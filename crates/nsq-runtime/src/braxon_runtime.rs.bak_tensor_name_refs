    }

    #[test]
    fn validates_tokenizer_stamp_matrix_bands() {
        let matrix = TokenizerStampMatrix {
            scope: "nsq_sovereign_tokenizer_matrix".to_string(),
            matrix_state: "declared_charter".to_string(),
            negative_stamp_space: TokenizerStampBand {
