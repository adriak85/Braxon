NSQ_APP soul_priority_law
NSQ_APP_VERSION 1

NSQ_SOUL_PRIORITY_LAW {
  if_many_things_claim_first = resolve_by_order

  priority_order_1 = read_everything
  priority_order_2 = check_surroundings
  priority_order_3 = resolve_real_identity
  priority_order_4 = understand_action
  priority_order_5 = make_best_decision

  first_label_is_not_authority = true
  random_priority_choice_is_forbidden = true
  identity_before_action = true
  surroundings_before_identity = true
  reading_before_surroundings = true
  best_decision_after_understood_action = true
}

NSQ_RUNTIME_ALIGNMENT {
  BRAXON_may_run_before_complete = true
  BRAXON_must_not_pretend_complete = true
  incomplete_state_requires_honest_next_path = true
  obstacle_is_navigation_input_not_deterrent = true
}
