BRAXON_MODEL_DOWNLOADER {
  authority = NSQ_COURT
  architecture_root = true
  route = BRAXON_model_downloader
  king = compositor
  queen = linter
  court_is_agents = false

  exact_link_first = true
  gated_exact_repo_is_not_missing = true
  lookup_nearest_aligned_if_missing = exact_404_only
  all_active_models_must_be_huihui_abliterated = true
  fallback_to_non_huihui_allowed = false
  fallback_to_non_abliterated_allowed = false
  vl_allowed_by_default = false
  no_daemons = true
  no_c_reference_runner = true

  required_stack {
    qwen_235 = qwen-235b
    maverick_235 = maverick-235b
    support_70 = deepseek-llama-70b
    gemma_only_small_slot = gemma-limbic
  }

  forbidden_stack {
    qwen_32b = forbidden
    deepseek_qwen_32b = forbidden
    mistral_24b = forbidden
    non_huihui_maverick = forbidden
    non_abliterated_model = forbidden
    qwen_vl_32b = forbidden
    qwen_vl_235b_default = forbidden
  }

  source = HuggingFace
  registry = config/nsq/huihui_model_registry.json
  local_root = assets/braxon_core/source_ingest/braxon_transport
  state_root = state/braxon/model_downloader/current

  acceptance {
    repo_resolved_by_api = true
    gated_exact_repo_records_auth_block = true
    file_list_dynamic = true
    wrong_vl_route_blocked = true
    payload_download_is_not_nsq_recode = true
    nsq_recode_required_after_payload = true
  }
}
