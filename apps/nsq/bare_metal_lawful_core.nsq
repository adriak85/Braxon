NSQ_APP bare_metal_lawful_core
NSQ_APP_VERSION 1

NSQ_BARE_METAL_LAW {
  nsq_claims_bare_metal_intent = true
  nsq_claims_bare_metal_only_after_proof = true
  nsq_must_not_self_certify_bare_metal = true

  nsq_is_not_rust_hosted = true
  nsq_is_not_c_hosted = true
  nsq_is_not_python_hosted = true
  nsq_is_not_binary_as_source_truth = true

  nsqasm_is_lowest_operating_bridge = true
  nsqasm_core_may_bootstrap_native_operation = true
  nsqasm_core_is_not_higher_authority_than_nsq = true

  lawful_nsq_required = true
  moral_invariant_required = true
  metadata_current_required = true
  court_macro_equipment_required = true

  hardware_proof_requires {
    native_machine_core_executes = true
    lawful_nsq_boot_task_executes = true
    driver_or_mount_boundary_proven = true
    no_python_scored_runtime = true
    no_rust_scored_runtime = true
    no_c_scored_runtime_for_final_nsq = true
    no_tracking_in_production_round = true
    no_macro_discovery_in_production_round = true
    no_tracers_in_production_round = true
  }

  if_driver_missing = keep_bare_metal_claim_false
  if_native_runner_missing = keep_bare_metal_claim_false
  if_only_shim_present = keep_bare_metal_claim_false
}
