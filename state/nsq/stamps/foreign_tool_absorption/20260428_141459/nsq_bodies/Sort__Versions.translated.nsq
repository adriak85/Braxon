NSQ_SOURCE_LINE 00000001 "package Sort::Versions;"
NSQ_SOURCE_LINE 00000002 "$Sort::Versions::VERSION = '1.62';"
NSQ_SOURCE_LINE 00000003 "# Copyright (c) 1996, Kenneth J. Albanowski. All rights reserved.  This"
NSQ_SOURCE_LINE 00000004 "# program is free software; you can redistribute it and/or modify it under"
NSQ_SOURCE_LINE 00000005 "# the same terms as Perl itself."
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use 5.006;"
NSQ_SOURCE_LINE 00000008 "use strict;"
NSQ_SOURCE_LINE 00000009 "use warnings;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "require Exporter;"
NSQ_SOURCE_LINE 00000012 "our @ISA        = qw(Exporter);"
NSQ_SOURCE_LINE 00000013 "our @EXPORT     = qw(&versions &versioncmp);"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK  = qw();"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub versioncmp ($$) {"
NSQ_SOURCE_LINE 00000017 "    my @A = ($_[0] =~ /([-.]|\\d+|[^-.\\d]+)/g);"
NSQ_SOURCE_LINE 00000018 "    my @B = ($_[1] =~ /([-.]|\\d+|[^-.\\d]+)/g);"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    my ($A, $B);"
NSQ_SOURCE_LINE 00000021 "    while (@A and @B) {"
NSQ_SOURCE_LINE 00000022 "\t$A = shift @A;"
NSQ_SOURCE_LINE 00000023 "\t$B = shift @B;"
NSQ_SOURCE_LINE 00000024 "\tif ($A eq '-' and $B eq '-') {"
NSQ_SOURCE_LINE 00000025 "\t    next;"
NSQ_SOURCE_LINE 00000026 "\t} elsif ( $A eq '-' ) {"
NSQ_SOURCE_LINE 00000027 "\t    return -1;"
NSQ_SOURCE_LINE 00000028 "\t} elsif ( $B eq '-') {"
NSQ_SOURCE_LINE 00000029 "\t    return 1;"
NSQ_SOURCE_LINE 00000030 "\t} elsif ($A eq '.' and $B eq '.') {"
NSQ_SOURCE_LINE 00000031 "\t    next;"
NSQ_SOURCE_LINE 00000032 "\t} elsif ( $A eq '.' ) {"
NSQ_SOURCE_LINE 00000033 "\t    return -1;"
NSQ_SOURCE_LINE 00000034 "\t} elsif ( $B eq '.' ) {"
NSQ_SOURCE_LINE 00000035 "\t    return 1;"
NSQ_SOURCE_LINE 00000036 "\t} elsif ($A =~ /^\\d+$/ and $B =~ /^\\d+$/) {"
NSQ_SOURCE_LINE 00000037 "\t    if ($A =~ /^0/ || $B =~ /^0/) {"
NSQ_SOURCE_LINE 00000038 "\t\treturn $A cmp $B if $A cmp $B;"
NSQ_SOURCE_LINE 00000039 "\t    } else {"
NSQ_SOURCE_LINE 00000040 "\t\treturn $A <=> $B if $A <=> $B;"
NSQ_SOURCE_LINE 00000041 "\t    }"
NSQ_SOURCE_LINE 00000042 "\t} else {"
NSQ_SOURCE_LINE 00000043 "\t    $A = uc $A;"
NSQ_SOURCE_LINE 00000044 "\t    $B = uc $B;"
NSQ_SOURCE_LINE 00000045 "\t    return $A cmp $B if $A cmp $B;"
NSQ_SOURCE_LINE 00000046 "\t}\t"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 "    @A <=> @B;"
NSQ_SOURCE_LINE 00000049 "}"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "sub versions () {"
NSQ_SOURCE_LINE 00000052 "    my $callerpkg = (caller)[0];"
NSQ_SOURCE_LINE 00000053 "    my $caller_a = \"${callerpkg}::a\";"
NSQ_SOURCE_LINE 00000054 "    my $caller_b = \"${callerpkg}::b\";"
NSQ_SOURCE_LINE 00000055 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000056 "    return versioncmp($$caller_a, $$caller_b);"
NSQ_SOURCE_LINE 00000057 "}"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=encoding utf-8"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=head1 NAME"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "Sort::Versions - a perl 5 module for sorting of revision-like numbers"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "\tuse Sort::Versions;"
NSQ_SOURCE_LINE 00000068 "\t@l = sort { versioncmp($a, $b) } qw( 1.2 1.2.0 1.2a.0 1.2.a 1.a 02.a );"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "\t..."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "\tuse Sort::Versions;"
NSQ_SOURCE_LINE 00000073 "\tprint 'lower' if versioncmp('1.2', '1.2a') == -1;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "\t..."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "\tuse Sort::Versions;"
NSQ_SOURCE_LINE 00000078 "\t%h = (1 => 'd', 2 => 'c', 3 => 'b', 4 => 'a');"
NSQ_SOURCE_LINE 00000079 "\t@h = sort { versioncmp($h{$a}, $h{$b}) } keys %h;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "=head1 DESCRIPTION\t"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "Sort::Versions allows easy sorting of mixed non-numeric and numeric strings,"
NSQ_SOURCE_LINE 00000084 "like the 'version numbers' that many shared library systems and revision"
NSQ_SOURCE_LINE 00000085 "control packages use. This is quite useful if you are trying to deal with"
NSQ_SOURCE_LINE 00000086 "shared libraries. It can also be applied to applications that intersperse"
NSQ_SOURCE_LINE 00000087 "variable-width numeric fields within text. Other applications can"
NSQ_SOURCE_LINE 00000088 "undoubtedly be found."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "For an explanation of the algorithm, it's simplest to look at these examples:"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "  1.1   <  1.2"
NSQ_SOURCE_LINE 00000093 "  1.1a  <  1.2"
NSQ_SOURCE_LINE 00000094 "  1.1   <  1.1.1"
NSQ_SOURCE_LINE 00000095 "  1.1   <  1.1a"
NSQ_SOURCE_LINE 00000096 "  1.1.a <  1.1a"
NSQ_SOURCE_LINE 00000097 "  1     <  a"
NSQ_SOURCE_LINE 00000098 "  a     <  b"
NSQ_SOURCE_LINE 00000099 "  1     <  2"
NSQ_SOURCE_LINE 00000100 "  1.1-3 <  1.1-4"
NSQ_SOURCE_LINE 00000101 "  1.1-5 <  1.1.6"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "More precisely (but less comprehensibly), the two strings are treated"
NSQ_SOURCE_LINE 00000104 "as subunits delimited by periods or hyphens. Each subunit can contain"
NSQ_SOURCE_LINE 00000105 "any number of groups of digits or non-digits. If digit groups are"
NSQ_SOURCE_LINE 00000106 "being compared on both sides, a numeric comparison is used, otherwise"
NSQ_SOURCE_LINE 00000107 "a ASCII ordering is used. A group or subgroup with more units will win"
NSQ_SOURCE_LINE 00000108 "if all comparisons are equal.  A period binds digit groups together"
NSQ_SOURCE_LINE 00000109 "more tightly than a hyphen."
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "Some packages use a different style of version numbering: a simple"
NSQ_SOURCE_LINE 00000112 "real number written as a decimal. Sort::Versions has limited support"
NSQ_SOURCE_LINE 00000113 "for this style: when comparing two subunits which are both digit"
NSQ_SOURCE_LINE 00000114 "groups, if either subunit has a leading zero, then both are treated"
NSQ_SOURCE_LINE 00000115 "like digits after a decimal point. So for example:"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "  0002  <  1"
NSQ_SOURCE_LINE 00000118 "  1.06  <  1.5"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "This wonE<39>t always work, because there wonE<39>t always be a leading zero"
NSQ_SOURCE_LINE 00000121 "in real-number style version numbers. There is no way for"
NSQ_SOURCE_LINE 00000122 "Sort::Versions to know which style was intended. But a lot of the time"
NSQ_SOURCE_LINE 00000123 "it will do the right thing. If you are making up version numbers, the"
NSQ_SOURCE_LINE 00000124 "style with (possibly) more than one dot is the style to use."
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=head1 USAGE"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "The function C<versioncmp()> takes two arguments and compares them like C<cmp>."
NSQ_SOURCE_LINE 00000129 "With perl 5.6 or later, you can also use this function directly in sorting:"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    @l = sort versioncmp qw(1.1 1.2 1.0.3);"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "The function C<versions()> can be used directly as a sort function even on"
NSQ_SOURCE_LINE 00000134 "perl 5.005 and earlier, but its use is deprecated."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "L<version>, L<CPAN::Version> which is part of the L<CPAN> distribution."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head1 REPOSITORY"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "L<https://github.com/neilb/Sort-Versions>"
NSQ_SOURCE_LINE 00000144 ""
