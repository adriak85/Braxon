NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "Related/similar modules: L<lib::none>, L<lib::core::only>, L<Devel::Hide>,"
NSQ_SOURCE_LINE 00000457 "L<Test::Without::Module>."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "To simulate the absence of certain programs in PATH, you can try"
NSQ_SOURCE_LINE 00000460 "L<File::Which::Patch::Hide>."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "To no-op instead of disallowing, see L<lib::noop>."
