NSQ_SOURCE_LINE 00000001 "package lib::filter;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "#use 5.008009;  # the first version where Module::CoreList becomes core"
NSQ_SOURCE_LINE 00000004 "use strict 'subs', 'vars'; # no need to avoid strict & warnings, because Config uses them"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Config;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000009 "our $DATE = '2021-08-29'; # DATE"
NSQ_SOURCE_LINE 00000010 "our $DIST = 'lib-filter'; # DIST"
NSQ_SOURCE_LINE 00000011 "our $VERSION = '0.281'; # VERSION"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "# BEGIN snippet from Module::Path::More, with mods/simplification"
NSQ_SOURCE_LINE 00000014 "my $SEPARATOR;"
NSQ_SOURCE_LINE 00000015 "BEGIN {"
NSQ_SOURCE_LINE 00000016 "    if ($^O =~ /^(dos|os2)/i) {"
NSQ_SOURCE_LINE 00000017 "        $SEPARATOR = '\\\\';"
NSQ_SOURCE_LINE 00000018 "    } elsif ($^O =~ /^MacOS/i) {"
NSQ_SOURCE_LINE 00000019 "        $SEPARATOR = ':';"
NSQ_SOURCE_LINE 00000020 "    } else {"
NSQ_SOURCE_LINE 00000021 "        $SEPARATOR = '/';"
NSQ_SOURCE_LINE 00000022 "    }"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 "sub module_path {"
NSQ_SOURCE_LINE 00000025 "    my ($file, $inc) = @_;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    foreach my $dir (@$inc) {"
NSQ_SOURCE_LINE 00000028 "        next if !defined($dir);"
NSQ_SOURCE_LINE 00000029 "        next if ref($dir);"
NSQ_SOURCE_LINE 00000030 "        my $path = $dir . $SEPARATOR . $file;"
NSQ_SOURCE_LINE 00000031 "        return $path if -f $path;"
NSQ_SOURCE_LINE 00000032 "    }"
NSQ_SOURCE_LINE 00000033 "    undef;"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 "# END snippet from Module::Path::More"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub _open_handle {"
NSQ_SOURCE_LINE 00000038 "    my $path = shift;"
NSQ_SOURCE_LINE 00000039 "    open my($fh), \"<\", $path"
NSQ_SOURCE_LINE 00000040 "        or die \"Can't open $path: $!\";"
NSQ_SOURCE_LINE 00000041 "    $fh;"
NSQ_SOURCE_LINE 00000042 "}"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "my $handler;"
NSQ_SOURCE_LINE 00000045 "my $hook;"
NSQ_SOURCE_LINE 00000046 "my ($orig_inc, $orig_inc_sorted_by_len);"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub lib::filter::INC { goto $handler }"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "sub import {"
NSQ_SOURCE_LINE 00000051 "    my ($class, %opts) = @_;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    my $dbgh = \"[lib::filter]\";"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    for (keys %opts) {"
NSQ_SOURCE_LINE 00000056 "        die \"Unknown option $_\""
NSQ_SOURCE_LINE 00000057 "            unless /\\A("
NSQ_SOURCE_LINE 00000058 "                        debug|"
NSQ_SOURCE_LINE 00000059 "                        allow_core|allow_noncore|"
NSQ_SOURCE_LINE 00000060 "                        extra_inc|"
NSQ_SOURCE_LINE 00000061 "                        allow|allow_list|allow_re|"
NSQ_SOURCE_LINE 00000062 "                        allow_is_recursive|"
NSQ_SOURCE_LINE 00000063 "                        disallow|disallow_list|disallow_re|"
NSQ_SOURCE_LINE 00000064 "                        filter"
NSQ_SOURCE_LINE 00000065 "                    )\\z/x;"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    $opts{debug} = $ENV{PERL_LIB_FILTER_DEBUG} unless defined($opts{debug});"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    $opts{allow_core}    = 1 if !defined($opts{allow_core});"
NSQ_SOURCE_LINE 00000071 "    $opts{allow_noncore} = 1 if !defined($opts{allow_noncore});"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    if ($opts{filter} && !ref($opts{filter})) {"
NSQ_SOURCE_LINE 00000074 "        # convenience, for when filter is specified from command-line (-M)"
NSQ_SOURCE_LINE 00000075 "        $opts{filter} = eval $opts{filter}; ## no critic: BuiltinFunctions::ProhibitStringyEval"
NSQ_SOURCE_LINE 00000076 "        die \"Error in filter code: $@\" if $@;"
NSQ_SOURCE_LINE 00000077 "    }"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    if ($opts{extra_inc}) {"
NSQ_SOURCE_LINE 00000080 "        unshift @INC, split(/:/, $opts{extra_inc});"
NSQ_SOURCE_LINE 00000081 "    }"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "    if (!$orig_inc) {"
NSQ_SOURCE_LINE 00000084 "        $orig_inc = [@INC];"
NSQ_SOURCE_LINE 00000085 "        $orig_inc_sorted_by_len = [sort {length($b) <=> length($a)} @INC];"
NSQ_SOURCE_LINE 00000086 "    }"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "    my $core_inc = [@Config{qw(privlibexp archlibexp)}];"
NSQ_SOURCE_LINE 00000089 "    my $noncore_inc = [grep {$_ ne $Config{privlibexp} &&"
NSQ_SOURCE_LINE 00000090 "                                 $_ ne $Config{archlibexp}} @$orig_inc];"
NSQ_SOURCE_LINE 00000091 "    my %allow;"
NSQ_SOURCE_LINE 00000092 "    if ($opts{allow}) {"
NSQ_SOURCE_LINE 00000093 "        for (split /\\s*;\\s*/, $opts{allow}) {"
NSQ_SOURCE_LINE 00000094 "            $allow{$_} = \"allow\";"
NSQ_SOURCE_LINE 00000095 "        }"
NSQ_SOURCE_LINE 00000096 "    }"
NSQ_SOURCE_LINE 00000097 "    if ($opts{allow_list}) {"
NSQ_SOURCE_LINE 00000098 "        open my($fh), \"<\", $opts{allow_list}"
NSQ_SOURCE_LINE 00000099 "            or die \"Can't open allow_list file '$opts{allow_list}': $!\";"
NSQ_SOURCE_LINE 00000100 "        while (my $line = <$fh>) {"
NSQ_SOURCE_LINE 00000101 "            $line =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00000102 "            $line =~ /^(\\w+(?:::\\w+)*)/ or next;"
NSQ_SOURCE_LINE 00000103 "            $allow{$1} ||= \"allow_list\";"
NSQ_SOURCE_LINE 00000104 "        }"
NSQ_SOURCE_LINE 00000105 "    }"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    my %disallow;"
NSQ_SOURCE_LINE 00000108 "    if ($opts{disallow}) {"
NSQ_SOURCE_LINE 00000109 "        for (split /\\s*;\\s*/, $opts{disallow}) {"
NSQ_SOURCE_LINE 00000110 "            $disallow{$_} = \"disallow\";"
NSQ_SOURCE_LINE 00000111 "            (my $pm = \"$_.pm\") =~ s!::!/!g; delete $INC{$pm};"
NSQ_SOURCE_LINE 00000112 "        }"
NSQ_SOURCE_LINE 00000113 "    }"
NSQ_SOURCE_LINE 00000114 "    if ($opts{disallow_list}) {"
NSQ_SOURCE_LINE 00000115 "        open my($fh), \"<\", $opts{disallow_list}"
NSQ_SOURCE_LINE 00000116 "            or die \"Can't open disallow_list file '$opts{disallow_list}': $!\";"
NSQ_SOURCE_LINE 00000117 "        while (my $line = <$fh>) {"
NSQ_SOURCE_LINE 00000118 "            $line =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00000119 "            $line =~ /^(\\w+(?:::\\w+)*)/ or next;"
NSQ_SOURCE_LINE 00000120 "            $disallow{$1} ||= \"disallow_list\";"
NSQ_SOURCE_LINE 00000121 "            (my $pm = \"$1.pm\") =~ s!::!/!g; delete $INC{$pm};"
NSQ_SOURCE_LINE 00000122 "        }"
NSQ_SOURCE_LINE 00000123 "    }"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "    $handler = sub {"
NSQ_SOURCE_LINE 00000126 "        my ($self, $file) = @_;"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "        my @caller = caller(0);"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "        warn \"$dbgh hook called for $file (from package $caller[0] file $caller[1])\\n\" if $opts{debug};"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "        my $path;"
NSQ_SOURCE_LINE 00000133 "      FILTER:"
NSQ_SOURCE_LINE 00000134 "        {"
NSQ_SOURCE_LINE 00000135 "            my $mod = $file; $mod =~ s/\\.pm$//; $mod =~ s!/!::!g;"
NSQ_SOURCE_LINE 00000136 "            my $err_prefix = \"Can't locate $file\";"
NSQ_SOURCE_LINE 00000137 "            if ($opts{filter}) {"
NSQ_SOURCE_LINE 00000138 "                local $_ = $mod;"
NSQ_SOURCE_LINE 00000139 "                warn \"$dbgh Checking against custom filter ...\\n\" if $opts{debug};"
NSQ_SOURCE_LINE 00000140 "                unless ($opts{filter}->($mod)) {"
NSQ_SOURCE_LINE 00000141 "                    die \"$err_prefix (module '$mod' is disallowed (filter))\";"
NSQ_SOURCE_LINE 00000142 "                }"
NSQ_SOURCE_LINE 00000143 "            }"
NSQ_SOURCE_LINE 00000144 "            if ($opts{disallow_re} && $mod =~ /$opts{disallow_re}/) {"
NSQ_SOURCE_LINE 00000145 "                die \"$err_prefix (module '$mod' is disallowed (disallow_re))\";"
NSQ_SOURCE_LINE 00000146 "            }"
NSQ_SOURCE_LINE 00000147 "            if ($disallow{$mod}) {"
NSQ_SOURCE_LINE 00000148 "                die \"$err_prefix (module '$mod' is disallowed ($disallow{$mod}))\";"
NSQ_SOURCE_LINE 00000149 "            }"
NSQ_SOURCE_LINE 00000150 "            if ($opts{allow_re} && $mod =~ /$opts{allow_re}/) {"
NSQ_SOURCE_LINE 00000151 "                warn \"$dbgh module $mod matches allow_re\\n\" if $opts{debug};"
NSQ_SOURCE_LINE 00000152 "                $path = module_path($file, $orig_inc);"
NSQ_SOURCE_LINE 00000153 "                last FILTER if $path;"
NSQ_SOURCE_LINE 00000154 "                die \"$err_prefix (module '$mod' is allowed (allow_re) but can't locate $file in \\@INC (\\@INC contains: \".join(\" \", @INC).\"))\";"
NSQ_SOURCE_LINE 00000155 "            }"
NSQ_SOURCE_LINE 00000156 "            if ($allow{$mod}) {"
NSQ_SOURCE_LINE 00000157 "                warn \"$dbgh module $mod matches $allow{$mod}\\n\" if $opts{debug};"
NSQ_SOURCE_LINE 00000158 "                $path = module_path($file, $orig_inc);"
NSQ_SOURCE_LINE 00000159 "                last FILTER if $path;"
NSQ_SOURCE_LINE 00000160 "                die \"$err_prefix (module '$mod' is allowed ($allow{$mod}) but can't locate $file in \\@INC (\\@INC contains: \".join(\" \", @INC).\"))\";"
NSQ_SOURCE_LINE 00000161 "            }"
NSQ_SOURCE_LINE 00000162 "            if ($opts{allow_is_recursive}) {"
NSQ_SOURCE_LINE 00000163 "                my $caller_pkg_from_file;"
NSQ_SOURCE_LINE 00000164 "                for (@$orig_inc_sorted_by_len) {"
NSQ_SOURCE_LINE 00000165 "                    #print \"D:\\$_=<$_> vs $caller[1]\\n\";"
NSQ_SOURCE_LINE 00000166 "                    if (index($caller[1], $_) == 0) {"
NSQ_SOURCE_LINE 00000167 "                        $caller_pkg_from_file = substr($caller[1], length($_)+1);"
NSQ_SOURCE_LINE 00000168 "                        #print \"D:caller_pkg_from_file=<$caller_pkg_from_file>\\n\";"
NSQ_SOURCE_LINE 00000169 "                        $caller_pkg_from_file =~ s/\\.pm\\z//;"
NSQ_SOURCE_LINE 00000170 "                        $caller_pkg_from_file =~ s/\\Q$Config{archname}\\E.//;"
NSQ_SOURCE_LINE 00000171 "                        $caller_pkg_from_file =~ s![/\\\\]!::!g;"
NSQ_SOURCE_LINE 00000172 "                    }"
NSQ_SOURCE_LINE 00000173 "                }"
NSQ_SOURCE_LINE 00000174 "                for my $caller_pkg (grep {defined} $caller[0], $caller_pkg_from_file) {"
NSQ_SOURCE_LINE 00000175 "                    (my $pm = \"$caller_pkg.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000176 "                    if (exists $INC{$pm}) {"
NSQ_SOURCE_LINE 00000177 "                        $path = module_path($file, $orig_inc);"
NSQ_SOURCE_LINE 00000178 "                        if ($path) {"
NSQ_SOURCE_LINE 00000179 "                            warn \"$dbgh module '$mod' allowed because it is require'd by $caller_pkg (allow_is_recursive=1)\\n\" if $opts{debug};"
NSQ_SOURCE_LINE 00000180 "                            last FILTER;"
NSQ_SOURCE_LINE 00000181 "                        }"
NSQ_SOURCE_LINE 00000182 "                    }"
NSQ_SOURCE_LINE 00000183 "                }"
NSQ_SOURCE_LINE 00000184 "            }"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "            my $inc;"
NSQ_SOURCE_LINE 00000187 "            if ($opts{allow_noncore} && $opts{allow_core}) {"
NSQ_SOURCE_LINE 00000188 "                $inc = $orig_inc;"
NSQ_SOURCE_LINE 00000189 "            } elsif ($opts{allow_core}) {"
NSQ_SOURCE_LINE 00000190 "                $inc = $core_inc;"
NSQ_SOURCE_LINE 00000191 "            } elsif ($opts{allow_noncore}) {"
NSQ_SOURCE_LINE 00000192 "                $inc = $noncore_inc;"
NSQ_SOURCE_LINE 00000193 "            }"
NSQ_SOURCE_LINE 00000194 "            if ($inc) {"
NSQ_SOURCE_LINE 00000195 "                warn \"$dbgh searching $file in (\".join(\", \", @$inc).\")\\n\" if $opts{debug};"
NSQ_SOURCE_LINE 00000196 "                $path = module_path($file, $inc);"
NSQ_SOURCE_LINE 00000197 "            }"
NSQ_SOURCE_LINE 00000198 "            last FILTER if $path;"
NSQ_SOURCE_LINE 00000199 "        } # FILTER"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "        unless ($path) {"
NSQ_SOURCE_LINE 00000202 "            warn \"$dbgh $file not found\\n\" if $opts{debug};"
NSQ_SOURCE_LINE 00000203 "            return;"
NSQ_SOURCE_LINE 00000204 "        }"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "        warn \"$dbgh $file found at $path\\n\" if $opts{debug};"
NSQ_SOURCE_LINE 00000207 "        $INC{$file} = $path;"
NSQ_SOURCE_LINE 00000208 "        return _open_handle($path);"
NSQ_SOURCE_LINE 00000209 "    };"
NSQ_SOURCE_LINE 00000210 "    $hook = bless(sub{\"dummy\"}, __PACKAGE__);"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "    @INC = ("
NSQ_SOURCE_LINE 00000213 "        $hook,"
NSQ_SOURCE_LINE 00000214 "        grep {"
NSQ_SOURCE_LINE 00000215 "            my $mod = $_;"
NSQ_SOURCE_LINE 00000216 "            if (\"$mod\" eq \"$hook\") {"
NSQ_SOURCE_LINE 00000217 "                0;"
NSQ_SOURCE_LINE 00000218 "            } elsif ($opts{allow_core} && grep {$mod eq $_} @$core_inc) {"
NSQ_SOURCE_LINE 00000219 "                1;"
NSQ_SOURCE_LINE 00000220 "            } elsif ($opts{allow_noncore} && grep {$mod eq $_} @$noncore_inc) {"
NSQ_SOURCE_LINE 00000221 "                1;"
NSQ_SOURCE_LINE 00000222 "            } else {"
NSQ_SOURCE_LINE 00000223 "                0;"
NSQ_SOURCE_LINE 00000224 "            }"
NSQ_SOURCE_LINE 00000225 "        } @$orig_inc,"
NSQ_SOURCE_LINE 00000226 "    );"
NSQ_SOURCE_LINE 00000227 "    #use DD; dd $orig_inc;"
NSQ_SOURCE_LINE 00000228 "    #use DD; dd \\@INC;"
NSQ_SOURCE_LINE 00000229 "}"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "sub unimport {"
NSQ_SOURCE_LINE 00000232 "    return unless $hook;"
NSQ_SOURCE_LINE 00000233 "    @INC = grep { \"$_\" ne \"$hook\" } @INC;"
NSQ_SOURCE_LINE 00000234 "}"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "1;"
NSQ_SOURCE_LINE 00000237 "# ABSTRACT: Allow/disallow loading modules"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "__END__"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=pod"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=head1 NAME"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "lib::filter - Allow/disallow loading modules"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=head1 VERSION"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "This document describes version 0.281 of lib::filter (from Perl distribution lib-filter), released on 2021-08-29."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 " use lib::filter %opts;"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "lib::filter lets you allow/disallow loading modules using some rules. It works"
NSQ_SOURCE_LINE 00000260 "by installing a coderef in C<@INC> (and additionally by pruning some entries in"
NSQ_SOURCE_LINE 00000261 "C<@INC>). The main use-case for this pragma is for testing."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "It has been pointed out to me that for some tasks, alternatives to using this"
NSQ_SOURCE_LINE 00000264 "module exist, so I'll be presenting those in the examples below."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=over"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=item * To disallow loading any module:"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 " % perl -Mlib::filter=allow_core,0,allow_noncore,0 yourscript.pl"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "You can also use L<lib::none> for this, or simply empty C<@INC> yourself, e.g.:"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 " {"
NSQ_SOURCE_LINE 00000275 "     local @INC = ();"
NSQ_SOURCE_LINE 00000276 "     ..."
NSQ_SOURCE_LINE 00000277 " }"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "To no-op instead of disallowing, see L<lib::noop::all>."
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=item * To allow only core modules:"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "For example for testing a fatpacked script (see L<App::FatPacker>):"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 " % perl -Mlib::filter=allow_noncore,0 yourscript.pl"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "You can also use L<lib::core::only> for this, which comes with the"
NSQ_SOURCE_LINE 00000288 "L<App::FatPacker> distribution."
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=item * To only allow a specific set of modules:"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 " % perl -Mlib::filter=allow_core,0,allow_noncore,0,allow,'XSLoader;List::Util' yourscript.pl"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "To no-op instead of disallowing, see L<lib::noop::except>."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=item * To allow core modules plus some additional modules:"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "For example to test a fatpacked script that might still require some XS modules:"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 " # allow additional modules by pattern"
NSQ_SOURCE_LINE 00000301 " % perl -Mlib::filter=allow_noncore,0,allow_re,'^DateTime::.*' yourscript.pl"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 " # allow additional modules listed in a file"
NSQ_SOURCE_LINE 00000304 " % perl -Mlib::filter=allow_noncore,0,allow_list,'/tmp/allow.txt' yourscript.pl"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 " # allow core modules plus additional modules found in some dirs"
NSQ_SOURCE_LINE 00000307 " % perl -Mlib::filter=allow_noncore,0,extra_inc,'.:proj/lib' yourscript.pl"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 " # allow some non-core XS modules"
NSQ_SOURCE_LINE 00000310 " % perl -MModule::CoreList -Mlib::filter=filter,'sub{ return 1 if Module::CoreList->is_core($_); return 1 if m!Clone|Acme/Damn!; 0' yourscript.pl"
NSQ_SOURCE_LINE 00000311 " % perl -Mlib::coreplus=Clone,Acme::Damn yourscript.pl"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "Alternatively, you can also test by preloading the additional modules before"
NSQ_SOURCE_LINE 00000314 "using lib::core::only:"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 " % perl -mClone -mAcme::Damn -Mlib::core::only yourscript.pl"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=item * To allow a module and recursively all other modules that the module requires"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "This is convenient when we want to allow a non-trivial module which itself uses"
NSQ_SOURCE_LINE 00000321 "some other modules, e.g. L<Moo> or L<Moose>:"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 " % perl -Mlib::filter=allow_noncore,0,allow,Moo,allow_is_recursive=0"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "=item * To disallow some modules:"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "For example to test that a script can still run without a module (e.g. an"
NSQ_SOURCE_LINE 00000328 "optional prereq):"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 " % perl -Mlib::filter=disallow,'YAML::XS;JSON::XS' yourscript.pl"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 " # idem, but the list of disallowed modules are retrieved from a file"
NSQ_SOURCE_LINE 00000333 " % perl -Mlib::filter=disallow_list,/tmp/disallow.txt yourscript.pl"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "L<Devel::Hide> is another module which you can you for exactly this purpose:"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 " % perl -MDevel::Hide=YAML::XS,JSON::XS yourscript.pl"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "To no-op instead of disallowing, see L<lib::noop>."
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "=item * Do custom filtering"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 " % perl -Mlib::filter=filter,sub{not/^Foo::/} yourscript.pl"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=back"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=for Pod::Coverage .+"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "=head1 OPTIONS"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "Known options:"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "=over"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "=item * debug => bool"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "If set to true, print diagnostics when filtering."
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=item * disallow => str"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "Add a semicolon-separated list of modules to disallow."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=item * disallow_re => str"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "Add modules matching regex pattern to disallow."
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=item * disallow_list => filename"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "Read a file containing list of modules to disallow (one module per line)."
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=item * allow => str"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "Add a semicolon-separated list of module names to allow."
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=item * allow_re => str"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "Allow modules matching regex pattern."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=item * allow_list => filename"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "Read a file containing list of modules to allow (one module per line)."
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "=item * allow_is_recursive => bool (default: 0)"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "If set to 1, then will also allow modules that are required by the allowed"
NSQ_SOURCE_LINE 00000386 "modules (and modules that are allowed by I<those> modules, and so on). This is"
NSQ_SOURCE_LINE 00000387 "convenient if you want to allow a non-trivial module, say, L<Moo> or L<Moose>"
NSQ_SOURCE_LINE 00000388 "which will require other modules too. Without this option, you will need to"
NSQ_SOURCE_LINE 00000389 "explicitly allow each of those modules yourself."
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "=item * allow_core => bool (default: 1)"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "Allow core modules."
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=item * allow_noncore => bool (default: 1)"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "Allow non-core modules."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=item * extra_inc => str"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "Add additional path to search modules in. String must be colon-separated paths."
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=item * filter => code"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "Do custom filtering. Code will receive module name (e.g. C<Foo/Bar.pm>) as its"
NSQ_SOURCE_LINE 00000406 "argument (C<$_> is also localized to contained the module name, for convenience)"
NSQ_SOURCE_LINE 00000407 "and should return 1 if the module should be allowed."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "=back"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "How a module is filtered:"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "=over"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "=item * First it's checked against C<filter>, if that option is defined"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "=item * then, it is checked against the C<disallow>/C<disallow_re>/C<disallow_list>."
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "If it matches one of those options then the module is disallowed."
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "=item * Otherwise it is checked against the C<allow>/C<allow_re>/C<allow_list>."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "If it matches one of those options and the module's path is found in the"
NSQ_SOURCE_LINE 00000424 "directories in C<@INC>, then the module is allowed."
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=item * If C<allow_is_recursive> is true, check the requirer."
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "If the calling package is already in C<%INC>, we allow that. For example, if we"
NSQ_SOURCE_LINE 00000429 "allow C<Moo> and C<Moo> calls L<Moo::_strictures> and L<Module::Runtime>, we"
NSQ_SOURCE_LINE 00000430 "will also allow them. Later if C<Moo::_strictures> tries to load L<strictures>,"
NSQ_SOURCE_LINE 00000431 "we also allow it, and so on."
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=item * Finally, allow_core/allow_noncore is checked."
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "When C<allow_core> is set to false, core directories are excluded. Likewise,"
NSQ_SOURCE_LINE 00000436 "when C<allow_noncore> is set to false, non-core directories are excluded."
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "=back"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "=head2 PERL_LIB_FILTER_DEBUG"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "Boolean. Sets the default for the C<debug> option."
NSQ_SOURCE_LINE 00000445 ""
