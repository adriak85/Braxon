BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Clone;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "require Exporter;"
NSQ_SOURCE_LINE 00000006 "use XSLoader ();"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our @ISA       = qw(Exporter);"
NSQ_SOURCE_LINE 00000009 "our @EXPORT;"
NSQ_SOURCE_LINE 00000010 "our @EXPORT_OK = qw( clone );"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.50';"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "XSLoader::load('Clone', $VERSION);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "1;"
NSQ_SOURCE_LINE 00000017 "__END__"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "=head1 NAME"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "Clone - recursively copy Perl datatypes"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "=for html"
NSQ_SOURCE_LINE 00000024 "<a href=\"https://github.com/garu/Clone/actions/workflows/test.yml\"><img src=\"https://github.com/garu/Clone/actions/workflows/test.yml/badge.svg\" alt=\"Build Status\"></a>"
NSQ_SOURCE_LINE 00000025 "<a href=\"https://metacpan.org/pod/Clone\"><img src=\"https://badge.fury.io/pl/Clone.svg\" alt=\"CPAN version\"></a>"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    use Clone 'clone';"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    my $data = {"
NSQ_SOURCE_LINE 00000032 "       set => [ 1 .. 50 ],"
NSQ_SOURCE_LINE 00000033 "       foo => {"
NSQ_SOURCE_LINE 00000034 "           answer => 42,"
NSQ_SOURCE_LINE 00000035 "           object => SomeObject->new,"
NSQ_SOURCE_LINE 00000036 "       },"
NSQ_SOURCE_LINE 00000037 "    };"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    my $cloned_data = clone($data);"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    $cloned_data->{foo}{answer} = 1;"
NSQ_SOURCE_LINE 00000042 "    print $cloned_data->{foo}{answer};  # '1'"
NSQ_SOURCE_LINE 00000043 "    print $data->{foo}{answer};         # '42'"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "You can also add it to your class:"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    package Foo;"
NSQ_SOURCE_LINE 00000048 "    use parent 'Clone';"
NSQ_SOURCE_LINE 00000049 "    sub new { bless {}, shift }"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    package main;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    my $obj = Foo->new;"
NSQ_SOURCE_LINE 00000054 "    my $copy = $obj->clone;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "This module provides a C<clone()> method which makes recursive"
NSQ_SOURCE_LINE 00000059 "copies of nested hash, array, scalar and reference types,"
NSQ_SOURCE_LINE 00000060 "including tied variables and objects."
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "C<clone()> takes a scalar argument and duplicates it. To duplicate lists,"
NSQ_SOURCE_LINE 00000063 "arrays or hashes, pass them in by reference, e.g."
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    my $copy = clone (\\@array);"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "    # or"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    my %copy = %{ clone (\\%hash) };"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=head2 Cloning Blessed Objects"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    package Person;"
NSQ_SOURCE_LINE 00000076 "    sub new {"
NSQ_SOURCE_LINE 00000077 "        my ($class, $name) = @_;"
NSQ_SOURCE_LINE 00000078 "        bless { name => $name, friends => [] }, $class;"
NSQ_SOURCE_LINE 00000079 "    }"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    package main;"
NSQ_SOURCE_LINE 00000082 "    use Clone 'clone';"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    my $person = Person->new('Alice');"
NSQ_SOURCE_LINE 00000085 "    my $clone = clone($person);"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    # $clone is a separate object with the same data"
NSQ_SOURCE_LINE 00000088 "    push @{$person->{friends}}, 'Bob';"
NSQ_SOURCE_LINE 00000089 "    print scalar @{$clone->{friends}};  # 0"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=head2 Handling Circular References"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "Clone properly handles circular references, preventing infinite loops:"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    my $a = { name => 'A' };"
NSQ_SOURCE_LINE 00000096 "    my $b = { name => 'B', ref => $a };"
NSQ_SOURCE_LINE 00000097 "    $a->{ref} = $b;  # circular reference"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    my $clone = clone($a);"
NSQ_SOURCE_LINE 00000100 "    # Circular structure is preserved in the clone"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head2 Cloning Weakened References"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    use Scalar::Util 'weaken';"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    my $obj = { data => 'important' };"
NSQ_SOURCE_LINE 00000107 "    my $container = { strong => $obj, weak => $obj };"
NSQ_SOURCE_LINE 00000108 "    weaken($container->{weak});"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "    my $clone = clone($container);"
NSQ_SOURCE_LINE 00000111 "    # Both strong and weak references are preserved correctly"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head2 Cloning Tied Variables"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    use Tie::Hash;"
NSQ_SOURCE_LINE 00000116 "    tie my %hash, 'Tie::StdHash';"
NSQ_SOURCE_LINE 00000117 "    %hash = (a => 1, b => 2);"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "    my $clone = clone(\\%hash);"
NSQ_SOURCE_LINE 00000120 "    # The tied behavior is preserved in the clone"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "=over 4"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=item * Maximum Recursion Depth"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "Clone uses a recursion depth counter to prevent stack overflow."
NSQ_SOURCE_LINE 00000129 "The default limit is 4000 rdepth units on Linux/macOS and 2000 on"
NSQ_SOURCE_LINE 00000130 "Windows/Cygwin. Each nesting level consumes approximately 2 rdepth"
NSQ_SOURCE_LINE 00000131 "units, so the effective limits are roughly 2000 nesting levels on"
NSQ_SOURCE_LINE 00000132 "Linux/macOS and 1000 on Windows/Cygwin."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "For arrays, exceeding the limit triggers an iterative fallback that"
NSQ_SOURCE_LINE 00000135 "avoids stack overflow. For other reference types (hashes, scalars),"
NSQ_SOURCE_LINE 00000136 "exceeding the limit produces a warning and a shallow copy."
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "You can override the depth limit by passing it as the second argument"
NSQ_SOURCE_LINE 00000139 "to C<clone()>:"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    my $copy = clone($data, 8000);  # allow deeper recursion"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=item * Filehandles and IO Objects"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "Filehandles and IO objects are cloned, but the underlying file descriptor"
NSQ_SOURCE_LINE 00000146 "is shared. Both the original and cloned filehandle will refer to the same"
NSQ_SOURCE_LINE 00000147 "file position. For DBI database handles and similar objects, Clone attempts"
NSQ_SOURCE_LINE 00000148 "to handle them safely, but behavior may vary depending on the object type."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=item * Code References"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "Code references (subroutines) are cloned by reference, not by value."
NSQ_SOURCE_LINE 00000153 "The cloned coderef points to the same subroutine as the original."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=item * Thread Safety"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Clone is not explicitly thread-safe. Use appropriate synchronization"
NSQ_SOURCE_LINE 00000158 "when cloning data structures across threads."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=back"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head1 PERFORMANCE"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "Clone is implemented in C using Perl's XS interface, making it very fast"
NSQ_SOURCE_LINE 00000165 "for most use cases."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=over 4"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=item * When to use Clone"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "Clone is optimized for speed and works best with:"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=over 4"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=item * Shallow to medium-depth structures (3 levels or fewer)"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=item * Data structures that need fast cloning in hot code paths"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=item * Structures containing blessed objects and tied variables"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=back"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=item * When to use Storable::dclone"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "L<Storable>'s C<dclone()> may be faster for:"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "=over 4"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=item * Very deep structures (4+ levels)"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=item * When you need serialization features"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=back"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=back"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "Benchmarking your specific use case is recommended for performance-critical"
NSQ_SOURCE_LINE 00000198 "applications."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=over 4"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=item * Cloned objects are deep copies"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "Changes to the clone do not affect the original, and vice versa. This"
NSQ_SOURCE_LINE 00000207 "includes nested references and objects."
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=item * Object internals"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "While Clone handles most blessed objects correctly, objects with XS"
NSQ_SOURCE_LINE 00000212 "components or complex internal state may not clone as expected. Test"
NSQ_SOURCE_LINE 00000213 "thoroughly with your specific object types."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=item * Memory usage"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "Cloning large data structures creates a complete copy in memory. Ensure"
NSQ_SOURCE_LINE 00000218 "you have sufficient memory available."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=back"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "L<Storable>'s C<dclone()> is a flexible solution for cloning variables,"
NSQ_SOURCE_LINE 00000225 "albeit slower for average-sized data structures. Simple"
NSQ_SOURCE_LINE 00000226 "and naive benchmarks show that Clone is faster for data structures"
NSQ_SOURCE_LINE 00000227 "with 3 or fewer levels, while C<dclone()> can be faster for structures"
NSQ_SOURCE_LINE 00000228 "4 or more levels deep."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "Other modules that may be of interest:"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "L<Clone::PP> - Pure Perl implementation of Clone"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "L<Scalar::Util> - For C<weaken()> and other scalar utilities"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "L<Data::Dumper> - For debugging and inspecting data structures"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=over 4"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=item * Bug Reports and Feature Requests"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Please report bugs on GitHub: L<https://github.com/garu/Clone/issues>"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=item * Source Code"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "The source code is available on GitHub: L<https://github.com/garu/Clone>"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=back"
