NSQ_SOURCE_LINE 00001967 ");"
NSQ_SOURCE_LINE 00001968 ""
NSQ_SOURCE_LINE 00001969 "my $flat_profile = flatten ( \\%tld_profile );"
NSQ_SOURCE_LINE 00001970 ""
NSQ_SOURCE_LINE 00001971 "sub flatten {"
NSQ_SOURCE_LINE 00001972 "  my $hashref = shift;"
NSQ_SOURCE_LINE 00001973 "  my %results;"
NSQ_SOURCE_LINE 00001974 "  @results{ keys %{ $hashref->{$_} } } = values % { $hashref->{$_} }"
NSQ_SOURCE_LINE 00001975 "    for ( keys %$hashref );"
NSQ_SOURCE_LINE 00001976 "  return \\%results;"
NSQ_SOURCE_LINE 00001977 "}"
NSQ_SOURCE_LINE 00001978 ""
NSQ_SOURCE_LINE 00001979 "sub check_type {"
NSQ_SOURCE_LINE 00001980 "  my $type = shift;"
NSQ_SOURCE_LINE 00001981 "  croak \"unknown TLD type: $type\" unless grep { $type eq $_ } TLD_TYPES;"
NSQ_SOURCE_LINE 00001982 "  return 1;"
NSQ_SOURCE_LINE 00001983 "}"
NSQ_SOURCE_LINE 00001984 ""
NSQ_SOURCE_LINE 00001985 "=head1 PUBLIC METHODS"
NSQ_SOURCE_LINE 00001986 ""
NSQ_SOURCE_LINE 00001987 "  Each public function/method is described here."
NSQ_SOURCE_LINE 00001988 "  These are how you should interact with this module."
NSQ_SOURCE_LINE 00001989 ""
NSQ_SOURCE_LINE 00001990 "=head3 C<< tlds >>"
NSQ_SOURCE_LINE 00001991 ""
NSQ_SOURCE_LINE 00001992 "  This routine returns the tlds requested."
NSQ_SOURCE_LINE 00001993 ""
NSQ_SOURCE_LINE 00001994 "  my @all_tlds = tlds; #array of tlds"
NSQ_SOURCE_LINE 00001995 "  my $all_tlds = tlds; #hashref of tlds and their descriptions"
NSQ_SOURCE_LINE 00001996 ""
NSQ_SOURCE_LINE 00001997 "  my @cc_tlds = tlds('cc'); #array of just 'cc' type tlds"
NSQ_SOURCE_LINE 00001998 "  my $cc_tlds = tlds('cc'); #hashref of just 'cc' type tlds and their descriptions"
NSQ_SOURCE_LINE 00001999 ""
NSQ_SOURCE_LINE 00002000 "  Valid types are:"
NSQ_SOURCE_LINE 00002001 "    cc                 - country code domains"
NSQ_SOURCE_LINE 00002002 "    ccidn              - internationalized country code top-level domain "
NSQ_SOURCE_LINE 00002003 "    gtld_open          - generic domains that anyone can register"
NSQ_SOURCE_LINE 00002004 "    gtld_restricted    - generic restricted registration domains"
NSQ_SOURCE_LINE 00002005 "    gtld_new           - new gTLDs"
NSQ_SOURCE_LINE 00002006 "    new_open           - recently added generic domains"
NSQ_SOURCE_LINE 00002007 "    new_restricted     - new restricted registration domains"
NSQ_SOURCE_LINE 00002008 "    reserved           - RFC2606 restricted names, not returned by tlds"
NSQ_SOURCE_LINE 00002009 ""
NSQ_SOURCE_LINE 00002010 "=cut"
NSQ_SOURCE_LINE 00002011 ""
NSQ_SOURCE_LINE 00002012 "sub tlds {"
NSQ_SOURCE_LINE 00002013 "  my $type = shift;"
NSQ_SOURCE_LINE 00002014 "  check_type ( $type ) if $type;"
NSQ_SOURCE_LINE 00002015 "  my $results = $type ? "
NSQ_SOURCE_LINE 00002016 "    wantarray ? [ keys %{ $tld_profile{$type} } ] : "
NSQ_SOURCE_LINE 00002017 "      dclone ( $tld_profile{$type} ) :"
NSQ_SOURCE_LINE 00002018 "\twantarray ? [ map { keys %$_ } values %tld_profile ] : "
NSQ_SOURCE_LINE 00002019 "\t  $flat_profile;"
NSQ_SOURCE_LINE 00002020 "  return wantarray ? @$results : $results;"
NSQ_SOURCE_LINE 00002021 "}"
NSQ_SOURCE_LINE 00002022 ""
NSQ_SOURCE_LINE 00002023 "=head3 C<< tld_exists >>"
NSQ_SOURCE_LINE 00002024 ""
NSQ_SOURCE_LINE 00002025 "  This routine returns true if the given domain exists and false otherwise."
NSQ_SOURCE_LINE 00002026 ""
NSQ_SOURCE_LINE 00002027 "  die \"no such domain\" unless tld_exists($tld); #call without tld type "
NSQ_SOURCE_LINE 00002028 "  die \"no such domain\" unless tld_exists($tld, 'new_open'); #call with tld type"
NSQ_SOURCE_LINE 00002029 ""
NSQ_SOURCE_LINE 00002030 "=cut"
NSQ_SOURCE_LINE 00002031 ""
NSQ_SOURCE_LINE 00002032 "sub tld_exists {"
NSQ_SOURCE_LINE 00002033 "  my ( $tld, $type )  = ( lc ( $_[0] ), $_[1] );"
NSQ_SOURCE_LINE 00002034 "  check_type ( $type ) if $type;"
NSQ_SOURCE_LINE 00002035 "  my $result = $type ? "
NSQ_SOURCE_LINE 00002036 "    $tld_profile{$type}{$tld} ? 1 : 0 :"
NSQ_SOURCE_LINE 00002037 "    $flat_profile->{$tld} ? 1 : 0;"
NSQ_SOURCE_LINE 00002038 "  return $result;"
NSQ_SOURCE_LINE 00002039 "}"
NSQ_SOURCE_LINE 00002040 ""
