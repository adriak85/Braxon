NSQ_SOURCE_LINE 00000001 "package Net::Domain::TLD;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use base qw( Exporter );"
NSQ_SOURCE_LINE 00000004 "use 5.006;"
NSQ_SOURCE_LINE 00000005 "our @EXPORT_OK = qw( tlds tld_exists %tld_profile );"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '1.75';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 "use Carp;"
NSQ_SOURCE_LINE 00000010 "use Storable qw ( dclone );"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use constant TLD_TYPES => qw ( new_open new_restricted gtld_open gtld_restricted gtld_new cc ccidn );"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "=head1 NAME"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "  Net::Domain::TLD - Work with TLD names "
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "  use Net::Domain::TLD qw(tlds tld_exists);"
NSQ_SOURCE_LINE 00000021 "  my @ccTLDs = tlds('cc');"
NSQ_SOURCE_LINE 00000022 "  print \"TLD ok\\n\" if tld_exists('ac','cc');"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "  The purpose of this module is to provide user with current list of "
NSQ_SOURCE_LINE 00000027 "  available top level domain names including new ICANN additions and ccTLDs"
NSQ_SOURCE_LINE 00000028 "  Currently TLD definitions have been acquired from the following sources:"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "  http://www.icann.org/tlds/"
NSQ_SOURCE_LINE 00000031 "  http://www.dnso.org/constituency/gtld/gtld.html"
NSQ_SOURCE_LINE 00000032 "  http://www.iana.org/cctld/cctld-whois.htm"
NSQ_SOURCE_LINE 00000033 "  https://www.iana.org/domains/root/db"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "=cut"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "my %tld_profile = ("
NSQ_SOURCE_LINE 00000038 "  reserved => {"
NSQ_SOURCE_LINE 00000039 "    test => q{DNS testing names},"
NSQ_SOURCE_LINE 00000040 "    example => q{Documentation names},"
NSQ_SOURCE_LINE 00000041 "    invalid => q{Invalid names},"
NSQ_SOURCE_LINE 00000042 "    localhost => q{Loopback names}"
NSQ_SOURCE_LINE 00000043 "  },"
NSQ_SOURCE_LINE 00000044 "  new_open => {"
NSQ_SOURCE_LINE 00000045 "    info => q{Unrestricted use},"
NSQ_SOURCE_LINE 00000046 "    xxx => q{sponsored top-level domain}"
NSQ_SOURCE_LINE 00000047 "  },"
NSQ_SOURCE_LINE 00000048 "  new_restricted => { "
NSQ_SOURCE_LINE 00000049 "    aero => q{Air-transport industry},"
NSQ_SOURCE_LINE 00000050 "    asia => q{Companies, organisations and individuals in the Asia-Pacific region},"
NSQ_SOURCE_LINE 00000051 "    arpa => q{Address and Routing Parameter Area},"
NSQ_SOURCE_LINE 00000052 "    biz => q{Businesses},"
