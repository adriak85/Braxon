BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use 5.008001;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "package Hash::Objectify;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "# ABSTRACT: Create objects from hashes on the fly"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $VERSION = '0.008';"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Carp;"
NSQ_SOURCE_LINE 00000012 "use Exporter 5.57 'import';"
NSQ_SOURCE_LINE 00000013 "use Scalar::Util qw/blessed/;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our @EXPORT    = qw/objectify/;"
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw/objectify_lax/;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "my %CACHE;"
NSQ_SOURCE_LINE 00000019 "my $COUNTER = 0;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub objectify {"
NSQ_SOURCE_LINE 00000022 "    my ( $ref, $package ) = @_;"
NSQ_SOURCE_LINE 00000023 "    my $type = ref $ref;"
NSQ_SOURCE_LINE 00000024 "    unless ( $type eq 'HASH' ) {"
NSQ_SOURCE_LINE 00000025 "        $type ="
NSQ_SOURCE_LINE 00000026 "            $type eq ''   ? \"a scalar value\""
NSQ_SOURCE_LINE 00000027 "          : blessed($ref) ? \"an object of class $type\""
NSQ_SOURCE_LINE 00000028 "          :                 \"a reference of type $type\";"
NSQ_SOURCE_LINE 00000029 "        croak \"Error: Can't objectify $type\";"
NSQ_SOURCE_LINE 00000030 "    }"
NSQ_SOURCE_LINE 00000031 "    if ( defined $package ) {"
NSQ_SOURCE_LINE 00000032 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000033 "        push @{ $package . '::ISA' }, 'Hash::Objectified'"
NSQ_SOURCE_LINE 00000034 "          unless $package->isa('Hash::Objectified');"
NSQ_SOURCE_LINE 00000035 "    }"
NSQ_SOURCE_LINE 00000036 "    else {"
NSQ_SOURCE_LINE 00000037 "        my ( $caller, undef, $line ) = caller;"
NSQ_SOURCE_LINE 00000038 "        my $cachekey = join \"\", sort keys %$ref;"
NSQ_SOURCE_LINE 00000039 "        if ( !defined $CACHE{$caller}{$line}{$cachekey} ) {"
NSQ_SOURCE_LINE 00000040 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000041 "            $package = $CACHE{$caller}{$line}{$cachekey} = \"Hash::Objectified$COUNTER\";"
NSQ_SOURCE_LINE 00000042 "            $COUNTER++;"
NSQ_SOURCE_LINE 00000043 "            @{ $package . '::ISA' } = 'Hash::Objectified';"
NSQ_SOURCE_LINE 00000044 "        }"
NSQ_SOURCE_LINE 00000045 "        else {"
NSQ_SOURCE_LINE 00000046 "            $package = $CACHE{$caller}{$line}{$cachekey};"
NSQ_SOURCE_LINE 00000047 "        }"
NSQ_SOURCE_LINE 00000048 "    }"
NSQ_SOURCE_LINE 00000049 "    return bless {%$ref}, $package;"
NSQ_SOURCE_LINE 00000050 "}"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "sub objectify_lax {"
NSQ_SOURCE_LINE 00000053 "    my ( $ref, $package ) = @_;"
NSQ_SOURCE_LINE 00000054 "    my $obj = objectify( $ref, $package );"
NSQ_SOURCE_LINE 00000055 "    $package ||= ref($obj);"
NSQ_SOURCE_LINE 00000056 "    {"
NSQ_SOURCE_LINE 00000057 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000058 "        unshift @{ $package . '::ISA' }, 'Hash::Objectified::Lax';"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 "    return $obj;"
NSQ_SOURCE_LINE 00000061 "}"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "package Hash::Objectified;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "use Class::XSAccessor;"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "our $AUTOLOAD;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "sub can {"
NSQ_SOURCE_LINE 00000070 "    my ( $self, $key ) = @_;"
NSQ_SOURCE_LINE 00000071 "    return undef unless ref $self && exists $self->{$key}; ## no critic"
NSQ_SOURCE_LINE 00000072 "    $self->$key; # install accessor if not installed"
NSQ_SOURCE_LINE 00000073 "    return $self->SUPER::can($key);"
NSQ_SOURCE_LINE 00000074 "}"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000077 "    my $self   = shift;"
NSQ_SOURCE_LINE 00000078 "    my $method = $AUTOLOAD;"
NSQ_SOURCE_LINE 00000079 "    $method =~ s/.*:://;"
NSQ_SOURCE_LINE 00000080 "    if ( ref $self && exists $self->{$method} ) {"
NSQ_SOURCE_LINE 00000081 "        Class::XSAccessor->import("
NSQ_SOURCE_LINE 00000082 "            accessors => { $method => $method },"
NSQ_SOURCE_LINE 00000083 "            class     => ref $self"
NSQ_SOURCE_LINE 00000084 "        );"
NSQ_SOURCE_LINE 00000085 "        return $self->$method(@_);"
NSQ_SOURCE_LINE 00000086 "    }"
NSQ_SOURCE_LINE 00000087 "    else {"
NSQ_SOURCE_LINE 00000088 "        return $self->_handle_missing($method);"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 "}"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "sub _handle_missing {"
NSQ_SOURCE_LINE 00000093 "    my ( $self, $method ) = @_;"
NSQ_SOURCE_LINE 00000094 "    my $class = ref $self || $self;"
NSQ_SOURCE_LINE 00000095 "    die qq{Can't locate object method \"$method\" via package \"$class\"};"
NSQ_SOURCE_LINE 00000096 "}"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "sub DESTROY { } # because we AUTOLOAD, we need this too"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "package Hash::Objectified::Lax;"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "sub _handle_missing {"
NSQ_SOURCE_LINE 00000103 "    return undef; ## no critic"
NSQ_SOURCE_LINE 00000104 "}"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "1;"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "# vim: ts=4 sts=4 sw=4 et:"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "__END__"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=pod"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=head1 NAME"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "Hash::Objectify - Create objects from hashes on the fly"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=head1 VERSION"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "version 0.008"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "  use Hash::Objectify;"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "  # turn a hash reference into an object with accessors"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "  $object = objectify { foo => 'bar', wibble => 'wobble' };"
NSQ_SOURCE_LINE 00000132 "  print $object->foo;"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "  # objectify with a specific class name"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "  $object = objectify { foo => 'bar' }, \"Foo::Response\";"
NSQ_SOURCE_LINE 00000137 "  print ref $object; # \"Foo::Response\""
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "Hash::Objectify turns a hash reference into a simple object with accessors"
NSQ_SOURCE_LINE 00000142 "for each of the keys."
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "One application of this module could be to create lightweight response"
NSQ_SOURCE_LINE 00000145 "objects without the extra work of setting up an entire response class with"
NSQ_SOURCE_LINE 00000146 "the framework of your choice."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "Using Hash::Objectify is slower than accessing the keys of the hash"
NSQ_SOURCE_LINE 00000149 "directly, but does provide \"typo protection\" since a misspelled method is"
NSQ_SOURCE_LINE 00000150 "an error."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=head1 USAGE"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "By default, the C<objectify> function is automatically exported."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=head2 objectify"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "  $object = objectify $hashref"
NSQ_SOURCE_LINE 00000159 "  $object = objectify $hashref, $classname;"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "  $object->$key;          # accessor"
NSQ_SOURCE_LINE 00000162 "  $object->$key($value);  # mutator"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "The C<objectify> function copies the hash reference (shallow copy), and"
NSQ_SOURCE_LINE 00000165 "blesses it into the given classname.  If no classname is given, a"
NSQ_SOURCE_LINE 00000166 "meaningless, generated package name is used instead.  In either case, the"
NSQ_SOURCE_LINE 00000167 "object will inherit from the Hash::Objectified class, which generates"
NSQ_SOURCE_LINE 00000168 "accessors on demand for any key in the hash."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "As an optimization, a generated classname will be the same for any given"
NSQ_SOURCE_LINE 00000171 "C<objectify> call if the keys of the input are the same.  (This avoids"
NSQ_SOURCE_LINE 00000172 "excessive accessor generation.)"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "The first time a method is called on the object, an accessor will be"
NSQ_SOURCE_LINE 00000175 "dynamically generated if the key exists.  If the key does not exist, an"
NSQ_SOURCE_LINE 00000176 "exception is thrown.  Note: deleting a key I<after> calling it as an"
NSQ_SOURCE_LINE 00000177 "accessor will not cause subsequent calls to throw an exception; the"
NSQ_SOURCE_LINE 00000178 "accessor will merely return undef."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "Objectifying with a \"real\" classname that does anything other than inherit"
NSQ_SOURCE_LINE 00000181 "from Hash::Objectified may lead to surprising behaviors from method name"
NSQ_SOURCE_LINE 00000182 "conflict.  You probably don't want to do that."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "Objectifying anything other than an unblessed hash reference is an error."
NSQ_SOURCE_LINE 00000185 "This is true even for objects based on blessed hash references, since the"
NSQ_SOURCE_LINE 00000186 "correct semantics are not universally obvious.  If you really want"
NSQ_SOURCE_LINE 00000187 "Hash::Objectify for access to the keys of a blessed hash, you should make"
NSQ_SOURCE_LINE 00000188 "an explicit, shallow copy:"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "  my $copy = objectify {%$object};"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=head2 objectify_lax"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "  $object = objectify_lax { foo => 'bar' };"
NSQ_SOURCE_LINE 00000195 "  $object->quux; # not fatal"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "This works just like L</objectify>, except that non-existing keys return"
NSQ_SOURCE_LINE 00000198 "C<undef> instead of throwing exceptions.  Non-existing keys will still"
NSQ_SOURCE_LINE 00000199 "return C<undef> if checked with C<can>."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "B<WARNING>: having an object that doesn't throw on unknown methods violates"
NSQ_SOURCE_LINE 00000202 "object-oriented behavior expectations so is generally a bad idea.  If you"
NSQ_SOURCE_LINE 00000203 "really feel you need this, be aware that the safety guard is removed and"
NSQ_SOURCE_LINE 00000204 "you might lose a finger."
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "If called with an existing non-lax objectified package name, the behavior"
NSQ_SOURCE_LINE 00000207 "of accessors not yet called with change to become lax.  You probably don't"
NSQ_SOURCE_LINE 00000208 "want to do that."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=for Pod::Coverage method_names_here"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "If an objectified hashref contains keys that conflict with existing"
NSQ_SOURCE_LINE 00000215 "resolvable methods (e.g. C<can>, C<AUTOLOAD>, C<DESTROY>), you won't be"
NSQ_SOURCE_LINE 00000216 "able to access those keys via a method as the existing methods take"
NSQ_SOURCE_LINE 00000217 "precedence."
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "Specifying custom package names or manipulating C<@ISA> for objectified"
NSQ_SOURCE_LINE 00000220 "packages (including subclassing) is likely to lead to surprising behavior."
NSQ_SOURCE_LINE 00000221 "It is not recommended and is not supported.  If it breaks, you get to keep"
NSQ_SOURCE_LINE 00000222 "the pieces."
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=for :stopwords cpan testmatrix url annocpan anno bugtracker rt cpants kwalitee diff irc mailto metadata placeholders metacpan"
NSQ_SOURCE_LINE 00000225 ""
