NSQ_SOURCE_LINE 00000001 "package lib::noop;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2021-06-07'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'lib-noop'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.006'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use strict;"
NSQ_SOURCE_LINE 00000009 "use warnings;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our @mods;"
NSQ_SOURCE_LINE 00000012 "our $noop_code = \"1;\\n\";"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our $hook = sub {"
NSQ_SOURCE_LINE 00000015 "    my ($self, $file) = @_;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "    my $mod = $file; $mod =~ s/\\.pm\\z//; $mod =~ s!/!::!g;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    # decline if not in list of module to noop"
NSQ_SOURCE_LINE 00000020 "    return undef unless grep { $_ eq $mod } @mods;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    return \\$noop_code;"
NSQ_SOURCE_LINE 00000023 "};"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub import {"
NSQ_SOURCE_LINE 00000026 "    my $class = shift;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    @mods = @_;"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    @INC = ($hook, grep { $_ ne \"$hook\" } @INC);"
NSQ_SOURCE_LINE 00000031 "}"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "sub unimport {"
NSQ_SOURCE_LINE 00000034 "    return unless $hook;"
NSQ_SOURCE_LINE 00000035 "    @mods = ();"
NSQ_SOURCE_LINE 00000036 "    @INC = grep { \"$_\" ne \"$hook\" } @INC;"
NSQ_SOURCE_LINE 00000037 "}"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "1;"
NSQ_SOURCE_LINE 00000040 "# ABSTRACT: no-op loading of some modules"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "__END__"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=pod"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "=head1 NAME"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "lib::noop - no-op loading of some modules"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=head1 VERSION"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "This document describes version 0.006 of lib::noop (from Perl distribution lib-noop), released on 2021-06-07."
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 " use lib::noop qw(Foo::Bar Baz);"
NSQ_SOURCE_LINE 00000059 " use Foo::Bar; # now a no-op"
NSQ_SOURCE_LINE 00000060 " use Qux; # load as usual"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "Given a list of module names, it will make subsequent loading of those modules a"
NSQ_SOURCE_LINE 00000065 "no-op. It works by installing a require hook in C<@INC> that looks for the"
NSQ_SOURCE_LINE 00000066 "specified modules to be no-op'ed and return \"1;\" as the source code for those"
NSQ_SOURCE_LINE 00000067 "modules."
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "This makes loading a no-op'ed module a success, even though the module does not"
NSQ_SOURCE_LINE 00000070 "exist on the filesystem. And the C<%INC> entry for the module will be added,"
NSQ_SOURCE_LINE 00000071 "making subsequent loading of the same module a no-op too because Perl's require"
NSQ_SOURCE_LINE 00000072 "will see that the entry for the module in C<%INC> already exists."
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "But, since the loading is a no-op operation, no code other than \"1;\" is executed"
NSQ_SOURCE_LINE 00000075 "and if the original module contains function or package variable definition,"
NSQ_SOURCE_LINE 00000076 "they will not be defined."
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "This pragma can be used e.g. for testing."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "To cancel the effect of lib::noop, you can unimport it. If you then want to"
NSQ_SOURCE_LINE 00000081 "actually load a module that has been no-op'ed, you have to delete its C<%INC>"
NSQ_SOURCE_LINE 00000082 "entry first:"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 " use lib::noop qw(Data::Dumper);"
NSQ_SOURCE_LINE 00000085 " use Data::Dumper;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 " # this code will die because Data::Dumper::Dumper is not defined"
NSQ_SOURCE_LINE 00000088 " BEGIN { print Data::Dumper::Dumper([1,2,3]) }"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 " no lib::noop;"
NSQ_SOURCE_LINE 00000091 " BEGIN { delete $INC{\"Data/Dumper.pm\"} }"
NSQ_SOURCE_LINE 00000092 " use Data::Dumper;"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 " # this code now runs ok"
NSQ_SOURCE_LINE 00000095 " BEGIN { print Data::Dumper::Dumper([1,2,3]) }"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=for Pod::Coverage .+"
NSQ_SOURCE_LINE 00000098 ""
