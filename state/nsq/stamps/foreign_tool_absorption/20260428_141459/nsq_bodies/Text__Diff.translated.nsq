BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Text::Diff;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Carp            qw/ croak confess /;"
NSQ_SOURCE_LINE 00000007 "use Exporter        ();"
NSQ_SOURCE_LINE 00000008 "use Algorithm::Diff ();"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $VERSION = '1.45';"
NSQ_SOURCE_LINE 00000011 "our @ISA     = qw/ Exporter /;"
NSQ_SOURCE_LINE 00000012 "our @EXPORT  = qw/ diff /;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "## Hunks are made of ops.  An op is the starting index for each"
NSQ_SOURCE_LINE 00000015 "## sequence and the opcode:"
NSQ_SOURCE_LINE 00000016 "use constant A       => 0;   # Array index before match/discard"
NSQ_SOURCE_LINE 00000017 "use constant B       => 1;"
NSQ_SOURCE_LINE 00000018 "use constant OPCODE  => 2;   # \"-\", \" \", \"+\""
NSQ_SOURCE_LINE 00000019 "use constant FLAG    => 3;   # What to display if not OPCODE \"!\""
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "my %internal_styles = ("
NSQ_SOURCE_LINE 00000022 "    Unified  => undef,"
NSQ_SOURCE_LINE 00000023 "    Context  => undef,"
NSQ_SOURCE_LINE 00000024 "    OldStyle => undef,"
NSQ_SOURCE_LINE 00000025 "    Table    => undef,   ## \"internal\", but in another module"
NSQ_SOURCE_LINE 00000026 ");"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "sub diff {"
NSQ_SOURCE_LINE 00000029 "    my @seqs    = ( shift, shift );"
NSQ_SOURCE_LINE 00000030 "    my $options = shift || {};"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    for my $i ( 0 .. 1 ) {"
NSQ_SOURCE_LINE 00000033 "        my $seq = $seqs[$i];"
NSQ_SOURCE_LINE 00000034 "        my $type = ref $seq;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "        while ( $type eq \"CODE\" ) {"
NSQ_SOURCE_LINE 00000037 "            $seqs[$i] = $seq = $seq->( $options );"
NSQ_SOURCE_LINE 00000038 "            $type = ref $seq;"
NSQ_SOURCE_LINE 00000039 "        }"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "        my $AorB = !$i ? \"A\" : \"B\";"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "        if ( $type eq \"ARRAY\" ) {"
NSQ_SOURCE_LINE 00000044 "            ## This is most efficient :)"
NSQ_SOURCE_LINE 00000045 "            $options->{\"OFFSET_$AorB\"} = 0"
NSQ_SOURCE_LINE 00000046 "                unless defined $options->{\"OFFSET_$AorB\"};"
NSQ_SOURCE_LINE 00000047 "        }"
NSQ_SOURCE_LINE 00000048 "        elsif ( $type eq \"SCALAR\" ) {"
NSQ_SOURCE_LINE 00000049 "            $seqs[$i] = [split( /^/m, $$seq )];"
NSQ_SOURCE_LINE 00000050 "            $options->{\"OFFSET_$AorB\"} = 1"
NSQ_SOURCE_LINE 00000051 "                unless defined $options->{\"OFFSET_$AorB\"};"
NSQ_SOURCE_LINE 00000052 "        }"
NSQ_SOURCE_LINE 00000053 "        elsif ( ! $type ) {"
NSQ_SOURCE_LINE 00000054 "            $options->{\"OFFSET_$AorB\"} = 1"
NSQ_SOURCE_LINE 00000055 "                unless defined $options->{\"OFFSET_$AorB\"};"
NSQ_SOURCE_LINE 00000056 "            $options->{\"FILENAME_$AorB\"} = $seq"
NSQ_SOURCE_LINE 00000057 "                unless defined $options->{\"FILENAME_$AorB\"};"
NSQ_SOURCE_LINE 00000058 "            $options->{\"MTIME_$AorB\"} = (stat($seq))[9]"
NSQ_SOURCE_LINE 00000059 "                unless defined $options->{\"MTIME_$AorB\"};"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "            local $/ = \"\\n\";"
NSQ_SOURCE_LINE 00000062 "            open F, \"<$seq\" or croak \"$!: $seq\";"
NSQ_SOURCE_LINE 00000063 "            $seqs[$i] = [<F>];"
NSQ_SOURCE_LINE 00000064 "            close F;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "        }"
NSQ_SOURCE_LINE 00000067 "        elsif ( $type eq \"GLOB\" || UNIVERSAL::isa( $seq, \"IO::Handle\" ) ) {"
NSQ_SOURCE_LINE 00000068 "            $options->{\"OFFSET_$AorB\"} = 1"
NSQ_SOURCE_LINE 00000069 "                unless defined $options->{\"OFFSET_$AorB\"};"
NSQ_SOURCE_LINE 00000070 "            local $/ = \"\\n\";"
NSQ_SOURCE_LINE 00000071 "            $seqs[$i] = [<$seq>];"
NSQ_SOURCE_LINE 00000072 "        }"
NSQ_SOURCE_LINE 00000073 "        else {"
NSQ_SOURCE_LINE 00000074 "            confess \"Can't handle input of type \", ref;"
NSQ_SOURCE_LINE 00000075 "        }"
NSQ_SOURCE_LINE 00000076 "    }"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "    ## Config vars"
NSQ_SOURCE_LINE 00000079 "    my $output;"
NSQ_SOURCE_LINE 00000080 "    my $output_handler = $options->{OUTPUT};"
NSQ_SOURCE_LINE 00000081 "    my $type = ref $output_handler ;"
NSQ_SOURCE_LINE 00000082 "    if ( ! defined $output_handler ) {"
NSQ_SOURCE_LINE 00000083 "        $output = \"\";"
NSQ_SOURCE_LINE 00000084 "        $output_handler = sub { $output .= shift };"
NSQ_SOURCE_LINE 00000085 "    }"
NSQ_SOURCE_LINE 00000086 "    elsif ( $type eq \"CODE\" ) {"
NSQ_SOURCE_LINE 00000087 "        ## No problems, mate."
NSQ_SOURCE_LINE 00000088 "    }"
NSQ_SOURCE_LINE 00000089 "    elsif ( $type eq \"SCALAR\" ) {"
NSQ_SOURCE_LINE 00000090 "        my $out_ref = $output_handler;"
NSQ_SOURCE_LINE 00000091 "        $output_handler = sub { $$out_ref .= shift };"
NSQ_SOURCE_LINE 00000092 "    }"
NSQ_SOURCE_LINE 00000093 "    elsif ( $type eq \"ARRAY\" ) {"
NSQ_SOURCE_LINE 00000094 "        my $out_ref = $output_handler;"
NSQ_SOURCE_LINE 00000095 "        $output_handler = sub { push @$out_ref, shift };"
NSQ_SOURCE_LINE 00000096 "    }"
NSQ_SOURCE_LINE 00000097 "    elsif ( $type eq \"GLOB\" || UNIVERSAL::isa $output_handler, \"IO::Handle\" ) {"
NSQ_SOURCE_LINE 00000098 "        my $output_handle = $output_handler;"
NSQ_SOURCE_LINE 00000099 "        $output_handler = sub { print $output_handle shift };"
NSQ_SOURCE_LINE 00000100 "    }"
NSQ_SOURCE_LINE 00000101 "    else {"
NSQ_SOURCE_LINE 00000102 "        croak \"Unrecognized output type: $type\";"
NSQ_SOURCE_LINE 00000103 "    }"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    my $style  = $options->{STYLE};"
NSQ_SOURCE_LINE 00000106 "    $style = \"Unified\" unless defined $options->{STYLE};"
NSQ_SOURCE_LINE 00000107 "    $style = \"Text::Diff::$style\" if exists $internal_styles{$style};"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    if ( ! $style->can( \"hunk\" ) ) {"
NSQ_SOURCE_LINE 00000110 "        eval \"require $style; 1\" or die $@;"
NSQ_SOURCE_LINE 00000111 "    }"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "    $style = $style->new if ! ref $style && $style->can( \"new\" );"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    my $ctx_lines = $options->{CONTEXT};"
NSQ_SOURCE_LINE 00000116 "    $ctx_lines = 3 unless defined $ctx_lines;"
NSQ_SOURCE_LINE 00000117 "    $ctx_lines = 0 if $style->isa( \"Text::Diff::OldStyle\" );"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "    my @keygen_args = $options->{KEYGEN_ARGS}"
NSQ_SOURCE_LINE 00000120 "        ? @{$options->{KEYGEN_ARGS}}"
NSQ_SOURCE_LINE 00000121 "        : ();"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "    ## State vars"
NSQ_SOURCE_LINE 00000124 "    my $diffs = 0; ## Number of discards this hunk"
NSQ_SOURCE_LINE 00000125 "    my $ctx   = 0; ## Number of \" \" (ctx_lines) ops pushed after last diff."
NSQ_SOURCE_LINE 00000126 "    my @ops;       ## ops (\" \", +, -) in this hunk"
NSQ_SOURCE_LINE 00000127 "    my $hunks = 0; ## Number of hunks"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "    my $emit_ops = sub {"
NSQ_SOURCE_LINE 00000130 "        $output_handler->( $style->file_header( @seqs,     $options ) )"
NSQ_SOURCE_LINE 00000131 "            unless $hunks++;"
NSQ_SOURCE_LINE 00000132 "        $output_handler->( $style->hunk_header( @seqs, @_, $options ) );"
NSQ_SOURCE_LINE 00000133 "        $output_handler->( $style->hunk       ( @seqs, @_, $options ) );"
NSQ_SOURCE_LINE 00000134 "        $output_handler->( $style->hunk_footer( @seqs, @_, $options ) );"
NSQ_SOURCE_LINE 00000135 "    };"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    ## We keep 2*ctx_lines so that if a diff occurs"
NSQ_SOURCE_LINE 00000138 "    ## at 2*ctx_lines we continue to grow the hunk instead"
NSQ_SOURCE_LINE 00000139 "    ## of emitting diffs and context as we go. We"
NSQ_SOURCE_LINE 00000140 "    ## need to know the total length of both of the two"
NSQ_SOURCE_LINE 00000141 "    ## subsequences so the line count can be printed in the"
NSQ_SOURCE_LINE 00000142 "    ## header."
NSQ_SOURCE_LINE 00000143 "    my $dis_a = sub {push @ops, [@_[0,1],\"-\"]; ++$diffs ; $ctx = 0 };"
NSQ_SOURCE_LINE 00000144 "    my $dis_b = sub {push @ops, [@_[0,1],\"+\"]; ++$diffs ; $ctx = 0 };"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    Algorithm::Diff::traverse_sequences("
NSQ_SOURCE_LINE 00000147 "        @seqs,"
NSQ_SOURCE_LINE 00000148 "        {"
NSQ_SOURCE_LINE 00000149 "            MATCH => sub {"
NSQ_SOURCE_LINE 00000150 "                push @ops, [@_[0,1],\" \"];"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "                if ( $diffs && ++$ctx > $ctx_lines * 2 ) {"
NSQ_SOURCE_LINE 00000153 "                    $emit_ops->( [ splice @ops, 0, $#ops - $ctx_lines ] );"
NSQ_SOURCE_LINE 00000154 "                    $ctx = $diffs = 0;"
NSQ_SOURCE_LINE 00000155 "                }"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "                ## throw away context lines that aren't needed any more"
NSQ_SOURCE_LINE 00000158 "                shift @ops if ! $diffs && @ops > $ctx_lines;"
NSQ_SOURCE_LINE 00000159 "            },"
NSQ_SOURCE_LINE 00000160 "            DISCARD_A => $dis_a,"
NSQ_SOURCE_LINE 00000161 "            DISCARD_B => $dis_b,"
NSQ_SOURCE_LINE 00000162 "        },"
NSQ_SOURCE_LINE 00000163 "        $options->{KEYGEN},  # pass in user arguments for key gen function"
NSQ_SOURCE_LINE 00000164 "        @keygen_args,"
NSQ_SOURCE_LINE 00000165 "    );"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    if ( $diffs ) {"
NSQ_SOURCE_LINE 00000168 "        $#ops -= $ctx - $ctx_lines if $ctx > $ctx_lines;"
NSQ_SOURCE_LINE 00000169 "        $emit_ops->( \\@ops );"
NSQ_SOURCE_LINE 00000170 "    }"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    $output_handler->( $style->file_footer( @seqs, $options ) ) if $hunks;"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "    return defined $output ? $output : $hunks;"
NSQ_SOURCE_LINE 00000175 "}"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "sub _header {"
NSQ_SOURCE_LINE 00000178 "    my ( $h ) = @_;"
NSQ_SOURCE_LINE 00000179 "    my ( $p1, $fn1, $t1, $p2, $fn2, $t2 ) = @{$h}{"
NSQ_SOURCE_LINE 00000180 "        \"FILENAME_PREFIX_A\","
NSQ_SOURCE_LINE 00000181 "        \"FILENAME_A\","
NSQ_SOURCE_LINE 00000182 "        \"MTIME_A\","
NSQ_SOURCE_LINE 00000183 "        \"FILENAME_PREFIX_B\","
NSQ_SOURCE_LINE 00000184 "        \"FILENAME_B\","
NSQ_SOURCE_LINE 00000185 "        \"MTIME_B\""
NSQ_SOURCE_LINE 00000186 "    };"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "    ## remember to change Text::Diff::Table if this logic is tweaked."
NSQ_SOURCE_LINE 00000189 "    return \"\" unless defined $fn1 && defined $fn2;"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "    return join( \"\","
NSQ_SOURCE_LINE 00000192 "        $p1, \" \", $fn1, defined $t1 ? \"\\t\" . localtime $t1 : (), \"\\n\","
NSQ_SOURCE_LINE 00000193 "        $p2, \" \", $fn2, defined $t2 ? \"\\t\" . localtime $t2 : (), \"\\n\","
NSQ_SOURCE_LINE 00000194 "    );"
NSQ_SOURCE_LINE 00000195 "}"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "## _range encapsulates the building of, well, ranges.  Turns out there are"
NSQ_SOURCE_LINE 00000198 "## a few nuances."
NSQ_SOURCE_LINE 00000199 "sub _range {"
NSQ_SOURCE_LINE 00000200 "    my ( $ops, $a_or_b, $format ) = @_;"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "    my $start = $ops->[ 0]->[$a_or_b];"
NSQ_SOURCE_LINE 00000203 "    my $after = $ops->[-1]->[$a_or_b];"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "    ## The sequence indexes in the lines are from *before* the OPCODE is"
NSQ_SOURCE_LINE 00000206 "    ## executed, so we bump the last index up unless the OP indicates"
NSQ_SOURCE_LINE 00000207 "    ## it didn't change."
NSQ_SOURCE_LINE 00000208 "    ++$after"
NSQ_SOURCE_LINE 00000209 "        unless $ops->[-1]->[OPCODE] eq ( $a_or_b == A ? \"+\" : \"-\" );"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "    ## convert from 0..n index to 1..(n+1) line number.  The unless modifier"
NSQ_SOURCE_LINE 00000212 "    ## handles diffs with no context, where only one file is affected.  In this"
NSQ_SOURCE_LINE 00000213 "    ## case $start == $after indicates an empty range, and the $start must"
NSQ_SOURCE_LINE 00000214 "    ## not be incremented."
NSQ_SOURCE_LINE 00000215 "    my $empty_range = $start == $after;"
NSQ_SOURCE_LINE 00000216 "    ++$start unless $empty_range;"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "    return"
NSQ_SOURCE_LINE 00000219 "        $start == $after"
NSQ_SOURCE_LINE 00000220 "            ? $format eq \"unified\" && $empty_range"
NSQ_SOURCE_LINE 00000221 "                ? \"$start,0\""
NSQ_SOURCE_LINE 00000222 "                : $start"
NSQ_SOURCE_LINE 00000223 "            : $format eq \"unified\""
NSQ_SOURCE_LINE 00000224 "                ? \"$start,\".($after-$start+1)"
NSQ_SOURCE_LINE 00000225 "                : \"$start,$after\";"
NSQ_SOURCE_LINE 00000226 "}"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "sub _op_to_line {"
NSQ_SOURCE_LINE 00000229 "    my ( $seqs, $op, $a_or_b, $op_prefixes ) = @_;"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "    my $opcode = $op->[OPCODE];"
NSQ_SOURCE_LINE 00000232 "    return () unless defined $op_prefixes->{$opcode};"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "    my $op_sym = defined $op->[FLAG] ? $op->[FLAG] : $opcode;"
NSQ_SOURCE_LINE 00000235 "    $op_sym = $op_prefixes->{$op_sym};"
NSQ_SOURCE_LINE 00000236 "    return () unless defined $op_sym;"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "    $a_or_b = $op->[OPCODE] ne \"+\" ? 0 : 1 unless defined $a_or_b;"
NSQ_SOURCE_LINE 00000239 "    my @line = ( $op_sym, $seqs->[$a_or_b][$op->[$a_or_b]] );"
NSQ_SOURCE_LINE 00000240 "    unless ( $line[1] =~ /(?:\\n|\\r\\n)$/ ) {"
NSQ_SOURCE_LINE 00000241 "        $line[1] .= \"\\n\\\\ No newline at end of file\\n\";"
NSQ_SOURCE_LINE 00000242 "    }"
NSQ_SOURCE_LINE 00000243 "    return @line;"
NSQ_SOURCE_LINE 00000244 "}"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "SCOPE: {"
NSQ_SOURCE_LINE 00000247 "    package Text::Diff::Base;"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "    sub new         {"
NSQ_SOURCE_LINE 00000250 "        my $proto = shift;"
NSQ_SOURCE_LINE 00000251 "        return bless { @_ }, ref $proto || $proto;"
NSQ_SOURCE_LINE 00000252 "    }"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "    sub file_header { return \"\" }"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "    sub hunk_header { return \"\" }"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "    sub hunk        { return \"\" }"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "    sub hunk_footer { return \"\" }"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "    sub file_footer { return \"\" }"
NSQ_SOURCE_LINE 00000263 "}"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "@Text::Diff::Unified::ISA = qw( Text::Diff::Base );"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "sub Text::Diff::Unified::file_header {"
NSQ_SOURCE_LINE 00000268 "    shift; ## No instance data"
NSQ_SOURCE_LINE 00000269 "    my $options = pop ;"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "    _header("
NSQ_SOURCE_LINE 00000272 "        { FILENAME_PREFIX_A => \"---\", FILENAME_PREFIX_B => \"+++\", %$options }"
NSQ_SOURCE_LINE 00000273 "    );"
NSQ_SOURCE_LINE 00000274 "}"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "sub Text::Diff::Unified::hunk_header {"
NSQ_SOURCE_LINE 00000277 "    shift; ## No instance data"
NSQ_SOURCE_LINE 00000278 "    pop; ## Ignore options"
NSQ_SOURCE_LINE 00000279 "    my $ops = pop;"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "    return join( \"\","
NSQ_SOURCE_LINE 00000282 "        \"@@ -\","
NSQ_SOURCE_LINE 00000283 "        _range( $ops, A, \"unified\" ),"
NSQ_SOURCE_LINE 00000284 "        \" +\","
NSQ_SOURCE_LINE 00000285 "        _range( $ops, B, \"unified\" ),"
NSQ_SOURCE_LINE 00000286 "        \" @@\\n\","
NSQ_SOURCE_LINE 00000287 "    );"
NSQ_SOURCE_LINE 00000288 "}"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "sub Text::Diff::Unified::hunk {"
NSQ_SOURCE_LINE 00000291 "    shift; ## No instance data"
NSQ_SOURCE_LINE 00000292 "    pop; ## Ignore options"
NSQ_SOURCE_LINE 00000293 "    my $ops = pop;"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "    my $prefixes = { \"+\" => \"+\", \" \" => \" \", \"-\" => \"-\" };"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "    return join \"\", map _op_to_line( \\@_, $_, undef, $prefixes ), @$ops"
NSQ_SOURCE_LINE 00000298 "}"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "@Text::Diff::Context::ISA = qw( Text::Diff::Base );"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "sub Text::Diff::Context::file_header {"
NSQ_SOURCE_LINE 00000303 "    _header { FILENAME_PREFIX_A=>\"***\", FILENAME_PREFIX_B=>\"---\", %{$_[-1]} };"
NSQ_SOURCE_LINE 00000304 "}"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "sub Text::Diff::Context::hunk_header {"
NSQ_SOURCE_LINE 00000307 "    return \"***************\\n\";"
NSQ_SOURCE_LINE 00000308 "}"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "sub Text::Diff::Context::hunk {"
NSQ_SOURCE_LINE 00000311 "    shift; ## No instance data"
NSQ_SOURCE_LINE 00000312 "    pop; ## Ignore options"
NSQ_SOURCE_LINE 00000313 "    my $ops = pop;"
NSQ_SOURCE_LINE 00000314 "    ## Leave the sequences in @_[0,1]"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "    my $a_range = _range( $ops, A, \"\" );"
NSQ_SOURCE_LINE 00000317 "    my $b_range = _range( $ops, B, \"\" );"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "    ## Sigh.  Gotta make sure that differences that aren't adds/deletions"
NSQ_SOURCE_LINE 00000320 "    ## get prefixed with \"!\", and that the old opcodes are removed."
NSQ_SOURCE_LINE 00000321 "    my $after;"
NSQ_SOURCE_LINE 00000322 "    for ( my $start = 0; $start <= $#$ops ; $start = $after ) {"
NSQ_SOURCE_LINE 00000323 "        ## Scan until next difference"
NSQ_SOURCE_LINE 00000324 "        $after = $start + 1;"
NSQ_SOURCE_LINE 00000325 "        my $opcode = $ops->[$start]->[OPCODE];"
NSQ_SOURCE_LINE 00000326 "        next if $opcode eq \" \";"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "        my $bang_it;"
NSQ_SOURCE_LINE 00000329 "        while ( $after <= $#$ops && $ops->[$after]->[OPCODE] ne \" \" ) {"
NSQ_SOURCE_LINE 00000330 "            $bang_it ||= $ops->[$after]->[OPCODE] ne $opcode;"
NSQ_SOURCE_LINE 00000331 "            ++$after;"
NSQ_SOURCE_LINE 00000332 "        }"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "        if ( $bang_it ) {"
NSQ_SOURCE_LINE 00000335 "            for my $i ( $start..($after-1) ) {"
NSQ_SOURCE_LINE 00000336 "                $ops->[$i]->[FLAG] = \"!\";"
NSQ_SOURCE_LINE 00000337 "            }"
NSQ_SOURCE_LINE 00000338 "        }"
NSQ_SOURCE_LINE 00000339 "    }"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "    my $b_prefixes = { \"+\" => \"+ \",  \" \" => \"  \", \"-\" => undef, \"!\" => \"! \" };"
NSQ_SOURCE_LINE 00000342 "    my $a_prefixes = { \"+\" => undef, \" \" => \"  \", \"-\" => \"- \",  \"!\" => \"! \" };"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "    return join( \"\","
NSQ_SOURCE_LINE 00000345 "        \"*** \", $a_range, \" ****\\n\","
NSQ_SOURCE_LINE 00000346 "        map( _op_to_line( \\@_, $_, A, $a_prefixes ), @$ops ),"
NSQ_SOURCE_LINE 00000347 "        \"--- \", $b_range, \" ----\\n\","
NSQ_SOURCE_LINE 00000348 "        map( _op_to_line( \\@_, $_, B, $b_prefixes ), @$ops ),"
NSQ_SOURCE_LINE 00000349 "    );"
NSQ_SOURCE_LINE 00000350 "}"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "@Text::Diff::OldStyle::ISA = qw( Text::Diff::Base );"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "sub _op {"
NSQ_SOURCE_LINE 00000355 "    my $ops = shift;"
NSQ_SOURCE_LINE 00000356 "    my $op = $ops->[0]->[OPCODE];"
NSQ_SOURCE_LINE 00000357 "    $op = \"c\" if grep $_->[OPCODE] ne $op, @$ops;"
NSQ_SOURCE_LINE 00000358 "    $op = \"a\" if $op eq \"+\";"
NSQ_SOURCE_LINE 00000359 "    $op = \"d\" if $op eq \"-\";"
NSQ_SOURCE_LINE 00000360 "    return $op;"
NSQ_SOURCE_LINE 00000361 "}"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "sub Text::Diff::OldStyle::hunk_header {"
NSQ_SOURCE_LINE 00000364 "    shift; ## No instance data"
NSQ_SOURCE_LINE 00000365 "    pop; ## ignore options"
NSQ_SOURCE_LINE 00000366 "    my $ops = pop;"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "    my $op = _op $ops;"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "    return join \"\", _range( $ops, A, \"\" ), $op, _range( $ops, B, \"\" ), \"\\n\";"
NSQ_SOURCE_LINE 00000371 "}"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "sub Text::Diff::OldStyle::hunk {"
NSQ_SOURCE_LINE 00000374 "    shift; ## No instance data"
NSQ_SOURCE_LINE 00000375 "    pop; ## ignore options"
NSQ_SOURCE_LINE 00000376 "    my $ops = pop;"
NSQ_SOURCE_LINE 00000377 "    ## Leave the sequences in @_[0,1]"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "    my $a_prefixes = { \"+\" => undef,  \" \" => undef, \"-\" => \"< \"  };"
NSQ_SOURCE_LINE 00000380 "    my $b_prefixes = { \"+\" => \"> \",   \" \" => undef, \"-\" => undef };"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "    my $op = _op $ops;"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "    return join( \"\","
NSQ_SOURCE_LINE 00000385 "        map( _op_to_line( \\@_, $_, A, $a_prefixes ), @$ops ),"
NSQ_SOURCE_LINE 00000386 "        $op eq \"c\" ? \"---\\n\" : (),"
NSQ_SOURCE_LINE 00000387 "        map( _op_to_line( \\@_, $_, B, $b_prefixes ), @$ops ),"
NSQ_SOURCE_LINE 00000388 "    );"
NSQ_SOURCE_LINE 00000389 "}"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "1;"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "__END__"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=head1 NAME"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "Text::Diff - Perform diffs on files and record sets"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "    use Text::Diff;"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "    ## Mix and match filenames, strings, file handles, producer subs,"
NSQ_SOURCE_LINE 00000404 "    ## or arrays of records; returns diff in a string."
NSQ_SOURCE_LINE 00000405 "    ## WARNING: can return B<large> diffs for large files."
NSQ_SOURCE_LINE 00000406 "    my $diff = diff \"file1.txt\", \"file2.txt\", { STYLE => \"Context\" };"
NSQ_SOURCE_LINE 00000407 "    my $diff = diff \\$string1,   \\$string2,   \\%options;"
NSQ_SOURCE_LINE 00000408 "    my $diff = diff \\*FH1,       \\*FH2;"
NSQ_SOURCE_LINE 00000409 "    my $diff = diff \\&reader1,   \\&reader2;"
NSQ_SOURCE_LINE 00000410 "    my $diff = diff \\@records1,  \\@records2;"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "    ## May also mix input types:"
NSQ_SOURCE_LINE 00000413 "    my $diff = diff \\@records1,  \"file_B.txt\";"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "C<diff()> provides a basic set of services akin to the GNU C<diff> utility.  It"
NSQ_SOURCE_LINE 00000418 "is not anywhere near as feature complete as GNU C<diff>, but it is better"
NSQ_SOURCE_LINE 00000419 "integrated with Perl and available on all platforms.  It is often faster than"
NSQ_SOURCE_LINE 00000420 "shelling out to a system's C<diff> executable for small files, and generally"
NSQ_SOURCE_LINE 00000421 "slower on larger files."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "Relies on L<Algorithm::Diff> for, well, the algorithm.  This may not produce"
NSQ_SOURCE_LINE 00000424 "the same exact diff as a system's local C<diff> executable, but it will be a"
NSQ_SOURCE_LINE 00000425 "valid diff and comprehensible by C<patch>.  We haven't seen any differences"
NSQ_SOURCE_LINE 00000426 "between L<Algorithm::Diff>'s logic and GNU C<diff>'s, but we have not examined"
NSQ_SOURCE_LINE 00000427 "them to make sure they are indeed identical."
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "B<Note>: If you don't want to import the C<diff> function, do one of the"
NSQ_SOURCE_LINE 00000430 "following:"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "   use Text::Diff ();"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "   require Text::Diff;"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "That's a pretty rare occurrence,"
NSQ_SOURCE_LINE 00000437 "so C<diff()> is exported by default."
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "If you pass a filename, but the file can't be read,"
NSQ_SOURCE_LINE 00000440 "then C<diff()> will C<croak>."
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "=head1 OPTIONS"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "C<diff()> takes two parameters from which to draw input and a set of"
NSQ_SOURCE_LINE 00000445 "options to control its output.  The options are:"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "=over"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "=item FILENAME_A, MTIME_A, FILENAME_B, MTIME_B"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "The name of the file and the modification time \"files\"."
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "These are filled in automatically for each file when C<diff()> is passed a"
NSQ_SOURCE_LINE 00000454 "filename, unless a defined value is passed in."
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "If a filename is not passed in and FILENAME_A and FILENAME_B are not provided"
NSQ_SOURCE_LINE 00000457 "or are C<undef>, the header will not be printed."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "Unused on C<OldStyle> diffs."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "=item OFFSET_A, OFFSET_B"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "The index of the first line / element.  These default to 1 for all"
NSQ_SOURCE_LINE 00000464 "parameter types except ARRAY references, for which the default is 0.  This"
NSQ_SOURCE_LINE 00000465 "is because ARRAY references are presumed to be data structures, while the"
NSQ_SOURCE_LINE 00000466 "others are line-oriented text."
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "=item STYLE"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "\"Unified\", \"Context\", \"OldStyle\", or an object or class reference for a class"
NSQ_SOURCE_LINE 00000471 "providing C<file_header()>, C<hunk_header()>, C<hunk()>, C<hunk_footer()> and"
NSQ_SOURCE_LINE 00000472 "C<file_footer()> methods.  The two footer() methods are provided for"
NSQ_SOURCE_LINE 00000473 "overloading only; none of the formats provide them."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "Defaults to \"Unified\" (unlike standard C<diff>, but Unified is what's most"
NSQ_SOURCE_LINE 00000476 "often used in submitting patches and is the most human readable of the three."
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "If the package indicated by the STYLE has no C<hunk()> method, C<diff()> will"
NSQ_SOURCE_LINE 00000479 "load it automatically (lazy loading).  Since all such packages should inherit"
NSQ_SOURCE_LINE 00000480 "from C<Text::Diff::Base>, this should be marvy."
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "Styles may be specified as class names (C<STYLE =E<gt> 'Foo'>),"
NSQ_SOURCE_LINE 00000483 "in which case they will be C<new()>ed with no parameters,"
NSQ_SOURCE_LINE 00000484 "or as objects (C<STYLE =E<gt> Foo-E<gt>new>)."
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "=item CONTEXT"
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "How many lines before and after each diff to display.  Ignored on old-style"
NSQ_SOURCE_LINE 00000489 "diffs.  Defaults to 3."
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "=item OUTPUT"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "Examples and their equivalent subroutines:"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "    OUTPUT   => \\*FOOHANDLE,   # like: sub { print FOOHANDLE shift() }"
NSQ_SOURCE_LINE 00000496 "    OUTPUT   => \\$output,      # like: sub { $output .= shift }"
NSQ_SOURCE_LINE 00000497 "    OUTPUT   => \\@output,      # like: sub { push @output, shift }"
NSQ_SOURCE_LINE 00000498 "    OUTPUT   => sub { $output .= shift },"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "If no C<OUTPUT> is supplied, returns the diffs in a string.  If"
NSQ_SOURCE_LINE 00000501 "C<OUTPUT> is a C<CODE> ref, it will be called once with the (optional)"
NSQ_SOURCE_LINE 00000502 "file header, and once for each hunk body with the text to emit.  If"
NSQ_SOURCE_LINE 00000503 "C<OUTPUT> is an L<IO::Handle>, output will be emitted to that handle."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=item FILENAME_PREFIX_A, FILENAME_PREFIX_B"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "The string to print before the filename in the header. Unused on C<OldStyle>"
NSQ_SOURCE_LINE 00000508 "diffs.  Defaults are C<\"---\">, C<\"+++\"> for Unified and C<\"***\">, C<\"+++\"> for"
NSQ_SOURCE_LINE 00000509 "Context."
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=item KEYGEN, KEYGEN_ARGS"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "These are passed to L<Algorithm::Diff/traverse_sequences>."
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "=back"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "B<Note>: if neither C<FILENAME_> option is defined, the header will not be"
NSQ_SOURCE_LINE 00000518 "printed.  If at least one is present, the other and both C<MTIME_> options must"
NSQ_SOURCE_LINE 00000519 "be present or \"Use of undefined variable\" warnings will be generated (except"
NSQ_SOURCE_LINE 00000520 "on C<OldStyle> diffs, which ignores these options)."
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "=head1 Formatting Classes"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "These functions implement the output formats.  They are grouped in to classes"
NSQ_SOURCE_LINE 00000525 "so C<diff()> can use class names to call the correct set of output routines and"
NSQ_SOURCE_LINE 00000526 "so that you may inherit from them easily.  There are no constructors or"
NSQ_SOURCE_LINE 00000527 "instance methods for these classes, though subclasses may provide them if need"
NSQ_SOURCE_LINE 00000528 "be."
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "Each class has C<file_header()>, C<hunk_header()>, C<hunk()>, and C<footer()>"
NSQ_SOURCE_LINE 00000531 "methods identical to those documented in the C<Text::Diff::Unified> section."
NSQ_SOURCE_LINE 00000532 "C<header()> is called before the C<hunk()> is first called, C<footer()>"
NSQ_SOURCE_LINE 00000533 "afterwards.  The default footer function is an empty method provided for"
NSQ_SOURCE_LINE 00000534 "overloading:"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "    sub footer { return \"End of patch\\n\" }"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "Some output formats are provided by external modules (which are loaded"
NSQ_SOURCE_LINE 00000539 "automatically), such as L<Text::Diff::Table>.  These are"
NSQ_SOURCE_LINE 00000540 "are documented here to keep the documentation simple."
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "=head2 Text::Diff::Base"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "Returns \"\" for all methods (other than C<new()>)."
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "=head2 Text::Diff::Unified"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "  --- A   Mon Nov 12 23:49:30 2001"
NSQ_SOURCE_LINE 00000549 "  +++ B   Mon Nov 12 23:49:30 2001"
NSQ_SOURCE_LINE 00000550 "  @@ -2,13 +2,13 @@"
NSQ_SOURCE_LINE 00000551 "   2"
NSQ_SOURCE_LINE 00000552 "   3"
NSQ_SOURCE_LINE 00000553 "   4"
NSQ_SOURCE_LINE 00000554 "  -5d"
NSQ_SOURCE_LINE 00000555 "  +5a"
NSQ_SOURCE_LINE 00000556 "   6"
NSQ_SOURCE_LINE 00000557 "   7"
NSQ_SOURCE_LINE 00000558 "   8"
NSQ_SOURCE_LINE 00000559 "   9"
NSQ_SOURCE_LINE 00000560 "  +9a"
NSQ_SOURCE_LINE 00000561 "   10"
NSQ_SOURCE_LINE 00000562 "   11"
NSQ_SOURCE_LINE 00000563 "  -11d"
NSQ_SOURCE_LINE 00000564 "   12"
NSQ_SOURCE_LINE 00000565 "   13"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "=over"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "=item Text::Diff::Unified::file_header"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "  $s = Text::Diff::Unified->file_header( $options );"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "Returns a string containing a unified header.  The sole parameter is the"
NSQ_SOURCE_LINE 00000574 "C<options> hash passed in to C<diff()>, containing at least:"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "  FILENAME_A  => $fn1,"
NSQ_SOURCE_LINE 00000577 "  MTIME_A     => $mtime1,"
NSQ_SOURCE_LINE 00000578 "  FILENAME_B  => $fn2,"
NSQ_SOURCE_LINE 00000579 "  MTIME_B     => $mtime2"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "May also contain"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "  FILENAME_PREFIX_A    => \"---\","
NSQ_SOURCE_LINE 00000584 "  FILENAME_PREFIX_B    => \"+++\","
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "to override the default prefixes (default values shown)."
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "=item Text::Diff::Unified::hunk_header"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "  Text::Diff::Unified->hunk_header( \\@ops, $options );"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "Returns a string containing the heading of one hunk of unified diff."
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "=item Text::Diff::Unified::hunk"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "  Text::Diff::Unified->hunk( \\@seq_a, \\@seq_b, \\@ops, $options );"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "Returns a string containing the output of one hunk of unified diff."
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "=back"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "=head2 Text::Diff::Table"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "  +--+----------------------------------+--+------------------------------+"
NSQ_SOURCE_LINE 00000605 "  |  |../Test-Differences-0.2/MANIFEST  |  |../Test-Differences/MANIFEST  |"
NSQ_SOURCE_LINE 00000606 "  |  |Thu Dec 13 15:38:49 2001          |  |Sat Dec 15 02:09:44 2001      |"
NSQ_SOURCE_LINE 00000607 "  +--+----------------------------------+--+------------------------------+"
NSQ_SOURCE_LINE 00000608 "  |  |                                  * 1|Changes                       *"
NSQ_SOURCE_LINE 00000609 "  | 1|Differences.pm                    | 2|Differences.pm                |"
NSQ_SOURCE_LINE 00000610 "  | 2|MANIFEST                          | 3|MANIFEST                      |"
NSQ_SOURCE_LINE 00000611 "  |  |                                  * 4|MANIFEST.SKIP                 *"
NSQ_SOURCE_LINE 00000612 "  | 3|Makefile.PL                       | 5|Makefile.PL                   |"
NSQ_SOURCE_LINE 00000613 "  |  |                                  * 6|t/00escape.t                  *"
NSQ_SOURCE_LINE 00000614 "  | 4|t/00flatten.t                     | 7|t/00flatten.t                 |"
NSQ_SOURCE_LINE 00000615 "  | 5|t/01text_vs_data.t                | 8|t/01text_vs_data.t            |"
NSQ_SOURCE_LINE 00000616 "  | 6|t/10test.t                        | 9|t/10test.t                    |"
NSQ_SOURCE_LINE 00000617 "  +--+----------------------------------+--+------------------------------+"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "This format also goes to some pains to highlight \"invisible\" characters on"
NSQ_SOURCE_LINE 00000620 "differing elements by selectively escaping whitespace:"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "  +--+--------------------------+--------------------------+"
NSQ_SOURCE_LINE 00000623 "  |  |demo_ws_A.txt             |demo_ws_B.txt             |"
NSQ_SOURCE_LINE 00000624 "  |  |Fri Dec 21 08:36:32 2001  |Fri Dec 21 08:36:50 2001  |"
NSQ_SOURCE_LINE 00000625 "  +--+--------------------------+--------------------------+"
NSQ_SOURCE_LINE 00000626 "  | 1|identical                 |identical                 |"
NSQ_SOURCE_LINE 00000627 "  * 2|        spaced in         |        also spaced in    *"
NSQ_SOURCE_LINE 00000628 "  * 3|embedded space            |embedded        tab       *"
NSQ_SOURCE_LINE 00000629 "  | 4|identical                 |identical                 |"
NSQ_SOURCE_LINE 00000630 "  * 5|        spaced in         |\\ttabbed in               *"
NSQ_SOURCE_LINE 00000631 "  * 6|trailing spaces\\s\\s\\n     |trailing tabs\\t\\t\\n       *"
NSQ_SOURCE_LINE 00000632 "  | 7|identical                 |identical                 |"
NSQ_SOURCE_LINE 00000633 "  * 8|lf line\\n                 |crlf line\\r\\n             *"
NSQ_SOURCE_LINE 00000634 "  * 9|embedded ws               |embedded\\tws              *"
NSQ_SOURCE_LINE 00000635 "  +--+--------------------------+--------------------------+"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "See L<Text::Diff::Table> for more details, including how the whitespace"
NSQ_SOURCE_LINE 00000638 "escaping works."
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "=head2 Text::Diff::Context"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "    *** A   Mon Nov 12 23:49:30 2001"
NSQ_SOURCE_LINE 00000643 "    --- B   Mon Nov 12 23:49:30 2001"
NSQ_SOURCE_LINE 00000644 "    ***************"
NSQ_SOURCE_LINE 00000645 "    *** 2,14 ****"
NSQ_SOURCE_LINE 00000646 "      2"
NSQ_SOURCE_LINE 00000647 "      3"
NSQ_SOURCE_LINE 00000648 "      4"
NSQ_SOURCE_LINE 00000649 "    ! 5d"
NSQ_SOURCE_LINE 00000650 "      6"
NSQ_SOURCE_LINE 00000651 "      7"
NSQ_SOURCE_LINE 00000652 "      8"
NSQ_SOURCE_LINE 00000653 "      9"
NSQ_SOURCE_LINE 00000654 "      10"
NSQ_SOURCE_LINE 00000655 "      11"
NSQ_SOURCE_LINE 00000656 "    - 11d"
NSQ_SOURCE_LINE 00000657 "      12"
NSQ_SOURCE_LINE 00000658 "      13"
NSQ_SOURCE_LINE 00000659 "    --- 2,14 ----"
NSQ_SOURCE_LINE 00000660 "      2"
NSQ_SOURCE_LINE 00000661 "      3"
NSQ_SOURCE_LINE 00000662 "      4"
NSQ_SOURCE_LINE 00000663 "    ! 5a"
NSQ_SOURCE_LINE 00000664 "      6"
NSQ_SOURCE_LINE 00000665 "      7"
NSQ_SOURCE_LINE 00000666 "      8"
NSQ_SOURCE_LINE 00000667 "      9"
NSQ_SOURCE_LINE 00000668 "    + 9a"
NSQ_SOURCE_LINE 00000669 "      10"
NSQ_SOURCE_LINE 00000670 "      11"
NSQ_SOURCE_LINE 00000671 "      12"
NSQ_SOURCE_LINE 00000672 "      13"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "Note: C<hunk_header()> returns only \"***************\\n\"."
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "=head2 Text::Diff::OldStyle"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "    5c5"
NSQ_SOURCE_LINE 00000679 "    < 5d"
NSQ_SOURCE_LINE 00000680 "    ---"
NSQ_SOURCE_LINE 00000681 "    > 5a"
NSQ_SOURCE_LINE 00000682 "    9a10"
NSQ_SOURCE_LINE 00000683 "    > 9a"
NSQ_SOURCE_LINE 00000684 "    12d12"
NSQ_SOURCE_LINE 00000685 "    < 11d"
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "Note: no C<file_header()>."
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "Must suck both input files entirely in to memory and store them with a normal"
NSQ_SOURCE_LINE 00000692 "amount of Perlish overhead (one array location) per record.  This is implied by"
NSQ_SOURCE_LINE 00000693 "the implementation of L<Algorithm::Diff>, which takes two arrays.  If"
NSQ_SOURCE_LINE 00000694 "L<Algorithm::Diff> ever offers an incremental mode, this can be changed"
NSQ_SOURCE_LINE 00000695 "(contact the maintainers of L<Algorithm::Diff> and C<Text::Diff> if you need"
NSQ_SOURCE_LINE 00000696 "this; it shouldn't be too terribly hard to tie arrays in this fashion)."
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "Does not provide most of the more refined GNU C<diff> options: recursive"
NSQ_SOURCE_LINE 00000699 "directory tree scanning, ignoring blank lines / whitespace, etc., etc.  These"
NSQ_SOURCE_LINE 00000700 "can all be added as time permits and need arises, many are rather easy; patches"
NSQ_SOURCE_LINE 00000701 "quite welcome."
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "Uses closures internally, this may lead to leaks on Perl versions 5.6.1 and"
NSQ_SOURCE_LINE 00000704 "prior if used many times over a process' life time."
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "L<Algorithm::Diff> - the underlying implementation of the diff algorithm"
NSQ_SOURCE_LINE 00000709 "used by C<Text::Diff>."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "L<YAML::Diff> - find difference between two YAML documents."
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "L<HTML::Differences> - find difference between two HTML documents."
NSQ_SOURCE_LINE 00000714 "This uses a more sane approach than L<HTML::Diff>."
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "L<XML::Diff> - find difference between two XML documents."
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "L<Array::Diff> - find the differences between two Perl arrays."
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "L<Hash::Diff> - find the differences between two Perl hashes."
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "L<Data::Diff> - find difference between two arbitrary data structures."
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "=head1 REPOSITORY"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "L<https://github.com/neilbowers/Text-Diff>"
