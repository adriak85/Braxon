NSQ_SOURCE_LINE 00000001 "package namespace::clean;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.27';"
NSQ_SOURCE_LINE 00000007 "$VERSION = eval $VERSION if $VERSION =~ /_/; # numify for warning-free dev releases"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $STORAGE_VAR = '__NAMESPACE_CLEAN_STORAGE';"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use B::Hooks::EndOfScope 'on_scope_end';"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "# FIXME This is a crock of shit, needs to go away"
NSQ_SOURCE_LINE 00000014 "# currently here to work around https://rt.cpan.org/Ticket/Display.html?id=74151"
NSQ_SOURCE_LINE 00000015 "# kill with fire when PS::XS is *finally* fixed"
NSQ_SOURCE_LINE 00000016 "BEGIN {"
NSQ_SOURCE_LINE 00000017 "  my $provider;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "  if ( \"$]\" < 5.008007 ) {"
NSQ_SOURCE_LINE 00000020 "    require Package::Stash::PP;"
NSQ_SOURCE_LINE 00000021 "    $provider = 'Package::Stash::PP';"
NSQ_SOURCE_LINE 00000022 "  }"
NSQ_SOURCE_LINE 00000023 "  else {"
NSQ_SOURCE_LINE 00000024 "    require Package::Stash;"
NSQ_SOURCE_LINE 00000025 "    $provider = 'Package::Stash';"
NSQ_SOURCE_LINE 00000026 "  }"
NSQ_SOURCE_LINE 00000027 "  eval <<\"EOS\" or die $@;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub stash_for (\\$) {"
NSQ_SOURCE_LINE 00000030 "  $provider->new(\\$_[0]);"
NSQ_SOURCE_LINE 00000031 "}"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "1;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "EOS"
NSQ_SOURCE_LINE 00000036 "}"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "use namespace::clean::_Util qw( DEBUGGER_NEEDS_CV_RENAME DEBUGGER_NEEDS_CV_PIVOT );"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "# Built-in debugger CV-retrieval fixups necessary before perl 5.15.5:"
NSQ_SOURCE_LINE 00000041 "# since we are deleting the glob where the subroutine was originally"
NSQ_SOURCE_LINE 00000042 "# defined, the assumptions below no longer hold."
NSQ_SOURCE_LINE 00000043 "#"
NSQ_SOURCE_LINE 00000044 "# In 5.8.9 ~ 5.13.5 (inclusive) the debugger assumes that a CV can"
NSQ_SOURCE_LINE 00000045 "# always be found under sub_fullname($sub)"
NSQ_SOURCE_LINE 00000046 "# Workaround: use sub naming to properly name the sub hidden in the package's"
NSQ_SOURCE_LINE 00000047 "# deleted-stash"
NSQ_SOURCE_LINE 00000048 "#"
NSQ_SOURCE_LINE 00000049 "# In the rest of the range ( ... ~ 5.8.8 and 5.13.6 ~ 5.15.4 ) the debugger"
NSQ_SOURCE_LINE 00000050 "# assumes the name of the glob passed to entersub can be used to find the CV"
NSQ_SOURCE_LINE 00000051 "# Workaround: realias the original glob to the deleted-stash slot"
NSQ_SOURCE_LINE 00000052 "#"
NSQ_SOURCE_LINE 00000053 "# While the errors manifest themselves inside perl5db.pl, they are caused by"
NSQ_SOURCE_LINE 00000054 "# problems inside the interpreter.  If enabled ($^P & 0x01) and existent,"
NSQ_SOURCE_LINE 00000055 "# the DB::sub sub will be called by the interpreter for any sub call rather"
NSQ_SOURCE_LINE 00000056 "# that call the sub directly.  It is provided the real sub to call in $DB::sub,"
NSQ_SOURCE_LINE 00000057 "# but the value given has the issues described above.  We only have to enable"
NSQ_SOURCE_LINE 00000058 "# the workaround if DB::sub will be used."
NSQ_SOURCE_LINE 00000059 "#"
NSQ_SOURCE_LINE 00000060 "# Can not tie constants to the current value of $^P directly,"
NSQ_SOURCE_LINE 00000061 "# as the debugger can be enabled during runtime (kinda dubious)"
NSQ_SOURCE_LINE 00000062 "#"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "my $RemoveSubs = sub {"
NSQ_SOURCE_LINE 00000065 "    my $cleanee = shift;"
NSQ_SOURCE_LINE 00000066 "    my $store   = shift;"
NSQ_SOURCE_LINE 00000067 "    my $cleanee_stash = stash_for($cleanee);"
NSQ_SOURCE_LINE 00000068 "    my $deleted_stash;"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "  SYMBOL:"
NSQ_SOURCE_LINE 00000071 "    for my $f (@_) {"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "        # ignore already removed symbols"
NSQ_SOURCE_LINE 00000074 "        next SYMBOL if $store->{exclude}{ $f };"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "        my $sub = $cleanee_stash->get_symbol(\"&$f\")"
NSQ_SOURCE_LINE 00000077 "          or next SYMBOL;"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "        my $need_debugger_fixup ="
NSQ_SOURCE_LINE 00000080 "          ( DEBUGGER_NEEDS_CV_RENAME or DEBUGGER_NEEDS_CV_PIVOT )"
NSQ_SOURCE_LINE 00000081 "            &&"
NSQ_SOURCE_LINE 00000082 "          $^P & 0x01"
NSQ_SOURCE_LINE 00000083 "            &&"
NSQ_SOURCE_LINE 00000084 "          defined &DB::sub"
NSQ_SOURCE_LINE 00000085 "            &&"
NSQ_SOURCE_LINE 00000086 "          ref(my $globref = \\$cleanee_stash->namespace->{$f}) eq 'GLOB'"
NSQ_SOURCE_LINE 00000087 "            &&"
NSQ_SOURCE_LINE 00000088 "         ( $deleted_stash ||= stash_for(\"namespace::clean::deleted::$cleanee\") )"
NSQ_SOURCE_LINE 00000089 "        ;"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "        # convince the Perl debugger to work"
NSQ_SOURCE_LINE 00000092 "        # see the comment on top"
NSQ_SOURCE_LINE 00000093 "        if ( DEBUGGER_NEEDS_CV_RENAME and $need_debugger_fixup ) {"
NSQ_SOURCE_LINE 00000094 "          #"
NSQ_SOURCE_LINE 00000095 "          # Note - both get_subname and set_subname are only compiled when CV_RENAME"
NSQ_SOURCE_LINE 00000096 "          # is true ( the 5.8.9 ~ 5.12 range ). On other perls this entire block is"
NSQ_SOURCE_LINE 00000097 "          # constant folded away, and so are the definitions in ::_Util"
NSQ_SOURCE_LINE 00000098 "          #"
NSQ_SOURCE_LINE 00000099 "          # Do not be surprised that they are missing without DEBUGGER_NEEDS_CV_RENAME"
NSQ_SOURCE_LINE 00000100 "          #"
NSQ_SOURCE_LINE 00000101 "          namespace::clean::_Util::get_subname( $sub ) eq  ( $cleanee_stash->name . \"::$f\" )"
NSQ_SOURCE_LINE 00000102 "            and"
NSQ_SOURCE_LINE 00000103 "          $deleted_stash->add_symbol("
NSQ_SOURCE_LINE 00000104 "            \"&$f\","
NSQ_SOURCE_LINE 00000105 "            namespace::clean::_Util::set_subname( $deleted_stash->name . \"::$f\", $sub ),"
NSQ_SOURCE_LINE 00000106 "          );"
NSQ_SOURCE_LINE 00000107 "        }"
NSQ_SOURCE_LINE 00000108 "        elsif ( DEBUGGER_NEEDS_CV_PIVOT and $need_debugger_fixup ) {"
NSQ_SOURCE_LINE 00000109 "          $deleted_stash->add_symbol(\"&$f\", $sub);"
NSQ_SOURCE_LINE 00000110 "        }"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "        my @symbols = map {"
NSQ_SOURCE_LINE 00000113 "            my $name = $_ . $f;"
NSQ_SOURCE_LINE 00000114 "            my $def = $cleanee_stash->get_symbol($name);"
NSQ_SOURCE_LINE 00000115 "            defined($def) ? [$name, $def] : ()"
NSQ_SOURCE_LINE 00000116 "        } '$', '@', '%', '';"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "        $cleanee_stash->remove_glob($f);"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "        # if this perl needs no renaming trick we need to"
NSQ_SOURCE_LINE 00000121 "        # rename the original glob after the fact"
NSQ_SOURCE_LINE 00000122 "        DEBUGGER_NEEDS_CV_PIVOT"
NSQ_SOURCE_LINE 00000123 "          and"
NSQ_SOURCE_LINE 00000124 "        $need_debugger_fixup"
NSQ_SOURCE_LINE 00000125 "          and"
NSQ_SOURCE_LINE 00000126 "        *$globref = $deleted_stash->namespace->{$f};"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "        $cleanee_stash->add_symbol(@$_) for @symbols;"
NSQ_SOURCE_LINE 00000129 "    }"
NSQ_SOURCE_LINE 00000130 "};"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "sub clean_subroutines {"
NSQ_SOURCE_LINE 00000133 "    my ($nc, $cleanee, @subs) = @_;"
NSQ_SOURCE_LINE 00000134 "    $RemoveSubs->($cleanee, {}, @subs);"
NSQ_SOURCE_LINE 00000135 "}"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "sub import {"
NSQ_SOURCE_LINE 00000138 "    my ($pragma, @args) = @_;"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "    my (%args, $is_explicit);"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "  ARG:"
NSQ_SOURCE_LINE 00000143 "    while (@args) {"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "        if ($args[0] =~ /^\\-/) {"
NSQ_SOURCE_LINE 00000146 "            my $key = shift @args;"
NSQ_SOURCE_LINE 00000147 "            my $value = shift @args;"
NSQ_SOURCE_LINE 00000148 "            $args{ $key } = $value;"
NSQ_SOURCE_LINE 00000149 "        }"
NSQ_SOURCE_LINE 00000150 "        else {"
NSQ_SOURCE_LINE 00000151 "            $is_explicit++;"
NSQ_SOURCE_LINE 00000152 "            last ARG;"
NSQ_SOURCE_LINE 00000153 "        }"
NSQ_SOURCE_LINE 00000154 "    }"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    my $cleanee = exists $args{ -cleanee } ? $args{ -cleanee } : scalar caller;"
NSQ_SOURCE_LINE 00000157 "    if ($is_explicit) {"
NSQ_SOURCE_LINE 00000158 "        on_scope_end {"
NSQ_SOURCE_LINE 00000159 "            $RemoveSubs->($cleanee, {}, @args);"
NSQ_SOURCE_LINE 00000160 "        };"
NSQ_SOURCE_LINE 00000161 "    }"
NSQ_SOURCE_LINE 00000162 "    else {"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "        # calling class, all current functions and our storage"
NSQ_SOURCE_LINE 00000165 "        my $functions = $pragma->get_functions($cleanee);"
NSQ_SOURCE_LINE 00000166 "        my $store     = $pragma->get_class_store($cleanee);"
NSQ_SOURCE_LINE 00000167 "        my $stash     = stash_for($cleanee);"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "        # except parameter can be array ref or single value"
NSQ_SOURCE_LINE 00000170 "        my %except = map {( $_ => 1 )} ("
NSQ_SOURCE_LINE 00000171 "            $args{ -except }"
NSQ_SOURCE_LINE 00000172 "            ? ( ref $args{ -except } eq 'ARRAY' ? @{ $args{ -except } } : $args{ -except } )"
NSQ_SOURCE_LINE 00000173 "            : ()"
NSQ_SOURCE_LINE 00000174 "        );"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "        # register symbols for removal, if they have a CODE entry"
NSQ_SOURCE_LINE 00000177 "        for my $f (keys %$functions) {"
NSQ_SOURCE_LINE 00000178 "            next if     $except{ $f };"
NSQ_SOURCE_LINE 00000179 "            next unless $stash->has_symbol(\"&$f\");"
NSQ_SOURCE_LINE 00000180 "            $store->{remove}{ $f } = 1;"
NSQ_SOURCE_LINE 00000181 "        }"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "        on_scope_end {"
NSQ_SOURCE_LINE 00000184 "            $RemoveSubs->($cleanee, $store, keys %{ $store->{remove} });"
NSQ_SOURCE_LINE 00000185 "        };"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "        return 1;"
NSQ_SOURCE_LINE 00000188 "    }"
NSQ_SOURCE_LINE 00000189 "}"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "sub unimport {"
NSQ_SOURCE_LINE 00000192 "    my ($pragma, %args) = @_;"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    # the calling class, the current functions and our storage"
NSQ_SOURCE_LINE 00000195 "    my $cleanee   = exists $args{ -cleanee } ? $args{ -cleanee } : scalar caller;"
NSQ_SOURCE_LINE 00000196 "    my $functions = $pragma->get_functions($cleanee);"
NSQ_SOURCE_LINE 00000197 "    my $store     = $pragma->get_class_store($cleanee);"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "    # register all unknown previous functions as excluded"
NSQ_SOURCE_LINE 00000200 "    for my $f (keys %$functions) {"
NSQ_SOURCE_LINE 00000201 "        next if $store->{remove}{ $f }"
NSQ_SOURCE_LINE 00000202 "             or $store->{exclude}{ $f };"
NSQ_SOURCE_LINE 00000203 "        $store->{exclude}{ $f } = 1;"
NSQ_SOURCE_LINE 00000204 "    }"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    return 1;"
NSQ_SOURCE_LINE 00000207 "}"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "sub get_class_store {"
NSQ_SOURCE_LINE 00000210 "    my ($pragma, $class) = @_;"
NSQ_SOURCE_LINE 00000211 "    my $stash = stash_for($class);"
NSQ_SOURCE_LINE 00000212 "    my $var = \"%$STORAGE_VAR\";"
NSQ_SOURCE_LINE 00000213 "    $stash->add_symbol($var, {})"
NSQ_SOURCE_LINE 00000214 "        unless $stash->has_symbol($var);"
NSQ_SOURCE_LINE 00000215 "    return $stash->get_symbol($var);"
NSQ_SOURCE_LINE 00000216 "}"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "sub get_functions {"
NSQ_SOURCE_LINE 00000219 "    my ($pragma, $class) = @_;"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "    my $stash = stash_for($class);"
NSQ_SOURCE_LINE 00000222 "    return {"
NSQ_SOURCE_LINE 00000223 "        map { $_ => $stash->get_symbol(\"&$_\") }"
NSQ_SOURCE_LINE 00000224 "            $stash->list_all_symbols('CODE')"
NSQ_SOURCE_LINE 00000225 "    };"
NSQ_SOURCE_LINE 00000226 "}"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "'Danger! Laws of Thermodynamics may not apply.'"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "__END__"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=head1 NAME"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "namespace::clean - Keep imports and functions out of your namespace"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "  package Foo;"
NSQ_SOURCE_LINE 00000239 "  use warnings;"
NSQ_SOURCE_LINE 00000240 "  use strict;"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "  use Carp qw(croak);   # 'croak' will be removed"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "  sub bar { 23 }        # 'bar' will be removed"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "  # remove all previously defined functions"
NSQ_SOURCE_LINE 00000247 "  use namespace::clean;"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "  sub baz { bar() }     # 'baz' still defined, 'bar' still bound"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "  # begin to collection function names from here again"
NSQ_SOURCE_LINE 00000252 "  no namespace::clean;"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "  sub quux { baz() }    # 'quux' will be removed"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "  # remove all functions defined after the 'no' unimport"
NSQ_SOURCE_LINE 00000257 "  use namespace::clean;"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "  # Will print: 'No', 'No', 'Yes' and 'No'"
NSQ_SOURCE_LINE 00000260 "  print +(__PACKAGE__->can('croak') ? 'Yes' : 'No'), \"\\n\";"
NSQ_SOURCE_LINE 00000261 "  print +(__PACKAGE__->can('bar')   ? 'Yes' : 'No'), \"\\n\";"
NSQ_SOURCE_LINE 00000262 "  print +(__PACKAGE__->can('baz')   ? 'Yes' : 'No'), \"\\n\";"
NSQ_SOURCE_LINE 00000263 "  print +(__PACKAGE__->can('quux')  ? 'Yes' : 'No'), \"\\n\";"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "  1;"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=head2 Keeping packages clean"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "When you define a function, or import one, into a Perl package, it will"
NSQ_SOURCE_LINE 00000272 "naturally also be available as a method. This does not per se cause"
NSQ_SOURCE_LINE 00000273 "problems, but it can complicate subclassing and, for example, plugin"
NSQ_SOURCE_LINE 00000274 "classes that are included via multiple inheritance by loading them as"
NSQ_SOURCE_LINE 00000275 "base classes."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "The C<namespace::clean> pragma will remove all previously declared or"
NSQ_SOURCE_LINE 00000278 "imported symbols at the end of the current package's compile cycle."
NSQ_SOURCE_LINE 00000279 "Functions called in the package itself will still be bound by their"
NSQ_SOURCE_LINE 00000280 "name, but they won't show up as methods on your class or instances."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "By unimporting via C<no> you can tell C<namespace::clean> to start"
NSQ_SOURCE_LINE 00000283 "collecting functions for the next C<use namespace::clean;> specification."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "You can use the C<-except> flag to tell C<namespace::clean> that you"
NSQ_SOURCE_LINE 00000286 "don't want it to remove a certain function or method. A common use would"
NSQ_SOURCE_LINE 00000287 "be a module exporting an C<import> method along with some functions:"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "  use ModuleExportingImport;"
NSQ_SOURCE_LINE 00000290 "  use namespace::clean -except => [qw( import )];"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "If you just want to C<-except> a single sub, you can pass it directly."
NSQ_SOURCE_LINE 00000293 "For more than one value you have to use an array reference."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=head3 Late binding caveat"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "Note that the L<technique used by this module|/IMPLEMENTATION DETAILS> relies"
NSQ_SOURCE_LINE 00000298 "on perl having resolved all names to actual code references during the"
NSQ_SOURCE_LINE 00000299 "compilation of a scope. While this is almost always what the interpreter does,"
NSQ_SOURCE_LINE 00000300 "there are some exceptions, notably the L<sort SUBNAME|perlfunc/sort> style of"
NSQ_SOURCE_LINE 00000301 "the C<sort> built-in invocation. The following example will not work, because"
NSQ_SOURCE_LINE 00000302 "C<sort> does not try to resolve the function name to an actual code reference"
NSQ_SOURCE_LINE 00000303 "until B<runtime>."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 " use MyApp::Utils 'my_sorter';"
NSQ_SOURCE_LINE 00000306 " use namespace::clean;"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 " my @sorted = sort my_sorter @list;"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "You need to work around this by forcing a compile-time resolution like so:"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 " use MyApp::Utils 'my_sorter';"
NSQ_SOURCE_LINE 00000313 " use namespace::clean;"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 " my $my_sorter_cref = \\&my_sorter;"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 " my @sorted = sort $my_sorter_cref @list;"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=head2 Explicitly removing functions when your scope is compiled"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "It is also possible to explicitly tell C<namespace::clean> what packages"
NSQ_SOURCE_LINE 00000322 "to remove when the surrounding scope has finished compiling. Here is an"
NSQ_SOURCE_LINE 00000323 "example:"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "  package Foo;"
NSQ_SOURCE_LINE 00000326 "  use strict;"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "  # blessed NOT available"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "  sub my_class {"
NSQ_SOURCE_LINE 00000331 "      use Scalar::Util qw( blessed );"
NSQ_SOURCE_LINE 00000332 "      use namespace::clean qw( blessed );"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "      # blessed available"
NSQ_SOURCE_LINE 00000335 "      return blessed shift;"
NSQ_SOURCE_LINE 00000336 "  }"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "  # blessed NOT available"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "=head2 Moose"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "When using C<namespace::clean> together with L<Moose> you want to keep"
NSQ_SOURCE_LINE 00000343 "the installed C<meta> method. So your classes should look like:"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "  package Foo;"
NSQ_SOURCE_LINE 00000346 "  use Moose;"
NSQ_SOURCE_LINE 00000347 "  use namespace::clean -except => 'meta';"
NSQ_SOURCE_LINE 00000348 "  ..."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "Same goes for L<Moose::Role>."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=head2 Cleaning other packages"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "You can tell C<namespace::clean> that you want to clean up another package"
NSQ_SOURCE_LINE 00000355 "instead of the one importing. To do this you have to pass in the C<-cleanee>"
NSQ_SOURCE_LINE 00000356 "option like this:"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "  package My::MooseX::namespace::clean;"
NSQ_SOURCE_LINE 00000359 "  use strict;"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "  use namespace::clean (); # no cleanup, just load"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "  sub import {"
NSQ_SOURCE_LINE 00000364 "      namespace::clean->import("
NSQ_SOURCE_LINE 00000365 "        -cleanee => scalar(caller),"
NSQ_SOURCE_LINE 00000366 "        -except  => 'meta',"
NSQ_SOURCE_LINE 00000367 "      );"
NSQ_SOURCE_LINE 00000368 "  }"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "If you don't care about C<namespace::clean>s discover-and-C<-except> logic, and"
NSQ_SOURCE_LINE 00000371 "just want to remove subroutines, try L</clean_subroutines>."
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "=head1 METHODS"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=head2 clean_subroutines"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "This exposes the actual subroutine-removal logic."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "  namespace::clean->clean_subroutines($cleanee, qw( subA subB ));"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "will remove C<subA> and C<subB> from C<$cleanee>. Note that this will remove the"
NSQ_SOURCE_LINE 00000382 "subroutines B<immediately> and not wait for scope end. If you want to have this"
NSQ_SOURCE_LINE 00000383 "effect at a specific time (e.g. C<namespace::clean> acts on scope compile end)"
NSQ_SOURCE_LINE 00000384 "it is your responsibility to make sure it runs at that time."
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "=head2 import"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "Makes a snapshot of the current defined functions and installs a"
NSQ_SOURCE_LINE 00000389 "L<B::Hooks::EndOfScope> hook in the current scope to invoke the cleanups."
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "=head2 unimport"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "This method will be called when you do a"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "  no namespace::clean;"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "It will start a new section of code that defines functions to clean up."
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "=head2 get_class_store"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "This returns a reference to a hash in a passed package containing"
NSQ_SOURCE_LINE 00000403 "information about function names included and excluded from removal."
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "=head2 get_functions"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "Takes a class as argument and returns all currently defined functions"
NSQ_SOURCE_LINE 00000408 "in it as a hash reference with the function name as key and a typeglob"
NSQ_SOURCE_LINE 00000409 "reference to the symbol as value."
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=head1 IMPLEMENTATION DETAILS"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "This module works through the effect that a"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "  delete $SomePackage::{foo};"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "will remove the C<foo> symbol from C<$SomePackage> for run time lookups"
NSQ_SOURCE_LINE 00000418 "(e.g., method calls) but will leave the entry alive to be called by"
NSQ_SOURCE_LINE 00000419 "already resolved names in the package itself. C<namespace::clean> will"
NSQ_SOURCE_LINE 00000420 "restore and therefor in effect keep all glob slots that aren't C<CODE>."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "A test file has been added to the perl core to ensure that this behaviour"
NSQ_SOURCE_LINE 00000423 "will be stable in future releases."
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "Just for completeness sake, if you want to remove the symbol completely,"
NSQ_SOURCE_LINE 00000426 "use C<undef> instead."
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "L<B::Hooks::EndOfScope>"
NSQ_SOURCE_LINE 00000431 ""
