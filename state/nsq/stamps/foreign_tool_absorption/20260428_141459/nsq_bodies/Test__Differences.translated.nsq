BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Test::Differences;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "=encoding utf8"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "=head1 NAME"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "Test::Differences - Test strings and data structures and show differences if not ok"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "   use Test;    ## Or use Test::More"
NSQ_SOURCE_LINE 00000012 "   use Test::Differences;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "   eq_or_diff $got,  \"a\\nb\\nc\\n\",   \"testing strings\";"
NSQ_SOURCE_LINE 00000015 "   eq_or_diff \\@got, [qw( a b c )], \"testing arrays\";"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "   ## Passing options:"
NSQ_SOURCE_LINE 00000018 "   eq_or_diff $got, $expected, $name, { context => 300 };  ## options"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "   ## Using with DBI-like data structures"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "   use DBI;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "   ... open connection & prepare statement and @expected_... here..."
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "   eq_or_diff $sth->fetchall_arrayref, \\@expected_arrays  \"testing DBI arrays\";"
NSQ_SOURCE_LINE 00000027 "   eq_or_diff $sth->fetchall_hashref,  \\@expected_hashes, \"testing DBI hashes\";"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "   ## To force textual or data line numbering (text lines are numbered 1..):"
NSQ_SOURCE_LINE 00000030 "   eq_or_diff_text ...;"
NSQ_SOURCE_LINE 00000031 "   eq_or_diff_data ...;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=head1 EXPORT"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "This module exports three test functions and four diff-style functions:"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=over 4"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=item * Test functions"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=over 4"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=item * C<eq_or_diff>"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=item * C<eq_or_diff_data>"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=item * C<eq_or_diff_text>"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=back"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=item * Diff style functions"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=over 4"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "=item * C<table_diff> (the default)"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=item * C<unified_diff>"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=item * C<oldstyle_diff>"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=item * C<context_diff>"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=back"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "=back"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "When the code you're testing returns multiple lines, records or data"
NSQ_SOURCE_LINE 00000070 "structures and they're just plain wrong, an equivalent to the Unix"
NSQ_SOURCE_LINE 00000071 "C<diff> utility may be just what's needed.  Here's output from an"
NSQ_SOURCE_LINE 00000072 "example test script that checks two text documents and then two"
NSQ_SOURCE_LINE 00000073 "(trivial) data structures:"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 " t/99example....1..3"
NSQ_SOURCE_LINE 00000076 " not ok 1 - differences in text"
NSQ_SOURCE_LINE 00000077 " #     Failed test ((eval 2) at line 14)"
NSQ_SOURCE_LINE 00000078 " #     +---+----------------+----------------+"
NSQ_SOURCE_LINE 00000079 " #     | Ln|Got             |Expected        |"
NSQ_SOURCE_LINE 00000080 " #     +---+----------------+----------------+"
NSQ_SOURCE_LINE 00000081 " #     |  1|this is line 1  |this is line 1  |"
NSQ_SOURCE_LINE 00000082 " #     *  2|this is line 2  |this is line b  *"
NSQ_SOURCE_LINE 00000083 " #     |  3|this is line 3  |this is line 3  |"
NSQ_SOURCE_LINE 00000084 " #     +---+----------------+----------------+"
NSQ_SOURCE_LINE 00000085 " not ok 2 - differences in whitespace"
NSQ_SOURCE_LINE 00000086 " #     Failed test ((eval 2) at line 20)"
NSQ_SOURCE_LINE 00000087 " #     +---+------------------+------------------+"
NSQ_SOURCE_LINE 00000088 " #     | Ln|Got               |Expected          |"
NSQ_SOURCE_LINE 00000089 " #     +---+------------------+------------------+"
NSQ_SOURCE_LINE 00000090 " #     |  1|        indented  |        indented  |"
NSQ_SOURCE_LINE 00000091 " #     *  2|        indented  |\\tindented        *"
NSQ_SOURCE_LINE 00000092 " #     |  3|        indented  |        indented  |"
NSQ_SOURCE_LINE 00000093 " #     +---+------------------+------------------+"
NSQ_SOURCE_LINE 00000094 " not ok 3"
NSQ_SOURCE_LINE 00000095 " #     Failed test ((eval 2) at line 22)"
NSQ_SOURCE_LINE 00000096 " #     +----+-------------------------------------+----------------------------+"
NSQ_SOURCE_LINE 00000097 " #     | Elt|Got                                  |Expected                    |"
NSQ_SOURCE_LINE 00000098 " #     +----+-------------------------------------+----------------------------+"
NSQ_SOURCE_LINE 00000099 " #     *   0|bless( [                             |[                           *"
NSQ_SOURCE_LINE 00000100 " #     *   1|  'Move along, nothing to see here'  |  'Dry, humorless message'  *"
NSQ_SOURCE_LINE 00000101 " #     *   2|], 'Test::Builder' )                 |]                           *"
NSQ_SOURCE_LINE 00000102 " #     +----+-------------------------------------+----------------------------+"
NSQ_SOURCE_LINE 00000103 " # Looks like you failed 3 tests of 3."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "eq_or_diff_...() compares two strings or (limited) data structures and"
NSQ_SOURCE_LINE 00000106 "either emits an ok indication or a side-by-side diff.  Test::Differences"
NSQ_SOURCE_LINE 00000107 "is designed to be used with Test.pm and with Test::Simple, Test::More,"
NSQ_SOURCE_LINE 00000108 "and other Test::Builder based testing modules.  As the SYNOPSIS shows,"
NSQ_SOURCE_LINE 00000109 "another testing module must be used as the basis for your test suite."
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=head1 OPTIONS"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "The options to C<eq_or_diff> give some fine-grained control over the output."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=over 4"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=item * C<context>"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "This allows you to control the amount of context shown:"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "   eq_or_diff $got, $expected, $name, { context => 50000 };"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "will show you lots and lots of context.  Normally, eq_or_diff() uses"
NSQ_SOURCE_LINE 00000124 "some heuristics to determine whether to show 3 lines of context (like"
NSQ_SOURCE_LINE 00000125 "a normal unified diff) or 25 lines."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=item * C<data_type>"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "C<text> or C<data>. This normally defaults to C<data>. If, however, neither of"
NSQ_SOURCE_LINE 00000130 "C<$got> or C<$expected> is a reference then  it defaults to C<text>. You can"
NSQ_SOURCE_LINE 00000131 "also force one or the other by calling C<eq_or_diff_text> or"
NSQ_SOURCE_LINE 00000132 "C<eq_or_diff_data>."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "The difference is that in text mode lines are numbered from 1, but in data mode"
NSQ_SOURCE_LINE 00000135 "from 0 (and are refered to as 'elements' (Elt) instead of lines):"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    # +---+-------+----------+"
NSQ_SOURCE_LINE 00000138 "    # | Ln|Got    |Expected  |"
NSQ_SOURCE_LINE 00000139 "    # +---+-------+----------+"
NSQ_SOURCE_LINE 00000140 "    # *  1|'foo'  |'bar'     *"
NSQ_SOURCE_LINE 00000141 "    # +---+-------+----------+"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    # +----+---------+----+----------+"
NSQ_SOURCE_LINE 00000144 "    # | Elt|Got      | Elt|Expected  |"
NSQ_SOURCE_LINE 00000145 "    # +----+---------+----+----------+"
NSQ_SOURCE_LINE 00000146 "    # *   0|[        *   0|'bar'     *"
NSQ_SOURCE_LINE 00000147 "    # *   1|  'foo'  *    |          |"
NSQ_SOURCE_LINE 00000148 "    # *   2|]        *    |          |"
NSQ_SOURCE_LINE 00000149 "    # +----+---------+----+----------+"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "The difference is purely cosmetic, it makes no difference to how comparisons"
NSQ_SOURCE_LINE 00000152 "are performed."
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "=item * C<Sortkeys>"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "If passed, whatever value is added is used as the argument for L<Data::Dumper>"
NSQ_SOURCE_LINE 00000157 "Sortkeys option. See the L<Data::Dumper> docs to understand how you can"
NSQ_SOURCE_LINE 00000158 "control the Sortkeys behavior."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=item * C<filename_a> and C<filename_b>"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "The column headers to use in the output. They default to 'Got' and 'Expected'."
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=back"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=head1 DIFF STYLES"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "For extremely long strings, a table diff can wrap on your screen and be hard"
NSQ_SOURCE_LINE 00000169 "to read.  If you are comfortable with different diff formats, you can switch"
NSQ_SOURCE_LINE 00000170 "to a format more suitable for your data.  These are the four formats supported"
NSQ_SOURCE_LINE 00000171 "by the L<Text::Diff> module and are set with the following functions:"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=over 4"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=item * C<table_diff> (the default)"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=item * C<unified_diff>"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=item * C<oldstyle_diff>"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=item * C<context_diff>"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=back"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "You can run the following to understand the different diff output styles:"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 " use Test::More 'no_plan';"
NSQ_SOURCE_LINE 00000188 " use Test::Differences;"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 " my $long_string = join '' => 1..40;"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 " TODO: {"
NSQ_SOURCE_LINE 00000193 "     local $TODO = 'Testing diff styles';"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "     # this is the default and does not need to explicitly set unless you need"
NSQ_SOURCE_LINE 00000196 "     # to reset it back from another diff type"
NSQ_SOURCE_LINE 00000197 "     table_diff;"
NSQ_SOURCE_LINE 00000198 "     eq_or_diff $long_string, \"-$long_string\", 'table diff';"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "     unified_diff;"
NSQ_SOURCE_LINE 00000201 "     eq_or_diff $long_string, \"-$long_string\", 'unified diff';"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "     context_diff;"
NSQ_SOURCE_LINE 00000204 "     eq_or_diff $long_string, \"-$long_string\", 'context diff';"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "     oldstyle_diff;"
NSQ_SOURCE_LINE 00000207 "     eq_or_diff $long_string, \"-$long_string\", 'oldstyle diff';"
NSQ_SOURCE_LINE 00000208 " }"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head1 UNICODE"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "Generally you'll find that the following test output is disappointing."
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "    use Test::Differences;"
NSQ_SOURCE_LINE 00000215 "    use utf8;"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "    my $want = { 'Traditional Chinese' => '中國' };"
NSQ_SOURCE_LINE 00000218 "    my $have = { 'Traditional Chinese' => '中国' };"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "    eq_or_diff $have, $want, 'Unicode, baby';"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "Here's what you get:"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "    #   Failed test 'Unicode, baby'"
NSQ_SOURCE_LINE 00000225 "    #   at t/unicode.t line 12."
NSQ_SOURCE_LINE 00000226 "    # +----+-----------------------+-----------------------+"
NSQ_SOURCE_LINE 00000227 "    # | Elt|Got                    |Expected               |"
NSQ_SOURCE_LINE 00000228 "    # +----+-----------------------+-----------------------+"
NSQ_SOURCE_LINE 00000229 "    # |   0|'Traditional Chinese'  |'Traditional Chinese'  |"
NSQ_SOURCE_LINE 00000230 "    # *   1|'\\x{4e2d}\\x{56fd}'     |'\\x{4e2d}\\x{570b}'     *"
NSQ_SOURCE_LINE 00000231 "    # +----+-----------------------+-----------------------+"
NSQ_SOURCE_LINE 00000232 "    # Looks like you failed 1 test of 1."
NSQ_SOURCE_LINE 00000233 "    Dubious, test returned 1 (wstat 256, 0x100)"
NSQ_SOURCE_LINE 00000234 "    Failed 1/1 subtests"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "A patch to fix this would be *most* welcome."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head1 Unknown::Values"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "L<Unknown::Values> is a module which provides values which will never compare as being"
NSQ_SOURCE_LINE 00000241 "the same as anything else, not even the same as itself."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "If code looks too hard at one of these values (and Test::Differences looks very hard indeed)"
NSQ_SOURCE_LINE 00000244 "that is a fatal error. This means that while we can detect the presence of these beasties,"
NSQ_SOURCE_LINE 00000245 "and tell you that they compare different, for Complicated Internals Reasons we can't show you"
NSQ_SOURCE_LINE 00000246 "much context. Sorry."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "NB that the support for these is experimental and relies on an undocumented unstable"
NSQ_SOURCE_LINE 00000249 "interface in Unknown::Values. If that fails then Test::Differences will I<probably> just die"
NSQ_SOURCE_LINE 00000250 "when it sees them instead of telling you that the comparison failed."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=cut"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "our $VERSION = \"0.72\"; # or \"0.001_001\" for a dev release"
NSQ_SOURCE_LINE 00000255 "$VERSION = eval $VERSION;"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "use Exporter;"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "@ISA    = qw( Exporter );"
NSQ_SOURCE_LINE 00000260 "@EXPORT = qw("
NSQ_SOURCE_LINE 00000261 "  eq_or_diff"
NSQ_SOURCE_LINE 00000262 "  eq_or_diff_text"
NSQ_SOURCE_LINE 00000263 "  eq_or_diff_data"
NSQ_SOURCE_LINE 00000264 "  unified_diff"
NSQ_SOURCE_LINE 00000265 "  context_diff"
NSQ_SOURCE_LINE 00000266 "  oldstyle_diff"
NSQ_SOURCE_LINE 00000267 "  table_diff"
NSQ_SOURCE_LINE 00000268 ");"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "use strict;"
NSQ_SOURCE_LINE 00000271 "use warnings;"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "use Carp;"
NSQ_SOURCE_LINE 00000274 "use Text::Diff;"
NSQ_SOURCE_LINE 00000275 "use  Data::Dumper;"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "{"
NSQ_SOURCE_LINE 00000278 "    my $diff_style = 'Table';"
NSQ_SOURCE_LINE 00000279 "    my %allowed_style = map { $_ => 1 } qw/Unified Context OldStyle Table/;"
NSQ_SOURCE_LINE 00000280 "    sub _diff_style {"
NSQ_SOURCE_LINE 00000281 "        return $diff_style unless @_;"
NSQ_SOURCE_LINE 00000282 "        my $requested_style = shift;"
NSQ_SOURCE_LINE 00000283 "        unless ( $allowed_style{$requested_style} ) {"
NSQ_SOURCE_LINE 00000284 "           Carp::croak(\"Uknown style ($requested_style) requested for diff\");"
NSQ_SOURCE_LINE 00000285 "        }"
NSQ_SOURCE_LINE 00000286 "        $diff_style = $requested_style;"
NSQ_SOURCE_LINE 00000287 "    }"
NSQ_SOURCE_LINE 00000288 "}"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "sub unified_diff  { _diff_style('Unified') }"
NSQ_SOURCE_LINE 00000291 "sub context_diff  { _diff_style('Context') }"
NSQ_SOURCE_LINE 00000292 "sub oldstyle_diff { _diff_style('OldStyle') }"
NSQ_SOURCE_LINE 00000293 "sub table_diff    { _diff_style('Table') }"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "sub _identify_callers_test_package_of_choice {"
NSQ_SOURCE_LINE 00000296 "    ## This is called at each test in case Test::Differences was used before"
NSQ_SOURCE_LINE 00000297 "    ## the base testing modules."
NSQ_SOURCE_LINE 00000298 "    ## First see if %INC tells us much of interest."
NSQ_SOURCE_LINE 00000299 "    my $has_builder_pm = grep $_ eq \"Test/Builder.pm\", keys %INC;"
NSQ_SOURCE_LINE 00000300 "    my $has_test_pm    = grep $_ eq \"Test.pm\",         keys %INC;"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "    return \"Test\"          if $has_test_pm  && !$has_builder_pm;"
NSQ_SOURCE_LINE 00000303 "    return \"Test::Builder\" if !$has_test_pm && $has_builder_pm;"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "    if ( $has_test_pm && $has_builder_pm ) {"
NSQ_SOURCE_LINE 00000306 "        ## TODO: Look in caller's namespace for hints.  For now, assume Builder."
NSQ_SOURCE_LINE 00000307 "        ## This should only ever be an issue if multiple test suites end"
NSQ_SOURCE_LINE 00000308 "        ## up in memory at once."
NSQ_SOURCE_LINE 00000309 "        return \"Test::Builder\";"
NSQ_SOURCE_LINE 00000310 "    }"
NSQ_SOURCE_LINE 00000311 "}"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "my $warned_of_unknown_test_lib;"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "sub eq_or_diff_text { $_[3] = { data_type => \"text\" }; goto &eq_or_diff; }"
NSQ_SOURCE_LINE 00000316 "sub eq_or_diff_data { $_[3] = { data_type => \"data\" }; goto &eq_or_diff; }"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "## This string is a cheat: it's used to see if the two arrays of values"
NSQ_SOURCE_LINE 00000319 "## are identical.  The stringified values are joined using this joint"
NSQ_SOURCE_LINE 00000320 "## and compared using eq.  This is a deep equality comparison for"
NSQ_SOURCE_LINE 00000321 "## references and a shallow one for scalars."
NSQ_SOURCE_LINE 00000322 "my $joint = chr(0) . \"A\" . chr(1);"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "sub _isnt_ARRAY_of_scalars {"
NSQ_SOURCE_LINE 00000325 "    return 1 if ref ne \"ARRAY\";"
NSQ_SOURCE_LINE 00000326 "    return scalar grep ref, @$_;"
NSQ_SOURCE_LINE 00000327 "}"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "sub _isnt_HASH_of_scalars {"
NSQ_SOURCE_LINE 00000330 "    return 1 if ref ne \"HASH\";"
NSQ_SOURCE_LINE 00000331 "    return scalar grep ref, values %$_;"
NSQ_SOURCE_LINE 00000332 "}"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "use constant ARRAY_of_scalars           => \"ARRAY of scalars\";"
NSQ_SOURCE_LINE 00000335 "use constant ARRAY_of_ARRAYs_of_scalars => \"ARRAY of ARRAYs of scalars\";"
NSQ_SOURCE_LINE 00000336 "use constant ARRAY_of_HASHes_of_scalars => \"ARRAY of HASHes of scalars\";"
NSQ_SOURCE_LINE 00000337 "use constant HASH_of_scalars            => \"HASH of scalars\";"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "sub _grok_type {"
NSQ_SOURCE_LINE 00000340 "    local $_ = shift if @_;"
NSQ_SOURCE_LINE 00000341 "    return \"SCALAR\" unless ref;"
NSQ_SOURCE_LINE 00000342 "    if ( ref eq \"ARRAY\" ) {"
NSQ_SOURCE_LINE 00000343 "        return undef unless @$_;"
NSQ_SOURCE_LINE 00000344 "        return ARRAY_of_scalars"
NSQ_SOURCE_LINE 00000345 "          unless _isnt_ARRAY_of_scalars;"
NSQ_SOURCE_LINE 00000346 "        return ARRAY_of_ARRAYs_of_scalars"
NSQ_SOURCE_LINE 00000347 "          unless grep _isnt_ARRAY_of_scalars, @$_;"
NSQ_SOURCE_LINE 00000348 "        return ARRAY_of_HASHes_of_scalars"
NSQ_SOURCE_LINE 00000349 "          unless grep _isnt_HASH_of_scalars, @$_;"
NSQ_SOURCE_LINE 00000350 "        return 0;"
NSQ_SOURCE_LINE 00000351 "    }"
NSQ_SOURCE_LINE 00000352 "    elsif ( ref eq 'HASH' ) {"
NSQ_SOURCE_LINE 00000353 "        return HASH_of_scalars"
NSQ_SOURCE_LINE 00000354 "          unless _isnt_HASH_of_scalars($_);"
NSQ_SOURCE_LINE 00000355 "        return 0;"
NSQ_SOURCE_LINE 00000356 "    }"
NSQ_SOURCE_LINE 00000357 "}"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "sub eq_or_diff {"
NSQ_SOURCE_LINE 00000360 "    my ( @vals, $name, $options );"
NSQ_SOURCE_LINE 00000361 "    $options = pop if @_ > 2 && ref $_[-1];"
NSQ_SOURCE_LINE 00000362 "    ( $vals[0], $vals[1], $name ) = @_;"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "    my @types = map { _grok_type($_) } @vals;"
NSQ_SOURCE_LINE 00000365 "    my $dump_it = !$types[0] || !$types[1];"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "    my($data_type, $filename_a, $filename_b);"
NSQ_SOURCE_LINE 00000368 "    if($options) {"
NSQ_SOURCE_LINE 00000369 "        $data_type  = $options->{data_type};"
NSQ_SOURCE_LINE 00000370 "        $filename_a = $options->{filename_a};"
NSQ_SOURCE_LINE 00000371 "        $filename_b = $options->{filename_b};"
NSQ_SOURCE_LINE 00000372 "    }"
NSQ_SOURCE_LINE 00000373 "    $data_type ||= \"text\" unless ref $vals[0] || ref $vals[1];"
NSQ_SOURCE_LINE 00000374 "    $data_type ||= \"data\";"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "    $filename_a ||= 'Got';"
NSQ_SOURCE_LINE 00000377 "    $filename_b ||= 'Expected';"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "    my @widths;"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "    local $Data::Dumper::Deparse   = 1"
NSQ_SOURCE_LINE 00000382 "        unless($Test::Differences::NoDeparse);"
NSQ_SOURCE_LINE 00000383 "    local $Data::Dumper::Indent    = 1;"
NSQ_SOURCE_LINE 00000384 "    local $Data::Dumper::Purity    = 0;"
NSQ_SOURCE_LINE 00000385 "    local $Data::Dumper::Terse     = 1;"
NSQ_SOURCE_LINE 00000386 "    local $Data::Dumper::Deepcopy  = 1;"
NSQ_SOURCE_LINE 00000387 "    local $Data::Dumper::Quotekeys = 0;"
NSQ_SOURCE_LINE 00000388 "    local $Data::Dumper::Useperl   = 1;"
NSQ_SOURCE_LINE 00000389 "    local $Data::Dumper::Sortkeys ="
NSQ_SOURCE_LINE 00000390 "        exists $options->{Sortkeys} ? $options->{Sortkeys} : 1;"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "    my $unknown_value_in_got;"
NSQ_SOURCE_LINE 00000393 "    my $unknown_value_in_expected;"
NSQ_SOURCE_LINE 00000394 "    my @unknown_flags = (\\$unknown_value_in_got, \\$unknown_value_in_expected);"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "    my($got, $expected) = map {"
NSQ_SOURCE_LINE 00000397 "        my $t = eval { [ split /^/, Data::Dumper::Dumper($_) ] };"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "        my $unknown_flag = shift(@unknown_flags);"
NSQ_SOURCE_LINE 00000400 "        if($@ =~ /^Dereferencing cannot be performed on unknown values at .*Unknown.Values.Instance/) {"
NSQ_SOURCE_LINE 00000401 "            ${$unknown_flag} = 1;"
NSQ_SOURCE_LINE 00000402 "        }"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "        $t;"
NSQ_SOURCE_LINE 00000405 "    } @vals;"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "    my $passed ="
NSQ_SOURCE_LINE 00000410 "        !defined($unknown_value_in_got) &&"
NSQ_SOURCE_LINE 00000411 "        !defined($unknown_value_in_expected) &&"
NSQ_SOURCE_LINE 00000412 "        join( $joint, @$got ) eq join( $joint, @$expected );"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "    my $diff;"
NSQ_SOURCE_LINE 00000415 "    unless ($passed) {"
NSQ_SOURCE_LINE 00000416 "        if($unknown_value_in_got) { $got = \\\"got something containing an Unknown::Values::unknown value\" };"
NSQ_SOURCE_LINE 00000417 "        if($unknown_value_in_expected) { $expected = \\\"expected something containing an Unknown::Values::unknown value\" };"
NSQ_SOURCE_LINE 00000418 "        my $context;"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "        $context = $options->{context}"
NSQ_SOURCE_LINE 00000421 "          if exists $options->{context};"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "        $context = $dump_it ? 2**31 : grep( @$_ > 25, $got, $expected ) ? 3 : 25"
NSQ_SOURCE_LINE 00000424 "            unless defined $context;"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "        confess \"context must be an integer: '$context'\\n\""
NSQ_SOURCE_LINE 00000427 "          unless $context =~ /\\A\\d+\\z/;"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "        $diff = diff $got, $expected,"
NSQ_SOURCE_LINE 00000430 "          { CONTEXT     => $context,"
NSQ_SOURCE_LINE 00000431 "            STYLE       => _diff_style(),"
NSQ_SOURCE_LINE 00000432 "            FILENAME_A  => $filename_a,"
NSQ_SOURCE_LINE 00000433 "            FILENAME_B  => $filename_b,"
NSQ_SOURCE_LINE 00000434 "            OFFSET_A    => $data_type eq \"text\" ? 1 : 0,"
NSQ_SOURCE_LINE 00000435 "            OFFSET_B    => $data_type eq \"text\" ? 1 : 0,"
NSQ_SOURCE_LINE 00000436 "            INDEX_LABEL => $data_type eq \"text\" ? \"Ln\" : \"Elt\","
NSQ_SOURCE_LINE 00000437 "          };"
NSQ_SOURCE_LINE 00000438 "        chomp $diff;"
NSQ_SOURCE_LINE 00000439 "        $diff .= \"\\n\";"
NSQ_SOURCE_LINE 00000440 "    }"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "    my $which = _identify_callers_test_package_of_choice;"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "    if ( $which eq \"Test\" ) {"
NSQ_SOURCE_LINE 00000445 "        @_"
NSQ_SOURCE_LINE 00000446 "          = $passed"
NSQ_SOURCE_LINE 00000447 "          ? ( \"\", \"\", $name )"
NSQ_SOURCE_LINE 00000448 "          : ( \"\\n$diff\", \"No differences\", $name );"
NSQ_SOURCE_LINE 00000449 "        goto &Test::ok;"
NSQ_SOURCE_LINE 00000450 "    }"
NSQ_SOURCE_LINE 00000451 "    elsif ( $which eq \"Test::Builder\" ) {"
NSQ_SOURCE_LINE 00000452 "        my $test = Test::Builder->new;"
NSQ_SOURCE_LINE 00000453 "        ## TODO: Call exported_to here?  May not need to because the caller"
NSQ_SOURCE_LINE 00000454 "        ## should have imported something based on Test::Builder already."
NSQ_SOURCE_LINE 00000455 "        $test->ok( $passed, $name );"
NSQ_SOURCE_LINE 00000456 "        $test->diag($diff) unless $passed;"
NSQ_SOURCE_LINE 00000457 "    }"
NSQ_SOURCE_LINE 00000458 "    else {"
NSQ_SOURCE_LINE 00000459 "        unless ($warned_of_unknown_test_lib) {"
NSQ_SOURCE_LINE 00000460 "            Carp::cluck"
NSQ_SOURCE_LINE 00000461 "              \"Can't identify test lib in use, doesn't seem to be Test.pm or Test::Builder based\\n\";"
NSQ_SOURCE_LINE 00000462 "            $warned_of_unknown_test_lib = 1;"
NSQ_SOURCE_LINE 00000463 "        }"
NSQ_SOURCE_LINE 00000464 "        ## Play dumb and hope nobody notices the fool drooling in the corner"
NSQ_SOURCE_LINE 00000465 "        if ($passed) {"
NSQ_SOURCE_LINE 00000466 "            print \"ok\\n\";"
NSQ_SOURCE_LINE 00000467 "        }"
NSQ_SOURCE_LINE 00000468 "        else {"
NSQ_SOURCE_LINE 00000469 "            $diff =~ s/^/# /gm;"
NSQ_SOURCE_LINE 00000470 "            print \"not ok\\n\", $diff;"
NSQ_SOURCE_LINE 00000471 "        }"
NSQ_SOURCE_LINE 00000472 "    }"
NSQ_SOURCE_LINE 00000473 "}"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "=head2 C<Test> or C<Test::More>"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "This module \"mixes in\" with Test.pm or any of the test libraries based on"
NSQ_SOURCE_LINE 00000480 "Test::Builder (Test::Simple, Test::More, etc).  It does this by peeking to see"
NSQ_SOURCE_LINE 00000481 "whether Test.pm or Test/Builder.pm is in %INC, so if you are not using one of"
NSQ_SOURCE_LINE 00000482 "those, it will print a warning and play dumb by not emitting test numbers (or"
NSQ_SOURCE_LINE 00000483 "incrementing them).  If you are using one of these, it should interoperate"
NSQ_SOURCE_LINE 00000484 "nicely."
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "=head2 Exporting"
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "Exports all 3 functions by default (and by design).  Use"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "    use Test::Differences ();"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "to suppress this behavior if you don't like the namespace pollution."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "This module will not override functions like ok(), is(), is_deeply(), etc.  If"
NSQ_SOURCE_LINE 00000495 "it did, then you could C<eval \"use Test::Differences qw( is_deeply );\"> to get"
NSQ_SOURCE_LINE 00000496 "automatic upgrading to diffing behaviors without the C<sub my_ok> shown above."
NSQ_SOURCE_LINE 00000497 "Test::Differences intentionally does not provide this behavior because this"
NSQ_SOURCE_LINE 00000498 "would mean that Test::Differences would need to emulate every popular test"
NSQ_SOURCE_LINE 00000499 "module out there, which would require far more coding and maintenance that I'm"
NSQ_SOURCE_LINE 00000500 "willing to do.  Use the eval and my_ok deployment shown above if you want some"
NSQ_SOURCE_LINE 00000501 "level of automation."
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "=head2 Booleans"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "Historically, true and false (whether resulting from logical-not C<!> or from"
NSQ_SOURCE_LINE 00000506 "equality checks like C<==>) were represented in perl as numeric C<1> for true"
NSQ_SOURCE_LINE 00000507 "and the empty string C<''> for false. In perl 5.36.0 they became real Boolean"
NSQ_SOURCE_LINE 00000508 "values which for backward compatibility also have their old numeric/string"
NSQ_SOURCE_LINE 00000509 "values. In 5.38 (and in dev releases from 5.37.2 onwards) L<Data::Dumper>"
NSQ_SOURCE_LINE 00000510 "belatedly learned about this, and so Test::Differences (which uses Data::Dumper"
NSQ_SOURCE_LINE 00000511 "under the bonnet) can also tell the difference."
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "This means that `eq_or_diff(1, !!1)` will behave differently depending on"
NSQ_SOURCE_LINE 00000514 "whether you are using perl 5.38 or later (in which case it will say they are"
NSQ_SOURCE_LINE 00000515 "different) or 5.36 or earlier (which will say they are the same)."
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=head2 Unicode"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "Perls before 5.6.0 don't support characters > 255 at all, and 5.6.0"
NSQ_SOURCE_LINE 00000520 "seems broken.  This means that you might get odd results using perl5.6.0"
NSQ_SOURCE_LINE 00000521 "with unicode strings."
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "=head2 C<Data::Dumper> and older Perls."
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "Relies on Data::Dumper (for now), which, prior to perl5.8, will not always"
NSQ_SOURCE_LINE 00000526 "report hashes in the same order.  C< $Data::Dumper::Sortkeys > I<is> set to 1,"
NSQ_SOURCE_LINE 00000527 "so on more recent versions of Data::Dumper, this should not occur.  Check CPAN"
NSQ_SOURCE_LINE 00000528 "to see if it's been peeled out of the main perl distribution and backported."
NSQ_SOURCE_LINE 00000529 "Reported by Ilya Martynov <ilya@martynov.org>, although the Sortkeys \"future"
NSQ_SOURCE_LINE 00000530 "perfect\" workaround has been set in anticipation of a new Data::Dumper for a"
NSQ_SOURCE_LINE 00000531 "while.  Note that the two hashes should report the same here:"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "    not ok 5"
NSQ_SOURCE_LINE 00000534 "    #     Failed test (t/ctrl/05-home.t at line 51)"
NSQ_SOURCE_LINE 00000535 "    # +----+------------------------+----+------------------------+"
NSQ_SOURCE_LINE 00000536 "    # | Elt|Got                     | Elt|Expected                |"
NSQ_SOURCE_LINE 00000537 "    # +----+------------------------+----+------------------------+"
NSQ_SOURCE_LINE 00000538 "    # |   0|{                       |   0|{                       |"
NSQ_SOURCE_LINE 00000539 "    # |   1|  'password' => '',     |   1|  'password' => '',     |"
NSQ_SOURCE_LINE 00000540 "    # *   2|  'method' => 'login',  *    |                        |"
NSQ_SOURCE_LINE 00000541 "    # |   3|  'ctrl' => 'home',     |   2|  'ctrl' => 'home',     |"
NSQ_SOURCE_LINE 00000542 "    # |    |                        *   3|  'method' => 'login',  *"
NSQ_SOURCE_LINE 00000543 "    # |   4|  'email' => 'test'     |   4|  'email' => 'test'     |"
NSQ_SOURCE_LINE 00000544 "    # |   5|}                       |   5|}                       |"
NSQ_SOURCE_LINE 00000545 "    # +----+------------------------+----+------------------------+"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "Data::Dumper also overlooks the difference between"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "    $a[0] = \\$a[1];"
NSQ_SOURCE_LINE 00000550 "    $a[1] = \\$a[0];   # $a[0] = \\$a[1]"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "and"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "    $x = \\$y;"
NSQ_SOURCE_LINE 00000555 "    $y = \\$x;"
NSQ_SOURCE_LINE 00000556 "    @a = ( $x, $y );  # $a[0] = \\$y, not \\$a[1]"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "The former involves two scalars, the latter 4: $x, $y, and @a[0,1]."
NSQ_SOURCE_LINE 00000559 "This was carefully explained to me in words of two syllables or less by"
NSQ_SOURCE_LINE 00000560 "Yves Orton <demerphq@hotmail.com>.  The plan to address this is to allow"
NSQ_SOURCE_LINE 00000561 "you to select Data::Denter or some other module of your choice as an"
NSQ_SOURCE_LINE 00000562 "option."
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "=head2 Code-refs"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "Test::Differences turns on C<$Data::Dumper::Deparse>, so any code-refs in your"
NSQ_SOURCE_LINE 00000567 "data structures will be turned into text before they are examined, using"
NSQ_SOURCE_LINE 00000568 "L<B::Deparse>. The precise text generated for a sub-ref might not be what you"
NSQ_SOURCE_LINE 00000569 "expect as it is generated from the compiled version of the code, but it should"
NSQ_SOURCE_LINE 00000570 "at least be consistent and spot differences correctly."
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "You can turn this behaviour off by setting C<$Test::Differences::NoDeparse>."
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "=head1 AUTHORS"
