NSQ_SOURCE_LINE 00000248 ");"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "our @BACKENDS = sort keys %BACKEND_FEATURES;"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "sub _encode {"
NSQ_SOURCE_LINE 00000253 "    my $val = shift;"
NSQ_SOURCE_LINE 00000254 "    $val =~ s/([\\\\\"])/\\\\$1/g;"
NSQ_SOURCE_LINE 00000255 "    \"\\\"$val\\\"\";"
NSQ_SOURCE_LINE 00000256 "}"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "sub backends {"
NSQ_SOURCE_LINE 00000259 "    @BACKENDS;"
NSQ_SOURCE_LINE 00000260 "}"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "sub generate_table {"
NSQ_SOURCE_LINE 00000263 "    my %params = @_;"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "    my $rows          = $params{rows} or die \"Must provide rows!\";"
NSQ_SOURCE_LINE 00000266 "    my $backend       = $params{backend} || 'Text::Table::Sprintf';"
NSQ_SOURCE_LINE 00000267 "    my $header_row    = $params{header_row} // 0;"
NSQ_SOURCE_LINE 00000268 "    my $separate_rows = $params{separate_rows} // 0;"
NSQ_SOURCE_LINE 00000269 "    my $align         = $params{align};"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "    if ($backend eq 'Term::Table') {"
NSQ_SOURCE_LINE 00000272 "        require Term::Table;"
NSQ_SOURCE_LINE 00000273 "        my ($header, $data_rows);"
NSQ_SOURCE_LINE 00000274 "        if ($header_row) {"
NSQ_SOURCE_LINE 00000275 "            $header = $rows->[0];"
NSQ_SOURCE_LINE 00000276 "            $data_rows = [ @{$rows}[1 .. $#{$rows}] ];"
NSQ_SOURCE_LINE 00000277 "        } else {"
NSQ_SOURCE_LINE 00000278 "            $header = [ map {\"col$_\"} 0..$#{$rows->[0]} ];"
NSQ_SOURCE_LINE 00000279 "            $data_rows = $rows;"
NSQ_SOURCE_LINE 00000280 "        }"
NSQ_SOURCE_LINE 00000281 "        my $table = Term::Table->new("
NSQ_SOURCE_LINE 00000282 "            header => $header,"
NSQ_SOURCE_LINE 00000283 "            rows   => $data_rows,"
NSQ_SOURCE_LINE 00000284 "        );"
NSQ_SOURCE_LINE 00000285 "        return join(\"\\n\", $table->render).\"\\n\";"
NSQ_SOURCE_LINE 00000286 "    } elsif ($backend eq 'Term::TablePrint') {"
NSQ_SOURCE_LINE 00000287 "        require Term::TablePrint;"
NSQ_SOURCE_LINE 00000288 "        my $rows2;"
NSQ_SOURCE_LINE 00000289 "        if ($header_row) {"
NSQ_SOURCE_LINE 00000290 "            $rows2 = $rows;"
NSQ_SOURCE_LINE 00000291 "        } else {"
NSQ_SOURCE_LINE 00000292 "            $rows2 = [@$rows];"
NSQ_SOURCE_LINE 00000293 "            shift @$rows2;"
NSQ_SOURCE_LINE 00000294 "        }"
NSQ_SOURCE_LINE 00000295 "        return Term::TablePrint::print_table($rows);"
NSQ_SOURCE_LINE 00000296 "    } elsif ($backend eq 'Text::ANSITable') {"
NSQ_SOURCE_LINE 00000297 "        require Text::ANSITable;"
NSQ_SOURCE_LINE 00000298 "        my $t = Text::ANSITable->new("
NSQ_SOURCE_LINE 00000299 "            use_utf8 => 0,"
NSQ_SOURCE_LINE 00000300 "            use_box_chars => 0,"
NSQ_SOURCE_LINE 00000301 "            use_color => 0,"
NSQ_SOURCE_LINE 00000302 "            border_style => 'ASCII::SingleLine',"
NSQ_SOURCE_LINE 00000303 "            ($align && !ref($align) ? (cell_align => ($align eq 'r' ? 'right' : $align eq 'c' ? 'middle' : 'left')) : ()),"
NSQ_SOURCE_LINE 00000304 "        );"
NSQ_SOURCE_LINE 00000305 "        # XXX pick an appropriate border style when header_row=0"
NSQ_SOURCE_LINE 00000306 "        if ($header_row) {"
NSQ_SOURCE_LINE 00000307 "            $t->columns($rows->[0]);"
NSQ_SOURCE_LINE 00000308 "            $t->add_row($rows->[$_]) for 1..@$rows-1;"
NSQ_SOURCE_LINE 00000309 "        } else {"
NSQ_SOURCE_LINE 00000310 "            $t->columns([ map {\"col$_\"} 0..$#{$rows->[0]} ]);"
NSQ_SOURCE_LINE 00000311 "            $t->add_row($_) for @$rows;"
NSQ_SOURCE_LINE 00000312 "        }"
NSQ_SOURCE_LINE 00000313 "        $t->show_row_separator(1) if $separate_rows;"
NSQ_SOURCE_LINE 00000314 "        if (ref $align) {"
NSQ_SOURCE_LINE 00000315 "            for my $i (0 .. @{$rows->[0]}-1) {"
NSQ_SOURCE_LINE 00000316 "                my $col_align = $align->[$i];"
NSQ_SOURCE_LINE 00000317 "                next unless $col_align;"
NSQ_SOURCE_LINE 00000318 "                $t->set_column_style($i, align => ($col_align eq 'r' ? 'right' : $col_align eq 'c' ? 'middle' : 'left'));"
NSQ_SOURCE_LINE 00000319 "            }"
NSQ_SOURCE_LINE 00000320 "        }"
NSQ_SOURCE_LINE 00000321 "        return $t->draw;"
NSQ_SOURCE_LINE 00000322 "    } elsif ($backend eq 'Text::ASCIITable') {"
NSQ_SOURCE_LINE 00000323 "        require Text::ASCIITable;"
NSQ_SOURCE_LINE 00000324 "        my $t = Text::ASCIITable->new();"
NSQ_SOURCE_LINE 00000325 "        my @colnames;"
NSQ_SOURCE_LINE 00000326 "        if ($header_row) {"
NSQ_SOURCE_LINE 00000327 "            @colnames = @{ $rows->[0] };"
NSQ_SOURCE_LINE 00000328 "            $t->setCols(@colnames);"
NSQ_SOURCE_LINE 00000329 "            $t->addRow(@{ $rows->[$_] }) for 1..@$rows-1;"
NSQ_SOURCE_LINE 00000330 "        } else {"
NSQ_SOURCE_LINE 00000331 "            @colnames = map { \"col$_\" } 0..$#{ $rows->[0] };"
NSQ_SOURCE_LINE 00000332 "            $t->setCols(@colnames);"
NSQ_SOURCE_LINE 00000333 "            $t->addRow(@$_) for @$rows;"
NSQ_SOURCE_LINE 00000334 "        }"
NSQ_SOURCE_LINE 00000335 "        if ($align) {"
NSQ_SOURCE_LINE 00000336 "            for my $i (ref $align ? (0 .. $#{$align}) : (0 .. @colnames-1)) {"
NSQ_SOURCE_LINE 00000337 "                my $colname = $colnames[$i];"
NSQ_SOURCE_LINE 00000338 "                my $col_align = ref $align ? $align->[$i] : $align;"
NSQ_SOURCE_LINE 00000339 "                my $align_val = ($col_align eq 'r' ? 'right' : $col_align eq 'c' ? 'center' : 'left');"
NSQ_SOURCE_LINE 00000340 "                #say \"D:aligning col: $colname -> $align_val\";"
NSQ_SOURCE_LINE 00000341 "                $t->alignCol($colname, $align_val);"
NSQ_SOURCE_LINE 00000342 "            }"
NSQ_SOURCE_LINE 00000343 "        }"
NSQ_SOURCE_LINE 00000344 "        return \"$t\";"
NSQ_SOURCE_LINE 00000345 "    } elsif ($backend eq 'Text::FormatTable') {"
NSQ_SOURCE_LINE 00000346 "        require Text::FormatTable;"
NSQ_SOURCE_LINE 00000347 "        my @formats = ('l') x @{ $rows->[0] };"
NSQ_SOURCE_LINE 00000348 "        if ($align) {"
NSQ_SOURCE_LINE 00000349 "            if (ref $align) {"
NSQ_SOURCE_LINE 00000350 "                for my $i (0 .. @{$align}-1) {"
NSQ_SOURCE_LINE 00000351 "                    my $col_align = $align->[$i];"
NSQ_SOURCE_LINE 00000352 "                    $formats[$i] = $col_align eq 'r' ? 'r' : 'l';"
NSQ_SOURCE_LINE 00000353 "                }"
NSQ_SOURCE_LINE 00000354 "            } else {"
NSQ_SOURCE_LINE 00000355 "                @formats = ($align eq 'r' ? 'r' : 'l') x @{ $rows->[0] };"
NSQ_SOURCE_LINE 00000356 "            }"
NSQ_SOURCE_LINE 00000357 "        }"
NSQ_SOURCE_LINE 00000358 "        #use DD; dd \\@formats;"
NSQ_SOURCE_LINE 00000359 "        my $t = Text::FormatTable->new(join('|', @formats));"
NSQ_SOURCE_LINE 00000360 "        $t->head(@{ $rows->[0] });"
NSQ_SOURCE_LINE 00000361 "        $t->row(@{ $rows->[$_] }) for 1..@$rows-1;"
NSQ_SOURCE_LINE 00000362 "        return $t->render;"
NSQ_SOURCE_LINE 00000363 "    } elsif ($backend eq 'Text::MarkdownTable') {"
NSQ_SOURCE_LINE 00000364 "        require Text::MarkdownTable;"
NSQ_SOURCE_LINE 00000365 "        my $out = \"\";"
NSQ_SOURCE_LINE 00000366 "        my $fields =  $header_row ?"
NSQ_SOURCE_LINE 00000367 "            $rows->[0] : [map {\"col$_\"} 0..$#{ $rows->[0] }];"
NSQ_SOURCE_LINE 00000368 "        my $t = Text::MarkdownTable->new(file => \\$out, columns => $fields);"
NSQ_SOURCE_LINE 00000369 "        foreach (($header_row ? 1:0) .. $#{$rows}) {"
NSQ_SOURCE_LINE 00000370 "            my $row = $rows->[$_];"
NSQ_SOURCE_LINE 00000371 "            $t->add( {"
NSQ_SOURCE_LINE 00000372 "                map { $fields->[$_] => $row->[$_] } 0..@$fields-1"
