NSQ_SOURCE_LINE 00000605 "1;"
NSQ_SOURCE_LINE 00000606 "# ABSTRACT: Generate text table using one of several backends"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "__END__"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "=pod"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "=head1 NAME"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "Text::Table::Any - Generate text table using one of several backends"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "=head1 VERSION"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "This document describes version 0.117 of Text::Table::Any (from Perl distribution Text-Table-Any), released on 2023-11-11."
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 " use Text::Table::Any qw/generate_table/;"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 " my $rows = ["
NSQ_SOURCE_LINE 00000627 "     # first element is header row"
NSQ_SOURCE_LINE 00000628 "     ['Distribution', 'Author', 'First Version', 'Latest Version', 'Abstract'],"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "     # subsequent elements are data rows"
NSQ_SOURCE_LINE 00000631 "     ['ACME-Dzil-Test-daemon', 'DAEMON', '0.001', '0.001', 'Module abstract placeholder text'],"
NSQ_SOURCE_LINE 00000632 "     ['ACME-Dzil-Test-daemon2', 'DAEMON', '0.001', '0.001', 'Module abstract placeholder text'],"
NSQ_SOURCE_LINE 00000633 "     ['Acme-CPANModules-ShellCompleters', 'PERLANCAR', '0.001', '0.001', 'Modules that provide shell tab completion for other commands/scripts'],"
NSQ_SOURCE_LINE 00000634 "     ['Acme-CPANModules-WorkingWithURL', 'PERLANCAR', '0.001', '0.001', 'Working with URL'],"
NSQ_SOURCE_LINE 00000635 " ];"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 " print generate_table(rows => $rows);"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "will render the table using the default backend L<Text::Table::Sprintf> and"
NSQ_SOURCE_LINE 00000640 "print something like:"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 " +----------------------------------+-----------+---------------+----------------+----------------------------------------------------------------------+"
NSQ_SOURCE_LINE 00000643 " | Distribution                     | Author    | First Version | Latest Version | Abstract                                                             |"
NSQ_SOURCE_LINE 00000644 " +----------------------------------+-----------+---------------+----------------+----------------------------------------------------------------------+"
NSQ_SOURCE_LINE 00000645 " | ACME-Dzil-Test-daemon            | DAEMON    | 0.001         | 0.001          | Module abstract placeholder text                                     |"
NSQ_SOURCE_LINE 00000646 " | ACME-Dzil-Test-daemon2           | DAEMON    | 0.001         | 0.001          | Module abstract placeholder text                                     |"
NSQ_SOURCE_LINE 00000647 " | Acme-CPANModules-ShellCompleters | PERLANCAR | 0.001         | 0.001          | Modules that provide shell tab completion for other commands/scripts |"
NSQ_SOURCE_LINE 00000648 " | Acme-CPANModules-WorkingWithURL  | PERLANCAR | 0.001         | 0.001          | Working with URL                                                     |"
NSQ_SOURCE_LINE 00000649 " +----------------------------------+-----------+---------------+----------------+----------------------------------------------------------------------+"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "To pick another backend:"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 " print generate_table("
NSQ_SOURCE_LINE 00000654 "     rows => $rows,"
NSQ_SOURCE_LINE 00000655 "     backend => \"Text::Table::Org\","
NSQ_SOURCE_LINE 00000656 " );"
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "The result is something like:"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 " | Distribution                     | Author    | First Version | Latest Version | Abstract                                                             |"
NSQ_SOURCE_LINE 00000661 " |----------------------------------+-----------+---------------+----------------+----------------------------------------------------------------------|"
NSQ_SOURCE_LINE 00000662 " | ACME-Dzil-Test-daemon            | DAEMON    | 0.001         | 0.001          | Module abstract placeholder text                                     |"
NSQ_SOURCE_LINE 00000663 " | ACME-Dzil-Test-daemon2           | DAEMON    | 0.001         | 0.001          | Module abstract placeholder text                                     |"
NSQ_SOURCE_LINE 00000664 " | Acme-CPANModules-ShellCompleters | PERLANCAR | 0.001         | 0.001          | Modules that provide shell tab completion for other commands/scripts |"
NSQ_SOURCE_LINE 00000665 " | Acme-CPANModules-WorkingWithURL  | PERLANCAR | 0.001         | 0.001          | Working with URL                                                     |"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "To specify some other options:"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 " print generate_table("
NSQ_SOURCE_LINE 00000670 "     rows => $rows,"
NSQ_SOURCE_LINE 00000671 "     header_row => 0,   # default is true"
NSQ_SOURCE_LINE 00000672 "     separate_rows => 1, # default is false"
NSQ_SOURCE_LINE 00000673 "     caption => \"Some of the new distributions released in Jan 2022\","
NSQ_SOURCE_LINE 00000674 "     backend => \"Text::Table::Org\","
NSQ_SOURCE_LINE 00000675 " );"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "The result is something like:"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 " #+CAPTION: Some of the new distributions released in Jan 2022"
NSQ_SOURCE_LINE 00000680 " | Distribution                     | Author    | First Version | Latest Version | Abstract                                                             |"
NSQ_SOURCE_LINE 00000681 " |----------------------------------+-----------+---------------+----------------+----------------------------------------------------------------------|"
NSQ_SOURCE_LINE 00000682 " | ACME-Dzil-Test-daemon            | DAEMON    | 0.001         | 0.001          | Module abstract placeholder text                                     |"
NSQ_SOURCE_LINE 00000683 " |----------------------------------+-----------+---------------+----------------+----------------------------------------------------------------------|"
NSQ_SOURCE_LINE 00000684 " | ACME-Dzil-Test-daemon2           | DAEMON    | 0.001         | 0.001          | Module abstract placeholder text                                     |"
NSQ_SOURCE_LINE 00000685 " |----------------------------------+-----------+---------------+----------------+----------------------------------------------------------------------|"
NSQ_SOURCE_LINE 00000686 " | Acme-CPANModules-ShellCompleters | PERLANCAR | 0.001         | 0.001          | Modules that provide shell tab completion for other commands/scripts |"
NSQ_SOURCE_LINE 00000687 " |----------------------------------+-----------+---------------+----------------+----------------------------------------------------------------------|"
NSQ_SOURCE_LINE 00000688 " | Acme-CPANModules-WorkingWithURL  | PERLANCAR | 0.001         | 0.001          | Working with URL                                                     |"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "To pass backend-specific options:"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 " print generate_table("
NSQ_SOURCE_LINE 00000693 "     rows => $rows,"
NSQ_SOURCE_LINE 00000694 "     backend => \"Text::Table::More\","
NSQ_SOURCE_LINE 00000695 "     backend_opts => {"
NSQ_SOURCE_LINE 00000696 "         border_style => 'ASCII::SingleLineDoubleAfterHeader',"
NSQ_SOURCE_LINE 00000697 "         align => 'right',"
NSQ_SOURCE_LINE 00000698 "         row_attrs => ["
NSQ_SOURCE_LINE 00000699 "             [0, {align=>'middle'}],"
NSQ_SOURCE_LINE 00000700 "         ],"
NSQ_SOURCE_LINE 00000701 "     },"
NSQ_SOURCE_LINE 00000702 " );"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "The result is something like:"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 " .----------------------------------+-----------+---------------+----------------+----------------------------------------------------------------------."
NSQ_SOURCE_LINE 00000707 " |           Distribution           |  Author   | First Version | Latest Version |                               Abstract                               |"
NSQ_SOURCE_LINE 00000708 " +==================================+===========+===============+================+======================================================================+"
NSQ_SOURCE_LINE 00000709 " |            ACME-Dzil-Test-daemon |    DAEMON |         0.001 |          0.001 |                                     Module abstract placeholder text |"
NSQ_SOURCE_LINE 00000710 " |           ACME-Dzil-Test-daemon2 |    DAEMON |         0.001 |          0.001 |                                     Module abstract placeholder text |"
NSQ_SOURCE_LINE 00000711 " | Acme-CPANModules-ShellCompleters | PERLANCAR |         0.001 |          0.001 | Modules that provide shell tab completion for other commands/scripts |"
NSQ_SOURCE_LINE 00000712 " |  Acme-CPANModules-WorkingWithURL | PERLANCAR |         0.001 |          0.001 |                                                     Working with URL |"
NSQ_SOURCE_LINE 00000713 " `----------------------------------+-----------+---------------+----------------+----------------------------------------------------------------------'"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "This module provides a single function, C<generate_table>, which formats a"
NSQ_SOURCE_LINE 00000718 "two-dimensional array of data as text table, using one of several available"
NSQ_SOURCE_LINE 00000719 "backends. The interface is modelled after L<Text::Table::Tiny>, but"
NSQ_SOURCE_LINE 00000720 "L<Text::Table::Sprintf> is the default backend and although Text::Table::Tiny is"
NSQ_SOURCE_LINE 00000721 "among the supported backends, it is not required by this module."
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "=head1 DIFFERENCES WITH TEXT::TABLE::TINY"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "=over"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "=item * 'top_and_tail' option from Text::Table::Tiny is not supported"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "Probably won't be supported. You can pass this option to Text::Table::Tiny"
NSQ_SOURCE_LINE 00000730 "backend via L</backend_opts> option."
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "=item * 'style' option from Text::Table::Tiny is not supported"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "Won't be supported because this is specific to Text::Table::Tiny. If you want"
NSQ_SOURCE_LINE 00000735 "custom border styles, here are some alternative backends you can use:"
NSQ_SOURCE_LINE 00000736 "L<Text::ANSITable>, L<Text::Table::TinyBorderStyle>, L<Text::Table::More>,"
NSQ_SOURCE_LINE 00000737 "L<Text::UnicodeBox::Table>."
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "=item * 'indent' option from Text::Table::Tiny is not supported"
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "Probably won't be supported. You can indent a multiline string in Perl using"
NSQ_SOURCE_LINE 00000742 "something like:"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 " $rendered_table =~ s/^/  /mg; # indent each line with two spaces"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "=item * 'compact' option from Text::Table::Tiny is not supported"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "May be supported in the future."
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "=back"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "=head1 VARIABLES"
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "=head2 @BACKENDS"
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "List of supported backends."
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "=head2 %BACKEND_FEATURES"
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "List of features supported by each backend. Hash key is backend name, e.g."
NSQ_SOURCE_LINE 00000761 "C<Text::Table::Sprintf>. Hash value is a hashref containing feature name as"
NSQ_SOURCE_LINE 00000762 "hashref key and a boolean value or other value as hashref value to describe the"
NSQ_SOURCE_LINE 00000763 "support of that feature by that backend."
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "=head2 table"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "An old name for L</generate_table> function (C<generate_table()> was not"
NSQ_SOURCE_LINE 00000770 "available in Text::Table::Tiny < 0.04). This name is not available for export."
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "=head2 generate_table"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "Exportable."
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "Usage:"
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 " table(%params) => str"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "Except for the C<backend> parameter, the parameters will mostly be passed to the"
NSQ_SOURCE_LINE 00000781 "backend, sometimes slightly modified if necessary to achieve the desired effect."
NSQ_SOURCE_LINE 00000782 "If a parameter is not supported by a backend, then it will not be passed to the"
NSQ_SOURCE_LINE 00000783 "backend."
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "Known parameters:"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "=over"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "=item * backend"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "Optional. Str, default C<Text::Table::Sprintf>. Pick a backend module. Supported"
NSQ_SOURCE_LINE 00000792 "backends:"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "=over"
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "=item * L<Term::Table>"
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 "=item * L<Term::TablePrint>"
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "=item * L<Text::ANSITable>"
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "=item * L<Text::ASCIITable>"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "=item * L<Text::FormatTable>"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "=item * L<Text::MarkdownTable>"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "=item * L<Text::Table>"
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "=item * L<Text::Table::ASV>"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "=item * L<Text::Table::CSV>"
NSQ_SOURCE_LINE 00000813 ""
NSQ_SOURCE_LINE 00000814 "=item * L<Text::Table::HTML>"
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 "=item * L<Text::Table::HTML::DataTables>"
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "=item * L<Text::Table::LTSV>"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "=item * L<Text::Table::Manifold>"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "=item * L<Text::Table::More>"
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "=item * L<Text::Table::Org>"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "=item * L<Text::Table::Paragraph>"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "=item * L<Text::Table::Sprintf>"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "=item * L<Text::Table::TSV>"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "=item * L<Text::Table::TickitWidget>"
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "=item * L<Text::Table::Tiny>"
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "=item * L<Text::Table::TinyBorderStyle>"
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "=item * L<Text::Table::TinyColor>"
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "=item * L<Text::Table::TinyColorWide>"
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "=item * L<Text::Table::TinyWide>"
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "=item * L<Text::Table::XLSX>"
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "=item * L<Text::TabularDisplay>"
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "=item * L<Text::UnicodeBox::Table>"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "=back"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "Support matrix for each backend:"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 " +-------------------------------+-------+--------------------------------------------------------------+--------------+------------------------------------------------------------------------------------------------+---------+------------+------+---------------+"
NSQ_SOURCE_LINE 00000855 " | backend                       | align | align_note                                                   | backend_opts | backend_opts_note                                                                              | caption | header_row | rows | separate_rows |"
NSQ_SOURCE_LINE 00000856 " +-------------------------------+-------+--------------------------------------------------------------+--------------+------------------------------------------------------------------------------------------------+---------+------------+------+---------------+"
NSQ_SOURCE_LINE 00000857 " | Term::Table                   | 0     |                                                              |              |                                                                                                | 0       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000858 " | Term::TablePrint              | 0     |                                                              |              |                                                                                                | 0       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000859 " | Text::ANSITable               | 1     |                                                              |              |                                                                                                | 0       | 1          | 1    | 1             |"
NSQ_SOURCE_LINE 00000860 " | Text::ASCIITable              | 1     |                                                              |              |                                                                                                | 0       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000861 " | Text::FormatTable             | 1     | c(enter) alignment is not supported, will fallback to l(eft) |              |                                                                                                | 0       | 0          | 1    | 0             |"
NSQ_SOURCE_LINE 00000862 " | Text::MarkdownTable           | 0     |                                                              |              |                                                                                                | 0       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000863 " | Text::Table                   | 1     |                                                              |              |                                                                                                | 0       | 0          | 1    | 0             |"
NSQ_SOURCE_LINE 00000864 " | Text::Table::ASV              | 0     |                                                              | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000865 " | Text::Table::CSV              | 0     |                                                              | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000866 " | Text::Table::HTML             | 0     | TODO, backend does not support yet, parameter already passed | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 1       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000867 " | Text::Table::HTML::DataTables | 0     | TODO, backend does not support yet, parameter already passed | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 1       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000868 " | Text::Table::LTSV             | 0     |                                                              | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 0          | 1    | 0             |"
NSQ_SOURCE_LINE 00000869 " | Text::Table::Manifold         | 1     |                                                              |              |                                                                                                | 0       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000870 " | Text::Table::More             | 1     |                                                              | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 1          | 1    | 1             |"
NSQ_SOURCE_LINE 00000871 " | Text::Table::Org              | 0     |                                                              | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 1       | 1          | 1    | 1             |"
NSQ_SOURCE_LINE 00000872 " | Text::Table::Paragraph        | 0     |                                                              | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000873 " | Text::Table::Sprintf          | 0     |                                                              | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 1          | 1    | 1             |"
NSQ_SOURCE_LINE 00000874 " | Text::Table::TSV              | 0     |                                                              | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 0          | 1    | 0             |"
NSQ_SOURCE_LINE 00000875 " | Text::Table::TickitWidget     | 0     |                                                              | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000876 " | Text::Table::Tiny             | 1     |                                                              | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 1          | 1    | 1             |"
NSQ_SOURCE_LINE 00000877 " | Text::Table::TinyBorderStyle  | 0     | TODO, backend does not support yet, parameter already passed | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 1          | 1    | 1             |"
NSQ_SOURCE_LINE 00000878 " | Text::Table::TinyColor        | 0     | TODO, backend does not support yet, parameter already passed | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 1          | 1    | 1             |"
NSQ_SOURCE_LINE 00000879 " | Text::Table::TinyColorWide    | 0     | TODO, backend does not support yet, parameter already passed | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 1          | 1    | 1             |"
NSQ_SOURCE_LINE 00000880 " | Text::Table::TinyWide         | 0     | TODO, backend does not support yet, parameter already passed | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 1          | 1    | 1             |"
NSQ_SOURCE_LINE 00000881 " | Text::Table::XLSX             | 0     |                                                              | 1            | Backend-specific options (backend_opts) will be passed to table() or generate_table() directly | 0       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000882 " | Text::TabularDisplay          | 0     |                                                              |              |                                                                                                | 0       | 0          | 1    | 0             |"
NSQ_SOURCE_LINE 00000883 " | Text::UnicodeBox::Table       | 0     | TODO: backend supports left/right                            |              |                                                                                                | 0       | 1          | 1    | 0             |"
NSQ_SOURCE_LINE 00000884 " +-------------------------------+-------+--------------------------------------------------------------+--------------+------------------------------------------------------------------------------------------------+---------+------------+------+---------------+"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "=item * rows"
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "Required. Aoaos (array of array-of-scalars). Each element in the array is a row"
NSQ_SOURCE_LINE 00000889 "of data, where each row is an array reference."
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "=item * header_row"
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "Optional. Bool, default is true. If given a true value, the first row in the"
NSQ_SOURCE_LINE 00000894 "data will be interpreted as a header row, and separated visually from the rest"
NSQ_SOURCE_LINE 00000895 "of the table (e.g. with a ruled line). But some backends won't display"
NSQ_SOURCE_LINE 00000896 "differently."
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "=item * separate_rows"
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "Boolean. Optional. Default is false. If set to true, will draw a separator line"
NSQ_SOURCE_LINE 00000901 "after each data row."
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "Not all backends support this."
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "=item * caption"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "Optional. Str. Caption of the table."
NSQ_SOURCE_LINE 00000908 ""
NSQ_SOURCE_LINE 00000909 "=item * align"
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "Optional. Array of Str or Str."
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "This takes an array ref with one entry per column, to specify the alignment of"
NSQ_SOURCE_LINE 00000914 "that column. Legal values are 'l', 'c', and 'r' (for left, center, and right,"
NSQ_SOURCE_LINE 00000915 "respectively). You can also specify a single alignment for all columns."
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "Not all backends support this. For example, L<Text::Table::Sprintf> prior to"
NSQ_SOURCE_LINE 00000918 "0.007 does not support this at all. Starting from 0.007, only support left and"
NSQ_SOURCE_LINE 00000919 "right alignment."
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "Note that some backends like L<Text::ANSITable> and L<Text::Table::More> support"
NSQ_SOURCE_LINE 00000922 "per-row or per-cell or even conditional alignment. Some backends like"
NSQ_SOURCE_LINE 00000923 "L<Text::ASCIITable> and L<Text::Table> can also align beyond just l(eft),"
NSQ_SOURCE_LINE 00000924 "c(enter), r(right), e.g. C<justify> or align on a decimal point. To do more"
NSQ_SOURCE_LINE 00000925 "fine-grained alignment setting, you can use the C<backend_opts> parameter."
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "=item * backend_opts"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "Optional. Hashref. Pass backend-specific options to the backend module. Not all"
NSQ_SOURCE_LINE 00000930 "backend modules support this, but all backend modules that have interface"
NSQ_SOURCE_LINE 00000931 "following C<Text::Table::Tiny> should support this. Also note that as the list"
NSQ_SOURCE_LINE 00000932 "of common options is expanded, a previously backend-specific option might be"
NSQ_SOURCE_LINE 00000933 "available later as a common option."
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "=back"
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "=head2 backends"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "Return list of supported backends. You can also get the list from the"
NSQ_SOURCE_LINE 00000940 "L</@BACKENDS> package variable."
NSQ_SOURCE_LINE 00000941 ""
