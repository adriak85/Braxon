BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package File::chdir;"
NSQ_SOURCE_LINE 00000002 "use 5.004;"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use vars qw($VERSION @ISA @EXPORT $CWD @CWD);"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: a more sensible way to change directories"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.1011';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "require Exporter;"
NSQ_SOURCE_LINE 00000010 "@ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000011 "@EXPORT = qw(*CWD);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Carp;"
NSQ_SOURCE_LINE 00000014 "use Cwd 3.16;"
NSQ_SOURCE_LINE 00000015 "use File::Spec::Functions 3.27 qw/canonpath splitpath catpath splitdir catdir/;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "tie $CWD, 'File::chdir::SCALAR' or die \"Can't tie \\$CWD\";"
NSQ_SOURCE_LINE 00000018 "tie @CWD, 'File::chdir::ARRAY'  or die \"Can't tie \\@CWD\";"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "sub _abs_path {"
NSQ_SOURCE_LINE 00000021 "    # Otherwise we'll never work under taint mode."
NSQ_SOURCE_LINE 00000022 "    my($cwd) = Cwd::getcwd =~ /(.*)/s;"
NSQ_SOURCE_LINE 00000023 "    # Run through File::Spec, since everything else uses it"
NSQ_SOURCE_LINE 00000024 "    return canonpath($cwd);"
NSQ_SOURCE_LINE 00000025 "}"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "# splitpath but also split directory"
NSQ_SOURCE_LINE 00000028 "sub _split_cwd {"
NSQ_SOURCE_LINE 00000029 "    my ($vol, $dir) = splitpath(_abs_path, 1);"
NSQ_SOURCE_LINE 00000030 "    my @dirs = splitdir( $dir );"
NSQ_SOURCE_LINE 00000031 "    shift @dirs; # get rid of leading empty \"root\" directory"
NSQ_SOURCE_LINE 00000032 "    return ($vol, @dirs);"
NSQ_SOURCE_LINE 00000033 "}"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "# catpath, but take list of directories"
NSQ_SOURCE_LINE 00000036 "# restore the empty root dir and provide an empty file to avoid warnings"
NSQ_SOURCE_LINE 00000037 "sub _catpath {"
NSQ_SOURCE_LINE 00000038 "    my ($vol, @dirs) = @_;"
NSQ_SOURCE_LINE 00000039 "    return catpath($vol, catdir(q{}, @dirs), q{});"
NSQ_SOURCE_LINE 00000040 "}"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "sub _chdir {"
NSQ_SOURCE_LINE 00000043 "    # Untaint target directory"
NSQ_SOURCE_LINE 00000044 "    my ($new_dir) = $_[0] =~ /(.*)/s;"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    local $Carp::CarpLevel = $Carp::CarpLevel + 1;"
NSQ_SOURCE_LINE 00000047 "    if ( ! CORE::chdir($new_dir) ) {"
NSQ_SOURCE_LINE 00000048 "        croak \"Failed to change directory to '$new_dir': $!\";"
NSQ_SOURCE_LINE 00000049 "    };"
NSQ_SOURCE_LINE 00000050 "    return 1;"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "{"
NSQ_SOURCE_LINE 00000054 "    package File::chdir::SCALAR;"
NSQ_SOURCE_LINE 00000055 "    use Carp;"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    BEGIN {"
NSQ_SOURCE_LINE 00000058 "        *_abs_path = \\&File::chdir::_abs_path;"
NSQ_SOURCE_LINE 00000059 "        *_chdir = \\&File::chdir::_chdir;"
NSQ_SOURCE_LINE 00000060 "        *_split_cwd = \\&File::chdir::_split_cwd;"
NSQ_SOURCE_LINE 00000061 "        *_catpath = \\&File::chdir::_catpath;"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    sub TIESCALAR {"
NSQ_SOURCE_LINE 00000065 "        bless [], $_[0];"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    # To be safe, in case someone chdir'd out from under us, we always"
NSQ_SOURCE_LINE 00000069 "    # check the Cwd explicitly."
NSQ_SOURCE_LINE 00000070 "    sub FETCH {"
NSQ_SOURCE_LINE 00000071 "        return _abs_path;"
NSQ_SOURCE_LINE 00000072 "    }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    sub STORE {"
NSQ_SOURCE_LINE 00000075 "        return unless defined $_[1];"
NSQ_SOURCE_LINE 00000076 "        _chdir($_[1]);"
NSQ_SOURCE_LINE 00000077 "    }"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "{"
NSQ_SOURCE_LINE 00000082 "    package File::chdir::ARRAY;"
NSQ_SOURCE_LINE 00000083 "    use Carp;"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    BEGIN {"
NSQ_SOURCE_LINE 00000086 "        *_abs_path = \\&File::chdir::_abs_path;"
NSQ_SOURCE_LINE 00000087 "        *_chdir = \\&File::chdir::_chdir;"
NSQ_SOURCE_LINE 00000088 "        *_split_cwd = \\&File::chdir::_split_cwd;"
NSQ_SOURCE_LINE 00000089 "        *_catpath = \\&File::chdir::_catpath;"
NSQ_SOURCE_LINE 00000090 "    }"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    sub TIEARRAY {"
NSQ_SOURCE_LINE 00000093 "        bless {}, $_[0];"
NSQ_SOURCE_LINE 00000094 "    }"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    sub FETCH {"
NSQ_SOURCE_LINE 00000097 "        my($self, $idx) = @_;"
NSQ_SOURCE_LINE 00000098 "        my ($vol, @cwd) = _split_cwd;"
NSQ_SOURCE_LINE 00000099 "        return $cwd[$idx];"
NSQ_SOURCE_LINE 00000100 "    }"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "    sub STORE {"
NSQ_SOURCE_LINE 00000103 "        my($self, $idx, $val) = @_;"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "        my ($vol, @cwd) = _split_cwd;"
NSQ_SOURCE_LINE 00000106 "        if( $self->{Cleared} ) {"
NSQ_SOURCE_LINE 00000107 "            @cwd = ();"
NSQ_SOURCE_LINE 00000108 "            $self->{Cleared} = 0;"
NSQ_SOURCE_LINE 00000109 "        }"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "        $cwd[$idx] = $val;"
NSQ_SOURCE_LINE 00000112 "        my $dir = _catpath($vol,@cwd);"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "        _chdir($dir);"
NSQ_SOURCE_LINE 00000115 "        return $cwd[$idx];"
NSQ_SOURCE_LINE 00000116 "    }"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    sub FETCHSIZE {"
NSQ_SOURCE_LINE 00000119 "        my ($vol, @cwd) = _split_cwd;"
NSQ_SOURCE_LINE 00000120 "        return scalar @cwd;"
NSQ_SOURCE_LINE 00000121 "    }"
NSQ_SOURCE_LINE 00000122 "    sub STORESIZE {}"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "    sub PUSH {"
NSQ_SOURCE_LINE 00000125 "        my($self) = shift;"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "        my $dir = _catpath(_split_cwd, @_);"
NSQ_SOURCE_LINE 00000128 "        _chdir($dir);"
NSQ_SOURCE_LINE 00000129 "        return $self->FETCHSIZE;"
NSQ_SOURCE_LINE 00000130 "    }"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    sub POP {"
NSQ_SOURCE_LINE 00000133 "        my($self) = shift;"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "        my ($vol, @cwd) = _split_cwd;"
NSQ_SOURCE_LINE 00000136 "        my $popped = pop @cwd;"
NSQ_SOURCE_LINE 00000137 "        my $dir = _catpath($vol,@cwd);"
NSQ_SOURCE_LINE 00000138 "        _chdir($dir);"
NSQ_SOURCE_LINE 00000139 "        return $popped;"
NSQ_SOURCE_LINE 00000140 "    }"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "    sub SHIFT {"
NSQ_SOURCE_LINE 00000143 "        my($self) = shift;"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "        my ($vol, @cwd) = _split_cwd;"
NSQ_SOURCE_LINE 00000146 "        my $shifted = shift @cwd;"
NSQ_SOURCE_LINE 00000147 "        my $dir = _catpath($vol,@cwd);"
NSQ_SOURCE_LINE 00000148 "        _chdir($dir);"
NSQ_SOURCE_LINE 00000149 "        return $shifted;"
NSQ_SOURCE_LINE 00000150 "    }"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    sub UNSHIFT {"
NSQ_SOURCE_LINE 00000153 "        my($self) = shift;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "        my ($vol, @cwd) = _split_cwd;"
NSQ_SOURCE_LINE 00000156 "        my $dir = _catpath($vol, @_, @cwd);"
NSQ_SOURCE_LINE 00000157 "        _chdir($dir);"
NSQ_SOURCE_LINE 00000158 "        return $self->FETCHSIZE;"
NSQ_SOURCE_LINE 00000159 "    }"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    sub CLEAR  {"
NSQ_SOURCE_LINE 00000162 "        my($self) = shift;"
NSQ_SOURCE_LINE 00000163 "        $self->{Cleared} = 1;"
NSQ_SOURCE_LINE 00000164 "    }"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "    sub SPLICE {"
NSQ_SOURCE_LINE 00000167 "        my $self = shift;"
NSQ_SOURCE_LINE 00000168 "        my $offset = shift || 0;"
NSQ_SOURCE_LINE 00000169 "        my $len = shift || $self->FETCHSIZE - $offset;"
NSQ_SOURCE_LINE 00000170 "        my @new_dirs = @_;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "        my ($vol, @cwd) = _split_cwd;"
NSQ_SOURCE_LINE 00000173 "        my @orig_dirs = splice @cwd, $offset, $len, @new_dirs;"
NSQ_SOURCE_LINE 00000174 "        my $dir = _catpath($vol, @cwd);"
NSQ_SOURCE_LINE 00000175 "        _chdir($dir);"
NSQ_SOURCE_LINE 00000176 "        return @orig_dirs;"
NSQ_SOURCE_LINE 00000177 "    }"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    sub EXTEND { }"
NSQ_SOURCE_LINE 00000180 "    sub EXISTS {"
NSQ_SOURCE_LINE 00000181 "        my($self, $idx) = @_;"
NSQ_SOURCE_LINE 00000182 "        return $self->FETCHSIZE >= $idx ? 1 : 0;"
NSQ_SOURCE_LINE 00000183 "    }"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "    sub DELETE {"
NSQ_SOURCE_LINE 00000186 "        my($self, $idx) = @_;"
NSQ_SOURCE_LINE 00000187 "        croak \"Can't delete except at the end of \\@CWD\""
NSQ_SOURCE_LINE 00000188 "            if $idx < $self->FETCHSIZE - 1;"
NSQ_SOURCE_LINE 00000189 "        local $Carp::CarpLevel = $Carp::CarpLevel + 1;"
NSQ_SOURCE_LINE 00000190 "        $self->POP;"
NSQ_SOURCE_LINE 00000191 "    }"
NSQ_SOURCE_LINE 00000192 "}"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "1;"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "__END__"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "=pod"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=head1 NAME"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "File::chdir - a more sensible way to change directories"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=head1 VERSION"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "version 0.1011"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "  use File::chdir;"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "  $CWD = \"/foo/bar\";     # now in /foo/bar"
NSQ_SOURCE_LINE 00000215 "  {"
NSQ_SOURCE_LINE 00000216 "      local $CWD = \"/moo/baz\";  # now in /moo/baz"
NSQ_SOURCE_LINE 00000217 "      ..."
NSQ_SOURCE_LINE 00000218 "  }"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "  # still in /foo/bar!"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "Perl's C<chdir()> has the unfortunate problem of being very, very, very"
NSQ_SOURCE_LINE 00000225 "global.  If any part of your program calls C<chdir()> or if any library"
NSQ_SOURCE_LINE 00000226 "you use calls C<chdir()>, it changes the current working directory for"
NSQ_SOURCE_LINE 00000227 "the *whole* program."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "This sucks."
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "File::chdir gives you an alternative, C<$CWD> and C<@CWD>.  These two"
NSQ_SOURCE_LINE 00000232 "variables combine all the power of C<chdir()>, L<File::Spec> and L<Cwd>."
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=head1 $CWD"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "Use the C<$CWD> variable instead of C<chdir()> and Cwd."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "    use File::chdir;"
NSQ_SOURCE_LINE 00000239 "    $CWD = $dir;  # just like chdir($dir)!"
NSQ_SOURCE_LINE 00000240 "    print $CWD;   # prints the current working directory"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "It can be localized, and it does the right thing."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "    $CWD = \"/foo\";      # it's /foo out here."
NSQ_SOURCE_LINE 00000245 "    {"
NSQ_SOURCE_LINE 00000246 "        local $CWD = \"/bar\";  # /bar in here"
NSQ_SOURCE_LINE 00000247 "    }"
NSQ_SOURCE_LINE 00000248 "    # still /foo out here!"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "C<$CWD> always returns the absolute path in the native form for the"
NSQ_SOURCE_LINE 00000251 "operating system."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "C<$CWD> and normal C<chdir()> work together just fine."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=head1 @CWD"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "C<@CWD> represents the current working directory as an array, each"
NSQ_SOURCE_LINE 00000258 "directory in the path is an element of the array.  This can often make"
NSQ_SOURCE_LINE 00000259 "the directory easier to manipulate, and you don't have to fumble with"
NSQ_SOURCE_LINE 00000260 "C<< File::Spec->splitpath >> and C<< File::Spec->catdir >> to make portable code."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "  # Similar to chdir(\"/usr/local/src/perl\")"
NSQ_SOURCE_LINE 00000263 "  @CWD = qw(usr local src perl);"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "pop, push, shift, unshift and splice all work.  pop and push are"
NSQ_SOURCE_LINE 00000266 "probably the most useful."
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "  pop @CWD;                 # same as chdir(File::Spec->updir)"
NSQ_SOURCE_LINE 00000269 "  push @CWD, 'some_dir'     # same as chdir('some_dir')"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "C<@CWD> and C<$CWD> both work fine together."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "*NOTE* Due to a perl bug you can't localize C<@CWD>.  See L</CAVEATS> for a work around."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "(We omit the C<use File::chdir> from these examples for terseness)"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "Here's C<$CWD> instead of C<chdir()>:"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "    $CWD = 'foo';           # chdir('foo')"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "and now instead of Cwd."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "    print $CWD;             # use Cwd;  print Cwd::abs_path"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "you can even do zsh style C<cd foo bar>"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "    $CWD = '/usr/local/foo';"
NSQ_SOURCE_LINE 00000290 "    $CWD =~ s/usr/var/;"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "if you want to localize that, make sure you get the parens right"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "    {"
NSQ_SOURCE_LINE 00000295 "        (local $CWD) =~ s/usr/var/;"
NSQ_SOURCE_LINE 00000296 "        ..."
NSQ_SOURCE_LINE 00000297 "    }"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "It's most useful for writing polite subroutines which don't leave the"
NSQ_SOURCE_LINE 00000300 "program in some strange directory:"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "    sub foo {"
NSQ_SOURCE_LINE 00000303 "        local $CWD = 'some/other/dir';"
NSQ_SOURCE_LINE 00000304 "        ...do your work..."
NSQ_SOURCE_LINE 00000305 "    }"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "which is much simpler than the equivalent:"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "    sub foo {"
NSQ_SOURCE_LINE 00000310 "        use Cwd;"
NSQ_SOURCE_LINE 00000311 "        my $orig_dir = Cwd::getcwd;"
NSQ_SOURCE_LINE 00000312 "        chdir('some/other/dir');"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "        ...do your work..."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "        chdir($orig_dir);"
NSQ_SOURCE_LINE 00000317 "    }"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "C<@CWD> comes in handy when you want to start moving up and down the"
NSQ_SOURCE_LINE 00000320 "directory hierarchy in a cross-platform manner without having to use"
NSQ_SOURCE_LINE 00000321 "File::Spec."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "    pop @CWD;                   # chdir(File::Spec->updir);"
NSQ_SOURCE_LINE 00000324 "    push @CWD, 'some', 'dir'    # chdir(File::Spec->catdir(qw(some dir)));"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "You can easily change your parent directory:"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "    # chdir from /some/dir/bar/moo to /some/dir/foo/moo"
NSQ_SOURCE_LINE 00000329 "    $CWD[-2] = 'foo';"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "=head2 C<local @CWD> does not work."
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "C<local @CWD> will not localize C<@CWD>.  This is a bug in Perl, you"
NSQ_SOURCE_LINE 00000336 "can't localize tied arrays.  As a work around localizing $CWD will"
NSQ_SOURCE_LINE 00000337 "effectively localize @CWD."
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "    {"
NSQ_SOURCE_LINE 00000340 "        local $CWD;"
NSQ_SOURCE_LINE 00000341 "        pop @CWD;"
NSQ_SOURCE_LINE 00000342 "        ..."
NSQ_SOURCE_LINE 00000343 "    }"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=head2 Assigning to C<@CWD> calls C<chdir()> for each element"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "    @CWD = qw/a b c d/;"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "Internally, Perl clears C<@CWD> and assigns each element in turn.  Thus, this"
NSQ_SOURCE_LINE 00000350 "code above will do this:"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "    chdir 'a';"
NSQ_SOURCE_LINE 00000353 "    chdir 'a/b';"
NSQ_SOURCE_LINE 00000354 "    chdir 'a/b/c';"
NSQ_SOURCE_LINE 00000355 "    chdir 'a/b/c/d';"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "Generally, avoid assigning to C<@CWD> and just use push and pop instead."
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=head2 Volumes not handled"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "There is currently no way to change the current volume via File::chdir."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=head1 NOTES"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "C<$CWD> returns the current directory using native path separators, i.e. C<\\>"
NSQ_SOURCE_LINE 00000366 "on Win32.  This ensures that C<$CWD> will compare correctly with directories"
NSQ_SOURCE_LINE 00000367 "created using File::Spec.  For example:"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "    my $working_dir = File::Spec->catdir( $CWD, \"foo\" );"
NSQ_SOURCE_LINE 00000370 "    $CWD = $working_dir;"
NSQ_SOURCE_LINE 00000371 "    doing_stuff_might_chdir();"
NSQ_SOURCE_LINE 00000372 "    is( $CWD, $working_dir, \"back to original working_dir?\" );"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "Deleting the last item of C<@CWD> will act like a pop.  Deleting from the"
NSQ_SOURCE_LINE 00000375 "middle will throw an exception."
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "    delete @CWD[-1]; # OK"
NSQ_SOURCE_LINE 00000378 "    delete @CWD[-2]; # Dies"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "What should %CWD do?  Something with volumes?"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "    # chdir to C:\\Program Files\\Sierra\\Half Life ?"
NSQ_SOURCE_LINE 00000383 "    $CWD{C} = '\\\\Program Files\\\\Sierra\\\\Half Life';"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=head1 DIAGNOSTICS"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "If an error is encountered when changing C<$CWD> or C<@CWD>, one of"
NSQ_SOURCE_LINE 00000388 "the following exceptions will be thrown:"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "* ~Can't delete except at the end of @CWD~"
NSQ_SOURCE_LINE 00000391 "* ~Failed to change directory to '$dir'~"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "=head1 HISTORY"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "Michael wanted C<local chdir> to work.  p5p didn't.  But it wasn't over!"
NSQ_SOURCE_LINE 00000396 "Was it over when the Germans bombed Pearl Harbor?  Hell, no!"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "Abigail and/or Bryan Warnock suggested the C<$CWD> thing (Michael forgets"
NSQ_SOURCE_LINE 00000399 "which).  They were right."
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "The C<chdir()> override was eliminated in 0.04."
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "David became co-maintainer with 0.06_01 to fix some chronic"
NSQ_SOURCE_LINE 00000404 "Win32 path bugs."
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "As of 0.08, if changing C<$CWD> or C<@CWD> fails to change the directory, an"
NSQ_SOURCE_LINE 00000407 "error will be thrown."
