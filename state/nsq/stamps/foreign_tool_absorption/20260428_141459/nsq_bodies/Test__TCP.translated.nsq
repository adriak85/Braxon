BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Test::TCP;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use 5.00800;"
NSQ_SOURCE_LINE 00000005 "our $VERSION = '2.22';"
NSQ_SOURCE_LINE 00000006 "use base qw/Exporter/;"
NSQ_SOURCE_LINE 00000007 "use Test::SharedFork 0.12;"
NSQ_SOURCE_LINE 00000008 "use Test::More ();"
NSQ_SOURCE_LINE 00000009 "use Config;"
NSQ_SOURCE_LINE 00000010 "use POSIX;"
NSQ_SOURCE_LINE 00000011 "use Time::HiRes ();"
NSQ_SOURCE_LINE 00000012 "use Carp ();"
NSQ_SOURCE_LINE 00000013 "use Net::EmptyPort qw(empty_port check_port);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our @EXPORT = qw/ empty_port test_tcp wait_port /;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "# process does not die when received SIGTERM, on win32."
NSQ_SOURCE_LINE 00000018 "my $TERMSIG = $^O eq 'MSWin32' ? 'KILL' : 'TERM';"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "sub test_tcp {"
NSQ_SOURCE_LINE 00000021 "    my %args = @_;"
NSQ_SOURCE_LINE 00000022 "    for my $k (qw/client server/) {"
NSQ_SOURCE_LINE 00000023 "        die \"missing mandatory parameter $k\" unless exists $args{$k};"
NSQ_SOURCE_LINE 00000024 "    }"
NSQ_SOURCE_LINE 00000025 "    my $server_code = delete $args{server};"
NSQ_SOURCE_LINE 00000026 "    my $client_code = delete $args{client};"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    my $server = Test::TCP->new("
NSQ_SOURCE_LINE 00000029 "        code => $server_code,"
NSQ_SOURCE_LINE 00000030 "        %args,"
NSQ_SOURCE_LINE 00000031 "    );"
NSQ_SOURCE_LINE 00000032 "    $client_code->($server->port, $server->pid);"
NSQ_SOURCE_LINE 00000033 "    undef $server; # make sure"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub wait_port {"
NSQ_SOURCE_LINE 00000037 "    my ($host, $port, $max_wait);"
NSQ_SOURCE_LINE 00000038 "    if (@_ && ref $_[0] eq 'HASH') {"
NSQ_SOURCE_LINE 00000039 "        $host = $_[0]->{host};"
NSQ_SOURCE_LINE 00000040 "        $port = $_[0]->{port};"
NSQ_SOURCE_LINE 00000041 "        $max_wait = $_[0]->{max_wait};"
NSQ_SOURCE_LINE 00000042 "    } elsif (@_ == 3) {"
NSQ_SOURCE_LINE 00000043 "        # backward compat"
NSQ_SOURCE_LINE 00000044 "        ($port, (my $sleep), (my $retry)) = @_;"
NSQ_SOURCE_LINE 00000045 "        $max_wait = $sleep * $retry;"
NSQ_SOURCE_LINE 00000046 "    } else {"
NSQ_SOURCE_LINE 00000047 "        ($port, $max_wait) = @_;"
NSQ_SOURCE_LINE 00000048 "    }"
NSQ_SOURCE_LINE 00000049 "    $host = '127.0.0.1'"
NSQ_SOURCE_LINE 00000050 "        unless defined $host;"
NSQ_SOURCE_LINE 00000051 "    $max_wait ||= 10;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    Net::EmptyPort::wait_port({ host => $host, port => $port, max_wait => $max_wait })"
NSQ_SOURCE_LINE 00000054 "        or die \"cannot open port: $host:$port\";"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "# ------------------------------------------------------------------------- "
NSQ_SOURCE_LINE 00000058 "# OO-ish interface"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub new {"
NSQ_SOURCE_LINE 00000061 "    my $class = shift;"
NSQ_SOURCE_LINE 00000062 "    my %args = @_==1 ? %{$_[0]} : @_;"
NSQ_SOURCE_LINE 00000063 "    Carp::croak(\"missing mandatory parameter 'code'\") unless exists $args{code};"
NSQ_SOURCE_LINE 00000064 "    my $self = bless {"
NSQ_SOURCE_LINE 00000065 "        auto_start => 1,"
NSQ_SOURCE_LINE 00000066 "        max_wait   => 10,"
NSQ_SOURCE_LINE 00000067 "        host       => '127.0.0.1',"
NSQ_SOURCE_LINE 00000068 "        _my_pid    => $$,"
NSQ_SOURCE_LINE 00000069 "        %args,"
NSQ_SOURCE_LINE 00000070 "    }, $class;"
NSQ_SOURCE_LINE 00000071 "    if ($self->{listen}) {"
NSQ_SOURCE_LINE 00000072 "        $self->{socket} ||= Net::EmptyPort::listen_socket({"
NSQ_SOURCE_LINE 00000073 "            host => $self->{host},"
NSQ_SOURCE_LINE 00000074 "            proto => $self->{proto},"
NSQ_SOURCE_LINE 00000075 "        }) or die \"Cannot listen: $!\";"
NSQ_SOURCE_LINE 00000076 "        $self->{port} = $self->{socket}->sockport;"
NSQ_SOURCE_LINE 00000077 "    }"
NSQ_SOURCE_LINE 00000078 "    else {"
NSQ_SOURCE_LINE 00000079 "        $self->{port} ||= empty_port({ host => $self->{host} });"
NSQ_SOURCE_LINE 00000080 "    }"
NSQ_SOURCE_LINE 00000081 "    $self->start()"
NSQ_SOURCE_LINE 00000082 "      if $self->{auto_start};"
NSQ_SOURCE_LINE 00000083 "    return $self;"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub pid  { $_[0]->{pid} }"
NSQ_SOURCE_LINE 00000087 "sub port { $_[0]->{port} }"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "sub start {"
NSQ_SOURCE_LINE 00000090 "    my $self = shift;"
NSQ_SOURCE_LINE 00000091 "    my $pid = fork();"
NSQ_SOURCE_LINE 00000092 "    die \"fork() failed: $!\" unless defined $pid;"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    if ( $pid ) { # parent process."
NSQ_SOURCE_LINE 00000095 "        $self->{pid} = $pid;"
NSQ_SOURCE_LINE 00000096 "        Test::TCP::wait_port({ host => $self->{host}, port => $self->port, max_wait => $self->{max_wait} })"
NSQ_SOURCE_LINE 00000097 "            unless $self->{socket};"
NSQ_SOURCE_LINE 00000098 "        return;"
NSQ_SOURCE_LINE 00000099 "    } else { # child process"
NSQ_SOURCE_LINE 00000100 "        $self->{code}->($self->{socket} || $self->port);"
NSQ_SOURCE_LINE 00000101 "        # should not reach here"
NSQ_SOURCE_LINE 00000102 "        if (kill 0, $self->{_my_pid}) { # warn only parent process still exists"
NSQ_SOURCE_LINE 00000103 "            warn(\"[Test::TCP] Child process does not block(PID: $$, PPID: $self->{_my_pid})\");"
NSQ_SOURCE_LINE 00000104 "        }"
NSQ_SOURCE_LINE 00000105 "        exit 0;"
NSQ_SOURCE_LINE 00000106 "    }"
NSQ_SOURCE_LINE 00000107 "}"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "sub stop {"
NSQ_SOURCE_LINE 00000110 "    my $self = shift;"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "    return unless defined $self->{pid};"
NSQ_SOURCE_LINE 00000113 "    return unless $self->{_my_pid} == $$;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    # This is a workaround for win32 fork emulation's bug."
NSQ_SOURCE_LINE 00000116 "    #"
NSQ_SOURCE_LINE 00000117 "    # kill is inherently unsafe for pseudo-processes in Windows"
NSQ_SOURCE_LINE 00000118 "    # and the process calling kill(9, $pid) may be destabilized"
NSQ_SOURCE_LINE 00000119 "    # The call to Sleep will decrease the frequency of this problems"
NSQ_SOURCE_LINE 00000120 "    #"
NSQ_SOURCE_LINE 00000121 "    # SEE ALSO:"
NSQ_SOURCE_LINE 00000122 "    #   http://www.gossamer-threads.com/lists/perl/porters/261805"
NSQ_SOURCE_LINE 00000123 "    #   https://rt.cpan.org/Ticket/Display.html?id=67292"
NSQ_SOURCE_LINE 00000124 "    Win32::Sleep(0) if $^O eq \"MSWin32\"; # will relinquish the remainder of its time slice"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "        kill $TERMSIG => $self->{pid};"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "    Win32::Sleep(0) if $^O eq \"MSWin32\"; # will relinquish the remainder of its time slice"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    local $?; # waitpid modifies original $?."
NSQ_SOURCE_LINE 00000132 "    LOOP: while (1) {"
NSQ_SOURCE_LINE 00000133 "        my $kid = waitpid( $self->{pid}, 0 );"
NSQ_SOURCE_LINE 00000134 "        if ($^O ne 'MSWin32') { # i'm not in hell"
NSQ_SOURCE_LINE 00000135 "            if (POSIX::WIFSIGNALED($?)) {"
NSQ_SOURCE_LINE 00000136 "                my $signame = (split(' ', $Config{sig_name}))[POSIX::WTERMSIG($?)];"
NSQ_SOURCE_LINE 00000137 "                if ($signame =~ /^(ABRT|PIPE)$/) {"
NSQ_SOURCE_LINE 00000138 "                    Test::More::diag(\"your server received SIG$signame\");"
NSQ_SOURCE_LINE 00000139 "                }"
NSQ_SOURCE_LINE 00000140 "            }"
NSQ_SOURCE_LINE 00000141 "        }"
NSQ_SOURCE_LINE 00000142 "        if ($kid == 0 || $kid == -1) {"
NSQ_SOURCE_LINE 00000143 "            last LOOP;"
NSQ_SOURCE_LINE 00000144 "        }"
NSQ_SOURCE_LINE 00000145 "    }"
NSQ_SOURCE_LINE 00000146 "    undef $self->{pid};"
NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "sub DESTROY {"
NSQ_SOURCE_LINE 00000150 "    my $self = shift;"
NSQ_SOURCE_LINE 00000151 "    local $@;"
NSQ_SOURCE_LINE 00000152 "    $self->stop();"
NSQ_SOURCE_LINE 00000153 "}"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "1;"
NSQ_SOURCE_LINE 00000156 "__END__"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=for stopwords OO loopback"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=encoding utf8"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head1 NAME"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "Test::TCP - testing TCP program"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    use Test::TCP;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    my $server = Test::TCP->new("
NSQ_SOURCE_LINE 00000171 "        listen => 1,"
NSQ_SOURCE_LINE 00000172 "        code => sub {"
NSQ_SOURCE_LINE 00000173 "            my $socket = shift;"
NSQ_SOURCE_LINE 00000174 "            ..."
NSQ_SOURCE_LINE 00000175 "        },"
NSQ_SOURCE_LINE 00000176 "    );"
NSQ_SOURCE_LINE 00000177 "    my $client = MyClient->new(host => '127.0.0.1', port => $server->port);"
NSQ_SOURCE_LINE 00000178 "    undef $server; # kill child process on DESTROY"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "If using a server that can only accept a port number, e.g. memcached:"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    use Test::TCP;"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "    my $memcached = Test::TCP->new("
NSQ_SOURCE_LINE 00000185 "        code => sub {"
NSQ_SOURCE_LINE 00000186 "            my $port = shift;"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "            exec $bin, '-p' => $port;"
NSQ_SOURCE_LINE 00000189 "            die \"cannot execute $bin: $!\";"
NSQ_SOURCE_LINE 00000190 "        },"
NSQ_SOURCE_LINE 00000191 "    );"
NSQ_SOURCE_LINE 00000192 "    my $memd = Cache::Memcached->new({servers => ['127.0.0.1:' . $memcached->port]});"
NSQ_SOURCE_LINE 00000193 "    ..."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "B<N.B.>: This is vulnerable to race conditions, if another process binds"
NSQ_SOURCE_LINE 00000196 "to the same port after L<Net::EmptyPort> found it available."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "And functional interface is available:"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    use Test::TCP;"
NSQ_SOURCE_LINE 00000201 "    test_tcp("
NSQ_SOURCE_LINE 00000202 "        listen => 1,"
NSQ_SOURCE_LINE 00000203 "        client => sub {"
NSQ_SOURCE_LINE 00000204 "            my ($port, $server_pid) = @_;"
NSQ_SOURCE_LINE 00000205 "            # send request to the server"
NSQ_SOURCE_LINE 00000206 "        },"
NSQ_SOURCE_LINE 00000207 "        server => sub {"
NSQ_SOURCE_LINE 00000208 "            my $socket = shift;"
NSQ_SOURCE_LINE 00000209 "            # run server, calling $socket->accept"
NSQ_SOURCE_LINE 00000210 "        },"
NSQ_SOURCE_LINE 00000211 "    );"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "    test_tcp("
NSQ_SOURCE_LINE 00000214 "        client => sub {"
NSQ_SOURCE_LINE 00000215 "            my ($port, $server_pid) = @_;"
NSQ_SOURCE_LINE 00000216 "            # send request to the server"
NSQ_SOURCE_LINE 00000217 "        },"
NSQ_SOURCE_LINE 00000218 "        server => sub {"
NSQ_SOURCE_LINE 00000219 "            my $port = shift;"
NSQ_SOURCE_LINE 00000220 "            # run server, binding to $port"
NSQ_SOURCE_LINE 00000221 "        },"
NSQ_SOURCE_LINE 00000222 "    );"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "Test::TCP is a test utility to test TCP/IP-based server programs."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=head1 METHODS"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=over 4"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=item test_tcp"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "Functional interface."
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "    test_tcp("
NSQ_SOURCE_LINE 00000237 "        listen => 1,"
NSQ_SOURCE_LINE 00000238 "        client => sub {"
NSQ_SOURCE_LINE 00000239 "            my $port = shift;"
NSQ_SOURCE_LINE 00000240 "            # send request to the server"
NSQ_SOURCE_LINE 00000241 "        },"
NSQ_SOURCE_LINE 00000242 "        server => sub {"
NSQ_SOURCE_LINE 00000243 "            my $socket = shift;"
NSQ_SOURCE_LINE 00000244 "            # run server"
NSQ_SOURCE_LINE 00000245 "        },"
NSQ_SOURCE_LINE 00000246 "        # optional"
NSQ_SOURCE_LINE 00000247 "        host => '127.0.0.1', # specify '::1' to test using IPv6"
NSQ_SOURCE_LINE 00000248 "        port => 8080,"
NSQ_SOURCE_LINE 00000249 "        max_wait => 3, # seconds"
NSQ_SOURCE_LINE 00000250 "    );"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "If C<listen> is false, C<server> is instead passed a port number that"
NSQ_SOURCE_LINE 00000253 "was free before it was called."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=item wait_port"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    wait_port(8080);"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "Waits for a particular port is available for connect."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=back"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=head1 Object Oriented interface"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=over 4"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=item my $server = Test::TCP->new(%args);"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "Create new instance of Test::TCP."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Arguments are following:"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=over 4"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=item $args{auto_start}: Boolean"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "Call C<< $server->start() >> after create instance."
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "Default: true"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=item $args{code}: CodeRef"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "The callback function. Argument for callback function is:"
NSQ_SOURCE_LINE 00000284 "C<< $code->($socket) >> or C<< $code->($port) >>,"
NSQ_SOURCE_LINE 00000285 "depending on the value of C<listen>."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "This parameter is required."
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=item $args{max_wait} : Number"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "Will wait for at most C<$max_wait> seconds before checking port."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "See also L<Net::EmptyPort>."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "I<Default: 10>"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=item $args{listen} : Boolean"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "If true, open a listening socket and pass this to the callback."
NSQ_SOURCE_LINE 00000300 "Otherwise find a free port and pass the number of it to the callback."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=back"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=item $server->start()"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "Start the server process. Normally, you don't need to call this method."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=item $server->stop()"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "Stop the server process."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "=item my $pid = $server->pid();"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "Get the pid of child process."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=item my $port = $server->port();"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "Get the port number of child process."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "=back"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=head1 FAQ"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=over 4"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "=item How to invoke two servers?"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "You can call test_tcp() twice!"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "    test_tcp("
NSQ_SOURCE_LINE 00000331 "        client => sub {"
NSQ_SOURCE_LINE 00000332 "            my $port1 = shift;"
NSQ_SOURCE_LINE 00000333 "            test_tcp("
NSQ_SOURCE_LINE 00000334 "                client => sub {"
NSQ_SOURCE_LINE 00000335 "                    my $port2 = shift;"
NSQ_SOURCE_LINE 00000336 "                    # some client code here"
NSQ_SOURCE_LINE 00000337 "                },"
NSQ_SOURCE_LINE 00000338 "                server => sub {"
NSQ_SOURCE_LINE 00000339 "                    my $port2 = shift;"
NSQ_SOURCE_LINE 00000340 "                    # some server2 code here"
NSQ_SOURCE_LINE 00000341 "                },"
NSQ_SOURCE_LINE 00000342 "            );"
NSQ_SOURCE_LINE 00000343 "        },"
NSQ_SOURCE_LINE 00000344 "        server => sub {"
NSQ_SOURCE_LINE 00000345 "            my $port1 = shift;"
NSQ_SOURCE_LINE 00000346 "            # some server1 code here"
NSQ_SOURCE_LINE 00000347 "        },"
NSQ_SOURCE_LINE 00000348 "    );"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "Or use the OO interface instead."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "    my $server1 = Test::TCP->new(code => sub {"
NSQ_SOURCE_LINE 00000353 "        my $port1 = shift;"
NSQ_SOURCE_LINE 00000354 "        ..."
NSQ_SOURCE_LINE 00000355 "    });"
NSQ_SOURCE_LINE 00000356 "    my $server2 = Test::TCP->new(code => sub {"
NSQ_SOURCE_LINE 00000357 "        my $port2 = shift;"
NSQ_SOURCE_LINE 00000358 "        ..."
NSQ_SOURCE_LINE 00000359 "    });"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "    # your client code here."
NSQ_SOURCE_LINE 00000362 "    ..."
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "=item How do you test server program written in other languages like memcached?"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "You can use C<exec()> in child process."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "    use strict;"
NSQ_SOURCE_LINE 00000369 "    use warnings;"
NSQ_SOURCE_LINE 00000370 "    use utf8;"
NSQ_SOURCE_LINE 00000371 "    use Test::More;"
NSQ_SOURCE_LINE 00000372 "    use Test::TCP 1.08;"
NSQ_SOURCE_LINE 00000373 "    use File::Which;"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "    my $bin = scalar which 'memcached';"
NSQ_SOURCE_LINE 00000376 "    plan skip_all => 'memcached binary is not found' unless defined $bin;"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "    my $memcached = Test::TCP->new("
NSQ_SOURCE_LINE 00000379 "        code => sub {"
NSQ_SOURCE_LINE 00000380 "            my $port = shift;"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "            exec $bin, '-p' => $port;"
NSQ_SOURCE_LINE 00000383 "            die \"cannot execute $bin: $!\";"
NSQ_SOURCE_LINE 00000384 "        },"
NSQ_SOURCE_LINE 00000385 "    );"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "    use Cache::Memcached;"
NSQ_SOURCE_LINE 00000388 "    my $memd = Cache::Memcached->new({servers => ['127.0.0.1:' . $memcached->port]});"
NSQ_SOURCE_LINE 00000389 "    $memd->set(foo => 'bar');"
NSQ_SOURCE_LINE 00000390 "    is $memd->get('foo'), 'bar';"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "    done_testing;"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "=item How do I use address other than \"127.0.0.1\" for testing?"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "You can use the C<< host >> parameter to specify the bind address."
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "    # let the server bind to \"0.0.0.0\" for testing"
NSQ_SOURCE_LINE 00000399 "    test_tcp("
NSQ_SOURCE_LINE 00000400 "        client => sub {"
NSQ_SOURCE_LINE 00000401 "            ..."
NSQ_SOURCE_LINE 00000402 "        },"
NSQ_SOURCE_LINE 00000403 "        server => sub {"
NSQ_SOURCE_LINE 00000404 "            ..."
NSQ_SOURCE_LINE 00000405 "        },"
NSQ_SOURCE_LINE 00000406 "        host => '0.0.0.0',"
NSQ_SOURCE_LINE 00000407 "    );"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "=item How should I write IPv6 tests?"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "You should use the L<Net::EmptyPort/can_bind> function to check if the program can bind to the loopback address of IPv6, as well as the C<host> parameter of the L</test_tcp> function to specify the same address as the bind address."
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "    use Net::EmptyPort qw(can_bind);"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "    plan skip_all => \"IPv6 not available\""
NSQ_SOURCE_LINE 00000416 "        unless can_bind('::1');"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "    test_tcp("
NSQ_SOURCE_LINE 00000419 "        client => sub {"
NSQ_SOURCE_LINE 00000420 "            ..."
NSQ_SOURCE_LINE 00000421 "        },"
NSQ_SOURCE_LINE 00000422 "        server => sub {"
NSQ_SOURCE_LINE 00000423 "            ..."
NSQ_SOURCE_LINE 00000424 "        },"
NSQ_SOURCE_LINE 00000425 "        host => '::1',"
NSQ_SOURCE_LINE 00000426 "    );"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "=back"
