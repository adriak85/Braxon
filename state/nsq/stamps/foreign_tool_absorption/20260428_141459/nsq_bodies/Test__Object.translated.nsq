NSQ_SOURCE_LINE 00000001 "package Test::Object; # git description: 1392ed9"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "=pod"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "=head1 NAME"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "Test::Object - Thoroughly testing objects via registered handlers"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "=head1 VERSION"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "version 0.08"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "  ###################################################################"
NSQ_SOURCE_LINE 00000016 "  # In your test module, register test handlers again class names   #"
NSQ_SOURCE_LINE 00000017 "  ###################################################################"
NSQ_SOURCE_LINE 00000018 "  "
NSQ_SOURCE_LINE 00000019 "  package My::ModuleTester;"
NSQ_SOURCE_LINE 00000020 "  "
NSQ_SOURCE_LINE 00000021 "  use Test::More;"
NSQ_SOURCE_LINE 00000022 "  use Test::Object;"
NSQ_SOURCE_LINE 00000023 "  "
NSQ_SOURCE_LINE 00000024 "  # Foo::Bar is a subclass of Foo"
NSQ_SOURCE_LINE 00000025 "  Test::Object->register("
NSQ_SOURCE_LINE 00000026 "  \tclass => 'Foo',"
NSQ_SOURCE_LINE 00000027 "  \ttests => 5,"
NSQ_SOURCE_LINE 00000028 "  \tcode  => \\&foo_ok,"
NSQ_SOURCE_LINE 00000029 "  \t);"
NSQ_SOURCE_LINE 00000030 "  Test::Object->register("
NSQ_SOURCE_LINE 00000031 "  \tclass => 'Foo::Bar',"
NSQ_SOURCE_LINE 00000032 "  \t# No fixed number of tests"
NSQ_SOURCE_LINE 00000033 "  \tcode  => \\&foobar_ok,"
NSQ_SOURCE_LINE 00000034 "  \t);"
NSQ_SOURCE_LINE 00000035 "  "
NSQ_SOURCE_LINE 00000036 "  sub foo_ok {"
NSQ_SOURCE_LINE 00000037 "  \tmy $object = shift;"
NSQ_SOURCE_LINE 00000038 "  \tok( $object->foo, '->foo returns true' );"
NSQ_SOURCE_LINE 00000039 "  }"
NSQ_SOURCE_LINE 00000040 "  "
NSQ_SOURCE_LINE 00000041 "  sub foobar_ok {"
NSQ_SOURCE_LINE 00000042 "  \tmy $object = shift;"
NSQ_SOURCE_LINE 00000043 "  \tis( $object->foo, 'bar', '->foo returns \"bar\"' );"
NSQ_SOURCE_LINE 00000044 "  }"
NSQ_SOURCE_LINE 00000045 "  "
NSQ_SOURCE_LINE 00000046 "  1;"
NSQ_SOURCE_LINE 00000047 "  "
NSQ_SOURCE_LINE 00000048 "  "
NSQ_SOURCE_LINE 00000049 "  "
NSQ_SOURCE_LINE 00000050 "  ###################################################################"
NSQ_SOURCE_LINE 00000051 "  # In test script, test object against all registered classes      #"
NSQ_SOURCE_LINE 00000052 "  ###################################################################"
NSQ_SOURCE_LINE 00000053 "  "
NSQ_SOURCE_LINE 00000054 "  #!/usr/bin/perl -w"
NSQ_SOURCE_LINE 00000055 "  "
NSQ_SOURCE_LINE 00000056 "  use Test::More 'no_plan';"
NSQ_SOURCE_LINE 00000057 "  use Test::Object;"
NSQ_SOURCE_LINE 00000058 "  use My::ModuleTester;"
NSQ_SOURCE_LINE 00000059 "  "
NSQ_SOURCE_LINE 00000060 "  my $object = Foo::Bar->new;"
NSQ_SOURCE_LINE 00000061 "  isa_ok( $object, 'Foo::Bar' );"
NSQ_SOURCE_LINE 00000062 "  object_ok( $object );"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "In situations where you have deep trees of classes, there is a common"
NSQ_SOURCE_LINE 00000067 "situation in which you test a module 4 or 5 subclasses down, which should"
NSQ_SOURCE_LINE 00000068 "follow the correct behaviour of not just the subclass, but of all the"
NSQ_SOURCE_LINE 00000069 "parent classes."
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "This should be done to ensure that the implementation of a subclass has"
NSQ_SOURCE_LINE 00000072 "not somehow \"broken\" the object's behaviour in a more general sense."
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "C<Test::Object> is a testing package designed to allow you to easily test"
NSQ_SOURCE_LINE 00000075 "what you believe is a valid object against the expected behaviour of B<all>"
NSQ_SOURCE_LINE 00000076 "of the classes in its inheritance tree in one single call."
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "To do this, you \"register\" tests (in the form of CODE or function"
NSQ_SOURCE_LINE 00000079 "references) with C<Test::Object>, with each test associated with a"
NSQ_SOURCE_LINE 00000080 "particular class."
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "When you call C<object_ok> in your test script, C<Test::Object> will check"
NSQ_SOURCE_LINE 00000083 "the object against all registered tests. For each class that your object"
NSQ_SOURCE_LINE 00000084 "responds to C<$object-E<gt>isa($class)> for, the appropriate testing"
NSQ_SOURCE_LINE 00000085 "function will be called."
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "Doing it this way allows adapter objects and other things that respond"
NSQ_SOURCE_LINE 00000088 "to C<isa> differently that the default to still be tested against the"
NSQ_SOURCE_LINE 00000089 "classes that it is advertising itself as correctly."
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "This also means that more than one test might be \"counted\" for each call"
NSQ_SOURCE_LINE 00000092 "to C<object_ok>. You should account for this correctly in your expected"
NSQ_SOURCE_LINE 00000093 "test count."
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=cut"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "use strict;"
NSQ_SOURCE_LINE 00000098 "use Carp               ();"
NSQ_SOURCE_LINE 00000099 "use Exporter           ();"
NSQ_SOURCE_LINE 00000100 "use Test::More         ();"
NSQ_SOURCE_LINE 00000101 "use Scalar::Util       ();"
NSQ_SOURCE_LINE 00000102 "use Test::Object::Test ();"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "our $VERSION = '0.08';"
NSQ_SOURCE_LINE 00000105 "use vars qw{@ISA @EXPORT};"
NSQ_SOURCE_LINE 00000106 "BEGIN {"
NSQ_SOURCE_LINE 00000107 "\t@ISA     = 'Exporter';"
NSQ_SOURCE_LINE 00000108 "\t@EXPORT  = 'object_ok';"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "#####################################################################"
NSQ_SOURCE_LINE 00000116 "# Registration and Planning"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "my @TESTS = ();"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "sub register {"
NSQ_SOURCE_LINE 00000121 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000122 "\tpush @TESTS, Test::Object::Test->new( @_ );"
NSQ_SOURCE_LINE 00000123 "}"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "#####################################################################"
NSQ_SOURCE_LINE 00000130 "# Testing Functions"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "sub object_ok {"
NSQ_SOURCE_LINE 00000133 "\tmy $object = Scalar::Util::blessed($_[0]) ? shift"
NSQ_SOURCE_LINE 00000134 "\t\t: Carp::croak(\"Did not provide an object to object_ok\");"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "\t# Iterate over the tests and run any we ->isa"
NSQ_SOURCE_LINE 00000137 "\tforeach my $test ( @TESTS ) {"
NSQ_SOURCE_LINE 00000138 "\t\t$test->run( $object ) if $object->isa( $test->class );"
NSQ_SOURCE_LINE 00000139 "\t}"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "\t1;"
NSQ_SOURCE_LINE 00000142 "}"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "1;"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=pod"
NSQ_SOURCE_LINE 00000147 ""
