NSQ_SOURCE_LINE 00000001 "package String::Wildcard::Bash;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Exporter 'import';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000010 "our $DATE = '2022-08-12'; # DATE"
NSQ_SOURCE_LINE 00000011 "our $DIST = 'String-Wildcard-Bash'; # DIST"
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.045'; # VERSION"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000015 "                       $RE_WILDCARD_BASH"
NSQ_SOURCE_LINE 00000016 "                       contains_wildcard"
NSQ_SOURCE_LINE 00000017 "                       contains_brace_wildcard"
NSQ_SOURCE_LINE 00000018 "                       contains_class_wildcard"
NSQ_SOURCE_LINE 00000019 "                       contains_joker_wildcard"
NSQ_SOURCE_LINE 00000020 "                       contains_qmark_wildcard"
NSQ_SOURCE_LINE 00000021 "                       contains_glob_wildcard"
NSQ_SOURCE_LINE 00000022 "                       contains_globstar_wildcard"
NSQ_SOURCE_LINE 00000023 "                       convert_wildcard_to_sql"
NSQ_SOURCE_LINE 00000024 "                       convert_wildcard_to_re"
NSQ_SOURCE_LINE 00000025 "               );"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "our $re_bash_brace_element ="
NSQ_SOURCE_LINE 00000028 "    qr("
NSQ_SOURCE_LINE 00000029 "          (?:(?:\\\\\\\\ | \\\\, | \\\\\\{ | \\\\\\} | [^\\\\\\{,\\}])*)"
NSQ_SOURCE_LINE 00000030 "  )x;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "# note: order is important here, brace encloses the other"
NSQ_SOURCE_LINE 00000033 "our $RE_WILDCARD_BASH ="
NSQ_SOURCE_LINE 00000034 "    qr("
NSQ_SOURCE_LINE 00000035 "          # non-escaped brace expression, with at least one comma"
NSQ_SOURCE_LINE 00000036 "          (?P<bash_brace>"
NSQ_SOURCE_LINE 00000037 "              (?<!\\\\)(?P<slashes_before_bash_brace>\\\\\\\\)*\\{"
NSQ_SOURCE_LINE 00000038 "              (?P<bash_brace_content>"
NSQ_SOURCE_LINE 00000039 "                  $re_bash_brace_element(?:, $re_bash_brace_element )+"
NSQ_SOURCE_LINE 00000040 "              )"
NSQ_SOURCE_LINE 00000041 "              (?<!\\\\)(?:\\\\\\\\)*\\}"
NSQ_SOURCE_LINE 00000042 "          )"
NSQ_SOURCE_LINE 00000043 "      |"
NSQ_SOURCE_LINE 00000044 "          # non-escaped brace expression, to catch * or ? or [...] inside so"
NSQ_SOURCE_LINE 00000045 "          # they don't go to below pattern, because bash doesn't consider them"
NSQ_SOURCE_LINE 00000046 "          # wildcards, e.g. '/{et?,us*}' expands to '/etc /usr', but '/{et?}'"
NSQ_SOURCE_LINE 00000047 "          # doesn't expand at all to /etc."
NSQ_SOURCE_LINE 00000048 "          (?P<literal_brace_single_element>"
NSQ_SOURCE_LINE 00000049 "              (?<!\\\\)(?:\\\\\\\\)*\\{"
NSQ_SOURCE_LINE 00000050 "              $re_bash_brace_element"
NSQ_SOURCE_LINE 00000051 "              (?<!\\\\)(?:\\\\\\\\)*\\}"
NSQ_SOURCE_LINE 00000052 "          )"
NSQ_SOURCE_LINE 00000053 "      |"
NSQ_SOURCE_LINE 00000054 "          (?P<bash_class>"
NSQ_SOURCE_LINE 00000055 "              # non-empty, non-escaped character class"
NSQ_SOURCE_LINE 00000056 "              (?<!\\\\)(?:\\\\\\\\)*\\["
NSQ_SOURCE_LINE 00000057 "              (?:  \\\\\\\\ | \\\\\\[ | \\\\\\] | [^\\\\\\[\\]] )+"
NSQ_SOURCE_LINE 00000058 "              (?<!\\\\)(?:\\\\\\\\)*\\]"
NSQ_SOURCE_LINE 00000059 "          )"
NSQ_SOURCE_LINE 00000060 "      |"
NSQ_SOURCE_LINE 00000061 "          (?P<bash_joker>"
NSQ_SOURCE_LINE 00000062 "              # non-escaped * and ?"
NSQ_SOURCE_LINE 00000063 "              (?<!\\\\)(?:\\\\\\\\)*(?:\\*\\*?|\\?)"
NSQ_SOURCE_LINE 00000064 "          )"
NSQ_SOURCE_LINE 00000065 "      |"
NSQ_SOURCE_LINE 00000066 "          (?P<sql_joker>"
NSQ_SOURCE_LINE 00000067 "              # non-escaped % and ?"
NSQ_SOURCE_LINE 00000068 "              (?<!\\\\)(?:\\\\\\\\)*[%_]"
NSQ_SOURCE_LINE 00000069 "          )"
NSQ_SOURCE_LINE 00000070 "      |"
NSQ_SOURCE_LINE 00000071 "          (?P<literal>"
NSQ_SOURCE_LINE 00000072 "              [^\\\\\\[\\]\\{\\}*?%_]+"
NSQ_SOURCE_LINE 00000073 "          |"
NSQ_SOURCE_LINE 00000074 "              .+?"
NSQ_SOURCE_LINE 00000075 "          )"
NSQ_SOURCE_LINE 00000076 "      )ox;"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "sub contains_wildcard {"
NSQ_SOURCE_LINE 00000079 "    my $str = shift;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    while ($str =~ /$RE_WILDCARD_BASH/go) {"
NSQ_SOURCE_LINE 00000082 "        my %m = %+;"
NSQ_SOURCE_LINE 00000083 "        return 1 if $m{bash_brace} || $m{bash_class} || $m{bash_joker};"
NSQ_SOURCE_LINE 00000084 "    }"
NSQ_SOURCE_LINE 00000085 "    0;"
NSQ_SOURCE_LINE 00000086 "}"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "sub contains_brace_wildcard {"
NSQ_SOURCE_LINE 00000089 "    my $str = shift;"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "    while ($str =~ /$RE_WILDCARD_BASH/go) {"
NSQ_SOURCE_LINE 00000092 "        my %m = %+;"
NSQ_SOURCE_LINE 00000093 "        return 1 if $m{bash_brace};"
NSQ_SOURCE_LINE 00000094 "    }"
NSQ_SOURCE_LINE 00000095 "    0;"
NSQ_SOURCE_LINE 00000096 "}"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "sub contains_joker_wildcard {"
NSQ_SOURCE_LINE 00000099 "    my $str = shift;"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    while ($str =~ /$RE_WILDCARD_BASH/go) {"
NSQ_SOURCE_LINE 00000102 "        my %m = %+;"
NSQ_SOURCE_LINE 00000103 "        return 1 if $m{bash_joker};"
NSQ_SOURCE_LINE 00000104 "    }"
NSQ_SOURCE_LINE 00000105 "    0;"
NSQ_SOURCE_LINE 00000106 "}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "sub contains_class_wildcard {"
NSQ_SOURCE_LINE 00000109 "    my $str = shift;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    while ($str =~ /$RE_WILDCARD_BASH/go) {"
NSQ_SOURCE_LINE 00000112 "        my %m = %+;"
NSQ_SOURCE_LINE 00000113 "        return 1 if $m{bash_class};"
NSQ_SOURCE_LINE 00000114 "    }"
NSQ_SOURCE_LINE 00000115 "    0;"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "sub contains_qmark_wildcard {"
NSQ_SOURCE_LINE 00000119 "    my $str = shift;"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "    while ($str =~ /$RE_WILDCARD_BASH/go) {"
NSQ_SOURCE_LINE 00000122 "        my %m = %+;"
NSQ_SOURCE_LINE 00000123 "        return 1 if $m{bash_joker} && $m{bash_joker} eq '?';"
NSQ_SOURCE_LINE 00000124 "    }"
NSQ_SOURCE_LINE 00000125 "    0;"
NSQ_SOURCE_LINE 00000126 "}"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "sub contains_glob_wildcard {"
NSQ_SOURCE_LINE 00000129 "    my $str = shift;"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    while ($str =~ /$RE_WILDCARD_BASH/go) {"
NSQ_SOURCE_LINE 00000132 "        my %m = %+;"
NSQ_SOURCE_LINE 00000133 "        return 1 if $m{bash_joker} && $m{bash_joker} eq '*';"
NSQ_SOURCE_LINE 00000134 "    }"
NSQ_SOURCE_LINE 00000135 "    0;"
NSQ_SOURCE_LINE 00000136 "}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "sub contains_globstar_wildcard {"
NSQ_SOURCE_LINE 00000139 "    my $str = shift;"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    while ($str =~ /$RE_WILDCARD_BASH/go) {"
NSQ_SOURCE_LINE 00000142 "        my %m = %+;"
NSQ_SOURCE_LINE 00000143 "        return 1 if $m{bash_joker} && $m{bash_joker} eq '**';"
NSQ_SOURCE_LINE 00000144 "    }"
NSQ_SOURCE_LINE 00000145 "    0;"
NSQ_SOURCE_LINE 00000146 "}"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "sub convert_wildcard_to_sql {"
NSQ_SOURCE_LINE 00000149 "    my $opts = ref $_[0] eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000150 "    my $str = shift;"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    my @res;"
NSQ_SOURCE_LINE 00000153 "    my $p;"
NSQ_SOURCE_LINE 00000154 "    while ($str =~ /$RE_WILDCARD_BASH/g) {"
NSQ_SOURCE_LINE 00000155 "        my %m = %+;"
NSQ_SOURCE_LINE 00000156 "        if (defined($p = $m{bash_brace_content})) {"
NSQ_SOURCE_LINE 00000157 "            die \"Cannot convert brace pattern '$p' to SQL\";"
NSQ_SOURCE_LINE 00000158 "        } elsif ($p = $m{bash_joker}) {"
NSQ_SOURCE_LINE 00000159 "            if ($m{bash_joker} eq '*' || $m{bash_joker} eq '**') {"
NSQ_SOURCE_LINE 00000160 "                push @res, \"%\";"
NSQ_SOURCE_LINE 00000161 "            } else {"
NSQ_SOURCE_LINE 00000162 "                push @res, \"_\";"
NSQ_SOURCE_LINE 00000163 "            }"
NSQ_SOURCE_LINE 00000164 "        } elsif ($p = $m{sql_joker}) {"
NSQ_SOURCE_LINE 00000165 "            push @res, \"\\\\$p\";"
NSQ_SOURCE_LINE 00000166 "        } elsif (defined($p = $m{literal_brace_single_element})) {"
NSQ_SOURCE_LINE 00000167 "            die \"Currently cannot convert brace literal '$p' to SQL\";"
NSQ_SOURCE_LINE 00000168 "        } elsif (defined($p = $m{bash_class})) {"
NSQ_SOURCE_LINE 00000169 "            die \"Currently cannot convert class pattern '$p' to SQL\";"
NSQ_SOURCE_LINE 00000170 "        } elsif (defined($p = $m{literal})) {"
NSQ_SOURCE_LINE 00000171 "            push @res, $p;"
NSQ_SOURCE_LINE 00000172 "        }"
NSQ_SOURCE_LINE 00000173 "    }"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    join \"\", @res;"
NSQ_SOURCE_LINE 00000176 "}"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "sub convert_wildcard_to_re {"
NSQ_SOURCE_LINE 00000179 "    my $opts = ref $_[0] eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000180 "    my $str = shift;"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    my $opt_brace    = $opts->{brace} // 1;"
NSQ_SOURCE_LINE 00000183 "    my $opt_dotglob  = $opts->{dotglob} // 0;"
NSQ_SOURCE_LINE 00000184 "    my $opt_globstar = $opts->{globstar} // 0;"
NSQ_SOURCE_LINE 00000185 "    my $opt_ps       = $opts->{path_separator} // '/';"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "    die \"Please use a single character for path_separator\" unless length($opt_ps) == 1;"
NSQ_SOURCE_LINE 00000188 "    my $q_ps ="
NSQ_SOURCE_LINE 00000189 "        $opt_ps eq '-' ? \"\\\\-\" :"
NSQ_SOURCE_LINE 00000190 "        $opt_ps eq '/' ? '/' :"
NSQ_SOURCE_LINE 00000191 "        quotemeta($opt_ps);"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    my $re_not_ps        = \"[^$q_ps]\";"
NSQ_SOURCE_LINE 00000194 "    my $re_not_dot       = \"[^.]\";"
NSQ_SOURCE_LINE 00000195 "    my $re_not_dot_or_ps = \"[^.$q_ps]\";"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "    my @res;"
NSQ_SOURCE_LINE 00000198 "    my $p;"
NSQ_SOURCE_LINE 00000199 "    my $after_pathsep;"
NSQ_SOURCE_LINE 00000200 "    while ($str =~ /$RE_WILDCARD_BASH/g) {"
NSQ_SOURCE_LINE 00000201 "        my %m = %+;"
NSQ_SOURCE_LINE 00000202 "        if (defined($p = $m{bash_brace_content})) {"
NSQ_SOURCE_LINE 00000203 "            push @res, quotemeta($m{slashes_before_bash_brace}) if"
NSQ_SOURCE_LINE 00000204 "                $m{slashes_before_bash_brace};"
NSQ_SOURCE_LINE 00000205 "            if ($opt_brace) {"
NSQ_SOURCE_LINE 00000206 "                my @elems;"
NSQ_SOURCE_LINE 00000207 "                while ($p =~ /($re_bash_brace_element)(,|\\z)/g) {"
NSQ_SOURCE_LINE 00000208 "                    push @elems, $1;"
NSQ_SOURCE_LINE 00000209 "                    last unless $2;"
NSQ_SOURCE_LINE 00000210 "                }"
NSQ_SOURCE_LINE 00000211 "                #use DD; dd \\@elems;"
NSQ_SOURCE_LINE 00000212 "                push @res, \"(?:\", join(\"|\", map {"
NSQ_SOURCE_LINE 00000213 "                    convert_wildcard_to_re({"
NSQ_SOURCE_LINE 00000214 "                        brace    => 0,"
NSQ_SOURCE_LINE 00000215 "                        dotglob  => $opt_dotglob,"
NSQ_SOURCE_LINE 00000216 "                        globstar => $opt_globstar,"
NSQ_SOURCE_LINE 00000217 "                    }, $_)} @elems), \")\";"
NSQ_SOURCE_LINE 00000218 "            } else {"
NSQ_SOURCE_LINE 00000219 "                push @res, quotemeta($m{bash_brace});"
NSQ_SOURCE_LINE 00000220 "            }"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "        } elsif (defined($p = $m{bash_joker})) {"
NSQ_SOURCE_LINE 00000223 "            if ($p eq '?') {"
NSQ_SOURCE_LINE 00000224 "                push @res, '.';"
NSQ_SOURCE_LINE 00000225 "            } elsif ($p eq '*' || $p eq '**' && !$opt_globstar) {"
NSQ_SOURCE_LINE 00000226 "                push @res, $opt_dotglob || (@res && !$after_pathsep) ?"
NSQ_SOURCE_LINE 00000227 "                    \"$re_not_ps*\" : \"$re_not_dot_or_ps$re_not_ps*\";"
NSQ_SOURCE_LINE 00000228 "            } elsif ($p eq '**') { # and with 'globstar' option set"
NSQ_SOURCE_LINE 00000229 "                if ($opt_dotglob) {"
NSQ_SOURCE_LINE 00000230 "                    push @res, '.*';"
NSQ_SOURCE_LINE 00000231 "                } elsif (@res && !$after_pathsep) {"
NSQ_SOURCE_LINE 00000232 "                    push @res, \"(?:$re_not_ps*)(?:$q_ps+$re_not_dot_or_ps$re_not_ps*)*\";"
NSQ_SOURCE_LINE 00000233 "                } else {"
NSQ_SOURCE_LINE 00000234 "                    push @res, \"(?:$re_not_dot_or_ps$re_not_ps*)(?:$q_ps+$re_not_dot_or_ps$re_not_ps*)*\";"
NSQ_SOURCE_LINE 00000235 "                }"
NSQ_SOURCE_LINE 00000236 "           }"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "        } elsif (defined($p = $m{literal_brace_single_element})) {"
NSQ_SOURCE_LINE 00000239 "            push @res, quotemeta($p);"
NSQ_SOURCE_LINE 00000240 "        } elsif (defined($p = $m{bash_class})) {"
NSQ_SOURCE_LINE 00000241 "            # XXX no need to escape some characters?"
NSQ_SOURCE_LINE 00000242 "            push @res, $p;"
NSQ_SOURCE_LINE 00000243 "        } elsif (defined($p = $m{sql_joker})) {"
NSQ_SOURCE_LINE 00000244 "            push @res, quotemeta($p);"
NSQ_SOURCE_LINE 00000245 "        } elsif (defined($p = $m{literal})) {"
NSQ_SOURCE_LINE 00000246 "            push @res, quotemeta($p);"
NSQ_SOURCE_LINE 00000247 "        }"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "        $after_pathsep = defined($m{literal}) && substr($m{literal}, -1) eq $opt_ps;"
NSQ_SOURCE_LINE 00000250 "    }"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    join \"\", @res;"
NSQ_SOURCE_LINE 00000253 "}"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "1;"
NSQ_SOURCE_LINE 00000256 "# ABSTRACT: Bash wildcard string routines"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "__END__"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=pod"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=head1 NAME"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "String::Wildcard::Bash - Bash wildcard string routines"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=head1 VERSION"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "This document describes version 0.045 of String::Wildcard::Bash (from Perl distribution String-Wildcard-Bash), released on 2022-08-12."
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "    use String::Wildcard::Bash qw("
NSQ_SOURCE_LINE 00000275 "        $RE_WILDCARD_BASH"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "        contains_wildcard"
NSQ_SOURCE_LINE 00000278 "        contains_brace_wildcard"
NSQ_SOURCE_LINE 00000279 "        contains_class_wildcard"
NSQ_SOURCE_LINE 00000280 "        contains_joker_wildcard"
NSQ_SOURCE_LINE 00000281 "        contains_qmark_wildcard"
NSQ_SOURCE_LINE 00000282 "        contains_glob_wildcard"
NSQ_SOURCE_LINE 00000283 "        contains_globstar_wildcard"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "        convert_wildcard_to_sql"
NSQ_SOURCE_LINE 00000286 "        convert_wildcard_to_re"
NSQ_SOURCE_LINE 00000287 "    );"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "    say 1 if contains_wildcard(\"\"));      # ->"
NSQ_SOURCE_LINE 00000290 "    say 1 if contains_wildcard(\"ab*\"));   # -> 1"
NSQ_SOURCE_LINE 00000291 "    say 1 if contains_wildcard(\"ab\\\\*\")); # ->"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "    say 1 if contains_glob_wildcard(\"ab*\"));   # -> 1"
NSQ_SOURCE_LINE 00000294 "    say 1 if contains_glob_wildcard(\"ab?\"));   # ->"
NSQ_SOURCE_LINE 00000295 "    say 1 if contains_qmark_wildcard(\"ab?\"));  # -> 1"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "    say convert_wildcard_to_sql(\"foo*\");  # -> \"foo%\""
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "    say convert_wildcard_to_re(\"foo*\");   # -> \"foo.*\""
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=for Pod::Coverage ^(qqquote)$"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=head1 VARIABLES"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=head2 $RE_WILDCARD_BASH"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "=head2 contains_wildcard"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "Usage:"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 " $bool = contains_wildcard($wildcard_str)"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "Return true if C<$str> contains wildcard pattern. Wildcard patterns include"
NSQ_SOURCE_LINE 00000318 "I<joker> such as C<*> (meaning zero or more of any characters) and C<?> (exactly"
NSQ_SOURCE_LINE 00000319 "one of any character), I<character class> C<[...]>, and I<brace> C<{...,}>"
NSQ_SOURCE_LINE 00000320 "(brace expansion). A pattern can be escaped using a bacslash so it becomes"
NSQ_SOURCE_LINE 00000321 "literal, e.g. C<foo\\*> does not contain wildcard because it's C<foo> followed by"
NSQ_SOURCE_LINE 00000322 "a literal asterisk C<*>."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "Aside from the abovementioned wildcard patterns, bash does other types of"
NSQ_SOURCE_LINE 00000325 "expansions/substitutions too, but these are not considered wildcard. These"
NSQ_SOURCE_LINE 00000326 "include tilde expansion (e.g. C<~> becomes C</home/alice>), parameter and"
NSQ_SOURCE_LINE 00000327 "variable expansion (e.g. C<$0> and C<$HOME>), arithmetic expression (e.g."
NSQ_SOURCE_LINE 00000328 "C<$[1+2]>), or history (C<!>)."
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "Although this module has 'Bash' in its name, this set of wildcards should be"
NSQ_SOURCE_LINE 00000331 "applicable to other Unix shells. Haven't checked completely though."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "For more specific needs, e.g. you want to check if a string just contains joker"
NSQ_SOURCE_LINE 00000334 "and not other types of wildcard patterns, use L</\"$RE_WILDCARD_BASH\"> directly"
NSQ_SOURCE_LINE 00000335 "or one of the C<contains_*_wildcard> functions."
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=head2 contains_brace_wildcard"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "Like L</contains_wildcard>, but only return true if string contains brace"
NSQ_SOURCE_LINE 00000340 "(C<{...,}>) wildcard pattern."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=head2 contains_class_wildcard"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "Like L</contains_wildcard>, but only return true if string contains character"
NSQ_SOURCE_LINE 00000345 "class (C<[...]>) wildcard pattern."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=head2 contains_joker_wildcard"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "Like L</contains_wildcard>, but only return true if string contains any of the"
NSQ_SOURCE_LINE 00000350 "joker (C<?>, C<*>, or C<**>) wildcard patterns."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=head2 contains_qmark_wildcard"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "Like L</contains_wildcard>, but only return true if string contains the question"
NSQ_SOURCE_LINE 00000355 "mark joker (C<?>) wildcard pattern."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=head2 contains_glob_wildcard"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "Like L</contains_wildcard>, but only return true if string contains the glob"
NSQ_SOURCE_LINE 00000360 "joker (C<*>, and not C<**>) wildcard pattern."
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "=head2 contains_globstar_wildcard"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "Like L</contains_wildcard>, but only return true if string contains the globstar"
NSQ_SOURCE_LINE 00000365 "joker (C<**> and not C<*>) wildcard pattern."
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=head2 convert_wildcard_to_sql"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "Usage:"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 " $sql_str = convert_wildcard_to_sql($wildcard_str);"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "Convert bash wildcard to SQL pattern. This includes:"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=over"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "=item * converting unescaped C<*> to C<%>"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=item * converting unescaped C<?> to C<_>"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=item * escaping unescaped C<%>"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "=item * escaping unescaped C<_>"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=back"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "Unsupported constructs will cause the function to die."
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "=head2 convert_wildcard_to_re"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "Usage:"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 " $re_str = convert_wildcard_to_re([ \\%opts, ] $wildcard_str);"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "Convert bash wildcard to regular expression string."
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "Known options:"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=over"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=item * brace"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "Bool. Default is true. Whether to expand braces or not. If set to false, will"
NSQ_SOURCE_LINE 00000404 "simply treat brace as literals."
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "Examples:"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 " convert_wildcard_to_re(            \"{a,b}\"); # => \"(?:a|b)\""
NSQ_SOURCE_LINE 00000409 " convert_wildcard_to_re({brace=>0}, \"{a,b}\"); # => \"\\\\{a\\\\,b\\\\}\""
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=item * dotglob"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "Bool. Default is false. Whether joker C<*> (asterisk) will match a dot file. The"
NSQ_SOURCE_LINE 00000414 "default behavior follows bash; that is, dot file must be matched explicitly with"
NSQ_SOURCE_LINE 00000415 "C<.*>."
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "This setting is similar to shell behavior (shopt) setting C<dotglob>."
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "Examples:"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 " convert_wildcard_to_re({}          , '*a*'); # => \"[^.][^/]*a[^/]*\""
NSQ_SOURCE_LINE 00000422 " convert_wildcard_to_re({dotglob=>1}, '*a*'); # =>     \"[^/]*a[^/]*\""
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "=item * globstar"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "Bool. Default is false. Whether globstar (C<**>) can match across subdirectories"
NSQ_SOURCE_LINE 00000427 "(matches path separator). The default behavior follows bash; that is, globstar"
NSQ_SOURCE_LINE 00000428 "option is off and C<**> behaves like C<*>."
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "This setting is similar to shell behavior (shopt) setting C<globstar>."
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 " convert_wildcard_to_re({},                         '*'); # => \"[^.][^/]*\""
NSQ_SOURCE_LINE 00000433 " convert_wildcard_to_re({},                        '**'); # => \"[^.][^/]*\""
NSQ_SOURCE_LINE 00000434 " convert_wildcard_to_re({globstar=>1},             '**'); # => \"(?:[^/.][^/]*)(?:/+[^/.][^/]*)*\""
NSQ_SOURCE_LINE 00000435 " convert_wildcard_to_re({globstar=>1, dotglob=>1}, '**'); # => \".*\""
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=item * path_separator"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "String, 1 character. Default is C</>. Can be used to customize the path"
NSQ_SOURCE_LINE 00000440 "separator."
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "=back"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "Please visit the project's homepage at L<https://metacpan.org/release/String-Wildcard-Bash>."
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "Source repository is at L<https://github.com/perlancar/perl-String-Wildcard-Bash>."
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "L<Regexp::Wildcards> can also convert a string with wildcard pattern to"
NSQ_SOURCE_LINE 00000455 "equivalent regexp pattern, like L</convert_wildcard_to_re>. Can handle Unix"
NSQ_SOURCE_LINE 00000456 "wildcards as well as SQL and DOS/Win32. As of this writing (v1.05), it does not"
NSQ_SOURCE_LINE 00000457 "handle character class (C<[...]>) and interprets brace expansion differently"
NSQ_SOURCE_LINE 00000458 "than bash. String::Wildcard::Bash's C<convert_wildcard_to_re> follows bash"
NSQ_SOURCE_LINE 00000459 "behavior more closely and also provides more options."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "Other C<String::Wildcard::*> modules."
NSQ_SOURCE_LINE 00000462 ""
