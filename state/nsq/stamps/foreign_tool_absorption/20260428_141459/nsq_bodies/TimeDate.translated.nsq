NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "=head1 NAME"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "TimeDate - Date and time formatting subroutines"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "=head1 VERSION"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "version 2.35"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    use Date::Format;"
NSQ_SOURCE_LINE 00000025 "    use Date::Parse;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    # Formatting"
NSQ_SOURCE_LINE 00000028 "    print time2str(\"%Y-%m-%d %T\", time);          # 2024-01-15 14:30:00"
NSQ_SOURCE_LINE 00000029 "    print time2str(\"%a %b %e %T %Y\\n\", time);     # Mon Jan 15 14:30:00 2024"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    # Parsing"
NSQ_SOURCE_LINE 00000032 "    my $time = str2time(\"Wed, 16 Jun 94 07:29:35 CST\");"
NSQ_SOURCE_LINE 00000033 "    my ($ss,$mm,$hh,$day,$month,$year,$zone) = strptime(\"2024-01-15T14:30:00Z\");"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    # Multi-language support"
NSQ_SOURCE_LINE 00000036 "    use Date::Language;"
NSQ_SOURCE_LINE 00000037 "    my $lang = Date::Language->new('German');"
NSQ_SOURCE_LINE 00000038 "    print $lang->time2str(\"%a %b %e %T %Y\\n\", time);"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "The TimeDate distribution provides date parsing, formatting, and timezone"
NSQ_SOURCE_LINE 00000043 "handling for Perl."
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=over 4"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=item L<Date::Parse>"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "Parse date strings in a wide variety of formats into Unix timestamps"
NSQ_SOURCE_LINE 00000050 "or component values."
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=item L<Date::Format>"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "Format Unix timestamps or localtime arrays into strings using"
NSQ_SOURCE_LINE 00000055 "C<strftime>-style conversion specifications."
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=item L<Date::Language>"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "Format and parse dates in over 30 languages including French, German,"
NSQ_SOURCE_LINE 00000060 "Spanish, Chinese, Russian, Arabic, and many more."
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=item L<Time::Zone>"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "Timezone offset lookups and conversions for named timezones."
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=back"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "L<Date::Format>, L<Date::Parse>, L<Date::Language>, L<Time::Zone>"
