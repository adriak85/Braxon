BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Crypt::Random::TESHA2;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use Carp qw/croak confess carp/;"
NSQ_SOURCE_LINE 00000005 "use Time::HiRes qw/gettimeofday usleep/;"
NSQ_SOURCE_LINE 00000006 "use Digest::SHA qw/sha256 sha512/;"
NSQ_SOURCE_LINE 00000007 "use Crypt::Random::TESHA2::Config;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "BEGIN {"
NSQ_SOURCE_LINE 00000010 "  $Crypt::Random::TESHA2::AUTHORITY = 'cpan:DANAJ';"
NSQ_SOURCE_LINE 00000011 "  $Crypt::Random::TESHA2::VERSION = '0.01';"
NSQ_SOURCE_LINE 00000012 "}"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "use base qw( Exporter );"
NSQ_SOURCE_LINE 00000015 "our @EXPORT_OK = qw( random_bytes random_values irand rand is_strong );"
NSQ_SOURCE_LINE 00000016 "our %EXPORT_TAGS = (all => [ @EXPORT_OK ]);"
NSQ_SOURCE_LINE 00000017 "our @EXPORT = qw( );  # nothing by default"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "my $_opt_need_strong = 0;"
NSQ_SOURCE_LINE 00000020 "my $_opt_weak_ok     = 0;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "my $_entropy_per_raw_byte = Crypt::Random::TESHA2::Config::entropy();"
NSQ_SOURCE_LINE 00000023 "# Protect against possible abuse / misconfiguration"
NSQ_SOURCE_LINE 00000024 "$_entropy_per_raw_byte = 1 if $_entropy_per_raw_byte < 1;"
NSQ_SOURCE_LINE 00000025 "$_entropy_per_raw_byte = 7 if $_entropy_per_raw_byte > 7;"
NSQ_SOURCE_LINE 00000026 "my $_hashalg = \\&sha512;"
NSQ_SOURCE_LINE 00000027 "my $_pool_size = 512;"
NSQ_SOURCE_LINE 00000028 "my $_nehi = 0;            # A 64-bit counter"
NSQ_SOURCE_LINE 00000029 "my $_nelo = 0;"
NSQ_SOURCE_LINE 00000030 "my $_pool;"
NSQ_SOURCE_LINE 00000031 "my $_C;                   # bits of entropy that we think are in the pool"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "# Make sure SHA512 is supported, back off to 256 if not."
NSQ_SOURCE_LINE 00000034 "if (!defined sha512(\"test\")) {"
NSQ_SOURCE_LINE 00000035 "  $_pool_size = 256;"
NSQ_SOURCE_LINE 00000036 "  $_hashalg = \\&sha256;"
NSQ_SOURCE_LINE 00000037 "}"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "sub import {"
NSQ_SOURCE_LINE 00000040 "  my @options;"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "  @options = grep { $_ !~ /^[-:]?weak$/i } @_;"
NSQ_SOURCE_LINE 00000043 "  $_opt_weak_ok = 1 if @options != @_;"
NSQ_SOURCE_LINE 00000044 "  @_ = @options;"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "  @options = grep { $_ !~ /^[-:]?strong$/i } @_;"
NSQ_SOURCE_LINE 00000047 "  $_opt_need_strong = 1 if @options != @_;"
NSQ_SOURCE_LINE 00000048 "  @_ = @options;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "  croak \"TESHA2 is not a strong randomness source on this platform\""
NSQ_SOURCE_LINE 00000051 "    if $_opt_need_strong && !is_strong();"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "  goto &Exporter::import;"
NSQ_SOURCE_LINE 00000054 "}"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "# Returns 1 if our installtion-time entropy measurements indicated we could"
NSQ_SOURCE_LINE 00000057 "# get enough entropy to make this method work on this platform."
NSQ_SOURCE_LINE 00000058 "sub is_strong {"
NSQ_SOURCE_LINE 00000059 "  return ($_entropy_per_raw_byte > 1.0) ? 1 : 0;"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "# Return $n random 32-bit values"
NSQ_SOURCE_LINE 00000063 "sub random_values {"
NSQ_SOURCE_LINE 00000064 "  return map { unpack(\"L\", random_bytes(4)) } 1 .. shift;"
NSQ_SOURCE_LINE 00000065 "}"
NSQ_SOURCE_LINE 00000066 "# Note, only 32 bits."
NSQ_SOURCE_LINE 00000067 "# TODO: Figure out a portable non-64-bit way to make 52-bit doubles."
NSQ_SOURCE_LINE 00000068 "sub rand {"
NSQ_SOURCE_LINE 00000069 "  return ($_[0]||1) * (unpack(\"L\", random_bytes(4))/4294967296.0);"
NSQ_SOURCE_LINE 00000070 "}"
NSQ_SOURCE_LINE 00000071 "sub irand {"
NSQ_SOURCE_LINE 00000072 "  return unpack(\"L\", random_bytes(4));"
NSQ_SOURCE_LINE 00000073 "}"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "# This uses an entropy pool (see Encyclopedia of Cryptography and Security,"
NSQ_SOURCE_LINE 00000076 "# volume 2, \"Entropy Sources\").  We use SHA-512 to handle a 512-bit pool."
NSQ_SOURCE_LINE 00000077 "# One this this will do is ensure the input from any one byte is nicely"
NSQ_SOURCE_LINE 00000078 "# spread out among the 64 bytes of the pool."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "sub random_bytes {"
NSQ_SOURCE_LINE 00000081 "  my $n = shift;"
NSQ_SOURCE_LINE 00000082 "  return '' unless defined $n;"
NSQ_SOURCE_LINE 00000083 "  if (!defined $_pool) {"
NSQ_SOURCE_LINE 00000084 "    # Initialize pool with 64 bits of entropy."
NSQ_SOURCE_LINE 00000085 "    $_C = 64;"
NSQ_SOURCE_LINE 00000086 "    # Get some extra bytes at the start."
NSQ_SOURCE_LINE 00000087 "    my $nbytes = 4 + int($_C/$_entropy_per_raw_byte) + 1;"
NSQ_SOURCE_LINE 00000088 "    my $S = join(\"\", map { _get_random_byte() } 1 .. $nbytes);"
NSQ_SOURCE_LINE 00000089 "    $_pool = $_hashalg->($S);"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "    carp \"TESHA2 is not a strong randomness source on this platform\""
NSQ_SOURCE_LINE 00000092 "      if !$_opt_weak_ok && !is_strong();"
NSQ_SOURCE_LINE 00000093 "  }"
NSQ_SOURCE_LINE 00000094 "  my $X = '';"
NSQ_SOURCE_LINE 00000095 "  while (length($X) < $n) {"
NSQ_SOURCE_LINE 00000096 "    my $K = 8 * $n;"
NSQ_SOURCE_LINE 00000097 "    $K = $_pool_size if $K > $_pool_size;"
NSQ_SOURCE_LINE 00000098 "    # Add more entropy to pool if needed."
NSQ_SOURCE_LINE 00000099 "    while ($_C < $K) {"
NSQ_SOURCE_LINE 00000100 "      my $nbytes = int( ($K - $_C) / $_entropy_per_raw_byte ) + 1;"
NSQ_SOURCE_LINE 00000101 "      #warn \"want $K bits, pool has $_C bits.  Adding $nbytes bytes\\n\";"
NSQ_SOURCE_LINE 00000102 "      my $S = join(\"\", map { _get_random_byte() } 1 .. $nbytes);"
NSQ_SOURCE_LINE 00000103 "      $_pool = $_hashalg->($_pool . $S);"
NSQ_SOURCE_LINE 00000104 "      $_C += $_entropy_per_raw_byte * $nbytes;"
NSQ_SOURCE_LINE 00000105 "      $_C = $_pool_size if $_C > $_pool_size;"
NSQ_SOURCE_LINE 00000106 "    }"
NSQ_SOURCE_LINE 00000107 "    # Extract K bits from the pool."
NSQ_SOURCE_LINE 00000108 "    $_C -= $K;"
NSQ_SOURCE_LINE 00000109 "    my $V = $_hashalg->( 'te' . pack(\"LL\", $_nehi, $_nelo) . $_pool );"
NSQ_SOURCE_LINE 00000110 "    if ($_nelo < 4294967295) { $_nelo++; } else { $_nehi++; $_nelo = 0; }"
NSQ_SOURCE_LINE 00000111 "    $X .= substr($V, 0, int($K/8));"
NSQ_SOURCE_LINE 00000112 "  }"
NSQ_SOURCE_LINE 00000113 "  return $X;"
NSQ_SOURCE_LINE 00000114 "}"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "# The heart of the system, where we gather entropy from timer jitter"
NSQ_SOURCE_LINE 00000117 "# (technically this is scheduler jitter).  This is a similar idea to"
NSQ_SOURCE_LINE 00000118 "# timer_entropyd, TrueRand, or the old Math::TrulyRandom module."
NSQ_SOURCE_LINE 00000119 "#"
NSQ_SOURCE_LINE 00000120 "# *) Cryptographically, there are numerous issues here.  This is, at best,"
NSQ_SOURCE_LINE 00000121 "#    one source to feed to a well designed entropy pool system."
NSQ_SOURCE_LINE 00000122 "#"
NSQ_SOURCE_LINE 00000123 "# *) The output of this function passes ENT and TestU01 Rabbit on all systems"
NSQ_SOURCE_LINE 00000124 "#    I've run it on.  timer_entropyd does not, even when von Neumann debiased."
NSQ_SOURCE_LINE 00000125 "#    However, even a counter run through SHA256 will pass these tests, which"
NSQ_SOURCE_LINE 00000126 "#    just indicates the stream data is uncorrelated."
NSQ_SOURCE_LINE 00000127 "#"
NSQ_SOURCE_LINE 00000128 "# *) The entropy tests mentioned above are only one part.  If a system"
NSQ_SOURCE_LINE 00000129 "#    returned the same sequence every time, it may pass all the tests but"
NSQ_SOURCE_LINE 00000130 "#    still be a horrible generator.  That's especially not what one wants"
NSQ_SOURCE_LINE 00000131 "#    from this module."
NSQ_SOURCE_LINE 00000132 "#"
NSQ_SOURCE_LINE 00000133 "# *) I discovered Matt Blaze's truerand after I wrote this -- no ideas or"
NSQ_SOURCE_LINE 00000134 "#    code were used.  However, I got the idea from timer_entropyd, which"
NSQ_SOURCE_LINE 00000135 "#    probably in turn got the idea from truerand.  Version 2.1 (1996) of"
NSQ_SOURCE_LINE 00000136 "#    Matt Blaze's truerand is _far_ more conservative than the old design"
NSQ_SOURCE_LINE 00000137 "#    in Math::TrulyRandom.  First he replaces the old-school byte mixing"
NSQ_SOURCE_LINE 00000138 "#    with a SHA (very similar to my solution here).  Next, he does another"
NSQ_SOURCE_LINE 00000139 "#    mixing to generate the actual bytes, while the old code would use the"
NSQ_SOURCE_LINE 00000140 "#    raw results.  I use a different method above, but the end result is"
NSQ_SOURCE_LINE 00000141 "#    somewhat similar -- we take these raw results and stir them further."
NSQ_SOURCE_LINE 00000142 "#"
NSQ_SOURCE_LINE 00000143 "# *) My tests using the raw timer data are showing 1.5 - 4 bits per xor."
NSQ_SOURCE_LINE 00000144 "#    The truerand 2.1 documentation indicates 0.67 to 1.33 bits per call,"
NSQ_SOURCE_LINE 00000145 "#    then conservatively halves the number."
NSQ_SOURCE_LINE 00000146 "#"
NSQ_SOURCE_LINE 00000147 "# *) Expanding on the above, assume the worst and absolutely no entropy is"
NSQ_SOURCE_LINE 00000148 "#    gathered.  Then each byte will be a sha256 related to the current hires"
NSQ_SOURCE_LINE 00000149 "#    time, where each byte is mixed in the pool.  We get a fine PRNG, just"
NSQ_SOURCE_LINE 00000150 "#    not seeded well (from a crypto point of view, this is awful)."
NSQ_SOURCE_LINE 00000151 "#"
NSQ_SOURCE_LINE 00000152 "# *) For each bit, the two microsecond values are xor'd and packed into"
NSQ_SOURCE_LINE 00000153 "#    32-bit words.  Eight of these are concatenated and a SHA-256 hash is"
NSQ_SOURCE_LINE 00000154 "#    performed.  As long as the sum of entropy gathered from all eight xors"
NSQ_SOURCE_LINE 00000155 "#    is at least 8, we're good.  The sha256 takes care of shuffling bits so"
NSQ_SOURCE_LINE 00000156 "#    there aren't biases.  This generates a much better result than using"
NSQ_SOURCE_LINE 00000157 "#    boolean differences like timer_entropyd (even if the differences are"
NSQ_SOURCE_LINE 00000158 "#    sent through von Neumann debiasing)."
NSQ_SOURCE_LINE 00000159 "#"
NSQ_SOURCE_LINE 00000160 "sub _get_random_byte {"
NSQ_SOURCE_LINE 00000161 "  my ($start, $t1, $t2) = gettimeofday();"
NSQ_SOURCE_LINE 00000162 "  # This basically gives us a counter, so every call is unique.  We can"
NSQ_SOURCE_LINE 00000163 "  # assume it adds no entropy."
NSQ_SOURCE_LINE 00000164 "  my $str = pack(\"LL\", $start, $t1);"
NSQ_SOURCE_LINE 00000165 "  # A hash we will use for a little bit of CPU processing inside the loop."
NSQ_SOURCE_LINE 00000166 "  my %dummy;"
NSQ_SOURCE_LINE 00000167 "  foreach my $bit (1 .. 8) {"
NSQ_SOURCE_LINE 00000168 "    # Sleep some period of time.  Differ the times so we don't hit a"
NSQ_SOURCE_LINE 00000169 "    # particular beat of the scheduler."
NSQ_SOURCE_LINE 00000170 "    usleep(2+3*$bit);"
NSQ_SOURCE_LINE 00000171 "    (undef, $t2) = gettimeofday();"
NSQ_SOURCE_LINE 00000172 "    # xor the two.  The entropy is in the variation between what we got"
NSQ_SOURCE_LINE 00000173 "    # (t2 - t1) and what we expected (2+3*bit + c)."
NSQ_SOURCE_LINE 00000174 "    $str .= pack(\"L\", $t1 ^ $t2);"
NSQ_SOURCE_LINE 00000175 "    # A little hash processing to further perturb the times."
NSQ_SOURCE_LINE 00000176 "    $dummy{$str . $_}++ for 1..8;"
NSQ_SOURCE_LINE 00000177 "    $t1 = $t2;"
NSQ_SOURCE_LINE 00000178 "  }"
NSQ_SOURCE_LINE 00000179 "  # To truly return a byte:  return substr( sha256($str), 0, 1 );"
NSQ_SOURCE_LINE 00000180 "  # Return the entire string -- let the pool figure it out."
NSQ_SOURCE_LINE 00000181 "  return sha256($str);"
NSQ_SOURCE_LINE 00000182 "}"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "1;"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "__END__"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "# ABSTRACT: Random numbers using timer/schedule entropy"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=pod"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=head1 NAME"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "Crypt::Random::TESHA2 - Random numbers using timer/schedule entropy"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "=head1 VERSION"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "Version 0.01"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=head1 WARNING"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "I<This module implements userspace voodoo entropy.  You should use a proper"
NSQ_SOURCE_LINE 00000205 "O/S supplied entropy source such as /dev/random or the Win32 Crypt API.>"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "  # Nothing exported by default"
NSQ_SOURCE_LINE 00000211 "  use Crypt::Random::TESHA2 qw(random_bytes random_values irand rand);"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "  # Get 64 random bytes"
NSQ_SOURCE_LINE 00000214 "  my $seed_string = random_bytes(64);"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "  # Get 16 random 32-bit values"
NSQ_SOURCE_LINE 00000217 "  my @seeds = random_values(16);"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "  # Get a 32-bit random integer (value between 0 and 4294967295 inclusive)"
NSQ_SOURCE_LINE 00000220 "  my $i = irand();"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "  # rand, like system rand, with 32 bits of randomness."
NSQ_SOURCE_LINE 00000223 "  my $r1 = rand();      # floating point in range [0,1)."
NSQ_SOURCE_LINE 00000224 "  my $r2 = rand(1000);  # floating point in range [0,1000)."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "  # croak if installation determined we couldn't generate enough entropy"
NSQ_SOURCE_LINE 00000228 "  use Crypt::Random::TESHA2 ':strong';"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "  # No warnings even if we are a weak source"
NSQ_SOURCE_LINE 00000231 "  use Crypt::Random::TESHA2 ':weak';"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "  # Ask for yourself"
NSQ_SOURCE_LINE 00000234 "  die \"No key for you!\" unless Crypt::Random::TESHA2::is_strong();"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "Generate random numbers using entropy gathered from timer / scheduler jitter."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "This can be used to generate non-pseudorandom data to seed a PRNG (e.g."
NSQ_SOURCE_LINE 00000242 "C<srand>/C<rand>, L<Math::Random::MT>, etc.) or CSPRNG (e.g. AES-CTR or"
NSQ_SOURCE_LINE 00000243 "L<Math::Random::ISAAC>).  You may use it directly or as part of a random"
NSQ_SOURCE_LINE 00000244 "source module that first checks for O/S randomness sources."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "Only Perl CORE modules are used, making this very portable.  However, systems"
NSQ_SOURCE_LINE 00000247 "must have a high resolution timer and support C<usleep> from L<Time::HiRes>."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "At installation time, measurements are taken of the estimated entropy gathered"
NSQ_SOURCE_LINE 00000250 "by the timer differences.  If the results indicated we could not get good"
NSQ_SOURCE_LINE 00000251 "results, then the module will consider itself \"weak\".  On the first use of"
NSQ_SOURCE_LINE 00000252 "any of the functions that return randomness (e.g. random_bytes), the module"
NSQ_SOURCE_LINE 00000253 "will carp about not being a strong randomness source.  However, two special"
NSQ_SOURCE_LINE 00000254 "options, \":strong\" and \":weak\" may be given to the importer to change this"
NSQ_SOURCE_LINE 00000255 "behavior.  If \":strong\" is used, then the module will croak.  If \":weak\" is"
NSQ_SOURCE_LINE 00000256 "used, then no carp will be generated.  The function C<is_strong> can be used"
NSQ_SOURCE_LINE 00000257 "at any time for finer control.  Note that this should be an unusual case, and"
NSQ_SOURCE_LINE 00000258 "neither flag has any effect if the module considers itself strong."
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=head2 random_bytes($n)"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "Takes an integer and returns a string of that size filled with random data."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head2 random_values($n)"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "Takes an integer and returns an array containing that many random 32-bit"
NSQ_SOURCE_LINE 00000270 "integers.  The values will be in the range [0,4294967295] (all 32-bit values"
NSQ_SOURCE_LINE 00000271 "are possible)."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=head2 irand"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Returns a single random 32-bit integer in the range [0,4294967295]."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=head2 rand"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "Returns a random float greater than or equal to 0 and less than the value of"
NSQ_SOURCE_LINE 00000280 "the argument.  If no argument is given or the argument is zero, 1 is used."
NSQ_SOURCE_LINE 00000281 "This has an identical API as system rand, though of course there is no"
NSQ_SOURCE_LINE 00000282 "associated srand function.  The result has 32 bits of randomness."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=head2 is_strong"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "Returns 0 if the installation procedure determined that not enough entropy"
NSQ_SOURCE_LINE 00000287 "could be gathered on this system.  Returns 1 if it was able.  If 0 is"
NSQ_SOURCE_LINE 00000288 "returned, then the bytes returned may be no better than a CSPRNG using a"
NSQ_SOURCE_LINE 00000289 "convoluted time-based reseed every bit."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=head1 METHOD"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "The underlying entropy gathering is done using timing differences between"
NSQ_SOURCE_LINE 00000295 "usleep calls.  We wrap usleep calls of varying intervals along with some"
NSQ_SOURCE_LINE 00000296 "Perl hash processing inside microsecond timer calls.  The two values are"
NSQ_SOURCE_LINE 00000297 "xored.  This is the raw entropy source.  Eight of these, along with the"
NSQ_SOURCE_LINE 00000298 "current time, are fed to a SHA-256 which can be added to an entropy pool."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "Measurements of the raw timer entropy (just the timing differences -- no"
NSQ_SOURCE_LINE 00000301 "hashes, time, counters, xors, or entropy pool) on systems I have available"
NSQ_SOURCE_LINE 00000302 "indicate 1.5 to 4 bits of entropy per usleep.  The installation procedure"
NSQ_SOURCE_LINE 00000303 "does a measurement of the 0-order entropy gathered from the raw timing"
NSQ_SOURCE_LINE 00000304 "process, halves it, limits to the range 1/8 - 7/8, and uses that as the"
NSQ_SOURCE_LINE 00000305 "estimated entropy gathered."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "The actual output random bytes are generated by an entropy pool that uses"
NSQ_SOURCE_LINE 00000308 "SHA-512 or SHA-256.  This adds data as needed from the above method, then"
NSQ_SOURCE_LINE 00000309 "extracts bits as needed to make the output bytes (again using a cryptographic"
NSQ_SOURCE_LINE 00000310 "hash and a counter, which means the entropy pool is not exposed)."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "The result will easily pass most stream randomness tests (e.g. FIPS-140, ENT,"
NSQ_SOURCE_LINE 00000313 "TestU01 Rabbit), but that is a given based on the last entropy pool stage, so"
NSQ_SOURCE_LINE 00000314 "this just shows we provide decorrelated output, not that we make a good seed."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "Note that pretty much every limitation of this module will apply to"
NSQ_SOURCE_LINE 00000320 "L<Math::TrulyRandom>, which many non-cryptographers still think is"
NSQ_SOURCE_LINE 00000321 "cryptographically secure (it's recommended in both the perl core documentation"
NSQ_SOURCE_LINE 00000322 "as well as L<Math::Random::ISAAC>).  If you think that module is great for"
NSQ_SOURCE_LINE 00000323 "your application, then you should be happy with this one.  Probably happier"
NSQ_SOURCE_LINE 00000324 "since this is more portable, doesn't hang infinitely, runs much faster,"
NSQ_SOURCE_LINE 00000325 "and generates better output on most systems."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "As mentioned in the L<Warnings|/\"WARNINGS\"> section, this generates userspace"
NSQ_SOURCE_LINE 00000328 "entropy -- what most people used until the waning years of the 20th century."
NSQ_SOURCE_LINE 00000329 "We should not have to do this on modern systems that have well designed APIs"
NSQ_SOURCE_LINE 00000330 "to get randomness from multiple entropy pools, all managed by production code."
NSQ_SOURCE_LINE 00000331 "In other words, C</dev/random>."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "Performance is slow (about 10,000 times slower than L<Math::Random::ISAAC::XS>),"
NSQ_SOURCE_LINE 00000334 "making this something best to be used to seed a PRNG or CSPRNG, rather than"
NSQ_SOURCE_LINE 00000335 "using directly.  On newer Linux systems and Win32 it runs about 10,000 bits"
NSQ_SOURCE_LINE 00000336 "per second.  Cygwin runs about 1000 bits per second.  Older systems will run"
NSQ_SOURCE_LINE 00000337 "slower of course, such as an old HPPA system I use that runs at 40 bits/s."
NSQ_SOURCE_LINE 00000338 "Much of the time is spent sleeping."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "Gathering entropy with this method depends on high resolution timers.  If the"
NSQ_SOURCE_LINE 00000341 "timers have low resolution, especially if we had a system with very fast"
NSQ_SOURCE_LINE 00000342 "yield turnaround, then we would gather very little entropy.  One of the tests"
NSQ_SOURCE_LINE 00000343 "tries to determine this, but it isn't perfect.  As with all such userspace"
NSQ_SOURCE_LINE 00000344 "systems, you should check that it works before using it for anything critical."
NSQ_SOURCE_LINE 00000345 "L<RFC4086|http://www.ietf.org/rfc/rfc4086.txt> section 3.4 discusses a few of"
NSQ_SOURCE_LINE 00000346 "the pitfalls of using portable clock-based software, and section 3.6 discusses"
NSQ_SOURCE_LINE 00000347 "the desire for multiple entropy sources."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "Because of the use of SHA-2 hashes along with an entropy pool using a counter,"
NSQ_SOURCE_LINE 00000350 "the output stream will pass randomness tests (e.g. FIPS-140, ENT,"
NSQ_SOURCE_LINE 00000351 "TestU01 Rabbit) even if there is I<no> underlying entropy.  The installation"
NSQ_SOURCE_LINE 00000352 "measurements should indicate whether this is happening, but it doesn't measure"
NSQ_SOURCE_LINE 00000353 "everything."
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "=head1 AUTHORS"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "Dana Jacobsen E<lt>dana@acm.orgE<gt>"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=over 4"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "=item Encyclopedia of Cryptography and Security, volume 2, \"Entropy Sources\"."
NSQ_SOURCE_LINE 00000366 "      The entropy pool implemented in this module follows this design."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "=item HAVEGE (L<http://www.issihosts.com/haveged/>)"
NSQ_SOURCE_LINE 00000369 "      Uses multiple methods to gather entropy and feed it to the O/S, which"
NSQ_SOURCE_LINE 00000370 "      can measure it and add it to a pool.  Highly recommended for embedded"
NSQ_SOURCE_LINE 00000371 "      or network devices that don't have good external interactions, or when"
NSQ_SOURCE_LINE 00000372 "      running programs that use a lot of entropy (e.g. anything that uses"
NSQ_SOURCE_LINE 00000373 "      L<Crypt::Random>)."
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=item timer_entropyd (L<http://www.vanheusden.com/te/>)"
NSQ_SOURCE_LINE 00000376 "      Uses a related method (jitter in timing data between usleeps) as this"
NSQ_SOURCE_LINE 00000377 "      module, but inefficient and only suitable for bulk feeding of an"
NSQ_SOURCE_LINE 00000378 "      entropy pool.  Even after von Neumann debiasing, the output has distinct"
NSQ_SOURCE_LINE 00000379 "      patterns and at most 0.5 bits of entropy per output bit.  HAVEGE is a"
NSQ_SOURCE_LINE 00000380 "      superior overall solution.  However, note a number of other links at"
NSQ_SOURCE_LINE 00000381 "      the site for other sources as well as links to hardware RNGs."
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "=item L<Math::TrulyRandom>"
NSQ_SOURCE_LINE 00000384 "      An old module that uses an obsolete version of Matt Blaze's TrueRand."
NSQ_SOURCE_LINE 00000385 "      TrueRand version 2.1 fixes a number of issues with the output quality"
NSQ_SOURCE_LINE 00000386 "      and specifically recommends against using the old method.  In addition,"
NSQ_SOURCE_LINE 00000387 "      the Perl module will not properly run on most current platforms."
NSQ_SOURCE_LINE 00000388 "      A pure Perl version is included in the examples directory of this"
NSQ_SOURCE_LINE 00000389 "      module, but it is still TrueRand version 1 and, like the old module,"
NSQ_SOURCE_LINE 00000390 "      will not run on Win32."
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "=item L<Crypt::Urandom>"
NSQ_SOURCE_LINE 00000393 "      A simple module that gets a good source of O/S non-blocking randomness."
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=item L<Crypt::Random::Source>"
NSQ_SOURCE_LINE 00000396 "      A complicated module that has multiple plugins for randomness sources."
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "=back"
NSQ_SOURCE_LINE 00000399 ""
