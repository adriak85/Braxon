NSQ_SOURCE_LINE 00000001 "# no code"
NSQ_SOURCE_LINE 00000002 "## no critic: TestingAndDebugging::RequireUseStrict"
NSQ_SOURCE_LINE 00000003 "package BorderStyle;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000006 "our $DATE = '2023-07-14'; # DATE"
NSQ_SOURCE_LINE 00000007 "our $DIST = 'BorderStyle'; # DIST"
NSQ_SOURCE_LINE 00000008 "our $VERSION = '3.0.3'; # VERSION"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "1;"
NSQ_SOURCE_LINE 00000011 "# ABSTRACT: Border styles"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "__END__"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "=pod"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "=head1 NAME"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "BorderStyle - Border styles"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "=head1 SPECIFICATION VERSION"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "3"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "=head1 VERSION"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "This document describes version 3.0.3 of BorderStyle (from Perl distribution BorderStyle), released on 2023-07-14."
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "This document specifies a way to create and use border styles"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "=head1 GLOSSARY"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=head2 border style class"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=head2 border style structure"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=head1 SPECIFICATION"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=head2 Border style class"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "Border style class must be put under C<BorderStyle::*>. Application-specific"
NSQ_SOURCE_LINE 00000046 "border styles should be put under C<BorderStyle::MODULE::NAME::*> or"
NSQ_SOURCE_LINE 00000047 "C<BorderStyle::APP::NAME::*>."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "Border style class must also provide these methods:"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=over"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=item * new"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "Usage:"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 " my $bs_obj = BorderStyle::NAME->new( [ %style_args ] );"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "Arguments will depend on the border style class; each border style class can"
NSQ_SOURCE_LINE 00000060 "define what arguments they want to accept."
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=item * get_struct"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "Usage:"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 " my $bs_struct = BorderStyle::NAME->get_struct;"
NSQ_SOURCE_LINE 00000067 " my $bs_struct = $bs_obj->get_struct;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "Provide a method way of getting the \"border style structure\". Must also work as"
NSQ_SOURCE_LINE 00000070 "a static method. A client can also access the %BORDER package variable directly."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=item * get_args"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "Usage:"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 " my $args = $bs_obj->get_args;"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "Provide a method way of getting the arguments to the constructor (the style"
NSQ_SOURCE_LINE 00000079 "arguments). The official implementation BorderStyleBase::Constructor stores this"
NSQ_SOURCE_LINE 00000080 "in the 'args' key of the hash object, but the proper way to access the arguments"
NSQ_SOURCE_LINE 00000081 "should be via this method."
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=item * get_border_char"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "Usage:"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 " my $str = $bs->get_border_char(%args);"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "Get border character. Arguments include:"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=over"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=item * char"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "String. Required. Character name (see below)."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=item * repeat"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "Uint. Optional, defaults to 1."
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=item * rownum"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "Uint, row number of the table cell, starts from 0."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=item * colnum"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "Uint, column number of the table cell, starts from 0."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=item * for_header_row"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "Bool. True if drawing a header row, or a separator line between header rows, or"
NSQ_SOURCE_LINE 00000112 "a separator between header row and data row."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=item * for_header_header_separator"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "Bool. True if drawing a separator line between header rows/columns."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=item * for_header_column"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "Bool. True if drawing a header column."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=item * for_header_data_separator"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "Bool. True if drawing a separator line between the last header row/column and"
NSQ_SOURCE_LINE 00000125 "the first data row/column."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=item * for_data_row"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "Bool. True if drawing a data row, or a separator line between data rows, or a"
NSQ_SOURCE_LINE 00000130 "separator between header row and data row."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=item * for_data_data_separator"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Bool. True if drawing a separator line between data rows/columns."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=item * for_data_column"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "Bool. True if drawing a data column."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=item * for_data_footer_separator"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "Bool. True if drawing a separator line between the last data row/column and the"
NSQ_SOURCE_LINE 00000143 "first footer row/column."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=item * for_footer_row"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "Bool. True if drawing a footer row, or separator between footer rows, or"
NSQ_SOURCE_LINE 00000148 "separator between data row and footer row."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=item * for_footer_column"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "Bool. True if drawing a footer column."
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "=item * for_footer_footer_separator"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "Bool. True if drawing a separator line between footer rows/columns."
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=back"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "B<Character names>. Names of known border characters are given below:"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "         rd_t  h_t   hd_t        ld_t"
NSQ_SOURCE_LINE 00000163 "         | ____|     |           |"
NSQ_SOURCE_LINE 00000164 "         vv          v           v"
NSQ_SOURCE_LINE 00000165 "         ┏━━━━━━━━━━━┳━━━━━┳━━━━━┓"
NSQ_SOURCE_LINE 00000166 "  v_l -->┃    v_i -->┃ hv_i┃     ┃<-- v_r"
NSQ_SOURCE_LINE 00000167 "         ┃           ┃    \\┃     ┃"
NSQ_SOURCE_LINE 00000168 "         ┃   rv_i -->┣━━━━━╋━━━━━┫<-- lv_r"
NSQ_SOURCE_LINE 00000169 "         ┃           ┃     ┃     ┃"
NSQ_SOURCE_LINE 00000170 "         ┃           ┣━━━━━┻━━━━━┫"
NSQ_SOURCE_LINE 00000171 "         ┃h_i  hd_i  ┃     ^     ┃"
NSQ_SOURCE_LINE 00000172 "         ┃|    |     ┃     |     ┃"
NSQ_SOURCE_LINE 00000173 "         ┃v    v     ┃     hu_i  ┃"
NSQ_SOURCE_LINE 00000174 " rv_l -->┣━━━━━┳━━━━━┫<-- lv_i   ┃"
NSQ_SOURCE_LINE 00000175 "         ┃     ┃     ┃           ┃"
NSQ_SOURCE_LINE 00000176 " ru_l -->┗━━━━━┻━━━━━┻━━━━━━━━━━━┛"
NSQ_SOURCE_LINE 00000177 "          ^    ^                 ^"
NSQ_SOURCE_LINE 00000178 "          |    |                 |"
NSQ_SOURCE_LINE 00000179 "          h_b  hu_b              lu_b"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 " no  border character name   description"
NSQ_SOURCE_LINE 00000182 " --  ---------------------   -----------"
NSQ_SOURCE_LINE 00000183 "  1  h_b                     horizontal for top border"
NSQ_SOURCE_LINE 00000184 "  2  h_i                     horizontal for top border"
NSQ_SOURCE_LINE 00000185 "  3  h_t                     horizontal line, for top border"
NSQ_SOURCE_LINE 00000186 "  4  hd_t                    horizontal down line, for top border"
NSQ_SOURCE_LINE 00000187 "  5  hd_i                    horizontal down line, for inside border"
NSQ_SOURCE_LINE 00000188 "  6  hu_b                    horizontal up line, for bottom border"
NSQ_SOURCE_LINE 00000189 "  7  hu_i                    horizontal up line, for inside border"
NSQ_SOURCE_LINE 00000190 "  8  hv_i                    horizontal vertical line, for inside border"
NSQ_SOURCE_LINE 00000191 "  9  ld_t                    left down line, for top border"
NSQ_SOURCE_LINE 00000192 " 10  lu_b                    left up line, for bottom border"
NSQ_SOURCE_LINE 00000193 " 11  lv_i                    left vertical, for inside border"
NSQ_SOURCE_LINE 00000194 " 12  lv_r                    left vertical, for right border"
NSQ_SOURCE_LINE 00000195 " 13  rd_t                    right down line, for top border"
NSQ_SOURCE_LINE 00000196 " 14  ru_b                    right up line, for bottom border"
NSQ_SOURCE_LINE 00000197 " 15  rv_i                    right vertical line, for inside border"
NSQ_SOURCE_LINE 00000198 " 16  rv_l                    right vertical line, for left border"
NSQ_SOURCE_LINE 00000199 " 17  v_i                     vertical line, for inside border"
NSQ_SOURCE_LINE 00000200 " 18  v_l                     vertical line, for left border"
NSQ_SOURCE_LINE 00000201 " 19  v_r                     vertical line, for right border"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "The arguments to C<get_border_char()> will also be passed to border character"
NSQ_SOURCE_LINE 00000204 "that is coderef, or to be interpreted by the class' C<get_border_char()> to vary"
NSQ_SOURCE_LINE 00000205 "the character."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=back"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head2 Border style structure"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "Border style structure is a L<DefHash> containing these keys:"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "=over"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=item * v"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "Float, from DefHash, must be set to 2 (this specification version)"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=item * name"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "From DefHash."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=item * summary"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "From DefHash."
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=item * utf8"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "Bool, must be set to true if the style uses non-ASCII UTF8 border character(s)."
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "Cannot be mixed with L</box_chars>."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=item * box_chars"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "Bool, must be set to true if the style uses box-drawing character. When using"
NSQ_SOURCE_LINE 00000236 "box-drawing character, the characters in L</chars> property must be specified"
NSQ_SOURCE_LINE 00000237 "using the VT100-style escape sequence without the prefix. For example, the"
NSQ_SOURCE_LINE 00000238 "top-left single border character must be specified as \"l\". For more details on"
NSQ_SOURCE_LINE 00000239 "box-drawing character, including the list of escape sequneces, see"
NSQ_SOURCE_LINE 00000240 "L<https://en.wikipedia.org/wiki/Box-drawing_character>."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "Box-drawing characters must not be mixed with other characters (ASCII or UTF8)."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=item * args"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "A hash of argument names and specifications (each specification a L<DefHash>) to"
NSQ_SOURCE_LINE 00000247 "specify which arguments a border style accept. This is similar to how"
NSQ_SOURCE_LINE 00000248 "L<Rinci::function> specifies function arguments. An argument specification can"
NSQ_SOURCE_LINE 00000249 "contain these properties: C<summary>, C<description>, C<schema>, C<req>,"
NSQ_SOURCE_LINE 00000250 "C<default>."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=back"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "Border style structure must be put in the C<%BORDER> package variable."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=head2 Border style character"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "A border style character can be a single-character string, or a coderef to allow"
NSQ_SOURCE_LINE 00000259 "border style that is context-sensitive."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "If border style character is a coderef, it must return a single-character string"
NSQ_SOURCE_LINE 00000262 "and not another coderef. The coderef will be called with the same arguments"
NSQ_SOURCE_LINE 00000263 "passed to L</get_border_char>."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "Please visit the project's homepage at L<https://metacpan.org/release/BorderStyle>."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Source repository is at L<https://github.com/perlancar/perl-BorderStyle>."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Somewhat related: L<ColorTheme> specification, because they are often used"
NSQ_SOURCE_LINE 00000276 "together in an application."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head1 HISTORY"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "=head2 v3"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "Incompatible change."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "Remove C<chars> in border style structure and abstract it through"
NSQ_SOURCE_LINE 00000285 "C<get_border_char()> to be more flexible, e.g. to allow for footer area,"
NSQ_SOURCE_LINE 00000286 "vertical header (header columns), and so on."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "Replace the positional arguments in C<get_border_char()> with named arguments to"
NSQ_SOURCE_LINE 00000289 "be more flexible. Replace the C<x> and C<y> arguments that refer to character"
NSQ_SOURCE_LINE 00000290 "with character C<name>, to be more readable."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=head2 v2"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "The first version of BorderStyle."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=head2 Border::Style"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "L<Border::Style> is an older specification, superseded by this document. The"
NSQ_SOURCE_LINE 00000299 "older specification defines border style as just the border style structure, not"
NSQ_SOURCE_LINE 00000300 "the class and thus lacks methods like C<get_struct()>, C<get_args()>, and"
NSQ_SOURCE_LINE 00000301 "C<get_border_char()>."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "perlancar <perlancar@cpan.org>"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=head1 CONTRIBUTING"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "To contribute, you can send patches by email/via RT, or send pull requests on"
NSQ_SOURCE_LINE 00000311 "GitHub."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "Most of the time, you don't need to build the distribution yourself. You can"
NSQ_SOURCE_LINE 00000314 "simply modify the code, then test via:"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 " % prove -l"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "If you want to build the distribution (e.g. to try to install it locally on your"
NSQ_SOURCE_LINE 00000319 "system), you can install L<Dist::Zilla>,"
NSQ_SOURCE_LINE 00000320 "L<Dist::Zilla::PluginBundle::Author::PERLANCAR>,"
NSQ_SOURCE_LINE 00000321 "L<Pod::Weaver::PluginBundle::Author::PERLANCAR>, and sometimes one or two other"
NSQ_SOURCE_LINE 00000322 "Dist::Zilla- and/or Pod::Weaver plugins. Any additional steps required beyond"
NSQ_SOURCE_LINE 00000323 "that are considered a bug and can be reported to me."
NSQ_SOURCE_LINE 00000324 ""
