NSQ_SOURCE_LINE 00000001 "package MySQL::Diff;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "=head1 NAME"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "MySQL::Diff - Generates a database upgrade instruction set"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "  use MySQL::Diff;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "  my $md = MySQL::Diff->new( %options );"
NSQ_SOURCE_LINE 00000012 "  my $db1 = $md->register_db($ARGV[0], 1);"
NSQ_SOURCE_LINE 00000013 "  my $db2 = $md->register_db($ARGV[1], 2);"
NSQ_SOURCE_LINE 00000014 "  my $diffs = $md->diff();"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "Generates the SQL instructions required to upgrade the first database to match"
NSQ_SOURCE_LINE 00000019 "the second."
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "=cut"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "use warnings;"
NSQ_SOURCE_LINE 00000024 "use strict;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "our $VERSION = '0.60';"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "# ------------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000029 "# Libraries"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "use MySQL::Diff::Database;"
NSQ_SOURCE_LINE 00000032 "use MySQL::Diff::Utils qw(debug debug_level debug_file);"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "use Data::Dumper;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "# ------------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "=head1 METHODS"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "=head2 Constructor"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=over 4"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=item new( %options )"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "Instantiate the objects, providing the command line options for database"
NSQ_SOURCE_LINE 00000047 "access and process requirements."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=back"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=cut"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "sub new {"
NSQ_SOURCE_LINE 00000054 "    my $class = shift;"
NSQ_SOURCE_LINE 00000055 "    my %hash  = @_;"
NSQ_SOURCE_LINE 00000056 "    my $self = {};"
NSQ_SOURCE_LINE 00000057 "    bless $self, ref $class || $class;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    $self->{opts} = \\%hash;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    if($hash{debug})        { debug_level($hash{debug})     ; delete $hash{debug};      }"
NSQ_SOURCE_LINE 00000062 "    if($hash{debug_file})   { debug_file($hash{debug_file}) ; delete $hash{debug_file}; }"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    debug(3,\"\\nconstructing new MySQL::Diff\");"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    return $self;"
NSQ_SOURCE_LINE 00000067 "}"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "=head2 Public Methods"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "Fuller documentation will appear here in time :)"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=over 4"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=item * register_db($name,$inx)"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "Reference the database, and setup a connection. The name can be an already"
NSQ_SOURCE_LINE 00000078 "existing 'MySQL::Diff::Database' database object. The index can be '1' or '2',"
NSQ_SOURCE_LINE 00000079 "and refers both to the order of the diff, and to the host, port, username and"
NSQ_SOURCE_LINE 00000080 "password arguments that have been supplied."
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=cut"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "sub register_db {"
NSQ_SOURCE_LINE 00000085 "    my ($self, $name, $inx) = @_;"
NSQ_SOURCE_LINE 00000086 "    return unless $inx == 1 || $inx == 2;"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "    my $db = ref $name eq 'MySQL::Diff::Database' ? $name : $self->_load_database($name,$inx);"
NSQ_SOURCE_LINE 00000089 "    $self->{databases}[$inx-1] = $db;"
NSQ_SOURCE_LINE 00000090 "    return $db;"
NSQ_SOURCE_LINE 00000091 "}"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=item * db1()"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=item * db2()"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "Return the first and second databases registered via C<register_db()>."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=cut"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "sub db1 { shift->{databases}->[0] }"
NSQ_SOURCE_LINE 00000102 "sub db2 { shift->{databases}->[1] }"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=item * diff()"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "Performs the diff, returning a string containing the commands needed to change"
NSQ_SOURCE_LINE 00000107 "the schema of the first database into that of the second."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=back"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=cut"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "sub diff {"
NSQ_SOURCE_LINE 00000114 "    my $self = shift;"
NSQ_SOURCE_LINE 00000115 "    my @changes;"
NSQ_SOURCE_LINE 00000116 "    my %used_tables = ();"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    debug(1, \"\\ncomparing databases\");"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "    for my $table1 ($self->db1->tables()) {"
NSQ_SOURCE_LINE 00000121 "        my $name = $table1->name();"
NSQ_SOURCE_LINE 00000122 "        $used_tables{'-- '. $name} = 1;"
NSQ_SOURCE_LINE 00000123 "        debug(4, \"table 1 $name = \".Dumper($table1));"
NSQ_SOURCE_LINE 00000124 "        debug(2,\"looking at tables called '$name'\");"
NSQ_SOURCE_LINE 00000125 "        if (my $table2 = $self->db2->table_by_name($name)) {"
NSQ_SOURCE_LINE 00000126 "            debug(3,\"comparing tables called '$name'\");"
NSQ_SOURCE_LINE 00000127 "            push @changes, $self->_diff_tables($table1, $table2);"
NSQ_SOURCE_LINE 00000128 "        } else {"
NSQ_SOURCE_LINE 00000129 "            debug(3,\"table '$name' dropped\");"
NSQ_SOURCE_LINE 00000130 "            push @changes, \"DROP TABLE $name;\\n\\n\""
NSQ_SOURCE_LINE 00000131 "                unless $self->{opts}{'only-both'} || $self->{opts}{'keep-old-tables'};"
NSQ_SOURCE_LINE 00000132 "        }"
NSQ_SOURCE_LINE 00000133 "    }"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "    for my $table2 ($self->db2->tables()) {"
NSQ_SOURCE_LINE 00000136 "        my $name = $table2->name();"
NSQ_SOURCE_LINE 00000137 "        $used_tables{'-- '. $name} = 1;"
NSQ_SOURCE_LINE 00000138 "        debug(4, \"table 2 $name = \".Dumper($table2));"
NSQ_SOURCE_LINE 00000139 "        if (! $self->db1->table_by_name($name)) {"
NSQ_SOURCE_LINE 00000140 "            debug(3,\"table '$name' added\");"
NSQ_SOURCE_LINE 00000141 "            debug(4,\"table '$name' added '\".$table2->def().\"'\");"
NSQ_SOURCE_LINE 00000142 "            push @changes, $table2->def() . \"\\n\""
NSQ_SOURCE_LINE 00000143 "                unless $self->{opts}{'only-both'};"
NSQ_SOURCE_LINE 00000144 "        }"
NSQ_SOURCE_LINE 00000145 "    }"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    debug(4,join '', @changes);"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    my $out = '';"
NSQ_SOURCE_LINE 00000150 "    if (@changes) {"
NSQ_SOURCE_LINE 00000151 "        if (!$self->{opts}{'list-tables'}) {"
NSQ_SOURCE_LINE 00000152 "            $out .= $self->_diff_banner();"
NSQ_SOURCE_LINE 00000153 "        }"
NSQ_SOURCE_LINE 00000154 "        else {"
NSQ_SOURCE_LINE 00000155 "            $out .= \"-- TABLES LIST \\n\";"
NSQ_SOURCE_LINE 00000156 "            $out .= join \"\\n\", keys %used_tables;"
NSQ_SOURCE_LINE 00000157 "            $out .= \"\\n-- END OF TABLES LIST \\n\";"
NSQ_SOURCE_LINE 00000158 "        }"
NSQ_SOURCE_LINE 00000159 "        $out .= join '', @changes;"
NSQ_SOURCE_LINE 00000160 "    }"
NSQ_SOURCE_LINE 00000161 "    return $out;"
NSQ_SOURCE_LINE 00000162 "}"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "# ------------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000165 "# Private Methods"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "sub _diff_banner {"
NSQ_SOURCE_LINE 00000168 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    my $summary1 = $self->db1->summary();"
NSQ_SOURCE_LINE 00000171 "    my $summary2 = $self->db2->summary();"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    my $opt_text ="
NSQ_SOURCE_LINE 00000174 "        join ', ',"
NSQ_SOURCE_LINE 00000175 "            map { $self->{opts}{$_} eq '1' ? $_ : \"$_=$self->{opts}{$_}\" }"
NSQ_SOURCE_LINE 00000176 "                keys %{$self->{opts}};"
NSQ_SOURCE_LINE 00000177 "    $opt_text = \"## Options: $opt_text\\n\" if $opt_text;"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    my $now = scalar localtime();"
NSQ_SOURCE_LINE 00000180 "    return <<EOF;"
NSQ_SOURCE_LINE 00000181 "## mysqldiff $VERSION"
NSQ_SOURCE_LINE 00000182 "## "
NSQ_SOURCE_LINE 00000183 "## Run on $now"
NSQ_SOURCE_LINE 00000184 "$opt_text##"
NSQ_SOURCE_LINE 00000185 "## --- $summary1"
NSQ_SOURCE_LINE 00000186 "## +++ $summary2"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "EOF"
NSQ_SOURCE_LINE 00000189 "}"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "sub _diff_tables {"
NSQ_SOURCE_LINE 00000192 "    my $self = shift;"
NSQ_SOURCE_LINE 00000193 "    my @changes = ( "
NSQ_SOURCE_LINE 00000194 "        $self->_diff_fields(@_),"
NSQ_SOURCE_LINE 00000195 "        $self->_diff_indices(@_),"
NSQ_SOURCE_LINE 00000196 "        $self->_diff_primary_key(@_),"
NSQ_SOURCE_LINE 00000197 "        $self->_diff_foreign_key(@_),"
NSQ_SOURCE_LINE 00000198 "        $self->_diff_options(@_)        "
NSQ_SOURCE_LINE 00000199 "    );"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "    $changes[-1] =~ s/\\n*$/\\n/  if (@changes);"
NSQ_SOURCE_LINE 00000202 "    return @changes;"
NSQ_SOURCE_LINE 00000203 "}"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "sub _diff_fields {"
NSQ_SOURCE_LINE 00000206 "    my ($self, $table1, $table2) = @_;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    my $name1 = $table1->name();"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    my $fields1 = $table1->fields;"
NSQ_SOURCE_LINE 00000211 "    my $fields2 = $table2->fields;"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "    return () unless $fields1 || $fields2;"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "    my @changes;"
NSQ_SOURCE_LINE 00000216 "  "
NSQ_SOURCE_LINE 00000217 "    if($fields1) {"
NSQ_SOURCE_LINE 00000218 "        for my $field (keys %$fields1) {"
NSQ_SOURCE_LINE 00000219 "            debug(3,\"table1 had field '$field'\");"
NSQ_SOURCE_LINE 00000220 "            my $f1 = $fields1->{$field};"
NSQ_SOURCE_LINE 00000221 "            my $f2 = $fields2->{$field};"
NSQ_SOURCE_LINE 00000222 "            if ($fields2 && $f2) {"
NSQ_SOURCE_LINE 00000223 "                if ($self->{opts}{tolerant}) {"
NSQ_SOURCE_LINE 00000224 "                    for ($f1, $f2) {"
NSQ_SOURCE_LINE 00000225 "                        s/ COLLATE [\\w_]+//gi;"
NSQ_SOURCE_LINE 00000226 "                    }"
NSQ_SOURCE_LINE 00000227 "                }"
NSQ_SOURCE_LINE 00000228 "                if ($f1 ne $f2) {"
NSQ_SOURCE_LINE 00000229 "                    if (not $self->{opts}{tolerant} or "
NSQ_SOURCE_LINE 00000230 "                        (($f1 !~ m/$f2\\(\\d+,\\d+\\)/) and"
NSQ_SOURCE_LINE 00000231 "                         ($f1 ne \"$f2 DEFAULT '' NOT NULL\") and"
NSQ_SOURCE_LINE 00000232 "                         ($f1 ne \"$f2 NOT NULL\") ))"
NSQ_SOURCE_LINE 00000233 "                    {"
NSQ_SOURCE_LINE 00000234 "                        debug(3,\"field '$field' changed\");"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "                        my $change = \"ALTER TABLE $name1 CHANGE COLUMN $field $field $f2;\";"
NSQ_SOURCE_LINE 00000237 "                        $change .= \" # was $f1\" unless $self->{opts}{'no-old-defs'};"
NSQ_SOURCE_LINE 00000238 "                        $change .= \"\\n\";"
NSQ_SOURCE_LINE 00000239 "                        push @changes, $change;"
NSQ_SOURCE_LINE 00000240 "                    }"
NSQ_SOURCE_LINE 00000241 "                }"
NSQ_SOURCE_LINE 00000242 "            } elsif (!$self->{opts}{'keep-old-columns'}) {"
NSQ_SOURCE_LINE 00000243 "                debug(3,\"field '$field' removed\");"
NSQ_SOURCE_LINE 00000244 "                my $change = \"ALTER TABLE $name1 DROP COLUMN $field;\";"
NSQ_SOURCE_LINE 00000245 "                $change .= \" # was $fields1->{$field}\" unless $self->{opts}{'no-old-defs'};"
NSQ_SOURCE_LINE 00000246 "                $change .= \"\\n\";"
NSQ_SOURCE_LINE 00000247 "                push @changes, $change;"
NSQ_SOURCE_LINE 00000248 "            }"
NSQ_SOURCE_LINE 00000249 "        }"
NSQ_SOURCE_LINE 00000250 "    }"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    if($fields2) {"
NSQ_SOURCE_LINE 00000253 "        for my $field (keys %$fields2) {"
NSQ_SOURCE_LINE 00000254 "            unless($fields1 && $fields1->{$field}) {"
NSQ_SOURCE_LINE 00000255 "                debug(3,\"field '$field' added\");"
NSQ_SOURCE_LINE 00000256 "                my $changes = \"ALTER TABLE $name1 ADD COLUMN $field $fields2->{$field}\";"
NSQ_SOURCE_LINE 00000257 "                if ($table2->is_auto_inc($field)) {"
NSQ_SOURCE_LINE 00000258 "                    if ($table2->isa_primary($field)) {"
NSQ_SOURCE_LINE 00000259 "                        $changes .= ' PRIMARY KEY';"
NSQ_SOURCE_LINE 00000260 "                    } elsif ($table2->is_unique($field)) {"
NSQ_SOURCE_LINE 00000261 "                        $changes .= ' UNIQUE KEY';"
NSQ_SOURCE_LINE 00000262 "                    }"
NSQ_SOURCE_LINE 00000263 "                }"
NSQ_SOURCE_LINE 00000264 "                push @changes, \"$changes;\\n\";"
NSQ_SOURCE_LINE 00000265 "            }"
NSQ_SOURCE_LINE 00000266 "        }"
NSQ_SOURCE_LINE 00000267 "    }"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "    return @changes;"
NSQ_SOURCE_LINE 00000270 "}"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "sub _diff_indices {"
NSQ_SOURCE_LINE 00000273 "    my ($self, $table1, $table2) = @_;"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "    my $name1 = $table1->name();"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "    my $indices1 = $table1->indices();"
NSQ_SOURCE_LINE 00000278 "    my $indices2 = $table2->indices();"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "    return () unless $indices1 || $indices2;"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "    my @changes;"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    if($indices1) {"
NSQ_SOURCE_LINE 00000285 "        for my $index (keys %$indices1) {"
NSQ_SOURCE_LINE 00000286 "            debug(3,\"table1 had index '$index'\");"
NSQ_SOURCE_LINE 00000287 "            my $old_type = $table1->is_unique($index) ? 'UNIQUE' : "
NSQ_SOURCE_LINE 00000288 "                           $table1->is_fulltext($index) ? 'FULLTEXT INDEX' : 'INDEX';"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "            if ($indices2 && $indices2->{$index}) {"
NSQ_SOURCE_LINE 00000291 "                if( ($indices1->{$index} ne $indices2->{$index}) or"
NSQ_SOURCE_LINE 00000292 "                    ($table1->is_unique($index) xor $table2->is_unique($index)) or"
NSQ_SOURCE_LINE 00000293 "                    ($table1->is_fulltext($index) xor $table2->is_fulltext($index)) )"
NSQ_SOURCE_LINE 00000294 "                {"
NSQ_SOURCE_LINE 00000295 "                    debug(3,\"index '$index' changed\");"
NSQ_SOURCE_LINE 00000296 "                    my $new_type = $table2->is_unique($index) ? 'UNIQUE' : "
NSQ_SOURCE_LINE 00000297 "                                   $table2->is_fulltext($index) ? 'FULLTEXT INDEX' : 'INDEX';"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "                    my $changes = \"ALTER TABLE $name1 DROP INDEX $index;\";"
NSQ_SOURCE_LINE 00000300 "                    $changes .= \" # was $old_type ($indices1->{$index})\""
NSQ_SOURCE_LINE 00000301 "                        unless $self->{opts}{'no-old-defs'};"
NSQ_SOURCE_LINE 00000302 "                    $changes .= \"\\nALTER TABLE $name1 ADD $new_type $index ($indices2->{$index});\\n\";"
NSQ_SOURCE_LINE 00000303 "                    push @changes, $changes;"
NSQ_SOURCE_LINE 00000304 "                }"
NSQ_SOURCE_LINE 00000305 "            } else {"
NSQ_SOURCE_LINE 00000306 "                debug(3,\"index '$index' removed\");"
NSQ_SOURCE_LINE 00000307 "                my $auto = _check_for_auto_col($table2, $indices1->{$index}, 1) || '';"
NSQ_SOURCE_LINE 00000308 "                my $changes = $auto ? _index_auto_col($table1, $indices1->{$index}) : '';"
NSQ_SOURCE_LINE 00000309 "                $changes .= \"ALTER TABLE $name1 DROP INDEX $index;\";"
NSQ_SOURCE_LINE 00000310 "                $changes .= \" # was $old_type ($indices1->{$index})\""
NSQ_SOURCE_LINE 00000311 "                    unless $self->{opts}{'no-old-defs'};"
NSQ_SOURCE_LINE 00000312 "                $changes .= \"\\n\";"
NSQ_SOURCE_LINE 00000313 "                push @changes, $changes;"
NSQ_SOURCE_LINE 00000314 "            }"
NSQ_SOURCE_LINE 00000315 "        }"
NSQ_SOURCE_LINE 00000316 "    }"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "    if($indices2) {"
NSQ_SOURCE_LINE 00000319 "        for my $index (keys %$indices2) {"
NSQ_SOURCE_LINE 00000320 "            next if($indices1 && $indices1->{$index});"
NSQ_SOURCE_LINE 00000321 "            next if("
NSQ_SOURCE_LINE 00000322 "                !$table2->isa_primary($index) &&"
NSQ_SOURCE_LINE 00000323 "                $table2->is_unique($index) &&"
NSQ_SOURCE_LINE 00000324 "                _key_covers_auto_col($table2, $index)"
NSQ_SOURCE_LINE 00000325 "            );"
NSQ_SOURCE_LINE 00000326 "            debug(3,\"index '$index' added\");"
NSQ_SOURCE_LINE 00000327 "            my $new_type = $table2->is_unique($index) ? 'UNIQUE' : 'INDEX';"
NSQ_SOURCE_LINE 00000328 "            push @changes, \"ALTER TABLE $name1 ADD $new_type $index ($indices2->{$index});\\n\";"
NSQ_SOURCE_LINE 00000329 "        }"
NSQ_SOURCE_LINE 00000330 "    }"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "    return @changes;"
NSQ_SOURCE_LINE 00000333 "}"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "sub _diff_primary_key {"
NSQ_SOURCE_LINE 00000336 "    my ($self, $table1, $table2) = @_;"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "    my $name1 = $table1->name();"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "    my $primary1 = $table1->primary_key();"
NSQ_SOURCE_LINE 00000341 "    my $primary2 = $table2->primary_key();"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "    return () unless $primary1 || $primary2;"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "    my @changes;"
NSQ_SOURCE_LINE 00000346 "  "
NSQ_SOURCE_LINE 00000347 "    if ($primary1 && ! $primary2) {"
NSQ_SOURCE_LINE 00000348 "        debug(3,\"primary key '$primary1' dropped\");"
NSQ_SOURCE_LINE 00000349 "        my $changes = _index_auto_col($table2, $primary1);"
NSQ_SOURCE_LINE 00000350 "        $changes .= \"ALTER TABLE $name1 DROP PRIMARY KEY;\";"
NSQ_SOURCE_LINE 00000351 "        $changes .= \" # was $primary1\" unless $self->{opts}{'no-old-defs'};"
NSQ_SOURCE_LINE 00000352 "        return ( \"$changes\\n\" );"
NSQ_SOURCE_LINE 00000353 "    }"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "    if (! $primary1 && $primary2) {"
NSQ_SOURCE_LINE 00000356 "        debug(3,\"primary key '$primary2' added\");"
NSQ_SOURCE_LINE 00000357 "        return () if _key_covers_auto_col($table2, $primary2);"
NSQ_SOURCE_LINE 00000358 "        return (\"ALTER TABLE $name1 ADD PRIMARY KEY $primary2;\\n\");"
NSQ_SOURCE_LINE 00000359 "    }"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "    if ($primary1 ne $primary2) {"
NSQ_SOURCE_LINE 00000362 "        debug(3,\"primary key changed\");"
NSQ_SOURCE_LINE 00000363 "        my $auto = _check_for_auto_col($table2, $primary1) || '';"
NSQ_SOURCE_LINE 00000364 "        my $changes = $auto ? _index_auto_col($table2, $auto) : '';"
NSQ_SOURCE_LINE 00000365 "        $changes .= \"ALTER TABLE $name1 DROP PRIMARY KEY;\";"
NSQ_SOURCE_LINE 00000366 "        $changes .= \" # was $primary1\" unless $self->{opts}{'no-old-defs'};"
NSQ_SOURCE_LINE 00000367 "        $changes .= \"\\nALTER TABLE $name1 ADD PRIMARY KEY $primary2;\\n\";"
NSQ_SOURCE_LINE 00000368 "        $changes .= \"ALTER TABLE $name1 DROP INDEX $auto;\\n\"    if($auto);"
NSQ_SOURCE_LINE 00000369 "        push @changes, $changes;"
NSQ_SOURCE_LINE 00000370 "    }"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "    return @changes;"
NSQ_SOURCE_LINE 00000373 "}"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "sub _diff_foreign_key {"
NSQ_SOURCE_LINE 00000376 "    my ($self, $table1, $table2) = @_;"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "    my $name1 = $table1->name();"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    my $fks1 = $table1->foreign_key();"
NSQ_SOURCE_LINE 00000381 "    my $fks2 = $table2->foreign_key();"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "    return () unless $fks1 || $fks2;"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "    my @changes;"
NSQ_SOURCE_LINE 00000386 "  "
NSQ_SOURCE_LINE 00000387 "    if($fks1) {"
NSQ_SOURCE_LINE 00000388 "        for my $fk (keys %$fks1) {"
NSQ_SOURCE_LINE 00000389 "            debug(1,\"$name1 has fk '$fk'\");"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "            if ($fks2 && $fks2->{$fk}) {"
NSQ_SOURCE_LINE 00000392 "                if($fks1->{$fk} ne $fks2->{$fk}) "
NSQ_SOURCE_LINE 00000393 "                {"
NSQ_SOURCE_LINE 00000394 "                    debug(1,\"foreign key '$fk' changed\");"
NSQ_SOURCE_LINE 00000395 "                    my $changes = \"ALTER TABLE $name1 DROP FOREIGN KEY $fk;\";"
NSQ_SOURCE_LINE 00000396 "                    $changes .= \" # was CONSTRAINT $fk $fks1->{$fk}\""
NSQ_SOURCE_LINE 00000397 "                        unless $self->{opts}{'no-old-defs'};"
NSQ_SOURCE_LINE 00000398 "                    $changes .= \"\\nALTER TABLE $name1 ADD CONSTRAINT $fk FOREIGN KEY $fks2->{$fk};\\n\";"
NSQ_SOURCE_LINE 00000399 "                    push @changes, $changes;"
NSQ_SOURCE_LINE 00000400 "                }"
NSQ_SOURCE_LINE 00000401 "            } else {"
NSQ_SOURCE_LINE 00000402 "                debug(1,\"foreign key '$fk' removed\");"
NSQ_SOURCE_LINE 00000403 "                my $changes .= \"ALTER TABLE $name1 DROP FOREIGN KEY $fk;\";"
NSQ_SOURCE_LINE 00000404 "                $changes .= \" # was CONSTRAINT $fk $fks1->{$fk}\""
NSQ_SOURCE_LINE 00000405 "                        unless $self->{opts}{'no-old-defs'};"
NSQ_SOURCE_LINE 00000406 "                $changes .= \"\\n\";"
NSQ_SOURCE_LINE 00000407 "                push @changes, $changes;"
NSQ_SOURCE_LINE 00000408 "            }"
NSQ_SOURCE_LINE 00000409 "        }"
NSQ_SOURCE_LINE 00000410 "    }"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "    if($fks2) {"
NSQ_SOURCE_LINE 00000413 "        for my $fk (keys %$fks2) {"
NSQ_SOURCE_LINE 00000414 "            next    if($fks1 && $fks1->{$fk});"
NSQ_SOURCE_LINE 00000415 "            debug(1, \"foreign key '$fk' added\");"
NSQ_SOURCE_LINE 00000416 "            push @changes, \"ALTER TABLE $name1 ADD CONSTRAINT $fk FOREIGN KEY $fks2->{$fk};\\n\";"
NSQ_SOURCE_LINE 00000417 "        }"
NSQ_SOURCE_LINE 00000418 "    }"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "    return @changes;"
NSQ_SOURCE_LINE 00000421 "}"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "# If we're about to drop a composite (multi-column) index, we need to"
NSQ_SOURCE_LINE 00000424 "# check whether any of the columns in the composite index are"
NSQ_SOURCE_LINE 00000425 "# auto_increment; if so, we have to add an index for that"
NSQ_SOURCE_LINE 00000426 "# auto_increment column *before* dropping the composite index, since"
NSQ_SOURCE_LINE 00000427 "# auto_increment columns must always be indexed."
NSQ_SOURCE_LINE 00000428 "sub _check_for_auto_col {"
NSQ_SOURCE_LINE 00000429 "    my ($table, $fields, $primary) = @_;"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "    my @fields = _fields_from_key($fields);"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "    for my $field (@fields) {"
NSQ_SOURCE_LINE 00000434 "        next if($table->field($field) !~ /auto_increment/i);"
NSQ_SOURCE_LINE 00000435 "        next if($table->isa_index($field));"
NSQ_SOURCE_LINE 00000436 "        next if($primary && $table->isa_primary($field));"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "        return $field;"
NSQ_SOURCE_LINE 00000439 "    }"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "    return;"
NSQ_SOURCE_LINE 00000442 "}"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "sub _fields_from_key {"
NSQ_SOURCE_LINE 00000445 "    my $key = shift;"
NSQ_SOURCE_LINE 00000446 "    $key =~ s/^\\s*\\((.*)\\)\\s*$/$1/g; # strip brackets if any"
NSQ_SOURCE_LINE 00000447 "    split /\\s*,\\s*/, $key;"
NSQ_SOURCE_LINE 00000448 "}"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "sub _key_covers_auto_col {"
NSQ_SOURCE_LINE 00000451 "    my ($table, $key) = @_;"
NSQ_SOURCE_LINE 00000452 "    my @fields = _fields_from_key($key);"
NSQ_SOURCE_LINE 00000453 "    for my $field (@fields) {"
NSQ_SOURCE_LINE 00000454 "        return 1 if $table->is_auto_inc($field);"
NSQ_SOURCE_LINE 00000455 "    }"
NSQ_SOURCE_LINE 00000456 "    return;"
NSQ_SOURCE_LINE 00000457 "}"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "sub _index_auto_col {"
NSQ_SOURCE_LINE 00000460 "    my ($table, $field) = @_;"
NSQ_SOURCE_LINE 00000461 "    my $name = $table->name;"
NSQ_SOURCE_LINE 00000462 "    return \"ALTER TABLE $name ADD INDEX ($field); # auto columns must always be indexed\\n\";"
NSQ_SOURCE_LINE 00000463 "}"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "sub _diff_options {"
NSQ_SOURCE_LINE 00000466 "    my ($self, $table1, $table2) = @_;"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "    my $name     = $table1->name();"
NSQ_SOURCE_LINE 00000469 "    my $options1 = $table1->options();"
NSQ_SOURCE_LINE 00000470 "    my $options2 = $table2->options();"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "    return () unless $options1 || $options2;"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "    my @changes;"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "    if ($self->{opts}{tolerant}) {"
NSQ_SOURCE_LINE 00000477 "      for ($options1, $options2) {"
NSQ_SOURCE_LINE 00000478 "        s/ AUTO_INCREMENT=\\d+//gi;"
NSQ_SOURCE_LINE 00000479 "        s/ COLLATE=[\\w_]+//gi;"
NSQ_SOURCE_LINE 00000480 "      }"
NSQ_SOURCE_LINE 00000481 "    }"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "    if ($options1 ne $options2) {"
NSQ_SOURCE_LINE 00000484 "        my $change = \"ALTER TABLE $name $options2;\";"
NSQ_SOURCE_LINE 00000485 "        $change .= \" # was \" . ($options1 || 'blank') unless $self->{opts}{'no-old-defs'};"
NSQ_SOURCE_LINE 00000486 "        $change .= \"\\n\";"
NSQ_SOURCE_LINE 00000487 "        push @changes, $change;"
NSQ_SOURCE_LINE 00000488 "    }"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "    return @changes;"
NSQ_SOURCE_LINE 00000491 "}"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "sub _load_database {"
NSQ_SOURCE_LINE 00000494 "    my ($self, $arg, $authnum) = @_;"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "    debug(2, \"parsing arg $authnum: '$arg'\\n\");"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "    my %auth;"
NSQ_SOURCE_LINE 00000499 "    for my $auth (qw/dbh host port user password socket/) {"
NSQ_SOURCE_LINE 00000500 "        $auth{$auth} = $self->{opts}{\"$auth$authnum\"} || $self->{opts}{$auth};"
NSQ_SOURCE_LINE 00000501 "        delete $auth{$auth} unless $auth{$auth};"
NSQ_SOURCE_LINE 00000502 "    }"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "    if ($arg =~ /^db:(.*)/) {"
NSQ_SOURCE_LINE 00000505 "        return MySQL::Diff::Database->new(db => $1, auth => \\%auth, 'single-transaction' => $self->{opts}{'single-transaction'}, 'table-re' => $self->{opts}{'table-re'});"
NSQ_SOURCE_LINE 00000506 "    }"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "    if ($self->{opts}{\"dbh\"}              ||"
NSQ_SOURCE_LINE 00000509 "        $self->{opts}{\"host$authnum\"}     ||"
NSQ_SOURCE_LINE 00000510 "        $self->{opts}{\"port$authnum\"}     ||"
NSQ_SOURCE_LINE 00000511 "        $self->{opts}{\"user$authnum\"}     ||"
NSQ_SOURCE_LINE 00000512 "        $self->{opts}{\"password$authnum\"} ||"
NSQ_SOURCE_LINE 00000513 "        $self->{opts}{\"socket$authnum\"}) {"
NSQ_SOURCE_LINE 00000514 "        return MySQL::Diff::Database->new(db => $arg, auth => \\%auth, 'single-transaction' => $self->{opts}{'single-transaction'}, 'table-re' => $self->{opts}{'table-re'});"
NSQ_SOURCE_LINE 00000515 "    }"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "    if (-f $arg) {"
NSQ_SOURCE_LINE 00000518 "        return MySQL::Diff::Database->new(file => $arg, auth => \\%auth, 'single-transaction' => $self->{opts}{'single-transaction'}, 'table-re' => $self->{opts}{'table-re'});"
NSQ_SOURCE_LINE 00000519 "    }"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "    my %dbs = MySQL::Diff::Database::available_dbs(%auth);"
NSQ_SOURCE_LINE 00000522 "    debug(2, \"  available databases: \", (join ', ', keys %dbs), \"\\n\");"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "    if ($dbs{$arg}) {"
NSQ_SOURCE_LINE 00000525 "        return MySQL::Diff::Database->new(db => $arg, auth => \\%auth, 'single-transaction' => $self->{opts}{'single-transaction'}, 'table-re' => $self->{opts}{'table-re'});"
NSQ_SOURCE_LINE 00000526 "    }"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "    warn \"'$arg' is not a valid file or database.\\n\";"
NSQ_SOURCE_LINE 00000529 "    return;"
NSQ_SOURCE_LINE 00000530 "}"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "sub _debug_level {"
NSQ_SOURCE_LINE 00000533 "    my ($self,$level) = @_;"
NSQ_SOURCE_LINE 00000534 "    debug_level($level);"
NSQ_SOURCE_LINE 00000535 "}"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "1;"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "__END__"
