BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "# $Id$"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "package XML::SAX;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use vars qw($VERSION @ISA @EXPORT_OK);"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "$VERSION = '1.02';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter ();"
NSQ_SOURCE_LINE 00000011 "@ISA = ('Exporter');"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "@EXPORT_OK = qw(Namespaces Validation);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use File::Basename qw(dirname);"
NSQ_SOURCE_LINE 00000016 "use File::Spec ();"
NSQ_SOURCE_LINE 00000017 "use Symbol qw(gensym);"
NSQ_SOURCE_LINE 00000018 "use XML::SAX::ParserFactory (); # loaded for simplicity"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "use constant PARSER_DETAILS => \"ParserDetails.ini\";"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "use constant Namespaces => \"http://xml.org/sax/features/namespaces\";"
NSQ_SOURCE_LINE 00000023 "use constant Validation => \"http://xml.org/sax/features/validation\";"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "my $known_parsers = undef;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "# load_parsers takes the ParserDetails.ini file out of the same directory"
NSQ_SOURCE_LINE 00000028 "# that XML::SAX is in, and looks at it. Format in POD below"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "=begin EXAMPLE"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "[XML::SAX::PurePerl]"
NSQ_SOURCE_LINE 00000033 "http://xml.org/sax/features/namespaces = 1"
NSQ_SOURCE_LINE 00000034 "http://xml.org/sax/features/validation = 0"
NSQ_SOURCE_LINE 00000035 "# a comment"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "# blank lines ignored"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "[XML::SAX::AnotherParser]"
NSQ_SOURCE_LINE 00000040 "http://xml.org/sax/features/namespaces = 0"
NSQ_SOURCE_LINE 00000041 "http://xml.org/sax/features/validation = 1"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=end EXAMPLE"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=cut"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "sub load_parsers {"
NSQ_SOURCE_LINE 00000048 "    my $class = shift;"
NSQ_SOURCE_LINE 00000049 "    my $dir = shift;"
NSQ_SOURCE_LINE 00000050 "    "
NSQ_SOURCE_LINE 00000051 "    # reset parsers"
NSQ_SOURCE_LINE 00000052 "    $known_parsers = [];"
NSQ_SOURCE_LINE 00000053 "    "
NSQ_SOURCE_LINE 00000054 "    # get directory from wherever XML::SAX is installed"
NSQ_SOURCE_LINE 00000055 "    if (!$dir) {"
NSQ_SOURCE_LINE 00000056 "        $dir = $INC{'XML/SAX.pm'};"
NSQ_SOURCE_LINE 00000057 "        $dir = dirname($dir);"
NSQ_SOURCE_LINE 00000058 "    }"
NSQ_SOURCE_LINE 00000059 "    "
NSQ_SOURCE_LINE 00000060 "    my $fh = gensym();"
NSQ_SOURCE_LINE 00000061 "    if (!open($fh, File::Spec->catfile($dir, \"SAX\", PARSER_DETAILS))) {"
NSQ_SOURCE_LINE 00000062 "        XML::SAX->do_warn(\"could not find \" . PARSER_DETAILS . \" in $dir/SAX\\n\");"
NSQ_SOURCE_LINE 00000063 "        return $class;"
NSQ_SOURCE_LINE 00000064 "    }"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    $known_parsers = $class->_parse_ini_file($fh);"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    return $class;"
NSQ_SOURCE_LINE 00000069 "}"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "sub _parse_ini_file {"
NSQ_SOURCE_LINE 00000072 "    my $class = shift;"
NSQ_SOURCE_LINE 00000073 "    my ($fh) = @_;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    my @config;"
NSQ_SOURCE_LINE 00000076 "    "
NSQ_SOURCE_LINE 00000077 "    my $lineno = 0;"
NSQ_SOURCE_LINE 00000078 "    while (defined(my $line = <$fh>)) {"
NSQ_SOURCE_LINE 00000079 "        $lineno++;"
NSQ_SOURCE_LINE 00000080 "        my $original = $line;"
NSQ_SOURCE_LINE 00000081 "        # strip whitespace"
NSQ_SOURCE_LINE 00000082 "        $line =~ s/\\s*$//m;"
NSQ_SOURCE_LINE 00000083 "        $line =~ s/^\\s*//m;"
NSQ_SOURCE_LINE 00000084 "        # strip comments"
NSQ_SOURCE_LINE 00000085 "        $line =~ s/[#;].*$//m;"
NSQ_SOURCE_LINE 00000086 "        # ignore blanks"
NSQ_SOURCE_LINE 00000087 "        next if $line =~ /^$/m;"
NSQ_SOURCE_LINE 00000088 "        "
NSQ_SOURCE_LINE 00000089 "        # heading"
NSQ_SOURCE_LINE 00000090 "        if ($line =~ /^\\[\\s*(.*)\\s*\\]$/m) {"
NSQ_SOURCE_LINE 00000091 "            push @config, { Name => $1 };"
NSQ_SOURCE_LINE 00000092 "            next;"
NSQ_SOURCE_LINE 00000093 "        }"
NSQ_SOURCE_LINE 00000094 "        "
NSQ_SOURCE_LINE 00000095 "        # instruction"
NSQ_SOURCE_LINE 00000096 "        elsif ($line =~ /^(.*?)\\s*?=\\s*(.*)$/) {"
NSQ_SOURCE_LINE 00000097 "            unless(@config) {"
NSQ_SOURCE_LINE 00000098 "                push @config, { Name => '' };"
NSQ_SOURCE_LINE 00000099 "            }"
NSQ_SOURCE_LINE 00000100 "            $config[-1]{Features}{$1} = $2;"
NSQ_SOURCE_LINE 00000101 "        }"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "        # not whitespace, comment, or instruction"
NSQ_SOURCE_LINE 00000104 "        else {"
NSQ_SOURCE_LINE 00000105 "            die \"Invalid line in ini: $lineno\\n>>> $original\\n\";"
NSQ_SOURCE_LINE 00000106 "        }"
NSQ_SOURCE_LINE 00000107 "    }"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    return \\@config;"
NSQ_SOURCE_LINE 00000110 "}"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "sub parsers {"
NSQ_SOURCE_LINE 00000113 "    my $class = shift;"
NSQ_SOURCE_LINE 00000114 "    if (!$known_parsers) {"
NSQ_SOURCE_LINE 00000115 "        $class->load_parsers();"
NSQ_SOURCE_LINE 00000116 "    }"
NSQ_SOURCE_LINE 00000117 "    return $known_parsers;"
NSQ_SOURCE_LINE 00000118 "}"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "sub remove_parser {"
NSQ_SOURCE_LINE 00000121 "    my $class = shift;"
NSQ_SOURCE_LINE 00000122 "    my ($parser_module) = @_;"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "    if (!$known_parsers) {"
NSQ_SOURCE_LINE 00000125 "        $class->load_parsers();"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 "    "
NSQ_SOURCE_LINE 00000128 "    @$known_parsers = grep { $_->{Name} ne $parser_module } @$known_parsers;"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    return $class;"
NSQ_SOURCE_LINE 00000131 "}"
NSQ_SOURCE_LINE 00000132 " "
NSQ_SOURCE_LINE 00000133 "sub add_parser {"
NSQ_SOURCE_LINE 00000134 "    my $class = shift;"
NSQ_SOURCE_LINE 00000135 "    my ($parser_module) = @_;"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    if (!$known_parsers) {"
NSQ_SOURCE_LINE 00000138 "        $class->load_parsers();"
NSQ_SOURCE_LINE 00000139 "    }"
NSQ_SOURCE_LINE 00000140 "    "
NSQ_SOURCE_LINE 00000141 "    # first load module, then query features, then push onto known_parsers,"
NSQ_SOURCE_LINE 00000142 "    "
NSQ_SOURCE_LINE 00000143 "    my $parser_file = $parser_module;"
NSQ_SOURCE_LINE 00000144 "    $parser_file =~ s/::/\\//g;"
NSQ_SOURCE_LINE 00000145 "    $parser_file .= \".pm\";"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    require $parser_file;"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    my @features = $parser_module->supported_features();"
NSQ_SOURCE_LINE 00000150 "    "
NSQ_SOURCE_LINE 00000151 "    my $new = { Name => $parser_module };"
NSQ_SOURCE_LINE 00000152 "    foreach my $feature (@features) {"
NSQ_SOURCE_LINE 00000153 "        $new->{Features}{$feature} = 1;"
NSQ_SOURCE_LINE 00000154 "    }"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    # If exists in list already, move to end."
NSQ_SOURCE_LINE 00000157 "    my $done = 0;"
NSQ_SOURCE_LINE 00000158 "    my $pos = undef;"
NSQ_SOURCE_LINE 00000159 "    for (my $i = 0; $i < @$known_parsers; $i++) {"
NSQ_SOURCE_LINE 00000160 "        my $p = $known_parsers->[$i];"
NSQ_SOURCE_LINE 00000161 "        if ($p->{Name} eq $parser_module) {"
NSQ_SOURCE_LINE 00000162 "            $pos = $i;"
NSQ_SOURCE_LINE 00000163 "        }"
NSQ_SOURCE_LINE 00000164 "    }"
NSQ_SOURCE_LINE 00000165 "    if (defined $pos) {"
NSQ_SOURCE_LINE 00000166 "        splice(@$known_parsers, $pos, 1);"
NSQ_SOURCE_LINE 00000167 "        push @$known_parsers, $new;"
NSQ_SOURCE_LINE 00000168 "        $done++;"
NSQ_SOURCE_LINE 00000169 "    }"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    # Otherwise (not in list), add at end of list."
NSQ_SOURCE_LINE 00000172 "    if (!$done) {"
NSQ_SOURCE_LINE 00000173 "        push @$known_parsers, $new;"
NSQ_SOURCE_LINE 00000174 "    }"
NSQ_SOURCE_LINE 00000175 "    "
NSQ_SOURCE_LINE 00000176 "    return $class;"
NSQ_SOURCE_LINE 00000177 "}"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "sub save_parsers {"
NSQ_SOURCE_LINE 00000180 "    my $class = shift;"
NSQ_SOURCE_LINE 00000181 "    "
NSQ_SOURCE_LINE 00000182 "    # get directory from wherever XML::SAX is installed"
NSQ_SOURCE_LINE 00000183 "    my $dir = $INC{'XML/SAX.pm'};"
NSQ_SOURCE_LINE 00000184 "    $dir = dirname($dir);"
NSQ_SOURCE_LINE 00000185 "    "
NSQ_SOURCE_LINE 00000186 "    my $file = File::Spec->catfile($dir, \"SAX\", PARSER_DETAILS);"
NSQ_SOURCE_LINE 00000187 "    chmod 0644, $file;"
NSQ_SOURCE_LINE 00000188 "    unlink($file);"
NSQ_SOURCE_LINE 00000189 "    "
NSQ_SOURCE_LINE 00000190 "    my $fh = gensym();"
NSQ_SOURCE_LINE 00000191 "    open($fh, \">$file\") ||"
NSQ_SOURCE_LINE 00000192 "        die \"Cannot write to $file: $!\";"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    foreach my $p (@$known_parsers) {"
NSQ_SOURCE_LINE 00000195 "        print $fh \"[$p->{Name}]\\n\";"
NSQ_SOURCE_LINE 00000196 "        foreach my $key (keys %{$p->{Features}}) {"
NSQ_SOURCE_LINE 00000197 "            print $fh \"$key = $p->{Features}{$key}\\n\";"
NSQ_SOURCE_LINE 00000198 "        }"
NSQ_SOURCE_LINE 00000199 "        print $fh \"\\n\";"
NSQ_SOURCE_LINE 00000200 "    }"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "    print $fh \"\\n\";"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "    close $fh;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    return $class;"
NSQ_SOURCE_LINE 00000207 "}"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "sub do_warn {"
NSQ_SOURCE_LINE 00000210 "    my $class = shift;"
NSQ_SOURCE_LINE 00000211 "    # Don't output warnings if running under Test::Harness"
NSQ_SOURCE_LINE 00000212 "    warn(@_) unless $ENV{HARNESS_ACTIVE};"
NSQ_SOURCE_LINE 00000213 "}"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "1;"
NSQ_SOURCE_LINE 00000216 "__END__"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "=head1 NAME"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "XML::SAX - Simple API for XML"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "  use XML::SAX;"
NSQ_SOURCE_LINE 00000225 "  "
NSQ_SOURCE_LINE 00000226 "  # get a list of known parsers"
NSQ_SOURCE_LINE 00000227 "  my $parsers = XML::SAX->parsers();"
NSQ_SOURCE_LINE 00000228 "  "
NSQ_SOURCE_LINE 00000229 "  # add/update a parser"
NSQ_SOURCE_LINE 00000230 "  XML::SAX->add_parser(q(XML::SAX::PurePerl));"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "  # remove parser"
NSQ_SOURCE_LINE 00000233 "  XML::SAX->remove_parser(q(XML::SAX::Foodelberry));"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "  # save parsers"
NSQ_SOURCE_LINE 00000236 "  XML::SAX->save_parsers();"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "XML::SAX is a SAX parser access API for Perl. It includes classes"
NSQ_SOURCE_LINE 00000241 "and APIs required for implementing SAX drivers, along with a factory"
NSQ_SOURCE_LINE 00000242 "class for returning any SAX parser installed on the user's system."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head1 USING A SAX2 PARSER"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "The factory class is XML::SAX::ParserFactory. Please see the"
NSQ_SOURCE_LINE 00000247 "documentation of that module for how to instantiate a SAX parser:"
NSQ_SOURCE_LINE 00000248 "L<XML::SAX::ParserFactory>. However if you don't want to load up"
NSQ_SOURCE_LINE 00000249 "another manual page, here's a short synopsis:"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "  use XML::SAX::ParserFactory;"
NSQ_SOURCE_LINE 00000252 "  use XML::SAX::XYZHandler;"
NSQ_SOURCE_LINE 00000253 "  my $handler = XML::SAX::XYZHandler->new();"
NSQ_SOURCE_LINE 00000254 "  my $p = XML::SAX::ParserFactory->parser(Handler => $handler);"
NSQ_SOURCE_LINE 00000255 "  $p->parse_uri(\"foo.xml\");"
NSQ_SOURCE_LINE 00000256 "  # or $p->parse_string(\"<foo/>\") or $p->parse_file($fh);"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "This will automatically load a SAX2 parser (defaulting to"
NSQ_SOURCE_LINE 00000259 "XML::SAX::PurePerl if no others are found) and return it to you."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "In order to learn how to use SAX to parse XML, you will need to read"
NSQ_SOURCE_LINE 00000262 "L<XML::SAX::Intro> and for reference, L<XML::SAX::Specification>."
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=head1 WRITING A SAX2 PARSER"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "The first thing to remember in writing a SAX2 parser is to subclass"
NSQ_SOURCE_LINE 00000267 "XML::SAX::Base. This will make your life infinitely easier, by providing"
NSQ_SOURCE_LINE 00000268 "a number of methods automagically for you. See L<XML::SAX::Base> for more"
NSQ_SOURCE_LINE 00000269 "details."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "When writing a SAX2 parser that is compatible with XML::SAX, you need"
NSQ_SOURCE_LINE 00000272 "to inform XML::SAX of the presence of that driver when you install it."
NSQ_SOURCE_LINE 00000273 "In order to do that, XML::SAX contains methods for saving the fact that"
NSQ_SOURCE_LINE 00000274 "the parser exists on your system to a \"INI\" file, which is then loaded"
NSQ_SOURCE_LINE 00000275 "to determine which parsers are installed."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "The best way to do this is to follow these rules:"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=over 4"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=item * Add XML::SAX as a prerequisite in Makefile.PL:"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "  WriteMakefile("
NSQ_SOURCE_LINE 00000284 "      ..."
NSQ_SOURCE_LINE 00000285 "      PREREQ_PM => { 'XML::SAX' => 0 },"
NSQ_SOURCE_LINE 00000286 "      ..."
NSQ_SOURCE_LINE 00000287 "  );"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "Alternatively you may wish to check for it in other ways that will"
NSQ_SOURCE_LINE 00000290 "cause more than just a warning."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=item * Add the following code snippet to your Makefile.PL:"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "  sub MY::install {"
NSQ_SOURCE_LINE 00000295 "    package MY;"
NSQ_SOURCE_LINE 00000296 "    my $script = shift->SUPER::install(@_);"
NSQ_SOURCE_LINE 00000297 "    if (ExtUtils::MakeMaker::prompt("
NSQ_SOURCE_LINE 00000298 "      \"Do you want to modify ParserDetails.ini?\", 'Y')"
NSQ_SOURCE_LINE 00000299 "      =~ /^y/i) {"
NSQ_SOURCE_LINE 00000300 "      $script =~ s/install :: (.*)$/install :: $1 install_sax_driver/m;"
NSQ_SOURCE_LINE 00000301 "      $script .= <<\"INSTALL\";"
NSQ_SOURCE_LINE 00000302 "  "
NSQ_SOURCE_LINE 00000303 "  install_sax_driver :"
NSQ_SOURCE_LINE 00000304 "  \\t\\@\\$(PERL) -MXML::SAX -e \"XML::SAX->add_parser(q(\\$(NAME)))->save_parsers()\""
NSQ_SOURCE_LINE 00000305 "  "
NSQ_SOURCE_LINE 00000306 "  INSTALL"
NSQ_SOURCE_LINE 00000307 "    }"
NSQ_SOURCE_LINE 00000308 "    return $script;"
NSQ_SOURCE_LINE 00000309 "  }"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "Note that you should check the output of this - \\$(NAME) will use the name of"
NSQ_SOURCE_LINE 00000312 "your distribution, which may not be exactly what you want. For example XML::LibXML"
NSQ_SOURCE_LINE 00000313 "has a driver called XML::LibXML::SAX::Generator, which is used in place of"
NSQ_SOURCE_LINE 00000314 "\\$(NAME) in the above."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=item * Add an XML::SAX test:"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "A test file should be added to your t/ directory containing something like the"
NSQ_SOURCE_LINE 00000319 "following:"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "  use Test;"
NSQ_SOURCE_LINE 00000322 "  BEGIN { plan tests => 3 }"
NSQ_SOURCE_LINE 00000323 "  use XML::SAX;"
NSQ_SOURCE_LINE 00000324 "  use XML::SAX::PurePerl::DebugHandler;"
NSQ_SOURCE_LINE 00000325 "  XML::SAX->add_parser(q(XML::SAX::MyDriver));"
NSQ_SOURCE_LINE 00000326 "  local $XML::SAX::ParserPackage = 'XML::SAX::MyDriver';"
NSQ_SOURCE_LINE 00000327 "  eval {"
NSQ_SOURCE_LINE 00000328 "    my $handler = XML::SAX::PurePerl::DebugHandler->new();"
NSQ_SOURCE_LINE 00000329 "    ok($handler);"
NSQ_SOURCE_LINE 00000330 "    my $parser = XML::SAX::ParserFactory->parser(Handler => $handler);"
NSQ_SOURCE_LINE 00000331 "    ok($parser);"
NSQ_SOURCE_LINE 00000332 "    ok($parser->isa('XML::SAX::MyDriver');"
NSQ_SOURCE_LINE 00000333 "    $parser->parse_string(\"<tag/>\");"
NSQ_SOURCE_LINE 00000334 "    ok($handler->{seen}{start_element});"
NSQ_SOURCE_LINE 00000335 "  };"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=back"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "By default, XML::SAX exports nothing into the caller's namespace. However you"
NSQ_SOURCE_LINE 00000342 "can request the symbols C<Namespaces> and C<Validation> which are the"
NSQ_SOURCE_LINE 00000343 "URIs for those features, allowing an easier way to request those features"
NSQ_SOURCE_LINE 00000344 "via ParserFactory:"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "  use XML::SAX qw(Namespaces Validation);"
NSQ_SOURCE_LINE 00000347 "  my $factory = XML::SAX::ParserFactory->new();"
NSQ_SOURCE_LINE 00000348 "  $factory->require_feature(Namespaces);"
NSQ_SOURCE_LINE 00000349 "  $factory->require_feature(Validation);"
NSQ_SOURCE_LINE 00000350 "  my $parser = $factory->parser();"
NSQ_SOURCE_LINE 00000351 ""
