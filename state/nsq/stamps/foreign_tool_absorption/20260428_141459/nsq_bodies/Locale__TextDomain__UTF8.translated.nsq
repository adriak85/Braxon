NSQ_SOURCE_LINE 00000001 "package Locale::TextDomain::UTF8;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2019-12-26'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Locale-TextDomain-UTF8'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.020'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "# IFUNBUILT"
NSQ_SOURCE_LINE 00000009 "# use strict;"
NSQ_SOURCE_LINE 00000010 "# use warnings;"
NSQ_SOURCE_LINE 00000011 "# END IFUNBUILT"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Encode             ();"
NSQ_SOURCE_LINE 00000014 "use Locale::Messages   ();"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "$ENV{OUTPUT_CHARSET} = 'UTF-8';"
NSQ_SOURCE_LINE 00000017 "sub import {"
NSQ_SOURCE_LINE 00000018 "    my ($class, $textdomain, @search_dirs) = @_;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    my $pkg = caller;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    eval qq[package $pkg; use Locale::TextDomain \\$textdomain, \\@search_dirs;];"
NSQ_SOURCE_LINE 00000023 "    die if $@;"
NSQ_SOURCE_LINE 00000024 "    Locale::Messages::bind_textdomain_filter("
NSQ_SOURCE_LINE 00000025 "        $textdomain, \\&Encode::decode_utf8);"
NSQ_SOURCE_LINE 00000026 "}"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "1;"
NSQ_SOURCE_LINE 00000029 "# ABSTRACT: Shortcut to use Locale::TextDomain and decoding to UTF8"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "__END__"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=pod"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=head1 NAME"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "Locale::TextDomain::UTF8 - Shortcut to use Locale::TextDomain and decoding to UTF8"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=head1 VERSION"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "This document describes version 0.020 of Locale::TextDomain::UTF8 (from Perl distribution Locale-TextDomain-UTF8), released on 2019-12-26."
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "Instead of:"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 " use Locale::TextDomain 'Some-TextDomain';"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "you now say:"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 " use Locale::TextDomain::UTF8 'Some-TextDomain';"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 " use Locale::TextDomain::UTF8 'Some-TextDomain'"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "is equivalent to:"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 " use Locale::TextDomain 'Some-TextDomain';"
NSQ_SOURCE_LINE 00000062 " use Locale::Messages qw(bind_textdomain_filter);"
NSQ_SOURCE_LINE 00000063 " use Encode;"
NSQ_SOURCE_LINE 00000064 " BEGIN {"
NSQ_SOURCE_LINE 00000065 "     $ENV{OUTPUT_CHARSET} = 'UTF-8';"
NSQ_SOURCE_LINE 00000066 "     bind_textdomain_filter 'Some-TextDomain' => \\&Encode::decode_utf8;"
NSQ_SOURCE_LINE 00000067 " }"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "it's just more convenient, especially if you have to do it for each textdomain."
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "Why would you want this? To ensure that strings returned by the C<__()>, et al"
NSQ_SOURCE_LINE 00000072 "functions are UTF8-encoded Perl strings. For example, if you want to pass the"
NSQ_SOURCE_LINE 00000073 "strings to L<Unicode::GCString>. For more details, see the Perl Advent article"
NSQ_SOURCE_LINE 00000074 "mentioned in the SEE ALSO section."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "Please visit the project's homepage at L<https://metacpan.org/release/Locale-TextDomain-UTF8>."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Source repository is at L<https://github.com/perlancar/perl-Locale-TextDomain-UTF8>."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head1 BUGS"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=Locale-TextDomain-UTF8>"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000089 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000090 "feature."
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000093 ""
