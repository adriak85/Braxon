NSQ_SOURCE_LINE 00000001 "package Log::Dispatch::FileRotate;"
NSQ_SOURCE_LINE 00000002 "$Log::Dispatch::FileRotate::VERSION = '1.38';"
NSQ_SOURCE_LINE 00000003 "# ABSTRACT: Log to Files that Archive/Rotate Themselves"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "require 5.005;"
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use base 'Log::Dispatch::Output';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Date::Manip;"
NSQ_SOURCE_LINE 00000011 "use File::Spec;"
NSQ_SOURCE_LINE 00000012 "use Log::Dispatch::File;"
NSQ_SOURCE_LINE 00000013 "use Log::Dispatch::FileRotate::Mutex;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub DESTROY {"
NSQ_SOURCE_LINE 00000016 "    my $self = shift;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "    # get rid of current LDF"
NSQ_SOURCE_LINE 00000019 "    if ($self->{LDF}) {"
NSQ_SOURCE_LINE 00000020 "        delete $self->{LDF};"
NSQ_SOURCE_LINE 00000021 "    }"
NSQ_SOURCE_LINE 00000022 "}"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub new {"
NSQ_SOURCE_LINE 00000026 "    my $proto = shift;"
NSQ_SOURCE_LINE 00000027 "    my $class = ref $proto || $proto;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    my %p = @_;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    my $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    # Turn ON/OFF debugging as required"
NSQ_SOURCE_LINE 00000034 "    $self->{debug} = $p{DEBUG};"
NSQ_SOURCE_LINE 00000035 "    $self->_basic_init(%p);"
NSQ_SOURCE_LINE 00000036 "    $self->{LDF}   = Log::Dispatch::File->new(%p);  # Our log"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    unless (defined $self->{timer}) {"
NSQ_SOURCE_LINE 00000039 "        $self->{timer} = sub { time };"
NSQ_SOURCE_LINE 00000040 "    }"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "    # Keep a copy of interesting stuff as well"
NSQ_SOURCE_LINE 00000043 "    $self->{params} = \\%p;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    # Size defaults to 10meg in all failure modes, hopefully"
NSQ_SOURCE_LINE 00000046 "    my $ten_meg = 1024*1024*10;"
NSQ_SOURCE_LINE 00000047 "    my $two_gig = 1024*1024*1024*2;"
NSQ_SOURCE_LINE 00000048 "    my $size    = $ten_meg;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    if (defined $p{size}) {"
NSQ_SOURCE_LINE 00000051 "        # allow perl-literal style nubers 10_000_000 -> 10000000"
NSQ_SOURCE_LINE 00000052 "        $p{size} =~ s/_//g;"
NSQ_SOURCE_LINE 00000053 "        $size = $p{size};"
NSQ_SOURCE_LINE 00000054 "    }"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    unless ($size =~ /^\\d+$/ && $size < $two_gig && $size > 0) {"
NSQ_SOURCE_LINE 00000057 "        $size = $ten_meg;"
NSQ_SOURCE_LINE 00000058 "    }"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    $self->{size} = $size;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    # Max number of files defaults to 1. No limit enforced here. Only"
NSQ_SOURCE_LINE 00000063 "    # positive whole numbers allowed"
NSQ_SOURCE_LINE 00000064 "    $self->{max} = $p{max};"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    unless (defined $self->{max} && $self->{max} =~ /^\\d+$/ && $self->{max} > 0) {"
NSQ_SOURCE_LINE 00000067 "        $self->{max}  = 1"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    # Get a name for our Lock file"
NSQ_SOURCE_LINE 00000071 "    my $name = $self->{params}->{filename};"
NSQ_SOURCE_LINE 00000072 "    my ($vol, $dir, $f) = File::Spec->splitpath($name);"
NSQ_SOURCE_LINE 00000073 "    $dir ||= '.';"
NSQ_SOURCE_LINE 00000074 "    $f   ||= $name;"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "    $self->{lf} = File::Spec->catpath($vol, $dir, \".${f}.LCK\");"
NSQ_SOURCE_LINE 00000077 "    $self->debug('Lock file is '.$self->{lf});"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    # Have we been called with a time based rotation pattern then setup"
NSQ_SOURCE_LINE 00000080 "    # timebased stuff. TZ is important and must match current TZ or all"
NSQ_SOURCE_LINE 00000081 "    # bets are off!"
NSQ_SOURCE_LINE 00000082 "    if (defined $p{TZ}) {"
NSQ_SOURCE_LINE 00000083 "        # Date::Manip deprecated TZ= in 6.x.  In order to maintain backwards"
NSQ_SOURCE_LINE 00000084 "        # compat with 5.8, we use TZ if setdate is not avilable.  Otherwise we"
NSQ_SOURCE_LINE 00000085 "        # use setdate."
NSQ_SOURCE_LINE 00000086 "        require version;"
NSQ_SOURCE_LINE 00000087 "        if (version->parse(DateManipVersion()) < version->parse('6.0')) {"
NSQ_SOURCE_LINE 00000088 "            Date_Init(\"TZ=\".$p{TZ});"
NSQ_SOURCE_LINE 00000089 "        }"
NSQ_SOURCE_LINE 00000090 "        else {"
NSQ_SOURCE_LINE 00000091 "            # Date::Manip 6.x deprecates TZ, use  SetDate instead"
NSQ_SOURCE_LINE 00000092 "            Date_Init(\"setdate=now,\".$p{TZ});"
NSQ_SOURCE_LINE 00000093 "        }"
NSQ_SOURCE_LINE 00000094 "    }"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    if (defined $p{DatePattern}) {"
NSQ_SOURCE_LINE 00000097 "        $self->setDatePattern($p{DatePattern});"
NSQ_SOURCE_LINE 00000098 "    }"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    $self->{check_both} = $p{check_both} ? 1 : 0;"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "    # User callback to rotate the file."
NSQ_SOURCE_LINE 00000103 "    $self->{user_constraint} = $p{user_constraint};"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    # A post rotate callback."
NSQ_SOURCE_LINE 00000106 "    $self->{post_rotate} = $p{post_rotate};"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "    # Flag this as first creation point"
NSQ_SOURCE_LINE 00000109 "    $self->{new} = 1;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    return $self;"
NSQ_SOURCE_LINE 00000112 "}"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "sub filename {"
NSQ_SOURCE_LINE 00000116 "    my $self = shift;"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    return $self->{params}->{filename};"
NSQ_SOURCE_LINE 00000119 "}"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "###########################################################################"
NSQ_SOURCE_LINE 00000123 "#"
NSQ_SOURCE_LINE 00000124 "# Subroutine setDatePattern"
NSQ_SOURCE_LINE 00000125 "#"
NSQ_SOURCE_LINE 00000126 "#       Args: a single string or ArrayRef of strings"
NSQ_SOURCE_LINE 00000127 "#"
NSQ_SOURCE_LINE 00000128 "#       Rtns: Nothing"
NSQ_SOURCE_LINE 00000129 "#"
NSQ_SOURCE_LINE 00000130 "# Description:"
NSQ_SOURCE_LINE 00000131 "#     Set a recurrance for file rotation. We accept Date::Manip"
NSQ_SOURCE_LINE 00000132 "#     recurrances and the log4j/DailyRollingFileAppender patterns"
NSQ_SOURCE_LINE 00000133 "#"
NSQ_SOURCE_LINE 00000134 "#     Date:Manip =>"
NSQ_SOURCE_LINE 00000135 "#           0:0:0:0:5:30:0       every 5 hours and 30 minutes"
NSQ_SOURCE_LINE 00000136 "#           0:0:0:2*12:30:0      every 2 days at 12:30 (each day)"
NSQ_SOURCE_LINE 00000137 "#           3*1:0:2:12:0:0       every 3 years on Jan 2 at noon"
NSQ_SOURCE_LINE 00000138 "#"
NSQ_SOURCE_LINE 00000139 "#     DailyRollingFileAppender =>"
NSQ_SOURCE_LINE 00000140 "#           yyyy-MM"
NSQ_SOURCE_LINE 00000141 "#           yyyy-ww"
NSQ_SOURCE_LINE 00000142 "#           yyyy-MM-dd"
NSQ_SOURCE_LINE 00000143 "#           yyyy-MM-dd-a"
NSQ_SOURCE_LINE 00000144 "#           yyyy-MM-dd-HH"
NSQ_SOURCE_LINE 00000145 "#           yyyy-MM-dd-HH-MM"
NSQ_SOURCE_LINE 00000146 "#"
NSQ_SOURCE_LINE 00000147 "# To specify multiple recurances in a single string seperate them with a"
NSQ_SOURCE_LINE 00000148 "# comma: yyyy-MM-dd,0:0:0:2*12:30:0"
NSQ_SOURCE_LINE 00000149 "#"
NSQ_SOURCE_LINE 00000150 "sub setDatePattern {"
NSQ_SOURCE_LINE 00000151 "    my ($self, $arg) = @_;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    local($_);               # Don't crap on $_"
NSQ_SOURCE_LINE 00000154 "    my @pats = ();"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    my %lookup = ("
NSQ_SOURCE_LINE 00000157 "        #                      Y:M:W:D:H:M:S"
NSQ_SOURCE_LINE 00000158 "        'yyyy-mm'          => '0:1*0:1:0:0:0',     # Every Month"
NSQ_SOURCE_LINE 00000159 "        'yyyy-ww'          => '0:0:1*0:0:0:0',     # Every week"
NSQ_SOURCE_LINE 00000160 "        'yyyy-dd'          => '0:0:0:1*0:0:0',     # Every day"
NSQ_SOURCE_LINE 00000161 "        'yyyy-mm-dd'       => '0:0:0:1*0:0:0',     # Every day"
NSQ_SOURCE_LINE 00000162 "        'yyyy-dd-a'        => '0:0:0:1*12:0:0',    # Every day 12noon"
NSQ_SOURCE_LINE 00000163 "        'yyyy-mm-dd-a'     => '0:0:0:1*12:0:0',    # Every day 12noon"
NSQ_SOURCE_LINE 00000164 "        'yyyy-dd-hh'       => '0:0:0:0:1*0:0',     # Every hour"
NSQ_SOURCE_LINE 00000165 "        'yyyy-mm-dd-hh'    => '0:0:0:0:1*0:0',     # Every hour"
NSQ_SOURCE_LINE 00000166 "        'yyyy-dd-hh-mm'    => '0:0:0:0:0:1*0',     # Every minute"
NSQ_SOURCE_LINE 00000167 "        'yyyy-mm-dd-hh-mm' => '0:0:0:0:0:1*0',     # Every minute"
NSQ_SOURCE_LINE 00000168 "    );"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    # Convert arg to array"
NSQ_SOURCE_LINE 00000171 "    if (ref $arg eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000172 "        @pats = @$arg;"
NSQ_SOURCE_LINE 00000173 "    }"
NSQ_SOURCE_LINE 00000174 "    elsif (!ref $arg) {"
NSQ_SOURCE_LINE 00000175 "        $arg =~ s/\\s+//go;"
NSQ_SOURCE_LINE 00000176 "        @pats = split /;/, $arg;"
NSQ_SOURCE_LINE 00000177 "    }"
NSQ_SOURCE_LINE 00000178 "    else {"
NSQ_SOURCE_LINE 00000179 "        die \"Bad reference type argument \".ref $arg;"
NSQ_SOURCE_LINE 00000180 "    }"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    # Handle (possibly multiple) recurrances"
NSQ_SOURCE_LINE 00000183 "    foreach my $pat (@pats) {"
NSQ_SOURCE_LINE 00000184 "        # Convert any log4j patterns across"
NSQ_SOURCE_LINE 00000185 "        if ($pat =~ /^yyyy/i) {"
NSQ_SOURCE_LINE 00000186 "            # log4j style"
NSQ_SOURCE_LINE 00000187 "            $pat = $lookup{lc $pat};"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "            # Default to daily on bad pattern"
NSQ_SOURCE_LINE 00000190 "            unless (defined $pat) {"
NSQ_SOURCE_LINE 00000191 "                warn \"Bad Rotation pattern ($pat) using yyyy-dd\\n\";"
NSQ_SOURCE_LINE 00000192 "                $pat = 'yyyy-dd';"
NSQ_SOURCE_LINE 00000193 "            }"
NSQ_SOURCE_LINE 00000194 "        }"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "        my $abs = $self->_get_next_occurance($pat);"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "        $self->debug(\"Adding [dates,pat] =>[$abs,$pat]\");"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "        my $ref = [$abs, $pat];"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "        push @{$self->{recurrance}}, $ref;"
NSQ_SOURCE_LINE 00000203 "    }"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "sub log_message {"
NSQ_SOURCE_LINE 00000208 "    my ($self, %p) = @_;"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    my $mutex = $self->rotate(1);"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "    unless (defined $mutex) {"
NSQ_SOURCE_LINE 00000213 "        $self->error('not logging');"
NSQ_SOURCE_LINE 00000214 "        return;"
NSQ_SOURCE_LINE 00000215 "    }"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "    $self->debug('normal log');"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "    $self->logit($p{message});"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "    $self->debug('releasing lock');"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "    $mutex->unlock;"
NSQ_SOURCE_LINE 00000224 "}"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "sub rotate {"
NSQ_SOURCE_LINE 00000228 "    my ($self, $hold_lock) = @_;"
NSQ_SOURCE_LINE 00000229 "    # NOTE: $hold_lock is internal use only!"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "    my $max_size = $self->{size};"
NSQ_SOURCE_LINE 00000232 "    my $numfiles = $self->{max};"
NSQ_SOURCE_LINE 00000233 "    my $name     = $self->filename();"
NSQ_SOURCE_LINE 00000234 "    my $fh       = $self->{LDF}->{fh};"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "    # Prime our time based data outside the critical code area"
NSQ_SOURCE_LINE 00000237 "    my ($in_time_mode,$time_to_rotate) = $self->time_to_rotate();"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "    my $user_rotation = 0;"
NSQ_SOURCE_LINE 00000240 "    if (ref $self->{user_constraint} eq 'CODE') {"
NSQ_SOURCE_LINE 00000241 "        eval {"
NSQ_SOURCE_LINE 00000242 "            $user_rotation = &{$self->{user_constraint}}();"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "            1;"
NSQ_SOURCE_LINE 00000245 "        } or do {"
NSQ_SOURCE_LINE 00000246 "            $self->error(\"user's callback error: $@\");"
NSQ_SOURCE_LINE 00000247 "        };"
NSQ_SOURCE_LINE 00000248 "    }"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "    # Handle critical code for logging. No changes if someone else is in.  We"
NSQ_SOURCE_LINE 00000251 "    # lock a lockfile, not the actual log filehandle since the log filehandle"
NSQ_SOURCE_LINE 00000252 "    # will change if we rotate the logs."
NSQ_SOURCE_LINE 00000253 "    my $mutex = $self->mutex_for_path($self->{lf});"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "    unless ($mutex->lock) {"
NSQ_SOURCE_LINE 00000256 "        $self->error(\"failed to get lock: $!\");"
NSQ_SOURCE_LINE 00000257 "        return;"
NSQ_SOURCE_LINE 00000258 "    }"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "    $self->debug('got lock');"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "    my $have_to_rotate = 0;"
NSQ_SOURCE_LINE 00000263 "    my ($inode, $size) = (stat $fh)[1,7]; # real inode and size"
NSQ_SOURCE_LINE 00000264 "    my $finode         = (stat $name)[1]; # inode of filename for comparision"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "    $self->debug(\"s=$size, i=$inode, f=\"."
NSQ_SOURCE_LINE 00000267 "            (defined $finode ? $finode : \"undef\") ."
NSQ_SOURCE_LINE 00000268 "            \", n=$name\");"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "    # If finode and inode are the same then nobody has done a rename"
NSQ_SOURCE_LINE 00000271 "    # under us and we can continue. Otherwise just close and reopen."
NSQ_SOURCE_LINE 00000272 "    if (!defined $finode || $inode != $finode) {"
NSQ_SOURCE_LINE 00000273 "        # Oops someone moved things on us. So just reopen our log"
NSQ_SOURCE_LINE 00000274 "        delete $self->{LDF};  # Should get rid of current LDF"
NSQ_SOURCE_LINE 00000275 "        $self->{LDF} =  Log::Dispatch::File->new(%{$self->{params}});  # Our log"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "        $self->debug('Someone else rotated');"
NSQ_SOURCE_LINE 00000278 "    }"
NSQ_SOURCE_LINE 00000279 "    else {"
NSQ_SOURCE_LINE 00000280 "        my $check_both = $self->{check_both};"
NSQ_SOURCE_LINE 00000281 "        my $rotate_by_size = ($size >= $max_size) ? 1 : 0;"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "        if(($in_time_mode && $time_to_rotate) ||"
NSQ_SOURCE_LINE 00000284 "           (!$in_time_mode && $rotate_by_size) ||"
NSQ_SOURCE_LINE 00000285 "           ($rotate_by_size && $check_both) ||"
NSQ_SOURCE_LINE 00000286 "           ($user_rotation))"
NSQ_SOURCE_LINE 00000287 "        {"
NSQ_SOURCE_LINE 00000288 "            $have_to_rotate = 1;"
NSQ_SOURCE_LINE 00000289 "        }"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "        $self->debug(\"in time mode: $in_time_mode; time to rotate: $time_to_rotate;\""
NSQ_SOURCE_LINE 00000292 "            .\" rotate by size: $rotate_by_size; check_both: $check_both;\""
NSQ_SOURCE_LINE 00000293 "            .\" user rotation: $user_rotation; have to rotate: $have_to_rotate\");"
NSQ_SOURCE_LINE 00000294 "    }"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "    if ($have_to_rotate) {"
NSQ_SOURCE_LINE 00000297 "        # Shut down the log"
NSQ_SOURCE_LINE 00000298 "        delete $self->{LDF};  # Should get rid of current LDF"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "        $self->debug('Rotating');"
NSQ_SOURCE_LINE 00000301 "        $self->_for_each_file(\\&_move_file);"
NSQ_SOURCE_LINE 00000302 "        $self->debug('Rotating Done');"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "        # reopen the logfile for writing."
NSQ_SOURCE_LINE 00000305 "        $self->{LDF} =  Log::Dispatch::File->new(%{$self->{params}});  # Our log"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "        if (ref $self->{post_rotate} eq 'CODE') {"
NSQ_SOURCE_LINE 00000308 "            $self->debug('Calling user post-rotate callback');"
NSQ_SOURCE_LINE 00000309 "            $self->_for_each_file($self->{post_rotate});"
NSQ_SOURCE_LINE 00000310 "        }"
NSQ_SOURCE_LINE 00000311 "    }"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "    if ($hold_lock) {"
NSQ_SOURCE_LINE 00000314 "        return $mutex;"
NSQ_SOURCE_LINE 00000315 "    }"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "    $mutex->unlock;"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "    return $have_to_rotate;"
NSQ_SOURCE_LINE 00000320 "}"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "sub _for_each_file {"
NSQ_SOURCE_LINE 00000323 "    my ($self, $callback) = @_;"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "    my $basename = $self->filename();"
NSQ_SOURCE_LINE 00000326 "    my $idx      = $self->{max} - 1;"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "    while ($idx >= 0) {"
NSQ_SOURCE_LINE 00000329 "        my $filename = $basename;"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "        if ($idx) {"
NSQ_SOURCE_LINE 00000332 "            $filename .= \".$idx\";"
NSQ_SOURCE_LINE 00000333 "        }"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "        eval {"
NSQ_SOURCE_LINE 00000336 "            if (-f $filename) {"
NSQ_SOURCE_LINE 00000337 "                &{$callback}($filename, $idx, $self);"
NSQ_SOURCE_LINE 00000338 "            }"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "            1;"
NSQ_SOURCE_LINE 00000341 "        } or do {"
NSQ_SOURCE_LINE 00000342 "            $self->error(\"callback error: $@\");"
NSQ_SOURCE_LINE 00000343 "        };"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "        $idx--;"
NSQ_SOURCE_LINE 00000346 "    }"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "    return undef;"
NSQ_SOURCE_LINE 00000349 "}"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "sub _move_file {"
NSQ_SOURCE_LINE 00000352 "    my ($filename, $idx, $fileRotate) = @_;"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "    my $basename = $fileRotate->filename();"
NSQ_SOURCE_LINE 00000355 "    my $newfile  = $basename . '.' . ($idx+1);"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "    $fileRotate->debug(\"rename $filename $newfile\");"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "    rename $filename, $newfile;"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "    return undef;"
NSQ_SOURCE_LINE 00000362 "}"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "sub logit {"
NSQ_SOURCE_LINE 00000365 "    my ($self, $message) = @_;"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "    # Make sure we are at the EOF"
NSQ_SOURCE_LINE 00000368 "    seek $self->{LDF}{fh}, 0, 2;"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "    $self->{LDF}->log_message(message => $message);"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "    return;"
NSQ_SOURCE_LINE 00000373 "}"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "{"
NSQ_SOURCE_LINE 00000376 "    my %MUTEXES;"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "    sub mutex_for_path {"
NSQ_SOURCE_LINE 00000379 "        my ($self, $path) = @_;"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "        my %args;"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "        # use same permissions for the Mutex file"
NSQ_SOURCE_LINE 00000384 "        if (exists $self->{params}{permissions}) {"
NSQ_SOURCE_LINE 00000385 "            $args{permissions} = $self->{params}{permissions};"
NSQ_SOURCE_LINE 00000386 "        }"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "        $MUTEXES{$path} ||= Log::Dispatch::FileRotate::Mutex->new($path, %args);"
NSQ_SOURCE_LINE 00000389 "    }"
NSQ_SOURCE_LINE 00000390 "}"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "###########################################################################"
NSQ_SOURCE_LINE 00000393 "#"
NSQ_SOURCE_LINE 00000394 "# Subroutine time_to_rotate"
NSQ_SOURCE_LINE 00000395 "#"
NSQ_SOURCE_LINE 00000396 "#       Args: none"
NSQ_SOURCE_LINE 00000397 "#"
NSQ_SOURCE_LINE 00000398 "#       Rtns: (1,n)  if we are in time mode and its time to rotate"
NSQ_SOURCE_LINE 00000399 "#                    n defines the number of timers that expired"
NSQ_SOURCE_LINE 00000400 "#             (1,0)  if we are in time mode but not ready to rotate"
NSQ_SOURCE_LINE 00000401 "#             (0,0)  otherwise"
NSQ_SOURCE_LINE 00000402 "#"
NSQ_SOURCE_LINE 00000403 "# Description:"
NSQ_SOURCE_LINE 00000404 "#     time_to_rotate - update internal clocks and return status as"
NSQ_SOURCE_LINE 00000405 "#     defined above"
NSQ_SOURCE_LINE 00000406 "#"
NSQ_SOURCE_LINE 00000407 "# If we have just been created then the first recurrance is an indication"
NSQ_SOURCE_LINE 00000408 "# to check against the log file."
NSQ_SOURCE_LINE 00000409 "#"
NSQ_SOURCE_LINE 00000410 "#"
NSQ_SOURCE_LINE 00000411 "#   my ($in_time_mode,$time_to_rotate) = $self->time_to_rotate();"
NSQ_SOURCE_LINE 00000412 "sub time_to_rotate {"
NSQ_SOURCE_LINE 00000413 "    my $self = shift;"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "    my $mode   = defined $self->{recurrance};"
NSQ_SOURCE_LINE 00000416 "    my $rotate = 0;"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "    if ($mode) {"
NSQ_SOURCE_LINE 00000419 "        # Then do some checking and update ourselves if we think we need"
NSQ_SOURCE_LINE 00000420 "        # to rotate. Wether we rotate or not is up to our caller. We"
NSQ_SOURCE_LINE 00000421 "        # assume they know what they are doing!"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "        # Only stat the log file here if we are in our first invocation."
NSQ_SOURCE_LINE 00000424 "        my $ftime = $self->{new}"
NSQ_SOURCE_LINE 00000425 "            ? (stat $self->{LDF}{fh})[9]"
NSQ_SOURCE_LINE 00000426 "            : 0;"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "        # Check need for rotation. Loop through our recurrances looking"
NSQ_SOURCE_LINE 00000429 "        # for expiration times. Any we find that have expired we update."
NSQ_SOURCE_LINE 00000430 "        my $tm    = $self->{timer}->();"
NSQ_SOURCE_LINE 00000431 "        my @recur = @{$self->{recurrance}};"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "        $self->{recurrance} = [];"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "        for my $rec (@recur) {"
NSQ_SOURCE_LINE 00000436 "            my ($abs, $pat) = @$rec;"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "            # Extra checking"
NSQ_SOURCE_LINE 00000439 "            unless (defined $abs && $abs) {"
NSQ_SOURCE_LINE 00000440 "                warn \"Bad time found for recurrance pattern $pat: $abs\\n\";"
NSQ_SOURCE_LINE 00000441 "                next;"
NSQ_SOURCE_LINE 00000442 "            }"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "            my $dorotate = 0;"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "            # If this is first time through"
NSQ_SOURCE_LINE 00000447 "            if ($self->{new}) {"
NSQ_SOURCE_LINE 00000448 "                # If it needs a rotate then flag it"
NSQ_SOURCE_LINE 00000449 "                if ($ftime <= $abs) {"
NSQ_SOURCE_LINE 00000450 "                    # Then we need to rotate"
NSQ_SOURCE_LINE 00000451 "                    $self->debug(\"Need rotate file($ftime) <= $abs\");"
NSQ_SOURCE_LINE 00000452 "                    $rotate++;"
NSQ_SOURCE_LINE 00000453 "                    $dorotate++;  # Just for debugging"
NSQ_SOURCE_LINE 00000454 "                }"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "                # Move to next occurance regardless"
NSQ_SOURCE_LINE 00000457 "                $self->debug(\"Dropping initial occurance($abs)\");"
NSQ_SOURCE_LINE 00000458 "                $abs = $self->_get_next_occurance($pat);"
NSQ_SOURCE_LINE 00000459 "                unless (defined $abs && $abs) {"
NSQ_SOURCE_LINE 00000460 "                    warn \"Next occurance is null for $pat\\n\";"
NSQ_SOURCE_LINE 00000461 "                    $abs = 0;"
NSQ_SOURCE_LINE 00000462 "                }"
NSQ_SOURCE_LINE 00000463 "            }"
NSQ_SOURCE_LINE 00000464 "            elsif ($abs <= $tm) {"
NSQ_SOURCE_LINE 00000465 "                # Then we need to rotate"
NSQ_SOURCE_LINE 00000466 "                $self->debug(\"Need rotate $abs <= $tm\");"
NSQ_SOURCE_LINE 00000467 "                $abs = $self->_get_next_occurance($pat);"
NSQ_SOURCE_LINE 00000468 "                unless (defined $abs && $abs) {"
NSQ_SOURCE_LINE 00000469 "                    warn \"Next occurance is null for $pat\\n\";"
NSQ_SOURCE_LINE 00000470 "                    $abs = 0;"
NSQ_SOURCE_LINE 00000471 "                }"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "                $rotate++;"
NSQ_SOURCE_LINE 00000474 "                $dorotate++;  # Just for debugging"
NSQ_SOURCE_LINE 00000475 "            }"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "            if ($abs) {"
NSQ_SOURCE_LINE 00000478 "                push @{$self->{recurrance}}, [$abs, $pat];"
NSQ_SOURCE_LINE 00000479 "            }"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "            $self->debug(\"time_to_rotate(mode,rotate,next) => ($mode,$dorotate,$abs)\");"
NSQ_SOURCE_LINE 00000482 "        }"
NSQ_SOURCE_LINE 00000483 "    }"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "    $self->{new} = 0;  # No longer brand-spankers"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "    $self->debug(\"time_to_rotate(mode,rotate) => ($mode,$rotate)\");"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "    return wantarray ? ($mode, $rotate) : $rotate;"
NSQ_SOURCE_LINE 00000490 "}"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "###########################################################################"
NSQ_SOURCE_LINE 00000493 "#"
NSQ_SOURCE_LINE 00000494 "# Subroutine _gen_occurance"
NSQ_SOURCE_LINE 00000495 "#"
NSQ_SOURCE_LINE 00000496 "#       Args: Date::Manip occurance pattern"
NSQ_SOURCE_LINE 00000497 "#"
NSQ_SOURCE_LINE 00000498 "#       Rtns: array of dates for next few events"
NSQ_SOURCE_LINE 00000499 "#"
NSQ_SOURCE_LINE 00000500 "#  If asked we will return an inital occurance that is before the current"
NSQ_SOURCE_LINE 00000501 "#  time. This can be used to see if we need to rotate on start up. We are"
NSQ_SOURCE_LINE 00000502 "#  often called by CGI (short lived) proggies :-("
NSQ_SOURCE_LINE 00000503 "#"
NSQ_SOURCE_LINE 00000504 "sub _gen_occurance {"
NSQ_SOURCE_LINE 00000505 "    my ($self, $pat, $initial) = @_;"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "    # Do we return an initial occurance before the current time?"
NSQ_SOURCE_LINE 00000508 "    $initial ||= 0;"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "    my $range = '';"
NSQ_SOURCE_LINE 00000511 "    my $base  = 'now'; # default to calcs based on the current time"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "    if ($pat =~ /^0:0:0:0:0/) {"
NSQ_SOURCE_LINE 00000514 "        # Small recurrance less than 1 hour"
NSQ_SOURCE_LINE 00000515 "        $range = \"4 hours later\";"
NSQ_SOURCE_LINE 00000516 "        $base  = \"1 hours ago\" if $initial;"
NSQ_SOURCE_LINE 00000517 "    }"
NSQ_SOURCE_LINE 00000518 "    elsif ($pat =~ /^0:0:0:0/) {"
NSQ_SOURCE_LINE 00000519 "        # recurrance less than 1 day"
NSQ_SOURCE_LINE 00000520 "        $range = \"4 days later\";"
NSQ_SOURCE_LINE 00000521 "        $base  = \"1 days ago\" if $initial;"
NSQ_SOURCE_LINE 00000522 "    }"
NSQ_SOURCE_LINE 00000523 "    elsif ($pat =~ /^0:0:0:/) {"
NSQ_SOURCE_LINE 00000524 "        # recurrance less than 1 week"
NSQ_SOURCE_LINE 00000525 "        $range = \"4 weeks later\";"
NSQ_SOURCE_LINE 00000526 "        $base  = \"1 weeks ago\" if $initial;"
NSQ_SOURCE_LINE 00000527 "    }"
NSQ_SOURCE_LINE 00000528 "    elsif ($pat =~ /^0:0:/) {"
NSQ_SOURCE_LINE 00000529 "        # recurrance less than 1 month"
NSQ_SOURCE_LINE 00000530 "        $range = \"4 months later\";"
NSQ_SOURCE_LINE 00000531 "        $base  = \"1 months ago\" if $initial;"
NSQ_SOURCE_LINE 00000532 "    }"
NSQ_SOURCE_LINE 00000533 "    elsif ($pat =~ /^0:/) {"
NSQ_SOURCE_LINE 00000534 "        # recurrance less than 1 year"
NSQ_SOURCE_LINE 00000535 "        $range = \"24 months later\";"
NSQ_SOURCE_LINE 00000536 "        $base  = \"24 months ago\" if $initial;"
NSQ_SOURCE_LINE 00000537 "    }"
NSQ_SOURCE_LINE 00000538 "    else {"
NSQ_SOURCE_LINE 00000539 "        # years"
NSQ_SOURCE_LINE 00000540 "        my ($yrs) = $pat =~ m/^(\\d+):/;"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "        $yrs ||= 1;"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "        my $months = $yrs * 4 * 12;"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "        $range = \"$months months later\";"
NSQ_SOURCE_LINE 00000547 "        $base  = \"$months months ago\" if $initial;"
NSQ_SOURCE_LINE 00000548 "    }"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "    # The next date must start at least 1 second away from now other wise"
NSQ_SOURCE_LINE 00000551 "    # we may rotate for every message we recieve with in this second :-("
NSQ_SOURCE_LINE 00000552 "    my $start = DateCalc($base,\"+ 1 second\");"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "    $self->debug(\"ParseRecur($pat,$base,$start,$range);\");"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "    my @dates = ParseRecur($pat,$base,$start,$range);"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "    # Just in case we have a bad parse or our assumptions are wrong."
NSQ_SOURCE_LINE 00000559 "    # We default to days"
NSQ_SOURCE_LINE 00000560 "    unless (scalar @dates >= 2) {"
NSQ_SOURCE_LINE 00000561 "        warn \"Failed to parse ($pat). Going daily\\n\";"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "        if ($initial) {"
NSQ_SOURCE_LINE 00000564 "            @dates = ParseRecur('0:0:0:1*0:0:0',\"2 days ago\",\"2 days ago\",\"1 months later\");"
NSQ_SOURCE_LINE 00000565 "        }"
NSQ_SOURCE_LINE 00000566 "        else {"
NSQ_SOURCE_LINE 00000567 "            @dates = ParseRecur('0:0:0:1*0:0:0',\"now\",\"now\",\"1 months later\");"
NSQ_SOURCE_LINE 00000568 "        }"
NSQ_SOURCE_LINE 00000569 "    }"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "    # Convert the dates to seconds since the epoch so we can use"
NSQ_SOURCE_LINE 00000572 "    # numerical comparision instead of textual"
NSQ_SOURCE_LINE 00000573 "    my @epochs = ();"
NSQ_SOURCE_LINE 00000574 "    my @a = ('%Y','%m','%d','%H','%M','%S');"
NSQ_SOURCE_LINE 00000575 "    foreach (@dates) {"
NSQ_SOURCE_LINE 00000576 "        my ($y,$m,$d,$h,$mn,$s) = Date::Manip::UnixDate($_, @a);"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "        my $e = Date_SecsSince1970GMT($m,$d,$y,$h,$mn,$s);"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "        $self->debug(\"Date to epochs ($_) => ($e)\");"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "        push @epochs, $e;"
NSQ_SOURCE_LINE 00000583 "    }"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "    # Clean out all but the one previous to now if we are doing an"
NSQ_SOURCE_LINE 00000586 "    # initial occurance"
NSQ_SOURCE_LINE 00000587 "    my $now = time;"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "    if ($initial) {"
NSQ_SOURCE_LINE 00000590 "        my $before = '';"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "        while (@epochs && $epochs[0] <= $now) {"
NSQ_SOURCE_LINE 00000593 "            $before = shift @epochs;"
NSQ_SOURCE_LINE 00000594 "        }"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "        if ($before) {"
NSQ_SOURCE_LINE 00000597 "            unshift @epochs, $before;"
NSQ_SOURCE_LINE 00000598 "        }"
NSQ_SOURCE_LINE 00000599 "    }"
NSQ_SOURCE_LINE 00000600 "    else {"
NSQ_SOURCE_LINE 00000601 "        # Clean out dates that occur before now, being careful not to loop"
NSQ_SOURCE_LINE 00000602 "        # forever (thanks James)."
NSQ_SOURCE_LINE 00000603 "        while (@epochs && $epochs[0] <= $now) {"
NSQ_SOURCE_LINE 00000604 "            shift @epochs;"
NSQ_SOURCE_LINE 00000605 "        }"
NSQ_SOURCE_LINE 00000606 "    }"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "    $self->debug(\"Recurrances are at: \". join \"\\n\\t\", @dates);"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "    warn \"No recurrances found! Probably a timezone issue!\\n\" unless @dates;"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "    return @epochs;"
NSQ_SOURCE_LINE 00000613 "}"
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "###########################################################################"
NSQ_SOURCE_LINE 00000616 "#"
NSQ_SOURCE_LINE 00000617 "# Subroutine _get_next_occurance"
NSQ_SOURCE_LINE 00000618 "#"
NSQ_SOURCE_LINE 00000619 "#       Args: Date::Manip occurance pattern"
NSQ_SOURCE_LINE 00000620 "#"
NSQ_SOURCE_LINE 00000621 "#       Rtns: date"
NSQ_SOURCE_LINE 00000622 "#"
NSQ_SOURCE_LINE 00000623 "# We don't want to call Date::Manip::ParseRecur too often as it is very"
NSQ_SOURCE_LINE 00000624 "# expensive. So, we cache what is returned from _gen_occurance()."
NSQ_SOURCE_LINE 00000625 "sub _get_next_occurance {"
NSQ_SOURCE_LINE 00000626 "    my ($self, $pat) = @_;"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "    # (ms) Throw out expired occurances"
NSQ_SOURCE_LINE 00000629 "    my $now = $self->{timer}->();"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "    if (defined $self->{dates}{$pat}) {"
NSQ_SOURCE_LINE 00000632 "        while (@{$self->{dates}{$pat}}) {"
NSQ_SOURCE_LINE 00000633 "            last if $self->{dates}{$pat}->[0] >= $now;"
NSQ_SOURCE_LINE 00000634 "            shift @{$self->{dates}{$pat}};"
NSQ_SOURCE_LINE 00000635 "        }"
NSQ_SOURCE_LINE 00000636 "    }"
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "    # If this is first time then generate some new ones including one"
NSQ_SOURCE_LINE 00000639 "    # before our time to test against the log file"
NSQ_SOURCE_LINE 00000640 "    unless (defined $self->{'dates'}{$pat}) {"
NSQ_SOURCE_LINE 00000641 "        @{$self->{'dates'}{$pat}} = $self->_gen_occurance($pat,1);"
NSQ_SOURCE_LINE 00000642 "    }"
NSQ_SOURCE_LINE 00000643 "    elsif (scalar(@{$self->{'dates'}{$pat}}) < 2) {"
NSQ_SOURCE_LINE 00000644 "        # close to the end of what we have"
NSQ_SOURCE_LINE 00000645 "        @{$self->{'dates'}{$pat}} = $self->_gen_occurance($pat);"
NSQ_SOURCE_LINE 00000646 "    }"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "    return shift @{$self->{'dates'}{$pat}};"
NSQ_SOURCE_LINE 00000649 "}"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "sub debug {"
NSQ_SOURCE_LINE 00000653 "    my ($self, $message) = @_;"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "    return unless $self->{debug};"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "    warn localtime() . \" $$ $message\\n\";"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "    return;"
NSQ_SOURCE_LINE 00000660 "}"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "sub error {"
NSQ_SOURCE_LINE 00000663 "    my ($self, $message) = @_;"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "    chomp $message;"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "    warn \"$$ \" . __PACKAGE__ . \" $message\\n\";"
NSQ_SOURCE_LINE 00000668 "}"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "1;"
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "__END__"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "=pod"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "=head1 NAME"
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "Log::Dispatch::FileRotate - Log to Files that Archive/Rotate Themselves"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "=head1 VERSION"
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "version 1.38"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "  use Log::Dispatch::FileRotate;"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "  my $logger = Log::Dispatch::FileRotate->new("
NSQ_SOURCE_LINE 00000691 "      name      => 'file1',"
NSQ_SOURCE_LINE 00000692 "      min_level => 'info',"
NSQ_SOURCE_LINE 00000693 "      filename  => 'Somefile.log',"
NSQ_SOURCE_LINE 00000694 "      mode      => 'append' ,"
NSQ_SOURCE_LINE 00000695 "      size      => 10*1024*1024,"
NSQ_SOURCE_LINE 00000696 "      max       => 6);"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "  # or for a time based rotation"
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "  my $logger = Log::Dispatch::FileRotate->new("
NSQ_SOURCE_LINE 00000701 "      name      => 'file1',"
NSQ_SOURCE_LINE 00000702 "      min_level => 'info',"
NSQ_SOURCE_LINE 00000703 "      filename  => 'Somefile.log',"
NSQ_SOURCE_LINE 00000704 "      mode      => 'append' ,"
NSQ_SOURCE_LINE 00000705 "      TZ        => 'AEDT',"
NSQ_SOURCE_LINE 00000706 "      DatePattern => 'yyyy-dd-HH');"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "  # and attach to Log::Dispatch"
NSQ_SOURCE_LINE 00000709 "  my $dispatcher = Log::Dispatch->new;"
NSQ_SOURCE_LINE 00000710 "  $dispatcher->add($logger);"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "  $dispatcher->log( level => 'info', message => \"your comment\\n\" );"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "This module extends the base class L<Log::Dispatch::Output> to provides a"
NSQ_SOURCE_LINE 00000717 "simple object for logging to files under the Log::Dispatch::* system, and"
NSQ_SOURCE_LINE 00000718 "automatically rotating them according to different constraints. This is"
NSQ_SOURCE_LINE 00000719 "basically a L<Log::Dispatch::File> wrapper with additions."
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "=head2 Rotation"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "There are three different constraints which decide when a file must be"
NSQ_SOURCE_LINE 00000724 "rotated."
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "The first is by size: when the log file grows more than a specified"
NSQ_SOURCE_LINE 00000727 "size, then it's rotated."
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "The second constraint is with occurrences. If a L</DatePattern> is defined, a"
NSQ_SOURCE_LINE 00000730 "file rotation ignores size constraint (unless C<check_both>) and uses the"
NSQ_SOURCE_LINE 00000731 "defined date pattern constraints. When using L</DatePattern> make sure TZ is"
NSQ_SOURCE_LINE 00000732 "defined correctly and that the TZ you use is understood by Date::Manip. We use"
NSQ_SOURCE_LINE 00000733 "Date::Manip to generate our recurrences. Bad TZ equals bad recurrences equals"
NSQ_SOURCE_LINE 00000734 "surprises! Read the L<Date::Manip> man page for more details on"
NSQ_SOURCE_LINE 00000735 "TZ. L</DatePattern> will default to a daily rotate if your entered pattern is"
NSQ_SOURCE_LINE 00000736 "incorrect. You will also get a warning message."
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "You can also check both constraints together by using the C<check_both>"
NSQ_SOURCE_LINE 00000739 "parameter."
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "The latter constraint is a user callback. This function is called outside the"
NSQ_SOURCE_LINE 00000742 "restricted area (see L</Concurrency>) and,"
NSQ_SOURCE_LINE 00000743 "if it returns a true value, a rotation will happen unconditionally."
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "All check are made before logging. The C<rotate> method leaves us check these"
NSQ_SOURCE_LINE 00000746 "constraints without logging anything."
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "To let more power at the user, a C<post_rotate> callback it'll call after every"
NSQ_SOURCE_LINE 00000749 "rotation."
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "=head2 Concurrency"
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "Multiple writers are allowed by this module. There is a restricted area where"
NSQ_SOURCE_LINE 00000754 "only one writer can be inside. This is done by using an external lock file,"
NSQ_SOURCE_LINE 00000755 "which name is \"C<.filename.LCK>\" (never deleted)."
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "The user constraint and the L</DatePattern> constraint are checked outside this"
NSQ_SOURCE_LINE 00000758 "restricted area. So, when you write a callback, don't rely on the logging"
NSQ_SOURCE_LINE 00000759 "file because it can disappear under your feet."
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "Within this restricted area we:"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "=over 4"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "=item *"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "check the size constraint"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "=item *"
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "eventually rotate the log file"
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "=item *"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "if it's defined, call the C<post_rotate> function"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "=item *"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "write the log message"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "=back"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "=head1 METHODS"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "=head2 new(%p)"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "The constructor takes the following parameters in addition to parameters"
NSQ_SOURCE_LINE 00000788 "documented in L<Log::Dispatch::File>:"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "=over 4"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "=item max ($)"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "The maximum number of log files to create. Default 1."
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "=item size ($)"
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 "The maximum (or close to) size the log file can grow too. Default 10M."
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "=item DatePattern ($)"
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "The L</DatePattern> as defined above."
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "=item TZ ($)"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "The TimeZone time based calculations should be done in. This should match"
NSQ_SOURCE_LINE 00000807 "L<Date::Manip>'s concept of timezones and of course your machines timezone."
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "=item check_both ($)"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "1 for checking L</DatePattern> and size concurrently, 0 otherwise.  Default 0."
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "=item user_constraint (\\&)"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "If this callback is defined and returns true, a rotation will happen"
NSQ_SOURCE_LINE 00000816 "unconditionally."
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "=item post_rotate (\\&)"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "This callback is called after that all files were rotated. Will be called one"
NSQ_SOURCE_LINE 00000821 "time for every rotated file (in reverse order) with this arguments:"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "=over 4"
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "=item C<filename>"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "the path of the rotated file"
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "=item C<index>"
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "the index of the rotated file from C<max>-1 to 0, in the latter case"
NSQ_SOURCE_LINE 00000832 "C<filename> is the new, empty, log file"
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "=item C<fileRotate>"
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "a object reference to this instance"
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "=back"
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "With this, you can have infinite files renaming each time the rotated file"
NSQ_SOURCE_LINE 00000841 "log. E.g:"
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "  my $file = Log::Dispatch::FileRotate"
NSQ_SOURCE_LINE 00000844 "  ->new("
NSQ_SOURCE_LINE 00000845 "        ..."
NSQ_SOURCE_LINE 00000846 "        post_rotate => sub {"
NSQ_SOURCE_LINE 00000847 "          my ($filename, $idx, $fileRotate) = @_;"
NSQ_SOURCE_LINE 00000848 "          if ($idx == 1) {"
NSQ_SOURCE_LINE 00000849 "            use POSIX qw(strftime);"
NSQ_SOURCE_LINE 00000850 "            my $basename = $fileRotate->filename();"
NSQ_SOURCE_LINE 00000851 "            my $newfilename ="
NSQ_SOURCE_LINE 00000852 "              $basename . '.' . strftime('%Y%m%d%H%M%S', localtime());"
NSQ_SOURCE_LINE 00000853 "            $fileRotate->debug(\"moving $filename to $newfilename\");"
NSQ_SOURCE_LINE 00000854 "            rename($filename, $newfilename);"
NSQ_SOURCE_LINE 00000855 "          }"
NSQ_SOURCE_LINE 00000856 "        },"
NSQ_SOURCE_LINE 00000857 "       );"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "B<Note>: this is called within the restricted area (see L</Concurrency>). This"
NSQ_SOURCE_LINE 00000860 "means that any other concurrent process is locked in the meanwhile. For the"
NSQ_SOURCE_LINE 00000861 "same reason, don't use the C<log()> or C<log_message()> methods because you"
NSQ_SOURCE_LINE 00000862 "will get a deadlock!"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "=item DEBUG ($)"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "Turn on lots of warning messages to STDERR about what this module is"
NSQ_SOURCE_LINE 00000867 "doing if set to 1. Really only useful to me."
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "=back"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "=head2 filename()"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "Returns the log filename."
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "=head2 setDatePattern( $ or [ $, $, ... ] )"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "Set a new suite of recurrances for file rotation. You can pass in a"
NSQ_SOURCE_LINE 00000878 "single string or a reference to an array of strings. Multiple recurrences"
NSQ_SOURCE_LINE 00000879 "can also be define within a single string by seperating them with a"
NSQ_SOURCE_LINE 00000880 "semi-colon (;)"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "See the discussion above regarding the setDatePattern paramater for more"
NSQ_SOURCE_LINE 00000883 "details."
NSQ_SOURCE_LINE 00000884 ""
NSQ_SOURCE_LINE 00000885 "=head2 log_message( message => $ )"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "Sends a message to the appropriate output.  Generally this shouldn't"
NSQ_SOURCE_LINE 00000888 "be called directly but should be called through the C<log()> method"
NSQ_SOURCE_LINE 00000889 "(in L<Log::Dispatch::Output>)."
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "=head2 rotate()"
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "Rotates the file, if it has to be done. You can call this method if you want to"
NSQ_SOURCE_LINE 00000894 "check, and eventually do, a rotation without logging anything."
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "Returns 1 if a rotation was done, 0 otherwise. C<undef> on error."
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "=head2 debug($)"
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "If C<DEBUG> is true, prints a standard warning message."
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "=head1 Tip"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "If you have multiple writers that were started at different times you"
NSQ_SOURCE_LINE 00000905 "will find each writer will try to rotate the log file at a recurrence"
NSQ_SOURCE_LINE 00000906 "calculated from its start time. To sync all the writers just use a config"
NSQ_SOURCE_LINE 00000907 "file and update it after starting your last writer. This will cause"
NSQ_SOURCE_LINE 00000908 "C<new()> to be called by each of the writers"
NSQ_SOURCE_LINE 00000909 "close to the same time, and if your recurrences aren't too close together"
NSQ_SOURCE_LINE 00000910 "all should sync up just nicely."
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "I initially assumed a long running process but it seems people are using"
NSQ_SOURCE_LINE 00000913 "this module as part of short running CGI programs. So, now we look at the"
NSQ_SOURCE_LINE 00000914 "last modified time stamp of the log file and compare it to a previous"
NSQ_SOURCE_LINE 00000915 "occurance of a L</DatePattern>, on startup only. If the file stat shows"
NSQ_SOURCE_LINE 00000916 "the mtime to be earlier than the previous recurrance then I rotate the"
NSQ_SOURCE_LINE 00000917 "log file."
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "=head1 DatePattern"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "As I said earlier we use L<Date::Manip> for generating our recurrence"
NSQ_SOURCE_LINE 00000922 "events. This means we can understand L<Date::Manip>'s recurrence patterns"
NSQ_SOURCE_LINE 00000923 "and the normal log4j DatePatterns. We don't use DatePattern to define the"
NSQ_SOURCE_LINE 00000924 "extension of the log file though."
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "DatePattern can therefore take forms like:"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "      Date::Manip style"
NSQ_SOURCE_LINE 00000929 "            0:0:0:0:5:30:0       every 5 hours and 30 minutes"
NSQ_SOURCE_LINE 00000930 "            0:0:0:2*12:30:0      every 2 days at 12:30 (each day)"
NSQ_SOURCE_LINE 00000931 "            3*1:0:2:12:0:0       every 3 years on Jan 2 at noon"
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "      DailyRollingFileAppender log4j style"
NSQ_SOURCE_LINE 00000934 "            yyyy-MM              every month"
NSQ_SOURCE_LINE 00000935 "            yyyy-ww              every week"
NSQ_SOURCE_LINE 00000936 "            yyyy-MM-dd           every day"
NSQ_SOURCE_LINE 00000937 "            yyyy-MM-dd-a         every day at noon"
NSQ_SOURCE_LINE 00000938 "            yyyy-MM-dd-HH        every hour"
NSQ_SOURCE_LINE 00000939 "            yyyy-MM-dd-HH-MM     every minute"
NSQ_SOURCE_LINE 00000940 ""
NSQ_SOURCE_LINE 00000941 "To specify multiple recurrences in a single string separate them with a"
NSQ_SOURCE_LINE 00000942 "semicolon:"
NSQ_SOURCE_LINE 00000943 "        yyyy-MM-dd; 0:0:0:2*12:30:0"
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 "This says we want to rotate every day AND every 2 days at 12:30. Put in"
NSQ_SOURCE_LINE 00000946 "as many as you like."
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "A complete description of L<Date::Manip> recurrences is beyond us here"
NSQ_SOURCE_LINE 00000949 "except to quote (from the man page):"
NSQ_SOURCE_LINE 00000950 ""
NSQ_SOURCE_LINE 00000951 "           A recur description is a string of the format"
NSQ_SOURCE_LINE 00000952 "           Y:M:W:D:H:MN:S .  Exactly one of the colons may"
NSQ_SOURCE_LINE 00000953 "           optionally be replaced by an asterisk, or an asterisk"
NSQ_SOURCE_LINE 00000954 "           may be prepended to the string."
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "           Any value \"N\" to the left of the asterisk refers to"
NSQ_SOURCE_LINE 00000957 "           the \"Nth\" one.  Any value to the right of the asterisk"
NSQ_SOURCE_LINE 00000958 "           refers to a value as it appears on a calendar/clock."
NSQ_SOURCE_LINE 00000959 "           Values to the right can be listed a single values,"
NSQ_SOURCE_LINE 00000960 "           ranges (2 numbers separated by a dash \"-\"), or a comma"
NSQ_SOURCE_LINE 00000961 "           separated list of values or ranges.  In a few cases,"
NSQ_SOURCE_LINE 00000962 "           negative values are appropriate."
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "           This is best illustrated by example."
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "             0:0:2:1:0:0:0        every 2 weeks and 1 day"
NSQ_SOURCE_LINE 00000967 "             0:0:0:0:5:30:0       every 5 hours and 30 minutes"
NSQ_SOURCE_LINE 00000968 "             0:0:0:2*12:30:0      every 2 days at 12:30 (each day)"
NSQ_SOURCE_LINE 00000969 "             3*1:0:2:12:0:0       every 3 years on Jan 2 at noon"
NSQ_SOURCE_LINE 00000970 "             0:1*0:2:12,14:0:0    2nd of every month at 12:00 and 14:00"
NSQ_SOURCE_LINE 00000971 "             1:0:0*45:0:0:0       45th day of every year"
NSQ_SOURCE_LINE 00000972 "             0:1*4:2:0:0:0        4th tuesday (day 2) of every month"
NSQ_SOURCE_LINE 00000973 "             0:1*-1:2:0:0:0       last tuesday of every month"
NSQ_SOURCE_LINE 00000974 "             0:1:0*-2:0:0:0       2nd to last day of every month"
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "=head1 TODO"
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 "compression, signal based rotates, proper test suite"
NSQ_SOURCE_LINE 00000979 ""
NSQ_SOURCE_LINE 00000980 "Could possibly use L<Logfile::Rotate> as well/instead."
NSQ_SOURCE_LINE 00000981 ""
NSQ_SOURCE_LINE 00000982 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "=over 4"
NSQ_SOURCE_LINE 00000985 ""
NSQ_SOURCE_LINE 00000986 "=item *"
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 "L<Log::Dispatch::File::Stamped>"
NSQ_SOURCE_LINE 00000989 ""
NSQ_SOURCE_LINE 00000990 "Log directly to timestamped files."
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "=back"
NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "=head1 HISTORY"
NSQ_SOURCE_LINE 00000995 ""
