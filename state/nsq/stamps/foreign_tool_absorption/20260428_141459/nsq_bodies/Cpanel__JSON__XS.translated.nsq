NSQ_SOURCE_LINE 00000001 "package Cpanel::JSON::XS;"
NSQ_SOURCE_LINE 00000002 "our $VERSION = '4.40';"
NSQ_SOURCE_LINE 00000003 "our $XS_VERSION = $VERSION;"
NSQ_SOURCE_LINE 00000004 "# $VERSION = eval $VERSION;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "=pod"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "=head1 NAME"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "Cpanel::JSON::XS - cPanel fork of JSON::XS, fast and correct serializing"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 " use Cpanel::JSON::XS;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 " # exported functions, they croak on error"
NSQ_SOURCE_LINE 00000017 " # and expect/generate UTF-8"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 " $utf8_encoded_json_text = encode_json $perl_hash_or_arrayref;"
NSQ_SOURCE_LINE 00000020 " $perl_hash_or_arrayref  = decode_json $utf8_encoded_json_text;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 " # OO-interface"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 " $coder = Cpanel::JSON::XS->new->ascii->pretty->allow_nonref;"
NSQ_SOURCE_LINE 00000025 " $pretty_printed_unencoded = $coder->encode ($perl_scalar);"
NSQ_SOURCE_LINE 00000026 " $perl_scalar = $coder->decode ($unicode_json_text);"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 " # Note that 5.6 misses most smart utf8 and encoding functionalities"
NSQ_SOURCE_LINE 00000029 " # of newer releases."
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 " # Note that L<JSON::MaybeXS> will automatically use Cpanel::JSON::XS"
NSQ_SOURCE_LINE 00000032 " # if available, at virtually no speed overhead either, so you should"
NSQ_SOURCE_LINE 00000033 " # be able to just:"
NSQ_SOURCE_LINE 00000034 " "
NSQ_SOURCE_LINE 00000035 " use JSON::MaybeXS;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 " # and do the same things, except that you have a pure-perl fallback now."
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 " Note that this module will be replaced by a new JSON::Safe module soon,"
NSQ_SOURCE_LINE 00000040 " with the same API just guaranteed safe defaults."
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "This module converts Perl data structures to JSON and vice versa. Its"
NSQ_SOURCE_LINE 00000045 "primary goal is to be I<correct> and its secondary goal is to be"
NSQ_SOURCE_LINE 00000046 "I<fast>. To reach the latter goal it was written in C."
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "As this is the n-th-something JSON module on CPAN, what was the reason"
NSQ_SOURCE_LINE 00000049 "to write yet another JSON module? While it seems there are many JSON"
NSQ_SOURCE_LINE 00000050 "modules, none of them correctly handle all corner cases, and in most cases"
NSQ_SOURCE_LINE 00000051 "their maintainers are unresponsive, gone missing, or not listening to bug"
NSQ_SOURCE_LINE 00000052 "reports for other reasons."
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "See below for the cPanel fork."
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "See MAPPING, below, on how Cpanel::JSON::XS maps perl values to JSON"
NSQ_SOURCE_LINE 00000057 "values and vice versa."
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=head2 FEATURES"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=over 4"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=item * correct Unicode handling"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "This module knows how to handle Unicode with Perl version higher than 5.8.5,"
NSQ_SOURCE_LINE 00000066 "documents how and when it does so, and even documents what \"correct\" means."
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=item * round-trip integrity"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "When you serialize a perl data structure using only data types supported"
NSQ_SOURCE_LINE 00000071 "by JSON and Perl, the deserialized data structure is identical on the Perl"
NSQ_SOURCE_LINE 00000072 "level. (e.g. the string \"2.0\" doesn't suddenly become \"2\" just because"
NSQ_SOURCE_LINE 00000073 "it looks like a number). There I<are> minor exceptions to this, read the"
NSQ_SOURCE_LINE 00000074 "MAPPING section below to learn about those."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=item * strict checking of JSON correctness"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "There is no guessing, no generating of illegal JSON texts by default,"
NSQ_SOURCE_LINE 00000079 "and only JSON is accepted as input by default. the latter is a security"
NSQ_SOURCE_LINE 00000080 "feature."
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=item * fast"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "Compared to other JSON modules and other serializers such as Storable,"
NSQ_SOURCE_LINE 00000085 "this module usually compares favourably in terms of speed, too."
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "=item * simple to use"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "This module has both a simple functional interface as well as an object"
NSQ_SOURCE_LINE 00000090 "oriented interface."
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=item * reasonably versatile output formats"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "You can choose between the most compact guaranteed-single-line format"
NSQ_SOURCE_LINE 00000095 "possible (nice for simple line-based protocols), a pure-ASCII format"
NSQ_SOURCE_LINE 00000096 "(for when your transport is not 8-bit clean, still supports the whole"
NSQ_SOURCE_LINE 00000097 "Unicode range), or a pretty-printed format (for when you want to read that"
NSQ_SOURCE_LINE 00000098 "stuff). Or you can combine those features in whatever way you like."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=back"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head2 cPanel fork"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "Since the original author MLEHMANN has no public"
NSQ_SOURCE_LINE 00000105 "bugtracker, this cPanel fork sits now on github."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "src repo: L<https://github.com/rurban/Cpanel-JSON-XS>"
NSQ_SOURCE_LINE 00000108 "original: L<http://cvs.schmorp.de/JSON-XS/>"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "RT:       L<https://github.com/rurban/Cpanel-JSON-XS/issues>"
NSQ_SOURCE_LINE 00000111 "or        L<https://rt.cpan.org/Public/Dist/Display.html?Queue=Cpanel-JSON-XS>"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "B<Changes to JSON::XS>"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "- bare hashkeys are now checked for utf8. (GH #209)"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "- stricter decode_json() as documented. non-refs are disallowed."
NSQ_SOURCE_LINE 00000118 "  safe by default."
NSQ_SOURCE_LINE 00000119 "  added a 2nd optional argument. decode() honors now allow_nonref."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "- fixed encode of numbers for dual-vars. Different string"
NSQ_SOURCE_LINE 00000122 "  representations are preserved, but numbers with temporary strings"
NSQ_SOURCE_LINE 00000123 "  which represent the same number are here treated as numbers, not"
NSQ_SOURCE_LINE 00000124 "  strings. Cpanel::JSON::XS is a bit slower, but preserves numeric"
NSQ_SOURCE_LINE 00000125 "  types better."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "- numbers ending with .0 stray numbers, are not converted to"
NSQ_SOURCE_LINE 00000128 "  integers. [#63] dual-vars which are represented as number not"
NSQ_SOURCE_LINE 00000129 "  integer (42+\"bar\" != 5.8.9) are now encoded as number (=> 42.0)"
NSQ_SOURCE_LINE 00000130 "  because internally it's now a NOK type.  However !!1 which is"
NSQ_SOURCE_LINE 00000131 "  wrongly encoded in 5.8 as \"1\"/1.0 is still represented as integer."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "- different handling of inf/nan. Default now to null, optionally with"
NSQ_SOURCE_LINE 00000134 "  stringify_infnan() to \"inf\"/\"nan\". [#28, #32]"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "- added C<binary> extension, non-JSON and non JSON parsable, allows"
NSQ_SOURCE_LINE 00000137 "  C<\\xNN> and C<\\NNN> sequences."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "- 5.6.2 support; sacrificing some utf8 features (assuming bytes"
NSQ_SOURCE_LINE 00000140 "  all-over), no multi-byte unicode characters with 5.6."
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "- interop for true/false overloading. JSON::XS, JSON::PP and Mojo::JSON "
NSQ_SOURCE_LINE 00000143 "  representations for booleans are accepted and JSON::XS accepts"
NSQ_SOURCE_LINE 00000144 "  Cpanel::JSON::XS booleans [#13, #37]"
NSQ_SOURCE_LINE 00000145 "  Fixed overloading of booleans. Cpanel::JSON::XS::true stringifies again"
NSQ_SOURCE_LINE 00000146 "  to \"1\", not \"true\", analog to all other JSON modules."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "- native boolean mapping of yes and no to true and false, as in YAML::XS."
NSQ_SOURCE_LINE 00000149 "  In perl C<!0> is yes, C<!1> is no."
NSQ_SOURCE_LINE 00000150 "  The JSON value true maps to 1, false maps to 0. [#39]"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "- support arbitrary stringification with encode, with convert_blessed"
NSQ_SOURCE_LINE 00000153 "  and allow_blessed."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "- ithread support. Cpanel::JSON::XS is thread-safe, JSON::XS not"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "- is_bool can be called as method, JSON::XS::is_bool not."
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "- performance optimizations for threaded Perls"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "- relaxed mode, allowing many popular extensions"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "- protect our magic object from corruption by wrong or missing external"
NSQ_SOURCE_LINE 00000164 "  methods, like FREEZE/THAW or serialization with other methods."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "- additional fixes for:"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "  - #208 - no security-relevant out-of-bounds reading of module memory"
NSQ_SOURCE_LINE 00000169 "    when decoding hash keys without ending ':'"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "  - [cpan #88061] AIX atof without USE_LONG_DOUBLE"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "  - #10 unshare_hek crash"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "  - #7, #29 avoid re-blessing where possible. It fails in JSON::XS for"
NSQ_SOURCE_LINE 00000176 "   READONLY values, i.e. restricted hashes."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "  - #41 overloading of booleans, use the object not the reference."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "  - #62 -Dusequadmath conversion and no SEGV."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "  - #72 parsing of values followed \\0, like 1\\0 does fail."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "  - #72 parsing of illegal unicode or non-unicode characters."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "  - #96 locale-insensitive numeric conversion."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "  - #154 numeric conversion fixed since 5.22, using the same strtold as perl5."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "  - #167 sort tied hashes with canonical."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "  - #212 fix utf8 object stringification"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "- public maintenance and bugtracker"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "- use ppport.h, sanify XS.xs comment styles, harness C coding style"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "- common::sense is optional. When available it is not used in the"
NSQ_SOURCE_LINE 00000199 "  published production module, just during development and testing."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "- extended testsuite, passes all http://seriot.ch/projects/parsing_json.html"
NSQ_SOURCE_LINE 00000202 "  tests.  In fact it is the only know JSON decoder which does so,"
NSQ_SOURCE_LINE 00000203 "  while also being the fastest."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "- support many more options and methods from JSON::PP:"
NSQ_SOURCE_LINE 00000206 "  stringify_infnan, allow_unknown, allow_stringify, allow_barekey,"
NSQ_SOURCE_LINE 00000207 "  encode_stringify, allow_bignum, allow_singlequote, dupkeys_as_arrayref,"
NSQ_SOURCE_LINE 00000208 "  sort_by (partially), escape_slash, convert_blessed, ..."
NSQ_SOURCE_LINE 00000209 "  optional decode_json(, allow_nonref) arg."
NSQ_SOURCE_LINE 00000210 "  relaxed implements allow_dupkeys."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "- support all 5 unicode L<BOM|/BOM>'s: UTF-8, UTF-16LE, UTF-16BE, UTF-32LE,"
NSQ_SOURCE_LINE 00000213 "  UTF-32BE, encoding internally to UTF-8."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=cut"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000218 "our @EXPORT = qw(encode_json decode_json to_json from_json);"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "sub to_json($@) {"
NSQ_SOURCE_LINE 00000221 "   if ($] >= 5.008) {"
NSQ_SOURCE_LINE 00000222 "     require Carp;"
NSQ_SOURCE_LINE 00000223 "     Carp::croak (\"Cpanel::JSON::XS::to_json has been renamed to encode_json,\"."
NSQ_SOURCE_LINE 00000224 "                  \" either downgrade to pre-2.0 versions of Cpanel::JSON::XS or\"."
NSQ_SOURCE_LINE 00000225 "                  \" rename the call\");"
NSQ_SOURCE_LINE 00000226 "   } else {"
NSQ_SOURCE_LINE 00000227 "     _to_json(@_);"
NSQ_SOURCE_LINE 00000228 "   }"
NSQ_SOURCE_LINE 00000229 "}"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "sub from_json($@) {"
NSQ_SOURCE_LINE 00000232 "   if ($] >= 5.008) {"
NSQ_SOURCE_LINE 00000233 "     require Carp;"
NSQ_SOURCE_LINE 00000234 "     Carp::croak (\"Cpanel::JSON::XS::from_json has been renamed to decode_json,\"."
NSQ_SOURCE_LINE 00000235 "                  \" either downgrade to pre-2.0 versions of Cpanel::JSON::XS or\"."
NSQ_SOURCE_LINE 00000236 "                  \" rename the call\");"
NSQ_SOURCE_LINE 00000237 "   } else {"
NSQ_SOURCE_LINE 00000238 "     _from_json(@_);"
NSQ_SOURCE_LINE 00000239 "   }"
NSQ_SOURCE_LINE 00000240 "}"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "use Exporter;"
NSQ_SOURCE_LINE 00000243 "use XSLoader;"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=head1 FUNCTIONAL INTERFACE"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "The following convenience methods are provided by this module. They are"
NSQ_SOURCE_LINE 00000248 "exported by default:"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=over 4"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=item $json_text = encode_json $perl_scalar, [json_type]"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "Converts the given Perl data structure to a UTF-8 encoded, binary string"
NSQ_SOURCE_LINE 00000255 "(that is, the string contains octets only). Croaks on error."
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "This function call is functionally identical to:"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "   $json_text = Cpanel::JSON::XS->new->utf8->encode ($perl_scalar, $json_type)"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "Except being faster."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "For the type argument see L<Cpanel::JSON::XS::Type>."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=item $perl_scalar = decode_json $json_text [, $allow_nonref [, my $json_type ] ]"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "The opposite of C<encode_json>: expects an UTF-8 (binary) string of an"
NSQ_SOURCE_LINE 00000268 "json reference and tries to parse that as an UTF-8 encoded JSON text,"
NSQ_SOURCE_LINE 00000269 "returning the resulting reference. Croaks on error."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "This function call is functionally identical to:"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "   $perl_scalar = Cpanel::JSON::XS->new->utf8->decode ($json_text, $json_type)"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "except being faster."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "Note that older decode_json versions in Cpanel::JSON::XS older than"
NSQ_SOURCE_LINE 00000278 "3.0116 and JSON::XS did not set allow_nonref but allowed them due to a"
NSQ_SOURCE_LINE 00000279 "bug in the decoder."
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "If the new 2nd optional $allow_nonref argument is set and not false, the"
NSQ_SOURCE_LINE 00000282 "C<allow_nonref> option will be set and the function will act is described"
NSQ_SOURCE_LINE 00000283 "as in the relaxed RFC 7159 allowing all values such as objects,"
NSQ_SOURCE_LINE 00000284 "arrays, strings, numbers, \"null\", \"true\", and \"false\"."
NSQ_SOURCE_LINE 00000285 "See L</\"OLD\" VS. \"NEW\" JSON (RFC 4627 VS. RFC 7159)> below, why you don't"
NSQ_SOURCE_LINE 00000286 "want to do that."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "For the 3rd optional type argument see L<Cpanel::JSON::XS::Type>."
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=item $is_boolean = Cpanel::JSON::XS::is_bool $scalar"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "Returns true if the passed scalar represents either C<JSON::PP::true>"
NSQ_SOURCE_LINE 00000293 "or C<JSON::PP::false>, two constants that act like C<1> and C<0>,"
NSQ_SOURCE_LINE 00000294 "respectively and are used to represent JSON C<true> and C<false>"
NSQ_SOURCE_LINE 00000295 "values in Perl. (Also recognizes the booleans produced by L<JSON::XS>.)"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "See MAPPING, below, for more information on how JSON values are mapped"
NSQ_SOURCE_LINE 00000298 "to Perl."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=back"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=head1 DEPRECATED FUNCTIONS"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=over"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=item from_json"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "from_json has been renamed to decode_json"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=item to_json"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "to_json has been renamed to encode_json"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=back"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=head1 A FEW NOTES ON UNICODE AND PERL"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "Since this often leads to confusion, here are a few very clear words on"
NSQ_SOURCE_LINE 00000320 "how Unicode works in Perl, modulo bugs."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=over 4"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=item 1. Perl strings can store characters with ordinal values > 255."
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "This enables you to store Unicode characters as single characters in a"
NSQ_SOURCE_LINE 00000327 "Perl string - very natural."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=item 2. Perl does I<not> associate an encoding with your strings."
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "... until you force it to, e.g. when matching it against a regex, or"
NSQ_SOURCE_LINE 00000332 "printing the scalar to a file, in which case Perl either interprets"
NSQ_SOURCE_LINE 00000333 "your string as locale-encoded text, octets/binary, or as Unicode,"
NSQ_SOURCE_LINE 00000334 "depending on various settings. In no case is an encoding stored"
NSQ_SOURCE_LINE 00000335 "together with your data, it is I<use> that decides encoding, not any"
NSQ_SOURCE_LINE 00000336 "magical meta data."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=item 3. The internal utf-8 flag has no meaning with regards to the"
NSQ_SOURCE_LINE 00000339 "encoding of your string."
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "=item 4. A \"Unicode String\" is simply a string where each character"
NSQ_SOURCE_LINE 00000342 "can be validly interpreted as a Unicode code point."
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "If you have UTF-8 encoded data, it is no longer a Unicode string, but"
NSQ_SOURCE_LINE 00000345 "a Unicode string encoded in UTF-8, giving you a binary string."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=item 5. A string containing \"high\" (> 255) character values is I<not>"
NSQ_SOURCE_LINE 00000348 "a UTF-8 string."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "=item 6. Raw non-Unicode characters below U+10FFFF are allowed."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "The 66 Unicode noncharacters U+FDD0..U+FDEF, and U+*FFFE, U+*FFFF are"
NSQ_SOURCE_LINE 00000353 "allowed without warning, as JSON::PP does, see"
NSQ_SOURCE_LINE 00000354 "L<http://www.unicode.org/versions/corrigendum9.html>.  But illegal"
NSQ_SOURCE_LINE 00000355 "surrogate pairs fail to parse."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=item 7. Raw non-Unicode characters above U+10FFFF are disallowed."
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "Raw non-Unicode characters outside the valid unicode range fail to"
NSQ_SOURCE_LINE 00000360 "parse, because \"A string is a sequence of zero or more Unicode"
NSQ_SOURCE_LINE 00000361 "characters\" RFC 7159 section 1 and \"JSON text SHALL be encoded in"
NSQ_SOURCE_LINE 00000362 "Unicode RFC 7159 section 8.1. We use now the UTF8_DISALLOW_SUPER"
NSQ_SOURCE_LINE 00000363 "flag when parsing unicode."
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "=item 8. Lone surrogates or illegal surrogate pairs are disallowed."
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "Since RFC 3629, U+D800 through U+DFFF are not legal Unicode values and"
NSQ_SOURCE_LINE 00000368 "their UTF-8 encodings must be treated as an invalid byte sequence."
NSQ_SOURCE_LINE 00000369 "RFC 8259 section 8.2 admits the spec allows string values that contain"
NSQ_SOURCE_LINE 00000370 "bit sequences that cannot encode Unicode characters and that the"
NSQ_SOURCE_LINE 00000371 "behavior of software that receives such values is unpredictable. To"
NSQ_SOURCE_LINE 00000372 "avoid introducing non-Unicode strings into Perl we use the"
NSQ_SOURCE_LINE 00000373 "UTF8_DISALLOW_SURROGATE flag when parsing Unicode and verify escaped"
NSQ_SOURCE_LINE 00000374 "surrogates form valid pairs."
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "=back"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "I hope this helps :)"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=head1 OBJECT-ORIENTED INTERFACE"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "The object oriented interface lets you configure your own encoding or"
NSQ_SOURCE_LINE 00000384 "decoding style, within the limits of supported formats."
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "=over 4"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "=item $json = new Cpanel::JSON::XS"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "Creates a new JSON object that can be used to de/encode JSON"
NSQ_SOURCE_LINE 00000391 "strings. All boolean flags described below are by default I<disabled>."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "The mutators for flags all return the JSON object again and thus calls can"
NSQ_SOURCE_LINE 00000394 "be chained:"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "   my $json = Cpanel::JSON::XS->new->utf8->space_after->encode ({a => [1,2]})"
NSQ_SOURCE_LINE 00000397 "   => {\"a\": [1, 2]}"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=item $json = $json->ascii ([$enable])"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=item $enabled = $json->get_ascii"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "If C<$enable> is true (or missing), then the C<encode> method will not"
NSQ_SOURCE_LINE 00000404 "generate characters outside the code range C<0..127> (which is ASCII). Any"
NSQ_SOURCE_LINE 00000405 "Unicode characters outside that range will be escaped using either a"
NSQ_SOURCE_LINE 00000406 "single C<\\uXXXX> (BMP characters) or a double C<\\uHHHH\\uLLLLL> escape sequence,"
NSQ_SOURCE_LINE 00000407 "as per RFC4627. The resulting encoded JSON text can be treated as a native"
NSQ_SOURCE_LINE 00000408 "Unicode string, an ascii-encoded, latin1-encoded or UTF-8 encoded string,"
NSQ_SOURCE_LINE 00000409 "or any other superset of ASCII."
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "If C<$enable> is false, then the C<encode> method will not escape Unicode"
NSQ_SOURCE_LINE 00000412 "characters unless required by the JSON syntax or other flags. This results"
NSQ_SOURCE_LINE 00000413 "in a faster and more compact format."
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "See also the section I<ENCODING/CODESET FLAG NOTES> later in this"
NSQ_SOURCE_LINE 00000416 "document."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "The main use for this flag is to produce JSON texts that can be"
NSQ_SOURCE_LINE 00000419 "transmitted over a 7-bit channel, as the encoded JSON texts will not"
NSQ_SOURCE_LINE 00000420 "contain any 8 bit characters."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "  Cpanel::JSON::XS->new->ascii (1)->encode ([chr 0x10401])"
NSQ_SOURCE_LINE 00000423 "  => [\"\\ud801\\udc01\"]"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "=item $json = $json->latin1 ([$enable])"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "=item $enabled = $json->get_latin1"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "If C<$enable> is true (or missing), then the C<encode> method will encode"
NSQ_SOURCE_LINE 00000430 "the resulting JSON text as latin1 (or ISO-8859-1), escaping any characters"
NSQ_SOURCE_LINE 00000431 "outside the code range C<0..255>. The resulting string can be treated as a"
NSQ_SOURCE_LINE 00000432 "latin1-encoded JSON text or a native Unicode string. The C<decode> method"
NSQ_SOURCE_LINE 00000433 "will not be affected in any way by this flag, as C<decode> by default"
NSQ_SOURCE_LINE 00000434 "expects Unicode, which is a strict superset of latin1."
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "If C<$enable> is false, then the C<encode> method will not escape Unicode"
NSQ_SOURCE_LINE 00000437 "characters unless required by the JSON syntax or other flags."
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "See also the section I<ENCODING/CODESET FLAG NOTES> later in this"
NSQ_SOURCE_LINE 00000440 "document."
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "The main use for this flag is efficiently encoding binary data as JSON"
NSQ_SOURCE_LINE 00000443 "text, as most octets will not be escaped, resulting in a smaller encoded"
NSQ_SOURCE_LINE 00000444 "size. The disadvantage is that the resulting JSON text is encoded"
NSQ_SOURCE_LINE 00000445 "in latin1 (and must correctly be treated as such when storing and"
NSQ_SOURCE_LINE 00000446 "transferring), a rare encoding for JSON. It is therefore most useful when"
NSQ_SOURCE_LINE 00000447 "you want to store data structures known to contain binary data efficiently"
NSQ_SOURCE_LINE 00000448 "in files or databases, not when talking to other JSON encoders/decoders."
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "  Cpanel::JSON::XS->new->latin1->encode ([\"\\x{89}\\x{abc}\"]"
NSQ_SOURCE_LINE 00000451 "  => [\"\\x{89}\\\\u0abc\"]    # (perl syntax, U+abc escaped, U+89 not)"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "=item $json = $json->binary ([$enable])"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "=item $enabled = $json = $json->get_binary"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "If the C<$enable> argument is true (or missing), then the C<encode>"
NSQ_SOURCE_LINE 00000459 "method will not try to detect an UTF-8 encoding in any JSON string, it"
NSQ_SOURCE_LINE 00000460 "will strictly interpret it as byte sequence.  The result might contain"
NSQ_SOURCE_LINE 00000461 "new C<\\xNN> sequences, which is B<unparsable JSON>.  The C<decode>"
NSQ_SOURCE_LINE 00000462 "method forbids C<\\uNNNN> sequences and accepts C<\\xNN> and octal"
NSQ_SOURCE_LINE 00000463 "C<\\NNN> sequences."
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "There is also a special logic for perl 5.6 and utf8. 5.6 encodes any"
NSQ_SOURCE_LINE 00000466 "string to utf-8 automatically when seeing a codepoint >= C<0x80> and"
NSQ_SOURCE_LINE 00000467 "< C<0x100>. With the binary flag enabled decode the perl utf8 encoded"
NSQ_SOURCE_LINE 00000468 "string to the original byte encoding and encode this with C<\\xNN>"
NSQ_SOURCE_LINE 00000469 "escapes. This will result to the same encodings as with newer"
NSQ_SOURCE_LINE 00000470 "perls. But note that binary multi-byte codepoints with 5.6 will"
NSQ_SOURCE_LINE 00000471 "result in C<illegal unicode character in binary string> errors,"
NSQ_SOURCE_LINE 00000472 "unlike with newer perls."
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "If C<$enable> is false, then the C<encode> method will smartly try to"
NSQ_SOURCE_LINE 00000475 "detect Unicode characters unless required by the JSON syntax or other"
NSQ_SOURCE_LINE 00000476 "flags and hex and octal sequences are forbidden."
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "See also the section I<ENCODING/CODESET FLAG NOTES> later in this"
NSQ_SOURCE_LINE 00000479 "document."
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "The main use for this flag is to avoid the smart unicode detection and"
NSQ_SOURCE_LINE 00000482 "possible double encoding. The disadvantage is that the resulting JSON"
NSQ_SOURCE_LINE 00000483 "text is encoded in new C<\\xNN> and in latin1 characters and must"
NSQ_SOURCE_LINE 00000484 "correctly be treated as such when storing and transferring, a rare"
NSQ_SOURCE_LINE 00000485 "encoding for JSON. It will produce non-readable JSON strings in the"
NSQ_SOURCE_LINE 00000486 "browser.  It is therefore most useful when you want to store data"
NSQ_SOURCE_LINE 00000487 "structures known to contain binary data efficiently in files or"
NSQ_SOURCE_LINE 00000488 "databases, not when talking to other JSON encoders/decoders.  The"
NSQ_SOURCE_LINE 00000489 "binary decoding method can also be used when an encoder produced a"
NSQ_SOURCE_LINE 00000490 "non-JSON conformant hex or octal encoding C<\\xNN> or C<\\NNN>."
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "  Cpanel::JSON::XS->new->binary->encode ([\"\\x{89}\\x{abc}\"])"
NSQ_SOURCE_LINE 00000493 "  5.6:   Error: malformed or illegal unicode character in binary string"
NSQ_SOURCE_LINE 00000494 "  >=5.8: ['\\x89\\xe0\\xaa\\xbc']"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "  Cpanel::JSON::XS->new->binary->encode ([\"\\x{89}\\x{bc}\"])"
NSQ_SOURCE_LINE 00000497 "  => [\"\\x89\\xbc\"]"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "  Cpanel::JSON::XS->new->binary->decode ([\"\\x89\\ua001\"])"
NSQ_SOURCE_LINE 00000500 "  Error: malformed or illegal unicode character in binary string"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "  Cpanel::JSON::XS->new->decode ([\"\\x89\"])"
NSQ_SOURCE_LINE 00000503 "  Error: illegal hex character in non-binary string"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "=item $json = $json->utf8 ([$enable])"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "=item $enabled = $json->get_utf8"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "If C<$enable> is true (or missing), then the C<encode> method will encode"
NSQ_SOURCE_LINE 00000511 "the JSON result into UTF-8, as required by many protocols, while the"
NSQ_SOURCE_LINE 00000512 "C<decode> method expects to be handled an UTF-8-encoded string.  Please"
NSQ_SOURCE_LINE 00000513 "note that UTF-8-encoded strings do not contain any characters outside the"
NSQ_SOURCE_LINE 00000514 "range C<0..255>, they are thus useful for bytewise/binary I/O. In future"
NSQ_SOURCE_LINE 00000515 "versions, enabling this option might enable autodetection of the UTF-16"
NSQ_SOURCE_LINE 00000516 "and UTF-32 encoding families, as described in RFC4627."
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "If C<$enable> is false, then the C<encode> method will return the JSON"
NSQ_SOURCE_LINE 00000519 "string as a (non-encoded) Unicode string, while C<decode> expects thus a"
NSQ_SOURCE_LINE 00000520 "Unicode string.  Any decoding or encoding (e.g. to UTF-8 or UTF-16) needs"
NSQ_SOURCE_LINE 00000521 "to be done yourself, e.g. using the Encode module."
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "See also the section I<ENCODING/CODESET FLAG NOTES> later in this"
NSQ_SOURCE_LINE 00000524 "document."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "Example, output UTF-16BE-encoded JSON:"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "  use Encode;"
NSQ_SOURCE_LINE 00000529 "  $jsontext = encode \"UTF-16BE\", Cpanel::JSON::XS->new->encode ($object);"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "Example, decode UTF-32LE-encoded JSON:"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "  use Encode;"
NSQ_SOURCE_LINE 00000534 "  $object = Cpanel::JSON::XS->new->decode (decode \"UTF-32LE\", $jsontext);"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "=item $json = $json->pretty ([$enable])"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "This enables (or disables) all of the C<indent>, C<space_before> and"
NSQ_SOURCE_LINE 00000539 "C<space_after> (and in the future possibly more) flags in one call to"
NSQ_SOURCE_LINE 00000540 "generate the most readable (or most compact) form possible."
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "Example, pretty-print some simple structure:"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "   my $json = Cpanel::JSON::XS->new->pretty(1)->encode ({a => [1,2]})"
NSQ_SOURCE_LINE 00000545 "   =>"
NSQ_SOURCE_LINE 00000546 "   {"
NSQ_SOURCE_LINE 00000547 "      \"a\" : ["
NSQ_SOURCE_LINE 00000548 "         1,"
NSQ_SOURCE_LINE 00000549 "         2"
NSQ_SOURCE_LINE 00000550 "      ]"
NSQ_SOURCE_LINE 00000551 "   }"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "=item $json = $json->indent ([$enable])"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "=item $enabled = $json->get_indent"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "If C<$enable> is true (or missing), then the C<encode> method will use"
NSQ_SOURCE_LINE 00000559 "a multiline format as output, putting every array member or"
NSQ_SOURCE_LINE 00000560 "object/hash key-value pair into its own line, indenting them properly."
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "If C<$enable> is false, no newlines or indenting will be produced, and the"
NSQ_SOURCE_LINE 00000563 "resulting JSON text is guaranteed not to contain any C<newlines>."
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "This setting has no effect when decoding JSON texts."
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "=item $json = $json->indent_length([$number_of_spaces])"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "=item $length = $json->get_indent_length()"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "Set the indent length (default C<3>)."
NSQ_SOURCE_LINE 00000572 "This option is only useful when you also enable indent or pretty."
NSQ_SOURCE_LINE 00000573 "The acceptable range is from 0 (no indentation) to 15"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "=item $json = $json->space_before ([$enable])"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "=item $enabled = $json->get_space_before"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "If C<$enable> is true (or missing), then the C<encode> method will add an extra"
NSQ_SOURCE_LINE 00000580 "optional space before the C<:> separating keys from values in JSON objects."
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "If C<$enable> is false, then the C<encode> method will not add any extra"
NSQ_SOURCE_LINE 00000583 "space at those places."
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "This setting has no effect when decoding JSON texts. You will also"
NSQ_SOURCE_LINE 00000586 "most likely combine this setting with C<space_after>."
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "Example, space_before enabled, space_after and indent disabled:"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "   {\"key\" :\"value\"}"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "=item $json = $json->space_after ([$enable])"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "=item $enabled = $json->get_space_after"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "If C<$enable> is true (or missing), then the C<encode> method will add"
NSQ_SOURCE_LINE 00000597 "an extra optional space after the C<:> separating keys from values in"
NSQ_SOURCE_LINE 00000598 "JSON objects and extra whitespace after the C<,> separating key-value"
NSQ_SOURCE_LINE 00000599 "pairs and array members."
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "If C<$enable> is false, then the C<encode> method will not add any extra"
NSQ_SOURCE_LINE 00000602 "space at those places."
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "This setting has no effect when decoding JSON texts."
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "Example, space_before and indent disabled, space_after enabled:"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "   {\"key\": \"value\"}"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "=item $json = $json->relaxed ([$enable])"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "=item $enabled = $json->get_relaxed"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "If C<$enable> is true (or missing), then C<decode> will accept some"
NSQ_SOURCE_LINE 00000615 "extensions to normal JSON syntax (see below). C<encode> will not be"
NSQ_SOURCE_LINE 00000616 "affected in anyway. I<Be aware that this option makes you accept invalid"
NSQ_SOURCE_LINE 00000617 "JSON texts as if they were valid!>. I suggest only to use this option to"
NSQ_SOURCE_LINE 00000618 "parse application-specific files written by humans (configuration files,"
NSQ_SOURCE_LINE 00000619 "resource files etc.)"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "If C<$enable> is false (the default), then C<decode> will only accept"
NSQ_SOURCE_LINE 00000622 "valid JSON texts."
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "Currently accepted extensions are:"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "=over 4"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "=item * list items can have an end-comma"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "JSON I<separates> array elements and key-value pairs with commas. This"
NSQ_SOURCE_LINE 00000631 "can be annoying if you write JSON texts manually and want to be able to"
NSQ_SOURCE_LINE 00000632 "quickly append elements, so this extension accepts comma at the end of"
NSQ_SOURCE_LINE 00000633 "such items not just between them:"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "   ["
NSQ_SOURCE_LINE 00000636 "      1,"
NSQ_SOURCE_LINE 00000637 "      2, <- this comma not normally allowed"
NSQ_SOURCE_LINE 00000638 "   ]"
NSQ_SOURCE_LINE 00000639 "   {"
NSQ_SOURCE_LINE 00000640 "      \"k1\": \"v1\","
NSQ_SOURCE_LINE 00000641 "      \"k2\": \"v2\", <- this comma not normally allowed"
NSQ_SOURCE_LINE 00000642 "   }"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "=item * shell-style '#'-comments"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "Whenever JSON allows whitespace, shell-style comments are additionally"
NSQ_SOURCE_LINE 00000647 "allowed. They are terminated by the first carriage-return or line-feed"
NSQ_SOURCE_LINE 00000648 "character, after which more white-space and comments are allowed."
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "  ["
NSQ_SOURCE_LINE 00000651 "     1, # this comment not allowed in JSON"
NSQ_SOURCE_LINE 00000652 "        # neither this one..."
NSQ_SOURCE_LINE 00000653 "  ]"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "=item * literal ASCII TAB characters in strings"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "Literal ASCII TAB characters are now allowed in strings (and treated as"
NSQ_SOURCE_LINE 00000658 "C<\\t>) in relaxed mode. Despite JSON mandates, that TAB character is"
NSQ_SOURCE_LINE 00000659 "substituted for \"\\t\" sequence."
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "  ["
NSQ_SOURCE_LINE 00000662 "     \"Hello\\tWorld\","
NSQ_SOURCE_LINE 00000663 "     \"Hello<TAB>World\", # literal <TAB> would not normally be allowed"
NSQ_SOURCE_LINE 00000664 "  ]"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "=item * allow_singlequote"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "Single quotes are accepted instead of double quotes. See the"
NSQ_SOURCE_LINE 00000669 "L</allow_singlequote> option."
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "    { \"foo\":'bar' }"
NSQ_SOURCE_LINE 00000672 "    { 'foo':\"bar\" }"
NSQ_SOURCE_LINE 00000673 "    { 'foo':'bar' }"
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "=item * allow_barekey"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "Accept unquoted object keys instead of with mandatory double quotes. See the"
NSQ_SOURCE_LINE 00000678 "L</allow_barekey> option."
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "    { foo:\"bar\" }"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "=item * allow_dupkeys"
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "Allow decoding of duplicate keys in hashes. By default duplicate keys are forbidden."
NSQ_SOURCE_LINE 00000685 "See L<http://seriot.ch/projects/parsing_json.php#24>:"
NSQ_SOURCE_LINE 00000686 "RFC 7159 section 4: \"The names within an object should be unique.\""
NSQ_SOURCE_LINE 00000687 "See the C<allow_dupkeys> option."
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "=back"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "=item $json = $json->canonical ([$enable])"
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "=item $enabled = $json->get_canonical"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "If C<$enable> is true (or missing), then the C<encode> method will"
NSQ_SOURCE_LINE 00000696 "output JSON objects by sorting their keys. This is adding a"
NSQ_SOURCE_LINE 00000697 "comparatively high overhead."
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "If C<$enable> is false, then the C<encode> method will output key-value"
NSQ_SOURCE_LINE 00000700 "pairs in the order Perl stores them (which will likely change between runs"
NSQ_SOURCE_LINE 00000701 "of the same script, and can change even within the same run from 5.18"
NSQ_SOURCE_LINE 00000702 "onwards)."
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "This option is useful if you want the same data structure to be encoded as"
NSQ_SOURCE_LINE 00000705 "the same JSON text (given the same overall settings). If it is disabled,"
NSQ_SOURCE_LINE 00000706 "the same hash might be encoded differently even if contains the same data,"
NSQ_SOURCE_LINE 00000707 "as key-value pairs have no inherent ordering in Perl."
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "This setting has no effect when decoding JSON texts."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "This is now also done with tied hashes, contrary to L<JSON::XS>."
NSQ_SOURCE_LINE 00000712 "But note that with most large tied hashes stored as tree it is advised to"
NSQ_SOURCE_LINE 00000713 "sort the iterator already and don't sort the hash output here. Most such"
NSQ_SOURCE_LINE 00000714 "iterators are already sorted, as such e.g. L<DB_File> with C<DB_BTREE>."
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "=item $json = $json->sort_by (undef, 0, 1 or a block)"
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "This currently only (un)sets the C<canonical> option, and ignores"
NSQ_SOURCE_LINE 00000719 "custom sort blocks."
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "This setting has no effect when decoding JSON texts."
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "This setting has currently no effect on tied hashes."
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "=item $json = $json->escape_slash ([$enable])"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "=item $enabled = $json->get_escape_slash"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "According to the JSON Grammar, the I<forward slash> character (U+002F)"
NSQ_SOURCE_LINE 00000731 "C<\"/\"> need to be escaped.  But by default strings are encoded without"
NSQ_SOURCE_LINE 00000732 "escaping slashes in all perl JSON encoders."
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "If C<$enable> is true (or missing), then C<encode> will escape slashes,"
NSQ_SOURCE_LINE 00000735 "C<\"\\/\">."
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "This setting has no effect when decoding JSON texts."
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "=item $json = $json->unblessed_bool ([$enable])"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "=item $enabled = $json->get_unblessed_bool"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "    $json = $json->unblessed_bool([$enable])"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "If C<$enable> is true (or missing), then C<decode> will return Perl"
NSQ_SOURCE_LINE 00000747 "non-object boolean variables (1 and 0 as numbers or \"1\" and \"\" as"
NSQ_SOURCE_LINE 00000748 "strings) for JSON booleans (C<true> and C<false>). If C<$enable> is"
NSQ_SOURCE_LINE 00000749 "false, then C<decode> will return C<JSON::PP::Boolean> objects for"
NSQ_SOURCE_LINE 00000750 "JSON booleans."
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "=item $json = $json->allow_singlequote ([$enable])"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "=item $enabled = $json->get_allow_singlequote"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "    $json = $json->allow_singlequote([$enable])"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "If C<$enable> is true (or missing), then C<decode> will accept"
NSQ_SOURCE_LINE 00000760 "JSON strings quoted by single quotations that are invalid JSON"
NSQ_SOURCE_LINE 00000761 "format."
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "    $json->allow_singlequote->decode({\"foo\":'bar'});"
NSQ_SOURCE_LINE 00000764 "    $json->allow_singlequote->decode({'foo':\"bar\"});"
NSQ_SOURCE_LINE 00000765 "    $json->allow_singlequote->decode({'foo':'bar'});"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "This is also enabled with C<relaxed>."
NSQ_SOURCE_LINE 00000768 "As same as the C<relaxed> option, this option may be used to parse"
NSQ_SOURCE_LINE 00000769 "application-specific files written by humans."
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "=item $json = $json->allow_barekey ([$enable])"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "=item $enabled = $json->get_allow_barekey"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "    $json = $json->allow_barekey([$enable])"
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "If C<$enable> is true (or missing), then C<decode> will accept"
NSQ_SOURCE_LINE 00000779 "bare keys of JSON object that are invalid JSON format."
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "Same as with the C<relaxed> option, this option may be used to parse"
NSQ_SOURCE_LINE 00000782 "application-specific files written by humans."
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "    $json->allow_barekey->decode('{foo:\"bar\"}');"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "=item $json = $json->allow_bignum ([$enable])"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "=item $enabled = $json->get_allow_bignum"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "    $json = $json->allow_bignum([$enable])"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "If C<$enable> is true (or missing), then C<decode> will convert"
NSQ_SOURCE_LINE 00000793 "the big integer Perl cannot handle as integer into a L<Math::BigInt>"
NSQ_SOURCE_LINE 00000794 "object and convert a floating number (any) into a L<Math::BigFloat>."
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "   $int = $json->allow_nonref->allow_bignum->decode(1); # => 1"
NSQ_SOURCE_LINE 00000797 "   $bigint = $json->allow_bignum->decode('100000000000000000000000000000000000000');"
NSQ_SOURCE_LINE 00000798 "   $bigfloat = $json->allow_bignum->decode(1.0);"
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "On the contrary, C<encode> converts C<Math::BigInt> objects and"
NSQ_SOURCE_LINE 00000801 "C<Math::BigFloat> objects into JSON numbers with C<allow_blessed>"
NSQ_SOURCE_LINE 00000802 "enable."
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "   $json->allow_nonref->allow_blessed->allow_bignum;"
NSQ_SOURCE_LINE 00000805 "   $bigfloat = $json->decode('2.000000000000000000000000001');"
NSQ_SOURCE_LINE 00000806 "   print $json->encode($bigfloat);"
NSQ_SOURCE_LINE 00000807 "   # => 2.000000000000000000000000001"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "See L</MAPPING> about the normal conversion of JSON number."
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "=item $json = $json->allow_bigint ([$enable])"
NSQ_SOURCE_LINE 00000813 ""
NSQ_SOURCE_LINE 00000814 "This option is obsolete and replaced by allow_bignum."
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "=item $json = $json->allow_nonref ([$enable])"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "=item $enabled = $json->get_allow_nonref"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "If C<$enable> is true (or missing), then the C<encode> method can"
NSQ_SOURCE_LINE 00000822 "convert a non-reference into its corresponding string, number or null"
NSQ_SOURCE_LINE 00000823 "JSON value, which is an extension to RFC4627. Likewise, C<decode> will"
NSQ_SOURCE_LINE 00000824 "accept those JSON values instead of croaking."
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "If C<$enable> is false, then the C<encode> method will croak if it isn't"
NSQ_SOURCE_LINE 00000827 "passed an arrayref or hashref, as JSON texts must either be an object"
NSQ_SOURCE_LINE 00000828 "or array. Likewise, C<decode> will croak if given something that is not a"
NSQ_SOURCE_LINE 00000829 "JSON object or array."
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "Example, encode a Perl scalar as JSON value with enabled C<allow_nonref>,"
NSQ_SOURCE_LINE 00000832 "resulting in an invalid JSON text:"
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "   Cpanel::JSON::XS->new->allow_nonref->encode (\"Hello, World!\")"
NSQ_SOURCE_LINE 00000835 "   => \"Hello, World!\""
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "=item $json = $json->allow_unknown ([$enable])"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "=item $enabled = $json->get_allow_unknown"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "If C<$enable> is true (or missing), then C<encode> will I<not> throw an"
NSQ_SOURCE_LINE 00000842 "exception when it encounters values it cannot represent in JSON (for"
NSQ_SOURCE_LINE 00000843 "example, filehandles) but instead will encode a JSON C<null> value. Note"
NSQ_SOURCE_LINE 00000844 "that blessed objects are not included here and are handled separately by"
NSQ_SOURCE_LINE 00000845 "c<allow_nonref>."
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "If C<$enable> is false (the default), then C<encode> will throw an"
NSQ_SOURCE_LINE 00000848 "exception when it encounters anything it cannot encode as JSON."
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "This option does not affect C<decode> in any way, and it is recommended to"
NSQ_SOURCE_LINE 00000851 "leave it off unless you know your communications partner."
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "=item $json = $json->allow_stringify ([$enable])"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "=item $enabled = $json->get_allow_stringify"
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "If C<$enable> is true (or missing), then C<encode> will stringify the"
NSQ_SOURCE_LINE 00000858 "non-object perl value or reference. Note that blessed objects are not"
NSQ_SOURCE_LINE 00000859 "included here and are handled separately by C<allow_blessed> and"
NSQ_SOURCE_LINE 00000860 "C<convert_blessed>.  String references are stringified to the string"
NSQ_SOURCE_LINE 00000861 "value, other references as in perl."
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "This option does not affect C<decode> in any way."
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "This option is special to this module, it is not supported by other"
NSQ_SOURCE_LINE 00000866 "encoders.  So it is not recommended to use it."
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "=item $json = $json->require_types ([$enable])"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "=item $enable = $json->get_require_types"
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "     $json = $json->require_types([$enable])"
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "If C<$enable> is true (or missing), then C<encode> will require"
NSQ_SOURCE_LINE 00000875 "either enabled C<type_all_string> or second argument with supplied JSON types."
NSQ_SOURCE_LINE 00000876 "See L<Cpanel::JSON::XS::Type>. When C<type_all_string> is not enabled or"
NSQ_SOURCE_LINE 00000877 "second argument is not provided (or is undef), then C<encode>"
NSQ_SOURCE_LINE 00000878 "croaks. It also croaks when the type for provided structure in"
NSQ_SOURCE_LINE 00000879 "C<encode> is incomplete."
NSQ_SOURCE_LINE 00000880 ""
NSQ_SOURCE_LINE 00000881 "=item $json = $json->type_all_string ([$enable])"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "=item $enable = $json->get_type_all_string"
NSQ_SOURCE_LINE 00000884 ""
NSQ_SOURCE_LINE 00000885 "     $json = $json->type_all_string([$enable])"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "If C<$enable> is true (or missing), then C<encode> will always"
NSQ_SOURCE_LINE 00000888 "produce stable deterministic JSON string types in resulted output."
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "When C<$enable> is false, then result of encoded JSON output may be"
NSQ_SOURCE_LINE 00000891 "different for different Perl versions and may depends on loaded modules."
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "This is useful it you need deterministic JSON types, independently of used"
NSQ_SOURCE_LINE 00000894 "Perl version and other modules, but do not want to write complicated type"
NSQ_SOURCE_LINE 00000895 "definitions for L<Cpanel::JSON::XS::Type>."
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "=item $json = $json->allow_dupkeys ([$enable])"
NSQ_SOURCE_LINE 00000898 ""
NSQ_SOURCE_LINE 00000899 "=item $enabled = $json->get_allow_dupkeys"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "If C<$enable> is true (or missing), then the C<decode> method will not"
NSQ_SOURCE_LINE 00000902 "die when it encounters duplicate keys in a hash."
NSQ_SOURCE_LINE 00000903 "C<allow_dupkeys> is also enabled in the C<relaxed> mode."
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "The JSON spec allows duplicate name in objects but recommends to"
NSQ_SOURCE_LINE 00000906 "disable it, however with Perl hashes they are impossible, parsing"
NSQ_SOURCE_LINE 00000907 "JSON in Perl silently ignores duplicate names, using the last value"
NSQ_SOURCE_LINE 00000908 "found."
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "See L<http://seriot.ch/projects/parsing_json.php#24>:"
NSQ_SOURCE_LINE 00000911 "RFC 7159 section 4: \"The names within an object should be unique.\""
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "=item $json = $json->dupkeys_as_arrayref ([$enable])"
NSQ_SOURCE_LINE 00000914 ""
NSQ_SOURCE_LINE 00000915 "=item $enabled = $json->get_dupkeys_as_arrayref"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "If enabled, allow decoding of duplicate keys in hashes and store the"
NSQ_SOURCE_LINE 00000918 "values as arrayref in the hash instead.  By default duplicate keys are"
NSQ_SOURCE_LINE 00000919 "forbidden.  Enabling this also enables the L</allow_dupkeys> option,"
NSQ_SOURCE_LINE 00000920 "but disabling this does not disable the L</allow_dupkeys> option."
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "Example:"
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "    $json->dupkeys_as_arrayref;"
NSQ_SOURCE_LINE 00000925 "    print encode_json ($json->decode ('{\"a\":\"b\",\"a\":\"c\"}'));"
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "      => {\"a\":[\"b\",\"c\"]}"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "This changes the result structure, thus cannot be enabled by default."
NSQ_SOURCE_LINE 00000930 "The client must be aware of it. The resulting arrayref is not yet marked somehow"
NSQ_SOURCE_LINE 00000931 "(blessed or such)."
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "=item $json = $json->allow_blessed ([$enable])"
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "=item $enabled = $json->get_allow_blessed"
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "If C<$enable> is true (or missing), then the C<encode> method will not"
NSQ_SOURCE_LINE 00000938 "barf when it encounters a blessed reference. Instead, the value of the"
NSQ_SOURCE_LINE 00000939 "B<convert_blessed> option will decide whether C<null> (C<convert_blessed>"
NSQ_SOURCE_LINE 00000940 "disabled or no C<TO_JSON> method found) or a representation of the"
NSQ_SOURCE_LINE 00000941 "object (C<convert_blessed> enabled and C<TO_JSON> method found) is being"
NSQ_SOURCE_LINE 00000942 "encoded. Has no effect on C<decode>."
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "If C<$enable> is false (the default), then C<encode> will throw an"
NSQ_SOURCE_LINE 00000945 "exception when it encounters a blessed object without C<convert_blessed>"
NSQ_SOURCE_LINE 00000946 "and a C<TO_JSON> method."
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "This setting has no effect on C<decode>."
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "=item $json = $json->convert_blessed ([$enable])"
NSQ_SOURCE_LINE 00000951 ""
NSQ_SOURCE_LINE 00000952 "=item $enabled = $json->get_convert_blessed"
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "If C<$enable> is true (or missing), then C<encode>, upon encountering a"
NSQ_SOURCE_LINE 00000955 "blessed object, will check for the availability of the C<TO_JSON> method"
NSQ_SOURCE_LINE 00000956 "on the object's class. If found, it will be called in scalar context"
NSQ_SOURCE_LINE 00000957 "and the resulting scalar will be encoded instead of the object. If no"
NSQ_SOURCE_LINE 00000958 "C<TO_JSON> method is found, a stringification overload method is tried next."
NSQ_SOURCE_LINE 00000959 "If both are not found, the value of C<allow_blessed> will decide what"
NSQ_SOURCE_LINE 00000960 "to do."
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "The C<TO_JSON> method may safely call die if it wants. If C<TO_JSON>"
NSQ_SOURCE_LINE 00000963 "returns other blessed objects, those will be handled in the same"
NSQ_SOURCE_LINE 00000964 "way. C<TO_JSON> must take care of not causing an endless recursion"
NSQ_SOURCE_LINE 00000965 "cycle (== crash) in this case. The same care must be taken with"
NSQ_SOURCE_LINE 00000966 "calling encode in stringify overloads (even if this works by luck in"
NSQ_SOURCE_LINE 00000967 "older perls) or other callbacks.  The name of C<TO_JSON> was chosen"
NSQ_SOURCE_LINE 00000968 "because other methods called by the Perl core (== not by the user of"
NSQ_SOURCE_LINE 00000969 "the object) are usually in upper case letters and to avoid collisions"
NSQ_SOURCE_LINE 00000970 "with any C<to_json> function or method."
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "If C<$enable> is false (the default), then C<encode> will not consider"
NSQ_SOURCE_LINE 00000973 "this type of conversion."
NSQ_SOURCE_LINE 00000974 ""
NSQ_SOURCE_LINE 00000975 "This setting has no effect on C<decode>."
NSQ_SOURCE_LINE 00000976 ""
NSQ_SOURCE_LINE 00000977 "=item $json = $json->allow_tags ([$enable])"
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "=item $enabled = $json->get_allow_tags"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "See L<OBJECT SERIALIZATION> for details."
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 "If C<$enable> is true (or missing), then C<encode>, upon encountering a"
NSQ_SOURCE_LINE 00000984 "blessed object, will check for the availability of the C<FREEZE> method on"
NSQ_SOURCE_LINE 00000985 "the object's class. If found, it will be used to serialize the object into"
NSQ_SOURCE_LINE 00000986 "a nonstandard tagged JSON value (that JSON decoders cannot decode)."
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 "It also causes C<decode> to parse such tagged JSON values and deserialize"
NSQ_SOURCE_LINE 00000989 "them via a call to the C<THAW> method."
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "If C<$enable> is false (the default), then C<encode> will not consider"
NSQ_SOURCE_LINE 00000992 "this type of conversion, and tagged JSON values will cause a parse error"
NSQ_SOURCE_LINE 00000993 "in C<decode>, as if tags were not part of the grammar."
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "=item $json = $json->filter_json_object ([$coderef->($hashref)])"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "When C<$coderef> is specified, it will be called from C<decode> each"
NSQ_SOURCE_LINE 00000998 "time it decodes a JSON object. The only argument is a reference to the"
NSQ_SOURCE_LINE 00000999 "newly-created hash. If the code references returns a single scalar (which"
NSQ_SOURCE_LINE 00001000 "need not be a reference), this value (i.e. a copy of that scalar to avoid"
NSQ_SOURCE_LINE 00001001 "aliasing) is inserted into the deserialized data structure. If it returns"
NSQ_SOURCE_LINE 00001002 "an empty list (NOTE: I<not> C<undef>, which is a valid scalar), the"
NSQ_SOURCE_LINE 00001003 "original deserialized hash will be inserted. This setting can slow down"
NSQ_SOURCE_LINE 00001004 "decoding considerably."
NSQ_SOURCE_LINE 00001005 ""
NSQ_SOURCE_LINE 00001006 "When C<$coderef> is omitted or undefined, any existing callback will"
NSQ_SOURCE_LINE 00001007 "be removed and C<decode> will not change the deserialized hash in any"
NSQ_SOURCE_LINE 00001008 "way."
NSQ_SOURCE_LINE 00001009 ""
NSQ_SOURCE_LINE 00001010 "Example, convert all JSON objects into the integer 5:"
NSQ_SOURCE_LINE 00001011 ""
NSQ_SOURCE_LINE 00001012 "   my $js = Cpanel::JSON::XS->new->filter_json_object (sub { 5 });"
NSQ_SOURCE_LINE 00001013 "   # returns [5]"
NSQ_SOURCE_LINE 00001014 "   $js->decode ('[{}]')"
NSQ_SOURCE_LINE 00001015 "   # throw an exception because allow_nonref is not enabled"
NSQ_SOURCE_LINE 00001016 "   # so a lone 5 is not allowed."
NSQ_SOURCE_LINE 00001017 "   $js->decode ('{\"a\":1, \"b\":2}');"
NSQ_SOURCE_LINE 00001018 ""
NSQ_SOURCE_LINE 00001019 "=item $json = $json->filter_json_single_key_object ($key [=> $coderef->($value)])"
NSQ_SOURCE_LINE 00001020 ""
NSQ_SOURCE_LINE 00001021 "Works remotely similar to C<filter_json_object>, but is only called for"
NSQ_SOURCE_LINE 00001022 "JSON objects having a single key named C<$key>."
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "This C<$coderef> is called before the one specified via"
NSQ_SOURCE_LINE 00001025 "C<filter_json_object>, if any. It gets passed the single value in the JSON"
NSQ_SOURCE_LINE 00001026 "object. If it returns a single value, it will be inserted into the data"
NSQ_SOURCE_LINE 00001027 "structure. If it returns nothing (not even C<undef> but the empty list),"
NSQ_SOURCE_LINE 00001028 "the callback from C<filter_json_object> will be called next, as if no"
NSQ_SOURCE_LINE 00001029 "single-key callback were specified."
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "If C<$coderef> is omitted or undefined, the corresponding callback will be"
NSQ_SOURCE_LINE 00001032 "disabled. There can only ever be one callback for a given key."
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "As this callback gets called less often then the C<filter_json_object>"
NSQ_SOURCE_LINE 00001035 "one, decoding speed will not usually suffer as much. Therefore, single-key"
NSQ_SOURCE_LINE 00001036 "objects make excellent targets to serialize Perl objects into, especially"
NSQ_SOURCE_LINE 00001037 "as single-key JSON objects are as close to the type-tagged value concept"
NSQ_SOURCE_LINE 00001038 "as JSON gets (it's basically an ID/VALUE tuple). Of course, JSON does not"
NSQ_SOURCE_LINE 00001039 "support this in any way, so you need to make sure your data never looks"
NSQ_SOURCE_LINE 00001040 "like a serialized Perl hash."
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "Typical names for the single object key are C<__class_whatever__>, or"
NSQ_SOURCE_LINE 00001043 "C<$__dollars_are_rarely_used__$> or C<}ugly_brace_placement>, or even"
NSQ_SOURCE_LINE 00001044 "things like C<__class_md5sum(classname)__>, to reduce the risk of clashing"
NSQ_SOURCE_LINE 00001045 "with real hashes."
NSQ_SOURCE_LINE 00001046 ""
NSQ_SOURCE_LINE 00001047 "Example, decode JSON objects of the form C<< { \"__widget__\" => <id> } >>"
NSQ_SOURCE_LINE 00001048 "into the corresponding C<< $WIDGET{<id>} >> object:"
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "   # return whatever is in $WIDGET{5}:"
NSQ_SOURCE_LINE 00001051 "   Cpanel::JSON::XS"
NSQ_SOURCE_LINE 00001052 "      ->new"
NSQ_SOURCE_LINE 00001053 "      ->filter_json_single_key_object (__widget__ => sub {"
NSQ_SOURCE_LINE 00001054 "            $WIDGET{ $_[0] }"
NSQ_SOURCE_LINE 00001055 "         })"
NSQ_SOURCE_LINE 00001056 "      ->decode ('{\"__widget__\": 5')"
NSQ_SOURCE_LINE 00001057 ""
NSQ_SOURCE_LINE 00001058 "   # this can be used with a TO_JSON method in some \"widget\" class"
NSQ_SOURCE_LINE 00001059 "   # for serialization to json:"
NSQ_SOURCE_LINE 00001060 "   sub WidgetBase::TO_JSON {"
NSQ_SOURCE_LINE 00001061 "      my ($self) = @_;"
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "      unless ($self->{id}) {"
NSQ_SOURCE_LINE 00001064 "         $self->{id} = ..get..some..id..;"
NSQ_SOURCE_LINE 00001065 "         $WIDGET{$self->{id}} = $self;"
NSQ_SOURCE_LINE 00001066 "      }"
NSQ_SOURCE_LINE 00001067 ""
NSQ_SOURCE_LINE 00001068 "      { __widget__ => $self->{id} }"
NSQ_SOURCE_LINE 00001069 "   }"
NSQ_SOURCE_LINE 00001070 ""
NSQ_SOURCE_LINE 00001071 "=item $json = $json->shrink ([$enable])"
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "=item $enabled = $json->get_shrink"
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "Perl usually over-allocates memory a bit when allocating space for"
NSQ_SOURCE_LINE 00001076 "strings. This flag optionally resizes strings generated by either"
NSQ_SOURCE_LINE 00001077 "C<encode> or C<decode> to their minimum size possible. This can save"
NSQ_SOURCE_LINE 00001078 "memory when your JSON texts are either very very long or you have many"
NSQ_SOURCE_LINE 00001079 "short strings. It will also try to downgrade any strings to octet-form"
NSQ_SOURCE_LINE 00001080 "if possible: perl stores strings internally either in an encoding called"
NSQ_SOURCE_LINE 00001081 "UTF-X or in octet-form. The latter cannot store everything but uses less"
NSQ_SOURCE_LINE 00001082 "space in general (and some buggy Perl or C code might even rely on that"
NSQ_SOURCE_LINE 00001083 "internal representation being used)."
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "The actual definition of what shrink does might change in future versions,"
NSQ_SOURCE_LINE 00001086 "but it will always try to save space at the expense of time."
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "If C<$enable> is true (or missing), the string returned by C<encode> will"
NSQ_SOURCE_LINE 00001089 "be shrunk-to-fit, while all strings generated by C<decode> will also be"
NSQ_SOURCE_LINE 00001090 "shrunk-to-fit."
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "If C<$enable> is false, then the normal perl allocation algorithms are used."
NSQ_SOURCE_LINE 00001093 "If you work with your data, then this is likely to be faster."
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "In the future, this setting might control other things, such as converting"
NSQ_SOURCE_LINE 00001096 "strings that look like integers or floats into integers or floats"
NSQ_SOURCE_LINE 00001097 "internally (there is no difference on the Perl level), saving space."
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "=item $json = $json->max_depth ([$maximum_nesting_depth])"
NSQ_SOURCE_LINE 00001100 ""
NSQ_SOURCE_LINE 00001101 "=item $max_depth = $json->get_max_depth"
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 "Sets the maximum nesting level (default C<512>) accepted while encoding"
NSQ_SOURCE_LINE 00001104 "or decoding. If a higher nesting level is detected in JSON text or a Perl"
NSQ_SOURCE_LINE 00001105 "data structure, then the encoder and decoder will stop and croak at that"
NSQ_SOURCE_LINE 00001106 "point."
NSQ_SOURCE_LINE 00001107 ""
NSQ_SOURCE_LINE 00001108 "Nesting level is defined by number of hash- or arrayrefs that the encoder"
NSQ_SOURCE_LINE 00001109 "needs to traverse to reach a given point or the number of C<{> or C<[>"
NSQ_SOURCE_LINE 00001110 "characters without their matching closing parenthesis crossed to reach a"
NSQ_SOURCE_LINE 00001111 "given character in a string."
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "Setting the maximum depth to one disallows any nesting, so that ensures"
NSQ_SOURCE_LINE 00001114 "that the object is only a single hash/object or array."
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "If no argument is given, the highest possible setting will be used, which"
NSQ_SOURCE_LINE 00001117 "is rarely useful."
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 "Note that nesting is implemented by recursion in C. The default value has"
NSQ_SOURCE_LINE 00001120 "been chosen to be as large as typical operating systems allow without"
NSQ_SOURCE_LINE 00001121 "crashing."
NSQ_SOURCE_LINE 00001122 ""
NSQ_SOURCE_LINE 00001123 "See L</SECURITY CONSIDERATIONS>, below, for more info on why this is useful."
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "=item $json = $json->max_size ([$maximum_string_size])"
NSQ_SOURCE_LINE 00001126 ""
NSQ_SOURCE_LINE 00001127 "=item $max_size = $json->get_max_size"
NSQ_SOURCE_LINE 00001128 ""
NSQ_SOURCE_LINE 00001129 "Set the maximum length a JSON text may have (in bytes) where decoding is"
NSQ_SOURCE_LINE 00001130 "being attempted. The default is C<0>, meaning no limit. When C<decode>"
NSQ_SOURCE_LINE 00001131 "is called on a string that is longer then this many bytes, it will not"
NSQ_SOURCE_LINE 00001132 "attempt to decode the string but throw an exception. This setting has no"
NSQ_SOURCE_LINE 00001133 "effect on C<encode> (yet)."
NSQ_SOURCE_LINE 00001134 ""
NSQ_SOURCE_LINE 00001135 "If no argument is given, the limit check will be deactivated (same as when"
NSQ_SOURCE_LINE 00001136 "C<0> is specified)."
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "See L</SECURITY CONSIDERATIONS>, below, for more info on why this is useful."
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "=item $json->stringify_infnan ([$infnan_mode = 1])"
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "=item $infnan_mode = $json->get_stringify_infnan"
NSQ_SOURCE_LINE 00001143 ""
NSQ_SOURCE_LINE 00001144 "Get or set how Cpanel::JSON::XS encodes C<inf>, C<-inf> or C<nan> for numeric"
NSQ_SOURCE_LINE 00001145 "values. Also qnan, snan or negative nan on some platforms."
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 "C<null>:     infnan_mode = 0. Similar to most JSON modules in other languages."
NSQ_SOURCE_LINE 00001148 "Always null."
NSQ_SOURCE_LINE 00001149 ""
NSQ_SOURCE_LINE 00001150 "stringified: infnan_mode = 1. As in Mojo::JSON. Platform specific strings."
NSQ_SOURCE_LINE 00001151 "Stringified via sprintf(%g), with double quotes."
NSQ_SOURCE_LINE 00001152 ""
NSQ_SOURCE_LINE 00001153 "inf/nan:     infnan_mode = 2. As in JSON::XS, and older releases."
NSQ_SOURCE_LINE 00001154 "Passes through platform dependent values, invalid JSON. Stringified via"
NSQ_SOURCE_LINE 00001155 "sprintf(%g), but without double quotes."
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "\"inf/-inf/nan\": infnan_mode = 3. Platform independent inf/nan/-inf"
NSQ_SOURCE_LINE 00001158 "strings.  No QNAN/SNAN/negative NAN support, unified to \"nan\". Much"
NSQ_SOURCE_LINE 00001159 "easier to detect, but may conflict with valid strings."
NSQ_SOURCE_LINE 00001160 ""
NSQ_SOURCE_LINE 00001161 "=item $json_text = $json->encode ($perl_scalar, $json_type)"
NSQ_SOURCE_LINE 00001162 ""
NSQ_SOURCE_LINE 00001163 "Converts the given Perl data structure (a simple scalar or a reference"
NSQ_SOURCE_LINE 00001164 "to a hash or array) to its JSON representation. Simple scalars will be"
NSQ_SOURCE_LINE 00001165 "converted into JSON string or number sequences, while references to"
NSQ_SOURCE_LINE 00001166 "arrays become JSON arrays and references to hashes become JSON"
NSQ_SOURCE_LINE 00001167 "objects. Undefined Perl values (e.g. C<undef>) become JSON C<null>"
NSQ_SOURCE_LINE 00001168 "values. Neither C<true> nor C<false> values will be generated."
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 "For the type argument see L<Cpanel::JSON::XS::Type>."
NSQ_SOURCE_LINE 00001171 ""
NSQ_SOURCE_LINE 00001172 "=item $perl_scalar = $json->decode ($json_text, my $json_type)"
NSQ_SOURCE_LINE 00001173 ""
NSQ_SOURCE_LINE 00001174 "The opposite of C<encode>: expects a JSON text and tries to parse it,"
NSQ_SOURCE_LINE 00001175 "returning the resulting simple scalar or reference. Croaks on error."
NSQ_SOURCE_LINE 00001176 ""
NSQ_SOURCE_LINE 00001177 "JSON numbers and strings become simple Perl scalars. JSON arrays become"
NSQ_SOURCE_LINE 00001178 "Perl arrayrefs and JSON objects become Perl hashrefs. C<true> becomes"
NSQ_SOURCE_LINE 00001179 "C<1>, C<false> becomes C<0> and C<null> becomes C<undef>."
NSQ_SOURCE_LINE 00001180 ""
NSQ_SOURCE_LINE 00001181 "For the type argument see L<Cpanel::JSON::XS::Type>."
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "=item ($perl_scalar, $characters) = $json->decode_prefix ($json_text)"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "This works like the C<decode> method, but instead of raising an exception"
NSQ_SOURCE_LINE 00001186 "when there is trailing garbage after the first JSON object, it will"
NSQ_SOURCE_LINE 00001187 "silently stop parsing there and return the number of characters consumed"
NSQ_SOURCE_LINE 00001188 "so far."
NSQ_SOURCE_LINE 00001189 ""
NSQ_SOURCE_LINE 00001190 "This is useful if your JSON texts are not delimited by an outer protocol"
NSQ_SOURCE_LINE 00001191 "and you need to know where the JSON text ends."
NSQ_SOURCE_LINE 00001192 ""
NSQ_SOURCE_LINE 00001193 "   Cpanel::JSON::XS->new->decode_prefix (\"[1] the tail\")"
NSQ_SOURCE_LINE 00001194 "   => ([1], 3)"
NSQ_SOURCE_LINE 00001195 ""
NSQ_SOURCE_LINE 00001196 "=item $json->to_json ($perl_hash_or_arrayref)"
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "Deprecated method for perl 5.8 and newer. Use L<encode_json> instead."
NSQ_SOURCE_LINE 00001199 ""
NSQ_SOURCE_LINE 00001200 "=item $json->from_json ($utf8_encoded_json_text)"
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "Deprecated method for perl 5.8 and newer. Use L<decode_json> instead."
NSQ_SOURCE_LINE 00001203 ""
NSQ_SOURCE_LINE 00001204 "=back"
NSQ_SOURCE_LINE 00001205 ""
NSQ_SOURCE_LINE 00001206 ""
NSQ_SOURCE_LINE 00001207 "=head1 INCREMENTAL PARSING"
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 "In some cases, there is the need for incremental parsing of JSON"
NSQ_SOURCE_LINE 00001210 "texts. While this module always has to keep both JSON text and resulting"
NSQ_SOURCE_LINE 00001211 "Perl data structure in memory at one time, it does allow you to parse a"
NSQ_SOURCE_LINE 00001212 "JSON stream incrementally. It does so by accumulating text until it has"
NSQ_SOURCE_LINE 00001213 "a full JSON object, which it then can decode. This process is similar to"
NSQ_SOURCE_LINE 00001214 "using C<decode_prefix> to see if a full JSON object is available, but"
NSQ_SOURCE_LINE 00001215 "is much more efficient (and can be implemented with a minimum of method"
NSQ_SOURCE_LINE 00001216 "calls)."
NSQ_SOURCE_LINE 00001217 ""
NSQ_SOURCE_LINE 00001218 "Cpanel::JSON::XS will only attempt to parse the JSON text once it is"
NSQ_SOURCE_LINE 00001219 "sure it has enough text to get a decisive result, using a very simple"
NSQ_SOURCE_LINE 00001220 "but truly incremental parser. This means that it sometimes won't stop"
NSQ_SOURCE_LINE 00001221 "as early as the full parser, for example, it doesn't detect mismatched"
NSQ_SOURCE_LINE 00001222 "parentheses. The only thing it guarantees is that it starts decoding"
NSQ_SOURCE_LINE 00001223 "as soon as a syntactically valid JSON text has been seen. This means"
NSQ_SOURCE_LINE 00001224 "you need to set resource limits (e.g. C<max_size>) to ensure the"
NSQ_SOURCE_LINE 00001225 "parser will stop parsing in the presence of syntax errors."
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "The following methods implement this incremental parser."
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 "=over 4"
NSQ_SOURCE_LINE 00001230 ""
NSQ_SOURCE_LINE 00001231 "=item [void, scalar or list context] = $json->incr_parse ([$string])"
NSQ_SOURCE_LINE 00001232 ""
NSQ_SOURCE_LINE 00001233 "This is the central parsing function. It can both append new text and"
NSQ_SOURCE_LINE 00001234 "extract objects from the stream accumulated so far (both of these"
NSQ_SOURCE_LINE 00001235 "functions are optional)."
NSQ_SOURCE_LINE 00001236 ""
NSQ_SOURCE_LINE 00001237 "If C<$string> is given, then this string is appended to the already"
NSQ_SOURCE_LINE 00001238 "existing JSON fragment stored in the C<$json> object."
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "After that, if the function is called in void context, it will simply"
NSQ_SOURCE_LINE 00001241 "return without doing anything further. This can be used to add more text"
NSQ_SOURCE_LINE 00001242 "in as many chunks as you want."
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "If the method is called in scalar context, then it will try to extract"
NSQ_SOURCE_LINE 00001245 "exactly I<one> JSON object. If that is successful, it will return this"
NSQ_SOURCE_LINE 00001246 "object, otherwise it will return C<undef>. If there is a parse error,"
NSQ_SOURCE_LINE 00001247 "this method will croak just as C<decode> would do (one can then use"
NSQ_SOURCE_LINE 00001248 "C<incr_skip> to skip the erroneous part). This is the most common way of"
NSQ_SOURCE_LINE 00001249 "using the method."
NSQ_SOURCE_LINE 00001250 ""
NSQ_SOURCE_LINE 00001251 "And finally, in list context, it will try to extract as many objects"
NSQ_SOURCE_LINE 00001252 "from the stream as it can find and return them, or the empty list"
NSQ_SOURCE_LINE 00001253 "otherwise. For this to work, there must be no separators between the JSON"
NSQ_SOURCE_LINE 00001254 "objects or arrays, instead they must be concatenated back-to-back. If"
NSQ_SOURCE_LINE 00001255 "an error occurs, an exception will be raised as in the scalar context"
NSQ_SOURCE_LINE 00001256 "case. Note that in this case, any previously-parsed JSON texts will be"
NSQ_SOURCE_LINE 00001257 "lost."
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "Example: Parse some JSON arrays/objects in a given string and return"
NSQ_SOURCE_LINE 00001260 "them."
NSQ_SOURCE_LINE 00001261 ""
NSQ_SOURCE_LINE 00001262 "   my @objs = Cpanel::JSON::XS->new->incr_parse (\"[5][7][1,2]\");"
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "=item $lvalue_string = $json->incr_text (>5.8 only)"
NSQ_SOURCE_LINE 00001265 ""
NSQ_SOURCE_LINE 00001266 "This method returns the currently stored JSON fragment as an lvalue, that"
NSQ_SOURCE_LINE 00001267 "is, you can manipulate it. This I<only> works when a preceding call to"
NSQ_SOURCE_LINE 00001268 "C<incr_parse> in I<scalar context> successfully returned an object, and"
NSQ_SOURCE_LINE 00001269 "2. only with Perl >= 5.8 "
NSQ_SOURCE_LINE 00001270 ""
NSQ_SOURCE_LINE 00001271 "Under all other circumstances you must not call this function (I mean"
NSQ_SOURCE_LINE 00001272 "it.  although in simple tests it might actually work, it I<will> fail"
NSQ_SOURCE_LINE 00001273 "under real world conditions). As a special exception, you can also"
NSQ_SOURCE_LINE 00001274 "call this method before having parsed anything."
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "This function is useful in two cases: a) finding the trailing text after a"
NSQ_SOURCE_LINE 00001277 "JSON object or b) parsing multiple JSON objects separated by non-JSON text"
NSQ_SOURCE_LINE 00001278 "(such as commas)."
NSQ_SOURCE_LINE 00001279 ""
NSQ_SOURCE_LINE 00001280 "=item $json->incr_skip"
NSQ_SOURCE_LINE 00001281 ""
NSQ_SOURCE_LINE 00001282 "This will reset the state of the incremental parser and will remove"
NSQ_SOURCE_LINE 00001283 "the parsed text from the input buffer so far. This is useful after"
NSQ_SOURCE_LINE 00001284 "C<incr_parse> died, in which case the input buffer and incremental parser"
NSQ_SOURCE_LINE 00001285 "state is left unchanged, to skip the text parsed so far and to reset the"
NSQ_SOURCE_LINE 00001286 "parse state."
NSQ_SOURCE_LINE 00001287 ""
NSQ_SOURCE_LINE 00001288 "The difference to C<incr_reset> is that only text until the parse error"
NSQ_SOURCE_LINE 00001289 "occurred is removed."
NSQ_SOURCE_LINE 00001290 ""
NSQ_SOURCE_LINE 00001291 "=item $json->incr_reset"
NSQ_SOURCE_LINE 00001292 ""
NSQ_SOURCE_LINE 00001293 "This completely resets the incremental parser, that is, after this call,"
NSQ_SOURCE_LINE 00001294 "it will be as if the parser had never parsed anything."
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 "This is useful if you want to repeatedly parse JSON objects and want to"
NSQ_SOURCE_LINE 00001297 "ignore any trailing data, which means you have to reset the parser after"
NSQ_SOURCE_LINE 00001298 "each successful decode."
NSQ_SOURCE_LINE 00001299 ""
NSQ_SOURCE_LINE 00001300 "=back"
NSQ_SOURCE_LINE 00001301 ""
NSQ_SOURCE_LINE 00001302 "=head2 LIMITATIONS"
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 "All options that affect decoding are supported, except"
NSQ_SOURCE_LINE 00001305 "C<allow_nonref>. The reason for this is that it cannot be made to work"
NSQ_SOURCE_LINE 00001306 "sensibly: JSON objects and arrays are self-delimited, i.e. you can"
NSQ_SOURCE_LINE 00001307 "concatenate them back to back and still decode them perfectly. This"
NSQ_SOURCE_LINE 00001308 "does not hold true for JSON numbers, however."
NSQ_SOURCE_LINE 00001309 ""
NSQ_SOURCE_LINE 00001310 "For example, is the string C<1> a single JSON number, or is it simply"
NSQ_SOURCE_LINE 00001311 "the start of C<12>? Or is C<12> a single JSON number, or the"
NSQ_SOURCE_LINE 00001312 "concatenation of C<1> and C<2>? In neither case you can tell, and this"
NSQ_SOURCE_LINE 00001313 "is why Cpanel::JSON::XS takes the conservative route and disallows"
NSQ_SOURCE_LINE 00001314 "this case."
NSQ_SOURCE_LINE 00001315 ""
NSQ_SOURCE_LINE 00001316 "=head2 EXAMPLES"
NSQ_SOURCE_LINE 00001317 ""
NSQ_SOURCE_LINE 00001318 "Some examples will make all this clearer. First, a simple example that"
NSQ_SOURCE_LINE 00001319 "works similarly to C<decode_prefix>: We want to decode the JSON object at"
NSQ_SOURCE_LINE 00001320 "the start of a string and identify the portion after the JSON object:"
NSQ_SOURCE_LINE 00001321 ""
NSQ_SOURCE_LINE 00001322 "   my $text = \"[1,2,3] hello\";"
NSQ_SOURCE_LINE 00001323 ""
NSQ_SOURCE_LINE 00001324 "   my $json = new Cpanel::JSON::XS;"
NSQ_SOURCE_LINE 00001325 ""
NSQ_SOURCE_LINE 00001326 "   my $obj = $json->incr_parse ($text)"
NSQ_SOURCE_LINE 00001327 "      or die \"expected JSON object or array at beginning of string\";"
NSQ_SOURCE_LINE 00001328 ""
NSQ_SOURCE_LINE 00001329 "   my $tail = $json->incr_text;"
NSQ_SOURCE_LINE 00001330 "   # $tail now contains \" hello\""
NSQ_SOURCE_LINE 00001331 ""
NSQ_SOURCE_LINE 00001332 "Easy, isn't it?"
NSQ_SOURCE_LINE 00001333 ""
NSQ_SOURCE_LINE 00001334 "Now for a more complicated example: Imagine a hypothetical protocol where"
NSQ_SOURCE_LINE 00001335 "you read some requests from a TCP stream, and each request is a JSON"
NSQ_SOURCE_LINE 00001336 "array, without any separation between them (in fact, it is often useful to"
NSQ_SOURCE_LINE 00001337 "use newlines as \"separators\", as these get interpreted as whitespace at"
NSQ_SOURCE_LINE 00001338 "the start of the JSON text, which makes it possible to test said protocol"
NSQ_SOURCE_LINE 00001339 "with C<telnet>...)."
NSQ_SOURCE_LINE 00001340 ""
NSQ_SOURCE_LINE 00001341 "Here is how you'd do it (it is trivial to write this in an event-based"
NSQ_SOURCE_LINE 00001342 "manner):"
NSQ_SOURCE_LINE 00001343 ""
NSQ_SOURCE_LINE 00001344 "   my $json = new Cpanel::JSON::XS;"
NSQ_SOURCE_LINE 00001345 ""
NSQ_SOURCE_LINE 00001346 "   # read some data from the socket"
NSQ_SOURCE_LINE 00001347 "   while (sysread $socket, my $buf, 4096) {"
NSQ_SOURCE_LINE 00001348 ""
NSQ_SOURCE_LINE 00001349 "      # split and decode as many requests as possible"
NSQ_SOURCE_LINE 00001350 "      for my $request ($json->incr_parse ($buf)) {"
NSQ_SOURCE_LINE 00001351 "         # act on the $request"
NSQ_SOURCE_LINE 00001352 "      }"
NSQ_SOURCE_LINE 00001353 "   }"
NSQ_SOURCE_LINE 00001354 ""
NSQ_SOURCE_LINE 00001355 "Another complicated example: Assume you have a string with JSON objects"
NSQ_SOURCE_LINE 00001356 "or arrays, all separated by (optional) comma characters (e.g. C<[1],[2],"
NSQ_SOURCE_LINE 00001357 "[3]>). To parse them, we have to skip the commas between the JSON texts,"
NSQ_SOURCE_LINE 00001358 "and here is where the lvalue-ness of C<incr_text> comes in useful:"
NSQ_SOURCE_LINE 00001359 ""
NSQ_SOURCE_LINE 00001360 "   my $text = \"[1],[2], [3]\";"
NSQ_SOURCE_LINE 00001361 "   my $json = new Cpanel::JSON::XS;"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "   # void context, so no parsing done"
NSQ_SOURCE_LINE 00001364 "   $json->incr_parse ($text);"
NSQ_SOURCE_LINE 00001365 ""
NSQ_SOURCE_LINE 00001366 "   # now extract as many objects as possible. note the"
NSQ_SOURCE_LINE 00001367 "   # use of scalar context so incr_text can be called."
NSQ_SOURCE_LINE 00001368 "   while (my $obj = $json->incr_parse) {"
NSQ_SOURCE_LINE 00001369 "      # do something with $obj"
NSQ_SOURCE_LINE 00001370 ""
NSQ_SOURCE_LINE 00001371 "      # now skip the optional comma"
NSQ_SOURCE_LINE 00001372 "      $json->incr_text =~ s/^ \\s* , //x;"
NSQ_SOURCE_LINE 00001373 "   }"
NSQ_SOURCE_LINE 00001374 ""
NSQ_SOURCE_LINE 00001375 "Now lets go for a very complex example: Assume that you have a gigantic"
NSQ_SOURCE_LINE 00001376 "JSON array-of-objects, many gigabytes in size, and you want to parse it,"
NSQ_SOURCE_LINE 00001377 "but you cannot load it into memory fully (this has actually happened in"
NSQ_SOURCE_LINE 00001378 "the real world :)."
NSQ_SOURCE_LINE 00001379 ""
NSQ_SOURCE_LINE 00001380 "Well, you lost, you have to implement your own JSON parser. But"
NSQ_SOURCE_LINE 00001381 "Cpanel::JSON::XS can still help you: You implement a (very simple)"
NSQ_SOURCE_LINE 00001382 "array parser and let JSON decode the array elements, which are all"
NSQ_SOURCE_LINE 00001383 "full JSON objects on their own (this wouldn't work if the array"
NSQ_SOURCE_LINE 00001384 "elements could be JSON numbers, for example):"
NSQ_SOURCE_LINE 00001385 ""
NSQ_SOURCE_LINE 00001386 "   my $json = new Cpanel::JSON::XS;"
NSQ_SOURCE_LINE 00001387 ""
NSQ_SOURCE_LINE 00001388 "   # open the monster"
NSQ_SOURCE_LINE 00001389 "   open my $fh, \"<bigfile.json\""
NSQ_SOURCE_LINE 00001390 "      or die \"bigfile: $!\";"
NSQ_SOURCE_LINE 00001391 ""
NSQ_SOURCE_LINE 00001392 "   # first parse the initial \"[\""
NSQ_SOURCE_LINE 00001393 "   for (;;) {"
NSQ_SOURCE_LINE 00001394 "      sysread $fh, my $buf, 65536"
NSQ_SOURCE_LINE 00001395 "         or die \"read error: $!\";"
NSQ_SOURCE_LINE 00001396 "      $json->incr_parse ($buf); # void context, so no parsing"
NSQ_SOURCE_LINE 00001397 ""
NSQ_SOURCE_LINE 00001398 "      # Exit the loop once we found and removed(!) the initial \"[\"."
NSQ_SOURCE_LINE 00001399 "      # In essence, we are (ab-)using the $json object as a simple scalar"
NSQ_SOURCE_LINE 00001400 "      # we append data to."
NSQ_SOURCE_LINE 00001401 "      last if $json->incr_text =~ s/^ \\s* \\[ //x;"
NSQ_SOURCE_LINE 00001402 "   }"
NSQ_SOURCE_LINE 00001403 ""
NSQ_SOURCE_LINE 00001404 "   # now we have the skipped the initial \"[\", so continue"
NSQ_SOURCE_LINE 00001405 "   # parsing all the elements."
NSQ_SOURCE_LINE 00001406 "   for (;;) {"
NSQ_SOURCE_LINE 00001407 "      # in this loop we read data until we got a single JSON object"
NSQ_SOURCE_LINE 00001408 "      for (;;) {"
NSQ_SOURCE_LINE 00001409 "         if (my $obj = $json->incr_parse) {"
NSQ_SOURCE_LINE 00001410 "            # do something with $obj"
NSQ_SOURCE_LINE 00001411 "            last;"
NSQ_SOURCE_LINE 00001412 "         }"
NSQ_SOURCE_LINE 00001413 ""
NSQ_SOURCE_LINE 00001414 "         # add more data"
NSQ_SOURCE_LINE 00001415 "         sysread $fh, my $buf, 65536"
NSQ_SOURCE_LINE 00001416 "            or die \"read error: $!\";"
NSQ_SOURCE_LINE 00001417 "         $json->incr_parse ($buf); # void context, so no parsing"
NSQ_SOURCE_LINE 00001418 "      }"
NSQ_SOURCE_LINE 00001419 ""
NSQ_SOURCE_LINE 00001420 "      # in this loop we read data until we either found and parsed the"
NSQ_SOURCE_LINE 00001421 "      # separating \",\" between elements, or the final \"]\""
NSQ_SOURCE_LINE 00001422 "      for (;;) {"
NSQ_SOURCE_LINE 00001423 "         # first skip whitespace"
NSQ_SOURCE_LINE 00001424 "         $json->incr_text =~ s/^\\s*//;"
NSQ_SOURCE_LINE 00001425 ""
NSQ_SOURCE_LINE 00001426 "         # if we find \"]\", we are done"
NSQ_SOURCE_LINE 00001427 "         if ($json->incr_text =~ s/^\\]//) {"
NSQ_SOURCE_LINE 00001428 "            print \"finished.\\n\";"
NSQ_SOURCE_LINE 00001429 "            exit;"
NSQ_SOURCE_LINE 00001430 "         }"
NSQ_SOURCE_LINE 00001431 ""
NSQ_SOURCE_LINE 00001432 "         # if we find \",\", we can continue with the next element"
NSQ_SOURCE_LINE 00001433 "         if ($json->incr_text =~ s/^,//) {"
NSQ_SOURCE_LINE 00001434 "            last;"
NSQ_SOURCE_LINE 00001435 "         }"
NSQ_SOURCE_LINE 00001436 ""
NSQ_SOURCE_LINE 00001437 "         # if we find anything else, we have a parse error!"
NSQ_SOURCE_LINE 00001438 "         if (length $json->incr_text) {"
NSQ_SOURCE_LINE 00001439 "            die \"parse error near \", $json->incr_text;"
NSQ_SOURCE_LINE 00001440 "         }"
NSQ_SOURCE_LINE 00001441 ""
NSQ_SOURCE_LINE 00001442 "         # else add more data"
NSQ_SOURCE_LINE 00001443 "         sysread $fh, my $buf, 65536"
NSQ_SOURCE_LINE 00001444 "            or die \"read error: $!\";"
NSQ_SOURCE_LINE 00001445 "         $json->incr_parse ($buf); # void context, so no parsing"
NSQ_SOURCE_LINE 00001446 "      }"
NSQ_SOURCE_LINE 00001447 ""
NSQ_SOURCE_LINE 00001448 "This is a complex example, but most of the complexity comes from the fact"
NSQ_SOURCE_LINE 00001449 "that we are trying to be correct (bear with me if I am wrong, I never ran"
NSQ_SOURCE_LINE 00001450 "the above example :)."
NSQ_SOURCE_LINE 00001451 ""
NSQ_SOURCE_LINE 00001452 "=head1 BOM"
NSQ_SOURCE_LINE 00001453 ""
NSQ_SOURCE_LINE 00001454 "Detect all unicode B<Byte Order Marks> on decode."
NSQ_SOURCE_LINE 00001455 "Which are UTF-8, UTF-16LE, UTF-16BE, UTF-32LE and UTF-32BE."
NSQ_SOURCE_LINE 00001456 ""
NSQ_SOURCE_LINE 00001457 "The BOM encoding is set only for one specific decode call, it does not"
NSQ_SOURCE_LINE 00001458 "change the state of the JSON object."
NSQ_SOURCE_LINE 00001459 ""
NSQ_SOURCE_LINE 00001460 "B<Warning>: With perls older than 5.20 you need load the Encode module"
NSQ_SOURCE_LINE 00001461 "before loading a multibyte BOM, i.e. >= UTF-16. Otherwise an error is"
NSQ_SOURCE_LINE 00001462 "thrown. This is an implementation limitation and might get fixed later."
NSQ_SOURCE_LINE 00001463 ""
NSQ_SOURCE_LINE 00001464 "See L<https://tools.ietf.org/html/rfc7159#section-8.1>"
NSQ_SOURCE_LINE 00001465 "I<\"JSON text SHALL be encoded in UTF-8, UTF-16, or UTF-32.\">"
NSQ_SOURCE_LINE 00001466 ""
NSQ_SOURCE_LINE 00001467 "I<\"Implementations MUST NOT add a byte order mark to the beginning of a"
NSQ_SOURCE_LINE 00001468 "JSON text\", \"implementations (...) MAY ignore the presence of a byte"
NSQ_SOURCE_LINE 00001469 "order mark rather than treating it as an error\".>"
NSQ_SOURCE_LINE 00001470 ""
NSQ_SOURCE_LINE 00001471 "See also L<http://www.unicode.org/faq/utf_bom.html#BOM>."
NSQ_SOURCE_LINE 00001472 ""
NSQ_SOURCE_LINE 00001473 "Beware that Cpanel::JSON::XS is currently the only JSON module which"
NSQ_SOURCE_LINE 00001474 "does accept and decode a BOM."
NSQ_SOURCE_LINE 00001475 ""
NSQ_SOURCE_LINE 00001476 "The latest JSON spec"
NSQ_SOURCE_LINE 00001477 "L<https://www.greenbytes.de/tech/webdav/rfc8259.html#character.encoding>"
NSQ_SOURCE_LINE 00001478 "forbid the usage of UTF-16 or UTF-32, the character encoding is UTF-8."
NSQ_SOURCE_LINE 00001479 "Thus in subsequent updates BOM's of UTF-16 or UTF-32 will throw an error."
NSQ_SOURCE_LINE 00001480 ""
NSQ_SOURCE_LINE 00001481 "=head1 MAPPING"
NSQ_SOURCE_LINE 00001482 ""
NSQ_SOURCE_LINE 00001483 "This section describes how Cpanel::JSON::XS maps Perl values to JSON"
NSQ_SOURCE_LINE 00001484 "values and vice versa. These mappings are designed to \"do the right"
NSQ_SOURCE_LINE 00001485 "thing\" in most circumstances automatically, preserving round-tripping"
NSQ_SOURCE_LINE 00001486 "characteristics (what you put in comes out as something equivalent)."
NSQ_SOURCE_LINE 00001487 ""
NSQ_SOURCE_LINE 00001488 "For the more enlightened: note that in the following descriptions,"
NSQ_SOURCE_LINE 00001489 "lowercase I<perl> refers to the Perl interpreter, while uppercase I<Perl>"
NSQ_SOURCE_LINE 00001490 "refers to the abstract Perl language itself."
NSQ_SOURCE_LINE 00001491 ""
NSQ_SOURCE_LINE 00001492 ""
NSQ_SOURCE_LINE 00001493 "=head2 JSON -> PERL"
NSQ_SOURCE_LINE 00001494 ""
NSQ_SOURCE_LINE 00001495 "=over 4"
NSQ_SOURCE_LINE 00001496 ""
NSQ_SOURCE_LINE 00001497 "=item object"
NSQ_SOURCE_LINE 00001498 ""
NSQ_SOURCE_LINE 00001499 "A JSON object becomes a reference to a hash in Perl. No ordering of object"
NSQ_SOURCE_LINE 00001500 "keys is preserved (JSON does not preserve object key ordering itself)."
NSQ_SOURCE_LINE 00001501 ""
NSQ_SOURCE_LINE 00001502 "=item array"
NSQ_SOURCE_LINE 00001503 ""
NSQ_SOURCE_LINE 00001504 "A JSON array becomes a reference to an array in Perl."
NSQ_SOURCE_LINE 00001505 ""
NSQ_SOURCE_LINE 00001506 "=item string"
NSQ_SOURCE_LINE 00001507 ""
NSQ_SOURCE_LINE 00001508 "A JSON string becomes a string scalar in Perl - Unicode codepoints in JSON"
NSQ_SOURCE_LINE 00001509 "are represented by the same codepoints in the Perl string, so no manual"
NSQ_SOURCE_LINE 00001510 "decoding is necessary."
NSQ_SOURCE_LINE 00001511 ""
NSQ_SOURCE_LINE 00001512 "=item number"
NSQ_SOURCE_LINE 00001513 ""
NSQ_SOURCE_LINE 00001514 "A JSON number becomes either an integer, numeric (floating point) or"
NSQ_SOURCE_LINE 00001515 "string scalar in perl, depending on its range and any fractional parts. On"
NSQ_SOURCE_LINE 00001516 "the Perl level, there is no difference between those as Perl handles all"
NSQ_SOURCE_LINE 00001517 "the conversion details, but an integer may take slightly less memory and"
NSQ_SOURCE_LINE 00001518 "might represent more values exactly than floating point numbers."
NSQ_SOURCE_LINE 00001519 ""
NSQ_SOURCE_LINE 00001520 "If the number consists of digits only, Cpanel::JSON::XS will try to"
NSQ_SOURCE_LINE 00001521 "represent it as an integer value. If that fails, it will try to"
NSQ_SOURCE_LINE 00001522 "represent it as a numeric (floating point) value if that is possible"
NSQ_SOURCE_LINE 00001523 "without loss of precision. Otherwise it will preserve the number as a"
NSQ_SOURCE_LINE 00001524 "string value (in which case you lose roundtripping ability, as the"
NSQ_SOURCE_LINE 00001525 "JSON number will be re-encoded to a JSON string)."
NSQ_SOURCE_LINE 00001526 ""
NSQ_SOURCE_LINE 00001527 "Numbers containing a fractional or exponential part will always be"
NSQ_SOURCE_LINE 00001528 "represented as numeric (floating point) values, possibly at a loss of"
NSQ_SOURCE_LINE 00001529 "precision (in which case you might lose perfect roundtripping ability, but"
NSQ_SOURCE_LINE 00001530 "the JSON number will still be re-encoded as a JSON number)."
NSQ_SOURCE_LINE 00001531 ""
NSQ_SOURCE_LINE 00001532 "Note that precision is not accuracy - binary floating point values"
NSQ_SOURCE_LINE 00001533 "cannot represent most decimal fractions exactly, and when converting"
NSQ_SOURCE_LINE 00001534 "from and to floating point, C<Cpanel::JSON::XS> only guarantees precision"
NSQ_SOURCE_LINE 00001535 "up to but not including the least significant bit."
NSQ_SOURCE_LINE 00001536 ""
NSQ_SOURCE_LINE 00001537 "=item true, false"
NSQ_SOURCE_LINE 00001538 ""
NSQ_SOURCE_LINE 00001539 "When C<unblessed_bool> is set to true, then JSON C<true> becomes C<1> and"
NSQ_SOURCE_LINE 00001540 "JSON C<false> becomes C<0>."
NSQ_SOURCE_LINE 00001541 ""
NSQ_SOURCE_LINE 00001542 "Otherwise these JSON atoms become C<JSON::PP::true> and"
NSQ_SOURCE_LINE 00001543 "C<JSON::PP::false>, respectively. They are C<JSON::PP::Boolean>"
NSQ_SOURCE_LINE 00001544 "objects and are overloaded to act almost exactly like the numbers C<1>"
NSQ_SOURCE_LINE 00001545 "and C<0>. You can check whether a scalar is a JSON boolean by using"
NSQ_SOURCE_LINE 00001546 "the C<Cpanel::JSON::XS::is_bool> function."
NSQ_SOURCE_LINE 00001547 ""
NSQ_SOURCE_LINE 00001548 "The other round, from perl to JSON, C<!0> which is represented as"
NSQ_SOURCE_LINE 00001549 "C<yes> becomes C<true>, and C<!1> which is represented as"
NSQ_SOURCE_LINE 00001550 "C<no> becomes C<false>."
NSQ_SOURCE_LINE 00001551 ""
NSQ_SOURCE_LINE 00001552 "Via L<Cpanel::JSON::XS::Type> you can now even force negation in C<encode>,"
NSQ_SOURCE_LINE 00001553 "without overloading of C<!>:"
NSQ_SOURCE_LINE 00001554 ""
NSQ_SOURCE_LINE 00001555 "    my $false = Cpanel::JSON::XS::false;"
NSQ_SOURCE_LINE 00001556 "    print($json->encode([!$false], [JSON_TYPE_BOOL]));"
NSQ_SOURCE_LINE 00001557 "    => [true]"
NSQ_SOURCE_LINE 00001558 ""
NSQ_SOURCE_LINE 00001559 "=item null"
NSQ_SOURCE_LINE 00001560 ""
NSQ_SOURCE_LINE 00001561 "A JSON null atom becomes C<undef> in Perl."
NSQ_SOURCE_LINE 00001562 ""
NSQ_SOURCE_LINE 00001563 "=item shell-style comments (C<< # I<text> >>)"
NSQ_SOURCE_LINE 00001564 ""
NSQ_SOURCE_LINE 00001565 "As a nonstandard extension to the JSON syntax that is enabled by the"
NSQ_SOURCE_LINE 00001566 "C<relaxed> setting, shell-style comments are allowed. They can start"
NSQ_SOURCE_LINE 00001567 "anywhere outside strings and go till the end of the line."
NSQ_SOURCE_LINE 00001568 ""
NSQ_SOURCE_LINE 00001569 "=item tagged values (C<< (I<tag>)I<value> >>)."
NSQ_SOURCE_LINE 00001570 ""
NSQ_SOURCE_LINE 00001571 "Another nonstandard extension to the JSON syntax, enabled with the"
NSQ_SOURCE_LINE 00001572 "C<allow_tags> setting, are tagged values. In this implementation, the"
NSQ_SOURCE_LINE 00001573 "I<tag> must be a perl package/class name encoded as a JSON string, and the"
NSQ_SOURCE_LINE 00001574 "I<value> must be a JSON array encoding optional constructor arguments."
NSQ_SOURCE_LINE 00001575 ""
NSQ_SOURCE_LINE 00001576 "See L<OBJECT SERIALIZATION>, below, for details."
NSQ_SOURCE_LINE 00001577 ""
NSQ_SOURCE_LINE 00001578 "=back"
NSQ_SOURCE_LINE 00001579 ""
NSQ_SOURCE_LINE 00001580 ""
NSQ_SOURCE_LINE 00001581 "=head2 PERL -> JSON"
NSQ_SOURCE_LINE 00001582 ""
NSQ_SOURCE_LINE 00001583 "The mapping from Perl to JSON is slightly more difficult, as Perl is a"
NSQ_SOURCE_LINE 00001584 "truly typeless language, so we can only guess which JSON type is meant by"
NSQ_SOURCE_LINE 00001585 "a Perl value."
NSQ_SOURCE_LINE 00001586 ""
NSQ_SOURCE_LINE 00001587 "=over 4"
NSQ_SOURCE_LINE 00001588 ""
NSQ_SOURCE_LINE 00001589 "=item hash references"
NSQ_SOURCE_LINE 00001590 ""
NSQ_SOURCE_LINE 00001591 "Perl hash references become JSON objects. As there is no inherent ordering"
NSQ_SOURCE_LINE 00001592 "in hash keys (or JSON objects), they will usually be encoded in a"
NSQ_SOURCE_LINE 00001593 "pseudo-random order that can change between runs of the same program but"
NSQ_SOURCE_LINE 00001594 "stays generally the same within a single run of a program. Cpanel::JSON::XS can"
NSQ_SOURCE_LINE 00001595 "optionally sort the hash keys (determined by the I<canonical> flag), so"
NSQ_SOURCE_LINE 00001596 "the same datastructure will serialize to the same JSON text (given same"
NSQ_SOURCE_LINE 00001597 "settings and version of Cpanel::JSON::XS), but this incurs a runtime overhead"
NSQ_SOURCE_LINE 00001598 "and is only rarely useful, e.g. when you want to compare some JSON text"
NSQ_SOURCE_LINE 00001599 "against another for equality."
NSQ_SOURCE_LINE 00001600 ""
NSQ_SOURCE_LINE 00001601 "=item array references"
NSQ_SOURCE_LINE 00001602 ""
NSQ_SOURCE_LINE 00001603 "Perl array references become JSON arrays."
NSQ_SOURCE_LINE 00001604 ""
NSQ_SOURCE_LINE 00001605 "=item other references"
NSQ_SOURCE_LINE 00001606 ""
NSQ_SOURCE_LINE 00001607 "Other unblessed references are generally not allowed and will cause an"
NSQ_SOURCE_LINE 00001608 "exception to be thrown, except for references to the integers C<0> and"
NSQ_SOURCE_LINE 00001609 "C<1>, which get turned into C<false> and C<true> atoms in JSON. "
NSQ_SOURCE_LINE 00001610 ""
NSQ_SOURCE_LINE 00001611 "With the option C<allow_stringify>, you can ignore the exception and return"
NSQ_SOURCE_LINE 00001612 "the stringification of the perl value."
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "With the option C<allow_unknown>, you can ignore the exception and"
NSQ_SOURCE_LINE 00001615 "return C<null> instead."
NSQ_SOURCE_LINE 00001616 ""
NSQ_SOURCE_LINE 00001617 "   encode_json [\\\"x\"]        # => cannot encode reference to scalar 'SCALAR(0x..)'"
NSQ_SOURCE_LINE 00001618 "                             # unless the scalar is 0 or 1"
NSQ_SOURCE_LINE 00001619 "   encode_json [\\0, \\1]      # yields [false,true]"
NSQ_SOURCE_LINE 00001620 ""
NSQ_SOURCE_LINE 00001621 "   allow_stringify->encode_json [\\\"x\"] # yields \"x\" unlike JSON::PP"
NSQ_SOURCE_LINE 00001622 "   allow_unknown->encode_json [\\\"x\"]   # yields null as in JSON::PP"
NSQ_SOURCE_LINE 00001623 ""
NSQ_SOURCE_LINE 00001624 "=item Cpanel::JSON::XS::true, Cpanel::JSON::XS::false"
NSQ_SOURCE_LINE 00001625 ""
NSQ_SOURCE_LINE 00001626 "These special values become JSON true and JSON false values,"
NSQ_SOURCE_LINE 00001627 "respectively. You can also use C<\\1> and C<\\0> or C<!0> and C<!1>"
NSQ_SOURCE_LINE 00001628 "directly if you want."
NSQ_SOURCE_LINE 00001629 ""
NSQ_SOURCE_LINE 00001630 "   encode_json [Cpanel::JSON::XS::false, Cpanel::JSON::XS::true] # yields [false,true]"
NSQ_SOURCE_LINE 00001631 "   encode_json [!1, !0], [JSON_TYPE_BOOL, JSON_TYPE_BOOL] # yields [false,true]"
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "eq/ne comparisons with true, false:"
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "false is eq to the empty string or the string 'false' or the special"
NSQ_SOURCE_LINE 00001636 "empty string C<!!0> or C<!1>, i.e. C<SV_NO>, or the numbers 0 or 0.0."
NSQ_SOURCE_LINE 00001637 ""
NSQ_SOURCE_LINE 00001638 "true is eq to the string 'true' or to the special string C<!0>"
NSQ_SOURCE_LINE 00001639 "(i.e. C<SV_YES>) or to the numbers 1 or 1.0."
NSQ_SOURCE_LINE 00001640 ""
NSQ_SOURCE_LINE 00001641 "=item blessed objects"
NSQ_SOURCE_LINE 00001642 ""
NSQ_SOURCE_LINE 00001643 "Blessed objects are not directly representable in JSON, but"
NSQ_SOURCE_LINE 00001644 "C<Cpanel::JSON::XS> allows various optional ways of handling"
NSQ_SOURCE_LINE 00001645 "objects. See L<OBJECT SERIALIZATION>, below, for details."
NSQ_SOURCE_LINE 00001646 ""
NSQ_SOURCE_LINE 00001647 "See the C<allow_blessed> and C<convert_blessed> methods on various"
NSQ_SOURCE_LINE 00001648 "options on how to deal with this: basically, you can choose between"
NSQ_SOURCE_LINE 00001649 "throwing an exception, encoding the reference as if it weren't"
NSQ_SOURCE_LINE 00001650 "blessed, use the objects overloaded stringification method or provide"
NSQ_SOURCE_LINE 00001651 "your own serializer method."
NSQ_SOURCE_LINE 00001652 ""
NSQ_SOURCE_LINE 00001653 "=item simple scalars"
NSQ_SOURCE_LINE 00001654 ""
NSQ_SOURCE_LINE 00001655 "Simple Perl scalars (any scalar that is not a reference) are the most"
NSQ_SOURCE_LINE 00001656 "difficult objects to encode: Cpanel::JSON::XS will encode undefined"
NSQ_SOURCE_LINE 00001657 "scalars or inf/nan as JSON C<null> values and other scalars to either"
NSQ_SOURCE_LINE 00001658 "number or string in non-deterministic way which may be affected or"
NSQ_SOURCE_LINE 00001659 "changed by Perl version or any other loaded Perl module."
NSQ_SOURCE_LINE 00001660 ""
NSQ_SOURCE_LINE 00001661 "If you want to have stable and deterministic types in JSON encoder then"
NSQ_SOURCE_LINE 00001662 "use L<Cpanel::JSON::XS::Type>."
NSQ_SOURCE_LINE 00001663 ""
NSQ_SOURCE_LINE 00001664 "Alternative way for deterministic types is to use C<type_all_string>"
NSQ_SOURCE_LINE 00001665 "method when all perl scalars are encoded to JSON strings."
NSQ_SOURCE_LINE 00001666 ""
NSQ_SOURCE_LINE 00001667 "Non-deterministic behavior is following: scalars that have last been"
NSQ_SOURCE_LINE 00001668 "used in a string context before encoding as JSON strings, and anything"
NSQ_SOURCE_LINE 00001669 "else as number value:"
NSQ_SOURCE_LINE 00001670 ""
NSQ_SOURCE_LINE 00001671 "   # dump as number"
NSQ_SOURCE_LINE 00001672 "   encode_json [2]                      # yields [2]"
NSQ_SOURCE_LINE 00001673 "   encode_json [-3.0e17]                # yields [-3e+17]"
NSQ_SOURCE_LINE 00001674 "   my $value = 5; encode_json [$value]  # yields [5]"
NSQ_SOURCE_LINE 00001675 ""
NSQ_SOURCE_LINE 00001676 "   # used as string, but the two representations are for the same number"
NSQ_SOURCE_LINE 00001677 "   print $value;"
NSQ_SOURCE_LINE 00001678 "   encode_json [$value]                 # yields [5]"
NSQ_SOURCE_LINE 00001679 ""
NSQ_SOURCE_LINE 00001680 "   # used as different string (non-matching dual-var)"
NSQ_SOURCE_LINE 00001681 "   my $str = '0 but true';"
NSQ_SOURCE_LINE 00001682 "   my $num = 1 + $str;"
NSQ_SOURCE_LINE 00001683 "   encode_json [$num, $str]           # yields [1,\"0 but true\"]"
NSQ_SOURCE_LINE 00001684 ""
NSQ_SOURCE_LINE 00001685 "   # undef becomes null"
NSQ_SOURCE_LINE 00001686 "   encode_json [undef]                  # yields [null]"
NSQ_SOURCE_LINE 00001687 ""
NSQ_SOURCE_LINE 00001688 "   # inf or nan becomes null, unless you answered"
NSQ_SOURCE_LINE 00001689 "   # \"Do you want to handle inf/nan as strings\" with yes"
NSQ_SOURCE_LINE 00001690 "   encode_json [9**9**9]                # yields [null]"
NSQ_SOURCE_LINE 00001691 ""
NSQ_SOURCE_LINE 00001692 "You can force the type to be a JSON string by stringifying it:"
NSQ_SOURCE_LINE 00001693 ""
NSQ_SOURCE_LINE 00001694 "   my $x = 3.1; # some variable containing a number"
NSQ_SOURCE_LINE 00001695 "   \"$x\";        # stringified"
NSQ_SOURCE_LINE 00001696 "   $x .= \"\";    # another, more awkward way to stringify"
NSQ_SOURCE_LINE 00001697 "   print $x;    # perl does it for you, too, quite often"
NSQ_SOURCE_LINE 00001698 ""
NSQ_SOURCE_LINE 00001699 "You can force the type to be a JSON number by numifying it:"
NSQ_SOURCE_LINE 00001700 ""
NSQ_SOURCE_LINE 00001701 "   my $x = \"3\"; # some variable containing a string"
NSQ_SOURCE_LINE 00001702 "   $x += 0;     # numify it, ensuring it will be dumped as a number"
NSQ_SOURCE_LINE 00001703 "   $x *= 1;     # same thing, the choice is yours."
NSQ_SOURCE_LINE 00001704 ""
NSQ_SOURCE_LINE 00001705 "Note that numerical precision has the same meaning as under Perl (so"
NSQ_SOURCE_LINE 00001706 "binary to decimal conversion follows the same rules as in Perl, which"
NSQ_SOURCE_LINE 00001707 "can differ to other languages). Also, your perl interpreter might expose"
NSQ_SOURCE_LINE 00001708 "extensions to the floating point numbers of your platform, such as"
NSQ_SOURCE_LINE 00001709 "infinities or NaN's - these cannot be represented in JSON, and thus"
NSQ_SOURCE_LINE 00001710 "null is returned instead. Optionally you can configure it to stringify"
NSQ_SOURCE_LINE 00001711 "inf and nan values."
NSQ_SOURCE_LINE 00001712 ""
NSQ_SOURCE_LINE 00001713 "=back"
NSQ_SOURCE_LINE 00001714 ""
NSQ_SOURCE_LINE 00001715 "=head2 OBJECT SERIALIZATION"
NSQ_SOURCE_LINE 00001716 ""
NSQ_SOURCE_LINE 00001717 "As JSON cannot directly represent Perl objects, you have to choose between"
NSQ_SOURCE_LINE 00001718 "a pure JSON representation (without the ability to deserialize the object"
NSQ_SOURCE_LINE 00001719 "automatically again), and a nonstandard extension to the JSON syntax,"
NSQ_SOURCE_LINE 00001720 "tagged values."
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "=head3 SERIALIZATION"
NSQ_SOURCE_LINE 00001723 ""
NSQ_SOURCE_LINE 00001724 "What happens when C<Cpanel::JSON::XS> encounters a Perl object depends"
NSQ_SOURCE_LINE 00001725 "on the C<allow_blessed>, C<convert_blessed> and C<allow_tags>"
NSQ_SOURCE_LINE 00001726 "settings, which are used in this order:"
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "=over 4"
NSQ_SOURCE_LINE 00001729 ""
NSQ_SOURCE_LINE 00001730 "=item 1. C<allow_tags> is enabled and the object has a C<FREEZE> method."
NSQ_SOURCE_LINE 00001731 ""
NSQ_SOURCE_LINE 00001732 "In this case, C<Cpanel::JSON::XS> uses the L<Types::Serialiser> object"
NSQ_SOURCE_LINE 00001733 "serialization protocol to create a tagged JSON value, using a nonstandard"
NSQ_SOURCE_LINE 00001734 "extension to the JSON syntax."
NSQ_SOURCE_LINE 00001735 ""
NSQ_SOURCE_LINE 00001736 "This works by invoking the C<FREEZE> method on the object, with the first"
NSQ_SOURCE_LINE 00001737 "argument being the object to serialize, and the second argument being the"
NSQ_SOURCE_LINE 00001738 "constant string C<JSON> to distinguish it from other serializers."
NSQ_SOURCE_LINE 00001739 ""
NSQ_SOURCE_LINE 00001740 "The C<FREEZE> method can return any number of values (i.e. zero or"
NSQ_SOURCE_LINE 00001741 "more). These values and the paclkage/classname of the object will then be"
NSQ_SOURCE_LINE 00001742 "encoded as a tagged JSON value in the following format:"
NSQ_SOURCE_LINE 00001743 ""
NSQ_SOURCE_LINE 00001744 "   (\"classname\")[FREEZE return values...]"
NSQ_SOURCE_LINE 00001745 ""
NSQ_SOURCE_LINE 00001746 "e.g.:"
NSQ_SOURCE_LINE 00001747 ""
NSQ_SOURCE_LINE 00001748 "   (\"URI\")[\"http://www.google.com/\"]"
NSQ_SOURCE_LINE 00001749 "   (\"MyDate\")[2013,10,29]"
NSQ_SOURCE_LINE 00001750 "   (\"ImageData::JPEG\")[\"Z3...VlCg==\"]"
NSQ_SOURCE_LINE 00001751 ""
NSQ_SOURCE_LINE 00001752 "For example, the hypothetical C<My::Object> C<FREEZE> method might use the"
NSQ_SOURCE_LINE 00001753 "objects C<type> and C<id> members to encode the object:"
NSQ_SOURCE_LINE 00001754 ""
NSQ_SOURCE_LINE 00001755 "   sub My::Object::FREEZE {"
NSQ_SOURCE_LINE 00001756 "      my ($self, $serializer) = @_;"
NSQ_SOURCE_LINE 00001757 ""
NSQ_SOURCE_LINE 00001758 "      ($self->{type}, $self->{id})"
NSQ_SOURCE_LINE 00001759 "   }"
NSQ_SOURCE_LINE 00001760 ""
NSQ_SOURCE_LINE 00001761 "=item 2. C<convert_blessed> is enabled and the object has a C<TO_JSON> method."
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 "In this case, the C<TO_JSON> method of the object is invoked in scalar"
NSQ_SOURCE_LINE 00001764 "context. It must return a single scalar that can be directly encoded into"
NSQ_SOURCE_LINE 00001765 "JSON. This scalar replaces the object in the JSON text."
NSQ_SOURCE_LINE 00001766 ""
NSQ_SOURCE_LINE 00001767 "For example, the following C<TO_JSON> method will convert all L<URI>"
NSQ_SOURCE_LINE 00001768 "objects to JSON strings when serialized. The fact that these values"
NSQ_SOURCE_LINE 00001769 "originally were L<URI> objects is lost."
NSQ_SOURCE_LINE 00001770 ""
NSQ_SOURCE_LINE 00001771 "   sub URI::TO_JSON {"
NSQ_SOURCE_LINE 00001772 "      my ($uri) = @_;"
NSQ_SOURCE_LINE 00001773 "      $uri->as_string"
NSQ_SOURCE_LINE 00001774 "   }"
NSQ_SOURCE_LINE 00001775 ""
NSQ_SOURCE_LINE 00001776 "=item 3. C<convert_blessed> is enabled and the object has a stringification overload."
NSQ_SOURCE_LINE 00001777 ""
NSQ_SOURCE_LINE 00001778 "In this case, the overloaded C<\"\"> method of the object is invoked in scalar"
NSQ_SOURCE_LINE 00001779 "context. It must return a single scalar that can be directly encoded into"
NSQ_SOURCE_LINE 00001780 "JSON. This scalar replaces the object in the JSON text."
NSQ_SOURCE_LINE 00001781 ""
NSQ_SOURCE_LINE 00001782 "For example, the following C<\"\"> method will convert all L<URI>"
NSQ_SOURCE_LINE 00001783 "objects to JSON strings when serialized. The fact that these values"
NSQ_SOURCE_LINE 00001784 "originally were L<URI> objects is lost."
NSQ_SOURCE_LINE 00001785 ""
NSQ_SOURCE_LINE 00001786 "    package URI;"
NSQ_SOURCE_LINE 00001787 "    use overload '\"\"' => sub { shift->as_string };"
NSQ_SOURCE_LINE 00001788 ""
NSQ_SOURCE_LINE 00001789 "=item 4. C<allow_blessed> is enabled."
NSQ_SOURCE_LINE 00001790 ""
NSQ_SOURCE_LINE 00001791 "The object will be serialized as a JSON null value."
NSQ_SOURCE_LINE 00001792 ""
NSQ_SOURCE_LINE 00001793 "=item 5. none of the above"
NSQ_SOURCE_LINE 00001794 ""
NSQ_SOURCE_LINE 00001795 "If none of the settings are enabled or the respective methods are missing,"
NSQ_SOURCE_LINE 00001796 "C<Cpanel::JSON::XS> throws an exception."
NSQ_SOURCE_LINE 00001797 ""
NSQ_SOURCE_LINE 00001798 "=back"
NSQ_SOURCE_LINE 00001799 ""
NSQ_SOURCE_LINE 00001800 "=head3 DESERIALIZATION"
NSQ_SOURCE_LINE 00001801 ""
NSQ_SOURCE_LINE 00001802 "For deserialization there are only two cases to consider: either"
NSQ_SOURCE_LINE 00001803 "nonstandard tagging was used, in which case C<allow_tags> decides,"
NSQ_SOURCE_LINE 00001804 "or objects cannot be automatically be deserialized, in which"
NSQ_SOURCE_LINE 00001805 "case you can use postprocessing or the C<filter_json_object> or"
NSQ_SOURCE_LINE 00001806 "C<filter_json_single_key_object> callbacks to get some real objects our of"
NSQ_SOURCE_LINE 00001807 "your JSON."
NSQ_SOURCE_LINE 00001808 ""
NSQ_SOURCE_LINE 00001809 "This section only considers the tagged value case: I a tagged JSON object"
NSQ_SOURCE_LINE 00001810 "is encountered during decoding and C<allow_tags> is disabled, a parse"
NSQ_SOURCE_LINE 00001811 "error will result (as if tagged values were not part of the grammar)."
NSQ_SOURCE_LINE 00001812 ""
NSQ_SOURCE_LINE 00001813 "If C<allow_tags> is enabled, C<Cpanel::JSON::XS> will look up the C<THAW> method"
NSQ_SOURCE_LINE 00001814 "of the package/classname used during serialization (it will not attempt"
NSQ_SOURCE_LINE 00001815 "to load the package as a Perl module). If there is no such method, the"
NSQ_SOURCE_LINE 00001816 "decoding will fail with an error."
NSQ_SOURCE_LINE 00001817 ""
NSQ_SOURCE_LINE 00001818 "Otherwise, the C<THAW> method is invoked with the classname as first"
NSQ_SOURCE_LINE 00001819 "argument, the constant string C<JSON> as second argument, and all the"
NSQ_SOURCE_LINE 00001820 "values from the JSON array (the values originally returned by the"
NSQ_SOURCE_LINE 00001821 "C<FREEZE> method) as remaining arguments."
NSQ_SOURCE_LINE 00001822 ""
NSQ_SOURCE_LINE 00001823 "The method must then return the object. While technically you can return"
NSQ_SOURCE_LINE 00001824 "any Perl scalar, you might have to enable the C<enable_nonref> setting to"
NSQ_SOURCE_LINE 00001825 "make that work in all cases, so better return an actual blessed reference."
NSQ_SOURCE_LINE 00001826 ""
NSQ_SOURCE_LINE 00001827 "As an example, let's implement a C<THAW> function that regenerates the"
NSQ_SOURCE_LINE 00001828 "C<My::Object> from the C<FREEZE> example earlier:"
NSQ_SOURCE_LINE 00001829 ""
NSQ_SOURCE_LINE 00001830 "   sub My::Object::THAW {"
NSQ_SOURCE_LINE 00001831 "      my ($class, $serializer, $type, $id) = @_;"
NSQ_SOURCE_LINE 00001832 ""
NSQ_SOURCE_LINE 00001833 "      $class->new (type => $type, id => $id)"
NSQ_SOURCE_LINE 00001834 "   }"
NSQ_SOURCE_LINE 00001835 ""
NSQ_SOURCE_LINE 00001836 "See the L</SECURITY CONSIDERATIONS> section below. Allowing external"
NSQ_SOURCE_LINE 00001837 "json objects being deserialized to perl objects is usually a very bad"
NSQ_SOURCE_LINE 00001838 "idea."
NSQ_SOURCE_LINE 00001839 ""
NSQ_SOURCE_LINE 00001840 ""
NSQ_SOURCE_LINE 00001841 "=head1 ENCODING/CODESET FLAG NOTES"
NSQ_SOURCE_LINE 00001842 ""
NSQ_SOURCE_LINE 00001843 "The interested reader might have seen a number of flags that signify"
NSQ_SOURCE_LINE 00001844 "encodings or codesets - C<utf8>, C<latin1>, C<binary> and"
NSQ_SOURCE_LINE 00001845 "C<ascii>. There seems to be some confusion on what these do, so here"
NSQ_SOURCE_LINE 00001846 "is a short comparison:"
NSQ_SOURCE_LINE 00001847 ""
NSQ_SOURCE_LINE 00001848 "C<utf8> controls whether the JSON text created by C<encode> (and expected"
NSQ_SOURCE_LINE 00001849 "by C<decode>) is UTF-8 encoded or not, while C<latin1> and C<ascii> only"
NSQ_SOURCE_LINE 00001850 "control whether C<encode> escapes character values outside their respective"
NSQ_SOURCE_LINE 00001851 "codeset range. Neither of these flags conflict with each other, although"
NSQ_SOURCE_LINE 00001852 "some combinations make less sense than others."
NSQ_SOURCE_LINE 00001853 ""
NSQ_SOURCE_LINE 00001854 "Care has been taken to make all flags symmetrical with respect to"
NSQ_SOURCE_LINE 00001855 "C<encode> and C<decode>, that is, texts encoded with any combination of"
NSQ_SOURCE_LINE 00001856 "these flag values will be correctly decoded when the same flags are used"
NSQ_SOURCE_LINE 00001857 "- in general, if you use different flag settings while encoding vs. when"
NSQ_SOURCE_LINE 00001858 "decoding you likely have a bug somewhere."
NSQ_SOURCE_LINE 00001859 ""
NSQ_SOURCE_LINE 00001860 "Below comes a verbose discussion of these flags. Note that a \"codeset\" is"
NSQ_SOURCE_LINE 00001861 "simply an abstract set of character-codepoint pairs, while an encoding"
NSQ_SOURCE_LINE 00001862 "takes those codepoint numbers and I<encodes> them, in our case into"
NSQ_SOURCE_LINE 00001863 "octets. Unicode is (among other things) a codeset, UTF-8 is an encoding,"
NSQ_SOURCE_LINE 00001864 "and ISO-8859-1 (= latin 1) and ASCII are both codesets I<and> encodings at"
NSQ_SOURCE_LINE 00001865 "the same time, which can be confusing."
NSQ_SOURCE_LINE 00001866 ""
NSQ_SOURCE_LINE 00001867 "=over 4"
NSQ_SOURCE_LINE 00001868 ""
NSQ_SOURCE_LINE 00001869 "=item C<utf8> flag disabled"
NSQ_SOURCE_LINE 00001870 ""
NSQ_SOURCE_LINE 00001871 "When C<utf8> is disabled (the default), then C<encode>/C<decode> generate"
NSQ_SOURCE_LINE 00001872 "and expect Unicode strings, that is, characters with high ordinal Unicode"
NSQ_SOURCE_LINE 00001873 "values (> 255) will be encoded as such characters, and likewise such"
NSQ_SOURCE_LINE 00001874 "characters are decoded as-is, no changes to them will be done, except"
NSQ_SOURCE_LINE 00001875 "\"(re-)interpreting\" them as Unicode codepoints or Unicode characters,"
NSQ_SOURCE_LINE 00001876 "respectively (to Perl, these are the same thing in strings unless you do"
NSQ_SOURCE_LINE 00001877 "funny/weird/dumb stuff)."
NSQ_SOURCE_LINE 00001878 ""
NSQ_SOURCE_LINE 00001879 "This is useful when you want to do the encoding yourself (e.g. when you"
NSQ_SOURCE_LINE 00001880 "want to have UTF-16 encoded JSON texts) or when some other layer does"
NSQ_SOURCE_LINE 00001881 "the encoding for you (for example, when printing to a terminal using a"
NSQ_SOURCE_LINE 00001882 "filehandle that transparently encodes to UTF-8 you certainly do NOT want"
NSQ_SOURCE_LINE 00001883 "to UTF-8 encode your data first and have Perl encode it another time)."
NSQ_SOURCE_LINE 00001884 ""
NSQ_SOURCE_LINE 00001885 "=item C<utf8> flag enabled"
NSQ_SOURCE_LINE 00001886 ""
NSQ_SOURCE_LINE 00001887 "If the C<utf8>-flag is enabled, C<encode>/C<decode> will encode all"
NSQ_SOURCE_LINE 00001888 "characters using the corresponding UTF-8 multi-byte sequence, and will"
NSQ_SOURCE_LINE 00001889 "expect your input strings to be encoded as UTF-8, that is, no \"character\""
NSQ_SOURCE_LINE 00001890 "of the input string must have any value > 255, as UTF-8 does not allow"
NSQ_SOURCE_LINE 00001891 "that."
NSQ_SOURCE_LINE 00001892 ""
NSQ_SOURCE_LINE 00001893 "The C<utf8> flag therefore switches between two modes: disabled means you"
NSQ_SOURCE_LINE 00001894 "will get a Unicode string in Perl, enabled means you get an UTF-8 encoded"
NSQ_SOURCE_LINE 00001895 "octet/binary string in Perl."
NSQ_SOURCE_LINE 00001896 ""
NSQ_SOURCE_LINE 00001897 "=item C<latin1>, C<binary> or C<ascii> flags enabled"
NSQ_SOURCE_LINE 00001898 ""
NSQ_SOURCE_LINE 00001899 "With C<latin1> (or C<ascii>) enabled, C<encode> will escape"
NSQ_SOURCE_LINE 00001900 "characters with ordinal values > 255 (> 127 with C<ascii>) and encode"
NSQ_SOURCE_LINE 00001901 "the remaining characters as specified by the C<utf8> flag."
NSQ_SOURCE_LINE 00001902 "With C<binary> enabled, ordinal values > 255 are illegal."
NSQ_SOURCE_LINE 00001903 ""
NSQ_SOURCE_LINE 00001904 "If C<utf8> is disabled, then the result is also correctly encoded in those"
NSQ_SOURCE_LINE 00001905 "character sets (as both are proper subsets of Unicode, meaning that a"
NSQ_SOURCE_LINE 00001906 "Unicode string with all character values < 256 is the same thing as a"
NSQ_SOURCE_LINE 00001907 "ISO-8859-1 string, and a Unicode string with all character values < 128 is"
NSQ_SOURCE_LINE 00001908 "the same thing as an ASCII string in Perl)."
NSQ_SOURCE_LINE 00001909 ""
NSQ_SOURCE_LINE 00001910 "If C<utf8> is enabled, you still get a correct UTF-8-encoded string,"
NSQ_SOURCE_LINE 00001911 "regardless of these flags, just some more characters will be escaped using"
NSQ_SOURCE_LINE 00001912 "C<\\uXXXX> then before."
NSQ_SOURCE_LINE 00001913 ""
NSQ_SOURCE_LINE 00001914 "Note that ISO-8859-1-I<encoded> strings are not compatible with UTF-8"
NSQ_SOURCE_LINE 00001915 "encoding, while ASCII-encoded strings are. That is because the ISO-8859-1"
NSQ_SOURCE_LINE 00001916 "encoding is NOT a subset of UTF-8 (despite the ISO-8859-1 I<codeset> being"
NSQ_SOURCE_LINE 00001917 "a subset of Unicode), while ASCII is."
NSQ_SOURCE_LINE 00001918 ""
NSQ_SOURCE_LINE 00001919 "Surprisingly, C<decode> will ignore these flags and so treat all input"
NSQ_SOURCE_LINE 00001920 "values as governed by the C<utf8> flag. If it is disabled, this allows you"
NSQ_SOURCE_LINE 00001921 "to decode ISO-8859-1- and ASCII-encoded strings, as both strict subsets of"
NSQ_SOURCE_LINE 00001922 "Unicode. If it is enabled, you can correctly decode UTF-8 encoded strings."
NSQ_SOURCE_LINE 00001923 ""
NSQ_SOURCE_LINE 00001924 "So neither C<latin1>, C<binary> nor C<ascii> are incompatible with the"
NSQ_SOURCE_LINE 00001925 "C<utf8> flag - they only govern when the JSON output engine escapes a"
NSQ_SOURCE_LINE 00001926 "character or not."
NSQ_SOURCE_LINE 00001927 ""
NSQ_SOURCE_LINE 00001928 "The main use for C<latin1> or C<binary> is to relatively efficiently"
NSQ_SOURCE_LINE 00001929 "store binary data as JSON, at the expense of breaking compatibility"
NSQ_SOURCE_LINE 00001930 "with most JSON decoders."
NSQ_SOURCE_LINE 00001931 ""
NSQ_SOURCE_LINE 00001932 "The main use for C<ascii> is to force the output to not contain characters"
NSQ_SOURCE_LINE 00001933 "with values > 127, which means you can interpret the resulting string"
NSQ_SOURCE_LINE 00001934 "as UTF-8, ISO-8859-1, ASCII, KOI8-R or most about any character set and"
NSQ_SOURCE_LINE 00001935 "8-bit-encoding, and still get the same data structure back. This is useful"
NSQ_SOURCE_LINE 00001936 "when your channel for JSON transfer is not 8-bit clean or the encoding"
NSQ_SOURCE_LINE 00001937 "might be mangled in between (e.g. in mail), and works because ASCII is a"
NSQ_SOURCE_LINE 00001938 "proper subset of most 8-bit and multibyte encodings in use in the world."
NSQ_SOURCE_LINE 00001939 ""
NSQ_SOURCE_LINE 00001940 "=back"
NSQ_SOURCE_LINE 00001941 ""
NSQ_SOURCE_LINE 00001942 ""
NSQ_SOURCE_LINE 00001943 "=head2 JSON and ECMAscript"
NSQ_SOURCE_LINE 00001944 ""
NSQ_SOURCE_LINE 00001945 "JSON syntax is based on how literals are represented in javascript (the"
NSQ_SOURCE_LINE 00001946 "not-standardized predecessor of ECMAscript) which is presumably why it is"
NSQ_SOURCE_LINE 00001947 "called \"JavaScript Object Notation\"."
NSQ_SOURCE_LINE 00001948 ""
NSQ_SOURCE_LINE 00001949 "However, JSON is not a subset (and also not a superset of course) of"
NSQ_SOURCE_LINE 00001950 "ECMAscript (the standard) or javascript (whatever browsers actually"
NSQ_SOURCE_LINE 00001951 "implement)."
NSQ_SOURCE_LINE 00001952 ""
NSQ_SOURCE_LINE 00001953 "If you want to use javascript's C<eval> function to \"parse\" JSON, you"
NSQ_SOURCE_LINE 00001954 "might run into parse errors for valid JSON texts, or the resulting data"
NSQ_SOURCE_LINE 00001955 "structure might not be queryable:"
NSQ_SOURCE_LINE 00001956 ""
NSQ_SOURCE_LINE 00001957 "One of the problems is that U+2028 and U+2029 are valid characters inside"
NSQ_SOURCE_LINE 00001958 "JSON strings, but are not allowed in ECMAscript string literals, so the"
NSQ_SOURCE_LINE 00001959 "following Perl fragment will not output something that can be guaranteed"
NSQ_SOURCE_LINE 00001960 "to be parsable by javascript's C<eval>:"
NSQ_SOURCE_LINE 00001961 ""
NSQ_SOURCE_LINE 00001962 "   use Cpanel::JSON::XS;"
NSQ_SOURCE_LINE 00001963 ""
NSQ_SOURCE_LINE 00001964 "   print encode_json [chr 0x2028];"
NSQ_SOURCE_LINE 00001965 ""
NSQ_SOURCE_LINE 00001966 "The right fix for this is to use a proper JSON parser in your javascript"
NSQ_SOURCE_LINE 00001967 "programs, and not rely on C<eval> (see for example Douglas Crockford's"
NSQ_SOURCE_LINE 00001968 "F<json2.js> parser)."
NSQ_SOURCE_LINE 00001969 ""
NSQ_SOURCE_LINE 00001970 "If this is not an option, you can, as a stop-gap measure, simply encode to"
NSQ_SOURCE_LINE 00001971 "ASCII-only JSON:"
NSQ_SOURCE_LINE 00001972 ""
NSQ_SOURCE_LINE 00001973 "   use Cpanel::JSON::XS;"
NSQ_SOURCE_LINE 00001974 ""
NSQ_SOURCE_LINE 00001975 "   print Cpanel::JSON::XS->new->ascii->encode ([chr 0x2028]);"
NSQ_SOURCE_LINE 00001976 ""
NSQ_SOURCE_LINE 00001977 "Note that this will enlarge the resulting JSON text quite a bit if you"
NSQ_SOURCE_LINE 00001978 "have many non-ASCII characters. You might be tempted to run some regexes"
NSQ_SOURCE_LINE 00001979 "to only escape U+2028 and U+2029, e.g.:"
NSQ_SOURCE_LINE 00001980 ""
NSQ_SOURCE_LINE 00001981 "   # DO NOT USE THIS!"
NSQ_SOURCE_LINE 00001982 "   my $json = Cpanel::JSON::XS->new->utf8->encode ([chr 0x2028]);"
NSQ_SOURCE_LINE 00001983 "   $json =~ s/\\xe2\\x80\\xa8/\\\\u2028/g; # escape U+2028"
NSQ_SOURCE_LINE 00001984 "   $json =~ s/\\xe2\\x80\\xa9/\\\\u2029/g; # escape U+2029"
NSQ_SOURCE_LINE 00001985 "   print $json;"
NSQ_SOURCE_LINE 00001986 ""
NSQ_SOURCE_LINE 00001987 "Note that I<this is a bad idea>: the above only works for U+2028 and"
NSQ_SOURCE_LINE 00001988 "U+2029 and thus only for fully ECMAscript-compliant parsers. Many existing"
NSQ_SOURCE_LINE 00001989 "javascript implementations, however, have issues with other characters as"
NSQ_SOURCE_LINE 00001990 "well - using C<eval> naively simply I<will> cause problems."
NSQ_SOURCE_LINE 00001991 ""
NSQ_SOURCE_LINE 00001992 "Another problem is that some javascript implementations reserve"
NSQ_SOURCE_LINE 00001993 "some property names for their own purposes (which probably makes"
NSQ_SOURCE_LINE 00001994 "them non-ECMAscript-compliant). For example, Iceweasel reserves the"
NSQ_SOURCE_LINE 00001995 "C<__proto__> property name for its own purposes."
NSQ_SOURCE_LINE 00001996 ""
NSQ_SOURCE_LINE 00001997 "If that is a problem, you could parse try to filter the resulting JSON"
NSQ_SOURCE_LINE 00001998 "output for these property strings, e.g.:"
NSQ_SOURCE_LINE 00001999 ""
NSQ_SOURCE_LINE 00002000 "   $json =~ s/\"__proto__\"\\s*:/\"__proto__renamed\":/g;"
NSQ_SOURCE_LINE 00002001 ""
NSQ_SOURCE_LINE 00002002 "This works because C<__proto__> is not valid outside of strings, so every"
NSQ_SOURCE_LINE 00002003 "occurrence of C<\"__proto__\"\\s*:> must be a string used as property name."
NSQ_SOURCE_LINE 00002004 ""
NSQ_SOURCE_LINE 00002005 "Raw non-Unicode characters outside the valid unicode range fail now to"
NSQ_SOURCE_LINE 00002006 "parse, because \"A string is a sequence of zero or more Unicode"
NSQ_SOURCE_LINE 00002007 "characters\" RFC 7159 section 1 and \"JSON text SHALL be encoded in"
NSQ_SOURCE_LINE 00002008 "Unicode RFC 7159 section 8.1. We use now the UTF8_DISALLOW_SUPER"
NSQ_SOURCE_LINE 00002009 "flag when parsing unicode."
NSQ_SOURCE_LINE 00002010 ""
NSQ_SOURCE_LINE 00002011 "Since RFC 3629, U+D800 through U+DFFF are not legal Unicode values and"
NSQ_SOURCE_LINE 00002012 "their UTF-8 encodings must be treated as an invalid byte sequence."
NSQ_SOURCE_LINE 00002013 "RFC 8259 section 8.2 admits the spec allows string values that contain"
NSQ_SOURCE_LINE 00002014 "bit sequences that cannot encode Unicode characters and that the"
NSQ_SOURCE_LINE 00002015 "behavior of software that receives such values is unpredictable. To"
NSQ_SOURCE_LINE 00002016 "avoid introducing non-Unicode strings into Perl we use the"
NSQ_SOURCE_LINE 00002017 "UTF8_DISALLOW_SURROGATE flag when parsing Unicode and verify escaped"
NSQ_SOURCE_LINE 00002018 "surrogates form valid pairs."
NSQ_SOURCE_LINE 00002019 ""
NSQ_SOURCE_LINE 00002020 "If you know of other incompatibilities, please let me know."
NSQ_SOURCE_LINE 00002021 ""
NSQ_SOURCE_LINE 00002022 ""
NSQ_SOURCE_LINE 00002023 "=head2 JSON and YAML"
NSQ_SOURCE_LINE 00002024 ""
NSQ_SOURCE_LINE 00002025 "You often hear that JSON is a subset of YAML.  I<in general, there is"
NSQ_SOURCE_LINE 00002026 "no way to configure JSON::XS to output a data structure as valid YAML>"
NSQ_SOURCE_LINE 00002027 "that works in all cases.  If you really must use Cpanel::JSON::XS to"
NSQ_SOURCE_LINE 00002028 "generate YAML, you should use this algorithm (subject to change in"
NSQ_SOURCE_LINE 00002029 "future versions):"
NSQ_SOURCE_LINE 00002030 ""
NSQ_SOURCE_LINE 00002031 "   my $to_yaml = Cpanel::JSON::XS->new->utf8->space_after (1);"
NSQ_SOURCE_LINE 00002032 "   my $yaml = $to_yaml->encode ($ref) . \"\\n\";"
NSQ_SOURCE_LINE 00002033 ""
NSQ_SOURCE_LINE 00002034 "This will I<usually> generate JSON texts that also parse as valid"
NSQ_SOURCE_LINE 00002035 "YAML."
NSQ_SOURCE_LINE 00002036 ""
NSQ_SOURCE_LINE 00002037 ""
NSQ_SOURCE_LINE 00002038 "=head2 SPEED"
NSQ_SOURCE_LINE 00002039 ""
NSQ_SOURCE_LINE 00002040 "It seems that JSON::XS is surprisingly fast, as shown in the following"
NSQ_SOURCE_LINE 00002041 "tables. They have been generated with the help of the C<eg/bench> program"
NSQ_SOURCE_LINE 00002042 "in the JSON::XS distribution, to make it easy to compare on your own"
NSQ_SOURCE_LINE 00002043 "system."
NSQ_SOURCE_LINE 00002044 ""
NSQ_SOURCE_LINE 00002045 "JSON::XS is with L<Data::MessagePack> and L<Sereal> one of the fastest"
NSQ_SOURCE_LINE 00002046 "serializers, because JSON and JSON::XS do not support backrefs (no"
NSQ_SOURCE_LINE 00002047 "graph structures), only trees. Storable supports backrefs,"
NSQ_SOURCE_LINE 00002048 "i.e. graphs. Data::MessagePack encodes its data binary (as Storable)"
NSQ_SOURCE_LINE 00002049 "and supports only very simple subset of JSON."
NSQ_SOURCE_LINE 00002050 ""
NSQ_SOURCE_LINE 00002051 "First comes a comparison between various modules using"
NSQ_SOURCE_LINE 00002052 "a very short single-line JSON string (also available at"
NSQ_SOURCE_LINE 00002053 "L<http://dist.schmorp.de/misc/json/short.json>)."
NSQ_SOURCE_LINE 00002054 ""
NSQ_SOURCE_LINE 00002055 "   {\"method\": \"handleMessage\", \"params\": [\"user1\","
NSQ_SOURCE_LINE 00002056 "   \"we were just talking\"], \"id\": null, \"array\":[1,11,234,-5,1e5,1e7,"
NSQ_SOURCE_LINE 00002057 "   1,  0]}"
NSQ_SOURCE_LINE 00002058 ""
NSQ_SOURCE_LINE 00002059 "It shows the number of encodes/decodes per second (JSON::XS uses"
NSQ_SOURCE_LINE 00002060 "the functional interface, while Cpanel::JSON::XS/2 uses the OO interface"
NSQ_SOURCE_LINE 00002061 "with pretty-printing and hash key sorting enabled, Cpanel::JSON::XS/3 enables"
NSQ_SOURCE_LINE 00002062 "shrink. JSON::DWIW/DS uses the deserialize function, while JSON::DWIW::FJ"
NSQ_SOURCE_LINE 00002063 "uses the from_json method). Higher is better:"
NSQ_SOURCE_LINE 00002064 ""
NSQ_SOURCE_LINE 00002065 "   module        |     encode |     decode |"
NSQ_SOURCE_LINE 00002066 "   --------------|------------|------------|"
NSQ_SOURCE_LINE 00002067 "   JSON::DWIW/DS |  86302.551 | 102300.098 |"
NSQ_SOURCE_LINE 00002068 "   JSON::DWIW/FJ |  86302.551 |  75983.768 |"
NSQ_SOURCE_LINE 00002069 "   JSON::PP      |  15827.562 |   6638.658 |"
NSQ_SOURCE_LINE 00002070 "   JSON::Syck    |  63358.066 |  47662.545 |"
NSQ_SOURCE_LINE 00002071 "   JSON::XS      | 511500.488 | 511500.488 |"
NSQ_SOURCE_LINE 00002072 "   JSON::XS/2    | 291271.111 | 388361.481 |"
NSQ_SOURCE_LINE 00002073 "   JSON::XS/3    | 361577.931 | 361577.931 |"
NSQ_SOURCE_LINE 00002074 "   Storable      |  66788.280 | 265462.278 |"
NSQ_SOURCE_LINE 00002075 "   --------------+------------+------------+"
NSQ_SOURCE_LINE 00002076 ""
NSQ_SOURCE_LINE 00002077 "That is, JSON::XS is almost six times faster than JSON::DWIW on encoding,"
NSQ_SOURCE_LINE 00002078 "about five times faster on decoding, and over thirty to seventy times"
NSQ_SOURCE_LINE 00002079 "faster than JSON's pure perl implementation. It also compares favourably"
NSQ_SOURCE_LINE 00002080 "to Storable for small amounts of data."
NSQ_SOURCE_LINE 00002081 ""
NSQ_SOURCE_LINE 00002082 "Using a longer test string (roughly 18KB, generated from Yahoo! Locals"
NSQ_SOURCE_LINE 00002083 "search API (L<http://dist.schmorp.de/misc/json/long.json>)."
NSQ_SOURCE_LINE 00002084 ""
NSQ_SOURCE_LINE 00002085 "   module        |     encode |     decode |"
NSQ_SOURCE_LINE 00002086 "   --------------|------------|------------|"
NSQ_SOURCE_LINE 00002087 "   JSON::DWIW/DS |   1647.927 |   2673.916 |"
NSQ_SOURCE_LINE 00002088 "   JSON::DWIW/FJ |   1630.249 |   2596.128 |"
NSQ_SOURCE_LINE 00002089 "   JSON::PP      |    400.640 |     62.311 |"
NSQ_SOURCE_LINE 00002090 "   JSON::Syck    |   1481.040 |   1524.869 |"
NSQ_SOURCE_LINE 00002091 "   JSON::XS      |  20661.596 |   9541.183 |"
NSQ_SOURCE_LINE 00002092 "   JSON::XS/2    |  10683.403 |   9416.938 |"
NSQ_SOURCE_LINE 00002093 "   JSON::XS/3    |  20661.596 |   9400.054 |"
NSQ_SOURCE_LINE 00002094 "   Storable      |  19765.806 |  10000.725 |"
NSQ_SOURCE_LINE 00002095 "   --------------+------------+------------+"
NSQ_SOURCE_LINE 00002096 ""
NSQ_SOURCE_LINE 00002097 "Again, JSON::XS leads by far (except for Storable which non-surprisingly"
NSQ_SOURCE_LINE 00002098 "decodes a bit faster)."
NSQ_SOURCE_LINE 00002099 ""
NSQ_SOURCE_LINE 00002100 "On large strings containing lots of high Unicode characters, some modules"
NSQ_SOURCE_LINE 00002101 "(such as JSON::PC) seem to decode faster than JSON::XS, but the result"
NSQ_SOURCE_LINE 00002102 "will be broken due to missing (or wrong) Unicode handling. Others refuse"
NSQ_SOURCE_LINE 00002103 "to decode or encode properly, so it was impossible to prepare a fair"
NSQ_SOURCE_LINE 00002104 "comparison table for that case."
NSQ_SOURCE_LINE 00002105 ""
NSQ_SOURCE_LINE 00002106 "For updated graphs see L<https://github.com/Sereal/Sereal/wiki/Sereal-Comparison-Graphs>"
NSQ_SOURCE_LINE 00002107 ""
NSQ_SOURCE_LINE 00002108 ""
NSQ_SOURCE_LINE 00002109 "=head1 INTEROP with JSON and JSON::XS and other JSON modules"
NSQ_SOURCE_LINE 00002110 ""
NSQ_SOURCE_LINE 00002111 "As long as you only serialize data that can be directly expressed in"
NSQ_SOURCE_LINE 00002112 "JSON, C<Cpanel::JSON::XS> is incapable of generating invalid JSON"
NSQ_SOURCE_LINE 00002113 "output (modulo bugs, but C<JSON::XS> has found more bugs in the"
NSQ_SOURCE_LINE 00002114 "official JSON testsuite (1) than the official JSON testsuite has found"
NSQ_SOURCE_LINE 00002115 "in C<JSON::XS> (0))."
NSQ_SOURCE_LINE 00002116 "C<Cpanel::JSON::XS> is currently the only known JSON decoder which passes all"
NSQ_SOURCE_LINE 00002117 "L<http://seriot.ch/projects/parsing_json.html> tests, while being the fastest also."
NSQ_SOURCE_LINE 00002118 ""
NSQ_SOURCE_LINE 00002119 "When you have trouble decoding JSON generated by this module using other"
NSQ_SOURCE_LINE 00002120 "decoders, then it is very likely that you have an encoding mismatch or the"
NSQ_SOURCE_LINE 00002121 "other decoder is broken."
NSQ_SOURCE_LINE 00002122 ""
NSQ_SOURCE_LINE 00002123 "When decoding, C<JSON::XS> is strict by default and will likely catch"
NSQ_SOURCE_LINE 00002124 "all errors. There are currently two settings that change this:"
NSQ_SOURCE_LINE 00002125 "C<relaxed> makes C<JSON::XS> accept (but not generate) some"
NSQ_SOURCE_LINE 00002126 "non-standard extensions, and C<allow_tags> or C<allow_blessed> will"
NSQ_SOURCE_LINE 00002127 "allow you to encode and decode Perl objects, at the cost of being"
NSQ_SOURCE_LINE 00002128 "totally insecure and not outputting valid JSON anymore."
NSQ_SOURCE_LINE 00002129 ""
NSQ_SOURCE_LINE 00002130 "JSON-XS-3.01 broke interoperability with JSON-2.90 with booleans. See L<JSON>."
NSQ_SOURCE_LINE 00002131 ""
NSQ_SOURCE_LINE 00002132 "Cpanel::JSON::XS needs to know the JSON and JSON::XS versions to be able work"
NSQ_SOURCE_LINE 00002133 "with those objects, especially when encoding a booleans like C<{\"is_true\":true}>."
NSQ_SOURCE_LINE 00002134 "So you need to load these modules before."
NSQ_SOURCE_LINE 00002135 ""
NSQ_SOURCE_LINE 00002136 "true/false overloading and boolean representations are supported."
NSQ_SOURCE_LINE 00002137 ""
NSQ_SOURCE_LINE 00002138 "JSON::XS and JSON::PP representations are accepted and older JSON::XS"
NSQ_SOURCE_LINE 00002139 "accepts Cpanel::JSON::XS booleans. All JSON modules JSON, JSON, PP,"
NSQ_SOURCE_LINE 00002140 "JSON::XS, Cpanel::JSON::XS produce JSON::PP::Boolean objects, just"
NSQ_SOURCE_LINE 00002141 "Mojo and JSON::YAJL not.  Mojo produces Mojo::JSON::_Bool and"
NSQ_SOURCE_LINE 00002142 "JSON::YAJL::Parser just an unblessed IV."
NSQ_SOURCE_LINE 00002143 ""
NSQ_SOURCE_LINE 00002144 "Cpanel::JSON::XS accepts JSON::PP::Boolean and Mojo::JSON::_Bool"
NSQ_SOURCE_LINE 00002145 "objects as booleans."
NSQ_SOURCE_LINE 00002146 ""
NSQ_SOURCE_LINE 00002147 "I cannot think of any reason to still use JSON::XS anymore."
NSQ_SOURCE_LINE 00002148 ""
NSQ_SOURCE_LINE 00002149 ""
NSQ_SOURCE_LINE 00002150 "=head2 TAGGED VALUE SYNTAX AND STANDARD JSON EN/DECODERS"
NSQ_SOURCE_LINE 00002151 ""
NSQ_SOURCE_LINE 00002152 "When you use C<allow_tags> to use the extended (and also nonstandard"
NSQ_SOURCE_LINE 00002153 "and invalid) JSON syntax for serialized objects, and you still want to"
NSQ_SOURCE_LINE 00002154 "decode the generated serialize objects, you can run a regex to replace"
NSQ_SOURCE_LINE 00002155 "the tagged syntax by standard JSON arrays (it only works for \"normal\""
NSQ_SOURCE_LINE 00002156 "package names without comma, newlines or single colons). First, the"
NSQ_SOURCE_LINE 00002157 "readable Perl version:"
NSQ_SOURCE_LINE 00002158 ""
NSQ_SOURCE_LINE 00002159 "   # if your FREEZE methods return no values, you need this replace first:"
NSQ_SOURCE_LINE 00002160 "   $json =~ s/\\( \\s* (\" (?: [^\\\\\":,]+|\\\\.|::)* \") \\s* \\) \\s* \\[\\s*\\]/[$1]/gx;"
NSQ_SOURCE_LINE 00002161 ""
NSQ_SOURCE_LINE 00002162 "   # this works for non-empty constructor arg lists:"
NSQ_SOURCE_LINE 00002163 "   $json =~ s/\\( \\s* (\" (?: [^\\\\\":,]+|\\\\.|::)* \") \\s* \\) \\s* \\[/[$1,/gx;"
NSQ_SOURCE_LINE 00002164 ""
NSQ_SOURCE_LINE 00002165 "And here is a less readable version that is easy to adapt to other"
NSQ_SOURCE_LINE 00002166 "languages:"
NSQ_SOURCE_LINE 00002167 ""
NSQ_SOURCE_LINE 00002168 "   $json =~ s/\\(\\s*(\"([^\\\\\":,]+|\\\\.|::)*\")\\s*\\)\\s*\\[/[$1,/g;"
NSQ_SOURCE_LINE 00002169 ""
NSQ_SOURCE_LINE 00002170 "Here is an ECMAScript version (same regex):"
NSQ_SOURCE_LINE 00002171 ""
NSQ_SOURCE_LINE 00002172 "   json = json.replace (/\\(\\s*(\"([^\\\\\":,]+|\\\\.|::)*\")\\s*\\)\\s*\\[/g, \"[$1,\");"
NSQ_SOURCE_LINE 00002173 ""
NSQ_SOURCE_LINE 00002174 "Since this syntax converts to standard JSON arrays, it might be hard to"
NSQ_SOURCE_LINE 00002175 "distinguish serialized objects from normal arrays. You can prepend a"
NSQ_SOURCE_LINE 00002176 "\"magic number\" as first array element to reduce chances of a collision:"
NSQ_SOURCE_LINE 00002177 ""
NSQ_SOURCE_LINE 00002178 "   $json =~ s/\\(\\s*(\"([^\\\\\":,]+|\\\\.|::)*\")\\s*\\)\\s*\\[/[\"XU1peReLzT4ggEllLanBYq4G9VzliwKF\",$1,/g;"
NSQ_SOURCE_LINE 00002179 ""
NSQ_SOURCE_LINE 00002180 "And after decoding the JSON text, you could walk the data"
NSQ_SOURCE_LINE 00002181 "structure looking for arrays with a first element of"
NSQ_SOURCE_LINE 00002182 "C<XU1peReLzT4ggEllLanBYq4G9VzliwKF>."
NSQ_SOURCE_LINE 00002183 ""
NSQ_SOURCE_LINE 00002184 "The same approach can be used to create the tagged format with another"
NSQ_SOURCE_LINE 00002185 "encoder. First, you create an array with the magic string as first member,"
NSQ_SOURCE_LINE 00002186 "the classname as second, and constructor arguments last, encode it as part"
NSQ_SOURCE_LINE 00002187 "of your JSON structure, and then:"
NSQ_SOURCE_LINE 00002188 ""
NSQ_SOURCE_LINE 00002189 "   $json =~ s/\\[\\s*\"XU1peReLzT4ggEllLanBYq4G9VzliwKF\"\\s*,\\s*(\"([^\\\\\":,]+|\\\\.|::)*\")\\s*,/($1)[/g;"
NSQ_SOURCE_LINE 00002190 ""
NSQ_SOURCE_LINE 00002191 "Again, this has some limitations - the magic string must not be encoded"
NSQ_SOURCE_LINE 00002192 "with character escapes, and the constructor arguments must be non-empty."
NSQ_SOURCE_LINE 00002193 ""
NSQ_SOURCE_LINE 00002194 ""
NSQ_SOURCE_LINE 00002195 "=head1 RFC7159"
NSQ_SOURCE_LINE 00002196 ""
NSQ_SOURCE_LINE 00002197 "Since this module was written, Google has written a new JSON RFC, RFC 7159"
NSQ_SOURCE_LINE 00002198 "(and RFC7158). Unfortunately, this RFC breaks compatibility with both the"
NSQ_SOURCE_LINE 00002199 "original JSON specification on www.json.org and RFC4627."
NSQ_SOURCE_LINE 00002200 ""
NSQ_SOURCE_LINE 00002201 "As far as I can see, you can get partial compatibility when parsing by"
NSQ_SOURCE_LINE 00002202 "using C<< ->allow_nonref >>. However, consider the security implications"
NSQ_SOURCE_LINE 00002203 "of doing so."
NSQ_SOURCE_LINE 00002204 ""
NSQ_SOURCE_LINE 00002205 "I haven't decided yet when to break compatibility with RFC4627 by default"
NSQ_SOURCE_LINE 00002206 "(and potentially leave applications insecure) and change the default to"
NSQ_SOURCE_LINE 00002207 "follow RFC7159, but application authors are well advised to call C<<"
NSQ_SOURCE_LINE 00002208 "->allow_nonref(0) >> even if this is the current default, if they cannot"
NSQ_SOURCE_LINE 00002209 "handle non-reference values, in preparation for the day when the default"
NSQ_SOURCE_LINE 00002210 "will change."
NSQ_SOURCE_LINE 00002211 ""
NSQ_SOURCE_LINE 00002212 "=head1 SECURITY CONSIDERATIONS"
NSQ_SOURCE_LINE 00002213 ""
NSQ_SOURCE_LINE 00002214 "JSON::XS and Cpanel::JSON::XS are not only fast. JSON is generally the"
NSQ_SOURCE_LINE 00002215 "most secure serializing format, because it is the only one besides"
NSQ_SOURCE_LINE 00002216 "Data::MessagePack, which does not deserialize objects per default. For"
NSQ_SOURCE_LINE 00002217 "all languages, not just perl.  The binary variant BSON (MongoDB) does"
NSQ_SOURCE_LINE 00002218 "more but is unsafe."
NSQ_SOURCE_LINE 00002219 ""
NSQ_SOURCE_LINE 00002220 "It is trivial for any attacker to create such serialized objects in"
NSQ_SOURCE_LINE 00002221 "JSON and trick perl into expanding them, thereby triggering certain"
NSQ_SOURCE_LINE 00002222 "methods. Watch L<https://www.youtube.com/watch?v=Gzx6KlqiIZE> for an"
NSQ_SOURCE_LINE 00002223 "exploit demo for \"CVE-2015-1592 SixApart MovableType Storable Perl"
NSQ_SOURCE_LINE 00002224 "Code Execution\" for a deserializer which expands objects."
NSQ_SOURCE_LINE 00002225 "Deserializing even coderefs (methods, functions) or external"
NSQ_SOURCE_LINE 00002226 "data would be considered the most dangerous."
NSQ_SOURCE_LINE 00002227 ""
NSQ_SOURCE_LINE 00002228 "Security relevant overview of serializers regarding deserializing"
NSQ_SOURCE_LINE 00002229 "objects by default:"
NSQ_SOURCE_LINE 00002230 ""
NSQ_SOURCE_LINE 00002231 "                      Objects   Coderefs  External Data"
NSQ_SOURCE_LINE 00002232 ""
NSQ_SOURCE_LINE 00002233 "    Data::Dumper      YES       YES       YES"
NSQ_SOURCE_LINE 00002234 "    Storable          YES       NO (def)  NO"
NSQ_SOURCE_LINE 00002235 "    Sereal            YES       NO        NO"
NSQ_SOURCE_LINE 00002236 "    YAML              YES       NO        NO"
NSQ_SOURCE_LINE 00002237 "    B::C              YES       YES       YES"
NSQ_SOURCE_LINE 00002238 "    B::Bytecode       YES       YES       YES"
NSQ_SOURCE_LINE 00002239 "    BSON              YES       YES       NO"
NSQ_SOURCE_LINE 00002240 "    JSON::SL          YES       NO        YES"
NSQ_SOURCE_LINE 00002241 "    JSON              NO (def)  NO        NO"
NSQ_SOURCE_LINE 00002242 "    Data::MessagePack NO        NO        NO"
NSQ_SOURCE_LINE 00002243 "    XML               NO        NO        YES"
NSQ_SOURCE_LINE 00002244 ""
NSQ_SOURCE_LINE 00002245 "    Pickle            YES       YES       YES"
NSQ_SOURCE_LINE 00002246 "    PHP Deserialize   YES       NO        NO"
NSQ_SOURCE_LINE 00002247 ""
NSQ_SOURCE_LINE 00002248 "When you are using JSON in a protocol, talking to untrusted potentially"
NSQ_SOURCE_LINE 00002249 "hostile creatures requires relatively few measures."
NSQ_SOURCE_LINE 00002250 ""
NSQ_SOURCE_LINE 00002251 "First of all, your JSON decoder should be secure, that is, should not have"
NSQ_SOURCE_LINE 00002252 "any buffer overflows. Obviously, this module should ensure that."
NSQ_SOURCE_LINE 00002253 ""
NSQ_SOURCE_LINE 00002254 "Second, you need to avoid resource-starving attacks. That means you should"
NSQ_SOURCE_LINE 00002255 "limit the size of JSON texts you accept, or make sure then when your"
NSQ_SOURCE_LINE 00002256 "resources run out, that's just fine (e.g. by using a separate process that"
NSQ_SOURCE_LINE 00002257 "can crash safely). The size of a JSON text in octets or characters is"
NSQ_SOURCE_LINE 00002258 "usually a good indication of the size of the resources required to decode"
NSQ_SOURCE_LINE 00002259 "it into a Perl structure. While JSON::XS can check the size of the JSON"
NSQ_SOURCE_LINE 00002260 "text, it might be too late when you already have it in memory, so you"
NSQ_SOURCE_LINE 00002261 "might want to check the size before you accept the string."
NSQ_SOURCE_LINE 00002262 ""
NSQ_SOURCE_LINE 00002263 "Third, Cpanel::JSON::XS recurses using the C stack when decoding objects and"
NSQ_SOURCE_LINE 00002264 "arrays. The C stack is a limited resource: for instance, on my amd64"
NSQ_SOURCE_LINE 00002265 "machine with 8MB of stack size I can decode around 180k nested arrays but"
NSQ_SOURCE_LINE 00002266 "only 14k nested JSON objects (due to perl itself recursing deeply on croak"
NSQ_SOURCE_LINE 00002267 "to free the temporary). If that is exceeded, the program crashes. To be"
NSQ_SOURCE_LINE 00002268 "conservative, the default nesting limit is set to 512. If your process"
NSQ_SOURCE_LINE 00002269 "has a smaller stack, you should adjust this setting accordingly with the"
NSQ_SOURCE_LINE 00002270 "C<max_depth> method."
NSQ_SOURCE_LINE 00002271 ""
NSQ_SOURCE_LINE 00002272 "Also keep in mind that Cpanel::JSON::XS might leak contents of your Perl data"
NSQ_SOURCE_LINE 00002273 "structures in its error messages, so when you serialize sensitive"
NSQ_SOURCE_LINE 00002274 "information you might want to make sure that exceptions thrown by JSON::XS"
NSQ_SOURCE_LINE 00002275 "will not end up in front of untrusted eyes."
NSQ_SOURCE_LINE 00002276 ""
NSQ_SOURCE_LINE 00002277 "If you are using Cpanel::JSON::XS to return packets to consumption"
NSQ_SOURCE_LINE 00002278 "by JavaScript scripts in a browser you should have a look at"
NSQ_SOURCE_LINE 00002279 "L<http://blog.archive.jpsykes.com/47/practical-csrf-and-json-security/> to"
NSQ_SOURCE_LINE 00002280 "see whether you are vulnerable to some common attack vectors (which really"
NSQ_SOURCE_LINE 00002281 "are browser design bugs, but it is still you who will have to deal with"
NSQ_SOURCE_LINE 00002282 "it, as major browser developers care only for features, not about getting"
NSQ_SOURCE_LINE 00002283 "security right). You might also want to also look at L<Mojo::JSON>"
NSQ_SOURCE_LINE 00002284 "special escape rules to prevent from XSS attacks."
NSQ_SOURCE_LINE 00002285 ""
NSQ_SOURCE_LINE 00002286 "=head1 \"OLD\" VS. \"NEW\" JSON (RFC 4627 VS. RFC 7159)"
NSQ_SOURCE_LINE 00002287 ""
NSQ_SOURCE_LINE 00002288 "TL;DR: Due to security concerns, Cpanel::JSON::XS will not allow"
NSQ_SOURCE_LINE 00002289 "scalar data in JSON texts by default - you need to create your own"
NSQ_SOURCE_LINE 00002290 "Cpanel::JSON::XS object and enable C<allow_nonref>:"
NSQ_SOURCE_LINE 00002291 ""
NSQ_SOURCE_LINE 00002292 ""
NSQ_SOURCE_LINE 00002293 "   my $json = JSON::XS->new->allow_nonref;"
NSQ_SOURCE_LINE 00002294 ""
NSQ_SOURCE_LINE 00002295 "   $text = $json->encode ($data);"
NSQ_SOURCE_LINE 00002296 "   $data = $json->decode ($text);"
NSQ_SOURCE_LINE 00002297 ""
NSQ_SOURCE_LINE 00002298 "The long version: JSON being an important and supposedly stable format,"
NSQ_SOURCE_LINE 00002299 "the IETF standardized it as RFC 4627 in 2006. Unfortunately the inventor"
NSQ_SOURCE_LINE 00002300 "of JSON Douglas Crockford unilaterally changed the definition of JSON in"
NSQ_SOURCE_LINE 00002301 "javascript. Rather than create a fork, the IETF decided to standardize the"
NSQ_SOURCE_LINE 00002302 "new syntax (apparently, so I as told, without finding it very amusing)."
NSQ_SOURCE_LINE 00002303 ""
NSQ_SOURCE_LINE 00002304 "The biggest difference between the original JSON and the new JSON is that"
NSQ_SOURCE_LINE 00002305 "the new JSON supports scalars (anything other than arrays and objects) at"
NSQ_SOURCE_LINE 00002306 "the top-level of a JSON text. While this is strictly backwards compatible"
NSQ_SOURCE_LINE 00002307 "to older versions, it breaks a number of protocols that relied on sending"
NSQ_SOURCE_LINE 00002308 "JSON back-to-back, and is a minor security concern."
NSQ_SOURCE_LINE 00002309 ""
NSQ_SOURCE_LINE 00002310 "For example, imagine you have two banks communicating, and on one side,"
NSQ_SOURCE_LINE 00002311 "the JSON coder gets upgraded. Two messages, such as C<10> and C<1000>"
NSQ_SOURCE_LINE 00002312 "might then be confused to mean C<101000>, something that couldn't happen"
NSQ_SOURCE_LINE 00002313 "in the original JSON, because neither of these messages would be valid"
NSQ_SOURCE_LINE 00002314 "JSON."
NSQ_SOURCE_LINE 00002315 ""
NSQ_SOURCE_LINE 00002316 "If one side accepts these messages, then an upgrade in the coder on either"
NSQ_SOURCE_LINE 00002317 "side could result in this becoming exploitable."
NSQ_SOURCE_LINE 00002318 ""
NSQ_SOURCE_LINE 00002319 "This module has always allowed these messages as an optional extension, by"
NSQ_SOURCE_LINE 00002320 "default disabled. The security concerns are the reason why the default is"
NSQ_SOURCE_LINE 00002321 "still disabled, but future versions might/will likely upgrade to the newer"
NSQ_SOURCE_LINE 00002322 "RFC as default format, so you are advised to check your implementation"
NSQ_SOURCE_LINE 00002323 "and/or override the default with C<< ->allow_nonref (0) >> to ensure that"
NSQ_SOURCE_LINE 00002324 "future versions are safe."
NSQ_SOURCE_LINE 00002325 ""
NSQ_SOURCE_LINE 00002326 "=head1 THREADS"
NSQ_SOURCE_LINE 00002327 ""
NSQ_SOURCE_LINE 00002328 "Cpanel::JSON::XS has proper ithreads support, unlike JSON::XS. If you"
NSQ_SOURCE_LINE 00002329 "encounter any bugs with thread support please report them."
NSQ_SOURCE_LINE 00002330 ""
NSQ_SOURCE_LINE 00002331 "From Version 4.00 - 4.19 you couldn't encode true with threads::shared"
NSQ_SOURCE_LINE 00002332 "magic."
NSQ_SOURCE_LINE 00002333 ""
NSQ_SOURCE_LINE 00002334 "=head1 BUGS"
NSQ_SOURCE_LINE 00002335 ""
NSQ_SOURCE_LINE 00002336 "While the goal of the Cpanel::JSON::XS module is to be correct, that"
NSQ_SOURCE_LINE 00002337 "unfortunately does not mean it's bug-free, only that the author thinks"
NSQ_SOURCE_LINE 00002338 "its design is bug-free. If you keep reporting bugs and tests they will"
NSQ_SOURCE_LINE 00002339 "be fixed swiftly, though."
NSQ_SOURCE_LINE 00002340 ""
NSQ_SOURCE_LINE 00002341 "Since the JSON::XS author refuses to use a public bugtracker and"
NSQ_SOURCE_LINE 00002342 "prefers private emails, we use the tracker at B<github>, so you might want"
NSQ_SOURCE_LINE 00002343 "to report any issues twice. Once in private to MLEHMANN to be fixed in"
NSQ_SOURCE_LINE 00002344 "JSON::XS and one to our the public tracker. Issues fixed by JSON::XS"
NSQ_SOURCE_LINE 00002345 "with a new release will also be backported to Cpanel::JSON::XS and"
NSQ_SOURCE_LINE 00002346 "5.6.2, as long as cPanel relies on 5.6.2 and Cpanel::JSON::XS as our"
NSQ_SOURCE_LINE 00002347 "serializer of choice."
NSQ_SOURCE_LINE 00002348 ""
NSQ_SOURCE_LINE 00002349 "L<https://github.com/rurban/Cpanel-JSON-XS/issues>"
NSQ_SOURCE_LINE 00002350 ""
NSQ_SOURCE_LINE 00002351 "=head1 LICENSE"
NSQ_SOURCE_LINE 00002352 ""
NSQ_SOURCE_LINE 00002353 "This module is available under the same licences as perl, the Artistic"
NSQ_SOURCE_LINE 00002354 "license and the GPL."
NSQ_SOURCE_LINE 00002355 ""
NSQ_SOURCE_LINE 00002356 "=cut"
NSQ_SOURCE_LINE 00002357 ""
NSQ_SOURCE_LINE 00002358 "sub allow_bigint {"
NSQ_SOURCE_LINE 00002359 "    Carp::carp(\"allow_bigint() is obsoleted. use allow_bignum() instead.\");"
NSQ_SOURCE_LINE 00002360 "}"
NSQ_SOURCE_LINE 00002361 ""
NSQ_SOURCE_LINE 00002362 "BEGIN {"
NSQ_SOURCE_LINE 00002363 "  package"
NSQ_SOURCE_LINE 00002364 "    JSON::PP::Boolean;"
NSQ_SOURCE_LINE 00002365 ""
NSQ_SOURCE_LINE 00002366 "  require overload;"
NSQ_SOURCE_LINE 00002367 ""
NSQ_SOURCE_LINE 00002368 "  local $^W; # silence redefine warnings. no warnings 'redefine' does not help"
NSQ_SOURCE_LINE 00002369 "  # These already come with JSON::PP::Boolean. Avoid redefine warning."
NSQ_SOURCE_LINE 00002370 "  if (!defined $JSON::PP::Boolean::VERSION or $JSON::PP::VERSION lt '4.00') {"
NSQ_SOURCE_LINE 00002371 "    &overload::unimport( 'overload', '0+', '++', '--' );"
NSQ_SOURCE_LINE 00002372 "    &overload::import( 'overload',"
NSQ_SOURCE_LINE 00002373 "                       \"0+\"     => sub { ${$_[0]} },"
NSQ_SOURCE_LINE 00002374 "                       \"++\"     => sub { $_[0] = ${$_[0]} + 1 },"
NSQ_SOURCE_LINE 00002375 "                       \"--\"     => sub { $_[0] = ${$_[0]} - 1 },"
NSQ_SOURCE_LINE 00002376 "      );"
NSQ_SOURCE_LINE 00002377 "  }"
NSQ_SOURCE_LINE 00002378 "  # workaround 5.6 reserved keyword warning"
NSQ_SOURCE_LINE 00002379 "  &overload::unimport( 'overload', '\"\"', 'eq', 'ne' );"
NSQ_SOURCE_LINE 00002380 "  &overload::import( 'overload',"
NSQ_SOURCE_LINE 00002381 "    '\"\"'     => sub { ${$_[0]} == 1 ? '1' : '0' }, # GH 29"
NSQ_SOURCE_LINE 00002382 "    'eq'     => sub {"
NSQ_SOURCE_LINE 00002383 "      my ($obj, $op) = $_[2] ? ($_[1], $_[0]) : ($_[0], $_[1]);"
NSQ_SOURCE_LINE 00002384 "      #warn \"eq obj:$obj op:$op len:\", length($op) > 0, \" swap:$_[2]\";"
NSQ_SOURCE_LINE 00002385 "      if (ref $op) { # if 2nd also blessed might recurse endlessly"
NSQ_SOURCE_LINE 00002386 "        return $obj ? 1 == $op : 0 == $op;"
NSQ_SOURCE_LINE 00002387 "      }"
NSQ_SOURCE_LINE 00002388 "      # if string, only accept numbers or true|false or \"\" (e.g. !!0 / SV_NO)"
NSQ_SOURCE_LINE 00002389 "      elsif ($op !~ /^[0-9]+$/) {"
NSQ_SOURCE_LINE 00002390 "        return \"$obj\" eq '1' ? 'true' eq $op : 'false' eq $op || \"\" eq $op;"
NSQ_SOURCE_LINE 00002391 "      }"
NSQ_SOURCE_LINE 00002392 "      else {"
NSQ_SOURCE_LINE 00002393 "        return $obj ? 1 == $op : 0 == $op;"
NSQ_SOURCE_LINE 00002394 "      }"
NSQ_SOURCE_LINE 00002395 "    },"
NSQ_SOURCE_LINE 00002396 "    'ne'     => sub {"
NSQ_SOURCE_LINE 00002397 "      my ($obj, $op) = $_[2] ? ($_[1], $_[0]) : ($_[0], $_[1]);"
NSQ_SOURCE_LINE 00002398 "      #warn \"ne obj:$obj op:$op\";"
NSQ_SOURCE_LINE 00002399 "      return !($obj eq $op);"
NSQ_SOURCE_LINE 00002400 "    },"
NSQ_SOURCE_LINE 00002401 "    fallback => 1);"
NSQ_SOURCE_LINE 00002402 "}"
NSQ_SOURCE_LINE 00002403 ""
NSQ_SOURCE_LINE 00002404 "our ($true, $false);"
NSQ_SOURCE_LINE 00002405 "BEGIN {"
NSQ_SOURCE_LINE 00002406 "  if ($INC{'JSON/XS.pm'}"
NSQ_SOURCE_LINE 00002407 "      and $INC{'Types/Serialiser.pm'}"
NSQ_SOURCE_LINE 00002408 "      and $JSON::XS::VERSION ge \"3.00\") {"
NSQ_SOURCE_LINE 00002409 "    $true  = $Types::Serialiser::true; # readonly if loaded by JSON::XS"
NSQ_SOURCE_LINE 00002410 "    $false = $Types::Serialiser::false;"
NSQ_SOURCE_LINE 00002411 "  } else {"
NSQ_SOURCE_LINE 00002412 "    $true  = do { bless \\(my $dummy = 1), \"JSON::PP::Boolean\" };"
NSQ_SOURCE_LINE 00002413 "    $false = do { bless \\(my $dummy = 0), \"JSON::PP::Boolean\" };"
NSQ_SOURCE_LINE 00002414 "  }"
NSQ_SOURCE_LINE 00002415 "}"
NSQ_SOURCE_LINE 00002416 ""
NSQ_SOURCE_LINE 00002417 "BEGIN {"
NSQ_SOURCE_LINE 00002418 "  my $const_true  = $true;"
NSQ_SOURCE_LINE 00002419 "  my $const_false = $false;"
NSQ_SOURCE_LINE 00002420 "  *true  = sub () { $const_true  };"
NSQ_SOURCE_LINE 00002421 "  *false = sub () { $const_false };"
NSQ_SOURCE_LINE 00002422 "}"
NSQ_SOURCE_LINE 00002423 ""
NSQ_SOURCE_LINE 00002424 "sub is_bool($) {"
NSQ_SOURCE_LINE 00002425 "  shift if @_ == 2; # as method call"
NSQ_SOURCE_LINE 00002426 "  (ref($_[0]) and UNIVERSAL::isa( $_[0], JSON::PP::Boolean::))"
NSQ_SOURCE_LINE 00002427 "  or (exists $INC{'Types/Serialiser.pm'} and Types::Serialiser::is_bool($_[0]))"
NSQ_SOURCE_LINE 00002428 "}"
NSQ_SOURCE_LINE 00002429 ""
NSQ_SOURCE_LINE 00002430 "XSLoader::load 'Cpanel::JSON::XS', $XS_VERSION;"
NSQ_SOURCE_LINE 00002431 ""
NSQ_SOURCE_LINE 00002432 "1;"
NSQ_SOURCE_LINE 00002433 ""
