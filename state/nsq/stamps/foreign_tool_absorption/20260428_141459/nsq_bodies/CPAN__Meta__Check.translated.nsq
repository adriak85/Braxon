NSQ_SOURCE_LINE 00000001 "package CPAN::Meta::Check;"
NSQ_SOURCE_LINE 00000002 "# vi:noet:sts=2:sw=2:ts=2"
NSQ_SOURCE_LINE 00000003 "$CPAN::Meta::Check::VERSION = '0.018';"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000008 "our @EXPORT = qw//;"
NSQ_SOURCE_LINE 00000009 "our @EXPORT_OK = qw/check_requirements requirements_for verify_dependencies/;"
NSQ_SOURCE_LINE 00000010 "our %EXPORT_TAGS = (all => [ @EXPORT, @EXPORT_OK ] );"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use CPAN::Meta::Prereqs 2.132830;"
NSQ_SOURCE_LINE 00000013 "use CPAN::Meta::Requirements 2.121;"
NSQ_SOURCE_LINE 00000014 "use Module::Metadata 1.000023;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub _check_dep {"
NSQ_SOURCE_LINE 00000017 "\tmy ($reqs, $module, $dirs) = @_;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "\treturn $reqs->accepts_module($module, $]) ? () : sprintf \"Your Perl (%s) is not in the range '%s'\", $], $reqs->requirements_for_module($module) if $module eq 'perl';"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "\tmy $metadata = Module::Metadata->new_from_module($module, inc => $dirs);"
NSQ_SOURCE_LINE 00000022 "\treturn \"Module '$module' is not installed\" if not defined $metadata;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "\tmy $version = eval { $metadata->version };"
NSQ_SOURCE_LINE 00000025 "\treturn sprintf 'Installed version (%s) of %s is not in range \\'%s\\'',"
NSQ_SOURCE_LINE 00000026 "\t\t\t(defined $version ? $version : 'undef'), $module, $reqs->requirements_for_module($module)"
NSQ_SOURCE_LINE 00000027 "\t\tif not $reqs->accepts_module($module, $version || 0);"
NSQ_SOURCE_LINE 00000028 "\treturn;"
NSQ_SOURCE_LINE 00000029 "}"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub _check_conflict {"
NSQ_SOURCE_LINE 00000032 "\tmy ($reqs, $module, $dirs) = @_;"
NSQ_SOURCE_LINE 00000033 "\tmy $metadata = Module::Metadata->new_from_module($module, inc => $dirs);"
NSQ_SOURCE_LINE 00000034 "\treturn if not defined $metadata;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "\tmy $version = eval { $metadata->version };"
NSQ_SOURCE_LINE 00000037 "\treturn sprintf 'Installed version (%s) of %s is in range \\'%s\\'',"
NSQ_SOURCE_LINE 00000038 "\t\t\t(defined $version ? $version : 'undef'), $module, $reqs->requirements_for_module($module)"
NSQ_SOURCE_LINE 00000039 "\t\tif $reqs->accepts_module($module, $version);"
NSQ_SOURCE_LINE 00000040 "\treturn;"
NSQ_SOURCE_LINE 00000041 "}"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "sub requirements_for {"
NSQ_SOURCE_LINE 00000044 "\tmy ($meta, $phases, $type) = @_;"
NSQ_SOURCE_LINE 00000045 "\tmy $prereqs = ref($meta) eq 'CPAN::Meta' ? $meta->effective_prereqs : $meta;"
NSQ_SOURCE_LINE 00000046 "\treturn $prereqs->merged_requirements(ref($phases) ? $phases : [ $phases ], [ $type ]);"
NSQ_SOURCE_LINE 00000047 "}"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "sub check_requirements {"
NSQ_SOURCE_LINE 00000050 "\tmy ($reqs, $type, $dirs) = @_;"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "\treturn +{"
NSQ_SOURCE_LINE 00000053 "\t\tmap {"
NSQ_SOURCE_LINE 00000054 "\t\t\t$_ => $type ne 'conflicts'"
NSQ_SOURCE_LINE 00000055 "\t\t\t\t? scalar _check_dep($reqs, $_, $dirs)"
NSQ_SOURCE_LINE 00000056 "\t\t\t\t: scalar _check_conflict($reqs, $_, $dirs)"
NSQ_SOURCE_LINE 00000057 "\t\t} $reqs->required_modules"
NSQ_SOURCE_LINE 00000058 "\t};"
NSQ_SOURCE_LINE 00000059 "}"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "sub verify_dependencies {"
NSQ_SOURCE_LINE 00000062 "\tmy ($meta, $phases, $type, $dirs) = @_;"
NSQ_SOURCE_LINE 00000063 "\tmy $reqs = requirements_for($meta, $phases, $type);"
NSQ_SOURCE_LINE 00000064 "\tmy $issues = check_requirements($reqs, $type, $dirs);"
NSQ_SOURCE_LINE 00000065 "\treturn grep { defined } values %{ $issues };"
NSQ_SOURCE_LINE 00000066 "}"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "1;"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "#ABSTRACT: Verify requirements in a CPAN::Meta object"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "__END__"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=pod"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=head1 NAME"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "CPAN::Meta::Check - Verify requirements in a CPAN::Meta object"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=head1 VERSION"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "version 0.018"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 " warn \"$_\\n\" for verify_dependencies($meta, [qw/runtime build test/], 'requires');"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "This module verifies if requirements described in a CPAN::Meta object are present."
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=head2 check_requirements($reqs, $type, $incdirs)"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "This function checks if all dependencies in C<$reqs> (a L<CPAN::Meta::Requirements|CPAN::Meta::Requirements> object) are met, taking into account that 'conflicts' dependencies have to be checked in reverse. It returns a hash with the modules as keys and any problems as values; the value for a successfully found module will be undef. Modules are searched for in C<@$incdirs>, defaulting to C<@INC>."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=head2 verify_dependencies($meta, $phases, $types, $incdirs)"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "Check all requirements in C<$meta> for phases C<$phases> and type C<$type>. Modules are searched for in C<@$incdirs>, defaulting to C<@INC>. C<$meta> should be a L<CPAN::Meta::Prereqs> or L<CPAN::Meta> object."
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=head2 requirements_for($meta, $phases, $types)"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "B<< This function is deprecated and may be removed at some point in the future, please use CPAN::Meta::Prereqs->merged_requirements instead. >>"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "This function returns a unified L<CPAN::Meta::Requirements|CPAN::Meta::Requirements> object for all C<$type> requirements for C<$phases>. C<$phases> may be either one (scalar) value or an arrayref of valid values as defined by the L<CPAN::Meta spec|CPAN::Meta::Spec>. C<$type> must be a relationship as defined by the same spec. C<$meta> should be a L<CPAN::Meta::Prereqs> or L<CPAN::Meta> object."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=over 4"
NSQ_SOURCE_LINE 00000113 ""
