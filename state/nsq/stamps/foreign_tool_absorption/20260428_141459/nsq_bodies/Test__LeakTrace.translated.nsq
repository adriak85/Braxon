NSQ_SOURCE_LINE 00000001 "package Test::LeakTrace;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.008_001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.17';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use XSLoader;"
NSQ_SOURCE_LINE 00000010 "XSLoader::load(__PACKAGE__, $VERSION);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Test::Builder::Module;"
NSQ_SOURCE_LINE 00000013 "our @ISA = qw(Test::Builder::Module);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use Exporter qw(import); # use Exporter::import for backward compatibility"
NSQ_SOURCE_LINE 00000016 "our @EXPORT = qw("
NSQ_SOURCE_LINE 00000017 "    leaktrace leaked_refs leaked_info leaked_count"
NSQ_SOURCE_LINE 00000018 "    no_leaks_ok leaks_cmp_ok"
NSQ_SOURCE_LINE 00000019 "    count_sv"
NSQ_SOURCE_LINE 00000020 ");"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000023 "    all  => \\@EXPORT,"
NSQ_SOURCE_LINE 00000024 "    test => [qw(no_leaks_ok leaks_cmp_ok)],"
NSQ_SOURCE_LINE 00000025 "    util => [qw(leaktrace leaked_refs leaked_info leaked_count count_sv)],"
NSQ_SOURCE_LINE 00000026 ");"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub _do_leaktrace{"
NSQ_SOURCE_LINE 00000030 "    my($block, $name, $need_stateinfo, $mode) = @_;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    if(!defined($mode) && !defined wantarray){"
NSQ_SOURCE_LINE 00000033 "        warnings::warnif void => \"Useless use of $name() in void context\";"
NSQ_SOURCE_LINE 00000034 "    }"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    if($name eq 'leaked_count') {"
NSQ_SOURCE_LINE 00000037 "        my $start;"
NSQ_SOURCE_LINE 00000038 "        $start = count_sv();"
NSQ_SOURCE_LINE 00000039 "        $block->();"
NSQ_SOURCE_LINE 00000040 "        return count_sv() - $start;"
NSQ_SOURCE_LINE 00000041 "    }"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    local $SIG{__DIE__} = 'DEFAULT';"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    _start($need_stateinfo);"
NSQ_SOURCE_LINE 00000046 "    eval{"
NSQ_SOURCE_LINE 00000047 "        $block->();"
NSQ_SOURCE_LINE 00000048 "    };"
NSQ_SOURCE_LINE 00000049 "    if($@){"
NSQ_SOURCE_LINE 00000050 "        _finish(-silent);"
NSQ_SOURCE_LINE 00000051 "        die $@;"
NSQ_SOURCE_LINE 00000052 "    }"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    return _finish($mode);"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub leaked_refs(&){"
NSQ_SOURCE_LINE 00000058 "    my($block) = @_;"
NSQ_SOURCE_LINE 00000059 "    return _do_leaktrace($block, 'leaked_refs', 0);"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "sub leaked_info(&){"
NSQ_SOURCE_LINE 00000063 "    my($block) = @_;"
NSQ_SOURCE_LINE 00000064 "    return _do_leaktrace($block, 'leaked_refs', 1);"
NSQ_SOURCE_LINE 00000065 "}"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "sub leaked_count(&){"
NSQ_SOURCE_LINE 00000068 "    my($block) = @_;"
NSQ_SOURCE_LINE 00000069 "    return scalar _do_leaktrace($block, 'leaked_count', 0);"
NSQ_SOURCE_LINE 00000070 "}"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "sub leaktrace(&;$){"
NSQ_SOURCE_LINE 00000073 "    my($block, $mode) = @_;"
NSQ_SOURCE_LINE 00000074 "    _do_leaktrace($block, 'leaktrace', 1, defined($mode) ? $mode : -simple);"
NSQ_SOURCE_LINE 00000075 "    return;"
NSQ_SOURCE_LINE 00000076 "}"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "sub leaks_cmp_ok(&$$;$){"
NSQ_SOURCE_LINE 00000080 "    my($block, $cmp_op, $expected, $description) = @_;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    my $Test = __PACKAGE__->builder;"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    if(!_runops_installed()){"
NSQ_SOURCE_LINE 00000085 "        my $mod = exists $INC{'Devel/Cover.pm'} ? 'Devel::Cover' : 'strange runops routines';"
NSQ_SOURCE_LINE 00000086 "        return $Test->ok(1, \"skipped (under $mod)\");"
NSQ_SOURCE_LINE 00000087 "    }"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    # calls to prepare cache in $block"
NSQ_SOURCE_LINE 00000090 "    $block->();"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    my $got = _do_leaktrace($block, 'leaked_count', 0);"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    my $desc = sprintf 'leaks %s %-2s %s', $got, $cmp_op, $expected;"
NSQ_SOURCE_LINE 00000095 "    if(defined $description){"
NSQ_SOURCE_LINE 00000096 "        $description .= \" ($desc)\";"
NSQ_SOURCE_LINE 00000097 "    }"
NSQ_SOURCE_LINE 00000098 "    else{"
NSQ_SOURCE_LINE 00000099 "        $description = $desc;"
NSQ_SOURCE_LINE 00000100 "    }"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "    my $result = $Test->cmp_ok($got, $cmp_op, $expected, $description);"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    if(!$result){"
NSQ_SOURCE_LINE 00000105 "        open local(*STDERR), '>', \\(my $content = '');"
NSQ_SOURCE_LINE 00000106 "        $block->(); # calls it again because opening *STDERR changes the run-time environment"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "        _do_leaktrace($block, 'leaktrace', 1, -verbose);"
NSQ_SOURCE_LINE 00000109 "        $Test->diag($content);"
NSQ_SOURCE_LINE 00000110 "    }"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "    return $result;"
NSQ_SOURCE_LINE 00000113 "}"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "sub no_leaks_ok(&;$){"
NSQ_SOURCE_LINE 00000116 "    # ($block, $description)"
NSQ_SOURCE_LINE 00000117 "    splice @_, 1, 0, ('<=', 0); # ($block, '<=', 0, $description);"
NSQ_SOURCE_LINE 00000118 "    goto &leaks_cmp_ok;"
NSQ_SOURCE_LINE 00000119 "}"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "1;"
NSQ_SOURCE_LINE 00000123 "__END__"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=for stopwords sv gfx"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=head1 NAME"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "Test::LeakTrace - Traces memory leaks"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=head1 VERSION"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "This document describes Test::LeakTrace version 0.17."
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    use Test::LeakTrace;"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    # simple report"
NSQ_SOURCE_LINE 00000140 "    leaktrace{"
NSQ_SOURCE_LINE 00000141 "        # ..."
NSQ_SOURCE_LINE 00000142 "    };"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    # verbose output"
NSQ_SOURCE_LINE 00000145 "    leaktrace{"
NSQ_SOURCE_LINE 00000146 "        # ..."
NSQ_SOURCE_LINE 00000147 "    } -verbose;"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    # with callback"
NSQ_SOURCE_LINE 00000150 "    leaktrace{"
NSQ_SOURCE_LINE 00000151 "        # ..."
NSQ_SOURCE_LINE 00000152 "    } sub {"
NSQ_SOURCE_LINE 00000153 "        my($ref, $file, $line) = @_;"
NSQ_SOURCE_LINE 00000154 "        warn \"leaked $ref from $file line\\n\";"
NSQ_SOURCE_LINE 00000155 "    };"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    my @refs = leaked_refs{"
NSQ_SOURCE_LINE 00000158 "        # ..."
NSQ_SOURCE_LINE 00000159 "    };"
NSQ_SOURCE_LINE 00000160 "    my @info = leaked_info{"
NSQ_SOURCE_LINE 00000161 "        # ..."
NSQ_SOURCE_LINE 00000162 "    };"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "    my $count = leaked_count{"
NSQ_SOURCE_LINE 00000165 "        # ..."
NSQ_SOURCE_LINE 00000166 "    };"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    # standard test interface"
NSQ_SOURCE_LINE 00000169 "    use Test::LeakTrace;"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    no_leaks_ok{"
NSQ_SOURCE_LINE 00000172 "        # ..."
NSQ_SOURCE_LINE 00000173 "    } 'no memory leaks';"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    leaks_cmp_ok{"
NSQ_SOURCE_LINE 00000176 "        # ..."
NSQ_SOURCE_LINE 00000177 "    } '<', 10;"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "C<Test::LeakTrace> provides several functions that trace memory leaks."
NSQ_SOURCE_LINE 00000182 "This module scans arenas, the memory allocation system,"
NSQ_SOURCE_LINE 00000183 "so it can detect any leaked SVs in given blocks."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "B<Leaked SVs> are SVs which are not released after the end of the scope"
NSQ_SOURCE_LINE 00000186 "they have been created. These SVs include global variables and internal caches."
NSQ_SOURCE_LINE 00000187 "For example, if you call a method in a tracing block, perl might prepare a cache"
NSQ_SOURCE_LINE 00000188 "for the method. Thus, to trace true leaks, C<no_leaks_ok()> and C<leaks_cmp_ok()>"
NSQ_SOURCE_LINE 00000189 "executes a block more than once."
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=head1 INTERFACE"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=head2 Exported functions"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=head3 C<< leaked_info { BLOCK } >>"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "Executes I<BLOCK> and returns a list of leaked SVs and places where the SVs"
NSQ_SOURCE_LINE 00000198 "come from, i.e. C<< [$ref, $file, $line] >>."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=head3 C<< leaked_refs { BLOCK } >>"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "Executes I<BLOCK> and returns a list of leaked SVs."
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=head3 C<< leaked_count { BLOCK } >>"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "Executes I<BLOCK> and returns the number of leaked SVs."
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=head3 C<< leaktrace { BLOCK } ?($mode | \\&callback) >>"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "Executes I<BLOCK> and reports leaked SVs to C<*STDERR>."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "Defined I<$mode>s are:"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=over 4"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=item -simple"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "Default. Reports the leaked SV identity (type and address), file name and line number."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=item -sv_dump"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "In addition to B<-simple>, dumps the sv content using C<sv_dump()>,"
NSQ_SOURCE_LINE 00000223 "which also implements C<Devel::Peek::Dump()>."
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=item -lines"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "In addition to B<-simple>, prints suspicious source lines."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=item -verbose"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "Both B<-sv_dump> and B<-lines>."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=back"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=head3 C<< no_leaks_ok { BLOCK } ?$description >>"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "Tests that I<BLOCK> does not leaks SVs. This is a test function"
NSQ_SOURCE_LINE 00000238 "using C<Test::Builder>."
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "Note that I<BLOCK> is called more than once. This is because"
NSQ_SOURCE_LINE 00000241 "I<BLOCK> might prepare caches which are not memory leaks."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head3 C<< leaks_cmp_ok { BLOCK } $cmp_op, $number, ?$description >>"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "Tests that I<BLOCK> leaks a specific number of SVs. This is a test"
NSQ_SOURCE_LINE 00000246 "function using C<Test::Builder>."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "Note that I<BLOCK> is called more than once. This is because"
NSQ_SOURCE_LINE 00000249 "I<BLOCK> might prepare caches which are not memory leaks."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=head3 C<< count_sv() >>"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "Counts all the SVs in the arena."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=head2 Script interface"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "Like C<Devel::LeakTrace> C<Test::LeakTrace::Script> is provided for whole scripts."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "The arguments of C<use Test::LeakTrace::Script> directive is the same as C<leaktrace()>."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "    $ TEST_LEAKTRACE=-sv_dump perl -MTest::LeakTrace::Script script.pl"
NSQ_SOURCE_LINE 00000262 "    $ perl -MTest::LeakTrace::Script=-verbose script.pl"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "    #!perl"
NSQ_SOURCE_LINE 00000265 "    # ..."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "    use Test::LeakTrace::Script sub{"
NSQ_SOURCE_LINE 00000268 "        my($ref, $file, $line) = @_;"
NSQ_SOURCE_LINE 00000269 "        # ..."
NSQ_SOURCE_LINE 00000270 "    };"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "    # ..."
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "=head2 Testing modules"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "Here is a test script template that checks memory leaks."
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "    #!perl -w"
NSQ_SOURCE_LINE 00000281 "    use strict;"
NSQ_SOURCE_LINE 00000282 "    use constant HAS_LEAKTRACE => eval{ require Test::LeakTrace };"
NSQ_SOURCE_LINE 00000283 "    use Test::More HAS_LEAKTRACE ? (tests => 1) : (skip_all => 'require Test::LeakTrace');"
NSQ_SOURCE_LINE 00000284 "    use Test::LeakTrace;"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "    use Some::Module;"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "    leaks_cmp_ok{"
NSQ_SOURCE_LINE 00000289 "        my $o = Some::Module->new();"
NSQ_SOURCE_LINE 00000290 "        $o->something();"
NSQ_SOURCE_LINE 00000291 "        $o->something_else();"
NSQ_SOURCE_LINE 00000292 "    } '<', 1;"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=head1 DEPENDENCIES"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "Perl 5.8.1 or later, and a C compiler."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "C<Test::LeakTrace> does not work with C<Devel::Cover> and modules which install"
NSQ_SOURCE_LINE 00000301 "their own C<runops> routines, or the perl executor. So if the test functions of"
NSQ_SOURCE_LINE 00000302 "this module detect strange C<runops> routines, they do nothing and report okay."
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=head1 BUGS"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "No bugs have been reported."
