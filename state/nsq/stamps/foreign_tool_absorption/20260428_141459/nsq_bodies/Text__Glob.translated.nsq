BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Text::Glob;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use Exporter;"
NSQ_SOURCE_LINE 00000004 "use vars qw/$VERSION @ISA @EXPORT_OK"
NSQ_SOURCE_LINE 00000005 "            $strict_leading_dot $strict_wildcard_slash/;"
NSQ_SOURCE_LINE 00000006 "$VERSION = '0.11';"
NSQ_SOURCE_LINE 00000007 "@ISA = 'Exporter';"
NSQ_SOURCE_LINE 00000008 "@EXPORT_OK = qw( glob_to_regex glob_to_regex_string match_glob );"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "$strict_leading_dot    = 1;"
NSQ_SOURCE_LINE 00000011 "$strict_wildcard_slash = 1;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use constant debug => 0;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub glob_to_regex {"
NSQ_SOURCE_LINE 00000016 "    my $glob = shift;"
NSQ_SOURCE_LINE 00000017 "    my $regex = glob_to_regex_string($glob);"
NSQ_SOURCE_LINE 00000018 "    return qr/^$regex$/;"
NSQ_SOURCE_LINE 00000019 "}"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub glob_to_regex_string"
NSQ_SOURCE_LINE 00000022 "{"
NSQ_SOURCE_LINE 00000023 "    my $glob = shift;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    my $seperator = $Text::Glob::seperator;"
NSQ_SOURCE_LINE 00000026 "    $seperator = \"/\" unless defined $seperator;"
NSQ_SOURCE_LINE 00000027 "    $seperator = quotemeta($seperator);"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    my ($regex, $in_curlies, $escaping);"
NSQ_SOURCE_LINE 00000030 "    local $_;"
NSQ_SOURCE_LINE 00000031 "    my $first_byte = 1;"
NSQ_SOURCE_LINE 00000032 "    for ($glob =~ m/(.)/gs) {"
NSQ_SOURCE_LINE 00000033 "        if ($first_byte) {"
NSQ_SOURCE_LINE 00000034 "            if ($strict_leading_dot) {"
NSQ_SOURCE_LINE 00000035 "                $regex .= '(?=[^\\.])' unless $_ eq '.';"
NSQ_SOURCE_LINE 00000036 "            }"
NSQ_SOURCE_LINE 00000037 "            $first_byte = 0;"
NSQ_SOURCE_LINE 00000038 "        }"
NSQ_SOURCE_LINE 00000039 "        if ($_ eq '/') {"
NSQ_SOURCE_LINE 00000040 "            $first_byte = 1;"
NSQ_SOURCE_LINE 00000041 "        }"
NSQ_SOURCE_LINE 00000042 "        if ($_ eq '.' || $_ eq '(' || $_ eq ')' || $_ eq '|' ||"
NSQ_SOURCE_LINE 00000043 "            $_ eq '+' || $_ eq '^' || $_ eq '$' || $_ eq '@' || $_ eq '%' ) {"
NSQ_SOURCE_LINE 00000044 "            $regex .= \"\\\\$_\";"
NSQ_SOURCE_LINE 00000045 "        }"
NSQ_SOURCE_LINE 00000046 "        elsif ($_ eq '*') {"
NSQ_SOURCE_LINE 00000047 "            $regex .= $escaping ? \"\\\\*\" :"
NSQ_SOURCE_LINE 00000048 "              $strict_wildcard_slash ? \"(?:(?!$seperator).)*\" : \".*\";"
NSQ_SOURCE_LINE 00000049 "        }"
NSQ_SOURCE_LINE 00000050 "        elsif ($_ eq '?') {"
NSQ_SOURCE_LINE 00000051 "            $regex .= $escaping ? \"\\\\?\" :"
NSQ_SOURCE_LINE 00000052 "              $strict_wildcard_slash ? \"(?!$seperator).\" : \".\";"
NSQ_SOURCE_LINE 00000053 "        }"
NSQ_SOURCE_LINE 00000054 "        elsif ($_ eq '{') {"
NSQ_SOURCE_LINE 00000055 "            $regex .= $escaping ? \"\\\\{\" : \"(\";"
NSQ_SOURCE_LINE 00000056 "            ++$in_curlies unless $escaping;"
NSQ_SOURCE_LINE 00000057 "        }"
NSQ_SOURCE_LINE 00000058 "        elsif ($_ eq '}' && $in_curlies) {"
NSQ_SOURCE_LINE 00000059 "            $regex .= $escaping ? \"}\" : \")\";"
NSQ_SOURCE_LINE 00000060 "            --$in_curlies unless $escaping;"
NSQ_SOURCE_LINE 00000061 "        }"
NSQ_SOURCE_LINE 00000062 "        elsif ($_ eq ',' && $in_curlies) {"
NSQ_SOURCE_LINE 00000063 "            $regex .= $escaping ? \",\" : \"|\";"
NSQ_SOURCE_LINE 00000064 "        }"
NSQ_SOURCE_LINE 00000065 "        elsif ($_ eq \"\\\\\") {"
NSQ_SOURCE_LINE 00000066 "            if ($escaping) {"
NSQ_SOURCE_LINE 00000067 "                $regex .= \"\\\\\\\\\";"
NSQ_SOURCE_LINE 00000068 "                $escaping = 0;"
NSQ_SOURCE_LINE 00000069 "            }"
NSQ_SOURCE_LINE 00000070 "            else {"
NSQ_SOURCE_LINE 00000071 "                $escaping = 1;"
NSQ_SOURCE_LINE 00000072 "            }"
NSQ_SOURCE_LINE 00000073 "            next;"
NSQ_SOURCE_LINE 00000074 "        }"
NSQ_SOURCE_LINE 00000075 "        else {"
NSQ_SOURCE_LINE 00000076 "            $regex .= $_;"
NSQ_SOURCE_LINE 00000077 "            $escaping = 0;"
NSQ_SOURCE_LINE 00000078 "        }"
NSQ_SOURCE_LINE 00000079 "        $escaping = 0;"
NSQ_SOURCE_LINE 00000080 "    }"
NSQ_SOURCE_LINE 00000081 "    print \"# $glob $regex\\n\" if debug;"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "    return $regex;"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub match_glob {"
NSQ_SOURCE_LINE 00000087 "    print \"# \", join(', ', map { \"'$_'\" } @_), \"\\n\" if debug;"
NSQ_SOURCE_LINE 00000088 "    my $glob = shift;"
NSQ_SOURCE_LINE 00000089 "    my $regex = glob_to_regex $glob;"
NSQ_SOURCE_LINE 00000090 "    local $_;"
NSQ_SOURCE_LINE 00000091 "    grep { $_ =~ $regex } @_;"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "1;"
NSQ_SOURCE_LINE 00000095 "__END__"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head1 NAME"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "Text::Glob - match globbing patterns against text"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 " use Text::Glob qw( match_glob glob_to_regex );"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 " print \"matched\\n\" if match_glob( \"foo.*\", \"foo.bar\" );"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 " # prints foo.bar and foo.baz"
NSQ_SOURCE_LINE 00000108 " my $regex = glob_to_regex( \"foo.*\" );"
NSQ_SOURCE_LINE 00000109 " for ( qw( foo.bar foo.baz foo bar ) ) {"
NSQ_SOURCE_LINE 00000110 "     print \"matched: $_\\n\" if /$regex/;"
NSQ_SOURCE_LINE 00000111 " }"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "Text::Glob implements glob(3) style matching that can be used to match"
NSQ_SOURCE_LINE 00000116 "against text, rather than fetching names from a filesystem.  If you"
NSQ_SOURCE_LINE 00000117 "want to do full file globbing use the File::Glob module instead."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head2 Routines"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=over"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=item match_glob( $glob, @things_to_test )"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "Returns the list of things which match the glob from the source list."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=item glob_to_regex( $glob )"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "Returns a compiled regex which is the equivalent of the globbing"
NSQ_SOURCE_LINE 00000130 "pattern."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=item glob_to_regex_string( $glob )"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Returns a regex string which is the equivalent of the globbing"
NSQ_SOURCE_LINE 00000135 "pattern."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=back"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 SYNTAX"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "The following metacharacters and rules are respected."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=over"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=item C<*> - match zero or more characters"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "C<a*> matches C<a>, C<aa>, C<aaaa> and many many more."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=item C<?> - match exactly one character"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "C<a?> matches C<aa>, but not C<a>, or C<aaa>"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=item Character sets/ranges"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "C<example.[ch]> matches C<example.c> and C<example.h>"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "C<demo.[a-c]> matches C<demo.a>, C<demo.b>, and C<demo.c>"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=item alternation"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "C<example.{foo,bar,baz}> matches C<example.foo>, C<example.bar>, and"
NSQ_SOURCE_LINE 00000162 "C<example.baz>"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=item leading . must be explicitly matched"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "C<*.foo> does not match C<.bar.foo>.  For this you must either specify"
NSQ_SOURCE_LINE 00000167 "the leading . in the glob pattern (C<.*.foo>), or set"
NSQ_SOURCE_LINE 00000168 "C<$Text::Glob::strict_leading_dot> to a false value while compiling"
NSQ_SOURCE_LINE 00000169 "the regex."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=item C<*> and C<?> do not match the seperator (i.e. do not match C</>)"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "C<*.foo> does not match C<bar/baz.foo>.  For this you must either"
NSQ_SOURCE_LINE 00000174 "explicitly match the / in the glob (C<*/*.foo>), or set"
NSQ_SOURCE_LINE 00000175 "C<$Text::Glob::strict_wildcard_slash> to a false value while compiling"
NSQ_SOURCE_LINE 00000176 "the regex, or change the seperator that Text::Glob uses by setting"
NSQ_SOURCE_LINE 00000177 "C<$Text::Glob::seperator> to an alternative value while compiling the"
NSQ_SOURCE_LINE 00000178 "the regex."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=back"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head1 BUGS"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "The code uses qr// to produce compiled regexes, therefore this module"
NSQ_SOURCE_LINE 00000185 "requires perl version 5.005_03 or newer."
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000188 ""
