NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "=head1 NAME"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "Text::VisualWidth - Perl extension for trimming text by the number of the columns of terminals and mobile phones."
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "  use Text::VisualWidth::EUC_JP;"
NSQ_SOURCE_LINE 00000023 "  my $length = Text::VisualWidth::EUC_JP::width($str);"
NSQ_SOURCE_LINE 00000024 "  my $str    = Text::VisualWidth::EUC_JP::trim($str, 20);"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "  use Text::VisualWidth::UTF8;"
NSQ_SOURCE_LINE 00000027 "  my $length = Text::VisualWidth::UTF8::width($str);"
NSQ_SOURCE_LINE 00000028 "  my $str    = Text::VisualWidth::UTF8::trim($str, 20);"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "This module provides functions to treat half-width and full-width characters and display correct size of text in one line on terminals and mobile phones. You can know the visual width of any text and truncate text by the visual width."
NSQ_SOURCE_LINE 00000033 "Now this module support EUC-JP and UTF-8 and tested only with Japanese."
NSQ_SOURCE_LINE 00000034 ""
