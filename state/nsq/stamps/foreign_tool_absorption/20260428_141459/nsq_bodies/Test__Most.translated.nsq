NSQ_SOURCE_LINE 00000001 "package Test::Most;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Test::Most::Exception 'throw_failure';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "# XXX don't use 'base' as it can override signal handlers"
NSQ_SOURCE_LINE 00000009 "use Test::Builder::Module;"
NSQ_SOURCE_LINE 00000010 "our ( @ISA, @EXPORT, $DATA_DUMPER_NAMES_INSTALLED );"
NSQ_SOURCE_LINE 00000011 "my $HAVE_TIME_HIRES;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "BEGIN {"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "    require Test::More;"
NSQ_SOURCE_LINE 00000016 "    if (Test::More->can('TB_PROVIDER_META')) {"
NSQ_SOURCE_LINE 00000017 "        Test::More->import(import => [ '!explain' ]);"
NSQ_SOURCE_LINE 00000018 "    }"
NSQ_SOURCE_LINE 00000019 "    else {"
NSQ_SOURCE_LINE 00000020 "        # There's some strange fiddling around with import(), so this allows us to"
NSQ_SOURCE_LINE 00000021 "        # be nicely backwards compatible to earlier versions of Test::More."
NSQ_SOURCE_LINE 00000022 "        local @Test::More::EXPORT = grep { $_ ne 'explain' } @Test::More::EXPORT;"
NSQ_SOURCE_LINE 00000023 "        Test::More->import;"
NSQ_SOURCE_LINE 00000024 "    }"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    eval \"use Time::HiRes\";"
NSQ_SOURCE_LINE 00000027 "    $HAVE_TIME_HIRES = 1 unless $@;"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "use Test::Builder;"
NSQ_SOURCE_LINE 00000031 "my $OK_FUNC;"
NSQ_SOURCE_LINE 00000032 "BEGIN {"
NSQ_SOURCE_LINE 00000033 "    $OK_FUNC = \\&Test::Builder::ok;"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "our $VERSION = '0.38';"
NSQ_SOURCE_LINE 00000037 "$VERSION = eval $VERSION;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "BEGIN {"
NSQ_SOURCE_LINE 00000040 "    @ISA    = qw(Test::Builder::Module);"
NSQ_SOURCE_LINE 00000041 "    @EXPORT = ("
NSQ_SOURCE_LINE 00000042 "        Test::More->can('TB_PROVIDER_META')"
NSQ_SOURCE_LINE 00000043 "            ? grep { $_ ne 'TODO' } keys( %{Test::More->TB_PROVIDER_META->{attrs}})"
NSQ_SOURCE_LINE 00000044 "            : @Test::More::EXPORT,"
NSQ_SOURCE_LINE 00000045 "        qw<"
NSQ_SOURCE_LINE 00000046 "            $TODO"
NSQ_SOURCE_LINE 00000047 "            all_done"
NSQ_SOURCE_LINE 00000048 "            bail_on_fail"
NSQ_SOURCE_LINE 00000049 "            die_on_fail"
NSQ_SOURCE_LINE 00000050 "            explain"
NSQ_SOURCE_LINE 00000051 "            always_explain"
NSQ_SOURCE_LINE 00000052 "            last_test_failed"
NSQ_SOURCE_LINE 00000053 "            restore_fail"
NSQ_SOURCE_LINE 00000054 "            set_failure_handler"
NSQ_SOURCE_LINE 00000055 "            show"
NSQ_SOURCE_LINE 00000056 "            always_show"
NSQ_SOURCE_LINE 00000057 "        >"
NSQ_SOURCE_LINE 00000058 "    );"
NSQ_SOURCE_LINE 00000059 "}"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "sub import {"
NSQ_SOURCE_LINE 00000062 "    my $bail_set = 0;"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    my %modules_to_load = map { $_ => 1 } qw/"
NSQ_SOURCE_LINE 00000065 "        Test::Differences"
NSQ_SOURCE_LINE 00000066 "        Test::Exception"
NSQ_SOURCE_LINE 00000067 "        Test::Deep"
NSQ_SOURCE_LINE 00000068 "        Test::Warn"
NSQ_SOURCE_LINE 00000069 "    /;"
NSQ_SOURCE_LINE 00000070 "    warnings->import;"
NSQ_SOURCE_LINE 00000071 "    strict->import;"
NSQ_SOURCE_LINE 00000072 "    eval \"use Data::Dumper::Names 0.03\";"
NSQ_SOURCE_LINE 00000073 "    $DATA_DUMPER_NAMES_INSTALLED = !$@;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    if ( $ENV{BAIL_ON_FAIL} ) {"
NSQ_SOURCE_LINE 00000076 "        $bail_set = 1;"
NSQ_SOURCE_LINE 00000077 "        bail_on_fail();"
NSQ_SOURCE_LINE 00000078 "    }"
NSQ_SOURCE_LINE 00000079 "    if ( !$bail_set and $ENV{DIE_ON_FAIL} ) {"
NSQ_SOURCE_LINE 00000080 "        die_on_fail();"
NSQ_SOURCE_LINE 00000081 "    }"
NSQ_SOURCE_LINE 00000082 "    for my $i ( 0 .. $#_ ) {"
NSQ_SOURCE_LINE 00000083 "        if ( 'bail' eq $_[$i] ) {"
NSQ_SOURCE_LINE 00000084 "            splice @_, $i, 1;"
NSQ_SOURCE_LINE 00000085 "            bail_on_fail();"
NSQ_SOURCE_LINE 00000086 "            $bail_set = 1;"
NSQ_SOURCE_LINE 00000087 "            last;"
NSQ_SOURCE_LINE 00000088 "        }"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000091 "    for my $i ( 0 .. $#_ ) {"
NSQ_SOURCE_LINE 00000092 "        if ( 'timeit' eq $_[$i] ) {"
NSQ_SOURCE_LINE 00000093 "            splice @_, $i, 1;"
NSQ_SOURCE_LINE 00000094 "            no strict;"
NSQ_SOURCE_LINE 00000095 "            *{\"${caller}::timeit\"} = \\&timeit;"
NSQ_SOURCE_LINE 00000096 "            last;"
NSQ_SOURCE_LINE 00000097 "        }"
NSQ_SOURCE_LINE 00000098 "    }"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    my %exclude_symbol;"
NSQ_SOURCE_LINE 00000101 "    my $i = 0;"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "    foreach my $do_not_import_by_default (qw/blessed reftype/) {"
NSQ_SOURCE_LINE 00000104 "        if ( grep { $_ eq $do_not_import_by_default } @_ ) {"
NSQ_SOURCE_LINE 00000105 "            @_ = grep { $_ ne $do_not_import_by_default } @_;"
NSQ_SOURCE_LINE 00000106 "        }"
NSQ_SOURCE_LINE 00000107 "        else {"
NSQ_SOURCE_LINE 00000108 "            $exclude_symbol{$do_not_import_by_default} = 1;"
NSQ_SOURCE_LINE 00000109 "        }"
NSQ_SOURCE_LINE 00000110 "    }"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "    while ($i < @_) {"
NSQ_SOURCE_LINE 00000113 "        if ( !$bail_set and ( 'die' eq $_[$i] ) ) {"
NSQ_SOURCE_LINE 00000114 "            splice @_, $i, 1;"
NSQ_SOURCE_LINE 00000115 "            die_on_fail();"
NSQ_SOURCE_LINE 00000116 "            $i = 0;"
NSQ_SOURCE_LINE 00000117 "            next;"
NSQ_SOURCE_LINE 00000118 "        }"
NSQ_SOURCE_LINE 00000119 "        if ( $_[$i] =~ /^-(.*)/ ) {"
NSQ_SOURCE_LINE 00000120 "            my $module = $1;"
NSQ_SOURCE_LINE 00000121 "            splice @_, $i, 1;"
NSQ_SOURCE_LINE 00000122 "            unless (exists $modules_to_load{$module}) {"
NSQ_SOURCE_LINE 00000123 "                require Carp;"
NSQ_SOURCE_LINE 00000124 "                Carp::croak(\"Cannot remove non-existent Test::Module ($module)\");"
NSQ_SOURCE_LINE 00000125 "            }"
NSQ_SOURCE_LINE 00000126 "            delete $modules_to_load{$module};"
NSQ_SOURCE_LINE 00000127 "            $i = 0;"
NSQ_SOURCE_LINE 00000128 "            next;"
NSQ_SOURCE_LINE 00000129 "        }"
NSQ_SOURCE_LINE 00000130 "        if ( $_[$i] =~ /^!(.*)/ ) {"
NSQ_SOURCE_LINE 00000131 "            splice @_, $i, 1;"
NSQ_SOURCE_LINE 00000132 "            $exclude_symbol{$1} = 1;"
NSQ_SOURCE_LINE 00000133 "            $i = 0;"
NSQ_SOURCE_LINE 00000134 "            next;"
NSQ_SOURCE_LINE 00000135 "        }"
NSQ_SOURCE_LINE 00000136 "        if ( 'defer_plan' eq $_[$i] ) {"
NSQ_SOURCE_LINE 00000137 "            require Carp;"
NSQ_SOURCE_LINE 00000138 "            Carp::carp(<<'END') unless $ENV{DO_NOT_WARN_ON_DEFER_PLAN};"
NSQ_SOURCE_LINE 00000139 "defer_plan() is deprecated and will be removed in a future release of"
NSQ_SOURCE_LINE 00000140 "Test::Most. It's functionality is provided by Test::More's done_testing(),"
NSQ_SOURCE_LINE 00000141 "first added in 2009 (0.88)."
NSQ_SOURCE_LINE 00000142 "END"
NSQ_SOURCE_LINE 00000143 "            splice @_, $i, 1;"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "            my $builder = Test::Builder->new;"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "            # XXX I don't like setting this directly, but"
NSQ_SOURCE_LINE 00000148 "            # Test::Builder::has_plan isn't public"
NSQ_SOURCE_LINE 00000149 "            $builder->{Have_Plan}               = 1;"
NSQ_SOURCE_LINE 00000150 "            $builder->{TEST_MOST_deferred_plan} = 1;"
NSQ_SOURCE_LINE 00000151 "            $builder->{TEST_MOST_all_done}      = 0;"
NSQ_SOURCE_LINE 00000152 "            $i = 0;"
NSQ_SOURCE_LINE 00000153 "            next;"
NSQ_SOURCE_LINE 00000154 "        }"
NSQ_SOURCE_LINE 00000155 "        $i++;"
NSQ_SOURCE_LINE 00000156 "    }"
NSQ_SOURCE_LINE 00000157 "    foreach my $module (keys %modules_to_load) {"
NSQ_SOURCE_LINE 00000158 "        eval \"use $module\";"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "        if ( my $error = $@) {"
NSQ_SOURCE_LINE 00000161 "            require Carp;"
NSQ_SOURCE_LINE 00000162 "            Carp::croak($error);"
NSQ_SOURCE_LINE 00000163 "        }"
NSQ_SOURCE_LINE 00000164 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000165 "        # Note: export_to_level would be better here."
NSQ_SOURCE_LINE 00000166 "        push @EXPORT => grep { !$exclude_symbol{$_} } @{\"${module}::EXPORT\"};"
NSQ_SOURCE_LINE 00000167 "    }"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    # 'magic' goto to avoid updating the callstack"
NSQ_SOURCE_LINE 00000170 "    goto &Test::Builder::Module::import;"
NSQ_SOURCE_LINE 00000171 "}"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "sub explain {"
NSQ_SOURCE_LINE 00000174 "    _explain(\\&Test::More::note, @_);"
NSQ_SOURCE_LINE 00000175 "}"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "sub timeit(&;$) {"
NSQ_SOURCE_LINE 00000179 "    my ( $code, $message ) = @_;"
NSQ_SOURCE_LINE 00000180 "    unless($HAVE_TIME_HIRES) {"
NSQ_SOURCE_LINE 00000181 "        Test::Most::diag(\"timeit: Time::HiRes not installed\");"
NSQ_SOURCE_LINE 00000182 "        $code->();"
NSQ_SOURCE_LINE 00000183 "    }"
NSQ_SOURCE_LINE 00000184 "    if ( !$message ) {"
NSQ_SOURCE_LINE 00000185 "        my ( $package, $filename, $line ) = caller;"
NSQ_SOURCE_LINE 00000186 "        $message = \"$filename line $line\";"
NSQ_SOURCE_LINE 00000187 "    }"
NSQ_SOURCE_LINE 00000188 "    my $start = [Time::HiRes::gettimeofday()];"
NSQ_SOURCE_LINE 00000189 "    $code->();"
NSQ_SOURCE_LINE 00000190 "    explain("
NSQ_SOURCE_LINE 00000191 "        sprintf \"$message: took %s seconds\" => Time::HiRes::tv_interval($start) );"
NSQ_SOURCE_LINE 00000192 "}"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "sub always_explain {"
NSQ_SOURCE_LINE 00000195 "    _explain(\\&Test::More::diag, @_);"
NSQ_SOURCE_LINE 00000196 "}"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "sub _explain {"
NSQ_SOURCE_LINE 00000199 "    my $diag = shift;"
NSQ_SOURCE_LINE 00000200 "    no warnings 'once';"
NSQ_SOURCE_LINE 00000201 "    $diag->("
NSQ_SOURCE_LINE 00000202 "        map {"
NSQ_SOURCE_LINE 00000203 "            ref $_"
NSQ_SOURCE_LINE 00000204 "              ? do {"
NSQ_SOURCE_LINE 00000205 "                require Data::Dumper;"
NSQ_SOURCE_LINE 00000206 "                local $Data::Dumper::Indent   = 1;"
NSQ_SOURCE_LINE 00000207 "                local $Data::Dumper::Sortkeys = 1;"
NSQ_SOURCE_LINE 00000208 "                local $Data::Dumper::Terse    = 1;"
NSQ_SOURCE_LINE 00000209 "                Data::Dumper::Dumper($_);"
NSQ_SOURCE_LINE 00000210 "              }"
NSQ_SOURCE_LINE 00000211 "              : $_"
NSQ_SOURCE_LINE 00000212 "          } @_"
NSQ_SOURCE_LINE 00000213 "    );"
NSQ_SOURCE_LINE 00000214 "}"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "sub show {"
NSQ_SOURCE_LINE 00000217 "    _show(\\&Test::More::note, @_);"
NSQ_SOURCE_LINE 00000218 "}"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "sub always_show {"
NSQ_SOURCE_LINE 00000221 "    _show(\\&Test::More::diag, @_);"
NSQ_SOURCE_LINE 00000222 "}"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "sub _show {"
NSQ_SOURCE_LINE 00000225 "    unless ( $DATA_DUMPER_NAMES_INSTALLED ) {"
NSQ_SOURCE_LINE 00000226 "        require Carp;"
NSQ_SOURCE_LINE 00000227 "\tCarp::carp(\"Data::Dumper::Names 0.03 not found.  Use explain() instead of show()\");"
NSQ_SOURCE_LINE 00000228 "        goto &_explain;"
NSQ_SOURCE_LINE 00000229 "    }"
NSQ_SOURCE_LINE 00000230 "    my $diag = shift;"
NSQ_SOURCE_LINE 00000231 "    no warnings 'once';"
NSQ_SOURCE_LINE 00000232 "    local $Data::Dumper::Indent         = 1;"
NSQ_SOURCE_LINE 00000233 "    local $Data::Dumper::Sortkeys       = 1;"
NSQ_SOURCE_LINE 00000234 "    local $Data::Dumper::Names::UpLevel = $Data::Dumper::Names::UpLevel + 2;"
NSQ_SOURCE_LINE 00000235 "    $diag->(Data::Dumper::Names::Dumper(@_));"
NSQ_SOURCE_LINE 00000236 "}"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "sub die_on_fail {"
NSQ_SOURCE_LINE 00000239 "    set_failure_handler( sub { throw_failure } );"
NSQ_SOURCE_LINE 00000240 "}"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "sub bail_on_fail {"
NSQ_SOURCE_LINE 00000243 "    set_failure_handler("
NSQ_SOURCE_LINE 00000244 "        sub { Test::More::BAIL_OUT(\"Test failed.  BAIL OUT!.\\n\") } );"
NSQ_SOURCE_LINE 00000245 "}"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "sub restore_fail {"
NSQ_SOURCE_LINE 00000248 "    no warnings 'redefine';"
NSQ_SOURCE_LINE 00000249 "    *Test::Builder::ok = $OK_FUNC;"
NSQ_SOURCE_LINE 00000250 "}"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "sub all_done {"
NSQ_SOURCE_LINE 00000253 "   my $builder = Test::Builder->new;"
NSQ_SOURCE_LINE 00000254 "   if ($builder->{TEST_MOST_deferred_plan}) {"
NSQ_SOURCE_LINE 00000255 "       $builder->{TEST_MOST_all_done} = 1;"
NSQ_SOURCE_LINE 00000256 "       $builder->expected_tests(@_ ? $_[0] : $builder->current_test);"
NSQ_SOURCE_LINE 00000257 "   }"
NSQ_SOURCE_LINE 00000258 "}"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "sub set_failure_handler {"
NSQ_SOURCE_LINE 00000262 "    my $action = shift;"
NSQ_SOURCE_LINE 00000263 "    no warnings 'redefine';"
NSQ_SOURCE_LINE 00000264 "    Test::Builder->new->{TEST_MOST_failure_action} = $action; # for DESTROY"
NSQ_SOURCE_LINE 00000265 "    *Test::Builder::ok = sub {"
NSQ_SOURCE_LINE 00000266 "        local $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000267 "        my $builder = $_[0];"
NSQ_SOURCE_LINE 00000268 "        if ( $builder->{TEST_MOST_test_failed} ) {"
NSQ_SOURCE_LINE 00000269 "            $builder->{TEST_MOST_test_failed} = 0;"
NSQ_SOURCE_LINE 00000270 "            $action->($builder);"
NSQ_SOURCE_LINE 00000271 "        }"
NSQ_SOURCE_LINE 00000272 "        $builder->{TEST_MOST_test_failed} = 0;"
NSQ_SOURCE_LINE 00000273 "        my $result = $OK_FUNC->(@_);"
NSQ_SOURCE_LINE 00000274 "        $builder->{TEST_MOST_test_failed} = !( $builder->summary )[-1];"
NSQ_SOURCE_LINE 00000275 "        return $result;"
NSQ_SOURCE_LINE 00000276 "    };"
NSQ_SOURCE_LINE 00000277 "}"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "{"
NSQ_SOURCE_LINE 00000280 "    no warnings 'redefine';"
NSQ_SOURCE_LINE 00000281 "    my $orig_destroy = Test::Builder->can('DESTROY');"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "    # we need this because if the failure is on the final test, we won't have"
NSQ_SOURCE_LINE 00000284 "    # a subsequent test triggering the behavior."
NSQ_SOURCE_LINE 00000285 "    *Test::Builder::DESTROY = sub {"
NSQ_SOURCE_LINE 00000286 "        my $builder = $_[0];"
NSQ_SOURCE_LINE 00000287 "        if ( $builder->{TEST_MOST_test_failed} ) {"
NSQ_SOURCE_LINE 00000288 "            ( $builder->{TEST_MOST_failure_action} || sub {} )->();"
NSQ_SOURCE_LINE 00000289 "        }"
NSQ_SOURCE_LINE 00000290 "        $orig_destroy->(@_) if $orig_destroy;"
NSQ_SOURCE_LINE 00000291 "    };"
NSQ_SOURCE_LINE 00000292 "}"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "sub _deferred_plan_handler {"
NSQ_SOURCE_LINE 00000295 "   my $builder = Test::Builder->new;"
NSQ_SOURCE_LINE 00000296 "   if ($builder->{TEST_MOST_deferred_plan} and !$builder->{TEST_MOST_all_done})"
NSQ_SOURCE_LINE 00000297 "   {"
NSQ_SOURCE_LINE 00000298 "       $builder->expected_tests($builder->current_test + 1);"
NSQ_SOURCE_LINE 00000299 "   }"
NSQ_SOURCE_LINE 00000300 "}"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "# This should work because the END block defined by Test::Builder should be"
NSQ_SOURCE_LINE 00000303 "# guaranteed to be run before t one, since we use'd Test::Builder way up top."
NSQ_SOURCE_LINE 00000304 "# The other two alternatives would be either to replace Test::Builder::_ending"
NSQ_SOURCE_LINE 00000305 "# similar to how we did Test::Builder::ok, or to call Test::Builder::no_ending"
NSQ_SOURCE_LINE 00000306 "# and basically rewrite _ending in our own image.  Neither is very palatable,"
NSQ_SOURCE_LINE 00000307 "# considering _ending's initial underscore."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "END {"
NSQ_SOURCE_LINE 00000310 "   _deferred_plan_handler();"
NSQ_SOURCE_LINE 00000311 "}"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "1;"
NSQ_SOURCE_LINE 00000314 "__END__"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=head1 NAME"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "Test::Most - Most commonly needed test functions and features."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "=head1 VERSION"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "Version 0.38"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "Instead of this:"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "    use strict;"
NSQ_SOURCE_LINE 00000329 "    use warnings;"
NSQ_SOURCE_LINE 00000330 "    use Test::Exception 0.88;"
NSQ_SOURCE_LINE 00000331 "    use Test::Differences 0.500;"
NSQ_SOURCE_LINE 00000332 "    use Test::Deep 0.106;"
NSQ_SOURCE_LINE 00000333 "    use Test::Warn 0.11;"
NSQ_SOURCE_LINE 00000334 "    use Test::More tests => 42;"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "You type this:"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "    use Test::Most tests => 42;"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "L<Test::Most> exists to reduce boilerplate and to make your testing life"
NSQ_SOURCE_LINE 00000343 "easier.  We provide \"one stop shopping\" for most commonly used testing"
NSQ_SOURCE_LINE 00000344 "modules.  In fact, we often require the latest versions so that you get bug"
NSQ_SOURCE_LINE 00000345 "fixes through L<Test::Most> and don't have to keep upgrading these modules"
NSQ_SOURCE_LINE 00000346 "separately."
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "This module provides you with the most commonly used testing functions, along"
NSQ_SOURCE_LINE 00000349 "with automatically turning on strict and warning and gives you a bit more"
NSQ_SOURCE_LINE 00000350 "fine-grained control over your test suite."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "    use Test::Most tests => 4, 'die';"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "    ok 1, 'Normal calls to ok() should succeed';"
NSQ_SOURCE_LINE 00000355 "    is 2, 2, '... as should all passing tests';"
NSQ_SOURCE_LINE 00000356 "    eq_or_diff [3], [4], '... but failing tests should die';"
NSQ_SOURCE_LINE 00000357 "    ok 4, '... will never get to here';"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "As you can see, the C<eq_or_diff> test will fail.  Because 'die' is in the"
NSQ_SOURCE_LINE 00000360 "import list, the test program will halt at that point."
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "If you do not want strict and warnings enabled, you must explicitly disable"
NSQ_SOURCE_LINE 00000363 "them.  Thus, you must be explicit about what you want and no longer need to"
NSQ_SOURCE_LINE 00000364 "worry about accidentally forgetting them."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "    use Test::Most tests => 4;"
NSQ_SOURCE_LINE 00000367 "    no strict;"
NSQ_SOURCE_LINE 00000368 "    no warnings;"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=head1 EXPORT"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "All functions from the following modules will automatically be exported into"
NSQ_SOURCE_LINE 00000373 "your namespace:"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=over 4"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "=item * L<Test::More>"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=item * L<Test::Exception>"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=item * L<Test::Differences>"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "=item * L<Test::Deep> "
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=item * L<Test::Warn>"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "=back"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "Functions which are I<optionally> exported from any of those modules must be"
NSQ_SOURCE_LINE 00000390 "referred to by their fully-qualified name:"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "  Test::Deep::render_stack( $var, $stack );"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "Several other functions are also automatically exported:"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "=head2 C<die_on_fail>"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 " die_on_fail;"
NSQ_SOURCE_LINE 00000401 " is_deeply $foo, bar, '... we throw an exception if this fails';"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "This function, if called, will cause the test program to throw a"
NSQ_SOURCE_LINE 00000404 "L<Test::Most::Exception>, effectively halting the test."
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "=head2 C<bail_on_fail>"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 " bail_on_fail;"
NSQ_SOURCE_LINE 00000409 " is_deeply $foo, bar, '... we bail out if this fails';"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "This function, if called, will cause the test suite to BAIL_OUT() if any"
NSQ_SOURCE_LINE 00000412 "tests fail after it."
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "=head2 C<restore_fail>"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 " die_on_fail;"
NSQ_SOURCE_LINE 00000417 " is_deeply $foo, bar, '... we throw an exception if this fails';"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 " restore_fail;"
NSQ_SOURCE_LINE 00000420 " cmp_bag(\\@got, \\@bag, '... we will not throw an exception if this fails';"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "This restores the original test failure behavior, so subsequent tests will no"
NSQ_SOURCE_LINE 00000423 "longer throw an exception or BAIL_OUT()."
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "=head2 C<set_failure_handler>"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "If you prefer other behavior to 'die_on_fail' or 'bail_on_fail', you can"
NSQ_SOURCE_LINE 00000428 "set your own failure handler:"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 " set_failure_handler( sub {"
NSQ_SOURCE_LINE 00000431 "     my $builder = shift;"
NSQ_SOURCE_LINE 00000432 "     if ( $builder && $builder->{Test_Results}[-1] =~ /critical/ ) {"
NSQ_SOURCE_LINE 00000433 "        send_admin_email(\"critical failure in tests\");"
NSQ_SOURCE_LINE 00000434 "     }"
NSQ_SOURCE_LINE 00000435 " } );"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "It receives the C<< Test::Builder >> instance as its only argument.  "
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "B<Important>:  Note that if the failing test is the very last test run, then"
NSQ_SOURCE_LINE 00000440 "the C<$builder> will likely be undefined.  This is an unfortunate side effect"
NSQ_SOURCE_LINE 00000441 "of how C<Test::Builder> has been designed."
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "=head2 C<explain>"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "Similar to C<note()>, the output will only be seen by the user by"
NSQ_SOURCE_LINE 00000446 "using the C<-v> switch with C<prove> or reading the raw TAP."
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "Unlike C<note()>, any reference in the argument list is automatically expanded"
NSQ_SOURCE_LINE 00000449 "using C<Data::Dumper>.  Thus, instead of this:"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 " my $self = Some::Object->new($id);"
NSQ_SOURCE_LINE 00000452 " use Data::Dumper;"
NSQ_SOURCE_LINE 00000453 " explain 'I was just created', Dumper($self);"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "You can now just do this:"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 " my $self = Some::Object->new($id);"
NSQ_SOURCE_LINE 00000458 " explain 'I was just created:  ', $self;"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "That output will look similar to:"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 " I was just created: bless( {"
NSQ_SOURCE_LINE 00000463 "   'id' => 2,"
NSQ_SOURCE_LINE 00000464 "   'stack' => []"
NSQ_SOURCE_LINE 00000465 " }, 'Some::Object' )"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "Note that the \"dumpered\" output has the C<Data::Dumper> variables"
NSQ_SOURCE_LINE 00000468 "C<$Indent>, C<Sortkeys> and C<Terse> all set to the value of C<1> (one).  This"
NSQ_SOURCE_LINE 00000469 "allows for a much cleaner diagnostic output and at the present time cannot be"
NSQ_SOURCE_LINE 00000470 "overridden."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "Note that Test::More's C<explain> acts differently.  This C<explain>"
NSQ_SOURCE_LINE 00000473 "is equivalent to C<note explain> in Test::More."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "=head2 C<show>"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "Experimental.  Just like C<explain>, but also tries to show you the lexical"
NSQ_SOURCE_LINE 00000478 "variable names:"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 " my $var   = 3;"
NSQ_SOURCE_LINE 00000481 " my @array = qw/ foo bar /;"
NSQ_SOURCE_LINE 00000482 " show $var, \\@array;"
NSQ_SOURCE_LINE 00000483 " __END__"
NSQ_SOURCE_LINE 00000484 " $var = 3;"
NSQ_SOURCE_LINE 00000485 " @array = ["
NSQ_SOURCE_LINE 00000486 "     'foo',"
NSQ_SOURCE_LINE 00000487 "     'bar'"
NSQ_SOURCE_LINE 00000488 " ];"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "It will show C<$VAR1>, C<$VAR2> ... C<$VAR_N> for every variable it cannot"
NSQ_SOURCE_LINE 00000491 "figure out the variable name to:"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 " my @array = qw/ foo bar /;"
NSQ_SOURCE_LINE 00000494 " show @array;"
NSQ_SOURCE_LINE 00000495 " __END__"
NSQ_SOURCE_LINE 00000496 " $VAR1 = 'foo';"
NSQ_SOURCE_LINE 00000497 " $VAR2 = 'bar';"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "Note that this relies on L<Data::Dumper::Names> version 0.03 or greater.  If"
NSQ_SOURCE_LINE 00000500 "this is not present, it will warn and call L<explain> instead.  Also, it can"
NSQ_SOURCE_LINE 00000501 "only show the names for lexical variables.  Globals such as C<%ENV> or C<%@>"
NSQ_SOURCE_LINE 00000502 "are not accessed via PadWalker and thus cannot be shown.  It would be nice to"
NSQ_SOURCE_LINE 00000503 "find a workaround for this."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=head2 C<always_explain> and C<always_show>"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "These are identical to C<explain> and C<show>, but like L<Test::More>'s"
NSQ_SOURCE_LINE 00000508 "C<diag> function, these will always emit output, regardless of whether or not"
NSQ_SOURCE_LINE 00000509 "you're in verbose mode."
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=head2 C<all_done>"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "B<DEPRECATED>.  Use the new C<done_testing()> (added in"
NSQ_SOURCE_LINE 00000514 "L<Test::More|Test::More> since 0.87_01).  Instead. We're leaving this in here"
NSQ_SOURCE_LINE 00000515 "for a long deprecation cycle.  After a while, we might even start warning."
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "If the plan is specified as C<defer_plan>, you may call C<&all_done> at the"
NSQ_SOURCE_LINE 00000518 "end of the test with an optional test number.  This lets you set the plan"
NSQ_SOURCE_LINE 00000519 "without knowing the plan before you run the tests."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "If you call it without a test number, the tests will still fail if you don't"
NSQ_SOURCE_LINE 00000522 "get to the end of the test.  This is useful if you don't want to specify a"
NSQ_SOURCE_LINE 00000523 "plan but the tests exit unexpectedly.  For example, the following would"
NSQ_SOURCE_LINE 00000524 "I<pass> with C<no_plan> but fails with C<all_done>."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 " use Test::More 'defer_plan';"
NSQ_SOURCE_LINE 00000527 " ok 1;"
NSQ_SOURCE_LINE 00000528 " exit;"
NSQ_SOURCE_LINE 00000529 " ok 2;"
NSQ_SOURCE_LINE 00000530 " all_done;"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "See L<Deferred plans> for more information."
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=head1 EXPORT ON DEMAND"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "The following will be exported only if requested:"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "=head2 C<timeit>"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "Prototype: C<timeit(&;$)>"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "This function will warn if C<Time::HiRes> is not installed. The test will"
NSQ_SOURCE_LINE 00000543 "still be run, but no timing information will be displayed."
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 " use Test::Most 'timeit';"
NSQ_SOURCE_LINE 00000546 " timeit { is expensive_function(), $some_value, $message }"
NSQ_SOURCE_LINE 00000547 "    \"expensive_function()\";"
NSQ_SOURCE_LINE 00000548 " timeit { is expensive_function(), $some_value, $message };"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "C<timeit> accepts a code reference and an optional message. After the test is"
NSQ_SOURCE_LINE 00000551 "run, will C<explain> the time of the function using C<Time::HiRes>. If a"
NSQ_SOURCE_LINE 00000552 "message is supplied, it will be formatted as:"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "  sprintf \"$message: took %s seconds\" => $time;"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "Otherwise, it will be formatted as:"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "  sprintf \"$filename line $line: took %s seconds\" => $time;"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "=head1 DIE OR BAIL ON FAIL"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "Sometimes you want your test suite to throw an exception or BAIL_OUT() if a"
NSQ_SOURCE_LINE 00000563 "test fails.  In order to provide maximum flexibility, there are three ways to"
NSQ_SOURCE_LINE 00000564 "accomplish each of these."
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "=head2 Import list"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 " use Test::Most 'die', tests => 7;"
NSQ_SOURCE_LINE 00000569 " use Test::Most qw< no_plan bail >;"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "If C<die> or C<bail> is anywhere in the import list, the test program/suite"
NSQ_SOURCE_LINE 00000572 "will throw a C<Test::Most::Exception> or C<BAIL_OUT()> as appropriate the"
NSQ_SOURCE_LINE 00000573 "first time a test fails.  Calling C<restore_fail> anywhere in the test program"
NSQ_SOURCE_LINE 00000574 "will restore the original behavior (not throwing an exception or bailing out)."
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "=head2 Functions"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 " use Test::Most 'no_plan';"
NSQ_SOURCE_LINE 00000579 " ok $bar, 'The test suite will continue if this passes';"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 " die_on_fail;"
NSQ_SOURCE_LINE 00000582 " is_deeply $foo, bar, '... we throw an exception if this fails';"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 " restore_fail;"
NSQ_SOURCE_LINE 00000585 " ok $baz, 'The test suite will continue if this passes';"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "The C<die_on_fail> and C<bail_on_fail> functions will automatically set the"
NSQ_SOURCE_LINE 00000588 "desired behavior at runtime."
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "=head2 Environment variables"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 " DIE_ON_FAIL=1 prove t/"
NSQ_SOURCE_LINE 00000593 " BAIL_ON_FAIL=1 prove t/"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "If the C<DIE_ON_FAIL> or C<BAIL_ON_FAIL> environment variables are true, any"
NSQ_SOURCE_LINE 00000596 "tests which use C<Test::Most> will throw an exception or call BAIL_OUT on test"
NSQ_SOURCE_LINE 00000597 "failure."
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "=head1 MISCELLANEOUS"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "=head2 Moose"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "It used to be that this module would produce a warning when used with Moose:"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "    Prototype mismatch: sub main::blessed ($) vs none"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "This was because L<Test::Deep> exported a C<blessed()> function by default,"
NSQ_SOURCE_LINE 00000608 "but its prototype did not match the L<Moose> version's prototype. We now"
NSQ_SOURCE_LINE 00000609 "exclude the L<Test::Deep> version by default. If you need it, you can call the"
NSQ_SOURCE_LINE 00000610 "fully-qualified version or request it on the command line:"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "    use Test::Most 'blessed';"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "Note that as of version C<0.34>, C<reftype> is also excluded from"
NSQ_SOURCE_LINE 00000615 "C<Test::Deep>'s import list. This was causing issues with people trying to use"
NSQ_SOURCE_LINE 00000616 "C<Scalar::Util>'s C<reftype> function."
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "=head2 Excluding Test Modules"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "Sometimes you want a exclude a particular test module.  For example,"
NSQ_SOURCE_LINE 00000621 "L<Test::Deep>, when used with L<Moose>, produces the following warning:"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "    Prototype mismatch: sub main::blessed ($) vs none"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "You can exclude this with by adding the module to the import list with a '-'"
NSQ_SOURCE_LINE 00000626 "symbol in front:"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "    use Test::Most tests => 42, '-Test::Deep';"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "See"
NSQ_SOURCE_LINE 00000631 "L<https://rt.cpan.org/Ticket/Display.html?id=54362&results=e73ff63c5bf9ba0f796efdba5773cf3f>"
NSQ_SOURCE_LINE 00000632 "for more information."
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "=head2 Excluding Test Symbols"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "Sometimes you don't want to exclude an entire test module, but just a"
NSQ_SOURCE_LINE 00000637 "particular symbol that is causing issues You can exclude the symbol(s) in the"
NSQ_SOURCE_LINE 00000638 "standard way, by specifying the symbol in the import list with a '!' in front:"
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "    use Test::Most tests => 42, '!throws_ok';"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "=head2 Deferred plans"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "B<DEPRECATED> and will be removed in some future release of this module."
NSQ_SOURCE_LINE 00000645 "Using C<defer_plan> will C<carp()>. Use C<done_testing()> from L<Test::More>"
NSQ_SOURCE_LINE 00000646 "instead."
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 " use Test::Most qw<defer_plan>;"
NSQ_SOURCE_LINE 00000649 " use My::Tests;"
NSQ_SOURCE_LINE 00000650 " my $test_count = My::Tests->run;"
NSQ_SOURCE_LINE 00000651 " all_done($test_count);"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "Sometimes it's difficult to know the plan up front, but you can calculate the"
NSQ_SOURCE_LINE 00000654 "plan as your tests run.  As a result, you want to defer the plan until the end"
NSQ_SOURCE_LINE 00000655 "of the test.  Typically, the best you can do is this:"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 " use Test::More 'no_plan';"
NSQ_SOURCE_LINE 00000658 " use My::Tests;"
NSQ_SOURCE_LINE 00000659 " My::Tests->run;"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "But when you do that, C<Test::Builder> merely asserts that the number of tests"
NSQ_SOURCE_LINE 00000662 "you I<ran> is the number of tests.  Until now, there was no way of asserting"
NSQ_SOURCE_LINE 00000663 "that the number of tests you I<expected> is the number of tests unless you do"
NSQ_SOURCE_LINE 00000664 "so before any tests have run.  This fixes that problem."
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "=head2 One-stop shopping"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "We generally require the latest stable versions of various test modules.  Why?"
NSQ_SOURCE_LINE 00000669 "Because they have bug fixes and new features.  You don't want to have to keep"
NSQ_SOURCE_LINE 00000670 "remembering them, so periodically we'll release new versions of L<Test::Most>"
NSQ_SOURCE_LINE 00000671 "just for bug fixes."
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "=head2 C<use ok>"
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "We do not bundle L<Test::use::ok>, though it's been requested.  That's because"
NSQ_SOURCE_LINE 00000676 "C<use_ok> is broken, but L<Test::use::ok> is also subtly broken (and a touch"
NSQ_SOURCE_LINE 00000677 "harder to fix).  See L<http://use.perl.org/~Ovid/journal/39859> for more"
NSQ_SOURCE_LINE 00000678 "information."
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "If you want to test if you can use a module, just use it.  If it fails, the"
NSQ_SOURCE_LINE 00000681 "test will still fail and that's the desired result."
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "=head1 RATIONALE"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "People want more control over their test suites.  Sometimes when you see"
NSQ_SOURCE_LINE 00000686 "hundreds of tests failing and whizzing by, you want the test suite to simply"
NSQ_SOURCE_LINE 00000687 "halt on the first failure.  This module gives you that control."
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "As for the reasons for the four test modules chosen, I ran code over a local"
NSQ_SOURCE_LINE 00000690 "copy of the CPAN to find the most commonly used testing modules.  Here's the"
NSQ_SOURCE_LINE 00000691 "top twenty as of January 2010 (the numbers are different because we're now"
NSQ_SOURCE_LINE 00000692 "counting distributions which use a given module rather than simply the number"
NSQ_SOURCE_LINE 00000693 "of times a module is used)."
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "    1   Test::More                          14111"
NSQ_SOURCE_LINE 00000696 "    2   Test                                 1736"
NSQ_SOURCE_LINE 00000697 "    3   Test::Exception                       744"
NSQ_SOURCE_LINE 00000698 "    4   Test::Simple                          331"
NSQ_SOURCE_LINE 00000699 "    5   Test::Pod                             328"
NSQ_SOURCE_LINE 00000700 "    6   Test::Pod::Coverage                   274"
NSQ_SOURCE_LINE 00000701 "    7   Test::Perl::Critic                    248"
NSQ_SOURCE_LINE 00000702 "    8   Test::Base                            228"
NSQ_SOURCE_LINE 00000703 "    9   Test::NoWarnings                      155"
NSQ_SOURCE_LINE 00000704 "    10  Test::Distribution                    142"
NSQ_SOURCE_LINE 00000705 "    11  Test::Kwalitee                        138"
NSQ_SOURCE_LINE 00000706 "    12  Test::Deep                            128"
NSQ_SOURCE_LINE 00000707 "    13  Test::Warn                            127"
NSQ_SOURCE_LINE 00000708 "    14  Test::Differences                     102"
NSQ_SOURCE_LINE 00000709 "    15  Test::Spelling                        101"
NSQ_SOURCE_LINE 00000710 "    16  Test::MockObject                       87"
NSQ_SOURCE_LINE 00000711 "    17  Test::Builder::Tester                  84"
NSQ_SOURCE_LINE 00000712 "    18  Test::WWW::Mechanize::Catalyst         79"
NSQ_SOURCE_LINE 00000713 "    19  Test::UseAllModules                    63"
NSQ_SOURCE_LINE 00000714 "    20  Test::YAML::Meta                       61"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "L<Test::Most> is number 24 on that list, if you're curious.  See"
NSQ_SOURCE_LINE 00000717 "L<http://blogs.perl.org/users/ovid/2010/01/most-popular-testing-modules---january-2010.html>."
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "The modules chosen seemed the best fit for what C<Test::Most> is trying to do."
NSQ_SOURCE_LINE 00000720 "As of 0.02, we've added L<Test::Warn> by request.  It's not in the top ten, but"
NSQ_SOURCE_LINE 00000721 "it's a great and useful module."
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "=cut"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "Curtis Poe, C<< <ovid at cpan.org> >>"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "=head1 BUGS"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "Please report any bugs or feature requests to C<bug-test-extended at"
NSQ_SOURCE_LINE 00000733 "rt.cpan.org>, or through the web interface at"
NSQ_SOURCE_LINE 00000734 "L<http://rt.cpan.org/NoAuth/ReportBug.html?Queue=Test-Most>.  I will be"
NSQ_SOURCE_LINE 00000735 "notified, and then you'll automatically be notified of progress on your bug as"
NSQ_SOURCE_LINE 00000736 "I make changes."
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "You can find documentation for this module with the perldoc command."
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "    perldoc Test::Most"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "You can also look for information at:"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "=over 4"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "=item * RT: CPAN's request tracker"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "L<http://rt.cpan.org/NoAuth/Bugs.html?Dist=Test-Most>"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "=item * AnnoCPAN: Annotated CPAN documentation"
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "L<http://annocpan.org/dist/Test-Most>"
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "=item * CPAN Ratings"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "L<http://cpanratings.perl.org/d/Test-Most>"
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "=item * Search CPAN"
NSQ_SOURCE_LINE 00000761 ""
