NSQ_SOURCE_LINE 00000108 "=head1 NAME"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "LWP::UserAgent::Plugin::Retry - Retry failed requests"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=head1 VERSION"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "This document describes version 0.005 of LWP::UserAgent::Plugin::Retry (from Perl distribution LWP-UserAgent-Plugin-Retry), released on 2024-07-17."
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 " use LWP::UserAgent::Plugin 'Retry' => {"
NSQ_SOURCE_LINE 00000119 "     max_attempts => 3, # optional, default 3"
NSQ_SOURCE_LINE 00000120 "     delay        => 2, # optional, default 2"
NSQ_SOURCE_LINE 00000121 "     retry_if     => qr/^[45]/, # optional, default is only 5xx errors are retried"
NSQ_SOURCE_LINE 00000122 " };"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 " my $res  = LWP::UserAgent::Plugin->new->get(\"http://www.example.com/\");"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "This plugin retries failed response. By default only retries 5xx failures, as"
NSQ_SOURCE_LINE 00000129 "4xx are considered to be client's fault (but you can configure it with"
NSQ_SOURCE_LINE 00000130 "L</retry_if>)."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=for Pod::Coverage .+"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=head1 CONFIGURATION"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head2 max_attempts"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "Int. Default 4."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=head2 delay"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "Float."
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=head2 LWP_USERAGENT_PLUGIN_RETRY_MAX_ATTEMPTS"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "Int."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=head2 LWP_USERAGENT_PLUGIN_RETRY_DELAY"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "Int."
NSQ_SOURCE_LINE 00000153 ""
