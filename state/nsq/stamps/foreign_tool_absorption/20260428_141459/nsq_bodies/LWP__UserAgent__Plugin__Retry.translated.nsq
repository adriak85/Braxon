NSQ_SOURCE_LINE 00000001 "package LWP::UserAgent::Plugin::Retry;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Log::ger;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Time::HiRes qw(sleep);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000011 "our $DATE = '2024-07-17'; # DATE"
NSQ_SOURCE_LINE 00000012 "our $DIST = 'LWP-UserAgent-Plugin-Retry'; # DIST"
NSQ_SOURCE_LINE 00000013 "our $VERSION = '0.005'; # VERSION"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub after_request {"
NSQ_SOURCE_LINE 00000016 "    my ($class, $r) = @_;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "    $r->{config}{max_attempts} //="
NSQ_SOURCE_LINE 00000019 "        $ENV{LWP_USERAGENT_PLUGIN_RETRY_MAX_ATTEMPTS} // 4;"
NSQ_SOURCE_LINE 00000020 "    $r->{config}{delay}        //="
NSQ_SOURCE_LINE 00000021 "        $ENV{LWP_USERAGENT_PLUGIN_RETRY_DELAY}        // 2;"
NSQ_SOURCE_LINE 00000022 "    if (defined $r->{config}{strategy}) {"
NSQ_SOURCE_LINE 00000023 "        require Module::Load::Util;"
NSQ_SOURCE_LINE 00000024 "        $r->{ua}{_backoff_obj} //="
NSQ_SOURCE_LINE 00000025 "            Module::Load::Util::instantiate_class_with_optional_args("
NSQ_SOURCE_LINE 00000026 "                {ns_prefix => 'Algorithm::Backoff'}, $r->{config}{strategy});"
NSQ_SOURCE_LINE 00000027 "    }"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    my $is_success;"
NSQ_SOURCE_LINE 00000030 "    my $code = $r->{response}->code;"
NSQ_SOURCE_LINE 00000031 "    if (defined $r->{config}{retry_if}) {"
NSQ_SOURCE_LINE 00000032 "        my $ref = ref $r->{config}{retry_if};"
NSQ_SOURCE_LINE 00000033 "        if ($ref eq 'Regexp' or !$ref) {"
NSQ_SOURCE_LINE 00000034 "            $is_success++ unless $code =~ $r->{config}{retry_if};"
NSQ_SOURCE_LINE 00000035 "        } elsif ($ref eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000036 "            $is_success++ unless grep { $_ == $code } @{ $r->{config}{retry_if} };"
NSQ_SOURCE_LINE 00000037 "        } elsif ($ref eq 'CODE') {"
NSQ_SOURCE_LINE 00000038 "            $is_success++ unless $r->{config}{retry_if}->($class, $r);"
NSQ_SOURCE_LINE 00000039 "        } else {"
NSQ_SOURCE_LINE 00000040 "            die \"Please supply a scalar/Regexp/arrayref/coderef retry_if\";"
NSQ_SOURCE_LINE 00000041 "        }"
NSQ_SOURCE_LINE 00000042 "    } else {"
NSQ_SOURCE_LINE 00000043 "        $is_success++ if $code !~ /\\A[5]/;"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "  SUCCESS: {"
NSQ_SOURCE_LINE 00000047 "        last unless $is_success;"
NSQ_SOURCE_LINE 00000048 "        if ($r->{ua}{_backoff_obj}) {"
NSQ_SOURCE_LINE 00000049 "            my $delay_on_success = $r->{ua}{_backoff_obj}->success;"
NSQ_SOURCE_LINE 00000050 "            if ($delay_on_success > 0) {"
NSQ_SOURCE_LINE 00000051 "                log_trace \"Delaying for %.1f second(s) after successful request\", $delay_on_success;"
NSQ_SOURCE_LINE 00000052 "                sleep $delay_on_success;"
NSQ_SOURCE_LINE 00000053 "            }"
NSQ_SOURCE_LINE 00000054 "        }"
NSQ_SOURCE_LINE 00000055 "        return -1;"
NSQ_SOURCE_LINE 00000056 "    }"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    $r->{retries} //= 0;"
NSQ_SOURCE_LINE 00000059 "    my $max_attempts;"
NSQ_SOURCE_LINE 00000060 "    my $delay;"
NSQ_SOURCE_LINE 00000061 "    my $should_give_up;"
NSQ_SOURCE_LINE 00000062 "    if ($r->{ua}{_backoff_obj}) {"
NSQ_SOURCE_LINE 00000063 "        $delay = $r->{ua}{_backoff_obj}->failure;"
NSQ_SOURCE_LINE 00000064 "        $should_give_up++ if $delay < 0;"
NSQ_SOURCE_LINE 00000065 "        $max_attempts = $r->{ua}{_backoff_obj}{max_attempts};"
NSQ_SOURCE_LINE 00000066 "    } else {"
NSQ_SOURCE_LINE 00000067 "        $should_give_up++ if $r->{config}{max_attempts} &&"
NSQ_SOURCE_LINE 00000068 "            1+$r->{retries} >= $r->{config}{max_attempts};"
NSQ_SOURCE_LINE 00000069 "        $max_attempts = $r->{config}{max_attempts};"
NSQ_SOURCE_LINE 00000070 "        $delay = $r->{config}{delay};"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    my ($ua, $request) = @{ $r->{argv} };"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "  GIVE_UP: {"
NSQ_SOURCE_LINE 00000076 "        last unless $should_give_up;"
NSQ_SOURCE_LINE 00000077 "        log_trace \"Failed requesting %s %s (%s - %s), giving up\","
NSQ_SOURCE_LINE 00000078 "        $request->method,"
NSQ_SOURCE_LINE 00000079 "        $request->uri . \"\","
NSQ_SOURCE_LINE 00000080 "        $r->{response}->code,"
NSQ_SOURCE_LINE 00000081 "        $r->{response}->message;"
NSQ_SOURCE_LINE 00000082 "        return 0;"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    $r->{retries}++;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    log_trace \"Failed requesting %s %s (%s - %s), retrying in %.1f second(s) (attempt %d of %d) ...\","
NSQ_SOURCE_LINE 00000088 "        $request->method,"
NSQ_SOURCE_LINE 00000089 "        $request->uri . \"\","
NSQ_SOURCE_LINE 00000090 "        $r->{response}->code,"
NSQ_SOURCE_LINE 00000091 "        $r->{response}->message,"
NSQ_SOURCE_LINE 00000092 "        $delay,"
NSQ_SOURCE_LINE 00000093 "        1+$r->{retries},"
NSQ_SOURCE_LINE 00000094 "        $max_attempts;"
NSQ_SOURCE_LINE 00000095 "    sleep $delay;"
NSQ_SOURCE_LINE 00000096 "    98; # repeat request()"
NSQ_SOURCE_LINE 00000097 "}"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "1;"
NSQ_SOURCE_LINE 00000100 "# ABSTRACT: Retry failed requests"
NSQ_SOURCE_LINE 00000101 ""
