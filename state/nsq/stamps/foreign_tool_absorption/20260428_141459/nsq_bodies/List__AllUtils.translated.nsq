BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package List::AllUtils;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.19';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use List::Util 1.56      ();"
NSQ_SOURCE_LINE 00000009 "use List::SomeUtils 0.58 ();"
NSQ_SOURCE_LINE 00000010 "use List::UtilsBy 0.11   ();"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "BEGIN {"
NSQ_SOURCE_LINE 00000013 "    my %skip = ("
NSQ_SOURCE_LINE 00000014 "        'List::Util' => {"
NSQ_SOURCE_LINE 00000015 "            mesh => 1,"
NSQ_SOURCE_LINE 00000016 "            zip  => 1,"
NSQ_SOURCE_LINE 00000017 "        },"
NSQ_SOURCE_LINE 00000018 "    );"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    my %imported;"
NSQ_SOURCE_LINE 00000021 "    for my $module (qw( List::Util List::SomeUtils List::UtilsBy )) {"
NSQ_SOURCE_LINE 00000022 "        my @ok = do {"
NSQ_SOURCE_LINE 00000023 "            ## no critic (TestingAndDebugging::ProhibitNoStrict)"
NSQ_SOURCE_LINE 00000024 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000025 "            grep { !$skip{$module}{$_} } @{ $module . '::EXPORT_OK' };"
NSQ_SOURCE_LINE 00000026 "        };"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "        $module->import( grep { !$imported{$_} } @ok );"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "        @imported{@ok} = ($module) x @ok;"
NSQ_SOURCE_LINE 00000031 "    }"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "our @EXPORT_OK = List::Util::uniqstr("
NSQ_SOURCE_LINE 00000037 "    @List::Util::EXPORT_OK,"
NSQ_SOURCE_LINE 00000038 "    @List::SomeUtils::EXPORT_OK,"
NSQ_SOURCE_LINE 00000039 "    @List::UtilsBy::EXPORT_OK,"
NSQ_SOURCE_LINE 00000040 ");"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "our %EXPORT_TAGS = ( all => \\@EXPORT_OK );"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "1;"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "# ABSTRACT: Combines List::Util, List::SomeUtils and List::UtilsBy in one bite-sized package"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "__END__"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "=pod"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "=head1 NAME"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "List::AllUtils - Combines List::Util, List::SomeUtils and List::UtilsBy in one bite-sized package"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "=head1 VERSION"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "version 0.19"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    use List::AllUtils qw( first any );"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    # _Everything_ from List::Util, List::SomeUtils, and List::UtilsBy"
NSQ_SOURCE_LINE 00000067 "    use List::AllUtils qw( :all );"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    my @numbers = ( 1, 2, 3, 5, 7 );"
NSQ_SOURCE_LINE 00000070 "    # or don't import anything"
NSQ_SOURCE_LINE 00000071 "    return List::AllUtils::first { $_ > 5 } @numbers;"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "Are you sick of trying to remember whether a particular helper is defined in"
NSQ_SOURCE_LINE 00000076 "L<List::Util>, L<List::SomeUtils> or L<List::UtilsBy>? I sure am. Now you"
NSQ_SOURCE_LINE 00000077 "don't have to remember. This module will export all of the functions that"
NSQ_SOURCE_LINE 00000078 "either of those three modules defines."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "Note that all function documentation has been shamelessly copied from"
NSQ_SOURCE_LINE 00000081 "L<List::Util>, L<List::SomeUtils> and L<List::UtilsBy>."
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=head2 Which One Wins?"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "Recently, L<List::Util> has started including some of the subs that used to"
NSQ_SOURCE_LINE 00000086 "only be in L<List::SomeUtils>. Similarly, L<List::SomeUtils> has some small"
NSQ_SOURCE_LINE 00000087 "overlap with L<List::UtilsBy>."
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "C<List::AllUtils> use to always favors the subroutine provided by"
NSQ_SOURCE_LINE 00000090 "L<List::Util>, L<List::SomeUtils> or L<List::UtilsBy> in that order. However,"
NSQ_SOURCE_LINE 00000091 "as of L<List::Util> 1.56, it included some functions, C<mesh> and C<zip> with"
NSQ_SOURCE_LINE 00000092 "the same name as L<List::SomeUtils> functions, but different behavior."
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "So going forward, we will always prefer backwards compatibility. This means"
NSQ_SOURCE_LINE 00000095 "that C<mesh> and C<zip> will always come from L<List::SomeUtils>. If other"
NSQ_SOURCE_LINE 00000096 "incompatible functions are added to L<List::Util>, those will also be skipped"
NSQ_SOURCE_LINE 00000097 "in favor of the L<List::SomeUtils> version."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "The docs below come from L<List::Util> 1.56, L<List::SomeUtils> 0.58, and"
NSQ_SOURCE_LINE 00000100 "L<List::UtilsBy> 0.11."
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 WHAT IS EXPORTED?"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "All this module does is load L<List::Util>, L<List::SomeUtils>, and"
NSQ_SOURCE_LINE 00000105 "L<List::UtilsBy>, and then re-export everything that they provide. That means"
NSQ_SOURCE_LINE 00000106 "that regardless of the documentation below, you will get any subroutine that"
NSQ_SOURCE_LINE 00000107 "your installed version provides."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=head1 LIST-REDUCTION FUNCTIONS"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "The following set of functions all apply a given block of code to a list of"
NSQ_SOURCE_LINE 00000112 "values."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head2 reduce"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    $result = reduce { BLOCK } @list"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "Reduces C<@list> by calling C<BLOCK> in a scalar context multiple times,"
NSQ_SOURCE_LINE 00000119 "setting C<$a> and C<$b> each time. The first call will be with C<$a> and C<$b>"
NSQ_SOURCE_LINE 00000120 "set to the first two elements of the list, subsequent calls will be done by"
NSQ_SOURCE_LINE 00000121 "setting C<$a> to the result of the previous call and C<$b> to the next element"
NSQ_SOURCE_LINE 00000122 "in the list."
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "Returns the result of the last call to the C<BLOCK>. If C<@list> is empty then"
NSQ_SOURCE_LINE 00000125 "C<undef> is returned. If C<@list> only contains one element then that element"
NSQ_SOURCE_LINE 00000126 "is returned and C<BLOCK> is not executed."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "The following examples all demonstrate how C<reduce> could be used to implement"
NSQ_SOURCE_LINE 00000129 "the other list-reduction functions in this module. (They are not in fact"
NSQ_SOURCE_LINE 00000130 "implemented like this, but instead in a more efficient manner in individual C"
NSQ_SOURCE_LINE 00000131 "functions)."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    $foo = reduce { defined($a)            ? $a :"
NSQ_SOURCE_LINE 00000134 "                    $code->(local $_ = $b) ? $b :"
NSQ_SOURCE_LINE 00000135 "                                             undef } undef, @list # first"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    $foo = reduce { $a > $b ? $a : $b } 1..10       # max"
NSQ_SOURCE_LINE 00000138 "    $foo = reduce { $a gt $b ? $a : $b } 'A'..'Z'   # maxstr"
NSQ_SOURCE_LINE 00000139 "    $foo = reduce { $a < $b ? $a : $b } 1..10       # min"
NSQ_SOURCE_LINE 00000140 "    $foo = reduce { $a lt $b ? $a : $b } 'aa'..'zz' # minstr"
NSQ_SOURCE_LINE 00000141 "    $foo = reduce { $a + $b } 1 .. 10               # sum"
NSQ_SOURCE_LINE 00000142 "    $foo = reduce { $a . $b } @bar                  # concat"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    $foo = reduce { $a || $code->(local $_ = $b) } 0, @bar   # any"
NSQ_SOURCE_LINE 00000145 "    $foo = reduce { $a && $code->(local $_ = $b) } 1, @bar   # all"
NSQ_SOURCE_LINE 00000146 "    $foo = reduce { $a && !$code->(local $_ = $b) } 1, @bar  # none"
NSQ_SOURCE_LINE 00000147 "    $foo = reduce { $a || !$code->(local $_ = $b) } 0, @bar  # notall"
NSQ_SOURCE_LINE 00000148 "       # Note that these implementations do not fully short-circuit"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "If your algorithm requires that C<reduce> produce an identity value, then make"
NSQ_SOURCE_LINE 00000151 "sure that you always pass that identity value as the first argument to prevent"
NSQ_SOURCE_LINE 00000152 "C<undef> being returned"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "  $foo = reduce { $a + $b } 0, @values;             # sum with 0 identity value"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "The above example code blocks also suggest how to use C<reduce> to build a"
NSQ_SOURCE_LINE 00000157 "more efficient combined version of one of these basic functions and a C<map>"
NSQ_SOURCE_LINE 00000158 "block. For example, to find the total length of all the strings in a list,"
NSQ_SOURCE_LINE 00000159 "we could use"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    $total = sum map { length } @strings;"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "However, this produces a list of temporary integer values as long as the"
NSQ_SOURCE_LINE 00000164 "original list of strings, only to reduce it down to a single value again. We"
NSQ_SOURCE_LINE 00000165 "can compute the same result more efficiently by using C<reduce> with a code"
NSQ_SOURCE_LINE 00000166 "block that accumulates lengths by writing this instead as:"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    $total = reduce { $a + length $b } 0, @strings"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "The other scalar-returning list reduction functions are all specialisations of"
NSQ_SOURCE_LINE 00000171 "this generic idea."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=head2 reductions"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    @results = reductions { BLOCK } @list"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "I<Since version 1.54.>"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "Similar to C<reduce> except that it also returns the intermediate values along"
NSQ_SOURCE_LINE 00000180 "with the final result. As before, C<$a> is set to the first element of the"
NSQ_SOURCE_LINE 00000181 "given list, and the C<BLOCK> is then called once for remaining item in the"
NSQ_SOURCE_LINE 00000182 "list set into C<$b>, with the result being captured for return as well as"
NSQ_SOURCE_LINE 00000183 "becoming the new value for C<$a>."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "The returned list will begin with the initial value for C<$a>, followed by"
NSQ_SOURCE_LINE 00000186 "each return value from the block in order. The final value of the result will"
NSQ_SOURCE_LINE 00000187 "be identical to what the C<reduce> function would have returned given the same"
NSQ_SOURCE_LINE 00000188 "block and list."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    reduce     { \"$a-$b\" }  \"a\"..\"d\"    # \"a-b-c-d\""
NSQ_SOURCE_LINE 00000191 "    reductions { \"$a-$b\" }  \"a\"..\"d\"    # \"a\", \"a-b\", \"a-b-c\", \"a-b-c-d\""
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=head2 any"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    my $bool = any { BLOCK } @list;"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "I<Since version 1.33.>"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "Similar to C<grep> in that it evaluates C<BLOCK> setting C<$_> to each element"
NSQ_SOURCE_LINE 00000200 "of C<@list> in turn. C<any> returns true if any element makes the C<BLOCK>"
NSQ_SOURCE_LINE 00000201 "return a true value. If C<BLOCK> never returns true or C<@list> was empty then"
NSQ_SOURCE_LINE 00000202 "it returns false."
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "Many cases of using C<grep> in a conditional can be written using C<any>"
NSQ_SOURCE_LINE 00000205 "instead, as it can short-circuit after the first true result."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "    if( any { length > 10 } @strings ) {"
NSQ_SOURCE_LINE 00000208 "        # at least one string has more than 10 characters"
NSQ_SOURCE_LINE 00000209 "    }"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "Note: Due to XS issues the block passed may be able to access the outer @_"
NSQ_SOURCE_LINE 00000212 "directly. This is not intentional and will break under debugger."
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=head2 all"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    my $bool = all { BLOCK } @list;"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "I<Since version 1.33.>"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "Similar to L</any>, except that it requires all elements of the C<@list> to"
NSQ_SOURCE_LINE 00000221 "make the C<BLOCK> return true. If any element returns false, then it returns"
NSQ_SOURCE_LINE 00000222 "false. If the C<BLOCK> never returns false or the C<@list> was empty then it"
NSQ_SOURCE_LINE 00000223 "returns true."
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "Note: Due to XS issues the block passed may be able to access the outer @_"
NSQ_SOURCE_LINE 00000226 "directly. This is not intentional and will break under debugger."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=head2 none"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=head2 notall"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    my $bool = none { BLOCK } @list;"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "    my $bool = notall { BLOCK } @list;"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "I<Since version 1.33.>"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "Similar to L</any> and L</all>, but with the return sense inverted. C<none>"
NSQ_SOURCE_LINE 00000239 "returns true only if no value in the C<@list> causes the C<BLOCK> to return"
NSQ_SOURCE_LINE 00000240 "true, and C<notall> returns true only if not all of the values do."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "Note: Due to XS issues the block passed may be able to access the outer @_"
NSQ_SOURCE_LINE 00000243 "directly. This is not intentional and will break under debugger."
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=head2 first"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    my $val = first { BLOCK } @list;"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "Similar to C<grep> in that it evaluates C<BLOCK> setting C<$_> to each element"
NSQ_SOURCE_LINE 00000250 "of C<@list> in turn. C<first> returns the first element where the result from"
NSQ_SOURCE_LINE 00000251 "C<BLOCK> is a true value. If C<BLOCK> never returns true or C<@list> was empty"
NSQ_SOURCE_LINE 00000252 "then C<undef> is returned."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "    $foo = first { defined($_) } @list    # first defined value in @list"
NSQ_SOURCE_LINE 00000255 "    $foo = first { $_ > $value } @list    # first value in @list which"
NSQ_SOURCE_LINE 00000256 "                                          # is greater than $value"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=head2 max"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "    my $num = max @list;"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "Returns the entry in the list with the highest numerical value. If the list is"
NSQ_SOURCE_LINE 00000263 "empty then C<undef> is returned."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "    $foo = max 1..10                # 10"
NSQ_SOURCE_LINE 00000266 "    $foo = max 3,9,12               # 12"
NSQ_SOURCE_LINE 00000267 "    $foo = max @bar, @baz           # whatever"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=head2 maxstr"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "    my $str = maxstr @list;"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "Similar to L</max>, but treats all the entries in the list as strings and"
NSQ_SOURCE_LINE 00000274 "returns the highest string as defined by the C<gt> operator. If the list is"
NSQ_SOURCE_LINE 00000275 "empty then C<undef> is returned."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "    $foo = maxstr 'A'..'Z'          # 'Z'"
NSQ_SOURCE_LINE 00000278 "    $foo = maxstr \"hello\",\"world\"   # \"world\""
NSQ_SOURCE_LINE 00000279 "    $foo = maxstr @bar, @baz        # whatever"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=head2 min"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "    my $num = min @list;"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "Similar to L</max> but returns the entry in the list with the lowest numerical"
NSQ_SOURCE_LINE 00000286 "value. If the list is empty then C<undef> is returned."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "    $foo = min 1..10                # 1"
NSQ_SOURCE_LINE 00000289 "    $foo = min 3,9,12               # 3"
NSQ_SOURCE_LINE 00000290 "    $foo = min @bar, @baz           # whatever"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=head2 minstr"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "    my $str = minstr @list;"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "Similar to L</min>, but treats all the entries in the list as strings and"
NSQ_SOURCE_LINE 00000297 "returns the lowest string as defined by the C<lt> operator. If the list is"
NSQ_SOURCE_LINE 00000298 "empty then C<undef> is returned."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "    $foo = minstr 'A'..'Z'          # 'A'"
NSQ_SOURCE_LINE 00000301 "    $foo = minstr \"hello\",\"world\"   # \"hello\""
NSQ_SOURCE_LINE 00000302 "    $foo = minstr @bar, @baz        # whatever"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=head2 product"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "    my $num = product @list;"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "I<Since version 1.35.>"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "Returns the numerical product of all the elements in C<@list>. If C<@list> is"
NSQ_SOURCE_LINE 00000311 "empty then C<1> is returned."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "    $foo = product 1..10            # 3628800"
NSQ_SOURCE_LINE 00000314 "    $foo = product 3,9,12           # 324"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=head2 sum"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "    my $num_or_undef = sum @list;"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "Returns the numerical sum of all the elements in C<@list>. For backwards"
NSQ_SOURCE_LINE 00000321 "compatibility, if C<@list> is empty then C<undef> is returned."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "    $foo = sum 1..10                # 55"
NSQ_SOURCE_LINE 00000324 "    $foo = sum 3,9,12               # 24"
NSQ_SOURCE_LINE 00000325 "    $foo = sum @bar, @baz           # whatever"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "=head2 sum0"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "    my $num = sum0 @list;"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "I<Since version 1.26.>"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "Similar to L</sum>, except this returns 0 when given an empty list, rather"
NSQ_SOURCE_LINE 00000334 "than C<undef>."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "=head1 KEY/VALUE PAIR LIST FUNCTIONS"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "The following set of functions, all inspired by L<List::Pairwise>, consume an"
NSQ_SOURCE_LINE 00000339 "even-sized list of pairs. The pairs may be key/value associations from a hash,"
NSQ_SOURCE_LINE 00000340 "or just a list of values. The functions will all preserve the original ordering"
NSQ_SOURCE_LINE 00000341 "of the pairs, and will not be confused by multiple pairs having the same \"key\""
NSQ_SOURCE_LINE 00000342 "value - nor even do they require that the first of each pair be a plain string."
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "B<NOTE>: At the time of writing, the following C<pair*> functions that take a"
NSQ_SOURCE_LINE 00000345 "block do not modify the value of C<$_> within the block, and instead operate"
NSQ_SOURCE_LINE 00000346 "using the C<$a> and C<$b> globals instead. This has turned out to be a poor"
NSQ_SOURCE_LINE 00000347 "design, as it precludes the ability to provide a C<pairsort> function. Better"
NSQ_SOURCE_LINE 00000348 "would be to pass pair-like objects as 2-element array references in C<$_>, in"
NSQ_SOURCE_LINE 00000349 "a style similar to the return value of the C<pairs> function. At some future"
NSQ_SOURCE_LINE 00000350 "version this behaviour may be added."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "Until then, users are alerted B<NOT> to rely on the value of C<$_> remaining"
NSQ_SOURCE_LINE 00000353 "unmodified between the outside and the inside of the control block. In"
NSQ_SOURCE_LINE 00000354 "particular, the following example is B<UNSAFE>:"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 " my @kvlist = ..."
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 " foreach (qw( some keys here )) {"
NSQ_SOURCE_LINE 00000359 "    my @items = pairgrep { $a eq $_ } @kvlist;"
NSQ_SOURCE_LINE 00000360 "    ..."
NSQ_SOURCE_LINE 00000361 " }"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "Instead, write this using a lexical variable:"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 " foreach my $key (qw( some keys here )) {"
NSQ_SOURCE_LINE 00000366 "    my @items = pairgrep { $a eq $key } @kvlist;"
NSQ_SOURCE_LINE 00000367 "    ..."
NSQ_SOURCE_LINE 00000368 " }"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=head2 pairs"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "    my @pairs = pairs @kvlist;"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "I<Since version 1.29.>"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "A convenient shortcut to operating on even-sized lists of pairs, this function"
NSQ_SOURCE_LINE 00000377 "returns a list of C<ARRAY> references, each containing two items from the"
NSQ_SOURCE_LINE 00000378 "given list. It is a more efficient version of"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    @pairs = pairmap { [ $a, $b ] } @kvlist"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "It is most convenient to use in a C<foreach> loop, for example:"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "    foreach my $pair ( pairs @kvlist ) {"
NSQ_SOURCE_LINE 00000385 "       my ( $key, $value ) = @$pair;"
NSQ_SOURCE_LINE 00000386 "       ..."
NSQ_SOURCE_LINE 00000387 "    }"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "Since version C<1.39> these C<ARRAY> references are blessed objects,"
NSQ_SOURCE_LINE 00000390 "recognising the two methods C<key> and C<value>. The following code is"
NSQ_SOURCE_LINE 00000391 "equivalent:"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "    foreach my $pair ( pairs @kvlist ) {"
NSQ_SOURCE_LINE 00000394 "       my $key   = $pair->key;"
NSQ_SOURCE_LINE 00000395 "       my $value = $pair->value;"
NSQ_SOURCE_LINE 00000396 "       ..."
NSQ_SOURCE_LINE 00000397 "    }"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "Since version C<1.51> they also have a C<TO_JSON> method to ease"
NSQ_SOURCE_LINE 00000400 "serialisation."
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "=head2 unpairs"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "    my @kvlist = unpairs @pairs"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "I<Since version 1.42.>"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "The inverse function to C<pairs>; this function takes a list of C<ARRAY>"
NSQ_SOURCE_LINE 00000409 "references containing two elements each, and returns a flattened list of the"
NSQ_SOURCE_LINE 00000410 "two values from each of the pairs, in order. This is notionally equivalent to"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "    my @kvlist = map { @{$_}[0,1] } @pairs"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "except that it is implemented more efficiently internally. Specifically, for"
NSQ_SOURCE_LINE 00000415 "any input item it will extract exactly two values for the output list; using"
NSQ_SOURCE_LINE 00000416 "C<undef> if the input array references are short."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "Between C<pairs> and C<unpairs>, a higher-order list function can be used to"
NSQ_SOURCE_LINE 00000419 "operate on the pairs as single scalars; such as the following near-equivalents"
NSQ_SOURCE_LINE 00000420 "of the other C<pair*> higher-order functions:"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "    @kvlist = unpairs grep { FUNC } pairs @kvlist"
NSQ_SOURCE_LINE 00000423 "    # Like pairgrep, but takes $_ instead of $a and $b"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "    @kvlist = unpairs map { FUNC } pairs @kvlist"
NSQ_SOURCE_LINE 00000426 "    # Like pairmap, but takes $_ instead of $a and $b"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "Note however that these versions will not behave as nicely in scalar context."
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "Finally, this technique can be used to implement a sort on a keyvalue pair"
NSQ_SOURCE_LINE 00000431 "list; e.g.:"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "    @kvlist = unpairs sort { $a->key cmp $b->key } pairs @kvlist"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "=head2 pairkeys"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "    my @keys = pairkeys @kvlist;"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "I<Since version 1.29.>"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "A convenient shortcut to operating on even-sized lists of pairs, this function"
NSQ_SOURCE_LINE 00000442 "returns a list of the the first values of each of the pairs in the given list."
NSQ_SOURCE_LINE 00000443 "It is a more efficient version of"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "    @keys = pairmap { $a } @kvlist"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "=head2 pairvalues"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "    my @values = pairvalues @kvlist;"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "I<Since version 1.29.>"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "A convenient shortcut to operating on even-sized lists of pairs, this function"
NSQ_SOURCE_LINE 00000454 "returns a list of the the second values of each of the pairs in the given list."
NSQ_SOURCE_LINE 00000455 "It is a more efficient version of"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "    @values = pairmap { $b } @kvlist"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "=head2 pairgrep"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "    my @kvlist = pairgrep { BLOCK } @kvlist;"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "    my $count = pairgrep { BLOCK } @kvlist;"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "I<Since version 1.29.>"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "Similar to perl's C<grep> keyword, but interprets the given list as an"
NSQ_SOURCE_LINE 00000468 "even-sized list of pairs. It invokes the C<BLOCK> multiple times, in scalar"
NSQ_SOURCE_LINE 00000469 "context, with C<$a> and C<$b> set to successive pairs of values from the"
NSQ_SOURCE_LINE 00000470 "C<@kvlist>."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "Returns an even-sized list of those pairs for which the C<BLOCK> returned true"
NSQ_SOURCE_LINE 00000473 "in list context, or the count of the B<number of pairs> in scalar context."
NSQ_SOURCE_LINE 00000474 "(Note, therefore, in scalar context that it returns a number half the size of"
NSQ_SOURCE_LINE 00000475 "the count of items it would have returned in list context)."
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "    @subset = pairgrep { $a =~ m/^[[:upper:]]+$/ } @kvlist"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "As with C<grep> aliasing C<$_> to list elements, C<pairgrep> aliases C<$a> and"
NSQ_SOURCE_LINE 00000480 "C<$b> to elements of the given list. Any modifications of it by the code block"
NSQ_SOURCE_LINE 00000481 "will be visible to the caller."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "=head2 pairfirst"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "    my ( $key, $val ) = pairfirst { BLOCK } @kvlist;"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "    my $found = pairfirst { BLOCK } @kvlist;"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "I<Since version 1.30.>"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "Similar to the L</first> function, but interprets the given list as an"
NSQ_SOURCE_LINE 00000492 "even-sized list of pairs. It invokes the C<BLOCK> multiple times, in scalar"
NSQ_SOURCE_LINE 00000493 "context, with C<$a> and C<$b> set to successive pairs of values from the"
NSQ_SOURCE_LINE 00000494 "C<@kvlist>."
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "Returns the first pair of values from the list for which the C<BLOCK> returned"
NSQ_SOURCE_LINE 00000497 "true in list context, or an empty list of no such pair was found. In scalar"
NSQ_SOURCE_LINE 00000498 "context it returns a simple boolean value, rather than either the key or the"
NSQ_SOURCE_LINE 00000499 "value found."
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "    ( $key, $value ) = pairfirst { $a =~ m/^[[:upper:]]+$/ } @kvlist"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "As with C<grep> aliasing C<$_> to list elements, C<pairfirst> aliases C<$a> and"
NSQ_SOURCE_LINE 00000504 "C<$b> to elements of the given list. Any modifications of it by the code block"
NSQ_SOURCE_LINE 00000505 "will be visible to the caller."
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "=head2 pairmap"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "    my @list = pairmap { BLOCK } @kvlist;"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "    my $count = pairmap { BLOCK } @kvlist;"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "I<Since version 1.29.>"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "Similar to perl's C<map> keyword, but interprets the given list as an"
NSQ_SOURCE_LINE 00000516 "even-sized list of pairs. It invokes the C<BLOCK> multiple times, in list"
NSQ_SOURCE_LINE 00000517 "context, with C<$a> and C<$b> set to successive pairs of values from the"
NSQ_SOURCE_LINE 00000518 "C<@kvlist>."
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "Returns the concatenation of all the values returned by the C<BLOCK> in list"
NSQ_SOURCE_LINE 00000521 "context, or the count of the number of items that would have been returned in"
NSQ_SOURCE_LINE 00000522 "scalar context."
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "    @result = pairmap { \"The key $a has value $b\" } @kvlist"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "As with C<map> aliasing C<$_> to list elements, C<pairmap> aliases C<$a> and"
NSQ_SOURCE_LINE 00000527 "C<$b> to elements of the given list. Any modifications of it by the code block"
NSQ_SOURCE_LINE 00000528 "will be visible to the caller."
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "See L</KNOWN BUGS> for a known-bug with C<pairmap>, and a workaround."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "=head1 OTHER FUNCTIONS"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=head2 shuffle"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "    my @values = shuffle @values;"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "Returns the values of the input in a random order"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "    @cards = shuffle 0..51      # 0..51 in a random order"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "This function is affected by the C<$RAND> variable."
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "=head2 sample"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "    my @items = sample $count, @values"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "I<Since version 1.54.>"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "Randomly select the given number of elements from the input list. Any given"
NSQ_SOURCE_LINE 00000551 "position in the input list will be selected at most once."
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "If there are fewer than C<$count> items in the list then the function will"
NSQ_SOURCE_LINE 00000554 "return once all of them have been randomly selected; effectively the function"
NSQ_SOURCE_LINE 00000555 "behaves similarly to L</shuffle>."
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "This function is affected by the C<$RAND> variable."
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "=head2 uniq"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "    my @subset = uniq @values"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "I<Since version 1.45.>"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "Filters a list of values to remove subsequent duplicates, as judged by a"
NSQ_SOURCE_LINE 00000566 "DWIM-ish string equality or C<undef> test. Preserves the order of unique"
NSQ_SOURCE_LINE 00000567 "elements, and retains the first value of any duplicate set."
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "    my $count = uniq @values"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "In scalar context, returns the number of elements that would have been"
NSQ_SOURCE_LINE 00000572 "returned as a list."
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "The C<undef> value is treated by this function as distinct from the empty"
NSQ_SOURCE_LINE 00000575 "string, and no warning will be produced. It is left as-is in the returned"
NSQ_SOURCE_LINE 00000576 "list. Subsequent C<undef> values are still considered identical to the first,"
NSQ_SOURCE_LINE 00000577 "and will be removed."
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "=head2 uniqint"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "    my @subset = uniqint @values"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "I<Since version 1.55.>"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "Filters a list of values to remove subsequent duplicates, as judged by an"
NSQ_SOURCE_LINE 00000586 "integer numerical equality test. Preserves the order of unique elements, and"
NSQ_SOURCE_LINE 00000587 "retains the first value of any duplicate set. Values in the returned list will"
NSQ_SOURCE_LINE 00000588 "be coerced into integers."
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "    my $count = uniqint @values"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "In scalar context, returns the number of elements that would have been"
NSQ_SOURCE_LINE 00000593 "returned as a list."
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "Note that C<undef> is treated much as other numerical operations treat it; it"
NSQ_SOURCE_LINE 00000596 "compares equal to zero but additionally produces a warning if such warnings"
NSQ_SOURCE_LINE 00000597 "are enabled (C<use warnings 'uninitialized';>). In addition, an C<undef> in"
NSQ_SOURCE_LINE 00000598 "the returned list is coerced into a numerical zero, so that the entire list of"
NSQ_SOURCE_LINE 00000599 "values returned by C<uniqint> are well-behaved as integers."
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "=head2 uniqnum"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "    my @subset = uniqnum @values"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "I<Since version 1.44.>"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "Filters a list of values to remove subsequent duplicates, as judged by a"
NSQ_SOURCE_LINE 00000608 "numerical equality test. Preserves the order of unique elements, and retains"
NSQ_SOURCE_LINE 00000609 "the first value of any duplicate set."
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "    my $count = uniqnum @values"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "In scalar context, returns the number of elements that would have been"
NSQ_SOURCE_LINE 00000614 "returned as a list."
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "Note that C<undef> is treated much as other numerical operations treat it; it"
NSQ_SOURCE_LINE 00000617 "compares equal to zero but additionally produces a warning if such warnings"
NSQ_SOURCE_LINE 00000618 "are enabled (C<use warnings 'uninitialized';>). In addition, an C<undef> in"
NSQ_SOURCE_LINE 00000619 "the returned list is coerced into a numerical zero, so that the entire list of"
NSQ_SOURCE_LINE 00000620 "values returned by C<uniqnum> are well-behaved as numbers."
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "Note also that multiple IEEE C<NaN> values are treated as duplicates of"
NSQ_SOURCE_LINE 00000623 "each other, regardless of any differences in their payloads, and despite"
NSQ_SOURCE_LINE 00000624 "the fact that C<< 0+'NaN' == 0+'NaN' >> yields false."
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "=head2 uniqstr"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "    my @subset = uniqstr @values"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "I<Since version 1.45.>"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "Filters a list of values to remove subsequent duplicates, as judged by a"
NSQ_SOURCE_LINE 00000633 "string equality test. Preserves the order of unique elements, and retains the"
NSQ_SOURCE_LINE 00000634 "first value of any duplicate set."
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "    my $count = uniqstr @values"
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "In scalar context, returns the number of elements that would have been"
NSQ_SOURCE_LINE 00000639 "returned as a list."
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "Note that C<undef> is treated much as other string operations treat it; it"
NSQ_SOURCE_LINE 00000642 "compares equal to the empty string but additionally produces a warning if such"
NSQ_SOURCE_LINE 00000643 "warnings are enabled (C<use warnings 'uninitialized';>). In addition, an"
NSQ_SOURCE_LINE 00000644 "C<undef> in the returned list is coerced into an empty string, so that the"
NSQ_SOURCE_LINE 00000645 "entire list of values returned by C<uniqstr> are well-behaved as strings."
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "=head2 head"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "    my @values = head $size, @list;"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "I<Since version 1.50.>"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "Returns the first C<$size> elements from C<@list>. If C<$size> is negative, returns"
NSQ_SOURCE_LINE 00000654 "all but the last C<$size> elements from C<@list>."
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "    @result = head 2, qw( foo bar baz );"
NSQ_SOURCE_LINE 00000657 "    # foo, bar"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "    @result = head -2, qw( foo bar baz );"
NSQ_SOURCE_LINE 00000660 "    # foo"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "=head2 tail"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "    my @values = tail $size, @list;"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "I<Since version 1.50.>"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "Returns the last C<$size> elements from C<@list>. If C<$size> is negative, returns"
NSQ_SOURCE_LINE 00000669 "all but the first C<$size> elements from C<@list>."
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "    @result = tail 2, qw( foo bar baz );"
NSQ_SOURCE_LINE 00000672 "    # bar, baz"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "    @result = tail -2, qw( foo bar baz );"
NSQ_SOURCE_LINE 00000675 "    # baz"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "=head1 List::SomeUtils FUNCTIONS"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "=head2 Junctions"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "=head3 I<Treatment of an empty list>"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "There are two schools of thought for how to evaluate a junction on an"
NSQ_SOURCE_LINE 00000684 "empty list:"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "=over"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "=item *"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "Reduction to an identity (boolean)"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "=item *"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "Result is undefined (three-valued)"
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "=back"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "In the first case, the result of the junction applied to the empty list is"
NSQ_SOURCE_LINE 00000699 "determined by a mathematical reduction to an identity depending on whether"
NSQ_SOURCE_LINE 00000700 "the underlying comparison is \"or\" or \"and\".  Conceptually:"
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "                    \"any are true\"      \"all are true\""
NSQ_SOURCE_LINE 00000703 "                    --------------      --------------"
NSQ_SOURCE_LINE 00000704 "    2 elements:     A || B || 0         A && B && 1"
NSQ_SOURCE_LINE 00000705 "    1 element:      A || 0              A && 1"
NSQ_SOURCE_LINE 00000706 "    0 elements:     0                   1"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "In the second case, three-value logic is desired, in which a junction"
NSQ_SOURCE_LINE 00000709 "applied to an empty list returns C<undef> rather than true or false"
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "Junctions with a C<_u> suffix implement three-valued logic.  Those"
NSQ_SOURCE_LINE 00000712 "without are boolean."
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "=head3 all BLOCK LIST"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "=head3 all_u BLOCK LIST"
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "Returns a true value if all items in LIST meet the criterion given through"
NSQ_SOURCE_LINE 00000719 "BLOCK. Sets C<$_> for each item in LIST in turn:"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "  print \"All values are non-negative\""
NSQ_SOURCE_LINE 00000722 "    if all { $_ >= 0 } ($x, $y, $z);"
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "For an empty LIST, C<all> returns true (i.e. no values failed the condition)"
NSQ_SOURCE_LINE 00000725 "and C<all_u> returns C<undef>."
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "Thus, C<< all_u(@list) >> is equivalent to C<< @list ? all(@list) : undef >>."
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "B<Note>: because Perl treats C<undef> as false, you must check the return value"
NSQ_SOURCE_LINE 00000730 "of C<all_u> with C<defined> or you will get the opposite result of what you"
NSQ_SOURCE_LINE 00000731 "expect."
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "=head3 any BLOCK LIST"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "=head3 any_u BLOCK LIST"
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "Returns a true value if any item in LIST meets the criterion given through"
NSQ_SOURCE_LINE 00000738 "BLOCK. Sets C<$_> for each item in LIST in turn:"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "  print \"At least one non-negative value\""
NSQ_SOURCE_LINE 00000741 "    if any { $_ >= 0 } ($x, $y, $z);"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "For an empty LIST, C<any> returns false and C<any_u> returns C<undef>."
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "Thus, C<< any_u(@list) >> is equivalent to C<< @list ? any(@list) : undef >>."
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "=head3 none BLOCK LIST"
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "=head3 none_u BLOCK LIST"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "Logically the negation of C<any>. Returns a true value if no item in LIST meets"
NSQ_SOURCE_LINE 00000752 "the criterion given through BLOCK. Sets C<$_> for each item in LIST in turn:"
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "  print \"No non-negative values\""
NSQ_SOURCE_LINE 00000755 "    if none { $_ >= 0 } ($x, $y, $z);"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "For an empty LIST, C<none> returns true (i.e. no values failed the condition)"
NSQ_SOURCE_LINE 00000758 "and C<none_u> returns C<undef>."
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "Thus, C<< none_u(@list) >> is equivalent to C<< @list ? none(@list) : undef >>."
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "B<Note>: because Perl treats C<undef> as false, you must check the return value"
NSQ_SOURCE_LINE 00000763 "of C<none_u> with C<defined> or you will get the opposite result of what you"
NSQ_SOURCE_LINE 00000764 "expect."
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "=head3 notall BLOCK LIST"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "=head3 notall_u BLOCK LIST"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "Logically the negation of C<all>. Returns a true value if not all items in LIST"
NSQ_SOURCE_LINE 00000771 "meet the criterion given through BLOCK. Sets C<$_> for each item in LIST in"
NSQ_SOURCE_LINE 00000772 "turn:"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "  print \"Not all values are non-negative\""
NSQ_SOURCE_LINE 00000775 "    if notall { $_ >= 0 } ($x, $y, $z);"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "For an empty LIST, C<notall> returns false and C<notall_u> returns C<undef>."
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "Thus, C<< notall_u(@list) >> is equivalent to C<< @list ? notall(@list) : undef >>."
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "=head3 one BLOCK LIST"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "=head3 one_u BLOCK LIST"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "Returns a true value if precisely one item in LIST meets the criterion"
NSQ_SOURCE_LINE 00000786 "given through BLOCK. Sets C<$_> for each item in LIST in turn:"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "    print \"Precisely one value defined\""
NSQ_SOURCE_LINE 00000789 "        if one { defined($_) } @list;"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "Returns false otherwise."
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "For an empty LIST, C<one> returns false and C<one_u> returns C<undef>."
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "The expression C<one BLOCK LIST> is almost equivalent to"
NSQ_SOURCE_LINE 00000796 "C<1 == true BLOCK LIST>, except for short-cutting."
NSQ_SOURCE_LINE 00000797 "Evaluation of BLOCK will immediately stop at the second true value."
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "=head2 Transformation"
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "=head3 apply BLOCK LIST"
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "Makes a copy of the list and then passes each element I<from the copy> to the"
NSQ_SOURCE_LINE 00000804 "BLOCK. Any changes or assignments to C<$_> in the BLOCK will only affect the"
NSQ_SOURCE_LINE 00000805 "elements of the new list. However, if C<$_> is a reference then changes to the"
NSQ_SOURCE_LINE 00000806 "referenced value will be seen in both the original and new list."
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "This function is similar to C<map> but will not modify the elements of the"
NSQ_SOURCE_LINE 00000809 "input list:"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "  my @list = (1 .. 4);"
NSQ_SOURCE_LINE 00000812 "  my @mult = apply { $_ *= 2 } @list;"
NSQ_SOURCE_LINE 00000813 "  print \"\\@list = @list\\n\";"
NSQ_SOURCE_LINE 00000814 "  print \"\\@mult = @mult\\n\";"
NSQ_SOURCE_LINE 00000815 "  __END__"
NSQ_SOURCE_LINE 00000816 "  @list = 1 2 3 4"
NSQ_SOURCE_LINE 00000817 "  @mult = 2 4 6 8"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "Think of it as syntactic sugar for"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "  for (my @mult = @list) { $_ *= 2 }"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "Note that you must alter C<$_> directly inside BLOCK in order for changes to"
NSQ_SOURCE_LINE 00000824 "make effect. New value returned from the BLOCK are ignored:"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "  # @new is identical to @list."
NSQ_SOURCE_LINE 00000827 "  my @new = apply { $_ * 2 } @list;"
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "  # @new is different from @list"
NSQ_SOURCE_LINE 00000830 "  my @new = apply { $_ =* 2 } @list;"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "=head3 insert_after BLOCK VALUE LIST"
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "Inserts VALUE after the first item in LIST for which the criterion in BLOCK is"
NSQ_SOURCE_LINE 00000835 "true. Sets C<$_> for each item in LIST in turn."
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "  my @list = qw/This is a list/;"
NSQ_SOURCE_LINE 00000838 "  insert_after { $_ eq \"a\" } \"longer\" => @list;"
NSQ_SOURCE_LINE 00000839 "  print \"@list\";"
NSQ_SOURCE_LINE 00000840 "  __END__"
NSQ_SOURCE_LINE 00000841 "  This is a longer list"
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "=head3 insert_after_string STRING VALUE LIST"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "Inserts VALUE after the first item in LIST which is equal to STRING."
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "  my @list = qw/This is a list/;"
NSQ_SOURCE_LINE 00000848 "  insert_after_string \"a\", \"longer\" => @list;"
NSQ_SOURCE_LINE 00000849 "  print \"@list\";"
NSQ_SOURCE_LINE 00000850 "  __END__"
NSQ_SOURCE_LINE 00000851 "  This is a longer list"
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "=head3 pairwise BLOCK ARRAY1 ARRAY2"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "Evaluates BLOCK for each pair of elements in ARRAY1 and ARRAY2 and returns a"
NSQ_SOURCE_LINE 00000856 "new list consisting of BLOCK's return values. The two elements are set to C<$a>"
NSQ_SOURCE_LINE 00000857 "and C<$b>.  Note that those two are aliases to the original value so changing"
NSQ_SOURCE_LINE 00000858 "them will modify the input arrays."
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 "  @a = (1 .. 5);"
NSQ_SOURCE_LINE 00000861 "  @b = (11 .. 15);"
NSQ_SOURCE_LINE 00000862 "  @x = pairwise { $a + $b } @a, @b;     # returns 12, 14, 16, 18, 20"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "  # mesh with pairwise"
NSQ_SOURCE_LINE 00000865 "  @a = qw/a b c/;"
NSQ_SOURCE_LINE 00000866 "  @b = qw/1 2 3/;"
NSQ_SOURCE_LINE 00000867 "  @x = pairwise { ($a, $b) } @a, @b;    # returns a, 1, b, 2, c, 3"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "=head3 mesh ARRAY1 ARRAY2 [ ARRAY3 ... ]"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "=head3 zip ARRAY1 ARRAY2 [ ARRAY3 ... ]"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "Returns a list consisting of the first elements of each array, then"
NSQ_SOURCE_LINE 00000874 "the second, then the third, etc, until all arrays are exhausted."
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "Examples:"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "  @x = qw/a b c d/;"
NSQ_SOURCE_LINE 00000879 "  @y = qw/1 2 3 4/;"
NSQ_SOURCE_LINE 00000880 "  @z = mesh @x, @y;         # returns a, 1, b, 2, c, 3, d, 4"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "  @a = ('x');"
NSQ_SOURCE_LINE 00000883 "  @b = ('1', '2');"
NSQ_SOURCE_LINE 00000884 "  @c = qw/zip zap zot/;"
NSQ_SOURCE_LINE 00000885 "  @d = mesh @a, @b, @c;   # x, 1, zip, undef, 2, zap, undef, undef, zot"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "C<zip> is an alias for C<mesh>."
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "=head3 uniq LIST"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "=head3 distinct LIST"
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "Returns a new list by stripping duplicate values in LIST by comparing"
NSQ_SOURCE_LINE 00000894 "the values as hash keys, except that undef is considered separate from ''."
NSQ_SOURCE_LINE 00000895 "The order of elements in the returned list is the same as in LIST. In"
NSQ_SOURCE_LINE 00000896 "scalar context, returns the number of unique elements in LIST."
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "  my @x = uniq 1, 1, 2, 2, 3, 5, 3, 4; # returns 1 2 3 5 4"
NSQ_SOURCE_LINE 00000899 "  my $x = uniq 1, 1, 2, 2, 3, 5, 3, 4; # returns 5"
NSQ_SOURCE_LINE 00000900 "  # returns \"Mike\", \"Michael\", \"Richard\", \"Rick\""
NSQ_SOURCE_LINE 00000901 "  my @n = distinct \"Mike\", \"Michael\", \"Richard\", \"Rick\", \"Michael\", \"Rick\""
NSQ_SOURCE_LINE 00000902 "  # returns '', undef, 'S1', A5'"
NSQ_SOURCE_LINE 00000903 "  my @s = distinct '', undef, 'S1', 'A5'"
NSQ_SOURCE_LINE 00000904 "  # returns '', undef, 'S1', A5'"
NSQ_SOURCE_LINE 00000905 "  my @w = uniq undef, '', 'S1', 'A5'"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "C<distinct> is an alias for C<uniq>."
NSQ_SOURCE_LINE 00000908 ""
NSQ_SOURCE_LINE 00000909 "B<RT#49800> can be used to give feedback about this behavior."
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "=head3 singleton"
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "Returns a new list by stripping values in LIST occurring more than once by"
NSQ_SOURCE_LINE 00000914 "comparing the values as hash keys, except that undef is considered separate"
NSQ_SOURCE_LINE 00000915 "from ''.  The order of elements in the returned list is the same as in LIST."
NSQ_SOURCE_LINE 00000916 "In scalar context, returns the number of elements occurring only once in LIST."
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "  my @x = singleton 1,1,2,2,3,4,5 # returns 3 4 5"
NSQ_SOURCE_LINE 00000919 ""
NSQ_SOURCE_LINE 00000920 "=head2 Partitioning"
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "=head3 after BLOCK LIST"
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "Returns a list of the values of LIST after (and not including) the point"
NSQ_SOURCE_LINE 00000925 "where BLOCK returns a true value. Sets C<$_> for each element in LIST in turn."
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "  @x = after { $_ % 5 == 0 } (1..9);    # returns 6, 7, 8, 9"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "=head3 after_incl BLOCK LIST"
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "Same as C<after> but also includes the element for which BLOCK is true."
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "=head3 before BLOCK LIST"
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "Returns a list of values of LIST up to (and not including) the point where BLOCK"
NSQ_SOURCE_LINE 00000936 "returns a true value. Sets C<$_> for each element in LIST in turn."
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "=head3 before_incl BLOCK LIST"
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "Same as C<before> but also includes the element for which BLOCK is true."
NSQ_SOURCE_LINE 00000941 ""
NSQ_SOURCE_LINE 00000942 "=head3 part BLOCK LIST"
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "Partitions LIST based on the return value of BLOCK which denotes into which"
NSQ_SOURCE_LINE 00000945 "partition the current value is put."
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "Returns a list of the partitions thusly created. Each partition created is a"
NSQ_SOURCE_LINE 00000948 "reference to an array."
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "  my $i = 0;"
NSQ_SOURCE_LINE 00000951 "  my @part = part { $i++ % 2 } 1 .. 8;   # returns [1, 3, 5, 7], [2, 4, 6, 8]"
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "You can have a sparse list of partitions as well where non-set partitions will"
NSQ_SOURCE_LINE 00000954 "be undef:"
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "  my @part = part { 2 } 1 .. 10;            # returns undef, undef, [ 1 .. 10 ]"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "Be careful with negative values, though:"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "  my @part = part { -1 } 1 .. 10;"
NSQ_SOURCE_LINE 00000961 "  __END__"
NSQ_SOURCE_LINE 00000962 "  Modification of non-creatable array value attempted, subscript -1 ..."
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "Negative values are only ok when they refer to a partition previously created:"
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "  my @idx  = ( 0, 1, -1 );"
NSQ_SOURCE_LINE 00000967 "  my $i    = 0;"
NSQ_SOURCE_LINE 00000968 "  my @part = part { $idx[$i++ % 3] } 1 .. 8; # [1, 4, 7], [2, 3, 5, 6, 8]"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "=head2 Iteration"
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "=head3 each_array ARRAY1 ARRAY2 ..."
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "Creates an array iterator to return the elements of the list of arrays ARRAY1,"
NSQ_SOURCE_LINE 00000975 "ARRAY2 throughout ARRAYn in turn.  That is, the first time it is called, it"
NSQ_SOURCE_LINE 00000976 "returns the first element of each array.  The next time, it returns the second"
NSQ_SOURCE_LINE 00000977 "elements.  And so on, until all elements are exhausted."
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "This is useful for looping over more than one array at once:"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "  my $ea = each_array(@a, @b, @c);"
NSQ_SOURCE_LINE 00000982 "  while ( my ($a, $b, $c) = $ea->() )   { .... }"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "The iterator returns the empty list when it reached the end of all arrays."
NSQ_SOURCE_LINE 00000985 ""
NSQ_SOURCE_LINE 00000986 "If the iterator is passed an argument of 'C<index>', then it returns"
NSQ_SOURCE_LINE 00000987 "the index of the last fetched set of values, as a scalar."
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "=head3 each_arrayref LIST"
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "Like each_array, but the arguments are references to arrays, not the"
NSQ_SOURCE_LINE 00000992 "plain arrays."
NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "=head3 natatime EXPR, LIST"
NSQ_SOURCE_LINE 00000995 ""
NSQ_SOURCE_LINE 00000996 "Creates an array iterator, for looping over an array in chunks of"
NSQ_SOURCE_LINE 00000997 "C<$n> items at a time.  (n at a time, get it?).  An example is"
NSQ_SOURCE_LINE 00000998 "probably a better explanation than I could give in words."
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "Example:"
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "  my @x = ('a' .. 'g');"
NSQ_SOURCE_LINE 00001003 "  my $it = natatime 3, @x;"
NSQ_SOURCE_LINE 00001004 "  while (my @vals = $it->())"
NSQ_SOURCE_LINE 00001005 "  {"
NSQ_SOURCE_LINE 00001006 "    print \"@vals\\n\";"
NSQ_SOURCE_LINE 00001007 "  }"
NSQ_SOURCE_LINE 00001008 ""
NSQ_SOURCE_LINE 00001009 "This prints"
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "  a b c"
NSQ_SOURCE_LINE 00001012 "  d e f"
NSQ_SOURCE_LINE 00001013 "  g"
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "=head2 Searching"
NSQ_SOURCE_LINE 00001016 ""
NSQ_SOURCE_LINE 00001017 "=head3 bsearch BLOCK LIST"
NSQ_SOURCE_LINE 00001018 ""
NSQ_SOURCE_LINE 00001019 "Performs a binary search on LIST which must be a sorted list of values. BLOCK"
NSQ_SOURCE_LINE 00001020 "must return a negative value if the current element (stored in C<$_>) is smaller,"
NSQ_SOURCE_LINE 00001021 "a positive value if it is bigger and zero if it matches."
NSQ_SOURCE_LINE 00001022 ""
NSQ_SOURCE_LINE 00001023 "Returns a boolean value in scalar context. In list context, it returns the element"
NSQ_SOURCE_LINE 00001024 "if it was found, otherwise the empty list."
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "=head3 bsearchidx BLOCK LIST"
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "=head3 bsearch_index BLOCK LIST"
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "Performs a binary search on LIST which must be a sorted list of values. BLOCK"
NSQ_SOURCE_LINE 00001031 "must return a negative value if the current element (stored in C<$_>) is smaller,"
NSQ_SOURCE_LINE 00001032 "a positive value if it is bigger and zero if it matches."
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "Returns the index of found element, otherwise C<-1>."
NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "C<bsearch_index> is an alias for C<bsearchidx>."
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "=head3 firstval BLOCK LIST"
NSQ_SOURCE_LINE 00001039 ""
NSQ_SOURCE_LINE 00001040 "=head3 first_value BLOCK LIST"
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "Returns the first element in LIST for which BLOCK evaluates to true. Each"
NSQ_SOURCE_LINE 00001043 "element of LIST is set to C<$_> in turn. Returns C<undef> if no such element"
NSQ_SOURCE_LINE 00001044 "has been found."
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "C<first_value> is an alias for C<firstval>."
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "=head3 onlyval BLOCK LIST"
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "=head3 only_value BLOCK LIST"
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "Returns the only element in LIST for which BLOCK evaluates to true. Sets"
NSQ_SOURCE_LINE 00001053 "C<$_> for each item in LIST in turn. Returns C<undef> if no such element"
NSQ_SOURCE_LINE 00001054 "has been found."
NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 "C<only_value> is an alias for C<onlyval>."
NSQ_SOURCE_LINE 00001057 ""
NSQ_SOURCE_LINE 00001058 "=head3 lastval BLOCK LIST"
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "=head3 last_value BLOCK LIST"
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "Returns the last value in LIST for which BLOCK evaluates to true. Each element"
NSQ_SOURCE_LINE 00001063 "of LIST is set to C<$_> in turn. Returns C<undef> if no such element has been"
NSQ_SOURCE_LINE 00001064 "found."
NSQ_SOURCE_LINE 00001065 ""
NSQ_SOURCE_LINE 00001066 "C<last_value> is an alias for C<lastval>."
NSQ_SOURCE_LINE 00001067 ""
NSQ_SOURCE_LINE 00001068 "=head3 firstres BLOCK LIST"
NSQ_SOURCE_LINE 00001069 ""
NSQ_SOURCE_LINE 00001070 "=head3 first_result BLOCK LIST"
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "Returns the result of BLOCK for the first element in LIST for which BLOCK"
NSQ_SOURCE_LINE 00001073 "evaluates to true. Each element of LIST is set to C<$_> in turn. Returns"
NSQ_SOURCE_LINE 00001074 "C<undef> if no such element has been found."
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 "C<first_result> is an alias for C<firstres>."
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 "=head3 onlyres BLOCK LIST"
NSQ_SOURCE_LINE 00001079 ""
NSQ_SOURCE_LINE 00001080 "=head3 only_result BLOCK LIST"
NSQ_SOURCE_LINE 00001081 ""
NSQ_SOURCE_LINE 00001082 "Returns the result of BLOCK for the first element in LIST for which BLOCK"
NSQ_SOURCE_LINE 00001083 "evaluates to true. Sets C<$_> for each item in LIST in turn. Returns"
NSQ_SOURCE_LINE 00001084 "C<undef> if no such element has been found."
NSQ_SOURCE_LINE 00001085 ""
NSQ_SOURCE_LINE 00001086 "C<only_result> is an alias for C<onlyres>."
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "=head3 lastres BLOCK LIST"
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "=head3 last_result BLOCK LIST"
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "Returns the result of BLOCK for the last element in LIST for which BLOCK"
NSQ_SOURCE_LINE 00001093 "evaluates to true. Each element of LIST is set to C<$_> in turn. Returns"
NSQ_SOURCE_LINE 00001094 "C<undef> if no such element has been found."
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 "C<last_result> is an alias for C<lastres>."
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "=head3 indexes BLOCK LIST"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "Evaluates BLOCK for each element in LIST (assigned to C<$_>) and returns a list"
NSQ_SOURCE_LINE 00001101 "of the indices of those elements for which BLOCK returned a true value. This is"
NSQ_SOURCE_LINE 00001102 "just like C<grep> only that it returns indices instead of values:"
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 "  @x = indexes { $_ % 2 == 0 } (1..10);   # returns 1, 3, 5, 7, 9"
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 "=head3 firstidx BLOCK LIST"
NSQ_SOURCE_LINE 00001107 ""
NSQ_SOURCE_LINE 00001108 "=head3 first_index BLOCK LIST"
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "Returns the index of the first element in LIST for which the criterion in BLOCK"
NSQ_SOURCE_LINE 00001111 "is true. Sets C<$_> for each item in LIST in turn:"
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "  my @list = (1, 4, 3, 2, 4, 6);"
NSQ_SOURCE_LINE 00001114 "  printf \"item with index %i in list is 4\", firstidx { $_ == 4 } @list;"
NSQ_SOURCE_LINE 00001115 "  __END__"
NSQ_SOURCE_LINE 00001116 "  item with index 1 in list is 4"
NSQ_SOURCE_LINE 00001117 ""
NSQ_SOURCE_LINE 00001118 "Returns C<-1> if no such item could be found."
NSQ_SOURCE_LINE 00001119 ""
NSQ_SOURCE_LINE 00001120 "C<first_index> is an alias for C<firstidx>."
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "=head3 onlyidx BLOCK LIST"
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 "=head3 only_index BLOCK LIST"
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "Returns the index of the only element in LIST for which the criterion"
NSQ_SOURCE_LINE 00001127 "in BLOCK is true. Sets C<$_> for each item in LIST in turn:"
NSQ_SOURCE_LINE 00001128 ""
NSQ_SOURCE_LINE 00001129 "    my @list = (1, 3, 4, 3, 2, 4);"
NSQ_SOURCE_LINE 00001130 "    printf \"uniqe index of item 2 in list is %i\", onlyidx { $_ == 2 } @list;"
NSQ_SOURCE_LINE 00001131 "    __END__"
NSQ_SOURCE_LINE 00001132 "    unique index of item 2 in list is 4"
NSQ_SOURCE_LINE 00001133 ""
NSQ_SOURCE_LINE 00001134 "Returns C<-1> if either no such item or more than one of these"
NSQ_SOURCE_LINE 00001135 "has been found."
NSQ_SOURCE_LINE 00001136 ""
NSQ_SOURCE_LINE 00001137 "C<only_index> is an alias for C<onlyidx>."
NSQ_SOURCE_LINE 00001138 ""
NSQ_SOURCE_LINE 00001139 "=head3 lastidx BLOCK LIST"
NSQ_SOURCE_LINE 00001140 ""
NSQ_SOURCE_LINE 00001141 "=head3 last_index BLOCK LIST"
NSQ_SOURCE_LINE 00001142 ""
NSQ_SOURCE_LINE 00001143 "Returns the index of the last element in LIST for which the criterion in BLOCK"
NSQ_SOURCE_LINE 00001144 "is true. Sets C<$_> for each item in LIST in turn:"
NSQ_SOURCE_LINE 00001145 ""
NSQ_SOURCE_LINE 00001146 "  my @list = (1, 4, 3, 2, 4, 6);"
NSQ_SOURCE_LINE 00001147 "  printf \"item with index %i in list is 4\", lastidx { $_ == 4 } @list;"
NSQ_SOURCE_LINE 00001148 "  __END__"
NSQ_SOURCE_LINE 00001149 "  item with index 4 in list is 4"
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "Returns C<-1> if no such item could be found."
NSQ_SOURCE_LINE 00001152 ""
NSQ_SOURCE_LINE 00001153 "C<last_index> is an alias for C<lastidx>."
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "=head2 Sorting"
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "=head3 sort_by BLOCK LIST"
NSQ_SOURCE_LINE 00001158 ""
NSQ_SOURCE_LINE 00001159 "Returns the list of values sorted according to the string values returned by the"
NSQ_SOURCE_LINE 00001160 "KEYFUNC block or function. A typical use of this may be to sort objects according"
NSQ_SOURCE_LINE 00001161 "to the string value of some accessor, such as"
NSQ_SOURCE_LINE 00001162 ""
NSQ_SOURCE_LINE 00001163 "  sort_by { $_->name } @people"
NSQ_SOURCE_LINE 00001164 ""
NSQ_SOURCE_LINE 00001165 "The key function is called in scalar context, being passed each value in turn as"
NSQ_SOURCE_LINE 00001166 "both $_ and the only argument in the parameters, @_. The values are then sorted"
NSQ_SOURCE_LINE 00001167 "according to string comparisons on the values returned."
NSQ_SOURCE_LINE 00001168 "This is equivalent to"
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 "  sort { $a->name cmp $b->name } @people"
NSQ_SOURCE_LINE 00001171 ""
NSQ_SOURCE_LINE 00001172 "except that it guarantees the name accessor will be executed only once per value."
NSQ_SOURCE_LINE 00001173 "One interesting use-case is to sort strings which may have numbers embedded in them"
NSQ_SOURCE_LINE 00001174 "\"naturally\", rather than lexically."
NSQ_SOURCE_LINE 00001175 ""
NSQ_SOURCE_LINE 00001176 "  sort_by { s/(\\d+)/sprintf \"%09d\", $1/eg; $_ } @strings"
NSQ_SOURCE_LINE 00001177 ""
NSQ_SOURCE_LINE 00001178 "This sorts strings by generating sort keys which zero-pad the embedded numbers to"
NSQ_SOURCE_LINE 00001179 "some level (9 digits in this case), helping to ensure the lexical sort puts them"
NSQ_SOURCE_LINE 00001180 "in the correct order."
NSQ_SOURCE_LINE 00001181 ""
NSQ_SOURCE_LINE 00001182 "=head3 nsort_by BLOCK LIST"
NSQ_SOURCE_LINE 00001183 ""
NSQ_SOURCE_LINE 00001184 "Similar to sort_by but compares its key values numerically."
NSQ_SOURCE_LINE 00001185 ""
NSQ_SOURCE_LINE 00001186 "=head2 Counting and calculation"
NSQ_SOURCE_LINE 00001187 ""
NSQ_SOURCE_LINE 00001188 "=head3 true BLOCK LIST"
NSQ_SOURCE_LINE 00001189 ""
NSQ_SOURCE_LINE 00001190 "Counts the number of elements in LIST for which the criterion in BLOCK is true."
NSQ_SOURCE_LINE 00001191 "Sets C<$_> for  each item in LIST in turn:"
NSQ_SOURCE_LINE 00001192 ""
NSQ_SOURCE_LINE 00001193 "  printf \"%i item(s) are defined\", true { defined($_) } @list;"
NSQ_SOURCE_LINE 00001194 ""
NSQ_SOURCE_LINE 00001195 "=head3 false BLOCK LIST"
NSQ_SOURCE_LINE 00001196 ""
NSQ_SOURCE_LINE 00001197 "Counts the number of elements in LIST for which the criterion in BLOCK is false."
NSQ_SOURCE_LINE 00001198 "Sets C<$_> for each item in LIST in turn:"
NSQ_SOURCE_LINE 00001199 ""
NSQ_SOURCE_LINE 00001200 "  printf \"%i item(s) are not defined\", false { defined($_) } @list;"
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "=head3 minmax LIST"
NSQ_SOURCE_LINE 00001203 ""
NSQ_SOURCE_LINE 00001204 "Calculates the minimum and maximum of LIST and returns a two element list with"
NSQ_SOURCE_LINE 00001205 "the first element being the minimum and the second the maximum. Returns the"
NSQ_SOURCE_LINE 00001206 "empty list if LIST was empty."
NSQ_SOURCE_LINE 00001207 ""
NSQ_SOURCE_LINE 00001208 "The C<minmax> algorithm differs from a naive iteration over the list where each"
NSQ_SOURCE_LINE 00001209 "element is compared to two values being the so far calculated min and max value"
NSQ_SOURCE_LINE 00001210 "in that it only requires 3n/2 - 2 comparisons. Thus it is the most efficient"
NSQ_SOURCE_LINE 00001211 "possible algorithm."
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 "However, the Perl implementation of it has some overhead simply due to the fact"
NSQ_SOURCE_LINE 00001214 "that there are more lines of Perl code involved. Therefore, LIST needs to be"
NSQ_SOURCE_LINE 00001215 "fairly big in order for C<minmax> to win over a naive implementation. This"
NSQ_SOURCE_LINE 00001216 "limitation does not apply to the XS version."
NSQ_SOURCE_LINE 00001217 ""
NSQ_SOURCE_LINE 00001218 "=head3 mode LIST"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "Calculates the most common items in the list and returns them as a list. This"
NSQ_SOURCE_LINE 00001221 "is effectively done by string comparisons, so references will be"
NSQ_SOURCE_LINE 00001222 "stringified. If they implement string overloading, this will be used."
NSQ_SOURCE_LINE 00001223 ""
NSQ_SOURCE_LINE 00001224 "If more than one item appears the same number of times in the list, all such"
NSQ_SOURCE_LINE 00001225 "items will be returned. For example, the mode of a unique list is the list"
NSQ_SOURCE_LINE 00001226 "itself."
NSQ_SOURCE_LINE 00001227 ""
NSQ_SOURCE_LINE 00001228 "This function returns a list in list context. In scalar context it returns a"
NSQ_SOURCE_LINE 00001229 "count indicating the number of modes in the list."
NSQ_SOURCE_LINE 00001230 ""
NSQ_SOURCE_LINE 00001231 "=head1 List::UtilsBy FUNCTIONS"
NSQ_SOURCE_LINE 00001232 ""
NSQ_SOURCE_LINE 00001233 "All functions added since version 0.04 unless otherwise stated, as the"
NSQ_SOURCE_LINE 00001234 "original names for earlier versions were renamed."
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 "=head2 sort_by"
NSQ_SOURCE_LINE 00001237 ""
NSQ_SOURCE_LINE 00001238 "   @vals = sort_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "Returns the list of values sorted according to the string values returned by"
NSQ_SOURCE_LINE 00001241 "the C<KEYFUNC> block or function. A typical use of this may be to sort objects"
NSQ_SOURCE_LINE 00001242 "according to the string value of some accessor, such as"
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "   sort_by { $_->name } @people"
NSQ_SOURCE_LINE 00001245 ""
NSQ_SOURCE_LINE 00001246 "The key function is called in scalar context, being passed each value in turn"
NSQ_SOURCE_LINE 00001247 "as both C<$_> and the only argument in the parameters, C<@_>. The values are"
NSQ_SOURCE_LINE 00001248 "then sorted according to string comparisons on the values returned."
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "This is equivalent to"
NSQ_SOURCE_LINE 00001251 ""
NSQ_SOURCE_LINE 00001252 "   sort { $a->name cmp $b->name } @people"
NSQ_SOURCE_LINE 00001253 ""
NSQ_SOURCE_LINE 00001254 "except that it guarantees the C<name> accessor will be executed only once per"
NSQ_SOURCE_LINE 00001255 "value."
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "One interesting use-case is to sort strings which may have numbers embedded in"
NSQ_SOURCE_LINE 00001258 "them \"naturally\", rather than lexically."
NSQ_SOURCE_LINE 00001259 ""
NSQ_SOURCE_LINE 00001260 "   sort_by { s/(\\d+)/sprintf \"%09d\", $1/eg; $_ } @strings"
NSQ_SOURCE_LINE 00001261 ""
NSQ_SOURCE_LINE 00001262 "This sorts strings by generating sort keys which zero-pad the embedded numbers"
NSQ_SOURCE_LINE 00001263 "to some level (9 digits in this case), helping to ensure the lexical sort puts"
NSQ_SOURCE_LINE 00001264 "them in the correct order."
NSQ_SOURCE_LINE 00001265 ""
NSQ_SOURCE_LINE 00001266 "=head2 nsort_by"
NSQ_SOURCE_LINE 00001267 ""
NSQ_SOURCE_LINE 00001268 "   @vals = nsort_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001269 ""
NSQ_SOURCE_LINE 00001270 "Similar to L</sort_by> but compares its key values numerically."
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 "=head2 rev_sort_by"
NSQ_SOURCE_LINE 00001273 ""
NSQ_SOURCE_LINE 00001274 "=head2 rev_nsort_by"
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "   @vals = rev_sort_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001277 ""
NSQ_SOURCE_LINE 00001278 "   @vals = rev_nsort_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001279 ""
NSQ_SOURCE_LINE 00001280 "I<Since version 0.06.>"
NSQ_SOURCE_LINE 00001281 ""
NSQ_SOURCE_LINE 00001282 "Similar to L</sort_by> and L</nsort_by> but returns the list in the reverse"
NSQ_SOURCE_LINE 00001283 "order. Equivalent to"
NSQ_SOURCE_LINE 00001284 ""
NSQ_SOURCE_LINE 00001285 "   @vals = reverse sort_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001286 ""
NSQ_SOURCE_LINE 00001287 "except that these functions are slightly more efficient because they avoid"
NSQ_SOURCE_LINE 00001288 "the final C<reverse> operation."
NSQ_SOURCE_LINE 00001289 ""
NSQ_SOURCE_LINE 00001290 "=head2 max_by"
NSQ_SOURCE_LINE 00001291 ""
NSQ_SOURCE_LINE 00001292 "   $optimal = max_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001293 ""
NSQ_SOURCE_LINE 00001294 "   @optimal = max_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 "Returns the (first) value from C<@vals> that gives the numerically largest"
NSQ_SOURCE_LINE 00001297 "result from the key function."
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "   my $tallest = max_by { $_->height } @people"
NSQ_SOURCE_LINE 00001300 ""
NSQ_SOURCE_LINE 00001301 "   use File::stat qw( stat );"
NSQ_SOURCE_LINE 00001302 "   my $newest = max_by { stat($_)->mtime } @files;"
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 "In scalar context, the first maximal value is returned. In list context, a"
NSQ_SOURCE_LINE 00001305 "list of all the maximal values is returned. This may be used to obtain"
NSQ_SOURCE_LINE 00001306 "positions other than the first, if order is significant."
NSQ_SOURCE_LINE 00001307 ""
NSQ_SOURCE_LINE 00001308 "If called on an empty list, an empty list is returned."
NSQ_SOURCE_LINE 00001309 ""
NSQ_SOURCE_LINE 00001310 "For symmetry with the L</nsort_by> function, this is also provided under the"
NSQ_SOURCE_LINE 00001311 "name C<nmax_by> since it behaves numerically."
NSQ_SOURCE_LINE 00001312 ""
NSQ_SOURCE_LINE 00001313 "=head2 min_by"
NSQ_SOURCE_LINE 00001314 ""
NSQ_SOURCE_LINE 00001315 "   $optimal = min_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001316 ""
NSQ_SOURCE_LINE 00001317 "   @optimal = min_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001318 ""
NSQ_SOURCE_LINE 00001319 "Similar to L</max_by> but returns values which give the numerically smallest"
NSQ_SOURCE_LINE 00001320 "result from the key function. Also provided as C<nmin_by>"
NSQ_SOURCE_LINE 00001321 ""
NSQ_SOURCE_LINE 00001322 "=head2 minmax_by"
NSQ_SOURCE_LINE 00001323 ""
NSQ_SOURCE_LINE 00001324 "   ( $minimal, $maximal ) = minmax_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001325 ""
NSQ_SOURCE_LINE 00001326 "I<Since version 0.11.>"
NSQ_SOURCE_LINE 00001327 ""
NSQ_SOURCE_LINE 00001328 "Similar to calling both L</min_by> and L</max_by> with the same key function"
NSQ_SOURCE_LINE 00001329 "on the same list. This version is more efficient than calling the two other"
NSQ_SOURCE_LINE 00001330 "functions individually, as it has less work to perform overall. In the case of"
NSQ_SOURCE_LINE 00001331 "ties, only the first optimal element found in each case is returned. Also"
NSQ_SOURCE_LINE 00001332 "provided as C<nminmax_by>."
NSQ_SOURCE_LINE 00001333 ""
NSQ_SOURCE_LINE 00001334 "=head2 uniq_by"
NSQ_SOURCE_LINE 00001335 ""
NSQ_SOURCE_LINE 00001336 "   @vals = uniq_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001337 ""
NSQ_SOURCE_LINE 00001338 "Returns a list of the subset of values for which the key function block"
NSQ_SOURCE_LINE 00001339 "returns unique values. The first value yielding a particular key is chosen,"
NSQ_SOURCE_LINE 00001340 "subsequent values are rejected."
NSQ_SOURCE_LINE 00001341 ""
NSQ_SOURCE_LINE 00001342 "   my @some_fruit = uniq_by { $_->colour } @fruit;"
NSQ_SOURCE_LINE 00001343 ""
NSQ_SOURCE_LINE 00001344 "To select instead the last value per key, reverse the input list. If the order"
NSQ_SOURCE_LINE 00001345 "of the results is significant, don't forget to reverse the result as well:"
NSQ_SOURCE_LINE 00001346 ""
NSQ_SOURCE_LINE 00001347 "   my @some_fruit = reverse uniq_by { $_->colour } reverse @fruit;"
NSQ_SOURCE_LINE 00001348 ""
NSQ_SOURCE_LINE 00001349 "Because the values returned by the key function are used as hash keys, they"
NSQ_SOURCE_LINE 00001350 "ought to either be strings, or at least well-behaved as strings (such as"
NSQ_SOURCE_LINE 00001351 "numbers, or object references which overload stringification in a suitable"
NSQ_SOURCE_LINE 00001352 "manner)."
NSQ_SOURCE_LINE 00001353 ""
NSQ_SOURCE_LINE 00001354 "=head2 partition_by"
NSQ_SOURCE_LINE 00001355 ""
NSQ_SOURCE_LINE 00001356 "   %parts = partition_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 "Returns a key/value list of ARRAY refs containing all the original values"
NSQ_SOURCE_LINE 00001359 "distributed according to the result of the key function block. Each value will"
NSQ_SOURCE_LINE 00001360 "be an ARRAY ref containing all the values which returned the string from the"
NSQ_SOURCE_LINE 00001361 "key function, in their original order."
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "   my %balls_by_colour = partition_by { $_->colour } @balls;"
NSQ_SOURCE_LINE 00001364 ""
NSQ_SOURCE_LINE 00001365 "Because the values returned by the key function are used as hash keys, they"
NSQ_SOURCE_LINE 00001366 "ought to either be strings, or at least well-behaved as strings (such as"
NSQ_SOURCE_LINE 00001367 "numbers, or object references which overload stringification in a suitable"
NSQ_SOURCE_LINE 00001368 "manner)."
NSQ_SOURCE_LINE 00001369 ""
NSQ_SOURCE_LINE 00001370 "=head2 count_by"
NSQ_SOURCE_LINE 00001371 ""
NSQ_SOURCE_LINE 00001372 "   %counts = count_by { KEYFUNC } @vals"
NSQ_SOURCE_LINE 00001373 ""
NSQ_SOURCE_LINE 00001374 "I<Since version 0.07.>"
NSQ_SOURCE_LINE 00001375 ""
NSQ_SOURCE_LINE 00001376 "Returns a key/value list of integers, giving the number of times the key"
NSQ_SOURCE_LINE 00001377 "function block returned the key, for each value in the list."
NSQ_SOURCE_LINE 00001378 ""
NSQ_SOURCE_LINE 00001379 "   my %count_of_balls = count_by { $_->colour } @balls;"
NSQ_SOURCE_LINE 00001380 ""
NSQ_SOURCE_LINE 00001381 "Because the values returned by the key function are used as hash keys, they"
NSQ_SOURCE_LINE 00001382 "ought to either be strings, or at least well-behaved as strings (such as"
NSQ_SOURCE_LINE 00001383 "numbers, or object references which overload stringification in a suitable"
NSQ_SOURCE_LINE 00001384 "manner)."
NSQ_SOURCE_LINE 00001385 ""
NSQ_SOURCE_LINE 00001386 "=head2 zip_by"
NSQ_SOURCE_LINE 00001387 ""
NSQ_SOURCE_LINE 00001388 "   @vals = zip_by { ITEMFUNC } \\@arr0, \\@arr1, \\@arr2,..."
NSQ_SOURCE_LINE 00001389 ""
NSQ_SOURCE_LINE 00001390 "Returns a list of each of the values returned by the function block, when"
NSQ_SOURCE_LINE 00001391 "invoked with values from across each each of the given ARRAY references. Each"
NSQ_SOURCE_LINE 00001392 "value in the returned list will be the result of the function having been"
NSQ_SOURCE_LINE 00001393 "invoked with arguments at that position, from across each of the arrays given."
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 "   my @transposition = zip_by { [ @_ ] } @matrix;"
NSQ_SOURCE_LINE 00001396 ""
NSQ_SOURCE_LINE 00001397 "   my @names = zip_by { \"$_[1], $_[0]\" } \\@firstnames, \\@surnames;"
NSQ_SOURCE_LINE 00001398 ""
NSQ_SOURCE_LINE 00001399 "   print zip_by { \"$_[0] => $_[1]\\n\" } [ keys %hash ], [ values %hash ];"
NSQ_SOURCE_LINE 00001400 ""
NSQ_SOURCE_LINE 00001401 "If some of the arrays are shorter than others, the function will behave as if"
NSQ_SOURCE_LINE 00001402 "they had C<undef> in the trailing positions. The following two lines are"
NSQ_SOURCE_LINE 00001403 "equivalent:"
NSQ_SOURCE_LINE 00001404 ""
NSQ_SOURCE_LINE 00001405 "   zip_by { f(@_) } [ 1, 2, 3 ], [ \"a\", \"b\" ]"
NSQ_SOURCE_LINE 00001406 "   f( 1, \"a\" ), f( 2, \"b\" ), f( 3, undef )"
NSQ_SOURCE_LINE 00001407 ""
NSQ_SOURCE_LINE 00001408 "The item function is called by C<map>, so if it returns a list, the entire"
NSQ_SOURCE_LINE 00001409 "list is included in the result. This can be useful for example, for generating"
NSQ_SOURCE_LINE 00001410 "a hash from two separate lists of keys and values"
NSQ_SOURCE_LINE 00001411 ""
NSQ_SOURCE_LINE 00001412 "   my %nums = zip_by { @_ } [qw( one two three )], [ 1, 2, 3 ];"
NSQ_SOURCE_LINE 00001413 "   # %nums = ( one => 1, two => 2, three => 3 )"
NSQ_SOURCE_LINE 00001414 ""
NSQ_SOURCE_LINE 00001415 "(A function having this behaviour is sometimes called C<zipWith>, e.g. in"
NSQ_SOURCE_LINE 00001416 "Haskell, but that name would not fit the naming scheme used by this module)."
NSQ_SOURCE_LINE 00001417 ""
NSQ_SOURCE_LINE 00001418 "=head2 unzip_by"
NSQ_SOURCE_LINE 00001419 ""
NSQ_SOURCE_LINE 00001420 "   $arr0, $arr1, $arr2, ... = unzip_by { ITEMFUNC } @vals"
NSQ_SOURCE_LINE 00001421 ""
NSQ_SOURCE_LINE 00001422 "I<Since version 0.09.>"
NSQ_SOURCE_LINE 00001423 ""
NSQ_SOURCE_LINE 00001424 "Returns a list of ARRAY references containing the values returned by the"
NSQ_SOURCE_LINE 00001425 "function block, when invoked for each of the values given in the input list."
NSQ_SOURCE_LINE 00001426 "Each of the returned ARRAY references will contain the values returned at that"
NSQ_SOURCE_LINE 00001427 "corresponding position by the function block. That is, the first returned"
NSQ_SOURCE_LINE 00001428 "ARRAY reference will contain all the values returned in the first position by"
NSQ_SOURCE_LINE 00001429 "the function block, the second will contain all the values from the second"
NSQ_SOURCE_LINE 00001430 "position, and so on."
NSQ_SOURCE_LINE 00001431 ""
NSQ_SOURCE_LINE 00001432 "   my ( $firstnames, $lastnames ) = unzip_by { m/^(.*?) (.*)$/ } @names;"
NSQ_SOURCE_LINE 00001433 ""
NSQ_SOURCE_LINE 00001434 "If the function returns lists of differing lengths, the result will be padded"
NSQ_SOURCE_LINE 00001435 "with C<undef> in the missing elements."
NSQ_SOURCE_LINE 00001436 ""
NSQ_SOURCE_LINE 00001437 "This function is an inverse of L</zip_by>, if given a corresponding inverse"
NSQ_SOURCE_LINE 00001438 "function."
NSQ_SOURCE_LINE 00001439 ""
NSQ_SOURCE_LINE 00001440 "=head2 extract_by"
NSQ_SOURCE_LINE 00001441 ""
NSQ_SOURCE_LINE 00001442 "   @vals = extract_by { SELECTFUNC } @arr"
NSQ_SOURCE_LINE 00001443 ""
NSQ_SOURCE_LINE 00001444 "I<Since version 0.05.>"
NSQ_SOURCE_LINE 00001445 ""
NSQ_SOURCE_LINE 00001446 "Removes elements from the referenced array on which the selection function"
NSQ_SOURCE_LINE 00001447 "returns true, and returns a list containing those elements. This function is"
NSQ_SOURCE_LINE 00001448 "similar to C<grep>, except that it modifies the referenced array to remove the"
NSQ_SOURCE_LINE 00001449 "selected values from it, leaving only the unselected ones."
NSQ_SOURCE_LINE 00001450 ""
NSQ_SOURCE_LINE 00001451 "   my @red_balls = extract_by { $_->color eq \"red\" } @balls;"
NSQ_SOURCE_LINE 00001452 ""
NSQ_SOURCE_LINE 00001453 "   # Now there are no red balls in the @balls array"
NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 "This function modifies a real array, unlike most of the other functions in this"
NSQ_SOURCE_LINE 00001456 "module. Because of this, it requires a real array, not just a list."
NSQ_SOURCE_LINE 00001457 ""
NSQ_SOURCE_LINE 00001458 "This function is implemented by invoking C<splice> on the array, not by"
NSQ_SOURCE_LINE 00001459 "constructing a new list and assigning it. One result of this is that weak"
NSQ_SOURCE_LINE 00001460 "references will not be disturbed."
NSQ_SOURCE_LINE 00001461 ""
NSQ_SOURCE_LINE 00001462 "   extract_by { !defined $_ } @refs;"
NSQ_SOURCE_LINE 00001463 ""
NSQ_SOURCE_LINE 00001464 "will leave weak references weakened in the C<@refs> array, whereas"
NSQ_SOURCE_LINE 00001465 ""
NSQ_SOURCE_LINE 00001466 "   @refs = grep { defined $_ } @refs;"
NSQ_SOURCE_LINE 00001467 ""
NSQ_SOURCE_LINE 00001468 "will strengthen them all again."
NSQ_SOURCE_LINE 00001469 ""
NSQ_SOURCE_LINE 00001470 "=head2 extract_first_by"
NSQ_SOURCE_LINE 00001471 ""
NSQ_SOURCE_LINE 00001472 "   $val = extract_first_by { SELECTFUNC } @arr"
NSQ_SOURCE_LINE 00001473 ""
NSQ_SOURCE_LINE 00001474 "I<Since version 0.10.>"
NSQ_SOURCE_LINE 00001475 ""
NSQ_SOURCE_LINE 00001476 "A hybrid between L</extract_by> and C<List::Util::first>. Removes the first"
NSQ_SOURCE_LINE 00001477 "element from the referenced array on which the selection function returns"
NSQ_SOURCE_LINE 00001478 "true, returning it."
NSQ_SOURCE_LINE 00001479 ""
NSQ_SOURCE_LINE 00001480 "As with L</extract_by>, this function requires a real array and not just a"
NSQ_SOURCE_LINE 00001481 "list, and is also implemented using C<splice> so that weak references are"
NSQ_SOURCE_LINE 00001482 "not disturbed."
NSQ_SOURCE_LINE 00001483 ""
NSQ_SOURCE_LINE 00001484 "If this function fails to find a matching element, it will return an empty"
NSQ_SOURCE_LINE 00001485 "list in list context. This allows a caller to distinguish the case between"
NSQ_SOURCE_LINE 00001486 "no matching element, and the first matching element being C<undef>."
NSQ_SOURCE_LINE 00001487 ""
NSQ_SOURCE_LINE 00001488 "=head2 weighted_shuffle_by"
NSQ_SOURCE_LINE 00001489 ""
NSQ_SOURCE_LINE 00001490 "   @vals = weighted_shuffle_by { WEIGHTFUNC } @vals"
NSQ_SOURCE_LINE 00001491 ""
NSQ_SOURCE_LINE 00001492 "I<Since version 0.07.>"
NSQ_SOURCE_LINE 00001493 ""
NSQ_SOURCE_LINE 00001494 "Returns the list of values shuffled into a random order. The randomisation is"
NSQ_SOURCE_LINE 00001495 "not uniform, but weighted by the value returned by the C<WEIGHTFUNC>. The"
NSQ_SOURCE_LINE 00001496 "probabilty of each item being returned first will be distributed with the"
NSQ_SOURCE_LINE 00001497 "distribution of the weights, and so on recursively for the remaining items."
NSQ_SOURCE_LINE 00001498 ""
NSQ_SOURCE_LINE 00001499 "=head2 bundle_by"
NSQ_SOURCE_LINE 00001500 ""
NSQ_SOURCE_LINE 00001501 "   @vals = bundle_by { BLOCKFUNC } $number, @vals"
NSQ_SOURCE_LINE 00001502 ""
NSQ_SOURCE_LINE 00001503 "I<Since version 0.07.>"
NSQ_SOURCE_LINE 00001504 ""
NSQ_SOURCE_LINE 00001505 "Similar to a regular C<map> functional, returns a list of the values returned"
NSQ_SOURCE_LINE 00001506 "by C<BLOCKFUNC>. Values from the input list are given to the block function in"
NSQ_SOURCE_LINE 00001507 "bundles of C<$number>."
NSQ_SOURCE_LINE 00001508 ""
NSQ_SOURCE_LINE 00001509 "If given a list of values whose length does not evenly divide by C<$number>,"
NSQ_SOURCE_LINE 00001510 "the final call will be passed fewer elements than the others."
NSQ_SOURCE_LINE 00001511 ""
NSQ_SOURCE_LINE 00001512 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00001513 ""
NSQ_SOURCE_LINE 00001514 "This module exports nothing by default. You can import functions by"
NSQ_SOURCE_LINE 00001515 "name, or get everything with the C<:all> tag."
NSQ_SOURCE_LINE 00001516 ""
NSQ_SOURCE_LINE 00001517 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001518 ""
NSQ_SOURCE_LINE 00001519 "L<List::Util>,  L<List::SomeUtils> and L<List::UtilsBy>, obviously."
NSQ_SOURCE_LINE 00001520 ""
NSQ_SOURCE_LINE 00001521 "Also see C<Util::Any>, which unifies many more util modules, and also"
NSQ_SOURCE_LINE 00001522 "lets you rename functions as part of the import."
NSQ_SOURCE_LINE 00001523 ""
NSQ_SOURCE_LINE 00001524 "=head1 BUGS"
NSQ_SOURCE_LINE 00001525 ""
NSQ_SOURCE_LINE 00001526 "Please report any bugs or feature requests to"
NSQ_SOURCE_LINE 00001527 "C<bug-list-allutils@rt.cpan.org>, or through the web interface at"
NSQ_SOURCE_LINE 00001528 "L<http://rt.cpan.org>.  I will be notified, and then you'll"
NSQ_SOURCE_LINE 00001529 "automatically be notified of progress on your bug as I make changes."
NSQ_SOURCE_LINE 00001530 ""
NSQ_SOURCE_LINE 00001531 "Bugs may be submitted at L<https://github.com/houseabsolute/List-AllUtils/issues>."
NSQ_SOURCE_LINE 00001532 ""
NSQ_SOURCE_LINE 00001533 "I am also usually active on IRC as 'autarch' on C<irc://irc.perl.org>."
NSQ_SOURCE_LINE 00001534 ""
NSQ_SOURCE_LINE 00001535 "=head1 SOURCE"
NSQ_SOURCE_LINE 00001536 ""
NSQ_SOURCE_LINE 00001537 "The source code repository for List-AllUtils can be found at L<https://github.com/houseabsolute/List-AllUtils>."
NSQ_SOURCE_LINE 00001538 ""
NSQ_SOURCE_LINE 00001539 "=head1 DONATIONS"
NSQ_SOURCE_LINE 00001540 ""
NSQ_SOURCE_LINE 00001541 "If you'd like to thank me for the work I've done on this module, please"
NSQ_SOURCE_LINE 00001542 "consider making a \"donation\" to me via PayPal. I spend a lot of free time"
NSQ_SOURCE_LINE 00001543 "creating free software, and would appreciate any support you'd care to offer."
NSQ_SOURCE_LINE 00001544 ""
NSQ_SOURCE_LINE 00001545 "Please note that B<I am not suggesting that you must do this> in order for me"
NSQ_SOURCE_LINE 00001546 "to continue working on this particular software. I will continue to do so,"
NSQ_SOURCE_LINE 00001547 "inasmuch as I have in the past, for as long as it interests me."
NSQ_SOURCE_LINE 00001548 ""
NSQ_SOURCE_LINE 00001549 "Similarly, a donation made in this way will probably not make me work on this"
NSQ_SOURCE_LINE 00001550 "software much more, unless I get so many donations that I can consider working"
NSQ_SOURCE_LINE 00001551 "on free software full time (let's all have a chuckle at that together)."
NSQ_SOURCE_LINE 00001552 ""
NSQ_SOURCE_LINE 00001553 "To donate, log into PayPal and send money to autarch@urth.org, or use the"
NSQ_SOURCE_LINE 00001554 "button at L<https://www.urth.org/fs-donation.html>."
NSQ_SOURCE_LINE 00001555 ""
