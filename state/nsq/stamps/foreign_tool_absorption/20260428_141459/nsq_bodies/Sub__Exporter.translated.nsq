BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use v5.12.0;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 "package Sub::Exporter 0.991;"
NSQ_SOURCE_LINE 00000004 "# ABSTRACT: a sophisticated exporter for custom-built routines"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Carp ();"
NSQ_SOURCE_LINE 00000007 "use Data::OptList 0.100 ();"
NSQ_SOURCE_LINE 00000008 "use Params::Util 0.14 (); # _CODELIKE"
NSQ_SOURCE_LINE 00000009 "use Sub::Install 0.92 ();"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "#pod =head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000012 "#pod"
NSQ_SOURCE_LINE 00000013 "#pod Sub::Exporter must be used in two places.  First, in an exporting module:"
NSQ_SOURCE_LINE 00000014 "#pod"
NSQ_SOURCE_LINE 00000015 "#pod   # in the exporting module:"
NSQ_SOURCE_LINE 00000016 "#pod   package Text::Tweaker;"
NSQ_SOURCE_LINE 00000017 "#pod   use Sub::Exporter -setup => {"
NSQ_SOURCE_LINE 00000018 "#pod     exports => ["
NSQ_SOURCE_LINE 00000019 "#pod       qw(squish titlecase), # always works the same way"
NSQ_SOURCE_LINE 00000020 "#pod       reformat => \\&build_reformatter, # generator to build exported function"
NSQ_SOURCE_LINE 00000021 "#pod       trim     => \\&build_trimmer,"
NSQ_SOURCE_LINE 00000022 "#pod       indent   => \\&build_indenter,"
NSQ_SOURCE_LINE 00000023 "#pod     ],"
NSQ_SOURCE_LINE 00000024 "#pod     collectors => [ 'defaults' ],"
NSQ_SOURCE_LINE 00000025 "#pod   };"
NSQ_SOURCE_LINE 00000026 "#pod"
NSQ_SOURCE_LINE 00000027 "#pod Then, in an importing module:"
NSQ_SOURCE_LINE 00000028 "#pod"
NSQ_SOURCE_LINE 00000029 "#pod   # in the importing module:"
NSQ_SOURCE_LINE 00000030 "#pod   use Text::Tweaker"
NSQ_SOURCE_LINE 00000031 "#pod     'squish',"
NSQ_SOURCE_LINE 00000032 "#pod     indent   => { margin => 5 },"
NSQ_SOURCE_LINE 00000033 "#pod     reformat => { width => 79, justify => 'full', -as => 'prettify_text' },"
NSQ_SOURCE_LINE 00000034 "#pod     defaults => { eol => 'CRLF' };"
NSQ_SOURCE_LINE 00000035 "#pod"
NSQ_SOURCE_LINE 00000036 "#pod With this setup, the importing module ends up with three routines: C<squish>,"
NSQ_SOURCE_LINE 00000037 "#pod C<indent>, and C<prettify_text>.  The latter two have been built to the"
NSQ_SOURCE_LINE 00000038 "#pod specifications of the importer -- they are not just copies of the code in the"
NSQ_SOURCE_LINE 00000039 "#pod exporting package."
NSQ_SOURCE_LINE 00000040 "#pod"
NSQ_SOURCE_LINE 00000041 "#pod =head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000042 "#pod"
NSQ_SOURCE_LINE 00000043 "#pod B<ACHTUNG!>  If you're not familiar with Exporter or exporting, read"
NSQ_SOURCE_LINE 00000044 "#pod L<Sub::Exporter::Tutorial> first!"
NSQ_SOURCE_LINE 00000045 "#pod"
NSQ_SOURCE_LINE 00000046 "#pod =head2 Why Generators?"
NSQ_SOURCE_LINE 00000047 "#pod"
NSQ_SOURCE_LINE 00000048 "#pod The biggest benefit of Sub::Exporter over existing exporters (including the"
NSQ_SOURCE_LINE 00000049 "#pod ubiquitous Exporter.pm) is its ability to build new coderefs for export, rather"
NSQ_SOURCE_LINE 00000050 "#pod than to simply export code identical to that found in the exporting package."
NSQ_SOURCE_LINE 00000051 "#pod"
NSQ_SOURCE_LINE 00000052 "#pod If your module's consumers get a routine that works like this:"
NSQ_SOURCE_LINE 00000053 "#pod"
NSQ_SOURCE_LINE 00000054 "#pod   use Data::Analyze qw(analyze);"
NSQ_SOURCE_LINE 00000055 "#pod   my $value = analyze($data, $tolerance, $passes);"
NSQ_SOURCE_LINE 00000056 "#pod"
NSQ_SOURCE_LINE 00000057 "#pod and they constantly pass only one or two different set of values for the"
NSQ_SOURCE_LINE 00000058 "#pod non-C<$data> arguments, your code can benefit from Sub::Exporter.  By writing a"
NSQ_SOURCE_LINE 00000059 "#pod simple generator, you can let them do this, instead:"
NSQ_SOURCE_LINE 00000060 "#pod"
NSQ_SOURCE_LINE 00000061 "#pod   use Data::Analyze"
NSQ_SOURCE_LINE 00000062 "#pod     analyze => { tolerance => 0.10, passes => 10, -as => analyze10 },"
NSQ_SOURCE_LINE 00000063 "#pod     analyze => { tolerance => 0.15, passes => 50, -as => analyze50 };"
NSQ_SOURCE_LINE 00000064 "#pod"
NSQ_SOURCE_LINE 00000065 "#pod   my $value = analyze10($data);"
NSQ_SOURCE_LINE 00000066 "#pod"
NSQ_SOURCE_LINE 00000067 "#pod The package with the generator for that would look something like this:"
NSQ_SOURCE_LINE 00000068 "#pod"
NSQ_SOURCE_LINE 00000069 "#pod   package Data::Analyze;"
NSQ_SOURCE_LINE 00000070 "#pod   use Sub::Exporter -setup => {"
NSQ_SOURCE_LINE 00000071 "#pod     exports => ["
NSQ_SOURCE_LINE 00000072 "#pod       analyze => \\&build_analyzer,"
NSQ_SOURCE_LINE 00000073 "#pod     ],"
NSQ_SOURCE_LINE 00000074 "#pod   };"
NSQ_SOURCE_LINE 00000075 "#pod"
NSQ_SOURCE_LINE 00000076 "#pod   sub build_analyzer {"
NSQ_SOURCE_LINE 00000077 "#pod     my ($class, $name, $arg) = @_;"
NSQ_SOURCE_LINE 00000078 "#pod"
NSQ_SOURCE_LINE 00000079 "#pod     return sub {"
NSQ_SOURCE_LINE 00000080 "#pod       my $data      = shift;"
NSQ_SOURCE_LINE 00000081 "#pod       my $tolerance = shift || $arg->{tolerance};"
NSQ_SOURCE_LINE 00000082 "#pod       my $passes    = shift || $arg->{passes};"
NSQ_SOURCE_LINE 00000083 "#pod"
NSQ_SOURCE_LINE 00000084 "#pod       analyze($data, $tolerance, $passes);"
NSQ_SOURCE_LINE 00000085 "#pod     }"
NSQ_SOURCE_LINE 00000086 "#pod   }"
NSQ_SOURCE_LINE 00000087 "#pod"
NSQ_SOURCE_LINE 00000088 "#pod Your module's user now has to do less work to benefit from it -- and remember,"
NSQ_SOURCE_LINE 00000089 "#pod you're often your own user!  Investing in customized subroutines is an"
NSQ_SOURCE_LINE 00000090 "#pod investment in future laziness."
NSQ_SOURCE_LINE 00000091 "#pod"
NSQ_SOURCE_LINE 00000092 "#pod This also avoids a common form of ugliness seen in many modules: package-level"
NSQ_SOURCE_LINE 00000093 "#pod configuration.  That is, you might have seen something like the above"
NSQ_SOURCE_LINE 00000094 "#pod implemented like so:"
NSQ_SOURCE_LINE 00000095 "#pod"
NSQ_SOURCE_LINE 00000096 "#pod   use Data::Analyze qw(analyze);"
NSQ_SOURCE_LINE 00000097 "#pod   $Data::Analyze::default_tolerance = 0.10;"
NSQ_SOURCE_LINE 00000098 "#pod   $Data::Analyze::default_passes    = 10;"
NSQ_SOURCE_LINE 00000099 "#pod"
NSQ_SOURCE_LINE 00000100 "#pod This might save time, until you have multiple modules using Data::Analyze."
NSQ_SOURCE_LINE 00000101 "#pod Because there is only one global configuration, they step on each other's toes"
NSQ_SOURCE_LINE 00000102 "#pod and your code begins to have mysterious errors."
NSQ_SOURCE_LINE 00000103 "#pod"
NSQ_SOURCE_LINE 00000104 "#pod Generators can also allow you to export class methods to be called as"
NSQ_SOURCE_LINE 00000105 "#pod subroutines:"
NSQ_SOURCE_LINE 00000106 "#pod"
NSQ_SOURCE_LINE 00000107 "#pod   package Data::Methodical;"
NSQ_SOURCE_LINE 00000108 "#pod   use Sub::Exporter -setup => { exports => { some_method => \\&_curry_class } };"
NSQ_SOURCE_LINE 00000109 "#pod"
NSQ_SOURCE_LINE 00000110 "#pod   sub _curry_class {"
NSQ_SOURCE_LINE 00000111 "#pod     my ($class, $name) = @_;"
NSQ_SOURCE_LINE 00000112 "#pod     sub { $class->$name(@_); };"
NSQ_SOURCE_LINE 00000113 "#pod   }"
NSQ_SOURCE_LINE 00000114 "#pod"
NSQ_SOURCE_LINE 00000115 "#pod Because of the way that exporters and Sub::Exporter work, any package that"
NSQ_SOURCE_LINE 00000116 "#pod inherits from Data::Methodical can inherit its exporter and override its"
NSQ_SOURCE_LINE 00000117 "#pod C<some_method>.  If a user imports C<some_method> from that package, he'll"
NSQ_SOURCE_LINE 00000118 "#pod receive a subroutine that calls the method on the subclass, rather than on"
NSQ_SOURCE_LINE 00000119 "#pod Data::Methodical itself.  Keep in mind that if you re-setup Sub::Exporter in a"
NSQ_SOURCE_LINE 00000120 "#pod package that inherits from Data::Methodical you will, of course, be entirely"
NSQ_SOURCE_LINE 00000121 "#pod replacing the exporter from Data::Methodical.  C<import> is a method, and is"
NSQ_SOURCE_LINE 00000122 "#pod hidden by the same means as any other method."
NSQ_SOURCE_LINE 00000123 "#pod"
NSQ_SOURCE_LINE 00000124 "#pod =head2 Other Customizations"
NSQ_SOURCE_LINE 00000125 "#pod"
NSQ_SOURCE_LINE 00000126 "#pod Building custom routines with generators isn't the only way that Sub::Exporters"
NSQ_SOURCE_LINE 00000127 "#pod allows the importing code to refine its use of the exported routines.  They may"
NSQ_SOURCE_LINE 00000128 "#pod also be renamed to avoid naming collisions."
NSQ_SOURCE_LINE 00000129 "#pod"
NSQ_SOURCE_LINE 00000130 "#pod Consider the following code:"
NSQ_SOURCE_LINE 00000131 "#pod"
NSQ_SOURCE_LINE 00000132 "#pod   # this program determines to which circle of Hell you will be condemned"
NSQ_SOURCE_LINE 00000133 "#pod   use Morality qw(sin virtue); # for calculating viciousness"
NSQ_SOURCE_LINE 00000134 "#pod   use Math::Trig qw(:all);     # for dealing with circles"
NSQ_SOURCE_LINE 00000135 "#pod"
NSQ_SOURCE_LINE 00000136 "#pod The programmer has inadvertently imported two C<sin> routines.  The solution,"
NSQ_SOURCE_LINE 00000137 "#pod in Exporter.pm-based modules, would be to import only one and then call the"
NSQ_SOURCE_LINE 00000138 "#pod other by its fully-qualified name.  Alternately, the importer could write a"
NSQ_SOURCE_LINE 00000139 "#pod routine that did so, or could mess about with typeglobs."
NSQ_SOURCE_LINE 00000140 "#pod"
NSQ_SOURCE_LINE 00000141 "#pod How much easier to write:"
NSQ_SOURCE_LINE 00000142 "#pod"
NSQ_SOURCE_LINE 00000143 "#pod   # this program determines to which circle of Hell you will be condemned"
NSQ_SOURCE_LINE 00000144 "#pod   use Morality qw(virtue), sin => { -as => 'offense' };"
NSQ_SOURCE_LINE 00000145 "#pod   use Math::Trig -all => { -prefix => 'trig_' };"
NSQ_SOURCE_LINE 00000146 "#pod"
NSQ_SOURCE_LINE 00000147 "#pod and to have at one's disposal C<offense> and C<trig_sin> -- not to mention"
NSQ_SOURCE_LINE 00000148 "#pod C<trig_cos> and C<trig_tan>."
NSQ_SOURCE_LINE 00000149 "#pod"
NSQ_SOURCE_LINE 00000150 "#pod =head1 EXPORTER CONFIGURATION"
NSQ_SOURCE_LINE 00000151 "#pod"
NSQ_SOURCE_LINE 00000152 "#pod You can configure an exporter for your package by using Sub::Exporter like so:"
NSQ_SOURCE_LINE 00000153 "#pod"
NSQ_SOURCE_LINE 00000154 "#pod   package Tools;"
NSQ_SOURCE_LINE 00000155 "#pod   use Sub::Exporter"
NSQ_SOURCE_LINE 00000156 "#pod     -setup => { exports => [ qw(function1 function2 function3) ] };"
NSQ_SOURCE_LINE 00000157 "#pod"
NSQ_SOURCE_LINE 00000158 "#pod This is the simplest way to use the exporter, and is basically equivalent to"
NSQ_SOURCE_LINE 00000159 "#pod this:"
NSQ_SOURCE_LINE 00000160 "#pod"
NSQ_SOURCE_LINE 00000161 "#pod   package Tools;"
NSQ_SOURCE_LINE 00000162 "#pod   use base qw(Exporter);"
NSQ_SOURCE_LINE 00000163 "#pod   our @EXPORT_OK = qw(function1 function2 function3);"
NSQ_SOURCE_LINE 00000164 "#pod"
NSQ_SOURCE_LINE 00000165 "#pod Any basic use of Sub::Exporter will look like this:"
NSQ_SOURCE_LINE 00000166 "#pod"
NSQ_SOURCE_LINE 00000167 "#pod   package Tools;"
NSQ_SOURCE_LINE 00000168 "#pod   use Sub::Exporter -setup => \\%config;"
NSQ_SOURCE_LINE 00000169 "#pod"
NSQ_SOURCE_LINE 00000170 "#pod The following keys are valid in C<%config>:"
NSQ_SOURCE_LINE 00000171 "#pod"
NSQ_SOURCE_LINE 00000172 "#pod   exports - a list of routines to provide for exporting; each routine may be"
NSQ_SOURCE_LINE 00000173 "#pod             followed by generator"
NSQ_SOURCE_LINE 00000174 "#pod   groups  - a list of groups to provide for exporting; each must be followed by"
NSQ_SOURCE_LINE 00000175 "#pod             either (a) a list of exports, possibly with arguments for each"
NSQ_SOURCE_LINE 00000176 "#pod             export, or (b) a generator"
NSQ_SOURCE_LINE 00000177 "#pod"
NSQ_SOURCE_LINE 00000178 "#pod   collectors - a list of names into which values are collected for use in"
NSQ_SOURCE_LINE 00000179 "#pod                routine generation; each name may be followed by a validator"
NSQ_SOURCE_LINE 00000180 "#pod"
NSQ_SOURCE_LINE 00000181 "#pod In addition to the basic options above, a few more advanced options may be"
NSQ_SOURCE_LINE 00000182 "#pod passed:"
NSQ_SOURCE_LINE 00000183 "#pod"
NSQ_SOURCE_LINE 00000184 "#pod   into_level - how far up the caller stack to look for a target (default 0)"
NSQ_SOURCE_LINE 00000185 "#pod   into       - an explicit target (package) into which to export routines"
NSQ_SOURCE_LINE 00000186 "#pod"
NSQ_SOURCE_LINE 00000187 "#pod In other words: Sub::Exporter installs a C<import> routine which, when called,"
NSQ_SOURCE_LINE 00000188 "#pod exports routines to the calling namespace.  The C<into> and C<into_level>"
NSQ_SOURCE_LINE 00000189 "#pod options change where those exported routines are installed."
NSQ_SOURCE_LINE 00000190 "#pod"
NSQ_SOURCE_LINE 00000191 "#pod   generator  - a callback used to produce the code that will be installed"
NSQ_SOURCE_LINE 00000192 "#pod                default: Sub::Exporter::default_generator"
NSQ_SOURCE_LINE 00000193 "#pod"
NSQ_SOURCE_LINE 00000194 "#pod   installer  - a callback used to install the code produced by the generator"
NSQ_SOURCE_LINE 00000195 "#pod                default: Sub::Exporter::default_installer"
NSQ_SOURCE_LINE 00000196 "#pod"
NSQ_SOURCE_LINE 00000197 "#pod For information on how these callbacks are used, see the documentation for"
NSQ_SOURCE_LINE 00000198 "#pod C<L</default_generator>> and C<L</default_installer>>."
NSQ_SOURCE_LINE 00000199 "#pod"
NSQ_SOURCE_LINE 00000200 "#pod =head2 Export Configuration"
NSQ_SOURCE_LINE 00000201 "#pod"
NSQ_SOURCE_LINE 00000202 "#pod The C<exports> list may be provided as an array reference or a hash reference."
NSQ_SOURCE_LINE 00000203 "#pod The list is processed in such a way that the following are equivalent:"
NSQ_SOURCE_LINE 00000204 "#pod"
NSQ_SOURCE_LINE 00000205 "#pod   { exports => [ qw(foo bar baz), quux => \\&quux_generator ] }"
NSQ_SOURCE_LINE 00000206 "#pod"
NSQ_SOURCE_LINE 00000207 "#pod   { exports =>"
NSQ_SOURCE_LINE 00000208 "#pod     { foo => undef, bar => undef, baz => undef, quux => \\&quux_generator } }"
NSQ_SOURCE_LINE 00000209 "#pod"
NSQ_SOURCE_LINE 00000210 "#pod Generators are code that return coderefs.  They are called with four"
NSQ_SOURCE_LINE 00000211 "#pod parameters:"
NSQ_SOURCE_LINE 00000212 "#pod"
NSQ_SOURCE_LINE 00000213 "#pod   $class - the class whose exporter has been called (the exporting class)"
NSQ_SOURCE_LINE 00000214 "#pod   $name  - the name of the export for which the routine is being build"
NSQ_SOURCE_LINE 00000215 "#pod  \\%arg   - the arguments passed for this export"
NSQ_SOURCE_LINE 00000216 "#pod  \\%col   - the collections for this import"
NSQ_SOURCE_LINE 00000217 "#pod"
NSQ_SOURCE_LINE 00000218 "#pod Given the configuration in the L</SYNOPSIS>, the following C<use> statement:"
NSQ_SOURCE_LINE 00000219 "#pod"
NSQ_SOURCE_LINE 00000220 "#pod   use Text::Tweaker"
NSQ_SOURCE_LINE 00000221 "#pod     reformat => { -as => 'make_narrow', width => 33 },"
NSQ_SOURCE_LINE 00000222 "#pod     defaults => { eol => 'CR' };"
NSQ_SOURCE_LINE 00000223 "#pod"
NSQ_SOURCE_LINE 00000224 "#pod would result in the following call to C<&build_reformatter>:"
NSQ_SOURCE_LINE 00000225 "#pod"
NSQ_SOURCE_LINE 00000226 "#pod   my $code = build_reformatter("
NSQ_SOURCE_LINE 00000227 "#pod     'Text::Tweaker',"
NSQ_SOURCE_LINE 00000228 "#pod     'reformat',"
NSQ_SOURCE_LINE 00000229 "#pod     { width => 33 }, # note that -as is not passed in"
NSQ_SOURCE_LINE 00000230 "#pod     { defaults => { eol => 'CR' } },"
NSQ_SOURCE_LINE 00000231 "#pod   );"
NSQ_SOURCE_LINE 00000232 "#pod"
NSQ_SOURCE_LINE 00000233 "#pod The returned coderef (C<$code>) would then be installed as C<make_narrow> in the"
NSQ_SOURCE_LINE 00000234 "#pod calling package."
NSQ_SOURCE_LINE 00000235 "#pod"
NSQ_SOURCE_LINE 00000236 "#pod Instead of providing a coderef in the configuration, a reference to a method"
NSQ_SOURCE_LINE 00000237 "#pod name may be provided.  This method will then be called on the invocant of the"
NSQ_SOURCE_LINE 00000238 "#pod C<import> method.  (In this case, we do not pass the C<$class> parameter, as it"
NSQ_SOURCE_LINE 00000239 "#pod would be redundant.)"
NSQ_SOURCE_LINE 00000240 "#pod"
NSQ_SOURCE_LINE 00000241 "#pod =head2 Group Configuration"
NSQ_SOURCE_LINE 00000242 "#pod"
NSQ_SOURCE_LINE 00000243 "#pod The C<groups> list can be passed in the same forms as C<exports>.  Groups must"
NSQ_SOURCE_LINE 00000244 "#pod have values to be meaningful, which may either list exports that make up the"
NSQ_SOURCE_LINE 00000245 "#pod group (optionally with arguments) or may provide a way to build the group."
NSQ_SOURCE_LINE 00000246 "#pod"
NSQ_SOURCE_LINE 00000247 "#pod The simpler case is the first: a group definition is a list of exports.  Here's"
NSQ_SOURCE_LINE 00000248 "#pod the example that could go in exporter in the L</SYNOPSIS>."
NSQ_SOURCE_LINE 00000249 "#pod"
NSQ_SOURCE_LINE 00000250 "#pod   groups  => {"
NSQ_SOURCE_LINE 00000251 "#pod     default    => [ qw(reformat) ],"
NSQ_SOURCE_LINE 00000252 "#pod     shorteners => [ qw(squish trim) ],"
NSQ_SOURCE_LINE 00000253 "#pod     email_safe => ["
NSQ_SOURCE_LINE 00000254 "#pod       'indent',"
NSQ_SOURCE_LINE 00000255 "#pod       reformat => { -as => 'email_format', width => 72 }"
NSQ_SOURCE_LINE 00000256 "#pod     ],"
NSQ_SOURCE_LINE 00000257 "#pod   },"
NSQ_SOURCE_LINE 00000258 "#pod"
NSQ_SOURCE_LINE 00000259 "#pod Groups are imported by specifying their name prefixed be either a dash or a"
NSQ_SOURCE_LINE 00000260 "#pod colon.  This line of code would import the C<shorteners> group:"
NSQ_SOURCE_LINE 00000261 "#pod"
NSQ_SOURCE_LINE 00000262 "#pod   use Text::Tweaker qw(-shorteners);"
NSQ_SOURCE_LINE 00000263 "#pod"
NSQ_SOURCE_LINE 00000264 "#pod Arguments passed to a group when importing are merged into the groups options"
NSQ_SOURCE_LINE 00000265 "#pod and passed to any relevant generators.  Groups can contain other groups, but"
NSQ_SOURCE_LINE 00000266 "#pod looping group structures are ignored."
NSQ_SOURCE_LINE 00000267 "#pod"
NSQ_SOURCE_LINE 00000268 "#pod The other possible value for a group definition, a coderef, allows one"
NSQ_SOURCE_LINE 00000269 "#pod generator to build several exportable routines simultaneously.  This is useful"
NSQ_SOURCE_LINE 00000270 "#pod when many routines must share enclosed lexical variables.  The coderef must"
NSQ_SOURCE_LINE 00000271 "#pod return a hash reference.  The keys will be used as export names and the values"
NSQ_SOURCE_LINE 00000272 "#pod are the subs that will be exported."
NSQ_SOURCE_LINE 00000273 "#pod"
NSQ_SOURCE_LINE 00000274 "#pod This example shows a simple use of the group generator."
NSQ_SOURCE_LINE 00000275 "#pod"
NSQ_SOURCE_LINE 00000276 "#pod   package Data::Crypto;"
NSQ_SOURCE_LINE 00000277 "#pod   use Sub::Exporter -setup => { groups => { cipher => \\&build_cipher_group } };"
NSQ_SOURCE_LINE 00000278 "#pod"
NSQ_SOURCE_LINE 00000279 "#pod   sub build_cipher_group {"
NSQ_SOURCE_LINE 00000280 "#pod     my ($class, $group, $arg) = @_;"
NSQ_SOURCE_LINE 00000281 "#pod     my ($encode, $decode) = build_codec($arg->{secret});"
NSQ_SOURCE_LINE 00000282 "#pod     return { cipher => $encode, decipher => $decode };"
NSQ_SOURCE_LINE 00000283 "#pod   }"
NSQ_SOURCE_LINE 00000284 "#pod"
NSQ_SOURCE_LINE 00000285 "#pod The C<cipher> and C<decipher> routines are built in a group because they are"
NSQ_SOURCE_LINE 00000286 "#pod built together by code which encloses their secret in their environment."
NSQ_SOURCE_LINE 00000287 "#pod"
NSQ_SOURCE_LINE 00000288 "#pod =head3 Default Groups"
NSQ_SOURCE_LINE 00000289 "#pod"
NSQ_SOURCE_LINE 00000290 "#pod If a module that uses Sub::Exporter is C<use>d with no arguments, it will try"
NSQ_SOURCE_LINE 00000291 "#pod to export the group named C<default>.  If that group has not been specifically"
NSQ_SOURCE_LINE 00000292 "#pod configured, it will be empty, and nothing will happen."
NSQ_SOURCE_LINE 00000293 "#pod"
NSQ_SOURCE_LINE 00000294 "#pod Another group is also created if not defined: C<all>.  The C<all> group"
NSQ_SOURCE_LINE 00000295 "#pod contains all the exports from the exports list."
NSQ_SOURCE_LINE 00000296 "#pod"
NSQ_SOURCE_LINE 00000297 "#pod =head2 Collector Configuration"
NSQ_SOURCE_LINE 00000298 "#pod"
NSQ_SOURCE_LINE 00000299 "#pod The C<collectors> entry in the exporter configuration gives names which, when"
NSQ_SOURCE_LINE 00000300 "#pod found in the import call, have their values collected and passed to every"
NSQ_SOURCE_LINE 00000301 "#pod generator."
NSQ_SOURCE_LINE 00000302 "#pod"
NSQ_SOURCE_LINE 00000303 "#pod For example, the C<build_analyzer> generator that we saw above could be"
NSQ_SOURCE_LINE 00000304 "#pod rewritten as:"
NSQ_SOURCE_LINE 00000305 "#pod"
NSQ_SOURCE_LINE 00000306 "#pod  sub build_analyzer {"
NSQ_SOURCE_LINE 00000307 "#pod    my ($class, $name, $arg, $col) = @_;"
NSQ_SOURCE_LINE 00000308 "#pod"
NSQ_SOURCE_LINE 00000309 "#pod    return sub {"
NSQ_SOURCE_LINE 00000310 "#pod      my $data      = shift;"
NSQ_SOURCE_LINE 00000311 "#pod      my $tolerance = shift || $arg->{tolerance} || $col->{defaults}{tolerance};"
NSQ_SOURCE_LINE 00000312 "#pod      my $passes    = shift || $arg->{passes}    || $col->{defaults}{passes};"
NSQ_SOURCE_LINE 00000313 "#pod"
NSQ_SOURCE_LINE 00000314 "#pod      analyze($data, $tolerance, $passes);"
NSQ_SOURCE_LINE 00000315 "#pod    }"
NSQ_SOURCE_LINE 00000316 "#pod  }"
NSQ_SOURCE_LINE 00000317 "#pod"
NSQ_SOURCE_LINE 00000318 "#pod That would allow the importer to specify global defaults for his imports:"
NSQ_SOURCE_LINE 00000319 "#pod"
NSQ_SOURCE_LINE 00000320 "#pod   use Data::Analyze"
NSQ_SOURCE_LINE 00000321 "#pod     'analyze',"
NSQ_SOURCE_LINE 00000322 "#pod     analyze  => { tolerance => 0.10, -as => analyze10 },"
NSQ_SOURCE_LINE 00000323 "#pod     analyze  => { tolerance => 0.15, passes => 50, -as => analyze50 },"
NSQ_SOURCE_LINE 00000324 "#pod     defaults => { passes => 10 };"
NSQ_SOURCE_LINE 00000325 "#pod"
NSQ_SOURCE_LINE 00000326 "#pod   my $A = analyze10($data);     # equivalent to analyze($data, 0.10, 10);"
NSQ_SOURCE_LINE 00000327 "#pod   my $C = analyze50($data);     # equivalent to analyze($data, 0.15, 50);"
NSQ_SOURCE_LINE 00000328 "#pod   my $B = analyze($data, 0.20); # equivalent to analyze($data, 0.20, 10);"
NSQ_SOURCE_LINE 00000329 "#pod"
NSQ_SOURCE_LINE 00000330 "#pod If values are provided in the C<collectors> list during exporter setup, they"
NSQ_SOURCE_LINE 00000331 "#pod must be code references, and are used to validate the importer's values.  The"
NSQ_SOURCE_LINE 00000332 "#pod validator is called when the collection is found, and if it returns false, an"
NSQ_SOURCE_LINE 00000333 "#pod exception is thrown.  We could ensure that no one tries to set a global data"
NSQ_SOURCE_LINE 00000334 "#pod default easily:"
NSQ_SOURCE_LINE 00000335 "#pod"
NSQ_SOURCE_LINE 00000336 "#pod   collectors => { defaults => sub { return (exists $_[0]->{data}) ? 0 : 1 } }"
NSQ_SOURCE_LINE 00000337 "#pod"
NSQ_SOURCE_LINE 00000338 "#pod Collector coderefs can also be used as hooks to perform arbitrary actions"
NSQ_SOURCE_LINE 00000339 "#pod before anything is exported."
NSQ_SOURCE_LINE 00000340 "#pod"
NSQ_SOURCE_LINE 00000341 "#pod When the coderef is called, it is passed the value of the collection and a"
NSQ_SOURCE_LINE 00000342 "#pod hashref containing the following entries:"
NSQ_SOURCE_LINE 00000343 "#pod"
NSQ_SOURCE_LINE 00000344 "#pod   name        - the name of the collector"
NSQ_SOURCE_LINE 00000345 "#pod   config      - the exporter configuration (hashref)"
NSQ_SOURCE_LINE 00000346 "#pod   import_args - the arguments passed to the exporter, sans collections (aref)"
NSQ_SOURCE_LINE 00000347 "#pod   class       - the package on which the importer was called"
NSQ_SOURCE_LINE 00000348 "#pod   into        - the package into which exports will be exported"
NSQ_SOURCE_LINE 00000349 "#pod"
NSQ_SOURCE_LINE 00000350 "#pod Collectors with all-caps names (that is, made up of underscore or capital A"
NSQ_SOURCE_LINE 00000351 "#pod through Z) are reserved for special use.  The only currently implemented"
NSQ_SOURCE_LINE 00000352 "#pod special collector is C<INIT>, whose hook (if present in the exporter"
NSQ_SOURCE_LINE 00000353 "#pod configuration) is always run before any other hook."
NSQ_SOURCE_LINE 00000354 "#pod"
NSQ_SOURCE_LINE 00000355 "#pod =head1 CALLING THE EXPORTER"
NSQ_SOURCE_LINE 00000356 "#pod"
NSQ_SOURCE_LINE 00000357 "#pod Arguments to the exporter (that is, the arguments after the module name in a"
NSQ_SOURCE_LINE 00000358 "#pod C<use> statement) are parsed as follows:"
NSQ_SOURCE_LINE 00000359 "#pod"
NSQ_SOURCE_LINE 00000360 "#pod First, the collectors gather any collections found in the arguments.  Any"
NSQ_SOURCE_LINE 00000361 "#pod reference type may be given as the value for a collector.  For each collection"
NSQ_SOURCE_LINE 00000362 "#pod given in the arguments, its validator (if any) is called."
NSQ_SOURCE_LINE 00000363 "#pod"
NSQ_SOURCE_LINE 00000364 "#pod Next, groups are expanded.  If the group is implemented by a group generator,"
NSQ_SOURCE_LINE 00000365 "#pod the generator is called.  There are two special arguments which, if given to a"
NSQ_SOURCE_LINE 00000366 "#pod group, have special meaning:"
NSQ_SOURCE_LINE 00000367 "#pod"
NSQ_SOURCE_LINE 00000368 "#pod   -prefix - a string to prepend to any export imported from this group"
NSQ_SOURCE_LINE 00000369 "#pod   -suffix - a string to append to any export imported from this group"
NSQ_SOURCE_LINE 00000370 "#pod"
NSQ_SOURCE_LINE 00000371 "#pod Finally, individual export generators are called and all subs, generated or"
NSQ_SOURCE_LINE 00000372 "#pod otherwise, are installed in the calling package.  There is only one special"
NSQ_SOURCE_LINE 00000373 "#pod argument for export generators:"
NSQ_SOURCE_LINE 00000374 "#pod"
NSQ_SOURCE_LINE 00000375 "#pod   -as     - where to install the exported sub"
NSQ_SOURCE_LINE 00000376 "#pod"
NSQ_SOURCE_LINE 00000377 "#pod Normally, C<-as> will contain an alternate name for the routine.  It may,"
NSQ_SOURCE_LINE 00000378 "#pod however, contain a reference to a scalar.  If that is the case, a reference the"
NSQ_SOURCE_LINE 00000379 "#pod generated routine will be placed in the scalar referenced by C<-as>.  It will"
NSQ_SOURCE_LINE 00000380 "#pod not be installed into the calling package."
NSQ_SOURCE_LINE 00000381 "#pod"
NSQ_SOURCE_LINE 00000382 "#pod =head2 Special Exporter Arguments"
NSQ_SOURCE_LINE 00000383 "#pod"
NSQ_SOURCE_LINE 00000384 "#pod The generated exporter accept some special options, which may be passed as the"
NSQ_SOURCE_LINE 00000385 "#pod first argument, in a hashref."
NSQ_SOURCE_LINE 00000386 "#pod"
NSQ_SOURCE_LINE 00000387 "#pod These options are:"
NSQ_SOURCE_LINE 00000388 "#pod"
NSQ_SOURCE_LINE 00000389 "#pod   into_level"
NSQ_SOURCE_LINE 00000390 "#pod   into"
NSQ_SOURCE_LINE 00000391 "#pod   generator"
NSQ_SOURCE_LINE 00000392 "#pod   installer"
NSQ_SOURCE_LINE 00000393 "#pod"
NSQ_SOURCE_LINE 00000394 "#pod These override the same-named configuration options described in L</EXPORTER"
NSQ_SOURCE_LINE 00000395 "#pod CONFIGURATION>."
NSQ_SOURCE_LINE 00000396 "#pod"
NSQ_SOURCE_LINE 00000397 "#pod =cut"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "# Given a potential import name, this returns the group name -- if it's got a"
NSQ_SOURCE_LINE 00000400 "# group prefix."
NSQ_SOURCE_LINE 00000401 "sub _group_name {"
NSQ_SOURCE_LINE 00000402 "  my ($name) = @_;"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "  return if (index q{-:}, (substr $name, 0, 1)) == -1;"
NSQ_SOURCE_LINE 00000405 "  return substr $name, 1;"
NSQ_SOURCE_LINE 00000406 "}"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "# \\@groups is a canonicalized opt list of exports and groups this returns"
NSQ_SOURCE_LINE 00000409 "# another canonicalized opt list with groups replaced with relevant exports."
NSQ_SOURCE_LINE 00000410 "# \\%seen is groups we've already expanded and can ignore."
NSQ_SOURCE_LINE 00000411 "# \\%merge is merged options from the group we're descending through."
NSQ_SOURCE_LINE 00000412 "sub _expand_groups {"
NSQ_SOURCE_LINE 00000413 "  my ($class, $config, $groups, $collection, $seen, $merge) = @_;"
NSQ_SOURCE_LINE 00000414 "  $seen  ||= {};"
NSQ_SOURCE_LINE 00000415 "  $merge ||= {};"
NSQ_SOURCE_LINE 00000416 "  my @groups = @$groups;"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "  for my $i (reverse 0 .. $#groups) {"
NSQ_SOURCE_LINE 00000419 "    if (my $group_name = _group_name($groups[$i][0])) {"
NSQ_SOURCE_LINE 00000420 "      my $seen = { %$seen }; # faux-dynamic scoping"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "      splice @groups, $i, 1,"
NSQ_SOURCE_LINE 00000423 "        _expand_group($class, $config, $groups[$i], $collection, $seen, $merge);"
NSQ_SOURCE_LINE 00000424 "    } else {"
NSQ_SOURCE_LINE 00000425 "      # there's nothing to munge in this export's args"
NSQ_SOURCE_LINE 00000426 "      next unless my %merge = %$merge;"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "      # we have things to merge in; do so"
NSQ_SOURCE_LINE 00000429 "      my $prefix = (delete $merge{-prefix}) || '';"
NSQ_SOURCE_LINE 00000430 "      my $suffix = (delete $merge{-suffix}) || '';"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "      if ("
NSQ_SOURCE_LINE 00000433 "        Params::Util::_CODELIKE($groups[$i][1]) ## no critic Private"
NSQ_SOURCE_LINE 00000434 "        or"
NSQ_SOURCE_LINE 00000435 "        Params::Util::_SCALAR0($groups[$i][1]) ## no critic Private"
NSQ_SOURCE_LINE 00000436 "      ) {"
NSQ_SOURCE_LINE 00000437 "        # this entry was build by a group generator"
NSQ_SOURCE_LINE 00000438 "        $groups[$i][0] = $prefix . $groups[$i][0] . $suffix;"
NSQ_SOURCE_LINE 00000439 "      } else {"
NSQ_SOURCE_LINE 00000440 "        my $as"
NSQ_SOURCE_LINE 00000441 "          = ref $groups[$i][1]{-as} ? $groups[$i][1]{-as}"
NSQ_SOURCE_LINE 00000442 "          :     $groups[$i][1]{-as} ? $prefix . $groups[$i][1]{-as} . $suffix"
NSQ_SOURCE_LINE 00000443 "          :                           $prefix . $groups[$i][0]      . $suffix;"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "        $groups[$i][1] = { %{ $groups[$i][1] }, %merge, -as => $as };"
NSQ_SOURCE_LINE 00000446 "      }"
NSQ_SOURCE_LINE 00000447 "    }"
NSQ_SOURCE_LINE 00000448 "  }"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "  return \\@groups;"
NSQ_SOURCE_LINE 00000451 "}"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "# \\@group is a name/value pair from an opt list."
NSQ_SOURCE_LINE 00000454 "sub _expand_group {"
NSQ_SOURCE_LINE 00000455 "  my ($class, $config, $group, $collection, $seen, $merge) = @_;"
NSQ_SOURCE_LINE 00000456 "  $merge ||= {};"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "  my ($group_name, $group_arg) = @$group;"
NSQ_SOURCE_LINE 00000459 "  $group_name = _group_name($group_name);"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "  Carp::croak qq(group \"$group_name\" is not exported by the $class module)"
NSQ_SOURCE_LINE 00000462 "    unless exists $config->{groups}{$group_name};"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "  return if $seen->{$group_name}++;"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "  if (ref $group_arg) {"
NSQ_SOURCE_LINE 00000467 "    my $prefix = (delete $merge->{-prefix}||'') . ($group_arg->{-prefix}||'');"
NSQ_SOURCE_LINE 00000468 "    my $suffix = ($group_arg->{-suffix}||'') . (delete $merge->{-suffix}||'');"
NSQ_SOURCE_LINE 00000469 "    $merge = {"
NSQ_SOURCE_LINE 00000470 "      %$merge,"
NSQ_SOURCE_LINE 00000471 "      %$group_arg,"
NSQ_SOURCE_LINE 00000472 "      ($prefix ? (-prefix => $prefix) : ()),"
NSQ_SOURCE_LINE 00000473 "      ($suffix ? (-suffix => $suffix) : ()),"
NSQ_SOURCE_LINE 00000474 "    };"
NSQ_SOURCE_LINE 00000475 "  }"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "  my $exports = $config->{groups}{$group_name};"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "  if ("
NSQ_SOURCE_LINE 00000480 "    Params::Util::_CODELIKE($exports) ## no critic Private"
NSQ_SOURCE_LINE 00000481 "    or"
NSQ_SOURCE_LINE 00000482 "    Params::Util::_SCALAR0($exports) ## no critic Private"
NSQ_SOURCE_LINE 00000483 "  ) {"
NSQ_SOURCE_LINE 00000484 "    # I'm not very happy with this code for hiding -prefix and -suffix, but"
NSQ_SOURCE_LINE 00000485 "    # it's needed, and I'm not sure, offhand, how to make it better."
NSQ_SOURCE_LINE 00000486 "    # -- rjbs, 2006-12-05"
NSQ_SOURCE_LINE 00000487 "    my $group_arg = $merge ? { %$merge } : {};"
NSQ_SOURCE_LINE 00000488 "    delete $group_arg->{-prefix};"
NSQ_SOURCE_LINE 00000489 "    delete $group_arg->{-suffix};"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "    my $group = Params::Util::_CODELIKE($exports) ## no critic Private"
NSQ_SOURCE_LINE 00000492 "              ? $exports->($class, $group_name, $group_arg, $collection)"
NSQ_SOURCE_LINE 00000493 "              : $class->$$exports($group_name, $group_arg, $collection);"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "    Carp::croak qq(group generator \"$group_name\" did not return a hashref)"
NSQ_SOURCE_LINE 00000496 "      if ref $group ne 'HASH';"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "    my $stuff = [ map { [ $_ => $group->{$_} ] } keys %$group ];"
NSQ_SOURCE_LINE 00000499 "    return @{"
NSQ_SOURCE_LINE 00000500 "      _expand_groups($class, $config, $stuff, $collection, $seen, $merge)"
NSQ_SOURCE_LINE 00000501 "    };"
NSQ_SOURCE_LINE 00000502 "  } else {"
NSQ_SOURCE_LINE 00000503 "    $exports"
NSQ_SOURCE_LINE 00000504 "      = Data::OptList::mkopt($exports, \"$group_name exports\");"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "    return @{"
NSQ_SOURCE_LINE 00000507 "      _expand_groups($class, $config, $exports, $collection, $seen, $merge)"
NSQ_SOURCE_LINE 00000508 "    };"
NSQ_SOURCE_LINE 00000509 "  }"
NSQ_SOURCE_LINE 00000510 "}"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "sub _mk_collection_builder {"
NSQ_SOURCE_LINE 00000513 "  my ($col, $etc) = @_;"
NSQ_SOURCE_LINE 00000514 "  my ($config, $import_args, $class, $into) = @$etc;"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "  my %seen;"
NSQ_SOURCE_LINE 00000517 "  sub {"
NSQ_SOURCE_LINE 00000518 "    my ($collection) = @_;"
NSQ_SOURCE_LINE 00000519 "    my ($name, $value) = @$collection;"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "    Carp::croak \"collection $name provided multiple times in import\""
NSQ_SOURCE_LINE 00000522 "      if $seen{ $name }++;"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "    if (ref(my $hook = $config->{collectors}{$name})) {"
NSQ_SOURCE_LINE 00000525 "      my $arg = {"
NSQ_SOURCE_LINE 00000526 "        name        => $name,"
NSQ_SOURCE_LINE 00000527 "        config      => $config,"
NSQ_SOURCE_LINE 00000528 "        import_args => $import_args,"
NSQ_SOURCE_LINE 00000529 "        class       => $class,"
NSQ_SOURCE_LINE 00000530 "        into        => $into,"
NSQ_SOURCE_LINE 00000531 "      };"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "      my $error_msg = \"collection $name failed validation\";"
NSQ_SOURCE_LINE 00000534 "      if (Params::Util::_SCALAR0($hook)) { ## no critic Private"
NSQ_SOURCE_LINE 00000535 "        Carp::croak $error_msg unless $class->$$hook($value, $arg);"
NSQ_SOURCE_LINE 00000536 "      } else {"
NSQ_SOURCE_LINE 00000537 "        Carp::croak $error_msg unless $hook->($value, $arg);"
NSQ_SOURCE_LINE 00000538 "      }"
NSQ_SOURCE_LINE 00000539 "    }"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "    $col->{ $name } = $value;"
NSQ_SOURCE_LINE 00000542 "  }"
NSQ_SOURCE_LINE 00000543 "}"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "# Given a config and pre-canonicalized importer args, remove collections from"
NSQ_SOURCE_LINE 00000546 "# the args and return them."
NSQ_SOURCE_LINE 00000547 "sub _collect_collections {"
NSQ_SOURCE_LINE 00000548 "  my ($config, $import_args, $class, $into) = @_;"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "  my @collections"
NSQ_SOURCE_LINE 00000551 "    = map  { splice @$import_args, $_, 1 }"
NSQ_SOURCE_LINE 00000552 "      grep { exists $config->{collectors}{ $import_args->[$_][0] } }"
NSQ_SOURCE_LINE 00000553 "      reverse 0 .. $#$import_args;"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "  unshift @collections, [ INIT => {} ] if $config->{collectors}{INIT};"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "  my $col = {};"
NSQ_SOURCE_LINE 00000558 "  my $builder = _mk_collection_builder($col, \\@_);"
NSQ_SOURCE_LINE 00000559 "  for my $collection (@collections) {"
NSQ_SOURCE_LINE 00000560 "    $builder->($collection)"
NSQ_SOURCE_LINE 00000561 "  }"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "  return $col;"
NSQ_SOURCE_LINE 00000564 "}"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "#pod =head1 SUBROUTINES"
NSQ_SOURCE_LINE 00000567 "#pod"
NSQ_SOURCE_LINE 00000568 "#pod =head2 setup_exporter"
NSQ_SOURCE_LINE 00000569 "#pod"
NSQ_SOURCE_LINE 00000570 "#pod This routine builds and installs an C<import> routine.  It is called with one"
NSQ_SOURCE_LINE 00000571 "#pod argument, a hashref containing the exporter configuration.  Using this, it"
NSQ_SOURCE_LINE 00000572 "#pod builds an exporter and installs it into the calling package with the name"
NSQ_SOURCE_LINE 00000573 "#pod \"import.\"  In addition to the normal exporter configuration, a few named"
NSQ_SOURCE_LINE 00000574 "#pod arguments may be passed in the hashref:"
NSQ_SOURCE_LINE 00000575 "#pod"
NSQ_SOURCE_LINE 00000576 "#pod   into       - into what package should the exporter be installed"
NSQ_SOURCE_LINE 00000577 "#pod   into_level - into what level up the stack should the exporter be installed"
NSQ_SOURCE_LINE 00000578 "#pod   as         - what name should the installed exporter be given"
NSQ_SOURCE_LINE 00000579 "#pod"
NSQ_SOURCE_LINE 00000580 "#pod By default the exporter is installed with the name C<import> into the immediate"
NSQ_SOURCE_LINE 00000581 "#pod caller of C<setup_exporter>.  In other words, if your package calls"
NSQ_SOURCE_LINE 00000582 "#pod C<setup_exporter> without providing any of the three above arguments, it will"
NSQ_SOURCE_LINE 00000583 "#pod have an C<import> routine installed."
NSQ_SOURCE_LINE 00000584 "#pod"
NSQ_SOURCE_LINE 00000585 "#pod Providing both C<into> and C<into_level> will cause an exception to be thrown."
NSQ_SOURCE_LINE 00000586 "#pod"
NSQ_SOURCE_LINE 00000587 "#pod The exporter is built by C<L</build_exporter>>."
NSQ_SOURCE_LINE 00000588 "#pod"
NSQ_SOURCE_LINE 00000589 "#pod =cut"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "sub setup_exporter {"
NSQ_SOURCE_LINE 00000592 "  my ($config)  = @_;"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "  Carp::croak 'into and into_level may not both be supplied to exporter'"
NSQ_SOURCE_LINE 00000595 "    if exists $config->{into} and exists $config->{into_level};"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "  my $as   = delete $config->{as}   || 'import';"
NSQ_SOURCE_LINE 00000598 "  my $into"
NSQ_SOURCE_LINE 00000599 "    = exists $config->{into}       ? delete $config->{into}"
NSQ_SOURCE_LINE 00000600 "    : exists $config->{into_level} ? caller(delete $config->{into_level})"
NSQ_SOURCE_LINE 00000601 "    :                                caller(0);"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "  my $import = build_exporter($config);"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "  Sub::Install::reinstall_sub({"
NSQ_SOURCE_LINE 00000606 "    code => $import,"
NSQ_SOURCE_LINE 00000607 "    into => $into,"
NSQ_SOURCE_LINE 00000608 "    as   => $as,"
NSQ_SOURCE_LINE 00000609 "  });"
NSQ_SOURCE_LINE 00000610 "}"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "#pod =head2 build_exporter"
NSQ_SOURCE_LINE 00000613 "#pod"
NSQ_SOURCE_LINE 00000614 "#pod Given a standard exporter configuration, this routine builds and returns an"
NSQ_SOURCE_LINE 00000615 "#pod exporter -- that is, a subroutine that can be installed as a class method to"
NSQ_SOURCE_LINE 00000616 "#pod perform exporting on request."
NSQ_SOURCE_LINE 00000617 "#pod"
NSQ_SOURCE_LINE 00000618 "#pod Usually, this method is called by C<L</setup_exporter>>, which then installs"
NSQ_SOURCE_LINE 00000619 "#pod the exporter as a package's import routine."
NSQ_SOURCE_LINE 00000620 "#pod"
NSQ_SOURCE_LINE 00000621 "#pod =cut"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "sub _key_intersection {"
NSQ_SOURCE_LINE 00000624 "  my ($x, $y) = @_;"
NSQ_SOURCE_LINE 00000625 "  my %seen = map { $_ => 1 } keys %$x;"
NSQ_SOURCE_LINE 00000626 "  my @names = grep { $seen{$_} } keys %$y;"
NSQ_SOURCE_LINE 00000627 "}"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "# Given the config passed to setup_exporter, which contains sugary opt list"
NSQ_SOURCE_LINE 00000630 "# data, rewrite the opt lists into hashes, catch a few kinds of invalid"
NSQ_SOURCE_LINE 00000631 "# configurations, and set up defaults.  Since the config is a reference, it's"
NSQ_SOURCE_LINE 00000632 "# rewritten in place."
NSQ_SOURCE_LINE 00000633 "my %valid_config_key;"
NSQ_SOURCE_LINE 00000634 "BEGIN {"
NSQ_SOURCE_LINE 00000635 "  %valid_config_key ="
NSQ_SOURCE_LINE 00000636 "    map { $_ => 1 }"
NSQ_SOURCE_LINE 00000637 "    qw(as collectors installer generator exports groups into into_level),"
NSQ_SOURCE_LINE 00000638 "    qw(exporter), # deprecated"
NSQ_SOURCE_LINE 00000639 "}"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "sub _assert_collector_names_ok {"
NSQ_SOURCE_LINE 00000642 "  my ($collectors) = @_;"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "  for my $reserved_name (grep { /\\A[_A-Z]+\\z/ } keys %$collectors) {"
NSQ_SOURCE_LINE 00000645 "    Carp::croak \"unknown reserved collector name: $reserved_name\""
NSQ_SOURCE_LINE 00000646 "      if $reserved_name ne 'INIT';"
NSQ_SOURCE_LINE 00000647 "  }"
NSQ_SOURCE_LINE 00000648 "}"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "sub _rewrite_build_config {"
NSQ_SOURCE_LINE 00000651 "  my ($config) = @_;"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "  if (my @keys = grep { not exists $valid_config_key{$_} } keys %$config) {"
NSQ_SOURCE_LINE 00000654 "    Carp::croak \"unknown options (@keys) passed to Sub::Exporter\";"
NSQ_SOURCE_LINE 00000655 "  }"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "  Carp::croak q(into and into_level may not both be supplied to exporter)"
NSQ_SOURCE_LINE 00000658 "    if exists $config->{into} and exists $config->{into_level};"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "  # XXX: Remove after deprecation period."
NSQ_SOURCE_LINE 00000661 "  if ($config->{exporter}) {"
NSQ_SOURCE_LINE 00000662 "    Carp::cluck \"'exporter' argument to build_exporter is deprecated. Use 'installer' instead; the semantics are identical.\";"
NSQ_SOURCE_LINE 00000663 "    $config->{installer} = delete $config->{exporter};"
NSQ_SOURCE_LINE 00000664 "  }"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "  Carp::croak q(into and into_level may not both be supplied to exporter)"
NSQ_SOURCE_LINE 00000667 "    if exists $config->{into} and exists $config->{into_level};"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "  for (qw(exports collectors)) {"
NSQ_SOURCE_LINE 00000670 "    $config->{$_} = Data::OptList::mkopt_hash("
NSQ_SOURCE_LINE 00000671 "      $config->{$_},"
NSQ_SOURCE_LINE 00000672 "      $_,"
NSQ_SOURCE_LINE 00000673 "      [ 'CODE', 'SCALAR' ],"
NSQ_SOURCE_LINE 00000674 "    );"
NSQ_SOURCE_LINE 00000675 "  }"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "  _assert_collector_names_ok($config->{collectors});"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "  if (my @names = _key_intersection(@$config{qw(exports collectors)})) {"
NSQ_SOURCE_LINE 00000680 "    Carp::croak \"names (@names) used in both collections and exports\";"
NSQ_SOURCE_LINE 00000681 "  }"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "  $config->{groups} = Data::OptList::mkopt_hash("
NSQ_SOURCE_LINE 00000684 "      $config->{groups},"
NSQ_SOURCE_LINE 00000685 "      'groups',"
NSQ_SOURCE_LINE 00000686 "      ["
NSQ_SOURCE_LINE 00000687 "        'HASH',   # standard opt list"
NSQ_SOURCE_LINE 00000688 "        'ARRAY',  # standard opt list"
NSQ_SOURCE_LINE 00000689 "        'CODE',   # group generator"
NSQ_SOURCE_LINE 00000690 "        'SCALAR', # name of group generation method"
NSQ_SOURCE_LINE 00000691 "      ]"
NSQ_SOURCE_LINE 00000692 "    );"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "  # by default, export nothing"
NSQ_SOURCE_LINE 00000695 "  $config->{groups}{default} ||= [];"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "  # by default, build an all-inclusive 'all' group"
NSQ_SOURCE_LINE 00000698 "  $config->{groups}{all} ||= [ keys %{ $config->{exports} } ];"
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "  $config->{generator} ||= \\&default_generator;"
NSQ_SOURCE_LINE 00000701 "  $config->{installer} ||= \\&default_installer;"
NSQ_SOURCE_LINE 00000702 "}"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "sub build_exporter {"
NSQ_SOURCE_LINE 00000705 "  my ($config) = @_;"
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "  _rewrite_build_config($config);"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "  my $import = sub {"
NSQ_SOURCE_LINE 00000710 "    my ($class) = shift;"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "    # XXX: clean this up -- rjbs, 2006-03-16"
NSQ_SOURCE_LINE 00000713 "    my $special = (ref $_[0]) ? shift(@_) : {};"
NSQ_SOURCE_LINE 00000714 "    Carp::croak q(into and into_level may not both be supplied to exporter)"
NSQ_SOURCE_LINE 00000715 "      if exists $special->{into} and exists $special->{into_level};"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "    if ($special->{exporter}) {"
NSQ_SOURCE_LINE 00000718 "      Carp::cluck \"'exporter' special import argument is deprecated. Use 'installer' instead; the semantics are identical.\";"
NSQ_SOURCE_LINE 00000719 "      $special->{installer} = delete $special->{exporter};"
NSQ_SOURCE_LINE 00000720 "    }"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "    my $into"
NSQ_SOURCE_LINE 00000723 "      = defined $special->{into}       ? delete $special->{into}"
NSQ_SOURCE_LINE 00000724 "      : defined $special->{into_level} ? caller(delete $special->{into_level})"
NSQ_SOURCE_LINE 00000725 "      : defined $config->{into}        ? $config->{into}"
NSQ_SOURCE_LINE 00000726 "      : defined $config->{into_level}  ? caller($config->{into_level})"
NSQ_SOURCE_LINE 00000727 "      :                                  caller(0);"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "    my $generator = delete $special->{generator} || $config->{generator};"
NSQ_SOURCE_LINE 00000730 "    my $installer = delete $special->{installer} || $config->{installer};"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "    # this builds a AOA, where the inner arrays are [ name => value_ref ]"
NSQ_SOURCE_LINE 00000733 "    my $import_args = Data::OptList::mkopt([ @_ ]);"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "    # is this right?  defaults first or collectors first? -- rjbs, 2006-06-24"
NSQ_SOURCE_LINE 00000736 "    $import_args = [ [ -default => undef ] ] unless @$import_args;"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "    my $collection = _collect_collections($config, $import_args, $class, $into);"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "    my $to_import = _expand_groups($class, $config, $import_args, $collection);"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "    # now, finally $import_arg is really the \"to do\" list"
NSQ_SOURCE_LINE 00000743 "    _do_import("
NSQ_SOURCE_LINE 00000744 "      {"
NSQ_SOURCE_LINE 00000745 "        class     => $class,"
NSQ_SOURCE_LINE 00000746 "        col       => $collection,"
NSQ_SOURCE_LINE 00000747 "        config    => $config,"
NSQ_SOURCE_LINE 00000748 "        into      => $into,"
NSQ_SOURCE_LINE 00000749 "        generator => $generator,"
NSQ_SOURCE_LINE 00000750 "        installer => $installer,"
NSQ_SOURCE_LINE 00000751 "      },"
NSQ_SOURCE_LINE 00000752 "      $to_import,"
NSQ_SOURCE_LINE 00000753 "    );"
NSQ_SOURCE_LINE 00000754 "  };"
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "  return $import;"
NSQ_SOURCE_LINE 00000757 "}"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "sub _do_import {"
NSQ_SOURCE_LINE 00000760 "  my ($arg, $to_import) = @_;"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "  my @todo;"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "  for my $pair (@$to_import) {"
NSQ_SOURCE_LINE 00000765 "    my ($name, $import_arg) = @$pair;"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "    my ($generator, $as);"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "    if ($import_arg and Params::Util::_CODELIKE($import_arg)) { ## no critic"
NSQ_SOURCE_LINE 00000770 "      # This is the case when a group generator has inserted name/code pairs."
NSQ_SOURCE_LINE 00000771 "      $generator = sub { $import_arg };"
NSQ_SOURCE_LINE 00000772 "      $as = $name;"
NSQ_SOURCE_LINE 00000773 "    } else {"
NSQ_SOURCE_LINE 00000774 "      $import_arg = { $import_arg ? %$import_arg : () };"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "      Carp::croak qq(\"$name\" is not exported by the $arg->{class} module)"
NSQ_SOURCE_LINE 00000777 "        unless exists $arg->{config}{exports}{$name};"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "      $generator = $arg->{config}{exports}{$name};"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "      $as = exists $import_arg->{-as} ? (delete $import_arg->{-as}) : $name;"
NSQ_SOURCE_LINE 00000782 "    }"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "    my $code = $arg->{generator}->("
NSQ_SOURCE_LINE 00000785 "      {"
NSQ_SOURCE_LINE 00000786 "        class     => $arg->{class},"
NSQ_SOURCE_LINE 00000787 "        name      => $name,"
NSQ_SOURCE_LINE 00000788 "        arg       => $import_arg,"
NSQ_SOURCE_LINE 00000789 "        col       => $arg->{col},"
NSQ_SOURCE_LINE 00000790 "        generator => $generator,"
NSQ_SOURCE_LINE 00000791 "      }"
NSQ_SOURCE_LINE 00000792 "    );"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "    push @todo, $as, $code;"
NSQ_SOURCE_LINE 00000795 "  }"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "  $arg->{installer}->("
NSQ_SOURCE_LINE 00000798 "    {"
NSQ_SOURCE_LINE 00000799 "      class => $arg->{class},"
NSQ_SOURCE_LINE 00000800 "      into  => $arg->{into},"
NSQ_SOURCE_LINE 00000801 "      col   => $arg->{col},"
NSQ_SOURCE_LINE 00000802 "    },"
NSQ_SOURCE_LINE 00000803 "    \\@todo,"
NSQ_SOURCE_LINE 00000804 "  );"
NSQ_SOURCE_LINE 00000805 "}"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "## Cute idea, possibly for future use: also supply an \"unimport\" for:"
NSQ_SOURCE_LINE 00000808 "## no Module::Whatever qw(arg arg arg);"
NSQ_SOURCE_LINE 00000809 "# sub _unexport {"
NSQ_SOURCE_LINE 00000810 "#   my (undef, undef, undef, undef, undef, $as, $into) = @_;"
NSQ_SOURCE_LINE 00000811 "#"
NSQ_SOURCE_LINE 00000812 "#   if (ref $as eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000813 "#     undef $$as;"
NSQ_SOURCE_LINE 00000814 "#   } elsif (ref $as) {"
NSQ_SOURCE_LINE 00000815 "#     Carp::croak \"invalid reference type for $as: \" . ref $as;"
NSQ_SOURCE_LINE 00000816 "#   } else {"
NSQ_SOURCE_LINE 00000817 "#     no strict 'refs';"
NSQ_SOURCE_LINE 00000818 "#     delete &{$into . '::' . $as};"
NSQ_SOURCE_LINE 00000819 "#   }"
NSQ_SOURCE_LINE 00000820 "# }"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "#pod =head2 default_generator"
NSQ_SOURCE_LINE 00000823 "#pod"
NSQ_SOURCE_LINE 00000824 "#pod This is Sub::Exporter's default generator.  It takes bits of configuration that"
NSQ_SOURCE_LINE 00000825 "#pod have been gathered during the import and turns them into a coderef that can be"
NSQ_SOURCE_LINE 00000826 "#pod installed."
NSQ_SOURCE_LINE 00000827 "#pod"
NSQ_SOURCE_LINE 00000828 "#pod   my $code = default_generator(\\%arg);"
NSQ_SOURCE_LINE 00000829 "#pod"
NSQ_SOURCE_LINE 00000830 "#pod Passed arguments are:"
NSQ_SOURCE_LINE 00000831 "#pod"
NSQ_SOURCE_LINE 00000832 "#pod   class - the class on which the import method was called"
NSQ_SOURCE_LINE 00000833 "#pod   name  - the name of the export being generated"
NSQ_SOURCE_LINE 00000834 "#pod   arg   - the arguments to the generator"
NSQ_SOURCE_LINE 00000835 "#pod   col   - the collections"
NSQ_SOURCE_LINE 00000836 "#pod"
NSQ_SOURCE_LINE 00000837 "#pod   generator - the generator to be used to build the export (code or scalar ref)"
NSQ_SOURCE_LINE 00000838 "#pod"
NSQ_SOURCE_LINE 00000839 "#pod =cut"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "sub default_generator {"
NSQ_SOURCE_LINE 00000842 "  my ($arg) = @_;"
NSQ_SOURCE_LINE 00000843 "  my ($class, $name, $generator) = @$arg{qw(class name generator)};"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "  if (not defined $generator) {"
NSQ_SOURCE_LINE 00000846 "    my $code = $class->can($name)"
NSQ_SOURCE_LINE 00000847 "      or Carp::croak \"can't locate exported subroutine $name via $class\";"
NSQ_SOURCE_LINE 00000848 "    return $code;"
NSQ_SOURCE_LINE 00000849 "  }"
NSQ_SOURCE_LINE 00000850 ""
NSQ_SOURCE_LINE 00000851 "  # I considered making this \"$class->$generator(\" but it seems that"
NSQ_SOURCE_LINE 00000852 "  # overloading precedence would turn an overloaded-as-code generator object"
NSQ_SOURCE_LINE 00000853 "  # into a string before code. -- rjbs, 2006-06-11"
NSQ_SOURCE_LINE 00000854 "  return $generator->($class, $name, $arg->{arg}, $arg->{col})"
NSQ_SOURCE_LINE 00000855 "    if Params::Util::_CODELIKE($generator); ## no critic Private"
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "  # This \"must\" be a scalar reference, to a generator method name."
NSQ_SOURCE_LINE 00000858 "  # -- rjbs, 2006-12-05"
NSQ_SOURCE_LINE 00000859 "  return $class->$$generator($name, $arg->{arg}, $arg->{col});"
NSQ_SOURCE_LINE 00000860 "}"
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "#pod =head2 default_installer"
NSQ_SOURCE_LINE 00000863 "#pod"
NSQ_SOURCE_LINE 00000864 "#pod This is Sub::Exporter's default installer.  It does what Sub::Exporter"
NSQ_SOURCE_LINE 00000865 "#pod promises: it installs code into the target package."
NSQ_SOURCE_LINE 00000866 "#pod"
NSQ_SOURCE_LINE 00000867 "#pod   default_installer(\\%arg, \\@to_export);"
NSQ_SOURCE_LINE 00000868 "#pod"
NSQ_SOURCE_LINE 00000869 "#pod Passed arguments are:"
NSQ_SOURCE_LINE 00000870 "#pod"
NSQ_SOURCE_LINE 00000871 "#pod   into - the package into which exports should be delivered"
NSQ_SOURCE_LINE 00000872 "#pod"
NSQ_SOURCE_LINE 00000873 "#pod C<@to_export> is a list of name/value pairs.  The default exporter assigns code"
NSQ_SOURCE_LINE 00000874 "#pod (the values) to named slots (the names) in the given package.  If the name is a"
NSQ_SOURCE_LINE 00000875 "#pod scalar reference, the scalar reference is made to point to the code reference"
NSQ_SOURCE_LINE 00000876 "#pod instead."
NSQ_SOURCE_LINE 00000877 "#pod"
NSQ_SOURCE_LINE 00000878 "#pod =cut"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "sub default_installer {"
NSQ_SOURCE_LINE 00000881 "  my ($arg, $to_export) = @_;"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "  for (my $i = 0; $i < @$to_export; $i += 2) {"
NSQ_SOURCE_LINE 00000884 "    my ($as, $code) = @$to_export[ $i, $i+1 ];"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "    # Allow as isa ARRAY to push onto an array?"
NSQ_SOURCE_LINE 00000887 "    # Allow into isa HASH to install name=>code into hash?"
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "    if (ref $as eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000890 "      $$as = $code;"
NSQ_SOURCE_LINE 00000891 "    } elsif (ref $as) {"
NSQ_SOURCE_LINE 00000892 "      Carp::croak \"invalid reference type for $as: \" . ref $as;"
NSQ_SOURCE_LINE 00000893 "    } else {"
NSQ_SOURCE_LINE 00000894 "      Sub::Install::reinstall_sub({"
NSQ_SOURCE_LINE 00000895 "        code => $code,"
NSQ_SOURCE_LINE 00000896 "        into => $arg->{into},"
NSQ_SOURCE_LINE 00000897 "        as   => $as"
NSQ_SOURCE_LINE 00000898 "      });"
NSQ_SOURCE_LINE 00000899 "    }"
NSQ_SOURCE_LINE 00000900 "  }"
NSQ_SOURCE_LINE 00000901 "}"
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "sub default_exporter {"
NSQ_SOURCE_LINE 00000904 "  Carp::cluck \"default_exporter is deprecated; call default_installer instead; the semantics are identical\";"
NSQ_SOURCE_LINE 00000905 "  goto &default_installer;"
NSQ_SOURCE_LINE 00000906 "}"
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "#pod =head1 EXPORTS"
NSQ_SOURCE_LINE 00000909 "#pod"
NSQ_SOURCE_LINE 00000910 "#pod Sub::Exporter also offers its own exports: the C<setup_exporter> and"
NSQ_SOURCE_LINE 00000911 "#pod C<build_exporter> routines described above.  It also provides a special \"setup\""
NSQ_SOURCE_LINE 00000912 "#pod collector, which will set up an exporter using the parameters passed to it."
NSQ_SOURCE_LINE 00000913 "#pod"
NSQ_SOURCE_LINE 00000914 "#pod Note that the \"setup\" collector (seen in examples like the L</SYNOPSIS> above)"
NSQ_SOURCE_LINE 00000915 "#pod uses C<build_exporter>, not C<setup_exporter>.  This means that the special"
NSQ_SOURCE_LINE 00000916 "#pod arguments like \"into\" and \"as\" for C<setup_exporter> are not accepted here."
NSQ_SOURCE_LINE 00000917 "#pod Instead, you may write something like:"
NSQ_SOURCE_LINE 00000918 "#pod"
NSQ_SOURCE_LINE 00000919 "#pod   use Sub::Exporter"
NSQ_SOURCE_LINE 00000920 "#pod     { into => 'Target::Package' },"
NSQ_SOURCE_LINE 00000921 "#pod     -setup => {"
NSQ_SOURCE_LINE 00000922 "#pod       -as     => 'do_import',"
NSQ_SOURCE_LINE 00000923 "#pod       exports => [ ... ],"
NSQ_SOURCE_LINE 00000924 "#pod     }"
NSQ_SOURCE_LINE 00000925 "#pod   ;"
NSQ_SOURCE_LINE 00000926 "#pod"
NSQ_SOURCE_LINE 00000927 "#pod Finding a good reason for wanting to do this is left as an exercise for the"
NSQ_SOURCE_LINE 00000928 "#pod reader."
NSQ_SOURCE_LINE 00000929 "#pod"
NSQ_SOURCE_LINE 00000930 "#pod =cut"
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "setup_exporter({"
NSQ_SOURCE_LINE 00000933 "  exports => ["
NSQ_SOURCE_LINE 00000934 "    qw(setup_exporter build_exporter),"
NSQ_SOURCE_LINE 00000935 "    _import => sub { build_exporter($_[2]) },"
NSQ_SOURCE_LINE 00000936 "  ],"
NSQ_SOURCE_LINE 00000937 "  groups  => {"
NSQ_SOURCE_LINE 00000938 "    all   => [ qw(setup_exporter build_export) ],"
NSQ_SOURCE_LINE 00000939 "  },"
NSQ_SOURCE_LINE 00000940 "  collectors => { -setup => \\&_setup },"
NSQ_SOURCE_LINE 00000941 "});"
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "sub _setup {"
NSQ_SOURCE_LINE 00000944 "  my ($value, $arg) = @_;"
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "  if (ref $value eq 'HASH') {"
NSQ_SOURCE_LINE 00000947 "    push @{ $arg->{import_args} }, [ _import => { -as => 'import', %$value } ];"
NSQ_SOURCE_LINE 00000948 "    return 1;"
NSQ_SOURCE_LINE 00000949 "  } elsif (ref $value eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000950 "    push @{ $arg->{import_args} },"
NSQ_SOURCE_LINE 00000951 "      [ _import => { -as => 'import', exports => $value } ];"
NSQ_SOURCE_LINE 00000952 "    return 1;"
NSQ_SOURCE_LINE 00000953 "  }"
NSQ_SOURCE_LINE 00000954 "  return;"
NSQ_SOURCE_LINE 00000955 "}"
NSQ_SOURCE_LINE 00000956 ""
NSQ_SOURCE_LINE 00000957 "#pod =head1 COMPARISONS"
NSQ_SOURCE_LINE 00000958 "#pod"
NSQ_SOURCE_LINE 00000959 "#pod There are a whole mess of exporters on the CPAN.  The features included in"
NSQ_SOURCE_LINE 00000960 "#pod Sub::Exporter set it apart from any existing Exporter.  Here's a summary of"
NSQ_SOURCE_LINE 00000961 "#pod some other exporters and how they compare."
NSQ_SOURCE_LINE 00000962 "#pod"
NSQ_SOURCE_LINE 00000963 "#pod =over"
NSQ_SOURCE_LINE 00000964 "#pod"
NSQ_SOURCE_LINE 00000965 "#pod =item * L<Exporter> and co."
NSQ_SOURCE_LINE 00000966 "#pod"
NSQ_SOURCE_LINE 00000967 "#pod This is the standard Perl exporter.  Its interface is a little clunky, but it's"
NSQ_SOURCE_LINE 00000968 "#pod fast and ubiquitous.  It can do some things that Sub::Exporter can't:  it can"
NSQ_SOURCE_LINE 00000969 "#pod export things other than routines, it can import \"everything in this group"
NSQ_SOURCE_LINE 00000970 "#pod except this symbol,\" and some other more esoteric things.  These features seem"
NSQ_SOURCE_LINE 00000971 "#pod to go nearly entirely unused."
NSQ_SOURCE_LINE 00000972 "#pod"
NSQ_SOURCE_LINE 00000973 "#pod It always exports things exactly as they appear in the exporting module; it"
NSQ_SOURCE_LINE 00000974 "#pod can't rename or customize routines.  Its groups (\"tags\") can't be nested."
NSQ_SOURCE_LINE 00000975 "#pod"
NSQ_SOURCE_LINE 00000976 "#pod L<Exporter::Lite> is a whole lot like Exporter, but it does significantly less:"
NSQ_SOURCE_LINE 00000977 "#pod it supports exporting symbols, but not groups, pattern matching, or negation."
NSQ_SOURCE_LINE 00000978 "#pod"
NSQ_SOURCE_LINE 00000979 "#pod The fact that Sub::Exporter can't export symbols other than subroutines is"
NSQ_SOURCE_LINE 00000980 "#pod a good idea, not a missing feature."
NSQ_SOURCE_LINE 00000981 "#pod"
NSQ_SOURCE_LINE 00000982 "#pod For simple uses, setting up Sub::Exporter is about as easy as Exporter.  For"
NSQ_SOURCE_LINE 00000983 "#pod complex uses, Sub::Exporter makes hard things possible, which would not be"
NSQ_SOURCE_LINE 00000984 "#pod possible with Exporter."
NSQ_SOURCE_LINE 00000985 "#pod"
NSQ_SOURCE_LINE 00000986 "#pod When using a module that uses Sub::Exporter, users familiar with Exporter will"
NSQ_SOURCE_LINE 00000987 "#pod probably see no difference in the basics.  These two lines do about the same"
NSQ_SOURCE_LINE 00000988 "#pod thing in whether the exporting module uses Exporter or Sub::Exporter."
NSQ_SOURCE_LINE 00000989 "#pod"
NSQ_SOURCE_LINE 00000990 "#pod   use Some::Module qw(foo bar baz);"
NSQ_SOURCE_LINE 00000991 "#pod   use Some::Module qw(foo :bar baz);"
NSQ_SOURCE_LINE 00000992 "#pod"
NSQ_SOURCE_LINE 00000993 "#pod The definition for exporting in Exporter.pm might look like this:"
NSQ_SOURCE_LINE 00000994 "#pod"
NSQ_SOURCE_LINE 00000995 "#pod   package Some::Module;"
NSQ_SOURCE_LINE 00000996 "#pod   use base qw(Exporter);"
NSQ_SOURCE_LINE 00000997 "#pod   our @EXPORT_OK   = qw(foo bar baz quux);"
NSQ_SOURCE_LINE 00000998 "#pod   our %EXPORT_TAGS = (bar => [ qw(bar baz) ]);"
NSQ_SOURCE_LINE 00000999 "#pod"
NSQ_SOURCE_LINE 00001000 "#pod Using Sub::Exporter, it would look like this:"
NSQ_SOURCE_LINE 00001001 "#pod"
NSQ_SOURCE_LINE 00001002 "#pod   package Some::Module;"
NSQ_SOURCE_LINE 00001003 "#pod   use Sub::Exporter -setup => {"
NSQ_SOURCE_LINE 00001004 "#pod     exports => [ qw(foo bar baz quux) ],"
NSQ_SOURCE_LINE 00001005 "#pod     groups  => { bar => [ qw(bar baz) ]}"
NSQ_SOURCE_LINE 00001006 "#pod   };"
NSQ_SOURCE_LINE 00001007 "#pod"
NSQ_SOURCE_LINE 00001008 "#pod Sub::Exporter respects inheritance, so that a package may export inherited"
NSQ_SOURCE_LINE 00001009 "#pod routines, and will export the most inherited version.  Exporting methods"
NSQ_SOURCE_LINE 00001010 "#pod without currying away the invocant is a bad idea, but Sub::Exporter allows you"
NSQ_SOURCE_LINE 00001011 "#pod to do just that -- and anyway, there are other uses for this feature, like"
NSQ_SOURCE_LINE 00001012 "#pod packages of exported subroutines which use inheritance specifically to allow"
NSQ_SOURCE_LINE 00001013 "#pod more specialized, but similar, packages."
NSQ_SOURCE_LINE 00001014 "#pod"
NSQ_SOURCE_LINE 00001015 "#pod L<Exporter::Easy> provides a wrapper around the standard Exporter.  It makes it"
NSQ_SOURCE_LINE 00001016 "#pod simpler to build groups, but doesn't provide any more functionality.  Because"
NSQ_SOURCE_LINE 00001017 "#pod it is a front-end to Exporter, it will store your exporter's configuration in"
NSQ_SOURCE_LINE 00001018 "#pod global package variables."
NSQ_SOURCE_LINE 00001019 "#pod"
NSQ_SOURCE_LINE 00001020 "#pod =item * Attribute-Based Exporters"
NSQ_SOURCE_LINE 00001021 "#pod"
NSQ_SOURCE_LINE 00001022 "#pod Some exporters use attributes to mark variables to export.  L<Exporter::Simple>"
NSQ_SOURCE_LINE 00001023 "#pod supports exporting any kind of symbol, and supports groups.  Using a module"
NSQ_SOURCE_LINE 00001024 "#pod like Exporter or Sub::Exporter, it's easy to look at one place and see what is"
NSQ_SOURCE_LINE 00001025 "#pod exported, but it's impossible to look at a variable definition and see whether"
NSQ_SOURCE_LINE 00001026 "#pod it is exported by that alone.  Exporter::Simple makes this trade in reverse:"
NSQ_SOURCE_LINE 00001027 "#pod each variable's declaration includes its export definition, but there is no one"
NSQ_SOURCE_LINE 00001028 "#pod place to look to find a manifest of exports."
NSQ_SOURCE_LINE 00001029 "#pod"
NSQ_SOURCE_LINE 00001030 "#pod More importantly, Exporter::Simple does not add any new features to those of"
NSQ_SOURCE_LINE 00001031 "#pod Exporter.  In fact, like Exporter::Easy, it is just a front-end to Exporter, so"
NSQ_SOURCE_LINE 00001032 "#pod it ends up storing its configuration in global package variables.  (This means"
NSQ_SOURCE_LINE 00001033 "#pod that there is one place to look for your exporter's manifest, actually.  You"
NSQ_SOURCE_LINE 00001034 "#pod can inspect the C<@EXPORT> package variables, and other related package"
NSQ_SOURCE_LINE 00001035 "#pod variables, at runtime.)"
NSQ_SOURCE_LINE 00001036 "#pod"
NSQ_SOURCE_LINE 00001037 "#pod L<Perl6::Export> isn't actually attribute based, but looks similar.  Its syntax"
NSQ_SOURCE_LINE 00001038 "#pod is borrowed from Perl 6, and implemented by a source filter.  It is a prototype"
NSQ_SOURCE_LINE 00001039 "#pod of an interface that is still being designed.  It should probably be avoided"
NSQ_SOURCE_LINE 00001040 "#pod for production work.  On the other hand, L<Perl6::Export::Attrs> implements"
NSQ_SOURCE_LINE 00001041 "#pod Perl 6-like exporting, but translates it into Perl 5 by providing attributes."
NSQ_SOURCE_LINE 00001042 "#pod"
NSQ_SOURCE_LINE 00001043 "#pod =item * Other Exporters"
NSQ_SOURCE_LINE 00001044 "#pod"
NSQ_SOURCE_LINE 00001045 "#pod L<Exporter::Renaming> wraps the standard Exporter to allow it to export symbols"
NSQ_SOURCE_LINE 00001046 "#pod with changed names."
NSQ_SOURCE_LINE 00001047 "#pod"
NSQ_SOURCE_LINE 00001048 "#pod L<Class::Exporter> performs a special kind of routine generation, giving each"
NSQ_SOURCE_LINE 00001049 "#pod importing package an instance of your class, and then exporting the instance's"
NSQ_SOURCE_LINE 00001050 "#pod methods as normal routines.  (Sub::Exporter, of course, can easily emulate this"
NSQ_SOURCE_LINE 00001051 "#pod behavior, as shown above.)"
NSQ_SOURCE_LINE 00001052 "#pod"
NSQ_SOURCE_LINE 00001053 "#pod L<Exporter::Tidy> implements a form of renaming (using its C<_map> argument)"
NSQ_SOURCE_LINE 00001054 "#pod and of prefixing, and implements groups.  It also avoids using package"
NSQ_SOURCE_LINE 00001055 "#pod variables for its configuration."
NSQ_SOURCE_LINE 00001056 "#pod"
NSQ_SOURCE_LINE 00001057 "#pod =back"
NSQ_SOURCE_LINE 00001058 "#pod"
NSQ_SOURCE_LINE 00001059 "#pod =head1 TODO"
NSQ_SOURCE_LINE 00001060 "#pod"
NSQ_SOURCE_LINE 00001061 "#pod =cut"
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "#pod =over"
NSQ_SOURCE_LINE 00001064 "#pod"
NSQ_SOURCE_LINE 00001065 "#pod =item * write a set of longer, more demonstrative examples"
NSQ_SOURCE_LINE 00001066 "#pod"
NSQ_SOURCE_LINE 00001067 "#pod =item * solidify the \"custom exporter\" interface (see C<&default_exporter>)"
NSQ_SOURCE_LINE 00001068 "#pod"
NSQ_SOURCE_LINE 00001069 "#pod =item * add an \"always\" group"
NSQ_SOURCE_LINE 00001070 "#pod"
NSQ_SOURCE_LINE 00001071 "#pod =back"
NSQ_SOURCE_LINE 00001072 "#pod"
NSQ_SOURCE_LINE 00001073 "#pod =head1 THANKS"
NSQ_SOURCE_LINE 00001074 "#pod"
NSQ_SOURCE_LINE 00001075 "#pod Hans Dieter Pearcey provided helpful advice while I was writing Sub::Exporter."
NSQ_SOURCE_LINE 00001076 "#pod Ian Langworth and Shawn Sorichetti asked some good questions and helped me"
NSQ_SOURCE_LINE 00001077 "#pod improve my documentation quite a bit.  Yuval Kogman helped me find a bunch of"
NSQ_SOURCE_LINE 00001078 "#pod little problems."
NSQ_SOURCE_LINE 00001079 "#pod"
NSQ_SOURCE_LINE 00001080 "#pod Thanks, friends!"
NSQ_SOURCE_LINE 00001081 "#pod"
NSQ_SOURCE_LINE 00001082 "#pod =head1 BUGS"
NSQ_SOURCE_LINE 00001083 "#pod"
NSQ_SOURCE_LINE 00001084 "#pod Please report any bugs or feature requests through the web interface at"
NSQ_SOURCE_LINE 00001085 "#pod L<http://rt.cpan.org>. I will be notified, and then you'll automatically be"
NSQ_SOURCE_LINE 00001086 "#pod notified of progress on your bug as I make changes."
NSQ_SOURCE_LINE 00001087 "#pod"
NSQ_SOURCE_LINE 00001088 "#pod =cut"
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "\"jn8:32\"; # <-- magic true value"
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "__END__"
NSQ_SOURCE_LINE 00001093 ""
NSQ_SOURCE_LINE 00001094 "=pod"
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 "=encoding UTF-8"
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "=head1 NAME"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "Sub::Exporter - a sophisticated exporter for custom-built routines"
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "=head1 VERSION"
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 "version 0.991"
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00001107 ""
NSQ_SOURCE_LINE 00001108 "Sub::Exporter must be used in two places.  First, in an exporting module:"
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "  # in the exporting module:"
NSQ_SOURCE_LINE 00001111 "  package Text::Tweaker;"
NSQ_SOURCE_LINE 00001112 "  use Sub::Exporter -setup => {"
NSQ_SOURCE_LINE 00001113 "    exports => ["
NSQ_SOURCE_LINE 00001114 "      qw(squish titlecase), # always works the same way"
NSQ_SOURCE_LINE 00001115 "      reformat => \\&build_reformatter, # generator to build exported function"
NSQ_SOURCE_LINE 00001116 "      trim     => \\&build_trimmer,"
NSQ_SOURCE_LINE 00001117 "      indent   => \\&build_indenter,"
NSQ_SOURCE_LINE 00001118 "    ],"
NSQ_SOURCE_LINE 00001119 "    collectors => [ 'defaults' ],"
NSQ_SOURCE_LINE 00001120 "  };"
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "Then, in an importing module:"
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 "  # in the importing module:"
NSQ_SOURCE_LINE 00001125 "  use Text::Tweaker"
NSQ_SOURCE_LINE 00001126 "    'squish',"
NSQ_SOURCE_LINE 00001127 "    indent   => { margin => 5 },"
NSQ_SOURCE_LINE 00001128 "    reformat => { width => 79, justify => 'full', -as => 'prettify_text' },"
NSQ_SOURCE_LINE 00001129 "    defaults => { eol => 'CRLF' };"
NSQ_SOURCE_LINE 00001130 ""
NSQ_SOURCE_LINE 00001131 "With this setup, the importing module ends up with three routines: C<squish>,"
NSQ_SOURCE_LINE 00001132 "C<indent>, and C<prettify_text>.  The latter two have been built to the"
NSQ_SOURCE_LINE 00001133 "specifications of the importer -- they are not just copies of the code in the"
NSQ_SOURCE_LINE 00001134 "exporting package."
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "B<ACHTUNG!>  If you're not familiar with Exporter or exporting, read"
NSQ_SOURCE_LINE 00001139 "L<Sub::Exporter::Tutorial> first!"
NSQ_SOURCE_LINE 00001140 ""
NSQ_SOURCE_LINE 00001141 "=head2 Why Generators?"
NSQ_SOURCE_LINE 00001142 ""
NSQ_SOURCE_LINE 00001143 "The biggest benefit of Sub::Exporter over existing exporters (including the"
NSQ_SOURCE_LINE 00001144 "ubiquitous Exporter.pm) is its ability to build new coderefs for export, rather"
NSQ_SOURCE_LINE 00001145 "than to simply export code identical to that found in the exporting package."
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 "If your module's consumers get a routine that works like this:"
NSQ_SOURCE_LINE 00001148 ""
NSQ_SOURCE_LINE 00001149 "  use Data::Analyze qw(analyze);"
NSQ_SOURCE_LINE 00001150 "  my $value = analyze($data, $tolerance, $passes);"
NSQ_SOURCE_LINE 00001151 ""
NSQ_SOURCE_LINE 00001152 "and they constantly pass only one or two different set of values for the"
NSQ_SOURCE_LINE 00001153 "non-C<$data> arguments, your code can benefit from Sub::Exporter.  By writing a"
NSQ_SOURCE_LINE 00001154 "simple generator, you can let them do this, instead:"
NSQ_SOURCE_LINE 00001155 ""
NSQ_SOURCE_LINE 00001156 "  use Data::Analyze"
NSQ_SOURCE_LINE 00001157 "    analyze => { tolerance => 0.10, passes => 10, -as => analyze10 },"
NSQ_SOURCE_LINE 00001158 "    analyze => { tolerance => 0.15, passes => 50, -as => analyze50 };"
NSQ_SOURCE_LINE 00001159 ""
NSQ_SOURCE_LINE 00001160 "  my $value = analyze10($data);"
NSQ_SOURCE_LINE 00001161 ""
NSQ_SOURCE_LINE 00001162 "The package with the generator for that would look something like this:"
NSQ_SOURCE_LINE 00001163 ""
NSQ_SOURCE_LINE 00001164 "  package Data::Analyze;"
NSQ_SOURCE_LINE 00001165 "  use Sub::Exporter -setup => {"
NSQ_SOURCE_LINE 00001166 "    exports => ["
NSQ_SOURCE_LINE 00001167 "      analyze => \\&build_analyzer,"
NSQ_SOURCE_LINE 00001168 "    ],"
NSQ_SOURCE_LINE 00001169 "  };"
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 "  sub build_analyzer {"
NSQ_SOURCE_LINE 00001172 "    my ($class, $name, $arg) = @_;"
NSQ_SOURCE_LINE 00001173 ""
NSQ_SOURCE_LINE 00001174 "    return sub {"
NSQ_SOURCE_LINE 00001175 "      my $data      = shift;"
NSQ_SOURCE_LINE 00001176 "      my $tolerance = shift || $arg->{tolerance};"
NSQ_SOURCE_LINE 00001177 "      my $passes    = shift || $arg->{passes};"
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "      analyze($data, $tolerance, $passes);"
NSQ_SOURCE_LINE 00001180 "    }"
NSQ_SOURCE_LINE 00001181 "  }"
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "Your module's user now has to do less work to benefit from it -- and remember,"
NSQ_SOURCE_LINE 00001184 "you're often your own user!  Investing in customized subroutines is an"
NSQ_SOURCE_LINE 00001185 "investment in future laziness."
NSQ_SOURCE_LINE 00001186 ""
NSQ_SOURCE_LINE 00001187 "This also avoids a common form of ugliness seen in many modules: package-level"
NSQ_SOURCE_LINE 00001188 "configuration.  That is, you might have seen something like the above"
NSQ_SOURCE_LINE 00001189 "implemented like so:"
NSQ_SOURCE_LINE 00001190 ""
NSQ_SOURCE_LINE 00001191 "  use Data::Analyze qw(analyze);"
NSQ_SOURCE_LINE 00001192 "  $Data::Analyze::default_tolerance = 0.10;"
NSQ_SOURCE_LINE 00001193 "  $Data::Analyze::default_passes    = 10;"
NSQ_SOURCE_LINE 00001194 ""
NSQ_SOURCE_LINE 00001195 "This might save time, until you have multiple modules using Data::Analyze."
NSQ_SOURCE_LINE 00001196 "Because there is only one global configuration, they step on each other's toes"
NSQ_SOURCE_LINE 00001197 "and your code begins to have mysterious errors."
NSQ_SOURCE_LINE 00001198 ""
NSQ_SOURCE_LINE 00001199 "Generators can also allow you to export class methods to be called as"
NSQ_SOURCE_LINE 00001200 "subroutines:"
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "  package Data::Methodical;"
NSQ_SOURCE_LINE 00001203 "  use Sub::Exporter -setup => { exports => { some_method => \\&_curry_class } };"
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "  sub _curry_class {"
NSQ_SOURCE_LINE 00001206 "    my ($class, $name) = @_;"
NSQ_SOURCE_LINE 00001207 "    sub { $class->$name(@_); };"
NSQ_SOURCE_LINE 00001208 "  }"
NSQ_SOURCE_LINE 00001209 ""
NSQ_SOURCE_LINE 00001210 "Because of the way that exporters and Sub::Exporter work, any package that"
NSQ_SOURCE_LINE 00001211 "inherits from Data::Methodical can inherit its exporter and override its"
NSQ_SOURCE_LINE 00001212 "C<some_method>.  If a user imports C<some_method> from that package, he'll"
NSQ_SOURCE_LINE 00001213 "receive a subroutine that calls the method on the subclass, rather than on"
NSQ_SOURCE_LINE 00001214 "Data::Methodical itself.  Keep in mind that if you re-setup Sub::Exporter in a"
NSQ_SOURCE_LINE 00001215 "package that inherits from Data::Methodical you will, of course, be entirely"
NSQ_SOURCE_LINE 00001216 "replacing the exporter from Data::Methodical.  C<import> is a method, and is"
NSQ_SOURCE_LINE 00001217 "hidden by the same means as any other method."
NSQ_SOURCE_LINE 00001218 ""
NSQ_SOURCE_LINE 00001219 "=head2 Other Customizations"
NSQ_SOURCE_LINE 00001220 ""
NSQ_SOURCE_LINE 00001221 "Building custom routines with generators isn't the only way that Sub::Exporters"
NSQ_SOURCE_LINE 00001222 "allows the importing code to refine its use of the exported routines.  They may"
NSQ_SOURCE_LINE 00001223 "also be renamed to avoid naming collisions."
NSQ_SOURCE_LINE 00001224 ""
NSQ_SOURCE_LINE 00001225 "Consider the following code:"
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "  # this program determines to which circle of Hell you will be condemned"
NSQ_SOURCE_LINE 00001228 "  use Morality qw(sin virtue); # for calculating viciousness"
NSQ_SOURCE_LINE 00001229 "  use Math::Trig qw(:all);     # for dealing with circles"
NSQ_SOURCE_LINE 00001230 ""
NSQ_SOURCE_LINE 00001231 "The programmer has inadvertently imported two C<sin> routines.  The solution,"
NSQ_SOURCE_LINE 00001232 "in Exporter.pm-based modules, would be to import only one and then call the"
NSQ_SOURCE_LINE 00001233 "other by its fully-qualified name.  Alternately, the importer could write a"
NSQ_SOURCE_LINE 00001234 "routine that did so, or could mess about with typeglobs."
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 "How much easier to write:"
NSQ_SOURCE_LINE 00001237 ""
NSQ_SOURCE_LINE 00001238 "  # this program determines to which circle of Hell you will be condemned"
NSQ_SOURCE_LINE 00001239 "  use Morality qw(virtue), sin => { -as => 'offense' };"
NSQ_SOURCE_LINE 00001240 "  use Math::Trig -all => { -prefix => 'trig_' };"
NSQ_SOURCE_LINE 00001241 ""
NSQ_SOURCE_LINE 00001242 "and to have at one's disposal C<offense> and C<trig_sin> -- not to mention"
NSQ_SOURCE_LINE 00001243 "C<trig_cos> and C<trig_tan>."
NSQ_SOURCE_LINE 00001244 ""
NSQ_SOURCE_LINE 00001245 "=head1 PERL VERSION"
NSQ_SOURCE_LINE 00001246 ""
NSQ_SOURCE_LINE 00001247 "This library should run on perls released even a long time ago.  It should"
NSQ_SOURCE_LINE 00001248 "work on any version of perl released in the last five years."
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "Although it may work on older versions of perl, no guarantee is made that the"
NSQ_SOURCE_LINE 00001251 "minimum required version will not be increased.  The version may be increased"
NSQ_SOURCE_LINE 00001252 "for any reason, and there is no promise that patches will be accepted to"
NSQ_SOURCE_LINE 00001253 "lower the minimum required perl."
NSQ_SOURCE_LINE 00001254 ""
NSQ_SOURCE_LINE 00001255 "=head1 EXPORTER CONFIGURATION"
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "You can configure an exporter for your package by using Sub::Exporter like so:"
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "  package Tools;"
NSQ_SOURCE_LINE 00001260 "  use Sub::Exporter"
NSQ_SOURCE_LINE 00001261 "    -setup => { exports => [ qw(function1 function2 function3) ] };"
NSQ_SOURCE_LINE 00001262 ""
NSQ_SOURCE_LINE 00001263 "This is the simplest way to use the exporter, and is basically equivalent to"
NSQ_SOURCE_LINE 00001264 "this:"
NSQ_SOURCE_LINE 00001265 ""
NSQ_SOURCE_LINE 00001266 "  package Tools;"
NSQ_SOURCE_LINE 00001267 "  use base qw(Exporter);"
NSQ_SOURCE_LINE 00001268 "  our @EXPORT_OK = qw(function1 function2 function3);"
NSQ_SOURCE_LINE 00001269 ""
NSQ_SOURCE_LINE 00001270 "Any basic use of Sub::Exporter will look like this:"
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 "  package Tools;"
NSQ_SOURCE_LINE 00001273 "  use Sub::Exporter -setup => \\%config;"
NSQ_SOURCE_LINE 00001274 ""
NSQ_SOURCE_LINE 00001275 "The following keys are valid in C<%config>:"
NSQ_SOURCE_LINE 00001276 ""
NSQ_SOURCE_LINE 00001277 "  exports - a list of routines to provide for exporting; each routine may be"
NSQ_SOURCE_LINE 00001278 "            followed by generator"
NSQ_SOURCE_LINE 00001279 "  groups  - a list of groups to provide for exporting; each must be followed by"
NSQ_SOURCE_LINE 00001280 "            either (a) a list of exports, possibly with arguments for each"
NSQ_SOURCE_LINE 00001281 "            export, or (b) a generator"
NSQ_SOURCE_LINE 00001282 ""
NSQ_SOURCE_LINE 00001283 "  collectors - a list of names into which values are collected for use in"
NSQ_SOURCE_LINE 00001284 "               routine generation; each name may be followed by a validator"
NSQ_SOURCE_LINE 00001285 ""
NSQ_SOURCE_LINE 00001286 "In addition to the basic options above, a few more advanced options may be"
NSQ_SOURCE_LINE 00001287 "passed:"
NSQ_SOURCE_LINE 00001288 ""
NSQ_SOURCE_LINE 00001289 "  into_level - how far up the caller stack to look for a target (default 0)"
NSQ_SOURCE_LINE 00001290 "  into       - an explicit target (package) into which to export routines"
NSQ_SOURCE_LINE 00001291 ""
NSQ_SOURCE_LINE 00001292 "In other words: Sub::Exporter installs a C<import> routine which, when called,"
NSQ_SOURCE_LINE 00001293 "exports routines to the calling namespace.  The C<into> and C<into_level>"
NSQ_SOURCE_LINE 00001294 "options change where those exported routines are installed."
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 "  generator  - a callback used to produce the code that will be installed"
NSQ_SOURCE_LINE 00001297 "               default: Sub::Exporter::default_generator"
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "  installer  - a callback used to install the code produced by the generator"
NSQ_SOURCE_LINE 00001300 "               default: Sub::Exporter::default_installer"
NSQ_SOURCE_LINE 00001301 ""
NSQ_SOURCE_LINE 00001302 "For information on how these callbacks are used, see the documentation for"
NSQ_SOURCE_LINE 00001303 "C<L</default_generator>> and C<L</default_installer>>."
NSQ_SOURCE_LINE 00001304 ""
NSQ_SOURCE_LINE 00001305 "=head2 Export Configuration"
NSQ_SOURCE_LINE 00001306 ""
NSQ_SOURCE_LINE 00001307 "The C<exports> list may be provided as an array reference or a hash reference."
NSQ_SOURCE_LINE 00001308 "The list is processed in such a way that the following are equivalent:"
NSQ_SOURCE_LINE 00001309 ""
NSQ_SOURCE_LINE 00001310 "  { exports => [ qw(foo bar baz), quux => \\&quux_generator ] }"
NSQ_SOURCE_LINE 00001311 ""
NSQ_SOURCE_LINE 00001312 "  { exports =>"
NSQ_SOURCE_LINE 00001313 "    { foo => undef, bar => undef, baz => undef, quux => \\&quux_generator } }"
NSQ_SOURCE_LINE 00001314 ""
NSQ_SOURCE_LINE 00001315 "Generators are code that return coderefs.  They are called with four"
NSQ_SOURCE_LINE 00001316 "parameters:"
NSQ_SOURCE_LINE 00001317 ""
NSQ_SOURCE_LINE 00001318 "  $class - the class whose exporter has been called (the exporting class)"
NSQ_SOURCE_LINE 00001319 "  $name  - the name of the export for which the routine is being build"
NSQ_SOURCE_LINE 00001320 " \\%arg   - the arguments passed for this export"
NSQ_SOURCE_LINE 00001321 " \\%col   - the collections for this import"
NSQ_SOURCE_LINE 00001322 ""
NSQ_SOURCE_LINE 00001323 "Given the configuration in the L</SYNOPSIS>, the following C<use> statement:"
NSQ_SOURCE_LINE 00001324 ""
NSQ_SOURCE_LINE 00001325 "  use Text::Tweaker"
NSQ_SOURCE_LINE 00001326 "    reformat => { -as => 'make_narrow', width => 33 },"
NSQ_SOURCE_LINE 00001327 "    defaults => { eol => 'CR' };"
NSQ_SOURCE_LINE 00001328 ""
NSQ_SOURCE_LINE 00001329 "would result in the following call to C<&build_reformatter>:"
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 "  my $code = build_reformatter("
NSQ_SOURCE_LINE 00001332 "    'Text::Tweaker',"
NSQ_SOURCE_LINE 00001333 "    'reformat',"
NSQ_SOURCE_LINE 00001334 "    { width => 33 }, # note that -as is not passed in"
NSQ_SOURCE_LINE 00001335 "    { defaults => { eol => 'CR' } },"
NSQ_SOURCE_LINE 00001336 "  );"
NSQ_SOURCE_LINE 00001337 ""
NSQ_SOURCE_LINE 00001338 "The returned coderef (C<$code>) would then be installed as C<make_narrow> in the"
NSQ_SOURCE_LINE 00001339 "calling package."
NSQ_SOURCE_LINE 00001340 ""
NSQ_SOURCE_LINE 00001341 "Instead of providing a coderef in the configuration, a reference to a method"
NSQ_SOURCE_LINE 00001342 "name may be provided.  This method will then be called on the invocant of the"
NSQ_SOURCE_LINE 00001343 "C<import> method.  (In this case, we do not pass the C<$class> parameter, as it"
NSQ_SOURCE_LINE 00001344 "would be redundant.)"
NSQ_SOURCE_LINE 00001345 ""
NSQ_SOURCE_LINE 00001346 "=head2 Group Configuration"
NSQ_SOURCE_LINE 00001347 ""
NSQ_SOURCE_LINE 00001348 "The C<groups> list can be passed in the same forms as C<exports>.  Groups must"
NSQ_SOURCE_LINE 00001349 "have values to be meaningful, which may either list exports that make up the"
NSQ_SOURCE_LINE 00001350 "group (optionally with arguments) or may provide a way to build the group."
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "The simpler case is the first: a group definition is a list of exports.  Here's"
NSQ_SOURCE_LINE 00001353 "the example that could go in exporter in the L</SYNOPSIS>."
NSQ_SOURCE_LINE 00001354 ""
NSQ_SOURCE_LINE 00001355 "  groups  => {"
NSQ_SOURCE_LINE 00001356 "    default    => [ qw(reformat) ],"
NSQ_SOURCE_LINE 00001357 "    shorteners => [ qw(squish trim) ],"
NSQ_SOURCE_LINE 00001358 "    email_safe => ["
NSQ_SOURCE_LINE 00001359 "      'indent',"
NSQ_SOURCE_LINE 00001360 "      reformat => { -as => 'email_format', width => 72 }"
NSQ_SOURCE_LINE 00001361 "    ],"
NSQ_SOURCE_LINE 00001362 "  },"
NSQ_SOURCE_LINE 00001363 ""
NSQ_SOURCE_LINE 00001364 "Groups are imported by specifying their name prefixed be either a dash or a"
NSQ_SOURCE_LINE 00001365 "colon.  This line of code would import the C<shorteners> group:"
NSQ_SOURCE_LINE 00001366 ""
NSQ_SOURCE_LINE 00001367 "  use Text::Tweaker qw(-shorteners);"
NSQ_SOURCE_LINE 00001368 ""
NSQ_SOURCE_LINE 00001369 "Arguments passed to a group when importing are merged into the groups options"
NSQ_SOURCE_LINE 00001370 "and passed to any relevant generators.  Groups can contain other groups, but"
NSQ_SOURCE_LINE 00001371 "looping group structures are ignored."
NSQ_SOURCE_LINE 00001372 ""
NSQ_SOURCE_LINE 00001373 "The other possible value for a group definition, a coderef, allows one"
NSQ_SOURCE_LINE 00001374 "generator to build several exportable routines simultaneously.  This is useful"
NSQ_SOURCE_LINE 00001375 "when many routines must share enclosed lexical variables.  The coderef must"
NSQ_SOURCE_LINE 00001376 "return a hash reference.  The keys will be used as export names and the values"
NSQ_SOURCE_LINE 00001377 "are the subs that will be exported."
NSQ_SOURCE_LINE 00001378 ""
NSQ_SOURCE_LINE 00001379 "This example shows a simple use of the group generator."
NSQ_SOURCE_LINE 00001380 ""
NSQ_SOURCE_LINE 00001381 "  package Data::Crypto;"
NSQ_SOURCE_LINE 00001382 "  use Sub::Exporter -setup => { groups => { cipher => \\&build_cipher_group } };"
NSQ_SOURCE_LINE 00001383 ""
NSQ_SOURCE_LINE 00001384 "  sub build_cipher_group {"
NSQ_SOURCE_LINE 00001385 "    my ($class, $group, $arg) = @_;"
NSQ_SOURCE_LINE 00001386 "    my ($encode, $decode) = build_codec($arg->{secret});"
NSQ_SOURCE_LINE 00001387 "    return { cipher => $encode, decipher => $decode };"
NSQ_SOURCE_LINE 00001388 "  }"
NSQ_SOURCE_LINE 00001389 ""
NSQ_SOURCE_LINE 00001390 "The C<cipher> and C<decipher> routines are built in a group because they are"
NSQ_SOURCE_LINE 00001391 "built together by code which encloses their secret in their environment."
NSQ_SOURCE_LINE 00001392 ""
NSQ_SOURCE_LINE 00001393 "=head3 Default Groups"
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 "If a module that uses Sub::Exporter is C<use>d with no arguments, it will try"
NSQ_SOURCE_LINE 00001396 "to export the group named C<default>.  If that group has not been specifically"
NSQ_SOURCE_LINE 00001397 "configured, it will be empty, and nothing will happen."
NSQ_SOURCE_LINE 00001398 ""
NSQ_SOURCE_LINE 00001399 "Another group is also created if not defined: C<all>.  The C<all> group"
NSQ_SOURCE_LINE 00001400 "contains all the exports from the exports list."
NSQ_SOURCE_LINE 00001401 ""
NSQ_SOURCE_LINE 00001402 "=head2 Collector Configuration"
NSQ_SOURCE_LINE 00001403 ""
NSQ_SOURCE_LINE 00001404 "The C<collectors> entry in the exporter configuration gives names which, when"
NSQ_SOURCE_LINE 00001405 "found in the import call, have their values collected and passed to every"
NSQ_SOURCE_LINE 00001406 "generator."
NSQ_SOURCE_LINE 00001407 ""
NSQ_SOURCE_LINE 00001408 "For example, the C<build_analyzer> generator that we saw above could be"
NSQ_SOURCE_LINE 00001409 "rewritten as:"
NSQ_SOURCE_LINE 00001410 ""
NSQ_SOURCE_LINE 00001411 " sub build_analyzer {"
NSQ_SOURCE_LINE 00001412 "   my ($class, $name, $arg, $col) = @_;"
NSQ_SOURCE_LINE 00001413 ""
NSQ_SOURCE_LINE 00001414 "   return sub {"
NSQ_SOURCE_LINE 00001415 "     my $data      = shift;"
NSQ_SOURCE_LINE 00001416 "     my $tolerance = shift || $arg->{tolerance} || $col->{defaults}{tolerance};"
NSQ_SOURCE_LINE 00001417 "     my $passes    = shift || $arg->{passes}    || $col->{defaults}{passes};"
NSQ_SOURCE_LINE 00001418 ""
NSQ_SOURCE_LINE 00001419 "     analyze($data, $tolerance, $passes);"
NSQ_SOURCE_LINE 00001420 "   }"
NSQ_SOURCE_LINE 00001421 " }"
NSQ_SOURCE_LINE 00001422 ""
NSQ_SOURCE_LINE 00001423 "That would allow the importer to specify global defaults for his imports:"
NSQ_SOURCE_LINE 00001424 ""
NSQ_SOURCE_LINE 00001425 "  use Data::Analyze"
NSQ_SOURCE_LINE 00001426 "    'analyze',"
NSQ_SOURCE_LINE 00001427 "    analyze  => { tolerance => 0.10, -as => analyze10 },"
NSQ_SOURCE_LINE 00001428 "    analyze  => { tolerance => 0.15, passes => 50, -as => analyze50 },"
NSQ_SOURCE_LINE 00001429 "    defaults => { passes => 10 };"
NSQ_SOURCE_LINE 00001430 ""
NSQ_SOURCE_LINE 00001431 "  my $A = analyze10($data);     # equivalent to analyze($data, 0.10, 10);"
NSQ_SOURCE_LINE 00001432 "  my $C = analyze50($data);     # equivalent to analyze($data, 0.15, 50);"
NSQ_SOURCE_LINE 00001433 "  my $B = analyze($data, 0.20); # equivalent to analyze($data, 0.20, 10);"
NSQ_SOURCE_LINE 00001434 ""
NSQ_SOURCE_LINE 00001435 "If values are provided in the C<collectors> list during exporter setup, they"
NSQ_SOURCE_LINE 00001436 "must be code references, and are used to validate the importer's values.  The"
NSQ_SOURCE_LINE 00001437 "validator is called when the collection is found, and if it returns false, an"
NSQ_SOURCE_LINE 00001438 "exception is thrown.  We could ensure that no one tries to set a global data"
NSQ_SOURCE_LINE 00001439 "default easily:"
NSQ_SOURCE_LINE 00001440 ""
NSQ_SOURCE_LINE 00001441 "  collectors => { defaults => sub { return (exists $_[0]->{data}) ? 0 : 1 } }"
NSQ_SOURCE_LINE 00001442 ""
NSQ_SOURCE_LINE 00001443 "Collector coderefs can also be used as hooks to perform arbitrary actions"
NSQ_SOURCE_LINE 00001444 "before anything is exported."
NSQ_SOURCE_LINE 00001445 ""
NSQ_SOURCE_LINE 00001446 "When the coderef is called, it is passed the value of the collection and a"
NSQ_SOURCE_LINE 00001447 "hashref containing the following entries:"
NSQ_SOURCE_LINE 00001448 ""
NSQ_SOURCE_LINE 00001449 "  name        - the name of the collector"
NSQ_SOURCE_LINE 00001450 "  config      - the exporter configuration (hashref)"
NSQ_SOURCE_LINE 00001451 "  import_args - the arguments passed to the exporter, sans collections (aref)"
NSQ_SOURCE_LINE 00001452 "  class       - the package on which the importer was called"
NSQ_SOURCE_LINE 00001453 "  into        - the package into which exports will be exported"
NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 "Collectors with all-caps names (that is, made up of underscore or capital A"
NSQ_SOURCE_LINE 00001456 "through Z) are reserved for special use.  The only currently implemented"
NSQ_SOURCE_LINE 00001457 "special collector is C<INIT>, whose hook (if present in the exporter"
NSQ_SOURCE_LINE 00001458 "configuration) is always run before any other hook."
NSQ_SOURCE_LINE 00001459 ""
NSQ_SOURCE_LINE 00001460 "=head1 CALLING THE EXPORTER"
NSQ_SOURCE_LINE 00001461 ""
NSQ_SOURCE_LINE 00001462 "Arguments to the exporter (that is, the arguments after the module name in a"
NSQ_SOURCE_LINE 00001463 "C<use> statement) are parsed as follows:"
NSQ_SOURCE_LINE 00001464 ""
NSQ_SOURCE_LINE 00001465 "First, the collectors gather any collections found in the arguments.  Any"
NSQ_SOURCE_LINE 00001466 "reference type may be given as the value for a collector.  For each collection"
NSQ_SOURCE_LINE 00001467 "given in the arguments, its validator (if any) is called."
NSQ_SOURCE_LINE 00001468 ""
NSQ_SOURCE_LINE 00001469 "Next, groups are expanded.  If the group is implemented by a group generator,"
NSQ_SOURCE_LINE 00001470 "the generator is called.  There are two special arguments which, if given to a"
NSQ_SOURCE_LINE 00001471 "group, have special meaning:"
NSQ_SOURCE_LINE 00001472 ""
NSQ_SOURCE_LINE 00001473 "  -prefix - a string to prepend to any export imported from this group"
NSQ_SOURCE_LINE 00001474 "  -suffix - a string to append to any export imported from this group"
NSQ_SOURCE_LINE 00001475 ""
NSQ_SOURCE_LINE 00001476 "Finally, individual export generators are called and all subs, generated or"
NSQ_SOURCE_LINE 00001477 "otherwise, are installed in the calling package.  There is only one special"
NSQ_SOURCE_LINE 00001478 "argument for export generators:"
NSQ_SOURCE_LINE 00001479 ""
NSQ_SOURCE_LINE 00001480 "  -as     - where to install the exported sub"
NSQ_SOURCE_LINE 00001481 ""
NSQ_SOURCE_LINE 00001482 "Normally, C<-as> will contain an alternate name for the routine.  It may,"
NSQ_SOURCE_LINE 00001483 "however, contain a reference to a scalar.  If that is the case, a reference the"
NSQ_SOURCE_LINE 00001484 "generated routine will be placed in the scalar referenced by C<-as>.  It will"
NSQ_SOURCE_LINE 00001485 "not be installed into the calling package."
NSQ_SOURCE_LINE 00001486 ""
NSQ_SOURCE_LINE 00001487 "=head2 Special Exporter Arguments"
NSQ_SOURCE_LINE 00001488 ""
NSQ_SOURCE_LINE 00001489 "The generated exporter accept some special options, which may be passed as the"
NSQ_SOURCE_LINE 00001490 "first argument, in a hashref."
NSQ_SOURCE_LINE 00001491 ""
NSQ_SOURCE_LINE 00001492 "These options are:"
NSQ_SOURCE_LINE 00001493 ""
NSQ_SOURCE_LINE 00001494 "  into_level"
NSQ_SOURCE_LINE 00001495 "  into"
NSQ_SOURCE_LINE 00001496 "  generator"
NSQ_SOURCE_LINE 00001497 "  installer"
NSQ_SOURCE_LINE 00001498 ""
NSQ_SOURCE_LINE 00001499 "These override the same-named configuration options described in L</EXPORTER"
NSQ_SOURCE_LINE 00001500 "CONFIGURATION>."
NSQ_SOURCE_LINE 00001501 ""
NSQ_SOURCE_LINE 00001502 "=head1 SUBROUTINES"
NSQ_SOURCE_LINE 00001503 ""
NSQ_SOURCE_LINE 00001504 "=head2 setup_exporter"
NSQ_SOURCE_LINE 00001505 ""
NSQ_SOURCE_LINE 00001506 "This routine builds and installs an C<import> routine.  It is called with one"
NSQ_SOURCE_LINE 00001507 "argument, a hashref containing the exporter configuration.  Using this, it"
NSQ_SOURCE_LINE 00001508 "builds an exporter and installs it into the calling package with the name"
NSQ_SOURCE_LINE 00001509 "\"import.\"  In addition to the normal exporter configuration, a few named"
NSQ_SOURCE_LINE 00001510 "arguments may be passed in the hashref:"
NSQ_SOURCE_LINE 00001511 ""
NSQ_SOURCE_LINE 00001512 "  into       - into what package should the exporter be installed"
NSQ_SOURCE_LINE 00001513 "  into_level - into what level up the stack should the exporter be installed"
NSQ_SOURCE_LINE 00001514 "  as         - what name should the installed exporter be given"
NSQ_SOURCE_LINE 00001515 ""
NSQ_SOURCE_LINE 00001516 "By default the exporter is installed with the name C<import> into the immediate"
NSQ_SOURCE_LINE 00001517 "caller of C<setup_exporter>.  In other words, if your package calls"
NSQ_SOURCE_LINE 00001518 "C<setup_exporter> without providing any of the three above arguments, it will"
NSQ_SOURCE_LINE 00001519 "have an C<import> routine installed."
NSQ_SOURCE_LINE 00001520 ""
NSQ_SOURCE_LINE 00001521 "Providing both C<into> and C<into_level> will cause an exception to be thrown."
NSQ_SOURCE_LINE 00001522 ""
NSQ_SOURCE_LINE 00001523 "The exporter is built by C<L</build_exporter>>."
NSQ_SOURCE_LINE 00001524 ""
NSQ_SOURCE_LINE 00001525 "=head2 build_exporter"
NSQ_SOURCE_LINE 00001526 ""
NSQ_SOURCE_LINE 00001527 "Given a standard exporter configuration, this routine builds and returns an"
NSQ_SOURCE_LINE 00001528 "exporter -- that is, a subroutine that can be installed as a class method to"
NSQ_SOURCE_LINE 00001529 "perform exporting on request."
NSQ_SOURCE_LINE 00001530 ""
NSQ_SOURCE_LINE 00001531 "Usually, this method is called by C<L</setup_exporter>>, which then installs"
NSQ_SOURCE_LINE 00001532 "the exporter as a package's import routine."
NSQ_SOURCE_LINE 00001533 ""
NSQ_SOURCE_LINE 00001534 "=head2 default_generator"
NSQ_SOURCE_LINE 00001535 ""
NSQ_SOURCE_LINE 00001536 "This is Sub::Exporter's default generator.  It takes bits of configuration that"
NSQ_SOURCE_LINE 00001537 "have been gathered during the import and turns them into a coderef that can be"
NSQ_SOURCE_LINE 00001538 "installed."
NSQ_SOURCE_LINE 00001539 ""
NSQ_SOURCE_LINE 00001540 "  my $code = default_generator(\\%arg);"
NSQ_SOURCE_LINE 00001541 ""
NSQ_SOURCE_LINE 00001542 "Passed arguments are:"
NSQ_SOURCE_LINE 00001543 ""
NSQ_SOURCE_LINE 00001544 "  class - the class on which the import method was called"
NSQ_SOURCE_LINE 00001545 "  name  - the name of the export being generated"
NSQ_SOURCE_LINE 00001546 "  arg   - the arguments to the generator"
NSQ_SOURCE_LINE 00001547 "  col   - the collections"
NSQ_SOURCE_LINE 00001548 ""
NSQ_SOURCE_LINE 00001549 "  generator - the generator to be used to build the export (code or scalar ref)"
NSQ_SOURCE_LINE 00001550 ""
NSQ_SOURCE_LINE 00001551 "=head2 default_installer"
NSQ_SOURCE_LINE 00001552 ""
NSQ_SOURCE_LINE 00001553 "This is Sub::Exporter's default installer.  It does what Sub::Exporter"
NSQ_SOURCE_LINE 00001554 "promises: it installs code into the target package."
NSQ_SOURCE_LINE 00001555 ""
NSQ_SOURCE_LINE 00001556 "  default_installer(\\%arg, \\@to_export);"
NSQ_SOURCE_LINE 00001557 ""
NSQ_SOURCE_LINE 00001558 "Passed arguments are:"
NSQ_SOURCE_LINE 00001559 ""
NSQ_SOURCE_LINE 00001560 "  into - the package into which exports should be delivered"
NSQ_SOURCE_LINE 00001561 ""
NSQ_SOURCE_LINE 00001562 "C<@to_export> is a list of name/value pairs.  The default exporter assigns code"
NSQ_SOURCE_LINE 00001563 "(the values) to named slots (the names) in the given package.  If the name is a"
NSQ_SOURCE_LINE 00001564 "scalar reference, the scalar reference is made to point to the code reference"
NSQ_SOURCE_LINE 00001565 "instead."
NSQ_SOURCE_LINE 00001566 ""
NSQ_SOURCE_LINE 00001567 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00001568 ""
NSQ_SOURCE_LINE 00001569 "Sub::Exporter also offers its own exports: the C<setup_exporter> and"
NSQ_SOURCE_LINE 00001570 "C<build_exporter> routines described above.  It also provides a special \"setup\""
NSQ_SOURCE_LINE 00001571 "collector, which will set up an exporter using the parameters passed to it."
NSQ_SOURCE_LINE 00001572 ""
NSQ_SOURCE_LINE 00001573 "Note that the \"setup\" collector (seen in examples like the L</SYNOPSIS> above)"
NSQ_SOURCE_LINE 00001574 "uses C<build_exporter>, not C<setup_exporter>.  This means that the special"
NSQ_SOURCE_LINE 00001575 "arguments like \"into\" and \"as\" for C<setup_exporter> are not accepted here."
NSQ_SOURCE_LINE 00001576 "Instead, you may write something like:"
NSQ_SOURCE_LINE 00001577 ""
NSQ_SOURCE_LINE 00001578 "  use Sub::Exporter"
NSQ_SOURCE_LINE 00001579 "    { into => 'Target::Package' },"
NSQ_SOURCE_LINE 00001580 "    -setup => {"
NSQ_SOURCE_LINE 00001581 "      -as     => 'do_import',"
NSQ_SOURCE_LINE 00001582 "      exports => [ ... ],"
NSQ_SOURCE_LINE 00001583 "    }"
NSQ_SOURCE_LINE 00001584 "  ;"
NSQ_SOURCE_LINE 00001585 ""
NSQ_SOURCE_LINE 00001586 "Finding a good reason for wanting to do this is left as an exercise for the"
NSQ_SOURCE_LINE 00001587 "reader."
NSQ_SOURCE_LINE 00001588 ""
NSQ_SOURCE_LINE 00001589 "=head1 COMPARISONS"
NSQ_SOURCE_LINE 00001590 ""
NSQ_SOURCE_LINE 00001591 "There are a whole mess of exporters on the CPAN.  The features included in"
NSQ_SOURCE_LINE 00001592 "Sub::Exporter set it apart from any existing Exporter.  Here's a summary of"
NSQ_SOURCE_LINE 00001593 "some other exporters and how they compare."
NSQ_SOURCE_LINE 00001594 ""
NSQ_SOURCE_LINE 00001595 "=over"
NSQ_SOURCE_LINE 00001596 ""
NSQ_SOURCE_LINE 00001597 "=item * L<Exporter> and co."
NSQ_SOURCE_LINE 00001598 ""
NSQ_SOURCE_LINE 00001599 "This is the standard Perl exporter.  Its interface is a little clunky, but it's"
NSQ_SOURCE_LINE 00001600 "fast and ubiquitous.  It can do some things that Sub::Exporter can't:  it can"
NSQ_SOURCE_LINE 00001601 "export things other than routines, it can import \"everything in this group"
NSQ_SOURCE_LINE 00001602 "except this symbol,\" and some other more esoteric things.  These features seem"
NSQ_SOURCE_LINE 00001603 "to go nearly entirely unused."
NSQ_SOURCE_LINE 00001604 ""
NSQ_SOURCE_LINE 00001605 "It always exports things exactly as they appear in the exporting module; it"
NSQ_SOURCE_LINE 00001606 "can't rename or customize routines.  Its groups (\"tags\") can't be nested."
NSQ_SOURCE_LINE 00001607 ""
NSQ_SOURCE_LINE 00001608 "L<Exporter::Lite> is a whole lot like Exporter, but it does significantly less:"
NSQ_SOURCE_LINE 00001609 "it supports exporting symbols, but not groups, pattern matching, or negation."
NSQ_SOURCE_LINE 00001610 ""
NSQ_SOURCE_LINE 00001611 "The fact that Sub::Exporter can't export symbols other than subroutines is"
NSQ_SOURCE_LINE 00001612 "a good idea, not a missing feature."
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "For simple uses, setting up Sub::Exporter is about as easy as Exporter.  For"
NSQ_SOURCE_LINE 00001615 "complex uses, Sub::Exporter makes hard things possible, which would not be"
NSQ_SOURCE_LINE 00001616 "possible with Exporter."
NSQ_SOURCE_LINE 00001617 ""
NSQ_SOURCE_LINE 00001618 "When using a module that uses Sub::Exporter, users familiar with Exporter will"
NSQ_SOURCE_LINE 00001619 "probably see no difference in the basics.  These two lines do about the same"
NSQ_SOURCE_LINE 00001620 "thing in whether the exporting module uses Exporter or Sub::Exporter."
NSQ_SOURCE_LINE 00001621 ""
NSQ_SOURCE_LINE 00001622 "  use Some::Module qw(foo bar baz);"
NSQ_SOURCE_LINE 00001623 "  use Some::Module qw(foo :bar baz);"
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 "The definition for exporting in Exporter.pm might look like this:"
NSQ_SOURCE_LINE 00001626 ""
NSQ_SOURCE_LINE 00001627 "  package Some::Module;"
NSQ_SOURCE_LINE 00001628 "  use base qw(Exporter);"
NSQ_SOURCE_LINE 00001629 "  our @EXPORT_OK   = qw(foo bar baz quux);"
NSQ_SOURCE_LINE 00001630 "  our %EXPORT_TAGS = (bar => [ qw(bar baz) ]);"
NSQ_SOURCE_LINE 00001631 ""
NSQ_SOURCE_LINE 00001632 "Using Sub::Exporter, it would look like this:"
NSQ_SOURCE_LINE 00001633 ""
NSQ_SOURCE_LINE 00001634 "  package Some::Module;"
NSQ_SOURCE_LINE 00001635 "  use Sub::Exporter -setup => {"
NSQ_SOURCE_LINE 00001636 "    exports => [ qw(foo bar baz quux) ],"
NSQ_SOURCE_LINE 00001637 "    groups  => { bar => [ qw(bar baz) ]}"
NSQ_SOURCE_LINE 00001638 "  };"
NSQ_SOURCE_LINE 00001639 ""
NSQ_SOURCE_LINE 00001640 "Sub::Exporter respects inheritance, so that a package may export inherited"
NSQ_SOURCE_LINE 00001641 "routines, and will export the most inherited version.  Exporting methods"
NSQ_SOURCE_LINE 00001642 "without currying away the invocant is a bad idea, but Sub::Exporter allows you"
NSQ_SOURCE_LINE 00001643 "to do just that -- and anyway, there are other uses for this feature, like"
NSQ_SOURCE_LINE 00001644 "packages of exported subroutines which use inheritance specifically to allow"
NSQ_SOURCE_LINE 00001645 "more specialized, but similar, packages."
NSQ_SOURCE_LINE 00001646 ""
NSQ_SOURCE_LINE 00001647 "L<Exporter::Easy> provides a wrapper around the standard Exporter.  It makes it"
NSQ_SOURCE_LINE 00001648 "simpler to build groups, but doesn't provide any more functionality.  Because"
NSQ_SOURCE_LINE 00001649 "it is a front-end to Exporter, it will store your exporter's configuration in"
NSQ_SOURCE_LINE 00001650 "global package variables."
NSQ_SOURCE_LINE 00001651 ""
NSQ_SOURCE_LINE 00001652 "=item * Attribute-Based Exporters"
NSQ_SOURCE_LINE 00001653 ""
NSQ_SOURCE_LINE 00001654 "Some exporters use attributes to mark variables to export.  L<Exporter::Simple>"
NSQ_SOURCE_LINE 00001655 "supports exporting any kind of symbol, and supports groups.  Using a module"
NSQ_SOURCE_LINE 00001656 "like Exporter or Sub::Exporter, it's easy to look at one place and see what is"
NSQ_SOURCE_LINE 00001657 "exported, but it's impossible to look at a variable definition and see whether"
NSQ_SOURCE_LINE 00001658 "it is exported by that alone.  Exporter::Simple makes this trade in reverse:"
NSQ_SOURCE_LINE 00001659 "each variable's declaration includes its export definition, but there is no one"
NSQ_SOURCE_LINE 00001660 "place to look to find a manifest of exports."
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "More importantly, Exporter::Simple does not add any new features to those of"
NSQ_SOURCE_LINE 00001663 "Exporter.  In fact, like Exporter::Easy, it is just a front-end to Exporter, so"
NSQ_SOURCE_LINE 00001664 "it ends up storing its configuration in global package variables.  (This means"
NSQ_SOURCE_LINE 00001665 "that there is one place to look for your exporter's manifest, actually.  You"
NSQ_SOURCE_LINE 00001666 "can inspect the C<@EXPORT> package variables, and other related package"
NSQ_SOURCE_LINE 00001667 "variables, at runtime.)"
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 "L<Perl6::Export> isn't actually attribute based, but looks similar.  Its syntax"
NSQ_SOURCE_LINE 00001670 "is borrowed from Perl 6, and implemented by a source filter.  It is a prototype"
NSQ_SOURCE_LINE 00001671 "of an interface that is still being designed.  It should probably be avoided"
NSQ_SOURCE_LINE 00001672 "for production work.  On the other hand, L<Perl6::Export::Attrs> implements"
NSQ_SOURCE_LINE 00001673 "Perl 6-like exporting, but translates it into Perl 5 by providing attributes."
NSQ_SOURCE_LINE 00001674 ""
NSQ_SOURCE_LINE 00001675 "=item * Other Exporters"
NSQ_SOURCE_LINE 00001676 ""
NSQ_SOURCE_LINE 00001677 "L<Exporter::Renaming> wraps the standard Exporter to allow it to export symbols"
NSQ_SOURCE_LINE 00001678 "with changed names."
NSQ_SOURCE_LINE 00001679 ""
NSQ_SOURCE_LINE 00001680 "L<Class::Exporter> performs a special kind of routine generation, giving each"
NSQ_SOURCE_LINE 00001681 "importing package an instance of your class, and then exporting the instance's"
NSQ_SOURCE_LINE 00001682 "methods as normal routines.  (Sub::Exporter, of course, can easily emulate this"
NSQ_SOURCE_LINE 00001683 "behavior, as shown above.)"
NSQ_SOURCE_LINE 00001684 ""
NSQ_SOURCE_LINE 00001685 "L<Exporter::Tidy> implements a form of renaming (using its C<_map> argument)"
NSQ_SOURCE_LINE 00001686 "and of prefixing, and implements groups.  It also avoids using package"
NSQ_SOURCE_LINE 00001687 "variables for its configuration."
NSQ_SOURCE_LINE 00001688 ""
NSQ_SOURCE_LINE 00001689 "=back"
NSQ_SOURCE_LINE 00001690 ""
NSQ_SOURCE_LINE 00001691 "=head1 TODO"
NSQ_SOURCE_LINE 00001692 ""
NSQ_SOURCE_LINE 00001693 "=over"
NSQ_SOURCE_LINE 00001694 ""
NSQ_SOURCE_LINE 00001695 "=item * write a set of longer, more demonstrative examples"
NSQ_SOURCE_LINE 00001696 ""
NSQ_SOURCE_LINE 00001697 "=item * solidify the \"custom exporter\" interface (see C<&default_exporter>)"
NSQ_SOURCE_LINE 00001698 ""
NSQ_SOURCE_LINE 00001699 "=item * add an \"always\" group"
NSQ_SOURCE_LINE 00001700 ""
NSQ_SOURCE_LINE 00001701 "=back"
NSQ_SOURCE_LINE 00001702 ""
NSQ_SOURCE_LINE 00001703 "=head1 THANKS"
NSQ_SOURCE_LINE 00001704 ""
NSQ_SOURCE_LINE 00001705 "Hans Dieter Pearcey provided helpful advice while I was writing Sub::Exporter."
NSQ_SOURCE_LINE 00001706 "Ian Langworth and Shawn Sorichetti asked some good questions and helped me"
NSQ_SOURCE_LINE 00001707 "improve my documentation quite a bit.  Yuval Kogman helped me find a bunch of"
NSQ_SOURCE_LINE 00001708 "little problems."
NSQ_SOURCE_LINE 00001709 ""
NSQ_SOURCE_LINE 00001710 "Thanks, friends!"
NSQ_SOURCE_LINE 00001711 ""
NSQ_SOURCE_LINE 00001712 "=head1 BUGS"
