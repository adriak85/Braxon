BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Net::SSH;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use vars qw($VERSION @ISA @EXPORT_OK $ssh $equalspace $DEBUG @ssh_options);"
NSQ_SOURCE_LINE 00000005 "use Exporter;"
NSQ_SOURCE_LINE 00000006 "use POSIX \":sys_wait_h\";"
NSQ_SOURCE_LINE 00000007 "use IO::File;"
NSQ_SOURCE_LINE 00000008 "use IO::Select;"
NSQ_SOURCE_LINE 00000009 "use IPC::Open2;"
NSQ_SOURCE_LINE 00000010 "use IPC::Open3;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "@ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000013 "@EXPORT_OK = qw( ssh issh ssh_cmd sshopen2 sshopen3 );"
NSQ_SOURCE_LINE 00000014 "$VERSION = '0.09';"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "$DEBUG = 0;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "$ssh = \"ssh\";"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "=head1 NAME"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "Net::SSH - Perl extension for secure shell"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "  use Net::SSH qw(ssh issh sshopen2 sshopen3);"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "  ssh('user@hostname', $command);"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "  issh('user@hostname', $command);"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "  ssh_cmd('user@hostname', $command);"
NSQ_SOURCE_LINE 00000033 "  ssh_cmd( {"
NSQ_SOURCE_LINE 00000034 "    user => 'user',"
NSQ_SOURCE_LINE 00000035 "    host => 'host.name',"
NSQ_SOURCE_LINE 00000036 "    command => 'command',"
NSQ_SOURCE_LINE 00000037 "    args => [ '-arg1', '-arg2' ],"
NSQ_SOURCE_LINE 00000038 "    stdin_string => \"string\\n\","
NSQ_SOURCE_LINE 00000039 "  } );"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "  sshopen2('user@hostname', $reader, $writer, $command);"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "  sshopen3('user@hostname', $writer, $reader, $error, $command);"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "Simple wrappers around ssh commands."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "For an all-perl implementation that does not require the system B<ssh> command,"
NSQ_SOURCE_LINE 00000050 "see L<Net::SSH::Perl> instead."
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=head1 SUBROUTINES"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "=over 4"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=item ssh [USER@]HOST, COMMAND [, ARGS ... ]"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "Calls ssh in batch mode."
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=cut"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "sub ssh {"
NSQ_SOURCE_LINE 00000063 "  my($host, @command) = @_;"
NSQ_SOURCE_LINE 00000064 "  @ssh_options = &_ssh_options unless @ssh_options;"
NSQ_SOURCE_LINE 00000065 "  my @cmd = ($ssh, @ssh_options, $host, @command);"
NSQ_SOURCE_LINE 00000066 "  warn \"[Net::SSH::ssh] executing \". join(' ', @cmd). \"\\n\""
NSQ_SOURCE_LINE 00000067 "    if $DEBUG;"
NSQ_SOURCE_LINE 00000068 "  system(@cmd);"
NSQ_SOURCE_LINE 00000069 "}"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=item issh [USER@]HOST, COMMAND [, ARGS ... ]"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "Prints the ssh command to be executed, waits for the user to confirm, and"
NSQ_SOURCE_LINE 00000074 "(optionally) executes the command."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=cut"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "sub issh {"
NSQ_SOURCE_LINE 00000079 "  my($host, @command) = @_;"
NSQ_SOURCE_LINE 00000080 "  my @cmd = ($ssh, $host, @command);"
NSQ_SOURCE_LINE 00000081 "  print join(' ', @cmd), \"\\n\";"
NSQ_SOURCE_LINE 00000082 "  if ( &_yesno ) {"
NSQ_SOURCE_LINE 00000083 "    system(@cmd);"
NSQ_SOURCE_LINE 00000084 "  }"
NSQ_SOURCE_LINE 00000085 "}"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "=item ssh_cmd [USER@]HOST, COMMAND [, ARGS ... ]"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=item ssh_cmd OPTIONS_HASHREF"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "Calls ssh in batch mode.  Throws a fatal error if data occurs on the command's"
NSQ_SOURCE_LINE 00000092 "STDERR.  Returns any data from the command's STDOUT."
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "If using the hashref-style of passing arguments, possible keys are:"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "  user (optional)"
NSQ_SOURCE_LINE 00000097 "  host (requried)"
NSQ_SOURCE_LINE 00000098 "  command (required)"
NSQ_SOURCE_LINE 00000099 "  args (optional, arrayref)"
NSQ_SOURCE_LINE 00000100 "  stdin_string (optional) - written to the command's STDIN"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=cut"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub ssh_cmd {"
NSQ_SOURCE_LINE 00000105 "  my($host, $stdin_string, @command);"
NSQ_SOURCE_LINE 00000106 "  if ( ref($_[0]) ) {"
NSQ_SOURCE_LINE 00000107 "    my $opt = shift;"
NSQ_SOURCE_LINE 00000108 "    $host = $opt->{host};"
NSQ_SOURCE_LINE 00000109 "    $host = $opt->{user}. '@'. $host if exists $opt->{user};"
NSQ_SOURCE_LINE 00000110 "    @command = ( $opt->{command} );"
NSQ_SOURCE_LINE 00000111 "    push @command, @{ $opt->{args} } if exists $opt->{args};"
NSQ_SOURCE_LINE 00000112 "    $stdin_string = $opt->{stdin_string};"
NSQ_SOURCE_LINE 00000113 "  } else {"
NSQ_SOURCE_LINE 00000114 "    ($host, @command) = @_;"
NSQ_SOURCE_LINE 00000115 "    undef $stdin_string;"
NSQ_SOURCE_LINE 00000116 "  }"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "  my $reader = IO::File->new();"
NSQ_SOURCE_LINE 00000119 "  my $writer = IO::File->new();"
NSQ_SOURCE_LINE 00000120 "  my $error  = IO::File->new();"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "  my $pid = sshopen3( $host, $writer, $reader, $error, @command ) or die $!;"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "  print $writer $stdin_string if defined $stdin_string;"
NSQ_SOURCE_LINE 00000125 "  close $writer;"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "  my $select = new IO::Select;"
NSQ_SOURCE_LINE 00000128 "  foreach ( $reader, $error ) { $select->add($_); }"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "  my($output_stream, $error_stream) = ('', '');"
NSQ_SOURCE_LINE 00000131 "  while ( $select->count ) {"
NSQ_SOURCE_LINE 00000132 "    my @handles = $select->can_read;"
NSQ_SOURCE_LINE 00000133 "    foreach my $handle ( @handles ) {"
NSQ_SOURCE_LINE 00000134 "      my $buffer = '';"
NSQ_SOURCE_LINE 00000135 "      my $bytes = sysread($handle, $buffer, 4096);"
NSQ_SOURCE_LINE 00000136 "      if ( !defined($bytes) ) {"
NSQ_SOURCE_LINE 00000137 "        waitpid($pid, WNOHANG);"
NSQ_SOURCE_LINE 00000138 "        die \"[Net::SSH::ssh_cmd] $!\""
NSQ_SOURCE_LINE 00000139 "      };"
NSQ_SOURCE_LINE 00000140 "      $select->remove($handle) if !$bytes;"
NSQ_SOURCE_LINE 00000141 "      if ( $handle eq $reader ) {"
NSQ_SOURCE_LINE 00000142 "        $output_stream .= $buffer;"
NSQ_SOURCE_LINE 00000143 "      } elsif ( $handle eq $error ) {"
NSQ_SOURCE_LINE 00000144 "        $error_stream  .= $buffer;"
NSQ_SOURCE_LINE 00000145 "      }"
NSQ_SOURCE_LINE 00000146 "    }"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "  }"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "  waitpid($pid, WNOHANG);"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "  die \"$error_stream\" if length($error_stream);"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "  return $output_stream;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "}"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=item sshopen2 [USER@]HOST, READER, WRITER, COMMAND [, ARGS ... ]"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "Connects the supplied filehandles to the ssh process (in batch mode)."
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=cut"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "sub sshopen2 {"
NSQ_SOURCE_LINE 00000165 "  my($host, $reader, $writer, @command) = @_;"
NSQ_SOURCE_LINE 00000166 "  @ssh_options = &_ssh_options unless @ssh_options;"
NSQ_SOURCE_LINE 00000167 "  open2($reader, $writer, $ssh, @ssh_options, $host, @command);"
NSQ_SOURCE_LINE 00000168 "}"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "=item sshopen3 HOST, WRITER, READER, ERROR, COMMAND [, ARGS ... ]"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "Connects the supplied filehandles to the ssh process (in batch mode)."
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "=cut"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "sub sshopen3 {"
NSQ_SOURCE_LINE 00000177 "  my($host, $writer, $reader, $error, @command) = @_;"
NSQ_SOURCE_LINE 00000178 "  @ssh_options = &_ssh_options unless @ssh_options;"
NSQ_SOURCE_LINE 00000179 "  open3($writer, $reader, $error, $ssh, @ssh_options, $host, @command);"
NSQ_SOURCE_LINE 00000180 "}"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "sub _yesno {"
NSQ_SOURCE_LINE 00000183 "  print \"Proceed [y/N]:\";"
NSQ_SOURCE_LINE 00000184 "  my $x = scalar(<STDIN>);"
NSQ_SOURCE_LINE 00000185 "  $x =~ /^y/i;"
NSQ_SOURCE_LINE 00000186 "}"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "sub _ssh_options {"
NSQ_SOURCE_LINE 00000189 "  my $reader = IO::File->new();"
NSQ_SOURCE_LINE 00000190 "  my $writer = IO::File->new();"
NSQ_SOURCE_LINE 00000191 "  my $error  = IO::File->new();"
NSQ_SOURCE_LINE 00000192 "  open3($writer, $reader, $error, $ssh, '-V');"
NSQ_SOURCE_LINE 00000193 "  my $ssh_version = <$error>;"
NSQ_SOURCE_LINE 00000194 "  chomp($ssh_version);"
NSQ_SOURCE_LINE 00000195 "  if ( $ssh_version =~ /.*OpenSSH[-|_](\\w+)\\./ && $1 == 1 ) {"
NSQ_SOURCE_LINE 00000196 "    $equalspace = \" \";"
NSQ_SOURCE_LINE 00000197 "  } else {"
NSQ_SOURCE_LINE 00000198 "    $equalspace = \"=\";"
NSQ_SOURCE_LINE 00000199 "  }"
NSQ_SOURCE_LINE 00000200 "  my @options = ( '-o', 'BatchMode'.$equalspace.'yes' );"
NSQ_SOURCE_LINE 00000201 "  if ( $ssh_version =~ /.*OpenSSH[-|_](\\w+)\\./ && $1 > 1 ) {"
NSQ_SOURCE_LINE 00000202 "    unshift @options, '-T';"
NSQ_SOURCE_LINE 00000203 "  }"
NSQ_SOURCE_LINE 00000204 "  @options;"
NSQ_SOURCE_LINE 00000205 "}"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=back"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head1 EXAMPLE"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "  use Net::SSH qw(sshopen2);"
NSQ_SOURCE_LINE 00000212 "  use strict;"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "  my $user = \"username\";"
NSQ_SOURCE_LINE 00000215 "  my $host = \"hostname\";"
NSQ_SOURCE_LINE 00000216 "  my $cmd = \"command\";"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "  sshopen2(\"$user\\@$host\", *READER, *WRITER, \"$cmd\") || die \"ssh: $!\";"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "  while (<READER>) {"
NSQ_SOURCE_LINE 00000221 "      chomp();"
NSQ_SOURCE_LINE 00000222 "      print \"$_\\n\";"
NSQ_SOURCE_LINE 00000223 "  }"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "  close(READER);"
NSQ_SOURCE_LINE 00000226 "  close(WRITER);"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=head1 FREQUENTLY ASKED QUESTIONS"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "Q: How do you supply a password to connect with ssh within a perl script"
NSQ_SOURCE_LINE 00000231 "using the Net::SSH module?"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "A: You don't (at least not with this module).  Use RSA or DSA keys.  See the"
NSQ_SOURCE_LINE 00000234 "   quick help in the next section and the ssh-keygen(1) manpage."
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "A #2: See L<Net::SSH::Expect> instead."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "Q: My script is \"leaking\" ssh processes."
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "A: See L<perlfaq8/\"How do I avoid zombies on a Unix system\">, L<IPC::Open2>,"
NSQ_SOURCE_LINE 00000241 "L<IPC::Open3> and L<perlfunc/waitpid>."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head1 GENERATING AND USING SSH KEYS"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=over 4"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=item 1 Generate keys"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "Type:"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "   ssh-keygen -t rsa"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "And do not enter a passphrase unless you wanted to be prompted for"
NSQ_SOURCE_LINE 00000254 "one during file copying."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "Here is what you will see:"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "   $ ssh-keygen -t rsa"
NSQ_SOURCE_LINE 00000259 "   Generating public/private rsa key pair."
NSQ_SOURCE_LINE 00000260 "   Enter file in which to save the key (/home/User/.ssh/id_rsa):"
NSQ_SOURCE_LINE 00000261 "   Enter passphrase (empty for no passphrase):"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "   Enter same passphrase again:"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "   Your identification has been saved in /home/User/.ssh/id_rsa."
NSQ_SOURCE_LINE 00000266 "   Your public key has been saved in /home/User/.ssh/id_rsa.pub."
NSQ_SOURCE_LINE 00000267 "   The key fingerprint is:"
NSQ_SOURCE_LINE 00000268 "   5a:cd:2b:0a:cd:d9:15:85:26:79:40:0c:55:2a:f4:23 User@JEFF-CPU"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "=item 2 Copy public to machines you want to upload to"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "C<id_rsa.pub> is your public key. Copy it to C<~/.ssh> on target machine."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Put a copy of the public key file on each machine you want to log into."
NSQ_SOURCE_LINE 00000276 "Name the copy C<authorized_keys> (some implementations name this file"
NSQ_SOURCE_LINE 00000277 "C<authorized_keys2>)"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "Then type:"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "     chmod 600 authorized_keys"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "Then make sure your home dir on the remote machine is not group or"
NSQ_SOURCE_LINE 00000284 "world writeable."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=back"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=head1 AUTHORS"
NSQ_SOURCE_LINE 00000289 ""
