NSQ_SOURCE_LINE 00000001 "package Specio;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.008;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.53';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Module::Implementation;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Exporter qw( import );"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "BEGIN {"
NSQ_SOURCE_LINE 00000015 "    # This env var exists for the benefit of the PurePerlTests dzil plugin, which only knows how to"
NSQ_SOURCE_LINE 00000016 "    # set an env var to a true value."
NSQ_SOURCE_LINE 00000017 "    if ( $ENV{SPECIO_TEST_PP} ) {"
NSQ_SOURCE_LINE 00000018 "        ## no critic (Variables::RequireLocalizedPunctuationVars)"
NSQ_SOURCE_LINE 00000019 "        $ENV{SPECIO_IMPLEMENTATION} = 'PP';"
NSQ_SOURCE_LINE 00000020 "    }"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    my $loader = Module::Implementation::build_loader_sub("
NSQ_SOURCE_LINE 00000023 "        implementations => [ 'XS', 'PP' ],"
NSQ_SOURCE_LINE 00000024 "        symbols         => ['_clone'],"
NSQ_SOURCE_LINE 00000025 "    );"
NSQ_SOURCE_LINE 00000026 "    $loader->();"
NSQ_SOURCE_LINE 00000027 "}"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "# It's a bit weird to put this in the root module, but this way the env var that"
NSQ_SOURCE_LINE 00000030 "# Module::Implementation::build_loader_sub uses will be named \"SPECIO_IMPLEMENTATION\". That way, if"
NSQ_SOURCE_LINE 00000031 "# in the future there are other optional XS components besides the Clone implementation, we don't"
NSQ_SOURCE_LINE 00000032 "# end up with a bunch of different env vars."
NSQ_SOURCE_LINE 00000033 "#"
NSQ_SOURCE_LINE 00000034 "## no critic (Modules::ProhibitAutomaticExportation)"
NSQ_SOURCE_LINE 00000035 "our @EXPORT = qw( _clone );"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "1;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "# ABSTRACT: Type constraints and coercions for Perl"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "__END__"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=pod"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 NAME"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "Specio - Type constraints and coercions for Perl"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=head1 VERSION"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "version 0.53"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    package MyApp::Type::Library;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    use Specio::Declare;"
NSQ_SOURCE_LINE 00000060 "    use Specio::Library::Builtins;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    declare("
NSQ_SOURCE_LINE 00000063 "        'PositiveInt',"
NSQ_SOURCE_LINE 00000064 "        parent => t('Int'),"
NSQ_SOURCE_LINE 00000065 "        inline => sub {"
NSQ_SOURCE_LINE 00000066 "            $_[0]->parent->inline_check( $_[1] )"
NSQ_SOURCE_LINE 00000067 "                . ' && ( '"
NSQ_SOURCE_LINE 00000068 "                . $_[1]"
NSQ_SOURCE_LINE 00000069 "                . ' > 0 )';"
NSQ_SOURCE_LINE 00000070 "        },"
NSQ_SOURCE_LINE 00000071 "    );"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    # or ..."
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    declare("
NSQ_SOURCE_LINE 00000076 "        'PositiveInt',"
NSQ_SOURCE_LINE 00000077 "        parent => t('Int'),"
NSQ_SOURCE_LINE 00000078 "        where  => sub { $_[0] > 0 },"
NSQ_SOURCE_LINE 00000079 "    );"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    declare("
NSQ_SOURCE_LINE 00000082 "        'ArrayRefOfPositiveInt',"
NSQ_SOURCE_LINE 00000083 "        parent => t("
NSQ_SOURCE_LINE 00000084 "            'ArrayRef',"
NSQ_SOURCE_LINE 00000085 "            of => t('PositiveInt'),"
NSQ_SOURCE_LINE 00000086 "        ),"
NSQ_SOURCE_LINE 00000087 "    );"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    coerce("
NSQ_SOURCE_LINE 00000090 "        'ArrayRefOfPositiveInt',"
NSQ_SOURCE_LINE 00000091 "        from  => t('PositiveInt'),"
NSQ_SOURCE_LINE 00000092 "        using => sub { [ $_[0] ] },"
NSQ_SOURCE_LINE 00000093 "    );"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    any_can_type("
NSQ_SOURCE_LINE 00000096 "        'Duck',"
NSQ_SOURCE_LINE 00000097 "        methods => [ 'duck_walk', 'quack' ],"
NSQ_SOURCE_LINE 00000098 "    );"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    object_isa_type('MyApp::Person');"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "The C<Specio> distribution provides classes for representing type constraints"
NSQ_SOURCE_LINE 00000105 "and coercion, along with syntax sugar for declaring them."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "Note that this is not a proper type system for Perl. Nothing in this"
NSQ_SOURCE_LINE 00000108 "distribution will magically make the Perl interpreter start checking a value's"
NSQ_SOURCE_LINE 00000109 "type on assignment to a variable. In fact, there's no built-in way to apply a"
NSQ_SOURCE_LINE 00000110 "type to a variable at all."
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "Instead, you can explicitly check a value against a type, and optionally coerce"
NSQ_SOURCE_LINE 00000113 "values to that type."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=head1 WHAT IS A TYPE?"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "At it's core, a type is simply a constraint. A constraint is code that checks a"
NSQ_SOURCE_LINE 00000118 "value and returns true or false. Most constraints are represented by"
NSQ_SOURCE_LINE 00000119 "L<Specio::Constraint::Simple> objects. However, there are other type constraint"
NSQ_SOURCE_LINE 00000120 "classes for specialized kinds of constraints."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "Types can be named or anonymous, and each type can have a parent type. A type's"
NSQ_SOURCE_LINE 00000123 "constraint is optional because sometimes you may want to create a named subtype"
NSQ_SOURCE_LINE 00000124 "of some existing type without adding additional constraints."
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "Constraints can be expressed either in terms of a simple subroutine reference"
NSQ_SOURCE_LINE 00000127 "or in terms of an inline generator subroutine reference. The former is easier"
NSQ_SOURCE_LINE 00000128 "to write but the latter is preferred because it allow for better optimization."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "A type can also have an optional message generator subroutine reference. You"
NSQ_SOURCE_LINE 00000131 "can use this to provide a more intelligent error message when a value does not"
NSQ_SOURCE_LINE 00000132 "pass the constraint, though the default message should suffice for most cases."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Finally, you can associate a set of coercions with a type. A coercion is a"
NSQ_SOURCE_LINE 00000135 "subroutine reference (or inline generator, like constraints), that takes a"
NSQ_SOURCE_LINE 00000136 "value of one type and turns it into a value that matches the type the coercion"
NSQ_SOURCE_LINE 00000137 "belongs to."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 BUILTIN TYPES"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "This distribution ships with a set of builtin types representing the types"
NSQ_SOURCE_LINE 00000142 "provided by the Perl interpreter itself. They are arranged in a hierarchy as"
NSQ_SOURCE_LINE 00000143 "follows:"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "  Item"
NSQ_SOURCE_LINE 00000146 "      Bool"
NSQ_SOURCE_LINE 00000147 "      Maybe (of `a)"
NSQ_SOURCE_LINE 00000148 "      Undef"
NSQ_SOURCE_LINE 00000149 "      Defined"
NSQ_SOURCE_LINE 00000150 "          Value"
NSQ_SOURCE_LINE 00000151 "              Str"
NSQ_SOURCE_LINE 00000152 "                  Num"
NSQ_SOURCE_LINE 00000153 "                      Int"
NSQ_SOURCE_LINE 00000154 "                  ClassName"
NSQ_SOURCE_LINE 00000155 "          Ref"
NSQ_SOURCE_LINE 00000156 "              ScalarRef (of `a)"
NSQ_SOURCE_LINE 00000157 "              ArrayRef (of `a)"
NSQ_SOURCE_LINE 00000158 "              HashRef (of `a)"
NSQ_SOURCE_LINE 00000159 "              CodeRef"
NSQ_SOURCE_LINE 00000160 "              RegexpRef"
NSQ_SOURCE_LINE 00000161 "              GlobRef"
NSQ_SOURCE_LINE 00000162 "              FileHandle"
NSQ_SOURCE_LINE 00000163 "              Object"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "The C<Item> type accepts anything and everything."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "The C<Bool> type only accepts C<undef>, C<0>, or C<1>."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "The C<Undef> type only accepts C<undef>."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "The C<Defined> type accepts anything I<except> C<undef>."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "The C<Num> and C<Int> types are stricter about numbers than Perl is."
NSQ_SOURCE_LINE 00000174 "Specifically, they do not allow any sort of space in the number, nor do they"
NSQ_SOURCE_LINE 00000175 "accept \"Nan\", \"Inf\", or \"Infinity\"."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "The C<ClassName> type constraint checks that the name is valid I<and> that the"
NSQ_SOURCE_LINE 00000178 "class is loaded."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "The C<FileHandle> type accepts either a glob, a scalar filehandle, or anything"
NSQ_SOURCE_LINE 00000181 "that isa L<IO::Handle>."
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "All types accept overloaded objects that support the required operation. See"
NSQ_SOURCE_LINE 00000184 "below for details."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=head2 Overloading"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "Perl's overloading is horribly broken and doesn't make much sense at all."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "However, unlike Moose, all type constraints allow overloaded objects where they"
NSQ_SOURCE_LINE 00000191 "make sense."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "For types where overloading makes sense, we explicitly check that the object"
NSQ_SOURCE_LINE 00000194 "provides the type overloading we expect. We I<do not> simply try to use the"
NSQ_SOURCE_LINE 00000195 "object as the type in question and hope it works. This means that these checks"
NSQ_SOURCE_LINE 00000196 "effectively ignore the C<fallback> setting for the overloaded object. In other"
NSQ_SOURCE_LINE 00000197 "words, an object that overloads stringification will not pass the C<Bool> type"
NSQ_SOURCE_LINE 00000198 "check unless it I<also> overloads boolification."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "Most types do not check that the overloaded method actually returns something"
NSQ_SOURCE_LINE 00000201 "that matches the constraint. This may change in the future."
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "The C<Bool> type accepts an object that implements C<bool> overloading."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "The C<Str> type accepts an object that implements string (C<q{\"\"}>)"
NSQ_SOURCE_LINE 00000206 "overloading."
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "The C<Num> type accepts an object that implements numeric (C<'0+'}>)"
NSQ_SOURCE_LINE 00000209 "overloading. The C<Int> type does as well, but it will check that the"
NSQ_SOURCE_LINE 00000210 "overloading returns an actual integer."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "The C<ClassName> type will accept an object with string overloading that"
NSQ_SOURCE_LINE 00000213 "returns a class name."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "To make this all more confusing, the C<Value> type will I<never> accept an"
NSQ_SOURCE_LINE 00000216 "object, even though some of its subtypes will."
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "The various reference types all accept objects which provide the appropriate"
NSQ_SOURCE_LINE 00000219 "overloading. The C<FileHandle> type accepts an object which overloads"
NSQ_SOURCE_LINE 00000220 "globification as long as the returned glob is an open filehandle."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head1 PARAMETERIZABLE TYPES"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "Any type followed by a type parameter C<of `a> in the hierarchy above can be"
NSQ_SOURCE_LINE 00000225 "parameterized. The parameter is itself a type, so you can say you want an"
NSQ_SOURCE_LINE 00000226 "\"ArrayRef of Int\", or even an \"ArrayRef of HashRef of ScalarRef of ClassName\"."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "When they are parameterized, the C<ScalarRef> and C<ArrayRef> types check that"
NSQ_SOURCE_LINE 00000229 "the value(s) they refer to match the type parameter. For the C<HashRef> type,"
NSQ_SOURCE_LINE 00000230 "the parameter applies to the values (keys are never checked)."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=head2 Maybe"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "The C<Maybe> type is a special parameterized type. It allows for either"
NSQ_SOURCE_LINE 00000235 "C<undef> or a value. All by itself, it is meaningless, since it is equivalent"
NSQ_SOURCE_LINE 00000236 "to \"Maybe of Item\", which is equivalent to Item. When parameterized, it accepts"
NSQ_SOURCE_LINE 00000237 "either an C<undef> or the type of its parameter."
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "This is useful for optional attributes or parameters. However, you're probably"
NSQ_SOURCE_LINE 00000240 "better off making your code simply not pass the parameter at all This usually"
NSQ_SOURCE_LINE 00000241 "makes for a simpler API."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head1 REGISTRIES AND IMPORTING"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "Types are local to each package where they are used. When you \"import\" types"
NSQ_SOURCE_LINE 00000246 "from some other library, you are actually making a copy of that type."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "This means that a type named \"Foo\" in one package may not be the same as \"Foo\""
NSQ_SOURCE_LINE 00000249 "in another package. This has potential for confusion, but it also avoids the"
NSQ_SOURCE_LINE 00000250 "magic action at a distance pollution that comes with a global type naming"
NSQ_SOURCE_LINE 00000251 "system."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "The registry is managed internally by the Specio distribution's modules, and is"
NSQ_SOURCE_LINE 00000254 "not exposed to your code. To access a type, you always call C<t('TypeName')>."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "This returns the named type or dies if no such type exists."
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "Because types are always copied on import, it's safe to create coercions on any"
NSQ_SOURCE_LINE 00000259 "type. Your coercion from C<Str> to C<Int> will not be seen by any other"
NSQ_SOURCE_LINE 00000260 "package, unless that package explicitly imports your C<Int> type."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "When you import types, you import every type defined in the package you import"
NSQ_SOURCE_LINE 00000263 "from. However, you I<can> overwrite an imported type with your own type"
NSQ_SOURCE_LINE 00000264 "definition. You I<cannot> define the same type twice internally."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=head1 CREATING A TYPE LIBRARY"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "By default, all types created inside a package are invisible to other packages."
NSQ_SOURCE_LINE 00000269 "If you want to create a type library, you need to inherit from"
NSQ_SOURCE_LINE 00000270 "L<Specio::Exporter> package:"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "  package MyApp::Type::Library;"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "  use parent 'Specio::Exporter';"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "  use Specio::Declare;"
NSQ_SOURCE_LINE 00000277 "  use Specio::Library::Builtins;"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "  declare("
NSQ_SOURCE_LINE 00000280 "      'Foo',"
NSQ_SOURCE_LINE 00000281 "      parent => t('Str'),"
NSQ_SOURCE_LINE 00000282 "      where  => sub { $_[0] =~ /foo/i },"
NSQ_SOURCE_LINE 00000283 "  );"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "Now the MyApp::Type::Library package will export a single type named C<Foo>. It"
NSQ_SOURCE_LINE 00000286 "I<does not> re-export the types provided by L<Specio::Library::Builtins>."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "If you want to make your library re-export some other libraries types, you can"
NSQ_SOURCE_LINE 00000289 "ask for this explicitly:"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "  package MyApp::Type::Library;"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "  use parent 'Specio::Exporter';"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "  use Specio::Declare;"
NSQ_SOURCE_LINE 00000296 "  use Specio::Library::Builtins -reexport;"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "  declare( 'Foo, ... );"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "Now MyApp::Types::Library exports any types it defines, as well as all the"
NSQ_SOURCE_LINE 00000301 "types defined in L<Specio::Library::Builtins>."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=head1 DECLARING TYPES"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "Use the L<Specio::Declare> module to declare types. It exports a set of helpers"
NSQ_SOURCE_LINE 00000306 "for declaring types. See that module's documentation for more details on these"
NSQ_SOURCE_LINE 00000307 "helpers."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head1 USING SPECIO WITH L<Moose>"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "This should just work. Use a Specio type anywhere you'd specify a type."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "=head1 USING SPECIO WITH L<Moo>"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "Using Specio with Moo is easy. You can pass Specio constraint objects as C<isa>"
NSQ_SOURCE_LINE 00000316 "parameters for attributes. For coercions, simply call C<< $type->coercion_sub"
NSQ_SOURCE_LINE 00000317 ">>."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "    package Foo;"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "    use Specio::Declare;"
NSQ_SOURCE_LINE 00000322 "    use Specio::Library::Builtins;"
NSQ_SOURCE_LINE 00000323 "    use Moo;"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "    my $str_type = t('Str');"
NSQ_SOURCE_LINE 00000326 "    has string => ("
NSQ_SOURCE_LINE 00000327 "       is  => 'ro',"
NSQ_SOURCE_LINE 00000328 "       isa => $str_type,"
NSQ_SOURCE_LINE 00000329 "    );"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "    my $ucstr = declare("
NSQ_SOURCE_LINE 00000332 "        'UCStr',"
NSQ_SOURCE_LINE 00000333 "        parent => t('Str'),"
NSQ_SOURCE_LINE 00000334 "        where  => sub { $_[0] =~ /^[A-Z]+$/ },"
NSQ_SOURCE_LINE 00000335 "    );"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "    coerce("
NSQ_SOURCE_LINE 00000338 "        $ucstr,"
NSQ_SOURCE_LINE 00000339 "        from  => t('Str'),"
NSQ_SOURCE_LINE 00000340 "        using => sub { return uc $_[0] },"
NSQ_SOURCE_LINE 00000341 "    );"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "    has ucstr => ("
NSQ_SOURCE_LINE 00000344 "        is     => 'ro',"
NSQ_SOURCE_LINE 00000345 "        isa    => $ucstr,"
NSQ_SOURCE_LINE 00000346 "        coerce => $ucstr->coercion_sub,"
NSQ_SOURCE_LINE 00000347 "    );"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "The subs returned by Specio use L<Sub::Quote> internally and are suitable for"
NSQ_SOURCE_LINE 00000350 "inlining."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=head1 USING SPECIO WITH OTHER THINGS"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "See L<Specio::Constraint::Simple> for the API that all constraint objects"
NSQ_SOURCE_LINE 00000355 "share."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=head1 L<Moose>, L<MooseX::Types>, and Specio"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "This module aims to supplant both L<Moose>'s built-in type system (see"
NSQ_SOURCE_LINE 00000360 "L<Moose::Util::TypeConstraints> aka MUTC) and L<MooseX::Types>, which attempts"
NSQ_SOURCE_LINE 00000361 "to patch some of the holes in the Moose built-in type design."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "Here are some of the salient differences:"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "=over 4"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=item * Types names are strings, but they're not global"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "Unlike Moose and MooseX::Types, type names are always local to the current"
NSQ_SOURCE_LINE 00000370 "package. There is no possibility of name collision between different modules,"
NSQ_SOURCE_LINE 00000371 "so you can safely use short type names."
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "Unlike MooseX::Types, types are strings, so there is no possibility of"
NSQ_SOURCE_LINE 00000374 "colliding with existing class or subroutine names."
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "=item * No type auto-creation"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "Types are always retrieved using the C<t()> subroutine. If you pass an unknown"
NSQ_SOURCE_LINE 00000379 "name to this subroutine it dies. This is different from Moose and"
NSQ_SOURCE_LINE 00000380 "MooseX::Types, which assume that unknown names are class names."
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=item * Anon types are explicit"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "With L<Moose> and L<MooseX::Types>, you use the same subroutine, C<subtype()>,"
NSQ_SOURCE_LINE 00000385 "to declare both named and anonymous types. With Specio, you use C<declare()>"
NSQ_SOURCE_LINE 00000386 "for named types and C<anon()> for anonymous types."
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "=item * Class and object types are separate"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "Moose and MooseX::Types have C<class_type> and C<duck_type>. The former type"
NSQ_SOURCE_LINE 00000391 "requires an object, while the latter accepts a class name or object."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "With Specio, the distinction between accepting an object versus object or class"
NSQ_SOURCE_LINE 00000394 "is explicit. There are six declaration helpers, C<object_can_type>,"
NSQ_SOURCE_LINE 00000395 "C<object_does_type>, C<object_isa_type>, C<any_can_type>, C<any_does_type>, and"
NSQ_SOURCE_LINE 00000396 "C<any_isa_type>."
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "=item * Overloading support is baked in"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "Perl's overloading is quite broken but ignoring it makes Moose's type system"
NSQ_SOURCE_LINE 00000401 "frustrating to use in many cases."
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=item * Types can either have a constraint or inline generator, not both"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "Moose and MooseX::Types types can be defined with a subroutine reference as the"
NSQ_SOURCE_LINE 00000406 "constraint, an inline generator subroutine, or both. This is purely for"
NSQ_SOURCE_LINE 00000407 "backwards compatibility, and it makes the internals more complicated than they"
NSQ_SOURCE_LINE 00000408 "need to be."
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "With Specio, a constraint can have I<either> a subroutine reference or an"
NSQ_SOURCE_LINE 00000411 "inline generator, not both."
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "=item * Coercions can be inlined"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "I simply never got around to implementing this in Moose."
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "=item * No crazy coercion features"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "Moose has some bizarre (and mostly) undocumented features relating to coercions"
NSQ_SOURCE_LINE 00000420 "and parameterizable types. This is a misfeature."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "=back"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "=head1 OPTIONAL PREREQS"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "There are several optional prereqs that if installed will make this"
NSQ_SOURCE_LINE 00000427 "distribution better in some way."
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "=over 4"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "=item * L<Ref::Util>"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "Installing this will speed up a number of type checks for built-in types."
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "=item * L<XString>"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "If this is installed it will be loaded instead of the L<B> module if you have"
NSQ_SOURCE_LINE 00000438 "Perl 5.10 or greater. This module is much more memory efficient than loading"
NSQ_SOURCE_LINE 00000439 "all of L<B>."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=item * L<Sub::Util> or L<Sub::Name>"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "If one of these is installed then stack traces that end up in Specio code will"
NSQ_SOURCE_LINE 00000444 "have much better subroutine names for any frames."
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "=back"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "=head1 FORCING PURE PERL MODE"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "For some use cases (notably fatpacking a program), you may want to force Specio"
NSQ_SOURCE_LINE 00000451 "to use pure Perl code instead of XS code. This can be done by setting the"
NSQ_SOURCE_LINE 00000452 "environment variable C<SPECIO_IMPLEMENTATION> to C<PP>."
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "=head1 WHY THE NAME?"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "This distro was originally called \"Type\", but that's an awfully generic top"
NSQ_SOURCE_LINE 00000457 "level namespace. Specio is Latin for for \"look at\" and \"spec\" is the root for"
NSQ_SOURCE_LINE 00000458 "the word \"species\". It's short, relatively easy to type, and not used by any"
NSQ_SOURCE_LINE 00000459 "other distro."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "Bugs may be submitted at L<https://github.com/houseabsolute/Specio/issues>."
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "The source code repository for Specio can be found at L<https://github.com/houseabsolute/Specio>."
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=head1 DONATIONS"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "If you'd like to thank me for the work I've done on this module, please"
NSQ_SOURCE_LINE 00000472 "consider making a \"donation\" to me via PayPal. I spend a lot of free time"
NSQ_SOURCE_LINE 00000473 "creating free software, and would appreciate any support you'd care to offer."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "Please note that B<I am not suggesting that you must do this> in order for me"
NSQ_SOURCE_LINE 00000476 "to continue working on this particular software. I will continue to do so,"
NSQ_SOURCE_LINE 00000477 "inasmuch as I have in the past, for as long as it interests me."
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "Similarly, a donation made in this way will probably not make me work on this"
NSQ_SOURCE_LINE 00000480 "software much more, unless I get so many donations that I can consider working"
NSQ_SOURCE_LINE 00000481 "on free software full time (let's all have a chuckle at that together)."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "To donate, log into PayPal and send money to autarch@urth.org, or use the"
NSQ_SOURCE_LINE 00000484 "button at L<https://houseabsolute.com/foss-donations/>."
NSQ_SOURCE_LINE 00000485 ""
