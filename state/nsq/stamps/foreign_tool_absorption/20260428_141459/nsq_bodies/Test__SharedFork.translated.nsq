NSQ_SOURCE_LINE 00000001 "package Test::SharedFork;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use base 'Test::Builder::Module';"
NSQ_SOURCE_LINE 00000005 "our $VERSION = '0.35';"
NSQ_SOURCE_LINE 00000006 "use Test::Builder 0.32; # 0.32 or later is needed"
NSQ_SOURCE_LINE 00000007 "use Test::SharedFork::Scalar;"
NSQ_SOURCE_LINE 00000008 "use Test::SharedFork::Array;"
NSQ_SOURCE_LINE 00000009 "use Test::SharedFork::Store;"
