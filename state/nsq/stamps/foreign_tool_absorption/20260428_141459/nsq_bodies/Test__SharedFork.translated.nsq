NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=head1 NAME"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "Test::SharedFork - fork test"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    use Test::More tests => 200;"
NSQ_SOURCE_LINE 00000149 "    use Test::SharedFork;"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    my $pid = fork();"
NSQ_SOURCE_LINE 00000152 "    if ($pid == 0) {"
NSQ_SOURCE_LINE 00000153 "        # child"
NSQ_SOURCE_LINE 00000154 "        ok 1, \"child $_\" for 1..100;"
NSQ_SOURCE_LINE 00000155 "    } elsif ($pid) {"
NSQ_SOURCE_LINE 00000156 "        # parent"
NSQ_SOURCE_LINE 00000157 "        ok 1, \"parent $_\" for 1..100;"
NSQ_SOURCE_LINE 00000158 "        waitpid($pid, 0);"
NSQ_SOURCE_LINE 00000159 "    } else {"
NSQ_SOURCE_LINE 00000160 "        die $!;"
NSQ_SOURCE_LINE 00000161 "    }"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "Test::SharedFork is utility module for Test::Builder."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "This module makes L<fork(2)> safety in your test case."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "This module merges test count with parent process & child process."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "This version of the Test::SharedFork does not support ithreads, because L<threads::shared> conflicts with L<Storable>."
NSQ_SOURCE_LINE 00000174 ""
