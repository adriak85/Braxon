NSQ_SOURCE_LINE 00000011 "use 5.008000;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "{"
NSQ_SOURCE_LINE 00000014 "    package #"
NSQ_SOURCE_LINE 00000015 "        Test::SharedFork::Contextual;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "    sub call {"
NSQ_SOURCE_LINE 00000018 "        my $code = shift;"
NSQ_SOURCE_LINE 00000019 "        my $wantarray = [caller(1)]->[5];"
NSQ_SOURCE_LINE 00000020 "        if ($wantarray) {"
NSQ_SOURCE_LINE 00000021 "            my @result = $code->();"
NSQ_SOURCE_LINE 00000022 "            bless {result => \\@result, wantarray => $wantarray}, __PACKAGE__;"
NSQ_SOURCE_LINE 00000023 "        } elsif (defined $wantarray) {"
NSQ_SOURCE_LINE 00000024 "            my $result = $code->();"
NSQ_SOURCE_LINE 00000025 "            bless {result => $result, wantarray => $wantarray}, __PACKAGE__;"
NSQ_SOURCE_LINE 00000026 "        } else {"
NSQ_SOURCE_LINE 00000027 "            { ; $code->(); } # void context"
NSQ_SOURCE_LINE 00000028 "            bless {wantarray => $wantarray}, __PACKAGE__;"
NSQ_SOURCE_LINE 00000029 "        }"
NSQ_SOURCE_LINE 00000030 "    }"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    sub result {"
NSQ_SOURCE_LINE 00000033 "        my $self = shift;"
NSQ_SOURCE_LINE 00000034 "        if ($self->{wantarray}) {"
NSQ_SOURCE_LINE 00000035 "            return @{ $self->{result} };"
NSQ_SOURCE_LINE 00000036 "        } elsif (defined $self->{wantarray}) {"
NSQ_SOURCE_LINE 00000037 "            return $self->{result};"
NSQ_SOURCE_LINE 00000038 "        } else {"
NSQ_SOURCE_LINE 00000039 "            return;"
NSQ_SOURCE_LINE 00000040 "        }"
NSQ_SOURCE_LINE 00000041 "    }"
NSQ_SOURCE_LINE 00000042 "}"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "my $STORE;"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "sub _mangle_builder {"
NSQ_SOURCE_LINE 00000047 "    my $builder = shift;"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    if( $] >= 5.008001 && $Config{useithreads} && $INC{'threads.pm'} ) {"
NSQ_SOURCE_LINE 00000050 "        die \"# Current version of Test::SharedFork does not supports ithreads.\";"
NSQ_SOURCE_LINE 00000051 "    }"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    if ($builder->can(\"coordinate_forks\")) {"
NSQ_SOURCE_LINE 00000054 "        # Use Test::Builder's implementation."
NSQ_SOURCE_LINE 00000055 "        $builder->new->coordinate_forks(1);"
NSQ_SOURCE_LINE 00000056 "    } elsif($INC{'Test2/Global.pm'} || $INC{'Test2/API.pm'} || $INC{'Test2/Context.pm'}) {"
NSQ_SOURCE_LINE 00000057 "        require Test2::Global;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "        Test2::Global::test2_ipc_enable_polling();"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "        # Check if we already have IPC"
NSQ_SOURCE_LINE 00000062 "        my $stack = $builder->{Stack};"
NSQ_SOURCE_LINE 00000063 "        return if $stack->top->ipc;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "        # Find a driver"
NSQ_SOURCE_LINE 00000066 "        my ($driver) = Test2::Global::test2_ipc_drivers();"
NSQ_SOURCE_LINE 00000067 "        unless ($driver) {"
NSQ_SOURCE_LINE 00000068 "            require Test2::IPC::Driver::Files;"
NSQ_SOURCE_LINE 00000069 "            $driver = 'Test2::IPC::Driver::Files';"
NSQ_SOURCE_LINE 00000070 "        }"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "        # Add the IPC to all hubs"
NSQ_SOURCE_LINE 00000073 "        my $ipc = $driver->new();"
NSQ_SOURCE_LINE 00000074 "        for my $hub (@$stack) {"
NSQ_SOURCE_LINE 00000075 "            $hub->set_ipc($ipc);"
NSQ_SOURCE_LINE 00000076 "            $ipc->add_hub($hub->hid);"
NSQ_SOURCE_LINE 00000077 "        }"
NSQ_SOURCE_LINE 00000078 "    } elsif($INC{'Test/Stream/Sync.pm'}) {"
NSQ_SOURCE_LINE 00000079 "        require Test::Stream::IPC;"
NSQ_SOURCE_LINE 00000080 "        Test::Stream::IPC->import('poll');"
NSQ_SOURCE_LINE 00000081 "        Test::Stream::IPC->enable_polling if Test::Stream::IPC->can('enable_polling');"
NSQ_SOURCE_LINE 00000082 "        my $stack = $builder->{Stack};"
NSQ_SOURCE_LINE 00000083 "        return if $stack->top->ipc;"
NSQ_SOURCE_LINE 00000084 "        my ($driver) = Test::Stream::IPC->drivers;"
NSQ_SOURCE_LINE 00000085 "        my $ipc = $driver->new();"
NSQ_SOURCE_LINE 00000086 "        for my $hub (@$stack) {"
NSQ_SOURCE_LINE 00000087 "            $hub->set_ipc($ipc);"
NSQ_SOURCE_LINE 00000088 "            $ipc->add_hub($hub->hid);"
NSQ_SOURCE_LINE 00000089 "        }"
NSQ_SOURCE_LINE 00000090 "    } else {"
NSQ_SOURCE_LINE 00000091 "        # older Test::Builder"
NSQ_SOURCE_LINE 00000092 "        $STORE = Test::SharedFork::Store->new("
NSQ_SOURCE_LINE 00000093 "            cb => sub {"
NSQ_SOURCE_LINE 00000094 "                my $store = shift;"
NSQ_SOURCE_LINE 00000095 "                tie $builder->{Curr_Test}, 'Test::SharedFork::Scalar',"
NSQ_SOURCE_LINE 00000096 "                    $store, 'Curr_Test';"
NSQ_SOURCE_LINE 00000097 "                tie $builder->{Is_Passing}, 'Test::SharedFork::Scalar',"
NSQ_SOURCE_LINE 00000098 "                    $store, 'Is_Passing';"
NSQ_SOURCE_LINE 00000099 "                tie @{ $builder->{Test_Results} },"
NSQ_SOURCE_LINE 00000100 "                    'Test::SharedFork::Array', $store, 'Test_Results';"
NSQ_SOURCE_LINE 00000101 "            },"
NSQ_SOURCE_LINE 00000102 "            init => +{"
NSQ_SOURCE_LINE 00000103 "                Test_Results => $builder->{Test_Results},"
NSQ_SOURCE_LINE 00000104 "                Curr_Test    => $builder->{Curr_Test},"
NSQ_SOURCE_LINE 00000105 "                Is_Passing   => 1,"
NSQ_SOURCE_LINE 00000106 "            },"
NSQ_SOURCE_LINE 00000107 "        );"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "        # make methods atomic."
NSQ_SOURCE_LINE 00000110 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000111 "        no warnings 'redefine';"
NSQ_SOURCE_LINE 00000112 "        no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000113 "        for my $name (qw/ok skip todo_skip current_test is_passing/) {"
NSQ_SOURCE_LINE 00000114 "            my $orig = *{\"Test::Builder::${name}\"}{CODE};"
NSQ_SOURCE_LINE 00000115 "            *{\"Test::Builder::${name}\"} = sub {"
NSQ_SOURCE_LINE 00000116 "                local $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000117 "                local $Test::Builder::BLevel = $Test::Builder::BLevel + 1;"
NSQ_SOURCE_LINE 00000118 "                my $lock = $STORE->get_lock(); # RAII"
NSQ_SOURCE_LINE 00000119 "                $orig->(@_);"
NSQ_SOURCE_LINE 00000120 "            };"
NSQ_SOURCE_LINE 00000121 "        };"
NSQ_SOURCE_LINE 00000122 "    }"
NSQ_SOURCE_LINE 00000123 "}"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "BEGIN {"
NSQ_SOURCE_LINE 00000126 "    my $builder = __PACKAGE__->builder;"
NSQ_SOURCE_LINE 00000127 "    _mangle_builder($builder);"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "{"
NSQ_SOURCE_LINE 00000131 "    # backward compatibility method"
NSQ_SOURCE_LINE 00000132 "    sub parent { }"
NSQ_SOURCE_LINE 00000133 "    sub child  { }"
NSQ_SOURCE_LINE 00000134 "    sub fork   { fork() }"
NSQ_SOURCE_LINE 00000135 "}"
NSQ_SOURCE_LINE 00000136 ""
