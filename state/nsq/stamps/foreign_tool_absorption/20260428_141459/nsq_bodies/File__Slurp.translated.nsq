NSQ_SOURCE_LINE 00000064 "sub read_file {"
NSQ_SOURCE_LINE 00000065 "\tmy $file_name = shift;"
NSQ_SOURCE_LINE 00000066 "\tmy $opts = (ref $_[0] eq 'HASH') ? shift : {@_};"
NSQ_SOURCE_LINE 00000067 "\t# options we care about:"
NSQ_SOURCE_LINE 00000068 "\t# array_ref binmode blk_size buf_ref chomp err_mode scalar_ref"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "\t# let's see if we have a stringified object before doing anything else"
NSQ_SOURCE_LINE 00000071 "\t# We then only have to deal with when we are given a file handle/globref"
NSQ_SOURCE_LINE 00000072 "\tif (ref($file_name)) {"
NSQ_SOURCE_LINE 00000073 "\t\tmy $ref_result = _check_ref($file_name, $opts);"
NSQ_SOURCE_LINE 00000074 "\t\tif (ref($ref_result)) {"
NSQ_SOURCE_LINE 00000075 "\t\t\t@_ = ($opts, $ref_result);"
NSQ_SOURCE_LINE 00000076 "\t\t\tgoto &_error;"
NSQ_SOURCE_LINE 00000077 "\t\t}"
NSQ_SOURCE_LINE 00000078 "\t\t$file_name = $ref_result if $ref_result;"
NSQ_SOURCE_LINE 00000079 "\t\t# we have now stringified $file_name if possible. if it's still a ref"
NSQ_SOURCE_LINE 00000080 "\t\t# then we probably have a file handle"
NSQ_SOURCE_LINE 00000081 "\t}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "\tmy $fh;"
NSQ_SOURCE_LINE 00000084 "\tif (ref($file_name)) {"
NSQ_SOURCE_LINE 00000085 "\t\t$fh = $file_name;"
NSQ_SOURCE_LINE 00000086 "\t}"
NSQ_SOURCE_LINE 00000087 "\telse {"
NSQ_SOURCE_LINE 00000088 "\t\t# to keep with the old ways, read in :raw by default"
NSQ_SOURCE_LINE 00000089 "\t\tunless (open $fh, \"<:raw\", $file_name) {"
NSQ_SOURCE_LINE 00000090 "\t\t\t@_ = ($opts, \"read_file '$file_name' - open: $!\");"
NSQ_SOURCE_LINE 00000091 "\t\t\tgoto &_error;"
NSQ_SOURCE_LINE 00000092 "\t\t}"
NSQ_SOURCE_LINE 00000093 "\t\t# even though we set raw, let binmode take place here (busted)"
NSQ_SOURCE_LINE 00000094 "\t\tif (my $bm = $opts->{binmode}) {"
NSQ_SOURCE_LINE 00000095 "\t\t\tbinmode $fh, $bm;"
NSQ_SOURCE_LINE 00000096 "\t\t}"
NSQ_SOURCE_LINE 00000097 "\t}"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "\t# we are now sure to have an open file handle. Let's slurp it in the same"
NSQ_SOURCE_LINE 00000100 "\t# way that File::Slurper does."
NSQ_SOURCE_LINE 00000101 "\tmy $buf;"
NSQ_SOURCE_LINE 00000102 "\tmy $buf_ref = $opts->{buf_ref} || \\$buf;"
NSQ_SOURCE_LINE 00000103 "\t${$buf_ref} = '';"
NSQ_SOURCE_LINE 00000104 "\tmy $blk_size = $opts->{blk_size} || 1024 * 1024;"
NSQ_SOURCE_LINE 00000105 "\tif (my $size = -f $fh && -s _) {"
NSQ_SOURCE_LINE 00000106 "\t\t$blk_size = $size if $size < $blk_size;"
NSQ_SOURCE_LINE 00000107 "\t\tmy ($pos, $read) = 0;"
NSQ_SOURCE_LINE 00000108 "\t\tdo {"
NSQ_SOURCE_LINE 00000109 "\t\t\tunless(defined($read = read $fh, ${$buf_ref}, $blk_size, $pos)) {"
NSQ_SOURCE_LINE 00000110 "\t\t\t\t@_ = ($opts, \"read_file '$file_name' - read: $!\");"
NSQ_SOURCE_LINE 00000111 "\t\t\t\tgoto &_error;"
NSQ_SOURCE_LINE 00000112 "\t\t\t}"
NSQ_SOURCE_LINE 00000113 "\t\t\t$pos += $read;"
NSQ_SOURCE_LINE 00000114 "\t\t} while ($read && $pos < $size);"
NSQ_SOURCE_LINE 00000115 "\t}"
NSQ_SOURCE_LINE 00000116 "\telse {"
NSQ_SOURCE_LINE 00000117 "\t\t${$buf_ref} = do { local $/; <$fh> };"
NSQ_SOURCE_LINE 00000118 "\t}"
NSQ_SOURCE_LINE 00000119 "\tseek($fh, $opts->{_data_tell}, SEEK_SET) if $opts->{_is_data} && $opts->{_data_tell};"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "\t# line endings if we're on Windows"
NSQ_SOURCE_LINE 00000122 "\t${$buf_ref} =~ s/\\015\\012/\\012/g if ${$buf_ref} && $is_win32 && !$opts->{binmode};"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "\t# we now have a buffer filled with the file content. Figure out how to"
NSQ_SOURCE_LINE 00000125 "\t# return it to the user"
NSQ_SOURCE_LINE 00000126 "\tmy $want_array = wantarray; # let's only ask for this once"
NSQ_SOURCE_LINE 00000127 "\tif ($want_array || $opts->{array_ref}) {"
NSQ_SOURCE_LINE 00000128 "\t\tuse re 'taint';"
NSQ_SOURCE_LINE 00000129 "\t\tmy $sep = $/;"
NSQ_SOURCE_LINE 00000130 "\t\t$sep = '\\n\\n+' if defined $sep && $sep eq '';"
NSQ_SOURCE_LINE 00000131 "\t\t# split the buffered content into lines"
NSQ_SOURCE_LINE 00000132 "\t\tmy @lines = length(${$buf_ref}) ?"
NSQ_SOURCE_LINE 00000133 "\t\t\t${$buf_ref} =~ /(.*?$sep|.+)/sg : ();"
NSQ_SOURCE_LINE 00000134 "\t\tchomp @lines if $opts->{chomp};"
NSQ_SOURCE_LINE 00000135 "\t\treturn \\@lines if $opts->{array_ref};"
NSQ_SOURCE_LINE 00000136 "\t\treturn @lines;"
NSQ_SOURCE_LINE 00000137 "\t}"
NSQ_SOURCE_LINE 00000138 "\treturn $buf_ref if $opts->{scalar_ref};"
NSQ_SOURCE_LINE 00000139 "\t# if the function was called in scalar context, return the contents"
NSQ_SOURCE_LINE 00000140 "\treturn ${$buf_ref} if defined $want_array;"
NSQ_SOURCE_LINE 00000141 "\t# if we were called in void context, return nothing"
NSQ_SOURCE_LINE 00000142 "\treturn;"
NSQ_SOURCE_LINE 00000143 "}"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "# errors in this sub are returned as scalar refs"
NSQ_SOURCE_LINE 00000146 "# a normal IO/GLOB handle is an empty return"
NSQ_SOURCE_LINE 00000147 "# an overloaded object returns its stringified as a scalarfilename"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "sub _check_ref {"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "\tmy( $handle, $opts ) = @_ ;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "# check if we are reading from a handle (GLOB or IO object)"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "\tif ( eval { $handle->isa( 'GLOB' ) || $handle->isa( 'IO' ) } ) {"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "# we have a handle. deal with seeking to it if it is DATA"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "\t\tmy $err = _seek_data_handle( $handle, $opts ) ;"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "# return the error string if any"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "\t\treturn \\$err if $err ;"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "# we have good handle"
NSQ_SOURCE_LINE 00000166 "\t\treturn ;"
NSQ_SOURCE_LINE 00000167 "\t}"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "\teval { require overload } ;"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "# return an error if we can't load the overload pragma"
NSQ_SOURCE_LINE 00000172 "# or if the object isn't overloaded"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "\treturn \\\"Bad handle '$handle' is not a GLOB or IO object or overloaded\""
NSQ_SOURCE_LINE 00000175 "\t\t if $@ || !overload::Overloaded( $handle ) ;"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "# must be overloaded so return its stringified value"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "\treturn \"$handle\" ;"
NSQ_SOURCE_LINE 00000180 "}"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "sub _seek_data_handle {"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "\tmy( $handle, $opts ) = @_ ;"
NSQ_SOURCE_LINE 00000185 "\t# store some meta-data about the __DATA__ file handle"
NSQ_SOURCE_LINE 00000186 "\t$opts->{_is_data} = 0;"
NSQ_SOURCE_LINE 00000187 "\t$opts->{_data_tell} = 0;"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "# DEEP DARK MAGIC. this checks the UNTAINT IO flag of a"
NSQ_SOURCE_LINE 00000190 "# glob/handle. only the DATA handle is untainted (since it is from"
NSQ_SOURCE_LINE 00000191 "# trusted data in the source file). this allows us to test if this is"
NSQ_SOURCE_LINE 00000192 "# the DATA handle and then to do a sysseek to make sure it gets"
NSQ_SOURCE_LINE 00000193 "# slurped correctly. on some systems, the buffered i/o pointer is not"
NSQ_SOURCE_LINE 00000194 "# left at the same place as the fd pointer. this sysseek makes them"
NSQ_SOURCE_LINE 00000195 "# the same so slurping with sysread will work."
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "\teval{ require B } ;"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "\tif ( $@ ) {"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "\t\treturn <<ERR ;"
NSQ_SOURCE_LINE 00000202 "Can't find B.pm with this Perl: $!."
NSQ_SOURCE_LINE 00000203 "That module is needed to properly slurp the DATA handle."
NSQ_SOURCE_LINE 00000204 "ERR"
NSQ_SOURCE_LINE 00000205 "\t}"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "\tif ( B::svref_2object( $handle )->IO->IoFLAGS & 16 ) {"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "\t\t# we now know we have the data handle. Let's store its original"
NSQ_SOURCE_LINE 00000210 "\t\t# location in the file so that we can put it back after the read."
NSQ_SOURCE_LINE 00000211 "\t\t# this is only done for Bugwards-compatibility in some dists such as"
NSQ_SOURCE_LINE 00000212 "\t\t# CPAN::Index::API that made use of the oddity where sysread was in use"
NSQ_SOURCE_LINE 00000213 "\t\t# before"
NSQ_SOURCE_LINE 00000214 "\t\t$opts->{_is_data} = 1;"
NSQ_SOURCE_LINE 00000215 "\t\t$opts->{_data_tell} = tell($handle);"
NSQ_SOURCE_LINE 00000216 "# set the seek position to the current tell."
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "\t\t# unless( sysseek( $handle, tell( $handle ), SEEK_SET ) ) {"
NSQ_SOURCE_LINE 00000219 "\t\t# \treturn \"read_file '$handle' - sysseek: $!\" ;"
NSQ_SOURCE_LINE 00000220 "\t\t# }"
NSQ_SOURCE_LINE 00000221 "\t}"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "# seek was successful, return no error string"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "\treturn ;"
NSQ_SOURCE_LINE 00000226 "}"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "*wf = \\&write_file ;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "sub write_file {"
NSQ_SOURCE_LINE 00000231 "\tmy $file_name = shift;"
NSQ_SOURCE_LINE 00000232 "\tmy $opts = (ref $_[0] eq 'HASH') ? shift : {};"
NSQ_SOURCE_LINE 00000233 "\t# options we care about:"
NSQ_SOURCE_LINE 00000234 "\t# append atomic binmode buf_ref err_mode no_clobber perms"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "\tmy $fh;"
NSQ_SOURCE_LINE 00000237 "\tmy $no_truncate = 0;"
NSQ_SOURCE_LINE 00000238 "\tmy $orig_filename;"
NSQ_SOURCE_LINE 00000239 "\t# let's see if we have a stringified object or some sort of handle"
NSQ_SOURCE_LINE 00000240 "\t# or globref before doing anything else"
NSQ_SOURCE_LINE 00000241 "\tif (ref($file_name)) {"
NSQ_SOURCE_LINE 00000242 "\t\tmy $ref_result = _check_ref($file_name, $opts);"
NSQ_SOURCE_LINE 00000243 "\t\tif (ref($ref_result)) {"
NSQ_SOURCE_LINE 00000244 "\t\t\t# some error happened while checking for a ref"
NSQ_SOURCE_LINE 00000245 "\t\t\t@_ = ($opts, $ref_result);"
NSQ_SOURCE_LINE 00000246 "\t\t\tgoto &_error;"
NSQ_SOURCE_LINE 00000247 "\t\t}"
NSQ_SOURCE_LINE 00000248 "\t\tif ($ref_result) {"
NSQ_SOURCE_LINE 00000249 "\t\t\t# we have now stringified $file_name from the overloaded obj"
NSQ_SOURCE_LINE 00000250 "\t\t\t$file_name = $ref_result;"
NSQ_SOURCE_LINE 00000251 "\t\t}"
NSQ_SOURCE_LINE 00000252 "\t\telse {"
NSQ_SOURCE_LINE 00000253 "\t\t\t# we now have a proper handle ref"
NSQ_SOURCE_LINE 00000254 "\t\t\t# make sure we don't call truncate on it"
NSQ_SOURCE_LINE 00000255 "\t\t\t$fh = $file_name;"
NSQ_SOURCE_LINE 00000256 "\t\t\t$no_truncate = 1;"
NSQ_SOURCE_LINE 00000257 "\t\t\t# can't do atomic or permissions on a file handle"
NSQ_SOURCE_LINE 00000258 "\t\t\tdelete $opts->{atomic};"
NSQ_SOURCE_LINE 00000259 "\t\t\tdelete $opts->{perms};"
NSQ_SOURCE_LINE 00000260 "\t\t}"
NSQ_SOURCE_LINE 00000261 "\t}"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "\t# open the file for writing if we were given a filename"
NSQ_SOURCE_LINE 00000264 "\tunless ($fh) {"
NSQ_SOURCE_LINE 00000265 "\t\t$orig_filename = $file_name;"
NSQ_SOURCE_LINE 00000266 "\t\tmy $perms = defined($opts->{perms}) ? $opts->{perms} : 0666;"
NSQ_SOURCE_LINE 00000267 "\t\t# set the mode for the sysopen"
NSQ_SOURCE_LINE 00000268 "\t\tmy $mode = O_WRONLY | O_CREAT;"
NSQ_SOURCE_LINE 00000269 "\t\t$mode |= O_APPEND if $opts->{append};"
NSQ_SOURCE_LINE 00000270 "\t\t$mode |= O_EXCL if $opts->{no_clobber};"
NSQ_SOURCE_LINE 00000271 "\t\tif ($opts->{atomic}) {"
NSQ_SOURCE_LINE 00000272 "\t\t\t# in an atomic write, we must open a new file in the same directory"
NSQ_SOURCE_LINE 00000273 "\t\t\t# as the original to account for ACLs. We must also set the new file"
NSQ_SOURCE_LINE 00000274 "\t\t\t# to the same permissions as the original unless overridden by the"
NSQ_SOURCE_LINE 00000275 "\t\t\t# caller's request to set a specified permission set."
NSQ_SOURCE_LINE 00000276 "\t\t\tmy $dir = File::Spec->rel2abs(File::Basename::dirname($file_name));"
NSQ_SOURCE_LINE 00000277 "\t\t\tif (!defined($opts->{perms}) && -e $file_name && -f _) {"
NSQ_SOURCE_LINE 00000278 "\t\t\t\t$perms = 07777 & (stat $file_name)[2];"
NSQ_SOURCE_LINE 00000279 "\t\t\t}"
NSQ_SOURCE_LINE 00000280 "\t\t\t# we must ensure we're using a good temporary filename (doesn't already"
NSQ_SOURCE_LINE 00000281 "\t\t\t# exist). This is slower, but safer."
NSQ_SOURCE_LINE 00000282 "\t\t\t{"
NSQ_SOURCE_LINE 00000283 "\t\t\t\tlocal $^W = 0; # AYFKM"
NSQ_SOURCE_LINE 00000284 "\t\t\t\t(undef, $file_name) = tempfile('.tempXXXXX', DIR => $dir, OPEN => 0);"
NSQ_SOURCE_LINE 00000285 "\t\t\t}"
NSQ_SOURCE_LINE 00000286 "\t\t}"
NSQ_SOURCE_LINE 00000287 "\t\t$fh = local *FH;"
NSQ_SOURCE_LINE 00000288 "\t\tunless (sysopen($fh, $file_name, $mode, $perms)) {"
NSQ_SOURCE_LINE 00000289 "\t\t\t@_ = ($opts, \"write_file '$file_name' - sysopen: $!\");"
NSQ_SOURCE_LINE 00000290 "\t\t\tgoto &_error;"
NSQ_SOURCE_LINE 00000291 "\t\t}"
NSQ_SOURCE_LINE 00000292 "\t}"
NSQ_SOURCE_LINE 00000293 "\t# we now have an open file handle as well as data to write to that handle"
NSQ_SOURCE_LINE 00000294 "\tif (my $binmode = $opts->{binmode}) {"
NSQ_SOURCE_LINE 00000295 "\t\tbinmode($fh, $binmode);"
NSQ_SOURCE_LINE 00000296 "\t}"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "\t# get the data to print to the file"
NSQ_SOURCE_LINE 00000299 "\t# get the buffer ref - it depends on how the data is passed in"
NSQ_SOURCE_LINE 00000300 "\t# after this if/else $buf_ref will have a scalar ref to the data"
NSQ_SOURCE_LINE 00000301 "\tmy $buf_ref;"
NSQ_SOURCE_LINE 00000302 "\tmy $data_is_ref = 0;"
NSQ_SOURCE_LINE 00000303 "\tif (ref($opts->{buf_ref}) eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000304 "\t\t# a scalar ref passed in %opts has the data"
NSQ_SOURCE_LINE 00000305 "\t\t# note that the data was passed by ref"
NSQ_SOURCE_LINE 00000306 "\t\t$buf_ref = $opts->{buf_ref};"
NSQ_SOURCE_LINE 00000307 "\t\t$data_is_ref = 1;"
NSQ_SOURCE_LINE 00000308 "\t}"
NSQ_SOURCE_LINE 00000309 "\telsif (ref($_[0]) eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000310 "\t\t# the first value in @_ is the scalar ref to the data"
NSQ_SOURCE_LINE 00000311 "\t\t# note that the data was passed by ref"
NSQ_SOURCE_LINE 00000312 "\t\t$buf_ref = shift;"
NSQ_SOURCE_LINE 00000313 "\t\t$data_is_ref = 1;"
NSQ_SOURCE_LINE 00000314 "\t}"
NSQ_SOURCE_LINE 00000315 "\telsif (ref($_[0]) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000316 "\t\t# the first value in @_ is the array ref to the data so join it."
NSQ_SOURCE_LINE 00000317 "\t\t${$buf_ref} = join '', @{$_[0]};"
NSQ_SOURCE_LINE 00000318 "\t}"
NSQ_SOURCE_LINE 00000319 "\telse {"
NSQ_SOURCE_LINE 00000320 "\t\t# good old @_ has all the data so join it."
NSQ_SOURCE_LINE 00000321 "\t\t${$buf_ref} = join '', @_;"
NSQ_SOURCE_LINE 00000322 "\t}"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "\t# seek and print"
NSQ_SOURCE_LINE 00000325 "\tseek($fh, 0, SEEK_END) if $opts->{append};"
NSQ_SOURCE_LINE 00000326 "\tprint {$fh} ${$buf_ref};"
NSQ_SOURCE_LINE 00000327 "\ttruncate($fh, tell($fh)) unless $no_truncate;"
NSQ_SOURCE_LINE 00000328 "\tclose($fh);"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "\tif ($opts->{atomic} && !rename($file_name, $orig_filename)) {"
NSQ_SOURCE_LINE 00000331 "\t\t@_ = ($opts, \"write_file '$file_name' - rename: $!\");"
NSQ_SOURCE_LINE 00000332 "\t\tgoto &_error;"
NSQ_SOURCE_LINE 00000333 "\t}"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "\treturn 1;"
NSQ_SOURCE_LINE 00000336 "}"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "# this is for backwards compatibility with the previous File::Slurp module."
NSQ_SOURCE_LINE 00000339 "# write_file always overwrites an existing file"
NSQ_SOURCE_LINE 00000340 "*overwrite_file = \\&write_file ;"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "# the current write_file has an append mode so we use that. this"
NSQ_SOURCE_LINE 00000343 "# supports the same API with an optional second argument which is a"
NSQ_SOURCE_LINE 00000344 "# hash ref of options."
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "sub append_file {"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "# get the optional opts hash ref"
NSQ_SOURCE_LINE 00000349 "\tmy $opts = $_[1] ;"
NSQ_SOURCE_LINE 00000350 "\tif ( ref $opts eq 'HASH' ) {"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "# we were passed an opts ref so just mark the append mode"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "\t\t$opts->{append} = 1 ;"
NSQ_SOURCE_LINE 00000355 "\t}"
NSQ_SOURCE_LINE 00000356 "\telse {"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "# no opts hash so insert one with the append mode"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "\t\tsplice( @_, 1, 0, { append => 1 } ) ;"
NSQ_SOURCE_LINE 00000361 "\t}"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "# magic goto the main write_file sub. this overlays the sub without touching"
NSQ_SOURCE_LINE 00000364 "# the stack or @_"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "\tgoto &write_file"
NSQ_SOURCE_LINE 00000367 "}"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "# prepend data to the beginning of a file"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "sub prepend_file {"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "\tmy $file_name = shift ;"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "#print \"FILE $file_name\\n\" ;"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "\tmy $opts = ( ref $_[0] eq 'HASH' ) ? shift : {} ;"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "# delete unsupported options"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "\tmy @bad_opts ="
NSQ_SOURCE_LINE 00000382 "\t\tgrep $_ ne 'err_mode' && $_ ne 'binmode', keys %{$opts} ;"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "\tdelete @{$opts}{@bad_opts} ;"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "\tmy $prepend_data = shift ;"
NSQ_SOURCE_LINE 00000387 "\t$prepend_data = '' unless defined $prepend_data ;"
NSQ_SOURCE_LINE 00000388 "\t$prepend_data = ${$prepend_data} if ref $prepend_data eq 'SCALAR' ;"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "#print \"PRE [$prepend_data]\\n\" ;"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "\tmy $err_mode = delete $opts->{err_mode} ;"
NSQ_SOURCE_LINE 00000393 "\t$opts->{ err_mode } = 'croak' ;"
NSQ_SOURCE_LINE 00000394 "\t$opts->{ scalar_ref } = 1 ;"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "\tmy $existing_data = eval { read_file( $file_name, $opts ) } ;"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "\tif ( $@ ) {"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "\t\t@_ = ( { err_mode => $err_mode },"
NSQ_SOURCE_LINE 00000401 "\t\t\t\"prepend_file '$file_name' - read_file: $!\" ) ;"
NSQ_SOURCE_LINE 00000402 "\t\tgoto &_error ;"
NSQ_SOURCE_LINE 00000403 "\t}"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "#print \"EXIST [$$existing_data]\\n\" ;"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "\t$opts->{atomic} = 1 ;"
NSQ_SOURCE_LINE 00000408 "\tmy $write_result ="
NSQ_SOURCE_LINE 00000409 "\t\teval { write_file( $file_name, $opts,"
NSQ_SOURCE_LINE 00000410 "\t\t       $prepend_data, $$existing_data ) ;"
NSQ_SOURCE_LINE 00000411 "\t} ;"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "\tif ( $@ ) {"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "\t\t@_ = ( { err_mode => $err_mode },"
NSQ_SOURCE_LINE 00000416 "\t\t\t\"prepend_file '$file_name' - write_file: $!\" ) ;"
NSQ_SOURCE_LINE 00000417 "\t\tgoto &_error ;"
NSQ_SOURCE_LINE 00000418 "\t}"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "\treturn $write_result ;"
NSQ_SOURCE_LINE 00000421 "}"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "# edit a file as a scalar in $_"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "*ef = \\&edit_file ;"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "sub edit_file(&$;$) {"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "\tmy( $edit_code, $file_name, $opts ) = @_ ;"
NSQ_SOURCE_LINE 00000430 "\t$opts = {} unless ref $opts eq 'HASH' ;"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "# \tmy $edit_code = shift ;"
NSQ_SOURCE_LINE 00000433 "# \tmy $file_name = shift ;"
NSQ_SOURCE_LINE 00000434 "# \tmy $opts = ( ref $_[0] eq 'HASH' ) ? shift : {} ;"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "#print \"FILE $file_name\\n\" ;"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "# delete unsupported options"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "\tmy @bad_opts ="
NSQ_SOURCE_LINE 00000441 "\t\tgrep $_ ne 'err_mode' && $_ ne 'binmode', keys %{$opts} ;"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "\tdelete @{$opts}{@bad_opts} ;"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "# keep the user err_mode and force croaking on internal errors"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "\tmy $err_mode = delete $opts->{err_mode} ;"
NSQ_SOURCE_LINE 00000448 "\t$opts->{ err_mode } = 'croak' ;"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "# get a scalar ref for speed and slurp the file into a scalar"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "\t$opts->{ scalar_ref } = 1 ;"
NSQ_SOURCE_LINE 00000453 "\tmy $existing_data = eval { read_file( $file_name, $opts ) } ;"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "\tif ( $@ ) {"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "\t\t@_ = ( { err_mode => $err_mode },"
NSQ_SOURCE_LINE 00000458 "\t\t\t\"edit_file '$file_name' - read_file: $!\" ) ;"
NSQ_SOURCE_LINE 00000459 "\t\tgoto &_error ;"
NSQ_SOURCE_LINE 00000460 "\t}"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "#print \"EXIST [$$existing_data]\\n\" ;"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "\tmy( $edited_data ) = map { $edit_code->(); $_ } $$existing_data ;"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "\t$opts->{atomic} = 1 ;"
NSQ_SOURCE_LINE 00000467 "\tmy $write_result ="
NSQ_SOURCE_LINE 00000468 "\t\teval { write_file( $file_name, $opts, $edited_data ) } ;"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "\tif ( $@ ) {"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "\t\t@_ = ( { err_mode => $err_mode },"
NSQ_SOURCE_LINE 00000473 "\t\t\t\"edit_file '$file_name' - write_file: $!\" ) ;"
NSQ_SOURCE_LINE 00000474 "\t\tgoto &_error ;"
NSQ_SOURCE_LINE 00000475 "\t}"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "\treturn $write_result ;"
NSQ_SOURCE_LINE 00000478 "}"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "*efl = \\&edit_file_lines ;"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "sub edit_file_lines(&$;$) {"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "\tmy( $edit_code, $file_name, $opts ) = @_ ;"
NSQ_SOURCE_LINE 00000485 "\t$opts = {} unless ref $opts eq 'HASH' ;"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "# \tmy $edit_code = shift ;"
NSQ_SOURCE_LINE 00000488 "# \tmy $file_name = shift ;"
NSQ_SOURCE_LINE 00000489 "# \tmy $opts = ( ref $_[0] eq 'HASH' ) ? shift : {} ;"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "#print \"FILE $file_name\\n\" ;"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "# delete unsupported options"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "\tmy @bad_opts ="
NSQ_SOURCE_LINE 00000496 "\t\tgrep $_ ne 'err_mode' && $_ ne 'binmode', keys %{$opts} ;"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "\tdelete @{$opts}{@bad_opts} ;"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "# keep the user err_mode and force croaking on internal errors"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "\tmy $err_mode = delete $opts->{err_mode} ;"
NSQ_SOURCE_LINE 00000503 "\t$opts->{ err_mode } = 'croak' ;"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "# get an array ref for speed and slurp the file into lines"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "\t$opts->{ array_ref } = 1 ;"
NSQ_SOURCE_LINE 00000508 "\tmy $existing_data = eval { read_file( $file_name, $opts ) } ;"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "\tif ( $@ ) {"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "\t\t@_ = ( { err_mode => $err_mode },"
NSQ_SOURCE_LINE 00000513 "\t\t\t\"edit_file_lines '$file_name' - read_file: $!\" ) ;"
NSQ_SOURCE_LINE 00000514 "\t\tgoto &_error ;"
NSQ_SOURCE_LINE 00000515 "\t}"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "#print \"EXIST [$$existing_data]\\n\" ;"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "\tmy @edited_data = map { $edit_code->(); $_ } @$existing_data ;"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "\t$opts->{atomic} = 1 ;"
NSQ_SOURCE_LINE 00000522 "\tmy $write_result ="
NSQ_SOURCE_LINE 00000523 "\t\teval { write_file( $file_name, $opts, @edited_data ) } ;"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "\tif ( $@ ) {"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "\t\t@_ = ( { err_mode => $err_mode },"
NSQ_SOURCE_LINE 00000528 "\t\t\t\"edit_file_lines '$file_name' - write_file: $!\" ) ;"
NSQ_SOURCE_LINE 00000529 "\t\tgoto &_error ;"
NSQ_SOURCE_LINE 00000530 "\t}"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "\treturn $write_result ;"
NSQ_SOURCE_LINE 00000533 "}"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "# basic wrapper around opendir/readdir"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "sub read_dir {"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "\tmy $dir = shift ;"
NSQ_SOURCE_LINE 00000540 "\tmy $opts = ( ref $_[0] eq 'HASH' ) ? shift : { @_ } ;"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "# this handle will be destroyed upon return"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "\tlocal(*DIRH);"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "# open the dir and handle any errors"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "\tunless ( opendir( DIRH, $dir ) ) {"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "\t\t@_ = ( $opts, \"read_dir '$dir' - opendir: $!\" ) ;"
NSQ_SOURCE_LINE 00000551 "\t\tgoto &_error ;"
NSQ_SOURCE_LINE 00000552 "\t}"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "\tmy @dir_entries = readdir(DIRH) ;"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "\t@dir_entries = grep( $_ ne \".\" && $_ ne \"..\", @dir_entries )"
NSQ_SOURCE_LINE 00000557 "\t\tunless $opts->{'keep_dot_dot'} ;"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "\tif ( $opts->{'prefix'} ) {"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "\t\t$_ = File::Spec->catfile($dir, $_) for @dir_entries;"
NSQ_SOURCE_LINE 00000562 "\t}"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "\treturn @dir_entries if wantarray ;"
NSQ_SOURCE_LINE 00000565 "\treturn \\@dir_entries ;"
NSQ_SOURCE_LINE 00000566 "}"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "# error handling section"
NSQ_SOURCE_LINE 00000569 "#"
NSQ_SOURCE_LINE 00000570 "# all the error handling uses magic goto so the caller will get the"
NSQ_SOURCE_LINE 00000571 "# error message as if from their code and not this module. if we just"
NSQ_SOURCE_LINE 00000572 "# did a call on the error code, the carp/croak would report it from"
NSQ_SOURCE_LINE 00000573 "# this module since the error sub is one level down on the call stack"
NSQ_SOURCE_LINE 00000574 "# from read_file/write_file/read_dir."
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "my %err_func = ("
NSQ_SOURCE_LINE 00000578 "\t'carp'\t=> \\&carp,"
NSQ_SOURCE_LINE 00000579 "\t'croak'\t=> \\&croak,"
NSQ_SOURCE_LINE 00000580 ") ;"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "sub _error {"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "\tmy( $opts, $err_msg ) = @_ ;"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "# get the error function to use"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 " \tmy $func = $err_func{ $opts->{'err_mode'} || 'croak' } ;"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "# if we didn't find it in our error function hash, they must have set"
NSQ_SOURCE_LINE 00000591 "# it to quiet and we don't do anything."
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "\treturn unless $func ;"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "# call the carp/croak function"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "\t$func->($err_msg) if $func ;"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "# return a hard undef (in list context this will be a single value of"
NSQ_SOURCE_LINE 00000600 "# undef which is not a legal in-band value)"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "\treturn undef ;"
NSQ_SOURCE_LINE 00000603 "}"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "1;"
NSQ_SOURCE_LINE 00000606 "__END__"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "=head1 NAME"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "File::Slurp - Simple and Efficient Reading/Writing/Modifying of Complete Files"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "  use File::Slurp;"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "  # read in a whole file into a scalar"
NSQ_SOURCE_LINE 00000617 "  my $text = read_file('/path/file');"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "  # read in a whole file into an array of lines"
NSQ_SOURCE_LINE 00000620 "  my @lines = read_file('/path/file');"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "  # write out a whole file from a scalar"
NSQ_SOURCE_LINE 00000623 "  write_file('/path/file', $text);"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "  # write out a whole file from an array of lines"
NSQ_SOURCE_LINE 00000626 "  write_file('/path/file', @lines);"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "  # Here is a simple and fast way to load and save a simple config file"
NSQ_SOURCE_LINE 00000629 "  # made of key=value lines."
NSQ_SOURCE_LINE 00000630 "  my %conf = read_file('/path/file') =~ /^(\\w+)=(.*)$/mg;"
NSQ_SOURCE_LINE 00000631 "  write_file('/path/file', {atomic => 1}, map \"$_=$conf{$_}\\n\", keys %conf);"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "  # insert text at the beginning of a file"
NSQ_SOURCE_LINE 00000634 "  prepend_file('/path/file', $text);"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "  # in-place edit to replace all 'foo' with 'bar' in file"
NSQ_SOURCE_LINE 00000637 "  edit_file { s/foo/bar/g } '/path/file';"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "  # in-place edit to delete all lines with 'foo' from file"
NSQ_SOURCE_LINE 00000640 "  edit_file_lines sub { $_ = '' if /foo/ }, '/path/file';"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "  # read in a whole directory of file names (skipping . and ..)"
NSQ_SOURCE_LINE 00000643 "  my @files = read_dir('/path/to/dir');"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "This module provides subs that allow you to read or write entire files"
NSQ_SOURCE_LINE 00000648 "with one simple call. They are designed to be simple to use, have"
NSQ_SOURCE_LINE 00000649 "flexible ways to pass in or get the file contents and to be very"
NSQ_SOURCE_LINE 00000650 "efficient. There is also a sub to read in all the files in a"
NSQ_SOURCE_LINE 00000651 "directory."
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "=head2 WARNING - PENDING DOOM"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "Although you technically I<can>, do NOT use this module to work on file handles,"
NSQ_SOURCE_LINE 00000656 "pipes, sockets, standard IO, or the C<DATA> handle. These are"
NSQ_SOURCE_LINE 00000657 "features implemented long ago that just really shouldn't be abused here."
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "Be warned: this activity will lead to inaccurate encoding/decoding of data."
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "All further mentions of actions on the above have been removed from this"
NSQ_SOURCE_LINE 00000662 "documentation and that feature set will likely be deprecated in the future."
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "In other words, if you don't have a filename to pass, consider using the"
NSQ_SOURCE_LINE 00000665 "standard C<< do { local $/; <$fh> } >>, or"
NSQ_SOURCE_LINE 00000666 "L<Data::Section>/L<Data::Section::Simple> for working with C<__DATA__>."
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "L<File::Slurp> implements the following functions."
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "=head2 append_file"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "\tuse File::Slurp qw(append_file write_file);"
NSQ_SOURCE_LINE 00000675 "\tmy $res = append_file('/path/file', \"Some text\");"
NSQ_SOURCE_LINE 00000676 "\t# same as"
NSQ_SOURCE_LINE 00000677 "\tmy $res = write_file('/path/file', {append => 1}, \"Some text\");"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "The C<append_file> function is simply a synonym for the"
NSQ_SOURCE_LINE 00000680 "L<File::Slurp/\"write_file\"> function, but ensures that the C<append> option is"
NSQ_SOURCE_LINE 00000681 "set."
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "=head2 edit_file"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "\tuse File::Slurp qw(edit_file);"
NSQ_SOURCE_LINE 00000686 "\t# perl -0777 -pi -e 's/foo/bar/g' /path/file"
NSQ_SOURCE_LINE 00000687 "\tedit_file { s/foo/bar/g } '/path/file';"
NSQ_SOURCE_LINE 00000688 "\tedit_file sub { s/foo/bar/g }, '/path/file';"
NSQ_SOURCE_LINE 00000689 "\tsub replace_foo { s/foo/bar/g }"
NSQ_SOURCE_LINE 00000690 "\tedit_file \\&replace_foo, '/path/file';"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "The C<edit_file> function reads in a file into C<$_>, executes a code block that"
NSQ_SOURCE_LINE 00000693 "should modify C<$_>, and then writes C<$_> back to the file. The C<edit_file>"
NSQ_SOURCE_LINE 00000694 "function reads in the entire file and calls the code block one time. It is"
NSQ_SOURCE_LINE 00000695 "equivalent to the C<-pi> command line options of Perl but you can call it from"
NSQ_SOURCE_LINE 00000696 "inside your program and not have to fork out a process."
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "The first argument to C<edit_file> is a code block or a code reference. The"
NSQ_SOURCE_LINE 00000699 "code block is not followed by a comma (as with C<grep> and C<map>) but a code"
NSQ_SOURCE_LINE 00000700 "reference is followed by a comma."
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "The next argument is the filename."
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "The next argument(s) is either a hash reference or a flattened hash,"
NSQ_SOURCE_LINE 00000705 "C<< key => value >> pairs. The options are passed through to the"
NSQ_SOURCE_LINE 00000706 "L<File::Slurp/\"write_file\"> function. All options are described there."
NSQ_SOURCE_LINE 00000707 "Only the C<binmode> and C<err_mode> options are supported. The call to"
NSQ_SOURCE_LINE 00000708 "L<File::Slurp/\"write_file\"> has the C<atomic> option set so you will always"
NSQ_SOURCE_LINE 00000709 "have a consistent file."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "=head2 edit_file_lines"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "\tuse File::Slurp qw(edit_file_lines);"
NSQ_SOURCE_LINE 00000714 "\t# perl -pi -e '$_ = \"\" if /foo/' /path/file"
NSQ_SOURCE_LINE 00000715 "\tedit_file_lines { $_ = '' if /foo/ } '/path/file';"
NSQ_SOURCE_LINE 00000716 "\tedit_file_lines sub { $_ = '' if /foo/ }, '/path/file';"
NSQ_SOURCE_LINE 00000717 "\tsub delete_foo { $_ = '' if /foo/ }"
NSQ_SOURCE_LINE 00000718 "\tedit_file \\&delete_foo, '/path/file';"
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "The C<edit_file_lines> function reads each line of a file into C<$_>, and"
NSQ_SOURCE_LINE 00000721 "executes a code block that should modify C<$_>. It will then write C<$_> back"
NSQ_SOURCE_LINE 00000722 "to the file. It is equivalent to the C<-pi> command line options of Perl but"
NSQ_SOURCE_LINE 00000723 "you can call it from inside your program and not have to fork out a process."
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "The first argument to C<edit_file_lines> is a code block or a code reference."
NSQ_SOURCE_LINE 00000726 "The code block is not followed by a comma (as with C<grep> and C<map>) but a"
NSQ_SOURCE_LINE 00000727 "code reference is followed by a comma."
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "The next argument is the filename."
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "The next argument(s) is either a hash reference or a flattened hash,"
NSQ_SOURCE_LINE 00000732 "C<< key => value >> pairs. The options are passed through to the"
NSQ_SOURCE_LINE 00000733 "L<File::Slurp/\"write_file\"> function. All options are described there."
NSQ_SOURCE_LINE 00000734 "Only the C<binmode> and C<err_mode> options are supported. The call to"
NSQ_SOURCE_LINE 00000735 "L<File::Slurp/\"write_file\"> has the C<atomic> option set so you will always"
NSQ_SOURCE_LINE 00000736 "have a consistent file."
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "=head2 ef"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "\tuse File::Slurp qw(ef);"
NSQ_SOURCE_LINE 00000741 "\t# perl -0777 -pi -e 's/foo/bar/g' /path/file"
NSQ_SOURCE_LINE 00000742 "\tef { s/foo/bar/g } '/path/file';"
NSQ_SOURCE_LINE 00000743 "\tef sub { s/foo/bar/g }, '/path/file';"
NSQ_SOURCE_LINE 00000744 "\tsub replace_foo { s/foo/bar/g }"
NSQ_SOURCE_LINE 00000745 "\tef \\&replace_foo, '/path/file';"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "The C<ef> function is simply a synonym for the L<File::Slurp/\"edit_file\">"
NSQ_SOURCE_LINE 00000748 "function."
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "=head2 efl"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "\tuse File::Slurp qw(efl);"
NSQ_SOURCE_LINE 00000753 "\t# perl -pi -e '$_ = \"\" if /foo/' /path/file"
NSQ_SOURCE_LINE 00000754 "\tefl { $_ = '' if /foo/ } '/path/file';"
NSQ_SOURCE_LINE 00000755 "\tefl sub { $_ = '' if /foo/ }, '/path/file';"
NSQ_SOURCE_LINE 00000756 "\tsub delete_foo { $_ = '' if /foo/ }"
NSQ_SOURCE_LINE 00000757 "\tefl \\&delete_foo, '/path/file';"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "The C<efl> function is simply a synonym for the L<File::Slurp/\"edit_file_lines\">"
NSQ_SOURCE_LINE 00000760 "function."
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "=head2 overwrite_file"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "\tuse File::Slurp qw(overwrite_file);"
NSQ_SOURCE_LINE 00000765 "\tmy $res = overwrite_file('/path/file', \"Some text\");"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "The C<overwrite_file> function is simply a synonym for the"
NSQ_SOURCE_LINE 00000768 "L<File::Slurp/\"write_file\"> function."
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "=head2 prepend_file"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "\tuse File::Slurp qw(prepend_file);"
NSQ_SOURCE_LINE 00000773 "\tprepend_file('/path/file', $header);"
NSQ_SOURCE_LINE 00000774 "\tprepend_file('/path/file', \\@lines);"
NSQ_SOURCE_LINE 00000775 "\tprepend_file('/path/file', { binmode => ':raw'}, $bin_data);"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "\t# equivalent to:"
NSQ_SOURCE_LINE 00000778 "\tuse File::Slurp qw(read_file write_file);"
NSQ_SOURCE_LINE 00000779 "\tmy $content = read_file('/path/file');"
NSQ_SOURCE_LINE 00000780 "\tmy $new_content = \"hahahaha\";"
NSQ_SOURCE_LINE 00000781 "\twrite_file('/path/file', $new_content . $content);"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "The C<prepend_file> function is the opposite of L<File::Slurp/\"append_file\"> as"
NSQ_SOURCE_LINE 00000784 "it writes new contents to the beginning of the file instead of the end. It is a"
NSQ_SOURCE_LINE 00000785 "combination of L<File::Slurp/\"read_file\"> and L<File::Slurp/\"write_file\">. It"
NSQ_SOURCE_LINE 00000786 "works by first using C<read_file> to slurp in the file and then calling"
NSQ_SOURCE_LINE 00000787 "C<write_file> with the new data and the existing file data."
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "The first argument to C<prepend_file> is the filename."
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "The next argument(s) is either a hash reference or a flattened hash,"
NSQ_SOURCE_LINE 00000792 "C<< key => value >> pairs. The options are passed through to the"
NSQ_SOURCE_LINE 00000793 "L<File::Slurp/\"write_file\"> function. All options are described there."
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "Only the C<binmode> and C<err_mode> options are supported. The"
NSQ_SOURCE_LINE 00000796 "C<write_file> call has the C<atomic> option set so you will always have"
NSQ_SOURCE_LINE 00000797 "a consistent file."
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "=head2 read_dir"
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "\tuse File::Slurp qw(read_dir);"
NSQ_SOURCE_LINE 00000802 "\tmy @files = read_dir('/path/to/dir');"
NSQ_SOURCE_LINE 00000803 "\t# all files, even the dots"
NSQ_SOURCE_LINE 00000804 "\tmy @files = read_dir('/path/to/dir', keep_dot_dot => 1);"
NSQ_SOURCE_LINE 00000805 "\t# keep the full file path"
NSQ_SOURCE_LINE 00000806 "\tmy @paths = read_dir('/path/to/dir', prefix => 1);"
NSQ_SOURCE_LINE 00000807 "\t# scalar context"
NSQ_SOURCE_LINE 00000808 "\tmy $files_ref = read_dir('/path/to/dir');"
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "This function returns a list of the filenames in the supplied directory. In"
NSQ_SOURCE_LINE 00000811 "list context, an array is returned, in scalar context, an array reference is"
NSQ_SOURCE_LINE 00000812 "returned."
NSQ_SOURCE_LINE 00000813 ""
NSQ_SOURCE_LINE 00000814 "The first argument is the path to the directory to read."
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 "The next argument(s) is either a hash reference or a flattened hash,"
NSQ_SOURCE_LINE 00000817 "C<< key => value >> pairs. The following options are available:"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "=over"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "=item"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "err_mode"
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "The C<err_mode> option has three possible values: C<quiet>, C<carp>, or the"
NSQ_SOURCE_LINE 00000826 "default, C<croak>. In C<quiet> mode, all errors will be silent. In C<carp> mode,"
NSQ_SOURCE_LINE 00000827 "all errors will be emitted as warnings. And, in C<croak> mode, all errors will"
NSQ_SOURCE_LINE 00000828 "be emitted as exceptions. Take a look at L<Try::Tiny> or"
NSQ_SOURCE_LINE 00000829 "L<Syntax::Keyword::Try> to see how to catch exceptions."
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "=item"
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "keep_dot_dot"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "The C<keep_dot_dot> option is a boolean option, defaulted to false (C<0>)."
NSQ_SOURCE_LINE 00000836 "Setting this option to true (C<1>) will also return the C<.> and C<..> files"
NSQ_SOURCE_LINE 00000837 "that are removed from the file list by default."
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "=item"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "prefix"
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "The C<prefix> option is a boolean option, defaulted to false (C<0>)."
NSQ_SOURCE_LINE 00000844 "Setting this option to true (C<1>) add the directory as a prefix to the file."
NSQ_SOURCE_LINE 00000845 "The directory and the filename are joined using C<< File::Spec->catfile() >> to"
NSQ_SOURCE_LINE 00000846 "ensure the proper directory separator is used for your OS. See L<File::Spec>."
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "=back"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "=head2 read_file"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "\tuse File::Slurp qw(read_file);"
NSQ_SOURCE_LINE 00000853 "\tmy $text = read_file('/path/file');"
NSQ_SOURCE_LINE 00000854 "\tmy $bin = read_file('/path/file', { binmode => ':raw' });"
NSQ_SOURCE_LINE 00000855 "\tmy @lines = read_file('/path/file');"
NSQ_SOURCE_LINE 00000856 "\tmy $lines_ref = read_file('/path/file', array_ref => 1);"
NSQ_SOURCE_LINE 00000857 "\tmy $lines_ref = [ read_file('/path/file') ];"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "\t# or we can read into a buffer:"
NSQ_SOURCE_LINE 00000860 "\tmy $buffer;"
NSQ_SOURCE_LINE 00000861 "\tread_file('/path/file', buf_ref => \\$buffer);"
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "\t# or we can set the block size for the read"
NSQ_SOURCE_LINE 00000864 "\tmy $text_ref = read_file('/path/file', blk_size => 10_000_000, array_ref => 1);"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "\t# or we can get a scalar reference"
NSQ_SOURCE_LINE 00000867 "\tmy $text_ref = read_file('/path/file', scalar_ref => 1);"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "This function reads in an entire file and returns its contents to the"
NSQ_SOURCE_LINE 00000870 "caller. In scalar context it returns the entire file as a single"
NSQ_SOURCE_LINE 00000871 "scalar. In list context it will return a list of lines (using the"
NSQ_SOURCE_LINE 00000872 "current value of C<$/> as the separator, including support for paragraph"
NSQ_SOURCE_LINE 00000873 "mode when it is set to C<''>)."
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "The first argument is the path to the file to be slurped in."
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "The next argument(s) is either a hash reference or a flattened hash,"
NSQ_SOURCE_LINE 00000878 "C<< key => value >> pairs. The following options are available:"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "=over"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "=item"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "array_ref"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "The C<array_ref> option is a boolean option, defaulted to false (C<0>). Setting"
NSQ_SOURCE_LINE 00000887 "this option to true (C<1>) will only have relevance if the C<read_file> function"
NSQ_SOURCE_LINE 00000888 "is called in scalar context. When true, the C<read_file> function will return"
NSQ_SOURCE_LINE 00000889 "a reference to an array of the lines in the file."
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "=item"
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "binmode"
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "The C<binmode> option is a string option, defaulted to empty (C<''>). If you"
NSQ_SOURCE_LINE 00000896 "set the C<binmode> option, then its value is passed to a call to C<binmode> on"
NSQ_SOURCE_LINE 00000897 "the opened handle. You can use this to set the file to be read in binary mode,"
NSQ_SOURCE_LINE 00000898 "utf8, etc. See C<perldoc -f binmode> for more."
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "=item"
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "blk_size"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "You can use this option to set the block size used when slurping from"
NSQ_SOURCE_LINE 00000905 "an already open handle (like C<\\*STDIN>). It defaults to 1MB."
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "=item"
NSQ_SOURCE_LINE 00000908 ""
NSQ_SOURCE_LINE 00000909 "buf_ref"
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "The C<buf_ref> option can be used in conjunction with any of the other options."
NSQ_SOURCE_LINE 00000912 "You can use this option to pass in a scalar reference and the slurped"
NSQ_SOURCE_LINE 00000913 "file contents will be stored in the scalar. This saves an extra copy of"
NSQ_SOURCE_LINE 00000914 "the slurped file and can lower RAM usage vs returning the file. It is"
NSQ_SOURCE_LINE 00000915 "usually the fastest way to read a file into a scalar."
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "=item"
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "chomp"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "The C<chomp> option is a boolean option, defaulted to false (C<0>). Setting"
NSQ_SOURCE_LINE 00000922 "this option to true (C<1>) will cause each line to have its contents C<chomp>ed."
NSQ_SOURCE_LINE 00000923 "This option works in list context or in scalar context with the C<array_ref>"
NSQ_SOURCE_LINE 00000924 "option."
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "=item"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "err_mode"
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "The C<err_mode> option has three possible values: C<quiet>, C<carp>, or the"
NSQ_SOURCE_LINE 00000931 "default, C<croak>. In C<quiet> mode, all errors will be silent. In C<carp> mode,"
NSQ_SOURCE_LINE 00000932 "all errors will be emitted as warnings. And, in C<croak> mode, all errors will"
NSQ_SOURCE_LINE 00000933 "be emitted as exceptions. Take a look at L<Try::Tiny> or"
NSQ_SOURCE_LINE 00000934 "L<Syntax::Keyword::Try> to see how to catch exceptions."
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "=item"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "scalar_ref"
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "The C<scalar_ref> option is a boolean option, defaulted to false (C<0>). It only"
NSQ_SOURCE_LINE 00000941 "has meaning in scalar context. The return value will be a scalar reference to a"
NSQ_SOURCE_LINE 00000942 "string which is the contents of the slurped file. This will usually be faster"
NSQ_SOURCE_LINE 00000943 "than returning the plain scalar. It will also save memory as it will not make a"
NSQ_SOURCE_LINE 00000944 "copy of the file to return."
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "=back"
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "=head2 rf"
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "\tuse File::Slurp qw(rf);"
NSQ_SOURCE_LINE 00000951 "\tmy $text = rf('/path/file');"
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "The C<rf> function is simply a synonym for the L<File::Slurp/\"read_file\">"
NSQ_SOURCE_LINE 00000954 "function."
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "=head2 slurp"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "\tuse File::Slurp qw(slurp);"
NSQ_SOURCE_LINE 00000959 "\tmy $text = slurp('/path/file');"
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "The C<slurp> function is simply a synonym for the L<File::Slurp/\"read_file\">"
NSQ_SOURCE_LINE 00000962 "function."
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "=head2 wf"
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "\tuse File::Slurp qw(wf);"
NSQ_SOURCE_LINE 00000967 "\tmy $res = wf('/path/file', \"Some text\");"
NSQ_SOURCE_LINE 00000968 ""
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "The C<wf> function is simply a synonym for the"
NSQ_SOURCE_LINE 00000971 "L<File::Slurp/\"write_file\"> function."
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "=head2 write_file"
NSQ_SOURCE_LINE 00000974 ""
NSQ_SOURCE_LINE 00000975 "\tuse File::Slurp qw(write_file);"
NSQ_SOURCE_LINE 00000976 "\twrite_file('/path/file', @data);"
NSQ_SOURCE_LINE 00000977 "\twrite_file('/path/file', {append => 1}, @data);"
NSQ_SOURCE_LINE 00000978 "\twrite_file('/path/file', {binmode => ':raw'}, $buffer);"
NSQ_SOURCE_LINE 00000979 "\twrite_file('/path/file', \\$buffer);"
NSQ_SOURCE_LINE 00000980 "\twrite_file('/path/file', $buffer);"
NSQ_SOURCE_LINE 00000981 "\twrite_file('/path/file', \\@lines);"
NSQ_SOURCE_LINE 00000982 "\twrite_file('/path/file', @lines);"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "\t# binmode"
NSQ_SOURCE_LINE 00000985 "\twrite_file('/path/file', {binmode => ':raw'}, @data);"
NSQ_SOURCE_LINE 00000986 "\twrite_file('/path/file', {binmode => ':utf8'}, $utf_text);"
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 "\t# buffered"
NSQ_SOURCE_LINE 00000989 "\twrite_file('/path/file', {buf_ref => \\$buffer});"
NSQ_SOURCE_LINE 00000990 "\twrite_file('/path/file', \\$buffer);"
NSQ_SOURCE_LINE 00000991 "\twrite_file('/path/file', $buffer);"
NSQ_SOURCE_LINE 00000992 ""
NSQ_SOURCE_LINE 00000993 "\t# append"
NSQ_SOURCE_LINE 00000994 "\twrite_file('/path/file', {append => 1}, @data);"
NSQ_SOURCE_LINE 00000995 ""
NSQ_SOURCE_LINE 00000996 "\t# no clobbering"
NSQ_SOURCE_LINE 00000997 "\twrite_file('/path/file', {no_clobber => 1}, @data);"
NSQ_SOURCE_LINE 00000998 ""
NSQ_SOURCE_LINE 00000999 "This function writes out an entire file in one call. By default C<write_file>"
NSQ_SOURCE_LINE 00001000 "returns C<1> upon successfully writing the file or C<undef> if it encountered"
NSQ_SOURCE_LINE 00001001 "an error. You can change how errors are handled with the C<err_mode> option."
NSQ_SOURCE_LINE 00001002 ""
NSQ_SOURCE_LINE 00001003 "The first argument to C<write_file> is the filename."
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "The next argument(s) is either a hash reference or a flattened hash,"
NSQ_SOURCE_LINE 00001006 "C<< key => value >> pairs. The following options are available:"
NSQ_SOURCE_LINE 00001007 ""
NSQ_SOURCE_LINE 00001008 "=over"
NSQ_SOURCE_LINE 00001009 ""
NSQ_SOURCE_LINE 00001010 "=item"
NSQ_SOURCE_LINE 00001011 ""
NSQ_SOURCE_LINE 00001012 "append"
NSQ_SOURCE_LINE 00001013 ""
NSQ_SOURCE_LINE 00001014 "The C<append> option is a boolean option, defaulted to false (C<0>). Setting"
NSQ_SOURCE_LINE 00001015 "this option to true (C<1>) will cause the data to be be written at the end of"
NSQ_SOURCE_LINE 00001016 "the current file. Internally this sets the C<sysopen> mode flag C<O_APPEND>."
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "The L<File::Slurp/\"append_file\"> function sets this option by default."
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "=item"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "atomic"
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "The C<atomic> option is a boolean option, defaulted to false (C<0>). Setting"
NSQ_SOURCE_LINE 00001025 "this option to true (C<1>) will cause the file to be be written to in an"
NSQ_SOURCE_LINE 00001026 "atomic fashion. A temporary file name is created using L<File::Temp/\"tempfile\">."
NSQ_SOURCE_LINE 00001027 "After the file is closed it is renamed to the original file name"
NSQ_SOURCE_LINE 00001028 "(and C<rename> is an atomic operation on most OSes). If the program using"
NSQ_SOURCE_LINE 00001029 "this were to crash in the middle of this, then the temporary file could"
NSQ_SOURCE_LINE 00001030 "be left behind."
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "=item"
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "binmode"
NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "The C<binmode> option is a string option, defaulted to empty (C<''>). If you"
NSQ_SOURCE_LINE 00001037 "set the C<binmode> option, then its value is passed to a call to C<binmode> on"
NSQ_SOURCE_LINE 00001038 "the opened handle. You can use this to set the file to be read in binary mode,"
NSQ_SOURCE_LINE 00001039 "utf8, etc. See C<perldoc -f binmode> for more."
NSQ_SOURCE_LINE 00001040 ""
NSQ_SOURCE_LINE 00001041 "=item"
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "buf_ref"
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "The C<buf_ref> option is used to pass in a scalar reference which has the"
NSQ_SOURCE_LINE 00001046 "data to be written. If this is set then any data arguments (including"
NSQ_SOURCE_LINE 00001047 "the scalar reference shortcut) in C<@_> will be ignored."
NSQ_SOURCE_LINE 00001048 ""
NSQ_SOURCE_LINE 00001049 "=item"
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 "err_mode"
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "The C<err_mode> option has three possible values: C<quiet>, C<carp>, or the"
NSQ_SOURCE_LINE 00001054 "default, C<croak>. In C<quiet> mode, all errors will be silent. In C<carp> mode,"
NSQ_SOURCE_LINE 00001055 "all errors will be emitted as warnings. And, in C<croak> mode, all errors will"
NSQ_SOURCE_LINE 00001056 "be emitted as exceptions. Take a look at L<Try::Tiny> or"
NSQ_SOURCE_LINE 00001057 "L<Syntax::Keyword::Try> to see how to catch exceptions."
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "=item"
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "no_clobber"
NSQ_SOURCE_LINE 00001063 ""
NSQ_SOURCE_LINE 00001064 "The C<no_clobber> option is a boolean option, defaulted to false (C<0>). Setting"
NSQ_SOURCE_LINE 00001065 "this option to true (C<1>) will ensure an that existing file will not be"
NSQ_SOURCE_LINE 00001066 "overwritten."
NSQ_SOURCE_LINE 00001067 ""
NSQ_SOURCE_LINE 00001068 "=item"
NSQ_SOURCE_LINE 00001069 ""
NSQ_SOURCE_LINE 00001070 "perms"
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "The C<perms> option sets the permissions of newly-created files. This value"
NSQ_SOURCE_LINE 00001073 "is modified by your process's C<umask> and defaults to C<0666> (same as"
NSQ_SOURCE_LINE 00001074 "C<sysopen>)."
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 "NOTE: this option is new as of File::Slurp version 9999.14."
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 "=back"
NSQ_SOURCE_LINE 00001079 ""
NSQ_SOURCE_LINE 00001080 "=head1 EXPORT"
NSQ_SOURCE_LINE 00001081 ""
NSQ_SOURCE_LINE 00001082 "These are exported by default or with"
NSQ_SOURCE_LINE 00001083 ""
NSQ_SOURCE_LINE 00001084 "\tuse File::Slurp qw(:std);"
NSQ_SOURCE_LINE 00001085 "\t# read_file write_file overwrite_file append_file read_dir"
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 "These are exported with"
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "\tuse File::Slurp qw(:edit);"
NSQ_SOURCE_LINE 00001090 "\t# edit_file edit_file_lines"
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "You can get all subs in the module exported with"
NSQ_SOURCE_LINE 00001093 ""
NSQ_SOURCE_LINE 00001094 "\tuse File::Slurp qw(:all);"
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "=over"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "=item *"
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "L<File::Slurper> - Provides a straightforward set of functions for the most"
NSQ_SOURCE_LINE 00001103 "common tasks of reading/writing text and binary files."
NSQ_SOURCE_LINE 00001104 ""
NSQ_SOURCE_LINE 00001105 "=item *"
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 "L<Path::Tiny> - Lightweight and comprehensive file handling, including simple"
NSQ_SOURCE_LINE 00001108 "methods for reading, writing, and editing text and binary files."
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "=item *"
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 "L<Mojo::File> - Similar to Path::Tiny for the L<Mojo> toolkit, always works in"
NSQ_SOURCE_LINE 00001113 "bytes."
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "=back"
NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 "Uri Guttman, <F<uri@stemsystems.com>>"
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 "=head1 COPYRIGHT & LICENSE"
NSQ_SOURCE_LINE 00001122 ""
NSQ_SOURCE_LINE 00001123 "Copyright (c) 2003 Uri Guttman. All rights reserved."
NSQ_SOURCE_LINE 00001124 ""
