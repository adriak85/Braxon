NSQ_SOURCE_LINE 00000001 ""
NSQ_SOURCE_LINE 00000002 "package CPAN::DistnameInfo;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "$VERSION = \"0.12\";"
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "sub distname_info {"
NSQ_SOURCE_LINE 00000008 "  my $file = shift or return;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "  my ($dist, $version) = $file =~ /^"
NSQ_SOURCE_LINE 00000011 "    ((?:[-+.]*(?:[A-Za-z0-9]+|(?<=\\D)_|_(?=\\D))*"
NSQ_SOURCE_LINE 00000012 "     (?:"
NSQ_SOURCE_LINE 00000013 "\t[A-Za-z](?=[^A-Za-z]|$)"
NSQ_SOURCE_LINE 00000014 "\t|"
NSQ_SOURCE_LINE 00000015 "\t\\d(?=-)"
NSQ_SOURCE_LINE 00000016 "     )(?<![._-][vV])"
NSQ_SOURCE_LINE 00000017 "    )+)(.*)"
NSQ_SOURCE_LINE 00000018 "  $/xs or return ($file,undef,undef);"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "  if ($dist =~ /-undef\\z/ and ! length $version) {"
NSQ_SOURCE_LINE 00000021 "    $dist =~ s/-undef\\z//;"
NSQ_SOURCE_LINE 00000022 "  }"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "  # Remove potential -withoutworldwriteables suffix"
NSQ_SOURCE_LINE 00000025 "  $version =~ s/-withoutworldwriteables$//;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "  if ($version =~ /^(-[Vv].*)-(\\d.*)/) {"
NSQ_SOURCE_LINE 00000028 "   "
NSQ_SOURCE_LINE 00000029 "    # Catch names like Unicode-Collate-Standard-V3_1_1-0.1"
NSQ_SOURCE_LINE 00000030 "    # where the V3_1_1 is part of the distname"
NSQ_SOURCE_LINE 00000031 "    $dist .= $1;"
NSQ_SOURCE_LINE 00000032 "    $version = $2;"
NSQ_SOURCE_LINE 00000033 "  }"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "  if ($version =~ /(.+_.*)-(\\d.*)/) {"
NSQ_SOURCE_LINE 00000036 "      # Catch names like Task-Deprecations5_14-1.00.tar.gz where the 5_14 is"
NSQ_SOURCE_LINE 00000037 "      # part of the distname. However, names like libao-perl_0.03-1.tar.gz"
NSQ_SOURCE_LINE 00000038 "      # should still have 0.03-1 as their version."
NSQ_SOURCE_LINE 00000039 "      $dist .= $1;"
NSQ_SOURCE_LINE 00000040 "      $version = $2;"
NSQ_SOURCE_LINE 00000041 "  }"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "  # Normalize the Dist.pm-1.23 convention which CGI.pm and"
NSQ_SOURCE_LINE 00000044 "  # a few others use."
NSQ_SOURCE_LINE 00000045 "  $dist =~ s{\\.pm$}{};"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "  $version = $1"
NSQ_SOURCE_LINE 00000048 "    if !length $version and $dist =~ s/-(\\d+\\w)$//;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "  $version = $1 . $version"
NSQ_SOURCE_LINE 00000051 "    if $version =~ /^\\d+$/ and $dist =~ s/-(\\w+)$//;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "  if ($version =~ /\\d\\.\\d/) {"
NSQ_SOURCE_LINE 00000054 "    $version =~ s/^[-_.]+//;"
NSQ_SOURCE_LINE 00000055 "  }"
NSQ_SOURCE_LINE 00000056 "  else {"
NSQ_SOURCE_LINE 00000057 "    $version =~ s/^[-_]+//;"
NSQ_SOURCE_LINE 00000058 "  }"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "  my $dev;"
NSQ_SOURCE_LINE 00000061 "  if (length $version) {"
NSQ_SOURCE_LINE 00000062 "    if ($file =~ /^perl-?\\d+\\.(\\d+)(?:\\D(\\d+))?(-(?:TRIAL|RC)\\d+)?$/) {"
NSQ_SOURCE_LINE 00000063 "      $dev = 1 if (($1 > 6 and $1 & 1) or ($2 and $2 >= 50)) or $3;"
NSQ_SOURCE_LINE 00000064 "    }"
NSQ_SOURCE_LINE 00000065 "    elsif ($version =~ /\\d\\D\\d+_\\d/ or $version =~ /-TRIAL/) {"
NSQ_SOURCE_LINE 00000066 "      $dev = 1;"
NSQ_SOURCE_LINE 00000067 "    }"
NSQ_SOURCE_LINE 00000068 "  }"
NSQ_SOURCE_LINE 00000069 "  else {"
NSQ_SOURCE_LINE 00000070 "    $version = undef;"
NSQ_SOURCE_LINE 00000071 "  }"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "  ($dist, $version, $dev);"
NSQ_SOURCE_LINE 00000074 "}"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "sub new {"
NSQ_SOURCE_LINE 00000077 "  my $class = shift;"
NSQ_SOURCE_LINE 00000078 "  my $distfile = shift;"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "  $distfile =~ s,//+,/,g;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "  my %info = ( pathname => $distfile );"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "  ($info{filename} = $distfile) =~ s,^(((.*?/)?authors/)?id/)?([A-Z])/(\\4[A-Z])/(\\5[-A-Z0-9]*)/,,"
NSQ_SOURCE_LINE 00000085 "    and $info{cpanid} = $6;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "  if ($distfile =~ m,([^/]+)\\.(tar\\.(?:g?z|bz2)|zip|tgz)$,i) { # support more ?"
NSQ_SOURCE_LINE 00000088 "    $info{distvname} = $1;"
NSQ_SOURCE_LINE 00000089 "    $info{extension} = $2;"
NSQ_SOURCE_LINE 00000090 "  }"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "  @info{qw(dist version beta)} = distname_info($info{distvname});"
NSQ_SOURCE_LINE 00000093 "  $info{maturity} = delete $info{beta} ? 'developer' : 'released';"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "  return bless \\%info, $class;"
NSQ_SOURCE_LINE 00000096 "}"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "sub dist      { shift->{dist} }"
NSQ_SOURCE_LINE 00000099 "sub version   { shift->{version} }"
NSQ_SOURCE_LINE 00000100 "sub maturity  { shift->{maturity} }"
NSQ_SOURCE_LINE 00000101 "sub filename  { shift->{filename} }"
NSQ_SOURCE_LINE 00000102 "sub cpanid    { shift->{cpanid} }"
NSQ_SOURCE_LINE 00000103 "sub distvname { shift->{distvname} }"
NSQ_SOURCE_LINE 00000104 "sub extension { shift->{extension} }"
NSQ_SOURCE_LINE 00000105 "sub pathname  { shift->{pathname} }"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "sub properties { %{ $_[0] } }"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "1;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "__END__"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head1 NAME"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "CPAN::DistnameInfo - Extract distribution name and version from a distribution filename"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "  my $pathname = \"authors/id/G/GB/GBARR/CPAN-DistnameInfo-0.02.tar.gz\";"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "  my $d = CPAN::DistnameInfo->new($pathname);"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "  my $dist      = $d->dist;      # \"CPAN-DistnameInfo\""
NSQ_SOURCE_LINE 00000124 "  my $version   = $d->version;   # \"0.02\""
NSQ_SOURCE_LINE 00000125 "  my $maturity  = $d->maturity;  # \"released\""
NSQ_SOURCE_LINE 00000126 "  my $filename  = $d->filename;  # \"CPAN-DistnameInfo-0.02.tar.gz\""
NSQ_SOURCE_LINE 00000127 "  my $cpanid    = $d->cpanid;    # \"GBARR\""
NSQ_SOURCE_LINE 00000128 "  my $distvname = $d->distvname; # \"CPAN-DistnameInfo-0.02\""
NSQ_SOURCE_LINE 00000129 "  my $extension = $d->extension; # \"tar.gz\""
NSQ_SOURCE_LINE 00000130 "  my $pathname  = $d->pathname;  # \"authors/id/G/GB/GBARR/...\""
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "  my %prop = $d->properties;"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "Many online services that are centered around CPAN attempt to"
NSQ_SOURCE_LINE 00000137 "associate multiple uploads by extracting a distribution name from"
NSQ_SOURCE_LINE 00000138 "the filename of the upload. For most distributions this is easy as"
NSQ_SOURCE_LINE 00000139 "they have used ExtUtils::MakeMaker or Module::Build to create the"
NSQ_SOURCE_LINE 00000140 "distribution, which results in a uniform name. But sadly not all"
NSQ_SOURCE_LINE 00000141 "uploads are created in this way."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "C<CPAN::DistnameInfo> uses heuristics that have been learnt by"
NSQ_SOURCE_LINE 00000144 "L<http://search.cpan.org/> to extract the distribution name and"
NSQ_SOURCE_LINE 00000145 "version from filenames and also report if the version is to be"
NSQ_SOURCE_LINE 00000146 "treated as a developer release"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "The constructor takes a single pathname, returning an object with the following methods"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=over"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=item cpanid"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "If the path given looked like a CPAN authors directory path, then this will be the"
NSQ_SOURCE_LINE 00000155 "the CPAN id of the author."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=item dist"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "The name of the distribution"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=item distvname"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "The file name with any suffix and leading directory names removed"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=item filename"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "If the path given looked like a CPAN authors directory path, then this will be the"
NSQ_SOURCE_LINE 00000168 "path to the file relative to the detected CPAN author directory. Otherwise it is the path"
NSQ_SOURCE_LINE 00000169 "that was passed in."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=item maturity"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "The maturity of the distribution. This will be either C<released> or C<developer>"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=item extension"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "The extension of the distribution, often used to denote the archive type (e.g. 'tar.gz')"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=item pathname"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "The pathname that was passed to the constructor when creating the object."
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=item properties"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "This will return a list of key-value pairs, suitable for assigning to a hash,"
NSQ_SOURCE_LINE 00000186 "for the known properties."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=item version"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "The extracted version"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=back"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "Graham Barr <gbarr@pobox.com>"
