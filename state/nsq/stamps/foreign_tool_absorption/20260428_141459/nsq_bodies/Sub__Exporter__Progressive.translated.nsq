NSQ_SOURCE_LINE 00000001 "package Sub::Exporter::Progressive;"
NSQ_SOURCE_LINE 00000002 "$Sub::Exporter::Progressive::VERSION = '0.001013';"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "# ABSTRACT: Only use Sub::Exporter if you need it"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "sub _croak {"
NSQ_SOURCE_LINE 00000009 "  require Carp;"
NSQ_SOURCE_LINE 00000010 "  &Carp::croak;"
NSQ_SOURCE_LINE 00000011 "}"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "sub import {"
NSQ_SOURCE_LINE 00000014 "   my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "   my $inner_target = caller;"
NSQ_SOURCE_LINE 00000017 "   my $export_data = sub_export_options($inner_target, @args);"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "   my $full_exporter;"
NSQ_SOURCE_LINE 00000020 "   no strict 'refs';"
NSQ_SOURCE_LINE 00000021 "   no warnings 'once';"
NSQ_SOURCE_LINE 00000022 "   @{\"${inner_target}::EXPORT_OK\"} = @{$export_data->{exports}};"
NSQ_SOURCE_LINE 00000023 "   @{\"${inner_target}::EXPORT\"} = @{$export_data->{defaults}};"
NSQ_SOURCE_LINE 00000024 "   %{\"${inner_target}::EXPORT_TAGS\"} = %{$export_data->{tags}};"
NSQ_SOURCE_LINE 00000025 "   *{\"${inner_target}::import\"} = sub {"
NSQ_SOURCE_LINE 00000026 "      use strict;"
NSQ_SOURCE_LINE 00000027 "      my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "      if ( grep {"
NSQ_SOURCE_LINE 00000030 "         length ref $_"
NSQ_SOURCE_LINE 00000031 "            or"
NSQ_SOURCE_LINE 00000032 "         $_ !~ / \\A [:-]? \\w+ \\z /xm"
NSQ_SOURCE_LINE 00000033 "      } @args ) {"
NSQ_SOURCE_LINE 00000034 "         _croak 'your usage of Sub::Exporter::Progressive requires Sub::Exporter to be installed'"
NSQ_SOURCE_LINE 00000035 "            unless eval { require Sub::Exporter };"
NSQ_SOURCE_LINE 00000036 "         $full_exporter ||= Sub::Exporter::build_exporter($export_data->{original});"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "         goto $full_exporter;"
NSQ_SOURCE_LINE 00000039 "      } elsif ( defined( (my ($num) = grep { m/^\\d/ } @args)[0] ) ) {"
NSQ_SOURCE_LINE 00000040 "         _croak \"cannot export symbols with a leading digit: '$num'\";"
NSQ_SOURCE_LINE 00000041 "      } else {"
NSQ_SOURCE_LINE 00000042 "         require Exporter;"
NSQ_SOURCE_LINE 00000043 "         s/ \\A - /:/xm for @args;"
NSQ_SOURCE_LINE 00000044 "         @_ = ($self, @args);"
NSQ_SOURCE_LINE 00000045 "         goto \\&Exporter::import;"
NSQ_SOURCE_LINE 00000046 "      }"
NSQ_SOURCE_LINE 00000047 "   };"
NSQ_SOURCE_LINE 00000048 "   return;"
NSQ_SOURCE_LINE 00000049 "}"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "my $too_complicated = <<'DEATH';"
NSQ_SOURCE_LINE 00000052 "You are using Sub::Exporter::Progressive, but the features your program uses from"
NSQ_SOURCE_LINE 00000053 "Sub::Exporter cannot be implemented without Sub::Exporter, so you might as well"
NSQ_SOURCE_LINE 00000054 "just use vanilla Sub::Exporter"
NSQ_SOURCE_LINE 00000055 "DEATH"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub sub_export_options {"
NSQ_SOURCE_LINE 00000058 "   my ($inner_target, $setup, $options) = @_;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "   my @exports;"
NSQ_SOURCE_LINE 00000061 "   my @defaults;"
NSQ_SOURCE_LINE 00000062 "   my %tags;"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "   if ( ($setup||'') eq '-setup') {"
NSQ_SOURCE_LINE 00000065 "      my %options = %$options;"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "      OPTIONS:"
NSQ_SOURCE_LINE 00000068 "      for my $opt (keys %options) {"
NSQ_SOURCE_LINE 00000069 "         if ($opt eq 'exports') {"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "            _croak $too_complicated if ref $options{exports} ne 'ARRAY';"
NSQ_SOURCE_LINE 00000072 "            @exports = @{$options{exports}};"
NSQ_SOURCE_LINE 00000073 "            _croak $too_complicated if grep { length ref $_ } @exports;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "         } elsif ($opt eq 'groups') {"
NSQ_SOURCE_LINE 00000076 "            %tags = %{$options{groups}};"
NSQ_SOURCE_LINE 00000077 "            for my $tagset (values %tags) {"
NSQ_SOURCE_LINE 00000078 "               _croak $too_complicated if grep {"
NSQ_SOURCE_LINE 00000079 "                  length ref $_"
NSQ_SOURCE_LINE 00000080 "                     or"
NSQ_SOURCE_LINE 00000081 "                  $_ =~ / \\A - (?! all \\b ) /x"
NSQ_SOURCE_LINE 00000082 "               } @{$tagset};"
NSQ_SOURCE_LINE 00000083 "            }"
NSQ_SOURCE_LINE 00000084 "            @defaults = @{$tags{default} || [] };"
NSQ_SOURCE_LINE 00000085 "         } else {"
NSQ_SOURCE_LINE 00000086 "            _croak $too_complicated;"
NSQ_SOURCE_LINE 00000087 "         }"
NSQ_SOURCE_LINE 00000088 "      }"
NSQ_SOURCE_LINE 00000089 "      @{$_} = map { / \\A  [:-] all \\z /x ? @exports : $_ } @{$_} for \\@defaults, values %tags;"
NSQ_SOURCE_LINE 00000090 "      $tags{all} ||= [ @exports ];"
NSQ_SOURCE_LINE 00000091 "      my %exports = map { $_ => 1 } @exports;"
NSQ_SOURCE_LINE 00000092 "      my @errors = grep { not $exports{$_} } @defaults;"
NSQ_SOURCE_LINE 00000093 "      _croak join(', ', @errors) . \" is not exported by the $inner_target module\\n\" if @errors;"
NSQ_SOURCE_LINE 00000094 "   }"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "   return {"
NSQ_SOURCE_LINE 00000097 "      exports => \\@exports,"
NSQ_SOURCE_LINE 00000098 "      defaults => \\@defaults,"
NSQ_SOURCE_LINE 00000099 "      original => $options,"
NSQ_SOURCE_LINE 00000100 "      tags => \\%tags,"
NSQ_SOURCE_LINE 00000101 "   };"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "1;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "__END__"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "=pod"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=head1 NAME"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "Sub::Exporter::Progressive - Only use Sub::Exporter if you need it"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=head1 VERSION"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "version 0.001013"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 " package Syntax::Keyword::Gather;"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 " use Sub::Exporter::Progressive -setup => {"
NSQ_SOURCE_LINE 00000125 "   exports => [qw( break gather gathered take )],"
NSQ_SOURCE_LINE 00000126 "   groups => {"
NSQ_SOURCE_LINE 00000127 "     default => [qw( break gather gathered take )],"
NSQ_SOURCE_LINE 00000128 "   },"
NSQ_SOURCE_LINE 00000129 " };"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 " # elsewhere"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 " # uses Exporter for speed"
NSQ_SOURCE_LINE 00000134 " use Syntax::Keyword::Gather;"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 " # somewhere else"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 " # uses Sub::Exporter for features"
NSQ_SOURCE_LINE 00000139 " use Syntax::Keyword::Gather 'gather', take => { -as => 'grab' };"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "L<Sub::Exporter> is an incredibly powerful module, but with that power comes"
NSQ_SOURCE_LINE 00000144 "great responsibility, er- as well as some runtime penalties.  This module"
NSQ_SOURCE_LINE 00000145 "is a C<Sub::Exporter> wrapper that will let your users just use L<Exporter>"
NSQ_SOURCE_LINE 00000146 "if all they are doing is picking exports, but use C<Sub::Exporter> if your"
NSQ_SOURCE_LINE 00000147 "users try to use C<Sub::Exporter>'s more advanced features, like"
NSQ_SOURCE_LINE 00000148 "renaming exports, if they try to use them."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Note that this module will export C<@EXPORT>, C<@EXPORT_OK> and"
NSQ_SOURCE_LINE 00000151 "C<%EXPORT_TAGS> package variables for C<Exporter> to work.  Additionally, if"
NSQ_SOURCE_LINE 00000152 "your package uses advanced C<Sub::Exporter> features like currying, this module"
NSQ_SOURCE_LINE 00000153 "will only ever use C<Sub::Exporter>, so you might as well use it directly."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=head1 CONTRIBUTORS"
