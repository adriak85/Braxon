BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Text::Table::Paragraph;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2017-01-01'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.002'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "#IFUNBUILT"
NSQ_SOURCE_LINE 00000007 "# use strict;"
NSQ_SOURCE_LINE 00000008 "# use warnings;"
NSQ_SOURCE_LINE 00000009 "#END IFUNBUILT"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "sub table {"
NSQ_SOURCE_LINE 00000012 "    require Text::Wrap;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "    my %args = @_;"
NSQ_SOURCE_LINE 00000015 "    my $rows = $args{rows} or die \"Must provide rows!\";"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "    my $opt_wrap = $args{wrap} // $ENV{TEXT_TABLE_PARAGRAPH_WRAP} // 1;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    my $columns;"
NSQ_SOURCE_LINE 00000020 "    my $data_idx_start;"
NSQ_SOURCE_LINE 00000021 "    if ($args{header_row}) {"
NSQ_SOURCE_LINE 00000022 "        $columns = $rows->[0];"
NSQ_SOURCE_LINE 00000023 "        $data_idx_start = 1;"
NSQ_SOURCE_LINE 00000024 "    } else {"
NSQ_SOURCE_LINE 00000025 "        $columns = [map {\"column$_\"} 0..$#{$rows->[0]}];"
NSQ_SOURCE_LINE 00000026 "        $data_idx_start = 0;"
NSQ_SOURCE_LINE 00000027 "    }"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    local $Text::Wrap::colums = $args{wrap_width} //"
NSQ_SOURCE_LINE 00000030 "        $ENV{TEXT_TABLE_PARAGRAPH_WRAP_WIDTH} // 72;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    my @output;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    for my $i ($data_idx_start .. $#$rows) {"
NSQ_SOURCE_LINE 00000035 "        my $row = $rows->[$i];"
NSQ_SOURCE_LINE 00000036 "        for my $j (0..$#{$columns}) {"
NSQ_SOURCE_LINE 00000037 "            last if $j > $#{$row};"
NSQ_SOURCE_LINE 00000038 "            my $column = $columns->[$j];"
NSQ_SOURCE_LINE 00000039 "            my $val = $row->[$j];"
NSQ_SOURCE_LINE 00000040 "            if ($opt_wrap) {"
NSQ_SOURCE_LINE 00000041 "                $val = Text::Wrap::wrap(\"\", \"  \", $val);"
NSQ_SOURCE_LINE 00000042 "            }"
NSQ_SOURCE_LINE 00000043 "            $val =~ s/\\R+\\z//;"
NSQ_SOURCE_LINE 00000044 "            push @output, \"$column: $val\\n\";"
NSQ_SOURCE_LINE 00000045 "\t}"
NSQ_SOURCE_LINE 00000046 "        push @output, \"\\n\";"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    return join(\"\", @output);"
NSQ_SOURCE_LINE 00000050 "}"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "1;"
NSQ_SOURCE_LINE 00000053 "# ABSTRACT: Format table data as paragraphs of rows"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "__END__"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=pod"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=head1 NAME"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "Text::Table::Paragraph - Format table data as paragraphs of rows"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "=head1 VERSION"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "This document describes version 0.002 of Text::Table::Paragraph (from Perl distribution Text-Table-Paragraph), released on 2016-01-01."
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 " use Text::Table::Paragraph;"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 " my $rows = ["
NSQ_SOURCE_LINE 00000074 "     # header row"
NSQ_SOURCE_LINE 00000075 "     ['name', 'summary', 'description'],"
NSQ_SOURCE_LINE 00000076 "     # rows"
NSQ_SOURCE_LINE 00000077 "     ['foo', 'bandung', 'a long description .... .... .... .... .... .... .... .... .... .... .... .... .... .... .... .... .... ....'],"
NSQ_SOURCE_LINE 00000078 "     ['bar', 'jakarta', 'another long description .... .... .... .... .... .... .... .... .... .... .... .... .... .... ....'],"
NSQ_SOURCE_LINE 00000079 "     ['baz', 'palangkaraya', 'yet another long description .... .... .... .... .... .... .... .... .... .... .... .... .... .... .... .... .... .... .... .... .... .... ....'],"
NSQ_SOURCE_LINE 00000080 " ];"
NSQ_SOURCE_LINE 00000081 " print Text::Table::Paragraph::table(rows => $rows, header_row => 1);"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "This module provides a single function, C<table>, which formats a"
NSQ_SOURCE_LINE 00000086 "two-dimensional array of data as paragraphs. Each paragraph shows a row of data"
NSQ_SOURCE_LINE 00000087 "and columns are shown as C<name: value> lines. Long values by default are"
NSQ_SOURCE_LINE 00000088 "wrapped and shown indented in the subsequent lines."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "The example shown in the SYNOPSIS generates the following table:"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 " name: foo"
NSQ_SOURCE_LINE 00000093 " summary: bandung"
NSQ_SOURCE_LINE 00000094 " description: a long description .... .... .... .... .... .... .... .... ...."
NSQ_SOURCE_LINE 00000095 "   .... .... .... .... .... .... .... .... ...."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 " name: bar"
NSQ_SOURCE_LINE 00000098 " summary: jakarta"
NSQ_SOURCE_LINE 00000099 " description: another long description .... .... .... .... .... .... .... ...."
NSQ_SOURCE_LINE 00000100 "   .... .... .... .... .... .... ...."
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 " name: baz"
NSQ_SOURCE_LINE 00000103 " summary: palangkaraya"
NSQ_SOURCE_LINE 00000104 " description: yet another long description .... .... .... .... .... .... ...."
NSQ_SOURCE_LINE 00000105 "   .... .... .... .... .... .... .... .... .... .... .... .... .... .... ...."
NSQ_SOURCE_LINE 00000106 "   ...."
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "=for Pod::Coverage ^(max)$"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=head2 table(%params) => str"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head2 OPTIONS"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "The C<table> function understands these arguments, which are passed as a hash."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=over"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=item * rows (aoaos)"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "Takes an array reference which should contain one or more rows of data, where"
NSQ_SOURCE_LINE 00000123 "each row is an array reference."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=item * header_row (bool)"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "If given a true value, the first row in the data will be interpreted as a header"
NSQ_SOURCE_LINE 00000128 "row that contains column names. Otherwise, columns will be named: C<column1>,"
NSQ_SOURCE_LINE 00000129 "C<column2>, and so on."
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=item * wrap (bool, default 1)"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "Whether to wrap long values."
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=item * wrap_width (int, default 72)"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=back"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head2 TEXT_TABLE_PARAGRAPH_WRAP => bool"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "Set default for C<wrap> option."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=head2 TEXT_TABLE_PARAGRAPH_WRAP_WIDTH => int"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "Set default for C<wrap_width> option."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "Please visit the project's homepage at L<https://metacpan.org/release/Text-Table-Paragraph>."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "Source repository is at L<https://github.com/perlancar/perl-Text-Table-Paragraph>."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=head1 BUGS"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=Text-Table-Paragraph>"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000162 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000163 "feature."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "This module is currently basically L<Text::Table::Tiny> 0.03 modified to output"
NSQ_SOURCE_LINE 00000168 "paragraphs instead of its original 2D text table format."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "C<Text::Table::*>, L<Text::Table::Any>"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "See also L<Bencher::Scenario::TextTableModules>."
NSQ_SOURCE_LINE 00000173 ""
