NSQ_SOURCE_LINE 00000001 "package Text::WideChar::Util;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2021-04-14'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Text-WideChar-Util'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.172'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use locale;"
NSQ_SOURCE_LINE 00000010 "use strict;"
NSQ_SOURCE_LINE 00000011 "use utf8;"
NSQ_SOURCE_LINE 00000012 "use warnings;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "use Unicode::GCString;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "require Exporter;"
NSQ_SOURCE_LINE 00000017 "our @ISA       = qw(Exporter);"
NSQ_SOURCE_LINE 00000018 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000019 "                       mbpad"
NSQ_SOURCE_LINE 00000020 "                       pad"
NSQ_SOURCE_LINE 00000021 "                       mbswidth"
NSQ_SOURCE_LINE 00000022 "                       mbswidth_height"
NSQ_SOURCE_LINE 00000023 "                       length_height"
NSQ_SOURCE_LINE 00000024 "                       mbtrunc"
NSQ_SOURCE_LINE 00000025 "                       trunc"
NSQ_SOURCE_LINE 00000026 "                       mbwrap"
NSQ_SOURCE_LINE 00000027 "                       wrap"
NSQ_SOURCE_LINE 00000028 "               );"
