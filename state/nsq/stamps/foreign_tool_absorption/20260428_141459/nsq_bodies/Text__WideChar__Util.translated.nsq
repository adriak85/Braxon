NSQ_SOURCE_LINE 00000030 "sub mbswidth {"
NSQ_SOURCE_LINE 00000031 "    Unicode::GCString->new($_[0])->columns;"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub mbswidth_height {"
NSQ_SOURCE_LINE 00000035 "    my $text = shift;"
NSQ_SOURCE_LINE 00000036 "    my $num_lines = 0;"
NSQ_SOURCE_LINE 00000037 "    my $len = 0;"
NSQ_SOURCE_LINE 00000038 "    for my $e (split /(\\r?\\n)/, $text) {"
NSQ_SOURCE_LINE 00000039 "        if ($e =~ /\\n/) {"
NSQ_SOURCE_LINE 00000040 "            $num_lines++;"
NSQ_SOURCE_LINE 00000041 "            next;"
NSQ_SOURCE_LINE 00000042 "        }"
NSQ_SOURCE_LINE 00000043 "        $num_lines = 1 if $num_lines == 0;"
NSQ_SOURCE_LINE 00000044 "        my $l = mbswidth($e);"
NSQ_SOURCE_LINE 00000045 "        $len = $l if $len < $l;"
NSQ_SOURCE_LINE 00000046 "    }"
NSQ_SOURCE_LINE 00000047 "    [$len, $num_lines];"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "sub length_height {"
NSQ_SOURCE_LINE 00000051 "    my $text = shift;"
NSQ_SOURCE_LINE 00000052 "    my $num_lines = 0;"
NSQ_SOURCE_LINE 00000053 "    my $len = 0;"
NSQ_SOURCE_LINE 00000054 "    for my $e (split /(\\r?\\n)/, $text) {"
NSQ_SOURCE_LINE 00000055 "        if ($e =~ /\\n/) {"
NSQ_SOURCE_LINE 00000056 "            $num_lines++;"
NSQ_SOURCE_LINE 00000057 "            next;"
NSQ_SOURCE_LINE 00000058 "        }"
NSQ_SOURCE_LINE 00000059 "        $num_lines = 1 if $num_lines == 0;"
NSQ_SOURCE_LINE 00000060 "        my $l = length($e);"
NSQ_SOURCE_LINE 00000061 "        $len = $l if $len < $l;"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 "    [$len, $num_lines];"
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "sub _get_indent_width {"
NSQ_SOURCE_LINE 00000067 "    my ($is_mb, $indent, $tab_width) = @_;"
NSQ_SOURCE_LINE 00000068 "    my $w = 0;"
NSQ_SOURCE_LINE 00000069 "    for (split //, $indent) {"
NSQ_SOURCE_LINE 00000070 "        if ($_ eq \"\\t\") {"
NSQ_SOURCE_LINE 00000071 "            # go to the next tab"
NSQ_SOURCE_LINE 00000072 "            $w = $tab_width * (int($w/$tab_width) + 1);"
NSQ_SOURCE_LINE 00000073 "        } else {"
NSQ_SOURCE_LINE 00000074 "            $w += $is_mb ? mbswidth($_) : 1;"
NSQ_SOURCE_LINE 00000075 "        }"
NSQ_SOURCE_LINE 00000076 "    }"
NSQ_SOURCE_LINE 00000077 "    $w;"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "# 3002 = IDEOGRAPHIC FULL STOP"
NSQ_SOURCE_LINE 00000081 "# ff0c = FULLWIDTH COMMA"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "our $re_cjk = qr/(?:"
NSQ_SOURCE_LINE 00000084 "                     \\p{Block=CJK_Compatibility}"
NSQ_SOURCE_LINE 00000085 "                 |   \\p{Block=CJK_Compatibility_Forms}"
NSQ_SOURCE_LINE 00000086 "                 |   \\p{Block=CJK_Compatibility_Ideographs}"
NSQ_SOURCE_LINE 00000087 "                 |   \\p{Block=CJK_Compatibility_Ideographs_Supplement}"
NSQ_SOURCE_LINE 00000088 "                 |   \\p{Block=CJK_Radicals_Supplement}"
NSQ_SOURCE_LINE 00000089 "                 |   \\p{Block=CJK_Strokes}"
NSQ_SOURCE_LINE 00000090 "                 |   \\p{Block=CJK_Symbols_And_Punctuation}"
NSQ_SOURCE_LINE 00000091 "                 |   \\p{Block=CJK_Unified_Ideographs}"
NSQ_SOURCE_LINE 00000092 "                 |   \\p{Block=CJK_Unified_Ideographs_Extension_A}"
NSQ_SOURCE_LINE 00000093 "                 |   \\p{Block=CJK_Unified_Ideographs_Extension_B}"
NSQ_SOURCE_LINE 00000094 "                 |   \\p{Hiragana}\\p{Katakana}\\p{Hangul}\\x{30fc}"
NSQ_SOURCE_LINE 00000095 "                #|   \\p{Block=CJK_Unified_Ideographs_Extension_C}"
NSQ_SOURCE_LINE 00000096 "                     [\\x{3002}\\x{ff0c}]"
NSQ_SOURCE_LINE 00000097 "                 )/x;"
NSQ_SOURCE_LINE 00000098 "our $re_cjk_class = qr/["
NSQ_SOURCE_LINE 00000099 "                           \\p{Block=CJK_Compatibility}"
NSQ_SOURCE_LINE 00000100 "                           \\p{Block=CJK_Compatibility_Forms}"
NSQ_SOURCE_LINE 00000101 "                           \\p{Block=CJK_Compatibility_Ideographs}"
NSQ_SOURCE_LINE 00000102 "                           \\p{Block=CJK_Compatibility_Ideographs_Supplement}"
NSQ_SOURCE_LINE 00000103 "                           \\p{Block=CJK_Radicals_Supplement}"
NSQ_SOURCE_LINE 00000104 "                           \\p{Block=CJK_Strokes}"
NSQ_SOURCE_LINE 00000105 "                           \\p{Block=CJK_Symbols_And_Punctuation}"
NSQ_SOURCE_LINE 00000106 "                           \\p{Block=CJK_Unified_Ideographs}"
NSQ_SOURCE_LINE 00000107 "                           \\p{Block=CJK_Unified_Ideographs_Extension_A}"
NSQ_SOURCE_LINE 00000108 "                           \\p{Block=CJK_Unified_Ideographs_Extension_B}"
NSQ_SOURCE_LINE 00000109 "                           \\p{Hiragana}\\p{Katakana}\\p{Hangul}\\x{30fc}"
NSQ_SOURCE_LINE 00000110 "                           \\x{3002}"
NSQ_SOURCE_LINE 00000111 "                           \\x{ff0c}"
NSQ_SOURCE_LINE 00000112 "                      ]/x;"
NSQ_SOURCE_LINE 00000113 "our $re_cjk_negclass = qr/[^"
NSQ_SOURCE_LINE 00000114 "                              \\p{Block=CJK_Compatibility}"
NSQ_SOURCE_LINE 00000115 "                              \\p{Block=CJK_Compatibility_Forms}"
NSQ_SOURCE_LINE 00000116 "                              \\p{Block=CJK_Compatibility_Ideographs}"
NSQ_SOURCE_LINE 00000117 "                              \\p{Block=CJK_Compatibility_Ideographs_Supplement}"
NSQ_SOURCE_LINE 00000118 "                              \\p{Block=CJK_Radicals_Supplement}"
NSQ_SOURCE_LINE 00000119 "                              \\p{Block=CJK_Strokes}"
NSQ_SOURCE_LINE 00000120 "                              \\p{Block=CJK_Symbols_And_Punctuation}"
NSQ_SOURCE_LINE 00000121 "                              \\p{Block=CJK_Unified_Ideographs}"
NSQ_SOURCE_LINE 00000122 "                              \\p{Block=CJK_Unified_Ideographs_Extension_A}"
NSQ_SOURCE_LINE 00000123 "                              \\p{Block=CJK_Unified_Ideographs_Extension_B}"
NSQ_SOURCE_LINE 00000124 "                              \\p{Hiragana}\\p{Katakana}\\p{Hangul}\\x{30fc}"
NSQ_SOURCE_LINE 00000125 "                              \\x{3002}"
NSQ_SOURCE_LINE 00000126 "                              \\x{ff0c}"
NSQ_SOURCE_LINE 00000127 "                      ]/x;"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "sub _wrap {"
NSQ_SOURCE_LINE 00000130 "    my ($is_mb, $text, $width, $opts) = @_;"
NSQ_SOURCE_LINE 00000131 "    $width //= 80;"
NSQ_SOURCE_LINE 00000132 "    $opts  //= {};"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "    # our algorithm: split into paragraphs, then process each paragraph. at the"
NSQ_SOURCE_LINE 00000135 "    # start of paragraph, determine indents (either from %opts, or deduced from"
NSQ_SOURCE_LINE 00000136 "    # text, like in Emacs) then push first-line indent. proceed to push words,"
NSQ_SOURCE_LINE 00000137 "    # while adding subsequent-line indent at the start of each line."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    my $tw = $opts->{tab_width} // 8;"
NSQ_SOURCE_LINE 00000140 "    die \"Please specify a positive tab width\" unless $tw > 0;"
NSQ_SOURCE_LINE 00000141 "    my $optfli  = $opts->{flindent};"
NSQ_SOURCE_LINE 00000142 "    my $optfliw = defined $optfli ? _get_indent_width($is_mb, $optfli, $tw) : undef;"
NSQ_SOURCE_LINE 00000143 "    my $optsli  = $opts->{slindent};"
NSQ_SOURCE_LINE 00000144 "    my $optsliw = defined $optsli ? _get_indent_width($is_mb, $optsli, $tw) : undef;"
NSQ_SOURCE_LINE 00000145 "    my $optkts  = $opts->{keep_trailing_space} // 0;"
NSQ_SOURCE_LINE 00000146 "    my @res;"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    my @para = split /(\\n(?:[ \\t]*\\n)+)/, $text;"
NSQ_SOURCE_LINE 00000149 "    #say \"D:para=[\",join(\", \", @para),\"]\";"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    my ($maxww, $minww);"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "  PARA:"
NSQ_SOURCE_LINE 00000154 "    while (my ($ptext, $pbreak) = splice @para, 0, 2) {"
NSQ_SOURCE_LINE 00000155 "        my $x = 0;"
NSQ_SOURCE_LINE 00000156 "        my $y = 0;"
NSQ_SOURCE_LINE 00000157 "        my $line_has_word = 0;"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "        # determine indents"
NSQ_SOURCE_LINE 00000160 "        my ($fli, $sli, $fliw, $sliw);"
NSQ_SOURCE_LINE 00000161 "        if (defined $optfli) {"
NSQ_SOURCE_LINE 00000162 "            $fli  = $optfli;"
NSQ_SOURCE_LINE 00000163 "            $fliw = $optfliw;"
NSQ_SOURCE_LINE 00000164 "        } else {"
NSQ_SOURCE_LINE 00000165 "            # XXX emacs can also treat ' #' as indent, e.g. when wrapping"
NSQ_SOURCE_LINE 00000166 "            # multi-line perl comment."
NSQ_SOURCE_LINE 00000167 "            ($fli) = $ptext =~ /\\A([ \\t]*)\\S/;"
NSQ_SOURCE_LINE 00000168 "            if (defined $fli) {"
NSQ_SOURCE_LINE 00000169 "                $fliw = _get_indent_width($is_mb, $fli, $tw);"
NSQ_SOURCE_LINE 00000170 "            } else {"
NSQ_SOURCE_LINE 00000171 "                $fli  = \"\";"
NSQ_SOURCE_LINE 00000172 "                $fliw = 0;"
NSQ_SOURCE_LINE 00000173 "            }"
NSQ_SOURCE_LINE 00000174 "        }"
NSQ_SOURCE_LINE 00000175 "        if (defined $optsli) {"
NSQ_SOURCE_LINE 00000176 "            $sli  = $optsli;"
NSQ_SOURCE_LINE 00000177 "            $sliw = $optsliw;"
NSQ_SOURCE_LINE 00000178 "        } else {"
NSQ_SOURCE_LINE 00000179 "            ($sli) = $ptext =~ /\\A[^\\n]*\\S[\\n]([ \\t+]*)\\S/;"
NSQ_SOURCE_LINE 00000180 "            if (defined $sli) {"
NSQ_SOURCE_LINE 00000181 "                $sliw = _get_indent_width($is_mb, $sli, $tw);"
NSQ_SOURCE_LINE 00000182 "            } else {"
NSQ_SOURCE_LINE 00000183 "                $sli  = \"\";"
NSQ_SOURCE_LINE 00000184 "                $sliw = 0;"
NSQ_SOURCE_LINE 00000185 "            }"
NSQ_SOURCE_LINE 00000186 "        }"
NSQ_SOURCE_LINE 00000187 "        die \"Subsequent indent must be less than width\" if $sliw >= $width;"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "        push @res, $fli;"
NSQ_SOURCE_LINE 00000190 "        $x += $fliw;"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "        my @words0; # (WORD1, WORD1_IS_CJK?, WS_AFTER?, WORD2, WORD2_IS_CJK?, WS_AFTER?, ...)"
NSQ_SOURCE_LINE 00000193 "        # we differentiate/split between CJK \"word\" (cluster of CJK letters,"
NSQ_SOURCE_LINE 00000194 "        # really) and non-CJK word, e.g. \"我很爱你my可爱的and beautiful,"
NSQ_SOURCE_LINE 00000195 "        # beautiful wife\" is split to [\"我很爱你\", \"my\", \"可爱的\", \"and\","
NSQ_SOURCE_LINE 00000196 "        # \"beautiful,\", \"beautiful\", \"wife\"]. we do this because CJK word can be"
NSQ_SOURCE_LINE 00000197 "        # line-broken on a per-letter basis, as they don't separate words with"
NSQ_SOURCE_LINE 00000198 "        # whitespaces."
NSQ_SOURCE_LINE 00000199 "        while ($ptext =~ /(?: ($re_cjk+)|(\\S+) ) (\\s*)/gox) {"
NSQ_SOURCE_LINE 00000200 "            my $ws_after = $3 ? 1:0;"
NSQ_SOURCE_LINE 00000201 "            if ($1) {"
NSQ_SOURCE_LINE 00000202 "                push @words0, $1, 1, $ws_after;"
NSQ_SOURCE_LINE 00000203 "            } else {"
NSQ_SOURCE_LINE 00000204 "                my $ptext2 = $2;"
NSQ_SOURCE_LINE 00000205 "                while ($ptext2 =~ /($re_cjk_class+)|"
NSQ_SOURCE_LINE 00000206 "                                   ($re_cjk_negclass+)/gox) {"
NSQ_SOURCE_LINE 00000207 "                    if ($1) {"
NSQ_SOURCE_LINE 00000208 "                        push @words0, $1, 1, 0;"
NSQ_SOURCE_LINE 00000209 "                    } else {"
NSQ_SOURCE_LINE 00000210 "                        push @words0, $2, 0, 0;"
NSQ_SOURCE_LINE 00000211 "                    }"
NSQ_SOURCE_LINE 00000212 "                }"
NSQ_SOURCE_LINE 00000213 "                $words0[-1] = $ws_after;"
NSQ_SOURCE_LINE 00000214 "            }"
NSQ_SOURCE_LINE 00000215 "        }"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "        # process each word"
NSQ_SOURCE_LINE 00000218 "        my $prev_ws_after;"
NSQ_SOURCE_LINE 00000219 "        while (@words0) {"
NSQ_SOURCE_LINE 00000220 "            my ($word0, $is_cjk, $ws_after) = splice @words0, 0, 3;"
NSQ_SOURCE_LINE 00000221 "            my @words;"
NSQ_SOURCE_LINE 00000222 "            my @wordsw;"
NSQ_SOURCE_LINE 00000223 "            while (1) {"
NSQ_SOURCE_LINE 00000224 "                my $wordw = $is_mb ? mbswidth($word0) : length($word0);"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "                # long cjk word is not truncated here because it will be"
NSQ_SOURCE_LINE 00000227 "                # line-broken later when wrapping."
NSQ_SOURCE_LINE 00000228 "                if ($wordw <= $width-$sliw || $is_cjk) {"
NSQ_SOURCE_LINE 00000229 "                    push @words , $word0;"
NSQ_SOURCE_LINE 00000230 "                    push @wordsw, $wordw;"
NSQ_SOURCE_LINE 00000231 "                    last;"
NSQ_SOURCE_LINE 00000232 "                }"
NSQ_SOURCE_LINE 00000233 "                # truncate long word"
NSQ_SOURCE_LINE 00000234 "                if ($is_mb) {"
NSQ_SOURCE_LINE 00000235 "                    my $res = mbtrunc($word0, $width-$sliw, 1);"
NSQ_SOURCE_LINE 00000236 "                    push @words , $res->[0];"
NSQ_SOURCE_LINE 00000237 "                    push @wordsw, $res->[1];"
NSQ_SOURCE_LINE 00000238 "                    $word0 = substr($word0, length($res->[0]));"
NSQ_SOURCE_LINE 00000239 "                    #say \"D:truncated long word (mb): $text -> $res->[0] & $res->[1], word0=$word0\";"
NSQ_SOURCE_LINE 00000240 "                } else {"
NSQ_SOURCE_LINE 00000241 "                    my $w2 = substr($word0, 0, $width-$sliw);"
NSQ_SOURCE_LINE 00000242 "                    push @words , $w2;"
NSQ_SOURCE_LINE 00000243 "                    push @wordsw, $width-$sliw;"
NSQ_SOURCE_LINE 00000244 "                    $word0 = substr($word0, $width-$sliw);"
NSQ_SOURCE_LINE 00000245 "                    #say \"D:truncated long word: $w2, \".($width-$sliw).\", word0=$word0\";"
NSQ_SOURCE_LINE 00000246 "                }"
NSQ_SOURCE_LINE 00000247 "            }"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "            for my $word (@words) {"
NSQ_SOURCE_LINE 00000250 "                my $wordw = shift @wordsw;"
NSQ_SOURCE_LINE 00000251 "                #say \"D:x=$x word=$word is_cjk=$is_cjk ws_after=$ws_after wordw=$wordw line_has_word=$line_has_word width=$width\";"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "                $maxww = $wordw if !defined($maxww) || $maxww < $wordw;"
NSQ_SOURCE_LINE 00000254 "                $minww = $wordw if !defined($minww) || $minww > $wordw;"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "                my $x_after_word = $x + ($line_has_word ? 1:0) + $wordw;"
NSQ_SOURCE_LINE 00000257 "                if ($x_after_word <= $width) {"
NSQ_SOURCE_LINE 00000258 "                    # the addition of word hasn't exceeded column width"
NSQ_SOURCE_LINE 00000259 "                    if ($line_has_word) {"
NSQ_SOURCE_LINE 00000260 "                        if ($prev_ws_after) {"
NSQ_SOURCE_LINE 00000261 "                            push @res, \" \";"
NSQ_SOURCE_LINE 00000262 "                            $x++;"
NSQ_SOURCE_LINE 00000263 "                        }"
NSQ_SOURCE_LINE 00000264 "                    }"
NSQ_SOURCE_LINE 00000265 "                    push @res, $word;"
NSQ_SOURCE_LINE 00000266 "                    $x += $wordw;"
NSQ_SOURCE_LINE 00000267 "                } else {"
NSQ_SOURCE_LINE 00000268 "                    while (1) {"
NSQ_SOURCE_LINE 00000269 "                        if ($is_cjk) {"
NSQ_SOURCE_LINE 00000270 "                            # CJK word can be broken"
NSQ_SOURCE_LINE 00000271 "                            my $res;"
NSQ_SOURCE_LINE 00000272 "                            if ($prev_ws_after) {"
NSQ_SOURCE_LINE 00000273 "                                $res = mbtrunc($word, $width - $x - 1, 1);"
NSQ_SOURCE_LINE 00000274 "                                push @res, \" \", $res->[0];"
NSQ_SOURCE_LINE 00000275 "                            } else {"
NSQ_SOURCE_LINE 00000276 "                                $res = mbtrunc($word, $width - $x, 1);"
NSQ_SOURCE_LINE 00000277 "                                push @res, $res->[0];"
NSQ_SOURCE_LINE 00000278 "                            }"
NSQ_SOURCE_LINE 00000279 "                            my $word2 = substr($word, length($res->[0]));"
NSQ_SOURCE_LINE 00000280 "                            #say \"D:truncated CJK word: $word -> $res->[0] & $res->[1], remaining=$word2\";"
NSQ_SOURCE_LINE 00000281 "                            $prev_ws_after = 0;"
NSQ_SOURCE_LINE 00000282 "                            $word = $word2;"
NSQ_SOURCE_LINE 00000283 "                            $wordw = mbswidth($word);"
NSQ_SOURCE_LINE 00000284 "                        }"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "                        # move the word to the next line"
NSQ_SOURCE_LINE 00000287 "                        push @res, \" \" if $prev_ws_after && $optkts;"
NSQ_SOURCE_LINE 00000288 "                        push @res, \"\\n\", $sli;"
NSQ_SOURCE_LINE 00000289 "                        $y++;"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "                        if ($sliw + $wordw <= $width) {"
NSQ_SOURCE_LINE 00000292 "                            push @res, $word;"
NSQ_SOURCE_LINE 00000293 "                            $x = $sliw + $wordw;"
NSQ_SOURCE_LINE 00000294 "                            last;"
NSQ_SOURCE_LINE 00000295 "                        } else {"
NSQ_SOURCE_LINE 00000296 "                            # still too long, truncate again"
NSQ_SOURCE_LINE 00000297 "                            $x = $sliw;"
NSQ_SOURCE_LINE 00000298 "                        }"
NSQ_SOURCE_LINE 00000299 "                    }"
NSQ_SOURCE_LINE 00000300 "                }"
NSQ_SOURCE_LINE 00000301 "                $line_has_word++;"
NSQ_SOURCE_LINE 00000302 "            }"
NSQ_SOURCE_LINE 00000303 "            $prev_ws_after = $ws_after;"
NSQ_SOURCE_LINE 00000304 "        }"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "        if (defined $pbreak) {"
NSQ_SOURCE_LINE 00000307 "            push @res, $pbreak;"
NSQ_SOURCE_LINE 00000308 "        } else {"
NSQ_SOURCE_LINE 00000309 "            push @res, \"\\n\" if $ptext =~ /\\n[ \\t]*\\z/;"
NSQ_SOURCE_LINE 00000310 "        }"
NSQ_SOURCE_LINE 00000311 "    }"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "    if ($opts->{return_stats}) {"
NSQ_SOURCE_LINE 00000314 "        return [join(\"\", @res), {"
NSQ_SOURCE_LINE 00000315 "            max_word_width => $maxww,"
NSQ_SOURCE_LINE 00000316 "            min_word_width => $minww,"
NSQ_SOURCE_LINE 00000317 "        }];"
NSQ_SOURCE_LINE 00000318 "    } else {"
NSQ_SOURCE_LINE 00000319 "        return join(\"\", @res);"
NSQ_SOURCE_LINE 00000320 "    }"
NSQ_SOURCE_LINE 00000321 "}"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "sub mbwrap {"
NSQ_SOURCE_LINE 00000324 "    _wrap(1, @_);"
NSQ_SOURCE_LINE 00000325 "}"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "sub wrap {"
NSQ_SOURCE_LINE 00000328 "    _wrap(0, @_);"
NSQ_SOURCE_LINE 00000329 "}"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "sub _pad {"
NSQ_SOURCE_LINE 00000332 "    my ($is_mb, $text, $width, $which, $padchar, $is_trunc) = @_;"
NSQ_SOURCE_LINE 00000333 "    if ($which) {"
NSQ_SOURCE_LINE 00000334 "        $which = substr($which, 0, 1);"
NSQ_SOURCE_LINE 00000335 "    } else {"
NSQ_SOURCE_LINE 00000336 "        $which = \"r\";"
NSQ_SOURCE_LINE 00000337 "    }"
NSQ_SOURCE_LINE 00000338 "    $padchar //= \" \";"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "    my $w = $is_mb ? mbswidth($text) : length($text);"
NSQ_SOURCE_LINE 00000341 "    if ($is_trunc && $w > $width) {"
NSQ_SOURCE_LINE 00000342 "        my $res = mbtrunc($text, $width, 1);"
NSQ_SOURCE_LINE 00000343 "        $text = $res->[0] . ($padchar x ($width-$res->[1]));"
NSQ_SOURCE_LINE 00000344 "    } else {"
NSQ_SOURCE_LINE 00000345 "        if ($which eq 'l') {"
NSQ_SOURCE_LINE 00000346 "            $text = ($padchar x ($width-$w)) . $text;"
NSQ_SOURCE_LINE 00000347 "        } elsif ($which eq 'c') {"
NSQ_SOURCE_LINE 00000348 "            my $n = int(($width-$w)/2);"
NSQ_SOURCE_LINE 00000349 "            $text = ($padchar x $n) . $text . ($padchar x ($width-$w-$n));"
NSQ_SOURCE_LINE 00000350 "        } else {"
NSQ_SOURCE_LINE 00000351 "            $text .= ($padchar x ($width-$w));"
NSQ_SOURCE_LINE 00000352 "        }"
NSQ_SOURCE_LINE 00000353 "    }"
NSQ_SOURCE_LINE 00000354 "    $text;"
NSQ_SOURCE_LINE 00000355 "}"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "sub mbpad {"
NSQ_SOURCE_LINE 00000358 "    _pad(1, @_);"
NSQ_SOURCE_LINE 00000359 "}"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "sub pad {"
NSQ_SOURCE_LINE 00000362 "    _pad(0, @_);"
NSQ_SOURCE_LINE 00000363 "}"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "sub _trunc {"
NSQ_SOURCE_LINE 00000366 "    my ($is_mb, $text, $width, $return_width) = @_;"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "    # return_width (undocumented): if set to 1, will return [truncated_text,"
NSQ_SOURCE_LINE 00000369 "    # visual width, length(chars) up to truncation point]"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "    my $w = $is_mb ? mbswidth($text) : length($text);"
NSQ_SOURCE_LINE 00000372 "    die \"Invalid argument, width must not be negative\" unless $width >= 0;"
NSQ_SOURCE_LINE 00000373 "    if ($w <= $width) {"
NSQ_SOURCE_LINE 00000374 "        return $return_width ? [$text, $w, length($text)] : $text;"
NSQ_SOURCE_LINE 00000375 "    }"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "    my $c = 0;"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "    # perform binary cutting"
NSQ_SOURCE_LINE 00000380 "    my @res;"
NSQ_SOURCE_LINE 00000381 "    my $wres = 0; # total width of text in @res"
NSQ_SOURCE_LINE 00000382 "    my $l = int($w/2); $l = 1 if $l == 0;"
NSQ_SOURCE_LINE 00000383 "    my $end = 0;"
NSQ_SOURCE_LINE 00000384 "    while (1) {"
NSQ_SOURCE_LINE 00000385 "        my $left  = substr($text, 0, $l);"
NSQ_SOURCE_LINE 00000386 "        my $right = $l > length($text) ? \"\" : substr($text, $l);"
NSQ_SOURCE_LINE 00000387 "        my $wl = $is_mb ? mbswidth($left) : length($left);"
NSQ_SOURCE_LINE 00000388 "        #say \"D:left=$left, right=$right, wl=$wl\";"
NSQ_SOURCE_LINE 00000389 "        if ($wres + $wl > $width) {"
NSQ_SOURCE_LINE 00000390 "            $text = $left;"
NSQ_SOURCE_LINE 00000391 "        } else {"
NSQ_SOURCE_LINE 00000392 "            push @res, $left;"
NSQ_SOURCE_LINE 00000393 "            $wres += $wl;"
NSQ_SOURCE_LINE 00000394 "            $c += length($left);"
NSQ_SOURCE_LINE 00000395 "            $text = $right;"
NSQ_SOURCE_LINE 00000396 "        }"
NSQ_SOURCE_LINE 00000397 "        $l = int(($l+1)/2);"
NSQ_SOURCE_LINE 00000398 "        #say \"D:l=$l\";"
NSQ_SOURCE_LINE 00000399 "        last if $l==1 && $end>1;"
NSQ_SOURCE_LINE 00000400 "        $end++ if $l==1;"
NSQ_SOURCE_LINE 00000401 "    }"
NSQ_SOURCE_LINE 00000402 "    if ($return_width) {"
NSQ_SOURCE_LINE 00000403 "        return [join(\"\", @res), $wres, $c];"
NSQ_SOURCE_LINE 00000404 "    } else {"
NSQ_SOURCE_LINE 00000405 "        return join(\"\", @res);"
NSQ_SOURCE_LINE 00000406 "    }"
NSQ_SOURCE_LINE 00000407 "}"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "sub mbtrunc {"
NSQ_SOURCE_LINE 00000410 "    _trunc(1, @_);"
NSQ_SOURCE_LINE 00000411 "}"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "sub trunc {"
NSQ_SOURCE_LINE 00000414 "    _trunc(0, @_);"
NSQ_SOURCE_LINE 00000415 "}"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "1;"
NSQ_SOURCE_LINE 00000418 "# ABSTRACT: Routines for text containing wide characters"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "__END__"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "=pod"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=head1 NAME"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "Text::WideChar::Util - Routines for text containing wide characters"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "=head1 VERSION"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "This document describes version 0.172 of Text::WideChar::Util (from Perl distribution Text-WideChar-Util), released on 2021-04-14."
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 " use Text::WideChar::Util qw("
NSQ_SOURCE_LINE 00000437 "     mbpad pad mbswidth mbswidth_height mbtrunc trunc mbwrap wrap);"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 " # get width as well as number of lines"
NSQ_SOURCE_LINE 00000440 " say mbswidth_height(\"red\\n红色\"); # => [4, 2]"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 " # wrap text to a certain column width"
NSQ_SOURCE_LINE 00000443 " say mbwrap(\"....\", 40);"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 " # pad (left, right, center) text to specified column width, handle multilines"
NSQ_SOURCE_LINE 00000446 " say mbpad(\"foo\", 10);                          # => \"foo       \""
NSQ_SOURCE_LINE 00000447 " say mbpad(\"红色\", 10, \"left\");                 # => \"      红色\""
NSQ_SOURCE_LINE 00000448 " say mbpad(\"foo\\nbarbaz\\n\", 10, \"center\", \".\"); # => \"...foo....\\n..barbaz..\\n\""
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 " # truncate text to a certain column width"
NSQ_SOURCE_LINE 00000451 " say mbtrunc(\"红色\",  2); # => \"红\""
NSQ_SOURCE_LINE 00000452 " say mbtrunc(\"红色\",  3); # => \"红\""
NSQ_SOURCE_LINE 00000453 " say mbtrunc(\"红red\", 3); # => \"红r\""
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "This module provides routines for dealing with text containing wide characters"
NSQ_SOURCE_LINE 00000458 "(wide meaning occupying more than 1 column width in terminal)."
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "=head1 INTERNAL NOTES"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "Should we wrap at hyphens? Probably not. Both Emacs as well as Text::Wrap do"
NSQ_SOURCE_LINE 00000463 "not."
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "=head2 mbswidth($text) => INT"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "Like L<Text::CharWidth>'s mbswidth(), except implemented using L<<"
NSQ_SOURCE_LINE 00000470 "Unicode::GCString->new($text)->columns >>."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=head2 mbswidth_height($text) => [INT, INT]"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "Like mbswidth(), but also gives height (number of lines). For example, C<<"
NSQ_SOURCE_LINE 00000475 "mbswidth_height(\"foobar\\nb\\n\") >> gives [6, 3]."
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "=head2 length_height($text) => [INT, INT]"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "This is the non-wide version of mbswidth_height() and can be used if your text"
NSQ_SOURCE_LINE 00000480 "only contains printable ASCII characters and newlines."
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "=head2 mbwrap($text, $width, \\%opts) => STR"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "Wrap C<$text> to C<$width> columns. Replaces multiple whitespaces with a single"
NSQ_SOURCE_LINE 00000485 "space."
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "It uses mbswidth() instead of Perl's length() which works on a per-character"
NSQ_SOURCE_LINE 00000488 "basis. Has some support for wrapping Kanji/CJK (Chinese/Japanese/Korean) text"
NSQ_SOURCE_LINE 00000489 "which do not have whitespace between words."
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "Options:"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "=over"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "=item * tab_width => INT (default: 8)"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "Set tab width."
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "Note that tab will only have effect on the indent. Tab between text will be"
NSQ_SOURCE_LINE 00000500 "replaced with a single space."
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "=item * flindent => STR"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "First line indent. If unspecified, will be deduced from the first line of text."
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "=item * slindent => STD"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "Subsequent line indent. If unspecified, will be deduced from the second line of"
NSQ_SOURCE_LINE 00000509 "text, or if unavailable, will default to empty string (C<\"\">)."
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=item * return_stats => BOOL (default: 0)"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "If set to true, then instead of returning the wrapped string, function will"
NSQ_SOURCE_LINE 00000514 "return C<< [$wrapped, $stats] >> where C<$stats> is a hash containing some"
NSQ_SOURCE_LINE 00000515 "information like C<max_word_width>, C<min_word_width>."
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=item * keep_trailing_space => BOOL (default: 0)"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "If set to true, then trailing space that separates words will be kept at the end"
NSQ_SOURCE_LINE 00000520 "of wrapped lines. This option is useful if you want to rejoin the lines later."
NSQ_SOURCE_LINE 00000521 "Without this option set to true, wrapping this line at width=4 (quotes shown):"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 " \"some long   line\""
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "will result in:"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 " \"some\""
NSQ_SOURCE_LINE 00000528 " \"long\""
NSQ_SOURCE_LINE 00000529 " \"line\""
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "While if this option is set to true, the result will be:"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 " \"some \""
NSQ_SOURCE_LINE 00000534 " \"long \""
NSQ_SOURCE_LINE 00000535 " \"line\""
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "=back"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "Performance: ~450/s on my Core i5 1.7GHz laptop for a 1KB of text."
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "=head2 wrap($text, $width, \\%opts) => STR"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "Like mbwrap(), but uses character-based length() instead of column width-wise"
NSQ_SOURCE_LINE 00000544 "mbswidth(). Provided as an alternative to the venerable L<Text::Wrap>'s wrap()"
NSQ_SOURCE_LINE 00000545 "but with a different behaviour. This module's wrap() can reflow newline and its"
NSQ_SOURCE_LINE 00000546 "behavior is more akin to Emacs (try reflowing a paragraph in Emacs using"
NSQ_SOURCE_LINE 00000547 "C<M-q>)."
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "Performance: ~2000/s on my Core i5 1.7GHz laptop for a ~1KB of text."
NSQ_SOURCE_LINE 00000550 "Text::Wrap::wrap() on the other hand is ~2500/s."
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "=head2 mbpad($text, $width[, $which[, $padchar[, $truncate]]]) => STR"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "Return C<$text> padded with C<$padchar> to C<$width> columns. C<$which> is"
NSQ_SOURCE_LINE 00000555 "either \"r\" or \"right\" for padding on the right (the default if not specified),"
NSQ_SOURCE_LINE 00000556 "\"l\" or \"left\" for padding on the right, or \"c\" or \"center\" or \"centre\" for"
NSQ_SOURCE_LINE 00000557 "left+right padding to center the text."
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "C<$padchar> is whitespace if not specified. It should be string having the width"
NSQ_SOURCE_LINE 00000560 "of 1 column."
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "=head2 pad($text, $width[, $which[, $padchar[, $truncate]]]) => STR"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "The non-wide version of mbpad(), just like in mbwrap() vs wrap()."
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "=head2 mbtrunc($text, $width) => STR"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "Truncate C<$text> to C<$width> columns. It uses mbswidth() instead of Perl's"
NSQ_SOURCE_LINE 00000569 "length(), so it can handle wide characters."
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "Does *not* handle multiple lines."
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "=head2 trunc($text, $width) => STR"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "The non-wide version of mbtrunc(), just like in mbwrap() vs wrap(). This is"
NSQ_SOURCE_LINE 00000576 "actually not much more than Perl's C<< substr($text, 0, $width) >>."
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "=head1 FAQ"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "=head2 Why split functionalities of wide character and color support into multiple modules/distributions?"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "Performance (see numbers in the function description), dependency"
NSQ_SOURCE_LINE 00000583 "(L<Unicode::GCString> is used for wide character support), and overhead (loading"
NSQ_SOURCE_LINE 00000584 "Unicode::GCString)."
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "Please visit the project's homepage at L<https://metacpan.org/release/Text-WideChar-Util>."
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "Source repository is at L<https://github.com/perlancar/perl-Text-WideChar-Util>."
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "=head1 BUGS"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "Please report any bugs or feature requests on the bugtracker website L<https://github.com/perlancar/perl-Text-WideChar-Util/issues>"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000599 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000600 "feature."
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "L<Unicode::GCString> which is consulted for visual width of characters."
NSQ_SOURCE_LINE 00000605 "L<Text::CharWidth> is about 2.5x faster but it gives weird results (-1 for"
NSQ_SOURCE_LINE 00000606 "characters like \"\\n\" and \"\\t\") and my Strawberry Perl installation fails to"
NSQ_SOURCE_LINE 00000607 "build it."
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "L<Text::ANSI::Util> which can also handle text containing wide characters as"
NSQ_SOURCE_LINE 00000610 "well ANSI escape codes."
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "L<Text::WrapI18N> which provides an alternative to wrap()/mbwrap() with"
NSQ_SOURCE_LINE 00000613 "comparable speed, though wrapping result might differ slightly. And the module"
NSQ_SOURCE_LINE 00000614 "currently uses Text::CharWidth."
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "L<Text::NonWideChar::Util> contains non-wide version of some of the"
NSQ_SOURCE_LINE 00000617 "abovementioned routines (the non-wide version of the routines will eventually be"
NSQ_SOURCE_LINE 00000618 "moved here)."
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "L<String::Pad>, L<Text::Wrap>"
NSQ_SOURCE_LINE 00000621 ""
