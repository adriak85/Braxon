BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Text::Table::Org;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000007 "our $DATE = '2022-01-23'; # DATE"
NSQ_SOURCE_LINE 00000008 "our $DIST = 'Text-Table-Org'; # DIST"
NSQ_SOURCE_LINE 00000009 "our $VERSION = '0.031'; # VERSION"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "sub table {"
NSQ_SOURCE_LINE 00000012 "    my %params = @_;"
NSQ_SOURCE_LINE 00000013 "    my $rows = $params{rows} or die \"Must provide rows!\";"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "    # foreach col, get the biggest width"
NSQ_SOURCE_LINE 00000016 "    my $widths = _maxwidths($rows);"
NSQ_SOURCE_LINE 00000017 "    my $max_index = _max_array_index($rows);"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    # use that to get the field format and separators"
NSQ_SOURCE_LINE 00000020 "    my $format = _get_format($widths);"
NSQ_SOURCE_LINE 00000021 "    my $row_sep = _get_row_separator($widths);"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    # here we go..."
NSQ_SOURCE_LINE 00000024 "    my @table;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    push @table, \"#+CAPTION: $params{caption}\\n\" if defined $params{caption};"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    # if the first row's a header:"
NSQ_SOURCE_LINE 00000029 "    my $data_begins = 0;"
NSQ_SOURCE_LINE 00000030 "    if ( $params{header_row} ) {"
NSQ_SOURCE_LINE 00000031 "        my $header_row = $rows->[0];"
NSQ_SOURCE_LINE 00000032 "        $data_begins++;"
NSQ_SOURCE_LINE 00000033 "        push @table, sprintf("
NSQ_SOURCE_LINE 00000034 "            $format,"
NSQ_SOURCE_LINE 00000035 "            map { defined($header_row->[$_]) ? $header_row->[$_] : '' } (0..$max_index)"
NSQ_SOURCE_LINE 00000036 "        );"
NSQ_SOURCE_LINE 00000037 "        push @table, $row_sep;"
NSQ_SOURCE_LINE 00000038 "    }"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    # then the data"
NSQ_SOURCE_LINE 00000041 "    my $i = 0;"
NSQ_SOURCE_LINE 00000042 "    for my $i ($data_begins..$#$rows) {"
NSQ_SOURCE_LINE 00000043 "        my $row = $rows->[$i];"
NSQ_SOURCE_LINE 00000044 "        push @table, sprintf("
NSQ_SOURCE_LINE 00000045 "\t    $format,"
NSQ_SOURCE_LINE 00000046 "\t    map { defined($row->[$_]) ? $row->[$_] : '' } (0..$max_index)"
NSQ_SOURCE_LINE 00000047 "\t);"
NSQ_SOURCE_LINE 00000048 "        push @table, $row_sep if $params{separate_rows} && $i < $#$rows;"
NSQ_SOURCE_LINE 00000049 "    }"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    return join(\"\", grep {$_} @table);"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "# FROM_MODULE: PERLANCAR::List::Util::PP"
NSQ_SOURCE_LINE 00000055 "# BEGIN_BLOCK: max"
NSQ_SOURCE_LINE 00000056 "sub max {"
NSQ_SOURCE_LINE 00000057 "    return undef unless @_; ## no critic: Subroutines::ProhibitExplicitReturnUndef"
NSQ_SOURCE_LINE 00000058 "    my $res = $_[0];"
NSQ_SOURCE_LINE 00000059 "    my $i = 0;"
NSQ_SOURCE_LINE 00000060 "    while (++$i < @_) { $res = $_[$i] if $_[$i] > $res }"
NSQ_SOURCE_LINE 00000061 "    $res;"
NSQ_SOURCE_LINE 00000062 "}"
NSQ_SOURCE_LINE 00000063 "# END_BLOCK: max"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "sub _get_cols_and_rows ($) { ## no critic: Subroutines::ProhibitSubroutinePrototypes"
NSQ_SOURCE_LINE 00000066 "    my $rows = shift;"
NSQ_SOURCE_LINE 00000067 "    return ( max( map { scalar @$_ } @$rows), scalar @$rows);"
NSQ_SOURCE_LINE 00000068 "}"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "sub _maxwidths {"
NSQ_SOURCE_LINE 00000071 "    my $rows = shift;"
NSQ_SOURCE_LINE 00000072 "    # what's the longest array in this list of arrays?"
NSQ_SOURCE_LINE 00000073 "    my $max_index = _max_array_index($rows);"
NSQ_SOURCE_LINE 00000074 "    my $widths = [];"
NSQ_SOURCE_LINE 00000075 "    for my $i (0..$max_index) {"
NSQ_SOURCE_LINE 00000076 "        # go through the $i-th element of each array, find the longest"
NSQ_SOURCE_LINE 00000077 "        my $max = max(map {defined $$_[$i] ? length($$_[$i]) : 0} @$rows);"
NSQ_SOURCE_LINE 00000078 "        push @$widths, $max;"
NSQ_SOURCE_LINE 00000079 "    }"
NSQ_SOURCE_LINE 00000080 "    return $widths;"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "# return highest top-index from all rows in case they're different lengths"
NSQ_SOURCE_LINE 00000084 "sub _max_array_index {"
NSQ_SOURCE_LINE 00000085 "    my $rows = shift;"
NSQ_SOURCE_LINE 00000086 "    return max( map { $#$_ } @$rows );"
NSQ_SOURCE_LINE 00000087 "}"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "sub _get_format {"
NSQ_SOURCE_LINE 00000090 "    my $widths = shift;"
NSQ_SOURCE_LINE 00000091 "    return \"| \".join(\" | \",map { \"%-${_}s\" } @$widths).\" |\\n\";"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "sub _get_row_separator {"
NSQ_SOURCE_LINE 00000095 "    my $widths = shift;"
NSQ_SOURCE_LINE 00000096 "    return \"|-\".join(\"-+-\",map { \"-\" x $_ } @$widths).\"-|\\n\";"
NSQ_SOURCE_LINE 00000097 "}"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "1;"
NSQ_SOURCE_LINE 00000100 "# ABSTRACT: Generate Org tables"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "__END__"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=pod"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "=head1 NAME"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "Text::Table::Org - Generate Org tables"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=head1 VERSION"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "This document describes version 0.031 of Text::Table::Org (from Perl distribution Text-Table-Org), released on 2022-01-23."
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 " use Text::Table::Org;"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 " my $rows = ["
NSQ_SOURCE_LINE 00000121 "     # header row"
NSQ_SOURCE_LINE 00000122 "     ['Name', 'Rank', 'Serial'],"
NSQ_SOURCE_LINE 00000123 "     # rows"
NSQ_SOURCE_LINE 00000124 "     ['alice', 'pvt', '123456'],"
NSQ_SOURCE_LINE 00000125 "     ['bob',   'cpl', '98765321'],"
NSQ_SOURCE_LINE 00000126 "     ['carol', 'brig gen', '8745'],"
NSQ_SOURCE_LINE 00000127 " ];"
NSQ_SOURCE_LINE 00000128 " print Text::Table::Org::table(rows => $rows, header_row => 1);"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "This module provides a single function, C<table>, which formats a"
NSQ_SOURCE_LINE 00000133 "two-dimensional array of data as an Org text table."
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "The example shown in the SYNOPSIS generates the following table:"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 " | Name  | Rank     | Serial   |"
NSQ_SOURCE_LINE 00000138 " |-------+----------+----------|"
NSQ_SOURCE_LINE 00000139 " | alice | pvt      | 123456   |"
NSQ_SOURCE_LINE 00000140 " | bob   | cpl      | 98765321 |"
NSQ_SOURCE_LINE 00000141 " | carol | brig gen | 8745     |"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=for Pod::Coverage ^(max)$"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=head2 table(%params) => str"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=head2 OPTIONS"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "The C<table> function understands these arguments, which are passed as a hash."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=over"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=item * rows (aoaos)"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Takes an array reference which should contain one or more rows of data, where"
NSQ_SOURCE_LINE 00000158 "each row is an array reference."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=item * header_row (bool)"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "If given a true value, the first row in the data will be interpreted as a header"
NSQ_SOURCE_LINE 00000163 "row, and separated from the rest of the table with a ruled line."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=item * separate_rows (bool)"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "If set to true, will add separator line between data rows."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=item * caption"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "Optional. String. If set, will add this line to the beginning of output (C<table"
NSQ_SOURCE_LINE 00000172 "caption> will be the actual caption string that you provide):"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 " #+CAPTION: table caption"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "=back"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "Please visit the project's homepage at L<https://metacpan.org/release/Text-Table-Org>."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "Source repository is at L<https://github.com/perlancar/perl-Text-Table-Org>."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "This module is currently basically L<Text::Table::Tiny> 0.03 modified to output"
NSQ_SOURCE_LINE 00000189 "Org tables instead of its original variant table format."
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "The output of this module is very similar to that of L<Text::MarkdownTable>. In"
NSQ_SOURCE_LINE 00000192 "fact, Org recognizes its output as a valid Org table (the only difference is"
NSQ_SOURCE_LINE 00000193 "that corner marker is C<|> instead of the Org standard of C<+>)."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "Some other text table modules: L<Text::ANSITable>, L<Text::ASCIITable>,"
NSQ_SOURCE_LINE 00000196 "L<Text::FormatTable>, L<Text::Table>, L<Text::TabularDisplay>."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "See also L<Bencher::Scenario::TextTableModules>."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "perlancar <perlancar@cpan.org>"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=head1 CONTRIBUTING"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "To contribute, you can send patches by email/via RT, or send pull requests on"
NSQ_SOURCE_LINE 00000208 "GitHub."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "Most of the time, you don't need to build the distribution yourself. You can"
NSQ_SOURCE_LINE 00000211 "simply modify the code, then test via:"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 " % prove -l"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "If you want to build the distribution (e.g. to try to install it locally on your"
NSQ_SOURCE_LINE 00000216 "system), you can install L<Dist::Zilla>,"
NSQ_SOURCE_LINE 00000217 "L<Dist::Zilla::PluginBundle::Author::PERLANCAR>, and sometimes one or two other"
NSQ_SOURCE_LINE 00000218 "Dist::Zilla plugin and/or Pod::Weaver::Plugin. Any additional steps required"
NSQ_SOURCE_LINE 00000219 "beyond that are considered a bug and can be reported to me."
NSQ_SOURCE_LINE 00000220 ""
