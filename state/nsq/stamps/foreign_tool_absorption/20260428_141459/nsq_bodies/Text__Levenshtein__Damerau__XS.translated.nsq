NSQ_SOURCE_LINE 00000031 "=encoding utf8"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=head1 NAME"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "Text::Levenshtein::Damerau::XS - XS Damerau Levenshtein edit distance."
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "\tuse Text::Levenshtein::Damerau::XS qw/xs_edistance/;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "\tprint xs_edistance('Neil','Niel');"
NSQ_SOURCE_LINE 00000042 "\t# prints 1"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "Returns the true Damerau Levenshtein edit distance of strings with adjacent transpositions. XS implementation (requires a C compiler). Works correctly with utf8."
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "\tuse Text::Levenshtein::Damerau::XS qw/xs_edistance/;"
NSQ_SOURCE_LINE 00000049 "\tuse utf8;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "\txs_edistance('ⓕⓞⓤⓡ','ⓕⓤⓞⓡ'), "
NSQ_SOURCE_LINE 00000052 "\t# prints 1"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "Speed improvements over L<Text::Levenshtein::Damerau::PP>:"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "\t# Text::Levenshtein::Damerau::PP::pp_edistance(\"four\",\"fuor\")"
NSQ_SOURCE_LINE 00000057 "\ttimethis 1000000: 381 wallclock secs (380.45 usr +  0.01 sys = "
NSQ_SOURCE_LINE 00000058 "\t\t 380.46 CPU) @ 2628.40/s (n=1000000)"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "\t# Text::Levenshtein::Damerau::XS::xs_edistance(\"four\",\"fuor\")"
NSQ_SOURCE_LINE 00000061 "\ttimethis 1000000: 19 wallclock secs (19.43 usr +  0.00 sys = "
NSQ_SOURCE_LINE 00000062 "\t\t 19.43 CPU) @ 51466.80/s (n=1000000)"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=head1 METHODS"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=head2 xs_edistance"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "Arguments: source string and target string."
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=over"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=item * I<OPTIONAL 3rd argument> int (max distance; only return results with $int distance or less). 0 = unlimited. Default = 0."
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=back"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "Returns: int that represents the edit distance between the two argument. Stops calculations and returns -1 if max distance is set and reached."
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "Wrapper function to take the edit distance between a source and target string using XS algorithm implementation."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "\tuse Text::Levenshtein::Damerau::XS qw/xs_edistance/;"
NSQ_SOURCE_LINE 00000081 "\tprint xs_edistance('Neil','Niel');"
NSQ_SOURCE_LINE 00000082 "\t# prints 1"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "       # Max edit distance of 1"
NSQ_SOURCE_LINE 00000085 "\tprint xs_edistance('Neil','Niely',1); # distance is 2"
NSQ_SOURCE_LINE 00000086 "\t# prints -1"
NSQ_SOURCE_LINE 00000087 ""
