NSQ_SOURCE_LINE 00000024 "sub xs_edistance {"
NSQ_SOURCE_LINE 00000025 "    # shift shift shift is faster than $_[0] $_[1] $_[2] "
NSQ_SOURCE_LINE 00000026 "    return Text::Levenshtein::Damerau::XS::cxs_edistance( [unpack('U*', shift)], [unpack('U*',shift)], shift || 0);"
