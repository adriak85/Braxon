NSQ_SOURCE_LINE 00000166 "sub ParseParameters"
NSQ_SOURCE_LINE 00000167 "{"
NSQ_SOURCE_LINE 00000168 "    my $level = shift || 0 ;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    my $sub = (caller($level + 1))[3] ;"
NSQ_SOURCE_LINE 00000171 "    #local $Carp::CarpLevel = 1 ;"
NSQ_SOURCE_LINE 00000172 "    my $p = new Compress::Raw::Lzma::Parameters() ;"
NSQ_SOURCE_LINE 00000173 "    $p->parse(@_)"
NSQ_SOURCE_LINE 00000174 "        or croak \"$sub: $p->{Error}\" ;"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    return $p;"
NSQ_SOURCE_LINE 00000177 "}"
