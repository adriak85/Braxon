NSQ_SOURCE_LINE 00000374 "sub Compress::Raw::Lzma::Parameters::value"
NSQ_SOURCE_LINE 00000375 "{"
NSQ_SOURCE_LINE 00000376 "    my $self = shift ;"
NSQ_SOURCE_LINE 00000377 "    my $name = shift ;"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "    if (@_)"
NSQ_SOURCE_LINE 00000380 "    {"
NSQ_SOURCE_LINE 00000381 "        $self->{Got}{lc $name}[OFF_PARSED]  = 1;"
NSQ_SOURCE_LINE 00000382 "        $self->{Got}{lc $name}[OFF_DEFAULT] = $_[0] ;"
NSQ_SOURCE_LINE 00000383 "        $self->{Got}{lc $name}[OFF_FIXED]   = $_[0] ;"
NSQ_SOURCE_LINE 00000384 "    }"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "    return $self->{Got}{lc $name}[OFF_FIXED] ;"
NSQ_SOURCE_LINE 00000387 "}"
