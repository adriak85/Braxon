NSQ_SOURCE_LINE 00002022 "=head1 Constants"
NSQ_SOURCE_LINE 00002023 ""
NSQ_SOURCE_LINE 00002024 "The following lzma constants are exported by this module."
NSQ_SOURCE_LINE 00002025 ""
NSQ_SOURCE_LINE 00002026 "=head2 Return/Status Codes"
NSQ_SOURCE_LINE 00002027 ""
NSQ_SOURCE_LINE 00002028 "=over 5"
NSQ_SOURCE_LINE 00002029 ""
NSQ_SOURCE_LINE 00002030 "=item LZMA_OK"
NSQ_SOURCE_LINE 00002031 ""
NSQ_SOURCE_LINE 00002032 "Operation completed successfully."
NSQ_SOURCE_LINE 00002033 ""
NSQ_SOURCE_LINE 00002034 "=item LZMA_STREAM_END"
NSQ_SOURCE_LINE 00002035 ""
NSQ_SOURCE_LINE 00002036 "End of stream was reached. The complete compressed data has been"
NSQ_SOURCE_LINE 00002037 "decoded/encoded."
NSQ_SOURCE_LINE 00002038 ""
NSQ_SOURCE_LINE 00002039 "=item LZMA_NO_CHECK"
NSQ_SOURCE_LINE 00002040 ""
NSQ_SOURCE_LINE 00002041 "Input stream has no integrity check."
NSQ_SOURCE_LINE 00002042 ""
NSQ_SOURCE_LINE 00002043 "=item LZMA_UNSUPPORTED_CHECK"
NSQ_SOURCE_LINE 00002044 ""
NSQ_SOURCE_LINE 00002045 "Cannot calculate the integrity check (not supported by this build)."
NSQ_SOURCE_LINE 00002046 ""
NSQ_SOURCE_LINE 00002047 "=item LZMA_GET_CHECK"
NSQ_SOURCE_LINE 00002048 ""
NSQ_SOURCE_LINE 00002049 "Integrity check type is now available."
NSQ_SOURCE_LINE 00002050 ""
NSQ_SOURCE_LINE 00002051 "=item LZMA_MEM_ERROR"
NSQ_SOURCE_LINE 00002052 ""
NSQ_SOURCE_LINE 00002053 "Cannot allocate memory."
NSQ_SOURCE_LINE 00002054 ""
NSQ_SOURCE_LINE 00002055 "=item LZMA_MEMLIMIT_ERROR"
NSQ_SOURCE_LINE 00002056 ""
NSQ_SOURCE_LINE 00002057 "Memory usage limit was reached."
NSQ_SOURCE_LINE 00002058 ""
NSQ_SOURCE_LINE 00002059 "=item LZMA_FORMAT_ERROR"
NSQ_SOURCE_LINE 00002060 ""
NSQ_SOURCE_LINE 00002061 "File format not recognized."
NSQ_SOURCE_LINE 00002062 ""
NSQ_SOURCE_LINE 00002063 "=item LZMA_OPTIONS_ERROR"
NSQ_SOURCE_LINE 00002064 ""
NSQ_SOURCE_LINE 00002065 "Invalid or unsupported options."
NSQ_SOURCE_LINE 00002066 ""
NSQ_SOURCE_LINE 00002067 "=item LZMA_DATA_ERROR"
NSQ_SOURCE_LINE 00002068 ""
NSQ_SOURCE_LINE 00002069 "Data is corrupt."
NSQ_SOURCE_LINE 00002070 ""
NSQ_SOURCE_LINE 00002071 "=item LZMA_BUF_ERROR"
NSQ_SOURCE_LINE 00002072 ""
NSQ_SOURCE_LINE 00002073 "No progress is possible (stream is truncated or corrupt)."
NSQ_SOURCE_LINE 00002074 ""
NSQ_SOURCE_LINE 00002075 "=item LZMA_PROG_ERROR"
NSQ_SOURCE_LINE 00002076 ""
NSQ_SOURCE_LINE 00002077 "Programming error (should never happen in correct usage)."
NSQ_SOURCE_LINE 00002078 ""
NSQ_SOURCE_LINE 00002079 "=back"
NSQ_SOURCE_LINE 00002080 ""
NSQ_SOURCE_LINE 00002081 "=head2 Flush Modes"
NSQ_SOURCE_LINE 00002082 ""
NSQ_SOURCE_LINE 00002083 "=over 5"
NSQ_SOURCE_LINE 00002084 ""
NSQ_SOURCE_LINE 00002085 "=item LZMA_RUN"
NSQ_SOURCE_LINE 00002086 ""
NSQ_SOURCE_LINE 00002087 "Continue coding. Used for normal operation."
NSQ_SOURCE_LINE 00002088 ""
NSQ_SOURCE_LINE 00002089 "=item LZMA_SYNC_FLUSH"
NSQ_SOURCE_LINE 00002090 ""
NSQ_SOURCE_LINE 00002091 "Make all the input available at output. Not commonly used with LZMA."
NSQ_SOURCE_LINE 00002092 ""
NSQ_SOURCE_LINE 00002093 "=item LZMA_FULL_FLUSH"
NSQ_SOURCE_LINE 00002094 ""
NSQ_SOURCE_LINE 00002095 "Finish encoding of the current Block. Not commonly used."
NSQ_SOURCE_LINE 00002096 ""
NSQ_SOURCE_LINE 00002097 "=item LZMA_FINISH"
NSQ_SOURCE_LINE 00002098 ""
NSQ_SOURCE_LINE 00002099 "Finish the coding operation. All input must have been given to the encoder."
NSQ_SOURCE_LINE 00002100 ""
NSQ_SOURCE_LINE 00002101 "=back"
