NSQ_SOURCE_LINE 00000120 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000121 "    my($constname);"
NSQ_SOURCE_LINE 00000122 "    ($constname = $AUTOLOAD) =~ s/.*:://;"
NSQ_SOURCE_LINE 00000123 "    my ($error, $val) = constant($constname);"
NSQ_SOURCE_LINE 00000124 "    Carp::croak $error if $error;"
NSQ_SOURCE_LINE 00000125 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000126 "    *{$AUTOLOAD} = sub { $val };"
NSQ_SOURCE_LINE 00000127 "    goto &{$AUTOLOAD};"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "}"
