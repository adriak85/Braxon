NSQ_SOURCE_LINE 00000208 "sub Compress::Raw::Lzma::Parameters::parse"
NSQ_SOURCE_LINE 00000209 "{"
NSQ_SOURCE_LINE 00000210 "    my $self = shift ;"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "    my $default = shift ;"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "    my $got = $self->{Got} ;"
NSQ_SOURCE_LINE 00000215 "    my $firstTime = keys %{ $got } == 0 ;"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "    my (@Bad) ;"
NSQ_SOURCE_LINE 00000218 "    my @entered = () ;"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "    # Allow the options to be passed as a hash reference or"
NSQ_SOURCE_LINE 00000221 "    # as the complete hash."
NSQ_SOURCE_LINE 00000222 "    if (@_ == 0) {"
NSQ_SOURCE_LINE 00000223 "        @entered = () ;"
NSQ_SOURCE_LINE 00000224 "    }"
NSQ_SOURCE_LINE 00000225 "    elsif (@_ == 1) {"
NSQ_SOURCE_LINE 00000226 "        my $href = $_[0] ;"
NSQ_SOURCE_LINE 00000227 "        return $self->setError(\"Expected even number of parameters, got 1\")"
NSQ_SOURCE_LINE 00000228 "            if ! defined $href or ! ref $href or ref $href ne \"HASH\" ;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "        foreach my $key (keys %$href) {"
NSQ_SOURCE_LINE 00000231 "            push @entered, $key ;"
NSQ_SOURCE_LINE 00000232 "            push @entered, \\$href->{$key} ;"
NSQ_SOURCE_LINE 00000233 "        }"
NSQ_SOURCE_LINE 00000234 "    }"
NSQ_SOURCE_LINE 00000235 "    else {"
NSQ_SOURCE_LINE 00000236 "        my $count = @_;"
NSQ_SOURCE_LINE 00000237 "        return $self->setError(\"Expected even number of parameters, got $count\")"
NSQ_SOURCE_LINE 00000238 "            if $count % 2 != 0 ;"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "        for my $i (0.. $count / 2 - 1) {"
NSQ_SOURCE_LINE 00000241 "            push @entered, $_[2* $i] ;"
NSQ_SOURCE_LINE 00000242 "            push @entered, \\$_[2* $i+1] ;"
NSQ_SOURCE_LINE 00000243 "        }"
NSQ_SOURCE_LINE 00000244 "    }"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    while (my ($key, $v) = each %$default)"
NSQ_SOURCE_LINE 00000248 "    {"
NSQ_SOURCE_LINE 00000249 "        croak \"need 4 params [@$v]\""
NSQ_SOURCE_LINE 00000250 "            if @$v != 4 ;"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "        my ($first_only, $sticky, $type, $value) = @$v ;"
NSQ_SOURCE_LINE 00000253 "        my $x ;"
NSQ_SOURCE_LINE 00000254 "        $self->_checkType($key, \\$value, $type, 0, \\$x)"
NSQ_SOURCE_LINE 00000255 "            or return undef ;"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "        $key = lc $key;"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "        if ($firstTime || ! $sticky) {"
NSQ_SOURCE_LINE 00000260 "            $got->{$key} = [0, $type, $value, $x, $first_only, $sticky] ;"
NSQ_SOURCE_LINE 00000261 "        }"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "        $got->{$key}[OFF_PARSED] = 0 ;"
NSQ_SOURCE_LINE 00000264 "    }"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "    for my $i (0.. @entered / 2 - 1) {"
NSQ_SOURCE_LINE 00000267 "        my $key = $entered[2* $i] ;"
NSQ_SOURCE_LINE 00000268 "        my $value = $entered[2* $i+1] ;"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "        #print \"Key [$key] Value [$value]\" ;"
NSQ_SOURCE_LINE 00000271 "        #print defined $$value ? \"[$$value]\\n\" : \"[undef]\\n\";"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "        $key =~ s/^-// ;"
NSQ_SOURCE_LINE 00000274 "        my $canonkey = lc $key;"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "        if ($got->{$canonkey} && ($firstTime ||"
NSQ_SOURCE_LINE 00000277 "                                  ! $got->{$canonkey}[OFF_FIRST_ONLY]  ))"
NSQ_SOURCE_LINE 00000278 "        {"
NSQ_SOURCE_LINE 00000279 "            my $type = $got->{$canonkey}[OFF_TYPE] ;"
NSQ_SOURCE_LINE 00000280 "            my $s ;"
NSQ_SOURCE_LINE 00000281 "            $self->_checkType($key, $value, $type, 1, \\$s)"
NSQ_SOURCE_LINE 00000282 "                or return undef ;"
NSQ_SOURCE_LINE 00000283 "            #$value = $$value unless $type & Parse_store_ref ;"
NSQ_SOURCE_LINE 00000284 "            $value = $$value ;"
NSQ_SOURCE_LINE 00000285 "            $got->{$canonkey} = [1, $type, $value, $s] ;"
NSQ_SOURCE_LINE 00000286 "        }"
NSQ_SOURCE_LINE 00000287 "        else"
NSQ_SOURCE_LINE 00000288 "          { push (@Bad, $key) }"
NSQ_SOURCE_LINE 00000289 "    }"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "    if (@Bad) {"
NSQ_SOURCE_LINE 00000292 "        my ($bad) = join(\", \", @Bad) ;"
NSQ_SOURCE_LINE 00000293 "        return $self->setError(\"unknown key value(s) @Bad\") ;"
NSQ_SOURCE_LINE 00000294 "    }"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "    return 1;"
NSQ_SOURCE_LINE 00000297 "}"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "sub Compress::Raw::Lzma::Parameters::_checkType"
NSQ_SOURCE_LINE 00000300 "{"
NSQ_SOURCE_LINE 00000301 "    my $self = shift ;"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "    my $key   = shift ;"
NSQ_SOURCE_LINE 00000304 "    my $value = shift ;"
NSQ_SOURCE_LINE 00000305 "    my $type  = shift ;"
NSQ_SOURCE_LINE 00000306 "    my $validate  = shift ;"
NSQ_SOURCE_LINE 00000307 "    my $output  = shift;"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "    #local $Carp::CarpLevel = $level ;"
NSQ_SOURCE_LINE 00000310 "    #print \"PARSE $type $key $value $validate $sub\\n\" ;"
NSQ_SOURCE_LINE 00000311 "    if ( $type & Parse_store_ref)"
NSQ_SOURCE_LINE 00000312 "    {"
NSQ_SOURCE_LINE 00000313 "        #$value = $$value"
NSQ_SOURCE_LINE 00000314 "        #    if ref ${ $value } ;"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "        $$output = $value ;"
NSQ_SOURCE_LINE 00000317 "        return 1;"
NSQ_SOURCE_LINE 00000318 "    }"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "    $value = $$value ;"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "    if ($type & Parse_any)"
NSQ_SOURCE_LINE 00000323 "    {"
NSQ_SOURCE_LINE 00000324 "        $$output = $value ;"
NSQ_SOURCE_LINE 00000325 "        return 1;"
NSQ_SOURCE_LINE 00000326 "    }"
NSQ_SOURCE_LINE 00000327 "    elsif ($type & Parse_unsigned)"
NSQ_SOURCE_LINE 00000328 "    {"
NSQ_SOURCE_LINE 00000329 "        return $self->setError(\"Parameter '$key' must be an unsigned int, got 'undef'\")"
NSQ_SOURCE_LINE 00000330 "            if $validate && ! defined $value ;"
NSQ_SOURCE_LINE 00000331 "        return $self->setError(\"Parameter '$key' must be an unsigned int, got '$value'\")"
NSQ_SOURCE_LINE 00000332 "            if $validate && $value !~ /^\\d+$/;"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "        $$output = defined $value ? $value : 0 ;"
NSQ_SOURCE_LINE 00000335 "        return 1;"
NSQ_SOURCE_LINE 00000336 "    }"
NSQ_SOURCE_LINE 00000337 "    elsif ($type & Parse_signed)"
NSQ_SOURCE_LINE 00000338 "    {"
NSQ_SOURCE_LINE 00000339 "        return $self->setError(\"Parameter '$key' must be a signed int, got 'undef'\")"
NSQ_SOURCE_LINE 00000340 "            if $validate && ! defined $value ;"
NSQ_SOURCE_LINE 00000341 "        return $self->setError(\"Parameter '$key' must be a signed int, got '$value'\")"
NSQ_SOURCE_LINE 00000342 "            if $validate && $value !~ /^-?\\d+$/;"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "        $$output = defined $value ? $value : 0 ;"
NSQ_SOURCE_LINE 00000345 "        return 1 ;"
NSQ_SOURCE_LINE 00000346 "    }"
NSQ_SOURCE_LINE 00000347 "    elsif ($type & Parse_boolean)"
NSQ_SOURCE_LINE 00000348 "    {"
NSQ_SOURCE_LINE 00000349 "        return $self->setError(\"Parameter '$key' must be an int, got '$value'\")"
NSQ_SOURCE_LINE 00000350 "            if $validate && defined $value && $value !~ /^\\d*$/;"
NSQ_SOURCE_LINE 00000351 "        $$output =  defined $value ? $value != 0 : 0 ;"
NSQ_SOURCE_LINE 00000352 "        return 1;"
NSQ_SOURCE_LINE 00000353 "    }"
NSQ_SOURCE_LINE 00000354 "    elsif ($type & Parse_string)"
NSQ_SOURCE_LINE 00000355 "    {"
NSQ_SOURCE_LINE 00000356 "        $$output = defined $value ? $value : \"\" ;"
NSQ_SOURCE_LINE 00000357 "        return 1;"
NSQ_SOURCE_LINE 00000358 "    }"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "    $$output = $value ;"
NSQ_SOURCE_LINE 00000361 "    return 1;"
NSQ_SOURCE_LINE 00000362 "}"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "sub Compress::Raw::Lzma::Parameters::parsed"
NSQ_SOURCE_LINE 00000367 "{"
