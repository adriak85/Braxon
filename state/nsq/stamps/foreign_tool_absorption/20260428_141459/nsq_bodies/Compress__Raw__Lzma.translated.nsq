NSQ_SOURCE_LINE 00000953 "#package Lzma::Filter::SubBlock;"
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "package Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "1;"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "__END__"
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "=head1 NAME"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "Compress::Raw::Lzma - Low-Level Perl Interface to lzma compression library"
NSQ_SOURCE_LINE 00000966 ""
NSQ_SOURCE_LINE 00000967 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000968 ""
NSQ_SOURCE_LINE 00000969 "    use Compress::Raw::Lzma ;"
NSQ_SOURCE_LINE 00000970 ""
NSQ_SOURCE_LINE 00000971 "    # Encoders"
NSQ_SOURCE_LINE 00000972 "    my ($lz, $status) = new Compress::Raw::Lzma::EasyEncoder [OPTS]"
NSQ_SOURCE_LINE 00000973 "        or die \"Cannot create lzma object: $status\\n\";"
NSQ_SOURCE_LINE 00000974 ""
NSQ_SOURCE_LINE 00000975 "    my ($lz, $status) = new Compress::Raw::Lzma::AloneEncoder [OPTS]"
NSQ_SOURCE_LINE 00000976 "        or die \"Cannot create lzma object: $status\\n\";"
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 "    my ($lz, $status) = new Compress::Raw::Lzma::StreamEncoder [OPTS]"
NSQ_SOURCE_LINE 00000979 "        or die \"Cannot create lzma object: $status\\n\";"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "    my ($lz, $status) = new Compress::Raw::Lzma::RawEncoder [OPTS]"
NSQ_SOURCE_LINE 00000982 "        or die \"Cannot create lzma object: $status\\n\";"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "    $status = $lz->code($input, $output);"
NSQ_SOURCE_LINE 00000985 "    $status = $lz->flush($output);"
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "    # Decoders"
NSQ_SOURCE_LINE 00000988 "    my ($lz, $status) = new Compress::Raw::Lzma::AloneDecoder [OPTS]"
NSQ_SOURCE_LINE 00000989 "        or die \"Cannot create lzma object: $status\\n\";"
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "    my ($lz, $status) = new Compress::Raw::Lzma::AutoDecoder [OPTS]"
NSQ_SOURCE_LINE 00000992 "        or die \"Cannot create lzma object: $status\\n\";"
NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "    my ($lz, $status) = new Compress::Raw::Lzma::StreamDecoder [OPTS]"
NSQ_SOURCE_LINE 00000995 "        or die \"Cannot create lzma object: $status\\n\";"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "    my ($lz, $status) = new Compress::Raw::Lzma::RawDecoder [OPTS]"
NSQ_SOURCE_LINE 00000998 "        or die \"Cannot create lzma object: $status\\n\";"
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "    $status = $lz->code($input, $output);"
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "    my $version = Compress::Raw::Lzma::lzma_version_number();"
NSQ_SOURCE_LINE 00001003 "    my $version = Compress::Raw::Lzma::lzma_version_string();"
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "C<Compress::Raw::Lzma> provides an interface to the in-memory"
NSQ_SOURCE_LINE 00001008 "compression/uncompression functions from the lzma compression library."
NSQ_SOURCE_LINE 00001009 ""
NSQ_SOURCE_LINE 00001010 "Although the primary purpose for the existence of C<Compress::Raw::Lzma> is"
NSQ_SOURCE_LINE 00001011 "for use by the  C<IO::Compress::Lzma>, C<IO::Uncompress::UnLzma>,"
NSQ_SOURCE_LINE 00001012 "C<IO::Compress::Xz> and C<IO::Uncompress::UnXz> modules, it can be used on"
NSQ_SOURCE_LINE 00001013 "its own for simple compression/uncompression tasks."
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "There are two functions, called C<code> and C<flush>, used in all the"
NSQ_SOURCE_LINE 00001016 "compression and uncompression interfaces defined in this module. By default"
NSQ_SOURCE_LINE 00001017 "both of these functions overwrites any data stored in its output buffer"
NSQ_SOURCE_LINE 00001018 "parameter. If you want to compress/uncompress to a single buffer, and have"
NSQ_SOURCE_LINE 00001019 "C<code> and C<flush> append to that buffer, enable the C<AppendOutput>"
NSQ_SOURCE_LINE 00001020 "option when you create the compression/decompression object."
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "=head1 Compression"
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "There are four compression interfaces available in this module."
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "=over 5"
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "=item Compress::Raw::Lzma::EasyEncoder"
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "=item Compress::Raw::Lzma::AloneEncoder"
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "=item Compress::Raw::Lzma::StreamEncoder"
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "=item Compress::Raw::Lzma::RawEncoder"
NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "=back"
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "=head2 ($z, $status) = new Compress::Raw::Lzma::EasyEncoder [OPTS];"
NSQ_SOURCE_LINE 00001039 ""
NSQ_SOURCE_LINE 00001040 "Creates a new I<xz> compression object."
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "If successful, it will return the initialised compression object, C<$z>"
NSQ_SOURCE_LINE 00001043 "and a C<$status> of C<LZMA_OK> in a list context. In scalar context it"
NSQ_SOURCE_LINE 00001044 "returns the deflation object, C<$z>, only."
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "If not successful, the returned compression object, C<$z>, will be"
NSQ_SOURCE_LINE 00001047 "I<undef> and C<$status> will hold the an I<lzma> error code."
NSQ_SOURCE_LINE 00001048 ""
NSQ_SOURCE_LINE 00001049 "Below is a list of the valid options:"
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 "=over 5"
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "=item B<< Preset => $preset >>"
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 "Used to choose the compression preset."
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "Valid values are 0-9 and C<LZMA_PRESET_DEFAULT>."
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "0 is the fastest compression with the lowest memory usage and the lowest"
NSQ_SOURCE_LINE 00001060 "compression."
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "9 is the slowest compression with the highest memory usage but with the best"
NSQ_SOURCE_LINE 00001063 "compression."
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "Defaults to C<LZMA_PRESET_DEFAULT>."
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "=item B<< Extreme => 0|1 >>"
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "Makes the compression a lot slower, but a small compression gain."
NSQ_SOURCE_LINE 00001070 ""
NSQ_SOURCE_LINE 00001071 "Defaults to 0."
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "=item B<< Check => $check >>"
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "Used to specify the integrity check used in the xz data stream."
NSQ_SOURCE_LINE 00001076 "Valid values are C<LZMA_CHECK_NONE>, C<LZMA_CHECK_CRC32>,"
NSQ_SOURCE_LINE 00001077 "C<LZMA_CHECK_CRC64>, C<LZMA_CHECK_SHA256>."
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "Defaults to C<LZMA_CHECK_CRC32>."
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "=item B<< AppendOutput => 0|1 >>"
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "Controls whether the compressed data is appended to the output buffer in"
NSQ_SOURCE_LINE 00001084 "the C<code> and C<flush> methods."
NSQ_SOURCE_LINE 00001085 ""
NSQ_SOURCE_LINE 00001086 "Defaults to 0."
NSQ_SOURCE_LINE 00001087 "(Note in versions of this module prior to 2.072 the default value was"
NSQ_SOURCE_LINE 00001088 "incorrectly documented as 1)."
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "=item B<< BufSize => $number >>"
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "Sets the initial size for the output buffer used by the C<$d-E<gt>code>"
NSQ_SOURCE_LINE 00001093 "method. If the buffer has to be reallocated to increase the size, it will"
NSQ_SOURCE_LINE 00001094 "grow in increments of C<Bufsize>."
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 "Defaults to 16k."
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "=back"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "=head2 ($z, $status) = new Compress::Raw::Lzma::AloneEncoder [OPTS];"
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "Creates a legacy I<lzma> compression object. This format is also know as"
NSQ_SOURCE_LINE 00001103 "lzma_alone."
NSQ_SOURCE_LINE 00001104 ""
NSQ_SOURCE_LINE 00001105 "If successful, it will return the initialised compression object, C<$z>"
NSQ_SOURCE_LINE 00001106 "and a C<$status> of C<LZMA_OK> in a list context. In scalar context it"
NSQ_SOURCE_LINE 00001107 "returns the deflation object, C<$z>, only."
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "If not successful, the returned compression object, C<$z>, will be"
NSQ_SOURCE_LINE 00001110 "I<undef> and C<$status> will hold the an I<lzma> error code."
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 "Below is a list of the valid options:"
NSQ_SOURCE_LINE 00001113 ""
NSQ_SOURCE_LINE 00001114 "=over 5"
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "=item B<< Filter => $filter >>"
NSQ_SOURCE_LINE 00001117 ""
NSQ_SOURCE_LINE 00001118 "The C< $filter > option must be an object of type C<Lzma::Filter::Lzma1>."
NSQ_SOURCE_LINE 00001119 "See L<Compress::Raw::Lzma/Lzma::Filter::Lzma> for a definition"
NSQ_SOURCE_LINE 00001120 "of C<Lzma::Filter::Lzma1>."
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "If this option is not present an C<Lzma::Filter::Lzma1> object with default"
NSQ_SOURCE_LINE 00001123 "values will be used."
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "=item B<< AppendOutput => 0|1 >>"
NSQ_SOURCE_LINE 00001126 ""
NSQ_SOURCE_LINE 00001127 "Controls whether the compressed data is appended to the output buffer in"
NSQ_SOURCE_LINE 00001128 "the C<code> and C<flush> methods."
NSQ_SOURCE_LINE 00001129 ""
NSQ_SOURCE_LINE 00001130 "Defaults to 0."
NSQ_SOURCE_LINE 00001131 "(Note in versions of this module prior to 2.072 the default value was"
NSQ_SOURCE_LINE 00001132 "incorrectly documented as 1)."
NSQ_SOURCE_LINE 00001133 ""
NSQ_SOURCE_LINE 00001134 "=item B<< BufSize => $number >>"
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 "Sets the initial size for the output buffer used by the C<$d-E<gt>code>"
NSQ_SOURCE_LINE 00001137 "method. If the buffer has to be reallocated to increase the size, it will"
NSQ_SOURCE_LINE 00001138 "grow in increments of C<Bufsize>."
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "Defaults to 16k."
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "=back"
NSQ_SOURCE_LINE 00001143 ""
NSQ_SOURCE_LINE 00001144 "=head2 ($z, $status) = new Compress::Raw::Lzma::StreamEncoder [OPTS];"
NSQ_SOURCE_LINE 00001145 ""
NSQ_SOURCE_LINE 00001146 "Creates a I<xz> compression object."
NSQ_SOURCE_LINE 00001147 ""
NSQ_SOURCE_LINE 00001148 "If successful, it will return the initialised compression object, C<$z>"
NSQ_SOURCE_LINE 00001149 "and a C<$status> of C<LZMA_OK> in a list context. In scalar context it"
NSQ_SOURCE_LINE 00001150 "returns the deflation object, C<$z>, only."
NSQ_SOURCE_LINE 00001151 ""
NSQ_SOURCE_LINE 00001152 "If not successful, the returned compression object, C<$z>, will be"
NSQ_SOURCE_LINE 00001153 "I<undef> and C<$status> will hold the an I<lzma> error code."
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "Below is a list of the valid options:"
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "=over 5"
NSQ_SOURCE_LINE 00001158 ""
NSQ_SOURCE_LINE 00001159 "=item B<< Filter => $filter >>"
NSQ_SOURCE_LINE 00001160 ""
NSQ_SOURCE_LINE 00001161 "=item B<< Filter => [$filter1, $filter2,...] >>"
NSQ_SOURCE_LINE 00001162 ""
NSQ_SOURCE_LINE 00001163 "This option is used to change the bahaviour of the StreamEncoder by"
NSQ_SOURCE_LINE 00001164 "applying between one and C<LZMA_FILTERS_MAX> filters to the data stream"
NSQ_SOURCE_LINE 00001165 "during compression. See L</Filters> for more details on the available"
NSQ_SOURCE_LINE 00001166 "filters."
NSQ_SOURCE_LINE 00001167 ""
NSQ_SOURCE_LINE 00001168 "If this option is present it must either contain a single"
NSQ_SOURCE_LINE 00001169 "C<Lzma::Filter::Lzma> filter object or an array reference containing between"
NSQ_SOURCE_LINE 00001170 "one and C<LZMA_FILTERS_MAX> filter objects."
NSQ_SOURCE_LINE 00001171 ""
NSQ_SOURCE_LINE 00001172 "If this option is not present an C<Lzma::Filter::Lzma2> object with default"
NSQ_SOURCE_LINE 00001173 "values will be used."
NSQ_SOURCE_LINE 00001174 ""
NSQ_SOURCE_LINE 00001175 "=item B<< Check => $check >>"
NSQ_SOURCE_LINE 00001176 ""
NSQ_SOURCE_LINE 00001177 "Used to specify the integrity check used in the xz data stream."
NSQ_SOURCE_LINE 00001178 "Valid values are C<LZMA_CHECK_NONE>, C<LZMA_CHECK_CRC32>,"
NSQ_SOURCE_LINE 00001179 "C<LZMA_CHECK_CRC64>, C<LZMA_CHECK_SHA256>."
NSQ_SOURCE_LINE 00001180 ""
NSQ_SOURCE_LINE 00001181 "Defaults to C<LZMA_CHECK_CRC32>."
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "=item B<< AppendOutput => 0|1 >>"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "Controls whether the compressed data is appended to the output buffer in"
NSQ_SOURCE_LINE 00001186 "the C<code> and C<flush> methods."
NSQ_SOURCE_LINE 00001187 ""
NSQ_SOURCE_LINE 00001188 "Defaults to 0."
NSQ_SOURCE_LINE 00001189 "(Note in versions of this module prior to 2.072 the default value was"
NSQ_SOURCE_LINE 00001190 "incorrectly documented as 1)."
NSQ_SOURCE_LINE 00001191 ""
NSQ_SOURCE_LINE 00001192 "=item B<< BufSize => $number >>"
NSQ_SOURCE_LINE 00001193 ""
NSQ_SOURCE_LINE 00001194 "Sets the initial size for the output buffer used by the C<$d-E<gt>code>"
NSQ_SOURCE_LINE 00001195 "method. If the buffer has to be reallocated to increase the size, it will"
NSQ_SOURCE_LINE 00001196 "grow in increments of C<Bufsize>."
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "Defaults to 16k."
NSQ_SOURCE_LINE 00001199 ""
NSQ_SOURCE_LINE 00001200 "=back"
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "=head2 ($z, $status) = new Compress::Raw::Lzma::RawEncoder [OPTS];"
NSQ_SOURCE_LINE 00001203 ""
NSQ_SOURCE_LINE 00001204 "Low level access to lzma."
NSQ_SOURCE_LINE 00001205 ""
NSQ_SOURCE_LINE 00001206 "If successful, it will return the initialised compression object, C<$z>"
NSQ_SOURCE_LINE 00001207 "and a C<$status> of C<LZMA_OK> in a list context. In scalar context it"
NSQ_SOURCE_LINE 00001208 "returns the deflation object, C<$z>, only."
NSQ_SOURCE_LINE 00001209 ""
NSQ_SOURCE_LINE 00001210 "If not successful, the returned compression object, C<$z>, will be"
NSQ_SOURCE_LINE 00001211 "I<undef> and C<$status> will hold the an I<lzma> error code."
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 "Below is a list of the valid options:"
NSQ_SOURCE_LINE 00001214 ""
NSQ_SOURCE_LINE 00001215 "=over 5"
NSQ_SOURCE_LINE 00001216 ""
NSQ_SOURCE_LINE 00001217 "=item B<< Filter => $filter >>"
NSQ_SOURCE_LINE 00001218 ""
NSQ_SOURCE_LINE 00001219 "=item B<< Filter => [$filter1, $filter2,...] >>"
NSQ_SOURCE_LINE 00001220 ""
NSQ_SOURCE_LINE 00001221 "This option is used to change the bahaviour of the RawEncoder by"
NSQ_SOURCE_LINE 00001222 "applying between one and C<LZMA_FILTERS_MAX> filters to the data stream"
NSQ_SOURCE_LINE 00001223 "during compression. See L</Filters> for more details on the available"
NSQ_SOURCE_LINE 00001224 "filters."
NSQ_SOURCE_LINE 00001225 ""
NSQ_SOURCE_LINE 00001226 "If this option is present it must either contain a single"
NSQ_SOURCE_LINE 00001227 "C<Lzma::Filter::Lzma> filter object or an array reference containing between"
NSQ_SOURCE_LINE 00001228 "one and C<LZMA_FILTERS_MAX> filter objects."
NSQ_SOURCE_LINE 00001229 ""
NSQ_SOURCE_LINE 00001230 "If this option is not present an C<Lzma::Filter::Lzma2> object with default"
NSQ_SOURCE_LINE 00001231 "values will be used."
NSQ_SOURCE_LINE 00001232 ""
NSQ_SOURCE_LINE 00001233 "=item B<< AppendOutput => 0|1 >>"
NSQ_SOURCE_LINE 00001234 ""
NSQ_SOURCE_LINE 00001235 "Controls whether the compressed data is appended to the output buffer in"
NSQ_SOURCE_LINE 00001236 "the C<code> and C<flush> methods."
NSQ_SOURCE_LINE 00001237 ""
NSQ_SOURCE_LINE 00001238 "Defaults to 0."
NSQ_SOURCE_LINE 00001239 "(Note in versions of this module prior to 2.072 the default value was"
NSQ_SOURCE_LINE 00001240 "incorrectly documented as 1)."
NSQ_SOURCE_LINE 00001241 ""
NSQ_SOURCE_LINE 00001242 "=item B<< BufSize => $number >>"
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "Sets the initial size for the output buffer used by the C<$d-E<gt>code>"
NSQ_SOURCE_LINE 00001245 "method. If the buffer has to be reallocated to increase the size, it will"
NSQ_SOURCE_LINE 00001246 "grow in increments of C<Bufsize>."
NSQ_SOURCE_LINE 00001247 ""
NSQ_SOURCE_LINE 00001248 "Defaults to 16k."
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "=item B<< ForZip => 1/0 >>"
NSQ_SOURCE_LINE 00001251 ""
NSQ_SOURCE_LINE 00001252 "This boolean option is used to enable prefixing the compressed data stream"
NSQ_SOURCE_LINE 00001253 "with an encoded copy of the filter properties."
NSQ_SOURCE_LINE 00001254 ""
NSQ_SOURCE_LINE 00001255 "Defaults to 0."
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "=back"
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "=head2 $status = $lz->code($input, $output)"
NSQ_SOURCE_LINE 00001260 ""
NSQ_SOURCE_LINE 00001261 "Reads the contents of C<$input>, compresses it and writes the compressed"
NSQ_SOURCE_LINE 00001262 "data to C<$output>."
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "Returns C<LZMA_OK> on success and an C<lzma> error code on failure."
NSQ_SOURCE_LINE 00001265 ""
NSQ_SOURCE_LINE 00001266 "If C<appendOutput> is enabled in the constructor for the lzma object, the"
NSQ_SOURCE_LINE 00001267 "compressed data will be appended to C<$output>. If not enabled, C<$output>"
NSQ_SOURCE_LINE 00001268 "will be truncated before the compressed data is written to it."
NSQ_SOURCE_LINE 00001269 ""
NSQ_SOURCE_LINE 00001270 "=head2 $status = $lz->flush($output, LZMA_FINISH);"
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 "Flushes any pending compressed data to C<$output>. By default it terminates"
NSQ_SOURCE_LINE 00001273 "the compressed data stream."
NSQ_SOURCE_LINE 00001274 ""
NSQ_SOURCE_LINE 00001275 "Returns C<LZMA_STREAM_END> on success and an C<lzma> error code on failure."
NSQ_SOURCE_LINE 00001276 ""
NSQ_SOURCE_LINE 00001277 "=head1 Compression examples"
NSQ_SOURCE_LINE 00001278 ""
NSQ_SOURCE_LINE 00001279 "=head2 Simple compression with EasyEncoder"
NSQ_SOURCE_LINE 00001280 ""
NSQ_SOURCE_LINE 00001281 "    use strict;"
NSQ_SOURCE_LINE 00001282 "    use warnings;"
NSQ_SOURCE_LINE 00001283 ""
NSQ_SOURCE_LINE 00001284 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001285 ""
NSQ_SOURCE_LINE 00001286 "    my ($lz, $status) = Compress::Raw::Lzma::EasyEncoder->new("
NSQ_SOURCE_LINE 00001287 "        Preset => 6,"
NSQ_SOURCE_LINE 00001288 "        Extreme => 0,"
NSQ_SOURCE_LINE 00001289 "    );"
NSQ_SOURCE_LINE 00001290 "    die \"Cannot create encoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001291 ""
NSQ_SOURCE_LINE 00001292 "    my $input = \"This is the data to compress \" x 100;"
NSQ_SOURCE_LINE 00001293 "    my $compressed = '';"
NSQ_SOURCE_LINE 00001294 ""
NSQ_SOURCE_LINE 00001295 "    $status = $lz->code($input, $compressed);"
NSQ_SOURCE_LINE 00001296 "    die \"Compression failed: $status\\n\" unless $status == LZMA_OK;"
NSQ_SOURCE_LINE 00001297 ""
NSQ_SOURCE_LINE 00001298 "    $status = $lz->flush($compressed);"
NSQ_SOURCE_LINE 00001299 "    die \"Flush failed: $status\\n\" unless $status == LZMA_STREAM_END;"
NSQ_SOURCE_LINE 00001300 ""
NSQ_SOURCE_LINE 00001301 "    print \"Original size: \", length($input), \"\\n\";"
NSQ_SOURCE_LINE 00001302 "    print \"Compressed size: \", length($compressed), \"\\n\";"
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 "=head2 Streaming compression with AppendOutput"
NSQ_SOURCE_LINE 00001305 ""
NSQ_SOURCE_LINE 00001306 "    use strict;"
NSQ_SOURCE_LINE 00001307 "    use warnings;"
NSQ_SOURCE_LINE 00001308 ""
NSQ_SOURCE_LINE 00001309 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 "    my ($lz, $status) = Compress::Raw::Lzma::EasyEncoder->new("
NSQ_SOURCE_LINE 00001312 "        AppendOutput => 1,"
NSQ_SOURCE_LINE 00001313 "        Preset => LZMA_PRESET_DEFAULT,"
NSQ_SOURCE_LINE 00001314 "    );"
NSQ_SOURCE_LINE 00001315 "    die \"Cannot create encoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001316 ""
NSQ_SOURCE_LINE 00001317 "    my $compressed = '';"
NSQ_SOURCE_LINE 00001318 ""
NSQ_SOURCE_LINE 00001319 "    # Compress data in chunks"
NSQ_SOURCE_LINE 00001320 "    for my $chunk (\"Hello \", \"world\", \"!\") {"
NSQ_SOURCE_LINE 00001321 "        $status = $lz->code($chunk, $compressed);"
NSQ_SOURCE_LINE 00001322 "        die \"Compression failed\\n\" unless $status == LZMA_OK;"
NSQ_SOURCE_LINE 00001323 "    }"
NSQ_SOURCE_LINE 00001324 ""
NSQ_SOURCE_LINE 00001325 "    # Finish compression"
NSQ_SOURCE_LINE 00001326 "    $status = $lz->flush($compressed);"
NSQ_SOURCE_LINE 00001327 "    die \"Flush failed\\n\" unless $status == LZMA_STREAM_END;"
NSQ_SOURCE_LINE 00001328 ""
NSQ_SOURCE_LINE 00001329 "    print \"Compressed: \", length($compressed), \" bytes\\n\";"
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 "=head2 Using custom filters with StreamEncoder"
NSQ_SOURCE_LINE 00001332 ""
NSQ_SOURCE_LINE 00001333 "    use strict;"
NSQ_SOURCE_LINE 00001334 "    use warnings;"
NSQ_SOURCE_LINE 00001335 ""
NSQ_SOURCE_LINE 00001336 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001337 ""
NSQ_SOURCE_LINE 00001338 "    # Create a custom LZMA2 filter"
NSQ_SOURCE_LINE 00001339 "    my $filter = Lzma::Filter::Lzma2("
NSQ_SOURCE_LINE 00001340 "        DictSize => 1024 * 1024 * 8,  # 8MB dictionary"
NSQ_SOURCE_LINE 00001341 "        Lc => 3,"
NSQ_SOURCE_LINE 00001342 "        Lp => 0,"
NSQ_SOURCE_LINE 00001343 "        Pb => 2,"
NSQ_SOURCE_LINE 00001344 "        Mode => LZMA_MODE_NORMAL,"
NSQ_SOURCE_LINE 00001345 "        Nice => 128,"
NSQ_SOURCE_LINE 00001346 "        Mf => LZMA_MF_BT4,"
NSQ_SOURCE_LINE 00001347 "        Depth => 512,"
NSQ_SOURCE_LINE 00001348 "    );"
NSQ_SOURCE_LINE 00001349 ""
NSQ_SOURCE_LINE 00001350 "    my ($lz, $status) = Compress::Raw::Lzma::StreamEncoder->new("
NSQ_SOURCE_LINE 00001351 "        Filter => $filter,"
NSQ_SOURCE_LINE 00001352 "        Check => LZMA_CHECK_SHA256,"
NSQ_SOURCE_LINE 00001353 "    );"
NSQ_SOURCE_LINE 00001354 "    die \"Cannot create encoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001355 ""
NSQ_SOURCE_LINE 00001356 "    my $input = \"Custom filter example data\";"
NSQ_SOURCE_LINE 00001357 "    my $compressed = '';"
NSQ_SOURCE_LINE 00001358 ""
NSQ_SOURCE_LINE 00001359 "    $status = $lz->code($input, $compressed);"
NSQ_SOURCE_LINE 00001360 "    $status = $lz->flush(compressed);"
NSQ_SOURCE_LINE 00001361 ""
NSQ_SOURCE_LINE 00001362 "=head2 Using multiple filters (BCJ + LZMA2)"
NSQ_SOURCE_LINE 00001363 ""
NSQ_SOURCE_LINE 00001364 "    use strict;"
NSQ_SOURCE_LINE 00001365 "    use warnings;"
NSQ_SOURCE_LINE 00001366 ""
NSQ_SOURCE_LINE 00001367 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001368 ""
NSQ_SOURCE_LINE 00001369 "    # Combine BCJ filter for x86 binaries with LZMA2 compression"
NSQ_SOURCE_LINE 00001370 "    my @filters = ("
NSQ_SOURCE_LINE 00001371 "        Lzma::Filter::X86(),      # BCJ filter for x86 code"
NSQ_SOURCE_LINE 00001372 "        Lzma::Filter::Lzma2(),    # LZMA2 compression"
NSQ_SOURCE_LINE 00001373 "    );"
NSQ_SOURCE_LINE 00001374 ""
NSQ_SOURCE_LINE 00001375 "    my ($lz, $status) = Compress::Raw::Lzma::StreamEncoder->new("
NSQ_SOURCE_LINE 00001376 "        Filter => \\@filters,"
NSQ_SOURCE_LINE 00001377 "        Check => LZMA_CHECK_CRC64,"
NSQ_SOURCE_LINE 00001378 "    );"
NSQ_SOURCE_LINE 00001379 "    die \"Cannot create encoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001380 ""
NSQ_SOURCE_LINE 00001381 "    # ... compress binary data ..."
NSQ_SOURCE_LINE 00001382 ""
NSQ_SOURCE_LINE 00001383 "=head1 Uncompression"
NSQ_SOURCE_LINE 00001384 ""
NSQ_SOURCE_LINE 00001385 "There are four uncompression interfaces available in this module."
NSQ_SOURCE_LINE 00001386 ""
NSQ_SOURCE_LINE 00001387 "=over 5"
NSQ_SOURCE_LINE 00001388 ""
NSQ_SOURCE_LINE 00001389 "=item Compress::Raw::Lzma::AutoDecoder"
NSQ_SOURCE_LINE 00001390 ""
NSQ_SOURCE_LINE 00001391 "=item Compress::Raw::Lzma::AloneDecoder"
NSQ_SOURCE_LINE 00001392 ""
NSQ_SOURCE_LINE 00001393 "=item Compress::Raw::Lzma::StreamDecoder"
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 "=item Compress::Raw::Lzma::RawDecoder"
NSQ_SOURCE_LINE 00001396 ""
NSQ_SOURCE_LINE 00001397 "=back"
NSQ_SOURCE_LINE 00001398 ""
NSQ_SOURCE_LINE 00001399 "=head2 ($z, $status) = new Compress::Raw::Lzma::AutoDecoder [OPTS] ;"
NSQ_SOURCE_LINE 00001400 ""
NSQ_SOURCE_LINE 00001401 "Create an object that can uncompress any of the compressed data streams"
NSQ_SOURCE_LINE 00001402 "that can be created by this module."
NSQ_SOURCE_LINE 00001403 ""
NSQ_SOURCE_LINE 00001404 "If successful, it will return the initialised uncompression object, C<$z>"
NSQ_SOURCE_LINE 00001405 "and a C<$status> of C<LZMA_OK> in a list context. In scalar context it"
NSQ_SOURCE_LINE 00001406 "returns the deflation object, C<$z>, only."
NSQ_SOURCE_LINE 00001407 ""
NSQ_SOURCE_LINE 00001408 "If not successful, the returned uncompression object, C<$z>, will be"
NSQ_SOURCE_LINE 00001409 "I<undef> and C<$status> will hold the an I<lzma> error code."
NSQ_SOURCE_LINE 00001410 ""
NSQ_SOURCE_LINE 00001411 "Below is a list of the valid options:"
NSQ_SOURCE_LINE 00001412 ""
NSQ_SOURCE_LINE 00001413 "=over 5"
NSQ_SOURCE_LINE 00001414 ""
NSQ_SOURCE_LINE 00001415 "=item B<-MemLimit>"
NSQ_SOURCE_LINE 00001416 ""
NSQ_SOURCE_LINE 00001417 "The number of bytes to use when uncompressing."
NSQ_SOURCE_LINE 00001418 ""
NSQ_SOURCE_LINE 00001419 "Default is unlimited."
NSQ_SOURCE_LINE 00001420 ""
NSQ_SOURCE_LINE 00001421 "=item B<-Bufsize>"
NSQ_SOURCE_LINE 00001422 ""
NSQ_SOURCE_LINE 00001423 "Sets the initial size for the output buffer used by the C<$i-E<gt>code>"
NSQ_SOURCE_LINE 00001424 "method. If the output buffer in this method has to be reallocated to"
NSQ_SOURCE_LINE 00001425 "increase the size, it will grow in increments of C<Bufsize>."
NSQ_SOURCE_LINE 00001426 ""
NSQ_SOURCE_LINE 00001427 "Default is 16k."
NSQ_SOURCE_LINE 00001428 ""
NSQ_SOURCE_LINE 00001429 "=item B<-AppendOutput>"
NSQ_SOURCE_LINE 00001430 ""
NSQ_SOURCE_LINE 00001431 "This option controls how data is written to the output buffer by the"
NSQ_SOURCE_LINE 00001432 "C<$i-E<gt>code> method."
NSQ_SOURCE_LINE 00001433 ""
NSQ_SOURCE_LINE 00001434 "If the option is set to false, the output buffer in the C<$i-E<gt>code>"
NSQ_SOURCE_LINE 00001435 "method will be truncated before uncompressed data is written to it."
NSQ_SOURCE_LINE 00001436 ""
NSQ_SOURCE_LINE 00001437 "If the option is set to true, uncompressed data will be appended to the"
NSQ_SOURCE_LINE 00001438 "output buffer by the C<$i-E<gt>code> method."
NSQ_SOURCE_LINE 00001439 ""
NSQ_SOURCE_LINE 00001440 "This option defaults to false."
NSQ_SOURCE_LINE 00001441 ""
NSQ_SOURCE_LINE 00001442 "=item B<-ConsumeInput>"
NSQ_SOURCE_LINE 00001443 ""
NSQ_SOURCE_LINE 00001444 "If set to true, this option will remove compressed data from the input"
NSQ_SOURCE_LINE 00001445 "buffer of the C<< $i->code >> method as the uncompression progresses."
NSQ_SOURCE_LINE 00001446 ""
NSQ_SOURCE_LINE 00001447 "This option can be useful when you are processing compressed data that is"
NSQ_SOURCE_LINE 00001448 "embedded in another file/buffer. In this case the data that immediately"
NSQ_SOURCE_LINE 00001449 "follows the compressed stream will be left in the input buffer."
NSQ_SOURCE_LINE 00001450 ""
NSQ_SOURCE_LINE 00001451 "This option defaults to true."
NSQ_SOURCE_LINE 00001452 ""
NSQ_SOURCE_LINE 00001453 "=item B<-LimitOutput>"
NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 "The C<LimitOutput> option changes the behavior of the C<< $i->code >>"
NSQ_SOURCE_LINE 00001456 "method so that the amount of memory used by the output buffer can be"
NSQ_SOURCE_LINE 00001457 "limited."
NSQ_SOURCE_LINE 00001458 ""
NSQ_SOURCE_LINE 00001459 "When C<LimitOutput> is used the size of the output buffer used will either"
NSQ_SOURCE_LINE 00001460 "be the value of the C<Bufsize> option or the amount of memory already"
NSQ_SOURCE_LINE 00001461 "allocated to C<$output>, whichever is larger. Predicting the output size"
NSQ_SOURCE_LINE 00001462 "available is tricky, so don't rely on getting an exact output buffer size."
NSQ_SOURCE_LINE 00001463 ""
NSQ_SOURCE_LINE 00001464 "When C<LimitOutout> is not specified C<< $i->code >> will use as much"
NSQ_SOURCE_LINE 00001465 "memory as it takes to write all the uncompressed data it creates by"
NSQ_SOURCE_LINE 00001466 "uncompressing the input buffer."
NSQ_SOURCE_LINE 00001467 ""
NSQ_SOURCE_LINE 00001468 "If C<LimitOutput> is enabled, the C<ConsumeInput> option will also be"
NSQ_SOURCE_LINE 00001469 "enabled."
NSQ_SOURCE_LINE 00001470 ""
NSQ_SOURCE_LINE 00001471 "This option defaults to false."
NSQ_SOURCE_LINE 00001472 ""
NSQ_SOURCE_LINE 00001473 "=back"
NSQ_SOURCE_LINE 00001474 ""
NSQ_SOURCE_LINE 00001475 "=head2 ($z, $status) = new Compress::Raw::Lzma::AloneDecoder [OPTS] ;"
NSQ_SOURCE_LINE 00001476 ""
NSQ_SOURCE_LINE 00001477 "Create an object that can uncompress an lzma_alone data stream."
NSQ_SOURCE_LINE 00001478 ""
NSQ_SOURCE_LINE 00001479 "If successful, it will return the initialised uncompression object, C<$z>"
NSQ_SOURCE_LINE 00001480 "and a C<$status> of C<LZMA_OK> in a list context. In scalar context it"
NSQ_SOURCE_LINE 00001481 "returns the deflation object, C<$z>, only."
NSQ_SOURCE_LINE 00001482 ""
NSQ_SOURCE_LINE 00001483 "If not successful, the returned uncompression object, C<$z>, will be"
NSQ_SOURCE_LINE 00001484 "I<undef> and C<$status> will hold the an I<lzma> error code."
NSQ_SOURCE_LINE 00001485 ""
NSQ_SOURCE_LINE 00001486 "Below is a list of the valid options:"
NSQ_SOURCE_LINE 00001487 ""
NSQ_SOURCE_LINE 00001488 "=over 5"
NSQ_SOURCE_LINE 00001489 ""
NSQ_SOURCE_LINE 00001490 "=item B<-MemLimit>"
NSQ_SOURCE_LINE 00001491 ""
NSQ_SOURCE_LINE 00001492 "The number of bytes to use when uncompressing."
NSQ_SOURCE_LINE 00001493 ""
NSQ_SOURCE_LINE 00001494 "Default is unlimited."
NSQ_SOURCE_LINE 00001495 ""
NSQ_SOURCE_LINE 00001496 "=item B<-Bufsize>"
NSQ_SOURCE_LINE 00001497 ""
NSQ_SOURCE_LINE 00001498 "Sets the initial size for the output buffer used by the C<$i-E<gt>code>"
NSQ_SOURCE_LINE 00001499 "method. If the output buffer in this method has to be reallocated to"
NSQ_SOURCE_LINE 00001500 "increase the size, it will grow in increments of C<Bufsize>."
NSQ_SOURCE_LINE 00001501 ""
NSQ_SOURCE_LINE 00001502 "Default is 16k."
NSQ_SOURCE_LINE 00001503 ""
NSQ_SOURCE_LINE 00001504 "=item B<-AppendOutput>"
NSQ_SOURCE_LINE 00001505 ""
NSQ_SOURCE_LINE 00001506 "This option controls how data is written to the output buffer by the"
NSQ_SOURCE_LINE 00001507 "C<$i-E<gt>code> method."
NSQ_SOURCE_LINE 00001508 ""
NSQ_SOURCE_LINE 00001509 "If the option is set to false, the output buffer in the C<$i-E<gt>code>"
NSQ_SOURCE_LINE 00001510 "method will be truncated before uncompressed data is written to it."
NSQ_SOURCE_LINE 00001511 ""
NSQ_SOURCE_LINE 00001512 "If the option is set to true, uncompressed data will be appended to the"
NSQ_SOURCE_LINE 00001513 "output buffer by the C<$i-E<gt>code> method."
NSQ_SOURCE_LINE 00001514 ""
NSQ_SOURCE_LINE 00001515 "This option defaults to false."
NSQ_SOURCE_LINE 00001516 ""
NSQ_SOURCE_LINE 00001517 "=item B<-ConsumeInput>"
NSQ_SOURCE_LINE 00001518 ""
NSQ_SOURCE_LINE 00001519 "If set to true, this option will remove compressed data from the input"
NSQ_SOURCE_LINE 00001520 "buffer of the C<< $i->code >> method as the uncompression progresses."
NSQ_SOURCE_LINE 00001521 ""
NSQ_SOURCE_LINE 00001522 "This option can be useful when you are processing compressed data that is"
NSQ_SOURCE_LINE 00001523 "embedded in another file/buffer. In this case the data that immediately"
NSQ_SOURCE_LINE 00001524 "follows the compressed stream will be left in the input buffer."
NSQ_SOURCE_LINE 00001525 ""
NSQ_SOURCE_LINE 00001526 "This option defaults to true."
NSQ_SOURCE_LINE 00001527 ""
NSQ_SOURCE_LINE 00001528 "=item B<-LimitOutput>"
NSQ_SOURCE_LINE 00001529 ""
NSQ_SOURCE_LINE 00001530 "The C<LimitOutput> option changes the behavior of the C<< $i->code >>"
NSQ_SOURCE_LINE 00001531 "method so that the amount of memory used by the output buffer can be"
NSQ_SOURCE_LINE 00001532 "limited."
NSQ_SOURCE_LINE 00001533 ""
NSQ_SOURCE_LINE 00001534 "When C<LimitOutput> is used the size of the output buffer used will either"
NSQ_SOURCE_LINE 00001535 "be the value of the C<Bufsize> option or the amount of memory already"
NSQ_SOURCE_LINE 00001536 "allocated to C<$output>, whichever is larger. Predicting the output size"
NSQ_SOURCE_LINE 00001537 "available is tricky, so don't rely on getting an exact output buffer size."
NSQ_SOURCE_LINE 00001538 ""
NSQ_SOURCE_LINE 00001539 "When C<LimitOutout> is not specified C<< $i->code >> will use as much"
NSQ_SOURCE_LINE 00001540 "memory as it takes to write all the uncompressed data it creates by"
NSQ_SOURCE_LINE 00001541 "uncompressing the input buffer."
NSQ_SOURCE_LINE 00001542 ""
NSQ_SOURCE_LINE 00001543 "If C<LimitOutput> is enabled, the C<ConsumeInput> option will also be"
NSQ_SOURCE_LINE 00001544 "enabled."
NSQ_SOURCE_LINE 00001545 ""
NSQ_SOURCE_LINE 00001546 "This option defaults to false."
NSQ_SOURCE_LINE 00001547 ""
NSQ_SOURCE_LINE 00001548 "=back"
NSQ_SOURCE_LINE 00001549 ""
NSQ_SOURCE_LINE 00001550 "=head2 $status = $z->code($input, $output);"
NSQ_SOURCE_LINE 00001551 ""
NSQ_SOURCE_LINE 00001552 "Uncompresses C<$input> and writes the uncompressed data to C<$output>."
NSQ_SOURCE_LINE 00001553 ""
NSQ_SOURCE_LINE 00001554 "Returns C<LZMA_OK> if the uncompression was successful, but the end of the"
NSQ_SOURCE_LINE 00001555 "compressed data stream has not been reached. Returns C<LZMA_STREAM_END> on"
NSQ_SOURCE_LINE 00001556 "successful uncompression and the end of the compression stream has been"
NSQ_SOURCE_LINE 00001557 "reached."
NSQ_SOURCE_LINE 00001558 ""
NSQ_SOURCE_LINE 00001559 "If C<consumeInput> is enabled in the constructor for the lzma object,"
NSQ_SOURCE_LINE 00001560 "C<$input> will have all compressed data removed from it after"
NSQ_SOURCE_LINE 00001561 "uncompression. On C<LZMA_OK> return this will mean that C<$input> will be an"
NSQ_SOURCE_LINE 00001562 "empty string; when C<LZMA_STREAM_END> C<$input> will either be an empty"
NSQ_SOURCE_LINE 00001563 "string or will contain whatever data immediately followed the compressed"
NSQ_SOURCE_LINE 00001564 "data stream."
NSQ_SOURCE_LINE 00001565 ""
NSQ_SOURCE_LINE 00001566 "If C<appendOutput> is enabled in the constructor for the lzma object,"
NSQ_SOURCE_LINE 00001567 "the uncompressed data will be appended to C<$output>. If not enabled,"
NSQ_SOURCE_LINE 00001568 "C<$output> will be truncated before the uncompressed data is written to it."
NSQ_SOURCE_LINE 00001569 ""
NSQ_SOURCE_LINE 00001570 "=head1 Uncompression examples"
NSQ_SOURCE_LINE 00001571 ""
NSQ_SOURCE_LINE 00001572 "=head2 Simple uncompression with AutoDecoder"
NSQ_SOURCE_LINE 00001573 ""
NSQ_SOURCE_LINE 00001574 "    use strict;"
NSQ_SOURCE_LINE 00001575 "    use warnings;"
NSQ_SOURCE_LINE 00001576 ""
NSQ_SOURCE_LINE 00001577 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001578 ""
NSQ_SOURCE_LINE 00001579 "    # $compressed contains xz/lzma compressed data"
NSQ_SOURCE_LINE 00001580 "    my $compressed = ...;"
NSQ_SOURCE_LINE 00001581 ""
NSQ_SOURCE_LINE 00001582 "    my ($lz, $status) = Compress::Raw::Lzma::AutoDecoder->new("
NSQ_SOURCE_LINE 00001583 "        AppendOutput => 1,"
NSQ_SOURCE_LINE 00001584 "        ConsumeInput => 1,"
NSQ_SOURCE_LINE 00001585 "    );"
NSQ_SOURCE_LINE 00001586 "    die \"Cannot create decoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001587 ""
NSQ_SOURCE_LINE 00001588 "    my $uncompressed = '';"
NSQ_SOURCE_LINE 00001589 "    $status = $lz->code($compressed, $uncompressed);"
NSQ_SOURCE_LINE 00001590 "    die \"Decompression failed: $status\\n\""
NSQ_SOURCE_LINE 00001591 "        unless $status == LZMA_STREAM_END;"
NSQ_SOURCE_LINE 00001592 ""
NSQ_SOURCE_LINE 00001593 "    print \"Uncompressed size: \", length($uncompressed), \"\\n\";"
NSQ_SOURCE_LINE 00001594 ""
NSQ_SOURCE_LINE 00001595 "=head2 Streaming uncompression with LimitOutput"
NSQ_SOURCE_LINE 00001596 ""
NSQ_SOURCE_LINE 00001597 "    use strict;"
NSQ_SOURCE_LINE 00001598 "    use warnings;"
NSQ_SOURCE_LINE 00001599 ""
NSQ_SOURCE_LINE 00001600 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001601 ""
NSQ_SOURCE_LINE 00001602 "    my ($lz, $status) = Compress::Raw::Lzma::AutoDecoder->new("
NSQ_SOURCE_LINE 00001603 "        LimitOutput => 1,"
NSQ_SOURCE_LINE 00001604 "        ConsumeInput => 1,"
NSQ_SOURCE_LINE 00001605 "        Bufsize => 4096,"
NSQ_SOURCE_LINE 00001606 "    );"
NSQ_SOURCE_LINE 00001607 "    die \"Cannot create decoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001608 ""
NSQ_SOURCE_LINE 00001609 "    # Process compressed data in chunks"
NSQ_SOURCE_LINE 00001610 "    my $compressed = ...;  # your compressed data"
NSQ_SOURCE_LINE 00001611 "    my $uncompressed = '';"
NSQ_SOURCE_LINE 00001612 ""
NSQ_SOURCE_LINE 00001613 "    while (length($compressed) > 0) {"
NSQ_SOURCE_LINE 00001614 "        my $output = '';"
NSQ_SOURCE_LINE 00001615 "        $status = $lz->code($compressed, $output);"
NSQ_SOURCE_LINE 00001616 ""
NSQ_SOURCE_LINE 00001617 "        $uncompressed .= $output;"
NSQ_SOURCE_LINE 00001618 ""
NSQ_SOURCE_LINE 00001619 "        last if $status == LZMA_STREAM_END;"
NSQ_SOURCE_LINE 00001620 "        die \"Decompression error: $status\\n\" unless $status == LZMA_OK;"
NSQ_SOURCE_LINE 00001621 "    }"
NSQ_SOURCE_LINE 00001622 ""
NSQ_SOURCE_LINE 00001623 "    print \"Total uncompressed: \", length($uncompressed), \" bytes\\n\";"
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 "=head2 Uncompressing specific format with AloneDecoder"
NSQ_SOURCE_LINE 00001626 ""
NSQ_SOURCE_LINE 00001627 "    use strict;"
NSQ_SOURCE_LINE 00001628 "    use warnings;"
NSQ_SOURCE_LINE 00001629 ""
NSQ_SOURCE_LINE 00001630 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001631 ""
NSQ_SOURCE_LINE 00001632 "    # For legacy .lzma format (lzma_alone)"
NSQ_SOURCE_LINE 00001633 "    my ($lz, $status) = Compress::Raw::Lzma::AloneDecoder->new("
NSQ_SOURCE_LINE 00001634 "        MemLimit => 128 * 1024 * 1024,  # 128 MB limit"
NSQ_SOURCE_LINE 00001635 "        AppendOutput => 0,"
NSQ_SOURCE_LINE 00001636 "    );"
NSQ_SOURCE_LINE 00001637 "    die \"Cannot create decoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001638 ""
NSQ_SOURCE_LINE 00001639 "    my $compressed = ...;  # .lzma format data"
NSQ_SOURCE_LINE 00001640 "    my $output = '';"
NSQ_SOURCE_LINE 00001641 ""
NSQ_SOURCE_LINE 00001642 "    $status = $lz->code($compressed, $output);"
NSQ_SOURCE_LINE 00001643 "    die \"Decompression failed: $status\\n\""
NSQ_SOURCE_LINE 00001644 "        unless $status == LZMA_STREAM_END;"
NSQ_SOURCE_LINE 00001645 ""
NSQ_SOURCE_LINE 00001646 "=head1 Filters"
NSQ_SOURCE_LINE 00001647 ""
NSQ_SOURCE_LINE 00001648 "A number of the Lzma compression interfaces (namely"
NSQ_SOURCE_LINE 00001649 "C<Compress::Raw::Lzma::StreamEncoder> &"
NSQ_SOURCE_LINE 00001650 "C<Compress::Raw::Lzma::AloneEncoder>) and the raw lzma uncompression interface"
NSQ_SOURCE_LINE 00001651 "make use of filters. These filters are used to change the behaviour of"
NSQ_SOURCE_LINE 00001652 "compression (and raw uncompression)."
NSQ_SOURCE_LINE 00001653 ""
NSQ_SOURCE_LINE 00001654 "All Lzma Filters are sub-classed from the C<Lzma::Filter> base-class."
NSQ_SOURCE_LINE 00001655 ""
NSQ_SOURCE_LINE 00001656 "=head2 Lzma::Filter::Lzma"
NSQ_SOURCE_LINE 00001657 ""
NSQ_SOURCE_LINE 00001658 "The C<Lzma::Filter::Lzma> class is the primary compression filter for LZMA"
NSQ_SOURCE_LINE 00001659 "algorithms. It provides fine-grained control over compression parameters."
NSQ_SOURCE_LINE 00001660 ""
NSQ_SOURCE_LINE 00001661 "There are two subclasses of C<Lzma::Filter::Lzma>, namely"
NSQ_SOURCE_LINE 00001662 "C<Lzma::Filter::Lzma1> and C<Lzma::Filter::Lzma2>."
NSQ_SOURCE_LINE 00001663 ""
NSQ_SOURCE_LINE 00001664 "The former is typically used with C<Compress::Raw::Lzma::AloneEncoder>."
NSQ_SOURCE_LINE 00001665 "The latter with C<Compress::Raw::Lzma::StreamEncoder>."
NSQ_SOURCE_LINE 00001666 ""
NSQ_SOURCE_LINE 00001667 "When using Lzma filters an C<Lzma::Filter::Lzma> I<must> be included and it"
NSQ_SOURCE_LINE 00001668 "I<must> be the last filter in the chain. There can only be one"
NSQ_SOURCE_LINE 00001669 "C<Lzma::Filter::Lzma> filter in any filter chain."
NSQ_SOURCE_LINE 00001670 ""
NSQ_SOURCE_LINE 00001671 "The C<Lzma::Filter::Lzma> construction takes the following options."
NSQ_SOURCE_LINE 00001672 ""
NSQ_SOURCE_LINE 00001673 "=over 5"
NSQ_SOURCE_LINE 00001674 ""
NSQ_SOURCE_LINE 00001675 "=item DictSize => $value"
NSQ_SOURCE_LINE 00001676 ""
NSQ_SOURCE_LINE 00001677 "Dictionary size in bytes. This controls"
NSQ_SOURCE_LINE 00001678 "how many bytes of the recently processed"
NSQ_SOURCE_LINE 00001679 "uncompressed data is kept in memory. The size of the dictionary must be at"
NSQ_SOURCE_LINE 00001680 "least C<LZMA_DICT_SIZE_MIN>."
NSQ_SOURCE_LINE 00001681 ""
NSQ_SOURCE_LINE 00001682 "Defaults to C<LZMA_DICT_SIZE_DEFAULT>."
NSQ_SOURCE_LINE 00001683 ""
NSQ_SOURCE_LINE 00001684 "=item PresetDict => $dict"
NSQ_SOURCE_LINE 00001685 ""
NSQ_SOURCE_LINE 00001686 "Provide an initial dictionary. This value is used to initialize the LZ77 history window."
NSQ_SOURCE_LINE 00001687 ""
NSQ_SOURCE_LINE 00001688 "This feature only works correctly with raw encoding and decoding."
NSQ_SOURCE_LINE 00001689 "You may not be able to decode other formats that have been encoded with a preset dictionary."
NSQ_SOURCE_LINE 00001690 ""
NSQ_SOURCE_LINE 00001691 "C<$dict> should contain typical strings that occur in the files being compressed,"
NSQ_SOURCE_LINE 00001692 "with the most probably strings near the end fo the preset dictionary."
NSQ_SOURCE_LINE 00001693 ""
NSQ_SOURCE_LINE 00001694 "If C<$dict> is larger than C<DictSize>, only the last C<DictSize> bytes are processed."
NSQ_SOURCE_LINE 00001695 ""
NSQ_SOURCE_LINE 00001696 "=item Lc => $value"
NSQ_SOURCE_LINE 00001697 ""
NSQ_SOURCE_LINE 00001698 "Number of literal context bits."
NSQ_SOURCE_LINE 00001699 ""
NSQ_SOURCE_LINE 00001700 "How many of the highest bits of the previous uncompressed"
NSQ_SOURCE_LINE 00001701 "eight-bit byte (also known as `literal') are taken into"
NSQ_SOURCE_LINE 00001702 "account when predicting the bits of the next literal."
NSQ_SOURCE_LINE 00001703 ""
NSQ_SOURCE_LINE 00001704 "C<$value> must be a number between C<LZMA_LCLP_MIN> and"
NSQ_SOURCE_LINE 00001705 "C<LZMA_LCLP_MAX>."
NSQ_SOURCE_LINE 00001706 ""
NSQ_SOURCE_LINE 00001707 "Note the sum of the C<Lc> and C<Lp> options cannot exceed 4."
NSQ_SOURCE_LINE 00001708 ""
NSQ_SOURCE_LINE 00001709 "Defaults to C<LZMA_LC_DEFAULT>."
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 "=item Lp => $value"
NSQ_SOURCE_LINE 00001712 ""
NSQ_SOURCE_LINE 00001713 "Number of literal position bits."
NSQ_SOURCE_LINE 00001714 ""
NSQ_SOURCE_LINE 00001715 "How many of the lowest bits of the current position (number"
NSQ_SOURCE_LINE 00001716 "of bytes from the beginning of the uncompressed data) in the"
NSQ_SOURCE_LINE 00001717 "uncompressed data is taken into account when predicting the"
NSQ_SOURCE_LINE 00001718 "bits of the next literal (a single eight-bit byte)."
NSQ_SOURCE_LINE 00001719 ""
NSQ_SOURCE_LINE 00001720 "Defaults to C<LZMA_LP_DEFAULT>."
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "=item Pb => $value"
NSQ_SOURCE_LINE 00001723 ""
NSQ_SOURCE_LINE 00001724 "Number of position bits"
NSQ_SOURCE_LINE 00001725 ""
NSQ_SOURCE_LINE 00001726 "How many of the lowest bits of the current position in the"
NSQ_SOURCE_LINE 00001727 "uncompressed data is taken into account when estimating"
NSQ_SOURCE_LINE 00001728 "probabilities of matches. A match is a sequence of bytes for"
NSQ_SOURCE_LINE 00001729 "which a matching sequence is found from the dictionary and"
NSQ_SOURCE_LINE 00001730 "thus can be stored as distance-length pair."
NSQ_SOURCE_LINE 00001731 ""
NSQ_SOURCE_LINE 00001732 "C<$value> must be a number between C<LZMA_PB_MIN> and"
NSQ_SOURCE_LINE 00001733 "C<LZMA_PB_MAX>."
NSQ_SOURCE_LINE 00001734 ""
NSQ_SOURCE_LINE 00001735 "Defaults to C<LZMA_PB_DEFAULT>."
NSQ_SOURCE_LINE 00001736 ""
NSQ_SOURCE_LINE 00001737 "=item Mode => $value"
NSQ_SOURCE_LINE 00001738 ""
NSQ_SOURCE_LINE 00001739 "The Compression Mode. Valid values are C<LZMA_MODE_FAST> and"
NSQ_SOURCE_LINE 00001740 "C<LZMA_MODE_NORMAL>."
NSQ_SOURCE_LINE 00001741 ""
NSQ_SOURCE_LINE 00001742 "Defaults to C<LZMA_MODE_NORMAL>."
NSQ_SOURCE_LINE 00001743 ""
NSQ_SOURCE_LINE 00001744 "=item Nice => $value"
NSQ_SOURCE_LINE 00001745 ""
NSQ_SOURCE_LINE 00001746 "Nice length of a match"
NSQ_SOURCE_LINE 00001747 ""
NSQ_SOURCE_LINE 00001748 "Defaults to 64."
NSQ_SOURCE_LINE 00001749 ""
NSQ_SOURCE_LINE 00001750 "=item Mf => $value"
NSQ_SOURCE_LINE 00001751 ""
NSQ_SOURCE_LINE 00001752 "Defines which Match Finder to use. Valid values are C<LZMA_MF_HC3>"
NSQ_SOURCE_LINE 00001753 "C<LZMA_MF_HC4>, C<LZMA_MF_BT2> C<LZMA_MF_BT3> and C<LZMA_MF_BT4>."
NSQ_SOURCE_LINE 00001754 ""
NSQ_SOURCE_LINE 00001755 "Defaults to C<LZMA_MF_BT4>."
NSQ_SOURCE_LINE 00001756 ""
NSQ_SOURCE_LINE 00001757 "=item Depth => $value"
NSQ_SOURCE_LINE 00001758 ""
NSQ_SOURCE_LINE 00001759 "Maximum search depth in the match finder."
NSQ_SOURCE_LINE 00001760 ""
NSQ_SOURCE_LINE 00001761 "Defaults to 0."
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 "=back"
NSQ_SOURCE_LINE 00001764 ""
NSQ_SOURCE_LINE 00001765 "=head2 Lzma::Filter::BCJ"
NSQ_SOURCE_LINE 00001766 ""
NSQ_SOURCE_LINE 00001767 "The sub-classes of C<Lzma::Filter::BCJ> are the"
NSQ_SOURCE_LINE 00001768 "Branch/Call/Jump conversion filters. These filters are used to rewrite"
NSQ_SOURCE_LINE 00001769 "executable binary code for a number of processor architectures."
NSQ_SOURCE_LINE 00001770 "None of these classes take any options."
NSQ_SOURCE_LINE 00001771 ""
NSQ_SOURCE_LINE 00001772 "=over 5"
NSQ_SOURCE_LINE 00001773 ""
NSQ_SOURCE_LINE 00001774 "=item Lzma::Filter::X86"
NSQ_SOURCE_LINE 00001775 ""
NSQ_SOURCE_LINE 00001776 "Filter for x86 binaries."
NSQ_SOURCE_LINE 00001777 ""
NSQ_SOURCE_LINE 00001778 "=item Lzma::Filter::PowerPC"
NSQ_SOURCE_LINE 00001779 ""
NSQ_SOURCE_LINE 00001780 "Filter for Big endian PowerPC binaries."
NSQ_SOURCE_LINE 00001781 ""
NSQ_SOURCE_LINE 00001782 "=item Lzma::Filter::IA64"
NSQ_SOURCE_LINE 00001783 ""
NSQ_SOURCE_LINE 00001784 "Filter for IA64 (Itanium) binaries."
NSQ_SOURCE_LINE 00001785 ""
NSQ_SOURCE_LINE 00001786 "=item Lzma::Filter::ARM"
NSQ_SOURCE_LINE 00001787 ""
NSQ_SOURCE_LINE 00001788 "Filter for ARM binaries."
NSQ_SOURCE_LINE 00001789 ""
NSQ_SOURCE_LINE 00001790 "=item Lzma::Filter::ARMThumb"
NSQ_SOURCE_LINE 00001791 ""
NSQ_SOURCE_LINE 00001792 "Filter for ARMThumb binaries."
NSQ_SOURCE_LINE 00001793 ""
NSQ_SOURCE_LINE 00001794 "=item Lzma::Filter::Sparc"
NSQ_SOURCE_LINE 00001795 ""
NSQ_SOURCE_LINE 00001796 "Filter for Sparc binaries."
NSQ_SOURCE_LINE 00001797 ""
NSQ_SOURCE_LINE 00001798 "=back"
NSQ_SOURCE_LINE 00001799 ""
NSQ_SOURCE_LINE 00001800 "=head2 Lzma::Filter::Delta"
NSQ_SOURCE_LINE 00001801 ""
NSQ_SOURCE_LINE 00001802 "Usage is"
NSQ_SOURCE_LINE 00001803 ""
NSQ_SOURCE_LINE 00001804 "    Lzma::Filter::Delta [OPTS]"
NSQ_SOURCE_LINE 00001805 ""
NSQ_SOURCE_LINE 00001806 "=over 5"
NSQ_SOURCE_LINE 00001807 ""
NSQ_SOURCE_LINE 00001808 "=item Type => $type"
NSQ_SOURCE_LINE 00001809 ""
NSQ_SOURCE_LINE 00001810 "Defines the type of Delta calculation. The only available type (and"
NSQ_SOURCE_LINE 00001811 "therefore the default) is"
NSQ_SOURCE_LINE 00001812 "C<LZMA_DELTA_TYPE_BYTE>,"
NSQ_SOURCE_LINE 00001813 ""
NSQ_SOURCE_LINE 00001814 "=item Distance => $value"
NSQ_SOURCE_LINE 00001815 ""
NSQ_SOURCE_LINE 00001816 "Defines the Delta Distance. C<$value> must be a number between"
NSQ_SOURCE_LINE 00001817 "C<LZMA_DELTA_DIST_MIN> and C<LZMA_DELTA_DIST_MAX>."
NSQ_SOURCE_LINE 00001818 ""
NSQ_SOURCE_LINE 00001819 "Default is C<LZMA_DELTA_DIST_MIN>."
NSQ_SOURCE_LINE 00001820 ""
NSQ_SOURCE_LINE 00001821 "=back"
NSQ_SOURCE_LINE 00001822 ""
NSQ_SOURCE_LINE 00001823 "=head1 Filter examples"
NSQ_SOURCE_LINE 00001824 ""
NSQ_SOURCE_LINE 00001825 "=head2 Using LZMA2 filter with custom dictionary size"
NSQ_SOURCE_LINE 00001826 ""
NSQ_SOURCE_LINE 00001827 "    use strict;"
NSQ_SOURCE_LINE 00001828 "    use warnings;"
NSQ_SOURCE_LINE 00001829 ""
NSQ_SOURCE_LINE 00001830 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001831 ""
NSQ_SOURCE_LINE 00001832 "    # Create LZMA2 filter with large dictionary for better compression"
NSQ_SOURCE_LINE 00001833 "    my $filter = Lzma::Filter::Lzma2("
NSQ_SOURCE_LINE 00001834 "        DictSize => 16 * 1024 * 1024,  # 16 MB dictionary"
NSQ_SOURCE_LINE 00001835 "        Lc => 3,"
NSQ_SOURCE_LINE 00001836 "        Lp => 0,"
NSQ_SOURCE_LINE 00001837 "        Pb => 2,"
NSQ_SOURCE_LINE 00001838 "    );"
NSQ_SOURCE_LINE 00001839 ""
NSQ_SOURCE_LINE 00001840 "    my ($lz, $status) = Compress::Raw::Lzma::StreamEncoder->new("
NSQ_SOURCE_LINE 00001841 "        Filter => $filter,"
NSQ_SOURCE_LINE 00001842 "        Check => LZMA_CHECK_CRC64,"
NSQ_SOURCE_LINE 00001843 "    );"
NSQ_SOURCE_LINE 00001844 "    die \"Cannot create encoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001845 ""
NSQ_SOURCE_LINE 00001846 "    my $input = \"Data to compress...\";"
NSQ_SOURCE_LINE 00001847 "    my $output = '';"
NSQ_SOURCE_LINE 00001848 ""
NSQ_SOURCE_LINE 00001849 "    $lz->code($input, $output);"
NSQ_SOURCE_LINE 00001850 "    $lz->flush($output);"
NSQ_SOURCE_LINE 00001851 ""
NSQ_SOURCE_LINE 00001852 "=head2 Using LZMA1 filter for legacy .lzma format"
NSQ_SOURCE_LINE 00001853 ""
NSQ_SOURCE_LINE 00001854 "    use strict;"
NSQ_SOURCE_LINE 00001855 "    use warnings;"
NSQ_SOURCE_LINE 00001856 ""
NSQ_SOURCE_LINE 00001857 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001858 ""
NSQ_SOURCE_LINE 00001859 "    # LZMA1 is used for the legacy .lzma format"
NSQ_SOURCE_LINE 00001860 "    my $filter = Lzma::Filter::Lzma1("
NSQ_SOURCE_LINE 00001861 "        DictSize => 8 * 1024 * 1024,"
NSQ_SOURCE_LINE 00001862 "        Mode => LZMA_MODE_NORMAL,"
NSQ_SOURCE_LINE 00001863 "        Mf => LZMA_MF_BT4,"
NSQ_SOURCE_LINE 00001864 "        Nice => 273,"
NSQ_SOURCE_LINE 00001865 "    );"
NSQ_SOURCE_LINE 00001866 ""
NSQ_SOURCE_LINE 00001867 "    my ($lz, $status) = Compress::Raw::Lzma::AloneEncoder->new("
NSQ_SOURCE_LINE 00001868 "        Filter => $filter,"
NSQ_SOURCE_LINE 00001869 "    );"
NSQ_SOURCE_LINE 00001870 "    die \"Cannot create encoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001871 ""
NSQ_SOURCE_LINE 00001872 "=head2 Using preset-based LZMA2 filter"
NSQ_SOURCE_LINE 00001873 ""
NSQ_SOURCE_LINE 00001874 "    use strict;"
NSQ_SOURCE_LINE 00001875 "    use warnings;"
NSQ_SOURCE_LINE 00001876 ""
NSQ_SOURCE_LINE 00001877 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001878 ""
NSQ_SOURCE_LINE 00001879 "    # Use preset instead of manually configuring parameters"
NSQ_SOURCE_LINE 00001880 "    # Preset 9 = maximum compression"
NSQ_SOURCE_LINE 00001881 "    my $filter = Lzma::Filter::Lzma2::Preset(9 | LZMA_PRESET_EXTREME);"
NSQ_SOURCE_LINE 00001882 ""
NSQ_SOURCE_LINE 00001883 "    my ($lz, $status) = Compress::Raw::Lzma::StreamEncoder->new("
NSQ_SOURCE_LINE 00001884 "        Filter => $filter,"
NSQ_SOURCE_LINE 00001885 "    );"
NSQ_SOURCE_LINE 00001886 "    die \"Cannot create encoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001887 ""
NSQ_SOURCE_LINE 00001888 "=head2 Combining Delta filter with LZMA2"
NSQ_SOURCE_LINE 00001889 ""
NSQ_SOURCE_LINE 00001890 "    use strict;"
NSQ_SOURCE_LINE 00001891 "    use warnings;"
NSQ_SOURCE_LINE 00001892 ""
NSQ_SOURCE_LINE 00001893 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001894 ""
NSQ_SOURCE_LINE 00001895 "    # Delta filter is useful for data with small changes between bytes"
NSQ_SOURCE_LINE 00001896 "    # (e.g., uncompressed images, audio samples)"
NSQ_SOURCE_LINE 00001897 "    my @filters = ("
NSQ_SOURCE_LINE 00001898 "        Lzma::Filter::Delta("
NSQ_SOURCE_LINE 00001899 "            Type => LZMA_DELTA_TYPE_BYTE,"
NSQ_SOURCE_LINE 00001900 "            Distance => 1,"
NSQ_SOURCE_LINE 00001901 "        ),"
NSQ_SOURCE_LINE 00001902 "        Lzma::Filter::Lzma2("
NSQ_SOURCE_LINE 00001903 "            DictSize => 8 * 1024 * 1024,"
NSQ_SOURCE_LINE 00001904 "        ),"
NSQ_SOURCE_LINE 00001905 "    );"
NSQ_SOURCE_LINE 00001906 ""
NSQ_SOURCE_LINE 00001907 "    my ($lz, $status) = Compress::Raw::Lzma::StreamEncoder->new("
NSQ_SOURCE_LINE 00001908 "        Filter => \\@filters,"
NSQ_SOURCE_LINE 00001909 "        Check => LZMA_CHECK_CRC32,"
NSQ_SOURCE_LINE 00001910 "    );"
NSQ_SOURCE_LINE 00001911 "    die \"Cannot create encoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001912 ""
NSQ_SOURCE_LINE 00001913 "    # Compress image or audio data"
NSQ_SOURCE_LINE 00001914 "    my $raw_data = ...;"
NSQ_SOURCE_LINE 00001915 "    my $compressed = '';"
NSQ_SOURCE_LINE 00001916 ""
NSQ_SOURCE_LINE 00001917 "    $lz->code($raw_data, $compressed);"
NSQ_SOURCE_LINE 00001918 "    $lz->flush($compressed);"
NSQ_SOURCE_LINE 00001919 ""
NSQ_SOURCE_LINE 00001920 "=head2 Using BCJ filter for x86 executable compression"
NSQ_SOURCE_LINE 00001921 ""
NSQ_SOURCE_LINE 00001922 "    use strict;"
NSQ_SOURCE_LINE 00001923 "    use warnings;"
NSQ_SOURCE_LINE 00001924 ""
NSQ_SOURCE_LINE 00001925 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001926 ""
NSQ_SOURCE_LINE 00001927 "    # BCJ (Branch/Call/Jump) filter optimizes compression of x86 binaries"
NSQ_SOURCE_LINE 00001928 "    my @filters = ("
NSQ_SOURCE_LINE 00001929 "        Lzma::Filter::X86(Offset => 0),"
NSQ_SOURCE_LINE 00001930 "        Lzma::Filter::Lzma2(),"
NSQ_SOURCE_LINE 00001931 "    );"
NSQ_SOURCE_LINE 00001932 ""
NSQ_SOURCE_LINE 00001933 "    my ($lz, $status) = Compress::Raw::Lzma::StreamEncoder->new("
NSQ_SOURCE_LINE 00001934 "        Filter => \\@filters,"
NSQ_SOURCE_LINE 00001935 "        Check => LZMA_CHECK_SHA256,"
NSQ_SOURCE_LINE 00001936 "    );"
NSQ_SOURCE_LINE 00001937 "    die \"Cannot create encoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001938 ""
NSQ_SOURCE_LINE 00001939 "    # Read and compress x86 binary"
NSQ_SOURCE_LINE 00001940 "    open my $fh, '<', 'program.exe' or die $!;"
NSQ_SOURCE_LINE 00001941 "    binmode $fh;"
NSQ_SOURCE_LINE 00001942 "    my $binary = do { local $/; <$fh> };"
NSQ_SOURCE_LINE 00001943 "    close $fh;"
NSQ_SOURCE_LINE 00001944 ""
NSQ_SOURCE_LINE 00001945 "    my $compressed = '';"
NSQ_SOURCE_LINE 00001946 "    $lz->code($binary, $compressed);"
NSQ_SOURCE_LINE 00001947 "    $lz->flush($compressed);"
NSQ_SOURCE_LINE 00001948 ""
NSQ_SOURCE_LINE 00001949 "    print \"Original: \", length($binary), \" bytes\\n\";"
NSQ_SOURCE_LINE 00001950 "    print \"Compressed: \", length($compressed), \" bytes\\n\";"
NSQ_SOURCE_LINE 00001951 ""
NSQ_SOURCE_LINE 00001952 "=head2 Using ARM filter for ARM binaries"
NSQ_SOURCE_LINE 00001953 ""
NSQ_SOURCE_LINE 00001954 "    use strict;"
NSQ_SOURCE_LINE 00001955 "    use warnings;"
NSQ_SOURCE_LINE 00001956 ""
NSQ_SOURCE_LINE 00001957 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001958 ""
NSQ_SOURCE_LINE 00001959 "    # For ARM executables"
NSQ_SOURCE_LINE 00001960 "    my @filters = ("
NSQ_SOURCE_LINE 00001961 "        Lzma::Filter::ARM(),"
NSQ_SOURCE_LINE 00001962 "        Lzma::Filter::Lzma2("
NSQ_SOURCE_LINE 00001963 "            DictSize => 4 * 1024 * 1024,"
NSQ_SOURCE_LINE 00001964 "        ),"
NSQ_SOURCE_LINE 00001965 "    );"
NSQ_SOURCE_LINE 00001966 ""
NSQ_SOURCE_LINE 00001967 "    my ($lz, $status) = Compress::Raw::Lzma::StreamEncoder->new("
NSQ_SOURCE_LINE 00001968 "        Filter => \\@filters,"
NSQ_SOURCE_LINE 00001969 "    );"
NSQ_SOURCE_LINE 00001970 "    die \"Cannot create encoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001971 ""
NSQ_SOURCE_LINE 00001972 "=head2 Maximum compression with multiple filters"
NSQ_SOURCE_LINE 00001973 ""
NSQ_SOURCE_LINE 00001974 "    use strict;"
NSQ_SOURCE_LINE 00001975 "    use warnings;"
NSQ_SOURCE_LINE 00001976 ""
NSQ_SOURCE_LINE 00001977 "    use Compress::Raw::Lzma;"
NSQ_SOURCE_LINE 00001978 ""
NSQ_SOURCE_LINE 00001979 "    # Combine filters for maximum compression"
NSQ_SOURCE_LINE 00001980 "    my @filters = ("
NSQ_SOURCE_LINE 00001981 "        Lzma::Filter::Delta(Distance => 1),"
NSQ_SOURCE_LINE 00001982 "        Lzma::Filter::Lzma2("
NSQ_SOURCE_LINE 00001983 "            DictSize => 64 * 1024 * 1024,  # 64 MB"
NSQ_SOURCE_LINE 00001984 "            Lc => 4,"
NSQ_SOURCE_LINE 00001985 "            Lp => 0,"
NSQ_SOURCE_LINE 00001986 "            Pb => 2,"
NSQ_SOURCE_LINE 00001987 "            Mode => LZMA_MODE_NORMAL,"
NSQ_SOURCE_LINE 00001988 "            Nice => 273,"
NSQ_SOURCE_LINE 00001989 "            Mf => LZMA_MF_BT4,"
NSQ_SOURCE_LINE 00001990 "            Depth => 1024,"
NSQ_SOURCE_LINE 00001991 "        ),"
NSQ_SOURCE_LINE 00001992 "    );"
NSQ_SOURCE_LINE 00001993 ""
NSQ_SOURCE_LINE 00001994 "    my ($lz, $status) = Compress::Raw::Lzma::StreamEncoder->new("
NSQ_SOURCE_LINE 00001995 "        Filter => \\@filters,"
NSQ_SOURCE_LINE 00001996 "        Check => LZMA_CHECK_SHA256,"
NSQ_SOURCE_LINE 00001997 "    );"
NSQ_SOURCE_LINE 00001998 "    die \"Cannot create encoder: $status\\n\" unless $lz;"
NSQ_SOURCE_LINE 00001999 ""
