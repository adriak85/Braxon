NSQ_SOURCE_LINE 00000701 "sub Lzma::Filters::validateFilters"
NSQ_SOURCE_LINE 00000702 "{"
NSQ_SOURCE_LINE 00000703 "    use UNIVERSAL ;"
NSQ_SOURCE_LINE 00000704 "    use Scalar::Util qw(blessed );"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "    my $encoding = shift; # not decoding"
NSQ_SOURCE_LINE 00000707 "    my $lzma2 = shift;"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "    # my $objType = $lzma2 ? \"Lzma::Filter::Lzma2\""
NSQ_SOURCE_LINE 00000710 "    #                      : \"Lzma::Filter::Lzma\" ;"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "    my $objType =  \"Lzma::Filter::Lzma\" ;"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "    # if only one, convert into an array reference"
NSQ_SOURCE_LINE 00000715 "    if (blessed $_[0] )  {"
NSQ_SOURCE_LINE 00000716 "        die \"filter object $_[0] is not an $objType object\""
NSQ_SOURCE_LINE 00000717 "            unless UNIVERSAL::isa($_[0], $objType);"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "            #$_[0] = [ $_[0] ] ;"
NSQ_SOURCE_LINE 00000720 "        return [ $_[0] ] ;"
NSQ_SOURCE_LINE 00000721 "    }"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "    if (ref $_[0] ne 'ARRAY')"
NSQ_SOURCE_LINE 00000724 "      { die \"$_[0] not Lzma::Filter object or ARRAY ref\" }"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "    my $filters = $_[0] ;"
NSQ_SOURCE_LINE 00000727 "    my $count = @$filters;"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "    # check number of filters"
NSQ_SOURCE_LINE 00000730 "    die sprintf \"Too many filters ($count), max is %d\", LZMA_FILTERS_MAX()"
NSQ_SOURCE_LINE 00000731 "        if $count > LZMA_FILTERS_MAX();"
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "    # TODO - add more tests here"
NSQ_SOURCE_LINE 00000734 "    # Check that all filters inherit from Lzma::Filter"
NSQ_SOURCE_LINE 00000735 "    # check that filters are supported"
NSQ_SOURCE_LINE 00000736 "    # check memory requirements"
NSQ_SOURCE_LINE 00000737 "    # need exactly one lzma1/2 filter"
NSQ_SOURCE_LINE 00000738 "    # lzma1/2 is the last thing in the list"
NSQ_SOURCE_LINE 00000739 "    for (my $i = 0; $i <  @$filters ; ++$i)"
NSQ_SOURCE_LINE 00000740 "    {"
NSQ_SOURCE_LINE 00000741 "        my $filt = $filters->[$i];"
NSQ_SOURCE_LINE 00000742 "        die \"filter is not an Lzma::Filter object\""
NSQ_SOURCE_LINE 00000743 "            unless UNIVERSAL::isa($filt, 'Lzma::Filter');"
NSQ_SOURCE_LINE 00000744 "        die \"Lzma filter must be last\""
NSQ_SOURCE_LINE 00000745 "            if UNIVERSAL::isa($filt, 'Lzma::Filter::Lzma') && $i < $count -1 ;"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "        #die \"xxx\" unless lzma_filter_encoder_is_supported($filt->id());"
NSQ_SOURCE_LINE 00000748 "    }"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "    if (@$filters == 0)"
NSQ_SOURCE_LINE 00000751 "    {"
NSQ_SOURCE_LINE 00000752 "        push @$filters, $lzma2 ? Lzma::Filter::Lzma2()"
NSQ_SOURCE_LINE 00000753 "                               : Lzma::Filter::Lzma1();"
NSQ_SOURCE_LINE 00000754 "    }"
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "    return $filters;"
NSQ_SOURCE_LINE 00000757 "}"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "#package Lzma::Filter;"
NSQ_SOURCE_LINE 00000760 "#package Lzma::Filter::Lzma;"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "#our ($VERSION, @ISA, @EXPORT, $AUTOLOAD);"
NSQ_SOURCE_LINE 00000763 "@Lzma::Filter::Lzma::ISA = qw(Lzma::Filter);"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "sub Lzma::Filter::Lzma::mk"
NSQ_SOURCE_LINE 00000766 "{"
NSQ_SOURCE_LINE 00000767 "    my $type = shift;"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "    my $got = Compress::Raw::Lzma::ParseParameters(0,"
NSQ_SOURCE_LINE 00000770 "        {"
NSQ_SOURCE_LINE 00000771 "            'DictSize' => [1, 1, Parse_unsigned(), LZMA_DICT_SIZE_DEFAULT()],"
NSQ_SOURCE_LINE 00000772 "            'PresetDict' => [1, 1, Parse_string(), undef],"
NSQ_SOURCE_LINE 00000773 "            'Lc'    => [1, 1, Parse_unsigned(), LZMA_LC_DEFAULT()],"
NSQ_SOURCE_LINE 00000774 "            'Lp'    => [1, 1, Parse_unsigned(), LZMA_LP_DEFAULT()],"
NSQ_SOURCE_LINE 00000775 "            'Pb'    => [1, 1, Parse_unsigned(), LZMA_PB_DEFAULT()],"
NSQ_SOURCE_LINE 00000776 "            'Mode'  => [1, 1, Parse_unsigned(), LZMA_MODE_NORMAL()],"
NSQ_SOURCE_LINE 00000777 "            'Nice'  => [1, 1, Parse_unsigned(), 64],"
NSQ_SOURCE_LINE 00000778 "            'Mf'    => [1, 1, Parse_unsigned(), LZMA_MF_BT4()],"
NSQ_SOURCE_LINE 00000779 "            'Depth' => [1, 1, Parse_unsigned(), 0],"
NSQ_SOURCE_LINE 00000780 "        }, @_) ;"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "    my $pkg = (caller(1))[3] ;"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "    my $DictSize = $got->value('DictSize');"
NSQ_SOURCE_LINE 00000785 "    die \"Dictsize $DictSize not in range 4KiB - 1536Mib\""
NSQ_SOURCE_LINE 00000786 "        if $DictSize < 1024 * 4 ||"
NSQ_SOURCE_LINE 00000787 "           $DictSize > 1024 * 1024 * 1536 ;"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "    my $Lc = $got->value('Lc');"
NSQ_SOURCE_LINE 00000790 "    die \"Lc $Lc not in range 0-4\""
NSQ_SOURCE_LINE 00000791 "        if $Lc < 0 || $Lc > 4;"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "    my $Lp = $got->value('Lp');"
NSQ_SOURCE_LINE 00000794 "    die \"Lp $Lp not in range 0-4\""
NSQ_SOURCE_LINE 00000795 "        if $Lp < 0 || $Lp > 4;"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "    die \"Lc + Lp must be <= 4\""
NSQ_SOURCE_LINE 00000798 "        if $Lc + $Lp > 4;"
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "    my $Pb = $got->value('Pb');"
NSQ_SOURCE_LINE 00000801 "    die \"Pb $Pb not in range 0-4\""
NSQ_SOURCE_LINE 00000802 "        if $Pb < 0 || $Pb > 4;"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "    my $Mode = $got->value('Mode');"
NSQ_SOURCE_LINE 00000805 "    die \"Mode $Mode not LZMA_MODE_FAST or LZMA_MODE_NORMAL\""
NSQ_SOURCE_LINE 00000806 "        if $Mode != LZMA_MODE_FAST() && $Mode != LZMA_MODE_NORMAL();"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "    my $Mf = $got->value('Mf');"
NSQ_SOURCE_LINE 00000809 "    die \"Mf $Mf not valid\""
NSQ_SOURCE_LINE 00000810 "        if ! grep { $Mf == $_ }"
NSQ_SOURCE_LINE 00000811 "             ( LZMA_MF_HC3(),"
NSQ_SOURCE_LINE 00000812 "               LZMA_MF_HC4(),"
NSQ_SOURCE_LINE 00000813 "               LZMA_MF_BT2(),"
NSQ_SOURCE_LINE 00000814 "               LZMA_MF_BT3(),"
NSQ_SOURCE_LINE 00000815 "               LZMA_MF_BT4());"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "    my $Nice = $got->value('Nice');"
NSQ_SOURCE_LINE 00000818 "    die \"Nice $Nice not in range 2-273\""
NSQ_SOURCE_LINE 00000819 "        if $Nice < 2 || $Nice > 273;"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "    my $obj = Lzma::Filter::Lzma::_mk($type,"
NSQ_SOURCE_LINE 00000822 "                            $DictSize,"
NSQ_SOURCE_LINE 00000823 "                            $Lc,"
NSQ_SOURCE_LINE 00000824 "                            $Lp,"
NSQ_SOURCE_LINE 00000825 "                            $Pb,"
NSQ_SOURCE_LINE 00000826 "                            $Mode,"
NSQ_SOURCE_LINE 00000827 "                            $Nice,"
NSQ_SOURCE_LINE 00000828 "                            $Mf,"
NSQ_SOURCE_LINE 00000829 "                            $got->value('Depth'),"
NSQ_SOURCE_LINE 00000830 "                            $got->value('PresetDict'),"
NSQ_SOURCE_LINE 00000831 "                        );"
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "    bless $obj, $pkg"
NSQ_SOURCE_LINE 00000834 "        if defined $obj;"
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "    $obj;"
NSQ_SOURCE_LINE 00000837 "}"
NSQ_SOURCE_LINE 00000838 ""
