NSQ_SOURCE_LINE 00000188 "    #return bless $obj, ref($class) || $class || __PACKAGE__ ;"
NSQ_SOURCE_LINE 00000189 "    return bless $obj, 'Compress::Raw::Lzma::Parameters' ;"
NSQ_SOURCE_LINE 00000190 "}"
