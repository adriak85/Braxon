NSQ_SOURCE_LINE 00000379 "        $self->{Got}{lc $name}[OFF_FIXED]   = $_[0] ;"
NSQ_SOURCE_LINE 00000380 "    }"
NSQ_SOURCE_LINE 00000381 ""
