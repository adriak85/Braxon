NSQ_SOURCE_LINE 00000162 "sub ParseParameters"
NSQ_SOURCE_LINE 00000163 "{"
NSQ_SOURCE_LINE 00000164 "    my $level = shift || 0 ;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "    my $sub = (caller($level + 1))[3] ;"
NSQ_SOURCE_LINE 00000167 "    #local $Carp::CarpLevel = 1 ;"
NSQ_SOURCE_LINE 00000168 "    my $p = new Compress::Raw::Zlib::Parameters() ;"
NSQ_SOURCE_LINE 00000169 "    $p->parse(@_)"
NSQ_SOURCE_LINE 00000170 "        or croak \"$sub: $p->{Error}\" ;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    return $p;"
NSQ_SOURCE_LINE 00000173 "}"
