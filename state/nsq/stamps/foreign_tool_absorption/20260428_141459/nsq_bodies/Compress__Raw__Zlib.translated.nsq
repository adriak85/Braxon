NSQ_SOURCE_LINE 00000184 "    #return bless $obj, ref($class) || $class || __PACKAGE__ ;"
NSQ_SOURCE_LINE 00000185 "    return bless $obj, 'Compress::Raw::Zlib::Parameters' ;"
NSQ_SOURCE_LINE 00000186 "}"
