NSQ_SOURCE_LINE 00000116 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000117 "    my($constname);"
NSQ_SOURCE_LINE 00000118 "    ($constname = $AUTOLOAD) =~ s/.*:://;"
NSQ_SOURCE_LINE 00000119 "    my ($error, $val) = constant($constname);"
NSQ_SOURCE_LINE 00000120 "    Carp::croak $error if $error;"
NSQ_SOURCE_LINE 00000121 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000122 "    *{$AUTOLOAD} = sub { $val };"
NSQ_SOURCE_LINE 00000123 "    goto &{$AUTOLOAD};"
NSQ_SOURCE_LINE 00000124 "}"
