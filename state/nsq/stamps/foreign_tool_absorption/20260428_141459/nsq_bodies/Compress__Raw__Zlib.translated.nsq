NSQ_SOURCE_LINE 00000371 "{"
NSQ_SOURCE_LINE 00000372 "    my $self = shift ;"
NSQ_SOURCE_LINE 00000373 "    my $name = shift ;"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "    if (@_)"
NSQ_SOURCE_LINE 00000376 "    {"
NSQ_SOURCE_LINE 00000377 "        $self->{Got}{lc $name}[OFF_PARSED]  = 1;"
