NSQ_SOURCE_LINE 00000204 "sub Compress::Raw::Zlib::Parameters::parse"
NSQ_SOURCE_LINE 00000205 "{"
NSQ_SOURCE_LINE 00000206 "    my $self = shift ;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    my $default = shift ;"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    my $got = $self->{Got} ;"
NSQ_SOURCE_LINE 00000211 "    my $firstTime = keys %{ $got } == 0 ;"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "    my (@Bad) ;"
NSQ_SOURCE_LINE 00000214 "    my @entered = () ;"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    # Allow the options to be passed as a hash reference or"
NSQ_SOURCE_LINE 00000217 "    # as the complete hash."
NSQ_SOURCE_LINE 00000218 "    if (@_ == 0) {"
NSQ_SOURCE_LINE 00000219 "        @entered = () ;"
NSQ_SOURCE_LINE 00000220 "    }"
NSQ_SOURCE_LINE 00000221 "    elsif (@_ == 1) {"
NSQ_SOURCE_LINE 00000222 "        my $href = $_[0] ;"
NSQ_SOURCE_LINE 00000223 "        return $self->setError(\"Expected even number of parameters, got 1\")"
NSQ_SOURCE_LINE 00000224 "            if ! defined $href or ! ref $href or ref $href ne \"HASH\" ;"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "        foreach my $key (keys %$href) {"
NSQ_SOURCE_LINE 00000227 "            push @entered, $key ;"
NSQ_SOURCE_LINE 00000228 "            push @entered, \\$href->{$key} ;"
NSQ_SOURCE_LINE 00000229 "        }"
NSQ_SOURCE_LINE 00000230 "    }"
NSQ_SOURCE_LINE 00000231 "    else {"
NSQ_SOURCE_LINE 00000232 "        my $count = @_;"
NSQ_SOURCE_LINE 00000233 "        return $self->setError(\"Expected even number of parameters, got $count\")"
NSQ_SOURCE_LINE 00000234 "            if $count % 2 != 0 ;"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "        for my $i (0.. $count / 2 - 1) {"
NSQ_SOURCE_LINE 00000237 "            push @entered, $_[2* $i] ;"
NSQ_SOURCE_LINE 00000238 "            push @entered, \\$_[2* $i+1] ;"
NSQ_SOURCE_LINE 00000239 "        }"
NSQ_SOURCE_LINE 00000240 "    }"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "    while (my ($key, $v) = each %$default)"
NSQ_SOURCE_LINE 00000244 "    {"
NSQ_SOURCE_LINE 00000245 "        croak \"need 4 params [@$v]\""
NSQ_SOURCE_LINE 00000246 "            if @$v != 4 ;"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "        my ($first_only, $sticky, $type, $value) = @$v ;"
NSQ_SOURCE_LINE 00000249 "        my $x ;"
NSQ_SOURCE_LINE 00000250 "        $self->_checkType($key, \\$value, $type, 0, \\$x)"
NSQ_SOURCE_LINE 00000251 "            or return undef ;"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "        $key = lc $key;"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "        if ($firstTime || ! $sticky) {"
NSQ_SOURCE_LINE 00000256 "            $got->{$key} = [0, $type, $value, $x, $first_only, $sticky] ;"
NSQ_SOURCE_LINE 00000257 "        }"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "        $got->{$key}[OFF_PARSED] = 0 ;"
NSQ_SOURCE_LINE 00000260 "    }"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "    for my $i (0.. @entered / 2 - 1) {"
NSQ_SOURCE_LINE 00000263 "        my $key = $entered[2* $i] ;"
NSQ_SOURCE_LINE 00000264 "        my $value = $entered[2* $i+1] ;"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "        #print \"Key [$key] Value [$value]\" ;"
NSQ_SOURCE_LINE 00000267 "        #print defined $$value ? \"[$$value]\\n\" : \"[undef]\\n\";"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "        $key =~ s/^-// ;"
NSQ_SOURCE_LINE 00000270 "        my $canonkey = lc $key;"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "        if ($got->{$canonkey} && ($firstTime ||"
NSQ_SOURCE_LINE 00000273 "                                  ! $got->{$canonkey}[OFF_FIRST_ONLY]  ))"
NSQ_SOURCE_LINE 00000274 "        {"
NSQ_SOURCE_LINE 00000275 "            my $type = $got->{$canonkey}[OFF_TYPE] ;"
NSQ_SOURCE_LINE 00000276 "            my $s ;"
NSQ_SOURCE_LINE 00000277 "            $self->_checkType($key, $value, $type, 1, \\$s)"
NSQ_SOURCE_LINE 00000278 "                or return undef ;"
NSQ_SOURCE_LINE 00000279 "            #$value = $$value unless $type & Parse_store_ref ;"
NSQ_SOURCE_LINE 00000280 "            $value = $$value ;"
NSQ_SOURCE_LINE 00000281 "            $got->{$canonkey} = [1, $type, $value, $s] ;"
NSQ_SOURCE_LINE 00000282 "        }"
NSQ_SOURCE_LINE 00000283 "        else"
NSQ_SOURCE_LINE 00000284 "          { push (@Bad, $key) }"
NSQ_SOURCE_LINE 00000285 "    }"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    if (@Bad) {"
NSQ_SOURCE_LINE 00000288 "        my ($bad) = join(\", \", @Bad) ;"
NSQ_SOURCE_LINE 00000289 "        return $self->setError(\"unknown key value(s) @Bad\") ;"
NSQ_SOURCE_LINE 00000290 "    }"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "    return 1;"
NSQ_SOURCE_LINE 00000293 "}"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "sub Compress::Raw::Zlib::Parameters::_checkType"
NSQ_SOURCE_LINE 00000296 "{"
NSQ_SOURCE_LINE 00000297 "    my $self = shift ;"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "    my $key   = shift ;"
NSQ_SOURCE_LINE 00000300 "    my $value = shift ;"
NSQ_SOURCE_LINE 00000301 "    my $type  = shift ;"
NSQ_SOURCE_LINE 00000302 "    my $validate  = shift ;"
NSQ_SOURCE_LINE 00000303 "    my $output  = shift;"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "    #local $Carp::CarpLevel = $level ;"
NSQ_SOURCE_LINE 00000306 "    #print \"PARSE $type $key $value $validate $sub\\n\" ;"
NSQ_SOURCE_LINE 00000307 "#    if ( $type & Parse_store_ref)"
NSQ_SOURCE_LINE 00000308 "#    {"
NSQ_SOURCE_LINE 00000309 "#        #$value = $$value"
NSQ_SOURCE_LINE 00000310 "#        #    if ref ${ $value } ;"
NSQ_SOURCE_LINE 00000311 "#"
NSQ_SOURCE_LINE 00000312 "#        $$output = $value ;"
NSQ_SOURCE_LINE 00000313 "#        return 1;"
NSQ_SOURCE_LINE 00000314 "#    }"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "    $value = $$value ;"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "    if ($type & Parse_any)"
NSQ_SOURCE_LINE 00000319 "    {"
NSQ_SOURCE_LINE 00000320 "        $$output = $value ;"
NSQ_SOURCE_LINE 00000321 "        return 1;"
NSQ_SOURCE_LINE 00000322 "    }"
NSQ_SOURCE_LINE 00000323 "    elsif ($type & Parse_unsigned)"
NSQ_SOURCE_LINE 00000324 "    {"
NSQ_SOURCE_LINE 00000325 "        return $self->setError(\"Parameter '$key' must be an unsigned int, got 'undef'\")"
NSQ_SOURCE_LINE 00000326 "            if $validate && ! defined $value ;"
NSQ_SOURCE_LINE 00000327 "        return $self->setError(\"Parameter '$key' must be an unsigned int, got '$value'\")"
NSQ_SOURCE_LINE 00000328 "            if $validate && $value !~ /^\\d+$/;"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "        $$output = defined $value ? $value : 0 ;"
NSQ_SOURCE_LINE 00000331 "        return 1;"
NSQ_SOURCE_LINE 00000332 "    }"
NSQ_SOURCE_LINE 00000333 "    elsif ($type & Parse_signed)"
NSQ_SOURCE_LINE 00000334 "    {"
NSQ_SOURCE_LINE 00000335 "        return $self->setError(\"Parameter '$key' must be a signed int, got 'undef'\")"
NSQ_SOURCE_LINE 00000336 "            if $validate && ! defined $value ;"
NSQ_SOURCE_LINE 00000337 "        return $self->setError(\"Parameter '$key' must be a signed int, got '$value'\")"
NSQ_SOURCE_LINE 00000338 "            if $validate && $value !~ /^-?\\d+$/;"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "        $$output = defined $value ? $value : 0 ;"
NSQ_SOURCE_LINE 00000341 "        return 1 ;"
NSQ_SOURCE_LINE 00000342 "    }"
NSQ_SOURCE_LINE 00000343 "    elsif ($type & Parse_boolean)"
NSQ_SOURCE_LINE 00000344 "    {"
NSQ_SOURCE_LINE 00000345 "        return $self->setError(\"Parameter '$key' must be an int, got '$value'\")"
NSQ_SOURCE_LINE 00000346 "            if $validate && defined $value && $value !~ /^\\d*$/;"
NSQ_SOURCE_LINE 00000347 "        $$output =  defined $value ? $value != 0 : 0 ;"
NSQ_SOURCE_LINE 00000348 "        return 1;"
NSQ_SOURCE_LINE 00000349 "    }"
NSQ_SOURCE_LINE 00000350 "#    elsif ($type & Parse_string)"
NSQ_SOURCE_LINE 00000351 "#    {"
NSQ_SOURCE_LINE 00000352 "#        $$output = defined $value ? $value : \"\" ;"
NSQ_SOURCE_LINE 00000353 "#        return 1;"
NSQ_SOURCE_LINE 00000354 "#    }"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "    $$output = $value ;"
NSQ_SOURCE_LINE 00000357 "    return 1;"
NSQ_SOURCE_LINE 00000358 "}"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "sub Compress::Raw::Zlib::Parameters::parsed"
