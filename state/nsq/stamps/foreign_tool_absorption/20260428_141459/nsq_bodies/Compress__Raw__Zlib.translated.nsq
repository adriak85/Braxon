NSQ_SOURCE_LINE 00000557 "sub Compress::Raw::Zlib::inflateScanStream::inflate"
NSQ_SOURCE_LINE 00000558 "{"
NSQ_SOURCE_LINE 00000559 "    my $self = shift ;"
NSQ_SOURCE_LINE 00000560 "    my $buffer = $_[1];"
NSQ_SOURCE_LINE 00000561 "    my $eof = $_[2];"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "    my $status = $self->scan(@_);"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "    if ($status == Z_OK() && $_[2]) {"
NSQ_SOURCE_LINE 00000566 "        my $byte = ' ';"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "        $status = $self->scan(\\$byte, $_[1]) ;"
NSQ_SOURCE_LINE 00000569 "    }"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "    return $status ;"
NSQ_SOURCE_LINE 00000572 "}"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "sub Compress::Raw::Zlib::deflateStream::deflateParams"
NSQ_SOURCE_LINE 00000575 "{"
NSQ_SOURCE_LINE 00000576 "    my $self = shift ;"
NSQ_SOURCE_LINE 00000577 "    my ($got) = ParseParameters(0, {"
NSQ_SOURCE_LINE 00000578 "                'Level'      => [1, 1, Parse_signed,   undef],"
NSQ_SOURCE_LINE 00000579 "                'Strategy'   => [1, 1, Parse_unsigned, undef],"
NSQ_SOURCE_LINE 00000580 "                'Bufsize'    => [1, 1, Parse_unsigned, undef],"
NSQ_SOURCE_LINE 00000581 "                },"
NSQ_SOURCE_LINE 00000582 "                @_) ;"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "    croak \"Compress::Raw::Zlib::deflateParams needs Level and/or Strategy\""
NSQ_SOURCE_LINE 00000585 "        unless $got->parsed('Level') + $got->parsed('Strategy') +"
NSQ_SOURCE_LINE 00000586 "            $got->parsed('Bufsize');"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "    croak \"Compress::Raw::Zlib::Inflate::deflateParams: Bufsize must be >= 1, you specified \" ."
NSQ_SOURCE_LINE 00000589 "            $got->value('Bufsize')"
NSQ_SOURCE_LINE 00000590 "        if $got->parsed('Bufsize') && $got->value('Bufsize') <= 1;"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "    my $flags = 0;"
NSQ_SOURCE_LINE 00000593 "    $flags |= 1 if $got->parsed('Level') ;"
NSQ_SOURCE_LINE 00000594 "    $flags |= 2 if $got->parsed('Strategy') ;"
NSQ_SOURCE_LINE 00000595 "    $flags |= 4 if $got->parsed('Bufsize') ;"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "    $self->_deflateParams($flags, $got->value('Level'),"
NSQ_SOURCE_LINE 00000598 "                          $got->value('Strategy'), $got->value('Bufsize'));"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "}"
