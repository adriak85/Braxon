NSQ_SOURCE_LINE 00000604 "__END__"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "=head1 NAME"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "Compress::Raw::Zlib - Low-Level Interface to zlib or zlib-ng compression library"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "    use Compress::Raw::Zlib ;"
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "    ($d, $status) = new Compress::Raw::Zlib::Deflate( [OPT] ) ;"
NSQ_SOURCE_LINE 00000616 "    $status = $d->deflate($input, $output) ;"
NSQ_SOURCE_LINE 00000617 "    $status = $d->flush($output [, $flush_type]) ;"
NSQ_SOURCE_LINE 00000618 "    $d->deflateReset() ;"
NSQ_SOURCE_LINE 00000619 "    $d->deflateParams(OPTS) ;"
NSQ_SOURCE_LINE 00000620 "    $d->deflateTune(OPTS) ;"
NSQ_SOURCE_LINE 00000621 "    $d->dict_adler() ;"
NSQ_SOURCE_LINE 00000622 "    $d->crc32() ;"
NSQ_SOURCE_LINE 00000623 "    $d->adler32() ;"
NSQ_SOURCE_LINE 00000624 "    $d->total_in() ;"
NSQ_SOURCE_LINE 00000625 "    $d->total_out() ;"
NSQ_SOURCE_LINE 00000626 "    $d->msg() ;"
NSQ_SOURCE_LINE 00000627 "    $d->get_Strategy();"
NSQ_SOURCE_LINE 00000628 "    $d->get_Level();"
NSQ_SOURCE_LINE 00000629 "    $d->get_Bufsize();"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "    ($i, $status) = new Compress::Raw::Zlib::Inflate( [OPT] ) ;"
NSQ_SOURCE_LINE 00000632 "    $status = $i->inflate($input, $output [, $eof]) ;"
NSQ_SOURCE_LINE 00000633 "    $status = $i->inflateSync($input) ;"
NSQ_SOURCE_LINE 00000634 "    $i->inflateReset() ;"
NSQ_SOURCE_LINE 00000635 "    $i->dict_adler() ;"
NSQ_SOURCE_LINE 00000636 "    $d->crc32() ;"
NSQ_SOURCE_LINE 00000637 "    $d->adler32() ;"
NSQ_SOURCE_LINE 00000638 "    $i->total_in() ;"
NSQ_SOURCE_LINE 00000639 "    $i->total_out() ;"
NSQ_SOURCE_LINE 00000640 "    $i->msg() ;"
NSQ_SOURCE_LINE 00000641 "    $d->get_Bufsize();"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "    $crc = adler32($buffer [,$crc]) ;"
NSQ_SOURCE_LINE 00000644 "    $crc = crc32($buffer [,$crc]) ;"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "    $crc = crc32_combine($crc1, $crc2, $len2);"
NSQ_SOURCE_LINE 00000647 "    $adler = adler32_combine($adler1, $adler2, $len2);"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "    my $version = Compress::Raw::Zlib::zlib_version();"
NSQ_SOURCE_LINE 00000650 "    my $flags = Compress::Raw::Zlib::zlibCompileFlags();"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "    is_zlib_native();"
NSQ_SOURCE_LINE 00000653 "    is_zlibng_native();"
NSQ_SOURCE_LINE 00000654 "    is_zlibng_compat();"
NSQ_SOURCE_LINE 00000655 "    is_zlibng();"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "The I<Compress::Raw::Zlib> module provides a Perl interface to the I<zlib> or I<zlib-ng>"
NSQ_SOURCE_LINE 00000660 "compression libraries (see L</SEE ALSO> for details about where to get"
NSQ_SOURCE_LINE 00000661 "I<zlib> or I<zlib-ng>)."
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "In the text below all references to I<zlib> are also applicable to I<zlib-ng> unless otherwise stated."
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "=head1 Compress::Raw::Zlib::Deflate"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "This section defines an interface that allows in-memory compression using"
NSQ_SOURCE_LINE 00000668 "the I<deflate> interface provided by zlib."
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "Here is a definition of the interface available:"
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "=head2 B<($d, $status) = new Compress::Raw::Zlib::Deflate( [OPT] ) >"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "Initialises a deflation object."
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "If you are familiar with the I<zlib> library, it combines the"
NSQ_SOURCE_LINE 00000677 "features of the I<zlib> functions C<deflateInit>, C<deflateInit2>"
NSQ_SOURCE_LINE 00000678 "and C<deflateSetDictionary>."
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "If successful, it will return the initialised deflation object, C<$d>"
NSQ_SOURCE_LINE 00000681 "and a C<$status> of C<Z_OK> in a list context. In scalar context it"
NSQ_SOURCE_LINE 00000682 "returns the deflation object, C<$d>, only."
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "If not successful, the returned deflation object, C<$d>, will be"
NSQ_SOURCE_LINE 00000685 "I<undef> and C<$status> will hold the a I<zlib> error code."
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "The function optionally takes a number of named options specified as"
NSQ_SOURCE_LINE 00000688 "C<< Name => value >> pairs. This allows individual options to be"
NSQ_SOURCE_LINE 00000689 "tailored without having to specify them all in the parameter list."
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "For backward compatibility, it is also possible to pass the parameters"
NSQ_SOURCE_LINE 00000692 "as a reference to a hash containing the name=>value pairs."
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "Below is a list of the valid options:"
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "=over 5"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "=item B<-Level>"
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "Defines the compression level. Valid values are 0 through 9,"
NSQ_SOURCE_LINE 00000701 "C<Z_NO_COMPRESSION>, C<Z_BEST_SPEED>, C<Z_BEST_COMPRESSION>, and"
NSQ_SOURCE_LINE 00000702 "C<Z_DEFAULT_COMPRESSION>."
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "The default is C<Z_DEFAULT_COMPRESSION>."
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "=item B<-Method>"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "Defines the compression method. The only valid value at present (and"
NSQ_SOURCE_LINE 00000709 "the default) is C<Z_DEFLATED>."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "=item B<-WindowBits>"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "To compress an RFC 1950 data stream, set C<WindowBits> to a positive"
NSQ_SOURCE_LINE 00000714 "number between 8 and 15."
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "To compress an RFC 1951 data stream, set C<WindowBits> to C<-MAX_WBITS>."
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "To compress an RFC 1952 data stream (i.e. gzip), set C<WindowBits> to"
NSQ_SOURCE_LINE 00000719 "C<WANT_GZIP>."
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "For a definition of the meaning and valid values for C<WindowBits>"
NSQ_SOURCE_LINE 00000722 "refer to the I<zlib> documentation for I<deflateInit2>."
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "Defaults to C<MAX_WBITS>."
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "=item B<-MemLevel>"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "For a definition of the meaning and valid values for C<MemLevel>"
NSQ_SOURCE_LINE 00000729 "refer to the I<zlib> documentation for I<deflateInit2>."
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "Defaults to MAX_MEM_LEVEL."
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "=item B<-Strategy>"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "Defines the strategy used to tune the compression. The valid values are"
NSQ_SOURCE_LINE 00000736 "C<Z_DEFAULT_STRATEGY>, C<Z_FILTERED>, C<Z_RLE>, C<Z_FIXED> and"
NSQ_SOURCE_LINE 00000737 "C<Z_HUFFMAN_ONLY>."
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "The default is C<Z_DEFAULT_STRATEGY>."
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "=item B<-Dictionary>"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "When a dictionary is specified I<Compress::Raw::Zlib> will automatically"
NSQ_SOURCE_LINE 00000744 "call C<deflateSetDictionary> directly after calling C<deflateInit>. The"
NSQ_SOURCE_LINE 00000745 "Adler32 value for the dictionary can be obtained by calling the method"
NSQ_SOURCE_LINE 00000746 "C<$d-E<gt>dict_adler()>."
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "The default is no dictionary."
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "=item B<-Bufsize>"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "Sets the initial size for the output buffer used by the C<$d-E<gt>deflate>"
NSQ_SOURCE_LINE 00000753 "and C<$d-E<gt>flush> methods. If the buffer has to be"
NSQ_SOURCE_LINE 00000754 "reallocated to increase the size, it will grow in increments of"
NSQ_SOURCE_LINE 00000755 "C<Bufsize>."
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "The default buffer size is 4096."
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "=item B<-AppendOutput>"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "This option controls how data is written to the output buffer by the"
NSQ_SOURCE_LINE 00000762 "C<$d-E<gt>deflate> and C<$d-E<gt>flush> methods."
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "If the C<AppendOutput> option is set to false, the output buffers in the"
NSQ_SOURCE_LINE 00000765 "C<$d-E<gt>deflate> and C<$d-E<gt>flush>  methods will be truncated before"
NSQ_SOURCE_LINE 00000766 "uncompressed data is written to them."
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "If the option is set to true, uncompressed data will be appended to the"
NSQ_SOURCE_LINE 00000769 "output buffer in the C<$d-E<gt>deflate> and C<$d-E<gt>flush> methods."
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "This option defaults to false."
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "=item B<-CRC32>"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "If set to true, a crc32 checksum of the uncompressed data will be"
NSQ_SOURCE_LINE 00000776 "calculated. Use the C<$d-E<gt>crc32> method to retrieve this value."
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "This option defaults to false."
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "=item B<-ADLER32>"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "If set to true, an adler32 checksum of the uncompressed data will be"
NSQ_SOURCE_LINE 00000783 "calculated. Use the C<$d-E<gt>adler32> method to retrieve this value."
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "This option defaults to false."
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "=back"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "Here is an example of using the C<Compress::Raw::Zlib::Deflate> optional"
NSQ_SOURCE_LINE 00000790 "parameter list to override the default buffer size and compression"
NSQ_SOURCE_LINE 00000791 "level. All other options will take their default values."
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "    my $d = new Compress::Raw::Zlib::Deflate ( -Bufsize => 300,"
NSQ_SOURCE_LINE 00000794 "                                               -Level   => Z_BEST_SPEED ) ;"
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "=head2 B<$status = $d-E<gt>deflate($input, $output)>"
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 "Deflates the contents of C<$input> and writes the compressed data to"
NSQ_SOURCE_LINE 00000799 "C<$output>."
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "The C<$input> and C<$output> parameters can be either scalars or scalar"
NSQ_SOURCE_LINE 00000802 "references."
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "When finished, C<$input> will be completely processed (assuming there"
NSQ_SOURCE_LINE 00000805 "were no errors). If the deflation was successful it writes the deflated"
NSQ_SOURCE_LINE 00000806 "data to C<$output> and returns a status value of C<Z_OK>."
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "On error, it returns a I<zlib> error code."
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "If the C<AppendOutput> option is set to true in the constructor for"
NSQ_SOURCE_LINE 00000811 "the C<$d> object, the compressed data will be appended to C<$output>. If"
NSQ_SOURCE_LINE 00000812 "it is false, C<$output> will be truncated before any compressed data is"
NSQ_SOURCE_LINE 00000813 "written to it."
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "B<Note>: This method will not necessarily write compressed data to"
NSQ_SOURCE_LINE 00000816 "C<$output> every time it is called. So do not assume that there has been"
NSQ_SOURCE_LINE 00000817 "an error if the contents of C<$output> is empty on returning from"
NSQ_SOURCE_LINE 00000818 "this method. As long as the return code from the method is C<Z_OK>,"
NSQ_SOURCE_LINE 00000819 "the deflate has succeeded."
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "=head2 B<$status = $d-E<gt>flush($output [, $flush_type]) >"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "Typically used to finish the deflation. Any pending output will be"
NSQ_SOURCE_LINE 00000824 "written to C<$output>."
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "Returns C<Z_OK> if successful."
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "Note that flushing can seriously degrade the compression ratio, so it"
NSQ_SOURCE_LINE 00000829 "should only be used to terminate a decompression (using C<Z_FINISH>) or"
NSQ_SOURCE_LINE 00000830 "when you want to create a I<full flush point> (using C<Z_FULL_FLUSH>)."
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "By default the C<flush_type> used is C<Z_FINISH>. Other valid values"
NSQ_SOURCE_LINE 00000833 "for C<flush_type> are C<Z_NO_FLUSH>, C<Z_PARTIAL_FLUSH>, C<Z_SYNC_FLUSH>"
NSQ_SOURCE_LINE 00000834 "and C<Z_FULL_FLUSH>. It is strongly recommended that you only set the"
NSQ_SOURCE_LINE 00000835 "C<flush_type> parameter if you fully understand the implications of"
NSQ_SOURCE_LINE 00000836 "what it does. See the C<zlib> documentation for details."
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "If the C<AppendOutput> option is set to true in the constructor for"
NSQ_SOURCE_LINE 00000839 "the C<$d> object, the compressed data will be appended to C<$output>. If"
NSQ_SOURCE_LINE 00000840 "it is false, C<$output> will be truncated before any compressed data is"
NSQ_SOURCE_LINE 00000841 "written to it."
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "=head2 B<$status = $d-E<gt>deflateReset() >"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "This method will reset the deflation object C<$d>. It can be used when you"
NSQ_SOURCE_LINE 00000846 "are compressing multiple data streams and want to use the same object to"
NSQ_SOURCE_LINE 00000847 "compress each of them. It should only be used once the previous data stream"
NSQ_SOURCE_LINE 00000848 "has been flushed successfully, i.e. a call to C<< $d->flush(Z_FINISH) >> has"
NSQ_SOURCE_LINE 00000849 "returned C<Z_OK>."
NSQ_SOURCE_LINE 00000850 ""
NSQ_SOURCE_LINE 00000851 "Returns C<Z_OK> if successful."
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "=head2 B<$status = $d-E<gt>deflateParams([OPT])>"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "Change settings for the deflate object C<$d>."
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "The list of the valid options is shown below. Options not specified"
NSQ_SOURCE_LINE 00000858 "will remain unchanged."
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 "=over 5"
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "=item B<-Level>"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "Defines the compression level. Valid values are 0 through 9,"
NSQ_SOURCE_LINE 00000865 "C<Z_NO_COMPRESSION>, C<Z_BEST_SPEED>, C<Z_BEST_COMPRESSION>, and"
NSQ_SOURCE_LINE 00000866 "C<Z_DEFAULT_COMPRESSION>."
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "=item B<-Strategy>"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "Defines the strategy used to tune the compression. The valid values are"
NSQ_SOURCE_LINE 00000871 "C<Z_DEFAULT_STRATEGY>, C<Z_FILTERED> and C<Z_HUFFMAN_ONLY>."
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "=item B<-BufSize>"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "Sets the initial size for the output buffer used by the C<$d-E<gt>deflate>"
NSQ_SOURCE_LINE 00000876 "and C<$d-E<gt>flush> methods. If the buffer has to be"
NSQ_SOURCE_LINE 00000877 "reallocated to increase the size, it will grow in increments of"
NSQ_SOURCE_LINE 00000878 "C<Bufsize>."
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "=back"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "=head2 B<$status = $d-E<gt>deflateTune($good_length, $max_lazy, $nice_length, $max_chain)>"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "Tune the internal settings for the deflate object C<$d>. This option is"
NSQ_SOURCE_LINE 00000885 "only available if you are running zlib 1.2.2.3 or better."
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "Refer to the documentation in zlib.h for instructions on how to fly"
NSQ_SOURCE_LINE 00000888 "C<deflateTune>."
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "=head2 B<$d-E<gt>dict_adler()>"
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "Returns the adler32 value for the dictionary."
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "=head2 B<$d-E<gt>crc32()>"
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "Returns the crc32 value for the uncompressed data to date."
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "If the C<CRC32> option is not enabled in the constructor for this object,"
NSQ_SOURCE_LINE 00000899 "this method will always return 0;"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "=head2 B<$d-E<gt>adler32()>"
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "Returns the adler32 value for the uncompressed data to date."
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "=head2 B<$d-E<gt>msg()>"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "Returns the last error message generated by zlib."
NSQ_SOURCE_LINE 00000908 ""
NSQ_SOURCE_LINE 00000909 "=head2 B<$d-E<gt>total_in()>"
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "Returns the total number of bytes uncompressed bytes input to deflate."
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "=head2 B<$d-E<gt>total_out()>"
NSQ_SOURCE_LINE 00000914 ""
NSQ_SOURCE_LINE 00000915 "Returns the total number of compressed bytes output from deflate."
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "=head2 B<$d-E<gt>get_Strategy()>"
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "Returns the deflation strategy currently used. Valid values are"
NSQ_SOURCE_LINE 00000920 "C<Z_DEFAULT_STRATEGY>, C<Z_FILTERED> and C<Z_HUFFMAN_ONLY>."
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "=head2 B<$d-E<gt>get_Level()>"
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "Returns the compression level being used."
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "=head2 B<$d-E<gt>get_Bufsize()>"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "Returns the buffer size used to carry out the compression."
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "=head2 Example"
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "Here is a trivial example of using C<deflate>. It simply reads standard"
NSQ_SOURCE_LINE 00000933 "input, deflates it and writes it to standard output."
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "    use strict ;"
NSQ_SOURCE_LINE 00000936 "    use warnings ;"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "    use Compress::Raw::Zlib ;"
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "    binmode STDIN;"
NSQ_SOURCE_LINE 00000941 "    binmode STDOUT;"
NSQ_SOURCE_LINE 00000942 "    my $x = new Compress::Raw::Zlib::Deflate"
NSQ_SOURCE_LINE 00000943 "       or die \"Cannot create a deflation stream\\n\" ;"
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 "    my ($output, $status) ;"
NSQ_SOURCE_LINE 00000946 "    while (<>)"
NSQ_SOURCE_LINE 00000947 "    {"
NSQ_SOURCE_LINE 00000948 "        $status = $x->deflate($_, $output) ;"
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "        $status == Z_OK"
NSQ_SOURCE_LINE 00000951 "            or die \"deflation failed\\n\" ;"
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "        print $output ;"
NSQ_SOURCE_LINE 00000954 "    }"
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "    $status = $x->flush($output) ;"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "    $status == Z_OK"
NSQ_SOURCE_LINE 00000959 "        or die \"deflation failed\\n\" ;"
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "    print $output ;"
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "=head1 Compress::Raw::Zlib::Inflate"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "This section defines an interface that allows in-memory uncompression using"
NSQ_SOURCE_LINE 00000966 "the I<inflate> interface provided by zlib."
NSQ_SOURCE_LINE 00000967 ""
NSQ_SOURCE_LINE 00000968 "Here is a definition of the interface:"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "=head2 B< ($i, $status) = new Compress::Raw::Zlib::Inflate( [OPT] ) >"
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "Initialises an inflation object."
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "In a list context it returns the inflation object, C<$i>, and the"
NSQ_SOURCE_LINE 00000975 "I<zlib> status code (C<$status>). In a scalar context it returns the"
NSQ_SOURCE_LINE 00000976 "inflation object only."
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 "If successful, C<$i> will hold the inflation object and C<$status> will"
NSQ_SOURCE_LINE 00000979 "be C<Z_OK>."
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "If not successful, C<$i> will be I<undef> and C<$status> will hold the"
NSQ_SOURCE_LINE 00000982 "I<zlib> error code."
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "The function optionally takes a number of named options specified as"
NSQ_SOURCE_LINE 00000985 "C<< -Name => value >> pairs. This allows individual options to be"
NSQ_SOURCE_LINE 00000986 "tailored without having to specify them all in the parameter list."
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 "For backward compatibility, it is also possible to pass the parameters"
NSQ_SOURCE_LINE 00000989 "as a reference to a hash containing the C<< name=>value >> pairs."
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "Here is a list of the valid options:"
NSQ_SOURCE_LINE 00000992 ""
NSQ_SOURCE_LINE 00000993 "=over 5"
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "=item B<-WindowBits>"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "To uncompress an RFC 1950 data stream, set C<WindowBits> to a positive"
NSQ_SOURCE_LINE 00000998 "number between 8 and 15."
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "To uncompress an RFC 1951 data stream, set C<WindowBits> to C<-MAX_WBITS>."
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "To uncompress an RFC 1952 data stream (i.e. gzip), set C<WindowBits> to"
NSQ_SOURCE_LINE 00001003 "C<WANT_GZIP>."
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "To auto-detect and uncompress an RFC 1950 or RFC 1952 data stream (i.e."
NSQ_SOURCE_LINE 00001006 "gzip), set C<WindowBits> to C<WANT_GZIP_OR_ZLIB>."
NSQ_SOURCE_LINE 00001007 ""
NSQ_SOURCE_LINE 00001008 "For a full definition of the meaning and valid values for C<WindowBits>"
NSQ_SOURCE_LINE 00001009 "refer to the I<zlib> documentation for I<inflateInit2>."
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "Defaults to C<MAX_WBITS>."
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "=item B<-Bufsize>"
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "Sets the initial size for the output buffer used by the C<$i-E<gt>inflate>"
NSQ_SOURCE_LINE 00001016 "method. If the output buffer in this method has to be reallocated to"
NSQ_SOURCE_LINE 00001017 "increase the size, it will grow in increments of C<Bufsize>."
NSQ_SOURCE_LINE 00001018 ""
NSQ_SOURCE_LINE 00001019 "Default is 4096."
NSQ_SOURCE_LINE 00001020 ""
NSQ_SOURCE_LINE 00001021 "=item B<-Dictionary>"
NSQ_SOURCE_LINE 00001022 ""
NSQ_SOURCE_LINE 00001023 "The default is no dictionary."
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "=item B<-AppendOutput>"
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "This option controls how data is written to the output buffer by the"
NSQ_SOURCE_LINE 00001028 "C<$i-E<gt>inflate> method."
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "If the option is set to false, the output buffer in the C<$i-E<gt>inflate>"
NSQ_SOURCE_LINE 00001031 "method will be truncated before uncompressed data is written to it."
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 "If the option is set to true, uncompressed data will be appended to the"
NSQ_SOURCE_LINE 00001034 "output buffer by the C<$i-E<gt>inflate> method."
NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "This option defaults to false."
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "=item B<-CRC32>"
NSQ_SOURCE_LINE 00001039 ""
NSQ_SOURCE_LINE 00001040 "If set to true, a crc32 checksum of the uncompressed data will be"
NSQ_SOURCE_LINE 00001041 "calculated. Use the C<$i-E<gt>crc32> method to retrieve this value."
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "This option defaults to false."
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "=item B<-ADLER32>"
NSQ_SOURCE_LINE 00001046 ""
NSQ_SOURCE_LINE 00001047 "If set to true, an adler32 checksum of the uncompressed data will be"
NSQ_SOURCE_LINE 00001048 "calculated. Use the C<$i-E<gt>adler32> method to retrieve this value."
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "This option defaults to false."
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "=item B<-ConsumeInput>"
NSQ_SOURCE_LINE 00001053 ""
NSQ_SOURCE_LINE 00001054 "If set to true, this option will remove compressed data from the input"
NSQ_SOURCE_LINE 00001055 "buffer of the C<< $i->inflate >> method as the inflate progresses."
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "This option can be useful when you are processing compressed data that is"
NSQ_SOURCE_LINE 00001058 "embedded in another file/buffer. In this case the data that immediately"
NSQ_SOURCE_LINE 00001059 "follows the compressed stream will be left in the input buffer."
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "This option defaults to true."
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "=item B<-LimitOutput>"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "The C<LimitOutput> option changes the behavior of the C<< $i->inflate >>"
NSQ_SOURCE_LINE 00001066 "method so that the amount of memory used by the output buffer can be"
NSQ_SOURCE_LINE 00001067 "limited."
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "When C<LimitOutput> is used the size of the output buffer used will either"
NSQ_SOURCE_LINE 00001070 "be the value of the C<Bufsize> option or the amount of memory already"
NSQ_SOURCE_LINE 00001071 "allocated to C<$output>, whichever is larger. Predicting the output size"
NSQ_SOURCE_LINE 00001072 "available is tricky, so don't rely on getting an exact output buffer size."
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 "When C<LimitOutout> is not specified C<< $i->inflate >> will use as much"
NSQ_SOURCE_LINE 00001075 "memory as it takes to write all the uncompressed data it creates by"
NSQ_SOURCE_LINE 00001076 "uncompressing the input buffer."
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 "If C<LimitOutput> is enabled, the C<ConsumeInput> option will also be"
NSQ_SOURCE_LINE 00001079 "enabled."
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "This option defaults to false."
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "See L</The LimitOutput option> for a discussion on why C<LimitOutput> is"
NSQ_SOURCE_LINE 00001084 "needed and how to use it."
NSQ_SOURCE_LINE 00001085 ""
NSQ_SOURCE_LINE 00001086 "=back"
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "Here is an example of using an optional parameter to override the default"
NSQ_SOURCE_LINE 00001089 "buffer size."
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 "    my ($i, $status) = new Compress::Raw::Zlib::Inflate( -Bufsize => 300 ) ;"
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "=head2 B< $status = $i-E<gt>inflate($input, $output [,$eof]) >"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "Inflates the complete contents of C<$input> and writes the uncompressed"
NSQ_SOURCE_LINE 00001096 "data to C<$output>. The C<$input> and C<$output> parameters can either be"
NSQ_SOURCE_LINE 00001097 "scalars or scalar references."
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "Returns C<Z_OK> if successful and C<Z_STREAM_END> if the end of the"
NSQ_SOURCE_LINE 00001100 "compressed data has been successfully reached."
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "If not successful C<$status> will hold the I<zlib> error code."
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 "If the C<ConsumeInput> option has been set to true when the"
NSQ_SOURCE_LINE 00001105 "C<Compress::Raw::Zlib::Inflate> object is created, the C<$input> parameter"
NSQ_SOURCE_LINE 00001106 "is modified by C<inflate>. On completion it will contain what remains"
NSQ_SOURCE_LINE 00001107 "of the input buffer after inflation. In practice, this means that when"
NSQ_SOURCE_LINE 00001108 "the return status is C<Z_OK> the C<$input> parameter will contain an"
NSQ_SOURCE_LINE 00001109 "empty string, and when the return status is C<Z_STREAM_END> the C<$input>"
NSQ_SOURCE_LINE 00001110 "parameter will contains what (if anything) was stored in the input buffer"
NSQ_SOURCE_LINE 00001111 "after the deflated data stream."
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "This feature is useful when processing a file format that encapsulates"
NSQ_SOURCE_LINE 00001114 "a compressed data stream (e.g. gzip, zip) and there is useful data"
NSQ_SOURCE_LINE 00001115 "immediately after the deflation stream."
NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "If the C<AppendOutput> option is set to true in the constructor for"
NSQ_SOURCE_LINE 00001118 "this object, the uncompressed data will be appended to C<$output>. If"
NSQ_SOURCE_LINE 00001119 "it is false, C<$output> will be truncated before any uncompressed data"
NSQ_SOURCE_LINE 00001120 "is written to it."
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "The C<$eof> parameter needs a bit of explanation."
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 "Prior to version 1.2.0, zlib assumed that there was at least one trailing"
NSQ_SOURCE_LINE 00001125 "byte immediately after the compressed data stream when it was carrying out"
NSQ_SOURCE_LINE 00001126 "decompression. This normally isn't a problem because the majority of zlib"
NSQ_SOURCE_LINE 00001127 "applications guarantee that there will be data directly after the"
NSQ_SOURCE_LINE 00001128 "compressed data stream.  For example, both gzip (RFC 1950) and zip both"
NSQ_SOURCE_LINE 00001129 "define trailing data that follows the compressed data stream."
NSQ_SOURCE_LINE 00001130 ""
NSQ_SOURCE_LINE 00001131 "The C<$eof> parameter only needs to be used if B<all> of the following"
NSQ_SOURCE_LINE 00001132 "conditions apply"
NSQ_SOURCE_LINE 00001133 ""
NSQ_SOURCE_LINE 00001134 "=over 5"
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 "=item 1"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "You are either using a copy of zlib that is older than version 1.2.0 or you"
NSQ_SOURCE_LINE 00001139 "want your application code to be able to run with as many different"
NSQ_SOURCE_LINE 00001140 "versions of zlib as possible."
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "=item 2"
NSQ_SOURCE_LINE 00001143 ""
NSQ_SOURCE_LINE 00001144 "You have set the C<WindowBits> parameter to C<-MAX_WBITS> in the constructor"
NSQ_SOURCE_LINE 00001145 "for this object, i.e. you are uncompressing a raw deflated data stream"
NSQ_SOURCE_LINE 00001146 "(RFC 1951)."
NSQ_SOURCE_LINE 00001147 ""
NSQ_SOURCE_LINE 00001148 "=item 3"
NSQ_SOURCE_LINE 00001149 ""
NSQ_SOURCE_LINE 00001150 "There is no data immediately after the compressed data stream."
NSQ_SOURCE_LINE 00001151 ""
NSQ_SOURCE_LINE 00001152 "=back"
NSQ_SOURCE_LINE 00001153 ""
NSQ_SOURCE_LINE 00001154 "If B<all> of these are the case, then you need to set the C<$eof> parameter"
NSQ_SOURCE_LINE 00001155 "to true on the final call (and only the final call) to C<$i-E<gt>inflate>."
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "If you have built this module with zlib >= 1.2.0, the C<$eof> parameter is"
NSQ_SOURCE_LINE 00001158 "ignored. You can still set it if you want, but it won't be used behind the"
NSQ_SOURCE_LINE 00001159 "scenes."
NSQ_SOURCE_LINE 00001160 ""
NSQ_SOURCE_LINE 00001161 "=head2 B<$status = $i-E<gt>inflateSync($input)>"
NSQ_SOURCE_LINE 00001162 ""
NSQ_SOURCE_LINE 00001163 "This method can be used to attempt to recover good data from a compressed"
NSQ_SOURCE_LINE 00001164 "data stream that is partially corrupt."
NSQ_SOURCE_LINE 00001165 "It scans C<$input> until it reaches either a I<full flush point> or the"
NSQ_SOURCE_LINE 00001166 "end of the buffer."
NSQ_SOURCE_LINE 00001167 ""
NSQ_SOURCE_LINE 00001168 "If a I<full flush point> is found, C<Z_OK> is returned and C<$input>"
NSQ_SOURCE_LINE 00001169 "will be have all data up to the flush point removed. This data can then be"
NSQ_SOURCE_LINE 00001170 "passed to the C<$i-E<gt>inflate> method to be uncompressed."
NSQ_SOURCE_LINE 00001171 ""
NSQ_SOURCE_LINE 00001172 "Any other return code means that a flush point was not found. If more"
NSQ_SOURCE_LINE 00001173 "data is available, C<inflateSync> can be called repeatedly with more"
NSQ_SOURCE_LINE 00001174 "compressed data until the flush point is found."
NSQ_SOURCE_LINE 00001175 ""
NSQ_SOURCE_LINE 00001176 "Note I<full flush points> are not present by default in compressed"
NSQ_SOURCE_LINE 00001177 "data streams. They must have been added explicitly when the data stream"
NSQ_SOURCE_LINE 00001178 "was created by calling C<Compress::Deflate::flush>  with C<Z_FULL_FLUSH>."
NSQ_SOURCE_LINE 00001179 ""
NSQ_SOURCE_LINE 00001180 "=head2 B<$status = $i-E<gt>inflateReset() >"
NSQ_SOURCE_LINE 00001181 ""
NSQ_SOURCE_LINE 00001182 "This method will reset the inflation object C<$i>. It can be used when you"
NSQ_SOURCE_LINE 00001183 "are uncompressing multiple data streams and want to use the same object to"
NSQ_SOURCE_LINE 00001184 "uncompress each of them."
NSQ_SOURCE_LINE 00001185 ""
NSQ_SOURCE_LINE 00001186 "Returns C<Z_OK> if successful."
NSQ_SOURCE_LINE 00001187 ""
NSQ_SOURCE_LINE 00001188 "=head2 B<$i-E<gt>dict_adler()>"
NSQ_SOURCE_LINE 00001189 ""
NSQ_SOURCE_LINE 00001190 "Returns the adler32 value for the dictionary."
NSQ_SOURCE_LINE 00001191 ""
NSQ_SOURCE_LINE 00001192 "=head2 B<$i-E<gt>crc32()>"
NSQ_SOURCE_LINE 00001193 ""
NSQ_SOURCE_LINE 00001194 "Returns the crc32 value for the uncompressed data to date."
NSQ_SOURCE_LINE 00001195 ""
NSQ_SOURCE_LINE 00001196 "If the C<CRC32> option is not enabled in the constructor for this object,"
NSQ_SOURCE_LINE 00001197 "this method will always return 0;"
NSQ_SOURCE_LINE 00001198 ""
NSQ_SOURCE_LINE 00001199 "=head2 B<$i-E<gt>adler32()>"
NSQ_SOURCE_LINE 00001200 ""
NSQ_SOURCE_LINE 00001201 "Returns the adler32 value for the uncompressed data to date."
NSQ_SOURCE_LINE 00001202 ""
NSQ_SOURCE_LINE 00001203 "If the C<ADLER32> option is not enabled in the constructor for this object,"
NSQ_SOURCE_LINE 00001204 "this method will always return 0;"
NSQ_SOURCE_LINE 00001205 ""
NSQ_SOURCE_LINE 00001206 "=head2 B<$i-E<gt>msg()>"
NSQ_SOURCE_LINE 00001207 ""
NSQ_SOURCE_LINE 00001208 "Returns the last error message generated by zlib."
NSQ_SOURCE_LINE 00001209 ""
NSQ_SOURCE_LINE 00001210 "=head2 B<$i-E<gt>total_in()>"
NSQ_SOURCE_LINE 00001211 ""
NSQ_SOURCE_LINE 00001212 "Returns the total number of bytes compressed bytes input to inflate."
NSQ_SOURCE_LINE 00001213 ""
NSQ_SOURCE_LINE 00001214 "=head2 B<$i-E<gt>total_out()>"
NSQ_SOURCE_LINE 00001215 ""
NSQ_SOURCE_LINE 00001216 "Returns the total number of uncompressed bytes output from inflate."
NSQ_SOURCE_LINE 00001217 ""
NSQ_SOURCE_LINE 00001218 "=head2 B<$d-E<gt>get_Bufsize()>"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "Returns the buffer size used to carry out the decompression."
NSQ_SOURCE_LINE 00001221 ""
NSQ_SOURCE_LINE 00001222 "=head2 Examples"
NSQ_SOURCE_LINE 00001223 ""
NSQ_SOURCE_LINE 00001224 "Here is an example of using C<inflate>."
NSQ_SOURCE_LINE 00001225 ""
NSQ_SOURCE_LINE 00001226 "    use strict ;"
NSQ_SOURCE_LINE 00001227 "    use warnings ;"
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 "    use Compress::Raw::Zlib;"
NSQ_SOURCE_LINE 00001230 ""
NSQ_SOURCE_LINE 00001231 "    my $x = new Compress::Raw::Zlib::Inflate()"
NSQ_SOURCE_LINE 00001232 "       or die \"Cannot create a inflation stream\\n\" ;"
NSQ_SOURCE_LINE 00001233 ""
NSQ_SOURCE_LINE 00001234 "    my $input = '' ;"
NSQ_SOURCE_LINE 00001235 "    binmode STDIN;"
NSQ_SOURCE_LINE 00001236 "    binmode STDOUT;"
NSQ_SOURCE_LINE 00001237 ""
NSQ_SOURCE_LINE 00001238 "    my ($output, $status) ;"
NSQ_SOURCE_LINE 00001239 "    while (read(STDIN, $input, 4096))"
NSQ_SOURCE_LINE 00001240 "    {"
NSQ_SOURCE_LINE 00001241 "        $status = $x->inflate($input, $output) ;"
NSQ_SOURCE_LINE 00001242 ""
NSQ_SOURCE_LINE 00001243 "        print $output ;"
NSQ_SOURCE_LINE 00001244 ""
NSQ_SOURCE_LINE 00001245 "        last if $status != Z_OK ;"
NSQ_SOURCE_LINE 00001246 "    }"
NSQ_SOURCE_LINE 00001247 ""
NSQ_SOURCE_LINE 00001248 "    die \"inflation failed\\n\""
NSQ_SOURCE_LINE 00001249 "        unless $status == Z_STREAM_END ;"
NSQ_SOURCE_LINE 00001250 ""
NSQ_SOURCE_LINE 00001251 "The next example show how to use the C<LimitOutput> option. Notice the use"
NSQ_SOURCE_LINE 00001252 "of two nested loops in this case. The outer loop reads the data from the"
NSQ_SOURCE_LINE 00001253 "input source - STDIN and the inner loop repeatedly calls C<inflate> until"
NSQ_SOURCE_LINE 00001254 "C<$input> is exhausted, we get an error, or the end of the stream is"
NSQ_SOURCE_LINE 00001255 "reached. One point worth remembering is by using the C<LimitOutput> option"
NSQ_SOURCE_LINE 00001256 "you also get C<ConsumeInput> set as well - this makes the code below much"
NSQ_SOURCE_LINE 00001257 "simpler."
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "    use strict ;"
NSQ_SOURCE_LINE 00001260 "    use warnings ;"
NSQ_SOURCE_LINE 00001261 ""
NSQ_SOURCE_LINE 00001262 "    use Compress::Raw::Zlib;"
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "    my $x = new Compress::Raw::Zlib::Inflate(LimitOutput => 1)"
NSQ_SOURCE_LINE 00001265 "       or die \"Cannot create a inflation stream\\n\" ;"
NSQ_SOURCE_LINE 00001266 ""
NSQ_SOURCE_LINE 00001267 "    my $input = '' ;"
NSQ_SOURCE_LINE 00001268 "    binmode STDIN;"
NSQ_SOURCE_LINE 00001269 "    binmode STDOUT;"
NSQ_SOURCE_LINE 00001270 ""
NSQ_SOURCE_LINE 00001271 "    my ($output, $status) ;"
NSQ_SOURCE_LINE 00001272 ""
NSQ_SOURCE_LINE 00001273 "  OUTER:"
NSQ_SOURCE_LINE 00001274 "    while (read(STDIN, $input, 4096))"
NSQ_SOURCE_LINE 00001275 "    {"
NSQ_SOURCE_LINE 00001276 "        do"
NSQ_SOURCE_LINE 00001277 "        {"
NSQ_SOURCE_LINE 00001278 "            $status = $x->inflate($input, $output) ;"
NSQ_SOURCE_LINE 00001279 ""
NSQ_SOURCE_LINE 00001280 "            print $output ;"
NSQ_SOURCE_LINE 00001281 ""
NSQ_SOURCE_LINE 00001282 "            last OUTER"
NSQ_SOURCE_LINE 00001283 "                unless $status == Z_OK || $status == Z_BUF_ERROR ;"
NSQ_SOURCE_LINE 00001284 "        }"
NSQ_SOURCE_LINE 00001285 "        while length $input;"
NSQ_SOURCE_LINE 00001286 "    }"
NSQ_SOURCE_LINE 00001287 ""
NSQ_SOURCE_LINE 00001288 "    die \"inflation failed\\n\""
NSQ_SOURCE_LINE 00001289 "        unless $status == Z_STREAM_END ;"
NSQ_SOURCE_LINE 00001290 ""
NSQ_SOURCE_LINE 00001291 "=head1 CHECKSUM FUNCTIONS"
NSQ_SOURCE_LINE 00001292 ""
NSQ_SOURCE_LINE 00001293 "Two functions are provided by I<zlib> to calculate checksums. For the"
NSQ_SOURCE_LINE 00001294 "Perl interface, the order of the two parameters in both functions has"
NSQ_SOURCE_LINE 00001295 "been reversed. This allows both running checksums and one off"
NSQ_SOURCE_LINE 00001296 "calculations to be done."
NSQ_SOURCE_LINE 00001297 ""
NSQ_SOURCE_LINE 00001298 "    $crc = adler32($buffer [,$crc]) ;"
NSQ_SOURCE_LINE 00001299 "    $crc = crc32($buffer [,$crc]) ;"
NSQ_SOURCE_LINE 00001300 ""
NSQ_SOURCE_LINE 00001301 "The buffer parameters can either be a scalar or a scalar reference."
NSQ_SOURCE_LINE 00001302 ""
NSQ_SOURCE_LINE 00001303 "If the $crc parameters is C<undef>, the crc value will be reset."
NSQ_SOURCE_LINE 00001304 ""
NSQ_SOURCE_LINE 00001305 "If you have built this module with zlib 1.2.3 or better, two more"
NSQ_SOURCE_LINE 00001306 "CRC-related functions are available."
NSQ_SOURCE_LINE 00001307 ""
NSQ_SOURCE_LINE 00001308 "    $crc = crc32_combine($crc1, $crc2, $len2);"
NSQ_SOURCE_LINE 00001309 "    $adler = adler32_combine($adler1, $adler2, $len2);"
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 "These functions allow checksums to be merged."
NSQ_SOURCE_LINE 00001312 "Refer to the I<zlib> documentation for more details."
NSQ_SOURCE_LINE 00001313 ""
NSQ_SOURCE_LINE 00001314 "=head1 Misc"
NSQ_SOURCE_LINE 00001315 ""
NSQ_SOURCE_LINE 00001316 "=head2 my $version = Compress::Raw::Zlib::zlib_version();"
NSQ_SOURCE_LINE 00001317 ""
NSQ_SOURCE_LINE 00001318 "Returns the version of the I<zlib> library if this module has been built with the I<zlib> library."
NSQ_SOURCE_LINE 00001319 "If this module has been built with I<zlib-ng> in native mode, this function will return a empty string."
NSQ_SOURCE_LINE 00001320 "If this module has been built with I<zlib-ng> in compat mode, this function will return the Izlib> API"
NSQ_SOURCE_LINE 00001321 "version that I<zlib-ng> is supporting."
NSQ_SOURCE_LINE 00001322 ""
NSQ_SOURCE_LINE 00001323 "=head2 my $version = Compress::Raw::Zlib::zlibng_version();"
NSQ_SOURCE_LINE 00001324 ""
NSQ_SOURCE_LINE 00001325 "Returns the version of the zlib-ng library if this module has been built with the I<zlib-ng> library."
NSQ_SOURCE_LINE 00001326 "If this module has been built with I<zlib>, this function will return a empty string."
NSQ_SOURCE_LINE 00001327 ""
NSQ_SOURCE_LINE 00001328 "=head2  my $flags = Compress::Raw::Zlib::zlibCompileFlags();"
NSQ_SOURCE_LINE 00001329 ""
NSQ_SOURCE_LINE 00001330 "Returns the flags indicating compile-time options that were used to build"
NSQ_SOURCE_LINE 00001331 "the zlib or zlib-ng library. See the zlib documentation for a description of the flags"
NSQ_SOURCE_LINE 00001332 "returned by C<zlibCompileFlags>."
NSQ_SOURCE_LINE 00001333 ""
NSQ_SOURCE_LINE 00001334 "Note that when the zlib sources are built along with this module the"
NSQ_SOURCE_LINE 00001335 "C<sprintf> flags (bits 24, 25 and 26) should be ignored."
NSQ_SOURCE_LINE 00001336 ""
NSQ_SOURCE_LINE 00001337 "If you are using zlib 1.2.0 or older, C<zlibCompileFlags> will return 0."
NSQ_SOURCE_LINE 00001338 ""
NSQ_SOURCE_LINE 00001339 "=head2 is_zlib_native();"
NSQ_SOURCE_LINE 00001340 "=head2 is_zlibng_native();"
NSQ_SOURCE_LINE 00001341 "=head2 is_zlibng_compat();"
NSQ_SOURCE_LINE 00001342 "=head2 is_zlibng();"
NSQ_SOURCE_LINE 00001343 ""
NSQ_SOURCE_LINE 00001344 "These function can use used to check if C<Compress::Raw::Zlib> was been built with I<zlib> or I<zlib-ng>."
NSQ_SOURCE_LINE 00001345 ""
NSQ_SOURCE_LINE 00001346 "The function C<is_zlib_native> returns true if C<Compress::Raw::Zlib> was built with I<zlib>."
NSQ_SOURCE_LINE 00001347 "The function C<is_zlibng> returns true if C<Compress::Raw::Zlib> was built with I<zlib-ng>."
NSQ_SOURCE_LINE 00001348 ""
NSQ_SOURCE_LINE 00001349 "The I<zlib-ng> library has an option to build with a zlib-compataible API."
NSQ_SOURCE_LINE 00001350 "The c<is_zlibng_compat> function retuens true if zlib-ng has ben built with this API."
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "Finally, C<is_zlibng_native> returns true if I<zlib-ng> was built with its native API."
NSQ_SOURCE_LINE 00001353 ""
NSQ_SOURCE_LINE 00001354 "=head1 The LimitOutput option."
NSQ_SOURCE_LINE 00001355 ""
NSQ_SOURCE_LINE 00001356 "By default C<< $i->inflate($input, $output) >> will uncompress I<all> data"
NSQ_SOURCE_LINE 00001357 "in C<$input> and write I<all> of the uncompressed data it has generated to"
NSQ_SOURCE_LINE 00001358 "C<$output>. This makes the interface to C<inflate> much simpler - if the"
NSQ_SOURCE_LINE 00001359 "method has uncompressed C<$input> successfully I<all> compressed data in"
NSQ_SOURCE_LINE 00001360 "C<$input> will have been dealt with. So if you are reading from an input"
NSQ_SOURCE_LINE 00001361 "source and uncompressing as you go the code will look something like this"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "    use strict ;"
NSQ_SOURCE_LINE 00001364 "    use warnings ;"
NSQ_SOURCE_LINE 00001365 ""
NSQ_SOURCE_LINE 00001366 "    use Compress::Raw::Zlib;"
NSQ_SOURCE_LINE 00001367 ""
NSQ_SOURCE_LINE 00001368 "    my $x = new Compress::Raw::Zlib::Inflate()"
NSQ_SOURCE_LINE 00001369 "       or die \"Cannot create a inflation stream\\n\" ;"
NSQ_SOURCE_LINE 00001370 ""
NSQ_SOURCE_LINE 00001371 "    my $input = '' ;"
NSQ_SOURCE_LINE 00001372 ""
NSQ_SOURCE_LINE 00001373 "    my ($output, $status) ;"
NSQ_SOURCE_LINE 00001374 "    while (read(STDIN, $input, 4096))"
NSQ_SOURCE_LINE 00001375 "    {"
NSQ_SOURCE_LINE 00001376 "        $status = $x->inflate($input, $output) ;"
NSQ_SOURCE_LINE 00001377 ""
NSQ_SOURCE_LINE 00001378 "        print $output ;"
NSQ_SOURCE_LINE 00001379 ""
NSQ_SOURCE_LINE 00001380 "        last if $status != Z_OK ;"
NSQ_SOURCE_LINE 00001381 "    }"
NSQ_SOURCE_LINE 00001382 ""
NSQ_SOURCE_LINE 00001383 "    die \"inflation failed\\n\""
NSQ_SOURCE_LINE 00001384 "        unless $status == Z_STREAM_END ;"
NSQ_SOURCE_LINE 00001385 ""
NSQ_SOURCE_LINE 00001386 "The points to note are"
NSQ_SOURCE_LINE 00001387 ""
NSQ_SOURCE_LINE 00001388 "=over 5"
NSQ_SOURCE_LINE 00001389 ""
NSQ_SOURCE_LINE 00001390 "=item *"
NSQ_SOURCE_LINE 00001391 ""
NSQ_SOURCE_LINE 00001392 "The main processing loop in the code handles reading of compressed data"
NSQ_SOURCE_LINE 00001393 "from STDIN."
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 "=item *"
NSQ_SOURCE_LINE 00001396 ""
NSQ_SOURCE_LINE 00001397 "The status code returned from C<inflate> will only trigger termination of"
NSQ_SOURCE_LINE 00001398 "the main processing loop if it isn't C<Z_OK>. When C<LimitOutput> has not"
NSQ_SOURCE_LINE 00001399 "been used the C<Z_OK> status means that the end of the compressed"
NSQ_SOURCE_LINE 00001400 "data stream has been reached or there has been an error in uncompression."
NSQ_SOURCE_LINE 00001401 ""
NSQ_SOURCE_LINE 00001402 "=item *"
NSQ_SOURCE_LINE 00001403 ""
NSQ_SOURCE_LINE 00001404 "After the call to C<inflate> I<all> of the uncompressed data in C<$input>"
NSQ_SOURCE_LINE 00001405 "will have been processed. This means the subsequent call to C<read> can"
NSQ_SOURCE_LINE 00001406 "overwrite it's contents without any problem."
NSQ_SOURCE_LINE 00001407 ""
NSQ_SOURCE_LINE 00001408 "=back"
NSQ_SOURCE_LINE 00001409 ""
NSQ_SOURCE_LINE 00001410 "For most use-cases the behavior described above is acceptable (this module"
NSQ_SOURCE_LINE 00001411 "and it's predecessor, C<Compress::Zlib>, have used it for over 10 years"
NSQ_SOURCE_LINE 00001412 "without an issue), but in a few very specific use-cases the amount of"
NSQ_SOURCE_LINE 00001413 "memory required for C<$output> can prohibitively large. For example, if the"
NSQ_SOURCE_LINE 00001414 "compressed data stream contains the same pattern repeated thousands of"
NSQ_SOURCE_LINE 00001415 "times, a relatively small compressed data stream can uncompress into"
NSQ_SOURCE_LINE 00001416 "hundreds of megabytes.  Remember C<inflate> will keep allocating memory"
NSQ_SOURCE_LINE 00001417 "until I<all> the uncompressed data has been written to the output buffer -"
NSQ_SOURCE_LINE 00001418 "the size of C<$output> is unbounded."
NSQ_SOURCE_LINE 00001419 ""
NSQ_SOURCE_LINE 00001420 "The C<LimitOutput> option is designed to help with this use-case."
NSQ_SOURCE_LINE 00001421 ""
NSQ_SOURCE_LINE 00001422 "The main difference in your code when using C<LimitOutput> is having to"
NSQ_SOURCE_LINE 00001423 "deal with cases where the C<$input> parameter still contains some"
NSQ_SOURCE_LINE 00001424 "uncompressed data that C<inflate> hasn't processed yet. The status code"
NSQ_SOURCE_LINE 00001425 "returned from C<inflate> will be C<Z_OK> if uncompression took place and"
NSQ_SOURCE_LINE 00001426 "C<Z_BUF_ERROR> if the output buffer is full."
NSQ_SOURCE_LINE 00001427 ""
NSQ_SOURCE_LINE 00001428 "Below is typical code that shows how to use C<LimitOutput>."
NSQ_SOURCE_LINE 00001429 ""
NSQ_SOURCE_LINE 00001430 "    use strict ;"
NSQ_SOURCE_LINE 00001431 "    use warnings ;"
NSQ_SOURCE_LINE 00001432 ""
NSQ_SOURCE_LINE 00001433 "    use Compress::Raw::Zlib;"
NSQ_SOURCE_LINE 00001434 ""
NSQ_SOURCE_LINE 00001435 "    my $x = new Compress::Raw::Zlib::Inflate(LimitOutput => 1)"
NSQ_SOURCE_LINE 00001436 "       or die \"Cannot create a inflation stream\\n\" ;"
NSQ_SOURCE_LINE 00001437 ""
NSQ_SOURCE_LINE 00001438 "    my $input = '' ;"
NSQ_SOURCE_LINE 00001439 "    binmode STDIN;"
NSQ_SOURCE_LINE 00001440 "    binmode STDOUT;"
NSQ_SOURCE_LINE 00001441 ""
NSQ_SOURCE_LINE 00001442 "    my ($output, $status) ;"
NSQ_SOURCE_LINE 00001443 ""
NSQ_SOURCE_LINE 00001444 "  OUTER:"
NSQ_SOURCE_LINE 00001445 "    while (read(STDIN, $input, 4096))"
NSQ_SOURCE_LINE 00001446 "    {"
NSQ_SOURCE_LINE 00001447 "        do"
NSQ_SOURCE_LINE 00001448 "        {"
NSQ_SOURCE_LINE 00001449 "            $status = $x->inflate($input, $output) ;"
NSQ_SOURCE_LINE 00001450 ""
NSQ_SOURCE_LINE 00001451 "            print $output ;"
NSQ_SOURCE_LINE 00001452 ""
NSQ_SOURCE_LINE 00001453 "            last OUTER"
NSQ_SOURCE_LINE 00001454 "                unless $status == Z_OK || $status == Z_BUF_ERROR ;"
NSQ_SOURCE_LINE 00001455 "        }"
NSQ_SOURCE_LINE 00001456 "        while length $input;"
NSQ_SOURCE_LINE 00001457 "    }"
NSQ_SOURCE_LINE 00001458 ""
NSQ_SOURCE_LINE 00001459 "    die \"inflation failed\\n\""
NSQ_SOURCE_LINE 00001460 "        unless $status == Z_STREAM_END ;"
NSQ_SOURCE_LINE 00001461 ""
NSQ_SOURCE_LINE 00001462 "Points to note this time:"
NSQ_SOURCE_LINE 00001463 ""
NSQ_SOURCE_LINE 00001464 "=over 5"
NSQ_SOURCE_LINE 00001465 ""
NSQ_SOURCE_LINE 00001466 "=item *"
NSQ_SOURCE_LINE 00001467 ""
NSQ_SOURCE_LINE 00001468 "There are now two nested loops in the code: the outer loop for reading the"
NSQ_SOURCE_LINE 00001469 "compressed data from STDIN, as before; and the inner loop to carry out the"
NSQ_SOURCE_LINE 00001470 "uncompression."
NSQ_SOURCE_LINE 00001471 ""
NSQ_SOURCE_LINE 00001472 "=item *"
NSQ_SOURCE_LINE 00001473 ""
NSQ_SOURCE_LINE 00001474 "There are two exit points from the inner uncompression loop."
NSQ_SOURCE_LINE 00001475 ""
NSQ_SOURCE_LINE 00001476 "Firstly when C<inflate> has returned a status other than C<Z_OK> or"
NSQ_SOURCE_LINE 00001477 "C<Z_BUF_ERROR>.  This means that either the end of the compressed data"
NSQ_SOURCE_LINE 00001478 "stream has been reached (C<Z_STREAM_END>) or there is an error in the"
NSQ_SOURCE_LINE 00001479 "compressed data. In either of these cases there is no point in continuing"
NSQ_SOURCE_LINE 00001480 "with reading the compressed data, so both loops are terminated."
NSQ_SOURCE_LINE 00001481 ""
NSQ_SOURCE_LINE 00001482 "The second exit point tests if there is any data left in the input buffer,"
NSQ_SOURCE_LINE 00001483 "C<$input> - remember that the C<ConsumeInput> option is automatically"
NSQ_SOURCE_LINE 00001484 "enabled when C<LimitOutput> is used.  When the input buffer has been"
NSQ_SOURCE_LINE 00001485 "exhausted, the outer loop can run again and overwrite a now empty"
NSQ_SOURCE_LINE 00001486 "C<$input>."
NSQ_SOURCE_LINE 00001487 ""
NSQ_SOURCE_LINE 00001488 "=back"
NSQ_SOURCE_LINE 00001489 ""
NSQ_SOURCE_LINE 00001490 "=head1 ACCESSING ZIP FILES"
NSQ_SOURCE_LINE 00001491 ""
NSQ_SOURCE_LINE 00001492 "Although it is possible (with some effort on your part) to use this module"
NSQ_SOURCE_LINE 00001493 "to access .zip files, there are other perl modules available that will do"
NSQ_SOURCE_LINE 00001494 "all the hard work for you. Check out C<Archive::Zip>,"
NSQ_SOURCE_LINE 00001495 "C<Archive::Zip::SimpleZip>, C<IO::Compress::Zip> and"
NSQ_SOURCE_LINE 00001496 "C<IO::Uncompress::Unzip>."
NSQ_SOURCE_LINE 00001497 ""
NSQ_SOURCE_LINE 00001498 "=head1 FAQ"
NSQ_SOURCE_LINE 00001499 ""
NSQ_SOURCE_LINE 00001500 "=head2 Compatibility with Unix compress/uncompress."
NSQ_SOURCE_LINE 00001501 ""
NSQ_SOURCE_LINE 00001502 "This module is not compatible with Unix C<compress>."
NSQ_SOURCE_LINE 00001503 ""
NSQ_SOURCE_LINE 00001504 "If you have the C<uncompress> program available, you can use this to read"
NSQ_SOURCE_LINE 00001505 "compressed files"
NSQ_SOURCE_LINE 00001506 ""
NSQ_SOURCE_LINE 00001507 "    open F, \"uncompress -c $filename |\";"
NSQ_SOURCE_LINE 00001508 "    while (<F>)"
NSQ_SOURCE_LINE 00001509 "    {"
NSQ_SOURCE_LINE 00001510 "        ..."
NSQ_SOURCE_LINE 00001511 ""
NSQ_SOURCE_LINE 00001512 "Alternatively, if you have the C<gunzip> program available, you can use"
NSQ_SOURCE_LINE 00001513 "this to read compressed files"
NSQ_SOURCE_LINE 00001514 ""
NSQ_SOURCE_LINE 00001515 "    open F, \"gunzip -c $filename |\";"
NSQ_SOURCE_LINE 00001516 "    while (<F>)"
NSQ_SOURCE_LINE 00001517 "    {"
NSQ_SOURCE_LINE 00001518 "        ..."
NSQ_SOURCE_LINE 00001519 ""
NSQ_SOURCE_LINE 00001520 "and this to write compress files, if you have the C<compress> program"
NSQ_SOURCE_LINE 00001521 "available"
NSQ_SOURCE_LINE 00001522 ""
NSQ_SOURCE_LINE 00001523 "    open F, \"| compress -c $filename \";"
NSQ_SOURCE_LINE 00001524 "    print F \"data\";"
NSQ_SOURCE_LINE 00001525 "    ..."
NSQ_SOURCE_LINE 00001526 "    close F ;"
NSQ_SOURCE_LINE 00001527 ""
NSQ_SOURCE_LINE 00001528 "=head2 Accessing .tar.Z files"
NSQ_SOURCE_LINE 00001529 ""
NSQ_SOURCE_LINE 00001530 "See previous FAQ item."
NSQ_SOURCE_LINE 00001531 ""
NSQ_SOURCE_LINE 00001532 "If the C<Archive::Tar> module is installed and either the C<uncompress> or"
NSQ_SOURCE_LINE 00001533 "C<gunzip> programs are available, you can use one of these workarounds to"
NSQ_SOURCE_LINE 00001534 "read C<.tar.Z> files."
NSQ_SOURCE_LINE 00001535 ""
NSQ_SOURCE_LINE 00001536 "Firstly with C<uncompress>"
NSQ_SOURCE_LINE 00001537 ""
NSQ_SOURCE_LINE 00001538 "    use strict;"
NSQ_SOURCE_LINE 00001539 "    use warnings;"
NSQ_SOURCE_LINE 00001540 "    use Archive::Tar;"
NSQ_SOURCE_LINE 00001541 ""
NSQ_SOURCE_LINE 00001542 "    open F, \"uncompress -c $filename |\";"
NSQ_SOURCE_LINE 00001543 "    my $tar = Archive::Tar->new(*F);"
NSQ_SOURCE_LINE 00001544 "    ..."
NSQ_SOURCE_LINE 00001545 ""
NSQ_SOURCE_LINE 00001546 "and this with C<gunzip>"
NSQ_SOURCE_LINE 00001547 ""
NSQ_SOURCE_LINE 00001548 "    use strict;"
NSQ_SOURCE_LINE 00001549 "    use warnings;"
NSQ_SOURCE_LINE 00001550 "    use Archive::Tar;"
NSQ_SOURCE_LINE 00001551 ""
NSQ_SOURCE_LINE 00001552 "    open F, \"gunzip -c $filename |\";"
NSQ_SOURCE_LINE 00001553 "    my $tar = Archive::Tar->new(*F);"
NSQ_SOURCE_LINE 00001554 "    ..."
NSQ_SOURCE_LINE 00001555 ""
NSQ_SOURCE_LINE 00001556 "Similarly, if the C<compress> program is available, you can use this to"
NSQ_SOURCE_LINE 00001557 "write a C<.tar.Z> file"
NSQ_SOURCE_LINE 00001558 ""
NSQ_SOURCE_LINE 00001559 "    use strict;"
NSQ_SOURCE_LINE 00001560 "    use warnings;"
NSQ_SOURCE_LINE 00001561 "    use Archive::Tar;"
NSQ_SOURCE_LINE 00001562 "    use IO::File;"
NSQ_SOURCE_LINE 00001563 ""
NSQ_SOURCE_LINE 00001564 "    my $fh = new IO::File \"| compress -c >$filename\";"
NSQ_SOURCE_LINE 00001565 "    my $tar = Archive::Tar->new();"
NSQ_SOURCE_LINE 00001566 "    ..."
NSQ_SOURCE_LINE 00001567 "    $tar->write($fh);"
NSQ_SOURCE_LINE 00001568 "    $fh->close ;"
NSQ_SOURCE_LINE 00001569 ""
NSQ_SOURCE_LINE 00001570 "=head2 Zlib Library Version Support"
NSQ_SOURCE_LINE 00001571 ""
NSQ_SOURCE_LINE 00001572 "By default C<Compress::Raw::Zlib> will build with a private copy of version"
NSQ_SOURCE_LINE 00001573 "1.2.5 of the zlib library. (See the F<README> file for details of"
NSQ_SOURCE_LINE 00001574 "how to override this behaviour)"
NSQ_SOURCE_LINE 00001575 ""
NSQ_SOURCE_LINE 00001576 "If you decide to use a different version of the zlib library, you need to be"
NSQ_SOURCE_LINE 00001577 "aware of the following issues"
NSQ_SOURCE_LINE 00001578 ""
NSQ_SOURCE_LINE 00001579 "=over 5"
NSQ_SOURCE_LINE 00001580 ""
NSQ_SOURCE_LINE 00001581 "=item *"
NSQ_SOURCE_LINE 00001582 ""
NSQ_SOURCE_LINE 00001583 "First off, you must have zlib 1.0.5 or better."
NSQ_SOURCE_LINE 00001584 ""
NSQ_SOURCE_LINE 00001585 "=item *"
NSQ_SOURCE_LINE 00001586 ""
NSQ_SOURCE_LINE 00001587 "You need to have zlib 1.2.1 or better if you want to use the C<-Merge>"
NSQ_SOURCE_LINE 00001588 "option with C<IO::Compress::Gzip>, C<IO::Compress::Deflate> and"
NSQ_SOURCE_LINE 00001589 "C<IO::Compress::RawDeflate>."
NSQ_SOURCE_LINE 00001590 ""
NSQ_SOURCE_LINE 00001591 "=back"
NSQ_SOURCE_LINE 00001592 ""
NSQ_SOURCE_LINE 00001593 "=head1 CONSTANTS"
NSQ_SOURCE_LINE 00001594 ""
NSQ_SOURCE_LINE 00001595 "All the I<zlib> constants are automatically imported when you make use"
NSQ_SOURCE_LINE 00001596 "of I<Compress::Raw::Zlib>."
NSQ_SOURCE_LINE 00001597 ""
NSQ_SOURCE_LINE 00001598 "=head1 SUPPORT"
