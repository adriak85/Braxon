NSQ_SOURCE_LINE 00000001 "use v5.8.0;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "package Sub::Install;"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: install subroutines into packages easily"
NSQ_SOURCE_LINE 00000006 "$Sub::Install::VERSION = '0.929';"
NSQ_SOURCE_LINE 00000007 "use Carp;"
NSQ_SOURCE_LINE 00000008 "use Scalar::Util ();"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "#pod =head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000011 "#pod"
NSQ_SOURCE_LINE 00000012 "#pod   use Sub::Install;"
NSQ_SOURCE_LINE 00000013 "#pod"
NSQ_SOURCE_LINE 00000014 "#pod   Sub::Install::install_sub({"
NSQ_SOURCE_LINE 00000015 "#pod     code => sub { ... },"
NSQ_SOURCE_LINE 00000016 "#pod     into => $package,"
NSQ_SOURCE_LINE 00000017 "#pod     as   => $subname"
NSQ_SOURCE_LINE 00000018 "#pod   });"
NSQ_SOURCE_LINE 00000019 "#pod"
NSQ_SOURCE_LINE 00000020 "#pod =head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000021 "#pod"
NSQ_SOURCE_LINE 00000022 "#pod This module makes it easy to install subroutines into packages without the"
NSQ_SOURCE_LINE 00000023 "#pod unsightly mess of C<no strict> or typeglobs lying about where just anyone can"
NSQ_SOURCE_LINE 00000024 "#pod see them."
NSQ_SOURCE_LINE 00000025 "#pod"
NSQ_SOURCE_LINE 00000026 "#pod =func install_sub"
NSQ_SOURCE_LINE 00000027 "#pod"
NSQ_SOURCE_LINE 00000028 "#pod   Sub::Install::install_sub({"
NSQ_SOURCE_LINE 00000029 "#pod    code => \\&subroutine,"
NSQ_SOURCE_LINE 00000030 "#pod    into => \"Finance::Shady\","
NSQ_SOURCE_LINE 00000031 "#pod    as   => 'launder',"
NSQ_SOURCE_LINE 00000032 "#pod   });"
NSQ_SOURCE_LINE 00000033 "#pod"
NSQ_SOURCE_LINE 00000034 "#pod This routine installs a given code reference into a package as a normal"
NSQ_SOURCE_LINE 00000035 "#pod subroutine.  The above is equivalent to:"
NSQ_SOURCE_LINE 00000036 "#pod"
NSQ_SOURCE_LINE 00000037 "#pod   no strict 'refs';"
NSQ_SOURCE_LINE 00000038 "#pod   *{\"Finance::Shady\" . '::' . \"launder\"} = \\&subroutine;"
NSQ_SOURCE_LINE 00000039 "#pod"
NSQ_SOURCE_LINE 00000040 "#pod If C<into> is not given, the sub is installed into the calling package."
NSQ_SOURCE_LINE 00000041 "#pod"
NSQ_SOURCE_LINE 00000042 "#pod If C<code> is not a code reference, it is looked for as an existing sub in the"
NSQ_SOURCE_LINE 00000043 "#pod package named in the C<from> parameter.  If C<from> is not given, it will look"
NSQ_SOURCE_LINE 00000044 "#pod in the calling package."
NSQ_SOURCE_LINE 00000045 "#pod"
NSQ_SOURCE_LINE 00000046 "#pod If C<as> is not given, and if C<code> is a name, C<as> will default to C<code>."
NSQ_SOURCE_LINE 00000047 "#pod If C<as> is not given, but if C<code> is a code ref, Sub::Install will try to"
NSQ_SOURCE_LINE 00000048 "#pod find the name of the given code ref and use that as C<as>."
NSQ_SOURCE_LINE 00000049 "#pod"
NSQ_SOURCE_LINE 00000050 "#pod That means that this code:"
NSQ_SOURCE_LINE 00000051 "#pod"
NSQ_SOURCE_LINE 00000052 "#pod   Sub::Install::install_sub({"
NSQ_SOURCE_LINE 00000053 "#pod     code => 'twitch',"
NSQ_SOURCE_LINE 00000054 "#pod     from => 'Person::InPain',"
NSQ_SOURCE_LINE 00000055 "#pod     into => 'Person::Teenager',"
NSQ_SOURCE_LINE 00000056 "#pod     as   => 'dance',"
NSQ_SOURCE_LINE 00000057 "#pod   });"
NSQ_SOURCE_LINE 00000058 "#pod"
NSQ_SOURCE_LINE 00000059 "#pod is the same as:"
NSQ_SOURCE_LINE 00000060 "#pod"
NSQ_SOURCE_LINE 00000061 "#pod   package Person::Teenager;"
NSQ_SOURCE_LINE 00000062 "#pod"
NSQ_SOURCE_LINE 00000063 "#pod   Sub::Install::install_sub({"
NSQ_SOURCE_LINE 00000064 "#pod     code => Person::InPain->can('twitch'),"
NSQ_SOURCE_LINE 00000065 "#pod     as   => 'dance',"
NSQ_SOURCE_LINE 00000066 "#pod   });"
NSQ_SOURCE_LINE 00000067 "#pod"
NSQ_SOURCE_LINE 00000068 "#pod =func reinstall_sub"
NSQ_SOURCE_LINE 00000069 "#pod"
NSQ_SOURCE_LINE 00000070 "#pod This routine behaves exactly like C<L</install_sub>>, but does not emit a"
NSQ_SOURCE_LINE 00000071 "#pod warning if warnings are on and the destination is already defined."
NSQ_SOURCE_LINE 00000072 "#pod"
NSQ_SOURCE_LINE 00000073 "#pod =cut"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "sub _name_of_code {"
NSQ_SOURCE_LINE 00000076 "  my ($code) = @_;"
NSQ_SOURCE_LINE 00000077 "  require B;"
NSQ_SOURCE_LINE 00000078 "  my $name = B::svref_2object($code)->GV->NAME;"
NSQ_SOURCE_LINE 00000079 "  return $name unless $name =~ /\\A__ANON__/;"
NSQ_SOURCE_LINE 00000080 "  return;"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "# See also Params::Util, to which this code was donated."
NSQ_SOURCE_LINE 00000084 "sub _CODELIKE {"
NSQ_SOURCE_LINE 00000085 "  (Scalar::Util::reftype($_[0])||'') eq 'CODE'"
NSQ_SOURCE_LINE 00000086 "  || Scalar::Util::blessed($_[0])"
NSQ_SOURCE_LINE 00000087 "  && (overload::Method($_[0],'&{}') ? $_[0] : undef);"
NSQ_SOURCE_LINE 00000088 "}"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "# do the heavy lifting"
NSQ_SOURCE_LINE 00000091 "sub _build_public_installer {"
NSQ_SOURCE_LINE 00000092 "  my ($installer) = @_;"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "  sub {"
NSQ_SOURCE_LINE 00000095 "    my ($arg) = @_;"
NSQ_SOURCE_LINE 00000096 "    my ($calling_pkg) = caller(0);"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    # I'd rather use ||= but I'm whoring for Devel::Cover."
NSQ_SOURCE_LINE 00000099 "    for (qw(into from)) { $arg->{$_} = $calling_pkg unless $arg->{$_} }"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    # This is the only absolutely required argument, in many cases."
NSQ_SOURCE_LINE 00000102 "    Carp::croak \"named argument 'code' is not optional\" unless $arg->{code};"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    if (_CODELIKE($arg->{code})) {"
NSQ_SOURCE_LINE 00000105 "      $arg->{as} ||= _name_of_code($arg->{code});"
NSQ_SOURCE_LINE 00000106 "    } else {"
NSQ_SOURCE_LINE 00000107 "      Carp::croak"
NSQ_SOURCE_LINE 00000108 "        \"couldn't find subroutine named $arg->{code} in package $arg->{from}\""
NSQ_SOURCE_LINE 00000109 "        unless my $code = $arg->{from}->can($arg->{code});"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "      $arg->{as}   = $arg->{code} unless $arg->{as};"
NSQ_SOURCE_LINE 00000112 "      $arg->{code} = $code;"
NSQ_SOURCE_LINE 00000113 "    }"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    Carp::croak \"couldn't determine name under which to install subroutine\""
NSQ_SOURCE_LINE 00000116 "      unless $arg->{as};"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    $installer->(@$arg{qw(into as code) });"
NSQ_SOURCE_LINE 00000119 "  }"
NSQ_SOURCE_LINE 00000120 "}"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "# do the ugly work"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "my $_misc_warn_re;"
NSQ_SOURCE_LINE 00000125 "my $_redef_warn_re;"
NSQ_SOURCE_LINE 00000126 "BEGIN {"
NSQ_SOURCE_LINE 00000127 "  $_misc_warn_re = qr/"
NSQ_SOURCE_LINE 00000128 "    Prototype\\ mismatch:\\ sub\\ .+?  |"
NSQ_SOURCE_LINE 00000129 "    Constant subroutine .+? redefined"
NSQ_SOURCE_LINE 00000130 "  /x;"
NSQ_SOURCE_LINE 00000131 "  $_redef_warn_re = qr/Subroutine\\ .+?\\ redefined/x;"
NSQ_SOURCE_LINE 00000132 "}"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "my $eow_re;"
NSQ_SOURCE_LINE 00000135 "BEGIN { $eow_re = qr/ at .+? line \\d+\\.\\Z/ };"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "sub _do_with_warn {"
NSQ_SOURCE_LINE 00000138 "  my ($arg) = @_;"
NSQ_SOURCE_LINE 00000139 "  my $code = delete $arg->{code};"
NSQ_SOURCE_LINE 00000140 "  my $wants_code = sub {"
NSQ_SOURCE_LINE 00000141 "    my $code = shift;"
NSQ_SOURCE_LINE 00000142 "    sub {"
NSQ_SOURCE_LINE 00000143 "      my $warn = $SIG{__WARN__} ? $SIG{__WARN__} : sub { warn @_ }; ## no critic"
NSQ_SOURCE_LINE 00000144 "      local $SIG{__WARN__} = sub {"
NSQ_SOURCE_LINE 00000145 "        my ($error) = @_;"
NSQ_SOURCE_LINE 00000146 "        for (@{ $arg->{suppress} }) {"
NSQ_SOURCE_LINE 00000147 "            return if $error =~ $_;"
NSQ_SOURCE_LINE 00000148 "        }"
NSQ_SOURCE_LINE 00000149 "        for (@{ $arg->{croak} }) {"
NSQ_SOURCE_LINE 00000150 "          if (my ($base_error) = $error =~ /\\A($_) $eow_re/x) {"
NSQ_SOURCE_LINE 00000151 "            Carp::croak $base_error;"
NSQ_SOURCE_LINE 00000152 "          }"
NSQ_SOURCE_LINE 00000153 "        }"
NSQ_SOURCE_LINE 00000154 "        for (@{ $arg->{carp} }) {"
NSQ_SOURCE_LINE 00000155 "          if (my ($base_error) = $error =~ /\\A($_) $eow_re/x) {"
NSQ_SOURCE_LINE 00000156 "            return $warn->(Carp::shortmess $base_error);"
NSQ_SOURCE_LINE 00000157 "          }"
NSQ_SOURCE_LINE 00000158 "        }"
NSQ_SOURCE_LINE 00000159 "        ($arg->{default} || $warn)->($error);"
NSQ_SOURCE_LINE 00000160 "      };"
NSQ_SOURCE_LINE 00000161 "      $code->(@_);"
NSQ_SOURCE_LINE 00000162 "    };"
NSQ_SOURCE_LINE 00000163 "  };"
NSQ_SOURCE_LINE 00000164 "  return $wants_code->($code) if $code;"
NSQ_SOURCE_LINE 00000165 "  return $wants_code;"
NSQ_SOURCE_LINE 00000166 "}"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "sub _installer {"
NSQ_SOURCE_LINE 00000169 "  sub {"
NSQ_SOURCE_LINE 00000170 "    my ($pkg, $name, $code) = @_;"
NSQ_SOURCE_LINE 00000171 "    no strict 'refs'; ## no critic ProhibitNoStrict"
NSQ_SOURCE_LINE 00000172 "    *{\"$pkg\\::$name\"} = $code;"
NSQ_SOURCE_LINE 00000173 "    return $code;"
NSQ_SOURCE_LINE 00000174 "  }"
NSQ_SOURCE_LINE 00000175 "}"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "BEGIN {"
NSQ_SOURCE_LINE 00000178 "  *_ignore_warnings = _do_with_warn({"
NSQ_SOURCE_LINE 00000179 "    carp => [ $_misc_warn_re, $_redef_warn_re ]"
NSQ_SOURCE_LINE 00000180 "  });"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "  *install_sub = _build_public_installer(_ignore_warnings(_installer));"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "  *_carp_warnings =  _do_with_warn({"
NSQ_SOURCE_LINE 00000185 "    carp     => [ $_misc_warn_re ],"
NSQ_SOURCE_LINE 00000186 "    suppress => [ $_redef_warn_re ],"
NSQ_SOURCE_LINE 00000187 "  });"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "  *reinstall_sub = _build_public_installer(_carp_warnings(_installer));"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "  *_install_fatal = _do_with_warn({"
NSQ_SOURCE_LINE 00000192 "    code     => _installer,"
NSQ_SOURCE_LINE 00000193 "    croak    => [ $_redef_warn_re ],"
NSQ_SOURCE_LINE 00000194 "  });"
NSQ_SOURCE_LINE 00000195 "}"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "#pod =func install_installers"
NSQ_SOURCE_LINE 00000198 "#pod"
NSQ_SOURCE_LINE 00000199 "#pod This routine is provided to allow Sub::Install compatibility with"
NSQ_SOURCE_LINE 00000200 "#pod Sub::Installer.  It installs C<install_sub> and C<reinstall_sub> methods into"
NSQ_SOURCE_LINE 00000201 "#pod the package named by its argument."
NSQ_SOURCE_LINE 00000202 "#pod"
NSQ_SOURCE_LINE 00000203 "#pod  Sub::Install::install_installers('Code::Builder'); # just for us, please"
NSQ_SOURCE_LINE 00000204 "#pod  Code::Builder->install_sub({ name => $code_ref });"
NSQ_SOURCE_LINE 00000205 "#pod"
NSQ_SOURCE_LINE 00000206 "#pod  Sub::Install::install_installers('UNIVERSAL'); # feeling lucky, punk?"
NSQ_SOURCE_LINE 00000207 "#pod  Anything::At::All->install_sub({ name => $code_ref });"
NSQ_SOURCE_LINE 00000208 "#pod"
NSQ_SOURCE_LINE 00000209 "#pod The installed installers are similar, but not identical, to those provided by"
NSQ_SOURCE_LINE 00000210 "#pod Sub::Installer.  They accept a single hash as an argument.  The key/value pairs"
NSQ_SOURCE_LINE 00000211 "#pod are used as the C<as> and C<code> parameters to the C<install_sub> routine"
NSQ_SOURCE_LINE 00000212 "#pod detailed above.  The package name on which the method is called is used as the"
NSQ_SOURCE_LINE 00000213 "#pod C<into> parameter."
NSQ_SOURCE_LINE 00000214 "#pod"
NSQ_SOURCE_LINE 00000215 "#pod Unlike Sub::Installer's C<install_sub> will not eval strings into code, but"
NSQ_SOURCE_LINE 00000216 "#pod will look for named code in the calling package."
NSQ_SOURCE_LINE 00000217 "#pod"
NSQ_SOURCE_LINE 00000218 "#pod =cut"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "sub install_installers {"
NSQ_SOURCE_LINE 00000221 "  my ($into) = @_;"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "  for my $method (qw(install_sub reinstall_sub)) {"
NSQ_SOURCE_LINE 00000224 "    my $code = sub {"
NSQ_SOURCE_LINE 00000225 "      my ($package, $subs) = @_;"
NSQ_SOURCE_LINE 00000226 "      my ($caller) = caller(0);"
NSQ_SOURCE_LINE 00000227 "      my $return;"
NSQ_SOURCE_LINE 00000228 "      for (my ($name, $sub) = %$subs) {"
NSQ_SOURCE_LINE 00000229 "        $return = Sub::Install->can($method)->({"
NSQ_SOURCE_LINE 00000230 "          code => $sub,"
NSQ_SOURCE_LINE 00000231 "          from => $caller,"
NSQ_SOURCE_LINE 00000232 "          into => $package,"
NSQ_SOURCE_LINE 00000233 "          as   => $name"
NSQ_SOURCE_LINE 00000234 "        });"
NSQ_SOURCE_LINE 00000235 "      }"
NSQ_SOURCE_LINE 00000236 "      return $return;"
NSQ_SOURCE_LINE 00000237 "    };"
NSQ_SOURCE_LINE 00000238 "    install_sub({ code => $code, into => $into, as => $method });"
NSQ_SOURCE_LINE 00000239 "  }"
NSQ_SOURCE_LINE 00000240 "}"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "#pod =head1 EXPORTS"
NSQ_SOURCE_LINE 00000243 "#pod"
NSQ_SOURCE_LINE 00000244 "#pod Sub::Install exports C<install_sub> and C<reinstall_sub> only if they are"
NSQ_SOURCE_LINE 00000245 "#pod requested."
NSQ_SOURCE_LINE 00000246 "#pod"
NSQ_SOURCE_LINE 00000247 "#pod =head2 exporter"
NSQ_SOURCE_LINE 00000248 "#pod"
NSQ_SOURCE_LINE 00000249 "#pod Sub::Install has a never-exported subroutine called C<exporter>, which is used"
NSQ_SOURCE_LINE 00000250 "#pod to implement its C<import> routine.  It takes a hashref of named arguments,"
NSQ_SOURCE_LINE 00000251 "#pod only one of which is currently recognize: C<exports>.  This must be an arrayref"
NSQ_SOURCE_LINE 00000252 "#pod of subroutines to offer for export."
NSQ_SOURCE_LINE 00000253 "#pod"
NSQ_SOURCE_LINE 00000254 "#pod This routine is mainly for Sub::Install's own consumption.  Instead, consider"
NSQ_SOURCE_LINE 00000255 "#pod L<Sub::Exporter>."
NSQ_SOURCE_LINE 00000256 "#pod"
NSQ_SOURCE_LINE 00000257 "#pod =cut"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "sub exporter {"
NSQ_SOURCE_LINE 00000260 "  my ($arg) = @_;"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "  my %is_exported = map { $_ => undef } @{ $arg->{exports} };"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "  sub {"
NSQ_SOURCE_LINE 00000265 "    my $class = shift;"
NSQ_SOURCE_LINE 00000266 "    my $target = caller;"
NSQ_SOURCE_LINE 00000267 "    for (@_) {"
NSQ_SOURCE_LINE 00000268 "      Carp::croak \"'$_' is not exported by $class\" if !exists $is_exported{$_};"
NSQ_SOURCE_LINE 00000269 "      install_sub({ code => $_, from => $class, into => $target });"
NSQ_SOURCE_LINE 00000270 "    }"
NSQ_SOURCE_LINE 00000271 "  }"
NSQ_SOURCE_LINE 00000272 "}"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "BEGIN { *import = exporter({ exports => [ qw(install_sub reinstall_sub) ] }); }"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "#pod =head1 SEE ALSO"
NSQ_SOURCE_LINE 00000277 "#pod"
NSQ_SOURCE_LINE 00000278 "#pod =over"
NSQ_SOURCE_LINE 00000279 "#pod"
NSQ_SOURCE_LINE 00000280 "#pod =item L<Sub::Installer>"
NSQ_SOURCE_LINE 00000281 "#pod"
NSQ_SOURCE_LINE 00000282 "#pod This module is (obviously) a reaction to Damian Conway's Sub::Installer, which"
NSQ_SOURCE_LINE 00000283 "#pod does the same thing, but does it by getting its greasy fingers all over"
NSQ_SOURCE_LINE 00000284 "#pod UNIVERSAL.  I was really happy about the idea of making the installation of"
NSQ_SOURCE_LINE 00000285 "#pod coderefs less ugly, but I couldn't bring myself to replace the ugliness of"
NSQ_SOURCE_LINE 00000286 "#pod typeglobs and loosened strictures with the ugliness of UNIVERSAL methods."
NSQ_SOURCE_LINE 00000287 "#pod"
NSQ_SOURCE_LINE 00000288 "#pod =item L<Sub::Exporter>"
NSQ_SOURCE_LINE 00000289 "#pod"
NSQ_SOURCE_LINE 00000290 "#pod This is a complete Exporter.pm replacement, built atop Sub::Install."
NSQ_SOURCE_LINE 00000291 "#pod"
NSQ_SOURCE_LINE 00000292 "#pod =back"
NSQ_SOURCE_LINE 00000293 "#pod"
NSQ_SOURCE_LINE 00000294 "#pod =head1 EXTRA CREDITS"
NSQ_SOURCE_LINE 00000295 "#pod"
NSQ_SOURCE_LINE 00000296 "#pod Several of the tests are adapted from tests that shipped with Damian Conway's"
NSQ_SOURCE_LINE 00000297 "#pod Sub-Installer distribution."
NSQ_SOURCE_LINE 00000298 "#pod"
NSQ_SOURCE_LINE 00000299 "#pod =cut"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "1;"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "__END__"
