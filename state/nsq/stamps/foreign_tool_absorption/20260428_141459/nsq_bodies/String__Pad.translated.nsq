BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package String::Pad;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2021-08-01'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'String-Pad'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.021'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Exporter;"
NSQ_SOURCE_LINE 00000013 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000015 "                       pad"
NSQ_SOURCE_LINE 00000016 "               );"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub pad {"
NSQ_SOURCE_LINE 00000019 "    my ($text0, $width, $which, $padchar, $is_trunc) = @_;"
NSQ_SOURCE_LINE 00000020 "    if ($which) {"
NSQ_SOURCE_LINE 00000021 "        $which = substr($which, 0, 1);"
NSQ_SOURCE_LINE 00000022 "    } else {"
NSQ_SOURCE_LINE 00000023 "        $which = \"r\";"
NSQ_SOURCE_LINE 00000024 "    }"
NSQ_SOURCE_LINE 00000025 "    $padchar //= \" \";"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    my $texts = ref $text0 eq 'ARRAY' ? [@$text0] : [$text0];"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    if (!defined($width) || $width < 0) {"
NSQ_SOURCE_LINE 00000030 "        my $longest = 0;"
NSQ_SOURCE_LINE 00000031 "        for (@$texts) {"
NSQ_SOURCE_LINE 00000032 "            my $len = length($_);"
NSQ_SOURCE_LINE 00000033 "            $longest = $len if $longest < $len;"
NSQ_SOURCE_LINE 00000034 "        }"
NSQ_SOURCE_LINE 00000035 "        $width = $longest;"
NSQ_SOURCE_LINE 00000036 "    }"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    for my $text (@$texts) {"
NSQ_SOURCE_LINE 00000039 "        my $w = length($text);"
NSQ_SOURCE_LINE 00000040 "        if ($is_trunc && $w > $width) {"
NSQ_SOURCE_LINE 00000041 "            $text = substr($text, 0, $width, 1);"
NSQ_SOURCE_LINE 00000042 "            $w = $width;"
NSQ_SOURCE_LINE 00000043 "        } else {"
NSQ_SOURCE_LINE 00000044 "            if ($which eq 'l') {"
NSQ_SOURCE_LINE 00000045 "                no warnings; # negative repeat count"
NSQ_SOURCE_LINE 00000046 "                $text = ($padchar x ($width-$w)) . $text;"
NSQ_SOURCE_LINE 00000047 "            } elsif ($which eq 'c') {"
NSQ_SOURCE_LINE 00000048 "                my $n = int(($width-$w)/2);"
NSQ_SOURCE_LINE 00000049 "                $text = ($padchar x $n) . $text . ($padchar x ($width-$w-$n));"
NSQ_SOURCE_LINE 00000050 "            } else {"
NSQ_SOURCE_LINE 00000051 "                no warnings; # negative repeat count"
NSQ_SOURCE_LINE 00000052 "                $text .= ($padchar x ($width-$w));"
NSQ_SOURCE_LINE 00000053 "            }"
NSQ_SOURCE_LINE 00000054 "        }"
NSQ_SOURCE_LINE 00000055 "    } # for $text"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    ref $text0 eq 'ARRAY' ? $texts : $texts->[0];"
NSQ_SOURCE_LINE 00000058 "}"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "1;"
NSQ_SOURCE_LINE 00000061 "# ABSTRACT: String padding routines"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "__END__"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "=pod"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "=head1 NAME"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "String::Pad - String padding routines"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=head1 VERSION"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "This document describes version 0.021 of String::Pad (from Perl distribution String-Pad), released on 2021-08-01."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 " use String::Pad qw(pad);"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 " my $res;"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 " # pad a single string"
NSQ_SOURCE_LINE 00000084 " $res = pad(\"foo\", 5);           # => \"foo  \"  # default $which is 'right' or 'r'"
NSQ_SOURCE_LINE 00000085 " $res = pad(\"foo\", 5, \"left\");   # => \"  foo\"  # left padding, which means to be 'right-justified'"
NSQ_SOURCE_LINE 00000086 " $res = pad(\"foo\", 5, \"l\");      # => \"  foo\"  # 'l' is same thing as 'left'"
NSQ_SOURCE_LINE 00000087 " $res = pad(\"foo\", 5, \"c\");      # => \" foo \"  # 'center' ('c') padding"
NSQ_SOURCE_LINE 00000088 " $res = pad(\"foo\", 5, \"c\", \"x\"); # => \"xfoox\"  # pad with a custom character"
NSQ_SOURCE_LINE 00000089 " $res = pad(\"foo\", 5, \"c\", \"x\"); # => \"xfoox\"  # pad with a custom character"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 " $res = pad(\"foobar\", 5, 'r', undef, 'truncate'); # => \"fooba\""
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 " # pad multiple strings"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head2 pad"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "Usage:"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 " $res = pad($text | \\@texts, $width [, $which [, $padchar=' ' [, $truncate=0] ] ] ); # => str or arrayref"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "Return C<$text> padded with C<$padchar> to C<$width> columns. Can accept"
NSQ_SOURCE_LINE 00000104 "multiple texts (C<\\@texts>); in which case will return a new arrayref of padded"
NSQ_SOURCE_LINE 00000105 "texts."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "C<$width> can be undef or -1 if you supply multiple texts, in which case the"
NSQ_SOURCE_LINE 00000108 "width will be determined from the longest text."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "C<$which> is either \"r\" or \"right\" for padding on the right (the default if not"
NSQ_SOURCE_LINE 00000111 "specified), \"l\" or \"left\" for padding on the right, or \"c\" or \"center\" or"
NSQ_SOURCE_LINE 00000112 "\"centre\" for left+right padding to center the text. Note that \"r\" will mean"
NSQ_SOURCE_LINE 00000113 "\"left justified\", while \"l\" will mean \"right justified\"."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "C<$padchar> is whitespace if not specified. It should be string having the width"
NSQ_SOURCE_LINE 00000116 "of 1 column."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "C<$truncate> is boolean. When set to 1, then text will be truncated when it is"
NSQ_SOURCE_LINE 00000119 "longer than C<$width>."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "Please visit the project's homepage at L<https://metacpan.org/release/String-Pad>."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "Source repository is at L<https://github.com/perlancar/perl-String-Pad>."
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "=head1 BUGS"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=String-Pad>"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000134 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000135 "feature."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "Other string padding modules: L<Text::Padding>, L<Text::WideChar::Util> (for"
NSQ_SOURCE_LINE 00000140 "strings that contain wide Unicode characters), L<Text::ANSI::Util> (for strings"
NSQ_SOURCE_LINE 00000141 "that contain ANSI color codes), L<Text::ANSIWide::Util> (for strings that"
NSQ_SOURCE_LINE 00000142 "contain both ANSI color codes and wide Unicode characters)."
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "Other alignment modules: L<Number::Pad> (for padding numbers so that the decimal"
NSQ_SOURCE_LINE 00000145 "points align)."
NSQ_SOURCE_LINE 00000146 ""
