NSQ_SOURCE_LINE 00000001 "package B::COW;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "# ABSTRACT: B::COW additional B helpers to check COW status"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $VERSION = '0.007'; # VERSION: generated by DZP::OurPkgVersion"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use XSLoader;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "XSLoader::load(__PACKAGE__);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "my @all_export = qw{ can_cow is_cow cowrefcnt cowrefcnt_max };"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "our @EXPORT_OK = ("
NSQ_SOURCE_LINE 00000019 "    @all_export,"
NSQ_SOURCE_LINE 00000020 ");"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000023 "    all => [@all_export],"
NSQ_SOURCE_LINE 00000024 ");"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "1;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "__END__"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "=pod"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=encoding utf-8"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "=head1 NAME"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "B::COW - B::COW additional B helpers to check COW status"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=head1 VERSION"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "version 0.007"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 " #!perl"
NSQ_SOURCE_LINE 00000046 " "
NSQ_SOURCE_LINE 00000047 " use strict;"
NSQ_SOURCE_LINE 00000048 " use warnings;"
NSQ_SOURCE_LINE 00000049 " "
NSQ_SOURCE_LINE 00000050 " use Test::More;    # just used for illustration purpose"
NSQ_SOURCE_LINE 00000051 " "
NSQ_SOURCE_LINE 00000052 " use B::COW qw{:all};"
NSQ_SOURCE_LINE 00000053 " "
NSQ_SOURCE_LINE 00000054 " if ( can_cow() ) {    # $] >= 5.020"
NSQ_SOURCE_LINE 00000055 "     ok !is_cow(undef);"
NSQ_SOURCE_LINE 00000056 " "
NSQ_SOURCE_LINE 00000057 "     my $str = \"abcdef\";"
NSQ_SOURCE_LINE 00000058 "     ok is_cow($str);"
NSQ_SOURCE_LINE 00000059 "     is cowrefcnt($str), 1;"
NSQ_SOURCE_LINE 00000060 " "
NSQ_SOURCE_LINE 00000061 "     my @a;"
NSQ_SOURCE_LINE 00000062 "     push @a, $str for 1 .. 100;"
NSQ_SOURCE_LINE 00000063 " "
NSQ_SOURCE_LINE 00000064 "     ok is_cow($str);"
NSQ_SOURCE_LINE 00000065 "     ok is_cow( $a[0] );"
NSQ_SOURCE_LINE 00000066 "     ok is_cow( $a[99] );"
NSQ_SOURCE_LINE 00000067 "     is cowrefcnt($str), 101;"
NSQ_SOURCE_LINE 00000068 "     is cowrefcnt( $a[-1] ), 101;"
NSQ_SOURCE_LINE 00000069 " "
NSQ_SOURCE_LINE 00000070 "     delete $a[99];"
NSQ_SOURCE_LINE 00000071 "     is cowrefcnt($str), 100;"
NSQ_SOURCE_LINE 00000072 "     is cowrefcnt( $a[-1] ), 100;"
NSQ_SOURCE_LINE 00000073 " "
NSQ_SOURCE_LINE 00000074 "     {"
NSQ_SOURCE_LINE 00000075 "         my %h = ( 'a' .. 'd' );"
NSQ_SOURCE_LINE 00000076 "         foreach my $k ( sort keys %h ) {"
NSQ_SOURCE_LINE 00000077 "             ok is_cow($k);"
NSQ_SOURCE_LINE 00000078 "             is cowrefcnt($k), 0;"
NSQ_SOURCE_LINE 00000079 "         }"
NSQ_SOURCE_LINE 00000080 "     }"
NSQ_SOURCE_LINE 00000081 " "
NSQ_SOURCE_LINE 00000082 " }"
NSQ_SOURCE_LINE 00000083 " else {"
NSQ_SOURCE_LINE 00000084 "     my $str = \"abcdef\";"
NSQ_SOURCE_LINE 00000085 "     is is_cow($str),    undef;"
NSQ_SOURCE_LINE 00000086 "     is cowrefcnt($str), undef;"
NSQ_SOURCE_LINE 00000087 "     is cowrefcnt_max(), undef;"
NSQ_SOURCE_LINE 00000088 " }"
NSQ_SOURCE_LINE 00000089 " "
NSQ_SOURCE_LINE 00000090 " done_testing;"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "B::COW provides some naive additional B helpers to check the COW status of one SvPV."
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=head2 COW or Copy On Write introduction"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "A COWed SvPV is sharing its string (the PV) with other SvPVs."
NSQ_SOURCE_LINE 00000099 "It's a (kind of) Read Only C string, that would be Copied On Write (COW)."
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "More than one SV can share the same PV, but when one PV need to alter it,"
NSQ_SOURCE_LINE 00000102 "it would perform a copy of it, decrease the COWREFCNT counter."
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "One SV can then drop the COW flag when it's the only one holding a pointer"
NSQ_SOURCE_LINE 00000105 "to the PV."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "The COWREFCNT is stored at the end of the PV, after the the \"\\0\"."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "That value is limited to 255, when we reach 255, a new PV would be created,"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=for markdown [![](https://github.com/atoomic/B-COW/workflows/linux/badge.svg)](https://github.com/atoomic/B-COW/actions) [![](https://github.com/atoomic/B-COW/workflows/macos/badge.svg)](https://github.com/atoomic/B-COW/actions) [![](https://github.com/atoomic/B-COW/workflows/windows/badge.svg)](https://github.com/atoomic/B-COW/actions)"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=head2 can_cow()"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "Return a boolean value. True if your Perl version support Copy On Write for SvPVs"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head2 is_cow( PV )"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "Return a boolean value. True if the SV is cowed SvPV. (check the SV FLAGS)"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=head2 cowrefcnt( PV )"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "Return one integer representing the COW RefCount value."
NSQ_SOURCE_LINE 00000126 "If the string is not COW, then it will return undef."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=head2 cowrefcnt_max()"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "Will return the SV_COW_REFCNT_MAX of your Perl. (if COW is supported, this should"
NSQ_SOURCE_LINE 00000131 "be 255 unless customized)."
NSQ_SOURCE_LINE 00000132 ""
