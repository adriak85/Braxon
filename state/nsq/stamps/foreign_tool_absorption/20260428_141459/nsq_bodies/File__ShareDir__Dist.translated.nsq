NSQ_SOURCE_LINE 00000001 "package File::ShareDir::Dist;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use 5.008001;"
NSQ_SOURCE_LINE 00000006 "use base qw( Exporter );"
NSQ_SOURCE_LINE 00000007 "use File::Spec;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our @EXPORT_OK = qw( dist_share dist_config );"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "# ABSTRACT: Locate per-dist shared files"
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.07'; # VERSION"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "# TODO: Works with PAR"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our %over;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "sub dist_share ($)"
NSQ_SOURCE_LINE 00000020 "{"
NSQ_SOURCE_LINE 00000021 "  my($dist_name) = @_;"
NSQ_SOURCE_LINE 00000022 "  "
NSQ_SOURCE_LINE 00000023 "  $dist_name =~ s/::/-/g;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "  local $over{$1} = $2"
NSQ_SOURCE_LINE 00000026 "    if defined $ENV{PERL_FILE_SHAREDIR_DIST} && $ENV{PERL_FILE_SHAREDIR_DIST} =~ /^(.*?)=(.*)$/;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "  return File::Spec->rel2abs($over{$dist_name}) if $over{$dist_name};"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "  my @pm = split /-/, $dist_name;"
NSQ_SOURCE_LINE 00000031 "  $pm[-1] .= \".pm\";"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "  foreach my $inc (@INC)"
NSQ_SOURCE_LINE 00000034 "  {"
NSQ_SOURCE_LINE 00000035 "    my $pm = File::Spec->catfile( $inc, @pm );"
NSQ_SOURCE_LINE 00000036 "    if(-f $pm)"
NSQ_SOURCE_LINE 00000037 "    {"
NSQ_SOURCE_LINE 00000038 "      my $share = File::Spec->catdir( $inc, qw( auto share dist ), $dist_name );"
NSQ_SOURCE_LINE 00000039 "      if(-d $share)"
NSQ_SOURCE_LINE 00000040 "      {"
NSQ_SOURCE_LINE 00000041 "        return File::Spec->rel2abs($share);"
NSQ_SOURCE_LINE 00000042 "      }"
NSQ_SOURCE_LINE 00000043 "      "
NSQ_SOURCE_LINE 00000044 "      if(!File::Spec->file_name_is_absolute($inc))"
NSQ_SOURCE_LINE 00000045 "      {"
NSQ_SOURCE_LINE 00000046 "        my($v,$dir) = File::Spec->splitpath( File::Spec->rel2abs($inc), 1 );"
NSQ_SOURCE_LINE 00000047 "        my @dirs = File::Spec->splitdir($dir);"
NSQ_SOURCE_LINE 00000048 "        if(defined $dirs[-1] && $dirs[-1] eq 'lib')"
NSQ_SOURCE_LINE 00000049 "        {"
NSQ_SOURCE_LINE 00000050 "          pop @dirs; # pop off the 'lib';"
NSQ_SOURCE_LINE 00000051 "          # put humpty dumpty back together again"
NSQ_SOURCE_LINE 00000052 "          my $share = File::Spec->catdir("
NSQ_SOURCE_LINE 00000053 "            File::Spec->catpath($v,"
NSQ_SOURCE_LINE 00000054 "              File::Spec->catdir(@dirs),"
NSQ_SOURCE_LINE 00000055 "              '',"
NSQ_SOURCE_LINE 00000056 "            ),"
NSQ_SOURCE_LINE 00000057 "            'share',"
NSQ_SOURCE_LINE 00000058 "          );"
NSQ_SOURCE_LINE 00000059 "          "
NSQ_SOURCE_LINE 00000060 "          if(-d $share)"
NSQ_SOURCE_LINE 00000061 "          {"
NSQ_SOURCE_LINE 00000062 "            return $share;"
NSQ_SOURCE_LINE 00000063 "          }"
NSQ_SOURCE_LINE 00000064 "        }"
NSQ_SOURCE_LINE 00000065 "      }"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "      last;"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 "  }"
NSQ_SOURCE_LINE 00000070 "  "
NSQ_SOURCE_LINE 00000071 "  return;"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "sub dist_config"
NSQ_SOURCE_LINE 00000076 "{"
NSQ_SOURCE_LINE 00000077 "  my($dist_name) = @_;"
NSQ_SOURCE_LINE 00000078 "  my $dir = dist_share $dist_name;"
NSQ_SOURCE_LINE 00000079 "  return {} unless defined $dir && -d $dir;"
NSQ_SOURCE_LINE 00000080 "  my $fn = File::Spec->catfile($dir, 'config.pl');"
NSQ_SOURCE_LINE 00000081 "  return {} unless -f $fn;"
NSQ_SOURCE_LINE 00000082 "  my $fh;"
NSQ_SOURCE_LINE 00000083 "  open($fh, '<', $fn) || die \"unable to read $fn $!\";"
NSQ_SOURCE_LINE 00000084 "  my $pl = do { local $/; <$fh> };"
NSQ_SOURCE_LINE 00000085 "  close $fh;"
NSQ_SOURCE_LINE 00000086 "  my $config = eval $pl;"
NSQ_SOURCE_LINE 00000087 "  die $@ if $@;"
NSQ_SOURCE_LINE 00000088 "  $config;"
NSQ_SOURCE_LINE 00000089 "}"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "sub import"
NSQ_SOURCE_LINE 00000092 "{"
NSQ_SOURCE_LINE 00000093 "  my($class, @args) = @_;"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "  my @modify;"
NSQ_SOURCE_LINE 00000096 "  "
NSQ_SOURCE_LINE 00000097 "  foreach my $arg (@args)"
NSQ_SOURCE_LINE 00000098 "  {"
NSQ_SOURCE_LINE 00000099 "    if($arg =~ /^-(.*?)=(.*)$/)"
NSQ_SOURCE_LINE 00000100 "    {"
NSQ_SOURCE_LINE 00000101 "      $over{$1} = $2;"
NSQ_SOURCE_LINE 00000102 "    }"
NSQ_SOURCE_LINE 00000103 "    else"
NSQ_SOURCE_LINE 00000104 "    {"
NSQ_SOURCE_LINE 00000105 "      push @modify, $arg;"
NSQ_SOURCE_LINE 00000106 "    }"
NSQ_SOURCE_LINE 00000107 "  }"
NSQ_SOURCE_LINE 00000108 "  "
NSQ_SOURCE_LINE 00000109 "  @_ = ($class, @modify);"
NSQ_SOURCE_LINE 00000110 "  "
NSQ_SOURCE_LINE 00000111 "  goto \\&Exporter::import;"
NSQ_SOURCE_LINE 00000112 "}"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "1;"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "__END__"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=pod"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head1 NAME"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "File::ShareDir::Dist - Locate per-dist shared files"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=head1 VERSION"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "version 0.07"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 " use File::ShareDir::Dist qw( dist_share );"
NSQ_SOURCE_LINE 00000133 " "
NSQ_SOURCE_LINE 00000134 " my $dir = dist_share 'Foo-Bar-Baz';"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "L<File::ShareDir::Dist> finds share directories for distributions.  It is similar to L<File::ShareDir>"
NSQ_SOURCE_LINE 00000139 "with a few differences:"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=over 4"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=item Only supports distribution directories."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "It doesn't support perl modules or perl class directories.  I have never really needed anything"
NSQ_SOURCE_LINE 00000146 "other than a per-dist share directory."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "=item Doesn't compute filenames."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Doesn't compute files in the share directory for you.  This is what L<File::Spec> or L<Path::Tiny>"
NSQ_SOURCE_LINE 00000151 "are for."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=item Doesn't support old style shares."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "For some reason there are two types.  I have never seen or needed the older type."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=item Hopefully doesn't find the wrong directory."
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "It doesn't blindly go finding the first share directory in @INC that matches the dist name.  It actually"
NSQ_SOURCE_LINE 00000160 "checks to see that it matches the .pm file that goes along with it."
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "That does mean that you need to have a .pm that corresponds to your dist name.  This is not"
NSQ_SOURCE_LINE 00000163 "always the case for some older historical distributions, but it has been the recommended convention"
NSQ_SOURCE_LINE 00000164 "for quite some time."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=item No non-core dependencies."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "L<File::ShareDir> only has L<Class::Inspector>, but since we are only doing per-dist share"
NSQ_SOURCE_LINE 00000169 "directories we don't even need that."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "The goal of this project is to have no non-core dependencies for the two most recent production"
NSQ_SOURCE_LINE 00000172 "versions of Perl.  As of this writing that means Perl 5.26 and 5.24.  In the future, we C<may> add"
NSQ_SOURCE_LINE 00000173 "dependencies on modules that are not part of the Perl core on older Perls."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=item Works in your development tree."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "Uses the heuristic, for determining if you are in a development tree, and if so, uses the common"
NSQ_SOURCE_LINE 00000178 "convention to find the directory named C<share>.  If you are using a relative path in C<@INC>,"
NSQ_SOURCE_LINE 00000179 "if the directory C<share> is a sibling of that relative entry in C<@INC> and if the last element"
NSQ_SOURCE_LINE 00000180 "in that relative path is C<lib>."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "Example, if you have the directory structure:"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 " lib/Foo/Bar/Baz.pm"
NSQ_SOURCE_LINE 00000185 " share/data"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "and you invoke perl with"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 " % perl -Ilib -MFoo::Bar::Baz -MFile::ShareDir::Dist=dist_share -E 'say dist_share(\"Foo-Bar-Baz\")'"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "C<dist_share> will return the (absolute) path to ./share/data.  If you invoked it with:"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 " % export PERL5LIB `pwd`/lib"
NSQ_SOURCE_LINE 00000194 " perl -MFoo::Bar::Baz -MFile::ShareDir::Dist=dist_share -E 'say dist_share(\"Foo-Bar-Baz\")'"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "it would not.  For me this covers most of my needs when developing a Perl module with a share"
NSQ_SOURCE_LINE 00000197 "directory."
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "L<prove> foils this heuristic by making C<@INC> absolute paths.  To get around that you can use"
NSQ_SOURCE_LINE 00000200 "L<App::Prove::Plugin::ShareDirDist>."
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=item Built in override."
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "The hash C<%File::ShareDir::Dist::over> can be used to override what C<dist_share> returns."
NSQ_SOURCE_LINE 00000205 "You can also override behavior on the command line using a dash followed by a key value pair"
NSQ_SOURCE_LINE 00000206 "joined by the equal sign.  In other words:"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 " % perl -MFile::ShareDir::Dist=-Foo-Bar-Baz=./share -E 'say File::ShareDir::Dist::dist_share(\"Foo-Bar-Baz\")'"
NSQ_SOURCE_LINE 00000209 " /.../share"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "If neither of those work then you can set PERL_FILE_SHAREDIR_DIST to a dist name, directory pair"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 " % env PERL_FILE_SHAREDIR_DIST=Foo-Bar-Baz=`pwd`/share perl -MFile::ShareDir::Dist -E 'say File::ShareDir::Dist::dist_share(\"Foo-Bar-Baz\")'"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "For L<File::ShareDir> you have to either mock the C<dist_dir> function or install"
NSQ_SOURCE_LINE 00000216 "L<File::ShareDir::Override>.  For testing you can use L<Test::File::ShareDir>.  I have never"
NSQ_SOURCE_LINE 00000217 "understood why such a simple concept needs three modules to do all of this."
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=back"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "Functions must be explicitly exported.  They are not exported by default."
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=head2 dist_share"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 " my $dir = dist_share $dist_name;"
NSQ_SOURCE_LINE 00000228 " my $dir = dist_share $module_name;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "Returns the absolute path to the share directory of the given distribution."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "As a convenience you can also use the \"main\" module name associated with the"
NSQ_SOURCE_LINE 00000233 "distribution.  That means if you want the share directory for the dist"
NSQ_SOURCE_LINE 00000234 "C<Foo-Bar-Baz> you may use either C<Foo-Bar-Baz> or C<Foo::Bar::Baz> to find"
NSQ_SOURCE_LINE 00000235 "it."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "Returns nothing if no share directory could be found."
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=head2 dist_config"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "[version 0.07]"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 " my $config = dist_config $dist_name;"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "Returns the config at runtime as created by L<File::ShareDir::Dist::Install> and install time."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=over 4"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=item PERL_FILE_SHAREDIR_DIST"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "Can be used to set a single dist directory override."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=back"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "All the stuff that is in L<File::ShareDir> but not in this module could be considered either"
NSQ_SOURCE_LINE 00000260 "caveats or features depending on your perspective I suppose."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=over"
