NSQ_SOURCE_LINE 00000266 "=item L<File::ShareDir::Dist::Install>"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=item L<App::Prove::Plugin::ShareDirDist>"
NSQ_SOURCE_LINE 00000269 ""
