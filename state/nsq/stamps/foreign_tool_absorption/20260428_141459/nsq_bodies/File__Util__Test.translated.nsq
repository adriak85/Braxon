NSQ_SOURCE_LINE 00000052 "sub file_exists {"
NSQ_SOURCE_LINE 00000053 "    my $path = shift;"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    !(-l $path) && (-e _) || (-l _);"
NSQ_SOURCE_LINE 00000056 "}"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "sub l_abs_path {"
NSQ_SOURCE_LINE 00000059 "    my $path = shift;"
NSQ_SOURCE_LINE 00000060 "    return Cwd::abs_path($path) unless (-l $path);"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    $path =~ s!/\\z!!;"
NSQ_SOURCE_LINE 00000063 "    my ($parent, $leaf);"
NSQ_SOURCE_LINE 00000064 "    if ($path =~ m!(.+)/(.+)!s) {"
NSQ_SOURCE_LINE 00000065 "        $parent = Cwd::abs_path($1);"
NSQ_SOURCE_LINE 00000066 "        return undef unless defined($path);"
NSQ_SOURCE_LINE 00000067 "        $leaf   = $2;"
NSQ_SOURCE_LINE 00000068 "    } else {"
NSQ_SOURCE_LINE 00000069 "        $parent = Cwd::getcwd();"
NSQ_SOURCE_LINE 00000070 "        $leaf   = $path;"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 "    \"$parent/$leaf\";"
NSQ_SOURCE_LINE 00000073 "}"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "sub dir_empty {"
NSQ_SOURCE_LINE 00000076 "    my ($dir) = @_;"
NSQ_SOURCE_LINE 00000077 "    return undef unless (-d $dir);"
NSQ_SOURCE_LINE 00000078 "    return undef unless opendir my($dh), $dir;"
NSQ_SOURCE_LINE 00000079 "    while (defined(my $e = readdir $dh)) {"
NSQ_SOURCE_LINE 00000080 "        next if $e eq '.' || $e eq '..';"
NSQ_SOURCE_LINE 00000081 "        return 0;"
NSQ_SOURCE_LINE 00000082 "    }"
NSQ_SOURCE_LINE 00000083 "    1;"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
