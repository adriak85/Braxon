NSQ_SOURCE_LINE 00000374 "}"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "sub get_dir_non_dot_subdirs {"
NSQ_SOURCE_LINE 00000377 "    my $opts = ref $_[0] eq 'HASH' ? {%{shift()}} : {};"
NSQ_SOURCE_LINE 00000378 "    die \"Unknown option(s): \".join(\", \", keys %$opts) if keys %$opts;"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    my ($dir) = @_;"
NSQ_SOURCE_LINE 00000381 "    $dir //= \".\";"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "    opendir my($dh), $dir or die \"Can't opendir $dir: $!\";"
NSQ_SOURCE_LINE 00000384 "    my @res = grep { $_ ne '.' && $_ ne '..' && !/\\A\\./ && !(-l \"$dir/$_\") && (-d _) } readdir $dh;"
NSQ_SOURCE_LINE 00000385 "    closedir $dh; # we're so nice"
NSQ_SOURCE_LINE 00000386 "    @res;"
NSQ_SOURCE_LINE 00000387 "}"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "sub get_dir_only_file {"
NSQ_SOURCE_LINE 00000390 "    my $opts = ref $_[0] eq 'HASH' ? {%{shift()}} : {};"
NSQ_SOURCE_LINE 00000391 "    my $opt_ignore_dir = delete $opts->{ignore_dir};"
NSQ_SOURCE_LINE 00000392 "    die \"Unknown option(s): \".join(\", \", keys %$opts) if keys %$opts;"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "    my ($dir) = @_;"
NSQ_SOURCE_LINE 00000395 "    $dir //= \".\";"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "    opendir my($dh), $dir or die \"Can't opendir $dir: $!\";"
NSQ_SOURCE_LINE 00000398 "    my $res;"
NSQ_SOURCE_LINE 00000399 "    while (defined(my $e = readdir $dh)) {"
NSQ_SOURCE_LINE 00000400 "        next if $e eq '.' || $e eq '..';"
NSQ_SOURCE_LINE 00000401 "        my @st = stat \"$dir/$e\";"
NSQ_SOURCE_LINE 00000402 "        next if -d _ && $opt_ignore_dir;"
NSQ_SOURCE_LINE 00000403 "        return unless -f _;"
NSQ_SOURCE_LINE 00000404 "        return if defined $res;"
NSQ_SOURCE_LINE 00000405 "        $res = $e;"
NSQ_SOURCE_LINE 00000406 "    }"
NSQ_SOURCE_LINE 00000407 "    return unless defined $res;"
NSQ_SOURCE_LINE 00000408 "    $res;"
NSQ_SOURCE_LINE 00000409 "}"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "sub get_dir_only_subdir {"
NSQ_SOURCE_LINE 00000412 "    my $opts = ref $_[0] eq 'HASH' ? {%{shift()}} : {};"
NSQ_SOURCE_LINE 00000413 "    my $opt_ignore_file = delete $opts->{ignore_file};"
NSQ_SOURCE_LINE 00000414 "    die \"Unknown option(s): \".join(\", \", keys %$opts) if keys %$opts;"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "    my ($dir) = @_;"
NSQ_SOURCE_LINE 00000417 "    $dir //= \".\";"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "    opendir my($dh), $dir or die \"Can't opendir $dir: $!\";"
NSQ_SOURCE_LINE 00000420 "    my $res;"
NSQ_SOURCE_LINE 00000421 "    while (defined(my $e = readdir $dh)) {"
NSQ_SOURCE_LINE 00000422 "        next if $e eq '.' || $e eq '..';"
NSQ_SOURCE_LINE 00000423 "        my @st = stat \"$dir/$e\";"
NSQ_SOURCE_LINE 00000424 "        next if -f _ && $opt_ignore_file;"
NSQ_SOURCE_LINE 00000425 "        return unless -d _;"
NSQ_SOURCE_LINE 00000426 "        return if defined $res;"
NSQ_SOURCE_LINE 00000427 "        $res = $e;"
NSQ_SOURCE_LINE 00000428 "    }"
NSQ_SOURCE_LINE 00000429 "    return unless defined $res;"
NSQ_SOURCE_LINE 00000430 "    $res;"
NSQ_SOURCE_LINE 00000431 "}"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "sub get_dir_only_symlink {"
NSQ_SOURCE_LINE 00000434 "    my $opts = ref $_[0] eq 'HASH' ? {%{shift()}} : {};"
NSQ_SOURCE_LINE 00000435 "    die \"Unknown option(s): \".join(\", \", keys %$opts) if keys %$opts;"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "    my ($dir) = @_;"
NSQ_SOURCE_LINE 00000438 "    $dir //= \".\";"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "    opendir my($dh), $dir or die \"Can't opendir $dir: $!\";"
NSQ_SOURCE_LINE 00000441 "    my $res;"
NSQ_SOURCE_LINE 00000442 "    while (defined(my $e = readdir $dh)) {"
NSQ_SOURCE_LINE 00000443 "        next if $e eq '.' || $e eq '..';"
NSQ_SOURCE_LINE 00000444 "        my @st = lstat \"$dir/$e\";"
NSQ_SOURCE_LINE 00000445 "        return unless -l _;"
NSQ_SOURCE_LINE 00000446 "        return if defined $res;"
NSQ_SOURCE_LINE 00000447 "        $res = $e;"
NSQ_SOURCE_LINE 00000448 "    }"
NSQ_SOURCE_LINE 00000449 "    return unless defined $res;"
NSQ_SOURCE_LINE 00000450 "    $res;"
NSQ_SOURCE_LINE 00000451 "}"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "1;"
NSQ_SOURCE_LINE 00000454 "# ABSTRACT: Utilities related mostly to testing/checking for files in directories"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "__END__"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "=pod"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "=head1 NAME"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "File::Util::Test - Utilities related mostly to testing/checking for files in directories"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "=head1 VERSION"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "This document describes version 0.632 of File::Util::Test (from Perl distribution File-Util-Test), released on 2024-07-17."
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 " use File::Util::Test qw("
NSQ_SOURCE_LINE 00000473 "     file_exists"
NSQ_SOURCE_LINE 00000474 "     l_abs_path"
NSQ_SOURCE_LINE 00000475 "     dir_empty"
NSQ_SOURCE_LINE 00000476 "     dir_has_files"
NSQ_SOURCE_LINE 00000477 "     dir_has_dot_files"
NSQ_SOURCE_LINE 00000478 "     dir_has_non_dot_files"
NSQ_SOURCE_LINE 00000479 "     dir_has_subdirs"
NSQ_SOURCE_LINE 00000480 "     dir_has_non_subdirs"
NSQ_SOURCE_LINE 00000481 "     dir_has_dot_subdirs"
NSQ_SOURCE_LINE 00000482 "     dir_has_non_dot_subdirs"
NSQ_SOURCE_LINE 00000483 "     dir_only_has_files"
NSQ_SOURCE_LINE 00000484 "     dir_only_has_dot_files"
NSQ_SOURCE_LINE 00000485 "     dir_only_has_non_dot_files"
NSQ_SOURCE_LINE 00000486 "     dir_only_has_subdirs"
NSQ_SOURCE_LINE 00000487 "     dir_only_has_dot_subdirs"
NSQ_SOURCE_LINE 00000488 "     dir_only_has_non_dot_subdirs"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "     get_dir_entries"
NSQ_SOURCE_LINE 00000491 "     get_dir_dot_entries"
NSQ_SOURCE_LINE 00000492 "     get_dir_subdirs"
NSQ_SOURCE_LINE 00000493 "     get_dir_non_subdirs"
NSQ_SOURCE_LINE 00000494 "     get_dir_dot_subdirs"
NSQ_SOURCE_LINE 00000495 "     get_dir_non_dot_subdirs"
NSQ_SOURCE_LINE 00000496 "     get_dir_files"
NSQ_SOURCE_LINE 00000497 "     get_dir_dot_files"
NSQ_SOURCE_LINE 00000498 "     get_dir_non_dot_files"
NSQ_SOURCE_LINE 00000499 "     get_dir_only_file"
NSQ_SOURCE_LINE 00000500 "     get_dir_only_subdir"
NSQ_SOURCE_LINE 00000501 "     get_dir_only_symlink"
NSQ_SOURCE_LINE 00000502 " );"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 " print \"file exists\" if file_exists(\"/path/to/file/or/dir\");"
NSQ_SOURCE_LINE 00000505 " print \"absolute path = \", l_abs_path(\"foo\");"
NSQ_SOURCE_LINE 00000506 " print \"dir exists and is empty\" if dir_empty(\"/path/to/dir\");"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "None are exported by default, but they are exportable."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=head2 file_exists"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "Usage:"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 " file_exists($path) => BOOL"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "This routine is just like the B<-e> test, except that it assume symlinks with"
NSQ_SOURCE_LINE 00000521 "non-existent target as existing. If C<sym> is a symlink to a non-existing"
NSQ_SOURCE_LINE 00000522 "target:"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 " -e \"sym\"             # false, Perl performs stat() which follows symlink"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "but:"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 " -l \"sym\"             # true, Perl performs lstat()"
NSQ_SOURCE_LINE 00000529 " -e _                 # false"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "This function performs the following test:"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 " !(-l \"sym\") && (-e _) || (-l _)"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "Which one should you use: C<-e> or C<file_exists>? It depends on whether you"
NSQ_SOURCE_LINE 00000536 "want to consider a broken symlink as \"existing\" or not. Sometimes one is more"
NSQ_SOURCE_LINE 00000537 "appropriate than the other. If you use C<-e>, your application might overwrite a"
NSQ_SOURCE_LINE 00000538 "(temporarily) broken symlink; on the other hand if you use C<file_exists>, your"
NSQ_SOURCE_LINE 00000539 "application will see a file as existing but gets confused when it cannot open"
NSQ_SOURCE_LINE 00000540 "it."
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "=head2 l_abs_path"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "Usage:"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 " l_abs_path($path) => STR"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "Just like Cwd::abs_path(), except that it will not follow symlink if $path is"
NSQ_SOURCE_LINE 00000549 "symlink (but it will follow symlinks for the parent paths)."
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "Example:"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 " use Cwd qw(getcwd abs_path);"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 " say getcwd();              # /home/steven"
NSQ_SOURCE_LINE 00000556 " # s is a symlink to /tmp/foo"
NSQ_SOURCE_LINE 00000557 " say abs_path(\"s\");         # /tmp/foo"
NSQ_SOURCE_LINE 00000558 " say l_abs_path(\"s\");       # /home/steven/s"
NSQ_SOURCE_LINE 00000559 " # s2 is a symlink to /tmp"
NSQ_SOURCE_LINE 00000560 " say abs_path(\"s2/foo\");    # /tmp/foo"
NSQ_SOURCE_LINE 00000561 " say l_abs_path(\"s2/foo\");  # /tmp/foo"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "Mnemonic: l_abs_path -> abs_path is analogous to lstat -> stat."
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "Note: currently uses hardcoded C</> as path separator."
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "=head2 dir_empty"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "Usage:"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 " dir_empty($dir) => BOOL"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "Will return true if C<$dir> exists and is empty."
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "This should be trivial but alas it is not. C<-s> always returns true (in other"
NSQ_SOURCE_LINE 00000576 "words, C<-z> always returns false) for a directory."
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "To test that a directory is C<not> empty, use L</dir_not_empty> (or its alias"
NSQ_SOURCE_LINE 00000579 "L</dir_has_entries>)."
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "=head2 dir_not_empty"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "Usage:"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 " dir_not_empty($dir) => BOOL"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "Will return true if C<$dir> exists and is not empty (has entries other than C<.>"
NSQ_SOURCE_LINE 00000588 "and C<..>)."
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "To test that a directory is empty, use L</dir_empty>."
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "=head2 dir_has_entries"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "Alias for L</dir_not_empty>."
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "=head2 dir_has_files"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "Usage:"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 " dir_has_files($dir) => BOOL"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "Will return true if C<$dir> exists and has one or more plain files in it. A"
NSQ_SOURCE_LINE 00000603 "plain file is one that passes Perl's C<-f> operator. A symlink to a plain file"
NSQ_SOURCE_LINE 00000604 "counts as a plain file. Non-plain files include named pipes, Unix sockets, and"
NSQ_SOURCE_LINE 00000605 "block/character special files."
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "=head2 dir_has_dot_files"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "Usage:"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 " dir_has_dot_files($dir) => BOOL"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "Will return true if C<$dir> exists and has one or more plain dot files in it."
NSQ_SOURCE_LINE 00000614 "See L</dir_has_files> for the definition of plain files. Dot files a.k.a. hidden"
NSQ_SOURCE_LINE 00000615 "files are files with names beginning with a dot."
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "=head2 dir_has_non_dot_files"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "Usage:"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 " dir_has_non_dot_files($dir) => BOOL"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "Will return true if C<$dir> exists and has one or more plain non-dot files in"
NSQ_SOURCE_LINE 00000624 "it. See L</dir_has_dot_files> for the definitions. =head2 dir_has_subdirs"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "=head2 dir_has_subdirs"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "Usage:"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 " dir_has_subdirs($dir) => BOOL"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "Will return true if C<$dir> exists and has one or more subdirectories in it. A"
NSQ_SOURCE_LINE 00000633 "symlink to a directory does I<NOT> count as subdirectory."
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "=head2 dir_has_non_subdirs"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "Usage:"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 " dir_has_non_subdirs($dir) => BOOL"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "Will return true if C<$dir> exists and has one or more non-subdirectories in it."
NSQ_SOURCE_LINE 00000642 "A symlink to a directory does I<NOT> count as subdirectory and thus counts as a"
NSQ_SOURCE_LINE 00000643 "non-subdirectory."
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "=head2 dir_has_dot_subdirs"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "Usage:"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 " dir_has_dot_subdirs($dir) => BOOL"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "Will return true if C<$dir> exists and has one or more dot subdirectories (i.e."
NSQ_SOURCE_LINE 00000652 "subdirectories with names beginning with a dot) in it. A symlink to a directory"
NSQ_SOURCE_LINE 00000653 "does I<NOT> count as subdirectory."
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "=head2 dir_has_non_dot_subdirs"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "Usage:"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 " dir_has_non_dot_subdirs($dir) => BOOL"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "Will return true if C<$dir> exists and has one or more non-dot subdirectories"
NSQ_SOURCE_LINE 00000662 "(i.e. subdirectories with names not beginning with a dot) in it. A symlink to a"
NSQ_SOURCE_LINE 00000663 "directory does I<NOT> count as subdirectory."
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "=head2 dir_only_has_files"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "Usage:"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 " dir_only_has_files($dir) => BOOL"
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "Will return true if C<$dir> exists and has one or more plain files in it *and*"
NSQ_SOURCE_LINE 00000672 "does not have anything else. See L</dir_has_files> for the definition of plain"
NSQ_SOURCE_LINE 00000673 "files."
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "=head2 dir_only_has_dot_files"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "Usage:"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 " dir_only_has_dot_files($dir) => BOOL"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "Will return true if C<$dir> exists and has one or more plain dot files in it"
NSQ_SOURCE_LINE 00000682 "*and* does not have anything else. See L</dir_has_files> for the definition of"
NSQ_SOURCE_LINE 00000683 "plain files."
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "=head2 dir_only_has_non_dot_files"
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "Usage:"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 " dir_only_has_non_dot_files($dir) => BOOL"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "Will return true if C<$dir> exists and has one or more plain non-dot files in it"
NSQ_SOURCE_LINE 00000692 "*and* does not have anything else. See L</dir_has_files> for the definition of"
NSQ_SOURCE_LINE 00000693 "plain files."
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "=head2 dir_only_has_subdirs"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "Usage:"
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 " dir_only_has_subdirs([ \\%opts, ] $dir) => BOOL"
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "Will return true if C<$dir> exists and has one or more subdirectories in it"
NSQ_SOURCE_LINE 00000702 "*and* does not have anything else."
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "=head2 dir_only_has_dot_subdirs"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "Usage:"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 " dir_only_has_dot_subdirs([ \\%opts, ] $dir) => BOOL"
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "Will return true if C<$dir> exists and has one or more dot subdirectories in it"
NSQ_SOURCE_LINE 00000711 "*and* does not have anything else."
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "=head2 dir_only_has_non_dot_subdirs"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "Usage:"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 " dir_only_has_non_dot_subdirs([ \\%opts, ] $dir) => BOOL"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "Will return true if C<$dir> exists and has one or more plain non-dot"
NSQ_SOURCE_LINE 00000720 "subdirectories in it *and* does not have anything else."
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "=head2 get_dir_entries"
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "Usage:"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 " my @entries = get_dir_entries([ \\%opts, ] [ $dir ]);"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "Get all entries of a directory specified by C<$dir> (or the current dir if"
NSQ_SOURCE_LINE 00000729 "unspecified), including dotfiles but excluding \".\" and \"..\". Dies if directory"
NSQ_SOURCE_LINE 00000730 "does not exist or cannot be read."
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "Basically a shortcut for something like:"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 " my @entries = do { opendir my $dh, $dir; grep { $_ ne '.' && $_ ne '..' } readdir $dh };"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "=head2 get_dir_dot_entries"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "Usage:"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 " my @dot_entries = get_dir_dot_entries([ \\%opts, ] [ $dir ]);"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "Get all \"dot\" entries of a directory specified by C<$dir> (or the current dir if"
NSQ_SOURCE_LINE 00000743 "unspecified), excluding \".\" and \"..\". Dies if directory does not exist or cannot"
NSQ_SOURCE_LINE 00000744 "be read."
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "Basically a shortcut for something like:"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 " my @dot_entries = do { opendir my $dh, $dir; grep { $_ ne '.' && $_ ne '..' && /\\A\\./ } readdir $dh };"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "=head2 get_dir_files"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "Usage:"
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 " my @filenames = get_dir_files([ \\%opts, ] [ $dir ]);"
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "Get all plain filename entries of a directory specified by C<$dir> (or the"
NSQ_SOURCE_LINE 00000757 "current dir if unspecified), including dotfiles but excluding \".\" and \"..\". See"
NSQ_SOURCE_LINE 00000758 "L</dir_has_files> for definition of \"plain files\". Dies if directory does not"
NSQ_SOURCE_LINE 00000759 "exist or cannot be read."
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "Basically a shortcut for something like:"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 " my @filenames = do { opendir my $dh, $dir; grep { $_ ne '.' && $_ ne '..' && -f } readdir $dh };"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "=head2 get_dir_dot_files"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "Usage:"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 " my @dot_filenames = get_dir_dot_files([ \\%opts, ] [ $dir ]);"
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "Get all \"dot\" plain filename entries of a directory specified by C<$dir> (or the"
NSQ_SOURCE_LINE 00000772 "current dir if unspecified). See L</dir_has_files> for definition of \"plain"
NSQ_SOURCE_LINE 00000773 "files\". Dies if directory does not exist or cannot be read."
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "Basically a shortcut for something like:"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 " my @dot_filenames = do { opendir my $dh, $dir; grep { $_ ne '.' && $_ ne '..' && /\\A\\./ && -f } readdir $dh };"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "=head2 get_dir_non_dot_files"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "Usage:"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 " my @non_dot_filenames = get_dir_non_dot_files([ \\%opts, ] [ $dir ]);"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "Get all non-\"dot\" plain filename entries of a directory specified by C<$dir> (or"
NSQ_SOURCE_LINE 00000786 "the current dir if unspecified). See L</dir_has_files> for definition of \"plain"
NSQ_SOURCE_LINE 00000787 "files\". Dies if directory does not exist or cannot be read."
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "Basically a shortcut for something like:"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 " my @non_dot_filenames = do { opendir my $dh, $dir; grep { !/\\A\\./ && -f } readdir $dh };"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "=head2 get_dir_subdirs"
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "Usage:"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 " my @subdirnames = get_dir_subdirs([ \\%opts, ] [ $dir ]);"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "Get all subdirectory entries of a directory specified by C<$dir> (or the current"
NSQ_SOURCE_LINE 00000800 "dir if unspecified), including dotsubdirs but excluding \".\" and \"..\". See"
NSQ_SOURCE_LINE 00000801 "L</dir_has_subdirs> for definition of \"subdirectories\". Dies if directory does"
NSQ_SOURCE_LINE 00000802 "not exist or cannot be read."
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "Basically a shortcut for something like:"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 " my @subdirnames = do { opendir my $dh, $dir; grep { $_ ne '.' && $_ ne '..' && !(-l) && (-d _) } readdir $dh };"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "=head2 get_dir_non_subdirs"
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "Usage:"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 " my @nonsubdirnames = get_dir_non_subdirs([ \\%opts, ] [ $dir ]);"
NSQ_SOURCE_LINE 00000813 ""
NSQ_SOURCE_LINE 00000814 "Get all non-subdirectory entries of a directory specified by C<$dir> (or the"
NSQ_SOURCE_LINE 00000815 "current dir if unspecified). See L</dir_has_subdirs> for definition of"
NSQ_SOURCE_LINE 00000816 "\"subdirectories\". Dies if directory does not exist or cannot be read."
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "Basically a shortcut for something like:"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 " my @nonsubdirnames = do { opendir my $dh, $dir; grep { $_ ne '.' && $_ ne '..' && !(-l) && !(-d) } readdir $dh };"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "=head2 get_dir_dot_subdirs"
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "Usage:"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 " my @dot_subdirnames = get_dir_dot_subdirs([ \\%opts, ] [ $dir ]);"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "Get all \"dot\" subdirectory entries of a directory specified by C<$dir> (or the"
NSQ_SOURCE_LINE 00000829 "current dir if unspecified). See L</dir_has_subdirs> for definition of"
NSQ_SOURCE_LINE 00000830 "\"subdirectories\". Dies if directory does not exist or cannot be read."
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "Basically a shortcut for something like:"
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 " my @dot_subdirnames = do { opendir my $dh, $dir; grep { $_ ne '.' && $_ ne '..' && /\\A\\./ && -d } readdir $dh };"
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "=head2 get_dir_non_dot_subdirs"
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "Usage:"
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 " my @non_dot_subdirnames = get_dir_non_dot_subdirs([ \\%opts, ] [ $dir ]);"
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "Get all non-\"dot\" subdirectory entries of a directory specified by C<$dir> (or"
NSQ_SOURCE_LINE 00000843 "the current dir if unspecified). See L</dir_has_subdirs> for definition of"
NSQ_SOURCE_LINE 00000844 "\"subdirectories\". Dies if directory does not exist or cannot be read."
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "Basically a shortcut for something like:"
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 " my @non_dot_subdirnames = do { opendir my $dh, $dir; grep { !/\\A\\./ && -d } readdir $dh };"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "=head2 get_dir_only_file"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "Usage:"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 " my $filename = get_dir_only_file([ \\%opts, ] [ $dir ]);"
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "Return filename inside directory C<$dir> (or current directory if unspecified)"
NSQ_SOURCE_LINE 00000857 "only if C<$dir> has a single plain file and nothing else."
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "Known options:"
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "=over"
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "=item * ignore_dir"
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "Boolean. If set to true, then ignore subdirectories."
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 "=back"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "=head2 get_dir_only_subdir"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "Usage:"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 " my $subdirname = get_dir_only_subdir([ \\%opts, ] [ $dir ]);"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "Return subdirectory name inside directory C<$dir> (or current directory if"
NSQ_SOURCE_LINE 00000876 "unspecified) only if C<$dir> has a single subdirectory and nothing else."
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "Known options:"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "=over"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "=item * ignore_file"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "Boolean. If set to true, then ignore files."
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "=back"
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "=head2 get_dir_only_symlink"
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "Usage:"
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 " my $filename = get_dir_only_symlink([ \\%opts, ] [ $dir ]);"
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "Return symlink name inside directory C<$dir> (or current directory if"
NSQ_SOURCE_LINE 00000895 "unspecified) only if C<$dir> has a single symlink and nothing else."
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "=head1 FAQ"
NSQ_SOURCE_LINE 00000898 ""
NSQ_SOURCE_LINE 00000899 "=head2 Where is file_empty()?"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "For checking if some path exists, is a plain file, and is empty (content is"
NSQ_SOURCE_LINE 00000902 "zero-length), you can simply use the C<-s> or C<-z> filetest operator."
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "=head2 Where is get_dir_non_dot_entries()?"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "That would be a regular glob(\"*\")."
NSQ_SOURCE_LINE 00000907 ""
