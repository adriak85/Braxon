NSQ_SOURCE_LINE 00000272 "sub get_dir_entries {"
NSQ_SOURCE_LINE 00000273 "    my $opts = ref $_[0] eq 'HASH' ? {%{shift()}} : {};"
NSQ_SOURCE_LINE 00000274 "    die \"Unknown option(s): \".join(\", \", keys %$opts) if keys %$opts;"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "    my ($dir) = @_;"
NSQ_SOURCE_LINE 00000277 "    $dir //= \".\";"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "    opendir my($dh), $dir or die \"Can't opendir $dir: $!\";"
NSQ_SOURCE_LINE 00000280 "    my @res = grep { $_ ne '.' && $_ ne '..' } readdir $dh;"
NSQ_SOURCE_LINE 00000281 "    closedir $dh; # we're so nice"
NSQ_SOURCE_LINE 00000282 "    @res;"
