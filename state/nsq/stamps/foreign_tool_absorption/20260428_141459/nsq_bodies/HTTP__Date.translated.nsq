BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package HTTP::Date;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "our $VERSION = '6.06';"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "require Exporter;"
NSQ_SOURCE_LINE 00000008 "our @ISA       = qw(Exporter);"
NSQ_SOURCE_LINE 00000009 "our @EXPORT    = qw(time2str str2time);"
NSQ_SOURCE_LINE 00000010 "our @EXPORT_OK = qw(parse_date time2iso time2isoz);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "require Time::Local;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our ( @DoW, @MoY, %MoY );"
NSQ_SOURCE_LINE 00000015 "@DoW       = qw(Sun Mon Tue Wed Thu Fri Sat);"
NSQ_SOURCE_LINE 00000016 "@MoY       = qw(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec);"
NSQ_SOURCE_LINE 00000017 "@MoY{@MoY} = ( 1 .. 12 );"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "my %GMT_ZONE = ( GMT => 1, UTC => 1, UT => 1, Z => 1 );"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub time2str (;$) {"
NSQ_SOURCE_LINE 00000022 "    my $time = shift;"
NSQ_SOURCE_LINE 00000023 "    $time = time unless defined $time;"
NSQ_SOURCE_LINE 00000024 "    my ( $sec, $min, $hour, $mday, $mon, $year, $wday ) = gmtime($time);"
NSQ_SOURCE_LINE 00000025 "    sprintf("
NSQ_SOURCE_LINE 00000026 "        \"%s, %02d %s %04d %02d:%02d:%02d GMT\","
NSQ_SOURCE_LINE 00000027 "        $DoW[$wday],"
NSQ_SOURCE_LINE 00000028 "        $mday, $MoY[$mon], $year + 1900,"
NSQ_SOURCE_LINE 00000029 "        $hour, $min,       $sec"
NSQ_SOURCE_LINE 00000030 "    );"
NSQ_SOURCE_LINE 00000031 "}"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "sub str2time ($;$) {"
NSQ_SOURCE_LINE 00000034 "    my $str = shift;"
NSQ_SOURCE_LINE 00000035 "    return undef unless defined $str;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    # fast exit for strictly conforming string"
NSQ_SOURCE_LINE 00000038 "    if ( $str"
NSQ_SOURCE_LINE 00000039 "        =~ /^[SMTWF][a-z][a-z], (\\d\\d) ([JFMAJSOND][a-z][a-z]) (\\d\\d\\d\\d) (\\d\\d):(\\d\\d):(\\d\\d) GMT$/"
NSQ_SOURCE_LINE 00000040 "    ) {"
NSQ_SOURCE_LINE 00000041 "        return eval {"
NSQ_SOURCE_LINE 00000042 "            my $t = Time::Local::timegm( $6, $5, $4, $1, $MoY{$2} - 1, $3 );"
NSQ_SOURCE_LINE 00000043 "            $t < 0 ? undef : $t;"
NSQ_SOURCE_LINE 00000044 "        };"
NSQ_SOURCE_LINE 00000045 "    }"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    my @d = parse_date($str);"
NSQ_SOURCE_LINE 00000048 "    return undef unless @d;"
NSQ_SOURCE_LINE 00000049 "    $d[1]--;    # month"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    my $tz = pop(@d);"
NSQ_SOURCE_LINE 00000052 "    unless ( defined $tz ) {"
NSQ_SOURCE_LINE 00000053 "        unless ( defined( $tz = shift ) ) {"
NSQ_SOURCE_LINE 00000054 "            return eval {"
NSQ_SOURCE_LINE 00000055 "                my $frac = $d[-1];"
NSQ_SOURCE_LINE 00000056 "                $frac -= ( $d[-1] = int($frac) );"
NSQ_SOURCE_LINE 00000057 "                my $t = Time::Local::timelocal( reverse @d ) + $frac;"
NSQ_SOURCE_LINE 00000058 "                $t < 0 ? undef : $t;"
NSQ_SOURCE_LINE 00000059 "            };"
NSQ_SOURCE_LINE 00000060 "        }"
NSQ_SOURCE_LINE 00000061 "    }"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    my $offset = 0;"
NSQ_SOURCE_LINE 00000064 "    if ( $GMT_ZONE{ uc $tz } ) {"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "        # offset already zero"
NSQ_SOURCE_LINE 00000067 "    }"
NSQ_SOURCE_LINE 00000068 "    elsif ( $tz =~ /^([-+])?(\\d\\d?):?(\\d\\d)?$/ ) {"
NSQ_SOURCE_LINE 00000069 "        $offset = 3600 * $2;"
NSQ_SOURCE_LINE 00000070 "        $offset += 60 * $3 if $3;"
NSQ_SOURCE_LINE 00000071 "        $offset *= -1      if $1 && $1 eq '-';"
NSQ_SOURCE_LINE 00000072 "    }"
NSQ_SOURCE_LINE 00000073 "    else {"
NSQ_SOURCE_LINE 00000074 "        eval { require Time::Zone } || return undef;"
NSQ_SOURCE_LINE 00000075 "        $offset = Time::Zone::tz_offset($tz);"
NSQ_SOURCE_LINE 00000076 "        return undef unless defined $offset;"
NSQ_SOURCE_LINE 00000077 "    }"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    return eval {"
NSQ_SOURCE_LINE 00000080 "        my $frac = $d[-1];"
NSQ_SOURCE_LINE 00000081 "        $frac -= ( $d[-1] = int($frac) );"
NSQ_SOURCE_LINE 00000082 "        my $t = Time::Local::timegm( reverse @d ) + $frac;"
NSQ_SOURCE_LINE 00000083 "        $t < 0 ? undef : $t - $offset;"
NSQ_SOURCE_LINE 00000084 "    };"
NSQ_SOURCE_LINE 00000085 "}"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "sub parse_date ($) {"
NSQ_SOURCE_LINE 00000088 "    local ($_) = shift;"
NSQ_SOURCE_LINE 00000089 "    return unless defined;"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "    # More lax parsing below"
NSQ_SOURCE_LINE 00000092 "    s/^\\s+//;                                            # kill leading space"
NSQ_SOURCE_LINE 00000093 "    s/^(?:Sun|Mon|Tue|Wed|Thu|Fri|Sat)[a-z]*,?\\s*//i;    # Useless weekday"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    my ( $day, $mon, $yr, $hr, $min, $sec, $tz, $ampm );"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    # Then we are able to check for most of the formats with this regexp"
NSQ_SOURCE_LINE 00000098 "    ("
NSQ_SOURCE_LINE 00000099 "        ( $day, $mon, $yr, $hr, $min, $sec, $tz )"
NSQ_SOURCE_LINE 00000100 "        = /^"
NSQ_SOURCE_LINE 00000101 "     (\\d\\d?)               # day"
NSQ_SOURCE_LINE 00000102 "        (?:\\s+|[-\\/])"
NSQ_SOURCE_LINE 00000103 "     (\\w+)                 # month"
NSQ_SOURCE_LINE 00000104 "        (?:\\s+|[-\\/])"
NSQ_SOURCE_LINE 00000105 "     (\\d+)                 # year"
NSQ_SOURCE_LINE 00000106 "     (?:"
NSQ_SOURCE_LINE 00000107 "           (?:\\s+|:)       # separator before clock"
NSQ_SOURCE_LINE 00000108 "        (\\d\\d?):(\\d\\d)     # hour:min"
NSQ_SOURCE_LINE 00000109 "        (?::(\\d\\d))?       # optional seconds"
NSQ_SOURCE_LINE 00000110 "     )?                    # optional clock"
NSQ_SOURCE_LINE 00000111 "        \\s*"
NSQ_SOURCE_LINE 00000112 "     ([-+]?\\d{2,4}|(?![APap][Mm]\\b)[A-Za-z]+)? # timezone"
NSQ_SOURCE_LINE 00000113 "        \\s*"
NSQ_SOURCE_LINE 00000114 "     (?:\\(\\w+\\)|\\w{3,})?   # ASCII representation of timezone."
NSQ_SOURCE_LINE 00000115 "        \\s*$"
NSQ_SOURCE_LINE 00000116 "    /x"
NSQ_SOURCE_LINE 00000117 "        )"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "        ||"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "        # Try the ctime and asctime format"
NSQ_SOURCE_LINE 00000122 "        ("
NSQ_SOURCE_LINE 00000123 "        ( $mon, $day, $hr, $min, $sec, $tz, $yr )"
NSQ_SOURCE_LINE 00000124 "        = /^"
NSQ_SOURCE_LINE 00000125 "     (\\w{1,3})             # month"
NSQ_SOURCE_LINE 00000126 "        \\s+"
NSQ_SOURCE_LINE 00000127 "     (\\d\\d?)               # day"
NSQ_SOURCE_LINE 00000128 "        \\s+"
NSQ_SOURCE_LINE 00000129 "     (\\d\\d?):(\\d\\d)        # hour:min"
NSQ_SOURCE_LINE 00000130 "     (?::(\\d\\d))?          # optional seconds"
NSQ_SOURCE_LINE 00000131 "        \\s+"
NSQ_SOURCE_LINE 00000132 "     (?:([A-Za-z]+)\\s+)?   # optional timezone"
NSQ_SOURCE_LINE 00000133 "     (\\d+)                 # year"
NSQ_SOURCE_LINE 00000134 "        \\s*$               # allow trailing whitespace"
NSQ_SOURCE_LINE 00000135 "    /x"
NSQ_SOURCE_LINE 00000136 "        )"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "        ||"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "        # Then the Unix 'ls -l' date format"
NSQ_SOURCE_LINE 00000141 "        ("
NSQ_SOURCE_LINE 00000142 "        ( $mon, $day, $yr, $hr, $min, $sec )"
NSQ_SOURCE_LINE 00000143 "        = /^"
NSQ_SOURCE_LINE 00000144 "     (\\w{3})               # month"
NSQ_SOURCE_LINE 00000145 "        \\s+"
NSQ_SOURCE_LINE 00000146 "     (\\d\\d?)               # day"
NSQ_SOURCE_LINE 00000147 "        \\s+"
NSQ_SOURCE_LINE 00000148 "     (?:"
NSQ_SOURCE_LINE 00000149 "        (\\d\\d\\d\\d) |       # year"
NSQ_SOURCE_LINE 00000150 "        (\\d{1,2}):(\\d{2})  # hour:min"
NSQ_SOURCE_LINE 00000151 "            (?::(\\d\\d))?       # optional seconds"
NSQ_SOURCE_LINE 00000152 "     )"
NSQ_SOURCE_LINE 00000153 "     \\s*$"
NSQ_SOURCE_LINE 00000154 "       /x"
NSQ_SOURCE_LINE 00000155 "        )"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "        ||"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "        # ISO 8601 format '1996-02-29 12:00:00 -0100' and variants"
NSQ_SOURCE_LINE 00000160 "        ("
NSQ_SOURCE_LINE 00000161 "        ( $yr, $mon, $day, $hr, $min, $sec, $tz )"
NSQ_SOURCE_LINE 00000162 "        = /^"
NSQ_SOURCE_LINE 00000163 "      (\\d{4})              # year"
NSQ_SOURCE_LINE 00000164 "         [-\\/]?"
NSQ_SOURCE_LINE 00000165 "      (\\d\\d?)              # numerical month"
NSQ_SOURCE_LINE 00000166 "         [-\\/]?"
NSQ_SOURCE_LINE 00000167 "      (\\d\\d?)              # day"
NSQ_SOURCE_LINE 00000168 "     (?:"
NSQ_SOURCE_LINE 00000169 "           (?:\\s+|[-:Tt])  # separator before clock"
NSQ_SOURCE_LINE 00000170 "        (\\d\\d?):?(\\d\\d)    # hour:min"
NSQ_SOURCE_LINE 00000171 "        (?::?(\\d\\d(?:\\.\\d*)?))?  # optional seconds (and fractional)"
NSQ_SOURCE_LINE 00000172 "     )?                    # optional clock"
NSQ_SOURCE_LINE 00000173 "        \\s*"
NSQ_SOURCE_LINE 00000174 "     ([-+]?\\d\\d?:?(:?\\d\\d)?"
NSQ_SOURCE_LINE 00000175 "      |Z|z)?               # timezone  (Z is \"zero meridian\", i.e. GMT)"
NSQ_SOURCE_LINE 00000176 "        \\s*$"
NSQ_SOURCE_LINE 00000177 "    /x"
NSQ_SOURCE_LINE 00000178 "        )"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "        ||"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "        # Windows 'dir': '11-12-96  03:52PM' and four-digit year variant"
NSQ_SOURCE_LINE 00000183 "        ("
NSQ_SOURCE_LINE 00000184 "        ( $mon, $day, $yr, $hr, $min, $ampm )"
NSQ_SOURCE_LINE 00000185 "        = /^"
NSQ_SOURCE_LINE 00000186 "          (\\d{2})                # numerical month"
NSQ_SOURCE_LINE 00000187 "             -"
NSQ_SOURCE_LINE 00000188 "          (\\d{2})                # day"
NSQ_SOURCE_LINE 00000189 "             -"
NSQ_SOURCE_LINE 00000190 "          (\\d{2,4})              # year"
NSQ_SOURCE_LINE 00000191 "             \\s+"
NSQ_SOURCE_LINE 00000192 "          (\\d\\d?):(\\d\\d)([APap][Mm])  # hour:min AM or PM"
NSQ_SOURCE_LINE 00000193 "             \\s*$"
NSQ_SOURCE_LINE 00000194 "        /x"
NSQ_SOURCE_LINE 00000195 "        )"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "        || return;    # unrecognized format"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "    # Translate month name to number"
NSQ_SOURCE_LINE 00000200 "    $mon"
NSQ_SOURCE_LINE 00000201 "        = $MoY{$mon}"
NSQ_SOURCE_LINE 00000202 "        || $MoY{\"\\u\\L$mon\"}"
NSQ_SOURCE_LINE 00000203 "        || ( $mon =~ /^\\d\\d?$/ && $mon >= 1 && $mon <= 12 && int($mon) )"
NSQ_SOURCE_LINE 00000204 "        || return;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    # If the year is missing, we assume first date before the current,"
NSQ_SOURCE_LINE 00000207 "    # because of the formats we support such dates are mostly present"
NSQ_SOURCE_LINE 00000208 "    # on \"ls -l\" listings."
NSQ_SOURCE_LINE 00000209 "    unless ( defined $yr ) {"
NSQ_SOURCE_LINE 00000210 "        my $cur_mon;"
NSQ_SOURCE_LINE 00000211 "        ( $cur_mon, $yr ) = (localtime)[ 4, 5 ];"
NSQ_SOURCE_LINE 00000212 "        $yr += 1900;"
NSQ_SOURCE_LINE 00000213 "        $cur_mon++;"
NSQ_SOURCE_LINE 00000214 "        $yr-- if $mon > $cur_mon;"
NSQ_SOURCE_LINE 00000215 "    }"
NSQ_SOURCE_LINE 00000216 "    elsif ( length($yr) < 3 ) {"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "        # Find \"obvious\" year"
NSQ_SOURCE_LINE 00000219 "        my $cur_yr = (localtime)[5] + 1900;"
NSQ_SOURCE_LINE 00000220 "        my $m      = $cur_yr % 100;"
NSQ_SOURCE_LINE 00000221 "        my $tmp    = $yr;"
NSQ_SOURCE_LINE 00000222 "        $yr += $cur_yr - $m;"
NSQ_SOURCE_LINE 00000223 "        $m  -= $tmp;"
NSQ_SOURCE_LINE 00000224 "        $yr += ( $m > 0 ) ? 100 : -100"
NSQ_SOURCE_LINE 00000225 "            if abs($m) > 50;"
NSQ_SOURCE_LINE 00000226 "    }"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "    # Make sure clock elements are defined"
NSQ_SOURCE_LINE 00000229 "    $hr  = 0 unless defined($hr);"
NSQ_SOURCE_LINE 00000230 "    $min = 0 unless defined($min);"
NSQ_SOURCE_LINE 00000231 "    $sec = 0 unless defined($sec);"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "    # Compensate for AM/PM"
NSQ_SOURCE_LINE 00000234 "    if ($ampm) {"
NSQ_SOURCE_LINE 00000235 "        $ampm = uc $ampm;"
NSQ_SOURCE_LINE 00000236 "        $hr   = 0 if $hr == 12 && $ampm eq 'AM';"
NSQ_SOURCE_LINE 00000237 "        $hr += 12 if $ampm eq 'PM' && $hr != 12;"
NSQ_SOURCE_LINE 00000238 "    }"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "    return ( $yr, $mon, $day, $hr, $min, $sec, $tz )"
NSQ_SOURCE_LINE 00000241 "        if wantarray;"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "    if ( defined $tz ) {"
NSQ_SOURCE_LINE 00000244 "        $tz = \"Z\" if $tz =~ /^(GMT|UTC?|[-+]?0+)$/;"
NSQ_SOURCE_LINE 00000245 "    }"
NSQ_SOURCE_LINE 00000246 "    else {"
NSQ_SOURCE_LINE 00000247 "        $tz = \"\";"
NSQ_SOURCE_LINE 00000248 "    }"
NSQ_SOURCE_LINE 00000249 "    return sprintf("
NSQ_SOURCE_LINE 00000250 "        \"%04d-%02d-%02d %02d:%02d:%02d%s\","
NSQ_SOURCE_LINE 00000251 "        $yr, $mon, $day, $hr, $min, $sec, $tz"
NSQ_SOURCE_LINE 00000252 "    );"
NSQ_SOURCE_LINE 00000253 "}"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "sub time2iso (;$) {"
NSQ_SOURCE_LINE 00000256 "    my $time = shift;"
NSQ_SOURCE_LINE 00000257 "    $time = time unless defined $time;"
NSQ_SOURCE_LINE 00000258 "    my ( $sec, $min, $hour, $mday, $mon, $year ) = localtime($time);"
NSQ_SOURCE_LINE 00000259 "    sprintf("
NSQ_SOURCE_LINE 00000260 "        \"%04d-%02d-%02d %02d:%02d:%02d\","
NSQ_SOURCE_LINE 00000261 "        $year + 1900, $mon + 1, $mday, $hour, $min, $sec"
NSQ_SOURCE_LINE 00000262 "    );"
NSQ_SOURCE_LINE 00000263 "}"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "sub time2isoz (;$) {"
NSQ_SOURCE_LINE 00000266 "    my $time = shift;"
NSQ_SOURCE_LINE 00000267 "    $time = time unless defined $time;"
NSQ_SOURCE_LINE 00000268 "    my ( $sec, $min, $hour, $mday, $mon, $year ) = gmtime($time);"
NSQ_SOURCE_LINE 00000269 "    sprintf("
NSQ_SOURCE_LINE 00000270 "        \"%04d-%02d-%02d %02d:%02d:%02dZ\","
NSQ_SOURCE_LINE 00000271 "        $year + 1900, $mon + 1, $mday, $hour, $min, $sec"
NSQ_SOURCE_LINE 00000272 "    );"
NSQ_SOURCE_LINE 00000273 "}"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "1;"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "# ABSTRACT: HTTP::Date - date conversion routines"
NSQ_SOURCE_LINE 00000278 "#"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "__END__"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=pod"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=head1 NAME"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "HTTP::Date - HTTP::Date - date conversion routines"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=head1 VERSION"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "version 6.06"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 " use HTTP::Date;"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 " $string = time2str($time);    # Format as GMT ASCII time"
NSQ_SOURCE_LINE 00000299 " $time = str2time($string);    # convert ASCII date to machine time"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "This module provides functions that deal the date formats used by the"
NSQ_SOURCE_LINE 00000304 "HTTP protocol (and then some more).  Only the first two functions,"
NSQ_SOURCE_LINE 00000305 "time2str() and str2time(), are exported by default."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=over 4"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=item time2str( [$time] )"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "The time2str() function converts a machine time (seconds since epoch)"
NSQ_SOURCE_LINE 00000312 "to a string.  If the function is called without an argument or with an"
NSQ_SOURCE_LINE 00000313 "undefined argument, it will use the current time."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "The string returned is in the format preferred for the HTTP protocol."
NSQ_SOURCE_LINE 00000316 "This is a fixed length subset of the format defined by RFC 1123,"
NSQ_SOURCE_LINE 00000317 "represented in Universal Time (GMT).  An example of a time stamp"
NSQ_SOURCE_LINE 00000318 "in this format is:"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "   Sun, 06 Nov 1994 08:49:37 GMT"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=item str2time( $str [, $zone] )"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "The str2time() function converts a string to machine time.  It returns"
NSQ_SOURCE_LINE 00000325 "C<undef> if the format of $str is unrecognized, otherwise whatever the"
NSQ_SOURCE_LINE 00000326 "C<Time::Local> functions can make out of the parsed time.  Dates"
NSQ_SOURCE_LINE 00000327 "before the system's epoch may not work on all operating systems.  The"
NSQ_SOURCE_LINE 00000328 "time formats recognized are the same as for parse_date()."
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "The function also takes an optional second argument that specifies the"
NSQ_SOURCE_LINE 00000331 "default time zone to use when converting the date.  This parameter is"
NSQ_SOURCE_LINE 00000332 "ignored if the zone is found in the date string itself.  If this"
NSQ_SOURCE_LINE 00000333 "parameter is missing, and the date string format does not contain any"
NSQ_SOURCE_LINE 00000334 "zone specification, then the local time zone is assumed."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "If the zone is not \"C<GMT>\" or numerical (like \"C<-0800>\" or"
NSQ_SOURCE_LINE 00000337 "\"C<+0100>\"), then the C<Time::Zone> module must be installed in order"
NSQ_SOURCE_LINE 00000338 "to get the date recognized."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "=item parse_date( $str )"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "This function will try to parse a date string, and then return it as a"
NSQ_SOURCE_LINE 00000343 "list of numerical values followed by a (possible undefined) time zone"
NSQ_SOURCE_LINE 00000344 "specifier; ($year, $month, $day, $hour, $min, $sec, $tz).  The $year"
NSQ_SOURCE_LINE 00000345 "will be the full 4-digit year, and $month numbers start with 1 (for January)."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "In scalar context the numbers are interpolated in a string of the"
NSQ_SOURCE_LINE 00000348 "\"YYYY-MM-DD hh:mm:ss TZ\"-format and returned."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "If the date is unrecognized, then the empty list is returned (C<undef> in"
NSQ_SOURCE_LINE 00000351 "scalar context)."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "The function is able to parse the following formats:"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 " \"Wed, 09 Feb 1994 22:23:32 GMT\"       -- HTTP format"
NSQ_SOURCE_LINE 00000356 " \"Thu Feb  3 17:03:55 GMT 1994\"        -- ctime(3) format"
NSQ_SOURCE_LINE 00000357 " \"Thu Feb  3 00:00:00 1994\",           -- ANSI C asctime() format"
NSQ_SOURCE_LINE 00000358 " \"Tuesday, 08-Feb-94 14:15:29 GMT\"     -- old rfc850 HTTP format"
NSQ_SOURCE_LINE 00000359 " \"Tuesday, 08-Feb-1994 14:15:29 GMT\"   -- broken rfc850 HTTP format"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 " \"03/Feb/1994:17:03:55 -0700\"   -- common logfile format"
NSQ_SOURCE_LINE 00000362 " \"09 Feb 1994 22:23:32 GMT\"     -- HTTP format (no weekday)"
NSQ_SOURCE_LINE 00000363 " \"08-Feb-94 14:15:29 GMT\"       -- rfc850 format (no weekday)"
NSQ_SOURCE_LINE 00000364 " \"08-Feb-1994 14:15:29 GMT\"     -- broken rfc850 format (no weekday)"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 " \"1994-02-03 14:15:29 -0100\"    -- ISO 8601 format"
NSQ_SOURCE_LINE 00000367 " \"1994-02-03 14:15:29\"          -- zone is optional"
NSQ_SOURCE_LINE 00000368 " \"1994-02-03\"                   -- only date"
NSQ_SOURCE_LINE 00000369 " \"1994-02-03T14:15:29\"          -- Use T as separator"
NSQ_SOURCE_LINE 00000370 " \"19940203T141529Z\"             -- ISO 8601 compact format"
NSQ_SOURCE_LINE 00000371 " \"19940203\"                     -- only date"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 " \"08-Feb-94\"         -- old rfc850 HTTP format    (no weekday, no time)"
NSQ_SOURCE_LINE 00000374 " \"08-Feb-1994\"       -- broken rfc850 HTTP format (no weekday, no time)"
NSQ_SOURCE_LINE 00000375 " \"09 Feb 1994\"       -- proposed new HTTP format  (no weekday, no time)"
NSQ_SOURCE_LINE 00000376 " \"03/Feb/1994\"       -- common logfile format     (no time, no offset)"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 " \"Feb  3  1994\"      -- Unix 'ls -l' format"
NSQ_SOURCE_LINE 00000379 " \"Feb  3 17:03\"      -- Unix 'ls -l' format"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 " \"11-15-96  03:52PM\"   -- Windows 'dir' format"
NSQ_SOURCE_LINE 00000382 " \"11-15-1996  03:52PM\" -- Windows 'dir' format with four-digit year"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "The parser ignores leading and trailing whitespace.  It also allow the"
NSQ_SOURCE_LINE 00000385 "seconds to be missing and the month to be numerical in most formats."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "If the year is missing, then we assume that the date is the first"
NSQ_SOURCE_LINE 00000388 "matching date I<before> current month.  If the year is given with only"
NSQ_SOURCE_LINE 00000389 "2 digits, then parse_date() will select the century that makes the"
NSQ_SOURCE_LINE 00000390 "year closest to the current date."
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "=item time2iso( [$time] )"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "Same as time2str(), but returns a \"YYYY-MM-DD hh:mm:ss\"-formatted"
NSQ_SOURCE_LINE 00000395 "string representing time in the local time zone."
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=item time2isoz( [$time] )"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "Same as time2str(), but returns a \"YYYY-MM-DD hh:mm:ssZ\"-formatted"
NSQ_SOURCE_LINE 00000400 "string representing Universal Time."
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "=back"
NSQ_SOURCE_LINE 00000403 ""
