NSQ_SOURCE_LINE 00000001 "package Complete::File;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2021-02-08'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.443'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Complete::Common qw(:all);"
NSQ_SOURCE_LINE 00000011 "use Complete::Util qw(hashify_answer);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "require Exporter;"
NSQ_SOURCE_LINE 00000014 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000015 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000016 "                       complete_file"
NSQ_SOURCE_LINE 00000017 "                       complete_dir"
NSQ_SOURCE_LINE 00000018 "               );"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "our %SPEC;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "$SPEC{':package'} = {"
NSQ_SOURCE_LINE 00000023 "    v => 1.1,"
NSQ_SOURCE_LINE 00000024 "    summary => 'Completion routines related to files',"
NSQ_SOURCE_LINE 00000025 "};"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "$SPEC{complete_file} = {"
NSQ_SOURCE_LINE 00000028 "    v => 1.1,"
NSQ_SOURCE_LINE 00000029 "    summary => 'Complete file and directory from local filesystem',"
NSQ_SOURCE_LINE 00000030 "    args => {"
NSQ_SOURCE_LINE 00000031 "        %arg_word,"
NSQ_SOURCE_LINE 00000032 "        filter => {"
NSQ_SOURCE_LINE 00000033 "            summary => 'Only return items matching this filter',"
NSQ_SOURCE_LINE 00000034 "            description => <<'_',"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "Filter can either be a string or a code."
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "For string filter, you can specify a pipe-separated groups of sequences of these"
NSQ_SOURCE_LINE 00000039 "characters: f, d, r, w, x. Dash can appear anywhere in the sequence to mean"
NSQ_SOURCE_LINE 00000040 "not/negate. An example: `f` means to only show regular files, `-f` means only"
NSQ_SOURCE_LINE 00000041 "show non-regular files, `drwx` means to show only directories which are"
NSQ_SOURCE_LINE 00000042 "readable, writable, and executable (cd-able). `wf|wd` means writable regular"
NSQ_SOURCE_LINE 00000043 "files or writable directories."
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "For code filter, you supply a coderef. The coderef will be called for each item"
NSQ_SOURCE_LINE 00000046 "with these arguments: `$name`. It should return true if it wants the item to be"
NSQ_SOURCE_LINE 00000047 "included."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "_"
NSQ_SOURCE_LINE 00000050 "            schema  => ['any*' => {of => ['str*', 'code*']}],"
NSQ_SOURCE_LINE 00000051 "            tags => ['category:filtering'],"
NSQ_SOURCE_LINE 00000052 "        },"
NSQ_SOURCE_LINE 00000053 "        file_regex_filter => {"
NSQ_SOURCE_LINE 00000054 "            summary => 'Filter shortcut for file regex',"
NSQ_SOURCE_LINE 00000055 "            description => <<'_',"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "This is a shortcut for constructing a filter. So instead of using `filter`, you"
NSQ_SOURCE_LINE 00000058 "use this option. This will construct a filter of including only directories or"
NSQ_SOURCE_LINE 00000059 "regular files, and the file must match a regex pattern. This use-case is common."
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "_"
NSQ_SOURCE_LINE 00000062 "            schema => 're*',"
NSQ_SOURCE_LINE 00000063 "            tags => ['category:filtering'],"
NSQ_SOURCE_LINE 00000064 "        },"
NSQ_SOURCE_LINE 00000065 "        exclude_dir => {"
NSQ_SOURCE_LINE 00000066 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000067 "            description => <<'_',"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "This is also an alternative to specifying full `filter`. Set this to true if you"
NSQ_SOURCE_LINE 00000070 "do not want directories."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "If you only want directories, take a look at `complete_dir()`."
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "_"
NSQ_SOURCE_LINE 00000075 "            tags => ['category:filtering'],"
NSQ_SOURCE_LINE 00000076 "        },"
NSQ_SOURCE_LINE 00000077 "        file_ext_filter => {"
NSQ_SOURCE_LINE 00000078 "            schema => ['any*', of=>['re*', ['array*',of=>'str*']]],"
NSQ_SOURCE_LINE 00000079 "            description => <<'_',"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "This is also an alternative to specifying full `filter` or `file_regex_filter`."
NSQ_SOURCE_LINE 00000082 "You can set this to a regex or a set of extensions to accept. Note that like in"
NSQ_SOURCE_LINE 00000083 "`file_regex_filter`, directories of any name is also still allowed."
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "_"
NSQ_SOURCE_LINE 00000086 "            tags => ['category:filtering'],"
NSQ_SOURCE_LINE 00000087 "        },"
NSQ_SOURCE_LINE 00000088 "        starting_path => {"
NSQ_SOURCE_LINE 00000089 "            schema  => 'str*',"
NSQ_SOURCE_LINE 00000090 "            default => '.',"
NSQ_SOURCE_LINE 00000091 "        },"
NSQ_SOURCE_LINE 00000092 "        handle_tilde => {"
NSQ_SOURCE_LINE 00000093 "            schema  => 'bool',"
NSQ_SOURCE_LINE 00000094 "            default => 1,"
NSQ_SOURCE_LINE 00000095 "        },"
NSQ_SOURCE_LINE 00000096 "        allow_dot => {"
NSQ_SOURCE_LINE 00000097 "            summary => 'If turned off, will not allow \".\" or \"..\" in path',"
NSQ_SOURCE_LINE 00000098 "            description => <<'_',"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "This is most useful when combined with `starting_path` option to prevent user"
NSQ_SOURCE_LINE 00000101 "going up/outside the starting path."
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "_"
NSQ_SOURCE_LINE 00000104 "            schema  => 'bool',"
NSQ_SOURCE_LINE 00000105 "            default => 1,"
NSQ_SOURCE_LINE 00000106 "        },"
NSQ_SOURCE_LINE 00000107 "        recurse => {"
NSQ_SOURCE_LINE 00000108 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000109 "            cmdline_aliases => {r=>{}},"
NSQ_SOURCE_LINE 00000110 "        },"
NSQ_SOURCE_LINE 00000111 "        recurse_matching => {"
NSQ_SOURCE_LINE 00000112 "            schema => ['str*', in=>['level-by-level', 'all-at-once']],"
NSQ_SOURCE_LINE 00000113 "            default => 'level-by-level',"
NSQ_SOURCE_LINE 00000114 "        },"
NSQ_SOURCE_LINE 00000115 "        exclude_leaf => {"
NSQ_SOURCE_LINE 00000116 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000117 "        },"
NSQ_SOURCE_LINE 00000118 "        exclude_dir => {"
NSQ_SOURCE_LINE 00000119 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000120 "        },"
NSQ_SOURCE_LINE 00000121 "    },"
NSQ_SOURCE_LINE 00000122 "    args_rels => {"
NSQ_SOURCE_LINE 00000123 "        dep_all => [recurse_matching => ['recurse']],"
NSQ_SOURCE_LINE 00000124 "    },"
NSQ_SOURCE_LINE 00000125 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000126 "    result => {"
NSQ_SOURCE_LINE 00000127 "        schema => 'array',"
NSQ_SOURCE_LINE 00000128 "    },"
NSQ_SOURCE_LINE 00000129 "};"
NSQ_SOURCE_LINE 00000130 "sub complete_file {"
NSQ_SOURCE_LINE 00000131 "    require Complete::Path;"
NSQ_SOURCE_LINE 00000132 "    require Encode;"
NSQ_SOURCE_LINE 00000133 "    require File::Glob;"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "    my %args   = @_;"
NSQ_SOURCE_LINE 00000136 "    my $word   = $args{word} // \"\";"
NSQ_SOURCE_LINE 00000137 "    my $handle_tilde = $args{handle_tilde} // 1;"
NSQ_SOURCE_LINE 00000138 "    my $allow_dot   = $args{allow_dot} // 1;"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "    # if word is starts with \"~/\" or \"~foo/\" replace it temporarily with user's"
NSQ_SOURCE_LINE 00000141 "    # name (so we can restore it back at the end). this is to mimic bash"
NSQ_SOURCE_LINE 00000142 "    # support. note that bash does not support case-insensitivity for \"foo\"."
NSQ_SOURCE_LINE 00000143 "    my $result_prefix;"
NSQ_SOURCE_LINE 00000144 "    my $starting_path = $args{starting_path} // '.';"
NSQ_SOURCE_LINE 00000145 "    if ($handle_tilde && $word =~ s!\\A(~[^/]*)/!!) {"
NSQ_SOURCE_LINE 00000146 "        $result_prefix = \"$1/\";"
NSQ_SOURCE_LINE 00000147 "        my @dir = File::Glob::bsd_glob($1); # glob will expand ~foo to /home/foo"
NSQ_SOURCE_LINE 00000148 "        return [] unless @dir;"
NSQ_SOURCE_LINE 00000149 "        $starting_path = Encode::decode('UTF-8', $dir[0]);"
NSQ_SOURCE_LINE 00000150 "    } elsif ($allow_dot && $word =~ s!\\A((?:\\.\\.?/+)+|/+)!!) {"
NSQ_SOURCE_LINE 00000151 "        # just an optimization to skip sequences of '../'"
NSQ_SOURCE_LINE 00000152 "        $starting_path = $1;"
NSQ_SOURCE_LINE 00000153 "        $result_prefix = $1;"
NSQ_SOURCE_LINE 00000154 "        $starting_path =~ s#/+\\z## unless $starting_path =~ m!\\A/!;"
NSQ_SOURCE_LINE 00000155 "    }"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    # bail if we don't allow dot and the path contains dot"
NSQ_SOURCE_LINE 00000158 "    return [] if !$allow_dot &&"
NSQ_SOURCE_LINE 00000159 "        $word =~ m!(?:\\A|/)\\.\\.?(?:\\z|/)!;"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    # prepare list_func"
NSQ_SOURCE_LINE 00000162 "    my $list = sub {"
NSQ_SOURCE_LINE 00000163 "        my ($path, $intdir, $isint) = @_;"
NSQ_SOURCE_LINE 00000164 "        opendir my($dh), $path or return undef;"
NSQ_SOURCE_LINE 00000165 "        my @res;"
NSQ_SOURCE_LINE 00000166 "        for (sort readdir $dh) {"
NSQ_SOURCE_LINE 00000167 "            # skip . and .. if leaf is empty, like in bash"
NSQ_SOURCE_LINE 00000168 "            next if ($_ eq '.' || $_ eq '..') && $intdir eq '';"
NSQ_SOURCE_LINE 00000169 "            next if $isint && !(-d \"$path/$_\");"
NSQ_SOURCE_LINE 00000170 "            push @res, Encode::decode('UTF-8', $_);"
NSQ_SOURCE_LINE 00000171 "        }"
NSQ_SOURCE_LINE 00000172 "        \\@res;"
NSQ_SOURCE_LINE 00000173 "    };"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    # prepare filter_func"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    # from the filter option"
NSQ_SOURCE_LINE 00000178 "    my $filter;"
NSQ_SOURCE_LINE 00000179 "    if ($args{filter} && !ref($args{filter})) {"
NSQ_SOURCE_LINE 00000180 "        my @seqs = split /\\s*\\|\\s*/, $args{filter};"
NSQ_SOURCE_LINE 00000181 "        $filter = sub {"
NSQ_SOURCE_LINE 00000182 "            my $name = shift;"
NSQ_SOURCE_LINE 00000183 "            my @st = stat($name) or return 0;"
NSQ_SOURCE_LINE 00000184 "            my $mode = $st[2];"
NSQ_SOURCE_LINE 00000185 "            my $pass;"
NSQ_SOURCE_LINE 00000186 "          SEQ:"
NSQ_SOURCE_LINE 00000187 "            for my $seq (@seqs) {"
NSQ_SOURCE_LINE 00000188 "                my $neg = sub { $_[0] };"
NSQ_SOURCE_LINE 00000189 "                for my $c (split //, $seq) {"
NSQ_SOURCE_LINE 00000190 "                    if    ($c eq '-') { $neg = sub { $_[0] ? 0 : 1 } }"
NSQ_SOURCE_LINE 00000191 "                    elsif ($c eq 'r') { next SEQ unless $neg->($mode & 0400) }"
NSQ_SOURCE_LINE 00000192 "                    elsif ($c eq 'w') { next SEQ unless $neg->($mode & 0200) }"
NSQ_SOURCE_LINE 00000193 "                    elsif ($c eq 'x') { next SEQ unless $neg->($mode & 0100) }"
NSQ_SOURCE_LINE 00000194 "                    elsif ($c eq 'f') { next SEQ unless $neg->($mode & 0100000)}"
NSQ_SOURCE_LINE 00000195 "                    elsif ($c eq 'd') { next SEQ unless $neg->($mode & 0040000)}"
NSQ_SOURCE_LINE 00000196 "                    else {"
NSQ_SOURCE_LINE 00000197 "                        die \"Unknown character in filter: $c (in $seq)\";"
NSQ_SOURCE_LINE 00000198 "                    }"
NSQ_SOURCE_LINE 00000199 "                }"
NSQ_SOURCE_LINE 00000200 "                $pass = 1; last SEQ;"
NSQ_SOURCE_LINE 00000201 "            }"
NSQ_SOURCE_LINE 00000202 "            $pass;"
NSQ_SOURCE_LINE 00000203 "        };"
NSQ_SOURCE_LINE 00000204 "    } elsif ($args{filter} && ref($args{filter}) eq 'CODE') {"
NSQ_SOURCE_LINE 00000205 "        $filter = $args{filter};"
NSQ_SOURCE_LINE 00000206 "    }"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    # from the file_regex_filter option"
NSQ_SOURCE_LINE 00000209 "    my $filter_fregex;"
NSQ_SOURCE_LINE 00000210 "    if ($args{file_regex_filter}) {"
NSQ_SOURCE_LINE 00000211 "        $filter_fregex = sub {"
NSQ_SOURCE_LINE 00000212 "            my $name = shift;"
NSQ_SOURCE_LINE 00000213 "            return 1 if -d $name;"
NSQ_SOURCE_LINE 00000214 "            return 0 unless -f _;"
NSQ_SOURCE_LINE 00000215 "            return 1 if $name =~ $args{file_regex_filter};"
NSQ_SOURCE_LINE 00000216 "            0;"
NSQ_SOURCE_LINE 00000217 "        };"
NSQ_SOURCE_LINE 00000218 "    }"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "    # from the file_ext_filter option"
NSQ_SOURCE_LINE 00000221 "    my $filter_fext;"
NSQ_SOURCE_LINE 00000222 "    if ($args{file_ext_filter} && ref $args{file_ext_filter} eq 'Regexp') {"
NSQ_SOURCE_LINE 00000223 "        $filter_fext = sub {"
NSQ_SOURCE_LINE 00000224 "            my $name = shift;"
NSQ_SOURCE_LINE 00000225 "            return 1 if -d $name;"
NSQ_SOURCE_LINE 00000226 "            return 0 unless -f _;"
NSQ_SOURCE_LINE 00000227 "            my $ext = $name =~ /\\.(\\w+)\\z/ ? $1 : '';"
NSQ_SOURCE_LINE 00000228 "            return 1 if $ext =~ $args{file_ext_filter};"
NSQ_SOURCE_LINE 00000229 "            0;"
NSQ_SOURCE_LINE 00000230 "        };"
NSQ_SOURCE_LINE 00000231 "    } elsif ($args{file_ext_filter} && ref $args{file_ext_filter} eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000232 "        $filter_fext = sub {"
NSQ_SOURCE_LINE 00000233 "            my $name = shift;"
NSQ_SOURCE_LINE 00000234 "            return 1 if -d $name;"
NSQ_SOURCE_LINE 00000235 "            return 0 unless -f _;"
NSQ_SOURCE_LINE 00000236 "            my $ext = $name =~ /\\.(\\w+)\\z/ ? $1 : '';"
NSQ_SOURCE_LINE 00000237 "            if ($Complete::Common::OPT_CI) {"
NSQ_SOURCE_LINE 00000238 "                $ext = lc($ext);"
NSQ_SOURCE_LINE 00000239 "                for my $e (@{ $args{file_ext_filter} }) {"
NSQ_SOURCE_LINE 00000240 "                    return 1 if $ext eq lc($e);"
NSQ_SOURCE_LINE 00000241 "                }"
NSQ_SOURCE_LINE 00000242 "            } else {"
NSQ_SOURCE_LINE 00000243 "                for my $e (@{ $args{file_ext_filter} }) {"
NSQ_SOURCE_LINE 00000244 "                    return 1 if $ext eq $e;"
NSQ_SOURCE_LINE 00000245 "                }"
NSQ_SOURCE_LINE 00000246 "            }"
NSQ_SOURCE_LINE 00000247 "            0;"
NSQ_SOURCE_LINE 00000248 "        };"
NSQ_SOURCE_LINE 00000249 "    }"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "    # from _dir (used by complete_dir)"
NSQ_SOURCE_LINE 00000252 "    my $filter_dir;"
NSQ_SOURCE_LINE 00000253 "    if ($args{_dir}) {"
NSQ_SOURCE_LINE 00000254 "        $filter_dir = sub { return 0 unless (-d $_[0]); 1 };"
NSQ_SOURCE_LINE 00000255 "    }"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    # from exclude_dir option"
NSQ_SOURCE_LINE 00000258 "    my $filter_xdir;"
NSQ_SOURCE_LINE 00000259 "    if ($args{exclude_dir}) {"
NSQ_SOURCE_LINE 00000260 "        $filter_xdir = sub { return 0 if (-d $_[0]); 1 };"
NSQ_SOURCE_LINE 00000261 "    }"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "    # final filter sub"
NSQ_SOURCE_LINE 00000264 "    my $final_filter = sub {"
NSQ_SOURCE_LINE 00000265 "        my $name = shift;"
NSQ_SOURCE_LINE 00000266 "        if ($filter_dir)    { return 0 unless $filter_dir->($name)    }"
NSQ_SOURCE_LINE 00000267 "        if ($filter_xdir)   { return 0 unless $filter_xdir->($name)   }"
NSQ_SOURCE_LINE 00000268 "        if ($filter)        { return 0 unless $filter->($name)        }"
NSQ_SOURCE_LINE 00000269 "        if ($filter_fregex) { return 0 unless $filter_fregex->($name) }"
NSQ_SOURCE_LINE 00000270 "        if ($filter_fext)   { return 0 unless $filter_fext->($name)   }"
NSQ_SOURCE_LINE 00000271 "        1;"
NSQ_SOURCE_LINE 00000272 "    };"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "    my $compres = Complete::Path::complete_path("
NSQ_SOURCE_LINE 00000275 "        word => $word,"
NSQ_SOURCE_LINE 00000276 "        list_func => $list,"
NSQ_SOURCE_LINE 00000277 "        is_dir_func => sub { -d $_[0] },"
NSQ_SOURCE_LINE 00000278 "        filter_func => $final_filter,"
NSQ_SOURCE_LINE 00000279 "        starting_path => $starting_path,"
NSQ_SOURCE_LINE 00000280 "        result_prefix => $result_prefix,"
NSQ_SOURCE_LINE 00000281 "        recurse => $args{recurse},"
NSQ_SOURCE_LINE 00000282 "        recurse_matching => $args{recurse_matching},"
NSQ_SOURCE_LINE 00000283 "        exclude_leaf => $args{exclude_leaf},"
NSQ_SOURCE_LINE 00000284 "        exclude_nonleaf => $args{exclude_nonleaf} // $args{exclude_dir},"
NSQ_SOURCE_LINE 00000285 "    );"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    # XXX why doesn't Complete::Path return hash answer with path_sep? we add"
NSQ_SOURCE_LINE 00000288 "    # workaround here to enable path mode."
NSQ_SOURCE_LINE 00000289 "    hashify_answer($compres, {path_sep=>'/'});"
NSQ_SOURCE_LINE 00000290 "}"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "$SPEC{complete_dir} = do {"
NSQ_SOURCE_LINE 00000293 "    my $spec = {%{ $SPEC{complete_file} }}; # shallow copy"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "    $spec->{summary} = 'Complete directory from local filesystem '."
NSQ_SOURCE_LINE 00000296 "        '(wrapper for complete_dir() that only picks directories)';"
NSQ_SOURCE_LINE 00000297 "    $spec->{args} = { %{$spec->{args}} }; # shallow copy of args"
NSQ_SOURCE_LINE 00000298 "    delete $spec->{args}{file_regex_filter};"
NSQ_SOURCE_LINE 00000299 "    delete $spec->{args}{file_ext_filter};"
NSQ_SOURCE_LINE 00000300 "    delete $spec->{args}{exclude_dir};"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "    $spec;"
NSQ_SOURCE_LINE 00000303 "};"
NSQ_SOURCE_LINE 00000304 "sub complete_dir {"
NSQ_SOURCE_LINE 00000305 "    my %args = @_;"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "    complete_file(%args, _dir=>1);"
NSQ_SOURCE_LINE 00000308 "}"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "1;"
NSQ_SOURCE_LINE 00000311 "# ABSTRACT: Completion routines related to files"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "__END__"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "=pod"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=head1 NAME"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "Complete::File - Completion routines related to files"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=head1 VERSION"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "This document describes version 0.443 of Complete::File (from Perl distribution Complete-File), released on 2021-02-08."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=head2 complete_dir"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "Usage:"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 " complete_dir(%args) -> array"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "Complete directory from local filesystem (wrapper for complete_dir() that only picks directories)."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "=over 4"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "=item * B<allow_dot> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "If turned off, will not allow \".\" or \"..\" in path."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "This is most useful when combined with C<starting_path> option to prevent user"
NSQ_SOURCE_LINE 00000351 "going up/outside the starting path."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "=item * B<exclude_leaf> => I<bool>"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "=item * B<filter> => I<str|code>"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "Only return items matching this filter."
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "Filter can either be a string or a code."
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "For string filter, you can specify a pipe-separated groups of sequences of these"
NSQ_SOURCE_LINE 00000362 "characters: f, d, r, w, x. Dash can appear anywhere in the sequence to mean"
NSQ_SOURCE_LINE 00000363 "not/negate. An example: C<f> means to only show regular files, C<-f> means only"
NSQ_SOURCE_LINE 00000364 "show non-regular files, C<drwx> means to show only directories which are"
NSQ_SOURCE_LINE 00000365 "readable, writable, and executable (cd-able). C<wf|wd> means writable regular"
NSQ_SOURCE_LINE 00000366 "files or writable directories."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "For code filter, you supply a coderef. The coderef will be called for each item"
NSQ_SOURCE_LINE 00000369 "with these arguments: C<$name>. It should return true if it wants the item to be"
NSQ_SOURCE_LINE 00000370 "included."
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=item * B<handle_tilde> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=item * B<recurse> => I<bool>"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "=item * B<recurse_matching> => I<str> (default: \"level-by-level\")"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "=item * B<starting_path> => I<str> (default: \".\")"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=item * B<word>* => I<str> (default: \"\")"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "Word to complete."
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=back"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "Return value:  (array)"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "=head2 complete_file"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "Usage:"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 " complete_file(%args) -> array"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "Complete file and directory from local filesystem."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=over 4"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "=item * B<allow_dot> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "If turned off, will not allow \".\" or \"..\" in path."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "This is most useful when combined with C<starting_path> option to prevent user"
NSQ_SOURCE_LINE 00000410 "going up/outside the starting path."
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "=item * B<exclude_dir> => I<bool>"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "=item * B<exclude_leaf> => I<bool>"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "=item * B<file_ext_filter> => I<re|array[str]>"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "This is also an alternative to specifying full C<filter> or C<file_regex_filter>."
NSQ_SOURCE_LINE 00000419 "You can set this to a regex or a set of extensions to accept. Note that like in"
NSQ_SOURCE_LINE 00000420 "C<file_regex_filter>, directories of any name is also still allowed."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "=item * B<file_regex_filter> => I<re>"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "Filter shortcut for file regex."
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "This is a shortcut for constructing a filter. So instead of using C<filter>, you"
NSQ_SOURCE_LINE 00000427 "use this option. This will construct a filter of including only directories or"
NSQ_SOURCE_LINE 00000428 "regular files, and the file must match a regex pattern. This use-case is common."
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "=item * B<filter> => I<str|code>"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "Only return items matching this filter."
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "Filter can either be a string or a code."
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "For string filter, you can specify a pipe-separated groups of sequences of these"
NSQ_SOURCE_LINE 00000437 "characters: f, d, r, w, x. Dash can appear anywhere in the sequence to mean"
NSQ_SOURCE_LINE 00000438 "not/negate. An example: C<f> means to only show regular files, C<-f> means only"
NSQ_SOURCE_LINE 00000439 "show non-regular files, C<drwx> means to show only directories which are"
NSQ_SOURCE_LINE 00000440 "readable, writable, and executable (cd-able). C<wf|wd> means writable regular"
NSQ_SOURCE_LINE 00000441 "files or writable directories."
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "For code filter, you supply a coderef. The coderef will be called for each item"
NSQ_SOURCE_LINE 00000444 "with these arguments: C<$name>. It should return true if it wants the item to be"
NSQ_SOURCE_LINE 00000445 "included."
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "=item * B<handle_tilde> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "=item * B<recurse> => I<bool>"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "=item * B<recurse_matching> => I<str> (default: \"level-by-level\")"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "=item * B<starting_path> => I<str> (default: \".\")"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=item * B<word>* => I<str> (default: \"\")"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "Word to complete."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "=back"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "Return value:  (array)"
NSQ_SOURCE_LINE 00000463 ""
