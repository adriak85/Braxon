NSQ_SOURCE_LINE 00000001 "package Data::Clean::ForJSON;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2019-11-26'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.395'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use parent qw(Data::Clean);"
NSQ_SOURCE_LINE 00000011 "use vars qw($creating_singleton);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000015 "                       clean_json_in_place"
NSQ_SOURCE_LINE 00000016 "                       clone_and_clean_json"
NSQ_SOURCE_LINE 00000017 "               );"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "sub new {"
NSQ_SOURCE_LINE 00000020 "    my ($class, %opts) = @_;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    if (!%opts && !$creating_singleton) {"
NSQ_SOURCE_LINE 00000023 "        warn \"You are creating a new \".__PACKAGE__.\" object without customizing options. \"."
NSQ_SOURCE_LINE 00000024 "            \"You probably want to call get_cleanser() yet to get a singleton instead?\";"
NSQ_SOURCE_LINE 00000025 "    }"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    $opts{DateTime}  //= [call_method => 'epoch'];"
NSQ_SOURCE_LINE 00000028 "    $opts{'Time::Moment'} //= [call_method => 'epoch'];"
NSQ_SOURCE_LINE 00000029 "    $opts{'Math::BigInt'} //= [call_method => 'bstr'];"
NSQ_SOURCE_LINE 00000030 "    $opts{Regexp}    //= ['stringify'];"
NSQ_SOURCE_LINE 00000031 "    $opts{version}   //= ['stringify'];"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    $opts{SCALAR}    //= ['deref_scalar'];"
NSQ_SOURCE_LINE 00000034 "    $opts{-ref}      //= ['replace_with_ref'];"
NSQ_SOURCE_LINE 00000035 "    $opts{-circular} //= ['clone'];"
NSQ_SOURCE_LINE 00000036 "    $opts{-obj}      //= ['unbless'];"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    $opts{'!recurse_obj'} //= 1;"
NSQ_SOURCE_LINE 00000039 "    $class->SUPER::new(%opts);"
NSQ_SOURCE_LINE 00000040 "}"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "sub get_cleanser {"
NSQ_SOURCE_LINE 00000043 "    my $class = shift;"
NSQ_SOURCE_LINE 00000044 "    local $creating_singleton = 1;"
NSQ_SOURCE_LINE 00000045 "    state $singleton = $class->new;"
NSQ_SOURCE_LINE 00000046 "    $singleton;"
NSQ_SOURCE_LINE 00000047 "}"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "sub clean_json_in_place {"
NSQ_SOURCE_LINE 00000050 "    __PACKAGE__->get_cleanser->clean_in_place(@_);"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "sub clone_and_clean_json {"
NSQ_SOURCE_LINE 00000054 "    __PACKAGE__->get_cleanser->clone_and_clean(@_);"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "1;"
NSQ_SOURCE_LINE 00000058 "# ABSTRACT: Clean data so it is safe to output to JSON"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "__END__"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=pod"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=head1 NAME"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "Data::Clean::ForJSON - Clean data so it is safe to output to JSON"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=head1 VERSION"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "This document describes version 0.395 of Data::Clean::ForJSON (from Perl distribution Data-Clean-ForJSON), released on 2019-11-26."
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 " use Data::Clean::ForJSON;"
NSQ_SOURCE_LINE 00000077 " my $cleanser = Data::Clean::ForJSON->get_cleanser;"
NSQ_SOURCE_LINE 00000078 " my $data     = { code=>sub {}, re=>qr/abc/i };"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 " my $cleaned;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 " # modifies data in-place"
NSQ_SOURCE_LINE 00000083 " $cleaned = $cleanser->clean_in_place($data);"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 " # ditto, but deep clone first, return"
NSQ_SOURCE_LINE 00000086 " $cleaned = $cleanser->clone_and_clean($data);"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 " # now output it"
NSQ_SOURCE_LINE 00000089 " use JSON;"
NSQ_SOURCE_LINE 00000090 " print encode_json($cleaned); # prints '{\"code\":\"CODE\",\"re\":\"(?^i:abc)\"}'"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "Functional shortcuts:"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 " use Data::Clean::ForJSON qw(clean_json_in_place clone_and_clean_json);"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 " # equivalent to Data::Clean::ForJSON->get_cleanser->clean_in_place($data)"
NSQ_SOURCE_LINE 00000097 " clean_json_in_place($data);"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 " # equivalent to Data::Clean::ForJSON->get_cleanser->clone_and_clean($data)"
NSQ_SOURCE_LINE 00000100 " $cleaned = clone_and_clean_json($data);"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "This class cleans data from anything that might be problematic when encoding to"
NSQ_SOURCE_LINE 00000105 "JSON. This includes coderefs, globs, and so on. Here's what it will do by"
NSQ_SOURCE_LINE 00000106 "default:"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "=over"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=item * Change DateTime and Time::Moment object to its epoch value"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=item * Change Regexp and version object to its string value"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=item * Change scalar references (e.g. \\1) to its scalar value (e.g. 1)"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=item * Change other references (non-hash, non-array) to its ref() value (e.g. \"GLOB\", \"CODE\")"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=item * Clone circular references"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "With a default limit of 1, meaning that if a reference is first seen again for"
NSQ_SOURCE_LINE 00000121 "the first time, it will be cloned. But if it is seen again for the second time,"
NSQ_SOURCE_LINE 00000122 "it will be replaced with \"CIRCULAR\"."
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "To change the default limit, customize your cleanser object:"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 " $cleanser = Data::Clean::ForJSON->new("
NSQ_SOURCE_LINE 00000127 "     -circular => [\"clone\", 4],"
NSQ_SOURCE_LINE 00000128 " );"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "or you can perform other action for circular references, see L<Data::Clean> for"
NSQ_SOURCE_LINE 00000131 "more details."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=item * Unbless other types of objects"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=back"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "Cleaning recurses into objects."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "Data that has been cleaned will probably not be convertible back to the"
NSQ_SOURCE_LINE 00000140 "original, due to information loss (for example, coderefs converted to string"
NSQ_SOURCE_LINE 00000141 "C<\"CODE\">)."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "The design goals are good performance, good defaults, and just enough"
NSQ_SOURCE_LINE 00000144 "flexibility. The original use-case is for returning JSON response in HTTP API"
NSQ_SOURCE_LINE 00000145 "service."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "This module is significantly faster than modules like L<Data::Rmap> or"
NSQ_SOURCE_LINE 00000148 "L<Data::Visitor::Callback> because with something like Data::Rmap you repeatedly"
NSQ_SOURCE_LINE 00000149 "invoke callback for each data item. This module, on the other hand, generates a"
NSQ_SOURCE_LINE 00000150 "cleanser code using eval(), using native Perl for() loops."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "If C<LOG_CLEANSER_CODE> environment is set to true, the generated cleanser code"
NSQ_SOURCE_LINE 00000153 "will be logged using L<Log::ger> at trace level. You can see it, e.g. using"
NSQ_SOURCE_LINE 00000154 "L<Log::ger::Output::Screen>:"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 " % LOG_CLEANSER_CODE=1 perl -MLog::ger::Output=Screen -MLog::ger::Level::trace -MData::Clean::ForJSON \\"
NSQ_SOURCE_LINE 00000157 "   -e'$c=Data::Clean::ForJSON->new; ...'"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "None of the functions are exported by default."
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=head2 clean_json_in_place($data)"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "A shortcut for:"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 " Data::Clean::ForJSON->get_cleanser->clean_in_place($data)"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=head2 clone_and_clean_json($data) => $cleaned"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "A shortcut for:"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 " $cleaned = Data::Clean::ForJSON->get_cleanser->clone_and_clean($data)"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=head1 METHODS"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=head2 CLASS->get_cleanser => $obj"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "Return a singleton instance, with default options. Use C<new()> if you want to"
NSQ_SOURCE_LINE 00000180 "customize options."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head2 CLASS->new() => $obj"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "Create a new instance."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=head2 $obj->clean_in_place($data) => $cleaned"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "Clean $data. Modify data in-place."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=head2 $obj->clone_and_clean($data) => $cleaned"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "Clean $data. Clone $data first."
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=head1 FAQ"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=head2 Why clone/modify? Why not directly output JSON?"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "So that the data can be used for other stuffs, like outputting to YAML, etc."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=head2 Why is it slow?"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "If you use C<new()> instead of C<get_cleanser()>, make sure that you do not"
NSQ_SOURCE_LINE 00000203 "construct the Data::Clean::ForJSON object repeatedly, as the constructor"
NSQ_SOURCE_LINE 00000204 "generates the cleanser code first using eval(). A short benchmark (run on my"
NSQ_SOURCE_LINE 00000205 "slow Atom netbook):"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 " % bench -MData::Clean::ForJSON -b'$c=Data::Clean::ForJSON->new' \\"
NSQ_SOURCE_LINE 00000208 "     'Data::Clean::ForJSON->new->clone_and_clean([1..100])' \\"
NSQ_SOURCE_LINE 00000209 "     '$c->clone_and_clean([1..100])'"
NSQ_SOURCE_LINE 00000210 " Benchmarking sub { Data::Clean::ForJSON->new->clean_in_place([1..100]) }, sub { $c->clean_in_place([1..100]) } ..."
NSQ_SOURCE_LINE 00000211 " a: 302 calls (291.3/s), 1.037s (3.433ms/call)"
NSQ_SOURCE_LINE 00000212 " b: 7043 calls (4996/s), 1.410s (0.200ms/call)"
NSQ_SOURCE_LINE 00000213 " Fastest is b (17.15x a)"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "Second, you can turn off some checks if you are sure you will not be getting bad"
NSQ_SOURCE_LINE 00000216 "data. For example, if you know that your input will not contain circular"
NSQ_SOURCE_LINE 00000217 "references, you can turn off circular detection:"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 " $cleanser = Data::Clean::ForJSON->new(-circular => 0);"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "Benchmark:"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 " $ perl -MData::Clean::ForJSON -MBench -E '"
NSQ_SOURCE_LINE 00000224 "   $data = [[1],[2],[3],[4],[5]];"
NSQ_SOURCE_LINE 00000225 "   bench {"
NSQ_SOURCE_LINE 00000226 "       circ   => sub { state $c = Data::Clean::ForJSON->new;               $c->clone_and_clean($data) },"
NSQ_SOURCE_LINE 00000227 "       nocirc => sub { state $c = Data::Clean::ForJSON->new(-circular=>0); $c->clone_and_clean($data) }"
NSQ_SOURCE_LINE 00000228 "   }, -1'"
NSQ_SOURCE_LINE 00000229 " circ: 9456 calls (9425/s), 1.003s (0.106ms/call)"
NSQ_SOURCE_LINE 00000230 " nocirc: 13161 calls (12885/s), 1.021s (0.0776ms/call)"
NSQ_SOURCE_LINE 00000231 " Fastest is nocirc (1.367x circ)"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "The less number of checks you do, the faster the cleansing process will be."
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=head2 Why am I getting 'Not a CODE reference at lib/Data/Clean.pm line xxx'?"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "[2013-08-07 ] This error message is from Data::Clone::clone() when it is cloning"
NSQ_SOURCE_LINE 00000238 "an object. If you are cleaning objects, instead of using clone_and_clean(), try"
NSQ_SOURCE_LINE 00000239 "using clean_in_place(). Or, clone your data first using something else like"
NSQ_SOURCE_LINE 00000240 "L<Sereal>."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head2 LOG_CLEANSER_CODE"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "Bool. Can be set to true to log cleanser code using L<Log::ger> at C<trace>"
NSQ_SOURCE_LINE 00000247 "level."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "Please visit the project's homepage at L<https://metacpan.org/release/Data-Clean-ForJSON>."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "Source repository is at L<https://github.com/perlancar/perl-Data-Clean-ForJSON>."
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=head1 BUGS"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=Data-Clean-ForJSON>"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000262 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000263 "feature."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "L<Data::Rmap>"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "L<Data::Visitor::Callback>"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "L<Data::Abridge> is similar in goal, which is to let Perl data structures (which"
NSQ_SOURCE_LINE 00000272 "might contain stuffs unsupported in JSON) be encodeable to JSON. But unlike"
NSQ_SOURCE_LINE 00000273 "Data::Clean::ForJSON, it has some (currently) non-configurable rules, like"
NSQ_SOURCE_LINE 00000274 "changing a coderef with a hash C<< {CODE=>'\\&main::__ANON__'} >> or a scalar ref"
NSQ_SOURCE_LINE 00000275 "with C<< {SCALAR=>'value'} >> and so on. Note that the abridging process is"
NSQ_SOURCE_LINE 00000276 "similarly unidirectional (you cannot convert back the original Perl data"
NSQ_SOURCE_LINE 00000277 "structure)."
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "Some benchmarks in L<Bencher::Scenarios::DataCleansing>. You can see that"
NSQ_SOURCE_LINE 00000280 "Data::Clean::ForJSON can be several times faster than, say, Data::Rmap."
NSQ_SOURCE_LINE 00000281 ""
