NSQ_SOURCE_LINE 00000001 "package List::BinarySearch::XS;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.008000;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "require Exporter;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "# Items to export into callers namespace by default."
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our @EXPORT = qw( );  ## no critic(export)"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw( binsearch binsearch_pos );"
NSQ_SOURCE_LINE 00000015 "our %EXPORT_TAGS = ( all => \\@EXPORT_OK );"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "our $VERSION = '0.09';"
NSQ_SOURCE_LINE 00000019 "our $XS_VERSION = $VERSION;"
NSQ_SOURCE_LINE 00000020 "require XSLoader;"
NSQ_SOURCE_LINE 00000021 "XSLoader::load('List::BinarySearch::XS', $VERSION);"
NSQ_SOURCE_LINE 00000022 "#$VERSION = eval $VERSION; ## no critic(eval)"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "# Preloaded methods go here."
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "1;"
NSQ_SOURCE_LINE 00000028 "__END__"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "=head1 NAME"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "List::BinarySearch::XS - Binary Search a sorted array with XS routines."
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "This module performs a binary search on arrays.  XS code is used for the search"
NSQ_SOURCE_LINE 00000038 "routines to facilitate optimal performance."
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "Examples:"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "    # Import all functions."
NSQ_SOURCE_LINE 00000043 "    use List::BinarySearch::XS qw( :all );"
NSQ_SOURCE_LINE 00000044 "    # or be explicit..."
NSQ_SOURCE_LINE 00000045 "    use List::BinarySearch::XS qw( binsearch  binsearch_pos );"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    # Sample data."
NSQ_SOURCE_LINE 00000048 "    @num_array =   ( 100, 200, 300, 400, 500 );"
NSQ_SOURCE_LINE 00000049 "    @str_array = qw( Bach Beethoven Brahms Mozart Schubert );"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    # Find the lowest index of a matching element."
NSQ_SOURCE_LINE 00000053 "    $index = binsearch {$a <=> $b} 300, @num_array;"
NSQ_SOURCE_LINE 00000054 "    $index = binsearch {$a cmp $b} 'Mozart', @str_array;      # Stringy cmp."
NSQ_SOURCE_LINE 00000055 "    $index = binsearch {$a <=> $b} 42, @num_array;            # not found: undef"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    # Find the lowest index of a matching element, or best insert point."
NSQ_SOURCE_LINE 00000058 "    $index = binsearch_pos { $a <=> $b } 200, @num_array;     # Matched at [1]."
NSQ_SOURCE_LINE 00000059 "    $index = binsearch_pos {$a cmp $b} 'Chopin', @str_array;  # Insert at [3]."
NSQ_SOURCE_LINE 00000060 "    $index = binsearch_pos 600, @num_array;                   # Insert at [5]."
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    # Insert based on a binsearch_pos return value."
NSQ_SOURCE_LINE 00000063 "    splice @num_array, $index, 0, 600"
NSQ_SOURCE_LINE 00000064 "      if( $num_array[$index] != 600 );                        # Insertion at [5]"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "A binary search searches I<sorted> lists using a divide and conquer technique."
NSQ_SOURCE_LINE 00000070 "On each iteration the search domain is cut in half, until the result is found."
NSQ_SOURCE_LINE 00000071 "The computational complexity of a binary search is O(log n)."
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "This module implements several Binary Search algorithms using XS code for"
NSQ_SOURCE_LINE 00000074 "optimal performance.  You are free to use this module directly, or as a plugin"
NSQ_SOURCE_LINE 00000075 "for the more general L<List::BinarySearch>."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "The binary search algorithm implemented in this module is known as a"
NSQ_SOURCE_LINE 00000078 "I<Deferred Detection> Binary Search.  Deferred Detection provides"
NSQ_SOURCE_LINE 00000079 "B<stable searches>.  Stable binary search algorithms have the following"
NSQ_SOURCE_LINE 00000080 "characteristics, contrasted with their unstable binary search cousins:"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=over 4"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=item * In the case of non-unique keys, a stable binary search will always"
NSQ_SOURCE_LINE 00000085 "return the lowest-indexed matching element.  An unstable binary search would"
NSQ_SOURCE_LINE 00000086 "return the first one found, which may not be the chronological first."
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=item * Best and worst case time complexity is always O(log n).  Unstable"
NSQ_SOURCE_LINE 00000089 "searches may stop once the target is found, but in the worst case are still"
NSQ_SOURCE_LINE 00000090 "O(log n).  In practical terms, this difference is usually not meaningful."
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=item * Stable binary searches only require one relational comparison of a"
NSQ_SOURCE_LINE 00000093 "given pair of data elements per iteration, where unstable binary searches"
NSQ_SOURCE_LINE 00000094 "require two comparisons per iteration."
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=item * The net result is that although an unstable binary search might have"
NSQ_SOURCE_LINE 00000097 "better \"best case\" performance, the fact that a stable binary search gets away"
NSQ_SOURCE_LINE 00000098 "with fewer comparisons per iteration gives it better performance in the worst"
NSQ_SOURCE_LINE 00000099 "case, and approximately equal performance in the average case. By trading away"
NSQ_SOURCE_LINE 00000100 "slightly better \"best case\" performance, the stable search gains the guarantee"
NSQ_SOURCE_LINE 00000101 "that the element found will always be the lowest-indexed element in a range of"
NSQ_SOURCE_LINE 00000102 "non-unique keys."
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=back"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 RATIONALE"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "B<A binary search is pretty simple, right?  Why use a module for this?>"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "Quoting from"
NSQ_SOURCE_LINE 00000111 "L<Wikipedia|http://en.wikipedia.org/wiki/Binary_search_algorithm>:  I<When Jon"
NSQ_SOURCE_LINE 00000112 "Bentley assigned it as a problem in a course for professional"
NSQ_SOURCE_LINE 00000113 "programmers, he found that an astounding ninety percent failed to code a"
NSQ_SOURCE_LINE 00000114 "binary search correctly after several hours of working on it, and another"
NSQ_SOURCE_LINE 00000115 "study shows that accurate code for it is only found in five out of twenty"
NSQ_SOURCE_LINE 00000116 "textbooks. Furthermore, Bentley's own implementation of binary search,"
NSQ_SOURCE_LINE 00000117 "published in his 1986 book Programming Pearls, contains an error that remained"
NSQ_SOURCE_LINE 00000118 "undetected for over twenty years.>"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "So the answer to the question \"Why use a module for this?\" is \"So that you"
NSQ_SOURCE_LINE 00000121 "don't have to write, test, and debug your own implementation.\""
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "B<< Perl has C<grep>, hashes, and other alternatives, right? >>"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "Yes, before using this module the user should weigh the other options such as"
NSQ_SOURCE_LINE 00000126 "linear searches ( C<grep> or C<List::Util::first> ), or hash based searches. A"
NSQ_SOURCE_LINE 00000127 "binary search requires an ordered list, so one must weigh the cost of sorting or"
NSQ_SOURCE_LINE 00000128 "maintaining the list in sorted order.  Ordered lists have O(n) time complexity"
NSQ_SOURCE_LINE 00000129 "for inserts.  Binary Searches are best when the data set is already ordered, or"
NSQ_SOURCE_LINE 00000130 "will be searched enough times to justify the cost of an initial sort."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "There are cases where a binary search may be an excellent choice. Finding the"
NSQ_SOURCE_LINE 00000133 "first matching element in a list of 1,000,000 items with a linear search would"
NSQ_SOURCE_LINE 00000134 "have a worst-case of 1,000,000 iterations, whereas the worst case for a binary"
NSQ_SOURCE_LINE 00000135 "search of 1,000,000 elements is about 20 iterations.  In fact, if many lookups"
NSQ_SOURCE_LINE 00000136 "will be performed on a seldom-changed list, the savings of O(log n) lookups may"
NSQ_SOURCE_LINE 00000137 "outweigh the cost of sorting or performing occasional linear time inserts."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=head1 EXPORT"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "Nothing is exported by default.  Upon request this module will export"
NSQ_SOURCE_LINE 00000143 "C<binsearch>, and C<binsearch_pos>."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "Or import all functions by specifying the export tag C<:all>."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=head1 SUBROUTINES/METHODS"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=head2 WHICH SEARCH ROUTINE TO USE"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=over 4"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=item * C<binsearch>: Returns lowest index where match is found, or undef."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=item * C<binsearch_pos>: Returns lowest index where match is found, or the"
NSQ_SOURCE_LINE 00000156 "index of the best insert point for needle if the needle isn't found."
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=back"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=head2 binsearch CODE NEEDLE ARRAY_HAYSTACK"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    $first_found_ix = binsearch { $a cmp $b } $needle, @haystack;"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "Pass a code block, a search target, and an array to search.  Uses"
NSQ_SOURCE_LINE 00000165 "the supplied code block C<$needle> to test the needle against elements"
NSQ_SOURCE_LINE 00000166 "in C<@haystack>."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "See the section entitled B<The Callback Block>, below, for an explanation"
NSQ_SOURCE_LINE 00000169 "of how the comparator works"
NSQ_SOURCE_LINE 00000170 "(hint: very similar to C<< sort { $a <=> $b } ... >> )."
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "Return value will be the lowest index of an element that matches target, or"
NSQ_SOURCE_LINE 00000173 "undef if target isn't found."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=head2 binsearch_pos CODE NEEDLE ARRAY_HAYSTACK"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    $first_found_ix = binsearch_pos { $a cmp $b } $needle, @haystack;"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "The only difference between this function and C<binsearch> is its return"
NSQ_SOURCE_LINE 00000180 "value upon failure.  C<binsearch> returns undef upon failure."
NSQ_SOURCE_LINE 00000181 "C<binsearch_pos> returns the index of a valid insert point for"
NSQ_SOURCE_LINE 00000182 "C<$needle>."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "Pass a code block, a search target, and an array to search.  Uses"
NSQ_SOURCE_LINE 00000185 "the code block to test C<$needle> against elements in C<@haystack>."
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "Return value is the index of the first element equaling C<$needle>.  If no"
NSQ_SOURCE_LINE 00000188 "element is found, the best insert-point for C<$needle> is returned."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=head2 The callback block (The comparator)"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "Comparators in L<List::BinarySearch::XS> are used to compare the target (needle)"
NSQ_SOURCE_LINE 00000194 "with individual haystack elements, and should return the result of the"
NSQ_SOURCE_LINE 00000195 "relational comparison of the two values.  A good example would be the code block"
NSQ_SOURCE_LINE 00000196 "in a C<sort> function."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "Basic comparators might be defined like this:"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    # Numeric comparisons:"
NSQ_SOURCE_LINE 00000201 "    binsearch { $a <=> $b } $needle, @haystack;"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    # Stringwise comparisons:"
NSQ_SOURCE_LINE 00000204 "    binsearch { $a cmp $b } $needle, @haystack;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    # Unicode Collation Algorithm comparisons"
NSQ_SOURCE_LINE 00000207 "    $Collator = Unicode::Collate->new;"
NSQ_SOURCE_LINE 00000208 "    binsearch { $Collator->cmp($a,$b) } $needle, @haystack;"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "On each call, C<$a> represents the target, and C<$b> represents the an"
NSQ_SOURCE_LINE 00000211 "individual haystack element being tested.  This leads to an asymmetry that might"
NSQ_SOURCE_LINE 00000212 "be prone to \"gotchas\" when writing custom comparators for searching complex data"
NSQ_SOURCE_LINE 00000213 "structures. As an example, consider the following data structure:"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "    my @structure = ("
NSQ_SOURCE_LINE 00000216 "        [ 100, 'ape'  ],"
NSQ_SOURCE_LINE 00000217 "        [ 200, 'cat'  ],"
NSQ_SOURCE_LINE 00000218 "        [ 300, 'dog'  ],"
NSQ_SOURCE_LINE 00000219 "        [ 400, 'frog' ]"
NSQ_SOURCE_LINE 00000220 "    );"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "A numeric comparator for such a data structure would look like this:"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "    sub{ $a <=> $b->[0] }"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "In this regard, the callback is I<unlike> C<sort>, because C<sort> always"
NSQ_SOURCE_LINE 00000227 "compares elements to elements, whereas C<binsearch> compares a target with"
NSQ_SOURCE_LINE 00000228 "an element."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "The comparator is expected to return -1, 0, or 1 corresponding to \"less than\","
NSQ_SOURCE_LINE 00000231 "\"equal to\", or \"greater than\" -- Just like C<sort>."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=head1 DATA SET REQUIREMENTS"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "A well written general algorithm should place as few demands on its data as"
NSQ_SOURCE_LINE 00000236 "practical.  The requirements that these Binary Search algorithms impose"
NSQ_SOURCE_LINE 00000237 "are:"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=over 4"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=item * B<Your data must be in ascending sort order>."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "This is a big one.  The best sort routines run in O(n log n) time.  It makes no"
NSQ_SOURCE_LINE 00000244 "sense to sort a list in O(n log n) time, and then perform a single O(log n)"
NSQ_SOURCE_LINE 00000245 "binary search when List::Util C<first> could be used to accomplish the same"
NSQ_SOURCE_LINE 00000246 "results in O(n) time without sorting."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=item * B<The list really must be in ascending sort order.>"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "\"The same rule twice?\", you say..."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "A Binary Search consumes O(log n) time. We don't want to waste linear time"
NSQ_SOURCE_LINE 00000253 "verifying the list is sordted, so B<there is no validity checking. You have"
NSQ_SOURCE_LINE 00000254 "been warned.>"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=item * B<These functions are prototyped> as C<&$\\@>."
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "What this implementation detail means is that C<@haystack> is implicitly passed"
NSQ_SOURCE_LINE 00000259 "by reference.  This is the price we pay for a familiar user interface, cleaner"
NSQ_SOURCE_LINE 00000260 "calling syntax, and the automatic efficiency of pass-by-reference.  Perl's"
NSQ_SOURCE_LINE 00000261 "prototypes are one of Perl's warts."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=item * B<Objects in the search lists must be capable of being evaluated for"
NSQ_SOURCE_LINE 00000264 "relationaity.>"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "I threw that in for C++ folks who have spent some time with Effective STL.  For"
NSQ_SOURCE_LINE 00000267 "everyone else don't worry; if you know how to C<sort> you know how to"
NSQ_SOURCE_LINE 00000268 "C<binsearch>."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "=back"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "=head1 UNICODE SUPPORT"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "Lists sorted according to the Unicode Collation Algorithm must be searched using"
NSQ_SOURCE_LINE 00000275 "the same Unicode Collation Algorithm, Here's an example using"
NSQ_SOURCE_LINE 00000276 "L<Unicode::Collate>'s C<< $Collator->cmp($a,$b) >>:"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "    my $found_index = binsearch { $Collator->cmp($a,$b) } $needle, @haystack;"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=head1 CONFIGURATION AND ENVIRONMENT"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "This module should run under any Perl from 5.8.0 onward.  This is an XS module,"
NSQ_SOURCE_LINE 00000284 "which means the build process requires a C compiler.  For most systems this"
NSQ_SOURCE_LINE 00000285 "isn't an issue.  For some users (ActiveState Perl users, for example), it may be"
NSQ_SOURCE_LINE 00000286 "advantageous to install a pre-built PPM distribution of this module."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "While it's perfectly Ok to use this module directly, a more flexible approach"
NSQ_SOURCE_LINE 00000289 "for the end user would be to C<use List::BinarySearch;>, while ensuring that"
NSQ_SOURCE_LINE 00000290 "L<List::BinarySearch::XS> is installed on the target machine."
NSQ_SOURCE_LINE 00000291 "L<List::BinarySearch> will use the XS version automatically if it's installed,"
NSQ_SOURCE_LINE 00000292 "and will downgrade gracefully to the pure-Perl version of"
NSQ_SOURCE_LINE 00000293 "L<List::BinarySearch::XS> isn't installed."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "Users of L<List::BinarySearch> may override this behavior by setting"
NSQ_SOURCE_LINE 00000296 "C<$ENV{List_BinarySearch_PP}> to a true value."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=head1 DEPENDENCIES"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "This module requires Perl 5.8 or newer."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "As mentioned above, the recommended point of entry is to install both this"
NSQ_SOURCE_LINE 00000304 "module and L<List::BinarySearch>.  If both are installed, using"
NSQ_SOURCE_LINE 00000305 "L<List::BinarySearch> will automatically use L<List::BinarySearch::XS> for"
NSQ_SOURCE_LINE 00000306 "optimal performance."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head1 INCOMPATIBILITIES"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "Currently L<List::BinarySearch::XS>, makes no attempt at compatibility with"
NSQ_SOURCE_LINE 00000312 "the XS API for versions of Perl that predate Perl 5.8.  Perl 5.6 was replaced"
NSQ_SOURCE_LINE 00000313 "by Perl 5.8 in July 2002.  It's time to move on.  Patches that establish"
NSQ_SOURCE_LINE 00000314 "compatibility with earlier Perl versions will be considered (and welcomed) if"
NSQ_SOURCE_LINE 00000315 "they have no measurable impact on efficiency, and especially if they come in"
NSQ_SOURCE_LINE 00000316 "the form of a git patch, complete with tests. ;)"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000320 ""
