NSQ_SOURCE_LINE 00000001 "package Data::TableData::Object;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Data::Check::Structure qw(is_aos is_aoaos is_aohos);"
NSQ_SOURCE_LINE 00000008 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000009 "use Scalar::Util qw(blessed);"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000012 "our $DATE = '2022-05-19'; # DATE"
NSQ_SOURCE_LINE 00000013 "our $DIST = 'Data-TableData-Object'; # DIST"
NSQ_SOURCE_LINE 00000014 "our $VERSION = '0.116'; # VERSION"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw(table);"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub table { __PACKAGE__->new(@_) }"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "sub new {"
NSQ_SOURCE_LINE 00000021 "    my ($class, $data, $spec) = @_;"
NSQ_SOURCE_LINE 00000022 "    if (!defined($data)) {"
NSQ_SOURCE_LINE 00000023 "        die \"Please specify table data\";"
NSQ_SOURCE_LINE 00000024 "    } elsif (blessed($data) && $data->isa(\"Data::TableData::Object::Base\")) {"
NSQ_SOURCE_LINE 00000025 "        return $data;"
NSQ_SOURCE_LINE 00000026 "    } elsif (ref($data) eq 'HASH') {"
NSQ_SOURCE_LINE 00000027 "        require Data::TableData::Object::hash;"
NSQ_SOURCE_LINE 00000028 "        Data::TableData::Object::hash->new($data);"
NSQ_SOURCE_LINE 00000029 "    } elsif (is_aoaos($data)) {"
NSQ_SOURCE_LINE 00000030 "        require Data::TableData::Object::aoaos;"
NSQ_SOURCE_LINE 00000031 "        Data::TableData::Object::aoaos->new($data, $spec);"
NSQ_SOURCE_LINE 00000032 "    } elsif (is_aohos($data)) {"
NSQ_SOURCE_LINE 00000033 "        require Data::TableData::Object::aohos;"
NSQ_SOURCE_LINE 00000034 "        Data::TableData::Object::aohos->new($data, $spec);"
NSQ_SOURCE_LINE 00000035 "    } elsif (ref($data) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000036 "        require Data::TableData::Object::aos;"
NSQ_SOURCE_LINE 00000037 "        Data::TableData::Object::aos->new($data);"
NSQ_SOURCE_LINE 00000038 "    } else {"
NSQ_SOURCE_LINE 00000039 "        die \"Unknown table data form, please supply array of scalar, \"."
NSQ_SOURCE_LINE 00000040 "            \"array of array-of-scalar, or array of hash-of-scalar\";"
NSQ_SOURCE_LINE 00000041 "    }"
NSQ_SOURCE_LINE 00000042 "}"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "1;"
NSQ_SOURCE_LINE 00000045 "# ABSTRACT: Manipulate table-like data structure via table object"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "__END__"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=pod"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=head1 NAME"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "Data::TableData::Object - Manipulate table-like data structure via table object"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=head1 VERSION"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "This document describes version 0.116 of Data::TableData::Object (from Perl distribution Data-TableData-Object), released on 2022-05-19."
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "This module provides a common interface to manipulate a few kinds of data"
NSQ_SOURCE_LINE 00000064 "structures that are \"table-like\": aoaos (array of array-of-scalars), aohos"
NSQ_SOURCE_LINE 00000065 "(array of hash-of-scalars), aos (array of scalars, viewed as a single-column"
NSQ_SOURCE_LINE 00000066 "table), and hash (viewed as two-column table with the columns being \"key\" and"
NSQ_SOURCE_LINE 00000067 "\"value')."
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "The interface (see L<Data::TableData::Object::Base>) allows you to list columns,"
NSQ_SOURCE_LINE 00000070 "add/delete columns, retrieve rows, convert to aoaos or aohos, etc."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=for Pod::Coverage ^$"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=head2 table"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "Usage:"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 " my $obj = table($data[ , $spec ]); # => obj"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Shortcut for C<< Data::TableData::Object->new(...) >>."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head1 METHODS"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=head2 new"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "Usage:"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 " my $obj = Data::TableData::Object->new($data[ , $spec ]); # => obj"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "Detect the structure of C<$data> and create the appropriate"
NSQ_SOURCE_LINE 00000093 "C<Data::TableData::Object::FORM> object. Note: if C<$data> is already a table"
NSQ_SOURCE_LINE 00000094 "data object (\"isa Data::TableData::Object::Base\"), then C<$data> will be"
NSQ_SOURCE_LINE 00000095 "returned as-is instead of creating a new object."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "Please visit the project's homepage at L<https://metacpan.org/release/Data-TableData-Object>."
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "Source repository is at L<https://github.com/perlancar/perl-TableData-Object>."
NSQ_SOURCE_LINE 00000104 ""
