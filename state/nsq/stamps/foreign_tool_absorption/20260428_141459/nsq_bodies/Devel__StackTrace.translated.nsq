NSQ_SOURCE_LINE 00000001 "package Devel::StackTrace;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '2.05';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Devel::StackTrace::Frame;"
NSQ_SOURCE_LINE 00000011 "use File::Spec;"
NSQ_SOURCE_LINE 00000012 "use Scalar::Util qw( blessed );"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "use overload"
NSQ_SOURCE_LINE 00000015 "    '\"\"'     => \\&as_string,"
NSQ_SOURCE_LINE 00000016 "    bool     => sub {1},"
NSQ_SOURCE_LINE 00000017 "    fallback => 1;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "sub new {"
NSQ_SOURCE_LINE 00000020 "    my $class = shift;"
NSQ_SOURCE_LINE 00000021 "    my %p     = @_;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    $p{unsafe_ref_capture} = !delete $p{no_refs}"
NSQ_SOURCE_LINE 00000024 "        if exists $p{no_refs};"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    my $self = bless {"
NSQ_SOURCE_LINE 00000027 "        index  => undef,"
NSQ_SOURCE_LINE 00000028 "        frames => [],"
NSQ_SOURCE_LINE 00000029 "        raw    => [],"
NSQ_SOURCE_LINE 00000030 "        %p,"
NSQ_SOURCE_LINE 00000031 "    }, $class;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    $self->_record_caller_data;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    return $self;"
NSQ_SOURCE_LINE 00000036 "}"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "sub _record_caller_data {"
NSQ_SOURCE_LINE 00000039 "    my $self = shift;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    my $filter = $self->{filter_frames_early} && $self->_make_frame_filter;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    # We exclude this method by starting at least one frame back."
NSQ_SOURCE_LINE 00000044 "    my $x = 1 + ( $self->{skip_frames} || 0 );"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    while ("
NSQ_SOURCE_LINE 00000047 "        my @c"
NSQ_SOURCE_LINE 00000048 "        = $self->{no_args}"
NSQ_SOURCE_LINE 00000049 "        ? caller( $x++ )"
NSQ_SOURCE_LINE 00000050 "        : do {"
NSQ_SOURCE_LINE 00000051 "            ## no critic (Modules::ProhibitMultiplePackages, Variables::ProhibitPackageVars)"
NSQ_SOURCE_LINE 00000052 "            package    # the newline keeps dzil from adding a version here"
NSQ_SOURCE_LINE 00000053 "                DB;"
NSQ_SOURCE_LINE 00000054 "            @DB::args = ();"
NSQ_SOURCE_LINE 00000055 "            caller( $x++ );"
NSQ_SOURCE_LINE 00000056 "        }"
NSQ_SOURCE_LINE 00000057 "    ) {"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "        my @args;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "        ## no critic (Variables::ProhibitPackageVars, BuiltinFunctions::ProhibitComplexMappings)"
NSQ_SOURCE_LINE 00000062 "        unless ( $self->{no_args} ) {"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "            # This is the same workaroud as was applied to Carp.pm a little"
NSQ_SOURCE_LINE 00000065 "            # while back"
NSQ_SOURCE_LINE 00000066 "            # (https://rt.perl.org/Public/Bug/Display.html?id=131046):"
NSQ_SOURCE_LINE 00000067 "            #"
NSQ_SOURCE_LINE 00000068 "            #   Guard our serialization of the stack from stack refcounting"
NSQ_SOURCE_LINE 00000069 "            #   bugs NOTE this is NOT a complete solution, we cannot 100%"
NSQ_SOURCE_LINE 00000070 "            #   guard against these bugs. However in many cases Perl *is*"
NSQ_SOURCE_LINE 00000071 "            #   capable of detecting them and throws an error when it"
NSQ_SOURCE_LINE 00000072 "            #   does. Unfortunately serializing the arguments on the stack is"
NSQ_SOURCE_LINE 00000073 "            #   a perfect way of finding these bugs, even when they would not"
NSQ_SOURCE_LINE 00000074 "            #   affect normal program flow that did not poke around inside the"
NSQ_SOURCE_LINE 00000075 "            #   stack. Inside of Carp.pm it makes little sense reporting these"
NSQ_SOURCE_LINE 00000076 "            #   bugs, as Carp's job is to report the callers errors, not the"
NSQ_SOURCE_LINE 00000077 "            #   ones it might happen to tickle while doing so.  See:"
NSQ_SOURCE_LINE 00000078 "            #   https://rt.perl.org/Public/Bug/Display.html?id=131046 and:"
NSQ_SOURCE_LINE 00000079 "            #   https://rt.perl.org/Public/Bug/Display.html?id=52610 for more"
NSQ_SOURCE_LINE 00000080 "            #   details and discussion. - Yves"
NSQ_SOURCE_LINE 00000081 "            @args = map {"
NSQ_SOURCE_LINE 00000082 "                my $arg;"
NSQ_SOURCE_LINE 00000083 "                local $@ = $@;"
NSQ_SOURCE_LINE 00000084 "                eval {"
NSQ_SOURCE_LINE 00000085 "                    $arg = $_;"
NSQ_SOURCE_LINE 00000086 "                    1;"
NSQ_SOURCE_LINE 00000087 "                } or do {"
NSQ_SOURCE_LINE 00000088 "                    $arg = '** argument not available anymore **';"
NSQ_SOURCE_LINE 00000089 "                };"
NSQ_SOURCE_LINE 00000090 "                $arg;"
NSQ_SOURCE_LINE 00000091 "            } @DB::args;"
NSQ_SOURCE_LINE 00000092 "        }"
NSQ_SOURCE_LINE 00000093 "        ## use critic"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "        my $raw = {"
NSQ_SOURCE_LINE 00000096 "            caller => \\@c,"
NSQ_SOURCE_LINE 00000097 "            args   => \\@args,"
NSQ_SOURCE_LINE 00000098 "        };"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "        next if $filter && !$filter->($raw);"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "        unless ( $self->{unsafe_ref_capture} ) {"
NSQ_SOURCE_LINE 00000103 "            $raw->{args} = [ map { ref $_ ? $self->_ref_to_string($_) : $_ }"
NSQ_SOURCE_LINE 00000104 "                    @{ $raw->{args} } ];"
NSQ_SOURCE_LINE 00000105 "        }"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "        push @{ $self->{raw} }, $raw;"
NSQ_SOURCE_LINE 00000108 "    }"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "sub _ref_to_string {"
NSQ_SOURCE_LINE 00000112 "    my $self = shift;"
NSQ_SOURCE_LINE 00000113 "    my $ref  = shift;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    return overload::AddrRef($ref)"
NSQ_SOURCE_LINE 00000116 "        if blessed $ref && $ref->isa('Exception::Class::Base');"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    return overload::AddrRef($ref) unless $self->{respect_overload};"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "    ## no critic (Variables::RequireInitializationForLocalVars)"
NSQ_SOURCE_LINE 00000121 "    local $@;"
NSQ_SOURCE_LINE 00000122 "    local $SIG{__DIE__};"
NSQ_SOURCE_LINE 00000123 "    ## use critic"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "    my $str = eval { $ref . q{} };"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "    return $@ ? overload::AddrRef($ref) : $str;"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "sub _make_frames {"
NSQ_SOURCE_LINE 00000131 "    my $self = shift;"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    my $filter = !$self->{filter_frames_early} && $self->_make_frame_filter;"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "    my $raw = delete $self->{raw};"
NSQ_SOURCE_LINE 00000136 "    for my $r ( @{$raw} ) {"
NSQ_SOURCE_LINE 00000137 "        next if $filter && !$filter->($r);"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "        $self->_add_frame( $r->{caller}, $r->{args} );"
NSQ_SOURCE_LINE 00000140 "    }"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "my $default_filter = sub {1};"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "sub _make_frame_filter {"
NSQ_SOURCE_LINE 00000146 "    my $self = shift;"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    my ( @i_pack_re, %i_class );"
NSQ_SOURCE_LINE 00000149 "    if ( $self->{ignore_package} ) {"
NSQ_SOURCE_LINE 00000150 "        ## no critic (Variables::RequireInitializationForLocalVars)"
NSQ_SOURCE_LINE 00000151 "        local $@;"
NSQ_SOURCE_LINE 00000152 "        local $SIG{__DIE__};"
NSQ_SOURCE_LINE 00000153 "        ## use critic"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "        $self->{ignore_package} = [ $self->{ignore_package} ]"
NSQ_SOURCE_LINE 00000156 "            unless eval { @{ $self->{ignore_package} } };"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "        @i_pack_re"
NSQ_SOURCE_LINE 00000159 "            = map { ref $_ ? $_ : qr/^\\Q$_\\E$/ } @{ $self->{ignore_package} };"
NSQ_SOURCE_LINE 00000160 "    }"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    my $p = __PACKAGE__;"
NSQ_SOURCE_LINE 00000163 "    push @i_pack_re, qr/^\\Q$p\\E$/;"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "    if ( $self->{ignore_class} ) {"
NSQ_SOURCE_LINE 00000166 "        $self->{ignore_class} = [ $self->{ignore_class} ]"
NSQ_SOURCE_LINE 00000167 "            unless ref $self->{ignore_class};"
NSQ_SOURCE_LINE 00000168 "        %i_class = map { $_ => 1 } @{ $self->{ignore_class} };"
NSQ_SOURCE_LINE 00000169 "    }"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    my $user_filter = $self->{frame_filter};"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    return sub {"
NSQ_SOURCE_LINE 00000174 "        return 0 if grep { $_[0]{caller}[0] =~ /$_/ } @i_pack_re;"
NSQ_SOURCE_LINE 00000175 "        return 0 if grep { $_[0]{caller}[0]->isa($_) } keys %i_class;"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "        if ($user_filter) {"
NSQ_SOURCE_LINE 00000178 "            return $user_filter->( $_[0] );"
NSQ_SOURCE_LINE 00000179 "        }"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "        return 1;"
NSQ_SOURCE_LINE 00000182 "    };"
NSQ_SOURCE_LINE 00000183 "}"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "sub _add_frame {"
NSQ_SOURCE_LINE 00000186 "    my $self = shift;"
NSQ_SOURCE_LINE 00000187 "    my $c    = shift;"
NSQ_SOURCE_LINE 00000188 "    my $p    = shift;"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    # eval and is_require are only returned when applicable under 5.00503."
NSQ_SOURCE_LINE 00000191 "    push @$c, ( undef, undef ) if scalar @$c == 6;"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    push @{ $self->{frames} },"
NSQ_SOURCE_LINE 00000194 "        Devel::StackTrace::Frame->new("
NSQ_SOURCE_LINE 00000195 "        $c,"
NSQ_SOURCE_LINE 00000196 "        $p,"
NSQ_SOURCE_LINE 00000197 "        $self->{respect_overload},"
NSQ_SOURCE_LINE 00000198 "        $self->{max_arg_length},"
NSQ_SOURCE_LINE 00000199 "        $self->{message},"
NSQ_SOURCE_LINE 00000200 "        $self->{indent}"
NSQ_SOURCE_LINE 00000201 "        );"
NSQ_SOURCE_LINE 00000202 "}"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "sub next_frame {"
NSQ_SOURCE_LINE 00000205 "    my $self = shift;"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "    # reset to top if necessary."
NSQ_SOURCE_LINE 00000208 "    $self->{index} = -1 unless defined $self->{index};"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    my @f = $self->frames;"
NSQ_SOURCE_LINE 00000211 "    if ( defined $f[ $self->{index} + 1 ] ) {"
NSQ_SOURCE_LINE 00000212 "        return $f[ ++$self->{index} ];"
NSQ_SOURCE_LINE 00000213 "    }"
NSQ_SOURCE_LINE 00000214 "    else {"
NSQ_SOURCE_LINE 00000215 "        $self->{index} = undef;"
NSQ_SOURCE_LINE 00000216 "        ## no critic (Subroutines::ProhibitExplicitReturnUndef)"
NSQ_SOURCE_LINE 00000217 "        return undef;"
NSQ_SOURCE_LINE 00000218 "    }"
NSQ_SOURCE_LINE 00000219 "}"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "sub prev_frame {"
NSQ_SOURCE_LINE 00000222 "    my $self = shift;"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "    my @f = $self->frames;"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "    # reset to top if necessary."
NSQ_SOURCE_LINE 00000227 "    $self->{index} = scalar @f unless defined $self->{index};"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "    if ( defined $f[ $self->{index} - 1 ] && $self->{index} >= 1 ) {"
NSQ_SOURCE_LINE 00000230 "        return $f[ --$self->{index} ];"
NSQ_SOURCE_LINE 00000231 "    }"
NSQ_SOURCE_LINE 00000232 "    else {"
NSQ_SOURCE_LINE 00000233 "        ## no critic (Subroutines::ProhibitExplicitReturnUndef)"
NSQ_SOURCE_LINE 00000234 "        $self->{index} = undef;"
NSQ_SOURCE_LINE 00000235 "        return undef;"
NSQ_SOURCE_LINE 00000236 "    }"
NSQ_SOURCE_LINE 00000237 "}"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "sub reset_pointer {"
NSQ_SOURCE_LINE 00000240 "    my $self = shift;"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "    $self->{index} = undef;"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "    return;"
NSQ_SOURCE_LINE 00000245 "}"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "sub frames {"
NSQ_SOURCE_LINE 00000248 "    my $self = shift;"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "    if (@_) {"
NSQ_SOURCE_LINE 00000251 "        die"
NSQ_SOURCE_LINE 00000252 "            \"Devel::StackTrace->frames can only take Devel::StackTrace::Frame args\\n\""
NSQ_SOURCE_LINE 00000253 "            if grep { !$_->isa('Devel::StackTrace::Frame') } @_;"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "        $self->{frames} = \\@_;"
NSQ_SOURCE_LINE 00000256 "        delete $self->{raw};"
NSQ_SOURCE_LINE 00000257 "    }"
NSQ_SOURCE_LINE 00000258 "    else {"
NSQ_SOURCE_LINE 00000259 "        $self->_make_frames if $self->{raw};"
NSQ_SOURCE_LINE 00000260 "    }"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "    return @{ $self->{frames} };"
NSQ_SOURCE_LINE 00000263 "}"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "sub frame {"
NSQ_SOURCE_LINE 00000266 "    my $self = shift;"
NSQ_SOURCE_LINE 00000267 "    my $i    = shift;"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "    return unless defined $i;"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "    return ( $self->frames )[$i];"
NSQ_SOURCE_LINE 00000272 "}"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "sub frame_count {"
NSQ_SOURCE_LINE 00000275 "    my $self = shift;"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "    return scalar( $self->frames );"
NSQ_SOURCE_LINE 00000278 "}"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "sub message { $_[0]->{message} }"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "sub as_string {"
NSQ_SOURCE_LINE 00000283 "    my $self = shift;"
NSQ_SOURCE_LINE 00000284 "    my $p    = shift;"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "    my @frames = $self->frames;"
NSQ_SOURCE_LINE 00000287 "    if (@frames) {"
NSQ_SOURCE_LINE 00000288 "        my $st    = q{};"
NSQ_SOURCE_LINE 00000289 "        my $first = 1;"
NSQ_SOURCE_LINE 00000290 "        for my $f (@frames) {"
NSQ_SOURCE_LINE 00000291 "            $st .= $f->as_string( $first, $p ) . \"\\n\";"
NSQ_SOURCE_LINE 00000292 "            $first = 0;"
NSQ_SOURCE_LINE 00000293 "        }"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "        return $st;"
NSQ_SOURCE_LINE 00000296 "    }"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "    my $msg = $self->message;"
NSQ_SOURCE_LINE 00000299 "    return $msg if defined $msg;"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "    return 'Trace begun';"
NSQ_SOURCE_LINE 00000302 "}"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "{"
NSQ_SOURCE_LINE 00000305 "    ## no critic (Modules::ProhibitMultiplePackages, ClassHierarchies::ProhibitExplicitISA)"
NSQ_SOURCE_LINE 00000306 "    package    # hide from PAUSE"
NSQ_SOURCE_LINE 00000307 "        Devel::StackTraceFrame;"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "    our @ISA = 'Devel::StackTrace::Frame';"
NSQ_SOURCE_LINE 00000310 "}"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "1;"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "# ABSTRACT: An object representing a stack trace"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "__END__"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=pod"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=head1 NAME"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "Devel::StackTrace - An object representing a stack trace"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "=head1 VERSION"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "version 2.05"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "  use Devel::StackTrace;"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "  my $trace = Devel::StackTrace->new;"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "  print $trace->as_string; # like carp"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "  # from top (most recent) of stack to bottom."
NSQ_SOURCE_LINE 00000339 "  while ( my $frame = $trace->next_frame ) {"
NSQ_SOURCE_LINE 00000340 "      print \"Has args\\n\" if $frame->hasargs;"
NSQ_SOURCE_LINE 00000341 "  }"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "  # from bottom (least recent) of stack to top."
NSQ_SOURCE_LINE 00000344 "  while ( my $frame = $trace->prev_frame ) {"
NSQ_SOURCE_LINE 00000345 "      print \"Sub: \", $frame->subroutine, \"\\n\";"
NSQ_SOURCE_LINE 00000346 "  }"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "The C<Devel::StackTrace> module contains two classes, C<Devel::StackTrace> and"
NSQ_SOURCE_LINE 00000351 "L<Devel::StackTrace::Frame>. These objects encapsulate the information that can"
NSQ_SOURCE_LINE 00000352 "retrieved via Perl's C<caller> function, as well as providing a simple"
NSQ_SOURCE_LINE 00000353 "interface to this data."
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "The C<Devel::StackTrace> object contains a set of C<Devel::StackTrace::Frame>"
NSQ_SOURCE_LINE 00000356 "objects, one for each level of the stack. The frames contain all the data"
NSQ_SOURCE_LINE 00000357 "available from C<caller>."
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "This code was created to support my L<Exception::Class::Base> class (part of"
NSQ_SOURCE_LINE 00000360 "L<Exception::Class>) but may be useful in other contexts."
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "=head1 'TOP' AND 'BOTTOM' OF THE STACK"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "When describing the methods of the trace object, I use the words 'top' and"
NSQ_SOURCE_LINE 00000365 "'bottom'. In this context, the 'top' frame on the stack is the most recent"
NSQ_SOURCE_LINE 00000366 "frame and the 'bottom' is the least recent."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "Here's an example:"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "  foo();  # bottom frame is here"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "  sub foo {"
NSQ_SOURCE_LINE 00000373 "     bar();"
NSQ_SOURCE_LINE 00000374 "  }"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "  sub bar {"
NSQ_SOURCE_LINE 00000377 "     Devel::StackTrace->new;  # top frame is here."
NSQ_SOURCE_LINE 00000378 "  }"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=head1 METHODS"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "This class provide the following methods:"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "=head2 Devel::StackTrace->new(%named_params)"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "Returns a new Devel::StackTrace object."
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "Takes the following parameters:"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "=over 4"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "=item * frame_filter => $sub"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "By default, Devel::StackTrace will include all stack frames before the call to"
NSQ_SOURCE_LINE 00000395 "its constructor."
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "However, you may want to filter out some frames with more granularity than"
NSQ_SOURCE_LINE 00000398 "'ignore_package' or 'ignore_class' allow."
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "You can provide a subroutine which is called with the raw frame data for each"
NSQ_SOURCE_LINE 00000401 "frame. This is a hash reference with two keys, \"caller\", and \"args\", both of"
NSQ_SOURCE_LINE 00000402 "which are array references. The \"caller\" key is the raw data as returned by"
NSQ_SOURCE_LINE 00000403 "Perl's C<caller> function, and the \"args\" key are the subroutine arguments"
NSQ_SOURCE_LINE 00000404 "found in C<@DB::args>."
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "The filter should return true if the frame should be included, or false if it"
NSQ_SOURCE_LINE 00000407 "should be skipped."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "=item * filter_frames_early => $boolean"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "If this parameter is true, C<frame_filter> will be called as soon as the"
NSQ_SOURCE_LINE 00000412 "stacktrace is created, and before refs are stringified (if"
NSQ_SOURCE_LINE 00000413 "C<unsafe_ref_capture> is not set), rather than being filtered lazily when"
NSQ_SOURCE_LINE 00000414 "L<Devel::StackTrace::Frame> objects are first needed."
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "This is useful if you want to filter based on the frame's arguments and want to"
NSQ_SOURCE_LINE 00000417 "be able to examine object properties, for example."
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "=item * ignore_package => $package_name OR \\@package_names"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "Any frames where the package is one of these packages will not be on the stack."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "=item * ignore_class => $package_name OR \\@package_names"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "Any frames where the package is a subclass of one of these packages (or is the"
NSQ_SOURCE_LINE 00000426 "same package) will not be on the stack."
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "Devel::StackTrace internally adds itself to the 'ignore_package' parameter,"
NSQ_SOURCE_LINE 00000429 "meaning that the Devel::StackTrace package is B<ALWAYS> ignored. However, if"
NSQ_SOURCE_LINE 00000430 "you create a subclass of Devel::StackTrace it will not be ignored."
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "=item * skip_frames => $integer"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "This will cause this number of stack frames to be excluded from top of the"
NSQ_SOURCE_LINE 00000435 "stack trace. This prevents the frames from being captured at all, and applies"
NSQ_SOURCE_LINE 00000436 "before the C<frame_filter>, C<ignore_package>, or C<ignore_class> options, even"
NSQ_SOURCE_LINE 00000437 "with C<filter_frames_early>."
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "=item * unsafe_ref_capture => $boolean"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "If this parameter is true, then Devel::StackTrace will store references"
NSQ_SOURCE_LINE 00000442 "internally when generating stacktrace frames."
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "B<This option is very dangerous, and should never be used with exception"
NSQ_SOURCE_LINE 00000445 "objects>. Using this option will keep any objects or references alive past"
NSQ_SOURCE_LINE 00000446 "their normal lifetime, until the stack trace object goes out of scope. It can"
NSQ_SOURCE_LINE 00000447 "keep objects alive even after their C<DESTROY> sub is called, resulting it it"
NSQ_SOURCE_LINE 00000448 "being called multiple times on the same object."
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "If not set, Devel::StackTrace replaces any references with their stringified"
NSQ_SOURCE_LINE 00000451 "representation."
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "=item * no_args => $boolean"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "If this parameter is true, then Devel::StackTrace will not store caller"
NSQ_SOURCE_LINE 00000456 "arguments in stack trace frames at all."
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "=item * respect_overload => $boolean"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "By default, Devel::StackTrace will call C<overload::AddrRef> to get the"
NSQ_SOURCE_LINE 00000461 "underlying string representation of an object, instead of respecting the"
NSQ_SOURCE_LINE 00000462 "object's stringification overloading. If you would prefer to see the overloaded"
NSQ_SOURCE_LINE 00000463 "representation of objects in stack traces, then set this parameter to true."
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=item * max_arg_length => $integer"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "By default, Devel::StackTrace will display the entire argument for each"
NSQ_SOURCE_LINE 00000468 "subroutine call. Setting this parameter causes truncates each subroutine"
NSQ_SOURCE_LINE 00000469 "argument's string representation if it is longer than this number of"
NSQ_SOURCE_LINE 00000470 "characters."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=item * message => $string"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "By default, Devel::StackTrace will use 'Trace begun' as the message for the"
NSQ_SOURCE_LINE 00000475 "first stack frame when you call C<as_string>. You can supply an alternative"
NSQ_SOURCE_LINE 00000476 "message using this option."
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "=item * indent => $boolean"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "If this parameter is true, each stack frame after the first will start with a"
NSQ_SOURCE_LINE 00000481 "tab character, just like C<Carp::confess>."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "=back"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "=head2 $trace->next_frame"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "Returns the next L<Devel::StackTrace::Frame> object on the stack, going down."
NSQ_SOURCE_LINE 00000488 "If this method hasn't been called before it returns the first frame. It returns"
NSQ_SOURCE_LINE 00000489 "C<undef> when it reaches the bottom of the stack and then resets its pointer so"
NSQ_SOURCE_LINE 00000490 "the next call to C<< $trace->next_frame >> or C<< $trace->prev_frame >> will"
NSQ_SOURCE_LINE 00000491 "work properly."
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "=head2 $trace->prev_frame"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "Returns the next L<Devel::StackTrace::Frame> object on the stack, going up. If"
NSQ_SOURCE_LINE 00000496 "this method hasn't been called before it returns the last frame. It returns"
NSQ_SOURCE_LINE 00000497 "undef when it reaches the top of the stack and then resets its pointer so the"
NSQ_SOURCE_LINE 00000498 "next call to C<< $trace->next_frame >> or C<< $trace->prev_frame >> will work"
NSQ_SOURCE_LINE 00000499 "properly."
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=head2 $trace->reset_pointer"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "Resets the pointer so that the next call to C<< $trace->next_frame >> or C<<"
NSQ_SOURCE_LINE 00000504 "$trace->prev_frame >> will start at the top or bottom of the stack, as"
NSQ_SOURCE_LINE 00000505 "appropriate."
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "=head2 $trace->frames"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "When this method is called with no arguments, it returns a list of"
NSQ_SOURCE_LINE 00000510 "L<Devel::StackTrace::Frame> objects. They are returned in order from top (most"
NSQ_SOURCE_LINE 00000511 "recent) to bottom."
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "This method can also be used to set the object's frames if you pass it a list"
NSQ_SOURCE_LINE 00000514 "of L<Devel::StackTrace::Frame> objects."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "This is useful if you want to filter the list of frames in ways that are more"
NSQ_SOURCE_LINE 00000517 "complex than can be handled by the C<< $trace->filter_frames >> method:"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "  $stacktrace->frames( my_filter( $stacktrace->frames ) );"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "=head2 $trace->frame($index)"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "Given an index, this method returns the relevant frame, or undef if there is no"
NSQ_SOURCE_LINE 00000524 "frame at that index. The index is exactly like a Perl array. The first frame is"
NSQ_SOURCE_LINE 00000525 "0 and negative indexes are allowed."
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "=head2 $trace->frame_count"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "Returns the number of frames in the trace object."
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "=head2 $trace->as_string(\\%p)"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "Calls C<< $frame->as_string >> on each frame from top to bottom, producing"
NSQ_SOURCE_LINE 00000534 "output quite similar to the Carp module's cluck/confess methods."
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "The optional C<\\%p> parameter only has one option. The C<max_arg_length>"
NSQ_SOURCE_LINE 00000537 "parameter truncates each subroutine argument's string representation if it is"
NSQ_SOURCE_LINE 00000538 "longer than this number of characters."
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "If all the frames in a trace are skipped then this just returns the C<message>"
NSQ_SOURCE_LINE 00000541 "passed to the constructor or the string C<\"Trace begun\">."
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "=head2 $trace->message"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "Returns the message passed to the constructor. If this wasn't passed then this"
NSQ_SOURCE_LINE 00000546 "method returns C<undef>."
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "Bugs may be submitted at L<https://github.com/houseabsolute/Devel-StackTrace/issues>."
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "The source code repository for Devel-StackTrace can be found at L<https://github.com/houseabsolute/Devel-StackTrace>."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "=head1 DONATIONS"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "If you'd like to thank me for the work I've done on this module, please"
NSQ_SOURCE_LINE 00000559 "consider making a \"donation\" to me via PayPal. I spend a lot of free time"
NSQ_SOURCE_LINE 00000560 "creating free software, and would appreciate any support you'd care to offer."
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "Please note that B<I am not suggesting that you must do this> in order for me"
NSQ_SOURCE_LINE 00000563 "to continue working on this particular software. I will continue to do so,"
NSQ_SOURCE_LINE 00000564 "inasmuch as I have in the past, for as long as it interests me."
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "Similarly, a donation made in this way will probably not make me work on this"
NSQ_SOURCE_LINE 00000567 "software much more, unless I get so many donations that I can consider working"
NSQ_SOURCE_LINE 00000568 "on free software full time (let's all have a chuckle at that together)."
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "To donate, log into PayPal and send money to autarch@urth.org, or use the"
NSQ_SOURCE_LINE 00000571 "button at L<https://houseabsolute.com/foss-donations/>."
NSQ_SOURCE_LINE 00000572 ""
