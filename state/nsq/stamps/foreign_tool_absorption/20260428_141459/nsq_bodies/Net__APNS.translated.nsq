NSQ_SOURCE_LINE 00000001 "package Net::APNS;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use Net::APNS::Notification;"
NSQ_SOURCE_LINE 00000005 "use Sub::Exporter -setup => {"
NSQ_SOURCE_LINE 00000006 "    exports => [ qw/notify/ ],"
NSQ_SOURCE_LINE 00000007 "};"
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.0202';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "sub new { bless {}, $_[0]; }"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "sub notify {"
NSQ_SOURCE_LINE 00000013 "    my ( $self, $args ) = @_;"
NSQ_SOURCE_LINE 00000014 "    return Net::APNS::Notification->new("
NSQ_SOURCE_LINE 00000015 "        cert   => $args->{cert},"
NSQ_SOURCE_LINE 00000016 "        key    => $args->{key},"
NSQ_SOURCE_LINE 00000017 "        passwd => $args->{passwd},"
NSQ_SOURCE_LINE 00000018 "    );"
NSQ_SOURCE_LINE 00000019 "}"
NSQ_SOURCE_LINE 00000020 ""
