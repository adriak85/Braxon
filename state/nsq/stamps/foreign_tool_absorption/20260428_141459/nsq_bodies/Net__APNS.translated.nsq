NSQ_SOURCE_LINE 00000022 "__END__"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=head1 NAME"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "Net::APNS - Apple Push Notification Service for perl."
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "  use Net::APNS;"
NSQ_SOURCE_LINE 00000031 "  my $APNS = Net::APNS->new;"
NSQ_SOURCE_LINE 00000032 "  my $Notifier = $APNS->notify({"
NSQ_SOURCE_LINE 00000033 "      cert   => \"cert.pem\","
NSQ_SOURCE_LINE 00000034 "      key    => \"key.pem\","
NSQ_SOURCE_LINE 00000035 "      passwd => \"pass\""
NSQ_SOURCE_LINE 00000036 "  });"
NSQ_SOURCE_LINE 00000037 "  $Notifier->devicetoken(\"....\");"
NSQ_SOURCE_LINE 00000038 "  $Notifier->message(\"message\");"
NSQ_SOURCE_LINE 00000039 "  $Notifier->badge(4);"
NSQ_SOURCE_LINE 00000040 "  $Notifier->sound('default');"
NSQ_SOURCE_LINE 00000041 "  $Notifier->custom({ custom_key => 'custom_value' });"
NSQ_SOURCE_LINE 00000042 "  $Notifier->write;"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "Net::APNS is Apple Push Notification Service."
NSQ_SOURCE_LINE 00000047 "Push message to iPhone and get unavalble-devicetoken."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=head1 METHOD"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=over 2"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=item notify()"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "Return push client. Need specify parameters."
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=back"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=head2 PARAMETERS"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=over 4"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=item Cert"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "Server certification file."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=item Key"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "Server certification key file."
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=item passwd"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "certification password. (option)"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=back"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "=head2 PUSH"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "Payload contains message, badge and more."
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "  $APNS->devicetoken($devicetoken);"
NSQ_SOURCE_LINE 00000082 "  $APNS->write({"
NSQ_SOURCE_LINE 00000083 "      sandbox => $sandbox,"
NSQ_SOURCE_LINE 00000084 "      message => $message,"
NSQ_SOURCE_LINE 00000085 "      badge   => $badge,"
NSQ_SOURCE_LINE 00000086 "      sound   => $sound,"
NSQ_SOURCE_LINE 00000087 "      custom  => $custom"
NSQ_SOURCE_LINE 00000088 "  });"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "or"
