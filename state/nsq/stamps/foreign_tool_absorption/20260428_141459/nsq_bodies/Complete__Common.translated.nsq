NSQ_SOURCE_LINE 00000001 "package Complete::Common;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2016-01-07'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.22'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000011 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000012 "                       %arg_word"
NSQ_SOURCE_LINE 00000013 "               );"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000016 "    all => \\@EXPORT_OK"
NSQ_SOURCE_LINE 00000017 ");"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "our %arg_word = ("
NSQ_SOURCE_LINE 00000020 "    word => {"
NSQ_SOURCE_LINE 00000021 "        summary => 'Word to complete',"
NSQ_SOURCE_LINE 00000022 "        schema => ['str', default=>''],"
NSQ_SOURCE_LINE 00000023 "        pos=>0,"
NSQ_SOURCE_LINE 00000024 "        req=>1,"
NSQ_SOURCE_LINE 00000025 "    },"
NSQ_SOURCE_LINE 00000026 ");"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "our $OPT_CI          = ($ENV{COMPLETE_OPT_CI}          // 1) ? 1:0;"
NSQ_SOURCE_LINE 00000029 "our $OPT_WORD_MODE   = ($ENV{COMPLETE_OPT_WORD_MODE}   // 1) ? 1:0;"
NSQ_SOURCE_LINE 00000030 "our $OPT_CHAR_MODE   = ($ENV{COMPLETE_OPT_CHAR_MODE}   // 1) ? 1:0;"
NSQ_SOURCE_LINE 00000031 "our $OPT_FUZZY       = ($ENV{COMPLETE_OPT_FUZZY}       // 1)+0;"
NSQ_SOURCE_LINE 00000032 "our $OPT_MAP_CASE    = ($ENV{COMPLETE_OPT_MAP_CASE}    // 1) ? 1:0;"
NSQ_SOURCE_LINE 00000033 "our $OPT_EXP_IM_PATH = ($ENV{COMPLETE_OPT_EXP_IM_PATH} // 1) ? 1:0;"
NSQ_SOURCE_LINE 00000034 "our $OPT_DIG_LEAF    = ($ENV{COMPLETE_OPT_DIG_LEAF}    // 1) ? 1:0;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "1;"
NSQ_SOURCE_LINE 00000037 "# ABSTRACT: Common stuffs for completion routines"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "__END__"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=pod"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=head1 NAME"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "Complete::Common - Common stuffs for completion routines"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=head1 VERSION"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "This document describes version 0.22 of Complete::Common (from Perl distribution Complete-Common), released on 2016-01-07."
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "This module defines some common arguments and settings. C<Complete::*> modules"
NSQ_SOURCE_LINE 00000056 "should use the default from these settings, to make it convenient for users to"
NSQ_SOURCE_LINE 00000057 "change some behaviors globally."
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "The defaults are optimized for convenience and laziness for user typing and"
NSQ_SOURCE_LINE 00000060 "might change from release to release."
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=head2 C<$Complete::Common::OPT_CI> => bool (default: from COMPLETE_OPT_CI or 1)"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "If set to 1, matching is done case-insensitively."
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "In bash/readline, this is akin to setting C<completion-ignore-case>."
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=head2 C<$Complete::Common::OPT_WORD_MODE> => bool (default: from COMPLETE_OPT_WORD_MODE or 1)"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "If set to 1, enable word-mode matching."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "Word mode matching is normally only done when exact matching fails to return any"
NSQ_SOURCE_LINE 00000073 "candidate. To give you an idea of how word-mode matching works, you can run"
NSQ_SOURCE_LINE 00000074 "Emacs and try its completion of filenames (C<C-x C-f>) or function names"
NSQ_SOURCE_LINE 00000075 "(C<M-x>). Basically, each string is split into words and matching is tried for"
NSQ_SOURCE_LINE 00000076 "all available word even non-adjacent ones. For example, if you have C<dua-d> and"
NSQ_SOURCE_LINE 00000077 "the choices are (C<dua-tiga>, C<dua-empat>, C<dua-lima-delapan>) then"
NSQ_SOURCE_LINE 00000078 "C<dua-lima-delapan> will match because C<d> matches C<delapan> even though the"
NSQ_SOURCE_LINE 00000079 "word is not adjacent. This is convenient when you have strings that are several"
NSQ_SOURCE_LINE 00000080 "or many words long: you can just type the starting letters of some of the words"
NSQ_SOURCE_LINE 00000081 "instead of just the starting letters of the whole string (which might need to be"
NSQ_SOURCE_LINE 00000082 "quite long before producing a unique match)."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head2 C<$Complete::Common::OPT_CHAR_MODE> => bool (default: from COMPLETE_OPT_CHAR_MODE or 1)"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "If set to 1, enable character-mode matching."
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "This mode is like word-mode matching, except it works on a"
NSQ_SOURCE_LINE 00000089 "character-by-character basis. Basically, it will match if a word contains any"
NSQ_SOURCE_LINE 00000090 "letters of the string in the correct order. For example, C<ap> will match C<ap>,"
NSQ_SOURCE_LINE 00000091 "C<amp>, C<slap>, or C<cramp> (but will not match C<pa> or C<pram>)."
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "Character-mode matching is normally only done when exact matching and word-mode"
NSQ_SOURCE_LINE 00000094 "fail to return any candidate."
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=head2 C<$Complete::Common::OPT_FUZZY> => int (default: from COMPLETE_OPT_FUZZY or 1)"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "Enable fuzzy matching (matching even though there are some spelling mistakes)."
NSQ_SOURCE_LINE 00000099 "The greater the number, the greater the tolerance. To disable fuzzy matching,"
NSQ_SOURCE_LINE 00000100 "set to 0."
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "Fuzzy matching is normally only done when exact matching, word-mode, and"
NSQ_SOURCE_LINE 00000103 "char-mode matching fail to return any candidate."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=head2 C<$Complete::Common::OPT_MAP_CASE> => bool (default: from COMPLETE_OPT_MAP_CASE or 1)"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "This is exactly like C<completion-map-case> in readline/bash to treat C<_> and"
NSQ_SOURCE_LINE 00000108 "C<-> as the same when matching."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "All L<Complete::Path>-based modules (like L<Complete::File>,"
NSQ_SOURCE_LINE 00000111 "L<Complete::Module>, or L<Complete::Riap>) respect this setting."
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head2 C<$Complete::Common::OPT_EXP_IM_PATH> => bool (default: from COMPLETE_OPT_EXP_IM_PATH or 1)"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "Whether to \"expand intermediate paths\". What is meant by this is something like"
NSQ_SOURCE_LINE 00000116 "zsh: when you type something like C<cd /h/u/b/myscript> it can be completed to"
NSQ_SOURCE_LINE 00000117 "C<cd /home/ujang/bin/myscript>."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "All L<Complete::Path>-based modules (like L<Complete::File>,"
NSQ_SOURCE_LINE 00000120 "L<Complete::Module>, or L<Complete::Riap>) respect this setting."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head2 C<$Complete::Common::OPT_DIG_LEAF> => bool (default: from COMPLETE_OPT_DIG_LEAF or 1)"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "(Experimental) When enabled, this option mimics what's seen on GitHub. If a"
NSQ_SOURCE_LINE 00000125 "directory entry only contains a single subentry, it will directly show the"
NSQ_SOURCE_LINE 00000126 "subentry (and subsubentry and so on) to save a number of tab presses."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "Suppose you have files like this:"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 " a"
NSQ_SOURCE_LINE 00000131 " b/c/d/e"
NSQ_SOURCE_LINE 00000132 " c"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "If you complete for C<b> you will directly get C<b/c/d/e> (the leaf)."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "This is currently experimental because if you want to complete only directories,"
NSQ_SOURCE_LINE 00000137 "you won't get b or b/c or b/c/d. Need to think how to solve this."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head2 COMPLETE_OPT_CI => bool"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "Set default for C<$Complete::Common::OPT_CI>."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=head2 COMPLETE_OPT_FUZZY => int"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "Set default for C<$Complete::Common::OPT_FUZZY>."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=head2 COMPLETE_OPT_WORD_MODE => bool"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "Set default for C<$Complete::Common::OPT_WORD_MODE>."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=head2 COMPLETE_OPT_MAP_CASE => bool"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "Set default for C<$Complete::Common::OPT_MAP_CASE>."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=head2 COMPLETE_OPT_EXP_IM_PATH => bool"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "Set default for C<$Complete::Common::OPT_EXP_IM_PATH>."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head2 COMPLETE_OPT_DIG_LEAF => bool"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "Set default for C<$Complete::Common::OPT_DIG_LEAF>."
NSQ_SOURCE_LINE 00000164 ""
