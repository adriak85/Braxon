NSQ_SOURCE_LINE 00000001 "use 5.006;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "package Test::Filename;"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: Portable filename comparison"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.03'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Test::Builder::Module;"
NSQ_SOURCE_LINE 00000009 "use Path::Tiny;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our @ISA = qw/Test::Builder::Module/; "
NSQ_SOURCE_LINE 00000012 "our @EXPORT = qw("
NSQ_SOURCE_LINE 00000013 "    filename_is "
NSQ_SOURCE_LINE 00000014 "    filename_isnt"
NSQ_SOURCE_LINE 00000015 "); "
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "my $CLASS = __PACKAGE__;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000020 "# public API"
NSQ_SOURCE_LINE 00000021 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub filename_is {"
NSQ_SOURCE_LINE 00000024 "    my($got, $expected, $label) = @_;"
NSQ_SOURCE_LINE 00000025 "    return $CLASS->builder->is_eq(path($got), path($expected), $label);"
NSQ_SOURCE_LINE 00000026 "}"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "sub filename_isnt {"
NSQ_SOURCE_LINE 00000029 "    my($got, $expected, $label) = @_;"
NSQ_SOURCE_LINE 00000030 "    return $CLASS->builder->isnt_eq(path($got), path($expected), $label);"
NSQ_SOURCE_LINE 00000031 "}"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "1;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "__END__"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "=pod"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "=head1 NAME"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "Test::Filename - Portable filename comparison"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=head1 VERSION"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "version 0.03"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "  use Test::Filename tests => 2;"
NSQ_SOURCE_LINE 00000051 "  "
NSQ_SOURCE_LINE 00000052 "  filename_is  ( \"some\\path\", \"some/path\", \"should pass\" );"
NSQ_SOURCE_LINE 00000053 "  filename_isnt( \"some\\path\", \"some/path\", \"should fail\" );"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "Many cross-platform test failures -- particularly on Win32 -- are due to"
NSQ_SOURCE_LINE 00000058 "hard-coded file paths being used in comparison tests."
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "  my $file = get_file();     # returns \"foo\\bar.t\";"
NSQ_SOURCE_LINE 00000061 "  is( $file, \"foo/bar.t\" );  # fails on Win32"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "This simple module provides some handy functions to convert all those"
NSQ_SOURCE_LINE 00000064 "path separators automatically so filename tests will just DWIM."
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "The alternative is to write your own utility subroutine and use it everywhere"
NSQ_SOURCE_LINE 00000067 "or just keep on littering your test code with calls to File::Spec -- yuck!"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "  is( $file, File::Spec->canonpath(\"some/path\"), \"should pass\" );"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "Since this module is so simple, you might not think it worth including as a"
NSQ_SOURCE_LINE 00000072 "dependency.  After all, it's not I<that> hard to always remember to use"
NSQ_SOURCE_LINE 00000073 "L<File::Spec>, L<Path::Tiny> or some other file utility, right? But odds are"
NSQ_SOURCE_LINE 00000074 "that, at some point, you'll be so busy writing tests that you'll forget and"
NSQ_SOURCE_LINE 00000075 "hard-code a path in your haste to show what a clever programmer you are."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "So just use this module and stop worrying about it.  You'll be happier"
NSQ_SOURCE_LINE 00000078 "and so will anyone trying to install your modules on Win32."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head1 USAGE"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Just like Test::More, you have the option of providing a test plan"
NSQ_SOURCE_LINE 00000083 "as arguments when you use this module. The following functions are "
NSQ_SOURCE_LINE 00000084 "imported by default."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=head2 filename_is"
NSQ_SOURCE_LINE 00000087 "=head2 filename_isnt"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    filename_is  ( $got, $expected, $label );"
NSQ_SOURCE_LINE 00000090 "    filename_isnt( $got, $expected, $label );"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "These functions work just like C<is()> and C<isnt()> from Test::More, but"
NSQ_SOURCE_LINE 00000093 "the first two argument will be cleaned up and normalized to Unix-style"
NSQ_SOURCE_LINE 00000094 "paths using L<Path::Tiny>.  This means that C<.\\foo.txt> will get normalized"
NSQ_SOURCE_LINE 00000095 "to C<foo.txt> and so on."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000098 ""
