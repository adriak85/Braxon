BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "\r"
NSQ_SOURCE_LINE 00000002 "###\r"
NSQ_SOURCE_LINE 00000003 "# XML::SAX::Expat - SAX2 Driver for Expat (XML::Parser)\r"
NSQ_SOURCE_LINE 00000004 "# Originally by Robin Berjon\r"
NSQ_SOURCE_LINE 00000005 "###\r"
NSQ_SOURCE_LINE 00000006 "\r"
NSQ_SOURCE_LINE 00000007 "package XML::SAX::Expat;\r"
NSQ_SOURCE_LINE 00000008 "use strict;\r"
NSQ_SOURCE_LINE 00000009 "use base qw(XML::SAX::Base);\r"
NSQ_SOURCE_LINE 00000010 "use XML::NamespaceSupport   qw();\r"
NSQ_SOURCE_LINE 00000011 "use XML::Parser             qw();\r"
NSQ_SOURCE_LINE 00000012 "\r"
NSQ_SOURCE_LINE 00000013 "use vars qw($VERSION);\r"
NSQ_SOURCE_LINE 00000014 "$VERSION = '0.51';\r"
NSQ_SOURCE_LINE 00000015 "\r"
NSQ_SOURCE_LINE 00000016 "\r"
NSQ_SOURCE_LINE 00000017 "#,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,#\r"
NSQ_SOURCE_LINE 00000018 "#`,`, Variations on parse `,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,#\r"
NSQ_SOURCE_LINE 00000019 "#```````````````````````````````````````````````````````````````````#\r"
NSQ_SOURCE_LINE 00000020 "\r"
NSQ_SOURCE_LINE 00000021 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000022 "# CharacterStream\r"
NSQ_SOURCE_LINE 00000023 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000024 "sub _parse_characterstream {\r"
NSQ_SOURCE_LINE 00000025 "    my $p       = shift;\r"
NSQ_SOURCE_LINE 00000026 "    my $xml     = shift;\r"
NSQ_SOURCE_LINE 00000027 "    my $opt     = shift;\r"
NSQ_SOURCE_LINE 00000028 "\r"
NSQ_SOURCE_LINE 00000029 "    my $expat = $p->_create_parser($opt);\r"
NSQ_SOURCE_LINE 00000030 "    my $result = $expat->parse($xml);\r"
NSQ_SOURCE_LINE 00000031 "    $p->_cleanup;\r"
NSQ_SOURCE_LINE 00000032 "    return $result;\r"
NSQ_SOURCE_LINE 00000033 "}\r"
NSQ_SOURCE_LINE 00000034 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000035 "\r"
NSQ_SOURCE_LINE 00000036 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000037 "# ByteStream\r"
NSQ_SOURCE_LINE 00000038 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000039 "sub _parse_bytestream {\r"
NSQ_SOURCE_LINE 00000040 "    my $p       = shift;\r"
NSQ_SOURCE_LINE 00000041 "    my $xml     = shift;\r"
NSQ_SOURCE_LINE 00000042 "    my $opt     = shift;\r"
NSQ_SOURCE_LINE 00000043 "\r"
NSQ_SOURCE_LINE 00000044 "    my $expat = $p->_create_parser($opt);\r"
NSQ_SOURCE_LINE 00000045 "    my $result = $expat->parse($xml);\r"
NSQ_SOURCE_LINE 00000046 "    $p->_cleanup;\r"
NSQ_SOURCE_LINE 00000047 "    return $result;\r"
NSQ_SOURCE_LINE 00000048 "}\r"
NSQ_SOURCE_LINE 00000049 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000050 "\r"
NSQ_SOURCE_LINE 00000051 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000052 "# String\r"
NSQ_SOURCE_LINE 00000053 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000054 "sub _parse_string {\r"
NSQ_SOURCE_LINE 00000055 "    my $p       = shift;\r"
NSQ_SOURCE_LINE 00000056 "    my $xml     = shift;\r"
NSQ_SOURCE_LINE 00000057 "    my $opt     = shift;\r"
NSQ_SOURCE_LINE 00000058 "\r"
NSQ_SOURCE_LINE 00000059 "    my $expat = $p->_create_parser($opt);\r"
NSQ_SOURCE_LINE 00000060 "    my $result = $expat->parse($xml);\r"
NSQ_SOURCE_LINE 00000061 "    $p->_cleanup;\r"
NSQ_SOURCE_LINE 00000062 "    return $result;\r"
NSQ_SOURCE_LINE 00000063 "}\r"
NSQ_SOURCE_LINE 00000064 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000065 "\r"
NSQ_SOURCE_LINE 00000066 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000067 "# SystemId\r"
NSQ_SOURCE_LINE 00000068 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000069 "sub _parse_systemid {\r"
NSQ_SOURCE_LINE 00000070 "    my $p       = shift;\r"
NSQ_SOURCE_LINE 00000071 "    my $xml     = shift;\r"
NSQ_SOURCE_LINE 00000072 "    my $opt     = shift;\r"
NSQ_SOURCE_LINE 00000073 "\r"
NSQ_SOURCE_LINE 00000074 "    my $expat = $p->_create_parser($opt);\r"
NSQ_SOURCE_LINE 00000075 "    my $result = $expat->parsefile($xml);\r"
NSQ_SOURCE_LINE 00000076 "    $p->_cleanup;\r"
NSQ_SOURCE_LINE 00000077 "    return $result;\r"
NSQ_SOURCE_LINE 00000078 "}\r"
NSQ_SOURCE_LINE 00000079 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000080 "\r"
NSQ_SOURCE_LINE 00000081 "\r"
NSQ_SOURCE_LINE 00000082 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000083 "# $p->_create_parser(\\%options)\r"
NSQ_SOURCE_LINE 00000084 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000085 "sub _create_parser {\r"
NSQ_SOURCE_LINE 00000086 "    my $self = shift;\r"
NSQ_SOURCE_LINE 00000087 "    my $opt  = shift;\r"
NSQ_SOURCE_LINE 00000088 "\r"
NSQ_SOURCE_LINE 00000089 "    die \"ParserReference: parser instance ($self) already parsing\\n\"\r"
NSQ_SOURCE_LINE 00000090 "         if $self->{_InParse};\r"
NSQ_SOURCE_LINE 00000091 "\r"
NSQ_SOURCE_LINE 00000092 "    my $featUri = 'http://xml.org/sax/features/';\r"
NSQ_SOURCE_LINE 00000093 "    my $ppe = ($self->get_feature($featUri . 'external-general-entities') or\r"
NSQ_SOURCE_LINE 00000094 "               $self->get_feature($featUri . 'external-parameter-entities') ) ? 1 : 0;\r"
NSQ_SOURCE_LINE 00000095 "\r"
NSQ_SOURCE_LINE 00000096 "    my $expat = XML::Parser->new( ParseParamEnt => $ppe );\r"
NSQ_SOURCE_LINE 00000097 "    $expat->{__XSE} = $self;\r"
NSQ_SOURCE_LINE 00000098 "    $expat->setHandlers(\r"
NSQ_SOURCE_LINE 00000099 "                        Init        => \\&_handle_init,\r"
NSQ_SOURCE_LINE 00000100 "                        Final       => \\&_handle_final,\r"
NSQ_SOURCE_LINE 00000101 "                        Start       => \\&_handle_start,\r"
NSQ_SOURCE_LINE 00000102 "                        End         => \\&_handle_end,\r"
NSQ_SOURCE_LINE 00000103 "                        Char        => \\&_handle_char,\r"
NSQ_SOURCE_LINE 00000104 "                        Comment     => \\&_handle_comment,\r"
NSQ_SOURCE_LINE 00000105 "                        Proc        => \\&_handle_proc,\r"
NSQ_SOURCE_LINE 00000106 "                        CdataStart  => \\&_handle_start_cdata,\r"
NSQ_SOURCE_LINE 00000107 "                        CdataEnd    => \\&_handle_end_cdata,\r"
NSQ_SOURCE_LINE 00000108 "                        Unparsed    => \\&_handle_unparsed_entity,\r"
NSQ_SOURCE_LINE 00000109 "                        Notation    => \\&_handle_notation_decl,\r"
NSQ_SOURCE_LINE 00000110 "                        #ExternEnt\r"
NSQ_SOURCE_LINE 00000111 "                        #ExternEntFin\r"
NSQ_SOURCE_LINE 00000112 "                        Entity      => \\&_handle_entity_decl,\r"
NSQ_SOURCE_LINE 00000113 "                        Element     => \\&_handle_element_decl,\r"
NSQ_SOURCE_LINE 00000114 "                        Attlist     => \\&_handle_attr_decl,\r"
NSQ_SOURCE_LINE 00000115 "                        Doctype     => \\&_handle_start_doctype,\r"
NSQ_SOURCE_LINE 00000116 "                        DoctypeFin  => \\&_handle_end_doctype,\r"
NSQ_SOURCE_LINE 00000117 "                        XMLDecl     => \\&_handle_xml_decl,\r"
NSQ_SOURCE_LINE 00000118 "                      );\r"
NSQ_SOURCE_LINE 00000119 "\r"
NSQ_SOURCE_LINE 00000120 "    $self->{_InParse} = 1;\r"
NSQ_SOURCE_LINE 00000121 "    $self->{_NodeStack} = [];\r"
NSQ_SOURCE_LINE 00000122 "    $self->{_NSStack} = [];\r"
NSQ_SOURCE_LINE 00000123 "    $self->{_NSHelper} = XML::NamespaceSupport->new({xmlns => 1});\r"
NSQ_SOURCE_LINE 00000124 "    $self->{_started} = 0;\r"
NSQ_SOURCE_LINE 00000125 "\r"
NSQ_SOURCE_LINE 00000126 "    return $expat;\r"
NSQ_SOURCE_LINE 00000127 "}\r"
NSQ_SOURCE_LINE 00000128 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000129 "\r"
NSQ_SOURCE_LINE 00000130 "\r"
NSQ_SOURCE_LINE 00000131 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000132 "# $p->_cleanup\r"
NSQ_SOURCE_LINE 00000133 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000134 "sub _cleanup {\r"
NSQ_SOURCE_LINE 00000135 "    my $self = shift;\r"
NSQ_SOURCE_LINE 00000136 "\r"
NSQ_SOURCE_LINE 00000137 "    $self->{_InParse} = 0;\r"
NSQ_SOURCE_LINE 00000138 "    delete $self->{_NodeStack};\r"
NSQ_SOURCE_LINE 00000139 "}\r"
NSQ_SOURCE_LINE 00000140 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000141 "\r"
NSQ_SOURCE_LINE 00000142 "\r"
NSQ_SOURCE_LINE 00000143 "\r"
NSQ_SOURCE_LINE 00000144 "#,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,#\r"
NSQ_SOURCE_LINE 00000145 "#`,`, Expat Handlers ,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,#\r"
NSQ_SOURCE_LINE 00000146 "#```````````````````````````````````````````````````````````````````#\r"
NSQ_SOURCE_LINE 00000147 "\r"
NSQ_SOURCE_LINE 00000148 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000149 "# _handle_init\r"
NSQ_SOURCE_LINE 00000150 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000151 "sub _handle_init {\r"
NSQ_SOURCE_LINE 00000152 "    #my $self    = shift()->{__XSE};\r"
NSQ_SOURCE_LINE 00000153 "\r"
NSQ_SOURCE_LINE 00000154 "    #my $document = {};\r"
NSQ_SOURCE_LINE 00000155 "    #push @{$self->{_NodeStack}}, $document;\r"
NSQ_SOURCE_LINE 00000156 "    #$self->SUPER::start_document($document);\r"
NSQ_SOURCE_LINE 00000157 "}\r"
NSQ_SOURCE_LINE 00000158 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000159 "\r"
NSQ_SOURCE_LINE 00000160 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000161 "# _handle_final\r"
NSQ_SOURCE_LINE 00000162 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000163 "sub _handle_final {\r"
NSQ_SOURCE_LINE 00000164 "    my $self    = shift()->{__XSE};\r"
NSQ_SOURCE_LINE 00000165 "\r"
NSQ_SOURCE_LINE 00000166 "    #my $document = pop @{$self->{_NodeStack}};\r"
NSQ_SOURCE_LINE 00000167 "    return $self->SUPER::end_document({});\r"
NSQ_SOURCE_LINE 00000168 "}\r"
NSQ_SOURCE_LINE 00000169 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000170 "\r"
NSQ_SOURCE_LINE 00000171 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000172 "# _handle_start\r"
NSQ_SOURCE_LINE 00000173 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000174 "sub _handle_start {\r"
NSQ_SOURCE_LINE 00000175 "    my $self    = shift()->{__XSE};\r"
NSQ_SOURCE_LINE 00000176 "    my $e_name  = shift;\r"
NSQ_SOURCE_LINE 00000177 "    my %attr    = @_;\r"
NSQ_SOURCE_LINE 00000178 "\r"
NSQ_SOURCE_LINE 00000179 "    # start_document data\r"
NSQ_SOURCE_LINE 00000180 "    $self->_handle_start_document({}) unless $self->{_started};\r"
NSQ_SOURCE_LINE 00000181 "\r"
NSQ_SOURCE_LINE 00000182 "    # take care of namespaces\r"
NSQ_SOURCE_LINE 00000183 "    my $nsh = $self->{_NSHelper};\r"
NSQ_SOURCE_LINE 00000184 "    $nsh->push_context;\r"
NSQ_SOURCE_LINE 00000185 "    my @new_ns;\r"
NSQ_SOURCE_LINE 00000186 "    for my $k (grep !index($_, 'xmlns'), keys %attr) {\r"
NSQ_SOURCE_LINE 00000187 "        $k =~ m/^xmlns(:(.*))?$/;\r"
NSQ_SOURCE_LINE 00000188 "        my $prefix = $2 || '';\r"
NSQ_SOURCE_LINE 00000189 "        $nsh->declare_prefix($prefix, $attr{$k});\r"
NSQ_SOURCE_LINE 00000190 "        my $ns = {\r"
NSQ_SOURCE_LINE 00000191 "                    Prefix       => $prefix,\r"
NSQ_SOURCE_LINE 00000192 "                    NamespaceURI => $attr{$k},\r"
NSQ_SOURCE_LINE 00000193 "                 };\r"
NSQ_SOURCE_LINE 00000194 "        push @new_ns, $ns;\r"
NSQ_SOURCE_LINE 00000195 "        $self->SUPER::start_prefix_mapping($ns);\r"
NSQ_SOURCE_LINE 00000196 "    }\r"
NSQ_SOURCE_LINE 00000197 "    push @{$self->{_NSStack}}, \\@new_ns;\r"
NSQ_SOURCE_LINE 00000198 "\r"
NSQ_SOURCE_LINE 00000199 "\r"
NSQ_SOURCE_LINE 00000200 "    # create the attributes\r"
NSQ_SOURCE_LINE 00000201 "    my %saxattr;\r"
NSQ_SOURCE_LINE 00000202 "    map {\r"
NSQ_SOURCE_LINE 00000203 "        my ($ns,$prefix,$lname) = $nsh->process_attribute_name($_);\r"
NSQ_SOURCE_LINE 00000204 "        $saxattr{'{' . ($ns || '') . '}' . $lname} = {\r"
NSQ_SOURCE_LINE 00000205 "                                    Name         => $_,\r"
NSQ_SOURCE_LINE 00000206 "                                    LocalName    => $lname || '',\r"
NSQ_SOURCE_LINE 00000207 "                                    Prefix       => $prefix || '',\r"
NSQ_SOURCE_LINE 00000208 "                                    Value        => $attr{$_},\r"
NSQ_SOURCE_LINE 00000209 "                                    NamespaceURI => $ns || '',\r"
NSQ_SOURCE_LINE 00000210 "                                 };\r"
NSQ_SOURCE_LINE 00000211 "    } keys %attr;\r"
NSQ_SOURCE_LINE 00000212 "\r"
NSQ_SOURCE_LINE 00000213 "\r"
NSQ_SOURCE_LINE 00000214 "    # now the element\r"
NSQ_SOURCE_LINE 00000215 "    my ($ns,$prefix,$lname) = $nsh->process_element_name($e_name);\r"
NSQ_SOURCE_LINE 00000216 "    my $element = {\r"
NSQ_SOURCE_LINE 00000217 "                    Name         => $e_name,\r"
NSQ_SOURCE_LINE 00000218 "                    LocalName    => $lname || '',\r"
NSQ_SOURCE_LINE 00000219 "                    Prefix       => $prefix || '',\r"
NSQ_SOURCE_LINE 00000220 "                    NamespaceURI => $ns || '',\r"
NSQ_SOURCE_LINE 00000221 "                    Attributes   => \\%saxattr,\r"
NSQ_SOURCE_LINE 00000222 "                   };\r"
NSQ_SOURCE_LINE 00000223 "\r"
NSQ_SOURCE_LINE 00000224 "    push @{$self->{_NodeStack}}, $element;\r"
NSQ_SOURCE_LINE 00000225 "    $self->SUPER::start_element($element);\r"
NSQ_SOURCE_LINE 00000226 "}\r"
NSQ_SOURCE_LINE 00000227 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000228 "\r"
NSQ_SOURCE_LINE 00000229 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000230 "# _handle_end\r"
NSQ_SOURCE_LINE 00000231 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000232 "sub _handle_end {\r"
NSQ_SOURCE_LINE 00000233 "    my $self    = shift()->{__XSE};\r"
NSQ_SOURCE_LINE 00000234 "\r"
NSQ_SOURCE_LINE 00000235 "    my %element = %{pop @{$self->{_NodeStack}}};\r"
NSQ_SOURCE_LINE 00000236 "    delete $element{Attributes};\r"
NSQ_SOURCE_LINE 00000237 "    $self->SUPER::end_element(\\%element);\r"
NSQ_SOURCE_LINE 00000238 "\r"
NSQ_SOURCE_LINE 00000239 "    my $prev_ns = pop @{$self->{_NSStack}};\r"
NSQ_SOURCE_LINE 00000240 "    for my $ns (@$prev_ns) {\r"
NSQ_SOURCE_LINE 00000241 "        $self->SUPER::end_prefix_mapping( { %$ns } );\r"
NSQ_SOURCE_LINE 00000242 "    }\r"
NSQ_SOURCE_LINE 00000243 "    $self->{_NSHelper}->pop_context;\r"
NSQ_SOURCE_LINE 00000244 "}\r"
NSQ_SOURCE_LINE 00000245 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000246 "\r"
NSQ_SOURCE_LINE 00000247 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000248 "# _handle_char\r"
NSQ_SOURCE_LINE 00000249 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000250 "sub _handle_char {\r"
NSQ_SOURCE_LINE 00000251 "    $_[0]->{__XSE}->_handle_start_document({}) unless $_[0]->{__XSE}->{_started};\r"
NSQ_SOURCE_LINE 00000252 "    $_[0]->{__XSE}->SUPER::characters({ Data => $_[1] });\r"
NSQ_SOURCE_LINE 00000253 "}\r"
NSQ_SOURCE_LINE 00000254 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000255 "\r"
NSQ_SOURCE_LINE 00000256 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000257 "# _handle_comment\r"
NSQ_SOURCE_LINE 00000258 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000259 "sub _handle_comment {\r"
NSQ_SOURCE_LINE 00000260 "    $_[0]->{__XSE}->_handle_start_document({}) unless $_[0]->{__XSE}->{_started};\r"
NSQ_SOURCE_LINE 00000261 "    $_[0]->{__XSE}->SUPER::comment({ Data => $_[1] });\r"
NSQ_SOURCE_LINE 00000262 "}\r"
NSQ_SOURCE_LINE 00000263 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000264 "\r"
NSQ_SOURCE_LINE 00000265 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000266 "# _handle_proc\r"
NSQ_SOURCE_LINE 00000267 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000268 "sub _handle_proc {\r"
NSQ_SOURCE_LINE 00000269 "    $_[0]->{__XSE}->_handle_start_document({}) unless $_[0]->{__XSE}->{_started};\r"
NSQ_SOURCE_LINE 00000270 "    $_[0]->{__XSE}->SUPER::processing_instruction({ Target => $_[1], Data => $_[2] });\r"
NSQ_SOURCE_LINE 00000271 "}\r"
NSQ_SOURCE_LINE 00000272 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000273 "\r"
NSQ_SOURCE_LINE 00000274 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000275 "# _handle_start_cdata\r"
NSQ_SOURCE_LINE 00000276 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000277 "sub _handle_start_cdata {\r"
NSQ_SOURCE_LINE 00000278 "    $_[0]->{__XSE}->SUPER::start_cdata( {} );\r"
NSQ_SOURCE_LINE 00000279 "}\r"
NSQ_SOURCE_LINE 00000280 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000281 "\r"
NSQ_SOURCE_LINE 00000282 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000283 "# _handle_end_cdata\r"
NSQ_SOURCE_LINE 00000284 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000285 "sub _handle_end_cdata {\r"
NSQ_SOURCE_LINE 00000286 "    $_[0]->{__XSE}->SUPER::end_cdata( {} );\r"
NSQ_SOURCE_LINE 00000287 "}\r"
NSQ_SOURCE_LINE 00000288 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000289 "\r"
NSQ_SOURCE_LINE 00000290 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000291 "# _handle_xml_decl\r"
NSQ_SOURCE_LINE 00000292 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000293 "sub _handle_xml_decl {\r"
NSQ_SOURCE_LINE 00000294 "    my $self    = shift()->{__XSE};\r"
NSQ_SOURCE_LINE 00000295 "    my $version     = shift;\r"
NSQ_SOURCE_LINE 00000296 "    my $encoding    = shift;\r"
NSQ_SOURCE_LINE 00000297 "    my $standalone  = shift;\r"
NSQ_SOURCE_LINE 00000298 "\r"
NSQ_SOURCE_LINE 00000299 "    if (not defined $standalone) { $standalone = '';    }\r"
NSQ_SOURCE_LINE 00000300 "    elsif ($standalone)          { $standalone = 'yes'; }\r"
NSQ_SOURCE_LINE 00000301 "    else                         { $standalone = 'no';  }\r"
NSQ_SOURCE_LINE 00000302 "    my $xd = {\r"
NSQ_SOURCE_LINE 00000303 "                Version     => $version,\r"
NSQ_SOURCE_LINE 00000304 "                Encoding    => $encoding,\r"
NSQ_SOURCE_LINE 00000305 "                Standalone  => $standalone,\r"
NSQ_SOURCE_LINE 00000306 "             };\r"
NSQ_SOURCE_LINE 00000307 "    #$self->SUPER::xml_decl($xd);\r"
NSQ_SOURCE_LINE 00000308 "    $self->_handle_start_document($xd);\r"
NSQ_SOURCE_LINE 00000309 "}\r"
NSQ_SOURCE_LINE 00000310 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000311 "\r"
NSQ_SOURCE_LINE 00000312 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000313 "# _handle_notation_decl\r"
NSQ_SOURCE_LINE 00000314 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000315 "sub _handle_notation_decl {\r"
NSQ_SOURCE_LINE 00000316 "    my $self    = shift()->{__XSE};\r"
NSQ_SOURCE_LINE 00000317 "    my $notation    = shift;\r"
NSQ_SOURCE_LINE 00000318 "    shift;\r"
NSQ_SOURCE_LINE 00000319 "    my $system      = shift;\r"
NSQ_SOURCE_LINE 00000320 "    my $public      = shift;\r"
NSQ_SOURCE_LINE 00000321 "\r"
NSQ_SOURCE_LINE 00000322 "    my $not = {\r"
NSQ_SOURCE_LINE 00000323 "                Name        => $notation,\r"
NSQ_SOURCE_LINE 00000324 "                PublicId    => $public,\r"
NSQ_SOURCE_LINE 00000325 "                SystemId    => $system,\r"
NSQ_SOURCE_LINE 00000326 "              };\r"
NSQ_SOURCE_LINE 00000327 "    $self->SUPER::notation_decl($not);\r"
NSQ_SOURCE_LINE 00000328 "}\r"
NSQ_SOURCE_LINE 00000329 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000330 "\r"
NSQ_SOURCE_LINE 00000331 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000332 "# _handle_unparsed_entity\r"
NSQ_SOURCE_LINE 00000333 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000334 "sub _handle_unparsed_entity {\r"
NSQ_SOURCE_LINE 00000335 "    my $self    = shift()->{__XSE};\r"
NSQ_SOURCE_LINE 00000336 "    my $name        = shift;\r"
NSQ_SOURCE_LINE 00000337 "    my $system      = shift;\r"
NSQ_SOURCE_LINE 00000338 "    my $public      = shift;\r"
NSQ_SOURCE_LINE 00000339 "    my $notation    = shift;\r"
NSQ_SOURCE_LINE 00000340 "\r"
NSQ_SOURCE_LINE 00000341 "    my $ue = {\r"
NSQ_SOURCE_LINE 00000342 "                Name        => $name,\r"
NSQ_SOURCE_LINE 00000343 "                PublicId    => $public,\r"
NSQ_SOURCE_LINE 00000344 "                SystemId    => $system,\r"
NSQ_SOURCE_LINE 00000345 "                Notation    => $notation,\r"
NSQ_SOURCE_LINE 00000346 "             };\r"
NSQ_SOURCE_LINE 00000347 "    $self->SUPER::unparsed_entity_decl($ue);\r"
NSQ_SOURCE_LINE 00000348 "}\r"
NSQ_SOURCE_LINE 00000349 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000350 "\r"
NSQ_SOURCE_LINE 00000351 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000352 "# _handle_element_decl\r"
NSQ_SOURCE_LINE 00000353 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000354 "sub _handle_element_decl {\r"
NSQ_SOURCE_LINE 00000355 "    $_[0]->{__XSE}->SUPER::element_decl({ Name => $_[1], Model => \"$_[2]\" });\r"
NSQ_SOURCE_LINE 00000356 "}\r"
NSQ_SOURCE_LINE 00000357 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000358 "\r"
NSQ_SOURCE_LINE 00000359 "\r"
NSQ_SOURCE_LINE 00000360 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000361 "# _handle_attr_decl\r"
NSQ_SOURCE_LINE 00000362 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000363 "sub _handle_attr_decl {\r"
NSQ_SOURCE_LINE 00000364 "    my $self    = shift()->{__XSE};\r"
NSQ_SOURCE_LINE 00000365 "    my $ename   = shift;\r"
NSQ_SOURCE_LINE 00000366 "    my $aname   = shift;\r"
NSQ_SOURCE_LINE 00000367 "    my $type    = shift;\r"
NSQ_SOURCE_LINE 00000368 "    my $default = shift;\r"
NSQ_SOURCE_LINE 00000369 "    my $fixed   = shift;\r"
NSQ_SOURCE_LINE 00000370 "\r"
NSQ_SOURCE_LINE 00000371 "    my ($vd, $value);\r"
NSQ_SOURCE_LINE 00000372 "    if ($fixed) {\r"
NSQ_SOURCE_LINE 00000373 "        $vd = '#FIXED';\r"
NSQ_SOURCE_LINE 00000374 "        $default =~ s/^(?:\"|')//; #\"\r"
NSQ_SOURCE_LINE 00000375 "        $default =~ s/(?:\"|')$//; #\"\r"
NSQ_SOURCE_LINE 00000376 "        $value = $default;\r"
NSQ_SOURCE_LINE 00000377 "    }\r"
NSQ_SOURCE_LINE 00000378 "    else {\r"
NSQ_SOURCE_LINE 00000379 "        if ($default =~ m/^#/) {\r"
NSQ_SOURCE_LINE 00000380 "            $vd = $default;\r"
NSQ_SOURCE_LINE 00000381 "            $value = '';\r"
NSQ_SOURCE_LINE 00000382 "        }\r"
NSQ_SOURCE_LINE 00000383 "        else {\r"
NSQ_SOURCE_LINE 00000384 "            $vd = ''; # maybe there's a default ?\r"
NSQ_SOURCE_LINE 00000385 "            $default =~ s/^(?:\"|')//; #\"\r"
NSQ_SOURCE_LINE 00000386 "            $default =~ s/(?:\"|')$//; #\"\r"
NSQ_SOURCE_LINE 00000387 "            $value = $default;\r"
NSQ_SOURCE_LINE 00000388 "        }\r"
NSQ_SOURCE_LINE 00000389 "    }\r"
NSQ_SOURCE_LINE 00000390 "\r"
NSQ_SOURCE_LINE 00000391 "    my $at = {\r"
NSQ_SOURCE_LINE 00000392 "                eName           => $ename,\r"
NSQ_SOURCE_LINE 00000393 "                aName           => $aname,\r"
NSQ_SOURCE_LINE 00000394 "                Type            => $type,\r"
NSQ_SOURCE_LINE 00000395 "                ValueDefault    => $vd,\r"
NSQ_SOURCE_LINE 00000396 "                Value           => $value,\r"
NSQ_SOURCE_LINE 00000397 "             };\r"
NSQ_SOURCE_LINE 00000398 "    $self->SUPER::attribute_decl($at);\r"
NSQ_SOURCE_LINE 00000399 "}\r"
NSQ_SOURCE_LINE 00000400 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000401 "\r"
NSQ_SOURCE_LINE 00000402 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000403 "# _handle_entity_decl\r"
NSQ_SOURCE_LINE 00000404 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000405 "sub _handle_entity_decl {\r"
NSQ_SOURCE_LINE 00000406 "    my $self    = shift()->{__XSE};\r"
NSQ_SOURCE_LINE 00000407 "    my $name    = shift;\r"
NSQ_SOURCE_LINE 00000408 "    my $val     = shift;\r"
NSQ_SOURCE_LINE 00000409 "    my $sys     = shift;\r"
NSQ_SOURCE_LINE 00000410 "    my $pub     = shift;\r"
NSQ_SOURCE_LINE 00000411 "    my $ndata   = shift;\r"
NSQ_SOURCE_LINE 00000412 "    my $isprm   = shift;\r"
NSQ_SOURCE_LINE 00000413 "\r"
NSQ_SOURCE_LINE 00000414 "    # deal with param ents\r"
NSQ_SOURCE_LINE 00000415 "    if ($isprm) {\r"
NSQ_SOURCE_LINE 00000416 "        $name = '%' . $name;\r"
NSQ_SOURCE_LINE 00000417 "    }\r"
NSQ_SOURCE_LINE 00000418 "\r"
NSQ_SOURCE_LINE 00000419 "    # int vs ext\r"
NSQ_SOURCE_LINE 00000420 "    if ($val) {\r"
NSQ_SOURCE_LINE 00000421 "        my $ent = {\r"
NSQ_SOURCE_LINE 00000422 "                    Name    => $name,\r"
NSQ_SOURCE_LINE 00000423 "                    Value   => $val,\r"
NSQ_SOURCE_LINE 00000424 "                  };\r"
NSQ_SOURCE_LINE 00000425 "        $self->SUPER::internal_entity_decl($ent);\r"
NSQ_SOURCE_LINE 00000426 "    }\r"
NSQ_SOURCE_LINE 00000427 "    else {\r"
NSQ_SOURCE_LINE 00000428 "        my $ent = {\r"
NSQ_SOURCE_LINE 00000429 "                    Name        => $name,\r"
NSQ_SOURCE_LINE 00000430 "                    PublicId    => $pub || '',\r"
NSQ_SOURCE_LINE 00000431 "                    SystemId    => $sys,\r"
NSQ_SOURCE_LINE 00000432 "                  };\r"
NSQ_SOURCE_LINE 00000433 "        $self->SUPER::external_entity_decl($ent);\r"
NSQ_SOURCE_LINE 00000434 "    }\r"
NSQ_SOURCE_LINE 00000435 "}\r"
NSQ_SOURCE_LINE 00000436 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000437 "\r"
NSQ_SOURCE_LINE 00000438 "\r"
NSQ_SOURCE_LINE 00000439 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000440 "# _handle_start_doctype\r"
NSQ_SOURCE_LINE 00000441 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000442 "sub _handle_start_doctype {\r"
NSQ_SOURCE_LINE 00000443 "    my $self    = shift()->{__XSE};\r"
NSQ_SOURCE_LINE 00000444 "    my $name    = shift;\r"
NSQ_SOURCE_LINE 00000445 "    my $sys     = shift;\r"
NSQ_SOURCE_LINE 00000446 "    my $pub     = shift;\r"
NSQ_SOURCE_LINE 00000447 "\r"
NSQ_SOURCE_LINE 00000448 "    $self->_handle_start_document({}) unless $self->{_started};\r"
NSQ_SOURCE_LINE 00000449 "\r"
NSQ_SOURCE_LINE 00000450 "    my $dtd = {\r"
NSQ_SOURCE_LINE 00000451 "                Name        => $name,\r"
NSQ_SOURCE_LINE 00000452 "                SystemId    => $sys,\r"
NSQ_SOURCE_LINE 00000453 "                PublicId    => $pub,\r"
NSQ_SOURCE_LINE 00000454 "              };\r"
NSQ_SOURCE_LINE 00000455 "    $self->SUPER::start_dtd($dtd);\r"
NSQ_SOURCE_LINE 00000456 "}\r"
NSQ_SOURCE_LINE 00000457 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000458 "\r"
NSQ_SOURCE_LINE 00000459 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000460 "# _handle_end_doctype\r"
NSQ_SOURCE_LINE 00000461 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000462 "sub _handle_end_doctype {\r"
NSQ_SOURCE_LINE 00000463 "    $_[0]->{__XSE}->SUPER::end_dtd( {} );\r"
NSQ_SOURCE_LINE 00000464 "}\r"
NSQ_SOURCE_LINE 00000465 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000466 "\r"
NSQ_SOURCE_LINE 00000467 "\r"
NSQ_SOURCE_LINE 00000468 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000469 "# _handle_start_document\r"
NSQ_SOURCE_LINE 00000470 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000471 "sub _handle_start_document {\r"
NSQ_SOURCE_LINE 00000472 "    $_[0]->SUPER::start_document($_[1]);\r"
NSQ_SOURCE_LINE 00000473 "    $_[0]->{_started} = 1;\r"
NSQ_SOURCE_LINE 00000474 "}\r"
NSQ_SOURCE_LINE 00000475 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000476 "\r"
NSQ_SOURCE_LINE 00000477 "\r"
NSQ_SOURCE_LINE 00000478 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000479 "# supported_features\r"
NSQ_SOURCE_LINE 00000480 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000481 "sub supported_features {\r"
NSQ_SOURCE_LINE 00000482 "    return (\r"
NSQ_SOURCE_LINE 00000483 "             $_[0]->SUPER::supported_features,\r"
NSQ_SOURCE_LINE 00000484 "             'http://xml.org/sax/features/external-general-entities',\r"
NSQ_SOURCE_LINE 00000485 "             'http://xml.org/sax/features/external-parameter-entities',\r"
NSQ_SOURCE_LINE 00000486 "           );\r"
NSQ_SOURCE_LINE 00000487 "}\r"
NSQ_SOURCE_LINE 00000488 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000489 "\r"
NSQ_SOURCE_LINE 00000490 "\r"
NSQ_SOURCE_LINE 00000491 "\r"
NSQ_SOURCE_LINE 00000492 "\r"
NSQ_SOURCE_LINE 00000493 "\r"
NSQ_SOURCE_LINE 00000494 "#,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,#\r"
NSQ_SOURCE_LINE 00000495 "#`,`, Private Helpers `,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,#\r"
NSQ_SOURCE_LINE 00000496 "#```````````````````````````````````````````````````````````````````#\r"
NSQ_SOURCE_LINE 00000497 "\r"
NSQ_SOURCE_LINE 00000498 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000499 "# _create_node\r"
NSQ_SOURCE_LINE 00000500 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000501 "#sub _create_node {\r"
NSQ_SOURCE_LINE 00000502 "#    shift;\r"
NSQ_SOURCE_LINE 00000503 "#    # this may check for a factory later\r"
NSQ_SOURCE_LINE 00000504 "#    return {@_};\r"
NSQ_SOURCE_LINE 00000505 "#}\r"
NSQ_SOURCE_LINE 00000506 "#-------------------------------------------------------------------#\r"
NSQ_SOURCE_LINE 00000507 "\r"
NSQ_SOURCE_LINE 00000508 "\r"
NSQ_SOURCE_LINE 00000509 "1;\r"
NSQ_SOURCE_LINE 00000510 "#,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,#\r"
NSQ_SOURCE_LINE 00000511 "#`,`, Documentation `,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,`,#\r"
NSQ_SOURCE_LINE 00000512 "#```````````````````````````````````````````````````````````````````#\r"
NSQ_SOURCE_LINE 00000513 "\r"
NSQ_SOURCE_LINE 00000514 "=pod\r"
NSQ_SOURCE_LINE 00000515 "\r"
NSQ_SOURCE_LINE 00000516 "=head1 NAME\r"
NSQ_SOURCE_LINE 00000517 "\r"
NSQ_SOURCE_LINE 00000518 "XML::SAX::Expat - SAX2 Driver for Expat (XML::Parser)\r"
NSQ_SOURCE_LINE 00000519 "\r"
NSQ_SOURCE_LINE 00000520 "=head1 SYNOPSIS\r"
NSQ_SOURCE_LINE 00000521 "\r"
NSQ_SOURCE_LINE 00000522 "  use XML::SAX::Expat;\r"
NSQ_SOURCE_LINE 00000523 "  use XML::SAX::MyFooHandler;\r"
NSQ_SOURCE_LINE 00000524 "  my $h = XML::SAX::MyFooHandler->new;\r"
NSQ_SOURCE_LINE 00000525 "  my $p = XML::SAX::Expat->new(Handler => $h);\r"
NSQ_SOURCE_LINE 00000526 "  $p->parse_file('/path/to/foo.xml');\r"
NSQ_SOURCE_LINE 00000527 "\r"
NSQ_SOURCE_LINE 00000528 "=head1 DESCRIPTION\r"
NSQ_SOURCE_LINE 00000529 "\r"
NSQ_SOURCE_LINE 00000530 "This is an implementation of a SAX2 driver sitting on top of Expat\r"
NSQ_SOURCE_LINE 00000531 "(XML::Parser) which Ken MacLeod posted to perl-xml and which I have\r"
NSQ_SOURCE_LINE 00000532 "updated.\r"
NSQ_SOURCE_LINE 00000533 "\r"
NSQ_SOURCE_LINE 00000534 "It is still incomplete, though most of the basic SAX2 events should be\r"
NSQ_SOURCE_LINE 00000535 "available. The SAX2 spec is currently available from L<http://perl-xml.sourceforge.net/perl-sax/>.\r"
NSQ_SOURCE_LINE 00000536 "\r"
NSQ_SOURCE_LINE 00000537 "A more friendly URL as well as a PODification of the spec are in the\r"
NSQ_SOURCE_LINE 00000538 "works.\r"
NSQ_SOURCE_LINE 00000539 "\r"
NSQ_SOURCE_LINE 00000540 "=head1 METHODS\r"
NSQ_SOURCE_LINE 00000541 "\r"
NSQ_SOURCE_LINE 00000542 "The methods defined in this class correspond to those listed in the\r"
NSQ_SOURCE_LINE 00000543 "PerlSAX2 specification, available above.\r"
NSQ_SOURCE_LINE 00000544 "\r"
NSQ_SOURCE_LINE 00000545 "=head1 FEATURES AND CAVEATS\r"
NSQ_SOURCE_LINE 00000546 "\r"
NSQ_SOURCE_LINE 00000547 "=over 2\r"
NSQ_SOURCE_LINE 00000548 "\r"
NSQ_SOURCE_LINE 00000549 "=item supported_features\r"
NSQ_SOURCE_LINE 00000550 "\r"
NSQ_SOURCE_LINE 00000551 "Returns:\r"
NSQ_SOURCE_LINE 00000552 "\r"
NSQ_SOURCE_LINE 00000553 "  * http://xml.org/sax/features/external-general-entities\r"
NSQ_SOURCE_LINE 00000554 "  * http://xml.org/sax/features/external-parameter-entities\r"
NSQ_SOURCE_LINE 00000555 "  * [ Features supported by ancestors ]\r"
NSQ_SOURCE_LINE 00000556 "\r"
NSQ_SOURCE_LINE 00000557 "Turning one of the first two on also turns the other on (this maps\r"
NSQ_SOURCE_LINE 00000558 "to the XML::Parser ParseParamEnts option). This may be fixed in the\r"
NSQ_SOURCE_LINE 00000559 "future, so don't rely on this behaviour.\r"
NSQ_SOURCE_LINE 00000560 "\r"
NSQ_SOURCE_LINE 00000561 "=back\r"
NSQ_SOURCE_LINE 00000562 "\r"
NSQ_SOURCE_LINE 00000563 "=head1 MISSING PARTS\r"
NSQ_SOURCE_LINE 00000564 "\r"
NSQ_SOURCE_LINE 00000565 "XML::Parser has no listed callbacks for the following events, which\r"
NSQ_SOURCE_LINE 00000566 "are therefore not presently generated (ways may be found in the\r"
NSQ_SOURCE_LINE 00000567 "future):\r"
NSQ_SOURCE_LINE 00000568 "\r"
NSQ_SOURCE_LINE 00000569 "  * ignorable_whitespace\r"
NSQ_SOURCE_LINE 00000570 "  * skipped_entity\r"
NSQ_SOURCE_LINE 00000571 "  * start_entity / end_entity\r"
NSQ_SOURCE_LINE 00000572 "  * resolve_entity\r"
NSQ_SOURCE_LINE 00000573 "\r"
NSQ_SOURCE_LINE 00000574 "Ways of signalling them are welcome. In addition to those,\r"
NSQ_SOURCE_LINE 00000575 "set_document_locator is not yet called.\r"
NSQ_SOURCE_LINE 00000576 "\r"
NSQ_SOURCE_LINE 00000577 "=head1 TODO\r"
NSQ_SOURCE_LINE 00000578 "\r"
NSQ_SOURCE_LINE 00000579 "  - reuse Ken's tests and add more\r"
NSQ_SOURCE_LINE 00000580 "\r"
NSQ_SOURCE_LINE 00000581 "=head1 AUTHOR\r"
NSQ_SOURCE_LINE 00000582 "\r"
NSQ_SOURCE_LINE 00000583 "Robin Berjon; stolen from Ken Macleod, ken@bitsko.slc.ut.us, and with\r"
NSQ_SOURCE_LINE 00000584 "suggestions and feedback from perl-xml. Currently maintained by Bjoern\r"
NSQ_SOURCE_LINE 00000585 "Hoehrmann, L<http://bjoern.hoehrmann.de/>.\r"
NSQ_SOURCE_LINE 00000586 "\r"
NSQ_SOURCE_LINE 00000587 "=head1 COPYRIGHT AND LICENSE\r"
NSQ_SOURCE_LINE 00000588 "\r"
