NSQ_SOURCE_LINE 00000590 "free software; you can redistribute it and/or modify it under the same\r"
NSQ_SOURCE_LINE 00000591 "terms as Perl itself.\r"
NSQ_SOURCE_LINE 00000592 "\r"
NSQ_SOURCE_LINE 00000593 "=head1 SEE ALSO\r"
NSQ_SOURCE_LINE 00000594 "\r"
NSQ_SOURCE_LINE 00000595 "XML::Parser::PerlSAX\r"
NSQ_SOURCE_LINE 00000596 "\r"
NSQ_SOURCE_LINE 00000597 "=cut\r"
BODY_END
