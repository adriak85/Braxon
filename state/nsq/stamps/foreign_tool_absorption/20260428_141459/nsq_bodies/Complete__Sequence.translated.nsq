NSQ_SOURCE_LINE 00000001 "package Complete::Sequence;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2019-12-17'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Complete-Sequence'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.002'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 "use Log::ger;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Complete::Common qw(:all);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000017 "                       complete_sequence"
NSQ_SOURCE_LINE 00000018 "               );"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "our %SPEC;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "our $COMPLETE_SEQUENCE_TRACE = $ENV{COMPLETE_SEQUENCE_TRACE} // 0;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "sub _get_strings_from_item {"
NSQ_SOURCE_LINE 00000025 "    my ($item, $stash) = @_;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    my @array;"
NSQ_SOURCE_LINE 00000028 "    my $ref = ref $item;"
NSQ_SOURCE_LINE 00000029 "    if (!$ref) {"
NSQ_SOURCE_LINE 00000030 "        push @array, $item;"
NSQ_SOURCE_LINE 00000031 "    } elsif ($ref eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000032 "        push @array, @$item;"
NSQ_SOURCE_LINE 00000033 "    } elsif ($ref eq 'CODE') {"
NSQ_SOURCE_LINE 00000034 "        push @array, _get_strings_from_item($item->($stash), $stash);"
NSQ_SOURCE_LINE 00000035 "    } elsif ($ref eq 'HASH') {"
NSQ_SOURCE_LINE 00000036 "        if (defined $item->{alternative}) {"
NSQ_SOURCE_LINE 00000037 "            push @array, map { _get_strings_from_item($_, $stash) }"
NSQ_SOURCE_LINE 00000038 "                @{ $item->{alternative} };"
NSQ_SOURCE_LINE 00000039 "        } elsif (defined $item->{sequence} && @{ $item->{sequence} }) {"
NSQ_SOURCE_LINE 00000040 "            my @set = map { [_get_strings_from_item($_, $stash)] }"
NSQ_SOURCE_LINE 00000041 "                @{ $item->{sequence} };"
NSQ_SOURCE_LINE 00000042 "            #use DD; dd \\@set;"
NSQ_SOURCE_LINE 00000043 "            # sigh, this module is quite fussy. it won't accept"
NSQ_SOURCE_LINE 00000044 "            if (@set > 1) {"
NSQ_SOURCE_LINE 00000045 "                require Set::CrossProduct;"
NSQ_SOURCE_LINE 00000046 "                my $scp = Set::CrossProduct->new(\\@set);"
NSQ_SOURCE_LINE 00000047 "                while (my $tuple = $scp->get) {"
NSQ_SOURCE_LINE 00000048 "                    push @array, join(\"\", @$tuple);"
NSQ_SOURCE_LINE 00000049 "                }"
NSQ_SOURCE_LINE 00000050 "            } elsif (@set == 1) {"
NSQ_SOURCE_LINE 00000051 "                push @array, @{ $set[0] };"
NSQ_SOURCE_LINE 00000052 "            }"
NSQ_SOURCE_LINE 00000053 "        } else {"
NSQ_SOURCE_LINE 00000054 "            die \"Need alternative or sequence\";"
NSQ_SOURCE_LINE 00000055 "        }"
NSQ_SOURCE_LINE 00000056 "    } else {"
NSQ_SOURCE_LINE 00000057 "        die \"Invalid item: $item\";"
NSQ_SOURCE_LINE 00000058 "    }"
NSQ_SOURCE_LINE 00000059 "    @array;"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "$SPEC{complete_sequence} = {"
NSQ_SOURCE_LINE 00000063 "    v => 1.1,"
NSQ_SOURCE_LINE 00000064 "    summary => 'Complete string from a sequence of choices',"
NSQ_SOURCE_LINE 00000065 "    description => <<'_',"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "Sometime you want to complete a string where its parts (sequence items) are"
NSQ_SOURCE_LINE 00000068 "formed from various pieces. For example, suppose your program \"delete-user-data\""
NSQ_SOURCE_LINE 00000069 "accepts an argument that is in the form of:"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "    USERNAME"
NSQ_SOURCE_LINE 00000072 "    UID \"(\" \"current\" \")\""
NSQ_SOURCE_LINE 00000073 "    UID \"(\" \"historical\" \")\""
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    \"EVERYONE\""
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "Supposed existing users include `budi`, `ujang`, and `wati` with UID 101, 102,"
NSQ_SOURCE_LINE 00000078 "103."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "This can be written as:"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    ["
NSQ_SOURCE_LINE 00000083 "        {"
NSQ_SOURCE_LINE 00000084 "            alternative => ["
NSQ_SOURCE_LINE 00000085 "                [qw/budi ujang wati/],"
NSQ_SOURCE_LINE 00000086 "                {sequence => ["
NSQ_SOURCE_LINE 00000087 "                    [qw/101 102 103/],"
NSQ_SOURCE_LINE 00000088 "                    [\"(current)\", \"(historical)\"],"
NSQ_SOURCE_LINE 00000089 "                ]},"
NSQ_SOURCE_LINE 00000090 "                \"EVERYONE\","
NSQ_SOURCE_LINE 00000091 "            ],"
NSQ_SOURCE_LINE 00000092 "        }"
NSQ_SOURCE_LINE 00000093 "    ]"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "When word is empty (`''`), the offered completion is:"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    budi"
NSQ_SOURCE_LINE 00000098 "    ujang"
NSQ_SOURCE_LINE 00000099 "    wati"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    101"
NSQ_SOURCE_LINE 00000102 "    102"
NSQ_SOURCE_LINE 00000103 "    103"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    EVERYONE"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "When word is `101`, the offered completion is:"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    101"
NSQ_SOURCE_LINE 00000110 "    101(current)"
NSQ_SOURCE_LINE 00000111 "    101(historical)"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "When word is `101(h`, the offered completion is:"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    101(historical)"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "_"
NSQ_SOURCE_LINE 00000118 "    args => {"
NSQ_SOURCE_LINE 00000119 "        %arg_word,"
NSQ_SOURCE_LINE 00000120 "        sequence => {"
NSQ_SOURCE_LINE 00000121 "            schema => 'array*',"
NSQ_SOURCE_LINE 00000122 "            req => 1,"
NSQ_SOURCE_LINE 00000123 "            description => <<'_',"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "A sequence structure is an array of items. An item can be:"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "* a scalar/string (a single string to choose from)"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "* an array of strings (multiple strings to choose from)"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "* a coderef (will be called to extract an item)"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "  Coderef will be called with `$stash` argument which contains various"
NSQ_SOURCE_LINE 00000134 "  information, e.g. the index of the sequence item (`item_index`), the completed"
NSQ_SOURCE_LINE 00000135 "  parts (`completed_item_words`), the current word (`cur_word`), etc."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "* a hash (another sequence or alternative of items)"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "If you want to specify another sub-sequence of items:"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    {sequence => [ ... ]}   # put items in here"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "If you want to specify an alternative of sub-sequences or sub-alternative:"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    {alternative => [ ... ]}    # put items in here"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "_"
NSQ_SOURCE_LINE 00000148 "        },"
NSQ_SOURCE_LINE 00000149 "    },"
NSQ_SOURCE_LINE 00000150 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000151 "    result => {"
NSQ_SOURCE_LINE 00000152 "        schema => 'array',"
NSQ_SOURCE_LINE 00000153 "    },"
NSQ_SOURCE_LINE 00000154 "};"
NSQ_SOURCE_LINE 00000155 "sub complete_sequence {"
NSQ_SOURCE_LINE 00000156 "    require Complete::Util;"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    my %args = @_;"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "    my $word = $args{word} // \"\";"
NSQ_SOURCE_LINE 00000161 "    my $sequence = $args{sequence};"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    my $orig_word = $word;"
NSQ_SOURCE_LINE 00000164 "    my @prefixes_from_completed_items;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "    my $stash = {"
NSQ_SOURCE_LINE 00000167 "        completed_item_words => \\@prefixes_from_completed_items,"
NSQ_SOURCE_LINE 00000168 "        cur_word => $word,"
NSQ_SOURCE_LINE 00000169 "        orig_word => $orig_word,"
NSQ_SOURCE_LINE 00000170 "    };"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    my $itemidx = -1;"
NSQ_SOURCE_LINE 00000173 "    for my $item (@$sequence) {"
NSQ_SOURCE_LINE 00000174 "        $itemidx++; $stash->{item_index} = $itemidx;"
NSQ_SOURCE_LINE 00000175 "        log_trace(\"[compseq] Looking at sequence item[$itemidx] : %s\", $item) if $COMPLETE_SEQUENCE_TRACE;"
NSQ_SOURCE_LINE 00000176 "        my @array = _get_strings_from_item($item, $stash);"
NSQ_SOURCE_LINE 00000177 "        log_trace(\"[compseq] Result from sequence item[$itemidx]: %s\", \\@array) if $COMPLETE_SEQUENCE_TRACE;"
NSQ_SOURCE_LINE 00000178 "        my $res = Complete::Util::complete_array_elem("
NSQ_SOURCE_LINE 00000179 "            word => $word,"
NSQ_SOURCE_LINE 00000180 "            array => \\@array,"
NSQ_SOURCE_LINE 00000181 "        );"
NSQ_SOURCE_LINE 00000182 "        if ($res && @$res == 1) {"
NSQ_SOURCE_LINE 00000183 "            # the word can be completed directly (unambiguously) with this item."
NSQ_SOURCE_LINE 00000184 "            # move on to get more words from the next item."
NSQ_SOURCE_LINE 00000185 "            log_trace(\"[compseq] Word ($word) can be completed unambiguously with this sequence item[$itemidx], moving on to the next sequence item\") if $COMPLETE_SEQUENCE_TRACE;"
NSQ_SOURCE_LINE 00000186 "            substr($word, 0, length $res->[0]) = \"\";"
NSQ_SOURCE_LINE 00000187 "            $stash->{cur_word} = $word;"
NSQ_SOURCE_LINE 00000188 "            push @prefixes_from_completed_items, $res->[0];"
NSQ_SOURCE_LINE 00000189 "            next;"
NSQ_SOURCE_LINE 00000190 "        } elsif ($res && @$res > 1) {"
NSQ_SOURCE_LINE 00000191 "            # the word can be completed with several choices from this item."
NSQ_SOURCE_LINE 00000192 "            # present the choices as the final answer."
NSQ_SOURCE_LINE 00000193 "            my $compres = [map { join(\"\", @prefixes_from_completed_items, $_) } @$res];"
NSQ_SOURCE_LINE 00000194 "            log_trace(\"[compseq] Word ($word) can be completed with several choices from this sequence item[$itemidx], returning final result: %s\", $compres) if $COMPLETE_SEQUENCE_TRACE;"
NSQ_SOURCE_LINE 00000195 "            return $compres;"
NSQ_SOURCE_LINE 00000196 "        } else {"
NSQ_SOURCE_LINE 00000197 "            # the word cannot be completed with this item. it can be that the"
NSQ_SOURCE_LINE 00000198 "            # word already contains this item and the next."
NSQ_SOURCE_LINE 00000199 "            my $num_matches = 0;"
NSQ_SOURCE_LINE 00000200 "            my $matching_str;"
NSQ_SOURCE_LINE 00000201 "            for my $str (@array) {"
NSQ_SOURCE_LINE 00000202 "                # XXX perhaps we want to be case-insensitive?"
NSQ_SOURCE_LINE 00000203 "                if (index($word, $str) == 0) {"
NSQ_SOURCE_LINE 00000204 "                    $num_matches++;"
NSQ_SOURCE_LINE 00000205 "                    $matching_str = $str;"
NSQ_SOURCE_LINE 00000206 "                }"
NSQ_SOURCE_LINE 00000207 "            }"
NSQ_SOURCE_LINE 00000208 "            if ($num_matches == 1) {"
NSQ_SOURCE_LINE 00000209 "                substr($word, 0, length($matching_str)) = \"\";"
NSQ_SOURCE_LINE 00000210 "                $stash->{cur_word} = $word;"
NSQ_SOURCE_LINE 00000211 "                push @prefixes_from_completed_items, $matching_str;"
NSQ_SOURCE_LINE 00000212 "                log_trace(\"[compseq] Word ($word) cannot be completed by this sequence item[$itemidx] because part of the word matches previous sequence item(s); completed_parts=%s, word=%s\", \\@prefixes_from_completed_items, $word) if $COMPLETE_SEQUENCE_TRACE;"
NSQ_SOURCE_LINE 00000213 "                next;"
NSQ_SOURCE_LINE 00000214 "            }"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "            # nope, this word simply doesn't match"
NSQ_SOURCE_LINE 00000217 "            log_trace(\"[compseq] Word ($word) cannot be completed by this sequence item[$itemidx], giving up the rest of the sequence items\") if $COMPLETE_SEQUENCE_TRACE;"
NSQ_SOURCE_LINE 00000218 "            goto RETURN;"
NSQ_SOURCE_LINE 00000219 "        }"
NSQ_SOURCE_LINE 00000220 "    }"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "  RETURN:"
NSQ_SOURCE_LINE 00000223 "    my $compres;"
NSQ_SOURCE_LINE 00000224 "    if (@prefixes_from_completed_items) {"
NSQ_SOURCE_LINE 00000225 "        $compres = [join(\"\", @prefixes_from_completed_items)];"
NSQ_SOURCE_LINE 00000226 "    } else {"
NSQ_SOURCE_LINE 00000227 "        $compres = [];"
NSQ_SOURCE_LINE 00000228 "    }"
NSQ_SOURCE_LINE 00000229 "    log_trace(\"[compseq] Returning final result: %s\", $compres) if $COMPLETE_SEQUENCE_TRACE;"
NSQ_SOURCE_LINE 00000230 "    $compres;"
NSQ_SOURCE_LINE 00000231 "}"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "1;"
NSQ_SOURCE_LINE 00000234 "# ABSTRACT: Complete string from a sequence of choices"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "__END__"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=pod"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head1 NAME"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Complete::Sequence - Complete string from a sequence of choices"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head1 VERSION"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "This document describes version 0.002 of Complete::Sequence (from Perl distribution Complete-Sequence), released on 2019-12-17."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=head2 complete_sequence"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "Usage:"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 " complete_sequence(%args) -> array"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "Complete string from a sequence of choices."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "Sometime you want to complete a string where its parts (sequence items) are"
NSQ_SOURCE_LINE 00000262 "formed from various pieces. For example, suppose your program \"delete-user-data\""
NSQ_SOURCE_LINE 00000263 "accepts an argument that is in the form of:"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 " USERNAME"
NSQ_SOURCE_LINE 00000266 " UID \"(\" \"current\" \")\""
NSQ_SOURCE_LINE 00000267 " UID \"(\" \"historical\" \")\""
NSQ_SOURCE_LINE 00000268 " "
NSQ_SOURCE_LINE 00000269 " \"EVERYONE\""
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Supposed existing users include C<budi>, C<ujang>, and C<wati> with UID 101, 102,"
NSQ_SOURCE_LINE 00000272 "103."
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "This can be written as:"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 " ["
NSQ_SOURCE_LINE 00000277 "     {"
NSQ_SOURCE_LINE 00000278 "         alternative => ["
NSQ_SOURCE_LINE 00000279 "             [qw/budi ujang wati/],"
NSQ_SOURCE_LINE 00000280 "             {sequence => ["
NSQ_SOURCE_LINE 00000281 "                 [qw/101 102 103/],"
NSQ_SOURCE_LINE 00000282 "                 [\"(current)\", \"(historical)\"],"
NSQ_SOURCE_LINE 00000283 "             ]},"
NSQ_SOURCE_LINE 00000284 "             \"EVERYONE\","
NSQ_SOURCE_LINE 00000285 "         ],"
NSQ_SOURCE_LINE 00000286 "     }"
NSQ_SOURCE_LINE 00000287 " ]"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "When word is empty (C<''>), the offered completion is:"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 " budi"
NSQ_SOURCE_LINE 00000292 " ujang"
NSQ_SOURCE_LINE 00000293 " wati"
NSQ_SOURCE_LINE 00000294 " "
NSQ_SOURCE_LINE 00000295 " 101"
NSQ_SOURCE_LINE 00000296 " 102"
NSQ_SOURCE_LINE 00000297 " 103"
NSQ_SOURCE_LINE 00000298 " "
NSQ_SOURCE_LINE 00000299 " EVERYONE"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "When word is C<101>, the offered completion is:"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 " 101"
NSQ_SOURCE_LINE 00000304 " 101(current)"
NSQ_SOURCE_LINE 00000305 " 101(historical)"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "When word is C<101(h>, the offered completion is:"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 " 101(historical)"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "=over 4"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=item * B<sequence>* => I<array>"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "A sequence structure is an array of items. An item can be:"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "=over"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=item * a scalar/string (a single string to choose from)"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "=item * an array of strings (multiple strings to choose from)"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "=item * a coderef (will be called to extract an item)"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "Coderef will be called with C<$stash> argument which contains various"
NSQ_SOURCE_LINE 00000330 "information, e.g. the index of the sequence item (C<item_index>), the completed"
NSQ_SOURCE_LINE 00000331 "parts (C<completed_item_words>), the current word (C<cur_word>), etc."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "=item * a hash (another sequence or alternative of items)"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "=back"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "If you want to specify another sub-sequence of items:"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 " {sequence => [ ... ]}   # put items in here"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "If you want to specify an alternative of sub-sequences or sub-alternative:"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 " {alternative => [ ... ]}    # put items in here"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=item * B<word>* => I<str> (default: \"\")"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "Word to complete."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "=back"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "Return value:  (array)"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "=head2 COMPLETE_SEQUENCE_TRACE"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "Bool. If set to true, will display more log statements for debugging."
NSQ_SOURCE_LINE 00000358 ""
