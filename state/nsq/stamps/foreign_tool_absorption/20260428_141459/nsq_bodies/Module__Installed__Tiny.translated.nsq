BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Module::Installed::Tiny;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000009 "our $DATE = '2022-08-22'; # DATE"
NSQ_SOURCE_LINE 00000010 "our $DIST = 'Module-Installed-Tiny'; # DIST"
NSQ_SOURCE_LINE 00000011 "our $VERSION = '0.011'; # VERSION"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw(module_installed module_source);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our $SEPARATOR;"
NSQ_SOURCE_LINE 00000016 "BEGIN {"
NSQ_SOURCE_LINE 00000017 "    if ($^O =~ /^(dos|os2)/i) {"
NSQ_SOURCE_LINE 00000018 "        $SEPARATOR = '\\\\';"
NSQ_SOURCE_LINE 00000019 "    } elsif ($^O =~ /^MacOS/i) {"
NSQ_SOURCE_LINE 00000020 "        $SEPARATOR = ':';"
NSQ_SOURCE_LINE 00000021 "    } else {"
NSQ_SOURCE_LINE 00000022 "        $SEPARATOR = '/';"
NSQ_SOURCE_LINE 00000023 "    }"
NSQ_SOURCE_LINE 00000024 "}"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "sub _parse_name {"
NSQ_SOURCE_LINE 00000027 "    my $name = shift;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    my ($name_mod, $name_pm, $name_path);"
NSQ_SOURCE_LINE 00000030 "    # name_mod is Foo::Bar form, name_pm is Foo/Bar.pm form, name_path is"
NSQ_SOURCE_LINE 00000031 "    # Foo/Bar.pm or Foo\\Bar.pm (uses native path separator), name_path_prefix is"
NSQ_SOURCE_LINE 00000032 "    # Foo/Bar."
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    if ($name =~ m!/|\\.pm\\z!) {"
NSQ_SOURCE_LINE 00000035 "        # assume it's name_pm form"
NSQ_SOURCE_LINE 00000036 "        $name_pm = $name;"
NSQ_SOURCE_LINE 00000037 "        $name_mod = $name;    $name_mod =~ s/\\.pm\\z//; $name_mod =~ s!/!::!g;"
NSQ_SOURCE_LINE 00000038 "        $name_path = $name_pm; $name_path =~ s!/!$SEPARATOR!g if $SEPARATOR ne '/';"
NSQ_SOURCE_LINE 00000039 "    } elsif ($SEPARATOR ne '/' && $name =~ m!\\Q$SEPARATOR!) {"
NSQ_SOURCE_LINE 00000040 "        # assume it's name_path form"
NSQ_SOURCE_LINE 00000041 "        $name_path = $name;"
NSQ_SOURCE_LINE 00000042 "        ($name_pm = $name_path) =~ s!\\Q$SEPARATOR!/!g;"
NSQ_SOURCE_LINE 00000043 "        $name_mod = $name_pm; $name_mod =~ s/\\.pm\\z//; $name_mod =~ s!/!::!g;"
NSQ_SOURCE_LINE 00000044 "    } else {"
NSQ_SOURCE_LINE 00000045 "        # assume it's name_mod form"
NSQ_SOURCE_LINE 00000046 "        $name_mod = $name;"
NSQ_SOURCE_LINE 00000047 "        ($name_pm  = \"$name_mod.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000048 "        $name_path = $name_pm; $name_path =~ s!/!$SEPARATOR!g if $SEPARATOR ne '/';"
NSQ_SOURCE_LINE 00000049 "    }"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    ($name_mod, $name_pm, $name_path);"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub module_source {"
NSQ_SOURCE_LINE 00000055 "    my ($name, $opts) = @_;"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    $opts //= {};"
NSQ_SOURCE_LINE 00000058 "    $opts->{die} = 1 unless defined $opts->{die};"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    my ($name_mod, $name_pm, $name_path) = _parse_name($name);"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    my $index = -1;"
NSQ_SOURCE_LINE 00000063 "    my @res;"
NSQ_SOURCE_LINE 00000064 "  ENTRY:"
NSQ_SOURCE_LINE 00000065 "    for my $entry (@INC) {"
NSQ_SOURCE_LINE 00000066 "        $index++;"
NSQ_SOURCE_LINE 00000067 "        next unless defined $entry;"
NSQ_SOURCE_LINE 00000068 "        my $ref = ref($entry);"
NSQ_SOURCE_LINE 00000069 "        my ($is_hook, @hook_res);"
NSQ_SOURCE_LINE 00000070 "        if ($ref eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000071 "            $is_hook++;"
NSQ_SOURCE_LINE 00000072 "            eval { @hook_res = $entry->[0]->($entry, $name_pm) };"
NSQ_SOURCE_LINE 00000073 "            if ($@) { if ($opts->{die}) { die \"Can't locate $name_pm in \\@INC (you may need to install the $name_mod module): $entry: $@ (\\@INC contains \".join(\" \", @INC).\")\" } else { return } }"
NSQ_SOURCE_LINE 00000074 "        } elsif (UNIVERSAL::can($entry, 'INC')) {"
NSQ_SOURCE_LINE 00000075 "            $is_hook++;"
NSQ_SOURCE_LINE 00000076 "            eval { @hook_res = $entry->INC($name_pm) };"
NSQ_SOURCE_LINE 00000077 "            if ($@) { if ($opts->{die}) { die \"Can't locate $name_pm in \\@INC (you may need to install the $name_mod module): $entry: $@ (\\@INC contains \".join(\" \", @INC).\")\" } else { return } }"
NSQ_SOURCE_LINE 00000078 "        } elsif ($ref eq 'CODE') {"
NSQ_SOURCE_LINE 00000079 "            $is_hook++;"
NSQ_SOURCE_LINE 00000080 "            eval { @hook_res = $entry->($entry, $name_pm) };"
NSQ_SOURCE_LINE 00000081 "            if ($@) { if ($opts->{die}) { die \"Can't locate $name_pm in \\@INC (you may need to install the $name_mod module): $entry: $@ (\\@INC contains \".join(\" \", @INC).\")\" } else { return } }"
NSQ_SOURCE_LINE 00000082 "        } else {"
NSQ_SOURCE_LINE 00000083 "            my $path = \"$entry$SEPARATOR$name_path\";"
NSQ_SOURCE_LINE 00000084 "            if (-f $path) {"
NSQ_SOURCE_LINE 00000085 "                my $fh;"
NSQ_SOURCE_LINE 00000086 "                unless (open $fh, \"<\", $path) {"
NSQ_SOURCE_LINE 00000087 "                    if ($opts->{die}) { die \"Can't locate $name_pm in \\@INC (you may need to install the $name_mod module): $entry: $path: $! (\\@INC contains \".join(\" \", @INC).\")\" } else { return }"
NSQ_SOURCE_LINE 00000088 "                }"
NSQ_SOURCE_LINE 00000089 "                local $/;"
NSQ_SOURCE_LINE 00000090 "                my $res = wantarray ? [scalar <$fh>, $path, $entry, $index, $name_mod, $name_pm, $name_path] : scalar <$fh>;"
NSQ_SOURCE_LINE 00000091 "                if ($opts->{all}) { push @res, $res } else { return wantarray ? @$res : $res }"
NSQ_SOURCE_LINE 00000092 "            } elsif ($opts->{find_prefix}) {"
NSQ_SOURCE_LINE 00000093 "                $path =~ s/\\.pm\\z//;"
NSQ_SOURCE_LINE 00000094 "                if (-d $path) {"
NSQ_SOURCE_LINE 00000095 "                    my $res = wantarray ? [undef, $path, $entry, $index, $name_mod, $name_pm, $name_path] : \\$path;"
NSQ_SOURCE_LINE 00000096 "                    if ($opts->{all}) { push @res, $res } else { return wantarray ? @$res : $res }"
NSQ_SOURCE_LINE 00000097 "                }"
NSQ_SOURCE_LINE 00000098 "            }"
NSQ_SOURCE_LINE 00000099 "        }"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "        if ($is_hook) {"
NSQ_SOURCE_LINE 00000102 "            next unless @hook_res;"
NSQ_SOURCE_LINE 00000103 "            my ($src, $fh, $code);"
NSQ_SOURCE_LINE 00000104 "            eval {"
NSQ_SOURCE_LINE 00000105 "                my $prepend_ref; $prepend_ref = shift @hook_res if ref($hook_res[0]) eq 'SCALAR';"
NSQ_SOURCE_LINE 00000106 "                $fh                           = shift @hook_res if ref($hook_res[0]) eq 'GLOB';"
NSQ_SOURCE_LINE 00000107 "                $code                         = shift @hook_res if ref($hook_res[0]) eq 'CODE';"
NSQ_SOURCE_LINE 00000108 "                my $code_state ; $code_state  = shift @hook_res if @hook_res;"
NSQ_SOURCE_LINE 00000109 "                if ($fh) {"
NSQ_SOURCE_LINE 00000110 "                    $src = \"\";"
NSQ_SOURCE_LINE 00000111 "                    local $_;"
NSQ_SOURCE_LINE 00000112 "                    while (!eof($fh)) {"
NSQ_SOURCE_LINE 00000113 "                        $_ = <$fh>;"
NSQ_SOURCE_LINE 00000114 "                        if ($code) {"
NSQ_SOURCE_LINE 00000115 "                            $code->($code, $code_state);"
NSQ_SOURCE_LINE 00000116 "                        }"
NSQ_SOURCE_LINE 00000117 "                        $src .= $_;"
NSQ_SOURCE_LINE 00000118 "                    }"
NSQ_SOURCE_LINE 00000119 "                    $src = $$prepend_ref . $src if $prepend_ref;"
NSQ_SOURCE_LINE 00000120 "                } elsif ($code) {"
NSQ_SOURCE_LINE 00000121 "                    $src = \"\";"
NSQ_SOURCE_LINE 00000122 "                    local $_;"
NSQ_SOURCE_LINE 00000123 "                    while ($code->($code, $code_state)) {"
NSQ_SOURCE_LINE 00000124 "                        $src .= $_;"
NSQ_SOURCE_LINE 00000125 "                    }"
NSQ_SOURCE_LINE 00000126 "                    $src = $$prepend_ref . $src if $prepend_ref;"
NSQ_SOURCE_LINE 00000127 "                }"
NSQ_SOURCE_LINE 00000128 "            }; # eval"
NSQ_SOURCE_LINE 00000129 "            if ($@) { if ($opts->{die}) { die \"Can't locate $name_pm in \\@INC (you may need to install the $name_mod module): $entry: \".($fh || $code).\": $@ (\\@INC contains \".join(\" \", @INC).\")\" } else { return } }"
NSQ_SOURCE_LINE 00000130 "            my $res = wantarray ? [$src, undef, $entry, $index, $name_mod, $name_pm, $name_path] : $src;"
NSQ_SOURCE_LINE 00000131 "            if ($opts->{all}) { push @res, $res } else { return wantarray ? @$res : $res }"
NSQ_SOURCE_LINE 00000132 "        } # if $is_hook"
NSQ_SOURCE_LINE 00000133 "    }"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "    if (@res) {"
NSQ_SOURCE_LINE 00000136 "        return wantarray ? @res : \\@res;"
NSQ_SOURCE_LINE 00000137 "    } else {"
NSQ_SOURCE_LINE 00000138 "        if ($opts->{die}) {"
NSQ_SOURCE_LINE 00000139 "            die \"Can't locate $name_pm in \\@INC (you may need to install the $name_mod module) (\\@INC contains \".join(\" \", @INC).\")\";"
NSQ_SOURCE_LINE 00000140 "        } else {"
NSQ_SOURCE_LINE 00000141 "            return;"
NSQ_SOURCE_LINE 00000142 "        }"
NSQ_SOURCE_LINE 00000143 "    }"
NSQ_SOURCE_LINE 00000144 "}"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "sub module_installed {"
NSQ_SOURCE_LINE 00000147 "    my ($name, $opts) = @_;"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    # convert Foo::Bar -> Foo/Bar.pm"
NSQ_SOURCE_LINE 00000150 "    my ($name_mod, $name_pm, $name_path) = _parse_name($name);"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    return 1 if exists $INC{$name_pm};"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    my $res = module_source($name, {%{ $opts || {}}, die=>0});"
NSQ_SOURCE_LINE 00000155 "    defined($res) ? 1:0;"
NSQ_SOURCE_LINE 00000156 "}"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "1;"
NSQ_SOURCE_LINE 00000159 "# ABSTRACT: Check if a module is installed, with as little code as possible"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "__END__"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=pod"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=head1 NAME"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "Module::Installed::Tiny - Check if a module is installed, with as little code as possible"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=head1 VERSION"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "This document describes version 0.011 of Module::Installed::Tiny (from Perl distribution Module-Installed-Tiny), released on 2022-08-22."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 " use Module::Installed::Tiny qw(module_installed module_source);"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 " # check if a module is available"
NSQ_SOURCE_LINE 00000180 " if (module_installed \"Foo::Bar\") {"
NSQ_SOURCE_LINE 00000181 "     # Foo::Bar is available"
NSQ_SOURCE_LINE 00000182 " } elsif (module_installed \"Foo/Baz.pm\") {"
NSQ_SOURCE_LINE 00000183 "     # Foo::Baz is available"
NSQ_SOURCE_LINE 00000184 " }"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 " # get a module's source code, dies on failure"
NSQ_SOURCE_LINE 00000187 " my $src = module_source(\"Foo/Baz.pm\");"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "To check if a module is installed (available), generally the simplest way is to"
NSQ_SOURCE_LINE 00000192 "try to C<require()> it:"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 " if (eval { require Foo::Bar; 1 }) {"
NSQ_SOURCE_LINE 00000195 "     # Foo::Bar is available"
NSQ_SOURCE_LINE 00000196 " }"
NSQ_SOURCE_LINE 00000197 " # or"
NSQ_SOURCE_LINE 00000198 " my $mod_pm = \"Foo/Bar.pm\";"
NSQ_SOURCE_LINE 00000199 " if (eval { require $mod_pm; 1 }) {"
NSQ_SOURCE_LINE 00000200 "     # Foo::Bar is available"
NSQ_SOURCE_LINE 00000201 " }"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "However, this actually loads the module. There are some cases where this is not"
NSQ_SOURCE_LINE 00000204 "desirable: 1) we have to check a lot of modules (actually loading the modules"
NSQ_SOURCE_LINE 00000205 "will take a lot of CPU time and memory; 2) some of the modules conflict with one"
NSQ_SOURCE_LINE 00000206 "another and cannot all be loaded; 3) the module is OS specific and might not"
NSQ_SOURCE_LINE 00000207 "load under another OS; 4) we simply do not want to execute the module, for"
NSQ_SOURCE_LINE 00000208 "security or other reasons."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "C<Module::Installed::Tiny> provides a routine C<module_installed()> which works"
NSQ_SOURCE_LINE 00000211 "like Perl's C<require> but does not actually load the module."
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "This module does not require any other module except L<Exporter>."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=head2 module_source"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "Usage:"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 " module_source($name [ , \\%opts ]) => str | list"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "Return module's source code, without actually loading/executing it. Module"
NSQ_SOURCE_LINE 00000224 "source will be searched in C<@INC> the way Perl's C<require()> finds modules."
NSQ_SOURCE_LINE 00000225 "This include executing require hooks in C<@INC> if there are any."
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "Die on failure (e.g. module named C<$name> not found in C<@INC> or module source"
NSQ_SOURCE_LINE 00000228 "file cannot be read) with the same/similar message as Perl's C<require()>:"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 " Can't locate Foo/Bar.pm (you may need to install the Foo::Bar module) ..."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "Module C<$name> can be in the form of C<Foo::Bar>, C<Foo/Bar.pm> or"
NSQ_SOURCE_LINE 00000233 "C<Foo\\Bar.pm> (on Windows)."
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "In list context, will return a record of information:"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 " #   [0]   [1]    [2]     [3]     [4]        [5]       [6]"
NSQ_SOURCE_LINE 00000238 " my ($src, $path, $entry, $index, $name_mod, $name_pm, $name_path) = module_source($name);"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "where:"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=over"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=item * $src"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "String. The module source code."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=item * $path"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "String. The filesystem path (C<undef> if source comes from a require hook)."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=item * $entry"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "The element in C<@INC> where the source comes from."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=item * $index"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "Integer, the index of entry in C<@INC> where the source comes from, 0 means the"
NSQ_SOURCE_LINE 00000259 "first entry."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=item * $name_mod"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "Module name normalized to C<Foo::Bar> form."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=item * $name_pm"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "Module name normalized to C<Foo/Bar.pm> form."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=item * $name_path"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Module name normalized to C<Foo/Bar.pm> form or C<Foo\\Bar.pm> form depending on"
NSQ_SOURCE_LINE 00000272 "the native path separator character."
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "=back"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "Options:"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=over"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "=item * die"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "Bool. Default true. If set to false, won't die upon failure but instead will"
NSQ_SOURCE_LINE 00000283 "return undef (or empty list in list context)."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "=item * find_prefix"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "Bool. If set to true, when a module (e.g. C<Foo/Bar.pm>) is not found in the"
NSQ_SOURCE_LINE 00000288 "fileysstem but its directory is (C<Foo/Bar/>), then instead of dying or"
NSQ_SOURCE_LINE 00000289 "returning undef/empty list, the function will return:"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 " \\$path"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "in scalar context, or:"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 " (undef, $path, $entry, $index, $name_mod, $name_pm, $name_path)"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "in list context. In scalar context, you can differentiate path from module"
NSQ_SOURCE_LINE 00000298 "source because the path is returned as a scalar reference. So to get the path:"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 " $source_or_pathref = module_source(\"Foo/Bar.pm\", {find_prefix=>1});"
NSQ_SOURCE_LINE 00000301 " if (ref $source_or_pathref eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000302 "     say \"Path is \", $$source_or_pathref;"
NSQ_SOURCE_LINE 00000303 " } else {"
NSQ_SOURCE_LINE 00000304 "     say \"Module source code is $source_or_pathref\";"
NSQ_SOURCE_LINE 00000305 " }"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=item * all"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "Bool. If set to true, then instead of stopping after one source is found, the"
NSQ_SOURCE_LINE 00000310 "function will continue finding sources until all entries in C<@INC> is"
NSQ_SOURCE_LINE 00000311 "exhausted. Then will return all the found sources as an arrayref:"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 " my $sources = module_source($name, {all=>1});"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "In list context, will return a list of records instead of a single record:"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 " my @records = module_source($name, {all=>1});"
NSQ_SOURCE_LINE 00000318 " for my $record (@records) {"
NSQ_SOURCE_LINE 00000319 "     my ($src, $path, $entry, $index, $name_mod, $name_pm, $name_path) = @$record;"
NSQ_SOURCE_LINE 00000320 "     ..."
NSQ_SOURCE_LINE 00000321 " }"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=back"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "=head2 module_installed"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "Usage:"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 " module_installed($name [ , \\%opts ]) => bool"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "Check that module named C<$name> is available to load, without actually"
NSQ_SOURCE_LINE 00000332 "loading/executing the module. Module will be searched in C<@INC> the way Perl's"
NSQ_SOURCE_LINE 00000333 "C<require()> finds modules. This include executing require hooks in C<@INC> if"
NSQ_SOURCE_LINE 00000334 "there are any."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "Note that this does not guarantee that the module can eventually be loaded"
NSQ_SOURCE_LINE 00000337 "successfully, as there might be syntax or runtime errors in the module's source."
NSQ_SOURCE_LINE 00000338 "To check for that, one would need to actually load the module using C<require>."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "Module C<$name> can be in the form of C<Foo::Bar>, C<Foo/Bar.pm> or"
NSQ_SOURCE_LINE 00000341 "F<Foo\\Bar.pm> (on Windows)."
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "Options:"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=over"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=item * find_prefix"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "See L</module_source> documentation."
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=back"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "=head1 FAQ"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "=head2 How to get module source without dying? I want to just get undef if module source is not available."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "Set the C<die> option to false:"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 " my $src = module_source($name, {die=>0});"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "This is what C<module_installed()> does."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=head2 How to know which @INC entry the source comes from?"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "Call the L</module_source> function in list context, where you will get more"
NSQ_SOURCE_LINE 00000366 "information including the entry. See the function documentation for more"
NSQ_SOURCE_LINE 00000367 "details."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "Please visit the project's homepage at L<https://metacpan.org/release/Module-Installed-Tiny>."
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "Source repository is at L<https://github.com/perlancar/perl-Module-Installed-Tiny>."
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "L<Module::Load::Conditional> provides C<check_install> which also does what"
NSQ_SOURCE_LINE 00000380 "C<module_installed> does, plus can check module version. It also has a couple"
NSQ_SOURCE_LINE 00000381 "other knobs to customize its behavior. It's less tiny than"
NSQ_SOURCE_LINE 00000382 "Module::Installed::Tiny though."
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "L<Module::Path> and L<Module::Path::More>. These modules can also be used to"
NSQ_SOURCE_LINE 00000385 "check if a module on the filesystem is available. They do not handle require"
NSQ_SOURCE_LINE 00000386 "hooks, nor do they actually check that the module file is readable."
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "perlancar <perlancar@cpan.org>"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "=head1 CONTRIBUTING"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "To contribute, you can send patches by email/via RT, or send pull requests on"
NSQ_SOURCE_LINE 00000396 "GitHub."
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "Most of the time, you don't need to build the distribution yourself. You can"
NSQ_SOURCE_LINE 00000399 "simply modify the code, then test via:"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 " % prove -l"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "If you want to build the distribution (e.g. to try to install it locally on your"
NSQ_SOURCE_LINE 00000404 "system), you can install L<Dist::Zilla>,"
NSQ_SOURCE_LINE 00000405 "L<Dist::Zilla::PluginBundle::Author::PERLANCAR>,"
NSQ_SOURCE_LINE 00000406 "L<Pod::Weaver::PluginBundle::Author::PERLANCAR>, and sometimes one or two other"
NSQ_SOURCE_LINE 00000407 "Dist::Zilla- and/or Pod::Weaver plugins. Any additional steps required beyond"
NSQ_SOURCE_LINE 00000408 "that are considered a bug and can be reported to me."
NSQ_SOURCE_LINE 00000409 ""
