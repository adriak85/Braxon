NSQ_SOURCE_LINE 00000001 "#    IPv4Addr.pm - Perl module to manipulate IPv4 addresses."
NSQ_SOURCE_LINE 00000002 "#"
NSQ_SOURCE_LINE 00000003 "#    Author: Francis J. Lacoste <francis.lacoste@iNsu.COM>"
NSQ_SOURCE_LINE 00000004 "#"
NSQ_SOURCE_LINE 00000005 "#    Copyright (C) 1999, 2000 iNsu Innovations Inc."
NSQ_SOURCE_LINE 00000006 "#"
