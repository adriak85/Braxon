NSQ_SOURCE_LINE 00000008 "#    it under the terms as perl itself."
NSQ_SOURCE_LINE 00000009 "#"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "package Net::IPv4Addr;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use strict;"
NSQ_SOURCE_LINE 00000014 "use vars qw($VERSION @ISA @EXPORT @EXPORT_OK %EXPORT_TAGS);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "BEGIN {"
NSQ_SOURCE_LINE 00000017 "    require Exporter;"
NSQ_SOURCE_LINE 00000018 "    require AutoLoader;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    @ISA = qw(Exporter AutoLoader);"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    @EXPORT = qw();"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000025 "\t\t    all => [qw{ ipv4_parse\tipv4_chkip"
NSQ_SOURCE_LINE 00000026 "\t\t\t\tipv4_network    ipv4_broadcast"
NSQ_SOURCE_LINE 00000027 "\t\t\t\tipv4_cidr2msk   ipv4_msk2cidr"
NSQ_SOURCE_LINE 00000028 "\t\t\t\tipv4_in_network ipv4_dflt_netmask"
NSQ_SOURCE_LINE 00000029 "\t\t\t\t} ],"
NSQ_SOURCE_LINE 00000030 "\t\t   );"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    @EXPORT_OK = qw();"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    Exporter::export_ok_tags('all');"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    $VERSION = '0.10';"
NSQ_SOURCE_LINE 00000037 "}"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "# Preloaded methods go here."
NSQ_SOURCE_LINE 00000040 "use Carp;"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "# Functions to manipulate IPV4 address"
NSQ_SOURCE_LINE 00000043 "my $ip_rgx = \"\\\\d+\\\\.\\\\d+\\\\.\\\\d+\\\\.\\\\d+\";"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "# Given an IPv4 address in host, ip/netmask or cidr format"
NSQ_SOURCE_LINE 00000046 "# returns a ip / cidr pair."
NSQ_SOURCE_LINE 00000047 "sub ipv4_parse($;$) {"
NSQ_SOURCE_LINE 00000048 "  my ($ip,$msk);"
NSQ_SOURCE_LINE 00000049 "  # Called with 2 args, assume first is IP address"
NSQ_SOURCE_LINE 00000050 "  if ( defined $_[1] ) {"
NSQ_SOURCE_LINE 00000051 "    $ip = $_[0];"
NSQ_SOURCE_LINE 00000052 "    $msk= $_[1];"
NSQ_SOURCE_LINE 00000053 "  } else {"
NSQ_SOURCE_LINE 00000054 "    ($ip)  = $_[0] =~ /($ip_rgx)/o;"
NSQ_SOURCE_LINE 00000055 "    ($msk) = $_[0] =~ m!/(.+)!o;"
NSQ_SOURCE_LINE 00000056 "  }"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "  # Remove white spaces"
NSQ_SOURCE_LINE 00000059 "  $ip = ipv4_chkip( $ip ) or"
NSQ_SOURCE_LINE 00000060 "    croak __PACKAGE__, \": invalid IPv4 address: \", $ip, \"\\n\";"
NSQ_SOURCE_LINE 00000061 "  $msk =~ s/\\s//g if defined $msk;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "  # Check Netmask to see if it is a CIDR or Network"
NSQ_SOURCE_LINE 00000064 "  if (defined $msk ) {"
NSQ_SOURCE_LINE 00000065 "    if ($msk =~ /^\\d{1,2}$/) {"
NSQ_SOURCE_LINE 00000066 "      # Check cidr"
NSQ_SOURCE_LINE 00000067 "      croak __PACKAGE__, \": invalid cidr: \", $msk, \"\\n\""
NSQ_SOURCE_LINE 00000068 "\tif $msk < 0 or $msk > 32;"
NSQ_SOURCE_LINE 00000069 "    } elsif ($msk =~ /^$ip_rgx$/o ) {"
NSQ_SOURCE_LINE 00000070 "      $msk = ipv4_msk2cidr($msk);"
NSQ_SOURCE_LINE 00000071 "    } else {"
NSQ_SOURCE_LINE 00000072 "      croak __PACKAGE__, \": invalid netmask specification: \", $msk, \"\\n\";"
NSQ_SOURCE_LINE 00000073 "    }"
NSQ_SOURCE_LINE 00000074 "  } else {"
NSQ_SOURCE_LINE 00000075 "    # Host"
NSQ_SOURCE_LINE 00000076 "    return $ip;"
NSQ_SOURCE_LINE 00000077 "  }"
NSQ_SOURCE_LINE 00000078 "  wantarray ? ($ip,$msk) : \"$ip/$msk\";"
NSQ_SOURCE_LINE 00000079 "}"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "sub ipv4_dflt_netmask($) {"
NSQ_SOURCE_LINE 00000082 "  my ($ip) = ipv4_parse($_[0]);"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "  my ($b1) = split /\\./, $ip;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "  return \"255.0.0.0\"\tif $b1 <= 127;"
NSQ_SOURCE_LINE 00000087 "  return \"255.255.0.0\"\tif $b1 <= 191;"
NSQ_SOURCE_LINE 00000088 "  return \"255.255.255.0\";"
NSQ_SOURCE_LINE 00000089 "}"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "# Check form a valid IPv4 address."
NSQ_SOURCE_LINE 00000092 "sub ipv4_chkip($) {"
NSQ_SOURCE_LINE 00000093 "  my ($ip) = $_[0] =~ /($ip_rgx)/o;"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "  return undef unless $ip;"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "  # Check that bytes are in range"
NSQ_SOURCE_LINE 00000098 "  for (split /\\./, $ip ) {"
NSQ_SOURCE_LINE 00000099 "    return undef if $_ < 0 or $_ > 255;"
NSQ_SOURCE_LINE 00000100 "  }"
NSQ_SOURCE_LINE 00000101 "  return $ip;"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "# Transform a netmask in a CIDR mask length"
NSQ_SOURCE_LINE 00000105 "sub ipv4_msk2cidr($) {"
NSQ_SOURCE_LINE 00000106 "  my $msk = ipv4_chkip( $_[0] )"
NSQ_SOURCE_LINE 00000107 "    or croak __PACKAGE__, \": invalid netmask: \", $_[0], \"\\n\";"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "  my @bytes = split /\\./, $msk;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "  my $cidr = 0;"
NSQ_SOURCE_LINE 00000112 "  for (@bytes) {"
NSQ_SOURCE_LINE 00000113 "    my $bits = unpack( \"B*\", pack( \"C\", $_ ) );"
NSQ_SOURCE_LINE 00000114 "    $cidr +=  $bits =~ tr /1/1/;"
NSQ_SOURCE_LINE 00000115 "  }"
NSQ_SOURCE_LINE 00000116 "  return $cidr;"
NSQ_SOURCE_LINE 00000117 "}"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "# Transform a CIDR mask length in a netmask"
NSQ_SOURCE_LINE 00000120 "sub ipv4_cidr2msk($) {"
NSQ_SOURCE_LINE 00000121 "  my $cidr = shift;"
NSQ_SOURCE_LINE 00000122 "  croak __PACKAGE__, \": invalid cidr: \", $cidr, \"\\n\""
NSQ_SOURCE_LINE 00000123 "    if $cidr < 0 or $cidr > 32;"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "  my $bits = \"1\" x $cidr . \"0\" x (32 - $cidr);"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "  return join \".\", (unpack 'CCCC', pack(\"B*\", $bits ));"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "# Return the network address of"
NSQ_SOURCE_LINE 00000131 "# an IPv4 address"
NSQ_SOURCE_LINE 00000132 "sub ipv4_network($;$) {"
NSQ_SOURCE_LINE 00000133 "  my ($ip,$cidr) = ipv4_parse( $_[0], $_[1] );"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "  # If only an host is given, use the default netmask"
NSQ_SOURCE_LINE 00000136 "  unless (defined $cidr) {"
NSQ_SOURCE_LINE 00000137 "    $cidr = ipv4_msk2cidr( ipv4_dflt_netmask($ip) );"
NSQ_SOURCE_LINE 00000138 "  }"
NSQ_SOURCE_LINE 00000139 "  my $u32 = unpack \"N\", pack \"CCCC\", split /\\./, $ip;"
NSQ_SOURCE_LINE 00000140 "  my $bits = \"1\" x $cidr . \"0\" x (32 - $cidr );"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "  my $msk = unpack \"N\", pack \"B*\", $bits;"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "  my $net = join \".\", unpack \"CCCC\", pack \"N\", $u32 & $msk;"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "  wantarray ? ( $net, $cidr) : \"$net/$cidr\";"
NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "sub ipv4_broadcast($;$) {"
NSQ_SOURCE_LINE 00000150 "  my ($ip,$cidr) = ipv4_parse( $_[0], $_[1] );"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "  # If only an host is given, use the default netmask"
NSQ_SOURCE_LINE 00000153 "  unless (defined $cidr) {"
NSQ_SOURCE_LINE 00000154 "    $cidr = ipv4_msk2cidr( ipv4_dflt_netmask($ip) );"
NSQ_SOURCE_LINE 00000155 "  }"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "  my $u32 = unpack \"N\", pack \"CCCC\", split /\\./, $ip;"
NSQ_SOURCE_LINE 00000158 "  my $bits = \"1\" x $cidr . \"0\" x (32 - $cidr );"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "  my $msk = unpack \"N\", pack \"B*\", $bits;"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "  my $broadcast = join \".\", unpack \"CCCC\", pack \"N\", $u32 | ~$msk;"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "  $broadcast;"
NSQ_SOURCE_LINE 00000165 "}"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "sub ipv4_in_network($$;$$) {"
NSQ_SOURCE_LINE 00000168 "  my ($ip1,$cidr1,$ip2,$cidr2);"
NSQ_SOURCE_LINE 00000169 "  if ( @_ >= 3) {"
NSQ_SOURCE_LINE 00000170 "    ($ip1,$cidr1) = ipv4_parse( $_[0], $_[1] );"
NSQ_SOURCE_LINE 00000171 "    ($ip2,$cidr2) = ipv4_parse( $_[2], $_[3] );"
NSQ_SOURCE_LINE 00000172 "  } else {"
NSQ_SOURCE_LINE 00000173 "    ($ip1,$cidr1) = ipv4_parse( $_[0]);"
NSQ_SOURCE_LINE 00000174 "    ($ip2,$cidr2) = ipv4_parse( $_[1]);"
NSQ_SOURCE_LINE 00000175 "  }"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "  # Check for magic addresses."
NSQ_SOURCE_LINE 00000178 "  return 1 if ($ip1 eq \"255.255.255.255\" or $ip1 eq \"0.0.0.0\")"
NSQ_SOURCE_LINE 00000179 "         and !defined $cidr1;"
NSQ_SOURCE_LINE 00000180 "  return 1 if ($ip2 eq \"255.255.255.255\" or $ip2 eq \"0.0.0.0\")"
NSQ_SOURCE_LINE 00000181 "         and !defined $cidr2;"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "  # Case where first argument is really an host"
NSQ_SOURCE_LINE 00000184 "  return $ip1 eq $ip2 unless (defined $cidr1);"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "  # Case where second argument is an host"
NSQ_SOURCE_LINE 00000187 "  if ( not defined $cidr2) {"
NSQ_SOURCE_LINE 00000188 "      return ipv4_network( $ip1, $cidr1) eq ipv4_network( $ip2, $cidr1 );"
NSQ_SOURCE_LINE 00000189 "  } elsif ( $cidr2 >= $cidr1 ) {"
NSQ_SOURCE_LINE 00000190 "      # Network 2 is smaller or equal than network 1"
NSQ_SOURCE_LINE 00000191 "      return ipv4_network( $ip1, $cidr1 ) eq ipv4_network( $ip2, $cidr1 );"
NSQ_SOURCE_LINE 00000192 "  } else {"
NSQ_SOURCE_LINE 00000193 "      # Network 2 is bigger, so can't be wholly contained."
NSQ_SOURCE_LINE 00000194 "      return 0;"
NSQ_SOURCE_LINE 00000195 "  }"
NSQ_SOURCE_LINE 00000196 "}"
NSQ_SOURCE_LINE 00000197 "# Autoload methods go after =cut, and are processed by the autosplit program."
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "1;"
NSQ_SOURCE_LINE 00000200 "__END__"
NSQ_SOURCE_LINE 00000201 "# Below is the stub of documentation for your module. You better edit it!"
NSQ_SOURCE_LINE 00000202 "=pod"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=head1 NAME"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "Net::IPv4Addr - Perl extension for manipulating IPv4 addresses."
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "  use Net::IPv4Addr qw( :all );"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "  my ($ip,$cidr) = ipv4_parse( \"127.0.0.1/24\" );"
NSQ_SOURCE_LINE 00000213 "  my ($ip,$cidr) = ipv4_parse( \"192.168.100.10 / 255.255.255.0\" );"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "  my ($net,$msk) = ipv4_network( \"192.168.100.30\" );"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "  my $broadcast  = ipv4_broadcast( \"192.168.100.30/26\" );"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "  if ( ipv4_in_network( \"192.168.100.0\", $her_ip ) ) {"
NSQ_SOURCE_LINE 00000220 "    print \"Welcome !\";"
NSQ_SOURCE_LINE 00000221 "  }"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "  etc."
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "Net::IPv4Addr provides functions for parsing IPv4 addresses both"
NSQ_SOURCE_LINE 00000228 "in traditional address/netmask format and in the new CIDR format."
NSQ_SOURCE_LINE 00000229 "There are also methods for calculating the network and broadcast "
NSQ_SOURCE_LINE 00000230 "address and also to see check if a given address is in a specific"
NSQ_SOURCE_LINE 00000231 "network."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=head1 ADDRESSES"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "All of Net::IPv4Addr functions accepts addresses in many"
NSQ_SOURCE_LINE 00000236 "format. The parsing is very liberal."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "All these addresses would be accepted:"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "    127.0.0.1"
NSQ_SOURCE_LINE 00000241 "    192.168.001.010/24"
NSQ_SOURCE_LINE 00000242 "    192.168.10.10/255.255.255.0"
NSQ_SOURCE_LINE 00000243 "    192.168.30.10 / 21"
NSQ_SOURCE_LINE 00000244 "    10.0.0.0 / 255.0.0.0"
NSQ_SOURCE_LINE 00000245 "    255.255.0.0"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "Those wouldn't though:"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "    272.135.234.0"
NSQ_SOURCE_LINE 00000250 "    192.168/16"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "Most functions accepts the address and netmask or masklength in the"
NSQ_SOURCE_LINE 00000253 "same scalar value or as separate values. That is either"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "    my($ip,$masklength) = ipv4_parse($cidr_str);"
NSQ_SOURCE_LINE 00000256 "    my($ip,$masklength) = ipv4_parse($ip_str,$msk_str);"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=head1 USING"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "No functions are exported by default. Either use the C<:all> tag "
NSQ_SOURCE_LINE 00000261 "to import them all or explicitly import those you need."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=over"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=item ipv4_parse"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "    my ($ip,$msklen) = ipv4_parse($cidr_str);"
NSQ_SOURCE_LINE 00000270 "    my $cidr = ipv4_parse($ip_str,$msk_str);"
NSQ_SOURCE_LINE 00000271 "    my ($ip) = ipv4_parse($ip_str,$msk_str);"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "Parse an IPv4 address and in scalar context the address in CIDR"
NSQ_SOURCE_LINE 00000274 "format and in an array context the address and the mask length."
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "If the parameters doesn't contains a netmask or a mask length, "
NSQ_SOURCE_LINE 00000277 "in scalar context only the IPv4 address is returned and in an "
NSQ_SOURCE_LINE 00000278 "array context the mask length is undefined."
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "If the function cannot parse its input, it croaks. Trap it using"
NSQ_SOURCE_LINE 00000281 "C<eval> if don't like that."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "=item ipv4_network"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "    my $cidr = ipv4_network($ip_str);"
NSQ_SOURCE_LINE 00000286 "    my $cidr = ipv4_network($cidr_str);"
NSQ_SOURCE_LINE 00000287 "    my ($net,$msk) = ipv4_network( $net_str, $msk_str);"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "In scalar context, this function returns the network in CIDR format in"
NSQ_SOURCE_LINE 00000290 "which the address is. In array context, it returns the network address and"
NSQ_SOURCE_LINE 00000291 "its mask length as a two elements array. If the input is an host without"
NSQ_SOURCE_LINE 00000292 "a netmask of mask length, the default netmask is assumed."
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "Again, the function croak if the input is invalid."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=item ipv4_broadcast"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "    my ($broadcast) = ipv4_broadcast($ip_str);"
NSQ_SOURCE_LINE 00000299 "    my $broadcast   = ipv4_broadcast($ip_str,$msk_str);"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "This function returns the broadcast address. If the input doesn't"
NSQ_SOURCE_LINE 00000302 "contains a netmask or mask length, the default netmask is assumed."
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "This function croaks if the input is invalid."
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=item ipv4_network"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "    my $cidr = ipv4_network($net_str);"
NSQ_SOURCE_LINE 00000309 "    my $cidr = ipv4_network($cidr_sstr);"
NSQ_SOURCE_LINE 00000310 "    my ($net,$msk) = ipv4_network( $ip_str, $mask_str);"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "In scalar context, this function returns the network in CIDR format in"
NSQ_SOURCE_LINE 00000313 "which the address is. In array context, it returns the network address and"
NSQ_SOURCE_LINE 00000314 "its mask length as a two elements array. If the input is an host without"
NSQ_SOURCE_LINE 00000315 "a netmask or mask length, the default netmask is assumed."
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "Again, the function croak if the input is invalid."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=item ipv4_in_network"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "    print \"Yes\" if ipv4_in_network( $cidr_str1, $cidr_str2);"
NSQ_SOURCE_LINE 00000322 "    print \"Yes\" if ipv4_in_network( $ip_str1, $mask_str1, $cidr_str2 );"
NSQ_SOURCE_LINE 00000323 "    print \"Yes\" if ipv4_in_network( $ip1, $mask1, $ip2, $msk2 );"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "This function checks if the second network is contained in"
NSQ_SOURCE_LINE 00000326 "the first one and it implements the following semantics :"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "   If net1 or net2 is a magic address (0.0.0.0 or 255.255.255.255)"
NSQ_SOURCE_LINE 00000329 "   than this function returns true."
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "   If net1 is an host, net2 will be in the same net only if"
NSQ_SOURCE_LINE 00000332 "   it is the same host."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "   If net2 is an host, it will be contained in net1 only if"
NSQ_SOURCE_LINE 00000335 "   it is part of net1."
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "   If net2 is only part of net1 if it is entirely contained in"
NSQ_SOURCE_LINE 00000338 "   net1."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "Trap bad input with C<eval> or else."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=item ipv4_checkip"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "    if ($ip = ipv4_checkip($str) ) {"
NSQ_SOURCE_LINE 00000345 "\t# Do something"
NSQ_SOURCE_LINE 00000346 "    }"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "Return the IPv4 address in the string or undef if the input "
NSQ_SOURCE_LINE 00000349 "doesn't contains a valid IPv4 address."
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=item ipv4_cidr2msk"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "    my $netmask = ipv4_cidr2msk( $cidr );"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "Returns the netmask corresponding to the mask length given in input. "
NSQ_SOURCE_LINE 00000356 "As usual, croaks if it doesn't like your input (in this case a number"
NSQ_SOURCE_LINE 00000357 "between 0 and 32)."
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=item ipv4_msk2cidr"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "    my $masklen = ipv4_msk2cidr( $msk );"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "Returns the mask length of the netmask in input. As usual, croaks if it"
NSQ_SOURCE_LINE 00000364 "doesn't like your input."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "=back"
NSQ_SOURCE_LINE 00000367 ""
