NSQ_SOURCE_LINE 00000001 "# -*- buffer-read-only: t -*-"
NSQ_SOURCE_LINE 00000002 "#"
NSQ_SOURCE_LINE 00000003 "# This file is auto-generated. ***ANY*** changes here will be lost"
NSQ_SOURCE_LINE 00000004 "#"
NSQ_SOURCE_LINE 00000005 "package Term::ReadKey;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "=head1 NAME"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "Term::ReadKey - A perl module for simple terminal control"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "    use Term::ReadKey;"
NSQ_SOURCE_LINE 00000017 "    ReadMode 4; # Turn off controls keys"
NSQ_SOURCE_LINE 00000018 "    while (not defined ($key = ReadKey(-1))) {"
NSQ_SOURCE_LINE 00000019 "        # No key yet"
NSQ_SOURCE_LINE 00000020 "    }"
NSQ_SOURCE_LINE 00000021 "    print \"Get key $key\\n\";"
NSQ_SOURCE_LINE 00000022 "    ReadMode 0; # Reset tty mode before exiting"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "Term::ReadKey is a compiled perl module dedicated to providing simple"
NSQ_SOURCE_LINE 00000027 "control over terminal driver modes (cbreak, raw, cooked, etc.,) support for"
NSQ_SOURCE_LINE 00000028 "non-blocking reads, if the architecture allows, and some generalized handy"
NSQ_SOURCE_LINE 00000029 "functions for working with terminals. One of the main goals is to have the"
NSQ_SOURCE_LINE 00000030 "functions as portable as possible, so you can just plug in \"use"
NSQ_SOURCE_LINE 00000031 "Term::ReadKey\" on any architecture and have a good likelihood of it working."
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "Version 2.30.01:"
NSQ_SOURCE_LINE 00000034 "Added handling of arrows, page up/down, home/end, insert/delete keys "
NSQ_SOURCE_LINE 00000035 "under Win32. These keys emit xterm-compatible sequences."
NSQ_SOURCE_LINE 00000036 "Works with Term::ReadLine::Perl."
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "=over 4"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "=item ReadMode MODE [, Filehandle]"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "Takes an integer argument or a string synonym (case insensitive), which"
NSQ_SOURCE_LINE 00000043 "can currently be one of the following values:"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    INT   SYNONYM    DESCRIPTION"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    0    'restore'   Restore original settings."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    1    'normal'    Change to what is commonly the default mode,"
NSQ_SOURCE_LINE 00000050 "                     echo on, buffered, signals enabled, Xon/Xoff"
NSQ_SOURCE_LINE 00000051 "                     possibly enabled, and 8-bit mode possibly disabled."
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    2    'noecho'    Same as 1, just with echo off. Nice for"
NSQ_SOURCE_LINE 00000054 "                     reading passwords."
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    3    'cbreak'    Echo off, unbuffered, signals enabled, Xon/Xoff"
NSQ_SOURCE_LINE 00000057 "                     possibly enabled, and 8-bit mode possibly enabled."
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    4    'raw'       Echo off, unbuffered, signals disabled, Xon/Xoff"
NSQ_SOURCE_LINE 00000060 "                     disabled, and 8-bit mode possibly disabled."
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    5    'ultra-raw' Echo off, unbuffered, signals disabled, Xon/Xoff "
NSQ_SOURCE_LINE 00000063 "                     disabled, 8-bit mode enabled if parity permits,"
NSQ_SOURCE_LINE 00000064 "                     and CR to CR/LF translation turned off. "
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "These functions are automatically applied to the STDIN handle if no"
NSQ_SOURCE_LINE 00000068 "other handle is supplied. Modes 0 and 5 have some special properties"
NSQ_SOURCE_LINE 00000069 "worth mentioning: not only will mode 0 restore original settings, but it"
NSQ_SOURCE_LINE 00000070 "cause the next ReadMode call to save a new set of default settings. Mode"
NSQ_SOURCE_LINE 00000071 "5 is similar to mode 4, except no CR/LF translation is performed, and if"
NSQ_SOURCE_LINE 00000072 "possible, parity will be disabled (only if not being used by the terminal,"
NSQ_SOURCE_LINE 00000073 "however. It is no different from mode 4 under Windows.)"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "If you just need to read a key at a time, then modes 3 or 4 are probably"
NSQ_SOURCE_LINE 00000076 "sufficient. Mode 4 is a tad more flexible, but needs a bit more work to"
NSQ_SOURCE_LINE 00000077 "control. If you use ReadMode 3, then you should install a SIGINT or END"
NSQ_SOURCE_LINE 00000078 "handler to reset the terminal (via ReadMode 0) if the user aborts the"
NSQ_SOURCE_LINE 00000079 "program via C<^C>. (For any mode, an END handler consisting of \"ReadMode 0\""
NSQ_SOURCE_LINE 00000080 "is actually a good idea.)"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "If you are executing another program that may be changing the terminal mode,"
NSQ_SOURCE_LINE 00000083 "you will either want to say"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    ReadMode 1;             # same as ReadMode 'normal'"
NSQ_SOURCE_LINE 00000086 "    system('someprogram');"
NSQ_SOURCE_LINE 00000087 "    ReadMode 1;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "which resets the settings after the program has run, or:"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "    $somemode=1;"
NSQ_SOURCE_LINE 00000092 "    ReadMode 0;             # same as ReadMode 'restore'"
NSQ_SOURCE_LINE 00000093 "    system('someprogram');"
NSQ_SOURCE_LINE 00000094 "    ReadMode 1;"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "which records any changes the program may have made, before resetting the"
NSQ_SOURCE_LINE 00000097 "mode."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=item ReadKey MODE [, Filehandle]"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "Takes an integer argument, which can currently be one of the following "
NSQ_SOURCE_LINE 00000102 "values:"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    0    Perform a normal read using getc"
NSQ_SOURCE_LINE 00000105 "    -1   Perform a non-blocked read"
NSQ_SOURCE_LINE 00000106 "    >0\t Perform a timed read"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "If the filehandle is not supplied, it will default to STDIN. If there is"
NSQ_SOURCE_LINE 00000109 "nothing waiting in the buffer during a non-blocked read, then undef will be"
NSQ_SOURCE_LINE 00000110 "returned.  In most situations, you will probably want to use C<ReadKey -1>."
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "I<NOTE> that if the OS does not provide any known mechanism for non-blocking"
NSQ_SOURCE_LINE 00000113 "reads, then a C<ReadKey -1> can die with a fatal error. This will hopefully"
NSQ_SOURCE_LINE 00000114 "not be common."
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "If MODE is greater then zero, then ReadKey will use it as a timeout value in"
NSQ_SOURCE_LINE 00000117 "seconds (fractional seconds are allowed), and won't return C<undef> until"
NSQ_SOURCE_LINE 00000118 "that time expires."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "I<NOTE>, again, that some OS's may not support this timeout behaviour."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "If MODE is less then zero, then this is treated as a timeout"
NSQ_SOURCE_LINE 00000123 "of zero, and thus will return immediately if no character is waiting. A MODE"
NSQ_SOURCE_LINE 00000124 "of zero, however, will act like a normal getc."
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "I<NOTE>, there are currently some limitations with this call under Windows."
NSQ_SOURCE_LINE 00000127 "It may be possible that non-blocking reads will fail when reading repeating"
NSQ_SOURCE_LINE 00000128 "keys from more then one console."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=item ReadLine MODE [, Filehandle]"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "Takes an integer argument, which can currently be one of the following "
NSQ_SOURCE_LINE 00000134 "values:"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    0    Perform a normal read using scalar(<FileHandle>)"
NSQ_SOURCE_LINE 00000137 "    -1   Perform a non-blocked read"
NSQ_SOURCE_LINE 00000138 "    >0\t Perform a timed read"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "If there is nothing waiting in the buffer during a non-blocked read, then"
NSQ_SOURCE_LINE 00000141 "undef will be returned."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "I<NOTE>, that if the OS does not provide any known mechanism for"
NSQ_SOURCE_LINE 00000144 "non-blocking reads, then a C<ReadLine 1> can die with a fatal"
NSQ_SOURCE_LINE 00000145 "error. This will hopefully not be common."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "I<NOTE> that a non-blocking test is only performed for the first character"
NSQ_SOURCE_LINE 00000148 "in the line, not the entire line.  This call will probably B<not> do what"
NSQ_SOURCE_LINE 00000149 "you assume, especially with C<ReadMode> MODE values higher then 1. For"
NSQ_SOURCE_LINE 00000150 "example, pressing Space and then Backspace would appear to leave you"
NSQ_SOURCE_LINE 00000151 "where you started, but any timeouts would now be suspended."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "B<This call is currently not available under Windows>."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=item GetTerminalSize [Filehandle]"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Returns either an empty array if this operation is unsupported, or a four"
NSQ_SOURCE_LINE 00000158 "element array containing: the width of the terminal in characters, the"
NSQ_SOURCE_LINE 00000159 "height of the terminal in character, the width in pixels, and the height in"
NSQ_SOURCE_LINE 00000160 "pixels. (The pixel size will only be valid in some environments.)"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "I<NOTE>, under Windows, this function must be called with an B<output>"
NSQ_SOURCE_LINE 00000163 "filehandle, such as C<STDOUT>, or a handle opened to C<CONOUT$>."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=item SetTerminalSize WIDTH,HEIGHT,XPIX,YPIX [, Filehandle]"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "Return -1 on failure, 0 otherwise."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "I<NOTE> that this terminal size is only for B<informative> value, and"
NSQ_SOURCE_LINE 00000170 "changing the size via this mechanism will B<not> change the size of"
NSQ_SOURCE_LINE 00000171 "the screen. For example, XTerm uses a call like this when"
NSQ_SOURCE_LINE 00000172 "it resizes the screen. If any of the new measurements vary from the old, the"
NSQ_SOURCE_LINE 00000173 "OS will probably send a SIGWINCH signal to anything reading that tty or pty."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "B<This call does not work under Windows>."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=item GetSpeed [, Filehandle]"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "Returns either an empty array if the operation is unsupported, or a two"
NSQ_SOURCE_LINE 00000180 "value array containing the terminal in and out speeds, in B<decimal>. E.g,"
NSQ_SOURCE_LINE 00000181 "an in speed of 9600 baud and an out speed of 4800 baud would be returned as"
NSQ_SOURCE_LINE 00000182 "(9600,4800). Note that currently the in and out speeds will always be"
NSQ_SOURCE_LINE 00000183 "identical in some OS's."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "B<No speeds are reported under Windows>."
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "=item GetControlChars [, Filehandle]"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "Returns an array containing key/value pairs suitable for a hash. The pairs"
NSQ_SOURCE_LINE 00000190 "consist of a key, the name of the control character/signal, and the value"
NSQ_SOURCE_LINE 00000191 "of that character, as a single character."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "B<This call does nothing under Windows>."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "Each key will be an entry from the following list:"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "\tDISCARD"
NSQ_SOURCE_LINE 00000198 "\tDSUSPEND"
NSQ_SOURCE_LINE 00000199 "\tEOF"
NSQ_SOURCE_LINE 00000200 "\tEOL"
NSQ_SOURCE_LINE 00000201 "\tEOL2"
NSQ_SOURCE_LINE 00000202 "\tERASE"
NSQ_SOURCE_LINE 00000203 "\tERASEWORD"
NSQ_SOURCE_LINE 00000204 "\tINTERRUPT"
NSQ_SOURCE_LINE 00000205 "\tKILL"
NSQ_SOURCE_LINE 00000206 "\tMIN"
NSQ_SOURCE_LINE 00000207 "\tQUIT"
NSQ_SOURCE_LINE 00000208 "\tQUOTENEXT"
NSQ_SOURCE_LINE 00000209 "\tREPRINT"
NSQ_SOURCE_LINE 00000210 "\tSTART"
NSQ_SOURCE_LINE 00000211 "\tSTATUS"
NSQ_SOURCE_LINE 00000212 "\tSTOP"
NSQ_SOURCE_LINE 00000213 "\tSUSPEND"
NSQ_SOURCE_LINE 00000214 "\tSWITCH"
NSQ_SOURCE_LINE 00000215 "\tTIME"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "Thus, the following will always return the current interrupt character,"
NSQ_SOURCE_LINE 00000218 "regardless of platform."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "\t%keys = GetControlChars;"
NSQ_SOURCE_LINE 00000221 "\t$int = $keys{INTERRUPT};"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=item SetControlChars [, Filehandle]"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "Takes an array containing key/value pairs, as a hash will produce. The pairs"
NSQ_SOURCE_LINE 00000226 "should consist of a key that is the name of a legal control"
NSQ_SOURCE_LINE 00000227 "character/signal, and the value should be either a single character, or a"
NSQ_SOURCE_LINE 00000228 "number in the range 0-255. SetControlChars will die with a runtime error if"
NSQ_SOURCE_LINE 00000229 "an invalid character name is passed or there is an error changing the"
NSQ_SOURCE_LINE 00000230 "settings. The list of valid names is easily available via"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "\t%cchars = GetControlChars();"
NSQ_SOURCE_LINE 00000233 "\t@cnames = keys %cchars;"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "B<This call does nothing under Windows>."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=back"
NSQ_SOURCE_LINE 00000238 ""
