NSQ_SOURCE_LINE 00000470 "# blockoptions: "
NSQ_SOURCE_LINE 00000471 "#no nodelay"
NSQ_SOURCE_LINE 00000472 "#select"
NSQ_SOURCE_LINE 00000473 "sub ReadKey {"
NSQ_SOURCE_LINE 00000474 "    my $File = normalizehandle((@_>1?$_[1]:\\*STDIN));"
NSQ_SOURCE_LINE 00000475 "    if (defined $_[0] && $_[0] != 0) {"
NSQ_SOURCE_LINE 00000476 "        return undef if &selectfile($File,$_[0]) == 0"
NSQ_SOURCE_LINE 00000477 "    }"
NSQ_SOURCE_LINE 00000478 "    getc $File;"
NSQ_SOURCE_LINE 00000479 "}"
NSQ_SOURCE_LINE 00000480 "sub ReadLine {"
NSQ_SOURCE_LINE 00000481 "    my $File = normalizehandle((@_>1?$_[1]:\\*STDIN));"
NSQ_SOURCE_LINE 00000482 "    if (defined $_[0] && $_[0] != 0) {"
NSQ_SOURCE_LINE 00000483 "        return undef if &selectfile($File,$_[0]) == 0;"
NSQ_SOURCE_LINE 00000484 "    }"
NSQ_SOURCE_LINE 00000485 "    scalar(<$File>);"
NSQ_SOURCE_LINE 00000486 "}"
