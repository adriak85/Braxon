NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "use vars qw($VERSION);"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "$VERSION = '2.38';"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "require Exporter;"
NSQ_SOURCE_LINE 00000288 "require DynaLoader;"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "use vars qw(@ISA @EXPORT_OK @EXPORT);"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "@ISA = qw(Exporter DynaLoader);"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "# Items to export into callers namespace by default"
NSQ_SOURCE_LINE 00000295 "# (move infrequently used names to @EXPORT_OK below)"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "@EXPORT = qw("
NSQ_SOURCE_LINE 00000298 "  ReadKey"
NSQ_SOURCE_LINE 00000299 "  ReadMode"
NSQ_SOURCE_LINE 00000300 "  ReadLine"
NSQ_SOURCE_LINE 00000301 "  GetTerminalSize"
NSQ_SOURCE_LINE 00000302 "  SetTerminalSize"
NSQ_SOURCE_LINE 00000303 "  GetSpeed"
NSQ_SOURCE_LINE 00000304 "  GetControlChars"
NSQ_SOURCE_LINE 00000305 "  SetControlChars"
NSQ_SOURCE_LINE 00000306 ");"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "@EXPORT_OK = qw();"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "bootstrap Term::ReadKey;"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "# Should we use LINES and COLUMNS to try and get the terminal size?"
NSQ_SOURCE_LINE 00000313 "# Change this to zero if you have systems where these are commonly"
NSQ_SOURCE_LINE 00000314 "# set to erroneous values. (But if either are near zero, they won't be"
NSQ_SOURCE_LINE 00000315 "# used anyhow.)"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "use vars qw($UseEnv $CurrentMode %modes);"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "$UseEnv = 1;"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "$CurrentMode = 0;"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "%modes = (                            # lowercase is canonical"
NSQ_SOURCE_LINE 00000324 "    original    => 0,"
NSQ_SOURCE_LINE 00000325 "    restore     => 0,"
NSQ_SOURCE_LINE 00000326 "    normal      => 1,"
NSQ_SOURCE_LINE 00000327 "    noecho      => 2,"
NSQ_SOURCE_LINE 00000328 "    cbreak      => 3,"
NSQ_SOURCE_LINE 00000329 "    raw         => 4,"
NSQ_SOURCE_LINE 00000330 "    'ultra-raw' => 5"
NSQ_SOURCE_LINE 00000331 ");"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "# reduce Carp memory footprint, only load when needed"
NSQ_SOURCE_LINE 00000334 "sub croak { require Carp; goto &Carp::croak; }"
NSQ_SOURCE_LINE 00000335 "sub carp  { require Carp; goto &Carp::carp; }"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "sub ReadMode"
NSQ_SOURCE_LINE 00000338 "{"
NSQ_SOURCE_LINE 00000339 "    my $mode = $modes{ lc $_[0] };  # lowercase is canonical"
NSQ_SOURCE_LINE 00000340 "    my $fh = normalizehandle( ( @_ > 1 ? $_[1] : \\*STDIN ) );"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "    if ( defined($mode) )    { $CurrentMode = $mode }"
NSQ_SOURCE_LINE 00000343 "    elsif ( $_[0] =~ /^\\d/ ) { $CurrentMode = $_[0] }"
NSQ_SOURCE_LINE 00000344 "    else                     { croak(\"Unknown terminal mode `$_[0]'\"); }"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "    SetReadMode($CurrentMode, $fh);"
NSQ_SOURCE_LINE 00000347 "}"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "sub normalizehandle"
NSQ_SOURCE_LINE 00000350 "{"
NSQ_SOURCE_LINE 00000351 "    my ($file) = @_; # allows fake signature optimization"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "    no strict;"
NSQ_SOURCE_LINE 00000354 "    #\tprint \"Handle = $file\\n\";"
NSQ_SOURCE_LINE 00000355 "    if ( ref($file) ) { return $file; }    # Reference is fine"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "    #\tif ($file =~ /^\\*/) { return $file; } # Type glob is good"
NSQ_SOURCE_LINE 00000358 "    if ( ref( \\$file ) eq 'GLOB' ) { return $file; }    # Glob is good"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "    #\tprint \"Caller = \",(caller(1))[0],\"\\n\";"
NSQ_SOURCE_LINE 00000361 "    return \\*{ ( ( caller(1) )[0] ) . \"::$file\" };"
NSQ_SOURCE_LINE 00000362 "}"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "sub GetTerminalSize"
NSQ_SOURCE_LINE 00000365 "{"
NSQ_SOURCE_LINE 00000366 "    my $file = normalizehandle( ( @_ > 0 ? $_[0] : \\*STDOUT ) );"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "    my (@results, @fail);"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "    if ( &termsizeoptions() & 1 )                       # VIO"
NSQ_SOURCE_LINE 00000371 "    {"
NSQ_SOURCE_LINE 00000372 "        @results = GetTermSizeVIO($file);"
NSQ_SOURCE_LINE 00000373 "        push( @fail, \"VIOGetMode call\" );"
NSQ_SOURCE_LINE 00000374 "    }"
NSQ_SOURCE_LINE 00000375 "    elsif ( &termsizeoptions() & 2 )                    # GWINSZ"
NSQ_SOURCE_LINE 00000376 "    {"
NSQ_SOURCE_LINE 00000377 "        @results = GetTermSizeGWINSZ($file);"
NSQ_SOURCE_LINE 00000378 "        push( @fail, \"TIOCGWINSZ ioctl\" );"
NSQ_SOURCE_LINE 00000379 "    }"
NSQ_SOURCE_LINE 00000380 "    elsif ( &termsizeoptions() & 4 )                    # GSIZE"
NSQ_SOURCE_LINE 00000381 "    {"
NSQ_SOURCE_LINE 00000382 "        @results = GetTermSizeGSIZE($file);"
NSQ_SOURCE_LINE 00000383 "        push( @fail, \"TIOCGSIZE ioctl\" );"
NSQ_SOURCE_LINE 00000384 "    }"
NSQ_SOURCE_LINE 00000385 "    elsif ( &termsizeoptions() & 8 )                    # WIN32"
NSQ_SOURCE_LINE 00000386 "    {"
NSQ_SOURCE_LINE 00000387 "        @results = GetTermSizeWin32($file);"
NSQ_SOURCE_LINE 00000388 "        push( @fail, \"Win32 GetConsoleScreenBufferInfo call\" );"
NSQ_SOURCE_LINE 00000389 "    }"
NSQ_SOURCE_LINE 00000390 "    else"
NSQ_SOURCE_LINE 00000391 "    {"
NSQ_SOURCE_LINE 00000392 "        @results = ();"
NSQ_SOURCE_LINE 00000393 "    }"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "    if ( @results < 4 and $UseEnv )"
NSQ_SOURCE_LINE 00000396 "    {"
NSQ_SOURCE_LINE 00000397 "        my ($C) = defined( $ENV{COLUMNS} ) ? $ENV{COLUMNS} : 0;"
NSQ_SOURCE_LINE 00000398 "        my ($L) = defined( $ENV{LINES} )   ? $ENV{LINES}   : 0;"
NSQ_SOURCE_LINE 00000399 "        if ( ( $C >= 2 ) and ( $L >= 2 ) )"
NSQ_SOURCE_LINE 00000400 "        {"
NSQ_SOURCE_LINE 00000401 "            @results = ( $C + 0, $L + 0, 0, 0 );"
NSQ_SOURCE_LINE 00000402 "        }"
NSQ_SOURCE_LINE 00000403 "        push( @fail, \"COLUMNS and LINES environment variables\" );"
NSQ_SOURCE_LINE 00000404 "    }"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "    if ( @results < 4 && $^O ne 'MSWin32')"
NSQ_SOURCE_LINE 00000407 "    {"
NSQ_SOURCE_LINE 00000408 "        my ($prog) = \"resize\";"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "        # Workaround for Solaris path silliness"
NSQ_SOURCE_LINE 00000411 "        if ( -f \"/usr/openwin/bin/resize\" ) {"
NSQ_SOURCE_LINE 00000412 "            $prog = \"/usr/openwin/bin/resize\";"
NSQ_SOURCE_LINE 00000413 "        }"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "        my ($resize) = scalar(`$prog 2>/dev/null`);"
NSQ_SOURCE_LINE 00000416 "        if (defined $resize"
NSQ_SOURCE_LINE 00000417 "            and (  $resize =~ /COLUMNS\\s*=\\s*(\\d+)/"
NSQ_SOURCE_LINE 00000418 "                or $resize =~ /setenv\\s+COLUMNS\\s+'?(\\d+)/ )"
NSQ_SOURCE_LINE 00000419 "           )"
NSQ_SOURCE_LINE 00000420 "        {"
NSQ_SOURCE_LINE 00000421 "            $results[0] = $1;"
NSQ_SOURCE_LINE 00000422 "            if (   $resize =~ /LINES\\s*=\\s*(\\d+)/"
NSQ_SOURCE_LINE 00000423 "                or $resize =~ /setenv\\s+LINES\\s+'?(\\d+)/ )"
NSQ_SOURCE_LINE 00000424 "            {"
NSQ_SOURCE_LINE 00000425 "                $results[1] = $1;"
NSQ_SOURCE_LINE 00000426 "                @results[ 2, 3 ] = ( 0, 0 );"
NSQ_SOURCE_LINE 00000427 "            }"
NSQ_SOURCE_LINE 00000428 "            else"
NSQ_SOURCE_LINE 00000429 "            {"
NSQ_SOURCE_LINE 00000430 "                @results = ();"
NSQ_SOURCE_LINE 00000431 "            }"
NSQ_SOURCE_LINE 00000432 "        }"
NSQ_SOURCE_LINE 00000433 "        else"
NSQ_SOURCE_LINE 00000434 "        {"
NSQ_SOURCE_LINE 00000435 "            @results = ();"
NSQ_SOURCE_LINE 00000436 "        }"
NSQ_SOURCE_LINE 00000437 "        push( @fail, \"resize program\" );"
NSQ_SOURCE_LINE 00000438 "    }"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "    if ( @results < 4 && $^O ne 'MSWin32' )"
NSQ_SOURCE_LINE 00000441 "    {"
NSQ_SOURCE_LINE 00000442 "        my ($prog) = \"stty size\";"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "        my ($stty) = scalar(`$prog 2>/dev/null`);"
NSQ_SOURCE_LINE 00000445 "        if (defined $stty"
NSQ_SOURCE_LINE 00000446 "            and (  $stty =~ /(\\d+) (\\d+)/ )"
NSQ_SOURCE_LINE 00000447 "           )"
NSQ_SOURCE_LINE 00000448 "        {"
NSQ_SOURCE_LINE 00000449 "            $results[0] = $2;"
NSQ_SOURCE_LINE 00000450 "            $results[1] = $1;"
NSQ_SOURCE_LINE 00000451 "            @results[ 2, 3 ] = ( 0, 0 );"
NSQ_SOURCE_LINE 00000452 "        }"
NSQ_SOURCE_LINE 00000453 "        else"
NSQ_SOURCE_LINE 00000454 "        {"
NSQ_SOURCE_LINE 00000455 "            @results = ();"
NSQ_SOURCE_LINE 00000456 "        }"
NSQ_SOURCE_LINE 00000457 "        push( @fail, \"stty program\" );"
NSQ_SOURCE_LINE 00000458 "    }"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "    if ( @results != 4 )"
NSQ_SOURCE_LINE 00000461 "    {"
NSQ_SOURCE_LINE 00000462 "        carp(\"Unable to get Terminal Size.\""
NSQ_SOURCE_LINE 00000463 "             . join( \"\", map( \" The $_ didn't work.\", @fail ) ));"
NSQ_SOURCE_LINE 00000464 "\treturn undef;"
NSQ_SOURCE_LINE 00000465 "    }"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "    @results;"
NSQ_SOURCE_LINE 00000468 "}"
