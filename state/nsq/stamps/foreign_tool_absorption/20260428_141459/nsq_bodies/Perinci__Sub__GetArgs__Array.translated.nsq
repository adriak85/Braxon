NSQ_SOURCE_LINE 00000001 "package Perinci::Sub::GetArgs::Array;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2019-04-15'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.170'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 "#use Log::Any '$log';"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Exporter;"
NSQ_SOURCE_LINE 00000012 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw(get_args_from_array);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our %SPEC;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "$SPEC{':package'} = {"
NSQ_SOURCE_LINE 00000018 "    v => 1.1,"
NSQ_SOURCE_LINE 00000019 "};"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "$SPEC{get_args_from_array} = {"
NSQ_SOURCE_LINE 00000022 "    v => 1.1,"
NSQ_SOURCE_LINE 00000023 "    summary => 'Get subroutine arguments (%args) from array',"
NSQ_SOURCE_LINE 00000024 "    description => <<'_',"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "Using information in metadata's `args` property (particularly the `pos` and"
NSQ_SOURCE_LINE 00000027 "`slurpy` arg type clauses), extract arguments from an array into a hash"
NSQ_SOURCE_LINE 00000028 "`\\%args`, suitable for passing into subs."
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "Example:"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    my $meta = {"
NSQ_SOURCE_LINE 00000033 "        v => 1.1,"
NSQ_SOURCE_LINE 00000034 "        summary => 'Multiply 2 numbers (a & b)',"
NSQ_SOURCE_LINE 00000035 "        args => {"
NSQ_SOURCE_LINE 00000036 "            a => {schema=>'num*', pos=>0},"
NSQ_SOURCE_LINE 00000037 "            b => {schema=>'num*', pos=>1},"
NSQ_SOURCE_LINE 00000038 "        }"
NSQ_SOURCE_LINE 00000039 "    }"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "then `get_args_from_array(array=>[2, 3], meta=>$meta)` will produce:"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    [200, \"OK\", {a=>2, b=>3}]"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "_"
NSQ_SOURCE_LINE 00000046 "    args => {"
NSQ_SOURCE_LINE 00000047 "        array => {"
NSQ_SOURCE_LINE 00000048 "            schema => ['array*' => {}],"
NSQ_SOURCE_LINE 00000049 "            req => 1,"
NSQ_SOURCE_LINE 00000050 "            description => <<'_',"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "NOTE: array will be modified/emptied (elements will be taken from the array as"
NSQ_SOURCE_LINE 00000053 "they are put into the resulting args). Copy your array first if you want to"
NSQ_SOURCE_LINE 00000054 "preserve its content."
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "_"
NSQ_SOURCE_LINE 00000057 "        },"
NSQ_SOURCE_LINE 00000058 "        meta => {"
NSQ_SOURCE_LINE 00000059 "            schema => ['hash*' => {}],"
NSQ_SOURCE_LINE 00000060 "            req => 1,"
NSQ_SOURCE_LINE 00000061 "        },"
NSQ_SOURCE_LINE 00000062 "        meta_is_normalized => {"
NSQ_SOURCE_LINE 00000063 "            summary => 'Can be set to 1 if your metadata is normalized, '."
NSQ_SOURCE_LINE 00000064 "                'to avoid duplicate effort',"
NSQ_SOURCE_LINE 00000065 "            schema => 'bool',"
NSQ_SOURCE_LINE 00000066 "            default => 0,"
NSQ_SOURCE_LINE 00000067 "        },"
NSQ_SOURCE_LINE 00000068 "        allow_extra_elems => {"
NSQ_SOURCE_LINE 00000069 "            schema => ['bool' => {default=>0}],"
NSQ_SOURCE_LINE 00000070 "            summary => 'Allow extra/unassigned elements in array',"
NSQ_SOURCE_LINE 00000071 "            description => <<'_',"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "If set to 1, then if there are array elements unassigned to one of the arguments"
NSQ_SOURCE_LINE 00000074 "(due to missing `pos`, for example), instead of generating an error, the"
NSQ_SOURCE_LINE 00000075 "function will just ignore them."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "_"
NSQ_SOURCE_LINE 00000078 "        },"
NSQ_SOURCE_LINE 00000079 "    },"
NSQ_SOURCE_LINE 00000080 "};"
NSQ_SOURCE_LINE 00000081 "sub get_args_from_array {"
NSQ_SOURCE_LINE 00000082 "    my %fargs = @_;"
NSQ_SOURCE_LINE 00000083 "    my $ary  = $fargs{array} or return [400, \"Please specify array\"];"
NSQ_SOURCE_LINE 00000084 "    my $meta = $fargs{meta} or return [400, \"Please specify meta\"];"
NSQ_SOURCE_LINE 00000085 "    unless ($fargs{meta_is_normalized}) {"
NSQ_SOURCE_LINE 00000086 "        require Perinci::Sub::Normalize;"
NSQ_SOURCE_LINE 00000087 "        $meta = Perinci::Sub::Normalize::normalize_function_metadata("
NSQ_SOURCE_LINE 00000088 "            $meta);"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 "    my $allow_extra_elems = $fargs{allow_extra_elems} // 0;"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    my $rargs = {};"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    my $args_p = $meta->{args} // {};"
NSQ_SOURCE_LINE 00000095 "    for my $i (reverse 0..@$ary-1) {"
NSQ_SOURCE_LINE 00000096 "        #$log->tracef(\"i=$i\");"
NSQ_SOURCE_LINE 00000097 "        while (my ($a, $as) = each %$args_p) {"
NSQ_SOURCE_LINE 00000098 "            my $o = $as->{pos};"
NSQ_SOURCE_LINE 00000099 "            if (defined($o) && $o == $i) {"
NSQ_SOURCE_LINE 00000100 "                if ($as->{slurpy} // $as->{greedy}) {"
NSQ_SOURCE_LINE 00000101 "                    my $type = $as->{schema}[0];"
NSQ_SOURCE_LINE 00000102 "                    my @elems = splice(@$ary, $i);"
NSQ_SOURCE_LINE 00000103 "                    if ($type eq 'array') {"
NSQ_SOURCE_LINE 00000104 "                        $rargs->{$a} = \\@elems;"
NSQ_SOURCE_LINE 00000105 "                    } elsif ($type eq 'hash') {"
NSQ_SOURCE_LINE 00000106 "                        $rargs->{$a} = {};"
NSQ_SOURCE_LINE 00000107 "                        for my $j (0..$#elems) {"
NSQ_SOURCE_LINE 00000108 "                            my $elem = $elems[$j];"
NSQ_SOURCE_LINE 00000109 "                            unless ($elem =~ /(.*?)=(.*)/) {"
NSQ_SOURCE_LINE 00000110 "                                return [400, \"Invalid key=value pair in element #$j\"];"
NSQ_SOURCE_LINE 00000111 "                            }"
NSQ_SOURCE_LINE 00000112 "                            $rargs->{$a}{$1} = $2;"
NSQ_SOURCE_LINE 00000113 "                        }"
NSQ_SOURCE_LINE 00000114 "                    } else {"
NSQ_SOURCE_LINE 00000115 "                        $rargs->{$a} = join \" \", @elems;"
NSQ_SOURCE_LINE 00000116 "                    }"
NSQ_SOURCE_LINE 00000117 "                    #$log->tracef(\"assign %s to arg->{$a}\", $rargs->{$a});"
NSQ_SOURCE_LINE 00000118 "                } else {"
NSQ_SOURCE_LINE 00000119 "                    $rargs->{$a} = splice(@$ary, $i, 1);"
NSQ_SOURCE_LINE 00000120 "                    #$log->tracef(\"assign %s to arg->{$a}\", $rargs->{$a});"
NSQ_SOURCE_LINE 00000121 "                }"
NSQ_SOURCE_LINE 00000122 "            }"
NSQ_SOURCE_LINE 00000123 "        }"
NSQ_SOURCE_LINE 00000124 "    }"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "    return [400, \"There are extra, unassigned elements in array: [\"."
NSQ_SOURCE_LINE 00000127 "                join(\", \", @$ary).\"]\"] if @$ary && !$allow_extra_elems;"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "    [200, \"OK\", $rargs];"
NSQ_SOURCE_LINE 00000130 "}"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "1;"
NSQ_SOURCE_LINE 00000133 "# ABSTRACT: Get subroutine arguments (%args) from array"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "__END__"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=pod"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head1 NAME"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "Perinci::Sub::GetArgs::Array - Get subroutine arguments (%args) from array"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=head1 VERSION"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "This document describes version 0.170 of Perinci::Sub::GetArgs::Array (from Perl distribution Perinci-Sub-GetArgs-Array), released on 2019-04-15."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 " use Perinci::Sub::GetArgs::Array;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 " my $res = get_args_from_array(array=>\\@ary, meta=>$meta, ...);"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "This module provides get_args_from_array(). This module is used by, among"
NSQ_SOURCE_LINE 00000158 "others, L<Perinci::Sub::GetArgs::Argv>."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=head2 get_args_from_array"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "Usage:"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 " get_args_from_array(%args) -> [status, msg, payload, meta]"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "Get subroutine arguments (%args) from array."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "Using information in metadata's C<args> property (particularly the C<pos> and"
NSQ_SOURCE_LINE 00000172 "C<slurpy> arg type clauses), extract arguments from an array into a hash"
NSQ_SOURCE_LINE 00000173 "C<\\%args>, suitable for passing into subs."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "Example:"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 " my $meta = {"
NSQ_SOURCE_LINE 00000178 "     v => 1.1,"
NSQ_SOURCE_LINE 00000179 "     summary => 'Multiply 2 numbers (a & b)',"
NSQ_SOURCE_LINE 00000180 "     args => {"
NSQ_SOURCE_LINE 00000181 "         a => {schema=>'num*', pos=>0},"
NSQ_SOURCE_LINE 00000182 "         b => {schema=>'num*', pos=>1},"
NSQ_SOURCE_LINE 00000183 "     }"
NSQ_SOURCE_LINE 00000184 " }"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "then C<< get_args_from_array(array=E<gt>[2, 3], meta=E<gt>$meta) >> will produce:"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 " [200, \"OK\", {a=>2, b=>3}]"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=over 4"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=item * B<allow_extra_elems> => I<bool> (default: 0)"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "Allow extra/unassigned elements in array."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "If set to 1, then if there are array elements unassigned to one of the arguments"
NSQ_SOURCE_LINE 00000201 "(due to missing C<pos>, for example), instead of generating an error, the"
NSQ_SOURCE_LINE 00000202 "function will just ignore them."
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=item * B<array>* => I<array>"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "NOTE: array will be modified/emptied (elements will be taken from the array as"
NSQ_SOURCE_LINE 00000207 "they are put into the resulting args). Copy your array first if you want to"
NSQ_SOURCE_LINE 00000208 "preserve its content."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=item * B<meta>* => I<hash>"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=item * B<meta_is_normalized> => I<bool> (default: 0)"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "Can be set to 1 if your metadata is normalized, to avoid duplicate effort."
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=back"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "First element (status) is an integer containing HTTP status code"
NSQ_SOURCE_LINE 00000221 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000222 "(msg) is a string containing error message, or 'OK' if status is"
NSQ_SOURCE_LINE 00000223 "200. Third element (payload) is optional, the actual result. Fourth"
NSQ_SOURCE_LINE 00000224 "element (meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000225 "that contains extra information."
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "Return value:  (any)"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "Please visit the project's homepage at L<https://metacpan.org/release/Perinci-Sub-GetArgs-Array>."
NSQ_SOURCE_LINE 00000232 ""
