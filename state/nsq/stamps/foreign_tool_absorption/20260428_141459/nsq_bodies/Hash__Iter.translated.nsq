NSQ_SOURCE_LINE 00000001 "package Hash::Iter;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000009 "our $DATE = '2024-11-04'; # DATE"
NSQ_SOURCE_LINE 00000010 "our $DIST = 'Hash-Iter'; # DIST"
NSQ_SOURCE_LINE 00000011 "our $VERSION = '0.001'; # VERSION"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw(hash_iter pair_iter);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub hash_iter {"
NSQ_SOURCE_LINE 00000016 "    my $hash = shift;"
NSQ_SOURCE_LINE 00000017 "    my $i = 0;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    my @ary = keys %$hash;"
NSQ_SOURCE_LINE 00000020 "    sub {"
NSQ_SOURCE_LINE 00000021 "        if ($i < @ary) {"
NSQ_SOURCE_LINE 00000022 "            my $key = $ary[$i++];"
NSQ_SOURCE_LINE 00000023 "            return ($key, $hash->{$key});"
NSQ_SOURCE_LINE 00000024 "        } else {"
NSQ_SOURCE_LINE 00000025 "            return ();"
NSQ_SOURCE_LINE 00000026 "        }"
NSQ_SOURCE_LINE 00000027 "    };"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "sub pair_iter {"
NSQ_SOURCE_LINE 00000031 "    hash_iter({@_});"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "1;"
NSQ_SOURCE_LINE 00000035 "# ABSTRACT: Generate a coderef iterator for a hash"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "__END__"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=pod"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=head1 NAME"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "Hash::Iter - Generate a coderef iterator for a hash"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 VERSION"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "This document describes version 0.001 of Hash::Iter (from Perl distribution Hash-Iter), released on 2024-11-04."
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "  use Hash::Iter qw(hash_iter pair_iter);"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "  my $iter = hash_iter({1,2,3,4,5,6});"
NSQ_SOURCE_LINE 00000056 "  while (my ($key,$val) = $iter->()) { ... }"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "  $iter = pair_iter(1,2,3,4,5,6);"
NSQ_SOURCE_LINE 00000059 "  while (my ($key,$val) = $iter->()) { ... }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "This module provides a simple iterator which is a coderef that you can call"
NSQ_SOURCE_LINE 00000064 "repeatedly to get pairs of a hash/hashref. When the pairs are exhausted, the"
NSQ_SOURCE_LINE 00000065 "coderef will return undef. No class/object involved."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "The principle is very simple and you can do it yourself with:"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 " my $iter = do {"
NSQ_SOURCE_LINE 00000070 "     my $hash = shift;"
NSQ_SOURCE_LINE 00000071 "     my $i = 0;"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "     my @ary = keys %$hash;"
NSQ_SOURCE_LINE 00000074 "     sub {"
NSQ_SOURCE_LINE 00000075 "         if ($i < @ary) {"
NSQ_SOURCE_LINE 00000076 "             my $key = $ary[$i++];"
NSQ_SOURCE_LINE 00000077 "             return ($key, $hash->{$key});"
NSQ_SOURCE_LINE 00000078 "         } else {"
NSQ_SOURCE_LINE 00000079 "             return undef;"
NSQ_SOURCE_LINE 00000080 "         }"
NSQ_SOURCE_LINE 00000081 "     };"
NSQ_SOURCE_LINE 00000082 "  }"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "Caveat: if list/array contains an C<undef> element, it cannot be distinguished"
NSQ_SOURCE_LINE 00000085 "with an exhausted iterator."
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "=for Pod::Coverage .+"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=head2 hash_iter($hashref) => coderef"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=head2 pair_iter(@pairs) => coderef"
NSQ_SOURCE_LINE 00000094 ""
