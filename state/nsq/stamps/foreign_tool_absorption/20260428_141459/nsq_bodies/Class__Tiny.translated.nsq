NSQ_SOURCE_LINE 00000001 "use 5.006;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "no strict 'refs';"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "package Class::Tiny;"
NSQ_SOURCE_LINE 00000007 "# ABSTRACT: Minimalist class construction"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $VERSION = '1.008';"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Carp ();"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "# load as .pm to hide from min version scanners"
NSQ_SOURCE_LINE 00000014 "require( $] >= 5.010 ? \"mro.pm\" : \"MRO/Compat.pm\" ); ## no critic:"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "my %CLASS_ATTRIBUTES;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub import {"
NSQ_SOURCE_LINE 00000019 "    my $class = shift;"
NSQ_SOURCE_LINE 00000020 "    my $pkg   = caller;"
NSQ_SOURCE_LINE 00000021 "    $class->prepare_class($pkg);"
NSQ_SOURCE_LINE 00000022 "    $class->create_attributes( $pkg, @_ ) if @_;"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub prepare_class {"
NSQ_SOURCE_LINE 00000026 "    my ( $class, $pkg ) = @_;"
NSQ_SOURCE_LINE 00000027 "    @{\"${pkg}::ISA\"} = \"Class::Tiny::Object\" unless @{\"${pkg}::ISA\"};"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "# adapted from Object::Tiny and Object::Tiny::RW"
NSQ_SOURCE_LINE 00000031 "sub create_attributes {"
NSQ_SOURCE_LINE 00000032 "    my ( $class, $pkg, @spec ) = @_;"
NSQ_SOURCE_LINE 00000033 "    my %defaults = map { ref $_ eq 'HASH' ? %$_ : ( $_ => undef ) } @spec;"
NSQ_SOURCE_LINE 00000034 "    my @attr = grep {"
NSQ_SOURCE_LINE 00000035 "        defined and !ref and /^[^\\W\\d]\\w*$/s"
NSQ_SOURCE_LINE 00000036 "          or Carp::croak \"Invalid accessor name '$_'\""
NSQ_SOURCE_LINE 00000037 "    } keys %defaults;"
NSQ_SOURCE_LINE 00000038 "    $CLASS_ATTRIBUTES{$pkg}{$_} = $defaults{$_} for @attr;"
NSQ_SOURCE_LINE 00000039 "    $class->_gen_accessor( $pkg, $_ ) for grep { !*{\"$pkg\\::$_\"}{CODE} } @attr;"
NSQ_SOURCE_LINE 00000040 "    Carp::croak(\"Failed to generate attributes for $pkg: $@\\n\") if $@;"
NSQ_SOURCE_LINE 00000041 "}"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "sub _gen_accessor {"
NSQ_SOURCE_LINE 00000044 "    my ( $class, $pkg, $name ) = @_;"
NSQ_SOURCE_LINE 00000045 "    my $outer_default = $CLASS_ATTRIBUTES{$pkg}{$name};"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    my $sub ="
NSQ_SOURCE_LINE 00000048 "      $class->__gen_sub_body( $name, defined($outer_default), ref($outer_default) );"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    # default = outer_default avoids \"won't stay shared\" bug"
NSQ_SOURCE_LINE 00000051 "    eval \"package $pkg; my \\$default=\\$outer_default; $sub\"; ## no critic"
NSQ_SOURCE_LINE 00000052 "    Carp::croak(\"Failed to generate attributes for $pkg: $@\\n\") if $@;"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "# NOTE: overriding __gen_sub_body in a subclass of Class::Tiny is risky and"
NSQ_SOURCE_LINE 00000056 "# could break if the internals of Class::Tiny need to change for any"
NSQ_SOURCE_LINE 00000057 "# reason.  That said, I currently see no reason why this would be likely to"
NSQ_SOURCE_LINE 00000058 "# change."
NSQ_SOURCE_LINE 00000059 "#"
NSQ_SOURCE_LINE 00000060 "# The generated sub body should assume that a '$default' variable will be"
NSQ_SOURCE_LINE 00000061 "# in scope (i.e. when the sub is evaluated) with any default value/coderef"
NSQ_SOURCE_LINE 00000062 "sub __gen_sub_body {"
NSQ_SOURCE_LINE 00000063 "    my ( $self, $name, $has_default, $default_type ) = @_;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    if ( $has_default && $default_type eq 'CODE' ) {"
NSQ_SOURCE_LINE 00000066 "        return << \"HERE\";"
NSQ_SOURCE_LINE 00000067 "sub $name {"
NSQ_SOURCE_LINE 00000068 "    return ("
NSQ_SOURCE_LINE 00000069 "          ( \\@_ == 1 && exists \\$_[0]{$name} )"
NSQ_SOURCE_LINE 00000070 "        ? ( \\$_[0]{$name} )"
NSQ_SOURCE_LINE 00000071 "        : ( \\$_[0]{$name} = ( \\@_ == 2 ) ? \\$_[1] : \\$default->( \\$_[0] ) )"
NSQ_SOURCE_LINE 00000072 "    );"
NSQ_SOURCE_LINE 00000073 "}"
NSQ_SOURCE_LINE 00000074 "HERE"
NSQ_SOURCE_LINE 00000075 "    }"
NSQ_SOURCE_LINE 00000076 "    elsif ($has_default) {"
NSQ_SOURCE_LINE 00000077 "        return << \"HERE\";"
NSQ_SOURCE_LINE 00000078 "sub $name {"
NSQ_SOURCE_LINE 00000079 "    return ("
NSQ_SOURCE_LINE 00000080 "          ( \\@_ == 1 && exists \\$_[0]{$name} )"
NSQ_SOURCE_LINE 00000081 "        ? ( \\$_[0]{$name} )"
NSQ_SOURCE_LINE 00000082 "        : ( \\$_[0]{$name} = ( \\@_ == 2 ) ? \\$_[1] : \\$default )"
NSQ_SOURCE_LINE 00000083 "    );"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 "HERE"
NSQ_SOURCE_LINE 00000086 "    }"
NSQ_SOURCE_LINE 00000087 "    else {"
NSQ_SOURCE_LINE 00000088 "        return << \"HERE\";"
NSQ_SOURCE_LINE 00000089 "sub $name {"
NSQ_SOURCE_LINE 00000090 "    return \\@_ == 1 ? \\$_[0]{$name} : ( \\$_[0]{$name} =  \\$_[1] );"
NSQ_SOURCE_LINE 00000091 "}"
NSQ_SOURCE_LINE 00000092 "HERE"
NSQ_SOURCE_LINE 00000093 "    }"
NSQ_SOURCE_LINE 00000094 "}"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "sub get_all_attributes_for {"
NSQ_SOURCE_LINE 00000097 "    my ( $class, $pkg ) = @_;"
NSQ_SOURCE_LINE 00000098 "    my %attr ="
NSQ_SOURCE_LINE 00000099 "      map { $_ => undef }"
NSQ_SOURCE_LINE 00000100 "      map { keys %{ $CLASS_ATTRIBUTES{$_} || {} } } @{ mro::get_linear_isa($pkg) };"
NSQ_SOURCE_LINE 00000101 "    return keys %attr;"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub get_all_attribute_defaults_for {"
NSQ_SOURCE_LINE 00000105 "    my ( $class, $pkg ) = @_;"
NSQ_SOURCE_LINE 00000106 "    my $defaults = {};"
NSQ_SOURCE_LINE 00000107 "    for my $p ( reverse @{ mro::get_linear_isa($pkg) } ) {"
NSQ_SOURCE_LINE 00000108 "        while ( my ( $k, $v ) = each %{ $CLASS_ATTRIBUTES{$p} || {} } ) {"
NSQ_SOURCE_LINE 00000109 "            $defaults->{$k} = $v;"
NSQ_SOURCE_LINE 00000110 "        }"
NSQ_SOURCE_LINE 00000111 "    }"
NSQ_SOURCE_LINE 00000112 "    return $defaults;"
NSQ_SOURCE_LINE 00000113 "}"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "package Class::Tiny::Object;"
NSQ_SOURCE_LINE 00000116 "# ABSTRACT: Base class for classes built with Class::Tiny"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "our $VERSION = '1.008';"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "my ( %HAS_BUILDARGS, %BUILD_CACHE, %DEMOLISH_CACHE, %ATTR_CACHE );"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "my $_PRECACHE = sub {"
NSQ_SOURCE_LINE 00000123 "    no warnings 'once'; # needed to avoid downstream warnings"
NSQ_SOURCE_LINE 00000124 "    my ($class) = @_;"
NSQ_SOURCE_LINE 00000125 "    my $linear_isa ="
NSQ_SOURCE_LINE 00000126 "      @{\"$class\\::ISA\"} == 1 && ${\"$class\\::ISA\"}[0] eq \"Class::Tiny::Object\""
NSQ_SOURCE_LINE 00000127 "      ? [$class]"
NSQ_SOURCE_LINE 00000128 "      : mro::get_linear_isa($class);"
NSQ_SOURCE_LINE 00000129 "    $DEMOLISH_CACHE{$class} = ["
NSQ_SOURCE_LINE 00000130 "        map { ( *{$_}{CODE} ) ? ( *{$_}{CODE} ) : () }"
NSQ_SOURCE_LINE 00000131 "        map { \"$_\\::DEMOLISH\" } @$linear_isa"
NSQ_SOURCE_LINE 00000132 "    ];"
NSQ_SOURCE_LINE 00000133 "    $BUILD_CACHE{$class} = ["
NSQ_SOURCE_LINE 00000134 "        map { ( *{$_}{CODE} ) ? ( *{$_}{CODE} ) : () }"
NSQ_SOURCE_LINE 00000135 "        map { \"$_\\::BUILD\" } reverse @$linear_isa"
NSQ_SOURCE_LINE 00000136 "    ];"
NSQ_SOURCE_LINE 00000137 "    $HAS_BUILDARGS{$class} = $class->can(\"BUILDARGS\");"
NSQ_SOURCE_LINE 00000138 "    return $ATTR_CACHE{$class} ="
NSQ_SOURCE_LINE 00000139 "      { map { $_ => 1 } Class::Tiny->get_all_attributes_for($class) };"
NSQ_SOURCE_LINE 00000140 "};"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "sub new {"
NSQ_SOURCE_LINE 00000143 "    my $class = shift;"
NSQ_SOURCE_LINE 00000144 "    my $valid_attrs = $ATTR_CACHE{$class} || $_PRECACHE->($class);"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    # handle hash ref or key/value arguments"
NSQ_SOURCE_LINE 00000147 "    my $args;"
NSQ_SOURCE_LINE 00000148 "    if ( $HAS_BUILDARGS{$class} ) {"
NSQ_SOURCE_LINE 00000149 "        $args = $class->BUILDARGS(@_);"
NSQ_SOURCE_LINE 00000150 "    }"
NSQ_SOURCE_LINE 00000151 "    else {"
NSQ_SOURCE_LINE 00000152 "        if ( @_ == 1 && ref $_[0] ) {"
NSQ_SOURCE_LINE 00000153 "            my %copy = eval { %{ $_[0] } }; # try shallow copy"
NSQ_SOURCE_LINE 00000154 "            Carp::croak(\"Argument to $class->new() could not be dereferenced as a hash\") if $@;"
NSQ_SOURCE_LINE 00000155 "            $args = \\%copy;"
NSQ_SOURCE_LINE 00000156 "        }"
NSQ_SOURCE_LINE 00000157 "        elsif ( @_ % 2 == 0 ) {"
NSQ_SOURCE_LINE 00000158 "            $args = {@_};"
NSQ_SOURCE_LINE 00000159 "        }"
NSQ_SOURCE_LINE 00000160 "        else {"
NSQ_SOURCE_LINE 00000161 "            Carp::croak(\"$class->new() got an odd number of elements\");"
NSQ_SOURCE_LINE 00000162 "        }"
NSQ_SOURCE_LINE 00000163 "    }"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "    # create object and invoke BUILD (unless we were given __no_BUILD__)"
NSQ_SOURCE_LINE 00000166 "    my $self ="
NSQ_SOURCE_LINE 00000167 "      bless { map { $_ => $args->{$_} } grep { exists $valid_attrs->{$_} } keys %$args },"
NSQ_SOURCE_LINE 00000168 "      $class;"
NSQ_SOURCE_LINE 00000169 "    $self->BUILDALL($args) if !delete $args->{__no_BUILD__} && @{ $BUILD_CACHE{$class} };"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    return $self;"
NSQ_SOURCE_LINE 00000172 "}"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "sub BUILDALL { $_->(@_) for @{ $BUILD_CACHE{ ref $_[0] } } }"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "# Adapted from Moo and its dependencies"
NSQ_SOURCE_LINE 00000177 "require Devel::GlobalDestruction unless defined ${^GLOBAL_PHASE};"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "sub DESTROY {"
NSQ_SOURCE_LINE 00000180 "    my $self  = shift;"
NSQ_SOURCE_LINE 00000181 "    my $class = ref $self;"
NSQ_SOURCE_LINE 00000182 "    my $in_global_destruction ="
NSQ_SOURCE_LINE 00000183 "      defined ${^GLOBAL_PHASE}"
NSQ_SOURCE_LINE 00000184 "      ? ${^GLOBAL_PHASE} eq 'DESTRUCT'"
NSQ_SOURCE_LINE 00000185 "      : Devel::GlobalDestruction::in_global_destruction();"
NSQ_SOURCE_LINE 00000186 "    for my $demolisher ( @{ $DEMOLISH_CACHE{$class} } ) {"
NSQ_SOURCE_LINE 00000187 "        my $e = do {"
NSQ_SOURCE_LINE 00000188 "            local ( $?, $@ );"
NSQ_SOURCE_LINE 00000189 "            eval { $demolisher->( $self, $in_global_destruction ) };"
NSQ_SOURCE_LINE 00000190 "            $@;"
NSQ_SOURCE_LINE 00000191 "        };"
NSQ_SOURCE_LINE 00000192 "        no warnings 'misc'; # avoid (in cleanup) warnings"
NSQ_SOURCE_LINE 00000193 "        die $e if $e;       # rethrow"
NSQ_SOURCE_LINE 00000194 "    }"
NSQ_SOURCE_LINE 00000195 "}"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "1;"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "# vim: ts=4 sts=4 sw=4 et:"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "__END__"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=pod"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=head1 NAME"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "Class::Tiny - Minimalist class construction"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=head1 VERSION"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "version 1.008"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "In F<Person.pm>:"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "  package Person;"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "  use Class::Tiny qw( name );"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "  1;"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "In F<Employee.pm>:"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "  package Employee;"
NSQ_SOURCE_LINE 00000229 "  use parent 'Person';"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "  use Class::Tiny qw( ssn ), {"
NSQ_SOURCE_LINE 00000232 "    timestamp => sub { time }   # attribute with default"
NSQ_SOURCE_LINE 00000233 "  };"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "  1;"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "In F<example.pl>:"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "  use Employee;"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "  my $obj = Employee->new( name => \"Larry\", ssn => \"111-22-3333\" );"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "  # unknown attributes are ignored"
NSQ_SOURCE_LINE 00000244 "  my $obj = Employee->new( name => \"Larry\", OS => \"Linux\" );"
NSQ_SOURCE_LINE 00000245 "  # $obj->{OS} does not exist"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "This module offers a minimalist class construction kit in around 120 lines of"
NSQ_SOURCE_LINE 00000250 "code.  Here is a list of features:"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=over 4"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=item *"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "defines attributes via import arguments"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=item *"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "generates read-write accessors"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=item *"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "supports lazy attribute defaults"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=item *"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "supports custom accessors"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "=item *"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "superclass provides a standard C<new> constructor"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "=item *"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "C<new> takes a hash reference or list of key/value pairs"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=item *"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "C<new> supports providing C<BUILDARGS> to customize constructor options"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=item *"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "C<new> calls C<BUILD> for each class from parent to child"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=item *"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "superclass provides a C<DESTROY> method"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=item *"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "C<DESTROY> calls C<DEMOLISH> for each class from child to parent"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=back"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "Multiple-inheritance is possible, with superclass order determined via"
NSQ_SOURCE_LINE 00000297 "L<mro::get_linear_isa|mro/Functions>."
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "It uses no non-core modules for any recent Perl. On Perls older than v5.10 it"
NSQ_SOURCE_LINE 00000300 "requires L<MRO::Compat>. On Perls older than v5.14, it requires"
NSQ_SOURCE_LINE 00000301 "L<Devel::GlobalDestruction>."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=head1 USAGE"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=head2 Defining attributes"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "Define attributes as a list of import arguments:"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "    package Foo::Bar;"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "    use Class::Tiny qw("
NSQ_SOURCE_LINE 00000312 "        name"
NSQ_SOURCE_LINE 00000313 "        id"
NSQ_SOURCE_LINE 00000314 "        height"
NSQ_SOURCE_LINE 00000315 "        weight"
NSQ_SOURCE_LINE 00000316 "    );"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "For each attribute, a read-write accessor is created unless a subroutine of that"
NSQ_SOURCE_LINE 00000319 "name already exists:"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "    $obj->name;               # getter"
NSQ_SOURCE_LINE 00000322 "    $obj->name( \"John Doe\" ); # setter"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "Attribute names must be valid subroutine identifiers or an exception will"
NSQ_SOURCE_LINE 00000325 "be thrown."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "You can specify lazy defaults by defining attributes with a hash reference."
NSQ_SOURCE_LINE 00000328 "Keys define attribute names and values are constants or code references that"
NSQ_SOURCE_LINE 00000329 "will be evaluated when the attribute is first accessed if no value has been"
NSQ_SOURCE_LINE 00000330 "set.  The object is passed as an argument to a code reference."
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "    package Foo::WithDefaults;"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "    use Class::Tiny qw/name id/, {"
NSQ_SOURCE_LINE 00000335 "        title     => 'Peon',"
NSQ_SOURCE_LINE 00000336 "        skills    => sub { [] },"
NSQ_SOURCE_LINE 00000337 "        hire_date => sub { $_[0]->_build_hire_date },"
NSQ_SOURCE_LINE 00000338 "    };"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "When subclassing, if multiple accessors of the same name exist in different"
NSQ_SOURCE_LINE 00000341 "classes, any default (or lack of default) is determined by standard"
NSQ_SOURCE_LINE 00000342 "method resolution order."
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "To make your own custom accessors, just pre-declare the method name before"
NSQ_SOURCE_LINE 00000345 "loading Class::Tiny:"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "    package Foo::Bar;"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "    use subs 'id';"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "    use Class::Tiny qw( name id );"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "    sub id { ... }"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "Even if you pre-declare a method name, you must include it in the attribute"
NSQ_SOURCE_LINE 00000356 "list for Class::Tiny to register it as a valid attribute."
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "If you set a default for a custom accessor, your accessor will need to retrieve"
NSQ_SOURCE_LINE 00000359 "the default and do something with it:"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "    package Foo::Bar;"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "    use subs 'id';"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "    use Class::Tiny qw( name ), { id => sub { int(rand(2*31)) } };"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "    sub id {"
NSQ_SOURCE_LINE 00000368 "        my $self = shift;"
NSQ_SOURCE_LINE 00000369 "        if (@_) {"
NSQ_SOURCE_LINE 00000370 "            return $self->{id} = shift;"
NSQ_SOURCE_LINE 00000371 "        }"
NSQ_SOURCE_LINE 00000372 "        elsif ( exists $self->{id} ) {"
NSQ_SOURCE_LINE 00000373 "            return $self->{id};"
NSQ_SOURCE_LINE 00000374 "        }"
NSQ_SOURCE_LINE 00000375 "        else {"
NSQ_SOURCE_LINE 00000376 "            my $defaults ="
NSQ_SOURCE_LINE 00000377 "                Class::Tiny->get_all_attribute_defaults_for( ref $self );"
NSQ_SOURCE_LINE 00000378 "            return $self->{id} = $defaults->{id}->();"
NSQ_SOURCE_LINE 00000379 "        }"
NSQ_SOURCE_LINE 00000380 "    }"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=head2 Class::Tiny::Object is your base class"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "If your class B<does not> already inherit from some class, then"
NSQ_SOURCE_LINE 00000385 "Class::Tiny::Object will be added to your C<@ISA> to provide C<new> and"
NSQ_SOURCE_LINE 00000386 "C<DESTROY>."
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "If your class B<does> inherit from something, then no additional inheritance is"
NSQ_SOURCE_LINE 00000389 "set up.  If the parent subclasses Class::Tiny::Object, then all is well.  If"
NSQ_SOURCE_LINE 00000390 "not, then you'll get accessors set up but no constructor or destructor. Don't"
NSQ_SOURCE_LINE 00000391 "do that unless you really have a special need for it."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "Define subclasses as normal.  It's best to define them with L<base>, L<parent>"
NSQ_SOURCE_LINE 00000394 "or L<superclass> before defining attributes with Class::Tiny so the C<@ISA>"
NSQ_SOURCE_LINE 00000395 "array is already populated at compile-time:"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "    package Foo::Bar::More;"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "    use parent 'Foo::Bar';"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "    use Class::Tiny qw( shoe_size );"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=head2 Object construction"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "If your class inherits from Class::Tiny::Object (as it should if you followed"
NSQ_SOURCE_LINE 00000406 "the advice above), it provides the C<new> constructor for you."
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "Objects can be created with attributes given as a hash reference or as a list"
NSQ_SOURCE_LINE 00000409 "of key/value pairs:"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "    $obj = Foo::Bar->new( name => \"David\" );"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "    $obj = Foo::Bar->new( { name => \"David\" } );"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "If a reference is passed as a single argument, it must be able to be"
NSQ_SOURCE_LINE 00000416 "dereferenced as a hash or an exception is thrown."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "Unknown attributes in the constructor arguments will be ignored.  Prior to"
NSQ_SOURCE_LINE 00000419 "version 1.000, unknown attributes were an error, but this made it harder for"
NSQ_SOURCE_LINE 00000420 "people to cleanly subclass Class::Tiny classes so this feature was removed."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "You can define a C<BUILDARGS> method to change how arguments to new are"
NSQ_SOURCE_LINE 00000423 "handled.  It will receive the constructor arguments as they were provided and"
NSQ_SOURCE_LINE 00000424 "must return a hash reference of key/value pairs (or else throw an"
NSQ_SOURCE_LINE 00000425 "exception)."
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "    sub BUILDARGS {"
NSQ_SOURCE_LINE 00000428 "       my $class = shift;"
NSQ_SOURCE_LINE 00000429 "       my $name = shift || \"John Doe\";"
NSQ_SOURCE_LINE 00000430 "       return { name => $name };"
NSQ_SOURCE_LINE 00000431 "     };"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "     Foo::Bar->new( \"David\" );"
NSQ_SOURCE_LINE 00000434 "     Foo::Bar->new(); # \"John Doe\""
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "Unknown attributes returned from C<BUILDARGS> will be ignored."
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "=head2 BUILD"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "If your class or any superclass defines a C<BUILD> method, it will be called"
NSQ_SOURCE_LINE 00000441 "by the constructor from the furthest parent class down to the child class after"
NSQ_SOURCE_LINE 00000442 "the object has been created."
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "It is passed the constructor arguments as a hash reference.  The return value"
NSQ_SOURCE_LINE 00000445 "is ignored.  Use C<BUILD> for validation, checking required attributes or"
NSQ_SOURCE_LINE 00000446 "setting default values that depend on other attributes."
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "    sub BUILD {"
NSQ_SOURCE_LINE 00000449 "        my ($self, $args) = @_;"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "        for my $req ( qw/name age/ ) {"
NSQ_SOURCE_LINE 00000452 "            croak \"$req attribute required\" unless defined $self->$req;"
NSQ_SOURCE_LINE 00000453 "        }"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "        croak \"Age must be non-negative\" if $self->age < 0;"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "        $self->msg( \"Hello \" . $self->name );"
NSQ_SOURCE_LINE 00000458 "    }"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "The argument reference is a copy, so deleting elements won't affect data in the"
NSQ_SOURCE_LINE 00000461 "original (but changes will be passed to other BUILD methods in C<@ISA>)."
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "=head2 DEMOLISH"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "Class::Tiny provides a C<DESTROY> method.  If your class or any superclass"
NSQ_SOURCE_LINE 00000466 "defines a C<DEMOLISH> method, they will be called from the child class to the"
NSQ_SOURCE_LINE 00000467 "furthest parent class during object destruction.  It is provided a single"
NSQ_SOURCE_LINE 00000468 "boolean argument indicating whether Perl is in global destruction.  Return"
NSQ_SOURCE_LINE 00000469 "values are ignored.  Errors are caught and rethrown."
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "    sub DEMOLISH {"
NSQ_SOURCE_LINE 00000472 "        my ($self, $global_destruct) = @_;"
NSQ_SOURCE_LINE 00000473 "        $self->cleanup();"
NSQ_SOURCE_LINE 00000474 "    }"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "=head2 Introspection and internals"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "You can retrieve an unsorted list of valid attributes known to Class::Tiny"
NSQ_SOURCE_LINE 00000479 "for a class and its superclasses with the C<get_all_attributes_for> class"
NSQ_SOURCE_LINE 00000480 "method."
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "    my @attrs = Class::Tiny->get_all_attributes_for(\"Employee\");"
NSQ_SOURCE_LINE 00000483 "    # returns qw/name ssn timestamp/"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "Likewise, a hash reference of all valid attributes and default values (or code"
NSQ_SOURCE_LINE 00000486 "references) may be retrieved with the C<get_all_attribute_defaults_for> class"
NSQ_SOURCE_LINE 00000487 "method.  Any attributes without a default will be C<undef>."
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "    my $def = Class::Tiny->get_all_attribute_defaults_for(\"Employee\");"
NSQ_SOURCE_LINE 00000490 "    # returns {"
NSQ_SOURCE_LINE 00000491 "    #   name => undef,"
NSQ_SOURCE_LINE 00000492 "    #   ssn => undef"
NSQ_SOURCE_LINE 00000493 "    #   timestamp => $coderef"
NSQ_SOURCE_LINE 00000494 "    # }"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "The C<import> method uses two class methods, C<prepare_class> and"
NSQ_SOURCE_LINE 00000497 "C<create_attributes> to set up the C<@ISA> array and attributes.  Anyone"
NSQ_SOURCE_LINE 00000498 "attempting to extend Class::Tiny itself should use these instead of mocking up"
NSQ_SOURCE_LINE 00000499 "a call to C<import>."
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "When the first object is created, linearized C<@ISA>, the valid attribute list"
NSQ_SOURCE_LINE 00000502 "and various subroutine references are cached for speed.  Ensure that all"
NSQ_SOURCE_LINE 00000503 "inheritance and methods are in place before creating objects. (You don't want"
NSQ_SOURCE_LINE 00000504 "to be changing that once you create objects anyway, right?)"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "=for Pod::Coverage new get_all_attributes_for get_all_attribute_defaults_for"
NSQ_SOURCE_LINE 00000507 "prepare_class create_attributes"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=head1 RATIONALE"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=head2 Why this instead of Object::Tiny or Class::Accessor or something else?"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "I wanted something so simple that it could potentially be used by core Perl"
NSQ_SOURCE_LINE 00000514 "modules I help maintain (or hope to write), most of which either use"
NSQ_SOURCE_LINE 00000515 "L<Class::Struct> or roll-their-own OO framework each time."
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "L<Object::Tiny> and L<Object::Tiny::RW> were close to what I wanted, but"
NSQ_SOURCE_LINE 00000518 "lacking some features I deemed necessary, and their maintainers have an even"
NSQ_SOURCE_LINE 00000519 "more strict philosophy against feature creep than I have."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "I also considered L<Class::Accessor>, which has been around a long time and is"
NSQ_SOURCE_LINE 00000522 "heavily used, but it, too, lacked features I wanted and did things in ways I"
NSQ_SOURCE_LINE 00000523 "considered poor design."
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "I looked for something else on CPAN, but after checking a dozen class creators"
NSQ_SOURCE_LINE 00000526 "I realized I could implement exactly what I wanted faster than I could search"
NSQ_SOURCE_LINE 00000527 "CPAN for something merely sufficient."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "In general, compared to most things on CPAN (other than Object::Tiny),"
NSQ_SOURCE_LINE 00000530 "Class::Tiny is smaller in implementation and simpler in API."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "Specifically, here is how Class::Tiny (\"C::T\") compares to Object::Tiny"
NSQ_SOURCE_LINE 00000533 "(\"O::T\") and Class::Accessor (\"C::A\"):"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 " FEATURE                            C::T    O::T      C::A"
NSQ_SOURCE_LINE 00000536 " --------------------------------------------------------------"
NSQ_SOURCE_LINE 00000537 " attributes defined via import      yes     yes       no"
NSQ_SOURCE_LINE 00000538 " read/write accessors               yes     no        yes"
NSQ_SOURCE_LINE 00000539 " lazy attribute defaults            yes     no        no"
NSQ_SOURCE_LINE 00000540 " provides new                       yes     yes       yes"
NSQ_SOURCE_LINE 00000541 " provides DESTROY                   yes     no        no"
NSQ_SOURCE_LINE 00000542 " new takes either hashref or list   yes     no (list) no (hash)"
NSQ_SOURCE_LINE 00000543 " Moo(se)-like BUILD/DEMOLISH        yes     no        no"
NSQ_SOURCE_LINE 00000544 " Moo(se)-like BUILDARGS             yes     no        no"
NSQ_SOURCE_LINE 00000545 " no extraneous methods via @ISA     yes     yes       no"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "=head2 Why this instead of Moose or Moo?"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "L<Moose> and L<Moo> are both excellent OO frameworks.  Moose offers a powerful"
NSQ_SOURCE_LINE 00000550 "meta-object protocol (MOP), but is slow to start up and has about 30 non-core"
NSQ_SOURCE_LINE 00000551 "dependencies including XS modules.  Moo is faster to start up and has about 10"
NSQ_SOURCE_LINE 00000552 "pure Perl dependencies but provides no true MOP, relying instead on its ability"
NSQ_SOURCE_LINE 00000553 "to transparently upgrade Moo to Moose when Moose's full feature set is"
NSQ_SOURCE_LINE 00000554 "required."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "By contrast, Class::Tiny has no MOP and has B<zero> non-core dependencies for"
NSQ_SOURCE_LINE 00000557 "Perls in the L<support window|perlpolicy>.  It has far less code, less"
NSQ_SOURCE_LINE 00000558 "complexity and no learning curve. If you don't need or can't afford what Moo or"
NSQ_SOURCE_LINE 00000559 "Moose offer, this is intended to be a reasonable fallback."
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "That said, Class::Tiny offers Moose-like conventions for things like C<BUILD>"
NSQ_SOURCE_LINE 00000562 "and C<DEMOLISH> for some minimal interoperability and an easier upgrade path."
NSQ_SOURCE_LINE 00000563 ""
