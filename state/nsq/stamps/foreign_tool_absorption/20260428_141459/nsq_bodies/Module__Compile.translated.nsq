NSQ_SOURCE_LINE 00000045 "# All Module::Compile based modules inherit this import routine."
NSQ_SOURCE_LINE 00000046 "sub import {"
NSQ_SOURCE_LINE 00000047 "    my ($class) = @_;"
NSQ_SOURCE_LINE 00000048 "    return if $class->pmc_use_means_no;"
NSQ_SOURCE_LINE 00000049 "    goto &{$class->can('pmc_import')};"
NSQ_SOURCE_LINE 00000050 "}"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "# Treat unimport like import if use means no"
NSQ_SOURCE_LINE 00000053 "sub unimport {"
NSQ_SOURCE_LINE 00000054 "    my ($class) = @_;"
NSQ_SOURCE_LINE 00000055 "    return unless $class->pmc_use_means_no;"
