NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "sub pmc_import {"
NSQ_SOURCE_LINE 00000060 "    my ($class, @args) = @_;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    # Handler modules can do `use Module::Compile -base;`. Make them ISA"
NSQ_SOURCE_LINE 00000063 "    # Module::Compile and get the hell out of Dodge."
NSQ_SOURCE_LINE 00000064 "    $class->pmc_set_base(@args) and return;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    my ($module, $line) = (caller($class->pmc_caller_stack_frame))[1, 2];"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    return if $filtered->{$module}++;"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    my $callback = sub {"
NSQ_SOURCE_LINE 00000071 "        my ($class, $content, $data) = @_;"
NSQ_SOURCE_LINE 00000072 "        my $output = $class->pmc_template($module, $content, $data);"
NSQ_SOURCE_LINE 00000073 "        $class->pmc_output($module, $output);"
NSQ_SOURCE_LINE 00000074 "    };"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "    $class->pmc_check_compiled_file($module);"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "    $class->pmc_filter($module, $line, $callback);"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "    # Is there a meaningful return value here?"
NSQ_SOURCE_LINE 00000081 "    return;"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "# File might not be a module (.pm) and might be compiled already."
NSQ_SOURCE_LINE 00000085 "# If so, run the compiled file."
NSQ_SOURCE_LINE 00000086 "sub pmc_check_compiled_file {"
NSQ_SOURCE_LINE 00000087 "    my ($class, $file) = @_;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    if (defined $file and $file !~ /\\.pm$/i) {"
NSQ_SOURCE_LINE 00000090 "        # Do the freshness check ourselves"
NSQ_SOURCE_LINE 00000091 "        my $pmc = $file.'c';"
NSQ_SOURCE_LINE 00000092 "        $class->pmc_run_compiled_file($pmc), die"
NSQ_SOURCE_LINE 00000093 "          if -s $pmc and (-M $pmc <= -M $file);"
NSQ_SOURCE_LINE 00000094 "    }"
NSQ_SOURCE_LINE 00000095 "}"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "sub pmc_run_compiled_file {"
NSQ_SOURCE_LINE 00000098 "    my ($class, $pmc) = @_;"
NSQ_SOURCE_LINE 00000099 "    my ($package) = caller($class->pmc_file_caller_frame());"
NSQ_SOURCE_LINE 00000100 "    eval \"package $package; do \\$pmc\";"
NSQ_SOURCE_LINE 00000101 "    die $@ if $@;"
NSQ_SOURCE_LINE 00000102 "    exit 0;"
NSQ_SOURCE_LINE 00000103 "}"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "sub pmc_file_caller_frame { 2 }"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "# Set up inheritance"
NSQ_SOURCE_LINE 00000108 "sub pmc_set_base {"
NSQ_SOURCE_LINE 00000109 "    my ($class, $flag) = @_;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    # Handle the `use Module::Compile -base;` command."
NSQ_SOURCE_LINE 00000112 "    if ($class->isa(__PACKAGE__) and defined $flag and $flag eq '-base') {"
NSQ_SOURCE_LINE 00000113 "        my $descendant = (caller 1)[0];;"
NSQ_SOURCE_LINE 00000114 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000115 "        push @{$descendant . '::ISA'}, $class;"
NSQ_SOURCE_LINE 00000116 "        return 1;"
NSQ_SOURCE_LINE 00000117 "    }"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "    return 0;"
NSQ_SOURCE_LINE 00000120 "}"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "# Generate the actual code that will go into the .pmc file."
NSQ_SOURCE_LINE 00000123 "sub pmc_template {"
NSQ_SOURCE_LINE 00000124 "    my ($class, $module, $content, $data) = @_;"
NSQ_SOURCE_LINE 00000125 "    my $base = __PACKAGE__;"
NSQ_SOURCE_LINE 00000126 "    my $check = $class->freshness_check($module);"
NSQ_SOURCE_LINE 00000127 "    my $version = $class->VERSION || '0';"
NSQ_SOURCE_LINE 00000128 "    return join \"\\n\","
NSQ_SOURCE_LINE 00000129 "        \"# Generated by $class $version ($base $VERSION) - do not edit!\","
NSQ_SOURCE_LINE 00000130 "        \"$check$content$data\";"
NSQ_SOURCE_LINE 00000131 "}"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "# This returns a piece of Perl code to do a runtime check to see if the"
NSQ_SOURCE_LINE 00000134 "# .pmc file is fresh.  By default we use a 32-bit running checksum."
NSQ_SOURCE_LINE 00000135 "sub freshness_check {"
NSQ_SOURCE_LINE 00000136 "    my ($class, $module) = @_;"
NSQ_SOURCE_LINE 00000137 "    my $sum = sprintf('%08X', do {"
NSQ_SOURCE_LINE 00000138 "        local $/;"
NSQ_SOURCE_LINE 00000139 "        open my $fh, \"<\", $module"
NSQ_SOURCE_LINE 00000140 "          or die \"Cannot open $module: $!\";"
NSQ_SOURCE_LINE 00000141 "        binmode($fh, ':crlf'); # normalize CRLF for consistent checksum"
NSQ_SOURCE_LINE 00000142 "        unpack('%32N*', <$fh>);"
NSQ_SOURCE_LINE 00000143 "    });"
NSQ_SOURCE_LINE 00000144 "    return << \"...\";"
NSQ_SOURCE_LINE 00000145 "################((( 32-bit Checksum Validator III )))################"
NSQ_SOURCE_LINE 00000146 "#line 1"
NSQ_SOURCE_LINE 00000147 "BEGIN { use 5.006; local (*F, \\$/); (\\$F = __FILE__) =~ s!c\\$!!; open(F)"
NSQ_SOURCE_LINE 00000148 "or die \"Cannot open \\$F: \\$!\"; binmode(F, ':crlf'); if (unpack('%32N*',"
NSQ_SOURCE_LINE 00000149 "\\$F=readline(*F)) != 0x$sum) { use Filter::Util::Call; my \\$f = \\$F;"
NSQ_SOURCE_LINE 00000150 "filter_add(sub { filter_del(); 1 while &filter_read; \\$_ = \\$f; 1; })}}"
NSQ_SOURCE_LINE 00000151 "#line 1"
NSQ_SOURCE_LINE 00000152 "..."
NSQ_SOURCE_LINE 00000153 "}"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "# Write the output to the .pmc file"
NSQ_SOURCE_LINE 00000156 "sub pmc_output {"
NSQ_SOURCE_LINE 00000157 "    my ($class, $module, $output) = @_;"
NSQ_SOURCE_LINE 00000158 "    $class->pmc_can_output($module)"
NSQ_SOURCE_LINE 00000159 "      or return 0;"
NSQ_SOURCE_LINE 00000160 "    my $pmc = $module . 'c';"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    # If we can't open the file, just return. The filtering will not be cached,"
NSQ_SOURCE_LINE 00000163 "    # but that might be ok."
NSQ_SOURCE_LINE 00000164 "    open my $fh, \">\", $pmc"
NSQ_SOURCE_LINE 00000165 "      or return 0;"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    # Protect against disk full or whatever else."
NSQ_SOURCE_LINE 00000168 "    local $@;"
NSQ_SOURCE_LINE 00000169 "    eval {"
NSQ_SOURCE_LINE 00000170 "        print $fh $output"
NSQ_SOURCE_LINE 00000171 "           or die;"
NSQ_SOURCE_LINE 00000172 "        close $fh"
NSQ_SOURCE_LINE 00000173 "           or die;"
NSQ_SOURCE_LINE 00000174 "    };"
NSQ_SOURCE_LINE 00000175 "    if ( my $e = $@ ) {"
NSQ_SOURCE_LINE 00000176 "        # close $fh? die if unlink?"
NSQ_SOURCE_LINE 00000177 "        if ( -e $pmc ) {"
NSQ_SOURCE_LINE 00000178 "            unlink $pmc"
NSQ_SOURCE_LINE 00000179 "                or die \"Can't delete errant $pmc: $!\";"
NSQ_SOURCE_LINE 00000180 "        }"
NSQ_SOURCE_LINE 00000181 "        return 0;"
NSQ_SOURCE_LINE 00000182 "    }"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "    return 1;"
NSQ_SOURCE_LINE 00000185 "}"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "# Check whether output can be written."
NSQ_SOURCE_LINE 00000188 "sub pmc_can_output {"
NSQ_SOURCE_LINE 00000189 "    my ($class, $file_path) = @_;"
NSQ_SOURCE_LINE 00000190 "    return 1;"
NSQ_SOURCE_LINE 00000191 "#     return $file_path =~ /\\.pm$/;"
NSQ_SOURCE_LINE 00000192 "}"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "# We use a source filter to get all the code for compiling."
NSQ_SOURCE_LINE 00000195 "sub pmc_filter {"
NSQ_SOURCE_LINE 00000196 "    my ($class, $module, $line_number, $post_process) = @_;"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "    # Read original module source code instead of taking from filter,"
NSQ_SOURCE_LINE 00000199 "    # because we need all the lines including the ones before the `use`"
NSQ_SOURCE_LINE 00000200 "    # statement, so we can parse Perl into packages and such."
NSQ_SOURCE_LINE 00000201 "    open my $fh, $module"
NSQ_SOURCE_LINE 00000202 "        or die \"Can't open $module for input:\\n$!\";"
NSQ_SOURCE_LINE 00000203 "    my $module_content = do { local $/; <$fh> };"
NSQ_SOURCE_LINE 00000204 "    close $fh;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    # Find the real __DATA__ or __END__ line. (Not one hidden in a Pod"
NSQ_SOURCE_LINE 00000207 "    # section or heredoc)."
NSQ_SOURCE_LINE 00000208 "    my $folded_content = $class->pmc_fold_blocks($module_content);"
NSQ_SOURCE_LINE 00000209 "    my $folded_data = '';"
NSQ_SOURCE_LINE 00000210 "    if ($folded_content =~ s/^((?:__(?:DATA|END)__$).*)//ms) {"
NSQ_SOURCE_LINE 00000211 "        $folded_data = $1;"
NSQ_SOURCE_LINE 00000212 "    }"
NSQ_SOURCE_LINE 00000213 "    my $real_content = $class->pmc_unfold_blocks($folded_content);"
NSQ_SOURCE_LINE 00000214 "    my $real_data = $class->pmc_unfold_blocks($folded_data);"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    # Calculate the number of lines to skip in the source filter, since"
NSQ_SOURCE_LINE 00000217 "    # we already have them in $real_content."
NSQ_SOURCE_LINE 00000218 "    my @lines = ($real_content =~ /(.*\\n)/g);"
NSQ_SOURCE_LINE 00000219 "    my $lines_to_skip = @lines;"
NSQ_SOURCE_LINE 00000220 "    $lines_to_skip -= $line_number;"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "    # Use filter to skip past that many lines"
NSQ_SOURCE_LINE 00000223 "    # Leave __DATA__ section intact"
NSQ_SOURCE_LINE 00000224 "    my $done = 0;"
NSQ_SOURCE_LINE 00000225 "    require Filter::Util::Call;"
NSQ_SOURCE_LINE 00000226 "    Filter::Util::Call::filter_add(sub {"
NSQ_SOURCE_LINE 00000227 "        return 0 if $done;"
NSQ_SOURCE_LINE 00000228 "        my $data_line = '';"
NSQ_SOURCE_LINE 00000229 "        while (1) {"
NSQ_SOURCE_LINE 00000230 "            my $status = Filter::Util::Call::filter_read();"
NSQ_SOURCE_LINE 00000231 "            last unless $status;"
NSQ_SOURCE_LINE 00000232 "            return $status if $status < 0;"
NSQ_SOURCE_LINE 00000233 "            # Skip lines up to the DATA section."
NSQ_SOURCE_LINE 00000234 "            next if $lines_to_skip-- > 0;"
NSQ_SOURCE_LINE 00000235 "            if (/^__(?:END|DATA)__$/) {"
NSQ_SOURCE_LINE 00000236 "                # Don't filter the DATA section, or else the DATA file"
NSQ_SOURCE_LINE 00000237 "                # handle becomes invalid."
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "                # XXX - Maybe there is a way to simply recreate the DATA"
NSQ_SOURCE_LINE 00000240 "                # file handle, or at least seek back to the start of it."
NSQ_SOURCE_LINE 00000241 "                # Needs investigation."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "                # For now this means that we only allow compilation on"
NSQ_SOURCE_LINE 00000244 "                # the module content; not the DATA section. Because we"
NSQ_SOURCE_LINE 00000245 "                # want to make sure that the program runs the same way"
NSQ_SOURCE_LINE 00000246 "                # as both a .pm and a .pmc."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "                $data_line = $_;"
NSQ_SOURCE_LINE 00000249 "                last;"
NSQ_SOURCE_LINE 00000250 "            }"
NSQ_SOURCE_LINE 00000251 "        }"
NSQ_SOURCE_LINE 00000252 "        continue {"
NSQ_SOURCE_LINE 00000253 "            $_ = '';"
NSQ_SOURCE_LINE 00000254 "        }"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "        $real_content =~ s/\\r//g;"
NSQ_SOURCE_LINE 00000257 "        my $filtered_content = $class->pmc_process($real_content);"
NSQ_SOURCE_LINE 00000258 "        $class->$post_process($filtered_content, $real_data);"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "        $filtered_content =~ s/(.*\\n){$line_number}//;"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "        $_ = $filtered_content . $data_line;"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "        $done = 1;"
NSQ_SOURCE_LINE 00000265 "    });"
NSQ_SOURCE_LINE 00000266 "}"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "use constant TEXT => 0;"
NSQ_SOURCE_LINE 00000269 "use constant CONTEXT => 1;"
NSQ_SOURCE_LINE 00000270 "use constant CLASSES => 2;"
NSQ_SOURCE_LINE 00000271 "# Break the code into blocks. Compile the blocks."
NSQ_SOURCE_LINE 00000272 "# Fold out heredocs etc"
NSQ_SOURCE_LINE 00000273 "# Parse the code into packages, blocks and subs"
NSQ_SOURCE_LINE 00000274 "# Parse the code by `use/no *::Compiler`"
NSQ_SOURCE_LINE 00000275 "# Build an AST"
NSQ_SOURCE_LINE 00000276 "# Reduce the AST until fully reduced"
NSQ_SOURCE_LINE 00000277 "# Return the result"
NSQ_SOURCE_LINE 00000278 "sub pmc_process {"
NSQ_SOURCE_LINE 00000279 "    my $class = shift;"
NSQ_SOURCE_LINE 00000280 "    my $data = shift;"
NSQ_SOURCE_LINE 00000281 "    my @blocks = $class->pmc_parse_blocks($data);"
NSQ_SOURCE_LINE 00000282 "    while (@blocks = $class->pmc_reduce(@blocks)) {"
NSQ_SOURCE_LINE 00000283 "        if (@blocks == 1 and @{$blocks[0][CLASSES]} == 0) {"
NSQ_SOURCE_LINE 00000284 "            my $content = $blocks[0][TEXT];"
NSQ_SOURCE_LINE 00000285 "            $content .= \"\\n\" unless $content =~ /\\n\\z/;"
NSQ_SOURCE_LINE 00000286 "            return $content;"
NSQ_SOURCE_LINE 00000287 "        }"
NSQ_SOURCE_LINE 00000288 "    }"
NSQ_SOURCE_LINE 00000289 "    die \"How did I get here?!?\";"
NSQ_SOURCE_LINE 00000290 "}"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "# Analyze the remaining blocks and determine which compilers to call to reduce"
NSQ_SOURCE_LINE 00000293 "# the problem."
NSQ_SOURCE_LINE 00000294 "#"
NSQ_SOURCE_LINE 00000295 "# XXX This routine must do some kind of reduction each pass, or infinite loop"
NSQ_SOURCE_LINE 00000296 "# will ensue. It is not yet certain if this is the case."
NSQ_SOURCE_LINE 00000297 "sub pmc_reduce {"
NSQ_SOURCE_LINE 00000298 "    my $class = shift;"
NSQ_SOURCE_LINE 00000299 "    my @blocks;"
NSQ_SOURCE_LINE 00000300 "    my $prev;"
NSQ_SOURCE_LINE 00000301 "    while (@_) {"
NSQ_SOURCE_LINE 00000302 "        my $block = shift;"
NSQ_SOURCE_LINE 00000303 "        my $next = $_[TEXT];"
NSQ_SOURCE_LINE 00000304 "        if ($next and \"@{$block->[CLASSES]}\" eq \"@{$next->[CLASSES]}\") {"
NSQ_SOURCE_LINE 00000305 "            shift;"
NSQ_SOURCE_LINE 00000306 "            $block->[TEXT] .= $next->[TEXT];"
NSQ_SOURCE_LINE 00000307 "        }"
NSQ_SOURCE_LINE 00000308 "        elsif ("
NSQ_SOURCE_LINE 00000309 "            (not $prev or @{$prev->[CLASSES]} < @{$block->[CLASSES]}) and"
NSQ_SOURCE_LINE 00000310 "            (not $next or @{$next->[CLASSES]} < @{$block->[CLASSES]})"
NSQ_SOURCE_LINE 00000311 "        ) {"
NSQ_SOURCE_LINE 00000312 "            my $prev_len = $prev ? @{$prev->[CLASSES]} : 0;"
NSQ_SOURCE_LINE 00000313 "            my $next_len = $next ? @{$next->[CLASSES]} : 0;"
NSQ_SOURCE_LINE 00000314 "            my $offset = ($prev_len > $next_len) ? $prev_len : $next_len;"
NSQ_SOURCE_LINE 00000315 "            my $length = @{$block->[CLASSES]} - $offset;"
NSQ_SOURCE_LINE 00000316 "            $class->pmc_call($block, $offset, $length);"
NSQ_SOURCE_LINE 00000317 "        }"
NSQ_SOURCE_LINE 00000318 "        push @blocks, $block;"
NSQ_SOURCE_LINE 00000319 "        $prev = $block;"
NSQ_SOURCE_LINE 00000320 "    }"
NSQ_SOURCE_LINE 00000321 "    return @blocks;"
NSQ_SOURCE_LINE 00000322 "}"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "# Call a set of compilers on a piece of source code."
NSQ_SOURCE_LINE 00000325 "sub pmc_call {"
NSQ_SOURCE_LINE 00000326 "    my $class = shift;"
NSQ_SOURCE_LINE 00000327 "    my $block = shift;"
NSQ_SOURCE_LINE 00000328 "    my $offset = shift;"
NSQ_SOURCE_LINE 00000329 "    my $length = shift;"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "    my $text = $block->[TEXT];"
NSQ_SOURCE_LINE 00000332 "    my $context = $block->[CONTEXT];"
NSQ_SOURCE_LINE 00000333 "    my @classes = splice(@{$block->[CLASSES]}, $offset, $length);"
NSQ_SOURCE_LINE 00000334 "    for my $klass (@classes) {"
NSQ_SOURCE_LINE 00000335 "        local $_ = $text;"
NSQ_SOURCE_LINE 00000336 "        my $return = $klass->pmc_compile($text, ($context->{$klass} || {}));"
NSQ_SOURCE_LINE 00000337 "        $text = (defined $return and $return !~ /^\\d+\\z/)"
NSQ_SOURCE_LINE 00000338 "            ? $return"
NSQ_SOURCE_LINE 00000339 "            : $_;"
NSQ_SOURCE_LINE 00000340 "    }"
NSQ_SOURCE_LINE 00000341 "    $block->[TEXT] = $text;"
NSQ_SOURCE_LINE 00000342 "}"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "# Divide a Perl module into blocks. This code divides a module based on"
NSQ_SOURCE_LINE 00000345 "# lines that use/no a Module::Compile subclass."
NSQ_SOURCE_LINE 00000346 "sub pmc_parse_blocks {"
NSQ_SOURCE_LINE 00000347 "    my $class = shift;"
NSQ_SOURCE_LINE 00000348 "    my $data = shift;"
NSQ_SOURCE_LINE 00000349 "    my @blocks = ();"
NSQ_SOURCE_LINE 00000350 "    my @classes = ();"
NSQ_SOURCE_LINE 00000351 "    my $context = {};"
NSQ_SOURCE_LINE 00000352 "    my $text = '';"
NSQ_SOURCE_LINE 00000353 "    my @parts = split /^([^\\S\\n]*(?:use|no)[^\\S\\n]+[\\w\\:\\']+[^\\n]*\\n)/m, $data;"
NSQ_SOURCE_LINE 00000354 "    for my $part (@parts) {"
NSQ_SOURCE_LINE 00000355 "        if ($part =~ /^[^\\S\\n]*(use|no)[^\\S\\n]+([\\w\\:\\']+)[^\\n]*\\n/) {"
NSQ_SOURCE_LINE 00000356 "            my ($use, $klass, $file) = ($1, $2, $2);"
NSQ_SOURCE_LINE 00000357 "            $file =~ s{(?:::|')}{/}g;"
NSQ_SOURCE_LINE 00000358 "            if ($klass =~ /^\\d+$/) {"
NSQ_SOURCE_LINE 00000359 "                $text .= $part;"
NSQ_SOURCE_LINE 00000360 "                next;"
NSQ_SOURCE_LINE 00000361 "            }"
NSQ_SOURCE_LINE 00000362 "            {"
NSQ_SOURCE_LINE 00000363 "                local $@;"
NSQ_SOURCE_LINE 00000364 "                eval { require \"$file.pm\" };"
NSQ_SOURCE_LINE 00000365 "                die $@ if $@ and \"$@\" !~ /^Can't locate /;"
NSQ_SOURCE_LINE 00000366 "            }"
NSQ_SOURCE_LINE 00000367 "            if ($klass->can('pmc_is_compiler_module') and"
NSQ_SOURCE_LINE 00000368 "                $klass->pmc_is_compiler_module) {"
NSQ_SOURCE_LINE 00000369 "                push @blocks, [$text, {%$context}, [@classes]];"
NSQ_SOURCE_LINE 00000370 "                $text = '';"
NSQ_SOURCE_LINE 00000371 "                @classes = grep {$_ ne $klass} @classes;"
NSQ_SOURCE_LINE 00000372 "                if (($use eq 'use') xor $klass->pmc_use_means_no) {"
NSQ_SOURCE_LINE 00000373 "                    push @classes, $klass;"
NSQ_SOURCE_LINE 00000374 "                    $context->{$klass} = {%{$context->{$klass} || {}}};"
NSQ_SOURCE_LINE 00000375 "                    $context->{$klass}{use} = $part;"
NSQ_SOURCE_LINE 00000376 "                    if ($klass->pmc_use_means_now) {"
NSQ_SOURCE_LINE 00000377 "                        push @blocks, ['', {%$context}, [@classes]];"
NSQ_SOURCE_LINE 00000378 "                        @classes = grep {$_ ne $klass} @classes;"
NSQ_SOURCE_LINE 00000379 "                        delete $context->{$klass};"
NSQ_SOURCE_LINE 00000380 "                    }"
NSQ_SOURCE_LINE 00000381 "                }"
NSQ_SOURCE_LINE 00000382 "                else {"
NSQ_SOURCE_LINE 00000383 "                    delete $context->{$klass};"
NSQ_SOURCE_LINE 00000384 "                }"
NSQ_SOURCE_LINE 00000385 "            }"
NSQ_SOURCE_LINE 00000386 "            else {"
NSQ_SOURCE_LINE 00000387 "                $text .= $part;"
NSQ_SOURCE_LINE 00000388 "            }"
NSQ_SOURCE_LINE 00000389 "        }"
NSQ_SOURCE_LINE 00000390 "        else {"
NSQ_SOURCE_LINE 00000391 "            $text .= $part;"
NSQ_SOURCE_LINE 00000392 "        }"
NSQ_SOURCE_LINE 00000393 "    }"
NSQ_SOURCE_LINE 00000394 "    push @blocks, [$text, {%$context}, [@classes]]"
NSQ_SOURCE_LINE 00000395 "        if length $text;"
NSQ_SOURCE_LINE 00000396 "    return @blocks;"
NSQ_SOURCE_LINE 00000397 "}"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "# Compile/Filter some source code into something else. This is almost"
NSQ_SOURCE_LINE 00000400 "# always overridden in a subclass."
NSQ_SOURCE_LINE 00000401 "sub pmc_compile {"
NSQ_SOURCE_LINE 00000402 "    my ($class, $source_code_string, $context_hashref) = @_;"
NSQ_SOURCE_LINE 00000403 "    return $source_code_string;"
NSQ_SOURCE_LINE 00000404 "}"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "# Regexp fragments for matching heredoc, pod section, comment block and"
NSQ_SOURCE_LINE 00000407 "# data section."
NSQ_SOURCE_LINE 00000408 "my $re_here = qr/"
NSQ_SOURCE_LINE 00000409 "(?:                     # Heredoc starting line"
NSQ_SOURCE_LINE 00000410 "    ^                   # Start of some line"
NSQ_SOURCE_LINE 00000411 "    ((?-s:.*?))         # $2 - text before heredoc marker"
NSQ_SOURCE_LINE 00000412 "    <<(?!=)             # heredoc marker"
NSQ_SOURCE_LINE 00000413 "    [\\t\\x20]*           # whitespace between marker and quote"
NSQ_SOURCE_LINE 00000414 "    ((?>['\"]?))         # $3 - possible left quote"
NSQ_SOURCE_LINE 00000415 "    ([\\w\\-\\.]*)         # $4 - heredoc terminator"
NSQ_SOURCE_LINE 00000416 "    (\\3                 # $5 - possible right quote"
NSQ_SOURCE_LINE 00000417 "     (?-s:.*\\n))        #      and rest of the line"
NSQ_SOURCE_LINE 00000418 "    (.*?\\n)             # $6 - Heredoc content"
NSQ_SOURCE_LINE 00000419 "    (?<!\\n[0-9a-fA-F]{40}\\n)  # Not another digest"
NSQ_SOURCE_LINE 00000420 "    (\\4\\n)              # $7 - Heredoc terminating line"
NSQ_SOURCE_LINE 00000421 ")"
NSQ_SOURCE_LINE 00000422 "/xsm;"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "my $re_pod = qr/"
NSQ_SOURCE_LINE 00000425 "(?:"
NSQ_SOURCE_LINE 00000426 "    (?-s:^=(?!cut\\b)\\w+.*\\n)        # Pod starter line"
NSQ_SOURCE_LINE 00000427 "    .*?                             # Pod lines"
NSQ_SOURCE_LINE 00000428 "    (?:(?-s:^=cut\\b.*\\n)|\\z)        # Pod terminator"
NSQ_SOURCE_LINE 00000429 ")"
NSQ_SOURCE_LINE 00000430 "/xsm;"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "my $re_comment = qr/"
NSQ_SOURCE_LINE 00000433 "(?:"
NSQ_SOURCE_LINE 00000434 "    (?m-s:^[^\\S\\n]*\\#.*\\n)+           # one or more comment lines"
NSQ_SOURCE_LINE 00000435 ")"
NSQ_SOURCE_LINE 00000436 "/xsm;"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "my $re_data = qr/"
NSQ_SOURCE_LINE 00000439 "(?:"
NSQ_SOURCE_LINE 00000440 "    ^(?:__END__|__DATA__)\\n   # DATA starter line"
NSQ_SOURCE_LINE 00000441 "    .*                              # Rest of lines"
NSQ_SOURCE_LINE 00000442 ")"
NSQ_SOURCE_LINE 00000443 "/xsm;"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "# Fold each heredoc, pod section, comment block and data section, each"
NSQ_SOURCE_LINE 00000446 "# into a single line containing a digest of the original content."
NSQ_SOURCE_LINE 00000447 "#"
NSQ_SOURCE_LINE 00000448 "# This makes further dividing of Perl code less troublesome."
NSQ_SOURCE_LINE 00000449 "sub pmc_fold_blocks {"
NSQ_SOURCE_LINE 00000450 "    my ($class, $source) = @_;"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "    $source =~ s/(~{3,})/$1~/g;"
NSQ_SOURCE_LINE 00000453 "    $source =~ s/(^'{3,})/$1'/gm;"
NSQ_SOURCE_LINE 00000454 "    $source =~ s/(^`{3,})/$1`/gm;"
NSQ_SOURCE_LINE 00000455 "    $source =~ s/(^={3,})/$1=/gm;"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "    while (1) {"
NSQ_SOURCE_LINE 00000458 "        no warnings;"
NSQ_SOURCE_LINE 00000459 "        $source =~ s/"
NSQ_SOURCE_LINE 00000460 "            ("
NSQ_SOURCE_LINE 00000461 "                $re_pod |"
NSQ_SOURCE_LINE 00000462 "                $re_comment |"
NSQ_SOURCE_LINE 00000463 "                $re_here |"
NSQ_SOURCE_LINE 00000464 "                $re_data"
NSQ_SOURCE_LINE 00000465 "            )"
NSQ_SOURCE_LINE 00000466 "        /"
NSQ_SOURCE_LINE 00000467 "            my $result = $1;"
NSQ_SOURCE_LINE 00000468 "            $result =~ m{\\A($re_data)}    ? $class->pmc_fold_data()    :"
NSQ_SOURCE_LINE 00000469 "            $result =~ m{\\A($re_pod)}     ? $class->pmc_fold_pod()     :"
NSQ_SOURCE_LINE 00000470 "            $result =~ m{\\A($re_comment)} ? $class->pmc_fold_comment() :"
NSQ_SOURCE_LINE 00000471 "            $result =~ m{\\A($re_here)}    ? $class->pmc_fold_here()    :"
NSQ_SOURCE_LINE 00000472 "                die \"'$result' didn't match '$re_comment'\";"
NSQ_SOURCE_LINE 00000473 "        /ex or last;"
NSQ_SOURCE_LINE 00000474 "    }"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "    $source =~ s/(?<!~)~~~(?!~)/<</g;"
NSQ_SOURCE_LINE 00000477 "    $source =~ s/^'''(?!') /__DATA__\\n/gm;"
NSQ_SOURCE_LINE 00000478 "    $source =~ s/^```(?!`)/#/gm;"
NSQ_SOURCE_LINE 00000479 "    $source =~ s/^===(?!=)/=/gm;"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "    $source =~ s/^(={3,})=/$1/gm;"
NSQ_SOURCE_LINE 00000482 "    $source =~ s/^('{3,})'/$1/gm;"
NSQ_SOURCE_LINE 00000483 "    $source =~ s/^(`{3,})`/$1/gm;"
NSQ_SOURCE_LINE 00000484 "    $source =~ s/(~{3,})~/$1/g;"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "    return $source;"
NSQ_SOURCE_LINE 00000487 "}"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "sub pmc_unfold_blocks {"
NSQ_SOURCE_LINE 00000490 "    my ($class, $source) = @_;"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "    $source =~ s/"
NSQ_SOURCE_LINE 00000493 "        ("
NSQ_SOURCE_LINE 00000494 "            ^__DATA__\\n[0-9a-fA-F]{40}\\n"
NSQ_SOURCE_LINE 00000495 "        |"
NSQ_SOURCE_LINE 00000496 "            ^=pod\\s[0-9a-fA-F]{40}\\n=cut\\n"
NSQ_SOURCE_LINE 00000497 "        )"
NSQ_SOURCE_LINE 00000498 "    /"
NSQ_SOURCE_LINE 00000499 "        my $match = $1;"
NSQ_SOURCE_LINE 00000500 "        $match =~ s!.*?([0-9a-fA-F]{40}).*!$1!s or die;"
NSQ_SOURCE_LINE 00000501 "        $digest_map->{$match}"
NSQ_SOURCE_LINE 00000502 "    /xmeg;"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "    return $source;"
NSQ_SOURCE_LINE 00000505 "}"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "# Fold a heredoc's content but don't fold other heredocs from the"
NSQ_SOURCE_LINE 00000508 "# same line."
NSQ_SOURCE_LINE 00000509 "sub pmc_fold_here {"
NSQ_SOURCE_LINE 00000510 "    my $class = shift;"
NSQ_SOURCE_LINE 00000511 "    my $result = \"$2~~~$3$4$5\";"
NSQ_SOURCE_LINE 00000512 "    my $preface = '';"
NSQ_SOURCE_LINE 00000513 "    my $text = $6;"
NSQ_SOURCE_LINE 00000514 "    my $stop = $7;"
NSQ_SOURCE_LINE 00000515 "    while (1) {"
NSQ_SOURCE_LINE 00000516 "        if ($text =~ s!^(([0-9a-fA-F]{40})\\n.*\\n)!!) {"
NSQ_SOURCE_LINE 00000517 "            if (defined $digest_map->{$2}) {"
NSQ_SOURCE_LINE 00000518 "                $preface .= $1;"
NSQ_SOURCE_LINE 00000519 "                next;"
NSQ_SOURCE_LINE 00000520 "            }"
NSQ_SOURCE_LINE 00000521 "            else {"
NSQ_SOURCE_LINE 00000522 "                $text = $1 . $text;"
NSQ_SOURCE_LINE 00000523 "                last;"
NSQ_SOURCE_LINE 00000524 "            }"
NSQ_SOURCE_LINE 00000525 "        }"
NSQ_SOURCE_LINE 00000526 "        last;"
NSQ_SOURCE_LINE 00000527 "    }"
NSQ_SOURCE_LINE 00000528 "    my $digest = $class->pmc_fold($text);"
NSQ_SOURCE_LINE 00000529 "    $result = \"$result$preface$digest\\n$stop\";"
NSQ_SOURCE_LINE 00000530 "    $result;"
NSQ_SOURCE_LINE 00000531 "}"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "sub pmc_fold_pod {"
NSQ_SOURCE_LINE 00000534 "    my $class = shift;"
NSQ_SOURCE_LINE 00000535 "    my $text = $1;"
NSQ_SOURCE_LINE 00000536 "    my $digest = $class->pmc_fold($text);"
NSQ_SOURCE_LINE 00000537 "    return qq{===pod $digest\\n===cut\\n};"
NSQ_SOURCE_LINE 00000538 "}"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "sub pmc_fold_comment {"
NSQ_SOURCE_LINE 00000541 "    my $class = shift;"
NSQ_SOURCE_LINE 00000542 "    my $text = $1;"
NSQ_SOURCE_LINE 00000543 "    my $digest = $class->pmc_fold($text);"
NSQ_SOURCE_LINE 00000544 "    return qq{``` $digest\\n};"
NSQ_SOURCE_LINE 00000545 "}"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "sub pmc_fold_data {"
NSQ_SOURCE_LINE 00000548 "    my $class = shift;"
NSQ_SOURCE_LINE 00000549 "    my $text = $1;"
NSQ_SOURCE_LINE 00000550 "    my $digest = $class->pmc_fold($text);"
NSQ_SOURCE_LINE 00000551 "    return qq{''' $digest\\n};"
NSQ_SOURCE_LINE 00000552 "}"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "# Fold a piece of code into a unique string."
NSQ_SOURCE_LINE 00000555 "sub pmc_fold {"
NSQ_SOURCE_LINE 00000556 "    require Digest::SHA1;"
NSQ_SOURCE_LINE 00000557 "    my ($class, $text) = @_;"
NSQ_SOURCE_LINE 00000558 "    my $digest = Digest::SHA1::sha1_hex($text);"
NSQ_SOURCE_LINE 00000559 "    $digest_map->{$digest} = $text;"
NSQ_SOURCE_LINE 00000560 "    return $digest;"
NSQ_SOURCE_LINE 00000561 "}"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "# Expand folded code into original content."
NSQ_SOURCE_LINE 00000564 "sub pmc_unfold {"
NSQ_SOURCE_LINE 00000565 "    my ($class, $digest) = @_;"
NSQ_SOURCE_LINE 00000566 "    return $digest_map->{$digest};"
NSQ_SOURCE_LINE 00000567 "}"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "1;"
BODY_END
