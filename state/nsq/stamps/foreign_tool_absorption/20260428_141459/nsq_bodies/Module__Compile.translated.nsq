NSQ_SOURCE_LINE 00000006 "use strict; use warnings;"
NSQ_SOURCE_LINE 00000007 "package Module::Compile;"
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.38';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Digest::SHA1();"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "# A lexical hash to keep track of which files have already been filtered"
NSQ_SOURCE_LINE 00000013 "my $filtered = {};"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "# A map of digests to code blocks"
NSQ_SOURCE_LINE 00000016 "my $digest_map = {};"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "# All subroutines are prefixed with pmc_ so subclasses don't"
NSQ_SOURCE_LINE 00000019 "# accidentally override things they didn't intend to."
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "# Determine which stack frame points to the code we are filtering."
NSQ_SOURCE_LINE 00000022 "# This is a method in case it needs to be overridden."
NSQ_SOURCE_LINE 00000023 "sub pmc_caller_stack_frame { 0 };"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "# This is called while parsing source code to determine if the"
NSQ_SOURCE_LINE 00000026 "# module/class in a use/no line is part of the Module::Compile game."
NSQ_SOURCE_LINE 00000027 "#"
NSQ_SOURCE_LINE 00000028 "# Return true if this class supports PMC compilation."
NSQ_SOURCE_LINE 00000029 "#"
NSQ_SOURCE_LINE 00000030 "# The hope is that this will allow interoperability with modules that"
NSQ_SOURCE_LINE 00000031 "# do not inherit from Module::Compile but still want to do this sort"
