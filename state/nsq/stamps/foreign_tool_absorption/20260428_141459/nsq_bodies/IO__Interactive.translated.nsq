BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use 5.008;"
NSQ_SOURCE_LINE 00000002 "package IO::Interactive;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "$IO::Interactive::VERSION = '1.027';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "sub is_interactive {"
NSQ_SOURCE_LINE 00000010 "    my ($out_handle) = (@_, select);    # Default to default output handle"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "    # Not interactive if output is not to terminal..."
NSQ_SOURCE_LINE 00000013 "    return 0 if not -t $out_handle;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "    # If *ARGV is opened, we're interactive if..."
NSQ_SOURCE_LINE 00000016 "    if ( tied(*ARGV) or defined(fileno(ARGV)) ) { # this is what 'Scalar::Util::openhandle *ARGV' boils down to"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "        # ...it's currently opened to the magic '-' file"
NSQ_SOURCE_LINE 00000019 "        return -t *STDIN if defined $ARGV && $ARGV eq '-';"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "        # ...it's at end-of-file and the next file is the magic '-' file"
NSQ_SOURCE_LINE 00000022 "        return @ARGV>0 && $ARGV[0] eq '-' && -t *STDIN if eof *ARGV;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "        # ...it's directly attached to the terminal"
NSQ_SOURCE_LINE 00000025 "        return -t *ARGV;"
NSQ_SOURCE_LINE 00000026 "    }"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    # If *ARGV isn't opened, it will be interactive if *STDIN is attached"
NSQ_SOURCE_LINE 00000029 "    # to a terminal."
NSQ_SOURCE_LINE 00000030 "    else {"
NSQ_SOURCE_LINE 00000031 "        return -t *STDIN;"
NSQ_SOURCE_LINE 00000032 "    }"
NSQ_SOURCE_LINE 00000033 "}"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "local (*DEV_NULL, *DEV_NULL2);"
NSQ_SOURCE_LINE 00000036 "my $dev_null;"
NSQ_SOURCE_LINE 00000037 "BEGIN {"
NSQ_SOURCE_LINE 00000038 "    pipe *DEV_NULL, *DEV_NULL2"
NSQ_SOURCE_LINE 00000039 "        or die \"Internal error: can't create null filehandle\";"
NSQ_SOURCE_LINE 00000040 "    $dev_null = \\*DEV_NULL;"
NSQ_SOURCE_LINE 00000041 "}"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "sub interactive {"
NSQ_SOURCE_LINE 00000044 "    my ($out_handle) = (@_, \\*STDOUT);      # Default to STDOUT"
NSQ_SOURCE_LINE 00000045 "    return &is_interactive ? $out_handle : $dev_null;"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub _input_pending_on {"
NSQ_SOURCE_LINE 00000049 "    my ($fh) = @_;"
NSQ_SOURCE_LINE 00000050 "    my $read_bits = \"\";"
NSQ_SOURCE_LINE 00000051 "    my $bit = fileno($fh);"
NSQ_SOURCE_LINE 00000052 "    return if $bit < 0;"
NSQ_SOURCE_LINE 00000053 "    vec($read_bits, fileno($fh), 1) = 1;"
NSQ_SOURCE_LINE 00000054 "    select $read_bits, undef, undef, 0.1;"
NSQ_SOURCE_LINE 00000055 "    return $read_bits;"
NSQ_SOURCE_LINE 00000056 "}"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "sub busy (&) {"
NSQ_SOURCE_LINE 00000059 "    my ($block_ref) = @_;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    # Non-interactive busy-ness is easy...just do it"
NSQ_SOURCE_LINE 00000062 "    if (!is_interactive()) {"
NSQ_SOURCE_LINE 00000063 "        $block_ref->();"
NSQ_SOURCE_LINE 00000064 "        open my $fh, '<', \\ \"\";"
NSQ_SOURCE_LINE 00000065 "        return $fh;"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    # Otherwise fork off an interceptor process..."
NSQ_SOURCE_LINE 00000069 "    my ($read, $write);"
NSQ_SOURCE_LINE 00000070 "    pipe $read, $write;"
NSQ_SOURCE_LINE 00000071 "    my $child = fork;"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    # Within that interceptor process..."
NSQ_SOURCE_LINE 00000074 "    if (!$child) {"
NSQ_SOURCE_LINE 00000075 "        # Prepare to send back any intercepted input..."
NSQ_SOURCE_LINE 00000076 "        use IO::Handle;"
NSQ_SOURCE_LINE 00000077 "        close $read;"
NSQ_SOURCE_LINE 00000078 "        $write->autoflush(1);"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "        # Intercept that input..."
NSQ_SOURCE_LINE 00000081 "        while (1) {"
NSQ_SOURCE_LINE 00000082 "            if (_input_pending_on(\\*ARGV)) {"
NSQ_SOURCE_LINE 00000083 "                # Read it..."
NSQ_SOURCE_LINE 00000084 "                my $res = <ARGV>;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "                # Send it back to the parent..."
NSQ_SOURCE_LINE 00000087 "                print {$write} $res;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "                # Admonish them for not waiting..."
NSQ_SOURCE_LINE 00000090 "                print {*STDERR} \"That input was ignored. \","
NSQ_SOURCE_LINE 00000091 "                                \"Please don't press any keys yet.\\n\";"
NSQ_SOURCE_LINE 00000092 "            }"
NSQ_SOURCE_LINE 00000093 "        }"
NSQ_SOURCE_LINE 00000094 "        exit;"
NSQ_SOURCE_LINE 00000095 "    }"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    # Meanwhile, back in the parent..."
NSQ_SOURCE_LINE 00000098 "    close $write;"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    # Temporarily close the input..."
NSQ_SOURCE_LINE 00000101 "    local *ARGV;"
NSQ_SOURCE_LINE 00000102 "    open *ARGV, '<', \\ \"\";"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    # Do the job..."
NSQ_SOURCE_LINE 00000105 "    $block_ref->();"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    # Take down the interceptor..."
NSQ_SOURCE_LINE 00000108 "    kill 9, $child;"
NSQ_SOURCE_LINE 00000109 "    wait;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    # Return whatever the interceptor caught..."
NSQ_SOURCE_LINE 00000112 "    return $read;"
NSQ_SOURCE_LINE 00000113 "}"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "sub import {"
NSQ_SOURCE_LINE 00000116 "    my ($package) = shift;"
NSQ_SOURCE_LINE 00000117 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "    # Export each sub if it's requested..."
NSQ_SOURCE_LINE 00000120 "    for my $request ( @_ ) {"
NSQ_SOURCE_LINE 00000121 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000122 "        my $impl = *{$package.'::'.$request}{CODE};"
NSQ_SOURCE_LINE 00000123 "        if(!$impl || $request =~ m/\\A _/xms) {"
NSQ_SOURCE_LINE 00000124 "            require Carp;"
NSQ_SOURCE_LINE 00000125 "            Carp::croak(\"Unknown subroutine ($request()) requested\");"
NSQ_SOURCE_LINE 00000126 "        }"
NSQ_SOURCE_LINE 00000127 "        *{$caller.'::'.$request} = $impl;"
NSQ_SOURCE_LINE 00000128 "    }"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "1; # Magic true value required at end of module"
NSQ_SOURCE_LINE 00000132 "__END__"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=encoding utf8"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head1 NAME"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "IO::Interactive - Utilities for interactive I/O"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=head1 VERSION"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "This document describes IO::Interactive version 1.02"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    use IO::Interactive qw(is_interactive interactive busy);"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    if ( is_interactive() ) {"
NSQ_SOURCE_LINE 00000149 "        print \"Running interactively\\n\";"
NSQ_SOURCE_LINE 00000150 "    }"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    # or..."
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    print {interactive} \"Running interactively\\n\";"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    $fh = busy {"
NSQ_SOURCE_LINE 00000158 "        do_noninteractive_stuff();"
NSQ_SOURCE_LINE 00000159 "    }"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "This module provides three utility subroutines that make it easier to"
NSQ_SOURCE_LINE 00000165 "develop interactive applications."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "The C<ARGV> filehandle, the one that C<< <> >> or an empty"
NSQ_SOURCE_LINE 00000168 "C<readline()> uses, has various magic associated with it. It's not"
NSQ_SOURCE_LINE 00000169 "actually opened until you try to read from it. Checking C<-t ARGV>"
NSQ_SOURCE_LINE 00000170 "before you've tried to read from it might give you the wrong answer."
NSQ_SOURCE_LINE 00000171 "Not only that, you might not read from C<ARGV>. If the value in"
NSQ_SOURCE_LINE 00000172 "C<@ARGV> is the magic filename C<-> (a convention to mean the standard"
NSQ_SOURCE_LINE 00000173 "filehandle for input or output), C<ARGV> might actually be C<STDIN>."
NSQ_SOURCE_LINE 00000174 "You don't want to think about all of this. This module is discussed in"
NSQ_SOURCE_LINE 00000175 "I<Perl Best Practices> on page 218. Also see the C<ARGV> entry in"
NSQ_SOURCE_LINE 00000176 "L<perlvar> and the C<readline> entry in L<perlfunc>."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=over"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=item C<is_interactive()>"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "This subroutine returns true if C<*ARGV> and the currently selected"
NSQ_SOURCE_LINE 00000183 "filehandle (usually C<*STDOUT>) are connected to the terminal. The"
NSQ_SOURCE_LINE 00000184 "test is considerably more sophisticated than:"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "    -t *ARGV && -t *STDOUT"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "as it takes into account the magic behaviour of C<*ARGV>."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "You can also pass C<is_interactive> a writable filehandle, in which"
NSQ_SOURCE_LINE 00000191 "case it requires that filehandle be connected to a terminal (instead"
NSQ_SOURCE_LINE 00000192 "of the currently selected). The usual suspect here is C<*STDERR>:"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    if ( is_interactive(*STDERR) ) {"
NSQ_SOURCE_LINE 00000195 "        carp $warning;"
NSQ_SOURCE_LINE 00000196 "    }"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "Note that C<is_interactive> may return true in a Windows Scheduled"
NSQ_SOURCE_LINE 00000199 "Task. See Github #6 (https://github.com/briandfoy/io-interactive/issues/6)."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=item C<interactive()>"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "This subroutine returns C<*STDOUT> if C<is_interactive> is true. If"
NSQ_SOURCE_LINE 00000204 "C<is_interactive()> is false, C<interactive> returns a filehandle that"
NSQ_SOURCE_LINE 00000205 "does not print."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "This makes it easy to create applications that print out only when the"
NSQ_SOURCE_LINE 00000208 "application is interactive:"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    print {interactive} \"Please enter a value: \";"
NSQ_SOURCE_LINE 00000211 "    my $value = <>;"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "You can also pass C<interactive> a writable filehandle, in which case it"
NSQ_SOURCE_LINE 00000214 "writes to that filehandle if it is connected to a terminal (instead of"
NSQ_SOURCE_LINE 00000215 "writing to C<*STDOUT>). Once again, the usual suspect is C<*STDERR>:"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "    print {interactive(*STDERR)} $warning;"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=item C<busy {...}>"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "This subroutine takes a block as its single argument and executes that block."
NSQ_SOURCE_LINE 00000222 "Whilst the block is executed, C<*ARGV> is temporarily replaced by a closed"
NSQ_SOURCE_LINE 00000223 "filehandle. That is, no input from C<*ARGV> is possible in a C<busy> block."
NSQ_SOURCE_LINE 00000224 "Furthermore, any attempts to send input into the C<busy> block through"
NSQ_SOURCE_LINE 00000225 "C<*ARGV> is intercepted and a warning message is printed to C<*STDERR>."
NSQ_SOURCE_LINE 00000226 "The C<busy> call returns a filehandle that contains the intercepted input."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "A C<busy> block is therefore useful to prevent attempts at input when the"
NSQ_SOURCE_LINE 00000229 "program is busy at some non-interactive task."
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=back"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=head1 DIAGNOSTICS"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=over"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=item Unknown subroutine (%s) requested"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "This module only exports the three subroutines described above."
NSQ_SOURCE_LINE 00000240 "You asked for something else. Maybe you misspelled the subroutine you wanted."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=back"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head1 CONFIGURATION AND ENVIRONMENT"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "IO::Interactive requires no configuration files or environment variables."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=head1 DEPENDENCIES"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "This module requires the C<openhandle()> subroutine from the"
NSQ_SOURCE_LINE 00000251 "Scalar::Util module."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=head1 INCOMPATIBILITIES"
