NSQ_SOURCE_LINE 00000023 "=head1 NAME"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "HTML::Entities::Interpolate - Call HTML::Entities::encode_entities, via a hash, within a string"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "=head1 Synopsis"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "This is scripts/synopsis.pl:"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "\t#!/usr/bin/env perl"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "\tuse strict;"
NSQ_SOURCE_LINE 00000034 "\tuse warnings;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "\tuse HTML::Entities::Interpolate;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "\t# ------------------------------"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "\tmy($block_1) = '<p>Para One</p>';"
NSQ_SOURCE_LINE 00000041 "\tmy($block_2) = \"<p align='center'>Para Two</p>\";"
NSQ_SOURCE_LINE 00000042 "\tmy($block_3) = 'http://tipjar.com/bin/test?foo=bar&reg=inald';"
NSQ_SOURCE_LINE 00000043 "\tmy($block_4) = $Entitize{$block_3};"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "\tprint <<EOS;"
NSQ_SOURCE_LINE 00000046 "\t<html>"
NSQ_SOURCE_LINE 00000047 "\t\t<head>"
NSQ_SOURCE_LINE 00000048 "\t\t\t<title>Test HTML::Entities::Interpolate</title>"
NSQ_SOURCE_LINE 00000049 "\t\t</head>"
NSQ_SOURCE_LINE 00000050 "\t\t<body>"
NSQ_SOURCE_LINE 00000051 "\t\t\t<h1 align='center'>HTML::Entities::Interpolate</h1>"
NSQ_SOURCE_LINE 00000052 "\t\t\t<form action='#'>"
NSQ_SOURCE_LINE 00000053 "\t\t\t<table align='center'>"
NSQ_SOURCE_LINE 00000054 "\t\t\t<tr>"
NSQ_SOURCE_LINE 00000055 "\t\t\t\t<td align='center'>Input: <input name='data' value='$Entitize{$block_1}'></td>"
NSQ_SOURCE_LINE 00000056 "\t\t\t</tr>"
NSQ_SOURCE_LINE 00000057 "\t\t\t<tr>"
NSQ_SOURCE_LINE 00000058 "\t\t\t\t<td align='center'><br>The full text of the block is <pre>$Entitize{$block_2}</pre></td>"
NSQ_SOURCE_LINE 00000059 "\t\t\t</tr>"
NSQ_SOURCE_LINE 00000060 "\t\t\t<tr>"
NSQ_SOURCE_LINE 00000061 "\t\t\t\t<td align='center'><br>Check out the web page at: <a href='$block_3'>$block_4</a></td>"
NSQ_SOURCE_LINE 00000062 "\t\t\t</tr>"
NSQ_SOURCE_LINE 00000063 "\t\t\t</table>"
NSQ_SOURCE_LINE 00000064 "\t\t\t</form>"
NSQ_SOURCE_LINE 00000065 "\t\t</body>"
NSQ_SOURCE_LINE 00000066 "\t</html>"
NSQ_SOURCE_LINE 00000067 "\tEOS"
