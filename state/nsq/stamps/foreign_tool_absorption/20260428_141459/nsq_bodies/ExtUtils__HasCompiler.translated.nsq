NSQ_SOURCE_LINE 00000001 "package ExtUtils::HasCompiler;"
NSQ_SOURCE_LINE 00000002 "$ExtUtils::HasCompiler::VERSION = '0.025';"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000007 "our @EXPORT_OK = qw/can_compile_loadable_object can_compile_static_library can_compile_extension/;"
NSQ_SOURCE_LINE 00000008 "our %EXPORT_TAGS = (all => \\@EXPORT_OK);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Config;"
NSQ_SOURCE_LINE 00000011 "use Carp 'carp';"
NSQ_SOURCE_LINE 00000012 "use File::Basename 'basename';"
NSQ_SOURCE_LINE 00000013 "use File::Spec::Functions qw/catfile catdir rel2abs curdir/;"
NSQ_SOURCE_LINE 00000014 "use File::Temp qw/tempdir tempfile/;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "my $tempdir = tempdir('HASCOMPILERXXXX', CLEANUP => 1, DIR => rel2abs(curdir));"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "my $loadable_object_format = <<'END';"
NSQ_SOURCE_LINE 00000019 "#define PERL_NO_GET_CONTEXT"
NSQ_SOURCE_LINE 00000020 "#include \"EXTERN.h\""
NSQ_SOURCE_LINE 00000021 "#include \"perl.h\""
NSQ_SOURCE_LINE 00000022 "#include \"XSUB.h\""
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "#ifndef PERL_UNUSED_VAR"
NSQ_SOURCE_LINE 00000025 "#define PERL_UNUSED_VAR(var)"
NSQ_SOURCE_LINE 00000026 "#endif"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "XS(exported) {"
NSQ_SOURCE_LINE 00000029 "#ifdef dVAR"
NSQ_SOURCE_LINE 00000030 "\tdVAR;"
NSQ_SOURCE_LINE 00000031 "#endif"
NSQ_SOURCE_LINE 00000032 "\tdXSARGS;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "\tPERL_UNUSED_VAR(cv); /* -W */"
NSQ_SOURCE_LINE 00000035 "\tPERL_UNUSED_VAR(items); /* -W */"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "\tXSRETURN_IV(42);"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "#ifndef XS_EXTERNAL"
NSQ_SOURCE_LINE 00000041 "#define XS_EXTERNAL(foo) XS(foo)"
NSQ_SOURCE_LINE 00000042 "#endif"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "/* we don't want to mess with .def files on mingw */"
NSQ_SOURCE_LINE 00000045 "#if defined(WIN32) && defined(__GNUC__)"
NSQ_SOURCE_LINE 00000046 "#  define EXPORT __declspec(dllexport)"
NSQ_SOURCE_LINE 00000047 "#else"
NSQ_SOURCE_LINE 00000048 "#  define EXPORT"
NSQ_SOURCE_LINE 00000049 "#endif"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "EXPORT XS_EXTERNAL(boot_%s) {"
NSQ_SOURCE_LINE 00000052 "#ifdef dVAR"
NSQ_SOURCE_LINE 00000053 "\tdVAR;"
NSQ_SOURCE_LINE 00000054 "#endif"
NSQ_SOURCE_LINE 00000055 "\tdXSARGS;"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "\tPERL_UNUSED_VAR(cv); /* -W */"
NSQ_SOURCE_LINE 00000058 "\tPERL_UNUSED_VAR(items); /* -W */"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "\tnewXS(\"%s::exported\", exported, __FILE__);"
NSQ_SOURCE_LINE 00000061 "}"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "END"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "my $counter = 1;"
NSQ_SOURCE_LINE 00000066 "my %prelinking = map { $_ => 1 } qw/MSWin32 VMS aix/;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "sub can_compile_loadable_object {"
NSQ_SOURCE_LINE 00000069 "\tmy %args = @_;"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "\tmy $output = $args{output} || \\*STDOUT;"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "\tmy $config = $args{config} || 'ExtUtils::HasCompiler::Config';"
NSQ_SOURCE_LINE 00000074 "\treturn if not $config->get('usedl');"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "\tmy ($source_handle, $source_name) = tempfile('TESTXXXX', DIR => $tempdir, SUFFIX => '.c', UNLINK => 1);"
NSQ_SOURCE_LINE 00000077 "\tmy $basename = basename($source_name, '.c');"
NSQ_SOURCE_LINE 00000078 "\tmy $abs_basename = catfile($tempdir, $basename);"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "\tmy ($cc, $ccflags, $optimize, $cccdlflags, $ld, $ldflags, $lddlflags, $libperl, $perllibs, $archlibexp, $_o, $dlext) = map { $config->get($_) } qw/cc ccflags optimize cccdlflags ld ldflags lddlflags libperl perllibs archlibexp _o dlext/;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "\tmy $incdir = catdir($archlibexp, 'CORE');"
NSQ_SOURCE_LINE 00000083 "\tmy $object_file = $abs_basename.$_o;"
NSQ_SOURCE_LINE 00000084 "\tmy $loadable_object = \"$abs_basename.$dlext\";"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "\tmy @commands;"
NSQ_SOURCE_LINE 00000087 "\tif ($^O eq 'MSWin32' && $cc =~ /^cl/) {"
NSQ_SOURCE_LINE 00000088 "\t\tpush @commands, qq{$cc $ccflags $cccdlflags $optimize /I \"$incdir\" /c $source_name /Fo$object_file};"
NSQ_SOURCE_LINE 00000089 "\t\tpush @commands, qq{$ld $object_file $lddlflags $libperl $perllibs /out:$loadable_object /def:$abs_basename.def /pdb:$abs_basename.pdb};"
NSQ_SOURCE_LINE 00000090 "\t}"
NSQ_SOURCE_LINE 00000091 "\telsif ($^O eq 'VMS') {"
NSQ_SOURCE_LINE 00000092 "\t\t# Mksymlists is only the beginning of the story."
NSQ_SOURCE_LINE 00000093 "\t\topen my $opt_fh, '>>', \"$abs_basename.opt\" or do { carp \"Couldn't append to '$abs_basename.opt'\"; return };"
NSQ_SOURCE_LINE 00000094 "\t\tprint $opt_fh \"PerlShr/Share\\n\";"
NSQ_SOURCE_LINE 00000095 "\t\tclose $opt_fh;"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "\t\tmy $incdirs = $ccflags =~ s{ /inc[^=]+ (?:=)+ (?:\\()? ( [^\\/\\)]* ) }{}xi ? \"$1,$incdir\" : $incdir;"
NSQ_SOURCE_LINE 00000098 "\t\tpush @commands, qq{$cc $ccflags $optimize /include=($incdirs) $cccdlflags $source_name /obj=$object_file};"
NSQ_SOURCE_LINE 00000099 "\t\tpush @commands, qq{$ld $ldflags $lddlflags=$loadable_object $object_file,$abs_basename.opt/OPTIONS,${incdir}perlshr_attr.opt/OPTIONS' $perllibs};"
NSQ_SOURCE_LINE 00000100 "\t}"
NSQ_SOURCE_LINE 00000101 "\telse {"
NSQ_SOURCE_LINE 00000102 "\t\tmy @extra;"
NSQ_SOURCE_LINE 00000103 "\t\tmy $inc = qq{\"-I$incdir\"};"
NSQ_SOURCE_LINE 00000104 "\t\tif ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000105 "\t\t\tmy $lib = '-l' . ($libperl =~ /lib([^.]+)\\./)[0];"
NSQ_SOURCE_LINE 00000106 "\t\t\tpush @extra, \"$abs_basename.def\", $lib, $perllibs;"
NSQ_SOURCE_LINE 00000107 "\t\t}"
NSQ_SOURCE_LINE 00000108 "\t\telsif ($^O =~ /^(cygwin|msys)$/) {"
NSQ_SOURCE_LINE 00000109 "\t\t\tpush @extra, catfile($incdir, $config->get('useshrplib') ? 'libperl.dll.a' : 'libperl.a');"
NSQ_SOURCE_LINE 00000110 "\t\t}"
NSQ_SOURCE_LINE 00000111 "\t\telsif ($^O eq 'aix') {"
NSQ_SOURCE_LINE 00000112 "\t\t\t$lddlflags =~ s/\\Q$(BASEEXT)\\E/$abs_basename/;"
NSQ_SOURCE_LINE 00000113 "\t\t\t$lddlflags =~ s/\\Q$(PERL_INC)\\E/$incdir/;"
NSQ_SOURCE_LINE 00000114 "\t\t}"
NSQ_SOURCE_LINE 00000115 "\t\telsif ($^O eq 'android') {"
NSQ_SOURCE_LINE 00000116 "\t\t\tpush @extra, qq{\"-L$incdir\"}, '-lperl', $perllibs;"
NSQ_SOURCE_LINE 00000117 "\t\t}"
NSQ_SOURCE_LINE 00000118 "\t\telsif ($^O eq 'darwin' && $config->get('perlpath') eq '/usr/bin/perl' && ($config->get('osvers') =~ /(\\d+)/)[0] >= 18) {"
NSQ_SOURCE_LINE 00000119 "\t\t\t$inc = qq{-iwithsysroot \"$incdir\"};"
NSQ_SOURCE_LINE 00000120 "\t\t}"
NSQ_SOURCE_LINE 00000121 "\t\tpush @commands, qq{$cc $ccflags $optimize $inc $cccdlflags -c $source_name -o $object_file};"
NSQ_SOURCE_LINE 00000122 "\t\tpush @commands, qq{$ld $object_file -o $loadable_object $lddlflags @extra};"
NSQ_SOURCE_LINE 00000123 "\t}"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "\tif ($prelinking{$^O}) {"
NSQ_SOURCE_LINE 00000126 "\t\trequire ExtUtils::Mksymlists;"
NSQ_SOURCE_LINE 00000127 "\t\tExtUtils::Mksymlists::Mksymlists(NAME => $basename, FILE => $abs_basename, IMPORTS => {});"
NSQ_SOURCE_LINE 00000128 "\t}"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "\tmy $shortname = '_Loadable' . $counter++;"
NSQ_SOURCE_LINE 00000131 "\tmy $package = \"ExtUtils::HasCompiler::$shortname\";"
NSQ_SOURCE_LINE 00000132 "\tprintf $source_handle $loadable_object_format, $basename, $package or do { carp \"Couldn't write to $source_name: $!\"; return };"
NSQ_SOURCE_LINE 00000133 "\tclose $source_handle or do { carp \"Couldn't close $source_name: $!\"; return };"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "\tfor my $command (@commands) {"
NSQ_SOURCE_LINE 00000136 "\t\tprint $output \"$command\\n\" if not $args{quiet};"
NSQ_SOURCE_LINE 00000137 "\t\tsystem $command and do { carp \"Couldn't execute $command: $!\"; return };"
NSQ_SOURCE_LINE 00000138 "\t}"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "\t# Skip loading when cross-compiling"
NSQ_SOURCE_LINE 00000141 "\treturn 1 if exists $args{skip_load} ? $args{skip_load} : $config->get('usecrosscompile');"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "\trequire DynaLoader;"
NSQ_SOURCE_LINE 00000144 "\tlocal @DynaLoader::dl_require_symbols = \"boot_$basename\";"
NSQ_SOURCE_LINE 00000145 "\tmy $handle = DynaLoader::dl_load_file(rel2abs($loadable_object), 0);"
NSQ_SOURCE_LINE 00000146 "\tif ($handle) {"
NSQ_SOURCE_LINE 00000147 "\t\tmy $symbol = DynaLoader::dl_find_symbol($handle, \"boot_$basename\") or do { carp \"Couldn't find boot symbol for $basename\"; return };"
NSQ_SOURCE_LINE 00000148 "\t\tmy $compilet = DynaLoader::dl_install_xsub('__ANON__::__ANON__', $symbol, $source_name);"
NSQ_SOURCE_LINE 00000149 "\t\tmy $ret = eval { $compilet->(); $package->exported } or carp $@;"
NSQ_SOURCE_LINE 00000150 "\t\tdelete $ExtUtils::HasCompiler::{\"$shortname\\::\"};"
NSQ_SOURCE_LINE 00000151 "\t\teval { DynaLoader::dl_unload_file($handle) } or carp $@;"
NSQ_SOURCE_LINE 00000152 "\t\treturn defined $ret && $ret == 42;"
NSQ_SOURCE_LINE 00000153 "\t}"
NSQ_SOURCE_LINE 00000154 "\telse {"
NSQ_SOURCE_LINE 00000155 "\t\tcarp \"Couldn't load $loadable_object: \" . DynaLoader::dl_error();"
NSQ_SOURCE_LINE 00000156 "\t\treturn;"
NSQ_SOURCE_LINE 00000157 "\t}"
NSQ_SOURCE_LINE 00000158 "}"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "my %static_unsupported_on = map { $_ => 1 } qw/VMS aix MSWin32 cygwin/;"
NSQ_SOURCE_LINE 00000161 "sub can_compile_static_library {"
NSQ_SOURCE_LINE 00000162 "\tmy %args = @_;"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "\tmy $output = $args{output} || \\*STDOUT;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "\tmy $config = $args{config} || 'ExtUtils::HasCompiler::Config';"
NSQ_SOURCE_LINE 00000167 "\treturn if $config->get('useshrplib') eq 'true';"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "\tmy ($source_handle, $source_name) = tempfile('TESTXXXX', DIR => $tempdir, SUFFIX => '.c', UNLINK => 1);"
NSQ_SOURCE_LINE 00000170 "\tmy $basename = basename($source_name, '.c');"
NSQ_SOURCE_LINE 00000171 "\tmy $abs_basename = catfile($tempdir, $basename);"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "\tmy ($cc, $ccflags, $optimize, $ar, $full_ar, $ranlib, $archlibexp, $_o, $lib_ext) = map { $config->get($_) } qw/cc ccflags optimize ar full_ar ranlib archlibexp _o lib_ext/;"
NSQ_SOURCE_LINE 00000174 "\tmy $incdir = catdir($archlibexp, 'CORE');"
NSQ_SOURCE_LINE 00000175 "\tmy $object_file = \"$abs_basename$_o\";"
NSQ_SOURCE_LINE 00000176 "\tmy $static_library = $abs_basename.$lib_ext;"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "\tmy @commands;"
NSQ_SOURCE_LINE 00000179 "\tif ($static_unsupported_on{$^O}) {"
NSQ_SOURCE_LINE 00000180 "\t\treturn;"
NSQ_SOURCE_LINE 00000181 "\t}"
NSQ_SOURCE_LINE 00000182 "\telse {"
NSQ_SOURCE_LINE 00000183 "\t\tmy $my_ar = length $full_ar ? $full_ar : $ar;"
NSQ_SOURCE_LINE 00000184 "\t\tpush @commands, qq{$cc $ccflags $optimize \"-I$incdir\" -c $source_name -o $object_file};"
NSQ_SOURCE_LINE 00000185 "\t\tpush @commands, qq{$my_ar cr $static_library $object_file};"
NSQ_SOURCE_LINE 00000186 "\t\tpush @commands, qq{$ranlib $static_library} if $ranlib ne ':';"
NSQ_SOURCE_LINE 00000187 "\t}"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "\tmy $shortname = '_Loadable' . $counter++;"
NSQ_SOURCE_LINE 00000190 "\tmy $package = \"ExtUtils::HasCompiler::$shortname\";"
NSQ_SOURCE_LINE 00000191 "\tprintf $source_handle $loadable_object_format, $basename, $package or do { carp \"Couldn't write to $source_name: $!\"; return };"
NSQ_SOURCE_LINE 00000192 "\tclose $source_handle or do { carp \"Couldn't close $source_name: $!\"; return };"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "\tfor my $command (@commands) {"
NSQ_SOURCE_LINE 00000195 "\t\tprint $output \"$command\\n\" if not $args{quiet};"
NSQ_SOURCE_LINE 00000196 "\t\tsystem $command and do { carp \"Couldn't execute $command: $!\"; return };"
NSQ_SOURCE_LINE 00000197 "\t}"
NSQ_SOURCE_LINE 00000198 "\treturn 1;"
NSQ_SOURCE_LINE 00000199 "}"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "sub can_compile_extension {"
NSQ_SOURCE_LINE 00000202 "\tmy %args = @_;"
NSQ_SOURCE_LINE 00000203 "\t$args{config} ||= 'ExtUtils::HasCompiler::Config';"
NSQ_SOURCE_LINE 00000204 "\tmy $linktype = $args{linktype} || ($args{config}->get('usedl') ? 'dynamic' : 'static');"
NSQ_SOURCE_LINE 00000205 "\treturn $linktype eq 'static' ? can_compile_static_library(%args) : can_compile_loadable_object(%args);"
NSQ_SOURCE_LINE 00000206 "}"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "sub ExtUtils::HasCompiler::Config::get {"
NSQ_SOURCE_LINE 00000209 "\tmy (undef, $key) = @_;"
NSQ_SOURCE_LINE 00000210 "\treturn $ENV{uc $key} || $Config{$key};"
NSQ_SOURCE_LINE 00000211 "}"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "1;"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "# ABSTRACT: Check for the presence of a compiler"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "__END__"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=pod"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=head1 NAME"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "ExtUtils::HasCompiler - Check for the presence of a compiler"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=head1 VERSION"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "version 0.025"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 " use ExtUtils::HasCompiler 'can_compile_extension';"
NSQ_SOURCE_LINE 00000234 " if (can_compile_extension()) {"
NSQ_SOURCE_LINE 00000235 "   ..."
NSQ_SOURCE_LINE 00000236 " }"
NSQ_SOURCE_LINE 00000237 " else {"
NSQ_SOURCE_LINE 00000238 "   ..."
NSQ_SOURCE_LINE 00000239 " }"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "This module tries to check if the current system is capable of compiling, linking and loading an XS module."
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "B<Notice>: this is an early release, interface stability isn't guaranteed yet."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=head2 can_compile_loadable_object(%opts)"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "This checks if the system can compile, link and load a perl loadable object. It may take the following options:"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=over 4"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=item * quiet"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "Do not output the executed compilation commands."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=item * config"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "An L<ExtUtils::Config|ExtUtils::Config> (compatible) object for configuration."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=item * skip_load"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "This causes can_compile_loadable_object to not try to load the generated object. This defaults to true on a cross-compiling perl."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=back"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=head2 can_compile_static_library(%opts)"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "This checks if the system can compile and link a perl static library. It does not check it it can compile a new perl with it. It may take the following options:"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=over 4"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=item * quiet"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "Do not output the executed compilation commands."
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=item * config"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "An L<ExtUtils::Config|ExtUtils::Config> (compatible) object for configuration."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "=back"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "=head2 can_compile_extension(%opts)"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "This will call either C<can_compile_loadable_object>, or C<can_compile_static_library>, depending on which is the default on your configuration. In addition to the arguments listed above, it can take one more optional argument:"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=over 4"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=item * linktype"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "This will force the linktype to be either static or dynamic. Dynamic compilation on a static perl won't work, but static libraries can be viable on a dynamic perl."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=back"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "Leon Timmermans <fawaka@gmail.com>"
