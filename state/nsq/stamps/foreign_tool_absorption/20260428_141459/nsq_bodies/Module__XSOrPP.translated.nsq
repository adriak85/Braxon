NSQ_SOURCE_LINE 00000001 "package Module::XSOrPP;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000008 "use Dist::Util qw(packlist_for);"
NSQ_SOURCE_LINE 00000009 "use Module::Installed::Tiny qw(module_source);"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000012 "our $DATE = '2023-07-09'; # DATE"
NSQ_SOURCE_LINE 00000013 "our $DIST = 'Module-XSOrPP'; # DIST"
NSQ_SOURCE_LINE 00000014 "our $VERSION = '0.120'; # VERSION"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000017 "                       is_xs"
NSQ_SOURCE_LINE 00000018 "                       is_pp"
NSQ_SOURCE_LINE 00000019 "                       xs_or_pp"
NSQ_SOURCE_LINE 00000020 "               );"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "our @XS_OR_PP_MODULES = qw("
NSQ_SOURCE_LINE 00000023 "                              DateTime"
NSQ_SOURCE_LINE 00000024 "                              List::MoreUtils"
NSQ_SOURCE_LINE 00000025 "                              Params::Util"
NSQ_SOURCE_LINE 00000026 "                              Params::Validate"
NSQ_SOURCE_LINE 00000027 ");"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "our @XS_MODULES = qw("
NSQ_SOURCE_LINE 00000030 "                        Scalar::Util"
NSQ_SOURCE_LINE 00000031 "                );"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "our @PP_MODULES = qw("
NSQ_SOURCE_LINE 00000034 "                );"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub xs_or_pp {"
NSQ_SOURCE_LINE 00000037 "    my ($mod, $opts) = @_;"
NSQ_SOURCE_LINE 00000038 "    die \"Please specify module\\n\" unless $mod;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    if ($mod =~ m!/!) {"
NSQ_SOURCE_LINE 00000041 "        $mod =~ s!/!::!g;"
NSQ_SOURCE_LINE 00000042 "        $mod =~ s/\\.pm$//;"
NSQ_SOURCE_LINE 00000043 "    }"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    $opts //= {};"
NSQ_SOURCE_LINE 00000046 "    $opts->{warn}  //= 0;"
NSQ_SOURCE_LINE 00000047 "    my $warn = $opts->{warn};"
NSQ_SOURCE_LINE 00000048 "    $opts->{debug} //= 0;"
NSQ_SOURCE_LINE 00000049 "    my $debug = $opts->{debug};"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    if (grep { $_ eq $mod } @XS_OR_PP_MODULES) {"
NSQ_SOURCE_LINE 00000052 "        warn \"$mod is xs_or_pp (from list)\\n\" if $debug;"
NSQ_SOURCE_LINE 00000053 "        return \"xs_or_pp\";"
NSQ_SOURCE_LINE 00000054 "    }"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    if (grep { $_ eq $mod } @XS_MODULES) {"
NSQ_SOURCE_LINE 00000057 "        warn \"$mod is xs (from list)\\n\" if $debug;"
NSQ_SOURCE_LINE 00000058 "        return \"xs\";"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    if (grep { $_ eq $mod } @PP_MODULES) {"
NSQ_SOURCE_LINE 00000062 "        warn \"$mod is pp (from list)\\n\" if $debug;"
NSQ_SOURCE_LINE 00000063 "        return \"pp\";"
NSQ_SOURCE_LINE 00000064 "    }"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    my $path = packlist_for($mod);"
NSQ_SOURCE_LINE 00000067 "    {"
NSQ_SOURCE_LINE 00000068 "        last unless $path;"
NSQ_SOURCE_LINE 00000069 "        my $fh;"
NSQ_SOURCE_LINE 00000070 "        unless (open $fh, '<', $path) {"
NSQ_SOURCE_LINE 00000071 "            warn \"Can't open .packlist $path: $!\\n\" if $warn;"
NSQ_SOURCE_LINE 00000072 "            last;"
NSQ_SOURCE_LINE 00000073 "        }"
NSQ_SOURCE_LINE 00000074 "        while (my $line = <$fh>) {"
NSQ_SOURCE_LINE 00000075 "            chomp $line;"
NSQ_SOURCE_LINE 00000076 "            if ($line =~ /\\.(bs|so|[Dd][Ll][Ll])\\z/) {"
NSQ_SOURCE_LINE 00000077 "                warn \"$mod is XS because the .packlist contains .{bs,so,dll} files\\n\" if $debug;"
NSQ_SOURCE_LINE 00000078 "                return \"xs\";"
NSQ_SOURCE_LINE 00000079 "            }"
NSQ_SOURCE_LINE 00000080 "        }"
NSQ_SOURCE_LINE 00000081 "        warn \"$mod is PP because the .packlist doesn't contain any .{bs,so,dll} files\\n\" if $debug;"
NSQ_SOURCE_LINE 00000082 "        return \"pp\";"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    {"
NSQ_SOURCE_LINE 00000086 "        my $src;"
NSQ_SOURCE_LINE 00000087 "        eval { $src = module_source($mod) };"
NSQ_SOURCE_LINE 00000088 "        if ($@) {"
NSQ_SOURCE_LINE 00000089 "            warn \"Can't check $mod for XS/PP because source can't be retrieved: $@\" if $debug;"
NSQ_SOURCE_LINE 00000090 "            return undef; ## no critic: TestingAndDebugging::ProhibitExplicitReturnUndef"
NSQ_SOURCE_LINE 00000091 "        }"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "        if ($src =~ m!^\\s*(use|require) \\s+ (DynaLoader|XSLoader)\\b!mx) {"
NSQ_SOURCE_LINE 00000094 "            warn \"$mod is XS because the source contains 'use {DynaLoader,XSLoader}' statement\\n\" if $debug;"
NSQ_SOURCE_LINE 00000095 "            return \"xs\";"
NSQ_SOURCE_LINE 00000096 "        }"
NSQ_SOURCE_LINE 00000097 "        warn \"$mod is PP because the source code doesn't contain any 'use {DynaLoader,XSLoader}' statement\\n\" if $debug;"
NSQ_SOURCE_LINE 00000098 "        return \"pp\";"
NSQ_SOURCE_LINE 00000099 "    }"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    {"
NSQ_SOURCE_LINE 00000102 "        my $mod = $mod;"
NSQ_SOURCE_LINE 00000103 "        unless ($mod =~ /\\.pm\\z/) { $mod =~ s!::!/!g; $mod .= \".pm\" }"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "        if ($mod =~ m!/XS\\.pm\\z|/[^/]+_(xs|XS)\\.pm\\z!) {"
NSQ_SOURCE_LINE 00000106 "            warn \"$mod is probably XS because its name contains XS\" if $debug;"
NSQ_SOURCE_LINE 00000107 "            return \"xs\";"
NSQ_SOURCE_LINE 00000108 "        } elsif ($mod =~ m!/PP\\.pm\\z|/[^/]+_(pp|PP)\\.pm\\z!) {"
NSQ_SOURCE_LINE 00000109 "            warn \"$mod is probably PP because its name contains PP\" if $debug;"
NSQ_SOURCE_LINE 00000110 "            return \"pp\";"
NSQ_SOURCE_LINE 00000111 "        }"
NSQ_SOURCE_LINE 00000112 "    }"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "    warn \"Can't determine whether $mod is XS: all methods tried\\n\" if $warn;"
NSQ_SOURCE_LINE 00000115 "    undef;"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "sub is_xs {"
NSQ_SOURCE_LINE 00000119 "    my ($mod, $opts) = @_;"
NSQ_SOURCE_LINE 00000120 "    my $res = xs_or_pp($mod, $opts);"
NSQ_SOURCE_LINE 00000121 "    return undef unless defined($res); ## no critic: TestingAndDebugging::ProhibitExplicitReturnUndef"
NSQ_SOURCE_LINE 00000122 "    $res eq 'xs' || $res eq 'xs_or_pp';"
NSQ_SOURCE_LINE 00000123 "}"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "sub is_pp {"
NSQ_SOURCE_LINE 00000126 "    my ($mod, $opts) = @_;"
NSQ_SOURCE_LINE 00000127 "    my $res = xs_or_pp($mod, $opts);"
NSQ_SOURCE_LINE 00000128 "    return undef unless defined($res); ## no critic: TestingAndDebugging::ProhibitExplicitReturnUndef"
NSQ_SOURCE_LINE 00000129 "    $res eq 'pp' || $res eq 'xs_or_pp';"
NSQ_SOURCE_LINE 00000130 "}"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "1;"
NSQ_SOURCE_LINE 00000133 "# ABSTRACT: Determine if an installed module is XS or pure-perl"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "__END__"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=pod"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head1 NAME"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "Module::XSOrPP - Determine if an installed module is XS or pure-perl"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=head1 VERSION"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "This document describes version 0.120 of Module::XSOrPP (from Perl distribution Module-XSOrPP), released on 2023-07-09."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 " use Module::XSOrPP qw("
NSQ_SOURCE_LINE 00000152 "     is_xs is_pp xs_or_pp"
NSQ_SOURCE_LINE 00000153 " );"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 " say \"Class::XSAccessor is an XS module\" if is_xs(\"Class/XSAccessor.pm\");"
NSQ_SOURCE_LINE 00000156 " say \"JSON::PP is a pure-Perl module\" if is_pp(\"JSON::PP\");"
NSQ_SOURCE_LINE 00000157 " say \"Params::Util is an XS module with PP fallback\" if xs_or_pp(\"Class/XSAccessor.pm\") =~ /^(xs|xs_or_pp)$/;"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=head2 xs_or_pp($mod, \\%opts) => str"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "Return either \"xs\", \"pp\", or \"xs_or_pp\" (XS with a PP fallback). Return undef if"
NSQ_SOURCE_LINE 00000166 "can't determine which. C<$mod> value can be in the form of C<Package/SubPkg.pm>"
NSQ_SOURCE_LINE 00000167 "or C<Package::SubPkg>. The following ways are tried, in order:"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=over"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=item * Predetermined list"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "Some CPAN modules are XS with a PP fallback. This module maintains the list."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=item * Looking at the C<.packlist>"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "If a .{bs,so,dll} file is listed in the C<.packlist>, then it is assumed to be"
NSQ_SOURCE_LINE 00000178 "an XS module. This method will fail if there is no C<.packlist> available (e.g."
NSQ_SOURCE_LINE 00000179 "core or uninstalled or when the package management strips the packlist), or if a"
NSQ_SOURCE_LINE 00000180 "dist contains both pure-Perl and XS."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=item * Looking at the source file for usage of C<XSLoader> or C<DynaLoader>"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "If the module source code has something like C<use XSLoader;> or <use"
NSQ_SOURCE_LINE 00000185 "DynaLoader;> then it is assumed to be an XS module. This is currently"
NSQ_SOURCE_LINE 00000186 "implemented using a simple regex, so it is somewhat brittle."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=item * Guessing from the name"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "If the module has \"XS\" in its name then it's assumed to be an XS module. If the"
NSQ_SOURCE_LINE 00000191 "module has \"PP\" in its name, it's assumed to be a pure-Perl module."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "Known false positives will be prevented in the future."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=back"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "Other methods will be added in the future (e.g. a database like in"
NSQ_SOURCE_LINE 00000198 "L<Module::CoreList>, consulting MetaCPAN, etc)."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "Options:"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=over"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=item * warn => BOOL (default: 0)"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "If set to true, will warn to STDERR if fail to determine."
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=item * debug => BOOL (default: 0)"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "If set to true will print debugging message to STDERR."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=back"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=head2 is_xs($mod, \\%opts) => BOOL"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "Return true if module C<$mod> is an XS module, false if a pure Perl module, or"
NSQ_SOURCE_LINE 00000217 "undef if can't determine either. See C<xs_or_pp> for more details."
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=head2 is_pp($mod, \\%opts) => BOOL"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "Return true if module C<$mod> is a pure Perl module or XS module with a PP"
NSQ_SOURCE_LINE 00000222 "fallback. See C<is_xs> for more details. See C<xs_or_pp> for more details."
NSQ_SOURCE_LINE 00000223 ""
