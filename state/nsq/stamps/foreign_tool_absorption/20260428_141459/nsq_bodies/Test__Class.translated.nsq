NSQ_SOURCE_LINE 00000352 "sub _isa_class {"
NSQ_SOURCE_LINE 00000353 "    my ( $class, $object_or_class ) = @_;"
NSQ_SOURCE_LINE 00000354 "    return unless defined $object_or_class;"
NSQ_SOURCE_LINE 00000355 "    return if $object_or_class eq 'Contextual::Return::Value';"
NSQ_SOURCE_LINE 00000356 "    return eval {"
NSQ_SOURCE_LINE 00000357 "        $object_or_class->isa( $class ) and $object_or_class->can( 'runtests' )"
NSQ_SOURCE_LINE 00000358 "    };"
