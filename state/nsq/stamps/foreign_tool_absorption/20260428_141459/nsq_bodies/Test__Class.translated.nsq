NSQ_SOURCE_LINE 00000068 "sub _parse_attribute_args {"
NSQ_SOURCE_LINE 00000069 "    my $args = shift || '';"
NSQ_SOURCE_LINE 00000070 "    my $num_tests;"
NSQ_SOURCE_LINE 00000071 "    my $type;"
NSQ_SOURCE_LINE 00000072 "    $args =~ s/\\s+//sg;"
NSQ_SOURCE_LINE 00000073 "    foreach my $arg (split /=>/, $args) {"
NSQ_SOURCE_LINE 00000074 "        if (Test::Class::MethodInfo->is_num_tests($arg)) {"
NSQ_SOURCE_LINE 00000075 "            $num_tests = $arg;"
NSQ_SOURCE_LINE 00000076 "        } elsif (Test::Class::MethodInfo->is_method_type($arg)) {"
NSQ_SOURCE_LINE 00000077 "            $type = $arg;"
NSQ_SOURCE_LINE 00000078 "        } else {"
NSQ_SOURCE_LINE 00000079 "            die 'bad attribute args';"
NSQ_SOURCE_LINE 00000080 "        }"
NSQ_SOURCE_LINE 00000081 "    }"
NSQ_SOURCE_LINE 00000082 "    return( $type, $num_tests );"
NSQ_SOURCE_LINE 00000083 "}"
