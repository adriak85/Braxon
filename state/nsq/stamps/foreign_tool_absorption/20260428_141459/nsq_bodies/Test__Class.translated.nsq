NSQ_SOURCE_LINE 00000129 "sub new {"
NSQ_SOURCE_LINE 00000130 "    my $proto = shift;"
NSQ_SOURCE_LINE 00000131 "    my $class = _class_of( $proto );"
NSQ_SOURCE_LINE 00000132 "    $proto = {} unless ref($proto);"
