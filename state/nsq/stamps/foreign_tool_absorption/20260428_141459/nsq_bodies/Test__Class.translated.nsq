NSQ_SOURCE_LINE 00000366 "sub runtests {"
NSQ_SOURCE_LINE 00000367 "    die \"Test::Class was loaded too late (after the CHECK block was run), or you may have redefined a test_ sub. See 'A NOTE ON LOADING TEST CLASSES' in perldoc Test::Class for more details\\n\""
NSQ_SOURCE_LINE 00000368 "        unless $Check_block_has_run;"
NSQ_SOURCE_LINE 00000369 "    my @tests = @_;"
NSQ_SOURCE_LINE 00000370 "    if (@tests == 1 && !ref($tests[0])) {"
NSQ_SOURCE_LINE 00000371 "        my $base_class = shift @tests;"
NSQ_SOURCE_LINE 00000372 "        @tests = _test_classes( $base_class );"
NSQ_SOURCE_LINE 00000373 "    }"
NSQ_SOURCE_LINE 00000374 "    my $all_passed = 1;"
NSQ_SOURCE_LINE 00000375 "    TEST_OBJECT: foreach my $t (@tests) {"
NSQ_SOURCE_LINE 00000376 "        # SHOULD ALSO ALLOW NO_PLAN"
NSQ_SOURCE_LINE 00000377 "        next if $t =~ m/^\\d+$/;"
NSQ_SOURCE_LINE 00000378 "        croak \"$t is not Test::Class or integer\""
NSQ_SOURCE_LINE 00000379 "            unless _isa_class( __PACKAGE__, $t );"
NSQ_SOURCE_LINE 00000380 "        if (my $reason = $t->SKIP_CLASS) {"
NSQ_SOURCE_LINE 00000381 "            _show_header($t, @tests);"
NSQ_SOURCE_LINE 00000382 "            $Builder->skip( $reason ) unless $reason eq \"1\";"
NSQ_SOURCE_LINE 00000383 "        } else {"
NSQ_SOURCE_LINE 00000384 "            $t = $t->new unless ref($t);"
NSQ_SOURCE_LINE 00000385 "            my @test_methods    = _get_methods($t, TEST);"
NSQ_SOURCE_LINE 00000386 "            if ( @test_methods ) {"
NSQ_SOURCE_LINE 00000387 "                foreach my $method (_get_methods($t, STARTUP)) {"
NSQ_SOURCE_LINE 00000388 "                    _show_header($t, @tests) unless _has_no_tests($t, $method);"
NSQ_SOURCE_LINE 00000389 "                    my $method_passed = _run_method($t, $method, \\@tests);"
NSQ_SOURCE_LINE 00000390 "                    $all_passed = 0 unless $method_passed;"
NSQ_SOURCE_LINE 00000391 "                    next TEST_OBJECT unless $method_passed;"
NSQ_SOURCE_LINE 00000392 "                }"
NSQ_SOURCE_LINE 00000393 "                my $class = ref($t);"
NSQ_SOURCE_LINE 00000394 "                my @setup           = _get_methods($t, SETUP);"
NSQ_SOURCE_LINE 00000395 "                my @teardown        = _get_methods($t, TEARDOWN);"
NSQ_SOURCE_LINE 00000396 "                foreach my $test ( @test_methods ) {"
NSQ_SOURCE_LINE 00000397 "                    local $Current_method = $test;"
NSQ_SOURCE_LINE 00000398 "                    $Builder->diag(\"\\n$class->$test\") if $ENV{TEST_VERBOSE};"
NSQ_SOURCE_LINE 00000399 "                    my @methods_to_run = (@setup, $test, @teardown);"
NSQ_SOURCE_LINE 00000400 "                    while ( my $method = shift @methods_to_run ) {"
NSQ_SOURCE_LINE 00000401 "                        _show_header($t, @tests) unless _has_no_tests($t, $method);"
NSQ_SOURCE_LINE 00000402 "                        $all_passed = 0 unless _run_method($t, $method, \\@tests);"
NSQ_SOURCE_LINE 00000403 "                        if ( _threw_exception( $t, $method ) ) {"
NSQ_SOURCE_LINE 00000404 "\t\t\t    next if ($method eq $test);"
NSQ_SOURCE_LINE 00000405 "                            my $num_to_skip = _total_num_tests($t, @methods_to_run);"
NSQ_SOURCE_LINE 00000406 "                            $Builder->skip( \"$method died\" ) for ( 1 .. $num_to_skip );"
NSQ_SOURCE_LINE 00000407 "                            last;"
NSQ_SOURCE_LINE 00000408 "                        }"
NSQ_SOURCE_LINE 00000409 "                    }"
NSQ_SOURCE_LINE 00000410 "                }"
NSQ_SOURCE_LINE 00000411 "                foreach my $method (_get_methods($t, SHUTDOWN)) {"
NSQ_SOURCE_LINE 00000412 "                    _show_header($t, @tests) unless _has_no_tests($t, $method);"
NSQ_SOURCE_LINE 00000413 "                    $all_passed = 0 unless _run_method($t, $method, \\@tests);"
NSQ_SOURCE_LINE 00000414 "                }"
NSQ_SOURCE_LINE 00000415 "            }"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "        }"
NSQ_SOURCE_LINE 00000418 "    }"
NSQ_SOURCE_LINE 00000419 "    return($all_passed);"
NSQ_SOURCE_LINE 00000420 "}"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "sub _find_calling_test_class {"
NSQ_SOURCE_LINE 00000423 "    my $level = 0;"
NSQ_SOURCE_LINE 00000424 "    while (my $class = caller(++$level)) {"
NSQ_SOURCE_LINE 00000425 "        next if $class eq __PACKAGE__;"
NSQ_SOURCE_LINE 00000426 "        return $class if _isa_class( __PACKAGE__, $class );"
NSQ_SOURCE_LINE 00000427 "    }"
NSQ_SOURCE_LINE 00000428 "    return(undef);"
NSQ_SOURCE_LINE 00000429 "}"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "sub num_method_tests {"
NSQ_SOURCE_LINE 00000432 "    my ($self, $method, $n) = @_;"
NSQ_SOURCE_LINE 00000433 "    my $class = _find_calling_test_class( $self )"
NSQ_SOURCE_LINE 00000434 "        or croak \"not called in a Test::Class\";"
NSQ_SOURCE_LINE 00000435 "    my $info = _method_info($self, $class, $method)"
NSQ_SOURCE_LINE 00000436 "        or croak \"$method is not a test method of class $class\";"
NSQ_SOURCE_LINE 00000437 "    $info->num_tests($n) if defined($n);"
NSQ_SOURCE_LINE 00000438 "    return( $info->num_tests );"
NSQ_SOURCE_LINE 00000439 "}"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "sub num_tests {"
NSQ_SOURCE_LINE 00000442 "    my $self = shift;"
NSQ_SOURCE_LINE 00000443 "    croak \"num_tests need to be called within a test method\""
NSQ_SOURCE_LINE 00000444 "            unless defined $Current_method;"
NSQ_SOURCE_LINE 00000445 "    return( $self->num_method_tests( $Current_method, @_ ) );"
NSQ_SOURCE_LINE 00000446 "}"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "sub BAILOUT {"
NSQ_SOURCE_LINE 00000449 "    my ($self, $reason) = @_;"
NSQ_SOURCE_LINE 00000450 "    $Builder->BAILOUT($reason);"
NSQ_SOURCE_LINE 00000451 "}"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "sub _last_test_if_exiting_immediately {"
NSQ_SOURCE_LINE 00000454 "    $Builder->expected_tests || $Builder->current_test+1"
NSQ_SOURCE_LINE 00000455 "}"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "sub FAIL_ALL {"
NSQ_SOURCE_LINE 00000458 "    my ($self, $reason) = @_;"
NSQ_SOURCE_LINE 00000459 "    my $last_test = _last_test_if_exiting_immediately();"
NSQ_SOURCE_LINE 00000460 "    $Builder->expected_tests( $last_test ) unless $Builder->has_plan;"
NSQ_SOURCE_LINE 00000461 "    $Builder->ok(0, $reason) until $Builder->current_test >= $last_test;"
NSQ_SOURCE_LINE 00000462 "    my $num_failed = $Builder->can(\"history\")"
NSQ_SOURCE_LINE 00000463 "      ? $Builder->history->fail_count : grep( !$_, $Builder->summary );"
NSQ_SOURCE_LINE 00000464 "    exit( $num_failed < 254 ? $num_failed : 254 );"
NSQ_SOURCE_LINE 00000465 "}"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "sub SKIP_ALL {"
NSQ_SOURCE_LINE 00000468 "    my ($self, $reason) = @_;"
NSQ_SOURCE_LINE 00000469 "    $Builder->skip_all( $reason ) unless $Builder->has_plan;"
NSQ_SOURCE_LINE 00000470 "    my $last_test = _last_test_if_exiting_immediately();"
NSQ_SOURCE_LINE 00000471 "    $Builder->skip( $reason )"
NSQ_SOURCE_LINE 00000472 "        until $Builder->current_test >= $last_test;"
NSQ_SOURCE_LINE 00000473 "    exit(0);"
NSQ_SOURCE_LINE 00000474 "}"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "sub add_filter {"
NSQ_SOURCE_LINE 00000477 "    my ( $class, $cb ) = @_;"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "    if ( not ref $cb eq 'CODE' ) {"
NSQ_SOURCE_LINE 00000480 "        croak \"Filter isn't a code-ref\""
NSQ_SOURCE_LINE 00000481 "    }"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "    push @Filters, $cb;"
NSQ_SOURCE_LINE 00000484 "}"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "1;"
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "__END__"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "=head1 NAME"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "Test::Class - Easily create test classes in an xUnit/JUnit style"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "=head1 VERSION"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "version 0.51"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "  package Example::Test;"
NSQ_SOURCE_LINE 00000501 "  use base qw(Test::Class);"
NSQ_SOURCE_LINE 00000502 "  use Test::More;"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "  # setup methods are run before every test method."
NSQ_SOURCE_LINE 00000505 "  sub make_fixture : Test(setup) {"
NSQ_SOURCE_LINE 00000506 "      my $array = [1, 2];"
NSQ_SOURCE_LINE 00000507 "      shift->{test_array} = $array;"
NSQ_SOURCE_LINE 00000508 "  }"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "  # a test method that runs 1 test"
NSQ_SOURCE_LINE 00000511 "  sub test_push : Test {"
NSQ_SOURCE_LINE 00000512 "      my $array = shift->{test_array};"
NSQ_SOURCE_LINE 00000513 "      push @$array, 3;"
NSQ_SOURCE_LINE 00000514 "      is_deeply($array, [1, 2, 3], 'push worked');"
NSQ_SOURCE_LINE 00000515 "  }"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "  # a test method that runs 4 tests"
NSQ_SOURCE_LINE 00000518 "  sub test_pop : Test(4) {"
NSQ_SOURCE_LINE 00000519 "      my $array = shift->{test_array};"
NSQ_SOURCE_LINE 00000520 "      is(pop @$array, 2, 'pop = 2');"
NSQ_SOURCE_LINE 00000521 "      is(pop @$array, 1, 'pop = 1');"
NSQ_SOURCE_LINE 00000522 "      is_deeply($array, [], 'array empty');"
NSQ_SOURCE_LINE 00000523 "      is(pop @$array, undef, 'pop = undef');"
NSQ_SOURCE_LINE 00000524 "  }"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "  # teardown methods are run after every test method."
NSQ_SOURCE_LINE 00000527 "  sub teardown : Test(teardown) {"
NSQ_SOURCE_LINE 00000528 "      my $array = shift->{test_array};"
NSQ_SOURCE_LINE 00000529 "      diag(\"array = (@$array) after test(s)\");"
NSQ_SOURCE_LINE 00000530 "  }"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "later in a nearby .t file"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "  #! /usr/bin/perl"
NSQ_SOURCE_LINE 00000535 "  use Example::Test;"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "  # run all the test methods in Example::Test"
NSQ_SOURCE_LINE 00000538 "  Test::Class->runtests;"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "Outputs:"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "  1..5"
NSQ_SOURCE_LINE 00000543 "  ok 1 - pop = 2"
NSQ_SOURCE_LINE 00000544 "  ok 2 - pop = 1"
NSQ_SOURCE_LINE 00000545 "  ok 3 - array empty"
NSQ_SOURCE_LINE 00000546 "  ok 4 - pop = undef"
NSQ_SOURCE_LINE 00000547 "  # array = () after test(s)"
NSQ_SOURCE_LINE 00000548 "  ok 5 - push worked"
NSQ_SOURCE_LINE 00000549 "  # array = (1 2 3) after test(s)"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "Test::Class provides a simple way of creating classes and objects to test your code in an xUnit style."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "Built using L<Test::Builder>, it was designed to work with other Test::Builder based modules (L<Test::More>, L<Test::Differences>, L<Test::Exception>, etc.)."
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "I<Note:> This module will make more sense, if you are already familiar with the \"standard\" mechanisms for testing perl code. Those unfamiliar with L<Test::Harness>, L<Test::Simple>, L<Test::More> and friends should go take a look at them now. L<Test::Tutorial> is a good starting point."
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "=head1 INTRODUCTION"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "=head2 A brief history lesson"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "In 1994 Kent Beck wrote a testing framework for Smalltalk called SUnit. It was popular. You can read a copy of his original paper at L<http://www.xprogramming.com/testfram.htm>."
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "Later Kent Beck and Erich Gamma created JUnit for testing Java L<http://www.junit.org/>. It was popular too."
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "Now there are xUnit frameworks for every language from Ada to XSLT. You can find a list at L<http://www.xprogramming.com/software.htm>."
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "While xUnit frameworks are traditionally associated with unit testing they are also useful in the creation of functional/acceptance tests."
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "Test::Class is (yet another) implementation of xUnit style testing in Perl."
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "=head2 Why you should use Test::Class"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "Test::Class attempts to provide simple xUnit testing that integrates simply with the standard perl *.t style of testing. In particular:"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "=over 4"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "=item *"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "All the advantages of xUnit testing. You can easily create test fixtures and isolate tests. It provides a framework that should be familiar to people who have used other xUnit style test systems."
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "=item *"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "It is built with L<Test::Builder> and should co-exist happily with all other Test::Builder based modules. This makes using test classes in *.t scripts, and refactoring normal tests into test classes, much simpler because:"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "=over 4"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=item *"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "You do not have to learn a new set of new test APIs and can continue using ok(), like(), etc. from L<Test::More> and friends."
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "=item *"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "Skipping tests and todo tests are supported."
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "=item *"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "You can have normal tests and Test::Class classes co-existing in the same *.t script. You don't have to re-write an entire script, but can use test classes as and when it proves useful."
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "=back"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "=item *"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "You can easily package your tests as classes/modules, rather than *.t scripts. This simplifies reuse, documentation and distribution, encourages refactoring, and allows tests to be extended by inheritance."
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "=item *"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "You can have multiple setup/teardown methods. For example have one teardown method to clean up resources and another to check that class invariants still hold."
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "=item *"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "It can make running tests faster. Once you have refactored your *.t scripts into classes they can be easily run from a single script. This gains you the (often considerable) start up time that each separate *.t script takes."
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "=back"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "=head2 Why you should I<not> use Test::Class"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "=over 4"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "=item *"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "If your *.t scripts are working fine then don't bother with Test::Class. For simple test suites it is almost certainly overkill. Don't start thinking about using Test::Class until issues like duplicate code in your test scripts start to annoy."
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "=item *"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "If you are distributing your code it is yet another module that the user has to have to run your tests (unless you distribute it with your test suite of course)."
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "=item *"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "If you are used to the TestCase/Suite/Runner class structure used by JUnit and similar testing frameworks you may find Test::Unit more familiar (but try reading L</\"HELP FOR CONFUSED JUNIT USERS\"> before you give up)."
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "=back"
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "=head1 TEST CLASSES"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "A test class is just a class that inherits from Test::Class. Defining a test class is as simple as doing:"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "  package Example::Test;"
NSQ_SOURCE_LINE 00000646 "  use base qw(Test::Class);"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "Since Test::Class does not provide its own test functions, but uses those provided by L<Test::More> and friends, you will nearly always also want to have:"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "  use Test::More;"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "to import the test functions into your test class."
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "=head1 METHOD TYPES"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "There are three different types of method you can define using Test::Class."
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "=head2 1) Test methods"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "You define test methods using the L<Test|/\"Test\"> attribute. For example:"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "  package Example::Test;"
NSQ_SOURCE_LINE 00000663 "  use base qw(Test::Class);"
NSQ_SOURCE_LINE 00000664 "  use Test::More;"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "  sub subtraction : Test {"
NSQ_SOURCE_LINE 00000667 "      is( 2-1, 1, 'subtraction works' );"
NSQ_SOURCE_LINE 00000668 "  }"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "This declares the C<subtraction> method as a test method that runs one test."
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "If your test method runs more than one test, you should put the number of tests in brackets like this:"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "  sub addition : Test(2) {"
NSQ_SOURCE_LINE 00000675 "      is(10 + 20, 30, 'addition works');"
NSQ_SOURCE_LINE 00000676 "      is(20 + 10, 30, '  both ways');"
NSQ_SOURCE_LINE 00000677 "  }"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "If you don't know the number of tests at compile time you can use C<no_plan> like this."
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "  sub check_class : Test(no_plan) {"
NSQ_SOURCE_LINE 00000682 "      my $objects = shift->{objects};"
NSQ_SOURCE_LINE 00000683 "      isa_ok($_, \"Object\") foreach @$objects;"
NSQ_SOURCE_LINE 00000684 "  }"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "or use the :Tests attribute, which acts just like C<:Test> but defaults to C<no_plan> if no number is given:"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "  sub check_class : Tests {"
NSQ_SOURCE_LINE 00000689 "      my $objects = shift->{objects};"
NSQ_SOURCE_LINE 00000690 "      isa_ok($_, \"Object\") foreach @$objects;"
NSQ_SOURCE_LINE 00000691 "  }"
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "=head2 2) Setup and teardown methods"
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "Setup and teardown methods are run before and after every test. For example:"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "  sub before : Test(setup)    { diag(\"running before test\") }"
NSQ_SOURCE_LINE 00000699 "  sub after  : Test(teardown) { diag(\"running after test\") }"
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "You can use setup and teardown methods to create common objects used by all of your test methods (a test I<fixture>) and store them in your Test::Class object, treating it as a hash. For example:"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "  sub pig : Test(setup) {"
NSQ_SOURCE_LINE 00000704 "      my $self = shift;"
NSQ_SOURCE_LINE 00000705 "      $self->{test_pig} = Pig->new;"
NSQ_SOURCE_LINE 00000706 "  }"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "  sub born_hungry : Test {"
NSQ_SOURCE_LINE 00000709 "      my $pig = shift->{test_pig};"
NSQ_SOURCE_LINE 00000710 "      is($pig->hungry, 'pigs are born hungry');"
NSQ_SOURCE_LINE 00000711 "  }"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "  sub eats : Test(3) {"
NSQ_SOURCE_LINE 00000714 "      my $pig = shift->{test_pig};"
NSQ_SOURCE_LINE 00000715 "      ok(  $pig->feed,   'pig fed okay');"
NSQ_SOURCE_LINE 00000716 "      ok(! $pig->hungry, 'fed pig not hungry');"
NSQ_SOURCE_LINE 00000717 "      ok(! $pig->feed,   'cannot feed full pig');"
NSQ_SOURCE_LINE 00000718 "  }"
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "You can also declare setup and teardown methods as running tests. For example you could check that the test pig survives each test method by doing:"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "  sub pig_alive : Test(teardown => 1) {"
NSQ_SOURCE_LINE 00000723 "      my $pig = shift->{test_pig};"
NSQ_SOURCE_LINE 00000724 "      ok($pig->alive, 'pig survived tests' );"
NSQ_SOURCE_LINE 00000725 "  }"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "=head2 3) Startup and shutdown methods"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "Startup and shutdown methods are like setup and teardown methods for the whole test class. All the startup methods are run once when you start running a test class. All the shutdown methods are run once just before a test class stops running."
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "You can use these to create and destroy expensive objects that you don't want to have to create and destroy for every test - a database connection for example:"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "  sub db_connect : Test(startup) {"
NSQ_SOURCE_LINE 00000735 "      shift->{dbi} = DBI->connect;"
NSQ_SOURCE_LINE 00000736 "  }"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "  sub db_disconnect : Test(shutdown) {"
NSQ_SOURCE_LINE 00000739 "      shift->{dbi}->disconnect;"
NSQ_SOURCE_LINE 00000740 "  }"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "Just like setup and teardown methods you can pass an optional number of tests to startup and shutdown methods. For example:"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "  sub example : Test(startup => 1) {"
NSQ_SOURCE_LINE 00000745 "      ok(1, 'a startup method with one test');"
NSQ_SOURCE_LINE 00000746 "  }"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "If you want to run an unknown number of tests within your startup method, you need to say e.g."
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "  sub example : Test(startup => no_plan) {"
NSQ_SOURCE_LINE 00000751 "     ok(1, q{The first of many tests that don't want to have to count});"
NSQ_SOURCE_LINE 00000752 "     ..."
NSQ_SOURCE_LINE 00000753 "  }"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "as the : Tests attribute behaves exactly like : Test in this context."
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "If a startup method has a failing test or throws an exception then all other tests for the current test object are ignored."
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "=head1 RUNNING TESTS"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "You run test methods with L<runtests()|\"runtests\">. Doing:"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "  Test::Class->runtests"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "runs all of the test methods in every loaded test class. This allows you to easily load multiple test classes in a *.t file and run them all."
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "  #! /usr/bin/perl"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "  # load all the test classes I want to run"
NSQ_SOURCE_LINE 00000770 "  use Foo::Test;"
NSQ_SOURCE_LINE 00000771 "  use Foo::Bar::Test;"
NSQ_SOURCE_LINE 00000772 "  use Foo::Fribble::Test;"
NSQ_SOURCE_LINE 00000773 "  use Foo::Ni::Test;"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "  # and run them all"
NSQ_SOURCE_LINE 00000776 "  Test::Class->runtests;"
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "You can use L<Test::Class::Load> to automatically load all the test classes in a given set of directories."
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "If you need finer control you can create individual test objects with L<new()|\"new\">. For example to just run the tests in the test class C<Foo::Bar::Test> you can do:"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "  Example::Test->new->runtests"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "You can also pass L<runtests()|/\"runtests\"> a list of test objects to run. For example:"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "  my $o1 = Example::Test->new;"
NSQ_SOURCE_LINE 00000787 "  my $o2 = Another::Test->new;"
NSQ_SOURCE_LINE 00000788 "  # runs all the tests in $o1 and $o2"
NSQ_SOURCE_LINE 00000789 "  $o1->runtests($o2);"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "Since, by definition, the base Test::Class has no tests, you could also have written:"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "  my $o1 = Example::Test->new;"
NSQ_SOURCE_LINE 00000794 "  my $o2 = Another::Test->new;"
NSQ_SOURCE_LINE 00000795 "  Test::Class->runtests($o1, $o2);"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "If you pass L<runtests()|/\"runtests\"> class names it will automatically create test objects for you, so the above can be written more compactly as:"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "  Test::Class->runtests(qw( Example::Test Another::Test ))"
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "In all of the above examples L<runtests()|/\"runtests\"> will look at the number of tests both test classes run and output an appropriate test header for L<Test::Harness> automatically."
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "What happens if you run test classes and normal tests in the same script? For example:"
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "  Test::Class->runtests;"
NSQ_SOURCE_LINE 00000806 "  ok(Example->new->foo, 'a test not in the test class');"
NSQ_SOURCE_LINE 00000807 "  ok(Example->new->bar, 'ditto');"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "L<Test::Harness> will complain that it saw more tests than it expected since the test header output by L<runtests()|/\"runtests\"> will not include the two normal tests."
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "To overcome this problem you can pass an integer value to L<runtests()|/\"runtests\">. This is added to the total number of tests in the test header. So the problematic example can be rewritten as follows:"
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "  Test::Class->runtests(+2);"
NSQ_SOURCE_LINE 00000814 "  ok(Example->new->foo, 'a test not in the test class');"
NSQ_SOURCE_LINE 00000815 "  ok(Example->new->bar, 'ditto');"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "If you prefer to write your test plan explicitly you can use L<expected_tests()|/\"expected_tests\"> to find out the number of tests a class/object is expected to run."
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "Since L<runtests()|/\"runtests\"> will not output a test plan if one has already been set, the previous example can be written as:"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "  plan tests => Test::Class->expected_tests(+2);"
NSQ_SOURCE_LINE 00000822 "  Test::Class->runtests;"
NSQ_SOURCE_LINE 00000823 "  ok(Example->new->foo, 'a test not in the test class');"
NSQ_SOURCE_LINE 00000824 "  ok(Example->new->bar, 'ditto');"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "I<Remember:> Test objects are just normal perl objects. Test classes are just normal perl classes. Setup, test and teardown methods are just normal methods. You are completely free to have other methods in your class that are called from your test methods, or have object specific C<new> and C<DESTROY> methods."
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "In particular you can override the new() method to pass parameters to your test object, or re-define the number of tests a method will run. See L<num_method_tests()|/\"num_method_tests\"> for an example."
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "=head1 TEST DESCRIPTIONS"
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "The test functions you import from L<Test::More> and other L<Test::Builder> based modules usually take an optional third argument that specifies the test description, for example:"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "  is $something, $something_else, 'a description of my test';"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "If you do not supply a test description, and the test function does not supply its own default, then Test::Class will use the name of the currently running test method, replacing all \"_\" characters with spaces so:"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "  sub one_plus_one_is_two : Test {"
NSQ_SOURCE_LINE 00000840 "      is 1+1, 2;"
NSQ_SOURCE_LINE 00000841 "  }"
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "will result in:"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "  ok 1 - one plus one is two"
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "=head1 RUNNING ORDER OF METHODS"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "Methods of each type are run in the following order:"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "=over 4"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "=item 1."
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "All of the startup methods in alphabetical order"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "=item 2."
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 "For each test method, in alphabetical order:"
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "=over 2"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "=item *"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "All of the setup methods in alphabetical order"
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "=item *"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "The test method."
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "=item *"
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "All of the teardown methods in alphabetical order"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "=back"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "=item 3."
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "All of the shutdown methods in alphabetical order."
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "=back"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "Most of the time you should not care what order tests are run in, but it can occasionally be useful to force some test methods to be run early. For example:"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "  sub _check_new {"
NSQ_SOURCE_LINE 00000887 "      my $self = shift;"
NSQ_SOURCE_LINE 00000888 "      isa_ok(Object->new, \"Object\") or $self->BAILOUT('new fails!');"
NSQ_SOURCE_LINE 00000889 "  }"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "The leading C<_> will force the above method to run first - allowing the entire suite to be aborted before any other test methods run."
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "=head1 HANDLING EXCEPTIONS"
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "If a startup, setup, test, teardown or shutdown method dies then L<runtests()|/\"runtests\"> will catch the exception and fail any remaining test. For example:"
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "  sub test_object : Test(2) {"
NSQ_SOURCE_LINE 00000899 "      my $object = Object->new;"
NSQ_SOURCE_LINE 00000900 "      isa_ok( $object, \"Object\" ) or die \"could not create object\\n\";"
NSQ_SOURCE_LINE 00000901 "      ok( $object->open, \"open worked\" );"
NSQ_SOURCE_LINE 00000902 "  }"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "will produce the following if the first test failed:"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "  not ok 1 - The object isa Object"
NSQ_SOURCE_LINE 00000907 "  #   Failed test 'The object isa Object'"
NSQ_SOURCE_LINE 00000908 "  #   at /Users/adrianh/Desktop/foo.pl line 14."
NSQ_SOURCE_LINE 00000909 "  #   (in MyTest->test_object)"
NSQ_SOURCE_LINE 00000910 "  #     The object isn't defined"
NSQ_SOURCE_LINE 00000911 "  not ok 2 - test_object died (could not create object)"
NSQ_SOURCE_LINE 00000912 "  #   Failed test 'test_object died (could not create object)'"
NSQ_SOURCE_LINE 00000913 "  #   at /Users/adrianh/Desktop/foo.pl line 19."
NSQ_SOURCE_LINE 00000914 "  #   (in MyTest->test_object)"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "This can considerably simplify testing code that throws exceptions."
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "Rather than having to explicitly check that the code exited normally (e.g. with L<Test::Exception/\"lives_ok\">) the test will fail automatically - without aborting the other test methods. For example contrast:"
NSQ_SOURCE_LINE 00000919 ""
NSQ_SOURCE_LINE 00000920 "  use Test::Exception;"
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "  my $file;"
NSQ_SOURCE_LINE 00000923 "  lives_ok { $file = read_file('test.txt') } 'file read';"
NSQ_SOURCE_LINE 00000924 "  is($file, \"content\", 'test file read');"
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "with:"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "  sub read_file : Test {"
NSQ_SOURCE_LINE 00000929 "      is(read_file('test.txt'), \"content\", 'test file read');"
NSQ_SOURCE_LINE 00000930 "  }"
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "If more than one test remains after an exception then the first one is failed, and the remaining ones are skipped."
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "If the setup method of a test method dies, then all of the remaining setup and shutdown methods are also skipped."
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "Since startup methods will usually be creating state needed by all the other test methods, an exception within a startup method will prevent all other test methods of that class running."
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "=head1 RETURNING EARLY"
NSQ_SOURCE_LINE 00000940 ""
NSQ_SOURCE_LINE 00000941 "If a test method returns before it has run all of its tests, by default the missing tests are deemed to have been skipped; see L<\"Skipped Tests\"> for more information."
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "However, if the class's C<fail_if_returned_early> method returns true, then the missing tests will be deemed to have failed.  For example,"
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 "  package MyClass;"
NSQ_SOURCE_LINE 00000946 "  use base 'Test::Class';"
NSQ_SOURCE_LINE 00000947 "  sub fail_if_returned_early { 1 }"
NSQ_SOURCE_LINE 00000948 ""
NSQ_SOURCE_LINE 00000949 "  sub oops : Tests(8) {"
NSQ_SOURCE_LINE 00000950 "    for (my $n=1; $n*$n<50; ++$n) {"
NSQ_SOURCE_LINE 00000951 "      ok 1, \"$n squared is less than fifty\";"
NSQ_SOURCE_LINE 00000952 "    }"
NSQ_SOURCE_LINE 00000953 "  }"
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "=head1 RETURNING LATE"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "If a test method runs too many tests, by default the test plan succeeds."
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "However, if the class's C<fail_if_returned_late> method returns true, then the extra tests will trigger a failure.  For example,"
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "  package MyClass;"
NSQ_SOURCE_LINE 00000963 "  use base 'Test::Class';"
NSQ_SOURCE_LINE 00000964 "  sub fail_if_returned_late { 1 }"
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "  sub oops : Tests(1) {"
NSQ_SOURCE_LINE 00000967 "    ok 1, \"just a simple test\";"
NSQ_SOURCE_LINE 00000968 "    ok 1, \"just a simple test\"; #oops I copied and pasted too many tests"
NSQ_SOURCE_LINE 00000969 "  }"
NSQ_SOURCE_LINE 00000970 ""
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "=head1 SKIPPED TESTS"
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "You can skip the rest of the tests in a method by returning from the method before all the test have finished running (but see L<\"Returning Early\"> for how to change this). The value returned is used as the reason for the tests being skipped."
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "This makes managing tests that can be skipped for multiple reasons very simple. For example:"
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 "  sub flying_pigs : Test(5) {"
NSQ_SOURCE_LINE 00000979 "      my $pig = Pig->new;"
NSQ_SOURCE_LINE 00000980 "      isa_ok($pig, 'Pig')           or return(\"cannot breed pigs\")"
NSQ_SOURCE_LINE 00000981 "      can_ok($pig, 'takeoff')       or return(\"pigs don't fly here\");"
NSQ_SOURCE_LINE 00000982 "      ok($pig->takeoff, 'takeoff')  or return(\"takeoff failed\");"
NSQ_SOURCE_LINE 00000983 "      ok( $pig->altitude > 0, 'Pig is airborne' );"
NSQ_SOURCE_LINE 00000984 "      ok( $pig->airspeed > 0, '  and moving'    );"
NSQ_SOURCE_LINE 00000985 "  }"
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "If you run this test in an environment where C<Pig-E<gt>new> worked and the takeoff method existed, but failed when ran, you would get:"
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "  ok 1 - The object isa Pig"
NSQ_SOURCE_LINE 00000990 "  ok 2 - can takeoff"
NSQ_SOURCE_LINE 00000991 "  not ok 3 - takeoff"
NSQ_SOURCE_LINE 00000992 "  ok 4 # skip takeoff failed"
NSQ_SOURCE_LINE 00000993 "  ok 5 # skip takeoff failed"
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "You can also skip tests just as you do in Test::More or Test::Builder - see L<Test::More/\"Conditional tests\"> for more information."
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "I<Note:> if you want to skip tests in a method with C<no_plan> tests then you have to explicitly skip the tests in the method - since Test::Class cannot determine how many tests (if any) should be skipped:"
NSQ_SOURCE_LINE 00000998 ""
NSQ_SOURCE_LINE 00000999 "  sub test_objects : Tests {"
NSQ_SOURCE_LINE 00001000 "      my $self = shift;"
NSQ_SOURCE_LINE 00001001 "      my $objects = $self->{objects};"
NSQ_SOURCE_LINE 00001002 "      if (@$objects) {"
NSQ_SOURCE_LINE 00001003 "          isa_ok($_, \"Object\") foreach (@$objects);"
NSQ_SOURCE_LINE 00001004 "      } else {"
NSQ_SOURCE_LINE 00001005 "          $self->builder->skip(\"no objects to test\");"
NSQ_SOURCE_LINE 00001006 "      }"
NSQ_SOURCE_LINE 00001007 "  }"
NSQ_SOURCE_LINE 00001008 ""
NSQ_SOURCE_LINE 00001009 "Another way of overcoming this problem is to explicitly set the number of tests for the method at run time using L<num_method_tests()|/\"num_method_tests\"> or L<\"num_tests\">."
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "You can make a test class skip all of its tests by setting L<SKIP_CLASS()|SKIP_CLASS> before L<runtests()|\"runtests\"> is called."
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "=head1 TO DO TESTS"
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "You can create todo tests just as you do in L<Test::More> and L<Test::Builder> using the C<$TODO> variable. For example:"
NSQ_SOURCE_LINE 00001016 ""
NSQ_SOURCE_LINE 00001017 "  sub live_test : Test  {"
NSQ_SOURCE_LINE 00001018 "      local $TODO = \"live currently unimplemented\";"
NSQ_SOURCE_LINE 00001019 "      ok(Object->live, \"object live\");"
NSQ_SOURCE_LINE 00001020 "  }"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "See L<Test::Harness/\"Todo tests\"> for more information."
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "=head1 EXTENDING TEST CLASSES BY INHERITANCE"
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "You can extend test methods by inheritance in the usual way. For example consider the following test class for a C<Pig> object."
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "  package Pig::Test;"
NSQ_SOURCE_LINE 00001030 "  use base qw(Test::Class);"
NSQ_SOURCE_LINE 00001031 "  use Test::More;"
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 "  sub testing_class { \"Pig\" }"
NSQ_SOURCE_LINE 00001034 "  sub new_args { (-age => 3) }"
NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "  sub setup : Test(setup) {"
NSQ_SOURCE_LINE 00001037 "      my $self = shift;"
NSQ_SOURCE_LINE 00001038 "      my $class = $self->testing_class;"
NSQ_SOURCE_LINE 00001039 "      my @args = $self->new_args;"
NSQ_SOURCE_LINE 00001040 "      $self->{pig} = $class->new( @args );"
NSQ_SOURCE_LINE 00001041 "  }"
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "  sub _creation : Test {"
NSQ_SOURCE_LINE 00001044 "      my $self = shift;"
NSQ_SOURCE_LINE 00001045 "      isa_ok($self->{pig}, $self->testing_class)"
NSQ_SOURCE_LINE 00001046 "              or $self->FAIL_ALL('Pig->new failed');"
NSQ_SOURCE_LINE 00001047 "  }"
NSQ_SOURCE_LINE 00001048 ""
NSQ_SOURCE_LINE 00001049 "  sub check_fields : Test {"
NSQ_SOURCE_LINE 00001050 "      my $pig = shift->{pig}"
NSQ_SOURCE_LINE 00001051 "      is($pig->age, 3, \"age accessed\");"
NSQ_SOURCE_LINE 00001052 "  }"
NSQ_SOURCE_LINE 00001053 ""
NSQ_SOURCE_LINE 00001054 "Next consider C<NamedPig> a subclass of C<Pig> where you can give your pig a name."
NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 "We want to make sure that all the tests for the C<Pig> object still work for C<NamedPig>. We can do this by subclassing C<Pig::Test> and overriding the C<testing_class> and C<new_args> methods."
NSQ_SOURCE_LINE 00001057 ""
NSQ_SOURCE_LINE 00001058 "  package NamedPig::Test;"
NSQ_SOURCE_LINE 00001059 "  use base qw(Pig::Test);"
NSQ_SOURCE_LINE 00001060 "  use Test::More;"
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "  sub testing_class { \"NamedPig\" }"
NSQ_SOURCE_LINE 00001063 "  sub new_args { (shift->SUPER::new_args, -name => 'Porky') }"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "Now we need to test the name method. We could write another test method, but we also have the option of extending the existing C<check_fields> method."
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "  sub check_fields : Test(2) {"
NSQ_SOURCE_LINE 00001068 "      my $self = shift;"
NSQ_SOURCE_LINE 00001069 "      $self->SUPER::check_fields;"
NSQ_SOURCE_LINE 00001070 "      is($self->{pig}->name, 'Porky', 'name accessed');"
NSQ_SOURCE_LINE 00001071 "  }"
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "While the above works, the total number of tests for the method is dependent on the number of tests in its C<SUPER::check_fields>. If we add a test to C<Pig::Test-E<gt>check_fields> we will also have to update the number of tests of C<NamedPig::test-E<gt>check_fields>."
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "Test::Class allows us to state explicitly that we are adding tests to an existing method by using the C<+> prefix. Since we are adding a single test to C<check_fields>, it can be rewritten as:"
NSQ_SOURCE_LINE 00001076 ""
NSQ_SOURCE_LINE 00001077 "  sub check_fields : Test(+1) {"
NSQ_SOURCE_LINE 00001078 "      my $self = shift;"
NSQ_SOURCE_LINE 00001079 "      $self->SUPER::check_fields;"
NSQ_SOURCE_LINE 00001080 "      is($self->{pig}->name, 'Porky', 'name accessed');"
NSQ_SOURCE_LINE 00001081 "  }"
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "With the above definition you can add tests to C<check_fields> in C<Pig::Test> without affecting C<NamedPig::Test>."
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 ""
NSQ_SOURCE_LINE 00001086 "=head1 RUNNING INDIVIDUAL TESTS"
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "B<NOTE:> The exact mechanism for running individual tests is likely to change in the future."
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "Sometimes you just want to run a single test.  Commenting out other tests or writing code to skip them can be a hassle, so you can specify the C<TEST_METHOD> environment variable.  The value is expected to be a valid regular expression and, if present, only runs test methods whose names match the regular expression.  Startup, setup, teardown and shutdown tests will still be run."
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "One easy way of doing this is by specifying the environment variable I<before> the C<runtests> method is called."
NSQ_SOURCE_LINE 00001093 ""
NSQ_SOURCE_LINE 00001094 "Running a test named C<customer_profile>:"
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 " #! /usr/bin/perl"
NSQ_SOURCE_LINE 00001097 " use Example::Test;"
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 " $ENV{TEST_METHOD} = 'customer_profile';"
NSQ_SOURCE_LINE 00001100 " Test::Class->runtests;"
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "Running all tests with C<customer> in their name:"
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 " #! /usr/bin/perl"
NSQ_SOURCE_LINE 00001105 " use Example::Test;"
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 " $ENV{TEST_METHOD} = '.*customer.*';"
NSQ_SOURCE_LINE 00001108 " Test::Class->runtests;"
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "If you specify an invalid regular expression, your tests will not be run:"
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 " #! /usr/bin/perl"
NSQ_SOURCE_LINE 00001113 " use Example::Test;"
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 " $ENV{TEST_METHOD} = 'C++';"
NSQ_SOURCE_LINE 00001116 " Test::Class->runtests;"
NSQ_SOURCE_LINE 00001117 ""
NSQ_SOURCE_LINE 00001118 "And when you run it:"
NSQ_SOURCE_LINE 00001119 ""
NSQ_SOURCE_LINE 00001120 " TEST_METHOD (C++) is not a valid regular expression: Search pattern \\"
NSQ_SOURCE_LINE 00001121 " not terminated at (eval 17) line 1."
NSQ_SOURCE_LINE 00001122 ""
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 "=head1 ORGANISING YOUR TEST CLASSES"
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "You can, of course, organise your test modules as you wish. My personal preferences is:"
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "=over 4"
NSQ_SOURCE_LINE 00001129 ""
NSQ_SOURCE_LINE 00001130 "=item *"
NSQ_SOURCE_LINE 00001131 ""
NSQ_SOURCE_LINE 00001132 "Name test classes with a suffix of C<::Test> so the test class for the C<Foo::Bar> module would be C<Foo::Bar::Test>."
NSQ_SOURCE_LINE 00001133 ""
NSQ_SOURCE_LINE 00001134 "=item *"
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 "Place all test classes in F<t/lib>."
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "=back"
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "The L<Test::Class::Load> provides a simple mechanism for easily loading all of the test classes in a given set of directories."
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 ""
NSQ_SOURCE_LINE 00001143 "=head1 A NOTE ON LOADING TEST CLASSES"
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "Due to its use of subroutine attributes Test::Class based modules must be loaded at compile rather than run time. This is because the :Test attribute is applied by a CHECK block."
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 "This can be problematic if you want to dynamically load Test::Class modules. Basically while:"
NSQ_SOURCE_LINE 00001148 ""
NSQ_SOURCE_LINE 00001149 "  require $some_test_class;"
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "will break, doing:"
NSQ_SOURCE_LINE 00001152 ""
NSQ_SOURCE_LINE 00001153 "  BEGIN { require $some_test_class }"
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "will work just fine. For more information on CHECK blocks see L<perlmod/\"BEGIN, CHECK, INIT and END\">."
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "If you still can't arrange for your classes to be loaded at runtime, you could use an alternative mechanism for adding your tests:"
NSQ_SOURCE_LINE 00001158 ""
NSQ_SOURCE_LINE 00001159 "  # sub test_something : Test(3) {...}"
NSQ_SOURCE_LINE 00001160 "  # becomes"
NSQ_SOURCE_LINE 00001161 "  sub test_something {...}"
NSQ_SOURCE_LINE 00001162 "  __PACKAGE__->add_testinfo('test_something', test => 3);"
NSQ_SOURCE_LINE 00001163 ""
NSQ_SOURCE_LINE 00001164 "See the L<add_testinfo|/\"add_testinfo\"> method for more details."
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 "Additionally, if you've forgotten to enable warnings and have two test subs called the same thing, you will get the same error."
NSQ_SOURCE_LINE 00001167 ""
NSQ_SOURCE_LINE 00001168 "=head1 GENERAL FILTERING OF TESTS"
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 "The use of $ENV{TEST_METHOD} to run just a subset of tests is useful, but"
NSQ_SOURCE_LINE 00001171 "sometimes it doesn't give the level of granularity that you desire.  Another"
NSQ_SOURCE_LINE 00001172 "feature of this class is the ability to do filtering on other static criteria."
NSQ_SOURCE_LINE 00001173 "In order to permit this, a generic filtering method is supported.  This can"
NSQ_SOURCE_LINE 00001174 "be used by specifying coderefs to the 'add_filter' method of this class."
NSQ_SOURCE_LINE 00001175 ""
NSQ_SOURCE_LINE 00001176 "In determining which tests should be run, all filters that have previously"
NSQ_SOURCE_LINE 00001177 "been specified via the add_filter method will be run in-turn for each normal"
NSQ_SOURCE_LINE 00001178 "test method.  If B<any> of these filters return a false value, the method will"
NSQ_SOURCE_LINE 00001179 "not be executed, or included in the number of tests.  Note that filters will"
NSQ_SOURCE_LINE 00001180 "only be run for normal test methods, they are ignored for startup, shutdown,"
NSQ_SOURCE_LINE 00001181 "setup, and teardown test methods."
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "Note that test filters are global, and will affect all tests in all classes,"
NSQ_SOURCE_LINE 00001184 "not just the one that they were defined in."
NSQ_SOURCE_LINE 00001185 ""
NSQ_SOURCE_LINE 00001186 "An example of this mechanism that mostly simulates the use of TEST_METHOD"
NSQ_SOURCE_LINE 00001187 "above is:"
NSQ_SOURCE_LINE 00001188 ""
NSQ_SOURCE_LINE 00001189 " package MyTests;"
NSQ_SOURCE_LINE 00001190 ""
NSQ_SOURCE_LINE 00001191 " use Test::More;"
NSQ_SOURCE_LINE 00001192 ""
NSQ_SOURCE_LINE 00001193 " use base qw( Test::Class );"
NSQ_SOURCE_LINE 00001194 ""
NSQ_SOURCE_LINE 00001195 " my $MYTEST_METHOD = qr/^t_not_filtered$/;"
NSQ_SOURCE_LINE 00001196 ""
NSQ_SOURCE_LINE 00001197 " my $filter = sub {"
NSQ_SOURCE_LINE 00001198 "    my ( $test_class, $test_method ) = @_;"
NSQ_SOURCE_LINE 00001199 ""
NSQ_SOURCE_LINE 00001200 "    return $test_method =~ $MYTEST_METHOD;"
NSQ_SOURCE_LINE 00001201 " }"
NSQ_SOURCE_LINE 00001202 " Test::Class->add_filter( $filter );"
NSQ_SOURCE_LINE 00001203 ""
NSQ_SOURCE_LINE 00001204 " sub t_filtered : Test( 1 ) {"
NSQ_SOURCE_LINE 00001205 "    fail( \"filtered test run\" );"
NSQ_SOURCE_LINE 00001206 " }"
NSQ_SOURCE_LINE 00001207 ""
NSQ_SOURCE_LINE 00001208 " sub t_not_filtered : Test( 1 ) {"
NSQ_SOURCE_LINE 00001209 "    pass( \"unfiltered test run\" );"
NSQ_SOURCE_LINE 00001210 " }"
NSQ_SOURCE_LINE 00001211 ""
NSQ_SOURCE_LINE 00001212 "=head1 METHODS"
NSQ_SOURCE_LINE 00001213 ""
NSQ_SOURCE_LINE 00001214 "=head2 Creating and running tests"
NSQ_SOURCE_LINE 00001215 ""
NSQ_SOURCE_LINE 00001216 "=over 4"
NSQ_SOURCE_LINE 00001217 ""
NSQ_SOURCE_LINE 00001218 "=item B<Test>"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "  # test methods"
NSQ_SOURCE_LINE 00001221 "  sub method_name : Test { ... }"
NSQ_SOURCE_LINE 00001222 "  sub method_name : Test(N) { ... }"
NSQ_SOURCE_LINE 00001223 ""
NSQ_SOURCE_LINE 00001224 "  # setup methods"
NSQ_SOURCE_LINE 00001225 "  sub method_name : Test(setup) { ... }"
NSQ_SOURCE_LINE 00001226 "  sub method_name : Test(setup => N) { ... }"
NSQ_SOURCE_LINE 00001227 ""
NSQ_SOURCE_LINE 00001228 "  # teardown methods"
NSQ_SOURCE_LINE 00001229 "  sub method_name : Test(teardown) { ... }"
NSQ_SOURCE_LINE 00001230 "  sub method_name : Test(teardown => N) { ... }"
NSQ_SOURCE_LINE 00001231 ""
NSQ_SOURCE_LINE 00001232 "  # startup methods"
NSQ_SOURCE_LINE 00001233 "  sub method_name : Test(startup) { ... }"
NSQ_SOURCE_LINE 00001234 "  sub method_name : Test(startup => N) { ... }"
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 "  # shutdown methods"
NSQ_SOURCE_LINE 00001237 "  sub method_name : Test(shutdown) { ... }"
NSQ_SOURCE_LINE 00001238 "  sub method_name : Test(shutdown => N) { ... }"
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "Marks a startup, setup, test, teardown or shutdown method. See L<runtests()|/\"runtests\"> for information on how to run methods declared with the C<Test> attribute."
NSQ_SOURCE_LINE 00001241 ""
NSQ_SOURCE_LINE 00001242 "N specifies the number of tests the method runs."
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "=over 4"
NSQ_SOURCE_LINE 00001245 ""
NSQ_SOURCE_LINE 00001246 "=item *"
NSQ_SOURCE_LINE 00001247 ""
NSQ_SOURCE_LINE 00001248 "If N is an integer then the method should run exactly N tests."
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "=item *"
NSQ_SOURCE_LINE 00001251 ""
NSQ_SOURCE_LINE 00001252 "If N is an integer with a C<+> prefix then the method is expected to call its C<SUPER::> method and extend it by running N additional tests."
NSQ_SOURCE_LINE 00001253 ""
NSQ_SOURCE_LINE 00001254 "=item *"
NSQ_SOURCE_LINE 00001255 ""
NSQ_SOURCE_LINE 00001256 "If N is the string C<no_plan> then the method can run an arbitrary number of tests."
NSQ_SOURCE_LINE 00001257 ""
NSQ_SOURCE_LINE 00001258 "=back"
NSQ_SOURCE_LINE 00001259 ""
NSQ_SOURCE_LINE 00001260 "If N is not specified it defaults to C<1> for test methods, and C<0> for startup, setup, teardown and shutdown methods."
NSQ_SOURCE_LINE 00001261 ""
NSQ_SOURCE_LINE 00001262 "You can change the number of tests that a method runs using L<num_method_tests()|/\"num_method_tests\"> or L<num_tests()|/\"num_tests\">."
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 ""
NSQ_SOURCE_LINE 00001265 "=item B<Tests>"
NSQ_SOURCE_LINE 00001266 ""
NSQ_SOURCE_LINE 00001267 "  sub method_name : Tests { ... }"
NSQ_SOURCE_LINE 00001268 "  sub method_name : Tests(N) { ... }"
NSQ_SOURCE_LINE 00001269 ""
NSQ_SOURCE_LINE 00001270 "Acts just like the C<:Test> attribute, except that if the number of tests is not specified it defaults to C<no_plan>. So the following are equivalent:"
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 "  sub silly1 :Test( no_plan ) { ok(1) foreach (1 .. rand 5) }"
NSQ_SOURCE_LINE 00001273 "  sub silly2 :Tests           { ok(1) foreach (1 .. rand 5) }"
NSQ_SOURCE_LINE 00001274 ""
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "=item B<new>"
NSQ_SOURCE_LINE 00001277 ""
NSQ_SOURCE_LINE 00001278 "  $Tests = CLASS->new(KEY => VAL ...)"
NSQ_SOURCE_LINE 00001279 "  $Tests2 = $Tests->new(KEY => VAL ...)"
NSQ_SOURCE_LINE 00001280 ""
NSQ_SOURCE_LINE 00001281 "Creates a new test object (blessed hashref) containing the specified key/value pairs."
NSQ_SOURCE_LINE 00001282 ""
NSQ_SOURCE_LINE 00001283 "If called as an object method the existing object's key/value pairs are copied into the new object. Any key/value pairs passed to C<new> override those in the original object if duplicates occur."
NSQ_SOURCE_LINE 00001284 ""
NSQ_SOURCE_LINE 00001285 "Since the test object is passed to every test method as it runs, it is a convenient place to store test fixtures. For example:"
NSQ_SOURCE_LINE 00001286 ""
NSQ_SOURCE_LINE 00001287 "  sub make_fixture : Test(setup) {"
NSQ_SOURCE_LINE 00001288 "      my $self = shift;"
NSQ_SOURCE_LINE 00001289 "      $self->{object} = Object->new();"
NSQ_SOURCE_LINE 00001290 "      $self->{dbh} = Mock::DBI->new(-type => normal);"
NSQ_SOURCE_LINE 00001291 "  }"
NSQ_SOURCE_LINE 00001292 ""
NSQ_SOURCE_LINE 00001293 "  sub test_open : Test {"
NSQ_SOURCE_LINE 00001294 "      my $self = shift;"
NSQ_SOURCE_LINE 00001295 "      my ($o, $dbh) = ($self->{object}, $self->{dbh});"
NSQ_SOURCE_LINE 00001296 "      ok($o->open($dbh), \"opened ok\");"
NSQ_SOURCE_LINE 00001297 "  }"
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "See L<num_method_tests()|/\"num_method_tests\"> for an example of overriding C<new>."
NSQ_SOURCE_LINE 00001300 ""
NSQ_SOURCE_LINE 00001301 ""
NSQ_SOURCE_LINE 00001302 "=item B<expected_tests>"
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 "  $n = $Tests->expected_tests"
NSQ_SOURCE_LINE 00001305 "  $n = CLASS->expected_tests"
NSQ_SOURCE_LINE 00001306 "  $n = $Tests->expected_tests(TEST, ...)"
NSQ_SOURCE_LINE 00001307 "  $n = CLASS->expected_tests(TEST, ...)"
NSQ_SOURCE_LINE 00001308 ""
NSQ_SOURCE_LINE 00001309 "Returns the total number of tests that L<runtests()|/\"runtests\"> will run on the specified class/object. This includes tests run by any setup and teardown methods."
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 "Will return C<no_plan> if the exact number of tests is undetermined (i.e. if any setup, test or teardown method has an undetermined number of tests)."
NSQ_SOURCE_LINE 00001312 ""
NSQ_SOURCE_LINE 00001313 "The C<expected_tests> of an object after L<runtests()|/\"runtests\"> has been executed will include any run time changes to the expected number of tests made by L<num_tests()|/\"num_tests\"> or L<num_method_tests()|/\"num_method_tests\">."
NSQ_SOURCE_LINE 00001314 ""
NSQ_SOURCE_LINE 00001315 "C<expected_tests> can also take an optional list of test objects, test classes and integers. In this case the result is the total number of expected tests for all the test/object classes (including the one the method was applied to) plus any integer values."
NSQ_SOURCE_LINE 00001316 ""
NSQ_SOURCE_LINE 00001317 "C<expected_tests> is useful when you're integrating one or more test classes into a more traditional test script, for example:"
NSQ_SOURCE_LINE 00001318 ""
NSQ_SOURCE_LINE 00001319 "  use Test::More;"
NSQ_SOURCE_LINE 00001320 "  use My::Test::Class;"
NSQ_SOURCE_LINE 00001321 ""
NSQ_SOURCE_LINE 00001322 "  plan tests => My::Test::Class->expected_tests(+2);"
NSQ_SOURCE_LINE 00001323 ""
NSQ_SOURCE_LINE 00001324 "  ok(whatever, 'a test');"
NSQ_SOURCE_LINE 00001325 "  ok(whatever, 'another test');"
NSQ_SOURCE_LINE 00001326 "  My::Test::Class->runtests;"
NSQ_SOURCE_LINE 00001327 ""
NSQ_SOURCE_LINE 00001328 ""
NSQ_SOURCE_LINE 00001329 ""
NSQ_SOURCE_LINE 00001330 "=item B<runtests>"
NSQ_SOURCE_LINE 00001331 ""
NSQ_SOURCE_LINE 00001332 "  $allok = $Tests->runtests"
NSQ_SOURCE_LINE 00001333 "  $allok = CLASS->runtests"
NSQ_SOURCE_LINE 00001334 "  $allok = $Tests->runtests(TEST, ...)"
NSQ_SOURCE_LINE 00001335 "  $allok = CLASS->runtests(TEST, ...)"
NSQ_SOURCE_LINE 00001336 ""
NSQ_SOURCE_LINE 00001337 "C<runtests> is used to run test classes. At its most basic doing:"
NSQ_SOURCE_LINE 00001338 ""
NSQ_SOURCE_LINE 00001339 "  $test->runtests"
NSQ_SOURCE_LINE 00001340 ""
NSQ_SOURCE_LINE 00001341 "will run the test methods of the test object $test, unless C<< $test->SKIP_CLASS >> returns a true value."
NSQ_SOURCE_LINE 00001342 ""
NSQ_SOURCE_LINE 00001343 "Unless you have already specified a test plan using Test::Builder (or Test::More, et al) C<runtests> will set the test plan just before the first method that runs a test is executed."
NSQ_SOURCE_LINE 00001344 ""
NSQ_SOURCE_LINE 00001345 "If the environment variable C<TEST_VERBOSE> is set C<runtests> will display the name of each test method before it runs like this:"
NSQ_SOURCE_LINE 00001346 ""
NSQ_SOURCE_LINE 00001347 "  # My::Test::Class->my_test"
NSQ_SOURCE_LINE 00001348 "  ok 1 - fribble"
NSQ_SOURCE_LINE 00001349 "  # My::Test::Class->another_test"
NSQ_SOURCE_LINE 00001350 "  ok 2 - bar"
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "Just like L<expected_tests()|/\"expected_tests\">, C<runtests> can take an optional list of test object/classes and integers. All of the test object/classes are run. Any integers are added to the total number of tests shown in the test header output by C<runtests>."
NSQ_SOURCE_LINE 00001353 ""
NSQ_SOURCE_LINE 00001354 "For example, you can run all the tests in test classes A, B and C, plus one additional normal test by doing:"
NSQ_SOURCE_LINE 00001355 ""
NSQ_SOURCE_LINE 00001356 "    Test::Class->runtests(qw(A B C), +1);"
NSQ_SOURCE_LINE 00001357 "    ok(1==1, 'non class test');"
NSQ_SOURCE_LINE 00001358 ""
NSQ_SOURCE_LINE 00001359 "Finally, if you call C<runtests> on a test class without any arguments it will run all of the test methods of that class, and all subclasses of that class. For example:"
NSQ_SOURCE_LINE 00001360 ""
NSQ_SOURCE_LINE 00001361 "  #! /usr/bin/perl"
NSQ_SOURCE_LINE 00001362 "  # Test all the Foo stuff"
NSQ_SOURCE_LINE 00001363 ""
NSQ_SOURCE_LINE 00001364 "  use Foo::Test;"
NSQ_SOURCE_LINE 00001365 "  use Foo::Bar::Test;"
NSQ_SOURCE_LINE 00001366 "  use Foo::Ni::Test;"
NSQ_SOURCE_LINE 00001367 ""
NSQ_SOURCE_LINE 00001368 "  # run all the Foo*Test modules we just loaded"
NSQ_SOURCE_LINE 00001369 "  Test::Class->runtests;"
NSQ_SOURCE_LINE 00001370 ""
NSQ_SOURCE_LINE 00001371 ""
NSQ_SOURCE_LINE 00001372 "=item B<SKIP_CLASS>"
NSQ_SOURCE_LINE 00001373 ""
NSQ_SOURCE_LINE 00001374 "  $reason = CLASS->SKIP_CLASS;"
NSQ_SOURCE_LINE 00001375 "  CLASS->SKIP_CLASS( $reason );"
NSQ_SOURCE_LINE 00001376 ""
NSQ_SOURCE_LINE 00001377 "Determines whether the test class CLASS should run it's tests. If SKIP_CLASS returns a true value then  L<runtests()|/\"runtests\"> will not run any of the test methods in CLASS."
NSQ_SOURCE_LINE 00001378 ""
NSQ_SOURCE_LINE 00001379 "You can override the default on a class-by-class basis by supplying a new value to SKIP_CLASS. For example if you have an abstract base class that should not run just add the following to your module:"
NSQ_SOURCE_LINE 00001380 ""
NSQ_SOURCE_LINE 00001381 "  My::Abstract::Test->SKIP_CLASS( 1 );"
NSQ_SOURCE_LINE 00001382 ""
NSQ_SOURCE_LINE 00001383 "This will not affect any sub-classes of C<My::Abstract::Test> which will run as normal."
NSQ_SOURCE_LINE 00001384 ""
NSQ_SOURCE_LINE 00001385 "If the true value returned by SKIP_CLASS is anything other than \"1\" then a skip test is output using this value as the skip message. For example:"
NSQ_SOURCE_LINE 00001386 ""
NSQ_SOURCE_LINE 00001387 "  My::Postgres::Test->SKIP_CLASS("
NSQ_SOURCE_LINE 00001388 "      $ENV{POSTGRES_HOME} ? 0 : '$POSTGRES_HOME needs to be set'"
NSQ_SOURCE_LINE 00001389 "  );"
NSQ_SOURCE_LINE 00001390 ""
NSQ_SOURCE_LINE 00001391 "will output something like this if C<POSTGRES_HOME> is not set"
NSQ_SOURCE_LINE 00001392 ""
NSQ_SOURCE_LINE 00001393 "    ... other tests ..."
NSQ_SOURCE_LINE 00001394 "    ok 123 # skip My::Postgres::Test  - $POSTGRES_HOME needs to be set"
NSQ_SOURCE_LINE 00001395 "    ... more tests ..."
NSQ_SOURCE_LINE 00001396 ""
NSQ_SOURCE_LINE 00001397 "You can also override SKIP_CLASS for a class hierarchy. For example, to prevent any subclasses of My::Postgres::Test running we could override SKIP_CLASS like this:"
NSQ_SOURCE_LINE 00001398 ""
NSQ_SOURCE_LINE 00001399 "  sub My::Postgres::Test::SKIP_CLASS {"
NSQ_SOURCE_LINE 00001400 "      $ENV{POSTGRES_HOME} ? 0 : '$POSTGRES_HOME needs to be set'"
NSQ_SOURCE_LINE 00001401 "  }"
NSQ_SOURCE_LINE 00001402 ""
NSQ_SOURCE_LINE 00001403 "=back"
NSQ_SOURCE_LINE 00001404 ""
NSQ_SOURCE_LINE 00001405 "=head2 Fetching and setting a method's test number"
NSQ_SOURCE_LINE 00001406 ""
NSQ_SOURCE_LINE 00001407 ""
NSQ_SOURCE_LINE 00001408 "=over 4"
NSQ_SOURCE_LINE 00001409 ""
NSQ_SOURCE_LINE 00001410 "=item B<num_method_tests>"
NSQ_SOURCE_LINE 00001411 ""
NSQ_SOURCE_LINE 00001412 "  $n = $Tests->num_method_tests($method_name)"
NSQ_SOURCE_LINE 00001413 "  $Tests->num_method_tests($method_name, $n)"
NSQ_SOURCE_LINE 00001414 "  $n = CLASS->num_method_tests($method_name)"
NSQ_SOURCE_LINE 00001415 "  CLASS->num_method_tests($method_name, $n)"
NSQ_SOURCE_LINE 00001416 ""
NSQ_SOURCE_LINE 00001417 "Fetch or set the number of tests that the named method is expected to run."
NSQ_SOURCE_LINE 00001418 ""
NSQ_SOURCE_LINE 00001419 "If the method has an undetermined number of tests then $n should be the string C<no_plan>."
NSQ_SOURCE_LINE 00001420 ""
NSQ_SOURCE_LINE 00001421 "If the method is extending the number of tests run by the method in a superclass then $n should have a C<+> prefix."
NSQ_SOURCE_LINE 00001422 ""
NSQ_SOURCE_LINE 00001423 "When called as a class method any change to the expected number of tests applies to all future test objects. Existing test objects are unaffected."
NSQ_SOURCE_LINE 00001424 ""
NSQ_SOURCE_LINE 00001425 "When called as an object method any change to the expected number of tests applies to that object alone."
NSQ_SOURCE_LINE 00001426 ""
NSQ_SOURCE_LINE 00001427 "C<num_method_tests> is useful when you need to set the expected number of tests at object creation time, rather than at compile time."
NSQ_SOURCE_LINE 00001428 ""
NSQ_SOURCE_LINE 00001429 "For example, the following test class will run a different number of tests depending on the number of objects supplied."
NSQ_SOURCE_LINE 00001430 ""
NSQ_SOURCE_LINE 00001431 "  package Object::Test;"
NSQ_SOURCE_LINE 00001432 "  use base qw(Test::Class);"
NSQ_SOURCE_LINE 00001433 "  use Test::More;"
NSQ_SOURCE_LINE 00001434 ""
NSQ_SOURCE_LINE 00001435 "  sub new {"
NSQ_SOURCE_LINE 00001436 "      my $class = shift;"
NSQ_SOURCE_LINE 00001437 "      my $self = $class->SUPER::new(@_);"
NSQ_SOURCE_LINE 00001438 "      my $num_objects = @{$self->{objects}};"
NSQ_SOURCE_LINE 00001439 "      $self->num_method_tests('test_objects', $num_objects);"
NSQ_SOURCE_LINE 00001440 "      return($self);"
NSQ_SOURCE_LINE 00001441 "  }"
NSQ_SOURCE_LINE 00001442 ""
NSQ_SOURCE_LINE 00001443 "  sub test_objects : Tests {"
NSQ_SOURCE_LINE 00001444 "    my $self = shift;"
NSQ_SOURCE_LINE 00001445 "    ok($_->open, \"opened $_\") foreach @{$self->{objects}};"
NSQ_SOURCE_LINE 00001446 "  }"
NSQ_SOURCE_LINE 00001447 "  ..."
NSQ_SOURCE_LINE 00001448 "  # This runs two tests"
NSQ_SOURCE_LINE 00001449 "  Object::Test->new(objects => [$o1, $o2]);"
NSQ_SOURCE_LINE 00001450 ""
NSQ_SOURCE_LINE 00001451 "The advantage of setting the number of tests at object creation time, rather than using a test method without a plan, is that the number of expected tests can be determined before testing begins. This allows better diagnostics from L<runtests()|/\"runtests\">, L<Test::Builder> and L<Test::Harness>."
NSQ_SOURCE_LINE 00001452 ""
NSQ_SOURCE_LINE 00001453 "C<num_method_tests> is a protected method and can only be called by subclasses of Test::Class. It fetches or sets the expected number of tests for the methods of the class it was I<called in>, not the methods of the object/class it was I<applied to>. This allows test classes that use C<num_method_tests> to be subclassed easily."
NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 "For example, consider the creation of a subclass of Object::Test that ensures that all the opened objects are read-only:"
NSQ_SOURCE_LINE 00001456 ""
NSQ_SOURCE_LINE 00001457 "  package Special::Object::Test;"
NSQ_SOURCE_LINE 00001458 "  use base qw(Object::Test);"
NSQ_SOURCE_LINE 00001459 "  use Test::More;"
NSQ_SOURCE_LINE 00001460 ""
NSQ_SOURCE_LINE 00001461 "  sub test_objects : Test(+1) {"
NSQ_SOURCE_LINE 00001462 "      my $self = shift;"
NSQ_SOURCE_LINE 00001463 "      $self->SUPER::test_objects;"
NSQ_SOURCE_LINE 00001464 "      my @bad_objects = grep {! $_->read_only} (@{$self->{objects}});"
NSQ_SOURCE_LINE 00001465 "      ok(@bad_objects == 0, \"all objects read only\");"
NSQ_SOURCE_LINE 00001466 "  }"
NSQ_SOURCE_LINE 00001467 "  ..."
NSQ_SOURCE_LINE 00001468 "  # This runs three tests"
NSQ_SOURCE_LINE 00001469 "  Special::Object::Test->new(objects => [$o1, $o2]);"
NSQ_SOURCE_LINE 00001470 ""
NSQ_SOURCE_LINE 00001471 "Since the call to C<num_method_tests> in Object::Test only affects the C<test_objects> of Object::Test, the above works as you would expect."
NSQ_SOURCE_LINE 00001472 ""
NSQ_SOURCE_LINE 00001473 ""
NSQ_SOURCE_LINE 00001474 "=item B<num_tests>"
NSQ_SOURCE_LINE 00001475 ""
NSQ_SOURCE_LINE 00001476 "  $n = $Tests->num_tests"
NSQ_SOURCE_LINE 00001477 "  $Tests->num_tests($n)"
NSQ_SOURCE_LINE 00001478 "  $n = CLASS->num_tests"
NSQ_SOURCE_LINE 00001479 "  CLASS->num_tests($n)"
NSQ_SOURCE_LINE 00001480 ""
NSQ_SOURCE_LINE 00001481 "Set or return the number of expected tests associated with the currently running test method. This is the same as calling L<num_method_tests()|/\"num_method_tests\"> with a method name of L<current_method()|/\"current_method\">."
NSQ_SOURCE_LINE 00001482 ""
NSQ_SOURCE_LINE 00001483 "For example:"
NSQ_SOURCE_LINE 00001484 ""
NSQ_SOURCE_LINE 00001485 "  sub txt_files_readable : Tests {"
NSQ_SOURCE_LINE 00001486 "      my $self = shift;"
NSQ_SOURCE_LINE 00001487 "      my @files = <*.txt>;"
NSQ_SOURCE_LINE 00001488 "      $self->num_tests(scalar(@files));"
NSQ_SOURCE_LINE 00001489 "      ok(-r $_, \"$_ readable\") foreach (@files);"
NSQ_SOURCE_LINE 00001490 "  }"
NSQ_SOURCE_LINE 00001491 ""
NSQ_SOURCE_LINE 00001492 "Setting the number of expected tests at run time, rather than just having a C<no_plan> test method, allows L<runtests()|/\"runtests\"> to display appropriate diagnostic messages if the method runs a different number of tests."
NSQ_SOURCE_LINE 00001493 ""
NSQ_SOURCE_LINE 00001494 "=back"
NSQ_SOURCE_LINE 00001495 ""
NSQ_SOURCE_LINE 00001496 ""
NSQ_SOURCE_LINE 00001497 "=head2 Support methods"
NSQ_SOURCE_LINE 00001498 ""
NSQ_SOURCE_LINE 00001499 "=over 4"
NSQ_SOURCE_LINE 00001500 ""
NSQ_SOURCE_LINE 00001501 "=item B<builder>"
NSQ_SOURCE_LINE 00001502 ""
NSQ_SOURCE_LINE 00001503 "  $Tests->builder"
NSQ_SOURCE_LINE 00001504 ""
NSQ_SOURCE_LINE 00001505 "Returns the underlying L<Test::Builder> object that Test::Class uses. For example:"
NSQ_SOURCE_LINE 00001506 ""
NSQ_SOURCE_LINE 00001507 "  sub test_close : Test {"
NSQ_SOURCE_LINE 00001508 "      my $self = shift;"
NSQ_SOURCE_LINE 00001509 "      my ($o, $dbh) = ($self->{object}, $self->{dbh});"
NSQ_SOURCE_LINE 00001510 "      $self->builder->ok($o->close($dbh), \"closed ok\");"
NSQ_SOURCE_LINE 00001511 "  }"
NSQ_SOURCE_LINE 00001512 ""
NSQ_SOURCE_LINE 00001513 "=item B<current_method>"
NSQ_SOURCE_LINE 00001514 ""
NSQ_SOURCE_LINE 00001515 "  $method_name = $Tests->current_method"
NSQ_SOURCE_LINE 00001516 "  $method_name = CLASS->current_method"
NSQ_SOURCE_LINE 00001517 ""
NSQ_SOURCE_LINE 00001518 "Returns the name of the test method currently being executed by L<runtests()|/\"runtests\">, or C<undef> if L<runtests()|/\"runtests\"> has not been called."
NSQ_SOURCE_LINE 00001519 ""
NSQ_SOURCE_LINE 00001520 "The method name is also available in the setup and teardown methods that run before and after the test method. This can be useful in producing diagnostic messages, for example:"
NSQ_SOURCE_LINE 00001521 ""
NSQ_SOURCE_LINE 00001522 "  sub test_invarient : Test(teardown => 1) {"
NSQ_SOURCE_LINE 00001523 "      my $self = shift;"
NSQ_SOURCE_LINE 00001524 "      my $m = $self->current_method;"
NSQ_SOURCE_LINE 00001525 "      ok($self->invarient_ok, \"class okay after $m\");"
NSQ_SOURCE_LINE 00001526 "  }"
NSQ_SOURCE_LINE 00001527 ""
NSQ_SOURCE_LINE 00001528 ""
NSQ_SOURCE_LINE 00001529 ""
NSQ_SOURCE_LINE 00001530 "=item B<BAILOUT>"
NSQ_SOURCE_LINE 00001531 ""
NSQ_SOURCE_LINE 00001532 "  $Tests->BAILOUT($reason)"
NSQ_SOURCE_LINE 00001533 "  CLASS->BAILOUT($reason)"
NSQ_SOURCE_LINE 00001534 ""
NSQ_SOURCE_LINE 00001535 "Things are going so badly all testing should terminate, including running any additional test scripts invoked by L<Test::Harness>. This is exactly the same as doing:"
NSQ_SOURCE_LINE 00001536 ""
NSQ_SOURCE_LINE 00001537 "  $self->builder->BAILOUT"
NSQ_SOURCE_LINE 00001538 ""
NSQ_SOURCE_LINE 00001539 "See L<Test::Builder/\"BAILOUT\"> for details. Any teardown and shutdown methods are I<not> run."
NSQ_SOURCE_LINE 00001540 ""
NSQ_SOURCE_LINE 00001541 ""
NSQ_SOURCE_LINE 00001542 "=item B<FAIL_ALL>"
NSQ_SOURCE_LINE 00001543 ""
NSQ_SOURCE_LINE 00001544 "  $Tests->FAIL_ALL($reason)"
NSQ_SOURCE_LINE 00001545 "  CLASS->FAIL_ALL($reason)"
NSQ_SOURCE_LINE 00001546 ""
NSQ_SOURCE_LINE 00001547 "Things are going so badly all the remaining tests in the current script should fail. Exits immediately with the number of tests failed, or C<254> if more than 254 tests were run. Any teardown methods are I<not> run."
NSQ_SOURCE_LINE 00001548 ""
NSQ_SOURCE_LINE 00001549 "This does not affect the running of any other test scripts invoked by L<Test::Harness>."
NSQ_SOURCE_LINE 00001550 ""
NSQ_SOURCE_LINE 00001551 "For example, if all your tests rely on the ability to create objects then you might want something like this as an early test:"
NSQ_SOURCE_LINE 00001552 ""
NSQ_SOURCE_LINE 00001553 "  sub _test_new : Test(3) {"
NSQ_SOURCE_LINE 00001554 "      my $self = shift;"
NSQ_SOURCE_LINE 00001555 "      isa_ok(Object->new, \"Object\")"
NSQ_SOURCE_LINE 00001556 "          || $self->FAIL_ALL('cannot create Objects');"
NSQ_SOURCE_LINE 00001557 "      ..."
NSQ_SOURCE_LINE 00001558 "  }"
NSQ_SOURCE_LINE 00001559 ""
NSQ_SOURCE_LINE 00001560 ""
NSQ_SOURCE_LINE 00001561 ""
NSQ_SOURCE_LINE 00001562 "=item B<SKIP_ALL>"
NSQ_SOURCE_LINE 00001563 ""
NSQ_SOURCE_LINE 00001564 "  $Tests->SKIP_ALL($reason)"
NSQ_SOURCE_LINE 00001565 "  CLASS->SKIP_ALL($reason)"
NSQ_SOURCE_LINE 00001566 ""
NSQ_SOURCE_LINE 00001567 "Things are going so badly all the remaining tests in the current script should be skipped. Exits immediately with C<0> - teardown methods are I<not> run."
NSQ_SOURCE_LINE 00001568 ""
NSQ_SOURCE_LINE 00001569 "This does not affect the running of any other test scripts invoked by L<Test::Harness>."
NSQ_SOURCE_LINE 00001570 ""
NSQ_SOURCE_LINE 00001571 "For example, if you had a test script that only applied to the darwin OS you could write:"
NSQ_SOURCE_LINE 00001572 ""
NSQ_SOURCE_LINE 00001573 "  sub _darwin_only : Test(setup) {"
NSQ_SOURCE_LINE 00001574 "      my $self = shift;"
NSQ_SOURCE_LINE 00001575 "      $self->SKIP_ALL(\"darwin only\") unless $^O eq \"darwin\";"
NSQ_SOURCE_LINE 00001576 "  }"
NSQ_SOURCE_LINE 00001577 ""
NSQ_SOURCE_LINE 00001578 ""
NSQ_SOURCE_LINE 00001579 "=item B<add_testinfo>"
NSQ_SOURCE_LINE 00001580 ""
NSQ_SOURCE_LINE 00001581 "  CLASS->add_testinfo($name, $type, $num_tests)"
NSQ_SOURCE_LINE 00001582 ""
NSQ_SOURCE_LINE 00001583 "Chiefly for use by libraries like L<Test::Class::Sugar>, which can't use the C<:Test(...)> interfaces make test methods. C<add_testinfo> informs the class about a test method that has been defined without a C<Test>, C<Tests> or other attribute."
NSQ_SOURCE_LINE 00001584 ""
NSQ_SOURCE_LINE 00001585 "C<$name> is the name of the method, C<$type> must be one of C<startup>, C<setup>, C<test>, C<teardown> or C<shutdown>, and C<$num_tests> has the same meaning as C<N> in the description of the L<Test|/\"Test\"> attribute."
NSQ_SOURCE_LINE 00001586 ""
NSQ_SOURCE_LINE 00001587 ""
NSQ_SOURCE_LINE 00001588 "=item B<add_filter>"
NSQ_SOURCE_LINE 00001589 ""
NSQ_SOURCE_LINE 00001590 "    CLASS->add_filter($filter_coderef);"
NSQ_SOURCE_LINE 00001591 ""
NSQ_SOURCE_LINE 00001592 "Adds a filtering coderef. Each filter is passed a test class and method name and returns a boolean. All filters are applied globally in the order they were added. If any filter returns false the test method is not run or included in the number of tests."
NSQ_SOURCE_LINE 00001593 ""
NSQ_SOURCE_LINE 00001594 "Note that filters will only be run for normal test methods, they are ignored for startup, shutdown, setup, and teardown test methods."
NSQ_SOURCE_LINE 00001595 ""
NSQ_SOURCE_LINE 00001596 "See the section on the L</\"GENERAL FILTERING OF TESTS\"> for more information."
NSQ_SOURCE_LINE 00001597 ""
NSQ_SOURCE_LINE 00001598 "=item B<fail_if_returned_early>"
NSQ_SOURCE_LINE 00001599 ""
NSQ_SOURCE_LINE 00001600 "Controls what happens if a method returns before it has run all of its tests.  It is called with no arguments in boolean context; if it returns true, then the missing tests fail, otherwise, they skip.  See L<\"Returning Early\"> and L<\"Skipped Tests\">."
NSQ_SOURCE_LINE 00001601 ""
NSQ_SOURCE_LINE 00001602 "=item B<fail_if_returned_late>"
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "Controls what happens if a method returns after running too many tests.  It is called with no arguments in boolean context; if it returns true, then the extra tests trigger a failure test.  See L<\"Returning Late\"> and L<\"Skipped Tests\">."
NSQ_SOURCE_LINE 00001605 ""
NSQ_SOURCE_LINE 00001606 ""
NSQ_SOURCE_LINE 00001607 "=back"
NSQ_SOURCE_LINE 00001608 ""
NSQ_SOURCE_LINE 00001609 ""
NSQ_SOURCE_LINE 00001610 ""
NSQ_SOURCE_LINE 00001611 "=head1 HELP FOR CONFUSED JUNIT USERS"
NSQ_SOURCE_LINE 00001612 ""
NSQ_SOURCE_LINE 00001613 "This section is for people who have used JUnit (or similar) and are confused because they don't see the TestCase/Suite/Runner class framework they were expecting. Here we take each of the major classes in JUnit and compare them with their equivalent Perl testing modules."
NSQ_SOURCE_LINE 00001614 ""
NSQ_SOURCE_LINE 00001615 "=over 4"
NSQ_SOURCE_LINE 00001616 ""
NSQ_SOURCE_LINE 00001617 "=item B<Class Assert>"
NSQ_SOURCE_LINE 00001618 ""
NSQ_SOURCE_LINE 00001619 "The test assertions provided by Assert correspond to the test functions provided by the L<Test::Builder> based modules (L<Test::More>, L<Test::Exception>, L<Test::Differences>, etc.)"
NSQ_SOURCE_LINE 00001620 ""
NSQ_SOURCE_LINE 00001621 "Unlike JUnit the test functions supplied by Test::More et al do I<not> throw exceptions on failure. They just report the failure to STDOUT where it is collected by L<Test::Harness>. This means that where you have"
NSQ_SOURCE_LINE 00001622 ""
NSQ_SOURCE_LINE 00001623 "  sub foo : Test(2) {"
NSQ_SOURCE_LINE 00001624 "      ok($foo->method1);"
NSQ_SOURCE_LINE 00001625 "      ok($foo->method2);"
NSQ_SOURCE_LINE 00001626 "  }"
NSQ_SOURCE_LINE 00001627 ""
NSQ_SOURCE_LINE 00001628 "The second test I<will> run if the first one fails. You can emulate the JUnit way of doing it by throwing an explicit exception on test failure:"
NSQ_SOURCE_LINE 00001629 ""
NSQ_SOURCE_LINE 00001630 "  sub foo : Test(2) {"
NSQ_SOURCE_LINE 00001631 "      ok($foo->method1) or die \"method1 failed\";"
NSQ_SOURCE_LINE 00001632 "      ok($foo->method2);"
NSQ_SOURCE_LINE 00001633 "  }"
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "The exception will be caught by Test::Class and the other test automatically failed."
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 "=item B<Class TestCase>"
NSQ_SOURCE_LINE 00001638 ""
NSQ_SOURCE_LINE 00001639 "Test::Class corresponds to TestCase in JUnit."
NSQ_SOURCE_LINE 00001640 ""
NSQ_SOURCE_LINE 00001641 "In Test::Class setup, test and teardown methods are marked explicitly using the L<Test|/\"Test\"> attribute. Since we need to know the total number of tests to provide a test plan for L<Test::Harness>, we also state how many tests each method runs."
NSQ_SOURCE_LINE 00001642 ""
NSQ_SOURCE_LINE 00001643 "Unlike JUnit you can have multiple setup/teardown methods in a class."
NSQ_SOURCE_LINE 00001644 ""
NSQ_SOURCE_LINE 00001645 "=item B<Class TestSuite>"
NSQ_SOURCE_LINE 00001646 ""
NSQ_SOURCE_LINE 00001647 "Test::Class also does the work that would be done by TestSuite in JUnit."
NSQ_SOURCE_LINE 00001648 ""
NSQ_SOURCE_LINE 00001649 "Since the methods are marked with attributes, Test::Class knows what is and isn't a test method. This allows it to run all the test methods without having the developer create a suite manually, or use reflection to dynamically determine the test methods by name. See the L<runtests()|/\"runtests\"> method for more details."
NSQ_SOURCE_LINE 00001650 ""
NSQ_SOURCE_LINE 00001651 "The running order of the test methods is fixed in Test::Class. Methods are executed in alphabetical order."
NSQ_SOURCE_LINE 00001652 ""
NSQ_SOURCE_LINE 00001653 "To run individual test methods, see L</\"RUNNING INDIVIDUAL TESTS\">."
NSQ_SOURCE_LINE 00001654 ""
NSQ_SOURCE_LINE 00001655 "=item B<Class TestRunner>"
NSQ_SOURCE_LINE 00001656 ""
NSQ_SOURCE_LINE 00001657 "L<Test::Harness> does the work of the TestRunner in JUnit. It collects the test results (sent to STDOUT) and collates the results."
NSQ_SOURCE_LINE 00001658 ""
NSQ_SOURCE_LINE 00001659 "Unlike JUnit there is no distinction made by Test::Harness between errors and failures. However, it does support skipped and todo test - which JUnit does not."
NSQ_SOURCE_LINE 00001660 ""
NSQ_SOURCE_LINE 00001661 "If you want to write your own test runners you should look at L<Test::Harness::Straps>."
NSQ_SOURCE_LINE 00001662 ""
NSQ_SOURCE_LINE 00001663 "=back"
NSQ_SOURCE_LINE 00001664 ""
NSQ_SOURCE_LINE 00001665 ""
NSQ_SOURCE_LINE 00001666 "=head1 OTHER MODULES FOR XUNIT TESTING IN PERL"
NSQ_SOURCE_LINE 00001667 ""
NSQ_SOURCE_LINE 00001668 "In addition to Test::Class there are two other distributions for xUnit testing in perl. Both have a longer history than Test::Class and might be more suitable for your needs."
NSQ_SOURCE_LINE 00001669 ""
NSQ_SOURCE_LINE 00001670 "I am biased since I wrote Test::Class - so please read the following with appropriate levels of scepticism. If you think I have misrepresented the modules please let me know."
NSQ_SOURCE_LINE 00001671 ""
NSQ_SOURCE_LINE 00001672 "=over 4"
NSQ_SOURCE_LINE 00001673 ""
NSQ_SOURCE_LINE 00001674 "=item B<Test::SimpleUnit>"
NSQ_SOURCE_LINE 00001675 ""
NSQ_SOURCE_LINE 00001676 "A very simple unit testing framework. If you are looking for a lightweight single module solution this might be for you."
NSQ_SOURCE_LINE 00001677 ""
NSQ_SOURCE_LINE 00001678 "The advantage of L<Test::SimpleUnit> is that it is simple! Just one module with a smallish API to learn."
NSQ_SOURCE_LINE 00001679 ""
NSQ_SOURCE_LINE 00001680 "Of course this is also the disadvantage."
NSQ_SOURCE_LINE 00001681 ""
NSQ_SOURCE_LINE 00001682 "It's not class based so you cannot create testing classes to reuse and extend."
NSQ_SOURCE_LINE 00001683 ""
NSQ_SOURCE_LINE 00001684 "It doesn't use L<Test::Builder> so it's difficult to extend or integrate with other testing modules. If you are already familiar with L<Test::Builder>, L<Test::More> and friends you will have to learn a new test assertion API. It does not support L<todo tests|Test::Harness/\"Todo tests\">."
NSQ_SOURCE_LINE 00001685 ""
NSQ_SOURCE_LINE 00001686 "=item B<Test::Unit>"
NSQ_SOURCE_LINE 00001687 ""
NSQ_SOURCE_LINE 00001688 "L<Test::Unit> is a port of JUnit L<http://www.junit.org/> into perl. If you have used JUnit then the Test::Unit framework should be very familiar."
NSQ_SOURCE_LINE 00001689 ""
NSQ_SOURCE_LINE 00001690 "It is class based so you can easily reuse your test classes and extend by subclassing. You get a nice flexible framework you can tweak to your heart's content. If you can run Tk you also get a graphical test runner."
NSQ_SOURCE_LINE 00001691 ""
NSQ_SOURCE_LINE 00001692 "However, Test::Unit is not based on L<Test::Builder>. You cannot easily move Test::Builder based test functions into Test::Unit based classes. You have to learn another test assertion API."
NSQ_SOURCE_LINE 00001693 ""
NSQ_SOURCE_LINE 00001694 "Test::Unit implements it's own testing framework separate from L<Test::Harness>. You can retrofit *.t scripts as unit tests, and output test results in the format that L<Test::Harness> expects, but things like L<todo tests|Test::Harness/\"Todo tests\"> and L<skipping tests|Test::Harness/\"Skipping tests\"> are not supported."
NSQ_SOURCE_LINE 00001695 ""
NSQ_SOURCE_LINE 00001696 "=back"
NSQ_SOURCE_LINE 00001697 ""
NSQ_SOURCE_LINE 00001698 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00001699 ""
NSQ_SOURCE_LINE 00001700 "Bugs may be submitted through L<GitHub issues|https://github.com/szabgab/test-class/issues>"
NSQ_SOURCE_LINE 00001701 ""
NSQ_SOURCE_LINE 00001702 "There is also an irc channel available for users of this distribution, at"
NSQ_SOURCE_LINE 00001703 "L<C<#perl-qa> on C<irc.perl.org>|irc://irc.perl.org/#perl-qa>."
NSQ_SOURCE_LINE 00001704 ""
NSQ_SOURCE_LINE 00001705 "=head1 TO DO"
NSQ_SOURCE_LINE 00001706 ""
NSQ_SOURCE_LINE 00001707 "If you think this module should do something that it doesn't (or does something that it shouldn't) please let me know."
NSQ_SOURCE_LINE 00001708 ""
NSQ_SOURCE_LINE 00001709 "You can see an old to do list at L<http://adrianh.tadalist.com/lists/public/4798>, with an RSS feed of changes at L<http://adrianh.tadalist.com/lists/feed_public/4798>."
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 ""
