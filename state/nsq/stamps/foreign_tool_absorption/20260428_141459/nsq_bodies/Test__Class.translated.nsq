NSQ_SOURCE_LINE 00000138 "sub _get_methods {"
NSQ_SOURCE_LINE 00000139 "    my ( $self, @types ) = @_;"
NSQ_SOURCE_LINE 00000140 "    my $test_class = _class_of( $self );"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "    my $test_method_regexp = $ENV{ TEST_METHOD } || '.*';"
NSQ_SOURCE_LINE 00000143 "    my $method_regexp = eval { qr/\\A$test_method_regexp\\z/ };"
NSQ_SOURCE_LINE 00000144 "    die \"TEST_METHOD ($test_method_regexp) is not a valid regexp: $@\" if $@;"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    my %methods = ();"
NSQ_SOURCE_LINE 00000147 "    foreach my $class ( @{mro::get_linear_isa( $test_class )} ) {"
NSQ_SOURCE_LINE 00000148 "      FILTER:"
NSQ_SOURCE_LINE 00000149 "        foreach my $info ( _methods_of_class( $self, $class ) ) {"
NSQ_SOURCE_LINE 00000150 "            my $name = $info->name;"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "            if ( $info->type eq TEST ) {"
NSQ_SOURCE_LINE 00000153 "                # determine if method is filtered, true if *any* filter"
NSQ_SOURCE_LINE 00000154 "                # returns false."
NSQ_SOURCE_LINE 00000155 "                foreach my $filter ( @Filters ) {"
NSQ_SOURCE_LINE 00000156 "                    next FILTER unless $filter->( $class, $name );"
NSQ_SOURCE_LINE 00000157 "                }"
NSQ_SOURCE_LINE 00000158 "            }"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "            foreach my $type ( @types ) {"
NSQ_SOURCE_LINE 00000161 "                if ( $info->is_type( $type ) ) {"
NSQ_SOURCE_LINE 00000162 "                    $methods{ $name } = 1"
NSQ_SOURCE_LINE 00000163 "                        unless $type eq TEST && $name !~ $method_regexp;"
NSQ_SOURCE_LINE 00000164 "                }"
NSQ_SOURCE_LINE 00000165 "            }"
NSQ_SOURCE_LINE 00000166 "        }"
NSQ_SOURCE_LINE 00000167 "    }"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    my @methods = sort keys %methods;"
NSQ_SOURCE_LINE 00000170 "    return @methods;"
NSQ_SOURCE_LINE 00000171 "}"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "sub _num_expected_tests {"
NSQ_SOURCE_LINE 00000174 "    my $self = shift;"
NSQ_SOURCE_LINE 00000175 "    if (my $reason = $self->SKIP_CLASS ) {"
NSQ_SOURCE_LINE 00000176 "       return $reason eq \"1\" ? 0 : 1;"
NSQ_SOURCE_LINE 00000177 "    };"
NSQ_SOURCE_LINE 00000178 "    my @test_methods = _get_methods($self, TEST);"
NSQ_SOURCE_LINE 00000179 "    return 0 unless @test_methods;"
NSQ_SOURCE_LINE 00000180 "    my @startup_shutdown_methods ="
NSQ_SOURCE_LINE 00000181 "            _get_methods($self, STARTUP, SHUTDOWN);"
NSQ_SOURCE_LINE 00000182 "    my $num_startup_shutdown_methods ="
NSQ_SOURCE_LINE 00000183 "            _total_num_tests($self, @startup_shutdown_methods);"
NSQ_SOURCE_LINE 00000184 "    return(NO_PLAN) if $num_startup_shutdown_methods eq NO_PLAN;"
NSQ_SOURCE_LINE 00000185 "    my @fixture_methods = _get_methods($self, SETUP, TEARDOWN);"
NSQ_SOURCE_LINE 00000186 "    my $num_fixture_tests = _total_num_tests($self, @fixture_methods);"
NSQ_SOURCE_LINE 00000187 "    return(NO_PLAN) if $num_fixture_tests eq NO_PLAN;"
NSQ_SOURCE_LINE 00000188 "    my $num_tests = _total_num_tests($self, @test_methods);"
NSQ_SOURCE_LINE 00000189 "    return(NO_PLAN) if $num_tests eq NO_PLAN;"
NSQ_SOURCE_LINE 00000190 "    return($num_startup_shutdown_methods + $num_tests + @test_methods * $num_fixture_tests);"
NSQ_SOURCE_LINE 00000191 "}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "sub expected_tests {"
NSQ_SOURCE_LINE 00000194 "    my $total = 0;"
NSQ_SOURCE_LINE 00000195 "    foreach my $test (@_) {"
NSQ_SOURCE_LINE 00000196 "        if ( _isa_class( __PACKAGE__, $test ) ) {"
NSQ_SOURCE_LINE 00000197 "            my $n = _num_expected_tests($test);"
NSQ_SOURCE_LINE 00000198 "            return NO_PLAN if $n eq NO_PLAN;"
NSQ_SOURCE_LINE 00000199 "            $total += $n;"
NSQ_SOURCE_LINE 00000200 "        } elsif ( defined $test && $test =~ m/^\\d+$/ ) {"
NSQ_SOURCE_LINE 00000201 "            $total += $test;"
NSQ_SOURCE_LINE 00000202 "        } else {"
NSQ_SOURCE_LINE 00000203 "            $test = 'undef' unless defined $test;"
NSQ_SOURCE_LINE 00000204 "            croak \"$test is not a Test::Class or an integer\";"
NSQ_SOURCE_LINE 00000205 "        }"
NSQ_SOURCE_LINE 00000206 "    }"
NSQ_SOURCE_LINE 00000207 "    return $total;"
NSQ_SOURCE_LINE 00000208 "}"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "sub _total_num_tests {"
NSQ_SOURCE_LINE 00000211 "    my ($self, @methods) = @_;"
NSQ_SOURCE_LINE 00000212 "    my $class = _class_of( $self );"
NSQ_SOURCE_LINE 00000213 "    my $total_num_tests = 0;"
NSQ_SOURCE_LINE 00000214 "    foreach my $method (@methods) {"
NSQ_SOURCE_LINE 00000215 "        foreach my $class (@{mro::get_linear_isa($class)}) {"
NSQ_SOURCE_LINE 00000216 "            my $info = _method_info($self, $class, $method);"
NSQ_SOURCE_LINE 00000217 "            next unless $info;"
NSQ_SOURCE_LINE 00000218 "            my $num_tests = $info->num_tests;"
NSQ_SOURCE_LINE 00000219 "            return(NO_PLAN) if ($num_tests eq NO_PLAN);"
NSQ_SOURCE_LINE 00000220 "            $total_num_tests += $num_tests;"
NSQ_SOURCE_LINE 00000221 "            last unless $num_tests =~ m/^\\+/"
NSQ_SOURCE_LINE 00000222 "        }"
NSQ_SOURCE_LINE 00000223 "    }"
NSQ_SOURCE_LINE 00000224 "    return($total_num_tests);"
NSQ_SOURCE_LINE 00000225 "}"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "sub _has_no_tests {"
NSQ_SOURCE_LINE 00000228 "    my ( $self, $method ) = @_;"
NSQ_SOURCE_LINE 00000229 "    return _total_num_tests( $self, $method ) eq '0';"
NSQ_SOURCE_LINE 00000230 "}"
