NSQ_SOURCE_LINE 00000085 "sub _is_public_method {"
NSQ_SOURCE_LINE 00000086 "    my ($class, $name) = @_;"
NSQ_SOURCE_LINE 00000087 "    my @parents = @{mro::get_linear_isa($class)};"
NSQ_SOURCE_LINE 00000088 "    shift @parents;"
NSQ_SOURCE_LINE 00000089 "    foreach my $parent_class ( @parents ) {"
NSQ_SOURCE_LINE 00000090 "        return unless $parent_class->can( $name );"
NSQ_SOURCE_LINE 00000091 "        return if _method_info( $class, $parent_class, $name );"
NSQ_SOURCE_LINE 00000092 "    }"
NSQ_SOURCE_LINE 00000093 "    return 1;"
NSQ_SOURCE_LINE 00000094 "}"
