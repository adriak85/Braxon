NSQ_SOURCE_LINE 00000232 "sub _all_ok_from {"
NSQ_SOURCE_LINE 00000233 "    my ($self, $start_test) = @_;"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "    # The Test::Builder 1.5 way to do it"
NSQ_SOURCE_LINE 00000236 "    if( $Builder->can(\"history\") ) {"
NSQ_SOURCE_LINE 00000237 "        return $Builder->history->can_succeed;"
NSQ_SOURCE_LINE 00000238 "    }"
NSQ_SOURCE_LINE 00000239 "    # The Test::Builder 0.x way to do it"
NSQ_SOURCE_LINE 00000240 "    else {"
NSQ_SOURCE_LINE 00000241 "        my $current_test = $Builder->current_test;"
NSQ_SOURCE_LINE 00000242 "        return(1) if $start_test == $current_test;"
NSQ_SOURCE_LINE 00000243 "        my @results = ($Builder->summary)[$start_test .. $current_test-1];"
NSQ_SOURCE_LINE 00000244 "        foreach my $result (@results) { return(0) unless $result }"
NSQ_SOURCE_LINE 00000245 "        return(1);"
NSQ_SOURCE_LINE 00000246 "    }"
NSQ_SOURCE_LINE 00000247 "}"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "sub _exception_failure {"
NSQ_SOURCE_LINE 00000250 "    my ($self, $method, $exception, $tests) = @_;"
NSQ_SOURCE_LINE 00000251 "    local $Test::Builder::Level = 3;"
NSQ_SOURCE_LINE 00000252 "    my $message = $method;"
NSQ_SOURCE_LINE 00000253 "    $message .= \" (for test method '$Current_method')\""
NSQ_SOURCE_LINE 00000254 "            if defined $Current_method && $method ne $Current_method;"
NSQ_SOURCE_LINE 00000255 "    _show_header($self, @$tests);"
NSQ_SOURCE_LINE 00000256 "    chomp $exception;"
NSQ_SOURCE_LINE 00000257 "    $Builder->ok(0, \"$message died ($exception)\");"
NSQ_SOURCE_LINE 00000258 "    _threw_exception( $self, $method => 1 );"
NSQ_SOURCE_LINE 00000259 "}"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "my %threw_exception;"
NSQ_SOURCE_LINE 00000262 "sub _threw_exception {"
NSQ_SOURCE_LINE 00000263 "    my ( $self, $method, $optional_value) = @_;"
NSQ_SOURCE_LINE 00000264 "    my $class = ref( $self );"
NSQ_SOURCE_LINE 00000265 "    $threw_exception{ $class }{ $method } = $optional_value"
NSQ_SOURCE_LINE 00000266 "        if defined $optional_value;"
NSQ_SOURCE_LINE 00000267 "    return $threw_exception{ $class }{ $method };"
NSQ_SOURCE_LINE 00000268 "}"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "sub _run_method {"
NSQ_SOURCE_LINE 00000271 "    my ($self, $method, $tests) = @_;"
NSQ_SOURCE_LINE 00000272 "    _threw_exception( $self, $method => 0 );"
NSQ_SOURCE_LINE 00000273 "    my $num_start = $Builder->current_test;"
NSQ_SOURCE_LINE 00000274 "    my $skip_reason;"
NSQ_SOURCE_LINE 00000275 "    my $original_ok = \\&Test::Builder::ok;"
NSQ_SOURCE_LINE 00000276 "    no warnings;"
NSQ_SOURCE_LINE 00000277 "    local *Test::Builder::ok = sub {"
NSQ_SOURCE_LINE 00000278 "        my ($builder, $test, $description) = @_;"
NSQ_SOURCE_LINE 00000279 "        local $Test::Builder::Level = $Test::Builder::Level+1;"
NSQ_SOURCE_LINE 00000280 "        unless ( defined($description) ) {"
NSQ_SOURCE_LINE 00000281 "            $description = $self->current_method;"
NSQ_SOURCE_LINE 00000282 "            $description =~ tr/_/ /;"
NSQ_SOURCE_LINE 00000283 "        }"
NSQ_SOURCE_LINE 00000284 "        my $is_ok = $original_ok->($builder, $test, $description);"
NSQ_SOURCE_LINE 00000285 "        unless ( $is_ok ) {"
NSQ_SOURCE_LINE 00000286 "            my $class = ref $self;"
NSQ_SOURCE_LINE 00000287 "            $Builder->diag( \"  (in $class->$method)\" );"
NSQ_SOURCE_LINE 00000288 "        }"
NSQ_SOURCE_LINE 00000289 "        return $is_ok;"
NSQ_SOURCE_LINE 00000290 "    };"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "    my $exception;"
NSQ_SOURCE_LINE 00000293 "    $skip_reason = try { $self->$method } catch { $exception = $_; undef };"
NSQ_SOURCE_LINE 00000294 "    $skip_reason = $method unless $skip_reason;"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "    my $num_done = $Builder->current_test - $num_start;"
NSQ_SOURCE_LINE 00000297 "    my $num_expected = _total_num_tests($self, $method);"
NSQ_SOURCE_LINE 00000298 "    $num_expected = $num_done if $num_expected eq NO_PLAN;"
NSQ_SOURCE_LINE 00000299 "    if ($num_done == $num_expected) {"
NSQ_SOURCE_LINE 00000300 "        _exception_failure($self, $method, $exception, $tests)"
NSQ_SOURCE_LINE 00000301 "                if $exception;"
NSQ_SOURCE_LINE 00000302 "    } elsif ($num_done > $num_expected) {"
NSQ_SOURCE_LINE 00000303 "        local $Test::Builder::Level = $Test::Builder::Level+1;"
NSQ_SOURCE_LINE 00000304 "        my $class = ref $self;"
NSQ_SOURCE_LINE 00000305 "        if ($self->fail_if_returned_late) {"
NSQ_SOURCE_LINE 00000306 "            $Builder->ok(0, \"expected $num_expected test(s) in $class\\::$method, $num_done completed\");"
NSQ_SOURCE_LINE 00000307 "        } else {"
NSQ_SOURCE_LINE 00000308 "            $Builder->diag(\"expected $num_expected test(s) in $class\\::$method, $num_done completed\\n\");"
NSQ_SOURCE_LINE 00000309 "        }"
NSQ_SOURCE_LINE 00000310 "    } else {"
NSQ_SOURCE_LINE 00000311 "        until (($Builder->current_test - $num_start) >= $num_expected) {"
NSQ_SOURCE_LINE 00000312 "            if ($exception) {"
NSQ_SOURCE_LINE 00000313 "                _exception_failure($self, $method, $exception, $tests);"
NSQ_SOURCE_LINE 00000314 "                $skip_reason = \"$method died\";"
NSQ_SOURCE_LINE 00000315 "                $exception = '';"
NSQ_SOURCE_LINE 00000316 "            } else {"
NSQ_SOURCE_LINE 00000317 "                local $Test::Builder::Level = $Test::Builder::Level+1;"
NSQ_SOURCE_LINE 00000318 "                if ($self->fail_if_returned_early) {"
NSQ_SOURCE_LINE 00000319 "                    my $class = ref $self;"
NSQ_SOURCE_LINE 00000320 "                    $Builder->ok(0, \"($class\\::$method returned before plan complete)\");"
NSQ_SOURCE_LINE 00000321 "                } else {"
NSQ_SOURCE_LINE 00000322 "                    $Builder->skip( $skip_reason );"
NSQ_SOURCE_LINE 00000323 "                }"
NSQ_SOURCE_LINE 00000324 "            }"
NSQ_SOURCE_LINE 00000325 "        }"
NSQ_SOURCE_LINE 00000326 "    }"
NSQ_SOURCE_LINE 00000327 "    return(_all_ok_from($self, $num_start));"
NSQ_SOURCE_LINE 00000328 "}"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "sub fail_if_returned_early { 0 }"
NSQ_SOURCE_LINE 00000331 "sub fail_if_returned_late { 0 }"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "sub _show_header {"
NSQ_SOURCE_LINE 00000334 "    my ($self, @tests) = @_;"
NSQ_SOURCE_LINE 00000335 "    return if $Builder->has_plan;"
NSQ_SOURCE_LINE 00000336 "    my $num_tests = Test::Class->expected_tests(@tests);"
NSQ_SOURCE_LINE 00000337 "    if ($num_tests eq NO_PLAN) {"
NSQ_SOURCE_LINE 00000338 "        $Builder->no_plan;"
NSQ_SOURCE_LINE 00000339 "    } else {"
NSQ_SOURCE_LINE 00000340 "        $Builder->expected_tests($num_tests);"
NSQ_SOURCE_LINE 00000341 "    }"
NSQ_SOURCE_LINE 00000342 "}"
