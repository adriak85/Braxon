NSQ_SOURCE_LINE 00001827 ""
NSQ_SOURCE_LINE 00001828 "=item L<Test::Builder>"
NSQ_SOURCE_LINE 00001829 ""
NSQ_SOURCE_LINE 00001830 "Support module for building test libraries."
NSQ_SOURCE_LINE 00001831 ""
NSQ_SOURCE_LINE 00001832 "=item L<Test::Simple> & L<Test::More>"
NSQ_SOURCE_LINE 00001833 ""
NSQ_SOURCE_LINE 00001834 "Basic utilities for writing tests."
NSQ_SOURCE_LINE 00001835 ""
NSQ_SOURCE_LINE 00001836 "=item L<https://qa.perl.org/test-modules.html>"
NSQ_SOURCE_LINE 00001837 ""
NSQ_SOURCE_LINE 00001838 "Overview of some of the many testing modules available on CPAN."
NSQ_SOURCE_LINE 00001839 ""
NSQ_SOURCE_LINE 00001840 "=item L<Test::Object>"
NSQ_SOURCE_LINE 00001841 ""
NSQ_SOURCE_LINE 00001842 "Another approach to object oriented testing."
NSQ_SOURCE_LINE 00001843 ""
NSQ_SOURCE_LINE 00001844 "=item L<Test::Group> and L<Test::Block>"
