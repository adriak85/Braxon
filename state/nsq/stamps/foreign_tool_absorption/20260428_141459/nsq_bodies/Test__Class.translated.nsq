NSQ_SOURCE_LINE 00000096 "sub Test : ATTR(CODE,RAWDATA) {"
NSQ_SOURCE_LINE 00000097 "    my ($class, $symbol, $code_ref, $attr, $args) = @_;"
NSQ_SOURCE_LINE 00000098 "    if ($symbol eq \"ANON\") {"
NSQ_SOURCE_LINE 00000099 "        warn \"cannot test anonymous subs - you probably loaded a Test::Class too late (after the CHECK block was run). See 'A NOTE ON LOADING TEST CLASSES' in perldoc Test::Class for more details\\n\";"
NSQ_SOURCE_LINE 00000100 "    } else {"
NSQ_SOURCE_LINE 00000101 "        my $name = *{$symbol}{NAME};"
NSQ_SOURCE_LINE 00000102 "        warn \"overriding public method $name with a test method in $class\\n\""
NSQ_SOURCE_LINE 00000103 "                if _is_public_method( $class, $name );"
NSQ_SOURCE_LINE 00000104 "        eval { $class->add_testinfo($name, _parse_attribute_args($args)) }"
NSQ_SOURCE_LINE 00000105 "            || warn \"bad test definition '$args' in $class->$name\\n\";"
NSQ_SOURCE_LINE 00000106 "    }"
NSQ_SOURCE_LINE 00000107 "}"
NSQ_SOURCE_LINE 00000108 ""
