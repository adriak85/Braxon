NSQ_SOURCE_LINE 00000453 "toes"
NSQ_SOURCE_LINE 00000454 "/);"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "my %oes;"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "@oes{@oes} = (1) x @oes;"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "# A store of words which end in \"ie\" and whose plural ends in \"ies\"."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "# References:"
NSQ_SOURCE_LINE 00000463 "# http://www.scrabblefinder.com/ends-with/ie/"
NSQ_SOURCE_LINE 00000464 "# (most of the words are invalid, the above list was manually searched"
NSQ_SOURCE_LINE 00000465 "# for useful words)."
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "# Also get a good list using"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "# perl -n -e 'print if /ie$/' < /usr/share/dict/words "
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "# There are too many obscure words there though."
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "# Also, I'm deliberately not including \"Bernie\" and \"Bessie\" since the"
NSQ_SOURCE_LINE 00000474 "# plurals are rare I think. "
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "my @ies = (qw/"
NSQ_SOURCE_LINE 00000477 "Aussies"
NSQ_SOURCE_LINE 00000478 "Valkryies"
NSQ_SOURCE_LINE 00000479 "aunties"
NSQ_SOURCE_LINE 00000480 "bogies"
NSQ_SOURCE_LINE 00000481 "brownies"
NSQ_SOURCE_LINE 00000482 "calories"
NSQ_SOURCE_LINE 00000483 "charlies"
NSQ_SOURCE_LINE 00000484 "coolies"
NSQ_SOURCE_LINE 00000485 "coteries"
NSQ_SOURCE_LINE 00000486 "curies"
NSQ_SOURCE_LINE 00000487 "cuties"
NSQ_SOURCE_LINE 00000488 "dies"
NSQ_SOURCE_LINE 00000489 "genies"
NSQ_SOURCE_LINE 00000490 "goalies"
NSQ_SOURCE_LINE 00000491 "kilocalories"
NSQ_SOURCE_LINE 00000492 "lies"
NSQ_SOURCE_LINE 00000493 "magpies"
NSQ_SOURCE_LINE 00000494 "menagerie"
NSQ_SOURCE_LINE 00000495 "movies"
NSQ_SOURCE_LINE 00000496 "neckties"
NSQ_SOURCE_LINE 00000497 "pies"
NSQ_SOURCE_LINE 00000498 "porkpies"
NSQ_SOURCE_LINE 00000499 "prairies"
NSQ_SOURCE_LINE 00000500 "quickies"
NSQ_SOURCE_LINE 00000501 "reveries"
NSQ_SOURCE_LINE 00000502 "rookies"
NSQ_SOURCE_LINE 00000503 "sorties"
NSQ_SOURCE_LINE 00000504 "stogies"
NSQ_SOURCE_LINE 00000505 "talkies"
NSQ_SOURCE_LINE 00000506 "ties"
NSQ_SOURCE_LINE 00000507 "zombies"
NSQ_SOURCE_LINE 00000508 "/);"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "my %ies;"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "@ies{@ies} = (1) x @ies;"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "# Words which end in -se, so that we want the singular to change from"
NSQ_SOURCE_LINE 00000515 "# -ses to -se. This also contains verbs like \"deceases\", so that they"
NSQ_SOURCE_LINE 00000516 "# don't trigger spell checker errors."
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "my @ses = (qw/"
NSQ_SOURCE_LINE 00000519 "automates"
NSQ_SOURCE_LINE 00000520 "bases"
NSQ_SOURCE_LINE 00000521 "cases"
NSQ_SOURCE_LINE 00000522 "causes"
NSQ_SOURCE_LINE 00000523 "ceases"
NSQ_SOURCE_LINE 00000524 "closes"
NSQ_SOURCE_LINE 00000525 "cornflakes"
NSQ_SOURCE_LINE 00000526 "creases"
NSQ_SOURCE_LINE 00000527 "databases"
NSQ_SOURCE_LINE 00000528 "deceases"
NSQ_SOURCE_LINE 00000529 "flakes"
NSQ_SOURCE_LINE 00000530 "horses"
NSQ_SOURCE_LINE 00000531 "increases"
NSQ_SOURCE_LINE 00000532 "mates"
NSQ_SOURCE_LINE 00000533 "parses"
NSQ_SOURCE_LINE 00000534 "purposes"
NSQ_SOURCE_LINE 00000535 "races"
NSQ_SOURCE_LINE 00000536 "releases"
NSQ_SOURCE_LINE 00000537 "tenses"
NSQ_SOURCE_LINE 00000538 "/);"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "my %ses;"
NSQ_SOURCE_LINE 00000541 "@ses{@ses} = (1) x @ses;"
NSQ_SOURCE_LINE 00000542 "# A regular expression which matches the end of words like \"dishes\""
NSQ_SOURCE_LINE 00000543 "# and \"sandwiches\". $1 is a capture which contains the part of the"
NSQ_SOURCE_LINE 00000544 "# word which should be kept in a substitution."
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "my $es_re = qr/([^aeiou]s|ch|sh)es$/;"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "# Plurals ending -i, singular is either -us, -o or something else"
NSQ_SOURCE_LINE 00000549 "# See https://en.wiktionary.org/wiki/Category:English_irregular_plurals_ending_in_%22-i%22"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "# -i to -us"
NSQ_SOURCE_LINE 00000552 "my @i_to_us = (qw/"
NSQ_SOURCE_LINE 00000553 "abaci"
NSQ_SOURCE_LINE 00000554 "abaculi"
NSQ_SOURCE_LINE 00000555 "acanthi"
NSQ_SOURCE_LINE 00000556 "acini"
NSQ_SOURCE_LINE 00000557 "alumni"
NSQ_SOURCE_LINE 00000558 "anthocauli"
NSQ_SOURCE_LINE 00000559 "bacilli"
NSQ_SOURCE_LINE 00000560 "baetuli"
NSQ_SOURCE_LINE 00000561 "cacti"
NSQ_SOURCE_LINE 00000562 "calculi"
NSQ_SOURCE_LINE 00000563 "calli"
NSQ_SOURCE_LINE 00000564 "catheti"
NSQ_SOURCE_LINE 00000565 "emboli"
NSQ_SOURCE_LINE 00000566 "emeriti"
NSQ_SOURCE_LINE 00000567 "esophagi"
NSQ_SOURCE_LINE 00000568 "foci"
NSQ_SOURCE_LINE 00000569 "foeti"
NSQ_SOURCE_LINE 00000570 "fumuli"
NSQ_SOURCE_LINE 00000571 "fungi"
NSQ_SOURCE_LINE 00000572 "gonococci"
NSQ_SOURCE_LINE 00000573 "hippopotami"
NSQ_SOURCE_LINE 00000574 "homunculi"
NSQ_SOURCE_LINE 00000575 "incubi"
NSQ_SOURCE_LINE 00000576 "loci"
NSQ_SOURCE_LINE 00000577 "macrofungi"
NSQ_SOURCE_LINE 00000578 "macronuclei"
NSQ_SOURCE_LINE 00000579 "naevi"
NSQ_SOURCE_LINE 00000580 "nuclei"
NSQ_SOURCE_LINE 00000581 "obeli"
NSQ_SOURCE_LINE 00000582 "octopi"
NSQ_SOURCE_LINE 00000583 "oeconomi"
NSQ_SOURCE_LINE 00000584 "oesophagi"
NSQ_SOURCE_LINE 00000585 "panni"
NSQ_SOURCE_LINE 00000586 "periœci"
NSQ_SOURCE_LINE 00000587 "phocomeli"
NSQ_SOURCE_LINE 00000588 "phoeti"
NSQ_SOURCE_LINE 00000589 "platypi"
NSQ_SOURCE_LINE 00000590 "polypi"
NSQ_SOURCE_LINE 00000591 "precunei"
NSQ_SOURCE_LINE 00000592 "radii"
NSQ_SOURCE_LINE 00000593 "rhombi"
NSQ_SOURCE_LINE 00000594 "sarcophagi"
NSQ_SOURCE_LINE 00000595 "solidi"
NSQ_SOURCE_LINE 00000596 "stimuli"
NSQ_SOURCE_LINE 00000597 "succubi"
NSQ_SOURCE_LINE 00000598 "syllabi"
NSQ_SOURCE_LINE 00000599 "thesauri"
NSQ_SOURCE_LINE 00000600 "thrombi"
NSQ_SOURCE_LINE 00000601 "tori"
NSQ_SOURCE_LINE 00000602 "trophi"
NSQ_SOURCE_LINE 00000603 "uteri"
NSQ_SOURCE_LINE 00000604 "viri"
NSQ_SOURCE_LINE 00000605 "virii"
NSQ_SOURCE_LINE 00000606 "xiphopagi"
NSQ_SOURCE_LINE 00000607 "zygomatici"
NSQ_SOURCE_LINE 00000608 "/);"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "my %i_to_us;"
NSQ_SOURCE_LINE 00000611 "@i_to_us{@i_to_us} = (1) x @i_to_us;"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "# -i to -o"
NSQ_SOURCE_LINE 00000614 "my @i_to_o = (qw/"
NSQ_SOURCE_LINE 00000615 "    alveoli"
NSQ_SOURCE_LINE 00000616 "    ghetti"
NSQ_SOURCE_LINE 00000617 "    manifesti"
NSQ_SOURCE_LINE 00000618 "    ostinati"
NSQ_SOURCE_LINE 00000619 "    pianissimi"
NSQ_SOURCE_LINE 00000620 "    scenarii"
NSQ_SOURCE_LINE 00000621 "    stiletti"
NSQ_SOURCE_LINE 00000622 "    torsi"
NSQ_SOURCE_LINE 00000623 "/);"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "my %i_to_o;"
NSQ_SOURCE_LINE 00000626 "@i_to_o{@i_to_o} = (1) x @i_to_o;"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "# -i to something else"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "my %i_to_other = ("
NSQ_SOURCE_LINE 00000631 "    improvisatori => 'improvisatore',"
NSQ_SOURCE_LINE 00000632 "    rhinoceri => 'rhinoceros',"
NSQ_SOURCE_LINE 00000633 "    scaloppini => 'scaloppine'"
NSQ_SOURCE_LINE 00000634 ");"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "# See documentation below."
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "sub to_singular"
NSQ_SOURCE_LINE 00000639 "{"
NSQ_SOURCE_LINE 00000640 "    my ($word) = @_;"
NSQ_SOURCE_LINE 00000641 "    # The return value."
NSQ_SOURCE_LINE 00000642 "    my $singular = $word;"
NSQ_SOURCE_LINE 00000643 "    if (! $not_plural{$word}) {"
NSQ_SOURCE_LINE 00000644 "        # The word is not in the list of exceptions."
NSQ_SOURCE_LINE 00000645 "        if ($plural{$word}) {"
NSQ_SOURCE_LINE 00000646 "            # The word has an irregular plural, like \"children\", or"
NSQ_SOURCE_LINE 00000647 "            # \"geese\", so look up the singular in the table."
NSQ_SOURCE_LINE 00000648 "            $singular = $plural{$word};"
NSQ_SOURCE_LINE 00000649 "        }"
NSQ_SOURCE_LINE 00000650 "        elsif ($word =~ /s$/) {"
NSQ_SOURCE_LINE 00000651 "            # The word ends in \"s\"."
NSQ_SOURCE_LINE 00000652 "            if ($word =~ /'s$/) {"
NSQ_SOURCE_LINE 00000653 "            # report's, etc."
NSQ_SOURCE_LINE 00000654 "            ;"
NSQ_SOURCE_LINE 00000655 "            }"
NSQ_SOURCE_LINE 00000656 "            elsif (length ($word) <= 2) {"
NSQ_SOURCE_LINE 00000657 "            # is, as, letter s, etc."
NSQ_SOURCE_LINE 00000658 "            ;"
NSQ_SOURCE_LINE 00000659 "            }"
NSQ_SOURCE_LINE 00000660 "            elsif ($word =~ /ss$/) {"
NSQ_SOURCE_LINE 00000661 "            # useless, etc."
NSQ_SOURCE_LINE 00000662 "            ;"
NSQ_SOURCE_LINE 00000663 "            }"
NSQ_SOURCE_LINE 00000664 "            elsif ($word =~ /sis$/) {"
NSQ_SOURCE_LINE 00000665 "            # basis, dialysis etc."
NSQ_SOURCE_LINE 00000666 "            ;"
NSQ_SOURCE_LINE 00000667 "            }"
NSQ_SOURCE_LINE 00000668 "            elsif ($word =~ /ies$/) {"
NSQ_SOURCE_LINE 00000669 "                # The word ends in \"ies\"."
NSQ_SOURCE_LINE 00000670 "                if ($ies{$word}) {"
NSQ_SOURCE_LINE 00000671 "                    # Lies -> lie"
NSQ_SOURCE_LINE 00000672 "                    $singular =~ s/ies$/ie/;"
NSQ_SOURCE_LINE 00000673 "                }"
NSQ_SOURCE_LINE 00000674 "                else {"
NSQ_SOURCE_LINE 00000675 "                    # Fries -> fry"
NSQ_SOURCE_LINE 00000676 "                    $singular =~ s/ies$/y/;"
NSQ_SOURCE_LINE 00000677 "                }"
NSQ_SOURCE_LINE 00000678 "            }"
NSQ_SOURCE_LINE 00000679 "            elsif ($word =~ /oes$/) {"
NSQ_SOURCE_LINE 00000680 "                # The word ends in \"oes\"."
NSQ_SOURCE_LINE 00000681 "                if ($oes{$word}) {"
NSQ_SOURCE_LINE 00000682 "                    # Toes -> toe"
NSQ_SOURCE_LINE 00000683 "                    $singular =~ s/oes$/oe/;"
NSQ_SOURCE_LINE 00000684 "                }"
NSQ_SOURCE_LINE 00000685 "                else {"
NSQ_SOURCE_LINE 00000686 "                    # Potatoes -> potato"
NSQ_SOURCE_LINE 00000687 "                    $singular =~ s/oes$/o/;"
NSQ_SOURCE_LINE 00000688 "                }"
NSQ_SOURCE_LINE 00000689 "            }"
NSQ_SOURCE_LINE 00000690 "            elsif ($word =~ /xes$/) {"
NSQ_SOURCE_LINE 00000691 "                # The word ends in \"xes\"."
NSQ_SOURCE_LINE 00000692 "\t\t        $singular =~ s/xes$/x/;"
NSQ_SOURCE_LINE 00000693 "            }"
NSQ_SOURCE_LINE 00000694 "            elsif ($word =~ /ses$/) {"
NSQ_SOURCE_LINE 00000695 "                if ($ses{$word}) {"
NSQ_SOURCE_LINE 00000696 "                    $singular =~ s/ses$/se/;"
NSQ_SOURCE_LINE 00000697 "                }"
NSQ_SOURCE_LINE 00000698 "                else {"
NSQ_SOURCE_LINE 00000699 "                    $singular =~ s/ses$/s/;"
NSQ_SOURCE_LINE 00000700 "                }"
NSQ_SOURCE_LINE 00000701 "\t        }"
NSQ_SOURCE_LINE 00000702 "            elsif ($word =~ $es_re) {"
NSQ_SOURCE_LINE 00000703 "                # Sandwiches -> sandwich"
NSQ_SOURCE_LINE 00000704 "                # Dishes -> dish"
NSQ_SOURCE_LINE 00000705 "                $singular =~ s/$es_re/$1/;"
NSQ_SOURCE_LINE 00000706 "            }"
NSQ_SOURCE_LINE 00000707 "            else {"
NSQ_SOURCE_LINE 00000708 "                # Now the program has checked for every exception it"
NSQ_SOURCE_LINE 00000709 "                # can think of, so it assumes that it is OK to remove"
NSQ_SOURCE_LINE 00000710 "                # the \"s\" from the end of the word."
NSQ_SOURCE_LINE 00000711 "                $singular =~ s/s$//;"
NSQ_SOURCE_LINE 00000712 "            }"
NSQ_SOURCE_LINE 00000713 "        }"
NSQ_SOURCE_LINE 00000714 "        elsif ($word =~ /i$/) {"
NSQ_SOURCE_LINE 00000715 "            if ($i_to_us{$word}) {"
NSQ_SOURCE_LINE 00000716 "                $singular =~ s/i$/us/;"
NSQ_SOURCE_LINE 00000717 "            }"
NSQ_SOURCE_LINE 00000718 "            elsif ($i_to_o{$word}) {"
NSQ_SOURCE_LINE 00000719 "                $singular =~ s/i$/o/;"
NSQ_SOURCE_LINE 00000720 "            }"
NSQ_SOURCE_LINE 00000721 "            if ($i_to_other{$word}) {"
NSQ_SOURCE_LINE 00000722 "                $singular = $i_to_other{$word};"
NSQ_SOURCE_LINE 00000723 "            }"
NSQ_SOURCE_LINE 00000724 "        }"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "    }"
NSQ_SOURCE_LINE 00000727 "    return $singular;"
NSQ_SOURCE_LINE 00000728 "}"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "sub is_plural"
NSQ_SOURCE_LINE 00000731 "{"
NSQ_SOURCE_LINE 00000732 "    my ($word) = @_;"
NSQ_SOURCE_LINE 00000733 "    my $singular = to_singular ($word);"
NSQ_SOURCE_LINE 00000734 "    my $is_plural;"
NSQ_SOURCE_LINE 00000735 "    if ($singular ne $word) {"
NSQ_SOURCE_LINE 00000736 "\t$is_plural = 1;"
NSQ_SOURCE_LINE 00000737 "    }"
NSQ_SOURCE_LINE 00000738 "    elsif ($plural{$singular} && $plural{$singular} eq $singular) {"
NSQ_SOURCE_LINE 00000739 "\t$is_plural = 1;"
NSQ_SOURCE_LINE 00000740 "    }"
NSQ_SOURCE_LINE 00000741 "    else {"
NSQ_SOURCE_LINE 00000742 "\t$is_plural = 0;"
NSQ_SOURCE_LINE 00000743 "    }"
NSQ_SOURCE_LINE 00000744 "    return $is_plural;"
NSQ_SOURCE_LINE 00000745 "}"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "1;"
BODY_END
