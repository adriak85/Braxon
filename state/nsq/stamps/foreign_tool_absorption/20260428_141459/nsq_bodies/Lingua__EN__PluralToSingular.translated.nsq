NSQ_SOURCE_LINE 00000327 "# A dictionary of plurals."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "my %plural = ("
NSQ_SOURCE_LINE 00000330 "    # Words ending in \"us\" which are plural, in contrast to words like"
NSQ_SOURCE_LINE 00000331 "    # \"citrus\" or \"bogus\"."
NSQ_SOURCE_LINE 00000332 "    'menus' => 'menu',"
NSQ_SOURCE_LINE 00000333 "    'buses' => 'bus',"
NSQ_SOURCE_LINE 00000334 "    %ves,"
NSQ_SOURCE_LINE 00000335 "    %irregular,"
NSQ_SOURCE_LINE 00000336 ");"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "# A store of words which are the same in both singular and plural."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "my @no_change = qw/"
