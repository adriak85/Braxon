NSQ_SOURCE_LINE 00000001 "package HTTP::Negotiate;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "$VERSION = \"6.01\";"
NSQ_SOURCE_LINE 00000004 "sub Version { $VERSION; }"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "require Exporter;"
NSQ_SOURCE_LINE 00000007 "@ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000008 "@EXPORT = qw(choose);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "require HTTP::Headers;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "$DEBUG = 0;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub choose ($;$)"
NSQ_SOURCE_LINE 00000015 "{"
NSQ_SOURCE_LINE 00000016 "    my($variants, $request) = @_;"
NSQ_SOURCE_LINE 00000017 "    my(%accept);"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    unless (defined $request) {"
NSQ_SOURCE_LINE 00000020 "\t# Create a request object from the CGI environment variables"
NSQ_SOURCE_LINE 00000021 "\t$request = HTTP::Headers->new;"
NSQ_SOURCE_LINE 00000022 "\t$request->header('Accept', $ENV{HTTP_ACCEPT})"
NSQ_SOURCE_LINE 00000023 "\t  if $ENV{HTTP_ACCEPT};"
NSQ_SOURCE_LINE 00000024 "\t$request->header('Accept-Charset', $ENV{HTTP_ACCEPT_CHARSET})"
NSQ_SOURCE_LINE 00000025 "\t  if $ENV{HTTP_ACCEPT_CHARSET};"
NSQ_SOURCE_LINE 00000026 "\t$request->header('Accept-Encoding', $ENV{HTTP_ACCEPT_ENCODING})"
NSQ_SOURCE_LINE 00000027 "\t  if $ENV{HTTP_ACCEPT_ENCODING};"
NSQ_SOURCE_LINE 00000028 "\t$request->header('Accept-Language', $ENV{HTTP_ACCEPT_LANGUAGE})"
NSQ_SOURCE_LINE 00000029 "\t  if $ENV{HTTP_ACCEPT_LANGUAGE};"
NSQ_SOURCE_LINE 00000030 "    }"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    # Get all Accept values from the request.  Build a hash initialized"
NSQ_SOURCE_LINE 00000033 "    # like this:"
NSQ_SOURCE_LINE 00000034 "    #"
NSQ_SOURCE_LINE 00000035 "    #   %accept = ( type =>     { 'audio/*'     => { q => 0.2, mbx => 20000 },"
NSQ_SOURCE_LINE 00000036 "    #                             'audio/basic' => { q => 1 },"
NSQ_SOURCE_LINE 00000037 "    #                           },"
NSQ_SOURCE_LINE 00000038 "    #               language => { 'no'          => { q => 1 },"
NSQ_SOURCE_LINE 00000039 "    #                           }"
NSQ_SOURCE_LINE 00000040 "    #             );"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "    $request->scan(sub {"
NSQ_SOURCE_LINE 00000043 "\tmy($key, $val) = @_;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "\tmy $type;"
NSQ_SOURCE_LINE 00000046 "\tif ($key =~ s/^Accept-//) {"
NSQ_SOURCE_LINE 00000047 "\t    $type = lc($key);"
NSQ_SOURCE_LINE 00000048 "\t}"
NSQ_SOURCE_LINE 00000049 "\telsif ($key eq \"Accept\") {"
NSQ_SOURCE_LINE 00000050 "\t    $type = \"type\";"
NSQ_SOURCE_LINE 00000051 "\t}"
NSQ_SOURCE_LINE 00000052 "\telse {"
NSQ_SOURCE_LINE 00000053 "\t    return;"
NSQ_SOURCE_LINE 00000054 "\t}"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "\t$val =~ s/\\s+//g;"
NSQ_SOURCE_LINE 00000057 "\tmy $default_q = 1;"
NSQ_SOURCE_LINE 00000058 "\tfor my $name (split(/,/, $val)) {"
NSQ_SOURCE_LINE 00000059 "\t    my(%param, $param);"
NSQ_SOURCE_LINE 00000060 "\t    if ($name =~ s/;(.*)//) {"
NSQ_SOURCE_LINE 00000061 "\t\tfor $param (split(/;/, $1)) {"
NSQ_SOURCE_LINE 00000062 "\t\t    my ($pk, $pv) = split(/=/, $param, 2);"
NSQ_SOURCE_LINE 00000063 "\t\t    $param{lc $pk} = $pv;"
NSQ_SOURCE_LINE 00000064 "\t\t}"
NSQ_SOURCE_LINE 00000065 "\t    }"
NSQ_SOURCE_LINE 00000066 "\t    $name = lc $name;"
NSQ_SOURCE_LINE 00000067 "\t    if (defined $param{'q'}) {"
NSQ_SOURCE_LINE 00000068 "\t\t$param{'q'} = 1 if $param{'q'} > 1;"
NSQ_SOURCE_LINE 00000069 "\t\t$param{'q'} = 0 if $param{'q'} < 0;"
NSQ_SOURCE_LINE 00000070 "\t    }"
NSQ_SOURCE_LINE 00000071 "\t    else {"
NSQ_SOURCE_LINE 00000072 "\t\t$param{'q'} = $default_q;"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "\t\t# This makes sure that the first ones are slightly better off"
NSQ_SOURCE_LINE 00000075 "\t\t# and therefore more likely to be chosen."
NSQ_SOURCE_LINE 00000076 "\t\t$default_q -= 0.0001;"
NSQ_SOURCE_LINE 00000077 "\t    }"
NSQ_SOURCE_LINE 00000078 "\t    $accept{$type}{$name} = \\%param;"
NSQ_SOURCE_LINE 00000079 "\t}"
NSQ_SOURCE_LINE 00000080 "    });"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    # Check if any of the variants specify a language.  We do this"
NSQ_SOURCE_LINE 00000083 "    # because it influences how we treat those without (they default to"
NSQ_SOURCE_LINE 00000084 "    # 0.5 instead of 1)."
NSQ_SOURCE_LINE 00000085 "    my $any_lang = 0;"
NSQ_SOURCE_LINE 00000086 "    for $var (@$variants) {"
NSQ_SOURCE_LINE 00000087 "\tif ($var->[5]) {"
NSQ_SOURCE_LINE 00000088 "\t    $any_lang = 1;"
NSQ_SOURCE_LINE 00000089 "\t    last;"
NSQ_SOURCE_LINE 00000090 "\t}"
NSQ_SOURCE_LINE 00000091 "    }"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    if ($DEBUG) {"
NSQ_SOURCE_LINE 00000094 "\tprint \"Negotiation parameters in the request\\n\";"
NSQ_SOURCE_LINE 00000095 "\tfor $type (keys %accept) {"
NSQ_SOURCE_LINE 00000096 "\t    print \" $type:\\n\";"
NSQ_SOURCE_LINE 00000097 "\t    for $name (keys %{$accept{$type}}) {"
NSQ_SOURCE_LINE 00000098 "\t\tprint \"    $name\\n\";"
NSQ_SOURCE_LINE 00000099 "\t\tfor $pv (keys %{$accept{$type}{$name}}) {"
NSQ_SOURCE_LINE 00000100 "\t\t    print \"      $pv = $accept{$type}{$name}{$pv}\\n\";"
NSQ_SOURCE_LINE 00000101 "\t\t}"
NSQ_SOURCE_LINE 00000102 "\t    }"
NSQ_SOURCE_LINE 00000103 "\t}"
NSQ_SOURCE_LINE 00000104 "    }"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    my @Q = ();  # This is where we collect the results of the"
NSQ_SOURCE_LINE 00000107 "\t\t # quality calculations"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    # Calculate quality for all the variants that are available."
NSQ_SOURCE_LINE 00000110 "    for (@$variants) {"
NSQ_SOURCE_LINE 00000111 "\tmy($id, $qs, $ct, $enc, $cs, $lang, $bs) = @$_;"
NSQ_SOURCE_LINE 00000112 "\t$qs = 1 unless defined $qs;"
NSQ_SOURCE_LINE 00000113 "        $ct = '' unless defined $ct;"
NSQ_SOURCE_LINE 00000114 "\t$bs = 0 unless defined $bs;"
NSQ_SOURCE_LINE 00000115 "\t$lang = lc($lang) if $lang; # lg tags are always case-insensitive"
NSQ_SOURCE_LINE 00000116 "\tif ($DEBUG) {"
NSQ_SOURCE_LINE 00000117 "\t    print \"\\nEvaluating $id (ct='$ct')\\n\";"
NSQ_SOURCE_LINE 00000118 "\t    printf \"  qs   = %.3f\\n\", $qs;"
NSQ_SOURCE_LINE 00000119 "\t    print  \"  enc  = $enc\\n\"  if $enc && !ref($enc);"
NSQ_SOURCE_LINE 00000120 "\t    print  \"  enc  = @$enc\\n\" if $enc && ref($enc);"
NSQ_SOURCE_LINE 00000121 "\t    print  \"  cs   = $cs\\n\"   if $cs;"
NSQ_SOURCE_LINE 00000122 "\t    print  \"  lang = $lang\\n\" if $lang;"
NSQ_SOURCE_LINE 00000123 "\t    print  \"  bs   = $bs\\n\"   if $bs;"
NSQ_SOURCE_LINE 00000124 "\t}"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "\t# Calculate encoding quality"
NSQ_SOURCE_LINE 00000127 "\tmy $qe = 1;"
NSQ_SOURCE_LINE 00000128 "\t# If the variant has no assigned Content-Encoding, or if no"
NSQ_SOURCE_LINE 00000129 "\t# Accept-Encoding field is present, then the value assigned"
NSQ_SOURCE_LINE 00000130 "\t# is \"qe=1\".  If *all* of the variant's content encodings"
NSQ_SOURCE_LINE 00000131 "\t# are listed in the Accept-Encoding field, then the value"
NSQ_SOURCE_LINE 00000132 "\t# assigned is \"qw=1\".  If *any* of the variant's content"
NSQ_SOURCE_LINE 00000133 "\t# encodings are not listed in the provided Accept-Encoding"
NSQ_SOURCE_LINE 00000134 "\t# field, then the value assigned is \"qe=0\""
NSQ_SOURCE_LINE 00000135 "\tif (exists $accept{'encoding'} && $enc) {"
NSQ_SOURCE_LINE 00000136 "\t    my @enc = ref($enc) ? @$enc : ($enc);"
NSQ_SOURCE_LINE 00000137 "\t    for (@enc) {"
NSQ_SOURCE_LINE 00000138 "\t\tprint \"Is encoding $_ accepted? \" if $DEBUG;"
NSQ_SOURCE_LINE 00000139 "\t\tunless(exists $accept{'encoding'}{$_}) {"
NSQ_SOURCE_LINE 00000140 "\t\t    print \"no\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000141 "\t\t    $qe = 0;"
NSQ_SOURCE_LINE 00000142 "\t\t    last;"
NSQ_SOURCE_LINE 00000143 "\t\t}"
NSQ_SOURCE_LINE 00000144 "\t\telse {"
NSQ_SOURCE_LINE 00000145 "\t\t    print \"yes\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000146 "\t\t}"
NSQ_SOURCE_LINE 00000147 "\t    }"
NSQ_SOURCE_LINE 00000148 "\t}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "\t# Calculate charset quality"
NSQ_SOURCE_LINE 00000151 "\tmy $qc  = 1;"
NSQ_SOURCE_LINE 00000152 "\t# If the variant's media-type has no charset parameter,"
NSQ_SOURCE_LINE 00000153 "\t# or the variant's charset is US-ASCII, or if no Accept-Charset"
NSQ_SOURCE_LINE 00000154 "\t# field is present, then the value assigned is \"qc=1\".  If the"
NSQ_SOURCE_LINE 00000155 "\t# variant's charset is listed in the Accept-Charset field,"
NSQ_SOURCE_LINE 00000156 "\t# then the value assigned is \"qc=1.  Otherwise, if the variant's"
NSQ_SOURCE_LINE 00000157 "\t# charset is not listed in the provided Accept-Encoding field,"
NSQ_SOURCE_LINE 00000158 "\t# then the value assigned is \"qc=0\"."
NSQ_SOURCE_LINE 00000159 "\tif (exists $accept{'charset'} && $cs && $cs ne 'us-ascii' ) {"
NSQ_SOURCE_LINE 00000160 "\t    $qc = 0 unless $accept{'charset'}{$cs};"
NSQ_SOURCE_LINE 00000161 "\t}"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "\t# Calculate language quality"
NSQ_SOURCE_LINE 00000164 "\tmy $ql  = 1;"
NSQ_SOURCE_LINE 00000165 "\tif ($lang && exists $accept{'language'}) {"
NSQ_SOURCE_LINE 00000166 "\t    my @lang = ref($lang) ? @$lang : ($lang);"
NSQ_SOURCE_LINE 00000167 "\t    # If any of the variant's content languages are listed"
NSQ_SOURCE_LINE 00000168 "\t    # in the Accept-Language field, the the value assigned is"
NSQ_SOURCE_LINE 00000169 "\t    # the largest of the \"q\" parameter values for those language"
NSQ_SOURCE_LINE 00000170 "\t    # tags."
NSQ_SOURCE_LINE 00000171 "\t    my $q = undef;"
NSQ_SOURCE_LINE 00000172 "\t    for (@lang) {"
NSQ_SOURCE_LINE 00000173 "\t\tnext unless exists $accept{'language'}{$_};"
NSQ_SOURCE_LINE 00000174 "\t\tmy $this_q = $accept{'language'}{$_}{'q'};"
NSQ_SOURCE_LINE 00000175 "\t\t$q = $this_q unless defined $q;"
NSQ_SOURCE_LINE 00000176 "\t\t$q = $this_q if $this_q > $q;"
NSQ_SOURCE_LINE 00000177 "\t    }"
NSQ_SOURCE_LINE 00000178 "\t    if(defined $q) {"
NSQ_SOURCE_LINE 00000179 "\t        $DEBUG and print \" -- Exact language match at q=$q\\n\";"
NSQ_SOURCE_LINE 00000180 "\t    }"
NSQ_SOURCE_LINE 00000181 "\t    else {"
NSQ_SOURCE_LINE 00000182 "\t\t# If there was no exact match and at least one of"
NSQ_SOURCE_LINE 00000183 "\t\t# the Accept-Language field values is a complete"
NSQ_SOURCE_LINE 00000184 "\t\t# subtag prefix of the content language tag(s), then"
NSQ_SOURCE_LINE 00000185 "\t\t# the \"q\" parameter value of the largest matching"
NSQ_SOURCE_LINE 00000186 "\t\t# prefix is used."
NSQ_SOURCE_LINE 00000187 "\t\t$DEBUG and print \" -- No exact language match\\n\";"
NSQ_SOURCE_LINE 00000188 "\t\tmy $selected = undef;"
NSQ_SOURCE_LINE 00000189 "\t\tfor $al (keys %{ $accept{'language'} }) {"
NSQ_SOURCE_LINE 00000190 "\t\t    if (index($al, \"$lang-\") == 0) {"
NSQ_SOURCE_LINE 00000191 "\t\t        # $lang starting with $al isn't enough, or else"
NSQ_SOURCE_LINE 00000192 "\t\t        #  Accept-Language: hu (Hungarian) would seem"
NSQ_SOURCE_LINE 00000193 "\t\t        #  to accept a document in hup (Hupa)"
NSQ_SOURCE_LINE 00000194 "\t\t        $DEBUG and print \" -- $al ISA $lang\\n\";"
NSQ_SOURCE_LINE 00000195 "\t\t\t$selected = $al unless defined $selected;"
NSQ_SOURCE_LINE 00000196 "\t\t\t$selected = $al if length($al) > length($selected);"
NSQ_SOURCE_LINE 00000197 "\t\t    }"
NSQ_SOURCE_LINE 00000198 "\t\t    else {"
NSQ_SOURCE_LINE 00000199 "\t\t        $DEBUG and print \" -- $lang  isn't a $al\\n\";"
NSQ_SOURCE_LINE 00000200 "\t\t    }"
NSQ_SOURCE_LINE 00000201 "\t\t}"
NSQ_SOURCE_LINE 00000202 "\t\t$q = $accept{'language'}{$selected}{'q'} if $selected;"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "\t\t# If none of the variant's content language tags or"
NSQ_SOURCE_LINE 00000205 "\t\t# tag prefixes are listed in the provided"
NSQ_SOURCE_LINE 00000206 "\t\t# Accept-Language field, then the value assigned"
NSQ_SOURCE_LINE 00000207 "\t\t# is \"ql=0.001\""
NSQ_SOURCE_LINE 00000208 "\t\t$q = 0.001 unless defined $q;"
NSQ_SOURCE_LINE 00000209 "\t    }"
NSQ_SOURCE_LINE 00000210 "\t    $ql = $q;"
NSQ_SOURCE_LINE 00000211 "\t}"
NSQ_SOURCE_LINE 00000212 "\telse {"
NSQ_SOURCE_LINE 00000213 "\t    $ql = 0.5 if $any_lang && exists $accept{'language'};"
NSQ_SOURCE_LINE 00000214 "\t}"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "\tmy $q   = 1;"
NSQ_SOURCE_LINE 00000217 "\tmy $mbx = undef;"
NSQ_SOURCE_LINE 00000218 "\t# If no Accept field is given, then the value assigned is \"q=1\"."
NSQ_SOURCE_LINE 00000219 "\t# If at least one listed media range matches the variant's media"
NSQ_SOURCE_LINE 00000220 "\t# type, then the \"q\" parameter value assigned to the most specific"
NSQ_SOURCE_LINE 00000221 "\t# of those matched is used (e.g. \"text/html;version=3.0\" is more"
NSQ_SOURCE_LINE 00000222 "\t# specific than \"text/html\", which is more specific than \"text/*\","
NSQ_SOURCE_LINE 00000223 "\t# which in turn is more specific than \"*/*\"). If not media range"
NSQ_SOURCE_LINE 00000224 "\t# in the provided Accept field matches the variant's media type,"
NSQ_SOURCE_LINE 00000225 "\t# then the value assigned is \"q=0\"."
NSQ_SOURCE_LINE 00000226 "\tif (exists $accept{'type'} && $ct) {"
NSQ_SOURCE_LINE 00000227 "\t    # First we clean up our content-type"
NSQ_SOURCE_LINE 00000228 "\t    $ct =~ s/\\s+//g;"
NSQ_SOURCE_LINE 00000229 "\t    my $params = \"\";"
NSQ_SOURCE_LINE 00000230 "\t    $params = $1 if $ct =~ s/;(.*)//;"
NSQ_SOURCE_LINE 00000231 "\t    my($type, $subtype) = split(\"/\", $ct, 2);"
NSQ_SOURCE_LINE 00000232 "\t    my %param = ();"
NSQ_SOURCE_LINE 00000233 "\t    for $param (split(/;/, $params)) {"
NSQ_SOURCE_LINE 00000234 "\t\tmy($pk,$pv) = split(/=/, $param, 2);"
NSQ_SOURCE_LINE 00000235 "\t\t$param{$pk} = $pv;"
NSQ_SOURCE_LINE 00000236 "\t    }"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "\t    my $sel_q = undef;"
NSQ_SOURCE_LINE 00000239 "\t    my $sel_mbx = undef;"
NSQ_SOURCE_LINE 00000240 "\t    my $sel_specificness = 0;"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "\t    ACCEPT_TYPE:"
NSQ_SOURCE_LINE 00000243 "\t    for $at (keys %{ $accept{'type'} }) {"
NSQ_SOURCE_LINE 00000244 "\t\tprint \"Consider $at...\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000245 "\t\tmy($at_type, $at_subtype) = split(\"/\", $at, 2);"
NSQ_SOURCE_LINE 00000246 "\t\t# Is it a match on the type"
NSQ_SOURCE_LINE 00000247 "\t\tnext if $at_type    ne '*' && $at_type    ne $type;"
NSQ_SOURCE_LINE 00000248 "\t\tnext if $at_subtype ne '*' && $at_subtype ne $subtype;"
NSQ_SOURCE_LINE 00000249 "\t\tmy $specificness = 0;"
NSQ_SOURCE_LINE 00000250 "\t\t$specificness++ if $at_type ne '*';"
NSQ_SOURCE_LINE 00000251 "\t\t$specificness++ if $at_subtype ne '*';"
NSQ_SOURCE_LINE 00000252 "\t\t# Let's see if content-type parameters also match"
NSQ_SOURCE_LINE 00000253 "\t\twhile (($pk, $pv) = each %param) {"
NSQ_SOURCE_LINE 00000254 "\t\t    print \"Check if $pk = $pv is true\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000255 "\t\t    next unless exists $accept{'type'}{$at}{$pk};"
NSQ_SOURCE_LINE 00000256 "\t\t    next ACCEPT_TYPE"
NSQ_SOURCE_LINE 00000257 "\t\t      unless $accept{'type'}{$at}{$pk} eq $pv;"
NSQ_SOURCE_LINE 00000258 "\t\t    print \"yes it is!!\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000259 "\t\t    $specificness++;"
NSQ_SOURCE_LINE 00000260 "\t\t}"
NSQ_SOURCE_LINE 00000261 "\t\tprint \"Hurray, type match with specificness = $specificness\\n\""
NSQ_SOURCE_LINE 00000262 "\t\t  if $DEBUG;"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "\t\tif (!defined($sel_q) || $sel_specificness < $specificness) {"
NSQ_SOURCE_LINE 00000265 "\t\t    $sel_q   = $accept{'type'}{$at}{'q'};"
NSQ_SOURCE_LINE 00000266 "\t\t    $sel_mbx = $accept{'type'}{$at}{'mbx'};"
NSQ_SOURCE_LINE 00000267 "\t\t    $sel_specificness = $specificness;"
NSQ_SOURCE_LINE 00000268 "\t\t}"
NSQ_SOURCE_LINE 00000269 "\t    }"
NSQ_SOURCE_LINE 00000270 "\t    $q   = $sel_q || 0;"
NSQ_SOURCE_LINE 00000271 "\t    $mbx = $sel_mbx;"
NSQ_SOURCE_LINE 00000272 "\t}"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "\tmy $Q;"
NSQ_SOURCE_LINE 00000275 "\tif (!defined($mbx) || $mbx >= $bs) {"
NSQ_SOURCE_LINE 00000276 "\t    $Q = $qs * $qe * $qc * $ql * $q;"
NSQ_SOURCE_LINE 00000277 "\t}"
NSQ_SOURCE_LINE 00000278 "\telse {"
NSQ_SOURCE_LINE 00000279 "\t    $Q = 0;"
NSQ_SOURCE_LINE 00000280 "\t    print \"Variant's size is too large ==> Q=0\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000281 "\t}"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "\tif ($DEBUG) {"
NSQ_SOURCE_LINE 00000284 "\t    $mbx = \"undef\" unless defined $mbx;"
NSQ_SOURCE_LINE 00000285 "\t    printf \"Q=%.4f\", $Q;"
NSQ_SOURCE_LINE 00000286 "\t    print \"  (q=$q, mbx=$mbx, qe=$qe, qc=$qc, ql=$ql, qs=$qs)\\n\";"
NSQ_SOURCE_LINE 00000287 "\t}"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "\tpush(@Q, [$id, $Q, $bs]);"
NSQ_SOURCE_LINE 00000290 "    }"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "    @Q = sort { $b->[1] <=> $a->[1] || $a->[2] <=> $b->[2] } @Q;"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "    return @Q if wantarray;"
NSQ_SOURCE_LINE 00000296 "    return undef unless @Q;"
NSQ_SOURCE_LINE 00000297 "    return undef if $Q[0][1] == 0;"
NSQ_SOURCE_LINE 00000298 "    $Q[0][0];"
NSQ_SOURCE_LINE 00000299 "}"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "1;"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "__END__"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=head1 NAME"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "HTTP::Negotiate - choose a variant to serve"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 " use HTTP::Negotiate qw(choose);"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 " #  ID       QS     Content-Type   Encoding Char-Set        Lang   Size"
NSQ_SOURCE_LINE 00000315 " $variants ="
NSQ_SOURCE_LINE 00000316 "  [['var1',  1.000, 'text/html',   undef,   'iso-8859-1',   'en',   3000],"
NSQ_SOURCE_LINE 00000317 "   ['var2',  0.950, 'text/plain',  'gzip',  'us-ascii',     'no',    400],"
NSQ_SOURCE_LINE 00000318 "   ['var3',  0.3,   'image/gif',   undef,   undef,          undef, 43555],"
NSQ_SOURCE_LINE 00000319 "  ];"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 " @preferred = choose($variants, $request_headers);"
NSQ_SOURCE_LINE 00000322 " $the_one   = choose($variants);"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "This module provides a complete implementation of the HTTP content"
NSQ_SOURCE_LINE 00000327 "negotiation algorithm specified in F<draft-ietf-http-v11-spec-00.ps>"
NSQ_SOURCE_LINE 00000328 "chapter 12.  Content negotiation allows for the selection of a"
NSQ_SOURCE_LINE 00000329 "preferred content representation based upon attributes of the"
NSQ_SOURCE_LINE 00000330 "negotiable variants and the value of the various Accept* header fields"
NSQ_SOURCE_LINE 00000331 "in the request."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "The variants are ordered by preference by calling the function"
NSQ_SOURCE_LINE 00000334 "choose()."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "The first parameter is reference to an array of the variants to"
NSQ_SOURCE_LINE 00000337 "choose among."
NSQ_SOURCE_LINE 00000338 "Each element in this array is an array with the values [$id, $qs,"
NSQ_SOURCE_LINE 00000339 "$content_type, $content_encoding, $charset, $content_language,"
NSQ_SOURCE_LINE 00000340 "$content_length] whose meanings are described"
NSQ_SOURCE_LINE 00000341 "below. The $content_encoding and $content_language can be either a"
NSQ_SOURCE_LINE 00000342 "single scalar value or an array reference if there are several values."
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "The second optional parameter is either a HTTP::Headers or a HTTP::Request"
NSQ_SOURCE_LINE 00000345 "object which is searched for \"Accept*\" headers.  If this"
NSQ_SOURCE_LINE 00000346 "parameter is missing, then the accept specification is initialized"
NSQ_SOURCE_LINE 00000347 "from the CGI environment variables HTTP_ACCEPT, HTTP_ACCEPT_CHARSET,"
NSQ_SOURCE_LINE 00000348 "HTTP_ACCEPT_ENCODING and HTTP_ACCEPT_LANGUAGE."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "In an array context, choose() returns a list of [variant"
NSQ_SOURCE_LINE 00000351 "identifier, calculated quality, size] tuples.  The values are sorted by"
NSQ_SOURCE_LINE 00000352 "quality, highest quality first.  If the calculated quality is the same"
NSQ_SOURCE_LINE 00000353 "for two variants, then they are sorted by size (smallest first). I<E.g.>:"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "  (['var1', 1, 2000], ['var2', 0.3, 512], ['var3', 0.3, 1024]);"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "Note that also zero quality variants are included in the return list"
NSQ_SOURCE_LINE 00000358 "even if these should never be served to the client."
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "In a scalar context, it returns the identifier of the variant with the"
NSQ_SOURCE_LINE 00000361 "highest score or C<undef> if none have non-zero quality."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "If the $HTTP::Negotiate::DEBUG variable is set to TRUE, then a lot of"
NSQ_SOURCE_LINE 00000364 "noise is generated on STDOUT during evaluation of choose()."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "=head1 VARIANTS"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "A variant is described by a list of the following values.  If the"
NSQ_SOURCE_LINE 00000369 "attribute does not make sense or is unknown for a variant, then use"
NSQ_SOURCE_LINE 00000370 "C<undef> instead."
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=over 3"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=item identifier"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "This is a string that you use as the name for the variant.  This"
NSQ_SOURCE_LINE 00000377 "identifier for the preferred variants returned by choose()."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=item qs"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "This is a number between 0.000 and 1.000 that describes the \"source"
NSQ_SOURCE_LINE 00000382 "quality\".  This is what F<draft-ietf-http-v11-spec-00.ps> says about this"
NSQ_SOURCE_LINE 00000383 "value:"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "Source quality is measured by the content provider as representing the"
NSQ_SOURCE_LINE 00000386 "amount of degradation from the original source.  For example, a"
NSQ_SOURCE_LINE 00000387 "picture in JPEG form would have a lower qs when translated to the XBM"
NSQ_SOURCE_LINE 00000388 "format, and much lower qs when translated to an ASCII-art"
NSQ_SOURCE_LINE 00000389 "representation.  Note, however, that this is a function of the source"
NSQ_SOURCE_LINE 00000390 "- an original piece of ASCII-art may degrade in quality if it is"
NSQ_SOURCE_LINE 00000391 "captured in JPEG form.  The qs values should be assigned to each"
NSQ_SOURCE_LINE 00000392 "variant by the content provider; if no qs value has been assigned, the"
NSQ_SOURCE_LINE 00000393 "default is generally \"qs=1\"."
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=item content-type"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "This is the media type of the variant.  The media type does not"
NSQ_SOURCE_LINE 00000398 "include a charset attribute, but might contain other parameters."
NSQ_SOURCE_LINE 00000399 "Examples are:"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "  text/html"
NSQ_SOURCE_LINE 00000402 "  text/html;version=2.0"
NSQ_SOURCE_LINE 00000403 "  text/plain"
NSQ_SOURCE_LINE 00000404 "  image/gif"
NSQ_SOURCE_LINE 00000405 "  image/jpg"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=item content-encoding"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "This is one or more content encodings that has been applied to the"
NSQ_SOURCE_LINE 00000410 "variant.  The content encoding is generally used as a modifier to the"
NSQ_SOURCE_LINE 00000411 "content media type.  The most common content encodings are:"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "  gzip"
NSQ_SOURCE_LINE 00000414 "  compress"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "=item content-charset"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "This is the character set used when the variant contains text."
NSQ_SOURCE_LINE 00000419 "The charset value should generally be C<undef> or one of these:"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "  us-ascii"
NSQ_SOURCE_LINE 00000422 "  iso-8859-1 ... iso-8859-9"
NSQ_SOURCE_LINE 00000423 "  iso-2022-jp"
NSQ_SOURCE_LINE 00000424 "  iso-2022-jp-2"
NSQ_SOURCE_LINE 00000425 "  iso-2022-kr"
NSQ_SOURCE_LINE 00000426 "  unicode-1-1"
NSQ_SOURCE_LINE 00000427 "  unicode-1-1-utf-7"
NSQ_SOURCE_LINE 00000428 "  unicode-1-1-utf-8"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "=item content-language"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "This describes one or more languages that are used in the variant."
NSQ_SOURCE_LINE 00000433 "Language is described like this in F<draft-ietf-http-v11-spec-00.ps>: A"
NSQ_SOURCE_LINE 00000434 "language is in this context a natural language spoken, written, or"
NSQ_SOURCE_LINE 00000435 "otherwise conveyed by human beings for communication of information to"
NSQ_SOURCE_LINE 00000436 "other human beings.  Computer languages are explicitly excluded."
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "The language tags are defined by RFC 3066.  Examples"
NSQ_SOURCE_LINE 00000439 "are:"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "  no               Norwegian"
NSQ_SOURCE_LINE 00000442 "  en               International English"
NSQ_SOURCE_LINE 00000443 "  en-US            US English"
NSQ_SOURCE_LINE 00000444 "  en-cockney"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "=item content-length"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "This is the number of bytes used to represent the content."
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "=back"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "=head1 ACCEPT HEADERS"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "The following Accept* headers can be used for describing content"
NSQ_SOURCE_LINE 00000455 "preferences in a request (This description is an edited extract from"
NSQ_SOURCE_LINE 00000456 "F<draft-ietf-http-v11-spec-00.ps>):"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "=over 3"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "=item Accept"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "This header can be used to indicate a list of media ranges which are"
NSQ_SOURCE_LINE 00000463 "acceptable as a response to the request.  The \"*\" character is used to"
NSQ_SOURCE_LINE 00000464 "group media types into ranges, with \"*/*\" indicating all media types"
NSQ_SOURCE_LINE 00000465 "and \"type/*\" indicating all subtypes of that type."
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "The parameter q is used to indicate the quality factor, which"
NSQ_SOURCE_LINE 00000468 "represents the user's preference for that range of media types.  The"
NSQ_SOURCE_LINE 00000469 "parameter mbx gives the maximum acceptable size of the response"
NSQ_SOURCE_LINE 00000470 "content. The default values are: q=1 and mbx=infinity. If no Accept"
NSQ_SOURCE_LINE 00000471 "header is present, then the client accepts all media types with q=1."
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "For example:"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "  Accept: audio/*;q=0.2;mbx=200000, audio/basic"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "would mean: \"I prefer audio/basic (of any size), but send me any audio"
NSQ_SOURCE_LINE 00000478 "type if it is the best available after an 80% mark-down in quality and"
NSQ_SOURCE_LINE 00000479 "its size is less than 200000 bytes\""
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "=item Accept-Charset"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "Used to indicate what character sets are acceptable for the response."
NSQ_SOURCE_LINE 00000485 "The \"us-ascii\" character set is assumed to be acceptable for all user"
NSQ_SOURCE_LINE 00000486 "agents.  If no Accept-Charset field is given, the default is that any"
NSQ_SOURCE_LINE 00000487 "charset is acceptable.  Example:"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "  Accept-Charset: iso-8859-1, unicode-1-1"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "=item Accept-Encoding"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "Restricts the Content-Encoding values which are acceptable in the"
NSQ_SOURCE_LINE 00000495 "response.  If no Accept-Encoding field is present, the server may"
NSQ_SOURCE_LINE 00000496 "assume that the client will accept any content encoding.  An empty"
NSQ_SOURCE_LINE 00000497 "Accept-Encoding means that no content encoding is acceptable.  Example:"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "  Accept-Encoding: compress, gzip"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "=item Accept-Language"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "This field is similar to Accept, but restricts the set of natural"
NSQ_SOURCE_LINE 00000505 "languages that are preferred in a response.  Each language may be"
NSQ_SOURCE_LINE 00000506 "given an associated quality value which represents an estimate of the"
NSQ_SOURCE_LINE 00000507 "user's comprehension of that language.  For example:"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "  Accept-Language: no, en-gb;q=0.8, de;q=0.55"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "would mean: \"I prefer Norwegian, but will accept British English (with"
NSQ_SOURCE_LINE 00000512 "80% comprehension) or German (with 55% comprehension)."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=back"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=head1 COPYRIGHT"
NSQ_SOURCE_LINE 00000518 ""
