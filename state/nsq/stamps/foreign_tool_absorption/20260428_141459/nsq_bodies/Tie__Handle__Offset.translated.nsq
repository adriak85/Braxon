NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "BEGIN{ if (not $] < 5.006) { require warnings; warnings->import } }"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "package Tie::Handle::Offset;"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: Tied handle that hides the beginning of a file"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.004';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Tie::Handle;"
NSQ_SOURCE_LINE 00000010 "our @ISA = qw/Tie::Handle/;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000013 "# Glob slot accessor"
NSQ_SOURCE_LINE 00000014 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub offset {"
NSQ_SOURCE_LINE 00000017 "  my $self = shift;"
NSQ_SOURCE_LINE 00000018 "  if ( @_ ) {"
NSQ_SOURCE_LINE 00000019 "    return ${*$self}{offset} = shift;"
NSQ_SOURCE_LINE 00000020 "  }"
NSQ_SOURCE_LINE 00000021 "  else {"
NSQ_SOURCE_LINE 00000022 "    return ${*$self}{offset};"
NSQ_SOURCE_LINE 00000023 "  }"
NSQ_SOURCE_LINE 00000024 "}"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000027 "# Tied handle methods"
NSQ_SOURCE_LINE 00000028 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "sub TIEHANDLE"
NSQ_SOURCE_LINE 00000031 "{"
NSQ_SOURCE_LINE 00000032 "  my $class = shift;"
NSQ_SOURCE_LINE 00000033 "  my $params;"
NSQ_SOURCE_LINE 00000034 "  $params = pop if ref $_[-1] eq 'HASH';"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "  my $self    = \\do { no warnings 'once'; local *HANDLE};"
NSQ_SOURCE_LINE 00000037 "  bless $self,$class;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "  $self->OPEN(@_) if (@_);"
NSQ_SOURCE_LINE 00000040 "  if ( $params->{offset} ) {"
NSQ_SOURCE_LINE 00000041 "    seek( $self, $self->offset( $params->{offset} ), 0 );"
NSQ_SOURCE_LINE 00000042 "  }"
NSQ_SOURCE_LINE 00000043 "  return $self;"
NSQ_SOURCE_LINE 00000044 "}"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "sub TELL    {"
NSQ_SOURCE_LINE 00000047 "  my $cur = tell($_[0]) - $_[0]->offset;"
NSQ_SOURCE_LINE 00000048 "  # XXX shouldn't ever be less than zero, but just in case..."
NSQ_SOURCE_LINE 00000049 "  return $cur > 0 ? $cur : 0;"
NSQ_SOURCE_LINE 00000050 "}"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "sub SEEK    {"
NSQ_SOURCE_LINE 00000053 "  my ($self, $pos, $whence) = @_;"
NSQ_SOURCE_LINE 00000054 "  my $rc;"
NSQ_SOURCE_LINE 00000055 "  if ( $whence == 0 || $whence == 1 ) { # pos from start, cur"
NSQ_SOURCE_LINE 00000056 "    $rc = seek($self, $pos + $self->offset, $whence);"
NSQ_SOURCE_LINE 00000057 "  }"
NSQ_SOURCE_LINE 00000058 "  elsif ( _size($self) + $pos < $self->offset ) { # from end"
NSQ_SOURCE_LINE 00000059 "    $rc = '';"
NSQ_SOURCE_LINE 00000060 "  }"
NSQ_SOURCE_LINE 00000061 "  else {"
NSQ_SOURCE_LINE 00000062 "    $rc = seek($self,$pos,$whence);"
NSQ_SOURCE_LINE 00000063 "  }"
NSQ_SOURCE_LINE 00000064 "  return $rc;"
NSQ_SOURCE_LINE 00000065 "}"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "sub OPEN"
NSQ_SOURCE_LINE 00000068 "{"
NSQ_SOURCE_LINE 00000069 "  $_[0]->offset(0);"
NSQ_SOURCE_LINE 00000070 "  $_[0]->CLOSE if defined($_[0]->FILENO);"
NSQ_SOURCE_LINE 00000071 "  @_ == 2 ? open($_[0], $_[1]) : open($_[0], $_[1], $_[2]);"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub _size {"
NSQ_SOURCE_LINE 00000075 "  my ($self) = @_;"
NSQ_SOURCE_LINE 00000076 "  my $cur = tell($self);"
NSQ_SOURCE_LINE 00000077 "  seek($self,0,2); # end"
NSQ_SOURCE_LINE 00000078 "  my $size = tell($self);"
NSQ_SOURCE_LINE 00000079 "  seek($self,$cur,0); # reset"
NSQ_SOURCE_LINE 00000080 "  return $size;"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000084 "# Methods copied from Tie::StdHandle to avoid dependency on Perl 5.8.9/5.10.0"
NSQ_SOURCE_LINE 00000085 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "sub EOF     { eof($_[0]) }"
NSQ_SOURCE_LINE 00000088 "sub FILENO  { fileno($_[0]) }"
NSQ_SOURCE_LINE 00000089 "sub CLOSE   { close($_[0]) }"
NSQ_SOURCE_LINE 00000090 "sub BINMODE { binmode($_[0]) }"
NSQ_SOURCE_LINE 00000091 "sub READ     { read($_[0],$_[1],$_[2]) }"
NSQ_SOURCE_LINE 00000092 "sub READLINE { my $fh = $_[0]; <$fh> }"
NSQ_SOURCE_LINE 00000093 "sub GETC     { getc($_[0]) }"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub WRITE"
NSQ_SOURCE_LINE 00000096 "{"
NSQ_SOURCE_LINE 00000097 " my $fh = $_[0];"
NSQ_SOURCE_LINE 00000098 " print $fh substr($_[1],0,$_[2])"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "1;"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "# vim: ts=2 sts=2 sw=2 et:"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "__END__"
NSQ_SOURCE_LINE 00000107 ""
