BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package CPAN::Requirements::Dynamic;"
NSQ_SOURCE_LINE 00000002 "$CPAN::Requirements::Dynamic::VERSION = '0.002';"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Carp 'croak';"
NSQ_SOURCE_LINE 00000007 "use Parse::CPAN::Meta;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "sub _version_satisfies {"
NSQ_SOURCE_LINE 00000010 "\tmy ($version, $range) = @_;"
NSQ_SOURCE_LINE 00000011 "\trequire CPAN::Meta::Requirements::Range;"
NSQ_SOURCE_LINE 00000012 "\treturn CPAN::Meta::Requirements::Range->with_string_requirement($range)->accepts($version);"
NSQ_SOURCE_LINE 00000013 "}"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "my %default_commands = ("
NSQ_SOURCE_LINE 00000016 "\tcan_run => sub {"
NSQ_SOURCE_LINE 00000017 "\t\tmy ($self, $command) = @_;"
NSQ_SOURCE_LINE 00000018 "\t\trequire IPC::Cmd;"
NSQ_SOURCE_LINE 00000019 "\t\treturn IPC::Cmd::can_run($command);"
NSQ_SOURCE_LINE 00000020 "\t},"
NSQ_SOURCE_LINE 00000021 "\tconfig_defined => sub {"
NSQ_SOURCE_LINE 00000022 "\t\tmy ($self, $entry) = @_;"
NSQ_SOURCE_LINE 00000023 "\t\treturn $self->{config}->get($entry) eq 'define';"
NSQ_SOURCE_LINE 00000024 "\t},"
NSQ_SOURCE_LINE 00000025 "\thas_env => sub {"
NSQ_SOURCE_LINE 00000026 "\t\tmy ($self, $entry) = @_;"
NSQ_SOURCE_LINE 00000027 "\t\treturn !!$ENV{$entry};"
NSQ_SOURCE_LINE 00000028 "\t},"
NSQ_SOURCE_LINE 00000029 "\thas_perl => sub {"
NSQ_SOURCE_LINE 00000030 "\t\tmy ($self, $range) = @_;"
NSQ_SOURCE_LINE 00000031 "\t\treturn _version_satisfies($], $range);"
NSQ_SOURCE_LINE 00000032 "\t},"
NSQ_SOURCE_LINE 00000033 "\tis_extended => sub {"
NSQ_SOURCE_LINE 00000034 "\t\treturn !!$ENV{EXTENDED_TESTING};"
NSQ_SOURCE_LINE 00000035 "\t},"
NSQ_SOURCE_LINE 00000036 "\tis_os => sub {"
NSQ_SOURCE_LINE 00000037 "\t\tmy ($self, @wanted) = @_;"
NSQ_SOURCE_LINE 00000038 "\t\treturn !!grep { $_ eq $^O } @wanted"
NSQ_SOURCE_LINE 00000039 "\t},"
NSQ_SOURCE_LINE 00000040 "\tis_os_type => sub {"
NSQ_SOURCE_LINE 00000041 "\t\tmy ($self, $wanted) = @_;"
NSQ_SOURCE_LINE 00000042 "\t\trequire Perl::OSType;"
NSQ_SOURCE_LINE 00000043 "\t\treturn Perl::OSType::is_os_type($wanted);"
NSQ_SOURCE_LINE 00000044 "\t},"
NSQ_SOURCE_LINE 00000045 "\tis_smoker => sub {"
NSQ_SOURCE_LINE 00000046 "\t\treturn !!$ENV{AUTOMATED_TESTING};"
NSQ_SOURCE_LINE 00000047 "\t},"
NSQ_SOURCE_LINE 00000048 "\twant_xs => sub {"
NSQ_SOURCE_LINE 00000049 "\t\tmy ($self) = @_;"
NSQ_SOURCE_LINE 00000050 "\t\treturn !!0 if $self->{pureperl_only};"
NSQ_SOURCE_LINE 00000051 "\t\trequire ExtUtils::HasCompiler;"
NSQ_SOURCE_LINE 00000052 "\t\treturn ExtUtils::HasCompiler::can_compile_extension(config => $self->{config});"
NSQ_SOURCE_LINE 00000053 "\t},"
NSQ_SOURCE_LINE 00000054 ");"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "sub new {"
NSQ_SOURCE_LINE 00000057 "\tmy ($class, %args) = @_;"
NSQ_SOURCE_LINE 00000058 "\treturn bless {"
NSQ_SOURCE_LINE 00000059 "\t\tconfig        => $args{config}   || do { require ExtUtils::Config; ExtUtils::Config->new },"
NSQ_SOURCE_LINE 00000060 "\t\tprereqs       => $args{prereqs}  || do { require CPAN::Meta::Prereqs; CPAN::Meta::Prereqs->new },"
NSQ_SOURCE_LINE 00000061 "\t\tcommands      => $args{commands} || \\%default_commands,"
NSQ_SOURCE_LINE 00000062 "\t\tpureperl_only => $args{pureperl_only},"
NSQ_SOURCE_LINE 00000063 "\t}, $class;"
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "sub _get_command {"
NSQ_SOURCE_LINE 00000067 "\tmy ($self, $name) = @_;"
NSQ_SOURCE_LINE 00000068 "\tif ($name eq 'or') {"
NSQ_SOURCE_LINE 00000069 "\t\treturn sub {"
NSQ_SOURCE_LINE 00000070 "\t\t\tmy ($self, @each) = @_;"
NSQ_SOURCE_LINE 00000071 "\t\t\tfor my $elem (@each) {"
NSQ_SOURCE_LINE 00000072 "\t\t\t\treturn !!1 if $self->_run_condition($elem);"
NSQ_SOURCE_LINE 00000073 "\t\t\t}"
NSQ_SOURCE_LINE 00000074 "\t\t\treturn !!0;"
NSQ_SOURCE_LINE 00000075 "\t\t};"
NSQ_SOURCE_LINE 00000076 "\t} elsif ($name eq 'and') {"
NSQ_SOURCE_LINE 00000077 "\t\treturn sub {"
NSQ_SOURCE_LINE 00000078 "\t\t\tmy ($self, @each) = @_;"
NSQ_SOURCE_LINE 00000079 "\t\t\tfor my $elem (@each) {"
NSQ_SOURCE_LINE 00000080 "\t\t\t\treturn !!0 if not $self->_run_condition($elem);"
NSQ_SOURCE_LINE 00000081 "\t\t\t}"
NSQ_SOURCE_LINE 00000082 "\t\t\treturn !!1;"
NSQ_SOURCE_LINE 00000083 "\t\t};"
NSQ_SOURCE_LINE 00000084 "\t} else {"
NSQ_SOURCE_LINE 00000085 "\t\treturn $self->{commands}{$name} || croak \"No such command $name\";"
NSQ_SOURCE_LINE 00000086 "\t}"
NSQ_SOURCE_LINE 00000087 "}"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "sub _run_condition {"
NSQ_SOURCE_LINE 00000090 "\tmy ($self, $condition) = @_;"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "\tmy $negate = !!0;"
NSQ_SOURCE_LINE 00000093 "\tmy ($function, @arguments) = @{ $condition };"
NSQ_SOURCE_LINE 00000094 "\twhile ($function eq 'not') {"
NSQ_SOURCE_LINE 00000095 "\t\t$function = shift @arguments;"
NSQ_SOURCE_LINE 00000096 "\t\t$negate = !$negate;"
NSQ_SOURCE_LINE 00000097 "\t}"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "\tmy $method = $self->_get_command($function);"
NSQ_SOURCE_LINE 00000100 "\tmy $primary = $self->$method(@arguments);"
NSQ_SOURCE_LINE 00000101 "\treturn $negate ? !$primary : $primary;"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub evaluate {"
NSQ_SOURCE_LINE 00000105 "\tmy ($self, $argument) = @_;"
NSQ_SOURCE_LINE 00000106 "\tmy $version = $argument->{version};"
NSQ_SOURCE_LINE 00000107 "\tcroak \"Dynamic prereqs spec version $version is not supported\" if int $version > 1;"
NSQ_SOURCE_LINE 00000108 "\tmy @prereqs;"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "\tfor my $entry (@{ $argument->{expressions} }) {"
NSQ_SOURCE_LINE 00000111 "\t\tif ($self->_run_condition($entry->{condition})) {"
NSQ_SOURCE_LINE 00000112 "\t\t\tif ($entry->{error}) {"
NSQ_SOURCE_LINE 00000113 "\t\t\t\tdie \"$entry->{error}\\n\";"
NSQ_SOURCE_LINE 00000114 "\t\t\t} elsif (my $prereqs = $entry->{prereqs}) {"
NSQ_SOURCE_LINE 00000115 "\t\t\t\tmy $phase = $entry->{phase} || 'runtime';"
NSQ_SOURCE_LINE 00000116 "\t\t\t\tmy $relation = $entry->{relation} || 'requires';"
NSQ_SOURCE_LINE 00000117 "\t\t\t\tmy $prereqs = { $phase => { $relation => $entry->{prereqs} } };"
NSQ_SOURCE_LINE 00000118 "\t\t\t\tpush @prereqs, CPAN::Meta::Prereqs->new($prereqs);"
NSQ_SOURCE_LINE 00000119 "\t\t\t}"
NSQ_SOURCE_LINE 00000120 "\t\t}"
NSQ_SOURCE_LINE 00000121 "\t}"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "\treturn $self->{prereqs}->with_merged_prereqs(\\@prereqs);"
NSQ_SOURCE_LINE 00000124 "}"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "sub evaluate_file {"
NSQ_SOURCE_LINE 00000127 "\tmy ($self, $filename) = @_;"
NSQ_SOURCE_LINE 00000128 "\tmy $structure = Parse::CPAN::Meta->load_file($filename);"
NSQ_SOURCE_LINE 00000129 "\treturn $self->evaluate($structure);"
NSQ_SOURCE_LINE 00000130 "}"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "1;"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "# ABSTRACT: Dynamic prerequisites in meta files"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "__END__"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=pod"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=head1 NAME"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "CPAN::Requirements::Dynamic - Dynamic prerequisites in meta files"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=head1 VERSION"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "version 0.002"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 " my $result = $dynamic->evaluate({"
NSQ_SOURCE_LINE 00000153 "   expressions => ["
NSQ_SOURCE_LINE 00000154 "     {"
NSQ_SOURCE_LINE 00000155 "       condition => [ 'has_perl' => 'v5.20.0' ],"
NSQ_SOURCE_LINE 00000156 "       prereqs => { Bar => \"1.3\" },"
NSQ_SOURCE_LINE 00000157 "     },"
NSQ_SOURCE_LINE 00000158 "     {"
NSQ_SOURCE_LINE 00000159 "       condition => [ is_os => 'linux' ],"
NSQ_SOURCE_LINE 00000160 "       prereqs => { Baz => \"1.4\" },"
NSQ_SOURCE_LINE 00000161 "     },"
NSQ_SOURCE_LINE 00000162 "     {"
NSQ_SOURCE_LINE 00000163 "       condition => [ config_defined => 'usethreads' ],"
NSQ_SOURCE_LINE 00000164 "       prereqs => { Quz => \"1.5\" },"
NSQ_SOURCE_LINE 00000165 "     },"
NSQ_SOURCE_LINE 00000166 "     {"
NSQ_SOURCE_LINE 00000167 "       condition => [ and =>"
NSQ_SOURCE_LINE 00000168 "         [ config_defined => 'usethreads' ],"
NSQ_SOURCE_LINE 00000169 "         [ is_os => 'openbsd' ],"
NSQ_SOURCE_LINE 00000170 "       ],"
NSQ_SOURCE_LINE 00000171 "       prereqs => { Euz => \"1.7\" },"
NSQ_SOURCE_LINE 00000172 "     },"
NSQ_SOURCE_LINE 00000173 "     {"
NSQ_SOURCE_LINE 00000174 "       condition => [ not => is_os_type => 'Unix'],"
NSQ_SOURCE_LINE 00000175 "       error => 'OS unsupported',"
NSQ_SOURCE_LINE 00000176 "     },"
NSQ_SOURCE_LINE 00000177 "   ],"
NSQ_SOURCE_LINE 00000178 " });"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "This module implements a format for describing dynamic prerequisites of a distribution."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=head1 METHODS"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=head2 new(%options)"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "This constructor takes two (optional but recommended) named arguments"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=over 4"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=item * config"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "This is an L<ExtUtils::Config|ExtUtils::Config> (compatible) object for reading configuration."
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=item * pureperl_only"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "This should be the value of the C<pureperl-only> flag."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=back"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=head2 evaluate(%options)"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "This takes a hash with two named arguments: C<version> and C<expressions>. The former is the version of the format, it currently defaults to 1. The latter is a list of hashes that can contain the following keys:"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=over 4"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=item * condition"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "The condition of the dynamic requirement. This is an array with a name as first values and zero or more arguments following it. The semantics are described below under L</Conditions>"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=item * prereqs"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "The prereqs is a hash with modules for keys and the required version as values (e.g. C<< { Foo => '1.234' } >>)."
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=item * phase"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "The phase of the requirements. This defaults to C<'runtime'>. Other valid values include C<'build'> and C<'test'>."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=item * relation"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "The relation of the requirements. This defaults to C<'requires'>, but other valid values include C<'recommends'>, C<'suggests'> and C<'conflicts'>."
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=item * error"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "It will die with this error if set. The two messages C<\"No support for OS\"> and C<\"OS unsupported\"> have special meaning to CPAN Testers and are generally encouraged for situations that indicate not a failed build but an impossibility to build."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=back"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "C<condition> and one of C<prereqs> or C<error> are mandatory."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=head2 evaluate_file($filename)"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "This takes a filename, that can be either a YAML file or a JSON file, and evaluates it."
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=head2 Conditions"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head3 can_run($command)"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "Returns true if a C<$command> can be run."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head3 config_defined($variable)"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "This returns true if a specific configuration variable is defined."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head3 has_env($variable)"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "This returns true if the environmental variable with the name in C<$variable> is true."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=head3 has_perl($version)"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "Returns true if the perl version satisfies C<$version>. C<$version> is interpreted exactly as in the CPAN::Meta spec (e.g. C<1.2> equals C<< '>= 1.2' >>)."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=head3 is_extended"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "Returns true if extended testing is asked for."
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=head3 is_os(@systems)"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "Returns true if the OS name equals any of C<@systems>."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=head3 is_os_type($type)"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "Returns true if the OS type equals C<$type>. Typical values of C<$type> are C<'Unix'> or C<'Windows'>."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=head3 is_smoker"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "Returns true when running on a smoker."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "=head3 has_env"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "This returns true if the given environmental variable is true."
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "=head3 want_xs"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "This returns true if a compiler appears to be available, and the C<pureperl_only> option has not been set."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head3 not"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "This takes an expression and negates its value."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=head3 or"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "This takes list of arrayrefs, each containing a condition expression. If at least one of the conditions is true this will also return true."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=head3 and"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "This takes a list of arrayrefs, each containing a condition expression. If all of the conditions are true this will also return true."
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "Leon Timmermans <fawaka@gmail.com>"
