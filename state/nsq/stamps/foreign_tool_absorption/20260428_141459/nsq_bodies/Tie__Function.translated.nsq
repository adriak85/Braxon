NSQ_SOURCE_LINE 00000001 "package Tie::Function;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 "# use strict;"
NSQ_SOURCE_LINE 00000005 "# use warnings;"
NSQ_SOURCE_LINE 00000006 "no warnings;  # slience \"split on uninitialized value\" when $_[key] is uninit"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.02';"
NSQ_SOURCE_LINE 00000009 "use Carp;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "sub OBJ(){0};"
NSQ_SOURCE_LINE 00000012 "sub KEY(){1};"
NSQ_SOURCE_LINE 00000013 "sub TIEHASH{"
NSQ_SOURCE_LINE 00000014 "\tref $_[1] eq 'CODE'"
NSQ_SOURCE_LINE 00000015 "\tor croak \"Tie argument must be a CODE reference\";"
NSQ_SOURCE_LINE 00000016 "\tbless $_[1];"
NSQ_SOURCE_LINE 00000017 "}"
NSQ_SOURCE_LINE 00000018 "sub FETCH{"
NSQ_SOURCE_LINE 00000019 "\t&{$_[OBJ]}(split /$;/,$_[KEY]);"
NSQ_SOURCE_LINE 00000020 "}"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "1;"
NSQ_SOURCE_LINE 00000023 "__END__"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "=head1 NAME"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "Tie::Function - wrap functions in tied hash sugar"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "=head1 SYNOPSIS AND EXAMPLE"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "  use Tie::Function 0.01; "
NSQ_SOURCE_LINE 00000032 "  tie my %a, Tie::Function => sub{join '_'x$_[0],qw/( | )/};"
NSQ_SOURCE_LINE 00000033 "  print \"small: $a{1}\\nmedium: $a{2}\\nwide: $a{3}\\n\"; "
NSQ_SOURCE_LINE 00000034 "  # we split on $; to recover multiple arguments"
NSQ_SOURCE_LINE 00000035 "  tie my %times, Tie::Function => sub{"
NSQ_SOURCE_LINE 00000036 "\t$_[0] * $_[1]"
NSQ_SOURCE_LINE 00000037 "  };"
NSQ_SOURCE_LINE 00000038 "  print \"3 times 5 is $times{3,5}\\n\""
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "Tie::Function simplifies wrapping functions in tied hash syntax"
NSQ_SOURCE_LINE 00000043 "so they can be interpolated in double-quoted"
NSQ_SOURCE_LINE 00000044 "literals without messy intermediate variables."
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "Here's how I use it the most:"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "   use HTML::Entities;"
NSQ_SOURCE_LINE 00000049 "   use Tie::Function;"
NSQ_SOURCE_LINE 00000050 "   tie my %Entitize => 'Tie::Function' => \\&encode_entities;"
NSQ_SOURCE_LINE 00000051 "   ..."
NSQ_SOURCE_LINE 00000052 "   print <<EOF;"
NSQ_SOURCE_LINE 00000053 "   <em>$Entitize{$somethingaboutsomething}</em><br>"
NSQ_SOURCE_LINE 00000054 "   <textarea name=\"something\""
NSQ_SOURCE_LINE 00000055 "   cols=\"60\" rows=\"10\">$Entitize{$something}</textarea>"
NSQ_SOURCE_LINE 00000056 "   EOF"
NSQ_SOURCE_LINE 00000057 "   ..."
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=head1 EXPORT"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "nothing"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=head1 HISTORY"
NSQ_SOURCE_LINE 00000064 ""
