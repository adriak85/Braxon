BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package curry;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $VERSION = '2.000001';"
NSQ_SOURCE_LINE 00000004 "$VERSION = eval $VERSION;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $curry = sub {"
NSQ_SOURCE_LINE 00000007 "  my ($invocant, $code) = splice @_, 0, 2;"
NSQ_SOURCE_LINE 00000008 "  my @args = @_;"
NSQ_SOURCE_LINE 00000009 "  sub { $invocant->$code(@args => @_) }"
NSQ_SOURCE_LINE 00000010 "};"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "sub curry::_ { &$curry }"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000015 "  my $invocant = shift;"
NSQ_SOURCE_LINE 00000016 "  my ($method) = our $AUTOLOAD =~ /^curry::(.+)$/;"
NSQ_SOURCE_LINE 00000017 "  my @args = @_;"
NSQ_SOURCE_LINE 00000018 "  return sub {"
NSQ_SOURCE_LINE 00000019 "    $invocant->$method(@args => @_);"
NSQ_SOURCE_LINE 00000020 "  }"
NSQ_SOURCE_LINE 00000021 "}"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "package curry::weak;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "use Scalar::Util ();"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "$curry::weak = sub {"
NSQ_SOURCE_LINE 00000028 "  my ($invocant, $code) = splice @_, 0, 2;"
NSQ_SOURCE_LINE 00000029 "  Scalar::Util::weaken($invocant) if length ref $invocant;"
NSQ_SOURCE_LINE 00000030 "  my @args = @_;"
NSQ_SOURCE_LINE 00000031 "  sub {"
NSQ_SOURCE_LINE 00000032 "    return unless defined $invocant;"
NSQ_SOURCE_LINE 00000033 "    $invocant->$code(@args => @_)"
NSQ_SOURCE_LINE 00000034 "  }"
NSQ_SOURCE_LINE 00000035 "};"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub curry::weak::_ { &$curry::weak }"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000040 "  my $invocant = shift;"
NSQ_SOURCE_LINE 00000041 "  Scalar::Util::weaken($invocant) if length ref $invocant;"
NSQ_SOURCE_LINE 00000042 "  my ($method) = our $AUTOLOAD =~ /^curry::weak::(.+)$/;"
NSQ_SOURCE_LINE 00000043 "  my @args = @_;"
NSQ_SOURCE_LINE 00000044 "  return sub {"
NSQ_SOURCE_LINE 00000045 "    return unless defined $invocant;"
NSQ_SOURCE_LINE 00000046 "    $invocant->$method(@args => @_);"
NSQ_SOURCE_LINE 00000047 "  }"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "1;"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=head1 NAME"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "curry - Create automatic curried method call closures for any class or object"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "  use curry;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "  my $code = $obj->curry::frobnicate('foo');"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "is equivalent to:"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "  my $code = sub { $obj->frobnicate(foo => @_) };"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "If you have a method name (or a coderef), you can call (as of version 2):"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "  my $code = $obj->curry::_($method => 'foo');"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "Additionally,"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "  use curry::weak;"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "  my $code = $obj->curry::weak::frobnicate('foo');"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "is equivalent to:"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "  my $code = do {"
NSQ_SOURCE_LINE 00000079 "    Scalar::Util::weaken(my $weak_obj = $obj);"
NSQ_SOURCE_LINE 00000080 "    sub {"
NSQ_SOURCE_LINE 00000081 "      return unless $weak_obj; # in case it already went away"
NSQ_SOURCE_LINE 00000082 "      $weak_obj->frobnicate(foo => @_)"
NSQ_SOURCE_LINE 00000083 "    };"
NSQ_SOURCE_LINE 00000084 "  };"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "Similarly, given a method name or coderef (as of version 2):"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "  my $code = $obj->curry::weak::_($method => 'foo');"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "There are also C<$curry::curry> and C<$curry::weak> globals that work"
NSQ_SOURCE_LINE 00000091 "equivalently to C<curry::_> and C<curry::weak::_> respectively - you'll"
NSQ_SOURCE_LINE 00000092 "quite possibly see them in existing code because they were provided in"
NSQ_SOURCE_LINE 00000093 "pre-2.0 versions but they're unlikely to be the best option for new code."
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=head1 RATIONALE"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "How many times have you written"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "  sub { $obj->something($some, $args, @_) }"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "or worse still needed to weaken it and had to check and re-check your code"
NSQ_SOURCE_LINE 00000102 "to be sure you weren't closing over things the wrong way?"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "Right. That's why I wrote this."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "mst - Matt S. Trout (cpan:MSTROUT) <mst@shadowcat.co.uk>"
