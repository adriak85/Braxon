NSQ_SOURCE_LINE 00001702 ""
NSQ_SOURCE_LINE 00001703 "Return value:  (array)"
NSQ_SOURCE_LINE 00001704 ""
NSQ_SOURCE_LINE 00001705 ""
NSQ_SOURCE_LINE 00001706 ""
NSQ_SOURCE_LINE 00001707 "=head2 get_answer_summaries"
NSQ_SOURCE_LINE 00001708 ""
NSQ_SOURCE_LINE 00001709 "Usage:"
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 " get_answer_summaries($answer) -> array"
NSQ_SOURCE_LINE 00001712 ""
NSQ_SOURCE_LINE 00001713 "Extract just the entry summaries from answer structure."
NSQ_SOURCE_LINE 00001714 ""
NSQ_SOURCE_LINE 00001715 "This routine accepts a hash or an array answer structure. It then returns an"
NSQ_SOURCE_LINE 00001716 "arrayref containing just the summaries from each answer entry. If the answer is"
NSQ_SOURCE_LINE 00001717 "undef, it returns an empty arrayref."
NSQ_SOURCE_LINE 00001718 ""
NSQ_SOURCE_LINE 00001719 "See also: C<get_answer_words()>."
NSQ_SOURCE_LINE 00001720 ""
NSQ_SOURCE_LINE 00001721 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001722 ""
NSQ_SOURCE_LINE 00001723 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001724 ""
NSQ_SOURCE_LINE 00001725 "=over 4"
NSQ_SOURCE_LINE 00001726 ""
NSQ_SOURCE_LINE 00001727 "=item * B<$answer>* => I<array|hash>"
NSQ_SOURCE_LINE 00001728 ""
NSQ_SOURCE_LINE 00001729 "Completion answer structure."
NSQ_SOURCE_LINE 00001730 ""
NSQ_SOURCE_LINE 00001731 ""
NSQ_SOURCE_LINE 00001732 "=back"
NSQ_SOURCE_LINE 00001733 ""
NSQ_SOURCE_LINE 00001734 "Return value:  (array)"
NSQ_SOURCE_LINE 00001735 ""
NSQ_SOURCE_LINE 00001736 ""
NSQ_SOURCE_LINE 00001737 ""
NSQ_SOURCE_LINE 00001738 "=head2 get_answer_words"
NSQ_SOURCE_LINE 00001739 ""
NSQ_SOURCE_LINE 00001740 "Usage:"
NSQ_SOURCE_LINE 00001741 ""
NSQ_SOURCE_LINE 00001742 " get_answer_words($answer) -> array"
NSQ_SOURCE_LINE 00001743 ""
NSQ_SOURCE_LINE 00001744 "Extract just the words from answer structure."
NSQ_SOURCE_LINE 00001745 ""
NSQ_SOURCE_LINE 00001746 "This routine accepts a hash or an array answer structure. It then returns an"
NSQ_SOURCE_LINE 00001747 "arrayref containing just the words from each answer entry. If the answer is"
NSQ_SOURCE_LINE 00001748 "undef, it returns an empty arrayref."
NSQ_SOURCE_LINE 00001749 ""
NSQ_SOURCE_LINE 00001750 "See also: C<get_answer_summaries()>."
NSQ_SOURCE_LINE 00001751 ""
NSQ_SOURCE_LINE 00001752 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001753 ""
NSQ_SOURCE_LINE 00001754 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001755 ""
NSQ_SOURCE_LINE 00001756 "=over 4"
NSQ_SOURCE_LINE 00001757 ""
NSQ_SOURCE_LINE 00001758 "=item * B<$answer>* => I<array|hash>"
NSQ_SOURCE_LINE 00001759 ""
NSQ_SOURCE_LINE 00001760 "Completion answer structure."
NSQ_SOURCE_LINE 00001761 ""
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 "=back"
NSQ_SOURCE_LINE 00001764 ""
NSQ_SOURCE_LINE 00001765 "Return value:  (array)"
NSQ_SOURCE_LINE 00001766 ""
NSQ_SOURCE_LINE 00001767 ""
NSQ_SOURCE_LINE 00001768 ""
NSQ_SOURCE_LINE 00001769 "=head2 hashify_answer"
NSQ_SOURCE_LINE 00001770 ""
NSQ_SOURCE_LINE 00001771 "Usage:"
NSQ_SOURCE_LINE 00001772 ""
NSQ_SOURCE_LINE 00001773 " hashify_answer($answer, $meta) -> hash"
NSQ_SOURCE_LINE 00001774 ""
NSQ_SOURCE_LINE 00001775 "Make sure we return completion answer in hash form."
NSQ_SOURCE_LINE 00001776 ""
NSQ_SOURCE_LINE 00001777 "This function accepts a hash or an array. If it receives an array, will convert"
NSQ_SOURCE_LINE 00001778 "the array into `{words=>$ary}' first to make sure the completion answer is in"
NSQ_SOURCE_LINE 00001779 "hash form."
NSQ_SOURCE_LINE 00001780 ""
NSQ_SOURCE_LINE 00001781 "Then will add keys from C<meta> to the hash."
NSQ_SOURCE_LINE 00001782 ""
NSQ_SOURCE_LINE 00001783 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001784 ""
NSQ_SOURCE_LINE 00001785 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001786 ""
NSQ_SOURCE_LINE 00001787 "=over 4"
NSQ_SOURCE_LINE 00001788 ""
NSQ_SOURCE_LINE 00001789 "=item * B<$answer>* => I<array|hash>"
NSQ_SOURCE_LINE 00001790 ""
NSQ_SOURCE_LINE 00001791 "Completion answer structure."
NSQ_SOURCE_LINE 00001792 ""
NSQ_SOURCE_LINE 00001793 "=item * B<$meta> => I<hash>"
NSQ_SOURCE_LINE 00001794 ""
NSQ_SOURCE_LINE 00001795 "Metadata (extra keys) for the hash."
NSQ_SOURCE_LINE 00001796 ""
NSQ_SOURCE_LINE 00001797 ""
NSQ_SOURCE_LINE 00001798 "=back"
NSQ_SOURCE_LINE 00001799 ""
NSQ_SOURCE_LINE 00001800 "Return value:  (hash)"
NSQ_SOURCE_LINE 00001801 ""
NSQ_SOURCE_LINE 00001802 ""
NSQ_SOURCE_LINE 00001803 ""
