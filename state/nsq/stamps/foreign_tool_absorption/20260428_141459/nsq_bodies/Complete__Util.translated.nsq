NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "our %arg0_answer = ("
NSQ_SOURCE_LINE 00000038 "    answer => {"
NSQ_SOURCE_LINE 00000039 "        summary => 'Completion answer structure',"
NSQ_SOURCE_LINE 00000040 "        schema  => ['any*' => of => ['array*','hash*']],"
NSQ_SOURCE_LINE 00000041 "        req => 1,"
NSQ_SOURCE_LINE 00000042 "        pos => 0,"
NSQ_SOURCE_LINE 00000043 "    },"
NSQ_SOURCE_LINE 00000044 ");"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "$SPEC{':package'} = {"
NSQ_SOURCE_LINE 00000047 "    v => 1.1,"
NSQ_SOURCE_LINE 00000048 "    summary => 'General completion routine',"
NSQ_SOURCE_LINE 00000049 "    description => <<'_',"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "This package provides some generic completion routines that follow the"
NSQ_SOURCE_LINE 00000052 "<pm:Complete> convention. (If you are looking for bash/shell tab completion"
NSQ_SOURCE_LINE 00000053 "routines, take a look at L</\"SEE ALSO\">.) The main routine is"
NSQ_SOURCE_LINE 00000054 "`complete_array_elem` which tries to complete a word using choices from elements"
NSQ_SOURCE_LINE 00000055 "of supplied array. For example:"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    complete_array_elem(word => \"a\", array => [\"apple\", \"apricot\", \"banana\"]);"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "The routine will first try a simple substring prefix matching. If that fails,"
NSQ_SOURCE_LINE 00000060 "will try some other methods like word-mode, character-mode, or fuzzy matching."
NSQ_SOURCE_LINE 00000061 "These methods can be disabled using settings."
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "There are other utility routines e.g. for converting completion answer structure"
NSQ_SOURCE_LINE 00000064 "from hash to array/array to hash, combine or modify answer, etc. These routines"
NSQ_SOURCE_LINE 00000065 "are usually used by the other more specific or higher-level completion modules."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "_"
NSQ_SOURCE_LINE 00000068 "};"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "$SPEC{hashify_answer} = {"
NSQ_SOURCE_LINE 00000071 "    v => 1.1,"
NSQ_SOURCE_LINE 00000072 "    summary => 'Make sure we return completion answer in hash form',"
NSQ_SOURCE_LINE 00000073 "    description => <<'_',"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "This function accepts a hash or an array. If it receives an array, will convert"
NSQ_SOURCE_LINE 00000076 "the array into `{words=>$ary}' first to make sure the completion answer is in"
NSQ_SOURCE_LINE 00000077 "hash form."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "Then will add keys from `meta` to the hash."
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "_"
NSQ_SOURCE_LINE 00000082 "    args => {"
NSQ_SOURCE_LINE 00000083 "        %arg0_answer,"
NSQ_SOURCE_LINE 00000084 "        meta => {"
NSQ_SOURCE_LINE 00000085 "            summary => 'Metadata (extra keys) for the hash',"
NSQ_SOURCE_LINE 00000086 "            schema  => 'hash*',"
NSQ_SOURCE_LINE 00000087 "            pos => 1,"
NSQ_SOURCE_LINE 00000088 "        },"
NSQ_SOURCE_LINE 00000089 "    },"
NSQ_SOURCE_LINE 00000090 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000091 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000092 "    result => {"
NSQ_SOURCE_LINE 00000093 "        schema => 'hash*',"
NSQ_SOURCE_LINE 00000094 "    },"
NSQ_SOURCE_LINE 00000095 "};"
NSQ_SOURCE_LINE 00000096 "sub hashify_answer {"
NSQ_SOURCE_LINE 00000097 "    my $ans = shift;"
NSQ_SOURCE_LINE 00000098 "    return unless defined $ans;"
NSQ_SOURCE_LINE 00000099 "    if (ref($ans) ne 'HASH') {"
NSQ_SOURCE_LINE 00000100 "        $ans = {words=>$ans};"
NSQ_SOURCE_LINE 00000101 "    }"
NSQ_SOURCE_LINE 00000102 "    if (@_) {"
NSQ_SOURCE_LINE 00000103 "        my $meta = shift;"
NSQ_SOURCE_LINE 00000104 "        for (keys %$meta) {"
NSQ_SOURCE_LINE 00000105 "            $ans->{$_} = $meta->{$_};"
NSQ_SOURCE_LINE 00000106 "        }"
NSQ_SOURCE_LINE 00000107 "    }"
NSQ_SOURCE_LINE 00000108 "    $ans;"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "$SPEC{arrayify_answer} = {"
NSQ_SOURCE_LINE 00000112 "    v => 1.1,"
NSQ_SOURCE_LINE 00000113 "    summary => 'Make sure we return completion answer in array form',"
NSQ_SOURCE_LINE 00000114 "    description => <<'_',"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "This is the reverse of `hashify_answer`. It accepts a hash or an array. If it"
NSQ_SOURCE_LINE 00000117 "receives a hash, will return its `words` key."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "_"
NSQ_SOURCE_LINE 00000120 "    args => {"
NSQ_SOURCE_LINE 00000121 "        %arg0_answer,"
NSQ_SOURCE_LINE 00000122 "    },"
NSQ_SOURCE_LINE 00000123 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000124 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000125 "    result => {"
NSQ_SOURCE_LINE 00000126 "        schema => 'array*',"
NSQ_SOURCE_LINE 00000127 "    },"
NSQ_SOURCE_LINE 00000128 "};"
NSQ_SOURCE_LINE 00000129 "sub arrayify_answer {"
NSQ_SOURCE_LINE 00000130 "    my $ans = shift;"
NSQ_SOURCE_LINE 00000131 "    return unless defined $ans;"
NSQ_SOURCE_LINE 00000132 "    if (ref($ans) eq 'HASH') {"
NSQ_SOURCE_LINE 00000133 "        $ans = $ans->{words};"
NSQ_SOURCE_LINE 00000134 "    }"
NSQ_SOURCE_LINE 00000135 "    $ans;"
NSQ_SOURCE_LINE 00000136 "}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "$SPEC{get_answer_words} = {"
NSQ_SOURCE_LINE 00000139 "    v => 1.1,"
NSQ_SOURCE_LINE 00000140 "    summary => 'Extract just the words from answer structure',"
NSQ_SOURCE_LINE 00000141 "    description => <<'_',"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "This routine accepts a hash or an array answer structure. It then returns an"
NSQ_SOURCE_LINE 00000144 "arrayref containing just the words from each answer entry. If the answer is"
NSQ_SOURCE_LINE 00000145 "undef, it returns an empty arrayref."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "See also: `get_answer_summaries()`."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "_"
NSQ_SOURCE_LINE 00000150 "    args => {"
NSQ_SOURCE_LINE 00000151 "        %arg0_answer,"
NSQ_SOURCE_LINE 00000152 "    },"
NSQ_SOURCE_LINE 00000153 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000154 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000155 "    result => {"
NSQ_SOURCE_LINE 00000156 "        schema => 'array*',"
NSQ_SOURCE_LINE 00000157 "    },"
NSQ_SOURCE_LINE 00000158 "};"
NSQ_SOURCE_LINE 00000159 "sub get_answer_words {"
NSQ_SOURCE_LINE 00000160 "    my $ans = shift;"
NSQ_SOURCE_LINE 00000161 "    return [] unless defined $ans;"
NSQ_SOURCE_LINE 00000162 "    if (ref($ans) eq 'HASH') {"
NSQ_SOURCE_LINE 00000163 "        $ans = $ans->{words};"
NSQ_SOURCE_LINE 00000164 "    }"
NSQ_SOURCE_LINE 00000165 "    my @words;"
NSQ_SOURCE_LINE 00000166 "    for (@$ans) { push @words, ref($_) eq 'HASH' ? $_->{word} : $_ }"
NSQ_SOURCE_LINE 00000167 "    \\@words;"
NSQ_SOURCE_LINE 00000168 "}"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "$SPEC{get_answer_summaries} = {"
NSQ_SOURCE_LINE 00000171 "    v => 1.1,"
NSQ_SOURCE_LINE 00000172 "    summary => 'Extract just the entry summaries from answer structure',"
NSQ_SOURCE_LINE 00000173 "    description => <<'_',"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "This routine accepts a hash or an array answer structure. It then returns an"
NSQ_SOURCE_LINE 00000176 "arrayref containing just the summaries from each answer entry. If the answer is"
NSQ_SOURCE_LINE 00000177 "undef, it returns an empty arrayref."
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "See also: `get_answer_words()`."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "_"
NSQ_SOURCE_LINE 00000182 "    args => {"
NSQ_SOURCE_LINE 00000183 "        %arg0_answer,"
NSQ_SOURCE_LINE 00000184 "    },"
NSQ_SOURCE_LINE 00000185 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000186 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000187 "    result => {"
NSQ_SOURCE_LINE 00000188 "        schema => 'array*',"
NSQ_SOURCE_LINE 00000189 "    },"
NSQ_SOURCE_LINE 00000190 "};"
NSQ_SOURCE_LINE 00000191 "sub get_answer_summaries {"
NSQ_SOURCE_LINE 00000192 "    my $ans = shift;"
NSQ_SOURCE_LINE 00000193 "    return [] unless defined $ans;"
NSQ_SOURCE_LINE 00000194 "    if (ref($ans) eq 'HASH') {"
NSQ_SOURCE_LINE 00000195 "        $ans = $ans->{words};"
NSQ_SOURCE_LINE 00000196 "    }"
NSQ_SOURCE_LINE 00000197 "    my @summaries;"
NSQ_SOURCE_LINE 00000198 "    for (@$ans) { push @summaries, ref($_) eq 'HASH' ? $_->{summary} : undef }"
NSQ_SOURCE_LINE 00000199 "    \\@summaries;"
NSQ_SOURCE_LINE 00000200 "}"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "$SPEC{answer_num_entries} = {"
NSQ_SOURCE_LINE 00000203 "    v => 1.1,"
NSQ_SOURCE_LINE 00000204 "    summary => 'Get the number of entries in an answer',"
NSQ_SOURCE_LINE 00000205 "    description => <<'_',"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "It is equivalent to:"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "    ref $answer eq 'ARRAY' ? (@$answer // 0) : (@{$answer->{words}} // 0);"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "_"
NSQ_SOURCE_LINE 00000212 "    args => {"
NSQ_SOURCE_LINE 00000213 "        %arg0_answer,"
NSQ_SOURCE_LINE 00000214 "    },"
NSQ_SOURCE_LINE 00000215 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000216 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000217 "    result => {"
NSQ_SOURCE_LINE 00000218 "        schema => 'int*',"
NSQ_SOURCE_LINE 00000219 "    },"
NSQ_SOURCE_LINE 00000220 "};"
NSQ_SOURCE_LINE 00000221 "sub answer_num_entries {"
NSQ_SOURCE_LINE 00000222 "    my $ans = shift;"
NSQ_SOURCE_LINE 00000223 "    return unless defined $ans;"
NSQ_SOURCE_LINE 00000224 "    return ref($ans) eq 'HASH' ? (@{$ans->{words} // []} // 0) : (@$ans // 0);"
NSQ_SOURCE_LINE 00000225 "}"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "$SPEC{answer_has_entries} = {"
NSQ_SOURCE_LINE 00000228 "    v => 1.1,"
NSQ_SOURCE_LINE 00000229 "    summary => 'Check if answer has entries',"
NSQ_SOURCE_LINE 00000230 "    description => <<'_',"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "It is equivalent to:"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "    ref $answer eq 'ARRAY' ? (@$answer ? 1:0) : (@{$answer->{words}} ? 1:0);"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "_"
NSQ_SOURCE_LINE 00000237 "    args => {"
NSQ_SOURCE_LINE 00000238 "        %arg0_answer,"
NSQ_SOURCE_LINE 00000239 "    },"
NSQ_SOURCE_LINE 00000240 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000241 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000242 "    result => {"
NSQ_SOURCE_LINE 00000243 "        schema => 'int*',"
NSQ_SOURCE_LINE 00000244 "    },"
NSQ_SOURCE_LINE 00000245 "};"
NSQ_SOURCE_LINE 00000246 "sub answer_has_entries {"
NSQ_SOURCE_LINE 00000247 "    my $ans = shift;"
NSQ_SOURCE_LINE 00000248 "    return unless defined $ans;"
NSQ_SOURCE_LINE 00000249 "    return ref($ans) eq 'HASH' ? (@{$ans->{words} // []} ? 1:0) : (@$ans ? 1:0);"
NSQ_SOURCE_LINE 00000250 "}"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "sub __min(@) { ## no critic: Subroutines::ProhibitSubroutinePrototypes"
NSQ_SOURCE_LINE 00000253 "    my $m = $_[0];"
NSQ_SOURCE_LINE 00000254 "    for (@_) {"
NSQ_SOURCE_LINE 00000255 "        $m = $_ if $_ < $m;"
NSQ_SOURCE_LINE 00000256 "    }"
NSQ_SOURCE_LINE 00000257 "    $m;"
NSQ_SOURCE_LINE 00000258 "}"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "our $code_editdist;"
NSQ_SOURCE_LINE 00000261 "our $editdist_flex;"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "# straight copy of Wikipedia's \"Levenshtein Distance\""
NSQ_SOURCE_LINE 00000264 "sub __editdist {"
NSQ_SOURCE_LINE 00000265 "    my @a = split //, shift;"
NSQ_SOURCE_LINE 00000266 "    my @b = split //, shift;"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "    # There is an extra row and column in the matrix. This is the distance from"
NSQ_SOURCE_LINE 00000269 "    # the empty string to a substring of the target."
NSQ_SOURCE_LINE 00000270 "    my @d;"
NSQ_SOURCE_LINE 00000271 "    $d[$_][0] = $_ for 0 .. @a;"
NSQ_SOURCE_LINE 00000272 "    $d[0][$_] = $_ for 0 .. @b;"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "    for my $i (1 .. @a) {"
NSQ_SOURCE_LINE 00000275 "        for my $j (1 .. @b) {"
NSQ_SOURCE_LINE 00000276 "            $d[$i][$j] = ("
NSQ_SOURCE_LINE 00000277 "                $a[$i-1] eq $b[$j-1]"
NSQ_SOURCE_LINE 00000278 "                    ? $d[$i-1][$j-1]"
NSQ_SOURCE_LINE 00000279 "                    : 1 + __min("
NSQ_SOURCE_LINE 00000280 "                        $d[$i-1][$j],"
NSQ_SOURCE_LINE 00000281 "                        $d[$i][$j-1],"
NSQ_SOURCE_LINE 00000282 "                        $d[$i-1][$j-1]"
NSQ_SOURCE_LINE 00000283 "                    )"
NSQ_SOURCE_LINE 00000284 "                );"
NSQ_SOURCE_LINE 00000285 "        }"
NSQ_SOURCE_LINE 00000286 "    }"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "    $d[@a][@b];"
NSQ_SOURCE_LINE 00000289 "}"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "my %complete_array_elem_args = ("
NSQ_SOURCE_LINE 00000292 "    %arg_word,"
NSQ_SOURCE_LINE 00000293 "    array       => {"
NSQ_SOURCE_LINE 00000294 "        schema => ['array*'=>{of=>'str*'}],"
NSQ_SOURCE_LINE 00000295 "        req => 1,"
NSQ_SOURCE_LINE 00000296 "        pos => 1,"
NSQ_SOURCE_LINE 00000297 "        slurpy => 1,"
NSQ_SOURCE_LINE 00000298 "    },"
NSQ_SOURCE_LINE 00000299 "    summaries => {"
NSQ_SOURCE_LINE 00000300 "        schema => ['array*'=>{of=>'str*'}],"
NSQ_SOURCE_LINE 00000301 "    },"
NSQ_SOURCE_LINE 00000302 "    exclude     => {"
NSQ_SOURCE_LINE 00000303 "        schema => ['array*'],"
NSQ_SOURCE_LINE 00000304 "    },"
NSQ_SOURCE_LINE 00000305 "    replace_map => {"
NSQ_SOURCE_LINE 00000306 "        schema => ['hash*', each_value=>['array*', of=>'str*']],"
NSQ_SOURCE_LINE 00000307 "        description => <<'_',"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "You can supply correction entries in this option. An example is when array if"
NSQ_SOURCE_LINE 00000310 "`['mount','unmount']` and `umount` is a popular \"typo\" for `unmount`. When"
NSQ_SOURCE_LINE 00000311 "someone already types `um` it cannot be completed into anything (even the"
NSQ_SOURCE_LINE 00000312 "current fuzzy mode will return *both* so it cannot complete immediately)."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "One solution is to add replace_map `{'unmount'=>['umount']}`. This way, `umount`"
NSQ_SOURCE_LINE 00000315 "will be regarded the same as `unmount` and when user types `um` it can be"
NSQ_SOURCE_LINE 00000316 "completed unambiguously into `unmount`."
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "_"
NSQ_SOURCE_LINE 00000319 "        tags => ['experimental'],"
NSQ_SOURCE_LINE 00000320 "    },"
NSQ_SOURCE_LINE 00000321 ");"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "$SPEC{complete_array_elem} = {"
NSQ_SOURCE_LINE 00000324 "    v => 1.1,"
NSQ_SOURCE_LINE 00000325 "    summary => 'Complete from array',"
NSQ_SOURCE_LINE 00000326 "    description => <<'_',"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "Try to find completion from an array of strings. Will attempt several methods,"
NSQ_SOURCE_LINE 00000329 "from the cheapest and most discriminating to the most expensive and least"
NSQ_SOURCE_LINE 00000330 "discriminating."
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "First method is normal/exact string prefix matching (either case-sensitive or"
NSQ_SOURCE_LINE 00000333 "insensitive depending on the `$Complete::Common::OPT_CI` variable or the"
NSQ_SOURCE_LINE 00000334 "`COMPLETE_OPT_CI` environment variable). If at least one match is found, return"
NSQ_SOURCE_LINE 00000335 "result. Else, proceed to the next method."
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "Word-mode matching (can be disabled by setting"
NSQ_SOURCE_LINE 00000338 "`$Complete::Common::OPT_WORD_MODE` or `COMPLETE_OPT_WORD_MODE` environment"
NSQ_SOURCE_LINE 00000339 "varialbe to false). Word-mode matching is described in <pm:Complete::Common>. If"
NSQ_SOURCE_LINE 00000340 "at least one match is found, return result. Else, proceed to the next method."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "Prefix char-mode matching (can be disabled by settings"
NSQ_SOURCE_LINE 00000343 "`$Complete::Common::OPT_CHAR_MODE` or `COMPLETE_OPT_CHAR_MODE` environment"
NSQ_SOURCE_LINE 00000344 "variable to false). Prefix char-mode matching is just like char-mode matching"
NSQ_SOURCE_LINE 00000345 "(see next paragraph) except the first character must match. If at least one"
NSQ_SOURCE_LINE 00000346 "match is found, return result. Else, proceed to the next method."
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "Char-mode matching (can be disabled by settings"
NSQ_SOURCE_LINE 00000349 "`$Complete::Common::OPT_CHAR_MODE` or `COMPLETE_OPT_CHAR_MODE` environment"
NSQ_SOURCE_LINE 00000350 "variable to false). Char-mode matching is described in <pm:Complete::Common>. If"
NSQ_SOURCE_LINE 00000351 "at least one match is found, return result. Else, proceed to the next method."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "Fuzzy matching (can be disabled by setting `$Complete::Common::OPT_FUZZY` or"
NSQ_SOURCE_LINE 00000354 "`COMPLETE_OPT_FUZZY` to false). Fuzzy matching is described in"
NSQ_SOURCE_LINE 00000355 "<pm:Complete::Common>. If at least one match is found, return result. Else,"
NSQ_SOURCE_LINE 00000356 "return empty string."
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "Will sort the resulting completion list, so you don't have to presort the array."
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "_"
NSQ_SOURCE_LINE 00000361 "    args => {"
NSQ_SOURCE_LINE 00000362 "        %complete_array_elem_args,"
NSQ_SOURCE_LINE 00000363 "    },"
NSQ_SOURCE_LINE 00000364 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000365 "    result => {"
NSQ_SOURCE_LINE 00000366 "        schema => 'array',"
NSQ_SOURCE_LINE 00000367 "    },"
NSQ_SOURCE_LINE 00000368 "};"
NSQ_SOURCE_LINE 00000369 "sub complete_array_elem {"
NSQ_SOURCE_LINE 00000370 "    my %args  = @_;"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "    my $array0    = delete $args{array} or die \"Please specify array\";"
NSQ_SOURCE_LINE 00000373 "    my $summaries = delete $args{summaries};"
NSQ_SOURCE_LINE 00000374 "    my $word      = delete($args{word}) // \"\";"
NSQ_SOURCE_LINE 00000375 "    my $exclude   = delete $args{exclude};"
NSQ_SOURCE_LINE 00000376 "    my $replace_map = delete $args{replace_map};"
NSQ_SOURCE_LINE 00000377 "    die \"complete_array_elem(): Unknown argument(s): \".join(\", \", keys %args)"
NSQ_SOURCE_LINE 00000378 "        if keys %args;"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    my $ci          = $Complete::Common::OPT_CI;"
NSQ_SOURCE_LINE 00000381 "    my $map_case    = $Complete::Common::OPT_MAP_CASE;"
NSQ_SOURCE_LINE 00000382 "    my $word_mode   = $Complete::Common::OPT_WORD_MODE;"
NSQ_SOURCE_LINE 00000383 "    my $char_mode   = $Complete::Common::OPT_CHAR_MODE;"
NSQ_SOURCE_LINE 00000384 "    my $fuzzy       = $Complete::Common::OPT_FUZZY;"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "    log_trace(\"[computil] entering complete_array_elem(), word=<%s>\", $word)"
NSQ_SOURCE_LINE 00000387 "        if $COMPLETE_UTIL_TRACE;"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "    my $res;"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "    unless (@$array0) {"
NSQ_SOURCE_LINE 00000392 "        $res = []; goto RETURN_RES;"
NSQ_SOURCE_LINE 00000393 "    }"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "    # normalize"
NSQ_SOURCE_LINE 00000396 "    my $wordn = $ci ? uc($word) : $word; $wordn =~ s/_/-/g if $map_case;"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "    my $excluden;"
NSQ_SOURCE_LINE 00000399 "    if ($exclude) {"
NSQ_SOURCE_LINE 00000400 "        $excluden = {};"
NSQ_SOURCE_LINE 00000401 "        for my $el (@{$exclude}) {"
NSQ_SOURCE_LINE 00000402 "            my $eln = $ci ? uc($el) : $el; $eln =~ s/_/-/g if $map_case;"
NSQ_SOURCE_LINE 00000403 "            $excluden->{$eln} //= 1;"
NSQ_SOURCE_LINE 00000404 "        }"
NSQ_SOURCE_LINE 00000405 "    }"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "    my $rmapn;"
NSQ_SOURCE_LINE 00000408 "    my $rev_rmapn; # to replace back to the original words back in the result"
NSQ_SOURCE_LINE 00000409 "    if ($replace_map) {"
NSQ_SOURCE_LINE 00000410 "        $rmapn = {};"
NSQ_SOURCE_LINE 00000411 "        $rev_rmapn = {};"
NSQ_SOURCE_LINE 00000412 "        for my $k (keys %$replace_map) {"
NSQ_SOURCE_LINE 00000413 "            my $kn = $ci ? uc($k) : $k; $kn =~ s/_/-/g if $map_case;"
NSQ_SOURCE_LINE 00000414 "            my @vn;"
NSQ_SOURCE_LINE 00000415 "            for my $v (@{ $replace_map->{$k} }) {"
NSQ_SOURCE_LINE 00000416 "                my $vn = $ci ? uc($v) : $v; $vn =~ s/_/-/g if $map_case;"
NSQ_SOURCE_LINE 00000417 "                push @vn, $vn;"
NSQ_SOURCE_LINE 00000418 "                $rev_rmapn->{$vn} //= $k;"
NSQ_SOURCE_LINE 00000419 "            }"
NSQ_SOURCE_LINE 00000420 "            $rmapn->{$kn} = \\@vn;"
NSQ_SOURCE_LINE 00000421 "        }"
NSQ_SOURCE_LINE 00000422 "    }"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "    my @words;      # the answer"
NSQ_SOURCE_LINE 00000425 "    my @wordsumms;  # summaries for each item in @words"
NSQ_SOURCE_LINE 00000426 "    my @array ;     # original array + rmap entries"
NSQ_SOURCE_LINE 00000427 "    my @arrayn;     # case- & map-case-normalized form of $array + rmap entries"
NSQ_SOURCE_LINE 00000428 "    my @arraysumms; # summaries for each item in @array (or @arrayn)"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "    # normal string prefix matching. we also fill @array & @arrayn here (which"
NSQ_SOURCE_LINE 00000431 "    # will be used again in word-mode, fuzzy, and char-mode matching) so we"
NSQ_SOURCE_LINE 00000432 "    # don't have to calculate again."
NSQ_SOURCE_LINE 00000433 "    log_trace(\"[computil] Trying normal string-prefix matching ...\") if $COMPLETE_UTIL_TRACE;"
NSQ_SOURCE_LINE 00000434 "    for my $i (0..$#{$array0}) {"
NSQ_SOURCE_LINE 00000435 "        my $el = $array0->[$i];"
NSQ_SOURCE_LINE 00000436 "        my $eln = $ci ? uc($el) : $el; $eln =~ s/_/-/g if $map_case;"
NSQ_SOURCE_LINE 00000437 "        next if $excluden && $excluden->{$eln};"
NSQ_SOURCE_LINE 00000438 "        push @array , $el;"
NSQ_SOURCE_LINE 00000439 "        push @arrayn, $eln;"
NSQ_SOURCE_LINE 00000440 "        push @arraysumms, $summaries->[$i] if $summaries;"
NSQ_SOURCE_LINE 00000441 "        if (0==index($eln, $wordn)) {"
NSQ_SOURCE_LINE 00000442 "            push @words, $el;"
NSQ_SOURCE_LINE 00000443 "            push @wordsumms, $summaries->[$i] if $summaries;"
NSQ_SOURCE_LINE 00000444 "        }"
NSQ_SOURCE_LINE 00000445 "        if ($rmapn && $rmapn->{$eln}) {"
NSQ_SOURCE_LINE 00000446 "            for my $vn (@{ $rmapn->{$eln} }) {"
NSQ_SOURCE_LINE 00000447 "                push @array , $el;"
NSQ_SOURCE_LINE 00000448 "                push @arrayn, $vn;"
NSQ_SOURCE_LINE 00000449 "                # we add the normalized form, because we'll just revert it back"
NSQ_SOURCE_LINE 00000450 "                # to the original word in the final result"
NSQ_SOURCE_LINE 00000451 "                if (0==index($vn, $wordn)) {"
NSQ_SOURCE_LINE 00000452 "                    push @words, $vn;"
NSQ_SOURCE_LINE 00000453 "                    push @wordsumms, $summaries->[$i] if $summaries;"
NSQ_SOURCE_LINE 00000454 "                }"
NSQ_SOURCE_LINE 00000455 "            }"
NSQ_SOURCE_LINE 00000456 "        }"
NSQ_SOURCE_LINE 00000457 "    }"
NSQ_SOURCE_LINE 00000458 "    log_trace(\"[computil] Result from normal string-prefix matching: %s\", \\@words) if @words && $COMPLETE_UTIL_TRACE;"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "    # word-mode matching"
NSQ_SOURCE_LINE 00000461 "    {"
NSQ_SOURCE_LINE 00000462 "        last unless $word_mode && !@words;"
NSQ_SOURCE_LINE 00000463 "        my @split_wordn = $wordn =~ /(\\w+)/g;"
NSQ_SOURCE_LINE 00000464 "        unshift @split_wordn, '' if $wordn =~ /\\A\\W/;"
NSQ_SOURCE_LINE 00000465 "        last unless @split_wordn > 1;"
NSQ_SOURCE_LINE 00000466 "        my $re = '\\A';"
NSQ_SOURCE_LINE 00000467 "        for my $i (0..$#split_wordn) {"
NSQ_SOURCE_LINE 00000468 "            $re .= '(?:\\W+\\w+)*\\W+' if $i;"
NSQ_SOURCE_LINE 00000469 "            $re .= quotemeta($split_wordn[$i]).'\\w*';"
NSQ_SOURCE_LINE 00000470 "        }"
NSQ_SOURCE_LINE 00000471 "        $re = qr/$re/;"
NSQ_SOURCE_LINE 00000472 "        log_trace(\"[computil] Trying word-mode matching (re=%s) ...\", $re) if $COMPLETE_UTIL_TRACE;"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "        for my $i (0..$#array) {"
NSQ_SOURCE_LINE 00000475 "            my $match;"
NSQ_SOURCE_LINE 00000476 "            {"
NSQ_SOURCE_LINE 00000477 "                if ($arrayn[$i] =~ $re) {"
NSQ_SOURCE_LINE 00000478 "                    $match++;"
NSQ_SOURCE_LINE 00000479 "                    last;"
NSQ_SOURCE_LINE 00000480 "                }"
NSQ_SOURCE_LINE 00000481 "                # try splitting CamelCase into Camel-Case"
NSQ_SOURCE_LINE 00000482 "                my $tmp = $array[$i];"
NSQ_SOURCE_LINE 00000483 "                if ($tmp =~ s/([a-z0-9_])([A-Z])/$1-$2/g) {"
NSQ_SOURCE_LINE 00000484 "                    $tmp = uc($tmp) if $ci; $tmp =~ s/_/-/g if $map_case; # normalize again"
NSQ_SOURCE_LINE 00000485 "                    if ($tmp =~ $re) {"
NSQ_SOURCE_LINE 00000486 "                        $match++;"
NSQ_SOURCE_LINE 00000487 "                        last;"
NSQ_SOURCE_LINE 00000488 "                    }"
NSQ_SOURCE_LINE 00000489 "                }"
NSQ_SOURCE_LINE 00000490 "            }"
NSQ_SOURCE_LINE 00000491 "            next unless $match;"
NSQ_SOURCE_LINE 00000492 "            push @words, $array[$i];"
NSQ_SOURCE_LINE 00000493 "            push @wordsumms, $arraysumms[$i] if $summaries;"
NSQ_SOURCE_LINE 00000494 "        }"
NSQ_SOURCE_LINE 00000495 "        log_trace(\"[computil] Result from word-mode matching: %s\", \\@words) if @words && $COMPLETE_UTIL_TRACE;"
NSQ_SOURCE_LINE 00000496 "    }"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "    # prefix char-mode matching"
NSQ_SOURCE_LINE 00000499 "    if ($char_mode && !@words && length($wordn) && length($wordn) <= 7) {"
NSQ_SOURCE_LINE 00000500 "        my $re = join(\".*\", map {quotemeta} split(//, $wordn));"
NSQ_SOURCE_LINE 00000501 "        $re = qr/\\A$re/;"
NSQ_SOURCE_LINE 00000502 "        log_trace(\"[computil] Trying prefix char-mode matching (re=%s) ...\", $re) if $COMPLETE_UTIL_TRACE;"
NSQ_SOURCE_LINE 00000503 "        for my $i (0..$#array) {"
NSQ_SOURCE_LINE 00000504 "            if ($arrayn[$i] =~ $re) {"
NSQ_SOURCE_LINE 00000505 "                push @words, $array[$i];"
NSQ_SOURCE_LINE 00000506 "                push @wordsumms, $arraysumms[$i] if $summaries;"
NSQ_SOURCE_LINE 00000507 "            }"
NSQ_SOURCE_LINE 00000508 "        }"
NSQ_SOURCE_LINE 00000509 "        log_trace(\"[computil] Result from prefix char-mode matching: %s\", \\@words) if @words && $COMPLETE_UTIL_TRACE;"
NSQ_SOURCE_LINE 00000510 "    }"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "    # char-mode matching"
NSQ_SOURCE_LINE 00000513 "    if ($char_mode && !@words && length($wordn) && length($wordn) <= 7) {"
NSQ_SOURCE_LINE 00000514 "        my $re = join(\".*\", map {quotemeta} split(//, $wordn));"
NSQ_SOURCE_LINE 00000515 "        $re = qr/$re/;"
NSQ_SOURCE_LINE 00000516 "        log_trace(\"[computil] Trying char-mode matching (re=%s) ...\", $re) if $COMPLETE_UTIL_TRACE;"
NSQ_SOURCE_LINE 00000517 "        for my $i (0..$#array) {"
NSQ_SOURCE_LINE 00000518 "            if ($arrayn[$i] =~ $re) {"
NSQ_SOURCE_LINE 00000519 "                push @words, $array[$i];"
NSQ_SOURCE_LINE 00000520 "                push @wordsumms, $arraysumms[$i] if $summaries;"
NSQ_SOURCE_LINE 00000521 "            }"
NSQ_SOURCE_LINE 00000522 "        }"
NSQ_SOURCE_LINE 00000523 "        log_trace(\"[computil] Result from char-mode matching: %s\", \\@words) if @words && $COMPLETE_UTIL_TRACE;"
NSQ_SOURCE_LINE 00000524 "    }"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "    # fuzzy matching"
NSQ_SOURCE_LINE 00000527 "    if ($fuzzy && !@words) {"
NSQ_SOURCE_LINE 00000528 "        log_trace(\"[computil] Trying fuzzy matching ...\") if $COMPLETE_UTIL_TRACE;"
NSQ_SOURCE_LINE 00000529 "        $code_editdist //= do {"
NSQ_SOURCE_LINE 00000530 "            my $env = $ENV{COMPLETE_UTIL_LEVENSHTEIN} // '';"
NSQ_SOURCE_LINE 00000531 "            if ($env eq 'xs') {"
NSQ_SOURCE_LINE 00000532 "                require Text::Levenshtein::XS;"
NSQ_SOURCE_LINE 00000533 "                $editdist_flex = 0;"
NSQ_SOURCE_LINE 00000534 "                \\&Text::Levenshtein::XS::distance;"
NSQ_SOURCE_LINE 00000535 "            } elsif ($env eq 'flexible') {"
NSQ_SOURCE_LINE 00000536 "                require Text::Levenshtein::Flexible;"
NSQ_SOURCE_LINE 00000537 "                $editdist_flex = 1;"
NSQ_SOURCE_LINE 00000538 "                \\&Text::Levenshtein::Flexible::levenshtein_l;"
NSQ_SOURCE_LINE 00000539 "            } elsif ($env eq 'pp') {"
NSQ_SOURCE_LINE 00000540 "                $editdist_flex = 0;"
NSQ_SOURCE_LINE 00000541 "                \\&__editdist;"
NSQ_SOURCE_LINE 00000542 "            } elsif (eval { require Text::Levenshtein::Flexible; 1 }) {"
NSQ_SOURCE_LINE 00000543 "                $editdist_flex = 1;"
NSQ_SOURCE_LINE 00000544 "                \\&Text::Levenshtein::Flexible::levenshtein_l;"
NSQ_SOURCE_LINE 00000545 "            } else {"
NSQ_SOURCE_LINE 00000546 "                $editdist_flex = 0;"
NSQ_SOURCE_LINE 00000547 "                \\&__editdist;"
NSQ_SOURCE_LINE 00000548 "            }"
NSQ_SOURCE_LINE 00000549 "        };"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "        my $factor = 1.3;"
NSQ_SOURCE_LINE 00000552 "        my $x = -1;"
NSQ_SOURCE_LINE 00000553 "        my $y = 1;"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "        # note: we cannot use Text::Levenshtein::Flexible::levenshtein_l_all()"
NSQ_SOURCE_LINE 00000556 "        # because we perform distance calculation on the normalized array but we"
NSQ_SOURCE_LINE 00000557 "        # want to get the original array elements"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "        my %editdists;"
NSQ_SOURCE_LINE 00000560 "      ELEM:"
NSQ_SOURCE_LINE 00000561 "        for my $i (0..$#array) {"
NSQ_SOURCE_LINE 00000562 "            my $eln = $arrayn[$i];"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "            for my $l (length($wordn)-$y .. length($wordn)+$y) {"
NSQ_SOURCE_LINE 00000565 "                next if $l <= 0;"
NSQ_SOURCE_LINE 00000566 "                my $chopped = substr($eln, 0, $l);"
NSQ_SOURCE_LINE 00000567 "                my $maxd = __min("
NSQ_SOURCE_LINE 00000568 "                    __min(length($chopped), length($word))/$factor,"
NSQ_SOURCE_LINE 00000569 "                    $fuzzy,"
NSQ_SOURCE_LINE 00000570 "                );"
NSQ_SOURCE_LINE 00000571 "                my $d;"
NSQ_SOURCE_LINE 00000572 "                unless (defined $editdists{$chopped}) {"
NSQ_SOURCE_LINE 00000573 "                    if ($editdist_flex) {"
NSQ_SOURCE_LINE 00000574 "                        $d = $code_editdist->($wordn, $chopped, $maxd);"
NSQ_SOURCE_LINE 00000575 "                        next ELEM unless defined $d;"
NSQ_SOURCE_LINE 00000576 "                    } else {"
NSQ_SOURCE_LINE 00000577 "                        $d = $code_editdist->($wordn, $chopped);"
NSQ_SOURCE_LINE 00000578 "                    }"
NSQ_SOURCE_LINE 00000579 "                    $editdists{$chopped} = $d;"
NSQ_SOURCE_LINE 00000580 "                } else {"
NSQ_SOURCE_LINE 00000581 "                    $d = $editdists{$chopped};"
NSQ_SOURCE_LINE 00000582 "                }"
NSQ_SOURCE_LINE 00000583 "                #say \"D: d($word,$chopped)=$d (maxd=$maxd)\";"
NSQ_SOURCE_LINE 00000584 "                next unless $d <= $maxd;"
NSQ_SOURCE_LINE 00000585 "                push @words, $array[$i];"
NSQ_SOURCE_LINE 00000586 "                push @wordsumms, $arraysumms[$i] if $summaries;"
NSQ_SOURCE_LINE 00000587 "                next ELEM;"
NSQ_SOURCE_LINE 00000588 "            }"
NSQ_SOURCE_LINE 00000589 "        }"
NSQ_SOURCE_LINE 00000590 "        log_trace(\"[computil] Result from fuzzy matching: %s\", \\@words) if @words && $COMPLETE_UTIL_TRACE;"
NSQ_SOURCE_LINE 00000591 "    }"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "    # replace back the words from replace_map"
NSQ_SOURCE_LINE 00000594 "    if ($rmapn && @words) {"
NSQ_SOURCE_LINE 00000595 "        my @wordsn;"
NSQ_SOURCE_LINE 00000596 "        for my $el (@words) {"
NSQ_SOURCE_LINE 00000597 "            my $eln = $ci ? uc($el) : $el; $eln =~ s/_/-/g if $map_case;"
NSQ_SOURCE_LINE 00000598 "            push @wordsn, $eln;"
NSQ_SOURCE_LINE 00000599 "        }"
NSQ_SOURCE_LINE 00000600 "        for my $i (0..$#words) {"
NSQ_SOURCE_LINE 00000601 "            if (my $w = $rev_rmapn->{$wordsn[$i]}) {"
NSQ_SOURCE_LINE 00000602 "                $words[$i] = $w;"
NSQ_SOURCE_LINE 00000603 "            }"
NSQ_SOURCE_LINE 00000604 "        }"
NSQ_SOURCE_LINE 00000605 "    }"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "    # sort results and insert summaries"
NSQ_SOURCE_LINE 00000608 "    $res = ["
NSQ_SOURCE_LINE 00000609 "        map {"
NSQ_SOURCE_LINE 00000610 "            $summaries ?"
NSQ_SOURCE_LINE 00000611 "                {word=>$words[$_], summary=>$wordsumms[$_]} :"
NSQ_SOURCE_LINE 00000612 "                $words[$_]"
NSQ_SOURCE_LINE 00000613 "            }"
NSQ_SOURCE_LINE 00000614 "            sort {"
NSQ_SOURCE_LINE 00000615 "                $ci ?"
NSQ_SOURCE_LINE 00000616 "                    lc($words[$a]) cmp lc($words[$b]) :"
NSQ_SOURCE_LINE 00000617 "                    $words[$a]     cmp $words[$b] }"
NSQ_SOURCE_LINE 00000618 "            0 .. $#words"
NSQ_SOURCE_LINE 00000619 "        ];"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "  RETURN_RES:"
NSQ_SOURCE_LINE 00000622 "    log_trace(\"[computil] leaving complete_array_elem(), res=%s\", $res)"
NSQ_SOURCE_LINE 00000623 "        if $COMPLETE_UTIL_TRACE;"
NSQ_SOURCE_LINE 00000624 "    $res;"
NSQ_SOURCE_LINE 00000625 "}"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "$SPEC{complete_hash_key} = {"
NSQ_SOURCE_LINE 00000628 "    v => 1.1,"
NSQ_SOURCE_LINE 00000629 "    summary => 'Complete from hash keys',"
NSQ_SOURCE_LINE 00000630 "    args => {"
NSQ_SOURCE_LINE 00000631 "        %arg_word,"
NSQ_SOURCE_LINE 00000632 "        hash      => { schema=>['hash*'=>{}], req=>1 },"
NSQ_SOURCE_LINE 00000633 "        summaries => { schema=>['hash*'=>{}] },"
NSQ_SOURCE_LINE 00000634 "        summaries_from_hash_values => { schema=>'true*' },"
NSQ_SOURCE_LINE 00000635 "    },"
NSQ_SOURCE_LINE 00000636 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000637 "    result => {"
NSQ_SOURCE_LINE 00000638 "        schema => 'array',"
NSQ_SOURCE_LINE 00000639 "    },"
NSQ_SOURCE_LINE 00000640 "    args_rels => {"
NSQ_SOURCE_LINE 00000641 "        choose_one => ['summaries', 'summaries_from_hash_values'],"
NSQ_SOURCE_LINE 00000642 "    },"
NSQ_SOURCE_LINE 00000643 "};"
NSQ_SOURCE_LINE 00000644 "sub complete_hash_key {"
NSQ_SOURCE_LINE 00000645 "    my %args  = @_;"
NSQ_SOURCE_LINE 00000646 "    my $hash      = delete $args{hash} or die \"Please specify hash\";"
NSQ_SOURCE_LINE 00000647 "    my $word      = delete($args{word}) // \"\";"
NSQ_SOURCE_LINE 00000648 "    my $summaries = delete $args{summaries};"
NSQ_SOURCE_LINE 00000649 "    my $summaries_from_hash_values = delete $args{summaries_from_hash_values};"
NSQ_SOURCE_LINE 00000650 "    die \"complete_hash_key(): Unknown argument(s): \".join(\", \", keys %args)"
NSQ_SOURCE_LINE 00000651 "        if keys %args;"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "    my @keys = keys %$hash;"
NSQ_SOURCE_LINE 00000654 "    my @summaries;"
NSQ_SOURCE_LINE 00000655 "    my $has_summary;"
NSQ_SOURCE_LINE 00000656 "    if ($summaries) {"
NSQ_SOURCE_LINE 00000657 "        $has_summary++;"
NSQ_SOURCE_LINE 00000658 "        for (@keys) { push @summaries, $summaries->{$_} }"
NSQ_SOURCE_LINE 00000659 "    } elsif ($summaries_from_hash_values) {"
NSQ_SOURCE_LINE 00000660 "        $has_summary++;"
NSQ_SOURCE_LINE 00000661 "        for (@keys) { push @summaries, $hash->{$_} }"
NSQ_SOURCE_LINE 00000662 "    }"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "    complete_array_elem("
NSQ_SOURCE_LINE 00000665 "        word=>$word, array=>\\@keys,"
NSQ_SOURCE_LINE 00000666 "        (summaries=>\\@summaries) x !!$has_summary,"
NSQ_SOURCE_LINE 00000667 "    );"
NSQ_SOURCE_LINE 00000668 "}"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "$SPEC{complete_hash_value} = {"
NSQ_SOURCE_LINE 00000672 "    v => 1.1,"
NSQ_SOURCE_LINE 00000673 "    summary => 'Complete from hash values',"
NSQ_SOURCE_LINE 00000674 "    args => {"
NSQ_SOURCE_LINE 00000675 "        %arg_word,"
NSQ_SOURCE_LINE 00000676 "        hash      => { schema=>['hash*'=>{}], req=>1 },"
NSQ_SOURCE_LINE 00000677 "        summaries => { schema=>['hash*'=>{}] },"
NSQ_SOURCE_LINE 00000678 "        summaries_from_hash_keys => { schema=>'true*' },"
NSQ_SOURCE_LINE 00000679 "    },"
NSQ_SOURCE_LINE 00000680 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000681 "    result => {"
NSQ_SOURCE_LINE 00000682 "        schema => 'array',"
NSQ_SOURCE_LINE 00000683 "    },"
NSQ_SOURCE_LINE 00000684 "    args_rels => {"
NSQ_SOURCE_LINE 00000685 "        choose_one => ['summaries', 'summaries_from_hash_keys'],"
NSQ_SOURCE_LINE 00000686 "    },"
NSQ_SOURCE_LINE 00000687 "};"
NSQ_SOURCE_LINE 00000688 "sub complete_hash_value {"
NSQ_SOURCE_LINE 00000689 "    my %args  = @_;"
NSQ_SOURCE_LINE 00000690 "    my $hash      = delete $args{hash} or die \"Please specify hash\";"
NSQ_SOURCE_LINE 00000691 "    my $word      = delete($args{word}) // \"\";"
NSQ_SOURCE_LINE 00000692 "    my $summaries = delete $args{summaries};"
NSQ_SOURCE_LINE 00000693 "    my $summaries_from_hash_keys = delete $args{summaries_from_hash_keys};"
NSQ_SOURCE_LINE 00000694 "    die \"complete_hash_values(): Unknown argument(s): \".join(\", \", keys %args)"
NSQ_SOURCE_LINE 00000695 "        if keys %args;"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "    my @keys   = keys %$hash;"
NSQ_SOURCE_LINE 00000698 "    my @values = map { \"$hash->{$_}\" } @keys;"
NSQ_SOURCE_LINE 00000699 "    my @summaries;"
NSQ_SOURCE_LINE 00000700 "    my $has_summary;"
NSQ_SOURCE_LINE 00000701 "    if ($summaries) {"
NSQ_SOURCE_LINE 00000702 "        $has_summary++;"
NSQ_SOURCE_LINE 00000703 "        for (@values) { push @summaries, $summaries->{$_} }"
NSQ_SOURCE_LINE 00000704 "    } elsif ($summaries_from_hash_keys) {"
NSQ_SOURCE_LINE 00000705 "        $has_summary++;"
NSQ_SOURCE_LINE 00000706 "        @summaries = @keys;"
NSQ_SOURCE_LINE 00000707 "    }"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "    complete_array_elem("
NSQ_SOURCE_LINE 00000710 "        word=>$word, array=>\\@values,"
NSQ_SOURCE_LINE 00000711 "        (summaries=>\\@summaries) x !!$has_summary,"
NSQ_SOURCE_LINE 00000712 "    );"
NSQ_SOURCE_LINE 00000713 "}"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "my %complete_comma_sep_args = ("
NSQ_SOURCE_LINE 00000716 "    %complete_array_elem_args,"
NSQ_SOURCE_LINE 00000717 "    sep => {"
NSQ_SOURCE_LINE 00000718 "        schema  => 'str*',"
NSQ_SOURCE_LINE 00000719 "        default => ',',"
NSQ_SOURCE_LINE 00000720 "    },"
NSQ_SOURCE_LINE 00000721 "    uniq => {"
NSQ_SOURCE_LINE 00000722 "        summary => 'Whether list should contain unique elements',"
NSQ_SOURCE_LINE 00000723 "        description => <<'_',"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "When this option is set to true, if the formed list in the current word already"
NSQ_SOURCE_LINE 00000726 "contains an element, the element will not be offered again as completion answer."
NSQ_SOURCE_LINE 00000727 "For example, if `elems` is `[1,2,3,4]` and `word` is `2,3,` then without `uniq`"
NSQ_SOURCE_LINE 00000728 "set to true the completion answer is:"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "    2,3,1"
NSQ_SOURCE_LINE 00000731 "    2,3,2"
NSQ_SOURCE_LINE 00000732 "    2,3,3"
NSQ_SOURCE_LINE 00000733 "    2,3,4"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "but with `uniq` set to true, the completion answer becomes:"
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "    2,3,1"
NSQ_SOURCE_LINE 00000738 "    2,3,4"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "See also the `remaining` option for a more general mechanism of offering fewer"
NSQ_SOURCE_LINE 00000741 "elements."
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "_"
NSQ_SOURCE_LINE 00000744 "        schema => ['bool*', is=>1],"
NSQ_SOURCE_LINE 00000745 "    },"
NSQ_SOURCE_LINE 00000746 "    remaining => {"
NSQ_SOURCE_LINE 00000747 "        schema => ['code*'],"
NSQ_SOURCE_LINE 00000748 "        summary => 'What elements should remain for completion',"
NSQ_SOURCE_LINE 00000749 "        description => <<'_',"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "This is a more general mechanism if the `uniq` option does not suffice. Suppose"
NSQ_SOURCE_LINE 00000752 "you are offering completion for sorting fields. The elements are field names as"
NSQ_SOURCE_LINE 00000753 "well as field names prefixed with dash (`-`) to mean sorting with a reverse"
NSQ_SOURCE_LINE 00000754 "order. So for example `elems` is `[\"name\",\"-name\",\"age\",\"-age\"]`. When current"
NSQ_SOURCE_LINE 00000755 "word is `name`, it doesn't make sense to offer `name` nor `-name` again as the"
NSQ_SOURCE_LINE 00000756 "next sorting field. So we can set `remaining` to this code:"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "    sub {"
NSQ_SOURCE_LINE 00000759 "        my ($seen_elems, $elems) = @_;"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "        my %seen;"
NSQ_SOURCE_LINE 00000762 "        for (@$seen_elems) {"
NSQ_SOURCE_LINE 00000763 "            (my $nodash = $_) =~ s/^-//;"
NSQ_SOURCE_LINE 00000764 "            $seen{$nodash}++;"
NSQ_SOURCE_LINE 00000765 "        }"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "        my @remaining;"
NSQ_SOURCE_LINE 00000768 "        for (@$elems) {"
NSQ_SOURCE_LINE 00000769 "            (my $nodash = $_) =~ s/^-//;"
NSQ_SOURCE_LINE 00000770 "            push @remaining, $_ unless $seen{$nodash};"
NSQ_SOURCE_LINE 00000771 "        }"
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "        \\@remaining;"
NSQ_SOURCE_LINE 00000774 "    }"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "As you can see above, the code is given `$seen_elems` and `$elems` as arguments"
NSQ_SOURCE_LINE 00000777 "and is expected to return remaining elements to offer."
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "_"
NSQ_SOURCE_LINE 00000780 "        tags => ['hidden-cli'],"
NSQ_SOURCE_LINE 00000781 "    },"
NSQ_SOURCE_LINE 00000782 ");"
