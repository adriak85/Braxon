NSQ_SOURCE_LINE 00000785 "$SPEC{complete_comma_sep} = {"
NSQ_SOURCE_LINE 00000786 "    v => 1.1,"
NSQ_SOURCE_LINE 00000787 "    summary => 'Complete a comma-separated list string',"
NSQ_SOURCE_LINE 00000788 "    args => {"
NSQ_SOURCE_LINE 00000789 "        %complete_comma_sep_args,"
NSQ_SOURCE_LINE 00000790 "    },"
NSQ_SOURCE_LINE 00000791 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000792 "    result => {"
NSQ_SOURCE_LINE 00000793 "        schema => 'array',"
NSQ_SOURCE_LINE 00000794 "    },"
NSQ_SOURCE_LINE 00000795 "};"
NSQ_SOURCE_LINE 00000796 "sub complete_comma_sep {"
NSQ_SOURCE_LINE 00000797 "    my %args  = @_;"
NSQ_SOURCE_LINE 00000798 "    my $word      = delete $args{word} // \"\";"
NSQ_SOURCE_LINE 00000799 "    my $sep       = delete $args{sep} // ',';"
NSQ_SOURCE_LINE 00000800 "    my $elems     = delete $args{elems} or die \"Please specify elems\";"
NSQ_SOURCE_LINE 00000801 "    my $summaries = delete $args{summaries};"
NSQ_SOURCE_LINE 00000802 "    my $uniq      = delete $args{uniq};"
NSQ_SOURCE_LINE 00000803 "    my $remaining = delete $args{remaining};"
NSQ_SOURCE_LINE 00000804 "    my $exclude     = delete $args{exclude};"
NSQ_SOURCE_LINE 00000805 "    my $replace_map = delete $args{replace_map};"
NSQ_SOURCE_LINE 00000806 "    die \"complete_comma_sep(): Unknown argument(s): \".join(\", \", keys %args)"
NSQ_SOURCE_LINE 00000807 "        if keys %args;"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "    my $ci = $Complete::Common::OPT_CI;"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "    my %summaries_for; # key=elem val=summary"
NSQ_SOURCE_LINE 00000812 "  GEN_SUMMARIES_HASH:"
NSQ_SOURCE_LINE 00000813 "    {"
NSQ_SOURCE_LINE 00000814 "        last unless $summaries;"
NSQ_SOURCE_LINE 00000815 "        for my $i (0 .. $#{$elems}) {"
NSQ_SOURCE_LINE 00000816 "            my $elem0 = $elems->[$i];"
NSQ_SOURCE_LINE 00000817 "            my $summary = $summaries->[$i];"
NSQ_SOURCE_LINE 00000818 "            my $elem = $ci ? lc($elem0) : $elem0;"
NSQ_SOURCE_LINE 00000819 "            if (exists $summaries_for{$elem}) {"
NSQ_SOURCE_LINE 00000820 "                log_warn \"Non-unique value '$elem', using only the first summary for it\";"
NSQ_SOURCE_LINE 00000821 "                next;"
NSQ_SOURCE_LINE 00000822 "            }"
NSQ_SOURCE_LINE 00000823 "            $summaries_for{$elem} = $summary;"
NSQ_SOURCE_LINE 00000824 "        }"
NSQ_SOURCE_LINE 00000825 "    } # GEN_SUMMARIES_HASH"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "    my @mentioned_elems = split /\\Q$sep\\E/, $word, -1;"
NSQ_SOURCE_LINE 00000828 "    my $cae_word = @mentioned_elems ? pop(@mentioned_elems) : ''; # cae=complete_array_elem"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "    my $remaining_elems;"
NSQ_SOURCE_LINE 00000831 "    if ($remaining) {"
NSQ_SOURCE_LINE 00000832 "        $remaining_elems = $remaining->(\\@mentioned_elems, $elems);"
NSQ_SOURCE_LINE 00000833 "    } elsif ($uniq) {"
NSQ_SOURCE_LINE 00000834 "        my %mem;"
NSQ_SOURCE_LINE 00000835 "        $remaining_elems = [];"
NSQ_SOURCE_LINE 00000836 "        for (@mentioned_elems) {"
NSQ_SOURCE_LINE 00000837 "            if ($ci) { $mem{lc $_}++ } else { $mem{$_}++ }"
NSQ_SOURCE_LINE 00000838 "        }"
NSQ_SOURCE_LINE 00000839 "        for (@$elems) {"
NSQ_SOURCE_LINE 00000840 "            push @$remaining_elems, $_ unless ($ci ? $mem{lc $_} : $mem{$_});"
NSQ_SOURCE_LINE 00000841 "        }"
NSQ_SOURCE_LINE 00000842 "    } else {"
NSQ_SOURCE_LINE 00000843 "        $remaining_elems = $elems;"
NSQ_SOURCE_LINE 00000844 "    }"
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "    my $cae_res = complete_array_elem("
NSQ_SOURCE_LINE 00000847 "        word  => $cae_word,"
NSQ_SOURCE_LINE 00000848 "        array => $remaining_elems,"
NSQ_SOURCE_LINE 00000849 "        exclude => $exclude,"
NSQ_SOURCE_LINE 00000850 "        replace_map => $replace_map,"
NSQ_SOURCE_LINE 00000851 "        ($summaries ? (summaries=>[map {$summaries_for{ $ci ? lc($_):$_ }} @$remaining_elems]) : ()),"
NSQ_SOURCE_LINE 00000852 "    );"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "    my $prefix = join($sep, @mentioned_elems);"
NSQ_SOURCE_LINE 00000855 "    $prefix .= $sep if @mentioned_elems;"
NSQ_SOURCE_LINE 00000856 "    $cae_res = [map { ref $_ eq 'HASH' ? { %$_, word=>\"$prefix$_->{word}\" } : \"$prefix$_\" } @$cae_res];"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "    # add trailing comma for convenience, where appropriate"
NSQ_SOURCE_LINE 00000859 "    {"
NSQ_SOURCE_LINE 00000860 "        last unless @$cae_res == 1;"
NSQ_SOURCE_LINE 00000861 "        last if @$remaining_elems <= 1;"
NSQ_SOURCE_LINE 00000862 "        $cae_res = [{word=>$cae_res->[0]}] unless ref $cae_res->[0] eq 'HASH';"
NSQ_SOURCE_LINE 00000863 "        $cae_res = [{word=>\"$cae_res->[0]{word}$sep\", (defined $cae_res->[0]{summary} ? (summary=>$cae_res->[0]{summary}) : ()), is_partial=>1}];"
NSQ_SOURCE_LINE 00000864 "    }"
NSQ_SOURCE_LINE 00000865 "    $cae_res;"
NSQ_SOURCE_LINE 00000866 "}"
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "$SPEC{complete_comma_sep_pair} = {"
NSQ_SOURCE_LINE 00000869 "    v => 1.1,"
NSQ_SOURCE_LINE 00000870 "    summary => 'Complete a comma-separated list of key-value pairs',"
NSQ_SOURCE_LINE 00000871 "    args => {"
NSQ_SOURCE_LINE 00000872 "        %arg_word,"
NSQ_SOURCE_LINE 00000873 "        keys => {"
NSQ_SOURCE_LINE 00000874 "            schema => ['array*', of=>'str*'],"
NSQ_SOURCE_LINE 00000875 "            req => 1,"
NSQ_SOURCE_LINE 00000876 "        },"
NSQ_SOURCE_LINE 00000877 "        keys_summaries => {"
NSQ_SOURCE_LINE 00000878 "            summary => 'Summary for each key',"
NSQ_SOURCE_LINE 00000879 "            schema => ['array*', of=>'str*'],"
NSQ_SOURCE_LINE 00000880 "        },"
NSQ_SOURCE_LINE 00000881 "        complete_value => {"
NSQ_SOURCE_LINE 00000882 "            summary => 'Code to supply possible values for a key',"
NSQ_SOURCE_LINE 00000883 "            schema => 'code*',"
NSQ_SOURCE_LINE 00000884 "            description => <<'_',"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "Code should accept hash arguments and will be given the arguments `word` (word"
NSQ_SOURCE_LINE 00000887 "that is part of the value), and `key` (the key being evaluated) and is expected"
NSQ_SOURCE_LINE 00000888 "to return a completion answer."
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "_"
NSQ_SOURCE_LINE 00000891 "        },"
NSQ_SOURCE_LINE 00000892 "        uniq => {"
NSQ_SOURCE_LINE 00000893 "            summary => 'If set to true, then do not offer key that has been mentioned before in the word',"
NSQ_SOURCE_LINE 00000894 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000895 "            default => 1,"
NSQ_SOURCE_LINE 00000896 "        },"
NSQ_SOURCE_LINE 00000897 "        remaining_keys => {"
NSQ_SOURCE_LINE 00000898 "            schema => ['code*'],"
NSQ_SOURCE_LINE 00000899 "            summary => 'What keys should remain for completion',"
NSQ_SOURCE_LINE 00000900 "            description => <<'_',"
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "This is a more general mechanism if the `uniq` option does not suffice. Suppose"
NSQ_SOURCE_LINE 00000903 "you are offering completion for arguments. Possible arguments are `foo`, `bar`,"
NSQ_SOURCE_LINE 00000904 "`baz` but the `bar` and `baz` arguments are mutually exclusive. We can set"
NSQ_SOURCE_LINE 00000905 "`remaining_keys` to this code:"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "    my %possible_args = {foo=>1, bar=>1, baz=>1};"
NSQ_SOURCE_LINE 00000908 "    sub {"
NSQ_SOURCE_LINE 00000909 "        my ($seen_elems, $elems) = @_;"
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "        my %remaining = %possible_args;"
NSQ_SOURCE_LINE 00000912 "        for (@$seen_elems) {"
NSQ_SOURCE_LINE 00000913 "            delete $remaining{$_};"
NSQ_SOURCE_LINE 00000914 "            delete $remaining{baz} if $_ eq 'bar';"
NSQ_SOURCE_LINE 00000915 "            delete $remaining{bar} if $_ eq 'baz';"
NSQ_SOURCE_LINE 00000916 "        }"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "        [keys %remaining];"
NSQ_SOURCE_LINE 00000919 "    }"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "As you can see above, the code is given `$seen_elems` and `$elems` as arguments"
NSQ_SOURCE_LINE 00000922 "and is expected to return remaining elements to offer."
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "_"
NSQ_SOURCE_LINE 00000926 "        },"
NSQ_SOURCE_LINE 00000927 "    },"
NSQ_SOURCE_LINE 00000928 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000929 "    result => {"
NSQ_SOURCE_LINE 00000930 "        schema => 'array',"
NSQ_SOURCE_LINE 00000931 "    },"
NSQ_SOURCE_LINE 00000932 "};"
NSQ_SOURCE_LINE 00000933 "sub complete_comma_sep_pair {"
NSQ_SOURCE_LINE 00000934 "    my %args  = @_;"
NSQ_SOURCE_LINE 00000935 "    my $word           = delete $args{word} // \"\";"
NSQ_SOURCE_LINE 00000936 "    my $sep            = delete $args{sep} // ',';"
NSQ_SOURCE_LINE 00000937 "    my $keys           = delete $args{keys} or die \"Please specify keys\";"
NSQ_SOURCE_LINE 00000938 "    my $keys_summaries = delete $args{keys_summaries};"
NSQ_SOURCE_LINE 00000939 "    my $uniq           = delete $args{uniq} // 1;"
NSQ_SOURCE_LINE 00000940 "    my $remaining_keys = delete $args{remaining_keys};"
NSQ_SOURCE_LINE 00000941 "    my $complete_value = delete $args{complete_value};"
NSQ_SOURCE_LINE 00000942 "    die \"complete_comma_sep_pair(): Unknown argument(s): \".join(\", \", keys %args)"
NSQ_SOURCE_LINE 00000943 "        if keys %args;"
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 "    my $ci = $Complete::Common::OPT_CI;"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "    my %keys_summaries_for; # key=elem val=summary"
NSQ_SOURCE_LINE 00000948 "  GEN_KEYS_SUMMARIES_HASH:"
NSQ_SOURCE_LINE 00000949 "    {"
NSQ_SOURCE_LINE 00000950 "        last unless $keys_summaries;"
NSQ_SOURCE_LINE 00000951 "        for my $i (0 .. $#{$keys}) {"
NSQ_SOURCE_LINE 00000952 "            my $key0 = $keys->[$i];"
NSQ_SOURCE_LINE 00000953 "            my $summary = $keys_summaries->[$i];"
NSQ_SOURCE_LINE 00000954 "            my $key = $ci ? lc($key0) : $key0;"
NSQ_SOURCE_LINE 00000955 "            if (exists $keys_summaries_for{$key}) {"
NSQ_SOURCE_LINE 00000956 "                log_warn \"Non-unique key '$key', using only the first summary for it\";"
NSQ_SOURCE_LINE 00000957 "                next;"
NSQ_SOURCE_LINE 00000958 "            }"
NSQ_SOURCE_LINE 00000959 "            $keys_summaries_for{$key} = $summary;"
NSQ_SOURCE_LINE 00000960 "        }"
NSQ_SOURCE_LINE 00000961 "    } # GEN_KEYS_SUMMARIES_HASH"
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "    my @mentioned_elems = split /\\Q$sep\\E/, $word, -1;"
NSQ_SOURCE_LINE 00000964 "    my @mentioned_keys;"
NSQ_SOURCE_LINE 00000965 "    for my $i (0..$#mentioned_elems) { push @mentioned_keys, $mentioned_elems[$i] if $i % 2 == 0 }"
NSQ_SOURCE_LINE 00000966 ""
NSQ_SOURCE_LINE 00000967 "    if (@mentioned_elems == 0 || @mentioned_elems % 2 == 1) {"
NSQ_SOURCE_LINE 00000968 ""
NSQ_SOURCE_LINE 00000969 "        # we should be completing keys"
NSQ_SOURCE_LINE 00000970 "        my $cae_word = @mentioned_keys ? pop(@mentioned_keys) : ''; # cae=complete_array_elem"
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "        my $remaining_elems;"
NSQ_SOURCE_LINE 00000973 "        if ($remaining_keys) {"
NSQ_SOURCE_LINE 00000974 "            $remaining_elems = $remaining_keys->(\\@mentioned_keys, $keys);"
NSQ_SOURCE_LINE 00000975 "        } elsif ($uniq) {"
NSQ_SOURCE_LINE 00000976 "            my %mem;"
NSQ_SOURCE_LINE 00000977 "            $remaining_elems = [];"
NSQ_SOURCE_LINE 00000978 "            for (@mentioned_keys) {"
NSQ_SOURCE_LINE 00000979 "                if ($ci) { $mem{lc $_}++ } else { $mem{$_}++ }"
NSQ_SOURCE_LINE 00000980 "            }"
NSQ_SOURCE_LINE 00000981 "            for (@$keys) {"
NSQ_SOURCE_LINE 00000982 "                push @$remaining_elems, $_ unless ($ci ? $mem{lc $_} : $mem{$_});"
NSQ_SOURCE_LINE 00000983 "            }"
NSQ_SOURCE_LINE 00000984 "        } else {"
NSQ_SOURCE_LINE 00000985 "            $remaining_elems = $keys;"
NSQ_SOURCE_LINE 00000986 "        }"
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 "        my $cae_res = complete_array_elem("
NSQ_SOURCE_LINE 00000989 "            %args,"
NSQ_SOURCE_LINE 00000990 "            word  => $cae_word,"
NSQ_SOURCE_LINE 00000991 "            array => $remaining_elems,"
NSQ_SOURCE_LINE 00000992 "            ($keys_summaries ? (summaries=>[map {$keys_summaries_for{ $ci ? lc($_):$_ }} @$remaining_elems]) : ()),"
NSQ_SOURCE_LINE 00000993 "        );"
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "        pop @mentioned_elems;"
NSQ_SOURCE_LINE 00000996 "        my $prefix = join($sep, @mentioned_elems);"
NSQ_SOURCE_LINE 00000997 "        $prefix .= $sep if @mentioned_elems;"
NSQ_SOURCE_LINE 00000998 "        $cae_res = [map { ref $_ eq 'HASH' ? { %$_, word=>\"$prefix$_->{word}\" } : \"$prefix$_\" } @$cae_res];"
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "        # add trailing comma for convenience, where appropriate"
NSQ_SOURCE_LINE 00001001 "        {"
NSQ_SOURCE_LINE 00001002 "            last unless @$cae_res == 1;"
NSQ_SOURCE_LINE 00001003 "            last if @$remaining_elems <= 1;"
NSQ_SOURCE_LINE 00001004 "            $cae_res = [{word=>$cae_res->[0]}] unless ref $cae_res->[0] eq 'HASH';"
NSQ_SOURCE_LINE 00001005 "            $cae_res = [{word=>\"$cae_res->[0]{word}$sep\", (defined $cae_res->[0]{summary} ? (summary=>$cae_res->[0]{summary}) : ()), is_partial=>1}];"
NSQ_SOURCE_LINE 00001006 "        }"
NSQ_SOURCE_LINE 00001007 "        return $cae_res;"
NSQ_SOURCE_LINE 00001008 ""
NSQ_SOURCE_LINE 00001009 "    } else {"
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "        # we should be completing values"
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "        return [] unless $complete_value;"
NSQ_SOURCE_LINE 00001014 "        my $word = pop @mentioned_elems;"
NSQ_SOURCE_LINE 00001015 "        my $res = $complete_value->(word=>$word, key=>$mentioned_keys[-1]);"
NSQ_SOURCE_LINE 00001016 "        my $prefix = join($sep, @mentioned_elems);"
NSQ_SOURCE_LINE 00001017 "        $prefix .= $sep if @mentioned_elems;"
NSQ_SOURCE_LINE 00001018 "        modify_answer(answer=>$res, prefix=>$prefix);"
NSQ_SOURCE_LINE 00001019 "    }"
NSQ_SOURCE_LINE 00001020 "}"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "$SPEC{combine_answers} = {"
NSQ_SOURCE_LINE 00001023 "    v => 1.1,"
NSQ_SOURCE_LINE 00001024 "    summary => 'Given two or more answers, combine them into one',"
NSQ_SOURCE_LINE 00001025 "    description => <<'_',"
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "This function is useful if you want to provide a completion answer that is"
NSQ_SOURCE_LINE 00001028 "gathered from multiple sources. For example, say you are providing completion"
NSQ_SOURCE_LINE 00001029 "for the Perl tool <prog:cpanm>, which accepts a filename (a tarball like"
NSQ_SOURCE_LINE 00001030 "`*.tar.gz`), a directory, or a module name. You can do something like this:"
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "    combine_answers("
NSQ_SOURCE_LINE 00001033 "        complete_file(word=>$word),"
NSQ_SOURCE_LINE 00001034 "        complete_module(word=>$word),"
NSQ_SOURCE_LINE 00001035 "    );"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "But if a completion answer has a metadata `final` set to true, then that answer"
NSQ_SOURCE_LINE 00001038 "is used as the final answer without any combining with the other answers."
NSQ_SOURCE_LINE 00001039 ""
NSQ_SOURCE_LINE 00001040 "_"
NSQ_SOURCE_LINE 00001041 "    args => {"
NSQ_SOURCE_LINE 00001042 "        answers => {"
NSQ_SOURCE_LINE 00001043 "            schema => ["
NSQ_SOURCE_LINE 00001044 "                'array*' => {"
NSQ_SOURCE_LINE 00001045 "                    of => ['any*', of=>['hash*','array*']], # XXX answer_t"
NSQ_SOURCE_LINE 00001046 "                    min_len => 1,"
NSQ_SOURCE_LINE 00001047 "                },"
NSQ_SOURCE_LINE 00001048 "            ],"
NSQ_SOURCE_LINE 00001049 "            req => 1,"
NSQ_SOURCE_LINE 00001050 "            pos => 0,"
NSQ_SOURCE_LINE 00001051 "            greedy => 1,"
NSQ_SOURCE_LINE 00001052 "        },"
NSQ_SOURCE_LINE 00001053 "    },"
NSQ_SOURCE_LINE 00001054 "    args_as => 'array',"
NSQ_SOURCE_LINE 00001055 "    result_naked => 1,"
NSQ_SOURCE_LINE 00001056 "    result => {"
NSQ_SOURCE_LINE 00001057 "        schema => 'hash*',"
NSQ_SOURCE_LINE 00001058 "        description => <<'_',"
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "Return a combined completion answer. Words from each input answer will be"
NSQ_SOURCE_LINE 00001061 "combined, order preserved and duplicates removed. The other keys from each"
NSQ_SOURCE_LINE 00001062 "answer will be merged."
NSQ_SOURCE_LINE 00001063 ""
NSQ_SOURCE_LINE 00001064 "_"
NSQ_SOURCE_LINE 00001065 "    },"
NSQ_SOURCE_LINE 00001066 "};"
NSQ_SOURCE_LINE 00001067 "sub combine_answers {"
NSQ_SOURCE_LINE 00001068 "    require List::Util;"
NSQ_SOURCE_LINE 00001069 ""
NSQ_SOURCE_LINE 00001070 "    return unless @_;"
NSQ_SOURCE_LINE 00001071 "    return $_[0] if @_ < 2;"
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "    my $final = {words=>[]};"
NSQ_SOURCE_LINE 00001074 "    my $encounter_hash;"
NSQ_SOURCE_LINE 00001075 "    my $add_words = sub {"
NSQ_SOURCE_LINE 00001076 "        my $words = shift;"
NSQ_SOURCE_LINE 00001077 "        for my $entry (@$words) {"
NSQ_SOURCE_LINE 00001078 "            push @{ $final->{words} }, $entry"
NSQ_SOURCE_LINE 00001079 "                unless List::Util::first("
NSQ_SOURCE_LINE 00001080 "                    sub {"
NSQ_SOURCE_LINE 00001081 "                        (ref($entry) ? $entry->{word} : $entry)"
NSQ_SOURCE_LINE 00001082 "                            eq"
NSQ_SOURCE_LINE 00001083 "                                (ref($_) ? $_->{word} : $_)"
NSQ_SOURCE_LINE 00001084 "                            }, @{ $final->{words} }"
NSQ_SOURCE_LINE 00001085 "                        );"
NSQ_SOURCE_LINE 00001086 "        }"
NSQ_SOURCE_LINE 00001087 "    };"
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "  ANSWER:"
NSQ_SOURCE_LINE 00001090 "    for my $ans (@_) {"
NSQ_SOURCE_LINE 00001091 "        if (ref($ans) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00001092 "            $add_words->($ans);"
NSQ_SOURCE_LINE 00001093 "        } elsif (ref($ans) eq 'HASH') {"
NSQ_SOURCE_LINE 00001094 "            $encounter_hash++;"
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 "            if ($ans->{final}) {"
NSQ_SOURCE_LINE 00001097 "                $final = $ans;"
NSQ_SOURCE_LINE 00001098 "                last ANSWER;"
NSQ_SOURCE_LINE 00001099 "            }"
NSQ_SOURCE_LINE 00001100 ""
NSQ_SOURCE_LINE 00001101 "            $add_words->($ans->{words} // []);"
NSQ_SOURCE_LINE 00001102 "            for (keys %$ans) {"
NSQ_SOURCE_LINE 00001103 "                if ($_ eq 'words') {"
NSQ_SOURCE_LINE 00001104 "                    next;"
NSQ_SOURCE_LINE 00001105 "                } elsif ($_ eq 'static') {"
NSQ_SOURCE_LINE 00001106 "                    if (exists $final->{$_}) {"
NSQ_SOURCE_LINE 00001107 "                        $final->{$_} &&= $ans->{$_};"
NSQ_SOURCE_LINE 00001108 "                    } else {"
NSQ_SOURCE_LINE 00001109 "                        $final->{$_} = $ans->{$_};"
NSQ_SOURCE_LINE 00001110 "                    }"
NSQ_SOURCE_LINE 00001111 "                } else {"
NSQ_SOURCE_LINE 00001112 "                    $final->{$_} = $ans->{$_};"
NSQ_SOURCE_LINE 00001113 "                }"
NSQ_SOURCE_LINE 00001114 "            }"
NSQ_SOURCE_LINE 00001115 "        }"
NSQ_SOURCE_LINE 00001116 "    }"
NSQ_SOURCE_LINE 00001117 ""
NSQ_SOURCE_LINE 00001118 "    $encounter_hash ? $final : $final->{words};"
NSQ_SOURCE_LINE 00001119 "}"
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 "$SPEC{modify_answer} = {"
NSQ_SOURCE_LINE 00001122 "    v => 1.1,"
NSQ_SOURCE_LINE 00001123 "    summary => 'Modify answer (add prefix/suffix, etc)',"
NSQ_SOURCE_LINE 00001124 "    args => {"
NSQ_SOURCE_LINE 00001125 "        answer => {"
NSQ_SOURCE_LINE 00001126 "            schema => ['any*', of=>['hash*','array*']], # XXX answer_t"
NSQ_SOURCE_LINE 00001127 "            req => 1,"
NSQ_SOURCE_LINE 00001128 "            pos => 0,"
NSQ_SOURCE_LINE 00001129 "        },"
NSQ_SOURCE_LINE 00001130 "        suffix => {"
NSQ_SOURCE_LINE 00001131 "            schema => 'str*',"
NSQ_SOURCE_LINE 00001132 "        },"
NSQ_SOURCE_LINE 00001133 "        prefix => {"
NSQ_SOURCE_LINE 00001134 "            schema => 'str*',"
NSQ_SOURCE_LINE 00001135 "        },"
NSQ_SOURCE_LINE 00001136 "    },"
NSQ_SOURCE_LINE 00001137 "    result_naked => 1,"
NSQ_SOURCE_LINE 00001138 "    result => {"
NSQ_SOURCE_LINE 00001139 "        schema => 'undef',"
NSQ_SOURCE_LINE 00001140 "    },"
NSQ_SOURCE_LINE 00001141 "};"
NSQ_SOURCE_LINE 00001142 "sub modify_answer {"
NSQ_SOURCE_LINE 00001143 "    my %args = @_;"
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "    my $answer = delete $args{answer};"
NSQ_SOURCE_LINE 00001146 "    my $words = ref($answer) eq 'HASH' ? $answer->{words} : $answer;"
NSQ_SOURCE_LINE 00001147 "    my $prefix = delete $args{prefix};"
NSQ_SOURCE_LINE 00001148 "    my $suffix = delete $args{suffix};"
NSQ_SOURCE_LINE 00001149 "    die \"modify_answer(): Unknown argument(s): \".join(\", \", keys %args)"
NSQ_SOURCE_LINE 00001150 "        if keys %args;"
NSQ_SOURCE_LINE 00001151 ""
NSQ_SOURCE_LINE 00001152 "    if (defined $prefix) {"
NSQ_SOURCE_LINE 00001153 "        for (@$words) {"
NSQ_SOURCE_LINE 00001154 "            if (ref $_ eq 'HASH') {"
NSQ_SOURCE_LINE 00001155 "                $_->{word} = \"$prefix$_->{word}\";"
NSQ_SOURCE_LINE 00001156 "            } else {"
NSQ_SOURCE_LINE 00001157 "                $_ = \"$prefix$_\";"
NSQ_SOURCE_LINE 00001158 "            }"
NSQ_SOURCE_LINE 00001159 "        }"
NSQ_SOURCE_LINE 00001160 "    }"
NSQ_SOURCE_LINE 00001161 "    if (defined $suffix) {"
NSQ_SOURCE_LINE 00001162 "        for (@$words) {"
NSQ_SOURCE_LINE 00001163 "            if (ref $_ eq 'HASH') {"
NSQ_SOURCE_LINE 00001164 "                $_->{word} = \"$_->{word}$suffix\";"
NSQ_SOURCE_LINE 00001165 "            } else {"
NSQ_SOURCE_LINE 00001166 "                $_ = \"$_$suffix\";"
NSQ_SOURCE_LINE 00001167 "            }"
NSQ_SOURCE_LINE 00001168 "        }"
NSQ_SOURCE_LINE 00001169 "    }"
NSQ_SOURCE_LINE 00001170 "    $answer;"
NSQ_SOURCE_LINE 00001171 "}"
NSQ_SOURCE_LINE 00001172 ""
NSQ_SOURCE_LINE 00001173 "$SPEC{ununiquify_answer} = {"
NSQ_SOURCE_LINE 00001174 "    v => 1.1,"
NSQ_SOURCE_LINE 00001175 "    summary => 'If answer contains only one item, make it two',"
NSQ_SOURCE_LINE 00001176 "    description => <<'_',"
NSQ_SOURCE_LINE 00001177 ""
NSQ_SOURCE_LINE 00001178 "For example, if answer is `[\"a\"]`, then will make answer become `[\"a\",\"a \"]`."
NSQ_SOURCE_LINE 00001179 "This will prevent shell from automatically adding space."
NSQ_SOURCE_LINE 00001180 ""
NSQ_SOURCE_LINE 00001181 "_"
NSQ_SOURCE_LINE 00001182 "    args => {"
NSQ_SOURCE_LINE 00001183 "        answer => {"
NSQ_SOURCE_LINE 00001184 "            schema => ['any*', of=>['hash*','array*']], # XXX answer_t"
NSQ_SOURCE_LINE 00001185 "            req => 1,"
NSQ_SOURCE_LINE 00001186 "            pos => 0,"
NSQ_SOURCE_LINE 00001187 "        },"
NSQ_SOURCE_LINE 00001188 "    },"
NSQ_SOURCE_LINE 00001189 "    result_naked => 1,"
NSQ_SOURCE_LINE 00001190 "    result => {"
NSQ_SOURCE_LINE 00001191 "        schema => 'undef',"
NSQ_SOURCE_LINE 00001192 "    },"
NSQ_SOURCE_LINE 00001193 "};"
NSQ_SOURCE_LINE 00001194 "sub ununiquify_answer {"
NSQ_SOURCE_LINE 00001195 "    my %args = @_;"
NSQ_SOURCE_LINE 00001196 ""
NSQ_SOURCE_LINE 00001197 "    my $answer = delete $args{answer};"
NSQ_SOURCE_LINE 00001198 "    my $words = ref($answer) eq 'HASH' ? $answer->{words} : $answer;"
NSQ_SOURCE_LINE 00001199 "    die \"ununiquify_answer(): Unknown argument(s): \".join(\", \", keys %args)"
NSQ_SOURCE_LINE 00001200 "        if keys %args;"
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "    if (@$words == 1) {"
NSQ_SOURCE_LINE 00001203 "        push @$words, \"$words->[0] \";"
NSQ_SOURCE_LINE 00001204 "    }"
NSQ_SOURCE_LINE 00001205 "    undef;"
NSQ_SOURCE_LINE 00001206 "}"
NSQ_SOURCE_LINE 00001207 ""
NSQ_SOURCE_LINE 00001208 "1;"
NSQ_SOURCE_LINE 00001209 "# ABSTRACT: General completion routine"
NSQ_SOURCE_LINE 00001210 ""
NSQ_SOURCE_LINE 00001211 "__END__"
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 "=pod"
NSQ_SOURCE_LINE 00001214 ""
NSQ_SOURCE_LINE 00001215 "=encoding UTF-8"
NSQ_SOURCE_LINE 00001216 ""
NSQ_SOURCE_LINE 00001217 "=head1 NAME"
NSQ_SOURCE_LINE 00001218 ""
NSQ_SOURCE_LINE 00001219 "Complete::Util - General completion routine"
NSQ_SOURCE_LINE 00001220 ""
NSQ_SOURCE_LINE 00001221 "=head1 VERSION"
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 "This document describes version 0.620 of Complete::Util (from Perl distribution Complete-Util), released on 2024-01-23."
NSQ_SOURCE_LINE 00001224 ""
NSQ_SOURCE_LINE 00001225 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 ""
NSQ_SOURCE_LINE 00001228 "This package provides some generic completion routines that follow the"
NSQ_SOURCE_LINE 00001229 "L<Complete> convention. (If you are looking for bash/shell tab completion"
NSQ_SOURCE_LINE 00001230 "routines, take a look at L</\"SEE ALSO\">.) The main routine is"
NSQ_SOURCE_LINE 00001231 "C<complete_array_elem> which tries to complete a word using choices from elements"
NSQ_SOURCE_LINE 00001232 "of supplied array. For example:"
NSQ_SOURCE_LINE 00001233 ""
NSQ_SOURCE_LINE 00001234 " complete_array_elem(word => \"a\", array => [\"apple\", \"apricot\", \"banana\"]);"
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 "The routine will first try a simple substring prefix matching. If that fails,"
NSQ_SOURCE_LINE 00001237 "will try some other methods like word-mode, character-mode, or fuzzy matching."
NSQ_SOURCE_LINE 00001238 "These methods can be disabled using settings."
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "There are other utility routines e.g. for converting completion answer structure"
NSQ_SOURCE_LINE 00001241 "from hash to array/array to hash, combine or modify answer, etc. These routines"
NSQ_SOURCE_LINE 00001242 "are usually used by the other more specific or higher-level completion modules."
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00001245 ""
NSQ_SOURCE_LINE 00001246 ""
NSQ_SOURCE_LINE 00001247 "=head2 answer_has_entries"
NSQ_SOURCE_LINE 00001248 ""
NSQ_SOURCE_LINE 00001249 "Usage:"
NSQ_SOURCE_LINE 00001250 ""
NSQ_SOURCE_LINE 00001251 " answer_has_entries($answer) -> int"
NSQ_SOURCE_LINE 00001252 ""
NSQ_SOURCE_LINE 00001253 "Check if answer has entries."
NSQ_SOURCE_LINE 00001254 ""
NSQ_SOURCE_LINE 00001255 "It is equivalent to:"
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 " ref $answer eq 'ARRAY' ? (@$answer ? 1:0) : (@{$answer->{words}} ? 1:0);"
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001260 ""
NSQ_SOURCE_LINE 00001261 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001262 ""
NSQ_SOURCE_LINE 00001263 "=over 4"
NSQ_SOURCE_LINE 00001264 ""
NSQ_SOURCE_LINE 00001265 "=item * B<$answer>* => I<array|hash>"
NSQ_SOURCE_LINE 00001266 ""
NSQ_SOURCE_LINE 00001267 "Completion answer structure."
NSQ_SOURCE_LINE 00001268 ""
NSQ_SOURCE_LINE 00001269 ""
NSQ_SOURCE_LINE 00001270 "=back"
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 "Return value:  (int)"
NSQ_SOURCE_LINE 00001273 ""
NSQ_SOURCE_LINE 00001274 ""
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "=head2 answer_num_entries"
NSQ_SOURCE_LINE 00001277 ""
NSQ_SOURCE_LINE 00001278 "Usage:"
NSQ_SOURCE_LINE 00001279 ""
NSQ_SOURCE_LINE 00001280 " answer_num_entries($answer) -> int"
NSQ_SOURCE_LINE 00001281 ""
NSQ_SOURCE_LINE 00001282 "Get the number of entries in an answer."
NSQ_SOURCE_LINE 00001283 ""
NSQ_SOURCE_LINE 00001284 "It is equivalent to:"
NSQ_SOURCE_LINE 00001285 ""
NSQ_SOURCE_LINE 00001286 " ref $answer eq 'ARRAY' ? (@$answer // 0) : (@{$answer->{words}} // 0);"
NSQ_SOURCE_LINE 00001287 ""
NSQ_SOURCE_LINE 00001288 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001289 ""
NSQ_SOURCE_LINE 00001290 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001291 ""
NSQ_SOURCE_LINE 00001292 "=over 4"
NSQ_SOURCE_LINE 00001293 ""
NSQ_SOURCE_LINE 00001294 "=item * B<$answer>* => I<array|hash>"
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 "Completion answer structure."
NSQ_SOURCE_LINE 00001297 ""
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "=back"
NSQ_SOURCE_LINE 00001300 ""
NSQ_SOURCE_LINE 00001301 "Return value:  (int)"
NSQ_SOURCE_LINE 00001302 ""
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 ""
NSQ_SOURCE_LINE 00001305 "=head2 arrayify_answer"
NSQ_SOURCE_LINE 00001306 ""
NSQ_SOURCE_LINE 00001307 "Usage:"
NSQ_SOURCE_LINE 00001308 ""
NSQ_SOURCE_LINE 00001309 " arrayify_answer($answer) -> array"
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 "Make sure we return completion answer in array form."
NSQ_SOURCE_LINE 00001312 ""
NSQ_SOURCE_LINE 00001313 "This is the reverse of C<hashify_answer>. It accepts a hash or an array. If it"
NSQ_SOURCE_LINE 00001314 "receives a hash, will return its C<words> key."
NSQ_SOURCE_LINE 00001315 ""
NSQ_SOURCE_LINE 00001316 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001317 ""
NSQ_SOURCE_LINE 00001318 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001319 ""
NSQ_SOURCE_LINE 00001320 "=over 4"
NSQ_SOURCE_LINE 00001321 ""
NSQ_SOURCE_LINE 00001322 "=item * B<$answer>* => I<array|hash>"
NSQ_SOURCE_LINE 00001323 ""
NSQ_SOURCE_LINE 00001324 "Completion answer structure."
NSQ_SOURCE_LINE 00001325 ""
NSQ_SOURCE_LINE 00001326 ""
NSQ_SOURCE_LINE 00001327 "=back"
NSQ_SOURCE_LINE 00001328 ""
NSQ_SOURCE_LINE 00001329 "Return value:  (array)"
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 ""
NSQ_SOURCE_LINE 00001332 ""
NSQ_SOURCE_LINE 00001333 "=head2 combine_answers"
NSQ_SOURCE_LINE 00001334 ""
NSQ_SOURCE_LINE 00001335 "Usage:"
NSQ_SOURCE_LINE 00001336 ""
NSQ_SOURCE_LINE 00001337 " combine_answers($answers, ...) -> hash"
NSQ_SOURCE_LINE 00001338 ""
NSQ_SOURCE_LINE 00001339 "Given two or more answers, combine them into one."
NSQ_SOURCE_LINE 00001340 ""
NSQ_SOURCE_LINE 00001341 "This function is useful if you want to provide a completion answer that is"
NSQ_SOURCE_LINE 00001342 "gathered from multiple sources. For example, say you are providing completion"
NSQ_SOURCE_LINE 00001343 "for the Perl tool L<cpanm>, which accepts a filename (a tarball like"
NSQ_SOURCE_LINE 00001344 "C<*.tar.gz>), a directory, or a module name. You can do something like this:"
NSQ_SOURCE_LINE 00001345 ""
NSQ_SOURCE_LINE 00001346 " combine_answers("
NSQ_SOURCE_LINE 00001347 "     complete_file(word=>$word),"
NSQ_SOURCE_LINE 00001348 "     complete_module(word=>$word),"
NSQ_SOURCE_LINE 00001349 " );"
NSQ_SOURCE_LINE 00001350 ""
NSQ_SOURCE_LINE 00001351 "But if a completion answer has a metadata C<final> set to true, then that answer"
NSQ_SOURCE_LINE 00001352 "is used as the final answer without any combining with the other answers."
NSQ_SOURCE_LINE 00001353 ""
NSQ_SOURCE_LINE 00001354 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001355 ""
NSQ_SOURCE_LINE 00001356 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 "=over 4"
NSQ_SOURCE_LINE 00001359 ""
NSQ_SOURCE_LINE 00001360 "=item * B<$answers>* => I<array[hash|array]>"
NSQ_SOURCE_LINE 00001361 ""
NSQ_SOURCE_LINE 00001362 "(No description)"
NSQ_SOURCE_LINE 00001363 ""
NSQ_SOURCE_LINE 00001364 ""
NSQ_SOURCE_LINE 00001365 "=back"
NSQ_SOURCE_LINE 00001366 ""
NSQ_SOURCE_LINE 00001367 "Return value:  (hash)"
NSQ_SOURCE_LINE 00001368 ""
NSQ_SOURCE_LINE 00001369 ""
NSQ_SOURCE_LINE 00001370 "Return a combined completion answer. Words from each input answer will be"
NSQ_SOURCE_LINE 00001371 "combined, order preserved and duplicates removed. The other keys from each"
NSQ_SOURCE_LINE 00001372 "answer will be merged."
NSQ_SOURCE_LINE 00001373 ""
NSQ_SOURCE_LINE 00001374 ""
NSQ_SOURCE_LINE 00001375 ""
NSQ_SOURCE_LINE 00001376 "=head2 complete_array_elem"
NSQ_SOURCE_LINE 00001377 ""
NSQ_SOURCE_LINE 00001378 "Usage:"
NSQ_SOURCE_LINE 00001379 ""
NSQ_SOURCE_LINE 00001380 " complete_array_elem(%args) -> array"
NSQ_SOURCE_LINE 00001381 ""
NSQ_SOURCE_LINE 00001382 "Complete from array."
NSQ_SOURCE_LINE 00001383 ""
NSQ_SOURCE_LINE 00001384 "Try to find completion from an array of strings. Will attempt several methods,"
NSQ_SOURCE_LINE 00001385 "from the cheapest and most discriminating to the most expensive and least"
NSQ_SOURCE_LINE 00001386 "discriminating."
NSQ_SOURCE_LINE 00001387 ""
NSQ_SOURCE_LINE 00001388 "First method is normal/exact string prefix matching (either case-sensitive or"
NSQ_SOURCE_LINE 00001389 "insensitive depending on the C<$Complete::Common::OPT_CI> variable or the"
NSQ_SOURCE_LINE 00001390 "C<COMPLETE_OPT_CI> environment variable). If at least one match is found, return"
NSQ_SOURCE_LINE 00001391 "result. Else, proceed to the next method."
NSQ_SOURCE_LINE 00001392 ""
NSQ_SOURCE_LINE 00001393 "Word-mode matching (can be disabled by setting"
NSQ_SOURCE_LINE 00001394 "C<$Complete::Common::OPT_WORD_MODE> or C<COMPLETE_OPT_WORD_MODE> environment"
NSQ_SOURCE_LINE 00001395 "varialbe to false). Word-mode matching is described in L<Complete::Common>. If"
NSQ_SOURCE_LINE 00001396 "at least one match is found, return result. Else, proceed to the next method."
NSQ_SOURCE_LINE 00001397 ""
NSQ_SOURCE_LINE 00001398 "Prefix char-mode matching (can be disabled by settings"
NSQ_SOURCE_LINE 00001399 "C<$Complete::Common::OPT_CHAR_MODE> or C<COMPLETE_OPT_CHAR_MODE> environment"
NSQ_SOURCE_LINE 00001400 "variable to false). Prefix char-mode matching is just like char-mode matching"
NSQ_SOURCE_LINE 00001401 "(see next paragraph) except the first character must match. If at least one"
NSQ_SOURCE_LINE 00001402 "match is found, return result. Else, proceed to the next method."
NSQ_SOURCE_LINE 00001403 ""
NSQ_SOURCE_LINE 00001404 "Char-mode matching (can be disabled by settings"
NSQ_SOURCE_LINE 00001405 "C<$Complete::Common::OPT_CHAR_MODE> or C<COMPLETE_OPT_CHAR_MODE> environment"
NSQ_SOURCE_LINE 00001406 "variable to false). Char-mode matching is described in L<Complete::Common>. If"
NSQ_SOURCE_LINE 00001407 "at least one match is found, return result. Else, proceed to the next method."
NSQ_SOURCE_LINE 00001408 ""
NSQ_SOURCE_LINE 00001409 "Fuzzy matching (can be disabled by setting C<$Complete::Common::OPT_FUZZY> or"
NSQ_SOURCE_LINE 00001410 "C<COMPLETE_OPT_FUZZY> to false). Fuzzy matching is described in"
NSQ_SOURCE_LINE 00001411 "L<Complete::Common>. If at least one match is found, return result. Else,"
NSQ_SOURCE_LINE 00001412 "return empty string."
NSQ_SOURCE_LINE 00001413 ""
NSQ_SOURCE_LINE 00001414 "Will sort the resulting completion list, so you don't have to presort the array."
NSQ_SOURCE_LINE 00001415 ""
NSQ_SOURCE_LINE 00001416 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001417 ""
NSQ_SOURCE_LINE 00001418 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001419 ""
NSQ_SOURCE_LINE 00001420 "=over 4"
NSQ_SOURCE_LINE 00001421 ""
NSQ_SOURCE_LINE 00001422 "=item * B<array>* => I<array[str]>"
NSQ_SOURCE_LINE 00001423 ""
NSQ_SOURCE_LINE 00001424 "(No description)"
NSQ_SOURCE_LINE 00001425 ""
NSQ_SOURCE_LINE 00001426 "=item * B<exclude> => I<array>"
NSQ_SOURCE_LINE 00001427 ""
NSQ_SOURCE_LINE 00001428 "(No description)"
NSQ_SOURCE_LINE 00001429 ""
NSQ_SOURCE_LINE 00001430 "=item * B<replace_map> => I<hash>"
NSQ_SOURCE_LINE 00001431 ""
NSQ_SOURCE_LINE 00001432 "You can supply correction entries in this option. An example is when array if"
NSQ_SOURCE_LINE 00001433 "C<['mount','unmount']> and C<umount> is a popular \"typo\" for C<unmount>. When"
NSQ_SOURCE_LINE 00001434 "someone already types C<um> it cannot be completed into anything (even the"
NSQ_SOURCE_LINE 00001435 "current fuzzy mode will return I<both> so it cannot complete immediately)."
NSQ_SOURCE_LINE 00001436 ""
NSQ_SOURCE_LINE 00001437 "One solution is to add replace_map C<< {'unmount'=E<gt>['umount']} >>. This way, C<umount>"
NSQ_SOURCE_LINE 00001438 "will be regarded the same as C<unmount> and when user types C<um> it can be"
NSQ_SOURCE_LINE 00001439 "completed unambiguously into C<unmount>."
NSQ_SOURCE_LINE 00001440 ""
NSQ_SOURCE_LINE 00001441 "=item * B<summaries> => I<array[str]>"
NSQ_SOURCE_LINE 00001442 ""
NSQ_SOURCE_LINE 00001443 "(No description)"
NSQ_SOURCE_LINE 00001444 ""
NSQ_SOURCE_LINE 00001445 "=item * B<word>* => I<str> (default: \"\")"
NSQ_SOURCE_LINE 00001446 ""
NSQ_SOURCE_LINE 00001447 "Word to complete."
NSQ_SOURCE_LINE 00001448 ""
NSQ_SOURCE_LINE 00001449 ""
NSQ_SOURCE_LINE 00001450 "=back"
NSQ_SOURCE_LINE 00001451 ""
NSQ_SOURCE_LINE 00001452 "Return value:  (array)"
NSQ_SOURCE_LINE 00001453 ""
NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 ""
NSQ_SOURCE_LINE 00001456 "=head2 complete_comma_sep"
NSQ_SOURCE_LINE 00001457 ""
NSQ_SOURCE_LINE 00001458 "Usage:"
NSQ_SOURCE_LINE 00001459 ""
NSQ_SOURCE_LINE 00001460 " complete_comma_sep(%args) -> array"
NSQ_SOURCE_LINE 00001461 ""
NSQ_SOURCE_LINE 00001462 "Complete a comma-separated list string."
NSQ_SOURCE_LINE 00001463 ""
NSQ_SOURCE_LINE 00001464 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001465 ""
NSQ_SOURCE_LINE 00001466 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001467 ""
NSQ_SOURCE_LINE 00001468 "=over 4"
NSQ_SOURCE_LINE 00001469 ""
NSQ_SOURCE_LINE 00001470 "=item * B<elems>* => I<array[str]>"
NSQ_SOURCE_LINE 00001471 ""
NSQ_SOURCE_LINE 00001472 "(No description)"
NSQ_SOURCE_LINE 00001473 ""
NSQ_SOURCE_LINE 00001474 "=item * B<exclude> => I<array>"
NSQ_SOURCE_LINE 00001475 ""
NSQ_SOURCE_LINE 00001476 "(No description)"
NSQ_SOURCE_LINE 00001477 ""
NSQ_SOURCE_LINE 00001478 "=item * B<remaining> => I<code>"
NSQ_SOURCE_LINE 00001479 ""
NSQ_SOURCE_LINE 00001480 "What elements should remain for completion."
NSQ_SOURCE_LINE 00001481 ""
NSQ_SOURCE_LINE 00001482 "This is a more general mechanism if the C<uniq> option does not suffice. Suppose"
NSQ_SOURCE_LINE 00001483 "you are offering completion for sorting fields. The elements are field names as"
NSQ_SOURCE_LINE 00001484 "well as field names prefixed with dash (C<->) to mean sorting with a reverse"
NSQ_SOURCE_LINE 00001485 "order. So for example C<elems> is C<[\"name\",\"-name\",\"age\",\"-age\"]>. When current"
NSQ_SOURCE_LINE 00001486 "word is C<name>, it doesn't make sense to offer C<name> nor C<-name> again as the"
NSQ_SOURCE_LINE 00001487 "next sorting field. So we can set C<remaining> to this code:"
NSQ_SOURCE_LINE 00001488 ""
NSQ_SOURCE_LINE 00001489 " sub {"
NSQ_SOURCE_LINE 00001490 "     my ($seen_elems, $elems) = @_;"
NSQ_SOURCE_LINE 00001491 " "
NSQ_SOURCE_LINE 00001492 "     my %seen;"
NSQ_SOURCE_LINE 00001493 "     for (@$seen_elems) {"
NSQ_SOURCE_LINE 00001494 "         (my $nodash = $_) =~ s/^-//;"
NSQ_SOURCE_LINE 00001495 "         $seen{$nodash}++;"
NSQ_SOURCE_LINE 00001496 "     }"
NSQ_SOURCE_LINE 00001497 " "
NSQ_SOURCE_LINE 00001498 "     my @remaining;"
NSQ_SOURCE_LINE 00001499 "     for (@$elems) {"
NSQ_SOURCE_LINE 00001500 "         (my $nodash = $_) =~ s/^-//;"
NSQ_SOURCE_LINE 00001501 "         push @remaining, $_ unless $seen{$nodash};"
NSQ_SOURCE_LINE 00001502 "     }"
NSQ_SOURCE_LINE 00001503 " "
NSQ_SOURCE_LINE 00001504 "     \\@remaining;"
NSQ_SOURCE_LINE 00001505 " }"
NSQ_SOURCE_LINE 00001506 ""
NSQ_SOURCE_LINE 00001507 "As you can see above, the code is given C<$seen_elems> and C<$elems> as arguments"
NSQ_SOURCE_LINE 00001508 "and is expected to return remaining elements to offer."
NSQ_SOURCE_LINE 00001509 ""
NSQ_SOURCE_LINE 00001510 "=item * B<replace_map> => I<hash>"
NSQ_SOURCE_LINE 00001511 ""
NSQ_SOURCE_LINE 00001512 "You can supply correction entries in this option. An example is when array if"
NSQ_SOURCE_LINE 00001513 "C<['mount','unmount']> and C<umount> is a popular \"typo\" for C<unmount>. When"
NSQ_SOURCE_LINE 00001514 "someone already types C<um> it cannot be completed into anything (even the"
NSQ_SOURCE_LINE 00001515 "current fuzzy mode will return I<both> so it cannot complete immediately)."
NSQ_SOURCE_LINE 00001516 ""
NSQ_SOURCE_LINE 00001517 "One solution is to add replace_map C<< {'unmount'=E<gt>['umount']} >>. This way, C<umount>"
NSQ_SOURCE_LINE 00001518 "will be regarded the same as C<unmount> and when user types C<um> it can be"
NSQ_SOURCE_LINE 00001519 "completed unambiguously into C<unmount>."
NSQ_SOURCE_LINE 00001520 ""
NSQ_SOURCE_LINE 00001521 "=item * B<sep> => I<str> (default: \",\")"
NSQ_SOURCE_LINE 00001522 ""
NSQ_SOURCE_LINE 00001523 "(No description)"
NSQ_SOURCE_LINE 00001524 ""
NSQ_SOURCE_LINE 00001525 "=item * B<summaries> => I<array[str]>"
NSQ_SOURCE_LINE 00001526 ""
NSQ_SOURCE_LINE 00001527 "(No description)"
NSQ_SOURCE_LINE 00001528 ""
NSQ_SOURCE_LINE 00001529 "=item * B<uniq> => I<bool>"
NSQ_SOURCE_LINE 00001530 ""
NSQ_SOURCE_LINE 00001531 "Whether list should contain unique elements."
NSQ_SOURCE_LINE 00001532 ""
NSQ_SOURCE_LINE 00001533 "When this option is set to true, if the formed list in the current word already"
NSQ_SOURCE_LINE 00001534 "contains an element, the element will not be offered again as completion answer."
NSQ_SOURCE_LINE 00001535 "For example, if C<elems> is C<[1,2,3,4]> and C<word> is C<2,3,> then without C<uniq>"
NSQ_SOURCE_LINE 00001536 "set to true the completion answer is:"
NSQ_SOURCE_LINE 00001537 ""
NSQ_SOURCE_LINE 00001538 " 2,3,1"
NSQ_SOURCE_LINE 00001539 " 2,3,2"
NSQ_SOURCE_LINE 00001540 " 2,3,3"
NSQ_SOURCE_LINE 00001541 " 2,3,4"
NSQ_SOURCE_LINE 00001542 ""
NSQ_SOURCE_LINE 00001543 "but with C<uniq> set to true, the completion answer becomes:"
NSQ_SOURCE_LINE 00001544 ""
NSQ_SOURCE_LINE 00001545 " 2,3,1"
NSQ_SOURCE_LINE 00001546 " 2,3,4"
NSQ_SOURCE_LINE 00001547 ""
NSQ_SOURCE_LINE 00001548 "See also the C<remaining> option for a more general mechanism of offering fewer"
NSQ_SOURCE_LINE 00001549 "elements."
NSQ_SOURCE_LINE 00001550 ""
NSQ_SOURCE_LINE 00001551 "=item * B<word>* => I<str> (default: \"\")"
NSQ_SOURCE_LINE 00001552 ""
NSQ_SOURCE_LINE 00001553 "Word to complete."
NSQ_SOURCE_LINE 00001554 ""
NSQ_SOURCE_LINE 00001555 ""
NSQ_SOURCE_LINE 00001556 "=back"
NSQ_SOURCE_LINE 00001557 ""
NSQ_SOURCE_LINE 00001558 "Return value:  (array)"
NSQ_SOURCE_LINE 00001559 ""
NSQ_SOURCE_LINE 00001560 ""
NSQ_SOURCE_LINE 00001561 ""
NSQ_SOURCE_LINE 00001562 "=head2 complete_comma_sep_pair"
NSQ_SOURCE_LINE 00001563 ""
NSQ_SOURCE_LINE 00001564 "Usage:"
NSQ_SOURCE_LINE 00001565 ""
NSQ_SOURCE_LINE 00001566 " complete_comma_sep_pair(%args) -> array"
NSQ_SOURCE_LINE 00001567 ""
NSQ_SOURCE_LINE 00001568 "Complete a comma-separated list of key-value pairs."
NSQ_SOURCE_LINE 00001569 ""
NSQ_SOURCE_LINE 00001570 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001571 ""
NSQ_SOURCE_LINE 00001572 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001573 ""
NSQ_SOURCE_LINE 00001574 "=over 4"
NSQ_SOURCE_LINE 00001575 ""
NSQ_SOURCE_LINE 00001576 "=item * B<complete_value> => I<code>"
NSQ_SOURCE_LINE 00001577 ""
NSQ_SOURCE_LINE 00001578 "Code to supply possible values for a key."
NSQ_SOURCE_LINE 00001579 ""
NSQ_SOURCE_LINE 00001580 "Code should accept hash arguments and will be given the arguments C<word> (word"
NSQ_SOURCE_LINE 00001581 "that is part of the value), and C<key> (the key being evaluated) and is expected"
NSQ_SOURCE_LINE 00001582 "to return a completion answer."
NSQ_SOURCE_LINE 00001583 ""
NSQ_SOURCE_LINE 00001584 "=item * B<keys>* => I<array[str]>"
NSQ_SOURCE_LINE 00001585 ""
NSQ_SOURCE_LINE 00001586 "(No description)"
NSQ_SOURCE_LINE 00001587 ""
NSQ_SOURCE_LINE 00001588 "=item * B<keys_summaries> => I<array[str]>"
NSQ_SOURCE_LINE 00001589 ""
NSQ_SOURCE_LINE 00001590 "Summary for each key."
NSQ_SOURCE_LINE 00001591 ""
NSQ_SOURCE_LINE 00001592 "=item * B<remaining_keys> => I<code>"
NSQ_SOURCE_LINE 00001593 ""
NSQ_SOURCE_LINE 00001594 "What keys should remain for completion."
NSQ_SOURCE_LINE 00001595 ""
NSQ_SOURCE_LINE 00001596 "This is a more general mechanism if the C<uniq> option does not suffice. Suppose"
NSQ_SOURCE_LINE 00001597 "you are offering completion for arguments. Possible arguments are C<foo>, C<bar>,"
NSQ_SOURCE_LINE 00001598 "C<baz> but the C<bar> and C<baz> arguments are mutually exclusive. We can set"
NSQ_SOURCE_LINE 00001599 "C<remaining_keys> to this code:"
NSQ_SOURCE_LINE 00001600 ""
NSQ_SOURCE_LINE 00001601 " my %possible_args = {foo=>1, bar=>1, baz=>1};"
NSQ_SOURCE_LINE 00001602 " sub {"
NSQ_SOURCE_LINE 00001603 "     my ($seen_elems, $elems) = @_;"
NSQ_SOURCE_LINE 00001604 " "
NSQ_SOURCE_LINE 00001605 "     my %remaining = %possible_args;"
NSQ_SOURCE_LINE 00001606 "     for (@$seen_elems) {"
NSQ_SOURCE_LINE 00001607 "         delete $remaining{$_};"
NSQ_SOURCE_LINE 00001608 "         delete $remaining{baz} if $_ eq 'bar';"
NSQ_SOURCE_LINE 00001609 "         delete $remaining{bar} if $_ eq 'baz';"
NSQ_SOURCE_LINE 00001610 "     }"
NSQ_SOURCE_LINE 00001611 " "
NSQ_SOURCE_LINE 00001612 "     [keys %remaining];"
NSQ_SOURCE_LINE 00001613 " }"
NSQ_SOURCE_LINE 00001614 ""
NSQ_SOURCE_LINE 00001615 "As you can see above, the code is given C<$seen_elems> and C<$elems> as arguments"
NSQ_SOURCE_LINE 00001616 "and is expected to return remaining elements to offer."
NSQ_SOURCE_LINE 00001617 ""
NSQ_SOURCE_LINE 00001618 "=item * B<uniq> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00001619 ""
NSQ_SOURCE_LINE 00001620 "If set to true, then do not offer key that has been mentioned before in the word."
NSQ_SOURCE_LINE 00001621 ""
NSQ_SOURCE_LINE 00001622 "=item * B<word>* => I<str> (default: \"\")"
NSQ_SOURCE_LINE 00001623 ""
NSQ_SOURCE_LINE 00001624 "Word to complete."
NSQ_SOURCE_LINE 00001625 ""
NSQ_SOURCE_LINE 00001626 ""
NSQ_SOURCE_LINE 00001627 "=back"
NSQ_SOURCE_LINE 00001628 ""
NSQ_SOURCE_LINE 00001629 "Return value:  (array)"
NSQ_SOURCE_LINE 00001630 ""
NSQ_SOURCE_LINE 00001631 ""
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "=head2 complete_hash_key"
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "Usage:"
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 " complete_hash_key(%args) -> array"
