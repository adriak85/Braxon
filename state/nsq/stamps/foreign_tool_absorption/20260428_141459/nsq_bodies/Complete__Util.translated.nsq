NSQ_SOURCE_LINE 00001835 ""
NSQ_SOURCE_LINE 00001836 ""
NSQ_SOURCE_LINE 00001837 "=head2 ununiquify_answer"
NSQ_SOURCE_LINE 00001838 ""
NSQ_SOURCE_LINE 00001839 "Usage:"
NSQ_SOURCE_LINE 00001840 ""
NSQ_SOURCE_LINE 00001841 " ununiquify_answer(%args) -> undef"
NSQ_SOURCE_LINE 00001842 ""
NSQ_SOURCE_LINE 00001843 "If answer contains only one item, make it two."
NSQ_SOURCE_LINE 00001844 ""
NSQ_SOURCE_LINE 00001845 "For example, if answer is C<[\"a\"]>, then will make answer become C<[\"a\",\"a \"]>."
NSQ_SOURCE_LINE 00001846 "This will prevent shell from automatically adding space."
NSQ_SOURCE_LINE 00001847 ""
NSQ_SOURCE_LINE 00001848 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001849 ""
NSQ_SOURCE_LINE 00001850 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001851 ""
NSQ_SOURCE_LINE 00001852 "=over 4"
NSQ_SOURCE_LINE 00001853 ""
NSQ_SOURCE_LINE 00001854 "=item * B<answer>* => I<hash|array>"
NSQ_SOURCE_LINE 00001855 ""
NSQ_SOURCE_LINE 00001856 "(No description)"
NSQ_SOURCE_LINE 00001857 ""
NSQ_SOURCE_LINE 00001858 ""
NSQ_SOURCE_LINE 00001859 "=back"
NSQ_SOURCE_LINE 00001860 ""
NSQ_SOURCE_LINE 00001861 "Return value:  (undef)"
NSQ_SOURCE_LINE 00001862 ""
NSQ_SOURCE_LINE 00001863 "=for Pod::Coverage ^(ununiquify_answer)$"
NSQ_SOURCE_LINE 00001864 ""
NSQ_SOURCE_LINE 00001865 "=head1 FAQ"
NSQ_SOURCE_LINE 00001866 ""
NSQ_SOURCE_LINE 00001867 "=head2 Why is fuzzy matching slow?"
NSQ_SOURCE_LINE 00001868 ""
NSQ_SOURCE_LINE 00001869 "Example:"
NSQ_SOURCE_LINE 00001870 ""
NSQ_SOURCE_LINE 00001871 " use Benchmark qw(timethis);"
NSQ_SOURCE_LINE 00001872 " use Complete::Util qw(complete_array_elem);"
NSQ_SOURCE_LINE 00001873 ""
NSQ_SOURCE_LINE 00001874 " # turn off the other non-exact matching methods"
NSQ_SOURCE_LINE 00001875 " $Complete::Common::OPT_CI = 0;"
NSQ_SOURCE_LINE 00001876 " $Complete::Common::OPT_WORD_MODE = 0;"
NSQ_SOURCE_LINE 00001877 " $Complete::Common::OPT_CHAR_MODE = 0;"
NSQ_SOURCE_LINE 00001878 ""
NSQ_SOURCE_LINE 00001879 " my @ary = (\"aaa\"..\"zzy\"); # 17575 elems"
NSQ_SOURCE_LINE 00001880 " timethis(20, sub { complete_array_elem(array=>\\@ary, word=>\"zzz\") });"
NSQ_SOURCE_LINE 00001881 ""
NSQ_SOURCE_LINE 00001882 "results in:"
NSQ_SOURCE_LINE 00001883 ""
NSQ_SOURCE_LINE 00001884 " timethis 20:  7 wallclock secs ( 6.82 usr +  0.00 sys =  6.82 CPU) @  2.93/s (n=20)"
NSQ_SOURCE_LINE 00001885 ""
NSQ_SOURCE_LINE 00001886 "Answer: fuzzy matching is slower than exact matching due to having to calculate"
NSQ_SOURCE_LINE 00001887 "Levenshtein distance. But if you find fuzzy matching too slow using the default"
NSQ_SOURCE_LINE 00001888 "pure-perl implementation, you might want to install"
NSQ_SOURCE_LINE 00001889 "L<Text::Levenshtein::Flexible> (an optional prereq) to speed up fuzzy matching."
NSQ_SOURCE_LINE 00001890 "After Text::Levenshtein::Flexible is installed:"
NSQ_SOURCE_LINE 00001891 ""
NSQ_SOURCE_LINE 00001892 " timethis 20:  1 wallclock secs ( 1.04 usr +  0.00 sys =  1.04 CPU) @ 19.23/s (n=20)"
NSQ_SOURCE_LINE 00001893 ""
NSQ_SOURCE_LINE 00001894 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00001895 ""
NSQ_SOURCE_LINE 00001896 "=head2 COMPLETE_UTIL_TRACE"
NSQ_SOURCE_LINE 00001897 ""
NSQ_SOURCE_LINE 00001898 "Bool. If set to true, will generate more log statements for debugging (at the"
NSQ_SOURCE_LINE 00001899 "trace level)."
NSQ_SOURCE_LINE 00001900 ""
NSQ_SOURCE_LINE 00001901 "=head2 COMPLETE_UTIL_LEVENSHTEIN => str ('pp'|'xs'|'flexible')"
NSQ_SOURCE_LINE 00001902 ""
NSQ_SOURCE_LINE 00001903 "Can be used to force which Levenshtein distance implementation to use. C<pp>"
NSQ_SOURCE_LINE 00001904 "means the included PP implementation, which is the slowest (1-2 orders of"
NSQ_SOURCE_LINE 00001905 "magnitude slower than XS implementations), C<xs> which means"
NSQ_SOURCE_LINE 00001906 "L<Text::Levenshtein::XS>, or C<flexible> which means"
NSQ_SOURCE_LINE 00001907 "L<Text::Levenshtein::Flexible> (performs best)."
NSQ_SOURCE_LINE 00001908 ""
NSQ_SOURCE_LINE 00001909 "If this is not set, the default is to use Text::Levenshtein::Flexible when it's"
NSQ_SOURCE_LINE 00001910 "available, then fallback to the included PP implementation."
NSQ_SOURCE_LINE 00001911 ""
