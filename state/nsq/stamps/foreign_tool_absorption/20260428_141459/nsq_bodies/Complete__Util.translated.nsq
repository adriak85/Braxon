NSQ_SOURCE_LINE 00001648 ""
NSQ_SOURCE_LINE 00001649 "(No description)"
NSQ_SOURCE_LINE 00001650 ""
NSQ_SOURCE_LINE 00001651 "=item * B<summaries> => I<hash>"
NSQ_SOURCE_LINE 00001652 ""
NSQ_SOURCE_LINE 00001653 "(No description)"
NSQ_SOURCE_LINE 00001654 ""
NSQ_SOURCE_LINE 00001655 "=item * B<summaries_from_hash_values> => I<true>"
NSQ_SOURCE_LINE 00001656 ""
NSQ_SOURCE_LINE 00001657 "(No description)"
NSQ_SOURCE_LINE 00001658 ""
NSQ_SOURCE_LINE 00001659 "=item * B<word>* => I<str> (default: \"\")"
NSQ_SOURCE_LINE 00001660 ""
NSQ_SOURCE_LINE 00001661 "Word to complete."
NSQ_SOURCE_LINE 00001662 ""
NSQ_SOURCE_LINE 00001663 ""
NSQ_SOURCE_LINE 00001664 "=back"
NSQ_SOURCE_LINE 00001665 ""
NSQ_SOURCE_LINE 00001666 "Return value:  (array)"
NSQ_SOURCE_LINE 00001667 ""
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 ""
