BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Module::CPANfile;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use Cwd;"
NSQ_SOURCE_LINE 00000005 "use Carp ();"
NSQ_SOURCE_LINE 00000006 "use Module::CPANfile::Environment;"
NSQ_SOURCE_LINE 00000007 "use Module::CPANfile::Requirement;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $VERSION = '1.1004';"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "BEGIN {"
NSQ_SOURCE_LINE 00000012 "    if (${^TAINT}) {"
NSQ_SOURCE_LINE 00000013 "        *untaint = sub {"
NSQ_SOURCE_LINE 00000014 "            my $str = shift;"
NSQ_SOURCE_LINE 00000015 "            ($str) = $str =~ /^(.+)$/s;"
NSQ_SOURCE_LINE 00000016 "            $str;"
NSQ_SOURCE_LINE 00000017 "        };"
NSQ_SOURCE_LINE 00000018 "    } else {"
NSQ_SOURCE_LINE 00000019 "        *untaint = sub { $_[0] };"
NSQ_SOURCE_LINE 00000020 "    }"
NSQ_SOURCE_LINE 00000021 "}"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub new {"
NSQ_SOURCE_LINE 00000024 "    my($class, $file) = @_;"
NSQ_SOURCE_LINE 00000025 "    bless {}, $class;"
NSQ_SOURCE_LINE 00000026 "}"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "sub load {"
NSQ_SOURCE_LINE 00000029 "    my($proto, $file) = @_;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    my $self = ref $proto ? $proto : $proto->new;"
NSQ_SOURCE_LINE 00000032 "    $self->parse($file || _default_cpanfile());"
NSQ_SOURCE_LINE 00000033 "    $self;"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub save {"
NSQ_SOURCE_LINE 00000037 "    my($self, $path) = @_;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    open my $out, \">\", $path or die \"$path: $!\";"
NSQ_SOURCE_LINE 00000040 "    print {$out} $self->to_string;"
NSQ_SOURCE_LINE 00000041 "}"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "sub parse {"
NSQ_SOURCE_LINE 00000044 "    my($self, $file) = @_;"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    my $code = do {"
NSQ_SOURCE_LINE 00000047 "        open my $fh, \"<\", $file or die \"$file: $!\";"
NSQ_SOURCE_LINE 00000048 "        join '', <$fh>;"
NSQ_SOURCE_LINE 00000049 "    };"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    $code = untaint $code;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    my $env = Module::CPANfile::Environment->new($file);"
NSQ_SOURCE_LINE 00000054 "    $env->parse($code) or die $@;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    $self->{_mirrors} = $env->mirrors;"
NSQ_SOURCE_LINE 00000057 "    $self->{_prereqs} = $env->prereqs;"
NSQ_SOURCE_LINE 00000058 "}"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub from_prereqs {"
NSQ_SOURCE_LINE 00000061 "    my($proto, $prereqs) = @_;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    my $self = $proto->new;"
NSQ_SOURCE_LINE 00000064 "    $self->{_prereqs} = Module::CPANfile::Prereqs->from_cpan_meta($prereqs);"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    $self;"
NSQ_SOURCE_LINE 00000067 "}"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "sub mirrors {"
NSQ_SOURCE_LINE 00000070 "    my $self = shift;"
NSQ_SOURCE_LINE 00000071 "    $self->{_mirrors} || [];"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub features {"
NSQ_SOURCE_LINE 00000075 "    my $self = shift;"
NSQ_SOURCE_LINE 00000076 "    map $self->feature($_), $self->{_prereqs}->identifiers;"
NSQ_SOURCE_LINE 00000077 "}"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "sub feature {"
NSQ_SOURCE_LINE 00000080 "    my($self, $identifier) = @_;"
NSQ_SOURCE_LINE 00000081 "    $self->{_prereqs}->feature($identifier);"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "sub prereq { shift->prereqs }"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub prereqs {"
NSQ_SOURCE_LINE 00000087 "    my $self = shift;"
NSQ_SOURCE_LINE 00000088 "    $self->{_prereqs}->as_cpan_meta;"
NSQ_SOURCE_LINE 00000089 "}"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "sub merged_requirements {"
NSQ_SOURCE_LINE 00000092 "    my $self = shift;"
NSQ_SOURCE_LINE 00000093 "    $self->{_prereqs}->merged_requirements;"
NSQ_SOURCE_LINE 00000094 "}"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "sub effective_prereqs {"
NSQ_SOURCE_LINE 00000097 "    my($self, $features) = @_;"
NSQ_SOURCE_LINE 00000098 "    $self->prereqs_with(@{$features || []});"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "sub prereqs_with {"
NSQ_SOURCE_LINE 00000102 "    my($self, @feature_identifiers) = @_;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    my @others = map { $self->feature($_)->prereqs } @feature_identifiers;"
NSQ_SOURCE_LINE 00000105 "    $self->prereqs->with_merged_prereqs(\\@others);"
NSQ_SOURCE_LINE 00000106 "}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "sub prereq_specs {"
NSQ_SOURCE_LINE 00000109 "    my $self = shift;"
NSQ_SOURCE_LINE 00000110 "    $self->prereqs->as_string_hash;"
NSQ_SOURCE_LINE 00000111 "}"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "sub prereq_for_module {"
NSQ_SOURCE_LINE 00000114 "    my($self, $module) = @_;"
NSQ_SOURCE_LINE 00000115 "    $self->{_prereqs}->find($module);"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "sub options_for_module {"
NSQ_SOURCE_LINE 00000119 "    my($self, $module) = @_;"
NSQ_SOURCE_LINE 00000120 "    my $prereq = $self->prereq_for_module($module) or return;"
NSQ_SOURCE_LINE 00000121 "    $prereq->requirement->options;"
NSQ_SOURCE_LINE 00000122 "}"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "sub merge_meta {"
NSQ_SOURCE_LINE 00000125 "    my($self, $file, $version) = @_;"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "    require CPAN::Meta;"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "    $version ||= $file =~ /\\.yml$/ ? '1.4' : '2';"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    my $prereq = $self->prereqs;"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    my $meta = CPAN::Meta->load_file($file);"
NSQ_SOURCE_LINE 00000134 "    my $prereqs_hash = $prereq->with_merged_prereqs($meta->effective_prereqs)->as_string_hash;"
NSQ_SOURCE_LINE 00000135 "    my $struct = { %{$meta->as_struct}, prereqs => $prereqs_hash };"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    CPAN::Meta->new($struct)->save($file, { version => $version });"
NSQ_SOURCE_LINE 00000138 "}"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "sub _d($) {"
NSQ_SOURCE_LINE 00000141 "    require Data::Dumper;"
NSQ_SOURCE_LINE 00000142 "    chomp(my $value = Data::Dumper->new([$_[0]])->Terse(1)->Dump);"
NSQ_SOURCE_LINE 00000143 "    $value;"
NSQ_SOURCE_LINE 00000144 "}"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "sub _default_cpanfile {"
NSQ_SOURCE_LINE 00000147 "    my $file = Cwd::abs_path('cpanfile');"
NSQ_SOURCE_LINE 00000148 "    untaint $file;"
NSQ_SOURCE_LINE 00000149 "}"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "sub to_string {"
NSQ_SOURCE_LINE 00000152 "    my($self, $include_empty) = @_;"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    my $mirrors = $self->mirrors;"
NSQ_SOURCE_LINE 00000155 "    my $prereqs = $self->prereq_specs;"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    my $code = '';"
NSQ_SOURCE_LINE 00000158 "    $code .= $self->_dump_mirrors($mirrors);"
NSQ_SOURCE_LINE 00000159 "    $code .= $self->_dump_prereqs($prereqs, $include_empty);"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    for my $feature ($self->features) {"
NSQ_SOURCE_LINE 00000162 "        $code .= \"feature @{[ _d $feature->{identifier} ]}, @{[ _d $feature->{description} ]} => sub {\\n\";"
NSQ_SOURCE_LINE 00000163 "        $code .= $self->_dump_prereqs($feature->{prereqs}->as_string_hash, $include_empty, 4);"
NSQ_SOURCE_LINE 00000164 "        $code .= \"};\\n\\n\";"
NSQ_SOURCE_LINE 00000165 "    }"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    $code =~ s/\\n+$/\\n/s;"
NSQ_SOURCE_LINE 00000168 "    $code;"
NSQ_SOURCE_LINE 00000169 "}"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "sub _dump_mirrors {"
NSQ_SOURCE_LINE 00000172 "    my($self, $mirrors) = @_;"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "    my $code = \"\";"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    for my $url (@$mirrors) {"
NSQ_SOURCE_LINE 00000177 "        $code .= \"mirror @{[ _d $url ]};\\n\";"
NSQ_SOURCE_LINE 00000178 "    }"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    $code =~ s/\\n+$/\\n/s;"
NSQ_SOURCE_LINE 00000181 "    $code;"
NSQ_SOURCE_LINE 00000182 "}"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "sub _dump_prereqs {"
NSQ_SOURCE_LINE 00000185 "    my($self, $prereqs, $include_empty, $base_indent) = @_;"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "    my $code = '';"
NSQ_SOURCE_LINE 00000188 "    for my $phase (qw(runtime configure build test develop)) {"
NSQ_SOURCE_LINE 00000189 "        my $indent = $phase eq 'runtime' ? '' : '    ';"
NSQ_SOURCE_LINE 00000190 "        $indent .= (' ' x ($base_indent || 0));"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "        my($phase_code, $requirements);"
NSQ_SOURCE_LINE 00000193 "        $phase_code .= \"on $phase => sub {\\n\" unless $phase eq 'runtime';"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "        for my $type (qw(requires recommends suggests conflicts)) {"
NSQ_SOURCE_LINE 00000196 "            for my $mod (sort keys %{$prereqs->{$phase}{$type}}) {"
NSQ_SOURCE_LINE 00000197 "                my $ver = $prereqs->{$phase}{$type}{$mod};"
NSQ_SOURCE_LINE 00000198 "                $phase_code .= $ver eq '0'"
NSQ_SOURCE_LINE 00000199 "                             ? \"${indent}$type @{[ _d $mod ]}\""
NSQ_SOURCE_LINE 00000200 "                             : \"${indent}$type @{[ _d $mod ]}, @{[ _d $ver ]}\";"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "                my $options = $self->options_for_module($mod) || {};"
NSQ_SOURCE_LINE 00000203 "                if (%$options) {"
NSQ_SOURCE_LINE 00000204 "                    my @opts;"
NSQ_SOURCE_LINE 00000205 "                    for my $key (keys %$options) {"
NSQ_SOURCE_LINE 00000206 "                        my $k = $key =~ /^[a-zA-Z0-9_]+$/ ? $key : _d $key;"
NSQ_SOURCE_LINE 00000207 "                        push @opts, \"$k => @{[ _d $options->{$k} ]}\";"
NSQ_SOURCE_LINE 00000208 "                    }"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "                    $phase_code .= \",\\n\" . join(\",\\n\", map \"  $indent$_\", @opts);"
NSQ_SOURCE_LINE 00000211 "                }"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "                $phase_code .= \";\\n\";"
NSQ_SOURCE_LINE 00000214 "                $requirements++;"
NSQ_SOURCE_LINE 00000215 "            }"
NSQ_SOURCE_LINE 00000216 "        }"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "        $phase_code .= \"\\n\" unless $requirements;"
NSQ_SOURCE_LINE 00000219 "        $phase_code .= \"};\\n\" unless $phase eq 'runtime';"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "        $code .= $phase_code . \"\\n\" if $requirements or $include_empty;"
NSQ_SOURCE_LINE 00000222 "    }"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "    $code =~ s/\\n+$/\\n/s;"
NSQ_SOURCE_LINE 00000225 "    $code;"
NSQ_SOURCE_LINE 00000226 "}"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "1;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "__END__"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=head1 NAME"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "Module::CPANfile - Parse cpanfile"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "  use Module::CPANfile;"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "  my $file = Module::CPANfile->load(\"cpanfile\");"
NSQ_SOURCE_LINE 00000241 "  my $prereqs = $file->prereqs; # CPAN::Meta::Prereqs object"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "  my @features = $file->features; # CPAN::Meta::Feature objects"
NSQ_SOURCE_LINE 00000244 "  my $merged_prereqs = $file->prereqs_with(@identifiers); # CPAN::Meta::Prereqs"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "  $file->merge_meta('MYMETA.json');"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "Module::CPANfile is a tool to handle L<cpanfile> format to load application"
NSQ_SOURCE_LINE 00000251 "specific dependencies, not just for CPAN distributions."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=head1 METHODS"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=over 4"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=item load"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "  $file = Module::CPANfile->load;"
NSQ_SOURCE_LINE 00000260 "  $file = Module::CPANfile->load('cpanfile');"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "Load and parse a cpanfile. By default it tries to load C<cpanfile> in"
NSQ_SOURCE_LINE 00000263 "the current directory, unless you pass the path to its argument."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=item from_prereqs"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "  $file = Module::CPANfile->from_prereqs({"
NSQ_SOURCE_LINE 00000268 "    runtime => { requires => { DBI => '1.000' } },"
NSQ_SOURCE_LINE 00000269 "  });"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Creates a new Module::CPANfile object from prereqs hash you can get"
NSQ_SOURCE_LINE 00000272 "via L<CPAN::Meta>'s C<prereqs>, or L<CPAN::Meta::Prereqs>'"
NSQ_SOURCE_LINE 00000273 "C<as_string_hash>."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "  # read MYMETA, then feed the prereqs to create Module::CPANfile"
NSQ_SOURCE_LINE 00000276 "  my $meta = CPAN::Meta->load_file('MYMETA.json');"
NSQ_SOURCE_LINE 00000277 "  my $file = Module::CPANfile->from_prereqs($meta->prereqs);"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "  # load cpanfile, then recreate it with round-trip"
NSQ_SOURCE_LINE 00000280 "  my $file = Module::CPANfile->load('cpanfile');"
NSQ_SOURCE_LINE 00000281 "  $file = Module::CPANfile->from_prereqs($file->prereq_specs);"
NSQ_SOURCE_LINE 00000282 "                                    # or $file->prereqs->as_string_hash"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=item prereqs"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "Returns L<CPAN::Meta::Prereqs> object out of the parsed cpanfile."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=item prereq_specs"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "Returns a hash reference that should be passed to C<< CPAN::Meta::Prereqs->new >>."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=item features"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "Returns a list of features available in the cpanfile as L<CPAN::Meta::Feature>."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=item prereqs_with(@identifiers), effective_prereqs(\\@identifiers)"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "Returns L<CPAN::Meta::Prereqs> object, with merged prereqs for"
NSQ_SOURCE_LINE 00000299 "features identified with the C<@identifiers>."
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=item to_string($include_empty)"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "  $file->to_string;"
NSQ_SOURCE_LINE 00000304 "  $file->to_string(1);"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "Returns a canonical string (code) representation for cpanfile. Useful"
NSQ_SOURCE_LINE 00000307 "if you want to convert L<CPAN::Meta::Prereqs> to a new cpanfile."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "  # read MYMETA's prereqs and print cpanfile representation of it"
NSQ_SOURCE_LINE 00000310 "  my $meta = CPAN::Meta->load_file('MYMETA.json');"
NSQ_SOURCE_LINE 00000311 "  my $file = Module::CPANfile->from_prereqs($meta->prereqs);"
NSQ_SOURCE_LINE 00000312 "  print $file->to_string;"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "By default, it omits the phase where there're no modules"
NSQ_SOURCE_LINE 00000315 "registered. If you pass the argument of a true value, it will print"
NSQ_SOURCE_LINE 00000316 "them as well."
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=item save"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "  $file->save('cpanfile');"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "Saves the currently loaded prereqs as a new C<cpanfile> by calling"
NSQ_SOURCE_LINE 00000323 "C<to_string>. Beware B<this method will overwrite the existing"
NSQ_SOURCE_LINE 00000324 "cpanfile without any warning or backup>. Taking a backup or giving"
NSQ_SOURCE_LINE 00000325 "warnings to users is a caller's responsibility."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "  # Read MYMETA.json and creates a new cpanfile"
NSQ_SOURCE_LINE 00000328 "  my $meta = CPAN::Meta->load_file('MYMETA.json');"
NSQ_SOURCE_LINE 00000329 "  my $file = Module::CPANfile->from_prereqs($meta->prereqs);"
NSQ_SOURCE_LINE 00000330 "  $file->save('cpanfile');"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=item merge_meta"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "  $file->merge_meta('META.yml');"
NSQ_SOURCE_LINE 00000335 "  $file->merge_meta('MYMETA.json', '2.0');"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "Merge the effective prereqs with Meta specification loaded from the"
NSQ_SOURCE_LINE 00000338 "given META file, using CPAN::Meta. You can specify the META spec"
NSQ_SOURCE_LINE 00000339 "version in the second argument, which defaults to 1.4 in case the"
NSQ_SOURCE_LINE 00000340 "given file is YAML, and 2 if it is JSON."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=item options_for_module"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "  my $options = $file->options_for_module($module);"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "Returns the extra options specified for a given module as a hash"
NSQ_SOURCE_LINE 00000347 "reference. Returns C<undef> when the given module is not specified in"
NSQ_SOURCE_LINE 00000348 "the C<cpanfile>."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "For example,"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "  # cpanfile"
NSQ_SOURCE_LINE 00000353 "  requires 'Plack', '1.000',"
NSQ_SOURCE_LINE 00000354 "    dist => \"MIYAGAWA/Plack-1.000.tar.gz\";"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "  # ..."
NSQ_SOURCE_LINE 00000357 "  my $file = Module::CPANfile->load;"
NSQ_SOURCE_LINE 00000358 "  my $options = $file->options_for_module('Plack');"
NSQ_SOURCE_LINE 00000359 "  # => { dist => \"MIYAGAWA/Plack-1.000.tar.gz\" }"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=back"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "Tatsuhiko Miyagawa"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "L<cpanfile>, L<CPAN::Meta>, L<CPAN::Meta::Spec>"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=cut"
BODY_END
