NSQ_SOURCE_LINE 00000012 "BEGIN {"
NSQ_SOURCE_LINE 00000013 "    unless (exists &Time::Moment::now) {"
NSQ_SOURCE_LINE 00000014 "        require Time::HiRes;"
NSQ_SOURCE_LINE 00000015 "        eval sprintf <<'EOC', __FILE__;"
NSQ_SOURCE_LINE 00000016 "# line 17 %s"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "# expects normalized tm values; algorithm is only valid for tm year's [1, 199]"
NSQ_SOURCE_LINE 00000019 "sub timegm {"
NSQ_SOURCE_LINE 00000020 "    my ($y, $d, $h, $m, $s) = @_[5,7,2,1,0];"
NSQ_SOURCE_LINE 00000021 "    return ((1461 * --$y >> 2) + $d - 25202) * 86400 + $h * 3600 + $m * 60 + $s;"
NSQ_SOURCE_LINE 00000022 "}"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "sub now {"
NSQ_SOURCE_LINE 00000025 "    @_ == 1 || Carp::croak(q/Usage: Time::Moment->now()/);"
NSQ_SOURCE_LINE 00000026 "    my ($class) = @_;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    my ($sec, $usec) = Time::HiRes::gettimeofday();"
NSQ_SOURCE_LINE 00000029 "    my $offset = int((timegm(localtime($sec)) - $sec) / 60);"
NSQ_SOURCE_LINE 00000030 "    return $class->from_epoch($sec, $usec * 1000)"
NSQ_SOURCE_LINE 00000031 "                 ->with_offset_same_instant($offset);"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub now_utc {"
NSQ_SOURCE_LINE 00000035 "    @_ == 1 || Carp::croak(q/Usage: Time::Moment->now_utc()/);"
NSQ_SOURCE_LINE 00000036 "    my ($class) = @_;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    my ($sec, $usec) = Time::HiRes::gettimeofday();"
NSQ_SOURCE_LINE 00000039 "    return $class->from_epoch($sec, $usec * 1000);"
NSQ_SOURCE_LINE 00000040 "}"
NSQ_SOURCE_LINE 00000041 "EOC"
NSQ_SOURCE_LINE 00000042 "        die $@ if $@;"
NSQ_SOURCE_LINE 00000043 "    }"
NSQ_SOURCE_LINE 00000044 "}"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "BEGIN {"
NSQ_SOURCE_LINE 00000047 "    delete @Time::Moment::{qw(timegm)};"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "sub __as_DateTime {"
NSQ_SOURCE_LINE 00000051 "    my ($tm) = @_;"
NSQ_SOURCE_LINE 00000052 "    return DateTime->from_epoch("
NSQ_SOURCE_LINE 00000053 "        epoch     => $tm->epoch,"
NSQ_SOURCE_LINE 00000054 "        time_zone => $tm->strftime('%Z'),"
NSQ_SOURCE_LINE 00000055 "    )->set_nanosecond($tm->nanosecond);"
NSQ_SOURCE_LINE 00000056 "}"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "sub __as_Time_Piece {"
NSQ_SOURCE_LINE 00000059 "    my ($tm) = @_;"
NSQ_SOURCE_LINE 00000060 "    return scalar Time::Piece::gmtime($tm->epoch);"
NSQ_SOURCE_LINE 00000061 "}"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "sub DateTime::__as_Time_Moment {"
NSQ_SOURCE_LINE 00000064 "    my ($dt) = @_;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    (!$dt->time_zone->is_floating)"
NSQ_SOURCE_LINE 00000067 "      or Carp::croak(q/Cannot coerce an instance of DateTime in the 'floating' /"
NSQ_SOURCE_LINE 00000068 "                    .q/time zone to an instance of Time::Moment/);"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    return Time::Moment->from_epoch($dt->epoch, $dt->nanosecond)"
NSQ_SOURCE_LINE 00000071 "                       ->with_offset_same_instant(int($dt->offset / 60));"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub Time::Piece::__as_Time_Moment {"
NSQ_SOURCE_LINE 00000075 "    my ($tp) = @_;"
NSQ_SOURCE_LINE 00000076 "    return Time::Moment->from_epoch($tp->epoch)"
NSQ_SOURCE_LINE 00000077 "                       ->with_offset_same_instant(int($tp->tzoffset / 60));"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "sub STORABLE_freeze {"
NSQ_SOURCE_LINE 00000081 "    my ($self, $cloning) = @_;"
NSQ_SOURCE_LINE 00000082 "    return if $cloning;"
NSQ_SOURCE_LINE 00000083 "    return pack 'nnNNN', 0x544D, $self->offset, $self->utc_rd_values;"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub STORABLE_thaw {"
NSQ_SOURCE_LINE 00000087 "    my ($self, $cloning, $packed) = @_;"
NSQ_SOURCE_LINE 00000088 "    return if $cloning;"
NSQ_SOURCE_LINE 00000089 "    (length($packed) == 16 && vec($packed, 0, 16) == 0x544D) # TM"
NSQ_SOURCE_LINE 00000090 "      or die(q/Cannot deserialize corrupted data/); # Don't replace die with Carp!"
NSQ_SOURCE_LINE 00000091 "    my ($offset, $rdn, $sod, $nos) = unpack 'xxnNNN', $packed;"
NSQ_SOURCE_LINE 00000092 "    $offset = ($offset & 0x7FFF) - 0x8000 if ($offset & 0x8000);"
NSQ_SOURCE_LINE 00000093 "    my $seconds = ($rdn - 719163) * 86400 + $sod;"
NSQ_SOURCE_LINE 00000094 "    $$self = ${ ref($self)->from_epoch($seconds, $nos)"
NSQ_SOURCE_LINE 00000095 "                          ->with_offset_same_instant($offset) };"
NSQ_SOURCE_LINE 00000096 "}"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "sub TO_JSON {"
NSQ_SOURCE_LINE 00000099 "    return $_[0]->to_string;"
NSQ_SOURCE_LINE 00000100 "}"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "sub TO_CBOR {"
NSQ_SOURCE_LINE 00000103 "    # Use the standard tag for date/time string; see RFC 7049 Section 2.4.1"
NSQ_SOURCE_LINE 00000104 "    return CBOR::XS::tag(0, $_[0]->to_string);"
NSQ_SOURCE_LINE 00000105 "}"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "sub FREEZE {"
