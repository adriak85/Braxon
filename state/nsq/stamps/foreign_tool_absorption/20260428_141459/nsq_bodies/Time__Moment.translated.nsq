NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "sub THAW {"
NSQ_SOURCE_LINE 00000112 "    my ($class, undef, $string) = @_;"
NSQ_SOURCE_LINE 00000113 "    return $class->from_string($string);"
NSQ_SOURCE_LINE 00000114 "}"
NSQ_SOURCE_LINE 00000115 ""
