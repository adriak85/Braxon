BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Perinci::Sub::Normalize;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Exporter 'import';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000010 "our $DATE = '2022-12-19'; # DATE"
NSQ_SOURCE_LINE 00000011 "our $DIST = 'Perinci-Sub-Normalize'; # DIST"
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.207'; # VERSION"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000015 "                       normalize_function_metadata"
NSQ_SOURCE_LINE 00000016 "               );"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub _check {"
NSQ_SOURCE_LINE 00000019 "    my $meta = shift; # must be normalized"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "  CHECK_ARGS: {"
NSQ_SOURCE_LINE 00000022 "        my $argspecs = $meta->{args};"
NSQ_SOURCE_LINE 00000023 "      CHECK_ARGS_POS: {"
NSQ_SOURCE_LINE 00000024 "            my @arg_at_pos;"
NSQ_SOURCE_LINE 00000025 "            my $slurpy_pos;"
NSQ_SOURCE_LINE 00000026 "            for my $argname (keys %$argspecs) {"
NSQ_SOURCE_LINE 00000027 "                my $argspec = $argspecs->{$argname};"
NSQ_SOURCE_LINE 00000028 "                if (defined $argspec->{pos}) {"
NSQ_SOURCE_LINE 00000029 "                    return \"Argument $argname: Negative pos\" if $argspec->{pos} < 0;"
NSQ_SOURCE_LINE 00000030 "                    return \"Duplicate argument position $argspec->{pos} (arg $argname vs $arg_at_pos[$argspec->{pos}])\" if defined $arg_at_pos[ $argspec->{pos} ];"
NSQ_SOURCE_LINE 00000031 "                    $arg_at_pos[ $argspec->{pos} ] = $argname;"
NSQ_SOURCE_LINE 00000032 "                }"
NSQ_SOURCE_LINE 00000033 "                if ($argspec->{slurpy} || $argspec->{greedy}) { # greedy is deprecated, but we should keep observing to make us properly strict"
NSQ_SOURCE_LINE 00000034 "                    return \"Argument $argname: slurpy=1 without setting pos\""
NSQ_SOURCE_LINE 00000035 "                        unless defined $argspec->{pos};"
NSQ_SOURCE_LINE 00000036 "                    return \"Multiple args with slurpy=1\" if defined $slurpy_pos;"
NSQ_SOURCE_LINE 00000037 "                    $slurpy_pos = $argspec->{pos};"
NSQ_SOURCE_LINE 00000038 "                }"
NSQ_SOURCE_LINE 00000039 "            }"
NSQ_SOURCE_LINE 00000040 "            if (defined $slurpy_pos && $slurpy_pos < @arg_at_pos-1) {"
NSQ_SOURCE_LINE 00000041 "                return \"Clash of argument positions: slurpy=1 defined for pos=$slurpy_pos but there is another argument with pos > $slurpy_pos\";"
NSQ_SOURCE_LINE 00000042 "            }"
NSQ_SOURCE_LINE 00000043 "            # we have holes"
NSQ_SOURCE_LINE 00000044 "            return \"There needs to be more arguments that define pos\""
NSQ_SOURCE_LINE 00000045 "                if grep { !defined } @arg_at_pos;"
NSQ_SOURCE_LINE 00000046 "            if ($meta->{args_as} && $meta->{args_as} =~ /\\Aarray(ref)?\\z/) {"
NSQ_SOURCE_LINE 00000047 "                return \"Function accepts array/arrayref but there are arguments with no pos defined\""
NSQ_SOURCE_LINE 00000048 "                    if scalar(keys %$argspecs) > @arg_at_pos;"
NSQ_SOURCE_LINE 00000049 "            }"
NSQ_SOURCE_LINE 00000050 "        }"
NSQ_SOURCE_LINE 00000051 "    }"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    undef;"
NSQ_SOURCE_LINE 00000054 "}"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "sub _normalize {"
NSQ_SOURCE_LINE 00000057 "    my ($meta, $ver, $opts, $proplist, $nmeta, $prefix, $modprefix) = @_;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    my $opt_aup = $opts->{allow_unknown_properties};"
NSQ_SOURCE_LINE 00000060 "    my $opt_nss = $opts->{normalize_sah_schemas};"
NSQ_SOURCE_LINE 00000061 "    my $opt_rip = $opts->{remove_internal_properties};"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    if (defined $ver) {"
NSQ_SOURCE_LINE 00000064 "        defined($meta->{v}) && $meta->{v} eq $ver"
NSQ_SOURCE_LINE 00000065 "            or die \"$prefix: Metadata version must be $ver\";"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "  KEY:"
NSQ_SOURCE_LINE 00000069 "    for my $k (keys %$meta) {"
NSQ_SOURCE_LINE 00000070 "        die \"Invalid prop/attr syntax '$k', must be word/dotted-word only\""
NSQ_SOURCE_LINE 00000071 "            unless $k =~ /\\A(\\w+)(?:\\.(\\w+(?:\\.\\w+)*))?(?:\\((\\w+)\\))?\\z/;"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "        my ($prop, $attr);"
NSQ_SOURCE_LINE 00000074 "        if (defined $3) {"
NSQ_SOURCE_LINE 00000075 "            $prop = $1;"
NSQ_SOURCE_LINE 00000076 "            $attr = defined($2) ? \"$2.alt.lang.$3\" : \"alt.lang.$3\";"
NSQ_SOURCE_LINE 00000077 "        } else {"
NSQ_SOURCE_LINE 00000078 "            $prop = $1;"
NSQ_SOURCE_LINE 00000079 "            $attr = $2;"
NSQ_SOURCE_LINE 00000080 "        }"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "        my $nk = \"$prop\" . (defined($attr) ? \".$attr\" : \"\");"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "        # strip property/attr started with _"
NSQ_SOURCE_LINE 00000085 "        if ($prop =~ /\\A_/ || defined($attr) && $attr =~ /\\A_|\\._/) {"
NSQ_SOURCE_LINE 00000086 "            unless ($opt_rip) {"
NSQ_SOURCE_LINE 00000087 "                $nmeta->{$nk} = $meta->{$k};"
NSQ_SOURCE_LINE 00000088 "            }"
NSQ_SOURCE_LINE 00000089 "            next KEY;"
NSQ_SOURCE_LINE 00000090 "        }"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "        my $prop_proplist = $proplist->{$prop};"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "        # try to load module that declare new props first"
NSQ_SOURCE_LINE 00000095 "        if (!$opt_aup && !$prop_proplist) {"
NSQ_SOURCE_LINE 00000096 "            $modprefix //= $prefix;"
NSQ_SOURCE_LINE 00000097 "            my $mod = \"Perinci/Sub/Property$modprefix/$prop.pm\";"
NSQ_SOURCE_LINE 00000098 "            eval { require $mod };"
NSQ_SOURCE_LINE 00000099 "            # hide technical error message from require()"
NSQ_SOURCE_LINE 00000100 "            if ($@) {"
NSQ_SOURCE_LINE 00000101 "                die \"Unknown property '$prefix/$prop' (and couldn't \"."
NSQ_SOURCE_LINE 00000102 "                    \"load property module '$mod'): $@\" if $@;"
NSQ_SOURCE_LINE 00000103 "            }"
NSQ_SOURCE_LINE 00000104 "            $prop_proplist = $proplist->{$prop};"
NSQ_SOURCE_LINE 00000105 "        }"
NSQ_SOURCE_LINE 00000106 "        die \"Unknown property '$prefix/$prop'\""
NSQ_SOURCE_LINE 00000107 "            unless $opt_aup || $prop_proplist;"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "        if ($prop_proplist && $prop_proplist->{_prop}) {"
NSQ_SOURCE_LINE 00000110 "            die \"Property '$prefix/$prop' must be a hash\""
NSQ_SOURCE_LINE 00000111 "                unless ref($meta->{$k}) eq 'HASH';"
NSQ_SOURCE_LINE 00000112 "            $nmeta->{$nk} = {};"
NSQ_SOURCE_LINE 00000113 "            _normalize("
NSQ_SOURCE_LINE 00000114 "                $meta->{$k},"
NSQ_SOURCE_LINE 00000115 "                $prop_proplist->{_ver},"
NSQ_SOURCE_LINE 00000116 "                $opts,"
NSQ_SOURCE_LINE 00000117 "                $prop_proplist->{_prop},"
NSQ_SOURCE_LINE 00000118 "                $nmeta->{$nk},"
NSQ_SOURCE_LINE 00000119 "                \"$prefix/$prop\","
NSQ_SOURCE_LINE 00000120 "            );"
NSQ_SOURCE_LINE 00000121 "        } elsif ($prop_proplist && $prop_proplist->{_elem_prop}) {"
NSQ_SOURCE_LINE 00000122 "            die \"Property '$prefix/$prop' must be an array\""
NSQ_SOURCE_LINE 00000123 "                unless ref($meta->{$k}) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000124 "            $nmeta->{$nk} = [];"
NSQ_SOURCE_LINE 00000125 "            my $i = 0;"
NSQ_SOURCE_LINE 00000126 "            for (@{ $meta->{$k} }) {"
NSQ_SOURCE_LINE 00000127 "                my $href = {};"
NSQ_SOURCE_LINE 00000128 "                if (ref($_) eq 'HASH') {"
NSQ_SOURCE_LINE 00000129 "                    _normalize("
NSQ_SOURCE_LINE 00000130 "                        $_,"
NSQ_SOURCE_LINE 00000131 "                        $prop_proplist->{_ver},"
NSQ_SOURCE_LINE 00000132 "                        $opts,"
NSQ_SOURCE_LINE 00000133 "                        $prop_proplist->{_elem_prop},"
NSQ_SOURCE_LINE 00000134 "                        $href,"
NSQ_SOURCE_LINE 00000135 "                        \"$prefix/$prop/$i\","
NSQ_SOURCE_LINE 00000136 "                    );"
NSQ_SOURCE_LINE 00000137 "                    push @{ $nmeta->{$nk} }, $href;"
NSQ_SOURCE_LINE 00000138 "                } else {"
NSQ_SOURCE_LINE 00000139 "                    push @{ $nmeta->{$nk} }, $_;"
NSQ_SOURCE_LINE 00000140 "                }"
NSQ_SOURCE_LINE 00000141 "                $i++;"
NSQ_SOURCE_LINE 00000142 "            }"
NSQ_SOURCE_LINE 00000143 "        } elsif ($prop_proplist && $prop_proplist->{_value_prop}) {"
NSQ_SOURCE_LINE 00000144 "            die \"Property '$prefix/$prop' must be a hash\""
NSQ_SOURCE_LINE 00000145 "                unless ref($meta->{$k}) eq 'HASH';"
NSQ_SOURCE_LINE 00000146 "            $nmeta->{$nk} = {};"
NSQ_SOURCE_LINE 00000147 "            for (keys %{ $meta->{$k} }) {"
NSQ_SOURCE_LINE 00000148 "                $nmeta->{$nk}{$_} = {};"
NSQ_SOURCE_LINE 00000149 "                die \"Property '$prefix/$prop/$_' must be a hash\""
NSQ_SOURCE_LINE 00000150 "                    unless ref($meta->{$k}{$_}) eq 'HASH';"
NSQ_SOURCE_LINE 00000151 "                _normalize("
NSQ_SOURCE_LINE 00000152 "                    $meta->{$k}{$_},"
NSQ_SOURCE_LINE 00000153 "                    $prop_proplist->{_ver},"
NSQ_SOURCE_LINE 00000154 "                    $opts,"
NSQ_SOURCE_LINE 00000155 "                    $prop_proplist->{_value_prop},"
NSQ_SOURCE_LINE 00000156 "                    $nmeta->{$nk}{$_},"
NSQ_SOURCE_LINE 00000157 "                    \"$prefix/$prop/$_\","
NSQ_SOURCE_LINE 00000158 "                    ($prop eq 'args' ? \"$prefix/arg\" : undef),"
NSQ_SOURCE_LINE 00000159 "                );"
NSQ_SOURCE_LINE 00000160 "            }"
NSQ_SOURCE_LINE 00000161 "        } else {"
NSQ_SOURCE_LINE 00000162 "            if ($k eq 'schema' && $opt_nss) { # XXX currently hardcoded"
NSQ_SOURCE_LINE 00000163 "                require Data::Sah::Normalize;"
NSQ_SOURCE_LINE 00000164 "                $nmeta->{$nk} = Data::Sah::Normalize::normalize_schema("
NSQ_SOURCE_LINE 00000165 "                    $meta->{$k});"
NSQ_SOURCE_LINE 00000166 "            } else {"
NSQ_SOURCE_LINE 00000167 "                $nmeta->{$nk} = $meta->{$k};"
NSQ_SOURCE_LINE 00000168 "            }"
NSQ_SOURCE_LINE 00000169 "        }"
NSQ_SOURCE_LINE 00000170 "    } # for each key"
NSQ_SOURCE_LINE 00000171 "    $nmeta;"
NSQ_SOURCE_LINE 00000172 "}"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "sub normalize_function_metadata($;$) { ## no critic: Subroutines::ProhibitSubroutinePrototypes"
NSQ_SOURCE_LINE 00000175 "    my ($meta, $opts) = @_;"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    $opts //= {};"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    $opts->{allow_unknown_properties}    //= 0;"
NSQ_SOURCE_LINE 00000180 "    $opts->{normalize_sah_schemas}       //= 1;"
NSQ_SOURCE_LINE 00000181 "    $opts->{remove_internal_properties}  //= 0;"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    require Sah::Schema::rinci::function_meta;"
NSQ_SOURCE_LINE 00000184 "    my $sch = $Sah::Schema::rinci::function_meta::schema;"
NSQ_SOURCE_LINE 00000185 "    my $sch_proplist = $sch->[1]{_prop}"
NSQ_SOURCE_LINE 00000186 "        or die \"BUG: Rinci schema structure changed (1a)\";"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "    my $nmeta = _normalize($meta, 1.1, $opts, $sch_proplist, {}, '');"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    my $err = _check($meta);"
NSQ_SOURCE_LINE 00000191 "    die $err if $err;"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    $nmeta;"
NSQ_SOURCE_LINE 00000194 "}"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "1;"
NSQ_SOURCE_LINE 00000197 "# ABSTRACT: Normalize Rinci function metadata"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "__END__"
