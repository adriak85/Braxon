NSQ_SOURCE_LINE 00000201 "=pod"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=head1 NAME"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "Perinci::Sub::Normalize - Normalize Rinci function metadata"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head1 VERSION"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "This document describes version 0.207 of Perinci::Sub::Normalize (from Perl distribution Perinci-Sub-Normalize), released on 2022-12-19."
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 " use Perinci::Sub::Normalize qw(normalize_function_metadata);"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 " my $nmeta = normalize_function_metadata($meta);"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=head2 normalize_function_metadata($meta[ , \\%opts ]) => HASH"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "Normalize and check L<Rinci> function metadata C<$meta>. Return normalized"
NSQ_SOURCE_LINE 00000224 "metadata, which is a shallow copy of C<$meta>. Die on error."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "Available options:"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=over"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=item * allow_unknown_properties => BOOL (default: 0)"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "If set to true, will die if there are unknown properties."
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=item * normalize_sah_schemas => BOOL (default: 1)"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "By default, L<Sah> schemas e.g. in C<result/schema> or C<args/*/schema> property"
NSQ_SOURCE_LINE 00000237 "is normalized using L<Data::Sah>'s C<normalize_schema>. Set this to 0 if you"
NSQ_SOURCE_LINE 00000238 "don't want this."
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=item * remove_internal_properties => BOOL (default: 0)"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "If set to 1, all properties and attributes starting with underscore (C<_>) with"
NSQ_SOURCE_LINE 00000243 "will be stripped. According to L<DefHash> specification, they are ignored and"
NSQ_SOURCE_LINE 00000244 "usually contain notes/comments/extra information."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=back"
NSQ_SOURCE_LINE 00000247 ""
