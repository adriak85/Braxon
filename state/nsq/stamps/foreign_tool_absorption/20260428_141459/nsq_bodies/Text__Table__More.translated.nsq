NSQ_SOURCE_LINE 00000080 "sub IDX_EXPTABLE_CELL_WIDTH()           {2} # visual width. this does not include the cell padding."
NSQ_SOURCE_LINE 00000081 "sub IDX_EXPTABLE_CELL_HEIGHT()          {3} # visual height. this does not include row separator."
NSQ_SOURCE_LINE 00000082 "sub IDX_EXPTABLE_CELL_ORIG()            {4} # str/hash"
NSQ_SOURCE_LINE 00000083 "sub IDX_EXPTABLE_CELL_IS_ROWSPAN_TAIL() {5} # whether this cell is tail of a rowspan"
NSQ_SOURCE_LINE 00000084 "sub IDX_EXPTABLE_CELL_IS_COLSPAN_TAIL() {6} # whether this cell is tail of a colspan"
NSQ_SOURCE_LINE 00000085 "sub IDX_EXPTABLE_CELL_ORIG_ROWNUM()     {7} #"
NSQ_SOURCE_LINE 00000086 "sub IDX_EXPTABLE_CELL_ORIG_COLNUM()     {8} #"
NSQ_SOURCE_LINE 00000087 "sub IDX_EXPTABLE_CELL_TEXT()            {9} # cell text (modified: padded)"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "# whether an exptable cell is the head (1st cell) or tail (the rest) of a"
NSQ_SOURCE_LINE 00000090 "# rowspan/colspan. these should be macros if possible, for speed."
NSQ_SOURCE_LINE 00000091 "sub _exptable_cell_is_rowspan_tail { defined($_[0]) &&  $_[0][IDX_EXPTABLE_CELL_IS_ROWSPAN_TAIL] }"
NSQ_SOURCE_LINE 00000092 "sub _exptable_cell_is_colspan_tail { defined($_[0]) &&  $_[0][IDX_EXPTABLE_CELL_IS_COLSPAN_TAIL] }"
NSQ_SOURCE_LINE 00000093 "sub _exptable_cell_is_tail         { defined($_[0]) && ($_[0][IDX_EXPTABLE_CELL_IS_ROWSPAN_TAIL] || $_[0][IDX_EXPTABLE_CELL_IS_COLSPAN_TAIL]) }"
NSQ_SOURCE_LINE 00000094 "sub _exptable_cell_is_rowspan_head { defined($_[0]) && !$_[0][IDX_EXPTABLE_CELL_IS_ROWSPAN_TAIL] }"
NSQ_SOURCE_LINE 00000095 "sub _exptable_cell_is_colspan_head { defined($_[0]) && !$_[0][IDX_EXPTABLE_CELL_IS_COLSPAN_TAIL] }"
NSQ_SOURCE_LINE 00000096 "sub _exptable_cell_is_head         { defined($_[0]) && defined $_[0][IDX_EXPTABLE_CELL_ORIG] }"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "sub _divide_int_to_n_ints {"
NSQ_SOURCE_LINE 00000099 "    my ($int, $n) = @_;"
NSQ_SOURCE_LINE 00000100 "    my $subtot = 0;"
NSQ_SOURCE_LINE 00000101 "    my $int_subtot = 0;"
NSQ_SOURCE_LINE 00000102 "    my $prev_int_subtot = 0;"
NSQ_SOURCE_LINE 00000103 "    my @ints;"
NSQ_SOURCE_LINE 00000104 "    for (1..$n) {"
NSQ_SOURCE_LINE 00000105 "        $subtot += $int/$n;"
NSQ_SOURCE_LINE 00000106 "        $int_subtot = sprintf \"%.0f\", $subtot;"
NSQ_SOURCE_LINE 00000107 "        push @ints, $int_subtot - $prev_int_subtot;"
NSQ_SOURCE_LINE 00000108 "        $prev_int_subtot = $int_subtot;"
NSQ_SOURCE_LINE 00000109 "    }"
NSQ_SOURCE_LINE 00000110 "    @ints;"
NSQ_SOURCE_LINE 00000111 "}"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "sub _vpad {"
NSQ_SOURCE_LINE 00000114 "    my ($lines, $num_lines, $width, $which, $pad_char) = @_;"
NSQ_SOURCE_LINE 00000115 "    return $lines if @$lines >= $num_lines; # we don't do truncate"
NSQ_SOURCE_LINE 00000116 "    my @vpadded_lines;"
NSQ_SOURCE_LINE 00000117 "    my $pad_line = $pad_char x $width;"
NSQ_SOURCE_LINE 00000118 "    if ($which =~ /^b/) { # bottom padding"
NSQ_SOURCE_LINE 00000119 "        push @vpadded_lines, @$lines;"
NSQ_SOURCE_LINE 00000120 "        push @vpadded_lines, $pad_line for @$lines+1 .. $num_lines;"
NSQ_SOURCE_LINE 00000121 "    } elsif ($which =~ /^t/) { # top padding"
NSQ_SOURCE_LINE 00000122 "        push @vpadded_lines, $pad_line for @$lines+1 .. $num_lines;"
NSQ_SOURCE_LINE 00000123 "        push @vpadded_lines, @$lines;"
NSQ_SOURCE_LINE 00000124 "    } else { # center padding"
NSQ_SOURCE_LINE 00000125 "        my $p  = $num_lines - @$lines;"
NSQ_SOURCE_LINE 00000126 "        my $p1 = int($p/2);"
NSQ_SOURCE_LINE 00000127 "        my $p2 = $p - $p1;"
NSQ_SOURCE_LINE 00000128 "        push @vpadded_lines, $pad_line for 1..$p1;"
NSQ_SOURCE_LINE 00000129 "        push @vpadded_lines, @$lines;"
NSQ_SOURCE_LINE 00000130 "        push @vpadded_lines, $pad_line for 1..$p2;"
NSQ_SOURCE_LINE 00000131 "    }"
NSQ_SOURCE_LINE 00000132 "    \\@vpadded_lines;"
NSQ_SOURCE_LINE 00000133 "}"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "sub _get_attr {"
NSQ_SOURCE_LINE 00000136 "    my ($attr_name, $y, $x, $cell_value, $table_args) = @_;"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "  CELL_ATTRS_FROM_CELL_VALUE: {"
NSQ_SOURCE_LINE 00000139 "        last unless ref $cell_value eq 'HASH';"
NSQ_SOURCE_LINE 00000140 "        my $attr_val = $cell_value->{$attr_name};"
NSQ_SOURCE_LINE 00000141 "        return $attr_val if defined $attr_val;"
NSQ_SOURCE_LINE 00000142 "    }"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "  CELL_ATTRS_FROM_CELL_ATTRS_ARG:"
NSQ_SOURCE_LINE 00000145 "    {"
NSQ_SOURCE_LINE 00000146 "        last unless defined $x && defined $y;"
NSQ_SOURCE_LINE 00000147 "        my $cell_attrs = $table_args->{cell_attrs};"
NSQ_SOURCE_LINE 00000148 "        last unless $cell_attrs;"
NSQ_SOURCE_LINE 00000149 "        for my $entry (@$cell_attrs) {"
NSQ_SOURCE_LINE 00000150 "            next unless $entry->[0] == $y && $entry->[1] == $x;"
NSQ_SOURCE_LINE 00000151 "            my $attr_val = $entry->[2]{$attr_name};"
NSQ_SOURCE_LINE 00000152 "            return $attr_val if defined $attr_val;"
NSQ_SOURCE_LINE 00000153 "        }"
NSQ_SOURCE_LINE 00000154 "    }"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "  COL_ATTRS:"
NSQ_SOURCE_LINE 00000157 "    {"
NSQ_SOURCE_LINE 00000158 "        last unless defined $x;"
NSQ_SOURCE_LINE 00000159 "        my $col_attrs = $table_args->{col_attrs};"
NSQ_SOURCE_LINE 00000160 "        last unless $col_attrs;"
NSQ_SOURCE_LINE 00000161 "        for my $entry (@$col_attrs) {"
NSQ_SOURCE_LINE 00000162 "            next unless $entry->[0] == $x;"
NSQ_SOURCE_LINE 00000163 "            my $attr_val = $entry->[1]{$attr_name};"
NSQ_SOURCE_LINE 00000164 "            return $attr_val if defined $attr_val;"
NSQ_SOURCE_LINE 00000165 "        }"
NSQ_SOURCE_LINE 00000166 "    }"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "  ROW_ATTRS:"
NSQ_SOURCE_LINE 00000169 "    {"
NSQ_SOURCE_LINE 00000170 "        last unless defined $y;"
NSQ_SOURCE_LINE 00000171 "        my $row_attrs = $table_args->{row_attrs};"
NSQ_SOURCE_LINE 00000172 "        last unless $row_attrs;"
NSQ_SOURCE_LINE 00000173 "        for my $entry (@$row_attrs) {"
NSQ_SOURCE_LINE 00000174 "            next unless $entry->[0] == $y;"
NSQ_SOURCE_LINE 00000175 "            my $attr_val = $entry->[1]{$attr_name};"
NSQ_SOURCE_LINE 00000176 "            return $attr_val if defined $attr_val;"
NSQ_SOURCE_LINE 00000177 "        }"
NSQ_SOURCE_LINE 00000178 "    }"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "  TABLE_ARGS:"
NSQ_SOURCE_LINE 00000181 "    {"
NSQ_SOURCE_LINE 00000182 "        my $attr_val = $table_args->{$attr_name};"
NSQ_SOURCE_LINE 00000183 "        return $attr_val if defined $attr_val;"
NSQ_SOURCE_LINE 00000184 "    }"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "    undef;"
NSQ_SOURCE_LINE 00000187 "}"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "sub _get_exptable_cell_lines {"
NSQ_SOURCE_LINE 00000190 "    my ($table_args, $exptable, $row_heights, $column_widths,"
NSQ_SOURCE_LINE 00000191 "        $bottom_borders, $intercol_width, $y, $x) = @_;"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    my $exptable_cell = $exptable->[$y][$x];"
NSQ_SOURCE_LINE 00000194 "    my $cell     = $exptable_cell->[IDX_EXPTABLE_CELL_ORIG];"
NSQ_SOURCE_LINE 00000195 "    my $text     = $exptable_cell->[IDX_EXPTABLE_CELL_TEXT];"
NSQ_SOURCE_LINE 00000196 "    my $align    = _get_attr('align', $y, $x, $cell, $table_args) // 'left';"
NSQ_SOURCE_LINE 00000197 "    my $valign   = _get_attr('valign', $y, $x, $cell, $table_args) // 'top';"
NSQ_SOURCE_LINE 00000198 "    my $pad      = $align eq 'left' ? 'r' : $align eq 'right' ? 'l' : 'c';"
NSQ_SOURCE_LINE 00000199 "    my $vpad     = $valign eq 'top' ? 'b' : $valign eq 'bottom' ? 't' : 'c';"
NSQ_SOURCE_LINE 00000200 "    my $pad_char = $table_args->{pad_char};"
NSQ_SOURCE_LINE 00000201 "    my $height = 0;"
NSQ_SOURCE_LINE 00000202 "    my $width  = 0;"
NSQ_SOURCE_LINE 00000203 "    for my $ic (1..$exptable_cell->[IDX_EXPTABLE_CELL_COLSPAN]) {"
NSQ_SOURCE_LINE 00000204 "        $width += $column_widths->[$x+$ic-1];"
NSQ_SOURCE_LINE 00000205 "        $width += $intercol_width if $ic > 1;"
NSQ_SOURCE_LINE 00000206 "    }"
NSQ_SOURCE_LINE 00000207 "    for my $ir (1..$exptable_cell->[IDX_EXPTABLE_CELL_ROWSPAN]) {"
NSQ_SOURCE_LINE 00000208 "        $height += $row_heights->[$y+$ir-1];"
NSQ_SOURCE_LINE 00000209 "        $height++ if $bottom_borders->[$y+$ir-2] && $ir > 1;"
NSQ_SOURCE_LINE 00000210 "    }"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "    my @datalines = map { $_pad_func->($_, $width, $pad, $pad_char, 'truncate') }"
NSQ_SOURCE_LINE 00000213 "        ($_split_lines_func->($text));"
NSQ_SOURCE_LINE 00000214 "    _vpad(\\@datalines, $height, $width, $vpad, $pad_char);"
NSQ_SOURCE_LINE 00000215 "}"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "sub generate_table {"
NSQ_SOURCE_LINE 00000218 "    require Module::Load::Util;"
NSQ_SOURCE_LINE 00000219 "    require Text::NonWideChar::Util;"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "    my %args = @_;"
NSQ_SOURCE_LINE 00000222 "    $args{header_row} //= 0; my $header_row = $args{header_row};"
NSQ_SOURCE_LINE 00000223 "    $args{pad_char} //= ' ';"
NSQ_SOURCE_LINE 00000224 "    $args{hpad} //= 1;"
NSQ_SOURCE_LINE 00000225 "    $args{vpad} //= 0;"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    my $rows = $args{rows} or die \"Please specify rows\";"
NSQ_SOURCE_LINE 00000228 "    my $bs_name = $args{border_style} //"
NSQ_SOURCE_LINE 00000229 "        $ENV{PERL_TEXT_TABLE_MORE_BORDER_STYLE} //"
NSQ_SOURCE_LINE 00000230 "        $ENV{BORDER_STYLE} //"
NSQ_SOURCE_LINE 00000231 "        'ASCII::SingleLineDoubleAfterHeader';"
NSQ_SOURCE_LINE 00000232 "    my $cell_attrs = $args{cell_attrs} // [];"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "    my $bs_obj = Module::Load::Util::instantiate_class_with_optional_args({ns_prefix=>\"BorderStyle\"}, $bs_name);"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "  DETERMINE_CODES: {"
NSQ_SOURCE_LINE 00000237 "        my $color = $args{color};"
NSQ_SOURCE_LINE 00000238 "        my $wide_char = $args{wide_char};"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "        # split_lines"
NSQ_SOURCE_LINE 00000241 "        if ($color) {"
NSQ_SOURCE_LINE 00000242 "            require Text::ANSI::Util;"
NSQ_SOURCE_LINE 00000243 "            $_split_lines_func = sub { Text::ANSI::Util::ta_add_color_resets(split /\\R/, $_[0]) };"
NSQ_SOURCE_LINE 00000244 "        } else {"
NSQ_SOURCE_LINE 00000245 "            $_split_lines_func = sub { split /\\R/, $_[0] };"
NSQ_SOURCE_LINE 00000246 "        }"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "        # pad & length_height"
NSQ_SOURCE_LINE 00000249 "        if ($color) {"
NSQ_SOURCE_LINE 00000250 "            if ($wide_char) {"
NSQ_SOURCE_LINE 00000251 "                require Text::ANSI::WideUtil;"
NSQ_SOURCE_LINE 00000252 "                $_pad_func           = \\&Text::ANSI::WideUtil::ta_mbpad;"
NSQ_SOURCE_LINE 00000253 "                $_length_height_func = \\&Text::ANSI::WideUtil::ta_mbswidth_height;"
NSQ_SOURCE_LINE 00000254 "            } else {"
NSQ_SOURCE_LINE 00000255 "                require Text::ANSI::Util;"
NSQ_SOURCE_LINE 00000256 "                $_pad_func           = \\&Text::ANSI::Util::ta_pad;"
NSQ_SOURCE_LINE 00000257 "                $_length_height_func = \\&Text::ANSI::Util::ta_length_height;"
NSQ_SOURCE_LINE 00000258 "            }"
NSQ_SOURCE_LINE 00000259 "        } else {"
NSQ_SOURCE_LINE 00000260 "            if ($wide_char) {"
NSQ_SOURCE_LINE 00000261 "                require Text::WideChar::Util;"
NSQ_SOURCE_LINE 00000262 "                $_pad_func           = \\&Text::WideChar::Util::mbpad;"
NSQ_SOURCE_LINE 00000263 "                $_length_height_func = \\&Text::WideChar::Util::mbswidth_height;"
NSQ_SOURCE_LINE 00000264 "            } else {"
NSQ_SOURCE_LINE 00000265 "                require String::Pad;"
NSQ_SOURCE_LINE 00000266 "                require Text::NonWideChar::Util;"
NSQ_SOURCE_LINE 00000267 "                $_pad_func           = \\&String::Pad::pad;"
NSQ_SOURCE_LINE 00000268 "                $_length_height_func = \\&Text::NonWideChar::Util::length_height;"
NSQ_SOURCE_LINE 00000269 "            }"
NSQ_SOURCE_LINE 00000270 "        }"
NSQ_SOURCE_LINE 00000271 "    }"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "    # XXX when we allow cell attrs right_border and left_border, this will"
NSQ_SOURCE_LINE 00000274 "    # become array too like $exptable_bottom_borders."
NSQ_SOURCE_LINE 00000275 "    my $intercol_width = length($bs_obj->get_border_char(char=>'v_i'));"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "    my $exptable = []; # [ [[$orig_rowidx,$orig_colidx,$rowspan,$colspan,...], ...], [[...], ...], ... ]"
NSQ_SOURCE_LINE 00000278 "    my $exptable_bottom_borders = []; # idx=exptable rownum, val=bool"
NSQ_SOURCE_LINE 00000279 "    my $M = 0; # number of rows in the exptable"
NSQ_SOURCE_LINE 00000280 "    my $N = 0; # number of columns in the exptable"
NSQ_SOURCE_LINE 00000281 "  CONSTRUCT_EXPTABLE: {"
NSQ_SOURCE_LINE 00000282 "        # 1. the first step is to construct a 2D array we call \"exptable\" (short"
NSQ_SOURCE_LINE 00000283 "        # for expanded table), which is like the original table but with all the"
NSQ_SOURCE_LINE 00000284 "        # spanning rows/columns split into the smaller boxes so it's easier to"
NSQ_SOURCE_LINE 00000285 "        # draw later. for example, a table cell with colspan=2 will become 2"
NSQ_SOURCE_LINE 00000286 "        # exptable cells. an m-row x n-column table will become M-row x N-column"
NSQ_SOURCE_LINE 00000287 "        # exptable, where M>=m, N>=n."
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "        my $rownum;"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "        # 1a. first substep: construct exptable and calculate everything except"
NSQ_SOURCE_LINE 00000292 "        # each exptable cell's width and height, because this will require"
NSQ_SOURCE_LINE 00000293 "        # information from the previous substeps."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "        $rownum = -1;"
NSQ_SOURCE_LINE 00000296 "        for my $row (@$rows) {"
NSQ_SOURCE_LINE 00000297 "            $rownum++;"
NSQ_SOURCE_LINE 00000298 "            my $colnum = -1;"
NSQ_SOURCE_LINE 00000299 "            my $separator_type = do {"
NSQ_SOURCE_LINE 00000300 "                my $cmp = $header_row-1 <=> $rownum;"
NSQ_SOURCE_LINE 00000301 "                # 0=none, 2=separator between header/data, 4=separator between"
NSQ_SOURCE_LINE 00000302 "                # data rows, 8=separator between header rows. this is from"
NSQ_SOURCE_LINE 00000303 "                # BorderStyle standard."
NSQ_SOURCE_LINE 00000304 "                $cmp==0 ? 2 : $cmp==1 ? 8 : 4;"
NSQ_SOURCE_LINE 00000305 "            };"
NSQ_SOURCE_LINE 00000306 "            $exptable->[$rownum] //= [];"
NSQ_SOURCE_LINE 00000307 "            push @{ $exptable->[$rownum] }, undef"
NSQ_SOURCE_LINE 00000308 "                if (@{ $exptable->[$rownum] } == 0 ||"
NSQ_SOURCE_LINE 00000309 "                defined($exptable->[$rownum][-1]));"
NSQ_SOURCE_LINE 00000310 "            #use DDC; say \"D:exptable->[$rownum] = \", DDC::dump($exptable->[$rownum]);"
NSQ_SOURCE_LINE 00000311 "            my $exptable_colnum = firstidx {!defined} @{ $exptable->[$rownum] };"
NSQ_SOURCE_LINE 00000312 "            #say \"D:rownum=$rownum, exptable_colnum=$exptable_colnum\";"
NSQ_SOURCE_LINE 00000313 "            if ($exptable_colnum == -1) { $exptable_colnum = 0 }"
NSQ_SOURCE_LINE 00000314 "            $exptable_bottom_borders->[$rownum] //= $args{separate_rows} ? $separator_type : 0;"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "            for my $cell (@$row) {"
NSQ_SOURCE_LINE 00000317 "                $colnum++;"
NSQ_SOURCE_LINE 00000318 "                my $text;"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "                my $rowspan = 1;"
NSQ_SOURCE_LINE 00000321 "                my $colspan = 1;"
NSQ_SOURCE_LINE 00000322 "                if (ref $cell eq 'HASH') {"
NSQ_SOURCE_LINE 00000323 "                    $text = $cell->{text};"
NSQ_SOURCE_LINE 00000324 "                    $rowspan = $cell->{rowspan} if $cell->{rowspan};"
NSQ_SOURCE_LINE 00000325 "                    $colspan = $cell->{colspan} if $cell->{colspan};"
NSQ_SOURCE_LINE 00000326 "                } else {"
NSQ_SOURCE_LINE 00000327 "                    $text = $cell;"
