NSQ_SOURCE_LINE 00001016 "=item * speed"
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "Subjective speed rating, relative to other text table modules."
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "Value: \"slow\"."
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "=back"
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "For more details on module features, see L<Module::Features>."
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "=head1 PER-ROW ATTRIBUTES"
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "=over"
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "=item * align"
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "String. Value is either C<\"left\">, C<\"middle\">, C<\"right\">. Specify text"
NSQ_SOURCE_LINE 00001033 "alignment of cells. Override table argument, but is overridden by per-column or"
NSQ_SOURCE_LINE 00001034 "per-cell attribute of the same name."
NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "=item * valign"
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "String. Value is either C<\"top\">, C<\"middle\">, C<\"bottom\">. Specify vertical"
NSQ_SOURCE_LINE 00001039 "text alignment of cells. Override table argument, but is overridden by"
NSQ_SOURCE_LINE 00001040 "per-column or per-cell attribute of the same name."
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "=item * bottom_border"
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 "Boolean."
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "=item * top_border"
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "Boolean."
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "=item * lpad"
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "Integer."
NSQ_SOURCE_LINE 00001053 ""
NSQ_SOURCE_LINE 00001054 "=item * rpad"
NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 "Integer."
NSQ_SOURCE_LINE 00001057 ""
NSQ_SOURCE_LINE 00001058 "=item * hpad"
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "Integer."
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "=item * tpad"
NSQ_SOURCE_LINE 00001063 ""
NSQ_SOURCE_LINE 00001064 "Integer."
NSQ_SOURCE_LINE 00001065 ""
NSQ_SOURCE_LINE 00001066 "=item * bpad"
NSQ_SOURCE_LINE 00001067 ""
NSQ_SOURCE_LINE 00001068 "Integer."
NSQ_SOURCE_LINE 00001069 ""
NSQ_SOURCE_LINE 00001070 "=item * vpad"
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "Integer."
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 "=back"
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 "=head1 PER-COLUMN ATTRIBUTES"
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 "=over"
NSQ_SOURCE_LINE 00001079 ""
NSQ_SOURCE_LINE 00001080 "=item * align"
