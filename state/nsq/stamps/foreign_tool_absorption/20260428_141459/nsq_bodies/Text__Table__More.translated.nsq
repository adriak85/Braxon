NSQ_SOURCE_LINE 00001391 "=head1 BUGS"
NSQ_SOURCE_LINE 00001392 ""
NSQ_SOURCE_LINE 00001393 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=Text-Table-More>"
NSQ_SOURCE_LINE 00001394 ""
