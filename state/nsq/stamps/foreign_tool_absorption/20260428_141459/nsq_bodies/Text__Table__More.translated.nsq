NSQ_SOURCE_LINE 00000598 "                                    if (_exptable_cell_is_rowspan_tail($cell_rightbottom)) {"
NSQ_SOURCE_LINE 00000599 "                                        $char = $b_dataorheaderrowbetwcol;"
NSQ_SOURCE_LINE 00000600 "                                    } else {"
NSQ_SOURCE_LINE 00000601 "                                        $char = $b_betwrowbetwcol_noleft;"
NSQ_SOURCE_LINE 00000602 "                                    }"
NSQ_SOURCE_LINE 00000603 "                                } elsif (_exptable_cell_is_rowspan_tail($cell_rightbottom)) {"
NSQ_SOURCE_LINE 00000604 "                                    $char = $b_betwrowbetwcol_noright;"
NSQ_SOURCE_LINE 00000605 "                                } else {"
NSQ_SOURCE_LINE 00000606 "                                    $char = $b_betwrowbetwcol;"
NSQ_SOURCE_LINE 00000607 "                                }"
NSQ_SOURCE_LINE 00000608 "                            }"
NSQ_SOURCE_LINE 00000609 "                        }"
NSQ_SOURCE_LINE 00000610 "                    }"
NSQ_SOURCE_LINE 00000611 "                    $buf[$y][$ic*4+4] = $char;"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "                }"
NSQ_SOURCE_LINE 00000614 "                $y++;"
NSQ_SOURCE_LINE 00000615 "            } # DRAW_ROW_SEPARATOR"
NSQ_SOURCE_LINE 00000616 "            delete $gbcargs{for_header_data_separator};"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "          DRAW_BOTTOM_BORDER:"
NSQ_SOURCE_LINE 00000619 "            {"
NSQ_SOURCE_LINE 00000620 "                last unless $ir == $M-1;"
NSQ_SOURCE_LINE 00000621 "                my $b_botleft    = $bs_obj->get_border_char(char=>'ru_b', %gbcargs);"
NSQ_SOURCE_LINE 00000622 "                my $b_botline    = $bs_obj->get_border_char(char=>'h_b', %gbcargs);"
NSQ_SOURCE_LINE 00000623 "                my $b_botbetwcol = $bs_obj->get_border_char(char=>'hu_b', %gbcargs);"
NSQ_SOURCE_LINE 00000624 "                my $b_botright   = $bs_obj->get_border_char(char=>'lu_b', %gbcargs);"
NSQ_SOURCE_LINE 00000625 "                last unless length $b_botleft || length $b_botline || length $b_botbetwcol || length $b_botright;"
NSQ_SOURCE_LINE 00000626 "                $buf[$y][0] = $b_botleft;"
NSQ_SOURCE_LINE 00000627 "                for my $ic (0..$N-1) {"
NSQ_SOURCE_LINE 00000628 "                    my $cell_right = $ic < $N-1 ? $exptable->[$ir][$ic+1] : undef;"
NSQ_SOURCE_LINE 00000629 "                    $buf[$y][$ic*4+2] = $bs_obj->get_border_char(char=>'h_b', repeat=>$exptable_column_widths->[$ic], %gbcargs);"
NSQ_SOURCE_LINE 00000630 "                    $buf[$y][$ic*4+4] = $ic == $N-1 ? $b_botright : (_exptable_cell_is_colspan_tail($cell_right) ? $b_botline : $b_botbetwcol);"
NSQ_SOURCE_LINE 00000631 "                }"
NSQ_SOURCE_LINE 00000632 "                $y++;"
NSQ_SOURCE_LINE 00000633 "            } # DRAW_BOTTOM_BORDER"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "        }"
NSQ_SOURCE_LINE 00000636 "    } # DRAW_EXPTABLE"
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "    for my $row (@buf) { for (@$row) { $_ = \"\" if !defined($_) } } # debug. remove undef to \"\" to save dump width"
NSQ_SOURCE_LINE 00000639 "    #use DDC; dd \\@buf;"
NSQ_SOURCE_LINE 00000640 "    join \"\", (map { my $linebuf = $_; join(\"\", grep {defined} @$linebuf).\"\\n\" } @buf);"
NSQ_SOURCE_LINE 00000641 "}"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "# Back-compat: 'table' is an alias for 'generate_table', but isn't exported"
NSQ_SOURCE_LINE 00000644 "{"
NSQ_SOURCE_LINE 00000645 "    no warnings 'once';"
NSQ_SOURCE_LINE 00000646 "    *table = \\&generate_table;"
NSQ_SOURCE_LINE 00000647 "}"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "1;"
NSQ_SOURCE_LINE 00000650 "# ABSTRACT: Generate text table with simple interface and many options"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "__END__"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "=pod"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "=head1 NAME"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "Text::Table::More - Generate text table with simple interface and many options"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "=head1 VERSION"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "This document describes version 0.025 of Text::Table::More (from Perl distribution Text-Table-More), released on 2022-03-27."
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 " #!perl"
NSQ_SOURCE_LINE 00000669 " "
NSQ_SOURCE_LINE 00000670 " use 5.010001;"
NSQ_SOURCE_LINE 00000671 " use strict;"
NSQ_SOURCE_LINE 00000672 " use warnings;"
NSQ_SOURCE_LINE 00000673 " "
NSQ_SOURCE_LINE 00000674 " use Text::Table::More qw/generate_table/;"
NSQ_SOURCE_LINE 00000675 " "
NSQ_SOURCE_LINE 00000676 " my $rows = ["
NSQ_SOURCE_LINE 00000677 "     # header row"
NSQ_SOURCE_LINE 00000678 "     [\"Year\","
NSQ_SOURCE_LINE 00000679 "      \"Comedy\","
NSQ_SOURCE_LINE 00000680 "      \"Drama\","
NSQ_SOURCE_LINE 00000681 "      \"Variety\","
NSQ_SOURCE_LINE 00000682 "      \"Lead Comedy Actor\","
NSQ_SOURCE_LINE 00000683 "      \"Lead Drama Actor\","
NSQ_SOURCE_LINE 00000684 "      \"Lead Comedy Actress\","
NSQ_SOURCE_LINE 00000685 "      \"Lead Drama Actress\"],"
NSQ_SOURCE_LINE 00000686 " "
NSQ_SOURCE_LINE 00000687 "     # first data row"
NSQ_SOURCE_LINE 00000688 "     [1962,"
NSQ_SOURCE_LINE 00000689 "      \"The Bob Newhart Show (NBC)\","
NSQ_SOURCE_LINE 00000690 "      {text=>\"The Defenders (CBS)\", rowspan=>3}, # each cell can be hashref to specify text (content) as well as attributes"
NSQ_SOURCE_LINE 00000691 "      \"The Garry Moore Show (CBS)\","
NSQ_SOURCE_LINE 00000692 "      {text=>\"E. G. Marshall, The Defenders (CBS)\", rowspan=>2, colspan=>2},"
NSQ_SOURCE_LINE 00000693 "      {text=>\"Shirley Booth, Hazel (NBC)\", rowspan=>2, colspan=>2}],"
NSQ_SOURCE_LINE 00000694 " "
NSQ_SOURCE_LINE 00000695 "     # second data row"
NSQ_SOURCE_LINE 00000696 "     [1963,"
NSQ_SOURCE_LINE 00000697 "      {text=>\"The Dick Van Dyke Show (CBS)\", rowspan=>2},"
NSQ_SOURCE_LINE 00000698 "      \"The Andy Williams Show (NBC)\"],"
NSQ_SOURCE_LINE 00000699 " "
NSQ_SOURCE_LINE 00000700 "     # third data row"
NSQ_SOURCE_LINE 00000701 "     [1964,"
NSQ_SOURCE_LINE 00000702 "      \"The Danny Kaye Show (CBS)\","
NSQ_SOURCE_LINE 00000703 "      {text=>\"Dick Van Dyke, The Dick Van Dyke Show (CBS)\", colspan=>2},"
NSQ_SOURCE_LINE 00000704 "      {text=>\"Mary Tyler Moore, The Dick Van Dyke Show (CBS)\", colspan=>2}],"
NSQ_SOURCE_LINE 00000705 " "
NSQ_SOURCE_LINE 00000706 "     # fourth data row"
NSQ_SOURCE_LINE 00000707 "     [1965,"
NSQ_SOURCE_LINE 00000708 "      {text=>\"four winners (Outstanding Program Achievements in Entertainment)\", colspan=>3},"
NSQ_SOURCE_LINE 00000709 "      {text=>\"five winners (Outstanding Program Achievements in Entertainment)\", colspan=>4}],"
NSQ_SOURCE_LINE 00000710 " "
NSQ_SOURCE_LINE 00000711 "     # fifth data row"
NSQ_SOURCE_LINE 00000712 "     [1966,"
NSQ_SOURCE_LINE 00000713 "      \"The Dick Van Dyke Show (CBS)\","
NSQ_SOURCE_LINE 00000714 "      \"The Fugitive (ABC)\","
NSQ_SOURCE_LINE 00000715 "      \"The Andy Williams Show (NBC)\","
NSQ_SOURCE_LINE 00000716 "      \"Dick Van Dyke, The Dick Van Dyke Show (CBS)\","
NSQ_SOURCE_LINE 00000717 "      \"Bill Cosby, I Spy (CBS)\","
NSQ_SOURCE_LINE 00000718 "      \"Mary Tyler Moore, The Dick Van Dyke Show (CBS)\","
NSQ_SOURCE_LINE 00000719 "      \"Barbara Stanwyck, The Big Valley (CBS)\"],"
NSQ_SOURCE_LINE 00000720 " ];"
NSQ_SOURCE_LINE 00000721 " "
NSQ_SOURCE_LINE 00000722 " binmode STDOUT, \"utf8\";"
NSQ_SOURCE_LINE 00000723 " print generate_table("
NSQ_SOURCE_LINE 00000724 "     rows => $rows,      # required"
NSQ_SOURCE_LINE 00000725 "     header_row => 1,    # optional, default 0"
NSQ_SOURCE_LINE 00000726 "     separate_rows => 1, # optional, default 0"
NSQ_SOURCE_LINE 00000727 "     border_style => $ARGV[0] // 'ASCII::SingleLineDoubleAfterHeader', # optional, this is module name in BorderStyle::* namespace, without the prefix"
NSQ_SOURCE_LINE 00000728 "     #align => 'left',   # optional, default 'left'. can be left/middle/right."
NSQ_SOURCE_LINE 00000729 "     #valign => 'top',   # optional, default 'top'. can be top/middle/bottom."
NSQ_SOURCE_LINE 00000730 "     #color => 1,        # optional, default 0. turn on support for cell content that contain ANSI color codes."
NSQ_SOURCE_LINE 00000731 "     #wide_char => 1,    # optional, default 0. turn on support for wide Unicode characters."
NSQ_SOURCE_LINE 00000732 " "
NSQ_SOURCE_LINE 00000733 "     row_attrs => [      # optional, specify per-row attributes"
NSQ_SOURCE_LINE 00000734 "         # rownum (0-based int), attributes (hashref)"
NSQ_SOURCE_LINE 00000735 "         [0, {align=>'middle', bottom_border=>1}],"
NSQ_SOURCE_LINE 00000736 "     ],"
NSQ_SOURCE_LINE 00000737 " "
NSQ_SOURCE_LINE 00000738 "     col_attrs => [      # optional, per-column attributes"
NSQ_SOURCE_LINE 00000739 "         # colnum (0-based int), attributes (hashref)"
NSQ_SOURCE_LINE 00000740 "         [2, {valign=>'middle'}],"
NSQ_SOURCE_LINE 00000741 "     ],"
NSQ_SOURCE_LINE 00000742 " "
NSQ_SOURCE_LINE 00000743 "     #cell_attrs => [    # optional, per-cell attributes"
NSQ_SOURCE_LINE 00000744 "     #    # rownum (0-based int), colnum (0-based int), attributes (hashref)"
NSQ_SOURCE_LINE 00000745 "     #    [1, 2, {rowspan=>3}],"
NSQ_SOURCE_LINE 00000746 "     #    [1, 4, {rowspan=>2, colspan=>2}],"
NSQ_SOURCE_LINE 00000747 "     #    [1, 5, {rowspan=>2, colspan=>2}],"
NSQ_SOURCE_LINE 00000748 "     #    [2, 1, {rowspan=>2}],"
NSQ_SOURCE_LINE 00000749 "     #    [3, 2, {colspan=>2}],"
NSQ_SOURCE_LINE 00000750 "     #    [3, 3, {colspan=>2}],"
NSQ_SOURCE_LINE 00000751 "     #    [4, 1, {colspan=>3}],"
NSQ_SOURCE_LINE 00000752 "     #    [4, 2, {colspan=>4}],"
NSQ_SOURCE_LINE 00000753 "     #],"
NSQ_SOURCE_LINE 00000754 " "
NSQ_SOURCE_LINE 00000755 " );"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "will output something like:"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 " .------+------------------------------+----------------------+------------------------------+---------------------------------------------+-------------------------+------------------------------------------------+----------------------------------------."
NSQ_SOURCE_LINE 00000760 " | Year |            Comedy            |        Drama         |           Variety            |              Lead Comedy Actor              |    Lead Drama Actor     |              Lead Comedy Actress               |           Lead Drama Actress           |"
NSQ_SOURCE_LINE 00000761 " +======+==============================+======================+==============================+=============================================+=========================+================================================+========================================+"
NSQ_SOURCE_LINE 00000762 " | 1962 | The Bob Newhart Show (NBC)   |                      | The Garry Moore Show (CBS)   | E. G. Marshall, The Defenders (CBS)                                   | Shirley Booth, Hazel (NBC)                                                              |"
NSQ_SOURCE_LINE 00000763 " +------+------------------------------+                      +------------------------------+                                                                       |                                                                                         |"
NSQ_SOURCE_LINE 00000764 " | 1963 | The Dick Van Dyke Show (CBS) | The Defenders (CBS)  | The Andy Williams Show (NBC) |                                                                       |                                                                                         |"
NSQ_SOURCE_LINE 00000765 " +------+                              |                      +------------------------------+---------------------------------------------|-------------------------+------------------------------------------------|----------------------------------------+"
NSQ_SOURCE_LINE 00000766 " | 1964 |                              |                      | The Danny Kaye Show (CBS)    | Dick Van Dyke, The Dick Van Dyke Show (CBS)                           | Mary Tyler Moore, The Dick Van Dyke Show (CBS)                                          |"
NSQ_SOURCE_LINE 00000767 " +------+------------------------------+----------------------+------------------------------+---------------------------------------------|-------------------------+------------------------------------------------|----------------------------------------+"
NSQ_SOURCE_LINE 00000768 " | 1965 | four winners (Outstanding Program Achievements in Entertainment)                   | five winners (Outstanding Program Achievements in Entertainment)                                                                                                |"
NSQ_SOURCE_LINE 00000769 " +------+------------------------------+----------------------+------------------------------+---------------------------------------------+-------------------------+------------------------------------------------+----------------------------------------+"
NSQ_SOURCE_LINE 00000770 " | 1966 | The Dick Van Dyke Show (CBS) | The Fugitive (ABC)   | The Andy Williams Show (NBC) | Dick Van Dyke, The Dick Van Dyke Show (CBS) | Bill Cosby, I Spy (CBS) | Mary Tyler Moore, The Dick Van Dyke Show (CBS) | Barbara Stanwyck, The Big Valley (CBS) |"
NSQ_SOURCE_LINE 00000771 " `------+------------------------------+----------------------+------------------------------+---------------------------------------------+-------------------------+------------------------------------------------+----------------------------------------'"
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "If you set the C<border_style> argument to C<\"UTF8::SingleLineBoldHeader\">:"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 " print generate_table("
NSQ_SOURCE_LINE 00000776 "     rows => $rows,"
NSQ_SOURCE_LINE 00000777 "     border_style => \"UTF8::SingleLineBoldHeader\","
NSQ_SOURCE_LINE 00000778 "     ..."
NSQ_SOURCE_LINE 00000779 " );"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "then the output will be something like:"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 " ┏━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
NSQ_SOURCE_LINE 00000784 " ┃ Year ┃            Comedy            ┃        Drama         ┃           Variety            ┃              Lead Comedy Actor              ┃    Lead Drama Actor     ┃              Lead Comedy Actress               ┃           Lead Drama Actress           ┃"
NSQ_SOURCE_LINE 00000785 " ┡━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┩"
NSQ_SOURCE_LINE 00000786 " │ 1962 │ The Bob Newhart Show (NBC)   │                      │ The Garry Moore Show (CBS)   │ E. G. Marshall, The Defenders (CBS)                                   │ Shirley Booth, Hazel (NBC)                                                              │"
NSQ_SOURCE_LINE 00000787 " ├──────┼──────────────────────────────┤                      ├──────────────────────────────┤                                                                       │                                                                                         │"
NSQ_SOURCE_LINE 00000788 " │ 1963 │ The Dick Van Dyke Show (CBS) │ The Defenders (CBS)  │ The Andy Williams Show (NBC) │                                                                       │                                                                                         │"
NSQ_SOURCE_LINE 00000789 " ├──────┤                              │                      ├──────────────────────────────┼─────────────────────────────────────────────│─────────────────────────┼────────────────────────────────────────────────│────────────────────────────────────────┤"
NSQ_SOURCE_LINE 00000790 " │ 1964 │                              │                      │ The Danny Kaye Show (CBS)    │ Dick Van Dyke, The Dick Van Dyke Show (CBS)                           │ Mary Tyler Moore, The Dick Van Dyke Show (CBS)                                          │"
NSQ_SOURCE_LINE 00000791 " ├──────┼──────────────────────────────┴──────────────────────┴──────────────────────────────┼─────────────────────────────────────────────│─────────────────────────┴────────────────────────────────────────────────│────────────────────────────────────────┤"
NSQ_SOURCE_LINE 00000792 " │ 1965 │ four winners (Outstanding Program Achievements in Entertainment)                   │ five winners (Outstanding Program Achievements in Entertainment)                                                                                                │"
NSQ_SOURCE_LINE 00000793 " ├──────┼──────────────────────────────┬──────────────────────┬──────────────────────────────┼─────────────────────────────────────────────┬─────────────────────────┬────────────────────────────────────────────────┬────────────────────────────────────────┤"
NSQ_SOURCE_LINE 00000794 " │ 1966 │ The Dick Van Dyke Show (CBS) │ The Fugitive (ABC)   │ The Andy Williams Show (NBC) │ Dick Van Dyke, The Dick Van Dyke Show (CBS) │ Bill Cosby, I Spy (CBS) │ Mary Tyler Moore, The Dick Van Dyke Show (CBS) │ Barbara Stanwyck, The Big Valley (CBS) │"
NSQ_SOURCE_LINE 00000795 " └──────┴──────────────────────────────┴──────────────────────┴──────────────────────────────┴─────────────────────────────────────────────┴─────────────────────────┴────────────────────────────────────────────────┴────────────────────────────────────────┘"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "Text::Table::More is yet another text table rendering module. This module uses"
NSQ_SOURCE_LINE 00000800 "the simple interface of L<Text::Table::Tiny> with support for more formatting"
NSQ_SOURCE_LINE 00000801 "options like column/row spans, border style, per-row/column/cell"
NSQ_SOURCE_LINE 00000802 "align/valign/pad/vpad/hpad, and so on. At the time of this writing,"
NSQ_SOURCE_LINE 00000803 "Text::Table::More is the only text table module on CPAN that supports"
NSQ_SOURCE_LINE 00000804 "rowspans/colspans."
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "Keywords: rowspan, colspan."
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "=for Pod::Coverage ^(.+)$"
NSQ_SOURCE_LINE 00000809 ""
