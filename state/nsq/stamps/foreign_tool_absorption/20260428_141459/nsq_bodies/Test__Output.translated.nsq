NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=item B<stderr_like>"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=item B<stderr_unlike>"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "   stderr_like  ( $coderef, qr/$expected/, 'description' );"
