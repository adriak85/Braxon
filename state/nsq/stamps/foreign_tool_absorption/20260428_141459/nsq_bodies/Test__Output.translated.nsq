NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=head2 COMBINED OUTPUT"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "=over 4"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "=item B<combined_is>"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=item B<combined_isnt>"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "   combined_is   ( $coderef, $expected, 'description' );"
NSQ_SOURCE_LINE 00000360 "   combined_is   {... } $expected, 'description';"
NSQ_SOURCE_LINE 00000361 "   combined_isnt ( $coderef, $expected, 'description' );"
NSQ_SOURCE_LINE 00000362 "   combined_isnt {... } $expected, 'description';"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "C<combined_is()> directs C<STDERR> to C<STDOUT> then captures C<STDOUT>. This is"
NSQ_SOURCE_LINE 00000365 "equivalent to UNIXs C<< 2>&1 >>. The test passes if the combined C<STDOUT>"
NSQ_SOURCE_LINE 00000366 "and C<STDERR> from $coderef equals $expected."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "C<combined_isnt()> passes if combined C<STDOUT> and C<STDERR> are not equal"
NSQ_SOURCE_LINE 00000369 "to C<$expected>."
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=cut"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "sub combined_is (&$;$$) {"
NSQ_SOURCE_LINE 00000374 "  my $test        = shift;"
NSQ_SOURCE_LINE 00000375 "  my $expected    = shift;"
NSQ_SOURCE_LINE 00000376 "  my $options     = shift if ( ref( $_[0] ) );"
NSQ_SOURCE_LINE 00000377 "  my $description = shift;"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "  my $combined = combined_from($test);"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "  my $ok = ( $combined eq $expected );"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "  $Test->ok( $ok, $description )"
NSQ_SOURCE_LINE 00000384 "    || $Test->diag("
NSQ_SOURCE_LINE 00000385 "    \"STDOUT & STDERR are:\\n$combined\\nnot:\\n$expected\\nas expected\");"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "  return $ok;"
NSQ_SOURCE_LINE 00000388 "}"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "sub combined_isnt (&$;$$) {"
NSQ_SOURCE_LINE 00000391 "  my $test        = shift;"
NSQ_SOURCE_LINE 00000392 "  my $expected    = shift;"
NSQ_SOURCE_LINE 00000393 "  my $options     = shift if ( ref( $_[0] ) );"
NSQ_SOURCE_LINE 00000394 "  my $description = shift;"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "  my $combined = combined_from($test);"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "  my $ok = ( $combined ne $expected );"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "  $Test->ok( $ok, $description )"
NSQ_SOURCE_LINE 00000401 "    || $Test->diag("
NSQ_SOURCE_LINE 00000402 "    \"STDOUT & STDERR:\\n$combined\\nmatching:\\n$expected\\nnot expected\");"
