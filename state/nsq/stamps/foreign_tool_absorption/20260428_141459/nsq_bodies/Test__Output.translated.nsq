NSQ_SOURCE_LINE 00000070 "=encoding utf8"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=head1 NAME"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "Test::Output - Utilities to test STDOUT and STDERR messages."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=cut"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "our $VERSION = '1.036';"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    use Test::More tests => 4;"
NSQ_SOURCE_LINE 00000083 "    use Test::Output;"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    sub writer {"
NSQ_SOURCE_LINE 00000086 "      print \"Write out.\\n\";"
NSQ_SOURCE_LINE 00000087 "      print STDERR \"Error out.\\n\";"
NSQ_SOURCE_LINE 00000088 "    }"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    stdout_is(\\&writer,\"Write out.\\n\",'Test STDOUT');"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    stderr_isnt(\\&writer,\"No error out.\\n\",'Test STDERR');"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    combined_is("
NSQ_SOURCE_LINE 00000095 "                \\&writer,"
NSQ_SOURCE_LINE 00000096 "                \"Write out.\\nError out.\\n\","
NSQ_SOURCE_LINE 00000097 "                'Test STDOUT & STDERR combined'"
NSQ_SOURCE_LINE 00000098 "               );"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    output_is("
NSQ_SOURCE_LINE 00000101 "              \\&writer,"
NSQ_SOURCE_LINE 00000102 "              \"Write out.\\n\","
NSQ_SOURCE_LINE 00000103 "              \"Error out.\\n\","
NSQ_SOURCE_LINE 00000104 "              'Test STDOUT & STDERR'"
NSQ_SOURCE_LINE 00000105 "            );"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "   # Use bare blocks."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "   stdout_is { print \"test\" } \"test\", \"Test STDOUT\";"
NSQ_SOURCE_LINE 00000110 "   stderr_isnt { print \"bad test\" } \"test\", \"Test STDERR\";"
NSQ_SOURCE_LINE 00000111 "   output_is { print 'STDOUT'; print STDERR 'STDERR' }"
NSQ_SOURCE_LINE 00000112 "     \"STDOUT\", \"STDERR\", \"Test output\";"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "Test::Output provides a simple interface for testing output sent to C<STDOUT>"
NSQ_SOURCE_LINE 00000117 "or C<STDERR>. A number of different utilities are included to try and be as"
NSQ_SOURCE_LINE 00000118 "flexible as possible to the tester."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "Likewise, L<Capture::Tiny> provides a much more robust capture mechanism without"
NSQ_SOURCE_LINE 00000121 "than the original L<Test::Output::Tie>."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=cut"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 TESTS"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=cut"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "=head2 STDOUT"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=over 4"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=item B<stdout_is>"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=item B<stdout_isnt>"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "   stdout_is  ( $coderef, $expected, 'description' );"
NSQ_SOURCE_LINE 00000138 "   stdout_is    { ... } $expected, 'description';"
NSQ_SOURCE_LINE 00000139 "   stdout_isnt( $coderef, $expected, 'description' );"
NSQ_SOURCE_LINE 00000140 "   stdout_isnt  { ... } $expected, 'description';"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "C<stdout_is()> captures output sent to C<STDOUT> from C<$coderef> and compares"
NSQ_SOURCE_LINE 00000143 "it against C<$expected>. The test passes if equal."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "C<stdout_isnt()> passes if C<STDOUT> is not equal to C<$expected>."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=cut"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "sub stdout_is (&$;$$) {"
NSQ_SOURCE_LINE 00000150 "  my $test        = shift;"
NSQ_SOURCE_LINE 00000151 "  my $expected    = shift;"
NSQ_SOURCE_LINE 00000152 "  my $options     = shift if ( ref( $_[0] ) );"
NSQ_SOURCE_LINE 00000153 "  my $description = shift;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "  my $stdout = stdout_from($test);"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "  my $ok = ( $stdout eq $expected );"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "  $Test->ok( $ok, $description )"
NSQ_SOURCE_LINE 00000160 "    || $Test->diag(\"STDOUT is:\\n$stdout\\nnot:\\n$expected\\nas expected\");"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "  return $ok;"
NSQ_SOURCE_LINE 00000163 "}"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "sub stdout_isnt (&$;$$) {"
NSQ_SOURCE_LINE 00000166 "  my $test        = shift;"
NSQ_SOURCE_LINE 00000167 "  my $expected    = shift;"
NSQ_SOURCE_LINE 00000168 "  my $options     = shift if ( ref( $_[0] ) );"
NSQ_SOURCE_LINE 00000169 "  my $description = shift;"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "  my $stdout = stdout_from($test);"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "  my $ok = ( $stdout ne $expected );"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "  $Test->ok( $ok, $description )"
NSQ_SOURCE_LINE 00000176 "    || $Test->diag(\"STDOUT:\\n$stdout\\nmatching:\\n$expected\\nnot expected\");"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "  return $ok;"
NSQ_SOURCE_LINE 00000179 "}"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=item B<stdout_like>"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=item B<stdout_unlike>"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "   stdout_like  ( $coderef, qr/$expected/, 'description' );"
NSQ_SOURCE_LINE 00000186 "   stdout_like    { ... } qr/$expected/, 'description';"
NSQ_SOURCE_LINE 00000187 "   stdout_unlike( $coderef, qr/$expected/, 'description' );"
NSQ_SOURCE_LINE 00000188 "   stdout_unlike  { ... } qr/$expected/, 'description';"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "C<stdout_like()> captures the output sent to C<STDOUT> from C<$coderef> and compares"
NSQ_SOURCE_LINE 00000191 "it to the regex in C<$expected>. The test passes if the regex matches."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "C<stdout_unlike()> passes if STDOUT does not match the regex."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=back"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "=cut"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "sub stdout_like (&$;$$) {"
NSQ_SOURCE_LINE 00000200 "  my $test        = shift;"
NSQ_SOURCE_LINE 00000201 "  my $expected    = shift;"
NSQ_SOURCE_LINE 00000202 "  my $options     = shift if ( ref( $_[0] ) );"
NSQ_SOURCE_LINE 00000203 "  my $description = shift;"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "  unless ( my $regextest = _chkregex( 'stdout_like' => $expected ) ) {"
NSQ_SOURCE_LINE 00000206 "    return $regextest;"
NSQ_SOURCE_LINE 00000207 "  }"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "  my $stdout = stdout_from($test);"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "  my $ok = ( $stdout =~ $expected );"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "  $Test->ok( $ok, $description )"
NSQ_SOURCE_LINE 00000214 "    || $Test->diag(\"STDOUT:\\n$stdout\\ndoesn't match:\\n$expected\\nas expected\");"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "  return $ok;"
NSQ_SOURCE_LINE 00000217 "}"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "sub stdout_unlike (&$;$$) {"
NSQ_SOURCE_LINE 00000220 "  my $test        = shift;"
NSQ_SOURCE_LINE 00000221 "  my $expected    = shift;"
NSQ_SOURCE_LINE 00000222 "  my $options     = shift if ( ref( $_[0] ) );"
NSQ_SOURCE_LINE 00000223 "  my $description = shift;"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "  unless ( my $regextest = _chkregex( 'stdout_unlike' => $expected ) ) {"
NSQ_SOURCE_LINE 00000226 "    return $regextest;"
NSQ_SOURCE_LINE 00000227 "  }"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "  my $stdout = stdout_from($test);"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "  my $ok = ( $stdout !~ $expected );"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "  $Test->ok( $ok, $description )"
NSQ_SOURCE_LINE 00000234 "    || $Test->diag(\"STDOUT:\\n$stdout\\nmatches:\\n$expected\\nnot expected\");"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "  return $ok;"
NSQ_SOURCE_LINE 00000237 "}"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=head2 STDERR"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=over 4"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=item B<stderr_is>"
NSQ_SOURCE_LINE 00000244 ""
