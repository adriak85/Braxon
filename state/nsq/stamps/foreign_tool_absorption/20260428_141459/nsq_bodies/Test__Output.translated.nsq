NSQ_SOURCE_LINE 00000405 "}"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=item B<combined_like>"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "=item B<combined_unlike>"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "   combined_like   ( $coderef, qr/$expected/, 'description' );"
NSQ_SOURCE_LINE 00000412 "   combined_like   { ...} qr/$expected/, 'description';"
NSQ_SOURCE_LINE 00000413 "   combined_unlike ( $coderef, qr/$expected/, 'description' );"
NSQ_SOURCE_LINE 00000414 "   combined_unlike { ...} qr/$expected/, 'description';"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "C<combined_like()> is similar to C<combined_is()> except that it compares a regex"
NSQ_SOURCE_LINE 00000417 "(C<$expected)> to C<STDOUT> and C<STDERR> captured from C<$codref>. The test passes if"
NSQ_SOURCE_LINE 00000418 "the regex matches."
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "C<combined_unlike()> passes if the combined C<STDOUT> and C<STDERR> does not match"
NSQ_SOURCE_LINE 00000421 "the regex."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "=back"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "=cut"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "sub combined_like (&$;$$) {"
NSQ_SOURCE_LINE 00000428 "  my $test        = shift;"
NSQ_SOURCE_LINE 00000429 "  my $expected    = shift;"
NSQ_SOURCE_LINE 00000430 "  my $options     = shift if ( ref( $_[0] ) );"
NSQ_SOURCE_LINE 00000431 "  my $description = shift;"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "  unless ( my $regextest = _chkregex( 'combined_like' => $expected ) ) {"
NSQ_SOURCE_LINE 00000434 "    return $regextest;"
NSQ_SOURCE_LINE 00000435 "  }"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "  my $combined = combined_from($test);"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "  my $ok = ( $combined =~ $expected );"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "  $Test->ok( $ok, $description )"
NSQ_SOURCE_LINE 00000442 "    || $Test->diag("
NSQ_SOURCE_LINE 00000443 "    \"STDOUT & STDERR:\\n$combined\\ndon't match:\\n$expected\\nas expected\");"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "  return $ok;"
NSQ_SOURCE_LINE 00000446 "}"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "sub combined_unlike (&$;$$) {"
NSQ_SOURCE_LINE 00000449 "  my $test        = shift;"
NSQ_SOURCE_LINE 00000450 "  my $expected    = shift;"
NSQ_SOURCE_LINE 00000451 "  my $options     = shift if ( ref( $_[0] ) );"
NSQ_SOURCE_LINE 00000452 "  my $description = shift;"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "  unless ( my $regextest = _chkregex( 'combined_unlike' => $expected ) ) {"
NSQ_SOURCE_LINE 00000455 "    return $regextest;"
NSQ_SOURCE_LINE 00000456 "  }"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "  my $combined = combined_from($test);"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "  my $ok = ( $combined !~ $expected );"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "  $Test->ok( $ok, $description )"
NSQ_SOURCE_LINE 00000463 "    || $Test->diag("
NSQ_SOURCE_LINE 00000464 "    \"STDOUT & STDERR:\\n$combined\\nmatching:\\n$expected\\nnot expected\");"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "  return $ok;"
NSQ_SOURCE_LINE 00000467 "}"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=head2 OUTPUT"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "=over 4"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "=item B<output_is>"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "=item B<output_isnt>"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "   output_is  ( $coderef, $expected_stdout, $expected_stderr, 'description' );"
NSQ_SOURCE_LINE 00000478 "   output_is    {... } $expected_stdout, $expected_stderr, 'description';"
NSQ_SOURCE_LINE 00000479 "   output_isnt( $coderef, $expected_stdout, $expected_stderr, 'description' );"
NSQ_SOURCE_LINE 00000480 "   output_isnt  {... } $expected_stdout, $expected_stderr, 'description';"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "The C<output_is()> function is a combination of the C<stdout_is()> and C<stderr_is()>"
NSQ_SOURCE_LINE 00000483 "functions. For example:"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "  output_is(sub {print \"foo\"; print STDERR \"bar\";},'foo','bar');"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "is functionally equivalent to"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "  stdout_is(sub {print \"foo\";},'foo')"
NSQ_SOURCE_LINE 00000490 "    && stderr_is(sub {print STDERR \"bar\";},'bar');"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "except that C<$coderef> is only executed once."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "Unlike C<stdout_is()> and C<stderr_is()> which ignore STDERR and STDOUT"
NSQ_SOURCE_LINE 00000495 "respectively, C<output_is()> requires both C<STDOUT> and C<STDERR> to match in order"
NSQ_SOURCE_LINE 00000496 "to pass. Setting either C<$expected_stdout> or C<$expected_stderr> to C<undef>"
NSQ_SOURCE_LINE 00000497 "ignores C<STDOUT> or C<STDERR> respectively."
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "  output_is(sub {print \"foo\"; print STDERR \"bar\";},'foo',undef);"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "is the same as"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "  stdout_is(sub {print \"foo\";},'foo')"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "C<output_isnt()> provides the opposite function of C<output_is()>. It is a"
NSQ_SOURCE_LINE 00000506 "combination of C<stdout_isnt()> and C<stderr_isnt()>."
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "  output_isnt(sub {print \"foo\"; print STDERR \"bar\";},'bar','foo');"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "is functionally equivalent to"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "  stdout_isnt(sub {print \"foo\";},'bar')"
NSQ_SOURCE_LINE 00000513 "    && stderr_isnt(sub {print STDERR \"bar\";},'foo');"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "As with C<output_is()>, setting either C<$expected_stdout> or C<$expected_stderr> to"
NSQ_SOURCE_LINE 00000516 "C<undef> ignores the output to that facility."
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "  output_isnt(sub {print \"foo\"; print STDERR \"bar\";},undef,'foo');"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "is the same as"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "  stderr_is(sub {print STDERR \"bar\";},'foo')"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "=cut"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "sub output_is (&$$;$$) {"
NSQ_SOURCE_LINE 00000527 "  my $test        = shift;"
NSQ_SOURCE_LINE 00000528 "  my $expout      = shift;"
NSQ_SOURCE_LINE 00000529 "  my $experr      = shift;"
NSQ_SOURCE_LINE 00000530 "  my $options     = shift if ( ref( $_[0] ) );"
NSQ_SOURCE_LINE 00000531 "  my $description = shift;"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "  my ( $stdout, $stderr ) = output_from($test);"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "  my $ok = 1;"
NSQ_SOURCE_LINE 00000536 "  my $diag;"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "  if ( defined($experr) && defined($expout) ) {"
NSQ_SOURCE_LINE 00000539 "    unless ( $stdout eq $expout ) {"
NSQ_SOURCE_LINE 00000540 "      $ok = 0;"
NSQ_SOURCE_LINE 00000541 "      $diag .= \"STDOUT is:\\n$stdout\\nnot:\\n$expout\\nas expected\";"
NSQ_SOURCE_LINE 00000542 "    }"
NSQ_SOURCE_LINE 00000543 "    unless ( $stderr eq $experr ) {"
NSQ_SOURCE_LINE 00000544 "      $diag .= \"\\n\" unless ($ok);"
NSQ_SOURCE_LINE 00000545 "      $ok = 0;"
NSQ_SOURCE_LINE 00000546 "      $diag .= \"STDERR is:\\n$stderr\\nnot:\\n$experr\\nas expected\";"
NSQ_SOURCE_LINE 00000547 "    }"
NSQ_SOURCE_LINE 00000548 "  }"
NSQ_SOURCE_LINE 00000549 "  elsif ( defined($expout) ) {"
NSQ_SOURCE_LINE 00000550 "    $ok = ( $stdout eq $expout );"
NSQ_SOURCE_LINE 00000551 "    $diag .= \"STDOUT is:\\n$stdout\\nnot:\\n$expout\\nas expected\";"
NSQ_SOURCE_LINE 00000552 "  }"
NSQ_SOURCE_LINE 00000553 "  elsif ( defined($experr) ) {"
NSQ_SOURCE_LINE 00000554 "    $ok = ( $stderr eq $experr );"
NSQ_SOURCE_LINE 00000555 "    $diag .= \"STDERR is:\\n$stderr\\nnot:\\n$experr\\nas expected\";"
NSQ_SOURCE_LINE 00000556 "  }"
NSQ_SOURCE_LINE 00000557 "  else {"
NSQ_SOURCE_LINE 00000558 "    unless ( $stdout eq '' ) {"
NSQ_SOURCE_LINE 00000559 "      $ok = 0;"
NSQ_SOURCE_LINE 00000560 "      $diag .= \"STDOUT is:\\n$stdout\\nnot:\\n\\nas expected\";"
NSQ_SOURCE_LINE 00000561 "    }"
NSQ_SOURCE_LINE 00000562 "    unless ( $stderr eq '' ) {"
NSQ_SOURCE_LINE 00000563 "      $diag .= \"\\n\" unless ($ok);"
NSQ_SOURCE_LINE 00000564 "      $ok = 0;"
NSQ_SOURCE_LINE 00000565 "      $diag .= \"STDERR is:\\n$stderr\\nnot:\\n\\nas expected\";"
NSQ_SOURCE_LINE 00000566 "    }"
NSQ_SOURCE_LINE 00000567 "  }"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "  $Test->ok( $ok, $description ) || $Test->diag($diag);"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "  return $ok;"
NSQ_SOURCE_LINE 00000572 "}"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "sub output_isnt (&$$;$$) {"
NSQ_SOURCE_LINE 00000575 "  my $test        = shift;"
NSQ_SOURCE_LINE 00000576 "  my $expout      = shift;"
NSQ_SOURCE_LINE 00000577 "  my $experr      = shift;"
NSQ_SOURCE_LINE 00000578 "  my $options     = shift if ( ref( $_[0] ) );"
NSQ_SOURCE_LINE 00000579 "  my $description = shift;"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "  my ( $stdout, $stderr ) = output_from($test);"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "  my $ok = 1;"
NSQ_SOURCE_LINE 00000584 "  my $diag;"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "  if ( defined($experr) && defined($expout) ) {"
NSQ_SOURCE_LINE 00000587 "    if ( $stdout eq $expout ) {"
NSQ_SOURCE_LINE 00000588 "      $ok = 0;"
NSQ_SOURCE_LINE 00000589 "      $diag .= \"STDOUT:\\n$stdout\\nmatching:\\n$expout\\nnot expected\";"
NSQ_SOURCE_LINE 00000590 "    }"
NSQ_SOURCE_LINE 00000591 "    if ( $stderr eq $experr ) {"
NSQ_SOURCE_LINE 00000592 "      $diag .= \"\\n\" unless ($ok);"
NSQ_SOURCE_LINE 00000593 "      $ok = 0;"
NSQ_SOURCE_LINE 00000594 "      $diag .= \"STDERR:\\n$stderr\\nmatching:\\n$experr\\nnot expected\";"
NSQ_SOURCE_LINE 00000595 "    }"
NSQ_SOURCE_LINE 00000596 "  }"
NSQ_SOURCE_LINE 00000597 "  elsif ( defined($expout) ) {"
NSQ_SOURCE_LINE 00000598 "    $ok = ( $stdout ne $expout );"
NSQ_SOURCE_LINE 00000599 "    $diag = \"STDOUT:\\n$stdout\\nmatching:\\n$expout\\nnot expected\";"
NSQ_SOURCE_LINE 00000600 "  }"
NSQ_SOURCE_LINE 00000601 "  elsif ( defined($experr) ) {"
NSQ_SOURCE_LINE 00000602 "    $ok = ( $stderr ne $experr );"
NSQ_SOURCE_LINE 00000603 "    $diag = \"STDERR:\\n$stderr\\nmatching:\\n$experr\\nnot expected\";"
NSQ_SOURCE_LINE 00000604 "  }"
NSQ_SOURCE_LINE 00000605 "  else {"
NSQ_SOURCE_LINE 00000606 "    if ( $stdout eq '' ) {"
NSQ_SOURCE_LINE 00000607 "      $ok   = 0;"
NSQ_SOURCE_LINE 00000608 "      $diag = \"STDOUT:\\n$stdout\\nmatching:\\n\\nnot expected\";"
NSQ_SOURCE_LINE 00000609 "    }"
NSQ_SOURCE_LINE 00000610 "    if ( $stderr eq '' ) {"
NSQ_SOURCE_LINE 00000611 "      $diag .= \"\\n\" unless ($ok);"
NSQ_SOURCE_LINE 00000612 "      $ok = 0;"
NSQ_SOURCE_LINE 00000613 "      $diag .= \"STDERR:\\n$stderr\\nmatching:\\n\\nnot expected\";"
NSQ_SOURCE_LINE 00000614 "    }"
NSQ_SOURCE_LINE 00000615 "  }"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "  $Test->ok( $ok, $description ) || $Test->diag($diag);"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "  return $ok;"
NSQ_SOURCE_LINE 00000620 "}"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "=item B<output_like>"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "=item B<output_unlike>"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "  output_like  ( $coderef, $regex_stdout, $regex_stderr, 'description' );"
NSQ_SOURCE_LINE 00000627 "  output_like  { ... } $regex_stdout, $regex_stderr, 'description';"
NSQ_SOURCE_LINE 00000628 "  output_unlike( $coderef, $regex_stdout, $regex_stderr, 'description' );"
NSQ_SOURCE_LINE 00000629 "  output_unlike { ... } $regex_stdout, $regex_stderr, 'description';"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "C<output_like()> and C<output_unlike()> follow the same principles as C<output_is()>"
NSQ_SOURCE_LINE 00000632 "and C<output_isnt()> except they use a regular expression for matching."
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "C<output_like()> attempts to match C<$regex_stdout> and C<$regex_stderr> against"
NSQ_SOURCE_LINE 00000635 "C<STDOUT> and C<STDERR> produced by $coderef. The test passes if both match."
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "  output_like(sub {print \"foo\"; print STDERR \"bar\";},qr/foo/,qr/bar/);"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "The above test is successful."
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "Like C<output_is()>, setting either C<$regex_stdout> or C<$regex_stderr> to"
NSQ_SOURCE_LINE 00000642 "C<undef> ignores the output to that facility."
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "  output_like(sub {print \"foo\"; print STDERR \"bar\";},qr/foo/,undef);"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "is the same as"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "  stdout_like(sub {print \"foo\"; print STDERR \"bar\";},qr/foo/);"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "C<output_unlike()> test pass if output from C<$coderef> doesn't match"
NSQ_SOURCE_LINE 00000651 "C<$regex_stdout> and C<$regex_stderr>."
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "=back"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "=cut"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "sub output_like (&$$;$$) {"
NSQ_SOURCE_LINE 00000658 "  my $test        = shift;"
NSQ_SOURCE_LINE 00000659 "  my $expout      = shift;"
NSQ_SOURCE_LINE 00000660 "  my $experr      = shift;"
NSQ_SOURCE_LINE 00000661 "  my $options     = shift if ( ref( $_[0] ) );"
NSQ_SOURCE_LINE 00000662 "  my $description = shift;"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "  my ( $stdout, $stderr ) = output_from($test);"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "  my $ok = 1;"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "  unless ("
NSQ_SOURCE_LINE 00000669 "    my $regextest = _chkregex("
NSQ_SOURCE_LINE 00000670 "      'output_like_STDERR' => $experr,"
NSQ_SOURCE_LINE 00000671 "      'output_like_STDOUT' => $expout"
NSQ_SOURCE_LINE 00000672 "    )"
NSQ_SOURCE_LINE 00000673 "    )"
NSQ_SOURCE_LINE 00000674 "  {"
NSQ_SOURCE_LINE 00000675 "    return $regextest;"
NSQ_SOURCE_LINE 00000676 "  }"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "  my $diag;"
NSQ_SOURCE_LINE 00000679 "  if ( defined($experr) && defined($expout) ) {"
NSQ_SOURCE_LINE 00000680 "    unless ( $stdout =~ $expout ) {"
NSQ_SOURCE_LINE 00000681 "      $ok = 0;"
NSQ_SOURCE_LINE 00000682 "      $diag .= \"STDOUT:\\n$stdout\\ndoesn't match:\\n$expout\\nas expected\";"
NSQ_SOURCE_LINE 00000683 "    }"
NSQ_SOURCE_LINE 00000684 "    unless ( $stderr =~ $experr ) {"
NSQ_SOURCE_LINE 00000685 "      $diag .= \"\\n\" unless ($ok);"
NSQ_SOURCE_LINE 00000686 "      $ok = 0;"
NSQ_SOURCE_LINE 00000687 "      $diag .= \"STDERR:\\n$stderr\\ndoesn't match:\\n$experr\\nas expected\";"
NSQ_SOURCE_LINE 00000688 "    }"
NSQ_SOURCE_LINE 00000689 "  }"
NSQ_SOURCE_LINE 00000690 "  elsif ( defined($expout) ) {"
NSQ_SOURCE_LINE 00000691 "    $ok = ( $stdout =~ $expout );"
NSQ_SOURCE_LINE 00000692 "    $diag .= \"STDOUT:\\n$stdout\\ndoesn't match:\\n$expout\\nas expected\";"
NSQ_SOURCE_LINE 00000693 "  }"
NSQ_SOURCE_LINE 00000694 "  elsif ( defined($experr) ) {"
NSQ_SOURCE_LINE 00000695 "    $ok = ( $stderr =~ $experr );"
NSQ_SOURCE_LINE 00000696 "    $diag .= \"STDERR:\\n$stderr\\ndoesn't match:\\n$experr\\nas expected\";"
NSQ_SOURCE_LINE 00000697 "  }"
NSQ_SOURCE_LINE 00000698 "  else {"
NSQ_SOURCE_LINE 00000699 "    unless ( $stdout eq '' ) {"
NSQ_SOURCE_LINE 00000700 "      $ok = 0;"
NSQ_SOURCE_LINE 00000701 "      $diag .= \"STDOUT is:\\n$stdout\\nnot:\\n\\nas expected\";"
NSQ_SOURCE_LINE 00000702 "    }"
NSQ_SOURCE_LINE 00000703 "    unless ( $stderr eq '' ) {"
NSQ_SOURCE_LINE 00000704 "      $diag .= \"\\n\" unless ($ok);"
NSQ_SOURCE_LINE 00000705 "      $ok = 0;"
NSQ_SOURCE_LINE 00000706 "      $diag .= \"STDERR is:\\n$stderr\\nnot:\\n\\nas expected\";"
NSQ_SOURCE_LINE 00000707 "    }"
NSQ_SOURCE_LINE 00000708 "  }"
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "  $Test->ok( $ok, $description ) || $Test->diag($diag);"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "  return $ok;"
NSQ_SOURCE_LINE 00000713 "}"
NSQ_SOURCE_LINE 00000714 ""
