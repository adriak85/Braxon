NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "C<stderr_isnt()> passes if C<STDERR> is not equal to C<$expected>."
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=cut"
NSQ_SOURCE_LINE 00000259 ""
