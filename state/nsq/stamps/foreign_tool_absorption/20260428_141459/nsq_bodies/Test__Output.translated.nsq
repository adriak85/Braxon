NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "By default, all subroutines are exported by default."
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "=over 4"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "=item * :stdout - the subs with C<stdout> in the name."
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "=item * :stderr - the subs with C<stderr> in the name."
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "=item * :functions - the subs with C<_from> at the end."
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "=item * :output - the subs with C<output> in the name."
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "=item * :combined - the subs with C<combined> in the name."
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "=item * :tests - everything that outputs TAP"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "=item * :all - everything (which is the same as the default)"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "=back"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "=cut"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "=head2 stdout_from"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "  my $stdout = stdout_from($coderef)"
NSQ_SOURCE_LINE 00000791 "  my $stdout = stdout_from { ... };"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "stdout_from() executes $coderef and captures STDOUT."
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "=cut"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "sub stdout_from (&) {"
NSQ_SOURCE_LINE 00000798 "  my $test = shift;"
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "  my $stdout = capture_stdout {"
NSQ_SOURCE_LINE 00000801 "    select( ( select(STDOUT), $| = 1 )[0] );"
NSQ_SOURCE_LINE 00000802 "    $test->()"
NSQ_SOURCE_LINE 00000803 "  };"
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "  return $stdout;"
NSQ_SOURCE_LINE 00000806 "}"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "=head2 stderr_from"
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "  my $stderr = stderr_from($coderef)"
NSQ_SOURCE_LINE 00000811 "  my $stderr = stderr_from { ... };"
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "C<stderr_from()> executes C<$coderef> and captures C<STDERR>."
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "=cut"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "sub stderr_from (&) {"
NSQ_SOURCE_LINE 00000818 "  my $test = shift;"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "  # XXX why is this here and not in output_from or combined_from -- xdg, 2012-05-13"
NSQ_SOURCE_LINE 00000821 "  local $SIG{__WARN__} = sub { print STDERR @_ }"
NSQ_SOURCE_LINE 00000822 "    if $] < 5.008;"
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "  my $stderr = capture_stderr {"
NSQ_SOURCE_LINE 00000825 "    select( ( select(STDERR), $| = 1 )[0] );"
NSQ_SOURCE_LINE 00000826 "    $test->()"
NSQ_SOURCE_LINE 00000827 "  };"
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "  return $stderr;"
NSQ_SOURCE_LINE 00000830 "}"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "=head2 output_from"
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "  my ($stdout, $stderr) = output_from($coderef)"
NSQ_SOURCE_LINE 00000835 "  my ($stdout, $stderr) = output_from {...};"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "C<output_from()> executes C<$coderef> one time capturing both C<STDOUT> and C<STDERR>."
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "=cut"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "sub output_from (&) {"
NSQ_SOURCE_LINE 00000842 "  my $test = shift;"
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "  my ($stdout, $stderr) = capture {"
NSQ_SOURCE_LINE 00000845 "    select( ( select(STDOUT), $| = 1 )[0] );"
NSQ_SOURCE_LINE 00000846 "    select( ( select(STDERR), $| = 1 )[0] );"
NSQ_SOURCE_LINE 00000847 "    $test->();"
NSQ_SOURCE_LINE 00000848 "  };"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "  return ( $stdout, $stderr );"
NSQ_SOURCE_LINE 00000851 "}"
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "=head2 combined_from"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "  my $combined = combined_from($coderef);"
NSQ_SOURCE_LINE 00000856 "  my $combined = combined_from {...};"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "C<combined_from()> executes C<$coderef> one time combines C<STDOUT> and C<STDERR>, and"
NSQ_SOURCE_LINE 00000859 "captures them. C<combined_from()> is equivalent to using C<< 2>&1 >> in UNIX."
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "=cut"
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "sub combined_from (&) {"
NSQ_SOURCE_LINE 00000864 "  my $test = shift;"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "  my $combined = capture_merged {"
NSQ_SOURCE_LINE 00000867 "    select( ( select(STDOUT), $| = 1 )[0] );"
NSQ_SOURCE_LINE 00000868 "    select( ( select(STDERR), $| = 1 )[0] );"
NSQ_SOURCE_LINE 00000869 "    $test->();"
NSQ_SOURCE_LINE 00000870 "  };"
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "  return $combined;"
NSQ_SOURCE_LINE 00000873 "}"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "sub _chkregex {"
NSQ_SOURCE_LINE 00000876 "  my %regexs = @_;"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "  foreach my $test ( keys(%regexs) ) {"
NSQ_SOURCE_LINE 00000879 "    next unless ( defined( $regexs{$test} ) );"
NSQ_SOURCE_LINE 00000880 ""
NSQ_SOURCE_LINE 00000881 "    my $usable_regex = $Test->maybe_regex( $regexs{$test} );"
NSQ_SOURCE_LINE 00000882 "    unless ( defined($usable_regex) ) {"
NSQ_SOURCE_LINE 00000883 "      my $ok = $Test->ok( 0, $test );"
NSQ_SOURCE_LINE 00000884 ""
NSQ_SOURCE_LINE 00000885 "      $Test->diag(\"'$regexs{$test}' doesn't look much like a regex to me.\");"
NSQ_SOURCE_LINE 00000886 "#       unless $ok;"
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "      return $ok;"
NSQ_SOURCE_LINE 00000889 "    }"
NSQ_SOURCE_LINE 00000890 "  }"
NSQ_SOURCE_LINE 00000891 "  return 1;"
NSQ_SOURCE_LINE 00000892 "}"
