NSQ_SOURCE_LINE 00000274 "=cut"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "package Test::Warn;"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "use 5.006;"
NSQ_SOURCE_LINE 00000280 "use strict;"
NSQ_SOURCE_LINE 00000281 "use warnings;"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "use Sub::Uplevel 0.12;"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "our $VERSION = '0.37';"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "require Exporter;"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "our %EXPORT_TAGS = ( 'all' => [ qw("
NSQ_SOURCE_LINE 00000292 "    @EXPORT\t"
NSQ_SOURCE_LINE 00000293 ") ] );"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "our @EXPORT_OK = ( @{ $EXPORT_TAGS{'all'} } );"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "our @EXPORT = qw("
NSQ_SOURCE_LINE 00000298 "    warning_is   warnings_are"
NSQ_SOURCE_LINE 00000299 "    warning_like warnings_like"
NSQ_SOURCE_LINE 00000300 "    warnings_exist"
NSQ_SOURCE_LINE 00000301 ");"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "use Test::Builder;"
NSQ_SOURCE_LINE 00000304 "my $Tester = Test::Builder->new;"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "{"
NSQ_SOURCE_LINE 00000307 "no warnings 'once';"
NSQ_SOURCE_LINE 00000308 "*warning_is = *warnings_are;"
NSQ_SOURCE_LINE 00000309 "*warning_like = *warnings_like;"
NSQ_SOURCE_LINE 00000310 "}"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "sub warnings_are (&$;$) {"
NSQ_SOURCE_LINE 00000313 "    my $block       = shift;"
NSQ_SOURCE_LINE 00000314 "    my @exp_warning = map {_canonical_exp_warning($_)}"
NSQ_SOURCE_LINE 00000315 "                          _to_array_if_necessary( shift() || [] );"
NSQ_SOURCE_LINE 00000316 "    my $testname    = shift;"
NSQ_SOURCE_LINE 00000317 "    my @got_warning = ();"
NSQ_SOURCE_LINE 00000318 "    local $SIG{__WARN__} = sub {"
NSQ_SOURCE_LINE 00000319 "        my ($called_from) = caller(0);  # to find out Carping methods"
NSQ_SOURCE_LINE 00000320 "        push @got_warning, _canonical_got_warning($called_from, shift());"
NSQ_SOURCE_LINE 00000321 "    };"
NSQ_SOURCE_LINE 00000322 "    uplevel 1,$block;"
NSQ_SOURCE_LINE 00000323 "    my $ok = _cmp_is( \\@got_warning, \\@exp_warning );"
NSQ_SOURCE_LINE 00000324 "    $Tester->ok( $ok, $testname );"
NSQ_SOURCE_LINE 00000325 "    $ok or _diag_found_warning(@got_warning),"
NSQ_SOURCE_LINE 00000326 "           _diag_exp_warning(@exp_warning);"
NSQ_SOURCE_LINE 00000327 "    return $ok;"
NSQ_SOURCE_LINE 00000328 "}"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "sub warnings_like (&$;$) {"
NSQ_SOURCE_LINE 00000332 "    my $block       = shift;"
NSQ_SOURCE_LINE 00000333 "    my @exp_warning = map {_canonical_exp_warning($_)}"
NSQ_SOURCE_LINE 00000334 "                          _to_array_if_necessary( shift() || [] );"
NSQ_SOURCE_LINE 00000335 "    my $testname    = shift;"
NSQ_SOURCE_LINE 00000336 "    my @got_warning = ();"
NSQ_SOURCE_LINE 00000337 "    local $SIG{__WARN__} = sub {"
NSQ_SOURCE_LINE 00000338 "        my ($called_from) = caller(0);  # to find out Carping methods"
NSQ_SOURCE_LINE 00000339 "        push @got_warning, _canonical_got_warning($called_from, shift());"
NSQ_SOURCE_LINE 00000340 "    };"
NSQ_SOURCE_LINE 00000341 "    uplevel 1,$block;"
NSQ_SOURCE_LINE 00000342 "    my $ok = _cmp_like( \\@got_warning, \\@exp_warning );"
NSQ_SOURCE_LINE 00000343 "    $Tester->ok( $ok, $testname );"
NSQ_SOURCE_LINE 00000344 "    $ok or _diag_found_warning(@got_warning),"
NSQ_SOURCE_LINE 00000345 "           _diag_exp_warning(@exp_warning);"
NSQ_SOURCE_LINE 00000346 "    return $ok;"
NSQ_SOURCE_LINE 00000347 "}"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "sub warnings_exist (&$;$) {"
NSQ_SOURCE_LINE 00000350 "    my $block       = shift;"
NSQ_SOURCE_LINE 00000351 "    my @exp_warning = map {_canonical_exp_warning($_)}"
NSQ_SOURCE_LINE 00000352 "                          _to_array_if_necessary( shift() || [] );"
NSQ_SOURCE_LINE 00000353 "    my $testname    = shift;"
NSQ_SOURCE_LINE 00000354 "    my @got_warning = ();"
NSQ_SOURCE_LINE 00000355 "    my $exp_idx = 0;"
NSQ_SOURCE_LINE 00000356 "    local $SIG{__WARN__} = sub {"
NSQ_SOURCE_LINE 00000357 "        my ($called_from) = caller(0);  # to find out Carping methods"
NSQ_SOURCE_LINE 00000358 "        my $wrn_text=shift;"
NSQ_SOURCE_LINE 00000359 "        my $wrn_rec=_canonical_got_warning($called_from, $wrn_text);"
NSQ_SOURCE_LINE 00000360 "        if ("
NSQ_SOURCE_LINE 00000361 "          $exp_idx < @exp_warning and"
NSQ_SOURCE_LINE 00000362 "          _cmp_got_to_exp_warning_like($wrn_rec,$exp_warning[$exp_idx])"
NSQ_SOURCE_LINE 00000363 "        ) {"
NSQ_SOURCE_LINE 00000364 "          push @got_warning, $wrn_rec;"
NSQ_SOURCE_LINE 00000365 "          $exp_idx++;"
NSQ_SOURCE_LINE 00000366 "          return;"
NSQ_SOURCE_LINE 00000367 "        }"
NSQ_SOURCE_LINE 00000368 "        warn $wrn_text;"
NSQ_SOURCE_LINE 00000369 "    };"
NSQ_SOURCE_LINE 00000370 "    uplevel 1,$block;"
NSQ_SOURCE_LINE 00000371 "    my $ok = _cmp_like( \\@got_warning, \\@exp_warning );"
NSQ_SOURCE_LINE 00000372 "    $Tester->ok( $ok, $testname );"
NSQ_SOURCE_LINE 00000373 "    $ok or _diag_found_warning(@got_warning),"
NSQ_SOURCE_LINE 00000374 "           _diag_exp_warning(@exp_warning);"
NSQ_SOURCE_LINE 00000375 "    return $ok;"
NSQ_SOURCE_LINE 00000376 "}"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "sub _to_array_if_necessary {"
NSQ_SOURCE_LINE 00000380 "    return (ref($_[0]) eq 'ARRAY') ? @{$_[0]} : ($_[0]);"
NSQ_SOURCE_LINE 00000381 "}"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "sub _canonical_got_warning {"
NSQ_SOURCE_LINE 00000384 "    my ($called_from, $msg) = @_;"
NSQ_SOURCE_LINE 00000385 "    my $warn_kind = $called_from eq 'Carp' ? 'carped' : 'warn';"
NSQ_SOURCE_LINE 00000386 "    my @warning_stack = split /\\n/, $msg;     # some stuff of uplevel is included"
NSQ_SOURCE_LINE 00000387 "    return {$warn_kind => $warning_stack[0]}; # return only the real message"
NSQ_SOURCE_LINE 00000388 "}"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "sub _canonical_exp_warning {"
NSQ_SOURCE_LINE 00000391 "    my ($exp) = @_;"
NSQ_SOURCE_LINE 00000392 "    if (ref($exp) eq 'HASH') {             # could be {carped => ...}"
NSQ_SOURCE_LINE 00000393 "        my $to_carp = $exp->{carped} or return; # undefined message are ignored"
NSQ_SOURCE_LINE 00000394 "        return (ref($to_carp) eq 'ARRAY')  # is {carped => [ ..., ...] }"
NSQ_SOURCE_LINE 00000395 "            ? map({ {carped => $_} } grep {defined $_} @$to_carp)"
NSQ_SOURCE_LINE 00000396 "            : +{carped => $to_carp};"
NSQ_SOURCE_LINE 00000397 "    }"
NSQ_SOURCE_LINE 00000398 "    return {warn => $exp};"
NSQ_SOURCE_LINE 00000399 "}"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "sub _cmp_got_to_exp_warning {"
NSQ_SOURCE_LINE 00000402 "    my ($got_kind, $got_msg) = %{ shift() };"
NSQ_SOURCE_LINE 00000403 "    my ($exp_kind, $exp_msg) = %{ shift() };"
NSQ_SOURCE_LINE 00000404 "    return 0 if ($got_kind eq 'warn') && ($exp_kind eq 'carped');"
NSQ_SOURCE_LINE 00000405 "    my $cmp;"
NSQ_SOURCE_LINE 00000406 "    if ($exp_msg =~ /\\n$/s) {"
NSQ_SOURCE_LINE 00000407 "      $cmp = \"$got_msg\\n\" eq $exp_msg;"
NSQ_SOURCE_LINE 00000408 "    } else {"
NSQ_SOURCE_LINE 00000409 "      $cmp = $got_msg =~ /^\\Q$exp_msg\\E at .+ line \\d+\\.?$/s;"
NSQ_SOURCE_LINE 00000410 "    }"
NSQ_SOURCE_LINE 00000411 "    return $cmp;"
NSQ_SOURCE_LINE 00000412 "}"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "sub _cmp_got_to_exp_warning_like {"
NSQ_SOURCE_LINE 00000415 "    my ($got_kind, $got_msg) = %{ shift() };"
NSQ_SOURCE_LINE 00000416 "    my ($exp_kind, $exp_msg) = %{ shift() };"
NSQ_SOURCE_LINE 00000417 "    return 0 if ($got_kind eq 'warn') && ($exp_kind eq 'carped');"
NSQ_SOURCE_LINE 00000418 "    if (my $re = $Tester->maybe_regex($exp_msg)) { #qr// or '//'"
NSQ_SOURCE_LINE 00000419 "        my $cmp = $got_msg =~ /$re/;"
NSQ_SOURCE_LINE 00000420 "        return $cmp;"
NSQ_SOURCE_LINE 00000421 "    } else {"
NSQ_SOURCE_LINE 00000422 "        return Test::Warn::Categorization::warning_like_category($got_msg,$exp_msg);"
NSQ_SOURCE_LINE 00000423 "    }"
NSQ_SOURCE_LINE 00000424 "}"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "sub _cmp_is {"
NSQ_SOURCE_LINE 00000428 "    my @got  = @{ shift() };"
NSQ_SOURCE_LINE 00000429 "    my @exp  = @{ shift() };"
NSQ_SOURCE_LINE 00000430 "    scalar @got == scalar @exp or return 0;"
NSQ_SOURCE_LINE 00000431 "    my $cmp = 1;"
NSQ_SOURCE_LINE 00000432 "    $cmp &&= _cmp_got_to_exp_warning($got[$_],$exp[$_]) for (0 .. $#got);"
NSQ_SOURCE_LINE 00000433 "    return $cmp;"
NSQ_SOURCE_LINE 00000434 "}"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "sub _cmp_like {"
NSQ_SOURCE_LINE 00000437 "    my @got  = @{ shift() };"
NSQ_SOURCE_LINE 00000438 "    my @exp  = @{ shift() };"
NSQ_SOURCE_LINE 00000439 "    scalar @got == scalar @exp or return 0;"
NSQ_SOURCE_LINE 00000440 "    my $cmp = 1;"
NSQ_SOURCE_LINE 00000441 "    $cmp &&= _cmp_got_to_exp_warning_like($got[$_],$exp[$_]) for (0 .. $#got);"
NSQ_SOURCE_LINE 00000442 "    return $cmp;"
NSQ_SOURCE_LINE 00000443 "}"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "sub _diag_found_warning {"
NSQ_SOURCE_LINE 00000446 "    foreach (@_) {"
NSQ_SOURCE_LINE 00000447 "        if (ref($_) eq 'HASH') {"
NSQ_SOURCE_LINE 00000448 "            ${$_}{carped} ? $Tester->diag(\"found carped warning: ${$_}{carped}\")"
NSQ_SOURCE_LINE 00000449 "                          : $Tester->diag(\"found warning: ${$_}{warn}\");"
NSQ_SOURCE_LINE 00000450 "        } else {"
NSQ_SOURCE_LINE 00000451 "            $Tester->diag( \"found warning: $_\" );"
NSQ_SOURCE_LINE 00000452 "        }"
NSQ_SOURCE_LINE 00000453 "    }"
NSQ_SOURCE_LINE 00000454 "    $Tester->diag( \"didn't find a warning\" ) unless @_;"
NSQ_SOURCE_LINE 00000455 "}"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "sub _diag_exp_warning {"
NSQ_SOURCE_LINE 00000458 "    foreach (@_) {"
NSQ_SOURCE_LINE 00000459 "        if (ref($_) eq 'HASH') {"
NSQ_SOURCE_LINE 00000460 "            ${$_}{carped} ? $Tester->diag(\"expected to find carped warning: ${$_}{carped}\")"
NSQ_SOURCE_LINE 00000461 "                          : $Tester->diag(\"expected to find warning: ${$_}{warn}\");"
NSQ_SOURCE_LINE 00000462 "        } else {"
NSQ_SOURCE_LINE 00000463 "            $Tester->diag( \"expected to find warning: $_\" );"
NSQ_SOURCE_LINE 00000464 "        }"
NSQ_SOURCE_LINE 00000465 "    }"
NSQ_SOURCE_LINE 00000466 "    $Tester->diag( \"didn't expect to find a warning\" ) unless @_;"
NSQ_SOURCE_LINE 00000467 "}"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "package Test::Warn::Categorization;"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "use Carp;"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "my $bits = \\%warnings::Bits;"
NSQ_SOURCE_LINE 00000474 "my @warnings = sort grep {"
NSQ_SOURCE_LINE 00000475 "  my $warn_bits = $bits->{$_};"
NSQ_SOURCE_LINE 00000476 "  #!grep { $_ ne $warn_bits && ($_ & $warn_bits) eq $_ } values %$bits;"
NSQ_SOURCE_LINE 00000477 "} keys %$bits;"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "# Create a warning name category (e.g. 'utf8') to map to a list of warnings."
NSQ_SOURCE_LINE 00000480 "# The warnings are strings that will be OR'ed together into a"
NSQ_SOURCE_LINE 00000481 "# regular expression: qr/...|...|.../."
NSQ_SOURCE_LINE 00000482 "my %warnings_in_category = ("
NSQ_SOURCE_LINE 00000483 "  'utf8' => ['Wide character in \\w+\\b',],"
NSQ_SOURCE_LINE 00000484 ");"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "sub _warning_category_regexp {"
NSQ_SOURCE_LINE 00000487 "    my $category = shift;"
NSQ_SOURCE_LINE 00000488 "    my $category_bits = $bits->{$category} or return;"
NSQ_SOURCE_LINE 00000489 "    my @category_warnings"
NSQ_SOURCE_LINE 00000490 "      = grep { ($bits->{$_} & $category_bits) eq $bits->{$_} } @warnings;"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "    my @list ="
NSQ_SOURCE_LINE 00000493 "      map { exists $warnings_in_category{$_}? (@{ $warnings_in_category{$_}}) : ($_) }"
NSQ_SOURCE_LINE 00000494 "      @category_warnings;"
NSQ_SOURCE_LINE 00000495 "    my $re = join \"|\", @list;"
NSQ_SOURCE_LINE 00000496 "    return qr/$re/;"
NSQ_SOURCE_LINE 00000497 "}"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "sub warning_like_category {"
NSQ_SOURCE_LINE 00000500 "    my ($warning, $category) = @_;"
NSQ_SOURCE_LINE 00000501 "    my $re = _warning_category_regexp($category) or"
NSQ_SOURCE_LINE 00000502 "        carp(\"Unknown warning category '$category'\"),return;"
NSQ_SOURCE_LINE 00000503 "    my $ok = $warning =~ /$re/;"
NSQ_SOURCE_LINE 00000504 "    return $ok;"
NSQ_SOURCE_LINE 00000505 "}"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "1;"
BODY_END
