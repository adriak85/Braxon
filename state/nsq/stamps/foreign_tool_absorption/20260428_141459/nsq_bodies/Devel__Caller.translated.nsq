BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "package Devel::Caller;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use B qw( peekop );"
NSQ_SOURCE_LINE 00000005 "use PadWalker ();"
NSQ_SOURCE_LINE 00000006 "use XSLoader;"
NSQ_SOURCE_LINE 00000007 "use base qw( Exporter  );"
NSQ_SOURCE_LINE 00000008 "use 5.008;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $VERSION = '2.07';"
NSQ_SOURCE_LINE 00000011 "XSLoader::load __PACKAGE__, $VERSION;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw( caller_cv caller_args caller_vars called_with called_as_method );"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub caller_cv {"
NSQ_SOURCE_LINE 00000016 "    my $level = shift;"
NSQ_SOURCE_LINE 00000017 "    my $cx = PadWalker::_upcontext($level + 1);"
NSQ_SOURCE_LINE 00000018 "    return unless $cx;"
NSQ_SOURCE_LINE 00000019 "    return _context_cv($cx);"
NSQ_SOURCE_LINE 00000020 "}"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "our $DEBUG = 0;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "# scan forward through the ops noting the pushmark or a padrange ops."
NSQ_SOURCE_LINE 00000025 "# These indicate the start of a subroutine call.  We're looking for the most"
NSQ_SOURCE_LINE 00000026 "# recent one before the subroutine invocation (the entersub)."
NSQ_SOURCE_LINE 00000027 "sub scan_forward {"
NSQ_SOURCE_LINE 00000028 "    my $op = shift;"
NSQ_SOURCE_LINE 00000029 "    die \"was expecting a pushmark or a padrange, not a \" . $op->name"
NSQ_SOURCE_LINE 00000030 "      if ($op->name !~ /^(?:pushmark|padrange)$/);"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    my @stack;"
NSQ_SOURCE_LINE 00000033 "    for (; $op && $op->name ne 'entersub'; $op = $op->next) {"
NSQ_SOURCE_LINE 00000034 "        print \"SCAN \", peekop($op), \"\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000035 "        if ($op->name eq \"pushmark\" or $op->name eq \"padrange\") {"
NSQ_SOURCE_LINE 00000036 "            print \"   PUSH\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000037 "            push @stack, $op;"
NSQ_SOURCE_LINE 00000038 "        }"
NSQ_SOURCE_LINE 00000039 "        elsif (0) { # op consumes a mark"
NSQ_SOURCE_LINE 00000040 "            print \"   POP\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000041 "            pop @stack;"
NSQ_SOURCE_LINE 00000042 "        }"
NSQ_SOURCE_LINE 00000043 "    }"
NSQ_SOURCE_LINE 00000044 "    return pop @stack;"
NSQ_SOURCE_LINE 00000045 "}"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "*caller_vars = \\&called_with;"
NSQ_SOURCE_LINE 00000048 "sub called_with {"
NSQ_SOURCE_LINE 00000049 "    my $level = shift;"
NSQ_SOURCE_LINE 00000050 "    my $want_names = shift;"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    my $op  = _context_op( PadWalker::_upcontext( $level + 1 ));"
NSQ_SOURCE_LINE 00000053 "    my $cv  = caller_cv( $level + 2 );"
NSQ_SOURCE_LINE 00000054 "    my $pad = $cv ? B::svref_2object( $cv )->PADLIST : B::comppadlist;"
NSQ_SOURCE_LINE 00000055 "    my $padn = $pad->ARRAYelt( 0 );"
NSQ_SOURCE_LINE 00000056 "    my $padv = $pad->ARRAYelt( 1 );"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    print \"Context OP: \", peekop($op), \"\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000059 "    $op = scan_forward( $op );"
NSQ_SOURCE_LINE 00000060 "    print \"Scanned forward to \", peekop($op), \"\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    my @return;"
NSQ_SOURCE_LINE 00000063 "    my $prev;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    # We're scanning through looking for ops which are pushing"
NSQ_SOURCE_LINE 00000066 "    # variables onto the stack (/pad(sv|av|hv)/ push from the pad, "
NSQ_SOURCE_LINE 00000067 "    # /gvsv|rv2([ahg]v/ are from globs."
NSQ_SOURCE_LINE 00000068 "    for (; $op && $op->name ne 'entersub'; ($prev = $op) && ($op = $op->next)) {"
NSQ_SOURCE_LINE 00000069 "        printf \"Loop: %s %s targ: %d\\n\", peekop($op), $op->name, $op->targ if $DEBUG;"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "        if ($op->name eq \"padrange\") {"
NSQ_SOURCE_LINE 00000072 "            # A padrange is a 5.17 optimisation that uses a single op to"
NSQ_SOURCE_LINE 00000073 "            # load multiple pad variables onto the stack.  The old ops"
NSQ_SOURCE_LINE 00000074 "            # are preserved and are reachable as the padrange's sibling"
NSQ_SOURCE_LINE 00000075 "            # so that B::Deparse can pessimise it back to that state."
NSQ_SOURCE_LINE 00000076 "            #"
NSQ_SOURCE_LINE 00000077 "            # http://perl5.git.perl.org/perl.git/commitdiff/0fe870f5"
NSQ_SOURCE_LINE 00000078 "            # http://perl5.git.perl.org/perl.git/commitdiff/a7fd8ef6"
NSQ_SOURCE_LINE 00000079 "            #"
NSQ_SOURCE_LINE 00000080 "            # We could use the B::Deparse method, but it's probably simpler if"
NSQ_SOURCE_LINE 00000081 "            # we just reassign $op."
NSQ_SOURCE_LINE 00000082 "            print \"padrange, diverting down \", $prev->sibling, \"\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000083 "            $op = $op->sibling;"
NSQ_SOURCE_LINE 00000084 "        }"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "        if ($op->name =~ /padsv_store/) {"
NSQ_SOURCE_LINE 00000087 "            # A padsv_store is a 5.37 optimization that combines a padsv and"
NSQ_SOURCE_LINE 00000088 "            # an sassign into a single op. The new op steals the targ slot"
NSQ_SOURCE_LINE 00000089 "            # of the original padsv."
NSQ_SOURCE_LINE 00000090 "            #"
NSQ_SOURCE_LINE 00000091 "            # https://github.com/Perl/perl5/commit/9fdd7fc"
NSQ_SOURCE_LINE 00000092 "            print \"Copying from pad\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000093 "            if ($want_names) {"
NSQ_SOURCE_LINE 00000094 "                push @return, $padn->ARRAYelt( $op->targ )->PVX;"
NSQ_SOURCE_LINE 00000095 "            }"
NSQ_SOURCE_LINE 00000096 "            else {"
NSQ_SOURCE_LINE 00000097 "                push @return, $padv->ARRAYelt( $op->targ )->object_2svref;"
NSQ_SOURCE_LINE 00000098 "            }"
NSQ_SOURCE_LINE 00000099 "            next;"
NSQ_SOURCE_LINE 00000100 "        }"
NSQ_SOURCE_LINE 00000101 "        elsif ($op->name =~ \"pad(sv|av|hv)\") {"
NSQ_SOURCE_LINE 00000102 "            if ($op->next->next->name eq \"sassign\") {"
NSQ_SOURCE_LINE 00000103 "                print \"sassign in two ops, this is the target skipping\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000104 "                next;"
NSQ_SOURCE_LINE 00000105 "            } elsif ($op->next->name eq \"padsv_store\") {"
NSQ_SOURCE_LINE 00000106 "                print \"padsv_store in one op, this is the target, skipping\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000107 "                next;"
NSQ_SOURCE_LINE 00000108 "            }"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "            print \"Copying from pad\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000111 "            if ($want_names) {"
NSQ_SOURCE_LINE 00000112 "                push @return, $padn->ARRAYelt( $op->targ )->PVX;"
NSQ_SOURCE_LINE 00000113 "            }"
NSQ_SOURCE_LINE 00000114 "            else {"
NSQ_SOURCE_LINE 00000115 "                push @return, $padv->ARRAYelt( $op->targ )->object_2svref;"
NSQ_SOURCE_LINE 00000116 "            }"
NSQ_SOURCE_LINE 00000117 "            next;"
NSQ_SOURCE_LINE 00000118 "        }"
NSQ_SOURCE_LINE 00000119 "        elsif ($op->name =~ /gvsv|rv2(av|hv|gv)/) {"
NSQ_SOURCE_LINE 00000120 "            if ($op->next->next->name eq \"sassign\") {"
NSQ_SOURCE_LINE 00000121 "                print \"sassign in two ops, this is the target, skipping\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000122 "                next;"
NSQ_SOURCE_LINE 00000123 "            }"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "            my $consider = ($op->name eq \"gvsv\") ? $op : $prev;"
NSQ_SOURCE_LINE 00000126 "            my $gv;"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "            if (ref $consider eq 'B::PADOP') {"
NSQ_SOURCE_LINE 00000129 "                print \"GV is really a padgv\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000130 "                $gv = $padv->ARRAYelt( $consider->padix );"
NSQ_SOURCE_LINE 00000131 "                print \"NEW GV $gv\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000132 "            }"
NSQ_SOURCE_LINE 00000133 "            else {"
NSQ_SOURCE_LINE 00000134 "                $gv = $consider->gv;"
NSQ_SOURCE_LINE 00000135 "            }"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "            print \"consider: $consider \", $consider->name, \" gv $gv\\n\""
NSQ_SOURCE_LINE 00000138 "              if $DEBUG;"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "            if ($want_names) {"
NSQ_SOURCE_LINE 00000141 "                my %sigils = ("
NSQ_SOURCE_LINE 00000142 "                    \"gvsv\"  => '$',"
NSQ_SOURCE_LINE 00000143 "                    \"rv2av\" => '@',"
NSQ_SOURCE_LINE 00000144 "                    \"rv2hv\" => '%',"
NSQ_SOURCE_LINE 00000145 "                    \"rv2gv\" => '*',"
NSQ_SOURCE_LINE 00000146 "                   );"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "                push @return, $sigils{ $op->name } . $gv->STASH->NAME . \"::\" . $gv->SAFENAME;"
NSQ_SOURCE_LINE 00000149 "            }"
NSQ_SOURCE_LINE 00000150 "            else {"
NSQ_SOURCE_LINE 00000151 "                my %slots = ("
NSQ_SOURCE_LINE 00000152 "                    \"gvsv\"  => 'SCALAR',"
NSQ_SOURCE_LINE 00000153 "                    \"rv2av\" => 'ARRAY',"
NSQ_SOURCE_LINE 00000154 "                    \"rv2hv\" => 'HASH',"
NSQ_SOURCE_LINE 00000155 "                    \"rv2gv\" => 'GLOB',"
NSQ_SOURCE_LINE 00000156 "                   );"
NSQ_SOURCE_LINE 00000157 "                push @return, *{ $gv->object_2svref }{ $slots{ $op->name} };"
NSQ_SOURCE_LINE 00000158 "            }"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "            next;"
NSQ_SOURCE_LINE 00000161 "        }"
NSQ_SOURCE_LINE 00000162 "        elsif ($op->name eq \"const\") {"
NSQ_SOURCE_LINE 00000163 "            if ($op->next->next->name eq \"sassign\") {"
NSQ_SOURCE_LINE 00000164 "                print \"sassign in two ops, this is the target, skipping\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000165 "                next;"
NSQ_SOURCE_LINE 00000166 "            } elsif ($op->next->name eq \"padsv_store\") {"
NSQ_SOURCE_LINE 00000167 "                print \"padsv_store in one op, this is the target, skipping\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000168 "                next;"
NSQ_SOURCE_LINE 00000169 "            }"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "            push @return, $want_names ? undef : $op->sv;"
NSQ_SOURCE_LINE 00000172 "            next;"
NSQ_SOURCE_LINE 00000173 "        }"
NSQ_SOURCE_LINE 00000174 "    }"
NSQ_SOURCE_LINE 00000175 "    return @return;"
NSQ_SOURCE_LINE 00000176 "}"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "sub called_as_method {"
NSQ_SOURCE_LINE 00000180 "    my $level = shift || 0;"
NSQ_SOURCE_LINE 00000181 "    my $op = _context_op( PadWalker::_upcontext( $level + 1 ));"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    print \"called_as_method: $op\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000184 "    die \"was expecting a pushmark or pad, not a \". $op->name"
NSQ_SOURCE_LINE 00000185 "      unless $op->name eq \"pushmark\";"
NSQ_SOURCE_LINE 00000186 "    while (($op = $op->next) && ($op->name ne \"entersub\")) {"
NSQ_SOURCE_LINE 00000187 "        print \"method: \", $op->name, \"\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000188 "        return 1 if $op->name =~ /^method(?:_named)?$/;"
NSQ_SOURCE_LINE 00000189 "    }"
NSQ_SOURCE_LINE 00000190 "    return;"
NSQ_SOURCE_LINE 00000191 "}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "sub caller_args {"
NSQ_SOURCE_LINE 00000195 "    my $level = shift;"
NSQ_SOURCE_LINE 00000196 "    package DB;"
NSQ_SOURCE_LINE 00000197 "    () = caller( $level + 1 );"
NSQ_SOURCE_LINE 00000198 "    return @DB::args"
NSQ_SOURCE_LINE 00000199 "}"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "1;"
NSQ_SOURCE_LINE 00000202 "__END__"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=head1 NAME"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "Devel::Caller - meatier versions of C<caller>"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 " use Devel::Caller qw(caller_cv);"
NSQ_SOURCE_LINE 00000212 " $foo = sub { print \"huzzah\\n\" if $foo == caller_cv(0) };"
NSQ_SOURCE_LINE 00000213 " $foo->();  # prints huzzah"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 " use Devel::Caller qw(called_with);"
NSQ_SOURCE_LINE 00000216 " sub foo { print called_with(0,1); }"
NSQ_SOURCE_LINE 00000217 " foo( my @foo ); # should print '@foo'"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=over"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=item caller_cv($level)"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "C<caller_cv> gives you the coderef of the subroutine being invoked at"
NSQ_SOURCE_LINE 00000226 "the call frame indicated by the value of $level"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=item caller_args($level)"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "Returns the arguments passed into the caller at level $level"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=item caller_vars( $level, $names )"
NSQ_SOURCE_LINE 00000233 "=item called_with($level, $names)"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "C<called_with> returns a list of references to the original arguments"
NSQ_SOURCE_LINE 00000236 "to the subroutine at $level.  if $names is true, the names of the"
NSQ_SOURCE_LINE 00000237 "variables will be returned instead"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "constants are returned as C<undef> in both cases"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=item called_as_method($level)"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "C<called_as_method> returns true if the subroutine at $level was"
NSQ_SOURCE_LINE 00000244 "called as a method."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=back"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=head1 BUGS"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "All of these routines are susceptible to the same limitations as"
NSQ_SOURCE_LINE 00000251 "C<caller> as described in L<perlfunc/caller>"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "The deparsing of the optree performed by called_with is fairly simple-minded"
NSQ_SOURCE_LINE 00000254 "and so a bit flaky."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=over"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=item"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "As a version 2.0 of Devel::Caller we no longer maintain compatibility with"
NSQ_SOURCE_LINE 00000261 "versions of perl earlier than 5.8.2.  Older versions continue to be available"
NSQ_SOURCE_LINE 00000262 "from CPAN and backpan."
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=back"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "L<perlfunc/caller>, L<PadWalker>, L<Devel::Peek>"
