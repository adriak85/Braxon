NSQ_SOURCE_LINE 00000001 "package Test2::Plugin::NoWarnings;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.10';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "# This is the version that added test2_is_testing_done."
NSQ_SOURCE_LINE 00000009 "use Test2 1.302167;"
NSQ_SOURCE_LINE 00000010 "use Test2::API qw( context_do test2_is_testing_done );"
NSQ_SOURCE_LINE 00000011 "use Test2::Event::Warning;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "my $echo = 0;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub import {"
NSQ_SOURCE_LINE 00000016 "    shift;"
NSQ_SOURCE_LINE 00000017 "    my %args = @_;"
NSQ_SOURCE_LINE 00000018 "    $echo = $args{echo} if exists $args{echo};"
NSQ_SOURCE_LINE 00000019 "    return;"
NSQ_SOURCE_LINE 00000020 "}"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "my $_orig_warn_handler = $SIG{__WARN__};"
NSQ_SOURCE_LINE 00000023 "## no critic (Variables::RequireLocalizedPunctuationVars)"
NSQ_SOURCE_LINE 00000024 "$SIG{__WARN__} = sub {"
NSQ_SOURCE_LINE 00000025 "    unless ( test2_is_testing_done() ) {"
NSQ_SOURCE_LINE 00000026 "        my $w = $_[0];"
NSQ_SOURCE_LINE 00000027 "        $w =~ s/\\n+$//g;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "        context_do {"
NSQ_SOURCE_LINE 00000030 "            my $ctx = shift;"
NSQ_SOURCE_LINE 00000031 "            $ctx->send_event("
NSQ_SOURCE_LINE 00000032 "                'Warning',"
NSQ_SOURCE_LINE 00000033 "                warning => \"Unexpected warning: $w\","
NSQ_SOURCE_LINE 00000034 "            );"
NSQ_SOURCE_LINE 00000035 "        }"
NSQ_SOURCE_LINE 00000036 "        $_[0];"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "        return unless $echo;"
NSQ_SOURCE_LINE 00000039 "    }"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    return if $_orig_warn_handler && $_orig_warn_handler eq 'IGNORE';"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    # The rest was copied from Test::Warnings"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    # TODO: this doesn't handle blessed coderefs... does anyone care?"
NSQ_SOURCE_LINE 00000046 "    goto &$_orig_warn_handler"
NSQ_SOURCE_LINE 00000047 "        if $_orig_warn_handler"
NSQ_SOURCE_LINE 00000048 "        and ("
NSQ_SOURCE_LINE 00000049 "        ( ref $_orig_warn_handler eq 'CODE' )"
NSQ_SOURCE_LINE 00000050 "        or (    $_orig_warn_handler ne 'DEFAULT'"
NSQ_SOURCE_LINE 00000051 "            and $_orig_warn_handler ne 'IGNORE'"
NSQ_SOURCE_LINE 00000052 "            and defined &$_orig_warn_handler )"
NSQ_SOURCE_LINE 00000053 "        );"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    if ( $_[0] =~ /\\n$/ ) {"
NSQ_SOURCE_LINE 00000056 "        warn $_[0];"
NSQ_SOURCE_LINE 00000057 "    }"
NSQ_SOURCE_LINE 00000058 "    else {"
NSQ_SOURCE_LINE 00000059 "        require Carp;"
NSQ_SOURCE_LINE 00000060 "        Carp::carp( $_[0] );"
NSQ_SOURCE_LINE 00000061 "    }"
NSQ_SOURCE_LINE 00000062 "};"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "1;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "# ABSTRACT: Fail if tests warn"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "__END__"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=pod"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=head1 NAME"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "Test2::Plugin::NoWarnings - Fail if tests warn"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=head1 VERSION"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "version 0.10"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    use Test2::V0;"
NSQ_SOURCE_LINE 00000085 "    use Test2::Plugin::NoWarnings;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    ...;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "Loading this plugin causes your tests to fail if there any warnings while they"
NSQ_SOURCE_LINE 00000092 "run. Each warning generates a new failing test and the warning content is"
NSQ_SOURCE_LINE 00000093 "outputted via C<diag>."
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "This module uses C<$SIG{__WARN__}>, so if the code you're testing sets this,"
NSQ_SOURCE_LINE 00000096 "then this module will stop working."
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "=head1 ECHOING WARNINGS"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "By default, this module suppresses the warning itself so it does not go to"
NSQ_SOURCE_LINE 00000101 "C<STDERR>. If you'd like to also have the warning go to C<STDERR> untouched,"
NSQ_SOURCE_LINE 00000102 "you can ask for this with the C<echo> import argument:"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    use Test2::Plugin::NoWarnings echo => 1;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "Bugs may be submitted at L<https://github.com/houseabsolute/Test2-Plugin-NoWarnings/issues>."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "The source code repository for Test2-Plugin-NoWarnings can be found at L<https://github.com/houseabsolute/Test2-Plugin-NoWarnings>."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 DONATIONS"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "If you'd like to thank me for the work I've done on this module, please"
NSQ_SOURCE_LINE 00000117 "consider making a \"donation\" to me via PayPal. I spend a lot of free time"
NSQ_SOURCE_LINE 00000118 "creating free software, and would appreciate any support you'd care to offer."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "Please note that B<I am not suggesting that you must do this> in order for me"
NSQ_SOURCE_LINE 00000121 "to continue working on this particular software. I will continue to do so,"
NSQ_SOURCE_LINE 00000122 "inasmuch as I have in the past, for as long as it interests me."
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "Similarly, a donation made in this way will probably not make me work on this"
NSQ_SOURCE_LINE 00000125 "software much more, unless I get so many donations that I can consider working"
NSQ_SOURCE_LINE 00000126 "on free software full time (let's all have a chuckle at that together)."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "To donate, log into PayPal and send money to autarch@urth.org, or use the"
NSQ_SOURCE_LINE 00000129 "button at L<https://houseabsolute.com/foss-donations/>."
NSQ_SOURCE_LINE 00000130 ""
