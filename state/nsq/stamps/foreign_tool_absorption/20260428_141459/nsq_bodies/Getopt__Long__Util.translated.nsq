NSQ_SOURCE_LINE 00000001 "package Getopt::Long::Util;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "require Exporter;"
NSQ_SOURCE_LINE 00000008 "our @ISA       = qw(Exporter);"
NSQ_SOURCE_LINE 00000009 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000010 "                       parse_getopt_long_opt_spec"
NSQ_SOURCE_LINE 00000011 "                       humanize_getopt_long_opt_spec"
NSQ_SOURCE_LINE 00000012 "                       detect_getopt_long_script"
NSQ_SOURCE_LINE 00000013 "                       gen_getopt_long_spec_from_getopt_std_spec"
NSQ_SOURCE_LINE 00000014 "                       array_getopt_long_spec_to_hash"
NSQ_SOURCE_LINE 00000015 "               );"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000018 "our $DATE = '2022-11-14'; # DATE"
NSQ_SOURCE_LINE 00000019 "our $DIST = 'Getopt-Long-Util'; # DIST"
NSQ_SOURCE_LINE 00000020 "our $VERSION = '0.899'; # VERSION"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "our %SPEC;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "$SPEC{parse_getopt_long_opt_spec} = {"
NSQ_SOURCE_LINE 00000025 "    v => 1.1,"
NSQ_SOURCE_LINE 00000026 "    summary => 'Parse a single Getopt::Long option specification',"
NSQ_SOURCE_LINE 00000027 "    description => <<'_',"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "Will produce a hash with some keys:"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "* `is_arg` (if true, then option specification is the special `<>` for argument"
NSQ_SOURCE_LINE 00000032 "  callback)"
NSQ_SOURCE_LINE 00000033 "* `opts` (array of option names, in the order specified in the opt spec)"
NSQ_SOURCE_LINE 00000034 "* `type` (string, type name)"
NSQ_SOURCE_LINE 00000035 "* `desttype` (either '', or '@' or '%'),"
NSQ_SOURCE_LINE 00000036 "* `is_neg` (true for `--opt!`)"
NSQ_SOURCE_LINE 00000037 "* `is_inc` (true for `--opt+`)"
NSQ_SOURCE_LINE 00000038 "* `min_vals` (int, usually 0 or 1)"
NSQ_SOURCE_LINE 00000039 "* `max_vals` (int, usually 0 or 1 except for option that requires multiple"
NSQ_SOURCE_LINE 00000040 "  values)"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "Will return undef if it can't parse the string."
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "_"
NSQ_SOURCE_LINE 00000045 "    args => {"
NSQ_SOURCE_LINE 00000046 "        optspec => {"
NSQ_SOURCE_LINE 00000047 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000048 "            req => 1,"
NSQ_SOURCE_LINE 00000049 "            pos => 0,"
NSQ_SOURCE_LINE 00000050 "        },"
NSQ_SOURCE_LINE 00000051 "    },"
NSQ_SOURCE_LINE 00000052 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000053 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000054 "    result => {"
NSQ_SOURCE_LINE 00000055 "        schema => 'hash*',"
NSQ_SOURCE_LINE 00000056 "    },"
NSQ_SOURCE_LINE 00000057 "    examples => ["
NSQ_SOURCE_LINE 00000058 "        {"
NSQ_SOURCE_LINE 00000059 "            args => {optspec => 'help|h|?'},"
NSQ_SOURCE_LINE 00000060 "            result => {dash_prefix=>'', opts=>['help', 'h', '?']},"
NSQ_SOURCE_LINE 00000061 "        },"
NSQ_SOURCE_LINE 00000062 "        {"
NSQ_SOURCE_LINE 00000063 "            args => {optspec=>'--foo=s'},"
NSQ_SOURCE_LINE 00000064 "            result => {dash_prefix=>'--', opts=>['foo'], type=>'s', desttype=>''},"
NSQ_SOURCE_LINE 00000065 "        },"
NSQ_SOURCE_LINE 00000066 "    ],"
NSQ_SOURCE_LINE 00000067 "};"
NSQ_SOURCE_LINE 00000068 "# BEGIN_BLOCK: parse_getopt_long_opt_spec"
NSQ_SOURCE_LINE 00000069 "sub parse_getopt_long_opt_spec {"
NSQ_SOURCE_LINE 00000070 "    my $optspec = shift;"
NSQ_SOURCE_LINE 00000071 "    return {is_arg=>1, dash_prefix=>'', opts=>[]}"
NSQ_SOURCE_LINE 00000072 "        if $optspec eq '<>';"
NSQ_SOURCE_LINE 00000073 "    $optspec =~ qr/\\A"
NSQ_SOURCE_LINE 00000074 "               (?P<dash_prefix>-{0,2})"
NSQ_SOURCE_LINE 00000075 "               (?P<name>[A-Za-z0-9_][A-Za-z0-9_-]*)"
NSQ_SOURCE_LINE 00000076 "               (?P<aliases> (?: \\| (?:[^:|!+=:-][^:|!+=:]*) )*)?"
NSQ_SOURCE_LINE 00000077 "               (?:"
NSQ_SOURCE_LINE 00000078 "                   (?P<is_neg>!) |"
NSQ_SOURCE_LINE 00000079 "                   (?P<is_inc>\\+) |"
NSQ_SOURCE_LINE 00000080 "                   (?:"
NSQ_SOURCE_LINE 00000081 "                       ="
NSQ_SOURCE_LINE 00000082 "                       (?P<type>[siof])"
NSQ_SOURCE_LINE 00000083 "                       (?P<desttype>|[%@])?"
NSQ_SOURCE_LINE 00000084 "                       (?:"
NSQ_SOURCE_LINE 00000085 "                           \\{"
NSQ_SOURCE_LINE 00000086 "                           (?: (?P<min_vals>\\d+), )?"
NSQ_SOURCE_LINE 00000087 "                           (?P<max_vals>\\d+)"
NSQ_SOURCE_LINE 00000088 "                           \\}"
NSQ_SOURCE_LINE 00000089 "                       )?"
NSQ_SOURCE_LINE 00000090 "                   ) |"
NSQ_SOURCE_LINE 00000091 "                   (?:"
NSQ_SOURCE_LINE 00000092 "                       :"
NSQ_SOURCE_LINE 00000093 "                       (?P<opttype>[siof])"
NSQ_SOURCE_LINE 00000094 "                       (?P<desttype>|[%@])?"
NSQ_SOURCE_LINE 00000095 "                   ) |"
NSQ_SOURCE_LINE 00000096 "                   (?:"
NSQ_SOURCE_LINE 00000097 "                       :"
NSQ_SOURCE_LINE 00000098 "                       (?P<optnum>-?\\d+)"
NSQ_SOURCE_LINE 00000099 "                       (?P<desttype>|[%@])?"
NSQ_SOURCE_LINE 00000100 "                   ) |"
NSQ_SOURCE_LINE 00000101 "                   (?:"
NSQ_SOURCE_LINE 00000102 "                       :"
NSQ_SOURCE_LINE 00000103 "                       (?P<optplus>\\+)"
NSQ_SOURCE_LINE 00000104 "                       (?P<desttype>|[%@])?"
NSQ_SOURCE_LINE 00000105 "                   )"
NSQ_SOURCE_LINE 00000106 "               )?"
NSQ_SOURCE_LINE 00000107 "               \\z/x"
NSQ_SOURCE_LINE 00000108 "                   or return;"
NSQ_SOURCE_LINE 00000109 "    my %res = %+;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    if (defined $res{optnum}) {"
NSQ_SOURCE_LINE 00000112 "        $res{type} = 'i';"
NSQ_SOURCE_LINE 00000113 "    }"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    if ($res{aliases}) {"
NSQ_SOURCE_LINE 00000116 "        my @als;"
NSQ_SOURCE_LINE 00000117 "        for my $al (split /\\|/, $res{aliases}) {"
NSQ_SOURCE_LINE 00000118 "            next unless length $al;"
NSQ_SOURCE_LINE 00000119 "            next if $al eq $res{name};"
NSQ_SOURCE_LINE 00000120 "            next if grep {$_ eq $al} @als;"
NSQ_SOURCE_LINE 00000121 "            push @als, $al;"
NSQ_SOURCE_LINE 00000122 "        }"
NSQ_SOURCE_LINE 00000123 "        $res{opts} = [$res{name}, @als];"
NSQ_SOURCE_LINE 00000124 "    } else {"
NSQ_SOURCE_LINE 00000125 "        $res{opts} = [$res{name}];"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 "    delete $res{name};"
NSQ_SOURCE_LINE 00000128 "    delete $res{aliases};"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    $res{is_neg} = 1 if $res{is_neg};"
NSQ_SOURCE_LINE 00000131 "    $res{is_inc} = 1 if $res{is_inc};"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    \\%res;"
NSQ_SOURCE_LINE 00000134 "}"
NSQ_SOURCE_LINE 00000135 "# END_BLOCK: parse_getopt_long_opt_spec"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "$SPEC{humanize_getopt_long_opt_spec} = {"
NSQ_SOURCE_LINE 00000138 "    v => 1.1,"
NSQ_SOURCE_LINE 00000139 "    description => <<'_',"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "Convert <pm:Getopt::Long> option specification into a more human-friendly"
NSQ_SOURCE_LINE 00000142 "notation that is suitable for including in help/usage text, for example:"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    help|h|?       ->  \"--help, -h, -?\""
NSQ_SOURCE_LINE 00000145 "    help|h|?       ->  \"--help | -h | -?\"               # if you provide 'separator'"
NSQ_SOURCE_LINE 00000146 "    --foo=s        ->  \"--foo=s\""
NSQ_SOURCE_LINE 00000147 "    --foo=s        ->  \"--foo=somelabel\"                # if you provide 'value_label'"
NSQ_SOURCE_LINE 00000148 "    --foo:s        ->  \"--foo[=s]\""
NSQ_SOURCE_LINE 00000149 "    --foo=s@       ->  \"(--foo=s)+\""
NSQ_SOURCE_LINE 00000150 "    --foo=s%       ->  \"(--foo key=value)+\""
NSQ_SOURCE_LINE 00000151 "    --foo=s%       ->  \"(--foo somelabel1=somelabel2)+\" # if you provide 'key_label' and 'value_label'"
NSQ_SOURCE_LINE 00000152 "    --debug!       ->  \"--(no)debug\""
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "It also produces POD-formatted string for use in POD documentation:"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    --foo=s        ->  {plaintext=>\"--foo=s\", pod=>\"B<--foo>=I<s>\"}"
NSQ_SOURCE_LINE 00000157 "                                                        # if you set 'extended' to true"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "Will die if can't parse the optspec string."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "_"
NSQ_SOURCE_LINE 00000162 "    args => {"
NSQ_SOURCE_LINE 00000163 "        optspec => {"
NSQ_SOURCE_LINE 00000164 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000165 "            req => 1,"
NSQ_SOURCE_LINE 00000166 "            pos => 0,"
NSQ_SOURCE_LINE 00000167 "        },"
NSQ_SOURCE_LINE 00000168 "        separator => {"
NSQ_SOURCE_LINE 00000169 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000170 "            default => ', ',"
NSQ_SOURCE_LINE 00000171 "        },"
NSQ_SOURCE_LINE 00000172 "        key_label => {"
NSQ_SOURCE_LINE 00000173 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000174 "            default => 'key',"
NSQ_SOURCE_LINE 00000175 "        },"
NSQ_SOURCE_LINE 00000176 "        opt_link => {"
NSQ_SOURCE_LINE 00000177 "            schema => 'str*', # XXX url? podlink?"
NSQ_SOURCE_LINE 00000178 "        },"
NSQ_SOURCE_LINE 00000179 "        value_label => {"
NSQ_SOURCE_LINE 00000180 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000181 "        },"
NSQ_SOURCE_LINE 00000182 "        value_label_link => {"
NSQ_SOURCE_LINE 00000183 "            schema => 'str*', # XXX url? podlink?"
NSQ_SOURCE_LINE 00000184 "        },"
NSQ_SOURCE_LINE 00000185 "        extended => {"
NSQ_SOURCE_LINE 00000186 "            summary => 'If set to true, will return a hash of multiple formats instead of a single plaintext format',"
NSQ_SOURCE_LINE 00000187 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000188 "        },"
NSQ_SOURCE_LINE 00000189 "    },"
NSQ_SOURCE_LINE 00000190 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000191 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000192 "    result => {"
NSQ_SOURCE_LINE 00000193 "        schema => ['any*', {of=>[['str*'], ['hash*', {of=>'str*'}]]}],"
NSQ_SOURCE_LINE 00000194 "    },"
NSQ_SOURCE_LINE 00000195 "};"
NSQ_SOURCE_LINE 00000196 "sub humanize_getopt_long_opt_spec {"
NSQ_SOURCE_LINE 00000197 "    my $opts = {}; $opts = shift if ref $_[0] eq 'HASH';"
NSQ_SOURCE_LINE 00000198 "    my $optspec = shift;"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    my $parse = parse_getopt_long_opt_spec($optspec)"
NSQ_SOURCE_LINE 00000201 "        or die \"Can't parse opt spec $optspec\";"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    return \"argument\" if $parse->{is_arg};"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "    my $plain_res = '';"
NSQ_SOURCE_LINE 00000206 "    my $pod_res   = '';"
NSQ_SOURCE_LINE 00000207 "    my $i = 0;"
NSQ_SOURCE_LINE 00000208 "    for (@{ $parse->{opts} }) {"
NSQ_SOURCE_LINE 00000209 "        $i++;"
NSQ_SOURCE_LINE 00000210 "        my $opt_plain_res = '';"
NSQ_SOURCE_LINE 00000211 "        my $opt_pod_res   = '';"
NSQ_SOURCE_LINE 00000212 "        if ($parse->{is_neg} && length($_) > 1) {"
NSQ_SOURCE_LINE 00000213 "            $opt_plain_res .= \"--(no)$_\";"
NSQ_SOURCE_LINE 00000214 "            $opt_pod_res   .= defined($opts->{opt_link}) ? \"B<L<--(no)$_|$opts->{opt_link}>>\" : \"B<--(no)$_>\";"
NSQ_SOURCE_LINE 00000215 "        } else {"
NSQ_SOURCE_LINE 00000216 "            if (length($_) > 1) {"
NSQ_SOURCE_LINE 00000217 "                $opt_plain_res .= \"--$_\";"
NSQ_SOURCE_LINE 00000218 "                $opt_pod_res   .= defined($opts->{opt_link}) ? \"B<L<--$_|$opts->{opt_link}>>\" : \"B<--$_>\";"
NSQ_SOURCE_LINE 00000219 "            } else {"
NSQ_SOURCE_LINE 00000220 "                $opt_plain_res .= \"-$_\";"
NSQ_SOURCE_LINE 00000221 "                $opt_pod_res   .= defined($opts->{opt_link}) ? \"B<L<-$_|$opts->{opt_link}>>\" : \"B<-$_>\";"
NSQ_SOURCE_LINE 00000222 "            }"
NSQ_SOURCE_LINE 00000223 "            if ($i==1 && ($parse->{type} || $parse->{opttype})) {"
NSQ_SOURCE_LINE 00000224 "                # show value label"
NSQ_SOURCE_LINE 00000225 "                my $key_label = $opts->{key_label} // 'key';"
NSQ_SOURCE_LINE 00000226 "                my $value_label = $opts->{value_label} //"
NSQ_SOURCE_LINE 00000227 "                    $parse->{type} // $parse->{opttype};"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "                $opt_plain_res .= \"[\" if $parse->{opttype};"
NSQ_SOURCE_LINE 00000230 "                $opt_plain_res .= ($parse->{type} && $parse->{desttype} eq '%' ? \" \" : \"=\");"
NSQ_SOURCE_LINE 00000231 "                $opt_plain_res .= \"$key_label=\" if $parse->{desttype} eq '%';"
NSQ_SOURCE_LINE 00000232 "                $opt_plain_res .= $value_label;"
NSQ_SOURCE_LINE 00000233 "                $opt_plain_res .= \"]\" if $parse->{opttype};"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "                $opt_pod_res   .= \"[\" if $parse->{opttype};"
NSQ_SOURCE_LINE 00000236 "                $opt_pod_res   .= ($parse->{type} && $parse->{desttype} eq '%' ? \" \" : \"=\");"
NSQ_SOURCE_LINE 00000237 "                $opt_pod_res   .= \"I<$key_label>=\" if $parse->{desttype} eq '%';"
NSQ_SOURCE_LINE 00000238 "                $opt_pod_res   .= defined $opts->{value_label_link} ? \"I<L<$value_label|$opts->{value_label_link}>>\" : \"I<$value_label>\";"
NSQ_SOURCE_LINE 00000239 "                $opt_pod_res   .= \"]\" if $parse->{opttype};"
NSQ_SOURCE_LINE 00000240 "            }"
NSQ_SOURCE_LINE 00000241 "            $opt_plain_res = \"($opt_plain_res)+\" if ($parse->{desttype} // '') =~ /@|%/;"
NSQ_SOURCE_LINE 00000242 "            $opt_pod_res   = \"($opt_pod_res)+\"   if ($parse->{desttype} // '') =~ /@|%/;"
NSQ_SOURCE_LINE 00000243 "        }"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "        $plain_res .= ($opts->{separator} // \", \") if length($plain_res);"
NSQ_SOURCE_LINE 00000246 "        $pod_res   .= ($opts->{separator} // \", \") if length($pod_res);"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "        $plain_res .= $opt_plain_res;"
NSQ_SOURCE_LINE 00000249 "        $pod_res   .= $opt_pod_res;"
NSQ_SOURCE_LINE 00000250 "    }"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    if ($opts->{extended}) {"
NSQ_SOURCE_LINE 00000253 "        return {"
NSQ_SOURCE_LINE 00000254 "            plaintext => $plain_res,"
NSQ_SOURCE_LINE 00000255 "            pod => $pod_res,"
NSQ_SOURCE_LINE 00000256 "        };"
NSQ_SOURCE_LINE 00000257 "    } else {"
NSQ_SOURCE_LINE 00000258 "        $plain_res;"
NSQ_SOURCE_LINE 00000259 "    }"
NSQ_SOURCE_LINE 00000260 "}"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "$SPEC{detect_getopt_long_script} = {"
NSQ_SOURCE_LINE 00000263 "    v => 1.1,"
NSQ_SOURCE_LINE 00000264 "    summary => 'Detect whether a file is a Getopt::Long-based CLI script',"
NSQ_SOURCE_LINE 00000265 "    description => <<'_',"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "The criteria are:"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "* the file must exist and readable;"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "* (optional, if `include_noexec` is false) file must have its executable mode"
NSQ_SOURCE_LINE 00000272 "  bit set;"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "* content must start with a shebang C<#!>;"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "* either: must be perl script (shebang line contains 'perl') and must contain"
NSQ_SOURCE_LINE 00000277 "  something like `use Getopt::Long`;"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "_"
NSQ_SOURCE_LINE 00000280 "    args => {"
NSQ_SOURCE_LINE 00000281 "        filename => {"
NSQ_SOURCE_LINE 00000282 "            summary => 'Path to file to be checked',"
NSQ_SOURCE_LINE 00000283 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000284 "            pos => 0,"
NSQ_SOURCE_LINE 00000285 "            cmdline_aliases => {f=>{}},"
NSQ_SOURCE_LINE 00000286 "        },"
NSQ_SOURCE_LINE 00000287 "        string => {"
NSQ_SOURCE_LINE 00000288 "            summary => 'String to be checked',"
NSQ_SOURCE_LINE 00000289 "            schema => 'buf*',"
NSQ_SOURCE_LINE 00000290 "        },"
NSQ_SOURCE_LINE 00000291 "        include_noexec => {"
NSQ_SOURCE_LINE 00000292 "            summary => 'Include scripts that do not have +x mode bit set',"
NSQ_SOURCE_LINE 00000293 "            schema  => 'bool*',"
NSQ_SOURCE_LINE 00000294 "            default => 1,"
NSQ_SOURCE_LINE 00000295 "        },"
NSQ_SOURCE_LINE 00000296 "    },"
NSQ_SOURCE_LINE 00000297 "    args_rels => {"
NSQ_SOURCE_LINE 00000298 "        'req_one' => ['filename', 'string'],"
NSQ_SOURCE_LINE 00000299 "    },"
NSQ_SOURCE_LINE 00000300 "};"
NSQ_SOURCE_LINE 00000301 "sub detect_getopt_long_script {"
NSQ_SOURCE_LINE 00000302 "    my %args = @_;"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "    (defined($args{filename}) xor defined($args{string}))"
NSQ_SOURCE_LINE 00000305 "        or return [400, \"Please specify either filename or string\"];"
NSQ_SOURCE_LINE 00000306 "    my $include_noexec  = $args{include_noexec}  // 1;"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "    my $yesno = 0;"
NSQ_SOURCE_LINE 00000309 "    my $reason = \"\";"
NSQ_SOURCE_LINE 00000310 "    my %extrameta;"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "    my $str = $args{string};"
NSQ_SOURCE_LINE 00000313 "  DETECT:"
NSQ_SOURCE_LINE 00000314 "    {"
NSQ_SOURCE_LINE 00000315 "        if (defined $args{filename}) {"
NSQ_SOURCE_LINE 00000316 "            my $fn = $args{filename};"
NSQ_SOURCE_LINE 00000317 "            unless (-f $fn) {"
NSQ_SOURCE_LINE 00000318 "                $reason = \"'$fn' is not a file\";"
NSQ_SOURCE_LINE 00000319 "                last;"
NSQ_SOURCE_LINE 00000320 "            };"
NSQ_SOURCE_LINE 00000321 "            if (!$include_noexec && !(-x _)) {"
NSQ_SOURCE_LINE 00000322 "                $reason = \"'$fn' is not an executable\";"
NSQ_SOURCE_LINE 00000323 "                last;"
NSQ_SOURCE_LINE 00000324 "            }"
NSQ_SOURCE_LINE 00000325 "            my $fh;"
NSQ_SOURCE_LINE 00000326 "            unless (open $fh, \"<\", $fn) {"
NSQ_SOURCE_LINE 00000327 "                $reason = \"Can't be read\";"
NSQ_SOURCE_LINE 00000328 "                last;"
NSQ_SOURCE_LINE 00000329 "            }"
NSQ_SOURCE_LINE 00000330 "            # for efficiency, we read a bit only here"
NSQ_SOURCE_LINE 00000331 "            read $fh, $str, 2;"
NSQ_SOURCE_LINE 00000332 "            unless ($str eq '#!') {"
NSQ_SOURCE_LINE 00000333 "                $reason = \"Does not start with a shebang (#!) sequence\";"
NSQ_SOURCE_LINE 00000334 "                last;"
NSQ_SOURCE_LINE 00000335 "            }"
NSQ_SOURCE_LINE 00000336 "            my $shebang = <$fh>;"
NSQ_SOURCE_LINE 00000337 "            unless ($shebang =~ /perl/) {"
NSQ_SOURCE_LINE 00000338 "                $reason = \"Does not have 'perl' in the shebang line\";"
NSQ_SOURCE_LINE 00000339 "                last;"
NSQ_SOURCE_LINE 00000340 "            }"
NSQ_SOURCE_LINE 00000341 "            seek $fh, 0, 0;"
NSQ_SOURCE_LINE 00000342 "            {"
NSQ_SOURCE_LINE 00000343 "                local $/;"
NSQ_SOURCE_LINE 00000344 "                $str = <$fh>;"
NSQ_SOURCE_LINE 00000345 "            }"
NSQ_SOURCE_LINE 00000346 "            close $fh;"
NSQ_SOURCE_LINE 00000347 "        }"
NSQ_SOURCE_LINE 00000348 "        unless ($str =~ /\\A#!/) {"
NSQ_SOURCE_LINE 00000349 "            $reason = \"Does not start with a shebang (#!) sequence\";"
NSQ_SOURCE_LINE 00000350 "            last;"
NSQ_SOURCE_LINE 00000351 "        }"
NSQ_SOURCE_LINE 00000352 "        unless ($str =~ /\\A#!.*perl/) {"
NSQ_SOURCE_LINE 00000353 "            $reason = \"Does not have 'perl' in the shebang line\";"
NSQ_SOURCE_LINE 00000354 "            last;"
NSQ_SOURCE_LINE 00000355 "        }"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "        # NOTE: the presence of \\s* pattern after ^ causes massive slowdown of"
NSQ_SOURCE_LINE 00000358 "        # the regex when we reach many thousands of lines, so we use split()"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "        #if ($str =~ /^\\s*(use|require)\\s+(Getopt::Long(?:::Complete)?)(\\s|;)/m) {"
NSQ_SOURCE_LINE 00000361 "        #    $yesno = 1;"
NSQ_SOURCE_LINE 00000362 "        #    $extrameta{'func.module'} = $2;"
NSQ_SOURCE_LINE 00000363 "        #    last DETECT;"
NSQ_SOURCE_LINE 00000364 "        #}"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "        for (split /^/, $str) {"
NSQ_SOURCE_LINE 00000367 "            if (/^\\s*(use|require)\\s+(Getopt::Long(?:::Complete|::Less|::EvenLess)?)(\\s|;|$)/) {"
NSQ_SOURCE_LINE 00000368 "                $yesno = 1;"
NSQ_SOURCE_LINE 00000369 "                $extrameta{'func.module'} = $2;"
NSQ_SOURCE_LINE 00000370 "                last DETECT;"
NSQ_SOURCE_LINE 00000371 "            }"
NSQ_SOURCE_LINE 00000372 "        }"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "        $reason = \"Can't find any statement requiring Getopt::Long(?::Complete|::Less|::EvenLess)? module\";"
NSQ_SOURCE_LINE 00000375 "    } # DETECT"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "    [200, \"OK\", $yesno, {\"func.reason\"=>$reason, %extrameta}];"
NSQ_SOURCE_LINE 00000378 "}"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "$SPEC{gen_getopt_long_spec_from_getopt_std_spec} = {"
NSQ_SOURCE_LINE 00000381 "    v => 1.1,"
NSQ_SOURCE_LINE 00000382 "    summary => 'Generate Getopt::Long spec from Getopt::Std spec',"
NSQ_SOURCE_LINE 00000383 "    args => {"
NSQ_SOURCE_LINE 00000384 "        spec => {"
NSQ_SOURCE_LINE 00000385 "            summary => 'Getopt::Std spec string',"
NSQ_SOURCE_LINE 00000386 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000387 "            req => 1,"
NSQ_SOURCE_LINE 00000388 "            pos => 0,"
NSQ_SOURCE_LINE 00000389 "        },"
NSQ_SOURCE_LINE 00000390 "        is_getopt => {"
NSQ_SOURCE_LINE 00000391 "            summary => 'Whether to assume spec is for getopt() or getopts()',"
NSQ_SOURCE_LINE 00000392 "            description => <<'_',"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "By default spec is assumed to be for getopts() instead of getopt(). This means"
NSQ_SOURCE_LINE 00000395 "that for a spec like `abc:`, `a` and `b` don't take argument while `c` does. But"
NSQ_SOURCE_LINE 00000396 "if `is_getopt` is true, the meaning of `:` is reversed: `a` and `b` take"
NSQ_SOURCE_LINE 00000397 "arguments while `c` doesn't."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "_"
NSQ_SOURCE_LINE 00000400 "            schema => 'bool',"
NSQ_SOURCE_LINE 00000401 "        },"
NSQ_SOURCE_LINE 00000402 "    },"
NSQ_SOURCE_LINE 00000403 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000404 "    result => {"
NSQ_SOURCE_LINE 00000405 "        schema => 'hash*',"
NSQ_SOURCE_LINE 00000406 "    },"
NSQ_SOURCE_LINE 00000407 "};"
NSQ_SOURCE_LINE 00000408 "sub gen_getopt_long_spec_from_getopt_std_spec {"
NSQ_SOURCE_LINE 00000409 "    my %args = @_;"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "    my $is_getopt = $args{is_getopt};"
NSQ_SOURCE_LINE 00000412 "    my $spec = {};"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "    while ($args{spec} =~ /(.)(:?)/g) {"
NSQ_SOURCE_LINE 00000415 "        $spec->{$1 . ($is_getopt ? ($2 ? \"\" : \"=s\") : ($2 ? \"=s\" : \"\"))} ="
NSQ_SOURCE_LINE 00000416 "            sub {};"
NSQ_SOURCE_LINE 00000417 "    }"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "    $spec;"
NSQ_SOURCE_LINE 00000420 "}"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "$SPEC{array_getopt_long_spec_to_hash} = {"
NSQ_SOURCE_LINE 00000423 "    v => 1.1,"
NSQ_SOURCE_LINE 00000424 "    summary => 'Convert array form of Getopt::Long spec to hash',"
NSQ_SOURCE_LINE 00000425 "    description => <<'_',"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "<pm:Getopt::Long>'s `GetOptions` function accepts a list of arguments. The first"
NSQ_SOURCE_LINE 00000428 "optional argument is a hash for option storage. After that, a list of option"
NSQ_SOURCE_LINE 00000429 "specs (e.g. `foo=s`), each optionally followed by a reference to specify"
NSQ_SOURCE_LINE 00000430 "destination (e.g. a reference to scalar, or array, or code)."
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "Die on failure (e.g. invalid option spec)."
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "This routine converts that array into a hash of option specs as keys and"
NSQ_SOURCE_LINE 00000435 "destinations as values. If an option spec does not have a destination, its"
NSQ_SOURCE_LINE 00000436 "destination is set to `undef`. If hash storage is specified then the destination"
NSQ_SOURCE_LINE 00000437 "will fall back to the hash storage's appropriate key when a specific destination"
NSQ_SOURCE_LINE 00000438 "is not specified."
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "Note that by converting to hash, 1) duplicate option specs are merged; and 2)"
NSQ_SOURCE_LINE 00000441 "order of option specs is not preserved."
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "_"
NSQ_SOURCE_LINE 00000444 "    args => {"
NSQ_SOURCE_LINE 00000445 "        spec => {"
NSQ_SOURCE_LINE 00000446 "            summary => 'Getopt::Long spec',"
NSQ_SOURCE_LINE 00000447 "            schema => 'array*',"
NSQ_SOURCE_LINE 00000448 "            req => 1,"
NSQ_SOURCE_LINE 00000449 "            pos => 0,"
NSQ_SOURCE_LINE 00000450 "        },"
NSQ_SOURCE_LINE 00000451 "    },"
NSQ_SOURCE_LINE 00000452 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000453 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000454 "    result => {"
NSQ_SOURCE_LINE 00000455 "        schema => 'hash*',"
NSQ_SOURCE_LINE 00000456 "    },"
NSQ_SOURCE_LINE 00000457 "};"
NSQ_SOURCE_LINE 00000458 "sub array_getopt_long_spec_to_hash {"
NSQ_SOURCE_LINE 00000459 "    my $go_spec = [ @_ ];"
NSQ_SOURCE_LINE 00000460 "    my $hash_spec = {};"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "    my $hash_storage;"
NSQ_SOURCE_LINE 00000463 "    $hash_storage = shift @$go_spec"
NSQ_SOURCE_LINE 00000464 "        if @$go_spec && ref $go_spec->[0] eq 'HASH';"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "    while (@$go_spec) {"
NSQ_SOURCE_LINE 00000467 "        my $opt_spec = shift @$go_spec;"
NSQ_SOURCE_LINE 00000468 "        my $dest;"
NSQ_SOURCE_LINE 00000469 "        if (@$go_spec && ref $go_spec->[0]) {"
NSQ_SOURCE_LINE 00000470 "            $dest = shift @$go_spec;"
NSQ_SOURCE_LINE 00000471 "        } elsif ($hash_storage) {"
NSQ_SOURCE_LINE 00000472 "            my $res = parse_getopt_long_opt_spec($opt_spec)"
NSQ_SOURCE_LINE 00000473 "                or die \"Invalid option spec '$opt_spec'\";"
NSQ_SOURCE_LINE 00000474 "            my $name = $res->{opts}[0];"
NSQ_SOURCE_LINE 00000475 "            $hash_storage->{$name} = undef unless exists $hash_storage->{$name};"
NSQ_SOURCE_LINE 00000476 "            $dest = ref $hash_storage->{$name} ?"
NSQ_SOURCE_LINE 00000477 "                $hash_storage->{$name} :"
NSQ_SOURCE_LINE 00000478 "                \\($hash_storage->{$name});"
NSQ_SOURCE_LINE 00000479 "        }"
NSQ_SOURCE_LINE 00000480 "        $hash_spec->{$opt_spec} = $dest;"
NSQ_SOURCE_LINE 00000481 "    }"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "    $hash_spec;"
NSQ_SOURCE_LINE 00000484 "}"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "1;"
NSQ_SOURCE_LINE 00000487 "# ABSTRACT: Utilities for Getopt::Long"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "__END__"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "=pod"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "=head1 NAME"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "Getopt::Long::Util - Utilities for Getopt::Long"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "=head1 VERSION"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "This document describes version 0.899 of Getopt::Long::Util (from Perl distribution Getopt-Long-Util), released on 2022-11-14."
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "=head2 array_getopt_long_spec_to_hash"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "Usage:"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 " array_getopt_long_spec_to_hash($spec) -> hash"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "Convert array form of Getopt::Long spec to hash."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "L<Getopt::Long>'s C<GetOptions> function accepts a list of arguments. The first"
NSQ_SOURCE_LINE 00000515 "optional argument is a hash for option storage. After that, a list of option"
NSQ_SOURCE_LINE 00000516 "specs (e.g. C<foo=s>), each optionally followed by a reference to specify"
NSQ_SOURCE_LINE 00000517 "destination (e.g. a reference to scalar, or array, or code)."
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "Die on failure (e.g. invalid option spec)."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "This routine converts that array into a hash of option specs as keys and"
NSQ_SOURCE_LINE 00000522 "destinations as values. If an option spec does not have a destination, its"
NSQ_SOURCE_LINE 00000523 "destination is set to C<undef>. If hash storage is specified then the destination"
NSQ_SOURCE_LINE 00000524 "will fall back to the hash storage's appropriate key when a specific destination"
NSQ_SOURCE_LINE 00000525 "is not specified."
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "Note that by converting to hash, 1) duplicate option specs are merged; and 2)"
NSQ_SOURCE_LINE 00000528 "order of option specs is not preserved."
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=over 4"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "=item * B<$spec>* => I<array>"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "Getopt::Long spec."
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "=back"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "Return value:  (hash)"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "=head2 detect_getopt_long_script"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "Usage:"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 " detect_getopt_long_script(%args) -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "Detect whether a file is a Getopt::Long-based CLI script."
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "The criteria are:"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "=over"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "=item * the file must exist and readable;"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "=item * (optional, if C<include_noexec> is false) file must have its executable mode"
NSQ_SOURCE_LINE 00000562 "bit set;"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "=item * content must start with a shebang C<#!>;"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "=item * either: must be perl script (shebang line contains 'perl') and must contain"
NSQ_SOURCE_LINE 00000567 "something like C<use Getopt::Long>;"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "=back"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "=over 4"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "=item * B<filename> => I<str>"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "Path to file to be checked."
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "=item * B<include_noexec> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "Include scripts that do not have +x mode bit set."
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "=item * B<string> => I<buf>"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "String to be checked."
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "=back"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "First element ($status_code) is an integer containing HTTP-like status code"
NSQ_SOURCE_LINE 00000595 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000596 "($reason) is a string containing error message, or something like \"OK\" if status is"
NSQ_SOURCE_LINE 00000597 "200. Third element ($payload) is the actual result, but usually not present when enveloped result is an error response ($status_code is not 2xx). Fourth"
NSQ_SOURCE_LINE 00000598 "element (%result_meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000599 "that contains extra information, much like how HTTP response headers provide additional metadata."
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "Return value:  (any)"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "=head2 gen_getopt_long_spec_from_getopt_std_spec"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "Usage:"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 " gen_getopt_long_spec_from_getopt_std_spec(%args) -> hash"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "Generate Getopt::Long spec from Getopt::Std spec."
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "=over 4"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "=item * B<is_getopt> => I<bool>"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "Whether to assume spec is for getopt() or getopts()."
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "By default spec is assumed to be for getopts() instead of getopt(). This means"
NSQ_SOURCE_LINE 00000624 "that for a spec like C<abc:>, C<a> and C<b> don't take argument while C<c> does. But"
NSQ_SOURCE_LINE 00000625 "if C<is_getopt> is true, the meaning of C<:> is reversed: C<a> and C<b> take"
NSQ_SOURCE_LINE 00000626 "arguments while C<c> doesn't."
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "=item * B<spec>* => I<str>"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "Getopt::Std spec string."
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "=back"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "Return value:  (hash)"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "=head2 humanize_getopt_long_opt_spec"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "Usage:"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 " humanize_getopt_long_opt_spec( [ \\%optional_named_args ] , $optspec) -> str|hash"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "Convert L<Getopt::Long> option specification into a more human-friendly"
NSQ_SOURCE_LINE 00000646 "notation that is suitable for including in help/usage text, for example:"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 " help|h|?       ->  \"--help, -h, -?\""
NSQ_SOURCE_LINE 00000649 " help|h|?       ->  \"--help | -h | -?\"               # if you provide 'separator'"
NSQ_SOURCE_LINE 00000650 " --foo=s        ->  \"--foo=s\""
NSQ_SOURCE_LINE 00000651 " --foo=s        ->  \"--foo=somelabel\"                # if you provide 'value_label'"
NSQ_SOURCE_LINE 00000652 " --foo:s        ->  \"--foo[=s]\""
NSQ_SOURCE_LINE 00000653 " --foo=s@       ->  \"(--foo=s)+\""
NSQ_SOURCE_LINE 00000654 " --foo=s%       ->  \"(--foo key=value)+\""
NSQ_SOURCE_LINE 00000655 " --foo=s%       ->  \"(--foo somelabel1=somelabel2)+\" # if you provide 'key_label' and 'value_label'"
NSQ_SOURCE_LINE 00000656 " --debug!       ->  \"--(no)debug\""
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "It also produces POD-formatted string for use in POD documentation:"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 " --foo=s        ->  {plaintext=>\"--foo=s\", pod=>\"B<--foo>=I<s>\"}"
NSQ_SOURCE_LINE 00000661 "                                                     # if you set 'extended' to true"
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "Will die if can't parse the optspec string."
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "=over 4"
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "=item * B<extended> => I<bool>"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "If set to true, will return a hash of multiple formats instead of a single plaintext format."
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "=item * B<key_label> => I<str> (default: \"key\")"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "(No description)"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "=item * B<opt_link> => I<str>"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "(No description)"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "=item * B<$optspec>* => I<str>"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "(No description)"
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "=item * B<separator> => I<str> (default: \", \")"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "(No description)"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "=item * B<value_label> => I<str>"
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "(No description)"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "=item * B<value_label_link> => I<str>"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "(No description)"
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "=back"
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "Return value:  (str|hash)"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "=head2 parse_getopt_long_opt_spec"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "Usage:"
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 " parse_getopt_long_opt_spec($optspec) -> hash"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "Parse a single Getopt::Long option specification."
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "Examples:"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "=over"
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "=item * Example #1:"
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 " parse_getopt_long_opt_spec(\"help|h|?\"); # -> { dash_prefix => \"\", opts => [\"help\", \"h\", \"?\"] }"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "=item * Example #2:"
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 " parse_getopt_long_opt_spec(\"--foo=s\"); # -> { dash_prefix => \"--\", desttype => \"\", opts => [\"foo\"], type => \"s\" }"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "=back"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "Will produce a hash with some keys:"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "=over"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "=item * C<is_arg> (if true, then option specification is the special C<< E<lt>E<gt> >> for argument"
NSQ_SOURCE_LINE 00000733 "callback)"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "=item * C<opts> (array of option names, in the order specified in the opt spec)"
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "=item * C<type> (string, type name)"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "=item * C<desttype> (either '', or '@' or '%'),"
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "=item * C<is_neg> (true for C<--opt!>)"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "=item * C<is_inc> (true for C<--opt+>)"
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "=item * C<min_vals> (int, usually 0 or 1)"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "=item * C<max_vals> (int, usually 0 or 1 except for option that requires multiple"
NSQ_SOURCE_LINE 00000748 "values)"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "=back"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "Will return undef if it can't parse the string."
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "=over 4"
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "=item * B<$optspec>* => I<str>"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "(No description)"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "=back"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "Return value:  (hash)"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "Please visit the project's homepage at L<https://metacpan.org/release/Getopt-Long-Util>."
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "Source repository is at L<https://github.com/perlancar/perl-Getopt-Long-Util>."
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "L<Getopt::Long>"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "L<Getopt::Long::Spec>, which can also parse Getopt::Long spec into hash as well"
NSQ_SOURCE_LINE 00000782 "as transform back the hash to Getopt::Long spec. OO interface. I should've found"
NSQ_SOURCE_LINE 00000783 "this module first before writing my own C<parse_getopt_long_opt_spec()>. But at"
NSQ_SOURCE_LINE 00000784 "least currently C<parse_getopt_long_opt_spec()> is at least about 30-100+%"
NSQ_SOURCE_LINE 00000785 "faster than Getopt::Long::Spec::Parser, has a much simpler implementation (a"
NSQ_SOURCE_LINE 00000786 "single regex match), and can handle valid Getopt::Long specs that"
NSQ_SOURCE_LINE 00000787 "Getopt::Long::Spec::Parser fails to parse, e.g. C<foo|f=s@>."
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "perlancar <perlancar@cpan.org>"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "=head1 CONTRIBUTOR"
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "=for stopwords Steven Haryanto"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "Steven Haryanto <stevenharyanto@gmail.com>"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "=head1 CONTRIBUTING"
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "To contribute, you can send patches by email/via RT, or send pull requests on"
NSQ_SOURCE_LINE 00000803 "GitHub."
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "Most of the time, you don't need to build the distribution yourself. You can"
NSQ_SOURCE_LINE 00000806 "simply modify the code, then test via:"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 " % prove -l"
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "If you want to build the distribution (e.g. to try to install it locally on your"
NSQ_SOURCE_LINE 00000811 "system), you can install L<Dist::Zilla>,"
NSQ_SOURCE_LINE 00000812 "L<Dist::Zilla::PluginBundle::Author::PERLANCAR>,"
NSQ_SOURCE_LINE 00000813 "L<Pod::Weaver::PluginBundle::Author::PERLANCAR>, and sometimes one or two other"
NSQ_SOURCE_LINE 00000814 "Dist::Zilla- and/or Pod::Weaver plugins. Any additional steps required beyond"
NSQ_SOURCE_LINE 00000815 "that are considered a bug and can be reported to me."
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "=head1 COPYRIGHT AND LICENSE"
