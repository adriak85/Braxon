BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Sort::BySpec;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2021-05-01'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.040'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000011 "our @EXPORT_OK = qw(sort_by_spec cmp_by_spec);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our %SPEC;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "$SPEC{':package'} = {"
NSQ_SOURCE_LINE 00000016 "    v => 1.1,"
NSQ_SOURCE_LINE 00000017 "    summary => 'Sort array (or create a list sorter) according to '."
NSQ_SOURCE_LINE 00000018 "        'specification',"
NSQ_SOURCE_LINE 00000019 "};"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "$SPEC{sort_by_spec} = {"
NSQ_SOURCE_LINE 00000022 "    v => 1.1,"
NSQ_SOURCE_LINE 00000023 "    summary => 'Sort array (or create a list sorter) according to '."
NSQ_SOURCE_LINE 00000024 "        'specification',"
NSQ_SOURCE_LINE 00000025 "    description => <<'_',"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "_"
NSQ_SOURCE_LINE 00000029 "    args => {"
NSQ_SOURCE_LINE 00000030 "        spec => {"
NSQ_SOURCE_LINE 00000031 "            schema => 'array*',"
NSQ_SOURCE_LINE 00000032 "            req => 1,"
NSQ_SOURCE_LINE 00000033 "            pos => 0,"
NSQ_SOURCE_LINE 00000034 "        },"
NSQ_SOURCE_LINE 00000035 "        xform => {"
NSQ_SOURCE_LINE 00000036 "            schema => 'code*',"
NSQ_SOURCE_LINE 00000037 "            summary => 'Code to return sort keys from data elements',"
NSQ_SOURCE_LINE 00000038 "            description => <<'_',"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "This is just like `xform` in `Sort::ByExample`."
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "_"
NSQ_SOURCE_LINE 00000043 "        },"
NSQ_SOURCE_LINE 00000044 "        reverse => {"
NSQ_SOURCE_LINE 00000045 "            summary => 'If set to true, will reverse the sort order',"
NSQ_SOURCE_LINE 00000046 "            schema => ['bool*', is=>1],"
NSQ_SOURCE_LINE 00000047 "        },"
NSQ_SOURCE_LINE 00000048 "        array => {"
NSQ_SOURCE_LINE 00000049 "            schema => 'array*',"
NSQ_SOURCE_LINE 00000050 "        },"
NSQ_SOURCE_LINE 00000051 "    },"
NSQ_SOURCE_LINE 00000052 "    result => {"
NSQ_SOURCE_LINE 00000053 "        summary => 'Sorted array, or sort coderef',"
NSQ_SOURCE_LINE 00000054 "        schema => ['any*', of=>['array*','code*']],"
NSQ_SOURCE_LINE 00000055 "        description => <<'_',"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "If array is specified, will returned the sorted array. If array is not specified"
NSQ_SOURCE_LINE 00000058 "in the argument, will return a sort subroutine that can be used to sort a list"
NSQ_SOURCE_LINE 00000059 "and return the sorted list."
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "_"
NSQ_SOURCE_LINE 00000062 "    },"
NSQ_SOURCE_LINE 00000063 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000064 "    examples => ["
NSQ_SOURCE_LINE 00000065 "        {"
NSQ_SOURCE_LINE 00000066 "            summary => 'Sort according to a sequence of scalars (like Sort::ByExample)',"
NSQ_SOURCE_LINE 00000067 "            args => {"
NSQ_SOURCE_LINE 00000068 "                spec => ['foo', 'bar', 'baz'],"
NSQ_SOURCE_LINE 00000069 "                array => [1, 2, 3, 'bar', 'a', 'b', 'c', 'baz'],"
NSQ_SOURCE_LINE 00000070 "            },"
NSQ_SOURCE_LINE 00000071 "        },"
NSQ_SOURCE_LINE 00000072 "        {"
NSQ_SOURCE_LINE 00000073 "            summary => 'Like previous example, but reversed',"
NSQ_SOURCE_LINE 00000074 "            args => {"
NSQ_SOURCE_LINE 00000075 "                spec => ['foo', 'bar', 'baz'],"
NSQ_SOURCE_LINE 00000076 "                array => [1, 2, 3, 'bar', 'a', 'b', 'c', 'baz'],"
NSQ_SOURCE_LINE 00000077 "                reverse => 1,"
NSQ_SOURCE_LINE 00000078 "            },"
NSQ_SOURCE_LINE 00000079 "        },"
NSQ_SOURCE_LINE 00000080 "        {"
NSQ_SOURCE_LINE 00000081 "            summary => 'Put integers first (in descending order), then '."
NSQ_SOURCE_LINE 00000082 "                'a sequence of scalars, then others (in ascending order)',"
NSQ_SOURCE_LINE 00000083 "            args => {"
NSQ_SOURCE_LINE 00000084 "                spec => ["
NSQ_SOURCE_LINE 00000085 "                    qr/\\A\\d+\\z/ => sub { $_[1] <=> $_[0] },"
NSQ_SOURCE_LINE 00000086 "                    'foo', 'bar', 'baz',"
NSQ_SOURCE_LINE 00000087 "                    qr// => sub { $_[0] cmp $_[1] },"
NSQ_SOURCE_LINE 00000088 "                ],"
NSQ_SOURCE_LINE 00000089 "                array => [\"qux\", \"b\", \"a\", \"bar\", \"foo\", 1, 10, 2],"
NSQ_SOURCE_LINE 00000090 "            },"
NSQ_SOURCE_LINE 00000091 "        },"
NSQ_SOURCE_LINE 00000092 "    ],"
NSQ_SOURCE_LINE 00000093 "};"
NSQ_SOURCE_LINE 00000094 "sub sort_by_spec {"
NSQ_SOURCE_LINE 00000095 "    my %args = @_;"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    my $spec  = $args{spec};"
NSQ_SOURCE_LINE 00000098 "    my $xform = $args{xform};"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    my $code_get_rank = sub {"
NSQ_SOURCE_LINE 00000101 "        my $val = shift;"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "        my $j;"
NSQ_SOURCE_LINE 00000104 "        for my $which (0..2) { # 0=scalar, 1=regexp, 2=code"
NSQ_SOURCE_LINE 00000105 "            $j = -1;"
NSQ_SOURCE_LINE 00000106 "            while ($j < $#{$spec}) {"
NSQ_SOURCE_LINE 00000107 "                $j++;"
NSQ_SOURCE_LINE 00000108 "                my $spec_elem = $spec->[$j];"
NSQ_SOURCE_LINE 00000109 "                my $ref = ref($spec_elem);"
NSQ_SOURCE_LINE 00000110 "                if (!$ref) {"
NSQ_SOURCE_LINE 00000111 "                    if ($which == 0 && $val eq $spec_elem) {"
NSQ_SOURCE_LINE 00000112 "                        return($j);"
NSQ_SOURCE_LINE 00000113 "                    }"
NSQ_SOURCE_LINE 00000114 "                } elsif ($ref eq 'Regexp') {"
NSQ_SOURCE_LINE 00000115 "                    my $sortsub;"
NSQ_SOURCE_LINE 00000116 "                    if ($j < $#{$spec} && ref($spec->[$j+1]) eq 'CODE') {"
NSQ_SOURCE_LINE 00000117 "                        $sortsub = $spec->[$j+1];"
NSQ_SOURCE_LINE 00000118 "                    }"
NSQ_SOURCE_LINE 00000119 "                    if ($which == 1 && $val =~ $spec_elem) {"
NSQ_SOURCE_LINE 00000120 "                        return($j, $sortsub);"
NSQ_SOURCE_LINE 00000121 "                    }"
NSQ_SOURCE_LINE 00000122 "                    $j++ if $sortsub;"
NSQ_SOURCE_LINE 00000123 "                } elsif ($ref eq 'CODE') {"
NSQ_SOURCE_LINE 00000124 "                    my $sortsub;"
NSQ_SOURCE_LINE 00000125 "                    if ($j < $#{$spec} && ref($spec->[$j+1]) eq 'CODE') {"
NSQ_SOURCE_LINE 00000126 "                        $sortsub = $spec->[$j+1];"
NSQ_SOURCE_LINE 00000127 "                    }"
NSQ_SOURCE_LINE 00000128 "                    if ($which == 2 && $spec_elem->($val)) {"
NSQ_SOURCE_LINE 00000129 "                        return($j, $sortsub);"
NSQ_SOURCE_LINE 00000130 "                    }"
NSQ_SOURCE_LINE 00000131 "                    $j++ if $sortsub;"
NSQ_SOURCE_LINE 00000132 "                } else {"
NSQ_SOURCE_LINE 00000133 "                    die \"Invalid spec[$j]: not a scalar/Regexp/code\";"
NSQ_SOURCE_LINE 00000134 "                }"
NSQ_SOURCE_LINE 00000135 "            } # loop element of spec"
NSQ_SOURCE_LINE 00000136 "        } # which"
NSQ_SOURCE_LINE 00000137 "        return($j+1);"
NSQ_SOURCE_LINE 00000138 "    };"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "    if ($args{_return_cmp}) {"
NSQ_SOURCE_LINE 00000141 "        my $cmp = sub {"
NSQ_SOURCE_LINE 00000142 "            my ($a, $b);"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "            if (@_ >= 2) {"
NSQ_SOURCE_LINE 00000145 "                $a = $_[0];"
NSQ_SOURCE_LINE 00000146 "                $b = $_[1];"
NSQ_SOURCE_LINE 00000147 "            } else {"
NSQ_SOURCE_LINE 00000148 "                my $caller = caller();"
NSQ_SOURCE_LINE 00000149 "                $a = ${\"caller\\::a\"};"
NSQ_SOURCE_LINE 00000150 "                $b = ${\"caller\\::b\"};"
NSQ_SOURCE_LINE 00000151 "            }"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "            if ($xform) {"
NSQ_SOURCE_LINE 00000154 "                $a = $xform->($a);"
NSQ_SOURCE_LINE 00000155 "                $b = $xform->($b);"
NSQ_SOURCE_LINE 00000156 "            }"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "            if ($args{reverse}) {"
NSQ_SOURCE_LINE 00000159 "                ($a, $b) = ($b, $a);"
NSQ_SOURCE_LINE 00000160 "            }"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "            my ($rank_a, $sortsub) = $code_get_rank->($a);"
NSQ_SOURCE_LINE 00000163 "            my ($rank_b          ) = $code_get_rank->($b);"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "            if ($rank_a != $rank_b) {"
NSQ_SOURCE_LINE 00000166 "                return $rank_a <=> $rank_b;"
NSQ_SOURCE_LINE 00000167 "            }"
NSQ_SOURCE_LINE 00000168 "            return 0 unless $sortsub;"
NSQ_SOURCE_LINE 00000169 "            return $sortsub->($a, $b);"
NSQ_SOURCE_LINE 00000170 "        };"
NSQ_SOURCE_LINE 00000171 "        return $cmp;"
NSQ_SOURCE_LINE 00000172 "    } else {"
NSQ_SOURCE_LINE 00000173 "        # use schwartzian transform to speed sorting longer lists"
NSQ_SOURCE_LINE 00000174 "        my $sorter = sub {"
NSQ_SOURCE_LINE 00000175 "            return map { $_->[0] }"
NSQ_SOURCE_LINE 00000176 "                sort {"
NSQ_SOURCE_LINE 00000177 "                    $a->[2] <=> $b->[2] ||"
NSQ_SOURCE_LINE 00000178 "                        ($a->[3] ? $a->[3]($a->[1], $b->[1]) : 0) }"
NSQ_SOURCE_LINE 00000179 "                    map {"
NSQ_SOURCE_LINE 00000180 "                        my $x = $xform ? $xform->($_) : $_;"
NSQ_SOURCE_LINE 00000181 "                        [$_, $x, $code_get_rank->($x)]"
NSQ_SOURCE_LINE 00000182 "                    } @_;"
NSQ_SOURCE_LINE 00000183 "        };"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "        if ($args{array}) {"
NSQ_SOURCE_LINE 00000186 "            return [$sorter->(@{ $args{array} })];"
NSQ_SOURCE_LINE 00000187 "        }"
NSQ_SOURCE_LINE 00000188 "        return $sorter;"
NSQ_SOURCE_LINE 00000189 "    }"
NSQ_SOURCE_LINE 00000190 "}"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "$SPEC{cmp_by_spec} = do {"
NSQ_SOURCE_LINE 00000193 "    # poor man's \"clone\""
NSQ_SOURCE_LINE 00000194 "    my $meta = { %{ $SPEC{sort_by_spec} } };"
NSQ_SOURCE_LINE 00000195 "    $meta->{summary} = 'Create a compare subroutine to be used in sort()';"
NSQ_SOURCE_LINE 00000196 "    $meta->{args} = { %{$meta->{args}} };"
NSQ_SOURCE_LINE 00000197 "    delete $meta->{args}{array};"
NSQ_SOURCE_LINE 00000198 "    $meta->{result} = {"
NSQ_SOURCE_LINE 00000199 "        schema => ['code*'],"
NSQ_SOURCE_LINE 00000200 "    };"
NSQ_SOURCE_LINE 00000201 "    delete $meta->{examples};"
NSQ_SOURCE_LINE 00000202 "    $meta;"
NSQ_SOURCE_LINE 00000203 "};"
NSQ_SOURCE_LINE 00000204 "sub cmp_by_spec {"
NSQ_SOURCE_LINE 00000205 "    sort_by_spec("
NSQ_SOURCE_LINE 00000206 "        @_,"
NSQ_SOURCE_LINE 00000207 "        _return_cmp => 1,"
NSQ_SOURCE_LINE 00000208 "    );"
NSQ_SOURCE_LINE 00000209 "}"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "1;"
NSQ_SOURCE_LINE 00000212 "# ABSTRACT: Sort array (or create a list sorter) according to specification"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "__END__"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=pod"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=head1 NAME"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "Sort::BySpec - Sort array (or create a list sorter) according to specification"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=head1 VERSION"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "This document describes version 0.040 of Sort::BySpec (from Perl distribution Sort-BySpec), released on 2021-05-01."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 " use Sort::BySpec qw(sort_by_spec cmp_by_spec);"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 " my $sorter = sort_by_spec(spec => ["
NSQ_SOURCE_LINE 00000233 "     # put odd numbers first, in ascending order"
NSQ_SOURCE_LINE 00000234 "     qr/[13579]\\z/ => sub { $_[0] <=> $_[1] },"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "     # then put specific numbers here, in this order"
NSQ_SOURCE_LINE 00000237 "     4, 2, 42,"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "     # put even numbers last, in descending order"
NSQ_SOURCE_LINE 00000240 "     sub { $_[0] % 2 == 0 } => sub { $_[1] <=> $_[0] },"
NSQ_SOURCE_LINE 00000241 " ]);"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 " my @res = $sorter->(1..15, 42);"
NSQ_SOURCE_LINE 00000244 " # => (1,3,5,7,9,11,13,15,  4,2,42,   14,12,10,8,6)"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "This package provides a more powerful alternative to L<Sort::ByExample>. Unlike"
NSQ_SOURCE_LINE 00000249 "in `Sort::ByExample` where you only provide a single array of example, you can"
NSQ_SOURCE_LINE 00000250 "specify multiple examples as well as regex or matcher subroutine coupled with"
NSQ_SOURCE_LINE 00000251 "sort rules. With this, you can more precisely specify how elements of your list"
NSQ_SOURCE_LINE 00000252 "should be ordered. If your needs are not met by Sort::ByExample, you might want"
NSQ_SOURCE_LINE 00000253 "to consider this package. The downside is performance penalty, especially when"
NSQ_SOURCE_LINE 00000254 "your list is large."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "To sort using Sort::BySpec, you provide a \"spec\" which is an array of strings,"
NSQ_SOURCE_LINE 00000257 "regexes, or coderefs to match against elements of your list to be sorted. In the"
NSQ_SOURCE_LINE 00000258 "simplest form, the spec contains only a list of examples:"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 " my $sorter = sort_by_spec(spec => [\"foo\", \"bar\", \"baz\"]); # [1]"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "and this is equivalent to Sort::ByExample:"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 " my $sorter = sbe([\"foo\", \"bar\", \"baz\"]);"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "You can also specify regex to match elements. This is evaluated after strings,"
NSQ_SOURCE_LINE 00000267 "so this work:"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 " my $sorter = sort_by_spec(spec => [qr/o/, \"foo\", \"bar\", \"baz\", qr/a/]);"
NSQ_SOURCE_LINE 00000270 " my @list = (\"foo\", \"food\", \"bar\", \"back\", \"baz\", \"fool\", \"boat\");"
NSQ_SOURCE_LINE 00000271 " my @res = $sorter->(@list);"
NSQ_SOURCE_LINE 00000272 " # => (\"food\",\"boat\",\"fool\",   \"foo\",\"bar\",\"baz\",   \"back\")"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "Right after a regex, you can optionally specify a sort subroutine to tell how to"
NSQ_SOURCE_LINE 00000275 "sort elements matching that regex, for example:"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 " my $sorter = sort_by_spec(spec => ["
NSQ_SOURCE_LINE 00000278 "     qr/o/ => sub { $_[0] cmp $_[1] },"
NSQ_SOURCE_LINE 00000279 "     \"foo\", \"bar\", \"baz\","
NSQ_SOURCE_LINE 00000280 "     qr/a/"
NSQ_SOURCE_LINE 00000281 " ]);"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 " # the same list @list above will now be sorted into:"
NSQ_SOURCE_LINE 00000284 " # => (\"boat\",\"food\",\"fool\",   \"foo\",\"bar\",\"baz\",   \"back\")"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "Note that instead of C<$a> and C<$b>, you should use C<$_[0]> and C<$_[1]>"
NSQ_SOURCE_LINE 00000287 "respectively. This avoids the package scoping issue of C<$a> and C<$b>, making"
NSQ_SOURCE_LINE 00000288 "your sorter subroutine works everywhere without any special workaround."
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "Finally, aside from strings and regexes, you can also specify a coderef matcher"
NSQ_SOURCE_LINE 00000291 "for more complex matching. Just like in the case of regex, right after the"
NSQ_SOURCE_LINE 00000292 "coderef you can optionally specify a sort subroutine (another coderef) to tell"
NSQ_SOURCE_LINE 00000293 "how to sort matching elements. For example:"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 " my $sorter = sort_by_spec(spec => ["
NSQ_SOURCE_LINE 00000296 "     # put odd numbers first, in ascending order"
NSQ_SOURCE_LINE 00000297 "     sub { $_[0] % 2 } => sub { $_[0] <=> $_[1] },"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "     # then put specific numbers here, in this order"
NSQ_SOURCE_LINE 00000300 "     4, 2, 42,"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "     # put even numbers last, in descending order"
NSQ_SOURCE_LINE 00000303 "     sub { $_[0] % 2 == 0 } => sub { $_[1] <=> $_[0] },"
NSQ_SOURCE_LINE 00000304 " ]);"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 " my @res = $sorter->(1..15, 42);"
NSQ_SOURCE_LINE 00000307 " # => (1,3,5,7,9,11,13,15,  4,2,42,   14,12,10,8,6)"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "=head2 cmp_by_spec"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "Usage:"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 " cmp_by_spec(%args) -> code"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "Create a compare subroutine to be used in sort()."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=over 4"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "=item * B<reverse> => I<bool>"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "If set to true, will reverse the sort order."
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=item * B<spec>* => I<array>"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=item * B<xform> => I<code>"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "Code to return sort keys from data elements."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "This is just like C<xform> in C<Sort::ByExample>."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "=back"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "Return value:  (code)"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=head2 sort_by_spec"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "Usage:"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 " sort_by_spec(%args) -> array|code"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "Sort array (or create a list sorter) according to specification."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "Examples:"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "=over"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=item * Sort according to a sequence of scalars (like Sort::ByExample):"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 " sort_by_spec("
NSQ_SOURCE_LINE 00000360 "   spec  => [\"foo\", \"bar\", \"baz\"],"
NSQ_SOURCE_LINE 00000361 "   array => [1, 2, 3, \"bar\", \"a\", \"b\", \"c\", \"baz\"]"
NSQ_SOURCE_LINE 00000362 " );"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "Result:"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 " [\"bar\", \"baz\", 1, 2, 3, \"a\", \"b\", \"c\"]"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "=item * Like previous example, but reversed:"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 " sort_by_spec("
NSQ_SOURCE_LINE 00000371 "   spec    => [\"foo\", \"bar\", \"baz\"],"
NSQ_SOURCE_LINE 00000372 "   array   => [1, 2, 3, \"bar\", \"a\", \"b\", \"c\", \"baz\"],"
NSQ_SOURCE_LINE 00000373 "   reverse => 1"
NSQ_SOURCE_LINE 00000374 " );"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "Result:"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 " [\"bar\", \"baz\", 1, 2, 3, \"a\", \"b\", \"c\"]"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=item * Put integers first (in descending order), then a sequence of scalars, then others (in ascending order):"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 " sort_by_spec("
NSQ_SOURCE_LINE 00000383 "   spec  => ["
NSQ_SOURCE_LINE 00000384 "              qr/\\A\\d+\\z/,"
NSQ_SOURCE_LINE 00000385 "              sub { $_[1] <=> $_[0] },"
NSQ_SOURCE_LINE 00000386 "              \"foo\","
NSQ_SOURCE_LINE 00000387 "              \"bar\","
NSQ_SOURCE_LINE 00000388 "              \"baz\","
NSQ_SOURCE_LINE 00000389 "              qr//,"
NSQ_SOURCE_LINE 00000390 "              sub { $_[0] cmp $_[1] },"
NSQ_SOURCE_LINE 00000391 "            ],"
NSQ_SOURCE_LINE 00000392 "   array => [\"qux\", \"b\", \"a\", \"bar\", \"foo\", 1, 10, 2]"
NSQ_SOURCE_LINE 00000393 " );"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "Result:"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 " [10, 2, 1, \"foo\", \"bar\", \"a\", \"b\", \"qux\"]"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=back"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "=over 4"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=item * B<array> => I<array>"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "=item * B<reverse> => I<bool>"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "If set to true, will reverse the sort order."
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "=item * B<spec>* => I<array>"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "=item * B<xform> => I<code>"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "Code to return sort keys from data elements."
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "This is just like C<xform> in C<Sort::ByExample>."
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "=back"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "Return value: Sorted array, or sort coderef (array|code)"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "If array is specified, will returned the sorted array. If array is not specified"
NSQ_SOURCE_LINE 00000428 "in the argument, will return a sort subroutine that can be used to sort a list"
NSQ_SOURCE_LINE 00000429 "and return the sorted list."
