NSQ_SOURCE_LINE 00000001 "package List::Rank;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000009 "our $DATE = '2023-11-23'; # DATE"
NSQ_SOURCE_LINE 00000010 "our $DIST = 'List-Rank'; # DIST"
NSQ_SOURCE_LINE 00000011 "our $VERSION = '0.004'; # VERSION"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw(rank rankstr rankby sortrank sortrankstr sortrankby);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub rank(@) { ## no critic: Subroutines::ProhibitSubroutinePrototypes"
NSQ_SOURCE_LINE 00000016 "    my @ary;"
NSQ_SOURCE_LINE 00000017 "    my $i = 0;"
NSQ_SOURCE_LINE 00000018 "    for (@_) { push @ary, [$_, $i++, undef] }"
NSQ_SOURCE_LINE 00000019 "    @ary = sort { $a->[0] <=> $b->[0] } @ary;"
NSQ_SOURCE_LINE 00000020 "    my $j = 1;"
NSQ_SOURCE_LINE 00000021 "    for ($i=0; $i<@ary; $i++) {"
NSQ_SOURCE_LINE 00000022 "        if ($i == 0) {"
NSQ_SOURCE_LINE 00000023 "            $ary[$i][2] = $j;"
NSQ_SOURCE_LINE 00000024 "        } else {"
NSQ_SOURCE_LINE 00000025 "            if ($ary[$i-1][0] == $ary[$i][0]) {"
NSQ_SOURCE_LINE 00000026 "                $ary[$i-1][2] = $ary[$i][2] = \"$j=\";"
NSQ_SOURCE_LINE 00000027 "            } else {"
NSQ_SOURCE_LINE 00000028 "                $j = $i+1;"
NSQ_SOURCE_LINE 00000029 "                $ary[$i][2] = $j;"
NSQ_SOURCE_LINE 00000030 "            }"
NSQ_SOURCE_LINE 00000031 "        }"
NSQ_SOURCE_LINE 00000032 "    }"
NSQ_SOURCE_LINE 00000033 "    map { $_->[2] } sort { $a->[1] <=> $b->[1] } @ary;"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub rankstr(@) { ## no critic: Subroutines::ProhibitSubroutinePrototypes"
NSQ_SOURCE_LINE 00000037 "    my @ary;"
NSQ_SOURCE_LINE 00000038 "    my $i = 0;"
NSQ_SOURCE_LINE 00000039 "    for (@_) { push @ary, [$_, $i++, undef] }"
NSQ_SOURCE_LINE 00000040 "    @ary = sort { $a->[0] cmp $b->[0] } @ary;"
NSQ_SOURCE_LINE 00000041 "    my $j = 1;"
NSQ_SOURCE_LINE 00000042 "    for ($i=0; $i<@ary; $i++) {"
NSQ_SOURCE_LINE 00000043 "        if ($i == 0) {"
NSQ_SOURCE_LINE 00000044 "            $ary[$i][2] = $j;"
NSQ_SOURCE_LINE 00000045 "        } else {"
NSQ_SOURCE_LINE 00000046 "            if ($ary[$i-1][0] eq $ary[$i][0]) {"
NSQ_SOURCE_LINE 00000047 "                $ary[$i-1][2] = $ary[$i][2] = \"$j=\";"
NSQ_SOURCE_LINE 00000048 "            } else {"
NSQ_SOURCE_LINE 00000049 "                $j = $i+1;"
NSQ_SOURCE_LINE 00000050 "                $ary[$i][2] = $j;"
NSQ_SOURCE_LINE 00000051 "            }"
NSQ_SOURCE_LINE 00000052 "        }"
NSQ_SOURCE_LINE 00000053 "    }"
NSQ_SOURCE_LINE 00000054 "    map { $_->[2] } sort { $a->[1] <=> $b->[1] } @ary;"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub rankby(&;@) { ## no critic: Subroutines::ProhibitSubroutinePrototypes"
NSQ_SOURCE_LINE 00000058 "    no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    my $cmp = shift;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    my $caller = caller();"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    my @ary;"
NSQ_SOURCE_LINE 00000065 "    my $i = 0;"
NSQ_SOURCE_LINE 00000066 "    for (@_) { push @ary, [$_, $i++, undef] }"
NSQ_SOURCE_LINE 00000067 "    @ary = sort {"
NSQ_SOURCE_LINE 00000068 "        local ${\"$caller\\::a\"} = $a->[0];"
NSQ_SOURCE_LINE 00000069 "        local ${\"$caller\\::b\"} = $b->[0];"
NSQ_SOURCE_LINE 00000070 "        $cmp->();"
NSQ_SOURCE_LINE 00000071 "    } @ary;"
NSQ_SOURCE_LINE 00000072 "    my $j = 1;"
NSQ_SOURCE_LINE 00000073 "    for ($i=0; $i<@ary; $i++) {"
NSQ_SOURCE_LINE 00000074 "        if ($i == 0) {"
NSQ_SOURCE_LINE 00000075 "            $ary[$i][2] = $j;"
NSQ_SOURCE_LINE 00000076 "        } else {"
NSQ_SOURCE_LINE 00000077 "            if (do {"
NSQ_SOURCE_LINE 00000078 "                local ${\"$caller\\::a\"} = $ary[$i-1][0];"
NSQ_SOURCE_LINE 00000079 "                local ${\"$caller\\::b\"} = $ary[$i][0];"
NSQ_SOURCE_LINE 00000080 "                !$cmp->();"
NSQ_SOURCE_LINE 00000081 "            }) {"
NSQ_SOURCE_LINE 00000082 "                $ary[$i-1][2] = $ary[$i][2] = \"$j=\";"
NSQ_SOURCE_LINE 00000083 "            } else {"
NSQ_SOURCE_LINE 00000084 "                $j = $i+1;"
NSQ_SOURCE_LINE 00000085 "                $ary[$i][2] = $j;"
NSQ_SOURCE_LINE 00000086 "            }"
NSQ_SOURCE_LINE 00000087 "        }"
NSQ_SOURCE_LINE 00000088 "    }"
NSQ_SOURCE_LINE 00000089 "    map { $_->[2] } sort { $a->[1] <=> $b->[1] } @ary;"
NSQ_SOURCE_LINE 00000090 "}"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "sub sortrank(@) { ## no critic: Subroutines::ProhibitSubroutinePrototypes"
NSQ_SOURCE_LINE 00000093 "    my @ary;"
NSQ_SOURCE_LINE 00000094 "    my $i = 0;"
NSQ_SOURCE_LINE 00000095 "    for (@_) { push @ary, [$_, $i++, undef] }"
NSQ_SOURCE_LINE 00000096 "    @ary = sort { $a->[0] <=> $b->[0] } @ary;"
NSQ_SOURCE_LINE 00000097 "    my $j = 1;"
NSQ_SOURCE_LINE 00000098 "    for ($i=0; $i<@ary; $i++) {"
NSQ_SOURCE_LINE 00000099 "        if ($i == 0) {"
NSQ_SOURCE_LINE 00000100 "            $ary[$i][2] = $j;"
NSQ_SOURCE_LINE 00000101 "        } else {"
NSQ_SOURCE_LINE 00000102 "            if ($ary[$i-1][0] == $ary[$i][0]) {"
NSQ_SOURCE_LINE 00000103 "                $ary[$i-1][2] = $ary[$i][2] = \"$j=\";"
NSQ_SOURCE_LINE 00000104 "            } else {"
NSQ_SOURCE_LINE 00000105 "                $j = $i+1;"
NSQ_SOURCE_LINE 00000106 "                $ary[$i][2] = $j;"
NSQ_SOURCE_LINE 00000107 "            }"
NSQ_SOURCE_LINE 00000108 "        }"
NSQ_SOURCE_LINE 00000109 "    }"
NSQ_SOURCE_LINE 00000110 "    map { ($_->[0], $_->[2]) } @ary;"
NSQ_SOURCE_LINE 00000111 "}"
NSQ_SOURCE_LINE 00000112 ""
