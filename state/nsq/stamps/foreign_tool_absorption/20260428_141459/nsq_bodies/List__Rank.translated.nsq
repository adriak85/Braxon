NSQ_SOURCE_LINE 00000169 "1;"
NSQ_SOURCE_LINE 00000170 "# ABSTRACT: Ranking of list elements"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "__END__"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "=pod"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=head1 NAME"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "List::Rank - Ranking of list elements"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head1 VERSION"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "This document describes version 0.004 of List::Rank (from Perl distribution List-Rank), released on 2023-11-23."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "Return the ranks of the elements if sorted numerically (note that equal values"
NSQ_SOURCE_LINE 00000189 "will be given equal ranks):"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 " my @ranks = rank 10, 30, 20, 20; # => 1, 4, \"2=\", \"2=\""
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "Return the ranks of the elements if sorted ascibetically:"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 " my @ranks = rankstr \"apricot\", \"cucumber\", \"banana\", \"banana\"; # => 1,4,\"2=\",\"2=\""
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "Return the ranks of the elements if sorted by a custom sorter:"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 " my @ranks = rankby {length($a) <=> length($b)}"
NSQ_SOURCE_LINE 00000200 "     \"apricot\", \"cucumber\", \"banana\", \"banana\"; # => 3, 4, \"1=\", \"1=\""
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "Return the ranks of records (taken from L<Sort::Rank>'s Synopsis):"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 " my @ranks = rankby {$b->{score} <=> $a->{score}} ("
NSQ_SOURCE_LINE 00000205 "     {   score   => 80,  name    => 'Andy'       },"
NSQ_SOURCE_LINE 00000206 "     {   score   => 70,  name    => 'Chrissie'   },"
NSQ_SOURCE_LINE 00000207 "     {   score   => 90,  name    => 'Alex'       },"
NSQ_SOURCE_LINE 00000208 "     {   score   => 90,  name    => 'Rosie'      },"
NSQ_SOURCE_LINE 00000209 "     {   score   => 80,  name    => 'Therese'    },"
NSQ_SOURCE_LINE 00000210 "     {   score   => 10,  name    => 'Mac'        },"
NSQ_SOURCE_LINE 00000211 "     {   score   => 10,  name    => 'Horton'     },"
NSQ_SOURCE_LINE 00000212 " ); # => (\"3=\", 5, \"1=\", \"1=\", \"3=\", \"6=\", \"6=\")"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "Sort the list numerically and return the elements as well as ranks in pairs:"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 " my @res = sortrank 10, 30, 20, 20; # => 10,1, 20,\"2=\", 20,\"2=\", 30,4"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "Sort the list ascibetically and return the elements as well as ranks in pairs:"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 " my @res = sortrankstr \"apricot\", \"cucumber\", \"banana\", \"banana\";"
NSQ_SOURCE_LINE 00000221 "     # => \"apricot\",1, \"banana\",\"2=\", \"banana\",\"2=\", \"cucumber\",4"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "Sort the list by a custom sorter and return the elements as well as ranks in"
NSQ_SOURCE_LINE 00000224 "pairs:"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 " my @res = sortrankby {length($a) <=> length($b)} \"apricot\", \"cucumber\", \"banana\", \"banana\";"
NSQ_SOURCE_LINE 00000227 "     # => \"banana\",\"1=\", \"banana\",\"1=\", \"apricot\",3, \"cucumber\",4"
NSQ_SOURCE_LINE 00000228 ""
