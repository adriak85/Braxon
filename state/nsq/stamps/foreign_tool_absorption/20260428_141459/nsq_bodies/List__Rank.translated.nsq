NSQ_SOURCE_LINE 00000114 "    my @ary;"
NSQ_SOURCE_LINE 00000115 "    my $i = 0;"
NSQ_SOURCE_LINE 00000116 "    for (@_) { push @ary, [$_, $i++, undef] }"
NSQ_SOURCE_LINE 00000117 "    @ary = sort { $a->[0] cmp $b->[0] } @ary;"
