NSQ_SOURCE_LINE 00000124 "                $ary[$i-1][2] = $ary[$i][2] = \"$j=\";"
NSQ_SOURCE_LINE 00000125 "            } else {"
NSQ_SOURCE_LINE 00000126 "                $j = $i+1;"
