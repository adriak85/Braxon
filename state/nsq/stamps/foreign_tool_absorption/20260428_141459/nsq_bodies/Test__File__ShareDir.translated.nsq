NSQ_SOURCE_LINE 00000024 "use File::ShareDir 1.00 qw();"
NSQ_SOURCE_LINE 00000025 "use Exporter qw();"
NSQ_SOURCE_LINE 00000026 "use Test::File::ShareDir::Utils qw( extract_dashes );"
NSQ_SOURCE_LINE 00000027 "use Carp qw( croak );"
NSQ_SOURCE_LINE 00000028 "use parent qw( Exporter );"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "our @EXPORT_OK = qw( with_dist_dir with_module_dir );"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub import {"
NSQ_SOURCE_LINE 00000033 "  my ( $package, @args ) = @_;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "  my ( @imports, %params );"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "  # ->import( {  }, qw( imports ) )"
NSQ_SOURCE_LINE 00000038 "  if ( 'HASH' eq ref $args[0] ) {"
NSQ_SOURCE_LINE 00000039 "    %params  = %{ shift @args };"
NSQ_SOURCE_LINE 00000040 "    @imports = @args;"
NSQ_SOURCE_LINE 00000041 "  }"
NSQ_SOURCE_LINE 00000042 "  else {"
NSQ_SOURCE_LINE 00000043 "    # ->import( -arg  => value, -arg => value, @imports );"
NSQ_SOURCE_LINE 00000044 "    while (@args) {"
NSQ_SOURCE_LINE 00000045 "      if ( $args[0] =~ /\\A-(.*)\\z/msx ) {"
NSQ_SOURCE_LINE 00000046 "        $params{ $args[0] } = $args[1];"
NSQ_SOURCE_LINE 00000047 "        splice @args, 0, 2, ();"
NSQ_SOURCE_LINE 00000048 "        next;"
NSQ_SOURCE_LINE 00000049 "      }"
NSQ_SOURCE_LINE 00000050 "      push @imports, shift @args;"
NSQ_SOURCE_LINE 00000051 "    }"
NSQ_SOURCE_LINE 00000052 "  }"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "  if ( keys %params ) {"
NSQ_SOURCE_LINE 00000055 "    require Test::File::ShareDir::TempDirObject;"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    my $tempdir_object = Test::File::ShareDir::TempDirObject->new( \\%params );"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    for my $module ( $tempdir_object->_module_names ) {"
NSQ_SOURCE_LINE 00000060 "      $tempdir_object->_install_module($module);"
NSQ_SOURCE_LINE 00000061 "    }"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    for my $dist ( $tempdir_object->_dist_names ) {"
NSQ_SOURCE_LINE 00000064 "      $tempdir_object->_install_dist($dist);"
NSQ_SOURCE_LINE 00000065 "    }"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "    unshift @INC, $tempdir_object->_tempdir->stringify;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "  }"
NSQ_SOURCE_LINE 00000070 "  if (@imports) {"
NSQ_SOURCE_LINE 00000071 "    $package->export_to_level( 1, undef, @imports );"
NSQ_SOURCE_LINE 00000072 "  }"
NSQ_SOURCE_LINE 00000073 "  return;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "}"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "# This code is just to make sure any guard objects"
NSQ_SOURCE_LINE 00000078 "# are not lexically visible to the sub they contain creating a self reference."
NSQ_SOURCE_LINE 00000079 "sub _mk_clearer {"
NSQ_SOURCE_LINE 00000080 "  my ($clearee) = @_;"
NSQ_SOURCE_LINE 00000081 "  return sub { $clearee->clear };"
NSQ_SOURCE_LINE 00000082 "}"
