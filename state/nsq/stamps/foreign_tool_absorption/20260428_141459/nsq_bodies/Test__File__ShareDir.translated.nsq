NSQ_SOURCE_LINE 00000174 "=head1 NAME"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "Test::File::ShareDir - Create a Fake ShareDir for your modules for testing."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=head1 VERSION"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "version 1.001002"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "    use Test::More;"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "    # use FindBin; optional"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "    use Test::File::ShareDir"
NSQ_SOURCE_LINE 00000189 "        # -root => \"$FindBin::Bin/../\" # optional,"
NSQ_SOURCE_LINE 00000190 "        -share => {"
NSQ_SOURCE_LINE 00000191 "            -module => { 'My::Module' => 'share/MyModule' }"
NSQ_SOURCE_LINE 00000192 "            -dist   => { 'My-Dist'    => 'share/somefolder' }"
NSQ_SOURCE_LINE 00000193 "        };"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    use My::Module;"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "    use File::ShareDir qw( module_dir dist_dir );"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "    module_dir( 'My::Module' ) # dir with files from $dist/share/MyModule"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "    dist_dir( 'My-Dist' ) # dir with files from $dist/share/somefolder"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "C<Test::File::ShareDir> is some low level plumbing to enable a distribution to perform tests while consuming its own C<share>"
NSQ_SOURCE_LINE 00000206 "directories in a manner similar to how they will be once installed."
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "This allows C<File::ShareDir> to see the I<latest> version of content instead of simply whatever is installed on whichever target"
NSQ_SOURCE_LINE 00000209 "system you happen to be testing on."
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "B<Note:> This module only has support for creating 'new' style share dirs and are NOT compatible with old File::ShareDirs."
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "For this reason, unless you have File::ShareDir 1.00 or later installed, this module will not be usable by you."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=head1 SIMPLE INTERFACE"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "Starting with version C<0.4.0>, there are a few extra interfaces you can use."
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "These will probably be more useful, and easier to grok, because they don't have a layer of"
NSQ_SOURCE_LINE 00000220 "indirection in order to simultaneously support both C<Module> and C<Dist> C<ShareDir>'s."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head2 Simple Exporter Interfaces"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=head3 C<Test::File::ShareDir::Dist>"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "L<< C<Test::File::ShareDir::Dist>|Test::File::ShareDir::Dist >> provides a simple export interface"
NSQ_SOURCE_LINE 00000227 "for making C<TempDir> C<ShareDir>'s from a given path:"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "    use Test::File::ShareDir::Dist { \"Dist-Name\" => \"share/\" };"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "This will automatically create a C<ShareDir> for C<Dist-Name> in a C<TempDir> based on the contents of C<CWD/share/>"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "See L<< C<Test::File::ShareDir::Dist>|Test::File::ShareDir::Dist >> for details."
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=head3 C<Test::File::ShareDir::Module>"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "L<< C<Test::File::ShareDir::Module>|Test::File::ShareDir::Module >> provides a simple export interface"
NSQ_SOURCE_LINE 00000238 "for making C<TempDir> C<ShareDir>'s from a given path:"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "    use Test::File::ShareDir::Module { \"Module::Name\" => \"share/\" };"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "This will automatically create a C<ShareDir> for C<Module::Name> in a C<TempDir> based on the contents of C<CWD/share/>"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "See L<< C<Test::File::ShareDir::Module>|Test::File::ShareDir::Module >> for details."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head2 Simple Object Oriented Interfaces"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=head3 C<Test::File::ShareDir::Object::Dist>"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "L<< C<Test::File::ShareDir::Object::Dist>|Test::File::ShareDir::Object::Dist >> provides a simple object oriented interface for"
NSQ_SOURCE_LINE 00000251 "making C<TempDir> C<ShareDir>'s from a given path:"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "    use Test::File::ShareDir::Object::Dist;"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "    my $obj = Test::File::ShareDir::Object::Dist->new( dists => { \"Dist-Name\" => \"share/\" } );"
NSQ_SOURCE_LINE 00000256 "    $obj->install_all_dists;"
NSQ_SOURCE_LINE 00000257 "    $obj->register;"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "This will automatically create a C<ShareDir> for C<Dist-Name> in a C<TempDir> based on the contents of C<CWD/share/>"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "See L<< C<Test::File::ShareDir::Object::Dist>|Test::File::ShareDir::Object::Dist >> for details."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=head3 C<Test::File::ShareDir::Object::Module>"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "L<< C<Test::File::ShareDir::Object::Module>|Test::File::ShareDir::Object::Module >> provides a simple object oriented interface"
NSQ_SOURCE_LINE 00000266 "for making C<TempDir> C<ShareDir>'s from a given path:"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "    use Test::File::ShareDir::Object::Module;"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "    my $obj = Test::File::ShareDir::Object::Module->new( modules => { \"Module::Name\" => \"share/\" } );"
NSQ_SOURCE_LINE 00000271 "    $obj->install_all_modules;"
NSQ_SOURCE_LINE 00000272 "    $obj->register;"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "This will automatically create a C<ShareDir> for C<Module::Name> in a C<TempDir> based on the contents of C<CWD/share/>"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "See L<< C<Test::File::ShareDir::Object::Module>|Test::File::ShareDir::Object::Module >> for details."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head1 SCOPE LIMITED UTILITIES"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "C<Test::File::ShareDir> provides a few utility functions to aide in temporarily adjusting C<ShareDir> behavior."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "    use Test::File::ShareDir qw( with_dist_dir with_module_dir );"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    with_dist_dir({ 'Dist-Name' => 'Some/Path' }, sub {"
NSQ_SOURCE_LINE 00000285 "      # dist_dir() now behaves differently here"
NSQ_SOURCE_LINE 00000286 "    });"
NSQ_SOURCE_LINE 00000287 "    with_module_dir({ 'Module::Name' => 'Some/Path' }, sub {"
NSQ_SOURCE_LINE 00000288 "      # module_dir() now behaves differently here"
NSQ_SOURCE_LINE 00000289 "    });"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "See L<< C<EXPORTABLE FUNCTIONS>|/EXPORTABLE FUNCTIONS >> for details."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=head1 IMPORTING"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "Since C<1.001000>, there are 2 ways of passing arguments to C<import>"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "  use Foo { -root => ... options }, qw( functions to import );"
NSQ_SOURCE_LINE 00000298 "  use Foo -optname => option, -optname => option, qw( functions to import );"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "Both should work, but the former might be less prone to accidental issues."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=head2 IMPORT OPTIONS"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=head3 -root"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "This parameter is the prefix the other paths are relative to."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "If this parameter is not specified, it defaults to the Current Working Directory ( C<CWD> )."
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "In versions prior to C<0.3.0>, this value was mandatory."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "The rationale behind using C<CWD> as the default value is as follows."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=over 4"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=item * Most users of this module are likely to be using it to test distributions"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=item * Most users of this module will be using it in C<$project/t/> to load files from C<$project/share/>"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "=item * Most C<CPAN> tools run tests with C<CWD> = $project"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=back"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "Therefor, defaulting to C<CWD> is a reasonably sane default for most people, but where it is not it can"
NSQ_SOURCE_LINE 00000325 "still be overridden."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "  -root => \"$FindBin::Bin/../\" # resolves to project root from t/ regardless of Cwd."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=head3 -share"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "This parameter is mandatory, and contains a C<hashref> containing the data that explains what directories you want shared."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "  -share =>  { ..... }"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "=head4 -module"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "C<-module> contains a C<hashref> mapping Module names to path names for module_dir style share dirs."
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "  -share => {"
NSQ_SOURCE_LINE 00000340 "    -module => { 'My::Module' => 'share/mymodule/', }"
NSQ_SOURCE_LINE 00000341 "  }"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "  ..."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "  module_dir('My::Module')"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "Notedly, it is a C<hashref>, which means there is a limitation of one share dir per module. This is simply because having more"
NSQ_SOURCE_LINE 00000348 "than one share dir per module makes no sense at all."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "=head4 -dist"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "C<-dist> contains a C<hashref> mapping Distribution names to path names for dist_dir style share dirs. The same limitation"
NSQ_SOURCE_LINE 00000353 "applied to C<-module> applies here."
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "  -share => {"
NSQ_SOURCE_LINE 00000356 "    -dist => { 'My-Dist' => 'share/mydist' }"
NSQ_SOURCE_LINE 00000357 "  }"
NSQ_SOURCE_LINE 00000358 "  ..."
NSQ_SOURCE_LINE 00000359 "  dist_dir('My-Dist')"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=head1 EXPORTABLE FUNCTIONS"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=head2 with_dist_dir"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "Sets up a C<ShareDir> environment with limited context."
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "  # with_dist_dir(\\%config, \\&sub);"
NSQ_SOURCE_LINE 00000368 "  with_dist_dir( { 'Dist-Name' => 'share/' } => sub {"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "      # File::ShareDir resolves to a copy of share/ in this context."
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "  } );"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "C<%config> can contain anything L<< C<Test::File::ShareDir::Dist>|Test::File::ShareDir::Dist >> accepts."
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "=over 4"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "=item C<-root>: Defaults to C<$CWD>"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=item C<I<$distName>>: Declare C<$distName>'s C<ShareDir>."
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=back"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "I<Since 1.001000>"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "=head2 with_module_dir"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "Sets up a C<ShareDir> environment with limited context."
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "  # with_module_dir(\\%config, \\&sub);"
NSQ_SOURCE_LINE 00000391 "  with_module_dir( { 'Module::Name' => 'share/' } => sub {"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "      # File::ShareDir resolves to a copy of share/ in this context."
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "  } );"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "C<%config> can contain anything L<< C<Test::File::ShareDir::Module>|Test::File::ShareDir::Module >> accepts."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=over 4"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=item C<-root>: Defaults to C<$CWD>"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=item C<I<$moduleName>>: Declare C<$moduleName>'s C<ShareDir>."
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "=back"
NSQ_SOURCE_LINE 00000406 ""
