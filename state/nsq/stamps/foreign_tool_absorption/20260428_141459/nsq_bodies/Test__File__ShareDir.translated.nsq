NSQ_SOURCE_LINE 00000109 "sub with_dist_dir {"
NSQ_SOURCE_LINE 00000110 "  my ( $config, $code ) = @_;"
NSQ_SOURCE_LINE 00000111 "  if ( 'CODE' ne ( ref $code || q{} ) ) {"
NSQ_SOURCE_LINE 00000112 "    croak( 'CodeRef expected at end of with_dist_dir(), ' . ( ref $code || qq{scalar=\"$code\"} ) . ' found' );"
NSQ_SOURCE_LINE 00000113 "  }"
NSQ_SOURCE_LINE 00000114 "  require Test::File::ShareDir::Object::Dist;"
NSQ_SOURCE_LINE 00000115 "  require Scope::Guard;"
NSQ_SOURCE_LINE 00000116 "  my $dist_object = Test::File::ShareDir::Object::Dist->new( extract_dashes( 'dists', $config ) );"
NSQ_SOURCE_LINE 00000117 "  $dist_object->install_all_dists();"
NSQ_SOURCE_LINE 00000118 "  $dist_object->register();"
NSQ_SOURCE_LINE 00000119 "  my $guard = Scope::Guard->new( _mk_clearer($dist_object) );    ## no critic (Variables::ProhibitUnusedVarsStricter)"
NSQ_SOURCE_LINE 00000120 "  return $code->();"
NSQ_SOURCE_LINE 00000121 "}"
