NSQ_SOURCE_LINE 00000001 "package namespace;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "=head1 NAME"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "namespace - Perl pragma to use like C++ namespace aliasing"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 " use namespace File => IO::File;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 " my $fh = new File \"foo\", O_CREAT|O_WRONLY;"
NSQ_SOURCE_LINE 00000012 " if( defined $fh )"
NSQ_SOURCE_LINE 00000013 " {"
NSQ_SOURCE_LINE 00000014 "     print $fh \"bar\\n\";"
NSQ_SOURCE_LINE 00000015 "     $fh->close;"
NSQ_SOURCE_LINE 00000016 " }"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "Allow aliasing namespace. May be useful for reusability increase."
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 " use namespace ALIAS => PACKAGE "
NSQ_SOURCE_LINE 00000023 "    [, qw/IMPORT_LIST [ ::SUBPACKAGE [ IMPORT_LIST ]] /];"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 " ALIAS and PACKAGE is required parameters;"
NSQ_SOURCE_LINE 00000026 " IMPORT_LIST is the usual list of import."
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "Also may be undefined namespace and they subnamespaces:"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 " no namespace ALIAS;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "If ALIAS begin with '::', then alias will be expandet to "
NSQ_SOURCE_LINE 00000035 "caller namespace. If following example of pragma namespace "
NSQ_SOURCE_LINE 00000036 "called from main:: module, then alias will be expandet to main::ALIAS::."
NSQ_SOURCE_LINE 00000037 "     "
NSQ_SOURCE_LINE 00000038 " use namespace ::ALIAS => PACKAGE"
NSQ_SOURCE_LINE 00000039 "    "
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 " EXAMPLE 1"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 " use namespace DOM => XML::DOM, qw/$VERSION ::Document $VERSION/;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    # DOM is alias for XML::DOM"
NSQ_SOURCE_LINE 00000048 "    #       $VERSION from XML::DOM will be imported to DOM"
NSQ_SOURCE_LINE 00000049 "    #"
NSQ_SOURCE_LINE 00000050 "    # ::Document subpackage of XML::DOM will be aliased to DOM::Document"
NSQ_SOURCE_LINE 00000051 "    #       $VERSION from XML::DOM::Document will be imported to DOM::Document"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 " my $doc = new DOM::Document;"
NSQ_SOURCE_LINE 00000054 " print \"Current used DOM version is $DOM::VERSION \\n\";"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 " no namespace DOM;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    # namespace DOM and all subnamespaces will be destroyed"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 " EXAMPLE 2"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 " use namespace DOM => XML::DOM, qw/::Document/;"
NSQ_SOURCE_LINE 00000065 " # or"
NSQ_SOURCE_LINE 00000066 " # use namespace DOM => XML::Sablotron::DOM, qw/:constants ::Document/;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 " my $doc = new DOM::Document;"
NSQ_SOURCE_LINE 00000069 " print \"Constant 'TEXT_NODE' = \", TEXT_NODE;"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "Albert MICHEEV <amichauer@cpan.org>"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=cut"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "use strict qw/subs vars/;"
NSQ_SOURCE_LINE 00000078 "$namespace::VERSION = '0.05';"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "sub import{"
NSQ_SOURCE_LINE 00000082 "    my ($slf, $als, $pkg) = (shift, shift, shift);"
NSQ_SOURCE_LINE 00000083 "    my $clr = (caller)[0];"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    $als = $clr.$als if substr($als, 0, 2) eq '::';"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    die \"Package '$als' already defined!\" if defined %{$als.'::'};"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    require join( '/', split '::', $pkg ) . '.pm' unless defined %{$pkg.'::'};"
NSQ_SOURCE_LINE 00000090 "    @{$als.'::ISA'} = $pkg;"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    if( @_ and $_[0] eq '()' ){ shift }"
NSQ_SOURCE_LINE 00000093 "    else{ unshift @_, @{$pkg.'::EXPORT'} if defined @{$pkg.'::EXPORT'} }"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    my ($Pkg, $Als) = ($pkg, $als);"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    while( my $imp = shift ){"
NSQ_SOURCE_LINE 00000098 "        if( substr($imp, 0, 2) eq '::' ){"
NSQ_SOURCE_LINE 00000099 "            $Pkg = $pkg.$imp;"
NSQ_SOURCE_LINE 00000100 "            $Als = $als.$imp;"
NSQ_SOURCE_LINE 00000101 "            @{$Als.'::ISA'} = $Pkg;"
NSQ_SOURCE_LINE 00000102 "            if( @_ and $_[0] eq '()' ){ shift }"
NSQ_SOURCE_LINE 00000103 "            else{ unshift @_, @{$Pkg.'::EXPORT'} if defined @{$Pkg.'::EXPORT'} }"
NSQ_SOURCE_LINE 00000104 "        }"
NSQ_SOURCE_LINE 00000105 "        elsif( $imp =~ /^:(.+)$/ ){"
NSQ_SOURCE_LINE 00000106 "            die \"Can't find '$imp' export tag in $Pkg!\\n\" unless"
NSQ_SOURCE_LINE 00000107 "                defined ${$Pkg.'::'}{EXPORT_TAGS}{$1};"
NSQ_SOURCE_LINE 00000108 "            unshift @_, @{ ${$Pkg.'::'}{EXPORT_TAGS}{$1} };"
NSQ_SOURCE_LINE 00000109 "        }"
NSQ_SOURCE_LINE 00000110 "        elsif( $imp =~ /^([\\$%@])?(.+)$/ ){"
NSQ_SOURCE_LINE 00000111 "            die \"Can't find '$imp' from $Pkg!\\n\" unless"
NSQ_SOURCE_LINE 00000112 "                !$1       && defined \\&{$Pkg.'::'.$2} or"
NSQ_SOURCE_LINE 00000113 "                $1 eq '$' && defined \\${$Pkg.'::'.$2} or"
NSQ_SOURCE_LINE 00000114 "                $1 eq '@' && defined \\@{$Pkg.'::'.$2} or"
NSQ_SOURCE_LINE 00000115 "                             defined \\%{$Pkg.'::'.$2};"
NSQ_SOURCE_LINE 00000116 "            *{$clr.'::'.$2} = "
NSQ_SOURCE_LINE 00000117 "            *{$Als.'::'.$2} = "
NSQ_SOURCE_LINE 00000118 "               !$1        ? \\&{$Pkg.'::'.$2} :"
NSQ_SOURCE_LINE 00000119 "                $1 eq '$' ? \\${$Pkg.'::'.$2} :"
NSQ_SOURCE_LINE 00000120 "                $1 eq '@' ? \\@{$Pkg.'::'.$2} : "
NSQ_SOURCE_LINE 00000121 "                            \\%{$Pkg.'::'.$2};"
NSQ_SOURCE_LINE 00000122 "        }"
NSQ_SOURCE_LINE 00000123 "        else{ die \"Undefined behavior!\\n\" }"
NSQ_SOURCE_LINE 00000124 "    }"
NSQ_SOURCE_LINE 00000125 "}"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "sub unimport{"
NSQ_SOURCE_LINE 00000128 "    undef %{(substr($_[1], 0, 2) eq '::' ? (caller)[0] : '' ).$_[1].'::'};"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "1;"
BODY_END
