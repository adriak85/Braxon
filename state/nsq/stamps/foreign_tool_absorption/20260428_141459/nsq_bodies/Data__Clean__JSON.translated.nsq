NSQ_SOURCE_LINE 00000001 "package Data::Clean::JSON;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2019-09-11'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.392'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use parent qw(Data::Clean);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000014 "                       clean_json_in_place"
NSQ_SOURCE_LINE 00000015 "                       clone_and_clean_json"
NSQ_SOURCE_LINE 00000016 "               );"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub new {"
NSQ_SOURCE_LINE 00000019 "    my ($class, %opts) = @_;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "    # from FromJSON"
NSQ_SOURCE_LINE 00000022 "    $opts{\"JSON::PP::Boolean\"} //= ['one_or_zero'];"
NSQ_SOURCE_LINE 00000023 "    $opts{\"JSON::XS::Boolean\"} //= ['one_or_zero']; # this doesn't exist though"
NSQ_SOURCE_LINE 00000024 "    $opts{\"Cpanel::JSON::XS::Boolean\"} //= ['one_or_zero']; # this doesn't exist though"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    $opts{DateTime}  //= [call_method => 'epoch'];"
NSQ_SOURCE_LINE 00000027 "    $opts{'Time::Moment'} //= [call_method => 'epoch'];"
NSQ_SOURCE_LINE 00000028 "    $opts{'Math::BigInt'} //= [call_method => 'bstr'];"
NSQ_SOURCE_LINE 00000029 "    $opts{Regexp}    //= ['stringify'];"
NSQ_SOURCE_LINE 00000030 "    $opts{version}   //= ['stringify'];"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    $opts{SCALAR}    //= ['deref_scalar'];"
NSQ_SOURCE_LINE 00000033 "    $opts{-ref}      //= ['replace_with_ref'];"
NSQ_SOURCE_LINE 00000034 "    $opts{-circular} //= ['clone'];"
NSQ_SOURCE_LINE 00000035 "    $opts{-obj}      //= ['unbless'];"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    $opts{'!recurse_obj'} //= 1;"
NSQ_SOURCE_LINE 00000038 "    $class->SUPER::new(%opts);"
NSQ_SOURCE_LINE 00000039 "}"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "sub get_cleanser {"
NSQ_SOURCE_LINE 00000042 "    my $class = shift;"
NSQ_SOURCE_LINE 00000043 "    state $singleton = $class->new;"
NSQ_SOURCE_LINE 00000044 "    $singleton;"
NSQ_SOURCE_LINE 00000045 "}"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "sub clean_json_in_place {"
NSQ_SOURCE_LINE 00000048 "    __PACKAGE__->get_cleanser->clean_in_place(@_);"
NSQ_SOURCE_LINE 00000049 "}"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "sub clone_and_clean_json {"
NSQ_SOURCE_LINE 00000052 "    __PACKAGE__->get_cleanser->clone_and_clean(@_);"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "1;"
NSQ_SOURCE_LINE 00000056 "# ABSTRACT: (DEPRECATED) Clean data so it is safe to output to JSON"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "__END__"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=pod"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=head1 NAME"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "Data::Clean::JSON - (DEPRECATED) Clean data so it is safe to output to JSON"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=head1 VERSION"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "This document describes version 0.392 of Data::Clean::JSON (from Perl distribution Data-Clean-JSON), released on 2019-09-11."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 " use Data::Clean::JSON;"
NSQ_SOURCE_LINE 00000075 " my $cleanser = Data::Clean::JSON->get_cleanser;"
NSQ_SOURCE_LINE 00000076 " my $data     = { code=>sub {}, re=>qr/abc/i };"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 " my $cleaned;"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 " # modifies data in-place"
NSQ_SOURCE_LINE 00000081 " $cleaned = $cleanser->clean_in_place($data);"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 " # ditto, but deep clone first, return"
NSQ_SOURCE_LINE 00000084 " $cleaned = $cleanser->clone_and_clean($data);"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 " # now output it"
NSQ_SOURCE_LINE 00000087 " use JSON;"
NSQ_SOURCE_LINE 00000088 " print encode_json($cleaned); # prints '{\"code\":\"CODE\",\"re\":\"(?^i:abc)\"}'"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "Functional shortcuts:"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 " use Data::Clean::JSON qw(clean_json_in_place clone_and_clean_json);"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 " # equivalent to Data::Clean::JSON->get_cleanser->clean_in_place($data)"
NSQ_SOURCE_LINE 00000095 " clean_json_in_place($data);"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 " # equivalent to Data::Clean::JSON->get_cleanser->clone_and_clean($data)"
NSQ_SOURCE_LINE 00000098 " $cleaned = clone_and_clean_json($data);"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "B<DEPRECATION NOTICE:> This module has been renamed to L<Data::Clean::ForJSON>"
NSQ_SOURCE_LINE 00000103 "for more clarity. This old name is retained because there are distributions"
NSQ_SOURCE_LINE 00000104 "still depending on it."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "This class cleans data from anything that might be problematic when encoding to"
NSQ_SOURCE_LINE 00000107 "JSON. This includes coderefs, globs, and so on. Here's what it will do by"
NSQ_SOURCE_LINE 00000108 "default:"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=over"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=item * Change DateTime and Time::Moment object to its epoch value"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=item * Change Regexp and version object to its string value"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=item * Change scalar references (e.g. \\1) to its scalar value (e.g. 1)"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=item * Change other references (non-hash, non-array) to its ref() value (e.g. \"GLOB\", \"CODE\")"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=item * Clone circular references"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "With a default limit of 1, meaning that if a reference is first seen again for"
NSQ_SOURCE_LINE 00000123 "the first time, it will be cloned. But if it is seen again for the second time,"
NSQ_SOURCE_LINE 00000124 "it will be replaced with \"CIRCULAR\"."
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "To change the default limit, customize your cleanser object:"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 " $cleanser = Data::Clean::JSON->new("
NSQ_SOURCE_LINE 00000129 "     -circular => [\"clone\", 4],"
NSQ_SOURCE_LINE 00000130 " );"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "or you can perform other action for circular references, see L<Data::Clean> for"
NSQ_SOURCE_LINE 00000133 "more details."
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=item * Unbless other types of objects"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=back"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "Cleaning recurses into objects."
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "Data that has been cleaned will probably not be convertible back to the"
NSQ_SOURCE_LINE 00000142 "original, due to information loss (for example, coderefs converted to string"
NSQ_SOURCE_LINE 00000143 "C<\"CODE\">)."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "The design goals are good performance, good defaults, and just enough"
NSQ_SOURCE_LINE 00000146 "flexibility. The original use-case is for returning JSON response in HTTP API"
NSQ_SOURCE_LINE 00000147 "service."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "This module is significantly faster than modules like L<Data::Rmap> or"
NSQ_SOURCE_LINE 00000150 "L<Data::Visitor::Callback> because with something like Data::Rmap you repeatedly"
NSQ_SOURCE_LINE 00000151 "invoke callback for each data item. This module, on the other hand, generates a"
NSQ_SOURCE_LINE 00000152 "cleanser code using eval(), using native Perl for() loops."
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "If C<LOG_CLEANSER_CODE> environment is set to true, the generated cleanser code"
NSQ_SOURCE_LINE 00000155 "will be logged using L<Log::get> at trace level. You can see it, e.g. using"
NSQ_SOURCE_LINE 00000156 "L<Log::ger::Output::Screen>:"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 " % LOG_CLEANSER_CODE=1 perl -MLog::ger::Output=Screen -MLog::ger::Level::trace -MData::Clean::JSON \\"
NSQ_SOURCE_LINE 00000159 "   -e'$c=Data::Clean::JSON->new; ...'"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "None of the functions are exported by default."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=head2 clean_json_in_place($data)"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "A shortcut for:"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 " Data::Clean::JSON->get_cleanser->clean_in_place($data)"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=head2 clone_and_clean_json($data) => $cleaned"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "A shortcut for:"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 " $cleaned = Data::Clean::JSON->get_cleanser->clone_and_clean($data)"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=head1 METHODS"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=head2 CLASS->get_cleanser => $obj"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "Return a singleton instance, with default options. Use C<new()> if you want to"
NSQ_SOURCE_LINE 00000182 "customize options."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=head2 CLASS->new() => $obj"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "Create a new instance."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=head2 $obj->clean_in_place($data) => $cleaned"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "Clean $data. Modify data in-place."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=head2 $obj->clone_and_clean($data) => $cleaned"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "Clean $data. Clone $data first."
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=head1 FAQ"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "=head2 Why clone/modify? Why not directly output JSON?"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "So that the data can be used for other stuffs, like outputting to YAML, etc."
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=head2 Why is it slow?"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "If you use C<new()> instead of C<get_cleanser()>, make sure that you do not"
NSQ_SOURCE_LINE 00000205 "construct the Data::Clean::JSON object repeatedly, as the constructor generates"
NSQ_SOURCE_LINE 00000206 "the cleanser code first using eval(). A short benchmark (run on my slow Atom"
NSQ_SOURCE_LINE 00000207 "netbook):"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 " % bench -MData::Clean::JSON -b'$c=Data::Clean::JSON->new' \\"
NSQ_SOURCE_LINE 00000210 "     'Data::Clean::JSON->new->clone_and_clean([1..100])' \\"
NSQ_SOURCE_LINE 00000211 "     '$c->clone_and_clean([1..100])'"
NSQ_SOURCE_LINE 00000212 " Benchmarking sub { Data::Clean::JSON->new->clean_in_place([1..100]) }, sub { $c->clean_in_place([1..100]) } ..."
NSQ_SOURCE_LINE 00000213 " a: 302 calls (291.3/s), 1.037s (3.433ms/call)"
NSQ_SOURCE_LINE 00000214 " b: 7043 calls (4996/s), 1.410s (0.200ms/call)"
NSQ_SOURCE_LINE 00000215 " Fastest is b (17.15x a)"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "Second, you can turn off some checks if you are sure you will not be getting bad"
NSQ_SOURCE_LINE 00000218 "data. For example, if you know that your input will not contain circular"
NSQ_SOURCE_LINE 00000219 "references, you can turn off circular detection:"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 " $cleanser = Data::Clean::JSON->new(-circular => 0);"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "Benchmark:"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 " $ perl -MData::Clean::JSON -MBench -E '"
NSQ_SOURCE_LINE 00000226 "   $data = [[1],[2],[3],[4],[5]];"
NSQ_SOURCE_LINE 00000227 "   bench {"
NSQ_SOURCE_LINE 00000228 "       circ   => sub { state $c = Data::Clean::JSON->new;               $c->clone_and_clean($data) },"
NSQ_SOURCE_LINE 00000229 "       nocirc => sub { state $c = Data::Clean::JSON->new(-circular=>0); $c->clone_and_clean($data) }"
NSQ_SOURCE_LINE 00000230 "   }, -1'"
NSQ_SOURCE_LINE 00000231 " circ: 9456 calls (9425/s), 1.003s (0.106ms/call)"
NSQ_SOURCE_LINE 00000232 " nocirc: 13161 calls (12885/s), 1.021s (0.0776ms/call)"
NSQ_SOURCE_LINE 00000233 " Fastest is nocirc (1.367x circ)"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "The less number of checks you do, the faster the cleansing process will be."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=head2 Why am I getting 'Not a CODE reference at lib/Data/Clean.pm line xxx'?"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "[2013-08-07 ] This error message is from Data::Clone::clone() when it is cloning"
NSQ_SOURCE_LINE 00000240 "an object. If you are cleaning objects, instead of using clone_and_clean(), try"
NSQ_SOURCE_LINE 00000241 "using clean_in_place(). Or, clone your data first using something else like"
NSQ_SOURCE_LINE 00000242 "L<Sereal>."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "LOG_CLEANSER_CODE"
