BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Eval::Closure;"
NSQ_SOURCE_LINE 00000002 "BEGIN {"
NSQ_SOURCE_LINE 00000003 "  $Eval::Closure::AUTHORITY = 'cpan:DOY';"
NSQ_SOURCE_LINE 00000004 "}"
NSQ_SOURCE_LINE 00000005 "$Eval::Closure::VERSION = '0.14';"
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 "# ABSTRACT: safely and cleanly create closures via string eval"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter 'import';"
NSQ_SOURCE_LINE 00000011 "@Eval::Closure::EXPORT = @Eval::Closure::EXPORT_OK = 'eval_closure';"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Carp;"
NSQ_SOURCE_LINE 00000014 "use overload ();"
NSQ_SOURCE_LINE 00000015 "use Scalar::Util qw(reftype);"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "use constant HAS_LEXICAL_SUBS => $] >= 5.018;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub eval_closure {"
NSQ_SOURCE_LINE 00000022 "    my (%args) = @_;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    # default to copying environment"
NSQ_SOURCE_LINE 00000025 "    $args{alias} = 0 if !exists $args{alias};"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    $args{source} = _canonicalize_source($args{source});"
NSQ_SOURCE_LINE 00000028 "    _validate_env($args{environment} ||= {});"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    $args{source} = _line_directive(@args{qw(line description)})"
NSQ_SOURCE_LINE 00000031 "                  . $args{source}"
NSQ_SOURCE_LINE 00000032 "        if defined $args{description} && !($^P & 0x10);"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    my ($code, $e) = _clean_eval_closure(@args{qw(source environment alias)});"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    if (!$code) {"
NSQ_SOURCE_LINE 00000037 "        if ($args{terse_error}) {"
NSQ_SOURCE_LINE 00000038 "            die \"$e\\n\";"
NSQ_SOURCE_LINE 00000039 "        }"
NSQ_SOURCE_LINE 00000040 "        else {"
NSQ_SOURCE_LINE 00000041 "            croak(\"Failed to compile source: $e\\n\\nsource:\\n$args{source}\")"
NSQ_SOURCE_LINE 00000042 "        }"
NSQ_SOURCE_LINE 00000043 "    }"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    return $code;"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub _canonicalize_source {"
NSQ_SOURCE_LINE 00000049 "    my ($source) = @_;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    if (defined($source)) {"
NSQ_SOURCE_LINE 00000052 "        if (ref($source)) {"
NSQ_SOURCE_LINE 00000053 "            if (reftype($source) eq 'ARRAY'"
NSQ_SOURCE_LINE 00000054 "             || overload::Method($source, '@{}')) {"
NSQ_SOURCE_LINE 00000055 "                return join \"\\n\", @$source;"
NSQ_SOURCE_LINE 00000056 "            }"
NSQ_SOURCE_LINE 00000057 "            elsif (overload::Method($source, '\"\"')) {"
NSQ_SOURCE_LINE 00000058 "                return \"$source\";"
NSQ_SOURCE_LINE 00000059 "            }"
NSQ_SOURCE_LINE 00000060 "            else {"
NSQ_SOURCE_LINE 00000061 "                croak(\"The 'source' parameter to eval_closure must be a \""
NSQ_SOURCE_LINE 00000062 "                    . \"string or array reference\");"
NSQ_SOURCE_LINE 00000063 "            }"
NSQ_SOURCE_LINE 00000064 "        }"
NSQ_SOURCE_LINE 00000065 "        else {"
NSQ_SOURCE_LINE 00000066 "            return $source;"
NSQ_SOURCE_LINE 00000067 "        }"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 "    else {"
NSQ_SOURCE_LINE 00000070 "        croak(\"The 'source' parameter to eval_closure is required\");"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub _validate_env {"
NSQ_SOURCE_LINE 00000075 "    my ($env) = @_;"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    croak(\"The 'environment' parameter must be a hashref\")"
NSQ_SOURCE_LINE 00000078 "        unless reftype($env) eq 'HASH';"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "    for my $var (keys %$env) {"
NSQ_SOURCE_LINE 00000081 "        if (HAS_LEXICAL_SUBS) {"
NSQ_SOURCE_LINE 00000082 "            croak(\"Environment key '$var' should start with \\@, \\%, \\$, or \\&\")"
NSQ_SOURCE_LINE 00000083 "                if index('$@%&', substr($var, 0, 1)) < 0;"
NSQ_SOURCE_LINE 00000084 "        }"
NSQ_SOURCE_LINE 00000085 "        else {"
NSQ_SOURCE_LINE 00000086 "            croak(\"Environment key '$var' should start with \\@, \\%, or \\$\")"
NSQ_SOURCE_LINE 00000087 "                if index('$@%', substr($var, 0, 1)) < 0;"
NSQ_SOURCE_LINE 00000088 "        }"
NSQ_SOURCE_LINE 00000089 "        croak(\"Environment values must be references, not $env->{$var}\")"
NSQ_SOURCE_LINE 00000090 "            unless ref($env->{$var});"
NSQ_SOURCE_LINE 00000091 "    }"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "sub _line_directive {"
NSQ_SOURCE_LINE 00000095 "    my ($line, $description) = @_;"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    $line = 1 unless defined($line);"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    return qq{#line $line \"$description\"\\n};"
NSQ_SOURCE_LINE 00000100 "}"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "sub _clean_eval_closure {"
NSQ_SOURCE_LINE 00000103 "    my ($source, $captures, $alias) = @_;"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    my @capture_keys = keys %$captures;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    if ($ENV{EVAL_CLOSURE_PRINT_SOURCE}) {"
NSQ_SOURCE_LINE 00000108 "        _dump_source(_make_compiler_source($source, $alias, @capture_keys));"
NSQ_SOURCE_LINE 00000109 "    }"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    my ($compiler, $e) = _make_compiler($source, $alias, @capture_keys);"
NSQ_SOURCE_LINE 00000112 "    return (undef, $e) unless defined $compiler;"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "    my $code = $compiler->(@$captures{@capture_keys});"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    if (!defined $code) {"
NSQ_SOURCE_LINE 00000117 "        return ("
NSQ_SOURCE_LINE 00000118 "            undef,"
NSQ_SOURCE_LINE 00000119 "            \"The 'source' parameter must return a subroutine reference, \""
NSQ_SOURCE_LINE 00000120 "            . \"not undef\""
NSQ_SOURCE_LINE 00000121 "        )"
NSQ_SOURCE_LINE 00000122 "    }"
NSQ_SOURCE_LINE 00000123 "    if (!ref($code) || ref($code) ne 'CODE') {"
NSQ_SOURCE_LINE 00000124 "        return ("
NSQ_SOURCE_LINE 00000125 "            undef,"
NSQ_SOURCE_LINE 00000126 "            \"The 'source' parameter must return a subroutine reference, not \""
NSQ_SOURCE_LINE 00000127 "            . ref($code)"
NSQ_SOURCE_LINE 00000128 "        )"
NSQ_SOURCE_LINE 00000129 "    }"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    if ($alias) {"
NSQ_SOURCE_LINE 00000132 "        require Devel::LexAlias;"
NSQ_SOURCE_LINE 00000133 "        Devel::LexAlias::lexalias($code, $_, $captures->{$_})"
NSQ_SOURCE_LINE 00000134 "            for grep substr($_, 0, 1) ne '&', @capture_keys;"
NSQ_SOURCE_LINE 00000135 "    }"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    return ($code, $e);"
NSQ_SOURCE_LINE 00000138 "}"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "sub _make_compiler {"
NSQ_SOURCE_LINE 00000141 "    my $source = _make_compiler_source(@_);"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    _clean_eval($source)"
NSQ_SOURCE_LINE 00000144 "}"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "sub _clean_eval {"
NSQ_SOURCE_LINE 00000147 "    local $@;"
NSQ_SOURCE_LINE 00000148 "    local $SIG{__DIE__};"
NSQ_SOURCE_LINE 00000149 "    my $compiler = eval $_[0];"
NSQ_SOURCE_LINE 00000150 "    my $e = $@;"
NSQ_SOURCE_LINE 00000151 "    ( $compiler, $e )"
NSQ_SOURCE_LINE 00000152 "}"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "$Eval::Closure::SANDBOX_ID = 0;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "sub _make_compiler_source {"
NSQ_SOURCE_LINE 00000157 "    my ($source, $alias, @capture_keys) = @_;"
NSQ_SOURCE_LINE 00000158 "    $Eval::Closure::SANDBOX_ID++;"
NSQ_SOURCE_LINE 00000159 "    my $i = 0;"
NSQ_SOURCE_LINE 00000160 "    return join \"\\n\", ("
NSQ_SOURCE_LINE 00000161 "        \"package Eval::Closure::Sandbox_$Eval::Closure::SANDBOX_ID;\","
NSQ_SOURCE_LINE 00000162 "        'sub {',"
NSQ_SOURCE_LINE 00000163 "            (map { _make_lexical_assignment($_, $i++, $alias) } @capture_keys),"
NSQ_SOURCE_LINE 00000164 "            $source,"
NSQ_SOURCE_LINE 00000165 "        '}',"
NSQ_SOURCE_LINE 00000166 "    );"
NSQ_SOURCE_LINE 00000167 "}"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "sub _make_lexical_assignment {"
NSQ_SOURCE_LINE 00000170 "    my ($key, $index, $alias) = @_;"
NSQ_SOURCE_LINE 00000171 "    my $sigil = substr($key, 0, 1);"
NSQ_SOURCE_LINE 00000172 "    my $name = substr($key, 1);"
NSQ_SOURCE_LINE 00000173 "    if (HAS_LEXICAL_SUBS && $sigil eq '&') {"
NSQ_SOURCE_LINE 00000174 "        my $tmpname = '$__' . $name . '__' . $index;"
NSQ_SOURCE_LINE 00000175 "        return 'use feature \"lexical_subs\"; '"
NSQ_SOURCE_LINE 00000176 "             . 'no warnings \"experimental::lexical_subs\"; '"
NSQ_SOURCE_LINE 00000177 "             . 'my ' . $tmpname . ' = $_[' . $index . ']; '"
NSQ_SOURCE_LINE 00000178 "             . 'my sub ' . $name . ' { goto ' . $tmpname . ' }';"
NSQ_SOURCE_LINE 00000179 "    }"
NSQ_SOURCE_LINE 00000180 "    if ($alias) {"
NSQ_SOURCE_LINE 00000181 "        return 'my ' . $key . ';';"
NSQ_SOURCE_LINE 00000182 "    }"
NSQ_SOURCE_LINE 00000183 "    else {"
NSQ_SOURCE_LINE 00000184 "        return 'my ' . $key . ' = ' . $sigil . '{$_[' . $index . ']};';"
NSQ_SOURCE_LINE 00000185 "    }"
NSQ_SOURCE_LINE 00000186 "}"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "sub _dump_source {"
NSQ_SOURCE_LINE 00000189 "    my ($source) = @_;"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "    my $output;"
NSQ_SOURCE_LINE 00000192 "    local $@;"
NSQ_SOURCE_LINE 00000193 "    if (eval { require Perl::Tidy; 1 }) {"
NSQ_SOURCE_LINE 00000194 "        Perl::Tidy::perltidy("
NSQ_SOURCE_LINE 00000195 "            source      => \\$source,"
NSQ_SOURCE_LINE 00000196 "            destination => \\$output,"
NSQ_SOURCE_LINE 00000197 "            argv        => [],"
NSQ_SOURCE_LINE 00000198 "        );"
NSQ_SOURCE_LINE 00000199 "    }"
NSQ_SOURCE_LINE 00000200 "    else {"
NSQ_SOURCE_LINE 00000201 "        $output = $source;"
NSQ_SOURCE_LINE 00000202 "    }"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "    warn \"$output\\n\";"
NSQ_SOURCE_LINE 00000205 "}"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "1;"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "__END__"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=pod"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=head1 NAME"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "Eval::Closure - safely and cleanly create closures via string eval"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=head1 VERSION"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "version 0.14"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "  use Eval::Closure;"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "  my $code = eval_closure("
NSQ_SOURCE_LINE 00000229 "      source      => 'sub { $foo++ }',"
NSQ_SOURCE_LINE 00000230 "      environment => {"
NSQ_SOURCE_LINE 00000231 "          '$foo' => \\1,"
NSQ_SOURCE_LINE 00000232 "      },"
NSQ_SOURCE_LINE 00000233 "  );"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "  warn $code->(); # 1"
NSQ_SOURCE_LINE 00000236 "  warn $code->(); # 2"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "  my $code2 = eval_closure("
NSQ_SOURCE_LINE 00000239 "      source => 'sub { $code->() }',"
NSQ_SOURCE_LINE 00000240 "  ); # dies, $code isn't in scope"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "String eval is often used for dynamic code generation. For instance, C<Moose>"
NSQ_SOURCE_LINE 00000245 "uses it heavily, to generate inlined versions of accessors and constructors,"
NSQ_SOURCE_LINE 00000246 "which speeds code up at runtime by a significant amount. String eval is not"
NSQ_SOURCE_LINE 00000247 "without its issues however - it's difficult to control the scope it's used in"
NSQ_SOURCE_LINE 00000248 "(which determines which variables are in scope inside the eval), and it's easy"
NSQ_SOURCE_LINE 00000249 "to miss compilation errors, since eval catches them and sticks them in $@"
NSQ_SOURCE_LINE 00000250 "instead."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "This module attempts to solve these problems. It provides an C<eval_closure>"
NSQ_SOURCE_LINE 00000253 "function, which evals a string in a clean environment, other than a fixed list"
NSQ_SOURCE_LINE 00000254 "of specified variables. Compilation errors are rethrown automatically."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=head2 eval_closure(%args)"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "This function provides the main functionality of this module. It is exported by"
NSQ_SOURCE_LINE 00000261 "default. It takes a hash of parameters, with these keys being valid:"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=over 4"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=item source"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "The string to be evaled. It should end by returning a code reference. It can"
NSQ_SOURCE_LINE 00000268 "access any variable declared in the C<environment> parameter (and only those"
NSQ_SOURCE_LINE 00000269 "variables). It can be either a string, or an arrayref of lines (which will be"
NSQ_SOURCE_LINE 00000270 "joined with newlines to produce the string)."
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "=item environment"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "The environment to provide to the eval. This should be a hashref, mapping"
NSQ_SOURCE_LINE 00000275 "variable names (including sigils) to references of the appropriate type. For"
NSQ_SOURCE_LINE 00000276 "instance, a valid value for environment would be C<< { '@foo' => [] } >> (which"
NSQ_SOURCE_LINE 00000277 "would allow the generated function to use an array named C<@foo>). Generally,"
NSQ_SOURCE_LINE 00000278 "this is used to allow the generated function to access externally defined"
NSQ_SOURCE_LINE 00000279 "variables (so you would pass in a reference to a variable that already exists)."
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "In perl 5.18 and greater, the environment hash can contain variables with a"
NSQ_SOURCE_LINE 00000282 "sigil of C<&>. This will create a lexical sub in the evaluated code (see"
NSQ_SOURCE_LINE 00000283 "L<feature/The 'lexical_subs' feature>). Using a C<&> sigil on perl versions"
NSQ_SOURCE_LINE 00000284 "before lexical subs were available will throw an error."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=item alias"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "If set to true, the coderef returned closes over the variables referenced in"
NSQ_SOURCE_LINE 00000289 "the environment hashref. (This feature requires L<Devel::LexAlias>.) If set to"
NSQ_SOURCE_LINE 00000290 "false, the coderef closes over a I<< shallow copy >> of the variables."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "If this argument is omitted, Eval::Closure will currently assume false, but"
NSQ_SOURCE_LINE 00000293 "this assumption may change in a future version."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=item description"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "This lets you provide a bit more information in backtraces. Normally, when a"
NSQ_SOURCE_LINE 00000298 "function that was generated through string eval is called, that stack frame"
NSQ_SOURCE_LINE 00000299 "will show up as \"(eval n)\", where 'n' is a sequential identifier for every"
NSQ_SOURCE_LINE 00000300 "string eval that has happened so far in the program. Passing a C<description>"
NSQ_SOURCE_LINE 00000301 "parameter lets you override that to something more useful (for instance,"
NSQ_SOURCE_LINE 00000302 "L<Moose> overrides the description for accessors to something like \"accessor"
NSQ_SOURCE_LINE 00000303 "foo at MyClass.pm, line 123\")."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=item line"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "This lets you override the particular line number that appears in backtraces,"
NSQ_SOURCE_LINE 00000308 "much like the C<description> option. The default is 1."
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=item terse_error"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "Normally, this function appends the source code that failed to compile, and"
NSQ_SOURCE_LINE 00000313 "prepends some explanatory text. Setting this option to true suppresses that"
NSQ_SOURCE_LINE 00000314 "behavior so you get only the compilation error that Perl actually reported."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=back"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=head1 BUGS"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "No known bugs."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "Please report any bugs to GitHub Issues at"
NSQ_SOURCE_LINE 00000323 "L<https://github.com/doy/eval-closure/issues>."
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "=over 4"
