BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Data::Sah::DefaultValue;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "no warnings 'once';"
NSQ_SOURCE_LINE 00000007 "use Log::ger;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Data::Sah::DefaultValueCommon;"
NSQ_SOURCE_LINE 00000010 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000013 "our $DATE = '2024-01-17'; # DATE"
NSQ_SOURCE_LINE 00000014 "our $DIST = 'Data-Sah-DefaultValue'; # DIST"
NSQ_SOURCE_LINE 00000015 "our $VERSION = '0.005'; # VERSION"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our @EXPORT_OK = qw(gen_default_value_code);"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "our %SPEC;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "our $Log_Default_Value_Code = $ENV{LOG_SAH_DEFAULT_VALUE_CODE} // 0;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "$SPEC{gen_default_value_code} = {"
NSQ_SOURCE_LINE 00000024 "    v => 1.1,"
NSQ_SOURCE_LINE 00000025 "    summary => 'Generate code to set default value',"
NSQ_SOURCE_LINE 00000026 "    description => <<'_',"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "This is mostly for testing. Normally the default value rules will be used from"
NSQ_SOURCE_LINE 00000029 "<pm:Data::Sah> via the `x.perl.default_value_rules` or"
NSQ_SOURCE_LINE 00000030 "`x.js.default_value_rules` or `x.default_value_rules` property."
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "_"
NSQ_SOURCE_LINE 00000033 "    args => {"
NSQ_SOURCE_LINE 00000034 "        %Data::Sah::DefaultValueCommon::gen_default_value_code_args,"
NSQ_SOURCE_LINE 00000035 "    },"
NSQ_SOURCE_LINE 00000036 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000037 "};"
NSQ_SOURCE_LINE 00000038 "sub gen_default_value_code {"
NSQ_SOURCE_LINE 00000039 "    my %args = @_;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    my $rules = Data::Sah::DefaultValueCommon::get_default_value_rules("
NSQ_SOURCE_LINE 00000042 "        %args,"
NSQ_SOURCE_LINE 00000043 "        compiler=>'perl',"
NSQ_SOURCE_LINE 00000044 "    );"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    my $code;"
NSQ_SOURCE_LINE 00000047 "    if (@$rules) {"
NSQ_SOURCE_LINE 00000048 "        my $code_require = '';"
NSQ_SOURCE_LINE 00000049 "        my %mem;"
NSQ_SOURCE_LINE 00000050 "        for my $rule (@$rules) {"
NSQ_SOURCE_LINE 00000051 "            next unless $rule->{modules};"
NSQ_SOURCE_LINE 00000052 "            for my $mod (keys %{$rule->{modules}}) {"
NSQ_SOURCE_LINE 00000053 "                next if $mem{$mod}++;"
NSQ_SOURCE_LINE 00000054 "                $code_require .= \"require $mod;\\n\";"
NSQ_SOURCE_LINE 00000055 "            }"
NSQ_SOURCE_LINE 00000056 "        }"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "        my $expr = '';"
NSQ_SOURCE_LINE 00000059 "        for my $i (reverse 0..$#{$rules}) {"
NSQ_SOURCE_LINE 00000060 "            $expr .= (length($expr) ? ' // ' : '') ."
NSQ_SOURCE_LINE 00000061 "                \"($rules->[$i]{expr_value})\";"
NSQ_SOURCE_LINE 00000062 "        }"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "        $code = join("
NSQ_SOURCE_LINE 00000065 "            \"\","
NSQ_SOURCE_LINE 00000066 "            $code_require,"
NSQ_SOURCE_LINE 00000067 "            \"sub { shift // $expr };\\n\","
NSQ_SOURCE_LINE 00000068 "        );"
NSQ_SOURCE_LINE 00000069 "    } else {"
NSQ_SOURCE_LINE 00000070 "        $code = 'sub { shift }';"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    if ($Log_Default_Value_Code) {"
NSQ_SOURCE_LINE 00000074 "        log_trace(\"Default-value code (gen args: %s): %s\", \\%args, $code);"
NSQ_SOURCE_LINE 00000075 "    }"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    return $code if $args{source};"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    my $default_value_code = eval $code; ## no critic: BuiltinFunctions::ProhibitStringyEval"
NSQ_SOURCE_LINE 00000080 "    die if $@;"
NSQ_SOURCE_LINE 00000081 "    $default_value_code;"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "1;"
NSQ_SOURCE_LINE 00000085 "# ABSTRACT: Default-value rules for Data::Sah"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "__END__"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=pod"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=head1 NAME"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "Data::Sah::DefaultValue - Default-value rules for Data::Sah"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head1 VERSION"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "This document describes version 0.005 of Data::Sah::DefaultValue (from Perl distribution Data-Sah-DefaultValue), released on 2024-01-17."
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 " use Data::Sah::DefaultValue  qw(gen_default_value_code);"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 " # a utility routine: gen_default_value_code"
NSQ_SOURCE_LINE 00000106 " my $dv = gen_default_value_code("
NSQ_SOURCE_LINE 00000107 "     default_value_rules => ['Perl::this_mod'],"
NSQ_SOURCE_LINE 00000108 " );"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 " my $val = $c->(123);          # unchanged, 123"
NSQ_SOURCE_LINE 00000111 " my $val = $c->(undef);        # becomes \"Some::Module\""
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "This module generates code to set default value using value rules."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "A value rule is put in C<Data::Sah::Value::$COMPILER::$TOPIC::$DESCRIPTION>"
NSQ_SOURCE_LINE 00000118 "module, for example: L<Data::Sah::Value::perl::Perl::this_mod> contains the"
NSQ_SOURCE_LINE 00000119 "value \"this module\" (see L<App::ThisDist> for more details on the meaning of"
NSQ_SOURCE_LINE 00000120 "\"this module\")."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "Basically, a value rule will provide an expression (C<expr_value>) that return"
NSQ_SOURCE_LINE 00000123 "some value."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "The module must contain C<meta> subroutine which must return a hashref that has"
NSQ_SOURCE_LINE 00000126 "the following keys (C<*> marks that the key is required):"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=over"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=item * v* => int (default: 1)"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "Metadata specification version. From L<DefHash>. Currently at 4."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=item * summary => str"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "From L<DefHash>."
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=back"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "The module must also contain C<value> subroutine which must generate the code"
NSQ_SOURCE_LINE 00000141 "for default value. The subroutine must accept a hash of arguments (C<*>"
NSQ_SOURCE_LINE 00000142 "indicates required arguments):"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=over"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=back"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "The C<value> subroutine must return a hashref with the following keys (C<*>"
NSQ_SOURCE_LINE 00000149 "indicates required keys):"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=over"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=item * expr_value => str"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "Expression in the target language that produces the value."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=item * modules => hash"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "A list of modules required by the expressions."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=back"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=head1 VARIABLES"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=head2 $Log_Default_Value_Code => bool (default: from ENV or 0)"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "If set to true, will log the generated default-value code (currently using"
NSQ_SOURCE_LINE 00000168 "L<Log::ger> at trace level). To see the log message, e.g. to the screen, you can"
NSQ_SOURCE_LINE 00000169 "use something like:"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 " % TRACE=1 perl -MLog::ger::LevelFromEnv -MLog::ger::Output=Screen \\"
NSQ_SOURCE_LINE 00000172 "     -MData::Sah::DefaultValue=gen_default_value_code -E'my $c = gen_default_value_code(...)'"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=head2 gen_default_value_code"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "Usage:"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 " gen_default_value_code(%args) -> any"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "Generate code to set default value."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "This is mostly for testing. Normally the default value rules will be used from"
NSQ_SOURCE_LINE 00000186 "L<Data::Sah> via the C<x.perl.default_value_rules> or"
NSQ_SOURCE_LINE 00000187 "C<x.js.default_value_rules> or C<x.default_value_rules> property."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=over 4"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=item * B<default_value_rules> => I<array[str]>"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "A specification of default-value rules to use (or avoid)."
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "This setting is used to specify which default-value rules to use (or avoid) in a"
NSQ_SOURCE_LINE 00000200 "flexible way. Each element is a string, in the form of either C<NAME> to mean"
NSQ_SOURCE_LINE 00000201 "specifically include a rule, or C<!NAME> to exclude a rule."
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "To use the default-value rules R1 and R2:"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 " ['R1', 'R2']"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=item * B<source> => I<bool>"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "If set to true, will return coercer source code string instead of compiled code."
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=back"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "Return value:  (any)"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "=head2 LOG_SAH_DEFAULT_VALUE_CODE => bool"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "Set default for C<$Log_Default_Value_Code>."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "Please visit the project's homepage at L<https://metacpan.org/release/Data-Sah-DefaultValue>."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "Source repository is at L<https://github.com/perlancar/perl-Data-Sah-DefaultValue>."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000231 ""
