NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "require 5.005;"
NSQ_SOURCE_LINE 00000023 "use strict;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "my ($APACHE, $WIN32);"
NSQ_SOURCE_LINE 00000026 "$APACHE\t= $Apache::ASP::VERSION; "
NSQ_SOURCE_LINE 00000027 "$WIN32\t= $^O =~ /win/i;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "package ASP::IO;"
NSQ_SOURCE_LINE 00000030 "sub TIEHANDLE\t{ shift->new(@_) }"
NSQ_SOURCE_LINE 00000031 "sub PRINT\t\t{ shift->print(@_) }"
NSQ_SOURCE_LINE 00000032 "sub PRINTF\t\t{ shift->print(sprintf(@_)) }"
NSQ_SOURCE_LINE 00000033 "sub new { bless {}, shift; }"
NSQ_SOURCE_LINE 00000034 "sub print {"
NSQ_SOURCE_LINE 00000035 "    my $self = shift;"
NSQ_SOURCE_LINE 00000036 "    ASP::Print(@_);"
NSQ_SOURCE_LINE 00000037 "    1;"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "1;"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "package ASP;"
NSQ_SOURCE_LINE 00000043 "use vars qw($VERSION @ISA @EXPORT @EXPORT_OK $ASPOUT);"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "require CGI;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "BEGIN {"
NSQ_SOURCE_LINE 00000048 "\trequire Exporter;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "\tuse vars qw( @ISA @EXPORT @EXPORT_OK %EXPORT_TAGS"
NSQ_SOURCE_LINE 00000051 "\t\t$Application $ObjectContext $Request $Response"
NSQ_SOURCE_LINE 00000052 "\t\t$Server $Session $ScriptingNamespace @DeathHooks"
NSQ_SOURCE_LINE 00000053 "\t\t);"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "\t@ISA = qw( Exporter );"
NSQ_SOURCE_LINE 00000056 "\t%EXPORT_TAGS =\t("
NSQ_SOURCE_LINE 00000057 "\t\tbasic => [qw("
NSQ_SOURCE_LINE 00000058 "\t\t\tPrint Warn die exit param param_count"
NSQ_SOURCE_LINE 00000059 "\t\t\t)],"
NSQ_SOURCE_LINE 00000060 "\t\tstrict => [qw("
NSQ_SOURCE_LINE 00000061 "\t\t\tPrint Warn die exit param param_count"
NSQ_SOURCE_LINE 00000062 "\t\t\t$Application $ObjectContext $Request"
NSQ_SOURCE_LINE 00000063 "\t\t\t$Response $Server $Session"
NSQ_SOURCE_LINE 00000064 "\t\t\t$ScriptingNamespace"
NSQ_SOURCE_LINE 00000065 "\t\t\t)],"
NSQ_SOURCE_LINE 00000066 "\t\tall => [qw("
NSQ_SOURCE_LINE 00000067 "\t\t\tPrint Warn die exit param param_count"
NSQ_SOURCE_LINE 00000068 "\t\t\t$Application $ObjectContext $Request"
NSQ_SOURCE_LINE 00000069 "\t\t\t$Response $Server $Session"
NSQ_SOURCE_LINE 00000070 "\t\t\t$ScriptingNamespace"
NSQ_SOURCE_LINE 00000071 "\t\t\tDebugPrint HTMLPrint"
NSQ_SOURCE_LINE 00000072 "\t\t\tescape unescape escapeHTML unescapeHTML"
NSQ_SOURCE_LINE 00000073 "\t\t\t)],"
NSQ_SOURCE_LINE 00000074 "\t);"
NSQ_SOURCE_LINE 00000075 "\tExporter::export_tags('basic');"
NSQ_SOURCE_LINE 00000076 "\tExporter::export_ok_tags('all');"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "\t$Application = $main::Application;"
NSQ_SOURCE_LINE 00000079 "\t$ObjectContext = $main::ObjectContext;"
NSQ_SOURCE_LINE 00000080 "\t$Request = $main::Request;"
NSQ_SOURCE_LINE 00000081 "\t$Response = $main::Response;"
NSQ_SOURCE_LINE 00000082 "\t$Server = $main::Server;"
NSQ_SOURCE_LINE 00000083 "\t$Session = $main::Session;"
NSQ_SOURCE_LINE 00000084 "\t$ScriptingNamespace = $main::ScriptingNamespace unless $APACHE;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "\tif ($WIN32) {"
NSQ_SOURCE_LINE 00000087 "\t\t%ENV = ();"
NSQ_SOURCE_LINE 00000088 "\t\tfor (Win32::OLE::in $Request->ServerVariables) {"
NSQ_SOURCE_LINE 00000089 "\t\t\t$ENV{$_} = $Request->ServerVariables($_)->Item;"
NSQ_SOURCE_LINE 00000090 "\t\t}"
NSQ_SOURCE_LINE 00000091 "\t}"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "$VERSION='1.07';"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "$ASPOUT = tie *RESPONSE_FH, 'ASP::IO';"
NSQ_SOURCE_LINE 00000097 "select RESPONSE_FH unless $APACHE;"
NSQ_SOURCE_LINE 00000098 "$SIG{__WARN__} = sub { ASP::Print(@_) };"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "sub _END { &$_() for  @DeathHooks; @DeathHooks = (); 1; }"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 NAME"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "ASP - a Module for ASP (PerlScript) Programming"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "\tuse strict;"
NSQ_SOURCE_LINE 00000109 "\tuse ASP qw(:strict);"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "\tprint \"Testing, testing.<BR><BR>\";"
NSQ_SOURCE_LINE 00000112 "\tmy $item = param('item');"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "\tif($item eq 'Select one...') {"
NSQ_SOURCE_LINE 00000115 "\t    die \"Please select a value from the list.\";"
NSQ_SOURCE_LINE 00000116 "\t}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "\tprint \"You selected $item.\";"
NSQ_SOURCE_LINE 00000119 "\texit;"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "This module is based on Matt Sergeant's excellent"
NSQ_SOURCE_LINE 00000124 "Win32::ASP module, which can be found at"
NSQ_SOURCE_LINE 00000125 "E<lt>F<http://www.fastnetltd.ndirect.co.uk/Perl>E<gt>."
NSQ_SOURCE_LINE 00000126 "After using Mr. Sergeant's module, I took on the task of"
NSQ_SOURCE_LINE 00000127 "customizing and optimizing it for my own purposes. Feel"
NSQ_SOURCE_LINE 00000128 "free to use it if you find it useful."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=head1 NOTES"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "This module is designed to work with both ASP PerlScript on IIS4,"
NSQ_SOURCE_LINE 00000133 "as well as mod_perl/Apache::ASP on *nix platforms. Apache::ASP"
NSQ_SOURCE_LINE 00000134 "already provides some of the functionality provided by this module;"
NSQ_SOURCE_LINE 00000135 "because of this (and to avoid redundancy), ASP.pm attempts to detect"
NSQ_SOURCE_LINE 00000136 "its environment. Differences between Apache and MS ASP are noted."
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "Both of the print() and warn() standard perl funcs are overloaded"
NSQ_SOURCE_LINE 00000139 "to output to the browser. print() is also available via the"
NSQ_SOURCE_LINE 00000140 "$ASP::ASPOUT->print() method call."
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "$Request->ServerVariables are only stuffed into %ENV on Win32"
NSQ_SOURCE_LINE 00000143 "platforms, as Apache::ASP already provides this."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "ASP.pm also exports the $ScriptingNamespace symbol (Win32 only)."
NSQ_SOURCE_LINE 00000146 "This symbol allows PerlScript to call subs/functions written in"
NSQ_SOURCE_LINE 00000147 "another script language. For example:"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    <%@ language=PerlScript %>"
NSQ_SOURCE_LINE 00000150 "    <%"
NSQ_SOURCE_LINE 00000151 "        use ASP qw(:strict);"
NSQ_SOURCE_LINE 00000152 "        print $ScriptingNamespace->SomeSub(\"arg1\");"
NSQ_SOURCE_LINE 00000153 "    %>"
NSQ_SOURCE_LINE 00000154 "    <SCRIPT language=VBScript runat=server>"
NSQ_SOURCE_LINE 00000155 "    Function SomeSub (str)"
NSQ_SOURCE_LINE 00000156 "        SomeSub = SomethingThatReturnsSomething()"
NSQ_SOURCE_LINE 00000157 "    End Function"
NSQ_SOURCE_LINE 00000158 "    </SCRIPT>"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=head1 USE"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head2 use ASP qw(:basic);"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "Exports basic subs: Print, Warn, die, exit, param, param_count. Same"
NSQ_SOURCE_LINE 00000165 "as C<use ASP;>"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=head2 use ASP qw(:strict);"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "Allows the use of the ASP objects under C<use strict;>."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "NOTE: This is not the only way to accomplish this, but I think it's"
NSQ_SOURCE_LINE 00000172 "the cleanest, most convenient way."
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "=head2 use ASP qw(:all);"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "Exports all subs except those marked 'not exported'."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=head2 use ASP ();"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "Overloads print() and warn() and provides the $ASP::ASPOUT object."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head1 FUNCTION REFERENCE"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=head2 warn LIST"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "C<warn> (or more specifically, the __WARN__ signal) has been re-routed to"
NSQ_SOURCE_LINE 00000187 "output to the browser."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "FYI: When implemented, this tweak led to the removal of the prototypes"
NSQ_SOURCE_LINE 00000190 "Matt placed on his subs."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=head2 Warn LIST"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "C<Warn> is an alias for the ASP::Print method described below. The"
NSQ_SOURCE_LINE 00000195 "overloading of C<warn> as described above does not currently work"
NSQ_SOURCE_LINE 00000196 "in Apache::ASP, so this is provided."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "=cut"
NSQ_SOURCE_LINE 00000199 "sub Warn { ASP::Print(@_); }"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=head2 print LIST"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "C<print> is overloaded to write to the browser by default. The inherent"
NSQ_SOURCE_LINE 00000204 "behavior of print has not been altered and you can still use an alternate"
NSQ_SOURCE_LINE 00000205 "filehandle as you normally would. This allows you to use print just"
NSQ_SOURCE_LINE 00000206 "as you would in CGI scripts. The following statement would need no"
NSQ_SOURCE_LINE 00000207 "modification between CGI and ASP PerlScript:"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "    print param('URL'), \" was requested by \", $ENV{REMOTE_HOST}, \"\\n\";"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=head2 Print LIST"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "Prints a string or comma separated list of strings to the browser. Use"
NSQ_SOURCE_LINE 00000214 "as if you were using C<print> in a CGI application. Print gets around ASP's"
NSQ_SOURCE_LINE 00000215 "limitations of 128k in a single $Response->Write() call."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "NB: C<print> calls Print, so you could use either, but"
NSQ_SOURCE_LINE 00000218 "print more closely resembles perl."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=cut"
NSQ_SOURCE_LINE 00000221 "sub Print {"
NSQ_SOURCE_LINE 00000222 "\tfor (@_) {"
NSQ_SOURCE_LINE 00000223 "\t\tif ( length($_) > 128000 ) {"
NSQ_SOURCE_LINE 00000224 "\t\t\tASP::Print( unpack('a128000a*', $_) );"
NSQ_SOURCE_LINE 00000225 "\t\t} else {"
NSQ_SOURCE_LINE 00000226 "\t\t\t$main::Response->Write($_);"
NSQ_SOURCE_LINE 00000227 "\t\t}"
NSQ_SOURCE_LINE 00000228 "\t}"
NSQ_SOURCE_LINE 00000229 "}"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=head2 DebugPrint LIST"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "Output is displayed between HTML comments so the output doesn't"
NSQ_SOURCE_LINE 00000234 "interfere with page aesthetics."
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=cut"
NSQ_SOURCE_LINE 00000237 "sub DebugPrint { ASP::Print(\"<!--\\n\", @_, \"\\n-->\"); }"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=head2 HTMLPrint LIST"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "The same as C<Print> except the output is HTML-encoded so that"
NSQ_SOURCE_LINE 00000242 "any HTML tags appear as sent, i.e. E<lt> becomes &lt;, E<gt> becomes &gt; etc."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=cut"
NSQ_SOURCE_LINE 00000245 "sub HTMLPrint { map { ASP::Print($main::Server->HTMLEncode($_)) } @_ ; }"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head2 die LIST"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "Prints the contents of LIST to the browser and then exits. die"
NSQ_SOURCE_LINE 00000250 "automatically calls $Response->End for you, it also executes any"
NSQ_SOURCE_LINE 00000251 "cleanup code you have added with C<AddDeathHook>."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=cut"
NSQ_SOURCE_LINE 00000254 "sub die {"
NSQ_SOURCE_LINE 00000255 "\tASP::Print(@_, \"</BODY></HTML>\");"
NSQ_SOURCE_LINE 00000256 "\t_END;"
NSQ_SOURCE_LINE 00000257 "\t$main::Response->End();"
NSQ_SOURCE_LINE 00000258 "\tCORE::die();"
NSQ_SOURCE_LINE 00000259 "}"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=head2 exit"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "Exits the current script. $Response->End is called automatically for you."
NSQ_SOURCE_LINE 00000264 "Any cleanup code added with C<AddDeathHook> is also called."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=cut"
NSQ_SOURCE_LINE 00000267 "sub exit {"
NSQ_SOURCE_LINE 00000268 "\t_END;"
NSQ_SOURCE_LINE 00000269 "\t$main::Response->End();"
NSQ_SOURCE_LINE 00000270 "\tCORE::exit();"
NSQ_SOURCE_LINE 00000271 "}"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=head2 escape LIST"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Escapes (URL-encodes) a list. Uses ASP object method"
NSQ_SOURCE_LINE 00000276 "$Server->URLEncode()."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=cut"
NSQ_SOURCE_LINE 00000279 "sub escape { map { $main::Server->URLEncode($_) } @_; }"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=head2 unescape LIST"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "Unescapes a URL-encoded list. Algorithms ripped from CGI.pm"
NSQ_SOURCE_LINE 00000284 "method of the same name."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=cut"
NSQ_SOURCE_LINE 00000287 "sub unescape {"
NSQ_SOURCE_LINE 00000288 "\tmap {"
NSQ_SOURCE_LINE 00000289 "\t\ttr/+/ /;"
NSQ_SOURCE_LINE 00000290 "\t\ts/%([0-9a-fA-F]{2})/pack(\"c\",hex($1))/ge;"
NSQ_SOURCE_LINE 00000291 "\t} @_;"
NSQ_SOURCE_LINE 00000292 "}"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=head2 escapeHTML LIST"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "Escapes a list of HTML. Uses ASP object method $Server->HTMLEncode()."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "If passed an array reference, escapeHTML will return a reference"
NSQ_SOURCE_LINE 00000299 "to the escaped array."
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=cut"
NSQ_SOURCE_LINE 00000302 "sub escapeHTML {"
NSQ_SOURCE_LINE 00000303 "\tmy ($flag, @args) = (0, @_);"
NSQ_SOURCE_LINE 00000304 "\t@args = @{$args[0]} and $flag++ if ref $args[0] eq \"ARRAY\"; "
NSQ_SOURCE_LINE 00000305 "\t$_ = $main::Server->HTMLEncode($_) for @args;"
NSQ_SOURCE_LINE 00000306 "\t$flag ? \\@args : @args;"
NSQ_SOURCE_LINE 00000307 "}"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head2 unescapeHTML LIST"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "Unescapes an HTML-encoded list."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "If passed an array reference, unescapeHTML will return a reference"
NSQ_SOURCE_LINE 00000314 "to the un-escaped array."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=cut"
NSQ_SOURCE_LINE 00000317 "sub unescapeHTML {"
NSQ_SOURCE_LINE 00000318 "\tmy ($flag, @args) = (0, @_);"
NSQ_SOURCE_LINE 00000319 "\t@args = @{$args[0]} and $flag++ if ref $args[0] eq \"ARRAY\"; "
NSQ_SOURCE_LINE 00000320 "\tmap {"
NSQ_SOURCE_LINE 00000321 "\t\ts/&amp;/&/gi;"
NSQ_SOURCE_LINE 00000322 "\t\ts/&quot;/\"/gi;"
NSQ_SOURCE_LINE 00000323 "\t\ts/&nbsp;/ /gi;"
NSQ_SOURCE_LINE 00000324 "\t\ts/&gt;/>/gi;"
NSQ_SOURCE_LINE 00000325 "\t\ts/&lt;/</gi;"
NSQ_SOURCE_LINE 00000326 "\t\ts/&#(\\d+);/chr($1)/ge;"
NSQ_SOURCE_LINE 00000327 "\t\ts/&#x([0-9a-f]+);/chr(hex($1))/gi;"
NSQ_SOURCE_LINE 00000328 "\t} @args;"
NSQ_SOURCE_LINE 00000329 "\t$flag ? \\@args : @args;"
NSQ_SOURCE_LINE 00000330 "}"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=head2 param EXPR [, EXPR]"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "Simplifies parameter access and makes switch from GET to POST transparent."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "Given the following querystring:"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "\tmyscript.asp?x=a&x=b&y=c"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "    param()      returns ('x', 'y')"
NSQ_SOURCE_LINE 00000341 "    param('y')   returns 'c'"
NSQ_SOURCE_LINE 00000342 "    param('x')   returns ('a', 'b')"
NSQ_SOURCE_LINE 00000343 "    param('x',1) returns 'a'"
NSQ_SOURCE_LINE 00000344 "    param('x',2) returns 'b'"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "NOTE: Under Apache::ASP, param() simply passes the arguments"
NSQ_SOURCE_LINE 00000347 "to CGI::param() because Apache::ASP doesn't support the $obj->{Count}"
NSQ_SOURCE_LINE 00000348 "property used in this function."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "=cut"
NSQ_SOURCE_LINE 00000351 "sub param {"
NSQ_SOURCE_LINE 00000352 "\tif ($APACHE) {"
NSQ_SOURCE_LINE 00000353 "\t\treturn (wantarray) ? (CGI::param(@_)) : scalar(CGI::param(@_));"
NSQ_SOURCE_LINE 00000354 "\t}"
NSQ_SOURCE_LINE 00000355 "\tunless (@_) {"
NSQ_SOURCE_LINE 00000356 "\t\tmy @keys;"
NSQ_SOURCE_LINE 00000357 "\t\tpush( @keys, $_ ) for ( Win32::OLE::in $main::Request->QueryString );"
NSQ_SOURCE_LINE 00000358 "\t\tpush( @keys, $_ ) for ( Win32::OLE::in $main::Request->Form );"
NSQ_SOURCE_LINE 00000359 "\t\treturn @keys;"
NSQ_SOURCE_LINE 00000360 "\t}"
NSQ_SOURCE_LINE 00000361 "\t$_[1] = 1 unless defined $_[1];"
NSQ_SOURCE_LINE 00000362 "\tunless (wantarray) {"
NSQ_SOURCE_LINE 00000363 "\t\tif ($main::Request->ServerVariables('REQUEST_METHOD')->Item eq 'GET') {"
NSQ_SOURCE_LINE 00000364 "\t\t\treturn $main::Request->QueryString($_[0])->Item($_[1]);"
NSQ_SOURCE_LINE 00000365 "\t\t} else {"
NSQ_SOURCE_LINE 00000366 "\t\t\treturn $main::Request->Form($_[0])->Item($_[1]);"
NSQ_SOURCE_LINE 00000367 "\t\t}"
NSQ_SOURCE_LINE 00000368 "\t} else {"
NSQ_SOURCE_LINE 00000369 "\t\tmy ($i, @ret);"
NSQ_SOURCE_LINE 00000370 "\t\tif ($main::Request->ServerVariables('REQUEST_METHOD')->Item eq 'GET') {"
NSQ_SOURCE_LINE 00000371 "\t\t\tmy $count = $main::Request->QueryString($_[0])->{Count};"
NSQ_SOURCE_LINE 00000372 "\t\t\tfor ($i = 1; $i <= $count; $i++ ) {"
NSQ_SOURCE_LINE 00000373 "\t\t\t\tpush @ret, $main::Request->QueryString($_[0])->Item($i);"
NSQ_SOURCE_LINE 00000374 "\t\t\t}"
NSQ_SOURCE_LINE 00000375 "\t\t} else {"
NSQ_SOURCE_LINE 00000376 "\t\t\tmy $count = $main::Request->Form($_[0])->{Count};"
NSQ_SOURCE_LINE 00000377 "\t\t\tfor ($i = 1; $i <= $count; $i++) {"
NSQ_SOURCE_LINE 00000378 "\t\t\t\tpush @ret, $main::Request->Form($_[0])->Item($i);"
NSQ_SOURCE_LINE 00000379 "\t\t\t}"
NSQ_SOURCE_LINE 00000380 "\t\t}"
NSQ_SOURCE_LINE 00000381 "\t\treturn @ret;"
NSQ_SOURCE_LINE 00000382 "\t}"
NSQ_SOURCE_LINE 00000383 "}"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=head2 param_count EXPR"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "Returns the number of times EXPR appears in the request (Form or"
NSQ_SOURCE_LINE 00000388 "QueryString)."
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "For example, if URL is"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "\tmyscript.asp?x=a&x=b&y=c"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "then"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "\tparam_count('x');"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "returns 2."
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "NOTE: Under Apache::ASP, param_count() performs some manipulation"
NSQ_SOURCE_LINE 00000401 "using CGI::param() because Apache::ASP doesn't support the"
NSQ_SOURCE_LINE 00000402 "$obj->{Count} property used in this function."
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 " "
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "=cut"
NSQ_SOURCE_LINE 00000407 "sub param_count {"
NSQ_SOURCE_LINE 00000408 "\tif ($APACHE) {"
NSQ_SOURCE_LINE 00000409 "\t\treturn scalar( @{[ CGI::param($_[0]) ]} );"
NSQ_SOURCE_LINE 00000410 "\t}"
NSQ_SOURCE_LINE 00000411 "\tif ($main::Request->ServerVariables('REQUEST_METHOD')->Item eq 'GET') {"
NSQ_SOURCE_LINE 00000412 "\t\treturn $main::Request->QueryString($_[0])->{Count};"
NSQ_SOURCE_LINE 00000413 "\t} else {"
NSQ_SOURCE_LINE 00000414 "\t\treturn $main::Request->Form($_[0])->{Count};"
NSQ_SOURCE_LINE 00000415 "\t}"
NSQ_SOURCE_LINE 00000416 "}"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "=head2 AddDeathHook LIST"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "Allows cleanup code to be executed when you C<die> or C<exit>."
NSQ_SOURCE_LINE 00000421 "Useful for closing database connections in the event of a"
NSQ_SOURCE_LINE 00000422 "fatal error."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "\t<%"
NSQ_SOURCE_LINE 00000425 "\tmy $conn = Win32::OLE-new('ADODB.Connection');"
NSQ_SOURCE_LINE 00000426 "\t$conn->Open(\"MyDSN\");"
NSQ_SOURCE_LINE 00000427 "\t$conn->BeginTrans();"
NSQ_SOURCE_LINE 00000428 "\tASP::AddDeathHook( sub { $Conn->Close if $Conn; } );"
NSQ_SOURCE_LINE 00000429 "\t%>"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "Death hooks are not executed except by explicitly calling the die() or exit()"
NSQ_SOURCE_LINE 00000432 "methods provided by ASP.pm."
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "AddDeathHook is not exported."
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "=cut"
NSQ_SOURCE_LINE 00000437 "sub AddDeathHook { push @DeathHooks, @_; }"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "# These two functions are ripped from CGI.pm"
NSQ_SOURCE_LINE 00000440 "sub expire_calc {"
NSQ_SOURCE_LINE 00000441 "    my($time) = @_;"
NSQ_SOURCE_LINE 00000442 "    my(%mult) = ('s'=>1,"
NSQ_SOURCE_LINE 00000443 "                 'm'=>60,"
NSQ_SOURCE_LINE 00000444 "                 'h'=>60*60,"
NSQ_SOURCE_LINE 00000445 "                 'd'=>60*60*24,"
NSQ_SOURCE_LINE 00000446 "                 'M'=>60*60*24*30,"
NSQ_SOURCE_LINE 00000447 "                 'y'=>60*60*24*365);"
NSQ_SOURCE_LINE 00000448 "    # format for time can be in any of the forms..."
NSQ_SOURCE_LINE 00000449 "    # \"now\" -- expire immediately"
NSQ_SOURCE_LINE 00000450 "    # \"+180s\" -- in 180 seconds"
NSQ_SOURCE_LINE 00000451 "    # \"+2m\" -- in 2 minutes"
NSQ_SOURCE_LINE 00000452 "    # \"+12h\" -- in 12 hours"
NSQ_SOURCE_LINE 00000453 "    # \"+1d\"  -- in 1 day"
NSQ_SOURCE_LINE 00000454 "    # \"+3M\"  -- in 3 months"
NSQ_SOURCE_LINE 00000455 "    # \"+2y\"  -- in 2 years"
NSQ_SOURCE_LINE 00000456 "    # \"-3m\"  -- 3 minutes ago(!)"
NSQ_SOURCE_LINE 00000457 "    # If you don't supply one of these forms, we assume you are"
NSQ_SOURCE_LINE 00000458 "    # specifying the date yourself"
NSQ_SOURCE_LINE 00000459 "    my $offset;"
NSQ_SOURCE_LINE 00000460 "    if ( !$time || $time eq 'now' ) {"
NSQ_SOURCE_LINE 00000461 "        $offset = 0;"
NSQ_SOURCE_LINE 00000462 "    } elsif ( $time =~ /^([+-]?\\d+)([mhdMy]?)/ ) {"
NSQ_SOURCE_LINE 00000463 "        $offset = ($mult{$2} || 1)*$1;"
NSQ_SOURCE_LINE 00000464 "    } else {"
NSQ_SOURCE_LINE 00000465 "        return $time;"
NSQ_SOURCE_LINE 00000466 "    }"
NSQ_SOURCE_LINE 00000467 "    return ($time + $offset);"
NSQ_SOURCE_LINE 00000468 "}"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000471 ""
