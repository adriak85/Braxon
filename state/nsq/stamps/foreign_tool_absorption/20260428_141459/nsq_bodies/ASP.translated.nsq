NSQ_SOURCE_LINE 00000474 "=head1 HISTORY"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "=over 4"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "=item Version 1.07"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "Added Warn() because warn() overloading doesn't appear to work"
NSQ_SOURCE_LINE 00000481 "under Apache::ASP."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "Was forced to clear @DeathHooks array after calling _END() because"
NSQ_SOURCE_LINE 00000484 "of the persistent state of Apache::ASP holding over contents across"
NSQ_SOURCE_LINE 00000485 "executions."
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "Removed BinaryWrite(), SetCookie(), and Autoload functionality."
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "=item Version 1.00"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "The escapeHTML() and unescapeHTML() functions now accept array refs as well"
NSQ_SOURCE_LINE 00000492 "as lists, as Win32::ASP::HTMLEncode() was supposed to."
NSQ_SOURCE_LINE 00000493 "Thanks to Matt Sergeant for the fix."
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "=item Version 0.97"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "Optimized and debugged."
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "=item Version 0.77"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "Overloaded warn() and subsequently removed prototypes."
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "Exported $ScriptingNamespace object."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "Added methods escape(), unescape(), escapeHTML(), unescapeHTML()."
NSQ_SOURCE_LINE 00000506 "Thanks to Bill Odom for pointing these out!"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "Re-implemented SetCookie and BinaryWrite functions."
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "=item Version 0.11"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "Optimized and debugged."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=back"
NSQ_SOURCE_LINE 00000515 ""
