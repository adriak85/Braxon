BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Devel::LexAlias;"
NSQ_SOURCE_LINE 00000002 "require DynaLoader;"
NSQ_SOURCE_LINE 00000003 "use Devel::Caller qw(caller_cv);"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "require 5.005003;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "@ISA = qw(Exporter DynaLoader);"
NSQ_SOURCE_LINE 00000008 "@EXPORT_OK = qw(lexalias);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "$VERSION = '0.05';"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "bootstrap Devel::LexAlias $VERSION;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub lexalias {"
NSQ_SOURCE_LINE 00000015 "    my $cv = shift;"
NSQ_SOURCE_LINE 00000016 "    unless (ref $cv eq 'CODE') {"
NSQ_SOURCE_LINE 00000017 "        $cv = caller_cv($cv + 1);"
NSQ_SOURCE_LINE 00000018 "    }"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    return _lexalias($cv, @_);"
NSQ_SOURCE_LINE 00000021 "}"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "1;"
NSQ_SOURCE_LINE 00000024 "__END__"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "=head1 NAME"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "Devel::LexAlias - alias lexical variables"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 " use Devel::LexAlias qw(lexalias);"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 " sub steal_my_x {"
NSQ_SOURCE_LINE 00000035 "     my $foo = 1;"
NSQ_SOURCE_LINE 00000036 "     lexalias(1, '$x', \\$foo);"
NSQ_SOURCE_LINE 00000037 " }"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 " sub foo {"
NSQ_SOURCE_LINE 00000040 "     my $x = 22;"
NSQ_SOURCE_LINE 00000041 "     print $x; # prints 22"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "     steal_my_x;"
NSQ_SOURCE_LINE 00000044 "     print $x; # prints 1"
NSQ_SOURCE_LINE 00000045 " }"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "Devel::LexAlias provides the ability to alias a lexical variable in a"
NSQ_SOURCE_LINE 00000050 "subroutines scope to one of your choosing."
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "If you don't know why you'd want to do this, I'd suggest that you skip"
NSQ_SOURCE_LINE 00000053 "this module.  If you think you have a use for it, I'd insist on it."
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "Still here?"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=over"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=item lexalias( $where, $name, $variable )"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "C<$where> refers to the subroutine in which to alias the lexical, it"
NSQ_SOURCE_LINE 00000062 "can be a coderef or a call level such that you'd give to C<caller>"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "C<$name> is the name of the lexical within that subroutine"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "C<$variable> is a reference to the variable to install at that location"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=back"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=head1 BUGS"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "lexalias delves into the internals of the interpreter to perform its"
NSQ_SOURCE_LINE 00000073 "actions and is so very sensitive to bad data, which will likely result"
NSQ_SOURCE_LINE 00000074 "in flaming death, or a core dump.  Consider this a warning."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "There is no checking that you are attaching a suitable variable back"
NSQ_SOURCE_LINE 00000077 "into the pad as implied by the name of the variable, so it is possible"
NSQ_SOURCE_LINE 00000078 "to do the following:"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 " lexalias( $sub, '$foo', [qw(an array)] );"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "The behaviour of this is untested, I imagine badness is very close on"
NSQ_SOURCE_LINE 00000083 "the horizon though."
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "peek_sub from L<PadWalker>, L<Devel::Peek>"
NSQ_SOURCE_LINE 00000088 ""
