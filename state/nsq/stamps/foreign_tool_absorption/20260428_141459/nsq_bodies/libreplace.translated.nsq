NSQ_SOURCE_LINE 00000001 "package libreplace;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $VERSION = '0.01';"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use 5.006;"
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "sub import {"
NSQ_SOURCE_LINE 00000010 "\t@INC = split ':', $ENV{PERL5LIB};"
NSQ_SOURCE_LINE 00000011 "}"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "__END__"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "=head1 NAME"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "libreplace - Clobber your lib with PERL5LIB"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "The environmental variable C<PERL5LIB> appends to C<@INC>, by using"
NSQ_SOURCE_LINE 00000022 "L<libreplace> it will replace (clobber) C<@INC> instead."
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "You can alternatively think of this kinda like C<use lib>, except with"
NSQ_SOURCE_LINE 00000025 "clobbering behavior that takes its arguments from C<PERL5INC>."
NSQ_SOURCE_LINE 00000026 "    "
NSQ_SOURCE_LINE 00000027 "\t\tPERL5LIB=\"foo:bar:baz\" perl -Mlibreplace ./script.pl"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "Evan Carroll, C<< <me at evancarroll.com> >>"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "You can find documentation for this module with the perldoc command."
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    perldoc libreplace"
