NSQ_SOURCE_LINE 00000001 "package Test::Time;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use Test::More;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.092';"
NSQ_SOURCE_LINE 00000008 "our $time = CORE::time();"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "my $pkg = __PACKAGE__;"
NSQ_SOURCE_LINE 00000011 "my $in_effect = 1;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "sub in_effect {"
NSQ_SOURCE_LINE 00000014 "\t$in_effect;"
NSQ_SOURCE_LINE 00000015 "}"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "sub __time () {"
NSQ_SOURCE_LINE 00000018 "\tif (in_effect) {"
NSQ_SOURCE_LINE 00000019 "\t\t$time;"
NSQ_SOURCE_LINE 00000020 "\t} else {"
NSQ_SOURCE_LINE 00000021 "\t\tCORE::time();"
NSQ_SOURCE_LINE 00000022 "\t}"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub __sleep (;$) {"
NSQ_SOURCE_LINE 00000026 "\tif (in_effect) {"
NSQ_SOURCE_LINE 00000027 "\t\tmy $sleep = shift || 1;"
NSQ_SOURCE_LINE 00000028 "\t\t$time += $sleep;"
NSQ_SOURCE_LINE 00000029 "\t\tnote \"sleep $sleep\";"
NSQ_SOURCE_LINE 00000030 "\t} else {"
NSQ_SOURCE_LINE 00000031 "\t\tCORE::sleep(shift);"
NSQ_SOURCE_LINE 00000032 "\t}"
NSQ_SOURCE_LINE 00000033 "}"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "sub __localtime (;$) {"
NSQ_SOURCE_LINE 00000036 "\tmy $arg = shift;"
NSQ_SOURCE_LINE 00000037 "\tif (in_effect) {"
NSQ_SOURCE_LINE 00000038 "\t\t$arg ||= $time;"
NSQ_SOURCE_LINE 00000039 "\t}"
NSQ_SOURCE_LINE 00000040 "\treturn defined $arg ? CORE::localtime($arg) : CORE::localtime();"
NSQ_SOURCE_LINE 00000041 "}"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "sub import {"
NSQ_SOURCE_LINE 00000044 "\tmy ($class, %opts) = @_;"
NSQ_SOURCE_LINE 00000045 "\t$in_effect = 1;"
NSQ_SOURCE_LINE 00000046 "\t$time = $opts{time} if defined $opts{time};"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "\t*CORE::GLOBAL::time = \\&__time;"
NSQ_SOURCE_LINE 00000049 "\t*CORE::GLOBAL::sleep = \\&__sleep;"
NSQ_SOURCE_LINE 00000050 "\t*CORE::GLOBAL::localtime = \\&__localtime;"
NSQ_SOURCE_LINE 00000051 "};"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "sub unimport {"
NSQ_SOURCE_LINE 00000054 "\t$in_effect = 0;"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "1;"
NSQ_SOURCE_LINE 00000058 "__END__"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=encoding utf8"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=head1 NAME"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "Test::Time - Overrides the time() and sleep() core functions for testing"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    use Test::Time;"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    # Freeze time"
NSQ_SOURCE_LINE 00000071 "    my $now = time();"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    # Increment internal time (returns immediately)"
NSQ_SOURCE_LINE 00000074 "    sleep 1;"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "    # Return internal time incremented by 1"
NSQ_SOURCE_LINE 00000077 "    my $then = time();"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Test::Time can be used to test modules that deal with time. Once you C<use> this"
NSQ_SOURCE_LINE 00000083 "module, all references to C<time>, C<localtime> and C<sleep> will be internalized."
NSQ_SOURCE_LINE 00000084 "You can set custom time by passing time => number after the C<use> statement:"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    use Test::Time time => 1;"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "    my $now = time;    # $now is equal to 1"
NSQ_SOURCE_LINE 00000089 "    sleep 300;         # returns immediately, displaying a note"
NSQ_SOURCE_LINE 00000090 "    my $then = time;   # $then equals to 301"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "cho45 E<lt>cho45@lowreal.netE<gt>"
