BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Sort::Sub;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Log::ger;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000009 "our $DATE = '2024-07-17'; # DATE"
NSQ_SOURCE_LINE 00000010 "our $DIST = 'Sort-Sub'; # DIST"
NSQ_SOURCE_LINE 00000011 "our $VERSION = '0.121'; # VERSION"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our $re_spec = qr/\\A(\\$)?(\\w+)(?:<(\\w*)>)?\\z/;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our %argsopt_sortsub = ("
NSQ_SOURCE_LINE 00000016 "    sort_sub => {"
NSQ_SOURCE_LINE 00000017 "        summary => 'Name of a Sort::Sub::* module (without the prefix)',"
NSQ_SOURCE_LINE 00000018 "        schema => ['sortsub::spec*'],"
NSQ_SOURCE_LINE 00000019 "    },"
NSQ_SOURCE_LINE 00000020 "    sort_args => {"
NSQ_SOURCE_LINE 00000021 "        'x.name.is_plural' => 1,"
NSQ_SOURCE_LINE 00000022 "        'x.name.singular' => 'sort_arg',"
NSQ_SOURCE_LINE 00000023 "        summary => 'Arguments to pass to the Sort::Sub::* routine',"
NSQ_SOURCE_LINE 00000024 "        schema => ['array*', of=>'str*'],"
NSQ_SOURCE_LINE 00000025 "        element_completion => sub {"
NSQ_SOURCE_LINE 00000026 "            my %cargs = @_;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "            # do we have the routine already? if yes, extract the metadata"
NSQ_SOURCE_LINE 00000029 "            my $rname = $cargs{args}{sort_sub};"
NSQ_SOURCE_LINE 00000030 "            return [] unless defined $rname;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "            my $mod = \"Sort::Sub::$rname\";"
NSQ_SOURCE_LINE 00000033 "            (my $mod_pm = \"$mod.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000034 "            eval { require $mod_pm };"
NSQ_SOURCE_LINE 00000035 "            return {message=>\"Cannot load $mod: $@\"} if $@;"
NSQ_SOURCE_LINE 00000036 "            my $meta;"
NSQ_SOURCE_LINE 00000037 "            eval { $meta = $mod->meta };"
NSQ_SOURCE_LINE 00000038 "            return [] unless $meta;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "            require Complete::Sequence;"
NSQ_SOURCE_LINE 00000041 "            return Complete::Sequence::complete_sequence("
NSQ_SOURCE_LINE 00000042 "                word => $cargs{word},"
NSQ_SOURCE_LINE 00000043 "                sequence => ["
NSQ_SOURCE_LINE 00000044 "                    sub {"
NSQ_SOURCE_LINE 00000045 "                        [$meta->{args} ? keys(%{ $meta->{args} }) : ()];"
NSQ_SOURCE_LINE 00000046 "                    },"
NSQ_SOURCE_LINE 00000047 "                    '=',"
NSQ_SOURCE_LINE 00000048 "                    sub {"
NSQ_SOURCE_LINE 00000049 "                        my $stash = shift;"
NSQ_SOURCE_LINE 00000050 "                        my $argname = $stash->{completed_item_words}[0];"
NSQ_SOURCE_LINE 00000051 "                        return [] unless defined $argname;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "                        my $argspec = $meta->{args}{$argname};"
NSQ_SOURCE_LINE 00000054 "                        return [] unless $argspec->{schema};"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "                        require Complete::Sah;"
NSQ_SOURCE_LINE 00000057 "                        require Complete::Util;"
NSQ_SOURCE_LINE 00000058 "                        Complete::Util::arrayify_answer("
NSQ_SOURCE_LINE 00000059 "                            Complete::Sah::complete_from_schema("
NSQ_SOURCE_LINE 00000060 "                                word => $stash->{cur_word},"
NSQ_SOURCE_LINE 00000061 "                                schema => $argspec->{schema},"
NSQ_SOURCE_LINE 00000062 "                            )"
NSQ_SOURCE_LINE 00000063 "                          );"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "                    },"
NSQ_SOURCE_LINE 00000066 "                ],"
NSQ_SOURCE_LINE 00000067 "            );"
NSQ_SOURCE_LINE 00000068 "        },"
NSQ_SOURCE_LINE 00000069 "    },"
NSQ_SOURCE_LINE 00000070 ");"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "sub get_sorter {"
NSQ_SOURCE_LINE 00000073 "    my ($spec, $args, $with_meta) = @_;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    my ($is_var, $name, $opts) = $spec =~ $re_spec"
NSQ_SOURCE_LINE 00000076 "        or die \"Invalid sorter spec '$spec', please use: \"."
NSQ_SOURCE_LINE 00000077 "        '[$]NAME [ <OPTS> ]';"
NSQ_SOURCE_LINE 00000078 "    my $modpm = \"Sort/Sub/$name.pm\";"
NSQ_SOURCE_LINE 00000079 "    require $modpm;"
NSQ_SOURCE_LINE 00000080 "    $opts //= \"\";"
NSQ_SOURCE_LINE 00000081 "    my $is_reverse = $opts =~ /r/;"
NSQ_SOURCE_LINE 00000082 "    my $is_ci      = $opts =~ /i/;"
NSQ_SOURCE_LINE 00000083 "    my $gen_sorter = \\&{\"Sort::Sub::$name\\::gen_sorter\"};"
NSQ_SOURCE_LINE 00000084 "    my $sorter = $gen_sorter->($is_reverse, $is_ci, $args // {});"
NSQ_SOURCE_LINE 00000085 "    if ($with_meta) {"
NSQ_SOURCE_LINE 00000086 "        my $meta = {};"
NSQ_SOURCE_LINE 00000087 "        eval { $meta = &{\"Sort::Sub::$name\\::meta\"}() };"
NSQ_SOURCE_LINE 00000088 "        warn if $@;"
NSQ_SOURCE_LINE 00000089 "        return ($sorter, $meta);"
NSQ_SOURCE_LINE 00000090 "    } else {"
NSQ_SOURCE_LINE 00000091 "        return $sorter;"
NSQ_SOURCE_LINE 00000092 "    }"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub import {"
NSQ_SOURCE_LINE 00000096 "    my $class = shift;"
NSQ_SOURCE_LINE 00000097 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    my $i = -1;"
NSQ_SOURCE_LINE 00000100 "    while (1) {"
NSQ_SOURCE_LINE 00000101 "        $i++;"
NSQ_SOURCE_LINE 00000102 "        last if $i >= @_;"
NSQ_SOURCE_LINE 00000103 "        my $import = $_[$i];"
NSQ_SOURCE_LINE 00000104 "        my $args = {};"
NSQ_SOURCE_LINE 00000105 "        if (ref $_[$i+1] eq 'HASH') {"
NSQ_SOURCE_LINE 00000106 "            $args = $_[$i+1];"
NSQ_SOURCE_LINE 00000107 "            $i++;"
NSQ_SOURCE_LINE 00000108 "        }"
NSQ_SOURCE_LINE 00000109 "        my $sorter = get_sorter($import, $args);"
NSQ_SOURCE_LINE 00000110 "        my ($is_var, $name) = $import =~ $re_spec; # XXX double matching"
NSQ_SOURCE_LINE 00000111 "        if ($is_var) {"
NSQ_SOURCE_LINE 00000112 "            ${\"$caller\\::$name\"} = \\&$sorter;"
NSQ_SOURCE_LINE 00000113 "        } else {"
NSQ_SOURCE_LINE 00000114 "            no warnings 'redefine';"
NSQ_SOURCE_LINE 00000115 "            *{\"$caller\\::$name\"} = \\&$sorter;"
NSQ_SOURCE_LINE 00000116 "        }"
NSQ_SOURCE_LINE 00000117 "    }"
NSQ_SOURCE_LINE 00000118 "}"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "1;"
NSQ_SOURCE_LINE 00000121 "# ABSTRACT: Collection of sort subroutines"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "__END__"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=pod"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "=head1 NAME"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "Sort::Sub - Collection of sort subroutines"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=head1 VERSION"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "This document describes version 0.121 of Sort::Sub (from Perl distribution Sort-Sub), released on 2024-07-17."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 " use Sort::Sub qw($naturally);"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 " my @sorted = sort $naturally ('track1.mp3', 'track10.mp3', 'track2.mp3', 'track1b.mp3', 'track1a.mp3');"
NSQ_SOURCE_LINE 00000142 " # => ('track1.mp3', 'track1a.mp3', 'track1b.mp3', 'track2.mp3', 'track10.mp3')"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "Request as subroutine:"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 " use Sort::Sub qw(naturally);"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 " my @sorted = sort {naturally} (...);"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Request a reverse sort:"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 " use Sort::Sub qw($naturally<r>);"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 " my @sorted = sort $naturally (...);"
NSQ_SOURCE_LINE 00000155 " # => ('track10.mp3', 'track2.mp3', 'track1b.mp3', 'track1a.mp3', 'track1.mp3')"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Request a case-insensitive sort:"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 " use Sort::Sub qw($naturally<i>);"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 " my @sorted = sort $naturally (...);"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "Request a case-insensitive, reverse sort:"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 " use Sort::Sub qw($naturally<ir>);"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 " my @sorted = sort $naturally ('track2.mp3', 'Track1.mp3', 'Track10.mp3');"
NSQ_SOURCE_LINE 00000168 " => ('Track10.mp3', 'track2.mp3', 'Track1.mp3')"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "Pass arguments to sort generator routine:"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 " use Sort::Sub '$by_num_of_colons', {pattern=>':'};"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 " my @sorted = sort $by_num_of_colons ('a::','b:','c::::','d:::');"
NSQ_SOURCE_LINE 00000175 " => ('b:','a::','d:::','c::::')"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "Request a coderef directly, without using the import interface:"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 " use Sort::Sub;"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 " my $naturally = Sort::Sub::get_sorter('naturally');"
NSQ_SOURCE_LINE 00000182 " my $naturally = Sort::Sub::get_sorter('$naturally');"
NSQ_SOURCE_LINE 00000183 " my $rev_naturally = Sort::Sub::get_sorter('naturally<r>');"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "L<Sort::Sub> and C<Sort::Sub::*> are a convenient packaging of any kind of"
NSQ_SOURCE_LINE 00000188 "subroutine which you can use for C<sort()>."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "To use Sort::Sub, you import a list of:"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 " [\"$\"]NAME [ \"<\" [i][r] \">\" ]"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "Where NAME is actually searched under C<Sort::Sub::*> namespace. For example:"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 " naturally"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "will attempt to load C<Sort::Sub::naturally> module and call its C<gen_sorter>"
NSQ_SOURCE_LINE 00000199 "subroutine."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "You can either request a subroutine name like the above or a variable name (e.g."
NSQ_SOURCE_LINE 00000202 "C<$naturally>)."
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "After the name, you can add some options, enclosed with angle brackets C<< <>"
NSQ_SOURCE_LINE 00000205 ">>. There are some known options, e.g. C<i> (for case-insensitive sort) or C<r>"
NSQ_SOURCE_LINE 00000206 "(for reverse sort). Some examples:"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 " naturally<i>"
NSQ_SOURCE_LINE 00000209 " naturally<r>"
NSQ_SOURCE_LINE 00000210 " naturally<ri>"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=head1 GUIDELINES FOR WRITING A SORT::SUB::* MODULE"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "The name should be in lowercase. It should be an adverb (e.g. C<naturally>) or a"
NSQ_SOURCE_LINE 00000215 "phrase with words separated by underscore (C<_>) and the phrase begins with"
NSQ_SOURCE_LINE 00000216 "C<by> (e.g. C<by_num_and_non_num_parts>)."
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "The module must contain a C<gen_sorter> subroutine. It will be called with:"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 " ($is_reverse, $is_ci, $args)"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "Where C<$is_reserve> will be set to true if user requests a reverse sort,"
NSQ_SOURCE_LINE 00000223 "C<$is_ci> will be set to true if user requests a case-insensitive sort. C<$args>"
NSQ_SOURCE_LINE 00000224 "is hashref to pass additional arguments to the C<gen_sorter()> routine. The"
NSQ_SOURCE_LINE 00000225 "subroutine should return a code reference."
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "The module should also contain a C<meta> subroutine which returns a metadata"
NSQ_SOURCE_LINE 00000228 "L<DefHash>. Known properties (keys) include: C<v> (currently at 1), C<summary>,"
NSQ_SOURCE_LINE 00000229 "C<compares_record> (bool, if set to true then sorter will be fed records C<<"
NSQ_SOURCE_LINE 00000230 "[$data, $order] >> instead of just C<$data>; C<$order> is a number that can be"
NSQ_SOURCE_LINE 00000231 "line number of array index; this allows sorter to sort by additional information"
NSQ_SOURCE_LINE 00000232 "instead of just the data items). Other metadata properties will be added in the"
NSQ_SOURCE_LINE 00000233 "future."
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=head2 get_sorter"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "Usage:"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 " my $coderef = Sort::Sub::get_sorter('SPEC' [ , \\%args [ , $with_meta ] ]);"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "Example:"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 " my $rev_naturally = Sort::Sub::get_sorter('naturally<r>');"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "This is an alternative to using the import interface. This function is not"
NSQ_SOURCE_LINE 00000248 "imported."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "If C<$with_meta> is set to true, will return this:"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 " ($sorter, $meta)"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "instead of just the C<$sorter> subroutine."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "Please visit the project's homepage at L<https://metacpan.org/release/Sort-Sub>."
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "Source repository is at L<https://github.com/perlancar/perl-Sort-Sub>."
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "Other additional C<Sort::Sub::*> not bundled in this distribution."
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "Supporting CLI's: L<sortsub> (from L<App::sortsub>), L<sorted> (from"
NSQ_SOURCE_LINE 00000269 "L<App::sorted>), CLI's from L<App::SortSubUtils>."
NSQ_SOURCE_LINE 00000270 ""
