BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package lazy;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use feature qw( say state );"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '1.000000';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use App::cpm 0.997017 ();                # CLI has no $VERSION"
NSQ_SOURCE_LINE 00000010 "use App::cpm::CLI     ();"
NSQ_SOURCE_LINE 00000011 "use Carp              qw( longmess );"
NSQ_SOURCE_LINE 00000012 "use Capture::Tiny     qw( :all );        ## no perlimports"
NSQ_SOURCE_LINE 00000013 "use Sub::Name         qw( subname );"
NSQ_SOURCE_LINE 00000014 "use Sub::Identify     qw( sub_name );"
NSQ_SOURCE_LINE 00000015 "use Try::Tiny         qw( catch try );"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "# Cargo-culted from App::cpm::CLI"
NSQ_SOURCE_LINE 00000018 "# Adding pass_through so that we don't have to keep up with all possible options"
NSQ_SOURCE_LINE 00000019 "use Getopt::Long qw("
NSQ_SOURCE_LINE 00000020 "    :config"
NSQ_SOURCE_LINE 00000021 "    no_auto_abbrev"
NSQ_SOURCE_LINE 00000022 "    no_ignore_case"
NSQ_SOURCE_LINE 00000023 "    bundling"
NSQ_SOURCE_LINE 00000024 "    pass_through"
NSQ_SOURCE_LINE 00000025 ");"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "sub import {"
NSQ_SOURCE_LINE 00000028 "    shift;"
NSQ_SOURCE_LINE 00000029 "    my @args = @_;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    my $is_global;"
NSQ_SOURCE_LINE 00000032 "    my $local_lib;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    # Don't add this to @INC twice"
NSQ_SOURCE_LINE 00000035 "    for my $i (@INC) {"
NSQ_SOURCE_LINE 00000036 "        next unless ref $i && ref $i eq 'CODE';"
NSQ_SOURCE_LINE 00000037 "        return if sub_name($i) eq '_lazy_worker';"
NSQ_SOURCE_LINE 00000038 "    }"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    {"
NSQ_SOURCE_LINE 00000041 "        local @ARGV = @args;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "        # Stolen from App::cpm::CLI::parse_options()"
NSQ_SOURCE_LINE 00000044 "        GetOptions("
NSQ_SOURCE_LINE 00000045 "            'L|local-lib-contained=s' => \\$local_lib,"
NSQ_SOURCE_LINE 00000046 "            'g|global'                => \\$is_global,"
NSQ_SOURCE_LINE 00000047 "        );"
NSQ_SOURCE_LINE 00000048 "    }"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    # Generally assume a global install, which makes the invocation as"
NSQ_SOURCE_LINE 00000051 "    # simple as:"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    # perl -Mlazy foo.pl"
NSQ_SOURCE_LINE 00000054 "    #"
NSQ_SOURCE_LINE 00000055 "    # To install into ./local:"
NSQ_SOURCE_LINE 00000056 "    # perl -Mlazy='-Llocal'"
NSQ_SOURCE_LINE 00000057 "    #"
NSQ_SOURCE_LINE 00000058 "    # To install into ./some-other-dir:"
NSQ_SOURCE_LINE 00000059 "    # perl -Mlazy='-Lsome-other-dir'"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    # Ensure global install by default"
NSQ_SOURCE_LINE 00000062 "    if ( !$local_lib ) {"
NSQ_SOURCE_LINE 00000063 "        print \"🌍 global install if required\\n\" unless $ENV{HARNESS_ACTIVE};"
NSQ_SOURCE_LINE 00000064 "        push @args, ('-g');"
NSQ_SOURCE_LINE 00000065 "    }"
NSQ_SOURCE_LINE 00000066 "    else {"
NSQ_SOURCE_LINE 00000067 "        print \"🔨 Installing into $local_lib if required\\n\""
NSQ_SOURCE_LINE 00000068 "            unless $ENV{HARNESS_ACTIVE};"
NSQ_SOURCE_LINE 00000069 "        require local::lib;"
NSQ_SOURCE_LINE 00000070 "        local::lib->import($local_lib);"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    my $cpm = App::cpm::CLI->new;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    # Push the hook onto @INC and then re-add all of @INC again.  This way, if"
NSQ_SOURCE_LINE 00000076 "    # we got to the hook and tried to install, we can re-try @INC to see if the"
NSQ_SOURCE_LINE 00000077 "    # module can now be used."
NSQ_SOURCE_LINE 00000078 "    my $_lazy = sub {"
NSQ_SOURCE_LINE 00000079 "        shift;"
NSQ_SOURCE_LINE 00000080 "        my $name = shift;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "        state %seen;"
NSQ_SOURCE_LINE 00000083 "        $seen{$name}++;"
NSQ_SOURCE_LINE 00000084 "        return if $seen{$name} > 1;    # Limit recursion to a single attempt"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "        $name =~ s{/}{::}g;"
NSQ_SOURCE_LINE 00000087 "        $name =~ s{\\.pm\\z}{};"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "        if ( $name =~ qr{\\A(?:auto::.*\\.al\\Z)} ) {"
NSQ_SOURCE_LINE 00000090 "            warn \"skipping autoloader file $name\";"
NSQ_SOURCE_LINE 00000091 "            return 1;"
NSQ_SOURCE_LINE 00000092 "        }"
NSQ_SOURCE_LINE 00000093 "        if ( $name =~ qr{\\A(?:Net::DNS::Resolver::.*\\Z)} ) {"
NSQ_SOURCE_LINE 00000094 "            warn \"skipping $name\";"
NSQ_SOURCE_LINE 00000095 "            return 1;"
NSQ_SOURCE_LINE 00000096 "        }"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "        try {"
NSQ_SOURCE_LINE 00000099 "            $cpm->run( 'install', @args, $name );"
NSQ_SOURCE_LINE 00000100 "        }"
NSQ_SOURCE_LINE 00000101 "        catch {"
NSQ_SOURCE_LINE 00000102 "            warn \"Failed to install $name: \" . longmess();"
NSQ_SOURCE_LINE 00000103 "            warn $_;"
NSQ_SOURCE_LINE 00000104 "        };"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "        return 1;"
NSQ_SOURCE_LINE 00000107 "    };"
NSQ_SOURCE_LINE 00000108 "    subname '_lazy_worker', $_lazy;"
NSQ_SOURCE_LINE 00000109 "    push @INC, $_lazy, @INC;"
NSQ_SOURCE_LINE 00000110 "}"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "1;"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "# ABSTRACT: Lazily install missing Perl modules"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "__END__"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=pod"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head1 NAME"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "lazy - Lazily install missing Perl modules"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=head1 VERSION"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "version 1.000000"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    # At the command line"
NSQ_SOURCE_LINE 00000133 "    # --------------------------------------------------"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "    # Auto-install missing modules globally"
NSQ_SOURCE_LINE 00000136 "    perl -Mlazy foo.pl"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "    # Auto-install missing modules into ./local"
NSQ_SOURCE_LINE 00000139 "    perl -Mlazy='-Llocal' foo.pl"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    # Auto-install missing modules into ./some-other-dir"
NSQ_SOURCE_LINE 00000142 "    perl -Mlazy='-Lsome-other-dir' foo.pl"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    # In your code"
NSQ_SOURCE_LINE 00000145 "    # --------------------------------------------------"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    # Auto-install missing modules globally"
NSQ_SOURCE_LINE 00000148 "    use lazy;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "    # Auto-install missing modules into ./local"
NSQ_SOURCE_LINE 00000151 "    use local::lib;"
NSQ_SOURCE_LINE 00000152 "    use lazy qw( -L local );"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    # Auto-install missing modules into ./some-other-dir"
NSQ_SOURCE_LINE 00000155 "    use local::lib qw( some-other-dir );"
NSQ_SOURCE_LINE 00000156 "    use lazy qw( -L some-other-dir );"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    # Auto-install missing modules into ./some-other-dir and pass more options to App::cpm"
NSQ_SOURCE_LINE 00000159 "    use local::lib qw( some-other-dir );"
NSQ_SOURCE_LINE 00000160 "    use lazy qw( -L some-other-dir --man-pages --verbose --no-color );"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    # In a one-liner?"
NSQ_SOURCE_LINE 00000163 "    # --------------------------------------------------"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "    # Install App::perlimports via a one-liner, but why would you want to?"
NSQ_SOURCE_LINE 00000166 "    perl -Mlazy -MApp::perlimports -E 'say \"ok\"'"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=head2 DESCRIPTION"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "Your co-worker sends you a one-off script to use.  You fire it up and realize"
NSQ_SOURCE_LINE 00000171 "you haven't got all of the dependencies installed in your work environment."
NSQ_SOURCE_LINE 00000172 "Now you fire up the script and one by one, you find the missing modules and"
NSQ_SOURCE_LINE 00000173 "install them manually."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "Not anymore!"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "C<lazy> will try to install any missing modules automatically, making your day"
NSQ_SOURCE_LINE 00000178 "just a little less long.  C<lazy> uses L<App::cpm> to perform this magic in the"
NSQ_SOURCE_LINE 00000179 "background."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=head2 USAGE"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    perl -Mlazy foo.pl"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "Or use a local lib:"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "    perl -Mlazy='-Llocal' foo.pl"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "You can pass arguments directly to L<App::cpm> via the import statement."
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "    use lazy qw( --verbose );"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "Or"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    use lazy qw( --man-pages --with-recommends --verbose );"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "You get the idea."
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "This module uses L<App::cpm>'s defaults, with the exception being that we"
NSQ_SOURCE_LINE 00000200 "default to global installs rather than local."
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "So, the default usage would be:"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "    use lazy;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "If you want to install to a local lib, use L<local::lib> first:"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    use local::lib qw( my-local-lib );"
NSQ_SOURCE_LINE 00000209 "    use lazy    q( -L my-local-lib );"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=head2 CAVEATS"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "* Remove C<lazy> before you put your work into production."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=head2 SEE ALSO"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "L<Acme::Intraweb>, L<Acme::Magic::Pony>, L<CPAN::AutoINC>, L<lib::xi>, L<Module::AutoINC>, L<Module::AutoLoad>, L<The::Net> and L<Class::Autouse>"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=head2 ACKNOWLEDGEMENTS"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "This entire idea was ripped off from L<Acme::Magic::Pony>.  The main difference"
NSQ_SOURCE_LINE 00000222 "is that we use L<App::cpm> rather than L<CPAN::Shell>."
NSQ_SOURCE_LINE 00000223 ""
