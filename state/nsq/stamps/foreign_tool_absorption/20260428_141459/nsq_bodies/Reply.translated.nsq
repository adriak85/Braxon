BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Reply;"
NSQ_SOURCE_LINE 00000002 "our $AUTHORITY = 'cpan:DOY';"
NSQ_SOURCE_LINE 00000003 "$Reply::VERSION = '0.42';"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "# ABSTRACT: read, eval, print, loop, yay!"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Module::Runtime qw(compose_module_name require_module);"
NSQ_SOURCE_LINE 00000009 "use Scalar::Util qw(blessed weaken);"
NSQ_SOURCE_LINE 00000010 "use Try::Tiny;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Reply::Config;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub new {"
NSQ_SOURCE_LINE 00000017 "    my $class = shift;"
NSQ_SOURCE_LINE 00000018 "    my %opts = @_;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    my $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    $self->{plugins} = [];"
NSQ_SOURCE_LINE 00000023 "    $self->{_default_plugin} = $self->_instantiate_plugin('Defaults');"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    if (defined $opts{config}) {"
NSQ_SOURCE_LINE 00000026 "        if (!ref($opts{config})) {"
NSQ_SOURCE_LINE 00000027 "            $opts{config} = Reply::Config->new(file => $opts{config});"
NSQ_SOURCE_LINE 00000028 "        }"
NSQ_SOURCE_LINE 00000029 "        $self->_load_config($opts{config});"
NSQ_SOURCE_LINE 00000030 "    }"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    $self->_load_plugin($_) for @{ $opts{plugins} || [] };"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    return $self;"
NSQ_SOURCE_LINE 00000035 "}"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "sub run {"
NSQ_SOURCE_LINE 00000039 "    my $self = shift;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    while (1) {"
NSQ_SOURCE_LINE 00000042 "        my $continue = $self->step;"
NSQ_SOURCE_LINE 00000043 "        last unless $continue;"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 "    print \"\\n\";"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "sub step {"
NSQ_SOURCE_LINE 00000050 "    my $self = shift;"
NSQ_SOURCE_LINE 00000051 "    my ($line, $verbose) = @_;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    if (defined $line) {"
NSQ_SOURCE_LINE 00000054 "        print $self->_wrapped_plugin('prompt'), $line, \"\\n\""
NSQ_SOURCE_LINE 00000055 "            if $verbose;"
NSQ_SOURCE_LINE 00000056 "    }"
NSQ_SOURCE_LINE 00000057 "    else {"
NSQ_SOURCE_LINE 00000058 "        $line = $self->_read;"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    return unless defined $line;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    $line = $self->_preprocess_line($line);"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    try {"
NSQ_SOURCE_LINE 00000066 "        my @result = $self->_eval($line);"
NSQ_SOURCE_LINE 00000067 "        $self->_print_result(@result);"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 "    catch {"
NSQ_SOURCE_LINE 00000070 "        $self->_print_error($_);"
NSQ_SOURCE_LINE 00000071 "    };"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    my ($continue) = $self->_loop;"
NSQ_SOURCE_LINE 00000074 "    return $continue;"
NSQ_SOURCE_LINE 00000075 "}"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "sub _load_config {"
NSQ_SOURCE_LINE 00000078 "    my $self = shift;"
NSQ_SOURCE_LINE 00000079 "    my ($config) = @_;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    my $data = $config->data;"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "    my $root_config;"
NSQ_SOURCE_LINE 00000084 "    for my $section (@$data) {"
NSQ_SOURCE_LINE 00000085 "        my ($name, $data) = @$section;"
NSQ_SOURCE_LINE 00000086 "        if ($name eq '_') {"
NSQ_SOURCE_LINE 00000087 "            $root_config = $data;"
NSQ_SOURCE_LINE 00000088 "        }"
NSQ_SOURCE_LINE 00000089 "        else {"
NSQ_SOURCE_LINE 00000090 "            $self->_load_plugin($name => $data);"
NSQ_SOURCE_LINE 00000091 "        }"
NSQ_SOURCE_LINE 00000092 "    }"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    for my $line (sort grep { /^script_line/ } keys %$root_config) {"
NSQ_SOURCE_LINE 00000095 "        $self->step($root_config->{$line});"
NSQ_SOURCE_LINE 00000096 "    }"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    if (defined(my $file = $root_config->{script_file})) {"
NSQ_SOURCE_LINE 00000099 "        my $contents = do {"
NSQ_SOURCE_LINE 00000100 "            open my $fh, '<', $file or die \"Couldn't open $file: $!\";"
NSQ_SOURCE_LINE 00000101 "            local $/ = undef;"
NSQ_SOURCE_LINE 00000102 "            <$fh>"
NSQ_SOURCE_LINE 00000103 "        };"
NSQ_SOURCE_LINE 00000104 "        $self->step($contents);"
NSQ_SOURCE_LINE 00000105 "    }"
NSQ_SOURCE_LINE 00000106 "}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "sub _load_plugin {"
NSQ_SOURCE_LINE 00000109 "    my $self = shift;"
NSQ_SOURCE_LINE 00000110 "    my ($plugin, $opts) = @_;"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "    $plugin = $self->_instantiate_plugin($plugin, $opts);"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "    push @{ $self->{plugins} }, $plugin;"
NSQ_SOURCE_LINE 00000115 "}"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "sub _instantiate_plugin {"
NSQ_SOURCE_LINE 00000118 "    my $self = shift;"
NSQ_SOURCE_LINE 00000119 "    my ($plugin, $opts) = @_;"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "    if (!blessed($plugin)) {"
NSQ_SOURCE_LINE 00000122 "        $plugin = compose_module_name(\"Reply::Plugin\", $plugin);"
NSQ_SOURCE_LINE 00000123 "        require_module($plugin);"
NSQ_SOURCE_LINE 00000124 "        die \"$plugin is not a valid plugin\""
NSQ_SOURCE_LINE 00000125 "            unless $plugin->isa(\"Reply::Plugin\");"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "        my $weakself = $self;"
NSQ_SOURCE_LINE 00000128 "        weaken($weakself);"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "        $plugin = $plugin->new("
NSQ_SOURCE_LINE 00000131 "            %$opts,"
NSQ_SOURCE_LINE 00000132 "            publisher => sub { $weakself->_publish(@_) },"
NSQ_SOURCE_LINE 00000133 "        );"
NSQ_SOURCE_LINE 00000134 "    }"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    return $plugin;"
NSQ_SOURCE_LINE 00000137 "}"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "sub _plugins {"
NSQ_SOURCE_LINE 00000140 "    my $self = shift;"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "    return ("
NSQ_SOURCE_LINE 00000143 "        @{ $self->{plugins} },"
NSQ_SOURCE_LINE 00000144 "        $self->{_default_plugin},"
NSQ_SOURCE_LINE 00000145 "    );"
NSQ_SOURCE_LINE 00000146 "}"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "sub _read {"
NSQ_SOURCE_LINE 00000149 "    my $self = shift;"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    my $prompt = $self->_wrapped_plugin('prompt');"
NSQ_SOURCE_LINE 00000152 "    return $self->_wrapped_plugin('read_line', $prompt);"
NSQ_SOURCE_LINE 00000153 "}"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "sub _preprocess_line {"
NSQ_SOURCE_LINE 00000156 "    my $self = shift;"
NSQ_SOURCE_LINE 00000157 "    my ($line) = @_;"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "    if ($line =~ s/^#(\\w+)(?:\\s+|$)//) {"
NSQ_SOURCE_LINE 00000160 "        ($line) = $self->_chained_plugin(\"command_\\L$1\", $line);"
NSQ_SOURCE_LINE 00000161 "    }"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    return \"\\n#line 1 \\\"reply input\\\"\\n$line\";"
NSQ_SOURCE_LINE 00000164 "}"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "sub _eval {"
NSQ_SOURCE_LINE 00000167 "    my $self = shift;"
NSQ_SOURCE_LINE 00000168 "    my ($line) = @_;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    ($line) = $self->_chained_plugin('mangle_line', $line)"
NSQ_SOURCE_LINE 00000171 "        if defined $line;"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    my ($code) = $self->_wrapped_plugin('compile', $line);"
NSQ_SOURCE_LINE 00000174 "    return $self->_wrapped_plugin('execute', $code);"
NSQ_SOURCE_LINE 00000175 "}"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "sub _print_error {"
NSQ_SOURCE_LINE 00000178 "    my $self = shift;"
NSQ_SOURCE_LINE 00000179 "    my ($error) = @_;"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "    ($error) = $self->_chained_plugin('mangle_error', $error);"
NSQ_SOURCE_LINE 00000182 "    $self->_wrapped_plugin('print_error', $error);"
NSQ_SOURCE_LINE 00000183 "}"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "sub _print_result {"
NSQ_SOURCE_LINE 00000186 "    my $self = shift;"
NSQ_SOURCE_LINE 00000187 "    my (@result) = @_;"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "    @result = $self->_chained_plugin('mangle_result', @result);"
NSQ_SOURCE_LINE 00000190 "    $self->_wrapped_plugin('print_result', @result);"
NSQ_SOURCE_LINE 00000191 "}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "sub _loop {"
NSQ_SOURCE_LINE 00000194 "    my $self = shift;"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "    $self->_chained_plugin('loop', 1);"
NSQ_SOURCE_LINE 00000197 "}"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "sub _publish {"
NSQ_SOURCE_LINE 00000200 "    my $self = shift;"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "    $self->_concatenate_plugin(@_);"
NSQ_SOURCE_LINE 00000203 "}"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "sub _wrapped_plugin {"
NSQ_SOURCE_LINE 00000206 "    my $self = shift;"
NSQ_SOURCE_LINE 00000207 "    my @plugins = ref($_[0]) ? @{ shift() } : $self->_plugins;"
NSQ_SOURCE_LINE 00000208 "    my ($method, @args) = @_;"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    @plugins = grep { $_->can($method) } @plugins;"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "    return @args unless @plugins;"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "    my $plugin = shift @plugins;"
NSQ_SOURCE_LINE 00000215 "    my $next = sub { $self->_wrapped_plugin(\\@plugins, $method, @_) };"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "    return $plugin->$method($next, @args);"
NSQ_SOURCE_LINE 00000218 "}"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "sub _chained_plugin {"
NSQ_SOURCE_LINE 00000221 "    my $self = shift;"
NSQ_SOURCE_LINE 00000222 "    my @plugins = ref($_[0]) ? @{ shift() } : $self->_plugins;"
NSQ_SOURCE_LINE 00000223 "    my ($method, @args) = @_;"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "    @plugins = grep { $_->can($method) } @plugins;"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    for my $plugin (@plugins) {"
NSQ_SOURCE_LINE 00000228 "        @args = $plugin->$method(@args);"
NSQ_SOURCE_LINE 00000229 "    }"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "    return @args;"
NSQ_SOURCE_LINE 00000232 "}"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "sub _concatenate_plugin {"
NSQ_SOURCE_LINE 00000235 "    my $self = shift;"
NSQ_SOURCE_LINE 00000236 "    my @plugins = ref($_[0]) ? @{ shift() } : $self->_plugins;"
NSQ_SOURCE_LINE 00000237 "    my ($method, @args) = @_;"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "    @plugins = grep { $_->can($method) } @plugins;"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    my @results;"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "    for my $plugin (@plugins) {"
NSQ_SOURCE_LINE 00000244 "        push @results, $plugin->$method(@args);"
NSQ_SOURCE_LINE 00000245 "    }"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    return @results;"
NSQ_SOURCE_LINE 00000248 "}"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "1;"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "__END__"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=pod"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=head1 NAME"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "Reply - read, eval, print, loop, yay!"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=head1 VERSION"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "version 0.42"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "  use Reply;"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "  Reply->new(config => \"$ENV{HOME}/.replyrc\")->run;"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "NOTE: This is an early release, and implementation details of this module are"
NSQ_SOURCE_LINE 00000276 "still very much in flux. Feedback is welcome!"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "Reply is a lightweight, extensible REPL for Perl. It is plugin-based (see"
NSQ_SOURCE_LINE 00000279 "L<Reply::Plugin>), and through plugins supports many advanced features such as"
NSQ_SOURCE_LINE 00000280 "coloring and pretty printing, readline support, and pluggable commands."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=head1 METHODS"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=head2 new(%opts)"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "Creates a new Reply instance. Valid options are:"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=over 4"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=item config"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "Name of a configuration file to load. This should contain INI-style"
NSQ_SOURCE_LINE 00000293 "configuration for plugins as described above."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=item plugins"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "An arrayref of additional plugins to load."
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=back"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=head2 run"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "Runs the repl. Will continue looping until the C<read_line> callback returns"
NSQ_SOURCE_LINE 00000304 "undef (typically when the user presses C<Ctrl+D>), or the C<loop> callback"
NSQ_SOURCE_LINE 00000305 "returns false (by default, the C<#q> command quits the repl in this way)."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=head2 step($line, $verbose)"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "Runs a single iteration of the repl. If C<$line> is given, it will be used as"
NSQ_SOURCE_LINE 00000310 "the string to evaluate (and the C<prompt> and C<read_line> callbacks will not"
NSQ_SOURCE_LINE 00000311 "be called). If C<$verbose> is true, the prompt and line will be displayed as"
NSQ_SOURCE_LINE 00000312 "though they were typed. Returns true if the repl can continue, and false if it"
NSQ_SOURCE_LINE 00000313 "was requested to quit."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "=head1 CONFIGURATION"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "Configuration uses an INI-style format similar to the configuration format of"
NSQ_SOURCE_LINE 00000318 "L<Dist::Zilla>. Section names are used as the names of plugins, and any options"
NSQ_SOURCE_LINE 00000319 "within a section are passed as arguments to that plugin. Plugins are loaded in"
NSQ_SOURCE_LINE 00000320 "order as they are listed in the configuration file, which can affect the"
NSQ_SOURCE_LINE 00000321 "results in some cases where multiple plugins are hooking into a single callback"
NSQ_SOURCE_LINE 00000322 "(see L<Reply::Plugin> for more information)."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "In addition to plugin configuration, there are some additional options"
NSQ_SOURCE_LINE 00000325 "recognized. These must be specified at the top of the file, before any section"
NSQ_SOURCE_LINE 00000326 "headers."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=over 4"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=item script_file"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "This contains a filename whose contents will be evaluated as perl code once the"
NSQ_SOURCE_LINE 00000333 "configuration is done being loaded."
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "=item script_line<I<n>>"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "Any options that start with C<script_line> will be sorted by their key and then"
NSQ_SOURCE_LINE 00000338 "each value will be evaluated individually once the configuration is done being"
NSQ_SOURCE_LINE 00000339 "loaded."
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "NOTE: this is currently a hack due to the fact that L<Config::INI> doesn't"
NSQ_SOURCE_LINE 00000342 "support multiple keys with the same name in a section. This may be fixed in the"
NSQ_SOURCE_LINE 00000343 "future to just allow specifying C<script_line> multiple times."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=back"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=head1 BUGS"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "No known bugs."
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "Please report any bugs to GitHub Issues at"
NSQ_SOURCE_LINE 00000352 "L<https://github.com/doy/reply/issues>."
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000355 ""
