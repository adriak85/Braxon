NSQ_SOURCE_LINE 00000001 "package HTTP::Tiny::UNIX;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $DATE = '2018-05-08'; # DATE"
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.051'; # VERSION"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "# issue: port must be numeric to avoid warning"
NSQ_SOURCE_LINE 00000011 "# put everything in path_query"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use parent qw(HTTP::Tiny);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use IO::Socket::UNIX;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "sub _split_url {"
NSQ_SOURCE_LINE 00000018 "    my ($self, $url) = @_;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    if ($url =~ m<\\A[^:/?#]+://>) {"
NSQ_SOURCE_LINE 00000021 "        $self->{_unix} = 0;"
NSQ_SOURCE_LINE 00000022 "        return $self->SUPER::_split_url($url);"
NSQ_SOURCE_LINE 00000023 "    }"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    my ($scheme, $sock_path, $path_query) ="
NSQ_SOURCE_LINE 00000026 "        $url =~ m<\\A(\\w+):(.+?)/(/[^#]*)>"
NSQ_SOURCE_LINE 00000027 "            or die \"Cannot parse HTTP-over-Unix URL: '$url'\\n\";"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    # a hack"
NSQ_SOURCE_LINE 00000030 "    $self->{_unix} = 1;"
NSQ_SOURCE_LINE 00000031 "    $self->{_path_query} = $path_query;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    $scheme = lc $scheme;"
NSQ_SOURCE_LINE 00000034 "    die \"Only http scheme is supported\\n\" unless $scheme eq 'http';"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    #return ($scheme, $host,      $port, $path_query, $auth);"
NSQ_SOURCE_LINE 00000037 "    return  ($scheme, $sock_path, -1,    $path_query, '');"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "sub _open_handle {"
NSQ_SOURCE_LINE 00000041 "    my ($self, $request, $scheme, $host, $port) = @_;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    return $self->SUPER::_open_handle($request, $scheme, $host, $port)"
NSQ_SOURCE_LINE 00000044 "        unless $self->{_unix};"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    my $handle = HTTP::Tiny::Handle::UNIX->new("
NSQ_SOURCE_LINE 00000047 "        timeout => $self->{timeout},"
NSQ_SOURCE_LINE 00000048 "    );"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    $handle->connect($scheme, $host, $port, $self);"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "package"
NSQ_SOURCE_LINE 00000054 "    HTTP::Tiny::Handle::UNIX;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "use parent -norequire, 'HTTP::Tiny::Handle';"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "use IO::Socket;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub connect {"
NSQ_SOURCE_LINE 00000061 "    my ($self, $scheme, $host, $port, $tiny) = @_;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    # on Unix, we use $host for path and leave port at -1 (unused)"
NSQ_SOURCE_LINE 00000064 "    my $path = $host;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    local($^W) = 0;"
NSQ_SOURCE_LINE 00000067 "    my $sock = IO::Socket::UNIX->new("
NSQ_SOURCE_LINE 00000068 "        Peer    => $path,"
NSQ_SOURCE_LINE 00000069 "        Type    => SOCK_STREAM,"
NSQ_SOURCE_LINE 00000070 "        Timeout => $self->{timeout},"
NSQ_SOURCE_LINE 00000071 "        Host    => 'localhost',"
NSQ_SOURCE_LINE 00000072 "    );"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    unless ($sock) {"
NSQ_SOURCE_LINE 00000075 "        $@ =~ s/^.*?: //;"
NSQ_SOURCE_LINE 00000076 "        die \"Can't open Unix socket $path\\: $@\";"
NSQ_SOURCE_LINE 00000077 "    }"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    eval { $sock->blocking(0); };"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    $self->{fh} = $sock;"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "    $self->{scheme} = $scheme;"
NSQ_SOURCE_LINE 00000084 "    $self->{host} = $host;"
NSQ_SOURCE_LINE 00000085 "    $self->{port} = $port;"
NSQ_SOURCE_LINE 00000086 "    $self->{_unix} = 1;"
NSQ_SOURCE_LINE 00000087 "    # this is a hack, we inject this so we can get HTTP::Tiny::UNIX object from"
NSQ_SOURCE_LINE 00000088 "    # HTTP::Tiny::Handle::UNIX, to get path"
NSQ_SOURCE_LINE 00000089 "    $self->{_tiny} = $tiny;"
NSQ_SOURCE_LINE 00000090 "    $self;"
NSQ_SOURCE_LINE 00000091 "}"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "sub write_request_header {"
NSQ_SOURCE_LINE 00000094 "    my ($self, $method, $request_uri, $headers, $header_case) = @_;"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    return $self->SUPER::write_request_header(@_)"
NSQ_SOURCE_LINE 00000097 "        unless $self->{_unix};"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    return $self->write_header_lines($headers, $header_case, \"$method $self->{_tiny}{_path_query} HTTP/1.1\\x0D\\x0A\");"
NSQ_SOURCE_LINE 00000100 "}"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "1;"
NSQ_SOURCE_LINE 00000103 "# ABSTRACT: A subclass of HTTP::Tiny to connect to HTTP server over Unix socket"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "__END__"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=pod"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=head1 NAME"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "HTTP::Tiny::UNIX - A subclass of HTTP::Tiny to connect to HTTP server over Unix socket"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=head1 VERSION"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "This document describes version 0.051 of HTTP::Tiny::UNIX (from Perl distribution HTTP-Tiny-UNIX), released on 2018-05-08."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 " use HTTP::Tiny::UNIX;"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 " my $response = HTTP::Tiny::UNIX->new->get('http:/path/to/unix.sock//uri/path');"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 " die \"Failed!\\n\" unless $response->{success};"
NSQ_SOURCE_LINE 00000126 " print \"$response->{status} $response->{reason}\\n\";"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 " while (my ($k, $v) = each %{$response->{headers}}) {"
NSQ_SOURCE_LINE 00000129 "     for (ref $v eq 'ARRAY' ? @$v : $v) {"
NSQ_SOURCE_LINE 00000130 "         print \"$k: $_\\n\";"
NSQ_SOURCE_LINE 00000131 "     }"
NSQ_SOURCE_LINE 00000132 " }"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 " print $response->{content} if length $response->{content};"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "This is a subclass of L<HTTP::Tiny> to connect to HTTP server over Unix socket."
NSQ_SOURCE_LINE 00000139 "URL syntax is C<\"http:\"> + I<path to unix socket> + C<\"/\"> + I<uri path>. For"
NSQ_SOURCE_LINE 00000140 "example: C<http:/var/run/apid.sock//api/v1/matches>. URL not matching this"
NSQ_SOURCE_LINE 00000141 "pattern will be passed to HTTP::Tiny."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "Proxy is currently not supported."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "Please visit the project's homepage at L<https://metacpan.org/release/HTTP-Tiny-UNIX>."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "Source repository is at L<https://github.com/perlancar/perl-HTTP-Tiny-UNIX>."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=head1 BUGS"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=HTTP-Tiny-UNIX>"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000158 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000159 "feature."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "L<HTTP::Tiny>"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "To use L<LWP> to connect over Unix sockets, see"
NSQ_SOURCE_LINE 00000166 "L<LWP::Protocol::http::SocketUnixAlt>."
