NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "package namespace::autoclean; # git description: 0.30-TRIAL-2-ga0e6aea"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: Keep imports out of your namespace"
NSQ_SOURCE_LINE 00000006 "# KEYWORDS: namespaces clean dirty imports exports subroutines methods development"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.31';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use B::Hooks::EndOfScope 0.12;"
NSQ_SOURCE_LINE 00000011 "use List::Util qw( first );"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "BEGIN {"
NSQ_SOURCE_LINE 00000014 "    if (eval { require Sub::Util } && defined &Sub::Util::subname) {"
NSQ_SOURCE_LINE 00000015 "        *subname = \\&Sub::Util::subname;"
NSQ_SOURCE_LINE 00000016 "    }"
NSQ_SOURCE_LINE 00000017 "    else {"
NSQ_SOURCE_LINE 00000018 "        require B;"
NSQ_SOURCE_LINE 00000019 "        *subname = sub {"
NSQ_SOURCE_LINE 00000020 "            my ($coderef) = @_;"
NSQ_SOURCE_LINE 00000021 "            die 'Not a subroutine reference'"
NSQ_SOURCE_LINE 00000022 "                unless ref $coderef;"
NSQ_SOURCE_LINE 00000023 "            my $cv = B::svref_2object($coderef);"
NSQ_SOURCE_LINE 00000024 "            die 'Not a subroutine reference'"
NSQ_SOURCE_LINE 00000025 "                unless $cv->isa('B::CV');"
NSQ_SOURCE_LINE 00000026 "            my $gv = $cv->GV;"
NSQ_SOURCE_LINE 00000027 "            return undef"
NSQ_SOURCE_LINE 00000028 "                if $gv->isa('B::SPECIAL');"
NSQ_SOURCE_LINE 00000029 "            my $stash = $gv->STASH;"
NSQ_SOURCE_LINE 00000030 "            my $package = $stash->isa('B::SPECIAL') ? '__ANON__' : $stash->NAME;"
NSQ_SOURCE_LINE 00000031 "            return $package . '::' . $gv->NAME;"
NSQ_SOURCE_LINE 00000032 "        };"
NSQ_SOURCE_LINE 00000033 "    }"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "use namespace::clean 0.20;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "#pod =head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000039 "#pod"
NSQ_SOURCE_LINE 00000040 "#pod     package Foo;"
NSQ_SOURCE_LINE 00000041 "#pod     use namespace::autoclean;"
NSQ_SOURCE_LINE 00000042 "#pod     use Some::Package qw/imported_function/;"
NSQ_SOURCE_LINE 00000043 "#pod"
NSQ_SOURCE_LINE 00000044 "#pod     sub bar { imported_function('stuff') }"
NSQ_SOURCE_LINE 00000045 "#pod"
NSQ_SOURCE_LINE 00000046 "#pod     # later on:"
NSQ_SOURCE_LINE 00000047 "#pod     Foo->bar;               # works"
NSQ_SOURCE_LINE 00000048 "#pod     Foo->imported_function; # will fail. imported_function got cleaned after compilation"
NSQ_SOURCE_LINE 00000049 "#pod"
NSQ_SOURCE_LINE 00000050 "#pod =head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000051 "#pod"
NSQ_SOURCE_LINE 00000052 "#pod When you import a function into a Perl package, it will naturally also be"
NSQ_SOURCE_LINE 00000053 "#pod available as a method."
NSQ_SOURCE_LINE 00000054 "#pod"
NSQ_SOURCE_LINE 00000055 "#pod The C<namespace::autoclean> pragma will remove all imported symbols at the end"
NSQ_SOURCE_LINE 00000056 "#pod of the current package's compile cycle. Functions called in the package itself"
NSQ_SOURCE_LINE 00000057 "#pod will still be bound by their name, but they won't show up as methods on your"
NSQ_SOURCE_LINE 00000058 "#pod class or instances."
NSQ_SOURCE_LINE 00000059 "#pod"
NSQ_SOURCE_LINE 00000060 "#pod This module is very similar to L<namespace::clean|namespace::clean>, except it"
NSQ_SOURCE_LINE 00000061 "#pod will clean all imported functions, no matter if you imported them before or"
NSQ_SOURCE_LINE 00000062 "#pod after you C<use>d the pragma. It will also not touch anything that looks like a"
NSQ_SOURCE_LINE 00000063 "#pod method."
NSQ_SOURCE_LINE 00000064 "#pod"
NSQ_SOURCE_LINE 00000065 "#pod If you're writing an exporter and you want to clean up after yourself (and your"
NSQ_SOURCE_LINE 00000066 "#pod peers), you can use the C<-cleanee> switch to specify what package to clean:"
NSQ_SOURCE_LINE 00000067 "#pod"
NSQ_SOURCE_LINE 00000068 "#pod   package My::MooseX::namespace::autoclean;"
NSQ_SOURCE_LINE 00000069 "#pod   use strict;"
NSQ_SOURCE_LINE 00000070 "#pod"
NSQ_SOURCE_LINE 00000071 "#pod   use namespace::autoclean (); # no cleanup, just load"
NSQ_SOURCE_LINE 00000072 "#pod"
NSQ_SOURCE_LINE 00000073 "#pod   sub import {"
NSQ_SOURCE_LINE 00000074 "#pod       namespace::autoclean->import("
NSQ_SOURCE_LINE 00000075 "#pod         -cleanee => scalar(caller),"
NSQ_SOURCE_LINE 00000076 "#pod       );"
NSQ_SOURCE_LINE 00000077 "#pod   }"
NSQ_SOURCE_LINE 00000078 "#pod"
NSQ_SOURCE_LINE 00000079 "#pod =head1 WHAT IS AND ISN'T CLEANED"
NSQ_SOURCE_LINE 00000080 "#pod"
NSQ_SOURCE_LINE 00000081 "#pod C<namespace::autoclean> will leave behind anything that it deems a method.  For"
NSQ_SOURCE_LINE 00000082 "#pod L<Moose> classes, this the based on the C<get_method_list> method"
NSQ_SOURCE_LINE 00000083 "#pod on from the L<Class::MOP::Class|metaclass>.  For non-Moose classes, anything"
NSQ_SOURCE_LINE 00000084 "#pod defined within the package will be identified as a method.  This should match"
NSQ_SOURCE_LINE 00000085 "#pod Moose's definition of a method.  Additionally, the magic subs installed by"
NSQ_SOURCE_LINE 00000086 "#pod L<overload> will not be cleaned."
NSQ_SOURCE_LINE 00000087 "#pod"
NSQ_SOURCE_LINE 00000088 "#pod =head1 PARAMETERS"
NSQ_SOURCE_LINE 00000089 "#pod"
NSQ_SOURCE_LINE 00000090 "#pod =head2 -also => [ ITEM | REGEX | SUB, .. ]"
NSQ_SOURCE_LINE 00000091 "#pod"
NSQ_SOURCE_LINE 00000092 "#pod =head2 -also => ITEM"
NSQ_SOURCE_LINE 00000093 "#pod"
NSQ_SOURCE_LINE 00000094 "#pod =head2 -also => REGEX"
NSQ_SOURCE_LINE 00000095 "#pod"
NSQ_SOURCE_LINE 00000096 "#pod =head2 -also => SUB"
NSQ_SOURCE_LINE 00000097 "#pod"
NSQ_SOURCE_LINE 00000098 "#pod Sometimes you don't want to clean imports only, but also helper functions"
NSQ_SOURCE_LINE 00000099 "#pod you're using in your methods. The C<-also> switch can be used to declare a list"
NSQ_SOURCE_LINE 00000100 "#pod of functions that should be removed additional to any imports:"
NSQ_SOURCE_LINE 00000101 "#pod"
NSQ_SOURCE_LINE 00000102 "#pod     use namespace::autoclean -also => ['some_function', 'another_function'];"
NSQ_SOURCE_LINE 00000103 "#pod"
NSQ_SOURCE_LINE 00000104 "#pod If only one function needs to be additionally cleaned the C<-also> switch also"
NSQ_SOURCE_LINE 00000105 "#pod accepts a plain string:"
NSQ_SOURCE_LINE 00000106 "#pod"
NSQ_SOURCE_LINE 00000107 "#pod     use namespace::autoclean -also => 'some_function';"
NSQ_SOURCE_LINE 00000108 "#pod"
NSQ_SOURCE_LINE 00000109 "#pod In some situations, you may wish for a more I<powerful> cleaning solution."
NSQ_SOURCE_LINE 00000110 "#pod"
NSQ_SOURCE_LINE 00000111 "#pod The C<-also> switch can take a Regex or a CodeRef to match against local"
NSQ_SOURCE_LINE 00000112 "#pod function names to clean."
NSQ_SOURCE_LINE 00000113 "#pod"
NSQ_SOURCE_LINE 00000114 "#pod     use namespace::autoclean -also => qr/^_/"
NSQ_SOURCE_LINE 00000115 "#pod"
NSQ_SOURCE_LINE 00000116 "#pod     use namespace::autoclean -also => sub { $_ =~ m{^_} };"
NSQ_SOURCE_LINE 00000117 "#pod"
NSQ_SOURCE_LINE 00000118 "#pod     use namespace::autoclean -also => [qr/^_/ , qr/^hidden_/ ];"
NSQ_SOURCE_LINE 00000119 "#pod"
NSQ_SOURCE_LINE 00000120 "#pod     use namespace::autoclean -also => [sub { $_ =~ m/^_/ or $_ =~ m/^hidden/ }, sub { uc($_) == $_ } ];"
NSQ_SOURCE_LINE 00000121 "#pod"
NSQ_SOURCE_LINE 00000122 "#pod =head2 -except => [ ITEM | REGEX | SUB, .. ]"
NSQ_SOURCE_LINE 00000123 "#pod"
NSQ_SOURCE_LINE 00000124 "#pod =head2 -except => ITEM"
NSQ_SOURCE_LINE 00000125 "#pod"
NSQ_SOURCE_LINE 00000126 "#pod =head2 -except => REGEX"
NSQ_SOURCE_LINE 00000127 "#pod"
NSQ_SOURCE_LINE 00000128 "#pod =head2 -except => SUB"
NSQ_SOURCE_LINE 00000129 "#pod"
NSQ_SOURCE_LINE 00000130 "#pod This takes exactly the same options as C<-also> except that anything this"
NSQ_SOURCE_LINE 00000131 "#pod matches will I<not> be cleaned."
NSQ_SOURCE_LINE 00000132 "#pod"
NSQ_SOURCE_LINE 00000133 "#pod =head1 CAVEATS"
NSQ_SOURCE_LINE 00000134 "#pod"
NSQ_SOURCE_LINE 00000135 "#pod When used with L<Moo> classes, the heuristic used to check for methods won't"
NSQ_SOURCE_LINE 00000136 "#pod work correctly for methods from roles consumed at compile time."
NSQ_SOURCE_LINE 00000137 "#pod"
NSQ_SOURCE_LINE 00000138 "#pod   package My::Class;"
NSQ_SOURCE_LINE 00000139 "#pod   use Moo;"
NSQ_SOURCE_LINE 00000140 "#pod   use namespace::autoclean;"
NSQ_SOURCE_LINE 00000141 "#pod"
NSQ_SOURCE_LINE 00000142 "#pod   # Bad, any consumed methods will be cleaned"
NSQ_SOURCE_LINE 00000143 "#pod   BEGIN { with 'Some::Role' }"
NSQ_SOURCE_LINE 00000144 "#pod"
NSQ_SOURCE_LINE 00000145 "#pod   # Good, methods from role will be maintained"
NSQ_SOURCE_LINE 00000146 "#pod   with 'Some::Role';"
NSQ_SOURCE_LINE 00000147 "#pod"
NSQ_SOURCE_LINE 00000148 "#pod Additionally, method detection may not work properly in L<Mouse> classes in"
NSQ_SOURCE_LINE 00000149 "#pod perls earlier than 5.10."
NSQ_SOURCE_LINE 00000150 "#pod"
NSQ_SOURCE_LINE 00000151 "#pod =head1 SEE ALSO"
NSQ_SOURCE_LINE 00000152 "#pod"
NSQ_SOURCE_LINE 00000153 "#pod =for :list"
NSQ_SOURCE_LINE 00000154 "#pod * L<namespace::clean>"
NSQ_SOURCE_LINE 00000155 "#pod * L<B::Hooks::EndOfScope>"
NSQ_SOURCE_LINE 00000156 "#pod * L<namespace::sweep>"
NSQ_SOURCE_LINE 00000157 "#pod * L<Sub::Exporter::ForMethods>"
NSQ_SOURCE_LINE 00000158 "#pod * L<Sub::Name>"
NSQ_SOURCE_LINE 00000159 "#pod * L<Sub::Install>"
NSQ_SOURCE_LINE 00000160 "#pod * L<Test::CleanNamespaces>"
NSQ_SOURCE_LINE 00000161 "#pod * L<Dist::Zilla::Plugin::Test::CleanNamespaces>"
NSQ_SOURCE_LINE 00000162 "#pod"
NSQ_SOURCE_LINE 00000163 "#pod =cut"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "sub import {"
NSQ_SOURCE_LINE 00000166 "    my ($class, %args) = @_;"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    my $subcast = sub {"
NSQ_SOURCE_LINE 00000169 "        my $i = shift;"
NSQ_SOURCE_LINE 00000170 "        return $i if ref $i eq 'CODE';"
NSQ_SOURCE_LINE 00000171 "        return sub { $_ =~ $i } if ref $i eq 'Regexp';"
NSQ_SOURCE_LINE 00000172 "        return sub { $_ eq $i };"
NSQ_SOURCE_LINE 00000173 "    };"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    my $runtest = sub {"
NSQ_SOURCE_LINE 00000176 "        my ($code, $method_name) = @_;"
NSQ_SOURCE_LINE 00000177 "        local $_ = $method_name;"
NSQ_SOURCE_LINE 00000178 "        return $code->();"
NSQ_SOURCE_LINE 00000179 "    };"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "    my $cleanee = exists $args{-cleanee} ? $args{-cleanee} : scalar caller;"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    my @also = map $subcast->($_), ("
NSQ_SOURCE_LINE 00000184 "        exists $args{-also}"
NSQ_SOURCE_LINE 00000185 "        ? (ref $args{-also} eq 'ARRAY' ? @{ $args{-also} } : $args{-also})"
NSQ_SOURCE_LINE 00000186 "        : ()"
NSQ_SOURCE_LINE 00000187 "    );"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "    my @except = map $subcast->($_), ("
NSQ_SOURCE_LINE 00000190 "        exists $args{-except}"
NSQ_SOURCE_LINE 00000191 "        ? (ref $args{-except} eq 'ARRAY' ? @{ $args{-except} } : $args{-except})"
NSQ_SOURCE_LINE 00000192 "        : ()"
NSQ_SOURCE_LINE 00000193 "    );"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    on_scope_end {"
NSQ_SOURCE_LINE 00000196 "        my $subs = namespace::clean->get_functions($cleanee);"
NSQ_SOURCE_LINE 00000197 "        my $method_check = _method_check($cleanee);"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "        my @clean = grep {"
NSQ_SOURCE_LINE 00000200 "          my $method = $_;"
NSQ_SOURCE_LINE 00000201 "          ! first { $runtest->($_, $method) } @except"
NSQ_SOURCE_LINE 00000202 "            and ( !$method_check->($method)"
NSQ_SOURCE_LINE 00000203 "              or first { $runtest->($_, $method) } @also)"
NSQ_SOURCE_LINE 00000204 "        } keys %$subs;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "        namespace::clean->clean_subroutines($cleanee, @clean);"
NSQ_SOURCE_LINE 00000207 "    };"
NSQ_SOURCE_LINE 00000208 "}"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "sub _method_check {"
NSQ_SOURCE_LINE 00000211 "    my $package = shift;"
NSQ_SOURCE_LINE 00000212 "    if ("
NSQ_SOURCE_LINE 00000213 "      (defined &Class::MOP::class_of and my $meta = Class::MOP::class_of($package))"
NSQ_SOURCE_LINE 00000214 "    ) {"
NSQ_SOURCE_LINE 00000215 "        my %methods = map +($_ => 1), $meta->get_method_list;"
NSQ_SOURCE_LINE 00000216 "        $methods{meta} = 1"
NSQ_SOURCE_LINE 00000217 "          if $meta->isa('Moose::Meta::Role') && Moose->VERSION < 0.90;"
NSQ_SOURCE_LINE 00000218 "        return sub { $_[0] =~ /^\\(/ || $methods{$_[0]} };"
NSQ_SOURCE_LINE 00000219 "    }"
NSQ_SOURCE_LINE 00000220 "    else {"
NSQ_SOURCE_LINE 00000221 "        my $does = $package->can('does') ? 'does'"
NSQ_SOURCE_LINE 00000222 "                 : $package->can('DOES') ? 'DOES'"
NSQ_SOURCE_LINE 00000223 "                 : undef;"
NSQ_SOURCE_LINE 00000224 "        return sub {"
NSQ_SOURCE_LINE 00000225 "            return 1 if $_[0] =~ /^\\(/;"
NSQ_SOURCE_LINE 00000226 "            my $coderef = do { no strict 'refs'; \\&{ $package . '::' . $_[0] } };"
NSQ_SOURCE_LINE 00000227 "            my ($code_stash) = subname($coderef) =~ /\\A(.*)::/s;"
NSQ_SOURCE_LINE 00000228 "            return 1 if $code_stash eq $package;"
NSQ_SOURCE_LINE 00000229 "            return 1 if $code_stash eq 'constant';"
NSQ_SOURCE_LINE 00000230 "            # TODO: consider if we really need this eval"
NSQ_SOURCE_LINE 00000231 "            return 1 if $does && eval { $package->$does($code_stash) };"
NSQ_SOURCE_LINE 00000232 "            return 0;"
NSQ_SOURCE_LINE 00000233 "        };"
NSQ_SOURCE_LINE 00000234 "    }"
NSQ_SOURCE_LINE 00000235 "}"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "1;"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "__END__"
