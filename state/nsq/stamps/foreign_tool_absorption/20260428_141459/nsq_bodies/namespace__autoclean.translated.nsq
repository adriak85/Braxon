NSQ_SOURCE_LINE 00000245 "=head1 NAME"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "namespace::autoclean - Keep imports out of your namespace"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=head1 VERSION"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "version 0.31"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "    package Foo;"
NSQ_SOURCE_LINE 00000256 "    use namespace::autoclean;"
NSQ_SOURCE_LINE 00000257 "    use Some::Package qw/imported_function/;"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "    sub bar { imported_function('stuff') }"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "    # later on:"
NSQ_SOURCE_LINE 00000262 "    Foo->bar;               # works"
NSQ_SOURCE_LINE 00000263 "    Foo->imported_function; # will fail. imported_function got cleaned after compilation"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "When you import a function into a Perl package, it will naturally also be"
NSQ_SOURCE_LINE 00000268 "available as a method."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "The C<namespace::autoclean> pragma will remove all imported symbols at the end"
NSQ_SOURCE_LINE 00000271 "of the current package's compile cycle. Functions called in the package itself"
NSQ_SOURCE_LINE 00000272 "will still be bound by their name, but they won't show up as methods on your"
NSQ_SOURCE_LINE 00000273 "class or instances."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "This module is very similar to L<namespace::clean|namespace::clean>, except it"
NSQ_SOURCE_LINE 00000276 "will clean all imported functions, no matter if you imported them before or"
NSQ_SOURCE_LINE 00000277 "after you C<use>d the pragma. It will also not touch anything that looks like a"
NSQ_SOURCE_LINE 00000278 "method."
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "If you're writing an exporter and you want to clean up after yourself (and your"
NSQ_SOURCE_LINE 00000281 "peers), you can use the C<-cleanee> switch to specify what package to clean:"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "  package My::MooseX::namespace::autoclean;"
NSQ_SOURCE_LINE 00000284 "  use strict;"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "  use namespace::autoclean (); # no cleanup, just load"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "  sub import {"
NSQ_SOURCE_LINE 00000289 "      namespace::autoclean->import("
NSQ_SOURCE_LINE 00000290 "        -cleanee => scalar(caller),"
NSQ_SOURCE_LINE 00000291 "      );"
NSQ_SOURCE_LINE 00000292 "  }"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=head1 WHAT IS AND ISN'T CLEANED"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "C<namespace::autoclean> will leave behind anything that it deems a method.  For"
NSQ_SOURCE_LINE 00000297 "L<Moose> classes, this the based on the C<get_method_list> method"
NSQ_SOURCE_LINE 00000298 "on from the L<Class::MOP::Class|metaclass>.  For non-Moose classes, anything"
NSQ_SOURCE_LINE 00000299 "defined within the package will be identified as a method.  This should match"
NSQ_SOURCE_LINE 00000300 "Moose's definition of a method.  Additionally, the magic subs installed by"
NSQ_SOURCE_LINE 00000301 "L<overload> will not be cleaned."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=head1 PARAMETERS"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=head2 -also => [ ITEM | REGEX | SUB, .. ]"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=head2 -also => ITEM"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head2 -also => REGEX"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "=head2 -also => SUB"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "Sometimes you don't want to clean imports only, but also helper functions"
NSQ_SOURCE_LINE 00000314 "you're using in your methods. The C<-also> switch can be used to declare a list"
NSQ_SOURCE_LINE 00000315 "of functions that should be removed additional to any imports:"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "    use namespace::autoclean -also => ['some_function', 'another_function'];"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "If only one function needs to be additionally cleaned the C<-also> switch also"
NSQ_SOURCE_LINE 00000320 "accepts a plain string:"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "    use namespace::autoclean -also => 'some_function';"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "In some situations, you may wish for a more I<powerful> cleaning solution."
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "The C<-also> switch can take a Regex or a CodeRef to match against local"
NSQ_SOURCE_LINE 00000327 "function names to clean."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "    use namespace::autoclean -also => qr/^_/"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "    use namespace::autoclean -also => sub { $_ =~ m{^_} };"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "    use namespace::autoclean -also => [qr/^_/ , qr/^hidden_/ ];"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "    use namespace::autoclean -also => [sub { $_ =~ m/^_/ or $_ =~ m/^hidden/ }, sub { uc($_) == $_ } ];"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=head2 -except => [ ITEM | REGEX | SUB, .. ]"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "=head2 -except => ITEM"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "=head2 -except => REGEX"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "=head2 -except => SUB"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "This takes exactly the same options as C<-also> except that anything this"
NSQ_SOURCE_LINE 00000346 "matches will I<not> be cleaned."
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "When used with L<Moo> classes, the heuristic used to check for methods won't"
NSQ_SOURCE_LINE 00000351 "work correctly for methods from roles consumed at compile time."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "  package My::Class;"
NSQ_SOURCE_LINE 00000354 "  use Moo;"
NSQ_SOURCE_LINE 00000355 "  use namespace::autoclean;"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "  # Bad, any consumed methods will be cleaned"
NSQ_SOURCE_LINE 00000358 "  BEGIN { with 'Some::Role' }"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "  # Good, methods from role will be maintained"
NSQ_SOURCE_LINE 00000361 "  with 'Some::Role';"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "Additionally, method detection may not work properly in L<Mouse> classes in"
NSQ_SOURCE_LINE 00000364 "perls earlier than 5.10."
