BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Digest::BubbleBabble;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use 5.008_001;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use Exporter;"
NSQ_SOURCE_LINE 00000006 "use vars qw( @EXPORT_OK @ISA $VERSION );"
NSQ_SOURCE_LINE 00000007 "@ISA = qw( Exporter );"
NSQ_SOURCE_LINE 00000008 "@EXPORT_OK = qw( bubblebabble );"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "$VERSION = '0.02';"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use vars qw( @VOWELS @CONSONANTS );"
NSQ_SOURCE_LINE 00000013 "@VOWELS = qw( a e i o u y );"
NSQ_SOURCE_LINE 00000014 "@CONSONANTS = qw( b c d f g h k l m n p r s t v z x );"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub bubblebabble {"
NSQ_SOURCE_LINE 00000017 "    my %param = @_;"
NSQ_SOURCE_LINE 00000018 "    my @dgst = map ord, split //, $param{Digest};"
NSQ_SOURCE_LINE 00000019 "    my $dlen = length $param{Digest};"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "    my $seed = 1;"
NSQ_SOURCE_LINE 00000022 "    my $rounds = int($dlen / 2) + 1;"
NSQ_SOURCE_LINE 00000023 "    my $retval = 'x';"
NSQ_SOURCE_LINE 00000024 "    for my $i (0..$rounds-1) {"
NSQ_SOURCE_LINE 00000025 "        if ($i+1 < $rounds || $dlen % 2) {"
NSQ_SOURCE_LINE 00000026 "            my $idx0 = ((($dgst[2 * $i] >> 6) & 3) + $seed) % 6;"
NSQ_SOURCE_LINE 00000027 "            my $idx1 = ($dgst[2 * $i] >> 2) & 15;"
NSQ_SOURCE_LINE 00000028 "            my $idx2 = (($dgst[2 * $i] & 3) + $seed / 6) % 6;"
NSQ_SOURCE_LINE 00000029 "            $retval .= $VOWELS[$idx0] . $CONSONANTS[$idx1] . $VOWELS[$idx2];"
NSQ_SOURCE_LINE 00000030 "            if ($i+1 < $rounds) {"
NSQ_SOURCE_LINE 00000031 "                my $idx3 = ($dgst[2 * $i + 1] >> 4) & 15;"
NSQ_SOURCE_LINE 00000032 "                my $idx4 = $dgst[2 * $i + 1] & 15;"
NSQ_SOURCE_LINE 00000033 "                $retval .= $CONSONANTS[$idx3] . '-' . $CONSONANTS[$idx4];"
NSQ_SOURCE_LINE 00000034 "                $seed = ($seed * 5 + $dgst[2 * $i] * 7 +"
NSQ_SOURCE_LINE 00000035 "                        $dgst[2 * $i + 1]) % 36;"
NSQ_SOURCE_LINE 00000036 "            }"
NSQ_SOURCE_LINE 00000037 "        }"
NSQ_SOURCE_LINE 00000038 "        else {"
NSQ_SOURCE_LINE 00000039 "            my $idx0 = $seed % 6;"
NSQ_SOURCE_LINE 00000040 "            my $idx1 = 16;"
NSQ_SOURCE_LINE 00000041 "            my $idx2 = $seed / 6;"
NSQ_SOURCE_LINE 00000042 "            $retval .= $VOWELS[$idx0] . $CONSONANTS[$idx1] . $VOWELS[$idx2];"
NSQ_SOURCE_LINE 00000043 "        }"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 "    $retval .= 'x';"
NSQ_SOURCE_LINE 00000046 "    $retval;"
NSQ_SOURCE_LINE 00000047 "}"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "1;"
NSQ_SOURCE_LINE 00000050 "__END__"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=head1 NAME"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "Digest::BubbleBabble - Create bubble-babble fingerprints"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    # Create a fingerprint of a simple string."
NSQ_SOURCE_LINE 00000059 "    use Digest::BubbleBabble qw( bubblebabble );"
NSQ_SOURCE_LINE 00000060 "    my $fingerprint = bubblebabble( Digest => \"Pineapple\" );"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    # Create a fingerprint of a SHA-1 hash."
NSQ_SOURCE_LINE 00000063 "    use Digest::SHA1 qw( sha1 );"
NSQ_SOURCE_LINE 00000064 "    $fingerprint = bubblebabble( Digest => sha1(\"hello\") );"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "I<Digest::BubbleBabble> takes a message digest (often generated by"
NSQ_SOURCE_LINE 00000069 "either of the MD5 or SHA-1 message digest algorithms) and creates"
NSQ_SOURCE_LINE 00000070 "a fingerprint of that digest in \"bubble babble\" format."
NSQ_SOURCE_LINE 00000071 "Bubble babble is a method of representing a message digest"
NSQ_SOURCE_LINE 00000072 "as a string of \"real\" words, to make the fingerprint easier"
NSQ_SOURCE_LINE 00000073 "to remember. The \"words\" are not necessarily real words, but"
NSQ_SOURCE_LINE 00000074 "they look more like words than a string of hex characters."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "Bubble babble fingerprinting is used by the SSH2 suite"
NSQ_SOURCE_LINE 00000077 "(and, consequently, by I<Net::SSH::Perl>, the Perl SSH"
NSQ_SOURCE_LINE 00000078 "implementation) to display easy-to-remember key fingerprints."
NSQ_SOURCE_LINE 00000079 "The key (a DSA or RSA key) is converted into a textual form,"
NSQ_SOURCE_LINE 00000080 "digested using I<Digest::SHA1>, and run through I<bubblebabble>"
NSQ_SOURCE_LINE 00000081 "to create the key fingerprint."
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=head1 USAGE"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "I<Digest::BubbleBabble> conditionally exports one function called"
NSQ_SOURCE_LINE 00000086 "I<bubblebabble>; to import the function you must choose to"
NSQ_SOURCE_LINE 00000087 "import it, like this:"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    use Digest::BubbleBabble qw( bubblebabble );"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=head2 bubblebabble( Digest => $digest )"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "Currently takes only one pair of arguments, the key of"
NSQ_SOURCE_LINE 00000094 "which must be I<Digest>, the value of which is the actual"
NSQ_SOURCE_LINE 00000095 "message digest I<$digest>. You should generate this message"
NSQ_SOURCE_LINE 00000096 "digest yourself using either I<Digest::MD5> of I<Digest::SHA1>."
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "Returns the bubble babble form of the digest."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "The BubbleBabble specification is available at:"
NSQ_SOURCE_LINE 00000103 "http://web.mit.edu/kenta/www/one/bubblebabble/spec/jrtrjwzi/draft-huima-01.txt"
NSQ_SOURCE_LINE 00000104 ""
