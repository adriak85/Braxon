NSQ_SOURCE_LINE 00000001 "package Sub::Name; # git description: v0.27-3-g0429db7"
NSQ_SOURCE_LINE 00000002 "# ABSTRACT: (Re)name a sub"
NSQ_SOURCE_LINE 00000003 "# KEYWORDS: subroutine function utility name rename symbol"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "#pod =pod"
NSQ_SOURCE_LINE 00000006 "#pod"
NSQ_SOURCE_LINE 00000007 "#pod =head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000008 "#pod"
NSQ_SOURCE_LINE 00000009 "#pod     use Sub::Name;"
NSQ_SOURCE_LINE 00000010 "#pod"
NSQ_SOURCE_LINE 00000011 "#pod     subname $name, $subref;"
NSQ_SOURCE_LINE 00000012 "#pod"
NSQ_SOURCE_LINE 00000013 "#pod     $subref = subname foo => sub { ... };"
NSQ_SOURCE_LINE 00000014 "#pod"
NSQ_SOURCE_LINE 00000015 "#pod =head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000016 "#pod"
NSQ_SOURCE_LINE 00000017 "#pod This module has only one function, which is also exported by default:"
NSQ_SOURCE_LINE 00000018 "#pod"
NSQ_SOURCE_LINE 00000019 "#pod =for stopwords subname"
NSQ_SOURCE_LINE 00000020 "#pod"
NSQ_SOURCE_LINE 00000021 "#pod =head2 subname NAME, CODEREF"
NSQ_SOURCE_LINE 00000022 "#pod"
NSQ_SOURCE_LINE 00000023 "#pod Assigns a new name to referenced sub.  If package specification is omitted in"
NSQ_SOURCE_LINE 00000024 "#pod the name, then the current package is used.  The return value is the sub."
NSQ_SOURCE_LINE 00000025 "#pod"
NSQ_SOURCE_LINE 00000026 "#pod The name is only used for informative routines (caller, Carp, etc).  You won't"
NSQ_SOURCE_LINE 00000027 "#pod be able to actually invoke the sub by the given name.  To allow that, you need"
NSQ_SOURCE_LINE 00000028 "#pod to do glob-assignment yourself."
NSQ_SOURCE_LINE 00000029 "#pod"
NSQ_SOURCE_LINE 00000030 "#pod Note that for anonymous closures (subs that reference lexicals declared outside"
NSQ_SOURCE_LINE 00000031 "#pod the sub itself) you can name each instance of the closure differently, which"
NSQ_SOURCE_LINE 00000032 "#pod can be very useful for debugging."
NSQ_SOURCE_LINE 00000033 "#pod"
NSQ_SOURCE_LINE 00000034 "#pod =head1 SEE ALSO"
NSQ_SOURCE_LINE 00000035 "#pod"
NSQ_SOURCE_LINE 00000036 "#pod =for :list"
NSQ_SOURCE_LINE 00000037 "#pod * L<Sub::Identify> - for getting information about subs"
NSQ_SOURCE_LINE 00000038 "#pod * L<Sub::Util> - set_subname is another implementation of C<subname>"
NSQ_SOURCE_LINE 00000039 "#pod"
NSQ_SOURCE_LINE 00000040 "#pod =for stopwords cPanel"
