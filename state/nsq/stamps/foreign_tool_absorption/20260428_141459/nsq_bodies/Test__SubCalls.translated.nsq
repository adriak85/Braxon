BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Test::SubCalls; # git description: d4e5915"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "=pod"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "=head1 NAME"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "Test::SubCalls - Track the number of times subs are called"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "=head1 VERSION"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "version 1.10"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "  use Test::SubCalls;"
NSQ_SOURCE_LINE 00000016 "  "
NSQ_SOURCE_LINE 00000017 "  # Start tracking calls to a named sub"
NSQ_SOURCE_LINE 00000018 "  sub_track( 'Foo::foo' );"
NSQ_SOURCE_LINE 00000019 "  "
NSQ_SOURCE_LINE 00000020 "  # Run some test code"
NSQ_SOURCE_LINE 00000021 "  ..."
NSQ_SOURCE_LINE 00000022 "  "
NSQ_SOURCE_LINE 00000023 "  # Test that some sub deep in the codebase was called"
NSQ_SOURCE_LINE 00000024 "  # a specific number of times."
NSQ_SOURCE_LINE 00000025 "  sub_calls( 'Foo::foo', 5 );"
NSQ_SOURCE_LINE 00000026 "  sub_calls( 'Foo::foo', 5, 'Use a custom test message' );"
NSQ_SOURCE_LINE 00000027 "  "
NSQ_SOURCE_LINE 00000028 "  # Reset the counts for one or all subs"
NSQ_SOURCE_LINE 00000029 "  sub_reset( 'Foo::foo' );"
NSQ_SOURCE_LINE 00000030 "  sub_reset_all();"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "There are a number of different situations (like testing caching code)"
NSQ_SOURCE_LINE 00000035 "where you want to want to do a number of tests, and then verify that"
NSQ_SOURCE_LINE 00000036 "some underlying subroutine deep within the code was called a specific"
NSQ_SOURCE_LINE 00000037 "number of times."
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "This module provides a number of functions for doing testing in this way"
NSQ_SOURCE_LINE 00000040 "in association with your normal L<Test::More> (or similar) test scripts."
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "In the nature of test modules, all functions are exported by default."
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=cut"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "use 5.006;"
NSQ_SOURCE_LINE 00000049 "use strict;"
NSQ_SOURCE_LINE 00000050 "use File::Spec    0.80 ();"
NSQ_SOURCE_LINE 00000051 "use Test::More    0.42 ();"
NSQ_SOURCE_LINE 00000052 "use Hook::LexWrap 0.20 ();"
NSQ_SOURCE_LINE 00000053 "use Exporter           ();"
NSQ_SOURCE_LINE 00000054 "use Test::Builder      ();"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "our $VERSION = '1.10';"
NSQ_SOURCE_LINE 00000057 "use vars qw{@ISA @EXPORT};"
NSQ_SOURCE_LINE 00000058 "BEGIN {"
NSQ_SOURCE_LINE 00000059 "\t@ISA     = 'Exporter';"
NSQ_SOURCE_LINE 00000060 "\t@EXPORT  = qw{sub_track sub_calls sub_reset sub_reset_all};"
NSQ_SOURCE_LINE 00000061 "}"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "my $Test = Test::Builder->new;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "my %CALLS = ();"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "#####################################################################"
NSQ_SOURCE_LINE 00000072 "# Test::SubCalls Functions"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=pod"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=head2 sub_track $subname"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "The C<sub_track> function creates a new call tracker for a named function."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "The sub to track must be provided by name, references to the function"
NSQ_SOURCE_LINE 00000081 "itself are insufficient."
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "Returns true if added, or dies on error."
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "=cut"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "sub sub_track {"
NSQ_SOURCE_LINE 00000088 "\t# Check the sub name is valid"
NSQ_SOURCE_LINE 00000089 "\tmy $subname = shift;"
NSQ_SOURCE_LINE 00000090 "\tSCOPE: {"
NSQ_SOURCE_LINE 00000091 "\t\tno strict 'refs';"
NSQ_SOURCE_LINE 00000092 "\t\tunless ( defined *{\"$subname\"}{CODE} ) {"
NSQ_SOURCE_LINE 00000093 "\t\t\tdie \"Test::SubCalls::sub_track : The sub '$subname' does not exist\";"
NSQ_SOURCE_LINE 00000094 "\t\t}"
NSQ_SOURCE_LINE 00000095 "\t\tif ( defined $CALLS{$subname} ) {"
NSQ_SOURCE_LINE 00000096 "\t\t\tdie \"Test::SubCalls::sub_track : Cannot add duplicate tracker for '$subname'\";"
NSQ_SOURCE_LINE 00000097 "\t\t}"
NSQ_SOURCE_LINE 00000098 "\t}"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "\t# Initialise the count"
NSQ_SOURCE_LINE 00000101 "\t$CALLS{$subname} = 0;"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "\t# Lexwrap the subroutine"
NSQ_SOURCE_LINE 00000104 "\tHook::LexWrap::wrap("
NSQ_SOURCE_LINE 00000105 "\t\t$subname,"
NSQ_SOURCE_LINE 00000106 "\t\tpre => sub { $CALLS{$subname}++ },"
NSQ_SOURCE_LINE 00000107 "\t);"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "\t1;"
NSQ_SOURCE_LINE 00000110 "}"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=pod"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head2 sub_calls $subname, $expected_calls [, $message ]"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "The C<sub_calls> function is the primary (and only) testing function"
NSQ_SOURCE_LINE 00000117 "provided by C<Test::SubCalls>. A single call will represent one test in"
NSQ_SOURCE_LINE 00000118 "your plan."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "It takes the subroutine name as originally provided to C<sub_track>,"
NSQ_SOURCE_LINE 00000121 "the expected number of times the subroutine should have been called,"
NSQ_SOURCE_LINE 00000122 "and an optional test message."
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "If no message is provided, a default message will be provided for you."
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "Test is ok if the number of times the sub has been called matches the"
NSQ_SOURCE_LINE 00000127 "expected number, or not ok if not."
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "=cut"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "sub sub_calls {"
NSQ_SOURCE_LINE 00000132 "\t# Check the sub name is valid"
NSQ_SOURCE_LINE 00000133 "\tmy $subname = shift;"
NSQ_SOURCE_LINE 00000134 "\tunless ( defined $CALLS{$subname} ) {"
NSQ_SOURCE_LINE 00000135 "\t\tdie \"Test::SubCalls::sub_calls : Cannot test untracked sub '$subname'\";"
NSQ_SOURCE_LINE 00000136 "\t}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "\t# Check the count"
NSQ_SOURCE_LINE 00000139 "\tmy $count = shift;"
NSQ_SOURCE_LINE 00000140 "\tunless ( $count =~ /^(?:0|[1-9]\\d*)\\z/s ) {"
NSQ_SOURCE_LINE 00000141 "\t\tdie \"Test::SubCalls::sub_calls : Expected count '$count' is not an integer\";"
NSQ_SOURCE_LINE 00000142 "\t}"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "\t# Get the message, applying default if needed"
NSQ_SOURCE_LINE 00000145 "\tmy $message = shift || \"$subname was called $count times\";"
NSQ_SOURCE_LINE 00000146 "\t$Test->is_num( $CALLS{$subname}, $count, $message );"
NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=pod"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=head2 sub_reset $subname"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "To prevent repeat users from having to take before and after counts when"
NSQ_SOURCE_LINE 00000154 "they start testing from after zero, the C<sub_reset> function has been"
NSQ_SOURCE_LINE 00000155 "provided to reset a sub call counter to zero."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Returns true or dies if the sub name is invalid or not currently tracked."
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=cut"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "sub sub_reset {"
NSQ_SOURCE_LINE 00000162 "\t# Check the sub name is valid"
NSQ_SOURCE_LINE 00000163 "\tmy $subname = shift;"
NSQ_SOURCE_LINE 00000164 "\tunless ( defined $CALLS{$subname} ) {"
NSQ_SOURCE_LINE 00000165 "\t\tdie \"Test::SubCalls::sub_reset : Cannot reset untracked sub '$subname'\";"
NSQ_SOURCE_LINE 00000166 "\t}"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "\t$CALLS{$subname} = 0;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "\t1;"
NSQ_SOURCE_LINE 00000171 "}"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=pod"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=head2 sub_reset_all"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "Provided mainly as a convenience, the C<sub_reset_all> function will reset"
NSQ_SOURCE_LINE 00000178 "all the counters currently defined."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "Returns true."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=cut"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "sub sub_reset_all {"
NSQ_SOURCE_LINE 00000185 "\tforeach my $subname ( keys %CALLS ) {"
NSQ_SOURCE_LINE 00000186 "\t\t$CALLS{$subname} = 0;"
NSQ_SOURCE_LINE 00000187 "\t}"
NSQ_SOURCE_LINE 00000188 "\t1;"
NSQ_SOURCE_LINE 00000189 "}"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "1;"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=pod"
NSQ_SOURCE_LINE 00000194 ""
