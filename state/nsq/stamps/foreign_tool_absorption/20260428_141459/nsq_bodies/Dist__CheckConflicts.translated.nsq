NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "L<https://metacpan.org/release/Dist-CheckConflicts>"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "=item * Github"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "L<https://github.com/doy/dist-checkconflicts>"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "=item * RT: CPAN's request tracker"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "L<http://rt.cpan.org/NoAuth/Bugs.html?Dist=Dist-CheckConflicts>"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "=item * CPAN Ratings"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "L<http://cpanratings.perl.org/d/Dist-CheckConflicts>"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "=back"
