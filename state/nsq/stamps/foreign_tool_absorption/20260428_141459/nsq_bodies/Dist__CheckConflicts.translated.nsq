BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Dist::CheckConflicts;"
NSQ_SOURCE_LINE 00000002 "BEGIN {"
NSQ_SOURCE_LINE 00000003 "  $Dist::CheckConflicts::AUTHORITY = 'cpan:DOY';"
NSQ_SOURCE_LINE 00000004 "}"
NSQ_SOURCE_LINE 00000005 "$Dist::CheckConflicts::VERSION = '0.11';"
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 "use 5.006;"
NSQ_SOURCE_LINE 00000009 "# ABSTRACT: declare version conflicts for your dist"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000012 "our @EXPORT = our @EXPORT_OK = ("
NSQ_SOURCE_LINE 00000013 "    qw(conflicts check_conflicts calculate_conflicts dist)"
NSQ_SOURCE_LINE 00000014 ");"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "use Carp;"
NSQ_SOURCE_LINE 00000017 "use Module::Runtime 0.009 'module_notional_filename', 'require_module';"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "my %CONFLICTS;"
NSQ_SOURCE_LINE 00000021 "my %HAS_CONFLICTS;"
NSQ_SOURCE_LINE 00000022 "my %DISTS;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "sub import {"
NSQ_SOURCE_LINE 00000025 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000026 "    my $for = caller;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    my ($conflicts, $alsos, $dist);"
NSQ_SOURCE_LINE 00000029 "    ($conflicts, @_) = _strip_opt('-conflicts' => @_);"
NSQ_SOURCE_LINE 00000030 "    ($alsos, @_)     = _strip_opt('-also' => @_);"
NSQ_SOURCE_LINE 00000031 "    ($dist, @_)      = _strip_opt('-dist' => @_);"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    my %conflicts = %{ $conflicts || {} };"
NSQ_SOURCE_LINE 00000034 "    for my $also (@{ $alsos || [] }) {"
NSQ_SOURCE_LINE 00000035 "        eval { require_module($also) } or next;"
NSQ_SOURCE_LINE 00000036 "        if (!exists $CONFLICTS{$also}) {"
NSQ_SOURCE_LINE 00000037 "            $also .= '::Conflicts';"
NSQ_SOURCE_LINE 00000038 "            eval { require_module($also) } or next;"
NSQ_SOURCE_LINE 00000039 "        }"
NSQ_SOURCE_LINE 00000040 "        if (!exists $CONFLICTS{$also}) {"
NSQ_SOURCE_LINE 00000041 "            next;"
NSQ_SOURCE_LINE 00000042 "        }"
NSQ_SOURCE_LINE 00000043 "        my %also_confs = $also->conflicts;"
NSQ_SOURCE_LINE 00000044 "        for my $also_conf (keys %also_confs) {"
NSQ_SOURCE_LINE 00000045 "            $conflicts{$also_conf} = $also_confs{$also_conf}"
NSQ_SOURCE_LINE 00000046 "                if !exists $conflicts{$also_conf}"
NSQ_SOURCE_LINE 00000047 "                || $conflicts{$also_conf} lt $also_confs{$also_conf};"
NSQ_SOURCE_LINE 00000048 "        }"
NSQ_SOURCE_LINE 00000049 "    }"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    $CONFLICTS{$for} = \\%conflicts;"
NSQ_SOURCE_LINE 00000052 "    $DISTS{$for}     = $dist || $for;"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    if (grep { $_ eq ':runtime' } @_) {"
NSQ_SOURCE_LINE 00000055 "        for my $conflict (keys %conflicts) {"
NSQ_SOURCE_LINE 00000056 "            $HAS_CONFLICTS{$conflict} ||= [];"
NSQ_SOURCE_LINE 00000057 "            push @{ $HAS_CONFLICTS{$conflict} }, $for;"
NSQ_SOURCE_LINE 00000058 "        }"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "        # warn for already loaded things..."
NSQ_SOURCE_LINE 00000061 "        for my $conflict (keys %conflicts) {"
NSQ_SOURCE_LINE 00000062 "            if (exists $INC{module_notional_filename($conflict)}) {"
NSQ_SOURCE_LINE 00000063 "                _check_version([$for], $conflict);"
NSQ_SOURCE_LINE 00000064 "            }"
NSQ_SOURCE_LINE 00000065 "        }"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "        # and warn for subsequently loaded things..."
NSQ_SOURCE_LINE 00000068 "        @INC = grep {"
NSQ_SOURCE_LINE 00000069 "            !(ref($_) eq 'ARRAY' && @$_ > 1 && $_->[1] == \\%CONFLICTS)"
NSQ_SOURCE_LINE 00000070 "        } @INC;"
NSQ_SOURCE_LINE 00000071 "        unshift @INC, ["
NSQ_SOURCE_LINE 00000072 "            sub {"
NSQ_SOURCE_LINE 00000073 "                my ($sub, $file) = @_;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "                (my $mod = $file) =~ s{\\.pm$}{};"
NSQ_SOURCE_LINE 00000076 "                $mod =~ s{/}{::}g;"
NSQ_SOURCE_LINE 00000077 "                return unless $mod =~ /[\\w:]+/;"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "                return unless defined $HAS_CONFLICTS{$mod};"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "                {"
NSQ_SOURCE_LINE 00000082 "                    local $HAS_CONFLICTS{$mod};"
NSQ_SOURCE_LINE 00000083 "                    require $file;"
NSQ_SOURCE_LINE 00000084 "                }"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "                _check_version($HAS_CONFLICTS{$mod}, $mod);"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "                # the previous require already handled it"
NSQ_SOURCE_LINE 00000089 "                my $called;"
NSQ_SOURCE_LINE 00000090 "                return sub {"
NSQ_SOURCE_LINE 00000091 "                    return 0 if $called;"
NSQ_SOURCE_LINE 00000092 "                    $_ = \"1;\";"
NSQ_SOURCE_LINE 00000093 "                    $called = 1;"
NSQ_SOURCE_LINE 00000094 "                    return 1;"
NSQ_SOURCE_LINE 00000095 "                };"
NSQ_SOURCE_LINE 00000096 "            },"
NSQ_SOURCE_LINE 00000097 "            \\%CONFLICTS, # arbitrary but unique, see above"
NSQ_SOURCE_LINE 00000098 "        ];"
NSQ_SOURCE_LINE 00000099 "    }"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    $pkg->export_to_level(1, @_);"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub _strip_opt {"
NSQ_SOURCE_LINE 00000105 "    my ($opt, @args) = @_;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    my $val;"
NSQ_SOURCE_LINE 00000108 "    for my $idx ( 0 .. $#args - 1 ) {"
NSQ_SOURCE_LINE 00000109 "        if (defined $args[$idx] && $args[$idx] eq $opt) {"
NSQ_SOURCE_LINE 00000110 "            $val = (splice @args, $idx, 2)[1];"
NSQ_SOURCE_LINE 00000111 "            last;"
NSQ_SOURCE_LINE 00000112 "        }"
NSQ_SOURCE_LINE 00000113 "    }"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    return ( $val, @args );"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "sub _check_version {"
NSQ_SOURCE_LINE 00000119 "    my ($fors, $mod) = @_;"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "    for my $for (@$fors) {"
NSQ_SOURCE_LINE 00000122 "        my $conflict_ver = $CONFLICTS{$for}{$mod};"
NSQ_SOURCE_LINE 00000123 "        my $version = do {"
NSQ_SOURCE_LINE 00000124 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000125 "            ${ ${ $mod . '::' }{VERSION} };"
NSQ_SOURCE_LINE 00000126 "        };"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "        if ($version le $conflict_ver) {"
NSQ_SOURCE_LINE 00000129 "            warn <<EOF;"
NSQ_SOURCE_LINE 00000130 "Conflict detected for $DISTS{$for}:"
NSQ_SOURCE_LINE 00000131 "  $mod is version $version, but must be greater than version $conflict_ver"
NSQ_SOURCE_LINE 00000132 "EOF"
NSQ_SOURCE_LINE 00000133 "            return;"
NSQ_SOURCE_LINE 00000134 "        }"
NSQ_SOURCE_LINE 00000135 "    }"
NSQ_SOURCE_LINE 00000136 "}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "sub conflicts {"
NSQ_SOURCE_LINE 00000140 "    my $package = shift;"
NSQ_SOURCE_LINE 00000141 "    return %{ $CONFLICTS{ $package } };"
NSQ_SOURCE_LINE 00000142 "}"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "sub dist {"
NSQ_SOURCE_LINE 00000146 "    my $package = shift;"
NSQ_SOURCE_LINE 00000147 "    return $DISTS{ $package };"
NSQ_SOURCE_LINE 00000148 "}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "sub check_conflicts {"
NSQ_SOURCE_LINE 00000152 "    my $package = shift;"
NSQ_SOURCE_LINE 00000153 "    my $dist = $package->dist;"
NSQ_SOURCE_LINE 00000154 "    my @conflicts = $package->calculate_conflicts;"
NSQ_SOURCE_LINE 00000155 "    return unless @conflicts;"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    my $err = \"Conflicts detected for $dist:\\n\";"
NSQ_SOURCE_LINE 00000158 "    for my $conflict (@conflicts) {"
NSQ_SOURCE_LINE 00000159 "        $err .= \"  $conflict->{package} is version \""
NSQ_SOURCE_LINE 00000160 "                . \"$conflict->{installed}, but must be greater than version \""
NSQ_SOURCE_LINE 00000161 "                . \"$conflict->{required}\\n\";"
NSQ_SOURCE_LINE 00000162 "    }"
NSQ_SOURCE_LINE 00000163 "    die $err;"
NSQ_SOURCE_LINE 00000164 "}"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "sub calculate_conflicts {"
NSQ_SOURCE_LINE 00000168 "    my $package = shift;"
NSQ_SOURCE_LINE 00000169 "    my %conflicts = $package->conflicts;"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    my @ret;"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "    CONFLICT:"
NSQ_SOURCE_LINE 00000175 "    for my $conflict (keys %conflicts) {"
NSQ_SOURCE_LINE 00000176 "        my $success = do {"
NSQ_SOURCE_LINE 00000177 "            local $SIG{__WARN__} = sub {};"
NSQ_SOURCE_LINE 00000178 "            eval { require_module($conflict) };"
NSQ_SOURCE_LINE 00000179 "        };"
NSQ_SOURCE_LINE 00000180 "        my $error = $@;"
NSQ_SOURCE_LINE 00000181 "        my $file = module_notional_filename($conflict);"
NSQ_SOURCE_LINE 00000182 "        next if not $success and $error =~ /Can't locate \\Q$file\\E in \\@INC/;"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "        warn \"Warning: $conflict did not compile\" if not $success;"
NSQ_SOURCE_LINE 00000185 "        my $installed = $success ? $conflict->VERSION : 'unknown';"
NSQ_SOURCE_LINE 00000186 "        push @ret, {"
NSQ_SOURCE_LINE 00000187 "            package   => $conflict,"
NSQ_SOURCE_LINE 00000188 "            installed => $installed,"
NSQ_SOURCE_LINE 00000189 "            required  => $conflicts{$conflict},"
NSQ_SOURCE_LINE 00000190 "        } if not $success or $installed le $conflicts{$conflict};"
NSQ_SOURCE_LINE 00000191 "    }"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    return sort { $a->{package} cmp $b->{package} } @ret;"
NSQ_SOURCE_LINE 00000194 "}"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "1;"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "__END__"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=pod"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=head1 NAME"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "Dist::CheckConflicts - declare version conflicts for your dist"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head1 VERSION"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "version 0.11"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "    use Dist::CheckConflicts"
NSQ_SOURCE_LINE 00000216 "        -dist => 'Class-MOP',"
NSQ_SOURCE_LINE 00000217 "        -conflicts => {"
NSQ_SOURCE_LINE 00000218 "            'Moose'                => '1.14',"
NSQ_SOURCE_LINE 00000219 "            'namespace::autoclean' => '0.08',"
NSQ_SOURCE_LINE 00000220 "        },"
NSQ_SOURCE_LINE 00000221 "        -also => ["
NSQ_SOURCE_LINE 00000222 "            'Package::Stash::Conflicts',"
NSQ_SOURCE_LINE 00000223 "        ];"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "    __PACKAGE__->check_conflicts;"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "One shortcoming of the CPAN clients that currently exist is that they have no"
NSQ_SOURCE_LINE 00000230 "way of specifying conflicting downstream dependencies of modules. This module"
NSQ_SOURCE_LINE 00000231 "attempts to work around this issue by allowing you to specify conflicting"
NSQ_SOURCE_LINE 00000232 "versions of modules separately, and deal with them after the module is done"
NSQ_SOURCE_LINE 00000233 "installing."
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "For instance, say you have a module C<Foo>, and some other module C<Bar> uses"
NSQ_SOURCE_LINE 00000236 "C<Foo>. If C<Foo> were to change its API in a non-backwards-compatible way,"
NSQ_SOURCE_LINE 00000237 "this would cause C<Bar> to break until it is updated to use the new API. C<Foo>"
NSQ_SOURCE_LINE 00000238 "can't just depend on the fixed version of C<Bar>, because this will cause a"
NSQ_SOURCE_LINE 00000239 "circular dependency (because C<Bar> is already depending on C<Foo>), and this"
NSQ_SOURCE_LINE 00000240 "doesn't express intent properly anyway - C<Foo> doesn't use C<Bar> at all. The"
NSQ_SOURCE_LINE 00000241 "ideal solution would be for there to be a way to specify conflicting versions"
NSQ_SOURCE_LINE 00000242 "of modules in a way that would let CPAN clients update conflicting modules"
NSQ_SOURCE_LINE 00000243 "automatically after an existing module is upgraded, but until that happens,"
NSQ_SOURCE_LINE 00000244 "this module will allow users to do this manually."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "This module accepts a hash of options passed to its C<use> statement, with"
NSQ_SOURCE_LINE 00000247 "these keys being valid:"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=over 4"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=item -conflicts"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "A hashref of conflict specifications, where keys are module names, and values"
NSQ_SOURCE_LINE 00000254 "are the last broken version - any version greater than the specified version"
NSQ_SOURCE_LINE 00000255 "should work."
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=item -also"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "Additional modules to get conflicts from (potentially recursively). This should"
NSQ_SOURCE_LINE 00000260 "generally be a list of modules which use Dist::CheckConflicts, which correspond"
NSQ_SOURCE_LINE 00000261 "to the dists that your dist depends on. (In an ideal world, this would be"
NSQ_SOURCE_LINE 00000262 "intuited directly from your dependency list, but the dependency list isn't"
NSQ_SOURCE_LINE 00000263 "available outside of build time)."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=item -dist"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "The name of the distribution, to make the error message from check_conflicts"
NSQ_SOURCE_LINE 00000268 "more user-friendly."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "=back"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "The methods listed below are exported by this module into the module that uses"
NSQ_SOURCE_LINE 00000273 "it, so you should call these methods on your module, not Dist::CheckConflicts."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "As an example, this command line can be used to update your modules, after"
NSQ_SOURCE_LINE 00000276 "installing the C<Foo> dist (assuming that C<Foo::Conflicts> is the module in"
NSQ_SOURCE_LINE 00000277 "the C<Foo> dist which uses Dist::CheckConflicts):"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "    perl -MFoo::Conflicts -e'print \"$_\\n\""
NSQ_SOURCE_LINE 00000280 "        for map { $_->{package} } Foo::Conflicts->calculate_conflicts' | cpanm"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "As an added bonus, loading your conflicts module will provide warnings at"
NSQ_SOURCE_LINE 00000283 "runtime if conflicting modules are detected (regardless of whether they are"
NSQ_SOURCE_LINE 00000284 "loaded before or afterwards)."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=head1 METHODS"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=head2 conflicts"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "Returns the conflict specification (the C<-conflicts> parameter to"
NSQ_SOURCE_LINE 00000291 "C<import()>), as a hash."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=head2 dist"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "Returns the dist name (either as specified by the C<-dist> parameter to"
NSQ_SOURCE_LINE 00000296 "C<import()>, or the package name which C<use>d this module)."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "=head2 check_conflicts"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "Examine the modules that are currently installed, and throw an exception with"
NSQ_SOURCE_LINE 00000301 "useful information if any modules are at versions which conflict with the dist."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=head2 calculate_conflicts"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "Examine the modules that are currently installed, and return a list of modules"
NSQ_SOURCE_LINE 00000306 "which conflict with the dist. The modules will be returned as a list of"
NSQ_SOURCE_LINE 00000307 "hashrefs, each containing C<package>, C<installed>, and C<required> keys."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head1 BUGS"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "No known bugs."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "Please report any bugs to GitHub Issues at"
NSQ_SOURCE_LINE 00000314 "L<https://github.com/doy/dist-checkconflicts/issues>."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "L<Module::Install::CheckConflicts>"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "L<Dist::Zilla::Plugin::Conflicts>"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "You can find this documentation for this module with the perldoc command."
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "    perldoc Dist::CheckConflicts"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "You can also look for information at:"
