NSQ_SOURCE_LINE 00000001 "package File::Util::Tempdir;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2018-09-22'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.034'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000010 "our @EXPORT_OK = qw(get_tempdir get_user_tempdir);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "sub get_tempdir {"
NSQ_SOURCE_LINE 00000013 "    if ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000014 "        for (qw/TMP TEMP TMPDIR TEMPDIR/) {"
NSQ_SOURCE_LINE 00000015 "            return $ENV{$_} if defined $ENV{$_};"
NSQ_SOURCE_LINE 00000016 "        }"
NSQ_SOURCE_LINE 00000017 "        for (\"C:\\\\TMP\", \"C:\\\\TEMP\") {"
NSQ_SOURCE_LINE 00000018 "            return $_ if -d;"
NSQ_SOURCE_LINE 00000019 "        }"
NSQ_SOURCE_LINE 00000020 "    } else {"
NSQ_SOURCE_LINE 00000021 "        for (qw/TMPDIR TEMPDIR TMP TEMP/) {"
NSQ_SOURCE_LINE 00000022 "            return $ENV{$_} if defined $ENV{$_};"
NSQ_SOURCE_LINE 00000023 "        }"
NSQ_SOURCE_LINE 00000024 "        for (\"/tmp\", \"/var/tmp\") {"
NSQ_SOURCE_LINE 00000025 "            return $_ if -d;"
NSQ_SOURCE_LINE 00000026 "        }"
NSQ_SOURCE_LINE 00000027 "    }"
NSQ_SOURCE_LINE 00000028 "    die \"Can't find any temporary directory\";"
NSQ_SOURCE_LINE 00000029 "}"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub get_user_tempdir {"
NSQ_SOURCE_LINE 00000032 "    if ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000033 "        return get_tempdir();"
NSQ_SOURCE_LINE 00000034 "    } else {"
NSQ_SOURCE_LINE 00000035 "        my $dir = $ENV{XDG_RUNTIME_DIR} ?"
NSQ_SOURCE_LINE 00000036 "            $ENV{XDG_RUNTIME_DIR} : get_tempdir();"
NSQ_SOURCE_LINE 00000037 "        my @st = stat($dir);"
NSQ_SOURCE_LINE 00000038 "        die \"Can't stat tempdir '$dir': $!\" unless @st;"
NSQ_SOURCE_LINE 00000039 "        return $dir if $st[4] == $> && !($st[2] & 022);"
NSQ_SOURCE_LINE 00000040 "        my $i = 0;"
NSQ_SOURCE_LINE 00000041 "        while (1) {"
NSQ_SOURCE_LINE 00000042 "            my $subdir = \"$dir/$>\" . ($i ? \".$i\" : \"\");"
NSQ_SOURCE_LINE 00000043 "            my @stsub = stat($subdir);"
NSQ_SOURCE_LINE 00000044 "            my $is_dir = -d _;"
NSQ_SOURCE_LINE 00000045 "            if (!@stsub) {"
NSQ_SOURCE_LINE 00000046 "                mkdir $subdir, 0700 or die \"Can't mkdir '$subdir': $!\";"
NSQ_SOURCE_LINE 00000047 "                return $subdir;"
NSQ_SOURCE_LINE 00000048 "            } elsif ($is_dir && $stsub[4] == $> && !($stsub[2] & 022)) {"
NSQ_SOURCE_LINE 00000049 "                return $subdir;"
NSQ_SOURCE_LINE 00000050 "            } else {"
NSQ_SOURCE_LINE 00000051 "                $i++;"
NSQ_SOURCE_LINE 00000052 "            }"
NSQ_SOURCE_LINE 00000053 "        }"
NSQ_SOURCE_LINE 00000054 "    }"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "1;"
NSQ_SOURCE_LINE 00000058 "# ABSTRACT: Cross-platform way to get system-wide & user private temporary directory"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "__END__"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=pod"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=head1 NAME"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "File::Util::Tempdir - Cross-platform way to get system-wide & user private temporary directory"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=head1 VERSION"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "This document describes version 0.034 of File::Util::Tempdir (from Perl distribution File-Util-Tempdir), released on 2018-09-22."
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 " use File::Util::Tempdir qw(get_tempdir get_user_tempdir);"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 " my $tmpdir = get_tempdir(); # => e.g. \"/tmp\""
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 " my $mytmpdir = get_user_tempdir(); # => e.g. \"/run/user/1000\", or \"/tmp/1000\""
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "None are exported by default, but they are exportable."
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=head2 get_tempdir"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "Usage:"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 " my $dir = get_tempdir();"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "A cross-platform way to get system-wide temporary directory."
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "On Windows: it first looks for one of these environment variables in this order"
NSQ_SOURCE_LINE 00000097 "and return the first value that is set: C<TMP>, C<TEMP>, C<TMPDIR>, C<TEMPDIR>."
NSQ_SOURCE_LINE 00000098 "If none are set, will look at these directories in this order and return the"
NSQ_SOURCE_LINE 00000099 "first value that is set: C<C:\\TMP>, C<C:\\TEMP>. If none are set, will die."
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "On Unix: it first looks for one of these environment variables in this order and"
NSQ_SOURCE_LINE 00000102 "return the first value that is set: C<TMPDIR>, C<TEMPDIR>, C<TMP>, C<TEMP>. If"
NSQ_SOURCE_LINE 00000103 "none are set, will look at these directories in this order and return the first"
NSQ_SOURCE_LINE 00000104 "value that is set: C</tmp>, C</var/tmp>. If none are set, will die."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head2 get_user_tempdir"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "Usage:"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 " my $dir = get_user_tempdir();"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "Get user's private temporary directory."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "When you use world-writable temporary directory like F</tmp>, you usually need"
NSQ_SOURCE_LINE 00000115 "to create randomly named temporary files, such as those created by"
NSQ_SOURCE_LINE 00000116 "L<File::Temp>. If you try to create a temporary file with guessable name, other"
NSQ_SOURCE_LINE 00000117 "users can intercept this and you can either: 1) fail to create/write your"
NSQ_SOURCE_LINE 00000118 "temporary file; 2) be tricked to read malicious data; 3) be tricked to write to"
NSQ_SOURCE_LINE 00000119 "other location (e.g. via symlink)."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "This routine is like L</\"get_tempdir\"> except: on Unix, it will look for"
NSQ_SOURCE_LINE 00000122 "C<XDG_RUNTIME_DIR> first (which on a Linux system with systemd will have value"
NSQ_SOURCE_LINE 00000123 "like C</run/user/1000> which points to a RAM-based tmpfs). Also,"
NSQ_SOURCE_LINE 00000124 "C<get_user_tempdir> will first check that the temporary directory is: 1) owned"
NSQ_SOURCE_LINE 00000125 "by the running user; 2) not group- and world-writable. If not, it will create a"
NSQ_SOURCE_LINE 00000126 "subdirectory named C<$EUID> (C<< $> >>) with permission mode 0700 and return"
NSQ_SOURCE_LINE 00000127 "that. If that subdirectory already exists and is not owned by the user or is"
NSQ_SOURCE_LINE 00000128 "group-/world-writable, will try C<$EUID.1> and so on."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "It will die on failure."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Please visit the project's homepage at L<https://metacpan.org/release/File-Util-Tempdir>."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "Source repository is at L<https://github.com/perlancar/perl-File-Util-Tempdir>."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=head1 BUGS"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=File-Util-Tempdir>"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000145 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000146 "feature."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "L<File::Spec> has C<tmpdir> function. It also tries to look at environment"
NSQ_SOURCE_LINE 00000151 "variables, e.g. on Unix it will look at C<TMPDIR> (but not C<TEMPDIR>) and"
NSQ_SOURCE_LINE 00000152 "then falls back to C</tmp> (but not C</var/tmp>)."
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "L<File::HomeDir>, a cross-platform way to get user's home directory and a few"
NSQ_SOURCE_LINE 00000155 "other related directories."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "L<File::Temp> to create a temporary directory."
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "L<https://specifications.freedesktop.org/basedir-spec/basedir-spec-latest.html>"
NSQ_SOURCE_LINE 00000160 "for the specification of C<XDG_RUNTIME_DIR>."
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "perlancar <perlancar@cpan.org>"
