NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 "package Test::RequiresInternet;"
NSQ_SOURCE_LINE 00000004 "$Test::RequiresInternet::VERSION = '0.05';"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: Easily test network connectivity"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Socket;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "sub import {"
NSQ_SOURCE_LINE 00000011 "    skip_all(\"NO_NETWORK_TESTING\") if env(\"NO_NETWORK_TESTING\");"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "    my $namespace = shift;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "    my $argc = scalar @_;"
NSQ_SOURCE_LINE 00000016 "    if ( $argc == 0 ) {"
NSQ_SOURCE_LINE 00000017 "        push @_, 'www.google.com', 80;"
NSQ_SOURCE_LINE 00000018 "    }"
NSQ_SOURCE_LINE 00000019 "    elsif ( $argc % 2 != 0 ) {"
NSQ_SOURCE_LINE 00000020 "        die \"Must supply server and a port pairs. You supplied \" . (join \", \", @_) . \"\\n\";"
NSQ_SOURCE_LINE 00000021 "    }"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    while ( @_ ) {"
NSQ_SOURCE_LINE 00000024 "        my $host = shift;"
NSQ_SOURCE_LINE 00000025 "        my $port = shift;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "        local $@;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "        eval {make_socket($host, $port)};"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "        if ( $@ ) {"
NSQ_SOURCE_LINE 00000032 "            skip_all(\"$@\");"
NSQ_SOURCE_LINE 00000033 "        }"
NSQ_SOURCE_LINE 00000034 "    }"
NSQ_SOURCE_LINE 00000035 "}"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub make_socket {"
NSQ_SOURCE_LINE 00000038 "    my ($host, $port) = @_;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    my $portnum;"
NSQ_SOURCE_LINE 00000041 "    if ($port =~ /\\D/) { "
NSQ_SOURCE_LINE 00000042 "        $portnum = getservbyname($port, \"tcp\");"
NSQ_SOURCE_LINE 00000043 "    }"
NSQ_SOURCE_LINE 00000044 "    else {"
NSQ_SOURCE_LINE 00000045 "        $portnum = $port;"
NSQ_SOURCE_LINE 00000046 "    }"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "    die \"Could not find a port number for $port\\n\" if not $portnum;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    my $iaddr = inet_aton($host) or die \"no host: $host\\n\";"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    my $paddr = sockaddr_in($portnum, $iaddr);"
NSQ_SOURCE_LINE 00000053 "    my $proto = getprotobyname(\"tcp\");"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    socket(my $sock, PF_INET, SOCK_STREAM, $proto) or die \"socket: $!\\n\";"
NSQ_SOURCE_LINE 00000056 "    connect($sock, $paddr) or die \"connect: $!\\n\";"
NSQ_SOURCE_LINE 00000057 "    close ($sock) or die \"close: $!\\n\";"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    1;"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "sub env {"
NSQ_SOURCE_LINE 00000063 "    exists $ENV{$_[0]} && $ENV{$_[0]} eq '1'"
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "sub skip_all {"
NSQ_SOURCE_LINE 00000067 "    my $reason = shift;"
NSQ_SOURCE_LINE 00000068 "    print \"1..0 # Skipped: $reason\";"
NSQ_SOURCE_LINE 00000069 "    exit 0;"
NSQ_SOURCE_LINE 00000070 "}"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "1;"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "__END__"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=pod"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head1 NAME"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Test::RequiresInternet - Easily test network connectivity"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head1 VERSION"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "version 0.05"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "  use Test::More;"
NSQ_SOURCE_LINE 00000091 "  use Test::RequiresInternet ('www.example.com' => 80, 'foobar.io' => 25);"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "  # if you reach here, sockets successfully connected to hosts/ports above"
NSQ_SOURCE_LINE 00000094 "  plan tests => 1;"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "  ok(do_that_internet_thing());"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "=head1 OVERVIEW"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "This module is intended to easily test network connectivity before functional "
NSQ_SOURCE_LINE 00000101 "tests begin to non-local Internet resources.  It does not require any modules"
NSQ_SOURCE_LINE 00000102 "beyond those supplied in core Perl."
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "If you do not specify a host/port pair, then the module defaults to using"
NSQ_SOURCE_LINE 00000105 "C<www.google.com> on port C<80>.  "
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "You may optionally specify the port by its name, as in C<http> or C<ldap>."
NSQ_SOURCE_LINE 00000108 "If you do this, the test module will attempt to look up the port number"
NSQ_SOURCE_LINE 00000109 "using C<getservbyname>."
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "If you do specify a host and port, they must be specified in B<pairs>. It is a"
NSQ_SOURCE_LINE 00000112 "fatal error to omit one or the other."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "If the environment variable C<NO_NETWORK_TESTING> is set, then the tests"
NSQ_SOURCE_LINE 00000115 "will be skipped without attempting any socket connections."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "If the sockets cannot connect to the specified hosts and ports, the exception"
NSQ_SOURCE_LINE 00000118 "is caught, reported and the tests skipped."
NSQ_SOURCE_LINE 00000119 ""
