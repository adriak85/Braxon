BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Spreadsheet::GenerateXLSX;"
NSQ_SOURCE_LINE 00000002 "$Spreadsheet::GenerateXLSX::VERSION = '0.05';"
NSQ_SOURCE_LINE 00000003 "use 5.008;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use parent 'Exporter';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Carp                qw/ croak /;"
NSQ_SOURCE_LINE 00000010 "use Ref::Util           qw/ is_arrayref is_ref /;"
NSQ_SOURCE_LINE 00000011 "use Excel::Writer::XLSX;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw/ generate_xlsx /;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "my $MAX_EXCEL_COLUMN_WIDTH = 80;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "my $define_formats = sub {"
NSQ_SOURCE_LINE 00000019 "    my $workbook = shift;"
NSQ_SOURCE_LINE 00000020 "    my $formats  = {};"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    my @common_settings = ("
NSQ_SOURCE_LINE 00000023 "             size => 12,"
NSQ_SOURCE_LINE 00000024 "        text_wrap => 1,"
NSQ_SOURCE_LINE 00000025 "            align => 'left',"
NSQ_SOURCE_LINE 00000026 "    );"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    $formats->{header} = $workbook->add_format(@common_settings,"
NSQ_SOURCE_LINE 00000029 "                              bold => 1,"
NSQ_SOURCE_LINE 00000030 "                             color => 'black',"
NSQ_SOURCE_LINE 00000031 "                         );"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    $formats->{cell}   = $workbook->add_format(@common_settings,"
NSQ_SOURCE_LINE 00000034 "                              bold => 0,"
NSQ_SOURCE_LINE 00000035 "                             color => 'gray',"
NSQ_SOURCE_LINE 00000036 "                         );"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    return $formats;"
NSQ_SOURCE_LINE 00000039 "};"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "my $find_sheet_dimensions = sub {"
NSQ_SOURCE_LINE 00000042 "    my $data          = shift;"
NSQ_SOURCE_LINE 00000043 "    my $nrows         = int(@$data);"
NSQ_SOURCE_LINE 00000044 "    my $n_header_cols = int(@{ $data->[0] });"
NSQ_SOURCE_LINE 00000045 "    my $ncols         = $n_header_cols;"
NSQ_SOURCE_LINE 00000046 "    my $s             = $n_header_cols == 1 ? '' : 's';"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "    foreach my $row (@$data) {"
NSQ_SOURCE_LINE 00000049 "        $ncols = int(@$row) if int(@$row) > $ncols;"
NSQ_SOURCE_LINE 00000050 "    }"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    # If there are data rows with more columns than there are"
NSQ_SOURCE_LINE 00000053 "    # header columns, then we let the caller know, because the"
NSQ_SOURCE_LINE 00000054 "    # auto filters will look a bit goofy"
NSQ_SOURCE_LINE 00000055 "    if ($ncols > $n_header_cols) {"
NSQ_SOURCE_LINE 00000056 "        # TODO: this should be a carp, but need to skip a call frame"
NSQ_SOURCE_LINE 00000057 "        warn \"generate_xlsx(): you gave me $n_header_cols header column$s, \","
NSQ_SOURCE_LINE 00000058 "             \"but at least one row has $ncols columns.\\n\";"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    return ($nrows, $ncols);"
NSQ_SOURCE_LINE 00000062 "};"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "my $set_column_widths = sub {"
NSQ_SOURCE_LINE 00000065 "    my ($sheet, $widths_ref) = @_;"
NSQ_SOURCE_LINE 00000066 "    my $col_num = 0;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    foreach my $width (@$widths_ref) {"
NSQ_SOURCE_LINE 00000069 "        # This is a heuristic (ok, nasty hack) for approximating the column"
NSQ_SOURCE_LINE 00000070 "        # width in whatever these excel units are, based on the number of chars."
NSQ_SOURCE_LINE 00000071 "        # It works well enough most of the time."
NSQ_SOURCE_LINE 00000072 "        my $column_width = 11 + 1.1 * ($width > 9 ? ($width - 9) : 1);"
NSQ_SOURCE_LINE 00000073 "        if ($column_width > $MAX_EXCEL_COLUMN_WIDTH) {"
NSQ_SOURCE_LINE 00000074 "            $column_width = $MAX_EXCEL_COLUMN_WIDTH;"
NSQ_SOURCE_LINE 00000075 "        }"
NSQ_SOURCE_LINE 00000076 "        $sheet->set_column($col_num, $col_num, $column_width);"
NSQ_SOURCE_LINE 00000077 "        $col_num++;"
NSQ_SOURCE_LINE 00000078 "    }"
NSQ_SOURCE_LINE 00000079 "};"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "my $generate_sheet = sub {"
NSQ_SOURCE_LINE 00000082 "    my ($book, $formats, $sheetname, $data) = @_;"
NSQ_SOURCE_LINE 00000083 "    my ($nrows, $ncols) = $find_sheet_dimensions->($data);"
NSQ_SOURCE_LINE 00000084 "    my $sheet           = $book->add_worksheet($sheetname);"
NSQ_SOURCE_LINE 00000085 "    my $row_num         = 0;"
NSQ_SOURCE_LINE 00000086 "    my @widths;"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "    foreach my $row (@$data) {"
NSQ_SOURCE_LINE 00000089 "        my $celltype = ($row_num == 0 ? 'header' : 'cell');"
NSQ_SOURCE_LINE 00000090 "        my $col_num  = 0;"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "        foreach my $cell (@$row) {"
NSQ_SOURCE_LINE 00000093 "            $sheet->write($row_num, $col_num, $cell, $formats->{$celltype});"
NSQ_SOURCE_LINE 00000094 "            if (!defined($widths[$col_num]) || (defined($cell) && length($cell) > $widths[$col_num])) {"
NSQ_SOURCE_LINE 00000095 "                $widths[$col_num] = length($cell);"
NSQ_SOURCE_LINE 00000096 "            }"
NSQ_SOURCE_LINE 00000097 "            $col_num++;"
NSQ_SOURCE_LINE 00000098 "        }"
NSQ_SOURCE_LINE 00000099 "        $row_num++;"
NSQ_SOURCE_LINE 00000100 "    }"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "    $set_column_widths->($sheet, \\@widths);"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    $sheet->autofilter(0, 0, $nrows-1, $ncols-1);"
NSQ_SOURCE_LINE 00000105 "    $sheet->freeze_panes(1, 0);"
NSQ_SOURCE_LINE 00000106 "};"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "sub generate_xlsx"
NSQ_SOURCE_LINE 00000109 "{"
NSQ_SOURCE_LINE 00000110 "    my $filename     = shift;"
NSQ_SOURCE_LINE 00000111 "    my $sheet_number = 1;"
NSQ_SOURCE_LINE 00000112 "    my $book         = Excel::Writer::XLSX->new( $filename )"
NSQ_SOURCE_LINE 00000113 "                       || croak \"failed to create workbook\\n\";"
NSQ_SOURCE_LINE 00000114 "    my $formats      = $define_formats->($book);"
NSQ_SOURCE_LINE 00000115 "    my $sheet_name;"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "    # Note: if you set this then you have to write rows in order."
NSQ_SOURCE_LINE 00000118 "    #       any out-of-order writes are effectively ignored."
NSQ_SOURCE_LINE 00000119 "    #       see the doc for Excel::Writer::XLSX"
NSQ_SOURCE_LINE 00000120 "    $book->set_optimization;"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    while (@_ > 0) {"
NSQ_SOURCE_LINE 00000123 "        my $data = shift @_;"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "        if (is_arrayref($data)) {"
NSQ_SOURCE_LINE 00000126 "            $sheet_name = \"Sheet$sheet_number\";"
NSQ_SOURCE_LINE 00000127 "        }"
NSQ_SOURCE_LINE 00000128 "        elsif (!is_ref($data) && @_ > 0) {"
NSQ_SOURCE_LINE 00000129 "            $sheet_name = $data;"
NSQ_SOURCE_LINE 00000130 "            $data       = shift @_;"
NSQ_SOURCE_LINE 00000131 "        }"
NSQ_SOURCE_LINE 00000132 "        else {"
NSQ_SOURCE_LINE 00000133 "            croak \"unexpected arguments -- see the documentation\\n\";"
NSQ_SOURCE_LINE 00000134 "        }"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "        $generate_sheet->($book, $formats, $sheet_name, $data);"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "        $sheet_number++;"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "    }"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "    $book->close;"
NSQ_SOURCE_LINE 00000143 "}"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "1;"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=head1 NAME"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "Spreadsheet::GenerateXLSX - function to generate XLSX spreadsheet from array ref(s)"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 " use Spreadsheet::GenerateXLSX qw/ generate_xlsx /;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 " my @data = ("
NSQ_SOURCE_LINE 00000156 "             ['Heading 1', 'Heading 2', 'Heading 2'],"
NSQ_SOURCE_LINE 00000157 "             ['blah',      'blah',      'blah'],"
NSQ_SOURCE_LINE 00000158 "             ['blah',      'blah',      'blah'],"
NSQ_SOURCE_LINE 00000159 "            );"
NSQ_SOURCE_LINE 00000160 " generate_xlsx('example.xlsx', \\@data);"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "This module provides a function C<generate_xlsx> which takes"
NSQ_SOURCE_LINE 00000165 "an array of Perl data and generates a simple Excel spreadsheet"
NSQ_SOURCE_LINE 00000166 "in the XLSX format."
NSQ_SOURCE_LINE 00000167 "The generated sheets have the first row frozen,"
NSQ_SOURCE_LINE 00000168 "and auto filters enabled for every column."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "Each sheet in the spreadsheet is generated from an array of rows,"
NSQ_SOURCE_LINE 00000171 "where each row is an arrayref."
NSQ_SOURCE_LINE 00000172 "The first row is treated as a header row."
NSQ_SOURCE_LINE 00000173 "Here's an example:"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 " my @sheet1 = ("
NSQ_SOURCE_LINE 00000176 "    ['Pokemon',  'Type',      'Number'],"
NSQ_SOURCE_LINE 00000177 "    ['Pikachu',  'Electric',  25],"
NSQ_SOURCE_LINE 00000178 "    ['Vulpix',   'Fire',      37],"
NSQ_SOURCE_LINE 00000179 "    ['Ditto',    'Normal',    132],"
NSQ_SOURCE_LINE 00000180 " );"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "The generated spreadsheet can have any numbers of sheets:"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 " generate_xslx('pokemon.xlsx', \\@sheet1, \\@sheet2);"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "If you just pass arrayrefs, the sheets will be named B<Sheet1>, B<Sheet2>, etc."
NSQ_SOURCE_LINE 00000187 "You can also pass the name of the sheet:"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 " generate_xslx('pokemon.xlsx', 'All Pokemon' => \\@sheet1, 'Hit List' => \\@sheet2);"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "The following modules can all generate the XLSX format."
NSQ_SOURCE_LINE 00000195 "I also wrote a L<blog post|http://neilb.org/2016/12/10/spreadsheet-generate-xlsx.html>"
NSQ_SOURCE_LINE 00000196 "which gives more details on some of these."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "=over 4"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "L<Excel::Writer::XLSX> - the underlying module used to generate the spreadsheet."
NSQ_SOURCE_LINE 00000201 "Gives you full control over the spreadsheet generated, but as a result has a much"
NSQ_SOURCE_LINE 00000202 "more complex interface."
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "L<Spreadsheet::WriteExcel::Styler> - helps with formatting of cells when"
NSQ_SOURCE_LINE 00000205 "using C<Excel::Writer::XLSX> or C<Spreadsheet::WriteExcel>."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "L<Spreadsheet::Template> - used to generate spreadsheets from"
NSQ_SOURCE_LINE 00000208 "\"JSON files which describe the desired content and formatting\"."
NSQ_SOURCE_LINE 00000209 "By default it generates XLSX format."
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "L<Data::Table::Excel> - converts between L<Data::Table> objects and XLS or XLSX format spreadsheets."
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "L<XLS::Simple> - provides a simple interface for both reading and writing spreadsheets."
NSQ_SOURCE_LINE 00000214 "Minimal documentation, and what there is is written in Japanese."
NSQ_SOURCE_LINE 00000215 "The function for creating a spreadsheet is called `write_xls()`,"
NSQ_SOURCE_LINE 00000216 "but it generates the XLSX format."
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "=back"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "The following modules only generate Microsoft's earlier xls binary format."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=over 4"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "L<Spreadsheet::WriteExcel> - provides the same interface as C<Excel::Writer::XLSX>,"
NSQ_SOURCE_LINE 00000225 "but generates the XLS format."
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "L<Spreadsheet::WriteExcel::FromDB> - converts a database table to an XLS format spreadsheet."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "L<Spreadsheet::WriteExcel::FromDB::Query> - converts a query to an XLS spreadsheet,"
NSQ_SOURCE_LINE 00000230 "as opposed to a table."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "L<Spreadsheet::WriteExcel::Simple> - provides a simpler OO interface"
NSQ_SOURCE_LINE 00000233 "for generating single-sheet XLS spreadsheets."
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "L<Spreadsheet::Write> - another simplified OO interface, which can write CSV or XLS output,"
NSQ_SOURCE_LINE 00000236 "but not XLSX."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "L<Spreadsheet::Wright> - a fork of C<Spreadsheet::Write> which supports more output formats"
NSQ_SOURCE_LINE 00000239 "(CSV, XLS, HTML, XHTML, XML, ODS, and JSON), but doesn't (appear to) support XLSX."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "L<Spreadsheet::DataToExcel> - provides a simple OO interface for generating XLS spreadsheets,"
NSQ_SOURCE_LINE 00000242 "and provides some control over the generated format."
NSQ_SOURCE_LINE 00000243 "But, as with most of the modules listed here, only XLS output is supported."
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "L<Spreadsheet::WriteExcel::Simple::Tabs> - a very simple OO interface built on C<Spreadsheet::WriteExcel>."
NSQ_SOURCE_LINE 00000246 "This one is close to the spirit of C<Spreadsheet::GenerateXLSX>, but only generates XLS."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=back"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=head1 TODO"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 " * smarter auto-formatting of columns"
NSQ_SOURCE_LINE 00000253 " * more tests"
NSQ_SOURCE_LINE 00000254 " * better error handler"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=head1 REPOSITORY"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "L<https://github.com/neilb/Spreadsheet-GenerateXLSX>"
