NSQ_SOURCE_LINE 00000001 "package YAML;"
NSQ_SOURCE_LINE 00000002 "our $VERSION = '1.31';"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "use YAML::Mo;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Exporter;"
NSQ_SOURCE_LINE 00000007 "push @YAML::ISA, 'Exporter';"
NSQ_SOURCE_LINE 00000008 "our @EXPORT = qw{ Dump Load };"
NSQ_SOURCE_LINE 00000009 "our @EXPORT_OK = qw{ freeze thaw DumpFile LoadFile Bless Blessed };"
NSQ_SOURCE_LINE 00000010 "our ("
NSQ_SOURCE_LINE 00000011 "    $UseCode, $DumpCode, $LoadCode,"
NSQ_SOURCE_LINE 00000012 "    $SpecVersion,"
NSQ_SOURCE_LINE 00000013 "    $UseHeader, $UseVersion, $UseBlock, $UseFold, $UseAliases,"
NSQ_SOURCE_LINE 00000014 "    $Indent, $SortKeys, $Preserve,"
NSQ_SOURCE_LINE 00000015 "    $AnchorPrefix, $CompressSeries, $InlineSeries, $Purity,"
NSQ_SOURCE_LINE 00000016 "    $Stringify, $Numify, $LoadBlessed, $QuoteNumericStrings,"
NSQ_SOURCE_LINE 00000017 "    $DumperClass, $LoaderClass"
NSQ_SOURCE_LINE 00000018 ");"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "use YAML::Node; # XXX This is a temp fix for Module::Build"
NSQ_SOURCE_LINE 00000021 "use Scalar::Util qw/ openhandle /;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "# XXX This VALUE nonsense needs to go."
NSQ_SOURCE_LINE 00000024 "use constant VALUE => \"\\x07YAML\\x07VALUE\\x07\";"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "# YAML Object Properties"
NSQ_SOURCE_LINE 00000027 "has dumper_class => default => sub {'YAML::Dumper'};"
NSQ_SOURCE_LINE 00000028 "has loader_class => default => sub {'YAML::Loader'};"
NSQ_SOURCE_LINE 00000029 "has dumper_object => default => sub {$_[0]->init_action_object(\"dumper\")};"
NSQ_SOURCE_LINE 00000030 "has loader_object => default => sub {$_[0]->init_action_object(\"loader\")};"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub Dump {"
NSQ_SOURCE_LINE 00000033 "    my $yaml = YAML->new;"
NSQ_SOURCE_LINE 00000034 "    $yaml->dumper_class($YAML::DumperClass)"
NSQ_SOURCE_LINE 00000035 "        if $YAML::DumperClass;"
NSQ_SOURCE_LINE 00000036 "    return $yaml->dumper_object->dump(@_);"
NSQ_SOURCE_LINE 00000037 "}"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "sub Load {"
NSQ_SOURCE_LINE 00000040 "    my $yaml = YAML->new;"
NSQ_SOURCE_LINE 00000041 "    $yaml->loader_class($YAML::LoaderClass)"
NSQ_SOURCE_LINE 00000042 "        if $YAML::LoaderClass;"
NSQ_SOURCE_LINE 00000043 "    return $yaml->loader_object->load(@_);"
NSQ_SOURCE_LINE 00000044 "}"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "{"
NSQ_SOURCE_LINE 00000047 "    no warnings 'once';"
NSQ_SOURCE_LINE 00000048 "    # freeze/thaw is the API for Storable string serialization. Some"
NSQ_SOURCE_LINE 00000049 "    # modules make use of serializing packages on if they use freeze/thaw."
NSQ_SOURCE_LINE 00000050 "    *freeze = \\ &Dump;"
NSQ_SOURCE_LINE 00000051 "    *thaw   = \\ &Load;"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub DumpFile {"
NSQ_SOURCE_LINE 00000055 "    my $OUT;"
NSQ_SOURCE_LINE 00000056 "    my $filename = shift;"
NSQ_SOURCE_LINE 00000057 "    if (openhandle $filename) {"
NSQ_SOURCE_LINE 00000058 "        $OUT = $filename;"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 "    else {"
NSQ_SOURCE_LINE 00000061 "        my $mode = '>';"
NSQ_SOURCE_LINE 00000062 "        if ($filename =~ /^\\s*(>{1,2})\\s*(.*)$/) {"
NSQ_SOURCE_LINE 00000063 "            ($mode, $filename) = ($1, $2);"
NSQ_SOURCE_LINE 00000064 "        }"
NSQ_SOURCE_LINE 00000065 "        open $OUT, $mode, $filename"
NSQ_SOURCE_LINE 00000066 "          or YAML::Mo::Object->die('YAML_DUMP_ERR_FILE_OUTPUT', $filename, \"$!\");"
NSQ_SOURCE_LINE 00000067 "    }"
NSQ_SOURCE_LINE 00000068 "    binmode $OUT, ':utf8';  # if $Config{useperlio} eq 'define';"
NSQ_SOURCE_LINE 00000069 "    local $/ = \"\\n\"; # reset special to \"sane\""
NSQ_SOURCE_LINE 00000070 "    print $OUT Dump(@_);"
NSQ_SOURCE_LINE 00000071 "    unless (ref $filename eq 'GLOB') {"
NSQ_SOURCE_LINE 00000072 "        close $OUT"
NSQ_SOURCE_LINE 00000073 "          or do {"
NSQ_SOURCE_LINE 00000074 "              my $errsav = $!;"
NSQ_SOURCE_LINE 00000075 "              YAML::Mo::Object->die('YAML_DUMP_ERR_FILE_OUTPUT_CLOSE', $filename, $errsav);"
NSQ_SOURCE_LINE 00000076 "          }"
NSQ_SOURCE_LINE 00000077 "    }"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "sub LoadFile {"
NSQ_SOURCE_LINE 00000081 "    my $IN;"
NSQ_SOURCE_LINE 00000082 "    my $filename = shift;"
NSQ_SOURCE_LINE 00000083 "    if (openhandle $filename) {"
NSQ_SOURCE_LINE 00000084 "        $IN = $filename;"
NSQ_SOURCE_LINE 00000085 "    }"
NSQ_SOURCE_LINE 00000086 "    else {"
NSQ_SOURCE_LINE 00000087 "        open $IN, '<', $filename"
NSQ_SOURCE_LINE 00000088 "          or YAML::Mo::Object->die('YAML_LOAD_ERR_FILE_INPUT', $filename, \"$!\");"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 "    binmode $IN, ':utf8';  # if $Config{useperlio} eq 'define';"
NSQ_SOURCE_LINE 00000091 "    return Load(do { local $/; <$IN> });"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "sub init_action_object {"
NSQ_SOURCE_LINE 00000095 "    my $self = shift;"
NSQ_SOURCE_LINE 00000096 "    my $object_class = (shift) . '_class';"
NSQ_SOURCE_LINE 00000097 "    my $module_name = $self->$object_class;"
NSQ_SOURCE_LINE 00000098 "    eval \"require $module_name\";"
NSQ_SOURCE_LINE 00000099 "    $self->die(\"Error in require $module_name - $@\")"
NSQ_SOURCE_LINE 00000100 "        if $@ and \"$@\" !~ /Can't locate/;"
NSQ_SOURCE_LINE 00000101 "    my $object = $self->$object_class->new;"
NSQ_SOURCE_LINE 00000102 "    $object->set_global_options;"
NSQ_SOURCE_LINE 00000103 "    return $object;"
NSQ_SOURCE_LINE 00000104 "}"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "my $global = {};"
NSQ_SOURCE_LINE 00000107 "sub Bless {"
NSQ_SOURCE_LINE 00000108 "    require YAML::Dumper::Base;"
NSQ_SOURCE_LINE 00000109 "    YAML::Dumper::Base::bless($global, @_)"
NSQ_SOURCE_LINE 00000110 "}"
NSQ_SOURCE_LINE 00000111 "sub Blessed {"
NSQ_SOURCE_LINE 00000112 "    require YAML::Dumper::Base;"
NSQ_SOURCE_LINE 00000113 "    YAML::Dumper::Base::blessed($global, @_)"
NSQ_SOURCE_LINE 00000114 "}"
NSQ_SOURCE_LINE 00000115 "sub global_object { $global }"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "1;"
BODY_END
