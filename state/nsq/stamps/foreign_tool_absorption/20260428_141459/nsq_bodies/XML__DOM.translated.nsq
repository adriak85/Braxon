NSQ_SOURCE_LINE 00000678 "sub getChildNodes"
NSQ_SOURCE_LINE 00000679 "{"
NSQ_SOURCE_LINE 00000680 "    # NOTE: if node can't have children, $self->[_C] is undef."
NSQ_SOURCE_LINE 00000681 "    my $kids = $_[0]->[_C];"
NSQ_SOURCE_LINE 00000682 ""
