NSQ_SOURCE_LINE 00000712 "sub getPreviousSibling"
NSQ_SOURCE_LINE 00000713 "{"
NSQ_SOURCE_LINE 00000714 "    my $self = shift;"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "    my $pa = $self->[_Parent];"
NSQ_SOURCE_LINE 00000717 "    return undef unless $pa;"
NSQ_SOURCE_LINE 00000718 "    my $index = $pa->getChildIndex ($self);"
NSQ_SOURCE_LINE 00000719 "    return undef unless $index;"
