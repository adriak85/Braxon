NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "    my @nodes = ($node);"
NSQ_SOURCE_LINE 00000788 "    @nodes = @{$node->[_C]}"
NSQ_SOURCE_LINE 00000789 "\tif $node->getNodeType == DOCUMENT_FRAGMENT_NODE;"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "    for my $n (@nodes)"
NSQ_SOURCE_LINE 00000792 "    {"
NSQ_SOURCE_LINE 00000793 "\tcroak new XML::DOM::DOMException (WRONG_DOCUMENT_ERR,"
NSQ_SOURCE_LINE 00000794 "\t\t\t\t\t  \"nodes belong to different documents\")"
NSQ_SOURCE_LINE 00000795 "\t    if $self->[_Doc] != $n->[_Doc];"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "\tcroak new XML::DOM::DOMException (HIERARCHY_REQUEST_ERR,"
NSQ_SOURCE_LINE 00000798 "\t\t\t\t\t  \"node is ancestor of parent node\")"
