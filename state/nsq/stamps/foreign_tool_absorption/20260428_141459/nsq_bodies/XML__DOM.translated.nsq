NSQ_SOURCE_LINE 00001951 "package XML::DOM::AttDef;"
NSQ_SOURCE_LINE 00001952 "######################################################################"
NSQ_SOURCE_LINE 00001953 "use vars qw{ @ISA @EXPORT_OK %EXPORT_TAGS %HFIELDS };"
NSQ_SOURCE_LINE 00001954 ""
NSQ_SOURCE_LINE 00001955 "BEGIN"
NSQ_SOURCE_LINE 00001956 "{"
NSQ_SOURCE_LINE 00001957 "    import XML::DOM::Node qw( :DEFAULT :Fields );"
NSQ_SOURCE_LINE 00001958 "    XML::DOM::def_fields (\"Name Type Fixed Default Required Implied Quote\", \"XML::DOM::Node\");"
NSQ_SOURCE_LINE 00001959 "}"
NSQ_SOURCE_LINE 00001960 ""
NSQ_SOURCE_LINE 00001961 "use XML::DOM::DOMException;"
NSQ_SOURCE_LINE 00001962 "use Carp;"
NSQ_SOURCE_LINE 00001963 ""
NSQ_SOURCE_LINE 00001964 "#------------------------------------------------------------"
NSQ_SOURCE_LINE 00001965 "# Extra method implementations"
NSQ_SOURCE_LINE 00001966 ""
NSQ_SOURCE_LINE 00001967 "# AttDef is not part of DOM Spec"
NSQ_SOURCE_LINE 00001968 "sub new"
NSQ_SOURCE_LINE 00001969 "{"
NSQ_SOURCE_LINE 00001970 "    my ($class, $doc, $name, $attrType, $default, $fixed, $hidden) = @_;"
NSQ_SOURCE_LINE 00001971 ""
NSQ_SOURCE_LINE 00001972 "    croak new XML::DOM::DOMException (INVALID_CHARACTER_ERR,"
NSQ_SOURCE_LINE 00001973 "\t\t\t\t      \"bad Attr name in AttDef [$name]\")"
NSQ_SOURCE_LINE 00001974 "\tunless XML::DOM::isValidName ($name);"
NSQ_SOURCE_LINE 00001975 ""
NSQ_SOURCE_LINE 00001976 "    my $self = bless [], $class;"
NSQ_SOURCE_LINE 00001977 ""
NSQ_SOURCE_LINE 00001978 "    $self->[_Doc] = $doc;"
NSQ_SOURCE_LINE 00001979 "    $self->[_Name] = $name;"
NSQ_SOURCE_LINE 00001980 "    $self->[_Type] = $attrType;"
NSQ_SOURCE_LINE 00001981 ""
NSQ_SOURCE_LINE 00001982 "    if (defined $default)"
NSQ_SOURCE_LINE 00001983 "    {"
NSQ_SOURCE_LINE 00001984 "\tif ($default eq \"#REQUIRED\")"
NSQ_SOURCE_LINE 00001985 "\t{"
NSQ_SOURCE_LINE 00001986 "\t    $self->[_Required] = 1;"
NSQ_SOURCE_LINE 00001987 "\t}"
NSQ_SOURCE_LINE 00001988 "\telsif ($default eq \"#IMPLIED\")"
NSQ_SOURCE_LINE 00001989 "\t{"
NSQ_SOURCE_LINE 00001990 "\t    $self->[_Implied] = 1;"
NSQ_SOURCE_LINE 00001991 "\t}"
NSQ_SOURCE_LINE 00001992 "\telse"
NSQ_SOURCE_LINE 00001993 "\t{"
NSQ_SOURCE_LINE 00001994 "\t    # strip off quotes - see Attlist handler in XML::Parser"
NSQ_SOURCE_LINE 00001995 "            # this regexp doesn't work with 5.8.0 unicode"
NSQ_SOURCE_LINE 00001996 "#\t    $default =~ m#^([\"'])(.*)['\"]$#;"
NSQ_SOURCE_LINE 00001997 "#\t    $self->[_Quote] = $1;\t# keep track of the quote character"
NSQ_SOURCE_LINE 00001998 "#\t    $self->[_Default] = $self->setDefault ($2);"
NSQ_SOURCE_LINE 00001999 ""
NSQ_SOURCE_LINE 00002000 "          # workaround for 5.8.0 unicode"
NSQ_SOURCE_LINE 00002001 "          $default =~ s!^([\"'])!!;"
NSQ_SOURCE_LINE 00002002 "          $self->[_Quote] = $1;"
NSQ_SOURCE_LINE 00002003 "          $default =~ s!([\"'])$!!;"
NSQ_SOURCE_LINE 00002004 "          $self->[_Default] = $self->setDefault ($default);"
NSQ_SOURCE_LINE 00002005 "\t    \t    "
NSQ_SOURCE_LINE 00002006 "#?? should default value be decoded - what if it contains e.g. \"&amp;\""
NSQ_SOURCE_LINE 00002007 "\t}"
NSQ_SOURCE_LINE 00002008 "    }"
NSQ_SOURCE_LINE 00002009 "    $self->[_Fixed] = $fixed if defined $fixed;"
NSQ_SOURCE_LINE 00002010 "    $self->[_Hidden] = $hidden if defined $hidden;"
NSQ_SOURCE_LINE 00002011 ""
NSQ_SOURCE_LINE 00002012 "    $self;"
NSQ_SOURCE_LINE 00002013 "}"
NSQ_SOURCE_LINE 00002014 ""
