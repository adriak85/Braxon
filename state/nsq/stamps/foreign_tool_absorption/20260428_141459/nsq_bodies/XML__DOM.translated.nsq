NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "#"
NSQ_SOURCE_LINE 00001038 "# This function can return 3 values:"
NSQ_SOURCE_LINE 00001039 "# 1: always readOnly"
NSQ_SOURCE_LINE 00001040 "# 0: never readOnly"
NSQ_SOURCE_LINE 00001041 "# undef: depends on parent node "
NSQ_SOURCE_LINE 00001042 "#"
NSQ_SOURCE_LINE 00001043 "# Returns 1 for DocumentType, Notation, Entity, EntityReference, Attlist, "
NSQ_SOURCE_LINE 00001044 "# ElementDecl, AttDef. "
NSQ_SOURCE_LINE 00001045 "# The first 4 are readOnly according to the DOM Spec, the others are always "
NSQ_SOURCE_LINE 00001046 "# children of DocumentType. (Naturally, children of a readOnly node have to be"
NSQ_SOURCE_LINE 00001047 "# readOnly as well...)"
NSQ_SOURCE_LINE 00001048 "# These nodes are always readOnly regardless of who their ancestors are."
NSQ_SOURCE_LINE 00001049 "# Other nodes, e.g. Comment, are readOnly only if their parent is readOnly,"
NSQ_SOURCE_LINE 00001050 "# which basically means that one of its ancestors has to be one of the"
NSQ_SOURCE_LINE 00001051 "# aforementioned node types."
NSQ_SOURCE_LINE 00001052 "# Document and DocumentFragment return 0 for obvious reasons."
NSQ_SOURCE_LINE 00001053 "# Attr, Element, CDATASection, Text return 0. The DOM spec says that they can "
NSQ_SOURCE_LINE 00001054 "# be children of an Entity, but I don't think that that's possible"
NSQ_SOURCE_LINE 00001055 "# with the current XML::Parser."
NSQ_SOURCE_LINE 00001056 "# Attr uses a {ReadOnly} property, which is only set if it's part of a AttDef."
NSQ_SOURCE_LINE 00001057 "# Always returns 0 if ignoreReadOnly is set."
NSQ_SOURCE_LINE 00001058 "#"
NSQ_SOURCE_LINE 00001059 "sub isReadOnly"
NSQ_SOURCE_LINE 00001060 "{"
NSQ_SOURCE_LINE 00001061 "    # default implementation for Nodes that are always readOnly"
NSQ_SOURCE_LINE 00001062 "    ! $XML::DOM::IgnoreReadOnly;"
NSQ_SOURCE_LINE 00001063 "}"
