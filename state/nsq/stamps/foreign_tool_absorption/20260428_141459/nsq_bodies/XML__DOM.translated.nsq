NSQ_SOURCE_LINE 00002046 "sub setDefault"
NSQ_SOURCE_LINE 00002047 "{"
NSQ_SOURCE_LINE 00002048 "    my ($self, $value) = @_;"
NSQ_SOURCE_LINE 00002049 ""
NSQ_SOURCE_LINE 00002050 "    # specified=0, it's the default !"
NSQ_SOURCE_LINE 00002051 "    my $attr = $self->[_Doc]->createAttribute ($self->[_Name], undef, 0);"
NSQ_SOURCE_LINE 00002052 "    $attr->[_ReadOnly] = 1;"
NSQ_SOURCE_LINE 00002053 ""
NSQ_SOURCE_LINE 00002054 "#?? this should be split over Text and EntityReference nodes, just like other"
NSQ_SOURCE_LINE 00002055 "# Attr nodes - just expand the text for now"
NSQ_SOURCE_LINE 00002056 "    $value = $self->expandEntityRefs ($value);"
NSQ_SOURCE_LINE 00002057 "    $attr->addText ($value);"
NSQ_SOURCE_LINE 00002058 "#?? reimplement in NoExpand mode!"
NSQ_SOURCE_LINE 00002059 ""
NSQ_SOURCE_LINE 00002060 "    $attr;"
NSQ_SOURCE_LINE 00002061 "}"
NSQ_SOURCE_LINE 00002062 ""
NSQ_SOURCE_LINE 00002063 "sub isFixed"
NSQ_SOURCE_LINE 00002064 "{"
