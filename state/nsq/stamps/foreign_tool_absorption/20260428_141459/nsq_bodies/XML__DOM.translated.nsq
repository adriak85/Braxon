NSQ_SOURCE_LINE 00002734 "\tfor my $kid (@kids)"
NSQ_SOURCE_LINE 00002735 "\t{"
NSQ_SOURCE_LINE 00002736 "\t    $kid->print ($FILE);"
NSQ_SOURCE_LINE 00002737 "\t}"
NSQ_SOURCE_LINE 00002738 "\t$FILE->print (\"</$name>\");"
NSQ_SOURCE_LINE 00002739 "    }"
NSQ_SOURCE_LINE 00002740 "    else"
NSQ_SOURCE_LINE 00002741 "    {"
NSQ_SOURCE_LINE 00002742 "\tmy $style = &$XML::DOM::TagStyle ($name, $self);"
NSQ_SOURCE_LINE 00002743 "\tif ($style == 0)"
NSQ_SOURCE_LINE 00002744 "\t{"
NSQ_SOURCE_LINE 00002745 "\t    $FILE->print (\"/>\");"
NSQ_SOURCE_LINE 00002746 "\t}"
NSQ_SOURCE_LINE 00002747 "\telsif ($style == 1)"
NSQ_SOURCE_LINE 00002748 "\t{"
NSQ_SOURCE_LINE 00002749 "\t    $FILE->print (\"></$name>\");"
NSQ_SOURCE_LINE 00002750 "\t}"
NSQ_SOURCE_LINE 00002751 "\telse"
NSQ_SOURCE_LINE 00002752 "\t{"
NSQ_SOURCE_LINE 00002753 "\t    $FILE->print (\" />\");"
NSQ_SOURCE_LINE 00002754 "\t}"
NSQ_SOURCE_LINE 00002755 "    }"
NSQ_SOURCE_LINE 00002756 "}"
