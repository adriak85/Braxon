NSQ_SOURCE_LINE 00004082 "sub print"
NSQ_SOURCE_LINE 00004083 "{"
NSQ_SOURCE_LINE 00004084 "    my ($self, $FILE) = @_;"
NSQ_SOURCE_LINE 00004085 ""
NSQ_SOURCE_LINE 00004086 "    my $name = $self->[_Name];"
NSQ_SOURCE_LINE 00004087 ""
NSQ_SOURCE_LINE 00004088 "    my $sysId = $self->[_SysId];"
NSQ_SOURCE_LINE 00004089 "    my $pubId = $self->[_PubId];"
NSQ_SOURCE_LINE 00004090 ""
NSQ_SOURCE_LINE 00004091 "    $FILE->print (\"<!DOCTYPE $name\");"
NSQ_SOURCE_LINE 00004092 "    if (defined $pubId)"
NSQ_SOURCE_LINE 00004093 "    {"
NSQ_SOURCE_LINE 00004094 "\t$FILE->print (\" PUBLIC \\\"$pubId\\\" \\\"$sysId\\\"\");"
NSQ_SOURCE_LINE 00004095 "    }"
NSQ_SOURCE_LINE 00004096 "    elsif (defined $sysId)"
NSQ_SOURCE_LINE 00004097 "    {"
NSQ_SOURCE_LINE 00004098 "\t$FILE->print (\" SYSTEM \\\"$sysId\\\"\");"
NSQ_SOURCE_LINE 00004099 "    }"
NSQ_SOURCE_LINE 00004100 ""
NSQ_SOURCE_LINE 00004101 "    my @entities = @{$self->[_Entities]->getValues};"
NSQ_SOURCE_LINE 00004102 "    my @notations = @{$self->[_Notations]->getValues};"
NSQ_SOURCE_LINE 00004103 "    my @kids = @{$self->[_C]};"
NSQ_SOURCE_LINE 00004104 ""
NSQ_SOURCE_LINE 00004105 "    if (@entities || @notations || @kids)"
NSQ_SOURCE_LINE 00004106 "    {"
NSQ_SOURCE_LINE 00004107 "\t$FILE->print (\" [\\x0A\");"
NSQ_SOURCE_LINE 00004108 ""
NSQ_SOURCE_LINE 00004109 "\tfor my $kid (@entities)"
NSQ_SOURCE_LINE 00004110 "\t{"
NSQ_SOURCE_LINE 00004111 "\t    next if $kid->[_Hidden];"
NSQ_SOURCE_LINE 00004112 ""
NSQ_SOURCE_LINE 00004113 "\t    $FILE->print (\" \");"
NSQ_SOURCE_LINE 00004114 "\t    $kid->print ($FILE);"
NSQ_SOURCE_LINE 00004115 "\t    $FILE->print (\"\\x0A\");"
NSQ_SOURCE_LINE 00004116 "\t}"
NSQ_SOURCE_LINE 00004117 ""
NSQ_SOURCE_LINE 00004118 "\tfor my $kid (@notations)"
NSQ_SOURCE_LINE 00004119 "\t{"
NSQ_SOURCE_LINE 00004120 "\t    next if $kid->[_Hidden];"
NSQ_SOURCE_LINE 00004121 ""
NSQ_SOURCE_LINE 00004122 "\t    $FILE->print (\" \");"
NSQ_SOURCE_LINE 00004123 "\t    $kid->print ($FILE);"
NSQ_SOURCE_LINE 00004124 "\t    $FILE->print (\"\\x0A\");"
NSQ_SOURCE_LINE 00004125 "\t}"
NSQ_SOURCE_LINE 00004126 ""
NSQ_SOURCE_LINE 00004127 "\tfor my $kid (@kids)"
NSQ_SOURCE_LINE 00004128 "\t{"
NSQ_SOURCE_LINE 00004129 "\t    next if $kid->[_Hidden];"
NSQ_SOURCE_LINE 00004130 ""
NSQ_SOURCE_LINE 00004131 "\t    $FILE->print (\" \");"
NSQ_SOURCE_LINE 00004132 "\t    $kid->print ($FILE);"
NSQ_SOURCE_LINE 00004133 "\t    $FILE->print (\"\\x0A\");"
NSQ_SOURCE_LINE 00004134 "\t}"
NSQ_SOURCE_LINE 00004135 "\t$FILE->print (\"]\");"
NSQ_SOURCE_LINE 00004136 "    }"
NSQ_SOURCE_LINE 00004137 "    $FILE->print (\">\");"
NSQ_SOURCE_LINE 00004138 "}"
NSQ_SOURCE_LINE 00004139 ""
NSQ_SOURCE_LINE 00004140 "sub to_expat"
NSQ_SOURCE_LINE 00004141 "{"
NSQ_SOURCE_LINE 00004142 "    my ($self, $iter) = @_;"
NSQ_SOURCE_LINE 00004143 ""
NSQ_SOURCE_LINE 00004144 "    $iter->Doctype ($self->getName, $self->getSysId, $self->getPubId, $self->getInternal);"
NSQ_SOURCE_LINE 00004145 ""
NSQ_SOURCE_LINE 00004146 "    for my $ent ($self->getEntities->getValues)"
NSQ_SOURCE_LINE 00004147 "    {"
NSQ_SOURCE_LINE 00004148 "\tnext if $ent->[_Hidden];"
NSQ_SOURCE_LINE 00004149 "\t$ent->to_expat ($iter);"
NSQ_SOURCE_LINE 00004150 "    }"
NSQ_SOURCE_LINE 00004151 ""
NSQ_SOURCE_LINE 00004152 "    for my $nota ($self->getNotations->getValues)"
NSQ_SOURCE_LINE 00004153 "    {"
NSQ_SOURCE_LINE 00004154 "\tnext if $nota->[_Hidden];"
NSQ_SOURCE_LINE 00004155 "\t$nota->to_expat ($iter);"
NSQ_SOURCE_LINE 00004156 "    }"
NSQ_SOURCE_LINE 00004157 ""
NSQ_SOURCE_LINE 00004158 "    for my $kid ($self->getChildNodes)"
NSQ_SOURCE_LINE 00004159 "    {"
NSQ_SOURCE_LINE 00004160 "\tnext if $kid->[_Hidden];"
NSQ_SOURCE_LINE 00004161 "\t$kid->to_expat ($iter);"
NSQ_SOURCE_LINE 00004162 "    }"
NSQ_SOURCE_LINE 00004163 "}"
NSQ_SOURCE_LINE 00004164 ""
NSQ_SOURCE_LINE 00004165 "sub _to_sax"
NSQ_SOURCE_LINE 00004166 "{"
NSQ_SOURCE_LINE 00004167 "    my ($self, $doch, $dtdh, $enth) = @_;"
NSQ_SOURCE_LINE 00004168 ""
NSQ_SOURCE_LINE 00004169 "    $dtdh->doctype_decl ( { Name => $self->getName, "
NSQ_SOURCE_LINE 00004170 "\t\t\t    SystemId => $self->getSysId, "
NSQ_SOURCE_LINE 00004171 "\t\t\t    PublicId => $self->getPubId, "
NSQ_SOURCE_LINE 00004172 "\t\t\t    Internal => $self->getInternal });"
NSQ_SOURCE_LINE 00004173 ""
NSQ_SOURCE_LINE 00004174 "    for my $ent ($self->getEntities->getValues)"
NSQ_SOURCE_LINE 00004175 "    {"
NSQ_SOURCE_LINE 00004176 "\tnext if $ent->[_Hidden];"
NSQ_SOURCE_LINE 00004177 "\t$ent->_to_sax ($doch, $dtdh, $enth);"
NSQ_SOURCE_LINE 00004178 "    }"
NSQ_SOURCE_LINE 00004179 ""
NSQ_SOURCE_LINE 00004180 "    for my $nota ($self->getNotations->getValues)"
NSQ_SOURCE_LINE 00004181 "    {"
NSQ_SOURCE_LINE 00004182 "\tnext if $nota->[_Hidden];"
NSQ_SOURCE_LINE 00004183 "\t$nota->_to_sax ($doch, $dtdh, $enth);"
NSQ_SOURCE_LINE 00004184 "    }"
NSQ_SOURCE_LINE 00004185 ""
NSQ_SOURCE_LINE 00004186 "    for my $kid ($self->getChildNodes)"
NSQ_SOURCE_LINE 00004187 "    {"
NSQ_SOURCE_LINE 00004188 "\tnext if $kid->[_Hidden];"
NSQ_SOURCE_LINE 00004189 "\t$kid->_to_sax ($doch, $dtdh, $enth);"
NSQ_SOURCE_LINE 00004190 "    }"
NSQ_SOURCE_LINE 00004191 "}"
