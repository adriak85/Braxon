NSQ_SOURCE_LINE 00003137 "sub splitText"
NSQ_SOURCE_LINE 00003138 "{"
NSQ_SOURCE_LINE 00003139 "    my ($self, $offset) = @_;"
NSQ_SOURCE_LINE 00003140 ""
NSQ_SOURCE_LINE 00003141 "    my $data = $self->getData;"
NSQ_SOURCE_LINE 00003142 "    croak new XML::DOM::DOMException (INDEX_SIZE_ERR,"
NSQ_SOURCE_LINE 00003143 "\t\t\t\t      \"bad offset [$offset]\")"
NSQ_SOURCE_LINE 00003144 "\tif ($offset < 0 || $offset >= length ($data));"
NSQ_SOURCE_LINE 00003145 "#?? DOM Spec says >, but >= makes more sense!"
NSQ_SOURCE_LINE 00003146 ""
NSQ_SOURCE_LINE 00003147 "    croak new XML::DOM::DOMException (NO_MODIFICATION_ALLOWED_ERR,"
NSQ_SOURCE_LINE 00003148 "\t\t\t\t      \"node is ReadOnly\")"
NSQ_SOURCE_LINE 00003149 "\tif $self->isReadOnly;"
NSQ_SOURCE_LINE 00003150 ""
NSQ_SOURCE_LINE 00003151 "    my $rest = substr ($data, $offset);"
NSQ_SOURCE_LINE 00003152 ""
NSQ_SOURCE_LINE 00003153 "    $self->setData (substr ($data, 0, $offset));"
NSQ_SOURCE_LINE 00003154 "    my $node = $self->[_Doc]->createTextNode ($rest);"
NSQ_SOURCE_LINE 00003155 ""
NSQ_SOURCE_LINE 00003156 "    # insert new node after this node"
NSQ_SOURCE_LINE 00003157 "    $self->[_Parent]->insertBefore ($node, $self->getNextSibling);"
NSQ_SOURCE_LINE 00003158 ""
NSQ_SOURCE_LINE 00003159 "    $node;"
NSQ_SOURCE_LINE 00003160 "}"
NSQ_SOURCE_LINE 00003161 ""
