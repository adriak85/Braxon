NSQ_SOURCE_LINE 00002792 ""
NSQ_SOURCE_LINE 00002793 "sub _to_sax"
NSQ_SOURCE_LINE 00002794 "{"
NSQ_SOURCE_LINE 00002795 "    my ($self, $doch, $dtdh, $enth) = @_;"
NSQ_SOURCE_LINE 00002796 ""
NSQ_SOURCE_LINE 00002797 "    my $tag = $self->getTagName;"
NSQ_SOURCE_LINE 00002798 ""
NSQ_SOURCE_LINE 00002799 "    my @attr = ();"
NSQ_SOURCE_LINE 00002800 "    my $attrOrder;"
NSQ_SOURCE_LINE 00002801 "    my $attrDefaulted;"
NSQ_SOURCE_LINE 00002802 ""
NSQ_SOURCE_LINE 00002803 "    if (defined $self->[_A])"
NSQ_SOURCE_LINE 00002804 "    {"
NSQ_SOURCE_LINE 00002805 "\tmy @spec = ();\t\t# names of specified attributes"
NSQ_SOURCE_LINE 00002806 "\tmy @unspec = ();\t# names of defaulted attributes"
NSQ_SOURCE_LINE 00002807 ""
NSQ_SOURCE_LINE 00002808 "\tfor my $attr ($self->[_A]->getValues) "
NSQ_SOURCE_LINE 00002809 "\t{"
NSQ_SOURCE_LINE 00002810 "\t    my $attrName = $attr->getName;"
NSQ_SOURCE_LINE 00002811 "\t    push @attr, $attrName, $attr->getValue;"
NSQ_SOURCE_LINE 00002812 "\t    if ($attr->isSpecified)"
NSQ_SOURCE_LINE 00002813 "\t    {"
NSQ_SOURCE_LINE 00002814 "\t\tpush @spec, $attrName;"
NSQ_SOURCE_LINE 00002815 "\t    }"
NSQ_SOURCE_LINE 00002816 "\t    else"
NSQ_SOURCE_LINE 00002817 "\t    {"
NSQ_SOURCE_LINE 00002818 "\t\tpush @unspec, $attrName;"
NSQ_SOURCE_LINE 00002819 "\t    }"
NSQ_SOURCE_LINE 00002820 "\t}"
NSQ_SOURCE_LINE 00002821 "\t$attrOrder = [ @spec, @unspec ];"
NSQ_SOURCE_LINE 00002822 "\t$attrDefaulted = @spec;"
NSQ_SOURCE_LINE 00002823 "    }"
NSQ_SOURCE_LINE 00002824 "    $doch->start_element (defined $attrOrder ? "
NSQ_SOURCE_LINE 00002825 "\t\t\t  { Name => $tag, "
NSQ_SOURCE_LINE 00002826 "\t\t\t    Attributes => { @attr },"
NSQ_SOURCE_LINE 00002827 "\t\t\t    AttributeOrder => $attrOrder,"
NSQ_SOURCE_LINE 00002828 "\t\t\t    Defaulted => $attrDefaulted"
NSQ_SOURCE_LINE 00002829 "\t\t\t  } :"
NSQ_SOURCE_LINE 00002830 "\t\t\t  { Name => $tag, "
NSQ_SOURCE_LINE 00002831 "\t\t\t    Attributes => { @attr } "
NSQ_SOURCE_LINE 00002832 "\t\t\t  }"
NSQ_SOURCE_LINE 00002833 "\t\t\t );"
NSQ_SOURCE_LINE 00002834 ""
NSQ_SOURCE_LINE 00002835 "    for my $kid ($self->getChildNodes)"
NSQ_SOURCE_LINE 00002836 "    {"
NSQ_SOURCE_LINE 00002837 "\t$kid->_to_sax ($doch, $dtdh, $enth);"
NSQ_SOURCE_LINE 00002838 "    }"
NSQ_SOURCE_LINE 00002839 ""
NSQ_SOURCE_LINE 00002840 "    $doch->end_element ( { Name => $tag } );"
NSQ_SOURCE_LINE 00002841 "}"
