NSQ_SOURCE_LINE 00000114 "#"
NSQ_SOURCE_LINE 00000115 "# If you don't want DOM warnings to use 'warn', override this method like this:"
NSQ_SOURCE_LINE 00000116 "#"
NSQ_SOURCE_LINE 00000117 "# { # start block scope"
NSQ_SOURCE_LINE 00000118 "#\tlocal *XML::DOM::warning = \\&my_warn;"
NSQ_SOURCE_LINE 00000119 "#\t... your code here ..."
NSQ_SOURCE_LINE 00000120 "# } # end block scope (old XML::DOM::warning takes effect again)"
NSQ_SOURCE_LINE 00000121 "#"
NSQ_SOURCE_LINE 00000122 "sub warning\t# static"
NSQ_SOURCE_LINE 00000123 "{"
NSQ_SOURCE_LINE 00000124 "    warn @_;"
NSQ_SOURCE_LINE 00000125 "}"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "#"
NSQ_SOURCE_LINE 00000128 "# This method defines several things in the caller's package, so you can use named constants to"
NSQ_SOURCE_LINE 00000129 "# access the array that holds the member data, i.e. $self->[_Data]. It assumes the caller's package"
NSQ_SOURCE_LINE 00000130 "# defines a class that is implemented as a blessed array reference."
NSQ_SOURCE_LINE 00000131 "# Note that this is very similar to using 'use fields' and 'use base'."
NSQ_SOURCE_LINE 00000132 "#"
NSQ_SOURCE_LINE 00000133 "# E.g. if $fields eq \"Name Model\", $parent eq \"XML::DOM::Node\" and"
NSQ_SOURCE_LINE 00000134 "# XML::DOM::Node had \"A B C\" as fields and it was called from package \"XML::DOM::ElementDecl\","
NSQ_SOURCE_LINE 00000135 "# then this code would basically do the following:"
NSQ_SOURCE_LINE 00000136 "#"
NSQ_SOURCE_LINE 00000137 "# package XML::DOM::ElementDecl;"
NSQ_SOURCE_LINE 00000138 "#"
NSQ_SOURCE_LINE 00000139 "# sub _Name  () { 3 }\t# Note that parent class had three fields"
NSQ_SOURCE_LINE 00000140 "# sub _Model () { 4 }"
NSQ_SOURCE_LINE 00000141 "#"
NSQ_SOURCE_LINE 00000142 "# # Maps constant names (without '_') to constant (int) value"
NSQ_SOURCE_LINE 00000143 "# %HFIELDS = ( %XML::DOM::Node::HFIELDS, Name => _Name, Model => _Model );"
NSQ_SOURCE_LINE 00000144 "#"
NSQ_SOURCE_LINE 00000145 "# # Define XML:DOM::ElementDecl as a subclass of XML::DOM::Node"
NSQ_SOURCE_LINE 00000146 "# @ISA = qw{ XML::DOM::Node };"
NSQ_SOURCE_LINE 00000147 "#"
NSQ_SOURCE_LINE 00000148 "# # The following function names can be exported into the user's namespace."
NSQ_SOURCE_LINE 00000149 "# @EXPORT_OK = qw{ _Name _Model };"
NSQ_SOURCE_LINE 00000150 "#"
NSQ_SOURCE_LINE 00000151 "# # The following function names can be exported into the user's namespace"
NSQ_SOURCE_LINE 00000152 "# # with: import XML::DOM::ElementDecl qw( :Fields );"
NSQ_SOURCE_LINE 00000153 "# %EXPORT_TAGS = ( Fields => qw{ _Name _Model } );"
NSQ_SOURCE_LINE 00000154 "#"
NSQ_SOURCE_LINE 00000155 "sub def_fields\t# static"
NSQ_SOURCE_LINE 00000156 "{"
NSQ_SOURCE_LINE 00000157 "    my ($fields, $parent) = @_;"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "    my ($pkg) = caller;"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    my @f = split (/\\s+/, $fields);"
NSQ_SOURCE_LINE 00000164 "    my $n = 0;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "    my %hfields;"
NSQ_SOURCE_LINE 00000167 "    if (defined $parent)"
NSQ_SOURCE_LINE 00000168 "    {"
NSQ_SOURCE_LINE 00000169 "\tmy %pf = %{\"$parent\\::HFIELDS\"};"
NSQ_SOURCE_LINE 00000170 "\t%hfields = %pf;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "\t$n = scalar (keys %pf);"
NSQ_SOURCE_LINE 00000173 "\t@{\"$pkg\\::ISA\"} = ( $parent );"
NSQ_SOURCE_LINE 00000174 "    }"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    my $i = $n;"
NSQ_SOURCE_LINE 00000177 "    for (@f)"
NSQ_SOURCE_LINE 00000178 "    {"
NSQ_SOURCE_LINE 00000179 "\teval \"sub $pkg\\::_$_ () { $i }\";"
NSQ_SOURCE_LINE 00000180 "\t$hfields{$_} = $i;"
NSQ_SOURCE_LINE 00000181 "\t$i++;"
NSQ_SOURCE_LINE 00000182 "    }"
NSQ_SOURCE_LINE 00000183 "    %{\"$pkg\\::HFIELDS\"} = %hfields;"
NSQ_SOURCE_LINE 00000184 "    @{\"$pkg\\::EXPORT_OK\"} = map { \"_$_\" } @f;"
NSQ_SOURCE_LINE 00000185 "    "
NSQ_SOURCE_LINE 00000186 "    ${\"$pkg\\::EXPORT_TAGS\"}{Fields} = [ map { \"_$_\" } @f ];"
NSQ_SOURCE_LINE 00000187 "}"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "# sub blesh"
NSQ_SOURCE_LINE 00000190 "# {"
NSQ_SOURCE_LINE 00000191 "#     my $hashref = shift;"
NSQ_SOURCE_LINE 00000192 "#     my $class = shift;"
NSQ_SOURCE_LINE 00000193 "#     no strict 'refs';"
NSQ_SOURCE_LINE 00000194 "#     my $self = bless [\\%{\"$class\\::FIELDS\"}], $class;"
NSQ_SOURCE_LINE 00000195 "#     if (defined $hashref)"
NSQ_SOURCE_LINE 00000196 "#     {"
NSQ_SOURCE_LINE 00000197 "# \tfor (keys %$hashref)"
NSQ_SOURCE_LINE 00000198 "# \t{"
NSQ_SOURCE_LINE 00000199 "# \t    $self->{$_} = $hashref->{$_};"
NSQ_SOURCE_LINE 00000200 "# \t}"
NSQ_SOURCE_LINE 00000201 "#     }"
NSQ_SOURCE_LINE 00000202 "#     $self;"
NSQ_SOURCE_LINE 00000203 "# }"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "# sub blesh2"
NSQ_SOURCE_LINE 00000206 "# {"
NSQ_SOURCE_LINE 00000207 "#     my $hashref = shift;"
NSQ_SOURCE_LINE 00000208 "#     my $class = shift;"
NSQ_SOURCE_LINE 00000209 "#     no strict 'refs';"
NSQ_SOURCE_LINE 00000210 "#     my $self = bless [\\%{\"$class\\::FIELDS\"}], $class;"
NSQ_SOURCE_LINE 00000211 "#     if (defined $hashref)"
NSQ_SOURCE_LINE 00000212 "#     {"
NSQ_SOURCE_LINE 00000213 "# \tfor (keys %$hashref)"
NSQ_SOURCE_LINE 00000214 "# \t{"
NSQ_SOURCE_LINE 00000215 "# \t    eval { $self->{$_} = $hashref->{$_}; };"
NSQ_SOURCE_LINE 00000216 "# \t    croak \"ERROR in field [$_] $@\" if $@;"
NSQ_SOURCE_LINE 00000217 "# \t}"
NSQ_SOURCE_LINE 00000218 "#     }"
NSQ_SOURCE_LINE 00000219 "#     $self;"
NSQ_SOURCE_LINE 00000220 "#}"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "#"
