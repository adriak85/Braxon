NSQ_SOURCE_LINE 00003550 "    {"
NSQ_SOURCE_LINE 00003551 "\tcroak new XML::DOM::DOMException (HIERARCHY_REQUEST_ERR,"
NSQ_SOURCE_LINE 00003552 "\t\t\t\t\t  \"document can have only one Element\");"
NSQ_SOURCE_LINE 00003553 "    }"
NSQ_SOURCE_LINE 00003554 "    $self->SUPER::appendChild ($node);"
