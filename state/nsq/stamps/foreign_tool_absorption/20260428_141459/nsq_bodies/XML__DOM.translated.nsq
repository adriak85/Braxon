NSQ_SOURCE_LINE 00001809 "    my $name = ($self->isParameterEntity ? '%' : \"\") . $self->getNotationName; "
NSQ_SOURCE_LINE 00001810 "    $dtdh->entity_decl ( { Name => $name, "
NSQ_SOURCE_LINE 00001811 "\t\t\t   Value => $self->getValue, "
NSQ_SOURCE_LINE 00001812 "\t\t\t   SystemId => $self->getSysId, "
NSQ_SOURCE_LINE 00001813 "\t\t\t   PublicId => $self->getPubId, "
NSQ_SOURCE_LINE 00001814 "\t\t\t   Notation => $self->getNdata } );"
NSQ_SOURCE_LINE 00001815 "}"
