NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "#"
NSQ_SOURCE_LINE 00000243 "#?? Not sure if this is right - must prevent double minus somehow..."
NSQ_SOURCE_LINE 00000244 "#"
NSQ_SOURCE_LINE 00000245 "sub encodeComment"
NSQ_SOURCE_LINE 00000246 "{"
NSQ_SOURCE_LINE 00000247 "    my ($str) = shift;"
NSQ_SOURCE_LINE 00000248 "    return undef unless defined $str;"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "    $str =~ s/--/&#45;&#45;/go;"
NSQ_SOURCE_LINE 00000251 "    $str;"
NSQ_SOURCE_LINE 00000252 "}"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "#"
NSQ_SOURCE_LINE 00000255 "# For debugging"
NSQ_SOURCE_LINE 00000256 "#"
NSQ_SOURCE_LINE 00000257 "sub toHex"
NSQ_SOURCE_LINE 00000258 "{"
NSQ_SOURCE_LINE 00000259 "    my $str = shift;"
NSQ_SOURCE_LINE 00000260 "    my $len = length($str);"
NSQ_SOURCE_LINE 00000261 "    my @a = unpack (\"C$len\", $str);"
NSQ_SOURCE_LINE 00000262 "    my $s = \"\";"
NSQ_SOURCE_LINE 00000263 "    for (@a)"
NSQ_SOURCE_LINE 00000264 "    {"
NSQ_SOURCE_LINE 00000265 "\t$s .= sprintf (\"%02x\", $_);"
NSQ_SOURCE_LINE 00000266 "    }"
NSQ_SOURCE_LINE 00000267 "    $s;"
NSQ_SOURCE_LINE 00000268 "}"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "#"
NSQ_SOURCE_LINE 00000271 "# 2nd parameter $default: list of Default Entity characters that need to be "
NSQ_SOURCE_LINE 00000272 "# converted (e.g. \"&<\" for conversion to \"&amp;\" and \"&lt;\" resp.)"
NSQ_SOURCE_LINE 00000273 "#"
NSQ_SOURCE_LINE 00000274 "sub encodeText"
NSQ_SOURCE_LINE 00000275 "{"
NSQ_SOURCE_LINE 00000276 "    my ($str, $default) = @_;"
NSQ_SOURCE_LINE 00000277 "    return undef unless defined $str;"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "    if ($] >= 5.006) {"
NSQ_SOURCE_LINE 00000280 "      $str =~ s/([$default])|(]]>)/"
NSQ_SOURCE_LINE 00000281 "        defined ($1) ? $DecodeDefaultEntity{$1} : \"]]&gt;\" /egs;"
NSQ_SOURCE_LINE 00000282 "    }"
NSQ_SOURCE_LINE 00000283 "    else {"
NSQ_SOURCE_LINE 00000284 "      $str =~ s/([\\xC0-\\xDF].|[\\xE0-\\xEF]..|[\\xF0-\\xFF]...)|([$default])|(]]>)/"
NSQ_SOURCE_LINE 00000285 "        defined($1) ? XmlUtf8Decode ($1) :"
NSQ_SOURCE_LINE 00000286 "        defined ($2) ? $DecodeDefaultEntity{$2} : \"]]&gt;\" /egs;"
NSQ_SOURCE_LINE 00000287 "    }"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "#?? could there be references that should not be expanded?"
NSQ_SOURCE_LINE 00000290 "# e.g. should not replace &#nn; &#xAF; and &abc;"
NSQ_SOURCE_LINE 00000291 "#    $str =~ s/&(?!($ReName|#[0-9]+|#x[0-9a-fA-F]+);)/&amp;/go;"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "    $str;"
NSQ_SOURCE_LINE 00000294 "}"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "#"
NSQ_SOURCE_LINE 00000297 "# Used by AttDef - default value"
NSQ_SOURCE_LINE 00000298 "#"
NSQ_SOURCE_LINE 00000299 "sub encodeAttrValue"
NSQ_SOURCE_LINE 00000300 "{"
NSQ_SOURCE_LINE 00000301 "    encodeText (shift, '\"&<>');"
NSQ_SOURCE_LINE 00000302 "}"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "#"
NSQ_SOURCE_LINE 00000305 "# Converts an integer (Unicode - ISO/IEC 10646) to a UTF-8 encoded character "
NSQ_SOURCE_LINE 00000306 "# sequence."
NSQ_SOURCE_LINE 00000307 "# Used when converting e.g. &#123; or &#x3ff; to a string value."
NSQ_SOURCE_LINE 00000308 "#"
NSQ_SOURCE_LINE 00000309 "# Algorithm borrowed from expat/xmltok.c/XmlUtf8Encode()"
NSQ_SOURCE_LINE 00000310 "#"
NSQ_SOURCE_LINE 00000311 "# not checking for bad characters: < 0, x00-x08, x0B-x0C, x0E-x1F, xFFFE-xFFFF"
NSQ_SOURCE_LINE 00000312 "#"
NSQ_SOURCE_LINE 00000313 "sub XmlUtf8Encode"
NSQ_SOURCE_LINE 00000314 "{"
NSQ_SOURCE_LINE 00000315 "    my $n = shift;"
NSQ_SOURCE_LINE 00000316 "    if ($n < 0x80)"
NSQ_SOURCE_LINE 00000317 "    {"
NSQ_SOURCE_LINE 00000318 "\treturn chr ($n);"
NSQ_SOURCE_LINE 00000319 "    }"
NSQ_SOURCE_LINE 00000320 "    elsif ($n < 0x800)"
NSQ_SOURCE_LINE 00000321 "    {"
NSQ_SOURCE_LINE 00000322 "\treturn pack (\"CC\", (($n >> 6) | 0xc0), (($n & 0x3f) | 0x80));"
NSQ_SOURCE_LINE 00000323 "    }"
NSQ_SOURCE_LINE 00000324 "    elsif ($n < 0x10000)"
NSQ_SOURCE_LINE 00000325 "    {"
NSQ_SOURCE_LINE 00000326 "\treturn pack (\"CCC\", (($n >> 12) | 0xe0), ((($n >> 6) & 0x3f) | 0x80),"
NSQ_SOURCE_LINE 00000327 "\t\t     (($n & 0x3f) | 0x80));"
NSQ_SOURCE_LINE 00000328 "    }"
NSQ_SOURCE_LINE 00000329 "    elsif ($n < 0x110000)"
NSQ_SOURCE_LINE 00000330 "    {"
NSQ_SOURCE_LINE 00000331 "\treturn pack (\"CCCC\", (($n >> 18) | 0xf0), ((($n >> 12) & 0x3f) | 0x80),"
NSQ_SOURCE_LINE 00000332 "\t\t     ((($n >> 6) & 0x3f) | 0x80), (($n & 0x3f) | 0x80));"
NSQ_SOURCE_LINE 00000333 "    }"
NSQ_SOURCE_LINE 00000334 "    croak \"number is too large for Unicode [$n] in &XmlUtf8Encode\";"
NSQ_SOURCE_LINE 00000335 "}"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "#"
NSQ_SOURCE_LINE 00000338 "# Opposite of XmlUtf8Decode plus it adds prefix \"&#\" or \"&#x\" and suffix \";\""
NSQ_SOURCE_LINE 00000339 "# The 2nd parameter ($hex) indicates whether the result is hex encoded or not."
NSQ_SOURCE_LINE 00000340 "#"
NSQ_SOURCE_LINE 00000341 "sub XmlUtf8Decode"
NSQ_SOURCE_LINE 00000342 "{"
NSQ_SOURCE_LINE 00000343 "    my ($str, $hex) = @_;"
NSQ_SOURCE_LINE 00000344 "    my $len = length ($str);"
NSQ_SOURCE_LINE 00000345 "    my $n;"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "    if ($len == 2)"
NSQ_SOURCE_LINE 00000348 "    {"
NSQ_SOURCE_LINE 00000349 "\tmy @n = unpack \"C2\", $str;"
NSQ_SOURCE_LINE 00000350 "\t$n = (($n[0] & 0x3f) << 6) + ($n[1] & 0x3f);"
NSQ_SOURCE_LINE 00000351 "    }"
NSQ_SOURCE_LINE 00000352 "    elsif ($len == 3)"
NSQ_SOURCE_LINE 00000353 "    {"
NSQ_SOURCE_LINE 00000354 "\tmy @n = unpack \"C3\", $str;"
NSQ_SOURCE_LINE 00000355 "\t$n = (($n[0] & 0x1f) << 12) + (($n[1] & 0x3f) << 6) + "
NSQ_SOURCE_LINE 00000356 "\t\t($n[2] & 0x3f);"
NSQ_SOURCE_LINE 00000357 "    }"
NSQ_SOURCE_LINE 00000358 "    elsif ($len == 4)"
NSQ_SOURCE_LINE 00000359 "    {"
NSQ_SOURCE_LINE 00000360 "\tmy @n = unpack \"C4\", $str;"
NSQ_SOURCE_LINE 00000361 "\t$n = (($n[0] & 0x0f) << 18) + (($n[1] & 0x3f) << 12) + "
NSQ_SOURCE_LINE 00000362 "\t\t(($n[2] & 0x3f) << 6) + ($n[3] & 0x3f);"
NSQ_SOURCE_LINE 00000363 "    }"
NSQ_SOURCE_LINE 00000364 "    elsif ($len == 1)\t# just to be complete..."
NSQ_SOURCE_LINE 00000365 "    {"
NSQ_SOURCE_LINE 00000366 "\t$n = ord ($str);"
NSQ_SOURCE_LINE 00000367 "    }"
NSQ_SOURCE_LINE 00000368 "    else"
NSQ_SOURCE_LINE 00000369 "    {"
NSQ_SOURCE_LINE 00000370 "\tcroak \"bad value [$str] for XmlUtf8Decode\";"
NSQ_SOURCE_LINE 00000371 "    }"
NSQ_SOURCE_LINE 00000372 "    $hex ? sprintf (\"&#x%x;\", $n) : \"&#$n;\";"
NSQ_SOURCE_LINE 00000373 "}"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "$IgnoreReadOnly = 0;"
NSQ_SOURCE_LINE 00000376 "$SafeMode = 1;"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "sub getIgnoreReadOnly"
NSQ_SOURCE_LINE 00000379 "{"
NSQ_SOURCE_LINE 00000380 "    $IgnoreReadOnly;"
NSQ_SOURCE_LINE 00000381 "}"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "#"
NSQ_SOURCE_LINE 00000384 "# The global flag $IgnoreReadOnly is set to the specified value and the old "
NSQ_SOURCE_LINE 00000385 "# value of $IgnoreReadOnly is returned."
NSQ_SOURCE_LINE 00000386 "#"
NSQ_SOURCE_LINE 00000387 "# To temporarily disable read-only related exceptions (i.e. when parsing"
NSQ_SOURCE_LINE 00000388 "# XML or temporarily), do the following:"
NSQ_SOURCE_LINE 00000389 "#"
NSQ_SOURCE_LINE 00000390 "# my $oldIgnore = XML::DOM::ignoreReadOnly (1);"
NSQ_SOURCE_LINE 00000391 "# ... do whatever you want ..."
NSQ_SOURCE_LINE 00000392 "# XML::DOM::ignoreReadOnly ($oldIgnore);"
NSQ_SOURCE_LINE 00000393 "#"
NSQ_SOURCE_LINE 00000394 "sub ignoreReadOnly"
NSQ_SOURCE_LINE 00000395 "{"
NSQ_SOURCE_LINE 00000396 "    my $i = $IgnoreReadOnly;"
NSQ_SOURCE_LINE 00000397 "    $IgnoreReadOnly = $_[0];"
NSQ_SOURCE_LINE 00000398 "    return $i;"
NSQ_SOURCE_LINE 00000399 "}"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "#"
NSQ_SOURCE_LINE 00000402 "# XML spec seems to break its own rules... (see ENTITY xmlpio)"
NSQ_SOURCE_LINE 00000403 "#"
NSQ_SOURCE_LINE 00000404 "sub forgiving_isValidName"
NSQ_SOURCE_LINE 00000405 "{"
NSQ_SOURCE_LINE 00000406 "    use bytes;  # XML::RegExp expressed in terms encoded UTF8"
NSQ_SOURCE_LINE 00000407 "    $_[0] =~ /^$XML::RegExp::Name$/o;"
NSQ_SOURCE_LINE 00000408 "}"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "#"
NSQ_SOURCE_LINE 00000411 "# Don't allow names starting with xml (either case)"
NSQ_SOURCE_LINE 00000412 "#"
NSQ_SOURCE_LINE 00000413 "sub picky_isValidName"
NSQ_SOURCE_LINE 00000414 "{"
NSQ_SOURCE_LINE 00000415 "    use bytes;  # XML::RegExp expressed in terms encoded UTF8"
NSQ_SOURCE_LINE 00000416 "    $_[0] =~ /^$XML::RegExp::Name$/o and $_[0] !~ /^xml/i;"
NSQ_SOURCE_LINE 00000417 "}"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "# Be forgiving by default, "
NSQ_SOURCE_LINE 00000420 "*isValidName = \\&forgiving_isValidName;"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "sub allowReservedNames\t\t# static"
NSQ_SOURCE_LINE 00000423 "{"
NSQ_SOURCE_LINE 00000424 "    *isValidName = ($_[0] ? \\&forgiving_isValidName : \\&picky_isValidName);"
NSQ_SOURCE_LINE 00000425 "}"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "sub getAllowReservedNames\t# static"
NSQ_SOURCE_LINE 00000428 "{"
NSQ_SOURCE_LINE 00000429 "    *isValidName == \\&forgiving_isValidName;"
NSQ_SOURCE_LINE 00000430 "}"
NSQ_SOURCE_LINE 00000431 ""
