NSQ_SOURCE_LINE 00004193 "######################################################################"
NSQ_SOURCE_LINE 00004194 "package XML::DOM::Parser;"
NSQ_SOURCE_LINE 00004195 "######################################################################"
NSQ_SOURCE_LINE 00004196 "use vars qw ( @ISA );"
NSQ_SOURCE_LINE 00004197 "@ISA = qw( XML::Parser );"
NSQ_SOURCE_LINE 00004198 ""
NSQ_SOURCE_LINE 00004199 "sub new"
NSQ_SOURCE_LINE 00004200 "{"
NSQ_SOURCE_LINE 00004201 "    my ($class, %args) = @_;"
NSQ_SOURCE_LINE 00004202 ""
NSQ_SOURCE_LINE 00004203 "    $args{Style} = 'XML::Parser::Dom';"
NSQ_SOURCE_LINE 00004204 "    $class->SUPER::new (%args);"
NSQ_SOURCE_LINE 00004205 "}"
NSQ_SOURCE_LINE 00004206 ""
NSQ_SOURCE_LINE 00004207 "# This method needed to be overriden so we can restore some global "
NSQ_SOURCE_LINE 00004208 "# variables when an exception is thrown"
NSQ_SOURCE_LINE 00004209 "sub parse"
NSQ_SOURCE_LINE 00004210 "{"
NSQ_SOURCE_LINE 00004211 "    my $self = shift;"
NSQ_SOURCE_LINE 00004212 ""
NSQ_SOURCE_LINE 00004213 "    local $XML::Parser::Dom::_DP_doc;"
NSQ_SOURCE_LINE 00004214 "    local $XML::Parser::Dom::_DP_elem;"
NSQ_SOURCE_LINE 00004215 "    local $XML::Parser::Dom::_DP_doctype;"
NSQ_SOURCE_LINE 00004216 "    local $XML::Parser::Dom::_DP_in_prolog;"
NSQ_SOURCE_LINE 00004217 "    local $XML::Parser::Dom::_DP_end_doc;"
NSQ_SOURCE_LINE 00004218 "    local $XML::Parser::Dom::_DP_saw_doctype;"
NSQ_SOURCE_LINE 00004219 "    local $XML::Parser::Dom::_DP_in_CDATA;"
NSQ_SOURCE_LINE 00004220 "    local $XML::Parser::Dom::_DP_keep_CDATA;"
NSQ_SOURCE_LINE 00004221 "    local $XML::Parser::Dom::_DP_last_text;"
NSQ_SOURCE_LINE 00004222 ""
NSQ_SOURCE_LINE 00004223 ""
NSQ_SOURCE_LINE 00004224 "    # Temporarily disable checks that Expat already does (for performance)"
NSQ_SOURCE_LINE 00004225 "    local $XML::DOM::SafeMode = 0;"
NSQ_SOURCE_LINE 00004226 "    # Temporarily disable ReadOnly checks"
NSQ_SOURCE_LINE 00004227 "    local $XML::DOM::IgnoreReadOnly = 1;"
NSQ_SOURCE_LINE 00004228 ""
NSQ_SOURCE_LINE 00004229 "    my $ret;"
NSQ_SOURCE_LINE 00004230 "    eval {"
NSQ_SOURCE_LINE 00004231 "\t$ret = $self->SUPER::parse (@_);"
NSQ_SOURCE_LINE 00004232 "    };"
NSQ_SOURCE_LINE 00004233 "    my $err = $@;"
NSQ_SOURCE_LINE 00004234 ""
NSQ_SOURCE_LINE 00004235 "    if ($err)"
NSQ_SOURCE_LINE 00004236 "    {"
NSQ_SOURCE_LINE 00004237 "\tmy $doc = $XML::Parser::Dom::_DP_doc;"
NSQ_SOURCE_LINE 00004238 "\tif ($doc)"
NSQ_SOURCE_LINE 00004239 "\t{"
NSQ_SOURCE_LINE 00004240 "\t    $doc->dispose;"
NSQ_SOURCE_LINE 00004241 "\t}"
NSQ_SOURCE_LINE 00004242 "\tdie $err;"
NSQ_SOURCE_LINE 00004243 "    }"
NSQ_SOURCE_LINE 00004244 ""
NSQ_SOURCE_LINE 00004245 "    $ret;"
NSQ_SOURCE_LINE 00004246 "}"
NSQ_SOURCE_LINE 00004247 ""
NSQ_SOURCE_LINE 00004248 "my $LWP_USER_AGENT;"
NSQ_SOURCE_LINE 00004249 "sub set_LWP_UserAgent"
NSQ_SOURCE_LINE 00004250 "{"
NSQ_SOURCE_LINE 00004251 "    $LWP_USER_AGENT = shift;"
NSQ_SOURCE_LINE 00004252 "}"
NSQ_SOURCE_LINE 00004253 ""
NSQ_SOURCE_LINE 00004254 "sub parsefile"
NSQ_SOURCE_LINE 00004255 "{"
NSQ_SOURCE_LINE 00004256 "    my $self = shift;"
NSQ_SOURCE_LINE 00004257 "    my $url = shift;"
NSQ_SOURCE_LINE 00004258 ""
NSQ_SOURCE_LINE 00004259 "    # Any other URL schemes?"
NSQ_SOURCE_LINE 00004260 "    if ($url =~ /^(https?|ftp|wais|gopher|file):/)"
NSQ_SOURCE_LINE 00004261 "    {"
NSQ_SOURCE_LINE 00004262 "\t# Read the file from the web with LWP."
NSQ_SOURCE_LINE 00004263 "\t#"
NSQ_SOURCE_LINE 00004264 "\t# Note that we read in the entire file, which may not be ideal"
NSQ_SOURCE_LINE 00004265 "\t# for large files. LWP::UserAgent also provides a callback style"
NSQ_SOURCE_LINE 00004266 "\t# request, which we could convert to a stream with a fork()..."
NSQ_SOURCE_LINE 00004267 ""
NSQ_SOURCE_LINE 00004268 "\tmy $result;"
NSQ_SOURCE_LINE 00004269 "\teval"
NSQ_SOURCE_LINE 00004270 "\t{"
NSQ_SOURCE_LINE 00004271 "\t    use LWP::UserAgent;"
NSQ_SOURCE_LINE 00004272 ""
NSQ_SOURCE_LINE 00004273 "\t    my $ua = $self->{LWP_UserAgent};"
NSQ_SOURCE_LINE 00004274 "\t    unless (defined $ua)"
NSQ_SOURCE_LINE 00004275 "\t    {"
NSQ_SOURCE_LINE 00004276 "\t\tunless (defined $LWP_USER_AGENT)"
NSQ_SOURCE_LINE 00004277 "\t\t{"
NSQ_SOURCE_LINE 00004278 "\t\t    $LWP_USER_AGENT = LWP::UserAgent->new;"
NSQ_SOURCE_LINE 00004279 ""
NSQ_SOURCE_LINE 00004280 "\t\t    # Load proxy settings from environment variables, i.e.:"
NSQ_SOURCE_LINE 00004281 "\t\t    # http_proxy, ftp_proxy, no_proxy etc. (see LWP::UserAgent(3))"
NSQ_SOURCE_LINE 00004282 "\t\t    # You need these to go thru firewalls."
NSQ_SOURCE_LINE 00004283 "\t\t    $LWP_USER_AGENT->env_proxy;"
NSQ_SOURCE_LINE 00004284 "\t\t}"
NSQ_SOURCE_LINE 00004285 "\t\t$ua = $LWP_USER_AGENT;"
NSQ_SOURCE_LINE 00004286 "\t    }"
NSQ_SOURCE_LINE 00004287 "\t    my $req = new HTTP::Request 'GET', $url;"
NSQ_SOURCE_LINE 00004288 "\t    my $response = $ua->request ($req);"
NSQ_SOURCE_LINE 00004289 ""
NSQ_SOURCE_LINE 00004290 "\t    # Parse the result of the HTTP request"
NSQ_SOURCE_LINE 00004291 "\t    $result = $self->parse ($response->content, @_);"
NSQ_SOURCE_LINE 00004292 "\t};"
NSQ_SOURCE_LINE 00004293 "\tif ($@)"
NSQ_SOURCE_LINE 00004294 "\t{"
NSQ_SOURCE_LINE 00004295 "\t    die \"Couldn't parsefile [$url] with LWP: $@\";"
NSQ_SOURCE_LINE 00004296 "\t}"
NSQ_SOURCE_LINE 00004297 "\treturn $result;"
NSQ_SOURCE_LINE 00004298 "    }"
NSQ_SOURCE_LINE 00004299 "    else"
NSQ_SOURCE_LINE 00004300 "    {"
NSQ_SOURCE_LINE 00004301 "\treturn $self->SUPER::parsefile ($url, @_);"
NSQ_SOURCE_LINE 00004302 "    }"
NSQ_SOURCE_LINE 00004303 "}"
NSQ_SOURCE_LINE 00004304 ""
NSQ_SOURCE_LINE 00004305 "######################################################################"
NSQ_SOURCE_LINE 00004306 "package XML::Parser::Dom;"
NSQ_SOURCE_LINE 00004307 "######################################################################"
NSQ_SOURCE_LINE 00004308 ""
NSQ_SOURCE_LINE 00004309 "BEGIN"
NSQ_SOURCE_LINE 00004310 "{"
NSQ_SOURCE_LINE 00004311 "    import XML::DOM::Node qw( :Fields );"
NSQ_SOURCE_LINE 00004312 "    import XML::DOM::CharacterData qw( :Fields );"
NSQ_SOURCE_LINE 00004313 "}"
NSQ_SOURCE_LINE 00004314 ""
NSQ_SOURCE_LINE 00004315 "use vars qw( $_DP_doc"
NSQ_SOURCE_LINE 00004316 "\t     $_DP_elem"
NSQ_SOURCE_LINE 00004317 "\t     $_DP_doctype"
NSQ_SOURCE_LINE 00004318 "\t     $_DP_in_prolog"
NSQ_SOURCE_LINE 00004319 "\t     $_DP_end_doc"
NSQ_SOURCE_LINE 00004320 "\t     $_DP_saw_doctype"
NSQ_SOURCE_LINE 00004321 "\t     $_DP_in_CDATA"
NSQ_SOURCE_LINE 00004322 "\t     $_DP_keep_CDATA"
NSQ_SOURCE_LINE 00004323 "\t     $_DP_last_text"
NSQ_SOURCE_LINE 00004324 "\t     $_DP_level"
NSQ_SOURCE_LINE 00004325 "\t     $_DP_expand_pent"
NSQ_SOURCE_LINE 00004326 "\t   );"
NSQ_SOURCE_LINE 00004327 ""
NSQ_SOURCE_LINE 00004328 "# This adds a new Style to the XML::Parser class."
NSQ_SOURCE_LINE 00004329 "# From now on you can say: $parser = new XML::Parser ('Style' => 'Dom' );"
NSQ_SOURCE_LINE 00004330 "# but that is *NOT* how a regular user should use it!"
NSQ_SOURCE_LINE 00004331 "$XML::Parser::Built_In_Styles{Dom} = 1;"
NSQ_SOURCE_LINE 00004332 ""
NSQ_SOURCE_LINE 00004333 "sub Init"
NSQ_SOURCE_LINE 00004334 "{"
NSQ_SOURCE_LINE 00004335 "    $_DP_elem = $_DP_doc = new XML::DOM::Document();"
NSQ_SOURCE_LINE 00004336 "    $_DP_doctype = new XML::DOM::DocumentType ($_DP_doc);"
NSQ_SOURCE_LINE 00004337 "    $_DP_doc->setDoctype ($_DP_doctype);"
NSQ_SOURCE_LINE 00004338 "    $_DP_keep_CDATA = $_[0]->{KeepCDATA};"
NSQ_SOURCE_LINE 00004339 ""
NSQ_SOURCE_LINE 00004340 "    # Prepare for document prolog"
NSQ_SOURCE_LINE 00004341 "    $_DP_in_prolog = 1;"
NSQ_SOURCE_LINE 00004342 ""
NSQ_SOURCE_LINE 00004343 "    # We haven't passed the root element yet"
NSQ_SOURCE_LINE 00004344 "    $_DP_end_doc = 0;"
NSQ_SOURCE_LINE 00004345 ""
NSQ_SOURCE_LINE 00004346 "    # Expand parameter entities in the DTD by default"
NSQ_SOURCE_LINE 00004347 ""
NSQ_SOURCE_LINE 00004348 "    $_DP_expand_pent = defined $_[0]->{ExpandParamEnt} ? "
NSQ_SOURCE_LINE 00004349 "\t\t\t\t\t$_[0]->{ExpandParamEnt} : 1;"
NSQ_SOURCE_LINE 00004350 "    if ($_DP_expand_pent)"
NSQ_SOURCE_LINE 00004351 "    {"
NSQ_SOURCE_LINE 00004352 "\t$_[0]->{DOM_Entity} = {};"
NSQ_SOURCE_LINE 00004353 "    }"
NSQ_SOURCE_LINE 00004354 ""
NSQ_SOURCE_LINE 00004355 "    $_DP_level = 0;"
NSQ_SOURCE_LINE 00004356 ""
NSQ_SOURCE_LINE 00004357 "    undef $_DP_last_text;"
NSQ_SOURCE_LINE 00004358 "}"
NSQ_SOURCE_LINE 00004359 ""
NSQ_SOURCE_LINE 00004360 "sub Final"
NSQ_SOURCE_LINE 00004361 "{"
NSQ_SOURCE_LINE 00004362 "    unless ($_DP_saw_doctype)"
NSQ_SOURCE_LINE 00004363 "    {"
NSQ_SOURCE_LINE 00004364 "\tmy $doctype = $_DP_doc->removeDoctype;"
NSQ_SOURCE_LINE 00004365 "\t$doctype->dispose;"
NSQ_SOURCE_LINE 00004366 "    }"
NSQ_SOURCE_LINE 00004367 "    $_DP_doc;"
NSQ_SOURCE_LINE 00004368 "}"
NSQ_SOURCE_LINE 00004369 ""
NSQ_SOURCE_LINE 00004370 "sub Char"
NSQ_SOURCE_LINE 00004371 "{"
NSQ_SOURCE_LINE 00004372 "    my $str = $_[1];"
NSQ_SOURCE_LINE 00004373 ""
NSQ_SOURCE_LINE 00004374 "    if ($_DP_in_CDATA && $_DP_keep_CDATA)"
NSQ_SOURCE_LINE 00004375 "    {"
NSQ_SOURCE_LINE 00004376 "\tundef $_DP_last_text;"
NSQ_SOURCE_LINE 00004377 "\t# Merge text with previous node if possible"
NSQ_SOURCE_LINE 00004378 "\t$_DP_elem->addCDATA ($str);"
NSQ_SOURCE_LINE 00004379 "    }"
NSQ_SOURCE_LINE 00004380 "    else"
NSQ_SOURCE_LINE 00004381 "    {"
NSQ_SOURCE_LINE 00004382 "\t# Merge text with previous node if possible"
NSQ_SOURCE_LINE 00004383 "\t# Used to be:\t$expat->{DOM_Element}->addText ($str);"
NSQ_SOURCE_LINE 00004384 "\tif ($_DP_last_text)"
NSQ_SOURCE_LINE 00004385 "\t{"
NSQ_SOURCE_LINE 00004386 "\t    $_DP_last_text->[_Data] .= $str;"
NSQ_SOURCE_LINE 00004387 "\t}"
NSQ_SOURCE_LINE 00004388 "\telse"
NSQ_SOURCE_LINE 00004389 "\t{"
NSQ_SOURCE_LINE 00004390 "\t    $_DP_last_text = $_DP_doc->createTextNode ($str);"
NSQ_SOURCE_LINE 00004391 "\t    $_DP_last_text->[_Parent] = $_DP_elem;"
NSQ_SOURCE_LINE 00004392 "\t    push @{$_DP_elem->[_C]}, $_DP_last_text;"
NSQ_SOURCE_LINE 00004393 "\t}"
NSQ_SOURCE_LINE 00004394 "    }"
NSQ_SOURCE_LINE 00004395 "}"
NSQ_SOURCE_LINE 00004396 ""
NSQ_SOURCE_LINE 00004397 "sub Start"
NSQ_SOURCE_LINE 00004398 "{"
NSQ_SOURCE_LINE 00004399 "    my ($expat, $elem, @attr) = @_;"
NSQ_SOURCE_LINE 00004400 "    my $parent = $_DP_elem;"
NSQ_SOURCE_LINE 00004401 "    my $doc = $_DP_doc;"
NSQ_SOURCE_LINE 00004402 "    "
NSQ_SOURCE_LINE 00004403 "    if ($parent == $doc)"
NSQ_SOURCE_LINE 00004404 "    {"
NSQ_SOURCE_LINE 00004405 "\t# End of document prolog, i.e. start of first Element"
NSQ_SOURCE_LINE 00004406 "\t$_DP_in_prolog = 0;"
NSQ_SOURCE_LINE 00004407 "    }"
NSQ_SOURCE_LINE 00004408 "    "
NSQ_SOURCE_LINE 00004409 "    undef $_DP_last_text;"
NSQ_SOURCE_LINE 00004410 "    my $node = $doc->createElement ($elem);"
NSQ_SOURCE_LINE 00004411 "    $_DP_elem = $node;"
NSQ_SOURCE_LINE 00004412 "    $parent->appendChild ($node);"
NSQ_SOURCE_LINE 00004413 "    "
NSQ_SOURCE_LINE 00004414 "    my $n = @attr;"
NSQ_SOURCE_LINE 00004415 "    return unless $n;"
NSQ_SOURCE_LINE 00004416 ""
NSQ_SOURCE_LINE 00004417 "    # Add attributes"
NSQ_SOURCE_LINE 00004418 "    my $first_default = $expat->specified_attr;"
NSQ_SOURCE_LINE 00004419 "    my $i = 0;"
NSQ_SOURCE_LINE 00004420 "    while ($i < $n)"
NSQ_SOURCE_LINE 00004421 "    {"
NSQ_SOURCE_LINE 00004422 "\tmy $specified = $i < $first_default;"
NSQ_SOURCE_LINE 00004423 "\tmy $name = $attr[$i++];"
NSQ_SOURCE_LINE 00004424 "\tundef $_DP_last_text;"
NSQ_SOURCE_LINE 00004425 "\tmy $attr = $doc->createAttribute ($name, $attr[$i++], $specified);"
NSQ_SOURCE_LINE 00004426 "\t$node->setAttributeNode ($attr);"
NSQ_SOURCE_LINE 00004427 "    }"
NSQ_SOURCE_LINE 00004428 "}"
NSQ_SOURCE_LINE 00004429 ""
NSQ_SOURCE_LINE 00004430 "sub End"
NSQ_SOURCE_LINE 00004431 "{"
NSQ_SOURCE_LINE 00004432 "    $_DP_elem = $_DP_elem->[_Parent];"
NSQ_SOURCE_LINE 00004433 "    undef $_DP_last_text;"
NSQ_SOURCE_LINE 00004434 ""
NSQ_SOURCE_LINE 00004435 "    # Check for end of root element"
NSQ_SOURCE_LINE 00004436 "    $_DP_end_doc = 1 if ($_DP_elem == $_DP_doc);"
NSQ_SOURCE_LINE 00004437 "}"
NSQ_SOURCE_LINE 00004438 ""
NSQ_SOURCE_LINE 00004439 "# Called at end of file, i.e. whitespace following last closing tag"
NSQ_SOURCE_LINE 00004440 "# Also for Entity references"
NSQ_SOURCE_LINE 00004441 "# May also be called at other times..."
NSQ_SOURCE_LINE 00004442 "sub Default"
NSQ_SOURCE_LINE 00004443 "{"
NSQ_SOURCE_LINE 00004444 "    my ($expat, $str) = @_;"
NSQ_SOURCE_LINE 00004445 ""
NSQ_SOURCE_LINE 00004446 "#    shift; deb (\"Default\", @_);"
NSQ_SOURCE_LINE 00004447 ""
NSQ_SOURCE_LINE 00004448 "    if ($_DP_in_prolog)\t# still processing Document prolog..."
NSQ_SOURCE_LINE 00004449 "    {"
NSQ_SOURCE_LINE 00004450 "#?? could try to store this text later"
NSQ_SOURCE_LINE 00004451 "#?? I've only seen whitespace here so far"
NSQ_SOURCE_LINE 00004452 "    }"
NSQ_SOURCE_LINE 00004453 "    elsif (!$_DP_end_doc)\t# ignore whitespace at end of Document"
NSQ_SOURCE_LINE 00004454 "    {"
NSQ_SOURCE_LINE 00004455 "#\tif ($expat->{NoExpand})"
NSQ_SOURCE_LINE 00004456 "#\t{"
NSQ_SOURCE_LINE 00004457 "\t    # Got a TextDecl (<?xml ...?>) from an external entity here once"
NSQ_SOURCE_LINE 00004458 ""
NSQ_SOURCE_LINE 00004459 "\t    # create non-parameter entity reference, correct?"
NSQ_SOURCE_LINE 00004460 "            return unless $str =~ s!^&!!;"
NSQ_SOURCE_LINE 00004461 "            return unless $str =~ s!;$!!;"
NSQ_SOURCE_LINE 00004462 "\t    $_DP_elem->appendChild ("
NSQ_SOURCE_LINE 00004463 "\t\t   $_DP_doc->createEntityReference ($str,0,$expat->{NoExpand}));"
NSQ_SOURCE_LINE 00004464 "\t    undef $_DP_last_text;"
NSQ_SOURCE_LINE 00004465 "#\t}"
NSQ_SOURCE_LINE 00004466 "#\telse"
NSQ_SOURCE_LINE 00004467 "#\t{"
NSQ_SOURCE_LINE 00004468 "#\t    $expat->{DOM_Element}->addText ($str);"
NSQ_SOURCE_LINE 00004469 "#\t}"
NSQ_SOURCE_LINE 00004470 "    }"
NSQ_SOURCE_LINE 00004471 "}"
NSQ_SOURCE_LINE 00004472 ""
NSQ_SOURCE_LINE 00004473 "# XML::Parser 2.19 added support for CdataStart and CdataEnd handlers"
NSQ_SOURCE_LINE 00004474 "# If they are not defined, the Default handler is called instead"
NSQ_SOURCE_LINE 00004475 "# with the text \"<![CDATA[\" and \"]]\""
NSQ_SOURCE_LINE 00004476 "sub CdataStart"
NSQ_SOURCE_LINE 00004477 "{"
NSQ_SOURCE_LINE 00004478 "    $_DP_in_CDATA = 1;"
NSQ_SOURCE_LINE 00004479 "}"
NSQ_SOURCE_LINE 00004480 ""
NSQ_SOURCE_LINE 00004481 "sub CdataEnd"
NSQ_SOURCE_LINE 00004482 "{"
NSQ_SOURCE_LINE 00004483 "    $_DP_in_CDATA = 0;"
NSQ_SOURCE_LINE 00004484 "}"
NSQ_SOURCE_LINE 00004485 ""
NSQ_SOURCE_LINE 00004486 "my $START_MARKER = \"__DOM__START__ENTITY__\";"
NSQ_SOURCE_LINE 00004487 "my $END_MARKER = \"__DOM__END__ENTITY__\";"
NSQ_SOURCE_LINE 00004488 ""
NSQ_SOURCE_LINE 00004489 "sub Comment"
NSQ_SOURCE_LINE 00004490 "{"
NSQ_SOURCE_LINE 00004491 "    undef $_DP_last_text;"
NSQ_SOURCE_LINE 00004492 ""
NSQ_SOURCE_LINE 00004493 "    # These comments were inserted by ExternEnt handler"
NSQ_SOURCE_LINE 00004494 "    if ($_[1] =~ /(?:($START_MARKER)|($END_MARKER))/)"
NSQ_SOURCE_LINE 00004495 "    {"
NSQ_SOURCE_LINE 00004496 "\tif ($1)\t # START"
NSQ_SOURCE_LINE 00004497 "\t{"
NSQ_SOURCE_LINE 00004498 "\t    $_DP_level++;"
NSQ_SOURCE_LINE 00004499 "\t}"
NSQ_SOURCE_LINE 00004500 "\telse"
NSQ_SOURCE_LINE 00004501 "\t{"
NSQ_SOURCE_LINE 00004502 "\t    $_DP_level--;"
NSQ_SOURCE_LINE 00004503 "\t}"
NSQ_SOURCE_LINE 00004504 "    }"
NSQ_SOURCE_LINE 00004505 "    else"
NSQ_SOURCE_LINE 00004506 "    {"
NSQ_SOURCE_LINE 00004507 "\tmy $comment = $_DP_doc->createComment ($_[1]);"
NSQ_SOURCE_LINE 00004508 "\t$_DP_elem->appendChild ($comment);"
NSQ_SOURCE_LINE 00004509 "    }"
NSQ_SOURCE_LINE 00004510 "}"
NSQ_SOURCE_LINE 00004511 ""
NSQ_SOURCE_LINE 00004512 "sub deb"
NSQ_SOURCE_LINE 00004513 "{"
NSQ_SOURCE_LINE 00004514 "#    return;"
NSQ_SOURCE_LINE 00004515 ""
NSQ_SOURCE_LINE 00004516 "    my $name = shift;"
NSQ_SOURCE_LINE 00004517 "    print \"$name (\" . join(\",\", map {defined($_)?$_ : \"(undef)\"} @_) . \")\\n\";"
NSQ_SOURCE_LINE 00004518 "}"
NSQ_SOURCE_LINE 00004519 ""
NSQ_SOURCE_LINE 00004520 "sub Doctype"
NSQ_SOURCE_LINE 00004521 "{"
NSQ_SOURCE_LINE 00004522 "    my $expat = shift;"
NSQ_SOURCE_LINE 00004523 "#    deb (\"Doctype\", @_);"
NSQ_SOURCE_LINE 00004524 ""
NSQ_SOURCE_LINE 00004525 "    $_DP_doctype->setParams (@_);"
NSQ_SOURCE_LINE 00004526 "    $_DP_saw_doctype = 1;"
NSQ_SOURCE_LINE 00004527 "}"
NSQ_SOURCE_LINE 00004528 ""
NSQ_SOURCE_LINE 00004529 "sub Attlist"
NSQ_SOURCE_LINE 00004530 "{"
NSQ_SOURCE_LINE 00004531 "    my $expat = shift;"
NSQ_SOURCE_LINE 00004532 "#    deb (\"Attlist\", @_);"
NSQ_SOURCE_LINE 00004533 ""
NSQ_SOURCE_LINE 00004534 "    $_[5] = \"Hidden\" unless $_DP_expand_pent || $_DP_level == 0;"
NSQ_SOURCE_LINE 00004535 "    $_DP_doctype->addAttDef (@_);"
NSQ_SOURCE_LINE 00004536 "}"
NSQ_SOURCE_LINE 00004537 ""
NSQ_SOURCE_LINE 00004538 "sub XMLDecl"
NSQ_SOURCE_LINE 00004539 "{"
NSQ_SOURCE_LINE 00004540 "    my $expat = shift;"
NSQ_SOURCE_LINE 00004541 "#    deb (\"XMLDecl\", @_);"
NSQ_SOURCE_LINE 00004542 ""
NSQ_SOURCE_LINE 00004543 "    undef $_DP_last_text;"
NSQ_SOURCE_LINE 00004544 "    $_DP_doc->setXMLDecl (new XML::DOM::XMLDecl ($_DP_doc, @_));"
NSQ_SOURCE_LINE 00004545 "}"
NSQ_SOURCE_LINE 00004546 ""
NSQ_SOURCE_LINE 00004547 "sub Entity"
NSQ_SOURCE_LINE 00004548 "{"
NSQ_SOURCE_LINE 00004549 "    my $expat = shift;"
NSQ_SOURCE_LINE 00004550 "#    deb (\"Entity\", @_);"
NSQ_SOURCE_LINE 00004551 "    "
NSQ_SOURCE_LINE 00004552 "    # check to see if Parameter Entity"
NSQ_SOURCE_LINE 00004553 "    if ($_[5])"
NSQ_SOURCE_LINE 00004554 "    {"
NSQ_SOURCE_LINE 00004555 ""
NSQ_SOURCE_LINE 00004556 "\tif (defined $_[2])\t# was sysid specified?"
NSQ_SOURCE_LINE 00004557 "\t{"
NSQ_SOURCE_LINE 00004558 "\t    # Store the Entity mapping for use in ExternEnt"
NSQ_SOURCE_LINE 00004559 "\t    if (exists $expat->{DOM_Entity}->{$_[2]})"
NSQ_SOURCE_LINE 00004560 "\t    {"
NSQ_SOURCE_LINE 00004561 "\t\t# If this ever happens, the name of entity may be the wrong one"
NSQ_SOURCE_LINE 00004562 "\t\t# when writing out the Document."
NSQ_SOURCE_LINE 00004563 "\t\tXML::DOM::warning (\"Entity $_[2] is known as %$_[0] and %\" ."
NSQ_SOURCE_LINE 00004564 "\t\t\t\t   $expat->{DOM_Entity}->{$_[2]});"
NSQ_SOURCE_LINE 00004565 "\t    }"
NSQ_SOURCE_LINE 00004566 "\t    else"
NSQ_SOURCE_LINE 00004567 "\t    {"
NSQ_SOURCE_LINE 00004568 "\t\t$expat->{DOM_Entity}->{$_[2]} = $_[0];"
NSQ_SOURCE_LINE 00004569 "\t    }"
NSQ_SOURCE_LINE 00004570 "\t    #?? remove this block when XML::Parser has better support"
NSQ_SOURCE_LINE 00004571 "\t}"
NSQ_SOURCE_LINE 00004572 "    }"
NSQ_SOURCE_LINE 00004573 ""
NSQ_SOURCE_LINE 00004574 "    # no value on things with sysId"
NSQ_SOURCE_LINE 00004575 "    if (defined $_[2] && defined $_[1])"
NSQ_SOURCE_LINE 00004576 "    {"
NSQ_SOURCE_LINE 00004577 "        # print STDERR \"XML::DOM Warning $_[0] had both value($_[1]) And SYSId ($_[2]), removing value.\\n\";"
NSQ_SOURCE_LINE 00004578 "        $_[1] = undef;"
NSQ_SOURCE_LINE 00004579 "    }"
NSQ_SOURCE_LINE 00004580 ""
NSQ_SOURCE_LINE 00004581 "    undef $_DP_last_text;"
NSQ_SOURCE_LINE 00004582 ""
NSQ_SOURCE_LINE 00004583 "    $_[6] = \"Hidden\" unless $_DP_expand_pent || $_DP_level == 0;"
NSQ_SOURCE_LINE 00004584 "    $_DP_doctype->addEntity (@_);"
NSQ_SOURCE_LINE 00004585 "}"
NSQ_SOURCE_LINE 00004586 ""
NSQ_SOURCE_LINE 00004587 "#"
NSQ_SOURCE_LINE 00004588 "# Unparsed is called when it encounters e.g:"
NSQ_SOURCE_LINE 00004589 "#"
NSQ_SOURCE_LINE 00004590 "#   <!ENTITY logo SYSTEM \"http://server/logo.gif\" NDATA gif>"
NSQ_SOURCE_LINE 00004591 "#"
NSQ_SOURCE_LINE 00004592 "sub Unparsed"
NSQ_SOURCE_LINE 00004593 "{"
NSQ_SOURCE_LINE 00004594 "    Entity (@_);\t# same as regular ENTITY, as far as DOM is concerned"
NSQ_SOURCE_LINE 00004595 "}"
NSQ_SOURCE_LINE 00004596 ""
NSQ_SOURCE_LINE 00004597 "sub Element"
NSQ_SOURCE_LINE 00004598 "{"
NSQ_SOURCE_LINE 00004599 "    shift;"
NSQ_SOURCE_LINE 00004600 "#    deb (\"Element\", @_);"
NSQ_SOURCE_LINE 00004601 ""
NSQ_SOURCE_LINE 00004602 "    # put in to convert XML::Parser::ContentModel object to string"
NSQ_SOURCE_LINE 00004603 "    # ($_[1] used to be a string in XML::Parser 2.27 and"
NSQ_SOURCE_LINE 00004604 "    # dom_attr.t fails if we don't stringify here)"
NSQ_SOURCE_LINE 00004605 "    $_[1] = \"$_[1]\";"
NSQ_SOURCE_LINE 00004606 ""
NSQ_SOURCE_LINE 00004607 "    undef $_DP_last_text;"
NSQ_SOURCE_LINE 00004608 "    push @_, \"Hidden\" unless $_DP_expand_pent || $_DP_level == 0;"
NSQ_SOURCE_LINE 00004609 "    $_DP_doctype->addElementDecl (@_);"
NSQ_SOURCE_LINE 00004610 "}"
NSQ_SOURCE_LINE 00004611 ""
NSQ_SOURCE_LINE 00004612 "sub Notation"
NSQ_SOURCE_LINE 00004613 "{"
NSQ_SOURCE_LINE 00004614 "    shift;"
NSQ_SOURCE_LINE 00004615 "#    deb (\"Notation\", @_);"
NSQ_SOURCE_LINE 00004616 ""
NSQ_SOURCE_LINE 00004617 "    undef $_DP_last_text;"
NSQ_SOURCE_LINE 00004618 "    $_[4] = \"Hidden\" unless $_DP_expand_pent || $_DP_level == 0;"
NSQ_SOURCE_LINE 00004619 "    $_DP_doctype->addNotation (@_);"
NSQ_SOURCE_LINE 00004620 "}"
NSQ_SOURCE_LINE 00004621 ""
NSQ_SOURCE_LINE 00004622 "sub Proc"
NSQ_SOURCE_LINE 00004623 "{"
NSQ_SOURCE_LINE 00004624 "    shift;"
NSQ_SOURCE_LINE 00004625 "#    deb (\"Proc\", @_);"
NSQ_SOURCE_LINE 00004626 ""
NSQ_SOURCE_LINE 00004627 "    undef $_DP_last_text;"
NSQ_SOURCE_LINE 00004628 "    push @_, \"Hidden\" unless $_DP_expand_pent || $_DP_level == 0;"
NSQ_SOURCE_LINE 00004629 "    $_DP_elem->appendChild ($_DP_doc->createProcessingInstruction (@_));"
NSQ_SOURCE_LINE 00004630 "}"
NSQ_SOURCE_LINE 00004631 ""
NSQ_SOURCE_LINE 00004632 "#"
NSQ_SOURCE_LINE 00004633 "# ExternEnt is called when an external entity, such as:"
NSQ_SOURCE_LINE 00004634 "#"
NSQ_SOURCE_LINE 00004635 "#\t<!ENTITY externalEntity PUBLIC \"-//Enno//TEXT Enno's description//EN\" "
NSQ_SOURCE_LINE 00004636 "#\t                        \"http://server/descr.txt\">"
NSQ_SOURCE_LINE 00004637 "#"
NSQ_SOURCE_LINE 00004638 "# is referenced in the document, e.g. with: &externalEntity;"
NSQ_SOURCE_LINE 00004639 "# If ExternEnt is not specified, the entity reference is passed to the Default"
NSQ_SOURCE_LINE 00004640 "# handler as e.g. \"&externalEntity;\", where an EntityReference object is added."
NSQ_SOURCE_LINE 00004641 "#"
NSQ_SOURCE_LINE 00004642 "# Also for %externalEntity; references in the DTD itself."
NSQ_SOURCE_LINE 00004643 "#"
NSQ_SOURCE_LINE 00004644 "# It can also be called when XML::Parser parses the DOCTYPE header"
NSQ_SOURCE_LINE 00004645 "# (just before calling the DocType handler), when it contains a"
NSQ_SOURCE_LINE 00004646 "# reference like \"docbook.dtd\" below:"
NSQ_SOURCE_LINE 00004647 "#"
NSQ_SOURCE_LINE 00004648 "#    <!DOCTYPE book PUBLIC \"-//Norman Walsh//DTD DocBk XML V3.1.3//EN\" "
NSQ_SOURCE_LINE 00004649 "#\t\"docbook.dtd\" ["
NSQ_SOURCE_LINE 00004650 "#     ... rest of DTD ..."
NSQ_SOURCE_LINE 00004651 "#"
NSQ_SOURCE_LINE 00004652 "sub ExternEnt"
NSQ_SOURCE_LINE 00004653 "{"
NSQ_SOURCE_LINE 00004654 "    my ($expat, $base, $sysid, $pubid) = @_;"
NSQ_SOURCE_LINE 00004655 "#    deb (\"ExternEnt\", @_);"
NSQ_SOURCE_LINE 00004656 ""
NSQ_SOURCE_LINE 00004657 "    # ?? (tjmather) i think there is a problem here"
NSQ_SOURCE_LINE 00004658 "    # with XML::Parser > 2.27 since file_ext_ent_handler"
NSQ_SOURCE_LINE 00004659 "    # now returns a IO::File object instead of a content string"
NSQ_SOURCE_LINE 00004660 ""
NSQ_SOURCE_LINE 00004661 "    # Invoke XML::Parser's default ExternEnt handler"
NSQ_SOURCE_LINE 00004662 "    my $content;"
NSQ_SOURCE_LINE 00004663 "    if ($XML::Parser::have_LWP)"
NSQ_SOURCE_LINE 00004664 "    {"
NSQ_SOURCE_LINE 00004665 "\t$content = XML::Parser::lwp_ext_ent_handler (@_);"
NSQ_SOURCE_LINE 00004666 "    }"
NSQ_SOURCE_LINE 00004667 "    else"
NSQ_SOURCE_LINE 00004668 "    {"
NSQ_SOURCE_LINE 00004669 "\t$content = XML::Parser::file_ext_ent_handler (@_);"
NSQ_SOURCE_LINE 00004670 "    }"
NSQ_SOURCE_LINE 00004671 ""
NSQ_SOURCE_LINE 00004672 "    if ($_DP_expand_pent)"
NSQ_SOURCE_LINE 00004673 "    {"
NSQ_SOURCE_LINE 00004674 "\treturn $content;"
NSQ_SOURCE_LINE 00004675 "    }"
NSQ_SOURCE_LINE 00004676 "    else"
NSQ_SOURCE_LINE 00004677 "    {"
NSQ_SOURCE_LINE 00004678 "\tmy $entname = $expat->{DOM_Entity}->{$sysid};"
NSQ_SOURCE_LINE 00004679 "\tif (defined $entname)"
NSQ_SOURCE_LINE 00004680 "\t{"
NSQ_SOURCE_LINE 00004681 "\t    $_DP_doctype->appendChild ($_DP_doc->createEntityReference ($entname, 1, $expat->{NoExpand}));"
NSQ_SOURCE_LINE 00004682 "            # Wrap the contents in special comments, so we know when we reach the"
NSQ_SOURCE_LINE 00004683 "\t    # end of parsing the entity. This way we can omit the contents from"
NSQ_SOURCE_LINE 00004684 "\t    # the DTD, when ExpandParamEnt is set to 0."
NSQ_SOURCE_LINE 00004685 "     "
NSQ_SOURCE_LINE 00004686 "\t    return \"<!-- $START_MARKER sysid=[$sysid] -->\" ."
NSQ_SOURCE_LINE 00004687 "\t\t$content . \"<!-- $END_MARKER sysid=[$sysid] -->\";"
NSQ_SOURCE_LINE 00004688 "\t}"
NSQ_SOURCE_LINE 00004689 "\telse"
NSQ_SOURCE_LINE 00004690 "\t{"
NSQ_SOURCE_LINE 00004691 "\t    # We either read the entity ref'd by the system id in the "
NSQ_SOURCE_LINE 00004692 "\t    # <!DOCTYPE> header, or the entity was undefined."
NSQ_SOURCE_LINE 00004693 "\t    # In either case, don't bother with maintaining the entity"
NSQ_SOURCE_LINE 00004694 "\t    # reference, just expand the contents."
NSQ_SOURCE_LINE 00004695 "\t    return \"<!-- $START_MARKER sysid=[DTD] -->\" ."
NSQ_SOURCE_LINE 00004696 "\t\t$content . \"<!-- $END_MARKER sysid=[DTD] -->\";"
NSQ_SOURCE_LINE 00004697 "\t}"
NSQ_SOURCE_LINE 00004698 "    }"
NSQ_SOURCE_LINE 00004699 "}"
NSQ_SOURCE_LINE 00004700 ""
NSQ_SOURCE_LINE 00004701 "1; # module return code"
NSQ_SOURCE_LINE 00004702 ""
NSQ_SOURCE_LINE 00004703 "__END__"
NSQ_SOURCE_LINE 00004704 ""
NSQ_SOURCE_LINE 00004705 "=head1 NAME"
NSQ_SOURCE_LINE 00004706 ""
NSQ_SOURCE_LINE 00004707 "XML::DOM - A perl module for building DOM Level 1 compliant document structures"
NSQ_SOURCE_LINE 00004708 ""
NSQ_SOURCE_LINE 00004709 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00004710 ""
NSQ_SOURCE_LINE 00004711 " use XML::DOM;"
NSQ_SOURCE_LINE 00004712 ""
NSQ_SOURCE_LINE 00004713 " my $parser = new XML::DOM::Parser;"
NSQ_SOURCE_LINE 00004714 " my $doc = $parser->parsefile (\"file.xml\");"
NSQ_SOURCE_LINE 00004715 ""
NSQ_SOURCE_LINE 00004716 " # print all HREF attributes of all CODEBASE elements"
NSQ_SOURCE_LINE 00004717 " my $nodes = $doc->getElementsByTagName (\"CODEBASE\");"
NSQ_SOURCE_LINE 00004718 " my $n = $nodes->getLength;"
NSQ_SOURCE_LINE 00004719 ""
NSQ_SOURCE_LINE 00004720 " for (my $i = 0; $i < $n; $i++)"
NSQ_SOURCE_LINE 00004721 " {"
NSQ_SOURCE_LINE 00004722 "     my $node = $nodes->item ($i);"
NSQ_SOURCE_LINE 00004723 "     my $href = $node->getAttributeNode (\"HREF\");"
NSQ_SOURCE_LINE 00004724 "     print $href->getValue . \"\\n\";"
NSQ_SOURCE_LINE 00004725 " }"
NSQ_SOURCE_LINE 00004726 ""
NSQ_SOURCE_LINE 00004727 " # Print doc file"
NSQ_SOURCE_LINE 00004728 " $doc->printToFile (\"out.xml\");"
NSQ_SOURCE_LINE 00004729 ""
NSQ_SOURCE_LINE 00004730 " # Print to string"
NSQ_SOURCE_LINE 00004731 " print $doc->toString;"
NSQ_SOURCE_LINE 00004732 ""
NSQ_SOURCE_LINE 00004733 " # Avoid memory leaks - cleanup circular references for garbage collection"
NSQ_SOURCE_LINE 00004734 " $doc->dispose;"
NSQ_SOURCE_LINE 00004735 ""
NSQ_SOURCE_LINE 00004736 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00004737 ""
NSQ_SOURCE_LINE 00004738 "This module extends the XML::Parser module by Clark Cooper. "
NSQ_SOURCE_LINE 00004739 "The XML::Parser module is built on top of XML::Parser::Expat, "
NSQ_SOURCE_LINE 00004740 "which is a lower level interface to James Clark's expat library."
NSQ_SOURCE_LINE 00004741 ""
NSQ_SOURCE_LINE 00004742 "XML::DOM::Parser is derived from XML::Parser. It parses XML strings or files"
NSQ_SOURCE_LINE 00004743 "and builds a data structure that conforms to the API of the Document Object "
NSQ_SOURCE_LINE 00004744 "Model as described at http://www.w3.org/TR/REC-DOM-Level-1."
NSQ_SOURCE_LINE 00004745 "See the XML::Parser manpage for other available features of the "
NSQ_SOURCE_LINE 00004746 "XML::DOM::Parser class. "
NSQ_SOURCE_LINE 00004747 "Note that the 'Style' property should not be used (it is set internally.)"
NSQ_SOURCE_LINE 00004748 ""
NSQ_SOURCE_LINE 00004749 "The XML::Parser I<NoExpand> option is more or less supported, in that it will"
NSQ_SOURCE_LINE 00004750 "generate EntityReference objects whenever an entity reference is encountered"
NSQ_SOURCE_LINE 00004751 "in character data. I'm not sure how useful this is. Any comments are welcome."
NSQ_SOURCE_LINE 00004752 ""
NSQ_SOURCE_LINE 00004753 "As described in the synopsis, when you create an XML::DOM::Parser object, "
NSQ_SOURCE_LINE 00004754 "the parse and parsefile methods create an I<XML::DOM::Document> object"
NSQ_SOURCE_LINE 00004755 "from the specified input. This Document object can then be examined, modified and"
NSQ_SOURCE_LINE 00004756 "written back out to a file or converted to a string."
NSQ_SOURCE_LINE 00004757 ""
NSQ_SOURCE_LINE 00004758 "When using XML::DOM with XML::Parser version 2.19 and up, setting the "
NSQ_SOURCE_LINE 00004759 "XML::DOM::Parser option I<KeepCDATA> to 1 will store CDATASections in"
NSQ_SOURCE_LINE 00004760 "CDATASection nodes, instead of converting them to Text nodes."
NSQ_SOURCE_LINE 00004761 "Subsequent CDATASection nodes will be merged into one. Let me know if this"
NSQ_SOURCE_LINE 00004762 "is a problem."
NSQ_SOURCE_LINE 00004763 ""
NSQ_SOURCE_LINE 00004764 "When using XML::Parser 2.27 and above, you can suppress expansion of"
NSQ_SOURCE_LINE 00004765 "parameter entity references (e.g. %pent;) in the DTD, by setting I<ParseParamEnt>"
NSQ_SOURCE_LINE 00004766 "to 1 and I<ExpandParamEnt> to 0. See L<Hidden Nodes|/_Hidden_Nodes_> for details."
NSQ_SOURCE_LINE 00004767 ""
NSQ_SOURCE_LINE 00004768 "A Document has a tree structure consisting of I<Node> objects. A Node may contain"
NSQ_SOURCE_LINE 00004769 "other nodes, depending on its type."
NSQ_SOURCE_LINE 00004770 "A Document may have Element, Text, Comment, and CDATASection nodes. "
NSQ_SOURCE_LINE 00004771 "Element nodes may have Attr, Element, Text, Comment, and CDATASection nodes. "
NSQ_SOURCE_LINE 00004772 "The other nodes may not have any child nodes. "
NSQ_SOURCE_LINE 00004773 ""
NSQ_SOURCE_LINE 00004774 "This module adds several node types that are not part of the DOM spec (yet.)"
NSQ_SOURCE_LINE 00004775 "These are: ElementDecl (for <!ELEMENT ...> declarations), AttlistDecl (for"
NSQ_SOURCE_LINE 00004776 "<!ATTLIST ...> declarations), XMLDecl (for <?xml ...?> declarations) and AttDef"
NSQ_SOURCE_LINE 00004777 "(for attribute definitions in an AttlistDecl.)"
NSQ_SOURCE_LINE 00004778 ""
NSQ_SOURCE_LINE 00004779 "=head1 XML::DOM Classes"
NSQ_SOURCE_LINE 00004780 ""
NSQ_SOURCE_LINE 00004781 "The XML::DOM module stores XML documents in a tree structure with a root node"
NSQ_SOURCE_LINE 00004782 "of type XML::DOM::Document. Different nodes in tree represent different"
NSQ_SOURCE_LINE 00004783 "parts of the XML file. The DOM Level 1 Specification defines the following"
NSQ_SOURCE_LINE 00004784 "node types:"
NSQ_SOURCE_LINE 00004785 ""
NSQ_SOURCE_LINE 00004786 "=over 4"
NSQ_SOURCE_LINE 00004787 ""
NSQ_SOURCE_LINE 00004788 "=item * L<XML::DOM::Node> - Super class of all node types"
NSQ_SOURCE_LINE 00004789 ""
NSQ_SOURCE_LINE 00004790 "=item * L<XML::DOM::Document> - The root of the XML document"
NSQ_SOURCE_LINE 00004791 ""
NSQ_SOURCE_LINE 00004792 "=item * L<XML::DOM::DocumentType> - Describes the document structure: <!DOCTYPE root [ ... ]>"
NSQ_SOURCE_LINE 00004793 ""
NSQ_SOURCE_LINE 00004794 "=item * L<XML::DOM::Element> - An XML element: <elem attr=\"val\"> ... </elem>"
NSQ_SOURCE_LINE 00004795 ""
NSQ_SOURCE_LINE 00004796 "=item * L<XML::DOM::Attr> - An XML element attribute: name=\"value\""
NSQ_SOURCE_LINE 00004797 ""
NSQ_SOURCE_LINE 00004798 "=item * L<XML::DOM::CharacterData> - Super class of Text, Comment and CDATASection"
NSQ_SOURCE_LINE 00004799 ""
NSQ_SOURCE_LINE 00004800 "=item * L<XML::DOM::Text> - Text in an XML element"
NSQ_SOURCE_LINE 00004801 ""
NSQ_SOURCE_LINE 00004802 "=item * L<XML::DOM::CDATASection> - Escaped block of text: <![CDATA[ text ]]>"
NSQ_SOURCE_LINE 00004803 ""
NSQ_SOURCE_LINE 00004804 "=item * L<XML::DOM::Comment> - An XML comment: <!-- comment -->"
NSQ_SOURCE_LINE 00004805 ""
NSQ_SOURCE_LINE 00004806 "=item * L<XML::DOM::EntityReference> - Refers to an ENTITY: &ent; or %ent;"
NSQ_SOURCE_LINE 00004807 ""
NSQ_SOURCE_LINE 00004808 "=item * L<XML::DOM::Entity> - An ENTITY definition: <!ENTITY ...>"
NSQ_SOURCE_LINE 00004809 ""
NSQ_SOURCE_LINE 00004810 "=item * L<XML::DOM::ProcessingInstruction> - <?PI target>"
NSQ_SOURCE_LINE 00004811 ""
NSQ_SOURCE_LINE 00004812 "=item * L<XML::DOM::DocumentFragment> - Lightweight node for cut & paste"
NSQ_SOURCE_LINE 00004813 ""
NSQ_SOURCE_LINE 00004814 "=item * L<XML::DOM::Notation> - An NOTATION definition: <!NOTATION ...>"
NSQ_SOURCE_LINE 00004815 ""
NSQ_SOURCE_LINE 00004816 "=back"
NSQ_SOURCE_LINE 00004817 ""
NSQ_SOURCE_LINE 00004818 "In addition, the XML::DOM module contains the following nodes that are not part "
NSQ_SOURCE_LINE 00004819 "of the DOM Level 1 Specification:"
NSQ_SOURCE_LINE 00004820 ""
NSQ_SOURCE_LINE 00004821 "=over 4"
NSQ_SOURCE_LINE 00004822 ""
NSQ_SOURCE_LINE 00004823 "=item * L<XML::DOM::ElementDecl> - Defines an element: <!ELEMENT ...>"
NSQ_SOURCE_LINE 00004824 ""
NSQ_SOURCE_LINE 00004825 "=item * L<XML::DOM::AttlistDecl> - Defines one or more attributes in an <!ATTLIST ...>"
NSQ_SOURCE_LINE 00004826 ""
NSQ_SOURCE_LINE 00004827 "=item * L<XML::DOM::AttDef> - Defines one attribute in an <!ATTLIST ...>"
NSQ_SOURCE_LINE 00004828 ""
NSQ_SOURCE_LINE 00004829 "=item * L<XML::DOM::XMLDecl> - An XML declaration: <?xml version=\"1.0\" ...>"
NSQ_SOURCE_LINE 00004830 ""
NSQ_SOURCE_LINE 00004831 "=back"
NSQ_SOURCE_LINE 00004832 ""
NSQ_SOURCE_LINE 00004833 "Other classes that are part of the DOM Level 1 Spec:"
NSQ_SOURCE_LINE 00004834 ""
NSQ_SOURCE_LINE 00004835 "=over 4"
NSQ_SOURCE_LINE 00004836 ""
NSQ_SOURCE_LINE 00004837 "=item * L<XML::DOM::Implementation> - Provides information about this implementation. Currently it doesn't do much."
NSQ_SOURCE_LINE 00004838 ""
NSQ_SOURCE_LINE 00004839 "=item * L<XML::DOM::NodeList> - Used internally to store a node's child nodes. Also returned by getElementsByTagName."
NSQ_SOURCE_LINE 00004840 ""
NSQ_SOURCE_LINE 00004841 "=item * L<XML::DOM::NamedNodeMap> - Used internally to store an element's attributes."
NSQ_SOURCE_LINE 00004842 ""
NSQ_SOURCE_LINE 00004843 "=back"
NSQ_SOURCE_LINE 00004844 ""
NSQ_SOURCE_LINE 00004845 "Other classes that are not part of the DOM Level 1 Spec:"
NSQ_SOURCE_LINE 00004846 ""
NSQ_SOURCE_LINE 00004847 "=over 4"
NSQ_SOURCE_LINE 00004848 ""
NSQ_SOURCE_LINE 00004849 "=item * L<XML::DOM::Parser> - An non-validating XML parser that creates XML::DOM::Documents"
NSQ_SOURCE_LINE 00004850 ""
NSQ_SOURCE_LINE 00004851 "=item * L<XML::DOM::ValParser> - A validating XML parser that creates XML::DOM::Documents. It uses L<XML::Checker> to check against the DocumentType (DTD)"
NSQ_SOURCE_LINE 00004852 ""
NSQ_SOURCE_LINE 00004853 "=item * L<XML::Handler::BuildDOM> - A PerlSAX handler that creates XML::DOM::Documents."
NSQ_SOURCE_LINE 00004854 ""
NSQ_SOURCE_LINE 00004855 "=back"
NSQ_SOURCE_LINE 00004856 ""
NSQ_SOURCE_LINE 00004857 "=head1 XML::DOM package"
NSQ_SOURCE_LINE 00004858 ""
NSQ_SOURCE_LINE 00004859 "=over 4"
NSQ_SOURCE_LINE 00004860 ""
NSQ_SOURCE_LINE 00004861 "=item Constant definitions"
NSQ_SOURCE_LINE 00004862 ""
NSQ_SOURCE_LINE 00004863 "The following predefined constants indicate which type of node it is."
NSQ_SOURCE_LINE 00004864 ""
NSQ_SOURCE_LINE 00004865 "=back"
NSQ_SOURCE_LINE 00004866 ""
NSQ_SOURCE_LINE 00004867 " UNKNOWN_NODE (0)                The node type is unknown (not part of DOM)"
NSQ_SOURCE_LINE 00004868 ""
NSQ_SOURCE_LINE 00004869 " ELEMENT_NODE (1)                The node is an Element."
NSQ_SOURCE_LINE 00004870 " ATTRIBUTE_NODE (2)              The node is an Attr."
NSQ_SOURCE_LINE 00004871 " TEXT_NODE (3)                   The node is a Text node."
NSQ_SOURCE_LINE 00004872 " CDATA_SECTION_NODE (4)          The node is a CDATASection."
NSQ_SOURCE_LINE 00004873 " ENTITY_REFERENCE_NODE (5)       The node is an EntityReference."
NSQ_SOURCE_LINE 00004874 " ENTITY_NODE (6)                 The node is an Entity."
NSQ_SOURCE_LINE 00004875 " PROCESSING_INSTRUCTION_NODE (7) The node is a ProcessingInstruction."
NSQ_SOURCE_LINE 00004876 " COMMENT_NODE (8)                The node is a Comment."
NSQ_SOURCE_LINE 00004877 " DOCUMENT_NODE (9)               The node is a Document."
NSQ_SOURCE_LINE 00004878 " DOCUMENT_TYPE_NODE (10)         The node is a DocumentType."
NSQ_SOURCE_LINE 00004879 " DOCUMENT_FRAGMENT_NODE (11)     The node is a DocumentFragment."
NSQ_SOURCE_LINE 00004880 " NOTATION_NODE (12)              The node is a Notation."
NSQ_SOURCE_LINE 00004881 ""
NSQ_SOURCE_LINE 00004882 " ELEMENT_DECL_NODE (13)\t\t The node is an ElementDecl (not part of DOM)"
NSQ_SOURCE_LINE 00004883 " ATT_DEF_NODE (14)\t\t The node is an AttDef (not part of DOM)"
NSQ_SOURCE_LINE 00004884 " XML_DECL_NODE (15)\t\t The node is an XMLDecl (not part of DOM)"
NSQ_SOURCE_LINE 00004885 " ATTLIST_DECL_NODE (16)\t\t The node is an AttlistDecl (not part of DOM)"
NSQ_SOURCE_LINE 00004886 ""
NSQ_SOURCE_LINE 00004887 " Usage:"
NSQ_SOURCE_LINE 00004888 ""
NSQ_SOURCE_LINE 00004889 "   if ($node->getNodeType == ELEMENT_NODE)"
NSQ_SOURCE_LINE 00004890 "   {"
NSQ_SOURCE_LINE 00004891 "       print \"It's an Element\";"
NSQ_SOURCE_LINE 00004892 "   }"
NSQ_SOURCE_LINE 00004893 ""
NSQ_SOURCE_LINE 00004894 "B<Not In DOM Spec>: The DOM Spec does not mention UNKNOWN_NODE and, "
NSQ_SOURCE_LINE 00004895 "quite frankly, you should never encounter it. The last 4 node types were added"
NSQ_SOURCE_LINE 00004896 "to support the 4 added node classes."
NSQ_SOURCE_LINE 00004897 ""
NSQ_SOURCE_LINE 00004898 "=head2 Global Variables"
NSQ_SOURCE_LINE 00004899 ""
NSQ_SOURCE_LINE 00004900 "=over 4"
NSQ_SOURCE_LINE 00004901 ""
NSQ_SOURCE_LINE 00004902 "=item $VERSION"
NSQ_SOURCE_LINE 00004903 ""
NSQ_SOURCE_LINE 00004904 "The variable $XML::DOM::VERSION contains the version number of this "
NSQ_SOURCE_LINE 00004905 "implementation, e.g. \"1.43\"."
NSQ_SOURCE_LINE 00004906 ""
NSQ_SOURCE_LINE 00004907 "=back"
NSQ_SOURCE_LINE 00004908 ""
NSQ_SOURCE_LINE 00004909 "=head2 METHODS"
NSQ_SOURCE_LINE 00004910 ""
NSQ_SOURCE_LINE 00004911 "These methods are not part of the DOM Level 1 Specification."
NSQ_SOURCE_LINE 00004912 ""
NSQ_SOURCE_LINE 00004913 "=over 4"
NSQ_SOURCE_LINE 00004914 ""
NSQ_SOURCE_LINE 00004915 "=item getIgnoreReadOnly and ignoreReadOnly (readOnly)"
NSQ_SOURCE_LINE 00004916 ""
NSQ_SOURCE_LINE 00004917 "The DOM Level 1 Spec does not allow you to edit certain sections of the document,"
NSQ_SOURCE_LINE 00004918 "e.g. the DocumentType, so by default this implementation throws DOMExceptions"
NSQ_SOURCE_LINE 00004919 "(i.e. NO_MODIFICATION_ALLOWED_ERR) when you try to edit a readonly node. "
NSQ_SOURCE_LINE 00004920 "These readonly checks can be disabled by (temporarily) setting the global "
NSQ_SOURCE_LINE 00004921 "IgnoreReadOnly flag."
NSQ_SOURCE_LINE 00004922 ""
NSQ_SOURCE_LINE 00004923 "The ignoreReadOnly method sets the global IgnoreReadOnly flag and returns its"
NSQ_SOURCE_LINE 00004924 "previous value. The getIgnoreReadOnly method simply returns its current value."
NSQ_SOURCE_LINE 00004925 ""
NSQ_SOURCE_LINE 00004926 " my $oldIgnore = XML::DOM::ignoreReadOnly (1);"
NSQ_SOURCE_LINE 00004927 " eval {"
NSQ_SOURCE_LINE 00004928 " ... do whatever you want, catching any other exceptions ..."
NSQ_SOURCE_LINE 00004929 " };"
NSQ_SOURCE_LINE 00004930 " XML::DOM::ignoreReadOnly ($oldIgnore);     # restore previous value"
NSQ_SOURCE_LINE 00004931 ""
NSQ_SOURCE_LINE 00004932 "Another way to do it, using a local variable:"
NSQ_SOURCE_LINE 00004933 ""
NSQ_SOURCE_LINE 00004934 " { # start new scope"
NSQ_SOURCE_LINE 00004935 "    local $XML::DOM::IgnoreReadOnly = 1;"
NSQ_SOURCE_LINE 00004936 "    ... do whatever you want, don't worry about exceptions ..."
NSQ_SOURCE_LINE 00004937 " } # end of scope ($IgnoreReadOnly is set back to its previous value)"
NSQ_SOURCE_LINE 00004938 "    "
NSQ_SOURCE_LINE 00004939 ""
NSQ_SOURCE_LINE 00004940 "=item isValidName (name)"
NSQ_SOURCE_LINE 00004941 ""
NSQ_SOURCE_LINE 00004942 "Whether the specified name is a valid \"Name\" as specified in the XML spec."
NSQ_SOURCE_LINE 00004943 "Characters with Unicode values > 127 are now also supported."
NSQ_SOURCE_LINE 00004944 ""
NSQ_SOURCE_LINE 00004945 "=item getAllowReservedNames and allowReservedNames (boolean)"
NSQ_SOURCE_LINE 00004946 ""
NSQ_SOURCE_LINE 00004947 "The first method returns whether reserved names are allowed. "
NSQ_SOURCE_LINE 00004948 "The second takes a boolean argument and sets whether reserved names are allowed."
NSQ_SOURCE_LINE 00004949 "The initial value is 1 (i.e. allow reserved names.)"
NSQ_SOURCE_LINE 00004950 ""
NSQ_SOURCE_LINE 00004951 "The XML spec states that \"Names\" starting with (X|x)(M|m)(L|l)"
NSQ_SOURCE_LINE 00004952 "are reserved for future use. (Amusingly enough, the XML version of the XML spec"
NSQ_SOURCE_LINE 00004953 "(REC-xml-19980210.xml) breaks that very rule by defining an ENTITY with the name "
NSQ_SOURCE_LINE 00004954 "'xmlpio'.)"
NSQ_SOURCE_LINE 00004955 "A \"Name\" in this context means the Name token as found in the BNF rules in the"
NSQ_SOURCE_LINE 00004956 "XML spec."
NSQ_SOURCE_LINE 00004957 ""
NSQ_SOURCE_LINE 00004958 "XML::DOM only checks for errors when you modify the DOM tree, not when the"
NSQ_SOURCE_LINE 00004959 "DOM tree is built by the XML::DOM::Parser."
NSQ_SOURCE_LINE 00004960 ""
NSQ_SOURCE_LINE 00004961 "=item setTagCompression (funcref)"
NSQ_SOURCE_LINE 00004962 ""
NSQ_SOURCE_LINE 00004963 "There are 3 possible styles for printing empty Element tags:"
NSQ_SOURCE_LINE 00004964 ""
NSQ_SOURCE_LINE 00004965 "=over 4"
NSQ_SOURCE_LINE 00004966 ""
NSQ_SOURCE_LINE 00004967 "=item Style 0"
NSQ_SOURCE_LINE 00004968 ""
NSQ_SOURCE_LINE 00004969 " <empty/> or <empty attr=\"val\"/>"
NSQ_SOURCE_LINE 00004970 ""
NSQ_SOURCE_LINE 00004971 "XML::DOM uses this style by default for all Elements."
NSQ_SOURCE_LINE 00004972 ""
NSQ_SOURCE_LINE 00004973 "=item Style 1"
NSQ_SOURCE_LINE 00004974 ""
NSQ_SOURCE_LINE 00004975 "  <empty></empty> or <empty attr=\"val\"></empty>"
NSQ_SOURCE_LINE 00004976 ""
NSQ_SOURCE_LINE 00004977 "=item Style 2"
NSQ_SOURCE_LINE 00004978 ""
NSQ_SOURCE_LINE 00004979 "  <empty /> or <empty attr=\"val\" />"
NSQ_SOURCE_LINE 00004980 ""
NSQ_SOURCE_LINE 00004981 "This style is sometimes desired when using XHTML. "
NSQ_SOURCE_LINE 00004982 "(Note the extra space before the slash \"/\")"
NSQ_SOURCE_LINE 00004983 "See L<http://www.w3.org/TR/xhtml1> Appendix C for more details."
NSQ_SOURCE_LINE 00004984 ""
NSQ_SOURCE_LINE 00004985 "=back"
NSQ_SOURCE_LINE 00004986 ""
NSQ_SOURCE_LINE 00004987 "By default XML::DOM compresses all empty Element tags (style 0.)"
NSQ_SOURCE_LINE 00004988 "You can control which style is used for a particular Element by calling"
NSQ_SOURCE_LINE 00004989 "XML::DOM::setTagCompression with a reference to a function that takes"
NSQ_SOURCE_LINE 00004990 "2 arguments. The first is the tag name of the Element, the second is the"
NSQ_SOURCE_LINE 00004991 "XML::DOM::Element that is being printed. "
NSQ_SOURCE_LINE 00004992 "The function should return 0, 1 or 2 to indicate which style should be used to"
NSQ_SOURCE_LINE 00004993 "print the empty tag. E.g."
NSQ_SOURCE_LINE 00004994 ""
NSQ_SOURCE_LINE 00004995 " XML::DOM::setTagCompression (\\&my_tag_compression);"
NSQ_SOURCE_LINE 00004996 ""
NSQ_SOURCE_LINE 00004997 " sub my_tag_compression"
NSQ_SOURCE_LINE 00004998 " {"
NSQ_SOURCE_LINE 00004999 "    my ($tag, $elem) = @_;"
NSQ_SOURCE_LINE 00005000 ""
NSQ_SOURCE_LINE 00005001 "    # Print empty br, hr and img tags like this: <br />"
NSQ_SOURCE_LINE 00005002 "    return 2 if $tag =~ /^(br|hr|img)$/;"
NSQ_SOURCE_LINE 00005003 ""
NSQ_SOURCE_LINE 00005004 "    # Print other empty tags like this: <empty></empty>"
NSQ_SOURCE_LINE 00005005 "    return 1;"
NSQ_SOURCE_LINE 00005006 " }"
NSQ_SOURCE_LINE 00005007 ""
NSQ_SOURCE_LINE 00005008 "=back"
NSQ_SOURCE_LINE 00005009 ""
NSQ_SOURCE_LINE 00005010 "=head1 IMPLEMENTATION DETAILS"
NSQ_SOURCE_LINE 00005011 ""
NSQ_SOURCE_LINE 00005012 "=over 4"
NSQ_SOURCE_LINE 00005013 ""
NSQ_SOURCE_LINE 00005014 "=item * Perl Mappings"
NSQ_SOURCE_LINE 00005015 ""
NSQ_SOURCE_LINE 00005016 "The value undef was used when the DOM Spec said null."
NSQ_SOURCE_LINE 00005017 ""
NSQ_SOURCE_LINE 00005018 "The DOM Spec says: Applications must encode DOMString using UTF-16 (defined in "
NSQ_SOURCE_LINE 00005019 "Appendix C.3 of [UNICODE] and Amendment 1 of [ISO-10646])."
NSQ_SOURCE_LINE 00005020 "In this implementation we use plain old Perl strings encoded in UTF-8 instead of"
NSQ_SOURCE_LINE 00005021 "UTF-16."
NSQ_SOURCE_LINE 00005022 ""
NSQ_SOURCE_LINE 00005023 "=item * Text and CDATASection nodes"
NSQ_SOURCE_LINE 00005024 ""
NSQ_SOURCE_LINE 00005025 "The Expat parser expands EntityReferences and CDataSection sections to "
NSQ_SOURCE_LINE 00005026 "raw strings and does not indicate where it was found. "
NSQ_SOURCE_LINE 00005027 "This implementation does therefore convert both to Text nodes at parse time."
NSQ_SOURCE_LINE 00005028 "CDATASection and EntityReference nodes that are added to an existing Document "
NSQ_SOURCE_LINE 00005029 "(by the user) will be preserved."
NSQ_SOURCE_LINE 00005030 ""
NSQ_SOURCE_LINE 00005031 "Also, subsequent Text nodes are always merged at parse time. Text nodes that are "
NSQ_SOURCE_LINE 00005032 "added later can be merged with the normalize method. Consider using the addText"
NSQ_SOURCE_LINE 00005033 "method when adding Text nodes."
NSQ_SOURCE_LINE 00005034 ""
NSQ_SOURCE_LINE 00005035 "=item * Printing and toString"
NSQ_SOURCE_LINE 00005036 ""
NSQ_SOURCE_LINE 00005037 "When printing (and converting an XML Document to a string) the strings have to "
NSQ_SOURCE_LINE 00005038 "encoded differently depending on where they occur. E.g. in a CDATASection all "
NSQ_SOURCE_LINE 00005039 "substrings are allowed except for \"]]>\". In regular text, certain characters are"
NSQ_SOURCE_LINE 00005040 "not allowed, e.g. \">\" has to be converted to \"&gt;\". "
NSQ_SOURCE_LINE 00005041 "These routines should be verified by someone who knows the details."
NSQ_SOURCE_LINE 00005042 ""
NSQ_SOURCE_LINE 00005043 "=item * Quotes"
NSQ_SOURCE_LINE 00005044 ""
NSQ_SOURCE_LINE 00005045 "Certain sections in XML are quoted, like attribute values in an Element."
NSQ_SOURCE_LINE 00005046 "XML::Parser strips these quotes and the print methods in this implementation "
NSQ_SOURCE_LINE 00005047 "always uses double quotes, so when parsing and printing a document, single quotes"
NSQ_SOURCE_LINE 00005048 "may be converted to double quotes. The default value of an attribute definition"
NSQ_SOURCE_LINE 00005049 "(AttDef) in an AttlistDecl, however, will maintain its quotes."
NSQ_SOURCE_LINE 00005050 ""
NSQ_SOURCE_LINE 00005051 "=item * AttlistDecl"
NSQ_SOURCE_LINE 00005052 ""
NSQ_SOURCE_LINE 00005053 "Attribute declarations for a certain Element are always merged into a single"
NSQ_SOURCE_LINE 00005054 "AttlistDecl object."
NSQ_SOURCE_LINE 00005055 ""
NSQ_SOURCE_LINE 00005056 "=item * Comments"
NSQ_SOURCE_LINE 00005057 ""
NSQ_SOURCE_LINE 00005058 "Comments in the DOCTYPE section are not kept in the right place. They will become"
NSQ_SOURCE_LINE 00005059 "child nodes of the Document."
NSQ_SOURCE_LINE 00005060 ""
NSQ_SOURCE_LINE 00005061 "=item * Hidden Nodes"
NSQ_SOURCE_LINE 00005062 ""
NSQ_SOURCE_LINE 00005063 "Previous versions of XML::DOM would expand parameter entity references"
NSQ_SOURCE_LINE 00005064 "(like B<%pent;>), so when printing the DTD, it would print the contents"
NSQ_SOURCE_LINE 00005065 "of the external entity, instead of the parameter entity reference."
NSQ_SOURCE_LINE 00005066 "With this release (1.27), you can prevent this by setting the XML::DOM::Parser"
NSQ_SOURCE_LINE 00005067 "options ParseParamEnt => 1 and ExpandParamEnt => 0."
NSQ_SOURCE_LINE 00005068 ""
NSQ_SOURCE_LINE 00005069 "When it is parsing the contents of the external entities, it *DOES* still add"
NSQ_SOURCE_LINE 00005070 "the nodes to the DocumentType, but it marks these nodes by setting"
NSQ_SOURCE_LINE 00005071 "the 'Hidden' property. In addition, it adds an EntityReference node to the"
NSQ_SOURCE_LINE 00005072 "DocumentType node."
NSQ_SOURCE_LINE 00005073 ""
NSQ_SOURCE_LINE 00005074 "When printing the DocumentType node (or when using to_expat() or to_sax()), "
NSQ_SOURCE_LINE 00005075 "the 'Hidden' nodes are suppressed, so you will see the parameter entity"
NSQ_SOURCE_LINE 00005076 "reference instead of the contents of the external entities. See test case"
NSQ_SOURCE_LINE 00005077 "t/dom_extent.t for an example."
NSQ_SOURCE_LINE 00005078 ""
NSQ_SOURCE_LINE 00005079 "The reason for adding the 'Hidden' nodes to the DocumentType node, is that"
NSQ_SOURCE_LINE 00005080 "the nodes may contain <!ENTITY> definitions that are referenced further"
NSQ_SOURCE_LINE 00005081 "in the document. (Simply not adding the nodes to the DocumentType could"
NSQ_SOURCE_LINE 00005082 "cause such entity references to be expanded incorrectly.)"
NSQ_SOURCE_LINE 00005083 ""
NSQ_SOURCE_LINE 00005084 "Note that you need XML::Parser 2.27 or higher for this to work correctly."
NSQ_SOURCE_LINE 00005085 ""
NSQ_SOURCE_LINE 00005086 "=back"
NSQ_SOURCE_LINE 00005087 ""
NSQ_SOURCE_LINE 00005088 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00005089 ""
NSQ_SOURCE_LINE 00005090 "L<XML::DOM::XPath>"
NSQ_SOURCE_LINE 00005091 ""
NSQ_SOURCE_LINE 00005092 "The Japanese version of this document by Takanori Kawai (Hippo2000)"
NSQ_SOURCE_LINE 00005093 "at L<http://member.nifty.ne.jp/hippo2000/perltips/xml/dom.htm>"
NSQ_SOURCE_LINE 00005094 ""
NSQ_SOURCE_LINE 00005095 "The DOM Level 1 specification at L<http://www.w3.org/TR/REC-DOM-Level-1>"
NSQ_SOURCE_LINE 00005096 ""
NSQ_SOURCE_LINE 00005097 "The XML spec (Extensible Markup Language 1.0) at L<http://www.w3.org/TR/REC-xml>"
NSQ_SOURCE_LINE 00005098 ""
NSQ_SOURCE_LINE 00005099 "The L<XML::Parser> and L<XML::Parser::Expat> manual pages."
NSQ_SOURCE_LINE 00005100 ""
NSQ_SOURCE_LINE 00005101 "L<XML::LibXML> also provides a DOM Parser, and is significantly faster"
NSQ_SOURCE_LINE 00005102 "than XML::DOM, and is under active development.  It requires that you "
NSQ_SOURCE_LINE 00005103 "download the Gnome libxml library."
NSQ_SOURCE_LINE 00005104 ""
NSQ_SOURCE_LINE 00005105 "L<XML::GDOME> will provide the DOM Level 2 Core API, and should be"
NSQ_SOURCE_LINE 00005106 "as fast as XML::LibXML, but more robust, since it uses the memory"
NSQ_SOURCE_LINE 00005107 "management functions of libgdome.  For more details see"
NSQ_SOURCE_LINE 00005108 "L<http://tjmather.com/xml-gdome/>"
NSQ_SOURCE_LINE 00005109 ""
NSQ_SOURCE_LINE 00005110 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00005111 ""
NSQ_SOURCE_LINE 00005112 "The method getElementsByTagName() does not return a \"live\" NodeList."
NSQ_SOURCE_LINE 00005113 "Whether this is an actual caveat is debatable, but a few people on the "
NSQ_SOURCE_LINE 00005114 "www-dom mailing list seemed to think so. I haven't decided yet. It's a pain"
NSQ_SOURCE_LINE 00005115 "to implement, it slows things down and the benefits seem marginal."
NSQ_SOURCE_LINE 00005116 "Let me know what you think. "
NSQ_SOURCE_LINE 00005117 ""
NSQ_SOURCE_LINE 00005118 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00005119 ""
NSQ_SOURCE_LINE 00005120 "Enno Derksen is the original author."
NSQ_SOURCE_LINE 00005121 ""
NSQ_SOURCE_LINE 00005122 "Send patches to T.J. Mather at <F<tjmather@maxmind.com>>."
NSQ_SOURCE_LINE 00005123 ""
