NSQ_SOURCE_LINE 00000907 "#"
NSQ_SOURCE_LINE 00000908 "# Return all Element nodes in the subtree that have the specified tagName."
NSQ_SOURCE_LINE 00000909 "# If tagName is \"*\", all Element nodes are returned."
NSQ_SOURCE_LINE 00000910 "# NOTE: the DOM Spec does not specify a 3rd or 4th parameter"
NSQ_SOURCE_LINE 00000911 "#"
NSQ_SOURCE_LINE 00000912 "sub getElementsByTagName"
NSQ_SOURCE_LINE 00000913 "{"
NSQ_SOURCE_LINE 00000914 "    my ($self, $tagName, $recurse, $list) = @_;"
NSQ_SOURCE_LINE 00000915 "    $recurse = 1 unless defined $recurse;"
NSQ_SOURCE_LINE 00000916 "    $list = (wantarray ? [] : new XML::DOM::NodeList) unless defined $list;"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "    return unless defined $self->[_C];"
NSQ_SOURCE_LINE 00000919 ""
NSQ_SOURCE_LINE 00000920 "    # preorder traversal: check parent node first"
NSQ_SOURCE_LINE 00000921 "    for my $kid (@{$self->[_C]})"
NSQ_SOURCE_LINE 00000922 "    {"
NSQ_SOURCE_LINE 00000923 "\tif ($kid->isElementNode)"
NSQ_SOURCE_LINE 00000924 "\t{"
NSQ_SOURCE_LINE 00000925 "\t    if ($tagName eq \"*\" || $tagName eq $kid->getTagName)"
NSQ_SOURCE_LINE 00000926 "\t    {"
NSQ_SOURCE_LINE 00000927 "\t\tpush @{$list}, $kid;"
NSQ_SOURCE_LINE 00000928 "\t    }"
NSQ_SOURCE_LINE 00000929 "\t    $kid->getElementsByTagName ($tagName, $recurse, $list) if $recurse;"
NSQ_SOURCE_LINE 00000930 "\t}"
NSQ_SOURCE_LINE 00000931 "    }"
NSQ_SOURCE_LINE 00000932 "    wantarray ? @{ $list } : $list;"
NSQ_SOURCE_LINE 00000933 "}"
