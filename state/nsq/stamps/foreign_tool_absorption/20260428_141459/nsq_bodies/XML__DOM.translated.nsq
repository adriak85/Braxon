NSQ_SOURCE_LINE 00002780 "\t}"
NSQ_SOURCE_LINE 00002781 "    }"
NSQ_SOURCE_LINE 00002782 ""
NSQ_SOURCE_LINE 00002783 "    $iter->EndAttr;"
NSQ_SOURCE_LINE 00002784 ""
NSQ_SOURCE_LINE 00002785 "    for my $kid ($self->getChildNodes)"
NSQ_SOURCE_LINE 00002786 "    {"
NSQ_SOURCE_LINE 00002787 "\t$kid->to_expat ($iter);"
NSQ_SOURCE_LINE 00002788 "    }"
NSQ_SOURCE_LINE 00002789 ""
NSQ_SOURCE_LINE 00002790 "    $iter->End;"
