NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "sub insertBefore"
NSQ_SOURCE_LINE 00000735 "{"
NSQ_SOURCE_LINE 00000736 "    my ($self, $node, $refNode) = @_;"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "    return $self->appendChild ($node) unless $refNode;\t# append at the end"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "    croak new XML::DOM::DOMException (NO_MODIFICATION_ALLOWED_ERR,"
NSQ_SOURCE_LINE 00000741 "\t\t\t\t      \"node is ReadOnly\")"
NSQ_SOURCE_LINE 00000742 "\tif $self->isReadOnly;"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "    my @nodes = ($node);"
NSQ_SOURCE_LINE 00000745 "    @nodes = @{$node->[_C]}"
NSQ_SOURCE_LINE 00000746 "\tif $node->getNodeType == DOCUMENT_FRAGMENT_NODE;"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "    my $doc = $self->[_Doc];"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "    for my $n (@nodes)"
NSQ_SOURCE_LINE 00000751 "    {"
NSQ_SOURCE_LINE 00000752 "\tcroak new XML::DOM::DOMException (WRONG_DOCUMENT_ERR,"
NSQ_SOURCE_LINE 00000753 "\t\t\t\t\t  \"nodes belong to different documents\")"
NSQ_SOURCE_LINE 00000754 "\t    if $doc != $n->[_Doc];"
NSQ_SOURCE_LINE 00000755 "\t"
NSQ_SOURCE_LINE 00000756 "\tcroak new XML::DOM::DOMException (HIERARCHY_REQUEST_ERR,"
NSQ_SOURCE_LINE 00000757 "\t\t\t\t\t  \"node is ancestor of parent node\")"
NSQ_SOURCE_LINE 00000758 "\t    if $n->isAncestor ($self);"
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "\tcroak new XML::DOM::DOMException (HIERARCHY_REQUEST_ERR,"
NSQ_SOURCE_LINE 00000761 "\t\t\t\t\t  \"bad node type\")"
NSQ_SOURCE_LINE 00000762 "\t    if $self->rejectChild ($n);"
NSQ_SOURCE_LINE 00000763 "    }"
NSQ_SOURCE_LINE 00000764 "    my $index = $self->getChildIndex ($refNode);"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "    croak new XML::DOM::DOMException (NOT_FOUND_ERR,"
NSQ_SOURCE_LINE 00000767 "\t\t\t\t      \"reference node not found\")"
NSQ_SOURCE_LINE 00000768 "\tif $index == -1;"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "    for my $n (@nodes)"
NSQ_SOURCE_LINE 00000771 "    {"
NSQ_SOURCE_LINE 00000772 "\t$n->setParentNode ($self);"
NSQ_SOURCE_LINE 00000773 "    }"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "    splice (@{$self->[_C]}, $index, 0, @nodes);"
NSQ_SOURCE_LINE 00000776 "    $node;"
NSQ_SOURCE_LINE 00000777 "}"
NSQ_SOURCE_LINE 00000778 ""
