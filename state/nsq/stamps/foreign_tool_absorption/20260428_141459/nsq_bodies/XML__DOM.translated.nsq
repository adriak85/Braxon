NSQ_SOURCE_LINE 00000841 "# Merge all subsequent Text nodes in this subtree"
NSQ_SOURCE_LINE 00000842 "sub normalize"
NSQ_SOURCE_LINE 00000843 "{"
NSQ_SOURCE_LINE 00000844 "    my ($self) = shift;"
NSQ_SOURCE_LINE 00000845 "    my $prev = undef;\t# previous Text node"
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "    return unless defined $self->[_C];"
NSQ_SOURCE_LINE 00000848 ""
NSQ_SOURCE_LINE 00000849 "    my @nodes = @{$self->[_C]};"
NSQ_SOURCE_LINE 00000850 "    my $i = 0;"
NSQ_SOURCE_LINE 00000851 "    my $n = @nodes;"
NSQ_SOURCE_LINE 00000852 "    while ($i < $n)"
NSQ_SOURCE_LINE 00000853 "    {"
NSQ_SOURCE_LINE 00000854 "\tmy $node = $self->getChildAtIndex($i);"
NSQ_SOURCE_LINE 00000855 "\tmy $type = $node->getNodeType;"
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "\tif (defined $prev)"
NSQ_SOURCE_LINE 00000858 "\t{"
NSQ_SOURCE_LINE 00000859 "\t    # It should not merge CDATASections. Dom Spec says:"
NSQ_SOURCE_LINE 00000860 "\t    #  Adjacent CDATASections nodes are not merged by use"
NSQ_SOURCE_LINE 00000861 "\t    #  of the Element.normalize() method."
NSQ_SOURCE_LINE 00000862 "\t    if ($type == TEXT_NODE)"
NSQ_SOURCE_LINE 00000863 "\t    {"
NSQ_SOURCE_LINE 00000864 "\t\t$prev->appendData ($node->getData);"
NSQ_SOURCE_LINE 00000865 "\t\t$self->removeChild ($node);"
NSQ_SOURCE_LINE 00000866 "\t\t$i--;"
NSQ_SOURCE_LINE 00000867 "\t\t$n--;"
NSQ_SOURCE_LINE 00000868 "\t    }"
NSQ_SOURCE_LINE 00000869 "\t    else"
NSQ_SOURCE_LINE 00000870 "\t    {"
NSQ_SOURCE_LINE 00000871 "\t\t$prev = undef;"
NSQ_SOURCE_LINE 00000872 "\t\tif ($type == ELEMENT_NODE)"
NSQ_SOURCE_LINE 00000873 "\t\t{"
NSQ_SOURCE_LINE 00000874 "\t\t    $node->normalize;"
NSQ_SOURCE_LINE 00000875 "\t\t    if (defined $node->[_A])"
NSQ_SOURCE_LINE 00000876 "\t\t    {"
NSQ_SOURCE_LINE 00000877 "\t\t\tfor my $attr (@{$node->[_A]->getValues})"
NSQ_SOURCE_LINE 00000878 "\t\t\t{"
NSQ_SOURCE_LINE 00000879 "\t\t\t    $attr->normalize;"
NSQ_SOURCE_LINE 00000880 "\t\t\t}"
NSQ_SOURCE_LINE 00000881 "\t\t    }"
NSQ_SOURCE_LINE 00000882 "\t\t}"
NSQ_SOURCE_LINE 00000883 "\t    }"
NSQ_SOURCE_LINE 00000884 "\t}"
NSQ_SOURCE_LINE 00000885 "\telse"
NSQ_SOURCE_LINE 00000886 "\t{"
NSQ_SOURCE_LINE 00000887 "\t    if ($type == TEXT_NODE)"
NSQ_SOURCE_LINE 00000888 "\t    {"
NSQ_SOURCE_LINE 00000889 "\t\t$prev = $node;"
NSQ_SOURCE_LINE 00000890 "\t    }"
NSQ_SOURCE_LINE 00000891 "\t    elsif ($type == ELEMENT_NODE)"
NSQ_SOURCE_LINE 00000892 "\t    {"
NSQ_SOURCE_LINE 00000893 "\t\t$node->normalize;"
NSQ_SOURCE_LINE 00000894 "\t\tif (defined $node->[_A])"
NSQ_SOURCE_LINE 00000895 "\t\t{"
NSQ_SOURCE_LINE 00000896 "\t\t    for my $attr (@{$node->[_A]->getValues})"
NSQ_SOURCE_LINE 00000897 "\t\t    {"
NSQ_SOURCE_LINE 00000898 "\t\t\t$attr->normalize;"
NSQ_SOURCE_LINE 00000899 "\t\t    }"
NSQ_SOURCE_LINE 00000900 "\t\t}"
NSQ_SOURCE_LINE 00000901 "\t    }"
NSQ_SOURCE_LINE 00000902 "\t}"
NSQ_SOURCE_LINE 00000903 "\t$i++;"
NSQ_SOURCE_LINE 00000904 "    }"
NSQ_SOURCE_LINE 00000905 "}"
