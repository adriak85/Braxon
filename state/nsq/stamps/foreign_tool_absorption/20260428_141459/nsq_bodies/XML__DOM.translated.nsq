NSQ_SOURCE_LINE 00000615 "sub appendChild"
NSQ_SOURCE_LINE 00000616 "{"
NSQ_SOURCE_LINE 00000617 "    my ($self, $node) = @_;"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "    # REC 7473"
NSQ_SOURCE_LINE 00000620 "    if ($XML::DOM::SafeMode)"
NSQ_SOURCE_LINE 00000621 "    {"
NSQ_SOURCE_LINE 00000622 "\tcroak new XML::DOM::DOMException (NO_MODIFICATION_ALLOWED_ERR,"
NSQ_SOURCE_LINE 00000623 "\t\t\t\t\t  \"node is ReadOnly\")"
NSQ_SOURCE_LINE 00000624 "\t    if $self->isReadOnly;"
NSQ_SOURCE_LINE 00000625 "    }"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "    my $doc = $self->[_Doc];"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "    if ($node->isDocumentFragmentNode)"
NSQ_SOURCE_LINE 00000630 "    {"
NSQ_SOURCE_LINE 00000631 "\tif ($XML::DOM::SafeMode)"
NSQ_SOURCE_LINE 00000632 "\t{"
NSQ_SOURCE_LINE 00000633 "\t    for my $n (@{$node->[_C]})"
NSQ_SOURCE_LINE 00000634 "\t    {"
NSQ_SOURCE_LINE 00000635 "\t\tcroak new XML::DOM::DOMException (WRONG_DOCUMENT_ERR,"
NSQ_SOURCE_LINE 00000636 "\t\t\t\t\t\t  \"nodes belong to different documents\")"
NSQ_SOURCE_LINE 00000637 "\t\t    if $doc != $n->[_Doc];"
NSQ_SOURCE_LINE 00000638 "\t\t"
NSQ_SOURCE_LINE 00000639 "\t\tcroak new XML::DOM::DOMException (HIERARCHY_REQUEST_ERR,"
NSQ_SOURCE_LINE 00000640 "\t\t\t\t\t\t  \"node is ancestor of parent node\")"
NSQ_SOURCE_LINE 00000641 "\t\t    if $n->isAncestor ($self);"
NSQ_SOURCE_LINE 00000642 "\t\t"
NSQ_SOURCE_LINE 00000643 "\t\tcroak new XML::DOM::DOMException (HIERARCHY_REQUEST_ERR,"
NSQ_SOURCE_LINE 00000644 "\t\t\t\t\t\t  \"bad node type\")"
NSQ_SOURCE_LINE 00000645 "\t\t    if $self->rejectChild ($n);"
NSQ_SOURCE_LINE 00000646 "\t    }"
NSQ_SOURCE_LINE 00000647 "\t}"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "\tmy @list = @{$node->[_C]};\t# don't try to compress this"
NSQ_SOURCE_LINE 00000650 "\tfor my $n (@list)"
NSQ_SOURCE_LINE 00000651 "\t{"
NSQ_SOURCE_LINE 00000652 "\t    $n->setParentNode ($self);"
NSQ_SOURCE_LINE 00000653 "\t}"
NSQ_SOURCE_LINE 00000654 "\tpush @{$self->[_C]}, @list;"
NSQ_SOURCE_LINE 00000655 "    }"
NSQ_SOURCE_LINE 00000656 "    else"
NSQ_SOURCE_LINE 00000657 "    {"
NSQ_SOURCE_LINE 00000658 "\tif ($XML::DOM::SafeMode)"
NSQ_SOURCE_LINE 00000659 "\t{"
NSQ_SOURCE_LINE 00000660 "\t    croak new XML::DOM::DOMException (WRONG_DOCUMENT_ERR,"
NSQ_SOURCE_LINE 00000661 "\t\t\t\t\t\t  \"nodes belong to different documents\")"
NSQ_SOURCE_LINE 00000662 "\t\tif $doc != $node->[_Doc];"
NSQ_SOURCE_LINE 00000663 "\t\t"
NSQ_SOURCE_LINE 00000664 "\t    croak new XML::DOM::DOMException (HIERARCHY_REQUEST_ERR,"
NSQ_SOURCE_LINE 00000665 "\t\t\t\t\t\t  \"node is ancestor of parent node\")"
NSQ_SOURCE_LINE 00000666 "\t\tif $node->isAncestor ($self);"
NSQ_SOURCE_LINE 00000667 "\t\t"
NSQ_SOURCE_LINE 00000668 "\t    croak new XML::DOM::DOMException (HIERARCHY_REQUEST_ERR,"
NSQ_SOURCE_LINE 00000669 "\t\t\t\t\t\t  \"bad node type\")"
NSQ_SOURCE_LINE 00000670 "\t\tif $self->rejectChild ($node);"
NSQ_SOURCE_LINE 00000671 "\t}"
NSQ_SOURCE_LINE 00000672 "\t$node->setParentNode ($self);"
NSQ_SOURCE_LINE 00000673 "\tpush @{$self->[_C]}, $node;"
NSQ_SOURCE_LINE 00000674 "    }"
NSQ_SOURCE_LINE 00000675 "    $node;"
NSQ_SOURCE_LINE 00000676 "}"
