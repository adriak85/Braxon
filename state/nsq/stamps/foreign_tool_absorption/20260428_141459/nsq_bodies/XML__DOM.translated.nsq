NSQ_SOURCE_LINE 00001755 "{"
NSQ_SOURCE_LINE 00001756 "    $_[0]->[_Ndata];"
NSQ_SOURCE_LINE 00001757 "}"
NSQ_SOURCE_LINE 00001758 ""
NSQ_SOURCE_LINE 00001759 "sub print"
NSQ_SOURCE_LINE 00001760 "{"
NSQ_SOURCE_LINE 00001761 "    my ($self, $FILE) = @_;    "
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 "    my $name = $self->[_NotationName];"
NSQ_SOURCE_LINE 00001764 ""
NSQ_SOURCE_LINE 00001765 "    my $par = $self->isParameterEntity ? \"% \" : \"\";"
NSQ_SOURCE_LINE 00001766 ""
NSQ_SOURCE_LINE 00001767 "    $FILE->print (\"<!ENTITY $par$name\");"
NSQ_SOURCE_LINE 00001768 ""
NSQ_SOURCE_LINE 00001769 "    my $value = $self->[_Value];"
NSQ_SOURCE_LINE 00001770 "    my $sysId = $self->[_SysId];"
NSQ_SOURCE_LINE 00001771 "    my $pubId = $self->[_PubId];"
NSQ_SOURCE_LINE 00001772 "    my $ndata = $self->[_Ndata];"
NSQ_SOURCE_LINE 00001773 ""
NSQ_SOURCE_LINE 00001774 "    if (defined $value)"
NSQ_SOURCE_LINE 00001775 "    {"
NSQ_SOURCE_LINE 00001776 "#?? Not sure what to do if it contains both single and double quote"
NSQ_SOURCE_LINE 00001777 "\t$value = ($value =~ /\\\"/) ? \"'$value'\" : \"\\\"$value\\\"\";"
NSQ_SOURCE_LINE 00001778 "\t$FILE->print (\" $value\");"
NSQ_SOURCE_LINE 00001779 "    }"
NSQ_SOURCE_LINE 00001780 "    if (defined $pubId)"
NSQ_SOURCE_LINE 00001781 "    {"
NSQ_SOURCE_LINE 00001782 "\t$FILE->print (\" PUBLIC \\\"$pubId\\\"\");\t"
NSQ_SOURCE_LINE 00001783 "    }"
NSQ_SOURCE_LINE 00001784 "    elsif (defined $sysId)"
NSQ_SOURCE_LINE 00001785 "    {"
NSQ_SOURCE_LINE 00001786 "\t$FILE->print (\" SYSTEM\");"
NSQ_SOURCE_LINE 00001787 "    }"
NSQ_SOURCE_LINE 00001788 ""
NSQ_SOURCE_LINE 00001789 "    if (defined $sysId)"
NSQ_SOURCE_LINE 00001790 "    {"
NSQ_SOURCE_LINE 00001791 "\t$FILE->print (\" \\\"$sysId\\\"\");"
NSQ_SOURCE_LINE 00001792 "    }"
NSQ_SOURCE_LINE 00001793 "    $FILE->print (\" NDATA $ndata\") if defined $ndata;"
NSQ_SOURCE_LINE 00001794 "    $FILE->print (\">\");"
NSQ_SOURCE_LINE 00001795 "}"
NSQ_SOURCE_LINE 00001796 ""
NSQ_SOURCE_LINE 00001797 "sub to_expat"
NSQ_SOURCE_LINE 00001798 "{"
NSQ_SOURCE_LINE 00001799 "    my ($self, $iter) = @_;"
NSQ_SOURCE_LINE 00001800 "    my $name = ($self->isParameterEntity ? '%' : \"\") . $self->getNotationName; "
NSQ_SOURCE_LINE 00001801 "    $iter->Entity ($name,"
NSQ_SOURCE_LINE 00001802 "\t\t   $self->getValue, $self->getSysId, $self->getPubId, "
NSQ_SOURCE_LINE 00001803 "\t\t   $self->getNdata);"
