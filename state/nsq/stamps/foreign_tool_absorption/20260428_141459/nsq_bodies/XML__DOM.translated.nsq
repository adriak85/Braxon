NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "sub rejectChild"
NSQ_SOURCE_LINE 00001729 "{"
NSQ_SOURCE_LINE 00001730 "    return 1;"
NSQ_SOURCE_LINE 00001731 "#?? if value is split over subnodes, recode this section"
NSQ_SOURCE_LINE 00001732 "# also add:\t\t\t\t   C => new XML::DOM::NodeList,"
NSQ_SOURCE_LINE 00001733 ""
NSQ_SOURCE_LINE 00001734 "    my $t = $_[1];"
NSQ_SOURCE_LINE 00001735 ""
NSQ_SOURCE_LINE 00001736 "    return $t == TEXT_NODE"
NSQ_SOURCE_LINE 00001737 "\t|| $t == ENTITY_REFERENCE_NODE "
NSQ_SOURCE_LINE 00001738 "\t|| $t == PROCESSING_INSTRUCTION_NODE"
NSQ_SOURCE_LINE 00001739 "\t|| $t == COMMENT_NODE"
NSQ_SOURCE_LINE 00001740 "\t|| $t == CDATA_SECTION_NODE"
NSQ_SOURCE_LINE 00001741 "\t|| $t == ELEMENT_NODE;"
NSQ_SOURCE_LINE 00001742 "}"
NSQ_SOURCE_LINE 00001743 ""
