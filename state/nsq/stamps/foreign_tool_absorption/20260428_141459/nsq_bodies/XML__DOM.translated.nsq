NSQ_SOURCE_LINE 00001877 ""
NSQ_SOURCE_LINE 00001878 "    my $data;"
NSQ_SOURCE_LINE 00001879 "    if ($self->[_NoExpand]) {"
NSQ_SOURCE_LINE 00001880 "      $data = \"&$name;\" if $name;"
NSQ_SOURCE_LINE 00001881 "    } else {"
NSQ_SOURCE_LINE 00001882 "      $data = $self->[_Doc]->expandEntity ($name, $parameter);"
NSQ_SOURCE_LINE 00001883 "    }"
NSQ_SOURCE_LINE 00001884 ""
NSQ_SOURCE_LINE 00001885 "    unless (defined $data)"
NSQ_SOURCE_LINE 00001886 "    {"
NSQ_SOURCE_LINE 00001887 "#?? this is probably an error, but perhaps requires check to NoExpand"
NSQ_SOURCE_LINE 00001888 "# will fix it?"
NSQ_SOURCE_LINE 00001889 "\tmy $pc = $parameter ? \"%\" : \"&\";"
NSQ_SOURCE_LINE 00001890 "\t$data = \"$pc$name;\";"
NSQ_SOURCE_LINE 00001891 "    }"
NSQ_SOURCE_LINE 00001892 "    $data;"
NSQ_SOURCE_LINE 00001893 "}"
NSQ_SOURCE_LINE 00001894 ""
NSQ_SOURCE_LINE 00001895 "sub print"
NSQ_SOURCE_LINE 00001896 "{"
NSQ_SOURCE_LINE 00001897 "    my ($self, $FILE) = @_;    "
NSQ_SOURCE_LINE 00001898 ""
NSQ_SOURCE_LINE 00001899 "    my $name = $self->[_EntityName];"
NSQ_SOURCE_LINE 00001900 ""
NSQ_SOURCE_LINE 00001901 "#?? or do we expand the entities?"
NSQ_SOURCE_LINE 00001902 ""
NSQ_SOURCE_LINE 00001903 "    my $pc = $self->[_Parameter] ? \"%\" : \"&\";"
NSQ_SOURCE_LINE 00001904 "    $FILE->print (\"$pc$name;\");"
NSQ_SOURCE_LINE 00001905 "}"
NSQ_SOURCE_LINE 00001906 ""
NSQ_SOURCE_LINE 00001907 "# Dom Spec says:"
NSQ_SOURCE_LINE 00001908 "#     [...] but if such an Entity exists, then"
NSQ_SOURCE_LINE 00001909 "#     the child list of the EntityReference node is the same as that of the"
NSQ_SOURCE_LINE 00001910 "#     Entity node. "
NSQ_SOURCE_LINE 00001911 "#"
NSQ_SOURCE_LINE 00001912 "#     The resolution of the children of the EntityReference (the replacement"
NSQ_SOURCE_LINE 00001913 "#     value of the referenced Entity) may be lazily evaluated; actions by the"
NSQ_SOURCE_LINE 00001914 "#     user (such as calling the childNodes method on the EntityReference"
NSQ_SOURCE_LINE 00001915 "#     node) are assumed to trigger the evaluation."
NSQ_SOURCE_LINE 00001916 "sub getChildNodes"
NSQ_SOURCE_LINE 00001917 "{"
NSQ_SOURCE_LINE 00001918 "    my $self = shift;"
NSQ_SOURCE_LINE 00001919 "    my $entity = $self->[_Doc]->getEntity ($self->[_EntityName]);"
NSQ_SOURCE_LINE 00001920 "    defined ($entity) ? $entity->getChildNodes : new XML::DOM::NodeList;"
NSQ_SOURCE_LINE 00001921 "}"
NSQ_SOURCE_LINE 00001922 ""
NSQ_SOURCE_LINE 00001923 "sub cloneNode"
NSQ_SOURCE_LINE 00001924 "{"
NSQ_SOURCE_LINE 00001925 "    my $self = shift;"
NSQ_SOURCE_LINE 00001926 "    $self->[_Doc]->createEntityReference ($self->[_EntityName], "
NSQ_SOURCE_LINE 00001927 "                                         $self->[_Parameter],"
NSQ_SOURCE_LINE 00001928 "                                         $self->[_NoExpand],"
NSQ_SOURCE_LINE 00001929 "                                          );"
NSQ_SOURCE_LINE 00001930 "}"
NSQ_SOURCE_LINE 00001931 ""
NSQ_SOURCE_LINE 00001932 "sub to_expat"
NSQ_SOURCE_LINE 00001933 "{"
NSQ_SOURCE_LINE 00001934 "    my ($self, $iter) = @_;"
NSQ_SOURCE_LINE 00001935 "    $iter->EntityRef ($self->getEntityName, $self->isParameterEntity);"
NSQ_SOURCE_LINE 00001936 "}"
NSQ_SOURCE_LINE 00001937 ""
NSQ_SOURCE_LINE 00001938 "sub _to_sax"
NSQ_SOURCE_LINE 00001939 "{"
NSQ_SOURCE_LINE 00001940 "    my ($self, $doch, $dtdh, $enth) = @_;"
NSQ_SOURCE_LINE 00001941 "    my @par = $self->isParameterEntity ? (Parameter => 1) : ();"
NSQ_SOURCE_LINE 00001942 "#?? not supported by PerlSAX: $self->isParameterEntity"
NSQ_SOURCE_LINE 00001943 ""
NSQ_SOURCE_LINE 00001944 "    $doch->entity_reference ( { Name => $self->getEntityName, @par } );"
NSQ_SOURCE_LINE 00001945 "}"
