NSQ_SOURCE_LINE 00002066 "}"
NSQ_SOURCE_LINE 00002067 ""
NSQ_SOURCE_LINE 00002068 "sub isRequired"
NSQ_SOURCE_LINE 00002069 "{"
NSQ_SOURCE_LINE 00002070 "    $_[0]->[_Required] || 0;"
NSQ_SOURCE_LINE 00002071 "}"
NSQ_SOURCE_LINE 00002072 ""
NSQ_SOURCE_LINE 00002073 "sub isImplied"
NSQ_SOURCE_LINE 00002074 "{"
NSQ_SOURCE_LINE 00002075 "    $_[0]->[_Implied] || 0;"
NSQ_SOURCE_LINE 00002076 "}"
NSQ_SOURCE_LINE 00002077 ""
NSQ_SOURCE_LINE 00002078 "sub print"
NSQ_SOURCE_LINE 00002079 "{"
NSQ_SOURCE_LINE 00002080 "    my ($self, $FILE) = @_;    "
NSQ_SOURCE_LINE 00002081 ""
NSQ_SOURCE_LINE 00002082 "    my $name = $self->[_Name];"
NSQ_SOURCE_LINE 00002083 "    my $type = $self->[_Type];"
NSQ_SOURCE_LINE 00002084 "    my $fixed = $self->[_Fixed];"
NSQ_SOURCE_LINE 00002085 "    my $default = $self->[_Default];"
NSQ_SOURCE_LINE 00002086 ""
NSQ_SOURCE_LINE 00002087 "#    $FILE->print (\"$name $type\");"
NSQ_SOURCE_LINE 00002088 "    # replaced line above with the two lines below"
NSQ_SOURCE_LINE 00002089 "    # seems to be a bug in perl 5.6.0 that causes"
NSQ_SOURCE_LINE 00002090 "    # test 3 of dom_jp_attr.t to fail?"
NSQ_SOURCE_LINE 00002091 "    $FILE->print ($name);"
NSQ_SOURCE_LINE 00002092 "    $FILE->print (\" $type\");"
NSQ_SOURCE_LINE 00002093 ""
NSQ_SOURCE_LINE 00002094 "    $FILE->print (\" #FIXED\") if defined $fixed;"
NSQ_SOURCE_LINE 00002095 ""
NSQ_SOURCE_LINE 00002096 "    if ($self->[_Required])"
NSQ_SOURCE_LINE 00002097 "    {"
NSQ_SOURCE_LINE 00002098 "\t$FILE->print (\" #REQUIRED\");"
NSQ_SOURCE_LINE 00002099 "    }"
NSQ_SOURCE_LINE 00002100 "    elsif ($self->[_Implied])"
NSQ_SOURCE_LINE 00002101 "    {"
NSQ_SOURCE_LINE 00002102 "\t$FILE->print (\" #IMPLIED\");"
NSQ_SOURCE_LINE 00002103 "    }"
NSQ_SOURCE_LINE 00002104 "    elsif (defined ($default))"
NSQ_SOURCE_LINE 00002105 "    {"
NSQ_SOURCE_LINE 00002106 "\tmy $quote = $self->[_Quote];"
NSQ_SOURCE_LINE 00002107 "\t$FILE->print (\" $quote\");"
NSQ_SOURCE_LINE 00002108 "\tfor my $kid (@{$default->[_C]})"
NSQ_SOURCE_LINE 00002109 "\t{"
NSQ_SOURCE_LINE 00002110 "\t    $kid->print ($FILE);"
NSQ_SOURCE_LINE 00002111 "\t}"
NSQ_SOURCE_LINE 00002112 "\t$FILE->print ($quote);\t"
NSQ_SOURCE_LINE 00002113 "    }"
NSQ_SOURCE_LINE 00002114 "}"
NSQ_SOURCE_LINE 00002115 ""
NSQ_SOURCE_LINE 00002116 "sub getDefaultString"
NSQ_SOURCE_LINE 00002117 "{"
NSQ_SOURCE_LINE 00002118 "    my $self = shift;"
NSQ_SOURCE_LINE 00002119 "    my $default;"
NSQ_SOURCE_LINE 00002120 ""
NSQ_SOURCE_LINE 00002121 "    if ($self->[_Required])"
NSQ_SOURCE_LINE 00002122 "    {"
NSQ_SOURCE_LINE 00002123 "\treturn \"#REQUIRED\";"
NSQ_SOURCE_LINE 00002124 "    }"
NSQ_SOURCE_LINE 00002125 "    elsif ($self->[_Implied])"
NSQ_SOURCE_LINE 00002126 "    {"
NSQ_SOURCE_LINE 00002127 "\treturn \"#IMPLIED\";"
NSQ_SOURCE_LINE 00002128 "    }"
NSQ_SOURCE_LINE 00002129 "    elsif (defined ($default = $self->[_Default]))"
NSQ_SOURCE_LINE 00002130 "    {"
NSQ_SOURCE_LINE 00002131 "\tmy $quote = $self->[_Quote];"
NSQ_SOURCE_LINE 00002132 "\t$default = $default->toString;"
NSQ_SOURCE_LINE 00002133 "\treturn \"$quote$default$quote\";"
NSQ_SOURCE_LINE 00002134 "    }"
NSQ_SOURCE_LINE 00002135 "    undef;"
NSQ_SOURCE_LINE 00002136 "}"
