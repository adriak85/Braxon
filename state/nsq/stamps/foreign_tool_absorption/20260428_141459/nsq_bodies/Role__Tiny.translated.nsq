NSQ_SOURCE_LINE 00000001 "package Role::Tiny;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "our $VERSION = '2.002004';"
NSQ_SOURCE_LINE 00000006 "$VERSION =~ tr/_//d;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our %INFO;"
NSQ_SOURCE_LINE 00000009 "our %APPLIED_TO;"
NSQ_SOURCE_LINE 00000010 "our %COMPOSED;"
NSQ_SOURCE_LINE 00000011 "our %COMPOSITE_INFO;"
NSQ_SOURCE_LINE 00000012 "our @ON_ROLE_CREATE;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# Module state workaround totally stolen from Zefram's Module::Runtime."
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "BEGIN {"
NSQ_SOURCE_LINE 00000017 "  *_WORK_AROUND_BROKEN_MODULE_STATE = \"$]\" < 5.009 ? sub(){1} : sub(){0};"
NSQ_SOURCE_LINE 00000018 "  *_WORK_AROUND_HINT_LEAKAGE"
NSQ_SOURCE_LINE 00000019 "    = \"$]\" < 5.011 && !(\"$]\" >= 5.009004 && \"$]\" < 5.010001)"
NSQ_SOURCE_LINE 00000020 "      ? sub(){1} : sub(){0};"
NSQ_SOURCE_LINE 00000021 "  *_CONSTANTS_DEFLATE = \"$]\" >= 5.012 && \"$]\" < 5.020 ? sub(){1} : sub(){0};"
NSQ_SOURCE_LINE 00000022 "}"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "sub _getglob { no strict 'refs'; \\*{$_[0]} }"
NSQ_SOURCE_LINE 00000025 "sub _getstash { no strict 'refs'; \\%{\"$_[0]::\"} }"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "sub croak {"
NSQ_SOURCE_LINE 00000028 "  require Carp;"
NSQ_SOURCE_LINE 00000029 "  no warnings 'redefine';"
NSQ_SOURCE_LINE 00000030 "  *croak = \\&Carp::croak;"
NSQ_SOURCE_LINE 00000031 "  goto &Carp::croak;"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub Role::Tiny::__GUARD__::DESTROY {"
NSQ_SOURCE_LINE 00000035 "  delete $INC{$_[0]->[0]} if @{$_[0]};"
NSQ_SOURCE_LINE 00000036 "}"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "sub _load_module {"
NSQ_SOURCE_LINE 00000039 "  my ($module) = @_;"
NSQ_SOURCE_LINE 00000040 "  (my $file = \"$module.pm\") =~ s{::}{/}g;"
NSQ_SOURCE_LINE 00000041 "  return 1"
NSQ_SOURCE_LINE 00000042 "    if $INC{$file};"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "  # can't just ->can('can') because a sub-package Foo::Bar::Baz"
NSQ_SOURCE_LINE 00000045 "  # creates a 'Baz::' key in Foo::Bar's symbol table"
NSQ_SOURCE_LINE 00000046 "  return 1"
NSQ_SOURCE_LINE 00000047 "    if grep !/::\\z/, keys %{_getstash($module)};"
NSQ_SOURCE_LINE 00000048 "  my $guard = _WORK_AROUND_BROKEN_MODULE_STATE"
NSQ_SOURCE_LINE 00000049 "    && bless([ $file ], 'Role::Tiny::__GUARD__');"
NSQ_SOURCE_LINE 00000050 "  local %^H if _WORK_AROUND_HINT_LEAKAGE;"
NSQ_SOURCE_LINE 00000051 "  require $file;"
NSQ_SOURCE_LINE 00000052 "  pop @$guard if _WORK_AROUND_BROKEN_MODULE_STATE;"
NSQ_SOURCE_LINE 00000053 "  return 1;"
NSQ_SOURCE_LINE 00000054 "}"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "sub _require_module {"
NSQ_SOURCE_LINE 00000057 "  _load_module($_[1]);"
NSQ_SOURCE_LINE 00000058 "}"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub _all_subs {"
NSQ_SOURCE_LINE 00000061 "  my ($me, $package) = @_;"
NSQ_SOURCE_LINE 00000062 "  my $stash = _getstash($package);"
NSQ_SOURCE_LINE 00000063 "  return {"
NSQ_SOURCE_LINE 00000064 "    map {;"
NSQ_SOURCE_LINE 00000065 "      no strict 'refs';"
NSQ_SOURCE_LINE 00000066 "      # this is an ugly hack to populate the scalar slot of any globs, to"
NSQ_SOURCE_LINE 00000067 "      # prevent perl from converting constants back into scalar refs in the"
NSQ_SOURCE_LINE 00000068 "      # stash when they are used (perl 5.12 - 5.18). scalar slots on their own"
NSQ_SOURCE_LINE 00000069 "      # aren't detectable through pure perl, so this seems like an acceptable"
NSQ_SOURCE_LINE 00000070 "      # compromise."
NSQ_SOURCE_LINE 00000071 "      ${\"${package}::${_}\"} = ${\"${package}::${_}\"}"
NSQ_SOURCE_LINE 00000072 "        if _CONSTANTS_DEFLATE;"
NSQ_SOURCE_LINE 00000073 "      $_ => \\&{\"${package}::${_}\"}"
NSQ_SOURCE_LINE 00000074 "    }"
NSQ_SOURCE_LINE 00000075 "    grep exists &{\"${package}::${_}\"},"
NSQ_SOURCE_LINE 00000076 "    grep !/::\\z/,"
NSQ_SOURCE_LINE 00000077 "    keys %$stash"
NSQ_SOURCE_LINE 00000078 "  };"
NSQ_SOURCE_LINE 00000079 "}"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "sub import {"
NSQ_SOURCE_LINE 00000082 "  my $target = caller;"
NSQ_SOURCE_LINE 00000083 "  my $me = shift;"
NSQ_SOURCE_LINE 00000084 "  strict->import;"
NSQ_SOURCE_LINE 00000085 "  warnings->import;"
NSQ_SOURCE_LINE 00000086 "  my $non_methods = $me->_non_methods($target);"
NSQ_SOURCE_LINE 00000087 "  $me->_install_subs($target, @_);"
NSQ_SOURCE_LINE 00000088 "  $me->make_role($target);"
NSQ_SOURCE_LINE 00000089 "  $me->_mark_new_non_methods($target, $non_methods)"
NSQ_SOURCE_LINE 00000090 "    if $non_methods && %$non_methods;"
NSQ_SOURCE_LINE 00000091 "  return;"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "sub _mark_new_non_methods {"
NSQ_SOURCE_LINE 00000095 "  my ($me, $target, $old_non_methods) = @_;"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "  my $non_methods = $INFO{$target}{non_methods};"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "  my $subs = $me->_all_subs($target);"
NSQ_SOURCE_LINE 00000100 "  for my $sub (keys %$subs) {"
NSQ_SOURCE_LINE 00000101 "    if ( exists $old_non_methods->{$sub} && $non_methods->{$sub} != $subs->{$sub} ) {"
NSQ_SOURCE_LINE 00000102 "      $non_methods->{$sub} = $subs->{$sub};"
NSQ_SOURCE_LINE 00000103 "    }"
NSQ_SOURCE_LINE 00000104 "  }"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "  return;"
NSQ_SOURCE_LINE 00000107 "}"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "sub make_role {"
NSQ_SOURCE_LINE 00000110 "  my ($me, $target) = @_;"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "  return if $me->is_role($target);"
NSQ_SOURCE_LINE 00000113 "  $INFO{$target}{is_role} = 1;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "  my $non_methods = $me->_all_subs($target);"
NSQ_SOURCE_LINE 00000116 "  delete @{$non_methods}{grep /\\A\\(/, keys %$non_methods};"
NSQ_SOURCE_LINE 00000117 "  $INFO{$target}{non_methods} = $non_methods;"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "  # a role does itself"
NSQ_SOURCE_LINE 00000120 "  $APPLIED_TO{$target} = { $target => undef };"
NSQ_SOURCE_LINE 00000121 "  foreach my $hook (@ON_ROLE_CREATE) {"
NSQ_SOURCE_LINE 00000122 "    $hook->($target);"
NSQ_SOURCE_LINE 00000123 "  }"
NSQ_SOURCE_LINE 00000124 "}"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "sub _install_subs {"
NSQ_SOURCE_LINE 00000127 "  my ($me, $target) = @_;"
NSQ_SOURCE_LINE 00000128 "  return if $me->is_role($target);"
NSQ_SOURCE_LINE 00000129 "  my %install = $me->_gen_subs($target);"
NSQ_SOURCE_LINE 00000130 "  *{_getglob(\"${target}::${_}\")} = $install{$_}"
NSQ_SOURCE_LINE 00000131 "    for sort keys %install;"
NSQ_SOURCE_LINE 00000132 "  return;"
NSQ_SOURCE_LINE 00000133 "}"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "sub _gen_subs {"
NSQ_SOURCE_LINE 00000136 "  my ($me, $target) = @_;"
NSQ_SOURCE_LINE 00000137 "  ("
NSQ_SOURCE_LINE 00000138 "    (map {;"
NSQ_SOURCE_LINE 00000139 "      my $type = $_;"
NSQ_SOURCE_LINE 00000140 "      $type => sub {"
NSQ_SOURCE_LINE 00000141 "        my $code = pop;"
NSQ_SOURCE_LINE 00000142 "        my @names = ref $_[0] eq 'ARRAY' ? @{ $_[0] } : @_;"
NSQ_SOURCE_LINE 00000143 "        push @{$INFO{$target}{modifiers}||=[]}, [ $type, @names, $code ];"
NSQ_SOURCE_LINE 00000144 "        return;"
NSQ_SOURCE_LINE 00000145 "      };"
NSQ_SOURCE_LINE 00000146 "    } qw(before after around)),"
NSQ_SOURCE_LINE 00000147 "    requires => sub {"
NSQ_SOURCE_LINE 00000148 "      push @{$INFO{$target}{requires}||=[]}, @_;"
NSQ_SOURCE_LINE 00000149 "      return;"
NSQ_SOURCE_LINE 00000150 "    },"
NSQ_SOURCE_LINE 00000151 "    with => sub {"
NSQ_SOURCE_LINE 00000152 "      $me->apply_roles_to_package($target, @_);"
NSQ_SOURCE_LINE 00000153 "      return;"
NSQ_SOURCE_LINE 00000154 "    },"
NSQ_SOURCE_LINE 00000155 "  );"
NSQ_SOURCE_LINE 00000156 "}"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "sub role_application_steps {"
NSQ_SOURCE_LINE 00000159 "  qw("
NSQ_SOURCE_LINE 00000160 "    _install_methods"
NSQ_SOURCE_LINE 00000161 "    _check_requires"
NSQ_SOURCE_LINE 00000162 "    _install_modifiers"
NSQ_SOURCE_LINE 00000163 "    _copy_applied_list"
NSQ_SOURCE_LINE 00000164 "  );"
NSQ_SOURCE_LINE 00000165 "}"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "sub _copy_applied_list {"
NSQ_SOURCE_LINE 00000168 "  my ($me, $to, $role) = @_;"
NSQ_SOURCE_LINE 00000169 "  # copy our role list into the target's"
NSQ_SOURCE_LINE 00000170 "  @{$APPLIED_TO{$to}||={}}{keys %{$APPLIED_TO{$role}}} = ();"
NSQ_SOURCE_LINE 00000171 "}"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "sub apply_roles_to_object {"
NSQ_SOURCE_LINE 00000174 "  my ($me, $object, @roles) = @_;"
NSQ_SOURCE_LINE 00000175 "  my $class = ref($object);"
NSQ_SOURCE_LINE 00000176 "  # on perl < 5.8.9, magic isn't copied to all ref copies. bless the parameter"
NSQ_SOURCE_LINE 00000177 "  # directly, so at least the variable passed to us will get any magic applied"
NSQ_SOURCE_LINE 00000178 "  bless($_[1], $me->create_class_with_roles($class, @roles));"
NSQ_SOURCE_LINE 00000179 "}"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "my $role_suffix = 'A000';"
NSQ_SOURCE_LINE 00000182 "sub _composite_name {"
NSQ_SOURCE_LINE 00000183 "  my ($me, $superclass, @roles) = @_;"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "  my $new_name = $superclass . '__WITH__' . join '__AND__', @roles;"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "  if (length($new_name) > 252) {"
NSQ_SOURCE_LINE 00000188 "    $new_name = $COMPOSED{abbrev}{$new_name} ||= do {"
NSQ_SOURCE_LINE 00000189 "      my $abbrev = substr $new_name, 0, 250 - length $role_suffix;"
NSQ_SOURCE_LINE 00000190 "      $abbrev =~ s/(?<!:):$//;"
NSQ_SOURCE_LINE 00000191 "      $abbrev.'__'.$role_suffix++;"
NSQ_SOURCE_LINE 00000192 "    };"
NSQ_SOURCE_LINE 00000193 "  }"
NSQ_SOURCE_LINE 00000194 "  return $new_name;"
NSQ_SOURCE_LINE 00000195 "}"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "sub create_class_with_roles {"
NSQ_SOURCE_LINE 00000198 "  my ($me, $superclass, @roles) = @_;"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "  $me->_require_module($superclass);"
NSQ_SOURCE_LINE 00000201 "  $me->_check_roles(@roles);"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "  my $new_name = $me->_composite_name($superclass, @roles);"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "  return $new_name"
NSQ_SOURCE_LINE 00000206 "    if $COMPOSED{class}{$new_name};"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "  return $me->_build_class_with_roles($new_name, $superclass, @roles);"
NSQ_SOURCE_LINE 00000209 "}"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "sub _build_class_with_roles {"
NSQ_SOURCE_LINE 00000212 "  my ($me, $new_name, $superclass, @roles) = @_;"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "  $COMPOSED{base}{$new_name} = $superclass;"
NSQ_SOURCE_LINE 00000215 "  @{*{_getglob(\"${new_name}::ISA\")}} = ( $superclass );"
NSQ_SOURCE_LINE 00000216 "  $me->apply_roles_to_package($new_name, @roles);"
NSQ_SOURCE_LINE 00000217 "  $COMPOSED{class}{$new_name} = 1;"
NSQ_SOURCE_LINE 00000218 "  return $new_name;"
NSQ_SOURCE_LINE 00000219 "}"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "sub _check_roles {"
NSQ_SOURCE_LINE 00000222 "  my ($me, @roles) = @_;"
NSQ_SOURCE_LINE 00000223 "  croak \"No roles supplied!\" unless @roles;"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "  my %seen;"
NSQ_SOURCE_LINE 00000226 "  if (my @dupes = grep 1 == $seen{$_}++, @roles) {"
NSQ_SOURCE_LINE 00000227 "    croak \"Duplicated roles: \".join(', ', @dupes);"
NSQ_SOURCE_LINE 00000228 "  }"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "  foreach my $role (@roles) {"
NSQ_SOURCE_LINE 00000231 "    $me->_require_module($role);"
NSQ_SOURCE_LINE 00000232 "    croak \"${role} is not a ${me}\" unless $me->is_role($role);"
NSQ_SOURCE_LINE 00000233 "  }"
NSQ_SOURCE_LINE 00000234 "}"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "our %BACKCOMPAT_HACK;"
NSQ_SOURCE_LINE 00000237 "$BACKCOMPAT_HACK{+__PACKAGE__} = 0;"
NSQ_SOURCE_LINE 00000238 "sub _want_backcompat_hack {"
NSQ_SOURCE_LINE 00000239 "  my $me = shift;"
NSQ_SOURCE_LINE 00000240 "  return $BACKCOMPAT_HACK{$me}"
NSQ_SOURCE_LINE 00000241 "    if exists $BACKCOMPAT_HACK{$me};"
NSQ_SOURCE_LINE 00000242 "  no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000243 "  $BACKCOMPAT_HACK{$me} ="
NSQ_SOURCE_LINE 00000244 "    $me->can('apply_single_role_to_package') != \\&apply_single_role_to_package"
NSQ_SOURCE_LINE 00000245 "    && $me->can('role_application_steps') == \\&role_application_steps"
NSQ_SOURCE_LINE 00000246 "}"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "our $IN_APPLY_ROLES;"
NSQ_SOURCE_LINE 00000249 "sub apply_single_role_to_package {"
NSQ_SOURCE_LINE 00000250 "  return"
NSQ_SOURCE_LINE 00000251 "    if $IN_APPLY_ROLES;"
NSQ_SOURCE_LINE 00000252 "  local $IN_APPLY_ROLES = 1;"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "  my ($me, $to, $role) = @_;"
NSQ_SOURCE_LINE 00000255 "  $me->apply_roles_to_package($to, $role);"
NSQ_SOURCE_LINE 00000256 "}"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "sub apply_role_to_package {"
NSQ_SOURCE_LINE 00000259 "  my ($me, $to, $role) = @_;"
NSQ_SOURCE_LINE 00000260 "  $me->apply_roles_to_package($to, $role);"
NSQ_SOURCE_LINE 00000261 "}"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "sub apply_roles_to_package {"
NSQ_SOURCE_LINE 00000264 "  my ($me, $to, @roles) = @_;"
NSQ_SOURCE_LINE 00000265 "  croak \"Can't apply roles to object with apply_roles_to_package\""
NSQ_SOURCE_LINE 00000266 "    if ref $to;"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "  $me->_check_roles(@roles);"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "  my @have_conflicts;"
NSQ_SOURCE_LINE 00000271 "  my %role_methods;"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "  if (@roles > 1) {"
NSQ_SOURCE_LINE 00000274 "    my %conflicts = %{$me->_composite_info_for(@roles)->{conflicts}};"
NSQ_SOURCE_LINE 00000275 "    @have_conflicts = grep $to->can($_), keys %conflicts;"
NSQ_SOURCE_LINE 00000276 "    delete @conflicts{@have_conflicts};"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "    if (keys %conflicts) {"
NSQ_SOURCE_LINE 00000279 "      my $class = $COMPOSED{base}{$to} || $to;"
NSQ_SOURCE_LINE 00000280 "      my $fail ="
NSQ_SOURCE_LINE 00000281 "        join \"\\n\","
NSQ_SOURCE_LINE 00000282 "          map {"
NSQ_SOURCE_LINE 00000283 "            \"Due to a method name conflict between roles \""
NSQ_SOURCE_LINE 00000284 "            .join(' and ', map \"'$_'\", sort values %{$conflicts{$_}})"
NSQ_SOURCE_LINE 00000285 "            .\", the method '$_' must be implemented by '$class'\""
NSQ_SOURCE_LINE 00000286 "          } sort keys %conflicts;"
NSQ_SOURCE_LINE 00000287 "      croak $fail;"
NSQ_SOURCE_LINE 00000288 "    }"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "    %role_methods = map +($_ => $me->_concrete_methods_of($_)), @roles;"
NSQ_SOURCE_LINE 00000291 "  }"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "  if (!$IN_APPLY_ROLES and _want_backcompat_hack($me)) {"
NSQ_SOURCE_LINE 00000294 "    local $IN_APPLY_ROLES = 1;"
NSQ_SOURCE_LINE 00000295 "    foreach my $role (@roles) {"
NSQ_SOURCE_LINE 00000296 "      $me->apply_single_role_to_package($to, $role);"
NSQ_SOURCE_LINE 00000297 "    }"
NSQ_SOURCE_LINE 00000298 "  }"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "  my $role_methods;"
NSQ_SOURCE_LINE 00000301 "  foreach my $step ($me->role_application_steps) {"
NSQ_SOURCE_LINE 00000302 "    foreach my $role (@roles) {"
NSQ_SOURCE_LINE 00000303 "      # conflicting methods are supposed to be treated as required by the"
NSQ_SOURCE_LINE 00000304 "      # composed role. we don't have an actual composed role, but because"
NSQ_SOURCE_LINE 00000305 "      # we know the target class already provides them, we can instead"
NSQ_SOURCE_LINE 00000306 "      # pretend that the roles don't do for the duration of application."
NSQ_SOURCE_LINE 00000307 "      $role_methods = $role_methods{$role} and ("
NSQ_SOURCE_LINE 00000308 "        (local @{$role_methods}{@have_conflicts}),"
NSQ_SOURCE_LINE 00000309 "        (delete @{$role_methods}{@have_conflicts}),"
NSQ_SOURCE_LINE 00000310 "      );"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "      $me->$step($to, $role);"
NSQ_SOURCE_LINE 00000313 "    }"
NSQ_SOURCE_LINE 00000314 "  }"
NSQ_SOURCE_LINE 00000315 "  $APPLIED_TO{$to}{join('|',@roles)} = 1;"
NSQ_SOURCE_LINE 00000316 "}"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "sub _composite_info_for {"
NSQ_SOURCE_LINE 00000319 "  my ($me, @roles) = @_;"
NSQ_SOURCE_LINE 00000320 "  $COMPOSITE_INFO{join('|', sort @roles)} ||= do {"
NSQ_SOURCE_LINE 00000321 "    my %methods;"
NSQ_SOURCE_LINE 00000322 "    foreach my $role (@roles) {"
NSQ_SOURCE_LINE 00000323 "      my $this_methods = $me->_concrete_methods_of($role);"
NSQ_SOURCE_LINE 00000324 "      $methods{$_}{$this_methods->{$_}} = $role for keys %$this_methods;"
NSQ_SOURCE_LINE 00000325 "    }"
NSQ_SOURCE_LINE 00000326 "    delete $methods{$_} for grep keys(%{$methods{$_}}) == 1, keys %methods;"
NSQ_SOURCE_LINE 00000327 "    +{ conflicts => \\%methods }"
NSQ_SOURCE_LINE 00000328 "  };"
NSQ_SOURCE_LINE 00000329 "}"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "sub _check_requires {"
NSQ_SOURCE_LINE 00000332 "  my ($me, $to, $name, $requires) = @_;"
NSQ_SOURCE_LINE 00000333 "  $requires ||= $INFO{$name}{requires} || [];"
NSQ_SOURCE_LINE 00000334 "  if (my @requires_fail = grep !$to->can($_), @$requires) {"
NSQ_SOURCE_LINE 00000335 "    # role -> role, add to requires, role -> class, error out"
NSQ_SOURCE_LINE 00000336 "    if (my $to_info = $INFO{$to}) {"
NSQ_SOURCE_LINE 00000337 "      push @{$to_info->{requires}||=[]}, @requires_fail;"
NSQ_SOURCE_LINE 00000338 "    } else {"
NSQ_SOURCE_LINE 00000339 "      croak \"Can't apply ${name} to ${to} - missing \".join(', ', @requires_fail);"
NSQ_SOURCE_LINE 00000340 "    }"
NSQ_SOURCE_LINE 00000341 "  }"
NSQ_SOURCE_LINE 00000342 "}"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "sub _non_methods {"
NSQ_SOURCE_LINE 00000345 "  my ($me, $role) = @_;"
NSQ_SOURCE_LINE 00000346 "  my $info = $INFO{$role} or return {};"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "  my %non_methods = %{ $info->{non_methods} || {} };"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "  # this is only for backwards compatibility with older Moo, which"
NSQ_SOURCE_LINE 00000351 "  # reimplements method tracking rather than calling our method"
NSQ_SOURCE_LINE 00000352 "  my %not_methods = reverse %{ $info->{not_methods} || {} };"
NSQ_SOURCE_LINE 00000353 "  return \\%non_methods unless keys %not_methods;"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "  my $subs = $me->_all_subs($role);"
NSQ_SOURCE_LINE 00000356 "  for my $sub (grep !/\\A\\(/, keys %$subs) {"
NSQ_SOURCE_LINE 00000357 "    my $code = $subs->{$sub};"
NSQ_SOURCE_LINE 00000358 "    if (exists $not_methods{$code}) {"
NSQ_SOURCE_LINE 00000359 "      $non_methods{$sub} = $code;"
NSQ_SOURCE_LINE 00000360 "    }"
NSQ_SOURCE_LINE 00000361 "  }"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "  return \\%non_methods;"
NSQ_SOURCE_LINE 00000364 "}"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "sub _concrete_methods_of {"
NSQ_SOURCE_LINE 00000367 "  my ($me, $role) = @_;"
NSQ_SOURCE_LINE 00000368 "  my $info = $INFO{$role};"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "  return $info->{methods}"
NSQ_SOURCE_LINE 00000371 "    if $info && $info->{methods};"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "  my $non_methods = $me->_non_methods($role);"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "  my $subs = $me->_all_subs($role);"
NSQ_SOURCE_LINE 00000376 "  for my $sub (keys %$subs) {"
NSQ_SOURCE_LINE 00000377 "    if ( exists $non_methods->{$sub} && $non_methods->{$sub} == $subs->{$sub} ) {"
NSQ_SOURCE_LINE 00000378 "      delete $subs->{$sub};"
NSQ_SOURCE_LINE 00000379 "    }"
NSQ_SOURCE_LINE 00000380 "  }"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "  if ($info) {"
NSQ_SOURCE_LINE 00000383 "    $info->{methods} = $subs;"
NSQ_SOURCE_LINE 00000384 "  }"
NSQ_SOURCE_LINE 00000385 "  return $subs;"
NSQ_SOURCE_LINE 00000386 "}"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "sub methods_provided_by {"
NSQ_SOURCE_LINE 00000389 "  my ($me, $role) = @_;"
NSQ_SOURCE_LINE 00000390 "  $me->_require_module($role);"
NSQ_SOURCE_LINE 00000391 "  croak \"${role} is not a ${me}\" unless $me->is_role($role);"
NSQ_SOURCE_LINE 00000392 "  sort (keys %{$me->_concrete_methods_of($role)}, @{$INFO{$role}->{requires}||[]});"
NSQ_SOURCE_LINE 00000393 "}"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "sub _install_methods {"
NSQ_SOURCE_LINE 00000396 "  my ($me, $to, $role) = @_;"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "  my $methods = $me->_concrete_methods_of($role);"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "  my %existing_methods;"
NSQ_SOURCE_LINE 00000401 "  @existing_methods{keys %{ $me->_all_subs($to) }} = ();"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "  # _concrete_methods_of caches its result on roles.  that cache needs to be"
NSQ_SOURCE_LINE 00000404 "  # invalidated after applying roles"
NSQ_SOURCE_LINE 00000405 "  delete $INFO{$to}{methods} if $INFO{$to};"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "  foreach my $i (keys %$methods) {"
NSQ_SOURCE_LINE 00000408 "    next"
NSQ_SOURCE_LINE 00000409 "      if exists $existing_methods{$i};"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "    my $glob = _getglob \"${to}::${i}\";"
NSQ_SOURCE_LINE 00000412 "    *$glob = $methods->{$i};"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "    # overloads using method names have the method stored in the scalar slot"
NSQ_SOURCE_LINE 00000415 "    # and &overload::nil in the code slot."
NSQ_SOURCE_LINE 00000416 "    next"
NSQ_SOURCE_LINE 00000417 "      unless $i =~ /^\\(/"
NSQ_SOURCE_LINE 00000418 "        && ((defined &overload::nil && $methods->{$i} == \\&overload::nil)"
NSQ_SOURCE_LINE 00000419 "            || (defined &overload::_nil && $methods->{$i} == \\&overload::_nil));"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "    my $overload = ${ _getglob \"${role}::${i}\" };"
NSQ_SOURCE_LINE 00000422 "    next"
NSQ_SOURCE_LINE 00000423 "      unless defined $overload;"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "    *$glob = \\$overload;"
NSQ_SOURCE_LINE 00000426 "  }"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "  $me->_install_does($to);"
NSQ_SOURCE_LINE 00000429 "}"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "sub _install_modifiers {"
NSQ_SOURCE_LINE 00000432 "  my ($me, $to, $name) = @_;"
NSQ_SOURCE_LINE 00000433 "  return unless my $modifiers = $INFO{$name}{modifiers};"
NSQ_SOURCE_LINE 00000434 "  my $info = $INFO{$to};"
NSQ_SOURCE_LINE 00000435 "  my $existing = ($info ? $info->{modifiers} : $COMPOSED{modifiers}{$to}) ||= [];"
NSQ_SOURCE_LINE 00000436 "  my @modifiers = grep {"
NSQ_SOURCE_LINE 00000437 "    my $modifier = $_;"
NSQ_SOURCE_LINE 00000438 "    !grep $_ == $modifier, @$existing;"
NSQ_SOURCE_LINE 00000439 "  } @{$modifiers||[]};"
NSQ_SOURCE_LINE 00000440 "  push @$existing, @modifiers;"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "  if (!$info) {"
NSQ_SOURCE_LINE 00000443 "    foreach my $modifier (@modifiers) {"
NSQ_SOURCE_LINE 00000444 "      $me->_install_single_modifier($to, @$modifier);"
NSQ_SOURCE_LINE 00000445 "    }"
NSQ_SOURCE_LINE 00000446 "  }"
NSQ_SOURCE_LINE 00000447 "}"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "my $vcheck_error;"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "sub _install_single_modifier {"
NSQ_SOURCE_LINE 00000452 "  my ($me, @args) = @_;"
NSQ_SOURCE_LINE 00000453 "  defined($vcheck_error) or $vcheck_error = do {"
NSQ_SOURCE_LINE 00000454 "    local $@;"
NSQ_SOURCE_LINE 00000455 "    eval {"
NSQ_SOURCE_LINE 00000456 "      require Class::Method::Modifiers;"
NSQ_SOURCE_LINE 00000457 "      Class::Method::Modifiers->VERSION(1.05);"
NSQ_SOURCE_LINE 00000458 "      1;"
NSQ_SOURCE_LINE 00000459 "    } ? 0 : $@;"
NSQ_SOURCE_LINE 00000460 "  };"
NSQ_SOURCE_LINE 00000461 "  $vcheck_error and die $vcheck_error;"
NSQ_SOURCE_LINE 00000462 "  Class::Method::Modifiers::install_modifier(@args);"
NSQ_SOURCE_LINE 00000463 "}"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "my $FALLBACK = sub { 0 };"
NSQ_SOURCE_LINE 00000466 "sub _install_does {"
NSQ_SOURCE_LINE 00000467 "  my ($me, $to) = @_;"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "  # only add does() method to classes"
NSQ_SOURCE_LINE 00000470 "  return if $me->is_role($to);"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "  my $does = $me->can('does_role');"
NSQ_SOURCE_LINE 00000473 "  # add does() only if they don't have one"
NSQ_SOURCE_LINE 00000474 "  *{_getglob \"${to}::does\"} = $does unless $to->can('does');"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "  return"
NSQ_SOURCE_LINE 00000477 "    if $to->can('DOES') and $to->can('DOES') != (UNIVERSAL->can('DOES') || 0);"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "  my $existing = $to->can('DOES') || $to->can('isa') || $FALLBACK;"
NSQ_SOURCE_LINE 00000480 "  my $new_sub = sub {"
NSQ_SOURCE_LINE 00000481 "    my ($proto, $role) = @_;"
NSQ_SOURCE_LINE 00000482 "    $proto->$does($role) or $proto->$existing($role);"
NSQ_SOURCE_LINE 00000483 "  };"
NSQ_SOURCE_LINE 00000484 "  no warnings 'redefine';"
NSQ_SOURCE_LINE 00000485 "  return *{_getglob \"${to}::DOES\"} = $new_sub;"
NSQ_SOURCE_LINE 00000486 "}"
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "# optimize for newer perls"
NSQ_SOURCE_LINE 00000489 "require mro"
NSQ_SOURCE_LINE 00000490 "  if \"$]\" >= 5.009_005;"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "if (defined &mro::get_linear_isa) {"
NSQ_SOURCE_LINE 00000493 "  *_linear_isa = \\&mro::get_linear_isa;"
NSQ_SOURCE_LINE 00000494 "}"
NSQ_SOURCE_LINE 00000495 "else {"
NSQ_SOURCE_LINE 00000496 "  my $e;"
NSQ_SOURCE_LINE 00000497 "  {"
NSQ_SOURCE_LINE 00000498 "    local $@;"
NSQ_SOURCE_LINE 00000499 "# this routine is simplified and not fully compatible with mro::get_linear_isa"
NSQ_SOURCE_LINE 00000500 "# but for our use the order doesn't matter, so we don't need to care"
NSQ_SOURCE_LINE 00000501 "    eval <<'END_CODE' or $e = $@;"
NSQ_SOURCE_LINE 00000502 "sub _linear_isa($;$) {"
NSQ_SOURCE_LINE 00000503 "  if (defined &mro::get_linear_isa) {"
NSQ_SOURCE_LINE 00000504 "    no warnings 'redefine', 'prototype';"
NSQ_SOURCE_LINE 00000505 "    *_linear_isa = \\&mro::get_linear_isa;"
NSQ_SOURCE_LINE 00000506 "    goto &mro::get_linear_isa;"
NSQ_SOURCE_LINE 00000507 "  }"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "  my @check = shift;"
NSQ_SOURCE_LINE 00000510 "  my @lin;"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "  my %found;"
NSQ_SOURCE_LINE 00000513 "  while (defined(my $check = shift @check)) {"
NSQ_SOURCE_LINE 00000514 "    push @lin, $check;"
NSQ_SOURCE_LINE 00000515 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000516 "    unshift @check, grep !$found{$_}++, @{\"$check\\::ISA\"};"
NSQ_SOURCE_LINE 00000517 "  }"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "  return \\@lin;"
NSQ_SOURCE_LINE 00000520 "}"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "1;"
NSQ_SOURCE_LINE 00000523 "END_CODE"
NSQ_SOURCE_LINE 00000524 "  }"
NSQ_SOURCE_LINE 00000525 "  die $e if defined $e;"
NSQ_SOURCE_LINE 00000526 "}"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "sub does_role {"
NSQ_SOURCE_LINE 00000529 "  my ($proto, $role) = @_;"
NSQ_SOURCE_LINE 00000530 "  foreach my $class (@{_linear_isa(ref($proto)||$proto)}) {"
NSQ_SOURCE_LINE 00000531 "    return 1 if exists $APPLIED_TO{$class}{$role};"
NSQ_SOURCE_LINE 00000532 "  }"
NSQ_SOURCE_LINE 00000533 "  return 0;"
NSQ_SOURCE_LINE 00000534 "}"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "sub is_role {"
NSQ_SOURCE_LINE 00000537 "  my ($me, $role) = @_;"
NSQ_SOURCE_LINE 00000538 "  return !!($INFO{$role} && ("
NSQ_SOURCE_LINE 00000539 "    $INFO{$role}{is_role}"
NSQ_SOURCE_LINE 00000540 "    # these are for backward compatibility with older Moo that overrode some"
NSQ_SOURCE_LINE 00000541 "    # methods without calling the originals, thus not getting is_role set"
NSQ_SOURCE_LINE 00000542 "    || $INFO{$role}{requires}"
NSQ_SOURCE_LINE 00000543 "    || $INFO{$role}{not_methods}"
NSQ_SOURCE_LINE 00000544 "    || $INFO{$role}{non_methods}"
NSQ_SOURCE_LINE 00000545 "  ));"
NSQ_SOURCE_LINE 00000546 "}"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "1;"
NSQ_SOURCE_LINE 00000549 "__END__"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "=encoding utf-8"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "=head1 NAME"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "Role::Tiny - Roles: a nouvelle cuisine portion size slice of Moose"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 " package Some::Role;"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 " use Role::Tiny;"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 " sub foo { ... }"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 " sub bar { ... }"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 " around baz => sub { ... };"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 " 1;"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "elsewhere"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 " package Some::Class;"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 " use Role::Tiny::With;"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 " # bar gets imported, but not foo"
NSQ_SOURCE_LINE 00000578 " with 'Some::Role';"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 " sub foo { ... }"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 " # baz is wrapped in the around modifier by Class::Method::Modifiers"
NSQ_SOURCE_LINE 00000583 " sub baz { ... }"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 " 1;"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "If you wanted attributes as well, look at L<Moo::Role>."
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "C<Role::Tiny> is a minimalist role composition tool."
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=head1 ROLE COMPOSITION"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "Role composition can be thought of as much more clever and meaningful multiple"
NSQ_SOURCE_LINE 00000596 "inheritance.  The basics of this implementation of roles is:"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "=over 2"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "=item *"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "If a method is already defined on a class, that method will not be composed in"
NSQ_SOURCE_LINE 00000603 "from the role. A method inherited by a class gets overridden by the role's"
NSQ_SOURCE_LINE 00000604 "method of the same name, though."
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "=item *"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "If a method that the role L</requires> to be implemented is not implemented,"
NSQ_SOURCE_LINE 00000609 "role application will fail loudly."
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "=back"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "Unlike L<Class::C3>, where the B<last> class inherited from \"wins,\" role"
NSQ_SOURCE_LINE 00000614 "composition is the other way around, where the class wins. If multiple roles"
NSQ_SOURCE_LINE 00000615 "are applied in a single call (single with statement), then if any of their"
NSQ_SOURCE_LINE 00000616 "provided methods clash, an exception is raised unless the class provides"
NSQ_SOURCE_LINE 00000617 "a method since this conflict indicates a potential problem."
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "=head2 ROLE METHODS"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "All subs created after importing Role::Tiny will be considered methods to be"
NSQ_SOURCE_LINE 00000622 "composed. For example:"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "    package MyRole;"
NSQ_SOURCE_LINE 00000625 "    use List::Util qw(min);"
NSQ_SOURCE_LINE 00000626 "    sub mysub { }"
NSQ_SOURCE_LINE 00000627 "    use Role::Tiny;"
NSQ_SOURCE_LINE 00000628 "    use List::Util qw(max);"
NSQ_SOURCE_LINE 00000629 "    sub mymethod { }"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "In this role, C<max> and C<mymethod> will be included when composing MyRole,"
NSQ_SOURCE_LINE 00000632 "and C<min> and C<mysub> will not. For additional control, L<namespace::clean>"
NSQ_SOURCE_LINE 00000633 "can be used to exclude undesired subs from roles."
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "=head1 IMPORTED SUBROUTINES"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "=head2 requires"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 " requires qw(foo bar);"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "Declares a list of methods that must be defined to compose role."
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "=head2 with"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 " with 'Some::Role1';"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 " with 'Some::Role1', 'Some::Role2';"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "Composes another role into the current role (or class via L<Role::Tiny::With>)."
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "If you have conflicts and want to resolve them in favour of Some::Role1 you"
NSQ_SOURCE_LINE 00000652 "can instead write:"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 " with 'Some::Role1';"
NSQ_SOURCE_LINE 00000655 " with 'Some::Role2';"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "If you have conflicts and want to resolve different conflicts in favour of"
NSQ_SOURCE_LINE 00000658 "different roles, please refactor your codebase."
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "=head2 before"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 " before foo => sub { ... };"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "See L<< Class::Method::Modifiers/before method(s) => sub { ... }; >> for full"
NSQ_SOURCE_LINE 00000665 "documentation."
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "Note that since you are not required to use method modifiers,"
NSQ_SOURCE_LINE 00000668 "L<Class::Method::Modifiers> is lazily loaded and we do not declare it as"
NSQ_SOURCE_LINE 00000669 "a dependency. If your L<Role::Tiny> role uses modifiers you must depend on"
NSQ_SOURCE_LINE 00000670 "both L<Class::Method::Modifiers> and L<Role::Tiny>."
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "=head2 around"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 " around foo => sub { ... };"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "See L<< Class::Method::Modifiers/around method(s) => sub { ... }; >> for full"
NSQ_SOURCE_LINE 00000677 "documentation."
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "Note that since you are not required to use method modifiers,"
NSQ_SOURCE_LINE 00000680 "L<Class::Method::Modifiers> is lazily loaded and we do not declare it as"
NSQ_SOURCE_LINE 00000681 "a dependency. If your L<Role::Tiny> role uses modifiers you must depend on"
NSQ_SOURCE_LINE 00000682 "both L<Class::Method::Modifiers> and L<Role::Tiny>."
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "=head2 after"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 " after foo => sub { ... };"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "See L<< Class::Method::Modifiers/after method(s) => sub { ... }; >> for full"
NSQ_SOURCE_LINE 00000689 "documentation."
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "Note that since you are not required to use method modifiers,"
NSQ_SOURCE_LINE 00000692 "L<Class::Method::Modifiers> is lazily loaded and we do not declare it as"
NSQ_SOURCE_LINE 00000693 "a dependency. If your L<Role::Tiny> role uses modifiers you must depend on"
NSQ_SOURCE_LINE 00000694 "both L<Class::Method::Modifiers> and L<Role::Tiny>."
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "=head2 Strict and Warnings"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "In addition to importing subroutines, using C<Role::Tiny> applies L<strict> and"
NSQ_SOURCE_LINE 00000699 "L<warnings> to the caller."
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "=head1 SUBROUTINES"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "=head2 does_role"
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 " if (Role::Tiny::does_role($foo, 'Some::Role')) {"
NSQ_SOURCE_LINE 00000706 "   ..."
NSQ_SOURCE_LINE 00000707 " }"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "Returns true if class has been composed with role."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "This subroutine is also installed as ->does on any class a Role::Tiny is"
NSQ_SOURCE_LINE 00000712 "composed into unless that class already has an ->does method, so"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "  if ($foo->does('Some::Role')) {"
NSQ_SOURCE_LINE 00000715 "    ..."
NSQ_SOURCE_LINE 00000716 "  }"
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "will work for classes but to test a role, one must use ::does_role directly."
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "Additionally, Role::Tiny will override the standard Perl C<DOES> method"
NSQ_SOURCE_LINE 00000721 "for your class. However, if C<any> class in your class' inheritance"
NSQ_SOURCE_LINE 00000722 "hierarchy provides C<DOES>, then Role::Tiny will not override it."
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "=head1 METHODS"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "=head2 make_role"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 " Role::Tiny->make_role('Some::Role');"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "Makes a package into a role, but does not export any subs into it."
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "=head2 apply_roles_to_package"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 " Role::Tiny->apply_roles_to_package("
NSQ_SOURCE_LINE 00000735 "   'Some::Package', 'Some::Role', 'Some::Other::Role'"
NSQ_SOURCE_LINE 00000736 " );"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "Composes role with package.  See also L<Role::Tiny::With>."
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "=head2 apply_roles_to_object"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 " Role::Tiny->apply_roles_to_object($foo, qw(Some::Role1 Some::Role2));"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "Composes roles in order into object directly. Object is reblessed into the"
NSQ_SOURCE_LINE 00000745 "resulting class. Note that the object's methods get overridden by the role's"
NSQ_SOURCE_LINE 00000746 "ones with the same names."
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "=head2 create_class_with_roles"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 " Role::Tiny->create_class_with_roles('Some::Base', qw(Some::Role1 Some::Role2));"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "Creates a new class based on base, with the roles composed into it in order."
NSQ_SOURCE_LINE 00000753 "New class is returned."
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "=head2 is_role"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 " Role::Tiny->is_role('Some::Role1')"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "Returns true if the given package is a role."
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "=over 4"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "=item * On perl 5.8.8 and earlier, applying a role to an object won't apply any"
NSQ_SOURCE_LINE 00000766 "overloads from the role to other copies of the object."
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "=item * On perl 5.16 and earlier, applying a role to a class won't apply any"
NSQ_SOURCE_LINE 00000769 "overloads from the role to any existing instances of the class."
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "=back"
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "L<Role::Tiny> is the attribute-less subset of L<Moo::Role>; L<Moo::Role> is"
NSQ_SOURCE_LINE 00000776 "a meta-protocol-less subset of the king of role systems, L<Moose::Role>."
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "Ovid's L<Role::Basic> provides roles with a similar scope, but without method"
NSQ_SOURCE_LINE 00000779 "modifiers, and having some extra usage restrictions."
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "mst - Matt S. Trout (cpan:MSTROUT) <mst@shadowcat.co.uk>"
NSQ_SOURCE_LINE 00000784 ""
