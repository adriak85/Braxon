NSQ_SOURCE_LINE 00000001 "package Sim;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use vars qw( $AUTOLOAD );"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Sim::Dispatcher;"
NSQ_SOURCE_LINE 00000008 "use Sim::Clock;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $VERSION = '0.03';"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our ($Clock, $Dispatcher);"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000015 "    my $self = shift;"
NSQ_SOURCE_LINE 00000016 "    my $method = $AUTOLOAD;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "    $method =~ s/.*:://;"
NSQ_SOURCE_LINE 00000019 "    return if $method eq 'DESTROY';"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "    $Clock ||= Sim::Clock->new;"
NSQ_SOURCE_LINE 00000022 "    $Dispatcher ||= Sim::Dispatcher->new(clock => $Clock);"
NSQ_SOURCE_LINE 00000023 "    $Dispatcher->$method(@_);"
NSQ_SOURCE_LINE 00000024 "}"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "1;"
NSQ_SOURCE_LINE 00000027 "__END__"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "=head1 NAME"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "Sim - Simulator engine for discrete events"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=head1 VERSION"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "This document describes Sim 0.03 released on 2 June, 2007."
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    use Sim;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    Sim->schedule("
NSQ_SOURCE_LINE 00000042 "        0.2 => sub { print \"Hi\\n\" },"
NSQ_SOURCE_LINE 00000043 "        0.4 => sub {"
NSQ_SOURCE_LINE 00000044 "            Sim->schedule("
NSQ_SOURCE_LINE 00000045 "                0.5 => sub { print \"Wow!\\n\" },"
NSQ_SOURCE_LINE 00000046 "                Sim->now + 0.2 => sub { print \"Hello!\\n\" },"
NSQ_SOURCE_LINE 00000047 "            );"
NSQ_SOURCE_LINE 00000048 "        },"
NSQ_SOURCE_LINE 00000049 "        0.5 => sub { print \"now is \", Sim->now, \"\\n\"; },"
NSQ_SOURCE_LINE 00000050 "    );"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    Sim->run( duration => 1.0 );  # upper-limit for simulation time"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    # OR: Sim->run( fires => 15 );  # upper-limit for number of event fires"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    print \"now is \", Sim->now, \"\\n\";  # now is 0.6"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "Sim is a general-purpose discrete event simulator engine written in pure"
NSQ_SOURCE_LINE 00000061 "Perl. It was originally developed as the run-core of a sequential/conbinational"
NSQ_SOURCE_LINE 00000062 "logic circuit simulator named Tesla."
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "The Sim class is just a static class wrapping around a L<Sim::Dispatcher>"
NSQ_SOURCE_LINE 00000065 "instance and a L<Sim::Clock> instance. I used AUTOLOAD to do the magic instead"
NSQ_SOURCE_LINE 00000066 "of writing a lot of boring code. It's expected that using L<Sim::Dispatcher>"
NSQ_SOURCE_LINE 00000067 "directly can be a bit faster but is certainly less convenient."
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "If you want to use a different clock model with vectorized time read,"
NSQ_SOURCE_LINE 00000070 "say a [sec, delta], which is found in a lot of EDA simulators, then you"
NSQ_SOURCE_LINE 00000071 "should use L<Sim::Dispatcher> instead of L<Sim> and define your clock class"
NSQ_SOURCE_LINE 00000072 "yourself."
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "See L<Sim::Dispatcher> for more information."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=head1 STATIC METHODS"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "All the methods of L<Sim::Dispatcher> are available for this class, but"
NSQ_SOURCE_LINE 00000079 "they are exposed as static methods only :)"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "=head1 TODO"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=over"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "=item *"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "Add cookbooks for M/M/1 and M/M/m queueing problems."
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=item *"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "Add support for vectorized timestamp (i.e. something like 3 sec + 3 * delta)."
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=item *"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "Add missing features compared to SimPy in the Python world."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=back"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=head1 BUGS"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "There must be some serious bugs lurking somewhere; if you find one,"
NSQ_SOURCE_LINE 00000102 "please consider firing off a report to"
NSQ_SOURCE_LINE 00000103 "L<http://rt.cpan.org/NoAuth/Bugs.html?Dist=Sim>."
NSQ_SOURCE_LINE 00000104 ""
