NSQ_SOURCE_LINE 00000001 "package File::MimeInfo;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use Carp;"
NSQ_SOURCE_LINE 00000006 "use Fcntl 'SEEK_SET';"
NSQ_SOURCE_LINE 00000007 "use File::Spec;"
NSQ_SOURCE_LINE 00000008 "use File::BaseDir qw/data_files/;"
NSQ_SOURCE_LINE 00000009 "require Exporter;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000012 "our @EXPORT = qw(mimetype);"
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw(extensions describe globs inodetype mimetype_canon mimetype_isa);"
NSQ_SOURCE_LINE 00000014 "our $VERSION = '0.36';"
NSQ_SOURCE_LINE 00000015 "our $DEBUG;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our ($_hashed, $_hashed_aliases, $_hashed_subclasses, $_has_mimeinfo_database);"
NSQ_SOURCE_LINE 00000018 "our (@globs, %literal, %extension, %mime2ext, %aliases, %subclasses);"
NSQ_SOURCE_LINE 00000019 "our ($LANG, @DIRS);"
NSQ_SOURCE_LINE 00000020 "# @globs = [ [ 'glob', qr//, $mime_string ], ... ]"
NSQ_SOURCE_LINE 00000021 "# %literal contains literal matches"
NSQ_SOURCE_LINE 00000022 "# %extension contains extensions (globs matching /^\\*(\\.\\w)+$/ )"
NSQ_SOURCE_LINE 00000023 "# %mime2ext is used for looking up extension by mime type"
NSQ_SOURCE_LINE 00000024 "# %aliases contains the aliases table"
NSQ_SOURCE_LINE 00000025 "# %subclasses contains the subclasses table"
NSQ_SOURCE_LINE 00000026 "# $LANG can be used to set a default language for the comments"
NSQ_SOURCE_LINE 00000027 "# @DIRS can be used to specify custom database directories"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub new { bless \\$VERSION, shift } # what else is there to bless ?"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub mimetype {"
NSQ_SOURCE_LINE 00000032 "    my $file = pop;"
NSQ_SOURCE_LINE 00000033 "    croak 'subroutine \"mimetype\" needs a filename as argument' unless defined $file;"
NSQ_SOURCE_LINE 00000034 "    return"
NSQ_SOURCE_LINE 00000035 "        inodetype($file) ||"
NSQ_SOURCE_LINE 00000036 "        globs($file)     ||"
NSQ_SOURCE_LINE 00000037 "        default($file);"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "sub inodetype {"
NSQ_SOURCE_LINE 00000041 "    my $file = pop;"
NSQ_SOURCE_LINE 00000042 "    print STDERR \"> Checking inode type\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000043 "    lstat $file or return undef;"
NSQ_SOURCE_LINE 00000044 "    return undef if -f _;"
NSQ_SOURCE_LINE 00000045 "    my $t = (-l $file) ? 'inode/symlink' :  # Win32 does not like '_' here"
NSQ_SOURCE_LINE 00000046 "        (-d _) ? 'inode/directory'   :"
NSQ_SOURCE_LINE 00000047 "        (-p _) ? 'inode/fifo'        :"
NSQ_SOURCE_LINE 00000048 "        (-c _) ? 'inode/chardevice'  :"
NSQ_SOURCE_LINE 00000049 "        (-b _) ? 'inode/blockdevice' :"
NSQ_SOURCE_LINE 00000050 "        (-S _) ? 'inode/socket'      : '' ;"
NSQ_SOURCE_LINE 00000051 "    if ($t eq 'inode/directory') { # compare devices to detect mount-points"
NSQ_SOURCE_LINE 00000052 "        my $dev = (stat _)[0]; # device of the node under investigation"
NSQ_SOURCE_LINE 00000053 "        $file = File::Spec->rel2abs($file); # get full path"
NSQ_SOURCE_LINE 00000054 "        my @dirs = File::Spec->splitdir($file);"
NSQ_SOURCE_LINE 00000055 "        $file = File::Spec->catfile(@dirs); # removes trailing '/' or equivalent"
NSQ_SOURCE_LINE 00000056 "        return $t if -l $file; # parent can be on other dev for links"
NSQ_SOURCE_LINE 00000057 "        pop @dirs;"
NSQ_SOURCE_LINE 00000058 "        my $dir = File::Spec->catdir(@dirs); # parent dir"
NSQ_SOURCE_LINE 00000059 "        $t = 'inode/mount-point' unless (stat $dir)[0] == $dev; # compare devices"
NSQ_SOURCE_LINE 00000060 "        return $t;"
NSQ_SOURCE_LINE 00000061 "    }"
NSQ_SOURCE_LINE 00000062 "    else { return $t ? $t : undef }"
NSQ_SOURCE_LINE 00000063 "}"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "sub globs {"
NSQ_SOURCE_LINE 00000066 "    my $file = pop;"
NSQ_SOURCE_LINE 00000067 "    croak 'subroutine \"globs\" needs a filename as argument' unless defined $file;"
NSQ_SOURCE_LINE 00000068 "    rehash() unless $_hashed;"
NSQ_SOURCE_LINE 00000069 "    (undef, undef, $file) = File::Spec->splitpath($file); # remove path"
NSQ_SOURCE_LINE 00000070 "    print STDERR \"> Checking globs for basename '$file'\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "    return $literal{$file} if exists $literal{$file};"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    if ($file =~ /\\.(\\w+(\\.\\w+)*)$/) {"
NSQ_SOURCE_LINE 00000075 "        my @ext = split /\\./, $1;"
NSQ_SOURCE_LINE 00000076 "        while (@ext) {"
NSQ_SOURCE_LINE 00000077 "            my $ext = join('.', @ext);"
NSQ_SOURCE_LINE 00000078 "            print STDERR \"> Checking for extension '.$ext'\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000079 "            carp \"WARNING: wantarray behaviour of globs() will change in the future.\\n\" if wantarray;"
NSQ_SOURCE_LINE 00000080 "            return wantarray"
NSQ_SOURCE_LINE 00000081 "                ? ($extension{$ext}, $ext)"
NSQ_SOURCE_LINE 00000082 "                : $extension{$ext}"
NSQ_SOURCE_LINE 00000083 "                if exists $extension{$ext};"
NSQ_SOURCE_LINE 00000084 "            shift @ext;"
NSQ_SOURCE_LINE 00000085 "        }"
NSQ_SOURCE_LINE 00000086 "    }"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "    for (@globs) {"
NSQ_SOURCE_LINE 00000089 "        next unless $file =~ $_->[1];"
NSQ_SOURCE_LINE 00000090 "        print STDERR \"> This file name matches \\\"$_->[0]\\\"\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000091 "        return $_->[2];"
NSQ_SOURCE_LINE 00000092 "    }"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    return globs(lc $file) if $file =~ /[A-Z]/; # recurs"
NSQ_SOURCE_LINE 00000095 "    return undef;"
NSQ_SOURCE_LINE 00000096 "}"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "sub default {"
NSQ_SOURCE_LINE 00000099 "    my $file = pop;"
NSQ_SOURCE_LINE 00000100 "    croak 'subroutine \"default\" needs a filename as argument' unless defined $file;"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "    my $line;"
NSQ_SOURCE_LINE 00000103 "    unless (ref $file) {"
NSQ_SOURCE_LINE 00000104 "        return undef unless -f $file;"
NSQ_SOURCE_LINE 00000105 "        print STDERR \"> File exists, trying default method\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000106 "        return 'text/plain' if -z $file;"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "        open FILE, '<', $file or return undef;"
NSQ_SOURCE_LINE 00000109 "        binmode FILE, ':utf8' unless $] < 5.008;"
NSQ_SOURCE_LINE 00000110 "        read FILE, $line, 32;"
NSQ_SOURCE_LINE 00000111 "        close FILE;"
NSQ_SOURCE_LINE 00000112 "    }"
NSQ_SOURCE_LINE 00000113 "    elsif (ref $file eq 'Path::Tiny') {"
NSQ_SOURCE_LINE 00000114 "        return undef unless $file->exists;"
NSQ_SOURCE_LINE 00000115 "        print STDERR \"> File is Path::Tiny object and exists, \""
NSQ_SOURCE_LINE 00000116 "            . \"trying default method\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000117 "        open my $fh, '<', $file or return undef;"
NSQ_SOURCE_LINE 00000118 "        binmode FILE, ':utf8' unless $] < 5.008;"
NSQ_SOURCE_LINE 00000119 "        read $fh, $line, 32;"
NSQ_SOURCE_LINE 00000120 "        close $fh;"
NSQ_SOURCE_LINE 00000121 "    }"
NSQ_SOURCE_LINE 00000122 "    else {"
NSQ_SOURCE_LINE 00000123 "        print STDERR \"> Trying default method on object\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "        $file->seek(0, SEEK_SET);"
NSQ_SOURCE_LINE 00000126 "        $file->read($line, 32);"
NSQ_SOURCE_LINE 00000127 "    }"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "    {"
NSQ_SOURCE_LINE 00000130 "        no warnings; # warnings can be thrown when input not ascii"
NSQ_SOURCE_LINE 00000131 "        if ($] < 5.008 or ! utf8::valid($line)) {"
NSQ_SOURCE_LINE 00000132 "            use bytes; # avoid invalid utf8 chars"
NSQ_SOURCE_LINE 00000133 "            $line =~ s/\\s//g; # \\m, \\n and \\t are also control chars"
NSQ_SOURCE_LINE 00000134 "            return 'text/plain' unless $line =~ /[\\x00-\\x1F\\x7F]/;"
NSQ_SOURCE_LINE 00000135 "        }"
NSQ_SOURCE_LINE 00000136 "        else {"
NSQ_SOURCE_LINE 00000137 "            # use perl to do something intelligent for ascii & utf8"
NSQ_SOURCE_LINE 00000138 "            return 'text/plain' unless $line =~ /[^[:print:]\\s]/;"
NSQ_SOURCE_LINE 00000139 "        }"
NSQ_SOURCE_LINE 00000140 "    }"
NSQ_SOURCE_LINE 00000141 "    print STDERR \"> First 10 bytes of the file contain control chars\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000142 "    return 'application/octet-stream';"
NSQ_SOURCE_LINE 00000143 "}"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "sub rehash {"
NSQ_SOURCE_LINE 00000146 "    (@globs, %literal, %extension, %mime2ext) = (); # clear all data"
NSQ_SOURCE_LINE 00000147 "    local $_; # limit scope of $_ ... :S"
NSQ_SOURCE_LINE 00000148 "    my @globfiles = @DIRS"
NSQ_SOURCE_LINE 00000149 "        ? ( grep {-e $_ && -r $_} map \"$_/globs\", @DIRS )"
NSQ_SOURCE_LINE 00000150 "        : ( reverse data_files('mime/globs')        );"
NSQ_SOURCE_LINE 00000151 "    if (@globfiles) {"
NSQ_SOURCE_LINE 00000152 "        $_has_mimeinfo_database = 1;"
NSQ_SOURCE_LINE 00000153 "    } else {"
NSQ_SOURCE_LINE 00000154 "        carp \"WARNING: You don't seem to have a mime-info database. \" ."
NSQ_SOURCE_LINE 00000155 "             \"The shared-mime-info package is available from http://freedesktop.org/\";"
NSQ_SOURCE_LINE 00000156 "    }"
NSQ_SOURCE_LINE 00000157 "    my @done;"
NSQ_SOURCE_LINE 00000158 "    for my $file (@globfiles) {"
NSQ_SOURCE_LINE 00000159 "        next if grep {$file eq $_} @done;"
NSQ_SOURCE_LINE 00000160 "        _hash_globs($file);"
NSQ_SOURCE_LINE 00000161 "        push @done, $file;"
NSQ_SOURCE_LINE 00000162 "    }"
NSQ_SOURCE_LINE 00000163 "    $_hashed = 1;"
NSQ_SOURCE_LINE 00000164 "}"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "sub _hash_globs {"
NSQ_SOURCE_LINE 00000167 "    my $file = shift;"
NSQ_SOURCE_LINE 00000168 "    open GLOB, '<', $file || croak \"Could not open file '$file' for reading\" ;"
NSQ_SOURCE_LINE 00000169 "    binmode GLOB, ':utf8' unless $] < 5.008;"
NSQ_SOURCE_LINE 00000170 "    my ($string, $glob);"
NSQ_SOURCE_LINE 00000171 "    while (<GLOB>) {"
NSQ_SOURCE_LINE 00000172 "        next if /^\\s*#/ or ! /\\S/; # skip comments and empty lines"
NSQ_SOURCE_LINE 00000173 "        chomp;"
NSQ_SOURCE_LINE 00000174 "        ($string, $glob) = split /:/, $_, 2;"
NSQ_SOURCE_LINE 00000175 "        unless ($glob =~ /[\\?\\*\\[]/) { $literal{$glob} = $string }"
NSQ_SOURCE_LINE 00000176 "        elsif ($glob =~ /^\\*\\.(\\w+(\\.\\w+)*)$/) {"
NSQ_SOURCE_LINE 00000177 "            $extension{$1} = $string unless exists $extension{$1};"
NSQ_SOURCE_LINE 00000178 "            $mime2ext{$string} = [] if !defined($mime2ext{$string});"
NSQ_SOURCE_LINE 00000179 "            push @{$mime2ext{$string}}, $1;"
NSQ_SOURCE_LINE 00000180 "        } else { unshift @globs, [$glob, _glob_to_regexp($glob), $string] }"
NSQ_SOURCE_LINE 00000181 "    }"
NSQ_SOURCE_LINE 00000182 "    close GLOB || croak \"Could not open file '$file' for reading\" ;"
NSQ_SOURCE_LINE 00000183 "}"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "sub _glob_to_regexp {"
NSQ_SOURCE_LINE 00000186 "    my $glob = shift;"
NSQ_SOURCE_LINE 00000187 "    $glob =~ s/\\./\\\\./g;"
NSQ_SOURCE_LINE 00000188 "    $glob =~ s/([?*])/.$1/g;"
NSQ_SOURCE_LINE 00000189 "    $glob =~ s/([^\\w\\/\\\\\\.\\?\\*\\[\\]])/\\\\$1/g;"
NSQ_SOURCE_LINE 00000190 "    qr/^$glob$/;"
NSQ_SOURCE_LINE 00000191 "}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "sub has_mimeinfo_database {"
NSQ_SOURCE_LINE 00000194 "    rehash() if (!$_hashed);"
NSQ_SOURCE_LINE 00000195 "    return $_has_mimeinfo_database;"
NSQ_SOURCE_LINE 00000196 "}"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "sub extensions {"
NSQ_SOURCE_LINE 00000199 "    my $mimet = mimetype_canon(pop @_);"
NSQ_SOURCE_LINE 00000200 "    rehash() unless $_hashed;"
NSQ_SOURCE_LINE 00000201 "        my $ref = $mime2ext{$mimet} if exists $mime2ext{$mimet};"
NSQ_SOURCE_LINE 00000202 "    return $ref ? @{$ref}    : undef if wantarray;"
NSQ_SOURCE_LINE 00000203 "        return $ref ? @{$ref}[0] : '';"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "sub describe {"
NSQ_SOURCE_LINE 00000207 "    shift if ref $_[0];"
NSQ_SOURCE_LINE 00000208 "    my ($mt, $lang) = @_;"
NSQ_SOURCE_LINE 00000209 "    croak 'subroutine \"describe\" needs a mimetype as argument' unless $mt;"
NSQ_SOURCE_LINE 00000210 "    $mt = mimetype_canon($mt);"
NSQ_SOURCE_LINE 00000211 "    $lang = $LANG unless defined $lang;"
NSQ_SOURCE_LINE 00000212 "    my $att =  $lang ? qq{xml:lang=\"$lang\"} : '';"
NSQ_SOURCE_LINE 00000213 "    my $desc;"
NSQ_SOURCE_LINE 00000214 "    my @descfiles = @DIRS"
NSQ_SOURCE_LINE 00000215 "        ? ( grep {-e $_ && -r $_} map \"$_/$mt.xml\", @DIRS        )"
NSQ_SOURCE_LINE 00000216 "        : ( reverse data_files('mime', split '/', \"$mt.xml\") ) ;"
NSQ_SOURCE_LINE 00000217 "    for my $file (@descfiles) {"
NSQ_SOURCE_LINE 00000218 "        $desc = ''; # if a file was found, return at least empty string"
NSQ_SOURCE_LINE 00000219 "        open XML, '<', $file || croak \"Could not open file '$file' for reading\";"
NSQ_SOURCE_LINE 00000220 "        binmode XML, ':utf8' unless $] < 5.008;"
NSQ_SOURCE_LINE 00000221 "        while (<XML>) {"
NSQ_SOURCE_LINE 00000222 "            next unless m!<comment\\s*$att>(.*?)</comment>!;"
NSQ_SOURCE_LINE 00000223 "            $desc = $1;"
NSQ_SOURCE_LINE 00000224 "            last;"
NSQ_SOURCE_LINE 00000225 "        }"
NSQ_SOURCE_LINE 00000226 "        close XML || croak \"Could not open file '$file' for reading\";"
NSQ_SOURCE_LINE 00000227 "        last if $desc;"
NSQ_SOURCE_LINE 00000228 "    }"
NSQ_SOURCE_LINE 00000229 "    return $desc;"
NSQ_SOURCE_LINE 00000230 "}"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "sub mimetype_canon {"
NSQ_SOURCE_LINE 00000233 "    my $mimet = pop;"
NSQ_SOURCE_LINE 00000234 "    croak 'mimetype_canon needs argument' unless defined $mimet;"
NSQ_SOURCE_LINE 00000235 "    rehash_aliases() unless $_hashed_aliases;"
NSQ_SOURCE_LINE 00000236 "    return exists($aliases{$mimet}) ? $aliases{$mimet} : $mimet;"
NSQ_SOURCE_LINE 00000237 "}"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "sub rehash_aliases {"
NSQ_SOURCE_LINE 00000240 "    %aliases = _read_map_files('aliases');"
NSQ_SOURCE_LINE 00000241 "    $_hashed_aliases++;"
NSQ_SOURCE_LINE 00000242 "}"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "sub _read_map_files {"
NSQ_SOURCE_LINE 00000245 "    my ($name, $list) = @_;"
NSQ_SOURCE_LINE 00000246 "    my @files = @DIRS"
NSQ_SOURCE_LINE 00000247 "        ? ( grep {-e $_ && -r $_} map \"$_/$name\", @DIRS )"
NSQ_SOURCE_LINE 00000248 "        : ( reverse data_files(\"mime/$name\")        );"
NSQ_SOURCE_LINE 00000249 "    my (@done, %map);"
NSQ_SOURCE_LINE 00000250 "    for my $file (@files) {"
NSQ_SOURCE_LINE 00000251 "        next if grep {$_ eq $file} @done;"
NSQ_SOURCE_LINE 00000252 "        open MAP, '<', $file || croak \"Could not open file '$file' for reading\";"
NSQ_SOURCE_LINE 00000253 "        binmode MAP, ':utf8' unless $] < 5.008;"
NSQ_SOURCE_LINE 00000254 "        while (my $line = <MAP>) {"
NSQ_SOURCE_LINE 00000255 "            next unless $line =~ m/\\S/; # skip empty lines"
NSQ_SOURCE_LINE 00000256 "            next if $line =~ m/^\\s*#/;  # skip comment lines"
NSQ_SOURCE_LINE 00000257 "            chomp $line;"
NSQ_SOURCE_LINE 00000258 "            my ($k, $v) = split m/\\s+/, $line, 2;"
NSQ_SOURCE_LINE 00000259 "            if ($list) {"
NSQ_SOURCE_LINE 00000260 "                $map{$k} = [] unless $map{$k};"
NSQ_SOURCE_LINE 00000261 "                push @{$map{$k}}, $v;"
NSQ_SOURCE_LINE 00000262 "            }"
NSQ_SOURCE_LINE 00000263 "            else { $map{$k} = $v }"
NSQ_SOURCE_LINE 00000264 "        }"
NSQ_SOURCE_LINE 00000265 "        close MAP;"
NSQ_SOURCE_LINE 00000266 "        push @done, $file;"
NSQ_SOURCE_LINE 00000267 "    }"
NSQ_SOURCE_LINE 00000268 "    return %map;"
NSQ_SOURCE_LINE 00000269 "}"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "sub mimetype_isa {"
NSQ_SOURCE_LINE 00000272 "    my $parent = pop || croak 'mimetype_isa needs argument';"
NSQ_SOURCE_LINE 00000273 "    my $mimet = pop;"
NSQ_SOURCE_LINE 00000274 "    if (ref $mimet or ! defined $mimet) {"
NSQ_SOURCE_LINE 00000275 "        $mimet = mimetype_canon($parent);"
NSQ_SOURCE_LINE 00000276 "        undef $parent;"
NSQ_SOURCE_LINE 00000277 "    }"
NSQ_SOURCE_LINE 00000278 "    else {"
NSQ_SOURCE_LINE 00000279 "        $mimet = mimetype_canon($mimet);"
NSQ_SOURCE_LINE 00000280 "        $parent = mimetype_canon($parent);"
NSQ_SOURCE_LINE 00000281 "    }"
NSQ_SOURCE_LINE 00000282 "    rehash_subclasses() unless $_hashed_subclasses;"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    my @subc;"
NSQ_SOURCE_LINE 00000285 "    push @subc, 'inode/directory' if $mimet eq 'inode/mount-point';"
NSQ_SOURCE_LINE 00000286 "    push @subc, @{$subclasses{$mimet}} if exists $subclasses{$mimet};"
NSQ_SOURCE_LINE 00000287 "    push @subc, 'text/plain' if $mimet =~ m#^text/#;"
NSQ_SOURCE_LINE 00000288 "    push @subc, 'application/octet-stream' unless $mimet =~ m#^inode/#;"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "    return $parent ? scalar(grep {$_ eq $parent} @subc) : @subc;"
NSQ_SOURCE_LINE 00000291 "}"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "sub rehash_subclasses {"
NSQ_SOURCE_LINE 00000294 "    %subclasses = _read_map_files('subclasses', 'LIST');"
NSQ_SOURCE_LINE 00000295 "    $_hashed_subclasses++;"
NSQ_SOURCE_LINE 00000296 "}"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "1;"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "__END__"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=head1 NAME"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "File::MimeInfo - Determine file type from the file name"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "  use File::MimeInfo;"
NSQ_SOURCE_LINE 00000309 "  my $mime_type = mimetype($file);"
NSQ_SOURCE_LINE 00000310 "  my $mime_type2 = mimetype('test.png');"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "This module can be used to determine the mime type of a file. It"
NSQ_SOURCE_LINE 00000315 "tries to implement the freedesktop specification for a shared"
NSQ_SOURCE_LINE 00000316 "MIME database."
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "For this module shared-mime-info-spec 0.13 was used."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "This package only uses the globs file. No real magic checking is"
NSQ_SOURCE_LINE 00000321 "used. The L<File::MimeInfo::Magic> package is provided for magic typing."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "If you want to determine the mimetype of data in a memory buffer you should"
NSQ_SOURCE_LINE 00000324 "use L<File::MimeInfo::Magic> in combination with L<IO::Scalar>."
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "This module loads the various data files when needed. If you want to"
NSQ_SOURCE_LINE 00000327 "hash data earlier see the C<rehash> methods below."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=head1 EXPORT"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "The method C<mimetype> is exported by default."
NSQ_SOURCE_LINE 00000332 "The methods C<inodetype>, C<globs>, C<extensions>, C<describe>,"
NSQ_SOURCE_LINE 00000333 "C<mimetype_canon> and C<mimetype_isa> can be exported on demand."
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "=head1 METHODS"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=over 4"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "=item C<new()>"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "Simple constructor to allow Object Oriented use of this module."
NSQ_SOURCE_LINE 00000342 "If you want to use this, include the package as C<use File::MimeInfo ();>"
NSQ_SOURCE_LINE 00000343 "to avoid importing sub C<mimetype()>."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=item C<mimetype($file)>"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "Returns a mimetype string for C<$file>, returns undef on failure."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "This method bundles C<inodetype> and C<globs>."
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "If these methods are unsuccessful the file is read and the mimetype defaults"
NSQ_SOURCE_LINE 00000352 "to 'text/plain' or to 'application/octet-stream' when the first ten chars"
NSQ_SOURCE_LINE 00000353 "of the file match ascii control chars (white spaces excluded)."
NSQ_SOURCE_LINE 00000354 "If the file doesn't exist or isn't readable C<undef> is returned."
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "=item C<inodetype($file)>"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "Returns a mimetype in the 'inode' namespace or undef when the file is"
NSQ_SOURCE_LINE 00000359 "actually a normal file."
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=item C<globs($file)>"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "Returns a mimetype string for C<$file> based on the filename and filename extensions."
NSQ_SOURCE_LINE 00000364 "Returns undef on failure. The file doesn't need to exist."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "Behaviour in list context (wantarray) is unspecified and will change in future"
NSQ_SOURCE_LINE 00000367 "releases."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=item C<default($file)>"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "This method decides whether a file is binary or plain text by looking at"
NSQ_SOURCE_LINE 00000372 "the first few bytes in the file. Used to decide between \"text/plain\" and"
NSQ_SOURCE_LINE 00000373 "\"application/octet-stream\" if all other methods have failed."
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "The spec states that we should check for the ascii control chars and let"
NSQ_SOURCE_LINE 00000376 "higher bit chars pass to allow utf8. We try to be more intelligent using"
NSQ_SOURCE_LINE 00000377 "perl utf8 support."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=item C<extensions($mimetype)>"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "In list context, returns the list of filename extensions that map to the given mimetype."
NSQ_SOURCE_LINE 00000382 "In scalar context, returns the first extension that is found in the database"
NSQ_SOURCE_LINE 00000383 "for this mimetype."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=item C<describe($mimetype, $lang)>"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "Returns a description of this mimetype as supplied by the mime info database."
NSQ_SOURCE_LINE 00000388 "You can specify a language with the optional parameter C<$lang>, this should be"
NSQ_SOURCE_LINE 00000389 "the two letter language code used in the xml files. Also you can set the global"
NSQ_SOURCE_LINE 00000390 "variable C<$File::MimeInfo::LANG> to specify a language."
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "This method returns undef when no xml file was found (i.e. the mimetype"
NSQ_SOURCE_LINE 00000393 "doesn't exist in the database). It returns an empty string when the xml file doesn't"
NSQ_SOURCE_LINE 00000394 "contain a description in the language you specified."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "I<Currently no real xml parsing is done, it trusts the xml files are nicely formatted.>"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "=item C<mimetype_canon($mimetype)>"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "Returns the canonical mimetype for a given mimetype."
NSQ_SOURCE_LINE 00000401 "Deprecated mimetypes are typically aliased to their canonical variants."
NSQ_SOURCE_LINE 00000402 "This method only checks aliases, doesn't check whether the mimetype"
NSQ_SOURCE_LINE 00000403 "exists."
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "Use this method as a filter when you take a mimetype as input."
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=item C<mimetype_isa($mimetype)>"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "=item C<mimetype_isa($mimetype, $mimetype)>"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "When give only one argument this method returns a list with mimetypes that are parent"
NSQ_SOURCE_LINE 00000412 "classes for this mimetype."
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "When given two arguments returns true if the second mimetype is a parent class of"
NSQ_SOURCE_LINE 00000415 "the first one."
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "This method checks the subclasses table and applies a few rules for implicit"
NSQ_SOURCE_LINE 00000418 "subclasses."
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "=item C<has_mimeinfo_database()>"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "Check if there are mimeinfo database files available; returns 1 on success."
NSQ_SOURCE_LINE 00000423 "If you don't have the shared-mime-info package installed or not in the PATH or"
NSQ_SOURCE_LINE 00000424 "C<@File::MimeInfo::DIRS> does not contain database directories, you will not get"
NSQ_SOURCE_LINE 00000425 "the successful reply."
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "New in version 0.30."
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "=item C<rehash()>"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "Rehash the data files. Glob information is preparsed when this method is called."
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "If you want to by-pass the XDG basedir system you can specify your database"
NSQ_SOURCE_LINE 00000434 "directories by setting C<@File::MimeInfo::DIRS>. But normally it is better to"
NSQ_SOURCE_LINE 00000435 "change the XDG basedir environment variables."
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=item C<rehash_aliases()>"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "Rehashes the F<mime/aliases> files."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=item C<rehash_subclasses()>"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "Rehashes the F<mime/subclasses> files."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=back"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "=head1 DIAGNOSTICS"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "This module throws an exception when it can't find any data files, when it can't"
NSQ_SOURCE_LINE 00000450 "open a data file it found for reading or when a subroutine doesn't get enough arguments."
NSQ_SOURCE_LINE 00000451 "In the first case you either don't have the freedesktop mime info database installed,"
NSQ_SOURCE_LINE 00000452 "or your environment variables point to the wrong places,"
NSQ_SOURCE_LINE 00000453 "in the second case you have the database installed, but it is broken"
NSQ_SOURCE_LINE 00000454 "(the mime info database should logically be world readable)."
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "=head1 TODO"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "Make an option for using some caching mechanism to reduce init time."
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "Make C<describe()> use real xml parsing ?"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "Perl versions prior to 5.8.0 do not have the ':utf8' IO Layer, thus"
NSQ_SOURCE_LINE 00000465 "for the default method and for reading the xml files"
NSQ_SOURCE_LINE 00000466 "utf8 is not supported for these versions."
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "Since it is not possible to distinguish between encoding types (utf8, latin1, latin2 etc.)"
NSQ_SOURCE_LINE 00000469 "in a straightforward manner only utf8 is supported (because the spec recommends this)."
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "This module does not yet check extended attributes for a mimetype."
NSQ_SOURCE_LINE 00000472 "Patches for this are very welcome."
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "This module uses the FreeDesktop.org shared mime info database. On your desktop"
NSQ_SOURCE_LINE 00000475 "linux this is typically pre-installed so it's not a problem. On your server"
NSQ_SOURCE_LINE 00000476 "you can install the shared-mime-info package via apt or dnf or apk or whatnot."
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "To install on macOS, you can install it like this:"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "    brew install shared-mime-info"
NSQ_SOURCE_LINE 00000481 ""
