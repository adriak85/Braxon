NSQ_SOURCE_LINE 00000013 "our $VERSION;"
NSQ_SOURCE_LINE 00000014 "$VERSION='6.99';"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our (@ISA,@EXPORT);"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "my $backend;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "if ((exists $ENV{'DATE_MANIP'}  &&  $ENV{'DATE_MANIP'} eq 'DM5') ||"
NSQ_SOURCE_LINE 00000021 "    (defined $Date::Manip::Backend  &&  $Date::Manip::Backend eq 'DM5')) {"
NSQ_SOURCE_LINE 00000022 "   $backend = 'Date::Manip::DM5';"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "} elsif ($] >= 5.010) {"
NSQ_SOURCE_LINE 00000025 "   $backend = 'Date::Manip::DM6';"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "} else {"
NSQ_SOURCE_LINE 00000028 "   $backend = 'Date::Manip::DM5';"
NSQ_SOURCE_LINE 00000029 "}"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "my $backend_exp = $backend . \"::EXPORT\";"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "my $flag = eval \"require $backend; $backend->import(); return 'loaded';\";"
NSQ_SOURCE_LINE 00000034 "if (! $flag) {"
NSQ_SOURCE_LINE 00000035 "   die \"ERROR LOADING MODULE: $backend\";"
NSQ_SOURCE_LINE 00000036 "}"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "{"
NSQ_SOURCE_LINE 00000039 "   no strict 'refs';"
NSQ_SOURCE_LINE 00000040 "   @EXPORT = @{ $backend_exp };"
NSQ_SOURCE_LINE 00000041 "}"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "unshift (@ISA, $backend);"
