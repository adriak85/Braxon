NSQ_SOURCE_LINE 00000001 "package Text::Table::XLSX;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2018-09-23'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.001'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "sub table {"
NSQ_SOURCE_LINE 00000011 "    require File::Temp;"
NSQ_SOURCE_LINE 00000012 "    require Spreadsheet::GenerateXLSX;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "    my %params = @_;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "    $params{rows} or die \"Must provide rows!\";"
NSQ_SOURCE_LINE 00000017 "    my $rows = $params{header_row} ? $params{rows} : do {"
NSQ_SOURCE_LINE 00000018 "        my @rows = @{ $params{rows} };"
NSQ_SOURCE_LINE 00000019 "        shift @rows;"
NSQ_SOURCE_LINE 00000020 "        \\@rows;"
NSQ_SOURCE_LINE 00000021 "    };"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    my (undef, $fname) = File::Temp::tempfile();"
NSQ_SOURCE_LINE 00000024 "    Spreadsheet::GenerateXLSX::generate_xlsx($fname, $rows);"
NSQ_SOURCE_LINE 00000025 "    open my $fh, \"<:bytes\", $fname or die \"Can't open $fname: $!\";"
NSQ_SOURCE_LINE 00000026 "    local $/;"
NSQ_SOURCE_LINE 00000027 "    scalar <$fh>;"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "1;"
NSQ_SOURCE_LINE 00000031 "# ABSTRACT: Generate XLSX worksheet"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "__END__"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "=pod"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=head1 NAME"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "Text::Table::XLSX - Generate XLSX worksheet"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=head1 VERSION"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "This document describes version 0.001 of Text::Table::XLSX (from Perl distribution Text-Table-XLSX), released on 2018-09-23."
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 " use Text::Table::XLSX;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 " my $rows = ["
NSQ_SOURCE_LINE 00000052 "     # header row"
NSQ_SOURCE_LINE 00000053 "     ['Name', 'Rank', 'Serial'],"
NSQ_SOURCE_LINE 00000054 "     # rows"
NSQ_SOURCE_LINE 00000055 "     ['alice', 'pvt', '123456'],"
NSQ_SOURCE_LINE 00000056 "     ['bob',   'cpl', '98765321'],"
NSQ_SOURCE_LINE 00000057 "     ['carol', 'brig gen', '8745'],"
NSQ_SOURCE_LINE 00000058 " ];"
NSQ_SOURCE_LINE 00000059 " print Text::Table::XLSX::table(rows => $rows, header_row => 1);"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "This module provides a single function, C<table>, which takes a two-dimensional"
NSQ_SOURCE_LINE 00000064 "array of data and generate an XLSX data stream from it. It's basically a very"
NSQ_SOURCE_LINE 00000065 "thin wrapper for L<Spreadsheet::GenerateXLSX>."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=for Pod::Coverage ^(.+)$"
NSQ_SOURCE_LINE 00000068 ""
