NSQ_SOURCE_LINE 00000001 "package Test::YAML;"
NSQ_SOURCE_LINE 00000002 "our $VERSION = '1.07';"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "use Test::Base -Base;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $YAML    = 'YAML';"
NSQ_SOURCE_LINE 00000007 "our @EXPORT  = qw("
NSQ_SOURCE_LINE 00000008 "    no_diff"
NSQ_SOURCE_LINE 00000009 "    run_yaml_tests"
NSQ_SOURCE_LINE 00000010 "    run_roundtrip_nyn roundtrip_nyn"
NSQ_SOURCE_LINE 00000011 "    run_load_passes load_passes"
NSQ_SOURCE_LINE 00000012 "    dumper Load Dump LoadFile DumpFile"
NSQ_SOURCE_LINE 00000013 "    XXX"
NSQ_SOURCE_LINE 00000014 ");"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "delimiters('===', '+++');"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub Dump     () { YAML(Dump => @_)     }"
NSQ_SOURCE_LINE 00000019 "sub Load     () { YAML(Load => @_)     }"
NSQ_SOURCE_LINE 00000020 "sub DumpFile () { YAML(DumpFile => @_) }"
NSQ_SOURCE_LINE 00000021 "sub LoadFile () { YAML(LoadFile => @_) }"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub YAML () {"
NSQ_SOURCE_LINE 00000024 "    load_yaml_pm();"
NSQ_SOURCE_LINE 00000025 "    my $meth = shift;"
NSQ_SOURCE_LINE 00000026 "    my $code = $YAML->can($meth) or die \"$YAML cannot do $meth\";"
NSQ_SOURCE_LINE 00000027 "    goto &$code;"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "sub load_yaml_pm {"
NSQ_SOURCE_LINE 00000031 "    my $file = \"$YAML.pm\";"
NSQ_SOURCE_LINE 00000032 "    $file =~ s{::}{/}g;"
NSQ_SOURCE_LINE 00000033 "    require $file;"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub run_yaml_tests() {"
NSQ_SOURCE_LINE 00000037 "    run {"
NSQ_SOURCE_LINE 00000038 "        my $block = shift;"
NSQ_SOURCE_LINE 00000039 "        &{_get_function($block)}($block) unless"
NSQ_SOURCE_LINE 00000040 "          _skip_tests_for_now($block) or"
NSQ_SOURCE_LINE 00000041 "          _skip_yaml_tests($block);"
NSQ_SOURCE_LINE 00000042 "    };"
NSQ_SOURCE_LINE 00000043 "}"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "sub run_roundtrip_nyn() {"
NSQ_SOURCE_LINE 00000046 "    my @options = @_;"
NSQ_SOURCE_LINE 00000047 "    run {"
NSQ_SOURCE_LINE 00000048 "        my $block = shift;"
NSQ_SOURCE_LINE 00000049 "        roundtrip_nyn($block, @options);"
NSQ_SOURCE_LINE 00000050 "    };"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "sub roundtrip_nyn() {"
NSQ_SOURCE_LINE 00000054 "    my $block = shift;"
NSQ_SOURCE_LINE 00000055 "    my $option = shift || '';"
NSQ_SOURCE_LINE 00000056 "    die \"'perl' data section required\""
NSQ_SOURCE_LINE 00000057 "        unless exists $block->{perl};"
NSQ_SOURCE_LINE 00000058 "    my @values = eval $block->perl;"
NSQ_SOURCE_LINE 00000059 "    die \"roundtrip_nyn eval perl error: $@\" if $@;"
NSQ_SOURCE_LINE 00000060 "    my $config = $block->config || '';"
NSQ_SOURCE_LINE 00000061 "    my $result = eval \"$config; Dump(\\@values)\";"
NSQ_SOURCE_LINE 00000062 "    die \"roundtrip_nyn YAML::Dump error: $@\" if $@;"
NSQ_SOURCE_LINE 00000063 "    if (exists $block->{yaml}) {"
NSQ_SOURCE_LINE 00000064 "        is $result, $block->yaml,"
NSQ_SOURCE_LINE 00000065 "            $block->description . ' (n->y)';"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 "    else {"
NSQ_SOURCE_LINE 00000068 "        pass $block->description . ' (n->y)';"
NSQ_SOURCE_LINE 00000069 "    }"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "    return if exists $block->{no_round_trip} or"
NSQ_SOURCE_LINE 00000072 "        not exists $block->{yaml};"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    if ($option eq 'dumper') {"
NSQ_SOURCE_LINE 00000075 "        is dumper(Load($block->yaml)), dumper(@values),"
NSQ_SOURCE_LINE 00000076 "            $block->description . ' (y->n)';"
NSQ_SOURCE_LINE 00000077 "    }"
NSQ_SOURCE_LINE 00000078 "    else {"
NSQ_SOURCE_LINE 00000079 "        is_deeply [Load($block->yaml)], [@values],"
NSQ_SOURCE_LINE 00000080 "            $block->description . ' (y->n)';"
NSQ_SOURCE_LINE 00000081 "    }"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "sub count_roundtrip_nyn() {"
NSQ_SOURCE_LINE 00000085 "    my $block = shift or die \"Bad call to count_roundtrip_nyn\";"
NSQ_SOURCE_LINE 00000086 "    return 1 if exists $block->{skip_this_for_now};"
NSQ_SOURCE_LINE 00000087 "    my $count = 0;"
NSQ_SOURCE_LINE 00000088 "    $count++ if exists $block->{perl};"
NSQ_SOURCE_LINE 00000089 "    $count++ unless exists $block->{no_round_trip} or"
NSQ_SOURCE_LINE 00000090 "        not exists $block->{yaml};"
NSQ_SOURCE_LINE 00000091 "    die \"Invalid test definition\" unless $count;"
NSQ_SOURCE_LINE 00000092 "    return $count;"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub run_load_passes() {"
NSQ_SOURCE_LINE 00000096 "    run {"
NSQ_SOURCE_LINE 00000097 "        my $block = shift;"
NSQ_SOURCE_LINE 00000098 "        my $yaml = $block->yaml;"
NSQ_SOURCE_LINE 00000099 "        eval { YAML(Load => $yaml) };"
NSQ_SOURCE_LINE 00000100 "        is(\"$@\", \"\");"
NSQ_SOURCE_LINE 00000101 "    };"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub load_passes() {"
NSQ_SOURCE_LINE 00000105 "    my $block = shift;"
NSQ_SOURCE_LINE 00000106 "    my $yaml = $block->yaml;"
NSQ_SOURCE_LINE 00000107 "    eval { YAML(Load => $yaml) };"
NSQ_SOURCE_LINE 00000108 "    is \"$@\", \"\", $block->description;"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "sub count_load_passes() {1}"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "sub dumper() {"
NSQ_SOURCE_LINE 00000114 "    require Data::Dumper;"
NSQ_SOURCE_LINE 00000115 "    $Data::Dumper::Sortkeys = 1;"
NSQ_SOURCE_LINE 00000116 "    $Data::Dumper::Terse = 1;"
NSQ_SOURCE_LINE 00000117 "    $Data::Dumper::Indent = 1;"
NSQ_SOURCE_LINE 00000118 "    return Data::Dumper::Dumper(@_);"
NSQ_SOURCE_LINE 00000119 "}"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "sub _count_tests() {"
NSQ_SOURCE_LINE 00000122 "    my $block = shift or die \"Bad call to _count_tests\";"
NSQ_SOURCE_LINE 00000123 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000124 "    &{'count_' . _get_function_name($block)}($block);"
NSQ_SOURCE_LINE 00000125 "}"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "sub _get_function_name() {"
NSQ_SOURCE_LINE 00000128 "    my $block = shift;"
NSQ_SOURCE_LINE 00000129 "    return $block->function || 'roundtrip_nyn';"
NSQ_SOURCE_LINE 00000130 "}"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "sub _get_function() {"
NSQ_SOURCE_LINE 00000133 "    my $block = shift;"
NSQ_SOURCE_LINE 00000134 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000135 "    \\ &{_get_function_name($block)};"
NSQ_SOURCE_LINE 00000136 "}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "sub _skip_tests_for_now() {"
NSQ_SOURCE_LINE 00000139 "    my $block = shift;"
NSQ_SOURCE_LINE 00000140 "    if (exists $block->{skip_this_for_now}) {"
NSQ_SOURCE_LINE 00000141 "        _skip_test("
NSQ_SOURCE_LINE 00000142 "            $block->description,"
NSQ_SOURCE_LINE 00000143 "            _count_tests($block),"
NSQ_SOURCE_LINE 00000144 "        );"
NSQ_SOURCE_LINE 00000145 "        return 1;"
NSQ_SOURCE_LINE 00000146 "    }"
NSQ_SOURCE_LINE 00000147 "    return 0;"
NSQ_SOURCE_LINE 00000148 "}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "sub _skip_yaml_tests() {"
NSQ_SOURCE_LINE 00000151 "    my $block = shift;"
NSQ_SOURCE_LINE 00000152 "    if ($block->skip_unless_modules) {"
NSQ_SOURCE_LINE 00000153 "        my @modules = split /[\\s\\,]+/, $block->skip_unless_modules;"
NSQ_SOURCE_LINE 00000154 "        for my $module (@modules) {"
NSQ_SOURCE_LINE 00000155 "            eval \"require $module\";"
NSQ_SOURCE_LINE 00000156 "            if ($@) {"
NSQ_SOURCE_LINE 00000157 "                _skip_test("
NSQ_SOURCE_LINE 00000158 "                    \"This test requires the '$module' module\","
NSQ_SOURCE_LINE 00000159 "                    _count_tests($block),"
NSQ_SOURCE_LINE 00000160 "                );"
NSQ_SOURCE_LINE 00000161 "                return 1;"
NSQ_SOURCE_LINE 00000162 "            }"
NSQ_SOURCE_LINE 00000163 "        }"
NSQ_SOURCE_LINE 00000164 "    }"
NSQ_SOURCE_LINE 00000165 "    return 0;"
NSQ_SOURCE_LINE 00000166 "}"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "sub _skip_test() {"
NSQ_SOURCE_LINE 00000169 "    my ($message, $count) = @_;"
NSQ_SOURCE_LINE 00000170 "    SKIP: {"
NSQ_SOURCE_LINE 00000171 "        skip($message, $count);"
NSQ_SOURCE_LINE 00000172 "    }"
NSQ_SOURCE_LINE 00000173 "}"
NSQ_SOURCE_LINE 00000174 ""
