NSQ_SOURCE_LINE 00000191 "sub Load { goto &Test::YAML::Load }"
NSQ_SOURCE_LINE 00000192 "sub DumpFile { goto &Test::YAML::DumpFile }"
NSQ_SOURCE_LINE 00000193 "sub LoadFile { goto &Test::YAML::LoadFile }"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "sub yaml_load_or_fail {"
NSQ_SOURCE_LINE 00000196 "    my ($result, $error, $warning) ="
NSQ_SOURCE_LINE 00000197 "      $self->_yaml_load_result_error_warning(@_);"
NSQ_SOURCE_LINE 00000198 "    return $error || $result;"
NSQ_SOURCE_LINE 00000199 "}"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "sub yaml_load_error_or_warning {"
NSQ_SOURCE_LINE 00000202 "    my ($result, $error, $warning) ="
NSQ_SOURCE_LINE 00000203 "      $self->_yaml_load_result_error_warning(@_);"
NSQ_SOURCE_LINE 00000204 "    return $error || $warning || '';"
NSQ_SOURCE_LINE 00000205 "}"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "sub perl_eval_error_or_warning {"
NSQ_SOURCE_LINE 00000208 "    my ($result, $error, $warning) ="
NSQ_SOURCE_LINE 00000209 "      $self->_perl_eval_result_error_warning(@_);"
NSQ_SOURCE_LINE 00000210 "    return $error || $warning || '';"
NSQ_SOURCE_LINE 00000211 "}"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "sub _yaml_load_result_error_warning {"
NSQ_SOURCE_LINE 00000214 "    $self->assert_scalar(@_);"
NSQ_SOURCE_LINE 00000215 "    my $yaml = shift;"
NSQ_SOURCE_LINE 00000216 "    my $warning = '';"
NSQ_SOURCE_LINE 00000217 "    local $SIG{__WARN__} = sub { $warning = join '', @_ };"
NSQ_SOURCE_LINE 00000218 "    my $result = eval {"
NSQ_SOURCE_LINE 00000219 "        $self->yaml_load($yaml);"
NSQ_SOURCE_LINE 00000220 "    };"
NSQ_SOURCE_LINE 00000221 "    return ($result, $@, $warning);"
NSQ_SOURCE_LINE 00000222 "}"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "sub _perl_eval_result_error_warning {"
NSQ_SOURCE_LINE 00000225 "    $self->assert_scalar(@_);"
NSQ_SOURCE_LINE 00000226 "    my $perl = shift;"
NSQ_SOURCE_LINE 00000227 "    my $warning = '';"
NSQ_SOURCE_LINE 00000228 "    local $SIG{__WARN__} = sub { $warning = join '', @_ };"
NSQ_SOURCE_LINE 00000229 "    my $result = eval $perl;"
NSQ_SOURCE_LINE 00000230 "    return ($result, $@, $warning);"
NSQ_SOURCE_LINE 00000231 "}"
