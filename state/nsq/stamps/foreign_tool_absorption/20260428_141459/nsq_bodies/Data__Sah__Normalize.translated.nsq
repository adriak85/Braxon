BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Data::Sah::Normalize;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2021-07-29'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Data-Sah-Normalize'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.051'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "require Exporter;"
NSQ_SOURCE_LINE 00000013 "our @ISA       = qw(Exporter);"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000015 "                       normalize_clset"
NSQ_SOURCE_LINE 00000016 "                       normalize_schema"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "                       $type_re"
NSQ_SOURCE_LINE 00000019 "                       $clause_name_re"
NSQ_SOURCE_LINE 00000020 "                       $clause_re"
NSQ_SOURCE_LINE 00000021 "                       $attr_re"
NSQ_SOURCE_LINE 00000022 "                       $funcset_re"
NSQ_SOURCE_LINE 00000023 "                       $compiler_re"
NSQ_SOURCE_LINE 00000024 "               );"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "our $type_re        = qr/\\A(?:[A-Za-z_]\\w*::)*[A-Za-z_]\\w*\\z/;"
NSQ_SOURCE_LINE 00000027 "our $clause_name_re = qr/\\A[A-Za-z_]\\w*\\z/;"
NSQ_SOURCE_LINE 00000028 "our $clause_re      = qr/\\A[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*\\z/;"
NSQ_SOURCE_LINE 00000029 "our $attr_re        = $clause_re;"
NSQ_SOURCE_LINE 00000030 "our $funcset_re     = qr/\\A(?:[A-Za-z_]\\w*::)*[A-Za-z_]\\w*\\z/;"
NSQ_SOURCE_LINE 00000031 "our $compiler_re    = qr/\\A[A-Za-z_]\\w*\\z/;"
NSQ_SOURCE_LINE 00000032 "our $clause_attr_on_empty_clause_re = qr/\\A(?:\\.[A-Za-z_]\\w*)+\\z/;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub normalize_clset($;$) {"
NSQ_SOURCE_LINE 00000035 "    my ($clset0, $opts) = @_;"
NSQ_SOURCE_LINE 00000036 "    $opts //= {};"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    my $clset = {};"
NSQ_SOURCE_LINE 00000039 "    for my $c (sort keys %$clset0) {"
NSQ_SOURCE_LINE 00000040 "        my $c0 = $c;"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "        my $v = $clset0->{$c};"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "        # ignore expression"
NSQ_SOURCE_LINE 00000045 "        my $expr;"
NSQ_SOURCE_LINE 00000046 "        if ($c =~ s/=\\z//) {"
NSQ_SOURCE_LINE 00000047 "            $expr++;"
NSQ_SOURCE_LINE 00000048 "            # XXX currently can't disregard merge prefix when checking"
NSQ_SOURCE_LINE 00000049 "            # conflict"
NSQ_SOURCE_LINE 00000050 "            die \"Conflict between '$c=' and '$c'\" if exists $clset0->{$c};"
NSQ_SOURCE_LINE 00000051 "            $clset->{\"$c.is_expr\"} = 1;"
NSQ_SOURCE_LINE 00000052 "            }"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "        my $sc = \"\";"
NSQ_SOURCE_LINE 00000055 "        my $cn;"
NSQ_SOURCE_LINE 00000056 "        {"
NSQ_SOURCE_LINE 00000057 "            my $errp = \"Invalid clause name syntax '$c0'\"; # error prefix"
NSQ_SOURCE_LINE 00000058 "            if (!$expr && $c =~ s/\\A!(?=.)//) {"
NSQ_SOURCE_LINE 00000059 "                die \"$errp, syntax should be !CLAUSE\""
NSQ_SOURCE_LINE 00000060 "                    unless $c =~ $clause_name_re;"
NSQ_SOURCE_LINE 00000061 "                $sc = \"!\";"
NSQ_SOURCE_LINE 00000062 "            } elsif (!$expr && $c =~ s/(?<=.)\\|\\z//) {"
NSQ_SOURCE_LINE 00000063 "                die \"$errp, syntax should be CLAUSE|\""
NSQ_SOURCE_LINE 00000064 "                    unless $c =~ $clause_name_re;"
NSQ_SOURCE_LINE 00000065 "                $sc = \"|\";"
NSQ_SOURCE_LINE 00000066 "            } elsif (!$expr && $c =~ s/(?<=.)\\&\\z//) {"
NSQ_SOURCE_LINE 00000067 "                die \"$errp, syntax should be CLAUSE&\""
NSQ_SOURCE_LINE 00000068 "                    unless $c =~ $clause_name_re;"
NSQ_SOURCE_LINE 00000069 "                $sc = \"&\";"
NSQ_SOURCE_LINE 00000070 "            } elsif (!$expr && $c =~ /\\A([^.]+)(?:\\.(.+))?\\((\\w+)\\)\\z/) {"
NSQ_SOURCE_LINE 00000071 "                my ($c2, $a, $lang) = ($1, $2, $3);"
NSQ_SOURCE_LINE 00000072 "                die \"$errp, syntax should be CLAUSE(LANG) or C.ATTR(LANG)\""
NSQ_SOURCE_LINE 00000073 "                    unless $c2 =~ $clause_name_re &&"
NSQ_SOURCE_LINE 00000074 "                        (!defined($a) || $a =~ $attr_re);"
NSQ_SOURCE_LINE 00000075 "                $sc = \"(LANG)\";"
NSQ_SOURCE_LINE 00000076 "                $cn = $c2 . (defined($a) ? \".$a\" : \"\") . \".alt.lang.$lang\";"
NSQ_SOURCE_LINE 00000077 "            } elsif ($c !~ $clause_re &&"
NSQ_SOURCE_LINE 00000078 "                         $c !~ $clause_attr_on_empty_clause_re) {"
NSQ_SOURCE_LINE 00000079 "                die \"$errp, please use letter/digit/underscore only\";"
NSQ_SOURCE_LINE 00000080 "            }"
NSQ_SOURCE_LINE 00000081 "        }"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "        # XXX can't disregard merge prefix when checking conflict"
NSQ_SOURCE_LINE 00000084 "        if ($sc eq '!') {"
NSQ_SOURCE_LINE 00000085 "            die \"Conflict between clause shortcuts '!$c' and '$c'\""
NSQ_SOURCE_LINE 00000086 "                if exists $clset0->{$c};"
NSQ_SOURCE_LINE 00000087 "            die \"Conflict between clause shortcuts '!$c' and '$c|'\""
NSQ_SOURCE_LINE 00000088 "                if exists $clset0->{\"$c|\"};"
NSQ_SOURCE_LINE 00000089 "            die \"Conflict between clause shortcuts '!$c' and '$c&'\""
NSQ_SOURCE_LINE 00000090 "                if exists $clset0->{\"$c&\"};"
NSQ_SOURCE_LINE 00000091 "            $clset->{$c} = $v;"
NSQ_SOURCE_LINE 00000092 "            $clset->{\"$c.op\"} = \"not\";"
NSQ_SOURCE_LINE 00000093 "        } elsif ($sc eq '&') {"
NSQ_SOURCE_LINE 00000094 "            die \"Conflict between clause shortcuts '$c&' and '$c'\""
NSQ_SOURCE_LINE 00000095 "                if exists $clset0->{$c};"
NSQ_SOURCE_LINE 00000096 "            die \"Conflict between clause shortcuts '$c&' and '$c|'\""
NSQ_SOURCE_LINE 00000097 "                if exists $clset0->{\"$c|\"};"
NSQ_SOURCE_LINE 00000098 "            die \"Clause 'c&' value must be an array\""
NSQ_SOURCE_LINE 00000099 "                unless ref($v) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000100 "            $clset->{$c} = $v;"
NSQ_SOURCE_LINE 00000101 "            $clset->{\"$c.op\"} = \"and\";"
NSQ_SOURCE_LINE 00000102 "        } elsif ($sc eq '|') {"
NSQ_SOURCE_LINE 00000103 "            die \"Conflict between clause shortcuts '$c|' and '$c'\""
NSQ_SOURCE_LINE 00000104 "                if exists $clset0->{$c};"
NSQ_SOURCE_LINE 00000105 "            die \"Clause 'c|' value must be an array\""
NSQ_SOURCE_LINE 00000106 "                unless ref($v) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000107 "            $clset->{$c} = $v;"
NSQ_SOURCE_LINE 00000108 "            $clset->{\"$c.op\"} = \"or\";"
NSQ_SOURCE_LINE 00000109 "        } elsif ($sc eq '(LANG)') {"
NSQ_SOURCE_LINE 00000110 "            die \"Conflict between clause '$c' and '$cn'\""
NSQ_SOURCE_LINE 00000111 "                if exists $clset0->{$cn};"
NSQ_SOURCE_LINE 00000112 "            $clset->{$cn} = $v;"
NSQ_SOURCE_LINE 00000113 "        } else {"
NSQ_SOURCE_LINE 00000114 "            $clset->{$c} = $v;"
NSQ_SOURCE_LINE 00000115 "        }"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "    }"
NSQ_SOURCE_LINE 00000118 "    $clset->{req} = 1 if $opts->{has_req};"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "    # XXX option to recursively normalize clset, any's of, all's of, ..."
NSQ_SOURCE_LINE 00000121 "    #if ($clset->{clset}) {"
NSQ_SOURCE_LINE 00000122 "    #    local $opts->{has_req};"
NSQ_SOURCE_LINE 00000123 "    #    if ($clset->{'clset.op'} && $clset->{'clset.op'} =~ /and|or/) {"
NSQ_SOURCE_LINE 00000124 "    #        # multiple clause sets"
NSQ_SOURCE_LINE 00000125 "    #        $clset->{clset} = map { $self->normalize_clset($_, $opts) }"
NSQ_SOURCE_LINE 00000126 "    #            @{ $clset->{clset} };"
NSQ_SOURCE_LINE 00000127 "    #    } else {"
NSQ_SOURCE_LINE 00000128 "    #        $clset->{clset} = $self->normalize_clset($_, $opts);"
NSQ_SOURCE_LINE 00000129 "    #    }"
NSQ_SOURCE_LINE 00000130 "    #}"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    $clset;"
NSQ_SOURCE_LINE 00000133 "}"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "sub normalize_schema($) {"
NSQ_SOURCE_LINE 00000136 "    my $s = shift;"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "    my $ref = ref($s);"
NSQ_SOURCE_LINE 00000139 "    if (!defined($s)) {"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "        die \"Schema is missing\";"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    } elsif (!$ref) {"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "        my $has_req = $s =~ s/\\*\\z//;"
NSQ_SOURCE_LINE 00000146 "        $s =~ $type_re or die \"Invalid type syntax $s, please use \"."
NSQ_SOURCE_LINE 00000147 "            \"letter/digit/underscore only\";"
NSQ_SOURCE_LINE 00000148 "        return [$s, $has_req ? {req=>1} : {}];"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "    } elsif ($ref eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "        my $t = $s->[0];"
NSQ_SOURCE_LINE 00000153 "        my $has_req = $t && $t =~ s/\\*\\z//;"
NSQ_SOURCE_LINE 00000154 "        if (!defined($t)) {"
NSQ_SOURCE_LINE 00000155 "            die \"For array form, at least 1 element is needed for type\";"
NSQ_SOURCE_LINE 00000156 "        } elsif (ref $t) {"
NSQ_SOURCE_LINE 00000157 "            die \"For array form, first element must be a string\";"
NSQ_SOURCE_LINE 00000158 "        }"
NSQ_SOURCE_LINE 00000159 "        $t =~ $type_re or die \"Invalid type syntax $s, please use \"."
NSQ_SOURCE_LINE 00000160 "            \"letter/digit/underscore only\";"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "        my $clset0;"
NSQ_SOURCE_LINE 00000163 "        my $extras;"
NSQ_SOURCE_LINE 00000164 "        if (defined($s->[1])) {"
NSQ_SOURCE_LINE 00000165 "            if (ref($s->[1]) eq 'HASH') {"
NSQ_SOURCE_LINE 00000166 "                $clset0 = $s->[1];"
NSQ_SOURCE_LINE 00000167 "                $extras = $s->[2];"
NSQ_SOURCE_LINE 00000168 "                die \"For array form, there should not be more than 3 elements\""
NSQ_SOURCE_LINE 00000169 "                    if @$s > 3;"
NSQ_SOURCE_LINE 00000170 "            } else {"
NSQ_SOURCE_LINE 00000171 "                # flattened clause set [t, c=>1, c2=>2, ...]"
NSQ_SOURCE_LINE 00000172 "                die \"For array in the form of [t, c1=>1, ...], there must be \"."
NSQ_SOURCE_LINE 00000173 "                    \"3 elements (or 5, 7, ...)\""
NSQ_SOURCE_LINE 00000174 "                        unless @$s % 2;"
NSQ_SOURCE_LINE 00000175 "                $clset0 = { @{$s}[1..@$s-1] };"
NSQ_SOURCE_LINE 00000176 "            }"
NSQ_SOURCE_LINE 00000177 "        } else {"
NSQ_SOURCE_LINE 00000178 "            $clset0 = {};"
NSQ_SOURCE_LINE 00000179 "        }"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "        # check clauses and parse shortcuts (!c, c&, c|, c=)"
NSQ_SOURCE_LINE 00000182 "        my $clset = normalize_clset($clset0, {has_req=>$has_req});"
NSQ_SOURCE_LINE 00000183 "        if (defined $extras) {"
NSQ_SOURCE_LINE 00000184 "            die \"For array form with 3 elements, extras must be hash\""
NSQ_SOURCE_LINE 00000185 "                unless ref($extras) eq 'HASH';"
NSQ_SOURCE_LINE 00000186 "            die \"Extras must be empty hashref (Sah 0.9.47)\" if keys %$extras;"
NSQ_SOURCE_LINE 00000187 "            # we remove extras to comply with Sah 0.9.47+"
NSQ_SOURCE_LINE 00000188 "            return [$t, $clset];"
NSQ_SOURCE_LINE 00000189 "        } else {"
NSQ_SOURCE_LINE 00000190 "            return [$t, $clset];"
NSQ_SOURCE_LINE 00000191 "        }"
NSQ_SOURCE_LINE 00000192 "    }"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    die \"Schema must be a string or arrayref (not $ref)\";"
NSQ_SOURCE_LINE 00000195 "}"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "1;"
NSQ_SOURCE_LINE 00000198 "# ABSTRACT: Normalize Sah schema"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "__END__"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=pod"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=head1 NAME"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "Data::Sah::Normalize - Normalize Sah schema"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head1 VERSION"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "This document describes version 0.051 of Data::Sah::Normalize (from Perl distribution Data-Sah-Normalize), released on 2021-07-29."
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 " use Data::Sah::Normalize qw(normalize_clset normalize_schema);"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 " my $nclset = normalize_clset({'!a'=>1}); # -> {a=>1, 'a.op'=>'not'}"
NSQ_SOURCE_LINE 00000219 " my $nsch   = normalize_schema(\"int\");    # -> [\"int\", {}]"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "This often-needed functionality is split from the main L<Data::Sah> to keep it"
NSQ_SOURCE_LINE 00000224 "in a small and minimal-dependencies package."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=head1 CONTRIBUTOR"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=for stopwords Steven Haryanto"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "Steven Haryanto <sharyanto@cpan.org>"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=head2 normalize_clset($clset) => HASH"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "Normalize a clause set (hash). Return a shallow copy of the original hash. Die"
NSQ_SOURCE_LINE 00000237 "on failure."
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "TODO: option to recursively normalize clause which contains sah clauses (e.g."
NSQ_SOURCE_LINE 00000240 "C<of>)."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head2 normalize_schema($sch) => ARRAY"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Normalize a Sah schema (scalar or array). Return an array. Produce a 2-level"
NSQ_SOURCE_LINE 00000245 "copy of schema, so it's safe to add/delete/modify the normalized schema's clause"
NSQ_SOURCE_LINE 00000246 "set, but clause set's values are still references to the original. Die on"
NSQ_SOURCE_LINE 00000247 "failure."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "TODO: recursively normalize clause which contains sah clauses (e.g. C<of>)."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "Please visit the project's homepage at L<https://metacpan.org/release/Data-Sah-Normalize>."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "Source repository is at L<https://github.com/perlancar/perl-Data-Sah-Normalize>."
NSQ_SOURCE_LINE 00000258 ""
