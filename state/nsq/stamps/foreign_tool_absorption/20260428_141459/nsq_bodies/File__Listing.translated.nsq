NSQ_SOURCE_LINE 00000007 "use Exporter 5.57 qw( import );"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "# ABSTRACT: Parse directory listing"
NSQ_SOURCE_LINE 00000010 "our $VERSION = '6.16'; # VERSION"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "sub Version { $File::Listing::VERSION; }"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our @EXPORT = qw(parse_dir);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub parse_dir ($;$$$)"
NSQ_SOURCE_LINE 00000017 "{"
NSQ_SOURCE_LINE 00000018 "   my($dir, $tz, $fstype, $error) = @_;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "   $fstype ||= 'unix';"
NSQ_SOURCE_LINE 00000021 "   $fstype = \"File::Listing::\" . lc $fstype;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "   my @args = $_[0];"
NSQ_SOURCE_LINE 00000024 "   push(@args, $tz) if(@_ >= 2);"
NSQ_SOURCE_LINE 00000025 "   push(@args, $error) if(@_ >= 4);"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "   $fstype->parse(@args);"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub line { Carp::croak(\"Not implemented yet\"); }"
NSQ_SOURCE_LINE 00000032 "sub init { } # Dummy sub"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "sub file_mode ($)"
NSQ_SOURCE_LINE 00000036 "{"
NSQ_SOURCE_LINE 00000037 "    Carp::croak(\"Input to file_mode() must be a 10 character string.\")"
NSQ_SOURCE_LINE 00000038 "        unless length($_[0]) == 10;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    # This routine was originally borrowed from Graham Barr's"
NSQ_SOURCE_LINE 00000041 "    # Net::FTP package."
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    local $_ = shift;"
NSQ_SOURCE_LINE 00000044 "    my $mode = 0;"
NSQ_SOURCE_LINE 00000045 "    my($type);"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    s/^(.)// and $type = $1;"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    # When the set-group-ID bit (file mode bit 02000) is set, and the group"
NSQ_SOURCE_LINE 00000050 "    # execution bit (file mode bit 00020) is unset, and it is a regular file,"
NSQ_SOURCE_LINE 00000051 "    # some implementations of `ls' use the letter `S', others use `l' or `L'."
NSQ_SOURCE_LINE 00000052 "    # Convert this `S'."
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    s/[Ll](...)$/S$1/;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    while (/(.)/g) {"
NSQ_SOURCE_LINE 00000057 "        $mode <<= 1;"
NSQ_SOURCE_LINE 00000058 "        $mode |= 1 if $1 ne \"-\" &&"
NSQ_SOURCE_LINE 00000059 "                      $1 ne \"*\" &&"
NSQ_SOURCE_LINE 00000060 "                      $1 ne 'S' &&"
NSQ_SOURCE_LINE 00000061 "                      $1 ne 'T';"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    $mode |= 0004000 if /^..s....../i;"
NSQ_SOURCE_LINE 00000065 "    $mode |= 0002000 if /^.....s.../i;"
NSQ_SOURCE_LINE 00000066 "    $mode |= 0001000 if /^........t/i;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    # De facto standard definitions. From 'stat.h' on Solaris 9."
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    $type eq \"p\" and $mode |= 0010000 or        # fifo"
NSQ_SOURCE_LINE 00000071 "    $type eq \"c\" and $mode |= 0020000 or        # character special"
NSQ_SOURCE_LINE 00000072 "    $type eq \"d\" and $mode |= 0040000 or        # directory"
NSQ_SOURCE_LINE 00000073 "    $type eq \"b\" and $mode |= 0060000 or        # block special"
NSQ_SOURCE_LINE 00000074 "    $type eq \"-\" and $mode |= 0100000 or        # regular"
NSQ_SOURCE_LINE 00000075 "    $type eq \"l\" and $mode |= 0120000 or        # symbolic link"
NSQ_SOURCE_LINE 00000076 "    $type eq \"s\" and $mode |= 0140000 or        # socket"
NSQ_SOURCE_LINE 00000077 "    $type eq \"D\" and $mode |= 0150000 or        # door"
NSQ_SOURCE_LINE 00000078 "      Carp::croak(\"Unknown file type: $type\");"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "    $mode;"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "sub parse"
NSQ_SOURCE_LINE 00000085 "{"
NSQ_SOURCE_LINE 00000086 "   my($pkg, $dir, $tz, $error) = @_;"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "   # First let's try to determine what kind of dir parameter we have"
NSQ_SOURCE_LINE 00000089 "   # received.  We allow both listings, reference to arrays and"
NSQ_SOURCE_LINE 00000090 "   # file handles to read from."
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "   if (ref($dir) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000093 "       # Already split up"
NSQ_SOURCE_LINE 00000094 "   }"
NSQ_SOURCE_LINE 00000095 "   elsif (ref($dir) eq 'GLOB') {"
NSQ_SOURCE_LINE 00000096 "       # A file handle"
NSQ_SOURCE_LINE 00000097 "   }"
NSQ_SOURCE_LINE 00000098 "   elsif (ref($dir)) {"
NSQ_SOURCE_LINE 00000099 "      Carp::croak(\"Illegal argument to parse_dir()\");"
NSQ_SOURCE_LINE 00000100 "   }"
NSQ_SOURCE_LINE 00000101 "   elsif ($dir =~ /^\\*\\w+(::\\w+)+$/) {"
NSQ_SOURCE_LINE 00000102 "      # This scalar looks like a file handle, so we assume it is"
NSQ_SOURCE_LINE 00000103 "   }"
NSQ_SOURCE_LINE 00000104 "   else {"
NSQ_SOURCE_LINE 00000105 "      # A normal scalar listing"
NSQ_SOURCE_LINE 00000106 "      $dir = [ split(/\\n/, $dir) ];"
NSQ_SOURCE_LINE 00000107 "   }"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "   $pkg->init();"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "   my @files = ();"
NSQ_SOURCE_LINE 00000112 "   if (ref($dir) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000113 "       for (@$dir) {"
NSQ_SOURCE_LINE 00000114 "           push(@files, $pkg->line($_, $tz, $error));"
NSQ_SOURCE_LINE 00000115 "       }"
NSQ_SOURCE_LINE 00000116 "   }"
NSQ_SOURCE_LINE 00000117 "   else {"
NSQ_SOURCE_LINE 00000118 "       local($_);"
NSQ_SOURCE_LINE 00000119 "       while (my $line = <$dir>) {"
NSQ_SOURCE_LINE 00000120 "           chomp $line;"
NSQ_SOURCE_LINE 00000121 "           push(@files, $pkg->line($line, $tz, $error));"
NSQ_SOURCE_LINE 00000122 "       }"
NSQ_SOURCE_LINE 00000123 "   }"
NSQ_SOURCE_LINE 00000124 "   wantarray ? @files : \\@files;  ## no critic (Community::Wantarray)"
NSQ_SOURCE_LINE 00000125 "}"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "package File::Listing::unix;"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "use HTTP::Date qw(str2time);"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "our @ISA = qw(File::Listing);"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "# A place to remember current directory from last line parsed."
NSQ_SOURCE_LINE 00000136 "our $curdir;"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "sub init"
NSQ_SOURCE_LINE 00000139 "{"
NSQ_SOURCE_LINE 00000140 "    $curdir = '';"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "sub line"
NSQ_SOURCE_LINE 00000145 "{"
NSQ_SOURCE_LINE 00000146 "    shift; # package name"
NSQ_SOURCE_LINE 00000147 "    local($_) = shift;"
NSQ_SOURCE_LINE 00000148 "    my($tz, $error) = @_;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "    s/\\015//g;"
NSQ_SOURCE_LINE 00000151 "    #study;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    my ($kind, $size, $date, $name);"
NSQ_SOURCE_LINE 00000154 "    if (($kind, $size, $date, $name) ="
NSQ_SOURCE_LINE 00000155 "        /^([\\-\\*FlrwxsStTdD]{10})                 # Type and permission bits"
NSQ_SOURCE_LINE 00000156 "         .*                                       # Graps"
NSQ_SOURCE_LINE 00000157 "         \\D(\\d+)                                  # File size"
NSQ_SOURCE_LINE 00000158 "         \\s+                                      # Some space"
NSQ_SOURCE_LINE 00000159 "         (\\w{3}\\s+\\d+\\s+(?:\\d{1,2}:\\d{2}|\\d{4})|\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2})  # Date"
NSQ_SOURCE_LINE 00000160 "         \\s+                                      # Some more space"
NSQ_SOURCE_LINE 00000161 "         (.*)$                                    # File name"
NSQ_SOURCE_LINE 00000162 "        /x )"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "    {"
NSQ_SOURCE_LINE 00000165 "        return if $name eq '.' || $name eq '..';"
NSQ_SOURCE_LINE 00000166 "        $name = \"$curdir/$name\" if length $curdir;"
NSQ_SOURCE_LINE 00000167 "        my $type = '?';"
NSQ_SOURCE_LINE 00000168 "        if ($kind =~ /^l/ && $name =~ /(.*) -> (.*)/ ) {"
NSQ_SOURCE_LINE 00000169 "            $name = $1;"
NSQ_SOURCE_LINE 00000170 "            $type = \"l $2\";"
NSQ_SOURCE_LINE 00000171 "        }"
NSQ_SOURCE_LINE 00000172 "        elsif ($kind =~ /^[\\-F]/) { # (hopefully) a regular file"
NSQ_SOURCE_LINE 00000173 "            $type = 'f';"
NSQ_SOURCE_LINE 00000174 "        }"
NSQ_SOURCE_LINE 00000175 "        elsif ($kind =~ /^[dD]/) {"
NSQ_SOURCE_LINE 00000176 "            $type = 'd';"
NSQ_SOURCE_LINE 00000177 "            $size = undef;  # Don't believe the reported size"
NSQ_SOURCE_LINE 00000178 "        }"
NSQ_SOURCE_LINE 00000179 "        return [$name, $type, $size, str2time($date, $tz),"
NSQ_SOURCE_LINE 00000180 "              File::Listing::file_mode($kind)];"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    }"
NSQ_SOURCE_LINE 00000183 "    elsif (/^(.+):$/ && !/^[dcbsp].*\\s.*\\s.*:$/ ) {"
NSQ_SOURCE_LINE 00000184 "        my $dir = $1;"
NSQ_SOURCE_LINE 00000185 "        return () if $dir eq '.';"
NSQ_SOURCE_LINE 00000186 "        $curdir = $dir;"
NSQ_SOURCE_LINE 00000187 "        return ();"
NSQ_SOURCE_LINE 00000188 "    }"
NSQ_SOURCE_LINE 00000189 "    elsif (/^[Tt]otal\\s+(\\d+)$/ || /^\\s*$/) {"
NSQ_SOURCE_LINE 00000190 "        return ();"
NSQ_SOURCE_LINE 00000191 "    }"
NSQ_SOURCE_LINE 00000192 "    elsif (/not found/    || # OSF1, HPUX, and SunOS return"
NSQ_SOURCE_LINE 00000193 "             # \"$file not found\""
NSQ_SOURCE_LINE 00000194 "             /No such file/ || # IRIX returns"
NSQ_SOURCE_LINE 00000195 "             # \"UX:ls: ERROR: Cannot access $file: No such file or directory\""
NSQ_SOURCE_LINE 00000196 "                               # Solaris returns"
NSQ_SOURCE_LINE 00000197 "             # \"$file: No such file or directory\""
NSQ_SOURCE_LINE 00000198 "             /cannot find/     # Windows NT returns"
NSQ_SOURCE_LINE 00000199 "             # \"The system cannot find the path specified.\""
NSQ_SOURCE_LINE 00000200 "             ) {"
NSQ_SOURCE_LINE 00000201 "        return () unless defined $error;"
NSQ_SOURCE_LINE 00000202 "        &$error($_) if ref($error) eq 'CODE';"
NSQ_SOURCE_LINE 00000203 "        warn \"Error: $_\\n\" if $error eq 'warn';"
NSQ_SOURCE_LINE 00000204 "        return ();"
NSQ_SOURCE_LINE 00000205 "    }"
NSQ_SOURCE_LINE 00000206 "    elsif ($_ eq '') {       # AIX, and Linux return nothing"
NSQ_SOURCE_LINE 00000207 "        return () unless defined $error;"
NSQ_SOURCE_LINE 00000208 "        &$error(\"No such file or directory\") if ref($error) eq 'CODE';"
NSQ_SOURCE_LINE 00000209 "        warn \"Warning: No such file or directory\\n\" if $error eq 'warn';"
NSQ_SOURCE_LINE 00000210 "        return ();"
NSQ_SOURCE_LINE 00000211 "    }"
NSQ_SOURCE_LINE 00000212 "    else {"
NSQ_SOURCE_LINE 00000213 "        # parse failed, check if the dosftp parse understands it"
NSQ_SOURCE_LINE 00000214 "        File::Listing::dosftp->init();"
NSQ_SOURCE_LINE 00000215 "        return(File::Listing::dosftp->line($_,$tz,$error));"
NSQ_SOURCE_LINE 00000216 "    }"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "}"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "package File::Listing::dosftp;"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "use HTTP::Date qw(str2time);"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "our @ISA = qw(File::Listing);"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "# A place to remember current directory from last line parsed."
NSQ_SOURCE_LINE 00000229 "our $curdir;"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "sub init"
NSQ_SOURCE_LINE 00000234 "{"
NSQ_SOURCE_LINE 00000235 "    $curdir = '';"
NSQ_SOURCE_LINE 00000236 "}"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "sub line"
NSQ_SOURCE_LINE 00000240 "{"
NSQ_SOURCE_LINE 00000241 "    shift; # package name"
NSQ_SOURCE_LINE 00000242 "    local($_) = shift;"
NSQ_SOURCE_LINE 00000243 "    my($tz, $error) = @_;"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "    s/\\015//g;"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    my ($date, $size_or_dir, $name, $size);"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "    # usual format:"
NSQ_SOURCE_LINE 00000250 "    # 02-05-96  10:48AM                 1415 src.slf"
NSQ_SOURCE_LINE 00000251 "    # 09-10-96  09:18AM       <DIR>          sl_util"
NSQ_SOURCE_LINE 00000252 "    # alternative dos format with four-digit year:"
NSQ_SOURCE_LINE 00000253 "    # 02-05-2022  10:48AM                 1415 src.slf"
NSQ_SOURCE_LINE 00000254 "    # 09-10-2022  09:18AM       <DIR>          sl_util"
NSQ_SOURCE_LINE 00000255 "    if (($date, $size_or_dir, $name) ="
NSQ_SOURCE_LINE 00000256 "        /^(\\d\\d-\\d\\d-\\d{2,4}\\s+\\d\\d:\\d\\d\\wM)      # Date and time info"
NSQ_SOURCE_LINE 00000257 "         \\s+                                      # Some space"
NSQ_SOURCE_LINE 00000258 "         (<\\w{3}>|\\d+)                            # Dir or Size"
NSQ_SOURCE_LINE 00000259 "         \\s+                                      # Some more space"
NSQ_SOURCE_LINE 00000260 "         (.+)$                                    # File name"
NSQ_SOURCE_LINE 00000261 "        /x )"
NSQ_SOURCE_LINE 00000262 "    {"
NSQ_SOURCE_LINE 00000263 "        return if $name eq '.' || $name eq '..';"
NSQ_SOURCE_LINE 00000264 "        $name = \"$curdir/$name\" if length $curdir;"
NSQ_SOURCE_LINE 00000265 "        my $type = '?';"
NSQ_SOURCE_LINE 00000266 "        if ($size_or_dir eq '<DIR>') {"
NSQ_SOURCE_LINE 00000267 "            $type = \"d\";"
NSQ_SOURCE_LINE 00000268 "            $size = \"\"; # directories have no size in the pc listing"
NSQ_SOURCE_LINE 00000269 "        }"
NSQ_SOURCE_LINE 00000270 "        else {"
NSQ_SOURCE_LINE 00000271 "            $type = 'f';"
NSQ_SOURCE_LINE 00000272 "            $size = $size_or_dir;"
NSQ_SOURCE_LINE 00000273 "        }"
NSQ_SOURCE_LINE 00000274 "        return [$name, $type, $size, str2time($date, $tz), undef];"
NSQ_SOURCE_LINE 00000275 "    }"
NSQ_SOURCE_LINE 00000276 "    else {"
NSQ_SOURCE_LINE 00000277 "        return () unless defined $error;"
NSQ_SOURCE_LINE 00000278 "        &$error($_) if ref($error) eq 'CODE';"
NSQ_SOURCE_LINE 00000279 "        warn \"Can't parse: $_\\n\" if $error eq 'warn';"
NSQ_SOURCE_LINE 00000280 "        return ();"
NSQ_SOURCE_LINE 00000281 "    }"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "}"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "package File::Listing::vms;"
NSQ_SOURCE_LINE 00000288 "our @ISA = qw(File::Listing);"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "package File::Listing::netware;"
NSQ_SOURCE_LINE 00000291 "our @ISA = qw(File::Listing);"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "package File::Listing::apache;"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "our @ISA = qw(File::Listing);"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "sub init { }"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "sub line {"
NSQ_SOURCE_LINE 00000304 "    shift; # package name"
NSQ_SOURCE_LINE 00000305 "    local($_) = shift;"
NSQ_SOURCE_LINE 00000306 "    my($tz, $error) = @_; # ignored for now..."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "    s!</?t[rd][^>]*>! !g;  # clean away various table stuff"
NSQ_SOURCE_LINE 00000309 "    if (m!<A\\s+HREF=\\\"([^?\\\"]+)\\\">.*</A>.*?(\\d+)-([a-zA-Z]+|\\d+)-(\\d+)\\s+(\\d+):(\\d+)\\s+(?:([\\d\\.]+[kMG]?|-))!i) {"
NSQ_SOURCE_LINE 00000310 "        my($filename, $filesize) = ($1, $7);"
NSQ_SOURCE_LINE 00000311 "        my($d,$m,$y, $H,$M) = ($2,$3,$4,$5,$6);"
NSQ_SOURCE_LINE 00000312 "        if ($m =~ /^\\d+$/) {"
NSQ_SOURCE_LINE 00000313 "            ($d,$y) = ($y,$d) # iso date"
NSQ_SOURCE_LINE 00000314 "        }"
NSQ_SOURCE_LINE 00000315 "        else {"
NSQ_SOURCE_LINE 00000316 "            $m = _monthabbrev_number($m);"
NSQ_SOURCE_LINE 00000317 "        }"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "        $filesize = 0 if $filesize eq '-';"
NSQ_SOURCE_LINE 00000320 "        if ($filesize =~ s/k$//i) {"
NSQ_SOURCE_LINE 00000321 "            $filesize *= 1024;"
NSQ_SOURCE_LINE 00000322 "        }"
NSQ_SOURCE_LINE 00000323 "        elsif ($filesize =~ s/M$//) {"
NSQ_SOURCE_LINE 00000324 "            $filesize *= 1024*1024;"
NSQ_SOURCE_LINE 00000325 "        }"
NSQ_SOURCE_LINE 00000326 "        elsif ($filesize =~ s/G$//) {"
NSQ_SOURCE_LINE 00000327 "            $filesize *= 1024*1024*1024;"
NSQ_SOURCE_LINE 00000328 "        }"
NSQ_SOURCE_LINE 00000329 "        $filesize = int $filesize;"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "        require Time::Local;"
NSQ_SOURCE_LINE 00000332 "        my $filetime = Time::Local::timelocal(0,$M,$H,$d,$m-1,_guess_year($y));"
NSQ_SOURCE_LINE 00000333 "        my $filetype = ($filename =~ s|/$|| ? \"d\" : \"f\");"
NSQ_SOURCE_LINE 00000334 "        return [$filename, $filetype, $filesize, $filetime, undef];"
NSQ_SOURCE_LINE 00000335 "    }"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "    # the default listing doesn't include timestamps or file sizes"
NSQ_SOURCE_LINE 00000338 "    # but we don't want to grab navigation links, so we ignore links"
NSQ_SOURCE_LINE 00000339 "    # that have a non-trailing slash / character or ?"
NSQ_SOURCE_LINE 00000340 "    elsif(m!<A\\s+HREF=\\\"([^?/\\\"]+/?)\\\">.*</A>!i) {"
NSQ_SOURCE_LINE 00000341 "        my $filename = $1;"
NSQ_SOURCE_LINE 00000342 "        my $filetype = ($filename =~ s|/$|| ? \"d\" : \"f\");"
NSQ_SOURCE_LINE 00000343 "        return [$filename, $filetype, undef, undef, undef];"
NSQ_SOURCE_LINE 00000344 "    }"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "    return ();"
NSQ_SOURCE_LINE 00000347 "}"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "sub _guess_year {"
NSQ_SOURCE_LINE 00000351 "    my $y = shift;"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "    # if the year is already four digit then we shouldn't do"
NSQ_SOURCE_LINE 00000354 "    # anything to modify it."
NSQ_SOURCE_LINE 00000355 "    if ($y >= 1900) {"
NSQ_SOURCE_LINE 00000356 "        # do nothing"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "    # TODO: for hysterical er historical reasons we assume 9x is in the"
NSQ_SOURCE_LINE 00000359 "    # 1990s we should probably not do that, but I don't have any examples"
NSQ_SOURCE_LINE 00000360 "    # where apache provides two digit dates so I am leaving this as-is"
NSQ_SOURCE_LINE 00000361 "    # for now.  Possibly the right thing is to not handle two digit years."
NSQ_SOURCE_LINE 00000362 "    } elsif ($y >= 90) {"
NSQ_SOURCE_LINE 00000363 "        $y = 1900+$y;"
NSQ_SOURCE_LINE 00000364 "    }"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "    # TODO: likewise assuming 00-89 are 20xx is long term probably wrong."
NSQ_SOURCE_LINE 00000367 "    elsif ($y < 100) {"
NSQ_SOURCE_LINE 00000368 "        $y = 2000+$y;"
NSQ_SOURCE_LINE 00000369 "    }"
NSQ_SOURCE_LINE 00000370 "    $y;"
NSQ_SOURCE_LINE 00000371 "}"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "sub _monthabbrev_number {"
NSQ_SOURCE_LINE 00000375 "    my $mon = shift;"
NSQ_SOURCE_LINE 00000376 "    +{'Jan' => 1,"
NSQ_SOURCE_LINE 00000377 "      'Feb' => 2,"
NSQ_SOURCE_LINE 00000378 "      'Mar' => 3,"
NSQ_SOURCE_LINE 00000379 "      'Apr' => 4,"
NSQ_SOURCE_LINE 00000380 "      'May' => 5,"
NSQ_SOURCE_LINE 00000381 "      'Jun' => 6,"
NSQ_SOURCE_LINE 00000382 "      'Jul' => 7,"
NSQ_SOURCE_LINE 00000383 "      'Aug' => 8,"
NSQ_SOURCE_LINE 00000384 "      'Sep' => 9,"
NSQ_SOURCE_LINE 00000385 "      'Oct' => 10,"
NSQ_SOURCE_LINE 00000386 "      'Nov' => 11,"
NSQ_SOURCE_LINE 00000387 "      'Dec' => 12,"
NSQ_SOURCE_LINE 00000388 "     }->{$mon};"
NSQ_SOURCE_LINE 00000389 "}"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "1;"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "__END__"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "=pod"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "=head1 NAME"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "File::Listing - Parse directory listing"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "=head1 VERSION"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "version 6.16"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 " use File::Listing qw(parse_dir);"
NSQ_SOURCE_LINE 00000411 " $ENV{LANG} = \"C\";  # dates in non-English locales not supported"
NSQ_SOURCE_LINE 00000412 " foreach my $file (parse_dir(`ls -l`)) {"
NSQ_SOURCE_LINE 00000413 "     my ($name, $type, $size, $mtime, $mode) = @$file;"
NSQ_SOURCE_LINE 00000414 "     next if $type ne 'f'; # plain file"
NSQ_SOURCE_LINE 00000415 "     #..."
NSQ_SOURCE_LINE 00000416 " }"
NSQ_SOURCE_LINE 00000417 " "
NSQ_SOURCE_LINE 00000418 " # directory listing can also be read from a file"
NSQ_SOURCE_LINE 00000419 " open my $listing, \"zcat ls-lR.gz|\";"
NSQ_SOURCE_LINE 00000420 " $dir = parse_dir($listing, '+0000');"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "This module exports a single function called C<parse_dir>, which can be"
NSQ_SOURCE_LINE 00000425 "used to parse directory listings."
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "=head2 parse_dir"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 " my $dir = parse_dir( $listing );"
NSQ_SOURCE_LINE 00000432 " my $dir = parse_dir( $listing, $time_zone );"
NSQ_SOURCE_LINE 00000433 " my $dir = parse_dir( $listing, $time_zone, $type );"
NSQ_SOURCE_LINE 00000434 " my $dir = parse_dir( $listing, $time_zone, $type, $error );"
NSQ_SOURCE_LINE 00000435 " my @files = parse_dir( $listing );"
NSQ_SOURCE_LINE 00000436 " my @files = parse_dir( $listing, $time_zone );"
NSQ_SOURCE_LINE 00000437 " my @files = parse_dir( $listing, $time_zone, $type );"
NSQ_SOURCE_LINE 00000438 " my @files = parse_dir( $listing, $time_zone, $type, $error );"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "The first parameter (C<$listing>) is the directory listing to parse."
NSQ_SOURCE_LINE 00000441 "It can be a scalar, a reference to an array of directory lines or a"
NSQ_SOURCE_LINE 00000442 "glob representing a filehandle to read the directory listing from."
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "The second parameter (C<$time_zone>) is the time zone to use when"
NSQ_SOURCE_LINE 00000445 "parsing time stamps in the listing. If this value is undefined,"
NSQ_SOURCE_LINE 00000446 "then the local time zone is assumed."
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "The third parameter (C<$type>) is the type of listing to assume."
NSQ_SOURCE_LINE 00000449 "Currently supported formats are C<'unix'>, C<'apache'> and"
NSQ_SOURCE_LINE 00000450 "C<'dosftp'>. The default value is C<'unix'>. Ideally, the listing"
NSQ_SOURCE_LINE 00000451 "type should be determined automatically."
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "The fourth parameter (C<$error>) specifies how unparseable lines"
NSQ_SOURCE_LINE 00000454 "should be treated. Values can be C<'ignore'>, C<'warn'> or a code reference."
NSQ_SOURCE_LINE 00000455 "Warn means that the perl warn() function will be called.  If a code"
NSQ_SOURCE_LINE 00000456 "reference is passed, then this routine will be called and the return"
NSQ_SOURCE_LINE 00000457 "value from it will be incorporated in the listing.  The default is"
NSQ_SOURCE_LINE 00000458 "C<'ignore'>."
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "Only the first parameter is mandatory."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 " # list context"
NSQ_SOURCE_LINE 00000463 " foreach my $file (parse_dir($listing)) {"
NSQ_SOURCE_LINE 00000464 "     my($name, $type, $size, $mtime, $mode) = @$file;"
NSQ_SOURCE_LINE 00000465 " }"
NSQ_SOURCE_LINE 00000466 " "
NSQ_SOURCE_LINE 00000467 " # scalar context"
NSQ_SOURCE_LINE 00000468 " my $dir = parse_dir($listing);"
NSQ_SOURCE_LINE 00000469 " foreach my $file (@$dir) {"
NSQ_SOURCE_LINE 00000470 "     my($name, $type, $size, $mtime, $mode) = @$file;"
NSQ_SOURCE_LINE 00000471 " }"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "The return value from parse_dir() is a list of directory entries."
NSQ_SOURCE_LINE 00000474 "In a scalar context the return value is a reference to the list."
NSQ_SOURCE_LINE 00000475 "The directory entries are represented by an array consisting of:"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "=over 4"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "=item name"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "The name of the file."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "=item type"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "One of: C<f> file, C<d> directory, C<l> symlink, C<?> unknown."
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=item size"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "The size of the file."
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "=item time"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "The number of seconds since January 1, 1970."
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "=item mode"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "Bitmask a la the mode returned by C<stat>."
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "=back"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "=over 4"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=item L<File::Listing::Ftpcopy>"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "Provides the same interface but uses XS and the parser implementation from C<ftpcopy>."
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=back"
NSQ_SOURCE_LINE 00000510 ""
