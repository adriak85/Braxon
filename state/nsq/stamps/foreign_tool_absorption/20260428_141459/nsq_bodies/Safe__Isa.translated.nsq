NSQ_TRANSLATED_TOOL_BODY v14
SOURCE_KIND cpan_source
SOURCE_NAME Safe::Isa
SOURCE_SHA256 1268fbc15c84bca9d6bab13238aaca5397c4d86b3d8319c3916143f182b504de
RUNTIME_AUTHORITY nsq_substrate
FOREIGN_RUNTIME_ALLOWED false
NO_PARALLEL_RUNTIME true
NO_SILENT_FOREIGN_EXECUTION true
STAMP_SYSTEM_ACTIVE true
BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Safe::Isa;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings FATAL => 'all';"
NSQ_SOURCE_LINE 00000005 "use Scalar::Util ();"
NSQ_SOURCE_LINE 00000006 "use Exporter 5.57 qw(import);"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '1.000010';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our @EXPORT = qw($_call_if_object $_isa $_can $_does $_DOES $_call_if_can);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our $_call_if_object = sub {"
NSQ_SOURCE_LINE 00000013 "  my ($obj, $method) = (shift, shift);"
NSQ_SOURCE_LINE 00000014 "  # This is intentionally a truth test, not a defined test, otherwise"
NSQ_SOURCE_LINE 00000015 "  # we gratuitously break modules like Scalar::Defer, which would be"
NSQ_SOURCE_LINE 00000016 "  # un-perlish."
NSQ_SOURCE_LINE 00000017 "  return unless Scalar::Util::blessed($obj);"
NSQ_SOURCE_LINE 00000018 "  return $obj->$method(@_);"
NSQ_SOURCE_LINE 00000019 "};"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "our ($_isa, $_can) = map {"
NSQ_SOURCE_LINE 00000022 "  my $method = $_;"
NSQ_SOURCE_LINE 00000023 "  sub { my $obj = shift; $obj->$_call_if_object($method => @_) }"
NSQ_SOURCE_LINE 00000024 "} qw(isa can);"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "our $_call_if_can = sub {"
NSQ_SOURCE_LINE 00000027 "  my ($obj, $method) = (shift, shift);"
NSQ_SOURCE_LINE 00000028 "  return unless $obj->$_call_if_object(can => $method);"
NSQ_SOURCE_LINE 00000029 "  return $obj->$method(@_);"
NSQ_SOURCE_LINE 00000030 "};"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "our $_does = sub {"
NSQ_SOURCE_LINE 00000033 "  my $obj = shift;"
NSQ_SOURCE_LINE 00000034 "  $obj->$_call_if_can(does => @_);"
NSQ_SOURCE_LINE 00000035 "};"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "our $_DOES = sub {"
NSQ_SOURCE_LINE 00000038 "  my $obj = shift;"
NSQ_SOURCE_LINE 00000039 "  return unless Scalar::Util::blessed($obj);"
NSQ_SOURCE_LINE 00000040 "  return $obj->DOES(@_)"
NSQ_SOURCE_LINE 00000041 "    if $obj->can('DOES');"
NSQ_SOURCE_LINE 00000042 "  return $obj->isa(@_);"
NSQ_SOURCE_LINE 00000043 "};"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "1;"
NSQ_SOURCE_LINE 00000046 "__END__"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "=pod"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "=head1 NAME"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "Safe::Isa - Call isa, can, does and DOES safely on things that may not be objects"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "  use strict;"
NSQ_SOURCE_LINE 00000057 "  use warnings;"
NSQ_SOURCE_LINE 00000058 "  "
NSQ_SOURCE_LINE 00000059 "  { package Foo; sub new { bless({}, $_[0]) } }"
NSQ_SOURCE_LINE 00000060 "  { package Bar; our @ISA = qw(Foo); sub bar { 1 } }"
NSQ_SOURCE_LINE 00000061 "  "
NSQ_SOURCE_LINE 00000062 "  my $foo = Foo->new;"
NSQ_SOURCE_LINE 00000063 "  my $bar = Bar->new;"
NSQ_SOURCE_LINE 00000064 "  my $blam = [ 42 ];"
NSQ_SOURCE_LINE 00000065 "  "
NSQ_SOURCE_LINE 00000066 "  # basic isa usage -"
NSQ_SOURCE_LINE 00000067 "  "
NSQ_SOURCE_LINE 00000068 "  $foo->isa('Foo');  # true"
NSQ_SOURCE_LINE 00000069 "  $bar->isa('Foo');  # true"
NSQ_SOURCE_LINE 00000070 "  $blam->isa('Foo'); # BOOM"
NSQ_SOURCE_LINE 00000071 "  "
NSQ_SOURCE_LINE 00000072 "  $foo->can('bar');  # false"
NSQ_SOURCE_LINE 00000073 "  $bar->can('bar');  # true"
NSQ_SOURCE_LINE 00000074 "  $blam->can('bar'); # BOOM"
NSQ_SOURCE_LINE 00000075 "  "
NSQ_SOURCE_LINE 00000076 "  # Safe::Isa usage -"
NSQ_SOURCE_LINE 00000077 "  "
NSQ_SOURCE_LINE 00000078 "  use Safe::Isa;"
NSQ_SOURCE_LINE 00000079 "  "
NSQ_SOURCE_LINE 00000080 "  $foo->$_isa('Foo');  # true"
NSQ_SOURCE_LINE 00000081 "  $bar->$_isa('Foo');  # true"
NSQ_SOURCE_LINE 00000082 "  $blam->$_isa('Foo'); # false, no boom today"
NSQ_SOURCE_LINE 00000083 "  "
NSQ_SOURCE_LINE 00000084 "  $foo->$_can('bar');  # false"
NSQ_SOURCE_LINE 00000085 "  $bar->$_can('bar');  # true"
NSQ_SOURCE_LINE 00000086 "  $blam->$_can('bar'); # false, no boom today"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "Similarly:"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "  $maybe_an_object->$_does('RoleName'); # true or false, no boom today"
NSQ_SOURCE_LINE 00000091 "  $maybe_an_object->$_DOES('RoleName'); # true or false, no boom today"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "And just in case we missed a method or two:"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "  $maybe_an_object->$_call_if_object(name => @args);"
NSQ_SOURCE_LINE 00000096 "  $maybe_an_object->$_call_if_can(name => @args);"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "Or to re-use a previous example for purposes of explication:"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "  $foo->$_call_if_object(isa => 'Foo');  # true"
NSQ_SOURCE_LINE 00000101 "  $bar->$_call_if_object(isa => 'Foo');  # true"
NSQ_SOURCE_LINE 00000102 "  $blam->$_call_if_object(isa => 'Foo'); # false, no boom today"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "How many times have you found yourself writing:"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "  if ($obj->isa('Something')) {"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "and then shortly afterwards cursing and changing it to:"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "  if (Scalar::Util::blessed($obj) and $obj->isa('Something')) {"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "Right. That's why this module exists."
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "Since perl allows us to provide a subroutine reference or a method name to"
NSQ_SOURCE_LINE 00000117 "the -> operator when used as a method call, and a subroutine doesn't require"
NSQ_SOURCE_LINE 00000118 "the invocant to actually be an object, we can create safe versions of isa,"
NSQ_SOURCE_LINE 00000119 "can and friends by using a subroutine reference that only tries to call the"
NSQ_SOURCE_LINE 00000120 "method if it's used on an object. So:"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "  my $isa_Foo = $maybe_an_object->$_call_if_object(isa => 'Foo');"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "is equivalent to"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "  my $isa_Foo = do {"
NSQ_SOURCE_LINE 00000127 "    if (Scalar::Util::blessed($maybe_an_object)) {"
NSQ_SOURCE_LINE 00000128 "      $maybe_an_object->isa('Foo');"
NSQ_SOURCE_LINE 00000129 "    } else {"
NSQ_SOURCE_LINE 00000130 "      undef;"
NSQ_SOURCE_LINE 00000131 "    }"
NSQ_SOURCE_LINE 00000132 "  };"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Note that we don't handle trying class names, because many things are valid"
NSQ_SOURCE_LINE 00000135 "class names that you might not want to treat as one (like say \"Matt\") - the"
NSQ_SOURCE_LINE 00000136 "C<is_module_name> function from L<Module::Runtime> is a good way to check for"
NSQ_SOURCE_LINE 00000137 "something you might be able to call methods on if you want to do that."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "We are careful to make sure that scalar/list context is preserved for the"
NSQ_SOURCE_LINE 00000140 "method that is eventually called."
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=head2 $_isa"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "  $maybe_an_object->$_isa('Foo');"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "If called on an object, calls C<isa> on it and returns the result, otherwise"
NSQ_SOURCE_LINE 00000149 "returns nothing."
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=head2 $_can"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "  $maybe_an_object->$_can('Foo');"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "If called on an object, calls C<can> on it and returns the result, otherwise"
NSQ_SOURCE_LINE 00000156 "returns nothing."
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=head2 $_does"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "  $maybe_an_object->$_does('Foo');"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "If called on an object, calls C<does> on it and returns the result, otherwise"
NSQ_SOURCE_LINE 00000163 "returns nothing. If the C<does> method does not exist, returns nothing rather"
NSQ_SOURCE_LINE 00000164 "than failing."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=head2 $_DOES"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "  $maybe_an_object->$_DOES('Foo');"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "If called on an object, calls C<DOES> on it and returns the result, otherwise"
NSQ_SOURCE_LINE 00000171 "returns nothing. On perl versions prior to 5.10.0, the built in core C<DOES>"
NSQ_SOURCE_LINE 00000172 "method doesn't exist. If the method doesn't exist, this will fall back to"
NSQ_SOURCE_LINE 00000173 "calling C<isa> just like the core C<DOES> method."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=head2 $_call_if_object"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "  $maybe_an_object->$_call_if_object(method_name => @args);"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "If called on an object, calls C<method_name> on it and returns the result,"
NSQ_SOURCE_LINE 00000180 "otherwise returns nothing."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head2 $_call_if_can"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "  $maybe_an_object->$_call_if_can(name => @args);"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "If called on an object, calls C<can> on it; if that returns true, then"
NSQ_SOURCE_LINE 00000187 "calls C<method_name> on it and returns the result; if any condition is false"
NSQ_SOURCE_LINE 00000188 "returns nothing."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "I gave a lightning talk on this module (and L<curry> and L<Import::Into>) at"
NSQ_SOURCE_LINE 00000193 "L<YAPC::NA 2013|https://www.youtube.com/watch?v=wFXWV2yY7gE&t=46m05s>."
NSQ_SOURCE_LINE 00000194 ""
