NSQ_SOURCE_LINE 00000018 "# This line is here to convince \"autouse\" into believing we are autousable."
NSQ_SOURCE_LINE 00000019 "sub can {"
NSQ_SOURCE_LINE 00000020 "    ($_[1] eq 'import' and caller()->isa('autouse'))"
NSQ_SOURCE_LINE 00000021 "        ? \\&Exporter::import        # pacify autouse's equality test"
