NSQ_SOURCE_LINE 00000031 "sub new {"
NSQ_SOURCE_LINE 00000032 "    my $class = shift;"
NSQ_SOURCE_LINE 00000033 "    $class = ref($class) || $class;"
NSQ_SOURCE_LINE 00000034 "    my $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000035 "    while (@_) {"
NSQ_SOURCE_LINE 00000036 "        my $method = shift;"
NSQ_SOURCE_LINE 00000037 "        $self->$method(shift);"
NSQ_SOURCE_LINE 00000038 "    }"
NSQ_SOURCE_LINE 00000039 "    return $self;"
NSQ_SOURCE_LINE 00000040 "}"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "my $filtered_files = {};"
NSQ_SOURCE_LINE 00000043 "my $filter_dump = 0;"
NSQ_SOURCE_LINE 00000044 "my $filter_save = 0;"
NSQ_SOURCE_LINE 00000045 "our $filter_result = '';"
NSQ_SOURCE_LINE 00000046 "sub import {"
NSQ_SOURCE_LINE 00000047 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000048 "    no warnings;"
NSQ_SOURCE_LINE 00000049 "    my $self_package = shift;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    # XXX Using parse_arguments here might cause confusion, because the"
NSQ_SOURCE_LINE 00000052 "    # subclass's boolean_arguments and paired_arguments can conflict, causing"
NSQ_SOURCE_LINE 00000053 "    # difficult debugging. Consider using something truly local."
NSQ_SOURCE_LINE 00000054 "    my ($args, @export_list) = do {"
NSQ_SOURCE_LINE 00000055 "        local *boolean_arguments = sub {"
NSQ_SOURCE_LINE 00000056 "            qw("
NSQ_SOURCE_LINE 00000057 "                -base -Base -mixin -selfless"
NSQ_SOURCE_LINE 00000058 "                -XXX -dumper -yaml"
NSQ_SOURCE_LINE 00000059 "                -filter_dump -filter_save"
NSQ_SOURCE_LINE 00000060 "            )"
NSQ_SOURCE_LINE 00000061 "        };"
NSQ_SOURCE_LINE 00000062 "        local *paired_arguments = sub { qw(-package) };"
NSQ_SOURCE_LINE 00000063 "        $self_package->parse_arguments(@_);"
NSQ_SOURCE_LINE 00000064 "    };"
NSQ_SOURCE_LINE 00000065 "    return spiffy_mixin_import(scalar(caller(0)), $self_package, @export_list)"
NSQ_SOURCE_LINE 00000066 "      if $args->{-mixin};"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    $filter_dump = 1 if $args->{-filter_dump};"
NSQ_SOURCE_LINE 00000069 "    $filter_save = 1 if $args->{-filter_save};"
NSQ_SOURCE_LINE 00000070 "    $dump = 'yaml' if $args->{-yaml};"
NSQ_SOURCE_LINE 00000071 "    $dump = 'dumper' if $args->{-dumper};"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    local @EXPORT_BASE = @EXPORT_BASE;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    if ($args->{-XXX}) {"
NSQ_SOURCE_LINE 00000076 "        push @EXPORT_BASE, @{$EXPORT_TAGS{XXX}}"
NSQ_SOURCE_LINE 00000077 "          unless grep /^XXX$/, @EXPORT_BASE;"
NSQ_SOURCE_LINE 00000078 "    }"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "    spiffy_filter()"
NSQ_SOURCE_LINE 00000081 "      if ($args->{-selfless} or $args->{-Base}) and"
NSQ_SOURCE_LINE 00000082 "         not $filtered_files->{(caller($stack_frame))[1]}++;"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    my $caller_package = $args->{-package} || caller($stack_frame);"
NSQ_SOURCE_LINE 00000085 "    push @{\"$caller_package\\::ISA\"}, $self_package"
NSQ_SOURCE_LINE 00000086 "      if $args->{-Base} or $args->{-base};"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "    for my $class (@{all_my_bases($self_package)}) {"
NSQ_SOURCE_LINE 00000089 "        next unless $class->isa('Spiffy');"
NSQ_SOURCE_LINE 00000090 "        my @export = grep {"
NSQ_SOURCE_LINE 00000091 "            not defined &{\"$caller_package\\::$_\"};"
NSQ_SOURCE_LINE 00000092 "        } ( @{\"$class\\::EXPORT\"},"
NSQ_SOURCE_LINE 00000093 "            ($args->{-Base} or $args->{-base})"
NSQ_SOURCE_LINE 00000094 "              ? @{\"$class\\::EXPORT_BASE\"} : (),"
NSQ_SOURCE_LINE 00000095 "          );"
NSQ_SOURCE_LINE 00000096 "        my @export_ok = grep {"
NSQ_SOURCE_LINE 00000097 "            not defined &{\"$caller_package\\::$_\"};"
NSQ_SOURCE_LINE 00000098 "        } @{\"$class\\::EXPORT_OK\"};"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "        # Avoid calling the expensive Exporter::export"
NSQ_SOURCE_LINE 00000101 "        # if there is nothing to do (optimization)"
NSQ_SOURCE_LINE 00000102 "        my %exportable = map { ($_, 1) } @export, @export_ok;"
NSQ_SOURCE_LINE 00000103 "        next unless keys %exportable;"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "        my @export_save = @{\"$class\\::EXPORT\"};"
NSQ_SOURCE_LINE 00000106 "        my @export_ok_save = @{\"$class\\::EXPORT_OK\"};"
NSQ_SOURCE_LINE 00000107 "        @{\"$class\\::EXPORT\"} = @export;"
NSQ_SOURCE_LINE 00000108 "        @{\"$class\\::EXPORT_OK\"} = @export_ok;"
NSQ_SOURCE_LINE 00000109 "        my @list = grep {"
NSQ_SOURCE_LINE 00000110 "            (my $v = $_) =~ s/^[\\!\\:]//;"
NSQ_SOURCE_LINE 00000111 "            $exportable{$v} or ${\"$class\\::EXPORT_TAGS\"}{$v};"
NSQ_SOURCE_LINE 00000112 "        } @export_list;"
NSQ_SOURCE_LINE 00000113 "        Exporter::export($class, $caller_package, @list);"
NSQ_SOURCE_LINE 00000114 "        @{\"$class\\::EXPORT\"} = @export_save;"
NSQ_SOURCE_LINE 00000115 "        @{\"$class\\::EXPORT_OK\"} = @export_ok_save;"
NSQ_SOURCE_LINE 00000116 "    }"
NSQ_SOURCE_LINE 00000117 "}"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "sub spiffy_filter {"
NSQ_SOURCE_LINE 00000120 "    require Filter::Util::Call;"
NSQ_SOURCE_LINE 00000121 "    my $done = 0;"
NSQ_SOURCE_LINE 00000122 "    Filter::Util::Call::filter_add("
NSQ_SOURCE_LINE 00000123 "        sub {"
NSQ_SOURCE_LINE 00000124 "            return 0 if $done;"
NSQ_SOURCE_LINE 00000125 "            my ($data, $end) = ('', '');"
NSQ_SOURCE_LINE 00000126 "            while (my $status = Filter::Util::Call::filter_read()) {"
NSQ_SOURCE_LINE 00000127 "                return $status if $status < 0;"
NSQ_SOURCE_LINE 00000128 "                if (/^__(?:END|DATA)__\\r?$/) {"
NSQ_SOURCE_LINE 00000129 "                    $end = $_;"
NSQ_SOURCE_LINE 00000130 "                    last;"
NSQ_SOURCE_LINE 00000131 "                }"
NSQ_SOURCE_LINE 00000132 "                $data .= $_;"
NSQ_SOURCE_LINE 00000133 "                $_ = '';"
NSQ_SOURCE_LINE 00000134 "            }"
NSQ_SOURCE_LINE 00000135 "            $_ = $data;"
NSQ_SOURCE_LINE 00000136 "            my @my_subs;"
NSQ_SOURCE_LINE 00000137 "            s[^(sub\\s+\\w+\\s+\\{)(.*\\n)]"
NSQ_SOURCE_LINE 00000138 "             [${1}my \\$self = shift;$2]gm;"
NSQ_SOURCE_LINE 00000139 "            s[^(sub\\s+\\w+)\\s*\\(\\s*\\)(\\s+\\{.*\\n)]"
NSQ_SOURCE_LINE 00000140 "             [${1}${2}]gm;"
NSQ_SOURCE_LINE 00000141 "            s[^my\\s+sub\\s+(\\w+)(\\s+\\{)(.*)((?s:.*?\\n))\\}\\n]"
NSQ_SOURCE_LINE 00000142 "             [push @my_subs, $1; \"\\$$1 = sub$2my \\$self = shift;$3$4\\};\\n\"]gem;"
NSQ_SOURCE_LINE 00000143 "            my $preclare = '';"
NSQ_SOURCE_LINE 00000144 "            if (@my_subs) {"
NSQ_SOURCE_LINE 00000145 "                $preclare = join ',', map \"\\$$_\", @my_subs;"
NSQ_SOURCE_LINE 00000146 "                $preclare = \"my($preclare);\";"
NSQ_SOURCE_LINE 00000147 "            }"
NSQ_SOURCE_LINE 00000148 "            $_ = \"use strict;use warnings;$preclare${_};1;\\n$end\";"
NSQ_SOURCE_LINE 00000149 "            if ($filter_dump) { print; exit }"
NSQ_SOURCE_LINE 00000150 "            if ($filter_save) { $filter_result = $_; $_ = $filter_result; }"
NSQ_SOURCE_LINE 00000151 "            $done = 1;"
NSQ_SOURCE_LINE 00000152 "        }"
NSQ_SOURCE_LINE 00000153 "    );"
NSQ_SOURCE_LINE 00000154 "}"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "sub base {"
NSQ_SOURCE_LINE 00000157 "    push @_, -base;"
NSQ_SOURCE_LINE 00000158 "    goto &import;"
NSQ_SOURCE_LINE 00000159 "}"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "sub all_my_bases {"
NSQ_SOURCE_LINE 00000162 "    my $class = shift;"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "    return $bases_map->{$class}"
NSQ_SOURCE_LINE 00000165 "      if defined $bases_map->{$class};"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    my @bases = ($class);"
NSQ_SOURCE_LINE 00000168 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000169 "    for my $base_class (@{\"${class}::ISA\"}) {"
NSQ_SOURCE_LINE 00000170 "        push @bases, @{all_my_bases($base_class)};"
NSQ_SOURCE_LINE 00000171 "    }"
NSQ_SOURCE_LINE 00000172 "    my $used = {};"
NSQ_SOURCE_LINE 00000173 "    $bases_map->{$class} = [grep {not $used->{$_}++} @bases];"
NSQ_SOURCE_LINE 00000174 "}"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "my %code = ("
NSQ_SOURCE_LINE 00000177 "    sub_start =>"
NSQ_SOURCE_LINE 00000178 "      \"sub {\\n\","
NSQ_SOURCE_LINE 00000179 "    set_default =>"
NSQ_SOURCE_LINE 00000180 "      \"  \\$_[0]->{%s} = %s\\n    unless exists \\$_[0]->{%s};\\n\","
NSQ_SOURCE_LINE 00000181 "    init =>"
NSQ_SOURCE_LINE 00000182 "      \"  return \\$_[0]->{%s} = do { my \\$self = \\$_[0]; %s }\\n\" ."
NSQ_SOURCE_LINE 00000183 "      \"    unless \\$#_ > 0 or defined \\$_[0]->{%s};\\n\","
NSQ_SOURCE_LINE 00000184 "    weak_init =>"
NSQ_SOURCE_LINE 00000185 "      \"  return do {\\n\" ."
NSQ_SOURCE_LINE 00000186 "      \"    \\$_[0]->{%s} = do { my \\$self = \\$_[0]; %s };\\n\" ."
NSQ_SOURCE_LINE 00000187 "      \"    Scalar::Util::weaken(\\$_[0]->{%s}) if ref \\$_[0]->{%s};\\n\" ."
NSQ_SOURCE_LINE 00000188 "      \"    \\$_[0]->{%s};\\n\" ."
NSQ_SOURCE_LINE 00000189 "      \"  } unless \\$#_ > 0 or defined \\$_[0]->{%s};\\n\","
NSQ_SOURCE_LINE 00000190 "    return_if_get =>"
NSQ_SOURCE_LINE 00000191 "      \"  return \\$_[0]->{%s} unless \\$#_ > 0;\\n\","
NSQ_SOURCE_LINE 00000192 "    set =>"
NSQ_SOURCE_LINE 00000193 "      \"  \\$_[0]->{%s} = \\$_[1];\\n\","
NSQ_SOURCE_LINE 00000194 "    weaken =>"
NSQ_SOURCE_LINE 00000195 "      \"  Scalar::Util::weaken(\\$_[0]->{%s}) if ref \\$_[0]->{%s};\\n\","
NSQ_SOURCE_LINE 00000196 "    sub_end =>"
NSQ_SOURCE_LINE 00000197 "      \"  return \\$_[0]->{%s};\\n}\\n\","
NSQ_SOURCE_LINE 00000198 ");"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "sub field {"
NSQ_SOURCE_LINE 00000201 "    my $package = caller;"
NSQ_SOURCE_LINE 00000202 "    my ($args, @values) = do {"
NSQ_SOURCE_LINE 00000203 "        no warnings;"
NSQ_SOURCE_LINE 00000204 "        local *boolean_arguments = sub { (qw(-weak)) };"
NSQ_SOURCE_LINE 00000205 "        local *paired_arguments = sub { (qw(-package -init)) };"
NSQ_SOURCE_LINE 00000206 "        Spiffy->parse_arguments(@_);"
NSQ_SOURCE_LINE 00000207 "    };"
NSQ_SOURCE_LINE 00000208 "    my ($field, $default) = @values;"
NSQ_SOURCE_LINE 00000209 "    $package = $args->{-package} if defined $args->{-package};"
NSQ_SOURCE_LINE 00000210 "    die \"Cannot have a default for a weakened field ($field)\""
NSQ_SOURCE_LINE 00000211 "        if defined $default && $args->{-weak};"
NSQ_SOURCE_LINE 00000212 "    return if defined &{\"${package}::$field\"};"
NSQ_SOURCE_LINE 00000213 "    require Scalar::Util if $args->{-weak};"
NSQ_SOURCE_LINE 00000214 "    my $default_string ="
NSQ_SOURCE_LINE 00000215 "        ( ref($default) eq 'ARRAY' and not @$default )"
NSQ_SOURCE_LINE 00000216 "        ? '[]'"
NSQ_SOURCE_LINE 00000217 "        : (ref($default) eq 'HASH' and not keys %$default )"
NSQ_SOURCE_LINE 00000218 "          ? '{}'"
NSQ_SOURCE_LINE 00000219 "          : default_as_code($default);"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "    my $code = $code{sub_start};"
NSQ_SOURCE_LINE 00000222 "    if ($args->{-init}) {"
NSQ_SOURCE_LINE 00000223 "        my $fragment = $args->{-weak} ? $code{weak_init} : $code{init};"
NSQ_SOURCE_LINE 00000224 "        my @count = ($fragment =~ /(%s)/g);"
NSQ_SOURCE_LINE 00000225 "        $code .= sprintf $fragment, $field, $args->{-init}, ($field) x (@count - 2);"
NSQ_SOURCE_LINE 00000226 "    }"
NSQ_SOURCE_LINE 00000227 "    $code .= sprintf $code{set_default}, $field, $default_string, $field"
NSQ_SOURCE_LINE 00000228 "      if defined $default;"
NSQ_SOURCE_LINE 00000229 "    $code .= sprintf $code{return_if_get}, $field;"
NSQ_SOURCE_LINE 00000230 "    $code .= sprintf $code{set}, $field;"
NSQ_SOURCE_LINE 00000231 "    $code .= sprintf $code{weaken}, $field, $field"
NSQ_SOURCE_LINE 00000232 "      if $args->{-weak};"
NSQ_SOURCE_LINE 00000233 "    $code .= sprintf $code{sub_end}, $field;"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "    my $sub = eval $code;"
NSQ_SOURCE_LINE 00000236 "    die $@ if $@;"
NSQ_SOURCE_LINE 00000237 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000238 "    *{\"${package}::$field\"} = $sub;"
NSQ_SOURCE_LINE 00000239 "    return $code if defined wantarray;"
NSQ_SOURCE_LINE 00000240 "}"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "sub default_as_code {"
NSQ_SOURCE_LINE 00000243 "    require Data::Dumper;"
NSQ_SOURCE_LINE 00000244 "    local $Data::Dumper::Sortkeys = 1;"
NSQ_SOURCE_LINE 00000245 "    my $code = Data::Dumper::Dumper(shift);"
NSQ_SOURCE_LINE 00000246 "    $code =~ s/^\\$VAR1 = //;"
NSQ_SOURCE_LINE 00000247 "    $code =~ s/;$//;"
NSQ_SOURCE_LINE 00000248 "    return $code;"
NSQ_SOURCE_LINE 00000249 "}"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "sub const {"
NSQ_SOURCE_LINE 00000252 "    my $package = caller;"
NSQ_SOURCE_LINE 00000253 "    my ($args, @values) = do {"
NSQ_SOURCE_LINE 00000254 "        no warnings;"
NSQ_SOURCE_LINE 00000255 "        local *paired_arguments = sub { (qw(-package)) };"
NSQ_SOURCE_LINE 00000256 "        Spiffy->parse_arguments(@_);"
NSQ_SOURCE_LINE 00000257 "    };"
NSQ_SOURCE_LINE 00000258 "    my ($field, $default) = @values;"
NSQ_SOURCE_LINE 00000259 "    $package = $args->{-package} if defined $args->{-package};"
NSQ_SOURCE_LINE 00000260 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000261 "    return if defined &{\"${package}::$field\"};"
NSQ_SOURCE_LINE 00000262 "    *{\"${package}::$field\"} = sub { $default }"
NSQ_SOURCE_LINE 00000263 "}"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "sub stub {"
NSQ_SOURCE_LINE 00000266 "    my $package = caller;"
NSQ_SOURCE_LINE 00000267 "    my ($args, @values) = do {"
NSQ_SOURCE_LINE 00000268 "        no warnings;"
NSQ_SOURCE_LINE 00000269 "        local *paired_arguments = sub { (qw(-package)) };"
NSQ_SOURCE_LINE 00000270 "        Spiffy->parse_arguments(@_);"
NSQ_SOURCE_LINE 00000271 "    };"
NSQ_SOURCE_LINE 00000272 "    my ($field, $default) = @values;"
NSQ_SOURCE_LINE 00000273 "    $package = $args->{-package} if defined $args->{-package};"
NSQ_SOURCE_LINE 00000274 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000275 "    return if defined &{\"${package}::$field\"};"
NSQ_SOURCE_LINE 00000276 "    *{\"${package}::$field\"} ="
NSQ_SOURCE_LINE 00000277 "    sub {"
NSQ_SOURCE_LINE 00000278 "        require Carp;"
NSQ_SOURCE_LINE 00000279 "        Carp::confess"
NSQ_SOURCE_LINE 00000280 "          \"Method $field in package $package must be subclassed\";"
NSQ_SOURCE_LINE 00000281 "    }"
NSQ_SOURCE_LINE 00000282 "}"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "sub parse_arguments {"
NSQ_SOURCE_LINE 00000285 "    my $class = shift;"
NSQ_SOURCE_LINE 00000286 "    my ($args, @values) = ({}, ());"
NSQ_SOURCE_LINE 00000287 "    my %booleans = map { ($_, 1) } $class->boolean_arguments;"
NSQ_SOURCE_LINE 00000288 "    my %pairs = map { ($_, 1) } $class->paired_arguments;"
NSQ_SOURCE_LINE 00000289 "    while (@_) {"
NSQ_SOURCE_LINE 00000290 "        my $elem = shift;"
NSQ_SOURCE_LINE 00000291 "        if (defined $elem and defined $booleans{$elem}) {"
NSQ_SOURCE_LINE 00000292 "            $args->{$elem} = (@_ and $_[0] =~ /^[01]$/)"
NSQ_SOURCE_LINE 00000293 "            ? shift"
NSQ_SOURCE_LINE 00000294 "            : 1;"
NSQ_SOURCE_LINE 00000295 "        }"
NSQ_SOURCE_LINE 00000296 "        elsif (defined $elem and defined $pairs{$elem} and @_) {"
NSQ_SOURCE_LINE 00000297 "            $args->{$elem} = shift;"
NSQ_SOURCE_LINE 00000298 "        }"
NSQ_SOURCE_LINE 00000299 "        else {"
NSQ_SOURCE_LINE 00000300 "            push @values, $elem;"
NSQ_SOURCE_LINE 00000301 "        }"
NSQ_SOURCE_LINE 00000302 "    }"
NSQ_SOURCE_LINE 00000303 "    return wantarray ? ($args, @values) : $args;"
NSQ_SOURCE_LINE 00000304 "}"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "sub boolean_arguments { () }"
NSQ_SOURCE_LINE 00000307 "sub paired_arguments { () }"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "# get a unique id for any node"
NSQ_SOURCE_LINE 00000310 "sub id {"
NSQ_SOURCE_LINE 00000311 "    if (not ref $_[0]) {"
NSQ_SOURCE_LINE 00000312 "        return 'undef' if not defined $_[0];"
NSQ_SOURCE_LINE 00000313 "        \\$_[0] =~ /\\((\\w+)\\)$/o or die;"
NSQ_SOURCE_LINE 00000314 "        return \"$1-S\";"
NSQ_SOURCE_LINE 00000315 "    }"
NSQ_SOURCE_LINE 00000316 "    require overload;"
NSQ_SOURCE_LINE 00000317 "    overload::StrVal($_[0]) =~ /\\((\\w+)\\)$/o or die;"
NSQ_SOURCE_LINE 00000318 "    return $1;"
NSQ_SOURCE_LINE 00000319 "}"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "#==============================================================================="
NSQ_SOURCE_LINE 00000322 "# It's super, man."
NSQ_SOURCE_LINE 00000323 "#==============================================================================="
NSQ_SOURCE_LINE 00000324 "package DB;"
NSQ_SOURCE_LINE 00000325 "{"
NSQ_SOURCE_LINE 00000326 "    no warnings 'redefine';"
NSQ_SOURCE_LINE 00000327 "    sub super_args {"
NSQ_SOURCE_LINE 00000328 "        my @dummy = caller(@_ ? $_[0] : 2);"
NSQ_SOURCE_LINE 00000329 "        return @DB::args;"
NSQ_SOURCE_LINE 00000330 "    }"
NSQ_SOURCE_LINE 00000331 "}"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "package Spiffy;"
NSQ_SOURCE_LINE 00000334 "sub super {"
NSQ_SOURCE_LINE 00000335 "    my $method;"
NSQ_SOURCE_LINE 00000336 "    my $frame = 1;"
NSQ_SOURCE_LINE 00000337 "    while ($method = (caller($frame++))[3]) {"
NSQ_SOURCE_LINE 00000338 "        $method =~ s/.*::// and last;"
NSQ_SOURCE_LINE 00000339 "    }"
NSQ_SOURCE_LINE 00000340 "    my @args = DB::super_args($frame);"
NSQ_SOURCE_LINE 00000341 "    @_ = @_ ? ($args[0], @_) : @args;"
NSQ_SOURCE_LINE 00000342 "    my $class = ref $_[0] ? ref $_[0] : $_[0];"
NSQ_SOURCE_LINE 00000343 "    my $caller_class = caller;"
NSQ_SOURCE_LINE 00000344 "    my $seen = 0;"
NSQ_SOURCE_LINE 00000345 "    my @super_classes = reverse grep {"
NSQ_SOURCE_LINE 00000346 "        ($seen or $seen = ($_ eq $caller_class)) ? 0 : 1;"
NSQ_SOURCE_LINE 00000347 "    } reverse @{all_my_bases($class)};"
NSQ_SOURCE_LINE 00000348 "    for my $super_class (@super_classes) {"
NSQ_SOURCE_LINE 00000349 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000350 "        next if $super_class eq $class;"
NSQ_SOURCE_LINE 00000351 "        if (defined &{\"${super_class}::$method\"}) {"
NSQ_SOURCE_LINE 00000352 "            ${\"$super_class\\::AUTOLOAD\"} = ${\"$class\\::AUTOLOAD\"}"
NSQ_SOURCE_LINE 00000353 "              if $method eq 'AUTOLOAD';"
NSQ_SOURCE_LINE 00000354 "            return &{\"${super_class}::$method\"};"
NSQ_SOURCE_LINE 00000355 "        }"
NSQ_SOURCE_LINE 00000356 "    }"
NSQ_SOURCE_LINE 00000357 "    return;"
NSQ_SOURCE_LINE 00000358 "}"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "#==============================================================================="
NSQ_SOURCE_LINE 00000361 "# This code deserves a spanking, because it is being very naughty."
NSQ_SOURCE_LINE 00000362 "# It is exchanging base.pm's import() for its own, so that people"
NSQ_SOURCE_LINE 00000363 "# can use base.pm with Spiffy modules, without being the wiser."
NSQ_SOURCE_LINE 00000364 "#==============================================================================="
NSQ_SOURCE_LINE 00000365 "my $real_base_import;"
NSQ_SOURCE_LINE 00000366 "my $real_mixin_import;"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "BEGIN {"
NSQ_SOURCE_LINE 00000369 "    require base unless defined $INC{'base.pm'};"
NSQ_SOURCE_LINE 00000370 "    $INC{'mixin.pm'} ||= 'Spiffy/mixin.pm';"
NSQ_SOURCE_LINE 00000371 "    $real_base_import = \\&base::import;"
NSQ_SOURCE_LINE 00000372 "    $real_mixin_import = \\&mixin::import;"
NSQ_SOURCE_LINE 00000373 "    no warnings;"
NSQ_SOURCE_LINE 00000374 "    *base::import = \\&spiffy_base_import;"
NSQ_SOURCE_LINE 00000375 "    *mixin::import = \\&spiffy_mixin_import;"
NSQ_SOURCE_LINE 00000376 "}"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "# my $i = 0;"
NSQ_SOURCE_LINE 00000379 "# while (my $caller = caller($i++)) {"
NSQ_SOURCE_LINE 00000380 "#     next unless $caller eq 'base' or $caller eq 'mixin';"
NSQ_SOURCE_LINE 00000381 "#     croak <<END;"
NSQ_SOURCE_LINE 00000382 "# Spiffy.pm must be loaded before calling 'use base' or 'use mixin' with a"
NSQ_SOURCE_LINE 00000383 "# Spiffy module. See the documentation of Spiffy.pm for details."
NSQ_SOURCE_LINE 00000384 "# END"
NSQ_SOURCE_LINE 00000385 "# }"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "sub spiffy_base_import {"
NSQ_SOURCE_LINE 00000388 "    my @base_classes = @_;"
NSQ_SOURCE_LINE 00000389 "    shift @base_classes;"
NSQ_SOURCE_LINE 00000390 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000391 "    goto &$real_base_import"
NSQ_SOURCE_LINE 00000392 "      unless grep {"
NSQ_SOURCE_LINE 00000393 "          eval \"require $_\" unless %{\"$_\\::\"};"
NSQ_SOURCE_LINE 00000394 "          $_->isa('Spiffy');"
NSQ_SOURCE_LINE 00000395 "      } @base_classes;"
NSQ_SOURCE_LINE 00000396 "    my $inheritor = caller(0);"
NSQ_SOURCE_LINE 00000397 "    for my $base_class (@base_classes) {"
NSQ_SOURCE_LINE 00000398 "        next if $inheritor->isa($base_class);"
NSQ_SOURCE_LINE 00000399 "        croak \"Can't mix Spiffy and non-Spiffy classes in 'use base'.\\n\","
NSQ_SOURCE_LINE 00000400 "              \"See the documentation of Spiffy.pm for details\\n  \""
NSQ_SOURCE_LINE 00000401 "          unless $base_class->isa('Spiffy');"
NSQ_SOURCE_LINE 00000402 "        $stack_frame = 1; # tell import to use different caller"
NSQ_SOURCE_LINE 00000403 "        import($base_class, '-base');"
NSQ_SOURCE_LINE 00000404 "        $stack_frame = 0;"
NSQ_SOURCE_LINE 00000405 "    }"
NSQ_SOURCE_LINE 00000406 "}"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "sub mixin {"
NSQ_SOURCE_LINE 00000409 "    my $self = shift;"
NSQ_SOURCE_LINE 00000410 "    my $target_class = ref($self);"
NSQ_SOURCE_LINE 00000411 "    spiffy_mixin_import($target_class, @_)"
NSQ_SOURCE_LINE 00000412 "}"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "sub spiffy_mixin_import {"
NSQ_SOURCE_LINE 00000415 "    my $target_class = shift;"
NSQ_SOURCE_LINE 00000416 "    $target_class = caller(0)"
NSQ_SOURCE_LINE 00000417 "      if $target_class eq 'mixin';"
NSQ_SOURCE_LINE 00000418 "    my $mixin_class = shift"
NSQ_SOURCE_LINE 00000419 "      or die \"Nothing to mixin\";"
NSQ_SOURCE_LINE 00000420 "    eval \"require $mixin_class\";"
NSQ_SOURCE_LINE 00000421 "    my @roles = @_;"
NSQ_SOURCE_LINE 00000422 "    my $pseudo_class = join '-', $target_class, $mixin_class, @roles;"
NSQ_SOURCE_LINE 00000423 "    my %methods = spiffy_mixin_methods($mixin_class, @roles);"
NSQ_SOURCE_LINE 00000424 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000425 "    no warnings;"
NSQ_SOURCE_LINE 00000426 "    @{\"$pseudo_class\\::ISA\"} = @{\"$target_class\\::ISA\"};"
NSQ_SOURCE_LINE 00000427 "    @{\"$target_class\\::ISA\"} = ($pseudo_class);"
NSQ_SOURCE_LINE 00000428 "    for (keys %methods) {"
NSQ_SOURCE_LINE 00000429 "        *{\"$pseudo_class\\::$_\"} = $methods{$_};"
NSQ_SOURCE_LINE 00000430 "    }"
NSQ_SOURCE_LINE 00000431 "}"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "sub spiffy_mixin_methods {"
NSQ_SOURCE_LINE 00000434 "    my $mixin_class = shift;"
NSQ_SOURCE_LINE 00000435 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000436 "    my %methods = spiffy_all_methods($mixin_class);"
NSQ_SOURCE_LINE 00000437 "    map {"
NSQ_SOURCE_LINE 00000438 "        $methods{$_}"
NSQ_SOURCE_LINE 00000439 "          ? ($_, \\ &{\"$methods{$_}\\::$_\"})"
NSQ_SOURCE_LINE 00000440 "          : ($_, \\ &{\"$mixin_class\\::$_\"})"
NSQ_SOURCE_LINE 00000441 "    } @_"
NSQ_SOURCE_LINE 00000442 "      ? (get_roles($mixin_class, @_))"
NSQ_SOURCE_LINE 00000443 "      : (keys %methods);"
NSQ_SOURCE_LINE 00000444 "}"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "sub get_roles {"
NSQ_SOURCE_LINE 00000447 "    my $mixin_class = shift;"
NSQ_SOURCE_LINE 00000448 "    my @roles = @_;"
NSQ_SOURCE_LINE 00000449 "    while (grep /^!*:/, @roles) {"
NSQ_SOURCE_LINE 00000450 "        @roles = map {"
NSQ_SOURCE_LINE 00000451 "            s/!!//g;"
NSQ_SOURCE_LINE 00000452 "            /^!:(.*)/ ? do {"
NSQ_SOURCE_LINE 00000453 "                my $m = \"_role_$1\";"
NSQ_SOURCE_LINE 00000454 "                map(\"!$_\", $mixin_class->$m);"
NSQ_SOURCE_LINE 00000455 "            } :"
NSQ_SOURCE_LINE 00000456 "            /^:(.*)/ ? do {"
NSQ_SOURCE_LINE 00000457 "                my $m = \"_role_$1\";"
NSQ_SOURCE_LINE 00000458 "                ($mixin_class->$m);"
NSQ_SOURCE_LINE 00000459 "            } :"
NSQ_SOURCE_LINE 00000460 "            ($_)"
NSQ_SOURCE_LINE 00000461 "        } @roles;"
NSQ_SOURCE_LINE 00000462 "    }"
NSQ_SOURCE_LINE 00000463 "    if (@roles and $roles[0] =~ /^!/) {"
NSQ_SOURCE_LINE 00000464 "        my %methods = spiffy_all_methods($mixin_class);"
NSQ_SOURCE_LINE 00000465 "        unshift @roles, keys(%methods);"
NSQ_SOURCE_LINE 00000466 "    }"
NSQ_SOURCE_LINE 00000467 "    my %roles;"
NSQ_SOURCE_LINE 00000468 "    for (@roles) {"
NSQ_SOURCE_LINE 00000469 "        s/!!//g;"
NSQ_SOURCE_LINE 00000470 "        delete $roles{$1}, next"
NSQ_SOURCE_LINE 00000471 "          if /^!(.*)/;"
NSQ_SOURCE_LINE 00000472 "        $roles{$_} = 1;"
NSQ_SOURCE_LINE 00000473 "    }"
NSQ_SOURCE_LINE 00000474 "    keys %roles;"
NSQ_SOURCE_LINE 00000475 "}"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "sub spiffy_all_methods {"
NSQ_SOURCE_LINE 00000478 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000479 "    my $class = shift;"
NSQ_SOURCE_LINE 00000480 "    return if $class eq 'Spiffy';"
NSQ_SOURCE_LINE 00000481 "    my %methods = map {"
NSQ_SOURCE_LINE 00000482 "        ($_, $class)"
NSQ_SOURCE_LINE 00000483 "    } grep {"
NSQ_SOURCE_LINE 00000484 "        defined &{\"$class\\::$_\"} and not /^_/"
NSQ_SOURCE_LINE 00000485 "    } keys %{\"$class\\::\"};"
NSQ_SOURCE_LINE 00000486 "    my %super_methods;"
NSQ_SOURCE_LINE 00000487 "    %super_methods = spiffy_all_methods(${\"$class\\::ISA\"}[0])"
NSQ_SOURCE_LINE 00000488 "      if @{\"$class\\::ISA\"};"
NSQ_SOURCE_LINE 00000489 "    %{{%super_methods, %methods}};"
NSQ_SOURCE_LINE 00000490 "}"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "# END of naughty code."
NSQ_SOURCE_LINE 00000494 "#==============================================================================="
NSQ_SOURCE_LINE 00000495 "# Debugging support"
NSQ_SOURCE_LINE 00000496 "#==============================================================================="
NSQ_SOURCE_LINE 00000497 "sub spiffy_dump {"
NSQ_SOURCE_LINE 00000498 "    no warnings;"
NSQ_SOURCE_LINE 00000499 "    if ($dump eq 'dumper') {"
NSQ_SOURCE_LINE 00000500 "        require Data::Dumper;"
NSQ_SOURCE_LINE 00000501 "        $Data::Dumper::Sortkeys = 1;"
NSQ_SOURCE_LINE 00000502 "        $Data::Dumper::Indent = 1;"
NSQ_SOURCE_LINE 00000503 "        return Data::Dumper::Dumper(@_);"
NSQ_SOURCE_LINE 00000504 "    }"
NSQ_SOURCE_LINE 00000505 "    require YAML;"
NSQ_SOURCE_LINE 00000506 "    $YAML::UseVersion = 0;"
NSQ_SOURCE_LINE 00000507 "    return YAML::Dump(@_) . \"...\\n\";"
NSQ_SOURCE_LINE 00000508 "}"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "sub at_line_number {"
NSQ_SOURCE_LINE 00000511 "    my ($file_path, $line_number) = (caller(1))[1,2];"
NSQ_SOURCE_LINE 00000512 "    \"  at $file_path line $line_number\\n\";"
NSQ_SOURCE_LINE 00000513 "}"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "sub WWW {"
NSQ_SOURCE_LINE 00000516 "    warn spiffy_dump(@_) . at_line_number;"
NSQ_SOURCE_LINE 00000517 "    return wantarray ? @_ : $_[0];"
NSQ_SOURCE_LINE 00000518 "}"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "sub XXX {"
NSQ_SOURCE_LINE 00000521 "    die spiffy_dump(@_) . at_line_number;"
NSQ_SOURCE_LINE 00000522 "}"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "sub YYY {"
NSQ_SOURCE_LINE 00000525 "    print spiffy_dump(@_) . at_line_number;"
NSQ_SOURCE_LINE 00000526 "    return wantarray ? @_ : $_[0];"
NSQ_SOURCE_LINE 00000527 "}"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "sub ZZZ {"
NSQ_SOURCE_LINE 00000530 "    require Carp;"
NSQ_SOURCE_LINE 00000531 "    Carp::confess spiffy_dump(@_);"
NSQ_SOURCE_LINE 00000532 "}"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "1;"
BODY_END
