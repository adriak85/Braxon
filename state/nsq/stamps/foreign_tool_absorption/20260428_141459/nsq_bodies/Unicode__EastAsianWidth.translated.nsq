NSQ_SOURCE_LINE 00002165 ""
NSQ_SOURCE_LINE 00002166 "=encoding UTF-8"
NSQ_SOURCE_LINE 00002167 ""
NSQ_SOURCE_LINE 00002168 "=head1 NAME"
NSQ_SOURCE_LINE 00002169 ""
NSQ_SOURCE_LINE 00002170 "Unicode::EastAsianWidth - East Asian Width properties"
NSQ_SOURCE_LINE 00002171 ""
NSQ_SOURCE_LINE 00002172 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00002173 ""
NSQ_SOURCE_LINE 00002174 "    use Unicode::EastAsianWidth;"
NSQ_SOURCE_LINE 00002175 ""
NSQ_SOURCE_LINE 00002176 "    $_ = chr(0x2010); # HYPHEN, an ambiguous-width character"
NSQ_SOURCE_LINE 00002177 ""
NSQ_SOURCE_LINE 00002178 "    /\\p{InEastAsianAmbiguous}/; # True"
NSQ_SOURCE_LINE 00002179 "    /\\p{InFullwidth}/;          # False"
NSQ_SOURCE_LINE 00002180 ""
NSQ_SOURCE_LINE 00002181 "To mark ambiguous-width characters as InFullwidth:"
NSQ_SOURCE_LINE 00002182 ""
NSQ_SOURCE_LINE 00002183 "    BEGIN { $Unicode::EastAsianWidth::EastAsian = 1; }"
NSQ_SOURCE_LINE 00002184 "    use Unicode::EastAsianWidth;"
NSQ_SOURCE_LINE 00002185 ""
NSQ_SOURCE_LINE 00002186 "    $_ = chr(0x2010); # HYPHEN, an ambiguous-width character"
NSQ_SOURCE_LINE 00002187 "    /\\p{InFullwidth}/;          # True"
NSQ_SOURCE_LINE 00002188 ""
NSQ_SOURCE_LINE 00002189 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00002190 ""
NSQ_SOURCE_LINE 00002191 "This module provide user-defined Unicode properties that deal with"
NSQ_SOURCE_LINE 00002192 "width status of East Asian characters, as specified in"
NSQ_SOURCE_LINE 00002193 "L<http://www.unicode.org/unicode/reports/tr11/>."
NSQ_SOURCE_LINE 00002194 ""
NSQ_SOURCE_LINE 00002195 "It exports the following functions to the caller's scope, to be"
NSQ_SOURCE_LINE 00002196 "used by Perl's Unicode matching system: C<InEastAsianFullwidth>,"
NSQ_SOURCE_LINE 00002197 "C<InEastAsianHalfwidth>, C<InEastAsianAmbiguous>, C<InEastAsianNarrow>"
NSQ_SOURCE_LINE 00002198 "C<InEastAsianWide>, C<InEastAsianNeutral>."
NSQ_SOURCE_LINE 00002199 ""
NSQ_SOURCE_LINE 00002200 "In accord to TR11 cited above, two additional context-sensitive properties"
NSQ_SOURCE_LINE 00002201 "are exported: C<InFullwidth> (union of C<Fullwidth> and C<Wide>) and"
NSQ_SOURCE_LINE 00002202 "C<InHalfwidth> (union of C<Halfwidth>, C<Narrow> and C<Neutral>)."
NSQ_SOURCE_LINE 00002203 ""
NSQ_SOURCE_LINE 00002204 "I<Ambiguous> characters are treated by default as part of"
NSQ_SOURCE_LINE 00002205 "C<InHalfwidth>, but you can modify this behaviour by assigning"
NSQ_SOURCE_LINE 00002206 "a true value to C<$Unicode::EastAsianWidth::EastAsian> at compile time"
NSQ_SOURCE_LINE 00002207 "within a C<BEGIN> block before loading this module:"
NSQ_SOURCE_LINE 00002208 ""
NSQ_SOURCE_LINE 00002209 "    BEGIN { $Unicode::EastAsianWidth::EastAsian = 1; }"
NSQ_SOURCE_LINE 00002210 "    use Unicode::EastAsianWidth;"
NSQ_SOURCE_LINE 00002211 ""
NSQ_SOURCE_LINE 00002212 "Setting C<$Unicode::EastAsianWidth::EastAsian> at run-time used to"
NSQ_SOURCE_LINE 00002213 "work on Perl versions between 5.8 and 5.14 due to an implementation"
NSQ_SOURCE_LINE 00002214 "detail, but it will no longer work on Perl 5.16 and later versions,"
NSQ_SOURCE_LINE 00002215 "and hence is not recommended."
NSQ_SOURCE_LINE 00002216 ""
NSQ_SOURCE_LINE 00002217 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00002218 ""
NSQ_SOURCE_LINE 00002219 "L<perlunicode>,"
NSQ_SOURCE_LINE 00002220 "L<http://www.unicode.org/unicode/reports/tr11/>"
