NSQ_SOURCE_LINE 00000036 "package Socket6;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "use strict;"
NSQ_SOURCE_LINE 00000039 "use vars qw($VERSION @ISA @EXPORT @EXPORT_OK %EXPORT_TAGS $AUTOLOAD);"
NSQ_SOURCE_LINE 00000040 "$VERSION = \"0.29\";"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=head1 NAME"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "Socket6 - IPv6 related part of the C socket.h defines and structure manipulators"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "    use Socket;"
NSQ_SOURCE_LINE 00000049 "    use Socket6;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    @res = getaddrinfo('hishost.com', 'daytime', AF_UNSPEC, SOCK_STREAM);"
NSQ_SOURCE_LINE 00000052 "    $family = -1;"
NSQ_SOURCE_LINE 00000053 "    while (scalar(@res) >= 5) {"
NSQ_SOURCE_LINE 00000054 "\t($family, $socktype, $proto, $saddr, $canonname, @res) = @res;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "\t($host, $port) = getnameinfo($saddr, NI_NUMERICHOST | NI_NUMERICSERV);"
NSQ_SOURCE_LINE 00000057 "\tprint STDERR \"Trying to connect to $host port $port...\\n\";"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "\tsocket(Socket_Handle, $family, $socktype, $proto) || next;"
NSQ_SOURCE_LINE 00000060 "        connect(Socket_Handle, $saddr) && last;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "\tclose(Socket_Handle);"
NSQ_SOURCE_LINE 00000063 "\t$family = -1;"
NSQ_SOURCE_LINE 00000064 "    }"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    if ($family != -1) {"
NSQ_SOURCE_LINE 00000067 "\tprint STDERR \"connected to $host port $port\\n\";"
NSQ_SOURCE_LINE 00000068 "    } else {"
NSQ_SOURCE_LINE 00000069 "\tdie \"connect attempt failed\\n\";"
NSQ_SOURCE_LINE 00000070 "    }"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "This module provides glue routines to the various IPv6 functions."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "If you use the Socket6 module,"
NSQ_SOURCE_LINE 00000077 "be sure to specify \"use Socket\" as well as \"use Socket6\"."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "Functions supplied are:"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "=over"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=item inet_pton FAMILY, TEXT_ADDRESS"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    This function takes an IP address in presentation (or string) format"
NSQ_SOURCE_LINE 00000086 "    and converts it into numeric (or binary) format."
NSQ_SOURCE_LINE 00000087 "    The type of IP address conversion (IPv4 versus IPv6) is controlled"
NSQ_SOURCE_LINE 00000088 "    by the FAMILY argument."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "=item inet_ntop FAMILY, BINARY_ADDRESS"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    This function takes an IP address in numeric (or binary) format"
NSQ_SOURCE_LINE 00000093 "    and converts it into presentation (or string) format"
NSQ_SOURCE_LINE 00000094 "    The type of IP address conversion (IPv4 versus IPv6) is controlled"
NSQ_SOURCE_LINE 00000095 "    by the FAMILY argument."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=item pack_sockaddr_in6 PORT, ADDR"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    This function takes two arguments: a port number, and a 16-octet"
NSQ_SOURCE_LINE 00000100 "    IPv6 address structure (as returned by inet_pton())."
NSQ_SOURCE_LINE 00000101 "    It returns the sockaddr_in6 structure with these arguments packed"
NSQ_SOURCE_LINE 00000102 "    into their correct fields, as well as the AF_INET6 family."
NSQ_SOURCE_LINE 00000103 "    The other fields are not set and their values should not be relied upon."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=item pack_sockaddr_in6_all PORT, FLOWINFO, ADDR, SCOPEID"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    This function takes four arguments: a port number, a 16-octet"
NSQ_SOURCE_LINE 00000108 "    IPv6 address structure (as returned by inet_pton), any"
NSQ_SOURCE_LINE 00000109 "    special flow information, and any specific scope information."
NSQ_SOURCE_LINE 00000110 "    It returns a complete sockaddr_in6 structure with these arguments packed"
NSQ_SOURCE_LINE 00000111 "    into their correct fields, as well as the AF_INET6 family."
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=item unpack_sockaddr_in6 NAME"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    This function takes a sockaddr_in6 structure (as returned by"
NSQ_SOURCE_LINE 00000116 "    pack_sockaddr_in6()) and returns a list of two elements:"
NSQ_SOURCE_LINE 00000117 "    the port number and the 16-octet IP address."
NSQ_SOURCE_LINE 00000118 "    This function will croak if it determines it has not been"
NSQ_SOURCE_LINE 00000119 "    passed an IPv6 structure."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=item unpack_sockaddr_in6_all NAME"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "    This function takes a sockaddr_in6 structure (as returned by"
NSQ_SOURCE_LINE 00000124 "    pack_sockaddr_in6()) and returns a list of four elements:"
NSQ_SOURCE_LINE 00000125 "    the port number, the flow information, the 16-octet IP address,"
NSQ_SOURCE_LINE 00000126 "    and the scope information."
NSQ_SOURCE_LINE 00000127 "    This function will croak if it determines it has not been"
NSQ_SOURCE_LINE 00000128 "    passed an IPv6 structure."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=item gethostbyname2 HOSTNAME, FAMILY"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=item getaddrinfo NODENAME, SERVICENAME, [FAMILY, SOCKTYPE, PROTOCOL, FLAGS]"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "    This function converts node names to addresses and service names"
NSQ_SOURCE_LINE 00000135 "    to port numbers."
NSQ_SOURCE_LINE 00000136 "    If the NODENAME argument is not a false value,"
NSQ_SOURCE_LINE 00000137 "    then a nodename to address lookup is performed;"
NSQ_SOURCE_LINE 00000138 "    otherwise a service name to port number lookup is performed."
NSQ_SOURCE_LINE 00000139 "    At least one of NODENAME and SERVICENAME must have a true value."
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    If the lookup is successful, a list consisting of multiples of"
NSQ_SOURCE_LINE 00000142 "    five elements is returned."
NSQ_SOURCE_LINE 00000143 "    Each group of five elements consists of the address family,"
NSQ_SOURCE_LINE 00000144 "    socket type, protocol, 16-octet IP address, and the canonical"
NSQ_SOURCE_LINE 00000145 "    name (undef if the node name passed is already the canonical name)."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    The arguments FAMILY, SOCKTYPE, PROTOCOL, and FLAGS are all optional."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    This function will croak if it determines it has not been"
NSQ_SOURCE_LINE 00000150 "    passed an IPv6 structure."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    If the lookup is unsuccessful, the function returns a single scalar."
NSQ_SOURCE_LINE 00000153 "    This will contain the string version of that error in string context,"
NSQ_SOURCE_LINE 00000154 "    and the numeric value in numeric context."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=item getnameinfo NAME, [FLAGS]"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    This function takes a socket address structure. If successful, it returns"
NSQ_SOURCE_LINE 00000159 "    two strings containing the node name and service name."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    The optional FLAGS argument controls what kind of lookup is performed."
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    If the lookup is unsuccessful, the function returns a single scalar."
NSQ_SOURCE_LINE 00000164 "    This will contain the string version of that error in string context,"
NSQ_SOURCE_LINE 00000165 "    and the numeric value in numeric context."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=item getipnodebyname HOST, [FAMILY, FLAGS]"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    This function takes either a node name or an IP address string"
NSQ_SOURCE_LINE 00000170 "    and performs a lookup on that name (or conversion of the string)."
NSQ_SOURCE_LINE 00000171 "    It returns a list of five elements: the canonical host name,"
NSQ_SOURCE_LINE 00000172 "    the address family, the length in octets of the IP addresses"
NSQ_SOURCE_LINE 00000173 "    returned, a reference to a list of IP address structures, and"
NSQ_SOURCE_LINE 00000174 "    a reference to a list of aliases for the host name."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    The arguments FAMILY and FLAGS are optional."
NSQ_SOURCE_LINE 00000177 "    Note: This function does not handle IPv6 scope identifiers,"
NSQ_SOURCE_LINE 00000178 "    and should be used with care."
NSQ_SOURCE_LINE 00000179 "    And, this function was deprecated in RFC3493."
NSQ_SOURCE_LINE 00000180 "    The getnameinfo function should be used instead."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=item getipnodebyaddr FAMILY, ADDRESS"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "    This function takes an IP address family and an IP address structure"
NSQ_SOURCE_LINE 00000185 "    and performs a reverse lookup on that address."
NSQ_SOURCE_LINE 00000186 "    It returns a list of five elements: the canonical host name,"
NSQ_SOURCE_LINE 00000187 "    the address family, the length in octets of the IP addresses"
NSQ_SOURCE_LINE 00000188 "    returned, a reference to a list of IP address structures, and"
NSQ_SOURCE_LINE 00000189 "    a reference to a list of aliases for the host name."
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "    Note: This function does not handle IPv6 scope identifiers,"
NSQ_SOURCE_LINE 00000192 "    and should be used with care."
NSQ_SOURCE_LINE 00000193 "    And, this function was deprecated in RFC3493."
NSQ_SOURCE_LINE 00000194 "    The getaddrinfo function should be used instead."
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=item gai_strerror ERROR_NUMBER"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "    This function returns a string corresponding to the error number"
NSQ_SOURCE_LINE 00000199 "    passed in as an argument."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=item in6addr_any"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    This function returns the 16-octet wildcard address."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=item in6addr_loopback"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "    This function returns the 16-octet loopback address."
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=back"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=cut"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "use Carp;"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "use base qw(Exporter DynaLoader);"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "@EXPORT = qw("
NSQ_SOURCE_LINE 00000218 "\tinet_pton inet_ntop pack_sockaddr_in6 pack_sockaddr_in6_all"
NSQ_SOURCE_LINE 00000219 "\tunpack_sockaddr_in6 unpack_sockaddr_in6_all sockaddr_in6"
NSQ_SOURCE_LINE 00000220 "\tgethostbyname2 getaddrinfo getnameinfo"
NSQ_SOURCE_LINE 00000221 "\tin6addr_any in6addr_loopback"
NSQ_SOURCE_LINE 00000222 "\tgai_strerror getipnodebyname getipnodebyaddr"
NSQ_SOURCE_LINE 00000223 "\tAI_ADDRCONFIG"
NSQ_SOURCE_LINE 00000224 "\tAI_ALL"
NSQ_SOURCE_LINE 00000225 "\tAI_CANONNAME"
NSQ_SOURCE_LINE 00000226 "\tAI_NUMERICHOST"
NSQ_SOURCE_LINE 00000227 "\tAI_NUMERICSERV"
NSQ_SOURCE_LINE 00000228 "\tAI_DEFAULT"
NSQ_SOURCE_LINE 00000229 "\tAI_MASK"
NSQ_SOURCE_LINE 00000230 "\tAI_PASSIVE"
NSQ_SOURCE_LINE 00000231 "\tAI_V4MAPPED"
NSQ_SOURCE_LINE 00000232 "\tAI_V4MAPPED_CFG"
NSQ_SOURCE_LINE 00000233 "\tEAI_ADDRFAMILY"
NSQ_SOURCE_LINE 00000234 "\tEAI_AGAIN"
NSQ_SOURCE_LINE 00000235 "\tEAI_BADFLAGS"
NSQ_SOURCE_LINE 00000236 "\tEAI_FAIL"
NSQ_SOURCE_LINE 00000237 "\tEAI_FAMILY"
NSQ_SOURCE_LINE 00000238 "\tEAI_MEMORY"
NSQ_SOURCE_LINE 00000239 "\tEAI_NODATA"
NSQ_SOURCE_LINE 00000240 "\tEAI_NONAME"
NSQ_SOURCE_LINE 00000241 "\tEAI_SERVICE"
NSQ_SOURCE_LINE 00000242 "\tEAI_SOCKTYPE"
NSQ_SOURCE_LINE 00000243 "\tEAI_SYSTEM"
NSQ_SOURCE_LINE 00000244 "\tEAI_BADHINTS"
NSQ_SOURCE_LINE 00000245 "\tEAI_PROTOCOL"
NSQ_SOURCE_LINE 00000246 "\tIP_AUTH_TRANS_LEVEL"
NSQ_SOURCE_LINE 00000247 "\tIP_AUTH_NETWORK_LEVEL"
NSQ_SOURCE_LINE 00000248 "\tIP_ESP_TRANS_LEVEL"
NSQ_SOURCE_LINE 00000249 "\tIP_ESP_NETWORK_LEVEL"
NSQ_SOURCE_LINE 00000250 "\tIPPROTO_IP"
NSQ_SOURCE_LINE 00000251 "\tIPPROTO_IPV6"
NSQ_SOURCE_LINE 00000252 "\tIPSEC_LEVEL_AVAIL"
NSQ_SOURCE_LINE 00000253 "\tIPSEC_LEVEL_BYPASS"
NSQ_SOURCE_LINE 00000254 "\tIPSEC_LEVEL_DEFAULT"
NSQ_SOURCE_LINE 00000255 "\tIPSEC_LEVEL_NONE"
NSQ_SOURCE_LINE 00000256 "\tIPSEC_LEVEL_REQUIRE"
NSQ_SOURCE_LINE 00000257 "\tIPSEC_LEVEL_UNIQUE"
NSQ_SOURCE_LINE 00000258 "\tIPSEC_LEVEL_USE"
NSQ_SOURCE_LINE 00000259 "\tIPV6_AUTH_TRANS_LEVEL"
NSQ_SOURCE_LINE 00000260 "\tIPV6_AUTH_NETWORK_LEVEL"
NSQ_SOURCE_LINE 00000261 "\tIPV6_ESP_NETWORK_LEVEL"
NSQ_SOURCE_LINE 00000262 "\tIPV6_ESP_TRANS_LEVEL"
NSQ_SOURCE_LINE 00000263 "\tNI_NOFQDN"
NSQ_SOURCE_LINE 00000264 "\tNI_NUMERICHOST"
NSQ_SOURCE_LINE 00000265 "\tNI_NAMEREQD"
NSQ_SOURCE_LINE 00000266 "\tNI_NUMERICSERV"
NSQ_SOURCE_LINE 00000267 "\tNI_DGRAM"
NSQ_SOURCE_LINE 00000268 "\tNI_WITHSCOPEID"
NSQ_SOURCE_LINE 00000269 ");"
NSQ_SOURCE_LINE 00000270 "push @EXPORT, qw(AF_INET6) unless defined eval {Socket::AF_INET6()};"
NSQ_SOURCE_LINE 00000271 "push @EXPORT, qw(PF_INET6) unless defined eval {Socket::PF_INET6()};"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "@EXPORT_OK = qw(AF_INET6 PF_INET6);"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "%EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000276 "    all     => [@EXPORT],"
NSQ_SOURCE_LINE 00000277 ");"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "sub sockaddr_in6 {"
NSQ_SOURCE_LINE 00000280 "    if (wantarray) {"
NSQ_SOURCE_LINE 00000281 "\tcroak \"usage:   (port,iaddr) = sockaddr_in6(sin_sv)\" unless @_ == 1;"
NSQ_SOURCE_LINE 00000282 "        unpack_sockaddr_in6(@_);"
NSQ_SOURCE_LINE 00000283 "    } else {"
NSQ_SOURCE_LINE 00000284 "\tcroak \"usage:   sin_sv = sockaddr_in6(port,iaddr))\" unless @_ == 2;"
NSQ_SOURCE_LINE 00000285 "        pack_sockaddr_in6(@_);"
NSQ_SOURCE_LINE 00000286 "    }"
NSQ_SOURCE_LINE 00000287 "}"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000290 "    my($constname);"
NSQ_SOURCE_LINE 00000291 "    ($constname = $AUTOLOAD) =~ s/.*:://o;"
NSQ_SOURCE_LINE 00000292 "    $! = 0;"
NSQ_SOURCE_LINE 00000293 "    my $val = constant($constname, @_ ? $_[0] : 0);"
NSQ_SOURCE_LINE 00000294 "    if ($! != 0) {"
NSQ_SOURCE_LINE 00000295 "\tcroak \"Your vendor has not defined Socket macro $constname, used\";"
NSQ_SOURCE_LINE 00000296 "    }"
NSQ_SOURCE_LINE 00000297 "    eval \"sub $AUTOLOAD { $val }\";"
NSQ_SOURCE_LINE 00000298 "    goto &$AUTOLOAD;"
NSQ_SOURCE_LINE 00000299 "}"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "bootstrap Socket6 $VERSION;"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "1;"
