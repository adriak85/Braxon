NSQ_SOURCE_LINE 00000001 "package List::SomeUtils::XS;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.58';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "require XSLoader;"
NSQ_SOURCE_LINE 00000010 "XSLoader::load( __PACKAGE__, $VERSION );"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "require List::SomeUtils::PP;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# This list is copied from List::SomeUtils itself and should be updated"
NSQ_SOURCE_LINE 00000015 "# when subs are added."
NSQ_SOURCE_LINE 00000016 "my @subs = qw("
NSQ_SOURCE_LINE 00000017 "    after"
NSQ_SOURCE_LINE 00000018 "    after_incl"
NSQ_SOURCE_LINE 00000019 "    all"
NSQ_SOURCE_LINE 00000020 "    all_u"
NSQ_SOURCE_LINE 00000021 "    any"
NSQ_SOURCE_LINE 00000022 "    any_u"
NSQ_SOURCE_LINE 00000023 "    apply"
NSQ_SOURCE_LINE 00000024 "    before"
NSQ_SOURCE_LINE 00000025 "    before_incl"
NSQ_SOURCE_LINE 00000026 "    bsearch"
NSQ_SOURCE_LINE 00000027 "    bsearchidx"
NSQ_SOURCE_LINE 00000028 "    each_array"
NSQ_SOURCE_LINE 00000029 "    each_arrayref"
NSQ_SOURCE_LINE 00000030 "    false"
NSQ_SOURCE_LINE 00000031 "    firstidx"
NSQ_SOURCE_LINE 00000032 "    firstres"
NSQ_SOURCE_LINE 00000033 "    firstval"
NSQ_SOURCE_LINE 00000034 "    indexes"
NSQ_SOURCE_LINE 00000035 "    insert_after"
NSQ_SOURCE_LINE 00000036 "    insert_after_string"
NSQ_SOURCE_LINE 00000037 "    lastidx"
NSQ_SOURCE_LINE 00000038 "    lastres"
NSQ_SOURCE_LINE 00000039 "    lastval"
NSQ_SOURCE_LINE 00000040 "    mesh"
NSQ_SOURCE_LINE 00000041 "    minmax"
NSQ_SOURCE_LINE 00000042 "    mode"
NSQ_SOURCE_LINE 00000043 "    natatime"
NSQ_SOURCE_LINE 00000044 "    none"
NSQ_SOURCE_LINE 00000045 "    none_u"
NSQ_SOURCE_LINE 00000046 "    notall"
NSQ_SOURCE_LINE 00000047 "    notall_u"
NSQ_SOURCE_LINE 00000048 "    nsort_by"
NSQ_SOURCE_LINE 00000049 "    one"
NSQ_SOURCE_LINE 00000050 "    one_u"
NSQ_SOURCE_LINE 00000051 "    onlyidx"
NSQ_SOURCE_LINE 00000052 "    onlyres"
NSQ_SOURCE_LINE 00000053 "    onlyval"
NSQ_SOURCE_LINE 00000054 "    pairwise"
NSQ_SOURCE_LINE 00000055 "    part"
NSQ_SOURCE_LINE 00000056 "    singleton"
NSQ_SOURCE_LINE 00000057 "    sort_by"
NSQ_SOURCE_LINE 00000058 "    true"
NSQ_SOURCE_LINE 00000059 "    uniq"
NSQ_SOURCE_LINE 00000060 ");"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "for my $sub (@subs) {"
NSQ_SOURCE_LINE 00000063 "    next if __PACKAGE__->can($sub);"
NSQ_SOURCE_LINE 00000064 "    ## no critic (TestingAndDebugging::ProhibitNoStrict)"
NSQ_SOURCE_LINE 00000065 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000066 "    *{$sub} = List::SomeUtils::PP->can($sub);"
NSQ_SOURCE_LINE 00000067 "}"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "1;"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "# ABSTRACT: XS implementation for List::SomeUtils"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "__END__"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=pod"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=head1 NAME"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "List::SomeUtils::XS - XS implementation for List::SomeUtils"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=head1 VERSION"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "version 0.58"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "There are no user-facing parts here. See L<List::SomeUtils> for API details."
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "You shouldn't have to install this module directly. When you install"
NSQ_SOURCE_LINE 00000092 "L<List::SomeUtils>, it checks whether your system has a compiler. If it does,"
NSQ_SOURCE_LINE 00000093 "then it adds a dependency on this module so that it gets installed and you"
NSQ_SOURCE_LINE 00000094 "have the faster XS implementation."
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "This distribution requires L<List::SomeUtils> but to avoid a circular"
NSQ_SOURCE_LINE 00000097 "dependency, that dependency is explicitly left out from the this"
NSQ_SOURCE_LINE 00000098 "distribution's metadata. However, without LSU already installed this module"
NSQ_SOURCE_LINE 00000099 "cannot function."
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "L<List::Util>, L<List::AllUtils>"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=head1 HISTORICAL COPYRIGHT"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "Some parts copyright 2011 Aaron Crane."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "Copyright 2004 - 2010 by Tassilo von Parseval"
NSQ_SOURCE_LINE 00000110 ""
