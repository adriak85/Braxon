BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Variable::Magic;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.008;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "=head1 NAME"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "Variable::Magic - Associate user-defined magic to variables from Perl."
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "=head1 VERSION"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "Version 0.64"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "=cut"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "our $VERSION;"
NSQ_SOURCE_LINE 00000019 "BEGIN {"
NSQ_SOURCE_LINE 00000020 " $VERSION = '0.64';"
NSQ_SOURCE_LINE 00000021 "}"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    use Variable::Magic qw<wizard cast VMG_OP_INFO_NAME>;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    { # A variable tracer"
NSQ_SOURCE_LINE 00000028 "     my $wiz = wizard("
NSQ_SOURCE_LINE 00000029 "      set  => sub { print \"now set to ${$_[0]}!\\n\" },"
NSQ_SOURCE_LINE 00000030 "      free => sub { print \"destroyed!\\n\" },"
NSQ_SOURCE_LINE 00000031 "     );"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "     my $a = 1;"
NSQ_SOURCE_LINE 00000034 "     cast $a, $wiz;"
NSQ_SOURCE_LINE 00000035 "     $a = 2;        # \"now set to 2!\""
NSQ_SOURCE_LINE 00000036 "    }               # \"destroyed!\""
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    { # A hash with a default value"
NSQ_SOURCE_LINE 00000039 "     my $wiz = wizard("
NSQ_SOURCE_LINE 00000040 "      data     => sub { $_[1] },"
NSQ_SOURCE_LINE 00000041 "      fetch    => sub { $_[2] = $_[1] unless exists $_[0]->{$_[2]}; () },"
NSQ_SOURCE_LINE 00000042 "      store    => sub { print \"key $_[2] stored in $_[-1]\\n\" },"
NSQ_SOURCE_LINE 00000043 "      copy_key => 1,"
NSQ_SOURCE_LINE 00000044 "      op_info  => VMG_OP_INFO_NAME,"
NSQ_SOURCE_LINE 00000045 "     );"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "     my %h = (_default => 0, apple => 2);"
NSQ_SOURCE_LINE 00000048 "     cast %h, $wiz, '_default';"
NSQ_SOURCE_LINE 00000049 "     print $h{banana}, \"\\n\"; # \"0\" (there is no 'banana' key in %h)"
NSQ_SOURCE_LINE 00000050 "     $h{pear} = 1;           # \"key pear stored in helem\""
NSQ_SOURCE_LINE 00000051 "    }"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "Magic is Perl's way of enhancing variables."
NSQ_SOURCE_LINE 00000056 "This mechanism lets the user add extra data to any variable and hook syntactical operations (such as access, assignment or destruction) that can be applied to it."
NSQ_SOURCE_LINE 00000057 "With this module, you can add your own magic to any variable without having to write a single line of XS."
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "You'll realize that these magic variables look a lot like tied variables."
NSQ_SOURCE_LINE 00000060 "It is not surprising, as tied variables are implemented as a special kind of magic, just like any 'irregular' Perl variable : scalars like C<$!>, C<$(> or C<$^W>, the C<%ENV> and C<%SIG> hashes, the C<@ISA> array,  C<vec()> and C<substr()> lvalues, L<threads::shared> variables..."
NSQ_SOURCE_LINE 00000061 "They all share the same underlying C API, and this module gives you direct access to it."
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "Still, the magic made available by this module differs from tieing and overloading in several ways :"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "=over 4"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=item *"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "Magic is not copied on assignment."
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "You attach it to variables, not values (as for blessed references)."
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=item *"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "Magic does not replace the original semantics."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "Magic callbacks usually get triggered before the original action takes place, and cannot prevent it from happening."
NSQ_SOURCE_LINE 00000078 "This also makes catching individual events easier than with C<tie>, where you have to provide fallbacks methods for all actions by usually inheriting from the correct C<Tie::Std*> class and overriding individual methods in your own class."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=item *"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Magic is multivalued."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "You can safely apply different kinds of magics to the same variable, and each of them will be invoked successively."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=item *"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "Magic is type-agnostic."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "The same magic can be applied on scalars, arrays, hashes, subs or globs."
NSQ_SOURCE_LINE 00000091 "But the same hook (see below for a list) may trigger differently depending on the type of the variable."
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=item *"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "Magic is invisible at Perl level."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "Magical and non-magical variables cannot be distinguished with C<ref>, C<tied> or another trick."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=item *"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "Magic is notably faster."
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "Mainly because perl's way of handling magic is lighter by nature, and because there is no need for any method resolution."
NSQ_SOURCE_LINE 00000104 "Also, since you don't have to reimplement all the variable semantics, you only pay for what you actually use."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=back"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "The operations that can be overloaded are :"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=over 4"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=item *"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "I<get>"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "This magic is invoked when the variable is evaluated."
NSQ_SOURCE_LINE 00000117 "It is never called for arrays and hashes."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=item *"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "I<set>"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "This magic is called each time the value of the variable changes."
NSQ_SOURCE_LINE 00000124 "It is called for array subscripts and slices, but never for hashes."
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=item *"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "I<len>"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "This magic only applies to arrays (though it used to also apply to scalars), and is triggered when the 'size' or the 'length' of the variable has to be known by Perl."
NSQ_SOURCE_LINE 00000131 "This is typically the magic involved when an array is evaluated in scalar context, but also on array assignment and loops (C<for>, C<map> or C<grep>)."
NSQ_SOURCE_LINE 00000132 "The length is returned from the callback as an integer."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Starting from perl 5.12, this magic is no longer called by the C<length> keyword, and starting from perl 5.17.4 it is also no longer called for scalars in any situation, making this magic only meaningful on arrays."
NSQ_SOURCE_LINE 00000135 "You can use the constants L</VMG_COMPAT_SCALAR_LENGTH_NOLEN> and L</VMG_COMPAT_SCALAR_NOLEN> to see if this magic is available for scalars or not."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=item *"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "I<clear>"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "This magic is invoked when the variable is reset, such as when an array is emptied."
NSQ_SOURCE_LINE 00000142 "Please note that this is different from undefining the variable, even though the magic is called when the clearing is a result of the undefine (e.g. for an array, but actually a bug prevent it to work before perl 5.9.5 - see the L<history|/PERL MAGIC HISTORY>)."
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=item *"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "I<free>"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "This magic is called when a variable is destroyed as the result of going out of scope (but not when it is undefined)."
NSQ_SOURCE_LINE 00000149 "It behaves roughly like Perl object destructors (i.e. C<DESTROY> methods), except that exceptions thrown from inside a I<free> callback will always be propagated to the surrounding code."
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=item *"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "I<copy>"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "When applied to tied arrays and hashes, this magic fires when you try to access or change their elements."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Starting from perl 5.17.0, it can also be applied to closure prototypes, in which case the magic will be called when the prototype is cloned."
NSQ_SOURCE_LINE 00000158 "The L</VMG_COMPAT_CODE_COPY_CLONE> constant is true when your perl support this feature."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=item *"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "I<dup>"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "This magic is invoked when the variable is cloned across threads."
NSQ_SOURCE_LINE 00000165 "It is currently not available."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=item *"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "I<local>"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "When this magic is set on a variable, all subsequent localizations of the variable will trigger the callback."
NSQ_SOURCE_LINE 00000172 "It is available on your perl if and only if C<MGf_LOCAL> is true."
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "=back"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "The following actions only apply to hashes and are available if and only if L</VMG_UVAR> is true."
NSQ_SOURCE_LINE 00000177 "They are referred to as I<uvar> magics."
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=over 4"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=item *"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "I<fetch>"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "This magic is invoked each time an element is fetched from the hash."
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "=item *"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "I<store>"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "This one is called when an element is stored into the hash."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=item *"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "I<exists>"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "This magic fires when a key is tested for existence in the hash."
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "=item *"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "I<delete>"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "This magic is triggered when a key is deleted in the hash, regardless of whether the key actually exists in it."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=back"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "You can refer to the tests to have more insight of where the different magics are invoked."
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=cut"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "BEGIN {"
NSQ_SOURCE_LINE 00000214 " require XSLoader;"
NSQ_SOURCE_LINE 00000215 " XSLoader::load(__PACKAGE__, $VERSION);"
NSQ_SOURCE_LINE 00000216 "}"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "=head2 C<wizard>"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "    wizard("
NSQ_SOURCE_LINE 00000221 "     data     => sub { ... },"
NSQ_SOURCE_LINE 00000222 "     get      => sub { my ($ref, $data [, $op]) = @_; ... },"
NSQ_SOURCE_LINE 00000223 "     set      => sub { my ($ref, $data [, $op]) = @_; ... },"
NSQ_SOURCE_LINE 00000224 "     len      => sub {"
NSQ_SOURCE_LINE 00000225 "      my ($ref, $data, $len [, $op]) = @_; ... ; return $newlen"
NSQ_SOURCE_LINE 00000226 "     },"
NSQ_SOURCE_LINE 00000227 "     clear    => sub { my ($ref, $data [, $op]) = @_; ... },"
NSQ_SOURCE_LINE 00000228 "     free     => sub { my ($ref, $data [, $op]) = @_, ... },"
NSQ_SOURCE_LINE 00000229 "     copy     => sub { my ($ref, $data, $key, $elt [, $op]) = @_; ... },"
NSQ_SOURCE_LINE 00000230 "     local    => sub { my ($ref, $data [, $op]) = @_; ... },"
NSQ_SOURCE_LINE 00000231 "     fetch    => sub { my ($ref, $data, $key [, $op]) = @_; ... },"
NSQ_SOURCE_LINE 00000232 "     store    => sub { my ($ref, $data, $key [, $op]) = @_; ... },"
NSQ_SOURCE_LINE 00000233 "     exists   => sub { my ($ref, $data, $key [, $op]) = @_; ... },"
NSQ_SOURCE_LINE 00000234 "     delete   => sub { my ($ref, $data, $key [, $op]) = @_; ... },"
NSQ_SOURCE_LINE 00000235 "     copy_key => $bool,"
NSQ_SOURCE_LINE 00000236 "     op_info  => [ 0 | VMG_OP_INFO_NAME | VMG_OP_INFO_OBJECT ],"
NSQ_SOURCE_LINE 00000237 "    )"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "This function creates a 'wizard', an opaque object that holds the magic information."
NSQ_SOURCE_LINE 00000240 "It takes a list of keys / values as argument, whose keys can be :"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=over 4"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=item *"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "C<data>"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "A code (or string) reference to a private data constructor."
NSQ_SOURCE_LINE 00000249 "It is called in scalar context each time the magic is cast onto a variable, with C<$_[0]> being a reference to this variable and C<@_[1 .. @_-1]> being all extra arguments that were passed to L</cast>."
NSQ_SOURCE_LINE 00000250 "The scalar returned from this call is then attached to the variable and can be retrieved later with L</getdata>."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=item *"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "C<get>, C<set>, C<len>, C<clear>, C<free>, C<copy>, C<local>, C<fetch>, C<store>, C<exists> and C<delete>"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "Code (or string) references to the respective magic callbacks."
NSQ_SOURCE_LINE 00000257 "You don't have to specify all of them : the magic corresponding to undefined entries will simply not be hooked."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "When those callbacks are executed, C<$_[0]> is a reference to the magic variable and C<$_[1]> is the associated private data (or C<undef> when no private data constructor is supplied with the wizard)."
NSQ_SOURCE_LINE 00000260 "Other arguments depend on which kind of magic is involved :"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=over 8"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=item *"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "I<len>"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "C<$_[2]> contains the natural, non-magical length of the variable (which can only be a scalar or an array as I<len> magic is only relevant for these types)."
NSQ_SOURCE_LINE 00000269 "The callback is expected to return the new scalar or array length to use, or C<undef> to default to the normal length."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "=item *"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "I<copy>"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "When the variable for which the magic is invoked is an array or an hash, C<$_[2]> is a either an alias or a copy of the current key, and C<$_[3]> is an alias to the current element (i.e. the value)."
NSQ_SOURCE_LINE 00000276 "Since C<$_[2]> might be a copy, it is useless to try to change it or cast magic on it."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "Starting from perl 5.17.0, this magic can also be called for code references."
NSQ_SOURCE_LINE 00000279 "In this case, C<$_[2]> is always C<undef> and C<$_[3]> is a reference to the cloned anonymous subroutine."
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=item *"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "I<fetch>, I<store>, I<exists> and I<delete>"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "C<$_[2]> is an alias to the current key."
NSQ_SOURCE_LINE 00000286 "Note that C<$_[2]> may rightfully be readonly if the key comes from a bareword, and as such it is unsafe to assign to it."
NSQ_SOURCE_LINE 00000287 "You can ask for a copy instead by passing C<< copy_key => 1 >> to L</wizard> which, at the price of a small performance hit, allows you to safely assign to C<$_[2]> in order to e.g. redirect the action to another key."
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=back"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "Finally, if C<< op_info => $num >> is also passed to C<wizard>, then one extra element is appended to C<@_>."
NSQ_SOURCE_LINE 00000292 "Its nature depends on the value of C<$num> :"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=over 8"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=item *"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "C<VMG_OP_INFO_NAME>"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "C<$_[-1]> is the current op name."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=item *"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "C<VMG_OP_INFO_OBJECT>"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "C<$_[-1]> is the C<B::OP> object for the current op."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=back"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "Both result in a small performance hit, but just getting the name is lighter than getting the op object."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "These callbacks are always executed in scalar context."
NSQ_SOURCE_LINE 00000313 "The returned value is coerced into a signed integer, which is then passed straight to the perl magic API."
NSQ_SOURCE_LINE 00000314 "However, note that perl currently only cares about the return value of the I<len> magic callback and ignores all the others."
NSQ_SOURCE_LINE 00000315 "Starting with Variable::Magic 0.58, a reference returned from a non-I<len> magic callback will not be destroyed immediately but will be allowed to survive until the end of the statement that triggered the magic."
NSQ_SOURCE_LINE 00000316 "This lets you use this return value as a token for triggering a destructor after the original magic action takes place."
NSQ_SOURCE_LINE 00000317 "You can see an example of this technique in the L<cookbook|/COOKBOOK>."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=back"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "Each callback can be specified as :"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=over 4"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "=item *"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "a code reference, which will be called as a subroutine."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=item *"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "a string reference, where the string denotes which subroutine is to be called when magic is triggered."
NSQ_SOURCE_LINE 00000332 "If the subroutine name is not fully qualified, then the current package at the time the magic is invoked will be used instead."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "=item *"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "a reference to C<undef>, in which case a no-op magic callback is installed instead of the default one."
NSQ_SOURCE_LINE 00000337 "This may especially be helpful for I<local> magic, where an empty callback prevents magic from being copied during localization."
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "=back"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "Note that I<free> magic is never called during global destruction, as there is no way to ensure that the wizard object and the callback were not destroyed before the variable."
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "Here is a simple usage example :"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "    # A simple scalar tracer"
NSQ_SOURCE_LINE 00000346 "    my $wiz = wizard("
NSQ_SOURCE_LINE 00000347 "     get  => sub { print STDERR \"got ${$_[0]}\\n\" },"
NSQ_SOURCE_LINE 00000348 "     set  => sub { print STDERR \"set to ${$_[0]}\\n\" },"
NSQ_SOURCE_LINE 00000349 "     free => sub { print STDERR \"${$_[0]} was deleted\\n\" },"
NSQ_SOURCE_LINE 00000350 "    );"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=cut"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "sub wizard {"
NSQ_SOURCE_LINE 00000355 " if (@_ % 2) {"
NSQ_SOURCE_LINE 00000356 "  require Carp;"
NSQ_SOURCE_LINE 00000357 "  Carp::croak('Wrong number of arguments for wizard()');"
NSQ_SOURCE_LINE 00000358 " }"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 " my %opts = @_;"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 " my @keys = qw<op_info data get set len clear free copy dup>;"
NSQ_SOURCE_LINE 00000363 " push @keys, 'local' if MGf_LOCAL;"
NSQ_SOURCE_LINE 00000364 " push @keys, qw<fetch store exists delete copy_key> if VMG_UVAR;"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 " my ($wiz, $err);"
NSQ_SOURCE_LINE 00000367 " {"
NSQ_SOURCE_LINE 00000368 "  local $@;"
NSQ_SOURCE_LINE 00000369 "  $wiz = eval { _wizard(map $opts{$_}, @keys) };"
NSQ_SOURCE_LINE 00000370 "  $err = $@;"
NSQ_SOURCE_LINE 00000371 " }"
NSQ_SOURCE_LINE 00000372 " if ($err) {"
NSQ_SOURCE_LINE 00000373 "  $err =~ s/\\sat\\s+.*?\\n//;"
NSQ_SOURCE_LINE 00000374 "  require Carp;"
NSQ_SOURCE_LINE 00000375 "  Carp::croak($err);"
NSQ_SOURCE_LINE 00000376 " }"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 " return $wiz;"
NSQ_SOURCE_LINE 00000379 "}"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=head2 C<cast>"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "    cast [$@%&*]var, $wiz, @args"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "This function associates C<$wiz> magic to the supplied variable, without overwriting any other kind of magic."
NSQ_SOURCE_LINE 00000386 "It returns true on success or when C<$wiz> magic is already attached, and croaks on error."
NSQ_SOURCE_LINE 00000387 "When C<$wiz> provides a data constructor, it is called just before magic is cast onto the variable, and it receives a reference to the target variable in C<$_[0]> and the content of C<@args> in C<@_[1 .. @args]>."
NSQ_SOURCE_LINE 00000388 "Otherwise, C<@args> is ignored."
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "    # Casts $wiz onto $x, passing (\\$x, '1') to the data constructor."
NSQ_SOURCE_LINE 00000391 "    my $x;"
NSQ_SOURCE_LINE 00000392 "    cast $x, $wiz, 1;"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "The C<var> argument can be an array or hash value."
NSQ_SOURCE_LINE 00000395 "Magic for these scalars behaves like for any other, except that it is dispelled when the entry is deleted from the container."
NSQ_SOURCE_LINE 00000396 "For example, if you want to call C<POSIX::tzset> each time the C<'TZ'> environment variable is changed in C<%ENV>, you can use :"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "    use POSIX;"
NSQ_SOURCE_LINE 00000399 "    cast $ENV{TZ}, wizard set => sub { POSIX::tzset(); () };"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "If you want to handle the possible deletion of the C<'TZ'> entry, you must also specify I<store> magic."
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=head2 C<getdata>"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "    getdata [$@%&*]var, $wiz"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "This accessor fetches the private data associated with the magic C<$wiz> in the variable."
NSQ_SOURCE_LINE 00000408 "It croaks when C<$wiz> does not represent a valid magic object, and returns an empty list if no such magic is attached to the variable or when the wizard has no data constructor."
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "    # Get the data attached to $wiz in $x, or undef if $wiz"
NSQ_SOURCE_LINE 00000411 "    # did not attach any."
NSQ_SOURCE_LINE 00000412 "    my $data = getdata $x, $wiz;"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "=head2 C<dispell>"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "    dispell [$@%&*]variable, $wiz"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "The exact opposite of L</cast> : it dissociates C<$wiz> magic from the variable."
NSQ_SOURCE_LINE 00000419 "This function returns true on success, C<0> when no magic represented by C<$wiz> could be found in the variable, and croaks if the supplied wizard is invalid."
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "    # Dispell now."
NSQ_SOURCE_LINE 00000422 "    die 'no such magic in $x' unless dispell $x, $wiz;"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "=head1 CONSTANTS"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=head2 C<MGf_COPY>"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "Evaluates to true if and only if the I<copy> magic is available."
NSQ_SOURCE_LINE 00000429 "This is the case for perl 5.7.3 and greater, which is ensured by the requirements of this module."
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "=head2 C<MGf_DUP>"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "Evaluates to true if and only if the I<dup> magic is available."
NSQ_SOURCE_LINE 00000434 "This is the case for perl 5.7.3 and greater, which is ensured by the requirements of this module."
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "=head2 C<MGf_LOCAL>"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "Evaluates to true if and only if the I<local> magic is available."
NSQ_SOURCE_LINE 00000439 "This is the case for perl 5.9.3 and greater."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=head2 C<VMG_UVAR>"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "When this constant is true, you can use the I<fetch>, I<store>, I<exists> and I<delete> magics on hashes."
NSQ_SOURCE_LINE 00000444 "Initial L</VMG_UVAR> capability was introduced in perl 5.9.5, with a fully functional implementation shipped with perl 5.10.0."
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "=head2 C<VMG_COMPAT_SCALAR_LENGTH_NOLEN>"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "True for perls that don't call I<len> magic when taking the C<length> of a magical scalar."
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "=head2 C<VMG_COMPAT_SCALAR_NOLEN>"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "True for perls that don't call I<len> magic on scalars."
NSQ_SOURCE_LINE 00000453 "Implies L</VMG_COMPAT_SCALAR_LENGTH_NOLEN>."
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=head2 C<VMG_COMPAT_ARRAY_PUSH_NOLEN>"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "True for perls that don't call I<len> magic when you push an element in a magical array."
NSQ_SOURCE_LINE 00000458 "Starting from perl 5.11.0, this only refers to pushes in non-void context and hence is false."
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "=head2 C<VMG_COMPAT_ARRAY_PUSH_NOLEN_VOID>"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "True for perls that don't call I<len> magic when you push in void context an element in a magical array."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "=head2 C<VMG_COMPAT_ARRAY_UNSHIFT_NOLEN_VOID>"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "True for perls that don't call I<len> magic when you unshift in void context an element in a magical array."
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "=head2 C<VMG_COMPAT_ARRAY_UNDEF_CLEAR>"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "True for perls that call I<clear> magic when undefining magical arrays."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=head2 C<VMG_COMPAT_HASH_DELETE_NOUVAR_VOID>"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "True for perls that don't call I<delete> magic when you delete an element from a hash in void context."
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "=head2 C<VMG_COMPAT_CODE_COPY_CLONE>"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "True for perls that call I<copy> magic when a magical closure prototype is cloned."
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "=head2 C<VMG_COMPAT_GLOB_GET>"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "True for perls that call I<get> magic for operations on globs."
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "=head2 C<VMG_PERL_PATCHLEVEL>"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "The perl patchlevel this module was built with, or C<0> for non-debugging perls."
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "=head2 C<VMG_THREADSAFE>"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "True if and only if this module could have been built with thread-safety features enabled."
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "=head2 C<VMG_FORKSAFE>"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "True if and only if this module could have been built with fork-safety features enabled."
NSQ_SOURCE_LINE 00000495 "This is always true except on Windows where it is false for perl 5.10.0 and below."
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "=head2 C<VMG_OP_INFO_NAME>"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "Value to pass with C<op_info> to get the current op name in the magic callbacks."
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=head2 C<VMG_OP_INFO_OBJECT>"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "Value to pass with C<op_info> to get a C<B::OP> object representing the current op in the magic callbacks."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=head1 COOKBOOK"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "=head2 Associate an object to any perl variable"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "This technique can be useful for passing user data through limited APIs."
NSQ_SOURCE_LINE 00000510 "It is similar to using inside-out objects, but without the drawback of having to implement a complex destructor."
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "    {"
NSQ_SOURCE_LINE 00000513 "     package Magical::UserData;"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "     use Variable::Magic qw<wizard cast getdata>;"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "     my $wiz = wizard data => sub { \\$_[1] };"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "     sub ud (\\[$@%*&]) : lvalue {"
NSQ_SOURCE_LINE 00000520 "      my ($var) = @_;"
NSQ_SOURCE_LINE 00000521 "      my $data = &getdata($var, $wiz);"
NSQ_SOURCE_LINE 00000522 "      unless (defined $data) {"
NSQ_SOURCE_LINE 00000523 "       $data = \\(my $slot);"
NSQ_SOURCE_LINE 00000524 "       &cast($var, $wiz, $slot)"
NSQ_SOURCE_LINE 00000525 "                 or die \"Couldn't cast UserData magic onto the variable\";"
NSQ_SOURCE_LINE 00000526 "      }"
NSQ_SOURCE_LINE 00000527 "      $$data;"
NSQ_SOURCE_LINE 00000528 "     }"
NSQ_SOURCE_LINE 00000529 "    }"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "    {"
NSQ_SOURCE_LINE 00000532 "     BEGIN { *ud = \\&Magical::UserData::ud }"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "     my $cb;"
NSQ_SOURCE_LINE 00000535 "     $cb = sub { print 'Hello, ', ud(&$cb), \"!\\n\" };"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "     ud(&$cb) = 'world';"
NSQ_SOURCE_LINE 00000538 "     $cb->(); # Hello, world!"
NSQ_SOURCE_LINE 00000539 "    }"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "=head2 Recursively cast magic on datastructures"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "C<cast> can be called from any magical callback, and in particular from C<data>."
NSQ_SOURCE_LINE 00000544 "This allows you to recursively cast magic on datastructures :"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "    my $wiz;"
NSQ_SOURCE_LINE 00000547 "    $wiz = wizard data => sub {"
NSQ_SOURCE_LINE 00000548 "     my ($var, $depth) = @_;"
NSQ_SOURCE_LINE 00000549 "     $depth ||= 0;"
NSQ_SOURCE_LINE 00000550 "     my $r = ref $var;"
NSQ_SOURCE_LINE 00000551 "     if ($r eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000552 "      &cast((ref() ? $_ : \\$_), $wiz, $depth + 1) for @$var;"
NSQ_SOURCE_LINE 00000553 "     } elsif ($r eq 'HASH') {"
NSQ_SOURCE_LINE 00000554 "      &cast((ref() ? $_ : \\$_), $wiz, $depth + 1) for values %$var;"
NSQ_SOURCE_LINE 00000555 "     }"
NSQ_SOURCE_LINE 00000556 "     return $depth;"
NSQ_SOURCE_LINE 00000557 "    },"
NSQ_SOURCE_LINE 00000558 "    free => sub {"
NSQ_SOURCE_LINE 00000559 "     my ($var, $depth) = @_;"
NSQ_SOURCE_LINE 00000560 "     my $r = ref $var;"
NSQ_SOURCE_LINE 00000561 "     print \"free $r at depth $depth\\n\";"
NSQ_SOURCE_LINE 00000562 "     ();"
NSQ_SOURCE_LINE 00000563 "    };"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "    {"
NSQ_SOURCE_LINE 00000566 "     my %h = ("
NSQ_SOURCE_LINE 00000567 "      a => [ 1, 2 ],"
NSQ_SOURCE_LINE 00000568 "      b => { c => 3 }"
NSQ_SOURCE_LINE 00000569 "     );"
NSQ_SOURCE_LINE 00000570 "     cast %h, $wiz;"
NSQ_SOURCE_LINE 00000571 "    }"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "When C<%h> goes out of scope, this prints something among the lines of :"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "    free HASH at depth 0"
NSQ_SOURCE_LINE 00000576 "    free HASH at depth 1"
NSQ_SOURCE_LINE 00000577 "    free SCALAR at depth 2"
NSQ_SOURCE_LINE 00000578 "    free ARRAY at depth 1"
NSQ_SOURCE_LINE 00000579 "    free SCALAR at depth 3"
NSQ_SOURCE_LINE 00000580 "    free SCALAR at depth 3"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "Of course, this example does nothing with the values that are added after the C<cast>."
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "=head2 Delayed magic actions"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "Starting with Variable::Magic 0.58, the return value of the magic callbacks can be used to delay the action until after the original action takes place :"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "    my $delayed;"
NSQ_SOURCE_LINE 00000589 "    my $delayed_aux = wizard("
NSQ_SOURCE_LINE 00000590 "     data => sub { $_[1] },"
NSQ_SOURCE_LINE 00000591 "     free => sub {"
NSQ_SOURCE_LINE 00000592 "      my ($target) = $_[1];"
NSQ_SOURCE_LINE 00000593 "      my $target_data = &getdata($target, $delayed);"
NSQ_SOURCE_LINE 00000594 "      local $target_data->{guard} = 1;"
NSQ_SOURCE_LINE 00000595 "      if (ref $target eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000596 "       my $orig = $$target;"
NSQ_SOURCE_LINE 00000597 "       $$target = $target_data->{mangler}->($orig);"
NSQ_SOURCE_LINE 00000598 "      }"
NSQ_SOURCE_LINE 00000599 "      return;"
NSQ_SOURCE_LINE 00000600 "     },"
NSQ_SOURCE_LINE 00000601 "    );"
NSQ_SOURCE_LINE 00000602 "    $delayed = wizard("
NSQ_SOURCE_LINE 00000603 "     data => sub {"
NSQ_SOURCE_LINE 00000604 "      return +{ guard => 0, mangler => $_[1] };"
NSQ_SOURCE_LINE 00000605 "     },"
NSQ_SOURCE_LINE 00000606 "     set  => sub {"
NSQ_SOURCE_LINE 00000607 "      return if $_[1]->{guard};"
NSQ_SOURCE_LINE 00000608 "      my $token;"
NSQ_SOURCE_LINE 00000609 "      cast $token, $delayed_aux, $_[0];"
NSQ_SOURCE_LINE 00000610 "      return \\$token;"
NSQ_SOURCE_LINE 00000611 "     },"
NSQ_SOURCE_LINE 00000612 "    );"
NSQ_SOURCE_LINE 00000613 "    my $x = 1;"
NSQ_SOURCE_LINE 00000614 "    cast $x, $delayed => sub { $_[0] * 2 };"
NSQ_SOURCE_LINE 00000615 "    $x = 2;"
NSQ_SOURCE_LINE 00000616 "    # $x is now 4"
NSQ_SOURCE_LINE 00000617 "    # But note that the delayed action only takes place at the end of the"
NSQ_SOURCE_LINE 00000618 "    # current statement :"
NSQ_SOURCE_LINE 00000619 "    my @y = ($x = 5, $x);"
NSQ_SOURCE_LINE 00000620 "    # $x is now 10, but @y is (5, 5)"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "=head1 PERL MAGIC HISTORY"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "The places where magic is invoked have changed a bit through perl history."
NSQ_SOURCE_LINE 00000625 "Here is a little list of the most recent ones."
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "=over 4"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "=item *"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "B<5.6.x>"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "I<p14416> : I<copy> and I<dup> magic."
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "=item *"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "B<5.8.9>"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "I<p28160> : Integration of I<p25854> (see below)."
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "I<p32542> : Integration of I<p31473> (see below)."
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "=item *"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "B<5.9.3>"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "I<p25854> : I<len> magic is no longer called when pushing an element into a magic array."
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "I<p26569> : I<local> magic."
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "=item *"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "B<5.9.5>"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "I<p31064> : Meaningful I<uvar> magic."
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "I<p31473> : I<clear> magic was not invoked when undefining an array."
NSQ_SOURCE_LINE 00000658 "The bug is fixed as of this version."
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "=item *"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "B<5.10.0>"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "Since C<PERL_MAGIC_uvar> is uppercased, C<hv_magic_check()> triggers I<copy> magic on hash stores for (non-tied) hashes that also have I<uvar> magic."
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "=item *"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "B<5.11.x>"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "I<p32969> : I<len> magic is no longer invoked when calling C<length> with a magical scalar."
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "I<p34908> : I<len> magic is no longer called when pushing / unshifting an element into a magical array in void context."
NSQ_SOURCE_LINE 00000673 "The C<push> part was already covered by I<p25854>."
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "I<g9cdcb38b> : I<len> magic is called again when pushing into a magical array in non-void context."
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "=back"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "=head1 EXPORT"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "The functions L</wizard>, L</cast>, L</getdata> and L</dispell> are only exported on request."
NSQ_SOURCE_LINE 00000682 "All of them are exported by the tags C<':funcs'> and C<':all'>."
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "All the constants are also only exported on request, either individually or by the tags C<':consts'> and C<':all'>."
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "=cut"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "use base qw<Exporter>;"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "our @EXPORT         = ();"
NSQ_SOURCE_LINE 00000691 "our %EXPORT_TAGS    = ("
NSQ_SOURCE_LINE 00000692 " 'funcs' =>  [ qw<wizard cast getdata dispell> ],"
NSQ_SOURCE_LINE 00000693 " 'consts' => [ qw<"
NSQ_SOURCE_LINE 00000694 "   MGf_COPY MGf_DUP MGf_LOCAL VMG_UVAR"
NSQ_SOURCE_LINE 00000695 "   VMG_COMPAT_SCALAR_LENGTH_NOLEN"
NSQ_SOURCE_LINE 00000696 "   VMG_COMPAT_SCALAR_NOLEN"
NSQ_SOURCE_LINE 00000697 "   VMG_COMPAT_ARRAY_PUSH_NOLEN VMG_COMPAT_ARRAY_PUSH_NOLEN_VOID"
NSQ_SOURCE_LINE 00000698 "   VMG_COMPAT_ARRAY_UNSHIFT_NOLEN_VOID"
NSQ_SOURCE_LINE 00000699 "   VMG_COMPAT_ARRAY_UNDEF_CLEAR"
NSQ_SOURCE_LINE 00000700 "   VMG_COMPAT_HASH_DELETE_NOUVAR_VOID"
NSQ_SOURCE_LINE 00000701 "   VMG_COMPAT_CODE_COPY_CLONE"
NSQ_SOURCE_LINE 00000702 "   VMG_COMPAT_GLOB_GET"
NSQ_SOURCE_LINE 00000703 "   VMG_PERL_PATCHLEVEL"
NSQ_SOURCE_LINE 00000704 "   VMG_THREADSAFE VMG_FORKSAFE"
NSQ_SOURCE_LINE 00000705 "   VMG_OP_INFO_NAME VMG_OP_INFO_OBJECT"
NSQ_SOURCE_LINE 00000706 " > ],"
NSQ_SOURCE_LINE 00000707 ");"
NSQ_SOURCE_LINE 00000708 "our @EXPORT_OK      = map { @$_ } values %EXPORT_TAGS;"
NSQ_SOURCE_LINE 00000709 "$EXPORT_TAGS{'all'} = [ @EXPORT_OK ];"
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "In order to hook hash operations with magic, you need at least perl 5.10.0 (see L</VMG_UVAR>)."
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "If you want to store a magic object in the private data slot, you will not be able to recover the magic with L</getdata>, since magic is not copied by assignment."
NSQ_SOURCE_LINE 00000716 "You can work around this gotcha by storing a reference to the magic object instead."
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "If you define a wizard with I<free> magic and cast it on itself, it results in a memory cycle, so this destructor will not be called when the wizard is freed."
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "=head1 DEPENDENCIES"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "L<perl> 5.8."
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "A C compiler."
NSQ_SOURCE_LINE 00000725 "This module may happen to build with a C++ compiler as well, but don't rely on it, as no guarantee is made in this regard."
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "L<Carp> (core since perl 5), L<XSLoader> (since 5.6.0)."
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "L<perlguts> and L<perlapi> for internal information about magic."
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "L<perltie> and L<overload> for other ways of enhancing objects."
