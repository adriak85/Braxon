BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "package Test::MockRandom;"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: Replaces random number generation with non-random number generation"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '1.01'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Carp qw/croak/;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000011 "# Class data"
NSQ_SOURCE_LINE 00000012 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "my @data = (0);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000017 "# new()"
NSQ_SOURCE_LINE 00000018 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "sub new {"
NSQ_SOURCE_LINE 00000021 "    my ( $class, @data ) = @_;"
NSQ_SOURCE_LINE 00000022 "    my $self = bless( [], ref($class) || $class );"
NSQ_SOURCE_LINE 00000023 "    $self->srand(@data);"
NSQ_SOURCE_LINE 00000024 "    return $self;"
NSQ_SOURCE_LINE 00000025 "}"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000028 "# srand()"
NSQ_SOURCE_LINE 00000029 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub srand { ## no critic"
NSQ_SOURCE_LINE 00000032 "    if ( ref( $_[0] ) eq __PACKAGE__ ) {"
NSQ_SOURCE_LINE 00000033 "        my $self = shift;"
NSQ_SOURCE_LINE 00000034 "        @$self = $self->_test_srand(@_);"
NSQ_SOURCE_LINE 00000035 "        return;"
NSQ_SOURCE_LINE 00000036 "    }"
NSQ_SOURCE_LINE 00000037 "    else {"
NSQ_SOURCE_LINE 00000038 "        @data = Test::MockRandom->_test_srand(@_);"
NSQ_SOURCE_LINE 00000039 "        return;"
NSQ_SOURCE_LINE 00000040 "    }"
NSQ_SOURCE_LINE 00000041 "}"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "sub _test_srand {"
NSQ_SOURCE_LINE 00000044 "    my ( $self, @data ) = @_;"
NSQ_SOURCE_LINE 00000045 "    my $error ="
NSQ_SOURCE_LINE 00000046 "      \"Seeds for \" . __PACKAGE__ . \" must be between 0 (inclusive) and 1 (exclusive)\";"
NSQ_SOURCE_LINE 00000047 "    croak $error if grep { $_ < 0 or $_ >= 1 } @data;"
NSQ_SOURCE_LINE 00000048 "    return @data ? @data : (0);"
NSQ_SOURCE_LINE 00000049 "}"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000052 "# rand()"
NSQ_SOURCE_LINE 00000053 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "sub rand(;$) { ## no critic"
NSQ_SOURCE_LINE 00000056 "    my ( $mult, $val );"
NSQ_SOURCE_LINE 00000057 "    if ( ref( $_[0] ) eq __PACKAGE__ ) { # we're a MockRandom object"
NSQ_SOURCE_LINE 00000058 "        $mult = $_[1];"
NSQ_SOURCE_LINE 00000059 "        $val = shift @{ $_[0] } || 0;"
NSQ_SOURCE_LINE 00000060 "    }"
NSQ_SOURCE_LINE 00000061 "    else {"
NSQ_SOURCE_LINE 00000062 "        # we might be called as a method of some other class"
NSQ_SOURCE_LINE 00000063 "        # so we need to ignore that and get the right multiplier"
NSQ_SOURCE_LINE 00000064 "        $mult = $_[ ref( $_[0] ) ? 1 : 0 ];"
NSQ_SOURCE_LINE 00000065 "        $val = shift @data || 0;"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 "    # default to 1 for undef, 0, or strings that aren't numbers"
NSQ_SOURCE_LINE 00000068 "    eval { no warnings; local $^W = 0; my $bogus = 1 / $mult };"
NSQ_SOURCE_LINE 00000069 "    $mult = 1 if $@;"
NSQ_SOURCE_LINE 00000070 "    return $val * $mult;"
NSQ_SOURCE_LINE 00000071 "}"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000074 "# oneish()"
NSQ_SOURCE_LINE 00000075 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "sub oneish {"
NSQ_SOURCE_LINE 00000078 "    return ( 2**32 - 1 ) / ( 2**32 );"
NSQ_SOURCE_LINE 00000079 "}"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000082 "# import()"
NSQ_SOURCE_LINE 00000083 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "sub import {"
NSQ_SOURCE_LINE 00000086 "    my ( $class, @import_list ) = @_;"
NSQ_SOURCE_LINE 00000087 "    my $caller = caller(0);"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    # Nothing exported by default or if empty string requested"
NSQ_SOURCE_LINE 00000090 "    return unless @import_list;"
NSQ_SOURCE_LINE 00000091 "    return if ( @import_list == 1 && $import_list[0] eq '' );"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    for my $tgt (@import_list) {"
NSQ_SOURCE_LINE 00000094 "        # custom handling if it's a hashref"
NSQ_SOURCE_LINE 00000095 "        if ( ref($tgt) eq \"HASH\" ) {"
NSQ_SOURCE_LINE 00000096 "            for my $sym ( keys %$tgt ) {"
NSQ_SOURCE_LINE 00000097 "                croak \"Unrecognized symbol '$sym'\""
NSQ_SOURCE_LINE 00000098 "                  unless grep { $sym eq $_ } qw (rand srand oneish);"
NSQ_SOURCE_LINE 00000099 "                my @custom = ref( $tgt->{$sym} ) eq 'ARRAY' ? @{ $tgt->{$sym} } : $tgt->{$sym};"
NSQ_SOURCE_LINE 00000100 "                _custom_export( $sym, $_ ) for (@custom);"
NSQ_SOURCE_LINE 00000101 "            }"
NSQ_SOURCE_LINE 00000102 "        }"
NSQ_SOURCE_LINE 00000103 "        # otherwise, export rand to target and srand/oneish to caller"
NSQ_SOURCE_LINE 00000104 "        else {"
NSQ_SOURCE_LINE 00000105 "            my $pkg = ( $tgt =~ /^__PACKAGE__$/ ) ? $caller : $tgt; # DWIM"
NSQ_SOURCE_LINE 00000106 "            _export_symbol( \"rand\", $pkg );"
NSQ_SOURCE_LINE 00000107 "            _export_symbol( $_, $caller ) for qw( srand oneish );"
NSQ_SOURCE_LINE 00000108 "        }"
NSQ_SOURCE_LINE 00000109 "    }"
NSQ_SOURCE_LINE 00000110 "    return;"
NSQ_SOURCE_LINE 00000111 "}"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000114 "# export_oneish_to()"
NSQ_SOURCE_LINE 00000115 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "sub export_oneish_to {"
NSQ_SOURCE_LINE 00000118 "    my ( $class, @args ) = @_;"
NSQ_SOURCE_LINE 00000119 "    _export_fcn_to( $class, \"oneish\", @args );"
NSQ_SOURCE_LINE 00000120 "    return;"
NSQ_SOURCE_LINE 00000121 "}"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000124 "# export_rand_to()"
NSQ_SOURCE_LINE 00000125 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "sub export_rand_to {"
NSQ_SOURCE_LINE 00000128 "    my ( $class, @args ) = @_;"
NSQ_SOURCE_LINE 00000129 "    _export_fcn_to( $class, \"rand\", @args );"
NSQ_SOURCE_LINE 00000130 "    return;"
NSQ_SOURCE_LINE 00000131 "}"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000134 "# export_srand_to()"
NSQ_SOURCE_LINE 00000135 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "sub export_srand_to {"
NSQ_SOURCE_LINE 00000138 "    my ( $class, @args ) = @_;"
NSQ_SOURCE_LINE 00000139 "    _export_fcn_to( $class, \"srand\", @args );"
NSQ_SOURCE_LINE 00000140 "    return;"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000144 "# _custom_export"
NSQ_SOURCE_LINE 00000145 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "sub _custom_export {"
NSQ_SOURCE_LINE 00000148 "    my ( $sym, $custom ) = @_;"
NSQ_SOURCE_LINE 00000149 "    if ( ref($custom) eq 'HASH' ) {"
NSQ_SOURCE_LINE 00000150 "        _export_symbol( $sym, %$custom ); # flatten { pkg => 'alias' }"
NSQ_SOURCE_LINE 00000151 "    }"
NSQ_SOURCE_LINE 00000152 "    else {"
NSQ_SOURCE_LINE 00000153 "        _export_symbol( $sym, $custom );"
NSQ_SOURCE_LINE 00000154 "    }"
NSQ_SOURCE_LINE 00000155 "    return;"
NSQ_SOURCE_LINE 00000156 "}"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000159 "# _export_fcn_to"
NSQ_SOURCE_LINE 00000160 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "sub _export_fcn_to {"
NSQ_SOURCE_LINE 00000163 "    my ( $self, $fcn, $pkg, $alias ) = @_;"
NSQ_SOURCE_LINE 00000164 "    croak \"Must call to export_${fcn}_to() as a class method\""
NSQ_SOURCE_LINE 00000165 "      unless ( $self eq __PACKAGE__ );"
NSQ_SOURCE_LINE 00000166 "    croak(\"export_${fcn}_to() requires a package name\") unless $pkg;"
NSQ_SOURCE_LINE 00000167 "    _export_symbol( $fcn, $pkg, $alias );"
NSQ_SOURCE_LINE 00000168 "    return;"
NSQ_SOURCE_LINE 00000169 "}"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000172 "# _export_symbol()"
NSQ_SOURCE_LINE 00000173 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "sub _export_symbol {"
NSQ_SOURCE_LINE 00000176 "    my ( $sym, $pkg, $alias ) = @_;"
NSQ_SOURCE_LINE 00000177 "    $alias ||= $sym;"
NSQ_SOURCE_LINE 00000178 "    {"
NSQ_SOURCE_LINE 00000179 "        no strict 'refs'; ## no critic"
NSQ_SOURCE_LINE 00000180 "        no warnings 'redefine';"
NSQ_SOURCE_LINE 00000181 "        local $^W = 0;    # no redefine warnings"
NSQ_SOURCE_LINE 00000182 "        *{\"${pkg}::${alias}\"} = \\&{\"Test::MockRandom::${sym}\"};"
NSQ_SOURCE_LINE 00000183 "    }"
NSQ_SOURCE_LINE 00000184 "    return;"
NSQ_SOURCE_LINE 00000185 "}"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "1;"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "__END__"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=pod"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=head1 NAME"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "Test::MockRandom - Replaces random number generation with non-random number generation"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "=head1 VERSION"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "version 1.01"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "   # intercept rand in another package"
NSQ_SOURCE_LINE 00000206 "   use Test::MockRandom 'Some::Other::Package';"
NSQ_SOURCE_LINE 00000207 "   use Some::Other::Package; # exports sub foo { return rand }"
NSQ_SOURCE_LINE 00000208 "   srand(0.13);"
NSQ_SOURCE_LINE 00000209 "   foo(); # returns 0.13"
NSQ_SOURCE_LINE 00000210 " "
NSQ_SOURCE_LINE 00000211 "   # using a seed list and \"oneish\""
NSQ_SOURCE_LINE 00000212 "   srand(0.23, 0.34, oneish() );"
NSQ_SOURCE_LINE 00000213 "   foo(); # returns 0.23"
NSQ_SOURCE_LINE 00000214 "   foo(); # returns 0.34"
NSQ_SOURCE_LINE 00000215 "   foo(); # returns a number just barely less than one"
NSQ_SOURCE_LINE 00000216 "   foo(); # returns 0, as the seed array is empty"
NSQ_SOURCE_LINE 00000217 " "
NSQ_SOURCE_LINE 00000218 "   # object-oriented, for use in the current package"
NSQ_SOURCE_LINE 00000219 "   use Test::MockRandom ();"
NSQ_SOURCE_LINE 00000220 "   my $nrng = Test::MockRandom->new(0.42, 0.23);"
NSQ_SOURCE_LINE 00000221 "   $nrng->rand(); # returns 0.42"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "This perhaps ridiculous-seeming module was created to test routines that"
NSQ_SOURCE_LINE 00000226 "manipulate random numbers by providing a known output from C<<< rand >>>.  Given a"
NSQ_SOURCE_LINE 00000227 "list of seeds with C<<< srand >>>, it will return each in turn.  After seeded random"
NSQ_SOURCE_LINE 00000228 "numbers are exhausted, it will always return 0.  Seed numbers must be of a form"
NSQ_SOURCE_LINE 00000229 "that meets the expected output from C<<< rand >>> as called with no arguments -- i.e."
NSQ_SOURCE_LINE 00000230 "they must be between 0 (inclusive) and 1 (exclusive).  In order to facilitate"
NSQ_SOURCE_LINE 00000231 "generating and testing a nearly-one number, this module exports the function"
NSQ_SOURCE_LINE 00000232 "C<<< oneish >>>, which returns a number just fractionally less than one.  "
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "Depending on how this module is called with C<<< use >>>, it will export C<<< rand >>> to a"
NSQ_SOURCE_LINE 00000235 "specified package (e.g. a class being tested) effectively overriding and"
NSQ_SOURCE_LINE 00000236 "intercepting calls in that package to the built-in C<<< rand >>>.  It can also"
NSQ_SOURCE_LINE 00000237 "override C<<< rand >>> in the current package or even globally.  In all"
NSQ_SOURCE_LINE 00000238 "of these cases, it also exports C<<< srand >>> and C<<< oneish >>> to the current package"
NSQ_SOURCE_LINE 00000239 "in order to control the output of C<<< rand >>>.  See L</USAGE> for details."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "Alternatively, this module can be used to generate objects, with each object"
NSQ_SOURCE_LINE 00000242 "maintaining its own distinct seed array."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head1 USAGE"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "By default, Test::MockRandom does not export any functions.  This still allows"
NSQ_SOURCE_LINE 00000247 "object-oriented use by calling C<<< Test::MockRandom->new(@seeds) >>>.  In order"
NSQ_SOURCE_LINE 00000248 "for Test::MockRandom to be more useful, arguments must be provided during the"
NSQ_SOURCE_LINE 00000249 "call to C<<< use >>>."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=head2 use Test::MockRandom 'Target::Package'"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "The simplest way to intercept C<<< rand >>> in another package is to provide the"
NSQ_SOURCE_LINE 00000254 "name(s) of the package(s) for interception as arguments in the C<<< use >>>"
NSQ_SOURCE_LINE 00000255 "statement.  This will export C<<< rand >>> to the listed packages and will export"
NSQ_SOURCE_LINE 00000256 "C<<< srand >>> and C<<< oneish >>> to the current package to control the behavior of"
NSQ_SOURCE_LINE 00000257 "C<<< rand >>>.  You B<must> C<<< use >>> Test::MockRandom before you C<<< use >>> the target"
NSQ_SOURCE_LINE 00000258 "package.  This is a typical case for testing a module that uses random numbers:"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "  use Test::More 'no_plan';"
NSQ_SOURCE_LINE 00000261 "  use Test::MockRandom 'Some::Package';"
NSQ_SOURCE_LINE 00000262 "  BEGIN { use_ok( Some::Package ) }"
NSQ_SOURCE_LINE 00000263 " "
NSQ_SOURCE_LINE 00000264 "  # assume sub foo { return rand } was imported from Some::Package"
NSQ_SOURCE_LINE 00000265 " "
NSQ_SOURCE_LINE 00000266 "  srand(0.5)"
NSQ_SOURCE_LINE 00000267 "  is( foo(), 0.5, \"is foo() 0.5?\") # test gives \"ok\""
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "If multiple package names are specified, C<<< rand >>> will be exported to all"
NSQ_SOURCE_LINE 00000270 "of them."
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "If you wish to export C<<< rand >>> to the current package, simply provide"
NSQ_SOURCE_LINE 00000273 "C<<< __PACKAGE__ >>> as the parameter for C<<< use >>>, or C<<< main >>> if importing"
NSQ_SOURCE_LINE 00000274 "to a script without a specified package.  This can be part of a"
NSQ_SOURCE_LINE 00000275 "list provided to C<<< use >>>.  All of the following idioms work:"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "  use Test::MockRandom qw( main Some::Package ); # Assumes a script"
NSQ_SOURCE_LINE 00000278 "  use Test::MockRandom __PACKAGE__, 'Some::Package';"
NSQ_SOURCE_LINE 00000279 " "
NSQ_SOURCE_LINE 00000280 "  # The following doesn't interpolate __PACKAGE__ as above, but "
NSQ_SOURCE_LINE 00000281 "  # Test::MockRandom will still DWIM and handle it correctly"
NSQ_SOURCE_LINE 00000282 " "
NSQ_SOURCE_LINE 00000283 "  use Test::MockRandom qw( __PACKAGE__ Some::Package );"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "=head2 use Test::MockRandom %customized"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "As an alternative to a package name as an argument to C<<< use >>>,"
NSQ_SOURCE_LINE 00000288 "Test::MockRandom will also accept a hash reference with a custom"
NSQ_SOURCE_LINE 00000289 "set of instructions for how to export functions:"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "  use Test::MockRandom {"
NSQ_SOURCE_LINE 00000292 "     rand   => [ Some::Package, {Another::Package => 'random'} ],"
NSQ_SOURCE_LINE 00000293 "     srand  => { Another::Package => 'seed' }, "
NSQ_SOURCE_LINE 00000294 "     oneish => __PACKAGE__"
NSQ_SOURCE_LINE 00000295 "  };"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "The keys of the hash may be any of C<<< rand >>>, C<<< srand >>>, and C<<< oneish >>>.  The"
NSQ_SOURCE_LINE 00000298 "values of the hash give instructions for where to export the symbol"
NSQ_SOURCE_LINE 00000299 "corresponding to the key.  These are interpreted as follows, depending on their"
NSQ_SOURCE_LINE 00000300 "type:"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=over"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=item *"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "String: a package to which Test::MockRandom will export the symbol"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=item *"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "Hash Reference: the key is the package to which Test::MockRandom will export"
NSQ_SOURCE_LINE 00000311 "the symbol and the value is the name under which it will be exported"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "=item *"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "Array Reference: a list of strings or hash references which will be handled"
NSQ_SOURCE_LINE 00000316 "as above"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=back"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "=head2 Test::MockRandom-E<gt>export_rand_to()"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "In order to intercept the built-in C<<< rand >>> in another package, "
NSQ_SOURCE_LINE 00000323 "Test::MockRandom must export its own C<<< rand >>> function to the "
NSQ_SOURCE_LINE 00000324 "target package B<before> the target package is compiled, thus overriding"
NSQ_SOURCE_LINE 00000325 "calls to the built-in.  The simple approach (described above) of providing the"
NSQ_SOURCE_LINE 00000326 "target package name in the C<<< use Test::MockRandom >>> statement accomplishes this"
NSQ_SOURCE_LINE 00000327 "because C<<< use >>> is equivalent to a C<<< require >>> and C<<< import >>> within a C<<< BEGIN >>>"
NSQ_SOURCE_LINE 00000328 "block.  To explicitly intercept C<<< rand >>> in another package, you can also call"
NSQ_SOURCE_LINE 00000329 "C<<< export_rand_to >>>, but it must be enclosed in a C<<< BEGIN >>> block of its own.  The"
NSQ_SOURCE_LINE 00000330 "explicit form also support function aliasing just as with the custom approach"
NSQ_SOURCE_LINE 00000331 "with C<<< use >>>, described above:"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "  use Test::MockRandom;"
NSQ_SOURCE_LINE 00000334 "  BEGIN {Test::MockRandom->export_rand_to('AnotherPackage'=>'random')}"
NSQ_SOURCE_LINE 00000335 "  use AnotherPackage;"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "This C<<< BEGIN >>> block must not include a C<<< use >>> statement for the package to be"
NSQ_SOURCE_LINE 00000338 "intercepted, or perl will compile the package to be intercepted before the"
NSQ_SOURCE_LINE 00000339 "C<<< export_rand_to >>> function has a chance to execute and intercept calls to "
NSQ_SOURCE_LINE 00000340 "the built-in C<<< rand >>>.  This is very important in testing.  The C<<< export_rand_to >>>"
NSQ_SOURCE_LINE 00000341 "call must be in a separate C<<< BEGIN >>> block from a C<<< use >>> or C<<< use_ok >>> test,"
NSQ_SOURCE_LINE 00000342 "which should be enclosed in a C<<< BEGIN >>> block of its own: "
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "  use Test::More tests => 1;"
NSQ_SOURCE_LINE 00000345 "  use Test::MockRandom;"
NSQ_SOURCE_LINE 00000346 "  BEGIN { Test::MockRandom->export_rand_to( 'AnotherPackage' ); }"
NSQ_SOURCE_LINE 00000347 "  BEGIN { use_ok( 'AnotherPackage' ); }"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "Given these cautions, it's probably best to use either the simple or custom"
NSQ_SOURCE_LINE 00000350 "approach with C<<< use >>>, which does the right thing in most circumstances.  Should"
NSQ_SOURCE_LINE 00000351 "additional explicit customization be necessary, Test::MockRandom also provides"
NSQ_SOURCE_LINE 00000352 "C<<< export_srand_to >>> and C<<< export_oneish_to >>>."
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=head2 Overriding C<<< rand >>> globally: use Test::MockRandom 'CORE::GLOBAL'"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "This is just like intercepting C<<< rand >>> in a package, except that you"
NSQ_SOURCE_LINE 00000357 "do it globally by overriding the built-in function in C<<< CORE::GLOBAL >>>. "
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "  use Test::MockRandom 'CORE::GLOBAL';"
NSQ_SOURCE_LINE 00000360 " "
NSQ_SOURCE_LINE 00000361 "  # or"
NSQ_SOURCE_LINE 00000362 " "
NSQ_SOURCE_LINE 00000363 "  BEGIN { Test::MockRandom->export_rand_to('CORE::GLOBAL') }"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "You can always access the real, built-in C<<< rand >>> by calling it explicitly as"
NSQ_SOURCE_LINE 00000366 "C<<< CORE::rand >>>."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "=head2 Intercepting C<<< rand >>> in a package that also contains a C<<< rand >>> function"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "This is tricky as the order in which the symbol table is manipulated will lead"
NSQ_SOURCE_LINE 00000371 "to very different results.  This can be done safely (maybe) if the module uses"
NSQ_SOURCE_LINE 00000372 "the same rand syntaxE<sol>prototype as the system call but offers them up as method"
NSQ_SOURCE_LINE 00000373 "calls which resolve at run-time instead of compile time.  In this case, you"
NSQ_SOURCE_LINE 00000374 "will need to do an explicit intercept (as above) but do it B<after> importing"
NSQ_SOURCE_LINE 00000375 "the package.  I.e.:"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "  use Test::MockRandom 'SomeRandPackage';"
NSQ_SOURCE_LINE 00000378 "  use SomeRandPackage;"
NSQ_SOURCE_LINE 00000379 "  BEGIN { Test::MockRandom->export_rand_to('SomeRandPackage');"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "The first line is necessary to get C<<< srand >>> and C<<< oneish >>> exported to"
NSQ_SOURCE_LINE 00000382 "the current package.  The second line will define a C<<< sub rand >>> in "
NSQ_SOURCE_LINE 00000383 "C<<< SomeRandPackage >>>, overriding the results of the first line.  The third"
NSQ_SOURCE_LINE 00000384 "line then re-overrides the C<<< rand >>>.  You may see warnings about C<<< rand >>> "
NSQ_SOURCE_LINE 00000385 "being redefined."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "Depending on how your C<<< rand >>> is written and used, there is a good likelihood"
NSQ_SOURCE_LINE 00000388 "that this isn't going to do what you're expecting, no matter what.  If your"
NSQ_SOURCE_LINE 00000389 "package that defines C<<< rand >>> relies internally upon the system"
NSQ_SOURCE_LINE 00000390 "C<<< CORE::GLOBAL::rand >>> function, then you may be best off overriding that"
NSQ_SOURCE_LINE 00000391 "instead."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=head2 C<<< new >>>"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "  $obj = new( LIST OF SEEDS );"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "Returns a new Test::MockRandom object with the specified list of seeds."
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=head2 C<<< srand >>>"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "  srand( LIST OF SEEDS );"
NSQ_SOURCE_LINE 00000404 "  $obj->srand( LIST OF SEEDS);"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "If called as a bare function call or package method, sets the seed list"
NSQ_SOURCE_LINE 00000407 "for bareE<sol>package calls to C<<< rand >>>.  If called as an object method,"
NSQ_SOURCE_LINE 00000408 "sets the seed list for that object only."
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "=head2 C<<< rand >>>"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "  $rv = rand();"
NSQ_SOURCE_LINE 00000413 "  $rv = $obj->rand();"
NSQ_SOURCE_LINE 00000414 "  $rv = rand(3);"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "If called as a bare or package function, returns the next value from the"
NSQ_SOURCE_LINE 00000417 "package seed list.  If called as an object method, returns the next value from"
NSQ_SOURCE_LINE 00000418 "the object seed list. "
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "If C<<< rand >>> is called with a numeric argument, it follows the same behavior as"
NSQ_SOURCE_LINE 00000421 "the built-in function -- it multiplies the argument with the next value from"
NSQ_SOURCE_LINE 00000422 "the seed array (resulting in a random fractional value between 0 and the"
NSQ_SOURCE_LINE 00000423 "argument, just like the built-in).  If the argument is 0, undef, or"
NSQ_SOURCE_LINE 00000424 "non-numeric, it is treated as if the argument is 1."
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "Using this with an argument in testing may be complicated, as limits in"
NSQ_SOURCE_LINE 00000427 "floating point precision mean that direct numeric comparisons are not reliable."
NSQ_SOURCE_LINE 00000428 "E.g."
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "  srand(1/3);"
NSQ_SOURCE_LINE 00000431 "  rand(3);       # does this return 1.0 or .999999999 etc."
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=head2 C<<< oneish >>>"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "  srand( oneish() );"
NSQ_SOURCE_LINE 00000436 "  if ( rand() == oneish() ) { print \"It's almost one.\" };"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "A utility function to return a nearly-one value.  Equal to ( 2^32 - 1 ) E<sol> 2^32."
NSQ_SOURCE_LINE 00000439 "Useful in C<<< srand >>> and test functions."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=head2 C<<< export_rand_to >>>"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "  Test::MockRandom->export_rand_to( 'Some::Class' );"
NSQ_SOURCE_LINE 00000444 "  Test::MockRandom->export_rand_to( 'Some::Class' => 'random' );"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "This function exports C<<< rand >>> into the specified package namespace.  It must be"
NSQ_SOURCE_LINE 00000447 "called as a class function.  If a second argument is provided, it is taken as"
NSQ_SOURCE_LINE 00000448 "the symbol name used in the other package as the alias to C<<< rand >>>:"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "  use Test::MockRandom;"
NSQ_SOURCE_LINE 00000451 "  BEGIN { Test::MockRandom->export_rand_to( 'Some::Class' => 'random' ); }"
NSQ_SOURCE_LINE 00000452 "  use Some::Class;"
NSQ_SOURCE_LINE 00000453 "  srand (0.5);"
NSQ_SOURCE_LINE 00000454 "  print Some::Class::random(); # prints 0.5"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "It can also be used to explicitly intercept C<<< rand >>> after Test::MockRandom has"
NSQ_SOURCE_LINE 00000457 "been loaded.  The effect of this function is highly dependent on when it is"
NSQ_SOURCE_LINE 00000458 "called in the compile cycle and should usually called from within a BEGIN"
NSQ_SOURCE_LINE 00000459 "block.  See L</USAGE> for details."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "Most users will not need this function."
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "=head2 C<<< export_srand_to >>>"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "  Test::MockRandom->export_srand_to( 'Some::Class' );"
NSQ_SOURCE_LINE 00000466 "  Test::MockRandom->export_srand_to( 'Some::Class' => 'seed' );"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "This function exports C<<< srand >>> into the specified package namespace.  It must be "
NSQ_SOURCE_LINE 00000469 "called as a class function.  If a second argument is provided, it is taken as"
NSQ_SOURCE_LINE 00000470 "the symbol name to use in the other package as the alias for C<<< srand >>>."
NSQ_SOURCE_LINE 00000471 "This function may be useful if another package wraps C<<< srand >>>:"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "  # In Some/Class.pm"
NSQ_SOURCE_LINE 00000474 "  package Some::Class;"
NSQ_SOURCE_LINE 00000475 "  sub seed { srand(shift) }"
NSQ_SOURCE_LINE 00000476 "  sub foo  { rand }"
NSQ_SOURCE_LINE 00000477 " "
NSQ_SOURCE_LINE 00000478 "  # In a script"
NSQ_SOURCE_LINE 00000479 "  use Test::MockRandom 'Some::Class';"
NSQ_SOURCE_LINE 00000480 "  BEGIN { Test::MockRandom->export_srand_to( 'Some::Class' ); }"
NSQ_SOURCE_LINE 00000481 "  use Some::Class;"
NSQ_SOURCE_LINE 00000482 "  seed(0.5);"
NSQ_SOURCE_LINE 00000483 "  print foo();   # prints \"0.5\""
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "The effect of this function is highly dependent on when it is called in the"
NSQ_SOURCE_LINE 00000486 "compile cycle and should usually be called from within a BEGIN block.  See"
NSQ_SOURCE_LINE 00000487 "L</USAGE> for details."
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "Most users will not need this function.  "
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "=head2 C<<< export_oneish_to >>>"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "  Test::MockRandom->export_oneish_to( 'Some::Class' );"
NSQ_SOURCE_LINE 00000494 "  Test::MockRandom->export_oneish_to( 'Some::Class' => 'nearly_one' );"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "This function exports C<<< oneish >>> into the specified package namespace.  It must"
NSQ_SOURCE_LINE 00000497 "be called as a class function.  If a second argument is provided, it is taken"
NSQ_SOURCE_LINE 00000498 "as the symbol name to use in the other package as the alias for C<<< oneish >>>.  "
NSQ_SOURCE_LINE 00000499 "Since C<<< oneish >>> is usually only used in a test script, this function is likely"
NSQ_SOURCE_LINE 00000500 "only necessary to alias C<<< oneish >>> to some other name in the current package:"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "  use Test::MockRandom 'Some::Class';"
NSQ_SOURCE_LINE 00000503 "  BEGIN { Test::MockRandom->export_oneish_to( __PACKAGE__, \"one\" ); }"
NSQ_SOURCE_LINE 00000504 "  use Some::Class;"
NSQ_SOURCE_LINE 00000505 "  seed( one() );"
NSQ_SOURCE_LINE 00000506 "  print foo();   # prints a value very close to one"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "The effect of this function is highly dependent on when it is called in the"
NSQ_SOURCE_LINE 00000509 "compile cycle and should usually be called from within a BEGIN block.  See"
NSQ_SOURCE_LINE 00000510 "L</USAGE> for details."
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "Most users will not need this function.  "
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000515 ""
