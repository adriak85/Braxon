BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Try::Tiny; # git description: v0.31-2-gc8e3a47"
NSQ_SOURCE_LINE 00000002 "use 5.006;"
NSQ_SOURCE_LINE 00000003 "# ABSTRACT: Minimal try/catch with proper preservation of $@"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "our $VERSION = '0.32';"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter 5.57 'import';"
NSQ_SOURCE_LINE 00000011 "our @EXPORT = our @EXPORT_OK = qw(try catch finally);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Carp;"
NSQ_SOURCE_LINE 00000014 "$Carp::Internal{+__PACKAGE__}++;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "BEGIN {"
NSQ_SOURCE_LINE 00000017 "  my $su = $INC{'Sub/Util.pm'} && defined &Sub::Util::set_subname;"
NSQ_SOURCE_LINE 00000018 "  my $sn = $INC{'Sub/Name.pm'} && eval { Sub::Name->VERSION(0.08) };"
NSQ_SOURCE_LINE 00000019 "  unless ($su || $sn) {"
NSQ_SOURCE_LINE 00000020 "    $su = eval { require Sub::Util; } && defined &Sub::Util::set_subname;"
NSQ_SOURCE_LINE 00000021 "    unless ($su) {"
NSQ_SOURCE_LINE 00000022 "      $sn = eval { require Sub::Name; Sub::Name->VERSION(0.08) };"
NSQ_SOURCE_LINE 00000023 "    }"
NSQ_SOURCE_LINE 00000024 "  }"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "  *_subname = $su ? \\&Sub::Util::set_subname"
NSQ_SOURCE_LINE 00000027 "            : $sn ? \\&Sub::Name::subname"
NSQ_SOURCE_LINE 00000028 "            : sub { $_[1] };"
NSQ_SOURCE_LINE 00000029 "  *_HAS_SUBNAME = ($su || $sn) ? sub(){1} : sub(){0};"
NSQ_SOURCE_LINE 00000030 "}"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "my %_finally_guards;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "# Need to prototype as @ not $$ because of the way Perl evaluates the prototype."
NSQ_SOURCE_LINE 00000035 "# Keeping it at $$ means you only ever get 1 sub because we need to eval in a list"
NSQ_SOURCE_LINE 00000036 "# context & not a scalar one"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "sub try (&;@) {"
NSQ_SOURCE_LINE 00000039 "  my ( $try, @code_refs ) = @_;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "  # we need to save this here, the eval block will be in scalar context due"
NSQ_SOURCE_LINE 00000042 "  # to $failed"
NSQ_SOURCE_LINE 00000043 "  my $wantarray = wantarray;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "  # work around perl bug by explicitly initializing these, due to the likelyhood"
NSQ_SOURCE_LINE 00000046 "  # this will be used in global destruction (perl rt#119311)"
NSQ_SOURCE_LINE 00000047 "  my ( $catch, @finally ) = ();"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "  # find labeled blocks in the argument list."
NSQ_SOURCE_LINE 00000050 "  # catch and finally tag the blocks by blessing a scalar reference to them."
NSQ_SOURCE_LINE 00000051 "  foreach my $code_ref (@code_refs) {"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    if ( ref($code_ref) eq 'Try::Tiny::Catch' ) {"
NSQ_SOURCE_LINE 00000054 "      croak 'A try() may not be followed by multiple catch() blocks'"
NSQ_SOURCE_LINE 00000055 "        if $catch;"
NSQ_SOURCE_LINE 00000056 "      $catch = ${$code_ref};"
NSQ_SOURCE_LINE 00000057 "    } elsif ( ref($code_ref) eq 'Try::Tiny::Finally' ) {"
NSQ_SOURCE_LINE 00000058 "      push @finally, ${$code_ref};"
NSQ_SOURCE_LINE 00000059 "    } else {"
NSQ_SOURCE_LINE 00000060 "      croak("
NSQ_SOURCE_LINE 00000061 "        'try() encountered an unexpected argument ('"
NSQ_SOURCE_LINE 00000062 "      . ( defined $code_ref ? $code_ref : 'undef' )"
NSQ_SOURCE_LINE 00000063 "      . ') - perhaps a missing semi-colon before or'"
NSQ_SOURCE_LINE 00000064 "      );"
NSQ_SOURCE_LINE 00000065 "    }"
NSQ_SOURCE_LINE 00000066 "  }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "  # FIXME consider using local $SIG{__DIE__} to accumulate all errors. It's"
NSQ_SOURCE_LINE 00000069 "  # not perfect, but we could provide a list of additional errors for"
NSQ_SOURCE_LINE 00000070 "  # $catch->();"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "  # name the blocks if we have Sub::Name installed"
NSQ_SOURCE_LINE 00000073 "  _subname(caller().'::try {...} ' => $try)"
NSQ_SOURCE_LINE 00000074 "    if _HAS_SUBNAME;"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "  # set up scope guards to invoke the finally blocks at the end."
NSQ_SOURCE_LINE 00000077 "  # this should really be a function scope lexical variable instead of"
NSQ_SOURCE_LINE 00000078 "  # file scope + local but that causes issues with perls < 5.20 due to"
NSQ_SOURCE_LINE 00000079 "  # perl rt#119311"
NSQ_SOURCE_LINE 00000080 "  local $_finally_guards{guards} = ["
NSQ_SOURCE_LINE 00000081 "    map Try::Tiny::ScopeGuard->_new($_),"
NSQ_SOURCE_LINE 00000082 "    @finally"
NSQ_SOURCE_LINE 00000083 "  ];"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "  # save the value of $@ so we can set $@ back to it in the beginning of the eval"
NSQ_SOURCE_LINE 00000086 "  # and restore $@ after the eval finishes"
NSQ_SOURCE_LINE 00000087 "  my $prev_error = $@;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "  my ( @ret, $error );"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "  # failed will be true if the eval dies, because 1 will not be returned"
NSQ_SOURCE_LINE 00000092 "  # from the eval body"
NSQ_SOURCE_LINE 00000093 "  my $failed = not eval {"
NSQ_SOURCE_LINE 00000094 "    $@ = $prev_error;"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    # evaluate the try block in the correct context"
NSQ_SOURCE_LINE 00000097 "    if ( $wantarray ) {"
NSQ_SOURCE_LINE 00000098 "      @ret = $try->();"
NSQ_SOURCE_LINE 00000099 "    } elsif ( defined $wantarray ) {"
NSQ_SOURCE_LINE 00000100 "      $ret[0] = $try->();"
NSQ_SOURCE_LINE 00000101 "    } else {"
NSQ_SOURCE_LINE 00000102 "      $try->();"
NSQ_SOURCE_LINE 00000103 "    };"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    return 1; # properly set $failed to false"
NSQ_SOURCE_LINE 00000106 "  };"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "  # preserve the current error and reset the original value of $@"
NSQ_SOURCE_LINE 00000109 "  $error = $@;"
NSQ_SOURCE_LINE 00000110 "  $@ = $prev_error;"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "  # at this point $failed contains a true value if the eval died, even if some"
NSQ_SOURCE_LINE 00000113 "  # destructor overwrote $@ as the eval was unwinding."
NSQ_SOURCE_LINE 00000114 "  if ( $failed ) {"
NSQ_SOURCE_LINE 00000115 "    # pass $error to the finally blocks"
NSQ_SOURCE_LINE 00000116 "    push @$_, $error for @{$_finally_guards{guards}};"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    # if we got an error, invoke the catch block."
NSQ_SOURCE_LINE 00000119 "    if ( $catch ) {"
NSQ_SOURCE_LINE 00000120 "      # This works like given($error), but is backwards compatible and"
NSQ_SOURCE_LINE 00000121 "      # sets $_ in the dynamic scope for the body of C<$catch>"
NSQ_SOURCE_LINE 00000122 "      for ($error) {"
NSQ_SOURCE_LINE 00000123 "        return $catch->($error);"
NSQ_SOURCE_LINE 00000124 "      }"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "      # in case when() was used without an explicit return, the C<for>"
NSQ_SOURCE_LINE 00000127 "      # loop will be aborted and there's no useful return value"
NSQ_SOURCE_LINE 00000128 "    }"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    return;"
NSQ_SOURCE_LINE 00000131 "  } else {"
NSQ_SOURCE_LINE 00000132 "    # no failure, $@ is back to what it was, everything is fine"
NSQ_SOURCE_LINE 00000133 "    return $wantarray ? @ret : $ret[0];"
NSQ_SOURCE_LINE 00000134 "  }"
NSQ_SOURCE_LINE 00000135 "}"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "sub catch (&;@) {"
NSQ_SOURCE_LINE 00000138 "  my ( $block, @rest ) = @_;"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "  croak 'Useless bare catch()' unless wantarray;"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "  _subname(caller().'::catch {...} ' => $block)"
NSQ_SOURCE_LINE 00000143 "    if _HAS_SUBNAME;"
NSQ_SOURCE_LINE 00000144 "  return ("
NSQ_SOURCE_LINE 00000145 "    bless(\\$block, 'Try::Tiny::Catch'),"
NSQ_SOURCE_LINE 00000146 "    @rest,"
NSQ_SOURCE_LINE 00000147 "  );"
NSQ_SOURCE_LINE 00000148 "}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "sub finally (&;@) {"
NSQ_SOURCE_LINE 00000151 "  my ( $block, @rest ) = @_;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "  croak 'Useless bare finally()' unless wantarray;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "  _subname(caller().'::finally {...} ' => $block)"
NSQ_SOURCE_LINE 00000156 "    if _HAS_SUBNAME;"
NSQ_SOURCE_LINE 00000157 "  return ("
NSQ_SOURCE_LINE 00000158 "    bless(\\$block, 'Try::Tiny::Finally'),"
NSQ_SOURCE_LINE 00000159 "    @rest,"
NSQ_SOURCE_LINE 00000160 "  );"
NSQ_SOURCE_LINE 00000161 "}"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "{"
NSQ_SOURCE_LINE 00000164 "  package # hide from PAUSE"
NSQ_SOURCE_LINE 00000165 "    Try::Tiny::ScopeGuard;"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "  use constant UNSTABLE_DOLLARAT => (\"$]\" < '5.013002') ? 1 : 0;"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "  sub _new {"
NSQ_SOURCE_LINE 00000170 "    shift;"
NSQ_SOURCE_LINE 00000171 "    bless [ @_ ];"
NSQ_SOURCE_LINE 00000172 "  }"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "  sub DESTROY {"
NSQ_SOURCE_LINE 00000175 "    my ($code, @args) = @{ $_[0] };"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    local $@ if UNSTABLE_DOLLARAT;"
NSQ_SOURCE_LINE 00000178 "    eval {"
NSQ_SOURCE_LINE 00000179 "      $code->(@args);"
NSQ_SOURCE_LINE 00000180 "      1;"
NSQ_SOURCE_LINE 00000181 "    } or do {"
NSQ_SOURCE_LINE 00000182 "      warn"
NSQ_SOURCE_LINE 00000183 "        \"Execution of finally() block $code resulted in an exception, which \""
NSQ_SOURCE_LINE 00000184 "      . '*CAN NOT BE PROPAGATED* due to fundamental limitations of Perl. '"
NSQ_SOURCE_LINE 00000185 "      . 'Your program will continue as if this event never took place. '"
NSQ_SOURCE_LINE 00000186 "      . \"Original exception text follows:\\n\\n\""
NSQ_SOURCE_LINE 00000187 "      . (defined $@ ? $@ : '$@ left undefined...')"
NSQ_SOURCE_LINE 00000188 "      . \"\\n\""
NSQ_SOURCE_LINE 00000189 "      ;"
NSQ_SOURCE_LINE 00000190 "    }"
NSQ_SOURCE_LINE 00000191 "  }"
NSQ_SOURCE_LINE 00000192 "}"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "__PACKAGE__"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "__END__"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "=pod"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=head1 NAME"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "Try::Tiny - Minimal try/catch with proper preservation of $@"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=head1 VERSION"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "version 0.32"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "You can use Try::Tiny's C<try> and C<catch> to expect and handle exceptional"
NSQ_SOURCE_LINE 00000213 "conditions, avoiding quirks in Perl and common mistakes:"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "  # handle errors with a catch handler"
NSQ_SOURCE_LINE 00000216 "  try {"
NSQ_SOURCE_LINE 00000217 "    die \"foo\";"
NSQ_SOURCE_LINE 00000218 "  } catch {"
NSQ_SOURCE_LINE 00000219 "    warn \"caught error: $_\"; # not $@"
NSQ_SOURCE_LINE 00000220 "  };"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "You can also use it like a standalone C<eval> to catch and ignore any error"
NSQ_SOURCE_LINE 00000223 "conditions.  Obviously, this is an extreme measure not to be undertaken"
NSQ_SOURCE_LINE 00000224 "lightly:"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "  # just silence errors"
NSQ_SOURCE_LINE 00000227 "  try {"
NSQ_SOURCE_LINE 00000228 "    die \"foo\";"
NSQ_SOURCE_LINE 00000229 "  };"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "This module provides bare bones C<try>/C<catch>/C<finally> statements that are designed to"
NSQ_SOURCE_LINE 00000234 "minimize common mistakes with eval blocks, and NOTHING else."
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "This is unlike L<TryCatch> which provides a nice syntax and avoids adding"
NSQ_SOURCE_LINE 00000237 "another call stack layer, and supports calling C<return> from the C<try> block to"
NSQ_SOURCE_LINE 00000238 "return from the parent subroutine. These extra features come at a cost of a few"
NSQ_SOURCE_LINE 00000239 "dependencies, namely L<Devel::Declare> and L<Scope::Upper> which are"
NSQ_SOURCE_LINE 00000240 "occasionally problematic, and the additional catch filtering uses L<Moose>"
NSQ_SOURCE_LINE 00000241 "type constraints which may not be desirable either."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "The main focus of this module is to provide simple and reliable error handling"
NSQ_SOURCE_LINE 00000244 "for those having a hard time installing L<TryCatch>, but who still want to"
NSQ_SOURCE_LINE 00000245 "write correct C<eval> blocks without 5 lines of boilerplate each time."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "It's designed to work as correctly as possible in light of the various"
NSQ_SOURCE_LINE 00000248 "pathological edge cases (see L</BACKGROUND>) and to be compatible with any style"
NSQ_SOURCE_LINE 00000249 "of error values (simple strings, references, objects, overloaded objects, etc)."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "If the C<try> block dies, it returns the value of the last statement executed in"
NSQ_SOURCE_LINE 00000252 "the C<catch> block, if there is one. Otherwise, it returns C<undef> in scalar"
NSQ_SOURCE_LINE 00000253 "context or the empty list in list context. The following examples all"
NSQ_SOURCE_LINE 00000254 "assign C<\"bar\"> to C<$x>:"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "  my $x = try { die \"foo\" } catch { \"bar\" };"
NSQ_SOURCE_LINE 00000257 "  my $x = try { die \"foo\" } || \"bar\";"
NSQ_SOURCE_LINE 00000258 "  my $x = (try { die \"foo\" }) // \"bar\";"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "  my $x = eval { die \"foo\" } || \"bar\";"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "You can add C<finally> blocks, yielding the following:"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "  my $x;"
NSQ_SOURCE_LINE 00000265 "  try { die 'foo' } finally { $x = 'bar' };"
NSQ_SOURCE_LINE 00000266 "  try { die 'foo' } catch { warn \"Got a die: $_\" } finally { $x = 'bar' };"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "C<finally> blocks are always executed making them suitable for cleanup code"
NSQ_SOURCE_LINE 00000269 "which cannot be handled using local.  You can add as many C<finally> blocks to a"
NSQ_SOURCE_LINE 00000270 "given C<try> block as you like."
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "Note that adding a C<finally> block without a preceding C<catch> block"
NSQ_SOURCE_LINE 00000273 "suppresses any errors. This behaviour is consistent with using a standalone"
NSQ_SOURCE_LINE 00000274 "C<eval>, but it is not consistent with C<try>/C<finally> patterns found in"
NSQ_SOURCE_LINE 00000275 "other programming languages, such as Java, Python, Javascript or C#. If you"
NSQ_SOURCE_LINE 00000276 "learned the C<try>/C<finally> pattern from one of these languages, watch out for"
NSQ_SOURCE_LINE 00000277 "this."
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "All functions are exported by default using L<Exporter>."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "If you need to rename the C<try>, C<catch> or C<finally> keyword consider using"
NSQ_SOURCE_LINE 00000284 "L<Sub::Import> to get L<Sub::Exporter>'s flexibility."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=over 4"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=item try (&;@)"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "Takes one mandatory C<try> subroutine, an optional C<catch> subroutine and C<finally>"
NSQ_SOURCE_LINE 00000291 "subroutine."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "The mandatory subroutine is evaluated in the context of an C<eval> block."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "If no error occurred the value from the first block is returned, preserving"
NSQ_SOURCE_LINE 00000296 "list/scalar context."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "If there was an error and the second subroutine was given it will be invoked"
NSQ_SOURCE_LINE 00000299 "with the error in C<$_> (localized) and as that block's first and only"
NSQ_SOURCE_LINE 00000300 "argument."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "C<$@> does B<not> contain the error. Inside the C<catch> block it has the same"
NSQ_SOURCE_LINE 00000303 "value it had before the C<try> block was executed."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "Note that the error may be false, but if that happens the C<catch> block will"
NSQ_SOURCE_LINE 00000306 "still be invoked."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "Once all execution is finished then the C<finally> block, if given, will execute."
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=item catch (&;@)"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "Intended to be used in the second argument position of C<try>."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "Returns a reference to the subroutine it was given but blessed as"
NSQ_SOURCE_LINE 00000315 "C<Try::Tiny::Catch> which allows try to decode correctly what to do"
NSQ_SOURCE_LINE 00000316 "with this code reference."
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "  catch { ... }"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "Inside the C<catch> block the caught error is stored in C<$_>, while previous"
NSQ_SOURCE_LINE 00000321 "value of C<$@> is still available for use.  This value may or may not be"
NSQ_SOURCE_LINE 00000322 "meaningful depending on what happened before the C<try>, but it might be a good"
NSQ_SOURCE_LINE 00000323 "idea to preserve it in an error stack."
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "For code that captures C<$@> when throwing new errors (i.e."
NSQ_SOURCE_LINE 00000326 "L<Class::Throwable>), you'll need to do:"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "  local $@ = $_;"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=item finally (&;@)"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "  try     { ... }"
NSQ_SOURCE_LINE 00000333 "  catch   { ... }"
NSQ_SOURCE_LINE 00000334 "  finally { ... };"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "Or"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "  try     { ... }"
NSQ_SOURCE_LINE 00000339 "  finally { ... };"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "Or even"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "  try     { ... }"
NSQ_SOURCE_LINE 00000344 "  finally { ... }"
NSQ_SOURCE_LINE 00000345 "  catch   { ... };"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "Intended to be the second or third element of C<try>. C<finally> blocks are always"
NSQ_SOURCE_LINE 00000348 "executed in the event of a successful C<try> or if C<catch> is run. This allows"
NSQ_SOURCE_LINE 00000349 "you to locate cleanup code which cannot be done via C<local()> e.g. closing a file"
NSQ_SOURCE_LINE 00000350 "handle."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "When invoked, the C<finally> block is passed the error that was caught.  If no"
NSQ_SOURCE_LINE 00000353 "error was caught, it is passed nothing.  (Note that the C<finally> block does not"
NSQ_SOURCE_LINE 00000354 "localize C<$_> with the error, since unlike in a C<catch> block, there is no way"
NSQ_SOURCE_LINE 00000355 "to know if C<$_ == undef> implies that there were no errors.) In other words,"
NSQ_SOURCE_LINE 00000356 "the following code does just what you would expect:"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "  try {"
NSQ_SOURCE_LINE 00000359 "    die_sometimes();"
NSQ_SOURCE_LINE 00000360 "  } catch {"
NSQ_SOURCE_LINE 00000361 "    # ...code run in case of error"
NSQ_SOURCE_LINE 00000362 "  } finally {"
NSQ_SOURCE_LINE 00000363 "    if (@_) {"
NSQ_SOURCE_LINE 00000364 "      print \"The try block died with: @_\\n\";"
NSQ_SOURCE_LINE 00000365 "    } else {"
NSQ_SOURCE_LINE 00000366 "      print \"The try block ran without error.\\n\";"
NSQ_SOURCE_LINE 00000367 "    }"
NSQ_SOURCE_LINE 00000368 "  };"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "B<You must always do your own error handling in the C<finally> block>. C<Try::Tiny> will"
NSQ_SOURCE_LINE 00000371 "not do anything about handling possible errors coming from code located in these"
NSQ_SOURCE_LINE 00000372 "blocks."
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "Furthermore B<exceptions in C<finally> blocks are not trappable and are unable"
NSQ_SOURCE_LINE 00000375 "to influence the execution of your program>. This is due to limitation of"
NSQ_SOURCE_LINE 00000376 "C<DESTROY>-based scope guards, which C<finally> is implemented on top of. This"
NSQ_SOURCE_LINE 00000377 "may change in a future version of Try::Tiny."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "In the same way C<catch()> blesses the code reference this subroutine does the same"
NSQ_SOURCE_LINE 00000380 "except it bless them as C<Try::Tiny::Finally>."
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=back"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "=head1 BACKGROUND"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "There are a number of issues with C<eval>."
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "=head2 Clobbering $@"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "When you run an C<eval> block and it succeeds, C<$@> will be cleared, potentially"
NSQ_SOURCE_LINE 00000391 "clobbering an error that is currently being caught."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "This causes action at a distance, clearing previous errors your caller may have"
NSQ_SOURCE_LINE 00000394 "not yet handled."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "C<$@> must be properly localized before invoking C<eval> in order to avoid this"
NSQ_SOURCE_LINE 00000397 "issue."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "More specifically,"
NSQ_SOURCE_LINE 00000400 "L<before Perl version 5.14.0|perl5140delta/\"Exception Handling\">"
NSQ_SOURCE_LINE 00000401 "C<$@> was clobbered at the beginning of the C<eval>, which"
NSQ_SOURCE_LINE 00000402 "also made it impossible to capture the previous error before you die (for"
NSQ_SOURCE_LINE 00000403 "instance when making exception objects with error stacks)."
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "For this reason C<try> will actually set C<$@> to its previous value (the one"
NSQ_SOURCE_LINE 00000406 "available before entering the C<try> block) in the beginning of the C<eval>"
NSQ_SOURCE_LINE 00000407 "block."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "=head2 Localizing $@ silently masks errors"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "Inside an C<eval> block, C<die> behaves sort of like:"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "  sub die {"
NSQ_SOURCE_LINE 00000414 "    $@ = $_[0];"
NSQ_SOURCE_LINE 00000415 "    return_undef_from_eval();"
NSQ_SOURCE_LINE 00000416 "  }"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "This means that if you were polite and localized C<$@> you can't die in that"
NSQ_SOURCE_LINE 00000419 "scope, or your error will be discarded (printing \"Something's wrong\" instead)."
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "The workaround is very ugly:"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "  my $error = do {"
NSQ_SOURCE_LINE 00000424 "    local $@;"
NSQ_SOURCE_LINE 00000425 "    eval { ... };"
NSQ_SOURCE_LINE 00000426 "    $@;"
NSQ_SOURCE_LINE 00000427 "  };"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "  ..."
NSQ_SOURCE_LINE 00000430 "  die $error;"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "=head2 $@ might not be a true value"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "This code is wrong:"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "  if ( $@ ) {"
NSQ_SOURCE_LINE 00000437 "    ..."
NSQ_SOURCE_LINE 00000438 "  }"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "because due to the previous caveats it may have been unset."
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "C<$@> could also be an overloaded error object that evaluates to false, but"
NSQ_SOURCE_LINE 00000443 "that's asking for trouble anyway."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "The classic failure mode (fixed in L<Perl 5.14.0|perl5140delta/\"Exception Handling\">) is:"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "  sub Object::DESTROY {"
NSQ_SOURCE_LINE 00000448 "    eval { ... }"
NSQ_SOURCE_LINE 00000449 "  }"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "  eval {"
NSQ_SOURCE_LINE 00000452 "    my $obj = Object->new;"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "    die \"foo\";"
NSQ_SOURCE_LINE 00000455 "  };"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "  if ( $@ ) {"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "  }"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "In this case since C<Object::DESTROY> is not localizing C<$@> but still uses"
NSQ_SOURCE_LINE 00000462 "C<eval>, it will set C<$@> to C<\"\">."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "The destructor is called when the stack is unwound, after C<die> sets C<$@> to"
NSQ_SOURCE_LINE 00000465 "C<\"foo at Foo.pm line 42\\n\">, so by the time C<if ( $@ )> is evaluated it has"
NSQ_SOURCE_LINE 00000466 "been cleared by C<eval> in the destructor."
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "The workaround for this is even uglier than the previous ones. Even though we"
NSQ_SOURCE_LINE 00000469 "can't save the value of C<$@> from code that doesn't localize, we can at least"
NSQ_SOURCE_LINE 00000470 "be sure the C<eval> was aborted due to an error:"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "  my $failed = not eval {"
NSQ_SOURCE_LINE 00000473 "    ..."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "    return 1;"
NSQ_SOURCE_LINE 00000476 "  };"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "This is because an C<eval> that caught a C<die> will always return a false"
NSQ_SOURCE_LINE 00000479 "value."
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "=head1 ALTERNATE SYNTAX"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "Using Perl 5.10 you can use L<perlsyn/\"Switch statements\"> (but please don't,"
NSQ_SOURCE_LINE 00000484 "because that syntax has since been deprecated because there was too much"
NSQ_SOURCE_LINE 00000485 "unexpected magical behaviour)."
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=for stopwords topicalizer"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "The C<catch> block is invoked in a topicalizer context (like a C<given> block),"
NSQ_SOURCE_LINE 00000490 "but note that you can't return a useful value from C<catch> using the C<when>"
NSQ_SOURCE_LINE 00000491 "blocks without an explicit C<return>."
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "This is somewhat similar to Perl 6's C<CATCH> blocks. You can use it to"
NSQ_SOURCE_LINE 00000494 "concisely match errors:"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "  try {"
NSQ_SOURCE_LINE 00000497 "    require Foo;"
NSQ_SOURCE_LINE 00000498 "  } catch {"
NSQ_SOURCE_LINE 00000499 "    when (/^Can't locate .*?\\.pm in \\@INC/) { } # ignore"
NSQ_SOURCE_LINE 00000500 "    default { die $_ }"
NSQ_SOURCE_LINE 00000501 "  };"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=over 4"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "=item *"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "C<@_> is not available within the C<try> block, so you need to copy your"
NSQ_SOURCE_LINE 00000510 "argument list. In case you want to work with argument values directly via C<@_>"
NSQ_SOURCE_LINE 00000511 "aliasing (i.e. allow C<$_[1] = \"foo\">), you need to pass C<@_> by reference:"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "  sub foo {"
NSQ_SOURCE_LINE 00000514 "    my ( $self, @args ) = @_;"
NSQ_SOURCE_LINE 00000515 "    try { $self->bar(@args) }"
NSQ_SOURCE_LINE 00000516 "  }"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "or"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "  sub bar_in_place {"
NSQ_SOURCE_LINE 00000521 "    my $self = shift;"
NSQ_SOURCE_LINE 00000522 "    my $args = \\@_;"
NSQ_SOURCE_LINE 00000523 "    try { $_ = $self->bar($_) for @$args }"
NSQ_SOURCE_LINE 00000524 "  }"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "=item *"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "C<return> returns from the C<try> block, not from the parent sub (note that"
NSQ_SOURCE_LINE 00000529 "this is also how C<eval> works, but not how L<TryCatch> works):"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "  sub parent_sub {"
NSQ_SOURCE_LINE 00000532 "    try {"
NSQ_SOURCE_LINE 00000533 "      die;"
NSQ_SOURCE_LINE 00000534 "    }"
NSQ_SOURCE_LINE 00000535 "    catch {"
NSQ_SOURCE_LINE 00000536 "      return;"
NSQ_SOURCE_LINE 00000537 "    };"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "    say \"this text WILL be displayed, even though an exception is thrown\";"
NSQ_SOURCE_LINE 00000540 "  }"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "Instead, you should capture the return value:"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "  sub parent_sub {"
NSQ_SOURCE_LINE 00000545 "    my $success = try {"
NSQ_SOURCE_LINE 00000546 "      die;"
NSQ_SOURCE_LINE 00000547 "      1;"
NSQ_SOURCE_LINE 00000548 "    };"
NSQ_SOURCE_LINE 00000549 "    return unless $success;"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "    say \"This text WILL NEVER appear!\";"
NSQ_SOURCE_LINE 00000552 "  }"
NSQ_SOURCE_LINE 00000553 "  # OR"
NSQ_SOURCE_LINE 00000554 "  sub parent_sub_with_catch {"
NSQ_SOURCE_LINE 00000555 "    my $success = try {"
NSQ_SOURCE_LINE 00000556 "      die;"
NSQ_SOURCE_LINE 00000557 "      1;"
NSQ_SOURCE_LINE 00000558 "    }"
NSQ_SOURCE_LINE 00000559 "    catch {"
NSQ_SOURCE_LINE 00000560 "      # do something with $_"
NSQ_SOURCE_LINE 00000561 "      return undef; #see note"
NSQ_SOURCE_LINE 00000562 "    };"
NSQ_SOURCE_LINE 00000563 "    return unless $success;"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "    say \"This text WILL NEVER appear!\";"
NSQ_SOURCE_LINE 00000566 "  }"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "Note that if you have a C<catch> block, it must return C<undef> for this to work,"
NSQ_SOURCE_LINE 00000569 "since if a C<catch> block exists, its return value is returned in place of C<undef>"
NSQ_SOURCE_LINE 00000570 "when an exception is thrown."
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "=item *"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "C<try> introduces another caller stack frame. L<Sub::Uplevel> is not used. L<Carp>"
NSQ_SOURCE_LINE 00000575 "will not report this when using full stack traces, though, because"
NSQ_SOURCE_LINE 00000576 "C<%Carp::Internal> is used. This lack of magic is considered a feature."
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "=for stopwords unhygienically"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "=item *"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "The value of C<$_> in the C<catch> block is not guaranteed to be the value of"
NSQ_SOURCE_LINE 00000583 "the exception thrown (C<$@>) in the C<try> block.  There is no safe way to"
NSQ_SOURCE_LINE 00000584 "ensure this, since C<eval> may be used unhygienically in destructors.  The only"
NSQ_SOURCE_LINE 00000585 "guarantee is that the C<catch> will be called if an exception is thrown."
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "=item *"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "The return value of the C<catch> block is not ignored, so if testing the result"
NSQ_SOURCE_LINE 00000590 "of the expression for truth on success, be sure to return a false value from"
NSQ_SOURCE_LINE 00000591 "the C<catch> block:"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "  my $obj = try {"
NSQ_SOURCE_LINE 00000594 "    MightFail->new;"
NSQ_SOURCE_LINE 00000595 "  } catch {"
NSQ_SOURCE_LINE 00000596 "    ..."
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "    return; # avoid returning a true value;"
NSQ_SOURCE_LINE 00000599 "  };"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "  return unless $obj;"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "=item *"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "C<$SIG{__DIE__}> is still in effect."
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "Though it can be argued that C<$SIG{__DIE__}> should be disabled inside of"
NSQ_SOURCE_LINE 00000608 "C<eval> blocks, since it isn't people have grown to rely on it. Therefore in"
NSQ_SOURCE_LINE 00000609 "the interests of compatibility, C<try> does not disable C<$SIG{__DIE__}> for"
NSQ_SOURCE_LINE 00000610 "the scope of the error throwing code."
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "=item *"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "Lexical C<$_> may override the one set by C<catch>."
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "For example Perl 5.10's C<given> form uses a lexical C<$_>, creating some"
NSQ_SOURCE_LINE 00000617 "confusing behavior:"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "  given ($foo) {"
NSQ_SOURCE_LINE 00000620 "    when (...) {"
NSQ_SOURCE_LINE 00000621 "      try {"
NSQ_SOURCE_LINE 00000622 "        ..."
NSQ_SOURCE_LINE 00000623 "      } catch {"
NSQ_SOURCE_LINE 00000624 "        warn $_; # will print $foo, not the error"
NSQ_SOURCE_LINE 00000625 "        warn $_[0]; # instead, get the error like this"
NSQ_SOURCE_LINE 00000626 "      }"
NSQ_SOURCE_LINE 00000627 "    }"
NSQ_SOURCE_LINE 00000628 "  }"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "Note that this behavior was changed once again in"
NSQ_SOURCE_LINE 00000631 "L<Perl5 version 18|https://metacpan.org/module/perldelta#given-now-aliases-the-global-_>."
NSQ_SOURCE_LINE 00000632 "However, since the entirety of lexical C<$_> is now L<considered experimental"
NSQ_SOURCE_LINE 00000633 "|https://metacpan.org/module/perldelta#Lexical-_-is-now-experimental>, it"
NSQ_SOURCE_LINE 00000634 "is unclear whether the new version 18 behavior is final."
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "=back"
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "=over 4"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "=item L<Syntax::Keyword::Try>"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "Only available on perls >= 5.14, with a slightly different syntax (e.g. no trailing C<;> because"
NSQ_SOURCE_LINE 00000645 "it's actually a keyword, not a sub, but this means you can C<return> and C<next> within it). Use"
NSQ_SOURCE_LINE 00000646 "L<Feature::Compat::Try> to automatically switch to the native C<try> syntax in newer perls (when"
NSQ_SOURCE_LINE 00000647 "available). See also L<Try Catch Exception Handling|perlsyn/Try-Catch-Exception-Handling>."
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "=item L<TryCatch>"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "Much more feature complete, more convenient semantics, but at the cost of"
NSQ_SOURCE_LINE 00000652 "implementation complexity."
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "=item L<autodie>"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "Automatic error throwing for builtin functions and more. Also designed to"
NSQ_SOURCE_LINE 00000657 "work well with C<given>/C<when>."
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "=item L<Throwable>"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "A lightweight role for rolling your own exception classes."
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "=item L<Error>"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "Exception object implementation with a C<try> statement. Does not localize"
NSQ_SOURCE_LINE 00000666 "C<$@>."
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "=item L<Exception::Class::TryCatch>"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "Provides a C<catch> statement, but properly calling C<eval> is your"
NSQ_SOURCE_LINE 00000671 "responsibility."
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "The C<try> keyword pushes C<$@> onto an error stack, avoiding some of the"
NSQ_SOURCE_LINE 00000674 "issues with C<$@>, but you still need to localize to prevent clobbering."
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "=back"
NSQ_SOURCE_LINE 00000677 ""
