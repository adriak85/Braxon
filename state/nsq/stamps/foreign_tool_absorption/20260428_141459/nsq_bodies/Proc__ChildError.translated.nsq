NSQ_SOURCE_LINE 00000001 "package Proc::ChildError;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2016-01-06'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.04'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "require Exporter;"
NSQ_SOURCE_LINE 00000010 "our @ISA       = qw(Exporter);"
NSQ_SOURCE_LINE 00000011 "our @EXPORT_OK = qw(explain_child_error);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "sub explain_child_error {"
NSQ_SOURCE_LINE 00000014 "    my $opts;"
NSQ_SOURCE_LINE 00000015 "    if (ref($_[0]) eq 'HASH') {"
NSQ_SOURCE_LINE 00000016 "        $opts = shift;"
NSQ_SOURCE_LINE 00000017 "    } else {"
NSQ_SOURCE_LINE 00000018 "        $opts = {};"
NSQ_SOURCE_LINE 00000019 "    }"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "    my ($num, $str);"
NSQ_SOURCE_LINE 00000022 "    if (defined $_[0]) {"
NSQ_SOURCE_LINE 00000023 "        $num = $_[0];"
NSQ_SOURCE_LINE 00000024 "        $str = $_[1];"
NSQ_SOURCE_LINE 00000025 "    } else {"
NSQ_SOURCE_LINE 00000026 "        $num = $?;"
NSQ_SOURCE_LINE 00000027 "        $str = $!;"
NSQ_SOURCE_LINE 00000028 "    }"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    my $prefix = \"\";"
NSQ_SOURCE_LINE 00000031 "    if (defined $opts->{prog}) {"
NSQ_SOURCE_LINE 00000032 "        $prefix = \"$opts->{prog} \";"
NSQ_SOURCE_LINE 00000033 "    }"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    if ($num == -1) {"
NSQ_SOURCE_LINE 00000036 "        return \"${prefix}failed to execute: \".($str ? \"$str \":\"\").\"($num)\";"
NSQ_SOURCE_LINE 00000037 "    } elsif ($num & 127) {"
NSQ_SOURCE_LINE 00000038 "        return sprintf("
NSQ_SOURCE_LINE 00000039 "            \"${prefix}died with signal %d, %s coredump\","
NSQ_SOURCE_LINE 00000040 "            ($num & 127),"
NSQ_SOURCE_LINE 00000041 "            (($num & 128) ? 'with' : 'without'));"
NSQ_SOURCE_LINE 00000042 "    } else {"
NSQ_SOURCE_LINE 00000043 "        return sprintf(\"${prefix}exited with code %d\", $num >> 8);"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 "}"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "1;"
NSQ_SOURCE_LINE 00000048 "# ABSTRACT: Explain process child error"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "__END__"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=pod"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=head1 NAME"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "Proc::ChildError - Explain process child error"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=head1 VERSION"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "This document describes version 0.04 of Proc::ChildError (from Perl distribution Proc-ChildError), released on 2016-01-06."
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=head2 explain_child_error([\\%opts, ]$child_error, $os_error) => STR"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "Produce a string description of an error number. C<$child_error> defaults to"
NSQ_SOURCE_LINE 00000069 "C<$?> if not specified. C<$os_error> defaults to C<$!> if not specified."
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "The algorithm is taken from perldoc -f system. Some sample output:"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 " failed to execute: No such file or directory (-1)"
NSQ_SOURCE_LINE 00000074 " died with signal 15, with coredump"
NSQ_SOURCE_LINE 00000075 " exited with value 3"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "An options hashref can be specified as the first argument to add information."
NSQ_SOURCE_LINE 00000078 "Currently known keys:"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=over"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=item * prog => str"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "Program name/path, to include in error messages:"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 " /usr/bin/foo failed to execute: Permission denied (-1)"
NSQ_SOURCE_LINE 00000087 " foo died with signal 15, with coredump"
NSQ_SOURCE_LINE 00000088 " /usr/bin/foo exited with value 3"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "=back"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "L<Process::Status> provides a lightweight OO interface for C<$?>. I recommend"
NSQ_SOURCE_LINE 00000095 "this module now over Proc::ChildError."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "L<IPC::System::Simple> provides a replacement for Perl's C<system()>, with the"
NSQ_SOURCE_LINE 00000098 "difference that it will print a diagnostic error message similar to what"
NSQ_SOURCE_LINE 00000099 "C<Proc::ChildError> provides. You only need to do C<use IPC::System::Simple"
NSQ_SOURCE_LINE 00000100 "qw(system)> and use C<system()> as usual. Recommended."
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "Please visit the project's homepage at L<https://metacpan.org/release/Proc-ChildError>."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "Source repository is at L<https://github.com/perlancar/perl-Proc-ChildError>."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=head1 BUGS"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=Proc-ChildError>"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000115 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000116 "feature."
