NSQ_SOURCE_LINE 00000257 "=head1 NAME"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "App::ShellCompleter::cpanm - Shell completion for cpanm"
NSQ_SOURCE_LINE 00000260 ""
