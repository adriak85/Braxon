BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package App::ShellCompleter::cpanm;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Log::ger;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Complete::File qw(complete_file);"
NSQ_SOURCE_LINE 00000009 "use Complete::Util qw(answer_has_entries complete_array_elem);"
NSQ_SOURCE_LINE 00000010 "use Getopt::Long::Complete qw(GetOptionsWithCompletion);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000013 "our $DATE = '2023-07-08'; # DATE"
NSQ_SOURCE_LINE 00000014 "our $DIST = 'App-ShellCompleter-cpanm'; # DIST"
NSQ_SOURCE_LINE 00000015 "our $VERSION = '0.212'; # VERSION"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "my $noop = sub {};"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "# complete with list of installed modules"
NSQ_SOURCE_LINE 00000020 "my $comp_installed_mods = sub {"
NSQ_SOURCE_LINE 00000021 "    require Complete::Module;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    my %args = @_;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    log_trace(\"[_cpanm] Adding completion: installed modules\");"
NSQ_SOURCE_LINE 00000026 "    Complete::Module::complete_module("
NSQ_SOURCE_LINE 00000027 "        word => $args{word},"
NSQ_SOURCE_LINE 00000028 "        path_sep => '::',"
NSQ_SOURCE_LINE 00000029 "    );"
NSQ_SOURCE_LINE 00000030 "};"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "# complete with installable stuff"
NSQ_SOURCE_LINE 00000033 "my $comp_installable = sub {"
NSQ_SOURCE_LINE 00000034 "    my %args = @_;"
NSQ_SOURCE_LINE 00000035 "    my $word   = $args{word} // '';"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    # try completing script name if we are in SCRIPT_MODE"
NSQ_SOURCE_LINE 00000038 "    {"
NSQ_SOURCE_LINE 00000039 "        last unless $ENV{SCRIPT_MODE};"
NSQ_SOURCE_LINE 00000040 "        last unless $word eq '' || $word =~ /\\A\\w[\\w-]*\\z/;"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "        my $dbh = _connect_lcpan() or last;"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "        my $sth;"
NSQ_SOURCE_LINE 00000045 "        $sth = $dbh->prepare("
NSQ_SOURCE_LINE 00000046 "            \"SELECT name FROM script WHERE name LIKE '$word%' ORDER BY name\");"
NSQ_SOURCE_LINE 00000047 "        $sth->execute;"
NSQ_SOURCE_LINE 00000048 "        my @scripts;"
NSQ_SOURCE_LINE 00000049 "        my %seen;"
NSQ_SOURCE_LINE 00000050 "        while (my @row = $sth->fetchrow_array) {"
NSQ_SOURCE_LINE 00000051 "            my $script = $row[0];"
NSQ_SOURCE_LINE 00000052 "            push @scripts, $script unless $seen{$script}++;"
NSQ_SOURCE_LINE 00000053 "        }"
NSQ_SOURCE_LINE 00000054 "        return \\@scripts if @scripts;"
NSQ_SOURCE_LINE 00000055 "    }"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    # first, we try the cheapest method first, which is local files"
NSQ_SOURCE_LINE 00000058 "    {"
NSQ_SOURCE_LINE 00000059 "        log_trace(\"[_cpanm] Trying completion: tarballs & dirs\");"
NSQ_SOURCE_LINE 00000060 "        local $Complete::Common::OPT_FUZZY = 0;"
NSQ_SOURCE_LINE 00000061 "        local $Complete::Common::OPT_WORD_MODE = 0;"
NSQ_SOURCE_LINE 00000062 "        local $Complete::Common::OPT_CHAR_MODE = 0;"
NSQ_SOURCE_LINE 00000063 "        my $answer = complete_file("
NSQ_SOURCE_LINE 00000064 "            filter => sub { log_trace(\"  $_\"); /\\.(zip|tar\\.gz|tar\\.bz2)$/i || (-d $_) },"
NSQ_SOURCE_LINE 00000065 "            word   => $word,"
NSQ_SOURCE_LINE 00000066 "        );"
NSQ_SOURCE_LINE 00000067 "    }"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    # if that fails, and the word looks like the start of module name, try"
NSQ_SOURCE_LINE 00000070 "    # searching for CPAN module. currently we only query local CPAN for speed."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "    # if user already types something that looks like a path instead of module"
NSQ_SOURCE_LINE 00000073 "    # name, like '../' or perhaps 'C:\\' (windows) then don't bother to complete"
NSQ_SOURCE_LINE 00000074 "    # with module name because it will just delay things without getting any"
NSQ_SOURCE_LINE 00000075 "    # result."
NSQ_SOURCE_LINE 00000076 "    {"
NSQ_SOURCE_LINE 00000077 "        last unless $word eq '' || $word =~ /\\A(\\w+)(::\\w+)*(::)?\\z/;"
NSQ_SOURCE_LINE 00000078 "        use experimental 'smartmatch';"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "        my $dbh = _connect_lcpan() or last;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "        my $sth;"
NSQ_SOURCE_LINE 00000083 "        my $mod_prefix = $args{mod_prefix} // '';"
NSQ_SOURCE_LINE 00000084 "        my $prefixed_word = \"$mod_prefix$word\";"
NSQ_SOURCE_LINE 00000085 "        my $num_sep = 0; while ($prefixed_word =~ /::/g) { $num_sep++ }"
NSQ_SOURCE_LINE 00000086 "        if ($prefixed_word eq '') {"
NSQ_SOURCE_LINE 00000087 "            $sth = $dbh->prepare(\"SELECT name,has_child FROM namespace WHERE name='' AND num_sep=0 ORDER BY name\");"
NSQ_SOURCE_LINE 00000088 "        } else {"
NSQ_SOURCE_LINE 00000089 "            $sth = $dbh->prepare(\"SELECT name,has_child FROM namespace WHERE name LIKE '$prefixed_word%' AND num_sep=$num_sep ORDER BY name\");"
NSQ_SOURCE_LINE 00000090 "        }"
NSQ_SOURCE_LINE 00000091 "        $sth->execute;"
NSQ_SOURCE_LINE 00000092 "        my @mods;"
NSQ_SOURCE_LINE 00000093 "        while (my @row = $sth->fetchrow_array) {"
NSQ_SOURCE_LINE 00000094 "            my $mod = $row[0];"
NSQ_SOURCE_LINE 00000095 "            $mod =~ s/\\A\\Q$mod_prefix\\E//;"
NSQ_SOURCE_LINE 00000096 "            push @mods, $mod unless grep { $_ eq $mod } @mods;"
NSQ_SOURCE_LINE 00000097 "            if ($row[1]) {"
NSQ_SOURCE_LINE 00000098 "                $mod .= '::';"
NSQ_SOURCE_LINE 00000099 "                push @mods, $mod unless grep { $_ eq $mod } @mods;"
NSQ_SOURCE_LINE 00000100 "            }"
NSQ_SOURCE_LINE 00000101 "        };"
NSQ_SOURCE_LINE 00000102 "        return \\@mods if @mods;"
NSQ_SOURCE_LINE 00000103 "    }"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    # TODO module name can be suffixed with '@<version>'"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    [];"
NSQ_SOURCE_LINE 00000108 "};"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "sub _connect_lcpan {"
NSQ_SOURCE_LINE 00000111 "    no warnings 'once';"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "    eval \"use App::lcpan 0.32\"; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000114 "    if ($@) {"
NSQ_SOURCE_LINE 00000115 "        log_trace(\"[_cpanm] App::lcpan not available, skipped \"."
NSQ_SOURCE_LINE 00000116 "                         \"trying to complete from CPAN module names\");"
NSQ_SOURCE_LINE 00000117 "        return;"
NSQ_SOURCE_LINE 00000118 "    }"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "    require Perinci::CmdLine::Util::Config;"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    my %lcpanargs;"
NSQ_SOURCE_LINE 00000123 "    my $res = Perinci::CmdLine::Util::Config::read_config("
NSQ_SOURCE_LINE 00000124 "        program_name => \"lcpan\","
NSQ_SOURCE_LINE 00000125 "    );"
NSQ_SOURCE_LINE 00000126 "    unless ($res->[0] == 200) {"
NSQ_SOURCE_LINE 00000127 "        log_trace(\"[_cpanm] Can't get config for lcpan: %s\", $res);"
NSQ_SOURCE_LINE 00000128 "        last;"
NSQ_SOURCE_LINE 00000129 "    }"
NSQ_SOURCE_LINE 00000130 "    my $config = $res->[2];"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    $res = Perinci::CmdLine::Util::Config::get_args_from_config("
NSQ_SOURCE_LINE 00000133 "        config => $config,"
NSQ_SOURCE_LINE 00000134 "        args   => \\%lcpanargs,"
NSQ_SOURCE_LINE 00000135 "        #subcommand_name => 'update',"
NSQ_SOURCE_LINE 00000136 "        meta   => $App::lcpan::SPEC{update},"
NSQ_SOURCE_LINE 00000137 "    );"
NSQ_SOURCE_LINE 00000138 "    unless ($res->[0] == 200) {"
NSQ_SOURCE_LINE 00000139 "        log_trace(\"[_cpanm] Can't get args from config: %s\", $res);"
NSQ_SOURCE_LINE 00000140 "        return;"
NSQ_SOURCE_LINE 00000141 "    }"
NSQ_SOURCE_LINE 00000142 "    App::lcpan::_set_args_default(\\%lcpanargs);"
NSQ_SOURCE_LINE 00000143 "    my $dbh = App::lcpan::_connect_db('ro', $lcpanargs{cpan}, $lcpanargs{index_name});"
NSQ_SOURCE_LINE 00000144 "}"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "sub run_completer {"
NSQ_SOURCE_LINE 00000147 "    my %cargs = @_;"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    die \"This script is for shell completion only\\n\""
NSQ_SOURCE_LINE 00000150 "        unless $ENV{GETOPT_LONG_DUMP} || $ENV{COMP_LINE} || $ENV{COMMAND_LINE};"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    # the list of options is taken from Menlo::CLI:Compat. should be updated"
NSQ_SOURCE_LINE 00000153 "    # from time to time."
NSQ_SOURCE_LINE 00000154 "    GetOptionsWithCompletion("
NSQ_SOURCE_LINE 00000155 "        sub {"
NSQ_SOURCE_LINE 00000156 "            my %args  = @_;"
NSQ_SOURCE_LINE 00000157 "            my $type      = $args{type};"
NSQ_SOURCE_LINE 00000158 "            my $word      = $args{word};"
NSQ_SOURCE_LINE 00000159 "            if ($type eq 'arg') {"
NSQ_SOURCE_LINE 00000160 "                log_trace(\"[_cpanm] Completing arg\");"
NSQ_SOURCE_LINE 00000161 "                my $seen_opts = $args{seen_opts};"
NSQ_SOURCE_LINE 00000162 "                if ($seen_opts->{'--uninstall'} || $seen_opts->{'--reinstall'}) {"
NSQ_SOURCE_LINE 00000163 "                    return $comp_installed_mods->(word=>$word);"
NSQ_SOURCE_LINE 00000164 "                } else {"
NSQ_SOURCE_LINE 00000165 "                    return $comp_installable->("
NSQ_SOURCE_LINE 00000166 "                        mod_prefix => $cargs{mod_prefix},"
NSQ_SOURCE_LINE 00000167 "                        word=>$word, mirror=>$seen_opts->{'--mirror'});"
NSQ_SOURCE_LINE 00000168 "                }"
NSQ_SOURCE_LINE 00000169 "            } elsif ($type eq 'optval') {"
NSQ_SOURCE_LINE 00000170 "                my $ospec = $args{ospec};"
NSQ_SOURCE_LINE 00000171 "                my $opt   = $args{opt};"
NSQ_SOURCE_LINE 00000172 "                log_trace(\"[_cpanm] Completing optval (opt=$opt)\");"
NSQ_SOURCE_LINE 00000173 "                if ($ospec eq 'l|local-lib=s' ||"
NSQ_SOURCE_LINE 00000174 "                        $ospec eq 'L|local-lib-contained=s') {"
NSQ_SOURCE_LINE 00000175 "                    return complete_file(filter=>'d', word=>$word);"
NSQ_SOURCE_LINE 00000176 "                } elsif ($ospec eq 'format=s') {"
NSQ_SOURCE_LINE 00000177 "                    return complete_array_elem("
NSQ_SOURCE_LINE 00000178 "                        array=>[qw/tree json yaml dists/], word=>$word);"
NSQ_SOURCE_LINE 00000179 "                } elsif ($ospec eq 'cpanfile=s') {"
NSQ_SOURCE_LINE 00000180 "                    return complete_file(word=>$word);"
NSQ_SOURCE_LINE 00000181 "                }"
NSQ_SOURCE_LINE 00000182 "            }"
NSQ_SOURCE_LINE 00000183 "            return [];"
NSQ_SOURCE_LINE 00000184 "        },"
NSQ_SOURCE_LINE 00000185 "        'f|force'   => $noop,"
NSQ_SOURCE_LINE 00000186 "        'n|notest!' => $noop,"
NSQ_SOURCE_LINE 00000187 "        'test-only' => $noop,"
NSQ_SOURCE_LINE 00000188 "        'S|sudo!'   => $noop,"
NSQ_SOURCE_LINE 00000189 "        'v|verbose' => $noop,"
NSQ_SOURCE_LINE 00000190 "        'verify!'   => $noop,"
NSQ_SOURCE_LINE 00000191 "        'q|quiet!'  => $noop,"
NSQ_SOURCE_LINE 00000192 "        'h|help'    => $noop,"
NSQ_SOURCE_LINE 00000193 "        'V|version' => $noop,"
NSQ_SOURCE_LINE 00000194 "        'perl=s'          => $noop,"
NSQ_SOURCE_LINE 00000195 "        'l|local-lib=s'   => $noop,"
NSQ_SOURCE_LINE 00000196 "        'L|local-lib-contained=s' => $noop,"
NSQ_SOURCE_LINE 00000197 "        'self-contained!' => $noop,"
NSQ_SOURCE_LINE 00000198 "        'exclude-vendor!' => $noop,"
NSQ_SOURCE_LINE 00000199 "        'mirror=s@'       => $noop,"
NSQ_SOURCE_LINE 00000200 "        'mirror-only!'    => $noop,"
NSQ_SOURCE_LINE 00000201 "        'mirror-index=s'  => $noop,"
NSQ_SOURCE_LINE 00000202 "        'M|from=s'        => $noop, # url (this is --mirror and --mirror-only combined)"
NSQ_SOURCE_LINE 00000203 "        'cpanmetadb=s'    => $noop,"
NSQ_SOURCE_LINE 00000204 "        'cascade-search!' => $noop,"
NSQ_SOURCE_LINE 00000205 "        'prompt!'         => $noop,"
NSQ_SOURCE_LINE 00000206 "        'installdeps'     => $noop,"
NSQ_SOURCE_LINE 00000207 "        'skip-installed!' => $noop,"
NSQ_SOURCE_LINE 00000208 "        'skip-satisfied!' => $noop,"
NSQ_SOURCE_LINE 00000209 "        'reinstall'       => $noop,"
NSQ_SOURCE_LINE 00000210 "        'interactive!'    => $noop,"
NSQ_SOURCE_LINE 00000211 "        'i|install'       => $noop,"
NSQ_SOURCE_LINE 00000212 "        'info'            => $noop,"
NSQ_SOURCE_LINE 00000213 "        'look'            => $noop,"
NSQ_SOURCE_LINE 00000214 "        'U|uninstall'     => $noop,"
NSQ_SOURCE_LINE 00000215 "        'self-upgrade'    => $noop,"
NSQ_SOURCE_LINE 00000216 "        'uninst-shadows!' => $noop,"
NSQ_SOURCE_LINE 00000217 "        'lwp!'    => $noop,"
NSQ_SOURCE_LINE 00000218 "        'wget!'   => $noop,"
NSQ_SOURCE_LINE 00000219 "        'curl!'   => $noop,"
NSQ_SOURCE_LINE 00000220 "        'auto-cleanup=s' => $noop,"
NSQ_SOURCE_LINE 00000221 "        'man-pages!' => $noop,"
NSQ_SOURCE_LINE 00000222 "        'scandeps'   => $noop,"
NSQ_SOURCE_LINE 00000223 "        'showdeps'   => $noop,"
NSQ_SOURCE_LINE 00000224 "        'format=s'   => $noop,"
NSQ_SOURCE_LINE 00000225 "        'save-dists=s' => $noop,"
NSQ_SOURCE_LINE 00000226 "        'skip-configure!' => $noop,"
NSQ_SOURCE_LINE 00000227 "        'static-install!' => $noop,"
NSQ_SOURCE_LINE 00000228 "        'dev!'       => $noop,"
NSQ_SOURCE_LINE 00000229 "        'metacpan!'  => $noop,"
NSQ_SOURCE_LINE 00000230 "        'report-perl-version!' => $noop,"
NSQ_SOURCE_LINE 00000231 "        'configure-timeout=i' => $noop,"
NSQ_SOURCE_LINE 00000232 "        'build-timeout=i' => $noop,"
NSQ_SOURCE_LINE 00000233 "        'test-timeout=i' => $noop,"
NSQ_SOURCE_LINE 00000234 "        'with-develop' => $noop,"
NSQ_SOURCE_LINE 00000235 "        'without-develop' => $noop,"
NSQ_SOURCE_LINE 00000236 "        'with-configure' => $noop,"
NSQ_SOURCE_LINE 00000237 "        'without-configure' => $noop,"
NSQ_SOURCE_LINE 00000238 "        'with-feature=s' => $noop,"
NSQ_SOURCE_LINE 00000239 "        'without-feature=s' => $noop,"
NSQ_SOURCE_LINE 00000240 "        'with-all-features' => $noop,"
NSQ_SOURCE_LINE 00000241 "        'pp|pureperl!' => $noop,"
NSQ_SOURCE_LINE 00000242 "        \"cpanfile=s\" => $noop,"
NSQ_SOURCE_LINE 00000243 "        #$self->install_type_handlers,"
NSQ_SOURCE_LINE 00000244 "        #$self->build_args_handlers,"
NSQ_SOURCE_LINE 00000245 "    );"
NSQ_SOURCE_LINE 00000246 "}"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "1;"
