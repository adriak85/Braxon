BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 "package Class::Method::Modifiers; # git description: v2.14-6-gede37cf"
NSQ_SOURCE_LINE 00000004 "# ABSTRACT: Provides Moose-like method modifiers"
NSQ_SOURCE_LINE 00000005 "# KEYWORDS: method wrap modification patch"
NSQ_SOURCE_LINE 00000006 "# vim: set ts=8 sts=4 sw=4 tw=115 et :"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '2.15';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our @EXPORT = qw(before after around);"
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = (@EXPORT, qw(fresh install_modifier));"
NSQ_SOURCE_LINE 00000014 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000015 "    moose => [qw(before after around)],"
NSQ_SOURCE_LINE 00000016 "    all   => \\@EXPORT_OK,"
NSQ_SOURCE_LINE 00000017 ");"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "BEGIN {"
NSQ_SOURCE_LINE 00000020 "  *_HAS_READONLY = $] >= 5.008 ? sub(){1} : sub(){0};"
NSQ_SOURCE_LINE 00000021 "}"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "our %MODIFIER_CACHE;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "# for backward compatibility"
NSQ_SOURCE_LINE 00000026 "sub _install_modifier; # -w"
NSQ_SOURCE_LINE 00000027 "*_install_modifier = \\&install_modifier;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub install_modifier {"
NSQ_SOURCE_LINE 00000030 "    my $into  = shift;"
NSQ_SOURCE_LINE 00000031 "    my $type  = shift;"
NSQ_SOURCE_LINE 00000032 "    my $code  = pop;"
NSQ_SOURCE_LINE 00000033 "    my @names = @_;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    @names = @{ $names[0] } if ref($names[0]) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    return _fresh($into, $code, @names) if $type eq 'fresh';"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    for my $name (@names) {"
NSQ_SOURCE_LINE 00000040 "        my $hit = $into->can($name) or do {"
NSQ_SOURCE_LINE 00000041 "            require Carp;"
NSQ_SOURCE_LINE 00000042 "            Carp::confess(\"The method '$name' is not found in the inheritance hierarchy for class $into\");"
NSQ_SOURCE_LINE 00000043 "        };"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "        my $qualified = $into.'::'.$name;"
NSQ_SOURCE_LINE 00000046 "        my $cache = $MODIFIER_CACHE{$into}{$name} ||= {"
NSQ_SOURCE_LINE 00000047 "            before => [],"
NSQ_SOURCE_LINE 00000048 "            after  => [],"
NSQ_SOURCE_LINE 00000049 "            around => [],"
NSQ_SOURCE_LINE 00000050 "        };"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "        # this must be the first modifier we're installing"
NSQ_SOURCE_LINE 00000053 "        if (!exists($cache->{\"orig\"})) {"
NSQ_SOURCE_LINE 00000054 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "            # grab the original method (or undef if the method is inherited)"
NSQ_SOURCE_LINE 00000057 "            $cache->{\"orig\"} = *{$qualified}{CODE};"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "            # the \"innermost\" method, the one that \"around\" will ultimately wrap"
NSQ_SOURCE_LINE 00000060 "            $cache->{\"wrapped\"} = $cache->{\"orig\"} || $hit; #sub {"
NSQ_SOURCE_LINE 00000061 "            #    # we can't cache this, because new methods or modifiers may be"
NSQ_SOURCE_LINE 00000062 "            #    # added between now and when this method is called"
NSQ_SOURCE_LINE 00000063 "            #    for my $package (@{ mro::get_linear_isa($into) }) {"
NSQ_SOURCE_LINE 00000064 "            #        next if $package eq $into;"
NSQ_SOURCE_LINE 00000065 "            #        my $code = *{$package.'::'.$name}{CODE};"
NSQ_SOURCE_LINE 00000066 "            #        goto $code if $code;"
NSQ_SOURCE_LINE 00000067 "            #    }"
NSQ_SOURCE_LINE 00000068 "            #    require Carp;"
NSQ_SOURCE_LINE 00000069 "            #    Carp::confess(\"$qualified\\::$name disappeared?\");"
NSQ_SOURCE_LINE 00000070 "            #};"
NSQ_SOURCE_LINE 00000071 "        }"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "        # keep these lists in the order the modifiers are called"
NSQ_SOURCE_LINE 00000074 "        if ($type eq 'after') {"
NSQ_SOURCE_LINE 00000075 "            push @{ $cache->{$type} }, $code;"
NSQ_SOURCE_LINE 00000076 "        }"
NSQ_SOURCE_LINE 00000077 "        else {"
NSQ_SOURCE_LINE 00000078 "            unshift @{ $cache->{$type} }, $code;"
NSQ_SOURCE_LINE 00000079 "        }"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "        # wrap the method with another layer of around. much simpler than"
NSQ_SOURCE_LINE 00000082 "        # the Moose equivalent. :)"
NSQ_SOURCE_LINE 00000083 "        if ($type eq 'around') {"
NSQ_SOURCE_LINE 00000084 "            my $method = $cache->{wrapped};"
NSQ_SOURCE_LINE 00000085 "            my $attrs = _sub_attrs($code);"
NSQ_SOURCE_LINE 00000086 "            # a bare \"sub :lvalue {...}\" will be parsed as a label and an"
NSQ_SOURCE_LINE 00000087 "            # indirect method call. force it to be treated as an expression"
NSQ_SOURCE_LINE 00000088 "            # using +"
NSQ_SOURCE_LINE 00000089 "            $cache->{wrapped} = eval \"package $into; +sub $attrs { \\$code->(\\$method, \\@_); };\";"
NSQ_SOURCE_LINE 00000090 "        }"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "        # install our new method which dispatches the modifiers, but only"
NSQ_SOURCE_LINE 00000093 "        # if a new type was added"
NSQ_SOURCE_LINE 00000094 "        if (@{ $cache->{$type} } == 1) {"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "            # avoid these hash lookups every method invocation"
NSQ_SOURCE_LINE 00000097 "            my $before  = $cache->{\"before\"};"
NSQ_SOURCE_LINE 00000098 "            my $after   = $cache->{\"after\"};"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "            # this is a coderef that changes every new \"around\". so we need"
NSQ_SOURCE_LINE 00000101 "            # to take a reference to it. better a deref than a hash lookup"
NSQ_SOURCE_LINE 00000102 "            my $wrapped = \\$cache->{\"wrapped\"};"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "            my $attrs = _sub_attrs($cache->{wrapped});"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "            my $generated = \"package $into;\\n\";"
NSQ_SOURCE_LINE 00000107 "            $generated .= \"sub $name $attrs {\";"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "            # before is easy, it doesn't affect the return value(s)"
NSQ_SOURCE_LINE 00000110 "            if (@$before) {"
NSQ_SOURCE_LINE 00000111 "                $generated .= '"
NSQ_SOURCE_LINE 00000112 "                    for my $method (@$before) {"
NSQ_SOURCE_LINE 00000113 "                        $method->(@_);"
NSQ_SOURCE_LINE 00000114 "                    }"
NSQ_SOURCE_LINE 00000115 "                ';"
NSQ_SOURCE_LINE 00000116 "            }"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "            if (@$after) {"
NSQ_SOURCE_LINE 00000119 "                $generated .= '"
NSQ_SOURCE_LINE 00000120 "                    my $ret;"
NSQ_SOURCE_LINE 00000121 "                    if (wantarray) {"
NSQ_SOURCE_LINE 00000122 "                        $ret = [$$wrapped->(@_)];"
NSQ_SOURCE_LINE 00000123 "                        '.(_HAS_READONLY ? 'Internals::SvREADONLY(@$ret, 1);' : '').'"
NSQ_SOURCE_LINE 00000124 "                    }"
NSQ_SOURCE_LINE 00000125 "                    elsif (defined wantarray) {"
NSQ_SOURCE_LINE 00000126 "                        $ret = \\($$wrapped->(@_));"
NSQ_SOURCE_LINE 00000127 "                    }"
NSQ_SOURCE_LINE 00000128 "                    else {"
NSQ_SOURCE_LINE 00000129 "                        $$wrapped->(@_);"
NSQ_SOURCE_LINE 00000130 "                    }"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "                    for my $method (@$after) {"
NSQ_SOURCE_LINE 00000133 "                        $method->(@_);"
NSQ_SOURCE_LINE 00000134 "                    }"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "                    wantarray ? @$ret : $ret ? $$ret : ();"
NSQ_SOURCE_LINE 00000137 "                '"
NSQ_SOURCE_LINE 00000138 "            }"
NSQ_SOURCE_LINE 00000139 "            else {"
NSQ_SOURCE_LINE 00000140 "                $generated .= '$$wrapped->(@_);';"
NSQ_SOURCE_LINE 00000141 "            }"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "            $generated .= '}';"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000146 "            no warnings 'redefine';"
NSQ_SOURCE_LINE 00000147 "            no warnings 'closure';"
NSQ_SOURCE_LINE 00000148 "            eval $generated;"
NSQ_SOURCE_LINE 00000149 "        };"
NSQ_SOURCE_LINE 00000150 "    }"
NSQ_SOURCE_LINE 00000151 "}"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "sub before {"
NSQ_SOURCE_LINE 00000154 "    _install_modifier(scalar(caller), 'before', @_);"
NSQ_SOURCE_LINE 00000155 "}"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "sub after {"
NSQ_SOURCE_LINE 00000158 "    _install_modifier(scalar(caller), 'after', @_);"
NSQ_SOURCE_LINE 00000159 "}"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "sub around {"
NSQ_SOURCE_LINE 00000162 "    _install_modifier(scalar(caller), 'around', @_);"
NSQ_SOURCE_LINE 00000163 "}"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "sub fresh {"
NSQ_SOURCE_LINE 00000166 "    my $code = pop;"
NSQ_SOURCE_LINE 00000167 "    my @names = @_;"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    @names = @{ $names[0] } if ref($names[0]) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    _fresh(scalar(caller), $code, @names);"
NSQ_SOURCE_LINE 00000172 "}"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "sub _fresh {"
NSQ_SOURCE_LINE 00000175 "    my ($into, $code, @names) = @_;"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    for my $name (@names) {"
NSQ_SOURCE_LINE 00000178 "        if ($name !~ /\\A [a-zA-Z_] [a-zA-Z0-9_]* \\z/xms) {"
NSQ_SOURCE_LINE 00000179 "            require Carp;"
NSQ_SOURCE_LINE 00000180 "            Carp::confess(\"Invalid method name '$name'\");"
NSQ_SOURCE_LINE 00000181 "        }"
NSQ_SOURCE_LINE 00000182 "        if ($into->can($name)) {"
NSQ_SOURCE_LINE 00000183 "            require Carp;"
NSQ_SOURCE_LINE 00000184 "            Carp::confess(\"Class $into already has a method named '$name'\");"
NSQ_SOURCE_LINE 00000185 "        }"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "        # We need to make sure that the installed method has its CvNAME in"
NSQ_SOURCE_LINE 00000188 "        # the appropriate package; otherwise, it would be subject to"
NSQ_SOURCE_LINE 00000189 "        # deletion if callers use namespace::autoclean.  If $code was"
NSQ_SOURCE_LINE 00000190 "        # compiled in the target package, we can just install it directly;"
NSQ_SOURCE_LINE 00000191 "        # otherwise, we'll need a different approach.  Using Sub::Name would"
NSQ_SOURCE_LINE 00000192 "        # be fine in all cases, at the cost of introducing a dependency on"
NSQ_SOURCE_LINE 00000193 "        # an XS-using, non-core module.  So instead we'll use string-eval to"
NSQ_SOURCE_LINE 00000194 "        # create a new subroutine that wraps $code."
NSQ_SOURCE_LINE 00000195 "        if (_is_in_package($code, $into)) {"
NSQ_SOURCE_LINE 00000196 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000197 "            *{\"$into\\::$name\"} = $code;"
NSQ_SOURCE_LINE 00000198 "        }"
NSQ_SOURCE_LINE 00000199 "        else {"
NSQ_SOURCE_LINE 00000200 "            no warnings 'closure'; # for 5.8.x"
NSQ_SOURCE_LINE 00000201 "            my $attrs = _sub_attrs($code);"
NSQ_SOURCE_LINE 00000202 "            eval \"package $into; sub $name $attrs { \\$code->(\\@_) }\";"
NSQ_SOURCE_LINE 00000203 "        }"
NSQ_SOURCE_LINE 00000204 "    }"
NSQ_SOURCE_LINE 00000205 "}"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "sub _sub_attrs {"
NSQ_SOURCE_LINE 00000208 "    my ($coderef) = @_;"
NSQ_SOURCE_LINE 00000209 "    local *_sub = $coderef;"
NSQ_SOURCE_LINE 00000210 "    local $@;"
NSQ_SOURCE_LINE 00000211 "    local $SIG{__DIE__};"
NSQ_SOURCE_LINE 00000212 "    # this assignment will fail to compile if it isn't an lvalue sub.  we"
NSQ_SOURCE_LINE 00000213 "    # never want to actually call the sub though, so we return early."
NSQ_SOURCE_LINE 00000214 "    (eval 'return 1; &_sub = 1') ? ':lvalue' : '';"
NSQ_SOURCE_LINE 00000215 "}"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "sub _is_in_package {"
NSQ_SOURCE_LINE 00000218 "    my ($coderef, $package) = @_;"
NSQ_SOURCE_LINE 00000219 "    require B;"
NSQ_SOURCE_LINE 00000220 "    my $cv = B::svref_2object($coderef);"
NSQ_SOURCE_LINE 00000221 "    return $cv->GV->STASH->NAME eq $package;"
NSQ_SOURCE_LINE 00000222 "}"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "1;"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "__END__"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=pod"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=head1 NAME"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "Class::Method::Modifiers - Provides Moose-like method modifiers"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=head1 VERSION"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "version 2.15"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "    package Child;"
NSQ_SOURCE_LINE 00000243 "    use parent 'MyParent';"
NSQ_SOURCE_LINE 00000244 "    use Class::Method::Modifiers;"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "    sub new_method { }"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "    before 'old_method' => sub {"
NSQ_SOURCE_LINE 00000249 "        carp \"old_method is deprecated, use new_method\";"
NSQ_SOURCE_LINE 00000250 "    };"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    around 'other_method' => sub {"
NSQ_SOURCE_LINE 00000253 "        my $orig = shift;"
NSQ_SOURCE_LINE 00000254 "        my $ret = $orig->(@_);"
NSQ_SOURCE_LINE 00000255 "        return $ret =~ /\\d/ ? $ret : lc $ret;"
NSQ_SOURCE_LINE 00000256 "    };"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "    after 'private', 'protected' => sub {"
NSQ_SOURCE_LINE 00000259 "        debug \"finished calling a dangerous method\";"
NSQ_SOURCE_LINE 00000260 "    };"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "    use Class::Method::Modifiers qw(fresh);"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "    fresh 'not_in_hierarchy' => sub {"
NSQ_SOURCE_LINE 00000265 "        warn \"freshly added method\\n\";"
NSQ_SOURCE_LINE 00000266 "    };"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "=for stopwords CLOS"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "Method modifiers are a convenient feature from the CLOS (Common Lisp Object"
NSQ_SOURCE_LINE 00000273 "System) world."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "In its most basic form, a method modifier is just a method that calls"
NSQ_SOURCE_LINE 00000276 "C<< $self->SUPER::foo(@_) >>. I for one have trouble remembering that exact"
NSQ_SOURCE_LINE 00000277 "invocation, so my classes seldom re-dispatch to their base classes. Very bad!"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "C<Class::Method::Modifiers> provides three modifiers: C<before>, C<around>, and"
NSQ_SOURCE_LINE 00000280 "C<after>. C<before> and C<after> are run just before and after the method they"
NSQ_SOURCE_LINE 00000281 "modify, but can not really affect that original method. C<around> is run in"
NSQ_SOURCE_LINE 00000282 "place of the original method, with a hook to easily call that original method."
NSQ_SOURCE_LINE 00000283 "See the L</MODIFIERS> section for more details on how the particular modifiers"
NSQ_SOURCE_LINE 00000284 "work."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "One clear benefit of using C<Class::Method::Modifiers> is that you can define"
NSQ_SOURCE_LINE 00000287 "multiple modifiers in a single namespace. These separate modifiers don't need"
NSQ_SOURCE_LINE 00000288 "to know about each other. This makes top-down design easy. Have a base class"
NSQ_SOURCE_LINE 00000289 "that provides the skeleton methods of each operation, and have plugins modify"
NSQ_SOURCE_LINE 00000290 "those methods to flesh out the specifics."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "Parent classes need not know about C<Class::Method::Modifiers>. This means you"
NSQ_SOURCE_LINE 00000293 "should be able to modify methods in I<any> subclass. See"
NSQ_SOURCE_LINE 00000294 "L<Term::VT102::ZeroBased> for an example of subclassing with"
NSQ_SOURCE_LINE 00000295 "C<Class::Method::Modifiers>."
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "In short, C<Class::Method::Modifiers> solves the problem of making sure you"
NSQ_SOURCE_LINE 00000298 "call C<< $self->SUPER::foo(@_) >>, and provides a cleaner interface for it."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "As of version 1.00, C<Class::Method::Modifiers> is faster in some cases than"
NSQ_SOURCE_LINE 00000301 "L<Moose>. See F<benchmark/method_modifiers.pl> in the L<Moose> distribution."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "C<Class::Method::Modifiers> also provides an additional \"modifier\" type,"
NSQ_SOURCE_LINE 00000304 "C<fresh>; see below."
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=head1 MODIFIERS"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "All modifiers let you modify one or multiple methods at a time. The names of"
NSQ_SOURCE_LINE 00000309 "multiple methods can be provided as a list or as an array-reference. Examples:"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 " before 'method' => sub { ... };"
NSQ_SOURCE_LINE 00000312 " before 'method1', 'method2' => sub { ... };"
NSQ_SOURCE_LINE 00000313 " before [ 'method1', 'method2' ] => sub { ... };"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "=head2 before method(s) => sub { ... };"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "C<before> is called before the method it is modifying. Its return value is"
NSQ_SOURCE_LINE 00000318 "totally ignored. It receives the same C<@_> as the method it is modifying"
NSQ_SOURCE_LINE 00000319 "would have received. You can modify the C<@_> the original method will receive"
NSQ_SOURCE_LINE 00000320 "by changing C<$_[0]> and friends (or by changing anything inside a reference)."
NSQ_SOURCE_LINE 00000321 "This is a feature!"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=head2 after method(s) => sub { ... };"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "C<after> is called after the method it is modifying. Its return value is"
NSQ_SOURCE_LINE 00000326 "totally ignored. It receives the same C<@_> as the method it is modifying"
NSQ_SOURCE_LINE 00000327 "received, mostly. The original method can modify C<@_> (such as by changing"
NSQ_SOURCE_LINE 00000328 "C<$_[0]> or references) and C<after> will see the modified version. If you"
NSQ_SOURCE_LINE 00000329 "don't like this behavior, specify both a C<before> and C<after>, and copy the"
NSQ_SOURCE_LINE 00000330 "C<@_> during C<before> for C<after> to use."
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=head2 around method(s) => sub { ... };"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "C<around> is called instead of the method it is modifying. The method you're"
NSQ_SOURCE_LINE 00000335 "overriding is passed in as the first argument (called C<$orig> by convention)."
NSQ_SOURCE_LINE 00000336 "Watch out for contextual return values of C<$orig>."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "You can use C<around> to:"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "=over 4"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=item Pass C<$orig> a different C<@_>"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "    around 'method' => sub {"
NSQ_SOURCE_LINE 00000345 "        my $orig = shift;"
NSQ_SOURCE_LINE 00000346 "        my $self = shift;"
NSQ_SOURCE_LINE 00000347 "        $orig->($self, reverse @_);"
NSQ_SOURCE_LINE 00000348 "    };"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "=item Munge the return value of C<$orig>"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "    around 'method' => sub {"
NSQ_SOURCE_LINE 00000353 "        my $orig = shift;"
NSQ_SOURCE_LINE 00000354 "        ucfirst $orig->(@_);"
NSQ_SOURCE_LINE 00000355 "    };"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=item Avoid calling C<$orig> -- conditionally"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "    around 'method' => sub {"
NSQ_SOURCE_LINE 00000360 "        my $orig = shift;"
NSQ_SOURCE_LINE 00000361 "        return $orig->(@_) if time() % 2;"
NSQ_SOURCE_LINE 00000362 "        return \"no dice, captain\";"
NSQ_SOURCE_LINE 00000363 "    };"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "=back"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=head2 fresh method(s) => sub { ... };"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "(Available since version 2.00)"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "Unlike the other modifiers, this does not modify an existing method."
NSQ_SOURCE_LINE 00000372 "Ordinarily, C<fresh> merely installs the coderef as a method in the"
NSQ_SOURCE_LINE 00000373 "appropriate class; but if the class hierarchy already contains a method of"
NSQ_SOURCE_LINE 00000374 "the same name, an exception is thrown.  The idea of this \"modifier\" is to"
NSQ_SOURCE_LINE 00000375 "increase safety when subclassing.  Suppose you're writing a subclass of a"
NSQ_SOURCE_LINE 00000376 "class Some::Base, and adding a new method:"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "    package My::Subclass;"
NSQ_SOURCE_LINE 00000379 "    use base 'Some::Base';"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "    sub foo { ... }"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "If a later version of Some::Base also adds a new method named C<foo>, your"
NSQ_SOURCE_LINE 00000384 "method will shadow that method.  Alternatively, you can use C<fresh>"
NSQ_SOURCE_LINE 00000385 "to install the additional method into your subclass:"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "    package My::Subclass;"
NSQ_SOURCE_LINE 00000388 "    use base 'Some::Base';"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "    use Class::Method::Modifiers 'fresh';"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "    fresh 'foo' => sub { ... };"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "Now upgrading Some::Base to a version with a conflicting C<foo> method will"
NSQ_SOURCE_LINE 00000395 "cause an exception to be thrown; seeing that error will give you the"
NSQ_SOURCE_LINE 00000396 "opportunity to fix the problem (perhaps by picking a different method name"
NSQ_SOURCE_LINE 00000397 "in your subclass, or similar)."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "Creating fresh methods with C<install_modifier> (see below) provides a way"
NSQ_SOURCE_LINE 00000400 "to get similar safety benefits when adding local monkeypatches to existing"
NSQ_SOURCE_LINE 00000401 "classes; see L<http://aaroncrane.co.uk/talks/monkey_patching_subclassing/>."
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "For API compatibility reasons, this function is exported only when you ask"
NSQ_SOURCE_LINE 00000404 "for it specifically, or for C<:all>."
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "=head2 install_modifier $package, $type, @names, sub { ... }"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "C<install_modifier> is like C<before>, C<after>, C<around>, and C<fresh> but"
NSQ_SOURCE_LINE 00000409 "it also lets you dynamically select the modifier type ('before', 'after',"
NSQ_SOURCE_LINE 00000410 "'around', 'fresh')"
NSQ_SOURCE_LINE 00000411 "and package that the method modifiers are installed into. This expert-level"
NSQ_SOURCE_LINE 00000412 "function is exported only when you ask for it specifically, or for C<:all>."
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "=head1 NOTES"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "All three normal modifiers; C<before>, C<after>, and C<around>; are exported"
NSQ_SOURCE_LINE 00000417 "into your namespace by default. You may C<use Class::Method::Modifiers ()> to"
NSQ_SOURCE_LINE 00000418 "avoid modifying your namespace. I may steal more features from L<Moose>, namely"
NSQ_SOURCE_LINE 00000419 "C<super>, C<override>, C<inner>, C<augment>, and whatever the L<Moose> folks"
NSQ_SOURCE_LINE 00000420 "come up with next."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "Note that the syntax and semantics for these modifiers is directly borrowed"
NSQ_SOURCE_LINE 00000423 "from L<Moose> (the implementations, however, are not)."
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "L<Class::Trigger> shares a few similarities with C<Class::Method::Modifiers>,"
NSQ_SOURCE_LINE 00000426 "and they even have some overlap in purpose -- both can be used to implement"
NSQ_SOURCE_LINE 00000427 "highly pluggable applications. The difference is that L<Class::Trigger>"
NSQ_SOURCE_LINE 00000428 "provides a mechanism for easily letting parent classes to invoke hooks defined"
NSQ_SOURCE_LINE 00000429 "by other code. C<Class::Method::Modifiers> provides a way of"
NSQ_SOURCE_LINE 00000430 "overriding/augmenting methods safely, and the parent class need not know about"
NSQ_SOURCE_LINE 00000431 "it."
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=head2 :lvalue METHODS"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "When adding C<before> or C<after> modifiers, the wrapper method will be"
NSQ_SOURCE_LINE 00000436 "an lvalue method if the wrapped sub is, and assigning to the method"
NSQ_SOURCE_LINE 00000437 "will propagate to the wrapped method as expected.  For C<around>"
NSQ_SOURCE_LINE 00000438 "modifiers, it is the modifier sub that determines if the wrapper"
NSQ_SOURCE_LINE 00000439 "method is an lvalue method."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "It is erroneous to modify a method that doesn't exist in your class's"
NSQ_SOURCE_LINE 00000444 "inheritance hierarchy. If this occurs, an exception will be thrown when"
NSQ_SOURCE_LINE 00000445 "the modifier is defined."
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "It doesn't yet play well with C<caller>. There are some C<TODO> tests for this."
NSQ_SOURCE_LINE 00000448 "Don't get your hopes up though!"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "Applying modifiers to array lvalue methods is not fully supported. Attempting"
NSQ_SOURCE_LINE 00000451 "to assign to an array lvalue method that has an C<after> modifier applied will"
NSQ_SOURCE_LINE 00000452 "result in an error.  Array lvalue methods are not well supported by perl in"
NSQ_SOURCE_LINE 00000453 "general, and should be avoided."
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=head1 MAJOR VERSION CHANGES"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "=for stopwords reimplementation"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "This module was bumped to 1.00 following a complete reimplementation, to"
NSQ_SOURCE_LINE 00000460 "indicate breaking backwards compatibility. The \"guard\" modifier was removed,"
NSQ_SOURCE_LINE 00000461 "and the internals are completely different."
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "The new version is a few times faster with half the code. It's now even faster"
NSQ_SOURCE_LINE 00000464 "than Moose."
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "Any code that just used modifiers should not change in behavior, except to"
NSQ_SOURCE_LINE 00000467 "become more correct. And, of course, faster. :)"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=head1 SEE ALSO"
