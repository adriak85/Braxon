BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Regexp::IPv6;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $VERSION = '0.03';"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "require Exporter;"
NSQ_SOURCE_LINE 00000009 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000010 "our @EXPORT_OK = qw($IPv6_re);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "my $IPv4 = \"((25[0-5]|2[0-4][0-9]|[0-1]?[0-9]{1,2})[.](25[0-5]|2[0-4][0-9]|[0-1]?[0-9]{1,2})[.](25[0-5]|2[0-4][0-9]|[0-1]?[0-9]{1,2})[.](25[0-5]|2[0-4][0-9]|[0-1]?[0-9]{1,2}))\";"
NSQ_SOURCE_LINE 00000013 "my $G = \"[0-9a-fA-F]{1,4}\";"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "my @tail = ( \":\","
NSQ_SOURCE_LINE 00000016 "\t     \"(:($G)?|$IPv4)\","
NSQ_SOURCE_LINE 00000017 "             \":($IPv4|$G(:$G)?|)\","
NSQ_SOURCE_LINE 00000018 "             \"(:$IPv4|:$G(:$IPv4|(:$G){0,2})|:)\","
NSQ_SOURCE_LINE 00000019 "\t     \"((:$G){0,2}(:$IPv4|(:$G){1,2})|:)\","
NSQ_SOURCE_LINE 00000020 "\t     \"((:$G){0,3}(:$IPv4|(:$G){1,2})|:)\","
NSQ_SOURCE_LINE 00000021 "\t     \"((:$G){0,4}(:$IPv4|(:$G){1,2})|:)\" );"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "our $IPv6_re = $G;"
NSQ_SOURCE_LINE 00000024 "$IPv6_re = \"$G:($IPv6_re|$_)\" for @tail;"
NSQ_SOURCE_LINE 00000025 "$IPv6_re = qq/:(:$G){0,5}((:$G){1,2}|:$IPv4)|$IPv6_re/;"
NSQ_SOURCE_LINE 00000026 "$IPv6_re =~ s/\\(/(?:/g;"
NSQ_SOURCE_LINE 00000027 "$IPv6_re = qr/$IPv6_re/;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "1;"
NSQ_SOURCE_LINE 00000030 "__END__"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "=head1 NAME"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "Regexp::IPv6 - Regular expression for IPv6 addresses"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "  use Regexp::IPv6 qw($IPv6_re);"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "  $address =~ /^$IPv6_re$/ and print \"IPv6 address\\n\";"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "This module exports the $IPv6_re regular expression that matches any"
NSQ_SOURCE_LINE 00000045 "valid IPv6 address as described in \"RFC 2373 - 2.2 Text Representation"
NSQ_SOURCE_LINE 00000046 "of Addresses\" but C<::>. Any string not compliant with such RFC will"
NSQ_SOURCE_LINE 00000047 "be rejected."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "To match full strings use C</^$IPv6_re$/>."
NSQ_SOURCE_LINE 00000050 ""
