NSQ_SOURCE_LINE 00001193 "=head2 sb_height"
NSQ_SOURCE_LINE 00001194 ""
NSQ_SOURCE_LINE 00001195 "Current scrollbar height."
NSQ_SOURCE_LINE 00001196 ""
NSQ_SOURCE_LINE 00001197 "=cut"
NSQ_SOURCE_LINE 00001198 ""
NSQ_SOURCE_LINE 00001199 "sub sb_height {"
NSQ_SOURCE_LINE 00001200 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001201 "\tmy $ext = $self->scroll_dimension;"
NSQ_SOURCE_LINE 00001202 "\tmy $max = $self->row_count - $ext;"
NSQ_SOURCE_LINE 00001203 "\treturn 1 unless $max;"
NSQ_SOURCE_LINE 00001204 "\treturn floor(0.5 + ($ext * $ext / $max));"
NSQ_SOURCE_LINE 00001205 "}"
NSQ_SOURCE_LINE 00001206 ""
NSQ_SOURCE_LINE 00001207 "=head2 scroll_rows"
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 "Positions of the scrollbar indicator."
NSQ_SOURCE_LINE 00001210 ""
NSQ_SOURCE_LINE 00001211 "=cut"
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 "sub scroll_rows {"
NSQ_SOURCE_LINE 00001214 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001215 "\tmy $cur = $self->scroll_position;"
NSQ_SOURCE_LINE 00001216 "\tmy $ext = $self->scroll_dimension;"
NSQ_SOURCE_LINE 00001217 "\tmy $max = $self->row_count - $ext;"
NSQ_SOURCE_LINE 00001218 "\treturn unless $max;"
NSQ_SOURCE_LINE 00001219 "\tmy $y = floor(0.5 + ($cur * ($ext - $self->sb_height) / $max));"
NSQ_SOURCE_LINE 00001220 "\treturn $y, $y + $self->sb_height;"
NSQ_SOURCE_LINE 00001221 "}"
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 "=head2 active_scrollbar_rect"
NSQ_SOURCE_LINE 00001224 ""
NSQ_SOURCE_LINE 00001225 "Rectangle representing the area covered by the current scrollbar."
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "=cut"
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 "sub active_scrollbar_rect {"
NSQ_SOURCE_LINE 00001230 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001231 "\treturn unless my ($start, $end) = $self->scroll_rows;"
NSQ_SOURCE_LINE 00001232 "\tTickit::Rect->new("
NSQ_SOURCE_LINE 00001233 "\t\ttop => $self->header_lines + $start,"
NSQ_SOURCE_LINE 00001234 "\t\tbottom => 2 + $end,"
NSQ_SOURCE_LINE 00001235 "\t\tleft => $self->window->cols - 1,"
NSQ_SOURCE_LINE 00001236 "\t\tcols => 1,"
NSQ_SOURCE_LINE 00001237 "\t);"
NSQ_SOURCE_LINE 00001238 "}"
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "=head2 scroll_dimension"
NSQ_SOURCE_LINE 00001241 ""
NSQ_SOURCE_LINE 00001242 "Size of the vertical scrollbar."
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "=cut"
NSQ_SOURCE_LINE 00001245 ""
NSQ_SOURCE_LINE 00001246 "sub scroll_dimension {"
NSQ_SOURCE_LINE 00001247 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001248 "\treturn 1 unless my $win = $self->window;"
NSQ_SOURCE_LINE 00001249 "\t$win->lines - 2;"
NSQ_SOURCE_LINE 00001250 "}"
NSQ_SOURCE_LINE 00001251 ""
NSQ_SOURCE_LINE 00001252 "=head2 on_adapter_change"
NSQ_SOURCE_LINE 00001253 ""
NSQ_SOURCE_LINE 00001254 "Applies a new adapter, taking care of any cleanup if there was an"
NSQ_SOURCE_LINE 00001255 "adapter previously active."
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "Can be passed undef, to remove the adapter completely."
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "=cut"
NSQ_SOURCE_LINE 00001260 ""
NSQ_SOURCE_LINE 00001261 "sub on_adapter_change {"
NSQ_SOURCE_LINE 00001262 "\tmy ($self, $adapter) = @_;"
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "\tif(my $old = $self->{adapter}) {"
NSQ_SOURCE_LINE 00001265 "\t\t$old->bus->unsubscribe_from_event("
NSQ_SOURCE_LINE 00001266 "\t\t\t@{$self->{adapter_subscriptions}}"
NSQ_SOURCE_LINE 00001267 "\t\t);"
NSQ_SOURCE_LINE 00001268 "\t}"
NSQ_SOURCE_LINE 00001269 ""
NSQ_SOURCE_LINE 00001270 "\tdelete $self->{bus};"
NSQ_SOURCE_LINE 00001271 "\t$self->{adapter} = $adapter;"
NSQ_SOURCE_LINE 00001272 "\tundef $self->{item_count};"
NSQ_SOURCE_LINE 00001273 "\treturn $self unless $adapter;"
NSQ_SOURCE_LINE 00001274 ""
NSQ_SOURCE_LINE 00001275 "\t# Want weakrefs in here, because we're storing the subscriptions"
NSQ_SOURCE_LINE 00001276 "\t# for later cleanup. "
NSQ_SOURCE_LINE 00001277 "\t$self->bus->subscribe_to_event(@{"
NSQ_SOURCE_LINE 00001278 "\t\t$self->{adapter_subscriptions} = ["
NSQ_SOURCE_LINE 00001279 "\t\t\tsplice => $self->curry::weak::on_splice_event,"
NSQ_SOURCE_LINE 00001280 "\t\t\tclear  => $self->curry::weak::on_clear_event,"
NSQ_SOURCE_LINE 00001281 "\t\t\tmodify => $self->curry::weak::on_modify_event,"
NSQ_SOURCE_LINE 00001282 "\t\t]"
NSQ_SOURCE_LINE 00001283 "\t});"
NSQ_SOURCE_LINE 00001284 ""
NSQ_SOURCE_LINE 00001285 "\t$self->adapter->count->on_done(sub {"
NSQ_SOURCE_LINE 00001286 "\t\t$self->{item_count} = shift"
NSQ_SOURCE_LINE 00001287 "\t});"
NSQ_SOURCE_LINE 00001288 "\t$self"
NSQ_SOURCE_LINE 00001289 "}"
NSQ_SOURCE_LINE 00001290 ""
NSQ_SOURCE_LINE 00001291 "sub idx_in_row_cache_range {"
NSQ_SOURCE_LINE 00001292 "\tmy ($self, $idx) = @_;"
NSQ_SOURCE_LINE 00001293 "\treturn 0 unless $self->idx_from_row_cache(0) <= $idx;"
NSQ_SOURCE_LINE 00001294 "\treturn 0 unless $self->idx_from_row_cache(3 * $self->body_lines - 1) >= $idx;"
NSQ_SOURCE_LINE 00001295 "\treturn 1;"
NSQ_SOURCE_LINE 00001296 "}"
NSQ_SOURCE_LINE 00001297 ""
NSQ_SOURCE_LINE 00001298 "sub on_modify_event {"
NSQ_SOURCE_LINE 00001299 "\tmy ($self, $ev, $idx, $data) = @_;"
NSQ_SOURCE_LINE 00001300 "\treturn unless $self->window;"
NSQ_SOURCE_LINE 00001301 "\t$self->update_row_cache($idx) if $self->idx_in_row_cache_range($idx);"
NSQ_SOURCE_LINE 00001302 "}"
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 "=head2 on_splice_event"
NSQ_SOURCE_LINE 00001305 ""
NSQ_SOURCE_LINE 00001306 "Invoked by the adapter when data is added to or removed from"
NSQ_SOURCE_LINE 00001307 "the data source."
NSQ_SOURCE_LINE 00001308 ""
NSQ_SOURCE_LINE 00001309 "=cut"
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 "sub on_splice_event {"
NSQ_SOURCE_LINE 00001312 "\tmy ($self, $ev, $idx, $len, $data) = @_;"
NSQ_SOURCE_LINE 00001313 ""
NSQ_SOURCE_LINE 00001314 "\tmy $delta = @$data - $len;"
NSQ_SOURCE_LINE 00001315 ""
NSQ_SOURCE_LINE 00001316 "\tif(my $win = $self->window) {"
NSQ_SOURCE_LINE 00001317 "\t\t# Row cache update"
NSQ_SOURCE_LINE 00001318 "\t\tmy $rc_start = $self->idx_from_row_cache(0);"
NSQ_SOURCE_LINE 00001319 "\t\tmy $rc_end = $self->idx_from_row_cache(3 * $self->body_lines - 1);"
NSQ_SOURCE_LINE 00001320 ""
NSQ_SOURCE_LINE 00001321 "\t\t# Just nuke the cache if this overlaps. It's"
NSQ_SOURCE_LINE 00001322 "\t\t# not very efficient, but should prevent"
NSQ_SOURCE_LINE 00001323 "\t\t# rendering glitches."
NSQ_SOURCE_LINE 00001324 "\t\tif($idx + $len >= $rc_start && $idx <= $rc_end) {"
NSQ_SOURCE_LINE 00001325 "\t\t\tundef($_) for @{$self->{row_cache}};"
NSQ_SOURCE_LINE 00001326 "\t\t}"
NSQ_SOURCE_LINE 00001327 "\t\tif($idx + @$data >= $rc_start && $idx <= $rc_end) {"
NSQ_SOURCE_LINE 00001328 "\t\t\tundef($_) for @{$self->{row_cache}};"
NSQ_SOURCE_LINE 00001329 "\t\t}"
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 "\t\t$self->scroll_highlight($delta) if $delta;"
NSQ_SOURCE_LINE 00001332 "\t\t$win->expose;"
NSQ_SOURCE_LINE 00001333 "\t}"
NSQ_SOURCE_LINE 00001334 ""
NSQ_SOURCE_LINE 00001335 "\t# Either update our cached count based on"
NSQ_SOURCE_LINE 00001336 "\t# the change, or request a new count if we have"
NSQ_SOURCE_LINE 00001337 "\t# none yet"
NSQ_SOURCE_LINE 00001338 "\tif(defined $self->{item_count}) {"
NSQ_SOURCE_LINE 00001339 "\t\t$self->{item_count} += $delta;"
NSQ_SOURCE_LINE 00001340 "\t} else {"
NSQ_SOURCE_LINE 00001341 "\t\t$self->adapter->count->on_done(sub {"
NSQ_SOURCE_LINE 00001342 "\t\t\t$self->{item_count} = shift"
NSQ_SOURCE_LINE 00001343 "\t\t});"
NSQ_SOURCE_LINE 00001344 "\t}"
NSQ_SOURCE_LINE 00001345 "}"
NSQ_SOURCE_LINE 00001346 ""
NSQ_SOURCE_LINE 00001347 "=head2 on_clear_event"
NSQ_SOURCE_LINE 00001348 ""
NSQ_SOURCE_LINE 00001349 "Called by the adapter when all data has been removed from the"
NSQ_SOURCE_LINE 00001350 "data source."
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "=cut"
NSQ_SOURCE_LINE 00001353 ""
NSQ_SOURCE_LINE 00001354 "sub on_clear_event {"
NSQ_SOURCE_LINE 00001355 "\tmy ($self, $ev) = @_;"
NSQ_SOURCE_LINE 00001356 "\t$self->{highlight_row} = 0;"
NSQ_SOURCE_LINE 00001357 "\t$self->{item_count} = 0;"
NSQ_SOURCE_LINE 00001358 "\tif(my $win = $self->window) {"
NSQ_SOURCE_LINE 00001359 "\t\t$win->expose;"
NSQ_SOURCE_LINE 00001360 "\t}"
NSQ_SOURCE_LINE 00001361 "}"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "=head1 METHODS - Key bindings"
NSQ_SOURCE_LINE 00001364 ""
NSQ_SOURCE_LINE 00001365 "=head2 key_previous_row"
NSQ_SOURCE_LINE 00001366 ""
NSQ_SOURCE_LINE 00001367 "Go to the previous row."
NSQ_SOURCE_LINE 00001368 ""
NSQ_SOURCE_LINE 00001369 "=cut"
NSQ_SOURCE_LINE 00001370 ""
NSQ_SOURCE_LINE 00001371 "sub key_previous_row {"
NSQ_SOURCE_LINE 00001372 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001373 "\treturn 1 unless my $win = $self->window;"
NSQ_SOURCE_LINE 00001374 "\treturn 1 if $self->{highlight_row} <= 0;"
NSQ_SOURCE_LINE 00001375 ""
NSQ_SOURCE_LINE 00001376 "\tif($self->highlight_visible_row >= 1) {"
NSQ_SOURCE_LINE 00001377 "\t\t$self->move_highlight(-1);"
NSQ_SOURCE_LINE 00001378 "\t\treturn 1;"
NSQ_SOURCE_LINE 00001379 "\t}"
NSQ_SOURCE_LINE 00001380 "\t$self->scroll_highlight(-1);"
NSQ_SOURCE_LINE 00001381 "\t1"
NSQ_SOURCE_LINE 00001382 "}"
NSQ_SOURCE_LINE 00001383 ""
NSQ_SOURCE_LINE 00001384 "=head2 key_next_row"
NSQ_SOURCE_LINE 00001385 ""
NSQ_SOURCE_LINE 00001386 "Move to the next row."
NSQ_SOURCE_LINE 00001387 ""
NSQ_SOURCE_LINE 00001388 "=cut"
NSQ_SOURCE_LINE 00001389 ""
NSQ_SOURCE_LINE 00001390 "sub key_next_row {"
NSQ_SOURCE_LINE 00001391 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001392 "\treturn 1 unless my $win = $self->window;"
NSQ_SOURCE_LINE 00001393 "\treturn 1 if $self->{highlight_row} >= $self->row_count - 1;"
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 "\tif($self->highlight_visible_row < $win->lines - 2) {"
NSQ_SOURCE_LINE 00001396 "\t\t$self->move_highlight(1);"
NSQ_SOURCE_LINE 00001397 "\t\treturn 1;"
NSQ_SOURCE_LINE 00001398 "\t}"
NSQ_SOURCE_LINE 00001399 "\t$self->scroll_highlight(1);"
NSQ_SOURCE_LINE 00001400 "\treturn 1;"
NSQ_SOURCE_LINE 00001401 "}"
NSQ_SOURCE_LINE 00001402 ""
NSQ_SOURCE_LINE 00001403 "=head2 key_first_row"
NSQ_SOURCE_LINE 00001404 ""
NSQ_SOURCE_LINE 00001405 "Move to the first row."
NSQ_SOURCE_LINE 00001406 ""
NSQ_SOURCE_LINE 00001407 "=cut"
NSQ_SOURCE_LINE 00001408 ""
NSQ_SOURCE_LINE 00001409 "sub key_first_row {"
NSQ_SOURCE_LINE 00001410 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001411 "\t$self->{highlight_row} = 0;"
NSQ_SOURCE_LINE 00001412 "\t$self->{row_offset} = 0;"
NSQ_SOURCE_LINE 00001413 "\t$self->redraw;"
NSQ_SOURCE_LINE 00001414 "\t1"
NSQ_SOURCE_LINE 00001415 "}"
NSQ_SOURCE_LINE 00001416 ""
NSQ_SOURCE_LINE 00001417 "=head2 key_last_row"
NSQ_SOURCE_LINE 00001418 ""
NSQ_SOURCE_LINE 00001419 "Move to the last row."
NSQ_SOURCE_LINE 00001420 ""
NSQ_SOURCE_LINE 00001421 "=cut"
NSQ_SOURCE_LINE 00001422 ""
NSQ_SOURCE_LINE 00001423 "sub key_last_row {"
NSQ_SOURCE_LINE 00001424 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001425 "\t$self->{highlight_row} = $self->row_count - 1;"
NSQ_SOURCE_LINE 00001426 "\t$self->{row_offset} = $self->row_count > $self->scroll_dimension ? -1 + $self->row_count - $self->scroll_dimension : 0;"
NSQ_SOURCE_LINE 00001427 "\t$self->redraw;"
NSQ_SOURCE_LINE 00001428 "\t1"
NSQ_SOURCE_LINE 00001429 "}"
NSQ_SOURCE_LINE 00001430 ""
NSQ_SOURCE_LINE 00001431 "=head2 key_previous_page"
NSQ_SOURCE_LINE 00001432 ""
NSQ_SOURCE_LINE 00001433 "Go up a page."
NSQ_SOURCE_LINE 00001434 ""
NSQ_SOURCE_LINE 00001435 "=cut"
NSQ_SOURCE_LINE 00001436 ""
NSQ_SOURCE_LINE 00001437 "sub key_previous_page {"
NSQ_SOURCE_LINE 00001438 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001439 "\t$self->scroll_highlight(-$self->scroll_dimension);"
NSQ_SOURCE_LINE 00001440 "\t1;"
