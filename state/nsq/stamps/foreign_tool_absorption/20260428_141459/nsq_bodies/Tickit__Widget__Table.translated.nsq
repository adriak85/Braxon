NSQ_SOURCE_LINE 00000001 "package Tickit::Widget::Table;"
NSQ_SOURCE_LINE 00000002 "# ABSTRACT: a table widget for larger datasets"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use parent qw(Tickit::Widget);"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.216';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "=head1 NAME"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "Tickit::Widget::Table - table widget with support for scrolling/paging"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "=head1 VERSION"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "version 0.216"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 " #!/usr/bin/env perl"
NSQ_SOURCE_LINE 00000021 " use strict;"
NSQ_SOURCE_LINE 00000022 " use warnings;"
NSQ_SOURCE_LINE 00000023 " "
NSQ_SOURCE_LINE 00000024 " use Tickit;"
NSQ_SOURCE_LINE 00000025 " use Tickit::Widget::Table;"
NSQ_SOURCE_LINE 00000026 " "
NSQ_SOURCE_LINE 00000027 " my $tbl = Tickit::Widget::Table->new;"
NSQ_SOURCE_LINE 00000028 " $tbl->add_column("
NSQ_SOURCE_LINE 00000029 " \tlabel => 'Left',"
NSQ_SOURCE_LINE 00000030 " \talign => 'left',"
NSQ_SOURCE_LINE 00000031 " \twidth => 8,"
NSQ_SOURCE_LINE 00000032 " );"
NSQ_SOURCE_LINE 00000033 " $tbl->add_column("
NSQ_SOURCE_LINE 00000034 " \tlabel => 'Second column',"
NSQ_SOURCE_LINE 00000035 " \talign => 'centre'"
NSQ_SOURCE_LINE 00000036 " );"
NSQ_SOURCE_LINE 00000037 " $tbl->adapter->push([ map [qw(left middle)], 1..100 ]);"
NSQ_SOURCE_LINE 00000038 " Tickit->new(root => $tbl)->run;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "B<WARNING>: This is still a preview release. API might be subject to change in"
NSQ_SOURCE_LINE 00000043 "future, please get in contact if you're using this, or wait for version 1.000."
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=begin HTML"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "<p>Basic rendering:</p>"
NSQ_SOURCE_LINE 00000048 "<p><img src=\"http://tickit.perlsite.co.uk/cpan-screenshot/tickit-widget-table-paged1.gif\" alt=\"Paged table widget in action\" width=\"430\" height=\"306\"></p>"
NSQ_SOURCE_LINE 00000049 "<p>Adapter updating dynamically, styled columns, deferred loading:</p>"
NSQ_SOURCE_LINE 00000050 "<p><img src=\"http://tickit.perlsite.co.uk/cpan-screenshot/tickit-widget-table-paged2.gif\" alt=\"Paged table widget in action\" width=\"539\" height=\"315\"></p>"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=end HTML"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "This widget provides a scrollable table implementation for use on larger data"
NSQ_SOURCE_LINE 00000055 "sets. Rather than populating the table with values, you provide an adapter"
NSQ_SOURCE_LINE 00000056 "which implements the C<count> and C<get> methods, and the table widget will"
NSQ_SOURCE_LINE 00000057 "query the adapter for the current \"page\" of values."
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "This abstraction should allow access to larger datasets than would fit in"
NSQ_SOURCE_LINE 00000060 "available memory, such as a database table or procedurally-generated data."
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "See L<Adapter::Async::OrderedList::Array> if your data is stored in a Perl"
NSQ_SOURCE_LINE 00000063 "array. Other subclasses may be available if you have a different source."
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "=head2 Transformations"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "Apply to:"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "=over 4"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=item * Row"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=item * Column"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=item * Cell"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "=back"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=head3 Item transformations"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "This takes the original data item for the row, and returns one of the following:"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=over 4"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "=item * Future - when resolved, the items will be used as cells"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "=item * Arrayref - holds the cells directly"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=back"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "The data item can be anything - an array-backed adapter would return an arrayref, ORM will give you an object for basic collections."
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "Any number of cells may be returned from a row transformation, but you may get odd results if the cell count is not consistent."
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "An array adapter needs no row transformation, due to the arrayref behaviour. You could provide a Future alternative:"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 " $row->apply_transformation(sub {"
NSQ_SOURCE_LINE 00000098 "  my ($item) = @_;"
NSQ_SOURCE_LINE 00000099 "  Future->wrap("
NSQ_SOURCE_LINE 00000100 "   @$item"
NSQ_SOURCE_LINE 00000101 "  )"
NSQ_SOURCE_LINE 00000102 " });"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "For the ORM example, something like this:"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 " $row->apply_transformation(sub {"
NSQ_SOURCE_LINE 00000107 "  my ($item) = @_;"
NSQ_SOURCE_LINE 00000108 "  Future->wrap("
NSQ_SOURCE_LINE 00000109 "   map $item->$_, qw(id name created)"
NSQ_SOURCE_LINE 00000110 "  )"
NSQ_SOURCE_LINE 00000111 " });"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head3 Column transformations"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "Column transformations are used to apply styles and formats."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "You get an input value, and return either a string or a Future."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "Example date+colour transformation on column:"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 " $col->apply_transformation(sub {"
NSQ_SOURCE_LINE 00000122 "  my $v = shift;"
NSQ_SOURCE_LINE 00000123 "  Future->wrap("
NSQ_SOURCE_LINE 00000124 "   String::Tagged->new(strftime '%Y-%m-%d', $v)"
NSQ_SOURCE_LINE 00000125 "   ->apply_tag(0, 4, b => 1)"
NSQ_SOURCE_LINE 00000126 "   ->apply_tag(5, 1, fg => 8)"
NSQ_SOURCE_LINE 00000127 "   ->apply_tag(6, 2, fg => 4)"
NSQ_SOURCE_LINE 00000128 "   ->apply_tag(9, 1, fg => 8)"
NSQ_SOURCE_LINE 00000129 "  );"
NSQ_SOURCE_LINE 00000130 " });"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=head3 Cell transformations"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Cell transformations are for cases where you need fine control over individual components. They operate similarly to column transformations,"
NSQ_SOURCE_LINE 00000135 "taking the input value and returning either a string or a Future."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "Typical example would be a spreadsheet:"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 " $cell->apply_transformation(sub {"
NSQ_SOURCE_LINE 00000140 "  my $v = shift;"
NSQ_SOURCE_LINE 00000141 "  return $v unless blessed $v;"
NSQ_SOURCE_LINE 00000142 "  return eval $v if $v->is_formula;"
NSQ_SOURCE_LINE 00000143 "  return $v->to_string if $v->is_formatted;"
NSQ_SOURCE_LINE 00000144 "  return \"$v\""
NSQ_SOURCE_LINE 00000145 " });"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=head3 View transformations"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "This happen every time the row is rendered. They provide the ability to do view-specific modification,"
NSQ_SOURCE_LINE 00000150 "such as replacing long strings with an elided version (\"Some lengthy messa...\")"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=cut"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "use Tickit::RenderBuffer qw(LINE_SINGLE LINE_DOUBLE CAP_BOTH);"
NSQ_SOURCE_LINE 00000155 "use Tickit::Utils qw(distribute substrwidth align textwidth chars2cols);"
NSQ_SOURCE_LINE 00000156 "use String::Tagged;"
NSQ_SOURCE_LINE 00000157 "use Future::Utils qw(fmap_void try_repeat);"
NSQ_SOURCE_LINE 00000158 "use Tickit::Style;"
NSQ_SOURCE_LINE 00000159 "use Scalar::Util qw(looks_like_number blessed);"
NSQ_SOURCE_LINE 00000160 "use POSIX qw(floor);"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "use Adapter::Async::OrderedList;"
NSQ_SOURCE_LINE 00000163 "use Adapter::Async::OrderedList::Array;"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "use constant WIDGET_PEN_FROM_STYLE => 1;"
NSQ_SOURCE_LINE 00000166 "use constant CLEAR_BEFORE_RENDER   => 0;"
NSQ_SOURCE_LINE 00000167 "use constant KEYPRESSES_FROM_STYLE => 1;"
NSQ_SOURCE_LINE 00000168 "use constant CAN_FOCUS             => 1;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "BEGIN {"
NSQ_SOURCE_LINE 00000171 "\tstyle_definition 'base' =>"
NSQ_SOURCE_LINE 00000172 "\t\tcell_padding         => 1,"
NSQ_SOURCE_LINE 00000173 "\t\tfg                   => 'white',"
NSQ_SOURCE_LINE 00000174 "\t\thighlight_b          => 1,"
NSQ_SOURCE_LINE 00000175 "\t\thighlight_fg         => 'yellow',"
NSQ_SOURCE_LINE 00000176 "\t\thighlight_bg         => 'blue',"
NSQ_SOURCE_LINE 00000177 "\t\tselected_b           => 1,"
NSQ_SOURCE_LINE 00000178 "\t\tselected_fg          => 'white',"
NSQ_SOURCE_LINE 00000179 "\t\tselected_bg          => 'red',"
NSQ_SOURCE_LINE 00000180 "\t\theader_b             => 1,"
NSQ_SOURCE_LINE 00000181 "\t\theader_fg            => 'blue',"
NSQ_SOURCE_LINE 00000182 "\t\tscrollbar_fg         => 'white',"
NSQ_SOURCE_LINE 00000183 "\t\tscrollbar_bg         => 'black',"
NSQ_SOURCE_LINE 00000184 "\t\tscrollbar_line_style => 'none',"
NSQ_SOURCE_LINE 00000185 "\t\tscroll_b             => 1,"
NSQ_SOURCE_LINE 00000186 "\t\tscroll_fg            => 'white',"
NSQ_SOURCE_LINE 00000187 "\t\tscroll_bg            => 'black',"
NSQ_SOURCE_LINE 00000188 "#\t\tscroll_line_style    => 'block';"
NSQ_SOURCE_LINE 00000189 "# Technically we should ignore any keyboard input if we don't have focus,"
NSQ_SOURCE_LINE 00000190 "# but other widgets don't currently do this and things seem to work without"
NSQ_SOURCE_LINE 00000191 "# it anyway."
NSQ_SOURCE_LINE 00000192 "#\tstyle_definition ':focus' =>"
NSQ_SOURCE_LINE 00000193 "\t\t'<Up>'               => 'previous_row',"
NSQ_SOURCE_LINE 00000194 "\t\t'<Down>'             => 'next_row',"
NSQ_SOURCE_LINE 00000195 "\t\t'<PageUp>'           => 'previous_page',"
NSQ_SOURCE_LINE 00000196 "\t\t'<PageDown>'         => 'next_page',"
NSQ_SOURCE_LINE 00000197 "\t\t'<Home>'             => 'first_row',"
NSQ_SOURCE_LINE 00000198 "\t\t'<End>'              => 'last_row',"
NSQ_SOURCE_LINE 00000199 "\t\t'<Left>'             => 'previous_column',"
NSQ_SOURCE_LINE 00000200 "\t\t'<Right>'            => 'next_column',"
NSQ_SOURCE_LINE 00000201 "\t\t'<Space>'            => 'select_toggle',"
NSQ_SOURCE_LINE 00000202 "\t\t'<Enter>'            => 'activate';"
NSQ_SOURCE_LINE 00000203 "}"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "# Allow more descriptive terms for column alignment - these"
NSQ_SOURCE_LINE 00000206 "# map to the values allowed by the Tickit::Utils::align series"
NSQ_SOURCE_LINE 00000207 "# of functions."
NSQ_SOURCE_LINE 00000208 "my %ALIGNMENT_TYPE = ("
NSQ_SOURCE_LINE 00000209 "\tleft   => 0,"
NSQ_SOURCE_LINE 00000210 "\tright  => 1,"
NSQ_SOURCE_LINE 00000211 "\tcentre => 0.5,"
NSQ_SOURCE_LINE 00000212 "\tcenter => 0.5,"
NSQ_SOURCE_LINE 00000213 "\tmiddle => 0.5,"
NSQ_SOURCE_LINE 00000214 ");"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=head1 METHODS"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "=cut"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=head2 new"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "Instantiate. Will attempt to take focus."
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "Takes the following named parameters:"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=over 4"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=item * on_activate - coderef to call when the user hits the Enter key,"
NSQ_SOURCE_LINE 00000229 "will be passed the highlighted row or selection when in C<multi_select> mode,"
NSQ_SOURCE_LINE 00000230 "see L</on_activate> for more details."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=item * multi_select - when set, the widget will allow selection of multiple"
NSQ_SOURCE_LINE 00000233 "rows (typically by pressing Space to toggle a given row)"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=item * adapter - an L<Adapter::Async::OrderedList::Array> instance"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=item * data - alternative to passing an adapter, if you want to wrap an existing"
NSQ_SOURCE_LINE 00000238 "array without creating an L<Adapter::Async::OrderedList> subclass yourself"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=back"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "Returns a new instance."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=cut"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "sub new {"
NSQ_SOURCE_LINE 00000247 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000248 "\tmy %args = @_;"
NSQ_SOURCE_LINE 00000249 "\tmy %attr;"
NSQ_SOURCE_LINE 00000250 "\t$attr{$_} = delete $args{$_} for qw("
NSQ_SOURCE_LINE 00000251 "\t\ton_activate"
NSQ_SOURCE_LINE 00000252 "\t\tmulti_select"
NSQ_SOURCE_LINE 00000253 "\t\tadapter"
NSQ_SOURCE_LINE 00000254 "\t\tfailure_transformations"
NSQ_SOURCE_LINE 00000255 "\t\titem_transformations"
NSQ_SOURCE_LINE 00000256 "\t\tcell_transformations"
NSQ_SOURCE_LINE 00000257 "\t\tview_transformations"
NSQ_SOURCE_LINE 00000258 "\t\tcolumns"
NSQ_SOURCE_LINE 00000259 "\t\thighlight_row"
NSQ_SOURCE_LINE 00000260 "\t\tdata"
NSQ_SOURCE_LINE 00000261 "\t);"
NSQ_SOURCE_LINE 00000262 "\t$attr{header_visible} //= 1;"
NSQ_SOURCE_LINE 00000263 "\t$attr{header_lines} //= 1;"
NSQ_SOURCE_LINE 00000264 "\tmy $self = $class->SUPER::new(@_);"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "\t# First we assign the adapter, since it might be used elsewhere"
NSQ_SOURCE_LINE 00000267 "\t$attr{adapter} ||= Adapter::Async::OrderedList::Array->new("
NSQ_SOURCE_LINE 00000268 "\t\tdata => delete($attr{data}) || []"
NSQ_SOURCE_LINE 00000269 "\t);"
NSQ_SOURCE_LINE 00000270 "\t$self->on_adapter_change(delete $attr{adapter});"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "\t# Special-case parameters which need method calls"
NSQ_SOURCE_LINE 00000273 "\t$self->on_activate(delete $attr{on_activate}) if $attr{on_activate};"
NSQ_SOURCE_LINE 00000274 "\t$self->multi_select(delete $attr{multi_select} || 0);"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "\t# Some defaults"
NSQ_SOURCE_LINE 00000277 "\t$attr{item_transformations} ||= [ ];"
NSQ_SOURCE_LINE 00000278 "\t$attr{cell_transformations} ||= { };"
NSQ_SOURCE_LINE 00000279 "\t$attr{failure_transformations} = [ $attr{failure_transformations} ] if $attr{failure_transformations} && ref $attr{failure_transformations} eq 'CODE';"
NSQ_SOURCE_LINE 00000280 "\t$attr{view_transformations} = [ $attr{view_transformations} ] if $attr{view_transformations} && ref $attr{view_transformations} eq 'CODE';"
NSQ_SOURCE_LINE 00000281 "\t$attr{highlight_row} //= 0;"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "\t# Apply our attributes now"
NSQ_SOURCE_LINE 00000284 "\tmy @cols = @{ delete $attr{columns} || [] };"
NSQ_SOURCE_LINE 00000285 "\t$self->{$_} = $attr{$_} for keys %attr;"
NSQ_SOURCE_LINE 00000286 "\tfor my $col (@cols) {"
NSQ_SOURCE_LINE 00000287 "\t\t$self->add_column(%$col);"
NSQ_SOURCE_LINE 00000288 "\t}"
NSQ_SOURCE_LINE 00000289 "\t$self->take_focus;"
NSQ_SOURCE_LINE 00000290 "\t$self"
NSQ_SOURCE_LINE 00000291 "}"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "sub adapter { shift->{adapter} }"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=head2 bus"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "Bus for event handling. Normally an L<Adapter::Async::Bus> instance"
NSQ_SOURCE_LINE 00000298 "shared by the adapter."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=cut"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "sub bus { $_[0]->{bus} ||= $_[0]->adapter->bus }"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=head1 METHODS - Table content"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=head2 clear"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "Clear all data in the table."
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=cut"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "sub clear {"
NSQ_SOURCE_LINE 00000313 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000314 "\t# Let our event handler take care of any required cleanup here"
NSQ_SOURCE_LINE 00000315 "\t$self->adapter->clear;"
NSQ_SOURCE_LINE 00000316 "\t$self"
NSQ_SOURCE_LINE 00000317 "}"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=head2 expose_row"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "Expose the given row (provided as an index into the underlying storage)."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 " $tbl->expose_row(14);"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "=cut"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "sub expose_row {"
NSQ_SOURCE_LINE 00000328 "\tmy ($self, $idx) = @_;"
NSQ_SOURCE_LINE 00000329 "\tif(my $win = $self->window) {"
NSQ_SOURCE_LINE 00000330 "\t\tmy $row = $self->row_from_idx($idx);"
NSQ_SOURCE_LINE 00000331 "\t\treturn $self unless $row >= 0;"
NSQ_SOURCE_LINE 00000332 "\t\tmy $rect = Tickit::Rect->new("
NSQ_SOURCE_LINE 00000333 "\t\t\ttop   => $row,"
NSQ_SOURCE_LINE 00000334 "\t\t\tleft  => 0,"
NSQ_SOURCE_LINE 00000335 "\t\t\tlines => 1,"
NSQ_SOURCE_LINE 00000336 "\t\t\tcols  => $win->cols"
NSQ_SOURCE_LINE 00000337 "\t\t)->intersect($self->body_rect);"
NSQ_SOURCE_LINE 00000338 "\t\t$win->expose($rect) if $rect;"
NSQ_SOURCE_LINE 00000339 "\t}"
NSQ_SOURCE_LINE 00000340 "\treturn $self;"
NSQ_SOURCE_LINE 00000341 "}"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "=head2 add_column"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "Add a new column. Takes the following named parameters:"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=over 4"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "=item * width - (optional) number of columns"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=item * type - (optional) data type, currently only supports 'text' (the default)"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "=item * align - (optional) align left, center or right"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "=item * transform - (optional) list of transformations to apply"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=item * visible - (optional) true if this column should be shown"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=back"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "Returns $self."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=cut"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "sub add_column {"
NSQ_SOURCE_LINE 00000366 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000367 "\tmy %args = @_;"
NSQ_SOURCE_LINE 00000368 "\t# delete $args{width} if $args{width} eq 'auto';"
NSQ_SOURCE_LINE 00000369 "\t@args{qw(base expand)} = (0,1) unless exists $args{width};"
NSQ_SOURCE_LINE 00000370 "\t$args{fixed} = delete $args{width} if looks_like_number($args{width});"
NSQ_SOURCE_LINE 00000371 "\t$args{type} ||= 'text';"
NSQ_SOURCE_LINE 00000372 "\t$args{align} = $ALIGNMENT_TYPE{$args{align}} if defined($args{align}) && exists $ALIGNMENT_TYPE{$args{align}};"
NSQ_SOURCE_LINE 00000373 "\t$args{align} ||= 0;"
NSQ_SOURCE_LINE 00000374 "\t$args{visible} //= 1;"
NSQ_SOURCE_LINE 00000375 "\t$args{transform} ||= [];"
NSQ_SOURCE_LINE 00000376 "\t$args{transform} = [ $args{transform} ] unless ref $args{transform} eq 'ARRAY';"
NSQ_SOURCE_LINE 00000377 "\tpush @{$self->{columns}}, \\%args;"
NSQ_SOURCE_LINE 00000378 "\treturn $self if $self->{distribute_pending};"
NSQ_SOURCE_LINE 00000379 "\treturn $self unless my $win = $self->window;"
NSQ_SOURCE_LINE 00000380 "\t$self->{distribute_pending} = 1;"
NSQ_SOURCE_LINE 00000381 "\t$win->term->later(sub {"
NSQ_SOURCE_LINE 00000382 "\t\treturn unless $self->{distribute_pending};"
NSQ_SOURCE_LINE 00000383 "\t\t$self->distribute_columns;"
NSQ_SOURCE_LINE 00000384 "\t\tdelete $self->{distribute_pending};"
NSQ_SOURCE_LINE 00000385 "\t});"
NSQ_SOURCE_LINE 00000386 "\t$self"
NSQ_SOURCE_LINE 00000387 "}"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "=head2 selected_rows"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "Returns the selected row, or multiple rows as a list if multi_select is enabled."
NSQ_SOURCE_LINE 00000392 "If multi_select is enabled it does not return the row currently highlighted (unless that row is also selected)."
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "=cut"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "sub selected_rows {"
NSQ_SOURCE_LINE 00000397 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "\tif($self->multi_select) {"
NSQ_SOURCE_LINE 00000400 "\t\tmy @selected = sort { $a <=> $b } grep $self->{selected}{$_}, keys %{$self->{selected}};"
NSQ_SOURCE_LINE 00000401 "\t\treturn @{$self->data}[@selected];"
NSQ_SOURCE_LINE 00000402 "\t} else {"
NSQ_SOURCE_LINE 00000403 "\t\tmy $idx = $self->highlight_row;"
NSQ_SOURCE_LINE 00000404 "\t\treturn $self->data->[$idx];"
NSQ_SOURCE_LINE 00000405 "\t}"
NSQ_SOURCE_LINE 00000406 "}"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "=head1 METHODS - Callbacks"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "=head2 on_activate"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "Accessor for the activation callback - if called without parameters,"
NSQ_SOURCE_LINE 00000413 "will return the current coderef (if any), otherwise, will set the new"
NSQ_SOURCE_LINE 00000414 "callback."
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "This callback will be triggered via L</key_activate>:"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 " $code->($row_index, $row_data_as_arrayref)"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "If multiselect is enabled, the callback will have the following:"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 " $code->("
NSQ_SOURCE_LINE 00000423 "   [$highlight_row_index, @selected_row_indices],"
NSQ_SOURCE_LINE 00000424 "   $highlight_row_data_as_arrayref,"
NSQ_SOURCE_LINE 00000425 "   @selected_rows_as_arrayrefs"
NSQ_SOURCE_LINE 00000426 " )"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "(the selected row data + index list could be empty here)"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "=cut"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "sub on_activate {"
NSQ_SOURCE_LINE 00000433 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000434 "\tif(@_) {"
NSQ_SOURCE_LINE 00000435 "\t\t$self->{on_activate} = shift;"
NSQ_SOURCE_LINE 00000436 "\t\treturn $self;"
NSQ_SOURCE_LINE 00000437 "\t}"
NSQ_SOURCE_LINE 00000438 "\treturn $self->{on_activate}"
NSQ_SOURCE_LINE 00000439 "}"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=head2 multi_select"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "Accessor for multi_select mode - when set, this allows multiple rows"
NSQ_SOURCE_LINE 00000444 "to be selected."
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "=cut"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "sub multi_select {"
NSQ_SOURCE_LINE 00000449 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000450 "\tif(@_) {"
NSQ_SOURCE_LINE 00000451 "\t\t$self->{multi_select} = shift;"
NSQ_SOURCE_LINE 00000452 "\t\treturn $self;"
NSQ_SOURCE_LINE 00000453 "\t}"
NSQ_SOURCE_LINE 00000454 "\treturn $self->{multi_select} ? 1 : 0"
NSQ_SOURCE_LINE 00000455 "}"
NSQ_SOURCE_LINE 00000456 ""
