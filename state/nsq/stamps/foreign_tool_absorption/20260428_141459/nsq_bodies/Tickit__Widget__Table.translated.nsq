NSQ_SOURCE_LINE 00001447 "=cut"
NSQ_SOURCE_LINE 00001448 ""
NSQ_SOURCE_LINE 00001449 "sub key_next_page {"
NSQ_SOURCE_LINE 00001450 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001451 "\t$self->scroll_highlight($self->scroll_dimension);"
NSQ_SOURCE_LINE 00001452 "\t1;"
NSQ_SOURCE_LINE 00001453 "}"
NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 "=head2 key_next_column"
NSQ_SOURCE_LINE 00001456 ""
NSQ_SOURCE_LINE 00001457 "Move to the next column."
NSQ_SOURCE_LINE 00001458 ""
NSQ_SOURCE_LINE 00001459 "=cut"
NSQ_SOURCE_LINE 00001460 ""
NSQ_SOURCE_LINE 00001461 "sub key_next_column { 1 }"
NSQ_SOURCE_LINE 00001462 ""
NSQ_SOURCE_LINE 00001463 "=head2 key_previous_column"
NSQ_SOURCE_LINE 00001464 ""
NSQ_SOURCE_LINE 00001465 "Move to the previous column."
NSQ_SOURCE_LINE 00001466 ""
NSQ_SOURCE_LINE 00001467 "=cut"
NSQ_SOURCE_LINE 00001468 ""
NSQ_SOURCE_LINE 00001469 "sub key_previous_column { 1 }"
NSQ_SOURCE_LINE 00001470 ""
NSQ_SOURCE_LINE 00001471 "=head2 key_first_column"
NSQ_SOURCE_LINE 00001472 ""
NSQ_SOURCE_LINE 00001473 "Move to the first column."
NSQ_SOURCE_LINE 00001474 ""
NSQ_SOURCE_LINE 00001475 "=cut"
NSQ_SOURCE_LINE 00001476 ""
NSQ_SOURCE_LINE 00001477 "sub key_first_column { 1 }"
NSQ_SOURCE_LINE 00001478 ""
NSQ_SOURCE_LINE 00001479 "=head2 key_last_column"
NSQ_SOURCE_LINE 00001480 ""
NSQ_SOURCE_LINE 00001481 "Move to the last column."
NSQ_SOURCE_LINE 00001482 ""
NSQ_SOURCE_LINE 00001483 "=cut"
NSQ_SOURCE_LINE 00001484 ""
NSQ_SOURCE_LINE 00001485 "sub key_last_column { 1 }"
NSQ_SOURCE_LINE 00001486 ""
NSQ_SOURCE_LINE 00001487 "=head2 key_activate"
NSQ_SOURCE_LINE 00001488 ""
NSQ_SOURCE_LINE 00001489 "Call the C< on_activate > coderef with either the highlighted item, or the selected"
NSQ_SOURCE_LINE 00001490 "items if we're in multiselect mode."
NSQ_SOURCE_LINE 00001491 ""
NSQ_SOURCE_LINE 00001492 " $on_activate->([ row indices ], [ items... ])"
NSQ_SOURCE_LINE 00001493 ""
NSQ_SOURCE_LINE 00001494 "The items will be as returned by the storage adapter, and will not have any of the"
NSQ_SOURCE_LINE 00001495 "data transformations applied."
NSQ_SOURCE_LINE 00001496 ""
NSQ_SOURCE_LINE 00001497 "=cut"
NSQ_SOURCE_LINE 00001498 ""
NSQ_SOURCE_LINE 00001499 "sub key_activate {"
NSQ_SOURCE_LINE 00001500 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001501 "\tif(my $code = $self->{on_activate}) {"
NSQ_SOURCE_LINE 00001502 "\t\tmy @selected = "
NSQ_SOURCE_LINE 00001503 "\t\t\t  $self->multi_select"
NSQ_SOURCE_LINE 00001504 "\t\t\t? (sort { $a <=> $b } grep $self->{selected}{$_}, keys %{$self->{selected}})"
NSQ_SOURCE_LINE 00001505 "\t\t\t: ($self->highlight_row);"
NSQ_SOURCE_LINE 00001506 "\t\tmy $f; $f = $self->adapter->get("
NSQ_SOURCE_LINE 00001507 "\t\t\titems => \\@selected,"
NSQ_SOURCE_LINE 00001508 "\t\t)->then(sub {"
NSQ_SOURCE_LINE 00001509 "\t\t\tmy $ret = $code->(\\@selected, shift);"
NSQ_SOURCE_LINE 00001510 "\t\t\treturn blessed($ret) && $ret->isa('Future') ? $ret : Future->wrap($ret)"
NSQ_SOURCE_LINE 00001511 "\t\t})->on_ready(sub { undef $f });"
NSQ_SOURCE_LINE 00001512 "\t}"
NSQ_SOURCE_LINE 00001513 "\t1"
NSQ_SOURCE_LINE 00001514 "}"
NSQ_SOURCE_LINE 00001515 ""
NSQ_SOURCE_LINE 00001516 "=head2 key_select_toggle"
NSQ_SOURCE_LINE 00001517 ""
NSQ_SOURCE_LINE 00001518 "Toggle selected row."
NSQ_SOURCE_LINE 00001519 ""
NSQ_SOURCE_LINE 00001520 "=cut"
NSQ_SOURCE_LINE 00001521 ""
NSQ_SOURCE_LINE 00001522 "sub key_select_toggle {"
NSQ_SOURCE_LINE 00001523 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001524 "\treturn 1 unless $self->multi_select;"
NSQ_SOURCE_LINE 00001525 "\t$self->{selected}{$self->highlight_row} = $self->{selected}{$self->highlight_row} ? 0 : 1;"
NSQ_SOURCE_LINE 00001526 "\t1"
NSQ_SOURCE_LINE 00001527 "}"
NSQ_SOURCE_LINE 00001528 ""
NSQ_SOURCE_LINE 00001529 "=head1 METHODS - Filtering"
NSQ_SOURCE_LINE 00001530 ""
NSQ_SOURCE_LINE 00001531 "Very broken. Ignore these for now. Sorry."
NSQ_SOURCE_LINE 00001532 ""
NSQ_SOURCE_LINE 00001533 "=cut"
NSQ_SOURCE_LINE 00001534 ""
NSQ_SOURCE_LINE 00001535 "# NYI"
NSQ_SOURCE_LINE 00001536 "sub row_visibility_changed {"
NSQ_SOURCE_LINE 00001537 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001538 "}"
NSQ_SOURCE_LINE 00001539 ""
NSQ_SOURCE_LINE 00001540 "=head2 row_visibility"
NSQ_SOURCE_LINE 00001541 ""
NSQ_SOURCE_LINE 00001542 "Sets the visibility of the given row (by index)."
NSQ_SOURCE_LINE 00001543 ""
NSQ_SOURCE_LINE 00001544 "Example:"
NSQ_SOURCE_LINE 00001545 ""
NSQ_SOURCE_LINE 00001546 " # Make row 5 hidden"
NSQ_SOURCE_LINE 00001547 " $tbl->row_visibility(5, 0)"
NSQ_SOURCE_LINE 00001548 " # Show row 0"
NSQ_SOURCE_LINE 00001549 " $tbl->row_visibility(0, 1)"
NSQ_SOURCE_LINE 00001550 ""
NSQ_SOURCE_LINE 00001551 "=cut"
NSQ_SOURCE_LINE 00001552 ""
NSQ_SOURCE_LINE 00001553 "sub row_visibility {"
NSQ_SOURCE_LINE 00001554 "\tmy ($self, $idx, $visible) = @_;"
NSQ_SOURCE_LINE 00001555 "\tmy $row = $self->adapter->get($idx);"
NSQ_SOURCE_LINE 00001556 "\tmy $prev = ref($row);"
NSQ_SOURCE_LINE 00001557 "\t$prev = 'Tickit::Widget::Table::VisibleRow' if $prev eq 'ARRAY';"
NSQ_SOURCE_LINE 00001558 "\tmy $next = $visible"
NSQ_SOURCE_LINE 00001559 "\t? 'Tickit::Widget::Table::VisibleRow'"
NSQ_SOURCE_LINE 00001560 "\t: 'Tickit::Widget::Table::HiddenRow';"
NSQ_SOURCE_LINE 00001561 "\tbless $row, $next;"
NSQ_SOURCE_LINE 00001562 "\t$self->row_visibility_changed($idx) unless $self->{IS_FILTER} || ($prev eq $next);"
NSQ_SOURCE_LINE 00001563 "\t$row"
NSQ_SOURCE_LINE 00001564 "}"
NSQ_SOURCE_LINE 00001565 ""
NSQ_SOURCE_LINE 00001566 "=head2 filter"
NSQ_SOURCE_LINE 00001567 ""
NSQ_SOURCE_LINE 00001568 "This will use the given coderef to set the visibility of each row in the table."
NSQ_SOURCE_LINE 00001569 "The coderef will be called once for each row, and should return true for rows"
NSQ_SOURCE_LINE 00001570 "which should be visible, false for rows to be hidden."
NSQ_SOURCE_LINE 00001571 ""
NSQ_SOURCE_LINE 00001572 "The coderef currently takes a single parameter: an arrayref representing the"
NSQ_SOURCE_LINE 00001573 "columns of the row to be processed."
NSQ_SOURCE_LINE 00001574 ""
NSQ_SOURCE_LINE 00001575 " # Hide all rows where the second column contains the text 'OK'"
NSQ_SOURCE_LINE 00001576 " $tbl->filter(sub { shift->[1] ne 'OK' });"
NSQ_SOURCE_LINE 00001577 ""
NSQ_SOURCE_LINE 00001578 "Note that this does not affect row selection: if the multiselect flag is enabled,"
NSQ_SOURCE_LINE 00001579 "it is possible to filter out rows that are selected. This behaviour is by design"
NSQ_SOURCE_LINE 00001580 "(the idea was to allow union select via different filter criteria), call the"
NSQ_SOURCE_LINE 00001581 "L</unselect_hidden_rows> method after filtering if you want to avoid this."
NSQ_SOURCE_LINE 00001582 ""
NSQ_SOURCE_LINE 00001583 "Also note that this is a one-shot operation. If you add or change data, you'll"
NSQ_SOURCE_LINE 00001584 "need to reapply the filter operation manually."
NSQ_SOURCE_LINE 00001585 ""
NSQ_SOURCE_LINE 00001586 "=cut"
NSQ_SOURCE_LINE 00001587 ""
NSQ_SOURCE_LINE 00001588 "sub filter {"
NSQ_SOURCE_LINE 00001589 "\tmy ($self, $filter) = @_;"
NSQ_SOURCE_LINE 00001590 "\t# Defer any updates until we've finished making changes"
NSQ_SOURCE_LINE 00001591 "\tlocal $self->{IS_FILTER} = 1;"
NSQ_SOURCE_LINE 00001592 "\tfor my $idx (0..$self->adapter->count - 1) {"
NSQ_SOURCE_LINE 00001593 "\t\tmy $row = $self->adapter->get($idx);"
NSQ_SOURCE_LINE 00001594 "\t\t$self->row_visibility($idx, $filter->($row));"
NSQ_SOURCE_LINE 00001595 "\t}"
NSQ_SOURCE_LINE 00001596 "\t$self->redraw;"
NSQ_SOURCE_LINE 00001597 "}"
NSQ_SOURCE_LINE 00001598 ""
NSQ_SOURCE_LINE 00001599 "sub apply_filters_to_row {"
NSQ_SOURCE_LINE 00001600 "\tmy ($self, $idx) = @_;"
NSQ_SOURCE_LINE 00001601 "}"
NSQ_SOURCE_LINE 00001602 ""
NSQ_SOURCE_LINE 00001603 "=head2 unselect_hidden_rows"
NSQ_SOURCE_LINE 00001604 ""
NSQ_SOURCE_LINE 00001605 "Helper method to mark any hidden rows as unselected."
NSQ_SOURCE_LINE 00001606 "Call this after L</filter> if you want to avoid confusing"
NSQ_SOURCE_LINE 00001607 "users with invisible selected rows."
NSQ_SOURCE_LINE 00001608 ""
NSQ_SOURCE_LINE 00001609 "=cut"
NSQ_SOURCE_LINE 00001610 ""
NSQ_SOURCE_LINE 00001611 "sub unselect_hidden_rows {"
NSQ_SOURCE_LINE 00001612 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001613 "\tdelete @{$self->{selected}}{"
NSQ_SOURCE_LINE 00001614 "\t\tgrep ref($self->adapter->get($_))->isa('Tickit::Widget::Table::HiddenRow'), 0..$self->adapter->count-1"
NSQ_SOURCE_LINE 00001615 "\t};"
NSQ_SOURCE_LINE 00001616 "\t$self"
NSQ_SOURCE_LINE 00001617 "}"
NSQ_SOURCE_LINE 00001618 ""
NSQ_SOURCE_LINE 00001619 "1;"
NSQ_SOURCE_LINE 00001620 ""
NSQ_SOURCE_LINE 00001621 "__END__"
NSQ_SOURCE_LINE 00001622 ""
NSQ_SOURCE_LINE 00001623 "=head1 TODO"
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 "Current list of pending features:"
NSQ_SOURCE_LINE 00001626 ""
NSQ_SOURCE_LINE 00001627 "=over 4"
NSQ_SOURCE_LINE 00001628 ""
NSQ_SOURCE_LINE 00001629 "=item * Column and cell highlighting modes"
NSQ_SOURCE_LINE 00001630 ""
NSQ_SOURCE_LINE 00001631 "=item * Proper widget-in-cell support"
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "=item * Better header support (more than one row, embedded widgets)"
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "=item * More efficient redraw when showing/hiding header (scroll body and redraw just the header lines)"
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 "=back"
NSQ_SOURCE_LINE 00001638 ""
NSQ_SOURCE_LINE 00001639 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001640 ""
NSQ_SOURCE_LINE 00001641 "Other tables and table-like things:"
NSQ_SOURCE_LINE 00001642 ""
NSQ_SOURCE_LINE 00001643 "=over 4"
NSQ_SOURCE_LINE 00001644 ""
NSQ_SOURCE_LINE 00001645 "=item * L<Tickit::Widget::Table::Paged> - earlier version of this module without adapter support"
NSQ_SOURCE_LINE 00001646 ""
NSQ_SOURCE_LINE 00001647 "=item * L<Text::ANSITable> - not part of L<Tickit> but has some impressive styling capabilities."
NSQ_SOURCE_LINE 00001648 ""
NSQ_SOURCE_LINE 00001649 "=item * L<Term::TablePrint> - again, not part of L<Tickit> but provides an interactive table"
NSQ_SOURCE_LINE 00001650 "via direct terminal access."
NSQ_SOURCE_LINE 00001651 ""
NSQ_SOURCE_LINE 00001652 "=back"
NSQ_SOURCE_LINE 00001653 ""
NSQ_SOURCE_LINE 00001654 "And these are probably important background reading for formatting and data source support:"
NSQ_SOURCE_LINE 00001655 ""
NSQ_SOURCE_LINE 00001656 "=over 4"
NSQ_SOURCE_LINE 00001657 ""
NSQ_SOURCE_LINE 00001658 "=item * L<String::Tagged> - supported for applying custom formatting (specifically, pen attributes)"
NSQ_SOURCE_LINE 00001659 ""
NSQ_SOURCE_LINE 00001660 "=item * L<Adapter::Async> - API for dealing with abstract data sources"
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "=item * L<Adapter::Async::OrderedList> - subclass of the above for our tabular layout API"
NSQ_SOURCE_LINE 00001663 ""
NSQ_SOURCE_LINE 00001664 "=back"
