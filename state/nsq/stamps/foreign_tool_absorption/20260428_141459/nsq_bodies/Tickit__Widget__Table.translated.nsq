NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "=cut"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "sub scrollbar_rect {"
NSQ_SOURCE_LINE 00000540 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000541 "\t$self->{scrollbar_rect} ||= Tickit::Rect->new("
NSQ_SOURCE_LINE 00000542 "\t\ttop   => $self->header_lines,"
NSQ_SOURCE_LINE 00000543 "\t\tbottom => $self->window->lines - 1,"
NSQ_SOURCE_LINE 00000544 "\t\tleft  => $self->window->cols - 1,"
NSQ_SOURCE_LINE 00000545 "\t\tcols  => 1,"
NSQ_SOURCE_LINE 00000546 "\t);"
NSQ_SOURCE_LINE 00000547 "}"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "=head2 hide_header"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "Removes the header - the body will expand upwards to compensate."
NSQ_SOURCE_LINE 00000552 "."
NSQ_SOURCE_LINE 00000553 "=cut"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "sub hide_header {"
NSQ_SOURCE_LINE 00000556 "\tmy ($self) = @_;"
NSQ_SOURCE_LINE 00000557 "\t$self->window->expose if $self->window;"
NSQ_SOURCE_LINE 00000558 "\tdelete @{$self}{qw(body_rect header_rect scrollbar_rect)};"
NSQ_SOURCE_LINE 00000559 "\t$self->{header_visible} = 0;"
NSQ_SOURCE_LINE 00000560 "\t$self"
NSQ_SOURCE_LINE 00000561 "}"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "=head2 show_header"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "Makes the header visible again. See L</hide_header>."
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "=cut"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "sub show_header {"
NSQ_SOURCE_LINE 00000570 "\tmy ($self) = @_;"
NSQ_SOURCE_LINE 00000571 "\t$self->{header_visible} = 1;"
NSQ_SOURCE_LINE 00000572 "\tdelete @{$self}{qw(body_rect header_rect scrollbar_rect)};"
NSQ_SOURCE_LINE 00000573 "\t$self->window->expose if $self->window;"
NSQ_SOURCE_LINE 00000574 "\t$self"
NSQ_SOURCE_LINE 00000575 "}"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "=head2 header_visible"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "Returns true if the header is visible, 0 otherwise."
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "=cut"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "sub header_visible { $_[0]{header_visible} ? 1 : 0 }"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "=head2 header_lines"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "Returns the number of lines in the header. Hardcoded to 1."
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "=cut"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "sub header_lines { $_[0]->header_visible ? $_[0]->{header_lines} : 0 }"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=head2 body_lines"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "Returns the number of lines in the body."
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "=cut"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "sub body_lines { $_[0]->window->lines - $_[0]->header_lines }"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "=head2 body_cols"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "Returns the number of columns in the body."
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "=cut"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "sub body_cols { $_[0]->window->cols - 1 }"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "=head2 idx_from_row"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "Returns a storage index from a body row index."
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "=cut"
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "sub idx_from_row {"
NSQ_SOURCE_LINE 00000616 "\tmy ($self, $row) = @_;"
NSQ_SOURCE_LINE 00000617 "\treturn $self->row_offset + $row - $self->header_lines;"
NSQ_SOURCE_LINE 00000618 "}"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "=head2 row_from_idx"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "Returns a body row index from a storage index."
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "=cut"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "sub row_from_idx {"
NSQ_SOURCE_LINE 00000627 "\tmy ($self, $idx) = @_;"
NSQ_SOURCE_LINE 00000628 "\treturn $self->header_lines + $idx - $self->row_offset;"
NSQ_SOURCE_LINE 00000629 "}"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "=head2 row_cache_idx"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "Returns a row cache offset from a storage index."
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "=cut"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "sub row_cache_idx {"
NSQ_SOURCE_LINE 00000638 "\tmy ($self, $idx) = @_;"
NSQ_SOURCE_LINE 00000639 "\tdie \"no window yet\" unless $self->window;"
NSQ_SOURCE_LINE 00000640 "\treturn $self->body_lines + $idx - $self->row_offset;"
NSQ_SOURCE_LINE 00000641 "}"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "=head2 idx_from_row_cache"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "Returns a storage index from a row cache offset."
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "=cut"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "sub idx_from_row_cache {"
NSQ_SOURCE_LINE 00000650 "\tmy ($self, $row) = @_;"
NSQ_SOURCE_LINE 00000651 "\treturn $row + $self->row_offset - $self->body_lines;"
NSQ_SOURCE_LINE 00000652 "}"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "sub column_width {"
NSQ_SOURCE_LINE 00000655 "\tmy ($self, $idx) = @_;"
NSQ_SOURCE_LINE 00000656 "\t$self->{columns}[$idx]{value};"
NSQ_SOURCE_LINE 00000657 "}"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "=head2 highlight_row"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "Returns the index of the currently-highlighted row."
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "=cut"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "sub highlight_row {"
NSQ_SOURCE_LINE 00000666 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000667 "\treturn $self->{highlight_row};"
NSQ_SOURCE_LINE 00000668 "}"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "=head2 highlight_visible_row"
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "Returns the position of the highlighted row taking scrollbar into account."
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "=cut"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "sub highlight_visible_row {"
NSQ_SOURCE_LINE 00000677 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000678 "\treturn $self->{highlight_row} - $self->row_offset;"
NSQ_SOURCE_LINE 00000679 "}"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "sub loading_message { 'Loading...' }"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "=head1 METHODS - Rendering"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "=head2 render_to_rb"
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "Render the table. Called from expose events."
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "=cut"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "sub render_to_rb {"
NSQ_SOURCE_LINE 00000692 "\tmy ($self, $rb, $rect) = @_;"
NSQ_SOURCE_LINE 00000693 "\tmy $win = $self->window;"
NSQ_SOURCE_LINE 00000694 "\t$self->{highlight_row} ||= 0;"
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "\t$rb->eraserect($rect);"
NSQ_SOURCE_LINE 00000697 "\t$self->render_header($rb, $rect) if $self->header_visible;"
NSQ_SOURCE_LINE 00000698 "\t$self->render_body($rb, $rect);"
NSQ_SOURCE_LINE 00000699 "\t$self->render_scrollbar($rb, $rect) if $self->vscroll;"
NSQ_SOURCE_LINE 00000700 "\tmy $highlight_pos = $self->header_lines + $self->highlight_visible_row;"
NSQ_SOURCE_LINE 00000701 "\t$win->cursor_at($highlight_pos, 0);"
NSQ_SOURCE_LINE 00000702 "}"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "=head2 render_header"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "Render the header area."
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "=cut"
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "sub render_header {"
NSQ_SOURCE_LINE 00000711 "\tmy ($self, $rb, $rect) = @_;"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "\t$rect = $rect->intersect($self->header_rect)"
NSQ_SOURCE_LINE 00000714 "\t\tor return $self;"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "\t$rb->goto(0, 0);"
NSQ_SOURCE_LINE 00000717 "\tfor my $col (0..$#{$self->{columns}}) {"
NSQ_SOURCE_LINE 00000718 "\t\tmy $def = $self->{columns}[$col];"
NSQ_SOURCE_LINE 00000719 "\t\t$self->render_header_cell($rb, $def);"
NSQ_SOURCE_LINE 00000720 "\t}"
NSQ_SOURCE_LINE 00000721 "\t$rb->erase_to($self->window->cols, $self->get_style_pen('padding'));"
NSQ_SOURCE_LINE 00000722 "}"
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "=head2 render_header_cell"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "Render a specific header cell."
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "=cut"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "sub render_header_cell {"
NSQ_SOURCE_LINE 00000731 "\tmy ($self, $rb, $def) = @_;"
NSQ_SOURCE_LINE 00000732 "\tmy $base_pen = $self->get_style_pen("
NSQ_SOURCE_LINE 00000733 "\t\t'header'"
NSQ_SOURCE_LINE 00000734 "\t);"
NSQ_SOURCE_LINE 00000735 "\t$rb->erase_to($def->{start}, $base_pen) if $def->{start};"
NSQ_SOURCE_LINE 00000736 "\tmy ($pre, undef, $post) = align textwidth($def->{label} // ''), $def->{value} // 0, $def->{align} // 0;"
NSQ_SOURCE_LINE 00000737 "\t$rb->erase($pre, $base_pen) if $pre;"
NSQ_SOURCE_LINE 00000738 "\t$rb->text($def->{label} // '', $base_pen);"
NSQ_SOURCE_LINE 00000739 "\t$rb->erase($post, $base_pen) if $post;"
NSQ_SOURCE_LINE 00000740 "}"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "=head2 render_scrollbar"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "Render the scrollbar."
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "=cut"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "sub render_scrollbar {"
NSQ_SOURCE_LINE 00000749 "\tmy ($self, $rb, $rect) = @_;"
NSQ_SOURCE_LINE 00000750 "\treturn $self unless my $win = $self->window;"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "\t$rect = $rect->intersect($self->scrollbar_rect)"
NSQ_SOURCE_LINE 00000753 "\t\tor return $self;"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "\tmy $cols = $win->cols - 1;"
NSQ_SOURCE_LINE 00000756 "\tmy $h = $win->lines - $self->header_lines;"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "\t# Need to clear any line content first, since we may be overwriting part of"
NSQ_SOURCE_LINE 00000759 "\t# the previous scrollbar rendering here"
NSQ_SOURCE_LINE 00000760 "\t$rb->eraserect("
NSQ_SOURCE_LINE 00000761 "\t\tTickit::Rect->new("
NSQ_SOURCE_LINE 00000762 "\t\t\ttop => $self->header_lines,"
NSQ_SOURCE_LINE 00000763 "\t\t\tleft => $cols,"
NSQ_SOURCE_LINE 00000764 "\t\t\tright => $cols,"
NSQ_SOURCE_LINE 00000765 "\t\t\tbottom => $h,"
NSQ_SOURCE_LINE 00000766 "\t\t)"
NSQ_SOURCE_LINE 00000767 "\t);"
NSQ_SOURCE_LINE 00000768 "\tif(my ($min, $max) = map $self->header_lines + $_, $self->scroll_rows) {"
NSQ_SOURCE_LINE 00000769 "\t\t# Scrollbar should be shown, since we don't have all rows visible on the screen at once"
NSQ_SOURCE_LINE 00000770 "\t\t$rb->vline_at($self->header_lines, $min - 1, $cols, LINE_SINGLE, $self->get_style_pen('scrollbar'), CAP_BOTH) if $min > 1;"
NSQ_SOURCE_LINE 00000771 "\t\t$rb->vline_at($min, $max, $cols, LINE_DOUBLE, $self->get_style_pen('scroll'), CAP_BOTH);"
NSQ_SOURCE_LINE 00000772 "\t\t$rb->vline_at($max + 1, $h, $cols, LINE_SINGLE, $self->get_style_pen('scrollbar'), CAP_BOTH) if $max < $h;"
NSQ_SOURCE_LINE 00000773 "\t} else {"
NSQ_SOURCE_LINE 00000774 "\t\t# Placeholder scrollbar - just render it as empty"
NSQ_SOURCE_LINE 00000775 "\t\t$rb->vline_at($self->header_lines, $h, $cols, LINE_SINGLE, $self->get_style_pen('scrollbar'), CAP_BOTH);"
NSQ_SOURCE_LINE 00000776 "\t}"
NSQ_SOURCE_LINE 00000777 "}"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "=head2 render_body"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "Render the table body."
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "=cut"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "sub render_body {"
NSQ_SOURCE_LINE 00000786 "\tmy ($self, $rb, $rect) = @_;"
NSQ_SOURCE_LINE 00000787 "\treturn $self unless my $win = $self->window;"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "\t# Make sure we only step through the parts of"
NSQ_SOURCE_LINE 00000790 "\t# the expose event that relate to the body"
NSQ_SOURCE_LINE 00000791 "\t# area"
NSQ_SOURCE_LINE 00000792 "\t$rect = $rect->intersect($self->body_rect)"
NSQ_SOURCE_LINE 00000793 "\t\tor return $self;"
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "\tfor my $line ($rect->linerange) {"
NSQ_SOURCE_LINE 00000796 "\t\tmy $idx = $self->idx_from_row($line);"
NSQ_SOURCE_LINE 00000797 "\t\tif(my $f = $self->row_cache($idx)) {"
NSQ_SOURCE_LINE 00000798 "\t\t\tif($f->is_done) {"
NSQ_SOURCE_LINE 00000799 "\t\t\t\t$self->render_row($rb, $rect, $idx, $f->get);"
NSQ_SOURCE_LINE 00000800 "\t\t\t} elsif($f->is_ready) {"
NSQ_SOURCE_LINE 00000801 "\t\t\t\t$self->render_failed_row($rb, $rect, $idx, $f->is_cancelled ? 'cancelled' : $self->failure_transform($f->failure));"
NSQ_SOURCE_LINE 00000802 "\t\t\t} else {"
NSQ_SOURCE_LINE 00000803 "\t\t\t\t$self->render_pending_row($rb, $rect, $idx);"
NSQ_SOURCE_LINE 00000804 "\t\t\t\t$f->on_done($self->curry::expose_row($idx));"
NSQ_SOURCE_LINE 00000805 "\t\t\t}"
NSQ_SOURCE_LINE 00000806 "\t\t} else {"
NSQ_SOURCE_LINE 00000807 "\t\t\t$rb->erase_at($line, $rect->left, $rect->cols, $self->get_style_pen);"
NSQ_SOURCE_LINE 00000808 "\t\t}"
NSQ_SOURCE_LINE 00000809 "\t}"
NSQ_SOURCE_LINE 00000810 "}"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "sub failure_transform {"
NSQ_SOURCE_LINE 00000813 "\tmy ($self, $msg) = @_;"
NSQ_SOURCE_LINE 00000814 "\treturn $msg unless my $ft = $self->{failure_transformations};"
NSQ_SOURCE_LINE 00000815 "\t$msg = $_->($msg) for @$ft;"
NSQ_SOURCE_LINE 00000816 "}"
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "=head2 render_row"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "Renders a given row, using storage index."
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "=cut"
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "sub render_row {"
NSQ_SOURCE_LINE 00000825 "\tmy ($self, $rb, $rect, $row, $data) = @_;"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "\tmy $line = $self->row_from_idx($row);"
NSQ_SOURCE_LINE 00000828 "\tmy $base_pen = $self->get_style_pen("
NSQ_SOURCE_LINE 00000829 "\t\t($row == $self->highlight_row)"
NSQ_SOURCE_LINE 00000830 "\t\t? 'highlight'"
NSQ_SOURCE_LINE 00000831 "\t\t: ($self->multi_select && $self->{selected}{$line + $self->row_offset - $self->header_lines})"
NSQ_SOURCE_LINE 00000832 "\t\t? 'selected'"
NSQ_SOURCE_LINE 00000833 "\t\t: undef"
NSQ_SOURCE_LINE 00000834 "\t);"
NSQ_SOURCE_LINE 00000835 "\tfor my $col (0..$#$data) {"
NSQ_SOURCE_LINE 00000836 "\t\tmy $v = $self->apply_view_transformations($row, $col, $data->[$col]) // '';"
NSQ_SOURCE_LINE 00000837 "\t\tmy $def = $self->{columns}[$col];"
NSQ_SOURCE_LINE 00000838 "\t\t$rb->goto($line, $def->{start} // 0);"
NSQ_SOURCE_LINE 00000839 "\t\t# Prevent any vertical whitespace because we only handle single-line widgets, and textwidth() returns"
NSQ_SOURCE_LINE 00000840 "\t\t# undef on \\n"
NSQ_SOURCE_LINE 00000841 "\t\t$v =~ s/\\v+/ /g;"
NSQ_SOURCE_LINE 00000842 "\t\tmy ($pre, undef, $post) = align textwidth($v), $def->{value} // 0, $def->{align} // 0;"
NSQ_SOURCE_LINE 00000843 "\t\t$rb->erase($pre, $base_pen) if $pre;"
NSQ_SOURCE_LINE 00000844 "\t\tif(blessed($v) && $v->isa('String::Tagged')) {"
NSQ_SOURCE_LINE 00000845 "\t\t\t# Copy before modifying, might be overkill?"
NSQ_SOURCE_LINE 00000846 "\t\t\tmy $st = String::Tagged->new($v);"
NSQ_SOURCE_LINE 00000847 "\t\t\t$st->merge_tags(sub {"
NSQ_SOURCE_LINE 00000848 "\t\t\t\tmy ($k, $left, $right) = @_;"
NSQ_SOURCE_LINE 00000849 "\t\t\t\treturn $left eq $right;"
NSQ_SOURCE_LINE 00000850 "\t\t\t});"
NSQ_SOURCE_LINE 00000851 "\t\t\t$st->iter_substr_nooverlap(sub {"
NSQ_SOURCE_LINE 00000852 "\t\t\t\tmy ($substr, %tags) = @_;"
NSQ_SOURCE_LINE 00000853 "\t\t\t\tmy %attr = ("
NSQ_SOURCE_LINE 00000854 "\t\t\t\t\t$base_pen->getattrs,"
NSQ_SOURCE_LINE 00000855 "\t\t\t\t\t%tags"
NSQ_SOURCE_LINE 00000856 "\t\t\t\t);"
NSQ_SOURCE_LINE 00000857 "\t\t\t\tmy $pen = Tickit::Pen::Immutable->new(%attr);"
NSQ_SOURCE_LINE 00000858 "\t\t\t\t$rb->text($substr, $pen);"
NSQ_SOURCE_LINE 00000859 "\t\t\t});"
NSQ_SOURCE_LINE 00000860 "\t\t} else {"
NSQ_SOURCE_LINE 00000861 "\t\t\t$rb->text($v, $base_pen);"
NSQ_SOURCE_LINE 00000862 "\t\t}"
NSQ_SOURCE_LINE 00000863 "\t\t$rb->erase($post, $base_pen) if $post;"
NSQ_SOURCE_LINE 00000864 "\t\tmy $target = $col < $#$data ? $self->{columns}[$col + 1]->{start} : $self->body_cols;"
NSQ_SOURCE_LINE 00000865 "\t\t$rb->erase_to($target, $base_pen) if $target;"
NSQ_SOURCE_LINE 00000866 "\t}"
NSQ_SOURCE_LINE 00000867 "}"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "sub render_failed_row {"
NSQ_SOURCE_LINE 00000870 "\tmy ($self, $rb, $rect, $row, $failure) = @_;"
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "\tmy $line = $self->row_from_idx($row);"
NSQ_SOURCE_LINE 00000873 "\tmy $base_pen = $self->get_style_pen("
NSQ_SOURCE_LINE 00000874 "\t\t($row == $self->highlight_row)"
NSQ_SOURCE_LINE 00000875 "\t\t? 'highlight'"
NSQ_SOURCE_LINE 00000876 "\t\t: ($self->multi_select && $self->{selected}{$line + $self->row_offset - $self->header_lines})"
NSQ_SOURCE_LINE 00000877 "\t\t? 'selected'"
NSQ_SOURCE_LINE 00000878 "\t\t: 'failed'"
NSQ_SOURCE_LINE 00000879 "\t);"
NSQ_SOURCE_LINE 00000880 ""
NSQ_SOURCE_LINE 00000881 "\t$rb->goto($line, 0);"
NSQ_SOURCE_LINE 00000882 "\t($failure //= '') =~ s/\\v+/ /g;"
NSQ_SOURCE_LINE 00000883 "\tmy $w = textwidth($failure);"
NSQ_SOURCE_LINE 00000884 "\tdie \"undef \\$w from $failure\" unless defined $w;"
NSQ_SOURCE_LINE 00000885 "\tmy ($pre, undef, $post) = align $w, $self->body_cols // 1, 0.5;"
NSQ_SOURCE_LINE 00000886 "\t$rb->erase($pre, $base_pen) if $pre;"
NSQ_SOURCE_LINE 00000887 "\t$rb->text($failure, $base_pen);"
NSQ_SOURCE_LINE 00000888 "\t$rb->erase($post, $base_pen) if $post;"
NSQ_SOURCE_LINE 00000889 "}"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "sub render_pending_row {"
NSQ_SOURCE_LINE 00000892 "\tmy ($self, $rb, $rect, $row) = @_;"
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "\tmy $line = $self->row_from_idx($row);"
NSQ_SOURCE_LINE 00000895 "\tmy $base_pen = $self->get_style_pen("
NSQ_SOURCE_LINE 00000896 "\t\t($row == $self->highlight_row)"
NSQ_SOURCE_LINE 00000897 "\t\t? 'highlight'"
NSQ_SOURCE_LINE 00000898 "\t\t: ($self->multi_select && $self->{selected}{$line + $self->row_offset - $self->header_lines})"
NSQ_SOURCE_LINE 00000899 "\t\t? 'selected'"
NSQ_SOURCE_LINE 00000900 "\t\t: 'pending'"
NSQ_SOURCE_LINE 00000901 "\t);"
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "\t$rb->goto($line, 0);"
NSQ_SOURCE_LINE 00000904 "\tmy ($pre, undef, $post) = align textwidth($self->loading_message // ''), $self->body_cols // 1, 0.5;"
NSQ_SOURCE_LINE 00000905 "\t$rb->erase($pre, $base_pen) if $pre;"
NSQ_SOURCE_LINE 00000906 "\t$rb->text($self->loading_message, $base_pen);"
NSQ_SOURCE_LINE 00000907 "\t$rb->erase($post, $base_pen) if $post;"
NSQ_SOURCE_LINE 00000908 "}"
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "=head2 on_scroll"
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "Update row cache to reflect a scroll event."
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "=cut"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "sub on_scroll {"
NSQ_SOURCE_LINE 00000917 "\tmy ($self, $offset) = @_;"
NSQ_SOURCE_LINE 00000918 "\tdie \"undef offset\" unless defined $offset;"
NSQ_SOURCE_LINE 00000919 ""
NSQ_SOURCE_LINE 00000920 "\t# Our row cache is a scrolling fixed-size window over the previous,"
NSQ_SOURCE_LINE 00000921 "\t# current and next page, so any removals need to be compensated by"
NSQ_SOURCE_LINE 00000922 "\t# empty items at the other end"
NSQ_SOURCE_LINE 00000923 "\tmy @replace = (undef) x ($offset < 0 ? -$offset : $offset);"
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "\tmy @removed;"
NSQ_SOURCE_LINE 00000926 "\tif($offset > 0) {"
NSQ_SOURCE_LINE 00000927 "\t\t# Scrolling down means we throw away the first N rows"
NSQ_SOURCE_LINE 00000928 "\t\t@removed = splice @{$self->{row_cache}}, 0, $offset;"
NSQ_SOURCE_LINE 00000929 "\t\tpush @{$self->{row_cache}}, @replace;"
NSQ_SOURCE_LINE 00000930 "\t} else {"
NSQ_SOURCE_LINE 00000931 "\t\t# and in the other direction, last N rows"
NSQ_SOURCE_LINE 00000932 "\t\t@removed = splice @{$self->{row_cache}}, @{$self->{row_cache}} + $offset, -$offset, @replace;"
NSQ_SOURCE_LINE 00000933 "\t\tunshift @{$self->{row_cache}}, @replace;"
NSQ_SOURCE_LINE 00000934 "\t}"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "\t# Any items that were still in progress are no longer required, make"
NSQ_SOURCE_LINE 00000937 "\t# sure we cancel them to avoid unnecessary work."
NSQ_SOURCE_LINE 00000938 "\t$_->cancel for grep defined($_) && !$_->is_ready, @removed;"
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "\treturn $self if exists $self->{cache_primer};"
NSQ_SOURCE_LINE 00000941 "\t$self->{cache_primer} = 1;"
NSQ_SOURCE_LINE 00000942 "\t$self->window->tickit->later(sub {"
NSQ_SOURCE_LINE 00000943 "\t\t# Prime the cache for the missing entries"
NSQ_SOURCE_LINE 00000944 "\t\t$self->row_cache($self->idx_from_row_cache($_)) for grep !defined($self->{row_cache}[$_]), 0..$#{$self->{row_cache}}; "
NSQ_SOURCE_LINE 00000945 "\t\tdelete $self->{cache_primer};"
NSQ_SOURCE_LINE 00000946 "\t});"
NSQ_SOURCE_LINE 00000947 "\t$self"
NSQ_SOURCE_LINE 00000948 "}"
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "=head2 fold_future"
NSQ_SOURCE_LINE 00000951 ""
NSQ_SOURCE_LINE 00000952 "Helper method to apply a series of coderefs to a value."
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "=cut"
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "sub fold_future {"
NSQ_SOURCE_LINE 00000957 "\tmy ($self, $prefix, $item, @steps) = @_;"
NSQ_SOURCE_LINE 00000958 "\treturn Future->wrap($item) unless @steps;"
NSQ_SOURCE_LINE 00000959 "\ttry_repeat {"
NSQ_SOURCE_LINE 00000960 "\t\tmy $code = shift;"
NSQ_SOURCE_LINE 00000961 "\t\tFuture->call(sub { $code->(@$prefix, $item) })->on_done(sub {"
NSQ_SOURCE_LINE 00000962 "\t\t\t$item = shift"
NSQ_SOURCE_LINE 00000963 "\t\t})"
NSQ_SOURCE_LINE 00000964 "\t} foreach => \\@steps"
NSQ_SOURCE_LINE 00000965 "}"
NSQ_SOURCE_LINE 00000966 ""
NSQ_SOURCE_LINE 00000967 "sub update_row_cache {"
NSQ_SOURCE_LINE 00000968 "\tmy ($self, $row) = @_;"
NSQ_SOURCE_LINE 00000969 "\tundef $self->{row_cache}[$self->row_cache_idx($row)];"
NSQ_SOURCE_LINE 00000970 "\t$self->row_cache($row)->on_ready(sub {"
NSQ_SOURCE_LINE 00000971 "\t\t$self->expose_row($row);"
NSQ_SOURCE_LINE 00000972 "\t});"
NSQ_SOURCE_LINE 00000973 "}"
NSQ_SOURCE_LINE 00000974 ""
NSQ_SOURCE_LINE 00000975 "=head2 row_cache"
NSQ_SOURCE_LINE 00000976 ""
NSQ_SOURCE_LINE 00000977 "Row cache accessor."
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "=cut"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "sub row_cache {"
NSQ_SOURCE_LINE 00000982 "\tmy ($self, $row) = @_;"
NSQ_SOURCE_LINE 00000983 "\t$self->{row_cache}[$self->row_cache_idx($row)] ||= do {"
NSQ_SOURCE_LINE 00000984 "\t\tmy $found;"
NSQ_SOURCE_LINE 00000985 "\t\t$self->adapter->range("
NSQ_SOURCE_LINE 00000986 "\t\t\tstart => $row,"
NSQ_SOURCE_LINE 00000987 "\t\t\tcount => 1,"
NSQ_SOURCE_LINE 00000988 "\t\t\ton_item => sub {"
NSQ_SOURCE_LINE 00000989 "\t\t\t\t# We have an item from storage. No idea what it is, could be an"
NSQ_SOURCE_LINE 00000990 "\t\t\t\t# object, hashref, arrayref... the item transformations will"
NSQ_SOURCE_LINE 00000991 "\t\t\t\t# convert it into something usable"
NSQ_SOURCE_LINE 00000992 "\t\t\t\tmy ($idx, $item) = @_;"
NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "\t\t\t\t# Somewhat tedious way to reduce() a Future chain"
NSQ_SOURCE_LINE 00000995 "\t\t\t\t$found = $self->fold_future([ $row ], $item, @{$self->{item_transformations}})"
NSQ_SOURCE_LINE 00000996 "\t\t\t}"
NSQ_SOURCE_LINE 00000997 "\t\t)->then(sub {"
NSQ_SOURCE_LINE 00000998 "\t\t\t$found || Future->done"
NSQ_SOURCE_LINE 00000999 "\t\t})->then(sub {"
NSQ_SOURCE_LINE 00001000 "\t\t\t# Our item is now accessible as an arrayref, start working on the columns"
NSQ_SOURCE_LINE 00001001 "\t\t\treturn Future->done unless @_;"
NSQ_SOURCE_LINE 00001002 "\t\t\tmy ($item) = @_;"
NSQ_SOURCE_LINE 00001003 "\t\t\tmy @pending;"
NSQ_SOURCE_LINE 00001004 "\t\t\tfor my $col (0..$#{$self->{columns}}) {"
NSQ_SOURCE_LINE 00001005 "\t\t\t\tmy $cell = $item->[$col];"
NSQ_SOURCE_LINE 00001006 "\t\t\t\tpush @pending, ("
NSQ_SOURCE_LINE 00001007 "\t\t\t\t\t$self->fold_future([ $row, $col ], $cell, @{$self->{columns}[$col]{transform} || [] })"
NSQ_SOURCE_LINE 00001008 "\t\t\t\t)->then(sub {"
NSQ_SOURCE_LINE 00001009 "\t\t\t\t\t# hey look at all these optimisations we're not doing"
NSQ_SOURCE_LINE 00001010 "\t\t\t\t\t$self->fold_future([ $row, $col ], shift, @{$self->{cell_transformations}{\"$row,$col\"} || []})"
NSQ_SOURCE_LINE 00001011 "\t\t\t\t})->on_fail(sub { warn \"Fail: @_\\n\" })"
NSQ_SOURCE_LINE 00001012 "\t\t\t}"
NSQ_SOURCE_LINE 00001013 "\t\t\t# our transform at the tail of each Future chain should ensure that we"
NSQ_SOURCE_LINE 00001014 "\t\t\t# end up with a helpful list of cells for this item. One last thing to"
NSQ_SOURCE_LINE 00001015 "\t\t\t# do: bundle that back into an arrayref, because Reasons."
NSQ_SOURCE_LINE 00001016 "\t\t\tFuture->needs_all(@pending)->transform("
NSQ_SOURCE_LINE 00001017 "\t\t\t\tdone => sub { [ @_ ] }"
NSQ_SOURCE_LINE 00001018 "\t\t\t)"
NSQ_SOURCE_LINE 00001019 "\t\t})"
NSQ_SOURCE_LINE 00001020 "\t};"
NSQ_SOURCE_LINE 00001021 "}"
NSQ_SOURCE_LINE 00001022 ""
NSQ_SOURCE_LINE 00001023 "=head2 apply_view_transformations"
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "Apply the transformations just before we render. Can return anything we know how to render."
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "=cut"
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "sub apply_view_transformations {"
NSQ_SOURCE_LINE 00001030 "\tmy ($self, $line, $col, $v) = @_;"
NSQ_SOURCE_LINE 00001031 "\t$v = $_->($line, $col, $v) for @{$self->{view_transformations}};"
NSQ_SOURCE_LINE 00001032 "\t$v"
NSQ_SOURCE_LINE 00001033 "}"
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 "=head2 reshape"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "Handle reshape requests."
NSQ_SOURCE_LINE 00001038 ""
NSQ_SOURCE_LINE 00001039 "=cut"
NSQ_SOURCE_LINE 00001040 ""
NSQ_SOURCE_LINE 00001041 "sub reshape {"
NSQ_SOURCE_LINE 00001042 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001043 "\tdelete @{$self}{qw(body_rect header_rect scrollbar_rect)};"
NSQ_SOURCE_LINE 00001044 "\t$self->SUPER::reshape(@_);"
NSQ_SOURCE_LINE 00001045 "\t# Clear cache on resize... not great but avoids rendering glitches for now."
NSQ_SOURCE_LINE 00001046 "\t$self->{row_cache} = ["
NSQ_SOURCE_LINE 00001047 "\t\t(undef) x ($self->body_lines * 3)"
NSQ_SOURCE_LINE 00001048 "\t];"
NSQ_SOURCE_LINE 00001049 "\t$self->distribute_columns;"
NSQ_SOURCE_LINE 00001050 "\t$self->window->expose;"
NSQ_SOURCE_LINE 00001051 "}"
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "=head2 distribute_columns"
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 "Distribute space between columns."
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "=cut"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "sub distribute_columns {"
NSQ_SOURCE_LINE 00001060 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001061 "\tmy $pad = $self->get_style_values('cell_padding');"
NSQ_SOURCE_LINE 00001062 "\tmy @spacing = @{$self->{columns}};"
NSQ_SOURCE_LINE 00001063 "\t(undef, @spacing) = map {;"
NSQ_SOURCE_LINE 00001064 "\t\t+{"
NSQ_SOURCE_LINE 00001065 "\t\t\tbase => $pad,"
NSQ_SOURCE_LINE 00001066 "\t\t\texpand => 0,"
NSQ_SOURCE_LINE 00001067 "\t\t\ttype => 'padding'"
NSQ_SOURCE_LINE 00001068 "\t\t},"
NSQ_SOURCE_LINE 00001069 "\t\t$_"
NSQ_SOURCE_LINE 00001070 "\t} @spacing if $pad;"
NSQ_SOURCE_LINE 00001071 "\tmy $cols = $self->window->cols;"
NSQ_SOURCE_LINE 00001072 "\t--$cols if $self->vscroll;"
NSQ_SOURCE_LINE 00001073 "\tdistribute $cols, @spacing;"
NSQ_SOURCE_LINE 00001074 "\t$self"
NSQ_SOURCE_LINE 00001075 "}"
NSQ_SOURCE_LINE 00001076 ""
NSQ_SOURCE_LINE 00001077 "=head2 window_gained"
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "Called when a window has been assigned to the widget."
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "=cut"
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "sub window_gained {"
NSQ_SOURCE_LINE 00001084 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001085 "\t$self->SUPER::window_gained(@_);"
NSQ_SOURCE_LINE 00001086 "\tmy $win = $self->window;"
NSQ_SOURCE_LINE 00001087 "\t$self->distribute_columns;"
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "\t# Row cache starts as empty. We should really"
NSQ_SOURCE_LINE 00001090 "\t# preserve any previous values here."
NSQ_SOURCE_LINE 00001091 "\t$self->{row_cache} = ["
NSQ_SOURCE_LINE 00001092 "\t\t(undef) x ($self->body_lines * 3)"
NSQ_SOURCE_LINE 00001093 "\t];"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "\t# Default anyway in newer versions"
NSQ_SOURCE_LINE 00001096 "\t$win->set_expose_after_scroll(1) if $win->can('set_expose_after_scroll');"
NSQ_SOURCE_LINE 00001097 "}"
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "=head2 expose_rows"
NSQ_SOURCE_LINE 00001100 ""
NSQ_SOURCE_LINE 00001101 "Expose the given rows."
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 "=cut"
NSQ_SOURCE_LINE 00001104 ""
NSQ_SOURCE_LINE 00001105 "sub expose_rows {"
NSQ_SOURCE_LINE 00001106 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001107 "\treturn $self unless my $win = $self->window;"
NSQ_SOURCE_LINE 00001108 "\tmy $cols = $win->cols;"
NSQ_SOURCE_LINE 00001109 "\tmap Tickit::Rect->new("
NSQ_SOURCE_LINE 00001110 "\t\ttop => $_,"
NSQ_SOURCE_LINE 00001111 "\t\tleft => 0,"
NSQ_SOURCE_LINE 00001112 "\t\tlines => 2,"
NSQ_SOURCE_LINE 00001113 "\t\tcols => $cols"
NSQ_SOURCE_LINE 00001114 "\t), @_;"
NSQ_SOURCE_LINE 00001115 "}"
NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "=head2 scroll_highlight"
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 "Update scroll information after changing highlight position."
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 "=cut"
NSQ_SOURCE_LINE 00001122 ""
NSQ_SOURCE_LINE 00001123 "sub scroll_highlight {"
NSQ_SOURCE_LINE 00001124 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001125 "\tmy $offset = shift;"
NSQ_SOURCE_LINE 00001126 "\treturn $self unless my $win = $self->window;"
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "\tif($self->highlight_row + $offset < 0) {"
NSQ_SOURCE_LINE 00001129 "\t\t$offset = -$self->highlight_row;"
NSQ_SOURCE_LINE 00001130 "\t}"
NSQ_SOURCE_LINE 00001131 "\tif($self->highlight_row + $offset > $self->row_count - 1) {"
NSQ_SOURCE_LINE 00001132 "\t\t$offset = $self->row_count - $self->highlight_row;"
NSQ_SOURCE_LINE 00001133 "\t}"
NSQ_SOURCE_LINE 00001134 "\treturn $self unless my $scrollbar_rect = $self->active_scrollbar_rect;"
NSQ_SOURCE_LINE 00001135 "\tmy $old = $self->highlight_visible_row;"
NSQ_SOURCE_LINE 00001136 ""
NSQ_SOURCE_LINE 00001137 "\t# FIXME Work out the changed extents on the"
NSQ_SOURCE_LINE 00001138 "\t# scrollbar, and just update those - note that"
NSQ_SOURCE_LINE 00001139 "\t# T::W::ScrollBar should already have this logic"
NSQ_SOURCE_LINE 00001140 "\t# somewhere, as does ProgressBar"
NSQ_SOURCE_LINE 00001141 "\tmy $redraw_rect = Tickit::RectSet->new;"
NSQ_SOURCE_LINE 00001142 "\t$redraw_rect->add($scrollbar_rect);"
NSQ_SOURCE_LINE 00001143 ""
NSQ_SOURCE_LINE 00001144 "\t$self->{highlight_row} += $offset;"
NSQ_SOURCE_LINE 00001145 "\t$self->{row_offset} += $offset;"
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 "\t$redraw_rect->add($scrollbar_rect->translate($offset, 0));"
NSQ_SOURCE_LINE 00001148 "\t$redraw_rect->add($_) for $self->expose_rows($old, $self->highlight_visible_row);"
NSQ_SOURCE_LINE 00001149 ""
NSQ_SOURCE_LINE 00001150 "\tmy $hdr = $self->header_lines;"
NSQ_SOURCE_LINE 00001151 "\t$win->scrollrect($hdr, 0, $win->lines - $hdr, $win->cols, $offset, 0);"
NSQ_SOURCE_LINE 00001152 "\t$self->on_scroll($offset);"
NSQ_SOURCE_LINE 00001153 "\t$win->expose($_) for map $_->translate(-$offset, 0), $redraw_rect->rects;"
NSQ_SOURCE_LINE 00001154 "}"
NSQ_SOURCE_LINE 00001155 ""
NSQ_SOURCE_LINE 00001156 "=head2 move_highlight"
NSQ_SOURCE_LINE 00001157 ""
NSQ_SOURCE_LINE 00001158 "Move the highlighted row by the given offset (can be negative to move up)."
NSQ_SOURCE_LINE 00001159 ""
NSQ_SOURCE_LINE 00001160 "=cut"
NSQ_SOURCE_LINE 00001161 ""
NSQ_SOURCE_LINE 00001162 "sub move_highlight {"
NSQ_SOURCE_LINE 00001163 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001164 "\tmy $offset = shift;"
NSQ_SOURCE_LINE 00001165 "\treturn $self unless my $win = $self->window;"
NSQ_SOURCE_LINE 00001166 ""
NSQ_SOURCE_LINE 00001167 "\tmy $old = $self->highlight_visible_row;"
NSQ_SOURCE_LINE 00001168 "\t$self->{highlight_row} += $offset;"
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 "\t$win->expose($_) for $self->expose_rows($old, $self->highlight_visible_row);"
NSQ_SOURCE_LINE 00001171 "\t$self"
NSQ_SOURCE_LINE 00001172 "}"
NSQ_SOURCE_LINE 00001173 ""
NSQ_SOURCE_LINE 00001174 "=head2 scroll_position"
