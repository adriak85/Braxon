NSQ_SOURCE_LINE 00000495 "Current row offset (vertical scroll position)."
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "=cut"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "sub row_offset { shift->{row_offset} //= 0 }"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=head2 header_rect"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "Returns the L<Tickit::Rect> representing the header area."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=cut"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "sub header_rect {"
NSQ_SOURCE_LINE 00000508 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000509 "\t$self->{header_rect} ||= Tickit::Rect->new("
NSQ_SOURCE_LINE 00000510 "\t\ttop   => 0,"
NSQ_SOURCE_LINE 00000511 "\t\tlines => $self->header_lines,"
NSQ_SOURCE_LINE 00000512 "\t\tleft  => 0,"
NSQ_SOURCE_LINE 00000513 "\t\tcols  => $self->window->cols"
NSQ_SOURCE_LINE 00000514 "\t);"
NSQ_SOURCE_LINE 00000515 "}"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=head2 body_rect"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "Returns the L<Tickit::Rect> representing the body area."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "=cut"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "sub body_rect {"
NSQ_SOURCE_LINE 00000524 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000525 "\t$self->{body_rect} ||= Tickit::Rect->new("
NSQ_SOURCE_LINE 00000526 "\t\ttop   => $self->header_lines,"
NSQ_SOURCE_LINE 00000527 "\t\tlines => $self->window->lines - $self->header_lines,"
NSQ_SOURCE_LINE 00000528 "\t\tleft  => 0,"
NSQ_SOURCE_LINE 00000529 "\t\tcols  => $self->window->cols - 1"
NSQ_SOURCE_LINE 00000530 "\t);"
NSQ_SOURCE_LINE 00000531 "}"
NSQ_SOURCE_LINE 00000532 ""
