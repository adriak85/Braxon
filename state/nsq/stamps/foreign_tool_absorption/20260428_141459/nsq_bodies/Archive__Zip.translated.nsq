NSQ_SOURCE_LINE 00000324 "# Convenience functions"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "sub _ISA ($$) {"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "    # Can't rely on Scalar::Util, so use the next best way"
NSQ_SOURCE_LINE 00000329 "    local $@;"
NSQ_SOURCE_LINE 00000330 "    !!eval { ref $_[0] and $_[0]->isa($_[1]) };"
NSQ_SOURCE_LINE 00000331 "}"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "sub _CAN ($$) {"
NSQ_SOURCE_LINE 00000334 "    local $@;"
NSQ_SOURCE_LINE 00000335 "    !!eval { ref $_[0] and $_[0]->can($_[1]) };"
NSQ_SOURCE_LINE 00000336 "}"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "#####################################################################"
NSQ_SOURCE_LINE 00000339 "# Methods"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "sub new {"
NSQ_SOURCE_LINE 00000342 "    my $class = shift;"
NSQ_SOURCE_LINE 00000343 "    return Archive::Zip::Archive->new(@_);"
NSQ_SOURCE_LINE 00000344 "}"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "sub computeCRC32 {"
NSQ_SOURCE_LINE 00000347 "    my ($data, $crc);"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "    if (ref($_[0]) eq 'HASH') {"
NSQ_SOURCE_LINE 00000350 "        $data = $_[0]->{string};"
NSQ_SOURCE_LINE 00000351 "        $crc  = $_[0]->{checksum};"
NSQ_SOURCE_LINE 00000352 "    } else {"
NSQ_SOURCE_LINE 00000353 "        $data = shift;"
NSQ_SOURCE_LINE 00000354 "        $data = shift if ref($data);"
NSQ_SOURCE_LINE 00000355 "        $crc  = shift;"
NSQ_SOURCE_LINE 00000356 "    }"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "    return Compress::Raw::Zlib::crc32($data, $crc);"
NSQ_SOURCE_LINE 00000359 "}"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "# Report or change chunk size used for reading and writing."
NSQ_SOURCE_LINE 00000362 "# Also sets Zlib's default buffer size (eventually)."
NSQ_SOURCE_LINE 00000363 "sub setChunkSize {"
NSQ_SOURCE_LINE 00000364 "    shift if ref($_[0]) eq 'Archive::Zip::Archive';"
NSQ_SOURCE_LINE 00000365 "    my $chunkSize = (ref($_[0]) eq 'HASH') ? shift->{chunkSize} : shift;"
NSQ_SOURCE_LINE 00000366 "    my $oldChunkSize = $Archive::Zip::ChunkSize;"
NSQ_SOURCE_LINE 00000367 "    $Archive::Zip::ChunkSize = $chunkSize if ($chunkSize);"
NSQ_SOURCE_LINE 00000368 "    return $oldChunkSize;"
NSQ_SOURCE_LINE 00000369 "}"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "sub chunkSize {"
NSQ_SOURCE_LINE 00000372 "    return $Archive::Zip::ChunkSize;"
NSQ_SOURCE_LINE 00000373 "}"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "sub setErrorHandler {"
NSQ_SOURCE_LINE 00000376 "    my $errorHandler = (ref($_[0]) eq 'HASH') ? shift->{subroutine} : shift;"
NSQ_SOURCE_LINE 00000377 "    $errorHandler = \\&Carp::carp unless defined($errorHandler);"
NSQ_SOURCE_LINE 00000378 "    my $oldErrorHandler = $Archive::Zip::ErrorHandler;"
NSQ_SOURCE_LINE 00000379 "    $Archive::Zip::ErrorHandler = $errorHandler;"
NSQ_SOURCE_LINE 00000380 "    return $oldErrorHandler;"
NSQ_SOURCE_LINE 00000381 "}"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "######################################################################"
NSQ_SOURCE_LINE 00000384 "# Private utility functions (not methods)."
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "sub _printError {"
NSQ_SOURCE_LINE 00000387 "    my $string = join(' ', @_, \"\\n\");"
NSQ_SOURCE_LINE 00000388 "    my $oldCarpLevel = $Carp::CarpLevel;"
NSQ_SOURCE_LINE 00000389 "    $Carp::CarpLevel += 2;"
NSQ_SOURCE_LINE 00000390 "    &{$ErrorHandler}($string);"
NSQ_SOURCE_LINE 00000391 "    $Carp::CarpLevel = $oldCarpLevel;"
NSQ_SOURCE_LINE 00000392 "}"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "# This is called on format errors."
NSQ_SOURCE_LINE 00000395 "sub _formatError {"
NSQ_SOURCE_LINE 00000396 "    shift if ref($_[0]);"
NSQ_SOURCE_LINE 00000397 "    _printError('format error:', @_);"
NSQ_SOURCE_LINE 00000398 "    return AZ_FORMAT_ERROR;"
NSQ_SOURCE_LINE 00000399 "}"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "# This is called on IO errors."
NSQ_SOURCE_LINE 00000402 "sub _ioError {"
NSQ_SOURCE_LINE 00000403 "    shift if ref($_[0]);"
NSQ_SOURCE_LINE 00000404 "    _printError('IO error:', @_, ':', $!);"
NSQ_SOURCE_LINE 00000405 "    return AZ_IO_ERROR;"
NSQ_SOURCE_LINE 00000406 "}"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "# This is called on generic errors."
NSQ_SOURCE_LINE 00000409 "sub _error {"
NSQ_SOURCE_LINE 00000410 "    shift if ref($_[0]);"
NSQ_SOURCE_LINE 00000411 "    _printError('error:', @_);"
NSQ_SOURCE_LINE 00000412 "    return AZ_ERROR;"
NSQ_SOURCE_LINE 00000413 "}"
NSQ_SOURCE_LINE 00000414 ""
