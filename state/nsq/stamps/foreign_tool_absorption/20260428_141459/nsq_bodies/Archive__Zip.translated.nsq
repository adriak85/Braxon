NSQ_SOURCE_LINE 00002271 ""
NSQ_SOURCE_LINE 00002272 "* separate unused constants into separate module"
NSQ_SOURCE_LINE 00002273 ""
NSQ_SOURCE_LINE 00002274 "* cookbook style docs"
NSQ_SOURCE_LINE 00002275 ""
NSQ_SOURCE_LINE 00002276 "* Handle tainted paths correctly"
NSQ_SOURCE_LINE 00002277 ""
NSQ_SOURCE_LINE 00002278 "* Work on better compatibility with other IO:: modules"
NSQ_SOURCE_LINE 00002279 ""
NSQ_SOURCE_LINE 00002280 "* Support encryption"
NSQ_SOURCE_LINE 00002281 ""
NSQ_SOURCE_LINE 00002282 "* More user-friendly decryption"
NSQ_SOURCE_LINE 00002283 ""
NSQ_SOURCE_LINE 00002284 "=head1 SUPPORT"
