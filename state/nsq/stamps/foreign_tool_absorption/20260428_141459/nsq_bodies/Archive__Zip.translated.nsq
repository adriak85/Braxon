NSQ_SOURCE_LINE 00000416 "# required."
NSQ_SOURCE_LINE 00000417 "sub _zip64NotSupported {"
NSQ_SOURCE_LINE 00000418 "    shift if ref($_[0]);"
NSQ_SOURCE_LINE 00000419 "    _printError('zip64 format not supported on this Perl interpreter');"
NSQ_SOURCE_LINE 00000420 "    return AZ_ERROR;"
NSQ_SOURCE_LINE 00000421 "}"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "# Called when a subclass should have implemented"
NSQ_SOURCE_LINE 00000424 "# something but didn't"
NSQ_SOURCE_LINE 00000425 "sub _subclassResponsibility {"
NSQ_SOURCE_LINE 00000426 "    Carp::croak(\"subclass Responsibility\\n\");"
NSQ_SOURCE_LINE 00000427 "}"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "# Try to set the given file handle or object into binary mode."
NSQ_SOURCE_LINE 00000430 "sub _binmode {"
NSQ_SOURCE_LINE 00000431 "    my $fh = shift;"
NSQ_SOURCE_LINE 00000432 "    return _CAN($fh, 'binmode') ? $fh->binmode() : binmode($fh);"
NSQ_SOURCE_LINE 00000433 "}"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "# Attempt to guess whether file handle is seekable."
NSQ_SOURCE_LINE 00000436 "# Because of problems with Windows, this only returns true when"
NSQ_SOURCE_LINE 00000437 "# the file handle is a real file."
NSQ_SOURCE_LINE 00000438 "sub _isSeekable {"
NSQ_SOURCE_LINE 00000439 "    my $fh = shift;"
NSQ_SOURCE_LINE 00000440 "    return 0 unless ref $fh;"
NSQ_SOURCE_LINE 00000441 "    _ISA($fh, \"IO::Scalar\")    # IO::Scalar objects are brokenly-seekable"
NSQ_SOURCE_LINE 00000442 "      and return 0;"
NSQ_SOURCE_LINE 00000443 "    _ISA($fh, \"IO::String\")"
NSQ_SOURCE_LINE 00000444 "      and return 1;"
NSQ_SOURCE_LINE 00000445 "    if (_ISA($fh, \"IO::Seekable\")) {"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "        # Unfortunately, some things like FileHandle objects"
NSQ_SOURCE_LINE 00000448 "        # return true for Seekable, but AREN'T!!!!!"
NSQ_SOURCE_LINE 00000449 "        _ISA($fh, \"FileHandle\")"
NSQ_SOURCE_LINE 00000450 "          and return 0;"
NSQ_SOURCE_LINE 00000451 "        return 1;"
NSQ_SOURCE_LINE 00000452 "    }"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "    # open my $fh, \"+<\", \\$data;"
NSQ_SOURCE_LINE 00000455 "    ref $fh eq \"GLOB\" && eval { seek $fh, 0, 1 } and return 1;"
NSQ_SOURCE_LINE 00000456 "    _CAN($fh, \"stat\")"
NSQ_SOURCE_LINE 00000457 "      and return -f $fh;"
NSQ_SOURCE_LINE 00000458 "    return (_CAN($fh, \"seek\") and _CAN($fh, \"tell\")) ? 1 : 0;"
NSQ_SOURCE_LINE 00000459 "}"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "# Print to the filehandle, while making sure the pesky Perl special global"
NSQ_SOURCE_LINE 00000462 "# variables don't interfere."
NSQ_SOURCE_LINE 00000463 "sub _print {"
NSQ_SOURCE_LINE 00000464 "    my ($self, $fh, @data) = @_;"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "    local $\\;"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "    return $fh->print(@data);"
NSQ_SOURCE_LINE 00000469 "}"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "# Return an opened IO::Handle"
NSQ_SOURCE_LINE 00000472 "# my ( $status, fh ) = _newFileHandle( 'fileName', 'w' );"
NSQ_SOURCE_LINE 00000473 "# Can take a filename, file handle, or ref to GLOB"
NSQ_SOURCE_LINE 00000474 "# Or, if given something that is a ref but not an IO::Handle,"
NSQ_SOURCE_LINE 00000475 "# passes back the same thing."
NSQ_SOURCE_LINE 00000476 "sub _newFileHandle {"
NSQ_SOURCE_LINE 00000477 "    my $fd     = shift;"
NSQ_SOURCE_LINE 00000478 "    my $status = 1;"
NSQ_SOURCE_LINE 00000479 "    my $handle;"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "    if (ref($fd)) {"
NSQ_SOURCE_LINE 00000482 "        if (_ISA($fd, 'IO::Scalar') or _ISA($fd, 'IO::String')) {"
NSQ_SOURCE_LINE 00000483 "            $handle = $fd;"
NSQ_SOURCE_LINE 00000484 "        } elsif (_ISA($fd, 'IO::Handle') or ref($fd) eq 'GLOB') {"
NSQ_SOURCE_LINE 00000485 "            $handle = IO::File->new;"
NSQ_SOURCE_LINE 00000486 "            $status = $handle->fdopen($fd, @_);"
NSQ_SOURCE_LINE 00000487 "        } else {"
NSQ_SOURCE_LINE 00000488 "            $handle = $fd;"
NSQ_SOURCE_LINE 00000489 "        }"
NSQ_SOURCE_LINE 00000490 "    } else {"
NSQ_SOURCE_LINE 00000491 "        $handle = IO::File->new;"
NSQ_SOURCE_LINE 00000492 "        $status = $handle->open($fd, @_);"
NSQ_SOURCE_LINE 00000493 "    }"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "    return ($status, $handle);"
NSQ_SOURCE_LINE 00000496 "}"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "# Returns next signature from given file handle, leaves"
NSQ_SOURCE_LINE 00000499 "# file handle positioned afterwards."
NSQ_SOURCE_LINE 00000500 "#"
NSQ_SOURCE_LINE 00000501 "# In list context, returns ($status, $signature)"
NSQ_SOURCE_LINE 00000502 "# ( $status, $signature ) = _readSignature( $fh, $fileName );"
NSQ_SOURCE_LINE 00000503 "#"
NSQ_SOURCE_LINE 00000504 "# This function returns one of AZ_OK, AZ_IO_ERROR, or"
NSQ_SOURCE_LINE 00000505 "# AZ_FORMAT_ERROR and calls the respective error handlers in the"
NSQ_SOURCE_LINE 00000506 "# latter two cases.  If optional $noFormatError is true, it does"
NSQ_SOURCE_LINE 00000507 "# not call the error handler on format error, but only returns"
NSQ_SOURCE_LINE 00000508 "# AZ_FORMAT_ERROR."
NSQ_SOURCE_LINE 00000509 "sub _readSignature {"
NSQ_SOURCE_LINE 00000510 "    my $fh                = shift;"
NSQ_SOURCE_LINE 00000511 "    my $fileName          = shift;"
NSQ_SOURCE_LINE 00000512 "    my $expectedSignature = shift;    # optional"
NSQ_SOURCE_LINE 00000513 "    my $noFormatError     = shift;    # optional"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "    my $signatureData;"
NSQ_SOURCE_LINE 00000516 "    my $bytesRead = $fh->read($signatureData, SIGNATURE_LENGTH);"
NSQ_SOURCE_LINE 00000517 "    if ($bytesRead != SIGNATURE_LENGTH) {"
NSQ_SOURCE_LINE 00000518 "        return _ioError(\"reading header signature\");"
NSQ_SOURCE_LINE 00000519 "    }"
NSQ_SOURCE_LINE 00000520 "    my $signature = unpack(SIGNATURE_FORMAT, $signatureData);"
NSQ_SOURCE_LINE 00000521 "    my $status = AZ_OK;"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "    # compare with expected signature, if any, or any known signature."
NSQ_SOURCE_LINE 00000524 "    if ("
NSQ_SOURCE_LINE 00000525 "        (defined($expectedSignature) && $signature != $expectedSignature)"
NSQ_SOURCE_LINE 00000526 "        || (   !defined($expectedSignature)"
NSQ_SOURCE_LINE 00000527 "            && $signature != CENTRAL_DIRECTORY_FILE_HEADER_SIGNATURE"
NSQ_SOURCE_LINE 00000528 "            && $signature != LOCAL_FILE_HEADER_SIGNATURE"
NSQ_SOURCE_LINE 00000529 "            && $signature != END_OF_CENTRAL_DIRECTORY_SIGNATURE"
NSQ_SOURCE_LINE 00000530 "            && $signature != DATA_DESCRIPTOR_SIGNATURE"
NSQ_SOURCE_LINE 00000531 "            && $signature != ZIP64_END_OF_CENTRAL_DIRECTORY_RECORD_SIGNATURE"
NSQ_SOURCE_LINE 00000532 "            && $signature != ZIP64_END_OF_CENTRAL_DIRECTORY_LOCATOR_SIGNATURE"
NSQ_SOURCE_LINE 00000533 "        )"
NSQ_SOURCE_LINE 00000534 "      ) {"
NSQ_SOURCE_LINE 00000535 "        if (! $noFormatError ) {"
NSQ_SOURCE_LINE 00000536 "            my $errmsg = sprintf(\"bad signature: 0x%08x\", $signature);"
NSQ_SOURCE_LINE 00000537 "            if (_isSeekable($fh)) {"
NSQ_SOURCE_LINE 00000538 "                $errmsg .= sprintf(\" at offset %d\", $fh->tell() - SIGNATURE_LENGTH);"
NSQ_SOURCE_LINE 00000539 "            }"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "            $status = _formatError(\"$errmsg in file $fileName\");"
NSQ_SOURCE_LINE 00000542 "        }"
NSQ_SOURCE_LINE 00000543 "        else {"
NSQ_SOURCE_LINE 00000544 "            $status = AZ_FORMAT_ERROR;"
NSQ_SOURCE_LINE 00000545 "        }"
NSQ_SOURCE_LINE 00000546 "    }"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "    return ($status, $signature);"
NSQ_SOURCE_LINE 00000549 "}"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "# Utility method to make and open a temp file."
NSQ_SOURCE_LINE 00000552 "# Will create $temp_dir if it does not exist."
NSQ_SOURCE_LINE 00000553 "# Returns file handle and name:"
NSQ_SOURCE_LINE 00000554 "#"
NSQ_SOURCE_LINE 00000555 "# my ($fh, $name) = Archive::Zip::tempFile();"
NSQ_SOURCE_LINE 00000556 "# my ($fh, $name) = Archive::Zip::tempFile('mytempdir');"
NSQ_SOURCE_LINE 00000557 "#"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "sub tempFile {"
NSQ_SOURCE_LINE 00000560 "    my $dir = (ref($_[0]) eq 'HASH') ? shift->{tempDir} : shift;"
NSQ_SOURCE_LINE 00000561 "    my ($fh, $filename) = File::Temp::tempfile("
NSQ_SOURCE_LINE 00000562 "        SUFFIX => '.zip',"
NSQ_SOURCE_LINE 00000563 "        UNLINK => 1,"
NSQ_SOURCE_LINE 00000564 "        $dir ? (DIR => $dir) : ());"
NSQ_SOURCE_LINE 00000565 "    return (undef, undef) unless $fh;"
NSQ_SOURCE_LINE 00000566 "    my ($status, $newfh) = _newFileHandle($fh, 'w+');"
NSQ_SOURCE_LINE 00000567 "    $fh->close();"
NSQ_SOURCE_LINE 00000568 "    return ($newfh, $filename);"
NSQ_SOURCE_LINE 00000569 "}"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "# Return the normalized directory name as used in a zip file (path"
NSQ_SOURCE_LINE 00000572 "# separators become slashes, etc.)."
NSQ_SOURCE_LINE 00000573 "# Will translate internal slashes in path components (i.e. on Macs) to"
NSQ_SOURCE_LINE 00000574 "# underscores.  Discards volume names."
NSQ_SOURCE_LINE 00000575 "# When $forceDir is set, returns paths with trailing slashes (or arrays"
NSQ_SOURCE_LINE 00000576 "# with trailing blank members)."
NSQ_SOURCE_LINE 00000577 "#"
NSQ_SOURCE_LINE 00000578 "# If third argument is a reference, returns volume information there."
NSQ_SOURCE_LINE 00000579 "#"
NSQ_SOURCE_LINE 00000580 "# input         output"
NSQ_SOURCE_LINE 00000581 "# .             ('.')   '.'"
NSQ_SOURCE_LINE 00000582 "# ./a           ('a')   a"
NSQ_SOURCE_LINE 00000583 "# ./a/b         ('a','b')   a/b"
NSQ_SOURCE_LINE 00000584 "# ./a/b/        ('a','b')   a/b"
NSQ_SOURCE_LINE 00000585 "# a/b/          ('a','b')   a/b"
NSQ_SOURCE_LINE 00000586 "# /a/b/         ('','a','b')    a/b"
NSQ_SOURCE_LINE 00000587 "# c:\\a\\b\\c.doc  ('','a','b','c.doc')    a/b/c.doc      # on Windows"
NSQ_SOURCE_LINE 00000588 "# \"i/o maps:whatever\"   ('i_o maps', 'whatever')  \"i_o maps/whatever\"   # on Macs"
NSQ_SOURCE_LINE 00000589 "sub _asZipDirName {"
NSQ_SOURCE_LINE 00000590 "    my $name      = shift;"
NSQ_SOURCE_LINE 00000591 "    my $forceDir  = shift;"
NSQ_SOURCE_LINE 00000592 "    my $volReturn = shift;"
NSQ_SOURCE_LINE 00000593 "    my ($volume, $directories, $file) ="
NSQ_SOURCE_LINE 00000594 "      File::Spec->splitpath(File::Spec->canonpath($name), $forceDir);"
NSQ_SOURCE_LINE 00000595 "    $$volReturn = $volume if (ref($volReturn));"
NSQ_SOURCE_LINE 00000596 "    my @dirs = map { $_ =~ y{/}{_}; $_ } File::Spec->splitdir($directories);"
NSQ_SOURCE_LINE 00000597 "    if (@dirs > 0) { pop(@dirs) unless $dirs[-1] }    # remove empty component"
NSQ_SOURCE_LINE 00000598 "    push(@dirs, defined($file) ? $file : '');"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "    #return wantarray ? @dirs : join ( '/', @dirs );"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "    my $normalised_path = join '/', @dirs;"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "    # Leading directory separators should not be stored in zip archives."
NSQ_SOURCE_LINE 00000605 "    # Example:"
NSQ_SOURCE_LINE 00000606 "    #   C:\\a\\b\\c\\      a/b/c"
NSQ_SOURCE_LINE 00000607 "    #   C:\\a\\b\\c.txt   a/b/c.txt"
NSQ_SOURCE_LINE 00000608 "    #   /a/b/c/        a/b/c"
NSQ_SOURCE_LINE 00000609 "    #   /a/b/c.txt     a/b/c.txt"
NSQ_SOURCE_LINE 00000610 "    $normalised_path =~ s{^/}{};    # remove leading separator"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "    return $normalised_path;"
NSQ_SOURCE_LINE 00000613 "}"
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "# Return an absolute local name for a zip name."
NSQ_SOURCE_LINE 00000616 "# Assume a directory if zip name has trailing slash."
NSQ_SOURCE_LINE 00000617 "# Takes an optional volume name in FS format (like 'a:')."
NSQ_SOURCE_LINE 00000618 "#"
NSQ_SOURCE_LINE 00000619 "sub _asLocalName {"
NSQ_SOURCE_LINE 00000620 "    my $name   = shift;    # zip format"
NSQ_SOURCE_LINE 00000621 "    my $volume = shift;"
NSQ_SOURCE_LINE 00000622 "    $volume = '' unless defined($volume);    # local FS format"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "    my @paths = split(/\\//, $name);"
NSQ_SOURCE_LINE 00000625 "    my $filename = pop(@paths);"
NSQ_SOURCE_LINE 00000626 "    $filename = '' unless defined($filename);"
NSQ_SOURCE_LINE 00000627 "    my $localDirs = @paths ? File::Spec->catdir(@paths) : '';"
NSQ_SOURCE_LINE 00000628 "    my $localName = File::Spec->catpath($volume, $localDirs, $filename);"
NSQ_SOURCE_LINE 00000629 "    unless ($volume) {"
NSQ_SOURCE_LINE 00000630 "        $localName = File::Spec->rel2abs($localName, Cwd::getcwd());"
NSQ_SOURCE_LINE 00000631 "    }"
NSQ_SOURCE_LINE 00000632 "    return $localName;"
NSQ_SOURCE_LINE 00000633 "}"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "1;"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "__END__"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "=pod"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "=encoding utf8"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "=head1 NAME"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "Archive::Zip - Provide an interface to ZIP archive files."
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "   # Create a Zip file"
NSQ_SOURCE_LINE 00000650 "   use Archive::Zip qw( :ERROR_CODES :CONSTANTS );"
NSQ_SOURCE_LINE 00000651 "   my $zip = Archive::Zip->new();"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "   # Add a directory"
NSQ_SOURCE_LINE 00000654 "   my $dir_member = $zip->addDirectory( 'dirname/' );"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "   # Add a file from a string with compression"
NSQ_SOURCE_LINE 00000657 "   my $string_member = $zip->addString( 'This is a test', 'stringMember.txt' );"
NSQ_SOURCE_LINE 00000658 "   $string_member->desiredCompressionMethod( COMPRESSION_DEFLATED );"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "   # Add a file from disk"
NSQ_SOURCE_LINE 00000661 "   my $file_member = $zip->addFile( 'xyz.pl', 'AnotherName.pl' );"
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "   # Save the Zip file"
NSQ_SOURCE_LINE 00000664 "   unless ( $zip->writeToFileNamed('someZip.zip') == AZ_OK ) {"
NSQ_SOURCE_LINE 00000665 "       die 'write error';"
NSQ_SOURCE_LINE 00000666 "   }"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "   # Read a Zip file"
NSQ_SOURCE_LINE 00000669 "   my $somezip = Archive::Zip->new();"
NSQ_SOURCE_LINE 00000670 "   unless ( $somezip->read( 'someZip.zip' ) == AZ_OK ) {"
NSQ_SOURCE_LINE 00000671 "       die 'read error';"
NSQ_SOURCE_LINE 00000672 "   }"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "   # Change the compression type for a file in the Zip"
NSQ_SOURCE_LINE 00000675 "   my $member = $somezip->memberNamed( 'stringMember.txt' );"
NSQ_SOURCE_LINE 00000676 "   $member->desiredCompressionMethod( COMPRESSION_STORED );"
NSQ_SOURCE_LINE 00000677 "   unless ( $zip->writeToFileNamed( 'someOtherZip.zip' ) == AZ_OK ) {"
NSQ_SOURCE_LINE 00000678 "       die 'write error';"
NSQ_SOURCE_LINE 00000679 "   }"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "The Archive::Zip module allows a Perl program to create, manipulate, read,"
NSQ_SOURCE_LINE 00000684 "and write Zip archive files."
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "Zip archives can be created, or you can read from existing zip files."
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "Once created, they can be written to files, streams, or strings. Members"
NSQ_SOURCE_LINE 00000689 "can be added, removed, extracted, replaced, rearranged, and enumerated."
NSQ_SOURCE_LINE 00000690 "They can also be renamed or have their dates, comments, or other attributes"
NSQ_SOURCE_LINE 00000691 "queried or modified. Their data can be compressed or uncompressed as needed."
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "Members can be created from members in existing Zip files, or from existing"
NSQ_SOURCE_LINE 00000694 "directories, files, or strings."
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "This module uses the L<Compress::Raw::Zlib> library to read and write the"
NSQ_SOURCE_LINE 00000697 "compressed streams inside the files."
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "One can use L<Archive::Zip::MemberRead> to read the zip file archive members"
NSQ_SOURCE_LINE 00000700 "as if they were files."
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "=head2 File Naming"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "Regardless of what your local file system uses for file naming, names in a"
NSQ_SOURCE_LINE 00000705 "Zip file are in Unix format (I<forward> slashes (/) separating directory"
NSQ_SOURCE_LINE 00000706 "names, etc.)."
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "C<Archive::Zip> tries to be consistent with file naming conventions, and will"
NSQ_SOURCE_LINE 00000709 "translate back and forth between native and Zip file names."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "However, it can't guess which format names are in. So two rules control what"
NSQ_SOURCE_LINE 00000712 "kind of file name you must pass various routines:"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "=over 4"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "=item Names of files are in local format."
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "C<File::Spec> and C<File::Basename> are used for various file"
NSQ_SOURCE_LINE 00000719 "operations. When you're referring to a file on your system, use its"
NSQ_SOURCE_LINE 00000720 "file naming conventions."
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "=item Names of archive members are in Unix format."
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "This applies to every method that refers to an archive member, or"
NSQ_SOURCE_LINE 00000725 "provides a name for new archive members. The C<extract()> methods"
NSQ_SOURCE_LINE 00000726 "that can take one or two names will convert from local to zip names"
NSQ_SOURCE_LINE 00000727 "if you call them with a single name."
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "=back"
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "=head2 Archive::Zip Object Model"
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "=head3 Overview"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "Archive::Zip::Archive objects are what you ordinarily deal with."
NSQ_SOURCE_LINE 00000736 "These maintain the structure of a zip file, without necessarily"
NSQ_SOURCE_LINE 00000737 "holding data. When a zip is read from a disk file, the (possibly"
NSQ_SOURCE_LINE 00000738 "compressed) data still lives in the file, not in memory. Archive"
NSQ_SOURCE_LINE 00000739 "members hold information about the individual members, but not"
NSQ_SOURCE_LINE 00000740 "(usually) the actual member data. When the zip is written to a"
NSQ_SOURCE_LINE 00000741 "(different) file, the member data is compressed or copied as needed."
NSQ_SOURCE_LINE 00000742 "It is possible to make archive members whose data is held in a string"
NSQ_SOURCE_LINE 00000743 "in memory, but this is not done when a zip file is read. Directory"
NSQ_SOURCE_LINE 00000744 "members don't have any data."
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "=head2 Inheritance"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "  Exporter"
NSQ_SOURCE_LINE 00000749 "   Archive::Zip                            Common base class, has defs."
NSQ_SOURCE_LINE 00000750 "       Archive::Zip::Archive               A Zip archive."
NSQ_SOURCE_LINE 00000751 "       Archive::Zip::Member                Abstract superclass for all members."
NSQ_SOURCE_LINE 00000752 "           Archive::Zip::StringMember      Member made from a string"
NSQ_SOURCE_LINE 00000753 "           Archive::Zip::FileMember        Member made from an external file"
NSQ_SOURCE_LINE 00000754 "               Archive::Zip::ZipFileMember Member that lives in a zip file"
NSQ_SOURCE_LINE 00000755 "               Archive::Zip::NewFileMember Member whose data is in a file"
NSQ_SOURCE_LINE 00000756 "           Archive::Zip::DirectoryMember   Member that is a directory"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "=over 4"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "=item :CONSTANTS"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "Exports the following constants:"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "FA_MSDOS FA_UNIX GPBF_ENCRYPTED_MASK"
NSQ_SOURCE_LINE 00000767 "GPBF_DEFLATING_COMPRESSION_MASK GPBF_HAS_DATA_DESCRIPTOR_MASK"
NSQ_SOURCE_LINE 00000768 "COMPRESSION_STORED COMPRESSION_DEFLATED IFA_TEXT_FILE_MASK"
NSQ_SOURCE_LINE 00000769 "IFA_TEXT_FILE IFA_BINARY_FILE COMPRESSION_LEVEL_NONE"
NSQ_SOURCE_LINE 00000770 "COMPRESSION_LEVEL_DEFAULT COMPRESSION_LEVEL_FASTEST"
NSQ_SOURCE_LINE 00000771 "COMPRESSION_LEVEL_BEST_COMPRESSION"
NSQ_SOURCE_LINE 00000772 "ZIP64_SUPPORTED ZIP64_AS_NEEDED ZIP64_EOCD ZIP64_HEADERS"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "=item :MISC_CONSTANTS"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "Exports the following constants (only necessary for extending the"
NSQ_SOURCE_LINE 00000777 "module):"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "FA_AMIGA FA_VAX_VMS FA_VM_CMS FA_ATARI_ST FA_OS2_HPFS"
NSQ_SOURCE_LINE 00000780 "FA_MACINTOSH FA_Z_SYSTEM FA_CPM FA_WINDOWS_NTFS"
NSQ_SOURCE_LINE 00000781 "GPBF_IMPLODING_8K_SLIDING_DICTIONARY_MASK"
NSQ_SOURCE_LINE 00000782 "GPBF_IMPLODING_3_SHANNON_FANO_TREES_MASK"
NSQ_SOURCE_LINE 00000783 "GPBF_IS_COMPRESSED_PATCHED_DATA_MASK COMPRESSION_SHRUNK"
NSQ_SOURCE_LINE 00000784 "DEFLATING_COMPRESSION_NORMAL DEFLATING_COMPRESSION_MAXIMUM"
NSQ_SOURCE_LINE 00000785 "DEFLATING_COMPRESSION_FAST DEFLATING_COMPRESSION_SUPER_FAST"
NSQ_SOURCE_LINE 00000786 "COMPRESSION_REDUCED_1 COMPRESSION_REDUCED_2 COMPRESSION_REDUCED_3"
NSQ_SOURCE_LINE 00000787 "COMPRESSION_REDUCED_4 COMPRESSION_IMPLODED COMPRESSION_TOKENIZED"
NSQ_SOURCE_LINE 00000788 "COMPRESSION_DEFLATED_ENHANCED"
NSQ_SOURCE_LINE 00000789 "COMPRESSION_PKWARE_DATA_COMPRESSION_LIBRARY_IMPLODED"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "=item :ERROR_CODES"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "Explained below. Returned from most methods."
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "AZ_OK AZ_STREAM_END AZ_ERROR AZ_FORMAT_ERROR AZ_IO_ERROR"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "=back"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "=head1 ERROR CODES"
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "Many of the methods in Archive::Zip return error codes. These are implemented"
NSQ_SOURCE_LINE 00000802 "as inline subroutines, using the C<use constant> pragma. They can be imported"
NSQ_SOURCE_LINE 00000803 "into your namespace using the C<:ERROR_CODES> tag:"
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "  use Archive::Zip qw( :ERROR_CODES );"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "  ..."
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "  unless ( $zip->read( 'myfile.zip' ) == AZ_OK ) {"
NSQ_SOURCE_LINE 00000810 "      die \"whoops!\";"
NSQ_SOURCE_LINE 00000811 "  }"
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "=over 4"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "=item AZ_OK (0)"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "Everything is fine."
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "=item AZ_STREAM_END (1)"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "The read stream (or central directory) ended normally."
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "=item AZ_ERROR (2)"
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "There was some generic kind of error."
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "=item AZ_FORMAT_ERROR (3)"
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "There is a format error in a ZIP file being read."
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "=item AZ_IO_ERROR (4)"
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "There was an IO error."
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "=back"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "=head2 Compression"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "Archive::Zip allows each member of a ZIP file to be compressed (using the"
NSQ_SOURCE_LINE 00000840 "Deflate algorithm) or uncompressed."
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "Other compression algorithms that some versions of ZIP have been able to"
NSQ_SOURCE_LINE 00000843 "produce are not supported. Each member has two compression methods: the"
NSQ_SOURCE_LINE 00000844 "one it's stored as (this is always COMPRESSION_STORED for string and external"
NSQ_SOURCE_LINE 00000845 "file members), and the one you desire for the member in the zip file."
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "These can be different, of course, so you can make a zip member that is not"
NSQ_SOURCE_LINE 00000848 "compressed out of one that is, and vice versa."
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "You can inquire about the current compression and set the desired"
NSQ_SOURCE_LINE 00000851 "compression method:"
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "  my $member = $zip->memberNamed( 'xyz.txt' );"
NSQ_SOURCE_LINE 00000854 "  $member->compressionMethod();    # return current compression"
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "  # set to read uncompressed"
NSQ_SOURCE_LINE 00000857 "  $member->desiredCompressionMethod( COMPRESSION_STORED );"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "  # set to read compressed"
NSQ_SOURCE_LINE 00000860 "  $member->desiredCompressionMethod( COMPRESSION_DEFLATED );"
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "There are two different compression methods:"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "=over 4"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "=item COMPRESSION_STORED"
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "File is stored (no compression)"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "=item COMPRESSION_DEFLATED"
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "File is Deflated"
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "=back"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "=head2 Compression Levels"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "If a member's desiredCompressionMethod is COMPRESSION_DEFLATED, you"
NSQ_SOURCE_LINE 00000879 "can choose different compression levels. This choice may affect the"
NSQ_SOURCE_LINE 00000880 "speed of compression and decompression, as well as the size of the"
NSQ_SOURCE_LINE 00000881 "compressed member data."
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "  $member->desiredCompressionLevel( 9 );"
NSQ_SOURCE_LINE 00000884 ""
NSQ_SOURCE_LINE 00000885 "The levels given can be:"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "=over 4"
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "=item * 0 or COMPRESSION_LEVEL_NONE"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "This is the same as saying"
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "  $member->desiredCompressionMethod( COMPRESSION_STORED );"
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "=item * 1 .. 9"
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "1 gives the best speed and worst compression, and 9 gives the"
NSQ_SOURCE_LINE 00000898 "best compression and worst speed."
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "=item * COMPRESSION_LEVEL_FASTEST"
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "This is a synonym for level 1."
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "=item * COMPRESSION_LEVEL_BEST_COMPRESSION"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "This is a synonym for level 9."
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "=item * COMPRESSION_LEVEL_DEFAULT"
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "This gives a good compromise between speed and compression,"
NSQ_SOURCE_LINE 00000911 "and is currently equivalent to 6 (this is in the zlib code)."
NSQ_SOURCE_LINE 00000912 "This is the level that will be used if not specified."
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "=back"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "=head1 Archive::Zip Methods"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "The Archive::Zip class (and its invisible subclass Archive::Zip::Archive)"
NSQ_SOURCE_LINE 00000919 "implement generic zip file functionality. Creating a new Archive::Zip object"
NSQ_SOURCE_LINE 00000920 "actually makes an Archive::Zip::Archive object, but you don't have to worry"
NSQ_SOURCE_LINE 00000921 "about this unless you're subclassing."
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "=head2 Constructor"
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "=over 4"
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "=item new( [$fileName] )"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "=item new( { filename => $fileName } )"
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "Make a new, empty zip archive."
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "    my $zip = Archive::Zip->new();"
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "If an additional argument is passed, new() will call read()"
NSQ_SOURCE_LINE 00000936 "to read the contents of an archive:"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "    my $zip = Archive::Zip->new( 'xyz.zip' );"
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "If a filename argument is passed and the read fails for any"
NSQ_SOURCE_LINE 00000941 "reason, new will return undef. For this reason, it may be"
NSQ_SOURCE_LINE 00000942 "better to call read separately."
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "=back"
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "=head2 Zip Archive Utility Methods"
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "These Archive::Zip methods may be called as functions or as object"
NSQ_SOURCE_LINE 00000949 "methods. Do not call them as class methods:"
NSQ_SOURCE_LINE 00000950 ""
NSQ_SOURCE_LINE 00000951 "    $zip = Archive::Zip->new();"
NSQ_SOURCE_LINE 00000952 "    $crc = Archive::Zip::computeCRC32( 'ghijkl' );    # OK"
NSQ_SOURCE_LINE 00000953 "    $crc = $zip->computeCRC32( 'ghijkl' );            # also OK"
NSQ_SOURCE_LINE 00000954 "    $crc = Archive::Zip->computeCRC32( 'ghijkl' );    # NOT OK"
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "=over 4"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "=item Archive::Zip::computeCRC32( $string [, $crc] )"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "=item Archive::Zip::computeCRC32( { string => $string [, checksum => $crc ] } )"
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "This is a utility function that uses the Compress::Raw::Zlib CRC"
NSQ_SOURCE_LINE 00000963 "routine to compute a CRC-32. You can get the CRC of a string:"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "    $crc = Archive::Zip::computeCRC32( $string );"
NSQ_SOURCE_LINE 00000966 ""
NSQ_SOURCE_LINE 00000967 "Or you can compute the running CRC:"
NSQ_SOURCE_LINE 00000968 ""
NSQ_SOURCE_LINE 00000969 "    $crc = 0;"
NSQ_SOURCE_LINE 00000970 "    $crc = Archive::Zip::computeCRC32( 'abcdef', $crc );"
NSQ_SOURCE_LINE 00000971 "    $crc = Archive::Zip::computeCRC32( 'ghijkl', $crc );"
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "=item Archive::Zip::setChunkSize( $number )"
NSQ_SOURCE_LINE 00000974 ""
NSQ_SOURCE_LINE 00000975 "=item Archive::Zip::setChunkSize( { chunkSize => $number } )"
NSQ_SOURCE_LINE 00000976 ""
NSQ_SOURCE_LINE 00000977 "Report or change chunk size used for reading and writing."
NSQ_SOURCE_LINE 00000978 "This can make big differences in dealing with large files."
NSQ_SOURCE_LINE 00000979 "Currently, this defaults to 32K. This also changes the chunk"
NSQ_SOURCE_LINE 00000980 "size used for Compress::Raw::Zlib. You must call setChunkSize()"
NSQ_SOURCE_LINE 00000981 "before reading or writing. This is not exportable, so you"
NSQ_SOURCE_LINE 00000982 "must call it like:"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "    Archive::Zip::setChunkSize( 4096 );"
NSQ_SOURCE_LINE 00000985 ""
NSQ_SOURCE_LINE 00000986 "or as a method on a zip (though this is a global setting)."
NSQ_SOURCE_LINE 00000987 "Returns old chunk size."
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "=item Archive::Zip::chunkSize()"
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "Returns the current chunk size:"
NSQ_SOURCE_LINE 00000992 ""
NSQ_SOURCE_LINE 00000993 "    my $chunkSize = Archive::Zip::chunkSize();"
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "=item Archive::Zip::setErrorHandler( \\&subroutine )"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "=item Archive::Zip::setErrorHandler( { subroutine => \\&subroutine } )"
NSQ_SOURCE_LINE 00000998 ""
NSQ_SOURCE_LINE 00000999 "Change the subroutine called with error strings. This"
NSQ_SOURCE_LINE 00001000 "defaults to \\&Carp::carp, but you may want to change it to"
NSQ_SOURCE_LINE 00001001 "get the error strings. This is not exportable, so you must"
NSQ_SOURCE_LINE 00001002 "call it like:"
NSQ_SOURCE_LINE 00001003 ""
NSQ_SOURCE_LINE 00001004 "    Archive::Zip::setErrorHandler( \\&myErrorHandler );"
NSQ_SOURCE_LINE 00001005 ""
NSQ_SOURCE_LINE 00001006 "If myErrorHandler is undef, resets handler to default."
NSQ_SOURCE_LINE 00001007 "Returns old error handler. Note that if you call Carp::carp"
NSQ_SOURCE_LINE 00001008 "or a similar routine or if you're chaining to the default"
NSQ_SOURCE_LINE 00001009 "error handler from your error handler, you may want to"
NSQ_SOURCE_LINE 00001010 "increment the number of caller levels that are skipped (do"
NSQ_SOURCE_LINE 00001011 "not just set it to a number):"
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "    $Carp::CarpLevel++;"
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "=item Archive::Zip::tempFile( [ $tmpdir ] )"
NSQ_SOURCE_LINE 00001016 ""
NSQ_SOURCE_LINE 00001017 "=item Archive::Zip::tempFile( { tempDir => $tmpdir } )"
NSQ_SOURCE_LINE 00001018 ""
NSQ_SOURCE_LINE 00001019 "Create a uniquely named temp file. It will be returned open"
NSQ_SOURCE_LINE 00001020 "for read/write. If C<$tmpdir> is given, it is used as the"
NSQ_SOURCE_LINE 00001021 "name of a directory to create the file in. If not given,"
NSQ_SOURCE_LINE 00001022 "creates the file using C<File::Spec::tmpdir()>. Generally, you can"
NSQ_SOURCE_LINE 00001023 "override this choice using the"
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "    $ENV{TMPDIR}"
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "environment variable. But see the L<File::Spec|File::Spec>"
NSQ_SOURCE_LINE 00001028 "documentation for your system. Note that on many systems, if you're"
NSQ_SOURCE_LINE 00001029 "running in taint mode, then you must make sure that C<$ENV{TMPDIR}> is"
NSQ_SOURCE_LINE 00001030 "untainted for it to be used."
NSQ_SOURCE_LINE 00001031 "Will I<NOT> create C<$tmpdir> if it does not exist (this is a change"
NSQ_SOURCE_LINE 00001032 "from prior versions!). Returns file handle and name:"
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "    my ($fh, $name) = Archive::Zip::tempFile();"
NSQ_SOURCE_LINE 00001035 "    my ($fh, $name) = Archive::Zip::tempFile('myTempDir');"
NSQ_SOURCE_LINE 00001036 "    my $fh = Archive::Zip::tempFile();  # if you don't need the name"
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "=back"
NSQ_SOURCE_LINE 00001039 ""
NSQ_SOURCE_LINE 00001040 "=head2 Zip Archive Accessors"
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "=over 4"
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 "=item members()"
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "Return a copy of the members array"
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "    my @members = $zip->members();"
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "=item numberOfMembers()"
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "Return the number of members I have"
NSQ_SOURCE_LINE 00001053 ""
NSQ_SOURCE_LINE 00001054 "=item memberNames()"
NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 "Return a list of the (internal) file names of the zip members"
NSQ_SOURCE_LINE 00001057 ""
NSQ_SOURCE_LINE 00001058 "=item memberNamed( $string )"
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "=item memberNamed( { zipName => $string } )"
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "Return ref to member whose filename equals given filename or"
NSQ_SOURCE_LINE 00001063 "undef. C<$string> must be in Zip (Unix) filename format."
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "=item membersMatching( $regex )"
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "=item membersMatching( { regex => $regex } )"
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "Return array of members whose filenames match given regular"
NSQ_SOURCE_LINE 00001070 "expression in list context. Returns number of matching"
NSQ_SOURCE_LINE 00001071 "members in scalar context."
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "    my @textFileMembers = $zip->membersMatching( '.*\\.txt' );"
NSQ_SOURCE_LINE 00001074 "    # or"
NSQ_SOURCE_LINE 00001075 "    my $numberOfTextFiles = $zip->membersMatching( '.*\\.txt' );"
NSQ_SOURCE_LINE 00001076 ""
NSQ_SOURCE_LINE 00001077 "=item zip64()"
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "Returns whether the previous read or write of the archive has"
NSQ_SOURCE_LINE 00001080 "been done in zip64 format."
NSQ_SOURCE_LINE 00001081 ""
NSQ_SOURCE_LINE 00001082 "=item desiredZip64Mode()"
NSQ_SOURCE_LINE 00001083 ""
NSQ_SOURCE_LINE 00001084 "Gets or sets which parts of the archive should be written in"
NSQ_SOURCE_LINE 00001085 "zip64 format: All parts as needed (ZIP64_AS_NEEDED), the default,"
NSQ_SOURCE_LINE 00001086 "force writing the zip64 end of central directory record"
NSQ_SOURCE_LINE 00001087 "(ZIP64_EOCD), force writing the zip64 EOCD record and all headers"
NSQ_SOURCE_LINE 00001088 "in zip64 format (ZIP64_HEADERS)."
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "=item versionMadeBy()"
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "=item versionNeededToExtract()"
NSQ_SOURCE_LINE 00001093 ""
NSQ_SOURCE_LINE 00001094 "Gets the fields from the zip64 end of central directory"
NSQ_SOURCE_LINE 00001095 "record. These are always 0 if the archive is not in zip64 format."
NSQ_SOURCE_LINE 00001096 ""
NSQ_SOURCE_LINE 00001097 "=item diskNumber()"
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "Return the disk that I start on. Not used for writing zips,"
NSQ_SOURCE_LINE 00001100 "but might be interesting if you read a zip in. This should be"
NSQ_SOURCE_LINE 00001101 "0, as Archive::Zip does not handle multi-volume archives."
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 "=item diskNumberWithStartOfCentralDirectory()"
NSQ_SOURCE_LINE 00001104 ""
NSQ_SOURCE_LINE 00001105 "Return the disk number that holds the beginning of the"
NSQ_SOURCE_LINE 00001106 "central directory. Not used for writing zips, but might be"
NSQ_SOURCE_LINE 00001107 "interesting if you read a zip in. This should be 0, as"
NSQ_SOURCE_LINE 00001108 "Archive::Zip does not handle multi-volume archives."
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "=item numberOfCentralDirectoriesOnThisDisk()"
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 "Return the number of CD structures in the zipfile last read in."
NSQ_SOURCE_LINE 00001113 "Not used for writing zips, but might be interesting if you read a zip"
NSQ_SOURCE_LINE 00001114 "in."
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "=item numberOfCentralDirectories()"
NSQ_SOURCE_LINE 00001117 ""
NSQ_SOURCE_LINE 00001118 "Return the number of CD structures in the zipfile last read in."
NSQ_SOURCE_LINE 00001119 "Not used for writing zips, but might be interesting if you read a zip"
NSQ_SOURCE_LINE 00001120 "in."
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "=item centralDirectorySize()"
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 "Returns central directory size, as read from an external zip"
NSQ_SOURCE_LINE 00001125 "file. Not used for writing zips, but might be interesting if"
NSQ_SOURCE_LINE 00001126 "you read a zip in."
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "=item centralDirectoryOffsetWRTStartingDiskNumber()"
NSQ_SOURCE_LINE 00001129 ""
NSQ_SOURCE_LINE 00001130 "Returns the offset into the zip file where the CD begins. Not"
NSQ_SOURCE_LINE 00001131 "used for writing zips, but might be interesting if you read a"
NSQ_SOURCE_LINE 00001132 "zip in."
NSQ_SOURCE_LINE 00001133 ""
NSQ_SOURCE_LINE 00001134 "=item zipfileComment( [ $string ] )"
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 "=item zipfileComment( [ { comment => $string } ] )"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "Get or set the zipfile comment. Returns the old comment."
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "    print $zip->zipfileComment();"
NSQ_SOURCE_LINE 00001141 "    $zip->zipfileComment( 'New Comment' );"
NSQ_SOURCE_LINE 00001142 ""
NSQ_SOURCE_LINE 00001143 "=item eocdOffset()"
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "Returns the (unexpected) number of bytes between where the"
NSQ_SOURCE_LINE 00001146 "EOCD was found and where it expected to be. This is normally"
NSQ_SOURCE_LINE 00001147 "0, but would be positive if something (a virus, perhaps) had"
NSQ_SOURCE_LINE 00001148 "added bytes somewhere before the EOCD. Not used for writing"
NSQ_SOURCE_LINE 00001149 "zips, but might be interesting if you read a zip in. Here is"
NSQ_SOURCE_LINE 00001150 "an example of how you can diagnose this:"
NSQ_SOURCE_LINE 00001151 ""
NSQ_SOURCE_LINE 00001152 "  my $zip = Archive::Zip->new('somefile.zip');"
NSQ_SOURCE_LINE 00001153 "  if ($zip->eocdOffset())"
NSQ_SOURCE_LINE 00001154 "  {"
NSQ_SOURCE_LINE 00001155 "    warn \"A virus has added \", $zip->eocdOffset, \" bytes of garbage\\n\";"
NSQ_SOURCE_LINE 00001156 "  }"
NSQ_SOURCE_LINE 00001157 ""
NSQ_SOURCE_LINE 00001158 "The C<eocdOffset()> is used to adjust the starting position of member"
NSQ_SOURCE_LINE 00001159 "headers, if necessary."
NSQ_SOURCE_LINE 00001160 ""
NSQ_SOURCE_LINE 00001161 "=item fileName()"
NSQ_SOURCE_LINE 00001162 ""
NSQ_SOURCE_LINE 00001163 "Returns the name of the file last read from. If nothing has"
NSQ_SOURCE_LINE 00001164 "been read yet, returns an empty string; if read from a file"
NSQ_SOURCE_LINE 00001165 "handle, returns the handle in string form."
NSQ_SOURCE_LINE 00001166 ""
NSQ_SOURCE_LINE 00001167 "=back"
NSQ_SOURCE_LINE 00001168 ""
NSQ_SOURCE_LINE 00001169 "=head2 Zip Archive Member Operations"
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 "Various operations on a zip file modify members. When a member is"
NSQ_SOURCE_LINE 00001172 "passed as an argument, you can either use a reference to the member"
NSQ_SOURCE_LINE 00001173 "itself, or the name of a member. Of course, using the name requires"
NSQ_SOURCE_LINE 00001174 "that names be unique within a zip (this is not enforced)."
NSQ_SOURCE_LINE 00001175 ""
NSQ_SOURCE_LINE 00001176 "=over 4"
NSQ_SOURCE_LINE 00001177 ""
NSQ_SOURCE_LINE 00001178 "=item removeMember( $memberOrName )"
NSQ_SOURCE_LINE 00001179 ""
NSQ_SOURCE_LINE 00001180 "=item removeMember( { memberOrZipName => $memberOrName } )"
NSQ_SOURCE_LINE 00001181 ""
NSQ_SOURCE_LINE 00001182 "Remove and return the given member, or match its name and"
NSQ_SOURCE_LINE 00001183 "remove it. Returns undef if member or name does not exist in this"
NSQ_SOURCE_LINE 00001184 "Zip. No-op if member does not belong to this zip."
NSQ_SOURCE_LINE 00001185 ""
NSQ_SOURCE_LINE 00001186 "=item replaceMember( $memberOrName, $newMember )"
NSQ_SOURCE_LINE 00001187 ""
NSQ_SOURCE_LINE 00001188 "=item replaceMember( { memberOrZipName => $memberOrName,"
NSQ_SOURCE_LINE 00001189 "    newMember => $newMember } )"
NSQ_SOURCE_LINE 00001190 ""
NSQ_SOURCE_LINE 00001191 "Remove and return the given member, or match its name and"
NSQ_SOURCE_LINE 00001192 "remove it. Replace with new member. Returns undef if member or"
NSQ_SOURCE_LINE 00001193 "name does not exist in this Zip, or if C<$newMember> is undefined."
NSQ_SOURCE_LINE 00001194 ""
NSQ_SOURCE_LINE 00001195 "It is an (undiagnosed) error to provide a C<$newMember> that is a"
NSQ_SOURCE_LINE 00001196 "member of the zip being modified."
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "    my $member1 = $zip->removeMember( 'xyz' );"
NSQ_SOURCE_LINE 00001199 "    my $member2 = $zip->replaceMember( 'abc', $member1 );"
NSQ_SOURCE_LINE 00001200 "    # now, $member2 (named 'abc') is not in $zip,"
NSQ_SOURCE_LINE 00001201 "    # and $member1 (named 'xyz') is, having taken $member2's place."
NSQ_SOURCE_LINE 00001202 ""
NSQ_SOURCE_LINE 00001203 "=item extractMember( $memberOrName [, $extractedName ] )"
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "=item extractMember( { memberOrZipName => $memberOrName"
NSQ_SOURCE_LINE 00001206 "    [, name => $extractedName ] } )"
NSQ_SOURCE_LINE 00001207 ""
NSQ_SOURCE_LINE 00001208 "Extract the given member, or match its name and extract it."
NSQ_SOURCE_LINE 00001209 "Returns undef if member does not exist in this Zip. If"
NSQ_SOURCE_LINE 00001210 "optional second arg is given, use it as the name of the"
NSQ_SOURCE_LINE 00001211 "extracted member. Otherwise, the internal filename of the"
NSQ_SOURCE_LINE 00001212 "member is used as the name of the extracted file or"
NSQ_SOURCE_LINE 00001213 "directory."
NSQ_SOURCE_LINE 00001214 "If you pass C<$extractedName>, it should be in the local file"
NSQ_SOURCE_LINE 00001215 "system's format."
NSQ_SOURCE_LINE 00001216 "If you do not pass C<$extractedName> and the internal filename traverses"
NSQ_SOURCE_LINE 00001217 "a parent directory or a symbolic link, the extraction will be aborted with"
NSQ_SOURCE_LINE 00001218 "C<AC_ERROR> for security reason."
NSQ_SOURCE_LINE 00001219 "All necessary directories will be created. Returns C<AZ_OK>"
NSQ_SOURCE_LINE 00001220 "on success."
NSQ_SOURCE_LINE 00001221 ""
NSQ_SOURCE_LINE 00001222 "=item extractMemberWithoutPaths( $memberOrName [, $extractedName ] )"
NSQ_SOURCE_LINE 00001223 ""
NSQ_SOURCE_LINE 00001224 "=item extractMemberWithoutPaths( { memberOrZipName => $memberOrName"
NSQ_SOURCE_LINE 00001225 "    [, name => $extractedName ] } )"
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "Extract the given member, or match its name and extract it."
NSQ_SOURCE_LINE 00001228 "Does not use path information (extracts into the current"
NSQ_SOURCE_LINE 00001229 "directory). Returns undef if member does not exist in this"
NSQ_SOURCE_LINE 00001230 "Zip."
NSQ_SOURCE_LINE 00001231 "If optional second arg is given, use it as the name of the"
NSQ_SOURCE_LINE 00001232 "extracted member (its paths will be deleted too). Otherwise,"
NSQ_SOURCE_LINE 00001233 "the internal filename of the member (minus paths) is used as"
NSQ_SOURCE_LINE 00001234 "the name of the extracted file or directory. Returns C<AZ_OK>"
NSQ_SOURCE_LINE 00001235 "on success."
NSQ_SOURCE_LINE 00001236 "If you do not pass C<$extractedName> and the internal filename is equalled"
NSQ_SOURCE_LINE 00001237 "to a local symbolic link, the extraction will be aborted with C<AC_ERROR> for"
NSQ_SOURCE_LINE 00001238 "security reason."
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "=item addMember( $member )"
NSQ_SOURCE_LINE 00001241 ""
NSQ_SOURCE_LINE 00001242 "=item addMember( { member => $member } )"
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "Append a member (possibly from another zip file) to the zip"
NSQ_SOURCE_LINE 00001245 "file. Returns the new member. Generally, you will use"
NSQ_SOURCE_LINE 00001246 "addFile(), addDirectory(), addFileOrDirectory(), addString(),"
NSQ_SOURCE_LINE 00001247 "or read() to add members."
NSQ_SOURCE_LINE 00001248 ""
NSQ_SOURCE_LINE 00001249 "    # Move member named 'abc' to end of zip:"
NSQ_SOURCE_LINE 00001250 "    my $member = $zip->removeMember( 'abc' );"
NSQ_SOURCE_LINE 00001251 "    $zip->addMember( $member );"
NSQ_SOURCE_LINE 00001252 ""
NSQ_SOURCE_LINE 00001253 "=item updateMember( $memberOrName, $fileName )"
NSQ_SOURCE_LINE 00001254 ""
NSQ_SOURCE_LINE 00001255 "=item updateMember( { memberOrZipName => $memberOrName, name => $fileName } )"
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "Update a single member from the file or directory named C<$fileName>."
NSQ_SOURCE_LINE 00001258 "Returns the (possibly added or updated) member, if any; C<undef> on"
NSQ_SOURCE_LINE 00001259 "errors."
NSQ_SOURCE_LINE 00001260 "The comparison is based on C<lastModTime()> and (in the case of a"
NSQ_SOURCE_LINE 00001261 "non-directory) the size of the file."
NSQ_SOURCE_LINE 00001262 ""
NSQ_SOURCE_LINE 00001263 "=item addFile( $fileName [, $newName, $compressionLevel ] )"
NSQ_SOURCE_LINE 00001264 ""
NSQ_SOURCE_LINE 00001265 "=item addFile( { filename => $fileName"
NSQ_SOURCE_LINE 00001266 "    [, zipName => $newName, compressionLevel => $compressionLevel } ] )"
NSQ_SOURCE_LINE 00001267 ""
NSQ_SOURCE_LINE 00001268 "Append a member whose data comes from an external file,"
NSQ_SOURCE_LINE 00001269 "returning the member or undef. The member will have its file"
NSQ_SOURCE_LINE 00001270 "name set to the name of the external file, and its"
NSQ_SOURCE_LINE 00001271 "desiredCompressionMethod set to COMPRESSION_DEFLATED. The"
NSQ_SOURCE_LINE 00001272 "file attributes and last modification time will be set from"
NSQ_SOURCE_LINE 00001273 "the file."
NSQ_SOURCE_LINE 00001274 "If the name given does not represent a readable plain file or"
NSQ_SOURCE_LINE 00001275 "symbolic link, undef will be returned. C<$fileName> must be"
NSQ_SOURCE_LINE 00001276 "in the format required for the local file system."
NSQ_SOURCE_LINE 00001277 "The optional C<$newName> argument sets the internal file name"
NSQ_SOURCE_LINE 00001278 "to something different than the given $fileName. C<$newName>,"
NSQ_SOURCE_LINE 00001279 "if given, must be in Zip name format (i.e. Unix)."
NSQ_SOURCE_LINE 00001280 "The text mode bit will be set if the contents appears to be"
NSQ_SOURCE_LINE 00001281 "text (as returned by the C<-T> perl operator)."
NSQ_SOURCE_LINE 00001282 ""
NSQ_SOURCE_LINE 00001283 ""
NSQ_SOURCE_LINE 00001284 "I<NOTE> that you should not (generally) use absolute path names"
NSQ_SOURCE_LINE 00001285 "in zip member names, as this will cause problems with some zip"
NSQ_SOURCE_LINE 00001286 "tools as well as introduce a security hole and make the zip"
NSQ_SOURCE_LINE 00001287 "harder to use."
NSQ_SOURCE_LINE 00001288 ""
NSQ_SOURCE_LINE 00001289 "=item addDirectory( $directoryName [, $fileName ] )"
NSQ_SOURCE_LINE 00001290 ""
NSQ_SOURCE_LINE 00001291 "=item addDirectory( { directoryName => $directoryName"
NSQ_SOURCE_LINE 00001292 "    [, zipName => $fileName ] } )"
NSQ_SOURCE_LINE 00001293 ""
NSQ_SOURCE_LINE 00001294 ""
NSQ_SOURCE_LINE 00001295 "Append a member created from the given directory name. The"
NSQ_SOURCE_LINE 00001296 "directory name does not have to name an existing directory."
NSQ_SOURCE_LINE 00001297 "If the named directory exists, the file modification time and"
NSQ_SOURCE_LINE 00001298 "permissions are set from the existing directory, otherwise"
NSQ_SOURCE_LINE 00001299 "they are set to now and permissive default permissions."
NSQ_SOURCE_LINE 00001300 "C<$directoryName> must be in local file system format."
NSQ_SOURCE_LINE 00001301 "The optional second argument sets the name of the archive"
NSQ_SOURCE_LINE 00001302 "member (which defaults to C<$directoryName>). If given, it"
NSQ_SOURCE_LINE 00001303 "must be in Zip (Unix) format."
NSQ_SOURCE_LINE 00001304 "Returns the new member."
NSQ_SOURCE_LINE 00001305 ""
NSQ_SOURCE_LINE 00001306 "=item addFileOrDirectory( $name [, $newName, $compressionLevel ] )"
NSQ_SOURCE_LINE 00001307 ""
NSQ_SOURCE_LINE 00001308 "=item addFileOrDirectory( { name => $name [, zipName => $newName,"
NSQ_SOURCE_LINE 00001309 "    compressionLevel => $compressionLevel ] } )"
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 ""
NSQ_SOURCE_LINE 00001312 "Append a member from the file or directory named $name. If"
NSQ_SOURCE_LINE 00001313 "$newName is given, use it for the name of the new member."
NSQ_SOURCE_LINE 00001314 "Will add or remove trailing slashes from $newName as needed."
NSQ_SOURCE_LINE 00001315 "C<$name> must be in local file system format."
NSQ_SOURCE_LINE 00001316 "The optional second argument sets the name of the archive"
NSQ_SOURCE_LINE 00001317 "member (which defaults to C<$name>). If given, it must be in"
NSQ_SOURCE_LINE 00001318 "Zip (Unix) format."
NSQ_SOURCE_LINE 00001319 ""
NSQ_SOURCE_LINE 00001320 "=item addString( $stringOrStringRef, $name, [$compressionLevel] )"
NSQ_SOURCE_LINE 00001321 ""
NSQ_SOURCE_LINE 00001322 "=item addString( { string => $stringOrStringRef [, zipName => $name,"
NSQ_SOURCE_LINE 00001323 "    compressionLevel => $compressionLevel ] } )"
NSQ_SOURCE_LINE 00001324 ""
NSQ_SOURCE_LINE 00001325 "Append a member created from the given string or string"
NSQ_SOURCE_LINE 00001326 "reference. The name is given by the second argument."
NSQ_SOURCE_LINE 00001327 "Returns the new member. The last modification time will be"
NSQ_SOURCE_LINE 00001328 "set to now, and the file attributes will be set to permissive"
NSQ_SOURCE_LINE 00001329 "defaults."
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 "    my $member = $zip->addString( 'This is a test', 'test.txt' );"
NSQ_SOURCE_LINE 00001332 ""
NSQ_SOURCE_LINE 00001333 "=item contents( $memberOrMemberName [, $newContents ] )"
NSQ_SOURCE_LINE 00001334 ""
NSQ_SOURCE_LINE 00001335 "=item contents( { memberOrZipName => $memberOrMemberName"
NSQ_SOURCE_LINE 00001336 "    [, contents => $newContents ] } )"
NSQ_SOURCE_LINE 00001337 ""
NSQ_SOURCE_LINE 00001338 ""
NSQ_SOURCE_LINE 00001339 "Returns the uncompressed data for a particular member, or"
NSQ_SOURCE_LINE 00001340 "undef."
NSQ_SOURCE_LINE 00001341 ""
NSQ_SOURCE_LINE 00001342 "    print \"xyz.txt contains \" . $zip->contents( 'xyz.txt' );"
NSQ_SOURCE_LINE 00001343 ""
NSQ_SOURCE_LINE 00001344 "Also can change the contents of a member:"
NSQ_SOURCE_LINE 00001345 ""
NSQ_SOURCE_LINE 00001346 "    $zip->contents( 'xyz.txt', 'This is the new contents' );"
NSQ_SOURCE_LINE 00001347 ""
NSQ_SOURCE_LINE 00001348 "If called expecting an array as the return value, it will include"
NSQ_SOURCE_LINE 00001349 "the status as the second value in the array."
NSQ_SOURCE_LINE 00001350 ""
NSQ_SOURCE_LINE 00001351 "    ($content, $status) = $zip->contents( 'xyz.txt');"
NSQ_SOURCE_LINE 00001352 ""
NSQ_SOURCE_LINE 00001353 "=back"
NSQ_SOURCE_LINE 00001354 ""
NSQ_SOURCE_LINE 00001355 "=head2 Zip Archive I/O operations"
NSQ_SOURCE_LINE 00001356 ""
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 "A Zip archive can be written to a file or file handle, or read from"
NSQ_SOURCE_LINE 00001359 "one."
NSQ_SOURCE_LINE 00001360 ""
NSQ_SOURCE_LINE 00001361 "=over 4"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "=item writeToFileNamed( $fileName )"
NSQ_SOURCE_LINE 00001364 ""
NSQ_SOURCE_LINE 00001365 "=item writeToFileNamed( { fileName => $fileName } )"
NSQ_SOURCE_LINE 00001366 ""
NSQ_SOURCE_LINE 00001367 "Write a zip archive to named file. Returns C<AZ_OK> on"
NSQ_SOURCE_LINE 00001368 "success."
NSQ_SOURCE_LINE 00001369 ""
NSQ_SOURCE_LINE 00001370 "    my $status = $zip->writeToFileNamed( 'xx.zip' );"
NSQ_SOURCE_LINE 00001371 "    die \"error somewhere\" if $status != AZ_OK;"
NSQ_SOURCE_LINE 00001372 ""
NSQ_SOURCE_LINE 00001373 "Note that if you use the same name as an existing zip file"
NSQ_SOURCE_LINE 00001374 "that you read in, you will clobber ZipFileMembers. So"
NSQ_SOURCE_LINE 00001375 "instead, write to a different file name, then delete the"
NSQ_SOURCE_LINE 00001376 "original."
NSQ_SOURCE_LINE 00001377 "If you use the C<overwrite()> or C<overwriteAs()> methods, you can"
NSQ_SOURCE_LINE 00001378 "re-write the original zip in this way."
NSQ_SOURCE_LINE 00001379 "C<$fileName> should be a valid file name on your system."
NSQ_SOURCE_LINE 00001380 ""
NSQ_SOURCE_LINE 00001381 "=item writeToFileHandle( $fileHandle [, $seekable] )"
NSQ_SOURCE_LINE 00001382 ""
NSQ_SOURCE_LINE 00001383 "Write a zip archive to a file handle. Return AZ_OK on"
NSQ_SOURCE_LINE 00001384 "success. The optional second arg tells whether or not to try"
NSQ_SOURCE_LINE 00001385 "to seek backwards to re-write headers. If not provided, it is"
NSQ_SOURCE_LINE 00001386 "set if the Perl C<-f> test returns true. This could fail on"
NSQ_SOURCE_LINE 00001387 "some operating systems, though."
NSQ_SOURCE_LINE 00001388 ""
NSQ_SOURCE_LINE 00001389 "    my $fh = IO::File->new( 'someFile.zip', 'w' );"
NSQ_SOURCE_LINE 00001390 "    unless ( $zip->writeToFileHandle( $fh ) == AZ_OK ) {"
NSQ_SOURCE_LINE 00001391 "        # error handling"
NSQ_SOURCE_LINE 00001392 "    }"
NSQ_SOURCE_LINE 00001393 ""
NSQ_SOURCE_LINE 00001394 "If you pass a file handle that is not seekable (like if"
NSQ_SOURCE_LINE 00001395 "you're writing to a pipe or a socket), pass a false second"
NSQ_SOURCE_LINE 00001396 "argument:"
NSQ_SOURCE_LINE 00001397 ""
NSQ_SOURCE_LINE 00001398 "    my $fh = IO::File->new( '| cat > somefile.zip', 'w' );"
NSQ_SOURCE_LINE 00001399 "    $zip->writeToFileHandle( $fh, 0 );   # fh is not seekable"
NSQ_SOURCE_LINE 00001400 ""
NSQ_SOURCE_LINE 00001401 "If this method fails during the write of a member, that"
NSQ_SOURCE_LINE 00001402 "member and all following it will return false from"
NSQ_SOURCE_LINE 00001403 "C<wasWritten()>. See writeCentralDirectory() for a way to"
NSQ_SOURCE_LINE 00001404 "deal with this."
NSQ_SOURCE_LINE 00001405 "If you want, you can write data to the file handle before"
NSQ_SOURCE_LINE 00001406 "passing it to writeToFileHandle(); this could be used (for"
NSQ_SOURCE_LINE 00001407 "instance) for making self-extracting archives. However, this"
NSQ_SOURCE_LINE 00001408 "only works reliably when writing to a real file (as opposed"
NSQ_SOURCE_LINE 00001409 "to STDOUT or some other possible non-file)."
NSQ_SOURCE_LINE 00001410 ""
NSQ_SOURCE_LINE 00001411 "See examples/selfex.pl for how to write a self-extracting"
NSQ_SOURCE_LINE 00001412 "archive."
NSQ_SOURCE_LINE 00001413 ""
NSQ_SOURCE_LINE 00001414 "=item writeCentralDirectory( $fileHandle [, $offset ] )"
NSQ_SOURCE_LINE 00001415 ""
NSQ_SOURCE_LINE 00001416 "=item writeCentralDirectory( { fileHandle => $fileHandle"
NSQ_SOURCE_LINE 00001417 "    [, offset => $offset ] } )"
NSQ_SOURCE_LINE 00001418 ""
NSQ_SOURCE_LINE 00001419 "Writes the central directory structure to the given file"
NSQ_SOURCE_LINE 00001420 "handle."
NSQ_SOURCE_LINE 00001421 ""
NSQ_SOURCE_LINE 00001422 "Returns AZ_OK on success. If given an $offset, will"
NSQ_SOURCE_LINE 00001423 "seek to that point before writing. This can be used for"
NSQ_SOURCE_LINE 00001424 "recovery in cases where writeToFileHandle or writeToFileNamed"
NSQ_SOURCE_LINE 00001425 "returns an IO error because of running out of space on the"
NSQ_SOURCE_LINE 00001426 "destination file."
NSQ_SOURCE_LINE 00001427 ""
NSQ_SOURCE_LINE 00001428 "You can truncate the zip by seeking backwards and then writing the"
NSQ_SOURCE_LINE 00001429 "directory:"
NSQ_SOURCE_LINE 00001430 ""
NSQ_SOURCE_LINE 00001431 "    my $fh = IO::File->new( 'someFile.zip', 'w' );"
NSQ_SOURCE_LINE 00001432 "        my $retval = $zip->writeToFileHandle( $fh );"
NSQ_SOURCE_LINE 00001433 "    if ( $retval == AZ_IO_ERROR ) {"
NSQ_SOURCE_LINE 00001434 "        my @unwritten = grep { not $_->wasWritten() } $zip->members();"
NSQ_SOURCE_LINE 00001435 "        if (@unwritten) {"
NSQ_SOURCE_LINE 00001436 "            $zip->removeMember( $member ) foreach my $member ( @unwritten );"
NSQ_SOURCE_LINE 00001437 "            $zip->writeCentralDirectory( $fh,"
NSQ_SOURCE_LINE 00001438 "            $unwritten[0]->writeLocalHeaderRelativeOffset());"
NSQ_SOURCE_LINE 00001439 "        }"
NSQ_SOURCE_LINE 00001440 "    }"
NSQ_SOURCE_LINE 00001441 ""
NSQ_SOURCE_LINE 00001442 "=item overwriteAs( $newName )"
NSQ_SOURCE_LINE 00001443 ""
NSQ_SOURCE_LINE 00001444 "=item overwriteAs( { filename => $newName } )"
NSQ_SOURCE_LINE 00001445 ""
NSQ_SOURCE_LINE 00001446 "Write the zip to the specified file, as safely as possible."
NSQ_SOURCE_LINE 00001447 "This is done by first writing to a temp file, then renaming"
NSQ_SOURCE_LINE 00001448 "the original if it exists, then renaming the temp file, then"
NSQ_SOURCE_LINE 00001449 "deleting the renamed original if it exists. Returns AZ_OK if"
NSQ_SOURCE_LINE 00001450 "successful."
NSQ_SOURCE_LINE 00001451 ""
NSQ_SOURCE_LINE 00001452 "=item overwrite()"
NSQ_SOURCE_LINE 00001453 ""
NSQ_SOURCE_LINE 00001454 "Write back to the original zip file. See overwriteAs() above."
NSQ_SOURCE_LINE 00001455 "If the zip was not ever read from a file, this generates an"
NSQ_SOURCE_LINE 00001456 "error."
NSQ_SOURCE_LINE 00001457 ""
NSQ_SOURCE_LINE 00001458 "=item read( $fileName )"
NSQ_SOURCE_LINE 00001459 ""
NSQ_SOURCE_LINE 00001460 "=item read( { filename => $fileName } )"
NSQ_SOURCE_LINE 00001461 ""
NSQ_SOURCE_LINE 00001462 "Read zipfile headers from a zip file, appending new members."
NSQ_SOURCE_LINE 00001463 "Returns C<AZ_OK> or error code."
NSQ_SOURCE_LINE 00001464 ""
NSQ_SOURCE_LINE 00001465 "    my $zipFile = Archive::Zip->new();"
NSQ_SOURCE_LINE 00001466 "    my $status = $zipFile->read( '/some/FileName.zip' );"
NSQ_SOURCE_LINE 00001467 ""
NSQ_SOURCE_LINE 00001468 "=item readFromFileHandle( $fileHandle, $filename )"
NSQ_SOURCE_LINE 00001469 ""
NSQ_SOURCE_LINE 00001470 "=item readFromFileHandle( { fileHandle => $fileHandle, filename => $filename } )"
NSQ_SOURCE_LINE 00001471 ""
NSQ_SOURCE_LINE 00001472 "Read zipfile headers from an already-opened file handle,"
NSQ_SOURCE_LINE 00001473 "appending new members. Does not close the file handle."
NSQ_SOURCE_LINE 00001474 "Returns C<AZ_OK> or error code. Note that this requires a"
NSQ_SOURCE_LINE 00001475 "seekable file handle; reading from a stream is not yet"
NSQ_SOURCE_LINE 00001476 "supported, but using in-memory data is."
NSQ_SOURCE_LINE 00001477 ""
NSQ_SOURCE_LINE 00001478 "    my $fh = IO::File->new( '/some/FileName.zip', 'r' );"
NSQ_SOURCE_LINE 00001479 "    my $zip1 = Archive::Zip->new();"
NSQ_SOURCE_LINE 00001480 "    my $status = $zip1->readFromFileHandle( $fh );"
NSQ_SOURCE_LINE 00001481 "    my $zip2 = Archive::Zip->new();"
NSQ_SOURCE_LINE 00001482 "    $status = $zip2->readFromFileHandle( $fh );"
NSQ_SOURCE_LINE 00001483 ""
NSQ_SOURCE_LINE 00001484 "Read zip using in-memory data (recursable):"
NSQ_SOURCE_LINE 00001485 ""
NSQ_SOURCE_LINE 00001486 "    open my $fh, \"<\", \"archive.zip\" or die $!;"
NSQ_SOURCE_LINE 00001487 "    my $zip_data = do { local $.; <$fh> };"
NSQ_SOURCE_LINE 00001488 "    my $zip = Archive::Zip->new;"
NSQ_SOURCE_LINE 00001489 "    open my $dh, \"+<\", \\$zip_data;"
NSQ_SOURCE_LINE 00001490 "    $zip->readFromFileHandle ($dh);"
NSQ_SOURCE_LINE 00001491 ""
NSQ_SOURCE_LINE 00001492 "=back"
NSQ_SOURCE_LINE 00001493 ""
NSQ_SOURCE_LINE 00001494 "=head2 Zip Archive Tree operations"
NSQ_SOURCE_LINE 00001495 ""
NSQ_SOURCE_LINE 00001496 "These used to be in Archive::Zip::Tree but got moved into"
NSQ_SOURCE_LINE 00001497 "Archive::Zip. They enable operation on an entire tree of members or"
NSQ_SOURCE_LINE 00001498 "files."
NSQ_SOURCE_LINE 00001499 "A usage example:"
NSQ_SOURCE_LINE 00001500 ""
NSQ_SOURCE_LINE 00001501 "  use Archive::Zip;"
NSQ_SOURCE_LINE 00001502 "  my $zip = Archive::Zip->new();"
NSQ_SOURCE_LINE 00001503 ""
NSQ_SOURCE_LINE 00001504 "  # add all readable files and directories below . as xyz/*"
NSQ_SOURCE_LINE 00001505 "  $zip->addTree( '.', 'xyz' );"
NSQ_SOURCE_LINE 00001506 ""
NSQ_SOURCE_LINE 00001507 "  # add all readable plain files below /abc as def/*"
NSQ_SOURCE_LINE 00001508 "  $zip->addTree( '/abc', 'def', sub { -f && -r } );"
NSQ_SOURCE_LINE 00001509 ""
NSQ_SOURCE_LINE 00001510 "  # add all .c files below /tmp as stuff/*"
NSQ_SOURCE_LINE 00001511 "  $zip->addTreeMatching( '/tmp', 'stuff', '\\.c$' );"
NSQ_SOURCE_LINE 00001512 ""
NSQ_SOURCE_LINE 00001513 "  # add all .o files below /tmp as stuff/* if they aren't writable"
NSQ_SOURCE_LINE 00001514 "  $zip->addTreeMatching( '/tmp', 'stuff', '\\.o$', sub { ! -w } );"
NSQ_SOURCE_LINE 00001515 ""
NSQ_SOURCE_LINE 00001516 "  # add all .so files below /tmp that are smaller than 200 bytes as stuff/*"
NSQ_SOURCE_LINE 00001517 "  $zip->addTreeMatching( '/tmp', 'stuff', '\\.o$', sub { -s < 200 } );"
NSQ_SOURCE_LINE 00001518 ""
NSQ_SOURCE_LINE 00001519 "  # and write them into a file"
NSQ_SOURCE_LINE 00001520 "  $zip->writeToFileNamed('xxx.zip');"
NSQ_SOURCE_LINE 00001521 ""
NSQ_SOURCE_LINE 00001522 "  # now extract the same files into /tmpx"
NSQ_SOURCE_LINE 00001523 "  $zip->extractTree( 'stuff', '/tmpx' );"
NSQ_SOURCE_LINE 00001524 ""
NSQ_SOURCE_LINE 00001525 "=over 4"
NSQ_SOURCE_LINE 00001526 ""
NSQ_SOURCE_LINE 00001527 "=item $zip->addTree( $root, $dest [, $pred, $compressionLevel ] ) -- Add tree of files to a zip"
NSQ_SOURCE_LINE 00001528 ""
NSQ_SOURCE_LINE 00001529 "=item $zip->addTree( { root => $root, zipName => $dest [, select => $pred,"
NSQ_SOURCE_LINE 00001530 "    compressionLevel => $compressionLevel ] )"
NSQ_SOURCE_LINE 00001531 ""
NSQ_SOURCE_LINE 00001532 "C<$root> is the root of the tree of files and directories to be"
NSQ_SOURCE_LINE 00001533 "added. It is a valid directory name on your system. C<$dest> is"
NSQ_SOURCE_LINE 00001534 "the name for the root in the zip file (undef or blank means"
NSQ_SOURCE_LINE 00001535 "to use relative pathnames). It is a valid ZIP directory name"
NSQ_SOURCE_LINE 00001536 "(that is, it uses forward slashes (/) for separating"
NSQ_SOURCE_LINE 00001537 "directory components). C<$pred> is an optional subroutine"
NSQ_SOURCE_LINE 00001538 "reference to select files: it is passed the name of the"
NSQ_SOURCE_LINE 00001539 "prospective file or directory using C<$_>, and if it returns"
NSQ_SOURCE_LINE 00001540 "true, the file or directory will be included. The default is"
NSQ_SOURCE_LINE 00001541 "to add all readable files and directories. For instance,"
NSQ_SOURCE_LINE 00001542 "using"
NSQ_SOURCE_LINE 00001543 ""
NSQ_SOURCE_LINE 00001544 "  my $pred = sub { /\\.txt/ };"
NSQ_SOURCE_LINE 00001545 "  $zip->addTree( '.', '', $pred );"
NSQ_SOURCE_LINE 00001546 ""
NSQ_SOURCE_LINE 00001547 "will add all the .txt files in and below the current"
NSQ_SOURCE_LINE 00001548 "directory, using relative names, and making the names"
NSQ_SOURCE_LINE 00001549 "identical in the zipfile:"
NSQ_SOURCE_LINE 00001550 ""
NSQ_SOURCE_LINE 00001551 "  original name           zip member name"
NSQ_SOURCE_LINE 00001552 "  ./xyz                   xyz"
NSQ_SOURCE_LINE 00001553 "  ./a/                    a/"
NSQ_SOURCE_LINE 00001554 "  ./a/b                   a/b"
NSQ_SOURCE_LINE 00001555 ""
NSQ_SOURCE_LINE 00001556 "To translate absolute to relative pathnames, just pass them"
NSQ_SOURCE_LINE 00001557 "in: $zip->addTree( '/c/d', 'a' );"
NSQ_SOURCE_LINE 00001558 ""
NSQ_SOURCE_LINE 00001559 "  original name           zip member name"
NSQ_SOURCE_LINE 00001560 "  /c/d/xyz                a/xyz"
NSQ_SOURCE_LINE 00001561 "  /c/d/a/                 a/a/"
NSQ_SOURCE_LINE 00001562 "  /c/d/a/b                a/a/b"
NSQ_SOURCE_LINE 00001563 ""
NSQ_SOURCE_LINE 00001564 "Returns AZ_OK on success. Note that this will not follow"
NSQ_SOURCE_LINE 00001565 "symbolic links to directories. Note also that this does not"
NSQ_SOURCE_LINE 00001566 "check for the validity of filenames."
NSQ_SOURCE_LINE 00001567 ""
NSQ_SOURCE_LINE 00001568 "Note that you generally I<don't> want to make zip archive member names"
NSQ_SOURCE_LINE 00001569 "absolute."
NSQ_SOURCE_LINE 00001570 ""
NSQ_SOURCE_LINE 00001571 "=item $zip->addTreeMatching( $root, $dest, $pattern [, $pred, $compressionLevel ] )"
NSQ_SOURCE_LINE 00001572 ""
NSQ_SOURCE_LINE 00001573 "=item $zip->addTreeMatching( { root => $root, zipName => $dest, pattern =>"
NSQ_SOURCE_LINE 00001574 "    $pattern [, select => $pred, compressionLevel => $compressionLevel ] } )"
NSQ_SOURCE_LINE 00001575 ""
NSQ_SOURCE_LINE 00001576 "$root is the root of the tree of files and directories to be"
NSQ_SOURCE_LINE 00001577 "added $dest is the name for the root in the zip file (undef"
NSQ_SOURCE_LINE 00001578 "means to use relative pathnames) $pattern is a (non-anchored)"
NSQ_SOURCE_LINE 00001579 "regular expression for filenames to match $pred is an"
NSQ_SOURCE_LINE 00001580 "optional subroutine reference to select files: it is passed"
NSQ_SOURCE_LINE 00001581 "the name of the prospective file or directory in C<$_>, and"
NSQ_SOURCE_LINE 00001582 "if it returns true, the file or directory will be included."
NSQ_SOURCE_LINE 00001583 "The default is to add all readable files and directories. To"
NSQ_SOURCE_LINE 00001584 "add all files in and below the current directory whose names"
NSQ_SOURCE_LINE 00001585 "end in C<.pl>, and make them extract into a subdirectory"
NSQ_SOURCE_LINE 00001586 "named C<xyz>, do this:"
NSQ_SOURCE_LINE 00001587 ""
NSQ_SOURCE_LINE 00001588 "  $zip->addTreeMatching( '.', 'xyz', '\\.pl$' )"
NSQ_SOURCE_LINE 00001589 ""
NSQ_SOURCE_LINE 00001590 "To add all I<writable> files in and below the directory named"
NSQ_SOURCE_LINE 00001591 "C</abc> whose names end in C<.pl>, and make them extract into"
NSQ_SOURCE_LINE 00001592 "a subdirectory named C<xyz>, do this:"
NSQ_SOURCE_LINE 00001593 ""
NSQ_SOURCE_LINE 00001594 "  $zip->addTreeMatching( '/abc', 'xyz', '\\.pl$', sub { -w } )"
NSQ_SOURCE_LINE 00001595 ""
NSQ_SOURCE_LINE 00001596 "Returns AZ_OK on success. Note that this will not follow"
NSQ_SOURCE_LINE 00001597 "symbolic links to directories."
NSQ_SOURCE_LINE 00001598 ""
NSQ_SOURCE_LINE 00001599 "=item $zip->updateTree( $root [, $dest , $pred , $mirror, $compressionLevel ] );"
NSQ_SOURCE_LINE 00001600 ""
NSQ_SOURCE_LINE 00001601 "=item $zip->updateTree( { root => $root [, zipName => $dest, select => $pred,"
NSQ_SOURCE_LINE 00001602 "    mirror => $mirror, compressionLevel => $compressionLevel ] } );"
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "Update a zip file from a directory tree."
NSQ_SOURCE_LINE 00001605 ""
NSQ_SOURCE_LINE 00001606 "C<updateTree()> takes the same arguments as C<addTree()>, but first"
NSQ_SOURCE_LINE 00001607 "checks to see whether the file or directory already exists in the zip"
NSQ_SOURCE_LINE 00001608 "file, and whether it has been changed."
NSQ_SOURCE_LINE 00001609 ""
NSQ_SOURCE_LINE 00001610 "If the fourth argument C<$mirror> is true, then delete all my members"
NSQ_SOURCE_LINE 00001611 "if corresponding files were not found."
NSQ_SOURCE_LINE 00001612 ""
NSQ_SOURCE_LINE 00001613 "Returns an error code or AZ_OK if all is well."
NSQ_SOURCE_LINE 00001614 ""
NSQ_SOURCE_LINE 00001615 "=item $zip->extractTree( [ $root, $dest, $volume } ] )"
NSQ_SOURCE_LINE 00001616 ""
NSQ_SOURCE_LINE 00001617 "=item $zip->extractTree( [ { root => $root, zipName => $dest, volume => $volume } ] )"
NSQ_SOURCE_LINE 00001618 ""
NSQ_SOURCE_LINE 00001619 "If you don't give any arguments at all, will extract all the"
NSQ_SOURCE_LINE 00001620 "files in the zip with their original names."
NSQ_SOURCE_LINE 00001621 ""
NSQ_SOURCE_LINE 00001622 "If you supply one argument for C<$root>, C<extractTree> will extract"
NSQ_SOURCE_LINE 00001623 "all the members whose names start with C<$root> into the current"
NSQ_SOURCE_LINE 00001624 "directory, stripping off C<$root> first."
NSQ_SOURCE_LINE 00001625 "C<$root> is in Zip (Unix) format."
NSQ_SOURCE_LINE 00001626 "For instance,"
NSQ_SOURCE_LINE 00001627 ""
NSQ_SOURCE_LINE 00001628 "  $zip->extractTree( 'a' );"
NSQ_SOURCE_LINE 00001629 ""
NSQ_SOURCE_LINE 00001630 "when applied to a zip containing the files:"
NSQ_SOURCE_LINE 00001631 "a/x a/b/c ax/d/e d/e will extract:"
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "a/x as ./x"
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "a/b/c as ./b/c"
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 "If you give two arguments, C<extractTree> extracts all the members"
NSQ_SOURCE_LINE 00001638 "whose names start with C<$root>. It will translate C<$root> into"
NSQ_SOURCE_LINE 00001639 "C<$dest> to construct the destination file name."
NSQ_SOURCE_LINE 00001640 "C<$root> and C<$dest> are in Zip (Unix) format."
NSQ_SOURCE_LINE 00001641 "For instance,"
NSQ_SOURCE_LINE 00001642 ""
NSQ_SOURCE_LINE 00001643 "   $zip->extractTree( 'a', 'd/e' );"
NSQ_SOURCE_LINE 00001644 ""
NSQ_SOURCE_LINE 00001645 "when applied to a zip containing the files:"
NSQ_SOURCE_LINE 00001646 "a/x a/b/c ax/d/e d/e will extract:"
NSQ_SOURCE_LINE 00001647 ""
NSQ_SOURCE_LINE 00001648 "a/x to d/e/x"
NSQ_SOURCE_LINE 00001649 ""
NSQ_SOURCE_LINE 00001650 "a/b/c to d/e/b/c and ignore ax/d/e and d/e"
NSQ_SOURCE_LINE 00001651 ""
NSQ_SOURCE_LINE 00001652 "If you give three arguments, C<extractTree> extracts all the members"
NSQ_SOURCE_LINE 00001653 "whose names start with C<$root>. It will translate C<$root> into"
NSQ_SOURCE_LINE 00001654 "C<$dest> to construct the destination file name, and then it will"
NSQ_SOURCE_LINE 00001655 "convert to local file system format, using C<$volume> as the name of"
NSQ_SOURCE_LINE 00001656 "the destination volume."
NSQ_SOURCE_LINE 00001657 ""
NSQ_SOURCE_LINE 00001658 "C<$root> and C<$dest> are in Zip (Unix) format."
NSQ_SOURCE_LINE 00001659 ""
NSQ_SOURCE_LINE 00001660 "C<$volume> is in local file system format."
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "For instance, under Windows,"
NSQ_SOURCE_LINE 00001663 ""
NSQ_SOURCE_LINE 00001664 "   $zip->extractTree( 'a', 'd/e', 'f:' );"
NSQ_SOURCE_LINE 00001665 ""
NSQ_SOURCE_LINE 00001666 "when applied to a zip containing the files:"
NSQ_SOURCE_LINE 00001667 "a/x a/b/c ax/d/e d/e will extract:"
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 "a/x to f:d/e/x"
NSQ_SOURCE_LINE 00001670 ""
NSQ_SOURCE_LINE 00001671 "a/b/c to f:d/e/b/c and ignore ax/d/e and d/e"
NSQ_SOURCE_LINE 00001672 ""
NSQ_SOURCE_LINE 00001673 "If you want absolute paths (the prior example used paths relative to"
NSQ_SOURCE_LINE 00001674 "the current directory on the destination volume, you can specify these"
NSQ_SOURCE_LINE 00001675 "in C<$dest>:"
NSQ_SOURCE_LINE 00001676 ""
NSQ_SOURCE_LINE 00001677 "   $zip->extractTree( 'a', '/d/e', 'f:' );"
NSQ_SOURCE_LINE 00001678 ""
NSQ_SOURCE_LINE 00001679 "when applied to a zip containing the files:"
NSQ_SOURCE_LINE 00001680 "a/x a/b/c ax/d/e d/e will extract:"
NSQ_SOURCE_LINE 00001681 ""
NSQ_SOURCE_LINE 00001682 "a/x to f:\\d\\e\\x"
NSQ_SOURCE_LINE 00001683 ""
NSQ_SOURCE_LINE 00001684 "a/b/c to f:\\d\\e\\b\\c and ignore ax/d/e and d/e"
NSQ_SOURCE_LINE 00001685 ""
NSQ_SOURCE_LINE 00001686 "If the path to the extracted file traverses a parent directory or a symbolic"
NSQ_SOURCE_LINE 00001687 "link, the extraction will be aborted with C<AC_ERROR> for security reason."
NSQ_SOURCE_LINE 00001688 "Returns an error code or AZ_OK if everything worked OK."
NSQ_SOURCE_LINE 00001689 ""
NSQ_SOURCE_LINE 00001690 "=back"
NSQ_SOURCE_LINE 00001691 ""
NSQ_SOURCE_LINE 00001692 "=head1 Archive::Zip Global Variables"
NSQ_SOURCE_LINE 00001693 ""
NSQ_SOURCE_LINE 00001694 "=over 4"
NSQ_SOURCE_LINE 00001695 ""
NSQ_SOURCE_LINE 00001696 "=item $Archive::Zip::UNICODE"
NSQ_SOURCE_LINE 00001697 ""
NSQ_SOURCE_LINE 00001698 "This variable governs how Unicode file and directory names are added"
NSQ_SOURCE_LINE 00001699 "to or extracted from an archive. If set, file and directory names are considered"
NSQ_SOURCE_LINE 00001700 "to be UTF-8 encoded. This is I<EXPERIMENTAL AND BUGGY (there are some edge cases"
NSQ_SOURCE_LINE 00001701 "on Win32)>. Please report problems."
NSQ_SOURCE_LINE 00001702 ""
NSQ_SOURCE_LINE 00001703 "    {"
NSQ_SOURCE_LINE 00001704 "        local $Archive::Zip::UNICODE = 1;"
NSQ_SOURCE_LINE 00001705 "        $zip->addFile('Déjà vu.txt');"
NSQ_SOURCE_LINE 00001706 "    }"
NSQ_SOURCE_LINE 00001707 ""
NSQ_SOURCE_LINE 00001708 "=back"
NSQ_SOURCE_LINE 00001709 ""
NSQ_SOURCE_LINE 00001710 "=head1 MEMBER OPERATIONS"
NSQ_SOURCE_LINE 00001711 ""
NSQ_SOURCE_LINE 00001712 "=head2 Member Class Methods"
NSQ_SOURCE_LINE 00001713 ""
NSQ_SOURCE_LINE 00001714 "Several constructors allow you to construct members without adding"
NSQ_SOURCE_LINE 00001715 "them to a zip archive. These work the same as the addFile(),"
NSQ_SOURCE_LINE 00001716 "addDirectory(), and addString() zip instance methods described above,"
NSQ_SOURCE_LINE 00001717 "but they don't add the new members to a zip."
NSQ_SOURCE_LINE 00001718 ""
NSQ_SOURCE_LINE 00001719 "=over 4"
NSQ_SOURCE_LINE 00001720 ""
NSQ_SOURCE_LINE 00001721 "=item Archive::Zip::Member->newFromString( $stringOrStringRef [, $fileName ] )"
NSQ_SOURCE_LINE 00001722 ""
NSQ_SOURCE_LINE 00001723 "=item Archive::Zip::Member->newFromString( { string => $stringOrStringRef"
NSQ_SOURCE_LINE 00001724 "    [, zipName => $fileName ] )"
NSQ_SOURCE_LINE 00001725 ""
NSQ_SOURCE_LINE 00001726 "Construct a new member from the given string. Returns undef"
NSQ_SOURCE_LINE 00001727 "on error."
NSQ_SOURCE_LINE 00001728 ""
NSQ_SOURCE_LINE 00001729 "    my $member = Archive::Zip::Member->newFromString( 'This is a test' );"
NSQ_SOURCE_LINE 00001730 "    my $member = Archive::Zip::Member->newFromString( 'This is a test', 'test.txt' );"
NSQ_SOURCE_LINE 00001731 "    my $member = Archive::Zip::Member->newFromString( { string => 'This is a test', zipName => 'test.txt' } );"
NSQ_SOURCE_LINE 00001732 ""
NSQ_SOURCE_LINE 00001733 "=item newFromFile( $fileName [, $zipName ] )"
NSQ_SOURCE_LINE 00001734 ""
NSQ_SOURCE_LINE 00001735 "=item newFromFile( { filename => $fileName [, zipName => $zipName ] } )"
NSQ_SOURCE_LINE 00001736 ""
NSQ_SOURCE_LINE 00001737 "Construct a new member from the given file. Returns undef on"
NSQ_SOURCE_LINE 00001738 "error."
NSQ_SOURCE_LINE 00001739 ""
NSQ_SOURCE_LINE 00001740 "    my $member = Archive::Zip::Member->newFromFile( 'xyz.txt' );"
NSQ_SOURCE_LINE 00001741 ""
NSQ_SOURCE_LINE 00001742 "=item newDirectoryNamed( $directoryName [, $zipname ] )"
NSQ_SOURCE_LINE 00001743 ""
NSQ_SOURCE_LINE 00001744 "=item newDirectoryNamed( { directoryName => $directoryName"
NSQ_SOURCE_LINE 00001745 "    [, zipName => $zipname ] } )"
NSQ_SOURCE_LINE 00001746 ""
NSQ_SOURCE_LINE 00001747 "Construct a new member from the given directory."
NSQ_SOURCE_LINE 00001748 "C<$directoryName> must be a valid name on your file system; it does not"
NSQ_SOURCE_LINE 00001749 "have to exist."
NSQ_SOURCE_LINE 00001750 ""
NSQ_SOURCE_LINE 00001751 "If given, C<$zipname> will be the name of the zip member; it must be a"
NSQ_SOURCE_LINE 00001752 "valid Zip (Unix) name. If not given, it will be converted from"
NSQ_SOURCE_LINE 00001753 "C<$directoryName>."
NSQ_SOURCE_LINE 00001754 ""
NSQ_SOURCE_LINE 00001755 "Returns undef on error."
NSQ_SOURCE_LINE 00001756 ""
NSQ_SOURCE_LINE 00001757 "    my $member = Archive::Zip::Member->newDirectoryNamed( 'CVS/' );"
NSQ_SOURCE_LINE 00001758 ""
NSQ_SOURCE_LINE 00001759 "=back"
NSQ_SOURCE_LINE 00001760 ""
NSQ_SOURCE_LINE 00001761 "=head2 Member Simple Accessors"
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 "These methods get (and/or set) member attribute values."
NSQ_SOURCE_LINE 00001764 ""
NSQ_SOURCE_LINE 00001765 "The zip64 format requires parts of the member data to be stored"
NSQ_SOURCE_LINE 00001766 "in the so-called extra fields.  You cannot get nor set this zip64"
NSQ_SOURCE_LINE 00001767 "data through the extra field accessors described in this section."
NSQ_SOURCE_LINE 00001768 "In fact, the low-level member methods ensure that the zip64 data"
NSQ_SOURCE_LINE 00001769 "in the extra fields is handled completely transparently and"
NSQ_SOURCE_LINE 00001770 "invisibly to the user when members are read or written."
NSQ_SOURCE_LINE 00001771 ""
NSQ_SOURCE_LINE 00001772 "=over 4"
NSQ_SOURCE_LINE 00001773 ""
NSQ_SOURCE_LINE 00001774 "=item zip64()"
NSQ_SOURCE_LINE 00001775 ""
NSQ_SOURCE_LINE 00001776 "Returns whether the previous read or write of the member has been"
NSQ_SOURCE_LINE 00001777 "done in zip64 format."
NSQ_SOURCE_LINE 00001778 ""
NSQ_SOURCE_LINE 00001779 "=item desiredZip64Mode()"
NSQ_SOURCE_LINE 00001780 ""
NSQ_SOURCE_LINE 00001781 "Gets or sets whether the member's headers should be written in"
NSQ_SOURCE_LINE 00001782 "zip64 format: As needed (ZIP64_AS_NEEDED), the default, or always"
NSQ_SOURCE_LINE 00001783 "(ZIP64_HEADERS)."
NSQ_SOURCE_LINE 00001784 ""
NSQ_SOURCE_LINE 00001785 "=item versionMadeBy()"
NSQ_SOURCE_LINE 00001786 ""
NSQ_SOURCE_LINE 00001787 "Gets the field from the member header."
NSQ_SOURCE_LINE 00001788 ""
NSQ_SOURCE_LINE 00001789 "=item fileAttributeFormat( [ $format ] )"
NSQ_SOURCE_LINE 00001790 ""
NSQ_SOURCE_LINE 00001791 "=item fileAttributeFormat( [ { format => $format ] } )"
NSQ_SOURCE_LINE 00001792 ""
NSQ_SOURCE_LINE 00001793 "Gets or sets the field from the member header. These are"
NSQ_SOURCE_LINE 00001794 "C<FA_*> values."
NSQ_SOURCE_LINE 00001795 ""
NSQ_SOURCE_LINE 00001796 "=item versionNeededToExtract()"
NSQ_SOURCE_LINE 00001797 ""
NSQ_SOURCE_LINE 00001798 "Gets the field from the member header."
NSQ_SOURCE_LINE 00001799 ""
NSQ_SOURCE_LINE 00001800 "=item bitFlag()"
NSQ_SOURCE_LINE 00001801 ""
NSQ_SOURCE_LINE 00001802 "Gets the general purpose bit field from the member header."
NSQ_SOURCE_LINE 00001803 "This is where the C<GPBF_*> bits live."
NSQ_SOURCE_LINE 00001804 ""
NSQ_SOURCE_LINE 00001805 "=item compressionMethod()"
NSQ_SOURCE_LINE 00001806 ""
NSQ_SOURCE_LINE 00001807 "Returns the member compression method. This is the method"
NSQ_SOURCE_LINE 00001808 "that is currently being used to compress the member data."
NSQ_SOURCE_LINE 00001809 "This will be COMPRESSION_STORED for added string or file"
NSQ_SOURCE_LINE 00001810 "members, or any of the C<COMPRESSION_*> values for members"
NSQ_SOURCE_LINE 00001811 "from a zip file. However, this module can only handle members"
NSQ_SOURCE_LINE 00001812 "whose data is in COMPRESSION_STORED or COMPRESSION_DEFLATED"
NSQ_SOURCE_LINE 00001813 "format."
NSQ_SOURCE_LINE 00001814 ""
NSQ_SOURCE_LINE 00001815 "=item desiredCompressionMethod( [ $method ] )"
NSQ_SOURCE_LINE 00001816 ""
NSQ_SOURCE_LINE 00001817 "=item desiredCompressionMethod( [ { compressionMethod => $method } ] )"
NSQ_SOURCE_LINE 00001818 ""
NSQ_SOURCE_LINE 00001819 "Get or set the member's C<desiredCompressionMethod>. This is"
NSQ_SOURCE_LINE 00001820 "the compression method that will be used when the member is"
NSQ_SOURCE_LINE 00001821 "written. Returns prior desiredCompressionMethod. Only"
NSQ_SOURCE_LINE 00001822 "COMPRESSION_DEFLATED or COMPRESSION_STORED are valid"
NSQ_SOURCE_LINE 00001823 "arguments. Changing to COMPRESSION_STORED will change the"
NSQ_SOURCE_LINE 00001824 "member desiredCompressionLevel to 0; changing to"
NSQ_SOURCE_LINE 00001825 "COMPRESSION_DEFLATED will change the member"
NSQ_SOURCE_LINE 00001826 "desiredCompressionLevel to COMPRESSION_LEVEL_DEFAULT."
NSQ_SOURCE_LINE 00001827 ""
NSQ_SOURCE_LINE 00001828 "=item desiredCompressionLevel( [ $level ] )"
NSQ_SOURCE_LINE 00001829 ""
NSQ_SOURCE_LINE 00001830 "=item desiredCompressionLevel( [ { compressionLevel => $level } ] )"
NSQ_SOURCE_LINE 00001831 ""
NSQ_SOURCE_LINE 00001832 "Get or set the member's desiredCompressionLevel This is the"
NSQ_SOURCE_LINE 00001833 "method that will be used to write. Returns prior"
NSQ_SOURCE_LINE 00001834 "desiredCompressionLevel. Valid arguments are 0 through 9,"
NSQ_SOURCE_LINE 00001835 "COMPRESSION_LEVEL_NONE, COMPRESSION_LEVEL_DEFAULT,"
NSQ_SOURCE_LINE 00001836 "COMPRESSION_LEVEL_BEST_COMPRESSION, and"
NSQ_SOURCE_LINE 00001837 "COMPRESSION_LEVEL_FASTEST. 0 or COMPRESSION_LEVEL_NONE will"
NSQ_SOURCE_LINE 00001838 "change the desiredCompressionMethod to COMPRESSION_STORED."
NSQ_SOURCE_LINE 00001839 "All other arguments will change the desiredCompressionMethod"
NSQ_SOURCE_LINE 00001840 "to COMPRESSION_DEFLATED."
NSQ_SOURCE_LINE 00001841 ""
NSQ_SOURCE_LINE 00001842 "=item externalFileName()"
NSQ_SOURCE_LINE 00001843 ""
NSQ_SOURCE_LINE 00001844 "Return the member's external file name, if any, or undef."
NSQ_SOURCE_LINE 00001845 ""
NSQ_SOURCE_LINE 00001846 "=item fileName()"
NSQ_SOURCE_LINE 00001847 ""
NSQ_SOURCE_LINE 00001848 "Get or set the member's internal filename. Returns the"
NSQ_SOURCE_LINE 00001849 "(possibly new) filename. Names will have backslashes"
NSQ_SOURCE_LINE 00001850 "converted to forward slashes, and will have multiple"
NSQ_SOURCE_LINE 00001851 "consecutive slashes converted to single ones."
NSQ_SOURCE_LINE 00001852 ""
NSQ_SOURCE_LINE 00001853 "=item lastModFileDateTime()"
NSQ_SOURCE_LINE 00001854 ""
NSQ_SOURCE_LINE 00001855 "Return the member's last modification date/time stamp in"
NSQ_SOURCE_LINE 00001856 "MS-DOS format."
NSQ_SOURCE_LINE 00001857 ""
NSQ_SOURCE_LINE 00001858 "=item lastModTime()"
NSQ_SOURCE_LINE 00001859 ""
NSQ_SOURCE_LINE 00001860 "Return the member's last modification date/time stamp,"
NSQ_SOURCE_LINE 00001861 "converted to unix localtime format."
NSQ_SOURCE_LINE 00001862 ""
NSQ_SOURCE_LINE 00001863 "    print \"Mod Time: \" . scalar( localtime( $member->lastModTime() ) );"
NSQ_SOURCE_LINE 00001864 ""
NSQ_SOURCE_LINE 00001865 "=item setLastModFileDateTimeFromUnix()"
NSQ_SOURCE_LINE 00001866 ""
NSQ_SOURCE_LINE 00001867 "Set the member's lastModFileDateTime from the given unix"
NSQ_SOURCE_LINE 00001868 "time."
NSQ_SOURCE_LINE 00001869 ""
NSQ_SOURCE_LINE 00001870 "    $member->setLastModFileDateTimeFromUnix( time() );"
NSQ_SOURCE_LINE 00001871 ""
NSQ_SOURCE_LINE 00001872 "=item internalFileAttributes()"
NSQ_SOURCE_LINE 00001873 ""
NSQ_SOURCE_LINE 00001874 "Return the internal file attributes field from the zip"
NSQ_SOURCE_LINE 00001875 "header. This is only set for members read from a zip file."
NSQ_SOURCE_LINE 00001876 ""
NSQ_SOURCE_LINE 00001877 "=item externalFileAttributes()"
NSQ_SOURCE_LINE 00001878 ""
NSQ_SOURCE_LINE 00001879 "Return member attributes as read from the ZIP file. Note that"
NSQ_SOURCE_LINE 00001880 "these are NOT UNIX!"
NSQ_SOURCE_LINE 00001881 ""
NSQ_SOURCE_LINE 00001882 "=item unixFileAttributes( [ $newAttributes ] )"
NSQ_SOURCE_LINE 00001883 ""
NSQ_SOURCE_LINE 00001884 "=item unixFileAttributes( [ { attributes => $newAttributes } ] )"
NSQ_SOURCE_LINE 00001885 ""
NSQ_SOURCE_LINE 00001886 "Get or set the member's file attributes using UNIX file"
NSQ_SOURCE_LINE 00001887 "attributes. Returns old attributes."
NSQ_SOURCE_LINE 00001888 ""
NSQ_SOURCE_LINE 00001889 "    my $oldAttribs = $member->unixFileAttributes( 0666 );"
NSQ_SOURCE_LINE 00001890 ""
NSQ_SOURCE_LINE 00001891 "Note that the return value has more than just the file"
NSQ_SOURCE_LINE 00001892 "permissions, so you will have to mask off the lowest bits for"
NSQ_SOURCE_LINE 00001893 "comparisons."
NSQ_SOURCE_LINE 00001894 ""
NSQ_SOURCE_LINE 00001895 "=item localExtraField( [ $newField ] )"
NSQ_SOURCE_LINE 00001896 ""
NSQ_SOURCE_LINE 00001897 "=item localExtraField( [ { field => $newField } ] )"
NSQ_SOURCE_LINE 00001898 ""
NSQ_SOURCE_LINE 00001899 "Gets or sets the extra field that was read from the local"
NSQ_SOURCE_LINE 00001900 "header. The extra field must be in the proper format.  If it is"
NSQ_SOURCE_LINE 00001901 "not or if the new field contains data related to the zip64"
NSQ_SOURCE_LINE 00001902 "format, this method does not modify the extra field and returns"
NSQ_SOURCE_LINE 00001903 "AZ_FORMAT_ERROR, otherwise it returns AZ_OK."
NSQ_SOURCE_LINE 00001904 ""
NSQ_SOURCE_LINE 00001905 "=item cdExtraField( [ $newField ] )"
NSQ_SOURCE_LINE 00001906 ""
NSQ_SOURCE_LINE 00001907 "=item cdExtraField( [ { field => $newField } ] )"
NSQ_SOURCE_LINE 00001908 ""
NSQ_SOURCE_LINE 00001909 "Gets or sets the extra field that was read from the central"
NSQ_SOURCE_LINE 00001910 "directory header. The extra field must be in the proper format."
NSQ_SOURCE_LINE 00001911 "If it is not or if the new field contains data related to the"
NSQ_SOURCE_LINE 00001912 "zip64 format, this method does not modify the extra field and"
NSQ_SOURCE_LINE 00001913 "returns AZ_FORMAT_ERROR, otherwise it returns AZ_OK."
NSQ_SOURCE_LINE 00001914 ""
NSQ_SOURCE_LINE 00001915 "=item extraFields()"
NSQ_SOURCE_LINE 00001916 ""
NSQ_SOURCE_LINE 00001917 "Return both local and CD extra fields, concatenated."
NSQ_SOURCE_LINE 00001918 ""
NSQ_SOURCE_LINE 00001919 "=item fileComment( [ $newComment ] )"
NSQ_SOURCE_LINE 00001920 ""
NSQ_SOURCE_LINE 00001921 "=item fileComment( [ { comment => $newComment } ] )"
NSQ_SOURCE_LINE 00001922 ""
NSQ_SOURCE_LINE 00001923 "Get or set the member's file comment."
NSQ_SOURCE_LINE 00001924 ""
NSQ_SOURCE_LINE 00001925 "=item hasDataDescriptor()"
NSQ_SOURCE_LINE 00001926 ""
NSQ_SOURCE_LINE 00001927 "Get or set the data descriptor flag. If this is set, the"
NSQ_SOURCE_LINE 00001928 "local header will not necessarily have the correct data"
NSQ_SOURCE_LINE 00001929 "sizes. Instead, a small structure will be stored at the end"
NSQ_SOURCE_LINE 00001930 "of the member data with these values. This should be"
NSQ_SOURCE_LINE 00001931 "transparent in normal operation."
NSQ_SOURCE_LINE 00001932 ""
NSQ_SOURCE_LINE 00001933 "=item crc32()"
NSQ_SOURCE_LINE 00001934 ""
NSQ_SOURCE_LINE 00001935 "Return the CRC-32 value for this member. This will not be set"
NSQ_SOURCE_LINE 00001936 "for members that were constructed from strings or external"
NSQ_SOURCE_LINE 00001937 "files until after the member has been written."
NSQ_SOURCE_LINE 00001938 ""
NSQ_SOURCE_LINE 00001939 "=item crc32String()"
NSQ_SOURCE_LINE 00001940 ""
NSQ_SOURCE_LINE 00001941 "Return the CRC-32 value for this member as an 8 character"
NSQ_SOURCE_LINE 00001942 "printable hex string. This will not be set for members that"
NSQ_SOURCE_LINE 00001943 "were constructed from strings or external files until after"
NSQ_SOURCE_LINE 00001944 "the member has been written."
NSQ_SOURCE_LINE 00001945 ""
NSQ_SOURCE_LINE 00001946 "=item compressedSize()"
NSQ_SOURCE_LINE 00001947 ""
NSQ_SOURCE_LINE 00001948 "Return the compressed size for this member. This will not be"
NSQ_SOURCE_LINE 00001949 "set for members that were constructed from strings or"
NSQ_SOURCE_LINE 00001950 "external files until after the member has been written."
NSQ_SOURCE_LINE 00001951 ""
NSQ_SOURCE_LINE 00001952 "=item uncompressedSize()"
NSQ_SOURCE_LINE 00001953 ""
NSQ_SOURCE_LINE 00001954 "Return the uncompressed size for this member."
NSQ_SOURCE_LINE 00001955 ""
NSQ_SOURCE_LINE 00001956 "=item password( [ $password ] )"
NSQ_SOURCE_LINE 00001957 ""
NSQ_SOURCE_LINE 00001958 "Returns the password for this member to be used on decryption."
NSQ_SOURCE_LINE 00001959 "If $password is given, it will set the password for the decryption."
NSQ_SOURCE_LINE 00001960 ""
NSQ_SOURCE_LINE 00001961 "=item isEncrypted()"
NSQ_SOURCE_LINE 00001962 ""
NSQ_SOURCE_LINE 00001963 "Return true if this member is encrypted. The Archive::Zip"
NSQ_SOURCE_LINE 00001964 "module does not currently support creation of encrypted"
NSQ_SOURCE_LINE 00001965 "members. Decryption works more or less like this:"
NSQ_SOURCE_LINE 00001966 ""
NSQ_SOURCE_LINE 00001967 "  my $zip = Archive::Zip->new;"
NSQ_SOURCE_LINE 00001968 "  $zip->read (\"encrypted.zip\");"
NSQ_SOURCE_LINE 00001969 "  for my $m (map { $zip->memberNamed ($_) } $zip->memberNames) {"
NSQ_SOURCE_LINE 00001970 "      $m->password (\"secret\");"
NSQ_SOURCE_LINE 00001971 "      $m->contents;  # is \"\" when password was wrong"
NSQ_SOURCE_LINE 00001972 ""
NSQ_SOURCE_LINE 00001973 "That shows that the password has to be set per member, and not per"
NSQ_SOURCE_LINE 00001974 "archive. This might change in the future."
NSQ_SOURCE_LINE 00001975 ""
NSQ_SOURCE_LINE 00001976 "=item isTextFile( [ $flag ] )"
NSQ_SOURCE_LINE 00001977 ""
NSQ_SOURCE_LINE 00001978 "=item isTextFile( [ { flag => $flag } ] )"
NSQ_SOURCE_LINE 00001979 ""
NSQ_SOURCE_LINE 00001980 "Returns true if I am a text file. Also can set the status if"
NSQ_SOURCE_LINE 00001981 "given an argument (then returns old state). Note that this"
NSQ_SOURCE_LINE 00001982 "module does not currently do anything with this flag upon"
NSQ_SOURCE_LINE 00001983 "extraction or storage. That is, bytes are stored in native"
NSQ_SOURCE_LINE 00001984 "format whether or not they came from a text file."
NSQ_SOURCE_LINE 00001985 ""
NSQ_SOURCE_LINE 00001986 "=item isBinaryFile()"
NSQ_SOURCE_LINE 00001987 ""
NSQ_SOURCE_LINE 00001988 "Returns true if I am a binary file. Also can set the status"
NSQ_SOURCE_LINE 00001989 "if given an argument (then returns old state). Note that this"
NSQ_SOURCE_LINE 00001990 "module does not currently do anything with this flag upon"
NSQ_SOURCE_LINE 00001991 "extraction or storage. That is, bytes are stored in native"
NSQ_SOURCE_LINE 00001992 "format whether or not they came from a text file."
NSQ_SOURCE_LINE 00001993 ""
NSQ_SOURCE_LINE 00001994 "=item extractToFileNamed( $fileName )"
NSQ_SOURCE_LINE 00001995 ""
NSQ_SOURCE_LINE 00001996 "=item extractToFileNamed( { name => $fileName } )"
NSQ_SOURCE_LINE 00001997 ""
NSQ_SOURCE_LINE 00001998 "Extract me to a file with the given name. The file will be"
NSQ_SOURCE_LINE 00001999 "created with default modes. Directories will be created as"
NSQ_SOURCE_LINE 00002000 "needed."
NSQ_SOURCE_LINE 00002001 "The C<$fileName> argument should be a valid file name on your"
NSQ_SOURCE_LINE 00002002 "file system."
NSQ_SOURCE_LINE 00002003 "Returns AZ_OK on success."
NSQ_SOURCE_LINE 00002004 ""
NSQ_SOURCE_LINE 00002005 "=item isDirectory()"
NSQ_SOURCE_LINE 00002006 ""
NSQ_SOURCE_LINE 00002007 "Returns true if I am a directory."
NSQ_SOURCE_LINE 00002008 ""
NSQ_SOURCE_LINE 00002009 "=item isSymbolicLink()"
NSQ_SOURCE_LINE 00002010 ""
NSQ_SOURCE_LINE 00002011 "Returns true if I am a symbolic link."
NSQ_SOURCE_LINE 00002012 ""
NSQ_SOURCE_LINE 00002013 "=item writeLocalHeaderRelativeOffset()"
NSQ_SOURCE_LINE 00002014 ""
NSQ_SOURCE_LINE 00002015 "Returns the file offset in bytes the last time I was written."
NSQ_SOURCE_LINE 00002016 ""
NSQ_SOURCE_LINE 00002017 "=item wasWritten()"
NSQ_SOURCE_LINE 00002018 ""
NSQ_SOURCE_LINE 00002019 "Returns true if I was successfully written. Reset at the"
NSQ_SOURCE_LINE 00002020 "beginning of a write attempt."
NSQ_SOURCE_LINE 00002021 ""
NSQ_SOURCE_LINE 00002022 "=back"
NSQ_SOURCE_LINE 00002023 ""
NSQ_SOURCE_LINE 00002024 "=head2 Low-level member data reading"
NSQ_SOURCE_LINE 00002025 ""
NSQ_SOURCE_LINE 00002026 "It is possible to use lower-level routines to access member data"
NSQ_SOURCE_LINE 00002027 "streams, rather than the extract* methods and contents(). For"
NSQ_SOURCE_LINE 00002028 "instance, here is how to print the uncompressed contents of a member"
NSQ_SOURCE_LINE 00002029 "in chunks using these methods:"
NSQ_SOURCE_LINE 00002030 ""
NSQ_SOURCE_LINE 00002031 "    my ( $member, $status, $bufferRef );"
NSQ_SOURCE_LINE 00002032 "    $member = $zip->memberNamed( 'xyz.txt' );"
NSQ_SOURCE_LINE 00002033 "    $member->desiredCompressionMethod( COMPRESSION_STORED );"
NSQ_SOURCE_LINE 00002034 "    $status = $member->rewindData();"
NSQ_SOURCE_LINE 00002035 "    die \"error $status\" unless $status == AZ_OK;"
NSQ_SOURCE_LINE 00002036 "    while ( ! $member->readIsDone() )"
NSQ_SOURCE_LINE 00002037 "    {"
NSQ_SOURCE_LINE 00002038 "    ( $bufferRef, $status ) = $member->readChunk();"
NSQ_SOURCE_LINE 00002039 "    die \"error $status\""
NSQ_SOURCE_LINE 00002040 "                if $status != AZ_OK && $status != AZ_STREAM_END;"
NSQ_SOURCE_LINE 00002041 "    # do something with $bufferRef:"
NSQ_SOURCE_LINE 00002042 "    print $$bufferRef;"
NSQ_SOURCE_LINE 00002043 "    }"
NSQ_SOURCE_LINE 00002044 "    $member->endRead();"
NSQ_SOURCE_LINE 00002045 ""
NSQ_SOURCE_LINE 00002046 "=over 4"
NSQ_SOURCE_LINE 00002047 ""
NSQ_SOURCE_LINE 00002048 "=item readChunk( [ $chunkSize ] )"
NSQ_SOURCE_LINE 00002049 ""
NSQ_SOURCE_LINE 00002050 "=item readChunk( [ { chunkSize => $chunkSize } ] )"
NSQ_SOURCE_LINE 00002051 ""
NSQ_SOURCE_LINE 00002052 "This reads the next chunk of given size from the member's"
NSQ_SOURCE_LINE 00002053 "data stream and compresses or uncompresses it as necessary,"
NSQ_SOURCE_LINE 00002054 "returning a reference to the bytes read and a status. If size"
NSQ_SOURCE_LINE 00002055 "argument is not given, defaults to global set by"
NSQ_SOURCE_LINE 00002056 "Archive::Zip::setChunkSize. Status is AZ_OK on success until"
NSQ_SOURCE_LINE 00002057 "the last chunk, where it returns AZ_STREAM_END. Returns C<("
NSQ_SOURCE_LINE 00002058 "\\$bytes, $status)>."
NSQ_SOURCE_LINE 00002059 ""
NSQ_SOURCE_LINE 00002060 "    my ( $outRef, $status ) = $self->readChunk();"
NSQ_SOURCE_LINE 00002061 "    print $$outRef if $status != AZ_OK && $status != AZ_STREAM_END;"
NSQ_SOURCE_LINE 00002062 ""
NSQ_SOURCE_LINE 00002063 "=item rewindData()"
NSQ_SOURCE_LINE 00002064 ""
NSQ_SOURCE_LINE 00002065 "Rewind data and set up for reading data streams or writing"
NSQ_SOURCE_LINE 00002066 "zip files. Can take options for C<inflateInit()> or"
NSQ_SOURCE_LINE 00002067 "C<deflateInit()>, but this is not likely to be necessary."
NSQ_SOURCE_LINE 00002068 "Subclass overrides should call this method. Returns C<AZ_OK>"
NSQ_SOURCE_LINE 00002069 "on success."
NSQ_SOURCE_LINE 00002070 ""
NSQ_SOURCE_LINE 00002071 "=item endRead()"
NSQ_SOURCE_LINE 00002072 ""
NSQ_SOURCE_LINE 00002073 "Reset the read variables and free the inflater or deflater."
NSQ_SOURCE_LINE 00002074 "Must be called to close files, etc. Returns AZ_OK on success."
NSQ_SOURCE_LINE 00002075 ""
NSQ_SOURCE_LINE 00002076 "=item readIsDone()"
NSQ_SOURCE_LINE 00002077 ""
NSQ_SOURCE_LINE 00002078 "Return true if the read has run out of data or encountered an error."
NSQ_SOURCE_LINE 00002079 ""
NSQ_SOURCE_LINE 00002080 "=item contents()"
NSQ_SOURCE_LINE 00002081 ""
NSQ_SOURCE_LINE 00002082 "Return the entire uncompressed member data or undef in scalar"
NSQ_SOURCE_LINE 00002083 "context. When called in array context, returns C<( $string,"
NSQ_SOURCE_LINE 00002084 "$status )>; status will be AZ_OK on success:"
NSQ_SOURCE_LINE 00002085 ""
NSQ_SOURCE_LINE 00002086 "    my $string = $member->contents();"
NSQ_SOURCE_LINE 00002087 "    # or"
NSQ_SOURCE_LINE 00002088 "    my ( $string, $status ) = $member->contents();"
NSQ_SOURCE_LINE 00002089 "    die \"error $status\" unless $status == AZ_OK;"
NSQ_SOURCE_LINE 00002090 ""
NSQ_SOURCE_LINE 00002091 "Can also be used to set the contents of a member (this may"
NSQ_SOURCE_LINE 00002092 "change the class of the member):"
NSQ_SOURCE_LINE 00002093 ""
NSQ_SOURCE_LINE 00002094 "    $member->contents( \"this is my new contents\" );"
NSQ_SOURCE_LINE 00002095 ""
NSQ_SOURCE_LINE 00002096 "=item extractToFileHandle( $fh )"
NSQ_SOURCE_LINE 00002097 ""
NSQ_SOURCE_LINE 00002098 "=item extractToFileHandle( { fileHandle => $fh } )"
NSQ_SOURCE_LINE 00002099 ""
NSQ_SOURCE_LINE 00002100 "Extract (and uncompress, if necessary) the member's contents"
NSQ_SOURCE_LINE 00002101 "to the given file handle. Return AZ_OK on success."
NSQ_SOURCE_LINE 00002102 ""
NSQ_SOURCE_LINE 00002103 "For members representing symbolic links, pass the name of the"
NSQ_SOURCE_LINE 00002104 "symbolic link as file handle. Ensure that all directories in the"
NSQ_SOURCE_LINE 00002105 "path to the symbolic link already exist."
NSQ_SOURCE_LINE 00002106 ""
NSQ_SOURCE_LINE 00002107 "=back"
NSQ_SOURCE_LINE 00002108 ""
NSQ_SOURCE_LINE 00002109 "=head1 Archive::Zip::FileMember methods"
NSQ_SOURCE_LINE 00002110 ""
NSQ_SOURCE_LINE 00002111 "The Archive::Zip::FileMember class extends Archive::Zip::Member. It is the"
NSQ_SOURCE_LINE 00002112 "base class for both ZipFileMember and NewFileMember classes. This class adds"
NSQ_SOURCE_LINE 00002113 "an C<externalFileName> and an C<fh> member to keep track of the external"
NSQ_SOURCE_LINE 00002114 "file."
NSQ_SOURCE_LINE 00002115 ""
NSQ_SOURCE_LINE 00002116 "=over 4"
NSQ_SOURCE_LINE 00002117 ""
NSQ_SOURCE_LINE 00002118 "=item externalFileName()"
NSQ_SOURCE_LINE 00002119 ""
NSQ_SOURCE_LINE 00002120 "Return the member's external filename."
NSQ_SOURCE_LINE 00002121 ""
NSQ_SOURCE_LINE 00002122 "=item fh()"
NSQ_SOURCE_LINE 00002123 ""
NSQ_SOURCE_LINE 00002124 "Return the member's read file handle. Automatically opens file if"
NSQ_SOURCE_LINE 00002125 "necessary."
NSQ_SOURCE_LINE 00002126 ""
NSQ_SOURCE_LINE 00002127 "=back"
NSQ_SOURCE_LINE 00002128 ""
NSQ_SOURCE_LINE 00002129 "=head1 Archive::Zip::ZipFileMember methods"
NSQ_SOURCE_LINE 00002130 ""
NSQ_SOURCE_LINE 00002131 "The Archive::Zip::ZipFileMember class represents members that have been read"
NSQ_SOURCE_LINE 00002132 "from external zip files."
NSQ_SOURCE_LINE 00002133 ""
NSQ_SOURCE_LINE 00002134 "=over 4"
NSQ_SOURCE_LINE 00002135 ""
NSQ_SOURCE_LINE 00002136 "=item diskNumberStart()"
NSQ_SOURCE_LINE 00002137 ""
NSQ_SOURCE_LINE 00002138 "Returns the disk number that the member's local header resides in."
NSQ_SOURCE_LINE 00002139 "Should be 0."
NSQ_SOURCE_LINE 00002140 ""
NSQ_SOURCE_LINE 00002141 "=item localHeaderRelativeOffset()"
NSQ_SOURCE_LINE 00002142 ""
NSQ_SOURCE_LINE 00002143 "Returns the offset into the zip file where the member's local header"
NSQ_SOURCE_LINE 00002144 "is."
NSQ_SOURCE_LINE 00002145 ""
NSQ_SOURCE_LINE 00002146 "=item dataOffset()"
NSQ_SOURCE_LINE 00002147 ""
NSQ_SOURCE_LINE 00002148 "Returns the offset from the beginning of the zip file to the member's"
NSQ_SOURCE_LINE 00002149 "data."
NSQ_SOURCE_LINE 00002150 ""
NSQ_SOURCE_LINE 00002151 "=back"
NSQ_SOURCE_LINE 00002152 ""
NSQ_SOURCE_LINE 00002153 "=head1 REQUIRED MODULES"
NSQ_SOURCE_LINE 00002154 ""
NSQ_SOURCE_LINE 00002155 "L<Archive::Zip> requires several other modules:"
NSQ_SOURCE_LINE 00002156 ""
NSQ_SOURCE_LINE 00002157 "L<Carp>"
NSQ_SOURCE_LINE 00002158 ""
NSQ_SOURCE_LINE 00002159 "L<Compress::Raw::Zlib>"
NSQ_SOURCE_LINE 00002160 ""
NSQ_SOURCE_LINE 00002161 "L<Cwd>"
NSQ_SOURCE_LINE 00002162 ""
NSQ_SOURCE_LINE 00002163 "L<File::Basename>"
NSQ_SOURCE_LINE 00002164 ""
NSQ_SOURCE_LINE 00002165 "L<File::Copy>"
NSQ_SOURCE_LINE 00002166 ""
NSQ_SOURCE_LINE 00002167 "L<File::Find>"
NSQ_SOURCE_LINE 00002168 ""
NSQ_SOURCE_LINE 00002169 "L<File::Path>"
NSQ_SOURCE_LINE 00002170 ""
NSQ_SOURCE_LINE 00002171 "L<File::Spec>"
NSQ_SOURCE_LINE 00002172 ""
NSQ_SOURCE_LINE 00002173 "L<IO::File>"
NSQ_SOURCE_LINE 00002174 ""
NSQ_SOURCE_LINE 00002175 "L<IO::Seekable>"
NSQ_SOURCE_LINE 00002176 ""
NSQ_SOURCE_LINE 00002177 "L<Time::Local>"
NSQ_SOURCE_LINE 00002178 ""
NSQ_SOURCE_LINE 00002179 "=head1 BUGS AND CAVEATS"
NSQ_SOURCE_LINE 00002180 ""
NSQ_SOURCE_LINE 00002181 "=head2 When not to use Archive::Zip"
NSQ_SOURCE_LINE 00002182 ""
NSQ_SOURCE_LINE 00002183 "If you are just going to be extracting zips (and/or other archives) you"
NSQ_SOURCE_LINE 00002184 "are recommended to look at using L<Archive::Extract> instead, as it is much"
NSQ_SOURCE_LINE 00002185 "easier to use and factors out archive-specific functionality."
NSQ_SOURCE_LINE 00002186 ""
NSQ_SOURCE_LINE 00002187 "=head2 Zip64 Format Support"
NSQ_SOURCE_LINE 00002188 ""
NSQ_SOURCE_LINE 00002189 "Since version 1.66 Archive::Zip supports the so-called zip64"
NSQ_SOURCE_LINE 00002190 "format, which overcomes various limitations in the original zip"
NSQ_SOURCE_LINE 00002191 "file format.  On some Perl interpreters, however, even version"
NSQ_SOURCE_LINE 00002192 "1.66 and newer of Archive::Zip cannot support the zip64 format."
NSQ_SOURCE_LINE 00002193 "Among these are all Perl interpreters that lack 64-bit support"
NSQ_SOURCE_LINE 00002194 "and those older than version 5.10.0."
NSQ_SOURCE_LINE 00002195 ""
NSQ_SOURCE_LINE 00002196 "Constant C<ZIP64_SUPPORTED>, exported with tag L<:CONSTANTS>,"
NSQ_SOURCE_LINE 00002197 "equals true if Archive::Zip on the current Perl interpreter"
NSQ_SOURCE_LINE 00002198 "supports the zip64 format.  If it does not and you try to read or"
NSQ_SOURCE_LINE 00002199 "write an archive in zip64 format, anyway, Archive::Zip returns an"
NSQ_SOURCE_LINE 00002200 "error C<AZ_ERROR> and reports an error message along the lines of"
NSQ_SOURCE_LINE 00002201 "\"zip64 format not supported on this Perl interpreter\"."
NSQ_SOURCE_LINE 00002202 ""
NSQ_SOURCE_LINE 00002203 "=head2 C<versionMadeBy> and C<versionNeededToExtract>"
NSQ_SOURCE_LINE 00002204 ""
NSQ_SOURCE_LINE 00002205 "The zip64 format and the zip file format in general specify what"
NSQ_SOURCE_LINE 00002206 "values to use for the C<versionMadeBy> and"
NSQ_SOURCE_LINE 00002207 "C<versionNeededToExtract> fields in the local file header,"
NSQ_SOURCE_LINE 00002208 "central directory file header, and zip64 EOCD record.  In"
NSQ_SOURCE_LINE 00002209 "practice however, these fields seem to be more or less randomly"
NSQ_SOURCE_LINE 00002210 "used by various archiver implementations."
NSQ_SOURCE_LINE 00002211 ""
NSQ_SOURCE_LINE 00002212 "To achieve a compromise between backward compatibility and"
NSQ_SOURCE_LINE 00002213 "(whatever) standard compliance, Archive::Zip handles them as"
NSQ_SOURCE_LINE 00002214 "follows:"
NSQ_SOURCE_LINE 00002215 ""
NSQ_SOURCE_LINE 00002216 "=over 4"
NSQ_SOURCE_LINE 00002217 ""
NSQ_SOURCE_LINE 00002218 "=item"
NSQ_SOURCE_LINE 00002219 ""
NSQ_SOURCE_LINE 00002220 "For field C<versionMadeBy>, Archive::Zip uses default value 20"
NSQ_SOURCE_LINE 00002221 "(45 for the zip64 EOCD record) or any previously read value. It"
NSQ_SOURCE_LINE 00002222 "never changes that value when writing a header, even if it is"
NSQ_SOURCE_LINE 00002223 "written in zip64 format, or when writing the zip64 EOCD record."
NSQ_SOURCE_LINE 00002224 ""
NSQ_SOURCE_LINE 00002225 "=item"
NSQ_SOURCE_LINE 00002226 ""
NSQ_SOURCE_LINE 00002227 "Likewise for field C<versionNeededToExtract>, but here"
NSQ_SOURCE_LINE 00002228 "Archive::Zip forces a minimum value of 45 when writing a header"
NSQ_SOURCE_LINE 00002229 "in zip64 format or the zip64 EOCD record."
NSQ_SOURCE_LINE 00002230 ""
NSQ_SOURCE_LINE 00002231 "=item"
NSQ_SOURCE_LINE 00002232 ""
NSQ_SOURCE_LINE 00002233 "Finally, Archive::Zip never depends on the values of these fields"
NSQ_SOURCE_LINE 00002234 "in any way when reading an archive from a file or file handle."
NSQ_SOURCE_LINE 00002235 ""
NSQ_SOURCE_LINE 00002236 "=back"
NSQ_SOURCE_LINE 00002237 ""
NSQ_SOURCE_LINE 00002238 "=head2 Try to avoid IO::Scalar"
NSQ_SOURCE_LINE 00002239 ""
NSQ_SOURCE_LINE 00002240 "One of the most common ways to use Archive::Zip is to generate Zip files"
NSQ_SOURCE_LINE 00002241 "in-memory. Most people use L<IO::Scalar> for this purpose."
NSQ_SOURCE_LINE 00002242 ""
NSQ_SOURCE_LINE 00002243 "Unfortunately, as of 1.11 this module no longer works with L<IO::Scalar>"
NSQ_SOURCE_LINE 00002244 "as it incorrectly implements seeking."
NSQ_SOURCE_LINE 00002245 ""
NSQ_SOURCE_LINE 00002246 "Anybody using L<IO::Scalar> should consider porting to L<IO::String>,"
NSQ_SOURCE_LINE 00002247 "which is smaller, lighter, and is implemented to be perfectly compatible"
NSQ_SOURCE_LINE 00002248 "with regular seekable filehandles."
NSQ_SOURCE_LINE 00002249 ""
NSQ_SOURCE_LINE 00002250 "Support for L<IO::Scalar> most likely will B<not> be restored in the"
NSQ_SOURCE_LINE 00002251 "future, as L<IO::Scalar> itself cannot change the way it is implemented"
NSQ_SOURCE_LINE 00002252 "due to back-compatibility issues."
NSQ_SOURCE_LINE 00002253 ""
NSQ_SOURCE_LINE 00002254 "=head2 Wrong password for encrypted members"
NSQ_SOURCE_LINE 00002255 ""
NSQ_SOURCE_LINE 00002256 "When an encrypted member is read using the wrong password, you currently"
NSQ_SOURCE_LINE 00002257 "have to re-read the entire archive to try again with the correct password."
NSQ_SOURCE_LINE 00002258 ""
NSQ_SOURCE_LINE 00002259 "=head1 TO DO"
