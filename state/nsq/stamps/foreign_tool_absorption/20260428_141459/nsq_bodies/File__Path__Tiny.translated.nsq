NSQ_SOURCE_LINE 00000001 "package File::Path::Tiny;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use Cwd qw(cwd chdir);"
NSQ_SOURCE_LINE 00000006 "use Carp ();"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "$File::Path::Tiny::VERSION = \"1.0\";"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "sub mk {"
NSQ_SOURCE_LINE 00000011 "    my ( $path, $mask ) = @_;"
NSQ_SOURCE_LINE 00000012 "    return 2 if -d $path;"
NSQ_SOURCE_LINE 00000013 "    if ( -e $path ) { $! = 20; return; }"
NSQ_SOURCE_LINE 00000014 "    $mask ||= '0777';    # Perl::Critic == Integer with leading zeros at ..."
NSQ_SOURCE_LINE 00000015 "    $mask = oct($mask) if substr( $mask, 0, 1 ) eq '0';"
NSQ_SOURCE_LINE 00000016 "    require File::Spec;"
NSQ_SOURCE_LINE 00000017 "    my ( $vol, $directories ) = File::Spec->splitpath( $path, 1 );"
NSQ_SOURCE_LINE 00000018 "    my @dirs = File::Spec->splitdir($directories);"
NSQ_SOURCE_LINE 00000019 "    my @list;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "    while ( my ($_dir) = shift @dirs ) {"
NSQ_SOURCE_LINE 00000022 "        last if not defined $_dir;"
NSQ_SOURCE_LINE 00000023 "        push @list, $_dir;"
NSQ_SOURCE_LINE 00000024 "        next if ( $_dir eq '' );"
NSQ_SOURCE_LINE 00000025 "        my $progressive = File::Spec->catpath( $vol, File::Spec->catdir(@list), '' );"
NSQ_SOURCE_LINE 00000026 "        if ( !-d $progressive ) {"
NSQ_SOURCE_LINE 00000027 "            mkdir( $progressive, $mask ) or -d $progressive or return;"
NSQ_SOURCE_LINE 00000028 "        }"
NSQ_SOURCE_LINE 00000029 "    }"
NSQ_SOURCE_LINE 00000030 "    return 1 if -d $path;"
NSQ_SOURCE_LINE 00000031 "    return;"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub rm {"
NSQ_SOURCE_LINE 00000035 "    my ( $path, $fast ) = @_;"
NSQ_SOURCE_LINE 00000036 "    my ( $orig_dev, $orig_ino ) = ( lstat $path )[ 0, 1 ];"
NSQ_SOURCE_LINE 00000037 "    if ( -e _ && !-d _ ) { $! = 20; return; }"
NSQ_SOURCE_LINE 00000038 "    return 2 if !-d _;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    empty_dir( $path, $fast ) or return;"
NSQ_SOURCE_LINE 00000041 "    _bail_if_changed( $path, $orig_dev, $orig_ino );"
NSQ_SOURCE_LINE 00000042 "    rmdir($path) or !-e $path or return;"
NSQ_SOURCE_LINE 00000043 "    return 1;"
NSQ_SOURCE_LINE 00000044 "}"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "sub empty_dir {"
NSQ_SOURCE_LINE 00000047 "    my ( $path, $fast ) = @_;"
NSQ_SOURCE_LINE 00000048 "    my ( $orig_dev, $orig_ino ) = ( lstat $path )[ 0, 1 ];"
NSQ_SOURCE_LINE 00000049 "    if ( -e _ && !-d _ ) { $! = 20; return; }"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    my ( $starting_point, $starting_dev, $starting_ino );"
NSQ_SOURCE_LINE 00000052 "    if ( !$fast ) {"
NSQ_SOURCE_LINE 00000053 "        $starting_point = cwd();"
NSQ_SOURCE_LINE 00000054 "        ( $starting_dev, $starting_ino ) = ( lstat $starting_point )[ 0, 1 ];"
NSQ_SOURCE_LINE 00000055 "        chdir($path) or Carp::croak(\"Failed to change directory to “$path”: $!\");"
NSQ_SOURCE_LINE 00000056 "        $path = '.';"
NSQ_SOURCE_LINE 00000057 "        _bail_if_changed( $path, $orig_dev, $orig_ino );"
NSQ_SOURCE_LINE 00000058 "    }"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    opendir( my $dh, $path ) or return;"
NSQ_SOURCE_LINE 00000061 "    my @contents = grep { $_ ne '.' && $_ ne '..' } readdir($dh);"
NSQ_SOURCE_LINE 00000062 "    closedir $dh;"
NSQ_SOURCE_LINE 00000063 "    _bail_if_changed( $path, $orig_dev, $orig_ino );"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    require File::Spec if @contents;"
NSQ_SOURCE_LINE 00000066 "    for my $thing (@contents) {"
NSQ_SOURCE_LINE 00000067 "        my $long = File::Spec->catdir( $path, $thing );"
NSQ_SOURCE_LINE 00000068 "        if ( !-l $long && -d _ ) {"
NSQ_SOURCE_LINE 00000069 "            _bail_if_changed( $path, $orig_dev, $orig_ino );"
NSQ_SOURCE_LINE 00000070 "            rm( $long, $fast ) or !-e $long or return;"
NSQ_SOURCE_LINE 00000071 "        }"
NSQ_SOURCE_LINE 00000072 "        else {"
NSQ_SOURCE_LINE 00000073 "            _bail_if_changed( $path, $orig_dev, $orig_ino );"
NSQ_SOURCE_LINE 00000074 "            unlink $long or !-e $long or return;"
NSQ_SOURCE_LINE 00000075 "        }"
NSQ_SOURCE_LINE 00000076 "    }"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "    _bail_if_changed( $path, $orig_dev, $orig_ino );"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "    if ( !$fast ) {"
NSQ_SOURCE_LINE 00000081 "        chdir($starting_point) or Carp::croak(\"Failed to change directory to “$starting_point”: $!\");"
NSQ_SOURCE_LINE 00000082 "        _bail_if_changed( \".\", $starting_dev, $starting_ino );"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    return 1;"
NSQ_SOURCE_LINE 00000086 "}"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "sub mk_parent {"
NSQ_SOURCE_LINE 00000089 "    my ( $path, $mode ) = @_;"
NSQ_SOURCE_LINE 00000090 "    $path =~ s{/+$}{};"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    require File::Spec;"
NSQ_SOURCE_LINE 00000093 "    my ( $v, $d, $f ) = File::Spec->splitpath( $path, 1 );"
NSQ_SOURCE_LINE 00000094 "    my @p = File::Spec->splitdir($d);"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    # pop() is probably cheaper here, benchmark? $d = File::Spec->catdir(@p[0--$#p-1]);"
NSQ_SOURCE_LINE 00000097 "    pop @p;"
NSQ_SOURCE_LINE 00000098 "    $d = File::Spec->catdir(@p);"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    my $parent = File::Spec->catpath( $v, $d, $f );"
NSQ_SOURCE_LINE 00000101 "    return mk( $parent, $mode );"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub _bail_if_changed {"
NSQ_SOURCE_LINE 00000105 "    my ( $path, $orig_dev, $orig_ino ) = @_;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    my ( $cur_dev, $cur_ino ) = ( lstat $path )[ 0, 1 ];"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    if ( !defined $cur_dev || !defined $cur_ino ) {"
NSQ_SOURCE_LINE 00000110 "        $cur_dev ||= \"undef(path went away?)\";"
NSQ_SOURCE_LINE 00000111 "        $cur_ino ||= \"undef(path went away?)\";"
NSQ_SOURCE_LINE 00000112 "    }"
NSQ_SOURCE_LINE 00000113 "    else {"
NSQ_SOURCE_LINE 00000114 "        $path = Cwd::abs_path($path);"
NSQ_SOURCE_LINE 00000115 "    }"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "    if ( $orig_dev ne $cur_dev || $orig_ino ne $cur_ino ) {"
NSQ_SOURCE_LINE 00000118 "        local $Carp::CarpLevel += 1;"
NSQ_SOURCE_LINE 00000119 "        Carp::croak(\"directory $path changed: expected dev=$orig_dev ino=$orig_ino, actual dev=$cur_dev ino=$cur_ino, aborting\");"
NSQ_SOURCE_LINE 00000120 "    }"
NSQ_SOURCE_LINE 00000121 "}"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "1;"
BODY_END
