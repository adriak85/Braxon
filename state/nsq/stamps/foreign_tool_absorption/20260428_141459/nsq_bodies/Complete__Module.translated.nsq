NSQ_SOURCE_LINE 00000001 "package Complete::Module;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Log::ger;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Complete::Common qw(:all);"
NSQ_SOURCE_LINE 00000009 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000010 "use List::Util qw(uniq);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000013 "our $DATE = '2023-03-19'; # DATE"
NSQ_SOURCE_LINE 00000014 "our $DIST = 'Complete-Module'; # DIST"
NSQ_SOURCE_LINE 00000015 "our $VERSION = '0.263'; # VERSION"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our %SPEC;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "our @EXPORT_OK = qw(complete_module);"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "our $OPT_SHORTCUT_PREFIXES;"
NSQ_SOURCE_LINE 00000022 "if ($ENV{COMPLETE_MODULE_OPT_SHORTCUT_PREFIXES}) {"
NSQ_SOURCE_LINE 00000023 "    $OPT_SHORTCUT_PREFIXES ="
NSQ_SOURCE_LINE 00000024 "        { split /=|;/, $ENV{COMPLETE_MODULE_OPT_SHORTCUT_PREFIXES} };"
NSQ_SOURCE_LINE 00000025 "} else {"
NSQ_SOURCE_LINE 00000026 "    $OPT_SHORTCUT_PREFIXES = {"
NSQ_SOURCE_LINE 00000027 "        #cp  => 'Catalyst/Plugin/' # candidate"
NSQ_SOURCE_LINE 00000028 "        df  => 'DateTime/Format/',"
NSQ_SOURCE_LINE 00000029 "        #dp  => 'Dancer/Plugin/', # candidate"
NSQ_SOURCE_LINE 00000030 "        #d2p  => 'Dancer2/Plugin/', # candidate"
NSQ_SOURCE_LINE 00000031 "        dz  => 'Dist/Zilla/',"
NSQ_SOURCE_LINE 00000032 "        dzb => 'Dist/Zilla/PluginBundle/',"
NSQ_SOURCE_LINE 00000033 "        dzp => 'Dist/Zilla/Plugin/',"
NSQ_SOURCE_LINE 00000034 "        dzr => 'Dist/Zilla/Role/',"
NSQ_SOURCE_LINE 00000035 "        #pa  => 'Plack/App/', # candidate"
NSQ_SOURCE_LINE 00000036 "        #pc  => 'POE/Component/', # candidate"
NSQ_SOURCE_LINE 00000037 "        #pc  => 'Perl/Critic/', # candidate?"
NSQ_SOURCE_LINE 00000038 "        #pcp => 'Perl/Critic/Policy/', # candidate?"
NSQ_SOURCE_LINE 00000039 "        #pd  => 'Padre/Document/', # candidate"
NSQ_SOURCE_LINE 00000040 "        #pm  => 'Plack/Middleware/', # candidate"
NSQ_SOURCE_LINE 00000041 "        #pp  => 'Padre/Plugin/', # candidate"
NSQ_SOURCE_LINE 00000042 "        pw  => 'Pod/Weaver/',"
NSQ_SOURCE_LINE 00000043 "        pwb => 'Pod/Weaver/PluginBundle/',"
NSQ_SOURCE_LINE 00000044 "        pwp => 'Pod/Weaver/Plugin/',"
NSQ_SOURCE_LINE 00000045 "        pwr => 'Pod/Weaver/Role/',"
NSQ_SOURCE_LINE 00000046 "        pws => 'Pod/Weaver/Section/',"
NSQ_SOURCE_LINE 00000047 "        #rtx => 'RT/Extension/', # candidate"
NSQ_SOURCE_LINE 00000048 "        #se  => 'Search/Elasticsearch/', # candidate"
NSQ_SOURCE_LINE 00000049 "        #sec => 'Search/Elasticsearch/Client/', # candidate"
NSQ_SOURCE_LINE 00000050 "        #ser => 'Search/Elasticsearch/Role/', # candidate"
NSQ_SOURCE_LINE 00000051 "        #tp  => 'Template/Plugin/', # candidate"
NSQ_SOURCE_LINE 00000052 "        #tw  => 'Tickit/Widget/', # candidate"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "        # MooseX, MooX"
NSQ_SOURCE_LINE 00000055 "        # Moose::Exception"
NSQ_SOURCE_LINE 00000056 "        # Finance::Bank"
NSQ_SOURCE_LINE 00000057 "        # Mojo::*, MojoX::*, Mojolicious::*"
NSQ_SOURCE_LINE 00000058 "    };"
NSQ_SOURCE_LINE 00000059 "}"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "$SPEC{complete_module} = {"
NSQ_SOURCE_LINE 00000062 "    v => 1.1,"
NSQ_SOURCE_LINE 00000063 "    summary => 'Complete with installed Perl module names',"
NSQ_SOURCE_LINE 00000064 "    description => <<'_',"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "For each directory in `@INC` (coderefs are ignored), find Perl modules and"
NSQ_SOURCE_LINE 00000067 "module prefixes which have `word` as prefix. So for example, given `Te` as"
NSQ_SOURCE_LINE 00000068 "`word`, will return e.g. `[Template, Template::, Term::, Test, Test::, Text::]`."
NSQ_SOURCE_LINE 00000069 "Given `Text::` will return `[Text::ASCIITable, Text::Abbrev, ...]` and so on."
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "This function has a bit of overlapping functionality with <pm:Module::List>, but"
NSQ_SOURCE_LINE 00000072 "this function is geared towards shell tab completion. Compared to Module::List,"
NSQ_SOURCE_LINE 00000073 "here are some differences: 1) list modules where prefix is incomplete; 2)"
NSQ_SOURCE_LINE 00000074 "interface slightly different; 3) (currently) doesn't do recursing; 4) contains"
NSQ_SOURCE_LINE 00000075 "conveniences for completion, e.g. map casing, expand intermediate paths (see"
NSQ_SOURCE_LINE 00000076 "`Complete` for more details on those features), autoselection of path separator"
NSQ_SOURCE_LINE 00000077 "character, some shortcuts, and so on."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "_"
NSQ_SOURCE_LINE 00000080 "    args => {"
NSQ_SOURCE_LINE 00000081 "        %arg_word,"
NSQ_SOURCE_LINE 00000082 "        path_sep => {"
NSQ_SOURCE_LINE 00000083 "            summary => 'Path separator',"
NSQ_SOURCE_LINE 00000084 "            schema  => 'str*',"
NSQ_SOURCE_LINE 00000085 "            description => <<'_',"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "For convenience in shell (bash) completion, instead of defaulting to `::` all"
NSQ_SOURCE_LINE 00000088 "the time, will look at `word`. If word does not contain any `::` then will"
NSQ_SOURCE_LINE 00000089 "default to `/`. This is because `::` (contains colon) is rather problematic as"
NSQ_SOURCE_LINE 00000090 "it is by default a word-break character in bash and the word needs to be quoted"
NSQ_SOURCE_LINE 00000091 "to avoid word-breaking by bash."
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "_"
NSQ_SOURCE_LINE 00000094 "        },"
NSQ_SOURCE_LINE 00000095 "        find_pm => {"
NSQ_SOURCE_LINE 00000096 "            summary => 'Whether to find .pm files',"
NSQ_SOURCE_LINE 00000097 "            schema  => 'bool*',"
NSQ_SOURCE_LINE 00000098 "            default => 1,"
NSQ_SOURCE_LINE 00000099 "        },"
NSQ_SOURCE_LINE 00000100 "        find_pod => {"
NSQ_SOURCE_LINE 00000101 "            summary => 'Whether to find .pod files',"
NSQ_SOURCE_LINE 00000102 "            schema  => 'bool*',"
NSQ_SOURCE_LINE 00000103 "            default => 1,"
NSQ_SOURCE_LINE 00000104 "        },"
NSQ_SOURCE_LINE 00000105 "        find_pmc => {"
NSQ_SOURCE_LINE 00000106 "            summary => 'Whether to find .pmc files',"
NSQ_SOURCE_LINE 00000107 "            schema  => 'bool*',"
NSQ_SOURCE_LINE 00000108 "            default => 1,"
NSQ_SOURCE_LINE 00000109 "        },"
NSQ_SOURCE_LINE 00000110 "        find_prefix => {"
NSQ_SOURCE_LINE 00000111 "            summary => 'Whether to find module prefixes',"
NSQ_SOURCE_LINE 00000112 "            schema  => 'bool*',"
NSQ_SOURCE_LINE 00000113 "            default => 1,"
NSQ_SOURCE_LINE 00000114 "        },"
NSQ_SOURCE_LINE 00000115 "        ns_prefix => {"
NSQ_SOURCE_LINE 00000116 "            summary => 'Namespace prefix',"
NSQ_SOURCE_LINE 00000117 "            schema  => 'perl::modname*',"
NSQ_SOURCE_LINE 00000118 "            description => <<'_',"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "This is useful if you want to complete module under a specific namespace"
NSQ_SOURCE_LINE 00000121 "(instead of the root). For example, if you set `ns_prefix` to"
NSQ_SOURCE_LINE 00000122 "`Dist::Zilla::Plugin` (or `Dist::Zilla::Plugin::`) and word is `F`, you can get"
NSQ_SOURCE_LINE 00000123 "`['FakeRelease', 'FileFinder::', 'FinderCode']` (those are modules under the"
NSQ_SOURCE_LINE 00000124 "`Dist::Zilla::Plugin::` namespace)."
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "_"
NSQ_SOURCE_LINE 00000127 "        },"
NSQ_SOURCE_LINE 00000128 "        ns_prefixes => {"
NSQ_SOURCE_LINE 00000129 "            summary => 'Namespace prefixes',"
NSQ_SOURCE_LINE 00000130 "            schema => ['array*', of=>'perl::modname*'],"
NSQ_SOURCE_LINE 00000131 "            description => <<'_',"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "If you specify this instead of `ns_prefix`, then the routine will search from"
NSQ_SOURCE_LINE 00000134 "all the prefixes instead of just one."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "_"
NSQ_SOURCE_LINE 00000137 "        },"
NSQ_SOURCE_LINE 00000138 "        recurse => {"
NSQ_SOURCE_LINE 00000139 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000140 "            cmdline_aliases => {r=>{}},"
NSQ_SOURCE_LINE 00000141 "        },"
NSQ_SOURCE_LINE 00000142 "        recurse_matching => {"
NSQ_SOURCE_LINE 00000143 "            schema => ['str*', in=>['level-by-level', 'all-at-once']],"
NSQ_SOURCE_LINE 00000144 "            default => 'level-by-level',"
NSQ_SOURCE_LINE 00000145 "        },"
NSQ_SOURCE_LINE 00000146 "        exclude_leaf => {"
NSQ_SOURCE_LINE 00000147 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000148 "        },"
NSQ_SOURCE_LINE 00000149 "        exclude_dir => {"
NSQ_SOURCE_LINE 00000150 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000151 "        },"
NSQ_SOURCE_LINE 00000152 "    },"
NSQ_SOURCE_LINE 00000153 "    args_rels => {"
NSQ_SOURCE_LINE 00000154 "        choose_one => [qw/ns_prefix ns_prefixes/],"
NSQ_SOURCE_LINE 00000155 "    },"
NSQ_SOURCE_LINE 00000156 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000157 "};"
NSQ_SOURCE_LINE 00000158 "sub complete_module {"
NSQ_SOURCE_LINE 00000159 "    require Complete::Path;"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    my %args = @_;"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    my $word = $args{word} // '';"
NSQ_SOURCE_LINE 00000164 "    #log_trace('[compmod] Entering complete_module(), word=<%s>', $word);"
NSQ_SOURCE_LINE 00000165 "    #log_trace('[compmod] args=%s', \\%args);"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    # convenience: allow Foo/Bar.{pm,pod,pmc}"
NSQ_SOURCE_LINE 00000168 "    $word =~ s/\\.(pm|pmc|pod)\\z//;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    # convenience (and compromise): if word doesn't contain :: we use the"
NSQ_SOURCE_LINE 00000171 "    # \"safer\" separator /, but if already contains '::' we use '::'. (Can also"
NSQ_SOURCE_LINE 00000172 "    # use '.' if user uses that.) Using \"::\" in bash means user needs to use"
NSQ_SOURCE_LINE 00000173 "    # quote (' or \") to make completion behave as expected since : is by default"
NSQ_SOURCE_LINE 00000174 "    # a word break character in bash/readline."
NSQ_SOURCE_LINE 00000175 "    my $sep = $args{path_sep};"
NSQ_SOURCE_LINE 00000176 "    unless (defined $sep) {"
NSQ_SOURCE_LINE 00000177 "        $sep = $word =~ /::/ ? '::' :"
NSQ_SOURCE_LINE 00000178 "            $word =~ /\\./ ? '.' : '/';"
NSQ_SOURCE_LINE 00000179 "    }"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "    # find shortcut prefixes"
NSQ_SOURCE_LINE 00000182 "    {"
NSQ_SOURCE_LINE 00000183 "        my $tmp = lc $word;"
NSQ_SOURCE_LINE 00000184 "        for (keys %$OPT_SHORTCUT_PREFIXES) {"
NSQ_SOURCE_LINE 00000185 "            if ($tmp =~ /\\A\\Q$_\\E(?:(\\Q$sep\\E).*|\\z)/) {"
NSQ_SOURCE_LINE 00000186 "                substr($word, 0, length($_) + length($1 // '')) ="
NSQ_SOURCE_LINE 00000187 "                    $OPT_SHORTCUT_PREFIXES->{$_};"
NSQ_SOURCE_LINE 00000188 "                last;"
NSQ_SOURCE_LINE 00000189 "            }"
NSQ_SOURCE_LINE 00000190 "        }"
NSQ_SOURCE_LINE 00000191 "    }"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    $word =~ s!(::|/|\\.)!::!g;"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    my $find_pm      = $args{find_pm}     // 1;"
NSQ_SOURCE_LINE 00000196 "    my $find_pmc     = $args{find_pmc}    // 1;"
NSQ_SOURCE_LINE 00000197 "    my $find_pod     = $args{find_pod}    // 1;"
NSQ_SOURCE_LINE 00000198 "    my $find_prefix  = $args{find_prefix} // 1;"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    my @ns_prefixes  = $args{ns_prefixes} ? @{$args{ns_prefixes}} : ($args{ns_prefix});"
NSQ_SOURCE_LINE 00000201 "    my $res = [];"
NSQ_SOURCE_LINE 00000202 "    for my $ns_prefix (@ns_prefixes) {"
NSQ_SOURCE_LINE 00000203 "        $ns_prefix //= '';"
NSQ_SOURCE_LINE 00000204 "        $ns_prefix =~ s/(::)+\\z//;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "        #log_trace('[compmod] invoking complete_path, word=<%s>', $word);"
NSQ_SOURCE_LINE 00000207 "        my $cp_res = Complete::Path::complete_path("
NSQ_SOURCE_LINE 00000208 "            word => $word,"
NSQ_SOURCE_LINE 00000209 "            starting_path => $ns_prefix,"
NSQ_SOURCE_LINE 00000210 "            list_func => sub {"
NSQ_SOURCE_LINE 00000211 "                my ($path, $intdir, $isint) = @_;"
NSQ_SOURCE_LINE 00000212 "                (my $fspath = $path) =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000213 "                my @res;"
NSQ_SOURCE_LINE 00000214 "                for my $inc (@INC) {"
NSQ_SOURCE_LINE 00000215 "                    next if ref($inc);"
NSQ_SOURCE_LINE 00000216 "                    my $dir = $inc . (length($fspath) ? \"/$fspath\" : \"\");"
NSQ_SOURCE_LINE 00000217 "                    opendir my($dh), $dir or next;"
NSQ_SOURCE_LINE 00000218 "                    for (readdir $dh) {"
NSQ_SOURCE_LINE 00000219 "                        next if $_ eq '.' || $_ eq '..';"
NSQ_SOURCE_LINE 00000220 "                        next unless /\\A\\w+(\\.\\w+)?\\z/;"
NSQ_SOURCE_LINE 00000221 "                        my $is_dir = (-d \"$dir/$_\");"
NSQ_SOURCE_LINE 00000222 "                        next if $isint && !$is_dir;"
NSQ_SOURCE_LINE 00000223 "                        push @res, \"$_\\::\" if $is_dir && ($isint || $find_prefix);"
NSQ_SOURCE_LINE 00000224 "                        push @res, $1 if /(.+)\\.pm\\z/  && $find_pm;"
NSQ_SOURCE_LINE 00000225 "                        push @res, $1 if /(.+)\\.pmc\\z/ && $find_pmc;"
NSQ_SOURCE_LINE 00000226 "                        push @res, $1 if /(.+)\\.pod\\z/ && $find_pod;"
NSQ_SOURCE_LINE 00000227 "                    }"
NSQ_SOURCE_LINE 00000228 "                }"
NSQ_SOURCE_LINE 00000229 "                [sort(uniq(@res))];"
NSQ_SOURCE_LINE 00000230 "            },"
NSQ_SOURCE_LINE 00000231 "            path_sep => '::',"
NSQ_SOURCE_LINE 00000232 "            is_dir_func => sub { }, # not needed, we already suffix \"dirs\" with ::"
NSQ_SOURCE_LINE 00000233 "            recurse => $args{recurse},"
NSQ_SOURCE_LINE 00000234 "            recurse_matching => $args{recurse_matching},"
NSQ_SOURCE_LINE 00000235 "            exclude_leaf => $args{exclude_leaf},"
NSQ_SOURCE_LINE 00000236 "            exclude_dir  => $args{exclude_dir},"
NSQ_SOURCE_LINE 00000237 "        );"
NSQ_SOURCE_LINE 00000238 "        push @$res, @$cp_res;"
NSQ_SOURCE_LINE 00000239 "    } # for $ns_prefix"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    # dedup"
NSQ_SOURCE_LINE 00000242 "    {"
NSQ_SOURCE_LINE 00000243 "        last unless @ns_prefixes > 1;"
NSQ_SOURCE_LINE 00000244 "        my $res_dedup = [];"
NSQ_SOURCE_LINE 00000245 "        my %seen;"
NSQ_SOURCE_LINE 00000246 "        for (@$res) { push @$res_dedup, $_ unless $seen{$_}++ }"
NSQ_SOURCE_LINE 00000247 "        $res = $res_dedup;"
NSQ_SOURCE_LINE 00000248 "    }"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "  FILTER_WITH_SCHEMA: {"
NSQ_SOURCE_LINE 00000251 "        my $sch = $args{_schema};"
NSQ_SOURCE_LINE 00000252 "        last unless $sch;"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "        my $fres = [];"
NSQ_SOURCE_LINE 00000255 "        for my $word (@$res) {"
NSQ_SOURCE_LINE 00000256 "            log_trace(\"[compmod] Validating word %s with validator ...\", $word);"
NSQ_SOURCE_LINE 00000257 "            if ($sch->[1]{in} && !(grep { index($_, $word)==0 } @{ $sch->[1]{in} })) {"
NSQ_SOURCE_LINE 00000258 "                next;"
NSQ_SOURCE_LINE 00000259 "            }"
NSQ_SOURCE_LINE 00000260 "            push @$fres, $word;"
NSQ_SOURCE_LINE 00000261 "        }"
NSQ_SOURCE_LINE 00000262 "        $res = $fres;"
NSQ_SOURCE_LINE 00000263 "    }"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "    for (@$res) { s/::/$sep/g }"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "    $res = { words=>$res, path_sep=>$sep };"
NSQ_SOURCE_LINE 00000268 "    #log_trace('[compmod] Leaving complete_module(), result=<%s>', $res);"
NSQ_SOURCE_LINE 00000269 "    $res;"
NSQ_SOURCE_LINE 00000270 "}"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "1;"
NSQ_SOURCE_LINE 00000273 "# ABSTRACT: Complete with installed Perl module names"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "__END__"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=pod"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=head1 NAME"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "Complete::Module - Complete with installed Perl module names"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "=head1 VERSION"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "This document describes version 0.263 of Complete::Module (from Perl distribution Complete-Module), released on 2023-03-19."
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 " use Complete::Module qw(complete_module);"
NSQ_SOURCE_LINE 00000292 " my $res = complete_module(word => 'Text::A');"
NSQ_SOURCE_LINE 00000293 " # -> ['Text::ANSI', 'Text::ANSITable', 'Text::ANSITable::', 'Text::Abbrev']"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=head1 SETTINGS"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=head2 C<$Complete::Module::OPT_SHORTCUT_PREFIXES> => hash"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "Shortcut prefixes. The default is:"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 " {"
NSQ_SOURCE_LINE 00000302 "   bs  => \"Bencher/Scenario/\","
NSQ_SOURCE_LINE 00000303 "   bss => \"Bencher/Scenarios/\","
NSQ_SOURCE_LINE 00000304 "   df  => \"DateTime/Format/\","
NSQ_SOURCE_LINE 00000305 "   dz  => \"Dist/Zilla/\","
NSQ_SOURCE_LINE 00000306 "   dzb => \"Dist/Zilla/PluginBundle/\","
NSQ_SOURCE_LINE 00000307 "   dzp => \"Dist/Zilla/Plugin/\","
NSQ_SOURCE_LINE 00000308 "   dzr => \"Dist/Zilla/Role/\","
NSQ_SOURCE_LINE 00000309 "   pw  => \"Pod/Weaver/\","
NSQ_SOURCE_LINE 00000310 "   pwb => \"Pod/Weaver/PluginBundle/\","
NSQ_SOURCE_LINE 00000311 "   pwp => \"Pod/Weaver/Plugin/\","
NSQ_SOURCE_LINE 00000312 "   pwr => \"Pod/Weaver/Role/\","
NSQ_SOURCE_LINE 00000313 "   pws => \"Pod/Weaver/Section/\","
NSQ_SOURCE_LINE 00000314 "   rp  => \"Regexp/Pattern/\","
NSQ_SOURCE_LINE 00000315 "   ss  => \"Sah/Schema/\","
NSQ_SOURCE_LINE 00000316 "   sss => \"Sah/Schemas/\","
NSQ_SOURCE_LINE 00000317 " }"
NSQ_SOURCE_LINE 00000318 "If user types one of the keys, it will be replaced with the matching value from"
NSQ_SOURCE_LINE 00000319 "this hash."
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=head2 complete_module"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "Usage:"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 " complete_module(%args) -> any"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "Complete with installed Perl module names."
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "For each directory in C<@INC> (coderefs are ignored), find Perl modules and"
NSQ_SOURCE_LINE 00000333 "module prefixes which have C<word> as prefix. So for example, given C<Te> as"
NSQ_SOURCE_LINE 00000334 "C<word>, will return e.g. C<[Template, Template::, Term::, Test, Test::, Text::]>."
NSQ_SOURCE_LINE 00000335 "Given C<Text::> will return C<[Text::ASCIITable, Text::Abbrev, ...]> and so on."
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "This function has a bit of overlapping functionality with L<Module::List>, but"
NSQ_SOURCE_LINE 00000338 "this function is geared towards shell tab completion. Compared to Module::List,"
NSQ_SOURCE_LINE 00000339 "here are some differences: 1) list modules where prefix is incomplete; 2)"
NSQ_SOURCE_LINE 00000340 "interface slightly different; 3) (currently) doesn't do recursing; 4) contains"
NSQ_SOURCE_LINE 00000341 "conveniences for completion, e.g. map casing, expand intermediate paths (see"
NSQ_SOURCE_LINE 00000342 "C<Complete> for more details on those features), autoselection of path separator"
NSQ_SOURCE_LINE 00000343 "character, some shortcuts, and so on."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "=over 4"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=item * B<exclude_dir> => I<bool>"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "(No description)"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "=item * B<exclude_leaf> => I<bool>"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "(No description)"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=item * B<find_pm> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "Whether to find .pm files."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=item * B<find_pmc> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "Whether to find .pmc files."
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=item * B<find_pod> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "Whether to find .pod files."
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=item * B<find_prefix> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "Whether to find module prefixes."
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=item * B<ns_prefix> => I<perl::modname>"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "Namespace prefix."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "This is useful if you want to complete module under a specific namespace"
NSQ_SOURCE_LINE 00000380 "(instead of the root). For example, if you set C<ns_prefix> to"
NSQ_SOURCE_LINE 00000381 "C<Dist::Zilla::Plugin> (or C<Dist::Zilla::Plugin::>) and word is C<F>, you can get"
NSQ_SOURCE_LINE 00000382 "C<['FakeRelease', 'FileFinder::', 'FinderCode']> (those are modules under the"
NSQ_SOURCE_LINE 00000383 "C<Dist::Zilla::Plugin::> namespace)."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=item * B<ns_prefixes> => I<array[perl::modname]>"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "Namespace prefixes."
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "If you specify this instead of C<ns_prefix>, then the routine will search from"
NSQ_SOURCE_LINE 00000390 "all the prefixes instead of just one."
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "=item * B<path_sep> => I<str>"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "Path separator."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "For convenience in shell (bash) completion, instead of defaulting to C<::> all"
NSQ_SOURCE_LINE 00000397 "the time, will look at C<word>. If word does not contain any C<::> then will"
NSQ_SOURCE_LINE 00000398 "default to C</>. This is because C<::> (contains colon) is rather problematic as"
NSQ_SOURCE_LINE 00000399 "it is by default a word-break character in bash and the word needs to be quoted"
NSQ_SOURCE_LINE 00000400 "to avoid word-breaking by bash."
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "=item * B<recurse> => I<bool>"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "(No description)"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "=item * B<recurse_matching> => I<str> (default: \"level-by-level\")"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "(No description)"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "=item * B<word>* => I<str> (default: \"\")"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "Word to complete."
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "=back"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "Return value:  (any)"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "=head2 C<COMPLETE_MODULE_OPT_SHORTCUT_PREFIXES> => str"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "Can be used to set the default for C<$Complete::Module::OPT_SHORTCUT_PREFIXES>."
NSQ_SOURCE_LINE 00000424 "It should be in the form of:"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 " shortcut1=Value1;shortcut2=Value2;..."
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "For example:"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 " dzp=Dist/Zilla/Plugin/;pwp=Pod/Weaver/Plugin/"
NSQ_SOURCE_LINE 00000431 ""
