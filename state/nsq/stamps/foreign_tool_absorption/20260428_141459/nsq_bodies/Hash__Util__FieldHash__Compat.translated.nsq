NSQ_SOURCE_LINE 00000001 "package Hash::Util::FieldHash::Compat; # git description: v0.10-5-g9de9e11"
NSQ_SOURCE_LINE 00000002 "# ABSTRACT: Use Hash::Util::FieldHash or ties, depending on availability"
NSQ_SOURCE_LINE 00000003 "# KEYWORDS: fields hashes fieldhash backwards compatibility backcompat tie"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.11';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use constant REAL_FIELDHASH => do { local $@; local $SIG{__DIE__}; eval { require Hash::Util::FieldHash } };"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "BEGIN {"
NSQ_SOURCE_LINE 00000013 "    if ( REAL_FIELDHASH ) {"
NSQ_SOURCE_LINE 00000014 "        require Hash::Util::FieldHash;"
NSQ_SOURCE_LINE 00000015 "        Hash::Util::FieldHash->import(\":all\");"
NSQ_SOURCE_LINE 00000016 "    } else {"
NSQ_SOURCE_LINE 00000017 "        require Hash::Util::FieldHash::Compat::Heavy;"
NSQ_SOURCE_LINE 00000018 "    }"
NSQ_SOURCE_LINE 00000019 "}"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub import {"
NSQ_SOURCE_LINE 00000022 "    if ( REAL_FIELDHASH ) {"
NSQ_SOURCE_LINE 00000023 "        my $class = \"Hash::Util::FieldHash\";"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "        shift @_;"
NSQ_SOURCE_LINE 00000026 "        unshift @_, $class;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "        goto $class->can(\"import\");"
NSQ_SOURCE_LINE 00000029 "    } else {"
NSQ_SOURCE_LINE 00000030 "        my $class = shift;"
NSQ_SOURCE_LINE 00000031 "        $class->export_to_level(1, $class, @_);"
NSQ_SOURCE_LINE 00000032 "    }"
NSQ_SOURCE_LINE 00000033 "}"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "__PACKAGE__"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "__END__"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=pod"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=head1 NAME"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "Hash::Util::FieldHash::Compat - Use Hash::Util::FieldHash or ties, depending on availability"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 VERSION"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "version 0.11"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    use Hash::Util::FieldHash::Compat;"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    # pretend you are using L<Hash::Util::FieldHash>"
NSQ_SOURCE_LINE 00000056 "    # under older perls it'll be Tie::RefHash::Weak instead (slower, but same behavior)"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "Under older perls this module provides a drop-in compatible API to"
NSQ_SOURCE_LINE 00000061 "L<Hash::Util::FieldHash> using L<perltie>. When L<Hash::Util::FieldHash> is"
NSQ_SOURCE_LINE 00000062 "available it will use that instead."
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "This way code requiring field hashes can benefit from fast, robust field hashes"
NSQ_SOURCE_LINE 00000065 "on Perl 5.10 and newer, but still run on older perls that don't ship with that"
NSQ_SOURCE_LINE 00000066 "module."
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "See L<Hash::Util::FieldHash> for all the details of the API."
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "L<Hash::Util::FieldHash>, L<Tie::RefHash>, L<Tie::RefHash::Weak>."
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "Bugs may be submitted through L<the RT bug tracker|https://rt.cpan.org/Public/Dist/Display.html?Name=Hash-Util-FieldHash-Compat>"
NSQ_SOURCE_LINE 00000077 "(or L<bug-Hash-Util-FieldHash-Compat@rt.cpan.org|mailto:bug-Hash-Util-FieldHash-Compat@rt.cpan.org>)."
NSQ_SOURCE_LINE 00000078 ""
