NSQ_SOURCE_LINE 00000001 "package Text::MicroTemplate::Extended;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use base 'Text::MicroTemplate::File';"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.17';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "sub new {"
NSQ_SOURCE_LINE 00000009 "    my $self = shift->SUPER::new(@_);"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "    $self->{template_args} ||= {};"
NSQ_SOURCE_LINE 00000012 "    $self->{extension}     ||= '.mt' unless defined $self->{extension};"
NSQ_SOURCE_LINE 00000013 "    my $m = $self->{macro} ||= {};"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "    # install default macros to support template inheritance"
NSQ_SOURCE_LINE 00000016 "    $m->{extends} = sub {"
NSQ_SOURCE_LINE 00000017 "        $self->render_context->{extends} = $_[0];"
NSQ_SOURCE_LINE 00000018 "    };"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    my $super = '';"
NSQ_SOURCE_LINE 00000021 "    $m->{super} = sub { $super };"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    $m->{block} = sub {"
NSQ_SOURCE_LINE 00000024 "        my ($name, $code) = @_;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000027 "        my $block;"
NSQ_SOURCE_LINE 00000028 "        if (defined $code) {"
NSQ_SOURCE_LINE 00000029 "            if ($self->render_context->{blocks}{$name}) {"
NSQ_SOURCE_LINE 00000030 "                unshift @{ $self->render_context->{super}{$name}}, {"
NSQ_SOURCE_LINE 00000031 "                    context_ref => ${\"$self->{package_name}::_MTREF\"},"
NSQ_SOURCE_LINE 00000032 "                    code        => ref($code) eq 'CODE' ? $code : sub { return $code },"
NSQ_SOURCE_LINE 00000033 "                };"
NSQ_SOURCE_LINE 00000034 "            }"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "            $block = $self->render_context->{blocks}{$name} ||= {"
NSQ_SOURCE_LINE 00000037 "                context_ref => ${\"$self->{package_name}::_MTREF\"},"
NSQ_SOURCE_LINE 00000038 "                code        => ref($code) eq 'CODE' ? $code : sub { return $code },"
NSQ_SOURCE_LINE 00000039 "            };"
NSQ_SOURCE_LINE 00000040 "        }"
NSQ_SOURCE_LINE 00000041 "        else {"
NSQ_SOURCE_LINE 00000042 "            $block = $self->render_context->{blocks}{$name}"
NSQ_SOURCE_LINE 00000043 "                or die qq[block \"$name\" does not define];"
NSQ_SOURCE_LINE 00000044 "        }"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "        if (!$self->render_context->{extends}) {"
NSQ_SOURCE_LINE 00000047 "            my $current_ref = ${\"$self->{package_name}::_MTREF\"};"
NSQ_SOURCE_LINE 00000048 "            my $rendered = $$current_ref || '';"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "            $super = Text::MicroTemplate::encoded_string($self->_render_block($_))"
NSQ_SOURCE_LINE 00000051 "                for (@{ $self->render_context->{super}{$name} || [] });"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "            $$current_ref = $rendered . $self->_render_block($block);"
NSQ_SOURCE_LINE 00000054 "            $super = '';"
NSQ_SOURCE_LINE 00000055 "        }"
NSQ_SOURCE_LINE 00000056 "    };"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    $m->{include} = sub {"
NSQ_SOURCE_LINE 00000059 "        $self->include_file(@_);"
NSQ_SOURCE_LINE 00000060 "    };"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    for my $name (keys %{ $self->{macro} }) {"
NSQ_SOURCE_LINE 00000063 "        unless ($name =~ /^[a-zA-Z_][a-zA-Z0-9_]*$/) {"
NSQ_SOURCE_LINE 00000064 "            die qq{Invalid macro key name: \"$name\"};"
NSQ_SOURCE_LINE 00000065 "        }"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000068 "        no warnings 'redefine';"
NSQ_SOURCE_LINE 00000069 "        my $code = $self->{macro}{$name};"
NSQ_SOURCE_LINE 00000070 "        *{ $self->package_name . \"::$name\" }"
NSQ_SOURCE_LINE 00000071 "            = ref $code eq 'CODE' ? $code : sub {$code};"
NSQ_SOURCE_LINE 00000072 "    }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    $self;"
NSQ_SOURCE_LINE 00000075 "}"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "sub template_args {"
NSQ_SOURCE_LINE 00000078 "    my $self = shift;"
NSQ_SOURCE_LINE 00000079 "    $self->{template_args} = $_[0] if @_;"
NSQ_SOURCE_LINE 00000080 "    $self->{template_args};"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "sub extension {"
NSQ_SOURCE_LINE 00000084 "    my $self = shift;"
NSQ_SOURCE_LINE 00000085 "    $self->{extension} = $_[0] if @_;"
NSQ_SOURCE_LINE 00000086 "    $self->{extension};"
NSQ_SOURCE_LINE 00000087 "}"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "{"
NSQ_SOURCE_LINE 00000090 "    no warnings 'once';"
NSQ_SOURCE_LINE 00000091 "    *render  = \\&render_file;"
NSQ_SOURCE_LINE 00000092 "    *include = \\&include_file;"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub render_file {"
NSQ_SOURCE_LINE 00000096 "    my $self     = shift;"
NSQ_SOURCE_LINE 00000097 "    my $template = shift;"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    my $context = $self->render_context || {};"
NSQ_SOURCE_LINE 00000100 "    $self->render_context($context);"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "    my $renderer = $self->build_file( $template . $self->extension );"
NSQ_SOURCE_LINE 00000103 "    my $result;"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    my $die_msg;"
NSQ_SOURCE_LINE 00000106 "    {"
NSQ_SOURCE_LINE 00000107 "        local $@;"
NSQ_SOURCE_LINE 00000108 "        eval {"
NSQ_SOURCE_LINE 00000109 "            $result = $renderer->(@_);"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "            my $tmpl = $self->{template};"
NSQ_SOURCE_LINE 00000112 "            $_->{template_ref} ||= \\$tmpl for values %{ $context->{blocks} };"
NSQ_SOURCE_LINE 00000113 "        };"
NSQ_SOURCE_LINE 00000114 "        $die_msg = $@;"
NSQ_SOURCE_LINE 00000115 "    }"
NSQ_SOURCE_LINE 00000116 "    unless ($die_msg) {"
NSQ_SOURCE_LINE 00000117 "        if (my $parent = delete $context->{extends}) {"
NSQ_SOURCE_LINE 00000118 "            $result = $self->render($parent);"
NSQ_SOURCE_LINE 00000119 "        }"
NSQ_SOURCE_LINE 00000120 "    }"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    $self->render_context(undef);"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "    die $self->_error($die_msg, 0, $context->{caller} || '')"
NSQ_SOURCE_LINE 00000125 "        if $die_msg;"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "    $result;"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "sub _render_block {"
NSQ_SOURCE_LINE 00000131 "    my ($self, $block) = @_;"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "    my $block_ref   = $block->{context_ref};"
NSQ_SOURCE_LINE 00000136 "    local ${\"$self->{package_name}::_MTEREF\"} = $block_ref;"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "    $$block_ref = '';"
NSQ_SOURCE_LINE 00000139 "    my ($result, $die_msg);"
NSQ_SOURCE_LINE 00000140 "    eval {"
NSQ_SOURCE_LINE 00000141 "        $result = $block->{code}->() || $$block_ref || '';"
NSQ_SOURCE_LINE 00000142 "    };"
NSQ_SOURCE_LINE 00000143 "    if ($@) {"
NSQ_SOURCE_LINE 00000144 "        my $context = $self->render_context;"
NSQ_SOURCE_LINE 00000145 "        local $self->{template} = ${ $block->{template_ref} };"
NSQ_SOURCE_LINE 00000146 "        die $self->_error($@, 0, $context->{caller});"
NSQ_SOURCE_LINE 00000147 "    }"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    $result;"
NSQ_SOURCE_LINE 00000150 "}"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "sub include_file {"
NSQ_SOURCE_LINE 00000153 "    my $self     = shift;"
NSQ_SOURCE_LINE 00000154 "    my $template = shift;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    my $renderer = $self->build_file( $template . $self->extension );"
NSQ_SOURCE_LINE 00000157 "    $renderer->(@_);"
NSQ_SOURCE_LINE 00000158 "}"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "sub render_context {"
NSQ_SOURCE_LINE 00000161 "    my $self = shift;"
NSQ_SOURCE_LINE 00000162 "    $self->{render_context} = $_[0] if @_;"
NSQ_SOURCE_LINE 00000163 "    $self->{render_context};"
NSQ_SOURCE_LINE 00000164 "}"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "sub build {"
NSQ_SOURCE_LINE 00000167 "    my $self = shift;"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    my $context = $self->render_context;"
NSQ_SOURCE_LINE 00000170 "    $context->{code}   = $self->code;"
NSQ_SOURCE_LINE 00000171 "    $context->{caller} = sub {"
NSQ_SOURCE_LINE 00000172 "        my $i = 0;"
NSQ_SOURCE_LINE 00000173 "        while (my @c = caller(++$i)) {"
NSQ_SOURCE_LINE 00000174 "            return \"$c[1] at line $c[2]\" if $c[0] ne __PACKAGE__;"
NSQ_SOURCE_LINE 00000175 "        }"
NSQ_SOURCE_LINE 00000176 "        '';"
NSQ_SOURCE_LINE 00000177 "    }->();"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    $context->{args} = '';"
NSQ_SOURCE_LINE 00000180 "    for my $key (keys %{ $self->template_args || {} }) {"
NSQ_SOURCE_LINE 00000181 "        unless ($key =~ /^[a-zA-Z_][a-zA-Z0-9_]*$/) {"
NSQ_SOURCE_LINE 00000182 "            die qq{Invalid template args key name: \"$key\"};"
NSQ_SOURCE_LINE 00000183 "        }"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "        if (ref($self->template_args->{$key}) eq 'CODE') {"
NSQ_SOURCE_LINE 00000186 "            $context->{args} .= qq{my \\$$key = \\$self->template_args->{$key}->();\\n};"
NSQ_SOURCE_LINE 00000187 "        }"
NSQ_SOURCE_LINE 00000188 "        else {"
NSQ_SOURCE_LINE 00000189 "            $context->{args} .= qq{my \\$$key = \\$self->template_args->{$key};\\n};"
NSQ_SOURCE_LINE 00000190 "        }"
NSQ_SOURCE_LINE 00000191 "    }"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    $context->{blocks} ||= {};"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    my $die_msg;"
NSQ_SOURCE_LINE 00000196 "    {"
NSQ_SOURCE_LINE 00000197 "        local $@;"
NSQ_SOURCE_LINE 00000198 "        if (my $builder = $self->eval_builder()) {"
NSQ_SOURCE_LINE 00000199 "            return $builder;"
NSQ_SOURCE_LINE 00000200 "        }"
NSQ_SOURCE_LINE 00000201 "        $die_msg = $self->_error($@, 0, $context->{caller});"
NSQ_SOURCE_LINE 00000202 "    }"
NSQ_SOURCE_LINE 00000203 "    die $die_msg;"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "sub eval_builder {"
NSQ_SOURCE_LINE 00000207 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "    local $SIG{__WARN__} = sub {"
NSQ_SOURCE_LINE 00000210 "        print STDERR $self->_error(shift, 0, $self->render_context->{caller});"
NSQ_SOURCE_LINE 00000211 "    };"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "    eval <<\"...\";"
NSQ_SOURCE_LINE 00000214 "package $self->{package_name};"
NSQ_SOURCE_LINE 00000215 "sub {"
NSQ_SOURCE_LINE 00000216 "    $self->{render_context}{args}"
NSQ_SOURCE_LINE 00000217 "# line 1"
NSQ_SOURCE_LINE 00000218 "    Text::MicroTemplate::encoded_string(($self->{render_context}{code})->(\\@_));"
NSQ_SOURCE_LINE 00000219 "}"
NSQ_SOURCE_LINE 00000220 "..."
NSQ_SOURCE_LINE 00000221 "}"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "1;"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "__END__"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=head1 NAME"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "Text::MicroTemplate::Extended - Extended MicroTemplate"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "    use Text::MicroTemplate::Extended;"
NSQ_SOURCE_LINE 00000234 "    "
NSQ_SOURCE_LINE 00000235 "    my $mt = Text::MicroTemplate::Extended->new("
NSQ_SOURCE_LINE 00000236 "        include_path  => ['/path/to/document_root'],"
NSQ_SOURCE_LINE 00000237 "        template_args => { c => $c, stash => $c->stash, },"
NSQ_SOURCE_LINE 00000238 "    );"
NSQ_SOURCE_LINE 00000239 "    "
NSQ_SOURCE_LINE 00000240 "    $mt->render('content'); # render file: /path/to/document_root/content.mt"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "L<Text::MicroTemplate::Extended> is an extended template engine based on L<Text::MicroTemplate::File>."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head1 EXTENDED FEATURES"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=head2 Template inheritance"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "Most notable point of this extended module is Template inheritance."
NSQ_SOURCE_LINE 00000251 "This concept is used in Python's Django framework."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "Template inheritance allows you to build a base \"skeleton\" template that contains all the common elements of your site and defines blocks that child templates can override."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "It's easiest to understand template inheritance by starting with an example:"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\""
NSQ_SOURCE_LINE 00000258 "        \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">"
NSQ_SOURCE_LINE 00000259 "    <html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\">"
NSQ_SOURCE_LINE 00000260 "    <head>"
NSQ_SOURCE_LINE 00000261 "        <link rel=\"stylesheet\" href=\"style.css\" />"
NSQ_SOURCE_LINE 00000262 "        <title><? block title => sub { ?>My amazing site<? } ?></title>"
NSQ_SOURCE_LINE 00000263 "    </head>"
NSQ_SOURCE_LINE 00000264 "    "
NSQ_SOURCE_LINE 00000265 "    <body>"
NSQ_SOURCE_LINE 00000266 "        <div id=\"sidebar\">"
NSQ_SOURCE_LINE 00000267 "            <? block sidebar => sub { ?>"
NSQ_SOURCE_LINE 00000268 "            <ul>"
NSQ_SOURCE_LINE 00000269 "                <li><a href=\"/\">Home</a></li>"
NSQ_SOURCE_LINE 00000270 "                <li><a href=\"/blog/\">Blog</a></li>"
NSQ_SOURCE_LINE 00000271 "            </ul>"
NSQ_SOURCE_LINE 00000272 "            <? } ?>"
NSQ_SOURCE_LINE 00000273 "        </div>"
NSQ_SOURCE_LINE 00000274 "    "
NSQ_SOURCE_LINE 00000275 "        <div id=\"content\">"
NSQ_SOURCE_LINE 00000276 "            <? block content => sub {} ?>"
NSQ_SOURCE_LINE 00000277 "        </div>"
NSQ_SOURCE_LINE 00000278 "    </body>"
NSQ_SOURCE_LINE 00000279 "    </html>"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "This template, which we'll call base.mt, defines a simple HTML skeleton document that you might use for a simple two-column page. It's the job of \"child\" templates to fill the empty blocks with content."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "In this example, the C<<? block ?>> tag defines three blocks that child templates can fill in. All the block tag does is to tell the template engine that a child template may override those portions of the template."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "A child template might look like this:"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    ? extends 'base'"
NSQ_SOURCE_LINE 00000288 "    "
NSQ_SOURCE_LINE 00000289 "    <? block title => sub { ?>My amazing blog<? } ?>"
NSQ_SOURCE_LINE 00000290 "    "
NSQ_SOURCE_LINE 00000291 "    ? block content => sub {"
NSQ_SOURCE_LINE 00000292 "    ? for my $entry (@$blog_entries) {"
NSQ_SOURCE_LINE 00000293 "        <h2><?= $entry->title ?></h2>"
NSQ_SOURCE_LINE 00000294 "        <p><?= $entry->body ?></p>"
NSQ_SOURCE_LINE 00000295 "    ? } # endfor"
NSQ_SOURCE_LINE 00000296 "    ? } # endblock"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "The C<<? extends ?>> tag is the key here. It tells the template engine that this template \"extends\" another template. When the template system evaluates this template, first it locates the parent -- in this case, \"base.mt\"."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "At that point, the template engine will notice the three C<<? block ?>> tags in base.mt and replace those blocks with the contents of the child template. Depending on the value of blog_entries, the output might look like:"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "    <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\""
NSQ_SOURCE_LINE 00000303 "        \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">"
NSQ_SOURCE_LINE 00000304 "    <html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\">"
NSQ_SOURCE_LINE 00000305 "    <head>"
NSQ_SOURCE_LINE 00000306 "        <link rel=\"stylesheet\" href=\"style.css\" />"
NSQ_SOURCE_LINE 00000307 "        <title>My amazing blog</title>"
NSQ_SOURCE_LINE 00000308 "    </head>"
NSQ_SOURCE_LINE 00000309 "    "
NSQ_SOURCE_LINE 00000310 "    <body>"
NSQ_SOURCE_LINE 00000311 "        <div id=\"sidebar\">"
NSQ_SOURCE_LINE 00000312 "            <ul>"
NSQ_SOURCE_LINE 00000313 "                <li><a href=\"/\">Home</a></li>"
NSQ_SOURCE_LINE 00000314 "                <li><a href=\"/blog/\">Blog</a></li>"
NSQ_SOURCE_LINE 00000315 "            </ul>"
NSQ_SOURCE_LINE 00000316 "        </div>"
NSQ_SOURCE_LINE 00000317 "    "
NSQ_SOURCE_LINE 00000318 "        <div id=\"content\">"
NSQ_SOURCE_LINE 00000319 "            <h2>Entry one</h2>"
NSQ_SOURCE_LINE 00000320 "            <p>This is my first entry.</p>"
NSQ_SOURCE_LINE 00000321 "    "
NSQ_SOURCE_LINE 00000322 "            <h2>Entry two</h2>"
NSQ_SOURCE_LINE 00000323 "            <p>This is my second entry.</p>"
NSQ_SOURCE_LINE 00000324 "        </div>"
NSQ_SOURCE_LINE 00000325 "    </body>"
NSQ_SOURCE_LINE 00000326 "    </html>"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "Note that since the child template didn't define the sidebar block, the value from the parent template is used instead. Content within a C<<? block ?>> tag in a parent template is always used as a fallback."
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "You can use as many levels of inheritance as needed. One common way of using inheritance is the following three-level approach:"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=over 4"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "=item 1."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "Create a base.mt template that holds the main look-and-feel of your site."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=item 2."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "Create a base_SECTIONNAME.mt template for each \"section\" of your site. For example, base_news.mt, base_sports.mt. These templates all extend base.mt and include section-specific styles/design."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=item 3."
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "Create individual templates for each type of page, such as a news article or blog entry. These templates extend the appropriate section template."
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "=back"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "This approach maximizes code reuse and makes it easy to add items to shared content areas, such as section-wide navigation."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "Here are some tips for working with inheritance:"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=over 4"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=item *"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "If you use C<<? extends ?>> in a template, it must be the first template tag in that template. Template inheritance won't work, otherwise."
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "=item *"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "More C<<? block ?>> tags in your base templates are better. Remember, child templates don't have to define all parent blocks, so you can fill in reasonable defaults in a number of blocks, then only define the ones you need later. It's better to have more hooks than fewer hooks."
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "=item *"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "If you find yourself duplicating content in a number of templates, it probably means you should move that content to a C<<? block ?>> in a parent template."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "=item *"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "If you need to get the content of the block from the parent template, the C<< <?= super() ?> >> variable will do the trick. This is useful if you want to add to the contents of a parent block instead of completely overriding it. Data inserted using C<< <?= super() ?> >> will not be automatically escaped, since it was already escaped, if necessary, in the parent template."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=item *"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "For extra readability, you can optionally give a name to your C<<? } # endblock ?>> tag. For example:"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "    <? block content => sub { ?>"
NSQ_SOURCE_LINE 00000375 "    ..."
NSQ_SOURCE_LINE 00000376 "    <? } # endblock content ?>"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "In larger templates, this technique helps you see which C<<? block ?>> tags are being closed."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=back"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "Finally, note that you can't define multiple C<<? block ?>> tags with the same name in the same template. This limitation exists because a block tag works in \"both\" directions. That is, a block tag doesn't just provide a hole to fill -- it also defines the content that fills the hole in the parent. If there were two similarly-named C<<? block ?>> tags in a template, that template's parent wouldn't know which one of the blocks' content to use."
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "=head2 Named template arguments"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "L<Text::MicroTemplate::Extended> has new template_args option."
NSQ_SOURCE_LINE 00000387 "Using this option, You can pass named template arguments to your tamplate like:"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "    my $mf = Text::MicroTemplate::Extended->new("
NSQ_SOURCE_LINE 00000390 "        template_args => { foo => 'bar', },"
NSQ_SOURCE_LINE 00000391 "        ..."
NSQ_SOURCE_LINE 00000392 "    );"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "Then in template:"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "    <?= $foo ?>"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "This template display 'bar'."
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "C<template_args> also supports CodeRef as its value life below:"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "    my $mf = Text::MicroTemplate::Extended->new("
NSQ_SOURCE_LINE 00000403 "        template_args => { foo => sub { $self->get_foo() } },"
NSQ_SOURCE_LINE 00000404 "        ..."
NSQ_SOURCE_LINE 00000405 "    );"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "In template, you can C<<?= $foo ?>> to show C<$foo> value. this value is set by calling C<< $self->get_foo >> in template process time."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "This feature is useful to set variable does not exists when template object is created."
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=head2 Macro"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "Similar to named arguments, but this feature install your subroutine to template instead of variables."
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "    my $mh = Text::MicroTemplate::Extended->new("
NSQ_SOURCE_LINE 00000416 "        macro => {"
NSQ_SOURCE_LINE 00000417 "            hello => sub { return 'Hello World!' },"
NSQ_SOURCE_LINE 00000418 "        },"
NSQ_SOURCE_LINE 00000419 "        ..."
NSQ_SOURCE_LINE 00000420 "    );"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "And in template:"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "    <?= hello() ?> # => 'Hello World'"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=head2 extension option"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "There is another new option 'extension'. You can specify template file extension."
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "If this option is set, you don't have to set extension with render method:"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "    $mf->render_file('template'); # render template.mt"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "Default value is '.mt'."
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "=head2 replace render method"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "For supporting template inheritance, it is no longer possible to implement original render method. Because extends function requires filename."
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "So in this module, render method acts same as render_file."
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "    $mf->render('template');"
NSQ_SOURCE_LINE 00000443 "    $mf->render_file('template');"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=head1 METHODS"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "=head2 new (%options)"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "    my $mf = Text::MicroTemplate::Extended->new("
NSQ_SOURCE_LINE 00000450 "        extension     => '.mt',"
NSQ_SOURCE_LINE 00000451 "        template_args => { c => $c, stash => $c->stash },"
NSQ_SOURCE_LINE 00000452 "    );"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "Create new L<Text::MicroTemplate::Extended> object."
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "Available options are:"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "=over 4"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "=item extension"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "Template file extension. (Default: '.mt')"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "=item template_args"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "Hash Reference of template args."
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "=item macro"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "Hash Reference of macros"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=back"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "See L<Text::MicroTemplate::File> for more options."
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "=head2 render ($template_name, @args)"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "=head2 render_file ($template_name, @args)"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "Render $template_name and return result."
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "=head2 include ($template_name, @args)"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "=head2 include_file ($template_name, @args)"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "Render $template_name and return result."
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "Difference between include and render is that render treats extends and block macros and supports template inheritance but include not."
NSQ_SOURCE_LINE 00000489 "But render method does not work in template."
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "    <?= $self->render('template') ?> # does not work!"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "Instead of above, use:"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "    <?= $self->include('template') ?>"
NSQ_SOURCE_LINE 00000496 "    "
NSQ_SOURCE_LINE 00000497 "    # or just"
NSQ_SOURCE_LINE 00000498 "    "
NSQ_SOURCE_LINE 00000499 "    <?= include('template') ?>"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=head1 INTERNAL METHODS"
NSQ_SOURCE_LINE 00000502 ""
