NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "my $pa;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub check_deps {"
NSQ_SOURCE_LINE 00000024 "    my ($val) = @_;"
NSQ_SOURCE_LINE 00000025 "    #say \"D:check: \", dump($val);"
NSQ_SOURCE_LINE 00000026 "    for my $dname (keys %$val) {"
NSQ_SOURCE_LINE 00000027 "        my $dval = $val->{$dname};"
NSQ_SOURCE_LINE 00000028 "        unless (defined &{\"checkdep_$dname\"}) {"
NSQ_SOURCE_LINE 00000029 "            # give a chance to load from a module first"
NSQ_SOURCE_LINE 00000030 "            eval { my $mod_pm = \"Perinci/Sub/Dep/$dname.pm\"; require $mod_pm };"
NSQ_SOURCE_LINE 00000031 "            return \"Unknown dependency type: $dname\""
NSQ_SOURCE_LINE 00000032 "                unless defined &{\"checkdep_$dname\"};"
NSQ_SOURCE_LINE 00000033 "        }"
NSQ_SOURCE_LINE 00000034 "        my $check = \\&{\"checkdep_$dname\"};"
NSQ_SOURCE_LINE 00000035 "        my $res = $check->($dval);"
NSQ_SOURCE_LINE 00000036 "        if ($res) {"
NSQ_SOURCE_LINE 00000037 "            $res = \"$dname: $res\";"
NSQ_SOURCE_LINE 00000038 "            return $res;"
NSQ_SOURCE_LINE 00000039 "        }"
NSQ_SOURCE_LINE 00000040 "    }"
NSQ_SOURCE_LINE 00000041 "    \"\";"
NSQ_SOURCE_LINE 00000042 "}"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "sub checkdep_all {"
NSQ_SOURCE_LINE 00000045 "    my ($val) = @_;"
NSQ_SOURCE_LINE 00000046 "    #say \"D:check_all: \", dump($val);"
NSQ_SOURCE_LINE 00000047 "    for (@$val) {"
NSQ_SOURCE_LINE 00000048 "        my $res = check_deps($_);"
NSQ_SOURCE_LINE 00000049 "        return \"Some dependencies not met: $res\" if $res;"
NSQ_SOURCE_LINE 00000050 "    }"
NSQ_SOURCE_LINE 00000051 "    \"\";"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub checkdep_any {"
NSQ_SOURCE_LINE 00000055 "    my ($val) = @_;"
NSQ_SOURCE_LINE 00000056 "    my $nfail = 0;"
NSQ_SOURCE_LINE 00000057 "    for (@$val) {"
NSQ_SOURCE_LINE 00000058 "        return \"\" unless check_deps($_);"
NSQ_SOURCE_LINE 00000059 "        $nfail++;"
NSQ_SOURCE_LINE 00000060 "    }"
NSQ_SOURCE_LINE 00000061 "    $nfail ? \"None of the dependencies are met\" : \"\";"
NSQ_SOURCE_LINE 00000062 "}"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "sub checkdep_none {"
NSQ_SOURCE_LINE 00000065 "    my ($val) = @_;"
NSQ_SOURCE_LINE 00000066 "    for (@$val) {"
NSQ_SOURCE_LINE 00000067 "        my $res = check_deps($_);"
NSQ_SOURCE_LINE 00000068 "        return \"A dependency is met when it shouldn't: $res\" unless $res;"
NSQ_SOURCE_LINE 00000069 "    }"
NSQ_SOURCE_LINE 00000070 "    \"\";"
NSQ_SOURCE_LINE 00000071 "}"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "sub checkdep_env {"
NSQ_SOURCE_LINE 00000074 "    my ($cval) = @_;"
NSQ_SOURCE_LINE 00000075 "    $ENV{$cval} ? \"\" : \"Environment variable $cval not set/true\";"
NSQ_SOURCE_LINE 00000076 "}"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "sub checkdep_code {"
NSQ_SOURCE_LINE 00000079 "    my ($cval) = @_;"
NSQ_SOURCE_LINE 00000080 "    $cval->() ? \"\" : \"code doesn't return true value\";"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "sub checkdep_prog {"
NSQ_SOURCE_LINE 00000084 "    my ($cval) = @_;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    $cval = ref $cval eq 'HASH' ? $cval : {name=>$cval};"
NSQ_SOURCE_LINE 00000087 "    my $prog_name = $cval->{name} or return \"BUG: Program name not specified in dependency\";"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    if ($prog_name =~ m!/!) {"
NSQ_SOURCE_LINE 00000090 "        return \"Program $prog_name not executable\" unless (-x $prog_name);"
NSQ_SOURCE_LINE 00000091 "    } else {"
NSQ_SOURCE_LINE 00000092 "        require File::Which;"
NSQ_SOURCE_LINE 00000093 "        return \"Program $prog_name not found in PATH (\"."
NSQ_SOURCE_LINE 00000094 "            join(\":\", File::Spec->path).\")\""
NSQ_SOURCE_LINE 00000095 "                unless File::Which::which($prog_name);"
NSQ_SOURCE_LINE 00000096 "    }"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    if (defined $cval->{min_version}) {"
NSQ_SOURCE_LINE 00000099 "        require IPC::System::Options;"
NSQ_SOURCE_LINE 00000100 "        require Version::Util;"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "        my (@ver_cmd, $ver_extract);"
NSQ_SOURCE_LINE 00000103 "        my $prog_path = $cval->{path} // $prog_name;"
NSQ_SOURCE_LINE 00000104 "        if ($prog_name eq 'git') {"
NSQ_SOURCE_LINE 00000105 "            @ver_cmd = ($prog_path, \"--version\");"
NSQ_SOURCE_LINE 00000106 "            $ver_extract = sub { $_[0] =~ /git version (.+)/ ? $1 : undef };"
NSQ_SOURCE_LINE 00000107 "        } elsif ($prog_name eq 'perl') {"
NSQ_SOURCE_LINE 00000108 "            @ver_cmd = ($prog_path, \"-v\");"
NSQ_SOURCE_LINE 00000109 "            $ver_extract = sub { $_[0] =~ /\\s\\(?v([\\.\\d]+)\\*?\\)?\\s/ ? $1 : undef };"
NSQ_SOURCE_LINE 00000110 "        } else {"
NSQ_SOURCE_LINE 00000111 "            return \"ERR: Cannot check minimum version for program '$prog_name'\";"
NSQ_SOURCE_LINE 00000112 "        }"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "        my $ver = IPC::System::Options::readpipe({log=>1, shell=>0}, @ver_cmd);"
NSQ_SOURCE_LINE 00000115 "        my ($exit_code, $signal, $core_dump) = ($? < 0 ? $? : $? >> 8, $? & 127, $? & 128);"
NSQ_SOURCE_LINE 00000116 "        return \"ERR: Cannot check version with '\".join(\" \", @ver_cmd).\"': exit_code=$exit_code\""
NSQ_SOURCE_LINE 00000117 "            if $exit_code;"
NSQ_SOURCE_LINE 00000118 "        ($ver) = $ver_extract->($ver) or return \"ERR: Cannot extract version from response '$ver'\";"
NSQ_SOURCE_LINE 00000119 "        return \"Program '$prog_name' version ($ver) is less than required ($cval->{min_version})\""
NSQ_SOURCE_LINE 00000120 "            if Version::Util::version_lt($ver, $cval->{min_version});"
NSQ_SOURCE_LINE 00000121 "    }"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "    \"\";"
NSQ_SOURCE_LINE 00000124 "}"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "sub riap_client {"
NSQ_SOURCE_LINE 00000127 "    return $pa if $pa;"
NSQ_SOURCE_LINE 00000128 "    require Perinci::Access;"
NSQ_SOURCE_LINE 00000129 "    $pa = Perinci::Access->new;"
NSQ_SOURCE_LINE 00000130 "    $pa;"
NSQ_SOURCE_LINE 00000131 "}"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "sub checkdep_pkg {"
NSQ_SOURCE_LINE 00000134 "    my ($cval) = @_;"
NSQ_SOURCE_LINE 00000135 "    my $res = riap_client->request(info => $cval);"
NSQ_SOURCE_LINE 00000136 "    $res->[0] == 200 or return \"Can't perform 'info' Riap request on '$cval': \"."
NSQ_SOURCE_LINE 00000137 "        \"$res->[0] $res->[1]\";"
NSQ_SOURCE_LINE 00000138 "    $res->[2]{type} eq 'package' or return \"$cval is not a Riap package\";"
NSQ_SOURCE_LINE 00000139 "    \"\";"
NSQ_SOURCE_LINE 00000140 "}"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "sub checkdep_func {"
NSQ_SOURCE_LINE 00000143 "    my ($cval) = @_;"
NSQ_SOURCE_LINE 00000144 "    my $res = riap_client->request(info => $cval);"
NSQ_SOURCE_LINE 00000145 "    $res->[0] == 200 or return \"Can't perform 'info' Riap request on '$cval': \"."
NSQ_SOURCE_LINE 00000146 "        \"$res->[0] $res->[1]\";"
NSQ_SOURCE_LINE 00000147 "    $res->[2]{type} eq 'function' or return \"$cval is not a Riap function\";"
NSQ_SOURCE_LINE 00000148 "    \"\";"
NSQ_SOURCE_LINE 00000149 "}"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "# for backward-compatibility"
NSQ_SOURCE_LINE 00000152 "sub checkdep_exec { checkdep_prog(@_) }"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "# we check this dep by checking arguments, so we'll let something like"
NSQ_SOURCE_LINE 00000155 "# Perinci::Sub::Wrapper to do it"
NSQ_SOURCE_LINE 00000156 "sub checkdep_tmp_dir { \"\" }"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "# we check this dep by checking arguments, so we'll let something like"
NSQ_SOURCE_LINE 00000159 "# Perinci::Sub::Wrapper to do it"
NSQ_SOURCE_LINE 00000160 "sub checkdep_trash_dir { \"\" }"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "# we check this dep by checking arguments, so we'll let something like"
NSQ_SOURCE_LINE 00000163 "# Perinci::Sub::Wrapper to do it"
NSQ_SOURCE_LINE 00000164 "sub checkdep_undo_trash_dir { \"\" }"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "sub _all_elems_is {"
NSQ_SOURCE_LINE 00000167 "    my ($ary, $el) = @_;"
NSQ_SOURCE_LINE 00000168 "    (grep {$_ eq $el} @$ary) && !(grep {$_ ne $el} @$ary);"
NSQ_SOURCE_LINE 00000169 "}"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "sub _all_nonblank_elems_is {"
NSQ_SOURCE_LINE 00000172 "    my ($ary, $el) = @_;"
NSQ_SOURCE_LINE 00000173 "    (grep {$_ eq $el} @$ary) && !(grep {$_ && $_ ne $el} @$ary);"
NSQ_SOURCE_LINE 00000174 "}"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "sub dep_satisfy_rel {"
NSQ_SOURCE_LINE 00000177 "    my ($wanted, $deps) = @_;"
NSQ_SOURCE_LINE 00000178 "    #$log->tracef(\"=> dep_satisfy_rel(%s, %s)\", $wanted, $deps);"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    my $res;"
NSQ_SOURCE_LINE 00000181 "    for my $dname (keys %$deps) {"
NSQ_SOURCE_LINE 00000182 "        my $dval = $deps->{$dname};"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "        if ($dname eq 'all') {"
NSQ_SOURCE_LINE 00000185 "            my @r = map { dep_satisfy_rel($wanted, $_) } @$dval;"
NSQ_SOURCE_LINE 00000186 "            #$log->tracef(\"all: %s\", \\@r);"
NSQ_SOURCE_LINE 00000187 "            next unless @r;"
NSQ_SOURCE_LINE 00000188 "            return \"impossible\" if grep { $_ eq \"impossible\" } @r;"
NSQ_SOURCE_LINE 00000189 "            return \"impossible\" if (grep { $_ eq \"must\" } @r) && (grep {$_ eq \"must not\"} @r);"
NSQ_SOURCE_LINE 00000190 "            return \"must\"       if grep { $_ eq \"must\" } @r;"
NSQ_SOURCE_LINE 00000191 "            return \"must not\"   if grep { $_ eq \"must not\" } @r;"
NSQ_SOURCE_LINE 00000192 "            return \"might\"      if _all_nonblank_elems_is(\\@r, \"might\");"
NSQ_SOURCE_LINE 00000193 "        } elsif ($dname eq 'any') {"
NSQ_SOURCE_LINE 00000194 "            my @r = map { dep_satisfy_rel($wanted, $_) } @$dval;"
NSQ_SOURCE_LINE 00000195 "            #$log->tracef(\"any: %s\", \\@r);"
NSQ_SOURCE_LINE 00000196 "            next unless @r;"
NSQ_SOURCE_LINE 00000197 "            return \"impossible\" if grep { $_ eq \"impossible\" } @r;"
NSQ_SOURCE_LINE 00000198 "            return \"must\"       if _all_elems_is(\\@r, \"must\");"
NSQ_SOURCE_LINE 00000199 "            return \"must not\"   if _all_elems_is(\\@r, \"must not\");"
NSQ_SOURCE_LINE 00000200 "            next                if _all_elems_is(\\@r, \"\");"
NSQ_SOURCE_LINE 00000201 "            return \"might\";"
NSQ_SOURCE_LINE 00000202 "        } elsif ($dname eq 'none') {"
NSQ_SOURCE_LINE 00000203 "            my @r = map { dep_satisfy_rel($wanted, $_) } @$dval;"
NSQ_SOURCE_LINE 00000204 "            #$log->tracef(\"none: %s\", \\@r);"
NSQ_SOURCE_LINE 00000205 "            next unless @r;"
NSQ_SOURCE_LINE 00000206 "            return \"impossible\" if grep { $_ eq \"impossible\" } @r;"
NSQ_SOURCE_LINE 00000207 "            return \"impossible\" if (grep { $_ eq \"must\" } @r) && (grep {$_ eq \"must not\"} @r);"
NSQ_SOURCE_LINE 00000208 "            return \"must not\"   if grep { $_ eq \"must\" } @r;"
NSQ_SOURCE_LINE 00000209 "            return \"must\"       if grep { $_ eq \"must not\" } @r;"
NSQ_SOURCE_LINE 00000210 "            return \"might\"      if _all_nonblank_elems_is(\\@r, \"might\");"
NSQ_SOURCE_LINE 00000211 "        } else {"
NSQ_SOURCE_LINE 00000212 "            return \"must\" if $dname eq $wanted;"
NSQ_SOURCE_LINE 00000213 "        }"
NSQ_SOURCE_LINE 00000214 "    }"
NSQ_SOURCE_LINE 00000215 "    \"\";"
NSQ_SOURCE_LINE 00000216 "}"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "sub list_mentioned_dep_clauses {"
NSQ_SOURCE_LINE 00000219 "    my ($deps, $res) = @_;"
NSQ_SOURCE_LINE 00000220 "    $res //= [];"
NSQ_SOURCE_LINE 00000221 "    for my $dname (keys %$deps) {"
NSQ_SOURCE_LINE 00000222 "        my $dval = $deps->{$dname};"
NSQ_SOURCE_LINE 00000223 "        push @$res, $dname unless grep { $_ eq $dname } @$res;"
NSQ_SOURCE_LINE 00000224 "        if ($dname =~ /\\A(?:all|any|none)\\z/) {"
NSQ_SOURCE_LINE 00000225 "            list_mentioned_dep_clauses($_, $res) for @$dval;"
NSQ_SOURCE_LINE 00000226 "        }"
NSQ_SOURCE_LINE 00000227 "    }"
NSQ_SOURCE_LINE 00000228 "    $res;"
NSQ_SOURCE_LINE 00000229 "}"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "1;"
NSQ_SOURCE_LINE 00000232 "# ABSTRACT: Check dependencies from 'deps' property"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "__END__"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=pod"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=head1 NAME"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "Perinci::Sub::DepChecker - Check dependencies from 'deps' property"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head1 VERSION"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "This document describes version 0.128 of Perinci::Sub::DepChecker (from Perl distribution Perinci-Sub-DepChecker), released on 2023-11-16."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 " use Perinci::Spec::DepChecker qw(check_deps dep_satisfy_rel list_mentioned_dep_clauses);"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 " my $err = check_deps($meta->{deps});"
NSQ_SOURCE_LINE 00000253 " print \"Dependencies not met: $err\" if $err;"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 " print \"We need to prepare foo\""
NSQ_SOURCE_LINE 00000256 "     if dep_satisfy_rel('foo', $meta->{deps}) =~ /^(?:must|might)$/;"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "The 'deps' spec clause adds information about subroutine dependencies. This"
NSQ_SOURCE_LINE 00000261 "module performs check on it."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "This module is currently mainly used by L<Perinci::Sub::Wrapper>."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=for Pod::Coverage ^(checkdep_.*|riap_client)$"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "None is exported by default, but every function is exportable."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "=head2 check_deps($deps) => ERRSTR"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "Check dependencies. Will in turn call various C<checkdep_NAME()> subroutines."
NSQ_SOURCE_LINE 00000274 "Return empty string if all dependencies are met, or a string containing an error"
NSQ_SOURCE_LINE 00000275 "message stating a dependency error."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "Example:"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 " my $err = check_deps({env=>'DEBUG'});"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "Will check environment variable C<DEBUG>. If true, will return an empty string."
NSQ_SOURCE_LINE 00000282 "Otherwise will set $err with something like C<Environment variable DEBUG not"
NSQ_SOURCE_LINE 00000283 "set/true>."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "Another example:"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 " my $err = check_deps({ all=>[{env=>\"A\"}, {env=>\"B\", prog=>\"bc\"}] });"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "The above will check environment variables C<A>, C<B>, as well as program C<bc>."
NSQ_SOURCE_LINE 00000290 "All dependencies must be met (because we use the C<and> metaclause)."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "To support a custom dependency named C<NAME>, just define C<checkdep_NAME>"
NSQ_SOURCE_LINE 00000293 "subroutine in L<Perinci::Sub::DepChecker> package which accepts a value and"
NSQ_SOURCE_LINE 00000294 "should return an empty string on success or an error message string."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=head2 dep_satisfy_rel($name, $deps) => STR"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "Check dep satisfication relationship, i.e. whether dependency named C<$name>"
NSQ_SOURCE_LINE 00000299 "must be satisfied in C<$deps>. Due to B<all>, B<any>, and B<none> clauses, this"
NSQ_SOURCE_LINE 00000300 "needs to be checked recursively and might yield an inconclusive answer"
NSQ_SOURCE_LINE 00000301 "(\"maybe\")."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "Return \"must\" if C<$name> definitely must be satisfied in C<$deps>, \"must not\""
NSQ_SOURCE_LINE 00000304 "if definitely not, \"\" if need not be satisfied (dep clause does not exist in"
NSQ_SOURCE_LINE 00000305 "deps), \"impossible\" if condition is impossible to be satisfied (due to"
NSQ_SOURCE_LINE 00000306 "conflicts), \"might\" if dep might need to be satisfied (but might also not)."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "Examples:"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 " dep_satisfy_rel('env', {env=>\"A\"})              # => \"must\""
NSQ_SOURCE_LINE 00000311 " dep_satisfy_rel('a', {all=>[{a=>1}, {b=>1}]})   # => \"must\""
NSQ_SOURCE_LINE 00000312 " dep_satisfy_rel('a', {b=>2})                    # => \"\""
NSQ_SOURCE_LINE 00000313 " dep_satisfy_rel('a', {none=>[{a=>1}, {b=>1}]})  # => \"must not\""
NSQ_SOURCE_LINE 00000314 " dep_satisfy_rel('c', {none=>[{a=>1}, {b=>1}]})  # => \"\""
NSQ_SOURCE_LINE 00000315 " dep_satisfy_rel('a', {any=>[{a=>1}, {b=>1}]})   # => \"might\""
NSQ_SOURCE_LINE 00000316 " dep_satisfy_rel('a', {all=>[{a=>1},"
NSQ_SOURCE_LINE 00000317 "                             {none=>[{a=>1}]}]}) # => \"impossible\""
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "This function is useful if we want to prepare something that \"must\" or \"might\""
NSQ_SOURCE_LINE 00000320 "be needed, or want to avoid preparing something that \"must not\" be present."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=head2 list_mentioned_dep_clauses($deps) => ARRAYREF"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "List all dep clauses mentioned in $deps. The returned array is I<not> sorted"
NSQ_SOURCE_LINE 00000325 "alphabetically, so you will have to do it yourself if you need it sorted."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "Example:"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 " list_mentioned_dep_clauses({any=>[{a=>1}, {b=>1}]}) # => [qw/any a b/]"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "Please visit the project's homepage at L<https://metacpan.org/release/Perinci-Sub-DepChecker>."
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "Source repository is at L<https://github.com/perlancar/perl-Perinci-Sub-DepChecker>."
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "L<Perinci>"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "'deps' section in L<Rinci::function>"
