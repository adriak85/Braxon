NSQ_SOURCE_LINE 00000001 "package IO::Stringy;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use Exporter;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "our $VERSION = '2.113';"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "1;"
NSQ_SOURCE_LINE 00000008 "__END__"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "=head1 NAME"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "IO-stringy - I/O on in-core objects like strings and arrays"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "    use strict;"
NSQ_SOURCE_LINE 00000017 "    use warnings;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    use IO::AtomicFile; # Write a file which is updated atomically"
NSQ_SOURCE_LINE 00000020 "    use IO::InnerFile; # define a file inside another file"
NSQ_SOURCE_LINE 00000021 "    use IO::Lines; # I/O handle to read/write to array of lines"
NSQ_SOURCE_LINE 00000022 "    use IO::Scalar; # I/O handle to read/write to a string"
NSQ_SOURCE_LINE 00000023 "    use IO::ScalarArray; # I/O handle to read/write to array of scalars"
NSQ_SOURCE_LINE 00000024 "    use IO::Wrap; # Wrap old-style FHs in standard OO interface"
NSQ_SOURCE_LINE 00000025 "    use IO::WrapTie; # Tie your handles & retain full OO interface"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    # ..."
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "This toolkit primarily provides modules for performing both traditional"
NSQ_SOURCE_LINE 00000032 "and object-oriented i/o) on things I<other> than normal filehandles;"
NSQ_SOURCE_LINE 00000033 "in particular, L<IO::Scalar|IO::Scalar>, L<IO::ScalarArray|IO::ScalarArray>,"
NSQ_SOURCE_LINE 00000034 "and L<IO::Lines|IO::Lines>."
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "In the more-traditional IO::Handle front, we"
NSQ_SOURCE_LINE 00000037 "have L<IO::AtomicFile|IO::AtomicFile>"
NSQ_SOURCE_LINE 00000038 "which may be used to painlessly create files which are updated"
NSQ_SOURCE_LINE 00000039 "atomically."
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "And in the \"this-may-prove-useful\" corner, we have L<IO::Wrap|IO::Wrap>,"
NSQ_SOURCE_LINE 00000042 "whose exported wraphandle() function will clothe anything that's not"
NSQ_SOURCE_LINE 00000043 "a blessed object in an IO::Handle-like wrapper... so you can just"
NSQ_SOURCE_LINE 00000044 "use OO syntax and stop worrying about whether your function's caller"
NSQ_SOURCE_LINE 00000045 "handed you a string, a globref, or a FileHandle."
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "Eryq (F<eryq@zeegee.com>)."
