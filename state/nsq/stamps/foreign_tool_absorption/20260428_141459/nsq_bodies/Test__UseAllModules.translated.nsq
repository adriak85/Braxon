BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Test::UseAllModules;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use ExtUtils::Manifest qw( maniread );"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.17';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Exporter;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our @ISA = qw/Exporter/;"
NSQ_SOURCE_LINE 00000012 "our @EXPORT = qw/all_uses_ok/;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "use Test::More;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "my $RULE = qr{^lib/(.+)\\.pm$};"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub import {"
NSQ_SOURCE_LINE 00000019 "  shift->export_to_level(1);"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "  shift if @_ && $_[0] eq 'under';"
NSQ_SOURCE_LINE 00000022 "  my @dirs = ('lib', @_);"
NSQ_SOURCE_LINE 00000023 "  my %seen;"
NSQ_SOURCE_LINE 00000024 "  @dirs  = grep { !$seen{$_}++ } map  { s|/+$||; $_ } @dirs;"
NSQ_SOURCE_LINE 00000025 "  $RULE = '^(?:'.(join '|', @dirs).')/(.+)\\.pm\\s*$';"
NSQ_SOURCE_LINE 00000026 "  unshift @INC, @dirs;"
NSQ_SOURCE_LINE 00000027 "}"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub _get_module_list {"
NSQ_SOURCE_LINE 00000030 "  shift if @_ && $_[0] eq 'except';"
NSQ_SOURCE_LINE 00000031 "  my @exceptions = @_;"
NSQ_SOURCE_LINE 00000032 "  my @modules;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "  my $manifest = maniread();"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "READ:"
NSQ_SOURCE_LINE 00000037 "  foreach my $file (keys %{ $manifest }) {"
NSQ_SOURCE_LINE 00000038 "    if (my ($module) = $file =~ m|$RULE|) {"
NSQ_SOURCE_LINE 00000039 "      $module =~ s|/|::|g;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "      foreach my $rule (@exceptions) {"
NSQ_SOURCE_LINE 00000042 "        next READ if $module eq $rule || $module =~ /$rule/;"
NSQ_SOURCE_LINE 00000043 "      }"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "      push @modules, $module;"
NSQ_SOURCE_LINE 00000046 "    }"
NSQ_SOURCE_LINE 00000047 "  }"
NSQ_SOURCE_LINE 00000048 "  return @modules;"
NSQ_SOURCE_LINE 00000049 "}"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "sub _planned {"
NSQ_SOURCE_LINE 00000052 "  Test::More->builder->has_plan;"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "sub all_uses_ok {"
NSQ_SOURCE_LINE 00000056 "  unless (-f 'MANIFEST') {"
NSQ_SOURCE_LINE 00000057 "    plan skip_all => 'no MANIFEST' unless _planned();"
NSQ_SOURCE_LINE 00000058 "    return;"
NSQ_SOURCE_LINE 00000059 "  }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "  my @modules = _get_module_list(@_);"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "  unless (@modules) {"
NSQ_SOURCE_LINE 00000064 "    plan skip_all => 'no .pm files are found under the lib directory' unless _planned();"
NSQ_SOURCE_LINE 00000065 "    return;"
NSQ_SOURCE_LINE 00000066 "  }"
NSQ_SOURCE_LINE 00000067 "  plan tests => scalar @modules unless _planned();"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "  my @failed;"
NSQ_SOURCE_LINE 00000070 "  foreach my $module (@modules) {"
NSQ_SOURCE_LINE 00000071 "    use_ok($module) or push @failed, $module;"
NSQ_SOURCE_LINE 00000072 "  }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "  BAIL_OUT( 'failed: ' . (join ',', @failed) ) if @failed;"
NSQ_SOURCE_LINE 00000075 "}"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "1;"
NSQ_SOURCE_LINE 00000078 "__END__"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head1 NAME"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Test::UseAllModules - do use_ok() for all the MANIFESTed modules"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "  # basic usage"
NSQ_SOURCE_LINE 00000087 "  use strict;"
NSQ_SOURCE_LINE 00000088 "  use Test::UseAllModules;"
NSQ_SOURCE_LINE 00000089 "  "
NSQ_SOURCE_LINE 00000090 "  BEGIN { all_uses_ok(); }"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "  # if you also want to test modules under t/lib"
NSQ_SOURCE_LINE 00000093 "  use strict;"
NSQ_SOURCE_LINE 00000094 "  use Test::UseAllModules under => qw(lib t/lib);"
NSQ_SOURCE_LINE 00000095 "  "
NSQ_SOURCE_LINE 00000096 "  BEGIN { all_uses_ok(); }"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "  # if you have modules that'll fail use_ok() for themselves"
NSQ_SOURCE_LINE 00000099 "  use strict;"
NSQ_SOURCE_LINE 00000100 "  use Test::UseAllModules;"
NSQ_SOURCE_LINE 00000101 "  "
NSQ_SOURCE_LINE 00000102 "  BEGIN {"
NSQ_SOURCE_LINE 00000103 "    all_uses_ok except => qw("
NSQ_SOURCE_LINE 00000104 "      Some::Dependent::Module"
NSQ_SOURCE_LINE 00000105 "      Another::Dependent::Module"
NSQ_SOURCE_LINE 00000106 "      ^Yet::Another::Dependent::.*   # you can use regex"
NSQ_SOURCE_LINE 00000107 "    )"
NSQ_SOURCE_LINE 00000108 "  }"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "I'm sick of writing 00_load.t (or something like that) that'll do use_ok() for every module I write. I'm sicker of updating 00_load.t when I add another file to the distro. This module reads MANIFEST to find modules to be tested and does use_ok() for each of them. Now all you have to do is update MANIFEST. You don't have to modify the test any more (hopefully)."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 EXPORTED FUNCTION"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=head2 all_uses_ok"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "Does Test::More's use_ok() for every module found in MANIFEST. If you have modules you don't want to test, give those modules or some regex rules as the argument. The word 'except' is ignored as shown above. "
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "As of 0.11, you can also test modules under arbitrary directories by providing a directory list at the loading time (the word 'under' is ignored as shown above). Modules under the lib directory are always tested."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head1 PROTECTED FUNCTION"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "=head2 _get_module_list"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "Returns module paths to test. This function will not be exported. If you want to use this (see below), you always need to call it by the full qualified name."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=head1 NOTES"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "As of 0.03, this module calls BAIL_OUT of Test::More if any of the use_ok tests should fail. (Thus the following tests will be ignored. Missing or unloadable modules cause a lot of errors of the same kind.)"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "As of 0.12, you can add extra tests before/after all_uses_ok() if you explicitly declare test plan like this."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "  use strict;"
NSQ_SOURCE_LINE 00000135 "  use warnings;"
NSQ_SOURCE_LINE 00000136 "  use Test::More;"
NSQ_SOURCE_LINE 00000137 "  use Test::UseAllModules;"
NSQ_SOURCE_LINE 00000138 "  use Test::NoWarnings;"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "  plan tests => Test::UseAllModules::_get_module_list() + 1;"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "  all_uses_ok();"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "  # and extra nowarnings test"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "There're several modules like this on the CPAN now. L<Test::Compile> and a bit confusing L<Test::LoadAllModules> try to find modules to test by traversing directories. I'm not a big fan of them as they tend to find temporary or unrelated modules as well, but they may be handier especially if you're too lazy to update MANIFEST every time."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "Kenichi Ishigaki, E<lt>ishigaki@cpan.orgE<gt>"
