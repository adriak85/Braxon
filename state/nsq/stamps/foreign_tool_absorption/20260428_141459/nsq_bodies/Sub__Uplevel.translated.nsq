NSQ_SOURCE_LINE 00000001 "package Sub::Uplevel;"
NSQ_SOURCE_LINE 00000002 "use 5.006;"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "# ABSTRACT: apparently run a function in a higher stack frame"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.2800';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "# Frame check global constant"
NSQ_SOURCE_LINE 00000009 "our $CHECK_FRAMES;"
NSQ_SOURCE_LINE 00000010 "BEGIN {"
NSQ_SOURCE_LINE 00000011 "  $CHECK_FRAMES = !! $CHECK_FRAMES;"
NSQ_SOURCE_LINE 00000012 "}"
NSQ_SOURCE_LINE 00000013 "use constant CHECK_FRAMES => $CHECK_FRAMES;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "# We must override *CORE::GLOBAL::caller if it hasn't already been "
NSQ_SOURCE_LINE 00000016 "# overridden or else Perl won't see our local override later."
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "if ( not defined *CORE::GLOBAL::caller{CODE} ) {"
NSQ_SOURCE_LINE 00000019 "  *CORE::GLOBAL::caller = \\&_normal_caller;"
NSQ_SOURCE_LINE 00000020 "}"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "# modules to force reload if \":aggressive\" is specified"
NSQ_SOURCE_LINE 00000023 "my @reload_list = qw/Exporter Exporter::Heavy/;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub import {"
NSQ_SOURCE_LINE 00000026 "  no strict 'refs'; ## no critic"
NSQ_SOURCE_LINE 00000027 "  my ($class, @args) = @_;"
NSQ_SOURCE_LINE 00000028 "  for my $tag ( @args, 'uplevel' ) {"
NSQ_SOURCE_LINE 00000029 "    if ( $tag eq 'uplevel' ) {"
NSQ_SOURCE_LINE 00000030 "      my $caller = caller(0);"
NSQ_SOURCE_LINE 00000031 "      *{\"$caller\\::uplevel\"} = \\&uplevel;"
NSQ_SOURCE_LINE 00000032 "    }"
NSQ_SOURCE_LINE 00000033 "    elsif( $tag eq ':aggressive' ) {"
NSQ_SOURCE_LINE 00000034 "      _force_reload( @reload_list );"
NSQ_SOURCE_LINE 00000035 "    }"
NSQ_SOURCE_LINE 00000036 "    else {"
NSQ_SOURCE_LINE 00000037 "      die qq{\"$tag\" is not exported by the $class module\\n}"
NSQ_SOURCE_LINE 00000038 "    }"
NSQ_SOURCE_LINE 00000039 "  }"
NSQ_SOURCE_LINE 00000040 "  return;"
NSQ_SOURCE_LINE 00000041 "}"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "sub _force_reload {"
NSQ_SOURCE_LINE 00000044 "  no warnings 'redefine';"
NSQ_SOURCE_LINE 00000045 "  local $^W = 0;"
NSQ_SOURCE_LINE 00000046 "  for my $m ( @_ ) {"
NSQ_SOURCE_LINE 00000047 "    $m =~ s{::}{/}g;"
NSQ_SOURCE_LINE 00000048 "    $m .= \".pm\";"
NSQ_SOURCE_LINE 00000049 "    require $m if delete $INC{$m};"
NSQ_SOURCE_LINE 00000050 "  }"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "#pod =head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000054 "#pod"
NSQ_SOURCE_LINE 00000055 "#pod   use Sub::Uplevel;"
NSQ_SOURCE_LINE 00000056 "#pod"
NSQ_SOURCE_LINE 00000057 "#pod   sub foo {"
NSQ_SOURCE_LINE 00000058 "#pod       print join \" - \", caller;"
NSQ_SOURCE_LINE 00000059 "#pod   }"
NSQ_SOURCE_LINE 00000060 "#pod"
NSQ_SOURCE_LINE 00000061 "#pod   sub bar {"
NSQ_SOURCE_LINE 00000062 "#pod       uplevel 1, \\&foo;"
NSQ_SOURCE_LINE 00000063 "#pod   }"
NSQ_SOURCE_LINE 00000064 "#pod"
NSQ_SOURCE_LINE 00000065 "#pod   #line 11"
NSQ_SOURCE_LINE 00000066 "#pod   bar();    # main - foo.plx - 11"
NSQ_SOURCE_LINE 00000067 "#pod"
NSQ_SOURCE_LINE 00000068 "#pod =head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000069 "#pod"
NSQ_SOURCE_LINE 00000070 "#pod Like Tcl's uplevel() function, but not quite so dangerous.  The idea"
NSQ_SOURCE_LINE 00000071 "#pod is just to fool caller().  All the really naughty bits of Tcl's"
NSQ_SOURCE_LINE 00000072 "#pod uplevel() are avoided."
NSQ_SOURCE_LINE 00000073 "#pod"
NSQ_SOURCE_LINE 00000074 "#pod B<THIS IS NOT THE SORT OF THING YOU WANT TO DO EVERYDAY>"
NSQ_SOURCE_LINE 00000075 "#pod"
NSQ_SOURCE_LINE 00000076 "#pod =over 4"
NSQ_SOURCE_LINE 00000077 "#pod"
NSQ_SOURCE_LINE 00000078 "#pod =item B<uplevel>"
NSQ_SOURCE_LINE 00000079 "#pod"
NSQ_SOURCE_LINE 00000080 "#pod   uplevel $num_frames, \\&func, @args;"
NSQ_SOURCE_LINE 00000081 "#pod"
NSQ_SOURCE_LINE 00000082 "#pod Makes the given function think it's being executed $num_frames higher"
NSQ_SOURCE_LINE 00000083 "#pod than the current stack level.  So when they use caller($frames) it"
NSQ_SOURCE_LINE 00000084 "#pod will actually give caller($frames + $num_frames) for them."
NSQ_SOURCE_LINE 00000085 "#pod"
NSQ_SOURCE_LINE 00000086 "#pod C<uplevel(1, \\&some_func, @_)> is effectively C<goto &some_func> but"
NSQ_SOURCE_LINE 00000087 "#pod you don't immediately exit the current subroutine.  So while you can't"
NSQ_SOURCE_LINE 00000088 "#pod do this:"
NSQ_SOURCE_LINE 00000089 "#pod"
NSQ_SOURCE_LINE 00000090 "#pod     sub wrapper {"
NSQ_SOURCE_LINE 00000091 "#pod         print \"Before\\n\";"
NSQ_SOURCE_LINE 00000092 "#pod         goto &some_func;"
NSQ_SOURCE_LINE 00000093 "#pod         print \"After\\n\";"
NSQ_SOURCE_LINE 00000094 "#pod     }"
NSQ_SOURCE_LINE 00000095 "#pod"
NSQ_SOURCE_LINE 00000096 "#pod you can do this:"
NSQ_SOURCE_LINE 00000097 "#pod"
NSQ_SOURCE_LINE 00000098 "#pod     sub wrapper {"
NSQ_SOURCE_LINE 00000099 "#pod         print \"Before\\n\";"
NSQ_SOURCE_LINE 00000100 "#pod         my @out = uplevel 1, &some_func;"
NSQ_SOURCE_LINE 00000101 "#pod         print \"After\\n\";"
NSQ_SOURCE_LINE 00000102 "#pod         return @out;"
NSQ_SOURCE_LINE 00000103 "#pod     }"
NSQ_SOURCE_LINE 00000104 "#pod"
NSQ_SOURCE_LINE 00000105 "#pod C<uplevel> has the ability to issue a warning if C<$num_frames> is more than"
NSQ_SOURCE_LINE 00000106 "#pod the current call stack depth, although this warning is disabled and compiled"
NSQ_SOURCE_LINE 00000107 "#pod out by default as the check is relatively expensive."
NSQ_SOURCE_LINE 00000108 "#pod"
NSQ_SOURCE_LINE 00000109 "#pod To enable the check for debugging or testing, you should set the global"
NSQ_SOURCE_LINE 00000110 "#pod C<$Sub::Uplevel::CHECK_FRAMES> to true before loading Sub::Uplevel for the"
NSQ_SOURCE_LINE 00000111 "#pod first time as follows:"
NSQ_SOURCE_LINE 00000112 "#pod"
NSQ_SOURCE_LINE 00000113 "#pod     #!/usr/bin/perl"
NSQ_SOURCE_LINE 00000114 "#pod     "
NSQ_SOURCE_LINE 00000115 "#pod     BEGIN {"
NSQ_SOURCE_LINE 00000116 "#pod         $Sub::Uplevel::CHECK_FRAMES = 1;"
NSQ_SOURCE_LINE 00000117 "#pod     }"
NSQ_SOURCE_LINE 00000118 "#pod     use Sub::Uplevel;"
NSQ_SOURCE_LINE 00000119 "#pod"
NSQ_SOURCE_LINE 00000120 "#pod Setting or changing the global after the module has been loaded will have"
NSQ_SOURCE_LINE 00000121 "#pod no effect."
NSQ_SOURCE_LINE 00000122 "#pod"
NSQ_SOURCE_LINE 00000123 "#pod =cut"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "# @Up_Frames -- uplevel stack"
NSQ_SOURCE_LINE 00000126 "# $Caller_Proxy -- whatever caller() override was in effect before uplevel"
NSQ_SOURCE_LINE 00000127 "our (@Up_Frames, $Caller_Proxy);"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "sub _apparent_stack_height {"
NSQ_SOURCE_LINE 00000130 "    my $height = 1; # start above this function "
NSQ_SOURCE_LINE 00000131 "    while ( 1 ) {"
NSQ_SOURCE_LINE 00000132 "        last if ! defined scalar $Caller_Proxy->($height);"
NSQ_SOURCE_LINE 00000133 "        $height++;"
NSQ_SOURCE_LINE 00000134 "    }"
NSQ_SOURCE_LINE 00000135 "    return $height - 1; # subtract 1 for this function"
NSQ_SOURCE_LINE 00000136 "}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "sub uplevel {"
NSQ_SOURCE_LINE 00000139 "    # Backwards compatible version of \"no warnings 'redefine'\""
NSQ_SOURCE_LINE 00000140 "    my $old_W = $^W;"
NSQ_SOURCE_LINE 00000141 "    $^W = 0;"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    # Update the caller proxy if the uplevel override isn't in effect"
NSQ_SOURCE_LINE 00000144 "    local $Caller_Proxy = *CORE::GLOBAL::caller{CODE}"
NSQ_SOURCE_LINE 00000145 "        if *CORE::GLOBAL::caller{CODE} != \\&_uplevel_caller;"
NSQ_SOURCE_LINE 00000146 "    local *CORE::GLOBAL::caller = \\&_uplevel_caller;"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    # Restore old warnings state"
NSQ_SOURCE_LINE 00000149 "    $^W = $old_W;"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    if ( CHECK_FRAMES and $_[0] >= _apparent_stack_height() ) {"
NSQ_SOURCE_LINE 00000152 "      require Carp;"
NSQ_SOURCE_LINE 00000153 "      Carp::carp(\"uplevel $_[0] is more than the caller stack\");"
NSQ_SOURCE_LINE 00000154 "    }"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    local @Up_Frames = (shift, @Up_Frames );"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    my $function = shift;"
NSQ_SOURCE_LINE 00000159 "    return $function->(@_);"
NSQ_SOURCE_LINE 00000160 "}"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "sub _normal_caller (;$) { ## no critic Prototypes"
NSQ_SOURCE_LINE 00000163 "    my ($height) = @_;"
NSQ_SOURCE_LINE 00000164 "    $height++;"
NSQ_SOURCE_LINE 00000165 "    my @caller = CORE::caller($height);"
NSQ_SOURCE_LINE 00000166 "    if ( CORE::caller() eq 'DB' ) {"
NSQ_SOURCE_LINE 00000167 "        # Oops, redo picking up @DB::args"
NSQ_SOURCE_LINE 00000168 "        package DB;"
NSQ_SOURCE_LINE 00000169 "        @caller = CORE::caller($height);"
NSQ_SOURCE_LINE 00000170 "    }"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    return if ! @caller;                  # empty"
NSQ_SOURCE_LINE 00000173 "    return $caller[0] if ! wantarray;     # scalar context"
NSQ_SOURCE_LINE 00000174 "    return @_ ? @caller : @caller[0..2];  # extra info or regular"
NSQ_SOURCE_LINE 00000175 "}"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "sub _uplevel_caller (;$) { ## no critic Prototypes"
NSQ_SOURCE_LINE 00000178 "    my $height = $_[0] || 0;"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    # shortcut if no uplevels have been called"
NSQ_SOURCE_LINE 00000181 "    # always add +1 to CORE::caller (proxy caller function)"
NSQ_SOURCE_LINE 00000182 "    # to skip this function's caller"
NSQ_SOURCE_LINE 00000183 "    return $Caller_Proxy->( $height + 1 ) if ! @Up_Frames;"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "#pod =begin _private"
NSQ_SOURCE_LINE 00000186 "#pod"
NSQ_SOURCE_LINE 00000187 "#pod So it has to work like this:"
NSQ_SOURCE_LINE 00000188 "#pod"
NSQ_SOURCE_LINE 00000189 "#pod     Call stack               Actual     uplevel 1"
NSQ_SOURCE_LINE 00000190 "#pod CORE::GLOBAL::caller"
NSQ_SOURCE_LINE 00000191 "#pod Carp::short_error_loc           0"
NSQ_SOURCE_LINE 00000192 "#pod Carp::shortmess_heavy           1           0"
NSQ_SOURCE_LINE 00000193 "#pod Carp::croak                     2           1"
NSQ_SOURCE_LINE 00000194 "#pod try_croak                       3           2"
NSQ_SOURCE_LINE 00000195 "#pod uplevel                         4            "
NSQ_SOURCE_LINE 00000196 "#pod function_that_called_uplevel    5            "
NSQ_SOURCE_LINE 00000197 "#pod caller_we_want_to_see           6           3"
NSQ_SOURCE_LINE 00000198 "#pod its_caller                      7           4"
NSQ_SOURCE_LINE 00000199 "#pod"
NSQ_SOURCE_LINE 00000200 "#pod So when caller(X) winds up below uplevel(), it only has to use  "
NSQ_SOURCE_LINE 00000201 "#pod CORE::caller(X+1) (to skip CORE::GLOBAL::caller).  But when caller(X)"
NSQ_SOURCE_LINE 00000202 "#pod winds up no or above uplevel(), it's CORE::caller(X+1+uplevel+1)."
NSQ_SOURCE_LINE 00000203 "#pod"
NSQ_SOURCE_LINE 00000204 "#pod Which means I'm probably going to have to do something nasty like walk"
NSQ_SOURCE_LINE 00000205 "#pod up the call stack on each caller() to see if I'm going to wind up   "
NSQ_SOURCE_LINE 00000206 "#pod before or after Sub::Uplevel::uplevel()."
NSQ_SOURCE_LINE 00000207 "#pod"
NSQ_SOURCE_LINE 00000208 "#pod =end _private"
NSQ_SOURCE_LINE 00000209 "#pod"
NSQ_SOURCE_LINE 00000210 "#pod =begin _dagolden"
NSQ_SOURCE_LINE 00000211 "#pod"
NSQ_SOURCE_LINE 00000212 "#pod I found the description above a bit confusing.  Instead, this is the logic"
NSQ_SOURCE_LINE 00000213 "#pod that I found clearer when CORE::GLOBAL::caller is invoked and we have to"
NSQ_SOURCE_LINE 00000214 "#pod walk up the call stack:"
NSQ_SOURCE_LINE 00000215 "#pod"
NSQ_SOURCE_LINE 00000216 "#pod * if searching up to the requested height in the real call stack doesn't find"
NSQ_SOURCE_LINE 00000217 "#pod a call to uplevel, then we can return the result at that height in the"
NSQ_SOURCE_LINE 00000218 "#pod call stack"
NSQ_SOURCE_LINE 00000219 "#pod"
NSQ_SOURCE_LINE 00000220 "#pod * if we find a call to uplevel, we need to keep searching upwards beyond the"
NSQ_SOURCE_LINE 00000221 "#pod requested height at least by the amount of upleveling requested for that"
NSQ_SOURCE_LINE 00000222 "#pod call to uplevel (from the Up_Frames stack set during the uplevel call)"
NSQ_SOURCE_LINE 00000223 "#pod"
NSQ_SOURCE_LINE 00000224 "#pod * additionally, we need to hide the uplevel subroutine call, too, so we search"
NSQ_SOURCE_LINE 00000225 "#pod upwards one more level for each call to uplevel"
NSQ_SOURCE_LINE 00000226 "#pod"
NSQ_SOURCE_LINE 00000227 "#pod * when we've reached the top of the search, we want to return that frame"
NSQ_SOURCE_LINE 00000228 "#pod in the call stack, i.e. the requested height plus any uplevel adjustments"
NSQ_SOURCE_LINE 00000229 "#pod found during the search"
NSQ_SOURCE_LINE 00000230 "#pod"
NSQ_SOURCE_LINE 00000231 "#pod =end _dagolden"
NSQ_SOURCE_LINE 00000232 "#pod"
NSQ_SOURCE_LINE 00000233 "#pod =cut"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "    my $saw_uplevel = 0;"
NSQ_SOURCE_LINE 00000236 "    my $adjust = 0;"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "    # walk up the call stack to fight the right package level to return;"
NSQ_SOURCE_LINE 00000239 "    # look one higher than requested for each call to uplevel found"
NSQ_SOURCE_LINE 00000240 "    # and adjust by the amount found in the Up_Frames stack for that call."
NSQ_SOURCE_LINE 00000241 "    # We *must* use CORE::caller here since we need the real stack not what "
NSQ_SOURCE_LINE 00000242 "    # some other override says the stack looks like, just in case that other"
NSQ_SOURCE_LINE 00000243 "    # override breaks things in some horrible way"
NSQ_SOURCE_LINE 00000244 "    my $test_caller;"
NSQ_SOURCE_LINE 00000245 "    for ( my $up = 0; $up <= $height + $adjust; $up++ ) {"
NSQ_SOURCE_LINE 00000246 "        $test_caller = scalar CORE::caller($up + 1);"
NSQ_SOURCE_LINE 00000247 "        if( $test_caller && $test_caller eq __PACKAGE__ ) {"
NSQ_SOURCE_LINE 00000248 "            # add one for each uplevel call seen"
NSQ_SOURCE_LINE 00000249 "            # and look into the uplevel stack for the offset"
NSQ_SOURCE_LINE 00000250 "            $adjust += 1 + $Up_Frames[$saw_uplevel];"
NSQ_SOURCE_LINE 00000251 "            $saw_uplevel++;"
NSQ_SOURCE_LINE 00000252 "        }"
NSQ_SOURCE_LINE 00000253 "    }"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "    # For returning values, we pass through the call to the proxy caller"
NSQ_SOURCE_LINE 00000256 "    # function, just at a higher stack level"
NSQ_SOURCE_LINE 00000257 "    my @caller = $Caller_Proxy->($height + $adjust + 1);"
NSQ_SOURCE_LINE 00000258 "    if ( CORE::caller() eq 'DB' ) {"
NSQ_SOURCE_LINE 00000259 "        # Oops, redo picking up @DB::args"
NSQ_SOURCE_LINE 00000260 "        package DB;"
NSQ_SOURCE_LINE 00000261 "        @caller = $Sub::Uplevel::Caller_Proxy->($height + $adjust + 1);"
NSQ_SOURCE_LINE 00000262 "    }"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "    return if ! @caller;                  # empty"
NSQ_SOURCE_LINE 00000265 "    return $caller[0] if ! wantarray;     # scalar context"
NSQ_SOURCE_LINE 00000266 "    return @_ ? @caller : @caller[0..2];  # extra info or regular"
NSQ_SOURCE_LINE 00000267 "}"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "#pod =back"
NSQ_SOURCE_LINE 00000270 "#pod"
NSQ_SOURCE_LINE 00000271 "#pod =head1 EXAMPLE"
NSQ_SOURCE_LINE 00000272 "#pod"
NSQ_SOURCE_LINE 00000273 "#pod The main reason I wrote this module is so I could write wrappers"
NSQ_SOURCE_LINE 00000274 "#pod around functions and they wouldn't be aware they've been wrapped."
NSQ_SOURCE_LINE 00000275 "#pod"
NSQ_SOURCE_LINE 00000276 "#pod     use Sub::Uplevel;"
NSQ_SOURCE_LINE 00000277 "#pod"
NSQ_SOURCE_LINE 00000278 "#pod     my $original_foo = \\&foo;"
NSQ_SOURCE_LINE 00000279 "#pod"
NSQ_SOURCE_LINE 00000280 "#pod     *foo = sub {"
NSQ_SOURCE_LINE 00000281 "#pod         my @output = uplevel 1, $original_foo;"
NSQ_SOURCE_LINE 00000282 "#pod         print \"foo() returned:  @output\";"
NSQ_SOURCE_LINE 00000283 "#pod         return @output;"
NSQ_SOURCE_LINE 00000284 "#pod     };"
NSQ_SOURCE_LINE 00000285 "#pod"
NSQ_SOURCE_LINE 00000286 "#pod If this code frightens you B<you should not use this module.>"
NSQ_SOURCE_LINE 00000287 "#pod"
NSQ_SOURCE_LINE 00000288 "#pod"
NSQ_SOURCE_LINE 00000289 "#pod =head1 BUGS and CAVEATS"
NSQ_SOURCE_LINE 00000290 "#pod"
NSQ_SOURCE_LINE 00000291 "#pod Well, the bad news is uplevel() is about 5 times slower than a normal"
NSQ_SOURCE_LINE 00000292 "#pod function call.  XS implementation anyone?  It also slows down every invocation"
NSQ_SOURCE_LINE 00000293 "#pod of caller(), regardless of whether uplevel() is in effect."
NSQ_SOURCE_LINE 00000294 "#pod"
NSQ_SOURCE_LINE 00000295 "#pod Sub::Uplevel overrides CORE::GLOBAL::caller temporarily for the scope of"
NSQ_SOURCE_LINE 00000296 "#pod each uplevel call.  It does its best to work with any previously existing"
NSQ_SOURCE_LINE 00000297 "#pod CORE::GLOBAL::caller (both when Sub::Uplevel is first loaded and within "
NSQ_SOURCE_LINE 00000298 "#pod each uplevel call) such as from Contextual::Return or Hook::LexWrap.  "
NSQ_SOURCE_LINE 00000299 "#pod"
NSQ_SOURCE_LINE 00000300 "#pod However, if you are routinely using multiple modules that override "
NSQ_SOURCE_LINE 00000301 "#pod CORE::GLOBAL::caller, you are probably asking for trouble."
NSQ_SOURCE_LINE 00000302 "#pod"
NSQ_SOURCE_LINE 00000303 "#pod You B<should> load Sub::Uplevel as early as possible within your program.  As"
NSQ_SOURCE_LINE 00000304 "#pod with all CORE::GLOBAL overloading, the overload will not affect modules that"
NSQ_SOURCE_LINE 00000305 "#pod have already been compiled prior to the overload.  One module that often is"
NSQ_SOURCE_LINE 00000306 "#pod unavoidably loaded prior to Sub::Uplevel is Exporter.  To forcibly recompile"
NSQ_SOURCE_LINE 00000307 "#pod Exporter (and Exporter::Heavy) after loading Sub::Uplevel, use it with the"
NSQ_SOURCE_LINE 00000308 "#pod \":aggressive\" tag:"
NSQ_SOURCE_LINE 00000309 "#pod"
NSQ_SOURCE_LINE 00000310 "#pod     use Sub::Uplevel qw/:aggressive/;"
NSQ_SOURCE_LINE 00000311 "#pod"
NSQ_SOURCE_LINE 00000312 "#pod The private function C<Sub::Uplevel::_force_reload()> may be passed a list of"
NSQ_SOURCE_LINE 00000313 "#pod additional modules to reload if \":aggressive\" is not aggressive enough.  "
NSQ_SOURCE_LINE 00000314 "#pod Reloading modules may break things, so only use this as a last resort."
NSQ_SOURCE_LINE 00000315 "#pod"
NSQ_SOURCE_LINE 00000316 "#pod As of version 0.20, Sub::Uplevel requires Perl 5.6 or greater."
NSQ_SOURCE_LINE 00000317 "#pod"
NSQ_SOURCE_LINE 00000318 "#pod =head1 HISTORY"
NSQ_SOURCE_LINE 00000319 "#pod"
NSQ_SOURCE_LINE 00000320 "#pod Those who do not learn from HISTORY are doomed to repeat it."
NSQ_SOURCE_LINE 00000321 "#pod"
NSQ_SOURCE_LINE 00000322 "#pod The lesson here is simple:  Don't sit next to a Tcl programmer at the"
NSQ_SOURCE_LINE 00000323 "#pod dinner table."
NSQ_SOURCE_LINE 00000324 "#pod"
NSQ_SOURCE_LINE 00000325 "#pod =head1 THANKS"
NSQ_SOURCE_LINE 00000326 "#pod"
NSQ_SOURCE_LINE 00000327 "#pod Thanks to Brent Welch, Damian Conway and Robin Houston."
NSQ_SOURCE_LINE 00000328 "#pod"
NSQ_SOURCE_LINE 00000329 "#pod See http://www.perl.com/perl/misc/Artistic.html"
NSQ_SOURCE_LINE 00000330 "#pod"
NSQ_SOURCE_LINE 00000331 "#pod =head1 SEE ALSO"
NSQ_SOURCE_LINE 00000332 "#pod"
NSQ_SOURCE_LINE 00000333 "#pod PadWalker (for the similar idea with lexicals), Hook::LexWrap, "
NSQ_SOURCE_LINE 00000334 "#pod Tcl's uplevel() at http://www.scriptics.com/man/tcl8.4/TclCmd/uplevel.htm"
NSQ_SOURCE_LINE 00000335 "#pod"
NSQ_SOURCE_LINE 00000336 "#pod =cut"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "1;"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "__END__"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=pod"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "=head1 NAME"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "Sub::Uplevel - apparently run a function in a higher stack frame"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "=head1 VERSION"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "version 0.2800"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "  use Sub::Uplevel;"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "  sub foo {"
NSQ_SOURCE_LINE 00000359 "      print join \" - \", caller;"
NSQ_SOURCE_LINE 00000360 "  }"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "  sub bar {"
NSQ_SOURCE_LINE 00000363 "      uplevel 1, \\&foo;"
NSQ_SOURCE_LINE 00000364 "  }"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "  #line 11"
NSQ_SOURCE_LINE 00000367 "  bar();    # main - foo.plx - 11"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "Like Tcl's uplevel() function, but not quite so dangerous.  The idea"
NSQ_SOURCE_LINE 00000372 "is just to fool caller().  All the really naughty bits of Tcl's"
NSQ_SOURCE_LINE 00000373 "uplevel() are avoided."
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "B<THIS IS NOT THE SORT OF THING YOU WANT TO DO EVERYDAY>"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "=over 4"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=item B<uplevel>"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "  uplevel $num_frames, \\&func, @args;"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "Makes the given function think it's being executed $num_frames higher"
NSQ_SOURCE_LINE 00000384 "than the current stack level.  So when they use caller($frames) it"
NSQ_SOURCE_LINE 00000385 "will actually give caller($frames + $num_frames) for them."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "C<uplevel(1, \\&some_func, @_)> is effectively C<goto &some_func> but"
NSQ_SOURCE_LINE 00000388 "you don't immediately exit the current subroutine.  So while you can't"
NSQ_SOURCE_LINE 00000389 "do this:"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "    sub wrapper {"
NSQ_SOURCE_LINE 00000392 "        print \"Before\\n\";"
NSQ_SOURCE_LINE 00000393 "        goto &some_func;"
NSQ_SOURCE_LINE 00000394 "        print \"After\\n\";"
NSQ_SOURCE_LINE 00000395 "    }"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "you can do this:"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "    sub wrapper {"
NSQ_SOURCE_LINE 00000400 "        print \"Before\\n\";"
NSQ_SOURCE_LINE 00000401 "        my @out = uplevel 1, &some_func;"
NSQ_SOURCE_LINE 00000402 "        print \"After\\n\";"
NSQ_SOURCE_LINE 00000403 "        return @out;"
NSQ_SOURCE_LINE 00000404 "    }"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "C<uplevel> has the ability to issue a warning if C<$num_frames> is more than"
NSQ_SOURCE_LINE 00000407 "the current call stack depth, although this warning is disabled and compiled"
NSQ_SOURCE_LINE 00000408 "out by default as the check is relatively expensive."
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "To enable the check for debugging or testing, you should set the global"
NSQ_SOURCE_LINE 00000411 "C<$Sub::Uplevel::CHECK_FRAMES> to true before loading Sub::Uplevel for the"
NSQ_SOURCE_LINE 00000412 "first time as follows:"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "    #!/usr/bin/perl"
NSQ_SOURCE_LINE 00000415 "    "
NSQ_SOURCE_LINE 00000416 "    BEGIN {"
NSQ_SOURCE_LINE 00000417 "        $Sub::Uplevel::CHECK_FRAMES = 1;"
NSQ_SOURCE_LINE 00000418 "    }"
NSQ_SOURCE_LINE 00000419 "    use Sub::Uplevel;"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "Setting or changing the global after the module has been loaded will have"
NSQ_SOURCE_LINE 00000422 "no effect."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "=begin _private"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "So it has to work like this:"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "    Call stack               Actual     uplevel 1"
NSQ_SOURCE_LINE 00000429 "CORE::GLOBAL::caller"
NSQ_SOURCE_LINE 00000430 "Carp::short_error_loc           0"
NSQ_SOURCE_LINE 00000431 "Carp::shortmess_heavy           1           0"
NSQ_SOURCE_LINE 00000432 "Carp::croak                     2           1"
NSQ_SOURCE_LINE 00000433 "try_croak                       3           2"
NSQ_SOURCE_LINE 00000434 "uplevel                         4            "
NSQ_SOURCE_LINE 00000435 "function_that_called_uplevel    5            "
NSQ_SOURCE_LINE 00000436 "caller_we_want_to_see           6           3"
NSQ_SOURCE_LINE 00000437 "its_caller                      7           4"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "So when caller(X) winds up below uplevel(), it only has to use  "
NSQ_SOURCE_LINE 00000440 "CORE::caller(X+1) (to skip CORE::GLOBAL::caller).  But when caller(X)"
NSQ_SOURCE_LINE 00000441 "winds up no or above uplevel(), it's CORE::caller(X+1+uplevel+1)."
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "Which means I'm probably going to have to do something nasty like walk"
NSQ_SOURCE_LINE 00000444 "up the call stack on each caller() to see if I'm going to wind up   "
NSQ_SOURCE_LINE 00000445 "before or after Sub::Uplevel::uplevel()."
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "=end _private"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "=begin _dagolden"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "I found the description above a bit confusing.  Instead, this is the logic"
NSQ_SOURCE_LINE 00000452 "that I found clearer when CORE::GLOBAL::caller is invoked and we have to"
NSQ_SOURCE_LINE 00000453 "walk up the call stack:"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "* if searching up to the requested height in the real call stack doesn't find"
NSQ_SOURCE_LINE 00000456 "a call to uplevel, then we can return the result at that height in the"
NSQ_SOURCE_LINE 00000457 "call stack"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "* if we find a call to uplevel, we need to keep searching upwards beyond the"
NSQ_SOURCE_LINE 00000460 "requested height at least by the amount of upleveling requested for that"
NSQ_SOURCE_LINE 00000461 "call to uplevel (from the Up_Frames stack set during the uplevel call)"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "* additionally, we need to hide the uplevel subroutine call, too, so we search"
NSQ_SOURCE_LINE 00000464 "upwards one more level for each call to uplevel"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "* when we've reached the top of the search, we want to return that frame"
NSQ_SOURCE_LINE 00000467 "in the call stack, i.e. the requested height plus any uplevel adjustments"
NSQ_SOURCE_LINE 00000468 "found during the search"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "=end _dagolden"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=back"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=head1 EXAMPLE"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "The main reason I wrote this module is so I could write wrappers"
NSQ_SOURCE_LINE 00000477 "around functions and they wouldn't be aware they've been wrapped."
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "    use Sub::Uplevel;"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "    my $original_foo = \\&foo;"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "    *foo = sub {"
NSQ_SOURCE_LINE 00000484 "        my @output = uplevel 1, $original_foo;"
NSQ_SOURCE_LINE 00000485 "        print \"foo() returned:  @output\";"
NSQ_SOURCE_LINE 00000486 "        return @output;"
NSQ_SOURCE_LINE 00000487 "    };"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "If this code frightens you B<you should not use this module.>"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "=head1 BUGS and CAVEATS"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "Well, the bad news is uplevel() is about 5 times slower than a normal"
NSQ_SOURCE_LINE 00000494 "function call.  XS implementation anyone?  It also slows down every invocation"
NSQ_SOURCE_LINE 00000495 "of caller(), regardless of whether uplevel() is in effect."
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "Sub::Uplevel overrides CORE::GLOBAL::caller temporarily for the scope of"
NSQ_SOURCE_LINE 00000498 "each uplevel call.  It does its best to work with any previously existing"
NSQ_SOURCE_LINE 00000499 "CORE::GLOBAL::caller (both when Sub::Uplevel is first loaded and within "
NSQ_SOURCE_LINE 00000500 "each uplevel call) such as from Contextual::Return or Hook::LexWrap.  "
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "However, if you are routinely using multiple modules that override "
NSQ_SOURCE_LINE 00000503 "CORE::GLOBAL::caller, you are probably asking for trouble."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "You B<should> load Sub::Uplevel as early as possible within your program.  As"
NSQ_SOURCE_LINE 00000506 "with all CORE::GLOBAL overloading, the overload will not affect modules that"
NSQ_SOURCE_LINE 00000507 "have already been compiled prior to the overload.  One module that often is"
NSQ_SOURCE_LINE 00000508 "unavoidably loaded prior to Sub::Uplevel is Exporter.  To forcibly recompile"
NSQ_SOURCE_LINE 00000509 "Exporter (and Exporter::Heavy) after loading Sub::Uplevel, use it with the"
NSQ_SOURCE_LINE 00000510 "\":aggressive\" tag:"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "    use Sub::Uplevel qw/:aggressive/;"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "The private function C<Sub::Uplevel::_force_reload()> may be passed a list of"
NSQ_SOURCE_LINE 00000515 "additional modules to reload if \":aggressive\" is not aggressive enough.  "
NSQ_SOURCE_LINE 00000516 "Reloading modules may break things, so only use this as a last resort."
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "As of version 0.20, Sub::Uplevel requires Perl 5.6 or greater."
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=head1 HISTORY"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "Those who do not learn from HISTORY are doomed to repeat it."
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "The lesson here is simple:  Don't sit next to a Tcl programmer at the"
NSQ_SOURCE_LINE 00000525 "dinner table."
NSQ_SOURCE_LINE 00000526 ""
