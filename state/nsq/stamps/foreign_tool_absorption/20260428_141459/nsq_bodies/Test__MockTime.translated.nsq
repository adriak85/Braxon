BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Test::MockTime;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use Carp();"
NSQ_SOURCE_LINE 00000006 "use Exporter();"
NSQ_SOURCE_LINE 00000007 "*import = \\&Exporter::import;"
NSQ_SOURCE_LINE 00000008 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000009 "  set_relative_time"
NSQ_SOURCE_LINE 00000010 "  set_absolute_time"
NSQ_SOURCE_LINE 00000011 "  set_fixed_time"
NSQ_SOURCE_LINE 00000012 "  restore_time"
NSQ_SOURCE_LINE 00000013 ");"
NSQ_SOURCE_LINE 00000014 "our %EXPORT_TAGS = ( 'all' => \\@EXPORT_OK, );"
NSQ_SOURCE_LINE 00000015 "our $VERSION     = '0.17';"
NSQ_SOURCE_LINE 00000016 "our $offset      = 0;"
NSQ_SOURCE_LINE 00000017 "our $fixed       = undef;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "BEGIN {"
NSQ_SOURCE_LINE 00000020 "    *CORE::GLOBAL::time      = \\&Test::MockTime::time;"
NSQ_SOURCE_LINE 00000021 "    *CORE::GLOBAL::localtime = \\&Test::MockTime::localtime;"
NSQ_SOURCE_LINE 00000022 "    *CORE::GLOBAL::gmtime    = \\&Test::MockTime::gmtime;"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub set_relative_time {"
NSQ_SOURCE_LINE 00000026 "    my ($relative) = @_;"
NSQ_SOURCE_LINE 00000027 "    if (   ( $relative eq __PACKAGE__ )"
NSQ_SOURCE_LINE 00000028 "        || ( UNIVERSAL::isa( $relative, __PACKAGE__ ) ) )"
NSQ_SOURCE_LINE 00000029 "    {"
NSQ_SOURCE_LINE 00000030 "        Carp::carp(\"Test::MockTime::set_relative_time called incorrectly\\n\");"
NSQ_SOURCE_LINE 00000031 "    }"
NSQ_SOURCE_LINE 00000032 "    $offset = $_[-1];    # last argument. might have been called in a OO syntax?"
NSQ_SOURCE_LINE 00000033 "    return $offset;"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub _time {"
NSQ_SOURCE_LINE 00000037 "    my ( $time, $spec ) = @_;"
NSQ_SOURCE_LINE 00000038 "    if ( $time !~ /\\A -? \\d+ \\z/xms ) {"
NSQ_SOURCE_LINE 00000039 "        $spec ||= '%Y-%m-%dT%H:%M:%SZ';"
NSQ_SOURCE_LINE 00000040 "    }"
NSQ_SOURCE_LINE 00000041 "    if ($spec) {"
NSQ_SOURCE_LINE 00000042 "        require Time::Piece;"
NSQ_SOURCE_LINE 00000043 "        $time = Time::Piece->strptime( $time, $spec )->epoch();"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 "    return $time;"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub set_absolute_time {"
NSQ_SOURCE_LINE 00000049 "    my ( $time, $spec ) = @_;"
NSQ_SOURCE_LINE 00000050 "    if ( ( $time eq __PACKAGE__ ) || ( UNIVERSAL::isa( $time, __PACKAGE__ ) ) )"
NSQ_SOURCE_LINE 00000051 "    {"
NSQ_SOURCE_LINE 00000052 "        Carp::carp(\"Test::MockTime::set_absolute_time called incorrectly\\n\");"
NSQ_SOURCE_LINE 00000053 "    }"
NSQ_SOURCE_LINE 00000054 "    $time = _time( $time, $spec );"
NSQ_SOURCE_LINE 00000055 "    $offset = $time - CORE::time;"
NSQ_SOURCE_LINE 00000056 "    return $offset;"
NSQ_SOURCE_LINE 00000057 "}"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "sub set_fixed_time {"
NSQ_SOURCE_LINE 00000060 "    my ( $time, $spec ) = @_;"
NSQ_SOURCE_LINE 00000061 "    if ( ( $time eq __PACKAGE__ ) || ( UNIVERSAL::isa( $time, __PACKAGE__ ) ) )"
NSQ_SOURCE_LINE 00000062 "    {"
NSQ_SOURCE_LINE 00000063 "        Carp::carp(\"Test::MockTime::set_fixed_time called incorrectly\\n\");"
NSQ_SOURCE_LINE 00000064 "    }"
NSQ_SOURCE_LINE 00000065 "    $time = _time( $time, $spec );"
NSQ_SOURCE_LINE 00000066 "    $fixed = $time;"
NSQ_SOURCE_LINE 00000067 "    return $fixed;"
NSQ_SOURCE_LINE 00000068 "}"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "sub time() {"
NSQ_SOURCE_LINE 00000071 "    if ( defined $fixed ) {"
NSQ_SOURCE_LINE 00000072 "        return $fixed;"
NSQ_SOURCE_LINE 00000073 "    }"
NSQ_SOURCE_LINE 00000074 "    else {"
NSQ_SOURCE_LINE 00000075 "        return ( CORE::time + $offset );"
NSQ_SOURCE_LINE 00000076 "    }"
NSQ_SOURCE_LINE 00000077 "}"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "sub localtime (;$) {"
NSQ_SOURCE_LINE 00000080 "    my ($time) = @_;"
NSQ_SOURCE_LINE 00000081 "    if ( !defined $time ) {"
NSQ_SOURCE_LINE 00000082 "        $time = Test::MockTime::time();"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 "    return CORE::localtime($time);"
NSQ_SOURCE_LINE 00000085 "}"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "sub gmtime (;$) {"
NSQ_SOURCE_LINE 00000088 "    my ($time) = @_;"
NSQ_SOURCE_LINE 00000089 "    if ( !defined $time ) {"
NSQ_SOURCE_LINE 00000090 "        $time = Test::MockTime::time();"
NSQ_SOURCE_LINE 00000091 "    }"
NSQ_SOURCE_LINE 00000092 "    return CORE::gmtime($time);"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub restore {"
NSQ_SOURCE_LINE 00000096 "    $offset = 0;"
NSQ_SOURCE_LINE 00000097 "    $fixed  = undef;"
NSQ_SOURCE_LINE 00000098 "    return;"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 "*restore_time = \\&restore;"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "1;"
NSQ_SOURCE_LINE 00000103 "__END__"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=head1 NAME"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "Test::MockTime - Replaces actual time with simulated time "
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=head1 VERSION"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "Version 0.17"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "  use Test::MockTime qw( :all );"
NSQ_SOURCE_LINE 00000116 "  set_relative_time(-600);"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "  # do some tests depending on time increasing from 600 seconds ago"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "  set_absolute_time(0);"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "  # do some more tests depending on time starting from the epoch"
NSQ_SOURCE_LINE 00000123 "  # epoch may vary according to platform.  see perlport."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "  set_fixed_time(CORE::time());"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "  # do some more tests depending on time staying at the current actual time"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "  set_absolute_time('1970-01-01T00:00:00Z');"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "  # do some tests depending on time starting at Unix epoch time"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "  set_fixed_time('01/01/1970 00:00:00', '%m/%d/%Y %H:%M:%S');"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "  # do some tests depending on time staying at the Unix epoch time"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "  restore_time();"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "  # resume normal service"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "This module was created to enable test suites to test code at specific "
NSQ_SOURCE_LINE 00000144 "points in time. Specifically it overrides localtime, gmtime and time at"
NSQ_SOURCE_LINE 00000145 "compile time and then relies on the user supplying a mock time via "
NSQ_SOURCE_LINE 00000146 "set_relative_time, set_absolute_time or set_fixed_time to alter future "
NSQ_SOURCE_LINE 00000147 "calls to gmtime,time or localtime."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=head1 SUBROUTINES/METHODS"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=over"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=item set_absolute_time"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "If given a single, numeric argument, the argument is an absolute time (for"
NSQ_SOURCE_LINE 00000156 "example, if 0 is supplied, the absolute time will be the epoch), and"
NSQ_SOURCE_LINE 00000157 "calculates the offset to allow subsequent calls to time, gmtime and localtime"
NSQ_SOURCE_LINE 00000158 "to reflect this."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "for example, in the following code"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "  Test::MockTime::set_absolute_time(0);"
NSQ_SOURCE_LINE 00000163 "  my ($start) = time;"
NSQ_SOURCE_LINE 00000164 "  sleep 2;"
NSQ_SOURCE_LINE 00000165 "  my ($end) = time;"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "The $end variable should contain 2 seconds past the epoch;"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "If given two arguments, the first argument is taken to be an absolute time in"
NSQ_SOURCE_LINE 00000170 "some string format (for example, \"01/01/1970 00:00:00\").  The second argument"
NSQ_SOURCE_LINE 00000171 "is taken to be a C<strptime> format string (for example, \"%m/%d/%Y %H:%M:%S\")."
NSQ_SOURCE_LINE 00000172 "If a single argument is given, but that argument is not numeric, a"
NSQ_SOURCE_LINE 00000173 "C<strptime> format string of \"%Y-%m-%dT%H:%M:%SZ\" is assumed."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "for example, in the following code"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "  Test::MockTime::set_absolute_time('1970-01-01T00:00:00Z');"
NSQ_SOURCE_LINE 00000178 "  my ($start) = time;"
NSQ_SOURCE_LINE 00000179 "  sleep 2;"
NSQ_SOURCE_LINE 00000180 "  my ($end) = time;"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "The $end variable should contain 2 seconds past the Unix epoch;"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=item set_relative_time($relative)"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "takes as an argument an relative value from current time (for example, if -10"
NSQ_SOURCE_LINE 00000187 "is supplied, current time be converted to actual machine time - 10 seconds)"
NSQ_SOURCE_LINE 00000188 "and calculates the offset to allow subsequent calls to time,gmtime and localtime"
NSQ_SOURCE_LINE 00000189 "to reflect this."
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "for example, in the following code"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "  my ($start) = time;"
NSQ_SOURCE_LINE 00000194 "  Test::MockTime::set_relative_time(-600);"
NSQ_SOURCE_LINE 00000195 "  sleep 600;"
NSQ_SOURCE_LINE 00000196 "  my ($end) = time;"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "The $end variable should contain either the same or very similar values to the"
NSQ_SOURCE_LINE 00000199 "$start variable."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=item set_fixed_time"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "If given a single, numeric argument, the argument is an absolute time (for"
NSQ_SOURCE_LINE 00000204 "example, if 0 is supplied, the absolute time will be the epoch).  All"
NSQ_SOURCE_LINE 00000205 "subsequent calls to gmtime, localtime and time will return this value."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "for example, in the following code"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "  Test::MockTime::set_fixed_time(time)"
NSQ_SOURCE_LINE 00000210 "  my ($start) = time;"
NSQ_SOURCE_LINE 00000211 "  sleep 3;"
NSQ_SOURCE_LINE 00000212 "  my ($end) = time;"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "the $end variable and the $start variable will contain the same results"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "If given two arguments, the first argument is taken to be an absolute time in"
NSQ_SOURCE_LINE 00000217 "some string format (for example, \"01/01/1970 00:00:00\").  The second argument"
NSQ_SOURCE_LINE 00000218 "is taken to be a C<strptime> format string (for example, \"%m/%d/%Y %H:%M:%S\")."
NSQ_SOURCE_LINE 00000219 "If a single argument is given, but that argument is not numeric, a"
NSQ_SOURCE_LINE 00000220 "C<strptime> format string of \"%Y-%m-%dT%H:%M:%SZ\" is assumed."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=item restore()"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "restore the default time handling values.  C<restore_time> is an alias. When"
NSQ_SOURCE_LINE 00000225 "exported with the 'all' tag, this subroutine is exported as C<restore_time>."
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=back"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=head1 CONFIGURATION AND ENVIRONMENT"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "Test::MockTime requires no configuration files or environment variables."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=head1 DEPENDENCIES"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "Test::MockTime depends on the following non-core Perl modules."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=over"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=item *"
NSQ_SOURCE_LINE 00000240 "L<Time::Piece 1.08 or greater|Time::Piece>"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=back"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head1 INCOMPATIBILITIES"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "None reported"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=head1 BUGS AND LIMITATIONS"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "Probably."
NSQ_SOURCE_LINE 00000251 " "
