BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 "package Hook::LexWrap; # git description: v0.25-14-g33c34e7"
NSQ_SOURCE_LINE 00000004 "# vi: noet sts=8 sw=8 ts=8 :"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: Lexically scoped subroutine wrappers"
NSQ_SOURCE_LINE 00000006 "# KEYWORDS: subroutine function modifier wrapper lexical scope"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.26';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Carp ();"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "{"
NSQ_SOURCE_LINE 00000013 "no warnings 'redefine';"
NSQ_SOURCE_LINE 00000014 "*CORE::GLOBAL::caller = sub (;$) {"
NSQ_SOURCE_LINE 00000015 "\tmy ($height) = ($_[0]||0);"
NSQ_SOURCE_LINE 00000016 "\tmy $i=1;"
NSQ_SOURCE_LINE 00000017 "\tmy $name_cache;"
NSQ_SOURCE_LINE 00000018 "\twhile (1) {"
NSQ_SOURCE_LINE 00000019 "\t\tmy @caller = CORE::caller() eq 'DB'"
NSQ_SOURCE_LINE 00000020 "\t\t\t? do { package\t# line break to foil [Git::Describe]"
NSQ_SOURCE_LINE 00000021 "\t\t\t\tDB; CORE::caller($i++) }"
NSQ_SOURCE_LINE 00000022 "\t\t\t: CORE::caller($i++);"
NSQ_SOURCE_LINE 00000023 "\t\treturn if not @caller;"
NSQ_SOURCE_LINE 00000024 "\t\t$caller[3] = $name_cache if $name_cache;"
NSQ_SOURCE_LINE 00000025 "\t\t$name_cache = $caller[0] eq 'Hook::LexWrap' ? $caller[3] : '';"
NSQ_SOURCE_LINE 00000026 "\t\tnext if $name_cache || $height-- != 0;"
NSQ_SOURCE_LINE 00000027 "\t\treturn wantarray ? @_ ? @caller : @caller[0..2] : $caller[0];"
NSQ_SOURCE_LINE 00000028 "\t}"
NSQ_SOURCE_LINE 00000029 "};"
NSQ_SOURCE_LINE 00000030 "}"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub import { no strict 'refs'; *{caller().\"::wrap\"} = \\&wrap }"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub wrap (*@) {  ## no critic Prototypes"
NSQ_SOURCE_LINE 00000035 "\tmy ($typeglob, %wrapper) = @_;"
NSQ_SOURCE_LINE 00000036 "\t$typeglob = (ref $typeglob || $typeglob =~ /::/)"
NSQ_SOURCE_LINE 00000037 "\t\t? $typeglob"
NSQ_SOURCE_LINE 00000038 "\t\t: caller().\"::$typeglob\";"
NSQ_SOURCE_LINE 00000039 "\tmy $original;"
NSQ_SOURCE_LINE 00000040 "\t{"
NSQ_SOURCE_LINE 00000041 "\t        no strict 'refs';"
NSQ_SOURCE_LINE 00000042 "\t        $original = ref $typeglob eq 'CODE' && $typeglob"
NSQ_SOURCE_LINE 00000043 "\t\t     || *$typeglob{CODE}"
NSQ_SOURCE_LINE 00000044 "\t\t     || Carp::croak \"Can't wrap non-existent subroutine \", $typeglob;"
NSQ_SOURCE_LINE 00000045 "\t}"
NSQ_SOURCE_LINE 00000046 "\tCarp::croak \"'$_' value is not a subroutine reference\""
NSQ_SOURCE_LINE 00000047 "\t\tforeach grep {$wrapper{$_} && ref $wrapper{$_} ne 'CODE'}"
NSQ_SOURCE_LINE 00000048 "\t\t\tqw(pre post);"
NSQ_SOURCE_LINE 00000049 "\tno warnings 'redefine';"
NSQ_SOURCE_LINE 00000050 "\tmy ($caller, $unwrap) = *CORE::GLOBAL::caller{CODE};"
NSQ_SOURCE_LINE 00000051 "\tmy $imposter = sub {"
NSQ_SOURCE_LINE 00000052 "\t\tif ($unwrap) { goto &$original }"
NSQ_SOURCE_LINE 00000053 "\t\tmy ($return, $prereturn);"
NSQ_SOURCE_LINE 00000054 "\t\tif (wantarray) {"
NSQ_SOURCE_LINE 00000055 "\t\t\t$prereturn = $return = [];"
NSQ_SOURCE_LINE 00000056 "\t\t\t() = $wrapper{pre}->(@_,$return) if $wrapper{pre};"
NSQ_SOURCE_LINE 00000057 "\t\t\tif (ref $return eq 'ARRAY' && $return == $prereturn && !@$return) {"
NSQ_SOURCE_LINE 00000058 "\t\t\t\t$return = [ &$original ];"
NSQ_SOURCE_LINE 00000059 "\t\t\t\t() = $wrapper{post}->(@_, $return)"
NSQ_SOURCE_LINE 00000060 "\t\t\t\t\tif $wrapper{post};"
NSQ_SOURCE_LINE 00000061 "\t\t\t}"
NSQ_SOURCE_LINE 00000062 "\t\t\treturn ref $return eq 'ARRAY' ? @$return : ($return);"
NSQ_SOURCE_LINE 00000063 "\t\t}"
NSQ_SOURCE_LINE 00000064 "\t\telsif (defined wantarray) {"
NSQ_SOURCE_LINE 00000065 "\t\t\t$return = bless sub {$prereturn=1}, 'Hook::LexWrap::Cleanup';"
NSQ_SOURCE_LINE 00000066 "\t\t\tmy $dummy = $wrapper{pre}->(@_, $return) if $wrapper{pre};"
NSQ_SOURCE_LINE 00000067 "\t\t\tunless ($prereturn) {"
NSQ_SOURCE_LINE 00000068 "\t\t\t\t$return = &$original;"
NSQ_SOURCE_LINE 00000069 "\t\t\t\t$dummy = scalar $wrapper{post}->(@_, $return)"
NSQ_SOURCE_LINE 00000070 "\t\t\t\t\tif $wrapper{post};"
NSQ_SOURCE_LINE 00000071 "\t\t\t}"
NSQ_SOURCE_LINE 00000072 "\t\t\treturn $return;"
NSQ_SOURCE_LINE 00000073 "\t\t}"
NSQ_SOURCE_LINE 00000074 "\t\telse {"
NSQ_SOURCE_LINE 00000075 "\t\t\t$return = bless sub {$prereturn=1}, 'Hook::LexWrap::Cleanup';"
NSQ_SOURCE_LINE 00000076 "\t\t\t$wrapper{pre}->(@_, $return) if $wrapper{pre};"
NSQ_SOURCE_LINE 00000077 "\t\t\tunless ($prereturn) {"
NSQ_SOURCE_LINE 00000078 "\t\t\t\t&$original;"
NSQ_SOURCE_LINE 00000079 "\t\t\t\t$wrapper{post}->(@_, $return)"
NSQ_SOURCE_LINE 00000080 "\t\t\t\t\tif $wrapper{post};"
NSQ_SOURCE_LINE 00000081 "\t\t\t}"
NSQ_SOURCE_LINE 00000082 "\t\t\treturn;"
NSQ_SOURCE_LINE 00000083 "\t\t}"
NSQ_SOURCE_LINE 00000084 "\t};"
NSQ_SOURCE_LINE 00000085 "\tref $typeglob eq 'CODE' and return defined wantarray"
NSQ_SOURCE_LINE 00000086 "\t\t? $imposter"
NSQ_SOURCE_LINE 00000087 "\t\t: Carp::carp \"Uselessly wrapped subroutine reference in void context\";"
NSQ_SOURCE_LINE 00000088 "\t{"
NSQ_SOURCE_LINE 00000089 "\t        no strict 'refs';"
NSQ_SOURCE_LINE 00000090 "\t        *{$typeglob} = $imposter;"
NSQ_SOURCE_LINE 00000091 "\t}"
NSQ_SOURCE_LINE 00000092 "\treturn unless defined wantarray;"
NSQ_SOURCE_LINE 00000093 "\treturn bless sub{ $unwrap=1 }, 'Hook::LexWrap::Cleanup';"
NSQ_SOURCE_LINE 00000094 "}"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "package  # hide from PAUSE"
NSQ_SOURCE_LINE 00000097 "\tHook::LexWrap::Cleanup;"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "sub DESTROY { $_[0]->() }"
NSQ_SOURCE_LINE 00000100 "use overload "
NSQ_SOURCE_LINE 00000101 "\tq{\"\"}   => sub { undef },"
NSQ_SOURCE_LINE 00000102 "\tq{0+}   => sub { undef },"
NSQ_SOURCE_LINE 00000103 "\tq{bool} => sub { undef },"
NSQ_SOURCE_LINE 00000104 "\tq{fallback}=>1; #fallback=1 - like no overloading for other operations"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "1;"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "__END__"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=pod"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 NAME"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "Hook::LexWrap - Lexically scoped subroutine wrappers"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=head1 VERSION"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "version 0.26"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "\tuse Hook::LexWrap;"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "\tsub doit { print \"[doit:\", caller, \"]\"; return {my=>\"data\"} }"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "\tSCOPED: {"
NSQ_SOURCE_LINE 00000129 "\t\twrap doit =>"
NSQ_SOURCE_LINE 00000130 "\t\t\tpre  => sub { print \"[pre1: @_]\\n\" },"
NSQ_SOURCE_LINE 00000131 "\t\t\tpost => sub { print \"[post1:@_]\\n\"; $_[1]=9; };"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "\t\tmy $temporarily = wrap doit =>"
NSQ_SOURCE_LINE 00000134 "\t\t\tpost => sub { print \"[post2:@_]\\n\" },"
NSQ_SOURCE_LINE 00000135 "\t\t\tpre  => sub { print \"[pre2: @_]\\n  \"};"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "\t\t@args = (1,2,3);"
NSQ_SOURCE_LINE 00000138 "\t\tdoit(@args);\t# pre2->pre1->doit->post1->post2"
NSQ_SOURCE_LINE 00000139 "\t}"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "\t@args = (4,5,6);"
NSQ_SOURCE_LINE 00000142 "\tdoit(@args);\t\t# pre1->doit->post1"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "Hook::LexWrap allows you to install a pre- or post-wrapper (or both)"
NSQ_SOURCE_LINE 00000147 "around an existing subroutine. Unlike other modules that provide this"
NSQ_SOURCE_LINE 00000148 "capacity (e.g. Hook::PreAndPost and Hook::WrapSub), Hook::LexWrap"
NSQ_SOURCE_LINE 00000149 "implements wrappers in such a way that the standard C<caller> function"
NSQ_SOURCE_LINE 00000150 "works correctly within the wrapped subroutine."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "To install a prewrappers, you write:"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "        use Hook::LexWrap;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "        wrap 'subroutine_name', pre => \\&some_other_sub;"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "   #or: wrap *subroutine_name,  pre => \\&some_other_sub;"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "The first argument to C<wrap> is a string containing the name of the"
NSQ_SOURCE_LINE 00000161 "subroutine to be wrapped (or the typeglob containing it, or a"
NSQ_SOURCE_LINE 00000162 "reference to it). The subroutine name may be qualified, and the"
NSQ_SOURCE_LINE 00000163 "subroutine must already be defined. The second argument indicates the"
NSQ_SOURCE_LINE 00000164 "type of wrapper being applied and must be either C<'pre'> or"
NSQ_SOURCE_LINE 00000165 "C<'post'>. The third argument must be a reference to a subroutine that"
NSQ_SOURCE_LINE 00000166 "implements the wrapper."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "To install a post-wrapper, you write:"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "        wrap 'subroutine_name', post => \\&yet_another_sub;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "   #or: wrap *subroutine_name,  post => \\&yet_another_sub;"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "To install both at once:"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "        wrap 'subroutine_name',"
NSQ_SOURCE_LINE 00000177 "             pre  => \\&some_other_sub,"
NSQ_SOURCE_LINE 00000178 "             post => \\&yet_another_sub;"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "or:"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "        wrap *subroutine_name,"
NSQ_SOURCE_LINE 00000183 "             post => \\&yet_another_sub,  # order in which wrappers are"
NSQ_SOURCE_LINE 00000184 "             pre  => \\&some_other_sub;   # specified doesn't matter"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "Once they are installed, the pre- and post-wrappers will be called before"
NSQ_SOURCE_LINE 00000187 "and after the subroutine itself, and will be passed the same argument list."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "The pre- and post-wrappers and the original subroutine also all see the same"
NSQ_SOURCE_LINE 00000190 "(correct!) values from C<caller> and C<wantarray>."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=head2 Short-circuiting and long-circuiting return values"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "The pre- and post-wrappers both receive an extra argument in their @_"
NSQ_SOURCE_LINE 00000195 "arrays. That extra argument is appended to the original argument list"
NSQ_SOURCE_LINE 00000196 "(i.e. is can always be accessed as $_[-1]) and acts as a place-holder for"
NSQ_SOURCE_LINE 00000197 "the original subroutine's return value."
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "In a pre-wrapper, $_[-1] is -- for obvious reasons -- C<undef>. However,"
NSQ_SOURCE_LINE 00000200 "$_[-1] may be assigned to in a pre-wrapper, in which case Hook::LexWrap"
NSQ_SOURCE_LINE 00000201 "assumes that the original subroutine has been \"pre-empted\", and that"
NSQ_SOURCE_LINE 00000202 "neither it, nor the corresponding post-wrapper, nor any wrappers that"
NSQ_SOURCE_LINE 00000203 "were applied I<before> the pre-empting pre-wrapper was installed, need"
NSQ_SOURCE_LINE 00000204 "be run. Note that any post-wrappers that were installed after the"
NSQ_SOURCE_LINE 00000205 "pre-empting pre-wrapper was installed I<will> still be called before the"
NSQ_SOURCE_LINE 00000206 "original subroutine call returns."
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "In a post-wrapper, $_[-1] contains the return value produced by the"
NSQ_SOURCE_LINE 00000209 "wrapped subroutine. In a scalar return context, this value is the scalar"
NSQ_SOURCE_LINE 00000210 "return value. In an list return context, this value is a reference to"
NSQ_SOURCE_LINE 00000211 "the array of return values. $_[-1] may be assigned to in a post-wrapper,"
NSQ_SOURCE_LINE 00000212 "and this changes the return value accordingly."
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "Access to the arguments and return value is useful for implementing"
NSQ_SOURCE_LINE 00000215 "techniques such as memoization:"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "        my %cache;"
NSQ_SOURCE_LINE 00000218 "        wrap fibonacci =>"
NSQ_SOURCE_LINE 00000219 "                pre  => sub { $_[-1] = $cache{$_[0]} if $cache{$_[0]} },"
NSQ_SOURCE_LINE 00000220 "                post => sub { $cache{$_[0]} = $_[-1] };"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "or for converting arguments and return values in a consistent manner:"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "\t# set_temp expects and returns degrees Fahrenheit,"
NSQ_SOURCE_LINE 00000225 "\t# but we want to use Celsius"
NSQ_SOURCE_LINE 00000226 "        wrap set_temp =>"
NSQ_SOURCE_LINE 00000227 "                pre   => sub { splice @_, 0, 1, $_[0] * 1.8 + 32 },"
NSQ_SOURCE_LINE 00000228 "                post  => sub { $_[-1] = ($_[0] - 32) / 1.8 };"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=head2 Lexically scoped wrappers"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "Normally, any wrappers installed by C<wrap> remain attached to the "
NSQ_SOURCE_LINE 00000233 "subroutine until it is undefined. However, it is possible to make"
NSQ_SOURCE_LINE 00000234 "specific wrappers lexically bound, so that they operate only until"
NSQ_SOURCE_LINE 00000235 "the end of the scope in which they're created (or until some other"
NSQ_SOURCE_LINE 00000236 "specific point in the code)."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "If C<wrap> is called in a I<non-void> context:"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "        my $lexical = wrap 'sub_name', pre => \\&wrapper;"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "it returns a special object corresponding to the particular wrapper being"
NSQ_SOURCE_LINE 00000243 "placed around the original subroutine. When that object is destroyed"
NSQ_SOURCE_LINE 00000244 "-- when its container variable goes out of scope, or when its"
NSQ_SOURCE_LINE 00000245 "reference count otherwise falls to zero (e.g. C<undef $lexical>), or "
NSQ_SOURCE_LINE 00000246 "when it is explicitly destroyed (C<$lexical-E<gt>DESTROY>) --"
NSQ_SOURCE_LINE 00000247 "the corresponding wrapper is removed from around"
NSQ_SOURCE_LINE 00000248 "the original subroutine. Note, however, that all other wrappers around the"
NSQ_SOURCE_LINE 00000249 "subroutine are preserved."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=head2 Anonymous wrappers"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "If the subroutine to be wrapped is passed as a reference (rather than by name"
NSQ_SOURCE_LINE 00000254 "or by typeglob), C<wrap> does not install the wrappers around the "
NSQ_SOURCE_LINE 00000255 "original subroutine. Instead it generates a new subroutine which acts"
NSQ_SOURCE_LINE 00000256 "as if it were the original with those wrappers around it."
NSQ_SOURCE_LINE 00000257 "It then returns a reference to that new subroutine. Only calls to the original"
NSQ_SOURCE_LINE 00000258 "through that wrapped reference invoke the wrappers. Direct by-name calls to"
NSQ_SOURCE_LINE 00000259 "the original, or calls through another reference, do not."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "If the original is subsequently wrapped by name, the anonymously wrapped"
NSQ_SOURCE_LINE 00000262 "subroutine reference does not see those wrappers. In other words,"
NSQ_SOURCE_LINE 00000263 "wrappers installed via a subroutine reference are completely independent"
NSQ_SOURCE_LINE 00000264 "of those installed via the subroutine's name (or typeglob)."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "For example:"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "        sub original { print \"ray\" }"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "        # Wrap anonymously..."
NSQ_SOURCE_LINE 00000271 "        my $anon_wrapped = wrap \\&original, pre => sub { print \"do...\" };"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "        # Show effects..."
NSQ_SOURCE_LINE 00000274 "        original();             # prints \"ray\""
NSQ_SOURCE_LINE 00000275 "        $anon_wrapped->();      # prints \"do..ray\""
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "        # Wrap nonymously..."
NSQ_SOURCE_LINE 00000278 "        wrap *original,"
NSQ_SOURCE_LINE 00000279 "                pre  => sub { print \"fa..\" },"
NSQ_SOURCE_LINE 00000280 "                post => sub { print \"..mi\" };"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "        # Show effects..."
NSQ_SOURCE_LINE 00000283 "        original();             #   now prints \"fa..ray..mi\""
NSQ_SOURCE_LINE 00000284 "        $anon_wrapped->();      # still prints \"do...ray\""
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=head1 DIAGNOSTICS"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=over"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=item C<Can't wrap non-existent subroutine %s>"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "An attempt was made to wrap a subroutine that was not defined at the"
NSQ_SOURCE_LINE 00000293 "point of wrapping."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=item C<'pre' value is not a subroutine reference>"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "The value passed to C<wrap> after the C<'pre'> flag was not"
NSQ_SOURCE_LINE 00000298 "a subroutine reference. Typically, someone forgot the C<sub> on"
NSQ_SOURCE_LINE 00000299 "the anonymous subroutine:"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "        wrap 'subname', pre => { your_code_here() };"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "and Perl interpreted the last argument as a hash constructor."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=item C<'post' value is not a subroutine reference>"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "The value passed to C<wrap> after the C<'post'> flag was not"
NSQ_SOURCE_LINE 00000308 "a subroutine reference."
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=item C<Uselessly wrapped subroutine reference in void context> (warning only)"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "When the subroutine to be wrapped is passed as a subroutine reference,"
NSQ_SOURCE_LINE 00000313 "C<wrap> does not install the wrapper around the original, but instead"
NSQ_SOURCE_LINE 00000314 "returns a reference to a subroutine which wraps the original"
NSQ_SOURCE_LINE 00000315 "(see L<Anonymous wrappers>). "
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "However, there's no point in doing this if you don't catch the resulting"
NSQ_SOURCE_LINE 00000318 "subroutine reference."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "=back"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=head1 BLAME"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "Schwern made me do this (by implying it wasn't possible ;-)"
NSQ_SOURCE_LINE 00000325 ""
