NSQ_SOURCE_LINE 00000001 "package Sub::Quote;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "sub _clean_eval { eval $_[0] }"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '2.006009';"
NSQ_SOURCE_LINE 00000009 "$VERSION =~ tr/_//d;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Sub::Defer qw(defer_sub);"
NSQ_SOURCE_LINE 00000012 "use Scalar::Util qw(weaken);"
NSQ_SOURCE_LINE 00000013 "use Exporter ();"
NSQ_SOURCE_LINE 00000014 "BEGIN { *import = \\&Exporter::import }"
NSQ_SOURCE_LINE 00000015 "use Carp qw(croak);"
NSQ_SOURCE_LINE 00000016 "BEGIN { our @CARP_NOT = qw(Sub::Defer) }"
NSQ_SOURCE_LINE 00000017 "BEGIN {"
NSQ_SOURCE_LINE 00000018 "  my $TRUE  = sub(){!!1};"
NSQ_SOURCE_LINE 00000019 "  my $FALSE = sub(){!!0};"
NSQ_SOURCE_LINE 00000020 "  *_HAVE_IS_UTF8          = defined &utf8::is_utf8 ? $TRUE : $FALSE;"
NSQ_SOURCE_LINE 00000021 "  *_CAN_TRACK_BOOLEANS    = defined &builtin::is_bool ? $TRUE : $FALSE;"
NSQ_SOURCE_LINE 00000022 "  *_CAN_TRACK_NUMBERS     = defined &builtin::created_as_number ? $TRUE : $FALSE;"
NSQ_SOURCE_LINE 00000023 "  *_HAVE_HEX_FLOAT        = !$ENV{SUB_QUOTE_NO_HEX_FLOAT} && \"$]\" >= 5.022 ? $TRUE : $FALSE;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "  # This may not be perfect, as we can't tell the format purely from the size"
NSQ_SOURCE_LINE 00000026 "  # but it should cover the common cases, and other formats are more likely to"
NSQ_SOURCE_LINE 00000027 "  # be less precise."
NSQ_SOURCE_LINE 00000028 "  my $nvsize = 8 * length pack 'F', 0;"
NSQ_SOURCE_LINE 00000029 "  my $nvmantbits"
NSQ_SOURCE_LINE 00000030 "    = $nvsize == 16   ? 11"
NSQ_SOURCE_LINE 00000031 "    : $nvsize == 32   ? 24"
NSQ_SOURCE_LINE 00000032 "    : $nvsize == 64   ? 53"
NSQ_SOURCE_LINE 00000033 "    : $nvsize == 80   ? 64"
NSQ_SOURCE_LINE 00000034 "    : $nvsize == 128  ? 113"
NSQ_SOURCE_LINE 00000035 "    : $nvsize == 256  ? 237"
NSQ_SOURCE_LINE 00000036 "                      : 237 # unknown float format"
NSQ_SOURCE_LINE 00000037 "    ;"
NSQ_SOURCE_LINE 00000038 "  my $precision = int( log(2)/log(10)*$nvmantbits );"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "  *_NVSIZE          = sub(){ $nvsize };"
NSQ_SOURCE_LINE 00000041 "  *_NVMANTBITS      = sub(){ $nvmantbits };"
NSQ_SOURCE_LINE 00000042 "  *_FLOAT_PRECISION = sub(){ $precision };"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "  local $@;"
NSQ_SOURCE_LINE 00000045 "  # if B is already loaded, just use its perlstring"
NSQ_SOURCE_LINE 00000046 "  if (\"$]\" >= 5.008_000 && \"$]\" != 5.010_000 && defined &B::perlstring) {"
NSQ_SOURCE_LINE 00000047 "    *_perlstring = \\&B::perlstring;"
NSQ_SOURCE_LINE 00000048 "  }"
NSQ_SOURCE_LINE 00000049 "  # XString is smaller than B, so prefer to use it. Buggy until 0.003."
NSQ_SOURCE_LINE 00000050 "  elsif (eval { require XString; XString->VERSION(0.003) }) {"
NSQ_SOURCE_LINE 00000051 "    *_perlstring = \\&XString::perlstring;"
NSQ_SOURCE_LINE 00000052 "  }"
NSQ_SOURCE_LINE 00000053 "  # B::perlstring in perl 5.10 handles escaping incorrectly on utf8 strings"
NSQ_SOURCE_LINE 00000054 "  elsif (\"$]\" == 5.010_000) {"
NSQ_SOURCE_LINE 00000055 "    my %escape = ("
NSQ_SOURCE_LINE 00000056 "      (map +(chr($_) => sprintf '\\x%02x', $_), 0 .. 0x31, 0x7f),"
NSQ_SOURCE_LINE 00000057 "      \"\\t\" => \"\\\\t\","
NSQ_SOURCE_LINE 00000058 "      \"\\n\" => \"\\\\n\","
NSQ_SOURCE_LINE 00000059 "      \"\\r\" => \"\\\\r\","
NSQ_SOURCE_LINE 00000060 "      \"\\f\" => \"\\\\f\","
NSQ_SOURCE_LINE 00000061 "      \"\\b\" => \"\\\\b\","
NSQ_SOURCE_LINE 00000062 "      \"\\a\" => \"\\\\a\","
NSQ_SOURCE_LINE 00000063 "      \"\\e\" => \"\\\\e\","
NSQ_SOURCE_LINE 00000064 "      (map +($_ => \"\\\\$_\"), qw(\" \\\\ $ @)),"
NSQ_SOURCE_LINE 00000065 "    );"
NSQ_SOURCE_LINE 00000066 "    *_perlstring = sub {"
NSQ_SOURCE_LINE 00000067 "      my $value = shift;"
NSQ_SOURCE_LINE 00000068 "      $value =~ s{([\"\\$\\@\\\\[:cntrl:]]|[^\\x00-\\x7f])}{"
NSQ_SOURCE_LINE 00000069 "        $escape{$1} || sprintf('\\x{%x}', ord($1))"
NSQ_SOURCE_LINE 00000070 "      }ge;"
NSQ_SOURCE_LINE 00000071 "      qq[\"$value\"];"
NSQ_SOURCE_LINE 00000072 "    };"
NSQ_SOURCE_LINE 00000073 "  }"
NSQ_SOURCE_LINE 00000074 "  elsif (\"$]\" >= 5.008_000 && eval { require B; 1 } && defined &B::perlstring ) {"
NSQ_SOURCE_LINE 00000075 "    *_perlstring = \\&B::perlstring;"
NSQ_SOURCE_LINE 00000076 "  }"
NSQ_SOURCE_LINE 00000077 "  # on perl 5.6, perlstring is not available. quotemeta will mostly serve as a"
NSQ_SOURCE_LINE 00000078 "  # replacement. it quotes just by adding lots of backslashes though. if a"
NSQ_SOURCE_LINE 00000079 "  # utf8 string was written out directly as bytes, it wouldn't get interpreted"
NSQ_SOURCE_LINE 00000080 "  # correctly if not under 'use utf8'. this is mostly a theoretical concern,"
NSQ_SOURCE_LINE 00000081 "  # but enough to stick with perlstring when possible."
NSQ_SOURCE_LINE 00000082 "  else {"
NSQ_SOURCE_LINE 00000083 "    *_perlstring = sub { qq[\"\\Q$_[0]\\E\"] };"
NSQ_SOURCE_LINE 00000084 "  }"
NSQ_SOURCE_LINE 00000085 "}"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "our @EXPORT = qw(quote_sub unquote_sub quoted_from_sub qsub);"
NSQ_SOURCE_LINE 00000088 "our @EXPORT_OK = qw(quotify capture_unroll inlinify sanitize_identifier);"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "our %QUOTED;"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "sub quotify {"
NSQ_SOURCE_LINE 00000093 "  my $value = $_[0];"
NSQ_SOURCE_LINE 00000094 "  no warnings 'numeric';"
NSQ_SOURCE_LINE 00000095 "  BEGIN {"
NSQ_SOURCE_LINE 00000096 "    warnings->unimport(qw(experimental::builtin))"
NSQ_SOURCE_LINE 00000097 "      if _CAN_TRACK_BOOLEANS || _CAN_TRACK_NUMBERS;"
NSQ_SOURCE_LINE 00000098 "  }"
NSQ_SOURCE_LINE 00000099 "  ! defined $value     ? 'undef()'"
NSQ_SOURCE_LINE 00000100 "  : _CAN_TRACK_BOOLEANS && builtin::is_bool($value) ? ("
NSQ_SOURCE_LINE 00000101 "    $value ? '(!!1)' : '(!!0)'"
NSQ_SOURCE_LINE 00000102 "  )"
NSQ_SOURCE_LINE 00000103 "  # numeric detection"
NSQ_SOURCE_LINE 00000104 "  : ("
NSQ_SOURCE_LINE 00000105 "    _CAN_TRACK_NUMBERS"
NSQ_SOURCE_LINE 00000106 "      ? builtin::created_as_number($value)"
NSQ_SOURCE_LINE 00000107 "      : ("
NSQ_SOURCE_LINE 00000108 "        !(_HAVE_IS_UTF8 && utf8::is_utf8($value))"
NSQ_SOURCE_LINE 00000109 "        && length( (my $dummy = '') & $value )"
NSQ_SOURCE_LINE 00000110 "        && 0 + $value eq $value"
NSQ_SOURCE_LINE 00000111 "      )"
NSQ_SOURCE_LINE 00000112 "  ) ? ("
NSQ_SOURCE_LINE 00000113 "    $value != $value ? ("
NSQ_SOURCE_LINE 00000114 "      $value eq (9**9**9*0)"
NSQ_SOURCE_LINE 00000115 "        ? '(9**9**9*0)'    # nan"
NSQ_SOURCE_LINE 00000116 "        : '(-(9**9**9*0))' # -nan"
NSQ_SOURCE_LINE 00000117 "    )"
NSQ_SOURCE_LINE 00000118 "    : $value == 9**9**9  ? '(9**9**9)'     # inf"
NSQ_SOURCE_LINE 00000119 "    : $value == -9**9**9 ? '(-9**9**9)'    # -inf"
NSQ_SOURCE_LINE 00000120 "    : $value == 0 ? ("
NSQ_SOURCE_LINE 00000121 "      sprintf('%g', $value) eq '-0' ? '-0.0' : '0',"
NSQ_SOURCE_LINE 00000122 "    )"
NSQ_SOURCE_LINE 00000123 "    : $value !~ /[e.]/i ? ("
NSQ_SOURCE_LINE 00000124 "      $value > 0 ? (sprintf '%u', $value)"
NSQ_SOURCE_LINE 00000125 "                 : (sprintf '%d', $value)"
NSQ_SOURCE_LINE 00000126 "    )"
NSQ_SOURCE_LINE 00000127 "    : do {"
NSQ_SOURCE_LINE 00000128 "      my $float = $value;"
NSQ_SOURCE_LINE 00000129 "      my $max_factor = int( log( abs($value) ) / log(2) ) - _NVMANTBITS;"
NSQ_SOURCE_LINE 00000130 "      my $ex_sign = $max_factor > 0 ? 1 : -1;"
NSQ_SOURCE_LINE 00000131 "      FACTOR: for my $ex (0 .. abs($max_factor)) {"
NSQ_SOURCE_LINE 00000132 "        my $num = $value / 2**($ex_sign * $ex);"
NSQ_SOURCE_LINE 00000133 "        for my $precision (_FLOAT_PRECISION .. _FLOAT_PRECISION+2) {"
NSQ_SOURCE_LINE 00000134 "          my $formatted = sprintf '%0.'.$precision.'g', $num;"
NSQ_SOURCE_LINE 00000135 "          $float = $formatted"
NSQ_SOURCE_LINE 00000136 "            if $ex == 0;"
NSQ_SOURCE_LINE 00000137 "          if ($formatted == $num) {"
NSQ_SOURCE_LINE 00000138 "            if ($ex) {"
NSQ_SOURCE_LINE 00000139 "              $float"
NSQ_SOURCE_LINE 00000140 "                = $formatted"
NSQ_SOURCE_LINE 00000141 "                . ($ex_sign == 1 ? '*' : '/')"
NSQ_SOURCE_LINE 00000142 "                . ("
NSQ_SOURCE_LINE 00000143 "                  $ex > _NVMANTBITS"
NSQ_SOURCE_LINE 00000144 "                    ? \"2**$ex\""
NSQ_SOURCE_LINE 00000145 "                    : sprintf('%u', 2**$ex)"
NSQ_SOURCE_LINE 00000146 "                );"
NSQ_SOURCE_LINE 00000147 "            }"
NSQ_SOURCE_LINE 00000148 "            last FACTOR;"
NSQ_SOURCE_LINE 00000149 "          }"
NSQ_SOURCE_LINE 00000150 "        }"
NSQ_SOURCE_LINE 00000151 "        if (_HAVE_HEX_FLOAT) {"
NSQ_SOURCE_LINE 00000152 "          $float = sprintf '%a', $value;"
NSQ_SOURCE_LINE 00000153 "          last FACTOR;"
NSQ_SOURCE_LINE 00000154 "        }"
NSQ_SOURCE_LINE 00000155 "      }"
NSQ_SOURCE_LINE 00000156 "      \"$float\";"
NSQ_SOURCE_LINE 00000157 "    }"
NSQ_SOURCE_LINE 00000158 "  )"
NSQ_SOURCE_LINE 00000159 "  : !_CAN_TRACK_BOOLEANS && !length($value) && length( (my $dummy2 = '') & $value ) ? '(!!0)' # false"
NSQ_SOURCE_LINE 00000160 "  : _perlstring($value);"
NSQ_SOURCE_LINE 00000161 "}"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "sub sanitize_identifier {"
NSQ_SOURCE_LINE 00000164 "  my $name = shift;"
NSQ_SOURCE_LINE 00000165 "  $name =~ s/([_\\W])/sprintf('_%x', ord($1))/ge;"
NSQ_SOURCE_LINE 00000166 "  $name;"
NSQ_SOURCE_LINE 00000167 "}"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "sub capture_unroll {"
NSQ_SOURCE_LINE 00000170 "  my ($from, $captures, $indent) = @_;"
NSQ_SOURCE_LINE 00000171 "  join("
NSQ_SOURCE_LINE 00000172 "    '',"
NSQ_SOURCE_LINE 00000173 "    map {"
NSQ_SOURCE_LINE 00000174 "      /^([\\@\\%\\$])/"
NSQ_SOURCE_LINE 00000175 "        or croak \"capture key should start with \\@, \\% or \\$: $_\";"
NSQ_SOURCE_LINE 00000176 "      (' ' x $indent).qq{my ${_} = ${1}{${from}->{${\\quotify $_}}};\\n};"
NSQ_SOURCE_LINE 00000177 "    } keys %$captures"
NSQ_SOURCE_LINE 00000178 "  );"
NSQ_SOURCE_LINE 00000179 "}"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "sub inlinify {"
NSQ_SOURCE_LINE 00000182 "  my ($code, $args, $extra, $local) = @_;"
NSQ_SOURCE_LINE 00000183 "  $args = '()'"
NSQ_SOURCE_LINE 00000184 "    if !defined $args;"
NSQ_SOURCE_LINE 00000185 "  my $do = 'do { '.($extra||'');"
NSQ_SOURCE_LINE 00000186 "  if ($code =~ s/^(\\s*package\\s+([a-zA-Z0-9:]+);)//) {"
NSQ_SOURCE_LINE 00000187 "    $do .= $1;"
NSQ_SOURCE_LINE 00000188 "  }"
NSQ_SOURCE_LINE 00000189 "  if ($code =~ s{"
NSQ_SOURCE_LINE 00000190 "    \\A((?:\\#\\ BEGIN\\ quote_sub\\ PRELUDE\\n.*?\\#\\ END\\ quote_sub\\ PRELUDE\\n)?\\s*)"
NSQ_SOURCE_LINE 00000191 "    (^\\s*) my \\s* \\(([^)]+)\\) \\s* = \\s* \\@_;"
NSQ_SOURCE_LINE 00000192 "  }{}xms) {"
NSQ_SOURCE_LINE 00000193 "    my ($pre, $indent, $code_args) = ($1, $2, $3);"
NSQ_SOURCE_LINE 00000194 "    $do .= $pre;"
NSQ_SOURCE_LINE 00000195 "    if ($code_args ne $args) {"
NSQ_SOURCE_LINE 00000196 "      $do .= $indent . 'my ('.$code_args.') = ('.$args.'); ';"
NSQ_SOURCE_LINE 00000197 "    }"
NSQ_SOURCE_LINE 00000198 "  }"
NSQ_SOURCE_LINE 00000199 "  elsif ($local || $args ne '@_') {"
NSQ_SOURCE_LINE 00000200 "    $do .= ($local ? 'local ' : '').'@_ = ('.$args.'); ';"
NSQ_SOURCE_LINE 00000201 "  }"
NSQ_SOURCE_LINE 00000202 "  $do.$code.' }';"
NSQ_SOURCE_LINE 00000203 "}"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "sub quote_sub {"
NSQ_SOURCE_LINE 00000206 "  # HOLY DWIMMERY, BATMAN!"
NSQ_SOURCE_LINE 00000207 "  # $name => $code => \\%captures => \\%options"
NSQ_SOURCE_LINE 00000208 "  # $name => $code => \\%captures"
NSQ_SOURCE_LINE 00000209 "  # $name => $code"
NSQ_SOURCE_LINE 00000210 "  # $code => \\%captures => \\%options"
NSQ_SOURCE_LINE 00000211 "  # $code"
NSQ_SOURCE_LINE 00000212 "  my $options ="
NSQ_SOURCE_LINE 00000213 "    (ref($_[-1]) eq 'HASH' and ref($_[-2]) eq 'HASH')"
NSQ_SOURCE_LINE 00000214 "      ? pop"
NSQ_SOURCE_LINE 00000215 "      : {};"
NSQ_SOURCE_LINE 00000216 "  my $captures = ref($_[-1]) eq 'HASH' ? pop : undef;"
NSQ_SOURCE_LINE 00000217 "  undef($captures) if $captures && !keys %$captures;"
NSQ_SOURCE_LINE 00000218 "  my $code = pop;"
NSQ_SOURCE_LINE 00000219 "  my $name = $_[0];"
NSQ_SOURCE_LINE 00000220 "  if ($name) {"
NSQ_SOURCE_LINE 00000221 "    my $subname = $name;"
NSQ_SOURCE_LINE 00000222 "    my $package = $subname =~ s/(.*)::// ? $1 : caller;"
NSQ_SOURCE_LINE 00000223 "    $name = join '::', $package, $subname;"
NSQ_SOURCE_LINE 00000224 "    croak qq{package name \"$package\" too long!}"
NSQ_SOURCE_LINE 00000225 "      if length $package > 252;"
NSQ_SOURCE_LINE 00000226 "    croak qq{package name \"$package\" is not valid!}"
NSQ_SOURCE_LINE 00000227 "      unless $package =~ /^[^\\d\\W]\\w*(?:::\\w+)*$/;"
NSQ_SOURCE_LINE 00000228 "    croak qq{sub name \"$subname\" too long!}"
NSQ_SOURCE_LINE 00000229 "      if length $subname > 252;"
NSQ_SOURCE_LINE 00000230 "    croak qq{sub name \"$subname\" is not valid!}"
NSQ_SOURCE_LINE 00000231 "      unless $subname =~ /^[^\\d\\W]\\w*$/;"
NSQ_SOURCE_LINE 00000232 "  }"
NSQ_SOURCE_LINE 00000233 "  my @caller = caller(0);"
NSQ_SOURCE_LINE 00000234 "  my ($attributes, $file, $line) = @{$options}{qw(attributes file line)};"
NSQ_SOURCE_LINE 00000235 "  if ($attributes) {"
NSQ_SOURCE_LINE 00000236 "    /\\A\\w+(?:\\(.*\\))?\\z/s || croak \"invalid attribute $_\""
NSQ_SOURCE_LINE 00000237 "      for @$attributes;"
NSQ_SOURCE_LINE 00000238 "  }"
NSQ_SOURCE_LINE 00000239 "  my $quoted_info = {"
NSQ_SOURCE_LINE 00000240 "    name     => $name,"
NSQ_SOURCE_LINE 00000241 "    code     => $code,"
NSQ_SOURCE_LINE 00000242 "    captures => $captures,"
NSQ_SOURCE_LINE 00000243 "    package      => (exists $options->{package}      ? $options->{package}      : $caller[0]),"
NSQ_SOURCE_LINE 00000244 "    hints        => (exists $options->{hints}        ? $options->{hints}        : $caller[8]),"
NSQ_SOURCE_LINE 00000245 "    warning_bits => (exists $options->{warning_bits} ? $options->{warning_bits} : $caller[9]),"
NSQ_SOURCE_LINE 00000246 "    hintshash    => (exists $options->{hintshash}    ? $options->{hintshash}    : $caller[10]),"
NSQ_SOURCE_LINE 00000247 "    ($attributes ? (attributes => $attributes) : ()),"
NSQ_SOURCE_LINE 00000248 "    ($file       ? (file => $file) : ()),"
NSQ_SOURCE_LINE 00000249 "    ($line       ? (line => $line) : ()),"
NSQ_SOURCE_LINE 00000250 "  };"
NSQ_SOURCE_LINE 00000251 "  my $unquoted;"
NSQ_SOURCE_LINE 00000252 "  weaken($quoted_info->{unquoted} = \\$unquoted);"
NSQ_SOURCE_LINE 00000253 "  if ($options->{no_defer}) {"
NSQ_SOURCE_LINE 00000254 "    my $fake = \\my $var;"
NSQ_SOURCE_LINE 00000255 "    local $QUOTED{$fake} = $quoted_info;"
NSQ_SOURCE_LINE 00000256 "    my $sub = unquote_sub($fake);"
NSQ_SOURCE_LINE 00000257 "    Sub::Defer::_install_coderef($name, $sub) if $name && !$options->{no_install};"
NSQ_SOURCE_LINE 00000258 "    return $sub;"
NSQ_SOURCE_LINE 00000259 "  }"
NSQ_SOURCE_LINE 00000260 "  else {"
NSQ_SOURCE_LINE 00000261 "    my $deferred = defer_sub("
NSQ_SOURCE_LINE 00000262 "      ($options->{no_install} ? undef : $name),"
NSQ_SOURCE_LINE 00000263 "      sub {"
NSQ_SOURCE_LINE 00000264 "        $unquoted if 0;"
NSQ_SOURCE_LINE 00000265 "        unquote_sub($quoted_info->{deferred});"
NSQ_SOURCE_LINE 00000266 "      },"
NSQ_SOURCE_LINE 00000267 "      {"
NSQ_SOURCE_LINE 00000268 "        ($attributes ? ( attributes => $attributes ) : ()),"
NSQ_SOURCE_LINE 00000269 "        ($name ? () : ( package => $quoted_info->{package} )),"
NSQ_SOURCE_LINE 00000270 "      },"
NSQ_SOURCE_LINE 00000271 "    );"
NSQ_SOURCE_LINE 00000272 "    weaken($quoted_info->{deferred} = $deferred);"
NSQ_SOURCE_LINE 00000273 "    weaken($QUOTED{$deferred} = $quoted_info);"
NSQ_SOURCE_LINE 00000274 "    return $deferred;"
NSQ_SOURCE_LINE 00000275 "  }"
NSQ_SOURCE_LINE 00000276 "}"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "sub _context {"
NSQ_SOURCE_LINE 00000279 "  my $info = shift;"
NSQ_SOURCE_LINE 00000280 "  $info->{context} ||= do {"
NSQ_SOURCE_LINE 00000281 "    my ($package, $hints, $warning_bits, $hintshash, $file, $line)"
NSQ_SOURCE_LINE 00000282 "      = @{$info}{qw(package hints warning_bits hintshash file line)};"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    $line ||= 1"
NSQ_SOURCE_LINE 00000285 "      if $file;"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    my $line_mark = '';"
NSQ_SOURCE_LINE 00000288 "    if ($line) {"
NSQ_SOURCE_LINE 00000289 "      $line_mark = \"#line \".($line-1);"
NSQ_SOURCE_LINE 00000290 "      if ($file) {"
NSQ_SOURCE_LINE 00000291 "        $line_mark .= qq{ \"$file\"};"
NSQ_SOURCE_LINE 00000292 "      }"
NSQ_SOURCE_LINE 00000293 "      $line_mark .= \"\\n\";"
NSQ_SOURCE_LINE 00000294 "    }"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "    $info->{context}"
NSQ_SOURCE_LINE 00000297 "      =\"# BEGIN quote_sub PRELUDE\\n\""
NSQ_SOURCE_LINE 00000298 "      .\"package $package;\\n\""
NSQ_SOURCE_LINE 00000299 "      .\"BEGIN {\\n\""
NSQ_SOURCE_LINE 00000300 "      .\"  \\$^H = \".quotify($hints).\";\\n\""
NSQ_SOURCE_LINE 00000301 "      .\"  \\${^WARNING_BITS} = \".quotify($warning_bits).\";\\n\""
NSQ_SOURCE_LINE 00000302 "      .\"  \\%^H = (\\n\""
NSQ_SOURCE_LINE 00000303 "      . join('', map"
NSQ_SOURCE_LINE 00000304 "      \"    \".quotify($_).\" => \".quotify($hintshash->{$_}).\",\\n\","
NSQ_SOURCE_LINE 00000305 "        grep !(ref $hintshash->{$_} && $hintshash->{$_} =~ /\\A(?:\\w+(?:::\\w+)*=)?[A-Z]+\\(0x[[0-9a-fA-F]+\\)\\z/),"
NSQ_SOURCE_LINE 00000306 "        keys %$hintshash)"
NSQ_SOURCE_LINE 00000307 "      .\"  );\\n\""
NSQ_SOURCE_LINE 00000308 "      .\"}\\n\""
NSQ_SOURCE_LINE 00000309 "      .$line_mark"
NSQ_SOURCE_LINE 00000310 "      .\"# END quote_sub PRELUDE\\n\";"
NSQ_SOURCE_LINE 00000311 "  };"
NSQ_SOURCE_LINE 00000312 "}"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "sub quoted_from_sub {"
NSQ_SOURCE_LINE 00000315 "  my ($sub) = @_;"
NSQ_SOURCE_LINE 00000316 "  my $quoted_info = $QUOTED{$sub||''} or return undef;"
NSQ_SOURCE_LINE 00000317 "  my ($name, $code, $captures, $unquoted, $deferred)"
NSQ_SOURCE_LINE 00000318 "    = @{$quoted_info}{qw(name code captures unquoted deferred)};"
NSQ_SOURCE_LINE 00000319 "  $code = _context($quoted_info) . $code;"
NSQ_SOURCE_LINE 00000320 "  $unquoted &&= $$unquoted;"
NSQ_SOURCE_LINE 00000321 "  if (($deferred && $deferred eq $sub)"
NSQ_SOURCE_LINE 00000322 "      || ($unquoted && $unquoted eq $sub)) {"
NSQ_SOURCE_LINE 00000323 "    return [ $name, $code, $captures, $unquoted, $deferred ];"
NSQ_SOURCE_LINE 00000324 "  }"
NSQ_SOURCE_LINE 00000325 "  return undef;"
NSQ_SOURCE_LINE 00000326 "}"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "sub unquote_sub {"
NSQ_SOURCE_LINE 00000329 "  my ($sub) = @_;"
NSQ_SOURCE_LINE 00000330 "  my $quoted_info = $QUOTED{$sub} or return undef;"
NSQ_SOURCE_LINE 00000331 "  my $unquoted = $quoted_info->{unquoted};"
NSQ_SOURCE_LINE 00000332 "  unless ($unquoted && $$unquoted) {"
NSQ_SOURCE_LINE 00000333 "    my ($name, $code, $captures, $package, $attributes)"
NSQ_SOURCE_LINE 00000334 "      = @{$quoted_info}{qw(name code captures package attributes)};"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "    ($package, $name) = $name =~ /(.*)::(.*)/"
NSQ_SOURCE_LINE 00000337 "      if $name;"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "    my %captures = $captures ? %$captures : ();"
NSQ_SOURCE_LINE 00000340 "    $captures{'$_UNQUOTED'} = \\$unquoted;"
NSQ_SOURCE_LINE 00000341 "    $captures{'$_QUOTED'} = \\$quoted_info;"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "    my $make_sub"
NSQ_SOURCE_LINE 00000344 "      = \"{\\n\""
NSQ_SOURCE_LINE 00000345 "      . capture_unroll(\"\\$_[1]\", \\%captures, 2)"
NSQ_SOURCE_LINE 00000346 "      . \"  package ${package};\\n\""
NSQ_SOURCE_LINE 00000347 "      . ("
NSQ_SOURCE_LINE 00000348 "        $name"
NSQ_SOURCE_LINE 00000349 "          # disable the 'variable $x will not stay shared' warning since"
NSQ_SOURCE_LINE 00000350 "          # we're not letting it escape from this scope anyway so there's"
NSQ_SOURCE_LINE 00000351 "          # nothing trying to share it"
NSQ_SOURCE_LINE 00000352 "          ? \"  no warnings 'closure';\\n  sub ${name} \""
NSQ_SOURCE_LINE 00000353 "          : \"  \\$\\$_UNQUOTED = sub \""
NSQ_SOURCE_LINE 00000354 "      )"
NSQ_SOURCE_LINE 00000355 "      . ($attributes ? join('', map \":$_ \", @$attributes) : '') . \"{\\n\""
NSQ_SOURCE_LINE 00000356 "      . \"  (\\$_QUOTED,\\$_UNQUOTED) if 0;\\n\""
NSQ_SOURCE_LINE 00000357 "      . _context($quoted_info)"
NSQ_SOURCE_LINE 00000358 "      . $code"
NSQ_SOURCE_LINE 00000359 "      . \"  }\".($name ? \"\\n  \\$\\$_UNQUOTED = \\\\&${name}\" : '') . \";\\n\""
NSQ_SOURCE_LINE 00000360 "      . \"}\\n\""
NSQ_SOURCE_LINE 00000361 "      . \"1;\\n\";"
NSQ_SOURCE_LINE 00000362 "    if (my $debug = $ENV{SUB_QUOTE_DEBUG}) {"
NSQ_SOURCE_LINE 00000363 "      if ($debug =~ m{^([^\\W\\d]\\w*(?:::\\w+)*(?:::)?)$}) {"
NSQ_SOURCE_LINE 00000364 "        my $filter = $1;"
NSQ_SOURCE_LINE 00000365 "        my $match"
NSQ_SOURCE_LINE 00000366 "          = $filter =~ /::$/ ? $package.'::'"
NSQ_SOURCE_LINE 00000367 "          : $filter =~ /::/  ? $package.'::'.($name||'__ANON__')"
NSQ_SOURCE_LINE 00000368 "          : ($name||'__ANON__');"
NSQ_SOURCE_LINE 00000369 "        warn $make_sub"
NSQ_SOURCE_LINE 00000370 "          if $match eq $filter;"
NSQ_SOURCE_LINE 00000371 "      }"
NSQ_SOURCE_LINE 00000372 "      elsif ($debug =~ m{\\A/(.*)/\\z}s) {"
NSQ_SOURCE_LINE 00000373 "        my $filter = $1;"
NSQ_SOURCE_LINE 00000374 "        warn $make_sub"
NSQ_SOURCE_LINE 00000375 "          if $code =~ $filter;"
NSQ_SOURCE_LINE 00000376 "      }"
NSQ_SOURCE_LINE 00000377 "      else {"
NSQ_SOURCE_LINE 00000378 "        warn $make_sub;"
NSQ_SOURCE_LINE 00000379 "      }"
NSQ_SOURCE_LINE 00000380 "    }"
NSQ_SOURCE_LINE 00000381 "    {"
NSQ_SOURCE_LINE 00000382 "      no strict 'refs';"
NSQ_SOURCE_LINE 00000383 "      local *{\"${package}::${name}\"} if $name;"
NSQ_SOURCE_LINE 00000384 "      my ($success, $e);"
NSQ_SOURCE_LINE 00000385 "      {"
NSQ_SOURCE_LINE 00000386 "        local $@;"
NSQ_SOURCE_LINE 00000387 "        $success = _clean_eval($make_sub, \\%captures);"
NSQ_SOURCE_LINE 00000388 "        $e = $@;"
NSQ_SOURCE_LINE 00000389 "      }"
NSQ_SOURCE_LINE 00000390 "      unless ($success) {"
NSQ_SOURCE_LINE 00000391 "        my $space = length($make_sub =~ tr/\\n//);"
NSQ_SOURCE_LINE 00000392 "        my $line = 0;"
NSQ_SOURCE_LINE 00000393 "        $make_sub =~ s/^/sprintf \"%${space}d: \", ++$line/emg;"
NSQ_SOURCE_LINE 00000394 "        croak \"Eval went very, very wrong:\\n\\n${make_sub}\\n\\n$e\";"
NSQ_SOURCE_LINE 00000395 "      }"
NSQ_SOURCE_LINE 00000396 "      weaken($QUOTED{$$unquoted} = $quoted_info);"
NSQ_SOURCE_LINE 00000397 "    }"
NSQ_SOURCE_LINE 00000398 "  }"
NSQ_SOURCE_LINE 00000399 "  $$unquoted;"
NSQ_SOURCE_LINE 00000400 "}"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "sub qsub ($) {"
NSQ_SOURCE_LINE 00000403 "  goto &quote_sub;"
NSQ_SOURCE_LINE 00000404 "}"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "sub CLONE {"
NSQ_SOURCE_LINE 00000407 "  my @quoted = map { defined $_ ? ("
NSQ_SOURCE_LINE 00000408 "    $_->{unquoted} && ${$_->{unquoted}} ? (${ $_->{unquoted} } => $_) : (),"
NSQ_SOURCE_LINE 00000409 "    $_->{deferred} ? ($_->{deferred} => $_) : (),"
NSQ_SOURCE_LINE 00000410 "  ) : () } values %QUOTED;"
NSQ_SOURCE_LINE 00000411 "  %QUOTED = @quoted;"
NSQ_SOURCE_LINE 00000412 "  weaken($_) for values %QUOTED;"
NSQ_SOURCE_LINE 00000413 "}"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "1;"
NSQ_SOURCE_LINE 00000416 "__END__"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "=encoding utf-8"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "=head1 NAME"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "Sub::Quote - Efficient generation of subroutines via string eval"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 " package Silly;"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 " use Sub::Quote qw(quote_sub unquote_sub quoted_from_sub);"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 " quote_sub 'Silly::kitty', q{ print \"meow\" };"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 " quote_sub 'Silly::doggy', q{ print \"woof\" };"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 " my $sound = 0;"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 " quote_sub 'Silly::dagron',"
NSQ_SOURCE_LINE 00000437 "   q{ print ++$sound % 2 ? 'burninate' : 'roar' },"
NSQ_SOURCE_LINE 00000438 "   { '$sound' => \\$sound };"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "And elsewhere:"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 " Silly->kitty;  # meow"
NSQ_SOURCE_LINE 00000443 " Silly->doggy;  # woof"
NSQ_SOURCE_LINE 00000444 " Silly->dagron; # burninate"
NSQ_SOURCE_LINE 00000445 " Silly->dagron; # roar"
NSQ_SOURCE_LINE 00000446 " Silly->dagron; # burninate"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "This package provides performant ways to generate subroutines from strings."
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "=head1 SUBROUTINES"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "=head2 quote_sub"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 " my $coderef = quote_sub 'Foo::bar', q{ print $x++ . \"\\n\" }, { '$x' => \\0 };"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "Arguments: ?$name, $code, ?\\%captures, ?\\%options"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "C<$name> is the subroutine where the coderef will be installed."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "C<$code> is a string that will be turned into code."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "C<\\%captures> is a hashref of variables that will be made available to the"
NSQ_SOURCE_LINE 00000465 "code.  The keys should be the full name of the variable to be made available,"
NSQ_SOURCE_LINE 00000466 "including the sigil.  The values should be references to the values.  The"
NSQ_SOURCE_LINE 00000467 "variables will contain copies of the values.  See the L</SYNOPSIS>'s"
NSQ_SOURCE_LINE 00000468 "C<Silly::dagron> for an example using captures."
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "Exported by default."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=head3 options"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=over 2"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "=item C<no_install>"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "B<Boolean>.  Set this option to not install the generated coderef into the"
NSQ_SOURCE_LINE 00000479 "passed subroutine name on undefer."
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "=item C<no_defer>"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "B<Boolean>.  Prevents a Sub::Defer wrapper from being generated for the quoted"
NSQ_SOURCE_LINE 00000484 "sub.  If the sub will most likely be called at some point, setting this is a"
NSQ_SOURCE_LINE 00000485 "good idea.  For a sub that will most likely be inlined, it is not recommended."
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=item C<package>"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "The package that the quoted sub will be evaluated in.  If not specified, the"
NSQ_SOURCE_LINE 00000490 "package from sub calling C<quote_sub> will be used."
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "=item C<hints>"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "The value of L<< C<$^H> | perlvar/$^H >> to use for the code being evaluated."
NSQ_SOURCE_LINE 00000495 "This captures the settings of the L<strict> pragma.  If not specified, the value"
NSQ_SOURCE_LINE 00000496 "from the calling code will be used."
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "=item C<warning_bits>"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "The value of L<< C<${^WARNING_BITS}> | perlvar/${^WARNING_BITS} >> to use for"
NSQ_SOURCE_LINE 00000501 "the code being evaluated.  This captures the L<warnings> set.  If not specified,"
NSQ_SOURCE_LINE 00000502 "the warnings from the calling code will be used."
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "=item C<hintshash>"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "The value of L<< C<%^H> | perlvar/%^H >> to use for the code being evaluated."
NSQ_SOURCE_LINE 00000507 "This captures additional pragma settings.  If not specified, the value from the"
NSQ_SOURCE_LINE 00000508 "calling code will be used if possible (on perl 5.10+)."
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "=item C<attributes>"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "The L<perlsub/Subroutine Attributes> to apply to the sub generated.  Should be"
NSQ_SOURCE_LINE 00000513 "specified as an array reference.  The attributes will be applied to both the"
NSQ_SOURCE_LINE 00000514 "generated sub and the deferred wrapper, if one is used."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=item C<file>"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "The apparent filename to use for the code being evaluated."
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=item C<line>"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "The apparent line number"
NSQ_SOURCE_LINE 00000523 "to use for the code being evaluated."
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "=back"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "=head2 unquote_sub"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 " my $coderef = unquote_sub $sub;"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "Forcibly replace subroutine with actual code."
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "If $sub is not a quoted sub, this is a no-op."
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "Exported by default."
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "=head2 quoted_from_sub"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 " my $data = quoted_from_sub $sub;"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 " my ($name, $code, $captures, $compiled_sub) = @$data;"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "Returns original arguments to quote_sub, plus the compiled version if this"
NSQ_SOURCE_LINE 00000544 "sub has already been unquoted."
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "Note that $sub can be either the original quoted version or the compiled"
NSQ_SOURCE_LINE 00000547 "version for convenience."
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "Exported by default."
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "=head2 inlinify"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 " my $prelude = capture_unroll '$captures', {"
NSQ_SOURCE_LINE 00000554 "   '$x' => 1,"
NSQ_SOURCE_LINE 00000555 "   '$y' => 2,"
NSQ_SOURCE_LINE 00000556 " }, 4;"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 " my $inlined_code = inlinify q{"
NSQ_SOURCE_LINE 00000559 "   my ($x, $y) = @_;"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "   print $x + $y . \"\\n\";"
NSQ_SOURCE_LINE 00000562 " }, '$x, $y', $prelude;"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "Takes a string of code, a string of arguments, a string of code which acts as a"
NSQ_SOURCE_LINE 00000565 "\"prelude\", and a B<Boolean> representing whether or not to localize the"
NSQ_SOURCE_LINE 00000566 "arguments."
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "=head2 quotify"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 " my $quoted_value = quotify $value;"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "Quotes a single (non-reference) scalar value for use in a code string.  The"
NSQ_SOURCE_LINE 00000573 "result should reproduce the original value, including strings, undef, integers,"
NSQ_SOURCE_LINE 00000574 "and floating point numbers.  The resulting floating point numbers (including"
NSQ_SOURCE_LINE 00000575 "infinites and not a number) should be precisely equal to the original, if"
NSQ_SOURCE_LINE 00000576 "possible.  The exact format of the resulting number should not be relied on, as"
NSQ_SOURCE_LINE 00000577 "it may include hex floats or math expressions."
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "=head2 capture_unroll"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 " my $prelude = capture_unroll '$captures', {"
NSQ_SOURCE_LINE 00000582 "   '$x' => 1,"
NSQ_SOURCE_LINE 00000583 "   '$y' => 2,"
NSQ_SOURCE_LINE 00000584 " }, 4;"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "Arguments: $from, \\%captures, $indent"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "Generates a snippet of code which is suitable to be used as a prelude for"
NSQ_SOURCE_LINE 00000589 "L</inlinify>.  C<$from> is a string will be used as a hashref in the resulting"
NSQ_SOURCE_LINE 00000590 "code.  The keys of C<%captures> are the names of the variables and the values"
NSQ_SOURCE_LINE 00000591 "are ignored.  C<$indent> is the number of spaces to indent the result by."
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=head2 qsub"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 " my $hash = {"
NSQ_SOURCE_LINE 00000596 "  coderef => qsub q{ print \"hello\"; },"
NSQ_SOURCE_LINE 00000597 "  other   => 5,"
NSQ_SOURCE_LINE 00000598 " };"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "Arguments: $code"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "Works exactly like L</quote_sub>, but includes a prototype to only accept a"
NSQ_SOURCE_LINE 00000603 "single parameter.  This makes it easier to include in hash structures or lists."
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "Exported by default."
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "=head2 sanitize_identifier"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 " my $var_name = '$variable_for_' . sanitize_identifier('@name');"
NSQ_SOURCE_LINE 00000610 " quote_sub qq{ print \\$${var_name} }, { $var_name => \\$value };"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "Arguments: $identifier"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "Sanitizes a value so that it can be used in an identifier."
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "=head2 SUB_QUOTE_DEBUG"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "Causes code to be output to C<STDERR> before being evaled.  Several forms are"
NSQ_SOURCE_LINE 00000621 "supported:"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "=over 4"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "=item C<1>"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "All subs will be output."
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "=item C</foo/>"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "Subs will be output if their code matches the given regular expression."
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "=item C<simple_identifier>"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "Any sub with the given name will be output."
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "=item C<Full::identifier>"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "A sub matching the full name will be output."
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "=item C<Package::Name::>"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "Any sub in the given package (including anonymous subs) will be output."
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "=back"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "Much of this is just string-based code-generation, and as a result, a few"
NSQ_SOURCE_LINE 00000650 "caveats apply."
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "=head2 return"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "Calling C<return> from a quote_sub'ed sub will not likely do what you intend."
NSQ_SOURCE_LINE 00000655 "Instead of returning from the code you defined in C<quote_sub>, it will return"
NSQ_SOURCE_LINE 00000656 "from the overall function it is composited into."
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "So when you pass in:"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "   quote_sub q{  return 1 if $condition; $morecode }"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "It might turn up in the intended context as follows:"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "  sub foo {"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "    <important code a>"
NSQ_SOURCE_LINE 00000667 "    do {"
NSQ_SOURCE_LINE 00000668 "      return 1 if $condition;"
NSQ_SOURCE_LINE 00000669 "      $morecode"
NSQ_SOURCE_LINE 00000670 "    };"
NSQ_SOURCE_LINE 00000671 "    <important code b>"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "  }"
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "Which will obviously return from foo, when all you meant to do was return from"
NSQ_SOURCE_LINE 00000676 "the code context in quote_sub and proceed with running important code b."
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "=head2 pragmas"
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "C<Sub::Quote> preserves the environment of the code creating the"
NSQ_SOURCE_LINE 00000681 "quoted subs.  This includes the package, strict, warnings, and any"
NSQ_SOURCE_LINE 00000682 "other lexical pragmas.  This is done by prefixing the code with a"
NSQ_SOURCE_LINE 00000683 "block that sets up a matching environment.  When inlining C<Sub::Quote>"
NSQ_SOURCE_LINE 00000684 "subs, care should be taken that user pragmas won't effect the rest"
NSQ_SOURCE_LINE 00000685 "of the code."
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "Users' IRC: #moose on irc.perl.org"
