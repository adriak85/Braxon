NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "=for :html"
NSQ_SOURCE_LINE 00000697 "L<(click for instant chatroom login)|http://chat.mibbit.com/#web-simple@irc.perl.org>"
NSQ_SOURCE_LINE 00000698 ""
