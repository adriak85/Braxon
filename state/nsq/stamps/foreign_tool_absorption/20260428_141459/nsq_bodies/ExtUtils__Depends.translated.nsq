NSQ_SOURCE_LINE 00000020 "sub new {"
NSQ_SOURCE_LINE 00000021 "\tmy ($class, $name, @deps) = @_;"
NSQ_SOURCE_LINE 00000022 "\tmy $self = bless {"
NSQ_SOURCE_LINE 00000023 "\t\tname => $name,"
NSQ_SOURCE_LINE 00000024 "\t\tdeps => {},"
NSQ_SOURCE_LINE 00000025 "\t\tinc => [],"
NSQ_SOURCE_LINE 00000026 "\t\tlibs => '',"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "\t\tpm => {},"
NSQ_SOURCE_LINE 00000029 "\t\ttypemaps => [],"
NSQ_SOURCE_LINE 00000030 "\t\txs => [],"
NSQ_SOURCE_LINE 00000031 "\t\tc => [],"
NSQ_SOURCE_LINE 00000032 "\t}, $class;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "\t$self->add_deps (@deps);"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "\t# attempt to load these now, so we'll find out as soon as possible"
NSQ_SOURCE_LINE 00000037 "\t# whether the dependencies are valid.  we'll load them again in"
NSQ_SOURCE_LINE 00000038 "\t# get_makefile_vars to catch any added between now and then."
NSQ_SOURCE_LINE 00000039 "\t$self->load_deps;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "\treturn $self;"
NSQ_SOURCE_LINE 00000042 "}"
