NSQ_SOURCE_LINE 00000100 "sub install {"
NSQ_SOURCE_LINE 00000101 "\t# install things by adding them to the hash of pm files that gets"
NSQ_SOURCE_LINE 00000102 "\t# passed through WriteMakefile's PM key."
NSQ_SOURCE_LINE 00000103 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000104 "\tforeach my $f (@_) {"
NSQ_SOURCE_LINE 00000105 "\t\t$self->add_pm ($f, $self->installed_filename ($f));"
NSQ_SOURCE_LINE 00000106 "\t}"
NSQ_SOURCE_LINE 00000107 "}"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "sub save_config {"
NSQ_SOURCE_LINE 00000110 "\tuse Data::Dumper;"
NSQ_SOURCE_LINE 00000111 "\tlocal $Data::Dumper::Terse = 0;"
NSQ_SOURCE_LINE 00000112 "\tlocal $Data::Dumper::Sortkeys = 1;"
NSQ_SOURCE_LINE 00000113 "\tuse IO::File;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "\tmy ($self, $filename) = @_;"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "\tmy $file = IO::File->new (\">\".$filename)"
NSQ_SOURCE_LINE 00000118 "\t\tor croak \"can't open '$filename' for writing: $!\\n\";"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "\tprint $file \"package $self->{name}\\::Install::Files;\\n\\n\";"
NSQ_SOURCE_LINE 00000121 "\tprint $file \"\".Data::Dumper->Dump([{"
NSQ_SOURCE_LINE 00000122 "\t\tinc => join (\" \", @{ $self->{inc} }),"
NSQ_SOURCE_LINE 00000123 "\t\tlibs => $self->{libs},"
NSQ_SOURCE_LINE 00000124 "\t\ttypemaps => [ map { basename $_ } @{ $self->{typemaps} } ],"
NSQ_SOURCE_LINE 00000125 "\t\tdeps => [sort keys %{ $self->{deps} }],"
NSQ_SOURCE_LINE 00000126 "\t}], ['self']);"
NSQ_SOURCE_LINE 00000127 "\tprint $file <<'EOF';"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "@deps = @{ $self->{deps} };"
NSQ_SOURCE_LINE 00000130 "@typemaps = @{ $self->{typemaps} };"
NSQ_SOURCE_LINE 00000131 "$libs = $self->{libs};"
NSQ_SOURCE_LINE 00000132 "$inc = $self->{inc};"
NSQ_SOURCE_LINE 00000133 "EOF"
NSQ_SOURCE_LINE 00000134 "\t# this is ridiculous, but old versions of ExtUtils::Depends take"
NSQ_SOURCE_LINE 00000135 "\t# first $loadedmodule::CORE and then $INC{$file} --- the fallback"
NSQ_SOURCE_LINE 00000136 "\t# includes the Filename.pm, which is not useful.  so we must add"
NSQ_SOURCE_LINE 00000137 "\t# this crappy code.  we don't worry about portable pathnames,"
NSQ_SOURCE_LINE 00000138 "\t# as the old code didn't either."
NSQ_SOURCE_LINE 00000139 "\t(my $mdir = $self->{name}) =~ s{::}{/}g;"
NSQ_SOURCE_LINE 00000140 "\tprint $file <<\"EOT\";"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "\t\\$CORE = undef;"
NSQ_SOURCE_LINE 00000143 "\tforeach (\\@INC) {"
NSQ_SOURCE_LINE 00000144 "\t\tif ( -f \\$_ . \"/$mdir/Install/Files.pm\") {"
NSQ_SOURCE_LINE 00000145 "\t\t\t\\$CORE = \\$_ . \"/$mdir/Install/\";"
NSQ_SOURCE_LINE 00000146 "\t\t\tlast;"
NSQ_SOURCE_LINE 00000147 "\t\t}"
NSQ_SOURCE_LINE 00000148 "\t}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "\tsub deps { \\@{ \\$self->{deps} }; }"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "\tsub Inline {"
NSQ_SOURCE_LINE 00000153 "\t\tmy (\\$class, \\$lang) = \\@_;"
NSQ_SOURCE_LINE 00000154 "\t\t+{ map { (uc(\\$_) => \\$self->{\\$_}) } qw(inc libs typemaps) };"
NSQ_SOURCE_LINE 00000155 "\t}"
NSQ_SOURCE_LINE 00000156 "EOT"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "\tprint $file \"\\n1;\\n\";"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "\tclose $file;"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "\t# we need to ensure that the file we just created gets put into"
NSQ_SOURCE_LINE 00000163 "\t# the install dir with everything else."
NSQ_SOURCE_LINE 00000164 "\t#$self->install ($filename);"
NSQ_SOURCE_LINE 00000165 "\t$self->add_pm ($filename, $self->installed_filename ('Files.pm'));"
NSQ_SOURCE_LINE 00000166 "}"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "sub load {"
NSQ_SOURCE_LINE 00000169 "\tmy $dep = shift;"
NSQ_SOURCE_LINE 00000170 "\tmy @pieces = split /::/, $dep;"
NSQ_SOURCE_LINE 00000171 "\tmy @suffix = qw/ Install Files /;"
NSQ_SOURCE_LINE 00000172 "\t# not File::Spec - see perldoc -f require"
NSQ_SOURCE_LINE 00000173 "\tmy $relpath = join('/', @pieces, @suffix) . '.pm';"
NSQ_SOURCE_LINE 00000174 "\tmy $depinstallfiles = join \"::\", @pieces, @suffix;"
NSQ_SOURCE_LINE 00000175 "\teval {"
NSQ_SOURCE_LINE 00000176 "\t\trequire $relpath "
NSQ_SOURCE_LINE 00000177 "\t} or die \" *** Can't load dependency information for $dep:\\n   $@\\n\";"
NSQ_SOURCE_LINE 00000178 "\t#print Dumper(\\%INC);"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "\t# effectively $instpath = dirname($INC{$relpath})"
NSQ_SOURCE_LINE 00000181 "\tmy ($vol,$dirs,$file) = File::Spec->splitpath($INC{$relpath});"
NSQ_SOURCE_LINE 00000182 "\tmy $instpath = File::Spec->catpath($vol,$dirs,'');"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "\tno strict;"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "\tcroak \"No dependency information found for $dep\""
NSQ_SOURCE_LINE 00000187 "\t\tunless $instpath;"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "\tif (not File::Spec->file_name_is_absolute ($instpath)) {"
NSQ_SOURCE_LINE 00000190 "\t\t$instpath = File::Spec->rel2abs ($instpath);"
NSQ_SOURCE_LINE 00000191 "\t}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "\t# this will not exist when loading files from old versions"
NSQ_SOURCE_LINE 00000194 "\t# of ExtUtils::Depends."
NSQ_SOURCE_LINE 00000195 "\tmy @deps = eval { $depinstallfiles->deps };"
NSQ_SOURCE_LINE 00000196 "\t@deps = @{\"$depinstallfiles\\::deps\"}"
NSQ_SOURCE_LINE 00000197 "\t\tif $@ and exists ${\"$depinstallfiles\\::\"}{deps};"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "\tmy (@typemaps, $inc, $libs);"
NSQ_SOURCE_LINE 00000200 "\tmy $inline = eval { $depinstallfiles->Inline('C') };"
NSQ_SOURCE_LINE 00000201 "\tif (!$@) {"
NSQ_SOURCE_LINE 00000202 "\t\t$inc = $inline->{INC} || '';"
NSQ_SOURCE_LINE 00000203 "\t\t$libs = $inline->{LIBS} || '';"
NSQ_SOURCE_LINE 00000204 "\t\t@typemaps = @{ $inline->{TYPEMAPS} || [] };"
NSQ_SOURCE_LINE 00000205 "\t} else {"
NSQ_SOURCE_LINE 00000206 "\t\t$inc = ${\"$depinstallfiles\\::inc\"} || '';"
NSQ_SOURCE_LINE 00000207 "\t\t$libs = ${\"$depinstallfiles\\::libs\"} || '';"
NSQ_SOURCE_LINE 00000208 "\t\t@typemaps = @{\"$depinstallfiles\\::typemaps\"};"
NSQ_SOURCE_LINE 00000209 "\t}"
NSQ_SOURCE_LINE 00000210 "\t@typemaps = map { File::Spec->rel2abs ($_, $instpath) } @typemaps;"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "\t{"
NSQ_SOURCE_LINE 00000213 "\t\tinstpath => $instpath,"
NSQ_SOURCE_LINE 00000214 "\t\ttypemaps => \\@typemaps,"
NSQ_SOURCE_LINE 00000215 "\t\tinc      => \"-I\". _quote_if_space($instpath) .\" $inc\","
NSQ_SOURCE_LINE 00000216 "\t\tlibs     => $libs,"
NSQ_SOURCE_LINE 00000217 "\t\tdeps     => \\@deps,"
NSQ_SOURCE_LINE 00000218 "\t}"
NSQ_SOURCE_LINE 00000219 "}"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "sub _quote_if_space { $_[0] =~ / / ? qq{\"$_[0]\"} : $_[0] }"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "sub load_deps {"
NSQ_SOURCE_LINE 00000224 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000225 "\tmy @load = grep !$self->{deps}{$_}, keys %{ $self->{deps} };"
NSQ_SOURCE_LINE 00000226 "\tmy %in_load; @in_load{@load} = ();"
NSQ_SOURCE_LINE 00000227 "\twhile (@load) {"
NSQ_SOURCE_LINE 00000228 "\t\tmy $d = shift @load;"
NSQ_SOURCE_LINE 00000229 "\t\t$self->{deps}{$d} = my $dep = load($d);"
NSQ_SOURCE_LINE 00000230 "\t\tmy @new_deps = grep !($self->{deps}{$_} || exists $in_load{$_}),"
NSQ_SOURCE_LINE 00000231 "\t\t\t@{ $dep->{deps} || [] };"
NSQ_SOURCE_LINE 00000232 "\t\tpush @load, @new_deps;"
NSQ_SOURCE_LINE 00000233 "\t\t@in_load{@new_deps} = ();"
NSQ_SOURCE_LINE 00000234 "\t}"
NSQ_SOURCE_LINE 00000235 "}"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "sub uniquify {"
NSQ_SOURCE_LINE 00000238 "\tmy %seen;"
NSQ_SOURCE_LINE 00000239 "\tgrep !$seen{$_}++, @_;"
NSQ_SOURCE_LINE 00000240 "}"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "sub get_makefile_vars {"
NSQ_SOURCE_LINE 00000243 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "\t# collect and uniquify things from the dependencies."
NSQ_SOURCE_LINE 00000246 "\t# first, ensure they are completely loaded."
NSQ_SOURCE_LINE 00000247 "\t$self->load_deps;"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "\tmy @incbits = @{ $self->{inc} };"
NSQ_SOURCE_LINE 00000250 "\tmy @libsbits = $self->{libs};"
NSQ_SOURCE_LINE 00000251 "\tmy @typemaps = @{ $self->{typemaps} };"
NSQ_SOURCE_LINE 00000252 "\tforeach my $d (sort keys %{ $self->{deps} }) {"
NSQ_SOURCE_LINE 00000253 "\t\tmy $dep = $self->{deps}{$d};"
NSQ_SOURCE_LINE 00000254 "\t\tpush @incbits, @{ $dep->{defines} } if $dep->{defines};"
NSQ_SOURCE_LINE 00000255 "\t\tpush @incbits, $dep->{inc} if $dep->{inc};"
NSQ_SOURCE_LINE 00000256 "\t\tpush @libsbits, $dep->{libs} if $dep->{libs};"
NSQ_SOURCE_LINE 00000257 "\t\tpush @typemaps, @{ $dep->{typemaps} } if $dep->{typemaps};"
NSQ_SOURCE_LINE 00000258 "\t}"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "\t# we have a fair bit of work to do for the xs files..."
NSQ_SOURCE_LINE 00000261 "\tmy @clean = ();"
NSQ_SOURCE_LINE 00000262 "\tmy @OBJECT = ();"
NSQ_SOURCE_LINE 00000263 "\tmy %XS = ();"
NSQ_SOURCE_LINE 00000264 "\tforeach my $xs (@{ $self->{xs} }) {"
NSQ_SOURCE_LINE 00000265 "\t\t(my $c = $xs) =~ s/\\.xs$/\\.c/i;"
NSQ_SOURCE_LINE 00000266 "\t\t(my $o = $xs) =~ s/\\.xs$/\\$(OBJ_EXT)/i;"
NSQ_SOURCE_LINE 00000267 "\t\t$XS{$xs} = $c;"
NSQ_SOURCE_LINE 00000268 "\t\tpush @OBJECT, $o;"
NSQ_SOURCE_LINE 00000269 "\t\t# according to the MakeMaker manpage, the C files listed in"
NSQ_SOURCE_LINE 00000270 "\t\t# XS will be added automatically to the list of cleanfiles."
NSQ_SOURCE_LINE 00000271 "\t\tpush @clean, $o;"
NSQ_SOURCE_LINE 00000272 "\t}"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "\t# we may have C files, as well:"
NSQ_SOURCE_LINE 00000275 "\tforeach my $c (@{ $self->{c} }) {"
NSQ_SOURCE_LINE 00000276 "\t\t(my $o = $c) =~ s/\\.c$/\\$(OBJ_EXT)/i;"
NSQ_SOURCE_LINE 00000277 "\t\tpush @OBJECT, $o;"
NSQ_SOURCE_LINE 00000278 "\t\tpush @clean, $o;"
NSQ_SOURCE_LINE 00000279 "\t}"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "\tmy %vars = ("
NSQ_SOURCE_LINE 00000282 "\t\tINC => join (' ', uniquify @incbits),"
NSQ_SOURCE_LINE 00000283 "\t\tLIBS => join (' ', uniquify @libsbits),"
NSQ_SOURCE_LINE 00000284 "\t\tLDFROM => join (' ', '$(OBJECT)', map _quote_if_space($_), find_extra_libs($self->{deps}, \\@INC)),"
NSQ_SOURCE_LINE 00000285 "\t\tTYPEMAPS => \\@typemaps,"
NSQ_SOURCE_LINE 00000286 "\t);"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "\t# we don't want to provide these if there is no data in them;"
NSQ_SOURCE_LINE 00000289 "\t# that way, the caller can still get default behavior out of"
NSQ_SOURCE_LINE 00000290 "\t# MakeMaker when INC, LIBS and TYPEMAPS are all that are required."
NSQ_SOURCE_LINE 00000291 "\t$vars{PM} = $self->{pm}"
NSQ_SOURCE_LINE 00000292 "\t\tif %{ $self->{pm} };"
NSQ_SOURCE_LINE 00000293 "\t$vars{clean} = { FILES => join (\" \", @clean), }"
NSQ_SOURCE_LINE 00000294 "\t\tif @clean;"
NSQ_SOURCE_LINE 00000295 "\t$vars{OBJECT} = join (\" \", @OBJECT)"
NSQ_SOURCE_LINE 00000296 "\t\tif @OBJECT;"
NSQ_SOURCE_LINE 00000297 "\t$vars{XS} = \\%XS"
NSQ_SOURCE_LINE 00000298 "\t\tif %XS;"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "\t%vars;"
NSQ_SOURCE_LINE 00000301 "}"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "# Search for extra library files to link against on Windows (either native"
NSQ_SOURCE_LINE 00000304 "# Windows library # files, or Cygwin library files)"
NSQ_SOURCE_LINE 00000305 "# NOTE: not meant to be called publicly, so no POD documentation"
NSQ_SOURCE_LINE 00000306 "# see https://rt.cpan.org/Ticket/Display.html?id=45224 for discussion"
NSQ_SOURCE_LINE 00000307 "my %exts; BEGIN { %exts = ("
NSQ_SOURCE_LINE 00000308 "  MSWin32 => [ \".lib\", \".$Config{dlext}\", $Config{_a} ],"
NSQ_SOURCE_LINE 00000309 "  cygwin => [ '.dll' ],"
NSQ_SOURCE_LINE 00000310 "  android => [ \".$Config{dlext}\" ],"
NSQ_SOURCE_LINE 00000311 "); }"
NSQ_SOURCE_LINE 00000312 "sub find_extra_libs {"
NSQ_SOURCE_LINE 00000313 "  my ($deps, $search) = @_;"
NSQ_SOURCE_LINE 00000314 "  return () if !keys %$deps;"
NSQ_SOURCE_LINE 00000315 "  return () unless my $exts = $exts{$^O};"
NSQ_SOURCE_LINE 00000316 "  require File::Spec::Functions;"
NSQ_SOURCE_LINE 00000317 "  my @found_libs = ();"
NSQ_SOURCE_LINE 00000318 "  DEP: foreach my $name (keys %$deps) {"
NSQ_SOURCE_LINE 00000319 "    my @parts = ('auto', split /::/, $name);"
NSQ_SOURCE_LINE 00000320 "    my $stem = defined &DynaLoader::mod2fname"
NSQ_SOURCE_LINE 00000321 "      ? DynaLoader::mod2fname(\\@parts) : $parts[-1];"
NSQ_SOURCE_LINE 00000322 "    my @bases = map $stem.$_, @$exts;"
NSQ_SOURCE_LINE 00000323 "    for my $dir (grep -d, @$search) { # only extant dirs"
NSQ_SOURCE_LINE 00000324 "      my ($found) = grep -f, map File::Spec::Functions::catfile($dir, @parts, $_), @bases;"
NSQ_SOURCE_LINE 00000325 "      next if !defined $found;"
NSQ_SOURCE_LINE 00000326 "      push @found_libs, $found;"
NSQ_SOURCE_LINE 00000327 "      next DEP;"
NSQ_SOURCE_LINE 00000328 "    }"
NSQ_SOURCE_LINE 00000329 "  }"
NSQ_SOURCE_LINE 00000330 "  @found_libs;"
NSQ_SOURCE_LINE 00000331 "}"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "1;"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "__END__"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=head1 NAME"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "ExtUtils::Depends - Easily build XS extensions that depend on XS extensions"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "\tuse ExtUtils::Depends;"
NSQ_SOURCE_LINE 00000344 "\t$package = new ExtUtils::Depends ('pkg::name', 'base::package')"
NSQ_SOURCE_LINE 00000345 "\t# set the flags and libraries to compile and link the module"
NSQ_SOURCE_LINE 00000346 "\t$package->set_inc(\"-I/opt/blahblah\");"
NSQ_SOURCE_LINE 00000347 "\t$package->set_libs(\"-lmylib\");"
NSQ_SOURCE_LINE 00000348 "\t# add a .c and an .xs file to compile"
NSQ_SOURCE_LINE 00000349 "\t$package->add_c('code.c');"
NSQ_SOURCE_LINE 00000350 "\t$package->add_xs('module-code.xs');"
NSQ_SOURCE_LINE 00000351 "\t# add the typemaps to use"
NSQ_SOURCE_LINE 00000352 "\t$package->add_typemaps(\"typemap\");"
NSQ_SOURCE_LINE 00000353 "\t# install some extra data files and headers"
NSQ_SOURCE_LINE 00000354 "\t$package->install (qw/foo.h data.txt/);"
NSQ_SOURCE_LINE 00000355 "\t# save the info"
NSQ_SOURCE_LINE 00000356 "\t$package->save_config('Files.pm');"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "\tWriteMakefile("
NSQ_SOURCE_LINE 00000359 "\t\t'NAME' => 'Mymodule',"
NSQ_SOURCE_LINE 00000360 "\t\t$package->get_makefile_vars()"
NSQ_SOURCE_LINE 00000361 "\t);"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "This module tries to make it easy to build Perl extensions that use"
NSQ_SOURCE_LINE 00000366 "functions and typemaps provided by other perl extensions. This means"
NSQ_SOURCE_LINE 00000367 "that a perl extension is treated like a shared library that provides"
NSQ_SOURCE_LINE 00000368 "also a C and an XS interface besides the perl one."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "This works as long as the base (or \"producing\") extension is loaded with"
NSQ_SOURCE_LINE 00000371 "the C<RTLD_GLOBAL> flag (usually done with a"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "\tsub dl_load_flags {0x01}"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "in the main F<.pm> file) if you need to use functions defined in the module."
NSQ_SOURCE_LINE 00000376 "That \"producing\" extension will also need to tell L<ExtUtils::MakeMaker>"
NSQ_SOURCE_LINE 00000377 "the specific functions to export, with arguments to C<WriteMakefile> like:"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "  FUNCLIST => [qw(function_name)],"
NSQ_SOURCE_LINE 00000380 "  DL_FUNCS => { 'Extension::Name' => [] },"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "The basic scheme of operation is to collect information about a module"
NSQ_SOURCE_LINE 00000383 "in the instance, and then store that data in the Perl library where it"
NSQ_SOURCE_LINE 00000384 "may be retrieved later.  The object can also reformat this information"
NSQ_SOURCE_LINE 00000385 "into the data structures required by ExtUtils::MakeMaker's WriteMakefile"
NSQ_SOURCE_LINE 00000386 "function."
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "For information on how to make your module fit into this scheme, see"
NSQ_SOURCE_LINE 00000389 "L</\"hashref = ExtUtils::Depends::load (name)\">."
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "When creating a new Depends object, you give it a name, which is the name"
NSQ_SOURCE_LINE 00000392 "of the module you are building.   You can also specify the names of modules"
NSQ_SOURCE_LINE 00000393 "on which this module depends.  These dependencies will be loaded"
NSQ_SOURCE_LINE 00000394 "automatically, and their typemaps, header files, etc merged with your new"
NSQ_SOURCE_LINE 00000395 "object's stuff.  When you store the data for your object, the list of"
NSQ_SOURCE_LINE 00000396 "dependencies are stored with it, so that another module depending on your"
NSQ_SOURCE_LINE 00000397 "needn't know on exactly which modules yours depends."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "For example:"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "  Gtk2 depends on Glib"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "  Gnome2::Canvas depends on Gtk2"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "  ExtUtils::Depends->new ('Gnome2::Canvas', 'Gtk2');"
NSQ_SOURCE_LINE 00000406 "     this command automatically brings in all the stuff needed"
NSQ_SOURCE_LINE 00000407 "     for Glib, since Gtk2 depends on it."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "When the configuration information is saved, it also includes a class"
NSQ_SOURCE_LINE 00000410 "method called C<Inline>, inheritable by your module. This allows you in"
NSQ_SOURCE_LINE 00000411 "your module to simply say at the top:"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "  package Mymod;"
NSQ_SOURCE_LINE 00000414 "  use parent 'Mymod::Install::Files'; # to inherit 'Inline' method"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "And users of C<Mymod> who want to write inline code (using L<Inline>)"
NSQ_SOURCE_LINE 00000417 "will simply be able to write:"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "  use Inline with => 'Mymod';"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "And all the necessary header files, defines, and libraries will be added"
NSQ_SOURCE_LINE 00000422 "for them."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "The C<Mymod::Install::Files> will also implement a C<deps> method,"
NSQ_SOURCE_LINE 00000425 "which will return a list of any modules that C<Mymod> depends on -"
NSQ_SOURCE_LINE 00000426 "you will not normally need to use this:"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "  require Mymod::Install::Files;"
NSQ_SOURCE_LINE 00000429 "  @deps = Mymod::Install::Files->deps;"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "=head1 METHODS"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=over"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "=item $object = ExtUtils::Depends->new($name, @deps)"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "Create a new depends object named I<$name>.  Any modules listed in I<@deps>"
NSQ_SOURCE_LINE 00000438 "(which may be empty) are added as dependencies and their dependency"
NSQ_SOURCE_LINE 00000439 "information is loaded.  An exception is raised if any dependency information"
NSQ_SOURCE_LINE 00000440 "cannot be loaded."
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "=item $depends->add_deps (@deps)"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "Add modules listed in I<@deps> as dependencies."
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "=item (hashes) = $depends->get_deps"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "Fetch information on the dependencies of I<$depends> as a hash of hashes,"
NSQ_SOURCE_LINE 00000449 "which are dependency information indexed by module name.  See C<load>."
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "=item $depends->set_inc (@newinc)"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "Add strings to the includes or cflags variables."
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=item $depends->set_libs (@newlibs)"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "Add strings to the libs (linker flags) variable."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "=item $depends->add_pm (%pm_files)"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "Add files to the hash to be passed through ExtUtils::WriteMakefile's"
NSQ_SOURCE_LINE 00000462 "PM key."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "=item $depends->add_xs (@xs_files)"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "Add xs files to be compiled."
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "=item $depends->add_c (@c_files)"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "Add C files to be compiled."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=item $depends->add_typemaps (@typemaps)"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "Add typemap files to be used and installed."
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "=item $depends->add_headers (list)"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "No-op, for backward compatibility."
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "=item $depends->install (@files)"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "Install I<@files> to the data directory for I<$depends>."
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "This actually works by adding them to the hash of pm files that gets"
NSQ_SOURCE_LINE 00000485 "passed through WriteMakefile's PM key."
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=item $depends->save_config ($filename)"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "Save the important information from I<$depends> to I<$filename>, and"
NSQ_SOURCE_LINE 00000490 "set it up to be installed as I<name>::Install::Files."
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "Note: the actual value of I<$filename> is unimportant so long as it"
NSQ_SOURCE_LINE 00000493 "doesn't clash with any other local files. It will be installed as"
NSQ_SOURCE_LINE 00000494 "I<name>::Install::Files."
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=item hash = $depends->get_makefile_vars"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "Return the information in I<$depends> in a format digestible by"
NSQ_SOURCE_LINE 00000499 "WriteMakefile."
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "This sets at least the following keys:"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "\tINC"
NSQ_SOURCE_LINE 00000504 "\tLIBS"
NSQ_SOURCE_LINE 00000505 "\tTYPEMAPS"
NSQ_SOURCE_LINE 00000506 "\tPM"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "And these if there is data to fill them:"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "\tclean"
NSQ_SOURCE_LINE 00000511 "\tOBJECT"
NSQ_SOURCE_LINE 00000512 "\tXS"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=item hashref = ExtUtils::Depends::load (name)"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "Load and return dependency information for I<name>.  Croaks if no such"
NSQ_SOURCE_LINE 00000517 "information can be found.  The information is returned as an anonymous"
NSQ_SOURCE_LINE 00000518 "hash containing these keys:"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=over"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "=item instpath"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "The absolute path to the data install directory for this module."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "=item typemaps"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "List of absolute pathnames for this module's typemap files."
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "=item inc"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "CFLAGS string for this module."
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=item libs"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "LIBS string for this module."
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "=item deps"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "List of modules on which this one depends.  This key will not exist when"
NSQ_SOURCE_LINE 00000541 "loading files created by old versions of ExtUtils::Depends."
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "=back"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "If you want to make module I<name> support this, you must provide"
NSQ_SOURCE_LINE 00000546 "a module I<name>::Install::Files, which on loading will implement the"
NSQ_SOURCE_LINE 00000547 "following class methods:"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "  $hashref = name::Install::Files->Inline('C');"
NSQ_SOURCE_LINE 00000550 "  # hash to contain any necessary TYPEMAPS (array-ref), LIBS, INC"
NSQ_SOURCE_LINE 00000551 "  @deps = name::Install::Files->deps;"
NSQ_SOURCE_LINE 00000552 "  # any modules on which \"name\" depends"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "An easy way to achieve this is to use the method"
NSQ_SOURCE_LINE 00000555 "L</\"$depends-E<gt>save_config ($filename)\">, but your package may have"
NSQ_SOURCE_LINE 00000556 "different facilities already."
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "=item $depends->load_deps"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "Load I<$depends> dependencies, by calling C<load> on each dependency module."
NSQ_SOURCE_LINE 00000561 "This is usually done for you, and should only be needed if you want to call"
NSQ_SOURCE_LINE 00000562 "C<get_deps> after calling C<add_deps> manually."
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "=back"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "=head2 Bugs/Feature Requests"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "Version 0.2 discards some of the more esoteric features provided by the"
NSQ_SOURCE_LINE 00000571 "older versions.  As they were completely undocumented, and this module"
NSQ_SOURCE_LINE 00000572 "has yet to reach 1.0, this may not exactly be a bug."
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "This module is tightly coupled to the ExtUtils::MakeMaker architecture."
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "You can submit new bugs/feature requests by using one of two bug trackers"
NSQ_SOURCE_LINE 00000577 "(below)."
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "=over"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "=item CPAN Request Tracker"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "You can submit bugs/feature requests via the web by going to"
NSQ_SOURCE_LINE 00000584 "L<https://rt.cpan.org/Public/Bug/Report.html?Queue=ExtUtils-Depends> (requires"
NSQ_SOURCE_LINE 00000585 "PAUSE ID or Bitcard), or by sending an e-mail to"
NSQ_SOURCE_LINE 00000586 "L<bug-ExtUtils-Depends at rt.cpan.org>."
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "=item Gnome.org Bugtracker"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "Report bugs/feature requests to 'perl-extutils-depends' (requires login)"
NSQ_SOURCE_LINE 00000591 "L<https://gitlab.gnome.org/GNOME/perl-extutils-depends/-/issues/>"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=back"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "Patches that implement new features with test cases, and/or test cases that"
NSQ_SOURCE_LINE 00000596 "exercise existing bugs are always welcome."
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "The Gtk-Perl support forum is at"
NSQ_SOURCE_LINE 00000599 "L<https://discourse.gnome.org/tags/c/platform/language-bindings/11/perl>"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "=head2 Source Code"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "The source code to L<ExtUtils::Depends> is available at the Gnome.org Git repo"
NSQ_SOURCE_LINE 00000604 "(L<https://gitlab.gnome.org/GNOME/perl-extutils-depends>).  Create your own"
NSQ_SOURCE_LINE 00000605 "copy of the Git repo with:"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "  git clone git://git.gnome.org/perl-ExtUtils-Depends (Git protocol)"
NSQ_SOURCE_LINE 00000608 "  git clone https://git.gnome.org/browse/perl-ExtUtils-Depends/ (HTTPS)"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "ExtUtils::MakeMaker."
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "Paolo Molaro <lupus at debian dot org> wrote the original version for"
NSQ_SOURCE_LINE 00000617 "Gtk-Perl.  muppet <scott at asofyet dot org> rewrote the innards for"
NSQ_SOURCE_LINE 00000618 "version 0.2, borrowing liberally from Paolo's code."
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "=head1 MAINTAINER"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "The Gtk2 project, L<http://gtk2-perl.sf.net>/L<gtk-perl-list at gnome dot org>."
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "=head1 LICENSE"
