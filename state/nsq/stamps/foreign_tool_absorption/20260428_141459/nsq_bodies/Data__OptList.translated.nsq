BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 "package Data::OptList 0.114;"
NSQ_SOURCE_LINE 00000004 "# ABSTRACT: parse and validate simple name/value option pairs"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use List::Util ();"
NSQ_SOURCE_LINE 00000007 "use Params::Util ();"
NSQ_SOURCE_LINE 00000008 "use Sub::Install 0.921 ();"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "#pod =head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000011 "#pod"
NSQ_SOURCE_LINE 00000012 "#pod   use Data::OptList;"
NSQ_SOURCE_LINE 00000013 "#pod"
NSQ_SOURCE_LINE 00000014 "#pod   my $options = Data::OptList::mkopt(["
NSQ_SOURCE_LINE 00000015 "#pod     qw(key1 key2 key3 key4),"
NSQ_SOURCE_LINE 00000016 "#pod     key5 => { ... },"
NSQ_SOURCE_LINE 00000017 "#pod     key6 => [ ... ],"
NSQ_SOURCE_LINE 00000018 "#pod     key7 => sub { ... },"
NSQ_SOURCE_LINE 00000019 "#pod     key8 => { ... },"
NSQ_SOURCE_LINE 00000020 "#pod     key8 => [ ... ],"
NSQ_SOURCE_LINE 00000021 "#pod   ]);"
NSQ_SOURCE_LINE 00000022 "#pod"
NSQ_SOURCE_LINE 00000023 "#pod ...is the same thing, more or less, as:"
NSQ_SOURCE_LINE 00000024 "#pod"
NSQ_SOURCE_LINE 00000025 "#pod   my $options = ["
NSQ_SOURCE_LINE 00000026 "#pod     [ key1 => undef,        ],"
NSQ_SOURCE_LINE 00000027 "#pod     [ key2 => undef,        ],"
NSQ_SOURCE_LINE 00000028 "#pod     [ key3 => undef,        ],"
NSQ_SOURCE_LINE 00000029 "#pod     [ key4 => undef,        ],"
NSQ_SOURCE_LINE 00000030 "#pod     [ key5 => { ... },      ],"
NSQ_SOURCE_LINE 00000031 "#pod     [ key6 => [ ... ],      ],"
NSQ_SOURCE_LINE 00000032 "#pod     [ key7 => sub { ... },  ],"
NSQ_SOURCE_LINE 00000033 "#pod     [ key8 => { ... },      ],"
NSQ_SOURCE_LINE 00000034 "#pod     [ key8 => [ ... ],      ],"
NSQ_SOURCE_LINE 00000035 "#pod   ]);"
NSQ_SOURCE_LINE 00000036 "#pod"
NSQ_SOURCE_LINE 00000037 "#pod =head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000038 "#pod"
NSQ_SOURCE_LINE 00000039 "#pod Hashes are great for storing named data, but if you want more than one entry"
NSQ_SOURCE_LINE 00000040 "#pod for a name, you have to use a list of pairs.  Even then, this is really boring"
NSQ_SOURCE_LINE 00000041 "#pod to write:"
NSQ_SOURCE_LINE 00000042 "#pod"
NSQ_SOURCE_LINE 00000043 "#pod   $values = ["
NSQ_SOURCE_LINE 00000044 "#pod     foo => undef,"
NSQ_SOURCE_LINE 00000045 "#pod     bar => undef,"
NSQ_SOURCE_LINE 00000046 "#pod     baz => undef,"
NSQ_SOURCE_LINE 00000047 "#pod     xyz => { ... },"
NSQ_SOURCE_LINE 00000048 "#pod   ];"
NSQ_SOURCE_LINE 00000049 "#pod"
NSQ_SOURCE_LINE 00000050 "#pod Just look at all those undefs!  Don't worry, we can get rid of those:"
NSQ_SOURCE_LINE 00000051 "#pod"
NSQ_SOURCE_LINE 00000052 "#pod   $values = ["
NSQ_SOURCE_LINE 00000053 "#pod     map { $_ => undef } qw(foo bar baz),"
NSQ_SOURCE_LINE 00000054 "#pod     xyz => { ... },"
NSQ_SOURCE_LINE 00000055 "#pod   ];"
NSQ_SOURCE_LINE 00000056 "#pod"
NSQ_SOURCE_LINE 00000057 "#pod Aaaauuugh!  We've saved a little typing, but now it requires thought to read,"
NSQ_SOURCE_LINE 00000058 "#pod and thinking is even worse than typing... and it's got a bug!  It looked right,"
NSQ_SOURCE_LINE 00000059 "#pod didn't it?  Well, the C<< xyz => { ... } >> gets consumed by the map, and we"
NSQ_SOURCE_LINE 00000060 "#pod don't get the data we wanted."
NSQ_SOURCE_LINE 00000061 "#pod"
NSQ_SOURCE_LINE 00000062 "#pod With Data::OptList, you can do this instead:"
NSQ_SOURCE_LINE 00000063 "#pod"
NSQ_SOURCE_LINE 00000064 "#pod   $values = Data::OptList::mkopt(["
NSQ_SOURCE_LINE 00000065 "#pod     qw(foo bar baz),"
NSQ_SOURCE_LINE 00000066 "#pod     xyz => { ... },"
NSQ_SOURCE_LINE 00000067 "#pod   ]);"
NSQ_SOURCE_LINE 00000068 "#pod"
NSQ_SOURCE_LINE 00000069 "#pod This works by assuming that any defined scalar is a name and any reference"
NSQ_SOURCE_LINE 00000070 "#pod following a name is its value."
NSQ_SOURCE_LINE 00000071 "#pod"
NSQ_SOURCE_LINE 00000072 "#pod =func mkopt"
NSQ_SOURCE_LINE 00000073 "#pod"
NSQ_SOURCE_LINE 00000074 "#pod   my $opt_list = Data::OptList::mkopt($input, \\%arg);"
NSQ_SOURCE_LINE 00000075 "#pod"
NSQ_SOURCE_LINE 00000076 "#pod Valid arguments are:"
NSQ_SOURCE_LINE 00000077 "#pod"
NSQ_SOURCE_LINE 00000078 "#pod   moniker        - a word used in errors to describe the opt list; encouraged"
NSQ_SOURCE_LINE 00000079 "#pod   require_unique - if true, no name may appear more than once"
NSQ_SOURCE_LINE 00000080 "#pod   must_be        - types to which opt list values are limited (described below)"
NSQ_SOURCE_LINE 00000081 "#pod   name_test      - a coderef used to test whether a value can be a name"
NSQ_SOURCE_LINE 00000082 "#pod                    (described below, but you probably don't want this)"
NSQ_SOURCE_LINE 00000083 "#pod"
NSQ_SOURCE_LINE 00000084 "#pod This produces an array of arrays; the inner arrays are name/value pairs."
NSQ_SOURCE_LINE 00000085 "#pod Values will be either \"undef\" or a reference."
NSQ_SOURCE_LINE 00000086 "#pod"
NSQ_SOURCE_LINE 00000087 "#pod Positional parameters may be used for compatibility with the old C<mkopt>"
NSQ_SOURCE_LINE 00000088 "#pod interface:"
NSQ_SOURCE_LINE 00000089 "#pod"
NSQ_SOURCE_LINE 00000090 "#pod   my $opt_list = Data::OptList::mkopt($input, $moniker, $req_uni, $must_be);"
NSQ_SOURCE_LINE 00000091 "#pod"
NSQ_SOURCE_LINE 00000092 "#pod Valid values for C<$input>:"
NSQ_SOURCE_LINE 00000093 "#pod"
NSQ_SOURCE_LINE 00000094 "#pod  undef    -> []"
NSQ_SOURCE_LINE 00000095 "#pod  hashref  -> [ [ key1 => value1 ] ... ] # non-ref values become undef"
NSQ_SOURCE_LINE 00000096 "#pod  arrayref -> every name followed by a non-name becomes a pair: [ name => ref ]"
NSQ_SOURCE_LINE 00000097 "#pod              every name followed by undef becomes a pair: [ name => undef ]"
NSQ_SOURCE_LINE 00000098 "#pod              otherwise, it becomes [ name => undef ] like so:"
NSQ_SOURCE_LINE 00000099 "#pod              [ \"a\", \"b\", [ 1, 2 ] ] -> [ [ a => undef ], [ b => [ 1, 2 ] ] ]"
NSQ_SOURCE_LINE 00000100 "#pod"
NSQ_SOURCE_LINE 00000101 "#pod By default, a I<name> is any defined non-reference.  The C<name_test> parameter"
NSQ_SOURCE_LINE 00000102 "#pod can be a code ref that tests whether the argument passed it is a name or not."
NSQ_SOURCE_LINE 00000103 "#pod This should be used rarely.  Interactions between C<require_unique> and"
NSQ_SOURCE_LINE 00000104 "#pod C<name_test> are not yet particularly elegant, as C<require_unique> just tests"
NSQ_SOURCE_LINE 00000105 "#pod string equality.  B<This may change.>"
NSQ_SOURCE_LINE 00000106 "#pod"
NSQ_SOURCE_LINE 00000107 "#pod The C<must_be> parameter is either a scalar or array of scalars; it defines"
NSQ_SOURCE_LINE 00000108 "#pod what kind(s) of refs may be values.  If an invalid value is found, an exception"
NSQ_SOURCE_LINE 00000109 "#pod is thrown.  If no value is passed for this argument, any reference is valid."
NSQ_SOURCE_LINE 00000110 "#pod If C<must_be> specifies that values must be CODE, HASH, ARRAY, or SCALAR, then"
NSQ_SOURCE_LINE 00000111 "#pod Params::Util is used to check whether the given value can provide that"
NSQ_SOURCE_LINE 00000112 "#pod interface.  Otherwise, it checks that the given value is an object of the kind."
NSQ_SOURCE_LINE 00000113 "#pod"
NSQ_SOURCE_LINE 00000114 "#pod In other words:"
NSQ_SOURCE_LINE 00000115 "#pod"
NSQ_SOURCE_LINE 00000116 "#pod   [ qw(SCALAR HASH Object::Known) ]"
NSQ_SOURCE_LINE 00000117 "#pod"
NSQ_SOURCE_LINE 00000118 "#pod Means:"
NSQ_SOURCE_LINE 00000119 "#pod"
NSQ_SOURCE_LINE 00000120 "#pod   _SCALAR0($value) or _HASH($value) or _INSTANCE($value, 'Object::Known')"
NSQ_SOURCE_LINE 00000121 "#pod"
NSQ_SOURCE_LINE 00000122 "#pod =cut"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "my %test_for;"
NSQ_SOURCE_LINE 00000125 "BEGIN {"
NSQ_SOURCE_LINE 00000126 "  %test_for = ("
NSQ_SOURCE_LINE 00000127 "    CODE   => \\&Params::Util::_CODELIKE,  ## no critic"
NSQ_SOURCE_LINE 00000128 "    HASH   => \\&Params::Util::_HASHLIKE,  ## no critic"
NSQ_SOURCE_LINE 00000129 "    ARRAY  => \\&Params::Util::_ARRAYLIKE, ## no critic"
NSQ_SOURCE_LINE 00000130 "    SCALAR => \\&Params::Util::_SCALAR0,   ## no critic"
NSQ_SOURCE_LINE 00000131 "  );"
NSQ_SOURCE_LINE 00000132 "}"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "sub mkopt {"
NSQ_SOURCE_LINE 00000135 "  my ($opt_list) = shift;"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "  my ($moniker, $require_unique, $must_be); # the old positional args"
NSQ_SOURCE_LINE 00000138 "  my ($name_test, $is_a);"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "  if (@_) {"
NSQ_SOURCE_LINE 00000141 "    if (@_ == 1 and Params::Util::_HASHLIKE($_[0])) {"
NSQ_SOURCE_LINE 00000142 "      ($moniker, $require_unique, $must_be, $name_test)"
NSQ_SOURCE_LINE 00000143 "        = @{$_[0]}{ qw(moniker require_unique must_be name_test) };"
NSQ_SOURCE_LINE 00000144 "    } else {"
NSQ_SOURCE_LINE 00000145 "      ($moniker, $require_unique, $must_be) = @_;"
NSQ_SOURCE_LINE 00000146 "    }"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    # Transform the $must_be specification into a closure $is_a"
NSQ_SOURCE_LINE 00000149 "    # that will check if a value matches the spec"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    if (defined $must_be) {"
NSQ_SOURCE_LINE 00000152 "      $must_be = [ $must_be ] unless ref $must_be;"
NSQ_SOURCE_LINE 00000153 "      my @checks = map {"
NSQ_SOURCE_LINE 00000154 "          my $class = $_;"
NSQ_SOURCE_LINE 00000155 "          $test_for{$class}"
NSQ_SOURCE_LINE 00000156 "          || sub { Params::Util::_INSTANCE($_[0], $class) }"
NSQ_SOURCE_LINE 00000157 "      } @$must_be;"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "      $is_a = (@checks == 1)"
NSQ_SOURCE_LINE 00000160 "            ? $checks[0]"
NSQ_SOURCE_LINE 00000161 "            : sub {"
NSQ_SOURCE_LINE 00000162 "                my $value = $_[0];"
NSQ_SOURCE_LINE 00000163 "                List::Util::first { defined($_->($value)) } @checks"
NSQ_SOURCE_LINE 00000164 "              };"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "      $moniker = 'unnamed' unless defined $moniker;"
NSQ_SOURCE_LINE 00000167 "    }"
NSQ_SOURCE_LINE 00000168 "  }"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "  return [] unless $opt_list;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "  $name_test ||= sub { ! ref $_[0] };"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "  $opt_list = ["
NSQ_SOURCE_LINE 00000175 "    map { $_ => (ref $opt_list->{$_} ? $opt_list->{$_} : ()) } keys %$opt_list"
NSQ_SOURCE_LINE 00000176 "  ] if ref $opt_list eq 'HASH';"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "  my @return;"
NSQ_SOURCE_LINE 00000179 "  my %seen;"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "  for (my $i = 0; $i < @$opt_list; $i++) { ## no critic"
NSQ_SOURCE_LINE 00000182 "    my $name = $opt_list->[$i];"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "    if ($require_unique) {"
NSQ_SOURCE_LINE 00000185 "      Carp::croak \"multiple definitions provided for $name\" if $seen{$name}++;"
NSQ_SOURCE_LINE 00000186 "    }"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "    my $value;"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    if ($i < $#$opt_list) {"
NSQ_SOURCE_LINE 00000191 "      if (not defined $opt_list->[$i+1]) {"
NSQ_SOURCE_LINE 00000192 "        $i++"
NSQ_SOURCE_LINE 00000193 "      } elsif (! $name_test->($opt_list->[$i+1])) {"
NSQ_SOURCE_LINE 00000194 "        $value = $opt_list->[++$i];"
NSQ_SOURCE_LINE 00000195 "        if ($is_a && !$is_a->($value)) {"
NSQ_SOURCE_LINE 00000196 "          my $ref = ref $value;"
NSQ_SOURCE_LINE 00000197 "          Carp::croak \"$ref-ref values are not valid in $moniker opt list\";"
NSQ_SOURCE_LINE 00000198 "        }"
NSQ_SOURCE_LINE 00000199 "      }"
NSQ_SOURCE_LINE 00000200 "    }"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "    push @return, [ $name => $value ];"
NSQ_SOURCE_LINE 00000203 "  }"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "  return \\@return;"
NSQ_SOURCE_LINE 00000206 "}"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "#pod =func mkopt_hash"
NSQ_SOURCE_LINE 00000209 "#pod"
NSQ_SOURCE_LINE 00000210 "#pod   my $opt_hash = Data::OptList::mkopt_hash($input, $moniker, $must_be);"
NSQ_SOURCE_LINE 00000211 "#pod"
NSQ_SOURCE_LINE 00000212 "#pod Given valid C<L</mkopt>> input, this routine returns a reference to a hash.  It"
NSQ_SOURCE_LINE 00000213 "#pod will throw an exception if any name has more than one value."
NSQ_SOURCE_LINE 00000214 "#pod"
NSQ_SOURCE_LINE 00000215 "#pod =cut"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "sub mkopt_hash {"
NSQ_SOURCE_LINE 00000218 "  my ($opt_list, $moniker, $must_be) = @_;"
NSQ_SOURCE_LINE 00000219 "  return {} unless $opt_list;"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "  $opt_list = mkopt($opt_list, $moniker, 1, $must_be);"
NSQ_SOURCE_LINE 00000222 "  my %hash = map { $_->[0] => $_->[1] } @$opt_list;"
NSQ_SOURCE_LINE 00000223 "  return \\%hash;"
NSQ_SOURCE_LINE 00000224 "}"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "#pod =head1 EXPORTS"
NSQ_SOURCE_LINE 00000227 "#pod"
NSQ_SOURCE_LINE 00000228 "#pod Both C<mkopt> and C<mkopt_hash> may be exported on request."
NSQ_SOURCE_LINE 00000229 "#pod"
NSQ_SOURCE_LINE 00000230 "#pod =cut"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "BEGIN {"
NSQ_SOURCE_LINE 00000233 "  *import = Sub::Install::exporter {"
NSQ_SOURCE_LINE 00000234 "    exports => [qw(mkopt mkopt_hash)],"
NSQ_SOURCE_LINE 00000235 "  };"
NSQ_SOURCE_LINE 00000236 "}"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "1;"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "__END__"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=pod"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head1 NAME"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "Data::OptList - parse and validate simple name/value option pairs"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=head1 VERSION"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "version 0.114"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "  use Data::OptList;"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "  my $options = Data::OptList::mkopt(["
NSQ_SOURCE_LINE 00000259 "    qw(key1 key2 key3 key4),"
NSQ_SOURCE_LINE 00000260 "    key5 => { ... },"
NSQ_SOURCE_LINE 00000261 "    key6 => [ ... ],"
NSQ_SOURCE_LINE 00000262 "    key7 => sub { ... },"
NSQ_SOURCE_LINE 00000263 "    key8 => { ... },"
NSQ_SOURCE_LINE 00000264 "    key8 => [ ... ],"
NSQ_SOURCE_LINE 00000265 "  ]);"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "...is the same thing, more or less, as:"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "  my $options = ["
NSQ_SOURCE_LINE 00000270 "    [ key1 => undef,        ],"
NSQ_SOURCE_LINE 00000271 "    [ key2 => undef,        ],"
NSQ_SOURCE_LINE 00000272 "    [ key3 => undef,        ],"
NSQ_SOURCE_LINE 00000273 "    [ key4 => undef,        ],"
NSQ_SOURCE_LINE 00000274 "    [ key5 => { ... },      ],"
NSQ_SOURCE_LINE 00000275 "    [ key6 => [ ... ],      ],"
NSQ_SOURCE_LINE 00000276 "    [ key7 => sub { ... },  ],"
NSQ_SOURCE_LINE 00000277 "    [ key8 => { ... },      ],"
NSQ_SOURCE_LINE 00000278 "    [ key8 => [ ... ],      ],"
NSQ_SOURCE_LINE 00000279 "  ]);"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "Hashes are great for storing named data, but if you want more than one entry"
NSQ_SOURCE_LINE 00000284 "for a name, you have to use a list of pairs.  Even then, this is really boring"
NSQ_SOURCE_LINE 00000285 "to write:"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "  $values = ["
NSQ_SOURCE_LINE 00000288 "    foo => undef,"
NSQ_SOURCE_LINE 00000289 "    bar => undef,"
NSQ_SOURCE_LINE 00000290 "    baz => undef,"
NSQ_SOURCE_LINE 00000291 "    xyz => { ... },"
NSQ_SOURCE_LINE 00000292 "  ];"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "Just look at all those undefs!  Don't worry, we can get rid of those:"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "  $values = ["
NSQ_SOURCE_LINE 00000297 "    map { $_ => undef } qw(foo bar baz),"
NSQ_SOURCE_LINE 00000298 "    xyz => { ... },"
NSQ_SOURCE_LINE 00000299 "  ];"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "Aaaauuugh!  We've saved a little typing, but now it requires thought to read,"
NSQ_SOURCE_LINE 00000302 "and thinking is even worse than typing... and it's got a bug!  It looked right,"
NSQ_SOURCE_LINE 00000303 "didn't it?  Well, the C<< xyz => { ... } >> gets consumed by the map, and we"
NSQ_SOURCE_LINE 00000304 "don't get the data we wanted."
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "With Data::OptList, you can do this instead:"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "  $values = Data::OptList::mkopt(["
NSQ_SOURCE_LINE 00000309 "    qw(foo bar baz),"
NSQ_SOURCE_LINE 00000310 "    xyz => { ... },"
NSQ_SOURCE_LINE 00000311 "  ]);"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "This works by assuming that any defined scalar is a name and any reference"
NSQ_SOURCE_LINE 00000314 "following a name is its value."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=head1 PERL VERSION"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "This library should run on perls released even a long time ago.  It should"
NSQ_SOURCE_LINE 00000319 "work on any version of perl released in the last five years."
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "Although it may work on older versions of perl, no guarantee is made that the"
NSQ_SOURCE_LINE 00000322 "minimum required version will not be increased.  The version may be increased"
NSQ_SOURCE_LINE 00000323 "for any reason, and there is no promise that patches will be accepted to"
NSQ_SOURCE_LINE 00000324 "lower the minimum required perl."
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=head2 mkopt"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "  my $opt_list = Data::OptList::mkopt($input, \\%arg);"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "Valid arguments are:"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "  moniker        - a word used in errors to describe the opt list; encouraged"
NSQ_SOURCE_LINE 00000335 "  require_unique - if true, no name may appear more than once"
NSQ_SOURCE_LINE 00000336 "  must_be        - types to which opt list values are limited (described below)"
NSQ_SOURCE_LINE 00000337 "  name_test      - a coderef used to test whether a value can be a name"
NSQ_SOURCE_LINE 00000338 "                   (described below, but you probably don't want this)"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "This produces an array of arrays; the inner arrays are name/value pairs."
NSQ_SOURCE_LINE 00000341 "Values will be either \"undef\" or a reference."
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "Positional parameters may be used for compatibility with the old C<mkopt>"
NSQ_SOURCE_LINE 00000344 "interface:"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "  my $opt_list = Data::OptList::mkopt($input, $moniker, $req_uni, $must_be);"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "Valid values for C<$input>:"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 " undef    -> []"
NSQ_SOURCE_LINE 00000351 " hashref  -> [ [ key1 => value1 ] ... ] # non-ref values become undef"
NSQ_SOURCE_LINE 00000352 " arrayref -> every name followed by a non-name becomes a pair: [ name => ref ]"
NSQ_SOURCE_LINE 00000353 "             every name followed by undef becomes a pair: [ name => undef ]"
NSQ_SOURCE_LINE 00000354 "             otherwise, it becomes [ name => undef ] like so:"
NSQ_SOURCE_LINE 00000355 "             [ \"a\", \"b\", [ 1, 2 ] ] -> [ [ a => undef ], [ b => [ 1, 2 ] ] ]"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "By default, a I<name> is any defined non-reference.  The C<name_test> parameter"
NSQ_SOURCE_LINE 00000358 "can be a code ref that tests whether the argument passed it is a name or not."
NSQ_SOURCE_LINE 00000359 "This should be used rarely.  Interactions between C<require_unique> and"
NSQ_SOURCE_LINE 00000360 "C<name_test> are not yet particularly elegant, as C<require_unique> just tests"
NSQ_SOURCE_LINE 00000361 "string equality.  B<This may change.>"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "The C<must_be> parameter is either a scalar or array of scalars; it defines"
NSQ_SOURCE_LINE 00000364 "what kind(s) of refs may be values.  If an invalid value is found, an exception"
NSQ_SOURCE_LINE 00000365 "is thrown.  If no value is passed for this argument, any reference is valid."
NSQ_SOURCE_LINE 00000366 "If C<must_be> specifies that values must be CODE, HASH, ARRAY, or SCALAR, then"
NSQ_SOURCE_LINE 00000367 "Params::Util is used to check whether the given value can provide that"
NSQ_SOURCE_LINE 00000368 "interface.  Otherwise, it checks that the given value is an object of the kind."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "In other words:"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "  [ qw(SCALAR HASH Object::Known) ]"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "Means:"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "  _SCALAR0($value) or _HASH($value) or _INSTANCE($value, 'Object::Known')"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "=head2 mkopt_hash"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "  my $opt_hash = Data::OptList::mkopt_hash($input, $moniker, $must_be);"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "Given valid C<L</mkopt>> input, this routine returns a reference to a hash.  It"
NSQ_SOURCE_LINE 00000383 "will throw an exception if any name has more than one value."
