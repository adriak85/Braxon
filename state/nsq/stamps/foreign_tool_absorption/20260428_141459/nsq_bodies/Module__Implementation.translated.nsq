BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Module::Implementation;"
NSQ_SOURCE_LINE 00000002 "# git description: v0.08-2-gd599347"
NSQ_SOURCE_LINE 00000003 "$Module::Implementation::VERSION = '0.09';"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Module::Runtime 0.012 qw( require_module );"
NSQ_SOURCE_LINE 00000009 "use Try::Tiny;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "# This is needed for the benefit of Test::CleanNamespaces, which in turn loads"
NSQ_SOURCE_LINE 00000012 "# Package::Stash, which in turn loads this module and expects a minimum"
NSQ_SOURCE_LINE 00000013 "# version."
NSQ_SOURCE_LINE 00000014 "unless ( exists $Module::Implementation::{VERSION}"
NSQ_SOURCE_LINE 00000015 "    && ${ $Module::Implementation::{VERSION} } ) {"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "    $Module::Implementation::{VERSION} = \\42;"
NSQ_SOURCE_LINE 00000018 "}"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "my %Implementation;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub build_loader_sub {"
NSQ_SOURCE_LINE 00000023 "    my $caller = caller();"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    return _build_loader( $caller, @_ );"
NSQ_SOURCE_LINE 00000026 "}"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "sub _build_loader {"
NSQ_SOURCE_LINE 00000029 "    my $package = shift;"
NSQ_SOURCE_LINE 00000030 "    my %args    = @_;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    my @implementations = @{ $args{implementations} };"
NSQ_SOURCE_LINE 00000033 "    my @symbols = @{ $args{symbols} || [] };"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    my $implementation;"
NSQ_SOURCE_LINE 00000036 "    my $env_var = uc $package;"
NSQ_SOURCE_LINE 00000037 "    $env_var =~ s/::/_/g;"
NSQ_SOURCE_LINE 00000038 "    $env_var .= '_IMPLEMENTATION';"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    return sub {"
NSQ_SOURCE_LINE 00000041 "        my ( $implementation, $loaded ) = _load_implementation("
NSQ_SOURCE_LINE 00000042 "            $package,"
NSQ_SOURCE_LINE 00000043 "            $ENV{$env_var},"
NSQ_SOURCE_LINE 00000044 "            \\@implementations,"
NSQ_SOURCE_LINE 00000045 "        );"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "        $Implementation{$package} = $implementation;"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "        _copy_symbols( $loaded, $package, \\@symbols );"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "        return $loaded;"
NSQ_SOURCE_LINE 00000052 "    };"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "sub implementation_for {"
NSQ_SOURCE_LINE 00000056 "    my $package = shift;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    return $Implementation{$package};"
NSQ_SOURCE_LINE 00000059 "}"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "sub _load_implementation {"
NSQ_SOURCE_LINE 00000062 "    my $package         = shift;"
NSQ_SOURCE_LINE 00000063 "    my $env_value       = shift;"
NSQ_SOURCE_LINE 00000064 "    my $implementations = shift;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    if ($env_value) {"
NSQ_SOURCE_LINE 00000067 "        die \"$env_value is not a valid implementation for $package\""
NSQ_SOURCE_LINE 00000068 "            unless grep { $_ eq $env_value } @{$implementations};"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "        my $requested = \"${package}::$env_value\";"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "        # Values from the %ENV hash are tainted. We know it's safe to untaint"
NSQ_SOURCE_LINE 00000073 "        # this value because the value was one of our known implementations."
NSQ_SOURCE_LINE 00000074 "        ($requested) = $requested =~ /^(.+)$/;"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "        try {"
NSQ_SOURCE_LINE 00000077 "            require_module($requested);"
NSQ_SOURCE_LINE 00000078 "        }"
NSQ_SOURCE_LINE 00000079 "        catch {"
NSQ_SOURCE_LINE 00000080 "            require Carp;"
NSQ_SOURCE_LINE 00000081 "            Carp::croak(\"Could not load $requested: $_\");"
NSQ_SOURCE_LINE 00000082 "        };"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "        return ( $env_value, $requested );"
NSQ_SOURCE_LINE 00000085 "    }"
NSQ_SOURCE_LINE 00000086 "    else {"
NSQ_SOURCE_LINE 00000087 "        my $err;"
NSQ_SOURCE_LINE 00000088 "        for my $possible ( @{$implementations} ) {"
NSQ_SOURCE_LINE 00000089 "            my $try = \"${package}::$possible\";"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "            my $ok;"
NSQ_SOURCE_LINE 00000092 "            try {"
NSQ_SOURCE_LINE 00000093 "                require_module($try);"
NSQ_SOURCE_LINE 00000094 "                $ok = 1;"
NSQ_SOURCE_LINE 00000095 "            }"
NSQ_SOURCE_LINE 00000096 "            catch {"
NSQ_SOURCE_LINE 00000097 "                $err .= $_ if defined $_;"
NSQ_SOURCE_LINE 00000098 "            };"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "            return ( $possible, $try ) if $ok;"
NSQ_SOURCE_LINE 00000101 "        }"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "        require Carp;"
NSQ_SOURCE_LINE 00000104 "        if ( defined $err && length $err ) {"
NSQ_SOURCE_LINE 00000105 "            Carp::croak("
NSQ_SOURCE_LINE 00000106 "                \"Could not find a suitable $package implementation: $err\");"
NSQ_SOURCE_LINE 00000107 "        }"
NSQ_SOURCE_LINE 00000108 "        else {"
NSQ_SOURCE_LINE 00000109 "            Carp::croak("
NSQ_SOURCE_LINE 00000110 "                'Module::Runtime failed to load a module but did not throw a real error. This should never happen. Something is very broken'"
NSQ_SOURCE_LINE 00000111 "            );"
NSQ_SOURCE_LINE 00000112 "        }"
NSQ_SOURCE_LINE 00000113 "    }"
NSQ_SOURCE_LINE 00000114 "}"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "sub _copy_symbols {"
NSQ_SOURCE_LINE 00000117 "    my $from_package = shift;"
NSQ_SOURCE_LINE 00000118 "    my $to_package   = shift;"
NSQ_SOURCE_LINE 00000119 "    my $symbols      = shift;"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "    for my $sym ( @{$symbols} ) {"
NSQ_SOURCE_LINE 00000122 "        my $type = $sym =~ s/^([\\$\\@\\%\\&\\*])// ? $1 : '&';"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "        my $from = \"${from_package}::$sym\";"
NSQ_SOURCE_LINE 00000125 "        my $to   = \"${to_package}::$sym\";"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "        {"
NSQ_SOURCE_LINE 00000128 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000129 "            no warnings 'once';"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "            # Copied from Exporter"
NSQ_SOURCE_LINE 00000132 "            *{$to}"
NSQ_SOURCE_LINE 00000133 "                = $type eq '&' ? \\&{$from}"
NSQ_SOURCE_LINE 00000134 "                : $type eq '$' ? \\${$from}"
NSQ_SOURCE_LINE 00000135 "                : $type eq '@' ? \\@{$from}"
NSQ_SOURCE_LINE 00000136 "                : $type eq '%' ? \\%{$from}"
NSQ_SOURCE_LINE 00000137 "                : $type eq '*' ? *{$from}"
NSQ_SOURCE_LINE 00000138 "                : die"
NSQ_SOURCE_LINE 00000139 "                \"Can't copy symbol from $from_package to $to_package: $type$sym\";"
NSQ_SOURCE_LINE 00000140 "        }"
NSQ_SOURCE_LINE 00000141 "    }"
NSQ_SOURCE_LINE 00000142 "}"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "1;"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "# ABSTRACT: Loads one of several alternate underlying implementations for a module"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "__END__"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=pod"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "=head1 NAME"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "Module::Implementation - Loads one of several alternate underlying implementations for a module"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=head1 VERSION"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "version 0.09"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "  package Foo::Bar;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "  use Module::Implementation;"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "  BEGIN {"
NSQ_SOURCE_LINE 00000169 "      my $loader = Module::Implementation::build_loader_sub("
NSQ_SOURCE_LINE 00000170 "          implementations => [ 'XS',  'PurePerl' ],"
NSQ_SOURCE_LINE 00000171 "          symbols         => [ 'run', 'check' ],"
NSQ_SOURCE_LINE 00000172 "      );"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "      $loader->();"
NSQ_SOURCE_LINE 00000175 "  }"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "  package Consumer;"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "  # loads the first viable implementation"
NSQ_SOURCE_LINE 00000180 "  use Foo::Bar;"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "This module abstracts out the process of choosing one of several underlying"
NSQ_SOURCE_LINE 00000185 "implementations for a module. This can be used to provide XS and pure Perl"
NSQ_SOURCE_LINE 00000186 "implementations of a module, or it could be used to load an implementation for"
NSQ_SOURCE_LINE 00000187 "a given OS or any other case of needing to provide multiple implementations."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "This module is only useful when you know all the implementations ahead of"
NSQ_SOURCE_LINE 00000190 "time. If you want to load arbitrary implementations then you probably want"
NSQ_SOURCE_LINE 00000191 "something like a plugin system, not this module."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=head1 API"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "This module provides two subroutines, neither of which are exported."
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "=head2 Module::Implementation::build_loader_sub(...)"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "This subroutine takes the following arguments."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=over 4"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=item * implementations"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "This should be an array reference of implementation names. Each name should"
NSQ_SOURCE_LINE 00000206 "correspond to a module in the caller's namespace."
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "In other words, using the example in the L</SYNOPSIS>, this module will look"
NSQ_SOURCE_LINE 00000209 "for the C<Foo::Bar::XS> and C<Foo::Bar::PurePerl> modules."
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "This argument is required."
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "=item * symbols"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "A list of symbols to copy from the implementation package to the calling"
NSQ_SOURCE_LINE 00000216 "package."
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "These can be prefixed with a variable type: C<$>, C<@>, C<%>, C<&>, or"
NSQ_SOURCE_LINE 00000219 "C<*)>. If no prefix is given, the symbol is assumed to be a subroutine."
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "This argument is optional."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=back"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "This subroutine I<returns> the implementation loader as a sub reference."
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "It is up to you to call this loader sub in your code."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "I recommend that you I<do not> call this loader in an C<import()> sub. If a"
NSQ_SOURCE_LINE 00000230 "caller explicitly requests no imports, your C<import()> sub will not be run at"
NSQ_SOURCE_LINE 00000231 "all, which can cause weird breakage."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=head2 Module::Implementation::implementation_for($package)"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "Given a package name, this subroutine returns the implementation that was"
NSQ_SOURCE_LINE 00000236 "loaded for the package. This is not a full package name, just the suffix that"
NSQ_SOURCE_LINE 00000237 "identifies the implementation. For the L</SYNOPSIS> example, this subroutine"
NSQ_SOURCE_LINE 00000238 "would be called as C<Module::Implementation::implementation_for('Foo::Bar')>,"
NSQ_SOURCE_LINE 00000239 "and it would return \"XS\" or \"PurePerl\"."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=head1 HOW THE IMPLEMENTATION LOADER WORKS"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "The implementation loader works like this ..."
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "First, it checks for an C<%ENV> var specifying the implementation to load. The"
NSQ_SOURCE_LINE 00000246 "env var is based on the package name which loads the implementations. The"
NSQ_SOURCE_LINE 00000247 "C<::> package separator is replaced with C<_>, and made entirely"
NSQ_SOURCE_LINE 00000248 "upper-case. Finally, we append \"_IMPLEMENTATION\" to this name."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "So in our L</SYNOPSIS> example, the corresponding C<%ENV> key would be"
NSQ_SOURCE_LINE 00000251 "C<FOO_BAR_IMPLEMENTATION>."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "If this is set, then the loader will B<only> try to load this one"
NSQ_SOURCE_LINE 00000254 "implementation."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "If the env var requests an implementation which doesn't match one of the"
NSQ_SOURCE_LINE 00000257 "implementations specified when the loader was created, an error is thrown."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "If this one implementation fails to load then loader throws an error. This is"
NSQ_SOURCE_LINE 00000260 "useful for testing. You can request a specific implementation in a test file"
NSQ_SOURCE_LINE 00000261 "by writing something like this:"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "  BEGIN { $ENV{FOO_BAR_IMPLEMENTATION} = 'XS' }"
NSQ_SOURCE_LINE 00000264 "  use Foo::Bar;"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "If the environment variable is I<not> set, then the loader simply tries the"
NSQ_SOURCE_LINE 00000267 "implementations originally passed to C<Module::Implementation>. The"
NSQ_SOURCE_LINE 00000268 "implementations are tried in the order in which they were originally passed."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "The loader will use the first implementation that loads without an error. It"
NSQ_SOURCE_LINE 00000271 "will copy any requested symbols from this implementation."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "If none of the implementations can be loaded, then the loader throws an"
NSQ_SOURCE_LINE 00000274 "exception."
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "The loader returns the name of the package it loaded."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "Dave Rolsky <autarch@urth.org>"
