NSQ_SOURCE_LINE 00000001 "#============================================================= -*-perl-*-"
NSQ_SOURCE_LINE 00000002 "#"
NSQ_SOURCE_LINE 00000003 "# Template"
NSQ_SOURCE_LINE 00000004 "#"
NSQ_SOURCE_LINE 00000005 "# DESCRIPTION"
NSQ_SOURCE_LINE 00000006 "#   Module implementing a simple, user-oriented front-end to the Template"
NSQ_SOURCE_LINE 00000007 "#   Toolkit."
NSQ_SOURCE_LINE 00000008 "#"
NSQ_SOURCE_LINE 00000009 "# AUTHOR"
NSQ_SOURCE_LINE 00000010 "#   Andy Wardley   <abw@wardley.org>"
NSQ_SOURCE_LINE 00000011 "#"
NSQ_SOURCE_LINE 00000012 "# COPYRIGHT"
NSQ_SOURCE_LINE 00000013 "#   Copyright (C) 1996-2022 Andy Wardley.  All Rights Reserved."
NSQ_SOURCE_LINE 00000014 "#"
NSQ_SOURCE_LINE 00000015 "#   This module is free software; you can redistribute it and/or"
NSQ_SOURCE_LINE 00000016 "#   modify it under the same terms as Perl itself."
NSQ_SOURCE_LINE 00000017 "#"
NSQ_SOURCE_LINE 00000018 "#========================================================================"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "package Template;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "use strict;"
NSQ_SOURCE_LINE 00000023 "use warnings;"
NSQ_SOURCE_LINE 00000024 "use 5.006;"
NSQ_SOURCE_LINE 00000025 "use base 'Template::Base';"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "use Template::Config;"
NSQ_SOURCE_LINE 00000028 "use Template::Constants;"
NSQ_SOURCE_LINE 00000029 "use Template::Provider;"
NSQ_SOURCE_LINE 00000030 "use Template::Service;"
NSQ_SOURCE_LINE 00000031 "use File::Basename;"
NSQ_SOURCE_LINE 00000032 "use File::Path;"
NSQ_SOURCE_LINE 00000033 "use Scalar::Util qw(blessed);"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "our $VERSION = '3.102';"
NSQ_SOURCE_LINE 00000036 "our $ERROR   = '';"
NSQ_SOURCE_LINE 00000037 "our $DEBUG   = 0;"
NSQ_SOURCE_LINE 00000038 "our $BINMODE = 0 unless defined $BINMODE;"
NSQ_SOURCE_LINE 00000039 "our $AUTOLOAD;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "# preload all modules if we're running under mod_perl"
NSQ_SOURCE_LINE 00000042 "Template::Config->preload() if $ENV{ MOD_PERL };"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000046 "# process($input, \\%replace, $output)"
NSQ_SOURCE_LINE 00000047 "#"
NSQ_SOURCE_LINE 00000048 "# Main entry point for the Template Toolkit.  The Template module"
NSQ_SOURCE_LINE 00000049 "# delegates most of the processing effort to the underlying SERVICE"
NSQ_SOURCE_LINE 00000050 "# object, an instance of the Template::Service class."
NSQ_SOURCE_LINE 00000051 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "sub process {"
NSQ_SOURCE_LINE 00000054 "    my ($self, $template, $vars, $outstream, @opts) = @_;"
NSQ_SOURCE_LINE 00000055 "    my ($output, $error);"
NSQ_SOURCE_LINE 00000056 "    my $options = (@opts == 1) && ref($opts[0]) eq 'HASH'"
NSQ_SOURCE_LINE 00000057 "        ? shift(@opts) : { @opts };"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    $options->{ binmode } = $BINMODE"
NSQ_SOURCE_LINE 00000060 "        unless defined $options->{ binmode };"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    # we're using this for testing in t/output.t and t/filter.t so"
NSQ_SOURCE_LINE 00000063 "    # don't remove it if you don't want tests to fail..."
NSQ_SOURCE_LINE 00000064 "    $self->DEBUG(\"set binmode\\n\") if $DEBUG && $options->{ binmode };"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    $output = $self->{ SERVICE }->process($template, $vars);"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    if (defined $output) {"
NSQ_SOURCE_LINE 00000069 "        $outstream ||= $self->{ OUTPUT };"
NSQ_SOURCE_LINE 00000070 "        unless (ref $outstream) {"
NSQ_SOURCE_LINE 00000071 "            my $outpath = $self->{ OUTPUT_PATH };"
NSQ_SOURCE_LINE 00000072 "            $outstream = \"$outpath/$outstream\" if $outpath;"
NSQ_SOURCE_LINE 00000073 "        }"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "        # send processed template to output stream, checking for error"
NSQ_SOURCE_LINE 00000076 "        return ($self->error($error))"
NSQ_SOURCE_LINE 00000077 "            if ($error = &_output($outstream, \\$output, $options));"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "        return 1;"
NSQ_SOURCE_LINE 00000080 "    }"
NSQ_SOURCE_LINE 00000081 "    else {"
NSQ_SOURCE_LINE 00000082 "        return $self->error($self->{ SERVICE }->error);"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000088 "# service()"
NSQ_SOURCE_LINE 00000089 "#"
NSQ_SOURCE_LINE 00000090 "# Returns a reference to the internal SERVICE object which handles"
NSQ_SOURCE_LINE 00000091 "# all requests for this Template object"
NSQ_SOURCE_LINE 00000092 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "sub service {"
NSQ_SOURCE_LINE 00000095 "    my $self = shift;"
NSQ_SOURCE_LINE 00000096 "    return $self->{ SERVICE };"
NSQ_SOURCE_LINE 00000097 "}"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000101 "# context()"
NSQ_SOURCE_LINE 00000102 "#"
NSQ_SOURCE_LINE 00000103 "# Returns a reference to the CONTEXT object within the SERVICE"
NSQ_SOURCE_LINE 00000104 "# object."
NSQ_SOURCE_LINE 00000105 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "sub context {"
NSQ_SOURCE_LINE 00000108 "    my $self = shift;"
NSQ_SOURCE_LINE 00000109 "    return $self->{ SERVICE }->{ CONTEXT };"
NSQ_SOURCE_LINE 00000110 "}"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "sub template {"
NSQ_SOURCE_LINE 00000113 "    shift->context->template(@_);"
NSQ_SOURCE_LINE 00000114 "}"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "#========================================================================"
NSQ_SOURCE_LINE 00000118 "#                     -- PRIVATE METHODS --"
NSQ_SOURCE_LINE 00000119 "#========================================================================"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000122 "# _init(\\%config)"
NSQ_SOURCE_LINE 00000123 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000124 "sub _init {"
NSQ_SOURCE_LINE 00000125 "    my ($self, $config) = @_;"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "    # convert any textual DEBUG args to numerical form"
NSQ_SOURCE_LINE 00000128 "    my $debug = $config->{ DEBUG };"
NSQ_SOURCE_LINE 00000129 "    $config->{ DEBUG } = Template::Constants::debug_flags($self, $debug)"
NSQ_SOURCE_LINE 00000130 "        || return if defined $debug && $debug !~ /^\\d+$/;"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    # prepare a namespace handler for any CONSTANTS definition"
NSQ_SOURCE_LINE 00000133 "    if (my $constants = $config->{ CONSTANTS }) {"
NSQ_SOURCE_LINE 00000134 "        my $ns  = $config->{ NAMESPACE } ||= { };"
NSQ_SOURCE_LINE 00000135 "        my $cns = $config->{ CONSTANTS_NAMESPACE } || 'constants';"
NSQ_SOURCE_LINE 00000136 "        $constants = Template::Config->constants($constants)"
NSQ_SOURCE_LINE 00000137 "            || return $self->error(Template::Config->error);"
NSQ_SOURCE_LINE 00000138 "        $ns->{ $cns } = $constants;"
NSQ_SOURCE_LINE 00000139 "    }"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    $self->{ SERVICE } = $config->{ SERVICE }"
NSQ_SOURCE_LINE 00000142 "        || Template::Config->service($config)"
NSQ_SOURCE_LINE 00000143 "        || return $self->error(Template::Config->error);"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    $self->{ OUTPUT      } = $config->{ OUTPUT } || \\*STDOUT;"
NSQ_SOURCE_LINE 00000146 "    $self->{ OUTPUT_PATH } = $config->{ OUTPUT_PATH };"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    return $self;"
NSQ_SOURCE_LINE 00000149 "}"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000153 "# _output($where, $text)"
NSQ_SOURCE_LINE 00000154 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "sub _output {"
NSQ_SOURCE_LINE 00000157 "    my ($where, $textref, $options) = @_;"
NSQ_SOURCE_LINE 00000158 "    my $reftype;"
NSQ_SOURCE_LINE 00000159 "    my $error = 0;"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    # call a CODE reference"
NSQ_SOURCE_LINE 00000162 "    if (($reftype = ref($where)) eq 'CODE') {"
NSQ_SOURCE_LINE 00000163 "        &$where($$textref);"
NSQ_SOURCE_LINE 00000164 "    }"
NSQ_SOURCE_LINE 00000165 "    # print to a glob (such as \\*STDOUT)"
NSQ_SOURCE_LINE 00000166 "    elsif ($reftype eq 'GLOB') {"
NSQ_SOURCE_LINE 00000167 "        print $where $$textref;"
NSQ_SOURCE_LINE 00000168 "    }"
NSQ_SOURCE_LINE 00000169 "    # append output to a SCALAR ref"
NSQ_SOURCE_LINE 00000170 "    elsif ($reftype eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000171 "        $$where .= $$textref;"
NSQ_SOURCE_LINE 00000172 "    }"
NSQ_SOURCE_LINE 00000173 "    # push onto ARRAY ref"
NSQ_SOURCE_LINE 00000174 "    elsif ($reftype eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000175 "        push @$where, $$textref;"
NSQ_SOURCE_LINE 00000176 "    }"
NSQ_SOURCE_LINE 00000177 "    # call the print() method on an object that implements the method"
NSQ_SOURCE_LINE 00000178 "    # (e.g. IO::Handle, Apache::Request, etc)"
NSQ_SOURCE_LINE 00000179 "    elsif (blessed($where) && $where->can('print')) {"
NSQ_SOURCE_LINE 00000180 "        $where->print($$textref);"
NSQ_SOURCE_LINE 00000181 "    }"
NSQ_SOURCE_LINE 00000182 "    # a simple string is taken as a filename"
NSQ_SOURCE_LINE 00000183 "    elsif (! $reftype) {"
NSQ_SOURCE_LINE 00000184 "        local *FP;"
NSQ_SOURCE_LINE 00000185 "        # make destination directory if it doesn't exist"
NSQ_SOURCE_LINE 00000186 "        my $dir = dirname($where);"
NSQ_SOURCE_LINE 00000187 "        eval { mkpath($dir) unless -d $dir; };"
NSQ_SOURCE_LINE 00000188 "        if ($@) {"
NSQ_SOURCE_LINE 00000189 "            # strip file name and line number from error raised by die()"
NSQ_SOURCE_LINE 00000190 "            ($error = $@) =~ s/ at \\S+ line \\d+\\n?$//;"
NSQ_SOURCE_LINE 00000191 "        }"
NSQ_SOURCE_LINE 00000192 "        elsif (open(FP, '>', $where)) {"
NSQ_SOURCE_LINE 00000193 "            # binmode option can be 1 or a specific layer, e.g. :utf8"
NSQ_SOURCE_LINE 00000194 "            my $bm = $options->{ binmode  };"
NSQ_SOURCE_LINE 00000195 "            if (not(defined $bm)) {"
NSQ_SOURCE_LINE 00000196 "              $bm = $BINMODE;"
NSQ_SOURCE_LINE 00000197 "            }"
NSQ_SOURCE_LINE 00000198 "            if ($bm && $bm eq 1) {"
NSQ_SOURCE_LINE 00000199 "                binmode FP;"
NSQ_SOURCE_LINE 00000200 "            }"
NSQ_SOURCE_LINE 00000201 "            elsif ($bm){"
NSQ_SOURCE_LINE 00000202 "                binmode FP, $bm;"
NSQ_SOURCE_LINE 00000203 "            }"
NSQ_SOURCE_LINE 00000204 "            print FP $$textref;"
NSQ_SOURCE_LINE 00000205 "            close FP;"
NSQ_SOURCE_LINE 00000206 "        }"
NSQ_SOURCE_LINE 00000207 "        else {"
NSQ_SOURCE_LINE 00000208 "            $error  = \"$where: $!\";"
NSQ_SOURCE_LINE 00000209 "        }"
NSQ_SOURCE_LINE 00000210 "    }"
NSQ_SOURCE_LINE 00000211 "    # give up, we've done our best"
NSQ_SOURCE_LINE 00000212 "    else {"
NSQ_SOURCE_LINE 00000213 "        $error = \"output_handler() cannot determine target type ($where)\\n\";"
NSQ_SOURCE_LINE 00000214 "    }"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    return $error;"
NSQ_SOURCE_LINE 00000217 "}"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "1;"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "__END__"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=head1 NAME"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "Template - Front-end module to the Template Toolkit"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "    use Template;"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    # some useful options (see below for full list)"
NSQ_SOURCE_LINE 00000233 "    my $config = {"
NSQ_SOURCE_LINE 00000234 "        INCLUDE_PATH => '/search/path',  # or list ref"
NSQ_SOURCE_LINE 00000235 "        INTERPOLATE  => 1,               # expand \"$var\" in plain text"
NSQ_SOURCE_LINE 00000236 "        POST_CHOMP   => 1,               # cleanup whitespace"
NSQ_SOURCE_LINE 00000237 "        PRE_PROCESS  => 'header',        # prefix each template"
NSQ_SOURCE_LINE 00000238 "        EVAL_PERL    => 1,               # evaluate Perl code blocks"
NSQ_SOURCE_LINE 00000239 "    };"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    # create Template object"
NSQ_SOURCE_LINE 00000242 "    my $template = Template->new($config);"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "    # define template variables for replacement"
NSQ_SOURCE_LINE 00000245 "    my $vars = {"
NSQ_SOURCE_LINE 00000246 "        var1  => $value,"
NSQ_SOURCE_LINE 00000247 "        var2  => \\%hash,"
NSQ_SOURCE_LINE 00000248 "        var3  => \\@list,"
NSQ_SOURCE_LINE 00000249 "        var4  => \\&code,"
NSQ_SOURCE_LINE 00000250 "        var5  => $object,"
NSQ_SOURCE_LINE 00000251 "    };"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "    # specify input filename, or file handle, text reference, etc."
NSQ_SOURCE_LINE 00000254 "    my $input = 'myfile.html';"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "    # process input template, substituting variables"
NSQ_SOURCE_LINE 00000257 "    $template->process($input, $vars)"
NSQ_SOURCE_LINE 00000258 "        || die $template->error();"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "This documentation describes the Template module which is the direct"
NSQ_SOURCE_LINE 00000263 "Perl interface into the Template Toolkit.  It covers the use of the"
NSQ_SOURCE_LINE 00000264 "module and gives a brief summary of configuration options and template"
NSQ_SOURCE_LINE 00000265 "directives.  Please see L<Template::Manual> for the complete reference"
NSQ_SOURCE_LINE 00000266 "manual which goes into much greater depth about the features and use"
NSQ_SOURCE_LINE 00000267 "of the Template Toolkit.  The L<Template::Tutorial> is also available"
NSQ_SOURCE_LINE 00000268 "as an introductory guide to using the Template Toolkit."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "=head1 METHODS"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "=head2 new(\\%config)"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "The C<new()> constructor method (implemented by the"
NSQ_SOURCE_LINE 00000275 "L<Template::Base|Template::Base#new()> base class) instantiates a new"
NSQ_SOURCE_LINE 00000276 "C<Template> object. A reference to a hash array of configuration items may be"
NSQ_SOURCE_LINE 00000277 "passed as a parameter."
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "    my $tt = Template->new({"
NSQ_SOURCE_LINE 00000280 "        INCLUDE_PATH => '/usr/local/templates',"
NSQ_SOURCE_LINE 00000281 "        EVAL_PERL    => 1,"
NSQ_SOURCE_LINE 00000282 "    }) || die $Template::ERROR, \"\\n\";"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "A reference to a new C<Template> object is returned, or undef on error. In the"
NSQ_SOURCE_LINE 00000285 "latter case, the error message can be retrieved by calling L<error()> as a"
NSQ_SOURCE_LINE 00000286 "class method or by examining the C<$Template::ERROR> package variable"
NSQ_SOURCE_LINE 00000287 "directly."
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "    my $tt = Template->new(\\%config)"
NSQ_SOURCE_LINE 00000290 "        || die Template->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "    my $tt = Template->new(\\%config)"
NSQ_SOURCE_LINE 00000293 "        || die $Template::ERROR, \"\\n\";"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "For convenience, configuration items may also be specified as a list"
NSQ_SOURCE_LINE 00000296 "of items instead of a hash array reference.  These are automatically"
NSQ_SOURCE_LINE 00000297 "folded into a hash array by the constructor."
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "    my $tt = Template->new(INCLUDE_PATH => '/tmp', POST_CHOMP => 1)"
NSQ_SOURCE_LINE 00000300 "        || die $Template::ERROR, \"\\n\";"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=head2 process($template, \\%vars, $output, %options)"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "The C<process()> method is called to process a template. The first parameter"
NSQ_SOURCE_LINE 00000305 "indicates the input template as one of:"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=over 4"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=item *"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "a filename relative to C<INCLUDE_PATH>, if defined"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "=item *"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "a reference to a text string containing the template text"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=item *"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "a file handle reference (e.g. C<IO::Handle> or sub-class) or C<GLOB>"
NSQ_SOURCE_LINE 00000320 "(e.g. C<\\*STDIN>), from which the template can be read."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=back"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "A reference to"
NSQ_SOURCE_LINE 00000325 "a hash array may be passed as the second parameter, containing definitions of"
NSQ_SOURCE_LINE 00000326 "template variables."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "    # filename"
NSQ_SOURCE_LINE 00000329 "    $tt->process('welcome.tt2')"
NSQ_SOURCE_LINE 00000330 "        || die $tt->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "    # text reference"
NSQ_SOURCE_LINE 00000333 "    $text = \"[% INCLUDE header %]\\nHello world!\\n[% INCLUDE footer %]\";"
NSQ_SOURCE_LINE 00000334 "    $tt->process(\\$text)"
NSQ_SOURCE_LINE 00000335 "        || die $tt->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "    # file handle (GLOB)"
NSQ_SOURCE_LINE 00000338 "    $tt->process(\\*DATA)"
NSQ_SOURCE_LINE 00000339 "        || die $tt->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "    __END__"
NSQ_SOURCE_LINE 00000342 "    [% INCLUDE header %]"
NSQ_SOURCE_LINE 00000343 "    This is a template defined in the __END__ section which is"
NSQ_SOURCE_LINE 00000344 "    accessible via the DATA \"file handle\"."
NSQ_SOURCE_LINE 00000345 "    [% INCLUDE footer %]"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "By default, the processed template output is printed to C<STDOUT>. The"
NSQ_SOURCE_LINE 00000348 "C<process()> method then returns C<1> to indicate success. A third parameter"
NSQ_SOURCE_LINE 00000349 "may be passed to the C<process()> method to specify a different output location."
NSQ_SOURCE_LINE 00000350 "This value may be one of:"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=over 4"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=item *"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "a plain string indicating a filename which will be opened (relative to"
NSQ_SOURCE_LINE 00000357 "C<OUTPUT_PATH>, if defined) and the output written to"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=item *"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "a file GLOB opened ready for output"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=item *"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "a reference to a scalar (e.g. a text string) to which output/error is appended"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=item *"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "a reference to a subroutine which is called, passing the output as a parameter"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=item *"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "any object reference which implements a C<print()> method (e.g. C<IO::Handle>,"
NSQ_SOURCE_LINE 00000374 "C<Apache::Request>, etc.) which will be called, passing the generated output"
NSQ_SOURCE_LINE 00000375 "as a parameter."
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "=back"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "Examples:"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "    # output filename"
NSQ_SOURCE_LINE 00000382 "    $tt->process('welcome.tt2', $vars, 'welcome.html')"
NSQ_SOURCE_LINE 00000383 "        || die $tt->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "    # reference to output subroutine"
NSQ_SOURCE_LINE 00000386 "    sub myout {"
NSQ_SOURCE_LINE 00000387 "        my $output = shift;"
NSQ_SOURCE_LINE 00000388 "        ..."
NSQ_SOURCE_LINE 00000389 "    }"
NSQ_SOURCE_LINE 00000390 "    $tt->process('welcome.tt2', $vars, \\&myout)"
NSQ_SOURCE_LINE 00000391 "        || die $tt->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "    # reference to output text string"
NSQ_SOURCE_LINE 00000394 "    my $output = '';"
NSQ_SOURCE_LINE 00000395 "    $tt->process('welcome.tt2', $vars, \\$output)"
NSQ_SOURCE_LINE 00000396 "        || die $tt->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "    print \"output: $output\\n\";"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "In an Apache/mod_perl handler:"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "    sub handler {"
NSQ_SOURCE_LINE 00000403 "        my $req = shift;"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "        # ...your code here..."
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "        # direct output to Apache::Request via $req->print($output)"
NSQ_SOURCE_LINE 00000408 "        $tt->process($file, $vars, $req) || do {"
NSQ_SOURCE_LINE 00000409 "            $req->log_reason($tt->error());"
NSQ_SOURCE_LINE 00000410 "            return SERVER_ERROR;"
NSQ_SOURCE_LINE 00000411 "        };"
NSQ_SOURCE_LINE 00000412 "        return OK;"
NSQ_SOURCE_LINE 00000413 "    }"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "After the optional third output argument can come an optional"
NSQ_SOURCE_LINE 00000416 "reference to a hash or a list of C<(name, value)> pairs providing further"
NSQ_SOURCE_LINE 00000417 "options for the output.  The only option currently supported is"
NSQ_SOURCE_LINE 00000418 "C<binmode> which, when set to any true value will ensure that files"
NSQ_SOURCE_LINE 00000419 "created (but not any existing file handles passed) will be set to"
NSQ_SOURCE_LINE 00000420 "binary mode."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "    # either: hash reference of options"
NSQ_SOURCE_LINE 00000423 "    $tt->process($infile, $vars, $outfile, { binmode => 1 })"
NSQ_SOURCE_LINE 00000424 "        || die $tt->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "    # or: list of name, value pairs"
NSQ_SOURCE_LINE 00000427 "    $tt->process($infile, $vars, $outfile, binmode => 1)"
NSQ_SOURCE_LINE 00000428 "        || die $tt->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "Alternately, the C<binmode> argument can specify a particular IO layer such"
NSQ_SOURCE_LINE 00000431 "as C<:utf8>."
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "    $tt->process($infile, $vars, $outfile, binmode => ':utf8')"
NSQ_SOURCE_LINE 00000434 "        || die $tt->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "The C<OUTPUT> configuration item can be used to specify a default output"
NSQ_SOURCE_LINE 00000437 "location other than C<\\*STDOUT>.  The C<OUTPUT_PATH> specifies a directory"
NSQ_SOURCE_LINE 00000438 "which should be prefixed to all output locations specified as filenames."
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "    my $tt = Template->new({"
NSQ_SOURCE_LINE 00000441 "        OUTPUT      => sub { ... },       # default"
NSQ_SOURCE_LINE 00000442 "        OUTPUT_PATH => '/tmp',"
NSQ_SOURCE_LINE 00000443 "    ..."
NSQ_SOURCE_LINE 00000444 "    }) || die Template->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "    # use default OUTPUT (sub is called)"
NSQ_SOURCE_LINE 00000447 "    $tt->process('welcome.tt2', $vars)"
NSQ_SOURCE_LINE 00000448 "        || die $tt->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "    # write file to '/tmp/welcome.html'"
NSQ_SOURCE_LINE 00000451 "    $tt->process('welcome.tt2', $vars, 'welcome.html')"
NSQ_SOURCE_LINE 00000452 "        || die $tt->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "The C<process()> method returns C<1> on success or C<undef> on error. The"
NSQ_SOURCE_LINE 00000455 "error message generated in the latter case can be retrieved by calling the"
NSQ_SOURCE_LINE 00000456 "L<error()> method. See also L<CONFIGURATION SUMMARY> which describes how error"
NSQ_SOURCE_LINE 00000457 "handling may be further customised."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "=head2 error()"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "When called as a class method, it returns the value of the C<$ERROR> package"
NSQ_SOURCE_LINE 00000462 "variable.  Thus, the following are equivalent."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "    my $tt = Template->new()"
NSQ_SOURCE_LINE 00000465 "        || die Template->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "    my $tt = Template->new()"
NSQ_SOURCE_LINE 00000468 "        || die $Template::ERROR, \"\\n\";"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "When called as an object method, it returns the value of the internal"
NSQ_SOURCE_LINE 00000471 "C<_ERROR> variable, as set by an error condition in a previous call to"
NSQ_SOURCE_LINE 00000472 "process()."
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "    $tt->process('welcome.tt2')"
NSQ_SOURCE_LINE 00000475 "        || die $tt->error(), \"\\n\";"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "Errors are represented in the Template Toolkit by objects of the"
NSQ_SOURCE_LINE 00000478 "L<Template::Exception> class. If the L<process()> method returns a false value"
NSQ_SOURCE_LINE 00000479 "then the C<error()> method can be called to return an object of this class."
NSQ_SOURCE_LINE 00000480 "The L<type()|Template::Exception#type()> and"
NSQ_SOURCE_LINE 00000481 "L<info()|Template::Exception#info()> methods can called on the object to"
NSQ_SOURCE_LINE 00000482 "retrieve the error type and information string, respectively. The"
NSQ_SOURCE_LINE 00000483 "L<as_string()|Template::Exception#as_string()>"
NSQ_SOURCE_LINE 00000484 "method can be called to return a string of the form C<$type - $info>. This"
NSQ_SOURCE_LINE 00000485 "method is also overloaded onto the stringification operator allowing the"
NSQ_SOURCE_LINE 00000486 "object reference itself to be printed to return the formatted error string."
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "    $tt->process('somefile') || do {"
NSQ_SOURCE_LINE 00000489 "        my $error = $tt->error();"
NSQ_SOURCE_LINE 00000490 "        print \"error type: \", $error->type(), \"\\n\";"
NSQ_SOURCE_LINE 00000491 "        print \"error info: \", $error->info(), \"\\n\";"
NSQ_SOURCE_LINE 00000492 "        print $error, \"\\n\";"
NSQ_SOURCE_LINE 00000493 "    };"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "=head2 service()"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "The C<Template> module delegates most of the effort of processing templates"
NSQ_SOURCE_LINE 00000498 "to an underlying L<Template::Service> object.  This method returns a reference"
NSQ_SOURCE_LINE 00000499 "to that object."
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=head2 context()"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "The L<Template::Service> module uses a core L<Template::Context> object for"
NSQ_SOURCE_LINE 00000504 "runtime processing of templates.  This method returns a reference to"
NSQ_SOURCE_LINE 00000505 "that object and is equivalent to C<< $template-E<gt>service-E<gt>context() >>."
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "=head2 template($name)"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "This method is a simple wrapper around the L<Template::Context> method of the"
NSQ_SOURCE_LINE 00000510 "same name.  It returns a compiled template for the source provided as an"
NSQ_SOURCE_LINE 00000511 "argument."
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "=head1 CONFIGURATION SUMMARY"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "The following list gives a short summary of each Template Toolkit"
NSQ_SOURCE_LINE 00000516 "configuration option.  See L<Template::Manual::Config> for full details."
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "=head2 Template Style and Parsing Options"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=head3 ENCODING"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "Specifies the character encoding."
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "=head3 START_TAG, END_TAG"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "Define tokens that indicate start and end of directives"
NSQ_SOURCE_LINE 00000527 "(default: 'C<[%>' and 'C<%]>')."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=head3 TAG_STYLE"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "Set C<START_TAG> and C<END_TAG> according to a pre-defined style (default:"
NSQ_SOURCE_LINE 00000532 "'C<template>', as above)."
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=head3 PRE_CHOMP, POST_CHOMP"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "Removes whitespace before/after directives (default: 0/0)."
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "=head3 TRIM"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "Remove leading and trailing whitespace from template output (default: 0)."
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "=head3 INTERPOLATE"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "Interpolate variables embedded like C<$this> or C<${this}> (default: 0)."
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "=head3 ANYCASE"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "Allow directive keywords in lower case (default: 0 - UPPER only)."
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "=head2 Template Files and Blocks"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "=head3 INCLUDE_PATH"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "One or more directories to search for templates."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "=head3 DELIMITER"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "Delimiter for separating paths in C<INCLUDE_PATH> (default: 'C<:>')."
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "=head3 ABSOLUTE"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "Allow absolute file names, e.g. C</foo/bar.html> (default: 0)."
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "=head3 RELATIVE"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "Allow relative filenames, e.g. C<../foo/bar.html> (default: 0)."
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "=head3 DEFAULT"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "Default template to use when another not found."
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "=head3 BLOCKS"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "Hash array pre-defining template blocks."
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "=head3 AUTO_RESET"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "Enabled by default causing C<BLOCK> definitions to be reset each time a"
NSQ_SOURCE_LINE 00000579 "template is processed.  Disable to allow C<BLOCK> definitions to persist."
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "=head3 RECURSION"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "Flag to permit recursion into templates (default: 0)."
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "=head2 Template Variables"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "=head3 VARIABLES"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "Hash array of variables and values to pre-define in the stash."
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "=head2 Runtime Processing Options"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=head3 EVAL_PERL"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "Flag to indicate if C<PERL>/C<RAWPERL> blocks should be processed (default: 0)."
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "=head3 PRE_PROCESS, POST_PROCESS"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "Name of template(s) to process before/after main template."
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "=head3 PROCESS"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "Name of template(s) to process instead of main template."
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "=head3 ERROR"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "Name of error template or reference to hash array mapping error types to"
NSQ_SOURCE_LINE 00000608 "templates."
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "=head3 OUTPUT"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "Default output location or handler."
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "=head3 OUTPUT_PATH"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "Directory into which output files can be written."
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "=head3 DEBUG"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "Enable debugging messages."
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "=head2 Caching and Compiling Options"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "=head3 CACHE_SIZE"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "Maximum number of compiled templates to cache in memory (default:"
NSQ_SOURCE_LINE 00000627 "undef - cache all)"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "=head3 COMPILE_EXT"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "Filename extension for compiled template files (default: undef - don't"
NSQ_SOURCE_LINE 00000632 "compile)."
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "=head3 COMPILE_DIR"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "Root of directory in which compiled template files should be written"
NSQ_SOURCE_LINE 00000637 "(default: undef - don't compile)."
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "=head2 Plugins and Filters"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "=head3 PLUGINS"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "Reference to a hash array mapping plugin names to Perl packages."
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "=head3 PLUGIN_BASE"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "One or more base classes under which plugins may be found."
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "=head3 LOAD_PERL"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "Flag to indicate regular Perl modules should be loaded if a named plugin"
NSQ_SOURCE_LINE 00000652 "can't be found  (default: 0)."
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "=head3 FILTERS"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "Hash array mapping filter names to filter subroutines or factories."
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "=head2 Customisation and Extension"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "=head3 LOAD_TEMPLATES"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "List of template providers."
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "=head3 LOAD_PLUGINS"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "List of plugin providers."
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "=head3 LOAD_FILTERS"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "List of filter providers."
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "=head3 TOLERANT"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "Set providers to tolerate errors as declinations (default: 0)."
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "=head3 SERVICE"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "Reference to a custom service object (default: L<Template::Service>)."
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "=head3 CONTEXT"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "Reference to a custom context object (default: L<Template::Context>)."
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "=head3 STASH"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "Reference to a custom stash object (default: L<Template::Stash>)."
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "=head3 PARSER"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "Reference to a custom parser object (default: L<Template::Parser>)."
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "=head3 GRAMMAR"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "Reference to a custom grammar object (default: L<Template::Grammar>)."
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "=head1 DIRECTIVE SUMMARY"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "The following list gives a short summary of each Template Toolkit directive."
NSQ_SOURCE_LINE 00000699 "See L<Template::Manual::Directives> for full details."
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "=head2 GET"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "Evaluate and print a variable or value."
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "    [%   GET variable %]    # 'GET' keyword is optional"
NSQ_SOURCE_LINE 00000706 "    [%       variable %]"
NSQ_SOURCE_LINE 00000707 "    [%       hash.key %]"
NSQ_SOURCE_LINE 00000708 "    [%         list.n %]"
NSQ_SOURCE_LINE 00000709 "    [%     code(args) %]"
NSQ_SOURCE_LINE 00000710 "    [% obj.meth(args) %]"
NSQ_SOURCE_LINE 00000711 "    [%  \"value: $var\" %]"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "=head2 CALL"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "As per L<GET> but without printing result (e.g. call code)"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "    [%  CALL variable %]"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "=head2 SET"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "Assign a values to variables."
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "    [% SET variable = value %]    # 'SET' also optional"
NSQ_SOURCE_LINE 00000724 "    [%     variable = other_variable"
NSQ_SOURCE_LINE 00000725 "           variable = 'literal text @ $100'"
NSQ_SOURCE_LINE 00000726 "           variable = \"interpolated text: $var\""
NSQ_SOURCE_LINE 00000727 "           list     = [ val, val, val, val, ... ]"
NSQ_SOURCE_LINE 00000728 "           list     = [ val..val ]"
NSQ_SOURCE_LINE 00000729 "           hash     = { var => val, var => val, ... }"
NSQ_SOURCE_LINE 00000730 "    %]"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "=head2 DEFAULT"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "Like L<SET>, but variables are only set if currently unset (i.e. have no"
NSQ_SOURCE_LINE 00000735 "true value)."
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "    [% DEFAULT variable = value %]"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "=head2 INSERT"
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "Insert a file without any processing performed on the contents."
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "    [% INSERT legalese.txt %]"
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "=head2 PROCESS"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "Process another template file or block and insert the generated output."
NSQ_SOURCE_LINE 00000748 "Any template L<BLOCK>s or variables defined or updated in the C<PROCESS>ed"
NSQ_SOURCE_LINE 00000749 "template will thereafter be defined in the calling template."
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "    [% PROCESS template %]"
NSQ_SOURCE_LINE 00000752 "    [% PROCESS template  var = val, ... %]"
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "=head2 INCLUDE"
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "Similar to C<PROCESS>, but using a local copy of the current variables."
NSQ_SOURCE_LINE 00000757 "Any template C<BLOCK>s or variables defined in the C<INCLUDE>d template"
NSQ_SOURCE_LINE 00000758 "remain local to it."
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "    [% INCLUDE template %]"
NSQ_SOURCE_LINE 00000761 "    [% INCLUDE template  var = val, ... %]"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "=head2 WRAPPER"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "The content between the C<WRAPPER> and corresponding C<END> directives is first"
NSQ_SOURCE_LINE 00000766 "evaluated, with the output generated being stored in the C<content> variable."
NSQ_SOURCE_LINE 00000767 "The named template is then process as per C<INCLUDE>."
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "    [% WRAPPER layout %]"
NSQ_SOURCE_LINE 00000770 "       Some template markup [% blah %]..."
NSQ_SOURCE_LINE 00000771 "    [% END %]"
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "A simple F<layout> template might look something like this:"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "    Your header here..."
NSQ_SOURCE_LINE 00000776 "    [% content %]"
NSQ_SOURCE_LINE 00000777 "    Your footer here..."
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "=head2 BLOCK"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "Define a named template block for L<INCLUDE>, L<PROCESS> and L<WRAPPER>"
NSQ_SOURCE_LINE 00000782 "to use."
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "    [% BLOCK hello %]"
NSQ_SOURCE_LINE 00000785 "       Hello World"
NSQ_SOURCE_LINE 00000786 "    [% END %]"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "    [% INCLUDE hello %]"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "=head2 FOREACH"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "Repeat the enclosed C<FOREACH> ... C<END> block for each value in the list."
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "    [% FOREACH variable IN [ val, val, val ] %]    # either"
NSQ_SOURCE_LINE 00000795 "    [% FOREACH variable IN list %]                 # or"
NSQ_SOURCE_LINE 00000796 "       The variable is set to [% variable %]"
NSQ_SOURCE_LINE 00000797 "    [% END %]"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "=head2 WHILE"
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "The block enclosed between C<WHILE> and C<END> block is processed while"
NSQ_SOURCE_LINE 00000802 "the specified condition is true."
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "    [% WHILE condition %]"
NSQ_SOURCE_LINE 00000805 "       content"
NSQ_SOURCE_LINE 00000806 "    [% END %]"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "=head2 IF / UNLESS / ELSIF / ELSE"
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "The enclosed block is processed if the condition is true / false."
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "    [% IF condition %]"
NSQ_SOURCE_LINE 00000813 "       content"
NSQ_SOURCE_LINE 00000814 "    [% ELSIF condition %]"
NSQ_SOURCE_LINE 00000815 "     content"
NSQ_SOURCE_LINE 00000816 "    [% ELSE %]"
NSQ_SOURCE_LINE 00000817 "     content"
NSQ_SOURCE_LINE 00000818 "    [% END %]"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "    [% UNLESS condition %]"
NSQ_SOURCE_LINE 00000821 "       content"
NSQ_SOURCE_LINE 00000822 "    [% # ELSIF/ELSE as per IF, above %]"
NSQ_SOURCE_LINE 00000823 "       content"
NSQ_SOURCE_LINE 00000824 "    [% END %]"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "=head2 SWITCH / CASE"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "Multi-way switch/case statement."
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "    [% SWITCH variable %]"
NSQ_SOURCE_LINE 00000831 "    [%   CASE val1 %]"
NSQ_SOURCE_LINE 00000832 "           content"
NSQ_SOURCE_LINE 00000833 "    [%   CASE [ val2, val3 ] %]"
NSQ_SOURCE_LINE 00000834 "           content"
NSQ_SOURCE_LINE 00000835 "    [%   CASE %]         # or [% CASE DEFAULT %]"
NSQ_SOURCE_LINE 00000836 "           content"
NSQ_SOURCE_LINE 00000837 "    [% END %]"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "=head2 MACRO"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "Define a named macro."
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "    [% MACRO name <directive> %]"
NSQ_SOURCE_LINE 00000844 "    [% MACRO name(arg1, arg2) <directive> %]"
NSQ_SOURCE_LINE 00000845 "    ..."
NSQ_SOURCE_LINE 00000846 "    [% name %]"
NSQ_SOURCE_LINE 00000847 "    [% name(val1, val2) %]"
NSQ_SOURCE_LINE 00000848 ""
NSQ_SOURCE_LINE 00000849 "=head2 FILTER"
NSQ_SOURCE_LINE 00000850 ""
NSQ_SOURCE_LINE 00000851 "Process enclosed C<FILTER> ... C<END> block then pipe through a filter."
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "    [% FILTER name %]                       # either"
NSQ_SOURCE_LINE 00000854 "    [% FILTER name( params ) %]             # or"
NSQ_SOURCE_LINE 00000855 "    [% FILTER alias = name( params ) %]     # or"
NSQ_SOURCE_LINE 00000856 "       content"
NSQ_SOURCE_LINE 00000857 "    [% END %]"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "=head2 USE"
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "Load a plugin module (see C<Template::<Manual::Plugins>), or any regular Perl"
NSQ_SOURCE_LINE 00000862 "module when the C<LOAD_PERL> option is set."
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "    [% USE name %]                      # either"
NSQ_SOURCE_LINE 00000865 "    [% USE name( params ) %]            # or"
NSQ_SOURCE_LINE 00000866 "    [% USE var = name( params ) %]      # or"
NSQ_SOURCE_LINE 00000867 "    ..."
NSQ_SOURCE_LINE 00000868 "    [% name.method %]"
NSQ_SOURCE_LINE 00000869 "    [% var.method %]"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "=head2 PERL / RAWPERL"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "Evaluate enclosed blocks as Perl code (requires the C<EVAL_PERL> option to be"
NSQ_SOURCE_LINE 00000874 "set)."
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "    [% PERL %]"
NSQ_SOURCE_LINE 00000877 "     # perl code goes here"
NSQ_SOURCE_LINE 00000878 "     $stash->set('foo', 10);"
NSQ_SOURCE_LINE 00000879 "     print \"set 'foo' to \", $stash->get('foo'), \"\\n\";"
NSQ_SOURCE_LINE 00000880 "     print $context->include('footer', { var => $val });"
NSQ_SOURCE_LINE 00000881 "    [% END %]"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "    [% RAWPERL %]"
NSQ_SOURCE_LINE 00000884 "       # raw perl code goes here, no magic but fast."
NSQ_SOURCE_LINE 00000885 "       $output .= 'some output';"
NSQ_SOURCE_LINE 00000886 "    [% END %]"
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "=head2 TRY / THROW / CATCH / FINAL"
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "Exception handling."
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "    [% TRY %]"
NSQ_SOURCE_LINE 00000893 "     content"
NSQ_SOURCE_LINE 00000894 "       [% THROW type info %]"
NSQ_SOURCE_LINE 00000895 "    [% CATCH type %]"
NSQ_SOURCE_LINE 00000896 "     catch content"
NSQ_SOURCE_LINE 00000897 "       [% error.type %] [% error.info %]"
NSQ_SOURCE_LINE 00000898 "    [% CATCH %] # or [% CATCH DEFAULT %]"
NSQ_SOURCE_LINE 00000899 "     content"
NSQ_SOURCE_LINE 00000900 "    [% FINAL %]"
NSQ_SOURCE_LINE 00000901 "       this block is always processed"
NSQ_SOURCE_LINE 00000902 "    [% END %]"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "=head2 NEXT"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "Jump straight to the next item in a C<FOREACH> or C<WHILE> loop."
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "    [% NEXT %]"
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "=head2 LAST"
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "Break out of C<FOREACH> or C<WHILE> loop."
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "    [% LAST %]"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "=head2 RETURN"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "Stop processing current template and return to including templates."
NSQ_SOURCE_LINE 00000919 ""
NSQ_SOURCE_LINE 00000920 "    [% RETURN %]"
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "=head2 STOP"
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "Stop processing all templates and return to caller."
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "    [% STOP %]"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "=head2 TAGS"
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "Define new tag style or characters (default: C<[%> C<%]>)."
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "    [% TAGS html %]"
NSQ_SOURCE_LINE 00000933 "    [% TAGS <!-- --> %]"
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "=head2 COMMENTS"
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "Ignored and deleted."
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "    [% # this is a comment to the end of line"
NSQ_SOURCE_LINE 00000940 "       foo = 'bar'"
NSQ_SOURCE_LINE 00000941 "    %]"
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "    [%# placing the '#' immediately inside the directive"
NSQ_SOURCE_LINE 00000944 "        tag comments out the entire directive"
NSQ_SOURCE_LINE 00000945 "    %]"
NSQ_SOURCE_LINE 00000946 ""
