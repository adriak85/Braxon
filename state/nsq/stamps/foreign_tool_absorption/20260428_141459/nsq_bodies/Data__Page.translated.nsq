BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Data::Page; # git description: 090534c"
NSQ_SOURCE_LINE 00000002 "use Carp;"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use base 'Class::Accessor::Chained::Fast';"
NSQ_SOURCE_LINE 00000005 "__PACKAGE__->mk_accessors(qw(total_entries entries_per_page current_page));"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '2.03';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "sub new {"
NSQ_SOURCE_LINE 00000010 "    my $class = shift;"
NSQ_SOURCE_LINE 00000011 "    my $self  = {};"
NSQ_SOURCE_LINE 00000012 "    bless( $self, $class );"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "    my ( $total_entries, $entries_per_page, $current_page ) = @_;"
NSQ_SOURCE_LINE 00000015 "    $self->total_entries( $total_entries       || 0 );"
NSQ_SOURCE_LINE 00000016 "    $self->entries_per_page( $entries_per_page || 10 );"
NSQ_SOURCE_LINE 00000017 "    $self->current_page( $current_page         || 1 );"
NSQ_SOURCE_LINE 00000018 "    return $self;"
NSQ_SOURCE_LINE 00000019 "}"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub entries_per_page {"
NSQ_SOURCE_LINE 00000022 "    my $self             = shift;"
NSQ_SOURCE_LINE 00000023 "    my $entries_per_page = $_[0];"
NSQ_SOURCE_LINE 00000024 "    if (@_) {"
NSQ_SOURCE_LINE 00000025 "        croak(\"Fewer than one entry per page!\") if $entries_per_page < 1;"
NSQ_SOURCE_LINE 00000026 "        return $self->_entries_per_page_accessor(@_);"
NSQ_SOURCE_LINE 00000027 "    }"
NSQ_SOURCE_LINE 00000028 "    return $self->_entries_per_page_accessor();"
NSQ_SOURCE_LINE 00000029 "}"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub current_page {"
NSQ_SOURCE_LINE 00000032 "    my $self = shift;"
NSQ_SOURCE_LINE 00000033 "    if (@_) {"
NSQ_SOURCE_LINE 00000034 "        return $self->_current_page_accessor(@_);"
NSQ_SOURCE_LINE 00000035 "    }"
NSQ_SOURCE_LINE 00000036 "    return $self->first_page unless defined $self->_current_page_accessor;"
NSQ_SOURCE_LINE 00000037 "    return $self->first_page"
NSQ_SOURCE_LINE 00000038 "        if $self->_current_page_accessor < $self->first_page;"
NSQ_SOURCE_LINE 00000039 "    return $self->last_page"
NSQ_SOURCE_LINE 00000040 "        if $self->_current_page_accessor > $self->last_page;"
NSQ_SOURCE_LINE 00000041 "    return $self->_current_page_accessor();"
NSQ_SOURCE_LINE 00000042 "}"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "sub total_entries {"
NSQ_SOURCE_LINE 00000045 "    my $self = shift;"
NSQ_SOURCE_LINE 00000046 "    if (@_) {"
NSQ_SOURCE_LINE 00000047 "        return $self->_total_entries_accessor(@_);"
NSQ_SOURCE_LINE 00000048 "    }"
NSQ_SOURCE_LINE 00000049 "    return $self->_total_entries_accessor;"
NSQ_SOURCE_LINE 00000050 "}"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "sub entries_on_this_page {"
NSQ_SOURCE_LINE 00000053 "    my $self = shift;"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    if ( $self->total_entries == 0 ) {"
NSQ_SOURCE_LINE 00000056 "        return 0;"
NSQ_SOURCE_LINE 00000057 "    } else {"
NSQ_SOURCE_LINE 00000058 "        return $self->last - $self->first + 1;"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "sub first_page {"
NSQ_SOURCE_LINE 00000063 "    my $self = shift;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    return 1;"
NSQ_SOURCE_LINE 00000066 "}"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "sub last_page {"
NSQ_SOURCE_LINE 00000069 "    my $self = shift;"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "    my $pages = $self->total_entries / $self->entries_per_page;"
NSQ_SOURCE_LINE 00000072 "    my $last_page;"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    if ( $pages == int $pages ) {"
NSQ_SOURCE_LINE 00000075 "        $last_page = $pages;"
NSQ_SOURCE_LINE 00000076 "    } else {"
NSQ_SOURCE_LINE 00000077 "        $last_page = 1 + int($pages);"
NSQ_SOURCE_LINE 00000078 "    }"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "    $last_page = 1 if $last_page < 1;"
NSQ_SOURCE_LINE 00000081 "    return $last_page;"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "sub first {"
NSQ_SOURCE_LINE 00000085 "    my $self = shift;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    if ( $self->total_entries == 0 ) {"
NSQ_SOURCE_LINE 00000088 "        return 0;"
NSQ_SOURCE_LINE 00000089 "    } else {"
NSQ_SOURCE_LINE 00000090 "        return ( ( $self->current_page - 1 ) * $self->entries_per_page ) + 1;"
NSQ_SOURCE_LINE 00000091 "    }"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "sub last {"
NSQ_SOURCE_LINE 00000095 "    my $self = shift;"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    if ( $self->current_page == $self->last_page ) {"
NSQ_SOURCE_LINE 00000098 "        return $self->total_entries;"
NSQ_SOURCE_LINE 00000099 "    } else {"
NSQ_SOURCE_LINE 00000100 "        return ( $self->current_page * $self->entries_per_page );"
NSQ_SOURCE_LINE 00000101 "    }"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub previous_page {"
NSQ_SOURCE_LINE 00000105 "    my $self = shift;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    if ( $self->current_page > 1 ) {"
NSQ_SOURCE_LINE 00000108 "        return $self->current_page - 1;"
NSQ_SOURCE_LINE 00000109 "    } else {"
NSQ_SOURCE_LINE 00000110 "        return undef;"
NSQ_SOURCE_LINE 00000111 "    }"
NSQ_SOURCE_LINE 00000112 "}"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "sub next_page {"
NSQ_SOURCE_LINE 00000115 "    my $self = shift;"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "    $self->current_page < $self->last_page ? $self->current_page + 1 : undef;"
NSQ_SOURCE_LINE 00000118 "}"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "# This method would probably be better named 'select' or 'slice' or"
NSQ_SOURCE_LINE 00000121 "# something, because it doesn't modify the array the way"
NSQ_SOURCE_LINE 00000122 "# CORE::splice() does."
NSQ_SOURCE_LINE 00000123 "sub splice {"
NSQ_SOURCE_LINE 00000124 "    my ( $self, $array ) = @_;"
NSQ_SOURCE_LINE 00000125 "    my $top = @$array > $self->last ? $self->last : @$array;"
NSQ_SOURCE_LINE 00000126 "    return () if $top == 0;    # empty"
NSQ_SOURCE_LINE 00000127 "    return @{$array}[ $self->first - 1 .. $top - 1 ];"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "sub skipped {"
NSQ_SOURCE_LINE 00000131 "    my $self = shift;"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    my $skipped = $self->first - 1;"
NSQ_SOURCE_LINE 00000134 "    return 0 if $skipped < 0;"
NSQ_SOURCE_LINE 00000135 "    return $skipped;"
NSQ_SOURCE_LINE 00000136 "}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "sub change_entries_per_page {"
NSQ_SOURCE_LINE 00000139 "    my ( $self, $new_epp ) = @_;"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    use integer;"
NSQ_SOURCE_LINE 00000142 "    croak(\"Fewer than one entry per page!\") if $new_epp < 1;"
NSQ_SOURCE_LINE 00000143 "    my $new_page = 1 + ( $self->first / $new_epp );"
NSQ_SOURCE_LINE 00000144 "    $self->entries_per_page($new_epp);"
NSQ_SOURCE_LINE 00000145 "    $self->current_page($new_page);"
NSQ_SOURCE_LINE 00000146 "}"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "1;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "__END__"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=head1 NAME"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "Data::Page - help when paging through sets of results"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "  use Data::Page;"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "  my $page = Data::Page->new();"
NSQ_SOURCE_LINE 00000161 "  $page->total_entries($total_entries);"
NSQ_SOURCE_LINE 00000162 "  $page->entries_per_page($entries_per_page);"
NSQ_SOURCE_LINE 00000163 "  $page->current_page($current_page);"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "  print \"         First page: \", $page->first_page, \"\\n\";"
NSQ_SOURCE_LINE 00000166 "  print \"          Last page: \", $page->last_page, \"\\n\";"
NSQ_SOURCE_LINE 00000167 "  print \"First entry on page: \", $page->first, \"\\n\";"
NSQ_SOURCE_LINE 00000168 "  print \" Last entry on page: \", $page->last, \"\\n\";"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "When searching through large amounts of data, it is often the case"
NSQ_SOURCE_LINE 00000173 "that a result set is returned that is larger than we want to display"
NSQ_SOURCE_LINE 00000174 "on one page. This results in wanting to page through various pages of"
NSQ_SOURCE_LINE 00000175 "data. The maths behind this is unfortunately fiddly, hence this"
NSQ_SOURCE_LINE 00000176 "module."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "The main concept is that you pass in the number of total entries, the"
NSQ_SOURCE_LINE 00000179 "number of entries per page, and the current page number. You can then"
NSQ_SOURCE_LINE 00000180 "call methods to find out how many pages of information there are, and"
NSQ_SOURCE_LINE 00000181 "what number the first and last entries on the current page really are."
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "For example, say we wished to page through the integers from 1 to 100"
NSQ_SOURCE_LINE 00000184 "with 20 entries per page. The first page would consist of 1-20, the"
NSQ_SOURCE_LINE 00000185 "second page from 21-40, the third page from 41-60, the fourth page"
NSQ_SOURCE_LINE 00000186 "from 61-80 and the fifth page from 81-100. This module would help you"
NSQ_SOURCE_LINE 00000187 "work this out."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=head1 METHODS"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=head2 new"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "This is the constructor, which takes no arguments."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "  my $page = Data::Page->new();"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "There is also an old, deprecated constructor, which currently takes"
NSQ_SOURCE_LINE 00000198 "two mandatory arguments, the total number of entries and the number of"
NSQ_SOURCE_LINE 00000199 "entries per page. It also optionally takes the current page number:"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "  my $page = Data::Page->new($total_entries, $entries_per_page, $current_page);"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=head2 total_entries"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "This method get or sets the total number of entries:"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "  print \"Entries:\", $page->total_entries, \"\\n\";"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head2 entries_per_page"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "This method gets or sets the total number of entries per page (which"
NSQ_SOURCE_LINE 00000212 "defaults to 10):"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "  print \"Per page:\", $page->entries_per_page, \"\\n\";"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=head2 current_page"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "This method gets or sets the current page number (which defaults to 1):"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "  print \"Page: \", $page->current_page, \"\\n\";"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head2 entries_on_this_page"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "This methods returns the number of entries on the current page:"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "  print \"There are \", $page->entries_on_this_page, \" entries displayed\\n\";"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=head2 first_page"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "This method returns the first page. This is put in for reasons of"
NSQ_SOURCE_LINE 00000231 "symmetry with last_page, as it always returns 1:"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "  print \"Pages range from: \", $page->first_page, \"\\n\";"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=head2 last_page"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "This method returns the total number of pages of information:"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "  print \"Pages range to: \", $page->last_page, \"\\n\";"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=head2 first"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "This method returns the number of the first entry on the current page:"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "  print \"Showing entries from: \", $page->first, \"\\n\";"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head2 last"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "This method returns the number of the last entry on the current page:"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "  print \"Showing entries to: \", $page->last, \"\\n\";"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=head2 previous_page"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "This method returns the previous page number, if one exists. Otherwise"
NSQ_SOURCE_LINE 00000256 "it returns undefined:"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "  if ($page->previous_page) {"
NSQ_SOURCE_LINE 00000259 "    print \"Previous page number: \", $page->previous_page, \"\\n\";"
NSQ_SOURCE_LINE 00000260 "  }"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=head2 next_page"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "This method returns the next page number, if one exists. Otherwise"
NSQ_SOURCE_LINE 00000265 "it returns undefined:"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "  if ($page->next_page) {"
NSQ_SOURCE_LINE 00000268 "    print \"Next page number: \", $page->next_page, \"\\n\";"
NSQ_SOURCE_LINE 00000269 "  }"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "=head2 splice"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "This method takes in a listref, and returns only the values which are"
NSQ_SOURCE_LINE 00000274 "on the current page:"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "  @visible_holidays = $page->splice(\\@holidays);"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head2 skipped"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "This method is useful paging through data in a database using SQL"
NSQ_SOURCE_LINE 00000281 "LIMIT clauses. It is simply $page->first - 1:"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "  $sth = $dbh->prepare("
NSQ_SOURCE_LINE 00000284 "    q{SELECT * FROM table ORDER BY rec_date LIMIT ?, ?}"
NSQ_SOURCE_LINE 00000285 "  );"
NSQ_SOURCE_LINE 00000286 "  $sth->execute($page->skipped, $page->entries_per_page);"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=head2 change_entries_per_page"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "This method changes the number of entries per page and the current page number"
NSQ_SOURCE_LINE 00000291 "such that the L<first> item on the current page will be present on the new page."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 " $page->total_entries(50);"
NSQ_SOURCE_LINE 00000294 " $page->entries_per_page(20);"
NSQ_SOURCE_LINE 00000295 " $page->current_page(3);"
NSQ_SOURCE_LINE 00000296 " print $page->first; # 41"
NSQ_SOURCE_LINE 00000297 " $page->change_entries_per_page(30);"
NSQ_SOURCE_LINE 00000298 " print $page->current_page; # 2 - the page that item 41 will show in"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=head1 NOTES"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "It has been said before that this code is \"too simple\" for CPAN, but I"
NSQ_SOURCE_LINE 00000303 "must disagree. I have seen people write this kind of code over and"
NSQ_SOURCE_LINE 00000304 "over again and they always get it wrong. Perhaps now they will spend"
NSQ_SOURCE_LINE 00000305 "more time getting the rest of their code right..."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "Related modules which may be of interest: L<Data::Pageset>,"
NSQ_SOURCE_LINE 00000310 "L<Data::Page::Tied>, L<Data::SpreadPagination>."
NSQ_SOURCE_LINE 00000311 ""
