NSQ_SOURCE_LINE 00000001 "package Test::Requires;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.11';"
NSQ_SOURCE_LINE 00000005 "use base 'Test::Builder::Module';"
NSQ_SOURCE_LINE 00000006 "use 5.006;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "sub import {"
NSQ_SOURCE_LINE 00000009 "    my $class = shift;"
NSQ_SOURCE_LINE 00000010 "    my $caller = caller(0);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "    # export methods"
NSQ_SOURCE_LINE 00000013 "    {"
NSQ_SOURCE_LINE 00000014 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000015 "        *{\"$caller\\::test_requires\"} = \\&test_requires;"
NSQ_SOURCE_LINE 00000016 "    }"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "    # test arguments"
NSQ_SOURCE_LINE 00000019 "    if (@_ == 1 && ref $_[0] && ref $_[0] eq 'HASH') {"
NSQ_SOURCE_LINE 00000020 "        while (my ($mod, $ver) = each %{$_[0]}) {"
NSQ_SOURCE_LINE 00000021 "            test_requires($mod, $ver, $caller);"
NSQ_SOURCE_LINE 00000022 "        }"
NSQ_SOURCE_LINE 00000023 "    } else {"
NSQ_SOURCE_LINE 00000024 "        for my $mod (@_) {"
NSQ_SOURCE_LINE 00000025 "            test_requires($mod, undef, $caller);"
NSQ_SOURCE_LINE 00000026 "        }"
NSQ_SOURCE_LINE 00000027 "    }"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "sub test_requires {"
NSQ_SOURCE_LINE 00000031 "    my ( $mod, $ver, $caller ) = @_;"
NSQ_SOURCE_LINE 00000032 "    return if $mod eq __PACKAGE__;"
NSQ_SOURCE_LINE 00000033 "    if (@_ != 3) {"
NSQ_SOURCE_LINE 00000034 "        $caller = caller(0);"
NSQ_SOURCE_LINE 00000035 "    }"
NSQ_SOURCE_LINE 00000036 "    $ver ||= '';"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    eval qq{package $caller; use $mod $ver}; ## no critic."
NSQ_SOURCE_LINE 00000039 "    if (my $e = $@) {"
NSQ_SOURCE_LINE 00000040 "        my $skip_all = sub {"
NSQ_SOURCE_LINE 00000041 "            my $builder = __PACKAGE__->builder;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "            if (not defined $builder->has_plan) {"
NSQ_SOURCE_LINE 00000044 "                $builder->skip_all(@_);"
NSQ_SOURCE_LINE 00000045 "            } elsif ($builder->has_plan eq 'no_plan') {"
NSQ_SOURCE_LINE 00000046 "                $builder->skip(@_);"
NSQ_SOURCE_LINE 00000047 "                if ( $builder->can('parent') && $builder->parent ) {"
NSQ_SOURCE_LINE 00000048 "                    die bless {} => 'Test::Builder::Exception';"
NSQ_SOURCE_LINE 00000049 "                }"
NSQ_SOURCE_LINE 00000050 "                exit 0;"
NSQ_SOURCE_LINE 00000051 "            } else {"
NSQ_SOURCE_LINE 00000052 "                for (1..$builder->has_plan) {"
NSQ_SOURCE_LINE 00000053 "                    $builder->skip(@_);"
NSQ_SOURCE_LINE 00000054 "                }"
NSQ_SOURCE_LINE 00000055 "                if ( $builder->can('parent') && $builder->parent ) {"
NSQ_SOURCE_LINE 00000056 "                    die bless {} => 'Test::Builder::Exception';"
NSQ_SOURCE_LINE 00000057 "                }"
NSQ_SOURCE_LINE 00000058 "                exit 0;"
NSQ_SOURCE_LINE 00000059 "            }"
NSQ_SOURCE_LINE 00000060 "        };"
NSQ_SOURCE_LINE 00000061 "        "
NSQ_SOURCE_LINE 00000062 "        my $msg = \"$e\";"
NSQ_SOURCE_LINE 00000063 "        if ( $e =~ /^Can't locate/ ) {"
NSQ_SOURCE_LINE 00000064 "            $msg = \"Test requires module '$mod' but it's not found\";"
NSQ_SOURCE_LINE 00000065 "        }"
NSQ_SOURCE_LINE 00000066 "        "
NSQ_SOURCE_LINE 00000067 "        if ($ENV{RELEASE_TESTING}) {"
NSQ_SOURCE_LINE 00000068 "            __PACKAGE__->builder->BAIL_OUT($msg);"
NSQ_SOURCE_LINE 00000069 "        }"
NSQ_SOURCE_LINE 00000070 "        else {"
NSQ_SOURCE_LINE 00000071 "            $skip_all->($msg);"
NSQ_SOURCE_LINE 00000072 "        }"
NSQ_SOURCE_LINE 00000073 "    }"
NSQ_SOURCE_LINE 00000074 "}"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "1;"
NSQ_SOURCE_LINE 00000077 "__END__"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=head1 NAME"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "Test::Requires - Checks to see if the module can be loaded"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    # in your Makefile.PL"
NSQ_SOURCE_LINE 00000086 "    use inc::Module::Install;"
NSQ_SOURCE_LINE 00000087 "    test_requires 'Test::Requires';"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    # in your test"
NSQ_SOURCE_LINE 00000090 "    use Test::More tests => 10;"
NSQ_SOURCE_LINE 00000091 "    use Test::Requires {"
NSQ_SOURCE_LINE 00000092 "        'HTTP::MobileAttribute' => 0.01, # skip all if HTTP::MobileAttribute doesn't installed"
NSQ_SOURCE_LINE 00000093 "    };"
NSQ_SOURCE_LINE 00000094 "    isa_ok HTTP::MobileAttribute->new, 'HTTP::MobileAttribute::NonMobile';"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    # or"
NSQ_SOURCE_LINE 00000097 "    use Test::More tests => 10;"
NSQ_SOURCE_LINE 00000098 "    use Test::Requires qw( "
NSQ_SOURCE_LINE 00000099 "        HTTP::MobileAttribute"
NSQ_SOURCE_LINE 00000100 "    );"
NSQ_SOURCE_LINE 00000101 "    isa_ok HTTP::MobileAttribute->new, 'HTTP::MobileAttribute::NonMobile';"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "    # or"
NSQ_SOURCE_LINE 00000104 "    use Test::More tests => 10;"
NSQ_SOURCE_LINE 00000105 "    use Test::Requires;"
NSQ_SOURCE_LINE 00000106 "    test_requires 'Some::Optional::Test::Required::Modules';"
NSQ_SOURCE_LINE 00000107 "    isa_ok HTTP::MobileAttribute->new, 'HTTP::MobileAttribute::NonMobile';"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "Test::Requires checks to see if the module can be loaded."
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "If this fails rather than failing tests this B<skips all tests>."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "Test::Requires can also be used to require a minimum version of Perl:"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "    use Test::Requires \"5.010\";  # quoting is necessary!!"
NSQ_SOURCE_LINE 00000118 "    "
NSQ_SOURCE_LINE 00000119 "    # or"
NSQ_SOURCE_LINE 00000120 "    use Test::Requires \"v5.10\";"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "Tokuhiro Matsuno E<lt>tokuhirom @*(#RJKLFHFSDLJF gmail.comE<gt>"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=head1 THANKS TO"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "    kazuho++ # some tricky stuff"
NSQ_SOURCE_LINE 00000129 "    miyagawa++ # original code from t/TestPlagger.pm"
NSQ_SOURCE_LINE 00000130 "    tomyhero++ # reported issue related older test::builder"
NSQ_SOURCE_LINE 00000131 "    tobyink++ # documented that Test::Requires \"5.010\" works"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "If the C<< RELEASE_TESTING >> environment variable is true, then instead"
NSQ_SOURCE_LINE 00000136 "of skipping tests, Test::Requires bails out."
NSQ_SOURCE_LINE 00000137 ""
