NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 "package Ouch;"
NSQ_SOURCE_LINE 00000004 "$Ouch::VERSION = '0.0501';"
NSQ_SOURCE_LINE 00000005 "use Carp qw(longmess shortmess);"
NSQ_SOURCE_LINE 00000006 "use parent 'Exporter';"
NSQ_SOURCE_LINE 00000007 "use overload bool => sub {1}, q{\"\"} => 'scalar', fallback => 1;"
NSQ_SOURCE_LINE 00000008 "use Scalar::Util qw(blessed);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our @EXPORT = qw(bleep ouch kiss hug barf);"
NSQ_SOURCE_LINE 00000011 "our @EXPORT_OK = qw(try throw catch catch_all caught caught_all);"
NSQ_SOURCE_LINE 00000012 "our %EXPORT_TAGS = ( traditional => [qw(try throw catch catch_all)], trytiny => [qw( throw caught caught_all )] );"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub import {"
NSQ_SOURCE_LINE 00000015 "   my $package = shift;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "   # filter out :trytiny_var from list of imports"
NSQ_SOURCE_LINE 00000018 "   my ($alt, @imports);"
NSQ_SOURCE_LINE 00000019 "   ($_ eq ':trytiny_var' ? ($alt = 1) : (push @imports, $_))"
NSQ_SOURCE_LINE 00000020 "      for @_;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "   # leave early if the modified interface is not of interest"
NSQ_SOURCE_LINE 00000023 "   local $Exporter::ExportLevel = 1 + ($Exporter::ExportLevel || 0);"
NSQ_SOURCE_LINE 00000024 "   return $package->SUPER::import(@imports) unless $alt;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "   # we will default to $_ instead of $@ in the following, the real"
NSQ_SOURCE_LINE 00000027 "   # import will still be done by Exporter but based on wrapped subs"
NSQ_SOURCE_LINE 00000028 "   no warnings 'redefine';"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "   my $barf  = \\&barf;"
NSQ_SOURCE_LINE 00000031 "   local *barf  = sub { push @_, $_ if @_ < 1; goto $barf  };"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "   my $bleep = \\&bleep;"
NSQ_SOURCE_LINE 00000034 "   local *bleep = sub { push @_, $_ if @_ < 1; goto $bleep };"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "   my $hug   = \\&hug;"
NSQ_SOURCE_LINE 00000037 "   local *hug   = sub { push @_, $_ if @_ < 1; goto $hug   };"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "   my $kiss  = \\&kiss;"
NSQ_SOURCE_LINE 00000040 "   local *kiss  = sub { push @_, $_ if @_ < 2; goto $kiss  };"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "   use warnings 'redefine';"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "   # leave the stage to Exporter now"
NSQ_SOURCE_LINE 00000045 "   $package->SUPER::import(@imports);"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub new {"
NSQ_SOURCE_LINE 00000049 "  my ($class, $code, $message, $data) = @_;"
NSQ_SOURCE_LINE 00000050 "  bless {code => $code, message => $message, data => $data, shortmess => shortmess($message), trace => longmess($message) }, $class;"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "sub try (&) {"
NSQ_SOURCE_LINE 00000054 "  my $try = shift;"
NSQ_SOURCE_LINE 00000055 "  eval { $try->() };"
NSQ_SOURCE_LINE 00000056 "  return $@;"
NSQ_SOURCE_LINE 00000057 "}"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "sub ouch {"
NSQ_SOURCE_LINE 00000060 "  my ($code, $message, $data) = @_;"
NSQ_SOURCE_LINE 00000061 "  my $self = __PACKAGE__->new($code, $message, $data);"
NSQ_SOURCE_LINE 00000062 "  die $self;"
NSQ_SOURCE_LINE 00000063 "}"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "sub throw {  # alias"
NSQ_SOURCE_LINE 00000066 "  ouch @_;"
NSQ_SOURCE_LINE 00000067 "}"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "sub kiss {"
NSQ_SOURCE_LINE 00000070 "  my ($code, $e) = @_;"
NSQ_SOURCE_LINE 00000071 "  $e = $@ if @_ < 2;"
NSQ_SOURCE_LINE 00000072 "  if (blessed $e && $e->isa('Ouch') && $e->code eq $code) {"
NSQ_SOURCE_LINE 00000073 "    return 1;"
NSQ_SOURCE_LINE 00000074 "  }"
NSQ_SOURCE_LINE 00000075 "  return 0;"
NSQ_SOURCE_LINE 00000076 "}"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "sub catch {"
NSQ_SOURCE_LINE 00000079 "  kiss @_;"
NSQ_SOURCE_LINE 00000080 "}"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "sub caught {"
NSQ_SOURCE_LINE 00000083 "  kiss @_;"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub hug {"
NSQ_SOURCE_LINE 00000087 "  my $e = @_ ? $_[0] : $@;"
NSQ_SOURCE_LINE 00000088 "  return $e ? 1 : 0;"
NSQ_SOURCE_LINE 00000089 "}"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "sub catch_all {"
NSQ_SOURCE_LINE 00000092 "  hug @_;"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub caught_all {"
NSQ_SOURCE_LINE 00000096 "  hug @_;"
NSQ_SOURCE_LINE 00000097 "}"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "sub bleep {"
NSQ_SOURCE_LINE 00000100 "  my $e = @_ ? $_[0] : $@;"
NSQ_SOURCE_LINE 00000101 "  if (blessed $e && $e->isa('Ouch')) {"
NSQ_SOURCE_LINE 00000102 "    return $e->message;"
NSQ_SOURCE_LINE 00000103 "  }"
NSQ_SOURCE_LINE 00000104 "  else {"
NSQ_SOURCE_LINE 00000105 "    my $message = \"$e\"; # force to string anyway"
NSQ_SOURCE_LINE 00000106 "    if ($message =~ m{^(.*)\\s+at\\s.*line\\s\\d+.}xms) {"
NSQ_SOURCE_LINE 00000107 "        return $1;"
NSQ_SOURCE_LINE 00000108 "    }"
NSQ_SOURCE_LINE 00000109 "    else {"
NSQ_SOURCE_LINE 00000110 "        return $message;"
NSQ_SOURCE_LINE 00000111 "    }"
NSQ_SOURCE_LINE 00000112 "  }"
NSQ_SOURCE_LINE 00000113 "}"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "sub barf {"
NSQ_SOURCE_LINE 00000116 "    my $e = @_ ? $_[0] : $@;"
NSQ_SOURCE_LINE 00000117 "    my $code;"
NSQ_SOURCE_LINE 00000118 "    if (blessed $e && $e->isa('Ouch')) {"
NSQ_SOURCE_LINE 00000119 "        $code = $e->code;"
NSQ_SOURCE_LINE 00000120 "    }"
NSQ_SOURCE_LINE 00000121 "    else {"
NSQ_SOURCE_LINE 00000122 "        $code = 1;"
NSQ_SOURCE_LINE 00000123 "    }"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "    print STDERR bleep($e).\"\\n\";"
NSQ_SOURCE_LINE 00000126 "    exit $code;"
NSQ_SOURCE_LINE 00000127 "}"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "sub scalar {"
NSQ_SOURCE_LINE 00000130 "  my $self = shift;"
NSQ_SOURCE_LINE 00000131 "  return $self->{shortmess};"
NSQ_SOURCE_LINE 00000132 "}"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "sub trace {"
NSQ_SOURCE_LINE 00000135 "  my $self = shift;"
NSQ_SOURCE_LINE 00000136 "  return $self->{trace};"
NSQ_SOURCE_LINE 00000137 "}"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "sub hashref {"
NSQ_SOURCE_LINE 00000140 "  my $self = shift;"
NSQ_SOURCE_LINE 00000141 "  return {"
NSQ_SOURCE_LINE 00000142 "    code    => $self->{code},"
NSQ_SOURCE_LINE 00000143 "    message => $self->{message},"
NSQ_SOURCE_LINE 00000144 "    data    => $self->{data},"
NSQ_SOURCE_LINE 00000145 "  };"
NSQ_SOURCE_LINE 00000146 "}"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "sub code {"
NSQ_SOURCE_LINE 00000149 "  my $self = shift;"
NSQ_SOURCE_LINE 00000150 "  return $self->{code};"
NSQ_SOURCE_LINE 00000151 "}"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "sub message {"
NSQ_SOURCE_LINE 00000154 "  my $self = shift;"
NSQ_SOURCE_LINE 00000155 "  return $self->{message};"
NSQ_SOURCE_LINE 00000156 "}"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "sub data {"
NSQ_SOURCE_LINE 00000159 "  my $self = shift;"
NSQ_SOURCE_LINE 00000160 "  return $self->{data};"
NSQ_SOURCE_LINE 00000161 "}"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=head1 NAME"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "Ouch - Exceptions that don't hurt."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=head1 VERSION"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "version 0.0501"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 " use Ouch;"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 " eval { ouch(404, 'File not found.'); };"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 " if (kiss 404) {"
NSQ_SOURCE_LINE 00000178 "   check_elsewhere();"
NSQ_SOURCE_LINE 00000179 " }"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 " say $@;           # These two lines do the"
NSQ_SOURCE_LINE 00000182 " say $@->scalar;   # same thing."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "Ouch provides a class for exception handling that doesn't require a lot of boilerplate, nor any up front definition. If L<Exception::Class>"
NSQ_SOURCE_LINE 00000187 "is working for you, great! But if you want something that is faster, easier to use, requires less typing, and has no prereqs, but still gives "
NSQ_SOURCE_LINE 00000188 "you much of that same functionality, then Ouch is for you."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=head2 Why another exception handling module?"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "It really comes down to L<Carp> isn't enough for me, and L<Exception::Class> does what I want but makes me type way too much. Also, I tend to work on a lot of protocol-based systems that use error codes (HTTP, FTP, SMTP, JSON-RPC) rather than error classes, so that feels more natural to me. Consider the difference between these:"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "B<Ouch>"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 " use Ouch;"
NSQ_SOURCE_LINE 00000197 " ouch 404, 'File not found.', 'file';"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "B<Exception::Class>"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 " use Exception::Class ("
NSQ_SOURCE_LINE 00000202 "    'FileNotFound' => {"
NSQ_SOURCE_LINE 00000203 "        fields  => [ 'code', 'field' ],"
NSQ_SOURCE_LINE 00000204 "    },"
NSQ_SOURCE_LINE 00000205 " );"
NSQ_SOURCE_LINE 00000206 " FileNotFound->throw( error => 'File not found.', code => 404, field => 'file' );"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "And if you want to catch the exception you're looking at:"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "B<Ouch>"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 " if (kiss 404) {"
NSQ_SOURCE_LINE 00000213 "   # do something"
NSQ_SOURCE_LINE 00000214 " }"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "B<Exception::Class>"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 " my $e;"
NSQ_SOURCE_LINE 00000219 " if ($e = Exception::Class->caught('FileNotFound')) {"
NSQ_SOURCE_LINE 00000220 "   # do something"
NSQ_SOURCE_LINE 00000221 " }"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "Those differences may not seem like a lot, but over any substantial program with lots of exceptions it can become a big deal. "
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=head2 Usage"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "Most of the time, all you need to do is:"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 " ouch $code, $message, $data;"
NSQ_SOURCE_LINE 00000230 " ouch -32700, 'Parse error.', $request; # JSON-RPC 2.0 error"
NSQ_SOURCE_LINE 00000231 " ouch 441, 'You need to specify an email address.', 'email'; # form processing error"
NSQ_SOURCE_LINE 00000232 " ouch 'missing_param', 'You need to specify an email address.', 'email';"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "You can also go long form if you prefer:"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 " die Ouch->new($code, $message, $data);"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "If you want to rethrow an Ouch, you can simply C<die> it."
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 " eval { ouch(404, 'File not found.'); } ;"
NSQ_SOURCE_LINE 00000241 " die $@;"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head2 Functional Interface"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=head3 ouch"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "Some nice sugar instead of using the object oriented interface."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 " ouch 2121, 'Did not do the big thing.';"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=over"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=item code"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "An error code. An integer or string representing error type. Try to stick to codes used in whatever domain you happen to be working in. HTTP Status codes. JSON-RPC error codes, etc."
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=item message"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "A human readable error message."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=item data"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "Optional. Anything you want to attach to the exception to help a developer catching it decide what to do. For example, if you're doing form processing, you might want this to be the name of the field that caused the exception. "
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "B<WARNING:> Do not include objects or code refs in your data. This should only be stuff that is easily serializable like scalars, array refs, and hash refs."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=back"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=head3 kiss"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Some nice sugar to trap an Ouch."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 " if (kiss $code) {"
NSQ_SOURCE_LINE 00000274 "    # make it go"
NSQ_SOURCE_LINE 00000275 " }"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=over"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=item code"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "The code you're looking for."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "=item exception"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "Optional. If you like you can pass the exception into C<kiss>. If not, it will just use whatever is in C<$@>. You might want to do this if you've saved the exception before running another C<eval>, for example."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=back"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=head3 hug"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "Some nice sugar to trap any exception."
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 " if (hug) {"
NSQ_SOURCE_LINE 00000295 "   # make it stop"
NSQ_SOURCE_LINE 00000296 " }"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "=over "
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=item exception"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "Optional. If you like you can pass the exception into C<hug>. If not, it will just use whatever is in C<$@>."
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=back"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=head3 bleep "
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "A little sugar to make exceptions human friendly. Returns a clean error message from any exception, including an Ouch."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 " File not found."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "Rather than:"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 " File not found. at /Some/File.pm line 63."
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=over"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=item exception"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "Optional. If you like you can pass the exception into C<bleep>. If not, it will just use whatever is in C<$@>."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=back"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "=head3 barf"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "Calls C<bleep>, and then exits with error code"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=over"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "=item exception"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "Optional. You can pass an exception into C<barf> which then gets passed to C<bleep> otherwise it will use whatever's in C<$@>"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "=back"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=head2 Object-Oriented Interface"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "=head3 new"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "Constructor for the object-oriented interface. Takes the same parameters as C<ouch>."
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 " Ouch->new($code, $message, $data);"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "=head3 scalar"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "Returns the scalar form of the error message:"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 " Crap! at /Some/File.pm line 43."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "Just as if you had done:"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 " die 'Crap!';"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "Rather than:"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 " ouch $code, 'Crap!'; "
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "=head3 trace"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "Call this if you want the full stack trace that lead up to the ouch."
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "=head3 hashref"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "Returns a formatted hash reference of the exception, which can be useful for handing off to a serializer like L<JSON>."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 " {"
NSQ_SOURCE_LINE 00000369 "   code     => $code,"
NSQ_SOURCE_LINE 00000370 "   message  => $message,"
NSQ_SOURCE_LINE 00000371 "   data     => $data,"
NSQ_SOURCE_LINE 00000372 " }"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=head3 code"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "Returns the C<code> passed into the constructor."
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "=head3 message"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "Returns the C<messsage> passed into the constructor."
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=head3 data"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "Returns the C<data> passed into the constructor."
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "=head2 Try::Tiny"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "Many Ouch users like to use Ouch with L<Try::Tiny>."
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 " use Try::Tiny;"
NSQ_SOURCE_LINE 00000391 " use Ouch;"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 " try {"
NSQ_SOURCE_LINE 00000394 "    ouch 404, 'File not found!';"
NSQ_SOURCE_LINE 00000395 " }"
NSQ_SOURCE_LINE 00000396 " catch {"
NSQ_SOURCE_LINE 00000397 "    if (kiss(401, $_)) {"
NSQ_SOURCE_LINE 00000398 "        # do something"
NSQ_SOURCE_LINE 00000399 "    }"
NSQ_SOURCE_LINE 00000400 "    else {"
NSQ_SOURCE_LINE 00000401 "        die $_; # rethrow"
NSQ_SOURCE_LINE 00000402 "    }"
NSQ_SOURCE_LINE 00000403 " };"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "Some users are sticks in the mud who can't bring themselves to C<ouch> and"
NSQ_SOURCE_LINE 00000406 "C<kiss>. For them, there is the C<:trytiny> interface. Here's how it works:"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 " use Try::Tiny;"
NSQ_SOURCE_LINE 00000409 " use Ouch qw(:trytiny);"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 " try {"
NSQ_SOURCE_LINE 00000412 "    throw 404, 'File not found!';"
NSQ_SOURCE_LINE 00000413 " }"
NSQ_SOURCE_LINE 00000414 " catch {"
NSQ_SOURCE_LINE 00000415 "    if (caught(401, $_)) {"
NSQ_SOURCE_LINE 00000416 "        # do something"
NSQ_SOURCE_LINE 00000417 "    }"
NSQ_SOURCE_LINE 00000418 "    else {"
NSQ_SOURCE_LINE 00000419 "        die $_; # rethrow"
NSQ_SOURCE_LINE 00000420 "    }"
NSQ_SOURCE_LINE 00000421 " };"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "Using L<Try::Tiny> has some impedence mismatch in that the exception is"
NSQ_SOURCE_LINE 00000424 "propagated through C<$_> instead of C<$@> (the default used by Ouch). This"
NSQ_SOURCE_LINE 00000425 "forces to always include C<$_> when calling functions in Ouch, which is"
NSQ_SOURCE_LINE 00000426 "suboptimal. It's possible to do this:"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "   use Try::Tiny;"
NSQ_SOURCE_LINE 00000429 "   use Ouch qw(:trytiny_var); # use Try::Tiny's variable $_"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "   try {"
NSQ_SOURCE_LINE 00000432 "      throw 404, 'File not found!';"
NSQ_SOURCE_LINE 00000433 "   }"
NSQ_SOURCE_LINE 00000434 "   catch {"
NSQ_SOURCE_LINE 00000435 "      if (kiss 401) {"
NSQ_SOURCE_LINE 00000436 "         # do something"
NSQ_SOURCE_LINE 00000437 "      }"
NSQ_SOURCE_LINE 00000438 "      else {"
NSQ_SOURCE_LINE 00000439 "         die $_; # rethrow"
NSQ_SOURCE_LINE 00000440 "      }"
NSQ_SOURCE_LINE 00000441 "   };"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "i.e. you can use the regular Ouch syntax."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "This behaviour is localized to the import, i.e. if Ouch is then imported"
NSQ_SOURCE_LINE 00000446 "in another place it is possible to decide again which is the default"
NSQ_SOURCE_LINE 00000447 "exception variable in that specific import:"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "   package I::Want::Try::Tiny;"
NSQ_SOURCE_LINE 00000450 "   use Try::Tiny;"
NSQ_SOURCE_LINE 00000451 "   use Ouch qw(:trytiny_var);"
NSQ_SOURCE_LINE 00000452 "   # ... $_ is the default exception for kiss, hug, barf, and bleep"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "   package Gimme::Regular::Ouch;"
NSQ_SOURCE_LINE 00000455 "   use Ouch;"
NSQ_SOURCE_LINE 00000456 "   # ... $@ is the default exception object here"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "It's also possible to mix the two approaches, i.e. use both C<:trytiny>"
NSQ_SOURCE_LINE 00000459 "and C<:trytiny_var>."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "=head3 throw"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "See C<ouch> for details."
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=head3 caught"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "See C<kiss> for details."
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=head3 caught_all"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "See C<hug> for details."
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "=head1 DEPRECATED"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "This functionality is deprecated and will be removed in a future release. Use Try::Tiny instead."
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "=head2 Traditional Interface"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "Some people just can't bring themselves to use the sugary cuteness of Ouch. For them there is the C<:traditional> interface. Here's how it works:"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 " use Ouch qw(:traditional);"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 " my $e = try {"
NSQ_SOURCE_LINE 00000484 "   throw 404, 'File not found.';"
NSQ_SOURCE_LINE 00000485 " };"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 " if ( catch 404, $e ) {"
NSQ_SOURCE_LINE 00000488 "   # do the big thing"
NSQ_SOURCE_LINE 00000489 " }"
NSQ_SOURCE_LINE 00000490 " elsif ( catch_all $e ) {"
NSQ_SOURCE_LINE 00000491 "   # make it stop"
NSQ_SOURCE_LINE 00000492 " }"
NSQ_SOURCE_LINE 00000493 " else {"
NSQ_SOURCE_LINE 00000494 "   # make it go"
NSQ_SOURCE_LINE 00000495 " }"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "B<NOTE:> C<try> also populates C<$@>, and C<catch> and C<catch_all> will also use C<$@> if you don't specify an exception."
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "=head3 try"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "Returns an exception. Is basically just a nice wrapper around C<eval>."
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "=over"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=item block"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "Try accepts a code ref, anonymous subroutine, or a block. "
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "B<NOTE:> You need a semi-colon at the end of a C<try> block."
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=back"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "=head3 throw"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "Works exactly like C<ouch>. See C<ouch> for details."
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=head3 catch"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "Works exactly like C<kiss>. See C<kiss> for details."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "=head3 catch_all"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "Works exactly like C<hug>. See C<hug> for details."
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 ""
