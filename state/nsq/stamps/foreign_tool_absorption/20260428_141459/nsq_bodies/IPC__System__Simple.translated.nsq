NSQ_SOURCE_LINE 00000001 "package IPC::System::Simple;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "# ABSTRACT: Run commands simply, with detailed diagnostics"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use 5.006;"
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 "use re 'taint';"
NSQ_SOURCE_LINE 00000009 "use Carp;"
NSQ_SOURCE_LINE 00000010 "use List::Util qw(first);"
NSQ_SOURCE_LINE 00000011 "use Scalar::Util qw(tainted);"
NSQ_SOURCE_LINE 00000012 "use Config;"
NSQ_SOURCE_LINE 00000013 "use constant WINDOWS => ($^O eq 'MSWin32');"
NSQ_SOURCE_LINE 00000014 "use constant VMS     => ($^O eq 'VMS');"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "BEGIN {"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "    # It would be lovely to use the 'if' module here, but it didn't"
NSQ_SOURCE_LINE 00000019 "    # enter core until 5.6.2, and we want to keep 5.6.0 compatibility."
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    if (WINDOWS) {"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "        ## no critic (ProhibitStringyEval)"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "        eval q{"
NSQ_SOURCE_LINE 00000027 "            use Win32::Process qw(INFINITE NORMAL_PRIORITY_CLASS);"
NSQ_SOURCE_LINE 00000028 "            use File::Spec;"
NSQ_SOURCE_LINE 00000029 "            use Win32;"
NSQ_SOURCE_LINE 00000030 "            use Win32::ShellQuote;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "            # This uses the same rules as the core win32.c/get_shell() call."
NSQ_SOURCE_LINE 00000033 "            use constant WINDOWS_SHELL => eval { Win32::IsWinNT() }"
NSQ_SOURCE_LINE 00000034 "                ? [ File::Spec->catfile(Win32::GetFolderPath(Win32::CSIDL_SYSTEM), 'cmd.exe'), '/x/d/c' ]"
NSQ_SOURCE_LINE 00000035 "                : [ File::Spec->catfile(Win32::GetFolderPath(Win32::CSIDL_SYSTEM), 'command.com'), '/c' ];"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "            # These are used when invoking _win32_capture"
NSQ_SOURCE_LINE 00000038 "            use constant NO_SHELL  => 0;"
NSQ_SOURCE_LINE 00000039 "            use constant USE_SHELL => 1;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "        };"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "        ## use critic"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "        # Die nosily if any of the above broke."
NSQ_SOURCE_LINE 00000046 "        die $@ if $@;"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "# Note that we don't use WIFSTOPPED because perl never uses"
NSQ_SOURCE_LINE 00000051 "# the WUNTRACED flag, and hence will never return early from"
NSQ_SOURCE_LINE 00000052 "# system() if the child processes is suspended with a SIGSTOP."
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "use POSIX qw(WIFEXITED WEXITSTATUS WIFSIGNALED WTERMSIG);"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "use constant FAIL_START     => q{\"%s\" failed to start: \"%s\"};"
NSQ_SOURCE_LINE 00000057 "use constant FAIL_PLUMBING  => q{Error in IPC::System::Simple plumbing: \"%s\" - \"%s\"};"
NSQ_SOURCE_LINE 00000058 "use constant FAIL_CMD_BLANK => q{Entirely blank command passed: \"%s\"};"
NSQ_SOURCE_LINE 00000059 "use constant FAIL_INTERNAL  => q{Internal error in IPC::System::Simple: \"%s\"};"
NSQ_SOURCE_LINE 00000060 "use constant FAIL_TAINT     => q{%s called with tainted argument \"%s\"};"
NSQ_SOURCE_LINE 00000061 "use constant FAIL_TAINT_ENV => q{%s called with tainted environment $ENV{%s}};"
NSQ_SOURCE_LINE 00000062 "use constant FAIL_SIGNAL    => q{\"%s\" died to signal \"%s\" (%d)%s};"
NSQ_SOURCE_LINE 00000063 "use constant FAIL_BADEXIT   => q{\"%s\" unexpectedly returned exit value %d};"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "use constant FAIL_UNDEF     => q{%s called with undefined command};"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "use constant FAIL_POSIX     => q{IPC::System::Simple does not understand the POSIX error '%s'.  Please check https://metacpan.org/pod/IPC::System::Simple to see if there is an updated version.  If not please report this as a bug to https://github.com/pjf/ipc-system-simple/issues};"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "# On Perl's older than 5.8.x we can't assume that there'll be a"
NSQ_SOURCE_LINE 00000071 "# $^{TAINT} for us to check, so we assume that our args may always"
NSQ_SOURCE_LINE 00000072 "# be tainted."
NSQ_SOURCE_LINE 00000073 "use constant ASSUME_TAINTED => ($] < 5.008);"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "use constant EXIT_ANY_CONST => -1;\t\t\t# Used internally"
NSQ_SOURCE_LINE 00000076 "use constant EXIT_ANY       => [ EXIT_ANY_CONST ];\t# Exported"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "use constant UNDEFINED_POSIX_RE => qr{not (?:defined|a valid) POSIX macro|not implemented on this architecture};"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "require Exporter;"
NSQ_SOURCE_LINE 00000081 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "our @EXPORT_OK = qw( "
NSQ_SOURCE_LINE 00000084 "    capture  capturex"
NSQ_SOURCE_LINE 00000085 "    run      runx"
NSQ_SOURCE_LINE 00000086 "    system   systemx"
NSQ_SOURCE_LINE 00000087 "    $EXITVAL EXIT_ANY"
NSQ_SOURCE_LINE 00000088 ");"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "our $VERSION = '1.30';"
NSQ_SOURCE_LINE 00000091 "$VERSION =~ tr/_//d;"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "our $EXITVAL = -1;"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "my @Signal_from_number = split(' ', $Config{sig_name});"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "# Environment variables we don't want to see tainted."
NSQ_SOURCE_LINE 00000098 "my @Check_tainted_env = qw(PATH IFS CDPATH ENV BASH_ENV);"
NSQ_SOURCE_LINE 00000099 "if (WINDOWS) {"
NSQ_SOURCE_LINE 00000100 "\tpush(@Check_tainted_env, 'PERL5SHELL');"
NSQ_SOURCE_LINE 00000101 "}"
NSQ_SOURCE_LINE 00000102 "if (VMS) {"
NSQ_SOURCE_LINE 00000103 "\tpush(@Check_tainted_env, 'DCL$PATH');"
NSQ_SOURCE_LINE 00000104 "}"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "# Not all systems implement the WIFEXITED calls, but POSIX"
NSQ_SOURCE_LINE 00000107 "# will always export them (even if they're just stubs that"
NSQ_SOURCE_LINE 00000108 "# die with an error).  Test for the presence of a working"
NSQ_SOURCE_LINE 00000109 "# WIFEXITED and friends, or define our own."
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "eval { WIFEXITED(0); };"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "if ($@ =~ UNDEFINED_POSIX_RE) {"
NSQ_SOURCE_LINE 00000114 "        no warnings 'redefine';  ## no critic"
NSQ_SOURCE_LINE 00000115 "\t*WIFEXITED   = sub { not $_[0] & 0xff };"
NSQ_SOURCE_LINE 00000116 "\t*WEXITSTATUS = sub { $_[0] >> 8  };"
NSQ_SOURCE_LINE 00000117 "\t*WIFSIGNALED = sub { $_[0] & 127 };"
NSQ_SOURCE_LINE 00000118 "\t*WTERMSIG    = sub { $_[0] & 127 };"
NSQ_SOURCE_LINE 00000119 "} elsif ($@) {"
NSQ_SOURCE_LINE 00000120 "\tcroak sprintf FAIL_POSIX, $@;"
NSQ_SOURCE_LINE 00000121 "}"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "# None of the POSIX modules I've found define WCOREDUMP, although"
NSQ_SOURCE_LINE 00000124 "# many systems define it.  Check the POSIX module in the hope that"
NSQ_SOURCE_LINE 00000125 "# it may actually be there."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "# TODO: Ideally, $NATIVE_WCOREDUMP should be a constant."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "my $NATIVE_WCOREDUMP;"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "eval { POSIX::WCOREDUMP(1); };"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "if ($@ =~ UNDEFINED_POSIX_RE) {"
NSQ_SOURCE_LINE 00000135 "\t*WCOREDUMP = sub { $_[0] & 128 };"
NSQ_SOURCE_LINE 00000136 "        $NATIVE_WCOREDUMP = 0;"
NSQ_SOURCE_LINE 00000137 "} elsif ($@) {"
NSQ_SOURCE_LINE 00000138 "\tcroak sprintf FAIL_POSIX, $@;"
NSQ_SOURCE_LINE 00000139 "} else {"
NSQ_SOURCE_LINE 00000140 "\t# POSIX actually has it defined!  Huzzah!"
NSQ_SOURCE_LINE 00000141 "\t*WCOREDUMP = \\&POSIX::WCOREDUMP;"
NSQ_SOURCE_LINE 00000142 "        $NATIVE_WCOREDUMP = 1;"
NSQ_SOURCE_LINE 00000143 "}"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "sub _native_wcoredump {"
NSQ_SOURCE_LINE 00000146 "    return $NATIVE_WCOREDUMP;"
NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "# system simply calls run"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "no warnings 'once'; ## no critic"
NSQ_SOURCE_LINE 00000152 "*system  = \\&run;"
NSQ_SOURCE_LINE 00000153 "*systemx = \\&runx;"
NSQ_SOURCE_LINE 00000154 "use warnings;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "# run is our way of running a process with system() semantics"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "sub run {"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "\t_check_taint(@_);"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "\tmy ($valid_returns, $command, @args) = _process_args(@_);"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "        # If we have arguments, we really want to call systemx,"
NSQ_SOURCE_LINE 00000165 "        # so we do so."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "\tif (@args) {"
NSQ_SOURCE_LINE 00000168 "                return systemx($valid_returns, $command, @args);"
NSQ_SOURCE_LINE 00000169 "\t}"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    if (WINDOWS) {"
NSQ_SOURCE_LINE 00000172 "        my $pid = _spawn_or_die(&WINDOWS_SHELL->[0], join ' ', @{&WINDOWS_SHELL}, $command);"
NSQ_SOURCE_LINE 00000173 "        $pid->Wait(INFINITE);\t# Wait for process exit."
NSQ_SOURCE_LINE 00000174 "        $pid->GetExitCode($EXITVAL);"
NSQ_SOURCE_LINE 00000175 "        return _check_exit($command,$EXITVAL,$valid_returns);"
NSQ_SOURCE_LINE 00000176 "    }"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "    # Without arguments, we're calling system, and checking"
NSQ_SOURCE_LINE 00000179 "        # the results."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "\t# We're throwing our own exception on command not found, so"
NSQ_SOURCE_LINE 00000182 "\t# we don't need a warning from Perl."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "        {"
NSQ_SOURCE_LINE 00000185 "            # silence 'Statement unlikely to be reached' warning"
NSQ_SOURCE_LINE 00000186 "            no warnings 'exec';             ## no critic"
NSQ_SOURCE_LINE 00000187 "            CORE::system($command,@args);"
NSQ_SOURCE_LINE 00000188 "        }"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "\treturn _process_child_error($?,$command,$valid_returns);"
NSQ_SOURCE_LINE 00000191 "}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "# runx is just like system/run, but *never* invokes the shell."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "sub runx {"
NSQ_SOURCE_LINE 00000196 "    _check_taint(@_);"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "    my ($valid_returns, $command, @args) = _process_args(@_);"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    if (WINDOWS) {"
NSQ_SOURCE_LINE 00000201 "        our $EXITVAL = -1;"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "        my $pid = _spawn_or_die($command, Win32::ShellQuote::quote_native($command, @args));"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "        $pid->Wait(INFINITE);\t# Wait for process exit."
NSQ_SOURCE_LINE 00000206 "        $pid->GetExitCode($EXITVAL);"
NSQ_SOURCE_LINE 00000207 "        return _check_exit($command,$EXITVAL,$valid_returns);"
NSQ_SOURCE_LINE 00000208 "    }"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    # If system() fails, we throw our own exception.  We don't"
NSQ_SOURCE_LINE 00000211 "    # need to have perl complain about it too."
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "    no warnings; ## no critic"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "    CORE::system { $command } $command, @args;"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "    return _process_child_error($?, $command, $valid_returns);"
NSQ_SOURCE_LINE 00000218 "}"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "# capture is our way of running a process with backticks/qx semantics"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "sub capture {"
NSQ_SOURCE_LINE 00000223 "\t_check_taint(@_);"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "\tmy ($valid_returns, $command, @args) = _process_args(@_);"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "        if (@args) {"
NSQ_SOURCE_LINE 00000228 "            return capturex($valid_returns, $command, @args);"
NSQ_SOURCE_LINE 00000229 "        }"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "        if (WINDOWS) {"
NSQ_SOURCE_LINE 00000232 "            # USE_SHELL really means \"You may use the shell if you need it.\""
NSQ_SOURCE_LINE 00000233 "            return _win32_capture(USE_SHELL, $valid_returns, $command);"
NSQ_SOURCE_LINE 00000234 "        }"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "\tour $EXITVAL = -1;"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "\tmy $wantarray = wantarray();"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "\t# We'll produce our own warnings on failure to execute."
NSQ_SOURCE_LINE 00000241 "\tno warnings 'exec';\t## no critic"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "        if ($wantarray) {"
NSQ_SOURCE_LINE 00000244 "                my @results = qx($command);"
NSQ_SOURCE_LINE 00000245 "                _process_child_error($?,$command,$valid_returns);"
NSQ_SOURCE_LINE 00000246 "                return @results;"
NSQ_SOURCE_LINE 00000247 "        } "
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "        my $results = qx($command);"
NSQ_SOURCE_LINE 00000250 "        _process_child_error($?,$command,$valid_returns);"
NSQ_SOURCE_LINE 00000251 "        return $results;"
NSQ_SOURCE_LINE 00000252 "}"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "# _win32_capture implements the capture and capurex commands on Win32."
NSQ_SOURCE_LINE 00000255 "# We need to wrap the whole internals of this sub into"
NSQ_SOURCE_LINE 00000256 "# an if (WINDOWS) block to avoid it being compiled on non-Win32 systems."
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "sub _win32_capture {"
NSQ_SOURCE_LINE 00000259 "    if (not WINDOWS) {"
NSQ_SOURCE_LINE 00000260 "        croak sprintf(FAIL_INTERNAL, \"_win32_capture called when not under Win32\");"
NSQ_SOURCE_LINE 00000261 "    } else {"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "        my ($use_shell, $valid_returns, $command, @args) = @_;"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "        my $wantarray = wantarray();"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "        # Perl doesn't support multi-arg open under"
NSQ_SOURCE_LINE 00000268 "        # Windows.  Perl also doesn't provide very good"
NSQ_SOURCE_LINE 00000269 "        # feedback when normal backtails fail, either;"
NSQ_SOURCE_LINE 00000270 "        # it returns exit status from the shell"
NSQ_SOURCE_LINE 00000271 "        # (which is indistinguishable from the command"
NSQ_SOURCE_LINE 00000272 "        # running and producing the same exit status)."
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "        # As such, we essentially have to write our own"
NSQ_SOURCE_LINE 00000275 "        # backticks."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "        # We start by dup'ing STDOUT."
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "        open(my $saved_stdout, '>&', \\*STDOUT)  ## no critic"
NSQ_SOURCE_LINE 00000280 "                or croak sprintf(FAIL_PLUMBING, \"Can't dup STDOUT\", $!);"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "        # We now open up a pipe that will allow us to\t"
NSQ_SOURCE_LINE 00000283 "        # communicate with the new process."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "        pipe(my ($read_fh, $write_fh))"
NSQ_SOURCE_LINE 00000286 "                or croak sprintf(FAIL_PLUMBING, \"Can't create pipe\", $!);"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "        # Allow CRLF sequences to become \"\\n\", since"
NSQ_SOURCE_LINE 00000289 "        # this is what Perl backticks do."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "        binmode($read_fh, ':crlf');"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "        # Now we re-open our STDOUT to $write_fh..."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "        open(STDOUT, '>&', $write_fh)  ## no critic"
NSQ_SOURCE_LINE 00000296 "                or croak sprintf(FAIL_PLUMBING, \"Can't redirect STDOUT\", $!);"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "        # If we have args, or we're told not to use the shell, then"
NSQ_SOURCE_LINE 00000299 "        # we treat $command as our shell.  Otherwise we grub around"
NSQ_SOURCE_LINE 00000300 "        # in our command to look for a command to run."
NSQ_SOURCE_LINE 00000301 "        #"
NSQ_SOURCE_LINE 00000302 "        # Note that we don't actually *use* the shell (although in"
NSQ_SOURCE_LINE 00000303 "        # a future version we might).  Being told not to use the shell"
NSQ_SOURCE_LINE 00000304 "        # (capturex) means we treat our command as really being a command,"
NSQ_SOURCE_LINE 00000305 "        # and not a command line."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "        my $exe =   @args                      ? $command :"
NSQ_SOURCE_LINE 00000308 "                    (! $use_shell)             ? $command :"
NSQ_SOURCE_LINE 00000309 "                    $command =~ m{^\"([^\"]+)\"}x ? $1       :"
NSQ_SOURCE_LINE 00000310 "                    $command =~ m{(\\S+)     }x ? $1       :"
NSQ_SOURCE_LINE 00000311 "                    croak sprintf(FAIL_CMD_BLANK, $command);"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "        # And now we spawn our new process with inherited"
NSQ_SOURCE_LINE 00000314 "        # filehandles."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "        my $err;"
NSQ_SOURCE_LINE 00000317 "        my $pid = eval { "
NSQ_SOURCE_LINE 00000318 "                _spawn_or_die($exe, @args ? Win32::ShellQuote::quote_native($command, @args) : $command);"
NSQ_SOURCE_LINE 00000319 "        }"
NSQ_SOURCE_LINE 00000320 "        or do {"
NSQ_SOURCE_LINE 00000321 "                $err = $@;"
NSQ_SOURCE_LINE 00000322 "        };"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "        # Regardless of whether our command ran, we must restore STDOUT."
NSQ_SOURCE_LINE 00000325 "        # RT #48319"
NSQ_SOURCE_LINE 00000326 "        open(STDOUT, '>&', $saved_stdout)  ## no critic"
NSQ_SOURCE_LINE 00000327 "                or croak sprintf(FAIL_PLUMBING,\"Can't restore STDOUT\", $!);"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "        # And now, if there was an actual error , propagate it."
NSQ_SOURCE_LINE 00000330 "        die $err if defined $err;   # If there's an error from _spawn_or_die"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "        # Clean-up the filehandles we no longer need..."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "        close($write_fh)"
NSQ_SOURCE_LINE 00000335 "                or croak sprintf(FAIL_PLUMBING,q{Can't close write end of pipe}, $!);"
NSQ_SOURCE_LINE 00000336 "        close($saved_stdout)"
NSQ_SOURCE_LINE 00000337 "                or croak sprintf(FAIL_PLUMBING,q{Can't close saved STDOUT}, $!);"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "        # Read the data from our child..."
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "        my (@results, $result);"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "        if ($wantarray) {"
NSQ_SOURCE_LINE 00000344 "                @results = <$read_fh>;"
NSQ_SOURCE_LINE 00000345 "        } else {"
NSQ_SOURCE_LINE 00000346 "                $result = join(\"\",<$read_fh>);"
NSQ_SOURCE_LINE 00000347 "        }"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "        # Tidy up our windows process and we're done!"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "        $pid->Wait(INFINITE);\t# Wait for process exit."
NSQ_SOURCE_LINE 00000352 "        $pid->GetExitCode($EXITVAL);"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "        _check_exit($command,$EXITVAL,$valid_returns);"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "        return $wantarray ? @results : $result;"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "    }"
NSQ_SOURCE_LINE 00000359 "}"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "# capturex() is just like backticks/qx, but never invokes the shell."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "sub capturex {"
NSQ_SOURCE_LINE 00000364 "\t_check_taint(@_);"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "\tmy ($valid_returns, $command, @args) = _process_args(@_);"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "\tour $EXITVAL = -1;"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "\tmy $wantarray = wantarray();"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "\tif (WINDOWS) {"
NSQ_SOURCE_LINE 00000373 "            return _win32_capture(NO_SHELL, $valid_returns, $command, @args);"
NSQ_SOURCE_LINE 00000374 "        }"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "\t# We can't use a multi-arg piped open here, since 5.6.x"
NSQ_SOURCE_LINE 00000377 "\t# doesn't like them.  Instead we emulate what 5.8.x does,"
NSQ_SOURCE_LINE 00000378 "\t# which is to create a pipe(), set the close-on-exec flag"
NSQ_SOURCE_LINE 00000379 "\t# on the child, and the fork/exec.  If the exec fails, the"
NSQ_SOURCE_LINE 00000380 "\t# child writes to the pipe.  If the exec succeeds, then"
NSQ_SOURCE_LINE 00000381 "\t# the pipe closes without data."
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "\tpipe(my ($read_fh, $write_fh))"
NSQ_SOURCE_LINE 00000384 "\t\tor croak sprintf(FAIL_PLUMBING, \"Can't create pipe\", $!);"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "\t# This next line also does an implicit fork."
NSQ_SOURCE_LINE 00000387 "\tmy $pid = open(my $pipe, '-|');\t ## no critic"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "\tif (not defined $pid) {"
NSQ_SOURCE_LINE 00000390 "\t\tcroak sprintf(FAIL_START, $command, $!);"
NSQ_SOURCE_LINE 00000391 "\t} elsif (not $pid) {"
NSQ_SOURCE_LINE 00000392 "\t\t# Child process, execs command."
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "\t\tclose($read_fh);"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "\t\t# TODO: 'no warnings exec' doesn't get rid"
NSQ_SOURCE_LINE 00000397 "\t\t# of the 'unlikely to be reached' warnings."
NSQ_SOURCE_LINE 00000398 "\t\t# This is a bug in perl / perldiag / perllexwarn / warnings."
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "\t\tno warnings;   ## no critic"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "\t\tCORE::exec { $command } $command, @args;"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "\t\t# Oh no, exec fails!  Send the reason why to"
NSQ_SOURCE_LINE 00000405 "\t\t# the parent."
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "\t\tprint {$write_fh} int($!);"
NSQ_SOURCE_LINE 00000408 "\t\texit(-1);"
NSQ_SOURCE_LINE 00000409 "\t}"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "\t{"
NSQ_SOURCE_LINE 00000412 "\t\t# In parent process."
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "\t\tclose($write_fh);"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "\t\t# Parent process, check for child error."
NSQ_SOURCE_LINE 00000417 "\t\tmy $error = <$read_fh>;"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "\t\t# Tidy up our pipes."
NSQ_SOURCE_LINE 00000420 "\t\tclose($read_fh);"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "\t\t# Check for error."
NSQ_SOURCE_LINE 00000423 "\t\tif ($error) {"
NSQ_SOURCE_LINE 00000424 "\t\t\t# Setting $! to our child error number gives"
NSQ_SOURCE_LINE 00000425 "\t\t\t# us nice looking strings when printed."
NSQ_SOURCE_LINE 00000426 "\t\t\tlocal $! = $error;"
NSQ_SOURCE_LINE 00000427 "\t\t\tcroak sprintf(FAIL_START, $command, $!);"
NSQ_SOURCE_LINE 00000428 "\t\t}"
NSQ_SOURCE_LINE 00000429 "\t}"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "\t# Parent process, we don't care about our pid, but we"
NSQ_SOURCE_LINE 00000432 "\t# do go and read our pipe."
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "\tif ($wantarray) {"
NSQ_SOURCE_LINE 00000435 "\t\tmy @results = <$pipe>;"
NSQ_SOURCE_LINE 00000436 "\t\tclose($pipe);"
NSQ_SOURCE_LINE 00000437 "\t\t_process_child_error($?,$command,$valid_returns);"
NSQ_SOURCE_LINE 00000438 "\t\treturn @results;"
NSQ_SOURCE_LINE 00000439 "\t}"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "\t# NB: We don't check the return status on close(), since"
NSQ_SOURCE_LINE 00000442 "\t# on failure it sets $?, which we then inspect for more"
NSQ_SOURCE_LINE 00000443 "\t# useful information."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "\tmy $results = join(\"\",<$pipe>);"
NSQ_SOURCE_LINE 00000446 "\tclose($pipe);"
NSQ_SOURCE_LINE 00000447 "\t_process_child_error($?,$command,$valid_returns);"
NSQ_SOURCE_LINE 00000448 "\t"
NSQ_SOURCE_LINE 00000449 "\treturn $results;"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "}"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "# Tries really hard to spawn a process under Windows.  Returns"
NSQ_SOURCE_LINE 00000454 "# the pid on success, or undef on error."
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "sub _spawn_or_die {"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "\t# We need to wrap practically the entire sub in an"
NSQ_SOURCE_LINE 00000459 "\t# if block to ensure it doesn't get compiled under non-Win32"
NSQ_SOURCE_LINE 00000460 "\t# systems.  Compiling on these systems would not only be a"
NSQ_SOURCE_LINE 00000461 "\t# waste of time, but also results in complaints about"
NSQ_SOURCE_LINE 00000462 "\t# the NORMAL_PRIORITY_CLASS constant."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "\tif (not WINDOWS) {"
NSQ_SOURCE_LINE 00000465 "\t\tcroak sprintf(FAIL_INTERNAL, \"_spawn_or_die called when not under Win32\");"
NSQ_SOURCE_LINE 00000466 "\t} else {"
NSQ_SOURCE_LINE 00000467 "\t\tmy ($orig_exe, $cmdline) = @_;"
NSQ_SOURCE_LINE 00000468 "\t\tmy $pid;"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "\t\tmy $exe = $orig_exe;"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "\t\t# If our command doesn't have an extension, add one."
NSQ_SOURCE_LINE 00000473 "\t\t$exe .= $Config{_exe} if ($exe !~ m{\\.});"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "\t\tWin32::Process::Create("
NSQ_SOURCE_LINE 00000476 "\t\t\t$pid, $exe, $cmdline, 1, NORMAL_PRIORITY_CLASS, \".\""
NSQ_SOURCE_LINE 00000477 "\t\t) and return $pid;"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "\t\tmy @path = split(/;/,$ENV{PATH});"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "\t\tforeach my $dir (@path) {"
NSQ_SOURCE_LINE 00000482 "\t\t\tmy $fullpath = File::Spec->catfile($dir,$exe);"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "\t\t\t# We're using -x here on the assumption that stat()"
NSQ_SOURCE_LINE 00000485 "\t\t\t# is faster than spawn, so trying to spawn a process"
NSQ_SOURCE_LINE 00000486 "\t\t\t# for each path element will be unacceptably"
NSQ_SOURCE_LINE 00000487 "\t\t\t# inefficient."
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "\t\t\tif (-x $fullpath) {"
NSQ_SOURCE_LINE 00000490 "\t\t\t\tWin32::Process::Create("
NSQ_SOURCE_LINE 00000491 "\t\t\t\t\t$pid, $fullpath, $cmdline, 1,"
NSQ_SOURCE_LINE 00000492 "\t\t\t\t\tNORMAL_PRIORITY_CLASS, \".\""
NSQ_SOURCE_LINE 00000493 "\t\t\t\t) and return $pid;"
NSQ_SOURCE_LINE 00000494 "\t\t\t}"
NSQ_SOURCE_LINE 00000495 "\t\t}"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "\t\tcroak sprintf(FAIL_START, $orig_exe, $^E);"
NSQ_SOURCE_LINE 00000498 "\t}"
NSQ_SOURCE_LINE 00000499 "}"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "# Complain on tainted arguments or environment."
NSQ_SOURCE_LINE 00000502 "# ASSUME_TAINTED is true for 5.6.x, since it's missing ${^TAINT}"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "sub _check_taint {"
NSQ_SOURCE_LINE 00000505 "\treturn if not (ASSUME_TAINTED or ${^TAINT});"
NSQ_SOURCE_LINE 00000506 "\tmy $caller = (caller(1))[3];"
NSQ_SOURCE_LINE 00000507 "\tforeach my $var (@_) {"
NSQ_SOURCE_LINE 00000508 "\t\tif (tainted $var) {"
NSQ_SOURCE_LINE 00000509 "\t\t\tcroak sprintf(FAIL_TAINT, $caller, $var);"
NSQ_SOURCE_LINE 00000510 "\t\t}"
NSQ_SOURCE_LINE 00000511 "\t}"
NSQ_SOURCE_LINE 00000512 "\tforeach my $var (@Check_tainted_env) {"
NSQ_SOURCE_LINE 00000513 "\t\tif (tainted $ENV{$var} ) {"
NSQ_SOURCE_LINE 00000514 "\t\t\tcroak sprintf(FAIL_TAINT_ENV, $caller, $var);"
NSQ_SOURCE_LINE 00000515 "\t\t}"
NSQ_SOURCE_LINE 00000516 "\t}"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "\treturn;"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "}"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "# This subroutine performs the difficult task of interpreting"
NSQ_SOURCE_LINE 00000523 "# $?.  It's not intended to be called directly, as it will"
NSQ_SOURCE_LINE 00000524 "# croak on errors, and its implementation and interface may"
NSQ_SOURCE_LINE 00000525 "# change in the future."
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "sub _process_child_error {"
NSQ_SOURCE_LINE 00000528 "\tmy ($child_error, $command, $valid_returns) = @_;"
NSQ_SOURCE_LINE 00000529 "\t"
NSQ_SOURCE_LINE 00000530 "\t$EXITVAL = -1;"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "\tmy $coredump = WCOREDUMP($child_error);"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "        # There's a bug in perl 5.8.9 and 5.10.0 where if the system"
NSQ_SOURCE_LINE 00000535 "        # does not provide a native WCOREDUMP, then $? will"
NSQ_SOURCE_LINE 00000536 "        # never contain coredump information.  This code"
NSQ_SOURCE_LINE 00000537 "        # checks to see if we have the bug, and works around"
NSQ_SOURCE_LINE 00000538 "        # it if needed."
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "        if ($] >= 5.008009 and not $NATIVE_WCOREDUMP) {"
NSQ_SOURCE_LINE 00000541 "            $coredump ||= WCOREDUMP( ${^CHILD_ERROR_NATIVE} );"
NSQ_SOURCE_LINE 00000542 "        }"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "\tif ($child_error == -1) {"
NSQ_SOURCE_LINE 00000545 "\t\tcroak sprintf(FAIL_START, $command, $!);"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "\t} elsif ( WIFEXITED( $child_error ) ) {"
NSQ_SOURCE_LINE 00000548 "\t\t$EXITVAL = WEXITSTATUS( $child_error );"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "\t\treturn _check_exit($command,$EXITVAL,$valid_returns);"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "\t} elsif ( WIFSIGNALED( $child_error ) ) {"
NSQ_SOURCE_LINE 00000553 "\t\tmy $signal_no   = WTERMSIG( $child_error );"
NSQ_SOURCE_LINE 00000554 "\t\tmy $signal_name = $Signal_from_number[$signal_no] || \"UNKNOWN\";"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "\t\tcroak sprintf FAIL_SIGNAL, $command, $signal_name, $signal_no, ($coredump ? \" and dumped core\" : \"\");"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "\t} "
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "\tcroak sprintf(FAIL_INTERNAL, qq{'$command' ran without exit value or signal});"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "}"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "# A simple subroutine for checking exit values.  Results in better"
NSQ_SOURCE_LINE 00000566 "# assurance of consistent error messages, and better forward support"
NSQ_SOURCE_LINE 00000567 "# for new features in I::S::S."
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "sub _check_exit {"
NSQ_SOURCE_LINE 00000570 "\tmy ($command, $exitval, $valid_returns) = @_;"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "\t# If we have a single-value list consisting of the EXIT_ANY"
NSQ_SOURCE_LINE 00000573 "\t# value, then we're happy with whatever exit value we're given."
NSQ_SOURCE_LINE 00000574 "\tif (@$valid_returns == 1 and $valid_returns->[0] == EXIT_ANY_CONST) {"
NSQ_SOURCE_LINE 00000575 "\t\treturn $exitval;"
NSQ_SOURCE_LINE 00000576 "\t}"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "\tif (not defined first { $_ == $exitval } @$valid_returns) {"
NSQ_SOURCE_LINE 00000579 "\t\tcroak sprintf FAIL_BADEXIT, $command, $exitval;"
NSQ_SOURCE_LINE 00000580 "\t}\t"
NSQ_SOURCE_LINE 00000581 "\treturn $exitval;"
NSQ_SOURCE_LINE 00000582 "}"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "# This subroutine simply determines a list of valid returns, the command"
NSQ_SOURCE_LINE 00000586 "# name, and any arguments that we need to pass to it."
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "sub _process_args {"
NSQ_SOURCE_LINE 00000589 "\tmy $valid_returns = [ 0 ];"
NSQ_SOURCE_LINE 00000590 "\tmy $caller = (caller(1))[3];"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "\tif (not @_) {"
NSQ_SOURCE_LINE 00000593 "\t\tcroak \"$caller called with no arguments\";"
NSQ_SOURCE_LINE 00000594 "\t}"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "\tif (ref $_[0] eq \"ARRAY\") {"
NSQ_SOURCE_LINE 00000597 "\t\t$valid_returns = shift(@_);"
NSQ_SOURCE_LINE 00000598 "\t}"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "\tif (not @_) {"
NSQ_SOURCE_LINE 00000601 "\t\tcroak \"$caller called with no command\";"
NSQ_SOURCE_LINE 00000602 "\t}"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "\tmy $command = shift(@_);"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "        if (not defined $command) {"
NSQ_SOURCE_LINE 00000607 "                croak sprintf( FAIL_UNDEF, $caller );"
NSQ_SOURCE_LINE 00000608 "        }"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "\treturn ($valid_returns,$command,@_);"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "}"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "1;"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "__END__"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "=head1 NAME"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "IPC::System::Simple - Run commands simply, with detailed diagnostics"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "  use IPC::System::Simple qw(system systemx capture capturex);"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "  system(\"some_command\");        # Command succeeds or dies!"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "  system(\"some_command\",@args);  # Succeeds or dies, avoids shell if @args"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "  systemx(\"some_command\",@args); # Succeeds or dies, NEVER uses the shell"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "  # Capture the output of a command (just like backticks). Dies on error."
NSQ_SOURCE_LINE 00000634 "  my $output = capture(\"some_command\");"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "  # Just like backticks in list context.  Dies on error."
NSQ_SOURCE_LINE 00000637 "  my @output = capture(\"some_command\");"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "  # As above, but avoids the shell if @args is non-empty"
NSQ_SOURCE_LINE 00000640 "  my $output = capture(\"some_command\", @args);"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "  # As above, but NEVER invokes the shell."
NSQ_SOURCE_LINE 00000643 "  my $output = capturex(\"some_command\", @args);"
NSQ_SOURCE_LINE 00000644 "  my @output = capturex(\"some_command\", @args);"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "Calling Perl's in-built C<system()> function is easy, "
NSQ_SOURCE_LINE 00000649 "determining if it was successful is I<hard>.  Let's face it,"
NSQ_SOURCE_LINE 00000650 "C<$?> isn't the nicest variable in the world to play with, and"
NSQ_SOURCE_LINE 00000651 "even if you I<do> check it, producing a well-formatted error"
NSQ_SOURCE_LINE 00000652 "string takes a lot of work."
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "C<IPC::System::Simple> takes the hard work out of calling "
NSQ_SOURCE_LINE 00000655 "external commands.  In fact, if you want to be really lazy,"
NSQ_SOURCE_LINE 00000656 "you can just write:"
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "    use IPC::System::Simple qw(system);"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "and all of your C<system> commands will either succeed (run to"
NSQ_SOURCE_LINE 00000661 "completion and return a zero exit value), or die with rich diagnostic"
NSQ_SOURCE_LINE 00000662 "messages."
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "The C<IPC::System::Simple> module also provides a simple replacement"
NSQ_SOURCE_LINE 00000665 "to Perl's backticks operator.  Simply write:"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "    use IPC::System::Simple qw(capture);"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "and then use the L</capture()> command just like you'd use backticks."
NSQ_SOURCE_LINE 00000670 "If there's an error, it will die with a detailed description of what"
NSQ_SOURCE_LINE 00000671 "went wrong.  Better still, you can even use C<capturex()> to run the"
NSQ_SOURCE_LINE 00000672 "equivalent of backticks, but without the shell:"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "    use IPC::System::Simple qw(capturex);"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "    my $result = capturex($command, @args);"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "If you want more power than the basic interface, including the"
NSQ_SOURCE_LINE 00000679 "ability to specify which exit values are acceptable, trap errors,"
NSQ_SOURCE_LINE 00000680 "or process diagnostics, then read on!"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "=head1 ADVANCED SYNOPSIS"
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "  use IPC::System::Simple qw("
NSQ_SOURCE_LINE 00000685 "    capture capturex system systemx run runx $EXITVAL EXIT_ANY"
NSQ_SOURCE_LINE 00000686 "  );"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "  # Run a command, throwing exception on failure"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "  run(\"some_command\");"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "  runx(\"some_command\",@args);  # Run a command, avoiding the shell"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "  # Do the same thing, but with the drop-in system replacement."
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "  system(\"some_command\");"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "  systemx(\"some_command\", @args);"
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "  # Run a command which must return 0..5, avoid the shell, and get the"
NSQ_SOURCE_LINE 00000701 "  # exit value (we could also look at $EXITVAL)"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "  my $exit_value = runx([0..5], \"some_command\", @args);"
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "  # The same, but any exit value will do."
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "  my $exit_value = runx(EXIT_ANY, \"some_command\", @args);"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "  # Capture output into $result and throw exception on failure"
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "  my $result = capture(\"some_command\");\t"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "  # Check exit value from captured command"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "  print \"some_command exited with status $EXITVAL\\n\";"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "  # Captures into @lines, splitting on $/"
NSQ_SOURCE_LINE 00000718 "  my @lines = capture(\"some_command\"); "
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "  # Run a command which must return 0..5, capture the output into"
NSQ_SOURCE_LINE 00000721 "  # @lines, and avoid the shell."
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "  my @lines  = capturex([0..5], \"some_command\", @args);"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "=head1 ADVANCED USAGE"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "=head2 run() and system()"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "C<IPC::System::Simple> provides a subroutine called"
NSQ_SOURCE_LINE 00000730 "C<run>, that executes a command using the same semantics as"
NSQ_SOURCE_LINE 00000731 "Perl's built-in C<system>:"
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "    use IPC::System::Simple qw(run);"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "    run(\"cat *.txt\");           # Execute command via the shell"
NSQ_SOURCE_LINE 00000736 "    run(\"cat\",\"/etc/motd\");     # Execute command without shell"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "The primary difference between Perl's in-built system and"
NSQ_SOURCE_LINE 00000739 "the C<run> command is that C<run> will throw an exception on"
NSQ_SOURCE_LINE 00000740 "failure, and allows a list of acceptable exit values to be set."
NSQ_SOURCE_LINE 00000741 "See L</Exit values> for further information."
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "In fact, you can even have C<IPC::System::Simple> replace the"
NSQ_SOURCE_LINE 00000744 "default C<system> function for your package so it has the"
NSQ_SOURCE_LINE 00000745 "same behaviour:"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "    use IPC::System::Simple qw(system);"
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "    system(\"cat *.txt\");  # system now succeeds or dies!"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "C<system> and C<run> are aliases to each other."
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "See also L</runx(), systemx() and capturex()> for variants of"
NSQ_SOURCE_LINE 00000754 "C<system()> and C<run()> that never invoke the shell, even with"
NSQ_SOURCE_LINE 00000755 "a single argument."
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "=head2 capture()"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "A second subroutine, named C<capture> executes a command with"
NSQ_SOURCE_LINE 00000760 "the same semantics as Perl's built-in backticks (and C<qx()>):"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "    use IPC::System::Simple qw(capture);"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "    # Capture text while invoking the shell."
NSQ_SOURCE_LINE 00000765 "    my $file  = capture(\"cat /etc/motd\");"
NSQ_SOURCE_LINE 00000766 "    my @lines = capture(\"cat /etc/passwd\");"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "However unlike regular backticks, which always use the shell, C<capture>"
NSQ_SOURCE_LINE 00000769 "will bypass the shell when called with multiple arguments:"
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "    # Capture text while avoiding the shell."
NSQ_SOURCE_LINE 00000772 "    my $file  = capture(\"cat\", \"/etc/motd\");"
NSQ_SOURCE_LINE 00000773 "    my @lines = capture(\"cat\", \"/etc/passwd\");"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "See also L</runx(), systemx() and capturex()> for a variant of"
NSQ_SOURCE_LINE 00000776 "C<capture()> that never invokes the shell, even with a single"
NSQ_SOURCE_LINE 00000777 "argument."
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "=head2 runx(), systemx() and capturex()"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "The C<runx()>, C<systemx()> and C<capturex()> commands are identical"
NSQ_SOURCE_LINE 00000782 "to the multi-argument forms of C<run()>, C<system()> and C<capture()>"
NSQ_SOURCE_LINE 00000783 "respectively, but I<never> invoke the shell, even when called with a"
NSQ_SOURCE_LINE 00000784 "single argument.  These forms are particularly useful when a command's"
NSQ_SOURCE_LINE 00000785 "argument list I<might> be empty, for example:"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "    systemx($cmd, @args);"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "The use of C<systemx()> here guarantees that the shell will I<never>"
NSQ_SOURCE_LINE 00000790 "be invoked, even if C<@args> is empty."
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "=head2 Exception handling"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "In the case where the command returns an unexpected status, both C<run> and"
NSQ_SOURCE_LINE 00000795 "C<capture> will throw an exception, which if not caught will terminate your"
NSQ_SOURCE_LINE 00000796 "program with an error."
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 "Capturing the exception is easy:"
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "    eval {"
NSQ_SOURCE_LINE 00000801 "        run(\"cat *.txt\");"
NSQ_SOURCE_LINE 00000802 "    };"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "    if ($@) {"
NSQ_SOURCE_LINE 00000805 "        print \"Something went wrong - $@\\n\";"
NSQ_SOURCE_LINE 00000806 "    }"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "See the diagnostics section below for more details."
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "=head3 Exception cases"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "C<IPC::System::Simple> considers the following to be unexpected,"
NSQ_SOURCE_LINE 00000813 "and worthy of exception:"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "=over 4"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "=item *"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "Failing to start entirely (eg, command not found, permission denied)."
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "=item *"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "Returning an exit value other than zero (but see below)."
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "=item *"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "Being killed by a signal."
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "=item *"
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "Being passed tainted data (in taint mode)."
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "=back"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "=head2 Exit values"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "Traditionally, system commands return a zero status for success and a"
NSQ_SOURCE_LINE 00000838 "non-zero status for failure.  C<IPC::System::Simple> will default to throwing"
NSQ_SOURCE_LINE 00000839 "an exception if a non-zero exit value is returned."
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "You may specify a range of values which are considered acceptable exit"
NSQ_SOURCE_LINE 00000842 "values by passing an I<array reference> as the first argument.  The"
NSQ_SOURCE_LINE 00000843 "special constant C<EXIT_ANY> can be used to allow I<any> exit value"
NSQ_SOURCE_LINE 00000844 "to be returned."
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "\tuse IPC::System::Simple qw(run system capture EXIT_ANY);"
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "\trun( [0..5], \"cat *.txt\");             # Exit values 0-5 are OK"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "\tsystem( [0..5], \"cat *.txt\");          # This works the same way"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "\tmy @lines = capture( EXIT_ANY, \"cat *.txt\"); # Any exit is fine."
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "The C<run> and replacement C<system> subroutines returns the exit"
NSQ_SOURCE_LINE 00000855 "value of the process:"
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "\tmy $exit_value = run( [0..5], \"cat *.txt\");"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "\t# OR:"
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "\tmy $exit_value = system( [0..5] \"cat *.txt\");"
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "\tprint \"Program exited with value $exit_value\\n\";"
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "=head3 $EXITVAL"
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 "The exit value of any command executed by C<IPC::System::Simple>"
NSQ_SOURCE_LINE 00000868 "can always be retrieved from the C<$IPC::System::Simple::EXITVAL>"
NSQ_SOURCE_LINE 00000869 "variable:"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "This is particularly useful when inspecting results from C<capture>,"
NSQ_SOURCE_LINE 00000872 "which returns the captured text from the command."
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "\tuse IPC::System::Simple qw(capture $EXITVAL EXIT_ANY);"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "\tmy @enemies_defeated = capture(EXIT_ANY, \"defeat_evil\", \"/dev/mordor\");"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "\tprint \"Program exited with value $EXITVAL\\n\";"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "C<$EXITVAL> will be set to C<-1> if the command did not exit normally (eg,"
NSQ_SOURCE_LINE 00000881 "being terminated by a signal) or did not start.  In this situation an"
NSQ_SOURCE_LINE 00000882 "exception will also be thrown."
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "=head2 WINDOWS-SPECIFIC NOTES"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "The C<run> subroutine make available the full 32-bit exit value on"
NSQ_SOURCE_LINE 00000887 "Win32 systems. This has been true since C<IPC::System::Simple> v0.06"
NSQ_SOURCE_LINE 00000888 "when called with multiple arguments, and since v1.25 when called with"
NSQ_SOURCE_LINE 00000889 "a single argument.  This is different from the previous versions of"
NSQ_SOURCE_LINE 00000890 "C<IPC::System::Simple> and from Perl's in-build C<system()> function,"
NSQ_SOURCE_LINE 00000891 "which can only handle 8-bit return values."
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "The C<capture> subroutine always returns the 32-bit exit value under"
NSQ_SOURCE_LINE 00000894 "Windows.  The C<capture> subroutine also never uses the shell,"
NSQ_SOURCE_LINE 00000895 "even when passed a single argument."
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "The C<run> subroutine always uses a shell when passed a single"
NSQ_SOURCE_LINE 00000898 "argument. On NT systems, it uses C<cmd.exe> in the system root, and on"
NSQ_SOURCE_LINE 00000899 "non-NT systems it uses C<command.com> in the system root."
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "As of C<IPC::System::Simple> v1.25, the C<runx> and C<capturex>"
NSQ_SOURCE_LINE 00000902 "subroutines, as well as multiple-argument calls to the C<run> and"
NSQ_SOURCE_LINE 00000903 "C<capture> subroutines, have their arguments properly quoted, so that"
NSQ_SOURCE_LINE 00000904 "arugments with spaces and the like work properly. Unfortunately, this"
NSQ_SOURCE_LINE 00000905 "breaks any attempt to invoke the shell itself. If you really need to"
NSQ_SOURCE_LINE 00000906 "execute C<cmd.exe> or C<command.com>, use the single-argument form."
NSQ_SOURCE_LINE 00000907 "For single-argument calls to C<run> and C<capture>, the argument must"
NSQ_SOURCE_LINE 00000908 "be properly shell-quoted in advance of the call."
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "Versions of C<IPC::System::Simple> before v0.09 would not search"
NSQ_SOURCE_LINE 00000911 "the C<PATH> environment variable when the multi-argument form of"
NSQ_SOURCE_LINE 00000912 "C<run()> was called.  Versions from v0.09 onwards correctly search"
NSQ_SOURCE_LINE 00000913 "the path provided the command is provided including the extension"
NSQ_SOURCE_LINE 00000914 "(eg, C<notepad.exe> rather than just C<notepad>, or C<gvim.bat> rather"
NSQ_SOURCE_LINE 00000915 "than just C<gvim>).  If no extension is provided, C<.exe> is"
NSQ_SOURCE_LINE 00000916 "assumed."
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "Signals are not supported on Windows systems.  Sending a signal"
NSQ_SOURCE_LINE 00000919 "to a Windows process will usually cause it to exit with the signal"
NSQ_SOURCE_LINE 00000920 "number used."
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "=head1 DIAGNOSTICS"
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "=over 4"
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "=item \"%s\" failed to start: \"%s\""
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "The command specified did not even start.  It may not exist, or"
NSQ_SOURCE_LINE 00000929 "you may not have permission to use it.  The reason it could not"
NSQ_SOURCE_LINE 00000930 "start (as determined from C<$!>) will be provided."
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "=item \"%s\" unexpectedly returned exit value %d"
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "The command ran successfully, but returned an exit value we did"
NSQ_SOURCE_LINE 00000935 "not expect.  The value returned is reported."
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "=item \"%s\" died to signal \"%s\" (%d) %s"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "The command was killed by a signal.  The name of the signal"
NSQ_SOURCE_LINE 00000940 "will be reported, or C<UNKNOWN> if it cannot be determined.  The"
NSQ_SOURCE_LINE 00000941 "signal number is always reported.  If we detected that the"
NSQ_SOURCE_LINE 00000942 "process dumped core, then the string C<and dumped core> is"
NSQ_SOURCE_LINE 00000943 "appended."
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 "=item IPC::System::Simple::%s called with no arguments"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "You attempted to call C<run> or C<capture> but did not provide any"
NSQ_SOURCE_LINE 00000948 "arguments at all.  At the very lease you need to supply a command"
NSQ_SOURCE_LINE 00000949 "to run."
NSQ_SOURCE_LINE 00000950 ""
NSQ_SOURCE_LINE 00000951 "=item IPC::System::Simple::%s called with no command"
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "You called C<run> or C<capture> with a list of acceptable exit values,"
NSQ_SOURCE_LINE 00000954 "but no actual command."
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "=item IPC::System::Simple::%s called with tainted argument \"%s\""
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "You called C<run> or C<capture> with tainted (untrusted) arguments, which is"
NSQ_SOURCE_LINE 00000959 "almost certainly a bad idea.  To untaint your arguments you'll need to pass"
NSQ_SOURCE_LINE 00000960 "your data through a regular expression and use the resulting match variables."
NSQ_SOURCE_LINE 00000961 "See L<perlsec/Laundering and Detecting Tainted Data> for more information."
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "=item IPC::System::Simple::%s called with tainted environment $ENV{%s}"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "You called C<run> or C<capture> but part of your environment was tainted"
NSQ_SOURCE_LINE 00000966 "(untrusted).  You should either delete the named environment"
NSQ_SOURCE_LINE 00000967 "variable before calling C<run>, or set it to an untainted value"
NSQ_SOURCE_LINE 00000968 "(usually one set inside your program).  See"
NSQ_SOURCE_LINE 00000969 "L<perlsec/Cleaning Up Your Path> for more information."
NSQ_SOURCE_LINE 00000970 ""
NSQ_SOURCE_LINE 00000971 "=item Error in IPC::System::Simple plumbing: \"%s\" - \"%s\""
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "Implementing the C<capture> command involves dark and terrible magicks"
NSQ_SOURCE_LINE 00000974 "involving pipes, and one of them has sprung a leak.  This could be due to a"
NSQ_SOURCE_LINE 00000975 "lack of file descriptors, although there are other possibilities."
NSQ_SOURCE_LINE 00000976 ""
NSQ_SOURCE_LINE 00000977 "If you are able to reproduce this error, you are encouraged"
NSQ_SOURCE_LINE 00000978 "to submit a bug report according to the L</Reporting bugs> section below."
NSQ_SOURCE_LINE 00000979 ""
NSQ_SOURCE_LINE 00000980 "=item Internal error in IPC::System::Simple: \"%s\""
NSQ_SOURCE_LINE 00000981 ""
NSQ_SOURCE_LINE 00000982 "You've found a bug in C<IPC::System::Simple>.  Please check to"
NSQ_SOURCE_LINE 00000983 "see if an updated version of C<IPC::System::Simple> is available."
NSQ_SOURCE_LINE 00000984 "If not, please file a bug report according to the L</Reporting bugs> section"
NSQ_SOURCE_LINE 00000985 "below."
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "=item IPC::System::Simple::%s called with undefined command"
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "You've passed the undefined value as a command to be executed."
NSQ_SOURCE_LINE 00000990 "While this is a very Zen-like action, it's not supported by"
NSQ_SOURCE_LINE 00000991 "Perl's current implementation."
NSQ_SOURCE_LINE 00000992 ""
NSQ_SOURCE_LINE 00000993 "=back"
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "=head1 DEPENDENCIES"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "This module depends upon L<Win32::Process> when used on Win32"
NSQ_SOURCE_LINE 00000998 "system.  C<Win32::Process> is bundled as a core module in ActivePerl 5.6"
NSQ_SOURCE_LINE 00000999 "and above."
NSQ_SOURCE_LINE 00001000 ""
NSQ_SOURCE_LINE 00001001 "There are no non-core dependencies on non-Win32 systems."
NSQ_SOURCE_LINE 00001002 ""
NSQ_SOURCE_LINE 00001003 "=head1 COMPARISON TO OTHER APIs"
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "Perl provides a range of in-built functions for handling external"
NSQ_SOURCE_LINE 00001006 "commands, and CPAN provides even more.  The C<IPC::System::Simple>"
NSQ_SOURCE_LINE 00001007 "differentiates itself from other options by providing:"
NSQ_SOURCE_LINE 00001008 ""
NSQ_SOURCE_LINE 00001009 "=over 4"
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "=item Extremely detailed diagnostics"
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "The diagnostics produced by C<IPC::System::Simple> are designed"
NSQ_SOURCE_LINE 00001014 "to provide as much information as possible.  Rather than requiring"
NSQ_SOURCE_LINE 00001015 "the developer to inspect C<$?>, C<IPC::System::Simple> does the"
NSQ_SOURCE_LINE 00001016 "hard work for you."
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "If an odd exit status is provided, you're informed of what it is.  If a"
NSQ_SOURCE_LINE 00001019 "signal kills your process, you are informed of both its name and number."
NSQ_SOURCE_LINE 00001020 "If tainted data or environment prevents your command from running, you"
NSQ_SOURCE_LINE 00001021 "are informed of exactly which data or environmental variable is"
NSQ_SOURCE_LINE 00001022 "tainted."
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "=item Exceptions on failure"
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "C<IPC::System::Simple> takes an aggressive approach to error handling."
NSQ_SOURCE_LINE 00001027 "Rather than allow commands to fail silently, exceptions are thrown"
NSQ_SOURCE_LINE 00001028 "when unexpected results are seen.  This allows for easy development"
NSQ_SOURCE_LINE 00001029 "using a try/catch style, and avoids the possibility of accidentally"
NSQ_SOURCE_LINE 00001030 "continuing after a failed command."
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "=item Easy access to exit status"
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "The C<run>, C<system> and C<capture> commands all set C<$EXITVAL>,"
NSQ_SOURCE_LINE 00001035 "making it easy to determine the exit status of a command."
NSQ_SOURCE_LINE 00001036 "Additionally, the C<system> and C<run> interfaces return the exit"
NSQ_SOURCE_LINE 00001037 "status."
NSQ_SOURCE_LINE 00001038 ""
NSQ_SOURCE_LINE 00001039 "=item Consistent interfaces"
NSQ_SOURCE_LINE 00001040 ""
NSQ_SOURCE_LINE 00001041 "When called with multiple arguments, the C<run>, C<system> and"
NSQ_SOURCE_LINE 00001042 "C<capture> interfaces I<never> invoke the shell.  This differs"
NSQ_SOURCE_LINE 00001043 "from the in-built Perl C<system> command which may invoke the"
NSQ_SOURCE_LINE 00001044 "shell under Windows when called with multiple arguments.  It"
NSQ_SOURCE_LINE 00001045 "differs from the in-built Perl backticks operator which always"
NSQ_SOURCE_LINE 00001046 "invokes the shell."
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "=back"
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "=head1 BUGS"
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "When C<system> is exported, the exotic form C<system { $cmd } @args>"
NSQ_SOURCE_LINE 00001053 "is not supported.  Attemping to use the exotic form is a syntax"
NSQ_SOURCE_LINE 00001054 "error.  This affects the calling package I<only>.  Use C<CORE::system>"
NSQ_SOURCE_LINE 00001055 "if you need it, or consider using the L<autodie> module to replace"
NSQ_SOURCE_LINE 00001056 "C<system> with lexical scope."
NSQ_SOURCE_LINE 00001057 ""
NSQ_SOURCE_LINE 00001058 "Core dumps are only checked for when a process dies due to a"
NSQ_SOURCE_LINE 00001059 "signal.  It is not believed there are any systems where processes"
NSQ_SOURCE_LINE 00001060 "can dump core without dying to a signal."
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "C<WIFSTOPPED> status is not checked, as perl never spawns processes"
NSQ_SOURCE_LINE 00001063 "with the C<WUNTRACED> option."
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "Signals are not supported under Win32 systems, since they don't"
NSQ_SOURCE_LINE 00001066 "work at all like Unix signals.  Win32 signals cause commands to"
NSQ_SOURCE_LINE 00001067 "exit with a given exit value, which this modules I<does> capture."
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "=head2 Reporting bugs"
NSQ_SOURCE_LINE 00001070 ""
NSQ_SOURCE_LINE 00001071 "Before reporting a bug, please check to ensure you are using the"
NSQ_SOURCE_LINE 00001072 "most recent version of C<IPC::System::Simple>.  Your problem may"
NSQ_SOURCE_LINE 00001073 "have already been fixed in a new release."
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "You can find the C<IPC::System::Simple> bug-tracker at"
NSQ_SOURCE_LINE 00001076 "L<http://rt.cpan.org/Public/Dist/Display.html?Name=IPC-System-Simple> ."
NSQ_SOURCE_LINE 00001077 "Please check to see if your bug has already been reported; if"
NSQ_SOURCE_LINE 00001078 "in doubt, report yours anyway."
NSQ_SOURCE_LINE 00001079 ""
NSQ_SOURCE_LINE 00001080 "Submitting a patch and/or failing test case will greatly expedite"
NSQ_SOURCE_LINE 00001081 "the fixing of bugs."
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "=head1 FEEDBACK"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "If you find this module useful, please consider rating it on the"
NSQ_SOURCE_LINE 00001086 "CPAN Ratings service at"
NSQ_SOURCE_LINE 00001087 "L<http://cpanratings.perl.org/rate/?distribution=IPC-System-Simple> ."
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "The module author loves to hear how C<IPC::System::Simple> has made"
NSQ_SOURCE_LINE 00001090 "your life better (or worse).  Feedback can be sent to"
NSQ_SOURCE_LINE 00001091 "E<lt>pjf@perltraining.com.auE<gt>."
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "L<autodie> uses C<IPC::System::Simple> to provide succeed-or-die"
NSQ_SOURCE_LINE 00001096 "replacements to C<system> (and other built-ins) with lexical scope."
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "L<POSIX>, L<IPC::Run::Simple>, L<perlipc>, L<perlport>, L<IPC::Run>,"
NSQ_SOURCE_LINE 00001099 "L<IPC::Run3>, L<Win32::Process>"
NSQ_SOURCE_LINE 00001100 ""
