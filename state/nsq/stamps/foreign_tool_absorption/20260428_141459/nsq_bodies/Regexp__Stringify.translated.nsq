NSQ_SOURCE_LINE 00000001 "package Regexp::Stringify;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2016-10-29'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.06'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use re qw(regexp_pattern);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Exporter;"
NSQ_SOURCE_LINE 00000013 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw(stringify_regexp);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our %SPEC;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "$SPEC{stringify_regexp} = {"
NSQ_SOURCE_LINE 00000019 "    v => 1.1,"
NSQ_SOURCE_LINE 00000020 "    summary => 'Stringify a Regexp object',"
NSQ_SOURCE_LINE 00000021 "    description => <<'_',"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "This routine is an alternative to Perl's default stringification of Regexp"
NSQ_SOURCE_LINE 00000024 "object (i.e.:`\"$re\"`) and has some features/options, e.g.: producing regexp"
NSQ_SOURCE_LINE 00000025 "string that is compatible with certain perl versions."
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "If given a string (or other non-Regexp object), will return it as-is."
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "_"
NSQ_SOURCE_LINE 00000030 "    args => {"
NSQ_SOURCE_LINE 00000031 "        regexp => {"
NSQ_SOURCE_LINE 00000032 "            schema => 're*',"
NSQ_SOURCE_LINE 00000033 "            req => 1,"
NSQ_SOURCE_LINE 00000034 "            pos => 0,"
NSQ_SOURCE_LINE 00000035 "        },"
NSQ_SOURCE_LINE 00000036 "        plver => {"
NSQ_SOURCE_LINE 00000037 "            summary => 'Target perl version',"
NSQ_SOURCE_LINE 00000038 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000039 "            description => <<'_',"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "Try to produce a regexp object compatible with a certain perl version (should at"
NSQ_SOURCE_LINE 00000042 "least be >= 5.10)."
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "For example, in perl 5.14 regex stringification changes, e.g. `qr/hlagh/i` would"
NSQ_SOURCE_LINE 00000045 "previously be stringified as `(?i-xsm:hlagh)`, but now it's stringified as"
NSQ_SOURCE_LINE 00000046 "`(?^i:hlagh)`. If you set `plver` to 5.10 or 5.12, then this routine will"
NSQ_SOURCE_LINE 00000047 "still produce the former. It will also ignore regexp modifiers that are"
NSQ_SOURCE_LINE 00000048 "introduced in newer perls."
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "Note that not all regexp objects are translatable to older perls, e.g. if they"
NSQ_SOURCE_LINE 00000051 "contain constructs not known to older perls like `(?^...)` before perl 5.14."
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "_"
NSQ_SOURCE_LINE 00000054 "        },"
NSQ_SOURCE_LINE 00000055 "        with_qr => {"
NSQ_SOURCE_LINE 00000056 "            schema  => 'bool',"
NSQ_SOURCE_LINE 00000057 "            description => <<'_',"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "If you set this to 1, then `qr/a/i` will be stringified as `'qr/a/i'` instead as"
NSQ_SOURCE_LINE 00000060 "`'(?^i:a)'`. The resulting string can then be eval-ed to recreate the Regexp"
NSQ_SOURCE_LINE 00000061 "object."
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "_"
NSQ_SOURCE_LINE 00000064 "        },"
NSQ_SOURCE_LINE 00000065 "    },"
NSQ_SOURCE_LINE 00000066 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000067 "    result => {"
NSQ_SOURCE_LINE 00000068 "        schema => 'str*',"
NSQ_SOURCE_LINE 00000069 "    },"
NSQ_SOURCE_LINE 00000070 "};"
NSQ_SOURCE_LINE 00000071 "sub stringify_regexp {"
NSQ_SOURCE_LINE 00000072 "    my %args = @_;"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    my $re = $args{regexp};"
NSQ_SOURCE_LINE 00000075 "    return $re unless ref($re) eq 'Regexp';"
NSQ_SOURCE_LINE 00000076 "    my $plver = $args{plver} // $^V;"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "    my ($pat, $mod) = regexp_pattern($re);"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "    my $ge_5140 = version->parse($plver) >= version->parse('5.14.0');"
NSQ_SOURCE_LINE 00000081 "    unless ($ge_5140) {"
NSQ_SOURCE_LINE 00000082 "        $mod =~ s/[adlu]//g;"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    if ($args{with_qr}) {"
NSQ_SOURCE_LINE 00000086 "        return \"qr($pat)$mod\";"
NSQ_SOURCE_LINE 00000087 "    } else {"
NSQ_SOURCE_LINE 00000088 "        if ($ge_5140) {"
NSQ_SOURCE_LINE 00000089 "            return \"(^$mod:$pat)\";"
NSQ_SOURCE_LINE 00000090 "        } else {"
NSQ_SOURCE_LINE 00000091 "            return \"(?:(?$mod-)$pat)\";"
NSQ_SOURCE_LINE 00000092 "        }"
NSQ_SOURCE_LINE 00000093 "    }"
NSQ_SOURCE_LINE 00000094 "}"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "1;"
NSQ_SOURCE_LINE 00000097 "# ABSTRACT: Stringify a Regexp object"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "__END__"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=pod"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=head1 NAME"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "Regexp::Stringify - Stringify a Regexp object"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=head1 VERSION"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "This document describes version 0.06 of Regexp::Stringify (from Perl distribution Regexp-Stringify), released on 2016-10-29."
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "Assuming this runs on Perl 5.14 or newer."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 " use Regexp::Stringify qw(stringify_regexp);"
NSQ_SOURCE_LINE 00000118 " $str = stringify_regexp(regexp=>qr/a/i);                       # '(^i:a)'"
NSQ_SOURCE_LINE 00000119 " $str = stringify_regexp(regexp=>qr/a/i, with_qr=>1);           # 'qr(a)i'"
NSQ_SOURCE_LINE 00000120 " $str = stringify_regexp(regexp=>qr/a/i, plver=>5.010);         # '(?:(?i-)a)'"
NSQ_SOURCE_LINE 00000121 " $str = stringify_regexp(regexp=>qr/a/ui, plver=>5.010);        # '(?:(?i-)a)'"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=head2 stringify_regexp(%args) -> str"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "Stringify a Regexp object."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "This routine is an alternative to Perl's default stringification of Regexp"
NSQ_SOURCE_LINE 00000131 "object (i.e.:C<\"$re\">) and has some features/options, e.g.: producing regexp"
NSQ_SOURCE_LINE 00000132 "string that is compatible with certain perl versions."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "If given a string (or other non-Regexp object), will return it as-is."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=over 4"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=item * B<plver> => I<str>"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "Target perl version."
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "Try to produce a regexp object compatible with a certain perl version (should at"
NSQ_SOURCE_LINE 00000147 "least be >= 5.10)."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "For example, in perl 5.14 regex stringification changes, e.g. C<qr/hlagh/i> would"
NSQ_SOURCE_LINE 00000150 "previously be stringified as C<(?i-xsm:hlagh)>, but now it's stringified as"
NSQ_SOURCE_LINE 00000151 "C<(?^i:hlagh)>. If you set C<plver> to 5.10 or 5.12, then this routine will"
NSQ_SOURCE_LINE 00000152 "still produce the former. It will also ignore regexp modifiers that are"
NSQ_SOURCE_LINE 00000153 "introduced in newer perls."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "Note that not all regexp objects are translatable to older perls, e.g. if they"
NSQ_SOURCE_LINE 00000156 "contain constructs not known to older perls like C<(?^...)> before perl 5.14."
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=item * B<regexp>* => I<re>"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=item * B<with_qr> => I<bool>"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "If you set this to 1, then C<qr/a/i> will be stringified as C<'qr/a/i'> instead as"
NSQ_SOURCE_LINE 00000163 "C<'(?^i:a)'>. The resulting string can then be eval-ed to recreate the Regexp"
NSQ_SOURCE_LINE 00000164 "object."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=back"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "Return value:  (str)"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "Please visit the project's homepage at L<https://metacpan.org/release/Regexp-Stringify>."
NSQ_SOURCE_LINE 00000173 ""
