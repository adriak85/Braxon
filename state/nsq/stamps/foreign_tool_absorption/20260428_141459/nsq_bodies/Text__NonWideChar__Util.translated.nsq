NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=head1 NAME"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "Text::NonWideChar::Util - Utility routines for text"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=head1 VERSION"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "This document describes version 0.004 of Text::NonWideChar::Util (from Perl distribution Text-NonWideChar-Util), released on 2021-04-16."
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 " use Text::NonWideChar::Util qw("
NSQ_SOURCE_LINE 00000050 "     length_height);"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 " # get length as well as number of lines"
NSQ_SOURCE_LINE 00000053 " say mbswidth_height(\"one\\ntwo\\nthree\"); # => [5, 3]"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "This module provides the non-wide version of some of the routines in"
NSQ_SOURCE_LINE 00000058 "L<Text::WideChar::Util>."
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=head2 length_height($text) => [INT, INT]"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "This is the non-wide version of C<mbswidth_height()> and can be used if your"
NSQ_SOURCE_LINE 00000065 "text only contains printable ASCII characters and newlines."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=head1 FAQ"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "=head2 Why split functionalities of wide character and color support into multiple modules/distributions?"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "Performance (see numbers in the function description), dependency"
NSQ_SOURCE_LINE 00000072 "(L<Unicode::GCString> is used for wide character support), and overhead (loading"
NSQ_SOURCE_LINE 00000073 "Unicode::GCString)."
NSQ_SOURCE_LINE 00000074 ""
