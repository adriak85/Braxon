NSQ_SOURCE_LINE 00000001 "package Text::NonWideChar::Util;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2021-04-16'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.004'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000010 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000011 "                       length_height"
NSQ_SOURCE_LINE 00000012 "               );"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub length_height {"
NSQ_SOURCE_LINE 00000015 "    my $text = shift;"
NSQ_SOURCE_LINE 00000016 "    my $num_lines = 0;"
NSQ_SOURCE_LINE 00000017 "    my $len = 0;"
NSQ_SOURCE_LINE 00000018 "    for my $e (split /(\\r?\\n)/, $text) {"
NSQ_SOURCE_LINE 00000019 "        if ($e =~ /\\n/) {"
NSQ_SOURCE_LINE 00000020 "            $num_lines++;"
NSQ_SOURCE_LINE 00000021 "            next;"
NSQ_SOURCE_LINE 00000022 "        }"
NSQ_SOURCE_LINE 00000023 "        $num_lines = 1 if $num_lines == 0;"
NSQ_SOURCE_LINE 00000024 "        my $l = length($e);"
NSQ_SOURCE_LINE 00000025 "        $len = $l if $len < $l;"
NSQ_SOURCE_LINE 00000026 "    }"
NSQ_SOURCE_LINE 00000027 "    [$len, $num_lines];"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "1;"
NSQ_SOURCE_LINE 00000031 "# ABSTRACT: Utility routines for text"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "__END__"
NSQ_SOURCE_LINE 00000034 ""
