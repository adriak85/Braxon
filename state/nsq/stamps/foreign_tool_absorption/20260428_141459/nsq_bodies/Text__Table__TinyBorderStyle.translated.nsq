NSQ_SOURCE_LINE 00000001 "package Text::Table::TinyBorderStyle;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use List::Util ();"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000012 "our $DATE = '2022-02-14'; # DATE"
NSQ_SOURCE_LINE 00000013 "our $DIST = 'Text-Table-TinyBorderStyle'; # DIST"
NSQ_SOURCE_LINE 00000014 "our $VERSION = '0.005'; # VERSION"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw/ generate_table /;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub generate_table {"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    my %params = @_;"
NSQ_SOURCE_LINE 00000021 "    my $rows = $params{rows} or die \"Must provide rows!\";"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    my $border_style_name = $params{border_style} ||"
NSQ_SOURCE_LINE 00000024 "        $ENV{TEXT_TABLE_TINY_BORDER_STYLE} ||"
NSQ_SOURCE_LINE 00000025 "        $ENV{BORDER_STYLE} ||"
NSQ_SOURCE_LINE 00000026 "        'BorderStyle::ASCII::SingleLine';"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    require Module::Load::Util;"
NSQ_SOURCE_LINE 00000029 "    my $border_style_obj = Module::Load::Util::instantiate_class_with_optional_args("
NSQ_SOURCE_LINE 00000030 "        {ns_prefixes=>[\"BorderStyle\", \"\"]}, $border_style_name);"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    # foreach col, get the biggest width"
NSQ_SOURCE_LINE 00000033 "    my $widths = _maxwidths($rows);"
NSQ_SOURCE_LINE 00000034 "    my $max_index = _max_array_index($rows);"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    my $table_has_header_row = $params{header_row} && @$rows;"
NSQ_SOURCE_LINE 00000037 "    my $table_has_data_row   = @$rows >= ($params{header_row} ? 2:1);"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    # use that to get the field format and separators"
NSQ_SOURCE_LINE 00000040 "    my $row_format        = _get_row_format          ($border_style_obj, $widths);"
NSQ_SOURCE_LINE 00000041 "    my $header_row_format = _get_header_row_format   ($border_style_obj, $widths);"
NSQ_SOURCE_LINE 00000042 "    my $top_border        = _get_top_border          ($border_style_obj, $widths, $table_has_header_row, $table_has_data_row);"
NSQ_SOURCE_LINE 00000043 "    my $head_row_sep      = _get_header_row_separator($border_style_obj, $widths);"
NSQ_SOURCE_LINE 00000044 "    my $row_sep           = _get_row_separator       ($border_style_obj, $widths);"
NSQ_SOURCE_LINE 00000045 "    my $bottom_border     = _get_bottom_border       ($border_style_obj, $widths, $table_has_header_row, $table_has_data_row);"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    # here we go..."
NSQ_SOURCE_LINE 00000048 "    my @table;"
NSQ_SOURCE_LINE 00000049 "    push @table, $top_border;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    # if the first row's a header:"
NSQ_SOURCE_LINE 00000052 "    my $data_begins = 0;"
NSQ_SOURCE_LINE 00000053 "    {"
NSQ_SOURCE_LINE 00000054 "        last unless $params{header_row};"
NSQ_SOURCE_LINE 00000055 "        my $header_row = $rows->[0];"
NSQ_SOURCE_LINE 00000056 "        last unless $header_row;"
NSQ_SOURCE_LINE 00000057 "        $data_begins++;"
NSQ_SOURCE_LINE 00000058 "        push @table, sprintf("
NSQ_SOURCE_LINE 00000059 "                         $header_row_format,"
NSQ_SOURCE_LINE 00000060 "                         map { defined($header_row->[$_]) ? $header_row->[$_] : '' } (0..$max_index)"
NSQ_SOURCE_LINE 00000061 "                     );"
NSQ_SOURCE_LINE 00000062 "        push @table, $head_row_sep;"
NSQ_SOURCE_LINE 00000063 "    }"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    # then the data"
NSQ_SOURCE_LINE 00000066 "    my $i = 0;"
NSQ_SOURCE_LINE 00000067 "    foreach my $row ( @{ $rows }[$data_begins..$#$rows] ) {"
NSQ_SOURCE_LINE 00000068 "        push @table, $row_sep if $params{separate_rows} && $i++;"
NSQ_SOURCE_LINE 00000069 "        push @table, sprintf("
NSQ_SOURCE_LINE 00000070 "\t    $row_format,"
NSQ_SOURCE_LINE 00000071 "\t    map { defined($row->[$_]) ? $row->[$_] : '' } (0..$max_index)"
NSQ_SOURCE_LINE 00000072 "\t);"
NSQ_SOURCE_LINE 00000073 "    }"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    # this will have already done the bottom if called explicitly"
NSQ_SOURCE_LINE 00000076 "    push @table, $bottom_border;"
NSQ_SOURCE_LINE 00000077 "    return join(\"\\n\",grep {$_} @table);"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "sub _get_cols_and_rows ($) { ## no critic: Subroutines::ProhibitSubroutinePrototypes"
NSQ_SOURCE_LINE 00000081 "    my $rows = shift;"
NSQ_SOURCE_LINE 00000082 "    return ( List::Util::max( map { scalar @$_ } @$rows), scalar @$rows);"
NSQ_SOURCE_LINE 00000083 "}"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "sub _maxwidths {"
NSQ_SOURCE_LINE 00000086 "    my $rows = shift;"
NSQ_SOURCE_LINE 00000087 "    # what's the longest array in this list of arrays?"
NSQ_SOURCE_LINE 00000088 "    my $max_index = _max_array_index($rows);"
NSQ_SOURCE_LINE 00000089 "    my $widths = [];"
NSQ_SOURCE_LINE 00000090 "    for my $i (0..$max_index) {"
NSQ_SOURCE_LINE 00000091 "        # go through the $i-th element of each array, find the longest"
NSQ_SOURCE_LINE 00000092 "        my $max = List::Util::max(map {defined $$_[$i] ? length($$_[$i]) : 0} @$rows);"
NSQ_SOURCE_LINE 00000093 "        push @$widths, $max;"
NSQ_SOURCE_LINE 00000094 "    }"
NSQ_SOURCE_LINE 00000095 "    return $widths;"
NSQ_SOURCE_LINE 00000096 "}"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "# return highest top-index from all rows in case they're different lengths"
NSQ_SOURCE_LINE 00000099 "sub _max_array_index {"
NSQ_SOURCE_LINE 00000100 "    my $rows = shift;"
NSQ_SOURCE_LINE 00000101 "    return List::Util::max( map { $#$_ } @$rows );"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "# TODO: what if border character contains %"
NSQ_SOURCE_LINE 00000105 "sub _get_row_format {"
NSQ_SOURCE_LINE 00000106 "    my ($border_style_obj, $widths, $table_has_header_row, $table_has_data_row) = @_;"
NSQ_SOURCE_LINE 00000107 "    my %gbcargs = (for_data_row=>1);"
NSQ_SOURCE_LINE 00000108 "    join("
NSQ_SOURCE_LINE 00000109 "        \"\","
NSQ_SOURCE_LINE 00000110 "        $border_style_obj->get_border_char(char=>'v_l', %gbcargs),"
NSQ_SOURCE_LINE 00000111 "        \" \","
NSQ_SOURCE_LINE 00000112 "        join("
NSQ_SOURCE_LINE 00000113 "            \" \"."
NSQ_SOURCE_LINE 00000114 "            $border_style_obj->get_border_char(char=>'v_i', %gbcargs)."
NSQ_SOURCE_LINE 00000115 "            \" \","
NSQ_SOURCE_LINE 00000116 "            map { \"%-${_}s\" } @$widths),"
NSQ_SOURCE_LINE 00000117 "        \" \","
NSQ_SOURCE_LINE 00000118 "        $border_style_obj->get_border_char(char=>'v_r', %gbcargs),"
NSQ_SOURCE_LINE 00000119 "    );"
NSQ_SOURCE_LINE 00000120 "}"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "# TODO: what if border character contains %"
NSQ_SOURCE_LINE 00000123 "sub _get_header_row_format {"
NSQ_SOURCE_LINE 00000124 "    my ($border_style_obj, $widths) = @_;"
NSQ_SOURCE_LINE 00000125 "    my %gbcargs = (for_header_row=>1);"
NSQ_SOURCE_LINE 00000126 "    join("
NSQ_SOURCE_LINE 00000127 "        \"\","
NSQ_SOURCE_LINE 00000128 "        $border_style_obj->get_border_char(char=>'v_l', %gbcargs),"
NSQ_SOURCE_LINE 00000129 "        \" \","
NSQ_SOURCE_LINE 00000130 "        join("
NSQ_SOURCE_LINE 00000131 "            \" \"."
NSQ_SOURCE_LINE 00000132 "            $border_style_obj->get_border_char(char=>'v_i', %gbcargs)."
NSQ_SOURCE_LINE 00000133 "            \" \","
NSQ_SOURCE_LINE 00000134 "            map { \"%-${_}s\" } @$widths),"
NSQ_SOURCE_LINE 00000135 "        \" \","
NSQ_SOURCE_LINE 00000136 "        $border_style_obj->get_border_char(char=>'v_r', %gbcargs),"
NSQ_SOURCE_LINE 00000137 "    );"
NSQ_SOURCE_LINE 00000138 "}"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "sub _get_top_border {"
NSQ_SOURCE_LINE 00000141 "    my ($border_style_obj, $widths, $table_has_header_row, $table_has_data_row) = @_;"
NSQ_SOURCE_LINE 00000142 "    my %gbcargs = ();"
NSQ_SOURCE_LINE 00000143 "    if ($table_has_header_row) {"
NSQ_SOURCE_LINE 00000144 "        $gbcargs{for_header_row} = 1;"
NSQ_SOURCE_LINE 00000145 "    } else {"
NSQ_SOURCE_LINE 00000146 "        $gbcargs{for_data_row} = 1;"
NSQ_SOURCE_LINE 00000147 "    }"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    # assume there's no top border when the rd_t character is empty"
NSQ_SOURCE_LINE 00000150 "    my $rd_t = $border_style_obj->get_border_char(char=>'rd_t', %gbcargs);"
NSQ_SOURCE_LINE 00000151 "    return '' unless length $rd_t;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    join("
NSQ_SOURCE_LINE 00000154 "        \"\","
NSQ_SOURCE_LINE 00000155 "        $rd_t,"
NSQ_SOURCE_LINE 00000156 "        $border_style_obj->get_border_char(char=>'h_t', %gbcargs),"
NSQ_SOURCE_LINE 00000157 "        join("
NSQ_SOURCE_LINE 00000158 "            $border_style_obj->get_border_char(char=>'h_t', %gbcargs)."
NSQ_SOURCE_LINE 00000159 "            $border_style_obj->get_border_char(char=>'hd_t', %gbcargs)."
NSQ_SOURCE_LINE 00000160 "            $border_style_obj->get_border_char(char=>'h_t', %gbcargs),"
NSQ_SOURCE_LINE 00000161 "            map { sprintf(\"%-${_}s\", $border_style_obj->get_border_char(char=>'h_t', repeat=>$_, %gbcargs)) } @$widths),"
NSQ_SOURCE_LINE 00000162 "        $border_style_obj->get_border_char(char=>'h_t', %gbcargs),"
NSQ_SOURCE_LINE 00000163 "        $border_style_obj->get_border_char(char=>'ld_t', %gbcargs),"
NSQ_SOURCE_LINE 00000164 "    );"
NSQ_SOURCE_LINE 00000165 "}"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "sub _get_header_row_separator {"
NSQ_SOURCE_LINE 00000168 "    my ($border_style_obj, $widths) = @_;"
NSQ_SOURCE_LINE 00000169 "    my %gbcargs = (for_header_data_separator=>1);"
NSQ_SOURCE_LINE 00000170 "    join("
NSQ_SOURCE_LINE 00000171 "        \"\","
NSQ_SOURCE_LINE 00000172 "        $border_style_obj->get_border_char(char=>'rv_l', %gbcargs),"
NSQ_SOURCE_LINE 00000173 "        $border_style_obj->get_border_char(char=>'h_i', %gbcargs),"
NSQ_SOURCE_LINE 00000174 "        join("
NSQ_SOURCE_LINE 00000175 "            $border_style_obj->get_border_char(char=>'h_i', %gbcargs)."
NSQ_SOURCE_LINE 00000176 "            $border_style_obj->get_border_char(char=>'hv_i', %gbcargs)."
NSQ_SOURCE_LINE 00000177 "            $border_style_obj->get_border_char(char=>'h_i', %gbcargs),"
NSQ_SOURCE_LINE 00000178 "            map { sprintf(\"%-${_}s\", $border_style_obj->get_border_char(char=>'h_i', repeat=>$_, %gbcargs)) } @$widths),"
NSQ_SOURCE_LINE 00000179 "        $border_style_obj->get_border_char(char=>'h_i', %gbcargs),"
NSQ_SOURCE_LINE 00000180 "        $border_style_obj->get_border_char(char=>'lv_r', %gbcargs),"
NSQ_SOURCE_LINE 00000181 "    );"
NSQ_SOURCE_LINE 00000182 "}"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "sub _get_row_separator {"
NSQ_SOURCE_LINE 00000185 "    my ($border_style_obj, $widths) = @_;"
NSQ_SOURCE_LINE 00000186 "    my %gbcargs = (for_data_row=>1, for_data_data_separator=>1);"
NSQ_SOURCE_LINE 00000187 "    join("
NSQ_SOURCE_LINE 00000188 "        \"\","
NSQ_SOURCE_LINE 00000189 "        $border_style_obj->get_border_char(char=>'rv_l', %gbcargs),"
NSQ_SOURCE_LINE 00000190 "        $border_style_obj->get_border_char(char=>'h_i', %gbcargs),"
NSQ_SOURCE_LINE 00000191 "        join("
NSQ_SOURCE_LINE 00000192 "            $border_style_obj->get_border_char(char=>'h_i', %gbcargs)."
NSQ_SOURCE_LINE 00000193 "            $border_style_obj->get_border_char(char=>'hv_i', %gbcargs)."
NSQ_SOURCE_LINE 00000194 "            $border_style_obj->get_border_char(char=>'h_i', %gbcargs),"
NSQ_SOURCE_LINE 00000195 "            map { sprintf(\"%-${_}s\", $border_style_obj->get_border_char(char=>'h_i', repeat=>$_, %gbcargs)) } @$widths),"
NSQ_SOURCE_LINE 00000196 "        $border_style_obj->get_border_char(char=>'h_i', %gbcargs),"
NSQ_SOURCE_LINE 00000197 "        $border_style_obj->get_border_char(char=>'lv_r', %gbcargs),"
NSQ_SOURCE_LINE 00000198 "    );"
NSQ_SOURCE_LINE 00000199 "}"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "sub _get_bottom_border {"
NSQ_SOURCE_LINE 00000202 "    my ($border_style_obj, $widths, $table_has_header_row, $table_has_data_row) = @_;"
NSQ_SOURCE_LINE 00000203 "    my %gbcargs = ();"
NSQ_SOURCE_LINE 00000204 "    if (!$table_has_data_row) {"
NSQ_SOURCE_LINE 00000205 "        $gbcargs{for_header_row} = 1;"
NSQ_SOURCE_LINE 00000206 "    } else {"
NSQ_SOURCE_LINE 00000207 "        $gbcargs{for_data_row} = 1;"
NSQ_SOURCE_LINE 00000208 "    }"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    my $ru_b = $border_style_obj->get_border_char(char=>'ru_b', %gbcargs);"
NSQ_SOURCE_LINE 00000211 "    # assume we don't have bottom border when ru_b character is empty"
NSQ_SOURCE_LINE 00000212 "    return '' unless length $ru_b;"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "    join("
NSQ_SOURCE_LINE 00000215 "        \"\","
NSQ_SOURCE_LINE 00000216 "        $ru_b,"
NSQ_SOURCE_LINE 00000217 "        $border_style_obj->get_border_char(char=>'h_b', %gbcargs),"
NSQ_SOURCE_LINE 00000218 "        join("
NSQ_SOURCE_LINE 00000219 "            $border_style_obj->get_border_char(char=>'h_b', %gbcargs)."
NSQ_SOURCE_LINE 00000220 "            $border_style_obj->get_border_char(char=>'hu_b', %gbcargs)."
NSQ_SOURCE_LINE 00000221 "            $border_style_obj->get_border_char(char=>'h_b', %gbcargs),"
NSQ_SOURCE_LINE 00000222 "            map { sprintf(\"%-${_}s\", $border_style_obj->get_border_char(char=>'h_b', repeat=>$_, %gbcargs)) } @$widths),"
NSQ_SOURCE_LINE 00000223 "        $border_style_obj->get_border_char(char=>'h_b', %gbcargs),"
NSQ_SOURCE_LINE 00000224 "        $border_style_obj->get_border_char(char=>'lu_b', %gbcargs),"
NSQ_SOURCE_LINE 00000225 "    );"
NSQ_SOURCE_LINE 00000226 "}"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "# Back-compat: 'table' is an alias for 'generate_table', but isn't exported"
NSQ_SOURCE_LINE 00000229 "{"
NSQ_SOURCE_LINE 00000230 "    no warnings 'once';"
