NSQ_SOURCE_LINE 00000234 "1;"
NSQ_SOURCE_LINE 00000235 "# ABSTRACT: Text::Table::Tiny + support for border styles"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "__END__"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=pod"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head1 NAME"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "Text::Table::TinyBorderStyle - Text::Table::Tiny + support for border styles"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head1 VERSION"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "This document describes version 0.005 of Text::Table::TinyBorderStyle (from Perl distribution Text-Table-TinyBorderStyle), released on 2022-02-14."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 " use Text::Table::TinyBorderStyle qw/ generate_table /;"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 " my $rows = ["
NSQ_SOURCE_LINE 00000256 "     # header row"
NSQ_SOURCE_LINE 00000257 "     ['Name','Rank','Serial'],"
NSQ_SOURCE_LINE 00000258 "     # rows"
NSQ_SOURCE_LINE 00000259 "     ['alice', 'pvt', '123456'],"
NSQ_SOURCE_LINE 00000260 "     ['bob',   'cpl', '98765321'],"
NSQ_SOURCE_LINE 00000261 "     ['carol', 'brig gen', '8745'],"
NSQ_SOURCE_LINE 00000262 " ];"
NSQ_SOURCE_LINE 00000263 " print generate_table(rows => $rows, header_row => 1, border_style => 'BorderStyle::ASCII::SingleLine');"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "This module is like L<Text::Table::Tiny> (0.04) with added support for using"
NSQ_SOURCE_LINE 00000268 "border styles. For more details about border styles, see L<BorderStyle>"
NSQ_SOURCE_LINE 00000269 "specification. The styles are in C<BorderStyle::*> modules. Try installing and"
NSQ_SOURCE_LINE 00000270 "using the border style modules to see what they look like."
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "Interface, options, and format variables are the same as in Text::Table::Tiny."
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "=for Pod::Coverage ^(.+)$"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head2 BORDER_STYLE"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "Set default for C<border_style> argument. See also"
NSQ_SOURCE_LINE 00000281 "L</TEXT_TABLE_TINY_BORDER_STYLE>."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "=head2 TEXT_TABLE_TINY_BORDER_STYLE"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "Set default for C<border_style> argument. Takes precedence over"
NSQ_SOURCE_LINE 00000286 "L</BORDER_STYLE>."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "Please visit the project's homepage at L<https://metacpan.org/release/Text-Table-TinyBorderStyle>."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "Source repository is at L<https://github.com/perlancar/perl-Text-Table-TinyBorderStyle>."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "L<Text::Table::Tiny> and other variants like L<Text::Table::TinyColor>,"
NSQ_SOURCE_LINE 00000299 "L<Text::Table::TinyWide>, L<Text::Table::TinyColorWide>."
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "L<BorderStyle> and C<BorderStyle::*> modules, e.g."
NSQ_SOURCE_LINE 00000302 "L<BorderStyle::ASCII::SingleLine> or L<BorderStyle::UTF8::DoubleLine>."
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "L<Text::Table::Any>"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "L<Text::ANSITable> which also supports border styles as well as color themes"
NSQ_SOURCE_LINE 00000307 "(including coloring the borders), aligning wide/colored text, and other"
NSQ_SOURCE_LINE 00000308 "features, but with larger footprint and slower rendering speed."
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "perlancar <perlancar@cpan.org>"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=head1 CONTRIBUTING"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "To contribute, you can send patches by email/via RT, or send pull requests on"
NSQ_SOURCE_LINE 00000318 "GitHub."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "Most of the time, you don't need to build the distribution yourself. You can"
NSQ_SOURCE_LINE 00000321 "simply modify the code, then test via:"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 " % prove -l"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "If you want to build the distribution (e.g. to try to install it locally on your"
NSQ_SOURCE_LINE 00000326 "system), you can install L<Dist::Zilla>,"
NSQ_SOURCE_LINE 00000327 "L<Dist::Zilla::PluginBundle::Author::PERLANCAR>, and sometimes one or two other"
