NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "############   END OF DOCS   ############"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "############################################################################"
NSQ_SOURCE_LINE 00000496 "############################################################################"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "############ BEGIN OLD STUFF ############"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "# We can't have \"use integer;\", or else (5 <=> 5.1) comes out \"0\" !"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "#-----------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000503 "sub nsort {"
NSQ_SOURCE_LINE 00000504 "  my($cmp, $lc);"
NSQ_SOURCE_LINE 00000505 "  return @_ if @_ < 2;   # Just to be CLEVER."
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "  my($x, $i);  # scratch vars"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "  # And now, the GREAT BIG Schwartzian transform:"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "  map"
NSQ_SOURCE_LINE 00000512 "    $_->[0],"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "  sort {"
NSQ_SOURCE_LINE 00000515 "    # Uses $i as the index variable, $x as the result."
NSQ_SOURCE_LINE 00000516 "    $x = 0;"
NSQ_SOURCE_LINE 00000517 "    $i = 1;"
NSQ_SOURCE_LINE 00000518 "    DEBUG and print \"\\nComparing \", map(\"{$_}\", @$a),"
NSQ_SOURCE_LINE 00000519 "                 ' : ', map(\"{$_}\", @$b), , \"...\\n\";"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "    while($i < @$a and $i < @$b) {"
NSQ_SOURCE_LINE 00000522 "      DEBUG and print \"  comparing $i: {$a->[$i]} cmp {$b->[$i]} => \","
NSQ_SOURCE_LINE 00000523 "        $a->[$i] cmp $b->[$i], \"\\n\";"
NSQ_SOURCE_LINE 00000524 "      last if ($x = ($a->[$i] cmp $b->[$i])); # lexicographic"
NSQ_SOURCE_LINE 00000525 "      ++$i;"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "      DEBUG and print \"  comparing $i: {$a->[$i]} <=> {$b->[$i]} => \","
NSQ_SOURCE_LINE 00000528 "        $a->[$i] <=> $b->[$i], \"\\n\";"
NSQ_SOURCE_LINE 00000529 "      last if ($x = ($a->[$i] <=> $b->[$i])); # numeric"
NSQ_SOURCE_LINE 00000530 "      ++$i;"
NSQ_SOURCE_LINE 00000531 "    }"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "    DEBUG and print \"{$a->[0]} : {$b->[0]} is \","
NSQ_SOURCE_LINE 00000534 "      $x || (@$a <=> @$b) || 0"
NSQ_SOURCE_LINE 00000535 "      ,\"\\n\""
NSQ_SOURCE_LINE 00000536 "    ;"
NSQ_SOURCE_LINE 00000537 "    $x || (@$a <=> @$b) || ($a->[0] cmp $b->[0]);"
NSQ_SOURCE_LINE 00000538 "      # unless we found a result for $x in the while loop,"
NSQ_SOURCE_LINE 00000539 "      #  use length as a tiebreaker, otherwise use cmp"
NSQ_SOURCE_LINE 00000540 "      #  on the original string as a fallback tiebreaker."
NSQ_SOURCE_LINE 00000541 "  }"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "  map {"
NSQ_SOURCE_LINE 00000544 "    my @bit = ($x = defined($_) ? $_ : '');"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "    if($x =~ m/^[+-]?(?=\\d|\\.\\d)\\d*(?:\\.\\d*)?(?:[Ee](?:[+-]?\\d+))?\\z/s) {"
NSQ_SOURCE_LINE 00000547 "      # It's entirely purely numeric, so treat it specially:"
NSQ_SOURCE_LINE 00000548 "      push @bit, '', $x;"
NSQ_SOURCE_LINE 00000549 "    } else {"
NSQ_SOURCE_LINE 00000550 "      # Consume the string."
NSQ_SOURCE_LINE 00000551 "      while(length $x) {"
NSQ_SOURCE_LINE 00000552 "        push @bit, ($x =~ s/^(\\D+)//s) ? lc($1) : '';"
NSQ_SOURCE_LINE 00000553 "        push @bit, ($x =~ s/^(\\d+)//s) ?    $1  :  0;"
NSQ_SOURCE_LINE 00000554 "      }"
NSQ_SOURCE_LINE 00000555 "    }"
NSQ_SOURCE_LINE 00000556 "    DEBUG and print \"$bit[0] => \", map(\"{$_} \", @bit), \"\\n\";"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "    # End result: [original bit         , (text, number), (text, number), ...]"
NSQ_SOURCE_LINE 00000559 "    # Minimally:  [0-length original bit,]"
NSQ_SOURCE_LINE 00000560 "    # Examples:"
NSQ_SOURCE_LINE 00000561 "    #    ['10'         => ''   ,  10,              ]"
NSQ_SOURCE_LINE 00000562 "    #    ['fo900'      => 'fo' , 900,              ]"
NSQ_SOURCE_LINE 00000563 "    #    ['foo10'      => 'foo',  10,              ]"
NSQ_SOURCE_LINE 00000564 "    #    ['foo9.pl'    => 'foo',   9,   , '.pl', 0 ]"
NSQ_SOURCE_LINE 00000565 "    #    ['foo32.pl'   => 'foo',  32,   , '.pl', 0 ]"
NSQ_SOURCE_LINE 00000566 "    #    ['foo325.pl'  => 'foo', 325,   , '.pl', 0 ]"
NSQ_SOURCE_LINE 00000567 "    #  Yes, always an ODD number of elements."
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "    \\@bit;"
NSQ_SOURCE_LINE 00000570 "  }"
NSQ_SOURCE_LINE 00000571 "  @_;"
NSQ_SOURCE_LINE 00000572 "}"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "#-----------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000575 "# Same as before, except without the pure-number trap."
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "sub nsorts {"
NSQ_SOURCE_LINE 00000578 "  return @_ if @_ < 2;   # Just to be CLEVER."
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "  my($x, $i);  # scratch vars"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "  # And now, the GREAT BIG Schwartzian transform:"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "  map"
NSQ_SOURCE_LINE 00000585 "    $_->[0],"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "  sort {"
NSQ_SOURCE_LINE 00000588 "    # Uses $i as the index variable, $x as the result."
NSQ_SOURCE_LINE 00000589 "    $x = 0;"
NSQ_SOURCE_LINE 00000590 "    $i = 1;"
NSQ_SOURCE_LINE 00000591 "    DEBUG and print \"\\nComparing \", map(\"{$_}\", @$a),"
NSQ_SOURCE_LINE 00000592 "                 ' : ', map(\"{$_}\", @$b), , \"...\\n\";"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "    while($i < @$a and $i < @$b) {"
NSQ_SOURCE_LINE 00000595 "      DEBUG and print \"  comparing $i: {$a->[$i]} cmp {$b->[$i]} => \","
NSQ_SOURCE_LINE 00000596 "        $a->[$i] cmp $b->[$i], \"\\n\";"
NSQ_SOURCE_LINE 00000597 "      last if ($x = ($a->[$i] cmp $b->[$i])); # lexicographic"
NSQ_SOURCE_LINE 00000598 "      ++$i;"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "      DEBUG and print \"  comparing $i: {$a->[$i]} <=> {$b->[$i]} => \","
NSQ_SOURCE_LINE 00000601 "        $a->[$i] <=> $b->[$i], \"\\n\";"
NSQ_SOURCE_LINE 00000602 "      last if ($x = ($a->[$i] <=> $b->[$i])); # numeric"
NSQ_SOURCE_LINE 00000603 "      ++$i;"
NSQ_SOURCE_LINE 00000604 "    }"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "    DEBUG and print \"{$a->[0]} : {$b->[0]} is \","
NSQ_SOURCE_LINE 00000607 "      $x || (@$a <=> @$b) || 0"
NSQ_SOURCE_LINE 00000608 "      ,\"\\n\""
NSQ_SOURCE_LINE 00000609 "    ;"
NSQ_SOURCE_LINE 00000610 "    $x || (@$a <=> @$b) || ($a->[0] cmp $b->[0]);"
NSQ_SOURCE_LINE 00000611 "      # unless we found a result for $x in the while loop,"
NSQ_SOURCE_LINE 00000612 "      #  use length as a tiebreaker, otherwise use cmp"
NSQ_SOURCE_LINE 00000613 "      #  on the original string as a fallback tiebreaker."
NSQ_SOURCE_LINE 00000614 "  }"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "  map {"
NSQ_SOURCE_LINE 00000617 "    my @bit = ($x = defined($_) ? $_ : '');"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "    while(length $x) {"
NSQ_SOURCE_LINE 00000620 "      push @bit, ($x =~ s/^(\\D+)//s) ? lc($1) : '';"
NSQ_SOURCE_LINE 00000621 "      push @bit, ($x =~ s/^(\\d+)//s) ?    $1  :  0;"
NSQ_SOURCE_LINE 00000622 "    }"
NSQ_SOURCE_LINE 00000623 "    DEBUG and print \"$bit[0] => \", map(\"{$_} \", @bit), \"\\n\";"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "    # End result: [original bit         , (text, number), (text, number), ...]"
NSQ_SOURCE_LINE 00000626 "    # Minimally:  [0-length original bit,]"
NSQ_SOURCE_LINE 00000627 "    # Examples:"
NSQ_SOURCE_LINE 00000628 "    #    ['10'         => ''   ,  10,              ]"
NSQ_SOURCE_LINE 00000629 "    #    ['fo900'      => 'fo' , 900,              ]"
NSQ_SOURCE_LINE 00000630 "    #    ['foo10'      => 'foo',  10,              ]"
NSQ_SOURCE_LINE 00000631 "    #    ['foo9.pl'    => 'foo',   9,   , '.pl', 0 ]"
NSQ_SOURCE_LINE 00000632 "    #    ['foo32.pl'   => 'foo',  32,   , '.pl', 0 ]"
NSQ_SOURCE_LINE 00000633 "    #    ['foo325.pl'  => 'foo', 325,   , '.pl', 0 ]"
NSQ_SOURCE_LINE 00000634 "    #  Yes, always an ODD number of elements."
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "    \\@bit;"
NSQ_SOURCE_LINE 00000637 "  }"
NSQ_SOURCE_LINE 00000638 "  @_;"
NSQ_SOURCE_LINE 00000639 "}"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "#-----------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000642 "# Same as before, except for the sort-key-making"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "sub nsort0 {"
NSQ_SOURCE_LINE 00000645 "  return @_ if @_ < 2;   # Just to be CLEVER."
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "  my($x, $i);  # scratch vars"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "  # And now, the GREAT BIG Schwartzian transform:"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "  map"
NSQ_SOURCE_LINE 00000652 "    $_->[0],"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "  sort {"
NSQ_SOURCE_LINE 00000655 "    # Uses $i as the index variable, $x as the result."
NSQ_SOURCE_LINE 00000656 "    $x = 0;"
NSQ_SOURCE_LINE 00000657 "    $i = 1;"
NSQ_SOURCE_LINE 00000658 "    DEBUG and print \"\\nComparing \", map(\"{$_}\", @$a),"
NSQ_SOURCE_LINE 00000659 "                 ' : ', map(\"{$_}\", @$b), , \"...\\n\";"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "    while($i < @$a and $i < @$b) {"
NSQ_SOURCE_LINE 00000662 "      DEBUG and print \"  comparing $i: {$a->[$i]} cmp {$b->[$i]} => \","
NSQ_SOURCE_LINE 00000663 "        $a->[$i] cmp $b->[$i], \"\\n\";"
NSQ_SOURCE_LINE 00000664 "      last if ($x = ($a->[$i] cmp $b->[$i])); # lexicographic"
NSQ_SOURCE_LINE 00000665 "      ++$i;"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "      DEBUG and print \"  comparing $i: {$a->[$i]} <=> {$b->[$i]} => \","
NSQ_SOURCE_LINE 00000668 "        $a->[$i] <=> $b->[$i], \"\\n\";"
NSQ_SOURCE_LINE 00000669 "      last if ($x = ($a->[$i] <=> $b->[$i])); # numeric"
NSQ_SOURCE_LINE 00000670 "      ++$i;"
NSQ_SOURCE_LINE 00000671 "    }"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "    DEBUG and print \"{$a->[0]} : {$b->[0]} is \","
NSQ_SOURCE_LINE 00000674 "      $x || (@$a <=> @$b) || 0"
NSQ_SOURCE_LINE 00000675 "      ,\"\\n\""
NSQ_SOURCE_LINE 00000676 "    ;"
NSQ_SOURCE_LINE 00000677 "    $x || (@$a <=> @$b) || ($a->[0] cmp $b->[0]);"
NSQ_SOURCE_LINE 00000678 "      # unless we found a result for $x in the while loop,"
NSQ_SOURCE_LINE 00000679 "      #  use length as a tiebreaker, otherwise use cmp"
NSQ_SOURCE_LINE 00000680 "      #  on the original string as a fallback tiebreaker."
NSQ_SOURCE_LINE 00000681 "  }"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "  map {"
NSQ_SOURCE_LINE 00000684 "    my @bit = ($x = defined($_) ? $_ : '');"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "    if($x =~ m/^[+-]?(?=\\d|\\.\\d)\\d*(?:\\.\\d*)?(?:[Ee](?:[+-]?\\d+))?\\z/s) {"
NSQ_SOURCE_LINE 00000687 "      # It's entirely purely numeric, so treat it specially:"
NSQ_SOURCE_LINE 00000688 "      push @bit, '', $x;"
NSQ_SOURCE_LINE 00000689 "    } else {"
NSQ_SOURCE_LINE 00000690 "      # Consume the string."
NSQ_SOURCE_LINE 00000691 "      while(length $x) {"
NSQ_SOURCE_LINE 00000692 "        push @bit, ($x =~ s/^(\\D+)//s) ? lc($1) : '';"
NSQ_SOURCE_LINE 00000693 "        # Secret sauce:"
NSQ_SOURCE_LINE 00000694 "        if($x =~ s/^(\\d+)//s) {"
NSQ_SOURCE_LINE 00000695 "          if(substr($1,0,1) eq '0' and $1 != 0) {"
NSQ_SOURCE_LINE 00000696 "            push @bit, $1 / (10 ** length($1));"
NSQ_SOURCE_LINE 00000697 "          } else {"
NSQ_SOURCE_LINE 00000698 "            push @bit, $1;"
NSQ_SOURCE_LINE 00000699 "          }"
NSQ_SOURCE_LINE 00000700 "        } else {"
NSQ_SOURCE_LINE 00000701 "          push @bit, 0;"
NSQ_SOURCE_LINE 00000702 "        }"
NSQ_SOURCE_LINE 00000703 "      }"
NSQ_SOURCE_LINE 00000704 "    }"
NSQ_SOURCE_LINE 00000705 "    DEBUG and print \"$bit[0] => \", map(\"{$_} \", @bit), \"\\n\";"
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "    \\@bit;"
NSQ_SOURCE_LINE 00000708 "  }"
NSQ_SOURCE_LINE 00000709 "  @_;"
NSQ_SOURCE_LINE 00000710 "}"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "#-----------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000713 "# Like nsort0, but WITHOUT pure number handling, and WITH special treatment"
NSQ_SOURCE_LINE 00000714 "# of pulling off extensions and version numbers."
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "sub nsortf {"
NSQ_SOURCE_LINE 00000717 "  return @_ if @_ < 2;   # Just to be CLEVER."
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "  my($x, $i);  # scratch vars"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "  # And now, the GREAT BIG Schwartzian transform:"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "  map"
NSQ_SOURCE_LINE 00000724 "    $_->[0],"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "  sort {"
NSQ_SOURCE_LINE 00000727 "    # Uses $i as the index variable, $x as the result."
NSQ_SOURCE_LINE 00000728 "    $x = 0;"
NSQ_SOURCE_LINE 00000729 "    $i = 3;"
NSQ_SOURCE_LINE 00000730 "    DEBUG and print \"\\nComparing \", map(\"{$_}\", @$a),"
NSQ_SOURCE_LINE 00000731 "                 ' : ', map(\"{$_}\", @$b), , \"...\\n\";"
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "    while($i < @$a and $i < @$b) {"
NSQ_SOURCE_LINE 00000734 "      DEBUG and print \"  comparing $i: {$a->[$i]} cmp {$b->[$i]} => \","
NSQ_SOURCE_LINE 00000735 "        $a->[$i] cmp $b->[$i], \"\\n\";"
NSQ_SOURCE_LINE 00000736 "      last if ($x = ($a->[$i] cmp $b->[$i])); # lexicographic"
NSQ_SOURCE_LINE 00000737 "      ++$i;"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "      DEBUG and print \"  comparing $i: {$a->[$i]} <=> {$b->[$i]} => \","
NSQ_SOURCE_LINE 00000740 "        $a->[$i] <=> $b->[$i], \"\\n\";"
NSQ_SOURCE_LINE 00000741 "      last if ($x = ($a->[$i] <=> $b->[$i])); # numeric"
NSQ_SOURCE_LINE 00000742 "      ++$i;"
NSQ_SOURCE_LINE 00000743 "    }"
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "    DEBUG and print \"{$a->[0]} : {$b->[0]} is \","
NSQ_SOURCE_LINE 00000746 "      $x || (@$a <=> @$b) || 0"
NSQ_SOURCE_LINE 00000747 "      ,\"\\n\""
NSQ_SOURCE_LINE 00000748 "    ;"
NSQ_SOURCE_LINE 00000749 "    $x || (@$a     <=> @$b    ) || ($a->[1] cmp $b->[1])"
NSQ_SOURCE_LINE 00000750 "       || ($a->[2] <=> $b->[2]) || ($a->[0] cmp $b->[0]);"
NSQ_SOURCE_LINE 00000751 "      # unless we found a result for $x in the while loop,"
NSQ_SOURCE_LINE 00000752 "      #  use length as a tiebreaker, otherwise use the"
NSQ_SOURCE_LINE 00000753 "      #  lc'd extension, otherwise the verison, otherwise use"
NSQ_SOURCE_LINE 00000754 "      #  the original string as a fallback tiebreaker."
NSQ_SOURCE_LINE 00000755 "  }"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "  map {"
NSQ_SOURCE_LINE 00000758 "    my @bit = ( ($x = defined($_) ? $_ : ''), '',0 );"
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "    {"
NSQ_SOURCE_LINE 00000761 "      # Consume the string."
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "      # First, pull off any VAX-style version"
NSQ_SOURCE_LINE 00000764 "      $bit[2] = $1 if $x =~ s/;(\\d+)$//;"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "      # Then pull off any apparent extension"
NSQ_SOURCE_LINE 00000767 "      if( $x !~ m/^\\.+$/s and     # don't mangle \".\", \"..\", or \"...\""
NSQ_SOURCE_LINE 00000768 "          $x =~ s/(\\.[^\\.\\;]*)$//sg"
NSQ_SOURCE_LINE 00000769 "          # We could try to avoid catching all-digit extensions,"
NSQ_SOURCE_LINE 00000770 "          #  but I think that's getting /too/ clever."
NSQ_SOURCE_LINE 00000771 "      ) {"
NSQ_SOURCE_LINE 00000772 "        $i = $1;"
NSQ_SOURCE_LINE 00000773 "        if($x =~ m<[^\\\\\\://]$>s) {"
NSQ_SOURCE_LINE 00000774 "          # We didn't take the whole basename."
NSQ_SOURCE_LINE 00000775 "          $bit[1] = lc $i;"
NSQ_SOURCE_LINE 00000776 "          DEBUG and print \"Consuming extension \\\"$1\\\"\\n\";"
NSQ_SOURCE_LINE 00000777 "        } else {"
NSQ_SOURCE_LINE 00000778 "          # We DID take the whole basename.  Fix it."
NSQ_SOURCE_LINE 00000779 "          $x = $1;  # Repair it."
NSQ_SOURCE_LINE 00000780 "        }"
NSQ_SOURCE_LINE 00000781 "      }"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "      push @bit, '', -1   if $x =~ m/^\\./s;"
NSQ_SOURCE_LINE 00000784 "       # A hack to make .-initial filenames sort first, regardless of locale."
NSQ_SOURCE_LINE 00000785 "       # And -1 is always a sort-firster, since in the code below, there's"
NSQ_SOURCE_LINE 00000786 "       # no allowance for filenames containing negative numbers: -1.dat"
NSQ_SOURCE_LINE 00000787 "       # will be read as string '-' followed by number 1."
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "      while(length $x) {"
NSQ_SOURCE_LINE 00000790 "        push @bit, ($x =~ s/^(\\D+)//s) ? lc($1) : '';"
NSQ_SOURCE_LINE 00000791 "        # Secret sauce:"
NSQ_SOURCE_LINE 00000792 "        if($x =~ s/^(\\d+)//s) {"
NSQ_SOURCE_LINE 00000793 "          if(substr($1,0,1) eq '0' and $1 != 0) {"
NSQ_SOURCE_LINE 00000794 "            push @bit, $1 / (10 ** length($1));"
NSQ_SOURCE_LINE 00000795 "          } else {"
NSQ_SOURCE_LINE 00000796 "            push @bit, $1;"
NSQ_SOURCE_LINE 00000797 "          }"
NSQ_SOURCE_LINE 00000798 "        } else {"
NSQ_SOURCE_LINE 00000799 "          push @bit, 0;"
NSQ_SOURCE_LINE 00000800 "        }"
NSQ_SOURCE_LINE 00000801 "      }"
NSQ_SOURCE_LINE 00000802 "    }"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "    DEBUG and print \"$bit[0] => \", map(\"{$_} \", @bit), \"\\n\";"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "    \\@bit;"
NSQ_SOURCE_LINE 00000807 "  }"
NSQ_SOURCE_LINE 00000808 "  @_;"
NSQ_SOURCE_LINE 00000809 "}"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "# yowza yowza yowza."
NSQ_SOURCE_LINE 00000812 ""
BODY_END
