BODY_BEGIN
NSQ_SOURCE_LINE 00000001 ""
NSQ_SOURCE_LINE 00000002 "require 5;"
NSQ_SOURCE_LINE 00000003 "package Sort::Naturally;  # Time-stamp: \"2004-12-29 18:30:03 AST\""
NSQ_SOURCE_LINE 00000004 "$VERSION = '1.03';"
NSQ_SOURCE_LINE 00000005 "@EXPORT = ('nsort', 'ncmp');"
NSQ_SOURCE_LINE 00000006 "require Exporter;"
NSQ_SOURCE_LINE 00000007 "@ISA = ('Exporter');"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use locale;"
NSQ_SOURCE_LINE 00000011 "use integer;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "#-----------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000014 "# constants:"
NSQ_SOURCE_LINE 00000015 "BEGIN { *DEBUG = sub () {0} unless defined &DEBUG }"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "use Config ();"
NSQ_SOURCE_LINE 00000018 "BEGIN {"
NSQ_SOURCE_LINE 00000019 "  # Make a constant such that if a whole-number string is that long"
NSQ_SOURCE_LINE 00000020 "  #  or shorter, we KNOW it's treatable as an integer"
NSQ_SOURCE_LINE 00000021 "  no integer;"
NSQ_SOURCE_LINE 00000022 "  my $x = length(256 ** $Config::Config{'intsize'} / 2) - 1;"
NSQ_SOURCE_LINE 00000023 "  die \"Crazy intsize: <$Config::Config{'intsize'}>\" if $x < 4;"
NSQ_SOURCE_LINE 00000024 "  eval 'sub MAX_INT_SIZE () {' . $x . '}';"
NSQ_SOURCE_LINE 00000025 "  die $@ if $@;"
NSQ_SOURCE_LINE 00000026 "  print \"intsize $Config::Config{'intsize'} => MAX_INT_SIZE $x\\n\" if DEBUG;"
NSQ_SOURCE_LINE 00000027 "}"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub X_FIRST () {-1}"
NSQ_SOURCE_LINE 00000030 "sub Y_FIRST () { 1}"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "my @ORD = ('same', 'swap', 'asis');"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "#-----------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000035 "# For lack of a preprocessor:"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "my($code, $guts);"
NSQ_SOURCE_LINE 00000038 "$guts = <<'EOGUTS';  # This is the guts of both ncmp and nsort:"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    if($x eq $y) {"
NSQ_SOURCE_LINE 00000041 "      # trap this expensive case first, and then fall thru to tiebreaker"
NSQ_SOURCE_LINE 00000042 "      $rv = 0;"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "    # Convoluted hack to get numerics to sort first, at string start:"
NSQ_SOURCE_LINE 00000045 "    } elsif($x =~ m/^\\d/s) {"
NSQ_SOURCE_LINE 00000046 "      if($y =~ m/^\\d/s) {"
NSQ_SOURCE_LINE 00000047 "        $rv = 0;    # fall thru to normal comparison for the two numbers"
NSQ_SOURCE_LINE 00000048 "      } else {"
NSQ_SOURCE_LINE 00000049 "        $rv = X_FIRST;"
NSQ_SOURCE_LINE 00000050 "        DEBUG > 1 and print \"Numeric-initial $x trumps letter-initial $y\\n\";"
NSQ_SOURCE_LINE 00000051 "      }"
NSQ_SOURCE_LINE 00000052 "    } elsif($y =~ m/^\\d/s) {"
NSQ_SOURCE_LINE 00000053 "      $rv = Y_FIRST;"
NSQ_SOURCE_LINE 00000054 "      DEBUG > 1 and print \"Numeric-initial $y trumps letter-initial $x\\n\";"
NSQ_SOURCE_LINE 00000055 "    } else {"
NSQ_SOURCE_LINE 00000056 "      $rv = 0;"
NSQ_SOURCE_LINE 00000057 "    }"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    unless($rv) {"
NSQ_SOURCE_LINE 00000060 "      # Normal case:"
NSQ_SOURCE_LINE 00000061 "      $rv = 0;"
NSQ_SOURCE_LINE 00000062 "      DEBUG and print \"<$x> and <$y> compared...\\n\";"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "     Consideration:"
NSQ_SOURCE_LINE 00000065 "      while(length $x and length $y) {"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "        DEBUG > 2 and print \" <$x> and <$y>...\\n\";"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "        # First, non-numeric comparison:"
NSQ_SOURCE_LINE 00000070 "        $x2 = ($x =~ m/^(\\D+)/s) ? length($1) : 0;"
NSQ_SOURCE_LINE 00000071 "        $y2 = ($y =~ m/^(\\D+)/s) ? length($1) : 0;"
NSQ_SOURCE_LINE 00000072 "        # Now make x2 the min length of the two:"
NSQ_SOURCE_LINE 00000073 "        $x2 = $y2 if $x2 > $y2;"
NSQ_SOURCE_LINE 00000074 "        if($x2) {"
NSQ_SOURCE_LINE 00000075 "          DEBUG > 1 and printf \" <%s> and <%s> lexically for length $x2...\\n\","
NSQ_SOURCE_LINE 00000076 "            substr($x,0,$x2), substr($y,0,$x2);"
NSQ_SOURCE_LINE 00000077 "          do {"
NSQ_SOURCE_LINE 00000078 "           my $i = substr($x,0,$x2);"
NSQ_SOURCE_LINE 00000079 "           my $j = substr($y,0,$x2);"
NSQ_SOURCE_LINE 00000080 "           my $sv = $i cmp $j;"
NSQ_SOURCE_LINE 00000081 "           print \"SCREAM! on <$i><$j> -- $sv != $rv \\n\" unless $rv == $sv;"
NSQ_SOURCE_LINE 00000082 "           last;"
NSQ_SOURCE_LINE 00000083 "          }"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "           if $rv ="
NSQ_SOURCE_LINE 00000087 "           # The ''. things here force a copy that seems to work around a"
NSQ_SOURCE_LINE 00000088 "           #  mysterious intermittent bug that 'use locale' provokes in"
NSQ_SOURCE_LINE 00000089 "           #  many versions of Perl."
NSQ_SOURCE_LINE 00000090 "                   $cmp"
NSQ_SOURCE_LINE 00000091 "                   ? $cmp->(substr($x,0,$x2) . '',"
NSQ_SOURCE_LINE 00000092 "                            substr($y,0,$x2) . '',"
NSQ_SOURCE_LINE 00000093 "                           )"
NSQ_SOURCE_LINE 00000094 "                   :"
NSQ_SOURCE_LINE 00000095 "                   scalar(( substr($x,0,$x2) . '' ) cmp"
NSQ_SOURCE_LINE 00000096 "                          ( substr($y,0,$x2) . '' )"
NSQ_SOURCE_LINE 00000097 "                          )"
NSQ_SOURCE_LINE 00000098 "          ;"
NSQ_SOURCE_LINE 00000099 "          # otherwise trim and keep going:"
NSQ_SOURCE_LINE 00000100 "          substr($x,0,$x2) = '';"
NSQ_SOURCE_LINE 00000101 "          substr($y,0,$x2) = '';"
NSQ_SOURCE_LINE 00000102 "        }"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "        # Now numeric:"
NSQ_SOURCE_LINE 00000105 "        #  (actually just using $x2 and $y2 as scratch)"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "        if( $x =~ s/^(\\d+)//s ) {"
NSQ_SOURCE_LINE 00000108 "          $x2 = $1;"
NSQ_SOURCE_LINE 00000109 "          if( $y =~ s/^(\\d+)//s ) {"
NSQ_SOURCE_LINE 00000110 "            # We have two numbers here."
NSQ_SOURCE_LINE 00000111 "            DEBUG > 1 and print \" <$x2> and <$1> numerically\\n\";"
NSQ_SOURCE_LINE 00000112 "            if(length($x2) < MAX_INT_SIZE and length($1) < MAX_INT_SIZE) {"
NSQ_SOURCE_LINE 00000113 "              # small numbers: we can compare happily"
NSQ_SOURCE_LINE 00000114 "              last if $rv = $x2 <=> $1;"
NSQ_SOURCE_LINE 00000115 "            } else {"
NSQ_SOURCE_LINE 00000116 "              # ARBITRARILY large integers!"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "              # This saves on loss of precision that could happen"
NSQ_SOURCE_LINE 00000119 "              #  with actual stringification."
NSQ_SOURCE_LINE 00000120 "              # Also, I sense that very large numbers aren't too"
NSQ_SOURCE_LINE 00000121 "              #  terribly common in sort data."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "              # trim leading 0's:"
NSQ_SOURCE_LINE 00000124 "              ($y2 = $1) =~ s/^0+//s;"
NSQ_SOURCE_LINE 00000125 "              $x2 =~ s/^0+//s;"
NSQ_SOURCE_LINE 00000126 "              print \"   Treating $x2 and $y2 as bigint\\n\" if DEBUG;"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "              no locale; # we want the dumb cmp back."
NSQ_SOURCE_LINE 00000129 "              last if $rv = ("
NSQ_SOURCE_LINE 00000130 "                 # works only for non-negative whole numbers:"
NSQ_SOURCE_LINE 00000131 "                 length($x2) <=> length($y2)"
NSQ_SOURCE_LINE 00000132 "                   # the longer the numeral, the larger the value"
NSQ_SOURCE_LINE 00000133 "                 or $x2 cmp $y2"
NSQ_SOURCE_LINE 00000134 "                   # between equals, compare lexically!!  amazing but true."
NSQ_SOURCE_LINE 00000135 "              );"
NSQ_SOURCE_LINE 00000136 "            }"
NSQ_SOURCE_LINE 00000137 "          } else {"
NSQ_SOURCE_LINE 00000138 "            # X is numeric but Y isn't"
NSQ_SOURCE_LINE 00000139 "            $rv = Y_FIRST;"
NSQ_SOURCE_LINE 00000140 "            last;"
NSQ_SOURCE_LINE 00000141 "          }"
NSQ_SOURCE_LINE 00000142 "        } elsif( $y =~ s/^\\d+//s ) {  # we don't need to capture the substring"
NSQ_SOURCE_LINE 00000143 "          $rv = X_FIRST;"
NSQ_SOURCE_LINE 00000144 "          last;"
NSQ_SOURCE_LINE 00000145 "        }"
NSQ_SOURCE_LINE 00000146 "         # else one of them is 0-length."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "       # end-while"
NSQ_SOURCE_LINE 00000149 "      }"
NSQ_SOURCE_LINE 00000150 "    }"
NSQ_SOURCE_LINE 00000151 "EOGUTS"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "sub maker {"
NSQ_SOURCE_LINE 00000154 "  my $code = $_[0];"
NSQ_SOURCE_LINE 00000155 "  $code =~ s/~COMPARATOR~/$guts/g || die \"Can't find ~COMPARATOR~\";"
NSQ_SOURCE_LINE 00000156 "  eval $code;"
NSQ_SOURCE_LINE 00000157 "  die $@ if $@;"
NSQ_SOURCE_LINE 00000158 "}"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "##############################################################################"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "maker(<<'EONSORT');"
NSQ_SOURCE_LINE 00000163 "sub nsort {"
NSQ_SOURCE_LINE 00000164 "  # get options:"
NSQ_SOURCE_LINE 00000165 "  my($cmp, $lc);"
NSQ_SOURCE_LINE 00000166 "  ($cmp,$lc) = @{shift @_} if @_ and ref($_[0]) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "  return @_ unless @_ > 1 or wantarray; # be clever"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "  my($x, $x2, $y, $y2, $rv);  # scratch vars"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "  # We use a Schwartzian xform to memoize the lc'ing and \\W-removal"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "  map $_->[0],"
NSQ_SOURCE_LINE 00000175 "  sort {"
NSQ_SOURCE_LINE 00000176 "    if($a->[0] eq $b->[0]) { 0 }   # trap this expensive case"
NSQ_SOURCE_LINE 00000177 "    else {"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    $x = $a->[1];"
NSQ_SOURCE_LINE 00000180 "    $y = $b->[1];"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "~COMPARATOR~"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "    # Tiebreakers..."
NSQ_SOURCE_LINE 00000185 "    DEBUG > 1 and print \" -<${$a}[0]> cmp <${$b}[0]> is $rv ($ORD[$rv])\\n\";"
NSQ_SOURCE_LINE 00000186 "    $rv ||= (length($x) <=> length($y))  # shorter is always first"
NSQ_SOURCE_LINE 00000187 "        ||  ($cmp and $cmp->($x,$y) || $cmp->($a->[0], $b->[0]))"
NSQ_SOURCE_LINE 00000188 "        ||  ($x      cmp $y     )"
NSQ_SOURCE_LINE 00000189 "        ||  ($a->[0] cmp $b->[0])"
NSQ_SOURCE_LINE 00000190 "    ;"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "    DEBUG > 1 and print \"  <${$a}[0]> cmp <${$b}[0]> is $rv ($ORD[$rv])\\n\";"
NSQ_SOURCE_LINE 00000193 "    $rv;"
NSQ_SOURCE_LINE 00000194 "  }}"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "  map {;"
NSQ_SOURCE_LINE 00000197 "    $x = $lc ? $lc->($_) : lc($_); # x as scratch"
NSQ_SOURCE_LINE 00000198 "    $x =~ s/\\W+//s;"
NSQ_SOURCE_LINE 00000199 "    [$_, $x];"
NSQ_SOURCE_LINE 00000200 "  }"
NSQ_SOURCE_LINE 00000201 "  @_"
NSQ_SOURCE_LINE 00000202 "}"
NSQ_SOURCE_LINE 00000203 "EONSORT"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "#-----------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000206 "maker(<<'EONCMP');"
NSQ_SOURCE_LINE 00000207 "sub ncmp {"
NSQ_SOURCE_LINE 00000208 "  # The guts are basically the same as above..."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "  # get options:"
NSQ_SOURCE_LINE 00000211 "  my($cmp, $lc);"
NSQ_SOURCE_LINE 00000212 "  ($cmp,$lc) = @{shift @_} if @_ and ref($_[0]) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "  if(@_ == 0) {"
NSQ_SOURCE_LINE 00000215 "    @_ = ($a, $b); # bit of a hack!"
NSQ_SOURCE_LINE 00000216 "    DEBUG > 1 and print \"Hacking in <$a><$b>\\n\";"
NSQ_SOURCE_LINE 00000217 "  } elsif(@_ != 2) {"
NSQ_SOURCE_LINE 00000218 "    require Carp;"
NSQ_SOURCE_LINE 00000219 "    Carp::croak(\"Not enough options to ncmp!\");"
NSQ_SOURCE_LINE 00000220 "  }"
NSQ_SOURCE_LINE 00000221 "  my($a,$b) = @_;"
NSQ_SOURCE_LINE 00000222 "  my($x, $x2, $y, $y2, $rv);  # scratch vars"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "  DEBUG > 1 and print \"ncmp args <$a><$b>\\n\";"
NSQ_SOURCE_LINE 00000225 "  if($a eq $b) { # trap this expensive case"
NSQ_SOURCE_LINE 00000226 "    0;"
NSQ_SOURCE_LINE 00000227 "  } else {"
NSQ_SOURCE_LINE 00000228 "    $x = ($lc ? $lc->($a) : lc($a));"
NSQ_SOURCE_LINE 00000229 "    $x =~ s/\\W+//s;"
NSQ_SOURCE_LINE 00000230 "    $y = ($lc ? $lc->($b) : lc($b));"
NSQ_SOURCE_LINE 00000231 "    $y =~ s/\\W+//s;"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "~COMPARATOR~"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "    # Tiebreakers..."
NSQ_SOURCE_LINE 00000237 "    DEBUG > 1 and print \" -<$a> cmp <$b> is $rv ($ORD[$rv])\\n\";"
NSQ_SOURCE_LINE 00000238 "    $rv ||= (length($x) <=> length($y))  # shorter is always first"
NSQ_SOURCE_LINE 00000239 "        ||  ($cmp and $cmp->($x,$y) || $cmp->($a,$b))"
NSQ_SOURCE_LINE 00000240 "        ||  ($x cmp $y)"
NSQ_SOURCE_LINE 00000241 "        ||  ($a cmp $b)"
NSQ_SOURCE_LINE 00000242 "    ;"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "    DEBUG > 1 and print \"  <$a> cmp <$b> is $rv\\n\";"
NSQ_SOURCE_LINE 00000245 "    $rv;"
NSQ_SOURCE_LINE 00000246 "  }"
NSQ_SOURCE_LINE 00000247 "}"
NSQ_SOURCE_LINE 00000248 "EONCMP"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "# clean up:"
NSQ_SOURCE_LINE 00000251 "undef $guts;"
NSQ_SOURCE_LINE 00000252 "undef &maker;"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "#-----------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000255 "1;"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "############### END OF MAIN SOURCE ###########################################"
NSQ_SOURCE_LINE 00000258 "__END__"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=head1 NAME"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "Sort::Naturally -- sort lexically, but sort numeral parts numerically"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "  @them = nsort(qw("
NSQ_SOURCE_LINE 00000267 "   foo12a foo12z foo13a foo 14 9x foo12 fooa foolio Foolio Foo12a"
NSQ_SOURCE_LINE 00000268 "  ));"
NSQ_SOURCE_LINE 00000269 "  print join(' ', @them), \"\\n\";"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Prints:"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "  9x 14 foo fooa foolio Foolio foo12 foo12a Foo12a foo12z foo13a"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "(Or \"foo12a\" + \"Foo12a\" and \"foolio\" + \"Foolio\" and might be"
NSQ_SOURCE_LINE 00000276 "switched, depending on your locale.)"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "This module exports two functions, C<nsort> and C<ncmp>; they are used"
NSQ_SOURCE_LINE 00000281 "in implementing my idea of a \"natural sorting\" algorithm.  Under natural"
NSQ_SOURCE_LINE 00000282 "sorting, numeric substrings are compared numerically, and other"
NSQ_SOURCE_LINE 00000283 "word-characters are compared lexically."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "This is the way I define natural sorting:"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=over"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=item *"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "Non-numeric word-character substrings are sorted lexically,"
NSQ_SOURCE_LINE 00000292 "case-insensitively: \"Foo\" comes between \"fish\" and \"fowl\"."
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=item *"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "Numeric substrings are sorted numerically:"
NSQ_SOURCE_LINE 00000297 "\"100\" comes after \"20\", not before."
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=item *"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "\\W substrings (neither words-characters nor digits) are I<ignored>."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=item *"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "Our use of \\w, \\d, \\D, and \\W is locale-sensitive:  Sort::Naturally"
NSQ_SOURCE_LINE 00000306 "uses a C<use locale> statement."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=item *"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "When comparing two strings, where a numeric substring in one"
NSQ_SOURCE_LINE 00000311 "place is I<not> up against a numeric substring in another,"
NSQ_SOURCE_LINE 00000312 "the non-numeric always comes first.  This is fudged by"
NSQ_SOURCE_LINE 00000313 "reading pretending that the lack of a number substring has"
NSQ_SOURCE_LINE 00000314 "the value -1, like so:"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "  foo       =>  \"foo\",  -1"
NSQ_SOURCE_LINE 00000317 "  foobar    =>  \"foo\",  -1,  \"bar\""
NSQ_SOURCE_LINE 00000318 "  foo13     =>  \"foo\",  13,"
NSQ_SOURCE_LINE 00000319 "  foo13xyz  =>  \"foo\",  13,  \"xyz\""
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "That's so that \"foo\" will come before \"foo13\", which will come"
NSQ_SOURCE_LINE 00000322 "before \"foobar\"."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=item *"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "The start of a string is exceptional: leading non-\\W (non-word,"
NSQ_SOURCE_LINE 00000327 "non-digit)"
NSQ_SOURCE_LINE 00000328 "components are are ignored, and numbers come I<before> letters."
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=item *"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "I define \"numeric substring\" just as sequences matching m/\\d+/ --"
NSQ_SOURCE_LINE 00000333 "scientific notation, commas, decimals, etc., are not seen.  If"
NSQ_SOURCE_LINE 00000334 "your data has thousands separators in numbers"
NSQ_SOURCE_LINE 00000335 "(\"20,000 Leagues Under The Sea\" or \"20.000 lieues sous les mers\"),"
NSQ_SOURCE_LINE 00000336 "consider stripping them before feeding them to C<nsort> or"
NSQ_SOURCE_LINE 00000337 "C<ncmp>."
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "=back"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "=head2 The nsort function"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "This function takes a list of strings, and returns a copy of the list,"
NSQ_SOURCE_LINE 00000344 "sorted."
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "This is what most people will want to use:"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "  @stuff = nsort(...list...);"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "When nsort needs to compare non-numeric substrings, it"
NSQ_SOURCE_LINE 00000351 "uses Perl's C<lc> function in scope of a <use locale>."
NSQ_SOURCE_LINE 00000352 "And when nsort needs to lowercase things, it uses Perl's"
NSQ_SOURCE_LINE 00000353 "C<lc> function in scope of a <use locale>.  If you want nsort"
NSQ_SOURCE_LINE 00000354 "to use other functions instead, you can specify them in"
NSQ_SOURCE_LINE 00000355 "an arrayref as the first argument to nsort:"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "  @stuff = nsort( ["
NSQ_SOURCE_LINE 00000358 "                    \\&string_comparator,   # optional"
NSQ_SOURCE_LINE 00000359 "                    \\&lowercaser_function  # optional"
NSQ_SOURCE_LINE 00000360 "                  ],"
NSQ_SOURCE_LINE 00000361 "                  ...list..."
NSQ_SOURCE_LINE 00000362 "                );"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "If you want to specify a string comparator but no lowercaser,"
NSQ_SOURCE_LINE 00000365 "then the options list is C<[\\&comparator, '']> or"
NSQ_SOURCE_LINE 00000366 "C<[\\&comparator]>.  If you want to specify no string comparator"
NSQ_SOURCE_LINE 00000367 "but a lowercaser, then the options list is"
NSQ_SOURCE_LINE 00000368 "C<['', \\&lowercaser]>."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "Any comparator you specify is called as"
NSQ_SOURCE_LINE 00000371 "C<$comparator-E<gt>($left, $right)>,"
NSQ_SOURCE_LINE 00000372 "and, like a normal Perl C<cmp> replacement, must return"
NSQ_SOURCE_LINE 00000373 "-1, 0, or 1 depending on whether the left argument is stringwise"
NSQ_SOURCE_LINE 00000374 "less than, equal to, or greater than the right argument."
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "Any lowercaser function you specify is called as"
NSQ_SOURCE_LINE 00000377 "C<$lowercased = $lowercaser-E<gt>($original)>.  The routine"
NSQ_SOURCE_LINE 00000378 "must not modify its C<$_[0]>."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=head2 The ncmp function"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "Often, when sorting non-string values like this:"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "   @objects_sorted = sort { $a->tag cmp $b->tag } @objects;"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "...or even in a Schwartzian transform, like this:"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "   @strings ="
NSQ_SOURCE_LINE 00000389 "     map $_->[0]"
NSQ_SOURCE_LINE 00000390 "     sort { $a->[1] cmp $b->[1] }"
NSQ_SOURCE_LINE 00000391 "     map { [$_, make_a_sort_key_from($_) ]"
NSQ_SOURCE_LINE 00000392 "     @_"
NSQ_SOURCE_LINE 00000393 "   ;"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "...you wight want something that replaces not C<sort>, but C<cmp>."
NSQ_SOURCE_LINE 00000396 "That's what Sort::Naturally's C<ncmp> function is for.  Call it with"
NSQ_SOURCE_LINE 00000397 "the syntax C<ncmp($left,$right)> instead of C<$left cmp $right>,"
NSQ_SOURCE_LINE 00000398 "but otherwise it's a fine replacement:"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "   @objects_sorted = sort { ncmp($a->tag,$b->tag) } @objects;"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "   @strings ="
NSQ_SOURCE_LINE 00000403 "     map $_->[0]"
NSQ_SOURCE_LINE 00000404 "     sort { ncmp($a->[1], $b->[1]) }"
NSQ_SOURCE_LINE 00000405 "     map { [$_, make_a_sort_key_from($_) ]"
NSQ_SOURCE_LINE 00000406 "     @_"
NSQ_SOURCE_LINE 00000407 "   ;"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "Just as with C<nsort> can take different a string-comparator"
NSQ_SOURCE_LINE 00000410 "and/or lowercaser, you can do the same with C<ncmp>, by passing"
NSQ_SOURCE_LINE 00000411 "an arrayref as the first argument:"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "  ncmp( ["
NSQ_SOURCE_LINE 00000414 "          \\&string_comparator,   # optional"
NSQ_SOURCE_LINE 00000415 "          \\&lowercaser_function  # optional"
NSQ_SOURCE_LINE 00000416 "        ],"
NSQ_SOURCE_LINE 00000417 "        $left, $right"
NSQ_SOURCE_LINE 00000418 "      )"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "You might get string comparators from L<Sort::ArbBiLex|Sort::ArbBiLex>."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "=head1 NOTES"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "=over"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=item *"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "This module is not a substitute for"
NSQ_SOURCE_LINE 00000429 "L<Sort::Versions|Sort::Versions>!  If"
NSQ_SOURCE_LINE 00000430 "you just need proper version sorting, use I<that!>"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "=item *"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "If you need something that works I<sort of> like this module's"
NSQ_SOURCE_LINE 00000435 "functions, but not quite the same, consider scouting thru this"
NSQ_SOURCE_LINE 00000436 "module's source code, and adapting what you see.  Besides"
NSQ_SOURCE_LINE 00000437 "the functions that actually compile in this module, after the POD,"
NSQ_SOURCE_LINE 00000438 "there's several alternate attempts of mine at natural sorting"
NSQ_SOURCE_LINE 00000439 "routines, which are not compiled as part of the module, but which you"
NSQ_SOURCE_LINE 00000440 "might find useful.  They should all be I<working> implementations of"
NSQ_SOURCE_LINE 00000441 "slightly different algorithms"
NSQ_SOURCE_LINE 00000442 "(all of them based on Martin Pool's C<nsort>) which I eventually"
NSQ_SOURCE_LINE 00000443 "discarded in favor of my algorithm.  If you are having to"
NSQ_SOURCE_LINE 00000444 "naturally-sort I<very large> data sets, and sorting is getting"
NSQ_SOURCE_LINE 00000445 "ridiculously slow, you might consider trying one of those"
NSQ_SOURCE_LINE 00000446 "discarded functions -- I have a feeling they might be faster on"
NSQ_SOURCE_LINE 00000447 "large data sets.  Benchmark them on your data and see.  (Unless"
NSQ_SOURCE_LINE 00000448 "you I<need> the speed, don't bother.  Hint: substitute C<sort>"
NSQ_SOURCE_LINE 00000449 "for C<nsort> in your code, and unless your program speeds up"
NSQ_SOURCE_LINE 00000450 "drastically, it's not the sorting that's slowing things down."
NSQ_SOURCE_LINE 00000451 "But if it I<is> C<nsort> that's slowing things down, consider"
NSQ_SOURCE_LINE 00000452 "just:"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "      if(@set >= SOME_VERY_BIG_NUMBER) {"
NSQ_SOURCE_LINE 00000455 "        no locale; # vroom vroom"
NSQ_SOURCE_LINE 00000456 "        @sorted = sort(@set);  # feh, good enough"
NSQ_SOURCE_LINE 00000457 "      } elsif(@set >= SOME_BIG_NUMBER) {"
NSQ_SOURCE_LINE 00000458 "        use locale;"
NSQ_SOURCE_LINE 00000459 "        @sorted = sort(@set);  # feh, good enough"
NSQ_SOURCE_LINE 00000460 "      } else {"
NSQ_SOURCE_LINE 00000461 "        # but keep it pretty for normal cases"
NSQ_SOURCE_LINE 00000462 "        @sorted = nsort(@set);"
NSQ_SOURCE_LINE 00000463 "      }"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=item *"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "If you do adapt the routines in this module, email me; I'd"
NSQ_SOURCE_LINE 00000468 "just be interested in hearing about it."
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "=item *"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "Thanks to the EFNet #perl people for encouraging this module,"
NSQ_SOURCE_LINE 00000473 "especially magister and a-mused."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "=back"
NSQ_SOURCE_LINE 00000476 ""
