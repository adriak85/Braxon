NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head2 ffi->test"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 " my $ffi = ffi->test;"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "Returns a L<FFI::Platypus> instance connected to the test for your module."
NSQ_SOURCE_LINE 00000314 ""
