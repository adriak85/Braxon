NSQ_SOURCE_LINE 00000282 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "This Test2 Tools module provide some basic tools for testing FFI modules."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=head2 ffi_options"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 " ffi_options %options;"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "This must be run before any C<< ffi-> >> functions.  Options available:"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=over 4"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=item api"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "The L<FFI::Platypus> api level.  Zero (0) by default for backward compat,"
NSQ_SOURCE_LINE 00000299 "but it is recommended that you use One (1)."
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=back"
NSQ_SOURCE_LINE 00000302 ""
