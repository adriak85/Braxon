NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "# ABSTRACT: Tools for testing FFI"
NSQ_SOURCE_LINE 00000016 "our $VERSION = '0.06'; # VERSION"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "our @EXPORT = qw( ffi ffi_options );"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "{"
NSQ_SOURCE_LINE 00000022 "  my $singleton;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "  sub ffi"
NSQ_SOURCE_LINE 00000025 "  {"
NSQ_SOURCE_LINE 00000026 "    unless($singleton)"
NSQ_SOURCE_LINE 00000027 "    {"
NSQ_SOURCE_LINE 00000028 "      $singleton = bless {}, 'Test2::Tools::FFI::Single';"
NSQ_SOURCE_LINE 00000029 "    }"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    $singleton;"
NSQ_SOURCE_LINE 00000032 "  }"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "  sub ffi_options"
NSQ_SOURCE_LINE 00000036 "  {"
NSQ_SOURCE_LINE 00000037 "    my(%options) = @_;"
NSQ_SOURCE_LINE 00000038 "    Carp::croak(\"Please call ffi_options before calling ffi\")"
NSQ_SOURCE_LINE 00000039 "      if defined $singleton;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    my $ffi = ffi();"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    my @new_args;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    if(my $api = delete $options{api})"
NSQ_SOURCE_LINE 00000046 "    {"
NSQ_SOURCE_LINE 00000047 "      push @new_args, api => $api;"
NSQ_SOURCE_LINE 00000048 "    }"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    $ffi->{new_args} = \\@new_args;"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    Carp::croak(\"Unknown option or options: @{[ sort keys %options ]}\")"
NSQ_SOURCE_LINE 00000053 "      if %options;"
NSQ_SOURCE_LINE 00000054 "  }"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub _pass"
NSQ_SOURCE_LINE 00000058 "{"
NSQ_SOURCE_LINE 00000059 "  my($name, @location) = @_;"
NSQ_SOURCE_LINE 00000060 "  my $ctx = context();"
NSQ_SOURCE_LINE 00000061 "  $ctx->send_event("
NSQ_SOURCE_LINE 00000062 "    'Pass',"
NSQ_SOURCE_LINE 00000063 "    name => $name,"
NSQ_SOURCE_LINE 00000064 "    # this seems to swallow some info, be good"
NSQ_SOURCE_LINE 00000065 "    # to know if we need it."
NSQ_SOURCE_LINE 00000066 "    trace => Test2::EventFacet::Trace->new("
NSQ_SOURCE_LINE 00000067 "      frame => [@location],"
NSQ_SOURCE_LINE 00000068 "    )"
NSQ_SOURCE_LINE 00000069 "  );"
NSQ_SOURCE_LINE 00000070 "  $ctx->release;"
NSQ_SOURCE_LINE 00000071 "}"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "sub _fail"
NSQ_SOURCE_LINE 00000074 "{"
NSQ_SOURCE_LINE 00000075 "  my($name, @location) = @_;"
NSQ_SOURCE_LINE 00000076 "  my $ctx = context();"
NSQ_SOURCE_LINE 00000077 "  $ctx->send_event("
NSQ_SOURCE_LINE 00000078 "    'Fail',"
NSQ_SOURCE_LINE 00000079 "    name => $name,"
NSQ_SOURCE_LINE 00000080 "    trace => Test2::EventFacet::Trace->new("
NSQ_SOURCE_LINE 00000081 "      frame => [@location],"
NSQ_SOURCE_LINE 00000082 "    )"
NSQ_SOURCE_LINE 00000083 "  );"
NSQ_SOURCE_LINE 00000084 "  $ctx->release;"
NSQ_SOURCE_LINE 00000085 "}"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "sub _note"
NSQ_SOURCE_LINE 00000088 "{"
NSQ_SOURCE_LINE 00000089 "  my($message, @location) = @_;"
NSQ_SOURCE_LINE 00000090 "  my $ctx = context();"
NSQ_SOURCE_LINE 00000091 "  $ctx->send_event("
NSQ_SOURCE_LINE 00000092 "    'Note',"
NSQ_SOURCE_LINE 00000093 "    message => $message,"
NSQ_SOURCE_LINE 00000094 "    trace => Test2::EventFacet::Trace->new("
NSQ_SOURCE_LINE 00000095 "      frame => [@location],"
NSQ_SOURCE_LINE 00000096 "    )"
NSQ_SOURCE_LINE 00000097 "  );"
NSQ_SOURCE_LINE 00000098 "  $ctx->release;"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "sub _diag"
NSQ_SOURCE_LINE 00000102 "{"
NSQ_SOURCE_LINE 00000103 "  my($message, @location) = @_;"
NSQ_SOURCE_LINE 00000104 "  my $ctx = context();"
NSQ_SOURCE_LINE 00000105 "  $ctx->send_event("
NSQ_SOURCE_LINE 00000106 "    'Diag',"
NSQ_SOURCE_LINE 00000107 "    message => $message,"
NSQ_SOURCE_LINE 00000108 "    trace => Test2::EventFacet::Trace->new("
NSQ_SOURCE_LINE 00000109 "      frame => [@location],"
NSQ_SOURCE_LINE 00000110 "    )"
NSQ_SOURCE_LINE 00000111 "  );"
NSQ_SOURCE_LINE 00000112 "  $ctx->release;"
NSQ_SOURCE_LINE 00000113 "}"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "{"
NSQ_SOURCE_LINE 00000116 "  local $ENV{FFI_PLATYPUS_DLERROR} = 1;"
NSQ_SOURCE_LINE 00000117 "  our $ffi = FFI::Platypus->new( api => 1 );"
NSQ_SOURCE_LINE 00000118 "  our @closures = map { $ffi->closure($_) } \\&_note, \\&_diag, \\&_pass, \\&_fail;"
NSQ_SOURCE_LINE 00000119 "  $ffi->bundle;"
NSQ_SOURCE_LINE 00000120 "  $ffi->type('(string,string,string,int,string)->void' => 'message_cb_t');"
NSQ_SOURCE_LINE 00000121 "  $ffi"
NSQ_SOURCE_LINE 00000122 "    ->function(t2t_simple_init => ['message_cb_t','message_cb_t','message_cb_t','message_cb_t'] => 'void')"
NSQ_SOURCE_LINE 00000123 "    ->call(@closures);"
NSQ_SOURCE_LINE 00000124 "}"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "package Test2::Tools::FFI::Single;"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "sub runtime"
NSQ_SOURCE_LINE 00000130 "{"
NSQ_SOURCE_LINE 00000131 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "  $self->{runtime} ||= (sub {"
NSQ_SOURCE_LINE 00000134 "    my $ffi = Test2::Tools::FFI::Platypus->new( @{ $self->{new_args} } );"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    my @dll = File::Glob::bsd_glob(\"blib/lib/auto/share/dist/*/lib/*\");"
NSQ_SOURCE_LINE 00000137 "    if(@dll)"
NSQ_SOURCE_LINE 00000138 "    {"
NSQ_SOURCE_LINE 00000139 "      $ffi->lib(@dll);"
NSQ_SOURCE_LINE 00000140 "      return $ffi;"
NSQ_SOURCE_LINE 00000141 "    }"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    @dll = File::Glob::bsd_glob(\"share/lib/*\");"
NSQ_SOURCE_LINE 00000144 "    if(@dll)"
NSQ_SOURCE_LINE 00000145 "    {"
NSQ_SOURCE_LINE 00000146 "      $ffi->lib(@dll);"
NSQ_SOURCE_LINE 00000147 "      return $ffi;"
NSQ_SOURCE_LINE 00000148 "    }"
NSQ_SOURCE_LINE 00000149 "    $ffi;"
NSQ_SOURCE_LINE 00000150 "  })->();"
NSQ_SOURCE_LINE 00000151 "}"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "sub _build_test"
NSQ_SOURCE_LINE 00000155 "{"
NSQ_SOURCE_LINE 00000156 "  if(-d \"t/ffi\")"
NSQ_SOURCE_LINE 00000157 "  {"
NSQ_SOURCE_LINE 00000158 "    require FFI::Build::MM;"
NSQ_SOURCE_LINE 00000159 "    require Capture::Tiny;"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    my($output, $error) = Capture::Tiny::capture_merged(sub {"
NSQ_SOURCE_LINE 00000162 "      local $@ = '';"
NSQ_SOURCE_LINE 00000163 "      eval {"
NSQ_SOURCE_LINE 00000164 "        my $fbmm = FFI::Build::MM->new( save => 0 );"
NSQ_SOURCE_LINE 00000165 "        $fbmm->mm_args( DISTNAME => \"My-Test\" );  # the DISTNAME isn't used for building the test anyway."
NSQ_SOURCE_LINE 00000166 "        $fbmm->test->build;"
NSQ_SOURCE_LINE 00000167 "      };"
NSQ_SOURCE_LINE 00000168 "      $@;"
NSQ_SOURCE_LINE 00000169 "    });"
NSQ_SOURCE_LINE 00000170 "    if($error)"
NSQ_SOURCE_LINE 00000171 "    {"
NSQ_SOURCE_LINE 00000172 "      my $ctx = Test2::API::context();"
NSQ_SOURCE_LINE 00000173 "      $ctx->diag($error);"
NSQ_SOURCE_LINE 00000174 "      $ctx->diag($output);"
NSQ_SOURCE_LINE 00000175 "      $ctx->release;"
NSQ_SOURCE_LINE 00000176 "      die $error;"
NSQ_SOURCE_LINE 00000177 "    }"
NSQ_SOURCE_LINE 00000178 "    else"
NSQ_SOURCE_LINE 00000179 "    {"
NSQ_SOURCE_LINE 00000180 "      my $ctx = Test2::API::context();"
NSQ_SOURCE_LINE 00000181 "      $ctx->note($output);"
NSQ_SOURCE_LINE 00000182 "      $ctx->release;"
NSQ_SOURCE_LINE 00000183 "    }"
NSQ_SOURCE_LINE 00000184 "  }"
NSQ_SOURCE_LINE 00000185 "}"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "sub test"
NSQ_SOURCE_LINE 00000188 "{"
NSQ_SOURCE_LINE 00000189 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "  $self->{test} ||= do {"
NSQ_SOURCE_LINE 00000192 "    _build_test();"
NSQ_SOURCE_LINE 00000193 "    my $ffi = Test2::Tools::FFI::Platypus->new( @{ $self->{new_args} } );"
NSQ_SOURCE_LINE 00000194 "    my @lib = FFI::CheckLib::find_lib("
NSQ_SOURCE_LINE 00000195 "      lib => '*',"
NSQ_SOURCE_LINE 00000196 "      libpath => 't/ffi/_build',"
NSQ_SOURCE_LINE 00000197 "      systempath => [],"
NSQ_SOURCE_LINE 00000198 "    );"
NSQ_SOURCE_LINE 00000199 "    Carp::croak(\"unable to find test lib in t/ffi/_build\")"
NSQ_SOURCE_LINE 00000200 "      unless @lib;"
NSQ_SOURCE_LINE 00000201 "    $ffi->lib(@lib);"
NSQ_SOURCE_LINE 00000202 "    $ffi;"
NSQ_SOURCE_LINE 00000203 "  };"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "sub combined"
NSQ_SOURCE_LINE 00000208 "{"
NSQ_SOURCE_LINE 00000209 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "  $self->{combined} ||= do {"
NSQ_SOURCE_LINE 00000212 "    _build_test();"
NSQ_SOURCE_LINE 00000213 "    my $rt = $self->runtime;"
NSQ_SOURCE_LINE 00000214 "    my $t  = $self->test;"
NSQ_SOURCE_LINE 00000215 "    my $ffi = Test2::Tools::FFI::Platypus->new( @{ $self->{new_args} } );"
NSQ_SOURCE_LINE 00000216 "    $ffi->lib($rt->lib, $t->lib);"
NSQ_SOURCE_LINE 00000217 "    $ffi;"
NSQ_SOURCE_LINE 00000218 "  };"
NSQ_SOURCE_LINE 00000219 "}"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "package Test2::Tools::FFI::Platypus;"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "use base qw( FFI::Platypus );"
NSQ_SOURCE_LINE 00000224 "use Test2::API ();"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "sub symbol_ok"
NSQ_SOURCE_LINE 00000227 "{"
NSQ_SOURCE_LINE 00000228 "  my($self, $symbol_name, $test_name) = @_;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "  $test_name ||= \"Library has symbol: $symbol_name\";"
NSQ_SOURCE_LINE 00000231 "  my $address = $self->find_symbol($symbol_name);"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "  my $ctx = Test2::API::context();"
NSQ_SOURCE_LINE 00000234 "  if($address)"
NSQ_SOURCE_LINE 00000235 "  {"
NSQ_SOURCE_LINE 00000236 "    $ctx->pass_and_release($test_name);"
NSQ_SOURCE_LINE 00000237 "  }"
NSQ_SOURCE_LINE 00000238 "  else"
NSQ_SOURCE_LINE 00000239 "  {"
NSQ_SOURCE_LINE 00000240 "    $ctx->fail_and_release($test_name, map { \"looked in $_\" } $self->lib);"
NSQ_SOURCE_LINE 00000241 "  }"
NSQ_SOURCE_LINE 00000242 "}"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "1;"
NSQ_SOURCE_LINE 00000245 ""
