NSQ_SOURCE_LINE 00000001 "package Email::Valid::Loose;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.05';"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Email::Valid 0.17;"
NSQ_SOURCE_LINE 00000007 "use base qw(Email::Valid);"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "# This is BNF from RFC822"
NSQ_SOURCE_LINE 00000010 "my $esc         = '\\\\\\\\';"
NSQ_SOURCE_LINE 00000011 "my $period      = '\\.';"
NSQ_SOURCE_LINE 00000012 "my $space       = '\\040';"
NSQ_SOURCE_LINE 00000013 "my $open_br     = '\\[';"
NSQ_SOURCE_LINE 00000014 "my $close_br    = '\\]';"
NSQ_SOURCE_LINE 00000015 "my $nonASCII    = '\\x80-\\xff';"
NSQ_SOURCE_LINE 00000016 "my $ctrl        = '\\000-\\037';"
NSQ_SOURCE_LINE 00000017 "my $cr_list     = '\\n\\015';"
NSQ_SOURCE_LINE 00000018 "my $qtext       = qq/[^$esc$nonASCII$cr_list\\\"]/; # \""
NSQ_SOURCE_LINE 00000019 "my $dtext       = qq/[^$esc$nonASCII$cr_list$open_br$close_br]/;"
NSQ_SOURCE_LINE 00000020 "my $quoted_pair = qq<$esc>.qq<[^$nonASCII]>;"
NSQ_SOURCE_LINE 00000021 "my $atom_char   = qq/[^($space)<>\\@,;:\\\".$esc$open_br$close_br$ctrl$nonASCII]/;\t# \""
NSQ_SOURCE_LINE 00000022 "my $atom        = qq<$atom_char+(?!$atom_char)>;"
NSQ_SOURCE_LINE 00000023 "my $quoted_str  = qq<\\\"$qtext*(?:$quoted_pair$qtext*)*\\\">; # \""
NSQ_SOURCE_LINE 00000024 "my $word        = qq<(?:$atom|$quoted_str)>;"
NSQ_SOURCE_LINE 00000025 "my $domain_ref  = $atom;"
NSQ_SOURCE_LINE 00000026 "my $domain_lit  = qq<$open_br(?:$dtext|$quoted_pair)*$close_br>;"
NSQ_SOURCE_LINE 00000027 "my $sub_domain  = qq<(?:$domain_ref|$domain_lit)>;"
NSQ_SOURCE_LINE 00000028 "my $domain      = qq<$sub_domain(?:$period$sub_domain)*>;"
NSQ_SOURCE_LINE 00000029 "my $local_part  = qq<$word(?:$word|$period)*>; # This part is modified"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "# Finally, the address-spec regex (more or less)"
NSQ_SOURCE_LINE 00000032 "use vars qw($Addr_spec_re);"
NSQ_SOURCE_LINE 00000033 "$Addr_spec_re   = qr<$local_part\\@$domain>;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "sub rfc822 {"
NSQ_SOURCE_LINE 00000036 "    my $self = shift;"
NSQ_SOURCE_LINE 00000037 "    my %args = $self->_rearrange([qw( address )], \\@_);"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    my $addr = $args{address} or return $self->details('rfc822');"
NSQ_SOURCE_LINE 00000040 "    $addr = $addr->address if UNIVERSAL::isa($addr, 'Mail::Address');"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "    return $self->details('rfc822') unless $addr =~ m/^$Addr_spec_re$/o;"
NSQ_SOURCE_LINE 00000043 "    return 1;"
NSQ_SOURCE_LINE 00000044 "}"
NSQ_SOURCE_LINE 00000045 "1;"
NSQ_SOURCE_LINE 00000046 "__END__"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "=head1 NAME"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "Email::Valid::Loose - Email::Valid which allows dot before at mark"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "  use Email::Valid::Loose;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "  # same as Email::Valid"
NSQ_SOURCE_LINE 00000057 "  my $addr     = 'read_rfc822.@docomo.ne.jp';"
NSQ_SOURCE_LINE 00000058 "  my $is_valid = Email::Valid::Loose->address($addr);"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "Email::Valid::Loose is a subclass of Email::Valid, which allows"
NSQ_SOURCE_LINE 00000063 ". (dot) before @ (at-mark). It is invalid in RFC822, but is commonly"
NSQ_SOURCE_LINE 00000064 "used in some of mobile phone addresses in Japan (like docomo.ne.jp or"
NSQ_SOURCE_LINE 00000065 "jp-t.ne.jp)."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=head1 IMPLEMENTATION"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "This module overrides C<rfc822> method in Email::Valid."
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "Tatsuhiko Miyagawa E<lt>miyagawa@bulknews.netE<gt>"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "This library is free software; you can redistribute it and/or modify"
NSQ_SOURCE_LINE 00000076 "it under the same terms as Perl itself."
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "L<Email::Valid>, L<Mail::Address::MobileJp>"
NSQ_SOURCE_LINE 00000081 ""
