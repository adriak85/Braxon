NSQ_SOURCE_LINE 00000001 "package XML::NamespaceSupport;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "our $VERSION = '1.12'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "# ABSTRACT: A simple generic namespace processor"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use constant FATALS         => 0; # root object"
NSQ_SOURCE_LINE 00000009 "use constant NSMAP          => 1;"
NSQ_SOURCE_LINE 00000010 "use constant UNKNOWN_PREF   => 2;"
NSQ_SOURCE_LINE 00000011 "use constant AUTO_PREFIX    => 3;"
NSQ_SOURCE_LINE 00000012 "use constant XMLNS_11       => 4;"
NSQ_SOURCE_LINE 00000013 "use constant DEFAULT        => 0; # maps"
NSQ_SOURCE_LINE 00000014 "use constant PREFIX_MAP     => 1;"
NSQ_SOURCE_LINE 00000015 "use constant DECLARATIONS   => 2;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "use vars qw($NS_XMLNS $NS_XML);"
NSQ_SOURCE_LINE 00000018 "$NS_XMLNS   = 'http://www.w3.org/2000/xmlns/';"
NSQ_SOURCE_LINE 00000019 "$NS_XML     = 'http://www.w3.org/XML/1998/namespace';"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "# add the ns stuff that baud wants based on Java's xml-writer"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000025 "# constructor"
NSQ_SOURCE_LINE 00000026 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000027 "sub new {"
NSQ_SOURCE_LINE 00000028 "    my $class   = ref($_[0]) ? ref(shift) : shift;"
NSQ_SOURCE_LINE 00000029 "    my $options = shift;"
NSQ_SOURCE_LINE 00000030 "    my $self = ["
NSQ_SOURCE_LINE 00000031 "                1, # FATALS"
NSQ_SOURCE_LINE 00000032 "                [[ # NSMAP"
NSQ_SOURCE_LINE 00000033 "                  undef,              # DEFAULT"
NSQ_SOURCE_LINE 00000034 "                  { xml => $NS_XML }, # PREFIX_MAP"
NSQ_SOURCE_LINE 00000035 "                  undef,              # DECLARATIONS"
NSQ_SOURCE_LINE 00000036 "                ]],"
NSQ_SOURCE_LINE 00000037 "                'aaa', # UNKNOWN_PREF"
NSQ_SOURCE_LINE 00000038 "                0,     # AUTO_PREFIX"
NSQ_SOURCE_LINE 00000039 "                1,     # XML_11"
NSQ_SOURCE_LINE 00000040 "               ];"
NSQ_SOURCE_LINE 00000041 "    $self->[NSMAP]->[0]->[PREFIX_MAP]->{xmlns} = $NS_XMLNS if $options->{xmlns};"
NSQ_SOURCE_LINE 00000042 "    $self->[FATALS] = $options->{fatal_errors} if defined $options->{fatal_errors};"
NSQ_SOURCE_LINE 00000043 "    $self->[AUTO_PREFIX] = $options->{auto_prefix} if defined $options->{auto_prefix};"
NSQ_SOURCE_LINE 00000044 "    $self->[XMLNS_11] = $options->{xmlns_11} if defined $options->{xmlns_11};"
NSQ_SOURCE_LINE 00000045 "    return bless $self, $class;"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000049 "# reset() - return to the original state (for reuse)"
NSQ_SOURCE_LINE 00000050 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000051 "sub reset {"
NSQ_SOURCE_LINE 00000052 "    my $self = shift;"
NSQ_SOURCE_LINE 00000053 "    $#{$self->[NSMAP]} = 0;"
NSQ_SOURCE_LINE 00000054 "}"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000057 "# push_context() - add a new empty context to the stack"
NSQ_SOURCE_LINE 00000058 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000059 "sub push_context {"
NSQ_SOURCE_LINE 00000060 "    my $self = shift;"
NSQ_SOURCE_LINE 00000061 "    push @{$self->[NSMAP]}, ["
NSQ_SOURCE_LINE 00000062 "                             $self->[NSMAP]->[-1]->[DEFAULT],"
NSQ_SOURCE_LINE 00000063 "                             { %{$self->[NSMAP]->[-1]->[PREFIX_MAP]} },"
NSQ_SOURCE_LINE 00000064 "                             [],"
NSQ_SOURCE_LINE 00000065 "                            ];"
NSQ_SOURCE_LINE 00000066 "}"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000069 "# pop_context() - remove the topmost context from the stack"
NSQ_SOURCE_LINE 00000070 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000071 "sub pop_context {"
NSQ_SOURCE_LINE 00000072 "    my $self = shift;"
NSQ_SOURCE_LINE 00000073 "    die 'Trying to pop context without push context' unless @{$self->[NSMAP]} > 1;"
NSQ_SOURCE_LINE 00000074 "    pop @{$self->[NSMAP]};"
NSQ_SOURCE_LINE 00000075 "}"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000078 "# declare_prefix() - declare a prefix in the current scope"
NSQ_SOURCE_LINE 00000079 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000080 "sub declare_prefix {"
NSQ_SOURCE_LINE 00000081 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000082 "    my $prefix  = shift;"
NSQ_SOURCE_LINE 00000083 "    my $value   = shift;"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    warn <<'    EOWARN' unless defined $prefix or $self->[AUTO_PREFIX];"
NSQ_SOURCE_LINE 00000086 "    Prefix was undefined."
NSQ_SOURCE_LINE 00000087 "    If you wish to set the default namespace, use the empty string ''."
NSQ_SOURCE_LINE 00000088 "    If you wish to autogenerate prefixes, set the auto_prefix option"
NSQ_SOURCE_LINE 00000089 "    to a true value."
NSQ_SOURCE_LINE 00000090 "    EOWARN"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000093 "    if ($prefix eq 'xml' and $value ne $NS_XML) {"
NSQ_SOURCE_LINE 00000094 "        die \"The xml prefix can only be bound to the $NS_XML namespace.\""
NSQ_SOURCE_LINE 00000095 "    }"
NSQ_SOURCE_LINE 00000096 "    elsif ($value eq $NS_XML and $prefix ne 'xml') {"
NSQ_SOURCE_LINE 00000097 "        die \"the $NS_XML namespace can only be bound to the xml prefix.\";"
NSQ_SOURCE_LINE 00000098 "    }"
NSQ_SOURCE_LINE 00000099 "    elsif ($value eq $NS_XML and $prefix eq 'xml') {"
NSQ_SOURCE_LINE 00000100 "        return 1;"
NSQ_SOURCE_LINE 00000101 "    }"
NSQ_SOURCE_LINE 00000102 "    return 0 if index(lc($prefix), 'xml') == 0;"
NSQ_SOURCE_LINE 00000103 "    use warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    if (defined $prefix and $prefix eq '') {"
NSQ_SOURCE_LINE 00000106 "        $self->[NSMAP]->[-1]->[DEFAULT] = $value;"
NSQ_SOURCE_LINE 00000107 "    }"
NSQ_SOURCE_LINE 00000108 "    else {"
NSQ_SOURCE_LINE 00000109 "        die \"Cannot declare prefix $prefix\" if $value eq '' and not $self->[XMLNS_11];"
NSQ_SOURCE_LINE 00000110 "        if (not defined $prefix and $self->[AUTO_PREFIX]) {"
NSQ_SOURCE_LINE 00000111 "            while (1) {"
NSQ_SOURCE_LINE 00000112 "                $prefix = $self->[UNKNOWN_PREF]++;"
NSQ_SOURCE_LINE 00000113 "                last if not exists $self->[NSMAP]->[-1]->[PREFIX_MAP]->{$prefix};"
NSQ_SOURCE_LINE 00000114 "            }"
NSQ_SOURCE_LINE 00000115 "        }"
NSQ_SOURCE_LINE 00000116 "        elsif (not defined $prefix and not $self->[AUTO_PREFIX]) {"
NSQ_SOURCE_LINE 00000117 "            return 0;"
NSQ_SOURCE_LINE 00000118 "        }"
NSQ_SOURCE_LINE 00000119 "        $self->[NSMAP]->[-1]->[PREFIX_MAP]->{$prefix} = $value;"
NSQ_SOURCE_LINE 00000120 "    }"
NSQ_SOURCE_LINE 00000121 "    push @{$self->[NSMAP]->[-1]->[DECLARATIONS]}, $prefix;"
NSQ_SOURCE_LINE 00000122 "    return 1;"
NSQ_SOURCE_LINE 00000123 "}"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000126 "# declare_prefixes() - declare several prefixes in the current scope"
NSQ_SOURCE_LINE 00000127 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000128 "sub declare_prefixes {"
NSQ_SOURCE_LINE 00000129 "    my $self     = shift;"
NSQ_SOURCE_LINE 00000130 "    my %prefixes = @_;"
NSQ_SOURCE_LINE 00000131 "    while (my ($k,$v) = each %prefixes) {"
NSQ_SOURCE_LINE 00000132 "        $self->declare_prefix($k,$v);"
NSQ_SOURCE_LINE 00000133 "    }"
NSQ_SOURCE_LINE 00000134 "}"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000137 "# undeclare_prefix"
NSQ_SOURCE_LINE 00000138 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000139 "sub undeclare_prefix {"
NSQ_SOURCE_LINE 00000140 "    my $self   = shift;"
NSQ_SOURCE_LINE 00000141 "    my $prefix = shift;"
NSQ_SOURCE_LINE 00000142 "    return if not defined($prefix);"
NSQ_SOURCE_LINE 00000143 "    return unless exists $self->[NSMAP]->[-1]->[PREFIX_MAP]->{$prefix};"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    my ( $tfix ) = grep { $_ eq $prefix } @{$self->[NSMAP]->[-1]->[DECLARATIONS]};"
NSQ_SOURCE_LINE 00000146 "    if ( not defined $tfix ) {"
NSQ_SOURCE_LINE 00000147 "        die \"prefix $prefix not declared in this context\\n\";"
NSQ_SOURCE_LINE 00000148 "    }"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "    @{$self->[NSMAP]->[-1]->[DECLARATIONS]} = grep { $_ ne $prefix } @{$self->[NSMAP]->[-1]->[DECLARATIONS]};"
NSQ_SOURCE_LINE 00000151 "    delete $self->[NSMAP]->[-1]->[PREFIX_MAP]->{$prefix};"
NSQ_SOURCE_LINE 00000152 "}"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000155 "# get_prefix() - get a (random) prefix for a given URI"
NSQ_SOURCE_LINE 00000156 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000157 "sub get_prefix {"
NSQ_SOURCE_LINE 00000158 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000159 "    my $uri     = shift;"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    # we have to iterate over the whole hash here because if we don't"
NSQ_SOURCE_LINE 00000162 "    # the iterator isn't reset and the next pass will fail"
NSQ_SOURCE_LINE 00000163 "    my $pref;"
NSQ_SOURCE_LINE 00000164 "    while (my ($k, $v) = each %{$self->[NSMAP]->[-1]->[PREFIX_MAP]}) {"
NSQ_SOURCE_LINE 00000165 "        $pref = $k if $v eq $uri;"
NSQ_SOURCE_LINE 00000166 "    }"
NSQ_SOURCE_LINE 00000167 "    return $pref;"
NSQ_SOURCE_LINE 00000168 "}"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000171 "# get_prefixes() - get all the prefixes for a given URI"
NSQ_SOURCE_LINE 00000172 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000173 "sub get_prefixes {"
NSQ_SOURCE_LINE 00000174 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000175 "    my $uri     = shift;"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    return keys %{$self->[NSMAP]->[-1]->[PREFIX_MAP]} unless defined $uri;"
NSQ_SOURCE_LINE 00000178 "    return grep { $self->[NSMAP]->[-1]->[PREFIX_MAP]->{$_} eq $uri } keys %{$self->[NSMAP]->[-1]->[PREFIX_MAP]};"
NSQ_SOURCE_LINE 00000179 "}"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000182 "# get_declared_prefixes() - get all prefixes declared in the last context"
NSQ_SOURCE_LINE 00000183 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000184 "sub get_declared_prefixes {"
NSQ_SOURCE_LINE 00000185 "    my $declarations = $_[0]->[NSMAP]->[-1]->[DECLARATIONS];"
NSQ_SOURCE_LINE 00000186 "    die \"At least one context must be pushed onto stack with push_context()\\n\","
NSQ_SOURCE_LINE 00000187 "\t\"before calling get_declared_prefixes()\""
NSQ_SOURCE_LINE 00000188 "\tif not defined $declarations;"
NSQ_SOURCE_LINE 00000189 "    return @{$_[0]->[NSMAP]->[-1]->[DECLARATIONS]};"
NSQ_SOURCE_LINE 00000190 "}"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000193 "# get_uri() - get a URI given a prefix"
NSQ_SOURCE_LINE 00000194 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000195 "sub get_uri {"
NSQ_SOURCE_LINE 00000196 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000197 "    my $prefix  = shift;"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "    warn \"Prefix must not be undef in get_uri(). The emtpy prefix must be ''\" unless defined $prefix;"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "    return $self->[NSMAP]->[-1]->[DEFAULT] if $prefix eq '';"
NSQ_SOURCE_LINE 00000202 "    return $self->[NSMAP]->[-1]->[PREFIX_MAP]->{$prefix} if exists $self->[NSMAP]->[-1]->[PREFIX_MAP]->{$prefix};"
NSQ_SOURCE_LINE 00000203 "    return undef;"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000207 "# process_name() - provide details on a name"
NSQ_SOURCE_LINE 00000208 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000209 "sub process_name {"
NSQ_SOURCE_LINE 00000210 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000211 "    my $qname   = shift;"
NSQ_SOURCE_LINE 00000212 "    my $aflag   = shift;"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "    if ($self->[FATALS]) {"
NSQ_SOURCE_LINE 00000215 "        return( ($self->_get_ns_details($qname, $aflag))[0,2], $qname );"
NSQ_SOURCE_LINE 00000216 "    }"
NSQ_SOURCE_LINE 00000217 "    else {"
NSQ_SOURCE_LINE 00000218 "        eval { return( ($self->_get_ns_details($qname, $aflag))[0,2], $qname ); }"
NSQ_SOURCE_LINE 00000219 "    }"
NSQ_SOURCE_LINE 00000220 "}"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000223 "# process_element_name() - provide details on a element's name"
NSQ_SOURCE_LINE 00000224 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000225 "sub process_element_name {"
NSQ_SOURCE_LINE 00000226 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000227 "    my $qname   = shift;"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "    if ($self->[FATALS]) {"
NSQ_SOURCE_LINE 00000230 "        return $self->_get_ns_details($qname, 0);"
NSQ_SOURCE_LINE 00000231 "    }"
NSQ_SOURCE_LINE 00000232 "    else {"
NSQ_SOURCE_LINE 00000233 "        eval { return $self->_get_ns_details($qname, 0); }"
NSQ_SOURCE_LINE 00000234 "    }"
NSQ_SOURCE_LINE 00000235 "}"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000239 "# process_attribute_name() - provide details on a attribute's name"
NSQ_SOURCE_LINE 00000240 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000241 "sub process_attribute_name {"
NSQ_SOURCE_LINE 00000242 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000243 "    my $qname   = shift;"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "    if ($self->[FATALS]) {"
NSQ_SOURCE_LINE 00000246 "        return $self->_get_ns_details($qname, 1);"
NSQ_SOURCE_LINE 00000247 "    }"
NSQ_SOURCE_LINE 00000248 "    else {"
NSQ_SOURCE_LINE 00000249 "        eval { return $self->_get_ns_details($qname, 1); }"
NSQ_SOURCE_LINE 00000250 "    }"
NSQ_SOURCE_LINE 00000251 "}"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000255 "# ($ns, $prefix, $lname) = $self->_get_ns_details($qname, $f_attr)"
NSQ_SOURCE_LINE 00000256 "# returns ns, prefix, and lname for a given attribute name"
NSQ_SOURCE_LINE 00000257 "# >> the $f_attr flag, if set to one, will work for an attribute"
NSQ_SOURCE_LINE 00000258 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000259 "sub _get_ns_details {"
NSQ_SOURCE_LINE 00000260 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000261 "    my $qname   = shift;"
NSQ_SOURCE_LINE 00000262 "    my $aflag   = shift;"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "    my ($ns, $prefix, $lname);"
NSQ_SOURCE_LINE 00000265 "    (my ($tmp_prefix, $tmp_lname) = split /:/, $qname, 3)"
NSQ_SOURCE_LINE 00000266 "                                    < 3 or die \"Invalid QName: $qname\";"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "    # no prefix"
NSQ_SOURCE_LINE 00000269 "    my $cur_map = $self->[NSMAP]->[-1];"
NSQ_SOURCE_LINE 00000270 "    if (not defined($tmp_lname)) {"
NSQ_SOURCE_LINE 00000271 "        $prefix = undef;"
NSQ_SOURCE_LINE 00000272 "        $lname = $qname;"
NSQ_SOURCE_LINE 00000273 "        # attr don't have a default namespace"
NSQ_SOURCE_LINE 00000274 "        $ns = ($aflag) ? undef : $cur_map->[DEFAULT];"
NSQ_SOURCE_LINE 00000275 "    }"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "    # prefix"
NSQ_SOURCE_LINE 00000278 "    else {"
NSQ_SOURCE_LINE 00000279 "        if (exists $cur_map->[PREFIX_MAP]->{$tmp_prefix}) {"
NSQ_SOURCE_LINE 00000280 "            $prefix = $tmp_prefix;"
NSQ_SOURCE_LINE 00000281 "            $lname  = $tmp_lname;"
NSQ_SOURCE_LINE 00000282 "            $ns     = $cur_map->[PREFIX_MAP]->{$prefix}"
NSQ_SOURCE_LINE 00000283 "        }"
NSQ_SOURCE_LINE 00000284 "        else { # no ns -> lname == name, all rest undef"
NSQ_SOURCE_LINE 00000285 "            die \"Undeclared prefix: $tmp_prefix\";"
NSQ_SOURCE_LINE 00000286 "        }"
NSQ_SOURCE_LINE 00000287 "    }"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "    return ($ns, $prefix, $lname);"
NSQ_SOURCE_LINE 00000290 "}"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000293 "# parse_jclark_notation() - parse the Clarkian notation"
NSQ_SOURCE_LINE 00000294 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000295 "sub parse_jclark_notation {"
NSQ_SOURCE_LINE 00000296 "    shift;"
NSQ_SOURCE_LINE 00000297 "    my $jc = shift;"
NSQ_SOURCE_LINE 00000298 "    $jc =~ m/^\\{(.*)\\}([^}]+)$/;"
NSQ_SOURCE_LINE 00000299 "    return $1, $2;"
NSQ_SOURCE_LINE 00000300 "}"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000304 "# Java names mapping"
NSQ_SOURCE_LINE 00000305 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000306 "*XML::NamespaceSupport::pushContext          = \\&push_context;"
NSQ_SOURCE_LINE 00000307 "*XML::NamespaceSupport::popContext           = \\&pop_context;"
NSQ_SOURCE_LINE 00000308 "*XML::NamespaceSupport::declarePrefix        = \\&declare_prefix;"
NSQ_SOURCE_LINE 00000309 "*XML::NamespaceSupport::declarePrefixes      = \\&declare_prefixes;"
NSQ_SOURCE_LINE 00000310 "*XML::NamespaceSupport::getPrefix            = \\&get_prefix;"
NSQ_SOURCE_LINE 00000311 "*XML::NamespaceSupport::getPrefixes          = \\&get_prefixes;"
NSQ_SOURCE_LINE 00000312 "*XML::NamespaceSupport::getDeclaredPrefixes  = \\&get_declared_prefixes;"
NSQ_SOURCE_LINE 00000313 "*XML::NamespaceSupport::getURI               = \\&get_uri;"
NSQ_SOURCE_LINE 00000314 "*XML::NamespaceSupport::processName          = \\&process_name;"
NSQ_SOURCE_LINE 00000315 "*XML::NamespaceSupport::processElementName   = \\&process_element_name;"
NSQ_SOURCE_LINE 00000316 "*XML::NamespaceSupport::processAttributeName = \\&process_attribute_name;"
NSQ_SOURCE_LINE 00000317 "*XML::NamespaceSupport::parseJClarkNotation  = \\&parse_jclark_notation;"
NSQ_SOURCE_LINE 00000318 "*XML::NamespaceSupport::undeclarePrefix      = \\&undeclare_prefix;"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "1;"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "__END__"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "=pod"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=head1 NAME"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "XML::NamespaceSupport - A simple generic namespace processor"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "=head1 VERSION"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "version 1.12"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "  use XML::NamespaceSupport;"
NSQ_SOURCE_LINE 00000340 "  my $nsup = XML::NamespaceSupport->new;"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "  # add a new empty context"
NSQ_SOURCE_LINE 00000343 "  $nsup->push_context;"
NSQ_SOURCE_LINE 00000344 "  # declare a few prefixes"
NSQ_SOURCE_LINE 00000345 "  $nsup->declare_prefix($prefix1, $uri1);"
NSQ_SOURCE_LINE 00000346 "  $nsup->declare_prefix($prefix2, $uri2);"
NSQ_SOURCE_LINE 00000347 "  # the same shorter"
NSQ_SOURCE_LINE 00000348 "  $nsup->declare_prefixes($prefix1 => $uri1, $prefix2 => $uri2);"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "  # get a single prefix for a URI (randomly)"
NSQ_SOURCE_LINE 00000351 "  $prefix = $nsup->get_prefix($uri);"
NSQ_SOURCE_LINE 00000352 "  # get all prefixes for a URI (probably better)"
NSQ_SOURCE_LINE 00000353 "  @prefixes = $nsup->get_prefixes($uri);"
NSQ_SOURCE_LINE 00000354 "  # get all prefixes in scope"
NSQ_SOURCE_LINE 00000355 "  @prefixes = $nsup->get_prefixes();"
NSQ_SOURCE_LINE 00000356 "  # get all prefixes that were declared for the current scope"
NSQ_SOURCE_LINE 00000357 "  @prefixes = $nsup->get_declared_prefixes;"
NSQ_SOURCE_LINE 00000358 "  # get a URI for a given prefix"
NSQ_SOURCE_LINE 00000359 "  $uri = $nsup->get_uri($prefix);"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "  # get info on a qname (java-ish way, it's a bit weird)"
NSQ_SOURCE_LINE 00000362 "  ($ns_uri, $local_name, $qname) = $nsup->process_name($qname, $is_attr);"
NSQ_SOURCE_LINE 00000363 "  # the same, more perlish"
NSQ_SOURCE_LINE 00000364 "  ($ns_uri, $prefix, $local_name) = $nsup->process_element_name($qname);"
NSQ_SOURCE_LINE 00000365 "  ($ns_uri, $prefix, $local_name) = $nsup->process_attribute_name($qname);"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "  # remove the current context"
NSQ_SOURCE_LINE 00000368 "  $nsup->pop_context;"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "  # reset the object for reuse in another document"
NSQ_SOURCE_LINE 00000371 "  $nsup->reset;"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "  # a simple helper to process Clarkian Notation"
NSQ_SOURCE_LINE 00000374 "  my ($ns, $lname) = $nsup->parse_jclark_notation('{http://foo}bar');"
NSQ_SOURCE_LINE 00000375 "  # or (given that it doesn't care about the object"
NSQ_SOURCE_LINE 00000376 "  my ($ns, $lname) = XML::NamespaceSupport->parse_jclark_notation('{http://foo}bar');"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "This module offers a simple to process namespaced XML names (unames)"
NSQ_SOURCE_LINE 00000381 "from within any application that may need them. It also helps maintain"
NSQ_SOURCE_LINE 00000382 "a prefix to namespace URI map, and provides a number of basic checks."
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "The model for this module is SAX2's NamespaceSupport class, readable at"
NSQ_SOURCE_LINE 00000385 "http://www.saxproject.org/namespaces.html"
NSQ_SOURCE_LINE 00000386 "It adds a few perlisations where we thought it appropriate."
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "=head1 NAME"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "XML::NamespaceSupport - a simple generic namespace support class"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "=head1 METHODS"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "=over 4"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "=item * XML::NamespaceSupport->new(\\%options)"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "A simple constructor."
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "The options are C<xmlns>, C<fatal_errors>, and C<auto_prefix>"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "If C<xmlns> is turned on (it is off by default) the mapping from the"
NSQ_SOURCE_LINE 00000403 "xmlns prefix to the URI defined for it in DOM level 2 is added to the"
NSQ_SOURCE_LINE 00000404 "list of predefined mappings (which normally only contains the xml"
NSQ_SOURCE_LINE 00000405 "prefix mapping)."
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "If C<fatal_errors> is turned off (it is on by default) a number of"
NSQ_SOURCE_LINE 00000408 "validity errors will simply be flagged as failures, instead of"
NSQ_SOURCE_LINE 00000409 "die()ing."
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "If C<auto_prefix> is turned on (it is off by default) when one"
NSQ_SOURCE_LINE 00000412 "provides a prefix of C<undef> to C<declare_prefix> it will generate a"
NSQ_SOURCE_LINE 00000413 "random prefix mapped to that namespace. Otherwise an undef prefix will"
NSQ_SOURCE_LINE 00000414 "trigger a warning (you should probably know what you're doing if you"
NSQ_SOURCE_LINE 00000415 "turn this option on)."
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "If C<xmlns_11> us turned off, it becomes illegal to undeclare namespace"
NSQ_SOURCE_LINE 00000418 "prefixes. It is on by default. This behaviour is compliant with Namespaces"
NSQ_SOURCE_LINE 00000419 "in XML 1.1, turning it off reverts you to version 1.0."
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "=item * $nsup->push_context"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "Adds a new empty context to the stack. You can then populate it with"
NSQ_SOURCE_LINE 00000424 "new prefixes defined at this level."
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=item * $nsup->pop_context"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "Removes the topmost context in the stack and reverts to the previous"
NSQ_SOURCE_LINE 00000429 "one. It will die() if you try to pop more than you have pushed."
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "=item * $nsup->declare_prefix($prefix, $uri)"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "Declares a mapping of $prefix to $uri, at the current level."
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "Note that with C<auto_prefix> turned on, if you declare a prefix"
NSQ_SOURCE_LINE 00000436 "mapping in which $prefix is undef(), you will get an automatic prefix"
NSQ_SOURCE_LINE 00000437 "selected for you. If it is off you will get a warning."
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "This is useful when you deal with code that hasn't kept prefixes around"
NSQ_SOURCE_LINE 00000440 "and need to reserialize the nodes. It also means that if you want to"
NSQ_SOURCE_LINE 00000441 "set the default namespace (i.e. with an empty prefix) you must use the"
NSQ_SOURCE_LINE 00000442 "empty string instead of undef. This behaviour is consistent with the"
NSQ_SOURCE_LINE 00000443 "SAX 2.0 specification."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=item * $nsup->declare_prefixes(%prefixes2uris)"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "Declares a mapping of several prefixes to URIs, at the current level."
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "=item * $nsup->get_prefix($uri)"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "Returns a prefix given a URI. Note that as several prefixes may be"
NSQ_SOURCE_LINE 00000452 "mapped to the same URI, it returns an arbitrary one. It'll return"
NSQ_SOURCE_LINE 00000453 "undef on failure."
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=item * $nsup->get_prefixes($uri)"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "Returns an array of prefixes given a URI. It'll return all the"
NSQ_SOURCE_LINE 00000458 "prefixes if the uri is undef."
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "=item * $nsup->get_declared_prefixes"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "Returns an array of all the prefixes that have been declared within"
NSQ_SOURCE_LINE 00000463 "this context, ie those that were declared on the last element, not"
NSQ_SOURCE_LINE 00000464 "those that were declared above and are simply in scope."
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "Note that at least one context must be added to the stack via"
NSQ_SOURCE_LINE 00000467 "C<push_context> before this method can be called."
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=item * $nsup->get_uri($prefix)"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "Returns a URI for a given prefix. Returns undef on failure."
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "=item * $nsup->process_name($qname, $is_attr)"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "Given a qualified name and a boolean indicating whether this is an"
NSQ_SOURCE_LINE 00000476 "attribute or another type of name (those are differently affected by"
NSQ_SOURCE_LINE 00000477 "default namespaces), it returns a namespace URI, local name, qualified"
NSQ_SOURCE_LINE 00000478 "name tuple. I know that that is a rather abnormal list to return, but"
NSQ_SOURCE_LINE 00000479 "it is so for compatibility with the Java spec. See below for more"
NSQ_SOURCE_LINE 00000480 "Perlish alternatives."
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "If the prefix is not declared, or if the name is not valid, it'll"
NSQ_SOURCE_LINE 00000483 "either die or return undef depending on the current setting of"
NSQ_SOURCE_LINE 00000484 "C<fatal_errors>."
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "=item * $nsup->undeclare_prefix($prefix);"
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "Removes a namespace prefix from the current context. This function may"
NSQ_SOURCE_LINE 00000489 "be used in SAX's end_prefix_mapping when there is fear that a namespace"
NSQ_SOURCE_LINE 00000490 "declaration might be available outside their scope (which shouldn't"
NSQ_SOURCE_LINE 00000491 "normally happen, but you never know ;) ). This may be needed in order"
NSQ_SOURCE_LINE 00000492 "to properly support Namespace 1.1."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "=item * $nsup->process_element_name($qname)"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "Given a qualified name, it returns a namespace URI, prefix, and local"
NSQ_SOURCE_LINE 00000497 "name tuple. This method applies to element names."
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "If the prefix is not declared, or if the name is not valid, it'll"
NSQ_SOURCE_LINE 00000500 "either die or return undef depending on the current setting of"
NSQ_SOURCE_LINE 00000501 "C<fatal_errors>."
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "=item * $nsup->process_attribute_name($qname)"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "Given a qualified name, it returns a namespace URI, prefix, and local"
NSQ_SOURCE_LINE 00000506 "name tuple. This method applies to attribute names."
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "If the prefix is not declared, or if the name is not valid, it'll"
NSQ_SOURCE_LINE 00000509 "either die or return undef depending on the current setting of"
NSQ_SOURCE_LINE 00000510 "C<fatal_errors>."
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "=item * $nsup->reset"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "Resets the object so that it can be reused on another document."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=back"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "All methods of the interface have an alias that is the name used in"
NSQ_SOURCE_LINE 00000519 "the original Java specification. You can use either name"
NSQ_SOURCE_LINE 00000520 "interchangeably. Here is the mapping:"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "  Java name                 Perl name"
NSQ_SOURCE_LINE 00000523 "  ---------------------------------------------------"
NSQ_SOURCE_LINE 00000524 "  pushContext               push_context"
NSQ_SOURCE_LINE 00000525 "  popContext                pop_context"
NSQ_SOURCE_LINE 00000526 "  declarePrefix             declare_prefix"
NSQ_SOURCE_LINE 00000527 "  declarePrefixes           declare_prefixes"
NSQ_SOURCE_LINE 00000528 "  getPrefix                 get_prefix"
NSQ_SOURCE_LINE 00000529 "  getPrefixes               get_prefixes"
NSQ_SOURCE_LINE 00000530 "  getDeclaredPrefixes       get_declared_prefixes"
NSQ_SOURCE_LINE 00000531 "  getURI                    get_uri"
NSQ_SOURCE_LINE 00000532 "  processName               process_name"
NSQ_SOURCE_LINE 00000533 "  processElementName        process_element_name"
NSQ_SOURCE_LINE 00000534 "  processAttributeName      process_attribute_name"
NSQ_SOURCE_LINE 00000535 "  parseJClarkNotation       parse_jclark_notation"
NSQ_SOURCE_LINE 00000536 "  undeclarePrefix           undeclare_prefix"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "=head1 VARIABLES"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "Two global variables are made available to you. They used to be constants but"
NSQ_SOURCE_LINE 00000541 "simple scalars are easier to use in a number of contexts. They are not"
NSQ_SOURCE_LINE 00000542 "exported but can easily be accessed from any package, or copied into it."
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "=over 4"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "=item * C<$NS_XMLNS>"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "The namespace for xmlns prefixes, http://www.w3.org/2000/xmlns/."
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "=item * C<$NS_XML>"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "The namespace for xml prefixes, http://www.w3.org/XML/1998/namespace."
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "=back"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "=head1 TODO"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 " - add more tests"
NSQ_SOURCE_LINE 00000559 " - optimise here and there"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000562 ""
