NSQ_SOURCE_LINE 00000001 "package URI;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '5.34';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "# 1=version 5.10 and earlier; 0=version 5.11 and later"
NSQ_SOURCE_LINE 00000009 "use constant HAS_RESERVED_SQUARE_BRACKETS => $ENV{URI_HAS_RESERVED_SQUARE_BRACKETS} ? 1 : 0;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our ($ABS_REMOTE_LEADING_DOTS, $ABS_ALLOW_RELATIVE_SCHEME, $DEFAULT_QUERY_FORM_DELIMITER);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "my %implements;  # mapping from scheme to implementor class"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "# Some \"official\" character classes"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our $reserved   = HAS_RESERVED_SQUARE_BRACKETS ? q(;/?:@&=+$,[]) : q(;/?:@&=+$,);"
NSQ_SOURCE_LINE 00000018 "our $mark       = q(-_.!~*'());                                    #'; emacs"
NSQ_SOURCE_LINE 00000019 "our $unreserved = \"A-Za-z0-9\\Q$mark\\E\";"
NSQ_SOURCE_LINE 00000020 "our $uric       = quotemeta($reserved) . $unreserved . \"%\";"
NSQ_SOURCE_LINE 00000021 "our $uric4host  = $uric . ( HAS_RESERVED_SQUARE_BRACKETS ? '' : quotemeta( q([]) ) );"
NSQ_SOURCE_LINE 00000022 "our $uric4user  = quotemeta( q{!$'()*,;:._~%-+=%&} ) . \"A-Za-z0-9\" . ( HAS_RESERVED_SQUARE_BRACKETS ? quotemeta( q([]) ) : '' ); # RFC-3987: iuserinfo w/o UTF"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "our $scheme_re  = '[a-zA-Z][a-zA-Z0-9.+\\-]*';"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "# These schemes don't have an IPv6+ address part."
NSQ_SOURCE_LINE 00000027 "our $schemes_without_host_part_re = 'data|ldapi|urn|sqlite|sqlite3';"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "# These schemes can have an IPv6+ authority part:"
NSQ_SOURCE_LINE 00000030 "#     file, ftp, gopher, http, https, ldap, ldaps, mms, news, nntp, nntps, pop, rlogin, rtsp, rtspu, rsync, sip, sips, snews,"
NSQ_SOURCE_LINE 00000031 "#     smtp, telnet, tn3270, ssh, sftp"
NSQ_SOURCE_LINE 00000032 "#     (all DB URIs, i.e. cassandra, couch, couchdb, etc.), except 'sqlite:', 'sqlite3:'. Others?"
NSQ_SOURCE_LINE 00000033 "#MAINT: URI has no test coverage for DB schemes"
NSQ_SOURCE_LINE 00000034 "#MAINT: decoupling - perhaps let each class decide itself by defining a member function 'scheme_has_authority_part()'?"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "#MAINT: 'mailto:' needs special treatment for IPv* addresses / RFC 5321 (4.1.3). Until then: restore all '[', ']'"
NSQ_SOURCE_LINE 00000037 "# These schemes need fallback to previous (<= 5.10) encoding until a specific handler is available."
NSQ_SOURCE_LINE 00000038 "our $fallback_schemes_re = 'mailto';"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "use Carp ();"
NSQ_SOURCE_LINE 00000041 "use URI::Escape ();"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "use overload ('\"\"'     => sub { ${$_[0]} },"
NSQ_SOURCE_LINE 00000044 "              '=='     => sub { _obj_eq(@_) },"
NSQ_SOURCE_LINE 00000045 "              '!='     => sub { !_obj_eq(@_) },"
NSQ_SOURCE_LINE 00000046 "              fallback => 1,"
NSQ_SOURCE_LINE 00000047 "             );"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "# Check if two objects are the same object"
NSQ_SOURCE_LINE 00000050 "sub _obj_eq {"
NSQ_SOURCE_LINE 00000051 "    return overload::StrVal($_[0]) eq overload::StrVal($_[1]);"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub new"
NSQ_SOURCE_LINE 00000055 "{"
NSQ_SOURCE_LINE 00000056 "    my($class, $uri, $scheme) = @_;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    $uri = defined ($uri) ? \"$uri\" : \"\";   # stringify"
NSQ_SOURCE_LINE 00000059 "    # Get rid of potential wrapping"
NSQ_SOURCE_LINE 00000060 "    $uri =~ s/^<(?:URL:)?(.*)>$/$1/;  #"
NSQ_SOURCE_LINE 00000061 "    $uri =~ s/^\"(.*)\"$/$1/;"
NSQ_SOURCE_LINE 00000062 "    $uri =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00000063 "    $uri =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    my $impclass;"
NSQ_SOURCE_LINE 00000066 "    if ($uri =~ m/^($scheme_re):/so) {"
NSQ_SOURCE_LINE 00000067 "\t$scheme = $1;"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 "    else {"
NSQ_SOURCE_LINE 00000070 "\tif (($impclass = ref($scheme))) {"
NSQ_SOURCE_LINE 00000071 "\t    $scheme = $scheme->scheme;"
NSQ_SOURCE_LINE 00000072 "\t}"
NSQ_SOURCE_LINE 00000073 "\telsif ($scheme && $scheme =~ m/^($scheme_re)(?::|$)/o) {"
NSQ_SOURCE_LINE 00000074 "\t    $scheme = $1;"
NSQ_SOURCE_LINE 00000075 "        }"
NSQ_SOURCE_LINE 00000076 "    }"
NSQ_SOURCE_LINE 00000077 "    $impclass ||= implementor($scheme) ||"
NSQ_SOURCE_LINE 00000078 "\tdo {"
NSQ_SOURCE_LINE 00000079 "\t    require URI::_foreign;"
NSQ_SOURCE_LINE 00000080 "\t    $impclass = 'URI::_foreign';"
NSQ_SOURCE_LINE 00000081 "\t};"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "    return $impclass->_init($uri, $scheme);"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "sub new_abs"
NSQ_SOURCE_LINE 00000088 "{"
NSQ_SOURCE_LINE 00000089 "    my($class, $uri, $base) = @_;"
NSQ_SOURCE_LINE 00000090 "    $uri = $class->new($uri, $base);"
NSQ_SOURCE_LINE 00000091 "    $uri->abs($base);"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub _init"
NSQ_SOURCE_LINE 00000096 "{"
NSQ_SOURCE_LINE 00000097 "    my $class = shift;"
NSQ_SOURCE_LINE 00000098 "    my($str, $scheme) = @_;"
NSQ_SOURCE_LINE 00000099 "    # find all funny characters and encode the bytes."
NSQ_SOURCE_LINE 00000100 "    $str = $class->_uric_escape($str);"
NSQ_SOURCE_LINE 00000101 "    $str = \"$scheme:$str\" unless $str =~ /^$scheme_re:/o ||"
NSQ_SOURCE_LINE 00000102 "                                 $class->_no_scheme_ok;"
NSQ_SOURCE_LINE 00000103 "    my $self = bless \\$str, $class;"
NSQ_SOURCE_LINE 00000104 "    $self;"
NSQ_SOURCE_LINE 00000105 "}"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "#-- Version: 5.11+"
NSQ_SOURCE_LINE 00000109 "#   Since the complete URI will be percent-encoded including '[' and ']',"
NSQ_SOURCE_LINE 00000110 "#   we selectively unescape square brackets from the authority/host part of the URI."
NSQ_SOURCE_LINE 00000111 "#   Derived modules that implement _uric_escape() should take this into account"
NSQ_SOURCE_LINE 00000112 "#   if they do not rely on URI::_uric_escape()."
NSQ_SOURCE_LINE 00000113 "#   No unescaping is performed for the userinfo@ part of the authority part."
NSQ_SOURCE_LINE 00000114 "sub _fix_uric_escape_for_host_part {"
NSQ_SOURCE_LINE 00000115 "  return if HAS_RESERVED_SQUARE_BRACKETS;"
NSQ_SOURCE_LINE 00000116 "  return if $_[0] !~ /%/;"
NSQ_SOURCE_LINE 00000117 "  return if $_[0] =~ m{^(?:$URI::schemes_without_host_part_re):}os;"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "  # until a scheme specific handler is available, fall back to previous behavior of v5.10 (i.e. 'mailto:')"
NSQ_SOURCE_LINE 00000120 "  if ($_[0] =~ m{^(?:$URI::fallback_schemes_re):}os) {"
NSQ_SOURCE_LINE 00000121 "    $_[0]    =~ s/\\%5B/[/gi;"
NSQ_SOURCE_LINE 00000122 "    $_[0]    =~ s/\\%5D/]/gi;"
NSQ_SOURCE_LINE 00000123 "    return;"
NSQ_SOURCE_LINE 00000124 "  }"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "  if ($_[0] =~ m{^((?:$URI::scheme_re:)?)//([^/?\\#]+)(.*)$}os) {"
NSQ_SOURCE_LINE 00000127 "    my $orig          = $2;"
NSQ_SOURCE_LINE 00000128 "    my ($user, $host) = $orig =~ /^(.*@)?([^@]*)$/;"
NSQ_SOURCE_LINE 00000129 "    $user  ||= '';"
NSQ_SOURCE_LINE 00000130 "    my $port = $host =~ s/(:\\d+)$// ? $1 : '';"
NSQ_SOURCE_LINE 00000131 "    #MAINT: die() here if scheme indicates TCP/UDP and port is out of range [0..65535] ?"
NSQ_SOURCE_LINE 00000132 "    $host    =~ s/\\%5B/[/gi;"
NSQ_SOURCE_LINE 00000133 "    $host    =~ s/\\%5D/]/gi;"
NSQ_SOURCE_LINE 00000134 "    $_[0]    =~ s/\\Q$orig\\E/$user$host$port/;"
NSQ_SOURCE_LINE 00000135 "  }"
NSQ_SOURCE_LINE 00000136 "}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "sub _uric_escape"
NSQ_SOURCE_LINE 00000140 "{"
NSQ_SOURCE_LINE 00000141 "    my($class, $str) = @_;"
NSQ_SOURCE_LINE 00000142 "    $str =~ s*([^$uric\\#])* URI::Escape::escape_char($1) *ego;"
NSQ_SOURCE_LINE 00000143 "    _fix_uric_escape_for_host_part( $str );"
NSQ_SOURCE_LINE 00000144 "    utf8::downgrade($str);"
NSQ_SOURCE_LINE 00000145 "    return $str;"
NSQ_SOURCE_LINE 00000146 "}"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "my %require_attempted;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "sub implementor"
NSQ_SOURCE_LINE 00000151 "{"
NSQ_SOURCE_LINE 00000152 "    my($scheme, $impclass) = @_;"
NSQ_SOURCE_LINE 00000153 "    if (!$scheme || $scheme !~ /\\A$scheme_re\\z/o) {"
NSQ_SOURCE_LINE 00000154 "\trequire URI::_generic;"
NSQ_SOURCE_LINE 00000155 "\treturn \"URI::_generic\";"
NSQ_SOURCE_LINE 00000156 "    }"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    $scheme = lc($scheme);"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "    if ($impclass) {"
NSQ_SOURCE_LINE 00000161 "\t# Set the implementor class for a given scheme"
NSQ_SOURCE_LINE 00000162 "        my $old = $implements{$scheme};"
NSQ_SOURCE_LINE 00000163 "        $impclass->_init_implementor($scheme);"
NSQ_SOURCE_LINE 00000164 "        $implements{$scheme} = $impclass;"
NSQ_SOURCE_LINE 00000165 "        return $old;"
NSQ_SOURCE_LINE 00000166 "    }"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    my $ic = $implements{$scheme};"
NSQ_SOURCE_LINE 00000169 "    return $ic if $ic;"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    # scheme not yet known, look for internal or"
NSQ_SOURCE_LINE 00000172 "    # preloaded (with 'use') implementation"
NSQ_SOURCE_LINE 00000173 "    $ic = \"URI::$scheme\";  # default location"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    # turn scheme into a valid perl identifier by a simple transformation..."
NSQ_SOURCE_LINE 00000176 "    $ic =~ s/\\+/_P/g;"
NSQ_SOURCE_LINE 00000177 "    $ic =~ s/\\./_O/g;"
NSQ_SOURCE_LINE 00000178 "    $ic =~ s/\\-/_/g;"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000181 "    # check we actually have one for the scheme:"
NSQ_SOURCE_LINE 00000182 "    unless (@{\"${ic}::ISA\"}) {"
NSQ_SOURCE_LINE 00000183 "        if (not exists $require_attempted{$ic}) {"
NSQ_SOURCE_LINE 00000184 "            $require_attempted{$ic} = 1;"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "            # Try to load it"
NSQ_SOURCE_LINE 00000187 "            my $_old_error = $@;"
NSQ_SOURCE_LINE 00000188 "            eval \"require $ic\";"
NSQ_SOURCE_LINE 00000189 "            die $@ if $@ && $@ !~ /Can\\'t locate.*in \\@INC/;"
NSQ_SOURCE_LINE 00000190 "            $@ = $_old_error;"
NSQ_SOURCE_LINE 00000191 "        }"
NSQ_SOURCE_LINE 00000192 "        return undef unless @{\"${ic}::ISA\"};"
NSQ_SOURCE_LINE 00000193 "    }"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    $ic->_init_implementor($scheme);"
NSQ_SOURCE_LINE 00000196 "    $implements{$scheme} = $ic;"
NSQ_SOURCE_LINE 00000197 "    $ic;"
NSQ_SOURCE_LINE 00000198 "}"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "sub _init_implementor"
NSQ_SOURCE_LINE 00000202 "{"
NSQ_SOURCE_LINE 00000203 "    my($class, $scheme) = @_;"
NSQ_SOURCE_LINE 00000204 "    # Remember that one implementor class may actually"
NSQ_SOURCE_LINE 00000205 "    # serve to implement several URI schemes."
NSQ_SOURCE_LINE 00000206 "}"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "sub clone"
NSQ_SOURCE_LINE 00000210 "{"
NSQ_SOURCE_LINE 00000211 "    my $self = shift;"
NSQ_SOURCE_LINE 00000212 "    my $other = $$self;"
NSQ_SOURCE_LINE 00000213 "    bless \\$other, ref $self;"
NSQ_SOURCE_LINE 00000214 "}"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "sub TO_JSON { ${$_[0]} }"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "sub _no_scheme_ok { 0 }"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "sub _scheme"
NSQ_SOURCE_LINE 00000221 "{"
NSQ_SOURCE_LINE 00000222 "    my $self = shift;"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "    unless (@_) {"
NSQ_SOURCE_LINE 00000225 "\treturn undef unless $$self =~ /^($scheme_re):/o;"
NSQ_SOURCE_LINE 00000226 "\treturn $1;"
NSQ_SOURCE_LINE 00000227 "    }"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "    my $old;"
NSQ_SOURCE_LINE 00000230 "    my $new = shift;"
NSQ_SOURCE_LINE 00000231 "    if (defined($new) && length($new)) {"
NSQ_SOURCE_LINE 00000232 "\tCarp::croak(\"Bad scheme '$new'\") unless $new =~ /^$scheme_re$/o;"
NSQ_SOURCE_LINE 00000233 "\t$old = $1 if $$self =~ s/^($scheme_re)://o;"
NSQ_SOURCE_LINE 00000234 "\tmy $newself = URI->new(\"$new:$$self\");"
NSQ_SOURCE_LINE 00000235 "\t$$self = $$newself;"
NSQ_SOURCE_LINE 00000236 "\tbless $self, ref($newself);"
NSQ_SOURCE_LINE 00000237 "    }"
NSQ_SOURCE_LINE 00000238 "    else {"
NSQ_SOURCE_LINE 00000239 "\tif ($self->_no_scheme_ok) {"
NSQ_SOURCE_LINE 00000240 "\t    $old = $1 if $$self =~ s/^($scheme_re)://o;"
NSQ_SOURCE_LINE 00000241 "\t    Carp::carp(\"Oops, opaque part now look like scheme\")"
NSQ_SOURCE_LINE 00000242 "\t\tif $^W && $$self =~ m/^$scheme_re:/o"
NSQ_SOURCE_LINE 00000243 "\t}"
NSQ_SOURCE_LINE 00000244 "\telse {"
NSQ_SOURCE_LINE 00000245 "\t    $old = $1 if $$self =~ m/^($scheme_re):/o;"
NSQ_SOURCE_LINE 00000246 "\t}"
NSQ_SOURCE_LINE 00000247 "    }"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "    return $old;"
NSQ_SOURCE_LINE 00000250 "}"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "sub scheme"
NSQ_SOURCE_LINE 00000253 "{"
NSQ_SOURCE_LINE 00000254 "    my $scheme = shift->_scheme(@_);"
NSQ_SOURCE_LINE 00000255 "    return undef unless defined $scheme;"
NSQ_SOURCE_LINE 00000256 "    lc($scheme);"
NSQ_SOURCE_LINE 00000257 "}"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "sub has_recognized_scheme {"
NSQ_SOURCE_LINE 00000260 "    my $self = shift;"
NSQ_SOURCE_LINE 00000261 "    return ref($self) !~ /^URI::_(?:foreign|generic)\\z/;"
NSQ_SOURCE_LINE 00000262 "}"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "sub opaque"
NSQ_SOURCE_LINE 00000265 "{"
NSQ_SOURCE_LINE 00000266 "    my $self = shift;"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "    unless (@_) {"
NSQ_SOURCE_LINE 00000269 "\t$$self =~ /^(?:$scheme_re:)?([^\\#]*)/o or die;"
NSQ_SOURCE_LINE 00000270 "\treturn $1;"
NSQ_SOURCE_LINE 00000271 "    }"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "    $$self =~ /^($scheme_re:)?    # optional scheme"
NSQ_SOURCE_LINE 00000274 "\t        ([^\\#]*)          # opaque"
NSQ_SOURCE_LINE 00000275 "                (\\#.*)?           # optional fragment"
NSQ_SOURCE_LINE 00000276 "              $/sx or die;"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "    my $old_scheme = $1;"
NSQ_SOURCE_LINE 00000279 "    my $old_opaque = $2;"
NSQ_SOURCE_LINE 00000280 "    my $old_frag   = $3;"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "    my $new_opaque = shift;"
NSQ_SOURCE_LINE 00000283 "    $new_opaque = \"\" unless defined $new_opaque;"
NSQ_SOURCE_LINE 00000284 "    $new_opaque =~ s/([^$uric])/ URI::Escape::escape_char($1)/ego;"
NSQ_SOURCE_LINE 00000285 "    utf8::downgrade($new_opaque);"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    $$self = defined($old_scheme) ? $old_scheme : \"\";"
NSQ_SOURCE_LINE 00000288 "    $$self .= $new_opaque;"
NSQ_SOURCE_LINE 00000289 "    $$self .= $old_frag if defined $old_frag;"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "    $old_opaque;"
NSQ_SOURCE_LINE 00000292 "}"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "sub path { goto &opaque }  # alias"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "sub fragment"
NSQ_SOURCE_LINE 00000298 "{"
NSQ_SOURCE_LINE 00000299 "    my $self = shift;"
NSQ_SOURCE_LINE 00000300 "    unless (@_) {"
NSQ_SOURCE_LINE 00000301 "\treturn undef unless $$self =~ /\\#(.*)/s;"
NSQ_SOURCE_LINE 00000302 "\treturn $1;"
NSQ_SOURCE_LINE 00000303 "    }"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "    my $old;"
NSQ_SOURCE_LINE 00000306 "    $old = $1 if $$self =~ s/\\#(.*)//s;"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "    my $new_frag = shift;"
NSQ_SOURCE_LINE 00000309 "    if (defined $new_frag) {"
NSQ_SOURCE_LINE 00000310 "\t$new_frag =~ s/([^$uric])/ URI::Escape::escape_char($1) /ego;"
NSQ_SOURCE_LINE 00000311 "\tutf8::downgrade($new_frag);"
NSQ_SOURCE_LINE 00000312 "\t$$self .= \"#$new_frag\";"
NSQ_SOURCE_LINE 00000313 "    }"
NSQ_SOURCE_LINE 00000314 "    $old;"
NSQ_SOURCE_LINE 00000315 "}"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "sub as_string"
NSQ_SOURCE_LINE 00000319 "{"
NSQ_SOURCE_LINE 00000320 "    my $self = shift;"
NSQ_SOURCE_LINE 00000321 "    $$self;"
NSQ_SOURCE_LINE 00000322 "}"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "sub as_iri"
NSQ_SOURCE_LINE 00000326 "{"
NSQ_SOURCE_LINE 00000327 "    my $self = shift;"
NSQ_SOURCE_LINE 00000328 "    my $str = $$self;"
NSQ_SOURCE_LINE 00000329 "    if ($str =~ s/%([89a-fA-F][0-9a-fA-F])/chr(hex($1))/eg) {"
NSQ_SOURCE_LINE 00000330 "\t# All this crap because the more obvious:"
NSQ_SOURCE_LINE 00000331 "\t#"
NSQ_SOURCE_LINE 00000332 "\t#   Encode::decode(\"UTF-8\", $str, sub { sprintf \"%%%02X\", shift })"
NSQ_SOURCE_LINE 00000333 "\t#"
NSQ_SOURCE_LINE 00000334 "\t# doesn't work before Encode 2.39.  Wait for a standard release"
NSQ_SOURCE_LINE 00000335 "\t# to bundle that version."
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "\trequire Encode;"
NSQ_SOURCE_LINE 00000338 "\tmy $enc = Encode::find_encoding(\"UTF-8\");"
NSQ_SOURCE_LINE 00000339 "\tmy $u = \"\";"
NSQ_SOURCE_LINE 00000340 "\twhile (length $str) {"
NSQ_SOURCE_LINE 00000341 "\t    $u .= $enc->decode($str, Encode::FB_QUIET());"
NSQ_SOURCE_LINE 00000342 "\t    if (length $str) {"
NSQ_SOURCE_LINE 00000343 "\t\t# escape next char"
NSQ_SOURCE_LINE 00000344 "\t\t$u .= URI::Escape::escape_char(substr($str, 0, 1, \"\"));"
NSQ_SOURCE_LINE 00000345 "\t    }"
NSQ_SOURCE_LINE 00000346 "\t}"
NSQ_SOURCE_LINE 00000347 "\t$str = $u;"
NSQ_SOURCE_LINE 00000348 "    }"
NSQ_SOURCE_LINE 00000349 "    return $str;"
NSQ_SOURCE_LINE 00000350 "}"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "sub canonical"
NSQ_SOURCE_LINE 00000354 "{"
NSQ_SOURCE_LINE 00000355 "    # Make sure scheme is lowercased, that we don't escape unreserved chars,"
NSQ_SOURCE_LINE 00000356 "    # and that we use upcase escape sequences."
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "    my $self = shift;"
NSQ_SOURCE_LINE 00000359 "    my $scheme = $self->_scheme || \"\";"
NSQ_SOURCE_LINE 00000360 "    my $uc_scheme = $scheme =~ /[A-Z]/;"
NSQ_SOURCE_LINE 00000361 "    my $esc = $$self =~ /%[a-fA-F0-9]{2}/;"
NSQ_SOURCE_LINE 00000362 "    return $self unless $uc_scheme || $esc;"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "    my $other = $self->clone;"
NSQ_SOURCE_LINE 00000365 "    if ($uc_scheme) {"
NSQ_SOURCE_LINE 00000366 "\t$other->_scheme(lc $scheme);"
NSQ_SOURCE_LINE 00000367 "    }"
NSQ_SOURCE_LINE 00000368 "    if ($esc) {"
NSQ_SOURCE_LINE 00000369 "\t$$other =~ s{%([0-9a-fA-F]{2})}"
NSQ_SOURCE_LINE 00000370 "\t            { my $a = chr(hex($1));"
NSQ_SOURCE_LINE 00000371 "                      $a =~ /^[$unreserved]\\z/o ? $a : \"%\\U$1\""
NSQ_SOURCE_LINE 00000372 "                    }ge;"
NSQ_SOURCE_LINE 00000373 "    }"
NSQ_SOURCE_LINE 00000374 "    return $other;"
NSQ_SOURCE_LINE 00000375 "}"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "# Compare two URIs, subclasses will provide a more correct implementation"
NSQ_SOURCE_LINE 00000378 "sub eq {"
NSQ_SOURCE_LINE 00000379 "    my($self, $other) = @_;"
NSQ_SOURCE_LINE 00000380 "    $self  = URI->new($self, $other) unless ref $self;"
NSQ_SOURCE_LINE 00000381 "    $other = URI->new($other, $self) unless ref $other;"
NSQ_SOURCE_LINE 00000382 "    ref($self) eq ref($other) &&                # same class"
NSQ_SOURCE_LINE 00000383 "\t$self->canonical->as_string eq $other->canonical->as_string;"
NSQ_SOURCE_LINE 00000384 "}"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "# generic-URI transformation methods"
NSQ_SOURCE_LINE 00000387 "sub abs { $_[0]; }"
NSQ_SOURCE_LINE 00000388 "sub rel { $_[0]; }"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "sub secure { 0 }"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "# help out Storable"
NSQ_SOURCE_LINE 00000393 "sub STORABLE_freeze {"
NSQ_SOURCE_LINE 00000394 "       my($self, $cloning) = @_;"
NSQ_SOURCE_LINE 00000395 "       return $$self;"
NSQ_SOURCE_LINE 00000396 "}"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "sub STORABLE_thaw {"
NSQ_SOURCE_LINE 00000399 "       my($self, $cloning, $str) = @_;"
NSQ_SOURCE_LINE 00000400 "       $$self = $str;"
NSQ_SOURCE_LINE 00000401 "}"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "1;"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "__END__"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=head1 NAME"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "URI - Uniform Resource Identifiers (absolute and relative)"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 " use URI ();"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 " $u1 = URI->new(\"http://www.example.com\");"
NSQ_SOURCE_LINE 00000416 " $u2 = URI->new(\"foo\", \"http\");"
NSQ_SOURCE_LINE 00000417 " $u3 = $u2->abs($u1);"
NSQ_SOURCE_LINE 00000418 " $u4 = $u3->clone;"
NSQ_SOURCE_LINE 00000419 " $u5 = URI->new(\"HTTP://WWW.example.com:80\")->canonical;"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 " $str = $u->as_string;"
NSQ_SOURCE_LINE 00000422 " $str = \"$u\";"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 " $scheme = $u->scheme;"
NSQ_SOURCE_LINE 00000425 " $opaque = $u->opaque;"
NSQ_SOURCE_LINE 00000426 " $path   = $u->path;"
NSQ_SOURCE_LINE 00000427 " $frag   = $u->fragment;"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 " $u->scheme(\"ftp\");"
NSQ_SOURCE_LINE 00000430 " $u->host(\"ftp.example.com\");"
NSQ_SOURCE_LINE 00000431 " $u->path(\"cpan/\");"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "This module implements the C<URI> class.  Objects of this class"
NSQ_SOURCE_LINE 00000436 "represent \"Uniform Resource Identifier references\" as specified in RFC"
NSQ_SOURCE_LINE 00000437 "2396 (and updated by RFC 2732)."
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "A Uniform Resource Identifier is a compact string of characters that"
NSQ_SOURCE_LINE 00000440 "identifies an abstract or physical resource.  A Uniform Resource"
NSQ_SOURCE_LINE 00000441 "Identifier can be further classified as either a Uniform Resource Locator"
NSQ_SOURCE_LINE 00000442 "(URL) or a Uniform Resource Name (URN).  The distinction between URL"
NSQ_SOURCE_LINE 00000443 "and URN does not matter to the C<URI> class interface. A"
NSQ_SOURCE_LINE 00000444 "\"URI-reference\" is a URI that may have additional information attached"
NSQ_SOURCE_LINE 00000445 "in the form of a fragment identifier."
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "An absolute URI reference consists of three parts:  a I<scheme>, a"
NSQ_SOURCE_LINE 00000448 "I<scheme-specific part> and a I<fragment> identifier.  A subset of URI"
NSQ_SOURCE_LINE 00000449 "references share a common syntax for hierarchical namespaces.  For"
NSQ_SOURCE_LINE 00000450 "these, the scheme-specific part is further broken down into"
NSQ_SOURCE_LINE 00000451 "I<authority>, I<path> and I<query> components.  These URIs can also"
NSQ_SOURCE_LINE 00000452 "take the form of relative URI references, where the scheme (and"
NSQ_SOURCE_LINE 00000453 "usually also the authority) component is missing, but implied by the"
NSQ_SOURCE_LINE 00000454 "context of the URI reference.  The three forms of URI reference"
NSQ_SOURCE_LINE 00000455 "syntax are summarized as follows:"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "  <scheme>:<scheme-specific-part>#<fragment>"
NSQ_SOURCE_LINE 00000458 "  <scheme>://<authority><path>?<query>#<fragment>"
NSQ_SOURCE_LINE 00000459 "  <path>?<query>#<fragment>"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "The components into which a URI reference can be divided depend on the"
NSQ_SOURCE_LINE 00000462 "I<scheme>.  The C<URI> class provides methods to get and set the"
NSQ_SOURCE_LINE 00000463 "individual components.  The methods available for a specific"
NSQ_SOURCE_LINE 00000464 "C<URI> object depend on the scheme."
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "=head1 CONSTRUCTORS"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "The following methods construct new C<URI> objects:"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "=over 4"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=item $uri = URI->new( $str )"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=item $uri = URI->new( $str, $scheme )"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "Constructs a new URI object.  The string"
NSQ_SOURCE_LINE 00000477 "representation of a URI is given as argument, together with an optional"
NSQ_SOURCE_LINE 00000478 "scheme specification.  Common URI wrappers like \"\" and <>, as well as"
NSQ_SOURCE_LINE 00000479 "leading and trailing white space, are automatically removed from"
NSQ_SOURCE_LINE 00000480 "the $str argument before it is processed further."
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "The constructor determines the scheme, maps this to an appropriate"
NSQ_SOURCE_LINE 00000483 "URI subclass, constructs a new object of that class and returns it."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "If the scheme isn't one of those that URI recognizes, you still get"
NSQ_SOURCE_LINE 00000486 "an URI object back that you can access the generic methods on.  The"
NSQ_SOURCE_LINE 00000487 "C<< $uri->has_recognized_scheme >> method can be used to test for"
NSQ_SOURCE_LINE 00000488 "this."
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "The $scheme argument is only used when $str is a"
NSQ_SOURCE_LINE 00000491 "relative URI.  It can be either a simple string that"
NSQ_SOURCE_LINE 00000492 "denotes the scheme, a string containing an absolute URI reference, or"
NSQ_SOURCE_LINE 00000493 "an absolute C<URI> object.  If no $scheme is specified for a relative"
NSQ_SOURCE_LINE 00000494 "URI $str, then $str is simply treated as a generic URI (no scheme-specific"
NSQ_SOURCE_LINE 00000495 "methods available)."
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "The set of characters available for building URI references is"
NSQ_SOURCE_LINE 00000498 "restricted (see L<URI::Escape>).  Characters outside this set are"
NSQ_SOURCE_LINE 00000499 "automatically escaped by the URI constructor."
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=item $uri = URI->new_abs( $str, $base_uri )"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "Constructs a new absolute URI object.  The $str argument can"
NSQ_SOURCE_LINE 00000504 "denote a relative or absolute URI.  If relative, then it is"
NSQ_SOURCE_LINE 00000505 "absolutized using $base_uri as base. The $base_uri must be an absolute"
NSQ_SOURCE_LINE 00000506 "URI."
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "=item $uri = URI::file->new( $filename )"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "=item $uri = URI::file->new( $filename, $os )"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "Constructs a new I<file> URI from a file name.  See L<URI::file>."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=item $uri = URI::file->new_abs( $filename )"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=item $uri = URI::file->new_abs( $filename, $os )"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "Constructs a new absolute I<file> URI from a file name.  See"
NSQ_SOURCE_LINE 00000519 "L<URI::file>."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "=item $uri = URI::file->cwd"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "Returns the current working directory as a I<file> URI.  See"
NSQ_SOURCE_LINE 00000524 "L<URI::file>."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "=item $uri->clone"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "Returns a copy of the $uri."
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "=back"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "=head1 COMMON METHODS"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "The methods described in this section are available for all C<URI>"
NSQ_SOURCE_LINE 00000535 "objects."
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "Methods that give access to components of a URI always return the"
NSQ_SOURCE_LINE 00000538 "old value of the component.  The value returned is C<undef> if the"
NSQ_SOURCE_LINE 00000539 "component was not present.  There is generally a difference between a"
NSQ_SOURCE_LINE 00000540 "component that is empty (represented as C<\"\">) and a component that is"
NSQ_SOURCE_LINE 00000541 "missing (represented as C<undef>).  If an accessor method is given an"
NSQ_SOURCE_LINE 00000542 "argument, it updates the corresponding component in addition to"
NSQ_SOURCE_LINE 00000543 "returning the old value of the component.  Passing an undefined"
NSQ_SOURCE_LINE 00000544 "argument removes the component (if possible).  The description of"
NSQ_SOURCE_LINE 00000545 "each accessor method indicates whether the component is passed as"
NSQ_SOURCE_LINE 00000546 "an escaped (percent-encoded) or an unescaped string.  A component that can be further"
NSQ_SOURCE_LINE 00000547 "divided into sub-parts are usually passed escaped, as unescaping might"
NSQ_SOURCE_LINE 00000548 "change its semantics."
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "The common methods available for all URI are:"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "=over 4"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "=item $uri->scheme"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "=item $uri->scheme( $new_scheme )"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "Sets and returns the scheme part of the $uri.  If the $uri is"
NSQ_SOURCE_LINE 00000559 "relative, then $uri->scheme returns C<undef>.  If called with an"
NSQ_SOURCE_LINE 00000560 "argument, it updates the scheme of $uri, possibly changing the"
NSQ_SOURCE_LINE 00000561 "class of $uri, and returns the old scheme value.  The method croaks"
NSQ_SOURCE_LINE 00000562 "if the new scheme name is illegal; a scheme name must begin with a"
NSQ_SOURCE_LINE 00000563 "letter and must consist of only US-ASCII letters, numbers, and a few"
NSQ_SOURCE_LINE 00000564 "special marks: \".\", \"+\", \"-\".  This restriction effectively means"
NSQ_SOURCE_LINE 00000565 "that the scheme must be passed unescaped.  Passing an undefined"
NSQ_SOURCE_LINE 00000566 "argument to the scheme method makes the URI relative (if possible)."
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "Letter case does not matter for scheme names.  The string"
NSQ_SOURCE_LINE 00000569 "returned by $uri->scheme is always lowercase.  If you want the scheme"
NSQ_SOURCE_LINE 00000570 "just as it was written in the URI in its original case,"
NSQ_SOURCE_LINE 00000571 "you can use the $uri->_scheme method instead."
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "=item $uri->has_recognized_scheme"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "Returns TRUE if the URI scheme is one that URI recognizes."
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "It will also be TRUE for relative URLs where a recognized"
NSQ_SOURCE_LINE 00000578 "scheme was provided to the constructor, even if C<< $uri->scheme >>"
NSQ_SOURCE_LINE 00000579 "returns C<undef> for these."
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "=item $uri->opaque"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "=item $uri->opaque( $new_opaque )"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "Sets and returns the scheme-specific part of the $uri"
NSQ_SOURCE_LINE 00000586 "(everything between the scheme and the fragment)"
NSQ_SOURCE_LINE 00000587 "as an escaped string."
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "=item $uri->path"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "=item $uri->path( $new_path )"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "Sets and returns the same value as $uri->opaque unless the URI"
NSQ_SOURCE_LINE 00000594 "supports the generic syntax for hierarchical namespaces."
NSQ_SOURCE_LINE 00000595 "In that case the generic method is overridden to set and return"
NSQ_SOURCE_LINE 00000596 "the part of the URI between the I<host name> and the I<fragment>."
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "=item $uri->fragment"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "=item $uri->fragment( $new_frag )"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "Returns the fragment identifier of a URI reference"
NSQ_SOURCE_LINE 00000603 "as an escaped string."
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "=item $uri->as_string"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "Returns a URI object to a plain ASCII string.  URI objects are"
NSQ_SOURCE_LINE 00000608 "also converted to plain strings automatically by overloading.  This"
NSQ_SOURCE_LINE 00000609 "means that $uri objects can be used as plain strings in most Perl"
NSQ_SOURCE_LINE 00000610 "constructs."
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "=item $uri->as_iri"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "Returns a Unicode string representing the URI.  Escaped UTF-8 sequences"
NSQ_SOURCE_LINE 00000615 "representing non-ASCII characters are turned into their corresponding Unicode"
NSQ_SOURCE_LINE 00000616 "code point."
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "=item $uri->canonical"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "Returns a normalized version of the URI.  The rules"
NSQ_SOURCE_LINE 00000621 "for normalization are scheme-dependent.  They usually involve"
NSQ_SOURCE_LINE 00000622 "lowercasing the scheme and Internet host name components,"
NSQ_SOURCE_LINE 00000623 "removing the explicit port specification if it matches the default port,"
NSQ_SOURCE_LINE 00000624 "uppercasing all escape sequences, and unescaping octets that can be"
NSQ_SOURCE_LINE 00000625 "better represented as plain characters."
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "For efficiency reasons, if the $uri is already in normalized form,"
NSQ_SOURCE_LINE 00000628 "then a reference to it is returned instead of a copy."
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "=item $uri->eq( $other_uri )"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "=item URI::eq( $first_uri, $other_uri )"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "Tests whether two URI references are equal.  URI references"
NSQ_SOURCE_LINE 00000635 "that normalize to the same string are considered equal.  The method"
NSQ_SOURCE_LINE 00000636 "can also be used as a plain function which can also test two string"
NSQ_SOURCE_LINE 00000637 "arguments."
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "If you need to test whether two C<URI> object references denote the"
NSQ_SOURCE_LINE 00000640 "same object, use the '==' operator."
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "=item $uri->abs( $base_uri )"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "Returns an absolute URI reference.  If $uri is already"
NSQ_SOURCE_LINE 00000645 "absolute, then a reference to it is simply returned.  If the $uri"
NSQ_SOURCE_LINE 00000646 "is relative, then a new absolute URI is constructed by combining the"
NSQ_SOURCE_LINE 00000647 "$uri and the $base_uri, and returned."
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "=item $uri->rel( $base_uri )"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "Returns a relative URI reference if it is possible to"
NSQ_SOURCE_LINE 00000652 "make one that denotes the same resource relative to $base_uri."
NSQ_SOURCE_LINE 00000653 "If not, then $uri is simply returned."
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "=item $uri->secure"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "Returns a TRUE value if the URI is considered to point to a resource on"
NSQ_SOURCE_LINE 00000658 "a secure channel, such as an SSL or TLS encrypted one."
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "=back"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "=head1 GENERIC METHODS"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "The following methods are available to schemes that use the"
NSQ_SOURCE_LINE 00000665 "common/generic syntax for hierarchical namespaces.  The descriptions of"
NSQ_SOURCE_LINE 00000666 "schemes below indicate which these are.  Unrecognized schemes are"
NSQ_SOURCE_LINE 00000667 "assumed to support the generic syntax, and therefore the following"
NSQ_SOURCE_LINE 00000668 "methods:"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "=over 4"
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "=item $uri->authority"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "=item $uri->authority( $new_authority )"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "Sets and returns the escaped authority component"
NSQ_SOURCE_LINE 00000677 "of the $uri."
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "=item $uri->path"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "=item $uri->path( $new_path )"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "Sets and returns the escaped path component of"
NSQ_SOURCE_LINE 00000684 "the $uri (the part between the host name and the query or fragment)."
NSQ_SOURCE_LINE 00000685 "The path can never be undefined, but it can be the empty string."
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "=item $uri->path_query"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "=item $uri->path_query( $new_path_query )"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "Sets and returns the escaped path and query"
NSQ_SOURCE_LINE 00000692 "components as a single entity.  The path and the query are"
NSQ_SOURCE_LINE 00000693 "separated by a \"?\" character, but the query can itself contain \"?\"."
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "=item $uri->path_segments"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "=item $uri->path_segments( $segment, ... )"
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "Sets and returns the path.  In a scalar context, it returns"
NSQ_SOURCE_LINE 00000700 "the same value as $uri->path.  In a list context, it returns the"
NSQ_SOURCE_LINE 00000701 "unescaped path segments that make up the path.  Path segments that"
NSQ_SOURCE_LINE 00000702 "have parameters are returned as an anonymous array.  The first element"
NSQ_SOURCE_LINE 00000703 "is the unescaped path segment proper;  subsequent elements are escaped"
NSQ_SOURCE_LINE 00000704 "parameter strings.  Such an anonymous array uses overloading so it can"
NSQ_SOURCE_LINE 00000705 "be treated as a string too, but this string does not include the"
NSQ_SOURCE_LINE 00000706 "parameters."
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "Note that absolute paths have the empty string as their first"
NSQ_SOURCE_LINE 00000709 "I<path_segment>, i.e. the I<path> C</foo/bar> have 3"
NSQ_SOURCE_LINE 00000710 "I<path_segments>; \"\", \"foo\" and \"bar\"."
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "=item $uri->query"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "=item $uri->query( $new_query )"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "Sets and returns the escaped query component of"
NSQ_SOURCE_LINE 00000717 "the $uri."
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "=item $uri->query_form"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "=item $uri->query_form( $key1 => $val1, $key2 => $val2, ... )"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "=item $uri->query_form( $key1 => $val1, $key2 => $val2, ..., $delim )"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "=item $uri->query_form( \\@key_value_pairs )"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "=item $uri->query_form( \\@key_value_pairs, $delim )"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "=item $uri->query_form( \\%hash )"
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "=item $uri->query_form( \\%hash, $delim )"
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "Sets and returns query components that use the"
NSQ_SOURCE_LINE 00000734 "I<application/x-www-form-urlencoded> format.  Key/value pairs are"
NSQ_SOURCE_LINE 00000735 "separated by \"&\", and the key is separated from the value by a \"=\""
NSQ_SOURCE_LINE 00000736 "character."
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "The form can be set either by passing separate key/value pairs, or via"
NSQ_SOURCE_LINE 00000739 "an array or hash reference.  Passing an empty array or an empty hash"
NSQ_SOURCE_LINE 00000740 "removes the query component, whereas passing no arguments at all leaves"
NSQ_SOURCE_LINE 00000741 "the component unchanged.  The order of keys is undefined if a hash"
NSQ_SOURCE_LINE 00000742 "reference is passed.  The old value is always returned as a list of"
NSQ_SOURCE_LINE 00000743 "separate key/value pairs.  Assigning this list to a hash is unwise as"
NSQ_SOURCE_LINE 00000744 "the keys returned might repeat."
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "The values passed when setting the form can be plain strings or"
NSQ_SOURCE_LINE 00000747 "references to arrays of strings.  Passing an array of values has the"
NSQ_SOURCE_LINE 00000748 "same effect as passing the key repeatedly with one value at a time."
NSQ_SOURCE_LINE 00000749 "All the following statements have the same effect:"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "    $uri->query_form(foo => 1, foo => 2);"
NSQ_SOURCE_LINE 00000752 "    $uri->query_form(foo => [1, 2]);"
NSQ_SOURCE_LINE 00000753 "    $uri->query_form([ foo => 1, foo => 2 ]);"
NSQ_SOURCE_LINE 00000754 "    $uri->query_form([ foo => [1, 2] ]);"
NSQ_SOURCE_LINE 00000755 "    $uri->query_form({ foo => [1, 2] });"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "The $delim parameter can be passed as \";\" to force the key/value pairs"
NSQ_SOURCE_LINE 00000758 "to be delimited by \";\" instead of \"&\" in the query string.  This"
NSQ_SOURCE_LINE 00000759 "practice is often recommended for URLs embedded in HTML or XML"
NSQ_SOURCE_LINE 00000760 "documents as this avoids the trouble of escaping the \"&\" character."
NSQ_SOURCE_LINE 00000761 "You might also set the $URI::DEFAULT_QUERY_FORM_DELIMITER variable to"
NSQ_SOURCE_LINE 00000762 "\";\" for the same global effect."
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "=item @keys = $u->query_param"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "=item @values = $u->query_param( $key )"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "=item $first_value = $u->query_param( $key )"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "=item $u->query_param( $key, $value,... )"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "If $u->query_param is called with no arguments, it returns all the"
NSQ_SOURCE_LINE 00000773 "distinct parameter keys of the URI.  In a scalar context it returns the"
NSQ_SOURCE_LINE 00000774 "number of distinct keys."
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "When a $key argument is given, the method returns the parameter values with the"
NSQ_SOURCE_LINE 00000777 "given key.  In a scalar context, only the first parameter value is"
NSQ_SOURCE_LINE 00000778 "returned."
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "If additional arguments are given, they are used to update successive"
NSQ_SOURCE_LINE 00000781 "parameters with the given key.  If any of the values provided are"
NSQ_SOURCE_LINE 00000782 "array references, then the array is dereferenced to get the actual"
NSQ_SOURCE_LINE 00000783 "values."
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "Please note that you can supply multiple values to this method, but you cannot"
NSQ_SOURCE_LINE 00000786 "supply multiple keys."
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "Do this:"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "    $uri->query_param( widget_id => 1, 5, 9 );"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "Do NOT do this:"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "    $uri->query_param( widget_id => 1, frobnicator_id => 99 );"
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "=item $u->query_param_append($key, $value,...)"
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 "Adds new parameters with the given"
NSQ_SOURCE_LINE 00000799 "key without touching any old parameters with the same key.  It"
NSQ_SOURCE_LINE 00000800 "can be explained as a more efficient version of:"
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "   $u->query_param($key,"
NSQ_SOURCE_LINE 00000803 "                   $u->query_param($key),"
NSQ_SOURCE_LINE 00000804 "                   $value,...);"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "One difference is that this expression would return the old values"
NSQ_SOURCE_LINE 00000807 "of $key, whereas the query_param_append() method does not."
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "=item @values = $u->query_param_delete($key)"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "=item $first_value = $u->query_param_delete($key)"
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "Deletes all key/value pairs with the given key."
NSQ_SOURCE_LINE 00000814 "The old values are returned.  In a scalar context, only the first value"
NSQ_SOURCE_LINE 00000815 "is returned."
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "Using the query_param_delete() method is slightly more efficient than"
NSQ_SOURCE_LINE 00000818 "the equivalent:"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "   $u->query_param($key, []);"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "=item $hashref = $u->query_form_hash"
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "=item $u->query_form_hash( \\%new_form )"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "Returns a reference to a hash that represents the"
NSQ_SOURCE_LINE 00000827 "query form's key/value pairs.  If a key occurs multiple times, then the hash"
NSQ_SOURCE_LINE 00000828 "value becomes an array reference."
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "Note that sequence information is lost.  This means that:"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "   $u->query_form_hash($u->query_form_hash);"
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "is not necessarily a no-op, as it may reorder the key/value pairs."
NSQ_SOURCE_LINE 00000835 "The values returned by the query_param() method should stay the same"
NSQ_SOURCE_LINE 00000836 "though."
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "=item $uri->query_keywords"
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "=item $uri->query_keywords( $keywords, ... )"
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "=item $uri->query_keywords( \\@keywords )"
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "Sets and returns query components that use the"
NSQ_SOURCE_LINE 00000845 "keywords separated by \"+\" format."
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "The keywords can be set either by passing separate keywords directly"
NSQ_SOURCE_LINE 00000848 "or by passing a reference to an array of keywords.  Passing an empty"
NSQ_SOURCE_LINE 00000849 "array removes the query component, whereas passing no arguments at"
NSQ_SOURCE_LINE 00000850 "all leaves the component unchanged.  The old value is always returned"
NSQ_SOURCE_LINE 00000851 "as a list of separate words."
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "=back"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "=head1 SERVER METHODS"
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "For schemes where the I<authority> component denotes an Internet host,"
NSQ_SOURCE_LINE 00000858 "the following methods are available in addition to the generic"
NSQ_SOURCE_LINE 00000859 "methods."
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "=over 4"
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "=item $uri->userinfo"
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "=item $uri->userinfo( $new_userinfo )"
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 "Sets and returns the escaped userinfo part of the"
NSQ_SOURCE_LINE 00000868 "authority component."
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "For some schemes this is a user name and a password separated by"
NSQ_SOURCE_LINE 00000871 "a colon.  This practice is not recommended. Embedding passwords in"
NSQ_SOURCE_LINE 00000872 "clear text (such as URI) has proven to be a security risk in almost"
NSQ_SOURCE_LINE 00000873 "every case where it has been used."
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "=item $uri->host"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "=item $uri->host( $new_host )"
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 "Sets and returns the unescaped hostname."
NSQ_SOURCE_LINE 00000880 ""
NSQ_SOURCE_LINE 00000881 "If the C<$new_host> string ends with a colon and a number, then this"
NSQ_SOURCE_LINE 00000882 "number also sets the port."
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "For IPv6 addresses the brackets around the raw address is removed in the return"
NSQ_SOURCE_LINE 00000885 "value from $uri->host.  When setting the host attribute to an IPv6 address you"
NSQ_SOURCE_LINE 00000886 "can use a raw address or one enclosed in brackets.  The address needs to be"
NSQ_SOURCE_LINE 00000887 "enclosed in brackets if you want to pass in a new port value as well."
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "  my $uri = URI->new(\"http://www.\\xC3\\xBCri-sample/foo/bar.html\");"
NSQ_SOURCE_LINE 00000890 "  print $u->host; # www.xn--ri-sample-fra0f"
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "=item $uri->ihost"
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "Returns the host in Unicode form. Any IDNA A-labels (encoded unicode chars with"
NSQ_SOURCE_LINE 00000896 "I<xn--> prefix) are turned into U-labels (unicode chars)."
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "  my $uri = URI->new(\"http://www.\\xC3\\xBCri-sample/foo/bar.html\");"
NSQ_SOURCE_LINE 00000899 "  print $u->ihost; # www.\\xC3\\xBCri-sample"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "=item $uri->port"
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "=item $uri->port( $new_port )"
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "Sets and returns the port.  The port is a simple integer"
NSQ_SOURCE_LINE 00000906 "that should be greater than 0."
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "If a port is not specified explicitly in the URI, then the URI scheme's default port"
NSQ_SOURCE_LINE 00000909 "is returned. If you don't want the default port"
NSQ_SOURCE_LINE 00000910 "substituted, then you can use the $uri->_port method instead."
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "=item $uri->host_port"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "=item $uri->host_port( $new_host_port )"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "Sets and returns the host and port as a single"
NSQ_SOURCE_LINE 00000917 "unit.  The returned value includes a port, even if it matches the"
NSQ_SOURCE_LINE 00000918 "default port.  The host part and the port part are separated by a"
NSQ_SOURCE_LINE 00000919 "colon: \":\"."
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "For IPv6 addresses the bracketing is preserved; thus"
NSQ_SOURCE_LINE 00000922 "URI->new(\"http://[::1]/\")->host_port returns \"[::1]:80\".  Contrast this with"
NSQ_SOURCE_LINE 00000923 "$uri->host which will remove the brackets."
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "=item $uri->default_port"
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "Returns the default port of the URI scheme to which $uri"
NSQ_SOURCE_LINE 00000928 "belongs.  For I<http> this is the number 80, for I<ftp> this"
NSQ_SOURCE_LINE 00000929 "is the number 21, etc.  The default port for a scheme can not be"
NSQ_SOURCE_LINE 00000930 "changed."
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "=back"
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "=head1 SCHEME-SPECIFIC SUPPORT"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "Scheme-specific support is provided for the following URI schemes.  For C<URI>"
NSQ_SOURCE_LINE 00000937 "objects that do not belong to one of these, you can only use the common and"
NSQ_SOURCE_LINE 00000938 "generic methods."
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "=over 4"
NSQ_SOURCE_LINE 00000941 ""
NSQ_SOURCE_LINE 00000942 "=item B<data>:"
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "The I<data> URI scheme is specified in RFC 2397.  It allows inclusion"
NSQ_SOURCE_LINE 00000945 "of small data items as \"immediate\" data, as if it had been included"
NSQ_SOURCE_LINE 00000946 "externally."
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "C<URI> objects belonging to the data scheme support the common methods"
NSQ_SOURCE_LINE 00000949 "and two new methods to access their scheme-specific components:"
NSQ_SOURCE_LINE 00000950 "$uri->media_type and $uri->data.  See L<URI::data> for details."
NSQ_SOURCE_LINE 00000951 ""
NSQ_SOURCE_LINE 00000952 "=item B<file>:"
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "An old specification of the I<file> URI scheme is found in RFC 1738."
NSQ_SOURCE_LINE 00000955 "A new RFC 2396 based specification in not available yet, but file URI"
NSQ_SOURCE_LINE 00000956 "references are in common use."
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "C<URI> objects belonging to the file scheme support the common and"
NSQ_SOURCE_LINE 00000959 "generic methods.  In addition, they provide two methods for mapping file URIs"
NSQ_SOURCE_LINE 00000960 "back to local file names; $uri->file and $uri->dir.  See L<URI::file>"
NSQ_SOURCE_LINE 00000961 "for details."
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "=item B<ftp>:"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "An old specification of the I<ftp> URI scheme is found in RFC 1738.  A"
NSQ_SOURCE_LINE 00000966 "new RFC 2396 based specification in not available yet, but ftp URI"
NSQ_SOURCE_LINE 00000967 "references are in common use."
NSQ_SOURCE_LINE 00000968 ""
NSQ_SOURCE_LINE 00000969 "C<URI> objects belonging to the ftp scheme support the common,"
NSQ_SOURCE_LINE 00000970 "generic and server methods.  In addition, they provide two methods for"
NSQ_SOURCE_LINE 00000971 "accessing the userinfo sub-components: $uri->user and $uri->password."
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "It also supports accessing to the encryption mode ($uri->encrypt_mode),"
NSQ_SOURCE_LINE 00000974 "which has its own defaults for I<ftps> and I<ftpes> URI schemes."
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "=item B<gopher>:"
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 "The I<gopher> URI scheme is specified in"
NSQ_SOURCE_LINE 00000979 "C<draft-murali-url-gopher-1996-12-04> and will hopefully be available"
NSQ_SOURCE_LINE 00000980 "as a RFC 2396 based specification."
NSQ_SOURCE_LINE 00000981 ""
NSQ_SOURCE_LINE 00000982 "C<URI> objects belonging to the gopher scheme support the common,"
NSQ_SOURCE_LINE 00000983 "generic and server methods. In addition, they support some methods for"
NSQ_SOURCE_LINE 00000984 "accessing gopher-specific path components: $uri->gopher_type,"
NSQ_SOURCE_LINE 00000985 "$uri->selector, $uri->search, $uri->string."
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "=item B<http>:"
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "The I<http> URI scheme is specified in RFC 2616."
NSQ_SOURCE_LINE 00000990 "The scheme is used to reference resources hosted by HTTP servers."
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "C<URI> objects belonging to the http scheme support the common,"
NSQ_SOURCE_LINE 00000993 "generic and server methods."
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "=item B<https>:"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "The I<https> URI scheme is a Netscape invention which is commonly"
NSQ_SOURCE_LINE 00000998 "implemented.  The scheme is used to reference HTTP servers through SSL"
NSQ_SOURCE_LINE 00000999 "connections.  Its syntax is the same as http, but the default"
NSQ_SOURCE_LINE 00001000 "port is different."
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "=item B<geo>:"
NSQ_SOURCE_LINE 00001003 ""
NSQ_SOURCE_LINE 00001004 "The I<geo> URI scheme is specified in L<RFC 5870|http://tools.ietf.org/html/rfc5870>."
NSQ_SOURCE_LINE 00001005 "The scheme is used to reference physical location in a two- or"
NSQ_SOURCE_LINE 00001006 "three-dimensional coordinate reference system in a compact, simple,"
NSQ_SOURCE_LINE 00001007 "human-readable, and protocol-independent way."
NSQ_SOURCE_LINE 00001008 ""
NSQ_SOURCE_LINE 00001009 "C<URI> objects belonging to the geo scheme support the common methods."
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "=item B<icap>:"
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "The I<icap> URI scheme is specified in L<RFC 3507|http://tools.ietf.org/html/rfc3507>."
NSQ_SOURCE_LINE 00001014 "The scheme is used to reference resources hosted by ICAP servers."
NSQ_SOURCE_LINE 00001015 ""
NSQ_SOURCE_LINE 00001016 "C<URI> objects belonging to the icap scheme support the common,"
NSQ_SOURCE_LINE 00001017 "generic and server methods."
NSQ_SOURCE_LINE 00001018 ""
NSQ_SOURCE_LINE 00001019 "=item B<icaps>:"
NSQ_SOURCE_LINE 00001020 ""
NSQ_SOURCE_LINE 00001021 "The I<icaps> URI scheme is specified in L<RFC 3507|http://tools.ietf.org/html/rfc3507> as well."
NSQ_SOURCE_LINE 00001022 "The scheme is used to reference ICAP servers through SSL"
NSQ_SOURCE_LINE 00001023 "connections.  Its syntax is the same as icap, including the same"
NSQ_SOURCE_LINE 00001024 "default port."
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "=item B<irc>:"
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "The I<irc> URI scheme is specified in L<draft-butcher-irc-url-04|https://datatracker.ietf.org/doc/html/draft-butcher-irc-url-04>."
NSQ_SOURCE_LINE 00001029 "The scheme is used to reference IRC servers and their resources."
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "C<URI> objects belonging to the irc or ircs scheme support login"
NSQ_SOURCE_LINE 00001032 "methods, and the following IRC-specific ones: $uri->entity,"
NSQ_SOURCE_LINE 00001033 "$uri->flags, $uri->options."
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 "=item B<ldap>:"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "The I<ldap> URI scheme is specified in RFC 2255.  LDAP is the"
NSQ_SOURCE_LINE 00001038 "Lightweight Directory Access Protocol.  An ldap URI describes an LDAP"
NSQ_SOURCE_LINE 00001039 "search operation to perform to retrieve information from an LDAP"
NSQ_SOURCE_LINE 00001040 "directory."
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "C<URI> objects belonging to the ldap scheme support the common,"
NSQ_SOURCE_LINE 00001043 "generic and server methods as well as ldap-specific methods: $uri->dn,"
NSQ_SOURCE_LINE 00001044 "$uri->attributes, $uri->scope, $uri->filter, $uri->extensions.  See"
NSQ_SOURCE_LINE 00001045 "L<URI::ldap> for details."
NSQ_SOURCE_LINE 00001046 ""
NSQ_SOURCE_LINE 00001047 "=item B<ldapi>:"
NSQ_SOURCE_LINE 00001048 ""
NSQ_SOURCE_LINE 00001049 "Like the I<ldap> URI scheme, but uses a UNIX domain socket.  The"
NSQ_SOURCE_LINE 00001050 "server methods are not supported, and the local socket path is"
NSQ_SOURCE_LINE 00001051 "available as $uri->un_path.  The I<ldapi> scheme is used by the"
NSQ_SOURCE_LINE 00001052 "OpenLDAP package.  There is no real specification for it, but it is"
NSQ_SOURCE_LINE 00001053 "mentioned in various OpenLDAP manual pages."
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 "=item B<ldaps>:"
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "Like the I<ldap> URI scheme, but uses an SSL connection.  This"
NSQ_SOURCE_LINE 00001058 "scheme is deprecated, as the preferred way is to use the I<start_tls>"
NSQ_SOURCE_LINE 00001059 "mechanism."
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "=item B<mailto>:"
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "The I<mailto> URI scheme is specified in RFC 2368.  The scheme was"
NSQ_SOURCE_LINE 00001064 "originally used to designate the Internet mailing address of an"
NSQ_SOURCE_LINE 00001065 "individual or service.  It has (in RFC 2368) been extended to allow"
NSQ_SOURCE_LINE 00001066 "setting of other mail header fields and the message body."
NSQ_SOURCE_LINE 00001067 ""
NSQ_SOURCE_LINE 00001068 "C<URI> objects belonging to the mailto scheme support the common"
NSQ_SOURCE_LINE 00001069 "methods and the generic query methods.  In addition, they support the"
NSQ_SOURCE_LINE 00001070 "following mailto-specific methods: $uri->to, $uri->headers."
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "Note that the \"foo@example.com\" part of a mailto is I<not> the"
NSQ_SOURCE_LINE 00001073 "C<userinfo> and C<host> but instead the C<path>.  This allows a"
NSQ_SOURCE_LINE 00001074 "mailto URI to contain multiple comma separated email addresses."
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 "=item B<mms>:"
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 "The I<mms> URL specification can be found at L<http://sdp.ppona.com/>."
NSQ_SOURCE_LINE 00001079 "C<URI> objects belonging to the mms scheme support the common,"
NSQ_SOURCE_LINE 00001080 "generic, and server methods, with the exception of userinfo and"
NSQ_SOURCE_LINE 00001081 "query-related sub-components."
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "=item B<news>:"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "The I<news>, I<nntp> and I<snews> URI schemes are specified in"
NSQ_SOURCE_LINE 00001086 "<draft-gilman-news-url-01> and will hopefully be available as an RFC"
NSQ_SOURCE_LINE 00001087 "2396 based specification soon. (Update: as of April 2010, they are in"
NSQ_SOURCE_LINE 00001088 "L<RFC 5538|https://tools.ietf.org/html/rfc5538>."
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "C<URI> objects belonging to the news scheme support the common,"
NSQ_SOURCE_LINE 00001091 "generic and server methods.  In addition, they provide some methods to"
NSQ_SOURCE_LINE 00001092 "access the path: $uri->group and $uri->message."
NSQ_SOURCE_LINE 00001093 ""
NSQ_SOURCE_LINE 00001094 "=item B<nntp>:"
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 "See I<news> scheme."
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "=item B<nntps>:"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "See I<news> scheme and L<RFC 5538|https://tools.ietf.org/html/rfc5538>."
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "=item B<otpauth>:"
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 "The I<otpauth> URI scheme is specified in L<https://github.com/google/google-authenticator/wiki/Key-Uri-Format>."
NSQ_SOURCE_LINE 00001105 "The scheme is used to encode secret keys for use in TOTP or HOTP schemes."
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 "C<URI> objects belonging to the otpauth scheme support the common methods."
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "=item B<pop>:"
NSQ_SOURCE_LINE 00001110 ""
NSQ_SOURCE_LINE 00001111 "The I<pop> URI scheme is specified in RFC 2384. The scheme is used to"
NSQ_SOURCE_LINE 00001112 "reference a POP3 mailbox."
NSQ_SOURCE_LINE 00001113 ""
NSQ_SOURCE_LINE 00001114 "C<URI> objects belonging to the pop scheme support the common, generic"
NSQ_SOURCE_LINE 00001115 "and server methods, as well as two email authorization methods:"
NSQ_SOURCE_LINE 00001116 "C<user> and C<auth>."
NSQ_SOURCE_LINE 00001117 ""
NSQ_SOURCE_LINE 00001118 "=item B<rlogin>:"
NSQ_SOURCE_LINE 00001119 ""
NSQ_SOURCE_LINE 00001120 "An old specification of the I<rlogin> URI scheme is found in RFC"
NSQ_SOURCE_LINE 00001121 "1738. C<URI> objects belonging to the rlogin scheme support the"
NSQ_SOURCE_LINE 00001122 "common, generic and server methods."
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 "=item B<rtsp>:"
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "The I<rtsp> URL specification can be found in section 3.2 of RFC 2326."
NSQ_SOURCE_LINE 00001127 "C<URI> objects belonging to the rtsp scheme support the common,"
NSQ_SOURCE_LINE 00001128 "generic, and server methods, with the exception of userinfo and"
NSQ_SOURCE_LINE 00001129 "query-related sub-components."
NSQ_SOURCE_LINE 00001130 ""
NSQ_SOURCE_LINE 00001131 "=item B<rtspu>:"
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "The I<rtspu> URI scheme is used to talk to RTSP servers over UDP"
NSQ_SOURCE_LINE 00001134 "instead of TCP.  The syntax is the same as rtsp."
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 "=item B<rsync>:"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "Information about rsync is available from L<http://rsync.samba.org/>."
NSQ_SOURCE_LINE 00001139 "C<URI> objects belonging to the rsync scheme support the common,"
NSQ_SOURCE_LINE 00001140 "generic and server methods.  In addition, they provide methods to"
NSQ_SOURCE_LINE 00001141 "access the userinfo sub-components: $uri->user and $uri->password."
NSQ_SOURCE_LINE 00001142 ""
NSQ_SOURCE_LINE 00001143 "=item B<sip>:"
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "The I<sip> URI specification is described in sections 19.1 and 25"
NSQ_SOURCE_LINE 00001146 "of RFC 3261.  C<URI> objects belonging to the sip scheme support the"
NSQ_SOURCE_LINE 00001147 "common, generic, and server methods with the exception of path related"
NSQ_SOURCE_LINE 00001148 "sub-components.  In addition, they provide two methods to get and set"
NSQ_SOURCE_LINE 00001149 "I<sip> parameters: $uri->params_form and $uri->params."
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "=item B<sips>:"
NSQ_SOURCE_LINE 00001152 ""
NSQ_SOURCE_LINE 00001153 "See I<sip> scheme.  Its syntax is the same as sip, but the default"
NSQ_SOURCE_LINE 00001154 "port is different."
NSQ_SOURCE_LINE 00001155 ""
NSQ_SOURCE_LINE 00001156 "=item B<smb>:"
NSQ_SOURCE_LINE 00001157 ""
NSQ_SOURCE_LINE 00001158 "C<URI> objects belonging to the smb scheme support the common,"
NSQ_SOURCE_LINE 00001159 "generic and server methods. In addition, they provide methods to"
NSQ_SOURCE_LINE 00001160 "access the userinfo sub-components ($uri->user and $uri->password)"
NSQ_SOURCE_LINE 00001161 "as well as $uri->authdomain and $uri->sharename methods."
NSQ_SOURCE_LINE 00001162 ""
NSQ_SOURCE_LINE 00001163 "=item B<smtp>:"
NSQ_SOURCE_LINE 00001164 ""
NSQ_SOURCE_LINE 00001165 "The I<smtp> URI scheme is specified in L<draft-earhart-url-smtp-00|https://datatracker.ietf.org/doc/html/draft-earhart-url-smtp-00>."
NSQ_SOURCE_LINE 00001166 "The scheme is used to reference a SMTP server."
NSQ_SOURCE_LINE 00001167 ""
NSQ_SOURCE_LINE 00001168 "C<URI> objects belonging to the smtp scheme support the common, generic"
NSQ_SOURCE_LINE 00001169 "and server methods, as well as two email authorization methods:"
NSQ_SOURCE_LINE 00001170 "C<user> and C<auth>."
NSQ_SOURCE_LINE 00001171 ""
NSQ_SOURCE_LINE 00001172 "=item B<snews>:"
NSQ_SOURCE_LINE 00001173 ""
NSQ_SOURCE_LINE 00001174 "See I<news> scheme.  Its syntax is the same as news, but the default"
NSQ_SOURCE_LINE 00001175 "port is different."
NSQ_SOURCE_LINE 00001176 ""
NSQ_SOURCE_LINE 00001177 "=item B<telnet>:"
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "An old specification of the I<telnet> URI scheme is found in RFC"
NSQ_SOURCE_LINE 00001180 "1738. C<URI> objects belonging to the telnet scheme support the"
NSQ_SOURCE_LINE 00001181 "common, generic and server methods."
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "=item B<tn3270>:"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "These URIs are used like I<telnet> URIs but for connections to IBM"
NSQ_SOURCE_LINE 00001186 "mainframes.  C<URI> objects belonging to the tn3270 scheme support the"
NSQ_SOURCE_LINE 00001187 "common, generic and server methods."
NSQ_SOURCE_LINE 00001188 ""
NSQ_SOURCE_LINE 00001189 "=item B<ssh>:"
NSQ_SOURCE_LINE 00001190 ""
NSQ_SOURCE_LINE 00001191 "Information about ssh is available at L<http://www.openssh.com/>."
NSQ_SOURCE_LINE 00001192 "C<URI> objects belonging to the ssh scheme support the common,"
NSQ_SOURCE_LINE 00001193 "generic and server methods. In addition, they provide methods to"
NSQ_SOURCE_LINE 00001194 "access the userinfo sub-components: $uri->user and $uri->password."
NSQ_SOURCE_LINE 00001195 ""
NSQ_SOURCE_LINE 00001196 "=item B<sftp>:"
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "C<URI> objects belonging to the sftp scheme support the common,"
NSQ_SOURCE_LINE 00001199 "generic and server methods. In addition, they provide methods to"
NSQ_SOURCE_LINE 00001200 "access the userinfo sub-components: $uri->user and $uri->password."
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "=item B<urn>:"
NSQ_SOURCE_LINE 00001203 ""
NSQ_SOURCE_LINE 00001204 "The syntax of Uniform Resource Names is specified in RFC 2141.  C<URI>"
NSQ_SOURCE_LINE 00001205 "objects belonging to the urn scheme provide the common methods, and also the"
NSQ_SOURCE_LINE 00001206 "methods $uri->nid and $uri->nss, which return the Namespace Identifier"
NSQ_SOURCE_LINE 00001207 "and the Namespace-Specific String respectively."
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 "The Namespace Identifier basically works like the Scheme identifier of"
NSQ_SOURCE_LINE 00001210 "URIs, and further divides the URN namespace.  Namespace Identifier"
NSQ_SOURCE_LINE 00001211 "assignments are maintained at"
NSQ_SOURCE_LINE 00001212 "L<http://www.iana.org/assignments/urn-namespaces>."
NSQ_SOURCE_LINE 00001213 ""
NSQ_SOURCE_LINE 00001214 "Letter case is not significant for the Namespace Identifier.  It is"
NSQ_SOURCE_LINE 00001215 "always returned in lower case by the $uri->nid method.  The $uri->_nid"
NSQ_SOURCE_LINE 00001216 "method can be used if you want it in its original case."
NSQ_SOURCE_LINE 00001217 ""
NSQ_SOURCE_LINE 00001218 "=item B<urn>:B<isbn>:"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "The C<urn:isbn:> namespace contains International Standard Book"
NSQ_SOURCE_LINE 00001221 "Numbers (ISBNs) and is described in RFC 3187.  A C<URI> object belonging"
NSQ_SOURCE_LINE 00001222 "to this namespace has the following extra methods (if the"
NSQ_SOURCE_LINE 00001223 "Business::ISBN module is available): $uri->isbn,"
NSQ_SOURCE_LINE 00001224 "$uri->isbn_publisher_code, $uri->isbn_group_code (formerly isbn_country_code,"
NSQ_SOURCE_LINE 00001225 "which is still supported by issues a deprecation warning), $uri->isbn_as_ean."
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "=item B<urn>:B<oid>:"
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 "The C<urn:oid:> namespace contains Object Identifiers (OIDs) and is"
NSQ_SOURCE_LINE 00001230 "described in RFC 3061.  An object identifier consists of sequences of digits"
NSQ_SOURCE_LINE 00001231 "separated by dots.  A C<URI> object belonging to this namespace has an"
NSQ_SOURCE_LINE 00001232 "additional method called $uri->oid that can be used to get/set the oid"
NSQ_SOURCE_LINE 00001233 "value.  In a list context, oid numbers are returned as separate elements."
NSQ_SOURCE_LINE 00001234 ""
NSQ_SOURCE_LINE 00001235 "=item B<ws>:"
NSQ_SOURCE_LINE 00001236 ""
NSQ_SOURCE_LINE 00001237 "The <ws> URI scheme is specified in L<RFC 6455|http://tools.ietf.org/html/rfc6455>."
NSQ_SOURCE_LINE 00001238 "The C<WebSocket> Protocol enables two-way communication between a client"
NSQ_SOURCE_LINE 00001239 "running untrusted code in a controlled environment to a remote host"
NSQ_SOURCE_LINE 00001240 "that has opted-in to communications from that code."
NSQ_SOURCE_LINE 00001241 ""
NSQ_SOURCE_LINE 00001242 "=item B<wss>:"
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "The I<wss> URI scheme is specified in L<RFC 6455|http://tools.ietf.org/html/rfc6455> as well."
NSQ_SOURCE_LINE 00001245 "The scheme is used to reference C<WebSocket> servers through SSL connections."
NSQ_SOURCE_LINE 00001246 ""
NSQ_SOURCE_LINE 00001247 "=back"
NSQ_SOURCE_LINE 00001248 ""
NSQ_SOURCE_LINE 00001249 "=head1 CONFIGURATION VARIABLES"
NSQ_SOURCE_LINE 00001250 ""
NSQ_SOURCE_LINE 00001251 "The following configuration variables influence how the class and its"
NSQ_SOURCE_LINE 00001252 "methods behave:"
NSQ_SOURCE_LINE 00001253 ""
NSQ_SOURCE_LINE 00001254 "=over 4"
NSQ_SOURCE_LINE 00001255 ""
NSQ_SOURCE_LINE 00001256 "=item $URI::ABS_ALLOW_RELATIVE_SCHEME"
NSQ_SOURCE_LINE 00001257 ""
NSQ_SOURCE_LINE 00001258 "Some older parsers used to allow the scheme name to be present in the"
NSQ_SOURCE_LINE 00001259 "relative URL if it was the same as the base URL scheme.  RFC 2396 says"
NSQ_SOURCE_LINE 00001260 "that this should be avoided, but you can enable this old behaviour by"
NSQ_SOURCE_LINE 00001261 "setting the $URI::ABS_ALLOW_RELATIVE_SCHEME variable to a TRUE value."
NSQ_SOURCE_LINE 00001262 "The difference is demonstrated by the following examples:"
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "  URI->new(\"http:foo\")->abs(\"http://host/a/b\")"
NSQ_SOURCE_LINE 00001265 "      ==>  \"http:foo\""
NSQ_SOURCE_LINE 00001266 ""
NSQ_SOURCE_LINE 00001267 "  local $URI::ABS_ALLOW_RELATIVE_SCHEME = 1;"
NSQ_SOURCE_LINE 00001268 "  URI->new(\"http:foo\")->abs(\"http://host/a/b\")"
NSQ_SOURCE_LINE 00001269 "      ==>  \"http:/host/a/foo\""
NSQ_SOURCE_LINE 00001270 ""
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 "=item $URI::ABS_REMOTE_LEADING_DOTS"
NSQ_SOURCE_LINE 00001273 ""
NSQ_SOURCE_LINE 00001274 "You can also have the abs() method ignore excess \"..\""
NSQ_SOURCE_LINE 00001275 "segments in the relative URI by setting $URI::ABS_REMOTE_LEADING_DOTS"
NSQ_SOURCE_LINE 00001276 "to a TRUE value.  The difference is demonstrated by the following"
NSQ_SOURCE_LINE 00001277 "examples:"
NSQ_SOURCE_LINE 00001278 ""
NSQ_SOURCE_LINE 00001279 "  URI->new(\"../../../foo\")->abs(\"http://host/a/b\")"
NSQ_SOURCE_LINE 00001280 "      ==> \"http://host/../../foo\""
NSQ_SOURCE_LINE 00001281 ""
NSQ_SOURCE_LINE 00001282 "  local $URI::ABS_REMOTE_LEADING_DOTS = 1;"
NSQ_SOURCE_LINE 00001283 "  URI->new(\"../../../foo\")->abs(\"http://host/a/b\")"
NSQ_SOURCE_LINE 00001284 "      ==> \"http://host/foo\""
NSQ_SOURCE_LINE 00001285 ""
NSQ_SOURCE_LINE 00001286 "=item $URI::DEFAULT_QUERY_FORM_DELIMITER"
NSQ_SOURCE_LINE 00001287 ""
NSQ_SOURCE_LINE 00001288 "This value can be set to \";\" to have the query form C<key=value> pairs"
NSQ_SOURCE_LINE 00001289 "delimited by \";\" instead of \"&\" which is the default."
NSQ_SOURCE_LINE 00001290 ""
NSQ_SOURCE_LINE 00001291 "=back"
NSQ_SOURCE_LINE 00001292 ""
NSQ_SOURCE_LINE 00001293 "=head1 ENVIRONMENT VARIABLES"
NSQ_SOURCE_LINE 00001294 ""
NSQ_SOURCE_LINE 00001295 "=over 4"
NSQ_SOURCE_LINE 00001296 ""
NSQ_SOURCE_LINE 00001297 "=item URI_HAS_RESERVED_SQUARE_BRACKETS"
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "Before version 5.11, URI treated square brackets as reserved characters"
NSQ_SOURCE_LINE 00001300 "throughout the whole URI string. However, these brackets are reserved"
NSQ_SOURCE_LINE 00001301 "only within the authority/host part of the URI and nowhere else (RFC 3986)."
NSQ_SOURCE_LINE 00001302 ""
NSQ_SOURCE_LINE 00001303 "Starting with version 5.11, URI takes this distinction into account."
NSQ_SOURCE_LINE 00001304 "Setting the environment variable C<URI_HAS_RESERVED_SQUARE_BRACKETS>"
NSQ_SOURCE_LINE 00001305 "(programmatically or via the shell), restores the old behavior."
NSQ_SOURCE_LINE 00001306 ""
NSQ_SOURCE_LINE 00001307 "  #-- restore 5.10 behavior programmatically"
NSQ_SOURCE_LINE 00001308 "  BEGIN {"
NSQ_SOURCE_LINE 00001309 "    $ENV{URI_HAS_RESERVED_SQUARE_BRACKETS} = 1;"
NSQ_SOURCE_LINE 00001310 "  }"
NSQ_SOURCE_LINE 00001311 "  use URI ();"
NSQ_SOURCE_LINE 00001312 ""
NSQ_SOURCE_LINE 00001313 "I<Note>: This environment variable is just used during initialization and has to be set"
NSQ_SOURCE_LINE 00001314 "      I<before> module URI is used/required. Changing it at run time has no effect."
NSQ_SOURCE_LINE 00001315 ""
NSQ_SOURCE_LINE 00001316 "Its value can be checked programmatically by accessing the constant"
NSQ_SOURCE_LINE 00001317 "C<URI::HAS_RESERVED_SQUARE_BRACKETS>."
NSQ_SOURCE_LINE 00001318 ""
NSQ_SOURCE_LINE 00001319 "=back"
NSQ_SOURCE_LINE 00001320 ""
NSQ_SOURCE_LINE 00001321 "=head1 BUGS"
NSQ_SOURCE_LINE 00001322 ""
NSQ_SOURCE_LINE 00001323 "There are some things that are not quite right:"
NSQ_SOURCE_LINE 00001324 ""
NSQ_SOURCE_LINE 00001325 "=over"
NSQ_SOURCE_LINE 00001326 ""
NSQ_SOURCE_LINE 00001327 "=item *"
NSQ_SOURCE_LINE 00001328 ""
NSQ_SOURCE_LINE 00001329 "Using regexp variables like $1 directly as arguments to the URI accessor methods"
NSQ_SOURCE_LINE 00001330 "does not work too well with current perl implementations.  I would argue"
NSQ_SOURCE_LINE 00001331 "that this is actually a bug in perl.  The workaround is to quote"
NSQ_SOURCE_LINE 00001332 "them. Example:"
NSQ_SOURCE_LINE 00001333 ""
NSQ_SOURCE_LINE 00001334 "   /(...)/ || die;"
NSQ_SOURCE_LINE 00001335 "   $u->query(\"$1\");"
NSQ_SOURCE_LINE 00001336 ""
NSQ_SOURCE_LINE 00001337 ""
NSQ_SOURCE_LINE 00001338 "=item *"
NSQ_SOURCE_LINE 00001339 ""
NSQ_SOURCE_LINE 00001340 "The escaping (percent encoding) of chars in the 128 .. 255 range passed to the"
NSQ_SOURCE_LINE 00001341 "URI constructor or when setting URI parts using the accessor methods depend on"
NSQ_SOURCE_LINE 00001342 "the state of the internal UTF8 flag (see utf8::is_utf8) of the string passed."
NSQ_SOURCE_LINE 00001343 "If the UTF8 flag is set the UTF-8 encoded version of the character is percent"
NSQ_SOURCE_LINE 00001344 "encoded.  If the UTF8 flag isn't set the Latin-1 version (byte) of the"
NSQ_SOURCE_LINE 00001345 "character is percent encoded.  This basically exposes the internal encoding of"
NSQ_SOURCE_LINE 00001346 "Perl strings."
NSQ_SOURCE_LINE 00001347 ""
NSQ_SOURCE_LINE 00001348 "=back"
NSQ_SOURCE_LINE 00001349 ""
NSQ_SOURCE_LINE 00001350 "=head1 PARSING URIs WITH REGEXP"
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "As an alternative to this module, the following (official) regular"
NSQ_SOURCE_LINE 00001353 "expression can be used to decode a URI:"
NSQ_SOURCE_LINE 00001354 ""
NSQ_SOURCE_LINE 00001355 "  my($scheme, $authority, $path, $query, $fragment) ="
NSQ_SOURCE_LINE 00001356 "  $uri =~ m|(?:([^:/?#]+):)?(?://([^/?#]*))?([^?#]*)(?:\\?([^#]*))?(?:#(.*))?|;"
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 "The C<URI::Split> module provides the function uri_split() as a"
NSQ_SOURCE_LINE 00001359 "readable alternative."
NSQ_SOURCE_LINE 00001360 ""
NSQ_SOURCE_LINE 00001361 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "L<URI::file>, L<URI::WithBase>, L<URI::Escape>,"
NSQ_SOURCE_LINE 00001364 "L<URI::Split>, L<URI::Heuristic>"
NSQ_SOURCE_LINE 00001365 ""
NSQ_SOURCE_LINE 00001366 "RFC 2396: \"Uniform Resource Identifiers (URI): Generic Syntax\","
NSQ_SOURCE_LINE 00001367 "Berners-Lee, Fielding, Masinter, August 1998."
NSQ_SOURCE_LINE 00001368 ""
NSQ_SOURCE_LINE 00001369 "L<http://www.iana.org/assignments/uri-schemes>"
NSQ_SOURCE_LINE 00001370 ""
NSQ_SOURCE_LINE 00001371 "L<http://www.iana.org/assignments/urn-namespaces>"
NSQ_SOURCE_LINE 00001372 ""
NSQ_SOURCE_LINE 00001373 "L<http://www.w3.org/Addressing/>"
NSQ_SOURCE_LINE 00001374 ""
