BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "package Test::Exception;"
NSQ_SOURCE_LINE 00000005 "use Test::Builder;"
NSQ_SOURCE_LINE 00000006 "use Sub::Uplevel qw( uplevel );"
NSQ_SOURCE_LINE 00000007 "use base qw( Exporter );"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $VERSION = '0.43';"
NSQ_SOURCE_LINE 00000010 "$VERSION = eval $VERSION;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our @EXPORT = qw(dies_ok lives_ok throws_ok lives_and);"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "my $Tester = Test::Builder->new;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub import {"
NSQ_SOURCE_LINE 00000017 "    my $self = shift;"
NSQ_SOURCE_LINE 00000018 "    if ( @_ ) {"
NSQ_SOURCE_LINE 00000019 "        my $package = caller;"
NSQ_SOURCE_LINE 00000020 "        $Tester->exported_to( $package );"
NSQ_SOURCE_LINE 00000021 "        $Tester->plan( @_ );"
NSQ_SOURCE_LINE 00000022 "    };"
NSQ_SOURCE_LINE 00000023 "    $self->export_to_level( 1, $self, $_ ) foreach @EXPORT;"
NSQ_SOURCE_LINE 00000024 "}"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "=head1 NAME"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "Test::Exception - Test exception-based code"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "  use Test::More tests => 5;"
NSQ_SOURCE_LINE 00000033 "  use Test::Exception;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "  # or if you don't need Test::More"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "  use Test::Exception tests => 5;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "  # then..."
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "  # Check that the stringified exception matches given regex"
NSQ_SOURCE_LINE 00000042 "  throws_ok { $foo->method } qr/division by zero/, 'zero caught okay';"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "  # Check an exception of the given class (or subclass) is thrown"
NSQ_SOURCE_LINE 00000045 "  throws_ok { $foo->method } 'Error::Simple', 'simple error thrown';"
NSQ_SOURCE_LINE 00000046 "  "
NSQ_SOURCE_LINE 00000047 "  # all Test::Exceptions subroutines are guaranteed to preserve the state "
NSQ_SOURCE_LINE 00000048 "  # of $@ so you can do things like this after throws_ok and dies_ok"
NSQ_SOURCE_LINE 00000049 "  like $@, 'what the stringified exception should look like';"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "  # Check that something died - we do not care why"
NSQ_SOURCE_LINE 00000052 "  dies_ok { $foo->method } 'expecting to die';"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "  # Check that something did not die"
NSQ_SOURCE_LINE 00000055 "  lives_ok { $foo->method } 'expecting to live';"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "  # Check that a test runs without an exception"
NSQ_SOURCE_LINE 00000058 "  lives_and { is $foo->method, 42 } 'method is 42';"
NSQ_SOURCE_LINE 00000059 "  "
NSQ_SOURCE_LINE 00000060 "  # or if you don't like prototyped functions"
NSQ_SOURCE_LINE 00000061 "  "
NSQ_SOURCE_LINE 00000062 "  throws_ok( sub { $foo->method }, qr/division by zero/,"
NSQ_SOURCE_LINE 00000063 "      'zero caught okay' );"
NSQ_SOURCE_LINE 00000064 "  throws_ok( sub { $foo->method }, 'Error::Simple', "
NSQ_SOURCE_LINE 00000065 "      'simple error thrown' );"
NSQ_SOURCE_LINE 00000066 "  dies_ok( sub { $foo->method }, 'expecting to die' );"
NSQ_SOURCE_LINE 00000067 "  lives_ok( sub { $foo->method }, 'expecting to live' );"
NSQ_SOURCE_LINE 00000068 "  lives_and( sub { is $foo->method, 42 }, 'method is 42' );"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "This module provides a few convenience methods for testing exception based code. It is built with "
NSQ_SOURCE_LINE 00000074 "L<Test::Builder> and plays happily with L<Test::More> and friends."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "If you are not already familiar with L<Test::More> now would be the time to go take a look."
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "You can specify the test plan when you C<use Test::Exception> in the same way as C<use Test::More>."
NSQ_SOURCE_LINE 00000079 "See L<Test::More> for details."
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "NOTE: Test::Exception only checks for exceptions. It will ignore other methods of stopping "
NSQ_SOURCE_LINE 00000082 "program execution - including exit(). If you have an exit() in evalled code Test::Exception"
NSQ_SOURCE_LINE 00000083 "will not catch this with any of its testing functions."
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "NOTE: This module uses L<Sub::Uplevel> and relies on overriding"
NSQ_SOURCE_LINE 00000086 "C<CORE::GLOBAL::caller> to hide your test blocks from the call stack.  If this"
NSQ_SOURCE_LINE 00000087 "use of global overrides concerns you, the L<Test::Fatal> module offers a more"
NSQ_SOURCE_LINE 00000088 "minimalist alternative."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "=cut"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "sub _quiet_caller (;$) { ## no critic Prototypes"
NSQ_SOURCE_LINE 00000093 "    my $height = $_[0];"
NSQ_SOURCE_LINE 00000094 "    $height++;"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    if ( CORE::caller() eq 'DB' ) {"
NSQ_SOURCE_LINE 00000097 "        # passthrough the @DB::args trick"
NSQ_SOURCE_LINE 00000098 "        package DB;"
NSQ_SOURCE_LINE 00000099 "        if( wantarray ) {"
NSQ_SOURCE_LINE 00000100 "            if ( !@_ ) {"
NSQ_SOURCE_LINE 00000101 "                return (CORE::caller($height))[0..2];"
NSQ_SOURCE_LINE 00000102 "            }"
NSQ_SOURCE_LINE 00000103 "            else {"
NSQ_SOURCE_LINE 00000104 "                # If we got here, we are within a Test::Exception test, and"
NSQ_SOURCE_LINE 00000105 "                # something is producing a stacktrace. In case this is a full"
NSQ_SOURCE_LINE 00000106 "                # trace (i.e. confess() ), we have to make sure that the sub"
NSQ_SOURCE_LINE 00000107 "                # args are not visible. If we do not do this, and the test in"
NSQ_SOURCE_LINE 00000108 "                # question is throws_ok() with a regex, it will end up matching"
NSQ_SOURCE_LINE 00000109 "                # against itself in the args to throws_ok()."
NSQ_SOURCE_LINE 00000110 "                #"
NSQ_SOURCE_LINE 00000111 "                # While it is possible (and maybe wise), to test if we are"
NSQ_SOURCE_LINE 00000112 "                # indeed running under throws_ok (by crawling the stack right"
NSQ_SOURCE_LINE 00000113 "                # up from here), the old behavior of Test::Exception was to"
NSQ_SOURCE_LINE 00000114 "                # simply obliterate @DB::args altogether in _quiet_caller, so"
NSQ_SOURCE_LINE 00000115 "                # we are just preserving the behavior to avoid surprises"
NSQ_SOURCE_LINE 00000116 "                #"
NSQ_SOURCE_LINE 00000117 "                my @frame_info = CORE::caller($height);"
NSQ_SOURCE_LINE 00000118 "                @DB::args = ();"
NSQ_SOURCE_LINE 00000119 "                return @frame_info;"
NSQ_SOURCE_LINE 00000120 "            }"
NSQ_SOURCE_LINE 00000121 "        }"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "        # fallback if nothing above returns"
NSQ_SOURCE_LINE 00000124 "        return CORE::caller($height);"
NSQ_SOURCE_LINE 00000125 "    }"
NSQ_SOURCE_LINE 00000126 "    else {"
NSQ_SOURCE_LINE 00000127 "        if( wantarray and !@_ ) {"
NSQ_SOURCE_LINE 00000128 "            return (CORE::caller($height))[0..2];"
NSQ_SOURCE_LINE 00000129 "        }"
NSQ_SOURCE_LINE 00000130 "        else {"
NSQ_SOURCE_LINE 00000131 "            return CORE::caller($height);"
NSQ_SOURCE_LINE 00000132 "        }"
NSQ_SOURCE_LINE 00000133 "    }"
NSQ_SOURCE_LINE 00000134 "}"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "sub _try_as_caller {"
NSQ_SOURCE_LINE 00000137 "    my $coderef = shift;"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    # local works here because Sub::Uplevel has already overridden caller"
NSQ_SOURCE_LINE 00000140 "    local *CORE::GLOBAL::caller;"
NSQ_SOURCE_LINE 00000141 "    { no warnings 'redefine'; *CORE::GLOBAL::caller = \\&_quiet_caller; }"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    eval { uplevel 3, $coderef };"
NSQ_SOURCE_LINE 00000144 "    return $@;"
NSQ_SOURCE_LINE 00000145 "};"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "sub _is_exception {"
NSQ_SOURCE_LINE 00000149 "    my $exception = shift;"
NSQ_SOURCE_LINE 00000150 "    return ref $exception || $exception ne '';"
NSQ_SOURCE_LINE 00000151 "};"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "sub _exception_as_string {"
NSQ_SOURCE_LINE 00000155 "    my ( $prefix, $exception ) = @_;"
NSQ_SOURCE_LINE 00000156 "    return \"$prefix normal exit\" unless _is_exception( $exception );"
NSQ_SOURCE_LINE 00000157 "    my $class = ref $exception;"
NSQ_SOURCE_LINE 00000158 "    $exception = \"$class ($exception)\" "
NSQ_SOURCE_LINE 00000159 "            if $class && \"$exception\" !~ m/^\\Q$class/;"
NSQ_SOURCE_LINE 00000160 "    chomp $exception;"
NSQ_SOURCE_LINE 00000161 "    return \"$prefix $exception\";"
NSQ_SOURCE_LINE 00000162 "};"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=over 4"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=item B<throws_ok>"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "Tests to see that a specific exception is thrown. throws_ok() has two forms: "
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "  throws_ok BLOCK REGEX, TEST_DESCRIPTION"
NSQ_SOURCE_LINE 00000172 "  throws_ok BLOCK CLASS, TEST_DESCRIPTION"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "In the first form the test passes if the stringified exception matches the give regular expression. For example:"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    throws_ok { read_file( 'unreadable' ) } qr/No file/, 'no file';"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "If your perl does not support C<qr//> you can also pass a regex-like string, for example:"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    throws_ok { read_file( 'unreadable' ) } '/No file/', 'no file';"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "The second form of throws_ok() test passes if the exception is of the same class as the one supplied, or a subclass of that class. For example:"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "    throws_ok { $foo->bar } \"Error::Simple\", 'simple error';"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "Will only pass if the C<bar> method throws an Error::Simple exception, or a subclass of an Error::Simple exception."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "You can get the same effect by passing an instance of the exception you want to look for. The following is equivalent to the previous example:"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    my $SIMPLE = Error::Simple->new;"
NSQ_SOURCE_LINE 00000191 "    throws_ok { $foo->bar } $SIMPLE, 'simple error';"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "Should a throws_ok() test fail it produces appropriate diagnostic messages. For example:"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    not ok 3 - simple error"
NSQ_SOURCE_LINE 00000196 "    #     Failed test (test.t at line 48)"
NSQ_SOURCE_LINE 00000197 "    # expecting: Error::Simple exception"
NSQ_SOURCE_LINE 00000198 "    # found: normal exit"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "Like all other Test::Exception functions you can avoid prototypes by passing a subroutine explicitly:"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "    throws_ok( sub {$foo->bar}, \"Error::Simple\", 'simple error' );"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "A true value is returned if the test succeeds, false otherwise. On exit $@ is guaranteed to be the cause of death (if any)."
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "A description of the exception being checked is used if no optional test description is passed."
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "NOTE: Remember when you C<die $string_without_a_trailing_newline> perl will "
NSQ_SOURCE_LINE 00000209 "automatically add the current script line number, input line number and a newline. This will"
NSQ_SOURCE_LINE 00000210 "form part of the string that throws_ok regular expressions match against."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "=cut"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "sub throws_ok (&$;$) {"
NSQ_SOURCE_LINE 00000217 "    my ( $coderef, $expecting, $description ) = @_;"
NSQ_SOURCE_LINE 00000218 "    unless (defined $expecting) {"
NSQ_SOURCE_LINE 00000219 "        require Carp;"
NSQ_SOURCE_LINE 00000220 "        Carp::croak( \"throws_ok: must pass exception class/object or regex\" ); "
NSQ_SOURCE_LINE 00000221 "    }"
NSQ_SOURCE_LINE 00000222 "    $description = _exception_as_string( \"threw\", $expecting )"
NSQ_SOURCE_LINE 00000223 "        unless defined $description;"
NSQ_SOURCE_LINE 00000224 "    my $exception = _try_as_caller( $coderef );"
NSQ_SOURCE_LINE 00000225 "    my $regex = $Tester->maybe_regex( $expecting );"
NSQ_SOURCE_LINE 00000226 "    my $ok = $regex "
NSQ_SOURCE_LINE 00000227 "        ? ( $exception =~ m/$regex/ ) "
NSQ_SOURCE_LINE 00000228 "        : eval { "
NSQ_SOURCE_LINE 00000229 "            $exception->isa( ref $expecting ? ref $expecting : $expecting ) "
NSQ_SOURCE_LINE 00000230 "        };"
NSQ_SOURCE_LINE 00000231 "    $Tester->ok( $ok, $description );"
NSQ_SOURCE_LINE 00000232 "    unless ( $ok ) {"
NSQ_SOURCE_LINE 00000233 "        $Tester->diag( _exception_as_string( \"expecting:\", $expecting ) );"
NSQ_SOURCE_LINE 00000234 "        $Tester->diag( _exception_as_string( \"found:\", $exception ) );"
NSQ_SOURCE_LINE 00000235 "    };"
NSQ_SOURCE_LINE 00000236 "    $@ = $exception;"
NSQ_SOURCE_LINE 00000237 "    return $ok;"
NSQ_SOURCE_LINE 00000238 "};"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=item B<dies_ok>"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "Checks that a piece of code dies, rather than returning normally. For example:"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "    sub div {"
NSQ_SOURCE_LINE 00000246 "        my ( $a, $b ) = @_;"
NSQ_SOURCE_LINE 00000247 "        return $a / $b;"
NSQ_SOURCE_LINE 00000248 "    };"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "    dies_ok { div( 1, 0 ) } 'divide by zero detected';"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    # or if you don't like prototypes"
NSQ_SOURCE_LINE 00000253 "    dies_ok( sub { div( 1, 0 ) }, 'divide by zero detected' );"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "A true value is returned if the test succeeds, false otherwise. On exit $@ is guaranteed to be the cause of death (if any)."
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "Remember: This test will pass if the code dies for any reason. If you care about the reason it might be more sensible to write a more specific test using throws_ok()."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "The test description is optional, but recommended. "
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=cut"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "sub dies_ok (&;$) {"
NSQ_SOURCE_LINE 00000264 "    my ( $coderef, $description ) = @_;"
NSQ_SOURCE_LINE 00000265 "    my $exception = _try_as_caller( $coderef );"
NSQ_SOURCE_LINE 00000266 "    my $ok = $Tester->ok( _is_exception($exception), $description );"
NSQ_SOURCE_LINE 00000267 "    $@ = $exception;"
NSQ_SOURCE_LINE 00000268 "    return $ok;"
NSQ_SOURCE_LINE 00000269 "}"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "=item B<lives_ok>"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "Checks that a piece of code doesn't die. This allows your test script to continue, rather than aborting if you get an unexpected exception. For example:"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "    sub read_file {"
NSQ_SOURCE_LINE 00000277 "        my $file = shift;"
NSQ_SOURCE_LINE 00000278 "        local $/;"
NSQ_SOURCE_LINE 00000279 "        open my $fh, '<', $file or die \"open failed ($!)\\n\";"
NSQ_SOURCE_LINE 00000280 "        $file = <FILE>;"
NSQ_SOURCE_LINE 00000281 "        return $file;"
NSQ_SOURCE_LINE 00000282 "    };"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    my $file;"
NSQ_SOURCE_LINE 00000285 "    lives_ok { $file = read_file('test.txt') } 'file read';"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    # or if you don't like prototypes"
NSQ_SOURCE_LINE 00000288 "    lives_ok( sub { $file = read_file('test.txt') }, 'file read' );"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "Should a lives_ok() test fail it produces appropriate diagnostic messages. For example:"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "    not ok 1 - file read"
NSQ_SOURCE_LINE 00000293 "    #     Failed test (test.t at line 15)"
NSQ_SOURCE_LINE 00000294 "    # died: open failed (No such file or directory)"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "A true value is returned if the test succeeds, false otherwise. On exit $@ is guaranteed to be the cause of death (if any)."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "The test description is optional, but recommended. "
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=cut"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "sub lives_ok (&;$) {"
NSQ_SOURCE_LINE 00000303 "    my ( $coderef, $description ) = @_;"
NSQ_SOURCE_LINE 00000304 "    my $exception = _try_as_caller( $coderef );"
NSQ_SOURCE_LINE 00000305 "    my $ok = $Tester->ok( ! _is_exception( $exception ), $description );"
NSQ_SOURCE_LINE 00000306 "    $Tester->diag( _exception_as_string( \"died:\", $exception ) ) unless $ok;"
NSQ_SOURCE_LINE 00000307 "    $@ = $exception;"
NSQ_SOURCE_LINE 00000308 "    return $ok;"
NSQ_SOURCE_LINE 00000309 "}"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "=item B<lives_and>"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "Run a test that may throw an exception. For example, instead of doing:"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "  my $file;"
NSQ_SOURCE_LINE 00000317 "  lives_ok { $file = read_file('answer.txt') } 'read_file worked';"
NSQ_SOURCE_LINE 00000318 "  is $file, \"42\", 'answer was 42';"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "You can use lives_and() like this:"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "  lives_and { is read_file('answer.txt'), \"42\" } 'answer is 42';"
NSQ_SOURCE_LINE 00000323 "  # or if you don't like prototypes"
NSQ_SOURCE_LINE 00000324 "  lives_and(sub {is read_file('answer.txt'), \"42\"}, 'answer is 42');"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "Which is the same as doing"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "  is read_file('answer.txt'), \"42\\n\", 'answer is 42';"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "unless C<read_file('answer.txt')> dies, in which case you get the same kind of error as lives_ok()"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "  not ok 1 - answer is 42"
NSQ_SOURCE_LINE 00000333 "  #     Failed test (test.t at line 15)"
NSQ_SOURCE_LINE 00000334 "  # died: open failed (No such file or directory)"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "A true value is returned if the test succeeds, false otherwise. On exit $@ is guaranteed to be the cause of death (if any)."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "The test description is optional, but recommended."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "=cut"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "sub lives_and (&;$) {"
NSQ_SOURCE_LINE 00000343 "    my ( $test, $description ) = @_;"
NSQ_SOURCE_LINE 00000344 "    {"
NSQ_SOURCE_LINE 00000345 "        my $ok = \\&Test::Builder::ok;"
NSQ_SOURCE_LINE 00000346 "        no warnings;"
NSQ_SOURCE_LINE 00000347 "        local *Test::Builder::ok = sub {"
NSQ_SOURCE_LINE 00000348 "            local $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000349 "            $_[2] = $description unless defined $_[2];"
NSQ_SOURCE_LINE 00000350 "            $ok->(@_);"
NSQ_SOURCE_LINE 00000351 "        };"
NSQ_SOURCE_LINE 00000352 "        use warnings;"
NSQ_SOURCE_LINE 00000353 "        eval { $test->() } and return 1;"
NSQ_SOURCE_LINE 00000354 "    };"
NSQ_SOURCE_LINE 00000355 "    my $exception = $@;"
NSQ_SOURCE_LINE 00000356 "    if ( _is_exception( $exception ) ) {"
NSQ_SOURCE_LINE 00000357 "        $Tester->ok( 0, $description );"
NSQ_SOURCE_LINE 00000358 "        $Tester->diag( _exception_as_string( \"died:\", $exception ) );"
NSQ_SOURCE_LINE 00000359 "    };"
NSQ_SOURCE_LINE 00000360 "    $@ = $exception;"
NSQ_SOURCE_LINE 00000361 "    return;"
NSQ_SOURCE_LINE 00000362 "}"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "=back"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=head1 SKIPPING TEST::EXCEPTION TESTS"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "Sometimes we want to use Test::Exception tests in a test suite, but don't want to force the user to have Test::Exception installed. One way to do this is to skip the tests if Test::Exception is absent. You can do this with code something like this:"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "  use strict;"
NSQ_SOURCE_LINE 00000372 "  use warnings;"
NSQ_SOURCE_LINE 00000373 "  use Test::More;"
NSQ_SOURCE_LINE 00000374 "  "
NSQ_SOURCE_LINE 00000375 "  BEGIN {"
NSQ_SOURCE_LINE 00000376 "      eval \"use Test::Exception\";"
NSQ_SOURCE_LINE 00000377 "      plan skip_all => \"Test::Exception needed\" if $@;"
NSQ_SOURCE_LINE 00000378 "  }"
NSQ_SOURCE_LINE 00000379 "  "
NSQ_SOURCE_LINE 00000380 "  plan tests => 2;"
NSQ_SOURCE_LINE 00000381 "  # ... tests that need Test::Exception ..."
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "Note that we load Test::Exception in a C<BEGIN> block ensuring that the subroutine prototypes are in place before the rest of the test script is compiled."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "=head1 BUGS"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "There are some edge cases in Perl's exception handling where Test::Exception will miss exceptions"
NSQ_SOURCE_LINE 00000389 "thrown in DESTROY blocks. See the RT bug L<http://rt.cpan.org/Ticket/Display.html?id=24678> for"
NSQ_SOURCE_LINE 00000390 "details, along with the t/edge-cases.t in the distribution test suite. These will be addressed in"
NSQ_SOURCE_LINE 00000391 "a future Test::Exception release."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "If you find any more bugs please let me know by e-mail, or report the problem with "
NSQ_SOURCE_LINE 00000394 "L<http://rt.cpan.org/>."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 ""
