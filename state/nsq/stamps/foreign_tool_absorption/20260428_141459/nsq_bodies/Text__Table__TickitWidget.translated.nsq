NSQ_SOURCE_LINE 00000001 "package Text::Table::TickitWidget;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2021-04-25'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Text-Table-TickitWidget'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.001'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "sub table {"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "    my %params = @_;"
NSQ_SOURCE_LINE 00000015 "    my $rows = $params{rows} or die \"Must provide rows!\";"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "    return \"\" unless @$rows;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    require Tickit;"
NSQ_SOURCE_LINE 00000020 "    require Tickit::Widget::Table;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    my $tbl = Tickit::Widget::Table->new;"
NSQ_SOURCE_LINE 00000023 "    for my $i (0..$#{$rows->[0]}) {"
NSQ_SOURCE_LINE 00000024 "        $tbl->add_column("
NSQ_SOURCE_LINE 00000025 "            label => $params{header_row} ? $rows->[0][$i] : \"column$i\","
NSQ_SOURCE_LINE 00000026 "            align => 'left',"
NSQ_SOURCE_LINE 00000027 "        );"
NSQ_SOURCE_LINE 00000028 "    }"
NSQ_SOURCE_LINE 00000029 "    $tbl->adapter->push([ @{$rows}[1 .. $#{$rows}] ]);"
NSQ_SOURCE_LINE 00000030 "    Tickit->new(root => $tbl)->run;"
NSQ_SOURCE_LINE 00000031 "    \"\";"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "1;"
NSQ_SOURCE_LINE 00000035 "# ABSTRACT: View table data on the terminal using Tickit::Widget::Table"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "__END__"
NSQ_SOURCE_LINE 00000038 ""
