NSQ_SOURCE_LINE 00000043 "=head1 NAME"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "Text::Table::TickitWidget - View table data on the terminal using Tickit::Widget::Table"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 VERSION"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "This document describes version 0.001 of Text::Table::TickitWidget (from Perl distribution Text-Table-TickitWidget), released on 2021-04-25."
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 " use Text::Table::TickitWidget;"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 " my $rows = ["
NSQ_SOURCE_LINE 00000056 "     # header row"
NSQ_SOURCE_LINE 00000057 "     ['Name', 'Rank', 'Serial'],"
NSQ_SOURCE_LINE 00000058 "     # rows"
NSQ_SOURCE_LINE 00000059 "     ['alice', 'pvt', '123<456>'],"
NSQ_SOURCE_LINE 00000060 "     ['bob',   'cpl', '98765321'],"
NSQ_SOURCE_LINE 00000061 "     ['carol', 'brig gen', '8745'],"
NSQ_SOURCE_LINE 00000062 " ];"
NSQ_SOURCE_LINE 00000063 " Text::Table::TickitWidget::table(rows => $rows, header_row => 1);"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "This module uses the L<Text::Table::Tiny> (0.03) interface to let you view table"
NSQ_SOURCE_LINE 00000068 "data on the terminal using L<Tickit::Widget::Table>."
