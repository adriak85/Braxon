NSQ_SOURCE_LINE 00000001 "package Class::Accessor;"
NSQ_SOURCE_LINE 00000002 "require 5.00502;"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "$Class::Accessor::VERSION = '0.51';"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "sub new {"
NSQ_SOURCE_LINE 00000007 "    return bless"
NSQ_SOURCE_LINE 00000008 "        defined $_[1]"
NSQ_SOURCE_LINE 00000009 "            ? {%{$_[1]}} # make a copy of $fields."
NSQ_SOURCE_LINE 00000010 "            : {},"
NSQ_SOURCE_LINE 00000011 "        ref $_[0] || $_[0];"
NSQ_SOURCE_LINE 00000012 "}"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub mk_accessors {"
NSQ_SOURCE_LINE 00000015 "    my($self, @fields) = @_;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "    $self->_mk_accessors('rw', @fields);"
NSQ_SOURCE_LINE 00000018 "}"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "if (eval { require Sub::Name }) {"
NSQ_SOURCE_LINE 00000021 "    Sub::Name->import;"
NSQ_SOURCE_LINE 00000022 "}"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "{"
NSQ_SOURCE_LINE 00000025 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    sub import {"
NSQ_SOURCE_LINE 00000028 "        my ($class, @what) = @_;"
NSQ_SOURCE_LINE 00000029 "        my $caller = caller;"
NSQ_SOURCE_LINE 00000030 "        for (@what) {"
NSQ_SOURCE_LINE 00000031 "            if (/^(?:antlers|moose-?like)$/i) {"
NSQ_SOURCE_LINE 00000032 "                *{\"${caller}::has\"} = sub {"
NSQ_SOURCE_LINE 00000033 "                    my ($f, %args) = @_;"
NSQ_SOURCE_LINE 00000034 "                    $caller->_mk_accessors(($args{is}||\"rw\"), $f);"
NSQ_SOURCE_LINE 00000035 "                };"
NSQ_SOURCE_LINE 00000036 "                *{\"${caller}::extends\"} = sub {"
NSQ_SOURCE_LINE 00000037 "                    @{\"${caller}::ISA\"} = @_;"
NSQ_SOURCE_LINE 00000038 "                    unless (grep $_->can(\"_mk_accessors\"), @_) {"
NSQ_SOURCE_LINE 00000039 "                        push @{\"${caller}::ISA\"}, $class;"
NSQ_SOURCE_LINE 00000040 "                    }"
NSQ_SOURCE_LINE 00000041 "                };"
NSQ_SOURCE_LINE 00000042 "                # we'll use their @ISA as a default, in case it happens to be"
NSQ_SOURCE_LINE 00000043 "                # set already"
NSQ_SOURCE_LINE 00000044 "                &{\"${caller}::extends\"}(@{\"${caller}::ISA\"});"
NSQ_SOURCE_LINE 00000045 "            }"
NSQ_SOURCE_LINE 00000046 "        }"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    sub follow_best_practice {"
NSQ_SOURCE_LINE 00000050 "        my($self) = @_;"
NSQ_SOURCE_LINE 00000051 "        my $class = ref $self || $self;"
NSQ_SOURCE_LINE 00000052 "        *{\"${class}::accessor_name_for\"}  = \\&best_practice_accessor_name_for;"
NSQ_SOURCE_LINE 00000053 "        *{\"${class}::mutator_name_for\"}  = \\&best_practice_mutator_name_for;"
NSQ_SOURCE_LINE 00000054 "    }"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    sub _mk_accessors {"
NSQ_SOURCE_LINE 00000057 "        my($self, $access, @fields) = @_;"
NSQ_SOURCE_LINE 00000058 "        my $class = ref $self || $self;"
NSQ_SOURCE_LINE 00000059 "        my $ra = $access eq 'rw' || $access eq 'ro';"
NSQ_SOURCE_LINE 00000060 "        my $wa = $access eq 'rw' || $access eq 'wo';"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "        foreach my $field (@fields) {"
NSQ_SOURCE_LINE 00000063 "            my $accessor_name = $self->accessor_name_for($field);"
NSQ_SOURCE_LINE 00000064 "            my $mutator_name = $self->mutator_name_for($field);"
NSQ_SOURCE_LINE 00000065 "            if( $accessor_name eq 'DESTROY' or $mutator_name eq 'DESTROY' ) {"
NSQ_SOURCE_LINE 00000066 "                $self->_carp(\"Having a data accessor named DESTROY  in '$class' is unwise.\");"
NSQ_SOURCE_LINE 00000067 "            }"
NSQ_SOURCE_LINE 00000068 "            if ($accessor_name eq $mutator_name) {"
NSQ_SOURCE_LINE 00000069 "                my $accessor;"
NSQ_SOURCE_LINE 00000070 "                if ($ra && $wa) {"
NSQ_SOURCE_LINE 00000071 "                    $accessor = $self->make_accessor($field);"
NSQ_SOURCE_LINE 00000072 "                } elsif ($ra) {"
NSQ_SOURCE_LINE 00000073 "                    $accessor = $self->make_ro_accessor($field);"
NSQ_SOURCE_LINE 00000074 "                } else {"
NSQ_SOURCE_LINE 00000075 "                    $accessor = $self->make_wo_accessor($field);"
NSQ_SOURCE_LINE 00000076 "                }"
NSQ_SOURCE_LINE 00000077 "                my $fullname = \"${class}::$accessor_name\";"
NSQ_SOURCE_LINE 00000078 "                my $subnamed = 0;"
NSQ_SOURCE_LINE 00000079 "                unless (defined &{$fullname}) {"
NSQ_SOURCE_LINE 00000080 "                    subname($fullname, $accessor) if defined &subname;"
NSQ_SOURCE_LINE 00000081 "                    $subnamed = 1;"
NSQ_SOURCE_LINE 00000082 "                    *{$fullname} = $accessor;"
NSQ_SOURCE_LINE 00000083 "                }"
NSQ_SOURCE_LINE 00000084 "                if ($accessor_name eq $field) {"
NSQ_SOURCE_LINE 00000085 "                    # the old behaviour"
NSQ_SOURCE_LINE 00000086 "                    my $alias = \"${class}::_${field}_accessor\";"
NSQ_SOURCE_LINE 00000087 "                    subname($alias, $accessor) if defined &subname and not $subnamed;"
NSQ_SOURCE_LINE 00000088 "                    *{$alias} = $accessor unless defined &{$alias};"
NSQ_SOURCE_LINE 00000089 "                }"
NSQ_SOURCE_LINE 00000090 "            } else {"
NSQ_SOURCE_LINE 00000091 "                my $fullaccname = \"${class}::$accessor_name\";"
NSQ_SOURCE_LINE 00000092 "                my $fullmutname = \"${class}::$mutator_name\";"
NSQ_SOURCE_LINE 00000093 "                if ($ra and not defined &{$fullaccname}) {"
NSQ_SOURCE_LINE 00000094 "                    my $accessor = $self->make_ro_accessor($field);"
NSQ_SOURCE_LINE 00000095 "                    subname($fullaccname, $accessor) if defined &subname;"
NSQ_SOURCE_LINE 00000096 "                    *{$fullaccname} = $accessor;"
NSQ_SOURCE_LINE 00000097 "                }"
NSQ_SOURCE_LINE 00000098 "                if ($wa and not defined &{$fullmutname}) {"
NSQ_SOURCE_LINE 00000099 "                    my $mutator = $self->make_wo_accessor($field);"
NSQ_SOURCE_LINE 00000100 "                    subname($fullmutname, $mutator) if defined &subname;"
NSQ_SOURCE_LINE 00000101 "                    *{$fullmutname} = $mutator;"
NSQ_SOURCE_LINE 00000102 "                }"
NSQ_SOURCE_LINE 00000103 "            }"
NSQ_SOURCE_LINE 00000104 "        }"
NSQ_SOURCE_LINE 00000105 "    }"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "}"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "sub mk_ro_accessors {"
NSQ_SOURCE_LINE 00000110 "    my($self, @fields) = @_;"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "    $self->_mk_accessors('ro', @fields);"
NSQ_SOURCE_LINE 00000113 "}"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "sub mk_wo_accessors {"
NSQ_SOURCE_LINE 00000116 "    my($self, @fields) = @_;"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    $self->_mk_accessors('wo', @fields);"
NSQ_SOURCE_LINE 00000119 "}"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "sub best_practice_accessor_name_for {"
NSQ_SOURCE_LINE 00000122 "    my ($class, $field) = @_;"
NSQ_SOURCE_LINE 00000123 "    return \"get_$field\";"
NSQ_SOURCE_LINE 00000124 "}"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "sub best_practice_mutator_name_for {"
NSQ_SOURCE_LINE 00000127 "    my ($class, $field) = @_;"
NSQ_SOURCE_LINE 00000128 "    return \"set_$field\";"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "sub accessor_name_for {"
NSQ_SOURCE_LINE 00000132 "    my ($class, $field) = @_;"
NSQ_SOURCE_LINE 00000133 "    return $field;"
NSQ_SOURCE_LINE 00000134 "}"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "sub mutator_name_for {"
NSQ_SOURCE_LINE 00000137 "    my ($class, $field) = @_;"
NSQ_SOURCE_LINE 00000138 "    return $field;"
NSQ_SOURCE_LINE 00000139 "}"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "sub set {"
NSQ_SOURCE_LINE 00000142 "    my($self, $key) = splice(@_, 0, 2);"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    if(@_ == 1) {"
NSQ_SOURCE_LINE 00000145 "        $self->{$key} = $_[0];"
NSQ_SOURCE_LINE 00000146 "    }"
NSQ_SOURCE_LINE 00000147 "    elsif(@_ > 1) {"
NSQ_SOURCE_LINE 00000148 "        $self->{$key} = [@_];"
NSQ_SOURCE_LINE 00000149 "    }"
NSQ_SOURCE_LINE 00000150 "    else {"
NSQ_SOURCE_LINE 00000151 "        $self->_croak(\"Wrong number of arguments received\");"
NSQ_SOURCE_LINE 00000152 "    }"
NSQ_SOURCE_LINE 00000153 "}"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "sub get {"
NSQ_SOURCE_LINE 00000156 "    my $self = shift;"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    if(@_ == 1) {"
NSQ_SOURCE_LINE 00000159 "        return $self->{$_[0]};"
NSQ_SOURCE_LINE 00000160 "    }"
NSQ_SOURCE_LINE 00000161 "    elsif( @_ > 1 ) {"
NSQ_SOURCE_LINE 00000162 "        return @{$self}{@_};"
NSQ_SOURCE_LINE 00000163 "    }"
NSQ_SOURCE_LINE 00000164 "    else {"
NSQ_SOURCE_LINE 00000165 "        $self->_croak(\"Wrong number of arguments received\");"
NSQ_SOURCE_LINE 00000166 "    }"
NSQ_SOURCE_LINE 00000167 "}"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "sub make_accessor {"
NSQ_SOURCE_LINE 00000170 "    my ($class, $field) = @_;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    return sub {"
NSQ_SOURCE_LINE 00000173 "        my $self = shift;"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "        if(@_) {"
NSQ_SOURCE_LINE 00000176 "            return $self->set($field, @_);"
NSQ_SOURCE_LINE 00000177 "        } else {"
NSQ_SOURCE_LINE 00000178 "            return $self->get($field);"
NSQ_SOURCE_LINE 00000179 "        }"
NSQ_SOURCE_LINE 00000180 "    };"
NSQ_SOURCE_LINE 00000181 "}"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "sub make_ro_accessor {"
NSQ_SOURCE_LINE 00000184 "    my($class, $field) = @_;"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "    return sub {"
NSQ_SOURCE_LINE 00000187 "        my $self = shift;"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "        if (@_) {"
NSQ_SOURCE_LINE 00000190 "            my $caller = caller;"
NSQ_SOURCE_LINE 00000191 "            $self->_croak(\"'$caller' cannot alter the value of '$field' on objects of class '$class'\");"
NSQ_SOURCE_LINE 00000192 "        }"
NSQ_SOURCE_LINE 00000193 "        else {"
NSQ_SOURCE_LINE 00000194 "            return $self->get($field);"
NSQ_SOURCE_LINE 00000195 "        }"
NSQ_SOURCE_LINE 00000196 "    };"
NSQ_SOURCE_LINE 00000197 "}"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "sub make_wo_accessor {"
NSQ_SOURCE_LINE 00000200 "    my($class, $field) = @_;"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "    return sub {"
NSQ_SOURCE_LINE 00000203 "        my $self = shift;"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "        unless (@_) {"
NSQ_SOURCE_LINE 00000206 "            my $caller = caller;"
NSQ_SOURCE_LINE 00000207 "            $self->_croak(\"'$caller' cannot access the value of '$field' on objects of class '$class'\");"
NSQ_SOURCE_LINE 00000208 "        }"
NSQ_SOURCE_LINE 00000209 "        else {"
NSQ_SOURCE_LINE 00000210 "            return $self->set($field, @_);"
NSQ_SOURCE_LINE 00000211 "        }"
NSQ_SOURCE_LINE 00000212 "    };"
NSQ_SOURCE_LINE 00000213 "}"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "use Carp ();"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "sub _carp {"
NSQ_SOURCE_LINE 00000219 "    my ($self, $msg) = @_;"
NSQ_SOURCE_LINE 00000220 "    Carp::carp($msg || $self);"
NSQ_SOURCE_LINE 00000221 "    return;"
NSQ_SOURCE_LINE 00000222 "}"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "sub _croak {"
NSQ_SOURCE_LINE 00000225 "    my ($self, $msg) = @_;"
NSQ_SOURCE_LINE 00000226 "    Carp::croak($msg || $self);"
NSQ_SOURCE_LINE 00000227 "    return;"
NSQ_SOURCE_LINE 00000228 "}"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "1;"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "__END__"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=head1 NAME"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "  Class::Accessor - Automated accessor generation"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "  package Foo;"
NSQ_SOURCE_LINE 00000241 "  use base qw(Class::Accessor);"
NSQ_SOURCE_LINE 00000242 "  Foo->follow_best_practice;"
NSQ_SOURCE_LINE 00000243 "  Foo->mk_accessors(qw(name role salary));"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "  # or if you prefer a Moose-like interface..."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "  package Foo;"
NSQ_SOURCE_LINE 00000248 "  use Class::Accessor \"antlers\";"
NSQ_SOURCE_LINE 00000249 "  has name => ( is => \"rw\", isa => \"Str\" );"
NSQ_SOURCE_LINE 00000250 "  has role => ( is => \"rw\", isa => \"Str\" );"
NSQ_SOURCE_LINE 00000251 "  has salary => ( is => \"rw\", isa => \"Num\" );"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "  # Meanwhile, in a nearby piece of code!"
NSQ_SOURCE_LINE 00000254 "  # Class::Accessor provides new()."
NSQ_SOURCE_LINE 00000255 "  my $mp = Foo->new({ name => \"Marty\", role => \"JAPH\" });"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "  my $job = $mp->role;  # gets $mp->{role}"
NSQ_SOURCE_LINE 00000258 "  $mp->salary(400000);  # sets $mp->{salary} = 400000 # I wish"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "  # like my @info = @{$mp}{qw(name role)}"
NSQ_SOURCE_LINE 00000261 "  my @info = $mp->get(qw(name role));"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "  # $mp->{salary} = 400000"
NSQ_SOURCE_LINE 00000264 "  $mp->set('salary', 400000);"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "This module automagically generates accessors/mutators for your class."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Most of the time, writing accessors is an exercise in cutting and"
NSQ_SOURCE_LINE 00000272 "pasting.  You usually wind up with a series of methods like this:"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "    sub name {"
NSQ_SOURCE_LINE 00000275 "        my $self = shift;"
NSQ_SOURCE_LINE 00000276 "        if(@_) {"
NSQ_SOURCE_LINE 00000277 "            $self->{name} = $_[0];"
NSQ_SOURCE_LINE 00000278 "        }"
NSQ_SOURCE_LINE 00000279 "        return $self->{name};"
NSQ_SOURCE_LINE 00000280 "    }"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "    sub salary {"
NSQ_SOURCE_LINE 00000283 "        my $self = shift;"
NSQ_SOURCE_LINE 00000284 "        if(@_) {"
NSQ_SOURCE_LINE 00000285 "            $self->{salary} = $_[0];"
NSQ_SOURCE_LINE 00000286 "        }"
NSQ_SOURCE_LINE 00000287 "        return $self->{salary};"
NSQ_SOURCE_LINE 00000288 "    }"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "  # etc..."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "One for each piece of data in your object.  While some will be unique,"
NSQ_SOURCE_LINE 00000293 "doing value checks and special storage tricks, most will simply be"
NSQ_SOURCE_LINE 00000294 "exercises in repetition.  Not only is it Bad Style to have a bunch of"
NSQ_SOURCE_LINE 00000295 "repetitious code, but it's also simply not lazy, which is the real"
NSQ_SOURCE_LINE 00000296 "tragedy."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "If you make your module a subclass of Class::Accessor and declare your"
NSQ_SOURCE_LINE 00000299 "accessor fields with mk_accessors() then you'll find yourself with a"
NSQ_SOURCE_LINE 00000300 "set of automatically generated accessors which can even be"
NSQ_SOURCE_LINE 00000301 "customized!"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "The basic set up is very simple:"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "    package Foo;"
NSQ_SOURCE_LINE 00000306 "    use base qw(Class::Accessor);"
NSQ_SOURCE_LINE 00000307 "    Foo->mk_accessors( qw(far bar car) );"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "Done.  Foo now has simple far(), bar() and car() accessors"
NSQ_SOURCE_LINE 00000310 "defined."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "Alternatively, if you want to follow Damian's I<best practice> guidelines"
NSQ_SOURCE_LINE 00000313 "you can use:"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "    package Foo;"
NSQ_SOURCE_LINE 00000316 "    use base qw(Class::Accessor);"
NSQ_SOURCE_LINE 00000317 "    Foo->follow_best_practice;"
NSQ_SOURCE_LINE 00000318 "    Foo->mk_accessors( qw(far bar car) );"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "B<Note:> you must call C<follow_best_practice> before calling C<mk_accessors>."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "=head2 Moose-like"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "By popular demand we now have a simple Moose-like interface.  You can now do:"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "    package Foo;"
NSQ_SOURCE_LINE 00000327 "    use Class::Accessor \"antlers\";"
NSQ_SOURCE_LINE 00000328 "    has far => ( is => \"rw\" );"
NSQ_SOURCE_LINE 00000329 "    has bar => ( is => \"rw\" );"
NSQ_SOURCE_LINE 00000330 "    has car => ( is => \"rw\" );"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "Currently only the C<is> attribute is supported."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "=head1 CONSTRUCTOR"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "Class::Accessor provides a basic constructor, C<new>.  It generates a"
NSQ_SOURCE_LINE 00000337 "hash-based object and can be called as either a class method or an"
NSQ_SOURCE_LINE 00000338 "object method."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "=head2 new"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "    my $obj = Foo->new;"
NSQ_SOURCE_LINE 00000343 "    my $obj = $other_obj->new;"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "    my $obj = Foo->new(\\%fields);"
NSQ_SOURCE_LINE 00000346 "    my $obj = $other_obj->new(\\%fields);"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "It takes an optional %fields hash which is used to initialize the"
NSQ_SOURCE_LINE 00000349 "object (handy if you use read-only accessors).  The fields of the hash"
NSQ_SOURCE_LINE 00000350 "correspond to the names of your accessors, so..."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "    package Foo;"
NSQ_SOURCE_LINE 00000353 "    use base qw(Class::Accessor);"
NSQ_SOURCE_LINE 00000354 "    Foo->mk_accessors('foo');"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "    my $obj = Foo->new({ foo => 42 });"
NSQ_SOURCE_LINE 00000357 "    print $obj->foo;    # 42"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "however %fields can contain anything, new() will shove them all into"
NSQ_SOURCE_LINE 00000360 "your object."
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "=head1 MAKING ACCESSORS"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "=head2 follow_best_practice"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "In Damian's Perl Best Practices book he recommends separate get and set methods"
NSQ_SOURCE_LINE 00000367 "with the prefix set_ and get_ to make it explicit what you intend to do.  If you"
NSQ_SOURCE_LINE 00000368 "want to create those accessor methods instead of the default ones, call:"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "    __PACKAGE__->follow_best_practice"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "B<before> you call any of the accessor-making methods."
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=head2 accessor_name_for / mutator_name_for"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "You may have your own crazy ideas for the names of the accessors, so you can"
NSQ_SOURCE_LINE 00000377 "make those happen by overriding C<accessor_name_for> and C<mutator_name_for> in"
NSQ_SOURCE_LINE 00000378 "your subclass.  (I copied that idea from Class::DBI.)"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=head2 mk_accessors"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "    __PACKAGE__->mk_accessors(@fields);"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "This creates accessor/mutator methods for each named field given in"
NSQ_SOURCE_LINE 00000385 "@fields.  Foreach field in @fields it will generate two accessors."
NSQ_SOURCE_LINE 00000386 "One called \"field()\" and the other called \"_field_accessor()\".  For"
NSQ_SOURCE_LINE 00000387 "example:"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "    # Generates foo(), _foo_accessor(), bar() and _bar_accessor()."
NSQ_SOURCE_LINE 00000390 "    __PACKAGE__->mk_accessors(qw(foo bar));"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "See L<CAVEATS AND TRICKS/\"Overriding autogenerated accessors\">"
NSQ_SOURCE_LINE 00000393 "for details."
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=head2 mk_ro_accessors"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "  __PACKAGE__->mk_ro_accessors(@read_only_fields);"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "Same as mk_accessors() except it will generate read-only accessors"
NSQ_SOURCE_LINE 00000400 "(ie. true accessors).  If you attempt to set a value with these"
NSQ_SOURCE_LINE 00000401 "accessors it will throw an exception.  It only uses get() and not"
NSQ_SOURCE_LINE 00000402 "set()."
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "    package Foo;"
NSQ_SOURCE_LINE 00000405 "    use base qw(Class::Accessor);"
NSQ_SOURCE_LINE 00000406 "    Foo->mk_ro_accessors(qw(foo bar));"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "    # Let's assume we have an object $foo of class Foo..."
NSQ_SOURCE_LINE 00000409 "    print $foo->foo;  # ok, prints whatever the value of $foo->{foo} is"
NSQ_SOURCE_LINE 00000410 "    $foo->foo(42);    # BOOM!  Naughty you."
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "=head2 mk_wo_accessors"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "  __PACKAGE__->mk_wo_accessors(@write_only_fields);"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "Same as mk_accessors() except it will generate write-only accessors"
NSQ_SOURCE_LINE 00000418 "(ie. mutators).  If you attempt to read a value with these accessors"
NSQ_SOURCE_LINE 00000419 "it will throw an exception.  It only uses set() and not get()."
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "B<NOTE> I'm not entirely sure why this is useful, but I'm sure someone"
NSQ_SOURCE_LINE 00000422 "will need it.  If you've found a use, let me know.  Right now it's here"
NSQ_SOURCE_LINE 00000423 "for orthogonality and because it's easy to implement."
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "    package Foo;"
NSQ_SOURCE_LINE 00000426 "    use base qw(Class::Accessor);"
NSQ_SOURCE_LINE 00000427 "    Foo->mk_wo_accessors(qw(foo bar));"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "    # Let's assume we have an object $foo of class Foo..."
NSQ_SOURCE_LINE 00000430 "    $foo->foo(42);      # OK.  Sets $self->{foo} = 42"
NSQ_SOURCE_LINE 00000431 "    print $foo->foo;    # BOOM!  Can't read from this accessor."
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=head1 Moose!"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "If you prefer a Moose-like interface to create accessors, you can use C<has> by"
NSQ_SOURCE_LINE 00000436 "importing this module like this:"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "  use Class::Accessor \"antlers\";"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "or"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "  use Class::Accessor \"moose-like\";"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "Then you can declare accessors like this:"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "  has alpha => ( is => \"rw\", isa => \"Str\" );"
NSQ_SOURCE_LINE 00000447 "  has beta  => ( is => \"ro\", isa => \"Str\" );"
NSQ_SOURCE_LINE 00000448 "  has gamma => ( is => \"wo\", isa => \"Str\" );"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "Currently only the C<is> attribute is supported.  And our C<is> also supports"
NSQ_SOURCE_LINE 00000451 "the \"wo\" value to make a write-only accessor."
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "If you are using the Moose-like interface then you should use the C<extends>"
NSQ_SOURCE_LINE 00000454 "rather than tweaking your C<@ISA> directly.  Basically, replace"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "  @ISA = qw/Foo Bar/;"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "with"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "  extends(qw/Foo Bar/);"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "=head1 DETAILS"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "An accessor generated by Class::Accessor looks something like"
NSQ_SOURCE_LINE 00000465 "this:"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "    # Your foo may vary."
NSQ_SOURCE_LINE 00000468 "    sub foo {"
NSQ_SOURCE_LINE 00000469 "        my($self) = shift;"
NSQ_SOURCE_LINE 00000470 "        if(@_) {    # set"
NSQ_SOURCE_LINE 00000471 "            return $self->set('foo', @_);"
NSQ_SOURCE_LINE 00000472 "        }"
NSQ_SOURCE_LINE 00000473 "        else {"
NSQ_SOURCE_LINE 00000474 "            return $self->get('foo');"
NSQ_SOURCE_LINE 00000475 "        }"
NSQ_SOURCE_LINE 00000476 "    }"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "Very simple.  All it does is determine if you're wanting to set a"
NSQ_SOURCE_LINE 00000479 "value or get a value and calls the appropriate method."
NSQ_SOURCE_LINE 00000480 "Class::Accessor provides default get() and set() methods which"
NSQ_SOURCE_LINE 00000481 "your class can override.  They're detailed later."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "=head2 Modifying the behavior of the accessor"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "Rather than actually modifying the accessor itself, it is much more"
NSQ_SOURCE_LINE 00000486 "sensible to simply override the two key methods which the accessor"
NSQ_SOURCE_LINE 00000487 "calls.  Namely set() and get()."
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "If you -really- want to, you can override make_accessor()."
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "=head2 set"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "    $obj->set($key, $value);"
NSQ_SOURCE_LINE 00000494 "    $obj->set($key, @values);"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "set() defines how generally one stores data in the object."
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "override this method to change how data is stored by your accessors."
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "=head2 get"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "    $value  = $obj->get($key);"
NSQ_SOURCE_LINE 00000503 "    @values = $obj->get(@keys);"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "get() defines how data is retrieved from your objects."
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "override this method to change how it is retrieved."
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=head2 make_accessor"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "    $accessor = __PACKAGE__->make_accessor($field);"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "Generates a subroutine reference which acts as an accessor for the given"
NSQ_SOURCE_LINE 00000514 "$field.  It calls get() and set()."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "If you wish to change the behavior of your accessors, try overriding"
NSQ_SOURCE_LINE 00000517 "get() and set() before you start mucking with make_accessor()."
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "=head2 make_ro_accessor"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "    $read_only_accessor = __PACKAGE__->make_ro_accessor($field);"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "Generates a subroutine reference which acts as a read-only accessor for"
NSQ_SOURCE_LINE 00000524 "the given $field.  It only calls get()."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "Override get() to change the behavior of your accessors."
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "=head2 make_wo_accessor"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "    $write_only_accessor = __PACKAGE__->make_wo_accessor($field);"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "Generates a subroutine reference which acts as a write-only accessor"
NSQ_SOURCE_LINE 00000533 "(mutator) for the given $field.  It only calls set()."
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "Override set() to change the behavior of your accessors."
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "=head1 EXCEPTIONS"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "If something goes wrong Class::Accessor will warn or die by calling Carp::carp"
NSQ_SOURCE_LINE 00000540 "or Carp::croak.  If you don't like this you can override _carp() and _croak() in"
NSQ_SOURCE_LINE 00000541 "your subclass and do whatever else you want."
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "=head1 EFFICIENCY"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "Class::Accessor does not employ an autoloader, thus it is much faster"
NSQ_SOURCE_LINE 00000546 "than you'd think.  Its generated methods incur no special penalty over"
NSQ_SOURCE_LINE 00000547 "ones you'd write yourself."
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "  accessors:"
NSQ_SOURCE_LINE 00000550 "              Rate  Basic   Fast Faster Direct"
NSQ_SOURCE_LINE 00000551 "  Basic   367589/s     --   -51%   -55%   -89%"
NSQ_SOURCE_LINE 00000552 "  Fast    747964/s   103%     --    -9%   -77%"
NSQ_SOURCE_LINE 00000553 "  Faster  819199/s   123%    10%     --   -75%"
NSQ_SOURCE_LINE 00000554 "  Direct 3245887/s   783%   334%   296%     --"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "  mutators:"
NSQ_SOURCE_LINE 00000557 "              Rate    Acc   Fast Faster Direct"
NSQ_SOURCE_LINE 00000558 "  Acc     265564/s     --   -54%   -63%   -91%"
NSQ_SOURCE_LINE 00000559 "  Fast    573439/s   116%     --   -21%   -80%"
NSQ_SOURCE_LINE 00000560 "  Faster  724710/s   173%    26%     --   -75%"
NSQ_SOURCE_LINE 00000561 "  Direct 2860979/s   977%   399%   295%     --"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "Class::Accessor::Fast is faster than methods written by an average programmer"
NSQ_SOURCE_LINE 00000564 "(where \"average\" is based on Schwern's example code)."
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "Class::Accessor is slower than average, but more flexible."
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "Class::Accessor::Faster is even faster than Class::Accessor::Fast.  It uses an"
NSQ_SOURCE_LINE 00000569 "array internally, not a hash.  This could be a good or bad feature depending on"
NSQ_SOURCE_LINE 00000570 "your point of view."
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "Direct hash access is, of course, much faster than all of these, but it"
NSQ_SOURCE_LINE 00000573 "provides no encapsulation."
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "Of course, it's not as simple as saying \"Class::Accessor is slower than"
NSQ_SOURCE_LINE 00000576 "average\".  These are benchmarks for a simple accessor.  If your accessors do"
NSQ_SOURCE_LINE 00000577 "any sort of complicated work (such as talking to a database or writing to a"
NSQ_SOURCE_LINE 00000578 "file) the time spent doing that work will quickly swamp the time spend just"
NSQ_SOURCE_LINE 00000579 "calling the accessor.  In that case, Class::Accessor and the ones you write"
NSQ_SOURCE_LINE 00000580 "will be roughly the same speed."
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "Here's an example of generating an accessor for every public field of"
NSQ_SOURCE_LINE 00000586 "your class."
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "    package Altoids;"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "    use base qw(Class::Accessor Class::Fields);"
NSQ_SOURCE_LINE 00000591 "    use fields qw(curiously strong mints);"
NSQ_SOURCE_LINE 00000592 "    Altoids->mk_accessors( Altoids->show_fields('Public') );"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "    sub new {"
NSQ_SOURCE_LINE 00000595 "        my $proto = shift;"
NSQ_SOURCE_LINE 00000596 "        my $class = ref $proto || $proto;"
NSQ_SOURCE_LINE 00000597 "        return fields::new($class);"
NSQ_SOURCE_LINE 00000598 "    }"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "    my Altoids $tin = Altoids->new;"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "    $tin->curiously('Curiouser and curiouser');"
NSQ_SOURCE_LINE 00000603 "    print $tin->{curiously};    # prints 'Curiouser and curiouser'"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "    # Subclassing works, too."
NSQ_SOURCE_LINE 00000607 "    package Mint::Snuff;"
NSQ_SOURCE_LINE 00000608 "    use base qw(Altoids);"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "    my Mint::Snuff $pouch = Mint::Snuff->new;"
NSQ_SOURCE_LINE 00000611 "    $pouch->strong('Blow your head off!');"
NSQ_SOURCE_LINE 00000612 "    print $pouch->{strong};     # prints 'Blow your head off!'"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "Here's a simple example of altering the behavior of your accessors."
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "    package Foo;"
NSQ_SOURCE_LINE 00000618 "    use base qw(Class::Accessor);"
NSQ_SOURCE_LINE 00000619 "    Foo->mk_accessors(qw(this that up down));"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "    sub get {"
NSQ_SOURCE_LINE 00000622 "        my $self = shift;"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "        # Note every time someone gets some data."
NSQ_SOURCE_LINE 00000625 "        print STDERR \"Getting @_\\n\";"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "        $self->SUPER::get(@_);"
NSQ_SOURCE_LINE 00000628 "    }"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "    sub set {"
NSQ_SOURCE_LINE 00000631 "        my ($self, $key) = splice(@_, 0, 2);"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "        # Note every time someone sets some data."
NSQ_SOURCE_LINE 00000634 "        print STDERR \"Setting $key to @_\\n\";"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "        $self->SUPER::set($key, @_);"
NSQ_SOURCE_LINE 00000637 "    }"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "=head1 CAVEATS AND TRICKS"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "Class::Accessor has to do some internal wackiness to get its"
NSQ_SOURCE_LINE 00000643 "job done quickly and efficiently.  Because of this, there's a few"
NSQ_SOURCE_LINE 00000644 "tricks and traps one must know about."
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "Hey, nothing's perfect."
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "=head2 Don't make a field called DESTROY"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "This is bad.  Since DESTROY is a magical method it would be bad for us"
NSQ_SOURCE_LINE 00000651 "to define an accessor using that name.  Class::Accessor will"
NSQ_SOURCE_LINE 00000652 "carp if you try to use it with a field named \"DESTROY\"."
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "=head2 Overriding autogenerated accessors"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "You may want to override the autogenerated accessor with your own, yet"
NSQ_SOURCE_LINE 00000657 "have your custom accessor call the default one.  For instance, maybe"
NSQ_SOURCE_LINE 00000658 "you want to have an accessor which checks its input.  Normally, one"
NSQ_SOURCE_LINE 00000659 "would expect this to work:"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "    package Foo;"
NSQ_SOURCE_LINE 00000662 "    use base qw(Class::Accessor);"
NSQ_SOURCE_LINE 00000663 "    Foo->mk_accessors(qw(email this that whatever));"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "    # Only accept addresses which look valid."
NSQ_SOURCE_LINE 00000666 "    sub email {"
NSQ_SOURCE_LINE 00000667 "        my($self) = shift;"
NSQ_SOURCE_LINE 00000668 "        my($email) = @_;"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "        if( @_ ) {  # Setting"
NSQ_SOURCE_LINE 00000671 "            require Email::Valid;"
NSQ_SOURCE_LINE 00000672 "            unless( Email::Valid->address($email) ) {"
NSQ_SOURCE_LINE 00000673 "                carp(\"$email doesn't look like a valid address.\");"
NSQ_SOURCE_LINE 00000674 "                return;"
NSQ_SOURCE_LINE 00000675 "            }"
NSQ_SOURCE_LINE 00000676 "        }"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "        return $self->SUPER::email(@_);"
NSQ_SOURCE_LINE 00000679 "    }"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "There's a subtle problem in the last example, and it's in this line:"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "    return $self->SUPER::email(@_);"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "If we look at how Foo was defined, it called mk_accessors() which"
NSQ_SOURCE_LINE 00000686 "stuck email() right into Foo's namespace.  There *is* no"
NSQ_SOURCE_LINE 00000687 "SUPER::email() to delegate to!  Two ways around this... first is to"
NSQ_SOURCE_LINE 00000688 "make a \"pure\" base class for Foo.  This pure class will generate the"
NSQ_SOURCE_LINE 00000689 "accessors and provide the necessary super class for Foo to use:"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "    package Pure::Organic::Foo;"
NSQ_SOURCE_LINE 00000692 "    use base qw(Class::Accessor);"
NSQ_SOURCE_LINE 00000693 "    Pure::Organic::Foo->mk_accessors(qw(email this that whatever));"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "    package Foo;"
NSQ_SOURCE_LINE 00000696 "    use base qw(Pure::Organic::Foo);"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "And now Foo::email() can override the generated"
NSQ_SOURCE_LINE 00000699 "Pure::Organic::Foo::email() and use it as SUPER::email()."
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "This is probably the most obvious solution to everyone but me."
NSQ_SOURCE_LINE 00000702 "Instead, what first made sense to me was for mk_accessors() to define"
NSQ_SOURCE_LINE 00000703 "an alias of email(), _email_accessor().  Using this solution,"
NSQ_SOURCE_LINE 00000704 "Foo::email() would be written with:"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "    return $self->_email_accessor(@_);"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "instead of the expected SUPER::email()."
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "=head1 AUTHORS"
