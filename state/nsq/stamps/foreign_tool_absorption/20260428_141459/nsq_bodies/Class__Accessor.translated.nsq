NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "See L<Class::Accessor::Fast> and L<Class::Accessor::Faster> if speed is more"
NSQ_SOURCE_LINE 00000734 "important than flexibility."
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "These are some modules which do similar things in different ways"
NSQ_SOURCE_LINE 00000737 "L<Class::Struct>, L<Class::Methodmaker>, L<Class::Generate>,"
NSQ_SOURCE_LINE 00000738 "L<Class::Class>, L<Class::Contract>, L<Moose>, L<Mouse>"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "See L<Class::DBI> for an example of this module in use."
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "=cut"
BODY_END
