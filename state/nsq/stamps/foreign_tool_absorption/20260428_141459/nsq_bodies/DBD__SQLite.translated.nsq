NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "package # hide from PAUSE"
NSQ_SOURCE_LINE 00000085 "    DBD::SQLite::dr;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "sub connect {"
NSQ_SOURCE_LINE 00000088 "    my ($drh, $dbname, $user, $auth, $attr) = @_;"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    # Default PrintWarn to the value of $^W"
NSQ_SOURCE_LINE 00000091 "    # unless ( defined $attr->{PrintWarn} ) {"
NSQ_SOURCE_LINE 00000092 "    #    $attr->{PrintWarn} = $^W ? 1 : 0;"
NSQ_SOURCE_LINE 00000093 "    # }"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    my $dbh = DBI::_new_dbh( $drh, {"
NSQ_SOURCE_LINE 00000096 "        Name => $dbname,"
NSQ_SOURCE_LINE 00000097 "    } );"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    my $real = $dbname;"
NSQ_SOURCE_LINE 00000100 "    if ( $dbname =~ /=/ ) {"
NSQ_SOURCE_LINE 00000101 "        foreach my $attrib ( split(/;/, $dbname) ) {"
NSQ_SOURCE_LINE 00000102 "            my ($key, $value) = split(/=/, $attrib, 2);"
NSQ_SOURCE_LINE 00000103 "            if ( $key =~ /^(?:db(?:name)?|database)$/ ) {"
NSQ_SOURCE_LINE 00000104 "                $real = $value;"
NSQ_SOURCE_LINE 00000105 "            } elsif ( $key eq 'uri' ) {"
NSQ_SOURCE_LINE 00000106 "                $real = $value;"
NSQ_SOURCE_LINE 00000107 "                $attr->{sqlite_open_flags} |= DBD::SQLite::OPEN_URI();"
NSQ_SOURCE_LINE 00000108 "            } else {"
NSQ_SOURCE_LINE 00000109 "                $attr->{$key} = $value;"
NSQ_SOURCE_LINE 00000110 "            }"
NSQ_SOURCE_LINE 00000111 "        }"
NSQ_SOURCE_LINE 00000112 "    }"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "    if (my $flags = $attr->{sqlite_open_flags}) {"
NSQ_SOURCE_LINE 00000115 "        unless ($flags & (DBD::SQLite::OPEN_READONLY() | DBD::SQLite::OPEN_READWRITE())) {"
NSQ_SOURCE_LINE 00000116 "            $attr->{sqlite_open_flags} |= DBD::SQLite::OPEN_READWRITE() | DBD::SQLite::OPEN_CREATE();"
NSQ_SOURCE_LINE 00000117 "        }"
NSQ_SOURCE_LINE 00000118 "    }"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "    # To avoid unicode and long file name problems on Windows,"
NSQ_SOURCE_LINE 00000121 "    # convert to the shortname if the file (or parent directory) exists."
NSQ_SOURCE_LINE 00000122 "    if ( $^O =~ /MSWin32/ and $real ne ':memory:' and $real ne '' and $real !~ /^file:/ and !-f $real ) {"
NSQ_SOURCE_LINE 00000123 "        require File::Basename;"
NSQ_SOURCE_LINE 00000124 "        my ($file, $dir, $suffix) = File::Basename::fileparse($real);"
NSQ_SOURCE_LINE 00000125 "        # We are creating a new file."
NSQ_SOURCE_LINE 00000126 "        # Does the directory it's in at least exist?"
NSQ_SOURCE_LINE 00000127 "        if ( -d $dir ) {"
NSQ_SOURCE_LINE 00000128 "            require Win32;"
NSQ_SOURCE_LINE 00000129 "            $real = join '', grep { defined } Win32::GetShortPathName($dir), $file, $suffix;"
NSQ_SOURCE_LINE 00000130 "        } else {"
NSQ_SOURCE_LINE 00000131 "            # SQLite can't do mkpath anyway."
NSQ_SOURCE_LINE 00000132 "            # So let it go through as it and fail."
NSQ_SOURCE_LINE 00000133 "        }"
NSQ_SOURCE_LINE 00000134 "    }"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    # Hand off to the actual login function"
NSQ_SOURCE_LINE 00000137 "    DBD::SQLite::db::_login($dbh, $real, $user, $auth, $attr) or return undef;"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    # Register the on-demand collation installer, REGEXP function and"
NSQ_SOURCE_LINE 00000140 "    # perl tokenizer"
NSQ_SOURCE_LINE 00000141 "    if ( DBD::SQLite::NEWAPI ) {"
NSQ_SOURCE_LINE 00000142 "        $dbh->sqlite_collation_needed( \\&install_collation );"
NSQ_SOURCE_LINE 00000143 "        $dbh->sqlite_create_function( \"REGEXP\", 2, \\&regexp );"
NSQ_SOURCE_LINE 00000144 "        $dbh->sqlite_register_fts3_perl_tokenizer();"
NSQ_SOURCE_LINE 00000145 "    } else {"
NSQ_SOURCE_LINE 00000146 "        $dbh->func( \\&install_collation, \"collation_needed\"  );"
NSQ_SOURCE_LINE 00000147 "        $dbh->func( \"REGEXP\", 2, \\&regexp, \"create_function\" );"
NSQ_SOURCE_LINE 00000148 "        $dbh->func( \"register_fts3_perl_tokenizer\" );"
NSQ_SOURCE_LINE 00000149 "    }"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    # HACK: Since PrintWarn = 0 doesn't seem to actually prevent warnings"
NSQ_SOURCE_LINE 00000152 "    # in DBD::SQLite we set Warn to false if PrintWarn is false."
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    # NOTE: According to the explanation by timbunce,"
NSQ_SOURCE_LINE 00000155 "    # \"Warn is meant to report on bad practices or problems with"
NSQ_SOURCE_LINE 00000156 "    # the DBI itself (hence always on by default), while PrintWarn"
NSQ_SOURCE_LINE 00000157 "    # is meant to report warnings coming from the database.\""
NSQ_SOURCE_LINE 00000158 "    # That is, if you want to disable an ineffective rollback warning"
NSQ_SOURCE_LINE 00000159 "    # etc (due to bad practices), you should turn off Warn,"
NSQ_SOURCE_LINE 00000160 "    # and to silence other warnings, turn off PrintWarn."
NSQ_SOURCE_LINE 00000161 "    # Warn and PrintWarn are independent, and turning off PrintWarn"
NSQ_SOURCE_LINE 00000162 "    # does not silence those warnings that should be controlled by"
NSQ_SOURCE_LINE 00000163 "    # Warn."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "    # unless ( $attr->{PrintWarn} ) {"
NSQ_SOURCE_LINE 00000166 "    #     $attr->{Warn} = 0;"
NSQ_SOURCE_LINE 00000167 "    # }"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    return $dbh;"
NSQ_SOURCE_LINE 00000170 "}"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "sub install_collation {"
NSQ_SOURCE_LINE 00000173 "    my $dbh       = shift;"
NSQ_SOURCE_LINE 00000174 "    my $name      = shift;"
NSQ_SOURCE_LINE 00000175 "    my $collation = $DBD::SQLite::COLLATION{$name};"
NSQ_SOURCE_LINE 00000176 "    unless ($collation) {"
NSQ_SOURCE_LINE 00000177 "        warn \"Can't install unknown collation: $name\" if $dbh->{PrintWarn};"
NSQ_SOURCE_LINE 00000178 "        return;"
NSQ_SOURCE_LINE 00000179 "    }"
NSQ_SOURCE_LINE 00000180 "    if ( DBD::SQLite::NEWAPI ) {"
NSQ_SOURCE_LINE 00000181 "        $dbh->sqlite_create_collation( $name => $collation );"
NSQ_SOURCE_LINE 00000182 "    } else {"
NSQ_SOURCE_LINE 00000183 "        $dbh->func( $name => $collation, \"create_collation\" );"
NSQ_SOURCE_LINE 00000184 "    }"
NSQ_SOURCE_LINE 00000185 "}"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "# default implementation for sqlite 'REGEXP' infix operator."
NSQ_SOURCE_LINE 00000188 "# Note : args are reversed, i.e. \"a REGEXP b\" calls REGEXP(b, a)"
NSQ_SOURCE_LINE 00000189 "# (see https://www.sqlite.org/vtab.html#xfindfunction)"
NSQ_SOURCE_LINE 00000190 "sub regexp {"
NSQ_SOURCE_LINE 00000191 "    use locale;"
NSQ_SOURCE_LINE 00000192 "    return if !defined $_[0] || !defined $_[1];"
NSQ_SOURCE_LINE 00000193 "    return scalar($_[1] =~ $_[0]);"
NSQ_SOURCE_LINE 00000194 "}"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "package # hide from PAUSE"
NSQ_SOURCE_LINE 00000197 "    DBD::SQLite::db;"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "use DBI qw/:sql_types/;"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "sub prepare {"
NSQ_SOURCE_LINE 00000202 "    my $dbh = shift;"
NSQ_SOURCE_LINE 00000203 "    my $sql = shift;"
NSQ_SOURCE_LINE 00000204 "    $sql = '' unless defined $sql;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    my $sth = DBI::_new_sth( $dbh, {"
NSQ_SOURCE_LINE 00000207 "        Statement => $sql,"
NSQ_SOURCE_LINE 00000208 "    } );"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    DBD::SQLite::st::_prepare($sth, $sql, @_) or return undef;"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "    return $sth;"
NSQ_SOURCE_LINE 00000213 "}"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "sub do {"
NSQ_SOURCE_LINE 00000216 "    my ($dbh, $statement, $attr, @bind_values) = @_;"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "    # shortcut"
NSQ_SOURCE_LINE 00000219 "    my $allow_multiple_statements = $dbh->FETCH('sqlite_allow_multiple_statements');"
NSQ_SOURCE_LINE 00000220 "    if  (defined $statement && !defined $attr && !@bind_values) {"
NSQ_SOURCE_LINE 00000221 "        # _do() (i.e. sqlite3_exec()) runs semicolon-separate SQL"
NSQ_SOURCE_LINE 00000222 "        # statements, which is handy but insecure sometimes."
NSQ_SOURCE_LINE 00000223 "        # Use this only when it's safe or explicitly allowed."
NSQ_SOURCE_LINE 00000224 "        if (index($statement, ';') == -1 or $allow_multiple_statements) {"
NSQ_SOURCE_LINE 00000225 "            return DBD::SQLite::db::_do($dbh, $statement);"
NSQ_SOURCE_LINE 00000226 "        }"
NSQ_SOURCE_LINE 00000227 "    }"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "    my @copy = @{[@bind_values]};"
NSQ_SOURCE_LINE 00000230 "    my $rows = 0;"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    while ($statement) {"
NSQ_SOURCE_LINE 00000233 "        my $sth = $dbh->prepare($statement, $attr) or return undef;"
NSQ_SOURCE_LINE 00000234 "        $sth->execute(splice @copy, 0, $sth->{NUM_OF_PARAMS}) or return undef;"
NSQ_SOURCE_LINE 00000235 "        $rows += $sth->rows;"
NSQ_SOURCE_LINE 00000236 "        # XXX: not sure why but $dbh->{sqlite...} wouldn't work here"
NSQ_SOURCE_LINE 00000237 "        last unless $allow_multiple_statements;"
NSQ_SOURCE_LINE 00000238 "        $statement = $sth->{sqlite_unprepared_statements};"
NSQ_SOURCE_LINE 00000239 "    }"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    # always return true if no error"
NSQ_SOURCE_LINE 00000242 "    return ($rows == 0) ? \"0E0\" : $rows;"
NSQ_SOURCE_LINE 00000243 "}"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "sub ping {"
NSQ_SOURCE_LINE 00000246 "    my $dbh = shift;"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "    # $file may be undef (ie. in-memory/temporary database)"
NSQ_SOURCE_LINE 00000249 "    my $file = DBD::SQLite::NEWAPI ? $dbh->sqlite_db_filename"
NSQ_SOURCE_LINE 00000250 "                                   : $dbh->func(\"db_filename\");"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    return 0 if $file && !-f $file;"
NSQ_SOURCE_LINE 00000253 "    return $dbh->FETCH('Active') ? 1 : 0;"
NSQ_SOURCE_LINE 00000254 "}"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "sub quote {"
NSQ_SOURCE_LINE 00000257 "    my ($self, $value, $data_type) = @_;"
NSQ_SOURCE_LINE 00000258 "    return \"NULL\" unless defined $value;"
NSQ_SOURCE_LINE 00000259 "    if (defined $data_type and ("
NSQ_SOURCE_LINE 00000260 "            $data_type == DBI::SQL_BIT ||"
NSQ_SOURCE_LINE 00000261 "            $data_type == DBI::SQL_BLOB ||"
NSQ_SOURCE_LINE 00000262 "            $data_type == DBI::SQL_BINARY ||"
NSQ_SOURCE_LINE 00000263 "            $data_type == DBI::SQL_VARBINARY ||"
NSQ_SOURCE_LINE 00000264 "            $data_type == DBI::SQL_LONGVARBINARY)) {"
NSQ_SOURCE_LINE 00000265 "        return q(X') . unpack('H*', $value) . q(');"
NSQ_SOURCE_LINE 00000266 "    }"
NSQ_SOURCE_LINE 00000267 "    $value =~ s/'/''/g;"
NSQ_SOURCE_LINE 00000268 "    return \"'$value'\";"
NSQ_SOURCE_LINE 00000269 "}"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "sub get_info {"
NSQ_SOURCE_LINE 00000272 "    my ($dbh, $info_type) = @_;"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "    require DBD::SQLite::GetInfo;"
NSQ_SOURCE_LINE 00000275 "    my $v = $DBD::SQLite::GetInfo::info{int($info_type)};"
NSQ_SOURCE_LINE 00000276 "    $v = $v->($dbh) if ref $v eq 'CODE';"
NSQ_SOURCE_LINE 00000277 "    return $v;"
NSQ_SOURCE_LINE 00000278 "}"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "sub _attached_database_list {"
NSQ_SOURCE_LINE 00000281 "    my $dbh = shift;"
NSQ_SOURCE_LINE 00000282 "    my @attached;"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    my $sth_databases = $dbh->prepare( 'PRAGMA database_list' ) or return;"
NSQ_SOURCE_LINE 00000285 "    $sth_databases->execute or return;"
NSQ_SOURCE_LINE 00000286 "    while ( my $db_info = $sth_databases->fetchrow_hashref ) {"
NSQ_SOURCE_LINE 00000287 "        push @attached, $db_info->{name} if $db_info->{seq} >= 2;"
NSQ_SOURCE_LINE 00000288 "    }"
NSQ_SOURCE_LINE 00000289 "    return @attached;"
NSQ_SOURCE_LINE 00000290 "}"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "# SQL/CLI (ISO/IEC JTC 1/SC 32 N 0595), 6.63 Tables"
NSQ_SOURCE_LINE 00000293 "# Based on DBD::Oracle's"
NSQ_SOURCE_LINE 00000294 "# See also http://www.ch-werner.de/sqliteodbc/html/sqlite3odbc_8c.html#a213"
NSQ_SOURCE_LINE 00000295 "sub table_info {"
NSQ_SOURCE_LINE 00000296 "    my ($dbh, $cat_val, $sch_val, $tbl_val, $typ_val, $attr) = @_;"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "    my @where = ();"
NSQ_SOURCE_LINE 00000299 "    my $sql;"
NSQ_SOURCE_LINE 00000300 "    if (  defined($cat_val) && $cat_val eq '%'"
NSQ_SOURCE_LINE 00000301 "       && defined($sch_val) && $sch_val eq ''"
NSQ_SOURCE_LINE 00000302 "       && defined($tbl_val) && $tbl_val eq '')  { # Rule 19a"
NSQ_SOURCE_LINE 00000303 "        $sql = <<'END_SQL';"
NSQ_SOURCE_LINE 00000304 "SELECT NULL TABLE_CAT"
NSQ_SOURCE_LINE 00000305 "     , NULL TABLE_SCHEM"
NSQ_SOURCE_LINE 00000306 "     , NULL TABLE_NAME"
NSQ_SOURCE_LINE 00000307 "     , NULL TABLE_TYPE"
NSQ_SOURCE_LINE 00000308 "     , NULL REMARKS"
NSQ_SOURCE_LINE 00000309 "END_SQL"
NSQ_SOURCE_LINE 00000310 "    }"
NSQ_SOURCE_LINE 00000311 "    elsif (  defined($cat_val) && $cat_val eq ''"
NSQ_SOURCE_LINE 00000312 "          && defined($sch_val) && $sch_val eq '%'"
NSQ_SOURCE_LINE 00000313 "          && defined($tbl_val) && $tbl_val eq '') { # Rule 19b"
NSQ_SOURCE_LINE 00000314 "        $sql = <<'END_SQL';"
NSQ_SOURCE_LINE 00000315 "SELECT NULL      TABLE_CAT"
NSQ_SOURCE_LINE 00000316 "     , t.tn      TABLE_SCHEM"
NSQ_SOURCE_LINE 00000317 "     , NULL      TABLE_NAME"
NSQ_SOURCE_LINE 00000318 "     , NULL      TABLE_TYPE"
NSQ_SOURCE_LINE 00000319 "     , NULL      REMARKS"
NSQ_SOURCE_LINE 00000320 "FROM ("
NSQ_SOURCE_LINE 00000321 "     SELECT 'main' tn"
NSQ_SOURCE_LINE 00000322 "     UNION SELECT 'temp' tn"
NSQ_SOURCE_LINE 00000323 "END_SQL"
NSQ_SOURCE_LINE 00000324 "        for my $db_name (_attached_database_list($dbh)) {"
NSQ_SOURCE_LINE 00000325 "            $sql .= \"     UNION SELECT '$db_name' tn\\n\";"
NSQ_SOURCE_LINE 00000326 "        }"
NSQ_SOURCE_LINE 00000327 "        $sql .= \") t\\n\";"
NSQ_SOURCE_LINE 00000328 "    }"
NSQ_SOURCE_LINE 00000329 "    elsif (  defined($cat_val) && $cat_val eq ''"
NSQ_SOURCE_LINE 00000330 "          && defined($sch_val) && $sch_val eq ''"
NSQ_SOURCE_LINE 00000331 "          && defined($tbl_val) && $tbl_val eq ''"
NSQ_SOURCE_LINE 00000332 "          && defined($typ_val) && $typ_val eq '%') { # Rule 19c"
NSQ_SOURCE_LINE 00000333 "        $sql = <<'END_SQL';"
NSQ_SOURCE_LINE 00000334 "SELECT NULL TABLE_CAT"
NSQ_SOURCE_LINE 00000335 "     , NULL TABLE_SCHEM"
NSQ_SOURCE_LINE 00000336 "     , NULL TABLE_NAME"
NSQ_SOURCE_LINE 00000337 "     , t.tt TABLE_TYPE"
NSQ_SOURCE_LINE 00000338 "     , NULL REMARKS"
NSQ_SOURCE_LINE 00000339 "FROM ("
NSQ_SOURCE_LINE 00000340 "     SELECT 'TABLE' tt                  UNION"
NSQ_SOURCE_LINE 00000341 "     SELECT 'VIEW' tt                   UNION"
NSQ_SOURCE_LINE 00000342 "     SELECT 'LOCAL TEMPORARY' tt        UNION"
NSQ_SOURCE_LINE 00000343 "     SELECT 'SYSTEM TABLE' tt"
NSQ_SOURCE_LINE 00000344 ") t"
NSQ_SOURCE_LINE 00000345 "ORDER BY TABLE_TYPE"
NSQ_SOURCE_LINE 00000346 "END_SQL"
NSQ_SOURCE_LINE 00000347 "    }"
NSQ_SOURCE_LINE 00000348 "    else {"
NSQ_SOURCE_LINE 00000349 "        $sql = <<'END_SQL';"
NSQ_SOURCE_LINE 00000350 "SELECT *"
NSQ_SOURCE_LINE 00000351 "FROM"
NSQ_SOURCE_LINE 00000352 "("
NSQ_SOURCE_LINE 00000353 "SELECT NULL         TABLE_CAT"
NSQ_SOURCE_LINE 00000354 "     ,              TABLE_SCHEM"
NSQ_SOURCE_LINE 00000355 "     , tbl_name     TABLE_NAME"
NSQ_SOURCE_LINE 00000356 "     ,              TABLE_TYPE"
NSQ_SOURCE_LINE 00000357 "     , NULL         REMARKS"
NSQ_SOURCE_LINE 00000358 "     , sql          sqlite_sql"
NSQ_SOURCE_LINE 00000359 "FROM ("
NSQ_SOURCE_LINE 00000360 "    SELECT 'main' TABLE_SCHEM, tbl_name, upper(type) TABLE_TYPE, sql"
NSQ_SOURCE_LINE 00000361 "    FROM sqlite_master"
NSQ_SOURCE_LINE 00000362 "UNION ALL"
NSQ_SOURCE_LINE 00000363 "    SELECT 'temp' TABLE_SCHEM, tbl_name, 'LOCAL TEMPORARY' TABLE_TYPE, sql"
NSQ_SOURCE_LINE 00000364 "    FROM sqlite_temp_master"
NSQ_SOURCE_LINE 00000365 "END_SQL"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "        for my $db_name (_attached_database_list($dbh)) {"
NSQ_SOURCE_LINE 00000368 "            $sql .= <<\"END_SQL\";"
NSQ_SOURCE_LINE 00000369 "UNION ALL"
NSQ_SOURCE_LINE 00000370 "    SELECT '$db_name' TABLE_SCHEM, tbl_name, upper(type) TABLE_TYPE, sql"
NSQ_SOURCE_LINE 00000371 "    FROM \"$db_name\".sqlite_master"
NSQ_SOURCE_LINE 00000372 "END_SQL"
NSQ_SOURCE_LINE 00000373 "        }"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "        $sql .= <<'END_SQL';"
NSQ_SOURCE_LINE 00000376 "UNION ALL"
NSQ_SOURCE_LINE 00000377 "    SELECT 'main' TABLE_SCHEM, 'sqlite_master'      tbl_name, 'SYSTEM TABLE' TABLE_TYPE, NULL sql"
NSQ_SOURCE_LINE 00000378 "UNION ALL"
NSQ_SOURCE_LINE 00000379 "    SELECT 'temp' TABLE_SCHEM, 'sqlite_temp_master' tbl_name, 'SYSTEM TABLE' TABLE_TYPE, NULL sql"
NSQ_SOURCE_LINE 00000380 ")"
NSQ_SOURCE_LINE 00000381 ")"
NSQ_SOURCE_LINE 00000382 "END_SQL"
NSQ_SOURCE_LINE 00000383 "        $attr = {} unless ref $attr eq 'HASH';"
NSQ_SOURCE_LINE 00000384 "        my $escape = defined $attr->{Escape} ? \" ESCAPE '$attr->{Escape}'\" : '';"
NSQ_SOURCE_LINE 00000385 "        if ( defined $sch_val ) {"
NSQ_SOURCE_LINE 00000386 "            push @where, \"TABLE_SCHEM LIKE '$sch_val'$escape\";"
NSQ_SOURCE_LINE 00000387 "        }"
NSQ_SOURCE_LINE 00000388 "        if ( defined $tbl_val ) {"
NSQ_SOURCE_LINE 00000389 "            push @where, \"TABLE_NAME LIKE '$tbl_val'$escape\";"
NSQ_SOURCE_LINE 00000390 "        }"
NSQ_SOURCE_LINE 00000391 "        if ( defined $typ_val ) {"
NSQ_SOURCE_LINE 00000392 "            my $table_type_list;"
NSQ_SOURCE_LINE 00000393 "            $typ_val =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00000394 "            $typ_val =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00000395 "            my @ttype_list = split (/\\s*,\\s*/, $typ_val);"
NSQ_SOURCE_LINE 00000396 "            foreach my $table_type (@ttype_list) {"
NSQ_SOURCE_LINE 00000397 "                if ($table_type !~ /^'.*'$/) {"
NSQ_SOURCE_LINE 00000398 "                    $table_type = \"'\" . $table_type . \"'\";"
NSQ_SOURCE_LINE 00000399 "                }"
NSQ_SOURCE_LINE 00000400 "            }"
NSQ_SOURCE_LINE 00000401 "            $table_type_list = join(', ', @ttype_list);"
NSQ_SOURCE_LINE 00000402 "            push @where, \"TABLE_TYPE IN (\\U$table_type_list)\" if $table_type_list;"
NSQ_SOURCE_LINE 00000403 "        }"
NSQ_SOURCE_LINE 00000404 "        $sql .= ' WHERE ' . join(\"\\n   AND \", @where ) . \"\\n\" if @where;"
NSQ_SOURCE_LINE 00000405 "        $sql .= \" ORDER BY TABLE_TYPE, TABLE_SCHEM, TABLE_NAME\\n\";"
NSQ_SOURCE_LINE 00000406 "    }"
NSQ_SOURCE_LINE 00000407 "    my $sth = $dbh->prepare($sql) or return undef;"
NSQ_SOURCE_LINE 00000408 "    $sth->execute or return undef;"
NSQ_SOURCE_LINE 00000409 "    $sth;"
NSQ_SOURCE_LINE 00000410 "}"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "sub primary_key_info {"
NSQ_SOURCE_LINE 00000413 "    my ($dbh, $catalog, $schema, $table, $attr) = @_;"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "    my $databases = $dbh->selectall_arrayref(\"PRAGMA database_list\", {Slice => {}});"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "    my @pk_info;"
NSQ_SOURCE_LINE 00000418 "    for my $database (@$databases) {"
NSQ_SOURCE_LINE 00000419 "        my $dbname = $database->{name};"
NSQ_SOURCE_LINE 00000420 "        next if defined $schema && $schema ne '%' && $schema ne $dbname;"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "        my $quoted_dbname = $dbh->quote_identifier($dbname);"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "        my $master_table ="
NSQ_SOURCE_LINE 00000425 "            ($dbname eq 'main') ? 'sqlite_master' :"
NSQ_SOURCE_LINE 00000426 "            ($dbname eq 'temp') ? 'sqlite_temp_master' :"
NSQ_SOURCE_LINE 00000427 "            $quoted_dbname.'.sqlite_master';"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "        my $sth = $dbh->prepare(\"SELECT name, sql FROM $master_table WHERE type = ?\") or return;"
NSQ_SOURCE_LINE 00000430 "        $sth->execute(\"table\") or return;"
NSQ_SOURCE_LINE 00000431 "        while(my $row = $sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000432 "            my $tbname = $row->{name};"
NSQ_SOURCE_LINE 00000433 "            next if defined $table && $table ne '%' && $table ne $tbname;"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "            my $quoted_tbname = $dbh->quote_identifier($tbname);"
NSQ_SOURCE_LINE 00000436 "            my $t_sth = $dbh->prepare(\"PRAGMA $quoted_dbname.table_xinfo($quoted_tbname)\") or return;"
NSQ_SOURCE_LINE 00000437 "            $t_sth->execute or return;"
NSQ_SOURCE_LINE 00000438 "            my @pk;"
NSQ_SOURCE_LINE 00000439 "            while(my $col = $t_sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000440 "                push @pk, $col->{name} if $col->{pk};"
NSQ_SOURCE_LINE 00000441 "            }"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "            # If there're multiple primary key columns, we need to"
NSQ_SOURCE_LINE 00000444 "            # find their order from one of the auto-generated unique"
NSQ_SOURCE_LINE 00000445 "            # indices (note that single column integer primary key"
NSQ_SOURCE_LINE 00000446 "            # doesn't create an index)."
NSQ_SOURCE_LINE 00000447 "            if (@pk > 1 and $row->{sql} =~ /\\bPRIMARY\\s+KEY\\s*\\(\\s*"
NSQ_SOURCE_LINE 00000448 "                ("
NSQ_SOURCE_LINE 00000449 "                    (?:"
NSQ_SOURCE_LINE 00000450 "                        ("
NSQ_SOURCE_LINE 00000451 "                            [a-z_][a-z0-9_]*"
NSQ_SOURCE_LINE 00000452 "                          | ([\"'`])(?:\\3\\3|(?!\\3).)+?\\3(?!\\3)"
NSQ_SOURCE_LINE 00000453 "                          | \\[[^\\]]+\\]"
NSQ_SOURCE_LINE 00000454 "                        )"
NSQ_SOURCE_LINE 00000455 "                        \\s*,\\s*"
NSQ_SOURCE_LINE 00000456 "                    )+"
NSQ_SOURCE_LINE 00000457 "                    ("
NSQ_SOURCE_LINE 00000458 "                        [a-z_][a-z0-9_]*"
NSQ_SOURCE_LINE 00000459 "                      | ([\"'`])(?:\\5\\5|(?!\\5).)+?\\5(?!\\5)"
NSQ_SOURCE_LINE 00000460 "                      | \\[[^\\]]+\\]"
NSQ_SOURCE_LINE 00000461 "                    )"
NSQ_SOURCE_LINE 00000462 "                )"
NSQ_SOURCE_LINE 00000463 "                    \\s*\\)/six) {"
NSQ_SOURCE_LINE 00000464 "                my $pk_sql = $1;"
NSQ_SOURCE_LINE 00000465 "                @pk = ();"
NSQ_SOURCE_LINE 00000466 "                while($pk_sql =~ /"
NSQ_SOURCE_LINE 00000467 "                    ("
NSQ_SOURCE_LINE 00000468 "                        [a-z_][a-z0-9_]*"
NSQ_SOURCE_LINE 00000469 "                      | ([\"'`])(?:\\2\\2|(?!\\2).)+?\\2(?!\\2)"
NSQ_SOURCE_LINE 00000470 "                      | \\[([^\\]]+)\\]"
NSQ_SOURCE_LINE 00000471 "                    )"
NSQ_SOURCE_LINE 00000472 "                    (?:\\s*,\\s*|$)"
NSQ_SOURCE_LINE 00000473 "                        /sixg) {"
NSQ_SOURCE_LINE 00000474 "                    my($col, $quote, $brack) = ($1, $2, $3);"
NSQ_SOURCE_LINE 00000475 "                    if ( defined $quote ) {"
NSQ_SOURCE_LINE 00000476 "                        # Dequote \"'`"
NSQ_SOURCE_LINE 00000477 "                        $col = substr $col, 1, -1;"
NSQ_SOURCE_LINE 00000478 "                        $col =~ s/$quote$quote/$quote/g;"
NSQ_SOURCE_LINE 00000479 "                    } elsif ( defined $brack ) {"
NSQ_SOURCE_LINE 00000480 "                        # Dequote []"
NSQ_SOURCE_LINE 00000481 "                        $col = $brack;"
NSQ_SOURCE_LINE 00000482 "                    }"
NSQ_SOURCE_LINE 00000483 "                    push @pk, $col;"
NSQ_SOURCE_LINE 00000484 "                }"
NSQ_SOURCE_LINE 00000485 "            }"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "            my $key_name = $row->{sql} =~ /\\bCONSTRAINT\\s+(\\S+|\"[^\"]+\")\\s+PRIMARY\\s+KEY\\s*\\(/i ? $1 : 'PRIMARY KEY';"
NSQ_SOURCE_LINE 00000488 "            my $key_seq = 0;"
NSQ_SOURCE_LINE 00000489 "            foreach my $pk_field (@pk) {"
NSQ_SOURCE_LINE 00000490 "                push @pk_info, {"
NSQ_SOURCE_LINE 00000491 "                    TABLE_SCHEM => $dbname,"
NSQ_SOURCE_LINE 00000492 "                    TABLE_NAME  => $tbname,"
NSQ_SOURCE_LINE 00000493 "                    COLUMN_NAME => $pk_field,"
NSQ_SOURCE_LINE 00000494 "                    KEY_SEQ     => ++$key_seq,"
NSQ_SOURCE_LINE 00000495 "                    PK_NAME     => $key_name,"
NSQ_SOURCE_LINE 00000496 "                };"
NSQ_SOURCE_LINE 00000497 "            }"
NSQ_SOURCE_LINE 00000498 "        }"
NSQ_SOURCE_LINE 00000499 "    }"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "    my $sponge = DBI->connect(\"DBI:Sponge:\", '','')"
NSQ_SOURCE_LINE 00000502 "        or return $dbh->DBI::set_err($DBI::err, \"DBI::Sponge: $DBI::errstr\");"
NSQ_SOURCE_LINE 00000503 "    my @names = qw(TABLE_CAT TABLE_SCHEM TABLE_NAME COLUMN_NAME KEY_SEQ PK_NAME);"
NSQ_SOURCE_LINE 00000504 "    my $sth = $sponge->prepare( \"primary_key_info\", {"
NSQ_SOURCE_LINE 00000505 "        rows          => [ map { [ @{$_}{@names} ] } @pk_info ],"
NSQ_SOURCE_LINE 00000506 "        NUM_OF_FIELDS => scalar @names,"
NSQ_SOURCE_LINE 00000507 "        NAME          => \\@names,"
NSQ_SOURCE_LINE 00000508 "    }) or return $dbh->DBI::set_err("
NSQ_SOURCE_LINE 00000509 "        $sponge->err,"
NSQ_SOURCE_LINE 00000510 "        $sponge->errstr,"
NSQ_SOURCE_LINE 00000511 "    );"
NSQ_SOURCE_LINE 00000512 "    return $sth;"
NSQ_SOURCE_LINE 00000513 "}"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "our %DBI_code_for_rule = ( # from DBI doc; curiously, they are not exported"
NSQ_SOURCE_LINE 00000517 "                           # by the DBI module."
NSQ_SOURCE_LINE 00000518 "  # codes for update/delete constraints"
NSQ_SOURCE_LINE 00000519 "  'CASCADE'             => 0,"
NSQ_SOURCE_LINE 00000520 "  'RESTRICT'            => 1,"
NSQ_SOURCE_LINE 00000521 "  'SET NULL'            => 2,"
NSQ_SOURCE_LINE 00000522 "  'NO ACTION'           => 3,"
NSQ_SOURCE_LINE 00000523 "  'SET DEFAULT'         => 4,"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "  # codes for deferrability"
NSQ_SOURCE_LINE 00000526 "  'INITIALLY DEFERRED'  => 5,"
NSQ_SOURCE_LINE 00000527 "  'INITIALLY IMMEDIATE' => 6,"
NSQ_SOURCE_LINE 00000528 "  'NOT DEFERRABLE'      => 7,"
NSQ_SOURCE_LINE 00000529 " );"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "my @FOREIGN_KEY_INFO_ODBC = ("
NSQ_SOURCE_LINE 00000533 "  'PKTABLE_CAT',       # The primary (unique) key table catalog identifier."
NSQ_SOURCE_LINE 00000534 "  'PKTABLE_SCHEM',     # The primary (unique) key table schema identifier."
NSQ_SOURCE_LINE 00000535 "  'PKTABLE_NAME',      # The primary (unique) key table identifier."
NSQ_SOURCE_LINE 00000536 "  'PKCOLUMN_NAME',     # The primary (unique) key column identifier."
NSQ_SOURCE_LINE 00000537 "  'FKTABLE_CAT',       # The foreign key table catalog identifier."
NSQ_SOURCE_LINE 00000538 "  'FKTABLE_SCHEM',     # The foreign key table schema identifier."
NSQ_SOURCE_LINE 00000539 "  'FKTABLE_NAME',      # The foreign key table identifier."
NSQ_SOURCE_LINE 00000540 "  'FKCOLUMN_NAME',     # The foreign key column identifier."
NSQ_SOURCE_LINE 00000541 "  'KEY_SEQ',           # The column sequence number (starting with 1)."
NSQ_SOURCE_LINE 00000542 "  'UPDATE_RULE',       # The referential action for the UPDATE rule."
NSQ_SOURCE_LINE 00000543 "  'DELETE_RULE',       # The referential action for the DELETE rule."
NSQ_SOURCE_LINE 00000544 "  'FK_NAME',           # The foreign key name."
NSQ_SOURCE_LINE 00000545 "  'PK_NAME',           # The primary (unique) key name."
NSQ_SOURCE_LINE 00000546 "  'DEFERRABILITY',     # The deferrability of the foreign key constraint."
NSQ_SOURCE_LINE 00000547 "  'UNIQUE_OR_PRIMARY', # qualifies the key referenced by the foreign key"
NSQ_SOURCE_LINE 00000548 ");"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "# Column names below are not used, but listed just for completeness's sake."
NSQ_SOURCE_LINE 00000551 "# Maybe we could add an option so that the user can choose which field"
NSQ_SOURCE_LINE 00000552 "# names will be returned; the DBI spec is not very clear about ODBC vs. CLI."
NSQ_SOURCE_LINE 00000553 "my @FOREIGN_KEY_INFO_SQL_CLI = qw("
NSQ_SOURCE_LINE 00000554 "  UK_TABLE_CAT "
NSQ_SOURCE_LINE 00000555 "  UK_TABLE_SCHEM"
NSQ_SOURCE_LINE 00000556 "  UK_TABLE_NAME"
NSQ_SOURCE_LINE 00000557 "  UK_COLUMN_NAME"
NSQ_SOURCE_LINE 00000558 "  FK_TABLE_CAT"
NSQ_SOURCE_LINE 00000559 "  FK_TABLE_SCHEM"
NSQ_SOURCE_LINE 00000560 "  FK_TABLE_NAME"
NSQ_SOURCE_LINE 00000561 "  FK_COLUMN_NAME"
NSQ_SOURCE_LINE 00000562 "  ORDINAL_POSITION"
NSQ_SOURCE_LINE 00000563 "  UPDATE_RULE"
NSQ_SOURCE_LINE 00000564 "  DELETE_RULE"
NSQ_SOURCE_LINE 00000565 "  FK_NAME"
NSQ_SOURCE_LINE 00000566 "  UK_NAME"
NSQ_SOURCE_LINE 00000567 "  DEFERABILITY"
NSQ_SOURCE_LINE 00000568 "  UNIQUE_OR_PRIMARY"
NSQ_SOURCE_LINE 00000569 " );"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "my $DEFERRABLE_RE = qr/"
NSQ_SOURCE_LINE 00000572 "    (?:(?:"
NSQ_SOURCE_LINE 00000573 "        on \\s+ (?:delete|update) \\s+ (?:set \\s+ null|set \\s+ default|cascade|restrict|no \\s+ action)"
NSQ_SOURCE_LINE 00000574 "    |"
NSQ_SOURCE_LINE 00000575 "        match \\s* (?:\\S+|\".+?(?<!\")\")"
NSQ_SOURCE_LINE 00000576 "    ) \\s*)*"
NSQ_SOURCE_LINE 00000577 "    ((?:not)? \\s* deferrable (?: \\s* initially \\s* (?: immediate | deferred))?)?"
NSQ_SOURCE_LINE 00000578 "/sxi;"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "sub foreign_key_info {"
NSQ_SOURCE_LINE 00000581 "    my ($dbh, $pk_catalog, $pk_schema, $pk_table, $fk_catalog, $fk_schema, $fk_table) = @_;"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "    my $databases = $dbh->selectall_arrayref(\"PRAGMA database_list\", {Slice => {}}) or return;"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "    my @fk_info;"
NSQ_SOURCE_LINE 00000586 "    my %table_info;"
NSQ_SOURCE_LINE 00000587 "    for my $database (@$databases) {"
NSQ_SOURCE_LINE 00000588 "        my $dbname = $database->{name};"
NSQ_SOURCE_LINE 00000589 "        next if defined $fk_schema && $fk_schema ne '%' && $fk_schema ne $dbname;"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "        my $quoted_dbname = $dbh->quote_identifier($dbname);"
NSQ_SOURCE_LINE 00000592 "        my $master_table ="
NSQ_SOURCE_LINE 00000593 "            ($dbname eq 'main') ? 'sqlite_master' :"
NSQ_SOURCE_LINE 00000594 "            ($dbname eq 'temp') ? 'sqlite_temp_master' :"
NSQ_SOURCE_LINE 00000595 "            $quoted_dbname.'.sqlite_master';"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "        my $tables = $dbh->selectall_arrayref(\"SELECT name, sql FROM $master_table WHERE type = ?\", undef, \"table\") or return;"
NSQ_SOURCE_LINE 00000598 "        for my $table (@$tables) {"
NSQ_SOURCE_LINE 00000599 "            my $tbname = $table->[0];"
NSQ_SOURCE_LINE 00000600 "            my $ddl = $table->[1];"
NSQ_SOURCE_LINE 00000601 "            my (@rels, %relid2rels);"
NSQ_SOURCE_LINE 00000602 "            next if defined $fk_table && $fk_table ne '%' && $fk_table ne $tbname;"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "            my $quoted_tbname = $dbh->quote_identifier($tbname);"
NSQ_SOURCE_LINE 00000605 "            my $sth = $dbh->prepare(\"PRAGMA $quoted_dbname.foreign_key_list($quoted_tbname)\") or return;"
NSQ_SOURCE_LINE 00000606 "            $sth->execute or return;"
NSQ_SOURCE_LINE 00000607 "            while(my $row = $sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000608 "                next if defined $pk_table && $pk_table ne '%' && $pk_table ne $row->{table};"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "                unless ($table_info{$row->{table}}) {"
NSQ_SOURCE_LINE 00000611 "                    my $quoted_tb = $dbh->quote_identifier($row->{table});"
NSQ_SOURCE_LINE 00000612 "                    for my $db (@$databases) {"
NSQ_SOURCE_LINE 00000613 "                        my $quoted_db = $dbh->quote_identifier($db->{name});"
NSQ_SOURCE_LINE 00000614 "                        my $t_sth = $dbh->prepare(\"PRAGMA $quoted_db.table_xinfo($quoted_tb)\") or return;"
NSQ_SOURCE_LINE 00000615 "                        $t_sth->execute or return;"
NSQ_SOURCE_LINE 00000616 "                        my $cols = {};"
NSQ_SOURCE_LINE 00000617 "                        while(my $r = $t_sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000618 "                            $cols->{$r->{name}} = $r->{pk};"
NSQ_SOURCE_LINE 00000619 "                        }"
NSQ_SOURCE_LINE 00000620 "                        if (keys %$cols) {"
NSQ_SOURCE_LINE 00000621 "                            $table_info{$row->{table}} = {"
NSQ_SOURCE_LINE 00000622 "                                schema  => $db->{name},"
NSQ_SOURCE_LINE 00000623 "                                columns => $cols,"
NSQ_SOURCE_LINE 00000624 "                            };"
NSQ_SOURCE_LINE 00000625 "                            last;"
NSQ_SOURCE_LINE 00000626 "                        }"
NSQ_SOURCE_LINE 00000627 "                    }"
NSQ_SOURCE_LINE 00000628 "                }"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "                next if defined $pk_schema && $pk_schema ne '%' && $pk_schema ne $table_info{$row->{table}}{schema};"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "                # cribbed from DBIx::Class::Schema::Loader::DBI::SQLite"
NSQ_SOURCE_LINE 00000633 "                my $rel = $rels[ $row->{id} ] ||= {"
NSQ_SOURCE_LINE 00000634 "                    local_columns => [],"
NSQ_SOURCE_LINE 00000635 "                    remote_columns => undef,"
NSQ_SOURCE_LINE 00000636 "                    remote_table => $row->{table},"
NSQ_SOURCE_LINE 00000637 "                };"
NSQ_SOURCE_LINE 00000638 "                push @{ $rel->{local_columns} }, $row->{from};"
NSQ_SOURCE_LINE 00000639 "                push @{ $rel->{remote_columns} }, $row->{to}"
NSQ_SOURCE_LINE 00000640 "                    if defined $row->{to};"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "                my $fk_row = {"
NSQ_SOURCE_LINE 00000643 "                    PKTABLE_CAT   => undef,"
NSQ_SOURCE_LINE 00000644 "                    PKTABLE_SCHEM => $table_info{$row->{table}}{schema},"
NSQ_SOURCE_LINE 00000645 "                    PKTABLE_NAME  => $row->{table},"
NSQ_SOURCE_LINE 00000646 "                    PKCOLUMN_NAME => $row->{to},"
NSQ_SOURCE_LINE 00000647 "                    FKTABLE_CAT   => undef,"
NSQ_SOURCE_LINE 00000648 "                    FKTABLE_SCHEM => $dbname,"
NSQ_SOURCE_LINE 00000649 "                    FKTABLE_NAME  => $tbname,"
NSQ_SOURCE_LINE 00000650 "                    FKCOLUMN_NAME => $row->{from},"
NSQ_SOURCE_LINE 00000651 "                    KEY_SEQ       => $row->{seq} + 1,"
NSQ_SOURCE_LINE 00000652 "                    UPDATE_RULE   => $DBI_code_for_rule{$row->{on_update}},"
NSQ_SOURCE_LINE 00000653 "                    DELETE_RULE   => $DBI_code_for_rule{$row->{on_delete}},"
NSQ_SOURCE_LINE 00000654 "                    FK_NAME       => undef,"
NSQ_SOURCE_LINE 00000655 "                    PK_NAME       => undef,"
NSQ_SOURCE_LINE 00000656 "                    DEFERRABILITY => undef,"
NSQ_SOURCE_LINE 00000657 "                    UNIQUE_OR_PRIMARY => $table_info{$row->{table}}{columns}{$row->{to}} ? 'PRIMARY' : 'UNIQUE',"
NSQ_SOURCE_LINE 00000658 "                };"
NSQ_SOURCE_LINE 00000659 "                push @fk_info, $fk_row;"
NSQ_SOURCE_LINE 00000660 "                push @{ $relid2rels{$row->{id}} }, $fk_row; # keep so can fixup"
NSQ_SOURCE_LINE 00000661 "            }"
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "            # cribbed from DBIx::Class::Schema::Loader::DBI::SQLite"
NSQ_SOURCE_LINE 00000664 "            # but with additional parsing of which kind of deferrable"
NSQ_SOURCE_LINE 00000665 "            REL: for my $relid (keys %relid2rels) {"
NSQ_SOURCE_LINE 00000666 "                my $rel = $rels[$relid];"
NSQ_SOURCE_LINE 00000667 "                my $deferrable = $DBI_code_for_rule{'NOT DEFERRABLE'};"
NSQ_SOURCE_LINE 00000668 "                my $local_cols  = '\"?' . (join '\"? \\s* , \\s* \"?', map quotemeta, @{ $rel->{local_columns} })        . '\"?';"
NSQ_SOURCE_LINE 00000669 "                my $remote_cols = '\"?' . (join '\"? \\s* , \\s* \"?', map quotemeta, @{ $rel->{remote_columns} || [] }) . '\"?';"
NSQ_SOURCE_LINE 00000670 "                my ($deferrable_clause) = $ddl =~ /"
NSQ_SOURCE_LINE 00000671 "                        foreign \\s+ key \\s* \\( \\s* $local_cols \\s* \\) \\s* references \\s* (?:\\S+|\".+?(?<!\")\") \\s*"
NSQ_SOURCE_LINE 00000672 "                        (?:\\( \\s* $remote_cols \\s* \\) \\s*)?"
NSQ_SOURCE_LINE 00000673 "                        $DEFERRABLE_RE"
NSQ_SOURCE_LINE 00000674 "                /sxi;"
NSQ_SOURCE_LINE 00000675 "                if (!$deferrable_clause) {"
NSQ_SOURCE_LINE 00000676 "                    # check for inline constraint if 1 local column"
NSQ_SOURCE_LINE 00000677 "                    if (@{ $rel->{local_columns} } == 1) {"
NSQ_SOURCE_LINE 00000678 "                        my ($local_col)  = @{ $rel->{local_columns} };"
NSQ_SOURCE_LINE 00000679 "                        my ($remote_col) = @{ $rel->{remote_columns} || [] };"
NSQ_SOURCE_LINE 00000680 "                        $remote_col ||= '';"
NSQ_SOURCE_LINE 00000681 "                        ($deferrable_clause) = $ddl =~ /"
NSQ_SOURCE_LINE 00000682 "                            \"?\\Q$local_col\\E\"? \\s* (?:\\w+\\s*)* (?: \\( \\s* \\d\\+ (?:\\s*,\\s*\\d+)* \\s* \\) )? \\s*"
NSQ_SOURCE_LINE 00000683 "                            references \\s+ (?:\\S+|\".+?(?<!\")\") (?:\\s* \\( \\s* \"?\\Q$remote_col\\E\"? \\s* \\))? \\s*"
NSQ_SOURCE_LINE 00000684 "                            $DEFERRABLE_RE"
NSQ_SOURCE_LINE 00000685 "                        /sxi;"
NSQ_SOURCE_LINE 00000686 "                    }"
NSQ_SOURCE_LINE 00000687 "                }"
NSQ_SOURCE_LINE 00000688 "                if ($deferrable_clause) {"
NSQ_SOURCE_LINE 00000689 "                    # default is already NOT"
NSQ_SOURCE_LINE 00000690 "                    if ($deferrable_clause !~ /not/i) {"
NSQ_SOURCE_LINE 00000691 "                        $deferrable = $deferrable_clause =~ /deferred/i"
NSQ_SOURCE_LINE 00000692 "                            ? $DBI_code_for_rule{'INITIALLY DEFERRED'}"
NSQ_SOURCE_LINE 00000693 "                            : $DBI_code_for_rule{'INITIALLY IMMEDIATE'};"
NSQ_SOURCE_LINE 00000694 "                    }"
NSQ_SOURCE_LINE 00000695 "                }"
NSQ_SOURCE_LINE 00000696 "                $_->{DEFERRABILITY} = $deferrable for @{ $relid2rels{$relid} };"
NSQ_SOURCE_LINE 00000697 "            }"
NSQ_SOURCE_LINE 00000698 "        }"
NSQ_SOURCE_LINE 00000699 "    }"
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "    my $sponge_dbh = DBI->connect(\"DBI:Sponge:\", \"\", \"\")"
NSQ_SOURCE_LINE 00000702 "        or return $dbh->DBI::set_err($DBI::err, \"DBI::Sponge: $DBI::errstr\");"
NSQ_SOURCE_LINE 00000703 "    my $sponge_sth = $sponge_dbh->prepare(\"foreign_key_info\", {"
NSQ_SOURCE_LINE 00000704 "        NAME          => \\@FOREIGN_KEY_INFO_ODBC,"
NSQ_SOURCE_LINE 00000705 "        rows          => [ map { [@{$_}{@FOREIGN_KEY_INFO_ODBC} ] } @fk_info ],"
NSQ_SOURCE_LINE 00000706 "        NUM_OF_FIELDS => scalar(@FOREIGN_KEY_INFO_ODBC),"
NSQ_SOURCE_LINE 00000707 "    }) or return $dbh->DBI::set_err("
NSQ_SOURCE_LINE 00000708 "        $sponge_dbh->err,"
NSQ_SOURCE_LINE 00000709 "        $sponge_dbh->errstr,"
NSQ_SOURCE_LINE 00000710 "    );"
NSQ_SOURCE_LINE 00000711 "    return $sponge_sth;"
NSQ_SOURCE_LINE 00000712 "}"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "my @STATISTICS_INFO_ODBC = ("
NSQ_SOURCE_LINE 00000715 "  'TABLE_CAT',        # The catalog identifier."
NSQ_SOURCE_LINE 00000716 "  'TABLE_SCHEM',      # The schema identifier."
NSQ_SOURCE_LINE 00000717 "  'TABLE_NAME',       # The table identifier."
NSQ_SOURCE_LINE 00000718 "  'NON_UNIQUE',       # Unique index indicator."
NSQ_SOURCE_LINE 00000719 "  'INDEX_QUALIFIER',  # Index qualifier identifier."
NSQ_SOURCE_LINE 00000720 "  'INDEX_NAME',       # The index identifier."
NSQ_SOURCE_LINE 00000721 "  'TYPE',             # The type of information being returned."
NSQ_SOURCE_LINE 00000722 "  'ORDINAL_POSITION', # Column sequence number (starting with 1)."
NSQ_SOURCE_LINE 00000723 "  'COLUMN_NAME',      # The column identifier."
NSQ_SOURCE_LINE 00000724 "  'ASC_OR_DESC',      # Column sort sequence."
NSQ_SOURCE_LINE 00000725 "  'CARDINALITY',      # Cardinality of the table or index."
NSQ_SOURCE_LINE 00000726 "  'PAGES',            # Number of storage pages used by this table or index."
NSQ_SOURCE_LINE 00000727 "  'FILTER_CONDITION', # The index filter condition as a string."
NSQ_SOURCE_LINE 00000728 ");"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "sub statistics_info {"
NSQ_SOURCE_LINE 00000731 "    my ($dbh, $catalog, $schema, $table, $unique_only, $quick) = @_;"
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "    my $databases = $dbh->selectall_arrayref(\"PRAGMA database_list\", {Slice => {}}) or return;"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "    my @statistics_info;"
NSQ_SOURCE_LINE 00000736 "    for my $database (@$databases) {"
NSQ_SOURCE_LINE 00000737 "        my $dbname = $database->{name};"
NSQ_SOURCE_LINE 00000738 "        next if defined $schema && $schema ne '%' && $schema ne $dbname;"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "        my $quoted_dbname = $dbh->quote_identifier($dbname);"
NSQ_SOURCE_LINE 00000741 "        my $master_table ="
NSQ_SOURCE_LINE 00000742 "            ($dbname eq 'main') ? 'sqlite_master' :"
NSQ_SOURCE_LINE 00000743 "            ($dbname eq 'temp') ? 'sqlite_temp_master' :"
NSQ_SOURCE_LINE 00000744 "            $quoted_dbname.'.sqlite_master';"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "        my $tables = $dbh->selectall_arrayref(\"SELECT name FROM $master_table WHERE type = ?\", undef, \"table\") or return;"
NSQ_SOURCE_LINE 00000747 "        for my $table_ref (@$tables) {"
NSQ_SOURCE_LINE 00000748 "            my $tbname = $table_ref->[0];"
NSQ_SOURCE_LINE 00000749 "            next if defined $table && $table ne '%' && uc($table) ne uc($tbname);"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "            my $quoted_tbname = $dbh->quote_identifier($tbname);"
NSQ_SOURCE_LINE 00000752 "            my $sth = $dbh->prepare(\"PRAGMA $quoted_dbname.index_list($quoted_tbname)\") or return;"
NSQ_SOURCE_LINE 00000753 "            $sth->execute or return;"
NSQ_SOURCE_LINE 00000754 "            while(my $row = $sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "                next if $unique_only && !$row->{unique};"
NSQ_SOURCE_LINE 00000757 "                my $quoted_idx = $dbh->quote_identifier($row->{name});"
NSQ_SOURCE_LINE 00000758 "                for my $db (@$databases) {"
NSQ_SOURCE_LINE 00000759 "                    my $quoted_db = $dbh->quote_identifier($db->{name});"
NSQ_SOURCE_LINE 00000760 "                    my $i_sth = $dbh->prepare(\"PRAGMA $quoted_db.index_info($quoted_idx)\") or return;"
NSQ_SOURCE_LINE 00000761 "                    $i_sth->execute or return;"
NSQ_SOURCE_LINE 00000762 "                    my $cols = {};"
NSQ_SOURCE_LINE 00000763 "                    while(my $info = $i_sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000764 "                        push @statistics_info, {"
NSQ_SOURCE_LINE 00000765 "                            TABLE_CAT   => undef,"
NSQ_SOURCE_LINE 00000766 "                            TABLE_SCHEM => $db->{name},"
NSQ_SOURCE_LINE 00000767 "                            TABLE_NAME  => $tbname,"
NSQ_SOURCE_LINE 00000768 "                            NON_UNIQUE    => $row->{unique} ? 0 : 1, "
NSQ_SOURCE_LINE 00000769 "                            INDEX_QUALIFIER => undef,"
NSQ_SOURCE_LINE 00000770 "                            INDEX_NAME      => $row->{name},"
NSQ_SOURCE_LINE 00000771 "                            TYPE            => 'btree', # see https://www.sqlite.org/version3.html esp. \"Traditional B-trees are still used for indices\""
NSQ_SOURCE_LINE 00000772 "                            ORDINAL_POSITION => $info->{seqno} + 1,"
NSQ_SOURCE_LINE 00000773 "                            COLUMN_NAME      => $info->{name},"
NSQ_SOURCE_LINE 00000774 "                            ASC_OR_DESC      => undef,"
NSQ_SOURCE_LINE 00000775 "                            CARDINALITY      => undef,"
NSQ_SOURCE_LINE 00000776 "                            PAGES            => undef,"
NSQ_SOURCE_LINE 00000777 "                            FILTER_CONDITION => undef,"
NSQ_SOURCE_LINE 00000778 "                       };"
NSQ_SOURCE_LINE 00000779 "                    }"
NSQ_SOURCE_LINE 00000780 "                }"
NSQ_SOURCE_LINE 00000781 "            }"
NSQ_SOURCE_LINE 00000782 "        }"
NSQ_SOURCE_LINE 00000783 "    }"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "    my $sponge_dbh = DBI->connect(\"DBI:Sponge:\", \"\", \"\")"
NSQ_SOURCE_LINE 00000786 "        or return $dbh->DBI::set_err($DBI::err, \"DBI::Sponge: $DBI::errstr\");"
NSQ_SOURCE_LINE 00000787 "    my $sponge_sth = $sponge_dbh->prepare(\"statistics_info\", {"
NSQ_SOURCE_LINE 00000788 "        NAME          => \\@STATISTICS_INFO_ODBC,"
NSQ_SOURCE_LINE 00000789 "        rows          => [ map { [@{$_}{@STATISTICS_INFO_ODBC} ] } @statistics_info ],"
NSQ_SOURCE_LINE 00000790 "        NUM_OF_FIELDS => scalar(@STATISTICS_INFO_ODBC),"
NSQ_SOURCE_LINE 00000791 "    }) or return $dbh->DBI::set_err("
NSQ_SOURCE_LINE 00000792 "        $sponge_dbh->err,"
NSQ_SOURCE_LINE 00000793 "        $sponge_dbh->errstr,"
NSQ_SOURCE_LINE 00000794 "    );"
NSQ_SOURCE_LINE 00000795 "    return $sponge_sth;"
NSQ_SOURCE_LINE 00000796 "}"
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 "my @TypeInfoKeys = qw/"
NSQ_SOURCE_LINE 00000799 "    TYPE_NAME"
NSQ_SOURCE_LINE 00000800 "    DATA_TYPE"
NSQ_SOURCE_LINE 00000801 "    COLUMN_SIZE"
NSQ_SOURCE_LINE 00000802 "    LITERAL_PREFIX"
NSQ_SOURCE_LINE 00000803 "    LITERAL_SUFFIX"
NSQ_SOURCE_LINE 00000804 "    CREATE_PARAMS"
NSQ_SOURCE_LINE 00000805 "    NULLABLE"
NSQ_SOURCE_LINE 00000806 "    CASE_SENSITIVE"
NSQ_SOURCE_LINE 00000807 "    SEARCHABLE"
NSQ_SOURCE_LINE 00000808 "    UNSIGNED_ATTRIBUTE"
NSQ_SOURCE_LINE 00000809 "    FIXED_PREC_SCALE"
NSQ_SOURCE_LINE 00000810 "    AUTO_UNIQUE_VALUE"
NSQ_SOURCE_LINE 00000811 "    LOCAL_TYPE_NAME"
NSQ_SOURCE_LINE 00000812 "    MINIMUM_SCALE"
NSQ_SOURCE_LINE 00000813 "    MAXIMUM_SCALE"
NSQ_SOURCE_LINE 00000814 "    SQL_DATA_TYPE"
NSQ_SOURCE_LINE 00000815 "    SQL_DATETIME_SUB"
NSQ_SOURCE_LINE 00000816 "    NUM_PREC_RADIX"
NSQ_SOURCE_LINE 00000817 "    INTERVAL_PRECISION"
NSQ_SOURCE_LINE 00000818 "/;"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "my %TypeInfo = ("
NSQ_SOURCE_LINE 00000821 "    SQL_INTEGER ,=> {"
NSQ_SOURCE_LINE 00000822 "        TYPE_NAME => 'INTEGER',"
NSQ_SOURCE_LINE 00000823 "        DATA_TYPE => SQL_INTEGER,"
NSQ_SOURCE_LINE 00000824 "        NULLABLE => 2, # no for integer primary key, otherwise yes"
NSQ_SOURCE_LINE 00000825 "        SEARCHABLE => 3,"
NSQ_SOURCE_LINE 00000826 "    },"
NSQ_SOURCE_LINE 00000827 "    SQL_DOUBLE ,=> {"
NSQ_SOURCE_LINE 00000828 "        TYPE_NAME => 'REAL',"
NSQ_SOURCE_LINE 00000829 "        DATA_TYPE => SQL_DOUBLE,"
NSQ_SOURCE_LINE 00000830 "        NULLABLE => 1,"
NSQ_SOURCE_LINE 00000831 "        SEARCHABLE => 3,"
NSQ_SOURCE_LINE 00000832 "    },"
NSQ_SOURCE_LINE 00000833 "    SQL_VARCHAR ,=> {"
NSQ_SOURCE_LINE 00000834 "        TYPE_NAME => 'TEXT',"
NSQ_SOURCE_LINE 00000835 "        DATA_TYPE => SQL_VARCHAR,"
NSQ_SOURCE_LINE 00000836 "        LITERAL_PREFIX => \"'\","
NSQ_SOURCE_LINE 00000837 "        LITERAL_SUFFIX => \"'\","
NSQ_SOURCE_LINE 00000838 "        NULLABLE => 1,"
NSQ_SOURCE_LINE 00000839 "        SEARCHABLE => 3,"
NSQ_SOURCE_LINE 00000840 "    },"
NSQ_SOURCE_LINE 00000841 "    SQL_BLOB ,=> {"
NSQ_SOURCE_LINE 00000842 "        TYPE_NAME => 'BLOB',"
NSQ_SOURCE_LINE 00000843 "        DATA_TYPE => SQL_BLOB,"
NSQ_SOURCE_LINE 00000844 "        NULLABLE => 1,"
NSQ_SOURCE_LINE 00000845 "        SEARCHABLE => 3,"
NSQ_SOURCE_LINE 00000846 "    },"
NSQ_SOURCE_LINE 00000847 "    SQL_UNKNOWN_TYPE ,=> {"
NSQ_SOURCE_LINE 00000848 "        DATA_TYPE => SQL_UNKNOWN_TYPE,"
NSQ_SOURCE_LINE 00000849 "    },"
NSQ_SOURCE_LINE 00000850 ");"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "sub type_info_all {"
NSQ_SOURCE_LINE 00000853 "    my $idx = 0;"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "    my @info = ({map {$_ => $idx++} @TypeInfoKeys});"
NSQ_SOURCE_LINE 00000856 "    for my $id (sort {$a <=> $b} keys %TypeInfo) {"
NSQ_SOURCE_LINE 00000857 "        push @info, [map {$TypeInfo{$id}{$_}} @TypeInfoKeys];"
NSQ_SOURCE_LINE 00000858 "    }"
NSQ_SOURCE_LINE 00000859 "    return \\@info;"
NSQ_SOURCE_LINE 00000860 "}"
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "my @COLUMN_INFO = qw("
NSQ_SOURCE_LINE 00000863 "    TABLE_CAT"
NSQ_SOURCE_LINE 00000864 "    TABLE_SCHEM"
NSQ_SOURCE_LINE 00000865 "    TABLE_NAME"
NSQ_SOURCE_LINE 00000866 "    COLUMN_NAME"
NSQ_SOURCE_LINE 00000867 "    DATA_TYPE"
NSQ_SOURCE_LINE 00000868 "    TYPE_NAME"
NSQ_SOURCE_LINE 00000869 "    COLUMN_SIZE"
NSQ_SOURCE_LINE 00000870 "    BUFFER_LENGTH"
NSQ_SOURCE_LINE 00000871 "    DECIMAL_DIGITS"
NSQ_SOURCE_LINE 00000872 "    NUM_PREC_RADIX"
NSQ_SOURCE_LINE 00000873 "    NULLABLE"
NSQ_SOURCE_LINE 00000874 "    REMARKS"
NSQ_SOURCE_LINE 00000875 "    COLUMN_DEF"
NSQ_SOURCE_LINE 00000876 "    SQL_DATA_TYPE"
NSQ_SOURCE_LINE 00000877 "    SQL_DATETIME_SUB"
NSQ_SOURCE_LINE 00000878 "    CHAR_OCTET_LENGTH"
NSQ_SOURCE_LINE 00000879 "    ORDINAL_POSITION"
NSQ_SOURCE_LINE 00000880 "    IS_NULLABLE"
NSQ_SOURCE_LINE 00000881 ");"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "sub column_info {"
NSQ_SOURCE_LINE 00000884 "    my ($dbh, $cat_val, $sch_val, $tbl_val, $col_val) = @_;"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "    if ( defined $col_val and $col_val eq '%' ) {"
NSQ_SOURCE_LINE 00000887 "        $col_val = undef;"
NSQ_SOURCE_LINE 00000888 "    }"
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "    # Get a list of all tables ordered by TABLE_SCHEM, TABLE_NAME"
NSQ_SOURCE_LINE 00000891 "    my $sql = <<'END_SQL';"
NSQ_SOURCE_LINE 00000892 "SELECT TABLE_SCHEM, tbl_name TABLE_NAME"
NSQ_SOURCE_LINE 00000893 "FROM ("
NSQ_SOURCE_LINE 00000894 "    SELECT 'main' TABLE_SCHEM, tbl_name"
NSQ_SOURCE_LINE 00000895 "    FROM sqlite_master"
NSQ_SOURCE_LINE 00000896 "    WHERE type IN ('table','view')"
NSQ_SOURCE_LINE 00000897 "UNION ALL"
NSQ_SOURCE_LINE 00000898 "    SELECT 'temp' TABLE_SCHEM, tbl_name"
NSQ_SOURCE_LINE 00000899 "    FROM sqlite_temp_master"
NSQ_SOURCE_LINE 00000900 "    WHERE type IN ('table','view')"
NSQ_SOURCE_LINE 00000901 "END_SQL"
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "    for my $db_name (_attached_database_list($dbh)) {"
NSQ_SOURCE_LINE 00000904 "        $sql .= <<\"END_SQL\";"
NSQ_SOURCE_LINE 00000905 "UNION ALL"
NSQ_SOURCE_LINE 00000906 "    SELECT '$db_name' TABLE_SCHEM, tbl_name"
NSQ_SOURCE_LINE 00000907 "    FROM \"$db_name\".sqlite_master"
NSQ_SOURCE_LINE 00000908 "    WHERE type IN ('table','view')"
NSQ_SOURCE_LINE 00000909 "END_SQL"
NSQ_SOURCE_LINE 00000910 "    }"
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "    $sql .= <<'END_SQL';"
NSQ_SOURCE_LINE 00000913 "UNION ALL"
NSQ_SOURCE_LINE 00000914 "    SELECT 'main' TABLE_SCHEM, 'sqlite_master' tbl_name"
NSQ_SOURCE_LINE 00000915 "UNION ALL"
NSQ_SOURCE_LINE 00000916 "    SELECT 'temp' TABLE_SCHEM, 'sqlite_temp_master' tbl_name"
NSQ_SOURCE_LINE 00000917 ")"
NSQ_SOURCE_LINE 00000918 "END_SQL"
NSQ_SOURCE_LINE 00000919 ""
NSQ_SOURCE_LINE 00000920 "    my @where;"
NSQ_SOURCE_LINE 00000921 "    if ( defined $sch_val ) {"
NSQ_SOURCE_LINE 00000922 "        push @where, \"TABLE_SCHEM LIKE '$sch_val'\";"
NSQ_SOURCE_LINE 00000923 "    }"
NSQ_SOURCE_LINE 00000924 "    if ( defined $tbl_val ) {"
NSQ_SOURCE_LINE 00000925 "        push @where, \"TABLE_NAME LIKE '$tbl_val'\";"
NSQ_SOURCE_LINE 00000926 "    }"
NSQ_SOURCE_LINE 00000927 "    $sql .= ' WHERE ' . join(\"\\n   AND \", @where ) . \"\\n\" if @where;"
NSQ_SOURCE_LINE 00000928 "    $sql .= \" ORDER BY TABLE_SCHEM, TABLE_NAME\\n\";"
NSQ_SOURCE_LINE 00000929 "    my $sth_tables = $dbh->prepare($sql) or return undef;"
NSQ_SOURCE_LINE 00000930 "    $sth_tables->execute or return undef;"
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "    # Taken from Fey::Loader::SQLite"
NSQ_SOURCE_LINE 00000933 "    my @cols;"
NSQ_SOURCE_LINE 00000934 "    while ( my ($schema, $table) = $sth_tables->fetchrow_array ) {"
NSQ_SOURCE_LINE 00000935 "        my $sth_columns = $dbh->prepare(qq{PRAGMA \"$schema\".table_xinfo(\"$table\")}) or return;"
NSQ_SOURCE_LINE 00000936 "        $sth_columns->execute or return;"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "        for ( my $position = 1; my $col_info = $sth_columns->fetchrow_hashref; $position++ ) {"
NSQ_SOURCE_LINE 00000939 "            if ( defined $col_val ) {"
NSQ_SOURCE_LINE 00000940 "                # This must do a LIKE comparison"
NSQ_SOURCE_LINE 00000941 "                my $sth = $dbh->prepare(\"SELECT '$col_info->{name}' LIKE '$col_val'\") or return undef;"
NSQ_SOURCE_LINE 00000942 "                $sth->execute or return undef;"
NSQ_SOURCE_LINE 00000943 "                # Skip columns that don't match $col_val"
NSQ_SOURCE_LINE 00000944 "                next unless ($sth->fetchrow_array)[0];"
NSQ_SOURCE_LINE 00000945 "            }"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "            my %col = ("
NSQ_SOURCE_LINE 00000948 "                TABLE_SCHEM      => $schema,"
NSQ_SOURCE_LINE 00000949 "                TABLE_NAME       => $table,"
NSQ_SOURCE_LINE 00000950 "                COLUMN_NAME      => $col_info->{name},"
NSQ_SOURCE_LINE 00000951 "                ORDINAL_POSITION => $position,"
NSQ_SOURCE_LINE 00000952 "            );"
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "            my $type = $col_info->{type};"
NSQ_SOURCE_LINE 00000955 "            if ( $type =~ s/(\\w+)\\s*\\(\\s*(\\d+)(?:\\s*,\\s*(\\d+))?\\s*\\)/$1/ ) {"
NSQ_SOURCE_LINE 00000956 "                $col{COLUMN_SIZE}    = $2;"
NSQ_SOURCE_LINE 00000957 "                $col{DECIMAL_DIGITS} = $3;"
NSQ_SOURCE_LINE 00000958 "            }"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "            $col{TYPE_NAME} = $type;"
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "            if ( defined $col_info->{dflt_value} ) {"
NSQ_SOURCE_LINE 00000963 "                $col{COLUMN_DEF} = $col_info->{dflt_value}"
NSQ_SOURCE_LINE 00000964 "            }"
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "            if ( $col_info->{notnull} ) {"
NSQ_SOURCE_LINE 00000967 "                $col{NULLABLE}    = 0;"
NSQ_SOURCE_LINE 00000968 "                $col{IS_NULLABLE} = 'NO';"
NSQ_SOURCE_LINE 00000969 "            } else {"
NSQ_SOURCE_LINE 00000970 "                $col{NULLABLE}    = 1;"
NSQ_SOURCE_LINE 00000971 "                $col{IS_NULLABLE} = 'YES';"
NSQ_SOURCE_LINE 00000972 "            }"
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "            push @cols, \\%col;"
NSQ_SOURCE_LINE 00000975 "        }"
NSQ_SOURCE_LINE 00000976 "        $sth_columns->finish;"
NSQ_SOURCE_LINE 00000977 "    }"
NSQ_SOURCE_LINE 00000978 "    $sth_tables->finish;"
NSQ_SOURCE_LINE 00000979 ""
NSQ_SOURCE_LINE 00000980 "    my $sponge = DBI->connect(\"DBI:Sponge:\", '','')"
NSQ_SOURCE_LINE 00000981 "        or return $dbh->DBI::set_err($DBI::err, \"DBI::Sponge: $DBI::errstr\");"
NSQ_SOURCE_LINE 00000982 "    $sponge->prepare( \"column_info\", {"
NSQ_SOURCE_LINE 00000983 "        rows          => [ map { [ @{$_}{@COLUMN_INFO} ] } @cols ],"
NSQ_SOURCE_LINE 00000984 "        NUM_OF_FIELDS => scalar @COLUMN_INFO,"
NSQ_SOURCE_LINE 00000985 "        NAME          => [ @COLUMN_INFO ],"
NSQ_SOURCE_LINE 00000986 "    } ) or return $dbh->DBI::set_err("
NSQ_SOURCE_LINE 00000987 "        $sponge->err,"
NSQ_SOURCE_LINE 00000988 "        $sponge->errstr,"
NSQ_SOURCE_LINE 00000989 "    );"
NSQ_SOURCE_LINE 00000990 "}"
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "#======================================================================"
NSQ_SOURCE_LINE 00000993 "# An internal tied hash package used for %DBD::SQLite::COLLATION, to"
NSQ_SOURCE_LINE 00000994 "# prevent people from unintentionally overriding globally registered collations."
NSQ_SOURCE_LINE 00000995 ""
NSQ_SOURCE_LINE 00000996 "package # hide from PAUSE"
NSQ_SOURCE_LINE 00000997 "    DBD::SQLite::_WriteOnceHash;"
NSQ_SOURCE_LINE 00000998 ""
NSQ_SOURCE_LINE 00000999 "require Tie::Hash;"
NSQ_SOURCE_LINE 00001000 ""
NSQ_SOURCE_LINE 00001001 "our @ISA = qw(Tie::StdHash);"
NSQ_SOURCE_LINE 00001002 ""
NSQ_SOURCE_LINE 00001003 "sub TIEHASH {"
NSQ_SOURCE_LINE 00001004 "    bless {}, $_[0];"
NSQ_SOURCE_LINE 00001005 "}"
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "sub STORE {"
NSQ_SOURCE_LINE 00001008 "    ! exists $_[0]->{$_[1]} or die \"entry $_[1] already registered\";"
NSQ_SOURCE_LINE 00001009 "    $_[0]->{$_[1]} = $_[2];"
NSQ_SOURCE_LINE 00001010 "}"
NSQ_SOURCE_LINE 00001011 ""
NSQ_SOURCE_LINE 00001012 "sub DELETE {"
NSQ_SOURCE_LINE 00001013 "    die \"deletion of entry $_[1] is forbidden\";"
NSQ_SOURCE_LINE 00001014 "}"
NSQ_SOURCE_LINE 00001015 ""
NSQ_SOURCE_LINE 00001016 "1;"
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "__END__"
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "=pod"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "=encoding utf-8"
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "=head1 NAME"
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "DBD::SQLite - Self-contained RDBMS in a DBI Driver"
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "  use DBI;"
NSQ_SOURCE_LINE 00001031 "  my $dbh = DBI->connect(\"dbi:SQLite:dbname=$dbfile\",\"\",\"\");"
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 "SQLite is a public domain file-based relational database engine that"
NSQ_SOURCE_LINE 00001036 "you can find at L<https://www.sqlite.org/>."
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "B<DBD::SQLite> is a Perl DBI driver for SQLite, that includes"
NSQ_SOURCE_LINE 00001039 "the entire thing in the distribution."
NSQ_SOURCE_LINE 00001040 "So in order to get a fast transaction capable RDBMS working for your"
NSQ_SOURCE_LINE 00001041 "perl project you simply have to install this module, and B<nothing>"
NSQ_SOURCE_LINE 00001042 "else."
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 "SQLite supports the following features:"
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "=over 4"
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "=item Implements a large subset of SQL92"
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "See L<https://www.sqlite.org/lang.html> for details."
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "=item A complete DB in a single disk file"
NSQ_SOURCE_LINE 00001053 ""
NSQ_SOURCE_LINE 00001054 "Everything for your database is stored in a single disk file, making it"
NSQ_SOURCE_LINE 00001055 "easier to move things around than with L<DBD::CSV>."
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "=item Atomic commit and rollback"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "Yes, B<DBD::SQLite> is small and light, but it supports full transactions!"
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "=item Extensible"
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "User-defined aggregate or regular functions can be registered with the"
NSQ_SOURCE_LINE 00001064 "SQL parser."
NSQ_SOURCE_LINE 00001065 ""
NSQ_SOURCE_LINE 00001066 "=back"
NSQ_SOURCE_LINE 00001067 ""
NSQ_SOURCE_LINE 00001068 "There's lots more to it, so please refer to the docs on the SQLite web"
NSQ_SOURCE_LINE 00001069 "page, listed above, for SQL details. Also refer to L<DBI> for details"
NSQ_SOURCE_LINE 00001070 "on how to use DBI itself. The API works like every DBI module does."
NSQ_SOURCE_LINE 00001071 "However, currently many statement attributes are not implemented or"
NSQ_SOURCE_LINE 00001072 "are limited by the typeless nature of the SQLite database."
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 "=head1 SQLITE VERSION"
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 "DBD::SQLite is usually compiled with a bundled SQLite library"
NSQ_SOURCE_LINE 00001077 "(SQLite version S<3.51.1> as of this release) for consistency."
NSQ_SOURCE_LINE 00001078 "However, a different version of SQLite may sometimes be used for"
NSQ_SOURCE_LINE 00001079 "some reasons like security, or some new experimental features."
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "You can look at C<$DBD::SQLite::sqlite_version> (C<3.x.y> format) or"
NSQ_SOURCE_LINE 00001082 "C<$DBD::SQLite::sqlite_version_number> (C<3xxxyyy> format)"
NSQ_SOURCE_LINE 00001083 "to find which version of SQLite is actually used. You can also"
NSQ_SOURCE_LINE 00001084 "check C<DBD::SQLite::Constants::SQLITE_VERSION_NUMBER()>."
NSQ_SOURCE_LINE 00001085 ""
NSQ_SOURCE_LINE 00001086 "You can also find how the library is compiled by calling"
NSQ_SOURCE_LINE 00001087 "C<DBD::SQLite::compile_options()> (see below)."
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "=head1 NOTABLE DIFFERENCES FROM OTHER DRIVERS"
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 "=head2 Database Name Is A File Name"
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "SQLite creates a file per a database. You should pass the C<path> of"
NSQ_SOURCE_LINE 00001094 "the database file (with or without a parent directory) in the DBI"
NSQ_SOURCE_LINE 00001095 "connection string (as a database C<name>):"
NSQ_SOURCE_LINE 00001096 ""
NSQ_SOURCE_LINE 00001097 "  my $dbh = DBI->connect(\"dbi:SQLite:dbname=$dbfile\",\"\",\"\");"
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "The file is opened in read/write mode, and will be created if"
NSQ_SOURCE_LINE 00001100 "it does not exist yet."
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "Although the database is stored in a single file, the directory"
NSQ_SOURCE_LINE 00001103 "containing the database file must be writable by SQLite because the"
NSQ_SOURCE_LINE 00001104 "library will create several temporary files there."
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 "If the filename C<$dbfile> is \":memory:\", then a private, temporary"
NSQ_SOURCE_LINE 00001107 "in-memory database is created for the connection. This in-memory"
NSQ_SOURCE_LINE 00001108 "database will vanish when the database connection is closed."
NSQ_SOURCE_LINE 00001109 "It is handy for your library tests."
NSQ_SOURCE_LINE 00001110 ""
NSQ_SOURCE_LINE 00001111 "Note that future versions of SQLite might make use of additional"
NSQ_SOURCE_LINE 00001112 "special filenames that begin with the \":\" character. It is recommended"
NSQ_SOURCE_LINE 00001113 "that when a database filename actually does begin with a \":\" character"
NSQ_SOURCE_LINE 00001114 "you should prefix the filename with a pathname such as \"./\" to avoid"
NSQ_SOURCE_LINE 00001115 "ambiguity."
NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "If the filename C<$dbfile> is an empty string, then a private,"
NSQ_SOURCE_LINE 00001118 "temporary on-disk database will be created. This private database will"
NSQ_SOURCE_LINE 00001119 "be automatically deleted as soon as the database connection is closed."
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 "As of 1.41_01, you can pass URI filename (see L<https://www.sqlite.org/uri.html>)"
NSQ_SOURCE_LINE 00001122 "as well for finer control:"
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 "  my $dbh = DBI->connect(\"dbi:SQLite:uri=file:$path_to_dbfile?mode=rwc\");"
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "Note that this is not for remote SQLite database connection. You can"
NSQ_SOURCE_LINE 00001127 "only connect to a local database."
NSQ_SOURCE_LINE 00001128 ""
NSQ_SOURCE_LINE 00001129 "=head2 Read-Only Database"
NSQ_SOURCE_LINE 00001130 ""
NSQ_SOURCE_LINE 00001131 "You can set sqlite_open_flags (only) when you connect to a database:"
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "  use DBD::SQLite::Constants qw/:file_open/;"
NSQ_SOURCE_LINE 00001134 "  my $dbh = DBI->connect(\"dbi:SQLite:$dbfile\", undef, undef, {"
NSQ_SOURCE_LINE 00001135 "    sqlite_open_flags => SQLITE_OPEN_READONLY,"
NSQ_SOURCE_LINE 00001136 "  });"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "See L<https://www.sqlite.org/c3ref/open.html> for details."
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "As of 1.49_05, you can also make a database read-only by setting"
NSQ_SOURCE_LINE 00001141 "C<ReadOnly> attribute to true (only) when you connect to a database."
NSQ_SOURCE_LINE 00001142 "Actually you can set it after you connect, but in that case, it"
NSQ_SOURCE_LINE 00001143 "can't make the database read-only, and you'll see a warning (which"
NSQ_SOURCE_LINE 00001144 "you can hide by turning C<PrintWarn> off)."
NSQ_SOURCE_LINE 00001145 ""
NSQ_SOURCE_LINE 00001146 "=head2 DBD::SQLite And File::Temp"
NSQ_SOURCE_LINE 00001147 ""
NSQ_SOURCE_LINE 00001148 "When you use L<File::Temp> to create a temporary file/directory for"
NSQ_SOURCE_LINE 00001149 "SQLite databases, you need to remember:"
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "=over 4"
NSQ_SOURCE_LINE 00001152 ""
NSQ_SOURCE_LINE 00001153 "=item tempfile may be locked exclusively"
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "You may want to use C<tempfile()> to create a temporary database"
NSQ_SOURCE_LINE 00001156 "filename for DBD::SQLite, but as noted in L<File::Temp>'s POD,"
NSQ_SOURCE_LINE 00001157 "this file may have an exclusive lock under some operating systems"
NSQ_SOURCE_LINE 00001158 "(notably Mac OSX), and result in a \"database is locked\" error."
NSQ_SOURCE_LINE 00001159 "To avoid this, set EXLOCK option to false when you call tempfile()."
NSQ_SOURCE_LINE 00001160 ""
NSQ_SOURCE_LINE 00001161 "  ($fh, $filename) = tempfile($template, EXLOCK => 0);"
NSQ_SOURCE_LINE 00001162 ""
NSQ_SOURCE_LINE 00001163 "=item CLEANUP may not work unless a database is disconnected"
NSQ_SOURCE_LINE 00001164 ""
NSQ_SOURCE_LINE 00001165 "When you set CLEANUP option to true when you create a temporary"
NSQ_SOURCE_LINE 00001166 "directory with C<tempdir()> or C<newdir()>, you may have to"
NSQ_SOURCE_LINE 00001167 "disconnect databases explicitly before the temporary directory"
NSQ_SOURCE_LINE 00001168 "is gone (notably under MS Windows)."
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 "=back"
NSQ_SOURCE_LINE 00001171 ""
NSQ_SOURCE_LINE 00001172 "(The above is quoted from the pod of File::Temp.)"
NSQ_SOURCE_LINE 00001173 ""
NSQ_SOURCE_LINE 00001174 "If you don't need to keep or share a temporary database,"
NSQ_SOURCE_LINE 00001175 "use \":memory:\" database instead. It's much handier and cleaner"
NSQ_SOURCE_LINE 00001176 "for ordinary testing."
NSQ_SOURCE_LINE 00001177 ""
NSQ_SOURCE_LINE 00001178 "=head2 DBD::SQLite and fork()"
NSQ_SOURCE_LINE 00001179 ""
NSQ_SOURCE_LINE 00001180 "Follow the advice in the SQLite FAQ (L<https://sqlite.org/faq.html>)."
NSQ_SOURCE_LINE 00001181 ""
NSQ_SOURCE_LINE 00001182 "=over 4"
NSQ_SOURCE_LINE 00001183 ""
NSQ_SOURCE_LINE 00001184 "Under Unix, you should not carry an open SQLite database across"
NSQ_SOURCE_LINE 00001185 "a fork() system call into the child process. Problems will result"
NSQ_SOURCE_LINE 00001186 "if you do."
NSQ_SOURCE_LINE 00001187 ""
NSQ_SOURCE_LINE 00001188 "=back"
NSQ_SOURCE_LINE 00001189 ""
NSQ_SOURCE_LINE 00001190 "You shouldn't (re)use a database handle you created (probably to"
NSQ_SOURCE_LINE 00001191 "set up a database schema etc) before you fork(). Otherwise, you"
NSQ_SOURCE_LINE 00001192 "might see a database corruption in the worst case."
NSQ_SOURCE_LINE 00001193 ""
NSQ_SOURCE_LINE 00001194 "If you need to fork(), (re)open a database after you fork()."
NSQ_SOURCE_LINE 00001195 "You might also want to tweak C<sqlite_busy_timeout> and"
NSQ_SOURCE_LINE 00001196 "C<sqlite_use_immediate_transaction> (see below), depending"
NSQ_SOURCE_LINE 00001197 "on your needs."
NSQ_SOURCE_LINE 00001198 ""
NSQ_SOURCE_LINE 00001199 "If you need a higher level of concurrency than SQLite supports,"
NSQ_SOURCE_LINE 00001200 "consider using other client/server database engines."
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "=head2 Accessing A Database With Other Tools"
NSQ_SOURCE_LINE 00001203 ""
NSQ_SOURCE_LINE 00001204 "To access the database from the command line, try using C<dbish>"
NSQ_SOURCE_LINE 00001205 "which comes with the L<DBI::Shell> module. Just type:"
NSQ_SOURCE_LINE 00001206 ""
NSQ_SOURCE_LINE 00001207 "  dbish dbi:SQLite:foo.db"
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 "On the command line to access the file F<foo.db>."
NSQ_SOURCE_LINE 00001210 ""
NSQ_SOURCE_LINE 00001211 "Alternatively you can install SQLite from the link above without"
NSQ_SOURCE_LINE 00001212 "conflicting with B<DBD::SQLite> and use the supplied C<sqlite3>"
NSQ_SOURCE_LINE 00001213 "command line tool."
NSQ_SOURCE_LINE 00001214 ""
NSQ_SOURCE_LINE 00001215 "=head2 Blobs"
NSQ_SOURCE_LINE 00001216 ""
NSQ_SOURCE_LINE 00001217 "As of version 1.11, blobs should \"just work\" in SQLite as text columns."
NSQ_SOURCE_LINE 00001218 "However this will cause the data to be treated as a string, so SQL"
NSQ_SOURCE_LINE 00001219 "statements such as length(x) will return the length of the column as a NUL"
NSQ_SOURCE_LINE 00001220 "terminated string, rather than the size of the blob in bytes. In order to"
NSQ_SOURCE_LINE 00001221 "store natively as a BLOB use the following code:"
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 "  use DBI qw(:sql_types);"
NSQ_SOURCE_LINE 00001224 "  my $dbh = DBI->connect(\"dbi:SQLite:dbfile\",\"\",\"\");"
NSQ_SOURCE_LINE 00001225 "  "
NSQ_SOURCE_LINE 00001226 "  my $blob = `cat foo.jpg`;"
NSQ_SOURCE_LINE 00001227 "  my $sth = $dbh->prepare(\"INSERT INTO mytable VALUES (1, ?)\");"
NSQ_SOURCE_LINE 00001228 "  $sth->bind_param(1, $blob, SQL_BLOB);"
NSQ_SOURCE_LINE 00001229 "  $sth->execute();"
NSQ_SOURCE_LINE 00001230 ""
NSQ_SOURCE_LINE 00001231 "And then retrieval just works:"
NSQ_SOURCE_LINE 00001232 ""
NSQ_SOURCE_LINE 00001233 "  $sth = $dbh->prepare(\"SELECT * FROM mytable WHERE id = 1\");"
NSQ_SOURCE_LINE 00001234 "  $sth->execute();"
NSQ_SOURCE_LINE 00001235 "  my $row = $sth->fetch;"
NSQ_SOURCE_LINE 00001236 "  my $blobo = $row->[1];"
NSQ_SOURCE_LINE 00001237 "  "
NSQ_SOURCE_LINE 00001238 "  # now $blobo == $blob"
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "=head2 Functions And Bind Parameters"
NSQ_SOURCE_LINE 00001241 ""
NSQ_SOURCE_LINE 00001242 "As of this writing, a SQL that compares a return value of a function"
NSQ_SOURCE_LINE 00001243 "with a numeric bind value like this doesn't work as you might expect."
NSQ_SOURCE_LINE 00001244 ""
NSQ_SOURCE_LINE 00001245 "  my $sth = $dbh->prepare(q{"
NSQ_SOURCE_LINE 00001246 "    SELECT bar FROM foo GROUP BY bar HAVING count(*) > ?;"
NSQ_SOURCE_LINE 00001247 "  });"
NSQ_SOURCE_LINE 00001248 "  $sth->execute(5);"
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "This is because DBD::SQLite assumes that all the bind values are text"
NSQ_SOURCE_LINE 00001251 "(and should be quoted) by default. Thus the above statement becomes"
NSQ_SOURCE_LINE 00001252 "like this while executing:"
NSQ_SOURCE_LINE 00001253 ""
NSQ_SOURCE_LINE 00001254 "  SELECT bar FROM foo GROUP BY bar HAVING count(*) > \"5\";"
NSQ_SOURCE_LINE 00001255 ""
NSQ_SOURCE_LINE 00001256 "There are four workarounds for this."
NSQ_SOURCE_LINE 00001257 ""
NSQ_SOURCE_LINE 00001258 "=over 4"
NSQ_SOURCE_LINE 00001259 ""
NSQ_SOURCE_LINE 00001260 "=item Use bind_param() explicitly"
NSQ_SOURCE_LINE 00001261 ""
NSQ_SOURCE_LINE 00001262 "As shown above in the C<BLOB> section, you can always use"
NSQ_SOURCE_LINE 00001263 "C<bind_param()> to tell the type of a bind value."
NSQ_SOURCE_LINE 00001264 ""
NSQ_SOURCE_LINE 00001265 "  use DBI qw(:sql_types);  # Don't forget this"
NSQ_SOURCE_LINE 00001266 "  "
NSQ_SOURCE_LINE 00001267 "  my $sth = $dbh->prepare(q{"
NSQ_SOURCE_LINE 00001268 "    SELECT bar FROM foo GROUP BY bar HAVING count(*) > ?;"
NSQ_SOURCE_LINE 00001269 "  });"
NSQ_SOURCE_LINE 00001270 "  $sth->bind_param(1, 5, SQL_INTEGER);"
NSQ_SOURCE_LINE 00001271 "  $sth->execute();"
NSQ_SOURCE_LINE 00001272 ""
NSQ_SOURCE_LINE 00001273 "=item Add zero to make it a number"
NSQ_SOURCE_LINE 00001274 ""
NSQ_SOURCE_LINE 00001275 "This is somewhat weird, but works anyway."
NSQ_SOURCE_LINE 00001276 ""
NSQ_SOURCE_LINE 00001277 "  my $sth = $dbh->prepare(q{"
NSQ_SOURCE_LINE 00001278 "    SELECT bar FROM foo GROUP BY bar HAVING count(*) > (? + 0);"
NSQ_SOURCE_LINE 00001279 "  });"
NSQ_SOURCE_LINE 00001280 "  $sth->execute(5);"
NSQ_SOURCE_LINE 00001281 ""
NSQ_SOURCE_LINE 00001282 "=item Use SQL cast() function"
NSQ_SOURCE_LINE 00001283 ""
NSQ_SOURCE_LINE 00001284 "This is more explicit way to do the above."
NSQ_SOURCE_LINE 00001285 ""
NSQ_SOURCE_LINE 00001286 "  my $sth = $dbh->prepare(q{"
NSQ_SOURCE_LINE 00001287 "    SELECT bar FROM foo GROUP BY bar HAVING count(*) > cast(? as integer);"
NSQ_SOURCE_LINE 00001288 "  });"
NSQ_SOURCE_LINE 00001289 "  $sth->execute(5);"
NSQ_SOURCE_LINE 00001290 ""
NSQ_SOURCE_LINE 00001291 "=item Set C<sqlite_see_if_its_a_number> database handle attribute"
NSQ_SOURCE_LINE 00001292 ""
NSQ_SOURCE_LINE 00001293 "As of version 1.32_02, you can use C<sqlite_see_if_its_a_number>"
NSQ_SOURCE_LINE 00001294 "to let DBD::SQLite to see if the bind values are numbers or not."
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 "  $dbh->{sqlite_see_if_its_a_number} = 1;"
NSQ_SOURCE_LINE 00001297 "  my $sth = $dbh->prepare(q{"
NSQ_SOURCE_LINE 00001298 "    SELECT bar FROM foo GROUP BY bar HAVING count(*) > ?;"
NSQ_SOURCE_LINE 00001299 "  });"
NSQ_SOURCE_LINE 00001300 "  $sth->execute(5);"
NSQ_SOURCE_LINE 00001301 ""
NSQ_SOURCE_LINE 00001302 "You can set it to true when you connect to a database."
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 "  my $dbh = DBI->connect('dbi:SQLite:foo', undef, undef, {"
NSQ_SOURCE_LINE 00001305 "    AutoCommit => 1,"
NSQ_SOURCE_LINE 00001306 "    RaiseError => 1,"
NSQ_SOURCE_LINE 00001307 "    sqlite_see_if_its_a_number => 1,"
NSQ_SOURCE_LINE 00001308 "  });"
NSQ_SOURCE_LINE 00001309 ""
NSQ_SOURCE_LINE 00001310 "This is the most straightforward solution, but as noted above,"
NSQ_SOURCE_LINE 00001311 "existing data in your databases created by DBD::SQLite have not"
NSQ_SOURCE_LINE 00001312 "always been stored as numbers, so this *might* cause other obscure"
NSQ_SOURCE_LINE 00001313 "problems. Use this sparingly when you handle existing databases."
NSQ_SOURCE_LINE 00001314 "If you handle databases created by other tools like native C<sqlite3>"
NSQ_SOURCE_LINE 00001315 "command line tool, this attribute would help you."
NSQ_SOURCE_LINE 00001316 ""
NSQ_SOURCE_LINE 00001317 "As of 1.41_04, C<sqlite_see_if_its_a_number> works only for"
NSQ_SOURCE_LINE 00001318 "bind values with no explicit type."
NSQ_SOURCE_LINE 00001319 ""
NSQ_SOURCE_LINE 00001320 "  my $dbh = DBI->connect('dbi:SQLite:foo', undef, undef, {"
NSQ_SOURCE_LINE 00001321 "    AutoCommit => 1,"
NSQ_SOURCE_LINE 00001322 "    RaiseError => 1,"
NSQ_SOURCE_LINE 00001323 "    sqlite_see_if_its_a_number => 1,"
NSQ_SOURCE_LINE 00001324 "  });"
NSQ_SOURCE_LINE 00001325 "  my $sth = $dbh->prepare('INSERT INTO foo VALUES(?)');"
NSQ_SOURCE_LINE 00001326 "  # '1.230' will be inserted as a text, instead of 1.23 as a number,"
NSQ_SOURCE_LINE 00001327 "  # even though sqlite_see_if_its_a_number is set."
NSQ_SOURCE_LINE 00001328 "  $sth->bind_param(1, '1.230', SQL_VARCHAR);"
NSQ_SOURCE_LINE 00001329 "  $sth->execute;"
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 "=back"
NSQ_SOURCE_LINE 00001332 ""
NSQ_SOURCE_LINE 00001333 "=head2 Placeholders"
NSQ_SOURCE_LINE 00001334 ""
NSQ_SOURCE_LINE 00001335 "SQLite supports several placeholder expressions, including C<?>"
NSQ_SOURCE_LINE 00001336 "and C<:AAAA>. Consult the L<DBI> and SQLite documentation for"
NSQ_SOURCE_LINE 00001337 "details. "
NSQ_SOURCE_LINE 00001338 ""
NSQ_SOURCE_LINE 00001339 "L<https://www.sqlite.org/lang_expr.html#varparam>"
NSQ_SOURCE_LINE 00001340 ""
NSQ_SOURCE_LINE 00001341 "Note that a question mark actually means a next unused (numbered)"
NSQ_SOURCE_LINE 00001342 "placeholder. You're advised not to use it with other (numbered or"
NSQ_SOURCE_LINE 00001343 "named) placeholders to avoid confusion."
NSQ_SOURCE_LINE 00001344 ""
NSQ_SOURCE_LINE 00001345 "  my $sth = $dbh->prepare("
NSQ_SOURCE_LINE 00001346 "    'update TABLE set a=?1 where b=?2 and a IS NOT ?1'"
NSQ_SOURCE_LINE 00001347 "  );"
NSQ_SOURCE_LINE 00001348 "  $sth->execute(1, 2); "
NSQ_SOURCE_LINE 00001349 ""
NSQ_SOURCE_LINE 00001350 "=head2 Pragma"
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "SQLite has a set of \"Pragma\"s to modify its operation or to query"
NSQ_SOURCE_LINE 00001353 "for its internal data. These are specific to SQLite and are not"
NSQ_SOURCE_LINE 00001354 "likely to work with other DBD libraries, but you may find some of"
NSQ_SOURCE_LINE 00001355 "these are quite useful, including:"
NSQ_SOURCE_LINE 00001356 ""
NSQ_SOURCE_LINE 00001357 "=over 4"
NSQ_SOURCE_LINE 00001358 ""
NSQ_SOURCE_LINE 00001359 "=item journal_mode"
NSQ_SOURCE_LINE 00001360 ""
NSQ_SOURCE_LINE 00001361 "You can use this pragma to change the journal mode for SQLite"
NSQ_SOURCE_LINE 00001362 "databases, maybe for better performance, or for compatibility."
NSQ_SOURCE_LINE 00001363 ""
NSQ_SOURCE_LINE 00001364 "Its default mode is C<DELETE>, which means SQLite uses a rollback"
NSQ_SOURCE_LINE 00001365 "journal to implement transactions, and the journal is deleted"
NSQ_SOURCE_LINE 00001366 "at the conclusion of each transaction. If you use C<TRUNCATE>"
NSQ_SOURCE_LINE 00001367 "instead of C<DELETE>, the journal will be truncated, which is"
NSQ_SOURCE_LINE 00001368 "usually much faster."
NSQ_SOURCE_LINE 00001369 ""
NSQ_SOURCE_LINE 00001370 "A C<WAL> (write-ahead log) mode is introduced as of SQLite 3.7.0."
NSQ_SOURCE_LINE 00001371 "This mode is persistent, and it stays in effect even after"
NSQ_SOURCE_LINE 00001372 "closing and reopening the database. In other words, once the C<WAL>"
NSQ_SOURCE_LINE 00001373 "mode is set in an application or in a test script, the database"
NSQ_SOURCE_LINE 00001374 "becomes inaccessible by older clients. This tends to be an issue"
NSQ_SOURCE_LINE 00001375 "when you use a system C<sqlite3> executable under a conservative"
NSQ_SOURCE_LINE 00001376 "operating system."
NSQ_SOURCE_LINE 00001377 ""
NSQ_SOURCE_LINE 00001378 "To fix this, You need to issue C<PRAGMA journal_mode = DELETE>"
NSQ_SOURCE_LINE 00001379 "(or C<TRUNCATE>) beforehand, or install a newer version of"
NSQ_SOURCE_LINE 00001380 "C<sqlite3>."
NSQ_SOURCE_LINE 00001381 ""
NSQ_SOURCE_LINE 00001382 "=item legacy_file_format"
NSQ_SOURCE_LINE 00001383 ""
NSQ_SOURCE_LINE 00001384 "If you happen to need to create a SQLite database that will also"
NSQ_SOURCE_LINE 00001385 "be accessed by a very old SQLite client (prior to 3.3.0 released"
NSQ_SOURCE_LINE 00001386 "in Jan. 2006), you need to set this pragma to ON before you create"
NSQ_SOURCE_LINE 00001387 "a database."
NSQ_SOURCE_LINE 00001388 ""
NSQ_SOURCE_LINE 00001389 "=item reverse_unordered_selects"
NSQ_SOURCE_LINE 00001390 ""
NSQ_SOURCE_LINE 00001391 "You can set this pragma to ON to reverse the order of results of"
NSQ_SOURCE_LINE 00001392 "SELECT statements without an ORDER BY clause so that you can see"
NSQ_SOURCE_LINE 00001393 "if applications are making invalid assumptions about the result"
NSQ_SOURCE_LINE 00001394 "order."
NSQ_SOURCE_LINE 00001395 ""
NSQ_SOURCE_LINE 00001396 "Note that SQLite 3.7.15 (bundled with DBD::SQLite 1.38_02) enhanced"
NSQ_SOURCE_LINE 00001397 "its query optimizer and the order of results of a SELECT statement"
NSQ_SOURCE_LINE 00001398 "without an ORDER BY clause may be different from the one of the"
NSQ_SOURCE_LINE 00001399 "previous versions."
NSQ_SOURCE_LINE 00001400 ""
NSQ_SOURCE_LINE 00001401 "=item synchronous"
NSQ_SOURCE_LINE 00001402 ""
NSQ_SOURCE_LINE 00001403 "You can set set this pragma to OFF to make some of the operations"
NSQ_SOURCE_LINE 00001404 "in SQLite faster with a possible risk of database corruption"
NSQ_SOURCE_LINE 00001405 "in the worst case. See also L</\"Performance\"> section below."
NSQ_SOURCE_LINE 00001406 ""
NSQ_SOURCE_LINE 00001407 "=back"
NSQ_SOURCE_LINE 00001408 ""
NSQ_SOURCE_LINE 00001409 "See L<https://www.sqlite.org/pragma.html> for more details."
NSQ_SOURCE_LINE 00001410 ""
NSQ_SOURCE_LINE 00001411 "=head2 Foreign Keys"
NSQ_SOURCE_LINE 00001412 ""
NSQ_SOURCE_LINE 00001413 "SQLite has started supporting foreign key constraints since 3.6.19"
NSQ_SOURCE_LINE 00001414 "(released on Oct 14, 2009; bundled in DBD::SQLite 1.26_05)."
NSQ_SOURCE_LINE 00001415 "To be exact, SQLite has long been able to parse a schema with foreign"
NSQ_SOURCE_LINE 00001416 "keys, but the constraints has not been enforced. Now you can issue"
NSQ_SOURCE_LINE 00001417 "a C<foreign_keys> pragma to enable this feature and enforce the"
NSQ_SOURCE_LINE 00001418 "constraints, preferably as soon as you connect to a database and"
NSQ_SOURCE_LINE 00001419 "you're not in a transaction:"
NSQ_SOURCE_LINE 00001420 ""
NSQ_SOURCE_LINE 00001421 "  $dbh->do(\"PRAGMA foreign_keys = ON\");"
NSQ_SOURCE_LINE 00001422 ""
NSQ_SOURCE_LINE 00001423 "And you can explicitly disable the feature whenever you like by"
NSQ_SOURCE_LINE 00001424 "turning the pragma off:"
NSQ_SOURCE_LINE 00001425 ""
NSQ_SOURCE_LINE 00001426 "  $dbh->do(\"PRAGMA foreign_keys = OFF\");"
NSQ_SOURCE_LINE 00001427 ""
NSQ_SOURCE_LINE 00001428 "As of this writing, this feature is disabled by default by the"
NSQ_SOURCE_LINE 00001429 "SQLite team, and by us, to secure backward compatibility, as"
NSQ_SOURCE_LINE 00001430 "this feature may break your applications, and actually broke"
NSQ_SOURCE_LINE 00001431 "some for us. If you have used a schema with foreign key constraints"
NSQ_SOURCE_LINE 00001432 "but haven't cared them much and supposed they're always ignored for"
NSQ_SOURCE_LINE 00001433 "SQLite, be prepared, and please do extensive testing to ensure"
NSQ_SOURCE_LINE 00001434 "that your applications will continue to work when the foreign keys"
NSQ_SOURCE_LINE 00001435 "support is enabled by default."
NSQ_SOURCE_LINE 00001436 ""
NSQ_SOURCE_LINE 00001437 "See L<https://www.sqlite.org/foreignkeys.html> for details."
NSQ_SOURCE_LINE 00001438 ""
NSQ_SOURCE_LINE 00001439 "=head2 Transactions"
NSQ_SOURCE_LINE 00001440 ""
NSQ_SOURCE_LINE 00001441 "DBI/DBD::SQLite's transactions may be a bit confusing. They behave"
NSQ_SOURCE_LINE 00001442 "differently according to the status of the C<AutoCommit> flag:"
NSQ_SOURCE_LINE 00001443 ""
NSQ_SOURCE_LINE 00001444 "=over 4"
NSQ_SOURCE_LINE 00001445 ""
NSQ_SOURCE_LINE 00001446 "=item When the AutoCommit flag is on"
NSQ_SOURCE_LINE 00001447 ""
NSQ_SOURCE_LINE 00001448 "You're supposed to always use the auto-commit mode, except you"
NSQ_SOURCE_LINE 00001449 "explicitly begin a transaction, and when the transaction ended,"
NSQ_SOURCE_LINE 00001450 "you're supposed to go back to the auto-commit mode. To begin a"
NSQ_SOURCE_LINE 00001451 "transaction, call C<begin_work> method, or issue a C<BEGIN>"
NSQ_SOURCE_LINE 00001452 "statement. To end it, call C<commit/rollback> methods, or issue"
NSQ_SOURCE_LINE 00001453 "the corresponding statements."
NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 "  $dbh->{AutoCommit} = 1;"
NSQ_SOURCE_LINE 00001456 "  "
NSQ_SOURCE_LINE 00001457 "  $dbh->begin_work; # or $dbh->do('BEGIN TRANSACTION');"
NSQ_SOURCE_LINE 00001458 "  "
NSQ_SOURCE_LINE 00001459 "  # $dbh->{AutoCommit} is turned off temporarily during a transaction;"
NSQ_SOURCE_LINE 00001460 "  "
NSQ_SOURCE_LINE 00001461 "  $dbh->commit; # or $dbh->do('COMMIT');"
NSQ_SOURCE_LINE 00001462 "  "
NSQ_SOURCE_LINE 00001463 "  # $dbh->{AutoCommit} is turned on again;"
NSQ_SOURCE_LINE 00001464 ""
NSQ_SOURCE_LINE 00001465 "=item When the AutoCommit flag is off"
NSQ_SOURCE_LINE 00001466 ""
NSQ_SOURCE_LINE 00001467 "You're supposed to always use the transactional mode, until you"
NSQ_SOURCE_LINE 00001468 "explicitly turn on the AutoCommit flag. You can explicitly issue"
NSQ_SOURCE_LINE 00001469 "a C<BEGIN> statement (only when an actual transaction has not"
NSQ_SOURCE_LINE 00001470 "begun yet) but you're not allowed to call C<begin_work> method"
NSQ_SOURCE_LINE 00001471 "(if you don't issue a C<BEGIN>, it will be issued internally)."
NSQ_SOURCE_LINE 00001472 "You can commit or roll it back freely. Another transaction will"
NSQ_SOURCE_LINE 00001473 "automatically begin if you execute another statement."
NSQ_SOURCE_LINE 00001474 ""
NSQ_SOURCE_LINE 00001475 "  $dbh->{AutoCommit} = 0;"
NSQ_SOURCE_LINE 00001476 "  "
NSQ_SOURCE_LINE 00001477 "  # $dbh->do('BEGIN TRANSACTION') is not necessary, but possible"
NSQ_SOURCE_LINE 00001478 "  "
NSQ_SOURCE_LINE 00001479 "  ..."
NSQ_SOURCE_LINE 00001480 "  "
NSQ_SOURCE_LINE 00001481 "  $dbh->commit; # or $dbh->do('COMMIT');"
NSQ_SOURCE_LINE 00001482 "  "
NSQ_SOURCE_LINE 00001483 "  # $dbh->{AutoCommit} stays intact;"
NSQ_SOURCE_LINE 00001484 "  "
NSQ_SOURCE_LINE 00001485 "  $dbh->{AutoCommit} = 1;  # ends the transactional mode"
NSQ_SOURCE_LINE 00001486 ""
NSQ_SOURCE_LINE 00001487 "=back"
NSQ_SOURCE_LINE 00001488 ""
NSQ_SOURCE_LINE 00001489 "This C<AutoCommit> mode is independent from the autocommit mode"
NSQ_SOURCE_LINE 00001490 "of the internal SQLite library, which always begins by a C<BEGIN>"
NSQ_SOURCE_LINE 00001491 "statement, and ends by a C<COMMIT> or a C<ROLLBACK>."
NSQ_SOURCE_LINE 00001492 ""
NSQ_SOURCE_LINE 00001493 "=head2 Transaction and Database Locking"
NSQ_SOURCE_LINE 00001494 ""
NSQ_SOURCE_LINE 00001495 "The default transaction behavior of SQLite is C<deferred>, that"
NSQ_SOURCE_LINE 00001496 "means, locks are not acquired until the first read or write"
NSQ_SOURCE_LINE 00001497 "operation, and thus it is possible that another thread or process"
NSQ_SOURCE_LINE 00001498 "could create a separate transaction and write to the database after"
NSQ_SOURCE_LINE 00001499 "the C<BEGIN> on the current thread has executed, and eventually"
NSQ_SOURCE_LINE 00001500 "cause a \"deadlock\". To avoid this, DBD::SQLite internally issues"
NSQ_SOURCE_LINE 00001501 "a C<BEGIN IMMEDIATE> if you begin a transaction by calling"
NSQ_SOURCE_LINE 00001502 "C<begin_work> or by turning off C<AutoCommit> (since 1.38_01)."
NSQ_SOURCE_LINE 00001503 ""
NSQ_SOURCE_LINE 00001504 "If you really need to turn off this feature for some reasons,"
NSQ_SOURCE_LINE 00001505 "set C<sqlite_use_immediate_transaction> database handle attribute"
NSQ_SOURCE_LINE 00001506 "to false, and the default C<deferred> transaction will be used."
NSQ_SOURCE_LINE 00001507 ""
NSQ_SOURCE_LINE 00001508 "  my $dbh = DBI->connect(\"dbi:SQLite::memory:\", \"\", \"\", {"
NSQ_SOURCE_LINE 00001509 "    sqlite_use_immediate_transaction => 0,"
NSQ_SOURCE_LINE 00001510 "  });"
NSQ_SOURCE_LINE 00001511 ""
NSQ_SOURCE_LINE 00001512 "Or, issue a C<BEGIN> statement explicitly each time you begin"
NSQ_SOURCE_LINE 00001513 "a transaction."
NSQ_SOURCE_LINE 00001514 ""
NSQ_SOURCE_LINE 00001515 "See L<http://sqlite.org/lockingv3.html> for locking details."
NSQ_SOURCE_LINE 00001516 ""
NSQ_SOURCE_LINE 00001517 "=head2 C<< $sth->finish >> and Transaction Rollback"
NSQ_SOURCE_LINE 00001518 ""
NSQ_SOURCE_LINE 00001519 "As the L<DBI> doc says, you almost certainly do B<not> need to"
NSQ_SOURCE_LINE 00001520 "call L<DBI/finish> method if you fetch all rows (probably in a loop)."
NSQ_SOURCE_LINE 00001521 "However, there are several exceptions to this rule, and rolling-back"
NSQ_SOURCE_LINE 00001522 "of an unfinished C<SELECT> statement is one of such exceptional"
NSQ_SOURCE_LINE 00001523 "cases. "
NSQ_SOURCE_LINE 00001524 ""
NSQ_SOURCE_LINE 00001525 "SQLite prohibits C<ROLLBACK> of unfinished C<SELECT> statements in"
NSQ_SOURCE_LINE 00001526 "a transaction (See L<http://sqlite.org/lang_transaction.html> for"
NSQ_SOURCE_LINE 00001527 "details). So you need to call C<finish> before you issue a rollback."
NSQ_SOURCE_LINE 00001528 ""
NSQ_SOURCE_LINE 00001529 "  $sth = $dbh->prepare(\"SELECT * FROM t\");"
NSQ_SOURCE_LINE 00001530 "  $dbh->begin_work;"
NSQ_SOURCE_LINE 00001531 "  eval {"
NSQ_SOURCE_LINE 00001532 "      $sth->execute;"
NSQ_SOURCE_LINE 00001533 "      $row = $sth->fetch;"
NSQ_SOURCE_LINE 00001534 "      ..."
NSQ_SOURCE_LINE 00001535 "      die \"For some reason\";"
NSQ_SOURCE_LINE 00001536 "      ..."
NSQ_SOURCE_LINE 00001537 "  };"
NSQ_SOURCE_LINE 00001538 "  if($@) {"
NSQ_SOURCE_LINE 00001539 "     $sth->finish;  # You need this for SQLite"
NSQ_SOURCE_LINE 00001540 "     $dbh->rollback;"
NSQ_SOURCE_LINE 00001541 "  } else {"
NSQ_SOURCE_LINE 00001542 "     $dbh->commit;"
NSQ_SOURCE_LINE 00001543 "  }"
NSQ_SOURCE_LINE 00001544 ""
NSQ_SOURCE_LINE 00001545 "=head2 Processing Multiple Statements At A Time"
NSQ_SOURCE_LINE 00001546 ""
NSQ_SOURCE_LINE 00001547 "L<DBI>'s statement handle is not supposed to process multiple"
NSQ_SOURCE_LINE 00001548 "statements at a time. So if you pass a string that contains multiple"
NSQ_SOURCE_LINE 00001549 "statements (a C<dump>) to a statement handle (via C<prepare> or C<do>),"
NSQ_SOURCE_LINE 00001550 "L<DBD::SQLite> only processes the first statement, and discards the"
NSQ_SOURCE_LINE 00001551 "rest."
NSQ_SOURCE_LINE 00001552 ""
NSQ_SOURCE_LINE 00001553 "If you need to process multiple statements at a time, set "
NSQ_SOURCE_LINE 00001554 "a C<sqlite_allow_multiple_statements> attribute of a database handle"
NSQ_SOURCE_LINE 00001555 "to true when you connect to a database, and C<do> method takes care"
NSQ_SOURCE_LINE 00001556 "of the rest (since 1.30_01, and without creating DBI's statement"
NSQ_SOURCE_LINE 00001557 "handles internally since 1.47_01). If you do need to use C<prepare>"
NSQ_SOURCE_LINE 00001558 "or C<prepare_cached> (which I don't recommend in this case, because"
NSQ_SOURCE_LINE 00001559 "typically there's no placeholder nor reusable part in a dump),"
NSQ_SOURCE_LINE 00001560 "you can look at C<< $sth->{sqlite_unprepared_statements} >> to retrieve"
NSQ_SOURCE_LINE 00001561 "what's left, though it usually contains nothing but white spaces."
NSQ_SOURCE_LINE 00001562 ""
NSQ_SOURCE_LINE 00001563 "=head2 TYPE statement attribute"
NSQ_SOURCE_LINE 00001564 ""
NSQ_SOURCE_LINE 00001565 "Because of historical reasons, DBD::SQLite's C<TYPE> statement"
NSQ_SOURCE_LINE 00001566 "handle attribute returns an array ref of string values, contrary to"
NSQ_SOURCE_LINE 00001567 "the DBI specification. This value is also less useful for SQLite"
NSQ_SOURCE_LINE 00001568 "users because SQLite uses dynamic type system (that means,"
NSQ_SOURCE_LINE 00001569 "the datatype of a value is associated with the value itself, not"
NSQ_SOURCE_LINE 00001570 "with its container)."
NSQ_SOURCE_LINE 00001571 ""
NSQ_SOURCE_LINE 00001572 "As of version 1.61_02, if you set C<sqlite_prefer_numeric_type>"
NSQ_SOURCE_LINE 00001573 "database handle attribute to true, C<TYPE> statement handle"
NSQ_SOURCE_LINE 00001574 "attribute returns an array of integer, as an experiment."
NSQ_SOURCE_LINE 00001575 ""
NSQ_SOURCE_LINE 00001576 "=head2 Performance"
NSQ_SOURCE_LINE 00001577 ""
NSQ_SOURCE_LINE 00001578 "SQLite is fast, very fast. Matt processed his 72MB log file with it,"
NSQ_SOURCE_LINE 00001579 "inserting the data (400,000+ rows) by using transactions and only"
NSQ_SOURCE_LINE 00001580 "committing every 1000 rows (otherwise the insertion is quite slow),"
NSQ_SOURCE_LINE 00001581 "and then performing queries on the data."
NSQ_SOURCE_LINE 00001582 ""
NSQ_SOURCE_LINE 00001583 "Queries like count(*) and avg(bytes) took fractions of a second to"
NSQ_SOURCE_LINE 00001584 "return, but what surprised him most of all was:"
NSQ_SOURCE_LINE 00001585 ""
NSQ_SOURCE_LINE 00001586 "  SELECT url, count(*) as count"
NSQ_SOURCE_LINE 00001587 "  FROM access_log"
NSQ_SOURCE_LINE 00001588 "  GROUP BY url"
NSQ_SOURCE_LINE 00001589 "  ORDER BY count desc"
NSQ_SOURCE_LINE 00001590 "  LIMIT 20"
NSQ_SOURCE_LINE 00001591 ""
NSQ_SOURCE_LINE 00001592 "To discover the top 20 hit URLs on the site (L<http://axkit.org>),"
NSQ_SOURCE_LINE 00001593 "and it returned within 2 seconds. He was seriously considering"
NSQ_SOURCE_LINE 00001594 "switching his log analysis code to use this little speed demon!"
NSQ_SOURCE_LINE 00001595 ""
NSQ_SOURCE_LINE 00001596 "Oh yeah, and that was with no indexes on the table, on a 400MHz PIII."
NSQ_SOURCE_LINE 00001597 ""
NSQ_SOURCE_LINE 00001598 "For best performance be sure to tune your hdparm settings if you"
NSQ_SOURCE_LINE 00001599 "are using linux. Also you might want to set:"
NSQ_SOURCE_LINE 00001600 ""
NSQ_SOURCE_LINE 00001601 "  PRAGMA synchronous = OFF"
NSQ_SOURCE_LINE 00001602 ""
NSQ_SOURCE_LINE 00001603 "Which will prevent SQLite from doing fsync's when writing (which"
NSQ_SOURCE_LINE 00001604 "slows down non-transactional writes significantly) at the expense"
NSQ_SOURCE_LINE 00001605 "of some peace of mind. Also try playing with the cache_size pragma."
NSQ_SOURCE_LINE 00001606 ""
NSQ_SOURCE_LINE 00001607 "The memory usage of SQLite can also be tuned using the cache_size"
NSQ_SOURCE_LINE 00001608 "pragma."
NSQ_SOURCE_LINE 00001609 ""
NSQ_SOURCE_LINE 00001610 "  $dbh->do(\"PRAGMA cache_size = 800000\");"
NSQ_SOURCE_LINE 00001611 ""
NSQ_SOURCE_LINE 00001612 "The above will allocate 800M for DB cache; the default is 2M."
NSQ_SOURCE_LINE 00001613 "Your sweet spot probably lies somewhere in between."
NSQ_SOURCE_LINE 00001614 ""
NSQ_SOURCE_LINE 00001615 "=head1 DRIVER PRIVATE ATTRIBUTES"
NSQ_SOURCE_LINE 00001616 ""
NSQ_SOURCE_LINE 00001617 "=head2 Database Handle Attributes"
NSQ_SOURCE_LINE 00001618 ""
NSQ_SOURCE_LINE 00001619 "=over 4"
NSQ_SOURCE_LINE 00001620 ""
NSQ_SOURCE_LINE 00001621 "=item sqlite_version"
NSQ_SOURCE_LINE 00001622 ""
NSQ_SOURCE_LINE 00001623 "Returns the version of the SQLite library which B<DBD::SQLite> is using,"
NSQ_SOURCE_LINE 00001624 "e.g., \"3.26.0\". Can only be read."
NSQ_SOURCE_LINE 00001625 ""
NSQ_SOURCE_LINE 00001626 "=item sqlite_string_mode"
NSQ_SOURCE_LINE 00001627 ""
NSQ_SOURCE_LINE 00001628 "SQLite strings are simple arrays of bytes, but Perl strings can store any"
NSQ_SOURCE_LINE 00001629 "arbitrary Unicode code point. Thus, DBD::SQLite has to adopt some method"
NSQ_SOURCE_LINE 00001630 "of translating between those two models. This parameter defines that"
NSQ_SOURCE_LINE 00001631 "translation."
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "Accepted values are the following constants:"
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "=over"
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 "=item * DBD_SQLITE_STRING_MODE_BYTES: All strings are assumed to"
NSQ_SOURCE_LINE 00001638 "represent bytes. A Perl string that contains any code point above 255"
NSQ_SOURCE_LINE 00001639 "will trigger an exception. This is appropriate for Latin-1 strings,"
NSQ_SOURCE_LINE 00001640 "binary data, pre-encoded UTF-8 strings, etc."
NSQ_SOURCE_LINE 00001641 ""
NSQ_SOURCE_LINE 00001642 "=item * DBD_SQLITE_STRING_MODE_UNICODE_FALLBACK: All Perl strings are encoded"
NSQ_SOURCE_LINE 00001643 "to UTF-8 before being given to SQLite. Perl will B<try> to decode SQLite"
NSQ_SOURCE_LINE 00001644 "strings as UTF-8 when giving them to Perl. Should any such string not be"
NSQ_SOURCE_LINE 00001645 "valid UTF-8, a warning is thrown, and the string is left undecoded."
NSQ_SOURCE_LINE 00001646 ""
NSQ_SOURCE_LINE 00001647 "This is appropriate for strings that are decoded to characters via,"
NSQ_SOURCE_LINE 00001648 "e.g., L<Encode/decode>."
NSQ_SOURCE_LINE 00001649 ""
NSQ_SOURCE_LINE 00001650 "Also note that, due to some bizarreness in SQLite's type system (see"
NSQ_SOURCE_LINE 00001651 "L<https://www.sqlite.org/datatype3.html>), if you want to retain"
NSQ_SOURCE_LINE 00001652 "blob-style behavior for B<some> columns under DBD_SQLITE_STRING_MODE_UNICODE_FALLBACK"
NSQ_SOURCE_LINE 00001653 "(say, to store images in the database), you have to state so"
NSQ_SOURCE_LINE 00001654 "explicitly using the 3-argument form of L<DBI/bind_param> when doing"
NSQ_SOURCE_LINE 00001655 "updates:"
NSQ_SOURCE_LINE 00001656 ""
NSQ_SOURCE_LINE 00001657 "  use DBI qw(:sql_types);"
NSQ_SOURCE_LINE 00001658 "  use DBD::SQLite::Constants ':dbd_sqlite_string_mode';"
NSQ_SOURCE_LINE 00001659 "  $dbh->{sqlite_string_mode} = DBD_SQLITE_STRING_MODE_UNICODE_FALLBACK;"
NSQ_SOURCE_LINE 00001660 "  my $sth = $dbh->prepare(\"INSERT INTO mytable (blobcolumn) VALUES (?)\");"
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "  # Binary_data will be stored as is."
NSQ_SOURCE_LINE 00001663 "  $sth->bind_param(1, $binary_data, SQL_BLOB);"
NSQ_SOURCE_LINE 00001664 ""
NSQ_SOURCE_LINE 00001665 "Defining the column type as C<BLOB> in the DDL is B<not> sufficient."
NSQ_SOURCE_LINE 00001666 ""
NSQ_SOURCE_LINE 00001667 "=item * DBD_SQLITE_STRING_MODE_UNICODE_STRICT: Like"
NSQ_SOURCE_LINE 00001668 "DBD_SQLITE_STRING_MODE_UNICODE_FALLBACK but usually throws an exception"
NSQ_SOURCE_LINE 00001669 "rather than a warning if SQLite sends invalid UTF-8. (In Perl callbacks"
NSQ_SOURCE_LINE 00001670 "from SQLite we still warn instead.)"
NSQ_SOURCE_LINE 00001671 ""
NSQ_SOURCE_LINE 00001672 "=item * DBD_SQLITE_STRING_MODE_UNICODE_NAIVE: Like"
NSQ_SOURCE_LINE 00001673 "DBD_SQLITE_STRING_MODE_UNICODE_FALLBACK but uses a \"naïve\" UTF-8 decoding"
NSQ_SOURCE_LINE 00001674 "method that forgoes validation. This is marginally faster than a validated"
NSQ_SOURCE_LINE 00001675 "decode, but it can also B<corrupt> B<Perl> B<itself!>"
NSQ_SOURCE_LINE 00001676 ""
NSQ_SOURCE_LINE 00001677 "=item * DBD_SQLITE_STRING_MODE_PV (default, but B<DO> B<NOT> B<USE>): Like"
NSQ_SOURCE_LINE 00001678 "DBD_SQLITE_STRING_MODE_BYTES, but when translating Perl strings to SQLite"
NSQ_SOURCE_LINE 00001679 "the Perl string's internal byte buffer is given to SQLite. B<This> B<is>"
NSQ_SOURCE_LINE 00001680 "B<bad>, but it's been the default for many years, and changing that would"
NSQ_SOURCE_LINE 00001681 "break existing applications."
NSQ_SOURCE_LINE 00001682 ""
NSQ_SOURCE_LINE 00001683 "=back"
NSQ_SOURCE_LINE 00001684 ""
NSQ_SOURCE_LINE 00001685 "=item C<sqlite_unicode> or C<unicode> (deprecated)"
NSQ_SOURCE_LINE 00001686 ""
NSQ_SOURCE_LINE 00001687 "If truthy, equivalent to setting C<sqlite_string_mode> to"
NSQ_SOURCE_LINE 00001688 "DBD_SQLITE_STRING_MODE_UNICODE_NAIVE; if falsy, equivalent to"
NSQ_SOURCE_LINE 00001689 "DBD_SQLITE_STRING_MODE_PV."
NSQ_SOURCE_LINE 00001690 ""
NSQ_SOURCE_LINE 00001691 "Prefer C<sqlite_string_mode> in all new code."
NSQ_SOURCE_LINE 00001692 ""
NSQ_SOURCE_LINE 00001693 "=item sqlite_allow_multiple_statements"
NSQ_SOURCE_LINE 00001694 ""
NSQ_SOURCE_LINE 00001695 "If you set this to true, C<do> method will process multiple"
NSQ_SOURCE_LINE 00001696 "statements at one go. This may be handy, but with performance"
NSQ_SOURCE_LINE 00001697 "penalty. See above for details."
NSQ_SOURCE_LINE 00001698 ""
NSQ_SOURCE_LINE 00001699 "=item sqlite_use_immediate_transaction"
NSQ_SOURCE_LINE 00001700 ""
NSQ_SOURCE_LINE 00001701 "If you set this to true, DBD::SQLite tries to issue a C<begin"
NSQ_SOURCE_LINE 00001702 "immediate transaction> (instead of C<begin transaction>) when"
NSQ_SOURCE_LINE 00001703 "necessary. See above for details."
NSQ_SOURCE_LINE 00001704 ""
NSQ_SOURCE_LINE 00001705 "As of version 1.38_01, this attribute is set to true by default."
NSQ_SOURCE_LINE 00001706 "If you really need to use C<deferred> transactions for some reasons,"
NSQ_SOURCE_LINE 00001707 "set this to false explicitly."
NSQ_SOURCE_LINE 00001708 ""
NSQ_SOURCE_LINE 00001709 "=item sqlite_see_if_its_a_number"
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 "If you set this to true, DBD::SQLite tries to see if the bind values"
NSQ_SOURCE_LINE 00001712 "are number or not, and does not quote if they are numbers. See above"
NSQ_SOURCE_LINE 00001713 "for details."
NSQ_SOURCE_LINE 00001714 ""
NSQ_SOURCE_LINE 00001715 "=item sqlite_extended_result_codes"
NSQ_SOURCE_LINE 00001716 ""
NSQ_SOURCE_LINE 00001717 "If set to true, DBD::SQLite uses extended result codes where appropriate"
NSQ_SOURCE_LINE 00001718 "(see L<https://www.sqlite.org/rescode.html>)."
NSQ_SOURCE_LINE 00001719 ""
NSQ_SOURCE_LINE 00001720 "=item sqlite_defensive"
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "If set to true, language features that allow ordinary SQL to deliberately"
NSQ_SOURCE_LINE 00001723 "corrupt the database file are prohibited."
NSQ_SOURCE_LINE 00001724 ""
NSQ_SOURCE_LINE 00001725 "=back"
NSQ_SOURCE_LINE 00001726 ""
NSQ_SOURCE_LINE 00001727 "=head2 Statement Handle Attributes"
NSQ_SOURCE_LINE 00001728 ""
NSQ_SOURCE_LINE 00001729 "=over 4"
NSQ_SOURCE_LINE 00001730 ""
NSQ_SOURCE_LINE 00001731 "=item sqlite_unprepared_statements"
NSQ_SOURCE_LINE 00001732 ""
NSQ_SOURCE_LINE 00001733 "Returns an unprepared part of the statement you pass to C<prepare>."
NSQ_SOURCE_LINE 00001734 "Typically this contains nothing but white spaces after a semicolon."
NSQ_SOURCE_LINE 00001735 "See above for details."
NSQ_SOURCE_LINE 00001736 ""
NSQ_SOURCE_LINE 00001737 "=back"
NSQ_SOURCE_LINE 00001738 ""
NSQ_SOURCE_LINE 00001739 "=head1 METHODS"
NSQ_SOURCE_LINE 00001740 ""
NSQ_SOURCE_LINE 00001741 "See also to the L<DBI> documentation for the details of other common"
NSQ_SOURCE_LINE 00001742 "methods."
NSQ_SOURCE_LINE 00001743 ""
NSQ_SOURCE_LINE 00001744 "=head2 table_info"
NSQ_SOURCE_LINE 00001745 ""
NSQ_SOURCE_LINE 00001746 "  $sth = $dbh->table_info(undef, $schema, $table, $type, \\%attr);"
NSQ_SOURCE_LINE 00001747 ""
NSQ_SOURCE_LINE 00001748 "Returns all tables and schemas (databases) as specified in L<DBI/table_info>."
NSQ_SOURCE_LINE 00001749 "The schema and table arguments will do a C<LIKE> search. You can specify an"
NSQ_SOURCE_LINE 00001750 "ESCAPE character by including an 'Escape' attribute in \\%attr. The C<$type>"
NSQ_SOURCE_LINE 00001751 "argument accepts a comma separated list of the following types 'TABLE',"
NSQ_SOURCE_LINE 00001752 "'INDEX', 'VIEW', 'TRIGGER', 'LOCAL TEMPORARY' and 'SYSTEM TABLE'"
NSQ_SOURCE_LINE 00001753 "(by default all are returned)."
NSQ_SOURCE_LINE 00001754 "Note that a statement handle is returned, and not a direct list of tables."
NSQ_SOURCE_LINE 00001755 ""
NSQ_SOURCE_LINE 00001756 "The following fields are returned:"
NSQ_SOURCE_LINE 00001757 ""
NSQ_SOURCE_LINE 00001758 "B<TABLE_CAT>: Always NULL, as SQLite does not have the concept of catalogs."
NSQ_SOURCE_LINE 00001759 ""
NSQ_SOURCE_LINE 00001760 "B<TABLE_SCHEM>: The name of the schema (database) that the table or view is"
NSQ_SOURCE_LINE 00001761 "in. The default schema is 'main', temporary tables are in 'temp' and other"
NSQ_SOURCE_LINE 00001762 "databases will be in the name given when the database was attached."
NSQ_SOURCE_LINE 00001763 ""
NSQ_SOURCE_LINE 00001764 "B<TABLE_NAME>: The name of the table or view."
NSQ_SOURCE_LINE 00001765 ""
NSQ_SOURCE_LINE 00001766 "B<TABLE_TYPE>: The type of object returned. Will be one of 'TABLE', 'INDEX',"
NSQ_SOURCE_LINE 00001767 "'VIEW', 'TRIGGER', 'LOCAL TEMPORARY' or 'SYSTEM TABLE'."
NSQ_SOURCE_LINE 00001768 ""
NSQ_SOURCE_LINE 00001769 "=head2 primary_key, primary_key_info"
NSQ_SOURCE_LINE 00001770 ""
NSQ_SOURCE_LINE 00001771 "  @names = $dbh->primary_key(undef, $schema, $table);"
NSQ_SOURCE_LINE 00001772 "  $sth   = $dbh->primary_key_info(undef, $schema, $table, \\%attr);"
NSQ_SOURCE_LINE 00001773 ""
NSQ_SOURCE_LINE 00001774 "You can retrieve primary key names or more detailed information."
NSQ_SOURCE_LINE 00001775 "As noted above, SQLite does not have the concept of catalogs, so the"
NSQ_SOURCE_LINE 00001776 "first argument of the methods is usually C<undef>, and you'll usually"
NSQ_SOURCE_LINE 00001777 "set C<undef> for the second one (unless you want to know the primary"
NSQ_SOURCE_LINE 00001778 "keys of temporary tables)."
NSQ_SOURCE_LINE 00001779 ""
NSQ_SOURCE_LINE 00001780 ""
NSQ_SOURCE_LINE 00001781 "=head2 foreign_key_info"
NSQ_SOURCE_LINE 00001782 ""
NSQ_SOURCE_LINE 00001783 "  $sth = $dbh->foreign_key_info(undef, $pk_schema, $pk_table,"
NSQ_SOURCE_LINE 00001784 "                                undef, $fk_schema, $fk_table);"
NSQ_SOURCE_LINE 00001785 ""
NSQ_SOURCE_LINE 00001786 "Returns information about foreign key constraints, as specified in"
NSQ_SOURCE_LINE 00001787 "L<DBI/foreign_key_info>, but with some limitations : "
NSQ_SOURCE_LINE 00001788 ""
NSQ_SOURCE_LINE 00001789 "=over"
NSQ_SOURCE_LINE 00001790 ""
NSQ_SOURCE_LINE 00001791 "=item *"
NSQ_SOURCE_LINE 00001792 ""
NSQ_SOURCE_LINE 00001793 "information in rows returned by the C<$sth> is incomplete with"
NSQ_SOURCE_LINE 00001794 "respect to the L<DBI/foreign_key_info> specification. All requested fields"
NSQ_SOURCE_LINE 00001795 "are present, but the content is C<undef> for some of them."
NSQ_SOURCE_LINE 00001796 ""
NSQ_SOURCE_LINE 00001797 "=back"
NSQ_SOURCE_LINE 00001798 ""
NSQ_SOURCE_LINE 00001799 "The following nonempty fields are returned :"
NSQ_SOURCE_LINE 00001800 ""
NSQ_SOURCE_LINE 00001801 "B<PKTABLE_NAME>:"
NSQ_SOURCE_LINE 00001802 "The primary (unique) key table identifier."
NSQ_SOURCE_LINE 00001803 ""
NSQ_SOURCE_LINE 00001804 "B<PKCOLUMN_NAME>:"
NSQ_SOURCE_LINE 00001805 "The primary (unique) key column identifier."
NSQ_SOURCE_LINE 00001806 ""
NSQ_SOURCE_LINE 00001807 "B<FKTABLE_NAME>:"
NSQ_SOURCE_LINE 00001808 "The foreign key table identifier."
NSQ_SOURCE_LINE 00001809 ""
NSQ_SOURCE_LINE 00001810 "B<FKCOLUMN_NAME>:"
NSQ_SOURCE_LINE 00001811 "The foreign key column identifier."
NSQ_SOURCE_LINE 00001812 ""
NSQ_SOURCE_LINE 00001813 "B<KEY_SEQ>:"
NSQ_SOURCE_LINE 00001814 "The column sequence number (starting with 1), when"
NSQ_SOURCE_LINE 00001815 "several columns belong to a same constraint."
NSQ_SOURCE_LINE 00001816 ""
NSQ_SOURCE_LINE 00001817 "B<UPDATE_RULE>:"
NSQ_SOURCE_LINE 00001818 "The referential action for the UPDATE rule."
NSQ_SOURCE_LINE 00001819 "The following codes are defined:"
NSQ_SOURCE_LINE 00001820 ""
NSQ_SOURCE_LINE 00001821 "  CASCADE              0"
NSQ_SOURCE_LINE 00001822 "  RESTRICT             1"
NSQ_SOURCE_LINE 00001823 "  SET NULL             2"
NSQ_SOURCE_LINE 00001824 "  NO ACTION            3"
NSQ_SOURCE_LINE 00001825 "  SET DEFAULT          4"
NSQ_SOURCE_LINE 00001826 ""
NSQ_SOURCE_LINE 00001827 "Default is 3 ('NO ACTION')."
NSQ_SOURCE_LINE 00001828 ""
NSQ_SOURCE_LINE 00001829 "B<DELETE_RULE>:"
NSQ_SOURCE_LINE 00001830 "The referential action for the DELETE rule."
NSQ_SOURCE_LINE 00001831 "The codes are the same as for UPDATE_RULE."
NSQ_SOURCE_LINE 00001832 ""
NSQ_SOURCE_LINE 00001833 "B<DEFERRABILITY>:"
NSQ_SOURCE_LINE 00001834 "The following codes are defined:"
NSQ_SOURCE_LINE 00001835 ""
NSQ_SOURCE_LINE 00001836 "  INITIALLY DEFERRED   5"
NSQ_SOURCE_LINE 00001837 "  INITIALLY IMMEDIATE  6"
NSQ_SOURCE_LINE 00001838 "  NOT DEFERRABLE       7"
NSQ_SOURCE_LINE 00001839 ""
NSQ_SOURCE_LINE 00001840 "B<UNIQUE_OR_PRIMARY>:"
NSQ_SOURCE_LINE 00001841 "Whether the column is primary or unique."
NSQ_SOURCE_LINE 00001842 ""
NSQ_SOURCE_LINE 00001843 "B<Note>: foreign key support in SQLite must be explicitly turned on through"
NSQ_SOURCE_LINE 00001844 "a C<PRAGMA> command; see L</\"Foreign keys\"> earlier in this manual."
NSQ_SOURCE_LINE 00001845 ""
NSQ_SOURCE_LINE 00001846 "=head2 statistics_info"
NSQ_SOURCE_LINE 00001847 ""
NSQ_SOURCE_LINE 00001848 "  $sth = $dbh->statistics_info(undef, $schema, $table,"
NSQ_SOURCE_LINE 00001849 "                                $unique_only, $quick);"
NSQ_SOURCE_LINE 00001850 ""
NSQ_SOURCE_LINE 00001851 "Returns information about a table and it's indexes, as specified in"
NSQ_SOURCE_LINE 00001852 "L<DBI/statistics_info>, but with some limitations : "
NSQ_SOURCE_LINE 00001853 ""
NSQ_SOURCE_LINE 00001854 "=over"
NSQ_SOURCE_LINE 00001855 ""
NSQ_SOURCE_LINE 00001856 "=item *"
NSQ_SOURCE_LINE 00001857 ""
NSQ_SOURCE_LINE 00001858 "information in rows returned by the C<$sth> is incomplete with"
NSQ_SOURCE_LINE 00001859 "respect to the L<DBI/statistics_info> specification. All requested fields"
NSQ_SOURCE_LINE 00001860 "are present, but the content is C<undef> for some of them."
NSQ_SOURCE_LINE 00001861 ""
NSQ_SOURCE_LINE 00001862 "=back"
NSQ_SOURCE_LINE 00001863 ""
NSQ_SOURCE_LINE 00001864 "The following nonempty fields are returned :"
NSQ_SOURCE_LINE 00001865 ""
NSQ_SOURCE_LINE 00001866 "B<TABLE_SCHEM>:"
NSQ_SOURCE_LINE 00001867 "The name of the schema (database) that the table is in. The default schema is 'main', temporary tables are in 'temp' and other databases will be in the name given when the database was attached."
NSQ_SOURCE_LINE 00001868 ""
NSQ_SOURCE_LINE 00001869 "B<TABLE_NAME>:"
NSQ_SOURCE_LINE 00001870 "The name of the table"
NSQ_SOURCE_LINE 00001871 ""
NSQ_SOURCE_LINE 00001872 "B<NON_UNIQUE>:"
NSQ_SOURCE_LINE 00001873 "Contains 0 for unique indexes, 1 for non-unique indexes"
NSQ_SOURCE_LINE 00001874 ""
NSQ_SOURCE_LINE 00001875 "B<INDEX_NAME>:"
NSQ_SOURCE_LINE 00001876 "The name of the index"
NSQ_SOURCE_LINE 00001877 ""
NSQ_SOURCE_LINE 00001878 "B<TYPE>:"
NSQ_SOURCE_LINE 00001879 "SQLite uses 'btree' for all it's indexes"
NSQ_SOURCE_LINE 00001880 ""
NSQ_SOURCE_LINE 00001881 "B<ORDINAL_POSITION>:"
NSQ_SOURCE_LINE 00001882 "Column sequence number (starting with 1)."
NSQ_SOURCE_LINE 00001883 ""
NSQ_SOURCE_LINE 00001884 "B<COLUMN_NAME>:"
NSQ_SOURCE_LINE 00001885 "The name of the column"
NSQ_SOURCE_LINE 00001886 ""
NSQ_SOURCE_LINE 00001887 "=head2 ping"
NSQ_SOURCE_LINE 00001888 ""
NSQ_SOURCE_LINE 00001889 "  my $bool = $dbh->ping;"
NSQ_SOURCE_LINE 00001890 ""
NSQ_SOURCE_LINE 00001891 "returns true if the database file exists (or the database is in-memory), and the database connection is active."
NSQ_SOURCE_LINE 00001892 ""
NSQ_SOURCE_LINE 00001893 "=head1 DRIVER PRIVATE METHODS"
NSQ_SOURCE_LINE 00001894 ""
NSQ_SOURCE_LINE 00001895 "The following methods can be called via the func() method with a little"
NSQ_SOURCE_LINE 00001896 "tweak, but the use of func() method is now discouraged by the L<DBI> author"
NSQ_SOURCE_LINE 00001897 "for various reasons (see DBI's document"
NSQ_SOURCE_LINE 00001898 "L<https://metacpan.org/pod/DBI::DBD#Using-install_method()-to-expose-driver-private-methods>"
NSQ_SOURCE_LINE 00001899 "for details). So, if you're using L<DBI> >= 1.608, use these C<sqlite_>"
NSQ_SOURCE_LINE 00001900 "methods. If you need to use an older L<DBI>, you can call these like this:"
NSQ_SOURCE_LINE 00001901 ""
NSQ_SOURCE_LINE 00001902 "  $dbh->func( ..., \"(method name without sqlite_ prefix)\" );"
NSQ_SOURCE_LINE 00001903 ""
NSQ_SOURCE_LINE 00001904 "Exception: C<sqlite_trace> should always be called as is, even with C<func()>"
NSQ_SOURCE_LINE 00001905 "method (to avoid conflict with DBI's trace() method)."
NSQ_SOURCE_LINE 00001906 ""
NSQ_SOURCE_LINE 00001907 "  $dbh->func( ..., \"sqlite_trace\");"
NSQ_SOURCE_LINE 00001908 ""
NSQ_SOURCE_LINE 00001909 "=head2 $dbh->sqlite_last_insert_rowid()"
NSQ_SOURCE_LINE 00001910 ""
NSQ_SOURCE_LINE 00001911 "This method returns the last inserted rowid. If you specify an INTEGER PRIMARY"
NSQ_SOURCE_LINE 00001912 "KEY as the first column in your table, that is the column that is returned."
NSQ_SOURCE_LINE 00001913 "Otherwise, it is the hidden ROWID column. See the SQLite docs for details."
NSQ_SOURCE_LINE 00001914 ""
NSQ_SOURCE_LINE 00001915 "Generally you should not be using this method. Use the L<DBI> last_insert_id"
NSQ_SOURCE_LINE 00001916 "method instead. The usage of this is:"
NSQ_SOURCE_LINE 00001917 ""
NSQ_SOURCE_LINE 00001918 "  $h->last_insert_id($catalog, $schema, $table_name, $field_name [, \\%attr ])"
NSQ_SOURCE_LINE 00001919 ""
NSQ_SOURCE_LINE 00001920 "Running C<$h-E<gt>last_insert_id(\"\",\"\",\"\",\"\")> is the equivalent of running"
NSQ_SOURCE_LINE 00001921 "C<$dbh-E<gt>sqlite_last_insert_rowid()> directly."
NSQ_SOURCE_LINE 00001922 ""
NSQ_SOURCE_LINE 00001923 "=head2 $dbh->sqlite_db_filename()"
NSQ_SOURCE_LINE 00001924 ""
NSQ_SOURCE_LINE 00001925 "Retrieve the current (main) database filename. If the database is in-memory"
NSQ_SOURCE_LINE 00001926 "or temporary, this returns an empty string, or C<undef>."
NSQ_SOURCE_LINE 00001927 ""
NSQ_SOURCE_LINE 00001928 "=head2 $dbh->sqlite_busy_timeout()"
NSQ_SOURCE_LINE 00001929 ""
NSQ_SOURCE_LINE 00001930 "Retrieve the current busy timeout."
NSQ_SOURCE_LINE 00001931 ""
NSQ_SOURCE_LINE 00001932 "=head2 $dbh->sqlite_busy_timeout( $ms )"
NSQ_SOURCE_LINE 00001933 ""
NSQ_SOURCE_LINE 00001934 "Set the current busy timeout. The timeout is in milliseconds."
NSQ_SOURCE_LINE 00001935 ""
NSQ_SOURCE_LINE 00001936 "=head2 $dbh->sqlite_create_function( $name, $argc, $code_ref, $flags )"
NSQ_SOURCE_LINE 00001937 ""
NSQ_SOURCE_LINE 00001938 "This method will register a new function which will be usable in an SQL"
NSQ_SOURCE_LINE 00001939 "query. The method's parameters are:"
NSQ_SOURCE_LINE 00001940 ""
NSQ_SOURCE_LINE 00001941 "=over"
NSQ_SOURCE_LINE 00001942 ""
NSQ_SOURCE_LINE 00001943 "=item $name"
NSQ_SOURCE_LINE 00001944 ""
NSQ_SOURCE_LINE 00001945 "The name of the function. This is the name of the function as it will"
NSQ_SOURCE_LINE 00001946 "be used from SQL."
NSQ_SOURCE_LINE 00001947 ""
NSQ_SOURCE_LINE 00001948 "=item $argc"
NSQ_SOURCE_LINE 00001949 ""
NSQ_SOURCE_LINE 00001950 "The number of arguments taken by the function. If this number is -1,"
NSQ_SOURCE_LINE 00001951 "the function can take any number of arguments."
NSQ_SOURCE_LINE 00001952 ""
NSQ_SOURCE_LINE 00001953 "=item $code_ref"
NSQ_SOURCE_LINE 00001954 ""
NSQ_SOURCE_LINE 00001955 "This should be a reference to the function's implementation."
NSQ_SOURCE_LINE 00001956 ""
NSQ_SOURCE_LINE 00001957 "=item $flags"
NSQ_SOURCE_LINE 00001958 ""
NSQ_SOURCE_LINE 00001959 "You can optionally pass an extra flag bit to create_function, which then would be ORed with SQLITE_UTF8 (default). As of 1.47_02 (SQLite 3.8.9), only meaning bit is SQLITE_DETERMINISTIC (introduced at SQLite 3.8.3), which can make the function perform better. See C API documentation at L<http://sqlite.org/c3ref/create_function.html> for details."
NSQ_SOURCE_LINE 00001960 ""
NSQ_SOURCE_LINE 00001961 "=back"
NSQ_SOURCE_LINE 00001962 ""
NSQ_SOURCE_LINE 00001963 "For example, here is how to define a now() function which returns the"
NSQ_SOURCE_LINE 00001964 "current number of seconds since the epoch:"
NSQ_SOURCE_LINE 00001965 ""
NSQ_SOURCE_LINE 00001966 "  $dbh->sqlite_create_function( 'now', 0, sub { return time } );"
NSQ_SOURCE_LINE 00001967 ""
NSQ_SOURCE_LINE 00001968 "After this, it could be used from SQL as:"
NSQ_SOURCE_LINE 00001969 ""
NSQ_SOURCE_LINE 00001970 "  INSERT INTO mytable ( now() );"
NSQ_SOURCE_LINE 00001971 ""
NSQ_SOURCE_LINE 00001972 "The function should return a scalar value, and the value is treated as a text"
NSQ_SOURCE_LINE 00001973 "(or a number if appropriate) by default. If you do need to specify a type"
NSQ_SOURCE_LINE 00001974 "of the return value (like BLOB), you can return a reference to an array that"
NSQ_SOURCE_LINE 00001975 "contains the value and the type, as of 1.65_01."
NSQ_SOURCE_LINE 00001976 ""
NSQ_SOURCE_LINE 00001977 "  $dbh->sqlite_create_function( 'md5', 1, sub { return [md5($_[0]), SQL_BLOB] } );"
NSQ_SOURCE_LINE 00001978 ""
NSQ_SOURCE_LINE 00001979 "=head3 REGEXP function"
NSQ_SOURCE_LINE 00001980 ""
NSQ_SOURCE_LINE 00001981 "SQLite includes syntactic support for an infix operator 'REGEXP', but"
NSQ_SOURCE_LINE 00001982 "without any implementation. The C<DBD::SQLite> driver"
NSQ_SOURCE_LINE 00001983 "automatically registers an implementation that performs standard"
NSQ_SOURCE_LINE 00001984 "perl regular expression matching, using current locale. So for example"
NSQ_SOURCE_LINE 00001985 "you can search for words starting with an 'A' with a query like"
NSQ_SOURCE_LINE 00001986 ""
NSQ_SOURCE_LINE 00001987 "  SELECT * from table WHERE column REGEXP '\\bA\\w+'"
NSQ_SOURCE_LINE 00001988 ""
NSQ_SOURCE_LINE 00001989 "If you want case-insensitive searching, use perl regex flags, like this :"
NSQ_SOURCE_LINE 00001990 ""
NSQ_SOURCE_LINE 00001991 "  SELECT * from table WHERE column REGEXP '(?i:\\bA\\w+)'"
NSQ_SOURCE_LINE 00001992 ""
NSQ_SOURCE_LINE 00001993 "The default REGEXP implementation can be overridden through the"
NSQ_SOURCE_LINE 00001994 "C<create_function> API described above."
NSQ_SOURCE_LINE 00001995 ""
NSQ_SOURCE_LINE 00001996 "Note that regexp matching will B<not> use SQLite indices, but will iterate"
NSQ_SOURCE_LINE 00001997 "over all rows, so it could be quite costly in terms of performance."
NSQ_SOURCE_LINE 00001998 ""
NSQ_SOURCE_LINE 00001999 "=head2 $dbh->sqlite_create_collation( $name, $code_ref )"
NSQ_SOURCE_LINE 00002000 ""
NSQ_SOURCE_LINE 00002001 "This method manually registers a new function which will be usable in an SQL"
NSQ_SOURCE_LINE 00002002 "query as a COLLATE option for sorting. Such functions can also be registered"
NSQ_SOURCE_LINE 00002003 "automatically on demand: see section L</\"COLLATION FUNCTIONS\"> below."
NSQ_SOURCE_LINE 00002004 ""
NSQ_SOURCE_LINE 00002005 "The method's parameters are:"
NSQ_SOURCE_LINE 00002006 ""
NSQ_SOURCE_LINE 00002007 "=over"
NSQ_SOURCE_LINE 00002008 ""
NSQ_SOURCE_LINE 00002009 "=item $name"
NSQ_SOURCE_LINE 00002010 ""
NSQ_SOURCE_LINE 00002011 "The name of the function exposed to SQL."
NSQ_SOURCE_LINE 00002012 ""
NSQ_SOURCE_LINE 00002013 "=item $code_ref"
NSQ_SOURCE_LINE 00002014 ""
NSQ_SOURCE_LINE 00002015 "Reference to the function's implementation."
NSQ_SOURCE_LINE 00002016 "The driver will check that this is a proper sorting function."
NSQ_SOURCE_LINE 00002017 ""
NSQ_SOURCE_LINE 00002018 "=back"
NSQ_SOURCE_LINE 00002019 ""
NSQ_SOURCE_LINE 00002020 "=head2 $dbh->sqlite_collation_needed( $code_ref )"
NSQ_SOURCE_LINE 00002021 ""
NSQ_SOURCE_LINE 00002022 "This method manually registers a callback function that will"
NSQ_SOURCE_LINE 00002023 "be invoked whenever an undefined collation sequence is required"
NSQ_SOURCE_LINE 00002024 "from an SQL statement. The callback is invoked as"
NSQ_SOURCE_LINE 00002025 ""
NSQ_SOURCE_LINE 00002026 "  $code_ref->($dbh, $collation_name)"
NSQ_SOURCE_LINE 00002027 ""
NSQ_SOURCE_LINE 00002028 "and should register the desired collation using"
NSQ_SOURCE_LINE 00002029 "L</\"sqlite_create_collation\">."
NSQ_SOURCE_LINE 00002030 ""
NSQ_SOURCE_LINE 00002031 "An initial callback is already registered by C<DBD::SQLite>,"
NSQ_SOURCE_LINE 00002032 "so for most common cases it will be simpler to just"
NSQ_SOURCE_LINE 00002033 "add your collation sequences in the C<%DBD::SQLite::COLLATION>"
NSQ_SOURCE_LINE 00002034 "hash (see section L</\"COLLATION FUNCTIONS\"> below)."
NSQ_SOURCE_LINE 00002035 ""
NSQ_SOURCE_LINE 00002036 "=head2 $dbh->sqlite_create_aggregate( $name, $argc, $pkg, $flags )"
NSQ_SOURCE_LINE 00002037 ""
NSQ_SOURCE_LINE 00002038 "This method will register a new aggregate function which can then be used"
NSQ_SOURCE_LINE 00002039 "from SQL. The method's parameters are:"
NSQ_SOURCE_LINE 00002040 ""
NSQ_SOURCE_LINE 00002041 "=over"
NSQ_SOURCE_LINE 00002042 ""
NSQ_SOURCE_LINE 00002043 "=item $name"
NSQ_SOURCE_LINE 00002044 ""
NSQ_SOURCE_LINE 00002045 "The name of the aggregate function, this is the name under which the"
NSQ_SOURCE_LINE 00002046 "function will be available from SQL."
NSQ_SOURCE_LINE 00002047 ""
NSQ_SOURCE_LINE 00002048 "=item $argc"
NSQ_SOURCE_LINE 00002049 ""
NSQ_SOURCE_LINE 00002050 "This is an integer which tells the SQL parser how many arguments the"
NSQ_SOURCE_LINE 00002051 "function takes. If that number is -1, the function can take any number"
NSQ_SOURCE_LINE 00002052 "of arguments."
NSQ_SOURCE_LINE 00002053 ""
NSQ_SOURCE_LINE 00002054 "=item $pkg"
NSQ_SOURCE_LINE 00002055 ""
NSQ_SOURCE_LINE 00002056 "This is the package which implements the aggregator interface."
NSQ_SOURCE_LINE 00002057 ""
NSQ_SOURCE_LINE 00002058 "=item $flags"
NSQ_SOURCE_LINE 00002059 ""
NSQ_SOURCE_LINE 00002060 "You can optionally pass an extra flag bit to create_aggregate, which then would be ORed with SQLITE_UTF8 (default). As of 1.47_02 (SQLite 3.8.9), only meaning bit is SQLITE_DETERMINISTIC (introduced at SQLite 3.8.3), which can make the function perform better. See C API documentation at L<http://sqlite.org/c3ref/create_function.html> for details."
NSQ_SOURCE_LINE 00002061 ""
NSQ_SOURCE_LINE 00002062 "=back"
NSQ_SOURCE_LINE 00002063 ""
NSQ_SOURCE_LINE 00002064 "The aggregator interface consists of defining three methods:"
NSQ_SOURCE_LINE 00002065 ""
NSQ_SOURCE_LINE 00002066 "=over"
NSQ_SOURCE_LINE 00002067 ""
NSQ_SOURCE_LINE 00002068 "=item new()"
NSQ_SOURCE_LINE 00002069 ""
NSQ_SOURCE_LINE 00002070 "This method will be called once to create an object which should"
NSQ_SOURCE_LINE 00002071 "be used to aggregate the rows in a particular group. The step() and"
NSQ_SOURCE_LINE 00002072 "finalize() methods will be called upon the reference return by"
NSQ_SOURCE_LINE 00002073 "the method."
NSQ_SOURCE_LINE 00002074 ""
NSQ_SOURCE_LINE 00002075 "=item step(@_)"
NSQ_SOURCE_LINE 00002076 ""
NSQ_SOURCE_LINE 00002077 "This method will be called once for each row in the aggregate."
NSQ_SOURCE_LINE 00002078 ""
NSQ_SOURCE_LINE 00002079 "=item finalize()"
NSQ_SOURCE_LINE 00002080 ""
NSQ_SOURCE_LINE 00002081 "This method will be called once all rows in the aggregate were"
NSQ_SOURCE_LINE 00002082 "processed and it should return the aggregate function's result. When"
NSQ_SOURCE_LINE 00002083 "there is no rows in the aggregate, finalize() will be called right"
NSQ_SOURCE_LINE 00002084 "after new()."
NSQ_SOURCE_LINE 00002085 ""
NSQ_SOURCE_LINE 00002086 "=back"
NSQ_SOURCE_LINE 00002087 ""
NSQ_SOURCE_LINE 00002088 "Here is a simple aggregate function which returns the variance"
NSQ_SOURCE_LINE 00002089 "(example adapted from pysqlite):"
NSQ_SOURCE_LINE 00002090 ""
NSQ_SOURCE_LINE 00002091 "  package variance;"
NSQ_SOURCE_LINE 00002092 "  "
NSQ_SOURCE_LINE 00002093 "  sub new { bless [], shift; }"
NSQ_SOURCE_LINE 00002094 "  "
NSQ_SOURCE_LINE 00002095 "  sub step {"
NSQ_SOURCE_LINE 00002096 "      my ( $self, $value ) = @_;"
NSQ_SOURCE_LINE 00002097 "  "
NSQ_SOURCE_LINE 00002098 "      push @$self, $value;"
NSQ_SOURCE_LINE 00002099 "  }"
NSQ_SOURCE_LINE 00002100 "  "
NSQ_SOURCE_LINE 00002101 "  sub finalize {"
NSQ_SOURCE_LINE 00002102 "      my $self = $_[0];"
NSQ_SOURCE_LINE 00002103 "  "
NSQ_SOURCE_LINE 00002104 "      my $n = @$self;"
NSQ_SOURCE_LINE 00002105 "  "
NSQ_SOURCE_LINE 00002106 "      # Variance is NULL unless there is more than one row"
NSQ_SOURCE_LINE 00002107 "      return undef unless $n || $n == 1;"
NSQ_SOURCE_LINE 00002108 "  "
NSQ_SOURCE_LINE 00002109 "      my $mu = 0;"
NSQ_SOURCE_LINE 00002110 "      foreach my $v ( @$self ) {"
NSQ_SOURCE_LINE 00002111 "          $mu += $v;"
NSQ_SOURCE_LINE 00002112 "      }"
NSQ_SOURCE_LINE 00002113 "      $mu /= $n;"
NSQ_SOURCE_LINE 00002114 "  "
NSQ_SOURCE_LINE 00002115 "      my $sigma = 0;"
NSQ_SOURCE_LINE 00002116 "      foreach my $v ( @$self ) {"
NSQ_SOURCE_LINE 00002117 "          $sigma += ($v - $mu)**2;"
NSQ_SOURCE_LINE 00002118 "      }"
NSQ_SOURCE_LINE 00002119 "      $sigma = $sigma / ($n - 1);"
NSQ_SOURCE_LINE 00002120 "  "
NSQ_SOURCE_LINE 00002121 "      return $sigma;"
NSQ_SOURCE_LINE 00002122 "  }"
NSQ_SOURCE_LINE 00002123 "  "
NSQ_SOURCE_LINE 00002124 "  $dbh->sqlite_create_aggregate( \"variance\", 1, 'variance' );"
NSQ_SOURCE_LINE 00002125 ""
NSQ_SOURCE_LINE 00002126 "The aggregate function can then be used as:"
NSQ_SOURCE_LINE 00002127 ""
NSQ_SOURCE_LINE 00002128 "  SELECT group_name, variance(score)"
NSQ_SOURCE_LINE 00002129 "  FROM results"
NSQ_SOURCE_LINE 00002130 "  GROUP BY group_name;"
NSQ_SOURCE_LINE 00002131 ""
NSQ_SOURCE_LINE 00002132 "For more examples, see the L<DBD::SQLite::Cookbook>."
NSQ_SOURCE_LINE 00002133 ""
NSQ_SOURCE_LINE 00002134 "=head2 $dbh->sqlite_progress_handler( $n_opcodes, $code_ref )"
NSQ_SOURCE_LINE 00002135 ""
NSQ_SOURCE_LINE 00002136 "This method registers a handler to be invoked periodically during long"
NSQ_SOURCE_LINE 00002137 "running calls to SQLite."
NSQ_SOURCE_LINE 00002138 ""
NSQ_SOURCE_LINE 00002139 "An example use for this interface is to keep a GUI updated during a"
NSQ_SOURCE_LINE 00002140 "large query. The parameters are:"
NSQ_SOURCE_LINE 00002141 ""
NSQ_SOURCE_LINE 00002142 "=over"
NSQ_SOURCE_LINE 00002143 ""
NSQ_SOURCE_LINE 00002144 "=item $n_opcodes"
NSQ_SOURCE_LINE 00002145 ""
NSQ_SOURCE_LINE 00002146 "The progress handler is invoked once for every C<$n_opcodes>"
NSQ_SOURCE_LINE 00002147 "virtual machine opcodes in SQLite."
NSQ_SOURCE_LINE 00002148 ""
NSQ_SOURCE_LINE 00002149 "=item $code_ref"
NSQ_SOURCE_LINE 00002150 ""
NSQ_SOURCE_LINE 00002151 "Reference to the handler subroutine.  If the progress handler returns"
NSQ_SOURCE_LINE 00002152 "non-zero, the SQLite operation is interrupted. This feature can be used to"
NSQ_SOURCE_LINE 00002153 "implement a \"Cancel\" button on a GUI dialog box."
NSQ_SOURCE_LINE 00002154 ""
NSQ_SOURCE_LINE 00002155 "Set this argument to C<undef> if you want to unregister a previous"
NSQ_SOURCE_LINE 00002156 "progress handler."
NSQ_SOURCE_LINE 00002157 ""
NSQ_SOURCE_LINE 00002158 "=back"
NSQ_SOURCE_LINE 00002159 ""
NSQ_SOURCE_LINE 00002160 "=head2 $dbh->sqlite_commit_hook( $code_ref )"
NSQ_SOURCE_LINE 00002161 ""
NSQ_SOURCE_LINE 00002162 "This method registers a callback function to be invoked whenever a"
NSQ_SOURCE_LINE 00002163 "transaction is committed. Any callback set by a previous call to"
NSQ_SOURCE_LINE 00002164 "C<sqlite_commit_hook> is overridden. A reference to the previous"
NSQ_SOURCE_LINE 00002165 "callback (if any) is returned.  Registering an C<undef> disables the"
NSQ_SOURCE_LINE 00002166 "callback."
NSQ_SOURCE_LINE 00002167 ""
NSQ_SOURCE_LINE 00002168 "When the commit hook callback returns zero, the commit operation is"
NSQ_SOURCE_LINE 00002169 "allowed to continue normally. If the callback returns non-zero, then"
NSQ_SOURCE_LINE 00002170 "the commit is converted into a rollback (in that case, any attempt to"
NSQ_SOURCE_LINE 00002171 "I<explicitly> call C<< $dbh->rollback() >> afterwards would yield an"
NSQ_SOURCE_LINE 00002172 "error)."
NSQ_SOURCE_LINE 00002173 ""
NSQ_SOURCE_LINE 00002174 "=head2 $dbh->sqlite_rollback_hook( $code_ref )"
NSQ_SOURCE_LINE 00002175 ""
NSQ_SOURCE_LINE 00002176 "This method registers a callback function to be invoked whenever a"
NSQ_SOURCE_LINE 00002177 "transaction is rolled back. Any callback set by a previous call to"
NSQ_SOURCE_LINE 00002178 "C<sqlite_rollback_hook> is overridden. A reference to the previous"
NSQ_SOURCE_LINE 00002179 "callback (if any) is returned.  Registering an C<undef> disables the"
NSQ_SOURCE_LINE 00002180 "callback."
NSQ_SOURCE_LINE 00002181 ""
NSQ_SOURCE_LINE 00002182 "=head2 $dbh->sqlite_update_hook( $code_ref )"
NSQ_SOURCE_LINE 00002183 ""
NSQ_SOURCE_LINE 00002184 "This method registers a callback function to be invoked whenever a row"
NSQ_SOURCE_LINE 00002185 "is updated, inserted or deleted. Any callback set by a previous call to"
NSQ_SOURCE_LINE 00002186 "C<sqlite_update_hook> is overridden. A reference to the previous"
NSQ_SOURCE_LINE 00002187 "callback (if any) is returned.  Registering an C<undef> disables the"
NSQ_SOURCE_LINE 00002188 "callback."
NSQ_SOURCE_LINE 00002189 ""
NSQ_SOURCE_LINE 00002190 "The callback will be called as"
NSQ_SOURCE_LINE 00002191 ""
NSQ_SOURCE_LINE 00002192 "  $code_ref->($action_code, $database, $table, $rowid)"
NSQ_SOURCE_LINE 00002193 ""
NSQ_SOURCE_LINE 00002194 "where"
NSQ_SOURCE_LINE 00002195 ""
NSQ_SOURCE_LINE 00002196 "=over"
NSQ_SOURCE_LINE 00002197 ""
NSQ_SOURCE_LINE 00002198 "=item $action_code"
NSQ_SOURCE_LINE 00002199 ""
NSQ_SOURCE_LINE 00002200 "is an integer equal to either C<DBD::SQLite::INSERT>,"
NSQ_SOURCE_LINE 00002201 "C<DBD::SQLite::DELETE> or C<DBD::SQLite::UPDATE>"
NSQ_SOURCE_LINE 00002202 "(see L</\"Action Codes\">);"
NSQ_SOURCE_LINE 00002203 ""
NSQ_SOURCE_LINE 00002204 "=item $database"
NSQ_SOURCE_LINE 00002205 ""
NSQ_SOURCE_LINE 00002206 "is the name of the database containing the affected row;"
NSQ_SOURCE_LINE 00002207 ""
NSQ_SOURCE_LINE 00002208 "=item $table"
NSQ_SOURCE_LINE 00002209 ""
NSQ_SOURCE_LINE 00002210 "is the name of the table containing the affected row;"
NSQ_SOURCE_LINE 00002211 ""
NSQ_SOURCE_LINE 00002212 "=item $rowid"
NSQ_SOURCE_LINE 00002213 ""
NSQ_SOURCE_LINE 00002214 "is the unique 64-bit signed integer key of the affected row within"
NSQ_SOURCE_LINE 00002215 "that table."
NSQ_SOURCE_LINE 00002216 ""
NSQ_SOURCE_LINE 00002217 "=back"
NSQ_SOURCE_LINE 00002218 ""
NSQ_SOURCE_LINE 00002219 "=head2 $dbh->sqlite_set_authorizer( $code_ref )"
NSQ_SOURCE_LINE 00002220 ""
NSQ_SOURCE_LINE 00002221 "This method registers an authorizer callback to be invoked whenever"
NSQ_SOURCE_LINE 00002222 "SQL statements are being compiled by the L<DBI/prepare> method.  The"
NSQ_SOURCE_LINE 00002223 "authorizer callback should return C<DBD::SQLite::OK> to allow the"
NSQ_SOURCE_LINE 00002224 "action, C<DBD::SQLite::IGNORE> to disallow the specific action but"
NSQ_SOURCE_LINE 00002225 "allow the SQL statement to continue to be compiled, or"
NSQ_SOURCE_LINE 00002226 "C<DBD::SQLite::DENY> to cause the entire SQL statement to be rejected"
NSQ_SOURCE_LINE 00002227 "with an error. If the authorizer callback returns any other value,"
NSQ_SOURCE_LINE 00002228 "then C<prepare> call that triggered the authorizer will fail with"
NSQ_SOURCE_LINE 00002229 "an error message."
NSQ_SOURCE_LINE 00002230 ""
NSQ_SOURCE_LINE 00002231 "An authorizer is used when preparing SQL statements from an untrusted"
NSQ_SOURCE_LINE 00002232 "source, to ensure that the SQL statements do not try to access data"
NSQ_SOURCE_LINE 00002233 "they are not allowed to see, or that they do not try to execute"
NSQ_SOURCE_LINE 00002234 "malicious statements that damage the database. For example, an"
NSQ_SOURCE_LINE 00002235 "application may allow a user to enter arbitrary SQL queries for"
NSQ_SOURCE_LINE 00002236 "evaluation by a database. But the application does not want the user"
NSQ_SOURCE_LINE 00002237 "to be able to make arbitrary changes to the database. An authorizer"
NSQ_SOURCE_LINE 00002238 "could then be put in place while the user-entered SQL is being"
NSQ_SOURCE_LINE 00002239 "prepared that disallows everything except SELECT statements."
NSQ_SOURCE_LINE 00002240 ""
NSQ_SOURCE_LINE 00002241 "The callback will be called as"
NSQ_SOURCE_LINE 00002242 ""
NSQ_SOURCE_LINE 00002243 "  $code_ref->($action_code, $string1, $string2, $database, $trigger_or_view)"
NSQ_SOURCE_LINE 00002244 ""
NSQ_SOURCE_LINE 00002245 "where"
NSQ_SOURCE_LINE 00002246 ""
NSQ_SOURCE_LINE 00002247 "=over"
NSQ_SOURCE_LINE 00002248 ""
NSQ_SOURCE_LINE 00002249 "=item $action_code"
NSQ_SOURCE_LINE 00002250 ""
NSQ_SOURCE_LINE 00002251 "is an integer that specifies what action is being authorized"
NSQ_SOURCE_LINE 00002252 "(see L</\"Action Codes\">)."
NSQ_SOURCE_LINE 00002253 ""
NSQ_SOURCE_LINE 00002254 "=item $string1, $string2"
NSQ_SOURCE_LINE 00002255 ""
NSQ_SOURCE_LINE 00002256 "are strings that depend on the action code"
NSQ_SOURCE_LINE 00002257 "(see L</\"Action Codes\">)."
NSQ_SOURCE_LINE 00002258 ""
NSQ_SOURCE_LINE 00002259 "=item $database"
NSQ_SOURCE_LINE 00002260 ""
NSQ_SOURCE_LINE 00002261 "is the name of the database (C<main>, C<temp>, etc.) if applicable."
NSQ_SOURCE_LINE 00002262 ""
NSQ_SOURCE_LINE 00002263 "=item $trigger_or_view"
NSQ_SOURCE_LINE 00002264 ""
NSQ_SOURCE_LINE 00002265 "is the name of the inner-most trigger or view that is responsible for"
NSQ_SOURCE_LINE 00002266 "the access attempt, or C<undef> if this access attempt is directly from"
NSQ_SOURCE_LINE 00002267 "top-level SQL code."
NSQ_SOURCE_LINE 00002268 ""
NSQ_SOURCE_LINE 00002269 "=back"
NSQ_SOURCE_LINE 00002270 ""
NSQ_SOURCE_LINE 00002271 "=head2 $dbh->sqlite_backup_from_file( $filename )"
NSQ_SOURCE_LINE 00002272 ""
NSQ_SOURCE_LINE 00002273 "This method accesses the SQLite Online Backup API, and will take a backup of"
NSQ_SOURCE_LINE 00002274 "the named database file, copying it to, and overwriting, your current database"
NSQ_SOURCE_LINE 00002275 "connection. This can be particularly handy if your current connection is to the"
NSQ_SOURCE_LINE 00002276 "special :memory: database, and you wish to populate it from an existing DB."
NSQ_SOURCE_LINE 00002277 ""
NSQ_SOURCE_LINE 00002278 "=head2 $dbh->sqlite_backup_to_file( $filename )"
NSQ_SOURCE_LINE 00002279 ""
NSQ_SOURCE_LINE 00002280 "This method accesses the SQLite Online Backup API, and will take a backup of"
NSQ_SOURCE_LINE 00002281 "the currently connected database, and write it out to the named file."
NSQ_SOURCE_LINE 00002282 ""
NSQ_SOURCE_LINE 00002283 "=head2 $dbh->sqlite_backup_from_dbh( $another_dbh )"
NSQ_SOURCE_LINE 00002284 ""
NSQ_SOURCE_LINE 00002285 "This method accesses the SQLite Online Backup API, and will take a backup of"
NSQ_SOURCE_LINE 00002286 "the database for the passed handle, copying it to, and overwriting, your current database"
NSQ_SOURCE_LINE 00002287 "connection. This can be particularly handy if your current connection is to the"
NSQ_SOURCE_LINE 00002288 "special :memory: database, and you wish to populate it from an existing DB."
NSQ_SOURCE_LINE 00002289 "You can use this to backup from an in-memory database to another in-memory database."
NSQ_SOURCE_LINE 00002290 ""
NSQ_SOURCE_LINE 00002291 "=head2 $dbh->sqlite_backup_to_dbh( $another_dbh )"
NSQ_SOURCE_LINE 00002292 ""
NSQ_SOURCE_LINE 00002293 "This method accesses the SQLite Online Backup API, and will take a backup of"
NSQ_SOURCE_LINE 00002294 "the currently connected database, and write it out to the passed database handle."
NSQ_SOURCE_LINE 00002295 ""
NSQ_SOURCE_LINE 00002296 "=head2 $dbh->sqlite_enable_load_extension( $bool )"
NSQ_SOURCE_LINE 00002297 ""
NSQ_SOURCE_LINE 00002298 "Calling this method with a true value enables loading (external)"
NSQ_SOURCE_LINE 00002299 "SQLite3 extensions. After the call, you can load extensions like this:"
NSQ_SOURCE_LINE 00002300 ""
NSQ_SOURCE_LINE 00002301 "  $dbh->sqlite_enable_load_extension(1);"
NSQ_SOURCE_LINE 00002302 "  $sth = $dbh->prepare(\"select load_extension('libmemvfs.so')\")"
NSQ_SOURCE_LINE 00002303 "  or die \"Cannot prepare: \" . $dbh->errstr();"
NSQ_SOURCE_LINE 00002304 ""
NSQ_SOURCE_LINE 00002305 "=head2 $dbh->sqlite_load_extension( $file, $proc )"
NSQ_SOURCE_LINE 00002306 ""
NSQ_SOURCE_LINE 00002307 "Loading an extension by a select statement (with the \"load_extension\" SQLite3 function like above) has some limitations. If the extension you want to use creates other functions that are not native to SQLite, use this method instead. $file (a path to the extension) is mandatory, and $proc (an entry point name) is optional. You need to call C<sqlite_enable_load_extension> before calling C<sqlite_load_extension>:"
NSQ_SOURCE_LINE 00002308 ""
NSQ_SOURCE_LINE 00002309 "  $dbh->sqlite_enable_load_extension(1);"
NSQ_SOURCE_LINE 00002310 "  $dbh->sqlite_load_extension('libsqlitefunctions.so')"
NSQ_SOURCE_LINE 00002311 "  or die \"Cannot load extension: \" . $dbh->errstr();"
NSQ_SOURCE_LINE 00002312 ""
NSQ_SOURCE_LINE 00002313 "If the extension uses SQLite mutex functions like C<sqlite3_mutex_enter>, then"
NSQ_SOURCE_LINE 00002314 "the extension should be compiled with the same C<SQLITE_THREADSAFE> compile-time"
NSQ_SOURCE_LINE 00002315 "setting as this module, see C<DBD::SQLite::compile_options()>."
NSQ_SOURCE_LINE 00002316 ""
NSQ_SOURCE_LINE 00002317 "=head2 $dbh->sqlite_trace( $code_ref )"
NSQ_SOURCE_LINE 00002318 ""
NSQ_SOURCE_LINE 00002319 "This method registers a trace callback to be invoked whenever"
NSQ_SOURCE_LINE 00002320 "SQL statements are being run."
NSQ_SOURCE_LINE 00002321 ""
NSQ_SOURCE_LINE 00002322 "The callback will be called as"
NSQ_SOURCE_LINE 00002323 ""
NSQ_SOURCE_LINE 00002324 "  $code_ref->($statement)"
NSQ_SOURCE_LINE 00002325 ""
NSQ_SOURCE_LINE 00002326 "where"
NSQ_SOURCE_LINE 00002327 ""
NSQ_SOURCE_LINE 00002328 "=over"
NSQ_SOURCE_LINE 00002329 ""
NSQ_SOURCE_LINE 00002330 "=item $statement"
NSQ_SOURCE_LINE 00002331 ""
NSQ_SOURCE_LINE 00002332 "is a UTF-8 rendering of the SQL statement text as the statement"
NSQ_SOURCE_LINE 00002333 "first begins executing."
NSQ_SOURCE_LINE 00002334 ""
NSQ_SOURCE_LINE 00002335 "=back"
NSQ_SOURCE_LINE 00002336 ""
NSQ_SOURCE_LINE 00002337 "Additional callbacks might occur as each triggered subprogram is"
NSQ_SOURCE_LINE 00002338 "entered. The callbacks for triggers contain a UTF-8 SQL comment"
NSQ_SOURCE_LINE 00002339 "that identifies the trigger."
NSQ_SOURCE_LINE 00002340 ""
NSQ_SOURCE_LINE 00002341 "See also L<DBI/TRACING> for better tracing options."
NSQ_SOURCE_LINE 00002342 ""
NSQ_SOURCE_LINE 00002343 "=head2 $dbh->sqlite_profile( $code_ref )"
NSQ_SOURCE_LINE 00002344 ""
NSQ_SOURCE_LINE 00002345 "This method registers a profile callback to be invoked whenever"
NSQ_SOURCE_LINE 00002346 "a SQL statement finishes."
NSQ_SOURCE_LINE 00002347 ""
NSQ_SOURCE_LINE 00002348 "The callback will be called as"
NSQ_SOURCE_LINE 00002349 ""
NSQ_SOURCE_LINE 00002350 "  $code_ref->($statement, $elapsed_time)"
NSQ_SOURCE_LINE 00002351 ""
NSQ_SOURCE_LINE 00002352 "where"
NSQ_SOURCE_LINE 00002353 ""
NSQ_SOURCE_LINE 00002354 "=over"
NSQ_SOURCE_LINE 00002355 ""
NSQ_SOURCE_LINE 00002356 "=item $statement"
NSQ_SOURCE_LINE 00002357 ""
NSQ_SOURCE_LINE 00002358 "is the original statement text (without bind parameters)."
NSQ_SOURCE_LINE 00002359 ""
NSQ_SOURCE_LINE 00002360 "=item $elapsed_time"
NSQ_SOURCE_LINE 00002361 ""
NSQ_SOURCE_LINE 00002362 "is an estimate of wall-clock time of how long that statement took to run (in milliseconds)."
NSQ_SOURCE_LINE 00002363 ""
NSQ_SOURCE_LINE 00002364 "=back"
NSQ_SOURCE_LINE 00002365 ""
NSQ_SOURCE_LINE 00002366 "This method is considered experimental and is subject to change in future versions of SQLite."
NSQ_SOURCE_LINE 00002367 ""
NSQ_SOURCE_LINE 00002368 "See also L<DBI::Profile> for better profiling options."
NSQ_SOURCE_LINE 00002369 ""
NSQ_SOURCE_LINE 00002370 "=head2 $dbh->sqlite_table_column_metadata( $dbname, $tablename, $columnname )"
NSQ_SOURCE_LINE 00002371 ""
NSQ_SOURCE_LINE 00002372 "is for internal use only."
NSQ_SOURCE_LINE 00002373 ""
NSQ_SOURCE_LINE 00002374 "=head2 $dbh->sqlite_db_status()"
NSQ_SOURCE_LINE 00002375 ""
NSQ_SOURCE_LINE 00002376 "Returns a hash reference that holds a set of status information of database connection such as cache usage. See L<https://www.sqlite.org/c3ref/c_dbstatus_options.html> for details. You may also pass 0 as an argument to reset the status."
NSQ_SOURCE_LINE 00002377 ""
NSQ_SOURCE_LINE 00002378 "=head2 $sth->sqlite_st_status()"
NSQ_SOURCE_LINE 00002379 ""
NSQ_SOURCE_LINE 00002380 "Returns a hash reference that holds a set of status information of SQLite statement handle such as full table scan count. See L<https://www.sqlite.org/c3ref/c_stmtstatus_counter.html> for details. Statement status only holds the current value."
NSQ_SOURCE_LINE 00002381 ""
NSQ_SOURCE_LINE 00002382 "  my $status = $sth->sqlite_st_status();"
NSQ_SOURCE_LINE 00002383 "  my $cur = $status->{fullscan_step};"
NSQ_SOURCE_LINE 00002384 ""
NSQ_SOURCE_LINE 00002385 "You may also pass 0 as an argument to reset the status."
NSQ_SOURCE_LINE 00002386 ""
NSQ_SOURCE_LINE 00002387 "=head2 $dbh->sqlite_db_config( $id, $new_integer_value )"
NSQ_SOURCE_LINE 00002388 ""
NSQ_SOURCE_LINE 00002389 "You can change how the connected database should behave like this:"
NSQ_SOURCE_LINE 00002390 ""
NSQ_SOURCE_LINE 00002391 "  use DBD::SQLite::Constants qw/:database_connection_configuration_options/;"
NSQ_SOURCE_LINE 00002392 "  "
NSQ_SOURCE_LINE 00002393 "  my $dbh = DBI->connect('dbi:SQLite::memory:');"
NSQ_SOURCE_LINE 00002394 ""
NSQ_SOURCE_LINE 00002395 "  # This disables language features that allow ordinary SQL"
NSQ_SOURCE_LINE 00002396 "  # to deliberately corrupt the database file"
NSQ_SOURCE_LINE 00002397 "  $dbh->sqlite_db_config( SQLITE_DBCONFIG_DEFENSIVE, 1 );"
NSQ_SOURCE_LINE 00002398 "  "
NSQ_SOURCE_LINE 00002399 "  # This disables two-arg version of fts3_tokenizer."
NSQ_SOURCE_LINE 00002400 "  $dbh->sqlite_db_config( SQLITE_DBCONFIG_ENABLE_FTS3_TOKENIZER, 0 );"
NSQ_SOURCE_LINE 00002401 ""
NSQ_SOURCE_LINE 00002402 "C<sqlite_db_config> returns the new value after the call. If you just want to know the current value without changing anything, pass a negative integer value."
NSQ_SOURCE_LINE 00002403 ""
NSQ_SOURCE_LINE 00002404 "  my $current_value = $dbh->sqlite_db_config( SQLITE_DBCONFIG_DEFENSIVE, -1 );"
NSQ_SOURCE_LINE 00002405 ""
NSQ_SOURCE_LINE 00002406 "As of this writing, C<sqlite_db_config> only supports options that set an integer value. C<SQLITE_DBCONFIG_LOOKASIDE> and C<SQLITE_DBCONFIG_MAINDBNAME> are not supported. See also C<https://www.sqlite.org/capi3ref.html#sqlite3_db_config> for details."
NSQ_SOURCE_LINE 00002407 ""
NSQ_SOURCE_LINE 00002408 "=head2 $dbh->sqlite_create_module()"
NSQ_SOURCE_LINE 00002409 ""
NSQ_SOURCE_LINE 00002410 "Registers a name for a I<virtual table module>. Module names must be"
NSQ_SOURCE_LINE 00002411 "registered before creating a new virtual table using the module and"
NSQ_SOURCE_LINE 00002412 "before using a preexisting virtual table for the module."
NSQ_SOURCE_LINE 00002413 "Virtual tables are explained in L<DBD::SQLite::VirtualTable>."
NSQ_SOURCE_LINE 00002414 ""
NSQ_SOURCE_LINE 00002415 "=head2 $dbh->sqlite_limit( $category_id, $new_value )"
NSQ_SOURCE_LINE 00002416 ""
NSQ_SOURCE_LINE 00002417 "Sets a new run-time limit for the category, and returns the current limit."
NSQ_SOURCE_LINE 00002418 "If the new value is a negative number (or omitted), the limit is unchanged"
NSQ_SOURCE_LINE 00002419 "and just returns the current limit. Category ids (SQLITE_LIMIT_LENGTH,"
NSQ_SOURCE_LINE 00002420 "SQLITE_LIMIT_VARIABLE_NUMBER, etc) can be imported from DBD::SQLite::Constants. "
NSQ_SOURCE_LINE 00002421 ""
NSQ_SOURCE_LINE 00002422 "=head2 $dbh->sqlite_get_autocommit()"
NSQ_SOURCE_LINE 00002423 ""
NSQ_SOURCE_LINE 00002424 "Returns true if the internal SQLite connection is in an autocommit mode."
NSQ_SOURCE_LINE 00002425 "This does not always return the same value as C<< $dbh->{AutoCommit} >>."
NSQ_SOURCE_LINE 00002426 "This returns false if you explicitly issue a C<<BEGIN>> statement."
NSQ_SOURCE_LINE 00002427 ""
NSQ_SOURCE_LINE 00002428 "=head2 $dbh->sqlite_txn_state()"
NSQ_SOURCE_LINE 00002429 ""
NSQ_SOURCE_LINE 00002430 "Returns the internal transaction status of SQLite (not of DBI)."
NSQ_SOURCE_LINE 00002431 "Return values (SQLITE_TXN_NONE, SQLITE_TXN_READ, SQLITE_TXN_WRITE)"
NSQ_SOURCE_LINE 00002432 "can be imported from DBD::SQLite::Constants. You may pass an optional"
NSQ_SOURCE_LINE 00002433 "schema name (usually \"main\"). If SQLite does not support this function,"
NSQ_SOURCE_LINE 00002434 "or if you pass a wrong schema name, -1 is returned."
NSQ_SOURCE_LINE 00002435 ""
NSQ_SOURCE_LINE 00002436 "=head2 $dbh->sqlite_error_offset()"
NSQ_SOURCE_LINE 00002437 ""
NSQ_SOURCE_LINE 00002438 "Returns the byte offset of the start of a problematic input SQL token"
NSQ_SOURCE_LINE 00002439 "or -1 if the most recent error does not reference a specific token in"
NSQ_SOURCE_LINE 00002440 "the input SQL (or DBD::SQLite is built with an older version of SQLite)."
NSQ_SOURCE_LINE 00002441 ""
NSQ_SOURCE_LINE 00002442 "=head1 DRIVER FUNCTIONS"
NSQ_SOURCE_LINE 00002443 ""
NSQ_SOURCE_LINE 00002444 "=head2 DBD::SQLite::compile_options()"
NSQ_SOURCE_LINE 00002445 ""
NSQ_SOURCE_LINE 00002446 "Returns an array of compile options (available since SQLite 3.6.23,"
NSQ_SOURCE_LINE 00002447 "bundled in DBD::SQLite 1.30_01), or an empty array if the bundled"
NSQ_SOURCE_LINE 00002448 "library is old or compiled with SQLITE_OMIT_COMPILEOPTION_DIAGS."
NSQ_SOURCE_LINE 00002449 ""
NSQ_SOURCE_LINE 00002450 "=head2 DBD::SQLite::sqlite_status()"
NSQ_SOURCE_LINE 00002451 ""
NSQ_SOURCE_LINE 00002452 "Returns a hash reference that holds a set of status information of SQLite runtime such as memory usage or page cache usage (see L<https://www.sqlite.org/c3ref/c_status_malloc_count.html> for details). Each of the entry contains the current value and the highwater value."
NSQ_SOURCE_LINE 00002453 ""
NSQ_SOURCE_LINE 00002454 "  my $status = DBD::SQLite::sqlite_status();"
NSQ_SOURCE_LINE 00002455 "  my $cur  = $status->{memory_used}{current};"
NSQ_SOURCE_LINE 00002456 "  my $high = $status->{memory_used}{highwater};"
NSQ_SOURCE_LINE 00002457 ""
NSQ_SOURCE_LINE 00002458 "You may also pass 0 as an argument to reset the status."
NSQ_SOURCE_LINE 00002459 ""
NSQ_SOURCE_LINE 00002460 "=head2 DBD::SQLite::strlike($pattern, $string, $escape_char), DBD::SQLite::strglob($pattern, $string)"
NSQ_SOURCE_LINE 00002461 ""
NSQ_SOURCE_LINE 00002462 "As of 1.49_05 (SQLite 3.10.0), you can use these two functions to"
NSQ_SOURCE_LINE 00002463 "see if a string matches a pattern. These may be useful when you"
NSQ_SOURCE_LINE 00002464 "create a virtual table or a custom function."
NSQ_SOURCE_LINE 00002465 "See L<http://sqlite.org/c3ref/strlike.html> and"
NSQ_SOURCE_LINE 00002466 "L<http://sqlite.org/c3ref/strglob.html> for details."
NSQ_SOURCE_LINE 00002467 ""
NSQ_SOURCE_LINE 00002468 "=head1 DRIVER CONSTANTS"
NSQ_SOURCE_LINE 00002469 ""
NSQ_SOURCE_LINE 00002470 "A subset of SQLite C constants are made available to Perl,"
NSQ_SOURCE_LINE 00002471 "because they may be needed when writing"
NSQ_SOURCE_LINE 00002472 "hooks or authorizer callbacks. For accessing such constants,"
NSQ_SOURCE_LINE 00002473 "the C<DBD::SQLite> module must be explicitly C<use>d at compile"
NSQ_SOURCE_LINE 00002474 "time. For example, an authorizer that forbids any"
NSQ_SOURCE_LINE 00002475 "DELETE operation would be written as follows :"
NSQ_SOURCE_LINE 00002476 ""
NSQ_SOURCE_LINE 00002477 "  use DBD::SQLite;"
NSQ_SOURCE_LINE 00002478 "  $dbh->sqlite_set_authorizer(sub {"
NSQ_SOURCE_LINE 00002479 "    my $action_code = shift;"
NSQ_SOURCE_LINE 00002480 "    return $action_code == DBD::SQLite::DELETE ? DBD::SQLite::DENY"
NSQ_SOURCE_LINE 00002481 "                                               : DBD::SQLite::OK;"
NSQ_SOURCE_LINE 00002482 "  });"
NSQ_SOURCE_LINE 00002483 ""
NSQ_SOURCE_LINE 00002484 "The list of constants implemented in C<DBD::SQLite> is given"
NSQ_SOURCE_LINE 00002485 "below; more information can be found ad"
NSQ_SOURCE_LINE 00002486 "at L<https://www.sqlite.org/c3ref/constlist.html>."
NSQ_SOURCE_LINE 00002487 ""
NSQ_SOURCE_LINE 00002488 "=head2 Authorizer Return Codes"
NSQ_SOURCE_LINE 00002489 ""
NSQ_SOURCE_LINE 00002490 "  OK"
NSQ_SOURCE_LINE 00002491 "  DENY"
NSQ_SOURCE_LINE 00002492 "  IGNORE"
NSQ_SOURCE_LINE 00002493 ""
NSQ_SOURCE_LINE 00002494 "=head2 Action Codes"
NSQ_SOURCE_LINE 00002495 ""
NSQ_SOURCE_LINE 00002496 "The L</set_authorizer> method registers a callback function that is"
NSQ_SOURCE_LINE 00002497 "invoked to authorize certain SQL statement actions. The first"
NSQ_SOURCE_LINE 00002498 "parameter to the callback is an integer code that specifies what"
NSQ_SOURCE_LINE 00002499 "action is being authorized. The second and third parameters to the"
NSQ_SOURCE_LINE 00002500 "callback are strings, the meaning of which varies according to the"
NSQ_SOURCE_LINE 00002501 "action code. Below is the list of action codes, together with their"
NSQ_SOURCE_LINE 00002502 "associated strings."
NSQ_SOURCE_LINE 00002503 ""
NSQ_SOURCE_LINE 00002504 "  # constant              string1         string2"
NSQ_SOURCE_LINE 00002505 "  # ========              =======         ======="
NSQ_SOURCE_LINE 00002506 "  CREATE_INDEX            Index Name      Table Name"
NSQ_SOURCE_LINE 00002507 "  CREATE_TABLE            Table Name      undef"
NSQ_SOURCE_LINE 00002508 "  CREATE_TEMP_INDEX       Index Name      Table Name"
NSQ_SOURCE_LINE 00002509 "  CREATE_TEMP_TABLE       Table Name      undef"
NSQ_SOURCE_LINE 00002510 "  CREATE_TEMP_TRIGGER     Trigger Name    Table Name"
NSQ_SOURCE_LINE 00002511 "  CREATE_TEMP_VIEW        View Name       undef"
NSQ_SOURCE_LINE 00002512 "  CREATE_TRIGGER          Trigger Name    Table Name"
NSQ_SOURCE_LINE 00002513 "  CREATE_VIEW             View Name       undef"
NSQ_SOURCE_LINE 00002514 "  DELETE                  Table Name      undef"
NSQ_SOURCE_LINE 00002515 "  DROP_INDEX              Index Name      Table Name"
NSQ_SOURCE_LINE 00002516 "  DROP_TABLE              Table Name      undef"
NSQ_SOURCE_LINE 00002517 "  DROP_TEMP_INDEX         Index Name      Table Name"
NSQ_SOURCE_LINE 00002518 "  DROP_TEMP_TABLE         Table Name      undef"
NSQ_SOURCE_LINE 00002519 "  DROP_TEMP_TRIGGER       Trigger Name    Table Name"
NSQ_SOURCE_LINE 00002520 "  DROP_TEMP_VIEW          View Name       undef"
NSQ_SOURCE_LINE 00002521 "  DROP_TRIGGER            Trigger Name    Table Name"
NSQ_SOURCE_LINE 00002522 "  DROP_VIEW               View Name       undef"
NSQ_SOURCE_LINE 00002523 "  INSERT                  Table Name      undef"
NSQ_SOURCE_LINE 00002524 "  PRAGMA                  Pragma Name     1st arg or undef"
NSQ_SOURCE_LINE 00002525 "  READ                    Table Name      Column Name"
NSQ_SOURCE_LINE 00002526 "  SELECT                  undef           undef"
NSQ_SOURCE_LINE 00002527 "  TRANSACTION             Operation       undef"
NSQ_SOURCE_LINE 00002528 "  UPDATE                  Table Name      Column Name"
NSQ_SOURCE_LINE 00002529 "  ATTACH                  Filename        undef"
NSQ_SOURCE_LINE 00002530 "  DETACH                  Database Name   undef"
NSQ_SOURCE_LINE 00002531 "  ALTER_TABLE             Database Name   Table Name"
NSQ_SOURCE_LINE 00002532 "  REINDEX                 Index Name      undef"
NSQ_SOURCE_LINE 00002533 "  ANALYZE                 Table Name      undef"
NSQ_SOURCE_LINE 00002534 "  CREATE_VTABLE           Table Name      Module Name"
NSQ_SOURCE_LINE 00002535 "  DROP_VTABLE             Table Name      Module Name"
NSQ_SOURCE_LINE 00002536 "  FUNCTION                undef           Function Name"
NSQ_SOURCE_LINE 00002537 "  SAVEPOINT               Operation       Savepoint Name"
NSQ_SOURCE_LINE 00002538 ""
NSQ_SOURCE_LINE 00002539 "=head1 COLLATION FUNCTIONS"
NSQ_SOURCE_LINE 00002540 ""
NSQ_SOURCE_LINE 00002541 "=head2 Definition"
NSQ_SOURCE_LINE 00002542 ""
NSQ_SOURCE_LINE 00002543 "SQLite v3 provides the ability for users to supply arbitrary"
NSQ_SOURCE_LINE 00002544 "comparison functions, known as user-defined \"collation sequences\" or"
NSQ_SOURCE_LINE 00002545 "\"collating functions\", to be used for comparing two text values."
NSQ_SOURCE_LINE 00002546 "L<https://www.sqlite.org/datatype3.html#collation>"
NSQ_SOURCE_LINE 00002547 "explains how collations are used in various SQL expressions."
NSQ_SOURCE_LINE 00002548 ""
NSQ_SOURCE_LINE 00002549 "=head2 Builtin collation sequences"
NSQ_SOURCE_LINE 00002550 ""
NSQ_SOURCE_LINE 00002551 "The following collation sequences are builtin within SQLite :"
NSQ_SOURCE_LINE 00002552 ""
NSQ_SOURCE_LINE 00002553 "=over"
NSQ_SOURCE_LINE 00002554 ""
NSQ_SOURCE_LINE 00002555 "=item B<BINARY>"
NSQ_SOURCE_LINE 00002556 ""
NSQ_SOURCE_LINE 00002557 "Compares string data using memcmp(), regardless of text encoding."
NSQ_SOURCE_LINE 00002558 ""
NSQ_SOURCE_LINE 00002559 "=item B<NOCASE>"
NSQ_SOURCE_LINE 00002560 ""
NSQ_SOURCE_LINE 00002561 "The same as binary, except the 26 upper case characters of ASCII are"
NSQ_SOURCE_LINE 00002562 "folded to their lower case equivalents before the comparison is"
NSQ_SOURCE_LINE 00002563 "performed. Note that only ASCII characters are case folded. SQLite"
NSQ_SOURCE_LINE 00002564 "does not attempt to do full UTF case folding due to the size of the"
NSQ_SOURCE_LINE 00002565 "tables required."
NSQ_SOURCE_LINE 00002566 ""
NSQ_SOURCE_LINE 00002567 "=item B<RTRIM>"
NSQ_SOURCE_LINE 00002568 ""
NSQ_SOURCE_LINE 00002569 "The same as binary, except that trailing space characters are ignored."
NSQ_SOURCE_LINE 00002570 ""
NSQ_SOURCE_LINE 00002571 "=back"
NSQ_SOURCE_LINE 00002572 ""
NSQ_SOURCE_LINE 00002573 "In addition, C<DBD::SQLite> automatically installs the"
NSQ_SOURCE_LINE 00002574 "following collation sequences :"
NSQ_SOURCE_LINE 00002575 ""
NSQ_SOURCE_LINE 00002576 "=over"
NSQ_SOURCE_LINE 00002577 ""
NSQ_SOURCE_LINE 00002578 "=item B<perl>"
NSQ_SOURCE_LINE 00002579 ""
NSQ_SOURCE_LINE 00002580 "corresponds to the Perl C<cmp> operator"
NSQ_SOURCE_LINE 00002581 ""
NSQ_SOURCE_LINE 00002582 "=item B<perllocale>"
NSQ_SOURCE_LINE 00002583 ""
NSQ_SOURCE_LINE 00002584 "Perl C<cmp> operator, in a context where C<use locale> is activated."
NSQ_SOURCE_LINE 00002585 ""
NSQ_SOURCE_LINE 00002586 "=back"
NSQ_SOURCE_LINE 00002587 ""
NSQ_SOURCE_LINE 00002588 "=head2 Usage"
NSQ_SOURCE_LINE 00002589 ""
NSQ_SOURCE_LINE 00002590 "You can write for example"
NSQ_SOURCE_LINE 00002591 ""
NSQ_SOURCE_LINE 00002592 "  CREATE TABLE foo("
NSQ_SOURCE_LINE 00002593 "      txt1 COLLATE perl,"
NSQ_SOURCE_LINE 00002594 "      txt2 COLLATE perllocale,"
NSQ_SOURCE_LINE 00002595 "      txt3 COLLATE nocase"
NSQ_SOURCE_LINE 00002596 "  )"
NSQ_SOURCE_LINE 00002597 ""
NSQ_SOURCE_LINE 00002598 "or"
NSQ_SOURCE_LINE 00002599 ""
NSQ_SOURCE_LINE 00002600 "  SELECT * FROM foo ORDER BY name COLLATE perllocale"
NSQ_SOURCE_LINE 00002601 ""
NSQ_SOURCE_LINE 00002602 "=head2 Unicode handling"
NSQ_SOURCE_LINE 00002603 ""
NSQ_SOURCE_LINE 00002604 "Depending on the C<< $dbh->{sqlite_string_mode} >> value, strings coming"
NSQ_SOURCE_LINE 00002605 "from the database and passed to the collation function may be decoded as"
NSQ_SOURCE_LINE 00002606 "UTF-8. This only works, though, if the C<sqlite_string_mode> attribute is"
NSQ_SOURCE_LINE 00002607 "set B<before> the first call to a perl collation sequence. The recommended"
NSQ_SOURCE_LINE 00002608 "way to activate unicode is to set C<sqlite_string_mode> at connection time:"
NSQ_SOURCE_LINE 00002609 ""
NSQ_SOURCE_LINE 00002610 "  my $dbh = DBI->connect("
NSQ_SOURCE_LINE 00002611 "      \"dbi:SQLite:dbname=foo\", \"\", \"\","
NSQ_SOURCE_LINE 00002612 "      {"
NSQ_SOURCE_LINE 00002613 "          RaiseError         => 1,"
NSQ_SOURCE_LINE 00002614 "          sqlite_string_mode => DBD_SQLITE_STRING_MODE_UNICODE_STRICT,"
NSQ_SOURCE_LINE 00002615 "      }"
NSQ_SOURCE_LINE 00002616 "  );"
NSQ_SOURCE_LINE 00002617 ""
NSQ_SOURCE_LINE 00002618 "=head2 Adding user-defined collations"
NSQ_SOURCE_LINE 00002619 ""
NSQ_SOURCE_LINE 00002620 "The native SQLite API for adding user-defined collations is"
NSQ_SOURCE_LINE 00002621 "exposed through methods L</\"sqlite_create_collation\"> and"
NSQ_SOURCE_LINE 00002622 "L</\"sqlite_collation_needed\">."
NSQ_SOURCE_LINE 00002623 ""
NSQ_SOURCE_LINE 00002624 "To avoid calling these functions every time a C<$dbh> handle is"
NSQ_SOURCE_LINE 00002625 "created, C<DBD::SQLite> offers a simpler interface through the"
NSQ_SOURCE_LINE 00002626 "C<%DBD::SQLite::COLLATION> hash : just insert your own"
NSQ_SOURCE_LINE 00002627 "collation functions in that hash, and whenever an unknown"
NSQ_SOURCE_LINE 00002628 "collation name is encountered in SQL, the appropriate collation"
NSQ_SOURCE_LINE 00002629 "function will be loaded on demand from the hash. For example,"
NSQ_SOURCE_LINE 00002630 "here is a way to sort text values regardless of their accented"
NSQ_SOURCE_LINE 00002631 "characters :"
NSQ_SOURCE_LINE 00002632 ""
NSQ_SOURCE_LINE 00002633 "  use DBD::SQLite;"
NSQ_SOURCE_LINE 00002634 "  $DBD::SQLite::COLLATION{no_accents} = sub {"
NSQ_SOURCE_LINE 00002635 "    my ( $a, $b ) = map lc, @_;"
NSQ_SOURCE_LINE 00002636 "    tr[àâáäåãçðèêéëìîíïñòôóöõøùûúüý]"
NSQ_SOURCE_LINE 00002637 "      [aaaaaacdeeeeiiiinoooooouuuuy] for $a, $b;"
NSQ_SOURCE_LINE 00002638 "    $a cmp $b;"
NSQ_SOURCE_LINE 00002639 "  };"
NSQ_SOURCE_LINE 00002640 "  my $dbh  = DBI->connect(\"dbi:SQLite:dbname=dbfile\");"
NSQ_SOURCE_LINE 00002641 "  my $sql  = \"SELECT ... FROM ... ORDER BY ... COLLATE no_accents\");"
NSQ_SOURCE_LINE 00002642 "  my $rows = $dbh->selectall_arrayref($sql);"
NSQ_SOURCE_LINE 00002643 ""
NSQ_SOURCE_LINE 00002644 "The builtin C<perl> or C<perllocale> collations are predefined"
NSQ_SOURCE_LINE 00002645 "in that same hash."
NSQ_SOURCE_LINE 00002646 ""
NSQ_SOURCE_LINE 00002647 "The COLLATION hash is a global registry within the current process;"
NSQ_SOURCE_LINE 00002648 "hence there is a risk of undesired side-effects. Therefore, to"
NSQ_SOURCE_LINE 00002649 "prevent action at distance, the hash is implemented as a \"write-only\""
NSQ_SOURCE_LINE 00002650 "hash, that will happily accept new entries, but will raise an"
NSQ_SOURCE_LINE 00002651 "exception if any attempt is made to override or delete a existing"
NSQ_SOURCE_LINE 00002652 "entry (including the builtin C<perl> and C<perllocale>)."
NSQ_SOURCE_LINE 00002653 ""
NSQ_SOURCE_LINE 00002654 "If you really, really need to change or delete an entry, you can"
NSQ_SOURCE_LINE 00002655 "always grab the tied object underneath C<%DBD::SQLite::COLLATION> ---"
NSQ_SOURCE_LINE 00002656 "but don't do that unless you really know what you are doing. Also"
NSQ_SOURCE_LINE 00002657 "observe that changes in the global hash will not modify existing"
NSQ_SOURCE_LINE 00002658 "collations in existing database handles: it will only affect new"
NSQ_SOURCE_LINE 00002659 "I<requests> for collations. In other words, if you want to change"
NSQ_SOURCE_LINE 00002660 "the behaviour of a collation within an existing C<$dbh>, you"
NSQ_SOURCE_LINE 00002661 "need to call the L</create_collation> method directly."
NSQ_SOURCE_LINE 00002662 ""
NSQ_SOURCE_LINE 00002663 "=head1 FULLTEXT SEARCH"
NSQ_SOURCE_LINE 00002664 ""
NSQ_SOURCE_LINE 00002665 "SQLite is bundled with an extension module for full-text"
NSQ_SOURCE_LINE 00002666 "indexing. Tables with this feature enabled can be efficiently queried"
NSQ_SOURCE_LINE 00002667 "to find rows that contain one or more instances of some specified"
NSQ_SOURCE_LINE 00002668 "words, in any column, even if the table contains many large documents."
NSQ_SOURCE_LINE 00002669 ""
NSQ_SOURCE_LINE 00002670 "Explanations for using this feature are provided in a separate document:"
NSQ_SOURCE_LINE 00002671 "see L<DBD::SQLite::Fulltext_search>."
NSQ_SOURCE_LINE 00002672 ""
NSQ_SOURCE_LINE 00002673 ""
NSQ_SOURCE_LINE 00002674 "=head1 R* TREE SUPPORT"
NSQ_SOURCE_LINE 00002675 ""
NSQ_SOURCE_LINE 00002676 "The RTREE extension module within SQLite adds support for creating"
NSQ_SOURCE_LINE 00002677 "a R-Tree, a special index for range and multidimensional queries.  This"
NSQ_SOURCE_LINE 00002678 "allows users to create tables that can be loaded with (as an example)"
NSQ_SOURCE_LINE 00002679 "geospatial data such as latitude/longitude coordinates for buildings within"
NSQ_SOURCE_LINE 00002680 "a city :"
NSQ_SOURCE_LINE 00002681 ""
NSQ_SOURCE_LINE 00002682 "  CREATE VIRTUAL TABLE city_buildings USING rtree("
NSQ_SOURCE_LINE 00002683 "     id,               -- Integer primary key"
NSQ_SOURCE_LINE 00002684 "     minLong, maxLong, -- Minimum and maximum longitude"
NSQ_SOURCE_LINE 00002685 "     minLat, maxLat    -- Minimum and maximum latitude"
NSQ_SOURCE_LINE 00002686 "  );"
NSQ_SOURCE_LINE 00002687 ""
NSQ_SOURCE_LINE 00002688 "then query which buildings overlap or are contained within a specified region:"
NSQ_SOURCE_LINE 00002689 ""
NSQ_SOURCE_LINE 00002690 "  # IDs that are contained within query coordinates"
NSQ_SOURCE_LINE 00002691 "  my $contained_sql = <<\"\";"
NSQ_SOURCE_LINE 00002692 "  SELECT id FROM city_buildings"
NSQ_SOURCE_LINE 00002693 "     WHERE  minLong >= ? AND maxLong <= ?"
NSQ_SOURCE_LINE 00002694 "     AND    minLat  >= ? AND maxLat  <= ?"
NSQ_SOURCE_LINE 00002695 "  "
NSQ_SOURCE_LINE 00002696 "  # ... and those that overlap query coordinates"
NSQ_SOURCE_LINE 00002697 "  my $overlap_sql = <<\"\";"
NSQ_SOURCE_LINE 00002698 "  SELECT id FROM city_buildings"
NSQ_SOURCE_LINE 00002699 "     WHERE    maxLong >= ? AND minLong <= ?"
NSQ_SOURCE_LINE 00002700 "     AND      maxLat  >= ? AND minLat  <= ?"
NSQ_SOURCE_LINE 00002701 "  "
NSQ_SOURCE_LINE 00002702 "  my $contained = $dbh->selectcol_arrayref($contained_sql,undef,"
NSQ_SOURCE_LINE 00002703 "                        $minLong, $maxLong, $minLat, $maxLat);"
NSQ_SOURCE_LINE 00002704 "  "
NSQ_SOURCE_LINE 00002705 "  my $overlapping = $dbh->selectcol_arrayref($overlap_sql,undef,"
NSQ_SOURCE_LINE 00002706 "                        $minLong, $maxLong, $minLat, $maxLat);  "
NSQ_SOURCE_LINE 00002707 ""
NSQ_SOURCE_LINE 00002708 "For more detail, please see the SQLite R-Tree page"
NSQ_SOURCE_LINE 00002709 "(L<https://www.sqlite.org/rtree.html>). Note that custom R-Tree"
NSQ_SOURCE_LINE 00002710 "queries using callbacks, as mentioned in the prior link, have not been"
NSQ_SOURCE_LINE 00002711 "implemented yet."
NSQ_SOURCE_LINE 00002712 ""
NSQ_SOURCE_LINE 00002713 "=head1 VIRTUAL TABLES IMPLEMENTED IN PERL"
NSQ_SOURCE_LINE 00002714 ""
NSQ_SOURCE_LINE 00002715 "SQLite has a concept of \"virtual tables\" which look like regular"
NSQ_SOURCE_LINE 00002716 "tables but are implemented internally through specific functions."
NSQ_SOURCE_LINE 00002717 "The fulltext or R* tree features described in the previous chapters"
NSQ_SOURCE_LINE 00002718 "are examples of such virtual tables, implemented in C code."
NSQ_SOURCE_LINE 00002719 ""
NSQ_SOURCE_LINE 00002720 "C<DBD::SQLite> also supports virtual tables implemented in I<Perl code>:"
NSQ_SOURCE_LINE 00002721 "see L<DBD::SQLite::VirtualTable> for using or implementing such"
NSQ_SOURCE_LINE 00002722 "virtual tables. These can have many interesting uses"
NSQ_SOURCE_LINE 00002723 "for joining regular DBMS data with some other kind of data within your"
NSQ_SOURCE_LINE 00002724 "Perl programs. Bundled with the present distribution are :"
NSQ_SOURCE_LINE 00002725 ""
NSQ_SOURCE_LINE 00002726 "=over "
NSQ_SOURCE_LINE 00002727 ""
NSQ_SOURCE_LINE 00002728 "=item *"
NSQ_SOURCE_LINE 00002729 ""
NSQ_SOURCE_LINE 00002730 "L<DBD::SQLite::VirtualTable::FileContent> : implements a virtual"
NSQ_SOURCE_LINE 00002731 "column that exposes file contents. This is especially useful"
NSQ_SOURCE_LINE 00002732 "in conjunction with a fulltext index; see L<DBD::SQLite::Fulltext_search>."
NSQ_SOURCE_LINE 00002733 ""
NSQ_SOURCE_LINE 00002734 "=item *"
NSQ_SOURCE_LINE 00002735 ""
NSQ_SOURCE_LINE 00002736 "L<DBD::SQLite::VirtualTable::PerlData> : binds to a Perl array"
NSQ_SOURCE_LINE 00002737 "within the Perl program. This can be used for simple import/export"
NSQ_SOURCE_LINE 00002738 "operations, for debugging purposes, for joining data from different"
NSQ_SOURCE_LINE 00002739 "sources, etc."
NSQ_SOURCE_LINE 00002740 ""
NSQ_SOURCE_LINE 00002741 "=back"
NSQ_SOURCE_LINE 00002742 ""
NSQ_SOURCE_LINE 00002743 "Other Perl virtual tables may also be published separately on CPAN."
NSQ_SOURCE_LINE 00002744 ""
NSQ_SOURCE_LINE 00002745 "=head1 FOR DBD::SQLITE EXTENSION AUTHORS"
NSQ_SOURCE_LINE 00002746 ""
NSQ_SOURCE_LINE 00002747 "Since 1.30_01, you can retrieve the bundled SQLite C source and/or"
NSQ_SOURCE_LINE 00002748 "header like this:"
NSQ_SOURCE_LINE 00002749 ""
NSQ_SOURCE_LINE 00002750 "  use File::ShareDir 'dist_dir';"
NSQ_SOURCE_LINE 00002751 "  use File::Spec::Functions 'catfile';"
NSQ_SOURCE_LINE 00002752 "  "
NSQ_SOURCE_LINE 00002753 "  # the whole sqlite3.h header"
NSQ_SOURCE_LINE 00002754 "  my $sqlite3_h = catfile(dist_dir('DBD-SQLite'), 'sqlite3.h');"
NSQ_SOURCE_LINE 00002755 "  "
NSQ_SOURCE_LINE 00002756 "  # or only a particular header, amalgamated in sqlite3.c"
NSQ_SOURCE_LINE 00002757 "  my $what_i_want = 'parse.h';"
NSQ_SOURCE_LINE 00002758 "  my $sqlite3_c = catfile(dist_dir('DBD-SQLite'), 'sqlite3.c');"
NSQ_SOURCE_LINE 00002759 "  open my $fh, '<', $sqlite3_c or die $!;"
NSQ_SOURCE_LINE 00002760 "  my $code = do { local $/; <$fh> };"
NSQ_SOURCE_LINE 00002761 "  my ($parse_h) = $code =~ m{("
NSQ_SOURCE_LINE 00002762 "    /\\*+[ ]Begin[ ]file[ ]$what_i_want[ ]\\*+"
NSQ_SOURCE_LINE 00002763 "    .+?"
NSQ_SOURCE_LINE 00002764 "    /\\*+[ ]End[ ]of[ ]$what_i_want[ ]\\*+/"
NSQ_SOURCE_LINE 00002765 "  )}sx;"
NSQ_SOURCE_LINE 00002766 "  open my $out, '>', $what_i_want or die $!;"
NSQ_SOURCE_LINE 00002767 "  print $out $parse_h;"
NSQ_SOURCE_LINE 00002768 "  close $out;"
NSQ_SOURCE_LINE 00002769 ""
NSQ_SOURCE_LINE 00002770 "You usually want to use this in your extension's C<Makefile.PL>,"
NSQ_SOURCE_LINE 00002771 "and you may want to add DBD::SQLite to your extension's C<CONFIGURE_REQUIRES>"
NSQ_SOURCE_LINE 00002772 "to ensure your extension users use the same C source/header they use"
NSQ_SOURCE_LINE 00002773 "to build DBD::SQLite itself (instead of the ones installed in their"
NSQ_SOURCE_LINE 00002774 "system)."
NSQ_SOURCE_LINE 00002775 ""
NSQ_SOURCE_LINE 00002776 "=head1 TO DO"
NSQ_SOURCE_LINE 00002777 ""
NSQ_SOURCE_LINE 00002778 "The following items remain to be done."
NSQ_SOURCE_LINE 00002779 ""
NSQ_SOURCE_LINE 00002780 "=head2 Leak Detection"
NSQ_SOURCE_LINE 00002781 ""
NSQ_SOURCE_LINE 00002782 "Implement one or more leak detection tests that only run during"
NSQ_SOURCE_LINE 00002783 "AUTOMATED_TESTING and RELEASE_TESTING and validate that none of the C"
NSQ_SOURCE_LINE 00002784 "code we work with leaks."
NSQ_SOURCE_LINE 00002785 ""
NSQ_SOURCE_LINE 00002786 "=head2 Stream API for Blobs"
NSQ_SOURCE_LINE 00002787 ""
NSQ_SOURCE_LINE 00002788 "Reading/writing into blobs using C<sqlite2_blob_open> / C<sqlite2_blob_close>."
NSQ_SOURCE_LINE 00002789 ""
NSQ_SOURCE_LINE 00002790 "=head2 Support for custom callbacks for R-Tree queries"
NSQ_SOURCE_LINE 00002791 ""
NSQ_SOURCE_LINE 00002792 "Custom queries of a R-Tree index using a callback are possible with"
NSQ_SOURCE_LINE 00002793 "the SQLite C API (L<https://www.sqlite.org/rtree.html>), so one could"
NSQ_SOURCE_LINE 00002794 "potentially use a callback that narrowed the result set down based"
NSQ_SOURCE_LINE 00002795 "on a specific need, such as querying for overlapping circles."
NSQ_SOURCE_LINE 00002796 ""
NSQ_SOURCE_LINE 00002797 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00002798 ""
NSQ_SOURCE_LINE 00002799 "Bugs should be reported to GitHub issues:"
NSQ_SOURCE_LINE 00002800 ""
NSQ_SOURCE_LINE 00002801 "L<https://github.com/DBD-SQLite/DBD-SQLite/issues>"
NSQ_SOURCE_LINE 00002802 ""
NSQ_SOURCE_LINE 00002803 "or via RT if you prefer:"
NSQ_SOURCE_LINE 00002804 ""
NSQ_SOURCE_LINE 00002805 "L<http://rt.cpan.org/NoAuth/ReportBug.html?Queue=DBD-SQLite>"
NSQ_SOURCE_LINE 00002806 ""
NSQ_SOURCE_LINE 00002807 "Note that bugs of bundled SQLite library (i.e. bugs in C<sqlite3.[ch]>)"
NSQ_SOURCE_LINE 00002808 "should be reported to the SQLite developers at sqlite.org via their bug"
NSQ_SOURCE_LINE 00002809 "tracker or via their mailing list."
NSQ_SOURCE_LINE 00002810 ""
NSQ_SOURCE_LINE 00002811 "The master repository is on GitHub:"
NSQ_SOURCE_LINE 00002812 ""
NSQ_SOURCE_LINE 00002813 "L<https://github.com/DBD-SQLite/DBD-SQLite>."
NSQ_SOURCE_LINE 00002814 ""
NSQ_SOURCE_LINE 00002815 "We also have a mailing list:"
NSQ_SOURCE_LINE 00002816 ""
NSQ_SOURCE_LINE 00002817 "L<http://lists.scsys.co.uk/cgi-bin/mailman/listinfo/dbd-sqlite>"
NSQ_SOURCE_LINE 00002818 ""
