NSQ_SOURCE_LINE 00000001 "package DBD::SQLite;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use DBI   1.57 ();"
NSQ_SOURCE_LINE 00000006 "use XSLoader ();"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '1.78';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "# sqlite_version cache (set in the XS bootstrap)"
NSQ_SOURCE_LINE 00000011 "our ($sqlite_version, $sqlite_version_number);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "# not sure if we still need these..."
NSQ_SOURCE_LINE 00000014 "our ($err, $errstr);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "XSLoader::load('DBD::SQLite', $VERSION);"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "# New or old API?"
NSQ_SOURCE_LINE 00000019 "use constant NEWAPI => ($DBI::VERSION >= 1.608);"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "# global registry of collation functions, initialized with 2 builtins"
NSQ_SOURCE_LINE 00000022 "our %COLLATION;"
NSQ_SOURCE_LINE 00000023 "tie %COLLATION, 'DBD::SQLite::_WriteOnceHash';"
NSQ_SOURCE_LINE 00000024 "$COLLATION{perl}       = sub { $_[0] cmp $_[1] };"
NSQ_SOURCE_LINE 00000025 "$COLLATION{perllocale} = sub { use locale; $_[0] cmp $_[1] };"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "our $drh;"
NSQ_SOURCE_LINE 00000028 "my $methods_are_installed = 0;"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "sub driver {"
NSQ_SOURCE_LINE 00000031 "    return $drh if $drh;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    if (!$methods_are_installed && DBD::SQLite::NEWAPI ) {"
NSQ_SOURCE_LINE 00000034 "        DBI->setup_driver('DBD::SQLite');"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "        DBD::SQLite::db->install_method('sqlite_last_insert_rowid');"
NSQ_SOURCE_LINE 00000037 "        DBD::SQLite::db->install_method('sqlite_busy_timeout');"
NSQ_SOURCE_LINE 00000038 "        DBD::SQLite::db->install_method('sqlite_create_function');"
NSQ_SOURCE_LINE 00000039 "        DBD::SQLite::db->install_method('sqlite_create_aggregate');"
NSQ_SOURCE_LINE 00000040 "        DBD::SQLite::db->install_method('sqlite_create_collation');"
NSQ_SOURCE_LINE 00000041 "        DBD::SQLite::db->install_method('sqlite_collation_needed');"
NSQ_SOURCE_LINE 00000042 "        DBD::SQLite::db->install_method('sqlite_progress_handler');"
NSQ_SOURCE_LINE 00000043 "        DBD::SQLite::db->install_method('sqlite_commit_hook');"
NSQ_SOURCE_LINE 00000044 "        DBD::SQLite::db->install_method('sqlite_rollback_hook');"
NSQ_SOURCE_LINE 00000045 "        DBD::SQLite::db->install_method('sqlite_update_hook');"
NSQ_SOURCE_LINE 00000046 "        DBD::SQLite::db->install_method('sqlite_set_authorizer');"
NSQ_SOURCE_LINE 00000047 "        DBD::SQLite::db->install_method('sqlite_backup_from_file');"
NSQ_SOURCE_LINE 00000048 "        DBD::SQLite::db->install_method('sqlite_backup_to_file');"
NSQ_SOURCE_LINE 00000049 "        DBD::SQLite::db->install_method('sqlite_backup_from_dbh');"
NSQ_SOURCE_LINE 00000050 "        DBD::SQLite::db->install_method('sqlite_backup_to_dbh');"
NSQ_SOURCE_LINE 00000051 "        DBD::SQLite::db->install_method('sqlite_enable_load_extension');"
NSQ_SOURCE_LINE 00000052 "        DBD::SQLite::db->install_method('sqlite_load_extension');"
NSQ_SOURCE_LINE 00000053 "        DBD::SQLite::db->install_method('sqlite_register_fts3_perl_tokenizer');"
NSQ_SOURCE_LINE 00000054 "        DBD::SQLite::db->install_method('sqlite_trace', { O => 0x0004 });"
NSQ_SOURCE_LINE 00000055 "        DBD::SQLite::db->install_method('sqlite_profile', { O => 0x0004 });"
NSQ_SOURCE_LINE 00000056 "        DBD::SQLite::db->install_method('sqlite_table_column_metadata', { O => 0x0004 });"
NSQ_SOURCE_LINE 00000057 "        DBD::SQLite::db->install_method('sqlite_db_filename', { O => 0x0004 });"
NSQ_SOURCE_LINE 00000058 "        DBD::SQLite::db->install_method('sqlite_db_status', { O => 0x0004 });"
NSQ_SOURCE_LINE 00000059 "        DBD::SQLite::st->install_method('sqlite_st_status', { O => 0x0004 });"
NSQ_SOURCE_LINE 00000060 "        DBD::SQLite::db->install_method('sqlite_create_module');"
NSQ_SOURCE_LINE 00000061 "        DBD::SQLite::db->install_method('sqlite_limit');"
NSQ_SOURCE_LINE 00000062 "        DBD::SQLite::db->install_method('sqlite_db_config');"
NSQ_SOURCE_LINE 00000063 "        DBD::SQLite::db->install_method('sqlite_get_autocommit');"
NSQ_SOURCE_LINE 00000064 "        DBD::SQLite::db->install_method('sqlite_txn_state');"
NSQ_SOURCE_LINE 00000065 "        DBD::SQLite::db->install_method('sqlite_error_offset');"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "        $methods_are_installed++;"
NSQ_SOURCE_LINE 00000068 "    }"
