NSQ_SOURCE_LINE 00000070 "    $drh = DBI::_new_drh( \"$_[0]::dr\", {"
NSQ_SOURCE_LINE 00000071 "        Name        => 'SQLite',"
NSQ_SOURCE_LINE 00000072 "        Version     => $VERSION,"
NSQ_SOURCE_LINE 00000073 "        Attribution => 'DBD::SQLite by Matt Sergeant et al',"
NSQ_SOURCE_LINE 00000074 "    } );"
