NSQ_SOURCE_LINE 00000001 "package Module::CoreList::More;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2016-02-17'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.08'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Module::CoreList ();"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "sub _firstidx {"
NSQ_SOURCE_LINE 00000013 "    my ($item, $ary) = @_;"
NSQ_SOURCE_LINE 00000014 "    for (0..@$ary-1) {"
NSQ_SOURCE_LINE 00000015 "       return $_ if $ary->[$_] eq $item;"
NSQ_SOURCE_LINE 00000016 "    }"
NSQ_SOURCE_LINE 00000017 "    -1;"
NSQ_SOURCE_LINE 00000018 "}"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "# construct our own %delta from Module::CoreList's %delta. our version is a"
NSQ_SOURCE_LINE 00000021 "# linear \"linked list\" (e.g. %delta{5.017} is a delta against %delta{5.016003}"
NSQ_SOURCE_LINE 00000022 "# instead of %delta{5.016}. also, version numbers are cleaned (some versions in"
NSQ_SOURCE_LINE 00000023 "# Module::CoreList has trailing whitespaces or alphas)"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "# the same for our own %released (version numbers in keys are canonicalized)"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "our @releases; # list of perl release versions, sorted by version"
NSQ_SOURCE_LINE 00000028 "our @releases_by_date; # list of perl release versions, sorted by release date"
NSQ_SOURCE_LINE 00000029 "our %delta;"
NSQ_SOURCE_LINE 00000030 "our %released;"
NSQ_SOURCE_LINE 00000031 "my %rel_orig_formats;"
NSQ_SOURCE_LINE 00000032 "{"
NSQ_SOURCE_LINE 00000033 "    # first let's only stored the canonical format of release versions"
NSQ_SOURCE_LINE 00000034 "    # (Module::Core stores \"5.01\" as well as \"5.010000\"), for less headache"
NSQ_SOURCE_LINE 00000035 "    # let's just store \"5.010000\""
NSQ_SOURCE_LINE 00000036 "    my %releases;"
NSQ_SOURCE_LINE 00000037 "    for (sort keys %Module::CoreList::delta) {"
NSQ_SOURCE_LINE 00000038 "        my $canonical = sprintf \"%.6f\", $_;"
NSQ_SOURCE_LINE 00000039 "        next if $releases{$canonical};"
NSQ_SOURCE_LINE 00000040 "        $releases{$canonical} = $Module::CoreList::delta{$_};"
NSQ_SOURCE_LINE 00000041 "        $released{$canonical} = $Module::CoreList::released{$_};"
NSQ_SOURCE_LINE 00000042 "        $rel_orig_formats{$canonical} = $_;"
NSQ_SOURCE_LINE 00000043 "    }"
NSQ_SOURCE_LINE 00000044 "    @releases = sort keys %releases;"
NSQ_SOURCE_LINE 00000045 "    @releases_by_date = sort {$released{$a} cmp $released{$b}} keys %releases;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    for my $i (0..@releases-1) {"
NSQ_SOURCE_LINE 00000048 "        my $reldelta = $releases{$releases[$i]};"
NSQ_SOURCE_LINE 00000049 "        my $delta_from = $reldelta->{delta_from};"
NSQ_SOURCE_LINE 00000050 "        my $changed = {};"
NSQ_SOURCE_LINE 00000051 "        my $removed = {};"
NSQ_SOURCE_LINE 00000052 "        # make sure that %delta will be linear \"linked list\" by release versions"
NSQ_SOURCE_LINE 00000053 "        if ($delta_from && $delta_from != $releases[$i-1]) {"
NSQ_SOURCE_LINE 00000054 "            $delta_from = sprintf \"%.6f\", $delta_from;"
NSQ_SOURCE_LINE 00000055 "            my $i0 = _firstidx($delta_from, \\@releases);"
NSQ_SOURCE_LINE 00000056 "            #say \"D: delta_from jumps from $delta_from (#$i0) -> $releases[$i] (#$i)\";"
NSQ_SOURCE_LINE 00000057 "            # accumulate changes between delta at releases #($i0+1) and #($i-1),"
NSQ_SOURCE_LINE 00000058 "            # subtract them from delta at #($i)"
NSQ_SOURCE_LINE 00000059 "            my $changed_between = {};"
NSQ_SOURCE_LINE 00000060 "            my $removed_between = {};"
NSQ_SOURCE_LINE 00000061 "            for my $j ($i0+1 .. $i-1) {"
NSQ_SOURCE_LINE 00000062 "                my $reldelta_between = $releases{$releases[$j]};"
NSQ_SOURCE_LINE 00000063 "                for (keys %{$reldelta_between->{changed}}) {"
NSQ_SOURCE_LINE 00000064 "                    $changed_between->{$_} = $reldelta_between->{changed}{$_};"
NSQ_SOURCE_LINE 00000065 "                    delete $removed_between->{$_};"
NSQ_SOURCE_LINE 00000066 "                }"
NSQ_SOURCE_LINE 00000067 "                for (keys %{$reldelta_between->{removed}}) {"
NSQ_SOURCE_LINE 00000068 "                    $removed_between->{$_} = $reldelta_between->{removed}{$_};"
NSQ_SOURCE_LINE 00000069 "                }"
NSQ_SOURCE_LINE 00000070 "            }"
NSQ_SOURCE_LINE 00000071 "            for (keys %{$reldelta->{changed}}) {"
NSQ_SOURCE_LINE 00000072 "                next if exists($changed_between->{$_}) &&"
NSQ_SOURCE_LINE 00000073 "                    !defined($changed_between->{$_}) && !defined($reldelta->{changed}{$_}) || # both undef"
NSQ_SOURCE_LINE 00000074 "                    defined ($changed_between->{$_}) && defined ($reldelta->{changed}{$_}) && $changed_between->{$_} eq $reldelta->{changed}{$_}; # both defined & equal"
NSQ_SOURCE_LINE 00000075 "                $changed->{$_} = $reldelta->{changed}{$_};"
NSQ_SOURCE_LINE 00000076 "            }"
NSQ_SOURCE_LINE 00000077 "            for (keys %{$reldelta->{removed}}) {"
NSQ_SOURCE_LINE 00000078 "                next if $removed_between->{$_};"
NSQ_SOURCE_LINE 00000079 "                $removed->{$_} = $reldelta->{removed}{$_};"
NSQ_SOURCE_LINE 00000080 "            }"
NSQ_SOURCE_LINE 00000081 "        } else {"
NSQ_SOURCE_LINE 00000082 "            $changed = { %{$reldelta->{changed}} };"
NSQ_SOURCE_LINE 00000083 "            $removed = { %{$reldelta->{removed} // {}} };"
NSQ_SOURCE_LINE 00000084 "        }"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "        # clean version numbers"
NSQ_SOURCE_LINE 00000087 "        for my $k (keys %$changed) {"
NSQ_SOURCE_LINE 00000088 "            for ($changed->{$k}) {"
NSQ_SOURCE_LINE 00000089 "                next unless defined;"
NSQ_SOURCE_LINE 00000090 "                s/\\s+$//; # eliminate trailing space"
NSQ_SOURCE_LINE 00000091 "                # for \"alpha\" version, turn trailing junk such as letters to _"
NSQ_SOURCE_LINE 00000092 "                # plus a number based on the first junk char"
NSQ_SOURCE_LINE 00000093 "                s/([^.0-9_])[^.0-9_]*$/'_'.sprintf('%03d',ord $1)/e;"
NSQ_SOURCE_LINE 00000094 "            }"
NSQ_SOURCE_LINE 00000095 "        }"
NSQ_SOURCE_LINE 00000096 "        $delta{$releases[$i]} = {"
NSQ_SOURCE_LINE 00000097 "            changed => $changed,"
NSQ_SOURCE_LINE 00000098 "            removed => $removed,"
NSQ_SOURCE_LINE 00000099 "        };"
NSQ_SOURCE_LINE 00000100 "    }"
NSQ_SOURCE_LINE 00000101 "}"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "my $removed_from = sub {"
NSQ_SOURCE_LINE 00000104 "    my ($order, $module) = splice @_,0,2;"
NSQ_SOURCE_LINE 00000105 "    $module = shift if eval { $module->isa(__PACKAGE__) } && @_ > 0 && defined($_[0]) && $_[0] =~ /^\\w/;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    for my $rel ($order eq 'date' ? @releases_by_date : @releases) {"
NSQ_SOURCE_LINE 00000108 "        return $rel_orig_formats{$rel} if $delta{$rel}{removed}{$module};"
NSQ_SOURCE_LINE 00000109 "    }"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    return;"
NSQ_SOURCE_LINE 00000112 "};"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "sub removed_from {"
NSQ_SOURCE_LINE 00000115 "    $removed_from->('', @_);"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "sub removed_from_by_date {"
NSQ_SOURCE_LINE 00000119 "    $removed_from->('date', @_);"
NSQ_SOURCE_LINE 00000120 "}"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "my $first_release = sub {"
NSQ_SOURCE_LINE 00000123 "    my ($order, $module) = splice @_,0,2;"
NSQ_SOURCE_LINE 00000124 "    $module = shift if eval { $module->isa(__PACKAGE__) } && @_ > 0 && defined($_[0]) && $_[0] =~ /^\\w/;"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "    for my $rel ($order eq 'date' ? @releases_by_date : @releases) {"
NSQ_SOURCE_LINE 00000127 "        return $rel_orig_formats{$rel} if exists $delta{$rel}{changed}{$module};"
NSQ_SOURCE_LINE 00000128 "    }"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    return;"
NSQ_SOURCE_LINE 00000131 "};"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "sub first_release {"
NSQ_SOURCE_LINE 00000134 "    $first_release->('', @_);"
NSQ_SOURCE_LINE 00000135 "}"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "sub first_release_by_date {"
NSQ_SOURCE_LINE 00000138 "    $first_release->('date', @_);"
NSQ_SOURCE_LINE 00000139 "}"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "my $is_core = sub {"
NSQ_SOURCE_LINE 00000142 "    my $all = pop;"
NSQ_SOURCE_LINE 00000143 "    my $module = shift;"
NSQ_SOURCE_LINE 00000144 "    $module = shift if eval { $module->isa(__PACKAGE__) } && @_ > 0 && defined($_[0]) && $_[0] =~ /^\\w/;"
NSQ_SOURCE_LINE 00000145 "    my ($module_version, $perl_version);"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    $module_version = shift if @_ > 0;"
NSQ_SOURCE_LINE 00000148 "    $perl_version   = @_ > 0 ? shift : $];"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "    my $mod_exists = 0;"
NSQ_SOURCE_LINE 00000151 "    my $mod_ver; # module version at each perl release, -1 means doesn't exist"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "  RELEASE:"
NSQ_SOURCE_LINE 00000154 "    for my $rel (sort keys %delta) {"
NSQ_SOURCE_LINE 00000155 "        last if $all && $rel > $perl_version; # this is the difference with is_still_core()"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "        my $reldelta = $delta{$rel};"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "        if ($rel > $perl_version) {"
NSQ_SOURCE_LINE 00000160 "            if ($reldelta->{removed}{$module}) {"
NSQ_SOURCE_LINE 00000161 "                $mod_exists = 0;"
NSQ_SOURCE_LINE 00000162 "            } else {"
NSQ_SOURCE_LINE 00000163 "                next;"
NSQ_SOURCE_LINE 00000164 "            }"
NSQ_SOURCE_LINE 00000165 "        }"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "        if (exists $reldelta->{changed}{$module}) {"
NSQ_SOURCE_LINE 00000168 "            $mod_exists = 1;"
NSQ_SOURCE_LINE 00000169 "            $mod_ver = $reldelta->{changed}{$module};"
NSQ_SOURCE_LINE 00000170 "        } elsif ($reldelta->{removed}{$module}) {"
NSQ_SOURCE_LINE 00000171 "            $mod_exists = 0;"
NSQ_SOURCE_LINE 00000172 "        }"
NSQ_SOURCE_LINE 00000173 "    }"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    if ($mod_exists) {"
NSQ_SOURCE_LINE 00000176 "        if (defined $module_version) {"
NSQ_SOURCE_LINE 00000177 "            return 0 unless defined $mod_ver;"
NSQ_SOURCE_LINE 00000178 "            return version->parse($mod_ver) >= version->parse($module_version) ? 1:0;"
NSQ_SOURCE_LINE 00000179 "        }"
NSQ_SOURCE_LINE 00000180 "        return 1;"
NSQ_SOURCE_LINE 00000181 "    }"
NSQ_SOURCE_LINE 00000182 "    return 0;"
NSQ_SOURCE_LINE 00000183 "};"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "sub is_core { $is_core->(@_,1) }"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "sub is_still_core { $is_core->(@_,0) }"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "my $list_core_modules = sub {"
NSQ_SOURCE_LINE 00000190 "    my $all = pop;"
NSQ_SOURCE_LINE 00000191 "    my $class = shift if @_ && eval { $_[0]->isa(__PACKAGE__) };"
NSQ_SOURCE_LINE 00000192 "    my $perl_version = @_ ? shift : $];"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    my %added;"
NSQ_SOURCE_LINE 00000195 "    my %removed;"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "  RELEASE:"
NSQ_SOURCE_LINE 00000198 "    for my $rel (sort keys %delta) {"
NSQ_SOURCE_LINE 00000199 "        last if $all && $rel > $perl_version; # this is the difference with list_still_core_modules()"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "        my $delta = $delta{$rel};"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "        next unless $delta->{changed};"
NSQ_SOURCE_LINE 00000204 "        for my $mod (keys %{$delta->{changed}}) {"
NSQ_SOURCE_LINE 00000205 "            # module has been removed between perl_version..latest, skip"
NSQ_SOURCE_LINE 00000206 "            next if $removed{$mod};"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "            if (exists $added{$mod}) {"
NSQ_SOURCE_LINE 00000209 "                # module has been added in a previous version, update first"
NSQ_SOURCE_LINE 00000210 "                # version"
NSQ_SOURCE_LINE 00000211 "                $added{$mod} = $delta->{changed}{$mod} if $rel <= $perl_version;"
NSQ_SOURCE_LINE 00000212 "            } else {"
NSQ_SOURCE_LINE 00000213 "                # module is first added after perl_version, skip"
NSQ_SOURCE_LINE 00000214 "                next if $rel > $perl_version;"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "                $added{$mod} = $delta->{changed}{$mod};"
NSQ_SOURCE_LINE 00000217 "            }"
NSQ_SOURCE_LINE 00000218 "        }"
NSQ_SOURCE_LINE 00000219 "        next unless $delta->{removed};"
NSQ_SOURCE_LINE 00000220 "        for my $mod (keys %{$delta->{removed}}) {"
NSQ_SOURCE_LINE 00000221 "            delete $added{$mod};"
NSQ_SOURCE_LINE 00000222 "            # module has been removed between perl_version..latest, mark it"
NSQ_SOURCE_LINE 00000223 "            $removed{$mod}++ if $rel >= $perl_version;"
NSQ_SOURCE_LINE 00000224 "        }"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "    }"
NSQ_SOURCE_LINE 00000227 "    %added;"
NSQ_SOURCE_LINE 00000228 "};"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "sub list_core_modules { $list_core_modules->(@_,1) }"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "sub list_still_core_modules { $list_core_modules->(@_,0) }"
NSQ_SOURCE_LINE 00000233 ""
