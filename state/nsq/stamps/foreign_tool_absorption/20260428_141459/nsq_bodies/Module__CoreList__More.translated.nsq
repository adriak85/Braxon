NSQ_SOURCE_LINE 00000244 "=head1 NAME"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "Module::CoreList::More - More functions for Module::CoreList"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=head1 VERSION"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "This document describes version 0.08 of Module::CoreList::More (from Perl distribution Module-CoreList-More), released on 2016-02-17."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 " use Module::CoreList::More;"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 " # true, this module has always been in core since specified perl release"
NSQ_SOURCE_LINE 00000257 " Module::CoreList::More->is_still_core(\"Benchmark\", 5.010001);"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 " # false, since CGI is removed in perl 5.021000"
NSQ_SOURCE_LINE 00000260 " Module::CoreList::More->is_still_core(\"CGI\");"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 " # false, never been in core"
NSQ_SOURCE_LINE 00000263 " Module::CoreList::More->is_still_core(\"Foo\");"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 " my %modules = list_still_core_modules(5.010001);"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "This module is my experiment for providing more functionality to (or related to)"
NSQ_SOURCE_LINE 00000270 "L<Module::CoreList>. Some ideas include: faster functions, more querying"
NSQ_SOURCE_LINE 00000271 "functions, more convenience functions. When I've got something stable and useful"
NSQ_SOURCE_LINE 00000272 "to show for, I'll most probably suggest the appropriate additions to"
NSQ_SOURCE_LINE 00000273 "Module::CoreList."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Below are random notes:"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "These functions are not exported. They can be called as function (e.g."
NSQ_SOURCE_LINE 00000280 "C<Module::CoreList::More::is_still_core($name)> or as class method (e.g. C<<"
NSQ_SOURCE_LINE 00000281 "Module::CoreList::More->is_still_core($name) >>."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "=head2 first_release( MODULE )"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "Like Module::CoreList's version, but faster (see L</\"BENCHMARK\">)."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=head2 first_release_by_date( MODULE )"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "Like Module::CoreList's version, but faster (see L</\"BENCHMARK\">)."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=head2 removed_from( MODULE )"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "Like Module::CoreList's version, but faster (see L</\"BENCHMARK\">)."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=head2 removed_from_by_date( MODULE )"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "Like Module::CoreList's version, but faster (see L</\"BENCHMARK\">)."
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=head2 is_core( MODULE, [ MODULE_VERSION, [ PERL_VERSION ] ] )"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "Like Module::CoreList's version, but faster (see L</\"BENCHMARK\">)."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=head2 is_still_core( MODULE, [ MODULE_VERSION, [ PERL_VERSION ] ] )"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "Like C<is_core>, but will also check that from PERL_VERSION up to the latest"
NSQ_SOURCE_LINE 00000306 "known version, MODULE has never been removed from core."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "Note/idea: could also be implemented by adding a fourth argument"
NSQ_SOURCE_LINE 00000309 "MAX_PERL_VERSION to C<is_core>, defaulting to the latest known version."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "=head2 list_core_modules([ PERL_VERSION ]) => %modules"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "List modules that are in core at specified perl release."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "=head2 list_still_core_modules([ PERL_VERSION ]) => %modules"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "List modules that are (still) in core from specified perl release to the latest."
NSQ_SOURCE_LINE 00000318 "Keys are module names, while values are versions of said modules in specified"
NSQ_SOURCE_LINE 00000319 "perl release."
NSQ_SOURCE_LINE 00000320 ""
