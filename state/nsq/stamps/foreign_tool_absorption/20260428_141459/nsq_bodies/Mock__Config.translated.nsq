NSQ_SOURCE_LINE 00000001 "package Mock::Config;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 "use Config ();"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our %MockConfig;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "=head1 NAME"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "Mock::Config - temporarily set Config or XSConfig values"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "=head1 VERSION"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "Version 0.05"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "=cut"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "our $VERSION = '0.05';"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "XSConfig is readonly, so workaround that."
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    use Mock::Config d_fork => 0, perl_patchlevel => '';"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "The importer works only dynamically, not lexically yet."
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    use Mock::Config;"
NSQ_SOURCE_LINE 00000029 "    Mock::Config->import(startperl => '');"
NSQ_SOURCE_LINE 00000030 "    print $Config{startperl}, ' mocked to empty';"
NSQ_SOURCE_LINE 00000031 "    Mock::Config->unimport;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=head1 SUBROUTINES"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "=head2 import"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "Set pair of Config values, even for the readonly XSConfig implementation,"
NSQ_SOURCE_LINE 00000038 "as used in cperl."
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "It does not store the mocked overrides lexically, just dynamically."
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=cut"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "sub _set {"
NSQ_SOURCE_LINE 00000045 "  my ($key, $val) = @_;"
NSQ_SOURCE_LINE 00000046 "  # string context only?"
NSQ_SOURCE_LINE 00000047 "  if (!exists $MockConfig{$key} or $MockConfig{$key} ne $val) {"
NSQ_SOURCE_LINE 00000048 "    if (exists &Config::KEYS) {     # compiled XSConfig"
NSQ_SOURCE_LINE 00000049 "      $MockConfig{$key} = $val;     # cache new value"
NSQ_SOURCE_LINE 00000050 "    } else {"
NSQ_SOURCE_LINE 00000051 "      $MockConfig{$key} = tied(%Config::Config)->{$key}; # store the old value"
NSQ_SOURCE_LINE 00000052 "      tied(%Config::Config)->{$key} = $val;      # set uncompiled Config"
NSQ_SOURCE_LINE 00000053 "    }"
NSQ_SOURCE_LINE 00000054 "  }"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub import {"
NSQ_SOURCE_LINE 00000058 "  my $class = shift;"
NSQ_SOURCE_LINE 00000059 "  if (exists &Config::KEYS) {     # compiled XSConfig"
NSQ_SOURCE_LINE 00000060 "    # initialize the mocker"
NSQ_SOURCE_LINE 00000061 "    if (!exists &Config_FETCHorig) {"
NSQ_SOURCE_LINE 00000062 "      *Config_FETCHorig = \\&Config::FETCH;"
NSQ_SOURCE_LINE 00000063 "      no warnings 'redefine';"
NSQ_SOURCE_LINE 00000064 "      *Config::FETCH = sub {"
NSQ_SOURCE_LINE 00000065 "        if ($_[0] and exists $MockConfig{$_[1]}) {"
NSQ_SOURCE_LINE 00000066 "          return $MockConfig{$_[1]};"
NSQ_SOURCE_LINE 00000067 "        } else {"
NSQ_SOURCE_LINE 00000068 "          return Config_FETCHorig(@_);"
NSQ_SOURCE_LINE 00000069 "        }"
NSQ_SOURCE_LINE 00000070 "      }"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 "  }"
NSQ_SOURCE_LINE 00000073 "  _set(shift, shift) while @_;"
NSQ_SOURCE_LINE 00000074 "}"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=head2 unimport"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "This is unstacked and not lexical."
NSQ_SOURCE_LINE 00000079 "It undoes all imported Config values at once."
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "=cut"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "sub unimport {"
NSQ_SOURCE_LINE 00000084 "  my $class = shift;"
NSQ_SOURCE_LINE 00000085 "  if (!exists &Config::KEYS) {"
NSQ_SOURCE_LINE 00000086 "    for (keys %MockConfig) {"
NSQ_SOURCE_LINE 00000087 "      tied(%Config::Config)->{$_} = $MockConfig{$_};"
NSQ_SOURCE_LINE 00000088 "    }"
NSQ_SOURCE_LINE 00000089 "  }"
NSQ_SOURCE_LINE 00000090 "  %MockConfig = ();"
NSQ_SOURCE_LINE 00000091 "}"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "Reini Urban, C<< <rurban at cpan.org> >>"
NSQ_SOURCE_LINE 00000097 ""
