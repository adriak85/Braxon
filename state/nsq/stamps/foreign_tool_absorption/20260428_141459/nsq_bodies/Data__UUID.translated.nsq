NSQ_SOURCE_LINE 00000012 "our @EXPORT = qw("
NSQ_SOURCE_LINE 00000013 "   NameSpace_DNS"
NSQ_SOURCE_LINE 00000014 "   NameSpace_OID"
NSQ_SOURCE_LINE 00000015 "   NameSpace_URL"
NSQ_SOURCE_LINE 00000016 "   NameSpace_X500"
NSQ_SOURCE_LINE 00000017 ");"
