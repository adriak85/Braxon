NSQ_SOURCE_LINE 00000001 "package Data::UUID;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use Carp;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "require Exporter;"
NSQ_SOURCE_LINE 00000008 "require DynaLoader;"
NSQ_SOURCE_LINE 00000009 "require Digest::MD5;"
NSQ_SOURCE_LINE 00000010 ""
