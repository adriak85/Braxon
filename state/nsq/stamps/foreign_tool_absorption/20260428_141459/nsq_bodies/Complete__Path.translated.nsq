NSQ_SOURCE_LINE 00000001 "package Complete::Path;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2021-02-02'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Complete-Path'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.251'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 "use Log::ger;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Complete::Common qw(:all);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our $COMPLETE_PATH_TRACE = $ENV{COMPLETE_PATH_TRACE} // 0;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "require Exporter;"
NSQ_SOURCE_LINE 00000018 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000019 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000020 "                       complete_path"
NSQ_SOURCE_LINE 00000021 "               );"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub _dig_leaf {"
NSQ_SOURCE_LINE 00000024 "    my ($p, $list_func, $is_dir_func, $filter_func, $path_sep) = @_;"
NSQ_SOURCE_LINE 00000025 "    my $num_dirs;"
NSQ_SOURCE_LINE 00000026 "    my $listres = $list_func->($p, '', 0);"
NSQ_SOURCE_LINE 00000027 "    return $p unless ref($listres) eq 'ARRAY' && @$listres;"
NSQ_SOURCE_LINE 00000028 "    my @candidates;"
NSQ_SOURCE_LINE 00000029 "  L1:"
NSQ_SOURCE_LINE 00000030 "    for my $e (@$listres) {"
NSQ_SOURCE_LINE 00000031 "        my $p2 = $p =~ m!\\Q$path_sep\\E\\z! ? \"$p$e\" : \"$p$path_sep$e\";"
NSQ_SOURCE_LINE 00000032 "        {"
NSQ_SOURCE_LINE 00000033 "            local $_ = $p2; # convenience for filter func"
NSQ_SOURCE_LINE 00000034 "            next L1 if $filter_func && !$filter_func->($p2);"
NSQ_SOURCE_LINE 00000035 "        }"
NSQ_SOURCE_LINE 00000036 "        push @candidates, $p2;"
NSQ_SOURCE_LINE 00000037 "    }"
NSQ_SOURCE_LINE 00000038 "    return $p unless @candidates == 1;"
NSQ_SOURCE_LINE 00000039 "    my $p2 = $candidates[0];"
NSQ_SOURCE_LINE 00000040 "    my $is_dir;"
NSQ_SOURCE_LINE 00000041 "    if ($p2 =~ m!\\Q$path_sep\\E\\z!) {"
NSQ_SOURCE_LINE 00000042 "        $is_dir++;"
NSQ_SOURCE_LINE 00000043 "    } else {"
NSQ_SOURCE_LINE 00000044 "        $is_dir = $is_dir_func && $is_dir_func->($p2);"
NSQ_SOURCE_LINE 00000045 "    }"
NSQ_SOURCE_LINE 00000046 "    return _dig_leaf($p2, $list_func, $is_dir_func, $filter_func, $path_sep)"
NSQ_SOURCE_LINE 00000047 "        if $is_dir;"
NSQ_SOURCE_LINE 00000048 "    $p2;"
NSQ_SOURCE_LINE 00000049 "}"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "our %SPEC;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "$SPEC{complete_path} = {"
NSQ_SOURCE_LINE 00000054 "    v => 1.1,"
NSQ_SOURCE_LINE 00000055 "    summary => 'Complete path',"
NSQ_SOURCE_LINE 00000056 "    description => <<'_',"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "Complete path, for anything path-like. Meant to be used as backend for other"
NSQ_SOURCE_LINE 00000059 "functions like `Complete::File::complete_file` or"
NSQ_SOURCE_LINE 00000060 "`Complete::Module::complete_module`. Provides features like case-insensitive"
NSQ_SOURCE_LINE 00000061 "matching, expanding intermediate paths, and case mapping."
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "Algorithm is to split path into path elements, then list items (using the"
NSQ_SOURCE_LINE 00000064 "supplied `list_func`) and perform filtering (using the supplied `filter_func`)"
NSQ_SOURCE_LINE 00000065 "at every level."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "_"
NSQ_SOURCE_LINE 00000068 "    args => {"
NSQ_SOURCE_LINE 00000069 "        %arg_word,"
NSQ_SOURCE_LINE 00000070 "        list_func => {"
NSQ_SOURCE_LINE 00000071 "            summary => 'Function to list the content of intermediate \"dirs\"',"
NSQ_SOURCE_LINE 00000072 "            schema => 'code*',"
NSQ_SOURCE_LINE 00000073 "            req => 1,"
NSQ_SOURCE_LINE 00000074 "            description => <<'_',"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "Code will be called with arguments: ($path, $cur_path_elem, $is_intermediate)."
NSQ_SOURCE_LINE 00000077 "Code should return an arrayref containing list of elements. \"Directories\" can be"
NSQ_SOURCE_LINE 00000078 "marked by ending the name with the path separator (see `path_sep`). Or, you can"
NSQ_SOURCE_LINE 00000079 "also provide an `is_dir_func` function that will be consulted after filtering."
NSQ_SOURCE_LINE 00000080 "If an item is a \"directory\" then its name will be suffixed with a path"
NSQ_SOURCE_LINE 00000081 "separator by `complete_path()`."
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "_"
NSQ_SOURCE_LINE 00000084 "        },"
NSQ_SOURCE_LINE 00000085 "        is_dir_func => {"
NSQ_SOURCE_LINE 00000086 "            summary => 'Function to check whether a path is a \"dir\"',"
NSQ_SOURCE_LINE 00000087 "            schema  => 'code*',"
NSQ_SOURCE_LINE 00000088 "            description => <<'_',"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "Optional. You can provide this function to determine if an item is a \"directory\""
NSQ_SOURCE_LINE 00000091 "(so its name can be suffixed with path separator). You do not need to do this if"
NSQ_SOURCE_LINE 00000092 "you already suffix names of \"directories\" with path separator in `list_func`."
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "One reason you might want to provide this and not mark \"directories\" in"
NSQ_SOURCE_LINE 00000095 "`list_func` is when you want to do extra filtering with `filter_func`. Sometimes"
NSQ_SOURCE_LINE 00000096 "you do not want to suffix the names first (example: see `complete_file` in"
NSQ_SOURCE_LINE 00000097 "`Complete::File`)."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "_"
NSQ_SOURCE_LINE 00000100 "        },"
NSQ_SOURCE_LINE 00000101 "        starting_path => {"
NSQ_SOURCE_LINE 00000102 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000103 "            req => 1,"
NSQ_SOURCE_LINE 00000104 "            default => '',"
NSQ_SOURCE_LINE 00000105 "        },"
NSQ_SOURCE_LINE 00000106 "        filter_func => {"
NSQ_SOURCE_LINE 00000107 "            schema  => 'code*',"
NSQ_SOURCE_LINE 00000108 "            description => <<'_',"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "Provide extra filtering. Code will be given path and should return 1 if the item"
NSQ_SOURCE_LINE 00000111 "should be included in the final result or 0 if the item should be excluded."
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "_"
NSQ_SOURCE_LINE 00000114 "        },"
NSQ_SOURCE_LINE 00000115 "        path_sep => {"
NSQ_SOURCE_LINE 00000116 "            schema  => 'str*',"
NSQ_SOURCE_LINE 00000117 "            default => '/',"
NSQ_SOURCE_LINE 00000118 "        },"
NSQ_SOURCE_LINE 00000119 "        #result_prefix => {"
NSQ_SOURCE_LINE 00000120 "        #    summary => 'Prefix each result with this string',"
NSQ_SOURCE_LINE 00000121 "        #    schema  => 'str*',"
NSQ_SOURCE_LINE 00000122 "        #},"
NSQ_SOURCE_LINE 00000123 "        recurse => {"
NSQ_SOURCE_LINE 00000124 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000125 "            cmdline_aliases => {r=>{}},"
NSQ_SOURCE_LINE 00000126 "        },"
NSQ_SOURCE_LINE 00000127 "        recurse_matching => {"
NSQ_SOURCE_LINE 00000128 "            schema => ['str*', in=>['level-by-level', 'all-at-once']],"
NSQ_SOURCE_LINE 00000129 "            default => 'level-by-level',"
NSQ_SOURCE_LINE 00000130 "        },"
NSQ_SOURCE_LINE 00000131 "        exclude_leaf => {"
NSQ_SOURCE_LINE 00000132 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000133 "        },"
NSQ_SOURCE_LINE 00000134 "        exclude_dir => {"
NSQ_SOURCE_LINE 00000135 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000136 "        },"
NSQ_SOURCE_LINE 00000137 "    },"
NSQ_SOURCE_LINE 00000138 "    args_rels => {"
NSQ_SOURCE_LINE 00000139 "        dep_all => [recurse_matching => ['recurse']],"
NSQ_SOURCE_LINE 00000140 "    },"
NSQ_SOURCE_LINE 00000141 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000142 "    result => {"
NSQ_SOURCE_LINE 00000143 "        schema => 'array',"
NSQ_SOURCE_LINE 00000144 "    },"
NSQ_SOURCE_LINE 00000145 "};"
NSQ_SOURCE_LINE 00000146 "sub complete_path {"
NSQ_SOURCE_LINE 00000147 "    require Complete::Util;"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    my %args   = @_;"
NSQ_SOURCE_LINE 00000150 "    my $word   = $args{word} // \"\";"
NSQ_SOURCE_LINE 00000151 "    my $path_sep = $args{path_sep} // '/';"
NSQ_SOURCE_LINE 00000152 "    my $list_func   = $args{list_func};"
NSQ_SOURCE_LINE 00000153 "    my $is_dir_func = $args{is_dir_func};"
NSQ_SOURCE_LINE 00000154 "    my $filter_func = $args{filter_func};"
NSQ_SOURCE_LINE 00000155 "    my $result_prefix = $args{result_prefix};"
NSQ_SOURCE_LINE 00000156 "    my $starting_path = $args{starting_path} // '';"
NSQ_SOURCE_LINE 00000157 "    my $recurse = $args{recurse};"
NSQ_SOURCE_LINE 00000158 "    my $recurse_matching = $args{recurse_matching} // 'level-by-level';"
NSQ_SOURCE_LINE 00000159 "    my $exclude_leaf = $args{exclude_leaf};"
NSQ_SOURCE_LINE 00000160 "    my $exclude_dir  = $args{exclude_dir};"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    my $ci          = $Complete::Common::OPT_CI;"
NSQ_SOURCE_LINE 00000163 "    my $word_mode   = $Complete::Common::OPT_WORD_MODE;"
NSQ_SOURCE_LINE 00000164 "    my $fuzzy       = $Complete::Common::OPT_FUZZY;"
NSQ_SOURCE_LINE 00000165 "    my $map_case    = $Complete::Common::OPT_MAP_CASE;"
NSQ_SOURCE_LINE 00000166 "    my $exp_im_path = $Complete::Common::OPT_EXP_IM_PATH;"
NSQ_SOURCE_LINE 00000167 "    my $dig_leaf    = $Complete::Common::OPT_DIG_LEAF;"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    my $re_ends_with_path_sep = qr!\\A\\z|\\Q$path_sep\\E\\z!;"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    my @res;"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    my $cut_chars;"
NSQ_SOURCE_LINE 00000174 "    if (defined $args{_cut_chars}) {"
NSQ_SOURCE_LINE 00000175 "        $cut_chars = $args{_cut_chars};"
NSQ_SOURCE_LINE 00000176 "    } else {"
NSQ_SOURCE_LINE 00000177 "        $cut_chars = 0;"
NSQ_SOURCE_LINE 00000178 "        if (length($starting_path)) {"
NSQ_SOURCE_LINE 00000179 "            $cut_chars += length($starting_path);"
NSQ_SOURCE_LINE 00000180 "            unless ($starting_path =~ /\\Q$path_sep\\E\\z/) {"
NSQ_SOURCE_LINE 00000181 "                $cut_chars += length($path_sep);"
NSQ_SOURCE_LINE 00000182 "            }"
NSQ_SOURCE_LINE 00000183 "        }"
NSQ_SOURCE_LINE 00000184 "    }"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "  RECURSE_MATCHING_ALL_AT_ONCE: {"
NSQ_SOURCE_LINE 00000187 "        # recurse matching all-at-once is way simpler, we just need to collect"
NSQ_SOURCE_LINE 00000188 "        # all the nodes, then complate against it."
NSQ_SOURCE_LINE 00000189 "        last unless $recurse && $recurse_matching eq 'all-at-once';"
NSQ_SOURCE_LINE 00000190 "        my @dirs = ($starting_path);"
NSQ_SOURCE_LINE 00000191 "        while (@dirs) {"
NSQ_SOURCE_LINE 00000192 "            my $dir = shift @dirs;"
NSQ_SOURCE_LINE 00000193 "            my $listres = $list_func->($dir, '', 0);"
NSQ_SOURCE_LINE 00000194 "            next unless $listres && @$listres;"
NSQ_SOURCE_LINE 00000195 "          L1:"
NSQ_SOURCE_LINE 00000196 "            for my $e (@$listres) {"
NSQ_SOURCE_LINE 00000197 "                my $p = $dir =~ $re_ends_with_path_sep ?"
NSQ_SOURCE_LINE 00000198 "                    \"$dir$e\" : \"$dir$path_sep$e\";"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "                {"
NSQ_SOURCE_LINE 00000201 "                    local $_ = $p; # convenience for filter func"
NSQ_SOURCE_LINE 00000202 "                    next L1 if $filter_func && !$filter_func->($p);"
NSQ_SOURCE_LINE 00000203 "                }"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "                my $is_dir;"
NSQ_SOURCE_LINE 00000206 "                if ($e =~ $re_ends_with_path_sep) {"
NSQ_SOURCE_LINE 00000207 "                    $is_dir = 1;"
NSQ_SOURCE_LINE 00000208 "                } else {"
NSQ_SOURCE_LINE 00000209 "                    local $_ = $p; # convenience for is_dir_func"
NSQ_SOURCE_LINE 00000210 "                    $is_dir = $is_dir_func->($p);"
NSQ_SOURCE_LINE 00000211 "                }"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "                if ($is_dir) { push @dirs, $p }"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "                # format result"
NSQ_SOURCE_LINE 00000216 "                $p = \"$result_prefix$p\" if length($result_prefix);"
NSQ_SOURCE_LINE 00000217 "                substr($p, 0, $cut_chars) = '' if $cut_chars;"
NSQ_SOURCE_LINE 00000218 "                unless ($p =~ /\\Q$path_sep\\E\\z/) {"
NSQ_SOURCE_LINE 00000219 "                    $p .= $path_sep if $is_dir;"
NSQ_SOURCE_LINE 00000220 "                }"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "                push @res, $p unless ($is_dir && $exclude_dir) || (!$is_dir && $exclude_leaf);"
NSQ_SOURCE_LINE 00000223 "            } # entry"
NSQ_SOURCE_LINE 00000224 "        } # while dirs"
NSQ_SOURCE_LINE 00000225 "        @res = @{ Complete::Util::complete_array_elem("
NSQ_SOURCE_LINE 00000226 "            array => \\@res,"
NSQ_SOURCE_LINE 00000227 "            word  => $word,"
NSQ_SOURCE_LINE 00000228 "        ) };"
NSQ_SOURCE_LINE 00000229 "        goto RETURN_RESULT;"
NSQ_SOURCE_LINE 00000230 "    }"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    # split word by into path elements, as we want to dig level by level (needed"
NSQ_SOURCE_LINE 00000233 "    # when doing case-insensitive search on a case-sensitive tree)."
NSQ_SOURCE_LINE 00000234 "    my @intermediate_dirs;"
NSQ_SOURCE_LINE 00000235 "    {"
NSQ_SOURCE_LINE 00000236 "        @intermediate_dirs = split qr/\\Q$path_sep/, $word;"
NSQ_SOURCE_LINE 00000237 "        @intermediate_dirs = ('') if !@intermediate_dirs;"
NSQ_SOURCE_LINE 00000238 "        push @intermediate_dirs, '' if $word =~ $re_ends_with_path_sep;"
NSQ_SOURCE_LINE 00000239 "    }"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    # extract leaf path, because this one is treated differently"
NSQ_SOURCE_LINE 00000242 "    my $leaf = pop @intermediate_dirs;"
NSQ_SOURCE_LINE 00000243 "    @intermediate_dirs = ('') if !@intermediate_dirs;"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "    #say \"D:starting_path=<$starting_path>\";"
NSQ_SOURCE_LINE 00000246 "    #say \"D:intermediate_dirs=[\",join(\", \", map{\"<$_>\"} @intermediate_dirs),\"]\";"
NSQ_SOURCE_LINE 00000247 "    #say \"D:leaf=<$leaf>\";"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "    # candidate for intermediate paths. when doing case-insensitive search,"
NSQ_SOURCE_LINE 00000250 "    # there maybe multiple candidate paths for each dir, for example if"
NSQ_SOURCE_LINE 00000251 "    # word='../foo/s' and there is '../foo/Surya', '../Foo/sri', '../FOO/SUPER'"
NSQ_SOURCE_LINE 00000252 "    # then candidate paths would be ['../foo', '../Foo', '../FOO'] and the"
NSQ_SOURCE_LINE 00000253 "    # filename should be searched inside all those dirs. everytime we drill down"
NSQ_SOURCE_LINE 00000254 "    # to deeper subdirectories, we adjust this list by removing"
NSQ_SOURCE_LINE 00000255 "    # no-longer-eligible candidates."
NSQ_SOURCE_LINE 00000256 "    my @candidate_paths;"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "    for my $i (0..$#intermediate_dirs) {"
NSQ_SOURCE_LINE 00000259 "        my $intdir = $intermediate_dirs[$i];"
NSQ_SOURCE_LINE 00000260 "        my $intdir_with_path_sep = \"$intdir$path_sep\";"
NSQ_SOURCE_LINE 00000261 "        my @dirs;"
NSQ_SOURCE_LINE 00000262 "        if ($i == 0) {"
NSQ_SOURCE_LINE 00000263 "            # first path elem, we search starting_path first since"
NSQ_SOURCE_LINE 00000264 "            # candidate_paths is still empty."
NSQ_SOURCE_LINE 00000265 "            @dirs = ($starting_path);"
NSQ_SOURCE_LINE 00000266 "        } else {"
NSQ_SOURCE_LINE 00000267 "            # subsequent path elem, we search all candidate_paths"
NSQ_SOURCE_LINE 00000268 "            @dirs = @candidate_paths;"
NSQ_SOURCE_LINE 00000269 "        }"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "        if ($i == $#intermediate_dirs && $intdir eq '') {"
NSQ_SOURCE_LINE 00000272 "            @candidate_paths = @dirs;"
NSQ_SOURCE_LINE 00000273 "            last;"
NSQ_SOURCE_LINE 00000274 "        }"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "        my @new_candidate_paths;"
NSQ_SOURCE_LINE 00000277 "        for my $dir (@dirs) {"
NSQ_SOURCE_LINE 00000278 "            #say \"D:  intdir list($dir)\";"
NSQ_SOURCE_LINE 00000279 "            my $listres = $list_func->($dir, $intdir, 1);"
NSQ_SOURCE_LINE 00000280 "            next unless $listres && @$listres;"
NSQ_SOURCE_LINE 00000281 "            #use DD; say \"D: list res=\", DD::dump($listres);"
NSQ_SOURCE_LINE 00000282 "            my $matches = Complete::Util::complete_array_elem("
NSQ_SOURCE_LINE 00000283 "                word => $intdir, array => $listres,"
NSQ_SOURCE_LINE 00000284 "            );"
NSQ_SOURCE_LINE 00000285 "            my $exact_matches = [grep {"
NSQ_SOURCE_LINE 00000286 "                $_ eq $intdir || $_ eq $intdir_with_path_sep"
NSQ_SOURCE_LINE 00000287 "            } @$matches];"
NSQ_SOURCE_LINE 00000288 "            #use Data::Dmp; say \"D: word=<$intdir>, matches=\", dmp($matches), \", exact_matches=\", dmp($exact_matches);"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "            # when doing exp_im_path, check if we have a single exact match. in"
NSQ_SOURCE_LINE 00000291 "            # that case, don't use all the candidates because that can be"
NSQ_SOURCE_LINE 00000292 "            # annoying, e.g. you have 'a/foo' and 'and/food', you won't be able"
NSQ_SOURCE_LINE 00000293 "            # to complete 'a/f' because bash (e.g.) will always cut the answer"
NSQ_SOURCE_LINE 00000294 "            # to 'a' because the candidates are 'a/foo' and 'and/foo' (it will"
NSQ_SOURCE_LINE 00000295 "            # use the shortest common string which is 'a')."
NSQ_SOURCE_LINE 00000296 "            #say \"D:  num_exact_matches: \", scalar @$exact_matches;"
NSQ_SOURCE_LINE 00000297 "            if (!$exp_im_path || @$exact_matches == 1) {"
NSQ_SOURCE_LINE 00000298 "                $matches = $exact_matches;"
NSQ_SOURCE_LINE 00000299 "            }"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "            for (@$matches) {"
NSQ_SOURCE_LINE 00000302 "                my $p = $dir =~ $re_ends_with_path_sep ?"
NSQ_SOURCE_LINE 00000303 "                    \"$dir$_\" : \"$dir$path_sep$_\";"
NSQ_SOURCE_LINE 00000304 "                push @new_candidate_paths, $p;"
NSQ_SOURCE_LINE 00000305 "            }"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "        }"
NSQ_SOURCE_LINE 00000308 "        #say \"D:  candidate_paths=[\",join(\", \", map{\"<$_>\"} @new_candidate_paths),\"]\";"
NSQ_SOURCE_LINE 00000309 "        return [] unless @new_candidate_paths;"
NSQ_SOURCE_LINE 00000310 "        @candidate_paths = @new_candidate_paths;"
NSQ_SOURCE_LINE 00000311 "    }"
NSQ_SOURCE_LINE 00000312 "    log_trace \"[comppath] candidate paths: %s\", \\@candidate_paths if $ENV{COMPLETE_PATH_TRACE};"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "    for my $dir (@candidate_paths) {"
NSQ_SOURCE_LINE 00000315 "        #say \"D:opendir($dir)\";"
NSQ_SOURCE_LINE 00000316 "        my $listres = $list_func->($dir, $leaf, 0);"
NSQ_SOURCE_LINE 00000317 "        next unless $listres && @$listres;"
NSQ_SOURCE_LINE 00000318 "        my $matches = Complete::Util::complete_array_elem("
NSQ_SOURCE_LINE 00000319 "            word => $leaf, array => $listres,"
NSQ_SOURCE_LINE 00000320 "        );"
NSQ_SOURCE_LINE 00000321 "        #use DD; dd $matches;"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "      L1:"
NSQ_SOURCE_LINE 00000324 "        for my $e (@$matches) {"
NSQ_SOURCE_LINE 00000325 "            my $p = $dir =~ $re_ends_with_path_sep ?"
NSQ_SOURCE_LINE 00000326 "                \"$dir$e\" : \"$dir$path_sep$e\";"
NSQ_SOURCE_LINE 00000327 "            {"
NSQ_SOURCE_LINE 00000328 "                local $_ = $p; # convenience for filter func"
NSQ_SOURCE_LINE 00000329 "                next L1 if $filter_func && !$filter_func->($p);"
NSQ_SOURCE_LINE 00000330 "            }"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "            my $is_dir;"
NSQ_SOURCE_LINE 00000333 "            if ($e =~ $re_ends_with_path_sep) {"
NSQ_SOURCE_LINE 00000334 "                $is_dir = 1;"
NSQ_SOURCE_LINE 00000335 "            } else {"
NSQ_SOURCE_LINE 00000336 "                local $_ = $p; # convenience for is_dir_func"
NSQ_SOURCE_LINE 00000337 "                $is_dir = $is_dir_func->($p);"
NSQ_SOURCE_LINE 00000338 "            }"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "            my @subres;"
NSQ_SOURCE_LINE 00000341 "            if ($is_dir) {"
NSQ_SOURCE_LINE 00000342 "                if ($recurse) {"
NSQ_SOURCE_LINE 00000343 "                    @subres = @{complete_path("
NSQ_SOURCE_LINE 00000344 "                        %args,"
NSQ_SOURCE_LINE 00000345 "                        starting_path => $p,"
NSQ_SOURCE_LINE 00000346 "                        word => '',"
NSQ_SOURCE_LINE 00000347 "                        _cut_chars => $cut_chars,"
NSQ_SOURCE_LINE 00000348 "                    )};"
NSQ_SOURCE_LINE 00000349 "                } elsif ($dig_leaf) {"
NSQ_SOURCE_LINE 00000350 "                  DIG_LEAF:"
NSQ_SOURCE_LINE 00000351 "                    {"
NSQ_SOURCE_LINE 00000352 "                        my $p2 = _dig_leaf($p, $list_func, $is_dir_func, $filter_func, $path_sep);"
NSQ_SOURCE_LINE 00000353 "                        last DIG_LEAF if $p2 eq $p;"
NSQ_SOURCE_LINE 00000354 "                        $p = $p2;"
NSQ_SOURCE_LINE 00000355 "                        #say \"D:p=$p (dig_leaf)\";"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "                        # check again"
NSQ_SOURCE_LINE 00000358 "                        if ($p =~ $re_ends_with_path_sep) {"
NSQ_SOURCE_LINE 00000359 "                            $is_dir = 1;"
NSQ_SOURCE_LINE 00000360 "                        } else {"
NSQ_SOURCE_LINE 00000361 "                            local $_ = $p; # convenience for is_dir_func"
NSQ_SOURCE_LINE 00000362 "                            $is_dir = $is_dir_func->($p);"
NSQ_SOURCE_LINE 00000363 "                        }"
NSQ_SOURCE_LINE 00000364 "                    } # DIG_LEAF"
NSQ_SOURCE_LINE 00000365 "                }"
NSQ_SOURCE_LINE 00000366 "            }"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "            # process into final result"
NSQ_SOURCE_LINE 00000369 "            my $p0 = $p;"
NSQ_SOURCE_LINE 00000370 "            substr($p, 0, $cut_chars) = '' if $cut_chars;"
NSQ_SOURCE_LINE 00000371 "            $p = \"$result_prefix$p\" if length($result_prefix);"
NSQ_SOURCE_LINE 00000372 "            unless ($p =~ /\\Q$path_sep\\E\\z/) {"
NSQ_SOURCE_LINE 00000373 "                $p .= $path_sep if $is_dir;"
NSQ_SOURCE_LINE 00000374 "            }"
NSQ_SOURCE_LINE 00000375 "            push @res, $p unless ($is_dir && $exclude_dir) || (!$is_dir && $exclude_leaf);"
NSQ_SOURCE_LINE 00000376 "            push @res, @subres;"
NSQ_SOURCE_LINE 00000377 "        }"
NSQ_SOURCE_LINE 00000378 "    }"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "  RETURN_RESULT:"
NSQ_SOURCE_LINE 00000381 "    \\@res;"
NSQ_SOURCE_LINE 00000382 "}"
NSQ_SOURCE_LINE 00000383 "1;"
NSQ_SOURCE_LINE 00000384 "# ABSTRACT: Complete path"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "__END__"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "=pod"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "=head1 NAME"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "Complete::Path - Complete path"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "=head1 VERSION"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "This document describes version 0.251 of Complete::Path (from Perl distribution Complete-Path), released on 2021-02-02."
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "=head2 complete_path"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "Usage:"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 " complete_path(%args) -> array"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "Complete path."
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "Complete path, for anything path-like. Meant to be used as backend for other"
NSQ_SOURCE_LINE 00000414 "functions like C<Complete::File::complete_file> or"
NSQ_SOURCE_LINE 00000415 "C<Complete::Module::complete_module>. Provides features like case-insensitive"
NSQ_SOURCE_LINE 00000416 "matching, expanding intermediate paths, and case mapping."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "Algorithm is to split path into path elements, then list items (using the"
NSQ_SOURCE_LINE 00000419 "supplied C<list_func>) and perform filtering (using the supplied C<filter_func>)"
NSQ_SOURCE_LINE 00000420 "at every level."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=over 4"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "=item * B<exclude_dir> => I<bool>"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "=item * B<exclude_leaf> => I<bool>"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "=item * B<filter_func> => I<code>"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "Provide extra filtering. Code will be given path and should return 1 if the item"
NSQ_SOURCE_LINE 00000435 "should be included in the final result or 0 if the item should be excluded."
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=item * B<is_dir_func> => I<code>"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "Function to check whether a path is a \"dir\"."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "Optional. You can provide this function to determine if an item is a \"directory\""
NSQ_SOURCE_LINE 00000442 "(so its name can be suffixed with path separator). You do not need to do this if"
NSQ_SOURCE_LINE 00000443 "you already suffix names of \"directories\" with path separator in C<list_func>."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "One reason you might want to provide this and not mark \"directories\" in"
NSQ_SOURCE_LINE 00000446 "C<list_func> is when you want to do extra filtering with C<filter_func>. Sometimes"
NSQ_SOURCE_LINE 00000447 "you do not want to suffix the names first (example: see C<complete_file> in"
NSQ_SOURCE_LINE 00000448 "C<Complete::File>)."
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "=item * B<list_func>* => I<code>"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "Function to list the content of intermediate \"dirs\"."
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "Code will be called with arguments: ($path, $cur_path_elem, $is_intermediate)."
NSQ_SOURCE_LINE 00000455 "Code should return an arrayref containing list of elements. \"Directories\" can be"
NSQ_SOURCE_LINE 00000456 "marked by ending the name with the path separator (see C<path_sep>). Or, you can"
NSQ_SOURCE_LINE 00000457 "also provide an C<is_dir_func> function that will be consulted after filtering."
NSQ_SOURCE_LINE 00000458 "If an item is a \"directory\" then its name will be suffixed with a path"
NSQ_SOURCE_LINE 00000459 "separator by C<complete_path()>."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "=item * B<path_sep> => I<str> (default: \"/\")"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "=item * B<recurse> => I<bool>"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=item * B<recurse_matching> => I<str> (default: \"level-by-level\")"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "=item * B<starting_path>* => I<str> (default: \"\")"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=item * B<word>* => I<str> (default: \"\")"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "Word to complete."
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=back"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "Return value:  (array)"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "=head2 COMPLETE_PATH_TRACE => bool"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "If set to true, will produce more log statements for debugging."
NSQ_SOURCE_LINE 00000483 ""
