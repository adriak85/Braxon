NSQ_SOURCE_LINE 00000001 "## no critic: Modules::ProhibitAutomaticExportation"
NSQ_SOURCE_LINE 00000002 "package Test::RandomResult;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "our $DATE = '2019-07-17'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $VERSION = '0.001'; # VERSION"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 "use Test2::API 'context';"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Exporter 'import';"
NSQ_SOURCE_LINE 00000012 "our @EXPORT = qw("
NSQ_SOURCE_LINE 00000013 "    results_look_random"
NSQ_SOURCE_LINE 00000014 ");"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub results_look_random(&@) {"
NSQ_SOURCE_LINE 00000017 "    my $code = shift;"
NSQ_SOURCE_LINE 00000018 "    my $opts = {};"
NSQ_SOURCE_LINE 00000019 "    while (@_ > 1) {"
NSQ_SOURCE_LINE 00000020 "        my ($k, $v) = splice @_, 0, 2;"
NSQ_SOURCE_LINE 00000021 "        $opts->{$k} = $v;"
NSQ_SOURCE_LINE 00000022 "    };"
NSQ_SOURCE_LINE 00000023 "    my $name = @_ ? shift : undef;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    my $runs = $opts->{runs} || 30;"
NSQ_SOURCE_LINE 00000026 "    $runs >= 2 or die \"Please set runs > 1\";"
NSQ_SOURCE_LINE 00000027 "    my @res;"
NSQ_SOURCE_LINE 00000028 "    for (1..$runs) {"
NSQ_SOURCE_LINE 00000029 "        push @res, $code->();"
NSQ_SOURCE_LINE 00000030 "    }"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    my $ctx = context();"
NSQ_SOURCE_LINE 00000033 "    #use Data::Dump; $ctx->diag(Data::Dump::dump($opts));"
NSQ_SOURCE_LINE 00000034 "    my $is_ok = 0;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    {"
NSQ_SOURCE_LINE 00000037 "        # XXX check actual distribution"
NSQ_SOURCE_LINE 00000038 "        my %vals;"
NSQ_SOURCE_LINE 00000039 "        for (@res) { $vals{$_}++ }"
NSQ_SOURCE_LINE 00000040 "        if (%vals < 2) {"
NSQ_SOURCE_LINE 00000041 "            $ctx->diag(\"Results do not look random (constant value)\");"
NSQ_SOURCE_LINE 00000042 "            last;"
NSQ_SOURCE_LINE 00000043 "        }"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "        if ($opts->{between} ||"
NSQ_SOURCE_LINE 00000046 "                defined $opts->{min} || defined $opts->{xmin} ||"
NSQ_SOURCE_LINE 00000047 "                defined $opts->{max} || defined $opts->{xmax}"
NSQ_SOURCE_LINE 00000048 "            ) {"
NSQ_SOURCE_LINE 00000049 "            my ($min, $max);"
NSQ_SOURCE_LINE 00000050 "            for (@res) {"
NSQ_SOURCE_LINE 00000051 "                $min = $_ if !defined($min) || $min > $_;"
NSQ_SOURCE_LINE 00000052 "                $max = $_ if !defined($max) || $max < $_;"
NSQ_SOURCE_LINE 00000053 "            }"
NSQ_SOURCE_LINE 00000054 "            if ($opts->{between} && $min < $opts->{between}[0]) {"
NSQ_SOURCE_LINE 00000055 "                $ctx->diag(\"There are results that are less than the specified minimum ($opts->{between}[0]): $min\");"
NSQ_SOURCE_LINE 00000056 "                last;"
NSQ_SOURCE_LINE 00000057 "            }"
NSQ_SOURCE_LINE 00000058 "            if ($opts->{between} && $max > $opts->{between}[1]) {"
NSQ_SOURCE_LINE 00000059 "                $ctx->diag(\"There are results that are greater than the specified minimum ($opts->{between}[1]): $max\");"
NSQ_SOURCE_LINE 00000060 "                last;"
NSQ_SOURCE_LINE 00000061 "            }"
NSQ_SOURCE_LINE 00000062 "            if (defined $opts->{min} && $min < $opts->{min}) {"
NSQ_SOURCE_LINE 00000063 "                $ctx->diag(\"There are results that are less than the specified minimum ($opts->{min}): $min\");"
NSQ_SOURCE_LINE 00000064 "                last;"
NSQ_SOURCE_LINE 00000065 "            }"
NSQ_SOURCE_LINE 00000066 "            if (defined $opts->{xmin} && $min <= $opts->{xmin}) {"
NSQ_SOURCE_LINE 00000067 "                $ctx->diag(\"There are results that are less than or equal to the specified minimum ($opts->{xmin}): $min\");"
NSQ_SOURCE_LINE 00000068 "                last;"
NSQ_SOURCE_LINE 00000069 "            }"
NSQ_SOURCE_LINE 00000070 "            if (defined $opts->{max} && $max > $opts->{max}) {"
NSQ_SOURCE_LINE 00000071 "                $ctx->diag(\"There are results that are greater than the specified maximum ($opts->{max}): $max\");"
NSQ_SOURCE_LINE 00000072 "                last;"
NSQ_SOURCE_LINE 00000073 "            }"
NSQ_SOURCE_LINE 00000074 "            if (defined $opts->{xmax} && $max >= $opts->{xmax}) {"
NSQ_SOURCE_LINE 00000075 "                $ctx->diag(\"There are results that are greater than or equal to the specified maximum ($opts->{xmax}): $max\");"
NSQ_SOURCE_LINE 00000076 "                last;"
NSQ_SOURCE_LINE 00000077 "            }"
NSQ_SOURCE_LINE 00000078 "        }"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "        # everything's good"
NSQ_SOURCE_LINE 00000081 "        $is_ok = 1;"
NSQ_SOURCE_LINE 00000082 "    }"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    $ctx->ok($is_ok, $name);"
NSQ_SOURCE_LINE 00000085 "    $ctx->release;"
NSQ_SOURCE_LINE 00000086 "    $is_ok;"
NSQ_SOURCE_LINE 00000087 "}"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "1;"
NSQ_SOURCE_LINE 00000090 "# ABSTRACT: Test that results of a running code look random"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "__END__"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=pod"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "=head1 NAME"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "Test::RandomResult - Test that results of a running code look random"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 VERSION"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "This document describes version 0.001 of Test::RandomResult (from Perl distribution Test-RandomResult), released on 2019-07-17."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 " use Test::More;"
NSQ_SOURCE_LINE 00000109 " use Test::RandomResult; # exports results_look_random"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 " results_look_random { your_func($arg) } 'your_func returns random result';"
NSQ_SOURCE_LINE 00000112 " results_look_random { your_func($arg) } between=>[1,10], 'your_func returns random between 1-10';"
NSQ_SOURCE_LINE 00000113 " ..."
NSQ_SOURCE_LINE 00000114 " done_testing;"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "B<EARLY RELEASE. CURRENTLY HAS NOT CHECKED THE DISTRIBUTION OF RANDOM RESULTS.>"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head2 results_look_random"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "Usage:"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 " results_look_random { CODE... }, 'TEST NAME';"
NSQ_SOURCE_LINE 00000127 " results_look_random { CODE... }, OPT1=>VAL, OPT2=>VAL, ..., 'TEST NAME';"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "Run code multiple times (by default 30 or more, see the C<runs> option) and"
NSQ_SOURCE_LINE 00000130 "check if the results look random."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "Known options:"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=over"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=item * runs"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "Integer. Default 30 or more. Number of times to run CODE."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=item * between"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "2-element array of numbers (C<< [$min, $max] >>). Check that results are between"
NSQ_SOURCE_LINE 00000143 "C<$min> and C<$max>."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=item * min"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "Number. Specify minimum value (inclusive)."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=item * xmin"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "Number. Specify minimum value (exclusive)."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=item * max"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "Number. Specify maximum value (inclusive)."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=item * xmax"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "Number. Specify maximum value (exclusive)."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=back"
NSQ_SOURCE_LINE 00000162 ""
