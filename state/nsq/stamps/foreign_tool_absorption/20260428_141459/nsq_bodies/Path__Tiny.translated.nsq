NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "sub rootdir { _path( File::Spec->rootdir ) }"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "#pod =construct tempfile, tempdir"
NSQ_SOURCE_LINE 00000355 "#pod"
NSQ_SOURCE_LINE 00000356 "#pod     $temp = Path::Tiny->tempfile( @options );"
NSQ_SOURCE_LINE 00000357 "#pod     $temp = Path::Tiny->tempdir( @options );"
NSQ_SOURCE_LINE 00000358 "#pod     $temp = $dirpath->tempfile( @options );"
NSQ_SOURCE_LINE 00000359 "#pod     $temp = $dirpath->tempdir( @options );"
NSQ_SOURCE_LINE 00000360 "#pod     $temp = tempfile( @options ); # optional export"
NSQ_SOURCE_LINE 00000361 "#pod     $temp = tempdir( @options );  # optional export"
NSQ_SOURCE_LINE 00000362 "#pod"
NSQ_SOURCE_LINE 00000363 "#pod C<tempfile> passes the options to C<< File::Temp->new >> and returns a"
NSQ_SOURCE_LINE 00000364 "#pod C<Path::Tiny> object with the file name.  The C<TMPDIR> option will be enabled"
NSQ_SOURCE_LINE 00000365 "#pod by default, but you can override that by passing C<< TMPDIR => 0 >> along with"
NSQ_SOURCE_LINE 00000366 "#pod the options.  (If you use an absolute C<TEMPLATE> option, you will want to"
NSQ_SOURCE_LINE 00000367 "#pod disable C<TMPDIR>.)"
NSQ_SOURCE_LINE 00000368 "#pod"
NSQ_SOURCE_LINE 00000369 "#pod The resulting C<File::Temp> object is cached. When the C<Path::Tiny> object is"
NSQ_SOURCE_LINE 00000370 "#pod destroyed, the C<File::Temp> object will be as well."
NSQ_SOURCE_LINE 00000371 "#pod"
NSQ_SOURCE_LINE 00000372 "#pod C<File::Temp> annoyingly requires you to specify a custom template in slightly"
NSQ_SOURCE_LINE 00000373 "#pod different ways depending on which function or method you call, but"
NSQ_SOURCE_LINE 00000374 "#pod C<Path::Tiny> lets you ignore that and can take either a leading template or a"
NSQ_SOURCE_LINE 00000375 "#pod C<TEMPLATE> option and does the right thing."
NSQ_SOURCE_LINE 00000376 "#pod"
NSQ_SOURCE_LINE 00000377 "#pod     $temp = Path::Tiny->tempfile( \"customXXXXXXXX\" );             # ok"
NSQ_SOURCE_LINE 00000378 "#pod     $temp = Path::Tiny->tempfile( TEMPLATE => \"customXXXXXXXX\" ); # ok"
NSQ_SOURCE_LINE 00000379 "#pod"
NSQ_SOURCE_LINE 00000380 "#pod The tempfile path object will be normalized to have an absolute path, even if"
NSQ_SOURCE_LINE 00000381 "#pod created in a relative directory using C<DIR>.  If you want it to have"
NSQ_SOURCE_LINE 00000382 "#pod the C<realpath> instead, pass a leading options hash like this:"
NSQ_SOURCE_LINE 00000383 "#pod"
NSQ_SOURCE_LINE 00000384 "#pod     $real_temp = tempfile({realpath => 1}, @options);"
NSQ_SOURCE_LINE 00000385 "#pod"
NSQ_SOURCE_LINE 00000386 "#pod C<tempdir> is just like C<tempfile>, except it calls"
NSQ_SOURCE_LINE 00000387 "#pod C<< File::Temp->newdir >> instead."
NSQ_SOURCE_LINE 00000388 "#pod"
NSQ_SOURCE_LINE 00000389 "#pod Both C<tempfile> and C<tempdir> may be exported on request and used as"
NSQ_SOURCE_LINE 00000390 "#pod functions instead of as methods."
NSQ_SOURCE_LINE 00000391 "#pod"
NSQ_SOURCE_LINE 00000392 "#pod The methods can be called on an instances representing a"
NSQ_SOURCE_LINE 00000393 "#pod directory. In this case, the directory is used as the base to create the"
NSQ_SOURCE_LINE 00000394 "#pod temporary file/directory, setting the C<DIR> option in File::Temp."
NSQ_SOURCE_LINE 00000395 "#pod"
NSQ_SOURCE_LINE 00000396 "#pod     my $target_dir = path('/to/destination');"
NSQ_SOURCE_LINE 00000397 "#pod     my $tempfile = $target_dir->tempfile('foobarXXXXXX');"
NSQ_SOURCE_LINE 00000398 "#pod     $tempfile->spew('A lot of data...');  # not atomic"
NSQ_SOURCE_LINE 00000399 "#pod     $tempfile->move($target_dir->child('foobar')); # hopefully atomic"
NSQ_SOURCE_LINE 00000400 "#pod"
NSQ_SOURCE_LINE 00000401 "#pod In this case, any value set for option C<DIR> is ignored."
NSQ_SOURCE_LINE 00000402 "#pod"
NSQ_SOURCE_LINE 00000403 "#pod B<Note>: for tempfiles, the filehandles from File::Temp are closed and not"
NSQ_SOURCE_LINE 00000404 "#pod reused.  This is not as secure as using File::Temp handles directly, but is"
NSQ_SOURCE_LINE 00000405 "#pod less prone to deadlocks or access problems on some platforms.  Think of what"
NSQ_SOURCE_LINE 00000406 "#pod C<Path::Tiny> gives you to be just a temporary file B<name> that gets cleaned"
NSQ_SOURCE_LINE 00000407 "#pod up."
NSQ_SOURCE_LINE 00000408 "#pod"
NSQ_SOURCE_LINE 00000409 "#pod B<Note 2>: if you don't want these cleaned up automatically when the object"
NSQ_SOURCE_LINE 00000410 "#pod is destroyed, File::Temp requires different options for directories and"
NSQ_SOURCE_LINE 00000411 "#pod files.  Use C<< CLEANUP => 0 >> for directories and C<< UNLINK => 0 >> for"
NSQ_SOURCE_LINE 00000412 "#pod files."
NSQ_SOURCE_LINE 00000413 "#pod"
NSQ_SOURCE_LINE 00000414 "#pod B<Note 3>: Don't lose the temporary object by chaining a method call instead"
NSQ_SOURCE_LINE 00000415 "#pod of storing it:"
NSQ_SOURCE_LINE 00000416 "#pod"
NSQ_SOURCE_LINE 00000417 "#pod     my $lost = tempdir()->child(\"foo\"); # tempdir cleaned up right away"
NSQ_SOURCE_LINE 00000418 "#pod"
NSQ_SOURCE_LINE 00000419 "#pod B<Note 4>: The cached object may be accessed with the L</cached_temp> method."
NSQ_SOURCE_LINE 00000420 "#pod Keeping a reference to, or modifying the cached object may break the"
NSQ_SOURCE_LINE 00000421 "#pod behavior documented above and is not supported.  Use at your own risk."
NSQ_SOURCE_LINE 00000422 "#pod"
NSQ_SOURCE_LINE 00000423 "#pod Current API available since 0.119."
NSQ_SOURCE_LINE 00000424 "#pod"
NSQ_SOURCE_LINE 00000425 "#pod =cut"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "sub tempfile {"
NSQ_SOURCE_LINE 00000428 "    my ( $opts, $maybe_template, $args )"
NSQ_SOURCE_LINE 00000429 "        = _parse_file_temp_args(tempfile => @_);"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "    # File::Temp->new demands TEMPLATE"
NSQ_SOURCE_LINE 00000432 "    $args->{TEMPLATE} = $maybe_template->[0] if @$maybe_template;"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "    require File::Temp;"
NSQ_SOURCE_LINE 00000435 "    my $temp = File::Temp->new( TMPDIR => 1, %$args );"
NSQ_SOURCE_LINE 00000436 "    close $temp;"
NSQ_SOURCE_LINE 00000437 "    my $self = $opts->{realpath} ? _path($temp)->realpath : _path($temp)->absolute;"
NSQ_SOURCE_LINE 00000438 "    $self->[TEMP] = $temp;                # keep object alive while we are"
NSQ_SOURCE_LINE 00000439 "    return $self;"
NSQ_SOURCE_LINE 00000440 "}"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "sub tempdir {"
NSQ_SOURCE_LINE 00000443 "    my ( $opts, $maybe_template, $args )"
NSQ_SOURCE_LINE 00000444 "        = _parse_file_temp_args(tempdir => @_);"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "    require File::Temp;"
NSQ_SOURCE_LINE 00000447 "    my $temp = File::Temp->newdir( @$maybe_template, TMPDIR => 1, %$args );"
NSQ_SOURCE_LINE 00000448 "    my $self = $opts->{realpath} ? _path($temp)->realpath : _path($temp)->absolute;"
NSQ_SOURCE_LINE 00000449 "    $self->[TEMP] = $temp;                # keep object alive while we are"
NSQ_SOURCE_LINE 00000450 "    # Some ActiveState Perls for Windows break Cwd in ways that lead"
NSQ_SOURCE_LINE 00000451 "    # File::Temp to get confused about what path to remove; this"
NSQ_SOURCE_LINE 00000452 "    # monkey-patches the object with our own view of the absolute path"
NSQ_SOURCE_LINE 00000453 "    $temp->{REALNAME} = $self->[CANON] if IS_WIN32;"
NSQ_SOURCE_LINE 00000454 "    return $self;"
NSQ_SOURCE_LINE 00000455 "}"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "# normalize the various ways File::Temp does templates"
NSQ_SOURCE_LINE 00000458 "sub _parse_file_temp_args {"
NSQ_SOURCE_LINE 00000459 "    my $called_as = shift;"
NSQ_SOURCE_LINE 00000460 "    if ( @_ && $_[0] eq 'Path::Tiny' ) { shift } # class method"
NSQ_SOURCE_LINE 00000461 "    elsif ( @_ && eval{$_[0]->isa('Path::Tiny')} ) {"
NSQ_SOURCE_LINE 00000462 "        my $dir = shift;"
NSQ_SOURCE_LINE 00000463 "        if (! $dir->is_dir) {"
NSQ_SOURCE_LINE 00000464 "            $dir->_throw( $called_as, $dir, \"is not a directory object\" );"
NSQ_SOURCE_LINE 00000465 "        }"
NSQ_SOURCE_LINE 00000466 "        push @_, DIR => $dir->stringify; # no overriding"
NSQ_SOURCE_LINE 00000467 "    }"
NSQ_SOURCE_LINE 00000468 "    my $opts = ( @_ && ref $_[0] eq 'HASH' ) ? shift @_ : {};"
NSQ_SOURCE_LINE 00000469 "    $opts = _get_args( $opts, qw/realpath/ );"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "    my $leading_template = ( scalar(@_) % 2 == 1 ? shift(@_) : '' );"
NSQ_SOURCE_LINE 00000472 "    my %args = @_;"
NSQ_SOURCE_LINE 00000473 "    %args = map { uc($_), $args{$_} } keys %args;"
NSQ_SOURCE_LINE 00000474 "    my @template = ("
NSQ_SOURCE_LINE 00000475 "          exists $args{TEMPLATE} ? delete $args{TEMPLATE}"
NSQ_SOURCE_LINE 00000476 "        : $leading_template      ? $leading_template"
NSQ_SOURCE_LINE 00000477 "        :                          ()"
NSQ_SOURCE_LINE 00000478 "    );"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "    return ( $opts, \\@template, \\%args );"
NSQ_SOURCE_LINE 00000481 "}"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000484 "# Private methods"
NSQ_SOURCE_LINE 00000485 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "sub _splitpath {"
NSQ_SOURCE_LINE 00000488 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000489 "    @{$self}[ VOL, DIR, FILE ] = File::Spec->splitpath( $self->[PATH] );"
NSQ_SOURCE_LINE 00000490 "}"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "sub _resolve_symlinks {"
NSQ_SOURCE_LINE 00000493 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000494 "    my $new = $self;"
NSQ_SOURCE_LINE 00000495 "    my ( $count, %seen ) = 0;"
NSQ_SOURCE_LINE 00000496 "    while ( -l $new->[PATH] ) {"
NSQ_SOURCE_LINE 00000497 "        if ( $seen{ $new->[PATH] }++ ) {"
NSQ_SOURCE_LINE 00000498 "            $self->_throw( 'readlink', $self->[PATH], \"symlink loop detected\" );"
NSQ_SOURCE_LINE 00000499 "        }"
NSQ_SOURCE_LINE 00000500 "        if ( ++$count > 100 ) {"
NSQ_SOURCE_LINE 00000501 "            $self->_throw( 'readlink', $self->[PATH], \"maximum symlink depth exceeded\" );"
NSQ_SOURCE_LINE 00000502 "        }"
NSQ_SOURCE_LINE 00000503 "        my $resolved = readlink $new->[PATH];"
NSQ_SOURCE_LINE 00000504 "        $new->_throw( 'readlink', $new->[PATH] ) unless defined $resolved;"
NSQ_SOURCE_LINE 00000505 "        $resolved = _path($resolved);"
NSQ_SOURCE_LINE 00000506 "        $new = $resolved->is_absolute ? $resolved : $new->sibling($resolved);"
NSQ_SOURCE_LINE 00000507 "    }"
NSQ_SOURCE_LINE 00000508 "    return $new;"
NSQ_SOURCE_LINE 00000509 "}"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "sub _replacement_path {"
NSQ_SOURCE_LINE 00000512 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "    my $unique_suffix = $$ . int( rand( 2**31 ) );"
NSQ_SOURCE_LINE 00000515 "    my $temp          = _path( $self . $unique_suffix );"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "    # If filename with process+random suffix is too long, use a shorter"
NSQ_SOURCE_LINE 00000518 "    # version that doesn't preserve the basename."
NSQ_SOURCE_LINE 00000519 "    if ( length $temp->basename > 255 ) {"
NSQ_SOURCE_LINE 00000520 "        $temp = $self->sibling( \"temp\" . $unique_suffix );"
NSQ_SOURCE_LINE 00000521 "    }"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "    return $temp;"
NSQ_SOURCE_LINE 00000524 "}"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000527 "# Public methods"
NSQ_SOURCE_LINE 00000528 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "#pod =method absolute"
NSQ_SOURCE_LINE 00000531 "#pod"
NSQ_SOURCE_LINE 00000532 "#pod     $abs = path(\"foo/bar\")->absolute;"
NSQ_SOURCE_LINE 00000533 "#pod     $abs = path(\"foo/bar\")->absolute(\"/tmp\");"
NSQ_SOURCE_LINE 00000534 "#pod"
NSQ_SOURCE_LINE 00000535 "#pod Returns a new C<Path::Tiny> object with an absolute path (or itself if already"
NSQ_SOURCE_LINE 00000536 "#pod absolute).  If no argument is given, the current directory is used as the"
NSQ_SOURCE_LINE 00000537 "#pod absolute base path.  If an argument is given, it will be converted to an"
NSQ_SOURCE_LINE 00000538 "#pod absolute path (if it is not already) and used as the absolute base path."
NSQ_SOURCE_LINE 00000539 "#pod"
NSQ_SOURCE_LINE 00000540 "#pod This will not resolve upward directories (\"foo/../bar\") unless C<canonpath>"
NSQ_SOURCE_LINE 00000541 "#pod in L<File::Spec> would normally do so on your platform.  If you need them"
NSQ_SOURCE_LINE 00000542 "#pod resolved, you must call the more expensive C<realpath> method instead."
NSQ_SOURCE_LINE 00000543 "#pod"
NSQ_SOURCE_LINE 00000544 "#pod On Windows, an absolute path without a volume component will have it added"
NSQ_SOURCE_LINE 00000545 "#pod based on the current drive."
NSQ_SOURCE_LINE 00000546 "#pod"
NSQ_SOURCE_LINE 00000547 "#pod Current API available since 0.101."
NSQ_SOURCE_LINE 00000548 "#pod"
NSQ_SOURCE_LINE 00000549 "#pod =cut"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "sub absolute {"
NSQ_SOURCE_LINE 00000552 "    my ( $self, $base ) = @_;"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "    # absolute paths handled differently by OS"
NSQ_SOURCE_LINE 00000555 "    if (IS_WIN32) {"
NSQ_SOURCE_LINE 00000556 "        return $self if length $self->volume;"
NSQ_SOURCE_LINE 00000557 "        # add missing volume"
NSQ_SOURCE_LINE 00000558 "        if ( $self->is_absolute ) {"
NSQ_SOURCE_LINE 00000559 "            require Cwd;"
NSQ_SOURCE_LINE 00000560 "            # use Win32::GetCwd not Cwd::getdcwd because we're sure"
NSQ_SOURCE_LINE 00000561 "            # to have the former but not necessarily the latter"
NSQ_SOURCE_LINE 00000562 "            my ($drv) = Win32::GetCwd() =~ /^($DRV_VOL | $UNC_VOL)/x;"
NSQ_SOURCE_LINE 00000563 "            return _path( $drv . $self->[PATH] );"
NSQ_SOURCE_LINE 00000564 "        }"
NSQ_SOURCE_LINE 00000565 "    }"
NSQ_SOURCE_LINE 00000566 "    else {"
NSQ_SOURCE_LINE 00000567 "        return $self if $self->is_absolute;"
NSQ_SOURCE_LINE 00000568 "    }"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "    # no base means use current directory as base"
NSQ_SOURCE_LINE 00000571 "    require Cwd;"
NSQ_SOURCE_LINE 00000572 "    return _path( Cwd::getcwd(), $_[0]->[PATH] ) unless defined $base;"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "    # relative base should be made absolute; we check is_absolute rather"
NSQ_SOURCE_LINE 00000575 "    # than unconditionally make base absolute so that \"/foo\" doesn't become"
NSQ_SOURCE_LINE 00000576 "    # \"C:/foo\" on Windows."
NSQ_SOURCE_LINE 00000577 "    $base = _path($base);"
NSQ_SOURCE_LINE 00000578 "    return _path( ( $base->is_absolute ? $base : $base->absolute ), $_[0]->[PATH] );"
NSQ_SOURCE_LINE 00000579 "}"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "#pod =method append, append_raw, append_utf8"
NSQ_SOURCE_LINE 00000582 "#pod"
NSQ_SOURCE_LINE 00000583 "#pod     path(\"foo.txt\")->append(@data);"
NSQ_SOURCE_LINE 00000584 "#pod     path(\"foo.txt\")->append(\\@data);"
NSQ_SOURCE_LINE 00000585 "#pod     path(\"foo.txt\")->append({binmode => \":raw\"}, @data);"
NSQ_SOURCE_LINE 00000586 "#pod     path(\"foo.txt\")->append_raw(@data);"
NSQ_SOURCE_LINE 00000587 "#pod     path(\"foo.txt\")->append_utf8(@data);"
NSQ_SOURCE_LINE 00000588 "#pod"
NSQ_SOURCE_LINE 00000589 "#pod Appends data to a file.  The file is locked with C<flock> prior to writing"
NSQ_SOURCE_LINE 00000590 "#pod and closed afterwards.  An optional hash reference may be used to pass"
NSQ_SOURCE_LINE 00000591 "#pod options.  Valid options are:"
NSQ_SOURCE_LINE 00000592 "#pod"
NSQ_SOURCE_LINE 00000593 "#pod =for :list"
NSQ_SOURCE_LINE 00000594 "#pod * C<binmode>: passed to C<binmode()> on the handle used for writing."
NSQ_SOURCE_LINE 00000595 "#pod * C<truncate>: truncates the file after locking and before appending"
NSQ_SOURCE_LINE 00000596 "#pod"
NSQ_SOURCE_LINE 00000597 "#pod The C<truncate> option is a way to replace the contents of a file"
NSQ_SOURCE_LINE 00000598 "#pod B<in place>, unlike L</spew> which writes to a temporary file and then"
NSQ_SOURCE_LINE 00000599 "#pod replaces the original (if it exists)."
NSQ_SOURCE_LINE 00000600 "#pod"
NSQ_SOURCE_LINE 00000601 "#pod C<append_raw> is like C<append> with a C<binmode> of C<:unix> for a fast,"
NSQ_SOURCE_LINE 00000602 "#pod unbuffered, raw write."
NSQ_SOURCE_LINE 00000603 "#pod"
NSQ_SOURCE_LINE 00000604 "#pod C<append_utf8> is like C<append> with an unbuffered C<binmode>"
NSQ_SOURCE_LINE 00000605 "#pod C<:unix:encoding(UTF-8)> (or C<:unix:utf8_strict> with"
NSQ_SOURCE_LINE 00000606 "#pod L<PerlIO::utf8_strict>).  If L<Unicode::UTF8> 0.58+ is installed, an"
NSQ_SOURCE_LINE 00000607 "#pod unbuffered, raw append will be done instead on the data encoded with"
NSQ_SOURCE_LINE 00000608 "#pod C<Unicode::UTF8>."
NSQ_SOURCE_LINE 00000609 "#pod"
NSQ_SOURCE_LINE 00000610 "#pod Current API available since 0.060."
NSQ_SOURCE_LINE 00000611 "#pod"
NSQ_SOURCE_LINE 00000612 "#pod =cut"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "sub append {"
NSQ_SOURCE_LINE 00000615 "    my ( $self, @data ) = @_;"
NSQ_SOURCE_LINE 00000616 "    my $args = ( @data && ref $data[0] eq 'HASH' ) ? shift @data : {};"
NSQ_SOURCE_LINE 00000617 "    $args = _get_args( $args, qw/binmode truncate/ );"
NSQ_SOURCE_LINE 00000618 "    my $binmode = $args->{binmode};"
NSQ_SOURCE_LINE 00000619 "    $binmode = ( ( caller(0) )[10] || {} )->{'open>'} unless defined $binmode;"
NSQ_SOURCE_LINE 00000620 "    my $mode = $args->{truncate} ? \">\" : \">>\";"
NSQ_SOURCE_LINE 00000621 "    my $fh = $self->filehandle( { locked => 1 }, $mode, $binmode );"
NSQ_SOURCE_LINE 00000622 "    print( {$fh} map { ref eq 'ARRAY' ? @$_ : $_ } @data ) or $self->_throw('print');"
NSQ_SOURCE_LINE 00000623 "    close $fh or $self->_throw('close');"
NSQ_SOURCE_LINE 00000624 "}"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "sub append_raw {"
NSQ_SOURCE_LINE 00000627 "    my ( $self, @data ) = @_;"
NSQ_SOURCE_LINE 00000628 "    my $args = ( @data && ref $data[0] eq 'HASH' ) ? shift @data : {};"
NSQ_SOURCE_LINE 00000629 "    $args = _get_args( $args, qw/binmode truncate/ );"
NSQ_SOURCE_LINE 00000630 "    $args->{binmode} = ':unix';"
NSQ_SOURCE_LINE 00000631 "    append( $self, $args, @data );"
NSQ_SOURCE_LINE 00000632 "}"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "sub append_utf8 {"
NSQ_SOURCE_LINE 00000635 "    my ( $self, @data ) = @_;"
NSQ_SOURCE_LINE 00000636 "    my $args = ( @data && ref $data[0] eq 'HASH' ) ? shift @data : {};"
NSQ_SOURCE_LINE 00000637 "    $args = _get_args( $args, qw/binmode truncate/ );"
NSQ_SOURCE_LINE 00000638 "    if ( defined($HAS_UU) ? $HAS_UU : ( $HAS_UU = _check_UU() ) ) {"
NSQ_SOURCE_LINE 00000639 "        $args->{binmode} = \":unix\";"
NSQ_SOURCE_LINE 00000640 "        append( $self, $args, map { Unicode::UTF8::encode_utf8($_) } @data );"
NSQ_SOURCE_LINE 00000641 "    }"
NSQ_SOURCE_LINE 00000642 "    elsif ( defined($HAS_PU) ? $HAS_PU : ( $HAS_PU = _check_PU() ) ) {"
NSQ_SOURCE_LINE 00000643 "        $args->{binmode} = \":unix:utf8_strict\";"
NSQ_SOURCE_LINE 00000644 "        append( $self, $args, @data );"
NSQ_SOURCE_LINE 00000645 "    }"
NSQ_SOURCE_LINE 00000646 "    else {"
NSQ_SOURCE_LINE 00000647 "        $args->{binmode} = \":unix:encoding(UTF-8)\";"
NSQ_SOURCE_LINE 00000648 "        append( $self, $args, @data );"
NSQ_SOURCE_LINE 00000649 "    }"
NSQ_SOURCE_LINE 00000650 "}"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "#pod =method assert"
NSQ_SOURCE_LINE 00000653 "#pod"
NSQ_SOURCE_LINE 00000654 "#pod     $path = path(\"foo.txt\")->assert( sub { $_->exists } );"
NSQ_SOURCE_LINE 00000655 "#pod"
NSQ_SOURCE_LINE 00000656 "#pod Returns the invocant after asserting that a code reference argument returns"
NSQ_SOURCE_LINE 00000657 "#pod true.  When the assertion code reference runs, it will have the invocant"
NSQ_SOURCE_LINE 00000658 "#pod object in the C<$_> variable.  If it returns false, an exception will be"
NSQ_SOURCE_LINE 00000659 "#pod thrown.  The assertion code reference may also throw its own exception."
NSQ_SOURCE_LINE 00000660 "#pod"
NSQ_SOURCE_LINE 00000661 "#pod If no assertion is provided, the invocant is returned without error."
NSQ_SOURCE_LINE 00000662 "#pod"
NSQ_SOURCE_LINE 00000663 "#pod Current API available since 0.062."
NSQ_SOURCE_LINE 00000664 "#pod"
NSQ_SOURCE_LINE 00000665 "#pod =cut"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "sub assert {"
NSQ_SOURCE_LINE 00000668 "    my ( $self, $assertion ) = @_;"
NSQ_SOURCE_LINE 00000669 "    return $self unless $assertion;"
NSQ_SOURCE_LINE 00000670 "    if ( ref $assertion eq 'CODE' ) {"
NSQ_SOURCE_LINE 00000671 "        local $_ = $self;"
NSQ_SOURCE_LINE 00000672 "        $assertion->()"
NSQ_SOURCE_LINE 00000673 "          or Path::Tiny::Error->throw( \"assert\", $self->[PATH], \"failed assertion\" );"
NSQ_SOURCE_LINE 00000674 "    }"
NSQ_SOURCE_LINE 00000675 "    else {"
NSQ_SOURCE_LINE 00000676 "        Carp::croak(\"argument to assert must be a code reference argument\");"
NSQ_SOURCE_LINE 00000677 "    }"
NSQ_SOURCE_LINE 00000678 "    return $self;"
NSQ_SOURCE_LINE 00000679 "}"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "#pod =method basename"
NSQ_SOURCE_LINE 00000682 "#pod"
NSQ_SOURCE_LINE 00000683 "#pod     $name = path(\"foo/bar.txt\")->basename;        # bar.txt"
NSQ_SOURCE_LINE 00000684 "#pod     $name = path(\"foo.txt\")->basename('.txt');    # foo"
NSQ_SOURCE_LINE 00000685 "#pod     $name = path(\"foo.txt\")->basename(qr/.txt/);  # foo"
NSQ_SOURCE_LINE 00000686 "#pod     $name = path(\"foo.txt\")->basename(@suffixes);"
NSQ_SOURCE_LINE 00000687 "#pod"
NSQ_SOURCE_LINE 00000688 "#pod Returns the file portion or last directory portion of a path."
NSQ_SOURCE_LINE 00000689 "#pod"
NSQ_SOURCE_LINE 00000690 "#pod Given a list of suffixes as strings or regular expressions, any that match at"
NSQ_SOURCE_LINE 00000691 "#pod the end of the file portion or last directory portion will be removed before"
NSQ_SOURCE_LINE 00000692 "#pod the result is returned."
NSQ_SOURCE_LINE 00000693 "#pod"
NSQ_SOURCE_LINE 00000694 "#pod Current API available since 0.054."
NSQ_SOURCE_LINE 00000695 "#pod"
NSQ_SOURCE_LINE 00000696 "#pod =cut"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "sub basename {"
NSQ_SOURCE_LINE 00000699 "    my ( $self, @suffixes ) = @_;"
NSQ_SOURCE_LINE 00000700 "    $self->_splitpath unless defined $self->[FILE];"
NSQ_SOURCE_LINE 00000701 "    my $file = $self->[FILE];"
NSQ_SOURCE_LINE 00000702 "    for my $s (@suffixes) {"
NSQ_SOURCE_LINE 00000703 "        my $re = ref($s) eq 'Regexp' ? qr/$s\\z/ : qr/\\Q$s\\E\\z/;"
NSQ_SOURCE_LINE 00000704 "        last if $file =~ s/$re//;"
NSQ_SOURCE_LINE 00000705 "    }"
NSQ_SOURCE_LINE 00000706 "    return $file;"
NSQ_SOURCE_LINE 00000707 "}"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "#pod =method canonpath"
NSQ_SOURCE_LINE 00000710 "#pod"
NSQ_SOURCE_LINE 00000711 "#pod     $canonical = path(\"foo/bar\")->canonpath; # foo\\bar on Windows"
NSQ_SOURCE_LINE 00000712 "#pod"
NSQ_SOURCE_LINE 00000713 "#pod Returns a string with the canonical format of the path name for"
NSQ_SOURCE_LINE 00000714 "#pod the platform.  In particular, this means directory separators"
NSQ_SOURCE_LINE 00000715 "#pod will be C<\\> on Windows."
NSQ_SOURCE_LINE 00000716 "#pod"
NSQ_SOURCE_LINE 00000717 "#pod Current API available since 0.001."
NSQ_SOURCE_LINE 00000718 "#pod"
NSQ_SOURCE_LINE 00000719 "#pod =cut"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "sub canonpath { $_[0]->[CANON] }"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "#pod =method cached_temp"
NSQ_SOURCE_LINE 00000724 "#pod"
NSQ_SOURCE_LINE 00000725 "#pod Returns the cached C<File::Temp> or C<File::Temp::Dir> object if the"
NSQ_SOURCE_LINE 00000726 "#pod C<Path::Tiny> object was created with C</tempfile> or C</tempdir>."
NSQ_SOURCE_LINE 00000727 "#pod If there is no such object, this method throws."
NSQ_SOURCE_LINE 00000728 "#pod"
NSQ_SOURCE_LINE 00000729 "#pod B<WARNING>: Keeping a reference to, or modifying the cached object may"
NSQ_SOURCE_LINE 00000730 "#pod break the behavior documented for temporary files and directories created"
NSQ_SOURCE_LINE 00000731 "#pod with C<Path::Tiny> and is not supported.  Use at your own risk."
NSQ_SOURCE_LINE 00000732 "#pod"
NSQ_SOURCE_LINE 00000733 "#pod Current API available since 0.101."
NSQ_SOURCE_LINE 00000734 "#pod"
NSQ_SOURCE_LINE 00000735 "#pod =cut"
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "sub cached_temp {"
NSQ_SOURCE_LINE 00000738 "    my $self = shift;"
NSQ_SOURCE_LINE 00000739 "    $self->_throw( \"cached_temp\", $self, \"has no cached File::Temp object\" )"
NSQ_SOURCE_LINE 00000740 "      unless defined $self->[TEMP];"
NSQ_SOURCE_LINE 00000741 "    return $self->[TEMP];"
NSQ_SOURCE_LINE 00000742 "}"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "#pod =method child"
NSQ_SOURCE_LINE 00000745 "#pod"
NSQ_SOURCE_LINE 00000746 "#pod     $file = path(\"/tmp\")->child(\"foo.txt\"); # \"/tmp/foo.txt\""
NSQ_SOURCE_LINE 00000747 "#pod     $file = path(\"/tmp\")->child(@parts);"
NSQ_SOURCE_LINE 00000748 "#pod"
NSQ_SOURCE_LINE 00000749 "#pod Returns a new C<Path::Tiny> object relative to the original.  Works"
NSQ_SOURCE_LINE 00000750 "#pod like C<catfile> or C<catdir> from File::Spec, but without caring about"
NSQ_SOURCE_LINE 00000751 "#pod file or directories."
NSQ_SOURCE_LINE 00000752 "#pod"
NSQ_SOURCE_LINE 00000753 "#pod B<WARNING>: because the argument could contain C<..> or refer to symlinks,"
NSQ_SOURCE_LINE 00000754 "#pod there is no guarantee that the new path refers to an actual descendent of"
NSQ_SOURCE_LINE 00000755 "#pod the original.  If this is important to you, transform parent and child with"
NSQ_SOURCE_LINE 00000756 "#pod L</realpath> and check them with L</subsumes>."
NSQ_SOURCE_LINE 00000757 "#pod"
NSQ_SOURCE_LINE 00000758 "#pod Current API available since 0.001."
NSQ_SOURCE_LINE 00000759 "#pod"
NSQ_SOURCE_LINE 00000760 "#pod =cut"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "sub child {"
NSQ_SOURCE_LINE 00000763 "    my ( $self, @parts ) = @_;"
NSQ_SOURCE_LINE 00000764 "    return _path( $self->[PATH], @parts );"
NSQ_SOURCE_LINE 00000765 "}"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "#pod =method children"
NSQ_SOURCE_LINE 00000768 "#pod"
NSQ_SOURCE_LINE 00000769 "#pod     @paths = path(\"/tmp\")->children;"
NSQ_SOURCE_LINE 00000770 "#pod     @paths = path(\"/tmp\")->children( qr/\\.txt\\z/ );"
NSQ_SOURCE_LINE 00000771 "#pod"
NSQ_SOURCE_LINE 00000772 "#pod Returns a list of C<Path::Tiny> objects for all files and directories"
NSQ_SOURCE_LINE 00000773 "#pod within a directory.  Excludes \".\" and \"..\" automatically."
NSQ_SOURCE_LINE 00000774 "#pod"
NSQ_SOURCE_LINE 00000775 "#pod If an optional C<qr//> argument is provided, it only returns objects for child"
NSQ_SOURCE_LINE 00000776 "#pod names that match the given regular expression.  Only the base name is used"
NSQ_SOURCE_LINE 00000777 "#pod for matching:"
NSQ_SOURCE_LINE 00000778 "#pod"
NSQ_SOURCE_LINE 00000779 "#pod     @paths = path(\"/tmp\")->children( qr/^foo/ );"
NSQ_SOURCE_LINE 00000780 "#pod     # matches children like the glob foo*"
NSQ_SOURCE_LINE 00000781 "#pod"
NSQ_SOURCE_LINE 00000782 "#pod Current API available since 0.028."
NSQ_SOURCE_LINE 00000783 "#pod"
NSQ_SOURCE_LINE 00000784 "#pod =cut"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "sub children {"
NSQ_SOURCE_LINE 00000787 "    my ( $self, $filter ) = @_;"
NSQ_SOURCE_LINE 00000788 "    my $dh;"
NSQ_SOURCE_LINE 00000789 "    opendir $dh, $self->[PATH] or $self->_throw('opendir');"
NSQ_SOURCE_LINE 00000790 "    my @children = readdir $dh;"
NSQ_SOURCE_LINE 00000791 "    closedir $dh or $self->_throw('closedir');"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "    if ( not defined $filter ) {"
NSQ_SOURCE_LINE 00000794 "        @children = grep { $_ ne '.' && $_ ne '..' } @children;"
NSQ_SOURCE_LINE 00000795 "    }"
NSQ_SOURCE_LINE 00000796 "    elsif ( $filter && ref($filter) eq 'Regexp' ) {"
NSQ_SOURCE_LINE 00000797 "        @children = grep { $_ ne '.' && $_ ne '..' && $_ =~ $filter } @children;"
NSQ_SOURCE_LINE 00000798 "    }"
NSQ_SOURCE_LINE 00000799 "    else {"
NSQ_SOURCE_LINE 00000800 "        Carp::croak(\"Invalid argument '$filter' for children()\");"
NSQ_SOURCE_LINE 00000801 "    }"
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "    return map { _path( $self->[PATH], $_ ) } @children;"
NSQ_SOURCE_LINE 00000804 "}"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "#pod =method chmod"
NSQ_SOURCE_LINE 00000807 "#pod"
NSQ_SOURCE_LINE 00000808 "#pod     path(\"foo.txt\")->chmod(0777);"
NSQ_SOURCE_LINE 00000809 "#pod     path(\"foo.txt\")->chmod(\"0755\");"
NSQ_SOURCE_LINE 00000810 "#pod     path(\"foo.txt\")->chmod(\"go-w\");"
NSQ_SOURCE_LINE 00000811 "#pod     path(\"foo.txt\")->chmod(\"a=r,u+wx\");"
NSQ_SOURCE_LINE 00000812 "#pod"
NSQ_SOURCE_LINE 00000813 "#pod Sets file or directory permissions.  The argument can be a numeric mode, a"
NSQ_SOURCE_LINE 00000814 "#pod octal string beginning with a \"0\" or a limited subset of the symbolic mode use"
NSQ_SOURCE_LINE 00000815 "#pod by F</bin/chmod>."
NSQ_SOURCE_LINE 00000816 "#pod"
NSQ_SOURCE_LINE 00000817 "#pod The symbolic mode must be a comma-delimited list of mode clauses.  Clauses must"
NSQ_SOURCE_LINE 00000818 "#pod match C<< qr/\\A([augo]+)([=+-])([rwx]+)\\z/ >>, which defines \"who\", \"op\" and"
NSQ_SOURCE_LINE 00000819 "#pod \"perms\" parameters for each clause.  Unlike F</bin/chmod>, all three parameters"
NSQ_SOURCE_LINE 00000820 "#pod are required for each clause, multiple ops are not allowed and permissions"
NSQ_SOURCE_LINE 00000821 "#pod C<stugoX> are not supported.  (See L<File::chmod> for more complex needs.)"
NSQ_SOURCE_LINE 00000822 "#pod"
NSQ_SOURCE_LINE 00000823 "#pod Current API available since 0.053."
NSQ_SOURCE_LINE 00000824 "#pod"
NSQ_SOURCE_LINE 00000825 "#pod =cut"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "sub chmod {"
NSQ_SOURCE_LINE 00000828 "    my ( $self, $new_mode ) = @_;"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "    my $mode;"
NSQ_SOURCE_LINE 00000831 "    if ( $new_mode =~ /\\d/ ) {"
NSQ_SOURCE_LINE 00000832 "        $mode = ( $new_mode =~ /^0/ ? oct($new_mode) : $new_mode );"
NSQ_SOURCE_LINE 00000833 "    }"
NSQ_SOURCE_LINE 00000834 "    elsif ( $new_mode =~ /[=+-]/ ) {"
NSQ_SOURCE_LINE 00000835 "        $mode = _symbolic_chmod( $self->stat->mode & 07777, $new_mode ); ## no critic"
NSQ_SOURCE_LINE 00000836 "    }"
NSQ_SOURCE_LINE 00000837 "    else {"
NSQ_SOURCE_LINE 00000838 "        Carp::croak(\"Invalid mode argument '$new_mode' for chmod()\");"
NSQ_SOURCE_LINE 00000839 "    }"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "    CORE::chmod( $mode, $self->[PATH] ) or $self->_throw(\"chmod\");"
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "    return 1;"
NSQ_SOURCE_LINE 00000844 "}"
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "#pod =method copy"
NSQ_SOURCE_LINE 00000847 "#pod"
NSQ_SOURCE_LINE 00000848 "#pod     path(\"/tmp/foo.txt\")->copy(\"/tmp/bar.txt\");"
NSQ_SOURCE_LINE 00000849 "#pod"
NSQ_SOURCE_LINE 00000850 "#pod Copies the current path to the given destination using L<File::Copy>'s"
NSQ_SOURCE_LINE 00000851 "#pod C<copy> function. Upon success, returns the C<Path::Tiny> object for the"
NSQ_SOURCE_LINE 00000852 "#pod newly copied file."
NSQ_SOURCE_LINE 00000853 "#pod"
NSQ_SOURCE_LINE 00000854 "#pod Current API available since 0.070."
NSQ_SOURCE_LINE 00000855 "#pod"
NSQ_SOURCE_LINE 00000856 "#pod =cut"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "# XXX do recursively for directories?"
NSQ_SOURCE_LINE 00000859 "sub copy {"
NSQ_SOURCE_LINE 00000860 "    my ( $self, $dest ) = @_;"
NSQ_SOURCE_LINE 00000861 "    require File::Copy;"
NSQ_SOURCE_LINE 00000862 "    File::Copy::copy( $self->[PATH], $dest )"
NSQ_SOURCE_LINE 00000863 "      or Carp::croak(\"copy failed for $self to $dest: $!\");"
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "    return -d $dest ? _path( $dest, $self->basename ) : _path($dest);"
NSQ_SOURCE_LINE 00000866 "}"
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "#pod =method digest"
NSQ_SOURCE_LINE 00000869 "#pod"
NSQ_SOURCE_LINE 00000870 "#pod     $obj = path(\"/tmp/foo.txt\")->digest;        # SHA-256"
NSQ_SOURCE_LINE 00000871 "#pod     $obj = path(\"/tmp/foo.txt\")->digest(\"MD5\"); # user-selected"
NSQ_SOURCE_LINE 00000872 "#pod     $obj = path(\"/tmp/foo.txt\")->digest( { chunk_size => 1e6 }, \"MD5\" );"
NSQ_SOURCE_LINE 00000873 "#pod"
NSQ_SOURCE_LINE 00000874 "#pod Returns a hexadecimal digest for a file.  An optional hash reference of options may"
NSQ_SOURCE_LINE 00000875 "#pod be given.  The only option is C<chunk_size>.  If C<chunk_size> is given, that many"
NSQ_SOURCE_LINE 00000876 "#pod bytes will be read at a time.  If not provided, the entire file will be slurped"
NSQ_SOURCE_LINE 00000877 "#pod into memory to compute the digest."
NSQ_SOURCE_LINE 00000878 "#pod"
NSQ_SOURCE_LINE 00000879 "#pod Any subsequent arguments are passed to the constructor for L<Digest> to select"
NSQ_SOURCE_LINE 00000880 "#pod an algorithm.  If no arguments are given, the default is SHA-256."
NSQ_SOURCE_LINE 00000881 "#pod"
NSQ_SOURCE_LINE 00000882 "#pod Current API available since 0.056."
NSQ_SOURCE_LINE 00000883 "#pod"
NSQ_SOURCE_LINE 00000884 "#pod =cut"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "sub digest {"
NSQ_SOURCE_LINE 00000887 "    my ( $self, @opts ) = @_;"
NSQ_SOURCE_LINE 00000888 "    my $args = ( @opts && ref $opts[0] eq 'HASH' ) ? shift @opts : {};"
NSQ_SOURCE_LINE 00000889 "    $args = _get_args( $args, qw/chunk_size/ );"
NSQ_SOURCE_LINE 00000890 "    unshift @opts, 'SHA-256' unless @opts;"
NSQ_SOURCE_LINE 00000891 "    require Digest;"
NSQ_SOURCE_LINE 00000892 "    my $digest = Digest->new(@opts);"
NSQ_SOURCE_LINE 00000893 "    if ( $args->{chunk_size} ) {"
NSQ_SOURCE_LINE 00000894 "        my $fh = $self->filehandle( { locked => 1 }, \"<\", \":unix\" );"
NSQ_SOURCE_LINE 00000895 "        my $buf;"
NSQ_SOURCE_LINE 00000896 "        while (!eof($fh)) {"
NSQ_SOURCE_LINE 00000897 "            my $rc = read $fh, $buf, $args->{chunk_size};"
NSQ_SOURCE_LINE 00000898 "            $self->_throw('read') unless defined $rc;"
NSQ_SOURCE_LINE 00000899 "            $digest->add($buf);"
NSQ_SOURCE_LINE 00000900 "        }"
NSQ_SOURCE_LINE 00000901 "    }"
NSQ_SOURCE_LINE 00000902 "    else {"
NSQ_SOURCE_LINE 00000903 "        $digest->add( $self->slurp_raw );"
NSQ_SOURCE_LINE 00000904 "    }"
NSQ_SOURCE_LINE 00000905 "    return $digest->hexdigest;"
NSQ_SOURCE_LINE 00000906 "}"
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "#pod =method dirname (deprecated)"
NSQ_SOURCE_LINE 00000909 "#pod"
NSQ_SOURCE_LINE 00000910 "#pod     $name = path(\"/tmp/foo.txt\")->dirname; # \"/tmp/\""
NSQ_SOURCE_LINE 00000911 "#pod"
NSQ_SOURCE_LINE 00000912 "#pod Returns the directory portion you would get from calling"
NSQ_SOURCE_LINE 00000913 "#pod C<< File::Spec->splitpath( $path->stringify ) >> or C<\".\"> for a path without a"
NSQ_SOURCE_LINE 00000914 "#pod parent directory portion.  Because L<File::Spec> is inconsistent, the result"
NSQ_SOURCE_LINE 00000915 "#pod might or might not have a trailing slash.  Because of this, this method is"
NSQ_SOURCE_LINE 00000916 "#pod B<deprecated>."
NSQ_SOURCE_LINE 00000917 "#pod"
NSQ_SOURCE_LINE 00000918 "#pod A better, more consistently approach is likely C<< $path->parent->stringify >>,"
NSQ_SOURCE_LINE 00000919 "#pod which will not have a trailing slash except for a root directory."
NSQ_SOURCE_LINE 00000920 "#pod"
NSQ_SOURCE_LINE 00000921 "#pod Deprecated in 0.056."
NSQ_SOURCE_LINE 00000922 "#pod"
NSQ_SOURCE_LINE 00000923 "#pod =cut"
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "sub dirname {"
NSQ_SOURCE_LINE 00000926 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000927 "    $self->_splitpath unless defined $self->[DIR];"
NSQ_SOURCE_LINE 00000928 "    return length $self->[DIR] ? $self->[DIR] : \".\";"
NSQ_SOURCE_LINE 00000929 "}"
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "#pod =method edit, edit_raw, edit_utf8"
NSQ_SOURCE_LINE 00000932 "#pod"
NSQ_SOURCE_LINE 00000933 "#pod     path(\"foo.txt\")->edit( \\&callback, $options );"
NSQ_SOURCE_LINE 00000934 "#pod     path(\"foo.txt\")->edit_utf8( \\&callback );"
NSQ_SOURCE_LINE 00000935 "#pod     path(\"foo.txt\")->edit_raw( \\&callback );"
NSQ_SOURCE_LINE 00000936 "#pod"
NSQ_SOURCE_LINE 00000937 "#pod These are convenience methods that allow \"editing\" a file using a single"
NSQ_SOURCE_LINE 00000938 "#pod callback argument. They slurp the file using C<slurp>, place the contents"
NSQ_SOURCE_LINE 00000939 "#pod inside a localized C<$_> variable, call the callback function (without"
NSQ_SOURCE_LINE 00000940 "#pod arguments), and then write C<$_> (presumably mutated) back to the"
NSQ_SOURCE_LINE 00000941 "#pod file with C<spew>."
NSQ_SOURCE_LINE 00000942 "#pod"
NSQ_SOURCE_LINE 00000943 "#pod An optional hash reference may be used to pass options.  The only option is"
NSQ_SOURCE_LINE 00000944 "#pod C<binmode>, which is passed to C<slurp> and C<spew>."
NSQ_SOURCE_LINE 00000945 "#pod"
NSQ_SOURCE_LINE 00000946 "#pod C<edit_utf8> and C<edit_raw> act like their respective C<slurp_*> and"
NSQ_SOURCE_LINE 00000947 "#pod C<spew_*> methods."
NSQ_SOURCE_LINE 00000948 "#pod"
NSQ_SOURCE_LINE 00000949 "#pod Current API available since 0.077."
NSQ_SOURCE_LINE 00000950 "#pod"
NSQ_SOURCE_LINE 00000951 "#pod =cut"
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "sub edit {"
NSQ_SOURCE_LINE 00000954 "    my $self = shift;"
NSQ_SOURCE_LINE 00000955 "    my $cb   = shift;"
NSQ_SOURCE_LINE 00000956 "    my $args = _get_args( shift, qw/binmode/ );"
NSQ_SOURCE_LINE 00000957 "    Carp::croak(\"Callback for edit() must be a code reference\")"
NSQ_SOURCE_LINE 00000958 "      unless defined($cb) && ref($cb) eq 'CODE';"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "    local $_ ="
NSQ_SOURCE_LINE 00000961 "      $self->slurp( exists( $args->{binmode} ) ? { binmode => $args->{binmode} } : () );"
NSQ_SOURCE_LINE 00000962 "    $cb->();"
NSQ_SOURCE_LINE 00000963 "    $self->spew( $args, $_ );"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "    return;"
NSQ_SOURCE_LINE 00000966 "}"
NSQ_SOURCE_LINE 00000967 ""
NSQ_SOURCE_LINE 00000968 "# this is done long-hand to benefit from slurp_utf8 optimizations"
NSQ_SOURCE_LINE 00000969 "sub edit_utf8 {"
NSQ_SOURCE_LINE 00000970 "    my ( $self, $cb ) = @_;"
NSQ_SOURCE_LINE 00000971 "    Carp::croak(\"Callback for edit_utf8() must be a code reference\")"
NSQ_SOURCE_LINE 00000972 "      unless defined($cb) && ref($cb) eq 'CODE';"
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "    local $_ = $self->slurp_utf8;"
NSQ_SOURCE_LINE 00000975 "    $cb->();"
NSQ_SOURCE_LINE 00000976 "    $self->spew_utf8($_);"
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 "    return;"
NSQ_SOURCE_LINE 00000979 "}"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "sub edit_raw { $_[2] = { binmode => \":unix\" }; goto &edit }"
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 "#pod =method edit_lines, edit_lines_utf8, edit_lines_raw"
NSQ_SOURCE_LINE 00000984 "#pod"
NSQ_SOURCE_LINE 00000985 "#pod     path(\"foo.txt\")->edit_lines( \\&callback, $options );"
NSQ_SOURCE_LINE 00000986 "#pod     path(\"foo.txt\")->edit_lines_utf8( \\&callback );"
NSQ_SOURCE_LINE 00000987 "#pod     path(\"foo.txt\")->edit_lines_raw( \\&callback );"
NSQ_SOURCE_LINE 00000988 "#pod"
NSQ_SOURCE_LINE 00000989 "#pod These are convenience methods that allow \"editing\" a file's lines using a"
NSQ_SOURCE_LINE 00000990 "#pod single callback argument.  They iterate over the file: for each line, the"
NSQ_SOURCE_LINE 00000991 "#pod line is put into a localized C<$_> variable, the callback function is"
NSQ_SOURCE_LINE 00000992 "#pod executed (without arguments) and then C<$_> is written to a temporary file."
NSQ_SOURCE_LINE 00000993 "#pod When iteration is finished, the temporary file is atomically renamed over"
NSQ_SOURCE_LINE 00000994 "#pod the original."
NSQ_SOURCE_LINE 00000995 "#pod"
NSQ_SOURCE_LINE 00000996 "#pod An optional hash reference may be used to pass options.  The only option is"
NSQ_SOURCE_LINE 00000997 "#pod C<binmode>, which is passed to the method that open handles for reading and"
NSQ_SOURCE_LINE 00000998 "#pod writing."
NSQ_SOURCE_LINE 00000999 "#pod"
NSQ_SOURCE_LINE 00001000 "#pod C<edit_lines_raw> is like C<edit_lines> with a buffered C<binmode> of"
NSQ_SOURCE_LINE 00001001 "#pod C<:raw>."
NSQ_SOURCE_LINE 00001002 "#pod"
NSQ_SOURCE_LINE 00001003 "#pod C<edit_lines_utf8> is like C<edit_lines> with a buffered C<binmode>"
NSQ_SOURCE_LINE 00001004 "#pod C<:raw:encoding(UTF-8)> (or C<:raw:utf8_strict> with"
NSQ_SOURCE_LINE 00001005 "#pod L<PerlIO::utf8_strict>)."
NSQ_SOURCE_LINE 00001006 "#pod"
NSQ_SOURCE_LINE 00001007 "#pod Current API available since 0.077."
NSQ_SOURCE_LINE 00001008 "#pod"
NSQ_SOURCE_LINE 00001009 "#pod =cut"
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "sub edit_lines {"
NSQ_SOURCE_LINE 00001012 "    my $self = shift;"
NSQ_SOURCE_LINE 00001013 "    my $cb   = shift;"
NSQ_SOURCE_LINE 00001014 "    my $args = _get_args( shift, qw/binmode/ );"
NSQ_SOURCE_LINE 00001015 "    Carp::croak(\"Callback for edit_lines() must be a code reference\")"
NSQ_SOURCE_LINE 00001016 "      unless defined($cb) && ref($cb) eq 'CODE';"
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "    my $binmode = $args->{binmode};"
NSQ_SOURCE_LINE 00001019 "    # get default binmode from caller's lexical scope (see \"perldoc open\")"
NSQ_SOURCE_LINE 00001020 "    $binmode = ( ( caller(0) )[10] || {} )->{'open>'} unless defined $binmode;"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "    # writing needs to follow the link and create the tempfile in the same"
NSQ_SOURCE_LINE 00001023 "    # dir for later atomic rename"
NSQ_SOURCE_LINE 00001024 "    my $resolved_path = $self->_resolve_symlinks;"
NSQ_SOURCE_LINE 00001025 "    my $temp          = $resolved_path->_replacement_path;"
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "    my $temp_fh = $temp->filehandle( { exclusive => 1, locked => 1 }, \">\", $binmode );"
NSQ_SOURCE_LINE 00001028 "    my $in_fh = $self->filehandle( { locked => 1 }, '<', $binmode );"
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "    local $_;"
NSQ_SOURCE_LINE 00001031 "    while (! eof($in_fh) ) {"
NSQ_SOURCE_LINE 00001032 "        defined( $_ = readline($in_fh) ) or $self->_throw('readline');"
NSQ_SOURCE_LINE 00001033 "        $cb->();"
NSQ_SOURCE_LINE 00001034 "        $temp_fh->print($_) or $self->_throw('print', $temp);"
NSQ_SOURCE_LINE 00001035 "    }"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "    close $temp_fh or $self->_throw( 'close', $temp );"
NSQ_SOURCE_LINE 00001038 "    close $in_fh or $self->_throw('close');"
NSQ_SOURCE_LINE 00001039 ""
NSQ_SOURCE_LINE 00001040 "    return $temp->move($resolved_path);"
NSQ_SOURCE_LINE 00001041 "}"
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "sub edit_lines_raw { $_[2] = { binmode => \":raw\" }; goto &edit_lines }"
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "sub edit_lines_utf8 {"
NSQ_SOURCE_LINE 00001046 "    if ( defined($HAS_PU) ? $HAS_PU : ( $HAS_PU = _check_PU() ) ) {"
NSQ_SOURCE_LINE 00001047 "        $_[2] = { binmode => \":raw:utf8_strict\" };"
NSQ_SOURCE_LINE 00001048 "    }"
NSQ_SOURCE_LINE 00001049 "    else {"
NSQ_SOURCE_LINE 00001050 "        $_[2] = { binmode => \":raw:encoding(UTF-8)\" };"
NSQ_SOURCE_LINE 00001051 "    }"
NSQ_SOURCE_LINE 00001052 "    goto &edit_lines;"
NSQ_SOURCE_LINE 00001053 "}"
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 "#pod =method exists, is_file, is_dir"
NSQ_SOURCE_LINE 00001056 "#pod"
NSQ_SOURCE_LINE 00001057 "#pod     if ( path(\"/tmp\")->exists ) { ... }     # -e"
NSQ_SOURCE_LINE 00001058 "#pod     if ( path(\"/tmp\")->is_dir ) { ... }     # -d"
NSQ_SOURCE_LINE 00001059 "#pod     if ( path(\"/tmp\")->is_file ) { ... }    # -e && ! -d"
NSQ_SOURCE_LINE 00001060 "#pod"
NSQ_SOURCE_LINE 00001061 "#pod Implements file test operations, this means the file or directory actually has"
NSQ_SOURCE_LINE 00001062 "#pod to exist on the filesystem.  Until then, it's just a path."
NSQ_SOURCE_LINE 00001063 "#pod"
NSQ_SOURCE_LINE 00001064 "#pod B<Note>: C<is_file> is not C<-f> because C<-f> is not the opposite of C<-d>."
NSQ_SOURCE_LINE 00001065 "#pod C<-f> means \"plain file\", excluding symlinks, devices, etc. that often can be"
NSQ_SOURCE_LINE 00001066 "#pod read just like files."
NSQ_SOURCE_LINE 00001067 "#pod"
NSQ_SOURCE_LINE 00001068 "#pod Use C<-f> instead if you really mean to check for a plain file."
NSQ_SOURCE_LINE 00001069 "#pod"
NSQ_SOURCE_LINE 00001070 "#pod Current API available since 0.053."
NSQ_SOURCE_LINE 00001071 "#pod"
NSQ_SOURCE_LINE 00001072 "#pod =cut"
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 "sub exists { -e $_[0]->[PATH] }"
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 "sub is_file { -e $_[0]->[PATH] && !-d _ }"
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 "sub is_dir { -d $_[0]->[PATH] }"
NSQ_SOURCE_LINE 00001079 ""
NSQ_SOURCE_LINE 00001080 "#pod =method filehandle"
NSQ_SOURCE_LINE 00001081 "#pod"
NSQ_SOURCE_LINE 00001082 "#pod     $fh = path(\"/tmp/foo.txt\")->filehandle($mode, $binmode);"
NSQ_SOURCE_LINE 00001083 "#pod     $fh = path(\"/tmp/foo.txt\")->filehandle({ locked => 1 }, $mode, $binmode);"
NSQ_SOURCE_LINE 00001084 "#pod     $fh = path(\"/tmp/foo.txt\")->filehandle({ exclusive => 1  }, $mode, $binmode);"
NSQ_SOURCE_LINE 00001085 "#pod"
NSQ_SOURCE_LINE 00001086 "#pod Returns an open file handle.  The C<$mode> argument must be a Perl-style"
NSQ_SOURCE_LINE 00001087 "#pod read/write mode string (\"<\" ,\">\", \">>\", etc.).  If a C<$binmode>"
NSQ_SOURCE_LINE 00001088 "#pod is given, it is set during the C<open> call."
NSQ_SOURCE_LINE 00001089 "#pod"
NSQ_SOURCE_LINE 00001090 "#pod An optional hash reference may be used to pass options."
NSQ_SOURCE_LINE 00001091 "#pod"
NSQ_SOURCE_LINE 00001092 "#pod The C<locked> option governs file locking; if true, handles opened for writing,"
NSQ_SOURCE_LINE 00001093 "#pod appending or read-write are locked with C<LOCK_EX>; otherwise, they are"
NSQ_SOURCE_LINE 00001094 "#pod locked with C<LOCK_SH>.  When using C<locked>, \">\" or \"+>\" modes will delay"
NSQ_SOURCE_LINE 00001095 "#pod truncation until after the lock is acquired."
NSQ_SOURCE_LINE 00001096 "#pod"
NSQ_SOURCE_LINE 00001097 "#pod The C<exclusive> option causes the open() call to fail if the file already"
NSQ_SOURCE_LINE 00001098 "#pod exists.  This corresponds to the O_EXCL flag to sysopen / open(2)."
NSQ_SOURCE_LINE 00001099 "#pod C<exclusive> implies C<locked> and will set it for you if you forget it."
NSQ_SOURCE_LINE 00001100 "#pod"
NSQ_SOURCE_LINE 00001101 "#pod See C<openr>, C<openw>, C<openrw>, and C<opena> for sugar."
NSQ_SOURCE_LINE 00001102 "#pod"
NSQ_SOURCE_LINE 00001103 "#pod Current API available since 0.066."
NSQ_SOURCE_LINE 00001104 "#pod"
NSQ_SOURCE_LINE 00001105 "#pod =cut"
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 "# Note: must put binmode on open line, not subsequent binmode() call, so things"
NSQ_SOURCE_LINE 00001108 "# like \":unix\" actually stop perlio/crlf from being added"
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "sub filehandle {"
NSQ_SOURCE_LINE 00001111 "    my ( $self, @args ) = @_;"
NSQ_SOURCE_LINE 00001112 "    my $args = ( @args && ref $args[0] eq 'HASH' ) ? shift @args : {};"
NSQ_SOURCE_LINE 00001113 "    $args = _get_args( $args, qw/locked exclusive/ );"
NSQ_SOURCE_LINE 00001114 "    $args->{locked} = 1 if $args->{exclusive};"
NSQ_SOURCE_LINE 00001115 "    my ( $opentype, $binmode ) = @args;"
NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "    $opentype = \"<\" unless defined $opentype;"
NSQ_SOURCE_LINE 00001118 "    Carp::croak(\"Invalid file mode '$opentype'\")"
NSQ_SOURCE_LINE 00001119 "      unless grep { $opentype eq $_ } qw/< +< > +> >> +>>/;"
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 "    $binmode = ( ( caller(0) )[10] || {} )->{ 'open' . substr( $opentype, -1, 1 ) }"
NSQ_SOURCE_LINE 00001122 "      unless defined $binmode;"
NSQ_SOURCE_LINE 00001123 "    $binmode = \"\" unless defined $binmode;"
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "    my ( $fh, $lock, $trunc );"
NSQ_SOURCE_LINE 00001126 "    if ( $HAS_FLOCK && $args->{locked} && !$ENV{PERL_PATH_TINY_NO_FLOCK} ) {"
NSQ_SOURCE_LINE 00001127 "        require Fcntl;"
NSQ_SOURCE_LINE 00001128 "        # truncating file modes shouldn't truncate until lock acquired"
NSQ_SOURCE_LINE 00001129 "        if ( grep { $opentype eq $_ } qw( > +> ) ) {"
NSQ_SOURCE_LINE 00001130 "            # sysopen in write mode without truncation"
NSQ_SOURCE_LINE 00001131 "            my $flags = $opentype eq \">\" ? Fcntl::O_WRONLY() : Fcntl::O_RDWR();"
NSQ_SOURCE_LINE 00001132 "            $flags |= Fcntl::O_CREAT();"
NSQ_SOURCE_LINE 00001133 "            $flags |= Fcntl::O_EXCL() if $args->{exclusive};"
NSQ_SOURCE_LINE 00001134 "            sysopen( $fh, $self->[PATH], $flags ) or $self->_throw(\"sysopen\");"
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 "            # fix up the binmode since sysopen() can't specify layers like"
NSQ_SOURCE_LINE 00001137 "            # open() and binmode() can't start with just :unix like open()"
NSQ_SOURCE_LINE 00001138 "            if ( $binmode =~ s/^:unix// ) {"
NSQ_SOURCE_LINE 00001139 "                # eliminate pseudo-layers"
NSQ_SOURCE_LINE 00001140 "                binmode( $fh, \":raw\" ) or $self->_throw(\"binmode (:raw)\");"
NSQ_SOURCE_LINE 00001141 "                # strip off real layers until only :unix is left"
NSQ_SOURCE_LINE 00001142 "                while ( 1 < ( my $layers =()= PerlIO::get_layers( $fh, output => 1 ) ) ) {"
NSQ_SOURCE_LINE 00001143 "                    binmode( $fh, \":pop\" ) or $self->_throw(\"binmode (:pop)\");"
NSQ_SOURCE_LINE 00001144 "                }"
NSQ_SOURCE_LINE 00001145 "            }"
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 "            # apply any remaining binmode layers"
NSQ_SOURCE_LINE 00001148 "            if ( length $binmode ) {"
NSQ_SOURCE_LINE 00001149 "                binmode( $fh, $binmode ) or $self->_throw(\"binmode ($binmode)\");"
NSQ_SOURCE_LINE 00001150 "            }"
NSQ_SOURCE_LINE 00001151 ""
NSQ_SOURCE_LINE 00001152 "            # ask for lock and truncation"
NSQ_SOURCE_LINE 00001153 "            $lock  = Fcntl::LOCK_EX();"
NSQ_SOURCE_LINE 00001154 "            $trunc = 1;"
NSQ_SOURCE_LINE 00001155 "        }"
NSQ_SOURCE_LINE 00001156 "        elsif ( $^O eq 'aix' && $opentype eq \"<\" ) {"
NSQ_SOURCE_LINE 00001157 "            # AIX can only lock write handles, so upgrade to RW and LOCK_EX if"
NSQ_SOURCE_LINE 00001158 "            # the file is writable; otherwise give up on locking.  N.B."
NSQ_SOURCE_LINE 00001159 "            # checking -w before open to determine the open mode is an"
NSQ_SOURCE_LINE 00001160 "            # unavoidable race condition"
NSQ_SOURCE_LINE 00001161 "            if ( -w $self->[PATH] ) {"
NSQ_SOURCE_LINE 00001162 "                $opentype = \"+<\";"
NSQ_SOURCE_LINE 00001163 "                $lock     = Fcntl::LOCK_EX();"
NSQ_SOURCE_LINE 00001164 "            }"
NSQ_SOURCE_LINE 00001165 "        }"
NSQ_SOURCE_LINE 00001166 "        else {"
NSQ_SOURCE_LINE 00001167 "            $lock = $opentype eq \"<\" ? Fcntl::LOCK_SH() : Fcntl::LOCK_EX();"
NSQ_SOURCE_LINE 00001168 "        }"
NSQ_SOURCE_LINE 00001169 "    }"
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 "    unless ($fh) {"
NSQ_SOURCE_LINE 00001172 "        my $mode = $opentype . $binmode;"
NSQ_SOURCE_LINE 00001173 "        open $fh, $mode, $self->[PATH] or $self->_throw(\"open ($mode)\");"
NSQ_SOURCE_LINE 00001174 "    }"
NSQ_SOURCE_LINE 00001175 ""
NSQ_SOURCE_LINE 00001176 "    do { flock( $fh, $lock ) or $self->_throw(\"flock ($lock)\") } if $lock;"
NSQ_SOURCE_LINE 00001177 "    do { truncate( $fh, 0 ) or $self->_throw(\"truncate\") } if $trunc;"
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "    return $fh;"
NSQ_SOURCE_LINE 00001180 "}"
NSQ_SOURCE_LINE 00001181 ""
NSQ_SOURCE_LINE 00001182 "#pod =method has_same_bytes"
NSQ_SOURCE_LINE 00001183 "#pod"
NSQ_SOURCE_LINE 00001184 "#pod     if ( path(\"foo.txt\")->has_same_bytes(\"bar.txt\") ) {"
NSQ_SOURCE_LINE 00001185 "#pod        # ..."
NSQ_SOURCE_LINE 00001186 "#pod     }"
NSQ_SOURCE_LINE 00001187 "#pod"
NSQ_SOURCE_LINE 00001188 "#pod This method returns true if both the invocant and the argument can be opened as"
NSQ_SOURCE_LINE 00001189 "#pod file handles and the handles contain the same bytes.  It returns false if their"
NSQ_SOURCE_LINE 00001190 "#pod contents differ.  If either can't be opened as a file (e.g. a directory or"
NSQ_SOURCE_LINE 00001191 "#pod non-existent file), the method throws an exception.  If both can be opened and"
NSQ_SOURCE_LINE 00001192 "#pod both have the same C<realpath>, the method returns true without scanning any"
NSQ_SOURCE_LINE 00001193 "#pod data."
NSQ_SOURCE_LINE 00001194 "#pod"
NSQ_SOURCE_LINE 00001195 "#pod Current API available since 0.125."
NSQ_SOURCE_LINE 00001196 "#pod"
NSQ_SOURCE_LINE 00001197 "#pod =cut"
NSQ_SOURCE_LINE 00001198 ""
NSQ_SOURCE_LINE 00001199 "sub has_same_bytes {"
NSQ_SOURCE_LINE 00001200 "    my ($self, $other_path) = @_;"
NSQ_SOURCE_LINE 00001201 "    my $other = _path($other_path);"
NSQ_SOURCE_LINE 00001202 ""
NSQ_SOURCE_LINE 00001203 "    my $fh1 = $self->openr_raw({ locked => 1 });"
NSQ_SOURCE_LINE 00001204 "    my $fh2 = $other->openr_raw({ locked => 1 });"
NSQ_SOURCE_LINE 00001205 ""
NSQ_SOURCE_LINE 00001206 "    # check for directories"
NSQ_SOURCE_LINE 00001207 "    if (-d $fh1) {"
NSQ_SOURCE_LINE 00001208 "        $self->_throw('has_same_bytes', $self->[PATH], \"directory not allowed\");"
NSQ_SOURCE_LINE 00001209 "    }"
NSQ_SOURCE_LINE 00001210 "    if (-d $fh2) {"
NSQ_SOURCE_LINE 00001211 "        $self->_throw('has_same_bytes', $other->[PATH], \"directory not allowed\");"
NSQ_SOURCE_LINE 00001212 "    }"
NSQ_SOURCE_LINE 00001213 ""
NSQ_SOURCE_LINE 00001214 "    # Now that handles are open, we know the inputs are readable files that"
NSQ_SOURCE_LINE 00001215 "    # exist, so it's safe to compare via realpath"
NSQ_SOURCE_LINE 00001216 "    if ($self->realpath eq $other->realpath) {"
NSQ_SOURCE_LINE 00001217 "        return 1"
NSQ_SOURCE_LINE 00001218 "    }"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "    # result is 0 for equal, 1 for unequal, -1 for error"
NSQ_SOURCE_LINE 00001221 "    require File::Compare;"
NSQ_SOURCE_LINE 00001222 "    my $res = File::Compare::compare($fh1, $fh2, 65536);"
NSQ_SOURCE_LINE 00001223 "    if ($res < 0) {"
NSQ_SOURCE_LINE 00001224 "        $self->_throw('has_same_bytes')"
NSQ_SOURCE_LINE 00001225 "    }"
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "    return $res == 0;"
NSQ_SOURCE_LINE 00001228 "}"
NSQ_SOURCE_LINE 00001229 ""
NSQ_SOURCE_LINE 00001230 "#pod =method is_absolute, is_relative"
NSQ_SOURCE_LINE 00001231 "#pod"
NSQ_SOURCE_LINE 00001232 "#pod     if ( path(\"/tmp\")->is_absolute ) { ... }"
NSQ_SOURCE_LINE 00001233 "#pod     if ( path(\"/tmp\")->is_relative ) { ... }"
NSQ_SOURCE_LINE 00001234 "#pod"
NSQ_SOURCE_LINE 00001235 "#pod Booleans for whether the path appears absolute or relative."
NSQ_SOURCE_LINE 00001236 "#pod"
NSQ_SOURCE_LINE 00001237 "#pod Current API available since 0.001."
NSQ_SOURCE_LINE 00001238 "#pod"
NSQ_SOURCE_LINE 00001239 "#pod =cut"
NSQ_SOURCE_LINE 00001240 ""
NSQ_SOURCE_LINE 00001241 "sub is_absolute { substr( $_[0]->dirname, 0, 1 ) eq '/' }"
NSQ_SOURCE_LINE 00001242 ""
NSQ_SOURCE_LINE 00001243 "sub is_relative { substr( $_[0]->dirname, 0, 1 ) ne '/' }"
NSQ_SOURCE_LINE 00001244 ""
NSQ_SOURCE_LINE 00001245 "#pod =method is_rootdir"
NSQ_SOURCE_LINE 00001246 "#pod"
NSQ_SOURCE_LINE 00001247 "#pod     while ( ! $path->is_rootdir ) {"
NSQ_SOURCE_LINE 00001248 "#pod         $path = $path->parent;"
NSQ_SOURCE_LINE 00001249 "#pod         ..."
NSQ_SOURCE_LINE 00001250 "#pod     }"
NSQ_SOURCE_LINE 00001251 "#pod"
NSQ_SOURCE_LINE 00001252 "#pod Boolean for whether the path is the root directory of the volume.  I.e. the"
NSQ_SOURCE_LINE 00001253 "#pod C<dirname> is C<q[/]> and the C<basename> is C<q[]>."
NSQ_SOURCE_LINE 00001254 "#pod"
NSQ_SOURCE_LINE 00001255 "#pod This works even on C<MSWin32> with drives and UNC volumes:"
NSQ_SOURCE_LINE 00001256 "#pod"
NSQ_SOURCE_LINE 00001257 "#pod     path(\"C:/\")->is_rootdir;             # true"
NSQ_SOURCE_LINE 00001258 "#pod     path(\"//server/share/\")->is_rootdir; #true"
NSQ_SOURCE_LINE 00001259 "#pod"
NSQ_SOURCE_LINE 00001260 "#pod Current API available since 0.038."
NSQ_SOURCE_LINE 00001261 "#pod"
NSQ_SOURCE_LINE 00001262 "#pod =cut"
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "sub is_rootdir {"
NSQ_SOURCE_LINE 00001265 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00001266 "    $self->_splitpath unless defined $self->[DIR];"
NSQ_SOURCE_LINE 00001267 "    return $self->[DIR] eq '/' && $self->[FILE] eq '';"
NSQ_SOURCE_LINE 00001268 "}"
NSQ_SOURCE_LINE 00001269 ""
NSQ_SOURCE_LINE 00001270 "#pod =method iterator"
NSQ_SOURCE_LINE 00001271 "#pod"
NSQ_SOURCE_LINE 00001272 "#pod     $iter = path(\"/tmp\")->iterator( \\%options );"
NSQ_SOURCE_LINE 00001273 "#pod"
NSQ_SOURCE_LINE 00001274 "#pod Returns a code reference that walks a directory lazily.  Each invocation"
NSQ_SOURCE_LINE 00001275 "#pod returns a C<Path::Tiny> object or undef when the iterator is exhausted."
NSQ_SOURCE_LINE 00001276 "#pod"
NSQ_SOURCE_LINE 00001277 "#pod     $iter = path(\"/tmp\")->iterator;"
NSQ_SOURCE_LINE 00001278 "#pod     while ( $path = $iter->() ) {"
NSQ_SOURCE_LINE 00001279 "#pod         ..."
NSQ_SOURCE_LINE 00001280 "#pod     }"
NSQ_SOURCE_LINE 00001281 "#pod"
NSQ_SOURCE_LINE 00001282 "#pod The current and parent directory entries (\".\" and \"..\") will not"
NSQ_SOURCE_LINE 00001283 "#pod be included."
NSQ_SOURCE_LINE 00001284 "#pod"
NSQ_SOURCE_LINE 00001285 "#pod If the C<recurse> option is true, the iterator will walk the directory"
NSQ_SOURCE_LINE 00001286 "#pod recursively, breadth-first.  If the C<follow_symlinks> option is also true,"
NSQ_SOURCE_LINE 00001287 "#pod directory links will be followed recursively.  There is no protection against"
NSQ_SOURCE_LINE 00001288 "#pod loops when following links. If a directory is not readable, it will not be"
NSQ_SOURCE_LINE 00001289 "#pod followed."
NSQ_SOURCE_LINE 00001290 "#pod"
NSQ_SOURCE_LINE 00001291 "#pod The default is the same as:"
NSQ_SOURCE_LINE 00001292 "#pod"
NSQ_SOURCE_LINE 00001293 "#pod     $iter = path(\"/tmp\")->iterator( {"
NSQ_SOURCE_LINE 00001294 "#pod         recurse         => 0,"
NSQ_SOURCE_LINE 00001295 "#pod         follow_symlinks => 0,"
NSQ_SOURCE_LINE 00001296 "#pod     } );"
NSQ_SOURCE_LINE 00001297 "#pod"
NSQ_SOURCE_LINE 00001298 "#pod For a more powerful, recursive iterator with built-in loop avoidance, see"
NSQ_SOURCE_LINE 00001299 "#pod L<Path::Iterator::Rule>."
NSQ_SOURCE_LINE 00001300 "#pod"
NSQ_SOURCE_LINE 00001301 "#pod See also L</visit>."
NSQ_SOURCE_LINE 00001302 "#pod"
NSQ_SOURCE_LINE 00001303 "#pod Current API available since 0.016."
NSQ_SOURCE_LINE 00001304 "#pod"
NSQ_SOURCE_LINE 00001305 "#pod =cut"
NSQ_SOURCE_LINE 00001306 ""
NSQ_SOURCE_LINE 00001307 "sub iterator {"
NSQ_SOURCE_LINE 00001308 "    my $self = shift;"
NSQ_SOURCE_LINE 00001309 "    my $args = _get_args( shift, qw/recurse follow_symlinks/ );"
NSQ_SOURCE_LINE 00001310 "    my @dirs = $self;"
NSQ_SOURCE_LINE 00001311 "    my $current;"
NSQ_SOURCE_LINE 00001312 "    return sub {"
NSQ_SOURCE_LINE 00001313 "        my $next;"
NSQ_SOURCE_LINE 00001314 "        while (@dirs) {"
NSQ_SOURCE_LINE 00001315 "            if ( ref $dirs[0] eq 'Path::Tiny' ) {"
NSQ_SOURCE_LINE 00001316 "                if ( !-r $dirs[0] ) {"
NSQ_SOURCE_LINE 00001317 "                    # Directory is missing or not readable, so skip it.  There"
NSQ_SOURCE_LINE 00001318 "                    # is still a race condition possible between the check and"
NSQ_SOURCE_LINE 00001319 "                    # the opendir, but we can't easily differentiate between"
NSQ_SOURCE_LINE 00001320 "                    # error cases that are OK to skip and those that we want"
NSQ_SOURCE_LINE 00001321 "                    # to be exceptions, so we live with the race and let opendir"
NSQ_SOURCE_LINE 00001322 "                    # be fatal."
NSQ_SOURCE_LINE 00001323 "                    shift @dirs and next;"
NSQ_SOURCE_LINE 00001324 "                }"
NSQ_SOURCE_LINE 00001325 "                $current = $dirs[0];"
NSQ_SOURCE_LINE 00001326 "                my $dh;"
NSQ_SOURCE_LINE 00001327 "                opendir( $dh, $current->[PATH] )"
NSQ_SOURCE_LINE 00001328 "                  or $self->_throw( 'opendir', $current->[PATH] );"
NSQ_SOURCE_LINE 00001329 "                $dirs[0] = $dh;"
NSQ_SOURCE_LINE 00001330 "                if ( -l $current->[PATH] && !$args->{follow_symlinks} ) {"
NSQ_SOURCE_LINE 00001331 "                    # Symlink attack! It was a real dir, but is now a symlink!"
NSQ_SOURCE_LINE 00001332 "                    # N.B. we check *after* opendir so the attacker has to win"
NSQ_SOURCE_LINE 00001333 "                    # two races: replace dir with symlink before opendir and"
NSQ_SOURCE_LINE 00001334 "                    # replace symlink with dir before -l check above"
NSQ_SOURCE_LINE 00001335 "                    shift @dirs and next;"
NSQ_SOURCE_LINE 00001336 "                }"
NSQ_SOURCE_LINE 00001337 "            }"
NSQ_SOURCE_LINE 00001338 "            while ( defined( $next = readdir $dirs[0] ) ) {"
NSQ_SOURCE_LINE 00001339 "                next if $next eq '.' || $next eq '..';"
NSQ_SOURCE_LINE 00001340 "                my $path = $current->child($next);"
NSQ_SOURCE_LINE 00001341 "                push @dirs, $path"
NSQ_SOURCE_LINE 00001342 "                  if $args->{recurse} && -d $path && !( !$args->{follow_symlinks} && -l $path );"
NSQ_SOURCE_LINE 00001343 "                return $path;"
NSQ_SOURCE_LINE 00001344 "            }"
NSQ_SOURCE_LINE 00001345 "            shift @dirs;"
NSQ_SOURCE_LINE 00001346 "        }"
NSQ_SOURCE_LINE 00001347 "        return;"
NSQ_SOURCE_LINE 00001348 "    };"
NSQ_SOURCE_LINE 00001349 "}"
NSQ_SOURCE_LINE 00001350 ""
NSQ_SOURCE_LINE 00001351 "#pod =method lines, lines_raw, lines_utf8"
NSQ_SOURCE_LINE 00001352 "#pod"
NSQ_SOURCE_LINE 00001353 "#pod     @contents = path(\"/tmp/foo.txt\")->lines;"
NSQ_SOURCE_LINE 00001354 "#pod     @contents = path(\"/tmp/foo.txt\")->lines(\\%options);"
NSQ_SOURCE_LINE 00001355 "#pod     @contents = path(\"/tmp/foo.txt\")->lines_raw;"
NSQ_SOURCE_LINE 00001356 "#pod     @contents = path(\"/tmp/foo.txt\")->lines_utf8;"
NSQ_SOURCE_LINE 00001357 "#pod"
NSQ_SOURCE_LINE 00001358 "#pod     @contents = path(\"/tmp/foo.txt\")->lines( { chomp => 1, count => 4 } );"
NSQ_SOURCE_LINE 00001359 "#pod"
NSQ_SOURCE_LINE 00001360 "#pod Returns a list of lines from a file.  Optionally takes a hash-reference of"
NSQ_SOURCE_LINE 00001361 "#pod options.  Valid options are C<binmode>, C<count> and C<chomp>."
NSQ_SOURCE_LINE 00001362 "#pod"
NSQ_SOURCE_LINE 00001363 "#pod If C<binmode> is provided, it will be set on the handle prior to reading."
NSQ_SOURCE_LINE 00001364 "#pod"
NSQ_SOURCE_LINE 00001365 "#pod If a positive C<count> is provided, that many lines will be returned from the"
NSQ_SOURCE_LINE 00001366 "#pod start of the file.  If a negative C<count> is provided, the entire file will be"
NSQ_SOURCE_LINE 00001367 "#pod read, but only C<abs(count)> will be kept and returned.  If C<abs(count)>"
NSQ_SOURCE_LINE 00001368 "#pod exceeds the number of lines in the file, all lines will be returned."
NSQ_SOURCE_LINE 00001369 "#pod"
NSQ_SOURCE_LINE 00001370 "#pod If C<chomp> is set, any end-of-line character sequences (C<CR>, C<CRLF>, or"
NSQ_SOURCE_LINE 00001371 "#pod C<LF>) will be removed from the lines returned."
NSQ_SOURCE_LINE 00001372 "#pod"
NSQ_SOURCE_LINE 00001373 "#pod Because the return is a list, C<lines> in scalar context will return the number"
NSQ_SOURCE_LINE 00001374 "#pod of lines (and throw away the data)."
NSQ_SOURCE_LINE 00001375 "#pod"
NSQ_SOURCE_LINE 00001376 "#pod     $number_of_lines = path(\"/tmp/foo.txt\")->lines;"
NSQ_SOURCE_LINE 00001377 "#pod"
NSQ_SOURCE_LINE 00001378 "#pod C<lines_raw> is like C<lines> with a C<binmode> of C<:raw>.  We use C<:raw>"
NSQ_SOURCE_LINE 00001379 "#pod instead of C<:unix> so PerlIO buffering can manage reading by line."
NSQ_SOURCE_LINE 00001380 "#pod"
NSQ_SOURCE_LINE 00001381 "#pod C<lines_utf8> is like C<lines> with a C<binmode> of C<:raw:encoding(UTF-8)>"
NSQ_SOURCE_LINE 00001382 "#pod (or C<:raw:utf8_strict> with L<PerlIO::utf8_strict>).  If L<Unicode::UTF8>"
NSQ_SOURCE_LINE 00001383 "#pod 0.58+ is installed, a raw, unbuffered UTF-8 slurp will be done and then the"
NSQ_SOURCE_LINE 00001384 "#pod lines will be split.  This is actually faster than relying on"
NSQ_SOURCE_LINE 00001385 "#pod IO layers, though a bit memory intensive.  If memory use is a"
NSQ_SOURCE_LINE 00001386 "#pod concern, consider C<openr_utf8> and iterating directly on the handle."
NSQ_SOURCE_LINE 00001387 "#pod"
NSQ_SOURCE_LINE 00001388 "#pod See also L</slurp> if you want to load a file as a whole chunk."
NSQ_SOURCE_LINE 00001389 "#pod"
NSQ_SOURCE_LINE 00001390 "#pod Current API available since 0.065."
NSQ_SOURCE_LINE 00001391 "#pod"
NSQ_SOURCE_LINE 00001392 "#pod =cut"
NSQ_SOURCE_LINE 00001393 ""
NSQ_SOURCE_LINE 00001394 "sub lines {"
NSQ_SOURCE_LINE 00001395 "    my $self    = shift;"
NSQ_SOURCE_LINE 00001396 "    my $args    = _get_args( shift, qw/binmode chomp count/ );"
NSQ_SOURCE_LINE 00001397 "    my $binmode = $args->{binmode};"
NSQ_SOURCE_LINE 00001398 "    $binmode = ( ( caller(0) )[10] || {} )->{'open<'} unless defined $binmode;"
NSQ_SOURCE_LINE 00001399 "    my $fh = $self->filehandle( { locked => 1 }, \"<\", $binmode );"
NSQ_SOURCE_LINE 00001400 "    my $chomp = $args->{chomp};"
NSQ_SOURCE_LINE 00001401 "    # XXX more efficient to read @lines then chomp(@lines) vs map?"
NSQ_SOURCE_LINE 00001402 "    if ( $args->{count} ) {"
NSQ_SOURCE_LINE 00001403 "        my ( $counter, $mod, @result ) = ( 0, abs( $args->{count} ) );"
NSQ_SOURCE_LINE 00001404 "        my $line;"
NSQ_SOURCE_LINE 00001405 "        while ( !eof($fh) ) {"
NSQ_SOURCE_LINE 00001406 "            defined( $line = readline($fh) ) or $self->_throw('readline');"
NSQ_SOURCE_LINE 00001407 ""
NSQ_SOURCE_LINE 00001408 "            $line =~ s/(?:\\x{0d}?\\x{0a}|\\x{0d})\\z// if $chomp;"
NSQ_SOURCE_LINE 00001409 "            $result[ $counter++ ] = $line;"
NSQ_SOURCE_LINE 00001410 "            # for positive count, terminate after right number of lines"
NSQ_SOURCE_LINE 00001411 "            last if $counter == $args->{count};"
NSQ_SOURCE_LINE 00001412 "            # for negative count, eventually wrap around in the result array"
NSQ_SOURCE_LINE 00001413 "            $counter %= $mod;"
NSQ_SOURCE_LINE 00001414 "        }"
NSQ_SOURCE_LINE 00001415 "        # reorder results if full and wrapped somewhere in the middle"
NSQ_SOURCE_LINE 00001416 "        splice( @result, 0, 0, splice( @result, $counter ) )"
NSQ_SOURCE_LINE 00001417 "          if @result == $mod && $counter % $mod;"
NSQ_SOURCE_LINE 00001418 "        return @result;"
NSQ_SOURCE_LINE 00001419 "    }"
NSQ_SOURCE_LINE 00001420 "    elsif ($chomp) {"
NSQ_SOURCE_LINE 00001421 "        local $!;"
NSQ_SOURCE_LINE 00001422 "        my @lines = map { s/(?:\\x{0d}?\\x{0a}|\\x{0d})\\z//; $_ } <$fh>; ## no critic"
NSQ_SOURCE_LINE 00001423 "        $self->_throw('readline') if $!;"
NSQ_SOURCE_LINE 00001424 "        return @lines;"
NSQ_SOURCE_LINE 00001425 "    }"
NSQ_SOURCE_LINE 00001426 "    else {"
NSQ_SOURCE_LINE 00001427 "        if ( wantarray ) {"
NSQ_SOURCE_LINE 00001428 "            local $!;"
NSQ_SOURCE_LINE 00001429 "            my @lines = <$fh>;"
NSQ_SOURCE_LINE 00001430 "            $self->_throw('readline') if $!;"
NSQ_SOURCE_LINE 00001431 "            return @lines;"
NSQ_SOURCE_LINE 00001432 "        } else {"
NSQ_SOURCE_LINE 00001433 "            local $!;"
NSQ_SOURCE_LINE 00001434 "            my $count =()= <$fh>;"
NSQ_SOURCE_LINE 00001435 "            $self->_throw('readline') if $!;"
NSQ_SOURCE_LINE 00001436 "            return $count;"
NSQ_SOURCE_LINE 00001437 "        }"
NSQ_SOURCE_LINE 00001438 "    }"
NSQ_SOURCE_LINE 00001439 "}"
NSQ_SOURCE_LINE 00001440 ""
NSQ_SOURCE_LINE 00001441 "sub lines_raw {"
NSQ_SOURCE_LINE 00001442 "    my $self = shift;"
NSQ_SOURCE_LINE 00001443 "    my $args = _get_args( shift, qw/binmode chomp count/ );"
NSQ_SOURCE_LINE 00001444 "    if ( $args->{chomp} && !$args->{count} ) {"
NSQ_SOURCE_LINE 00001445 "        return split /\\n/, slurp_raw($self);                    ## no critic"
NSQ_SOURCE_LINE 00001446 "    }"
NSQ_SOURCE_LINE 00001447 "    else {"
NSQ_SOURCE_LINE 00001448 "        $args->{binmode} = \":raw\";"
NSQ_SOURCE_LINE 00001449 "        return lines( $self, $args );"
NSQ_SOURCE_LINE 00001450 "    }"
NSQ_SOURCE_LINE 00001451 "}"
NSQ_SOURCE_LINE 00001452 ""
NSQ_SOURCE_LINE 00001453 "my $CRLF = qr/(?:\\x{0d}?\\x{0a}|\\x{0d})/;"
NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 "sub lines_utf8 {"
NSQ_SOURCE_LINE 00001456 "    my $self = shift;"
NSQ_SOURCE_LINE 00001457 "    my $args = _get_args( shift, qw/binmode chomp count/ );"
NSQ_SOURCE_LINE 00001458 "    if (   ( defined($HAS_UU) ? $HAS_UU : ( $HAS_UU = _check_UU() ) )"
NSQ_SOURCE_LINE 00001459 "        && $args->{chomp}"
NSQ_SOURCE_LINE 00001460 "        && !$args->{count} )"
NSQ_SOURCE_LINE 00001461 "    {"
NSQ_SOURCE_LINE 00001462 "        my $slurp = slurp_utf8($self);"
NSQ_SOURCE_LINE 00001463 "        $slurp =~ s/$CRLF\\z//; # like chomp, but full CR?LF|CR"
NSQ_SOURCE_LINE 00001464 "        return split $CRLF, $slurp, -1; ## no critic"
NSQ_SOURCE_LINE 00001465 "    }"
NSQ_SOURCE_LINE 00001466 "    elsif ( defined($HAS_PU) ? $HAS_PU : ( $HAS_PU = _check_PU() ) ) {"
NSQ_SOURCE_LINE 00001467 "        $args->{binmode} = \":raw:utf8_strict\";"
NSQ_SOURCE_LINE 00001468 "        return lines( $self, $args );"
NSQ_SOURCE_LINE 00001469 "    }"
NSQ_SOURCE_LINE 00001470 "    else {"
NSQ_SOURCE_LINE 00001471 "        $args->{binmode} = \":raw:encoding(UTF-8)\";"
NSQ_SOURCE_LINE 00001472 "        return lines( $self, $args );"
NSQ_SOURCE_LINE 00001473 "    }"
NSQ_SOURCE_LINE 00001474 "}"
NSQ_SOURCE_LINE 00001475 ""
NSQ_SOURCE_LINE 00001476 "#pod =method mkdir"
NSQ_SOURCE_LINE 00001477 "#pod"
NSQ_SOURCE_LINE 00001478 "#pod     path(\"foo/bar/baz\")->mkdir;"
NSQ_SOURCE_LINE 00001479 "#pod     path(\"foo/bar/baz\")->mkdir( \\%options );"
NSQ_SOURCE_LINE 00001480 "#pod"
NSQ_SOURCE_LINE 00001481 "#pod Like calling C<make_path> from L<File::Path>.  An optional hash reference"
NSQ_SOURCE_LINE 00001482 "#pod is passed through to C<make_path>.  Errors will be trapped and an exception"
NSQ_SOURCE_LINE 00001483 "#pod thrown.  Returns the the path object to facilitate chaining."
NSQ_SOURCE_LINE 00001484 "#pod"
NSQ_SOURCE_LINE 00001485 "#pod B<NOTE>: unlike Perl's builtin C<mkdir>, this will create intermediate paths"
NSQ_SOURCE_LINE 00001486 "#pod similar to the Unix C<mkdir -p> command.  It will not error if applied to an"
NSQ_SOURCE_LINE 00001487 "#pod existing directory."
NSQ_SOURCE_LINE 00001488 "#pod"
NSQ_SOURCE_LINE 00001489 "#pod Passing a defined argument I<other> than a hash reference is an error, and an"
NSQ_SOURCE_LINE 00001490 "#pod exception will be thrown."
NSQ_SOURCE_LINE 00001491 "#pod"
NSQ_SOURCE_LINE 00001492 "#pod Current API available since 0.125."
NSQ_SOURCE_LINE 00001493 "#pod"
NSQ_SOURCE_LINE 00001494 "#pod =cut"
NSQ_SOURCE_LINE 00001495 ""
NSQ_SOURCE_LINE 00001496 "sub mkdir {"
NSQ_SOURCE_LINE 00001497 "    my ( $self, $args, @rest ) = @_;"
NSQ_SOURCE_LINE 00001498 ""
NSQ_SOURCE_LINE 00001499 "    $args = {} unless defined $args;"
NSQ_SOURCE_LINE 00001500 "    if (@rest || (defined $args && ref $args ne 'HASH')) {"
NSQ_SOURCE_LINE 00001501 "        $self->_throw('mkdir', undef, \"method argument was given, but was not a hash reference\");"
NSQ_SOURCE_LINE 00001502 "    }"
NSQ_SOURCE_LINE 00001503 ""
NSQ_SOURCE_LINE 00001504 "    my $err;"
NSQ_SOURCE_LINE 00001505 ""
NSQ_SOURCE_LINE 00001506 "    $args->{error} = \\$err unless defined $args->{error};"
NSQ_SOURCE_LINE 00001507 "    require File::Path;"
NSQ_SOURCE_LINE 00001508 "    my @dirs;"
NSQ_SOURCE_LINE 00001509 "    my $ok = eval {"
NSQ_SOURCE_LINE 00001510 "        File::Path::make_path( $self->[PATH], $args );"
NSQ_SOURCE_LINE 00001511 "        1;"
NSQ_SOURCE_LINE 00001512 "    };"
NSQ_SOURCE_LINE 00001513 "    if (!$ok) {"
NSQ_SOURCE_LINE 00001514 "        $self->_throw('mkdir', $self->[PATH], \"error creating path: $@\");"
NSQ_SOURCE_LINE 00001515 "    }"
NSQ_SOURCE_LINE 00001516 "    if ( $err && @$err ) {"
NSQ_SOURCE_LINE 00001517 "        my ( $file, $message ) = %{ $err->[0] };"
NSQ_SOURCE_LINE 00001518 "        $self->_throw('mkdir', $file, $message);"
NSQ_SOURCE_LINE 00001519 "    }"
NSQ_SOURCE_LINE 00001520 "    return $self;"
NSQ_SOURCE_LINE 00001521 "}"
NSQ_SOURCE_LINE 00001522 ""
NSQ_SOURCE_LINE 00001523 "#pod =method mkpath (deprecated)"
NSQ_SOURCE_LINE 00001524 "#pod"
NSQ_SOURCE_LINE 00001525 "#pod Like calling C<mkdir>, but returns the list of directories created or an empty list if"
NSQ_SOURCE_LINE 00001526 "#pod the directories already exist, just like C<make_path>."
NSQ_SOURCE_LINE 00001527 "#pod"
NSQ_SOURCE_LINE 00001528 "#pod Passing a defined argument I<other> than a hash reference is an error, and an"
NSQ_SOURCE_LINE 00001529 "#pod exception will be thrown."
NSQ_SOURCE_LINE 00001530 "#pod"
NSQ_SOURCE_LINE 00001531 "#pod Deprecated in 0.125."
NSQ_SOURCE_LINE 00001532 "#pod"
NSQ_SOURCE_LINE 00001533 "#pod =cut"
NSQ_SOURCE_LINE 00001534 ""
NSQ_SOURCE_LINE 00001535 "sub mkpath {"
NSQ_SOURCE_LINE 00001536 "    my ( $self, $args, @rest ) = @_;"
NSQ_SOURCE_LINE 00001537 ""
NSQ_SOURCE_LINE 00001538 "    $args = {} unless defined $args;"
NSQ_SOURCE_LINE 00001539 "    if (@rest || (defined $args && ref $args ne 'HASH')) {"
NSQ_SOURCE_LINE 00001540 "        $self->_throw('mkdir', undef, \"method argument was given, but was not a hash reference\");"
NSQ_SOURCE_LINE 00001541 "    }"
NSQ_SOURCE_LINE 00001542 ""
NSQ_SOURCE_LINE 00001543 "    my $err;"
NSQ_SOURCE_LINE 00001544 "    $args->{error} = \\$err unless defined $args->{error};"
NSQ_SOURCE_LINE 00001545 "    require File::Path;"
NSQ_SOURCE_LINE 00001546 "    my @dirs = File::Path::make_path( $self->[PATH], $args );"
NSQ_SOURCE_LINE 00001547 "    if ( $err && @$err ) {"
NSQ_SOURCE_LINE 00001548 "        my ( $file, $message ) = %{ $err->[0] };"
NSQ_SOURCE_LINE 00001549 "        Carp::croak(\"mkpath failed for $file: $message\");"
NSQ_SOURCE_LINE 00001550 "    }"
NSQ_SOURCE_LINE 00001551 "    return @dirs;"
NSQ_SOURCE_LINE 00001552 "}"
NSQ_SOURCE_LINE 00001553 ""
NSQ_SOURCE_LINE 00001554 "#pod =method move"
NSQ_SOURCE_LINE 00001555 "#pod"
NSQ_SOURCE_LINE 00001556 "#pod     path(\"foo.txt\")->move(\"bar.txt\");"
NSQ_SOURCE_LINE 00001557 "#pod"
NSQ_SOURCE_LINE 00001558 "#pod Moves the current path to the given destination using L<File::Copy>'s"
NSQ_SOURCE_LINE 00001559 "#pod C<move> function. Upon success, returns the C<Path::Tiny> object for the"
NSQ_SOURCE_LINE 00001560 "#pod newly moved file."
NSQ_SOURCE_LINE 00001561 "#pod"
NSQ_SOURCE_LINE 00001562 "#pod If the destination already exists and is a directory, and the source is not a"
NSQ_SOURCE_LINE 00001563 "#pod directory, then the source file will be renamed into the directory"
NSQ_SOURCE_LINE 00001564 "#pod specified by the destination."
NSQ_SOURCE_LINE 00001565 "#pod"
NSQ_SOURCE_LINE 00001566 "#pod If possible, move() will simply rename the file. Otherwise, it"
NSQ_SOURCE_LINE 00001567 "#pod copies the file to the new location and deletes the original. If an"
NSQ_SOURCE_LINE 00001568 "#pod error occurs during this copy-and-delete process, you may be left"
NSQ_SOURCE_LINE 00001569 "#pod with a (possibly partial) copy of the file under the destination"
NSQ_SOURCE_LINE 00001570 "#pod name."
NSQ_SOURCE_LINE 00001571 "#pod"
NSQ_SOURCE_LINE 00001572 "#pod Current API available since 0.124. Prior versions used Perl's"
NSQ_SOURCE_LINE 00001573 "#pod -built-in (and less robust) L<rename|perlfunc/rename> function"
NSQ_SOURCE_LINE 00001574 "#pod and did not return an object."
NSQ_SOURCE_LINE 00001575 "#pod"
NSQ_SOURCE_LINE 00001576 "#pod =cut"
NSQ_SOURCE_LINE 00001577 ""
NSQ_SOURCE_LINE 00001578 "sub move {"
NSQ_SOURCE_LINE 00001579 "    my ( $self, $dest ) = @_;"
NSQ_SOURCE_LINE 00001580 "    require File::Copy;"
NSQ_SOURCE_LINE 00001581 "    File::Copy::move( $self->[PATH], $dest )"
NSQ_SOURCE_LINE 00001582 "      or $self->_throw( 'move', $self->[PATH] . \"' -> '$dest\" );"
NSQ_SOURCE_LINE 00001583 ""
NSQ_SOURCE_LINE 00001584 "    return -d $dest ? _path( $dest, $self->basename ) : _path($dest);"
NSQ_SOURCE_LINE 00001585 "}"
NSQ_SOURCE_LINE 00001586 ""
NSQ_SOURCE_LINE 00001587 "#pod =method openr, openw, openrw, opena"
NSQ_SOURCE_LINE 00001588 "#pod"
NSQ_SOURCE_LINE 00001589 "#pod     $fh = path(\"foo.txt\")->openr($binmode);  # read"
NSQ_SOURCE_LINE 00001590 "#pod     $fh = path(\"foo.txt\")->openr_raw;"
NSQ_SOURCE_LINE 00001591 "#pod     $fh = path(\"foo.txt\")->openr_utf8;"
NSQ_SOURCE_LINE 00001592 "#pod"
NSQ_SOURCE_LINE 00001593 "#pod     $fh = path(\"foo.txt\")->openw($binmode);  # write"
NSQ_SOURCE_LINE 00001594 "#pod     $fh = path(\"foo.txt\")->openw_raw;"
NSQ_SOURCE_LINE 00001595 "#pod     $fh = path(\"foo.txt\")->openw_utf8;"
NSQ_SOURCE_LINE 00001596 "#pod"
NSQ_SOURCE_LINE 00001597 "#pod     $fh = path(\"foo.txt\")->opena($binmode);  # append"
NSQ_SOURCE_LINE 00001598 "#pod     $fh = path(\"foo.txt\")->opena_raw;"
NSQ_SOURCE_LINE 00001599 "#pod     $fh = path(\"foo.txt\")->opena_utf8;"
NSQ_SOURCE_LINE 00001600 "#pod"
NSQ_SOURCE_LINE 00001601 "#pod     $fh = path(\"foo.txt\")->openrw($binmode); # read/write"
NSQ_SOURCE_LINE 00001602 "#pod     $fh = path(\"foo.txt\")->openrw_raw;"
NSQ_SOURCE_LINE 00001603 "#pod     $fh = path(\"foo.txt\")->openrw_utf8;"
NSQ_SOURCE_LINE 00001604 "#pod"
NSQ_SOURCE_LINE 00001605 "#pod Returns a file handle opened in the specified mode.  The C<openr> style methods"
NSQ_SOURCE_LINE 00001606 "#pod take a single C<binmode> argument.  All of the C<open*> methods have"
NSQ_SOURCE_LINE 00001607 "#pod C<open*_raw> and C<open*_utf8> equivalents that use buffered I/O layers C<:raw>"
NSQ_SOURCE_LINE 00001608 "#pod and C<:raw:encoding(UTF-8)> (or C<:raw:utf8_strict> with"
NSQ_SOURCE_LINE 00001609 "#pod L<PerlIO::utf8_strict>)."
NSQ_SOURCE_LINE 00001610 "#pod"
NSQ_SOURCE_LINE 00001611 "#pod An optional hash reference may be used to pass options.  The only option is"
NSQ_SOURCE_LINE 00001612 "#pod C<locked>.  If true, handles opened for writing, appending or read-write are"
NSQ_SOURCE_LINE 00001613 "#pod locked with C<LOCK_EX>; otherwise, they are locked for C<LOCK_SH>."
NSQ_SOURCE_LINE 00001614 "#pod"
NSQ_SOURCE_LINE 00001615 "#pod     $fh = path(\"foo.txt\")->openrw_utf8( { locked => 1 } );"
NSQ_SOURCE_LINE 00001616 "#pod"
NSQ_SOURCE_LINE 00001617 "#pod See L</filehandle> for more on locking."
NSQ_SOURCE_LINE 00001618 "#pod"
NSQ_SOURCE_LINE 00001619 "#pod Current API available since 0.011."
NSQ_SOURCE_LINE 00001620 "#pod"
NSQ_SOURCE_LINE 00001621 "#pod =cut"
NSQ_SOURCE_LINE 00001622 ""
NSQ_SOURCE_LINE 00001623 "# map method names to corresponding open mode"
NSQ_SOURCE_LINE 00001624 "my %opens = ("
NSQ_SOURCE_LINE 00001625 "    opena  => \">>\","
NSQ_SOURCE_LINE 00001626 "    openr  => \"<\","
NSQ_SOURCE_LINE 00001627 "    openw  => \">\","
NSQ_SOURCE_LINE 00001628 "    openrw => \"+<\""
NSQ_SOURCE_LINE 00001629 ");"
NSQ_SOURCE_LINE 00001630 ""
NSQ_SOURCE_LINE 00001631 "while ( my ( $k, $v ) = each %opens ) {"
NSQ_SOURCE_LINE 00001632 "    no strict 'refs';"
NSQ_SOURCE_LINE 00001633 "    # must check for lexical IO mode hint"
NSQ_SOURCE_LINE 00001634 "    *{$k} = sub {"
NSQ_SOURCE_LINE 00001635 "        my ( $self, @args ) = @_;"
NSQ_SOURCE_LINE 00001636 "        my $args = ( @args && ref $args[0] eq 'HASH' ) ? shift @args : {};"
NSQ_SOURCE_LINE 00001637 "        $args = _get_args( $args, qw/locked/ );"
NSQ_SOURCE_LINE 00001638 "        my ($binmode) = @args;"
NSQ_SOURCE_LINE 00001639 "        $binmode = ( ( caller(0) )[10] || {} )->{ 'open' . substr( $v, -1, 1 ) }"
NSQ_SOURCE_LINE 00001640 "          unless defined $binmode;"
NSQ_SOURCE_LINE 00001641 "        $self->filehandle( $args, $v, $binmode );"
NSQ_SOURCE_LINE 00001642 "    };"
NSQ_SOURCE_LINE 00001643 "    *{ $k . \"_raw\" } = sub {"
NSQ_SOURCE_LINE 00001644 "        my ( $self, @args ) = @_;"
NSQ_SOURCE_LINE 00001645 "        my $args = ( @args && ref $args[0] eq 'HASH' ) ? shift @args : {};"
NSQ_SOURCE_LINE 00001646 "        $args = _get_args( $args, qw/locked/ );"
NSQ_SOURCE_LINE 00001647 "        $self->filehandle( $args, $v, \":raw\" );"
NSQ_SOURCE_LINE 00001648 "    };"
NSQ_SOURCE_LINE 00001649 "    *{ $k . \"_utf8\" } = sub {"
NSQ_SOURCE_LINE 00001650 "        my ( $self, @args ) = @_;"
NSQ_SOURCE_LINE 00001651 "        my $args = ( @args && ref $args[0] eq 'HASH' ) ? shift @args : {};"
NSQ_SOURCE_LINE 00001652 "        $args = _get_args( $args, qw/locked/ );"
NSQ_SOURCE_LINE 00001653 "        my $layer;"
NSQ_SOURCE_LINE 00001654 "        if ( defined($HAS_PU) ? $HAS_PU : ( $HAS_PU = _check_PU() ) ) {"
NSQ_SOURCE_LINE 00001655 "            $layer = \":raw:utf8_strict\";"
NSQ_SOURCE_LINE 00001656 "        }"
NSQ_SOURCE_LINE 00001657 "        else {"
NSQ_SOURCE_LINE 00001658 "            $layer = \":raw:encoding(UTF-8)\";"
NSQ_SOURCE_LINE 00001659 "        }"
NSQ_SOURCE_LINE 00001660 "        $self->filehandle( $args, $v, $layer );"
NSQ_SOURCE_LINE 00001661 "    };"
NSQ_SOURCE_LINE 00001662 "}"
NSQ_SOURCE_LINE 00001663 ""
NSQ_SOURCE_LINE 00001664 "#pod =method parent"
NSQ_SOURCE_LINE 00001665 "#pod"
NSQ_SOURCE_LINE 00001666 "#pod     $parent = path(\"foo/bar/baz\")->parent; # foo/bar"
NSQ_SOURCE_LINE 00001667 "#pod     $parent = path(\"foo/wibble.txt\")->parent; # foo"
NSQ_SOURCE_LINE 00001668 "#pod"
NSQ_SOURCE_LINE 00001669 "#pod     $parent = path(\"foo/bar/baz\")->parent(2); # foo"
NSQ_SOURCE_LINE 00001670 "#pod"
NSQ_SOURCE_LINE 00001671 "#pod Returns a C<Path::Tiny> object corresponding to the parent directory of the"
NSQ_SOURCE_LINE 00001672 "#pod original directory or file. An optional positive integer argument is the number"
NSQ_SOURCE_LINE 00001673 "#pod of parent directories upwards to return.  C<parent> by itself is equivalent to"
NSQ_SOURCE_LINE 00001674 "#pod C<parent(1)>."
NSQ_SOURCE_LINE 00001675 "#pod"
NSQ_SOURCE_LINE 00001676 "#pod Current API available since 0.014."
NSQ_SOURCE_LINE 00001677 "#pod"
NSQ_SOURCE_LINE 00001678 "#pod =cut"
NSQ_SOURCE_LINE 00001679 ""
NSQ_SOURCE_LINE 00001680 "# XXX this is ugly and coverage is incomplete.  I think it's there for windows"
NSQ_SOURCE_LINE 00001681 "# so need to check coverage there and compare"
NSQ_SOURCE_LINE 00001682 "sub parent {"
NSQ_SOURCE_LINE 00001683 "    my ( $self, $level ) = @_;"
NSQ_SOURCE_LINE 00001684 "    $level = 1 unless defined $level && $level > 0;"
NSQ_SOURCE_LINE 00001685 "    $self->_splitpath unless defined $self->[FILE];"
NSQ_SOURCE_LINE 00001686 "    my $parent;"
NSQ_SOURCE_LINE 00001687 "    if ( length $self->[FILE] ) {"
NSQ_SOURCE_LINE 00001688 "        if ( $self->[FILE] eq '.' || $self->[FILE] eq \"..\" ) {"
NSQ_SOURCE_LINE 00001689 "            $parent = _path( $self->[PATH] . \"/..\" );"
NSQ_SOURCE_LINE 00001690 "        }"
NSQ_SOURCE_LINE 00001691 "        else {"
NSQ_SOURCE_LINE 00001692 "            $parent = _path( _non_empty( $self->[VOL] . $self->[DIR] ) );"
NSQ_SOURCE_LINE 00001693 "        }"
NSQ_SOURCE_LINE 00001694 "    }"
NSQ_SOURCE_LINE 00001695 "    elsif ( length $self->[DIR] ) {"
NSQ_SOURCE_LINE 00001696 "        # because of symlinks, any internal updir requires us to"
NSQ_SOURCE_LINE 00001697 "        # just add more updirs at the end"
NSQ_SOURCE_LINE 00001698 "        if ( $self->[DIR] =~ m{(?:^\\.\\./|/\\.\\./|/\\.\\.\\z)} ) {"
NSQ_SOURCE_LINE 00001699 "            $parent = _path( $self->[VOL] . $self->[DIR] . \"/..\" );"
NSQ_SOURCE_LINE 00001700 "        }"
NSQ_SOURCE_LINE 00001701 "        else {"
NSQ_SOURCE_LINE 00001702 "            ( my $dir = $self->[DIR] ) =~ s{/[^\\/]+/\\z}{/};"
NSQ_SOURCE_LINE 00001703 "            $parent = _path( $self->[VOL] . $dir );"
NSQ_SOURCE_LINE 00001704 "        }"
NSQ_SOURCE_LINE 00001705 "    }"
NSQ_SOURCE_LINE 00001706 "    else {"
NSQ_SOURCE_LINE 00001707 "        $parent = _path( _non_empty( $self->[VOL] ) );"
NSQ_SOURCE_LINE 00001708 "    }"
NSQ_SOURCE_LINE 00001709 "    return $level == 1 ? $parent : $parent->parent( $level - 1 );"
NSQ_SOURCE_LINE 00001710 "}"
NSQ_SOURCE_LINE 00001711 ""
NSQ_SOURCE_LINE 00001712 "sub _non_empty {"
NSQ_SOURCE_LINE 00001713 "    my ($string) = shift;"
NSQ_SOURCE_LINE 00001714 "    return ( ( defined($string) && length($string) ) ? $string : \".\" );"
NSQ_SOURCE_LINE 00001715 "}"
NSQ_SOURCE_LINE 00001716 ""
NSQ_SOURCE_LINE 00001717 "#pod =method realpath"
NSQ_SOURCE_LINE 00001718 "#pod"
NSQ_SOURCE_LINE 00001719 "#pod     $real = path(\"/baz/foo/../bar\")->realpath;"
NSQ_SOURCE_LINE 00001720 "#pod     $real = path(\"foo/../bar\")->realpath;"
NSQ_SOURCE_LINE 00001721 "#pod"
NSQ_SOURCE_LINE 00001722 "#pod Returns a new C<Path::Tiny> object with all symbolic links and upward directory"
NSQ_SOURCE_LINE 00001723 "#pod parts resolved using L<Cwd>'s C<realpath>.  Compared to C<absolute>, this is"
NSQ_SOURCE_LINE 00001724 "#pod more expensive as it must actually consult the filesystem."
NSQ_SOURCE_LINE 00001725 "#pod"
NSQ_SOURCE_LINE 00001726 "#pod If the parent path can't be resolved (e.g. if it includes directories that"
NSQ_SOURCE_LINE 00001727 "#pod don't exist), an exception will be thrown:"
NSQ_SOURCE_LINE 00001728 "#pod"
NSQ_SOURCE_LINE 00001729 "#pod     $real = path(\"doesnt_exist/foo\")->realpath; # dies"
NSQ_SOURCE_LINE 00001730 "#pod"
NSQ_SOURCE_LINE 00001731 "#pod However, if the parent path exists and only the last component (e.g. filename)"
NSQ_SOURCE_LINE 00001732 "#pod doesn't exist, the realpath will be the realpath of the parent plus the"
NSQ_SOURCE_LINE 00001733 "#pod non-existent last component:"
NSQ_SOURCE_LINE 00001734 "#pod"
NSQ_SOURCE_LINE 00001735 "#pod     $real = path(\"./aasdlfasdlf\")->realpath; # works"
NSQ_SOURCE_LINE 00001736 "#pod"
NSQ_SOURCE_LINE 00001737 "#pod The underlying L<Cwd> module usually worked this way on Unix, but died on"
NSQ_SOURCE_LINE 00001738 "#pod Windows (and some Unixes) if the full path didn't exist.  As of version 0.064,"
NSQ_SOURCE_LINE 00001739 "#pod it's safe to use anywhere."
NSQ_SOURCE_LINE 00001740 "#pod"
NSQ_SOURCE_LINE 00001741 "#pod Current API available since 0.001."
NSQ_SOURCE_LINE 00001742 "#pod"
NSQ_SOURCE_LINE 00001743 "#pod =cut"
NSQ_SOURCE_LINE 00001744 ""
NSQ_SOURCE_LINE 00001745 "# Win32 and some Unixes need parent path resolved separately so realpath"
NSQ_SOURCE_LINE 00001746 "# doesn't throw an error resolving non-existent basename"
NSQ_SOURCE_LINE 00001747 "sub realpath {"
NSQ_SOURCE_LINE 00001748 "    my $self = shift;"
NSQ_SOURCE_LINE 00001749 "    $self = $self->_resolve_symlinks;"
NSQ_SOURCE_LINE 00001750 "    require Cwd;"
NSQ_SOURCE_LINE 00001751 "    $self->_splitpath if !defined $self->[FILE];"
NSQ_SOURCE_LINE 00001752 "    my $check_parent ="
NSQ_SOURCE_LINE 00001753 "      length $self->[FILE] && $self->[FILE] ne '.' && $self->[FILE] ne '..';"
NSQ_SOURCE_LINE 00001754 "    my $realpath = eval {"
NSQ_SOURCE_LINE 00001755 "        # pure-perl Cwd can carp"
NSQ_SOURCE_LINE 00001756 "        local $SIG{__WARN__} = sub { };"
NSQ_SOURCE_LINE 00001757 "        Cwd::realpath( $check_parent ? $self->parent->[PATH] : $self->[PATH] );"
NSQ_SOURCE_LINE 00001758 "    };"
NSQ_SOURCE_LINE 00001759 "    # parent realpath must exist; not all Cwd::realpath will error if it doesn't"
NSQ_SOURCE_LINE 00001760 "    $self->_throw(\"resolving realpath\")"
NSQ_SOURCE_LINE 00001761 "      unless defined $realpath && length $realpath && -e $realpath;"
NSQ_SOURCE_LINE 00001762 "    return ( $check_parent ? _path( $realpath, $self->[FILE] ) : _path($realpath) );"
NSQ_SOURCE_LINE 00001763 "}"
NSQ_SOURCE_LINE 00001764 ""
NSQ_SOURCE_LINE 00001765 "#pod =method relative"
NSQ_SOURCE_LINE 00001766 "#pod"
NSQ_SOURCE_LINE 00001767 "#pod     $rel = path(\"/tmp/foo/bar\")->relative(\"/tmp\"); # foo/bar"
NSQ_SOURCE_LINE 00001768 "#pod"
NSQ_SOURCE_LINE 00001769 "#pod Returns a C<Path::Tiny> object with a path relative to a new base path"
NSQ_SOURCE_LINE 00001770 "#pod given as an argument.  If no argument is given, the current directory will"
NSQ_SOURCE_LINE 00001771 "#pod be used as the new base path."
NSQ_SOURCE_LINE 00001772 "#pod"
NSQ_SOURCE_LINE 00001773 "#pod If either path is already relative, it will be made absolute based on the"
NSQ_SOURCE_LINE 00001774 "#pod current directly before determining the new relative path."
NSQ_SOURCE_LINE 00001775 "#pod"
NSQ_SOURCE_LINE 00001776 "#pod The algorithm is roughly as follows:"
NSQ_SOURCE_LINE 00001777 "#pod"
NSQ_SOURCE_LINE 00001778 "#pod =for :list"
NSQ_SOURCE_LINE 00001779 "#pod * If the original and new base path are on different volumes, an exception"
NSQ_SOURCE_LINE 00001780 "#pod   will be thrown."
NSQ_SOURCE_LINE 00001781 "#pod * If the original and new base are identical, the relative path is C<\".\">."
NSQ_SOURCE_LINE 00001782 "#pod * If the new base subsumes the original, the relative path is the original"
NSQ_SOURCE_LINE 00001783 "#pod   path with the new base chopped off the front"
NSQ_SOURCE_LINE 00001784 "#pod * If the new base does not subsume the original, a common prefix path is"
NSQ_SOURCE_LINE 00001785 "#pod   determined (possibly the root directory) and the relative path will"
NSQ_SOURCE_LINE 00001786 "#pod   consist of updirs (C<\"..\">) to reach the common prefix, followed by the"
NSQ_SOURCE_LINE 00001787 "#pod   original path less the common prefix."
NSQ_SOURCE_LINE 00001788 "#pod"
NSQ_SOURCE_LINE 00001789 "#pod Unlike C<File::Spec::abs2rel>, in the last case above, the calculation based"
NSQ_SOURCE_LINE 00001790 "#pod on a common prefix takes into account symlinks that could affect the updir"
NSQ_SOURCE_LINE 00001791 "#pod process.  Given an original path \"/A/B\" and a new base \"/A/C\","
NSQ_SOURCE_LINE 00001792 "#pod (where \"A\", \"B\" and \"C\" could each have multiple path components):"
NSQ_SOURCE_LINE 00001793 "#pod"
NSQ_SOURCE_LINE 00001794 "#pod =for :list"
NSQ_SOURCE_LINE 00001795 "#pod * Symlinks in \"A\" don't change the result unless the last component of A is"
NSQ_SOURCE_LINE 00001796 "#pod   a symlink and the first component of \"C\" is an updir."
NSQ_SOURCE_LINE 00001797 "#pod * Symlinks in \"B\" don't change the result and will exist in the result as"
NSQ_SOURCE_LINE 00001798 "#pod   given."
NSQ_SOURCE_LINE 00001799 "#pod * Symlinks and updirs in \"C\" must be resolved to actual paths, taking into"
NSQ_SOURCE_LINE 00001800 "#pod   account the possibility that not all path components might exist on the"
NSQ_SOURCE_LINE 00001801 "#pod   filesystem."
NSQ_SOURCE_LINE 00001802 "#pod"
NSQ_SOURCE_LINE 00001803 "#pod Current API available since 0.001.  New algorithm (that accounts for"
NSQ_SOURCE_LINE 00001804 "#pod symlinks) available since 0.079."
NSQ_SOURCE_LINE 00001805 "#pod"
NSQ_SOURCE_LINE 00001806 "#pod =cut"
NSQ_SOURCE_LINE 00001807 ""
NSQ_SOURCE_LINE 00001808 "sub relative {"
NSQ_SOURCE_LINE 00001809 "    my ( $self, $base ) = @_;"
NSQ_SOURCE_LINE 00001810 "    $base = _path( defined $base && length $base ? $base : '.' );"
NSQ_SOURCE_LINE 00001811 ""
NSQ_SOURCE_LINE 00001812 "    # relative paths must be converted to absolute first"
NSQ_SOURCE_LINE 00001813 "    $self = $self->absolute if $self->is_relative;"
NSQ_SOURCE_LINE 00001814 "    $base = $base->absolute if $base->is_relative;"
NSQ_SOURCE_LINE 00001815 ""
NSQ_SOURCE_LINE 00001816 "    # normalize volumes if they exist"
NSQ_SOURCE_LINE 00001817 "    $self = $self->absolute if !length $self->volume && length $base->volume;"
NSQ_SOURCE_LINE 00001818 "    $base = $base->absolute if length $self->volume  && !length $base->volume;"
NSQ_SOURCE_LINE 00001819 ""
NSQ_SOURCE_LINE 00001820 "    # can't make paths relative across volumes"
NSQ_SOURCE_LINE 00001821 "    if ( !_same( $self->volume, $base->volume ) ) {"
NSQ_SOURCE_LINE 00001822 "        Carp::croak(\"relative() can't cross volumes: '$self' vs '$base'\");"
NSQ_SOURCE_LINE 00001823 "    }"
NSQ_SOURCE_LINE 00001824 ""
NSQ_SOURCE_LINE 00001825 "    # if same absolute path, relative is current directory"
NSQ_SOURCE_LINE 00001826 "    return _path(\".\") if _same( $self->[PATH], $base->[PATH] );"
NSQ_SOURCE_LINE 00001827 ""
NSQ_SOURCE_LINE 00001828 "    # if base is a prefix of self, chop prefix off self"
NSQ_SOURCE_LINE 00001829 "    if ( $base->subsumes($self) ) {"
NSQ_SOURCE_LINE 00001830 "        $base = \"\" if $base->is_rootdir;"
NSQ_SOURCE_LINE 00001831 "        my $relative = \"$self\";"
NSQ_SOURCE_LINE 00001832 "        $relative =~ s{\\A\\Q$base/}{};"
NSQ_SOURCE_LINE 00001833 "        return _path(\".\", $relative);"
NSQ_SOURCE_LINE 00001834 "    }"
NSQ_SOURCE_LINE 00001835 ""
NSQ_SOURCE_LINE 00001836 "    # base is not a prefix, so must find a common prefix (even if root)"
NSQ_SOURCE_LINE 00001837 "    my ( @common, @self_parts, @base_parts );"
NSQ_SOURCE_LINE 00001838 "    @base_parts = split /\\//, $base->_just_filepath;"
NSQ_SOURCE_LINE 00001839 ""
NSQ_SOURCE_LINE 00001840 "    # if self is rootdir, then common directory is root (shown as empty"
NSQ_SOURCE_LINE 00001841 "    # string for later joins); otherwise, must be computed from path parts."
NSQ_SOURCE_LINE 00001842 "    if ( $self->is_rootdir ) {"
NSQ_SOURCE_LINE 00001843 "        @common = (\"\");"
NSQ_SOURCE_LINE 00001844 "        shift @base_parts;"
NSQ_SOURCE_LINE 00001845 "    }"
NSQ_SOURCE_LINE 00001846 "    else {"
NSQ_SOURCE_LINE 00001847 "        @self_parts = split /\\//, $self->_just_filepath;"
NSQ_SOURCE_LINE 00001848 ""
NSQ_SOURCE_LINE 00001849 "        while ( @self_parts && @base_parts && _same( $self_parts[0], $base_parts[0] ) ) {"
NSQ_SOURCE_LINE 00001850 "            push @common, shift @base_parts;"
NSQ_SOURCE_LINE 00001851 "            shift @self_parts;"
NSQ_SOURCE_LINE 00001852 "        }"
NSQ_SOURCE_LINE 00001853 "    }"
NSQ_SOURCE_LINE 00001854 ""
NSQ_SOURCE_LINE 00001855 "    # if there are any symlinks from common to base, we have a problem, as"
NSQ_SOURCE_LINE 00001856 "    # you can't guarantee that updir from base reaches the common prefix;"
NSQ_SOURCE_LINE 00001857 "    # we must resolve symlinks and try again; likewise, any updirs are"
NSQ_SOURCE_LINE 00001858 "    # a problem as it throws off calculation of updirs needed to get from"
NSQ_SOURCE_LINE 00001859 "    # self's path to the common prefix."
NSQ_SOURCE_LINE 00001860 "    if ( my $new_base = $self->_resolve_between( \\@common, \\@base_parts ) ) {"
NSQ_SOURCE_LINE 00001861 "        return $self->relative($new_base);"
NSQ_SOURCE_LINE 00001862 "    }"
NSQ_SOURCE_LINE 00001863 ""
NSQ_SOURCE_LINE 00001864 "    # otherwise, symlinks in common or from common to A don't matter as"
NSQ_SOURCE_LINE 00001865 "    # those don't involve updirs"
NSQ_SOURCE_LINE 00001866 "    my @new_path = ( (\"..\") x ( 0+ @base_parts ), @self_parts );"
NSQ_SOURCE_LINE 00001867 "    return _path(@new_path);"
NSQ_SOURCE_LINE 00001868 "}"
NSQ_SOURCE_LINE 00001869 ""
NSQ_SOURCE_LINE 00001870 "sub _just_filepath {"
NSQ_SOURCE_LINE 00001871 "    my $self     = shift;"
NSQ_SOURCE_LINE 00001872 "    my $self_vol = $self->volume;"
NSQ_SOURCE_LINE 00001873 "    return \"$self\" if !length $self_vol;"
NSQ_SOURCE_LINE 00001874 ""
NSQ_SOURCE_LINE 00001875 "    ( my $self_path = \"$self\" ) =~ s{\\A\\Q$self_vol}{};"
NSQ_SOURCE_LINE 00001876 ""
NSQ_SOURCE_LINE 00001877 "    return $self_path;"
NSQ_SOURCE_LINE 00001878 "}"
NSQ_SOURCE_LINE 00001879 ""
NSQ_SOURCE_LINE 00001880 "sub _resolve_between {"
NSQ_SOURCE_LINE 00001881 "    my ( $self, $common, $base ) = @_;"
NSQ_SOURCE_LINE 00001882 "    my $path = $self->volume . join( \"/\", @$common );"
NSQ_SOURCE_LINE 00001883 "    my $changed = 0;"
NSQ_SOURCE_LINE 00001884 "    for my $p (@$base) {"
NSQ_SOURCE_LINE 00001885 "        $path .= \"/$p\";"
NSQ_SOURCE_LINE 00001886 "        if ( $p eq '..' ) {"
NSQ_SOURCE_LINE 00001887 "            $changed = 1;"
NSQ_SOURCE_LINE 00001888 "            if ( -e $path ) {"
NSQ_SOURCE_LINE 00001889 "                $path = _path($path)->realpath->[PATH];"
NSQ_SOURCE_LINE 00001890 "            }"
NSQ_SOURCE_LINE 00001891 "            else {"
NSQ_SOURCE_LINE 00001892 "                $path =~ s{/[^/]+/..\\z}{/};"
NSQ_SOURCE_LINE 00001893 "            }"
NSQ_SOURCE_LINE 00001894 "        }"
NSQ_SOURCE_LINE 00001895 "        if ( -l $path ) {"
NSQ_SOURCE_LINE 00001896 "            $changed = 1;"
NSQ_SOURCE_LINE 00001897 "            $path    = _path($path)->realpath->[PATH];"
NSQ_SOURCE_LINE 00001898 "        }"
NSQ_SOURCE_LINE 00001899 "    }"
NSQ_SOURCE_LINE 00001900 "    return $changed ? _path($path) : undef;"
NSQ_SOURCE_LINE 00001901 "}"
NSQ_SOURCE_LINE 00001902 ""
NSQ_SOURCE_LINE 00001903 "#pod =method remove"
NSQ_SOURCE_LINE 00001904 "#pod"
NSQ_SOURCE_LINE 00001905 "#pod     path(\"foo.txt\")->remove;"
NSQ_SOURCE_LINE 00001906 "#pod"
NSQ_SOURCE_LINE 00001907 "#pod This is just like C<unlink>, except for its error handling: if the path does"
NSQ_SOURCE_LINE 00001908 "#pod not exist, it returns false; if deleting the file fails, it throws an"
NSQ_SOURCE_LINE 00001909 "#pod exception."
NSQ_SOURCE_LINE 00001910 "#pod"
NSQ_SOURCE_LINE 00001911 "#pod Current API available since 0.012."
NSQ_SOURCE_LINE 00001912 "#pod"
NSQ_SOURCE_LINE 00001913 "#pod =cut"
NSQ_SOURCE_LINE 00001914 ""
NSQ_SOURCE_LINE 00001915 "sub remove {"
NSQ_SOURCE_LINE 00001916 "    my $self = shift;"
NSQ_SOURCE_LINE 00001917 ""
NSQ_SOURCE_LINE 00001918 "    return 0 if !-e $self->[PATH] && !-l $self->[PATH];"
NSQ_SOURCE_LINE 00001919 ""
NSQ_SOURCE_LINE 00001920 "    return unlink( $self->[PATH] ) || $self->_throw('unlink');"
NSQ_SOURCE_LINE 00001921 "}"
NSQ_SOURCE_LINE 00001922 ""
NSQ_SOURCE_LINE 00001923 "#pod =method remove_tree"
NSQ_SOURCE_LINE 00001924 "#pod"
NSQ_SOURCE_LINE 00001925 "#pod     # directory"
NSQ_SOURCE_LINE 00001926 "#pod     path(\"foo/bar/baz\")->remove_tree;"
NSQ_SOURCE_LINE 00001927 "#pod     path(\"foo/bar/baz\")->remove_tree( \\%options );"
NSQ_SOURCE_LINE 00001928 "#pod     path(\"foo/bar/baz\")->remove_tree( { safe => 0 } ); # force remove"
NSQ_SOURCE_LINE 00001929 "#pod"
NSQ_SOURCE_LINE 00001930 "#pod Like calling C<remove_tree> from L<File::Path>, but defaults to C<safe> mode."
NSQ_SOURCE_LINE 00001931 "#pod An optional hash reference is passed through to C<remove_tree>.  Errors will be"
NSQ_SOURCE_LINE 00001932 "#pod trapped and an exception thrown.  Returns the number of directories deleted,"
NSQ_SOURCE_LINE 00001933 "#pod just like C<remove_tree>."
NSQ_SOURCE_LINE 00001934 "#pod"
NSQ_SOURCE_LINE 00001935 "#pod If you want to remove a directory only if it is empty, use the built-in"
NSQ_SOURCE_LINE 00001936 "#pod C<rmdir> function instead."
NSQ_SOURCE_LINE 00001937 "#pod"
NSQ_SOURCE_LINE 00001938 "#pod     rmdir path(\"foo/bar/baz/\");"
NSQ_SOURCE_LINE 00001939 "#pod"
NSQ_SOURCE_LINE 00001940 "#pod Current API available since 0.013."
NSQ_SOURCE_LINE 00001941 "#pod"
NSQ_SOURCE_LINE 00001942 "#pod Passing a defined argument I<other> than a hash reference is an error, and an"
NSQ_SOURCE_LINE 00001943 "#pod exception will be thrown."
NSQ_SOURCE_LINE 00001944 "#pod"
NSQ_SOURCE_LINE 00001945 "#pod =cut"
NSQ_SOURCE_LINE 00001946 ""
NSQ_SOURCE_LINE 00001947 "sub remove_tree {"
NSQ_SOURCE_LINE 00001948 "    my ( $self, $args, @rest ) = @_;"
NSQ_SOURCE_LINE 00001949 ""
NSQ_SOURCE_LINE 00001950 "    $args = {} unless defined $args;"
NSQ_SOURCE_LINE 00001951 "    if (@rest || (defined $args && ref $args ne 'HASH')) {"
NSQ_SOURCE_LINE 00001952 "        $self->_throw('mkdir', undef, \"method argument was given, but was not a hash reference\");"
NSQ_SOURCE_LINE 00001953 "    }"
NSQ_SOURCE_LINE 00001954 ""
NSQ_SOURCE_LINE 00001955 "    return 0 if !-e $self->[PATH] && !-l $self->[PATH];"
NSQ_SOURCE_LINE 00001956 ""
NSQ_SOURCE_LINE 00001957 "    my $err;"
NSQ_SOURCE_LINE 00001958 "    $args->{error} = \\$err unless defined $args->{error};"
NSQ_SOURCE_LINE 00001959 "    $args->{safe}  = 1     unless defined $args->{safe};"
NSQ_SOURCE_LINE 00001960 "    require File::Path;"
NSQ_SOURCE_LINE 00001961 "    my $count = File::Path::remove_tree( $self->[PATH], $args );"
NSQ_SOURCE_LINE 00001962 ""
NSQ_SOURCE_LINE 00001963 "    if ( $err && @$err ) {"
NSQ_SOURCE_LINE 00001964 "        my ( $file, $message ) = %{ $err->[0] };"
NSQ_SOURCE_LINE 00001965 "        Carp::croak(\"remove_tree failed for $file: $message\");"
NSQ_SOURCE_LINE 00001966 "    }"
NSQ_SOURCE_LINE 00001967 "    return $count;"
NSQ_SOURCE_LINE 00001968 "}"
NSQ_SOURCE_LINE 00001969 ""
NSQ_SOURCE_LINE 00001970 "#pod =method sibling"
NSQ_SOURCE_LINE 00001971 "#pod"
NSQ_SOURCE_LINE 00001972 "#pod     $foo = path(\"/tmp/foo.txt\");"
NSQ_SOURCE_LINE 00001973 "#pod     $sib = $foo->sibling(\"bar.txt\");        # /tmp/bar.txt"
NSQ_SOURCE_LINE 00001974 "#pod     $sib = $foo->sibling(\"baz\", \"bam.txt\"); # /tmp/baz/bam.txt"
NSQ_SOURCE_LINE 00001975 "#pod"
NSQ_SOURCE_LINE 00001976 "#pod Returns a new C<Path::Tiny> object relative to the parent of the original."
NSQ_SOURCE_LINE 00001977 "#pod This is slightly more efficient than C<< $path->parent->child(...) >>."
NSQ_SOURCE_LINE 00001978 "#pod"
NSQ_SOURCE_LINE 00001979 "#pod Current API available since 0.058."
NSQ_SOURCE_LINE 00001980 "#pod"
NSQ_SOURCE_LINE 00001981 "#pod =cut"
NSQ_SOURCE_LINE 00001982 ""
NSQ_SOURCE_LINE 00001983 "sub sibling {"
NSQ_SOURCE_LINE 00001984 "    my $self = shift;"
NSQ_SOURCE_LINE 00001985 "    return _path( $self->parent->[PATH], @_ );"
NSQ_SOURCE_LINE 00001986 "}"
NSQ_SOURCE_LINE 00001987 ""
NSQ_SOURCE_LINE 00001988 "#pod =method size, size_human"
NSQ_SOURCE_LINE 00001989 "#pod"
NSQ_SOURCE_LINE 00001990 "#pod     my $p = path(\"foo\"); # with size 1025 bytes"
NSQ_SOURCE_LINE 00001991 "#pod"
NSQ_SOURCE_LINE 00001992 "#pod     $p->size;                            # \"1025\""
NSQ_SOURCE_LINE 00001993 "#pod     $p->size_human;                      # \"1.1 K\""
NSQ_SOURCE_LINE 00001994 "#pod     $p->size_human( {format => \"iec\"} ); # \"1.1 KiB\""
NSQ_SOURCE_LINE 00001995 "#pod"
NSQ_SOURCE_LINE 00001996 "#pod Returns the size of a file.  The C<size> method is just a wrapper around C<-s>."
NSQ_SOURCE_LINE 00001997 "#pod"
NSQ_SOURCE_LINE 00001998 "#pod The C<size_human> method provides a human-readable string similar to"
NSQ_SOURCE_LINE 00001999 "#pod C<ls -lh>.  Like C<ls>, it rounds upwards and provides one decimal place for"
NSQ_SOURCE_LINE 00002000 "#pod single-digit sizes and no decimal places for larger sizes.  The only available"
NSQ_SOURCE_LINE 00002001 "#pod option is C<format>, which has three valid values:"
NSQ_SOURCE_LINE 00002002 "#pod"
NSQ_SOURCE_LINE 00002003 "#pod =for :list"
NSQ_SOURCE_LINE 00002004 "#pod * 'ls' (the default): base-2 sizes, with C<ls> style single-letter suffixes (K, M, etc.)"
NSQ_SOURCE_LINE 00002005 "#pod * 'iec': base-2 sizes, with IEC binary suffixes (KiB, MiB, etc.)"
NSQ_SOURCE_LINE 00002006 "#pod * 'si': base-10 sizes, with SI decimal suffixes (kB, MB, etc.)"
NSQ_SOURCE_LINE 00002007 "#pod"
NSQ_SOURCE_LINE 00002008 "#pod If C<-s> would return C<undef>, C<size_human> returns the empty string."
NSQ_SOURCE_LINE 00002009 "#pod"
NSQ_SOURCE_LINE 00002010 "#pod Current API available since 0.122."
NSQ_SOURCE_LINE 00002011 "#pod"
NSQ_SOURCE_LINE 00002012 "#pod =cut"
NSQ_SOURCE_LINE 00002013 ""
NSQ_SOURCE_LINE 00002014 "sub size { -s $_[0]->[PATH] }"
NSQ_SOURCE_LINE 00002015 ""
NSQ_SOURCE_LINE 00002016 "my %formats = ("
NSQ_SOURCE_LINE 00002017 "    'ls'  => [ 1024, log(1024), [ \"\", map { \" $_\" } qw/K M G T/ ] ],"
NSQ_SOURCE_LINE 00002018 "    'iec' => [ 1024, log(1024), [ \"\", map { \" $_\" } qw/KiB MiB GiB TiB/ ] ],"
NSQ_SOURCE_LINE 00002019 "    'si'  => [ 1000, log(1000), [ \"\", map { \" $_\" } qw/kB MB GB TB/ ] ],"
NSQ_SOURCE_LINE 00002020 ");"
NSQ_SOURCE_LINE 00002021 ""
NSQ_SOURCE_LINE 00002022 "sub _formats { return $formats{$_[0]} }"
NSQ_SOURCE_LINE 00002023 ""
NSQ_SOURCE_LINE 00002024 "sub size_human {"
NSQ_SOURCE_LINE 00002025 "    my $self     = shift;"
NSQ_SOURCE_LINE 00002026 "    my $args     = _get_args( shift, qw/format/ );"
NSQ_SOURCE_LINE 00002027 "    my $format   = defined $args->{format} ? $args->{format} : \"ls\";"
NSQ_SOURCE_LINE 00002028 "    my $fmt_opts = $formats{$format}"
NSQ_SOURCE_LINE 00002029 "      or Carp::croak(\"Invalid format '$format' for size_human()\");"
NSQ_SOURCE_LINE 00002030 "    my $size = -s $self->[PATH];"
NSQ_SOURCE_LINE 00002031 "    return defined $size ? _human_size( $size, @$fmt_opts ) : \"\";"
NSQ_SOURCE_LINE 00002032 "}"
NSQ_SOURCE_LINE 00002033 ""
NSQ_SOURCE_LINE 00002034 "sub _ceil {"
NSQ_SOURCE_LINE 00002035 "    return $_[0] == int($_[0]) ? $_[0] : int($_[0]+1);"
NSQ_SOURCE_LINE 00002036 "}"
NSQ_SOURCE_LINE 00002037 ""
NSQ_SOURCE_LINE 00002038 "sub _human_size {"
NSQ_SOURCE_LINE 00002039 "    my ( $size, $base, $log_base, $suffixes ) = @_;"
NSQ_SOURCE_LINE 00002040 "    return \"0\" if $size == 0;"
NSQ_SOURCE_LINE 00002041 ""
NSQ_SOURCE_LINE 00002042 "    my $mag = int( log($size) / $log_base );"
NSQ_SOURCE_LINE 00002043 "    $size /= $base**$mag;"
NSQ_SOURCE_LINE 00002044 "    $size ="
NSQ_SOURCE_LINE 00002045 "        $mag == 0               ? $size"
NSQ_SOURCE_LINE 00002046 "      : length( int($size) ) == 1 ? _ceil( $size * 10 ) / 10"
NSQ_SOURCE_LINE 00002047 "      :                             _ceil($size);"
NSQ_SOURCE_LINE 00002048 "    if ( $size >= $base ) {"
NSQ_SOURCE_LINE 00002049 "        $size /= $base;"
NSQ_SOURCE_LINE 00002050 "        $mag++;"
NSQ_SOURCE_LINE 00002051 "    }"
NSQ_SOURCE_LINE 00002052 ""
NSQ_SOURCE_LINE 00002053 "    my $fmt = ( $mag == 0 || length( int($size) ) > 1 ) ? \"%.0f%s\" : \"%.1f%s\";"
NSQ_SOURCE_LINE 00002054 "    return sprintf( $fmt, $size, $suffixes->[$mag] );"
NSQ_SOURCE_LINE 00002055 "}"
NSQ_SOURCE_LINE 00002056 ""
NSQ_SOURCE_LINE 00002057 "#pod =method slurp, slurp_raw, slurp_utf8"
NSQ_SOURCE_LINE 00002058 "#pod"
NSQ_SOURCE_LINE 00002059 "#pod     $data = path(\"foo.txt\")->slurp;"
NSQ_SOURCE_LINE 00002060 "#pod     $data = path(\"foo.txt\")->slurp( {binmode => \":raw\"} );"
NSQ_SOURCE_LINE 00002061 "#pod     $data = path(\"foo.txt\")->slurp_raw;"
NSQ_SOURCE_LINE 00002062 "#pod     $data = path(\"foo.txt\")->slurp_utf8;"
NSQ_SOURCE_LINE 00002063 "#pod"
NSQ_SOURCE_LINE 00002064 "#pod Reads file contents into a scalar.  Takes an optional hash reference which may"
NSQ_SOURCE_LINE 00002065 "#pod be used to pass options.  The only available option is C<binmode>, which is"
NSQ_SOURCE_LINE 00002066 "#pod passed to C<binmode()> on the handle used for reading."
NSQ_SOURCE_LINE 00002067 "#pod"
NSQ_SOURCE_LINE 00002068 "#pod C<slurp_raw> is like C<slurp> with a C<binmode> of C<:unix> for"
NSQ_SOURCE_LINE 00002069 "#pod a fast, unbuffered, raw read."
NSQ_SOURCE_LINE 00002070 "#pod"
NSQ_SOURCE_LINE 00002071 "#pod C<slurp_utf8> is like C<slurp> with a C<binmode> of"
NSQ_SOURCE_LINE 00002072 "#pod C<:unix:encoding(UTF-8)> (or C<:unix:utf8_strict> with"
NSQ_SOURCE_LINE 00002073 "#pod L<PerlIO::utf8_strict>).  If L<Unicode::UTF8> 0.58+ is installed, a"
NSQ_SOURCE_LINE 00002074 "#pod unbuffered, raw slurp will be done instead and the result decoded with"
NSQ_SOURCE_LINE 00002075 "#pod C<Unicode::UTF8>. This is just as strict and is roughly an order of"
NSQ_SOURCE_LINE 00002076 "#pod magnitude faster than using C<:encoding(UTF-8)>."
NSQ_SOURCE_LINE 00002077 "#pod"
NSQ_SOURCE_LINE 00002078 "#pod B<Note>: C<slurp> and friends lock the filehandle before slurping.  If"
NSQ_SOURCE_LINE 00002079 "#pod you plan to slurp from a file created with L<File::Temp>, be sure to"
NSQ_SOURCE_LINE 00002080 "#pod close other handles or open without locking to avoid a deadlock:"
NSQ_SOURCE_LINE 00002081 "#pod"
NSQ_SOURCE_LINE 00002082 "#pod     my $tempfile = File::Temp->new(EXLOCK => 0);"
NSQ_SOURCE_LINE 00002083 "#pod     my $guts = path($tempfile)->slurp;"
NSQ_SOURCE_LINE 00002084 "#pod"
NSQ_SOURCE_LINE 00002085 "#pod See also L</lines> if you want to slurp a file into a line array."
NSQ_SOURCE_LINE 00002086 "#pod"
NSQ_SOURCE_LINE 00002087 "#pod Current API available since 0.004."
NSQ_SOURCE_LINE 00002088 "#pod"
NSQ_SOURCE_LINE 00002089 "#pod =cut"
NSQ_SOURCE_LINE 00002090 ""
NSQ_SOURCE_LINE 00002091 "sub slurp {"
NSQ_SOURCE_LINE 00002092 "    my $self    = shift;"
NSQ_SOURCE_LINE 00002093 "    my $args    = _get_args( shift, qw/binmode/ );"
NSQ_SOURCE_LINE 00002094 "    my $binmode = $args->{binmode};"
NSQ_SOURCE_LINE 00002095 "    $binmode = ( ( caller(0) )[10] || {} )->{'open<'} unless defined $binmode;"
NSQ_SOURCE_LINE 00002096 "    my $fh = $self->filehandle( { locked => 1 }, \"<\", $binmode );"
NSQ_SOURCE_LINE 00002097 "    if ( ( defined($binmode) ? $binmode : \"\" ) eq \":unix\""
NSQ_SOURCE_LINE 00002098 "        and my $size = -s $fh )"
NSQ_SOURCE_LINE 00002099 "    {"
NSQ_SOURCE_LINE 00002100 "        my $buf;"
NSQ_SOURCE_LINE 00002101 "        my $rc = read $fh, $buf, $size; # File::Slurp in a nutshell"
NSQ_SOURCE_LINE 00002102 "        $self->_throw('read') unless defined $rc;"
NSQ_SOURCE_LINE 00002103 "        return $buf;"
NSQ_SOURCE_LINE 00002104 "    }"
NSQ_SOURCE_LINE 00002105 "    else {"
NSQ_SOURCE_LINE 00002106 "        local $/;"
NSQ_SOURCE_LINE 00002107 "        my $buf = scalar <$fh>;"
NSQ_SOURCE_LINE 00002108 "        $self->_throw('read') unless defined $buf;"
NSQ_SOURCE_LINE 00002109 "        return $buf;"
NSQ_SOURCE_LINE 00002110 "    }"
NSQ_SOURCE_LINE 00002111 "}"
NSQ_SOURCE_LINE 00002112 ""
NSQ_SOURCE_LINE 00002113 "sub slurp_raw { $_[1] = { binmode => \":unix\" }; goto &slurp }"
NSQ_SOURCE_LINE 00002114 ""
NSQ_SOURCE_LINE 00002115 "sub slurp_utf8 {"
NSQ_SOURCE_LINE 00002116 "    if ( defined($HAS_UU) ? $HAS_UU : ( $HAS_UU = _check_UU() ) ) {"
NSQ_SOURCE_LINE 00002117 "        return Unicode::UTF8::decode_utf8( slurp( $_[0], { binmode => \":unix\" } ) );"
NSQ_SOURCE_LINE 00002118 "    }"
NSQ_SOURCE_LINE 00002119 "    elsif ( defined($HAS_PU) ? $HAS_PU : ( $HAS_PU = _check_PU() ) ) {"
NSQ_SOURCE_LINE 00002120 "        $_[1] = { binmode => \":unix:utf8_strict\" };"
NSQ_SOURCE_LINE 00002121 "        goto &slurp;"
NSQ_SOURCE_LINE 00002122 "    }"
NSQ_SOURCE_LINE 00002123 "    else {"
NSQ_SOURCE_LINE 00002124 "        $_[1] = { binmode => \":unix:encoding(UTF-8)\" };"
NSQ_SOURCE_LINE 00002125 "        goto &slurp;"
NSQ_SOURCE_LINE 00002126 "    }"
NSQ_SOURCE_LINE 00002127 "}"
NSQ_SOURCE_LINE 00002128 ""
NSQ_SOURCE_LINE 00002129 "#pod =method spew, spew_raw, spew_utf8"
NSQ_SOURCE_LINE 00002130 "#pod"
NSQ_SOURCE_LINE 00002131 "#pod     path(\"foo.txt\")->spew(@data);"
NSQ_SOURCE_LINE 00002132 "#pod     path(\"foo.txt\")->spew(\\@data);"
NSQ_SOURCE_LINE 00002133 "#pod     path(\"foo.txt\")->spew({binmode => \":raw\"}, @data);"
NSQ_SOURCE_LINE 00002134 "#pod     path(\"foo.txt\")->spew_raw(@data);"
NSQ_SOURCE_LINE 00002135 "#pod     path(\"foo.txt\")->spew_utf8(@data);"
NSQ_SOURCE_LINE 00002136 "#pod"
NSQ_SOURCE_LINE 00002137 "#pod Writes data to a file atomically.  The file is written to a temporary file in"
NSQ_SOURCE_LINE 00002138 "#pod the same directory, then renamed over the original.  An optional hash reference"
NSQ_SOURCE_LINE 00002139 "#pod may be used to pass options.  The only option is C<binmode>, which is passed to"
NSQ_SOURCE_LINE 00002140 "#pod C<binmode()> on the handle used for writing."
NSQ_SOURCE_LINE 00002141 "#pod"
NSQ_SOURCE_LINE 00002142 "#pod C<spew_raw> is like C<spew> with a C<binmode> of C<:unix> for a fast,"
NSQ_SOURCE_LINE 00002143 "#pod unbuffered, raw write."
NSQ_SOURCE_LINE 00002144 "#pod"
NSQ_SOURCE_LINE 00002145 "#pod C<spew_utf8> is like C<spew> with a C<binmode> of C<:unix:encoding(UTF-8)>"
NSQ_SOURCE_LINE 00002146 "#pod (or C<:unix:utf8_strict> with L<PerlIO::utf8_strict>).  If L<Unicode::UTF8>"
NSQ_SOURCE_LINE 00002147 "#pod 0.58+ is installed, a raw, unbuffered spew will be done instead on the data"
NSQ_SOURCE_LINE 00002148 "#pod encoded with C<Unicode::UTF8>."
NSQ_SOURCE_LINE 00002149 "#pod"
NSQ_SOURCE_LINE 00002150 "#pod B<NOTE>: because the file is written to a temporary file and then renamed, the"
NSQ_SOURCE_LINE 00002151 "#pod new file will wind up with permissions based on your current umask.  This is a"
NSQ_SOURCE_LINE 00002152 "#pod feature to protect you from a race condition that would otherwise give"
NSQ_SOURCE_LINE 00002153 "#pod different permissions than you might expect.  If you really want to keep the"
NSQ_SOURCE_LINE 00002154 "#pod original mode flags, use L</append> with the C<truncate> option."
NSQ_SOURCE_LINE 00002155 "#pod"
NSQ_SOURCE_LINE 00002156 "#pod Current API available since 0.011."
NSQ_SOURCE_LINE 00002157 "#pod"
NSQ_SOURCE_LINE 00002158 "#pod =cut"
NSQ_SOURCE_LINE 00002159 ""
NSQ_SOURCE_LINE 00002160 "sub spew {"
NSQ_SOURCE_LINE 00002161 "    my ( $self, @data ) = @_;"
NSQ_SOURCE_LINE 00002162 "    my $args = ( @data && ref $data[0] eq 'HASH' ) ? shift @data : {};"
NSQ_SOURCE_LINE 00002163 "    $args = _get_args( $args, qw/binmode/ );"
NSQ_SOURCE_LINE 00002164 "    my $binmode = $args->{binmode};"
NSQ_SOURCE_LINE 00002165 "    # get default binmode from caller's lexical scope (see \"perldoc open\")"
NSQ_SOURCE_LINE 00002166 "    $binmode = ( ( caller(0) )[10] || {} )->{'open>'} unless defined $binmode;"
NSQ_SOURCE_LINE 00002167 ""
NSQ_SOURCE_LINE 00002168 "    # writing needs to follow the link and create the tempfile in the same"
NSQ_SOURCE_LINE 00002169 "    # dir for later atomic rename"
NSQ_SOURCE_LINE 00002170 "    my $resolved_path = $self->_resolve_symlinks;"
NSQ_SOURCE_LINE 00002171 "    my $temp          = $resolved_path->_replacement_path;"
NSQ_SOURCE_LINE 00002172 ""
NSQ_SOURCE_LINE 00002173 "    my $fh;"
NSQ_SOURCE_LINE 00002174 "    my $ok = eval { $fh = $temp->filehandle( { exclusive => 1, locked => 1 }, \">\", $binmode ); 1 };"
NSQ_SOURCE_LINE 00002175 "    if (!$ok) {"
NSQ_SOURCE_LINE 00002176 "        my $msg = ref($@) eq 'Path::Tiny::Error'"
NSQ_SOURCE_LINE 00002177 "            ? \"error opening temp file '$@->{file}' for atomic write: $@->{err}\""
NSQ_SOURCE_LINE 00002178 "            : \"error opening temp file for atomic write: $@\";"
NSQ_SOURCE_LINE 00002179 "        $self->_throw('spew', $self->[PATH], $msg);"
NSQ_SOURCE_LINE 00002180 "    }"
NSQ_SOURCE_LINE 00002181 "    print( {$fh} map { ref eq 'ARRAY' ? @$_ : $_ } @data) or $self->_throw('print', $temp->[PATH]);"
NSQ_SOURCE_LINE 00002182 "    close $fh or $self->_throw( 'close', $temp->[PATH] );"
NSQ_SOURCE_LINE 00002183 ""
NSQ_SOURCE_LINE 00002184 "    return $temp->move($resolved_path);"
NSQ_SOURCE_LINE 00002185 "}"
NSQ_SOURCE_LINE 00002186 ""
NSQ_SOURCE_LINE 00002187 "sub spew_raw { splice @_, 1, 0, { binmode => \":unix\" }; goto &spew }"
NSQ_SOURCE_LINE 00002188 ""
NSQ_SOURCE_LINE 00002189 "sub spew_utf8 {"
NSQ_SOURCE_LINE 00002190 "    if ( defined($HAS_UU) ? $HAS_UU : ( $HAS_UU = _check_UU() ) ) {"
NSQ_SOURCE_LINE 00002191 "        my $self = shift;"
NSQ_SOURCE_LINE 00002192 "        spew("
NSQ_SOURCE_LINE 00002193 "            $self,"
NSQ_SOURCE_LINE 00002194 "            { binmode => \":unix\" },"
NSQ_SOURCE_LINE 00002195 "            map { Unicode::UTF8::encode_utf8($_) } map { ref eq 'ARRAY' ? @$_ : $_ } @_"
NSQ_SOURCE_LINE 00002196 "        );"
NSQ_SOURCE_LINE 00002197 "    }"
NSQ_SOURCE_LINE 00002198 "    elsif ( defined($HAS_PU) ? $HAS_PU : ( $HAS_PU = _check_PU() ) ) {"
NSQ_SOURCE_LINE 00002199 "        splice @_, 1, 0, { binmode => \":unix:utf8_strict\" };"
NSQ_SOURCE_LINE 00002200 "        goto &spew;"
NSQ_SOURCE_LINE 00002201 "    }"
NSQ_SOURCE_LINE 00002202 "    else {"
NSQ_SOURCE_LINE 00002203 "        splice @_, 1, 0, { binmode => \":unix:encoding(UTF-8)\" };"
NSQ_SOURCE_LINE 00002204 "        goto &spew;"
NSQ_SOURCE_LINE 00002205 "    }"
NSQ_SOURCE_LINE 00002206 "}"
NSQ_SOURCE_LINE 00002207 ""
NSQ_SOURCE_LINE 00002208 "#pod =method stat, lstat"
NSQ_SOURCE_LINE 00002209 "#pod"
NSQ_SOURCE_LINE 00002210 "#pod     $stat = path(\"foo.txt\")->stat;"
NSQ_SOURCE_LINE 00002211 "#pod     $stat = path(\"/some/symlink\")->lstat;"
NSQ_SOURCE_LINE 00002212 "#pod"
NSQ_SOURCE_LINE 00002213 "#pod Like calling C<stat> or C<lstat> from L<File::stat>."
NSQ_SOURCE_LINE 00002214 "#pod"
NSQ_SOURCE_LINE 00002215 "#pod Current API available since 0.001."
NSQ_SOURCE_LINE 00002216 "#pod"
NSQ_SOURCE_LINE 00002217 "#pod =cut"
NSQ_SOURCE_LINE 00002218 ""
NSQ_SOURCE_LINE 00002219 "# XXX break out individual stat() components as subs?"
NSQ_SOURCE_LINE 00002220 "sub stat {"
NSQ_SOURCE_LINE 00002221 "    my $self = shift;"
NSQ_SOURCE_LINE 00002222 "    require File::stat;"
NSQ_SOURCE_LINE 00002223 "    return File::stat::stat( $self->[PATH] ) || $self->_throw('stat');"
NSQ_SOURCE_LINE 00002224 "}"
NSQ_SOURCE_LINE 00002225 ""
NSQ_SOURCE_LINE 00002226 "sub lstat {"
NSQ_SOURCE_LINE 00002227 "    my $self = shift;"
NSQ_SOURCE_LINE 00002228 "    require File::stat;"
NSQ_SOURCE_LINE 00002229 "    return File::stat::lstat( $self->[PATH] ) || $self->_throw('lstat');"
NSQ_SOURCE_LINE 00002230 "}"
NSQ_SOURCE_LINE 00002231 ""
NSQ_SOURCE_LINE 00002232 "#pod =method stringify"
NSQ_SOURCE_LINE 00002233 "#pod"
NSQ_SOURCE_LINE 00002234 "#pod     $path = path(\"foo.txt\");"
NSQ_SOURCE_LINE 00002235 "#pod     say $path->stringify; # same as \"$path\""
NSQ_SOURCE_LINE 00002236 "#pod"
NSQ_SOURCE_LINE 00002237 "#pod Returns a string representation of the path.  Unlike C<canonpath>, this method"
NSQ_SOURCE_LINE 00002238 "#pod returns the path standardized with Unix-style C</> directory separators."
NSQ_SOURCE_LINE 00002239 "#pod"
NSQ_SOURCE_LINE 00002240 "#pod Current API available since 0.001."
NSQ_SOURCE_LINE 00002241 "#pod"
NSQ_SOURCE_LINE 00002242 "#pod =cut"
NSQ_SOURCE_LINE 00002243 ""
NSQ_SOURCE_LINE 00002244 "sub stringify { $_[0]->[PATH] =~ /^~/ ? './' . $_[0]->[PATH] : $_[0]->[PATH] }"
NSQ_SOURCE_LINE 00002245 ""
NSQ_SOURCE_LINE 00002246 "#pod =method subsumes"
NSQ_SOURCE_LINE 00002247 "#pod"
NSQ_SOURCE_LINE 00002248 "#pod     path(\"foo/bar\")->subsumes(\"foo/bar/baz\"); # true"
NSQ_SOURCE_LINE 00002249 "#pod     path(\"/foo/bar\")->subsumes(\"/foo/baz\");   # false"
NSQ_SOURCE_LINE 00002250 "#pod"
NSQ_SOURCE_LINE 00002251 "#pod Returns true if the first path is a prefix of the second path at a directory"
NSQ_SOURCE_LINE 00002252 "#pod boundary."
NSQ_SOURCE_LINE 00002253 "#pod"
NSQ_SOURCE_LINE 00002254 "#pod This B<does not> resolve parent directory entries (C<..>) or symlinks:"
NSQ_SOURCE_LINE 00002255 "#pod"
NSQ_SOURCE_LINE 00002256 "#pod     path(\"foo/bar\")->subsumes(\"foo/bar/../baz\"); # true"
NSQ_SOURCE_LINE 00002257 "#pod"
NSQ_SOURCE_LINE 00002258 "#pod If such things are important to you, ensure that both paths are resolved to"
NSQ_SOURCE_LINE 00002259 "#pod the filesystem with C<realpath>:"
NSQ_SOURCE_LINE 00002260 "#pod"
NSQ_SOURCE_LINE 00002261 "#pod     my $p1 = path(\"foo/bar\")->realpath;"
NSQ_SOURCE_LINE 00002262 "#pod     my $p2 = path(\"foo/bar/../baz\")->realpath;"
NSQ_SOURCE_LINE 00002263 "#pod     if ( $p1->subsumes($p2) ) { ... }"
NSQ_SOURCE_LINE 00002264 "#pod"
NSQ_SOURCE_LINE 00002265 "#pod Current API available since 0.048."
NSQ_SOURCE_LINE 00002266 "#pod"
NSQ_SOURCE_LINE 00002267 "#pod =cut"
NSQ_SOURCE_LINE 00002268 ""
NSQ_SOURCE_LINE 00002269 "sub subsumes {"
NSQ_SOURCE_LINE 00002270 "    my $self = shift;"
NSQ_SOURCE_LINE 00002271 "    Carp::croak(\"subsumes() requires a defined, positive-length argument\")"
NSQ_SOURCE_LINE 00002272 "      unless defined $_[0];"
NSQ_SOURCE_LINE 00002273 "    my $other = _path(shift);"
NSQ_SOURCE_LINE 00002274 ""
NSQ_SOURCE_LINE 00002275 "    # normalize absolute vs relative"
NSQ_SOURCE_LINE 00002276 "    if ( $self->is_absolute && !$other->is_absolute ) {"
NSQ_SOURCE_LINE 00002277 "        $other = $other->absolute;"
NSQ_SOURCE_LINE 00002278 "    }"
NSQ_SOURCE_LINE 00002279 "    elsif ( $other->is_absolute && !$self->is_absolute ) {"
NSQ_SOURCE_LINE 00002280 "        $self = $self->absolute;"
NSQ_SOURCE_LINE 00002281 "    }"
NSQ_SOURCE_LINE 00002282 ""
NSQ_SOURCE_LINE 00002283 "    # normalize volume vs non-volume; do this after absolute path"
NSQ_SOURCE_LINE 00002284 "    # adjustments above since that might add volumes already"
NSQ_SOURCE_LINE 00002285 "    if ( length $self->volume && !length $other->volume ) {"
NSQ_SOURCE_LINE 00002286 "        $other = $other->absolute;"
NSQ_SOURCE_LINE 00002287 "    }"
NSQ_SOURCE_LINE 00002288 "    elsif ( length $other->volume && !length $self->volume ) {"
NSQ_SOURCE_LINE 00002289 "        $self = $self->absolute;"
NSQ_SOURCE_LINE 00002290 "    }"
NSQ_SOURCE_LINE 00002291 ""
NSQ_SOURCE_LINE 00002292 "    if ( $self->[PATH] eq '.' ) {"
NSQ_SOURCE_LINE 00002293 "        return !!1; # cwd subsumes everything relative"
NSQ_SOURCE_LINE 00002294 "    }"
NSQ_SOURCE_LINE 00002295 "    elsif ( $self->is_rootdir ) {"
NSQ_SOURCE_LINE 00002296 "        # a root directory (\"/\", \"c:/\") already ends with a separator"
NSQ_SOURCE_LINE 00002297 "        return $other->[PATH] =~ m{^\\Q$self->[PATH]\\E};"
NSQ_SOURCE_LINE 00002298 "    }"
NSQ_SOURCE_LINE 00002299 "    else {"
NSQ_SOURCE_LINE 00002300 "        # exact match or prefix breaking at a separator"
NSQ_SOURCE_LINE 00002301 "        return $other->[PATH] =~ m{^\\Q$self->[PATH]\\E(?:/|\\z)};"
NSQ_SOURCE_LINE 00002302 "    }"
NSQ_SOURCE_LINE 00002303 "}"
NSQ_SOURCE_LINE 00002304 ""
NSQ_SOURCE_LINE 00002305 "#pod =method touch"
NSQ_SOURCE_LINE 00002306 "#pod"
NSQ_SOURCE_LINE 00002307 "#pod     path(\"foo.txt\")->touch;"
NSQ_SOURCE_LINE 00002308 "#pod     path(\"foo.txt\")->touch($epoch_secs);"
NSQ_SOURCE_LINE 00002309 "#pod"
NSQ_SOURCE_LINE 00002310 "#pod Like the Unix C<touch> utility.  Creates the file if it doesn't exist, or else"
NSQ_SOURCE_LINE 00002311 "#pod changes the modification and access times to the current time.  If the first"
NSQ_SOURCE_LINE 00002312 "#pod argument is the epoch seconds then it will be used."
NSQ_SOURCE_LINE 00002313 "#pod"
NSQ_SOURCE_LINE 00002314 "#pod Returns the path object so it can be easily chained with other methods:"
NSQ_SOURCE_LINE 00002315 "#pod"
NSQ_SOURCE_LINE 00002316 "#pod     # won't die if foo.txt doesn't exist"
NSQ_SOURCE_LINE 00002317 "#pod     $content = path(\"foo.txt\")->touch->slurp;"
NSQ_SOURCE_LINE 00002318 "#pod"
NSQ_SOURCE_LINE 00002319 "#pod Current API available since 0.015."
NSQ_SOURCE_LINE 00002320 "#pod"
NSQ_SOURCE_LINE 00002321 "#pod =cut"
NSQ_SOURCE_LINE 00002322 ""
NSQ_SOURCE_LINE 00002323 "sub touch {"
NSQ_SOURCE_LINE 00002324 "    my ( $self, $epoch ) = @_;"
NSQ_SOURCE_LINE 00002325 "    if ( !-e $self->[PATH] ) {"
NSQ_SOURCE_LINE 00002326 "        my $fh = $self->openw;"
NSQ_SOURCE_LINE 00002327 "        close $fh or $self->_throw('close');"
NSQ_SOURCE_LINE 00002328 "    }"
NSQ_SOURCE_LINE 00002329 "    if ( defined $epoch ) {"
NSQ_SOURCE_LINE 00002330 "        utime $epoch, $epoch, $self->[PATH]"
NSQ_SOURCE_LINE 00002331 "          or $self->_throw(\"utime ($epoch)\");"
NSQ_SOURCE_LINE 00002332 "    }"
NSQ_SOURCE_LINE 00002333 "    else {"
NSQ_SOURCE_LINE 00002334 "        # literal undef prevents warnings :-("
NSQ_SOURCE_LINE 00002335 "        utime undef, undef, $self->[PATH]"
NSQ_SOURCE_LINE 00002336 "          or $self->_throw(\"utime ()\");"
NSQ_SOURCE_LINE 00002337 "    }"
NSQ_SOURCE_LINE 00002338 "    return $self;"
NSQ_SOURCE_LINE 00002339 "}"
NSQ_SOURCE_LINE 00002340 ""
NSQ_SOURCE_LINE 00002341 "#pod =method touchpath"
NSQ_SOURCE_LINE 00002342 "#pod"
NSQ_SOURCE_LINE 00002343 "#pod     path(\"bar/baz/foo.txt\")->touchpath;"
NSQ_SOURCE_LINE 00002344 "#pod"
NSQ_SOURCE_LINE 00002345 "#pod Combines C<mkdir> and C<touch>.  Creates the parent directory if it doesn't exist,"
NSQ_SOURCE_LINE 00002346 "#pod before touching the file.  Returns the path object like C<touch> does."
NSQ_SOURCE_LINE 00002347 "#pod"
NSQ_SOURCE_LINE 00002348 "#pod If you need to pass options, use C<mkdir> and C<touch> separately:"
NSQ_SOURCE_LINE 00002349 "#pod"
NSQ_SOURCE_LINE 00002350 "#pod     path(\"bar/baz\")->mkdir( \\%options )->child(\"foo.txt\")->touch($epoch_secs);"
NSQ_SOURCE_LINE 00002351 "#pod"
NSQ_SOURCE_LINE 00002352 "#pod Current API available since 0.022."
NSQ_SOURCE_LINE 00002353 "#pod"
NSQ_SOURCE_LINE 00002354 "#pod =cut"
NSQ_SOURCE_LINE 00002355 ""
NSQ_SOURCE_LINE 00002356 "sub touchpath {"
NSQ_SOURCE_LINE 00002357 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00002358 "    my $parent = $self->parent;"
NSQ_SOURCE_LINE 00002359 "    $parent->mkdir unless $parent->exists;"
NSQ_SOURCE_LINE 00002360 "    $self->touch;"
NSQ_SOURCE_LINE 00002361 "}"
NSQ_SOURCE_LINE 00002362 ""
NSQ_SOURCE_LINE 00002363 "#pod =method visit"
NSQ_SOURCE_LINE 00002364 "#pod"
NSQ_SOURCE_LINE 00002365 "#pod     path(\"/tmp\")->visit( \\&callback, \\%options );"
NSQ_SOURCE_LINE 00002366 "#pod"
NSQ_SOURCE_LINE 00002367 "#pod Executes a callback for each child of a directory.  It returns a hash"
NSQ_SOURCE_LINE 00002368 "#pod reference with any state accumulated during iteration."
NSQ_SOURCE_LINE 00002369 "#pod"
NSQ_SOURCE_LINE 00002370 "#pod The options are the same as for L</iterator> (which it uses internally):"
NSQ_SOURCE_LINE 00002371 "#pod C<recurse> and C<follow_symlinks>.  Both default to false."
NSQ_SOURCE_LINE 00002372 "#pod"
NSQ_SOURCE_LINE 00002373 "#pod The callback function will receive a C<Path::Tiny> object as the first argument"
NSQ_SOURCE_LINE 00002374 "#pod and a hash reference to accumulate state as the second argument.  For example:"
NSQ_SOURCE_LINE 00002375 "#pod"
NSQ_SOURCE_LINE 00002376 "#pod     # collect files sizes"
NSQ_SOURCE_LINE 00002377 "#pod     my $sizes = path(\"/tmp\")->visit("
NSQ_SOURCE_LINE 00002378 "#pod         sub {"
NSQ_SOURCE_LINE 00002379 "#pod             my ($path, $state) = @_;"
NSQ_SOURCE_LINE 00002380 "#pod             return if $path->is_dir;"
NSQ_SOURCE_LINE 00002381 "#pod             $state->{$path} = -s $path;"
NSQ_SOURCE_LINE 00002382 "#pod         },"
NSQ_SOURCE_LINE 00002383 "#pod         { recurse => 1 }"
NSQ_SOURCE_LINE 00002384 "#pod     );"
NSQ_SOURCE_LINE 00002385 "#pod"
NSQ_SOURCE_LINE 00002386 "#pod For convenience, the C<Path::Tiny> object will also be locally aliased as the"
NSQ_SOURCE_LINE 00002387 "#pod C<$_> global variable:"
NSQ_SOURCE_LINE 00002388 "#pod"
NSQ_SOURCE_LINE 00002389 "#pod     # print paths matching /foo/"
NSQ_SOURCE_LINE 00002390 "#pod     path(\"/tmp\")->visit( sub { say if /foo/ }, { recurse => 1} );"
NSQ_SOURCE_LINE 00002391 "#pod"
NSQ_SOURCE_LINE 00002392 "#pod If the callback returns a B<reference> to a false scalar value, iteration will"
NSQ_SOURCE_LINE 00002393 "#pod terminate.  This is not the same as \"pruning\" a directory search; this just"
NSQ_SOURCE_LINE 00002394 "#pod stops all iteration and returns the state hash reference."
NSQ_SOURCE_LINE 00002395 "#pod"
NSQ_SOURCE_LINE 00002396 "#pod     # find up to 10 files larger than 100K"
NSQ_SOURCE_LINE 00002397 "#pod     my $files = path(\"/tmp\")->visit("
NSQ_SOURCE_LINE 00002398 "#pod         sub {"
NSQ_SOURCE_LINE 00002399 "#pod             my ($path, $state) = @_;"
NSQ_SOURCE_LINE 00002400 "#pod             $state->{$path}++ if -s $path > 102400"
NSQ_SOURCE_LINE 00002401 "#pod             return \\0 if keys %$state == 10;"
NSQ_SOURCE_LINE 00002402 "#pod         },"
NSQ_SOURCE_LINE 00002403 "#pod         { recurse => 1 }"
NSQ_SOURCE_LINE 00002404 "#pod     );"
NSQ_SOURCE_LINE 00002405 "#pod"
NSQ_SOURCE_LINE 00002406 "#pod If you want more flexible iteration, use a module like L<Path::Iterator::Rule>."
NSQ_SOURCE_LINE 00002407 "#pod"
NSQ_SOURCE_LINE 00002408 "#pod Current API available since 0.062."
NSQ_SOURCE_LINE 00002409 "#pod"
NSQ_SOURCE_LINE 00002410 "#pod =cut"
NSQ_SOURCE_LINE 00002411 ""
NSQ_SOURCE_LINE 00002412 "sub visit {"
NSQ_SOURCE_LINE 00002413 "    my $self = shift;"
NSQ_SOURCE_LINE 00002414 "    my $cb   = shift;"
NSQ_SOURCE_LINE 00002415 "    my $args = _get_args( shift, qw/recurse follow_symlinks/ );"
NSQ_SOURCE_LINE 00002416 "    Carp::croak(\"Callback for visit() must be a code reference\")"
NSQ_SOURCE_LINE 00002417 "      unless defined($cb) && ref($cb) eq 'CODE';"
NSQ_SOURCE_LINE 00002418 "    my $next  = $self->iterator($args);"
NSQ_SOURCE_LINE 00002419 "    my $state = {};"
NSQ_SOURCE_LINE 00002420 "    while ( my $file = $next->() ) {"
NSQ_SOURCE_LINE 00002421 "        local $_ = $file;"
NSQ_SOURCE_LINE 00002422 "        my $r = $cb->( $file, $state );"
NSQ_SOURCE_LINE 00002423 "        last if ref($r) eq 'SCALAR' && !$$r;"
NSQ_SOURCE_LINE 00002424 "    }"
NSQ_SOURCE_LINE 00002425 "    return $state;"
NSQ_SOURCE_LINE 00002426 "}"
NSQ_SOURCE_LINE 00002427 ""
NSQ_SOURCE_LINE 00002428 "#pod =method volume"
NSQ_SOURCE_LINE 00002429 "#pod"
NSQ_SOURCE_LINE 00002430 "#pod     $vol = path(\"/tmp/foo.txt\")->volume;   # \"\""
NSQ_SOURCE_LINE 00002431 "#pod     $vol = path(\"C:/tmp/foo.txt\")->volume; # \"C:\""
NSQ_SOURCE_LINE 00002432 "#pod"
NSQ_SOURCE_LINE 00002433 "#pod Returns the volume portion of the path.  This is equivalent"
NSQ_SOURCE_LINE 00002434 "#pod to what L<File::Spec> would give from C<splitpath> and thus"
NSQ_SOURCE_LINE 00002435 "#pod usually is the empty string on Unix-like operating systems or the"
NSQ_SOURCE_LINE 00002436 "#pod drive letter for an absolute path on C<MSWin32>."
NSQ_SOURCE_LINE 00002437 "#pod"
NSQ_SOURCE_LINE 00002438 "#pod Current API available since 0.001."
NSQ_SOURCE_LINE 00002439 "#pod"
NSQ_SOURCE_LINE 00002440 "#pod =cut"
NSQ_SOURCE_LINE 00002441 ""
NSQ_SOURCE_LINE 00002442 "sub volume {"
NSQ_SOURCE_LINE 00002443 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00002444 "    $self->_splitpath unless defined $self->[VOL];"
NSQ_SOURCE_LINE 00002445 "    return $self->[VOL];"
NSQ_SOURCE_LINE 00002446 "}"
NSQ_SOURCE_LINE 00002447 ""
NSQ_SOURCE_LINE 00002448 "package Path::Tiny::Error;"
NSQ_SOURCE_LINE 00002449 ""
NSQ_SOURCE_LINE 00002450 "our @CARP_NOT = qw/Path::Tiny/;"
NSQ_SOURCE_LINE 00002451 ""
NSQ_SOURCE_LINE 00002452 "use overload ( q{\"\"} => sub { (shift)->{msg} }, fallback => 1 );"
NSQ_SOURCE_LINE 00002453 ""
NSQ_SOURCE_LINE 00002454 "sub throw {"
NSQ_SOURCE_LINE 00002455 "    my ( $class, $op, $file, $err ) = @_;"
NSQ_SOURCE_LINE 00002456 "    chomp( my $trace = Carp::shortmess );"
NSQ_SOURCE_LINE 00002457 "    my $msg = \"Error $op on '$file': $err$trace\\n\";"
NSQ_SOURCE_LINE 00002458 "    die bless { op => $op, file => $file, err => $err, msg => $msg }, $class;"
NSQ_SOURCE_LINE 00002459 "}"
NSQ_SOURCE_LINE 00002460 ""
NSQ_SOURCE_LINE 00002461 "1;"
NSQ_SOURCE_LINE 00002462 ""
NSQ_SOURCE_LINE 00002463 ""
NSQ_SOURCE_LINE 00002464 "# vim: ts=4 sts=4 sw=4 et:"
NSQ_SOURCE_LINE 00002465 ""
NSQ_SOURCE_LINE 00002466 "__END__"
NSQ_SOURCE_LINE 00002467 ""
NSQ_SOURCE_LINE 00002468 "=pod"
NSQ_SOURCE_LINE 00002469 ""
NSQ_SOURCE_LINE 00002470 "=encoding UTF-8"
NSQ_SOURCE_LINE 00002471 ""
NSQ_SOURCE_LINE 00002472 "=head1 NAME"
NSQ_SOURCE_LINE 00002473 ""
NSQ_SOURCE_LINE 00002474 "Path::Tiny - File path utility"
NSQ_SOURCE_LINE 00002475 ""
NSQ_SOURCE_LINE 00002476 "=head1 VERSION"
NSQ_SOURCE_LINE 00002477 ""
NSQ_SOURCE_LINE 00002478 "version 0.150"
NSQ_SOURCE_LINE 00002479 ""
NSQ_SOURCE_LINE 00002480 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00002481 ""
NSQ_SOURCE_LINE 00002482 "  use Path::Tiny;"
NSQ_SOURCE_LINE 00002483 ""
NSQ_SOURCE_LINE 00002484 "  # Creating Path::Tiny objects"
NSQ_SOURCE_LINE 00002485 ""
NSQ_SOURCE_LINE 00002486 "  my $dir = path(\"/tmp\");"
NSQ_SOURCE_LINE 00002487 "  my $foo = path(\"foo.txt\");"
NSQ_SOURCE_LINE 00002488 ""
NSQ_SOURCE_LINE 00002489 "  my $subdir = $dir->child(\"foo\");"
NSQ_SOURCE_LINE 00002490 "  my $bar = $subdir->child(\"bar.txt\");"
NSQ_SOURCE_LINE 00002491 ""
NSQ_SOURCE_LINE 00002492 "  # Stringifies as cleaned up path"
NSQ_SOURCE_LINE 00002493 ""
NSQ_SOURCE_LINE 00002494 "  my $file = path(\"./foo.txt\");"
NSQ_SOURCE_LINE 00002495 "  print $file; # \"foo.txt\""
NSQ_SOURCE_LINE 00002496 ""
NSQ_SOURCE_LINE 00002497 "  # Reading files"
NSQ_SOURCE_LINE 00002498 ""
NSQ_SOURCE_LINE 00002499 "  my $guts = $file->slurp;"
NSQ_SOURCE_LINE 00002500 "     $guts = $file->slurp_utf8;"
NSQ_SOURCE_LINE 00002501 ""
NSQ_SOURCE_LINE 00002502 "  my @lines = $file->lines;"
NSQ_SOURCE_LINE 00002503 "     @lines = $file->lines_utf8;"
NSQ_SOURCE_LINE 00002504 ""
NSQ_SOURCE_LINE 00002505 "  my ($head) = $file->lines( {count => 1} );"
NSQ_SOURCE_LINE 00002506 "  my ($tail) = $file->lines( {count => -1} );"
NSQ_SOURCE_LINE 00002507 ""
NSQ_SOURCE_LINE 00002508 "  # Writing files"
NSQ_SOURCE_LINE 00002509 ""
NSQ_SOURCE_LINE 00002510 "  $bar->spew( @data );"
NSQ_SOURCE_LINE 00002511 "  $bar->spew_utf8( @data );"
NSQ_SOURCE_LINE 00002512 ""
NSQ_SOURCE_LINE 00002513 "  # Reading directories"
NSQ_SOURCE_LINE 00002514 ""
NSQ_SOURCE_LINE 00002515 "  for ( $dir->children ) { ... }"
NSQ_SOURCE_LINE 00002516 ""
NSQ_SOURCE_LINE 00002517 "  my $iter = $dir->iterator;"
NSQ_SOURCE_LINE 00002518 "  while ( my $next = $iter->() ) { ... }"
NSQ_SOURCE_LINE 00002519 ""
NSQ_SOURCE_LINE 00002520 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00002521 ""
NSQ_SOURCE_LINE 00002522 "This module provides a small, fast utility for working with file paths.  It is"
NSQ_SOURCE_LINE 00002523 "friendlier to use than L<File::Spec> and provides easy access to functions from"
NSQ_SOURCE_LINE 00002524 "several other core file handling modules.  It aims to be smaller and faster"
NSQ_SOURCE_LINE 00002525 "than many alternatives on CPAN, while helping people do many common things in"
NSQ_SOURCE_LINE 00002526 "consistent and less error-prone ways."
NSQ_SOURCE_LINE 00002527 ""
NSQ_SOURCE_LINE 00002528 "Path::Tiny does not try to work for anything except Unix-like and Win32"
NSQ_SOURCE_LINE 00002529 "platforms.  Even then, it might break if you try something particularly obscure"
NSQ_SOURCE_LINE 00002530 "or tortuous.  (Quick!  What does this mean:"
NSQ_SOURCE_LINE 00002531 "C<< ///../../..//./././a//b/.././c/././ >>?  And how does it differ on Win32?)"
NSQ_SOURCE_LINE 00002532 ""
NSQ_SOURCE_LINE 00002533 "All paths are forced to have Unix-style forward slashes.  Stringifying"
NSQ_SOURCE_LINE 00002534 "the object gives you back the path (after some clean up)."
NSQ_SOURCE_LINE 00002535 ""
NSQ_SOURCE_LINE 00002536 "File input/output methods C<flock> handles before reading or writing,"
NSQ_SOURCE_LINE 00002537 "as appropriate (if supported by the platform and/or filesystem)."
NSQ_SOURCE_LINE 00002538 ""
NSQ_SOURCE_LINE 00002539 "The C<*_utf8> methods (C<slurp_utf8>, C<lines_utf8>, etc.) operate in raw"
NSQ_SOURCE_LINE 00002540 "mode.  On Windows, that means they will not have CRLF translation from the"
NSQ_SOURCE_LINE 00002541 "C<:crlf> IO layer.  Installing L<Unicode::UTF8> 0.58 or later will speed up"
NSQ_SOURCE_LINE 00002542 "C<*_utf8> situations in many cases and is highly recommended."
NSQ_SOURCE_LINE 00002543 "Alternatively, installing L<PerlIO::utf8_strict> 0.003 or later will be"
NSQ_SOURCE_LINE 00002544 "used in place of the default C<:encoding(UTF-8)>."
NSQ_SOURCE_LINE 00002545 ""
NSQ_SOURCE_LINE 00002546 "This module depends heavily on PerlIO layers for correct operation and thus"
NSQ_SOURCE_LINE 00002547 "requires Perl 5.008001 or later."
NSQ_SOURCE_LINE 00002548 ""
NSQ_SOURCE_LINE 00002549 "=head1 CONSTRUCTORS"
NSQ_SOURCE_LINE 00002550 ""
NSQ_SOURCE_LINE 00002551 "=head2 path"
NSQ_SOURCE_LINE 00002552 ""
NSQ_SOURCE_LINE 00002553 "    $path = path(\"foo/bar\");"
NSQ_SOURCE_LINE 00002554 "    $path = path(\"/tmp\", \"file.txt\"); # list"
NSQ_SOURCE_LINE 00002555 "    $path = path(\".\");                # cwd"
NSQ_SOURCE_LINE 00002556 ""
NSQ_SOURCE_LINE 00002557 "Constructs a C<Path::Tiny> object.  It doesn't matter if you give a file or"
NSQ_SOURCE_LINE 00002558 "directory path.  It's still up to you to call directory-like methods only on"
NSQ_SOURCE_LINE 00002559 "directories and file-like methods only on files.  This function is exported"
NSQ_SOURCE_LINE 00002560 "automatically by default."
NSQ_SOURCE_LINE 00002561 ""
NSQ_SOURCE_LINE 00002562 "The first argument must be defined and have non-zero length or an exception"
NSQ_SOURCE_LINE 00002563 "will be thrown.  This prevents subtle, dangerous errors with code like"
NSQ_SOURCE_LINE 00002564 "C<< path( maybe_undef() )->remove_tree >>."
NSQ_SOURCE_LINE 00002565 ""
NSQ_SOURCE_LINE 00002566 "B<DEPRECATED>: If and only if the B<first> character of the B<first> argument"
NSQ_SOURCE_LINE 00002567 "to C<path> is a tilde ('~'), then tilde replacement will be applied to the"
NSQ_SOURCE_LINE 00002568 "first path segment. A single tilde will be replaced with C<glob('~')> and a"
NSQ_SOURCE_LINE 00002569 "tilde followed by a username will be replaced with output of"
NSQ_SOURCE_LINE 00002570 "C<glob('~username')>. B<No other method does tilde expansion on its arguments>."
NSQ_SOURCE_LINE 00002571 "See L</Tilde expansion (deprecated)> for more."
NSQ_SOURCE_LINE 00002572 ""
NSQ_SOURCE_LINE 00002573 "On Windows, if the path consists of a drive identifier without a path component"
NSQ_SOURCE_LINE 00002574 "(C<C:> or C<D:>), it will be expanded to the absolute path of the current"
NSQ_SOURCE_LINE 00002575 "directory on that volume using C<Cwd::getdcwd()>."
NSQ_SOURCE_LINE 00002576 ""
NSQ_SOURCE_LINE 00002577 "If called with a single C<Path::Tiny> argument, the original is returned unless"
NSQ_SOURCE_LINE 00002578 "the original is holding a temporary file or directory reference in which case a"
NSQ_SOURCE_LINE 00002579 "stringified copy is made."
NSQ_SOURCE_LINE 00002580 ""
NSQ_SOURCE_LINE 00002581 "    $path = path(\"foo/bar\");"
NSQ_SOURCE_LINE 00002582 "    $temp = Path::Tiny->tempfile;"
NSQ_SOURCE_LINE 00002583 ""
NSQ_SOURCE_LINE 00002584 "    $p2 = path($path); # like $p2 = $path"
NSQ_SOURCE_LINE 00002585 "    $t2 = path($temp); # like $t2 = path( \"$temp\" )"
NSQ_SOURCE_LINE 00002586 ""
NSQ_SOURCE_LINE 00002587 "This optimizes copies without proliferating references unexpectedly if a copy is"
NSQ_SOURCE_LINE 00002588 "made by code outside your control."
NSQ_SOURCE_LINE 00002589 ""
NSQ_SOURCE_LINE 00002590 "Current API available since 0.017."
NSQ_SOURCE_LINE 00002591 ""
NSQ_SOURCE_LINE 00002592 "=head2 new"
NSQ_SOURCE_LINE 00002593 ""
NSQ_SOURCE_LINE 00002594 "    $path = Path::Tiny->new(\"foo/bar\");"
NSQ_SOURCE_LINE 00002595 ""
NSQ_SOURCE_LINE 00002596 "This is just like C<path>, but with method call overhead.  (Why would you"
NSQ_SOURCE_LINE 00002597 "do that?)"
NSQ_SOURCE_LINE 00002598 ""
NSQ_SOURCE_LINE 00002599 "Current API available since 0.001."
NSQ_SOURCE_LINE 00002600 ""
NSQ_SOURCE_LINE 00002601 "=head2 cwd"
NSQ_SOURCE_LINE 00002602 ""
NSQ_SOURCE_LINE 00002603 "    $path = Path::Tiny->cwd; # path( Cwd::getcwd )"
NSQ_SOURCE_LINE 00002604 "    $path = cwd; # optional export"
NSQ_SOURCE_LINE 00002605 ""
NSQ_SOURCE_LINE 00002606 "Gives you the absolute path to the current directory as a C<Path::Tiny> object."
NSQ_SOURCE_LINE 00002607 "This is slightly faster than C<< path(\".\")->absolute >>."
NSQ_SOURCE_LINE 00002608 ""
NSQ_SOURCE_LINE 00002609 "C<cwd> may be exported on request and used as a function instead of as a"
NSQ_SOURCE_LINE 00002610 "method."
NSQ_SOURCE_LINE 00002611 ""
NSQ_SOURCE_LINE 00002612 "Current API available since 0.018."
NSQ_SOURCE_LINE 00002613 ""
NSQ_SOURCE_LINE 00002614 "=head2 rootdir"
NSQ_SOURCE_LINE 00002615 ""
NSQ_SOURCE_LINE 00002616 "    $path = Path::Tiny->rootdir; # /"
NSQ_SOURCE_LINE 00002617 "    $path = rootdir;             # optional export "
NSQ_SOURCE_LINE 00002618 ""
NSQ_SOURCE_LINE 00002619 "Gives you C<< File::Spec->rootdir >> as a C<Path::Tiny> object if you're too"
NSQ_SOURCE_LINE 00002620 "picky for C<path(\"/\")>."
NSQ_SOURCE_LINE 00002621 ""
NSQ_SOURCE_LINE 00002622 "C<rootdir> may be exported on request and used as a function instead of as a"
NSQ_SOURCE_LINE 00002623 "method."
NSQ_SOURCE_LINE 00002624 ""
NSQ_SOURCE_LINE 00002625 "Current API available since 0.018."
NSQ_SOURCE_LINE 00002626 ""
NSQ_SOURCE_LINE 00002627 "=head2 tempfile, tempdir"
NSQ_SOURCE_LINE 00002628 ""
NSQ_SOURCE_LINE 00002629 "    $temp = Path::Tiny->tempfile( @options );"
NSQ_SOURCE_LINE 00002630 "    $temp = Path::Tiny->tempdir( @options );"
NSQ_SOURCE_LINE 00002631 "    $temp = $dirpath->tempfile( @options );"
NSQ_SOURCE_LINE 00002632 "    $temp = $dirpath->tempdir( @options );"
NSQ_SOURCE_LINE 00002633 "    $temp = tempfile( @options ); # optional export"
NSQ_SOURCE_LINE 00002634 "    $temp = tempdir( @options );  # optional export"
NSQ_SOURCE_LINE 00002635 ""
NSQ_SOURCE_LINE 00002636 "C<tempfile> passes the options to C<< File::Temp->new >> and returns a"
NSQ_SOURCE_LINE 00002637 "C<Path::Tiny> object with the file name.  The C<TMPDIR> option will be enabled"
NSQ_SOURCE_LINE 00002638 "by default, but you can override that by passing C<< TMPDIR => 0 >> along with"
NSQ_SOURCE_LINE 00002639 "the options.  (If you use an absolute C<TEMPLATE> option, you will want to"
NSQ_SOURCE_LINE 00002640 "disable C<TMPDIR>.)"
NSQ_SOURCE_LINE 00002641 ""
NSQ_SOURCE_LINE 00002642 "The resulting C<File::Temp> object is cached. When the C<Path::Tiny> object is"
NSQ_SOURCE_LINE 00002643 "destroyed, the C<File::Temp> object will be as well."
NSQ_SOURCE_LINE 00002644 ""
NSQ_SOURCE_LINE 00002645 "C<File::Temp> annoyingly requires you to specify a custom template in slightly"
NSQ_SOURCE_LINE 00002646 "different ways depending on which function or method you call, but"
NSQ_SOURCE_LINE 00002647 "C<Path::Tiny> lets you ignore that and can take either a leading template or a"
NSQ_SOURCE_LINE 00002648 "C<TEMPLATE> option and does the right thing."
NSQ_SOURCE_LINE 00002649 ""
NSQ_SOURCE_LINE 00002650 "    $temp = Path::Tiny->tempfile( \"customXXXXXXXX\" );             # ok"
NSQ_SOURCE_LINE 00002651 "    $temp = Path::Tiny->tempfile( TEMPLATE => \"customXXXXXXXX\" ); # ok"
NSQ_SOURCE_LINE 00002652 ""
NSQ_SOURCE_LINE 00002653 "The tempfile path object will be normalized to have an absolute path, even if"
NSQ_SOURCE_LINE 00002654 "created in a relative directory using C<DIR>.  If you want it to have"
NSQ_SOURCE_LINE 00002655 "the C<realpath> instead, pass a leading options hash like this:"
NSQ_SOURCE_LINE 00002656 ""
NSQ_SOURCE_LINE 00002657 "    $real_temp = tempfile({realpath => 1}, @options);"
NSQ_SOURCE_LINE 00002658 ""
NSQ_SOURCE_LINE 00002659 "C<tempdir> is just like C<tempfile>, except it calls"
NSQ_SOURCE_LINE 00002660 "C<< File::Temp->newdir >> instead."
NSQ_SOURCE_LINE 00002661 ""
NSQ_SOURCE_LINE 00002662 "Both C<tempfile> and C<tempdir> may be exported on request and used as"
NSQ_SOURCE_LINE 00002663 "functions instead of as methods."
NSQ_SOURCE_LINE 00002664 ""
NSQ_SOURCE_LINE 00002665 "The methods can be called on an instances representing a"
NSQ_SOURCE_LINE 00002666 "directory. In this case, the directory is used as the base to create the"
NSQ_SOURCE_LINE 00002667 "temporary file/directory, setting the C<DIR> option in File::Temp."
NSQ_SOURCE_LINE 00002668 ""
NSQ_SOURCE_LINE 00002669 "    my $target_dir = path('/to/destination');"
NSQ_SOURCE_LINE 00002670 "    my $tempfile = $target_dir->tempfile('foobarXXXXXX');"
NSQ_SOURCE_LINE 00002671 "    $tempfile->spew('A lot of data...');  # not atomic"
NSQ_SOURCE_LINE 00002672 "    $tempfile->move($target_dir->child('foobar')); # hopefully atomic"
NSQ_SOURCE_LINE 00002673 ""
NSQ_SOURCE_LINE 00002674 "In this case, any value set for option C<DIR> is ignored."
NSQ_SOURCE_LINE 00002675 ""
NSQ_SOURCE_LINE 00002676 "B<Note>: for tempfiles, the filehandles from File::Temp are closed and not"
NSQ_SOURCE_LINE 00002677 "reused.  This is not as secure as using File::Temp handles directly, but is"
NSQ_SOURCE_LINE 00002678 "less prone to deadlocks or access problems on some platforms.  Think of what"
NSQ_SOURCE_LINE 00002679 "C<Path::Tiny> gives you to be just a temporary file B<name> that gets cleaned"
NSQ_SOURCE_LINE 00002680 "up."
NSQ_SOURCE_LINE 00002681 ""
NSQ_SOURCE_LINE 00002682 "B<Note 2>: if you don't want these cleaned up automatically when the object"
NSQ_SOURCE_LINE 00002683 "is destroyed, File::Temp requires different options for directories and"
NSQ_SOURCE_LINE 00002684 "files.  Use C<< CLEANUP => 0 >> for directories and C<< UNLINK => 0 >> for"
NSQ_SOURCE_LINE 00002685 "files."
NSQ_SOURCE_LINE 00002686 ""
NSQ_SOURCE_LINE 00002687 "B<Note 3>: Don't lose the temporary object by chaining a method call instead"
NSQ_SOURCE_LINE 00002688 "of storing it:"
NSQ_SOURCE_LINE 00002689 ""
NSQ_SOURCE_LINE 00002690 "    my $lost = tempdir()->child(\"foo\"); # tempdir cleaned up right away"
NSQ_SOURCE_LINE 00002691 ""
NSQ_SOURCE_LINE 00002692 "B<Note 4>: The cached object may be accessed with the L</cached_temp> method."
NSQ_SOURCE_LINE 00002693 "Keeping a reference to, or modifying the cached object may break the"
NSQ_SOURCE_LINE 00002694 "behavior documented above and is not supported.  Use at your own risk."
NSQ_SOURCE_LINE 00002695 ""
NSQ_SOURCE_LINE 00002696 "Current API available since 0.119."
NSQ_SOURCE_LINE 00002697 ""
NSQ_SOURCE_LINE 00002698 "=head1 METHODS"
NSQ_SOURCE_LINE 00002699 ""
NSQ_SOURCE_LINE 00002700 "=head2 absolute"
NSQ_SOURCE_LINE 00002701 ""
NSQ_SOURCE_LINE 00002702 "    $abs = path(\"foo/bar\")->absolute;"
NSQ_SOURCE_LINE 00002703 "    $abs = path(\"foo/bar\")->absolute(\"/tmp\");"
NSQ_SOURCE_LINE 00002704 ""
NSQ_SOURCE_LINE 00002705 "Returns a new C<Path::Tiny> object with an absolute path (or itself if already"
NSQ_SOURCE_LINE 00002706 "absolute).  If no argument is given, the current directory is used as the"
NSQ_SOURCE_LINE 00002707 "absolute base path.  If an argument is given, it will be converted to an"
NSQ_SOURCE_LINE 00002708 "absolute path (if it is not already) and used as the absolute base path."
NSQ_SOURCE_LINE 00002709 ""
NSQ_SOURCE_LINE 00002710 "This will not resolve upward directories (\"foo/../bar\") unless C<canonpath>"
NSQ_SOURCE_LINE 00002711 "in L<File::Spec> would normally do so on your platform.  If you need them"
NSQ_SOURCE_LINE 00002712 "resolved, you must call the more expensive C<realpath> method instead."
NSQ_SOURCE_LINE 00002713 ""
NSQ_SOURCE_LINE 00002714 "On Windows, an absolute path without a volume component will have it added"
NSQ_SOURCE_LINE 00002715 "based on the current drive."
NSQ_SOURCE_LINE 00002716 ""
NSQ_SOURCE_LINE 00002717 "Current API available since 0.101."
NSQ_SOURCE_LINE 00002718 ""
NSQ_SOURCE_LINE 00002719 "=head2 append, append_raw, append_utf8"
NSQ_SOURCE_LINE 00002720 ""
NSQ_SOURCE_LINE 00002721 "    path(\"foo.txt\")->append(@data);"
NSQ_SOURCE_LINE 00002722 "    path(\"foo.txt\")->append(\\@data);"
NSQ_SOURCE_LINE 00002723 "    path(\"foo.txt\")->append({binmode => \":raw\"}, @data);"
NSQ_SOURCE_LINE 00002724 "    path(\"foo.txt\")->append_raw(@data);"
NSQ_SOURCE_LINE 00002725 "    path(\"foo.txt\")->append_utf8(@data);"
NSQ_SOURCE_LINE 00002726 ""
NSQ_SOURCE_LINE 00002727 "Appends data to a file.  The file is locked with C<flock> prior to writing"
NSQ_SOURCE_LINE 00002728 "and closed afterwards.  An optional hash reference may be used to pass"
NSQ_SOURCE_LINE 00002729 "options.  Valid options are:"
NSQ_SOURCE_LINE 00002730 ""
NSQ_SOURCE_LINE 00002731 "=over 4"
NSQ_SOURCE_LINE 00002732 ""
NSQ_SOURCE_LINE 00002733 "=item *"
NSQ_SOURCE_LINE 00002734 ""
NSQ_SOURCE_LINE 00002735 "C<binmode>: passed to C<binmode()> on the handle used for writing."
NSQ_SOURCE_LINE 00002736 ""
NSQ_SOURCE_LINE 00002737 "=item *"
NSQ_SOURCE_LINE 00002738 ""
NSQ_SOURCE_LINE 00002739 "C<truncate>: truncates the file after locking and before appending"
NSQ_SOURCE_LINE 00002740 ""
NSQ_SOURCE_LINE 00002741 "=back"
NSQ_SOURCE_LINE 00002742 ""
NSQ_SOURCE_LINE 00002743 "The C<truncate> option is a way to replace the contents of a file"
NSQ_SOURCE_LINE 00002744 "B<in place>, unlike L</spew> which writes to a temporary file and then"
NSQ_SOURCE_LINE 00002745 "replaces the original (if it exists)."
NSQ_SOURCE_LINE 00002746 ""
NSQ_SOURCE_LINE 00002747 "C<append_raw> is like C<append> with a C<binmode> of C<:unix> for a fast,"
NSQ_SOURCE_LINE 00002748 "unbuffered, raw write."
NSQ_SOURCE_LINE 00002749 ""
NSQ_SOURCE_LINE 00002750 "C<append_utf8> is like C<append> with an unbuffered C<binmode>"
NSQ_SOURCE_LINE 00002751 "C<:unix:encoding(UTF-8)> (or C<:unix:utf8_strict> with"
NSQ_SOURCE_LINE 00002752 "L<PerlIO::utf8_strict>).  If L<Unicode::UTF8> 0.58+ is installed, an"
NSQ_SOURCE_LINE 00002753 "unbuffered, raw append will be done instead on the data encoded with"
NSQ_SOURCE_LINE 00002754 "C<Unicode::UTF8>."
NSQ_SOURCE_LINE 00002755 ""
NSQ_SOURCE_LINE 00002756 "Current API available since 0.060."
NSQ_SOURCE_LINE 00002757 ""
NSQ_SOURCE_LINE 00002758 "=head2 assert"
NSQ_SOURCE_LINE 00002759 ""
NSQ_SOURCE_LINE 00002760 "    $path = path(\"foo.txt\")->assert( sub { $_->exists } );"
NSQ_SOURCE_LINE 00002761 ""
NSQ_SOURCE_LINE 00002762 "Returns the invocant after asserting that a code reference argument returns"
NSQ_SOURCE_LINE 00002763 "true.  When the assertion code reference runs, it will have the invocant"
NSQ_SOURCE_LINE 00002764 "object in the C<$_> variable.  If it returns false, an exception will be"
NSQ_SOURCE_LINE 00002765 "thrown.  The assertion code reference may also throw its own exception."
NSQ_SOURCE_LINE 00002766 ""
NSQ_SOURCE_LINE 00002767 "If no assertion is provided, the invocant is returned without error."
NSQ_SOURCE_LINE 00002768 ""
NSQ_SOURCE_LINE 00002769 "Current API available since 0.062."
NSQ_SOURCE_LINE 00002770 ""
NSQ_SOURCE_LINE 00002771 "=head2 basename"
NSQ_SOURCE_LINE 00002772 ""
NSQ_SOURCE_LINE 00002773 "    $name = path(\"foo/bar.txt\")->basename;        # bar.txt"
NSQ_SOURCE_LINE 00002774 "    $name = path(\"foo.txt\")->basename('.txt');    # foo"
NSQ_SOURCE_LINE 00002775 "    $name = path(\"foo.txt\")->basename(qr/.txt/);  # foo"
NSQ_SOURCE_LINE 00002776 "    $name = path(\"foo.txt\")->basename(@suffixes);"
NSQ_SOURCE_LINE 00002777 ""
NSQ_SOURCE_LINE 00002778 "Returns the file portion or last directory portion of a path."
NSQ_SOURCE_LINE 00002779 ""
NSQ_SOURCE_LINE 00002780 "Given a list of suffixes as strings or regular expressions, any that match at"
NSQ_SOURCE_LINE 00002781 "the end of the file portion or last directory portion will be removed before"
NSQ_SOURCE_LINE 00002782 "the result is returned."
NSQ_SOURCE_LINE 00002783 ""
NSQ_SOURCE_LINE 00002784 "Current API available since 0.054."
NSQ_SOURCE_LINE 00002785 ""
NSQ_SOURCE_LINE 00002786 "=head2 canonpath"
NSQ_SOURCE_LINE 00002787 ""
NSQ_SOURCE_LINE 00002788 "    $canonical = path(\"foo/bar\")->canonpath; # foo\\bar on Windows"
NSQ_SOURCE_LINE 00002789 ""
NSQ_SOURCE_LINE 00002790 "Returns a string with the canonical format of the path name for"
NSQ_SOURCE_LINE 00002791 "the platform.  In particular, this means directory separators"
NSQ_SOURCE_LINE 00002792 "will be C<\\> on Windows."
NSQ_SOURCE_LINE 00002793 ""
NSQ_SOURCE_LINE 00002794 "Current API available since 0.001."
NSQ_SOURCE_LINE 00002795 ""
NSQ_SOURCE_LINE 00002796 "=head2 cached_temp"
NSQ_SOURCE_LINE 00002797 ""
NSQ_SOURCE_LINE 00002798 "Returns the cached C<File::Temp> or C<File::Temp::Dir> object if the"
NSQ_SOURCE_LINE 00002799 "C<Path::Tiny> object was created with C</tempfile> or C</tempdir>."
NSQ_SOURCE_LINE 00002800 "If there is no such object, this method throws."
NSQ_SOURCE_LINE 00002801 ""
NSQ_SOURCE_LINE 00002802 "B<WARNING>: Keeping a reference to, or modifying the cached object may"
NSQ_SOURCE_LINE 00002803 "break the behavior documented for temporary files and directories created"
NSQ_SOURCE_LINE 00002804 "with C<Path::Tiny> and is not supported.  Use at your own risk."
NSQ_SOURCE_LINE 00002805 ""
NSQ_SOURCE_LINE 00002806 "Current API available since 0.101."
NSQ_SOURCE_LINE 00002807 ""
NSQ_SOURCE_LINE 00002808 "=head2 child"
NSQ_SOURCE_LINE 00002809 ""
NSQ_SOURCE_LINE 00002810 "    $file = path(\"/tmp\")->child(\"foo.txt\"); # \"/tmp/foo.txt\""
NSQ_SOURCE_LINE 00002811 "    $file = path(\"/tmp\")->child(@parts);"
NSQ_SOURCE_LINE 00002812 ""
NSQ_SOURCE_LINE 00002813 "Returns a new C<Path::Tiny> object relative to the original.  Works"
NSQ_SOURCE_LINE 00002814 "like C<catfile> or C<catdir> from File::Spec, but without caring about"
NSQ_SOURCE_LINE 00002815 "file or directories."
NSQ_SOURCE_LINE 00002816 ""
NSQ_SOURCE_LINE 00002817 "B<WARNING>: because the argument could contain C<..> or refer to symlinks,"
NSQ_SOURCE_LINE 00002818 "there is no guarantee that the new path refers to an actual descendent of"
NSQ_SOURCE_LINE 00002819 "the original.  If this is important to you, transform parent and child with"
NSQ_SOURCE_LINE 00002820 "L</realpath> and check them with L</subsumes>."
NSQ_SOURCE_LINE 00002821 ""
NSQ_SOURCE_LINE 00002822 "Current API available since 0.001."
NSQ_SOURCE_LINE 00002823 ""
NSQ_SOURCE_LINE 00002824 "=head2 children"
NSQ_SOURCE_LINE 00002825 ""
NSQ_SOURCE_LINE 00002826 "    @paths = path(\"/tmp\")->children;"
NSQ_SOURCE_LINE 00002827 "    @paths = path(\"/tmp\")->children( qr/\\.txt\\z/ );"
NSQ_SOURCE_LINE 00002828 ""
NSQ_SOURCE_LINE 00002829 "Returns a list of C<Path::Tiny> objects for all files and directories"
NSQ_SOURCE_LINE 00002830 "within a directory.  Excludes \".\" and \"..\" automatically."
NSQ_SOURCE_LINE 00002831 ""
NSQ_SOURCE_LINE 00002832 "If an optional C<qr//> argument is provided, it only returns objects for child"
NSQ_SOURCE_LINE 00002833 "names that match the given regular expression.  Only the base name is used"
NSQ_SOURCE_LINE 00002834 "for matching:"
NSQ_SOURCE_LINE 00002835 ""
NSQ_SOURCE_LINE 00002836 "    @paths = path(\"/tmp\")->children( qr/^foo/ );"
NSQ_SOURCE_LINE 00002837 "    # matches children like the glob foo*"
NSQ_SOURCE_LINE 00002838 ""
NSQ_SOURCE_LINE 00002839 "Current API available since 0.028."
NSQ_SOURCE_LINE 00002840 ""
NSQ_SOURCE_LINE 00002841 "=head2 chmod"
NSQ_SOURCE_LINE 00002842 ""
NSQ_SOURCE_LINE 00002843 "    path(\"foo.txt\")->chmod(0777);"
NSQ_SOURCE_LINE 00002844 "    path(\"foo.txt\")->chmod(\"0755\");"
NSQ_SOURCE_LINE 00002845 "    path(\"foo.txt\")->chmod(\"go-w\");"
NSQ_SOURCE_LINE 00002846 "    path(\"foo.txt\")->chmod(\"a=r,u+wx\");"
NSQ_SOURCE_LINE 00002847 ""
NSQ_SOURCE_LINE 00002848 "Sets file or directory permissions.  The argument can be a numeric mode, a"
NSQ_SOURCE_LINE 00002849 "octal string beginning with a \"0\" or a limited subset of the symbolic mode use"
NSQ_SOURCE_LINE 00002850 "by F</bin/chmod>."
NSQ_SOURCE_LINE 00002851 ""
NSQ_SOURCE_LINE 00002852 "The symbolic mode must be a comma-delimited list of mode clauses.  Clauses must"
NSQ_SOURCE_LINE 00002853 "match C<< qr/\\A([augo]+)([=+-])([rwx]+)\\z/ >>, which defines \"who\", \"op\" and"
NSQ_SOURCE_LINE 00002854 "\"perms\" parameters for each clause.  Unlike F</bin/chmod>, all three parameters"
NSQ_SOURCE_LINE 00002855 "are required for each clause, multiple ops are not allowed and permissions"
NSQ_SOURCE_LINE 00002856 "C<stugoX> are not supported.  (See L<File::chmod> for more complex needs.)"
NSQ_SOURCE_LINE 00002857 ""
NSQ_SOURCE_LINE 00002858 "Current API available since 0.053."
NSQ_SOURCE_LINE 00002859 ""
NSQ_SOURCE_LINE 00002860 "=head2 copy"
NSQ_SOURCE_LINE 00002861 ""
NSQ_SOURCE_LINE 00002862 "    path(\"/tmp/foo.txt\")->copy(\"/tmp/bar.txt\");"
NSQ_SOURCE_LINE 00002863 ""
NSQ_SOURCE_LINE 00002864 "Copies the current path to the given destination using L<File::Copy>'s"
NSQ_SOURCE_LINE 00002865 "C<copy> function. Upon success, returns the C<Path::Tiny> object for the"
NSQ_SOURCE_LINE 00002866 "newly copied file."
NSQ_SOURCE_LINE 00002867 ""
NSQ_SOURCE_LINE 00002868 "Current API available since 0.070."
NSQ_SOURCE_LINE 00002869 ""
NSQ_SOURCE_LINE 00002870 "=head2 digest"
NSQ_SOURCE_LINE 00002871 ""
NSQ_SOURCE_LINE 00002872 "    $obj = path(\"/tmp/foo.txt\")->digest;        # SHA-256"
NSQ_SOURCE_LINE 00002873 "    $obj = path(\"/tmp/foo.txt\")->digest(\"MD5\"); # user-selected"
NSQ_SOURCE_LINE 00002874 "    $obj = path(\"/tmp/foo.txt\")->digest( { chunk_size => 1e6 }, \"MD5\" );"
NSQ_SOURCE_LINE 00002875 ""
NSQ_SOURCE_LINE 00002876 "Returns a hexadecimal digest for a file.  An optional hash reference of options may"
NSQ_SOURCE_LINE 00002877 "be given.  The only option is C<chunk_size>.  If C<chunk_size> is given, that many"
NSQ_SOURCE_LINE 00002878 "bytes will be read at a time.  If not provided, the entire file will be slurped"
NSQ_SOURCE_LINE 00002879 "into memory to compute the digest."
NSQ_SOURCE_LINE 00002880 ""
NSQ_SOURCE_LINE 00002881 "Any subsequent arguments are passed to the constructor for L<Digest> to select"
NSQ_SOURCE_LINE 00002882 "an algorithm.  If no arguments are given, the default is SHA-256."
NSQ_SOURCE_LINE 00002883 ""
NSQ_SOURCE_LINE 00002884 "Current API available since 0.056."
NSQ_SOURCE_LINE 00002885 ""
NSQ_SOURCE_LINE 00002886 "=head2 dirname (deprecated)"
NSQ_SOURCE_LINE 00002887 ""
NSQ_SOURCE_LINE 00002888 "    $name = path(\"/tmp/foo.txt\")->dirname; # \"/tmp/\""
NSQ_SOURCE_LINE 00002889 ""
NSQ_SOURCE_LINE 00002890 "Returns the directory portion you would get from calling"
NSQ_SOURCE_LINE 00002891 "C<< File::Spec->splitpath( $path->stringify ) >> or C<\".\"> for a path without a"
NSQ_SOURCE_LINE 00002892 "parent directory portion.  Because L<File::Spec> is inconsistent, the result"
NSQ_SOURCE_LINE 00002893 "might or might not have a trailing slash.  Because of this, this method is"
NSQ_SOURCE_LINE 00002894 "B<deprecated>."
NSQ_SOURCE_LINE 00002895 ""
NSQ_SOURCE_LINE 00002896 "A better, more consistently approach is likely C<< $path->parent->stringify >>,"
NSQ_SOURCE_LINE 00002897 "which will not have a trailing slash except for a root directory."
NSQ_SOURCE_LINE 00002898 ""
NSQ_SOURCE_LINE 00002899 "Deprecated in 0.056."
NSQ_SOURCE_LINE 00002900 ""
NSQ_SOURCE_LINE 00002901 "=head2 edit, edit_raw, edit_utf8"
NSQ_SOURCE_LINE 00002902 ""
NSQ_SOURCE_LINE 00002903 "    path(\"foo.txt\")->edit( \\&callback, $options );"
NSQ_SOURCE_LINE 00002904 "    path(\"foo.txt\")->edit_utf8( \\&callback );"
NSQ_SOURCE_LINE 00002905 "    path(\"foo.txt\")->edit_raw( \\&callback );"
NSQ_SOURCE_LINE 00002906 ""
NSQ_SOURCE_LINE 00002907 "These are convenience methods that allow \"editing\" a file using a single"
NSQ_SOURCE_LINE 00002908 "callback argument. They slurp the file using C<slurp>, place the contents"
NSQ_SOURCE_LINE 00002909 "inside a localized C<$_> variable, call the callback function (without"
NSQ_SOURCE_LINE 00002910 "arguments), and then write C<$_> (presumably mutated) back to the"
NSQ_SOURCE_LINE 00002911 "file with C<spew>."
NSQ_SOURCE_LINE 00002912 ""
NSQ_SOURCE_LINE 00002913 "An optional hash reference may be used to pass options.  The only option is"
NSQ_SOURCE_LINE 00002914 "C<binmode>, which is passed to C<slurp> and C<spew>."
NSQ_SOURCE_LINE 00002915 ""
NSQ_SOURCE_LINE 00002916 "C<edit_utf8> and C<edit_raw> act like their respective C<slurp_*> and"
NSQ_SOURCE_LINE 00002917 "C<spew_*> methods."
NSQ_SOURCE_LINE 00002918 ""
NSQ_SOURCE_LINE 00002919 "Current API available since 0.077."
NSQ_SOURCE_LINE 00002920 ""
NSQ_SOURCE_LINE 00002921 "=head2 edit_lines, edit_lines_utf8, edit_lines_raw"
NSQ_SOURCE_LINE 00002922 ""
NSQ_SOURCE_LINE 00002923 "    path(\"foo.txt\")->edit_lines( \\&callback, $options );"
NSQ_SOURCE_LINE 00002924 "    path(\"foo.txt\")->edit_lines_utf8( \\&callback );"
NSQ_SOURCE_LINE 00002925 "    path(\"foo.txt\")->edit_lines_raw( \\&callback );"
NSQ_SOURCE_LINE 00002926 ""
NSQ_SOURCE_LINE 00002927 "These are convenience methods that allow \"editing\" a file's lines using a"
NSQ_SOURCE_LINE 00002928 "single callback argument.  They iterate over the file: for each line, the"
NSQ_SOURCE_LINE 00002929 "line is put into a localized C<$_> variable, the callback function is"
NSQ_SOURCE_LINE 00002930 "executed (without arguments) and then C<$_> is written to a temporary file."
NSQ_SOURCE_LINE 00002931 "When iteration is finished, the temporary file is atomically renamed over"
NSQ_SOURCE_LINE 00002932 "the original."
NSQ_SOURCE_LINE 00002933 ""
NSQ_SOURCE_LINE 00002934 "An optional hash reference may be used to pass options.  The only option is"
NSQ_SOURCE_LINE 00002935 "C<binmode>, which is passed to the method that open handles for reading and"
NSQ_SOURCE_LINE 00002936 "writing."
NSQ_SOURCE_LINE 00002937 ""
NSQ_SOURCE_LINE 00002938 "C<edit_lines_raw> is like C<edit_lines> with a buffered C<binmode> of"
NSQ_SOURCE_LINE 00002939 "C<:raw>."
NSQ_SOURCE_LINE 00002940 ""
NSQ_SOURCE_LINE 00002941 "C<edit_lines_utf8> is like C<edit_lines> with a buffered C<binmode>"
NSQ_SOURCE_LINE 00002942 "C<:raw:encoding(UTF-8)> (or C<:raw:utf8_strict> with"
NSQ_SOURCE_LINE 00002943 "L<PerlIO::utf8_strict>)."
NSQ_SOURCE_LINE 00002944 ""
NSQ_SOURCE_LINE 00002945 "Current API available since 0.077."
NSQ_SOURCE_LINE 00002946 ""
NSQ_SOURCE_LINE 00002947 "=head2 exists, is_file, is_dir"
NSQ_SOURCE_LINE 00002948 ""
NSQ_SOURCE_LINE 00002949 "    if ( path(\"/tmp\")->exists ) { ... }     # -e"
NSQ_SOURCE_LINE 00002950 "    if ( path(\"/tmp\")->is_dir ) { ... }     # -d"
NSQ_SOURCE_LINE 00002951 "    if ( path(\"/tmp\")->is_file ) { ... }    # -e && ! -d"
NSQ_SOURCE_LINE 00002952 ""
NSQ_SOURCE_LINE 00002953 "Implements file test operations, this means the file or directory actually has"
NSQ_SOURCE_LINE 00002954 "to exist on the filesystem.  Until then, it's just a path."
NSQ_SOURCE_LINE 00002955 ""
NSQ_SOURCE_LINE 00002956 "B<Note>: C<is_file> is not C<-f> because C<-f> is not the opposite of C<-d>."
NSQ_SOURCE_LINE 00002957 "C<-f> means \"plain file\", excluding symlinks, devices, etc. that often can be"
NSQ_SOURCE_LINE 00002958 "read just like files."
NSQ_SOURCE_LINE 00002959 ""
NSQ_SOURCE_LINE 00002960 "Use C<-f> instead if you really mean to check for a plain file."
NSQ_SOURCE_LINE 00002961 ""
NSQ_SOURCE_LINE 00002962 "Current API available since 0.053."
NSQ_SOURCE_LINE 00002963 ""
NSQ_SOURCE_LINE 00002964 "=head2 filehandle"
NSQ_SOURCE_LINE 00002965 ""
NSQ_SOURCE_LINE 00002966 "    $fh = path(\"/tmp/foo.txt\")->filehandle($mode, $binmode);"
NSQ_SOURCE_LINE 00002967 "    $fh = path(\"/tmp/foo.txt\")->filehandle({ locked => 1 }, $mode, $binmode);"
NSQ_SOURCE_LINE 00002968 "    $fh = path(\"/tmp/foo.txt\")->filehandle({ exclusive => 1  }, $mode, $binmode);"
NSQ_SOURCE_LINE 00002969 ""
NSQ_SOURCE_LINE 00002970 "Returns an open file handle.  The C<$mode> argument must be a Perl-style"
NSQ_SOURCE_LINE 00002971 "read/write mode string (\"<\" ,\">\", \">>\", etc.).  If a C<$binmode>"
NSQ_SOURCE_LINE 00002972 "is given, it is set during the C<open> call."
NSQ_SOURCE_LINE 00002973 ""
NSQ_SOURCE_LINE 00002974 "An optional hash reference may be used to pass options."
NSQ_SOURCE_LINE 00002975 ""
NSQ_SOURCE_LINE 00002976 "The C<locked> option governs file locking; if true, handles opened for writing,"
NSQ_SOURCE_LINE 00002977 "appending or read-write are locked with C<LOCK_EX>; otherwise, they are"
NSQ_SOURCE_LINE 00002978 "locked with C<LOCK_SH>.  When using C<locked>, \">\" or \"+>\" modes will delay"
NSQ_SOURCE_LINE 00002979 "truncation until after the lock is acquired."
NSQ_SOURCE_LINE 00002980 ""
NSQ_SOURCE_LINE 00002981 "The C<exclusive> option causes the open() call to fail if the file already"
NSQ_SOURCE_LINE 00002982 "exists.  This corresponds to the O_EXCL flag to sysopen / open(2)."
NSQ_SOURCE_LINE 00002983 "C<exclusive> implies C<locked> and will set it for you if you forget it."
NSQ_SOURCE_LINE 00002984 ""
NSQ_SOURCE_LINE 00002985 "See C<openr>, C<openw>, C<openrw>, and C<opena> for sugar."
NSQ_SOURCE_LINE 00002986 ""
NSQ_SOURCE_LINE 00002987 "Current API available since 0.066."
NSQ_SOURCE_LINE 00002988 ""
NSQ_SOURCE_LINE 00002989 "=head2 has_same_bytes"
NSQ_SOURCE_LINE 00002990 ""
NSQ_SOURCE_LINE 00002991 "    if ( path(\"foo.txt\")->has_same_bytes(\"bar.txt\") ) {"
NSQ_SOURCE_LINE 00002992 "       # ..."
NSQ_SOURCE_LINE 00002993 "    }"
NSQ_SOURCE_LINE 00002994 ""
NSQ_SOURCE_LINE 00002995 "This method returns true if both the invocant and the argument can be opened as"
NSQ_SOURCE_LINE 00002996 "file handles and the handles contain the same bytes.  It returns false if their"
NSQ_SOURCE_LINE 00002997 "contents differ.  If either can't be opened as a file (e.g. a directory or"
NSQ_SOURCE_LINE 00002998 "non-existent file), the method throws an exception.  If both can be opened and"
NSQ_SOURCE_LINE 00002999 "both have the same C<realpath>, the method returns true without scanning any"
NSQ_SOURCE_LINE 00003000 "data."
NSQ_SOURCE_LINE 00003001 ""
NSQ_SOURCE_LINE 00003002 "Current API available since 0.125."
NSQ_SOURCE_LINE 00003003 ""
NSQ_SOURCE_LINE 00003004 "=head2 is_absolute, is_relative"
NSQ_SOURCE_LINE 00003005 ""
NSQ_SOURCE_LINE 00003006 "    if ( path(\"/tmp\")->is_absolute ) { ... }"
NSQ_SOURCE_LINE 00003007 "    if ( path(\"/tmp\")->is_relative ) { ... }"
NSQ_SOURCE_LINE 00003008 ""
NSQ_SOURCE_LINE 00003009 "Booleans for whether the path appears absolute or relative."
NSQ_SOURCE_LINE 00003010 ""
NSQ_SOURCE_LINE 00003011 "Current API available since 0.001."
NSQ_SOURCE_LINE 00003012 ""
NSQ_SOURCE_LINE 00003013 "=head2 is_rootdir"
NSQ_SOURCE_LINE 00003014 ""
NSQ_SOURCE_LINE 00003015 "    while ( ! $path->is_rootdir ) {"
NSQ_SOURCE_LINE 00003016 "        $path = $path->parent;"
NSQ_SOURCE_LINE 00003017 "        ..."
NSQ_SOURCE_LINE 00003018 "    }"
NSQ_SOURCE_LINE 00003019 ""
NSQ_SOURCE_LINE 00003020 "Boolean for whether the path is the root directory of the volume.  I.e. the"
NSQ_SOURCE_LINE 00003021 "C<dirname> is C<q[/]> and the C<basename> is C<q[]>."
NSQ_SOURCE_LINE 00003022 ""
NSQ_SOURCE_LINE 00003023 "This works even on C<MSWin32> with drives and UNC volumes:"
NSQ_SOURCE_LINE 00003024 ""
NSQ_SOURCE_LINE 00003025 "    path(\"C:/\")->is_rootdir;             # true"
NSQ_SOURCE_LINE 00003026 "    path(\"//server/share/\")->is_rootdir; #true"
NSQ_SOURCE_LINE 00003027 ""
NSQ_SOURCE_LINE 00003028 "Current API available since 0.038."
NSQ_SOURCE_LINE 00003029 ""
NSQ_SOURCE_LINE 00003030 "=head2 iterator"
NSQ_SOURCE_LINE 00003031 ""
NSQ_SOURCE_LINE 00003032 "    $iter = path(\"/tmp\")->iterator( \\%options );"
NSQ_SOURCE_LINE 00003033 ""
NSQ_SOURCE_LINE 00003034 "Returns a code reference that walks a directory lazily.  Each invocation"
NSQ_SOURCE_LINE 00003035 "returns a C<Path::Tiny> object or undef when the iterator is exhausted."
NSQ_SOURCE_LINE 00003036 ""
NSQ_SOURCE_LINE 00003037 "    $iter = path(\"/tmp\")->iterator;"
NSQ_SOURCE_LINE 00003038 "    while ( $path = $iter->() ) {"
NSQ_SOURCE_LINE 00003039 "        ..."
NSQ_SOURCE_LINE 00003040 "    }"
NSQ_SOURCE_LINE 00003041 ""
NSQ_SOURCE_LINE 00003042 "The current and parent directory entries (\".\" and \"..\") will not"
NSQ_SOURCE_LINE 00003043 "be included."
NSQ_SOURCE_LINE 00003044 ""
NSQ_SOURCE_LINE 00003045 "If the C<recurse> option is true, the iterator will walk the directory"
NSQ_SOURCE_LINE 00003046 "recursively, breadth-first.  If the C<follow_symlinks> option is also true,"
NSQ_SOURCE_LINE 00003047 "directory links will be followed recursively.  There is no protection against"
NSQ_SOURCE_LINE 00003048 "loops when following links. If a directory is not readable, it will not be"
NSQ_SOURCE_LINE 00003049 "followed."
NSQ_SOURCE_LINE 00003050 ""
NSQ_SOURCE_LINE 00003051 "The default is the same as:"
NSQ_SOURCE_LINE 00003052 ""
NSQ_SOURCE_LINE 00003053 "    $iter = path(\"/tmp\")->iterator( {"
NSQ_SOURCE_LINE 00003054 "        recurse         => 0,"
NSQ_SOURCE_LINE 00003055 "        follow_symlinks => 0,"
NSQ_SOURCE_LINE 00003056 "    } );"
NSQ_SOURCE_LINE 00003057 ""
NSQ_SOURCE_LINE 00003058 "For a more powerful, recursive iterator with built-in loop avoidance, see"
NSQ_SOURCE_LINE 00003059 "L<Path::Iterator::Rule>."
NSQ_SOURCE_LINE 00003060 ""
NSQ_SOURCE_LINE 00003061 "See also L</visit>."
NSQ_SOURCE_LINE 00003062 ""
NSQ_SOURCE_LINE 00003063 "Current API available since 0.016."
NSQ_SOURCE_LINE 00003064 ""
NSQ_SOURCE_LINE 00003065 "=head2 lines, lines_raw, lines_utf8"
NSQ_SOURCE_LINE 00003066 ""
NSQ_SOURCE_LINE 00003067 "    @contents = path(\"/tmp/foo.txt\")->lines;"
NSQ_SOURCE_LINE 00003068 "    @contents = path(\"/tmp/foo.txt\")->lines(\\%options);"
NSQ_SOURCE_LINE 00003069 "    @contents = path(\"/tmp/foo.txt\")->lines_raw;"
NSQ_SOURCE_LINE 00003070 "    @contents = path(\"/tmp/foo.txt\")->lines_utf8;"
NSQ_SOURCE_LINE 00003071 ""
NSQ_SOURCE_LINE 00003072 "    @contents = path(\"/tmp/foo.txt\")->lines( { chomp => 1, count => 4 } );"
NSQ_SOURCE_LINE 00003073 ""
NSQ_SOURCE_LINE 00003074 "Returns a list of lines from a file.  Optionally takes a hash-reference of"
NSQ_SOURCE_LINE 00003075 "options.  Valid options are C<binmode>, C<count> and C<chomp>."
NSQ_SOURCE_LINE 00003076 ""
NSQ_SOURCE_LINE 00003077 "If C<binmode> is provided, it will be set on the handle prior to reading."
NSQ_SOURCE_LINE 00003078 ""
NSQ_SOURCE_LINE 00003079 "If a positive C<count> is provided, that many lines will be returned from the"
NSQ_SOURCE_LINE 00003080 "start of the file.  If a negative C<count> is provided, the entire file will be"
NSQ_SOURCE_LINE 00003081 "read, but only C<abs(count)> will be kept and returned.  If C<abs(count)>"
NSQ_SOURCE_LINE 00003082 "exceeds the number of lines in the file, all lines will be returned."
NSQ_SOURCE_LINE 00003083 ""
NSQ_SOURCE_LINE 00003084 "If C<chomp> is set, any end-of-line character sequences (C<CR>, C<CRLF>, or"
NSQ_SOURCE_LINE 00003085 "C<LF>) will be removed from the lines returned."
NSQ_SOURCE_LINE 00003086 ""
NSQ_SOURCE_LINE 00003087 "Because the return is a list, C<lines> in scalar context will return the number"
NSQ_SOURCE_LINE 00003088 "of lines (and throw away the data)."
NSQ_SOURCE_LINE 00003089 ""
NSQ_SOURCE_LINE 00003090 "    $number_of_lines = path(\"/tmp/foo.txt\")->lines;"
NSQ_SOURCE_LINE 00003091 ""
NSQ_SOURCE_LINE 00003092 "C<lines_raw> is like C<lines> with a C<binmode> of C<:raw>.  We use C<:raw>"
NSQ_SOURCE_LINE 00003093 "instead of C<:unix> so PerlIO buffering can manage reading by line."
NSQ_SOURCE_LINE 00003094 ""
NSQ_SOURCE_LINE 00003095 "C<lines_utf8> is like C<lines> with a C<binmode> of C<:raw:encoding(UTF-8)>"
NSQ_SOURCE_LINE 00003096 "(or C<:raw:utf8_strict> with L<PerlIO::utf8_strict>).  If L<Unicode::UTF8>"
NSQ_SOURCE_LINE 00003097 "0.58+ is installed, a raw, unbuffered UTF-8 slurp will be done and then the"
NSQ_SOURCE_LINE 00003098 "lines will be split.  This is actually faster than relying on"
NSQ_SOURCE_LINE 00003099 "IO layers, though a bit memory intensive.  If memory use is a"
NSQ_SOURCE_LINE 00003100 "concern, consider C<openr_utf8> and iterating directly on the handle."
NSQ_SOURCE_LINE 00003101 ""
NSQ_SOURCE_LINE 00003102 "See also L</slurp> if you want to load a file as a whole chunk."
NSQ_SOURCE_LINE 00003103 ""
NSQ_SOURCE_LINE 00003104 "Current API available since 0.065."
NSQ_SOURCE_LINE 00003105 ""
NSQ_SOURCE_LINE 00003106 "=head2 mkdir"
NSQ_SOURCE_LINE 00003107 ""
NSQ_SOURCE_LINE 00003108 "    path(\"foo/bar/baz\")->mkdir;"
NSQ_SOURCE_LINE 00003109 "    path(\"foo/bar/baz\")->mkdir( \\%options );"
NSQ_SOURCE_LINE 00003110 ""
NSQ_SOURCE_LINE 00003111 "Like calling C<make_path> from L<File::Path>.  An optional hash reference"
NSQ_SOURCE_LINE 00003112 "is passed through to C<make_path>.  Errors will be trapped and an exception"
NSQ_SOURCE_LINE 00003113 "thrown.  Returns the the path object to facilitate chaining."
NSQ_SOURCE_LINE 00003114 ""
NSQ_SOURCE_LINE 00003115 "B<NOTE>: unlike Perl's builtin C<mkdir>, this will create intermediate paths"
NSQ_SOURCE_LINE 00003116 "similar to the Unix C<mkdir -p> command.  It will not error if applied to an"
NSQ_SOURCE_LINE 00003117 "existing directory."
NSQ_SOURCE_LINE 00003118 ""
NSQ_SOURCE_LINE 00003119 "Passing a defined argument I<other> than a hash reference is an error, and an"
NSQ_SOURCE_LINE 00003120 "exception will be thrown."
NSQ_SOURCE_LINE 00003121 ""
NSQ_SOURCE_LINE 00003122 "Current API available since 0.125."
NSQ_SOURCE_LINE 00003123 ""
NSQ_SOURCE_LINE 00003124 "=head2 mkpath (deprecated)"
NSQ_SOURCE_LINE 00003125 ""
NSQ_SOURCE_LINE 00003126 "Like calling C<mkdir>, but returns the list of directories created or an empty list if"
NSQ_SOURCE_LINE 00003127 "the directories already exist, just like C<make_path>."
NSQ_SOURCE_LINE 00003128 ""
NSQ_SOURCE_LINE 00003129 "Passing a defined argument I<other> than a hash reference is an error, and an"
NSQ_SOURCE_LINE 00003130 "exception will be thrown."
NSQ_SOURCE_LINE 00003131 ""
NSQ_SOURCE_LINE 00003132 "Deprecated in 0.125."
NSQ_SOURCE_LINE 00003133 ""
NSQ_SOURCE_LINE 00003134 "=head2 move"
NSQ_SOURCE_LINE 00003135 ""
NSQ_SOURCE_LINE 00003136 "    path(\"foo.txt\")->move(\"bar.txt\");"
NSQ_SOURCE_LINE 00003137 ""
NSQ_SOURCE_LINE 00003138 "Moves the current path to the given destination using L<File::Copy>'s"
NSQ_SOURCE_LINE 00003139 "C<move> function. Upon success, returns the C<Path::Tiny> object for the"
NSQ_SOURCE_LINE 00003140 "newly moved file."
NSQ_SOURCE_LINE 00003141 ""
NSQ_SOURCE_LINE 00003142 "If the destination already exists and is a directory, and the source is not a"
NSQ_SOURCE_LINE 00003143 "directory, then the source file will be renamed into the directory"
NSQ_SOURCE_LINE 00003144 "specified by the destination."
NSQ_SOURCE_LINE 00003145 ""
NSQ_SOURCE_LINE 00003146 "If possible, move() will simply rename the file. Otherwise, it"
NSQ_SOURCE_LINE 00003147 "copies the file to the new location and deletes the original. If an"
NSQ_SOURCE_LINE 00003148 "error occurs during this copy-and-delete process, you may be left"
NSQ_SOURCE_LINE 00003149 "with a (possibly partial) copy of the file under the destination"
NSQ_SOURCE_LINE 00003150 "name."
NSQ_SOURCE_LINE 00003151 ""
NSQ_SOURCE_LINE 00003152 "Current API available since 0.124. Prior versions used Perl's"
NSQ_SOURCE_LINE 00003153 "-built-in (and less robust) L<rename|perlfunc/rename> function"
NSQ_SOURCE_LINE 00003154 "and did not return an object."
NSQ_SOURCE_LINE 00003155 ""
NSQ_SOURCE_LINE 00003156 "=head2 openr, openw, openrw, opena"
NSQ_SOURCE_LINE 00003157 ""
NSQ_SOURCE_LINE 00003158 "    $fh = path(\"foo.txt\")->openr($binmode);  # read"
NSQ_SOURCE_LINE 00003159 "    $fh = path(\"foo.txt\")->openr_raw;"
NSQ_SOURCE_LINE 00003160 "    $fh = path(\"foo.txt\")->openr_utf8;"
NSQ_SOURCE_LINE 00003161 ""
NSQ_SOURCE_LINE 00003162 "    $fh = path(\"foo.txt\")->openw($binmode);  # write"
NSQ_SOURCE_LINE 00003163 "    $fh = path(\"foo.txt\")->openw_raw;"
NSQ_SOURCE_LINE 00003164 "    $fh = path(\"foo.txt\")->openw_utf8;"
NSQ_SOURCE_LINE 00003165 ""
NSQ_SOURCE_LINE 00003166 "    $fh = path(\"foo.txt\")->opena($binmode);  # append"
NSQ_SOURCE_LINE 00003167 "    $fh = path(\"foo.txt\")->opena_raw;"
NSQ_SOURCE_LINE 00003168 "    $fh = path(\"foo.txt\")->opena_utf8;"
NSQ_SOURCE_LINE 00003169 ""
NSQ_SOURCE_LINE 00003170 "    $fh = path(\"foo.txt\")->openrw($binmode); # read/write"
NSQ_SOURCE_LINE 00003171 "    $fh = path(\"foo.txt\")->openrw_raw;"
NSQ_SOURCE_LINE 00003172 "    $fh = path(\"foo.txt\")->openrw_utf8;"
NSQ_SOURCE_LINE 00003173 ""
NSQ_SOURCE_LINE 00003174 "Returns a file handle opened in the specified mode.  The C<openr> style methods"
NSQ_SOURCE_LINE 00003175 "take a single C<binmode> argument.  All of the C<open*> methods have"
NSQ_SOURCE_LINE 00003176 "C<open*_raw> and C<open*_utf8> equivalents that use buffered I/O layers C<:raw>"
NSQ_SOURCE_LINE 00003177 "and C<:raw:encoding(UTF-8)> (or C<:raw:utf8_strict> with"
NSQ_SOURCE_LINE 00003178 "L<PerlIO::utf8_strict>)."
NSQ_SOURCE_LINE 00003179 ""
NSQ_SOURCE_LINE 00003180 "An optional hash reference may be used to pass options.  The only option is"
NSQ_SOURCE_LINE 00003181 "C<locked>.  If true, handles opened for writing, appending or read-write are"
NSQ_SOURCE_LINE 00003182 "locked with C<LOCK_EX>; otherwise, they are locked for C<LOCK_SH>."
NSQ_SOURCE_LINE 00003183 ""
NSQ_SOURCE_LINE 00003184 "    $fh = path(\"foo.txt\")->openrw_utf8( { locked => 1 } );"
NSQ_SOURCE_LINE 00003185 ""
NSQ_SOURCE_LINE 00003186 "See L</filehandle> for more on locking."
NSQ_SOURCE_LINE 00003187 ""
NSQ_SOURCE_LINE 00003188 "Current API available since 0.011."
NSQ_SOURCE_LINE 00003189 ""
NSQ_SOURCE_LINE 00003190 "=head2 parent"
NSQ_SOURCE_LINE 00003191 ""
NSQ_SOURCE_LINE 00003192 "    $parent = path(\"foo/bar/baz\")->parent; # foo/bar"
NSQ_SOURCE_LINE 00003193 "    $parent = path(\"foo/wibble.txt\")->parent; # foo"
NSQ_SOURCE_LINE 00003194 ""
NSQ_SOURCE_LINE 00003195 "    $parent = path(\"foo/bar/baz\")->parent(2); # foo"
NSQ_SOURCE_LINE 00003196 ""
NSQ_SOURCE_LINE 00003197 "Returns a C<Path::Tiny> object corresponding to the parent directory of the"
NSQ_SOURCE_LINE 00003198 "original directory or file. An optional positive integer argument is the number"
NSQ_SOURCE_LINE 00003199 "of parent directories upwards to return.  C<parent> by itself is equivalent to"
NSQ_SOURCE_LINE 00003200 "C<parent(1)>."
NSQ_SOURCE_LINE 00003201 ""
NSQ_SOURCE_LINE 00003202 "Current API available since 0.014."
NSQ_SOURCE_LINE 00003203 ""
NSQ_SOURCE_LINE 00003204 "=head2 realpath"
NSQ_SOURCE_LINE 00003205 ""
NSQ_SOURCE_LINE 00003206 "    $real = path(\"/baz/foo/../bar\")->realpath;"
NSQ_SOURCE_LINE 00003207 "    $real = path(\"foo/../bar\")->realpath;"
NSQ_SOURCE_LINE 00003208 ""
NSQ_SOURCE_LINE 00003209 "Returns a new C<Path::Tiny> object with all symbolic links and upward directory"
NSQ_SOURCE_LINE 00003210 "parts resolved using L<Cwd>'s C<realpath>.  Compared to C<absolute>, this is"
NSQ_SOURCE_LINE 00003211 "more expensive as it must actually consult the filesystem."
NSQ_SOURCE_LINE 00003212 ""
NSQ_SOURCE_LINE 00003213 "If the parent path can't be resolved (e.g. if it includes directories that"
NSQ_SOURCE_LINE 00003214 "don't exist), an exception will be thrown:"
NSQ_SOURCE_LINE 00003215 ""
NSQ_SOURCE_LINE 00003216 "    $real = path(\"doesnt_exist/foo\")->realpath; # dies"
NSQ_SOURCE_LINE 00003217 ""
NSQ_SOURCE_LINE 00003218 "However, if the parent path exists and only the last component (e.g. filename)"
NSQ_SOURCE_LINE 00003219 "doesn't exist, the realpath will be the realpath of the parent plus the"
NSQ_SOURCE_LINE 00003220 "non-existent last component:"
NSQ_SOURCE_LINE 00003221 ""
NSQ_SOURCE_LINE 00003222 "    $real = path(\"./aasdlfasdlf\")->realpath; # works"
NSQ_SOURCE_LINE 00003223 ""
NSQ_SOURCE_LINE 00003224 "The underlying L<Cwd> module usually worked this way on Unix, but died on"
NSQ_SOURCE_LINE 00003225 "Windows (and some Unixes) if the full path didn't exist.  As of version 0.064,"
NSQ_SOURCE_LINE 00003226 "it's safe to use anywhere."
NSQ_SOURCE_LINE 00003227 ""
NSQ_SOURCE_LINE 00003228 "Current API available since 0.001."
NSQ_SOURCE_LINE 00003229 ""
NSQ_SOURCE_LINE 00003230 "=head2 relative"
NSQ_SOURCE_LINE 00003231 ""
NSQ_SOURCE_LINE 00003232 "    $rel = path(\"/tmp/foo/bar\")->relative(\"/tmp\"); # foo/bar"
NSQ_SOURCE_LINE 00003233 ""
NSQ_SOURCE_LINE 00003234 "Returns a C<Path::Tiny> object with a path relative to a new base path"
NSQ_SOURCE_LINE 00003235 "given as an argument.  If no argument is given, the current directory will"
NSQ_SOURCE_LINE 00003236 "be used as the new base path."
NSQ_SOURCE_LINE 00003237 ""
NSQ_SOURCE_LINE 00003238 "If either path is already relative, it will be made absolute based on the"
NSQ_SOURCE_LINE 00003239 "current directly before determining the new relative path."
NSQ_SOURCE_LINE 00003240 ""
NSQ_SOURCE_LINE 00003241 "The algorithm is roughly as follows:"
NSQ_SOURCE_LINE 00003242 ""
NSQ_SOURCE_LINE 00003243 "=over 4"
NSQ_SOURCE_LINE 00003244 ""
NSQ_SOURCE_LINE 00003245 "=item *"
NSQ_SOURCE_LINE 00003246 ""
NSQ_SOURCE_LINE 00003247 "If the original and new base path are on different volumes, an exception will be thrown."
NSQ_SOURCE_LINE 00003248 ""
NSQ_SOURCE_LINE 00003249 "=item *"
NSQ_SOURCE_LINE 00003250 ""
NSQ_SOURCE_LINE 00003251 "If the original and new base are identical, the relative path is C<\".\">."
NSQ_SOURCE_LINE 00003252 ""
NSQ_SOURCE_LINE 00003253 "=item *"
NSQ_SOURCE_LINE 00003254 ""
NSQ_SOURCE_LINE 00003255 "If the new base subsumes the original, the relative path is the original path with the new base chopped off the front"
NSQ_SOURCE_LINE 00003256 ""
NSQ_SOURCE_LINE 00003257 "=item *"
NSQ_SOURCE_LINE 00003258 ""
NSQ_SOURCE_LINE 00003259 "If the new base does not subsume the original, a common prefix path is determined (possibly the root directory) and the relative path will consist of updirs (C<\"..\">) to reach the common prefix, followed by the original path less the common prefix."
NSQ_SOURCE_LINE 00003260 ""
NSQ_SOURCE_LINE 00003261 "=back"
NSQ_SOURCE_LINE 00003262 ""
NSQ_SOURCE_LINE 00003263 "Unlike C<File::Spec::abs2rel>, in the last case above, the calculation based"
NSQ_SOURCE_LINE 00003264 "on a common prefix takes into account symlinks that could affect the updir"
NSQ_SOURCE_LINE 00003265 "process.  Given an original path \"/A/B\" and a new base \"/A/C\","
NSQ_SOURCE_LINE 00003266 "(where \"A\", \"B\" and \"C\" could each have multiple path components):"
NSQ_SOURCE_LINE 00003267 ""
NSQ_SOURCE_LINE 00003268 "=over 4"
NSQ_SOURCE_LINE 00003269 ""
NSQ_SOURCE_LINE 00003270 "=item *"
NSQ_SOURCE_LINE 00003271 ""
NSQ_SOURCE_LINE 00003272 "Symlinks in \"A\" don't change the result unless the last component of A is a symlink and the first component of \"C\" is an updir."
NSQ_SOURCE_LINE 00003273 ""
NSQ_SOURCE_LINE 00003274 "=item *"
NSQ_SOURCE_LINE 00003275 ""
NSQ_SOURCE_LINE 00003276 "Symlinks in \"B\" don't change the result and will exist in the result as given."
NSQ_SOURCE_LINE 00003277 ""
NSQ_SOURCE_LINE 00003278 "=item *"
NSQ_SOURCE_LINE 00003279 ""
NSQ_SOURCE_LINE 00003280 "Symlinks and updirs in \"C\" must be resolved to actual paths, taking into account the possibility that not all path components might exist on the filesystem."
NSQ_SOURCE_LINE 00003281 ""
NSQ_SOURCE_LINE 00003282 "=back"
NSQ_SOURCE_LINE 00003283 ""
NSQ_SOURCE_LINE 00003284 "Current API available since 0.001.  New algorithm (that accounts for"
NSQ_SOURCE_LINE 00003285 "symlinks) available since 0.079."
NSQ_SOURCE_LINE 00003286 ""
NSQ_SOURCE_LINE 00003287 "=head2 remove"
NSQ_SOURCE_LINE 00003288 ""
NSQ_SOURCE_LINE 00003289 "    path(\"foo.txt\")->remove;"
NSQ_SOURCE_LINE 00003290 ""
NSQ_SOURCE_LINE 00003291 "This is just like C<unlink>, except for its error handling: if the path does"
NSQ_SOURCE_LINE 00003292 "not exist, it returns false; if deleting the file fails, it throws an"
NSQ_SOURCE_LINE 00003293 "exception."
NSQ_SOURCE_LINE 00003294 ""
NSQ_SOURCE_LINE 00003295 "Current API available since 0.012."
NSQ_SOURCE_LINE 00003296 ""
NSQ_SOURCE_LINE 00003297 "=head2 remove_tree"
NSQ_SOURCE_LINE 00003298 ""
NSQ_SOURCE_LINE 00003299 "    # directory"
NSQ_SOURCE_LINE 00003300 "    path(\"foo/bar/baz\")->remove_tree;"
NSQ_SOURCE_LINE 00003301 "    path(\"foo/bar/baz\")->remove_tree( \\%options );"
NSQ_SOURCE_LINE 00003302 "    path(\"foo/bar/baz\")->remove_tree( { safe => 0 } ); # force remove"
NSQ_SOURCE_LINE 00003303 ""
NSQ_SOURCE_LINE 00003304 "Like calling C<remove_tree> from L<File::Path>, but defaults to C<safe> mode."
NSQ_SOURCE_LINE 00003305 "An optional hash reference is passed through to C<remove_tree>.  Errors will be"
NSQ_SOURCE_LINE 00003306 "trapped and an exception thrown.  Returns the number of directories deleted,"
NSQ_SOURCE_LINE 00003307 "just like C<remove_tree>."
NSQ_SOURCE_LINE 00003308 ""
NSQ_SOURCE_LINE 00003309 "If you want to remove a directory only if it is empty, use the built-in"
NSQ_SOURCE_LINE 00003310 "C<rmdir> function instead."
NSQ_SOURCE_LINE 00003311 ""
NSQ_SOURCE_LINE 00003312 "    rmdir path(\"foo/bar/baz/\");"
NSQ_SOURCE_LINE 00003313 ""
NSQ_SOURCE_LINE 00003314 "Current API available since 0.013."
NSQ_SOURCE_LINE 00003315 ""
NSQ_SOURCE_LINE 00003316 "Passing a defined argument I<other> than a hash reference is an error, and an"
NSQ_SOURCE_LINE 00003317 "exception will be thrown."
NSQ_SOURCE_LINE 00003318 ""
NSQ_SOURCE_LINE 00003319 "=head2 sibling"
NSQ_SOURCE_LINE 00003320 ""
NSQ_SOURCE_LINE 00003321 "    $foo = path(\"/tmp/foo.txt\");"
NSQ_SOURCE_LINE 00003322 "    $sib = $foo->sibling(\"bar.txt\");        # /tmp/bar.txt"
NSQ_SOURCE_LINE 00003323 "    $sib = $foo->sibling(\"baz\", \"bam.txt\"); # /tmp/baz/bam.txt"
NSQ_SOURCE_LINE 00003324 ""
NSQ_SOURCE_LINE 00003325 "Returns a new C<Path::Tiny> object relative to the parent of the original."
NSQ_SOURCE_LINE 00003326 "This is slightly more efficient than C<< $path->parent->child(...) >>."
NSQ_SOURCE_LINE 00003327 ""
NSQ_SOURCE_LINE 00003328 "Current API available since 0.058."
NSQ_SOURCE_LINE 00003329 ""
NSQ_SOURCE_LINE 00003330 "=head2 size, size_human"
NSQ_SOURCE_LINE 00003331 ""
NSQ_SOURCE_LINE 00003332 "    my $p = path(\"foo\"); # with size 1025 bytes"
NSQ_SOURCE_LINE 00003333 ""
NSQ_SOURCE_LINE 00003334 "    $p->size;                            # \"1025\""
NSQ_SOURCE_LINE 00003335 "    $p->size_human;                      # \"1.1 K\""
NSQ_SOURCE_LINE 00003336 "    $p->size_human( {format => \"iec\"} ); # \"1.1 KiB\""
NSQ_SOURCE_LINE 00003337 ""
NSQ_SOURCE_LINE 00003338 "Returns the size of a file.  The C<size> method is just a wrapper around C<-s>."
NSQ_SOURCE_LINE 00003339 ""
NSQ_SOURCE_LINE 00003340 "The C<size_human> method provides a human-readable string similar to"
NSQ_SOURCE_LINE 00003341 "C<ls -lh>.  Like C<ls>, it rounds upwards and provides one decimal place for"
NSQ_SOURCE_LINE 00003342 "single-digit sizes and no decimal places for larger sizes.  The only available"
NSQ_SOURCE_LINE 00003343 "option is C<format>, which has three valid values:"
NSQ_SOURCE_LINE 00003344 ""
NSQ_SOURCE_LINE 00003345 "=over 4"
NSQ_SOURCE_LINE 00003346 ""
NSQ_SOURCE_LINE 00003347 "=item *"
NSQ_SOURCE_LINE 00003348 ""
NSQ_SOURCE_LINE 00003349 "'ls' (the default): base-2 sizes, with C<ls> style single-letter suffixes (K, M, etc.)"
NSQ_SOURCE_LINE 00003350 ""
NSQ_SOURCE_LINE 00003351 "=item *"
NSQ_SOURCE_LINE 00003352 ""
NSQ_SOURCE_LINE 00003353 "'iec': base-2 sizes, with IEC binary suffixes (KiB, MiB, etc.)"
NSQ_SOURCE_LINE 00003354 ""
NSQ_SOURCE_LINE 00003355 "=item *"
NSQ_SOURCE_LINE 00003356 ""
NSQ_SOURCE_LINE 00003357 "'si': base-10 sizes, with SI decimal suffixes (kB, MB, etc.)"
NSQ_SOURCE_LINE 00003358 ""
NSQ_SOURCE_LINE 00003359 "=back"
NSQ_SOURCE_LINE 00003360 ""
NSQ_SOURCE_LINE 00003361 "If C<-s> would return C<undef>, C<size_human> returns the empty string."
NSQ_SOURCE_LINE 00003362 ""
NSQ_SOURCE_LINE 00003363 "Current API available since 0.122."
NSQ_SOURCE_LINE 00003364 ""
NSQ_SOURCE_LINE 00003365 "=head2 slurp, slurp_raw, slurp_utf8"
NSQ_SOURCE_LINE 00003366 ""
NSQ_SOURCE_LINE 00003367 "    $data = path(\"foo.txt\")->slurp;"
NSQ_SOURCE_LINE 00003368 "    $data = path(\"foo.txt\")->slurp( {binmode => \":raw\"} );"
NSQ_SOURCE_LINE 00003369 "    $data = path(\"foo.txt\")->slurp_raw;"
NSQ_SOURCE_LINE 00003370 "    $data = path(\"foo.txt\")->slurp_utf8;"
NSQ_SOURCE_LINE 00003371 ""
NSQ_SOURCE_LINE 00003372 "Reads file contents into a scalar.  Takes an optional hash reference which may"
NSQ_SOURCE_LINE 00003373 "be used to pass options.  The only available option is C<binmode>, which is"
NSQ_SOURCE_LINE 00003374 "passed to C<binmode()> on the handle used for reading."
NSQ_SOURCE_LINE 00003375 ""
NSQ_SOURCE_LINE 00003376 "C<slurp_raw> is like C<slurp> with a C<binmode> of C<:unix> for"
NSQ_SOURCE_LINE 00003377 "a fast, unbuffered, raw read."
NSQ_SOURCE_LINE 00003378 ""
NSQ_SOURCE_LINE 00003379 "C<slurp_utf8> is like C<slurp> with a C<binmode> of"
NSQ_SOURCE_LINE 00003380 "C<:unix:encoding(UTF-8)> (or C<:unix:utf8_strict> with"
NSQ_SOURCE_LINE 00003381 "L<PerlIO::utf8_strict>).  If L<Unicode::UTF8> 0.58+ is installed, a"
NSQ_SOURCE_LINE 00003382 "unbuffered, raw slurp will be done instead and the result decoded with"
NSQ_SOURCE_LINE 00003383 "C<Unicode::UTF8>. This is just as strict and is roughly an order of"
NSQ_SOURCE_LINE 00003384 "magnitude faster than using C<:encoding(UTF-8)>."
NSQ_SOURCE_LINE 00003385 ""
NSQ_SOURCE_LINE 00003386 "B<Note>: C<slurp> and friends lock the filehandle before slurping.  If"
NSQ_SOURCE_LINE 00003387 "you plan to slurp from a file created with L<File::Temp>, be sure to"
NSQ_SOURCE_LINE 00003388 "close other handles or open without locking to avoid a deadlock:"
NSQ_SOURCE_LINE 00003389 ""
NSQ_SOURCE_LINE 00003390 "    my $tempfile = File::Temp->new(EXLOCK => 0);"
NSQ_SOURCE_LINE 00003391 "    my $guts = path($tempfile)->slurp;"
NSQ_SOURCE_LINE 00003392 ""
NSQ_SOURCE_LINE 00003393 "See also L</lines> if you want to slurp a file into a line array."
NSQ_SOURCE_LINE 00003394 ""
NSQ_SOURCE_LINE 00003395 "Current API available since 0.004."
NSQ_SOURCE_LINE 00003396 ""
NSQ_SOURCE_LINE 00003397 "=head2 spew, spew_raw, spew_utf8"
NSQ_SOURCE_LINE 00003398 ""
NSQ_SOURCE_LINE 00003399 "    path(\"foo.txt\")->spew(@data);"
NSQ_SOURCE_LINE 00003400 "    path(\"foo.txt\")->spew(\\@data);"
NSQ_SOURCE_LINE 00003401 "    path(\"foo.txt\")->spew({binmode => \":raw\"}, @data);"
NSQ_SOURCE_LINE 00003402 "    path(\"foo.txt\")->spew_raw(@data);"
NSQ_SOURCE_LINE 00003403 "    path(\"foo.txt\")->spew_utf8(@data);"
NSQ_SOURCE_LINE 00003404 ""
NSQ_SOURCE_LINE 00003405 "Writes data to a file atomically.  The file is written to a temporary file in"
NSQ_SOURCE_LINE 00003406 "the same directory, then renamed over the original.  An optional hash reference"
NSQ_SOURCE_LINE 00003407 "may be used to pass options.  The only option is C<binmode>, which is passed to"
NSQ_SOURCE_LINE 00003408 "C<binmode()> on the handle used for writing."
NSQ_SOURCE_LINE 00003409 ""
NSQ_SOURCE_LINE 00003410 "C<spew_raw> is like C<spew> with a C<binmode> of C<:unix> for a fast,"
NSQ_SOURCE_LINE 00003411 "unbuffered, raw write."
NSQ_SOURCE_LINE 00003412 ""
NSQ_SOURCE_LINE 00003413 "C<spew_utf8> is like C<spew> with a C<binmode> of C<:unix:encoding(UTF-8)>"
NSQ_SOURCE_LINE 00003414 "(or C<:unix:utf8_strict> with L<PerlIO::utf8_strict>).  If L<Unicode::UTF8>"
NSQ_SOURCE_LINE 00003415 "0.58+ is installed, a raw, unbuffered spew will be done instead on the data"
NSQ_SOURCE_LINE 00003416 "encoded with C<Unicode::UTF8>."
NSQ_SOURCE_LINE 00003417 ""
NSQ_SOURCE_LINE 00003418 "B<NOTE>: because the file is written to a temporary file and then renamed, the"
NSQ_SOURCE_LINE 00003419 "new file will wind up with permissions based on your current umask.  This is a"
NSQ_SOURCE_LINE 00003420 "feature to protect you from a race condition that would otherwise give"
NSQ_SOURCE_LINE 00003421 "different permissions than you might expect.  If you really want to keep the"
NSQ_SOURCE_LINE 00003422 "original mode flags, use L</append> with the C<truncate> option."
NSQ_SOURCE_LINE 00003423 ""
NSQ_SOURCE_LINE 00003424 "Current API available since 0.011."
NSQ_SOURCE_LINE 00003425 ""
NSQ_SOURCE_LINE 00003426 "=head2 stat, lstat"
NSQ_SOURCE_LINE 00003427 ""
NSQ_SOURCE_LINE 00003428 "    $stat = path(\"foo.txt\")->stat;"
NSQ_SOURCE_LINE 00003429 "    $stat = path(\"/some/symlink\")->lstat;"
NSQ_SOURCE_LINE 00003430 ""
NSQ_SOURCE_LINE 00003431 "Like calling C<stat> or C<lstat> from L<File::stat>."
NSQ_SOURCE_LINE 00003432 ""
NSQ_SOURCE_LINE 00003433 "Current API available since 0.001."
NSQ_SOURCE_LINE 00003434 ""
NSQ_SOURCE_LINE 00003435 "=head2 stringify"
NSQ_SOURCE_LINE 00003436 ""
NSQ_SOURCE_LINE 00003437 "    $path = path(\"foo.txt\");"
NSQ_SOURCE_LINE 00003438 "    say $path->stringify; # same as \"$path\""
NSQ_SOURCE_LINE 00003439 ""
NSQ_SOURCE_LINE 00003440 "Returns a string representation of the path.  Unlike C<canonpath>, this method"
NSQ_SOURCE_LINE 00003441 "returns the path standardized with Unix-style C</> directory separators."
NSQ_SOURCE_LINE 00003442 ""
NSQ_SOURCE_LINE 00003443 "Current API available since 0.001."
NSQ_SOURCE_LINE 00003444 ""
NSQ_SOURCE_LINE 00003445 "=head2 subsumes"
NSQ_SOURCE_LINE 00003446 ""
NSQ_SOURCE_LINE 00003447 "    path(\"foo/bar\")->subsumes(\"foo/bar/baz\"); # true"
NSQ_SOURCE_LINE 00003448 "    path(\"/foo/bar\")->subsumes(\"/foo/baz\");   # false"
NSQ_SOURCE_LINE 00003449 ""
NSQ_SOURCE_LINE 00003450 "Returns true if the first path is a prefix of the second path at a directory"
NSQ_SOURCE_LINE 00003451 "boundary."
NSQ_SOURCE_LINE 00003452 ""
NSQ_SOURCE_LINE 00003453 "This B<does not> resolve parent directory entries (C<..>) or symlinks:"
NSQ_SOURCE_LINE 00003454 ""
NSQ_SOURCE_LINE 00003455 "    path(\"foo/bar\")->subsumes(\"foo/bar/../baz\"); # true"
NSQ_SOURCE_LINE 00003456 ""
NSQ_SOURCE_LINE 00003457 "If such things are important to you, ensure that both paths are resolved to"
NSQ_SOURCE_LINE 00003458 "the filesystem with C<realpath>:"
NSQ_SOURCE_LINE 00003459 ""
NSQ_SOURCE_LINE 00003460 "    my $p1 = path(\"foo/bar\")->realpath;"
NSQ_SOURCE_LINE 00003461 "    my $p2 = path(\"foo/bar/../baz\")->realpath;"
NSQ_SOURCE_LINE 00003462 "    if ( $p1->subsumes($p2) ) { ... }"
NSQ_SOURCE_LINE 00003463 ""
NSQ_SOURCE_LINE 00003464 "Current API available since 0.048."
NSQ_SOURCE_LINE 00003465 ""
NSQ_SOURCE_LINE 00003466 "=head2 touch"
NSQ_SOURCE_LINE 00003467 ""
NSQ_SOURCE_LINE 00003468 "    path(\"foo.txt\")->touch;"
NSQ_SOURCE_LINE 00003469 "    path(\"foo.txt\")->touch($epoch_secs);"
NSQ_SOURCE_LINE 00003470 ""
NSQ_SOURCE_LINE 00003471 "Like the Unix C<touch> utility.  Creates the file if it doesn't exist, or else"
NSQ_SOURCE_LINE 00003472 "changes the modification and access times to the current time.  If the first"
NSQ_SOURCE_LINE 00003473 "argument is the epoch seconds then it will be used."
NSQ_SOURCE_LINE 00003474 ""
NSQ_SOURCE_LINE 00003475 "Returns the path object so it can be easily chained with other methods:"
NSQ_SOURCE_LINE 00003476 ""
NSQ_SOURCE_LINE 00003477 "    # won't die if foo.txt doesn't exist"
NSQ_SOURCE_LINE 00003478 "    $content = path(\"foo.txt\")->touch->slurp;"
NSQ_SOURCE_LINE 00003479 ""
NSQ_SOURCE_LINE 00003480 "Current API available since 0.015."
NSQ_SOURCE_LINE 00003481 ""
NSQ_SOURCE_LINE 00003482 "=head2 touchpath"
NSQ_SOURCE_LINE 00003483 ""
NSQ_SOURCE_LINE 00003484 "    path(\"bar/baz/foo.txt\")->touchpath;"
NSQ_SOURCE_LINE 00003485 ""
NSQ_SOURCE_LINE 00003486 "Combines C<mkdir> and C<touch>.  Creates the parent directory if it doesn't exist,"
NSQ_SOURCE_LINE 00003487 "before touching the file.  Returns the path object like C<touch> does."
NSQ_SOURCE_LINE 00003488 ""
NSQ_SOURCE_LINE 00003489 "If you need to pass options, use C<mkdir> and C<touch> separately:"
NSQ_SOURCE_LINE 00003490 ""
NSQ_SOURCE_LINE 00003491 "    path(\"bar/baz\")->mkdir( \\%options )->child(\"foo.txt\")->touch($epoch_secs);"
NSQ_SOURCE_LINE 00003492 ""
NSQ_SOURCE_LINE 00003493 "Current API available since 0.022."
NSQ_SOURCE_LINE 00003494 ""
NSQ_SOURCE_LINE 00003495 "=head2 visit"
NSQ_SOURCE_LINE 00003496 ""
NSQ_SOURCE_LINE 00003497 "    path(\"/tmp\")->visit( \\&callback, \\%options );"
NSQ_SOURCE_LINE 00003498 ""
NSQ_SOURCE_LINE 00003499 "Executes a callback for each child of a directory.  It returns a hash"
NSQ_SOURCE_LINE 00003500 "reference with any state accumulated during iteration."
NSQ_SOURCE_LINE 00003501 ""
NSQ_SOURCE_LINE 00003502 "The options are the same as for L</iterator> (which it uses internally):"
NSQ_SOURCE_LINE 00003503 "C<recurse> and C<follow_symlinks>.  Both default to false."
NSQ_SOURCE_LINE 00003504 ""
NSQ_SOURCE_LINE 00003505 "The callback function will receive a C<Path::Tiny> object as the first argument"
NSQ_SOURCE_LINE 00003506 "and a hash reference to accumulate state as the second argument.  For example:"
NSQ_SOURCE_LINE 00003507 ""
NSQ_SOURCE_LINE 00003508 "    # collect files sizes"
NSQ_SOURCE_LINE 00003509 "    my $sizes = path(\"/tmp\")->visit("
NSQ_SOURCE_LINE 00003510 "        sub {"
NSQ_SOURCE_LINE 00003511 "            my ($path, $state) = @_;"
NSQ_SOURCE_LINE 00003512 "            return if $path->is_dir;"
NSQ_SOURCE_LINE 00003513 "            $state->{$path} = -s $path;"
NSQ_SOURCE_LINE 00003514 "        },"
NSQ_SOURCE_LINE 00003515 "        { recurse => 1 }"
NSQ_SOURCE_LINE 00003516 "    );"
NSQ_SOURCE_LINE 00003517 ""
NSQ_SOURCE_LINE 00003518 "For convenience, the C<Path::Tiny> object will also be locally aliased as the"
NSQ_SOURCE_LINE 00003519 "C<$_> global variable:"
NSQ_SOURCE_LINE 00003520 ""
NSQ_SOURCE_LINE 00003521 "    # print paths matching /foo/"
NSQ_SOURCE_LINE 00003522 "    path(\"/tmp\")->visit( sub { say if /foo/ }, { recurse => 1} );"
NSQ_SOURCE_LINE 00003523 ""
NSQ_SOURCE_LINE 00003524 "If the callback returns a B<reference> to a false scalar value, iteration will"
NSQ_SOURCE_LINE 00003525 "terminate.  This is not the same as \"pruning\" a directory search; this just"
NSQ_SOURCE_LINE 00003526 "stops all iteration and returns the state hash reference."
NSQ_SOURCE_LINE 00003527 ""
NSQ_SOURCE_LINE 00003528 "    # find up to 10 files larger than 100K"
NSQ_SOURCE_LINE 00003529 "    my $files = path(\"/tmp\")->visit("
NSQ_SOURCE_LINE 00003530 "        sub {"
NSQ_SOURCE_LINE 00003531 "            my ($path, $state) = @_;"
NSQ_SOURCE_LINE 00003532 "            $state->{$path}++ if -s $path > 102400"
NSQ_SOURCE_LINE 00003533 "            return \\0 if keys %$state == 10;"
NSQ_SOURCE_LINE 00003534 "        },"
NSQ_SOURCE_LINE 00003535 "        { recurse => 1 }"
NSQ_SOURCE_LINE 00003536 "    );"
NSQ_SOURCE_LINE 00003537 ""
NSQ_SOURCE_LINE 00003538 "If you want more flexible iteration, use a module like L<Path::Iterator::Rule>."
NSQ_SOURCE_LINE 00003539 ""
NSQ_SOURCE_LINE 00003540 "Current API available since 0.062."
NSQ_SOURCE_LINE 00003541 ""
NSQ_SOURCE_LINE 00003542 "=head2 volume"
NSQ_SOURCE_LINE 00003543 ""
NSQ_SOURCE_LINE 00003544 "    $vol = path(\"/tmp/foo.txt\")->volume;   # \"\""
NSQ_SOURCE_LINE 00003545 "    $vol = path(\"C:/tmp/foo.txt\")->volume; # \"C:\""
NSQ_SOURCE_LINE 00003546 ""
NSQ_SOURCE_LINE 00003547 "Returns the volume portion of the path.  This is equivalent"
NSQ_SOURCE_LINE 00003548 "to what L<File::Spec> would give from C<splitpath> and thus"
NSQ_SOURCE_LINE 00003549 "usually is the empty string on Unix-like operating systems or the"
NSQ_SOURCE_LINE 00003550 "drive letter for an absolute path on C<MSWin32>."
NSQ_SOURCE_LINE 00003551 ""
NSQ_SOURCE_LINE 00003552 "Current API available since 0.001."
NSQ_SOURCE_LINE 00003553 ""
NSQ_SOURCE_LINE 00003554 "=for Pod::Coverage openr_utf8 opena_utf8 openw_utf8 openrw_utf8"
NSQ_SOURCE_LINE 00003555 "openr_raw opena_raw openw_raw openrw_raw"
NSQ_SOURCE_LINE 00003556 "IS_WIN32 FREEZE THAW TO_JSON abs2rel"
NSQ_SOURCE_LINE 00003557 ""
NSQ_SOURCE_LINE 00003558 "=head1 EXCEPTION HANDLING"
NSQ_SOURCE_LINE 00003559 ""
NSQ_SOURCE_LINE 00003560 "Simple usage errors will generally croak.  Failures of underlying Perl"
NSQ_SOURCE_LINE 00003561 "functions will be thrown as exceptions in the class"
NSQ_SOURCE_LINE 00003562 "C<Path::Tiny::Error>."
NSQ_SOURCE_LINE 00003563 ""
NSQ_SOURCE_LINE 00003564 "A C<Path::Tiny::Error> object will be a hash reference with the following fields:"
NSQ_SOURCE_LINE 00003565 ""
NSQ_SOURCE_LINE 00003566 "=over 4"
NSQ_SOURCE_LINE 00003567 ""
NSQ_SOURCE_LINE 00003568 "=item *"
NSQ_SOURCE_LINE 00003569 ""
NSQ_SOURCE_LINE 00003570 "C<op> — a description of the operation, usually function call and any extra info"
NSQ_SOURCE_LINE 00003571 ""
NSQ_SOURCE_LINE 00003572 "=item *"
NSQ_SOURCE_LINE 00003573 ""
NSQ_SOURCE_LINE 00003574 "C<file> — the file or directory relating to the error"
NSQ_SOURCE_LINE 00003575 ""
NSQ_SOURCE_LINE 00003576 "=item *"
NSQ_SOURCE_LINE 00003577 ""
NSQ_SOURCE_LINE 00003578 "C<err> — hold C<$!> at the time the error was thrown"
NSQ_SOURCE_LINE 00003579 ""
NSQ_SOURCE_LINE 00003580 "=item *"
NSQ_SOURCE_LINE 00003581 ""
NSQ_SOURCE_LINE 00003582 "C<msg> — a string combining the above data and a Carp-like short stack trace"
NSQ_SOURCE_LINE 00003583 ""
NSQ_SOURCE_LINE 00003584 "=back"
NSQ_SOURCE_LINE 00003585 ""
NSQ_SOURCE_LINE 00003586 "Exception objects will stringify as the C<msg> field."
NSQ_SOURCE_LINE 00003587 ""
NSQ_SOURCE_LINE 00003588 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00003589 ""
NSQ_SOURCE_LINE 00003590 "=head2 PERL_PATH_TINY_NO_FLOCK"
NSQ_SOURCE_LINE 00003591 ""
NSQ_SOURCE_LINE 00003592 "If the environment variable C<PERL_PATH_TINY_NO_FLOCK> is set to a true"
NSQ_SOURCE_LINE 00003593 "value then flock will NOT be used when accessing files (this is not"
NSQ_SOURCE_LINE 00003594 "recommended)."
NSQ_SOURCE_LINE 00003595 ""
NSQ_SOURCE_LINE 00003596 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00003597 ""
NSQ_SOURCE_LINE 00003598 "=head2 Subclassing not supported"
NSQ_SOURCE_LINE 00003599 ""
NSQ_SOURCE_LINE 00003600 "For speed, this class is implemented as an array based object and uses many"
NSQ_SOURCE_LINE 00003601 "direct function calls internally.  You must not subclass it and expect"
NSQ_SOURCE_LINE 00003602 "things to work properly."
NSQ_SOURCE_LINE 00003603 ""
NSQ_SOURCE_LINE 00003604 "=head2 Tilde expansion (deprecated)"
NSQ_SOURCE_LINE 00003605 ""
NSQ_SOURCE_LINE 00003606 "Tilde expansion was a nice idea, but it can't easily be applied consistently"
NSQ_SOURCE_LINE 00003607 "across the entire API.  This was a source of bugs and confusion for users."
NSQ_SOURCE_LINE 00003608 "Therefore, it is B<deprecated> and its use is discouraged.  Limitations to the"
NSQ_SOURCE_LINE 00003609 "existing, legacy behavior follow."
NSQ_SOURCE_LINE 00003610 ""
NSQ_SOURCE_LINE 00003611 "Tilde expansion will only occur if the B<first> argument to C<path> begins with"
NSQ_SOURCE_LINE 00003612 "a tilde. B<No other method does tilde expansion on its arguments>.  If you want"
NSQ_SOURCE_LINE 00003613 "tilde expansion on arguments, you must explicitly wrap them in a call to"
NSQ_SOURCE_LINE 00003614 "C<path>."
NSQ_SOURCE_LINE 00003615 ""
NSQ_SOURCE_LINE 00003616 "    path( \"~/foo.txt\" )->copy( path( \"~/bar.txt\" ) );"
NSQ_SOURCE_LINE 00003617 ""
NSQ_SOURCE_LINE 00003618 "If you need a literal leading tilde, use C<path(\"./~whatever\")> so that the"
NSQ_SOURCE_LINE 00003619 "argument to C<path> doesn't start with a tilde, but the path still resolves to"
NSQ_SOURCE_LINE 00003620 "the current directory."
NSQ_SOURCE_LINE 00003621 ""
NSQ_SOURCE_LINE 00003622 "Behaviour of tilde expansion with a username for non-existent users depends on"
NSQ_SOURCE_LINE 00003623 "the output of C<glob> on the system."
NSQ_SOURCE_LINE 00003624 ""
NSQ_SOURCE_LINE 00003625 "=head2 File locking"
NSQ_SOURCE_LINE 00003626 ""
NSQ_SOURCE_LINE 00003627 "If flock is not supported on a platform, it will not be used, even if"
NSQ_SOURCE_LINE 00003628 "locking is requested."
NSQ_SOURCE_LINE 00003629 ""
NSQ_SOURCE_LINE 00003630 "In situations where a platform normally would support locking, but the"
NSQ_SOURCE_LINE 00003631 "flock fails due to a filesystem limitation, Path::Tiny has some heuristics"
NSQ_SOURCE_LINE 00003632 "to detect this and will warn once and continue in an unsafe mode.  If you"
NSQ_SOURCE_LINE 00003633 "want this failure to be fatal, you can fatalize the 'flock' warnings"
NSQ_SOURCE_LINE 00003634 "category:"
NSQ_SOURCE_LINE 00003635 ""
NSQ_SOURCE_LINE 00003636 "    use warnings FATAL => 'flock';"
NSQ_SOURCE_LINE 00003637 ""
NSQ_SOURCE_LINE 00003638 "See additional caveats below."
NSQ_SOURCE_LINE 00003639 ""
NSQ_SOURCE_LINE 00003640 "=head3 NFS and BSD"
NSQ_SOURCE_LINE 00003641 ""
NSQ_SOURCE_LINE 00003642 "On BSD, Perl's flock implementation may not work to lock files on an"
NSQ_SOURCE_LINE 00003643 "NFS filesystem.  If detected, this situation will warn once, as described"
NSQ_SOURCE_LINE 00003644 "above."
NSQ_SOURCE_LINE 00003645 ""
NSQ_SOURCE_LINE 00003646 "=head3 Lustre"
NSQ_SOURCE_LINE 00003647 ""
NSQ_SOURCE_LINE 00003648 "The Lustre filesystem does not support flock.  If detected, this situation"
NSQ_SOURCE_LINE 00003649 "will warn once, as described above."
NSQ_SOURCE_LINE 00003650 ""
NSQ_SOURCE_LINE 00003651 "=head3 AIX and locking"
NSQ_SOURCE_LINE 00003652 ""
NSQ_SOURCE_LINE 00003653 "AIX requires a write handle for locking.  Therefore, calls that normally"
NSQ_SOURCE_LINE 00003654 "open a read handle and take a shared lock instead will open a read-write"
NSQ_SOURCE_LINE 00003655 "handle and take an exclusive lock.  If the user does not have write"
NSQ_SOURCE_LINE 00003656 "permission, no lock will be used."
NSQ_SOURCE_LINE 00003657 ""
NSQ_SOURCE_LINE 00003658 "=head2 utf8 vs UTF-8"
NSQ_SOURCE_LINE 00003659 ""
NSQ_SOURCE_LINE 00003660 "All the C<*_utf8> methods by default use C<:encoding(UTF-8)> -- either as"
NSQ_SOURCE_LINE 00003661 "C<:unix:encoding(UTF-8)> (unbuffered, for whole file operations) or"
NSQ_SOURCE_LINE 00003662 "C<:raw:encoding(UTF-8)> (buffered, for line-by-line operations). These are"
NSQ_SOURCE_LINE 00003663 "strict against the Unicode spec and disallows illegal Unicode codepoints or"
NSQ_SOURCE_LINE 00003664 "UTF-8 sequences."
NSQ_SOURCE_LINE 00003665 ""
NSQ_SOURCE_LINE 00003666 "Unfortunately, C<:encoding(UTF-8)> is very, very slow.  If you install"
NSQ_SOURCE_LINE 00003667 "L<Unicode::UTF8> 0.58 or later, that module will be used by some C<*_utf8>"
NSQ_SOURCE_LINE 00003668 "methods to encode or decode data after a raw, binary input/output operation,"
NSQ_SOURCE_LINE 00003669 "which is much faster.  Alternatively, if you install L<PerlIO::utf8_strict>,"
NSQ_SOURCE_LINE 00003670 "that will be used instead of C<:encoding(UTF-8)> and is also very fast."
NSQ_SOURCE_LINE 00003671 ""
NSQ_SOURCE_LINE 00003672 "If you need the performance and can accept the security risk,"
NSQ_SOURCE_LINE 00003673 "C<< slurp({binmode => \":unix:utf8\"}) >> will be faster than C<:unix:encoding(UTF-8)>"
NSQ_SOURCE_LINE 00003674 "(but not as fast as C<Unicode::UTF8>)."
NSQ_SOURCE_LINE 00003675 ""
NSQ_SOURCE_LINE 00003676 "Note that the C<*_utf8> methods read in B<raw> mode.  There is no CRLF"
NSQ_SOURCE_LINE 00003677 "translation on Windows.  If you must have CRLF translation, use the regular"
NSQ_SOURCE_LINE 00003678 "input/output methods with an appropriate binmode:"
NSQ_SOURCE_LINE 00003679 ""
NSQ_SOURCE_LINE 00003680 "  $path->spew_utf8($data);                            # raw"
NSQ_SOURCE_LINE 00003681 "  $path->spew({binmode => \":encoding(UTF-8)\"}, $data; # LF -> CRLF"
NSQ_SOURCE_LINE 00003682 ""
NSQ_SOURCE_LINE 00003683 "=head2 Default IO layers and the open pragma"
NSQ_SOURCE_LINE 00003684 ""
NSQ_SOURCE_LINE 00003685 "If you have Perl 5.10 or later, file input/output methods (C<slurp>, C<spew>,"
NSQ_SOURCE_LINE 00003686 "etc.) and high-level handle opening methods ( C<filehandle>, C<openr>,"
NSQ_SOURCE_LINE 00003687 "C<openw>, etc. ) respect default encodings set by the C<-C> switch or lexical"
NSQ_SOURCE_LINE 00003688 "L<open> settings of the caller.  For UTF-8, this is almost certainly slower"
NSQ_SOURCE_LINE 00003689 "than using the dedicated C<_utf8> methods if you have L<Unicode::UTF8> or"
NSQ_SOURCE_LINE 00003690 "L<PerlIP::utf8_strict>."
NSQ_SOURCE_LINE 00003691 ""
NSQ_SOURCE_LINE 00003692 "=head1 TYPE CONSTRAINTS AND COERCION"
NSQ_SOURCE_LINE 00003693 ""
NSQ_SOURCE_LINE 00003694 "A standard L<MooseX::Types> library is available at"
NSQ_SOURCE_LINE 00003695 "L<MooseX::Types::Path::Tiny>.  A L<Type::Tiny> equivalent is available as"
NSQ_SOURCE_LINE 00003696 "L<Types::Path::Tiny>."
NSQ_SOURCE_LINE 00003697 ""
NSQ_SOURCE_LINE 00003698 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00003699 ""
NSQ_SOURCE_LINE 00003700 "These are other file/path utilities, which may offer a different feature"
NSQ_SOURCE_LINE 00003701 "set than C<Path::Tiny>."
NSQ_SOURCE_LINE 00003702 ""
NSQ_SOURCE_LINE 00003703 "=over 4"
NSQ_SOURCE_LINE 00003704 ""
NSQ_SOURCE_LINE 00003705 "=item *"
NSQ_SOURCE_LINE 00003706 ""
NSQ_SOURCE_LINE 00003707 "L<File::chmod>"
NSQ_SOURCE_LINE 00003708 ""
NSQ_SOURCE_LINE 00003709 "=item *"
NSQ_SOURCE_LINE 00003710 ""
NSQ_SOURCE_LINE 00003711 "L<File::Fu>"
NSQ_SOURCE_LINE 00003712 ""
NSQ_SOURCE_LINE 00003713 "=item *"
NSQ_SOURCE_LINE 00003714 ""
NSQ_SOURCE_LINE 00003715 "L<IO::All>"
NSQ_SOURCE_LINE 00003716 ""
NSQ_SOURCE_LINE 00003717 "=item *"
NSQ_SOURCE_LINE 00003718 ""
NSQ_SOURCE_LINE 00003719 "L<Path::Class>"
NSQ_SOURCE_LINE 00003720 ""
NSQ_SOURCE_LINE 00003721 "=back"
NSQ_SOURCE_LINE 00003722 ""
NSQ_SOURCE_LINE 00003723 "These iterators may be slightly faster than the recursive iterator in"
NSQ_SOURCE_LINE 00003724 "C<Path::Tiny>:"
NSQ_SOURCE_LINE 00003725 ""
NSQ_SOURCE_LINE 00003726 "=over 4"
NSQ_SOURCE_LINE 00003727 ""
NSQ_SOURCE_LINE 00003728 "=item *"
NSQ_SOURCE_LINE 00003729 ""
NSQ_SOURCE_LINE 00003730 "L<Path::Iterator::Rule>"
NSQ_SOURCE_LINE 00003731 ""
NSQ_SOURCE_LINE 00003732 "=item *"
NSQ_SOURCE_LINE 00003733 ""
NSQ_SOURCE_LINE 00003734 "L<File::Next>"
NSQ_SOURCE_LINE 00003735 ""
NSQ_SOURCE_LINE 00003736 "=back"
NSQ_SOURCE_LINE 00003737 ""
NSQ_SOURCE_LINE 00003738 "There are probably comparable, non-Tiny tools.  Let me know if you want me to"
NSQ_SOURCE_LINE 00003739 "add a module to the list."
NSQ_SOURCE_LINE 00003740 ""
NSQ_SOURCE_LINE 00003741 "This module was featured in the L<2013 Perl Advent Calendar|http://www.perladvent.org/2013/2013-12-18.html>."
NSQ_SOURCE_LINE 00003742 ""
NSQ_SOURCE_LINE 00003743 "=for :stopwords cpan testmatrix url bugtracker rt cpants kwalitee diff irc mailto metadata placeholders metacpan"
NSQ_SOURCE_LINE 00003744 ""
NSQ_SOURCE_LINE 00003745 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00003746 ""
NSQ_SOURCE_LINE 00003747 "=head2 Bugs / Feature Requests"
NSQ_SOURCE_LINE 00003748 ""
NSQ_SOURCE_LINE 00003749 "Please report any bugs or feature requests through the issue tracker"
NSQ_SOURCE_LINE 00003750 "at L<https://github.com/dagolden/Path-Tiny/issues>."
NSQ_SOURCE_LINE 00003751 "You will be notified automatically of any progress on your issue."
NSQ_SOURCE_LINE 00003752 ""
