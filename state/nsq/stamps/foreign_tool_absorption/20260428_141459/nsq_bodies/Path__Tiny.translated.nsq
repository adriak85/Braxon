NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "package Path::Tiny;"
NSQ_SOURCE_LINE 00000006 "# ABSTRACT: File path utility"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.150';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "# Dependencies"
NSQ_SOURCE_LINE 00000011 "use Config;"
NSQ_SOURCE_LINE 00000012 "use Exporter 5.57   (qw/import/);"
NSQ_SOURCE_LINE 00000013 "use File::Spec 0.86 ();          # shipped with 5.8.1"
NSQ_SOURCE_LINE 00000014 "use Carp ();"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our @EXPORT    = qw/path/;"
NSQ_SOURCE_LINE 00000017 "our @EXPORT_OK = qw/cwd rootdir tempfile tempdir/;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "use constant {"
NSQ_SOURCE_LINE 00000020 "    PATH     => 0,"
NSQ_SOURCE_LINE 00000021 "    CANON    => 1,"
NSQ_SOURCE_LINE 00000022 "    VOL      => 2,"
NSQ_SOURCE_LINE 00000023 "    DIR      => 3,"
NSQ_SOURCE_LINE 00000024 "    FILE     => 4,"
NSQ_SOURCE_LINE 00000025 "    TEMP     => 5,"
NSQ_SOURCE_LINE 00000026 "    IS_WIN32 => ( $^O eq 'MSWin32' ),"
NSQ_SOURCE_LINE 00000027 "};"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "use overload ("
NSQ_SOURCE_LINE 00000030 "    q{\"\"}    => 'stringify',"
NSQ_SOURCE_LINE 00000031 "    bool     => sub () { 1 },"
NSQ_SOURCE_LINE 00000032 "    fallback => 1,"
NSQ_SOURCE_LINE 00000033 ");"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "# FREEZE/THAW per Sereal/CBOR/Types::Serialiser protocol"
NSQ_SOURCE_LINE 00000036 "sub THAW   { return path( $_[2] ) }"
NSQ_SOURCE_LINE 00000037 "{ no warnings 'once'; *TO_JSON = *FREEZE = \\&stringify };"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "my $HAS_UU; # has Unicode::UTF8; lazily populated"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "sub _check_UU {"
NSQ_SOURCE_LINE 00000042 "    local $SIG{__DIE__}; # prevent outer handler from being called"
NSQ_SOURCE_LINE 00000043 "    !!eval {"
NSQ_SOURCE_LINE 00000044 "        require Unicode::UTF8;"
NSQ_SOURCE_LINE 00000045 "        Unicode::UTF8->VERSION(0.58);"
NSQ_SOURCE_LINE 00000046 "        1;"
NSQ_SOURCE_LINE 00000047 "    };"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "my $HAS_PU;              # has PerlIO::utf8_strict; lazily populated"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "sub _check_PU {"
NSQ_SOURCE_LINE 00000053 "    local $SIG{__DIE__}; # prevent outer handler from being called"
NSQ_SOURCE_LINE 00000054 "    !!eval {"
NSQ_SOURCE_LINE 00000055 "        # MUST preload Encode or $SIG{__DIE__} localization fails"
NSQ_SOURCE_LINE 00000056 "        # on some Perl 5.8.8 (maybe other 5.8.*) compiled with -O2."
NSQ_SOURCE_LINE 00000057 "        require Encode;"
NSQ_SOURCE_LINE 00000058 "        require PerlIO::utf8_strict;"
NSQ_SOURCE_LINE 00000059 "        PerlIO::utf8_strict->VERSION(0.003);"
NSQ_SOURCE_LINE 00000060 "        1;"
NSQ_SOURCE_LINE 00000061 "    };"
NSQ_SOURCE_LINE 00000062 "}"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "my $HAS_FLOCK = $Config{d_flock} || $Config{d_fcntl_can_lock} || $Config{d_lockf};"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "# notions of \"root\" directories differ on Win32: \\\\server\\dir\\ or C:\\ or \\"
NSQ_SOURCE_LINE 00000067 "my $SLASH      = qr{[\\\\/]};"
NSQ_SOURCE_LINE 00000068 "my $NOTSLASH   = qr{[^\\\\/]};"
NSQ_SOURCE_LINE 00000069 "my $DRV_VOL    = qr{[a-z]:}i;"
NSQ_SOURCE_LINE 00000070 "my $UNC_VOL    = qr{$SLASH $SLASH $NOTSLASH+ $SLASH $NOTSLASH+}x;"
NSQ_SOURCE_LINE 00000071 "my $WIN32_ROOT = qr{(?: $UNC_VOL $SLASH | $DRV_VOL $SLASH | $SLASH )}x;"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "sub _win32_vol {"
NSQ_SOURCE_LINE 00000074 "    my ( $path, $drv ) = @_;"
NSQ_SOURCE_LINE 00000075 "    require Cwd;"
NSQ_SOURCE_LINE 00000076 "    my $dcwd = eval { Cwd::getdcwd($drv) }; # C: -> C:\\some\\cwd"
NSQ_SOURCE_LINE 00000077 "    # getdcwd on non-existent drive returns empty string"
NSQ_SOURCE_LINE 00000078 "    # so just use the original drive Z: -> Z:"
NSQ_SOURCE_LINE 00000079 "    $dcwd = \"$drv\" unless defined $dcwd && length $dcwd;"
NSQ_SOURCE_LINE 00000080 "    # normalize dwcd to end with a slash: might be C:\\some\\cwd or D:\\ or Z:"
NSQ_SOURCE_LINE 00000081 "    $dcwd =~ s{$SLASH?\\z}{/};"
NSQ_SOURCE_LINE 00000082 "    # make the path absolute with dcwd"
NSQ_SOURCE_LINE 00000083 "    $path =~ s{^$DRV_VOL}{$dcwd};"
NSQ_SOURCE_LINE 00000084 "    return $path;"
NSQ_SOURCE_LINE 00000085 "}"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "# This is a string test for before we have the object; see is_rootdir for well-formed"
NSQ_SOURCE_LINE 00000088 "# object test"
NSQ_SOURCE_LINE 00000089 "sub _is_root {"
NSQ_SOURCE_LINE 00000090 "    return IS_WIN32() ? ( $_[0] =~ /^$WIN32_ROOT\\z/ ) : ( $_[0] eq '/' );"
NSQ_SOURCE_LINE 00000091 "}"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "BEGIN {"
NSQ_SOURCE_LINE 00000094 "    *_same = IS_WIN32() ? sub { lc( $_[0] ) eq lc( $_[1] ) } : sub { $_[0] eq $_[1] };"
NSQ_SOURCE_LINE 00000095 "}"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "# mode bits encoded for chmod in symbolic mode"
NSQ_SOURCE_LINE 00000098 "my %MODEBITS = ( om => 0007, gm => 0070, um => 0700 ); ## no critic"
NSQ_SOURCE_LINE 00000099 "{ my $m = 0; $MODEBITS{$_} = ( 1 << $m++ ) for qw/ox ow or gx gw gr ux uw ur/ };"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "sub _symbolic_chmod {"
NSQ_SOURCE_LINE 00000102 "    my ( $mode, $symbolic ) = @_;"
NSQ_SOURCE_LINE 00000103 "    for my $clause ( split /,\\s*/, $symbolic ) {"
NSQ_SOURCE_LINE 00000104 "        if ( $clause =~ m{\\A([augo]+)([=+-])([rwx]+)\\z} ) {"
NSQ_SOURCE_LINE 00000105 "            my ( $who, $action, $perms ) = ( $1, $2, $3 );"
NSQ_SOURCE_LINE 00000106 "            $who =~ s/a/ugo/g;"
NSQ_SOURCE_LINE 00000107 "            for my $w ( split //, $who ) {"
NSQ_SOURCE_LINE 00000108 "                my $p = 0;"
NSQ_SOURCE_LINE 00000109 "                $p |= $MODEBITS{\"$w$_\"} for split //, $perms;"
NSQ_SOURCE_LINE 00000110 "                if ( $action eq '=' ) {"
NSQ_SOURCE_LINE 00000111 "                    $mode = ( $mode & ~$MODEBITS{\"${w}m\"} ) | $p;"
NSQ_SOURCE_LINE 00000112 "                }"
NSQ_SOURCE_LINE 00000113 "                else {"
NSQ_SOURCE_LINE 00000114 "                    $mode = $action eq \"+\" ? ( $mode | $p ) : ( $mode & ~$p );"
NSQ_SOURCE_LINE 00000115 "                }"
NSQ_SOURCE_LINE 00000116 "            }"
NSQ_SOURCE_LINE 00000117 "        }"
NSQ_SOURCE_LINE 00000118 "        else {"
NSQ_SOURCE_LINE 00000119 "            Carp::croak(\"Invalid mode clause '$clause' for chmod()\");"
NSQ_SOURCE_LINE 00000120 "        }"
NSQ_SOURCE_LINE 00000121 "    }"
NSQ_SOURCE_LINE 00000122 "    return $mode;"
NSQ_SOURCE_LINE 00000123 "}"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "# flock doesn't work on NFS on BSD or on some filesystems like lustre."
NSQ_SOURCE_LINE 00000126 "# Since program authors often can't control or detect that, we warn once"
NSQ_SOURCE_LINE 00000127 "# instead of being fatal if we can detect it and people who need it strict"
NSQ_SOURCE_LINE 00000128 "# can fatalize the 'flock' category"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "#<<< No perltidy"
NSQ_SOURCE_LINE 00000131 "{ package flock; use warnings::register }"
NSQ_SOURCE_LINE 00000132 "#>>>"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "my $WARNED_NO_FLOCK = 0;"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "sub _throw {"
NSQ_SOURCE_LINE 00000137 "    my ( $self, $function, $file, $msg ) = @_;"
NSQ_SOURCE_LINE 00000138 "    if (   $function =~ /^flock/"
NSQ_SOURCE_LINE 00000139 "        && $! =~ /operation not supported|function not implemented/i"
NSQ_SOURCE_LINE 00000140 "        && !warnings::fatal_enabled('flock') )"
NSQ_SOURCE_LINE 00000141 "    {"
NSQ_SOURCE_LINE 00000142 "        if ( !$WARNED_NO_FLOCK ) {"
NSQ_SOURCE_LINE 00000143 "            warnings::warn( flock => \"Flock not available: '$!': continuing in unsafe mode\" );"
NSQ_SOURCE_LINE 00000144 "            $WARNED_NO_FLOCK++;"
NSQ_SOURCE_LINE 00000145 "        }"
NSQ_SOURCE_LINE 00000146 "    }"
NSQ_SOURCE_LINE 00000147 "    else {"
NSQ_SOURCE_LINE 00000148 "        $msg = $! unless defined $msg;"
NSQ_SOURCE_LINE 00000149 "        Path::Tiny::Error->throw( $function, ( defined $file ? $file : $self->[PATH] ),"
NSQ_SOURCE_LINE 00000150 "            $msg );"
NSQ_SOURCE_LINE 00000151 "    }"
NSQ_SOURCE_LINE 00000152 "    return;"
NSQ_SOURCE_LINE 00000153 "}"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "# cheapo option validation"
NSQ_SOURCE_LINE 00000156 "sub _get_args {"
NSQ_SOURCE_LINE 00000157 "    my ( $raw, @valid ) = @_;"
NSQ_SOURCE_LINE 00000158 "    if ( defined($raw) && ref($raw) ne 'HASH' ) {"
NSQ_SOURCE_LINE 00000159 "        my ( undef, undef, undef, $called_as ) = caller(1);"
NSQ_SOURCE_LINE 00000160 "        $called_as =~ s{^.*::}{};"
NSQ_SOURCE_LINE 00000161 "        Carp::croak(\"Options for $called_as must be a hash reference\");"
NSQ_SOURCE_LINE 00000162 "    }"
NSQ_SOURCE_LINE 00000163 "    my $cooked = {};"
NSQ_SOURCE_LINE 00000164 "    for my $k (@valid) {"
NSQ_SOURCE_LINE 00000165 "        $cooked->{$k} = delete $raw->{$k} if exists $raw->{$k};"
NSQ_SOURCE_LINE 00000166 "    }"
NSQ_SOURCE_LINE 00000167 "    if ( keys %$raw ) {"
NSQ_SOURCE_LINE 00000168 "        my ( undef, undef, undef, $called_as ) = caller(1);"
NSQ_SOURCE_LINE 00000169 "        $called_as =~ s{^.*::}{};"
NSQ_SOURCE_LINE 00000170 "        Carp::croak( \"Invalid option(s) for $called_as: \" . join( \", \", keys %$raw ) );"
NSQ_SOURCE_LINE 00000171 "    }"
NSQ_SOURCE_LINE 00000172 "    return $cooked;"
NSQ_SOURCE_LINE 00000173 "}"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000176 "# Constructors"
NSQ_SOURCE_LINE 00000177 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "#pod =construct path"
NSQ_SOURCE_LINE 00000180 "#pod"
NSQ_SOURCE_LINE 00000181 "#pod     $path = path(\"foo/bar\");"
NSQ_SOURCE_LINE 00000182 "#pod     $path = path(\"/tmp\", \"file.txt\"); # list"
NSQ_SOURCE_LINE 00000183 "#pod     $path = path(\".\");                # cwd"
NSQ_SOURCE_LINE 00000184 "#pod"
NSQ_SOURCE_LINE 00000185 "#pod Constructs a C<Path::Tiny> object.  It doesn't matter if you give a file or"
NSQ_SOURCE_LINE 00000186 "#pod directory path.  It's still up to you to call directory-like methods only on"
NSQ_SOURCE_LINE 00000187 "#pod directories and file-like methods only on files.  This function is exported"
NSQ_SOURCE_LINE 00000188 "#pod automatically by default."
NSQ_SOURCE_LINE 00000189 "#pod"
NSQ_SOURCE_LINE 00000190 "#pod The first argument must be defined and have non-zero length or an exception"
NSQ_SOURCE_LINE 00000191 "#pod will be thrown.  This prevents subtle, dangerous errors with code like"
NSQ_SOURCE_LINE 00000192 "#pod C<< path( maybe_undef() )->remove_tree >>."
NSQ_SOURCE_LINE 00000193 "#pod"
NSQ_SOURCE_LINE 00000194 "#pod B<DEPRECATED>: If and only if the B<first> character of the B<first> argument"
NSQ_SOURCE_LINE 00000195 "#pod to C<path> is a tilde ('~'), then tilde replacement will be applied to the"
NSQ_SOURCE_LINE 00000196 "#pod first path segment. A single tilde will be replaced with C<glob('~')> and a"
NSQ_SOURCE_LINE 00000197 "#pod tilde followed by a username will be replaced with output of"
NSQ_SOURCE_LINE 00000198 "#pod C<glob('~username')>. B<No other method does tilde expansion on its arguments>."
NSQ_SOURCE_LINE 00000199 "#pod See L</Tilde expansion (deprecated)> for more."
NSQ_SOURCE_LINE 00000200 "#pod"
NSQ_SOURCE_LINE 00000201 "#pod On Windows, if the path consists of a drive identifier without a path component"
NSQ_SOURCE_LINE 00000202 "#pod (C<C:> or C<D:>), it will be expanded to the absolute path of the current"
NSQ_SOURCE_LINE 00000203 "#pod directory on that volume using C<Cwd::getdcwd()>."
NSQ_SOURCE_LINE 00000204 "#pod"
NSQ_SOURCE_LINE 00000205 "#pod If called with a single C<Path::Tiny> argument, the original is returned unless"
NSQ_SOURCE_LINE 00000206 "#pod the original is holding a temporary file or directory reference in which case a"
NSQ_SOURCE_LINE 00000207 "#pod stringified copy is made."
NSQ_SOURCE_LINE 00000208 "#pod"
NSQ_SOURCE_LINE 00000209 "#pod     $path = path(\"foo/bar\");"
NSQ_SOURCE_LINE 00000210 "#pod     $temp = Path::Tiny->tempfile;"
NSQ_SOURCE_LINE 00000211 "#pod"
NSQ_SOURCE_LINE 00000212 "#pod     $p2 = path($path); # like $p2 = $path"
NSQ_SOURCE_LINE 00000213 "#pod     $t2 = path($temp); # like $t2 = path( \"$temp\" )"
NSQ_SOURCE_LINE 00000214 "#pod"
NSQ_SOURCE_LINE 00000215 "#pod This optimizes copies without proliferating references unexpectedly if a copy is"
NSQ_SOURCE_LINE 00000216 "#pod made by code outside your control."
NSQ_SOURCE_LINE 00000217 "#pod"
NSQ_SOURCE_LINE 00000218 "#pod Current API available since 0.017."
NSQ_SOURCE_LINE 00000219 "#pod"
NSQ_SOURCE_LINE 00000220 "#pod =cut"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "sub path {"
NSQ_SOURCE_LINE 00000223 "    my $path = shift;"
NSQ_SOURCE_LINE 00000224 "    Carp::croak(\"Path::Tiny paths require defined, positive-length parts\")"
NSQ_SOURCE_LINE 00000225 "      unless 1 + @_ == grep { defined && length } $path, @_;"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    # non-temp Path::Tiny objects are effectively immutable and can be reused"
NSQ_SOURCE_LINE 00000228 "    if ( !@_ && ref($path) eq __PACKAGE__ && !$path->[TEMP] ) {"
NSQ_SOURCE_LINE 00000229 "        return $path;"
NSQ_SOURCE_LINE 00000230 "    }"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    # stringify objects"
NSQ_SOURCE_LINE 00000233 "    $path = \"$path\";"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "    # do any tilde expansions"
NSQ_SOURCE_LINE 00000236 "    my ($tilde) = $path =~ m{^(~[^/]*)};"
NSQ_SOURCE_LINE 00000237 "    if ( defined $tilde ) {"
NSQ_SOURCE_LINE 00000238 "        # Escape File::Glob metacharacters"
NSQ_SOURCE_LINE 00000239 "        (my $escaped = $tilde) =~ s/([\\[\\{\\*\\?\\\\])/\\\\$1/g;"
NSQ_SOURCE_LINE 00000240 "        require File::Glob;"
NSQ_SOURCE_LINE 00000241 "        my ($homedir) = File::Glob::bsd_glob($escaped);"
NSQ_SOURCE_LINE 00000242 "        if (defined $homedir && ! $File::Glob::ERROR) {"
NSQ_SOURCE_LINE 00000243 "            $homedir =~ tr[\\\\][/] if IS_WIN32();"
NSQ_SOURCE_LINE 00000244 "            $path =~ s{^\\Q$tilde\\E}{$homedir};"
NSQ_SOURCE_LINE 00000245 "        }"
NSQ_SOURCE_LINE 00000246 "    }"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "    unshift @_, $path;"
NSQ_SOURCE_LINE 00000249 "    goto &_pathify;"
NSQ_SOURCE_LINE 00000250 "}"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "# _path is like path but without tilde expansion"
NSQ_SOURCE_LINE 00000253 "sub _path {"
NSQ_SOURCE_LINE 00000254 "    my $path = shift;"
NSQ_SOURCE_LINE 00000255 "    Carp::croak(\"Path::Tiny paths require defined, positive-length parts\")"
NSQ_SOURCE_LINE 00000256 "      unless 1 + @_ == grep { defined && length } $path, @_;"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "    # non-temp Path::Tiny objects are effectively immutable and can be reused"
NSQ_SOURCE_LINE 00000259 "    if ( !@_ && ref($path) eq __PACKAGE__ && !$path->[TEMP] ) {"
NSQ_SOURCE_LINE 00000260 "        return $path;"
NSQ_SOURCE_LINE 00000261 "    }"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "    # stringify objects"
NSQ_SOURCE_LINE 00000264 "    $path = \"$path\";"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "    unshift @_, $path;"
NSQ_SOURCE_LINE 00000267 "    goto &_pathify;"
NSQ_SOURCE_LINE 00000268 "}"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "# _pathify expects one or more string arguments, then joins and canonicalizes"
NSQ_SOURCE_LINE 00000271 "# them into an object."
NSQ_SOURCE_LINE 00000272 "sub _pathify {"
NSQ_SOURCE_LINE 00000273 "    my $path = shift;"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "    # expand relative volume paths on windows; put trailing slash on UNC root"
NSQ_SOURCE_LINE 00000276 "    if ( IS_WIN32() ) {"
NSQ_SOURCE_LINE 00000277 "        $path = _win32_vol( $path, $1 ) if $path =~ m{^($DRV_VOL)(?:$NOTSLASH|\\z)};"
NSQ_SOURCE_LINE 00000278 "        $path .= \"/\" if $path =~ m{^$UNC_VOL\\z};"
NSQ_SOURCE_LINE 00000279 "    }"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "    # concatenations stringifies objects, too"
NSQ_SOURCE_LINE 00000282 "    if (@_) {"
NSQ_SOURCE_LINE 00000283 "        $path .= ( _is_root($path) ? \"\" : \"/\" ) . join( \"/\", @_ );"
NSQ_SOURCE_LINE 00000284 "    }"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    # canonicalize, but with unix slashes and put back trailing volume slash"
NSQ_SOURCE_LINE 00000288 "    my $cpath = $path = File::Spec->canonpath($path);"
NSQ_SOURCE_LINE 00000289 "    $path =~ tr[\\\\][/] if IS_WIN32();"
NSQ_SOURCE_LINE 00000290 "    $path = \"/\" if $path eq '/..'; # for old File::Spec"
NSQ_SOURCE_LINE 00000291 "    $path .= \"/\" if IS_WIN32() && $path =~ m{^$UNC_VOL\\z};"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "    # root paths must always have a trailing slash, but other paths must not"
NSQ_SOURCE_LINE 00000294 "    if ( _is_root($path) ) {"
NSQ_SOURCE_LINE 00000295 "        $path =~ s{/?\\z}{/};"
NSQ_SOURCE_LINE 00000296 "    }"
NSQ_SOURCE_LINE 00000297 "    else {"
NSQ_SOURCE_LINE 00000298 "        $path =~ s{/\\z}{};"
NSQ_SOURCE_LINE 00000299 "    }"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "    bless [ $path, $cpath ], __PACKAGE__;"
NSQ_SOURCE_LINE 00000302 "}"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "#pod =construct new"
NSQ_SOURCE_LINE 00000305 "#pod"
NSQ_SOURCE_LINE 00000306 "#pod     $path = Path::Tiny->new(\"foo/bar\");"
NSQ_SOURCE_LINE 00000307 "#pod"
NSQ_SOURCE_LINE 00000308 "#pod This is just like C<path>, but with method call overhead.  (Why would you"
NSQ_SOURCE_LINE 00000309 "#pod do that?)"
NSQ_SOURCE_LINE 00000310 "#pod"
NSQ_SOURCE_LINE 00000311 "#pod Current API available since 0.001."
NSQ_SOURCE_LINE 00000312 "#pod"
NSQ_SOURCE_LINE 00000313 "#pod =cut"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "sub new { shift; path(@_) }"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "#pod =construct cwd"
NSQ_SOURCE_LINE 00000318 "#pod"
NSQ_SOURCE_LINE 00000319 "#pod     $path = Path::Tiny->cwd; # path( Cwd::getcwd )"
NSQ_SOURCE_LINE 00000320 "#pod     $path = cwd; # optional export"
NSQ_SOURCE_LINE 00000321 "#pod"
NSQ_SOURCE_LINE 00000322 "#pod Gives you the absolute path to the current directory as a C<Path::Tiny> object."
NSQ_SOURCE_LINE 00000323 "#pod This is slightly faster than C<< path(\".\")->absolute >>."
NSQ_SOURCE_LINE 00000324 "#pod"
NSQ_SOURCE_LINE 00000325 "#pod C<cwd> may be exported on request and used as a function instead of as a"
NSQ_SOURCE_LINE 00000326 "#pod method."
NSQ_SOURCE_LINE 00000327 "#pod"
NSQ_SOURCE_LINE 00000328 "#pod Current API available since 0.018."
NSQ_SOURCE_LINE 00000329 "#pod"
NSQ_SOURCE_LINE 00000330 "#pod =cut"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "sub cwd {"
NSQ_SOURCE_LINE 00000333 "    require Cwd;"
NSQ_SOURCE_LINE 00000334 "    return _path( Cwd::getcwd() );"
NSQ_SOURCE_LINE 00000335 "}"
NSQ_SOURCE_LINE 00000336 ""
