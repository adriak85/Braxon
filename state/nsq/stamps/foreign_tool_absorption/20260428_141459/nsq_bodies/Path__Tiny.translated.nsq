NSQ_SOURCE_LINE 00000339 "#pod     $path = Path::Tiny->rootdir; # /"
NSQ_SOURCE_LINE 00000340 "#pod     $path = rootdir;             # optional export "
NSQ_SOURCE_LINE 00000341 "#pod"
NSQ_SOURCE_LINE 00000342 "#pod Gives you C<< File::Spec->rootdir >> as a C<Path::Tiny> object if you're too"
