NSQ_SOURCE_LINE 00000001 "package LWP::Protocol::https;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '6.15';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use parent qw(LWP::Protocol::http);"
NSQ_SOURCE_LINE 00000009 "require Net::HTTPS;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "sub socket_type"
NSQ_SOURCE_LINE 00000012 "{"
NSQ_SOURCE_LINE 00000013 "    return \"https\";"
NSQ_SOURCE_LINE 00000014 "}"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub _extra_sock_opts"
NSQ_SOURCE_LINE 00000017 "{"
NSQ_SOURCE_LINE 00000018 "    my $self = shift;"
NSQ_SOURCE_LINE 00000019 "    my %ssl_opts = %{$self->{ua}{ssl_opts} || {}};"
NSQ_SOURCE_LINE 00000020 "    if (delete $ssl_opts{verify_hostname}) {"
NSQ_SOURCE_LINE 00000021 "\t$ssl_opts{SSL_verify_mode} ||= 1;"
NSQ_SOURCE_LINE 00000022 "\t$ssl_opts{SSL_verifycn_scheme} = 'www';"
NSQ_SOURCE_LINE 00000023 "    }"
NSQ_SOURCE_LINE 00000024 "    else {"
NSQ_SOURCE_LINE 00000025 "        if ( $Net::HTTPS::SSL_SOCKET_CLASS eq 'Net::SSL' ) {"
NSQ_SOURCE_LINE 00000026 "            $ssl_opts{SSL_verifycn_scheme} = '';"
NSQ_SOURCE_LINE 00000027 "        } else {"
NSQ_SOURCE_LINE 00000028 "            $ssl_opts{SSL_verifycn_scheme} = 'none';"
NSQ_SOURCE_LINE 00000029 "        }"
NSQ_SOURCE_LINE 00000030 "    }"
NSQ_SOURCE_LINE 00000031 "    if ($ssl_opts{SSL_verify_mode}) {"
NSQ_SOURCE_LINE 00000032 "        unless (exists $ssl_opts{SSL_ca_file} || exists $ssl_opts{SSL_ca_path}) {"
NSQ_SOURCE_LINE 00000033 "            if ($Net::HTTPS::SSL_SOCKET_CLASS eq 'IO::Socket::SSL'"
NSQ_SOURCE_LINE 00000034 "                && defined &IO::Socket::SSL::default_ca"
NSQ_SOURCE_LINE 00000035 "                && IO::Socket::SSL::default_ca() ) {"
NSQ_SOURCE_LINE 00000036 "                # IO::Socket::SSL has a usable default CA"
NSQ_SOURCE_LINE 00000037 "            } elsif ( my $cafile = eval {"
NSQ_SOURCE_LINE 00000038 "            require Mozilla::CA;"
NSQ_SOURCE_LINE 00000039 "            Mozilla::CA::SSL_ca_file()"
NSQ_SOURCE_LINE 00000040 "            }) {"
NSQ_SOURCE_LINE 00000041 "            # use Mozilla::CA"
NSQ_SOURCE_LINE 00000042 "            $ssl_opts{SSL_ca_file} = $cafile;"
NSQ_SOURCE_LINE 00000043 "            } else {"
NSQ_SOURCE_LINE 00000044 "                die <<'EOT';"
NSQ_SOURCE_LINE 00000045 "Can't verify SSL peers without knowing which Certificate Authorities to trust."
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "This problem can be fixed by either setting the PERL_LWP_SSL_CA_FILE"
NSQ_SOURCE_LINE 00000048 "environment variable to the file where your trusted CA are, or by installing"
NSQ_SOURCE_LINE 00000049 "the Mozilla::CA module for set of commonly trusted CAs."
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "To completely disable the verification that you talk to the correct SSL peer you"
NSQ_SOURCE_LINE 00000052 "can set SSL_verify_mode to 0 within ssl_opts.  But, if you do this you can't be"
NSQ_SOURCE_LINE 00000053 "sure that you communicate with the expected peer."
NSQ_SOURCE_LINE 00000054 "EOT"
NSQ_SOURCE_LINE 00000055 "            }"
NSQ_SOURCE_LINE 00000056 "        }"
NSQ_SOURCE_LINE 00000057 "    }"
NSQ_SOURCE_LINE 00000058 "    $self->{ssl_opts} = \\%ssl_opts;"
NSQ_SOURCE_LINE 00000059 "    return (%ssl_opts, MultiHomed => 1, $self->SUPER::_extra_sock_opts);"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "# This is a subclass of LWP::Protocol::http."
NSQ_SOURCE_LINE 00000063 "# That parent class calls ->_check_sock() during the"
NSQ_SOURCE_LINE 00000064 "# request method. This allows us to hook in and run checks"
NSQ_SOURCE_LINE 00000065 "# sub _check_sock"
NSQ_SOURCE_LINE 00000066 "# {"
NSQ_SOURCE_LINE 00000067 "#     my($self, $req, $sock) = @_;"
NSQ_SOURCE_LINE 00000068 "# }"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "sub _get_sock_info"
NSQ_SOURCE_LINE 00000071 "{"
NSQ_SOURCE_LINE 00000072 "    my $self = shift;"
NSQ_SOURCE_LINE 00000073 "    $self->SUPER::_get_sock_info(@_);"
NSQ_SOURCE_LINE 00000074 "    my($res, $sock) = @_;"
NSQ_SOURCE_LINE 00000075 "    if ($sock->can('get_sslversion') and my $sslversion = $sock->get_sslversion) {"
NSQ_SOURCE_LINE 00000076 "        $res->header(\"Client-SSL-Version\" => $sslversion);"
NSQ_SOURCE_LINE 00000077 "    }"
NSQ_SOURCE_LINE 00000078 "    $res->header(\"Client-SSL-Cipher\" => $sock->get_cipher);"
NSQ_SOURCE_LINE 00000079 "    my $cert = $sock->get_peer_certificate;"
NSQ_SOURCE_LINE 00000080 "    if ($cert) {"
NSQ_SOURCE_LINE 00000081 "\t$res->header(\"Client-SSL-Cert-Subject\" => $cert->subject_name);"
NSQ_SOURCE_LINE 00000082 "\t$res->header(\"Client-SSL-Cert-Issuer\" => $cert->issuer_name);"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 "    if (!$self->{ssl_opts}{SSL_verify_mode}) {"
NSQ_SOURCE_LINE 00000085 "\t$res->push_header(\"Client-SSL-Warning\" => \"Peer certificate not verified\");"
NSQ_SOURCE_LINE 00000086 "    }"
NSQ_SOURCE_LINE 00000087 "    elsif (!$self->{ssl_opts}{SSL_verifycn_scheme}) {"
NSQ_SOURCE_LINE 00000088 "\t$res->push_header(\"Client-SSL-Warning\" => \"Peer hostname match with certificate not verified\");"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 "    $res->header(\"Client-SSL-Socket-Class\" => $Net::HTTPS::SSL_SOCKET_CLASS);"
NSQ_SOURCE_LINE 00000091 "}"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "# upgrade plain socket to SSL, used for CONNECT tunnel when proxying https"
NSQ_SOURCE_LINE 00000094 "# will only work if the underlying socket class of Net::HTTPS is"
NSQ_SOURCE_LINE 00000095 "# IO::Socket::SSL, but code will only be called in this case"
NSQ_SOURCE_LINE 00000096 "if ( $Net::HTTPS::SSL_SOCKET_CLASS->can('start_SSL')) {"
NSQ_SOURCE_LINE 00000097 "    *_upgrade_sock = sub {"
NSQ_SOURCE_LINE 00000098 "\tmy ($self,$sock,$url) = @_;"
NSQ_SOURCE_LINE 00000099 "    # SNI should be passed there only if it is not an IP address."
NSQ_SOURCE_LINE 00000100 "    # Details: https://github.com/libwww-perl/libwww-perl/issues/449#issuecomment-1896175509"
NSQ_SOURCE_LINE 00000101 "\tmy $host = $url->host() =~ m/:|^[\\d.]+$/s ? undef : $url->host();"
NSQ_SOURCE_LINE 00000102 "\tmy $usebio = {};"
NSQ_SOURCE_LINE 00000103 "\tif (UNIVERSAL::can($sock,'is_SSL') && $sock->is_SSL) {"
NSQ_SOURCE_LINE 00000104 "\t    $usebio = eval { $Net::HTTPS::SSL_SOCKET_CLASS->can_nested_ssl } or"
NSQ_SOURCE_LINE 00000105 "\t\tdie \"no support for nested TLS in this IO::Socket::SSL version\";"
NSQ_SOURCE_LINE 00000106 "\t}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "\t$sock = LWP::Protocol::https::Socket->start_SSL( my $osock = $sock,"
NSQ_SOURCE_LINE 00000109 "\t    SSL_verifycn_name => $url->host,"
NSQ_SOURCE_LINE 00000110 "\t    SSL_hostname => $host,"
NSQ_SOURCE_LINE 00000111 "\t    %$usebio,"
NSQ_SOURCE_LINE 00000112 "\t    $self->_extra_sock_opts,"
NSQ_SOURCE_LINE 00000113 "\t);"
NSQ_SOURCE_LINE 00000114 "\tif (!$sock) {"
NSQ_SOURCE_LINE 00000115 "\t    $@ = LWP::Protocol::https::Socket->errstr;"
NSQ_SOURCE_LINE 00000116 "\t    return;"
NSQ_SOURCE_LINE 00000117 "\t}"
NSQ_SOURCE_LINE 00000118 "\tif ($usebio and my @fields = grep { /^http_/ } keys %{*$osock}) {"
NSQ_SOURCE_LINE 00000119 "\t    # propagate any http_ fields from osock to sock"
NSQ_SOURCE_LINE 00000120 "\t    @{*$sock}{@fields} = @{*$osock}{@fields}"
NSQ_SOURCE_LINE 00000121 "\t}"
NSQ_SOURCE_LINE 00000122 "\treturn $sock;"
NSQ_SOURCE_LINE 00000123 "    }"
NSQ_SOURCE_LINE 00000124 "}"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "#-----------------------------------------------------------"
NSQ_SOURCE_LINE 00000127 "package LWP::Protocol::https::Socket;"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "use parent -norequire, qw(Net::HTTPS LWP::Protocol::http::SocketMethods);"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "1;"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "__END__"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=head1 NAME"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "LWP::Protocol::https - Provide https support for LWP::UserAgent"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "  use LWP::UserAgent;"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "  $ua = LWP::UserAgent->new(ssl_opts => { verify_hostname => 1 });"
NSQ_SOURCE_LINE 00000144 "  $res = $ua->get(\"https://www.example.com\");"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "  # specify a CA path"
NSQ_SOURCE_LINE 00000147 "  $ua = LWP::UserAgent->new("
NSQ_SOURCE_LINE 00000148 "      ssl_opts => {"
NSQ_SOURCE_LINE 00000149 "          SSL_ca_path     => '/etc/ssl/certs',"
NSQ_SOURCE_LINE 00000150 "          verify_hostname => 1,"
NSQ_SOURCE_LINE 00000151 "      }"
NSQ_SOURCE_LINE 00000152 "  );"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "The LWP::Protocol::https module provides support for using https schemed"
NSQ_SOURCE_LINE 00000157 "URLs with LWP.  This module is a plug-in to the LWP protocol handling, so"
NSQ_SOURCE_LINE 00000158 "you don't use it directly.  Once the module is installed LWP is able"
NSQ_SOURCE_LINE 00000159 "to access sites using HTTP over SSL/TLS."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "If hostname verification is requested by LWP::UserAgent's C<ssl_opts>, and"
NSQ_SOURCE_LINE 00000162 "neither C<SSL_ca_file> nor C<SSL_ca_path> is set, then C<SSL_ca_file> is"
NSQ_SOURCE_LINE 00000163 "implied to be the one provided by L<Mozilla::CA>.  If the Mozilla::CA module"
NSQ_SOURCE_LINE 00000164 "isn't available SSL requests will fail.  Either install this module, set up an"
NSQ_SOURCE_LINE 00000165 "alternative C<SSL_ca_file> or disable hostname verification."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "This module used to be bundled with the libwww-perl, but it was unbundled in"
NSQ_SOURCE_LINE 00000168 "v6.02 in order to be able to declare its dependencies properly for the CPAN"
NSQ_SOURCE_LINE 00000169 "tool-chain.  Applications that need https support can just declare their"
NSQ_SOURCE_LINE 00000170 "dependency on LWP::Protocol::https and will no longer need to know what"
NSQ_SOURCE_LINE 00000171 "underlying modules to install."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "L<IO::Socket::SSL>, L<Crypt::SSLeay>, L<Mozilla::CA>"
