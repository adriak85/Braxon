BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Text::Table::TSV;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2019-01-17'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.002'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "#IFUNBUILT"
NSQ_SOURCE_LINE 00000007 "# # use 5.010001;"
NSQ_SOURCE_LINE 00000008 "# # use strict;"
NSQ_SOURCE_LINE 00000009 "# # use warnings;"
NSQ_SOURCE_LINE 00000010 "#END IFUNBUILT"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "sub _encode {"
NSQ_SOURCE_LINE 00000013 "    my $val = shift;"
NSQ_SOURCE_LINE 00000014 "    $val =~ s/\\t/    /g;"
NSQ_SOURCE_LINE 00000015 "    $val;"
NSQ_SOURCE_LINE 00000016 "}"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub table {"
NSQ_SOURCE_LINE 00000019 "    my %params = @_;"
NSQ_SOURCE_LINE 00000020 "    my $rows = $params{rows} or die \"Must provide rows!\";"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    my $max_index = _max_array_index($rows);"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    # here we go..."
NSQ_SOURCE_LINE 00000025 "    my @table;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    # then the data"
NSQ_SOURCE_LINE 00000028 "    my $i = 0;"
NSQ_SOURCE_LINE 00000029 "    foreach my $row ( @{ $rows }[0..$#$rows] ) {"
NSQ_SOURCE_LINE 00000030 "        $i++;"
NSQ_SOURCE_LINE 00000031 "        push @table, join("
NSQ_SOURCE_LINE 00000032 "\t    \"\\t\","
NSQ_SOURCE_LINE 00000033 "\t    map { _encode(defined($row->[$_]) ? $row->[$_] : '') } (0..$max_index)"
NSQ_SOURCE_LINE 00000034 "\t), \"\\n\";"
NSQ_SOURCE_LINE 00000035 "    }"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    return join(\"\", grep {$_} @table);"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "# FROM_MODULE: PERLANCAR::List::Util::PP"
NSQ_SOURCE_LINE 00000041 "# BEGIN_BLOCK: max"
NSQ_SOURCE_LINE 00000042 "sub max {"
NSQ_SOURCE_LINE 00000043 "    return undef unless @_;"
NSQ_SOURCE_LINE 00000044 "    my $res = $_[0];"
NSQ_SOURCE_LINE 00000045 "    my $i = 0;"
NSQ_SOURCE_LINE 00000046 "    while (++$i < @_) { $res = $_[$i] if $_[$i] > $res }"
NSQ_SOURCE_LINE 00000047 "    $res;"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 "# END_BLOCK: max"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "# return highest top-index from all rows in case they're different lengths"
NSQ_SOURCE_LINE 00000052 "sub _max_array_index {"
NSQ_SOURCE_LINE 00000053 "    my $rows = shift;"
NSQ_SOURCE_LINE 00000054 "    return max( map { $#$_ } @$rows );"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "1;"
NSQ_SOURCE_LINE 00000058 "# ABSTRACT: Generate TSV"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "__END__"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=pod"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=head1 NAME"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "Text::Table::TSV - Generate TSV"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=head1 VERSION"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "This document describes version 0.002 of Text::Table::TSV (from Perl distribution Text-Table-TSV), released on 2019-01-17."
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 " use Text::Table::TSV;"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 " my $rows = ["
NSQ_SOURCE_LINE 00000079 "     # header row"
NSQ_SOURCE_LINE 00000080 "     ['Name', 'Rank', 'Serial'],"
NSQ_SOURCE_LINE 00000081 "     # rows"
NSQ_SOURCE_LINE 00000082 "     ['alice', 'pvt', '123456'],"
NSQ_SOURCE_LINE 00000083 "     ['bob',   'cpl', '98765321'],"
NSQ_SOURCE_LINE 00000084 "     ['carol', 'brig gen', '8745'],"
NSQ_SOURCE_LINE 00000085 " ];"
NSQ_SOURCE_LINE 00000086 " print Text::Table::TSV::table(rows => $rows);"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "This module provides a single function, C<table>, which formats a"
NSQ_SOURCE_LINE 00000091 "two-dimensional array of data as TSV. This is basically a way to generate TSV"
NSQ_SOURCE_LINE 00000092 "using the same interface as that of L<Text::Table::Tiny> (v0.03) or"
NSQ_SOURCE_LINE 00000093 "L<Text::Table::Org>."
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "The example shown in the SYNOPSIS generates the following table (Tab might be"
NSQ_SOURCE_LINE 00000096 "shown as spaces):"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 " Name    Rank    Serial"
NSQ_SOURCE_LINE 00000099 " alice   pvt     123456"
NSQ_SOURCE_LINE 00000100 " bob     cpl     98765321"
NSQ_SOURCE_LINE 00000101 " carol   brig gen        8745"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "=for Pod::Coverage ^(max)$"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=head2 table(%params) => str"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=head2 OPTIONS"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "The C<table> function understands these arguments, which are passed as a hash."
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=over"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=item * rows (aoaos)"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "Takes an array reference which should contain one or more rows of data, where"
NSQ_SOURCE_LINE 00000118 "each row is an array reference."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=back"
NSQ_SOURCE_LINE 00000121 ""
