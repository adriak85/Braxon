NSQ_SOURCE_LINE 00000001 "## no critic (InputOutput::RequireBriefOpen)"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "package Log::ger::Output::File;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000006 "our $DATE = '2020-03-11'; # DATE"
NSQ_SOURCE_LINE 00000007 "our $DIST = 'Log-ger-Output-File'; # DIST"
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.012'; # VERSION"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use strict;"
NSQ_SOURCE_LINE 00000011 "use warnings;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "# supply object methods for filehandles, required for older perls e.g. 5.10"
NSQ_SOURCE_LINE 00000014 "use FileHandle;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our %lock_handles;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub meta { +{"
NSQ_SOURCE_LINE 00000019 "    v => 2,"
NSQ_SOURCE_LINE 00000020 "} }"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub get_hooks {"
NSQ_SOURCE_LINE 00000023 "    my %plugin_conf = @_;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    my $lazy      = $plugin_conf{lazy};"
NSQ_SOURCE_LINE 00000026 "    my $autoflush = $plugin_conf{autoflush}; $autoflush = 1 unless defined $autoflush;"
NSQ_SOURCE_LINE 00000027 "    my $lock_mode = $plugin_conf{lock_mode} || 'none';"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    (defined($plugin_conf{path}) || $plugin_conf{handle}) or"
NSQ_SOURCE_LINE 00000030 "        die \"Please specify 'path' or 'handle'\";"
NSQ_SOURCE_LINE 00000031 "    $lock_mode =~ /\\A(none|write|exclusive)\\z/ or"
NSQ_SOURCE_LINE 00000032 "        die \"Invalid lock_mode, please choose none|write|exclusive\";"
NSQ_SOURCE_LINE 00000033 "    $lock_mode ne 'none' && $plugin_conf{handle} and"
NSQ_SOURCE_LINE 00000034 "        die \"Locking using handle not supported for now\";"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    my $code_lock = sub {"
NSQ_SOURCE_LINE 00000037 "        require File::Flock::Retry;"
NSQ_SOURCE_LINE 00000038 "        my $key = defined($plugin_conf{path}) ? \":$plugin_conf{path}\" : $plugin_conf{handle};"
NSQ_SOURCE_LINE 00000039 "        if ($lock_handles{$key}) {"
NSQ_SOURCE_LINE 00000040 "            return $lock_handles{$key};"
NSQ_SOURCE_LINE 00000041 "        }"
NSQ_SOURCE_LINE 00000042 "        $lock_handles{$key} = File::Flock::Retry->lock(\"$plugin_conf{path}.lck\");"
NSQ_SOURCE_LINE 00000043 "        #Scalar::Util::weaken($lock_handles{$key});"
NSQ_SOURCE_LINE 00000044 "        # XXX how do we purge old %lock_handles keys?"
NSQ_SOURCE_LINE 00000045 "        return $lock_handles{$key};"
NSQ_SOURCE_LINE 00000046 "    };"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "    my $fh;"
NSQ_SOURCE_LINE 00000049 "    my $code_open = sub {"
NSQ_SOURCE_LINE 00000050 "        return if $fh;"
NSQ_SOURCE_LINE 00000051 "        if (defined(my $path = $plugin_conf{path})) {"
NSQ_SOURCE_LINE 00000052 "            open $fh, \">>\", $path or die \"Can't open log file '$path': $!\";"
NSQ_SOURCE_LINE 00000053 "        } else {"
NSQ_SOURCE_LINE 00000054 "            $fh = $plugin_conf{handle};"
NSQ_SOURCE_LINE 00000055 "        }"
NSQ_SOURCE_LINE 00000056 "        $fh;"
NSQ_SOURCE_LINE 00000057 "    };"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    if ($lock_mode eq 'exclusive') {"
NSQ_SOURCE_LINE 00000060 "        $code_lock->();"
NSQ_SOURCE_LINE 00000061 "    }"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    $code_open->() unless $lazy;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    return {"
NSQ_SOURCE_LINE 00000066 "        create_outputter => ["
NSQ_SOURCE_LINE 00000067 "            __PACKAGE__, # key"
NSQ_SOURCE_LINE 00000068 "            50,          # priority"
NSQ_SOURCE_LINE 00000069 "            sub {        # hook"
NSQ_SOURCE_LINE 00000070 "                my %hook_args = @_; # see Log::ger::Manual::Internals/\"Arguments passed to hook\""
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "                my $outputter = sub {"
NSQ_SOURCE_LINE 00000073 "                    my ($per_target_conf, $msg, $per_msg_conf) = @_;"
NSQ_SOURCE_LINE 00000074 "                    my $lock_handle;"
NSQ_SOURCE_LINE 00000075 "                    $code_open->() if $lazy && !$fh;"
NSQ_SOURCE_LINE 00000076 "                    $lock_handle = $code_lock->() if $lock_mode eq 'write';"
NSQ_SOURCE_LINE 00000077 "                    print $fh $msg;"
NSQ_SOURCE_LINE 00000078 "                    print $fh \"\\n\" unless $msg =~ /\\R\\z/;"
NSQ_SOURCE_LINE 00000079 "                    $fh->flush if $autoflush || $lock_handle;"
NSQ_SOURCE_LINE 00000080 "                    undef $lock_handle;"
NSQ_SOURCE_LINE 00000081 "                };"
NSQ_SOURCE_LINE 00000082 "                [$outputter];"
NSQ_SOURCE_LINE 00000083 "            }],"
NSQ_SOURCE_LINE 00000084 "    };"
NSQ_SOURCE_LINE 00000085 "}"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "1;"
NSQ_SOURCE_LINE 00000088 "# ABSTRACT: Send logs to file"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "__END__"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=pod"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=head1 NAME"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "Log::ger::Output::File - Send logs to file"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=head1 VERSION"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "version 0.012"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 " use Log::ger::Output 'File' => ("
NSQ_SOURCE_LINE 00000107 "     path => '/path/to/file.log', # or handle => $fh"
NSQ_SOURCE_LINE 00000108 "     lazy => 1,                   # optional, default 0"
NSQ_SOURCE_LINE 00000109 " );"
NSQ_SOURCE_LINE 00000110 " use Log::ger;"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 " log_warn \"blah ...\";"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "This is a plugin to send logs to a file, with some options. File will be opened"
NSQ_SOURCE_LINE 00000117 "with append mode. A lock can be requested at every write, or when opening the"
NSQ_SOURCE_LINE 00000118 "file. By default, filehandle will be flushed after each log."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=for Pod::Coverage ^(.+)$"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head1 CONFIGURATION"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "=head2 path => filename"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "Specify filename to open. File will be opened in append mode."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=head2 handle => glob|obj"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "Alternatively, you can provide an already opened filehandle."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=head2 autoflush => bool (default: 1)"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Can be turned off if you need more speed, but note that under the absence of"
NSQ_SOURCE_LINE 00000135 "autoflush, partial log messages might be written."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=head2 lazy => bool (default: 0)"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "If set to true, will only open the file right before we need to log the message"
NSQ_SOURCE_LINE 00000140 "(instead of during output initialization). If you have lots of applications that"
NSQ_SOURCE_LINE 00000141 "use file logging, this can avoid the proliferation of zero-sized log files. On"
NSQ_SOURCE_LINE 00000142 "the other hand, the application bears an additional risk of failing to open a"
NSQ_SOURCE_LINE 00000143 "log file in the middle of the run."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=head2 lock_mode => str (none|write|exclusive, default: none)"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "If you set this to C<none> (the default), no locking is done. When there are"
NSQ_SOURCE_LINE 00000148 "several applications/processes that output log to the same file, messages from"
NSQ_SOURCE_LINE 00000149 "applications might get jumbled, e.g. partial message from application 1 is"
NSQ_SOURCE_LINE 00000150 "followed by message from application 2 and 3, then continued by the rest of"
NSQ_SOURCE_LINE 00000151 "message from application 1, and so on."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "If you set this to C<write>, an attempt to acquire an exclusive lock to C<<"
NSQ_SOURCE_LINE 00000154 "<PATH>.lck >> will be made. If all logger processes use locking, this makes it"
NSQ_SOURCE_LINE 00000155 "safe to log to the same file. However, this increases the overhead of writing"
NSQ_SOURCE_LINE 00000156 "the log which will become non-negligible once you log to files at the rate of"
NSQ_SOURCE_LINE 00000157 "thousands per second. Also, when a locking attempt fails after 60 seconds, this"
NSQ_SOURCE_LINE 00000158 "module will die. C<autoflush> is automatically turned on under this locking"
NSQ_SOURCE_LINE 00000159 "mode."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "If you set this to C<exclusive>, locking will be attempted only once during the"
NSQ_SOURCE_LINE 00000162 "output initialization."
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=head1 TODO"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "When C<lock_mode> is set to C<exclusive>, and user switches output, we have not"
NSQ_SOURCE_LINE 00000167 "released the lock."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "L<Log::ger>"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "L<Log::ger::Output::SimpleFile> is a simpler output plugin: no locking,"
NSQ_SOURCE_LINE 00000174 "autoflush, or lazy options."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "L<Log::ger::Output::FileWriteRotate> offers autorotation feature."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "perlancar <perlancar@cpan.org>"
