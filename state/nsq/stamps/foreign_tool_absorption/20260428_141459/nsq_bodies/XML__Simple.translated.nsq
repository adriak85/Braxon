NSQ_SOURCE_LINE 00000001 "package XML::Simple;"
NSQ_SOURCE_LINE 00000002 "$XML::Simple::VERSION = '2.25';"
NSQ_SOURCE_LINE 00000003 "=head1 NAME"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "XML::Simple - An API for simple XML files"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "PLEASE DO NOT USE THIS MODULE IN NEW CODE.  If you ignore this"
NSQ_SOURCE_LINE 00000010 "warning and use it anyway, the C<qw(:strict)> mode will save you a little pain."
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "    use XML::Simple qw(:strict);"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "    my $ref = XMLin([<xml file or string>] [, <options>]);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "    my $xml = XMLout($hashref [, <options>]);"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "Or the object oriented way:"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    require XML::Simple qw(:strict);"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    my $xs = XML::Simple->new([<options>]);"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    my $ref = $xs->XMLin([<xml file or string>] [, <options>]);"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    my $xml = $xs->XMLout($hashref [, <options>]);"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "(or see L<\"SAX SUPPORT\"> for 'the SAX way')."
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "Note, in these examples, the square brackets are used to denote optional items"
NSQ_SOURCE_LINE 00000031 "not to imply items should be supplied in arrayrefs."
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=cut"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "# See after __END__ for more POD documentation"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "# Load essentials here, other modules loaded on demand later"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "use strict;"
NSQ_SOURCE_LINE 00000041 "use warnings;"
NSQ_SOURCE_LINE 00000042 "use warnings::register;"
NSQ_SOURCE_LINE 00000043 "use Carp;"
NSQ_SOURCE_LINE 00000044 "use Scalar::Util qw();"
NSQ_SOURCE_LINE 00000045 "require Exporter;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "##############################################################################"
NSQ_SOURCE_LINE 00000049 "# Define some constants"
NSQ_SOURCE_LINE 00000050 "#"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "use vars qw($VERSION @ISA @EXPORT @EXPORT_OK $PREFERRED_PARSER);"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "@ISA               = qw(Exporter);"
NSQ_SOURCE_LINE 00000055 "@EXPORT            = qw(XMLin XMLout);"
NSQ_SOURCE_LINE 00000056 "@EXPORT_OK         = qw(xml_in xml_out);"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "my %StrictMode     = ();"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "my @KnownOptIn     = qw(keyattr keeproot forcecontent contentkey noattr"
NSQ_SOURCE_LINE 00000061 "                        searchpath forcearray cache suppressempty parseropts"
NSQ_SOURCE_LINE 00000062 "                        grouptags nsexpand datahandler varattr variables"
NSQ_SOURCE_LINE 00000063 "                        normalisespace normalizespace valueattr strictmode);"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "my @KnownOptOut    = qw(keyattr keeproot contentkey noattr"
NSQ_SOURCE_LINE 00000066 "                        rootname xmldecl outputfile noescape suppressempty"
NSQ_SOURCE_LINE 00000067 "                        grouptags nsexpand handler noindent attrindent nosort"
NSQ_SOURCE_LINE 00000068 "                        valueattr numericescape strictmode);"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "my @DefKeyAttr     = qw(name key id);"
NSQ_SOURCE_LINE 00000071 "my $DefRootName    = qq(opt);"
NSQ_SOURCE_LINE 00000072 "my $DefContentKey  = qq(content);"
NSQ_SOURCE_LINE 00000073 "my $DefXmlDecl     = qq(<?xml version='1.0' standalone='yes'?>);"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "my $xmlns_ns       = 'http://www.w3.org/2000/xmlns/';"
NSQ_SOURCE_LINE 00000076 "my $bad_def_ns_jcn = '{' . $xmlns_ns . '}';     # LibXML::SAX workaround"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "##############################################################################"
NSQ_SOURCE_LINE 00000080 "# Globals for use by caching routines"
NSQ_SOURCE_LINE 00000081 "#"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "my %MemShareCache  = ();"
NSQ_SOURCE_LINE 00000084 "my %MemCopyCache   = ();"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "##############################################################################"
NSQ_SOURCE_LINE 00000088 "# Wrapper for Exporter - handles ':strict'"
NSQ_SOURCE_LINE 00000089 "#"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "sub import {"
NSQ_SOURCE_LINE 00000092 "  # Handle the :strict tag"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "  my($calling_package) = caller();"
NSQ_SOURCE_LINE 00000095 "  _strict_mode_for_caller(1) if grep(/^:strict$/, @_);"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "  # Pass everything else to Exporter.pm"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "  @_ = grep(!/^:strict$/, @_);"
NSQ_SOURCE_LINE 00000100 "  goto &Exporter::import;"
NSQ_SOURCE_LINE 00000101 "}"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "##############################################################################"
NSQ_SOURCE_LINE 00000105 "# Constructor for optional object interface."
NSQ_SOURCE_LINE 00000106 "#"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "sub new {"
NSQ_SOURCE_LINE 00000109 "  my $class = shift;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "  if(@_ % 2) {"
NSQ_SOURCE_LINE 00000112 "    croak \"Default options must be name=>value pairs (odd number supplied)\";"
NSQ_SOURCE_LINE 00000113 "  }"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "  my %known_opt;"
NSQ_SOURCE_LINE 00000116 "  @known_opt{@KnownOptIn, @KnownOptOut} = ();"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "  my %raw_opt = @_;"
NSQ_SOURCE_LINE 00000119 "  $raw_opt{strictmode} = _strict_mode_for_caller()"
NSQ_SOURCE_LINE 00000120 "    unless exists $raw_opt{strictmode};"
NSQ_SOURCE_LINE 00000121 "  my %def_opt;"
NSQ_SOURCE_LINE 00000122 "  while(my($key, $val) = each %raw_opt) {"
NSQ_SOURCE_LINE 00000123 "    my $lkey = lc($key);"
NSQ_SOURCE_LINE 00000124 "    $lkey =~ s/_//g;"
NSQ_SOURCE_LINE 00000125 "    croak \"Unrecognised option: $key\" unless(exists($known_opt{$lkey}));"
NSQ_SOURCE_LINE 00000126 "    $def_opt{$lkey} = $val;"
NSQ_SOURCE_LINE 00000127 "  }"
NSQ_SOURCE_LINE 00000128 "  my $self = { def_opt => \\%def_opt };"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "  return(bless($self, $class));"
NSQ_SOURCE_LINE 00000131 "}"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "##############################################################################"
NSQ_SOURCE_LINE 00000135 "# Sub: _strict_mode_for_caller()"
NSQ_SOURCE_LINE 00000136 "#"
NSQ_SOURCE_LINE 00000137 "# Gets or sets the XML::Simple :strict mode flag for the calling namespace."
NSQ_SOURCE_LINE 00000138 "# Walks back through call stack to find the calling namespace and sets the"
NSQ_SOURCE_LINE 00000139 "# :strict mode flag for that namespace if an argument was supplied and returns"
NSQ_SOURCE_LINE 00000140 "# the flag value if not."
NSQ_SOURCE_LINE 00000141 "#"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "sub _strict_mode_for_caller {"
NSQ_SOURCE_LINE 00000144 "  my $set_mode = @_;"
NSQ_SOURCE_LINE 00000145 "  my $frame = 1;"
NSQ_SOURCE_LINE 00000146 "  while(my($package) = caller($frame++)) {"
NSQ_SOURCE_LINE 00000147 "    next if $package eq 'XML::Simple';"
NSQ_SOURCE_LINE 00000148 "    $StrictMode{$package} = 1 if $set_mode;"
NSQ_SOURCE_LINE 00000149 "    return $StrictMode{$package};"
NSQ_SOURCE_LINE 00000150 "  }"
NSQ_SOURCE_LINE 00000151 "  return(0);"
NSQ_SOURCE_LINE 00000152 "}"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "##############################################################################"
NSQ_SOURCE_LINE 00000156 "# Sub: _get_object()"
NSQ_SOURCE_LINE 00000157 "#"
NSQ_SOURCE_LINE 00000158 "# Helper routine called from XMLin() and XMLout() to create an object if none"
NSQ_SOURCE_LINE 00000159 "# was provided.  Note, this routine does mess with the caller's @_ array."
NSQ_SOURCE_LINE 00000160 "#"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "sub _get_object {"
NSQ_SOURCE_LINE 00000163 "  my $self;"
NSQ_SOURCE_LINE 00000164 "  if($_[0]  and  UNIVERSAL::isa($_[0], 'XML::Simple')) {"
NSQ_SOURCE_LINE 00000165 "    $self = shift;"
NSQ_SOURCE_LINE 00000166 "  }"
NSQ_SOURCE_LINE 00000167 "  else {"
NSQ_SOURCE_LINE 00000168 "    $self = XML::Simple->new();"
NSQ_SOURCE_LINE 00000169 "  }"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "  return $self;"
NSQ_SOURCE_LINE 00000172 "}"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "##############################################################################"
NSQ_SOURCE_LINE 00000176 "# Sub/Method: XMLin()"
NSQ_SOURCE_LINE 00000177 "#"
NSQ_SOURCE_LINE 00000178 "# Exported routine for slurping XML into a hashref - see pod for info."
NSQ_SOURCE_LINE 00000179 "#"
NSQ_SOURCE_LINE 00000180 "# May be called as object method or as a plain function."
NSQ_SOURCE_LINE 00000181 "#"
NSQ_SOURCE_LINE 00000182 "# Expects one arg for the source XML, optionally followed by a number of"
NSQ_SOURCE_LINE 00000183 "# name => value option pairs."
NSQ_SOURCE_LINE 00000184 "#"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "sub XMLin {"
NSQ_SOURCE_LINE 00000187 "  my $self = &_get_object;      # note, @_ is passed implicitly"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "  my $target = shift;"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "  # Work out whether to parse a string, a file or a filehandle"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "  if(not defined $target) {"
NSQ_SOURCE_LINE 00000195 "    return $self->parse_file(undef, @_);"
NSQ_SOURCE_LINE 00000196 "  }"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "  elsif($target eq '-') {"
NSQ_SOURCE_LINE 00000199 "    local($/) = undef;"
NSQ_SOURCE_LINE 00000200 "    $target = <STDIN>;"
NSQ_SOURCE_LINE 00000201 "    return $self->parse_string(\\$target, @_);"
NSQ_SOURCE_LINE 00000202 "  }"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "  elsif(my $type = ref($target)) {"
NSQ_SOURCE_LINE 00000205 "    if($type eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000206 "      return $self->parse_string($target, @_);"
NSQ_SOURCE_LINE 00000207 "    }"
NSQ_SOURCE_LINE 00000208 "    else {"
NSQ_SOURCE_LINE 00000209 "      return $self->parse_fh($target, @_);"
NSQ_SOURCE_LINE 00000210 "    }"
NSQ_SOURCE_LINE 00000211 "  }"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "  elsif($target =~ m{<.*?>}s) {"
NSQ_SOURCE_LINE 00000214 "    return $self->parse_string(\\$target, @_);"
NSQ_SOURCE_LINE 00000215 "  }"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "  else {"
NSQ_SOURCE_LINE 00000218 "    return $self->parse_file($target, @_);"
NSQ_SOURCE_LINE 00000219 "  }"
NSQ_SOURCE_LINE 00000220 "}"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "##############################################################################"
NSQ_SOURCE_LINE 00000224 "# Sub/Method: parse_file()"
NSQ_SOURCE_LINE 00000225 "#"
NSQ_SOURCE_LINE 00000226 "# Same as XMLin, but only parses from a named file."
NSQ_SOURCE_LINE 00000227 "#"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "sub parse_file {"
NSQ_SOURCE_LINE 00000230 "  my $self = &_get_object;      # note, @_ is passed implicitly"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "  my $filename = shift;"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "  $self->handle_options('in', @_);"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "  $filename = $self->default_config_file if not defined $filename;"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "  $filename = $self->find_xml_file($filename, @{$self->{opt}->{searchpath}});"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "  # Check cache for previous parse"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "  if($self->{opt}->{cache}) {"
NSQ_SOURCE_LINE 00000243 "    foreach my $scheme (@{$self->{opt}->{cache}}) {"
NSQ_SOURCE_LINE 00000244 "      my $method = 'cache_read_' . $scheme;"
NSQ_SOURCE_LINE 00000245 "      my $opt = $self->$method($filename);"
NSQ_SOURCE_LINE 00000246 "      return($opt) if($opt);"
NSQ_SOURCE_LINE 00000247 "    }"
NSQ_SOURCE_LINE 00000248 "  }"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "  my $ref = $self->build_simple_tree($filename, undef);"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "  if($self->{opt}->{cache}) {"
NSQ_SOURCE_LINE 00000253 "    my $method = 'cache_write_' . $self->{opt}->{cache}->[0];"
NSQ_SOURCE_LINE 00000254 "    $self->$method($ref, $filename);"
NSQ_SOURCE_LINE 00000255 "  }"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "  return $ref;"
NSQ_SOURCE_LINE 00000258 "}"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "##############################################################################"
NSQ_SOURCE_LINE 00000262 "# Sub/Method: parse_fh()"
NSQ_SOURCE_LINE 00000263 "#"
NSQ_SOURCE_LINE 00000264 "# Same as XMLin, but only parses from a filehandle."
NSQ_SOURCE_LINE 00000265 "#"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "sub parse_fh {"
NSQ_SOURCE_LINE 00000268 "  my $self = &_get_object;      # note, @_ is passed implicitly"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "  my $fh = shift;"
NSQ_SOURCE_LINE 00000271 "  croak \"Can't use \" . (defined $fh ? qq{string (\"$fh\")} : 'undef') ."
NSQ_SOURCE_LINE 00000272 "        \" as a filehandle\" unless ref $fh;"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "  $self->handle_options('in', @_);"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "  return $self->build_simple_tree(undef, $fh);"
NSQ_SOURCE_LINE 00000277 "}"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "##############################################################################"
NSQ_SOURCE_LINE 00000281 "# Sub/Method: parse_string()"
NSQ_SOURCE_LINE 00000282 "#"
NSQ_SOURCE_LINE 00000283 "# Same as XMLin, but only parses from a string or a reference to a string."
NSQ_SOURCE_LINE 00000284 "#"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "sub parse_string {"
NSQ_SOURCE_LINE 00000287 "  my $self = &_get_object;      # note, @_ is passed implicitly"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "  my $string = shift;"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "  $self->handle_options('in', @_);"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "  return $self->build_simple_tree(undef, ref $string ? $string : \\$string);"
NSQ_SOURCE_LINE 00000294 "}"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "##############################################################################"
NSQ_SOURCE_LINE 00000298 "# Method: default_config_file()"
NSQ_SOURCE_LINE 00000299 "#"
NSQ_SOURCE_LINE 00000300 "# Returns the name of the XML file to parse if no filename (or XML string)"
NSQ_SOURCE_LINE 00000301 "# was provided."
NSQ_SOURCE_LINE 00000302 "#"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "sub default_config_file {"
NSQ_SOURCE_LINE 00000305 "  my $self = shift;"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "  require File::Basename;"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "  my($basename, $script_dir, $ext) = File::Basename::fileparse($0, '\\.[^\\.]+');"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "  # Add script directory to searchpath"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "  if($script_dir) {"
NSQ_SOURCE_LINE 00000314 "    unshift(@{$self->{opt}->{searchpath}}, $script_dir);"
NSQ_SOURCE_LINE 00000315 "  }"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "  return $basename . '.xml';"
NSQ_SOURCE_LINE 00000318 "}"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "##############################################################################"
NSQ_SOURCE_LINE 00000322 "# Method: build_simple_tree()"
NSQ_SOURCE_LINE 00000323 "#"
NSQ_SOURCE_LINE 00000324 "# Builds a 'tree' data structure as provided by XML::Parser and then"
NSQ_SOURCE_LINE 00000325 "# 'simplifies' it as specified by the various options in effect."
NSQ_SOURCE_LINE 00000326 "#"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "sub build_simple_tree {"
NSQ_SOURCE_LINE 00000329 "  my $self = shift;"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "  my $tree = eval {"
NSQ_SOURCE_LINE 00000332 "    $self->build_tree(@_);"
NSQ_SOURCE_LINE 00000333 "  };"
NSQ_SOURCE_LINE 00000334 "  Carp::croak(\"$@XML::Simple called\") if $@;"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "  return $self->{opt}->{keeproot}"
NSQ_SOURCE_LINE 00000337 "         ? $self->collapse({}, @$tree)"
NSQ_SOURCE_LINE 00000338 "         : $self->collapse(@{$tree->[1]});"
NSQ_SOURCE_LINE 00000339 "}"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "##############################################################################"
NSQ_SOURCE_LINE 00000343 "# Method: build_tree()"
NSQ_SOURCE_LINE 00000344 "#"
NSQ_SOURCE_LINE 00000345 "# This routine will be called if there is no suitable pre-parsed tree in a"
NSQ_SOURCE_LINE 00000346 "# cache.  It parses the XML and returns an XML::Parser 'Tree' style data"
NSQ_SOURCE_LINE 00000347 "# structure (summarised in the comments for the collapse() routine below)."
NSQ_SOURCE_LINE 00000348 "#"
NSQ_SOURCE_LINE 00000349 "# XML::Simple requires the services of another module that knows how to parse"
NSQ_SOURCE_LINE 00000350 "# XML.  If XML::SAX is installed, the default SAX parser will be used,"
NSQ_SOURCE_LINE 00000351 "# otherwise XML::Parser will be used."
NSQ_SOURCE_LINE 00000352 "#"
NSQ_SOURCE_LINE 00000353 "# This routine expects to be passed a filename as argument 1 or a 'string' as"
NSQ_SOURCE_LINE 00000354 "# argument 2.  The 'string' might be a string of XML (passed by reference to"
NSQ_SOURCE_LINE 00000355 "# save memory) or it might be a reference to an IO::Handle.  (This"
NSQ_SOURCE_LINE 00000356 "# non-intuitive mess results in part from the way XML::Parser works but that's"
NSQ_SOURCE_LINE 00000357 "# really no excuse)."
NSQ_SOURCE_LINE 00000358 "#"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "sub build_tree {"
NSQ_SOURCE_LINE 00000361 "  my $self     = shift;"
NSQ_SOURCE_LINE 00000362 "  my $filename = shift;"
NSQ_SOURCE_LINE 00000363 "  my $string   = shift;"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "  my $preferred_parser = $PREFERRED_PARSER;"
NSQ_SOURCE_LINE 00000367 "  unless(defined($preferred_parser)) {"
NSQ_SOURCE_LINE 00000368 "    $preferred_parser = $ENV{XML_SIMPLE_PREFERRED_PARSER} || '';"
NSQ_SOURCE_LINE 00000369 "  }"
NSQ_SOURCE_LINE 00000370 "  if($preferred_parser eq 'XML::Parser') {"
NSQ_SOURCE_LINE 00000371 "    return($self->build_tree_xml_parser($filename, $string));"
NSQ_SOURCE_LINE 00000372 "  }"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "  eval { require XML::SAX; };      # We didn't need it until now"
NSQ_SOURCE_LINE 00000375 "  if($@) {                         # No XML::SAX - fall back to XML::Parser"
NSQ_SOURCE_LINE 00000376 "    if($preferred_parser) {        # unless a SAX parser was expressly requested"
NSQ_SOURCE_LINE 00000377 "      croak \"XMLin() could not load XML::SAX\";"
NSQ_SOURCE_LINE 00000378 "    }"
NSQ_SOURCE_LINE 00000379 "    return($self->build_tree_xml_parser($filename, $string));"
NSQ_SOURCE_LINE 00000380 "  }"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "  $XML::SAX::ParserPackage = $preferred_parser if($preferred_parser);"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "  my $sp = XML::SAX::ParserFactory->parser(Handler => $self);"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "  $self->{nocollapse} = 1;"
NSQ_SOURCE_LINE 00000387 "  my($tree);"
NSQ_SOURCE_LINE 00000388 "  if($filename) {"
NSQ_SOURCE_LINE 00000389 "    $tree = $sp->parse_uri($filename);"
NSQ_SOURCE_LINE 00000390 "  }"
NSQ_SOURCE_LINE 00000391 "  else {"
NSQ_SOURCE_LINE 00000392 "    if(ref($string) && ref($string) ne 'SCALAR') {"
NSQ_SOURCE_LINE 00000393 "      $tree = $sp->parse_file($string);"
NSQ_SOURCE_LINE 00000394 "    }"
NSQ_SOURCE_LINE 00000395 "    else {"
NSQ_SOURCE_LINE 00000396 "      $tree = $sp->parse_string($$string);"
NSQ_SOURCE_LINE 00000397 "    }"
NSQ_SOURCE_LINE 00000398 "  }"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "  return($tree);"
NSQ_SOURCE_LINE 00000401 "}"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "##############################################################################"
NSQ_SOURCE_LINE 00000405 "# Method: build_tree_xml_parser()"
NSQ_SOURCE_LINE 00000406 "#"
NSQ_SOURCE_LINE 00000407 "# This routine will be called if XML::SAX is not installed, or if XML::Parser"
NSQ_SOURCE_LINE 00000408 "# was specifically requested.  It takes the same arguments as build_tree() and"
NSQ_SOURCE_LINE 00000409 "# returns the same data structure (XML::Parser 'Tree' style)."
NSQ_SOURCE_LINE 00000410 "#"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "sub build_tree_xml_parser {"
NSQ_SOURCE_LINE 00000413 "  my $self     = shift;"
NSQ_SOURCE_LINE 00000414 "  my $filename = shift;"
NSQ_SOURCE_LINE 00000415 "  my $string   = shift;"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "  eval {"
NSQ_SOURCE_LINE 00000419 "    local($^W) = 0;      # Suppress warning from Expat.pm re File::Spec::load()"
NSQ_SOURCE_LINE 00000420 "    require XML::Parser; # We didn't need it until now"
NSQ_SOURCE_LINE 00000421 "  };"
NSQ_SOURCE_LINE 00000422 "  if($@) {"
NSQ_SOURCE_LINE 00000423 "    croak \"XMLin() requires either XML::SAX or XML::Parser\";"
NSQ_SOURCE_LINE 00000424 "  }"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "  if($self->{opt}->{nsexpand}) {"
NSQ_SOURCE_LINE 00000427 "    carp \"'nsexpand' option requires XML::SAX\";"
NSQ_SOURCE_LINE 00000428 "  }"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "  my $xp = $self->new_xml_parser();"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "  my($tree);"
NSQ_SOURCE_LINE 00000433 "  if($filename) {"
NSQ_SOURCE_LINE 00000434 "    # $tree = $xp->parsefile($filename);  # Changed due to prob w/mod_perl"
NSQ_SOURCE_LINE 00000435 "    open(my $xfh, '<', $filename) || croak qq($filename - $!);"
NSQ_SOURCE_LINE 00000436 "    $tree = $xp->parse($xfh);"
NSQ_SOURCE_LINE 00000437 "  }"
NSQ_SOURCE_LINE 00000438 "  else {"
NSQ_SOURCE_LINE 00000439 "    $tree = $xp->parse($$string);"
NSQ_SOURCE_LINE 00000440 "  }"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "  return($tree);"
