NSQ_SOURCE_LINE 00000463 "##############################################################################"
NSQ_SOURCE_LINE 00000464 "# Method: cache_write_storable()"
NSQ_SOURCE_LINE 00000465 "#"
NSQ_SOURCE_LINE 00000466 "# Wrapper routine for invoking Storable::nstore() to cache a parsed data"
NSQ_SOURCE_LINE 00000467 "# structure."
NSQ_SOURCE_LINE 00000468 "#"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "sub cache_write_storable {"
NSQ_SOURCE_LINE 00000471 "  my($self, $data, $filename) = @_;"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "  my $cachefile = $self->storable_filename($filename);"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "  require Storable;           # We didn't need it until now"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "  if ('VMS' eq $^O) {"
NSQ_SOURCE_LINE 00000478 "    Storable::nstore($data, $cachefile);"
NSQ_SOURCE_LINE 00000479 "  }"
NSQ_SOURCE_LINE 00000480 "  else {"
NSQ_SOURCE_LINE 00000481 "    # If the following line fails for you, your Storable.pm is old - upgrade"
NSQ_SOURCE_LINE 00000482 "    Storable::lock_nstore($data, $cachefile);"
NSQ_SOURCE_LINE 00000483 "  }"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "}"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "##############################################################################"
NSQ_SOURCE_LINE 00000489 "# Method: cache_read_storable()"
NSQ_SOURCE_LINE 00000490 "#"
NSQ_SOURCE_LINE 00000491 "# Wrapper routine for invoking Storable::retrieve() to read a cached parsed"
NSQ_SOURCE_LINE 00000492 "# data structure.  Only returns cached data if the cache file exists and is"
NSQ_SOURCE_LINE 00000493 "# newer than the source XML file."
NSQ_SOURCE_LINE 00000494 "#"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "sub cache_read_storable {"
NSQ_SOURCE_LINE 00000497 "  my($self, $filename) = @_;"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "  my $cachefile = $self->storable_filename($filename);"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "  return unless(-r $cachefile);"
NSQ_SOURCE_LINE 00000502 "  return unless((stat($cachefile))[9] > (stat($filename))[9]);"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "  require Storable;           # We didn't need it until now"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "  if ('VMS' eq $^O) {"
NSQ_SOURCE_LINE 00000507 "    return(Storable::retrieve($cachefile));"
NSQ_SOURCE_LINE 00000508 "  }"
NSQ_SOURCE_LINE 00000509 "  else {"
NSQ_SOURCE_LINE 00000510 "    return(Storable::lock_retrieve($cachefile));"
NSQ_SOURCE_LINE 00000511 "  }"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "}"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "##############################################################################"
NSQ_SOURCE_LINE 00000517 "# Method: storable_filename()"
NSQ_SOURCE_LINE 00000518 "#"
NSQ_SOURCE_LINE 00000519 "# Translates the supplied source XML filename into a filename for the storable"
NSQ_SOURCE_LINE 00000520 "# cached data.  A '.stor' suffix is added after stripping an optional '.xml'"
NSQ_SOURCE_LINE 00000521 "# suffix."
NSQ_SOURCE_LINE 00000522 "#"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "sub storable_filename {"
NSQ_SOURCE_LINE 00000525 "  my($self, $cachefile) = @_;"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "  $cachefile =~ s{(\\.xml)?$}{.stor};"
NSQ_SOURCE_LINE 00000528 "  return $cachefile;"
NSQ_SOURCE_LINE 00000529 "}"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "##############################################################################"
