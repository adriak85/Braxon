NSQ_SOURCE_LINE 00000597 "##############################################################################"
NSQ_SOURCE_LINE 00000598 "# Sub/Method: XMLout()"
NSQ_SOURCE_LINE 00000599 "#"
NSQ_SOURCE_LINE 00000600 "# Exported routine for 'unslurping' a data structure out to XML."
NSQ_SOURCE_LINE 00000601 "#"
NSQ_SOURCE_LINE 00000602 "# Expects a reference to a data structure and an optional list of option"
NSQ_SOURCE_LINE 00000603 "# name => value pairs."
NSQ_SOURCE_LINE 00000604 "#"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "sub XMLout {"
NSQ_SOURCE_LINE 00000607 "  my $self = &_get_object;      # note, @_ is passed implicitly"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "  croak \"XMLout() requires at least one argument\" unless(@_);"
NSQ_SOURCE_LINE 00000610 "  my $ref = shift;"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "  $self->handle_options('out', @_);"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "  # If namespace expansion is set, XML::NamespaceSupport is required"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "  if($self->{opt}->{nsexpand}) {"
NSQ_SOURCE_LINE 00000618 "    require XML::NamespaceSupport;"
NSQ_SOURCE_LINE 00000619 "    $self->{nsup} = XML::NamespaceSupport->new();"
NSQ_SOURCE_LINE 00000620 "    $self->{ns_prefix} = 'aaa';"
NSQ_SOURCE_LINE 00000621 "  }"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "  # Wrap top level arrayref in a hash"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "  if(UNIVERSAL::isa($ref, 'ARRAY')) {"
NSQ_SOURCE_LINE 00000627 "    $ref = { anon => $ref };"
NSQ_SOURCE_LINE 00000628 "  }"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "  # Extract rootname from top level hash if keeproot enabled"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "  if($self->{opt}->{keeproot}) {"
NSQ_SOURCE_LINE 00000634 "    my(@keys) = keys(%$ref);"
NSQ_SOURCE_LINE 00000635 "    if(@keys == 1) {"
NSQ_SOURCE_LINE 00000636 "      $ref = $ref->{$keys[0]};"
NSQ_SOURCE_LINE 00000637 "      $self->{opt}->{rootname} = $keys[0];"
NSQ_SOURCE_LINE 00000638 "    }"
NSQ_SOURCE_LINE 00000639 "  }"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "  # Ensure there are no top level attributes if we're not adding root elements"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "  elsif($self->{opt}->{rootname} eq '') {"
NSQ_SOURCE_LINE 00000644 "    if(UNIVERSAL::isa($ref, 'HASH')) {"
NSQ_SOURCE_LINE 00000645 "      my $refsave = $ref;"
NSQ_SOURCE_LINE 00000646 "      $ref = {};"
NSQ_SOURCE_LINE 00000647 "      foreach (keys(%$refsave)) {"
NSQ_SOURCE_LINE 00000648 "        if(ref($refsave->{$_})) {"
NSQ_SOURCE_LINE 00000649 "          $ref->{$_} = $refsave->{$_};"
NSQ_SOURCE_LINE 00000650 "        }"
NSQ_SOURCE_LINE 00000651 "        else {"
NSQ_SOURCE_LINE 00000652 "          $ref->{$_} = [ $refsave->{$_} ];"
NSQ_SOURCE_LINE 00000653 "        }"
NSQ_SOURCE_LINE 00000654 "      }"
NSQ_SOURCE_LINE 00000655 "    }"
NSQ_SOURCE_LINE 00000656 "  }"
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "  # Encode the hashref and write to file if necessary"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "  $self->{_ancestors} = {};"
NSQ_SOURCE_LINE 00000662 "  my $xml = $self->value_to_xml($ref, $self->{opt}->{rootname}, '');"
NSQ_SOURCE_LINE 00000663 "  delete $self->{_ancestors};"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "  if($self->{opt}->{xmldecl}) {"
NSQ_SOURCE_LINE 00000666 "    $xml = $self->{opt}->{xmldecl} . \"\\n\" . $xml;"
NSQ_SOURCE_LINE 00000667 "  }"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "  if($self->{opt}->{outputfile}) {"
NSQ_SOURCE_LINE 00000670 "    if(ref($self->{opt}->{outputfile})) {"
NSQ_SOURCE_LINE 00000671 "      my $fh = $self->{opt}->{outputfile};"
NSQ_SOURCE_LINE 00000672 "      if(UNIVERSAL::isa($fh, 'GLOB') and !UNIVERSAL::can($fh, 'print')) {"
NSQ_SOURCE_LINE 00000673 "        eval { require IO::Handle; };"
NSQ_SOURCE_LINE 00000674 "        croak $@ if $@;"
NSQ_SOURCE_LINE 00000675 "      }"
NSQ_SOURCE_LINE 00000676 "      return($fh->print($xml));"
NSQ_SOURCE_LINE 00000677 "    }"
NSQ_SOURCE_LINE 00000678 "    else {"
NSQ_SOURCE_LINE 00000679 "      open(my $out, '>', \"$self->{opt}->{outputfile}\") ||"
NSQ_SOURCE_LINE 00000680 "        croak \"open($self->{opt}->{outputfile}): $!\";"
NSQ_SOURCE_LINE 00000681 "      binmode($out, ':utf8') if($] >= 5.008);"
NSQ_SOURCE_LINE 00000682 "      print $out $xml or croak \"print: $!\";"
NSQ_SOURCE_LINE 00000683 "      close $out or croak \"close: $!\";"
NSQ_SOURCE_LINE 00000684 "    }"
NSQ_SOURCE_LINE 00000685 "  }"
NSQ_SOURCE_LINE 00000686 "  elsif($self->{opt}->{handler}) {"
NSQ_SOURCE_LINE 00000687 "    require XML::SAX;"
NSQ_SOURCE_LINE 00000688 "    my $sp = XML::SAX::ParserFactory->parser("
NSQ_SOURCE_LINE 00000689 "               Handler => $self->{opt}->{handler}"
NSQ_SOURCE_LINE 00000690 "             );"
NSQ_SOURCE_LINE 00000691 "    return($sp->parse_string($xml));"
NSQ_SOURCE_LINE 00000692 "  }"
NSQ_SOURCE_LINE 00000693 "  else {"
NSQ_SOURCE_LINE 00000694 "    return($xml);"
NSQ_SOURCE_LINE 00000695 "  }"
NSQ_SOURCE_LINE 00000696 "}"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "##############################################################################"
NSQ_SOURCE_LINE 00000700 "# Method: handle_options()"
NSQ_SOURCE_LINE 00000701 "#"
NSQ_SOURCE_LINE 00000702 "# Helper routine for both XMLin() and XMLout().  Both routines handle their"
NSQ_SOURCE_LINE 00000703 "# first argument and assume all other args are options handled by this routine."
NSQ_SOURCE_LINE 00000704 "# Saves a hash of options in $self->{opt}."
NSQ_SOURCE_LINE 00000705 "#"
NSQ_SOURCE_LINE 00000706 "# If default options were passed to the constructor, they will be retrieved"
NSQ_SOURCE_LINE 00000707 "# here and merged with options supplied to the method call."
NSQ_SOURCE_LINE 00000708 "#"
NSQ_SOURCE_LINE 00000709 "# First argument should be the string 'in' or the string 'out'."
NSQ_SOURCE_LINE 00000710 "#"
NSQ_SOURCE_LINE 00000711 "# Remaining arguments should be name=>value pairs.  Sets up default values"
NSQ_SOURCE_LINE 00000712 "# for options not supplied.  Unrecognised options are a fatal error."
NSQ_SOURCE_LINE 00000713 "#"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "sub handle_options  {"
NSQ_SOURCE_LINE 00000716 "  my $self = shift;"
NSQ_SOURCE_LINE 00000717 "  my $dirn = shift;"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "  # Determine valid options based on context"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "  my %known_opt;"
NSQ_SOURCE_LINE 00000723 "  if($dirn eq 'in') {"
NSQ_SOURCE_LINE 00000724 "    @known_opt{@KnownOptIn} = @KnownOptIn;"
NSQ_SOURCE_LINE 00000725 "  }"
NSQ_SOURCE_LINE 00000726 "  else {"
NSQ_SOURCE_LINE 00000727 "    @known_opt{@KnownOptOut} = @KnownOptOut;"
NSQ_SOURCE_LINE 00000728 "  }"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "  # Store supplied options in hashref and weed out invalid ones"
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "  if(@_ % 2) {"
NSQ_SOURCE_LINE 00000734 "    croak \"Options must be name=>value pairs (odd number supplied)\";"
NSQ_SOURCE_LINE 00000735 "  }"
NSQ_SOURCE_LINE 00000736 "  my %raw_opt  = @_;"
NSQ_SOURCE_LINE 00000737 "  my $opt      = {};"
NSQ_SOURCE_LINE 00000738 "  $self->{opt} = $opt;"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "  while(my($key, $val) = each %raw_opt) {"
NSQ_SOURCE_LINE 00000741 "    my $lkey = lc($key);"
NSQ_SOURCE_LINE 00000742 "    $lkey =~ s/_//g;"
NSQ_SOURCE_LINE 00000743 "    croak \"Unrecognised option: $key\" unless($known_opt{$lkey});"
NSQ_SOURCE_LINE 00000744 "    $opt->{$lkey} = $val;"
NSQ_SOURCE_LINE 00000745 "  }"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "  # Merge in options passed to constructor"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "  foreach (keys(%known_opt)) {"
NSQ_SOURCE_LINE 00000751 "    unless(exists($opt->{$_})) {"
NSQ_SOURCE_LINE 00000752 "      if(exists($self->{def_opt}->{$_})) {"
NSQ_SOURCE_LINE 00000753 "        $opt->{$_} = $self->{def_opt}->{$_};"
NSQ_SOURCE_LINE 00000754 "      }"
NSQ_SOURCE_LINE 00000755 "    }"
NSQ_SOURCE_LINE 00000756 "  }"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "  # Set sensible defaults if not supplied"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "  if(exists($opt->{rootname})) {"
NSQ_SOURCE_LINE 00000762 "    unless(defined($opt->{rootname})) {"
NSQ_SOURCE_LINE 00000763 "      $opt->{rootname} = '';"
NSQ_SOURCE_LINE 00000764 "    }"
NSQ_SOURCE_LINE 00000765 "  }"
NSQ_SOURCE_LINE 00000766 "  else {"
NSQ_SOURCE_LINE 00000767 "    $opt->{rootname} = $DefRootName;"
NSQ_SOURCE_LINE 00000768 "  }"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "  if($opt->{xmldecl}  and  $opt->{xmldecl} eq '1') {"
NSQ_SOURCE_LINE 00000771 "    $opt->{xmldecl} = $DefXmlDecl;"
NSQ_SOURCE_LINE 00000772 "  }"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "  if(exists($opt->{contentkey})) {"
NSQ_SOURCE_LINE 00000775 "    if($opt->{contentkey} =~ m{^-(.*)$}) {"
NSQ_SOURCE_LINE 00000776 "      $opt->{contentkey} = $1;"
NSQ_SOURCE_LINE 00000777 "      $opt->{collapseagain} = 1;"
NSQ_SOURCE_LINE 00000778 "    }"
NSQ_SOURCE_LINE 00000779 "  }"
NSQ_SOURCE_LINE 00000780 "  else {"
NSQ_SOURCE_LINE 00000781 "    $opt->{contentkey} = $DefContentKey;"
NSQ_SOURCE_LINE 00000782 "  }"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "  unless(exists($opt->{normalisespace})) {"
NSQ_SOURCE_LINE 00000785 "    $opt->{normalisespace} = $opt->{normalizespace};"
NSQ_SOURCE_LINE 00000786 "  }"
NSQ_SOURCE_LINE 00000787 "  $opt->{normalisespace} = 0 unless(defined($opt->{normalisespace}));"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "  # Cleanups for values assumed to be arrays later"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "  if($opt->{searchpath}) {"
NSQ_SOURCE_LINE 00000792 "    unless(ref($opt->{searchpath})) {"
NSQ_SOURCE_LINE 00000793 "      $opt->{searchpath} = [ $opt->{searchpath} ];"
NSQ_SOURCE_LINE 00000794 "    }"
NSQ_SOURCE_LINE 00000795 "  }"
NSQ_SOURCE_LINE 00000796 "  else  {"
NSQ_SOURCE_LINE 00000797 "    $opt->{searchpath} = [ ];"
NSQ_SOURCE_LINE 00000798 "  }"
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "  if($opt->{cache}  and !ref($opt->{cache})) {"
NSQ_SOURCE_LINE 00000801 "    $opt->{cache} = [ $opt->{cache} ];"
NSQ_SOURCE_LINE 00000802 "  }"
NSQ_SOURCE_LINE 00000803 "  if($opt->{cache}) {"
NSQ_SOURCE_LINE 00000804 "    $_ = lc($_) foreach (@{$opt->{cache}});"
NSQ_SOURCE_LINE 00000805 "    foreach my $scheme (@{$opt->{cache}}) {"
NSQ_SOURCE_LINE 00000806 "      my $method = 'cache_read_' . $scheme;"
NSQ_SOURCE_LINE 00000807 "      croak \"Unsupported caching scheme: $scheme\""
NSQ_SOURCE_LINE 00000808 "        unless($self->can($method));"
NSQ_SOURCE_LINE 00000809 "    }"
NSQ_SOURCE_LINE 00000810 "  }"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "  if(exists($opt->{parseropts})) {"
NSQ_SOURCE_LINE 00000813 "    if(warnings::enabled()) {"
NSQ_SOURCE_LINE 00000814 "      carp \"Warning: \" ."
NSQ_SOURCE_LINE 00000815 "           \"'ParserOpts' is deprecated, contact the author if you need it\";"
NSQ_SOURCE_LINE 00000816 "    }"
NSQ_SOURCE_LINE 00000817 "  }"
NSQ_SOURCE_LINE 00000818 "  else {"
NSQ_SOURCE_LINE 00000819 "    $opt->{parseropts} = [ ];"
NSQ_SOURCE_LINE 00000820 "  }"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "  # Special cleanup for {forcearray} which could be regex, arrayref or boolean"
NSQ_SOURCE_LINE 00000824 "  # or left to default to 0"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "  if(exists($opt->{forcearray})) {"
NSQ_SOURCE_LINE 00000827 "    if(ref($opt->{forcearray}) eq 'Regexp') {"
NSQ_SOURCE_LINE 00000828 "      $opt->{forcearray} = [ $opt->{forcearray} ];"
NSQ_SOURCE_LINE 00000829 "    }"
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "    if(ref($opt->{forcearray}) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000832 "      my @force_list = @{$opt->{forcearray}};"
NSQ_SOURCE_LINE 00000833 "      if(@force_list) {"
NSQ_SOURCE_LINE 00000834 "        $opt->{forcearray} = {};"
NSQ_SOURCE_LINE 00000835 "        foreach my $tag (@force_list) {"
NSQ_SOURCE_LINE 00000836 "          if(ref($tag) eq 'Regexp') {"
NSQ_SOURCE_LINE 00000837 "            push @{$opt->{forcearray}->{_regex}}, $tag;"
NSQ_SOURCE_LINE 00000838 "          }"
NSQ_SOURCE_LINE 00000839 "          else {"
NSQ_SOURCE_LINE 00000840 "            $opt->{forcearray}->{$tag} = 1;"
NSQ_SOURCE_LINE 00000841 "          }"
NSQ_SOURCE_LINE 00000842 "        }"
NSQ_SOURCE_LINE 00000843 "      }"
NSQ_SOURCE_LINE 00000844 "      else {"
NSQ_SOURCE_LINE 00000845 "        $opt->{forcearray} = 0;"
NSQ_SOURCE_LINE 00000846 "      }"
NSQ_SOURCE_LINE 00000847 "    }"
NSQ_SOURCE_LINE 00000848 "    else {"
NSQ_SOURCE_LINE 00000849 "      $opt->{forcearray} = ( $opt->{forcearray} ? 1 : 0 );"
NSQ_SOURCE_LINE 00000850 "    }"
NSQ_SOURCE_LINE 00000851 "  }"
NSQ_SOURCE_LINE 00000852 "  else {"
NSQ_SOURCE_LINE 00000853 "    if($opt->{strictmode}  and  $dirn eq 'in') {"
NSQ_SOURCE_LINE 00000854 "      croak \"No value specified for 'ForceArray' option in call to XML$dirn()\";"
NSQ_SOURCE_LINE 00000855 "    }"
NSQ_SOURCE_LINE 00000856 "    $opt->{forcearray} = 0;"
NSQ_SOURCE_LINE 00000857 "  }"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 "  # Special cleanup for {keyattr} which could be arrayref or hashref or left"
NSQ_SOURCE_LINE 00000861 "  # to default to arrayref"
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "  if(exists($opt->{keyattr}))  {"
NSQ_SOURCE_LINE 00000864 "    if(ref($opt->{keyattr})) {"
NSQ_SOURCE_LINE 00000865 "      if(ref($opt->{keyattr}) eq 'HASH') {"
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 "        # Make a copy so we can mess with it"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "        $opt->{keyattr} = { %{$opt->{keyattr}} };"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "        # Convert keyattr => { elem => '+attr' }"
NSQ_SOURCE_LINE 00000873 "        # to keyattr => { elem => [ 'attr', '+' ] }"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "        foreach my $el (keys(%{$opt->{keyattr}})) {"
NSQ_SOURCE_LINE 00000876 "          if($opt->{keyattr}->{$el} =~ /^(\\+|-)?(.*)$/) {"
NSQ_SOURCE_LINE 00000877 "            $opt->{keyattr}->{$el} = [ $2, ($1 ? $1 : '') ];"
NSQ_SOURCE_LINE 00000878 "            if($opt->{strictmode}  and  $dirn eq 'in') {"
NSQ_SOURCE_LINE 00000879 "              next if($opt->{forcearray} == 1);"
NSQ_SOURCE_LINE 00000880 "              next if(ref($opt->{forcearray}) eq 'HASH'"
NSQ_SOURCE_LINE 00000881 "                      and $opt->{forcearray}->{$el});"
NSQ_SOURCE_LINE 00000882 "              croak \"<$el> set in KeyAttr but not in ForceArray\";"
NSQ_SOURCE_LINE 00000883 "            }"
NSQ_SOURCE_LINE 00000884 "          }"
NSQ_SOURCE_LINE 00000885 "          else {"
NSQ_SOURCE_LINE 00000886 "            delete($opt->{keyattr}->{$el}); # Never reached (famous last words?)"
NSQ_SOURCE_LINE 00000887 "          }"
NSQ_SOURCE_LINE 00000888 "        }"
NSQ_SOURCE_LINE 00000889 "      }"
NSQ_SOURCE_LINE 00000890 "      else {"
NSQ_SOURCE_LINE 00000891 "        if(@{$opt->{keyattr}} == 0) {"
NSQ_SOURCE_LINE 00000892 "          delete($opt->{keyattr});"
NSQ_SOURCE_LINE 00000893 "        }"
NSQ_SOURCE_LINE 00000894 "      }"
NSQ_SOURCE_LINE 00000895 "    }"
NSQ_SOURCE_LINE 00000896 "    else {"
NSQ_SOURCE_LINE 00000897 "      $opt->{keyattr} = [ $opt->{keyattr} ];"
NSQ_SOURCE_LINE 00000898 "    }"
NSQ_SOURCE_LINE 00000899 "  }"
NSQ_SOURCE_LINE 00000900 "  else  {"
NSQ_SOURCE_LINE 00000901 "    if($opt->{strictmode}) {"
NSQ_SOURCE_LINE 00000902 "      croak \"No value specified for 'KeyAttr' option in call to XML$dirn()\";"
NSQ_SOURCE_LINE 00000903 "    }"
NSQ_SOURCE_LINE 00000904 "    $opt->{keyattr} = [ @DefKeyAttr ];"
NSQ_SOURCE_LINE 00000905 "  }"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "  # Special cleanup for {valueattr} which could be arrayref or hashref"
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "  if(exists($opt->{valueattr})) {"
NSQ_SOURCE_LINE 00000911 "    if(ref($opt->{valueattr}) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000912 "      $opt->{valueattrlist} = {};"
NSQ_SOURCE_LINE 00000913 "      $opt->{valueattrlist}->{$_} = 1 foreach(@{ delete $opt->{valueattr} });"
NSQ_SOURCE_LINE 00000914 "    }"
NSQ_SOURCE_LINE 00000915 "  }"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "  # make sure there's nothing weird in {grouptags}"
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "  if($opt->{grouptags}) {"
NSQ_SOURCE_LINE 00000920 "    croak \"Illegal value for 'GroupTags' option - expected a hashref\""
NSQ_SOURCE_LINE 00000921 "      unless UNIVERSAL::isa($opt->{grouptags}, 'HASH');"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "    while(my($key, $val) = each %{$opt->{grouptags}}) {"
NSQ_SOURCE_LINE 00000924 "      next if $key ne $val;"
NSQ_SOURCE_LINE 00000925 "      croak \"Bad value in GroupTags: '$key' => '$val'\";"
NSQ_SOURCE_LINE 00000926 "    }"
NSQ_SOURCE_LINE 00000927 "  }"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "  # Check the {variables} option is valid and initialise variables hash"
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "  if($opt->{variables} and !UNIVERSAL::isa($opt->{variables}, 'HASH')) {"
NSQ_SOURCE_LINE 00000933 "    croak \"Illegal value for 'Variables' option - expected a hashref\";"
NSQ_SOURCE_LINE 00000934 "  }"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "  if($opt->{variables}) {"
NSQ_SOURCE_LINE 00000937 "    $self->{_var_values} = { %{$opt->{variables}} };"
NSQ_SOURCE_LINE 00000938 "  }"
NSQ_SOURCE_LINE 00000939 "  elsif($opt->{varattr}) {"
NSQ_SOURCE_LINE 00000940 "    $self->{_var_values} = {};"
NSQ_SOURCE_LINE 00000941 "  }"
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "}"
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "##############################################################################"
NSQ_SOURCE_LINE 00000947 "# Method: find_xml_file()"
NSQ_SOURCE_LINE 00000948 "#"
NSQ_SOURCE_LINE 00000949 "# Helper routine for XMLin()."
NSQ_SOURCE_LINE 00000950 "# Takes a filename, and a list of directories, attempts to locate the file in"
NSQ_SOURCE_LINE 00000951 "# the directories listed."
NSQ_SOURCE_LINE 00000952 "# Returns a full pathname on success; croaks on failure."
NSQ_SOURCE_LINE 00000953 "#"
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 "sub find_xml_file  {"
NSQ_SOURCE_LINE 00000956 "  my $self = shift;"
NSQ_SOURCE_LINE 00000957 "  my $file = shift;"
NSQ_SOURCE_LINE 00000958 "  my @search_path = @_;"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "  require File::Basename;"
NSQ_SOURCE_LINE 00000962 "  require File::Spec;"
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "  my($filename, $filedir) = File::Basename::fileparse($file);"
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "  if($filename ne $file) {        # Ignore searchpath if dir component"
NSQ_SOURCE_LINE 00000967 "    return($file) if(-e $file);"
NSQ_SOURCE_LINE 00000968 "  }"
NSQ_SOURCE_LINE 00000969 "  else {"
NSQ_SOURCE_LINE 00000970 "    my($path);"
NSQ_SOURCE_LINE 00000971 "    foreach $path (@search_path)  {"
NSQ_SOURCE_LINE 00000972 "      my $fullpath = File::Spec->catfile($path, $file);"
NSQ_SOURCE_LINE 00000973 "      return($fullpath) if(-e $fullpath);"
NSQ_SOURCE_LINE 00000974 "    }"
NSQ_SOURCE_LINE 00000975 "  }"
NSQ_SOURCE_LINE 00000976 ""
NSQ_SOURCE_LINE 00000977 "  # If user did not supply a search path, default to current directory"
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "  if(!@search_path) {"
NSQ_SOURCE_LINE 00000980 "    return($file) if(-e $file);"
NSQ_SOURCE_LINE 00000981 "    croak \"File does not exist: $file\";"
NSQ_SOURCE_LINE 00000982 "  }"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "  croak \"Could not find $file in \", join(':', @search_path);"
NSQ_SOURCE_LINE 00000985 "}"
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 "##############################################################################"
NSQ_SOURCE_LINE 00000989 "# Method: collapse()"
NSQ_SOURCE_LINE 00000990 "#"
NSQ_SOURCE_LINE 00000991 "# Helper routine for XMLin().  This routine really comprises the 'smarts' (or"
NSQ_SOURCE_LINE 00000992 "# value add) of this module."
NSQ_SOURCE_LINE 00000993 "#"
NSQ_SOURCE_LINE 00000994 "# Takes the parse tree that XML::Parser produced from the supplied XML and"
NSQ_SOURCE_LINE 00000995 "# recurses through it 'collapsing' unnecessary levels of indirection (nested"
NSQ_SOURCE_LINE 00000996 "# arrays etc) to produce a data structure that is easier to work with."
NSQ_SOURCE_LINE 00000997 "#"
NSQ_SOURCE_LINE 00000998 "# Elements in the original parser tree are represented as an element name"
NSQ_SOURCE_LINE 00000999 "# followed by an arrayref.  The first element of the array is a hashref"
NSQ_SOURCE_LINE 00001000 "# containing the attributes.  The rest of the array contains a list of any"
NSQ_SOURCE_LINE 00001001 "# nested elements as name+arrayref pairs:"
NSQ_SOURCE_LINE 00001002 "#"
NSQ_SOURCE_LINE 00001003 "#  <element name>, [ { <attribute hashref> }, <element name>, [ ... ], ... ]"
NSQ_SOURCE_LINE 00001004 "#"
NSQ_SOURCE_LINE 00001005 "# The special element name '0' (zero) flags text content."
NSQ_SOURCE_LINE 00001006 "#"
NSQ_SOURCE_LINE 00001007 "# This routine cuts down the noise by discarding any text content consisting of"
NSQ_SOURCE_LINE 00001008 "# only whitespace and then moves the nested elements into the attribute hash"
NSQ_SOURCE_LINE 00001009 "# using the name of the nested element as the hash key and the collapsed"
NSQ_SOURCE_LINE 00001010 "# version of the nested element as the value.  Multiple nested elements with"
NSQ_SOURCE_LINE 00001011 "# the same name will initially be represented as an arrayref, but this may be"
NSQ_SOURCE_LINE 00001012 "# 'folded' into a hashref depending on the value of the keyattr option."
NSQ_SOURCE_LINE 00001013 "#"
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "sub collapse {"
NSQ_SOURCE_LINE 00001016 "  my $self = shift;"
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 ""
NSQ_SOURCE_LINE 00001019 "  # Start with the hash of attributes"
NSQ_SOURCE_LINE 00001020 ""
NSQ_SOURCE_LINE 00001021 "  my $attr  = shift;"
NSQ_SOURCE_LINE 00001022 "  if($self->{opt}->{noattr}) {                    # Discard if 'noattr' set"
NSQ_SOURCE_LINE 00001023 "    $attr = $self->new_hashref;"
NSQ_SOURCE_LINE 00001024 "  }"
NSQ_SOURCE_LINE 00001025 "  elsif($self->{opt}->{normalisespace} == 2) {"
NSQ_SOURCE_LINE 00001026 "    while(my($key, $value) = each %$attr) {"
NSQ_SOURCE_LINE 00001027 "      $attr->{$key} = $self->normalise_space($value)"
NSQ_SOURCE_LINE 00001028 "    }"
NSQ_SOURCE_LINE 00001029 "  }"
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "  # Do variable substitutions"
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "  if(my $var = $self->{_var_values}) {"
NSQ_SOURCE_LINE 00001035 "    while(my($key, $val) = each(%$attr)) {"
NSQ_SOURCE_LINE 00001036 "      $val =~ s^\\$\\{([\\w.]+)\\}^ $self->get_var($1) ^ge;"
NSQ_SOURCE_LINE 00001037 "      $attr->{$key} = $val;"
NSQ_SOURCE_LINE 00001038 "    }"
NSQ_SOURCE_LINE 00001039 "  }"
NSQ_SOURCE_LINE 00001040 ""
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "  # Roll up 'value' attributes (but only if no nested elements)"
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 "  if(!@_  and  keys %$attr == 1) {"
NSQ_SOURCE_LINE 00001045 "    my($k) = keys %$attr;"
NSQ_SOURCE_LINE 00001046 "    if($self->{opt}->{valueattrlist}  and $self->{opt}->{valueattrlist}->{$k}) {"
NSQ_SOURCE_LINE 00001047 "      return $attr->{$k};"
NSQ_SOURCE_LINE 00001048 "    }"
NSQ_SOURCE_LINE 00001049 "  }"
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "  # Add any nested elements"
NSQ_SOURCE_LINE 00001053 ""
NSQ_SOURCE_LINE 00001054 "  my($key, $val);"
NSQ_SOURCE_LINE 00001055 "  while(@_) {"
NSQ_SOURCE_LINE 00001056 "    $key = shift;"
NSQ_SOURCE_LINE 00001057 "    $val = shift;"
NSQ_SOURCE_LINE 00001058 "    $val = '' if not defined $val;"
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "    if(ref($val)) {"
NSQ_SOURCE_LINE 00001061 "      $val = $self->collapse(@$val);"
NSQ_SOURCE_LINE 00001062 "      next if(!defined($val)  and  $self->{opt}->{suppressempty});"
NSQ_SOURCE_LINE 00001063 "    }"
NSQ_SOURCE_LINE 00001064 "    elsif($key eq '0') {"
NSQ_SOURCE_LINE 00001065 "      next if($val =~ m{^\\s*$}s);  # Skip all whitespace content"
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "      $val = $self->normalise_space($val)"
NSQ_SOURCE_LINE 00001068 "        if($self->{opt}->{normalisespace} == 2);"
NSQ_SOURCE_LINE 00001069 ""
NSQ_SOURCE_LINE 00001070 "      # do variable substitutions"
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "      if(my $var = $self->{_var_values}) {"
NSQ_SOURCE_LINE 00001073 "        $val =~ s^\\$\\{(\\w+)\\}^ $self->get_var($1) ^ge;"
NSQ_SOURCE_LINE 00001074 "      }"
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 ""
NSQ_SOURCE_LINE 00001077 "      # look for variable definitions"
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "      if(my $var = $self->{opt}->{varattr}) {"
NSQ_SOURCE_LINE 00001080 "        if(exists $attr->{$var}) {"
NSQ_SOURCE_LINE 00001081 "          $self->set_var($attr->{$var}, $val);"
NSQ_SOURCE_LINE 00001082 "        }"
NSQ_SOURCE_LINE 00001083 "      }"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 ""
NSQ_SOURCE_LINE 00001086 "      # Collapse text content in element with no attributes to a string"
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "      if(!%$attr  and  !@_) {"
NSQ_SOURCE_LINE 00001089 "        return($self->{opt}->{forcecontent} ?"
NSQ_SOURCE_LINE 00001090 "          { $self->{opt}->{contentkey} => $val } : $val"
NSQ_SOURCE_LINE 00001091 "        );"
NSQ_SOURCE_LINE 00001092 "      }"
NSQ_SOURCE_LINE 00001093 "      $key = $self->{opt}->{contentkey};"
NSQ_SOURCE_LINE 00001094 "    }"
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 ""
NSQ_SOURCE_LINE 00001097 "    # Combine duplicate attributes into arrayref if required"
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "    if(exists($attr->{$key})) {"
NSQ_SOURCE_LINE 00001100 "      if(UNIVERSAL::isa($attr->{$key}, 'ARRAY')) {"
NSQ_SOURCE_LINE 00001101 "        push(@{$attr->{$key}}, $val);"
NSQ_SOURCE_LINE 00001102 "      }"
NSQ_SOURCE_LINE 00001103 "      else {"
NSQ_SOURCE_LINE 00001104 "        $attr->{$key} = [ $attr->{$key}, $val ];"
NSQ_SOURCE_LINE 00001105 "      }"
NSQ_SOURCE_LINE 00001106 "    }"
NSQ_SOURCE_LINE 00001107 "    elsif(defined($val)  and  UNIVERSAL::isa($val, 'ARRAY')) {"
NSQ_SOURCE_LINE 00001108 "      $attr->{$key} = [ $val ];"
NSQ_SOURCE_LINE 00001109 "    }"
NSQ_SOURCE_LINE 00001110 "    else {"
NSQ_SOURCE_LINE 00001111 "      if( $key ne $self->{opt}->{contentkey}"
NSQ_SOURCE_LINE 00001112 "          and ("
NSQ_SOURCE_LINE 00001113 "            ($self->{opt}->{forcearray} == 1)"
NSQ_SOURCE_LINE 00001114 "            or ("
NSQ_SOURCE_LINE 00001115 "              (ref($self->{opt}->{forcearray}) eq 'HASH')"
NSQ_SOURCE_LINE 00001116 "              and ("
NSQ_SOURCE_LINE 00001117 "                $self->{opt}->{forcearray}->{$key}"
NSQ_SOURCE_LINE 00001118 "                or (grep $key =~ $_, @{$self->{opt}->{forcearray}->{_regex}})"
NSQ_SOURCE_LINE 00001119 "              )"
NSQ_SOURCE_LINE 00001120 "            )"
NSQ_SOURCE_LINE 00001121 "          )"
NSQ_SOURCE_LINE 00001122 "        ) {"
NSQ_SOURCE_LINE 00001123 "        $attr->{$key} = [ $val ];"
NSQ_SOURCE_LINE 00001124 "      }"
NSQ_SOURCE_LINE 00001125 "      else {"
NSQ_SOURCE_LINE 00001126 "        $attr->{$key} = $val;"
NSQ_SOURCE_LINE 00001127 "      }"
NSQ_SOURCE_LINE 00001128 "    }"
NSQ_SOURCE_LINE 00001129 ""
NSQ_SOURCE_LINE 00001130 "  }"
NSQ_SOURCE_LINE 00001131 ""
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "  # Turn arrayrefs into hashrefs if key fields present"
NSQ_SOURCE_LINE 00001134 ""
NSQ_SOURCE_LINE 00001135 "  if($self->{opt}->{keyattr}) {"
NSQ_SOURCE_LINE 00001136 "    while(($key,$val) = each %$attr) {"
NSQ_SOURCE_LINE 00001137 "      if(defined($val)  and  UNIVERSAL::isa($val, 'ARRAY')) {"
NSQ_SOURCE_LINE 00001138 "        $attr->{$key} = $self->array_to_hash($key, $val);"
NSQ_SOURCE_LINE 00001139 "      }"
NSQ_SOURCE_LINE 00001140 "    }"
NSQ_SOURCE_LINE 00001141 "  }"
NSQ_SOURCE_LINE 00001142 ""
NSQ_SOURCE_LINE 00001143 ""
NSQ_SOURCE_LINE 00001144 "  # disintermediate grouped tags"
NSQ_SOURCE_LINE 00001145 ""
NSQ_SOURCE_LINE 00001146 "  if($self->{opt}->{grouptags}) {"
NSQ_SOURCE_LINE 00001147 "    while(my($key, $val) = each(%$attr)) {"
NSQ_SOURCE_LINE 00001148 "      next unless(UNIVERSAL::isa($val, 'HASH') and (keys %$val == 1));"
NSQ_SOURCE_LINE 00001149 "      next unless(exists($self->{opt}->{grouptags}->{$key}));"
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "      my($child_key, $child_val) =  %$val;"
NSQ_SOURCE_LINE 00001152 ""
NSQ_SOURCE_LINE 00001153 "      if($self->{opt}->{grouptags}->{$key} eq $child_key) {"
NSQ_SOURCE_LINE 00001154 "        $attr->{$key}= $child_val;"
NSQ_SOURCE_LINE 00001155 "      }"
NSQ_SOURCE_LINE 00001156 "    }"
NSQ_SOURCE_LINE 00001157 "  }"
NSQ_SOURCE_LINE 00001158 ""
NSQ_SOURCE_LINE 00001159 ""
NSQ_SOURCE_LINE 00001160 "  # Fold hashes containing a single anonymous array up into just the array"
NSQ_SOURCE_LINE 00001161 ""
NSQ_SOURCE_LINE 00001162 "  my $count = scalar keys %$attr;"
NSQ_SOURCE_LINE 00001163 "  if($count == 1"
NSQ_SOURCE_LINE 00001164 "     and  exists $attr->{anon}"
NSQ_SOURCE_LINE 00001165 "     and  UNIVERSAL::isa($attr->{anon}, 'ARRAY')"
NSQ_SOURCE_LINE 00001166 "  ) {"
NSQ_SOURCE_LINE 00001167 "    return($attr->{anon});"
NSQ_SOURCE_LINE 00001168 "  }"
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 "  # Do the right thing if hash is empty, otherwise just return it"
NSQ_SOURCE_LINE 00001172 ""
NSQ_SOURCE_LINE 00001173 "  if(!%$attr  and  exists($self->{opt}->{suppressempty})) {"
NSQ_SOURCE_LINE 00001174 "    if(defined($self->{opt}->{suppressempty})  and"
NSQ_SOURCE_LINE 00001175 "       $self->{opt}->{suppressempty} eq '') {"
NSQ_SOURCE_LINE 00001176 "      return('');"
NSQ_SOURCE_LINE 00001177 "    }"
NSQ_SOURCE_LINE 00001178 "    return(undef);"
NSQ_SOURCE_LINE 00001179 "  }"
NSQ_SOURCE_LINE 00001180 ""
NSQ_SOURCE_LINE 00001181 ""
NSQ_SOURCE_LINE 00001182 "  # Roll up named elements with named nested 'value' attributes"
NSQ_SOURCE_LINE 00001183 ""
NSQ_SOURCE_LINE 00001184 "  if($self->{opt}->{valueattr}) {"
NSQ_SOURCE_LINE 00001185 "    while(my($key, $val) = each(%$attr)) {"
NSQ_SOURCE_LINE 00001186 "      next unless($self->{opt}->{valueattr}->{$key});"
NSQ_SOURCE_LINE 00001187 "      next unless(UNIVERSAL::isa($val, 'HASH') and (keys %$val == 1));"
NSQ_SOURCE_LINE 00001188 "      my($k) = keys %$val;"
NSQ_SOURCE_LINE 00001189 "      next unless($k eq $self->{opt}->{valueattr}->{$key});"
NSQ_SOURCE_LINE 00001190 "      $attr->{$key} = $val->{$k};"
NSQ_SOURCE_LINE 00001191 "    }"
NSQ_SOURCE_LINE 00001192 "  }"
NSQ_SOURCE_LINE 00001193 ""
NSQ_SOURCE_LINE 00001194 "  return($attr)"
NSQ_SOURCE_LINE 00001195 ""
NSQ_SOURCE_LINE 00001196 "}"
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 ""
NSQ_SOURCE_LINE 00001199 "##############################################################################"
NSQ_SOURCE_LINE 00001200 "# Method: set_var()"
NSQ_SOURCE_LINE 00001201 "#"
NSQ_SOURCE_LINE 00001202 "# Called when a variable definition is encountered in the XML.  (A variable"
NSQ_SOURCE_LINE 00001203 "# definition looks like <element attrname=\"name\">value</element> where attrname"
NSQ_SOURCE_LINE 00001204 "# matches the varattr setting)."
NSQ_SOURCE_LINE 00001205 "#"
NSQ_SOURCE_LINE 00001206 ""
NSQ_SOURCE_LINE 00001207 "sub set_var {"
NSQ_SOURCE_LINE 00001208 "  my($self, $name, $value) = @_;"
NSQ_SOURCE_LINE 00001209 ""
NSQ_SOURCE_LINE 00001210 "  $self->{_var_values}->{$name} = $value;"
NSQ_SOURCE_LINE 00001211 "}"
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 ""
NSQ_SOURCE_LINE 00001214 "##############################################################################"
NSQ_SOURCE_LINE 00001215 "# Method: get_var()"
NSQ_SOURCE_LINE 00001216 "#"
NSQ_SOURCE_LINE 00001217 "# Called during variable substitution to get the value for the named variable."
NSQ_SOURCE_LINE 00001218 "#"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "sub get_var {"
NSQ_SOURCE_LINE 00001221 "  my($self, $name) = @_;"
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 "  my $value = $self->{_var_values}->{$name};"
NSQ_SOURCE_LINE 00001224 "  return $value if(defined($value));"
NSQ_SOURCE_LINE 00001225 ""
NSQ_SOURCE_LINE 00001226 "  return '${' . $name . '}';"
NSQ_SOURCE_LINE 00001227 "}"
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 ""
NSQ_SOURCE_LINE 00001230 "##############################################################################"
NSQ_SOURCE_LINE 00001231 "# Method: normalise_space()"
NSQ_SOURCE_LINE 00001232 "#"
NSQ_SOURCE_LINE 00001233 "# Strips leading and trailing whitespace and collapses sequences of whitespace"
NSQ_SOURCE_LINE 00001234 "# characters to a single space."
NSQ_SOURCE_LINE 00001235 "#"
NSQ_SOURCE_LINE 00001236 ""
NSQ_SOURCE_LINE 00001237 "sub normalise_space {"
NSQ_SOURCE_LINE 00001238 "  my($self, $text) = @_;"
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "  $text =~ s/^\\s+//s;"
NSQ_SOURCE_LINE 00001241 "  $text =~ s/\\s+$//s;"
NSQ_SOURCE_LINE 00001242 "  $text =~ s/\\s\\s+/ /sg;"
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "  return $text;"
NSQ_SOURCE_LINE 00001245 "}"
NSQ_SOURCE_LINE 00001246 ""
NSQ_SOURCE_LINE 00001247 ""
NSQ_SOURCE_LINE 00001248 "##############################################################################"
NSQ_SOURCE_LINE 00001249 "# Method: array_to_hash()"
NSQ_SOURCE_LINE 00001250 "#"
NSQ_SOURCE_LINE 00001251 "# Helper routine for collapse()."
NSQ_SOURCE_LINE 00001252 "# Attempts to 'fold' an array of hashes into an hash of hashes.  Returns a"
NSQ_SOURCE_LINE 00001253 "# reference to the hash on success or the original array if folding is"
NSQ_SOURCE_LINE 00001254 "# not possible.  Behaviour is controlled by 'keyattr' option."
NSQ_SOURCE_LINE 00001255 "#"
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "sub array_to_hash {"
NSQ_SOURCE_LINE 00001258 "  my $self     = shift;"
NSQ_SOURCE_LINE 00001259 "  my $name     = shift;"
NSQ_SOURCE_LINE 00001260 "  my $arrayref = shift;"
NSQ_SOURCE_LINE 00001261 ""
NSQ_SOURCE_LINE 00001262 "  my $hashref  = $self->new_hashref;"
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "  my($i, $key, $val, $flag);"
NSQ_SOURCE_LINE 00001265 ""
NSQ_SOURCE_LINE 00001266 ""
NSQ_SOURCE_LINE 00001267 "  # Handle keyattr => { .... }"
NSQ_SOURCE_LINE 00001268 ""
NSQ_SOURCE_LINE 00001269 "  if(ref($self->{opt}->{keyattr}) eq 'HASH') {"
NSQ_SOURCE_LINE 00001270 "    return($arrayref) unless(exists($self->{opt}->{keyattr}->{$name}));"
NSQ_SOURCE_LINE 00001271 "    ($key, $flag) = @{$self->{opt}->{keyattr}->{$name}};"
NSQ_SOURCE_LINE 00001272 "    for($i = 0; $i < @$arrayref; $i++)  {"
NSQ_SOURCE_LINE 00001273 "      if(UNIVERSAL::isa($arrayref->[$i], 'HASH') and"
NSQ_SOURCE_LINE 00001274 "         exists($arrayref->[$i]->{$key})"
NSQ_SOURCE_LINE 00001275 "      ) {"
NSQ_SOURCE_LINE 00001276 "        $val = $arrayref->[$i]->{$key};"
NSQ_SOURCE_LINE 00001277 "        if(ref($val)) {"
NSQ_SOURCE_LINE 00001278 "          $self->die_or_warn(\"<$name> element has non-scalar '$key' key attribute\");"
NSQ_SOURCE_LINE 00001279 "          return($arrayref);"
NSQ_SOURCE_LINE 00001280 "        }"
NSQ_SOURCE_LINE 00001281 "        $val = $self->normalise_space($val)"
NSQ_SOURCE_LINE 00001282 "          if($self->{opt}->{normalisespace} == 1);"
NSQ_SOURCE_LINE 00001283 "        $self->die_or_warn(\"<$name> element has non-unique value in '$key' key attribute: $val\")"
NSQ_SOURCE_LINE 00001284 "          if(exists($hashref->{$val}));"
NSQ_SOURCE_LINE 00001285 "        $hashref->{$val} = $self->new_hashref( %{$arrayref->[$i]} );"
NSQ_SOURCE_LINE 00001286 "        $hashref->{$val}->{\"-$key\"} = $hashref->{$val}->{$key} if($flag eq '-');"
NSQ_SOURCE_LINE 00001287 "        delete $hashref->{$val}->{$key} unless($flag eq '+');"
NSQ_SOURCE_LINE 00001288 "      }"
NSQ_SOURCE_LINE 00001289 "      else {"
NSQ_SOURCE_LINE 00001290 "        $self->die_or_warn(\"<$name> element has no '$key' key attribute\");"
NSQ_SOURCE_LINE 00001291 "        return($arrayref);"
NSQ_SOURCE_LINE 00001292 "      }"
NSQ_SOURCE_LINE 00001293 "    }"
NSQ_SOURCE_LINE 00001294 "  }"
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 ""
NSQ_SOURCE_LINE 00001297 "  # Or assume keyattr => [ .... ]"
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "  else {"
NSQ_SOURCE_LINE 00001300 "    my $default_keys ="
NSQ_SOURCE_LINE 00001301 "      join(',', @DefKeyAttr) eq join(',', @{$self->{opt}->{keyattr}});"
NSQ_SOURCE_LINE 00001302 ""
NSQ_SOURCE_LINE 00001303 "    ELEMENT: for($i = 0; $i < @$arrayref; $i++)  {"
NSQ_SOURCE_LINE 00001304 "      return($arrayref) unless(UNIVERSAL::isa($arrayref->[$i], 'HASH'));"
NSQ_SOURCE_LINE 00001305 ""
NSQ_SOURCE_LINE 00001306 "      foreach $key (@{$self->{opt}->{keyattr}}) {"
NSQ_SOURCE_LINE 00001307 "        if(defined($arrayref->[$i]->{$key}))  {"
NSQ_SOURCE_LINE 00001308 "          $val = $arrayref->[$i]->{$key};"
NSQ_SOURCE_LINE 00001309 "          if(ref($val)) {"
NSQ_SOURCE_LINE 00001310 "            $self->die_or_warn(\"<$name> element has non-scalar '$key' key attribute\")"
NSQ_SOURCE_LINE 00001311 "              if not $default_keys;"
NSQ_SOURCE_LINE 00001312 "            return($arrayref);"
NSQ_SOURCE_LINE 00001313 "          }"
NSQ_SOURCE_LINE 00001314 "          $val = $self->normalise_space($val)"
NSQ_SOURCE_LINE 00001315 "            if($self->{opt}->{normalisespace} == 1);"
NSQ_SOURCE_LINE 00001316 "          $self->die_or_warn(\"<$name> element has non-unique value in '$key' key attribute: $val\")"
NSQ_SOURCE_LINE 00001317 "            if(exists($hashref->{$val}));"
NSQ_SOURCE_LINE 00001318 "          $hashref->{$val} = $self->new_hashref( %{$arrayref->[$i]} );"
NSQ_SOURCE_LINE 00001319 "          delete $hashref->{$val}->{$key};"
NSQ_SOURCE_LINE 00001320 "          next ELEMENT;"
NSQ_SOURCE_LINE 00001321 "        }"
NSQ_SOURCE_LINE 00001322 "      }"
NSQ_SOURCE_LINE 00001323 ""
NSQ_SOURCE_LINE 00001324 "      return($arrayref);    # No keyfield matched"
NSQ_SOURCE_LINE 00001325 "    }"
NSQ_SOURCE_LINE 00001326 "  }"
NSQ_SOURCE_LINE 00001327 ""
NSQ_SOURCE_LINE 00001328 "  # collapse any hashes which now only have a 'content' key"
NSQ_SOURCE_LINE 00001329 ""
NSQ_SOURCE_LINE 00001330 "  if($self->{opt}->{collapseagain}) {"
NSQ_SOURCE_LINE 00001331 "    $hashref = $self->collapse_content($hashref);"
NSQ_SOURCE_LINE 00001332 "  }"
NSQ_SOURCE_LINE 00001333 ""
NSQ_SOURCE_LINE 00001334 "  return($hashref);"
NSQ_SOURCE_LINE 00001335 "}"
NSQ_SOURCE_LINE 00001336 ""
NSQ_SOURCE_LINE 00001337 ""
NSQ_SOURCE_LINE 00001338 "##############################################################################"
NSQ_SOURCE_LINE 00001339 "# Method: die_or_warn()"
NSQ_SOURCE_LINE 00001340 "#"
NSQ_SOURCE_LINE 00001341 "# Takes a diagnostic message and does one of three things:"
NSQ_SOURCE_LINE 00001342 "# 1. dies if strict mode is enabled"
NSQ_SOURCE_LINE 00001343 "# 2. warns if warnings are enabled but strict mode is not"
NSQ_SOURCE_LINE 00001344 "# 3. ignores message and returns silently if neither strict mode nor warnings"
NSQ_SOURCE_LINE 00001345 "#    are enabled"
NSQ_SOURCE_LINE 00001346 "#"
NSQ_SOURCE_LINE 00001347 ""
NSQ_SOURCE_LINE 00001348 "sub die_or_warn {"
NSQ_SOURCE_LINE 00001349 "  my $self = shift;"
NSQ_SOURCE_LINE 00001350 "  my $msg  = shift;"
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "  croak $msg if($self->{opt}->{strictmode});"
NSQ_SOURCE_LINE 00001353 "  if(warnings::enabled()) {"
NSQ_SOURCE_LINE 00001354 "    carp \"Warning: $msg\";"
NSQ_SOURCE_LINE 00001355 "  }"
NSQ_SOURCE_LINE 00001356 "}"
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 ""
NSQ_SOURCE_LINE 00001359 "##############################################################################"
NSQ_SOURCE_LINE 00001360 "# Method: new_hashref()"
NSQ_SOURCE_LINE 00001361 "#"
NSQ_SOURCE_LINE 00001362 "# This is a hook routine for overriding in a sub-class.  Some people believe"
NSQ_SOURCE_LINE 00001363 "# that using Tie::IxHash here will solve order-loss problems."
NSQ_SOURCE_LINE 00001364 "#"
NSQ_SOURCE_LINE 00001365 ""
NSQ_SOURCE_LINE 00001366 "sub new_hashref {"
NSQ_SOURCE_LINE 00001367 "  my $self = shift;"
NSQ_SOURCE_LINE 00001368 ""
NSQ_SOURCE_LINE 00001369 "  return { @_ };"
NSQ_SOURCE_LINE 00001370 "}"
NSQ_SOURCE_LINE 00001371 ""
NSQ_SOURCE_LINE 00001372 ""
NSQ_SOURCE_LINE 00001373 "##############################################################################"
NSQ_SOURCE_LINE 00001374 "# Method: collapse_content()"
NSQ_SOURCE_LINE 00001375 "#"
NSQ_SOURCE_LINE 00001376 "# Helper routine for array_to_hash"
NSQ_SOURCE_LINE 00001377 "#"
NSQ_SOURCE_LINE 00001378 "# Arguments expected are:"
NSQ_SOURCE_LINE 00001379 "# - an XML::Simple object"
NSQ_SOURCE_LINE 00001380 "# - a hashref"
NSQ_SOURCE_LINE 00001381 "# the hashref is a former array, turned into a hash by array_to_hash because"
NSQ_SOURCE_LINE 00001382 "# of the presence of key attributes"
NSQ_SOURCE_LINE 00001383 "# at this point collapse_content avoids over-complicated structures like"
NSQ_SOURCE_LINE 00001384 "# dir => { libexecdir    => { content => '$exec_prefix/libexec' },"
NSQ_SOURCE_LINE 00001385 "#          localstatedir => { content => '$prefix' },"
NSQ_SOURCE_LINE 00001386 "#        }"
NSQ_SOURCE_LINE 00001387 "# into"
NSQ_SOURCE_LINE 00001388 "# dir => { libexecdir    => '$exec_prefix/libexec',"
NSQ_SOURCE_LINE 00001389 "#          localstatedir => '$prefix',"
NSQ_SOURCE_LINE 00001390 "#        }"
NSQ_SOURCE_LINE 00001391 ""
NSQ_SOURCE_LINE 00001392 "sub collapse_content {"
NSQ_SOURCE_LINE 00001393 "  my $self       = shift;"
NSQ_SOURCE_LINE 00001394 "  my $hashref    = shift;"
NSQ_SOURCE_LINE 00001395 ""
NSQ_SOURCE_LINE 00001396 "  my $contentkey = $self->{opt}->{contentkey};"
NSQ_SOURCE_LINE 00001397 ""
NSQ_SOURCE_LINE 00001398 "  # first go through the values,checking that they are fit to collapse"
NSQ_SOURCE_LINE 00001399 "  foreach my $val (values %$hashref) {"
NSQ_SOURCE_LINE 00001400 "    return $hashref unless (     (ref($val) eq 'HASH')"
NSQ_SOURCE_LINE 00001401 "                             and (keys %$val == 1)"
NSQ_SOURCE_LINE 00001402 "                             and (exists $val->{$contentkey})"
NSQ_SOURCE_LINE 00001403 "                           );"
NSQ_SOURCE_LINE 00001404 "  }"
NSQ_SOURCE_LINE 00001405 ""
NSQ_SOURCE_LINE 00001406 "  # now collapse them"
NSQ_SOURCE_LINE 00001407 "  foreach my $key (keys %$hashref) {"
NSQ_SOURCE_LINE 00001408 "    $hashref->{$key}=  $hashref->{$key}->{$contentkey};"
NSQ_SOURCE_LINE 00001409 "  }"
NSQ_SOURCE_LINE 00001410 ""
NSQ_SOURCE_LINE 00001411 "  return $hashref;"
NSQ_SOURCE_LINE 00001412 "}"
NSQ_SOURCE_LINE 00001413 ""
NSQ_SOURCE_LINE 00001414 ""
NSQ_SOURCE_LINE 00001415 "##############################################################################"
NSQ_SOURCE_LINE 00001416 "# Method: value_to_xml()"
NSQ_SOURCE_LINE 00001417 "#"
NSQ_SOURCE_LINE 00001418 "# Helper routine for XMLout() - recurses through a data structure building up"
NSQ_SOURCE_LINE 00001419 "# and returning an XML representation of that structure as a string."
NSQ_SOURCE_LINE 00001420 "#"
NSQ_SOURCE_LINE 00001421 "# Arguments expected are:"
NSQ_SOURCE_LINE 00001422 "# - the data structure to be encoded (usually a reference)"
NSQ_SOURCE_LINE 00001423 "# - the XML tag name to use for this item"
NSQ_SOURCE_LINE 00001424 "# - a string of spaces for use as the current indent level"
NSQ_SOURCE_LINE 00001425 "#"
NSQ_SOURCE_LINE 00001426 ""
NSQ_SOURCE_LINE 00001427 "sub value_to_xml {"
NSQ_SOURCE_LINE 00001428 "  my $self = shift;;"
NSQ_SOURCE_LINE 00001429 ""
NSQ_SOURCE_LINE 00001430 ""
NSQ_SOURCE_LINE 00001431 "  # Grab the other arguments"
NSQ_SOURCE_LINE 00001432 ""
NSQ_SOURCE_LINE 00001433 "  my($ref, $name, $indent) = @_;"
NSQ_SOURCE_LINE 00001434 ""
NSQ_SOURCE_LINE 00001435 "  my $named = (defined($name) and $name ne '' ? 1 : 0);"
NSQ_SOURCE_LINE 00001436 ""
NSQ_SOURCE_LINE 00001437 "  my $nl = \"\\n\";"
NSQ_SOURCE_LINE 00001438 ""
NSQ_SOURCE_LINE 00001439 "  my $is_root = $indent eq '' ? 1 : 0;   # Warning, dirty hack!"
NSQ_SOURCE_LINE 00001440 "  if($self->{opt}->{noindent}) {"
NSQ_SOURCE_LINE 00001441 "    $indent = '';"
NSQ_SOURCE_LINE 00001442 "    $nl     = '';"
NSQ_SOURCE_LINE 00001443 "  }"
NSQ_SOURCE_LINE 00001444 ""
NSQ_SOURCE_LINE 00001445 ""
NSQ_SOURCE_LINE 00001446 "  # Convert to XML"
NSQ_SOURCE_LINE 00001447 ""
NSQ_SOURCE_LINE 00001448 "  my $refaddr = Scalar::Util::refaddr($ref);"
NSQ_SOURCE_LINE 00001449 "  if($refaddr) {"
NSQ_SOURCE_LINE 00001450 "    croak \"circular data structures not supported\""
NSQ_SOURCE_LINE 00001451 "      if $self->{_ancestors}->{$refaddr};"
NSQ_SOURCE_LINE 00001452 "    $self->{_ancestors}->{$refaddr} = $ref;  # keep ref alive until we delete it"
NSQ_SOURCE_LINE 00001453 "  }"
NSQ_SOURCE_LINE 00001454 "  else {"
NSQ_SOURCE_LINE 00001455 "    if($named) {"
NSQ_SOURCE_LINE 00001456 "      return(join('',"
NSQ_SOURCE_LINE 00001457 "              $indent, '<', $name, '>',"
NSQ_SOURCE_LINE 00001458 "              ($self->{opt}->{noescape} ? $ref : $self->escape_value($ref)),"
NSQ_SOURCE_LINE 00001459 "              '</', $name, \">\", $nl"
NSQ_SOURCE_LINE 00001460 "            ));"
NSQ_SOURCE_LINE 00001461 "    }"
NSQ_SOURCE_LINE 00001462 "    else {"
NSQ_SOURCE_LINE 00001463 "      return(\"$ref$nl\");"
NSQ_SOURCE_LINE 00001464 "    }"
NSQ_SOURCE_LINE 00001465 "  }"
NSQ_SOURCE_LINE 00001466 ""
NSQ_SOURCE_LINE 00001467 ""
NSQ_SOURCE_LINE 00001468 "  # Unfold hash to array if possible"
NSQ_SOURCE_LINE 00001469 ""
NSQ_SOURCE_LINE 00001470 "  if(UNIVERSAL::isa($ref, 'HASH')      # It is a hash"
NSQ_SOURCE_LINE 00001471 "     and keys %$ref                    # and it's not empty"
NSQ_SOURCE_LINE 00001472 "     and $self->{opt}->{keyattr}       # and folding is enabled"
NSQ_SOURCE_LINE 00001473 "     and !$is_root                     # and its not the root element"
NSQ_SOURCE_LINE 00001474 "  ) {"
NSQ_SOURCE_LINE 00001475 "    $ref = $self->hash_to_array($name, $ref);"
NSQ_SOURCE_LINE 00001476 "  }"
NSQ_SOURCE_LINE 00001477 ""
NSQ_SOURCE_LINE 00001478 ""
NSQ_SOURCE_LINE 00001479 "  my @result = ();"
NSQ_SOURCE_LINE 00001480 "  my($key, $value);"
NSQ_SOURCE_LINE 00001481 ""
NSQ_SOURCE_LINE 00001482 ""
NSQ_SOURCE_LINE 00001483 "  # Handle hashrefs"
NSQ_SOURCE_LINE 00001484 ""
NSQ_SOURCE_LINE 00001485 "  if(UNIVERSAL::isa($ref, 'HASH')) {"
NSQ_SOURCE_LINE 00001486 ""
NSQ_SOURCE_LINE 00001487 "    # Reintermediate grouped values if applicable"
NSQ_SOURCE_LINE 00001488 ""
NSQ_SOURCE_LINE 00001489 "    if($self->{opt}->{grouptags}) {"
NSQ_SOURCE_LINE 00001490 "      $ref = $self->copy_hash($ref);"
NSQ_SOURCE_LINE 00001491 "      while(my($key, $val) = each %$ref) {"
NSQ_SOURCE_LINE 00001492 "        if($self->{opt}->{grouptags}->{$key}) {"
NSQ_SOURCE_LINE 00001493 "          $ref->{$key} = $self->new_hashref("
NSQ_SOURCE_LINE 00001494 "            $self->{opt}->{grouptags}->{$key} => $val"
NSQ_SOURCE_LINE 00001495 "          );"
NSQ_SOURCE_LINE 00001496 "        }"
NSQ_SOURCE_LINE 00001497 "      }"
NSQ_SOURCE_LINE 00001498 "    }"
NSQ_SOURCE_LINE 00001499 ""
NSQ_SOURCE_LINE 00001500 ""
NSQ_SOURCE_LINE 00001501 "    # Scan for namespace declaration attributes"
NSQ_SOURCE_LINE 00001502 ""
NSQ_SOURCE_LINE 00001503 "    my $nsdecls = '';"
NSQ_SOURCE_LINE 00001504 "    my $default_ns_uri;"
NSQ_SOURCE_LINE 00001505 "    if($self->{nsup}) {"
NSQ_SOURCE_LINE 00001506 "      $ref = $self->copy_hash($ref);"
NSQ_SOURCE_LINE 00001507 "      $self->{nsup}->push_context();"
NSQ_SOURCE_LINE 00001508 ""
NSQ_SOURCE_LINE 00001509 "      # Look for default namespace declaration first"
NSQ_SOURCE_LINE 00001510 ""
NSQ_SOURCE_LINE 00001511 "      if(exists($ref->{xmlns})) {"
NSQ_SOURCE_LINE 00001512 "        $self->{nsup}->declare_prefix('', $ref->{xmlns});"
NSQ_SOURCE_LINE 00001513 "        $nsdecls .= qq( xmlns=\"$ref->{xmlns}\");"
NSQ_SOURCE_LINE 00001514 "        delete($ref->{xmlns});"
NSQ_SOURCE_LINE 00001515 "      }"
NSQ_SOURCE_LINE 00001516 "      $default_ns_uri = $self->{nsup}->get_uri('');"
NSQ_SOURCE_LINE 00001517 ""
NSQ_SOURCE_LINE 00001518 ""
NSQ_SOURCE_LINE 00001519 "      # Then check all the other keys"
NSQ_SOURCE_LINE 00001520 ""
NSQ_SOURCE_LINE 00001521 "      foreach my $qname (keys(%$ref)) {"
NSQ_SOURCE_LINE 00001522 "        my($uri, $lname) = $self->{nsup}->parse_jclark_notation($qname);"
NSQ_SOURCE_LINE 00001523 "        if($uri) {"
NSQ_SOURCE_LINE 00001524 "          if($uri eq $xmlns_ns) {"
NSQ_SOURCE_LINE 00001525 "            $self->{nsup}->declare_prefix($lname, $ref->{$qname});"
NSQ_SOURCE_LINE 00001526 "            $nsdecls .= qq( xmlns:$lname=\"$ref->{$qname}\");"
NSQ_SOURCE_LINE 00001527 "            delete($ref->{$qname});"
NSQ_SOURCE_LINE 00001528 "          }"
NSQ_SOURCE_LINE 00001529 "        }"
NSQ_SOURCE_LINE 00001530 "      }"
NSQ_SOURCE_LINE 00001531 ""
NSQ_SOURCE_LINE 00001532 "      # Translate any remaining Clarkian names"
NSQ_SOURCE_LINE 00001533 ""
NSQ_SOURCE_LINE 00001534 "      foreach my $qname (keys(%$ref)) {"
NSQ_SOURCE_LINE 00001535 "        my($uri, $lname) = $self->{nsup}->parse_jclark_notation($qname);"
NSQ_SOURCE_LINE 00001536 "        if($uri) {"
NSQ_SOURCE_LINE 00001537 "          if($default_ns_uri  and  $uri eq $default_ns_uri) {"
NSQ_SOURCE_LINE 00001538 "            $ref->{$lname} = $ref->{$qname};"
NSQ_SOURCE_LINE 00001539 "            delete($ref->{$qname});"
NSQ_SOURCE_LINE 00001540 "          }"
NSQ_SOURCE_LINE 00001541 "          else {"
NSQ_SOURCE_LINE 00001542 "            my $prefix = $self->{nsup}->get_prefix($uri);"
NSQ_SOURCE_LINE 00001543 "            unless($prefix) {"
NSQ_SOURCE_LINE 00001544 "              # $self->{nsup}->declare_prefix(undef, $uri);"
NSQ_SOURCE_LINE 00001545 "              # $prefix = $self->{nsup}->get_prefix($uri);"
NSQ_SOURCE_LINE 00001546 "              $prefix = $self->{ns_prefix}++;"
NSQ_SOURCE_LINE 00001547 "              $self->{nsup}->declare_prefix($prefix, $uri);"
NSQ_SOURCE_LINE 00001548 "              $nsdecls .= qq( xmlns:$prefix=\"$uri\");"
NSQ_SOURCE_LINE 00001549 "            }"
NSQ_SOURCE_LINE 00001550 "            $ref->{\"$prefix:$lname\"} = $ref->{$qname};"
NSQ_SOURCE_LINE 00001551 "            delete($ref->{$qname});"
NSQ_SOURCE_LINE 00001552 "          }"
NSQ_SOURCE_LINE 00001553 "        }"
NSQ_SOURCE_LINE 00001554 "      }"
NSQ_SOURCE_LINE 00001555 "    }"
NSQ_SOURCE_LINE 00001556 ""
NSQ_SOURCE_LINE 00001557 ""
NSQ_SOURCE_LINE 00001558 "    my @nested = ();"
NSQ_SOURCE_LINE 00001559 "    my $text_content = undef;"
NSQ_SOURCE_LINE 00001560 "    if($named) {"
NSQ_SOURCE_LINE 00001561 "      push @result, $indent, '<', $name, $nsdecls;"
NSQ_SOURCE_LINE 00001562 "    }"
NSQ_SOURCE_LINE 00001563 ""
NSQ_SOURCE_LINE 00001564 "    if(keys %$ref) {"
NSQ_SOURCE_LINE 00001565 "      my $first_arg = 1;"
NSQ_SOURCE_LINE 00001566 "      foreach my $key ($self->sorted_keys($name, $ref)) {"
NSQ_SOURCE_LINE 00001567 "        my $value = $ref->{$key};"
NSQ_SOURCE_LINE 00001568 "        next if(substr($key, 0, 1) eq '-');"
NSQ_SOURCE_LINE 00001569 "        if(!defined($value)) {"
NSQ_SOURCE_LINE 00001570 "          next if $self->{opt}->{suppressempty};"
NSQ_SOURCE_LINE 00001571 "          unless(exists($self->{opt}->{suppressempty})"
NSQ_SOURCE_LINE 00001572 "             and !defined($self->{opt}->{suppressempty})"
NSQ_SOURCE_LINE 00001573 "          ) {"
NSQ_SOURCE_LINE 00001574 "            carp 'Use of uninitialized value' if warnings::enabled();"
NSQ_SOURCE_LINE 00001575 "          }"
NSQ_SOURCE_LINE 00001576 "          if($key eq $self->{opt}->{contentkey}) {"
NSQ_SOURCE_LINE 00001577 "            $text_content = '';"
NSQ_SOURCE_LINE 00001578 "          }"
NSQ_SOURCE_LINE 00001579 "          else {"
NSQ_SOURCE_LINE 00001580 "            $value = exists($self->{opt}->{suppressempty}) ? {} : '';"
NSQ_SOURCE_LINE 00001581 "          }"
NSQ_SOURCE_LINE 00001582 "        }"
NSQ_SOURCE_LINE 00001583 ""
NSQ_SOURCE_LINE 00001584 "        if(!ref($value)"
NSQ_SOURCE_LINE 00001585 "           and $self->{opt}->{valueattr}"
NSQ_SOURCE_LINE 00001586 "           and $self->{opt}->{valueattr}->{$key}"
NSQ_SOURCE_LINE 00001587 "        ) {"
NSQ_SOURCE_LINE 00001588 "          $value = $self->new_hashref("
NSQ_SOURCE_LINE 00001589 "            $self->{opt}->{valueattr}->{$key} => $value"
NSQ_SOURCE_LINE 00001590 "          );"
NSQ_SOURCE_LINE 00001591 "        }"
NSQ_SOURCE_LINE 00001592 ""
NSQ_SOURCE_LINE 00001593 "        if(ref($value)  or  $self->{opt}->{noattr}) {"
NSQ_SOURCE_LINE 00001594 "          push @nested,"
NSQ_SOURCE_LINE 00001595 "            $self->value_to_xml($value, $key, \"$indent  \");"
NSQ_SOURCE_LINE 00001596 "        }"
NSQ_SOURCE_LINE 00001597 "        else {"
NSQ_SOURCE_LINE 00001598 "          if($key eq $self->{opt}->{contentkey}) {"
NSQ_SOURCE_LINE 00001599 "            $value = $self->escape_value($value) unless($self->{opt}->{noescape});"
NSQ_SOURCE_LINE 00001600 "            $text_content = $value;"
NSQ_SOURCE_LINE 00001601 "          }"
NSQ_SOURCE_LINE 00001602 "          else {"
NSQ_SOURCE_LINE 00001603 "            $value = $self->escape_attr($value) unless($self->{opt}->{noescape});"
NSQ_SOURCE_LINE 00001604 "            push @result, \"\\n$indent \" . ' ' x length($name)"
NSQ_SOURCE_LINE 00001605 "              if($self->{opt}->{attrindent}  and  !$first_arg);"
NSQ_SOURCE_LINE 00001606 "            push @result, ' ', $key, '=\"', $value , '\"';"
NSQ_SOURCE_LINE 00001607 "            $first_arg = 0;"
NSQ_SOURCE_LINE 00001608 "          }"
NSQ_SOURCE_LINE 00001609 "        }"
NSQ_SOURCE_LINE 00001610 "      }"
NSQ_SOURCE_LINE 00001611 "    }"
NSQ_SOURCE_LINE 00001612 "    else {"
NSQ_SOURCE_LINE 00001613 "      $text_content = '';"
NSQ_SOURCE_LINE 00001614 "    }"
NSQ_SOURCE_LINE 00001615 ""
NSQ_SOURCE_LINE 00001616 "    if(@nested  or  defined($text_content)) {"
NSQ_SOURCE_LINE 00001617 "      if($named) {"
NSQ_SOURCE_LINE 00001618 "        push @result, \">\";"
NSQ_SOURCE_LINE 00001619 "        if(defined($text_content)) {"
NSQ_SOURCE_LINE 00001620 "          push @result, $text_content;"
NSQ_SOURCE_LINE 00001621 "          $nested[0] =~ s/^\\s+// if(@nested);"
NSQ_SOURCE_LINE 00001622 "        }"
NSQ_SOURCE_LINE 00001623 "        else {"
NSQ_SOURCE_LINE 00001624 "          push @result, $nl;"
NSQ_SOURCE_LINE 00001625 "        }"
NSQ_SOURCE_LINE 00001626 "        if(@nested) {"
NSQ_SOURCE_LINE 00001627 "          push @result, @nested, $indent;"
NSQ_SOURCE_LINE 00001628 "        }"
NSQ_SOURCE_LINE 00001629 "        push @result, '</', $name, \">\", $nl;"
NSQ_SOURCE_LINE 00001630 "      }"
NSQ_SOURCE_LINE 00001631 "      else {"
NSQ_SOURCE_LINE 00001632 "        push @result, @nested;             # Special case if no root elements"
NSQ_SOURCE_LINE 00001633 "      }"
NSQ_SOURCE_LINE 00001634 "    }"
NSQ_SOURCE_LINE 00001635 "    else {"
NSQ_SOURCE_LINE 00001636 "      push @result, \" />\", $nl;"
NSQ_SOURCE_LINE 00001637 "    }"
NSQ_SOURCE_LINE 00001638 "    $self->{nsup}->pop_context() if($self->{nsup});"
NSQ_SOURCE_LINE 00001639 "  }"
NSQ_SOURCE_LINE 00001640 ""
NSQ_SOURCE_LINE 00001641 ""
NSQ_SOURCE_LINE 00001642 "  # Handle arrayrefs"
NSQ_SOURCE_LINE 00001643 ""
NSQ_SOURCE_LINE 00001644 "  elsif(UNIVERSAL::isa($ref, 'ARRAY')) {"
NSQ_SOURCE_LINE 00001645 "    foreach $value (@$ref) {"
NSQ_SOURCE_LINE 00001646 "      next if !defined($value) and $self->{opt}->{suppressempty};"
NSQ_SOURCE_LINE 00001647 "      if(!ref($value)) {"
NSQ_SOURCE_LINE 00001648 "        push @result,"
NSQ_SOURCE_LINE 00001649 "             $indent, '<', $name, '>',"
NSQ_SOURCE_LINE 00001650 "             ($self->{opt}->{noescape} ? $value : $self->escape_value($value)),"
NSQ_SOURCE_LINE 00001651 "             '</', $name, \">$nl\";"
NSQ_SOURCE_LINE 00001652 "      }"
NSQ_SOURCE_LINE 00001653 "      elsif(UNIVERSAL::isa($value, 'HASH')) {"
NSQ_SOURCE_LINE 00001654 "        push @result, $self->value_to_xml($value, $name, $indent);"
NSQ_SOURCE_LINE 00001655 "      }"
NSQ_SOURCE_LINE 00001656 "      else {"
NSQ_SOURCE_LINE 00001657 "        push @result,"
NSQ_SOURCE_LINE 00001658 "               $indent, '<', $name, \">$nl\","
NSQ_SOURCE_LINE 00001659 "               $self->value_to_xml($value, 'anon', \"$indent  \"),"
NSQ_SOURCE_LINE 00001660 "               $indent, '</', $name, \">$nl\";"
NSQ_SOURCE_LINE 00001661 "      }"
NSQ_SOURCE_LINE 00001662 "    }"
NSQ_SOURCE_LINE 00001663 "  }"
NSQ_SOURCE_LINE 00001664 ""
NSQ_SOURCE_LINE 00001665 "  else {"
NSQ_SOURCE_LINE 00001666 "    croak \"Can't encode a value of type: \" . ref($ref);"
NSQ_SOURCE_LINE 00001667 "  }"
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 ""
NSQ_SOURCE_LINE 00001670 "  delete $self->{_ancestors}->{$refaddr};"
NSQ_SOURCE_LINE 00001671 ""
NSQ_SOURCE_LINE 00001672 "  return(join('', @result));"
NSQ_SOURCE_LINE 00001673 "}"
NSQ_SOURCE_LINE 00001674 ""
NSQ_SOURCE_LINE 00001675 ""
NSQ_SOURCE_LINE 00001676 "##############################################################################"
NSQ_SOURCE_LINE 00001677 "# Method: sorted_keys()"
NSQ_SOURCE_LINE 00001678 "#"
NSQ_SOURCE_LINE 00001679 "# Returns the keys of the referenced hash sorted into alphabetical order, but"
NSQ_SOURCE_LINE 00001680 "# with the 'key' key (as in KeyAttr) first, if there is one."
NSQ_SOURCE_LINE 00001681 "#"
NSQ_SOURCE_LINE 00001682 ""
NSQ_SOURCE_LINE 00001683 "sub sorted_keys {"
NSQ_SOURCE_LINE 00001684 "  my($self, $name, $ref) = @_;"
NSQ_SOURCE_LINE 00001685 ""
NSQ_SOURCE_LINE 00001686 "  return keys %$ref if $self->{opt}->{nosort};"
NSQ_SOURCE_LINE 00001687 ""
NSQ_SOURCE_LINE 00001688 "  my %hash = %$ref;"
NSQ_SOURCE_LINE 00001689 "  my $keyattr = $self->{opt}->{keyattr};"
NSQ_SOURCE_LINE 00001690 ""
NSQ_SOURCE_LINE 00001691 "  my @key;"
NSQ_SOURCE_LINE 00001692 ""
NSQ_SOURCE_LINE 00001693 "  if(ref $keyattr eq 'HASH') {"
NSQ_SOURCE_LINE 00001694 "    if(exists $keyattr->{$name} and exists $hash{$keyattr->{$name}->[0]}) {"
NSQ_SOURCE_LINE 00001695 "      push @key, $keyattr->{$name}->[0];"
NSQ_SOURCE_LINE 00001696 "      delete $hash{$keyattr->{$name}->[0]};"
NSQ_SOURCE_LINE 00001697 "    }"
NSQ_SOURCE_LINE 00001698 "  }"
NSQ_SOURCE_LINE 00001699 "  elsif(ref $keyattr eq 'ARRAY') {"
NSQ_SOURCE_LINE 00001700 "    foreach (@{$keyattr}) {"
NSQ_SOURCE_LINE 00001701 "      if(exists $hash{$_}) {"
NSQ_SOURCE_LINE 00001702 "        push @key, $_;"
NSQ_SOURCE_LINE 00001703 "        delete $hash{$_};"
NSQ_SOURCE_LINE 00001704 "        last;"
NSQ_SOURCE_LINE 00001705 "      }"
NSQ_SOURCE_LINE 00001706 "    }"
NSQ_SOURCE_LINE 00001707 "  }"
NSQ_SOURCE_LINE 00001708 ""
NSQ_SOURCE_LINE 00001709 "  return(@key, sort keys %hash);"
NSQ_SOURCE_LINE 00001710 "}"
NSQ_SOURCE_LINE 00001711 ""
NSQ_SOURCE_LINE 00001712 "##############################################################################"
NSQ_SOURCE_LINE 00001713 "# Method: escape_value()"
NSQ_SOURCE_LINE 00001714 "#"
NSQ_SOURCE_LINE 00001715 "# Helper routine for automatically escaping values for XMLout()."
NSQ_SOURCE_LINE 00001716 "# Expects a scalar data value.  Returns escaped version."
NSQ_SOURCE_LINE 00001717 "#"
NSQ_SOURCE_LINE 00001718 ""
NSQ_SOURCE_LINE 00001719 "sub escape_value {"
NSQ_SOURCE_LINE 00001720 "  my($self, $data) = @_;"
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "  return '' unless(defined($data));"
NSQ_SOURCE_LINE 00001723 ""
NSQ_SOURCE_LINE 00001724 "  $data =~ s/&/&amp;/sg;"
NSQ_SOURCE_LINE 00001725 "  $data =~ s/</&lt;/sg;"
NSQ_SOURCE_LINE 00001726 "  $data =~ s/>/&gt;/sg;"
NSQ_SOURCE_LINE 00001727 "  $data =~ s/\"/&quot;/sg;"
NSQ_SOURCE_LINE 00001728 ""
NSQ_SOURCE_LINE 00001729 "  my $level = $self->{opt}->{numericescape} or return $data;"
NSQ_SOURCE_LINE 00001730 ""
NSQ_SOURCE_LINE 00001731 "  return $self->numeric_escape($data, $level);"
NSQ_SOURCE_LINE 00001732 "}"
NSQ_SOURCE_LINE 00001733 ""
NSQ_SOURCE_LINE 00001734 "sub numeric_escape {"
NSQ_SOURCE_LINE 00001735 "  my($self, $data, $level) = @_;"
NSQ_SOURCE_LINE 00001736 ""
NSQ_SOURCE_LINE 00001737 "  if($self->{opt}->{numericescape} eq '2') {"
NSQ_SOURCE_LINE 00001738 "    $data =~ s/([^\\x00-\\x7F])/'&#' . ord($1) . ';'/gse;"
NSQ_SOURCE_LINE 00001739 "  }"
NSQ_SOURCE_LINE 00001740 "  else {"
NSQ_SOURCE_LINE 00001741 "    $data =~ s/([^\\x00-\\xFF])/'&#' . ord($1) . ';'/gse;"
NSQ_SOURCE_LINE 00001742 "  }"
NSQ_SOURCE_LINE 00001743 ""
NSQ_SOURCE_LINE 00001744 "  return $data;"
NSQ_SOURCE_LINE 00001745 "}"
NSQ_SOURCE_LINE 00001746 ""
NSQ_SOURCE_LINE 00001747 "##############################################################################"
NSQ_SOURCE_LINE 00001748 "# Method: escape_attr()"
NSQ_SOURCE_LINE 00001749 "#"
NSQ_SOURCE_LINE 00001750 "# Helper routine for escaping attribute values.  Defaults to escape_value(),"
NSQ_SOURCE_LINE 00001751 "# but may be overridden by a subclass to customise behaviour."
NSQ_SOURCE_LINE 00001752 "#"
NSQ_SOURCE_LINE 00001753 ""
NSQ_SOURCE_LINE 00001754 "sub escape_attr {"
NSQ_SOURCE_LINE 00001755 "  my $self = shift;"
NSQ_SOURCE_LINE 00001756 ""
NSQ_SOURCE_LINE 00001757 "  return $self->escape_value(@_);"
NSQ_SOURCE_LINE 00001758 "}"
NSQ_SOURCE_LINE 00001759 ""
NSQ_SOURCE_LINE 00001760 ""
NSQ_SOURCE_LINE 00001761 "##############################################################################"
NSQ_SOURCE_LINE 00001762 "# Method: hash_to_array()"
NSQ_SOURCE_LINE 00001763 "#"
NSQ_SOURCE_LINE 00001764 "# Helper routine for value_to_xml()."
NSQ_SOURCE_LINE 00001765 "# Attempts to 'unfold' a hash of hashes into an array of hashes.  Returns a"
NSQ_SOURCE_LINE 00001766 "# reference to the array on success or the original hash if unfolding is"
NSQ_SOURCE_LINE 00001767 "# not possible."
NSQ_SOURCE_LINE 00001768 "#"
NSQ_SOURCE_LINE 00001769 ""
NSQ_SOURCE_LINE 00001770 "sub hash_to_array {"
NSQ_SOURCE_LINE 00001771 "  my $self    = shift;"
NSQ_SOURCE_LINE 00001772 "  my $parent  = shift;"
NSQ_SOURCE_LINE 00001773 "  my $hashref = shift;"
NSQ_SOURCE_LINE 00001774 ""
NSQ_SOURCE_LINE 00001775 "  my $arrayref = [];"
NSQ_SOURCE_LINE 00001776 ""
NSQ_SOURCE_LINE 00001777 "  my($key, $value);"
NSQ_SOURCE_LINE 00001778 ""
NSQ_SOURCE_LINE 00001779 "  my @keys = $self->{opt}->{nosort} ? keys %$hashref : sort keys %$hashref;"
NSQ_SOURCE_LINE 00001780 "  foreach $key (@keys) {"
NSQ_SOURCE_LINE 00001781 "    $value = $hashref->{$key};"
NSQ_SOURCE_LINE 00001782 "    return($hashref) unless(UNIVERSAL::isa($value, 'HASH'));"
NSQ_SOURCE_LINE 00001783 ""
NSQ_SOURCE_LINE 00001784 "    if(ref($self->{opt}->{keyattr}) eq 'HASH') {"
NSQ_SOURCE_LINE 00001785 "      return($hashref) unless(defined($self->{opt}->{keyattr}->{$parent}));"
NSQ_SOURCE_LINE 00001786 "      push @$arrayref, $self->copy_hash("
NSQ_SOURCE_LINE 00001787 "        $value, $self->{opt}->{keyattr}->{$parent}->[0] => $key"
NSQ_SOURCE_LINE 00001788 "      );"
NSQ_SOURCE_LINE 00001789 "    }"
NSQ_SOURCE_LINE 00001790 "    else {"
NSQ_SOURCE_LINE 00001791 "      push(@$arrayref, { $self->{opt}->{keyattr}->[0] => $key, %$value });"
NSQ_SOURCE_LINE 00001792 "    }"
NSQ_SOURCE_LINE 00001793 "  }"
NSQ_SOURCE_LINE 00001794 ""
NSQ_SOURCE_LINE 00001795 "  return($arrayref);"
NSQ_SOURCE_LINE 00001796 "}"
NSQ_SOURCE_LINE 00001797 ""
NSQ_SOURCE_LINE 00001798 ""
NSQ_SOURCE_LINE 00001799 "##############################################################################"
NSQ_SOURCE_LINE 00001800 "# Method: copy_hash()"
NSQ_SOURCE_LINE 00001801 "#"
NSQ_SOURCE_LINE 00001802 "# Helper routine for hash_to_array().  When unfolding a hash of hashes into"
NSQ_SOURCE_LINE 00001803 "# an array of hashes, we need to copy the key from the outer hash into the"
NSQ_SOURCE_LINE 00001804 "# inner hash.  This routine makes a copy of the original hash so we don't"
NSQ_SOURCE_LINE 00001805 "# destroy the original data structure.  You might wish to override this"
NSQ_SOURCE_LINE 00001806 "# method if you're using tied hashes and don't want them to get untied."
NSQ_SOURCE_LINE 00001807 "#"
NSQ_SOURCE_LINE 00001808 ""
NSQ_SOURCE_LINE 00001809 "sub copy_hash {"
NSQ_SOURCE_LINE 00001810 "  my($self, $orig, @extra) = @_;"
NSQ_SOURCE_LINE 00001811 ""
NSQ_SOURCE_LINE 00001812 "  return { @extra, %$orig };"
NSQ_SOURCE_LINE 00001813 "}"
NSQ_SOURCE_LINE 00001814 ""
NSQ_SOURCE_LINE 00001815 "##############################################################################"
NSQ_SOURCE_LINE 00001816 "# Methods required for building trees from SAX events"
NSQ_SOURCE_LINE 00001817 "##############################################################################"
NSQ_SOURCE_LINE 00001818 ""
NSQ_SOURCE_LINE 00001819 "sub start_document {"
NSQ_SOURCE_LINE 00001820 "  my $self = shift;"
NSQ_SOURCE_LINE 00001821 ""
NSQ_SOURCE_LINE 00001822 "  $self->handle_options('in') unless($self->{opt});"
NSQ_SOURCE_LINE 00001823 ""
NSQ_SOURCE_LINE 00001824 "  $self->{lists} = [];"
NSQ_SOURCE_LINE 00001825 "  $self->{curlist} = $self->{tree} = [];"
NSQ_SOURCE_LINE 00001826 "}"
NSQ_SOURCE_LINE 00001827 ""
NSQ_SOURCE_LINE 00001828 ""
NSQ_SOURCE_LINE 00001829 "sub start_element {"
NSQ_SOURCE_LINE 00001830 "  my $self    = shift;"
NSQ_SOURCE_LINE 00001831 "  my $element = shift;"
NSQ_SOURCE_LINE 00001832 ""
NSQ_SOURCE_LINE 00001833 "  my $name = $element->{Name};"
NSQ_SOURCE_LINE 00001834 "  if($self->{opt}->{nsexpand}) {"
NSQ_SOURCE_LINE 00001835 "    $name = $element->{LocalName} || '';"
NSQ_SOURCE_LINE 00001836 "    if($element->{NamespaceURI}) {"
NSQ_SOURCE_LINE 00001837 "      $name = '{' . $element->{NamespaceURI} . '}' . $name;"
NSQ_SOURCE_LINE 00001838 "    }"
NSQ_SOURCE_LINE 00001839 "  }"
NSQ_SOURCE_LINE 00001840 "  my $attributes = {};"
NSQ_SOURCE_LINE 00001841 "  if($element->{Attributes}) {  # Might be undef"
NSQ_SOURCE_LINE 00001842 "    foreach my $attr (values %{$element->{Attributes}}) {"
NSQ_SOURCE_LINE 00001843 "      if($self->{opt}->{nsexpand}) {"
NSQ_SOURCE_LINE 00001844 "        my $name = $attr->{LocalName} || '';"
NSQ_SOURCE_LINE 00001845 "        if($attr->{NamespaceURI}) {"
NSQ_SOURCE_LINE 00001846 "          $name = '{' . $attr->{NamespaceURI} . '}' . $name"
NSQ_SOURCE_LINE 00001847 "        }"
NSQ_SOURCE_LINE 00001848 "        $name = 'xmlns' if($name eq $bad_def_ns_jcn);"
NSQ_SOURCE_LINE 00001849 "        $attributes->{$name} = $attr->{Value};"
NSQ_SOURCE_LINE 00001850 "      }"
NSQ_SOURCE_LINE 00001851 "      else {"
NSQ_SOURCE_LINE 00001852 "        $attributes->{$attr->{Name}} = $attr->{Value};"
NSQ_SOURCE_LINE 00001853 "      }"
NSQ_SOURCE_LINE 00001854 "    }"
NSQ_SOURCE_LINE 00001855 "  }"
NSQ_SOURCE_LINE 00001856 "  my $newlist = [ $attributes ];"
NSQ_SOURCE_LINE 00001857 "  push @{ $self->{lists} }, $self->{curlist};"
NSQ_SOURCE_LINE 00001858 "  push @{ $self->{curlist} }, $name => $newlist;"
NSQ_SOURCE_LINE 00001859 "  $self->{curlist} = $newlist;"
NSQ_SOURCE_LINE 00001860 "}"
NSQ_SOURCE_LINE 00001861 ""
NSQ_SOURCE_LINE 00001862 ""
NSQ_SOURCE_LINE 00001863 "sub characters {"
NSQ_SOURCE_LINE 00001864 "  my $self  = shift;"
NSQ_SOURCE_LINE 00001865 "  my $chars = shift;"
NSQ_SOURCE_LINE 00001866 ""
NSQ_SOURCE_LINE 00001867 "  my $text  = $chars->{Data};"
NSQ_SOURCE_LINE 00001868 "  my $clist = $self->{curlist};"
NSQ_SOURCE_LINE 00001869 "  my $pos = $#$clist;"
NSQ_SOURCE_LINE 00001870 ""
NSQ_SOURCE_LINE 00001871 "  if ($pos > 0 and $clist->[$pos - 1] eq '0') {"
NSQ_SOURCE_LINE 00001872 "    $clist->[$pos] .= $text;"
NSQ_SOURCE_LINE 00001873 "  }"
NSQ_SOURCE_LINE 00001874 "  else {"
NSQ_SOURCE_LINE 00001875 "    push @$clist, 0 => $text;"
NSQ_SOURCE_LINE 00001876 "  }"
NSQ_SOURCE_LINE 00001877 "}"
NSQ_SOURCE_LINE 00001878 ""
NSQ_SOURCE_LINE 00001879 ""
NSQ_SOURCE_LINE 00001880 "sub end_element {"
NSQ_SOURCE_LINE 00001881 "  my $self    = shift;"
NSQ_SOURCE_LINE 00001882 ""
NSQ_SOURCE_LINE 00001883 "  $self->{curlist} = pop @{ $self->{lists} };"
NSQ_SOURCE_LINE 00001884 "}"
NSQ_SOURCE_LINE 00001885 ""
NSQ_SOURCE_LINE 00001886 ""
NSQ_SOURCE_LINE 00001887 "sub end_document {"
NSQ_SOURCE_LINE 00001888 "  my $self = shift;"
NSQ_SOURCE_LINE 00001889 ""
NSQ_SOURCE_LINE 00001890 "  delete($self->{curlist});"
NSQ_SOURCE_LINE 00001891 "  delete($self->{lists});"
NSQ_SOURCE_LINE 00001892 ""
NSQ_SOURCE_LINE 00001893 "  my $tree = $self->{tree};"
NSQ_SOURCE_LINE 00001894 "  delete($self->{tree});"
NSQ_SOURCE_LINE 00001895 ""
NSQ_SOURCE_LINE 00001896 ""
NSQ_SOURCE_LINE 00001897 "  # Return tree as-is to XMLin()"
NSQ_SOURCE_LINE 00001898 ""
NSQ_SOURCE_LINE 00001899 "  return($tree) if($self->{nocollapse});"
NSQ_SOURCE_LINE 00001900 ""
NSQ_SOURCE_LINE 00001901 ""
NSQ_SOURCE_LINE 00001902 "  # Or collapse it before returning it to SAX parser class"
NSQ_SOURCE_LINE 00001903 ""
NSQ_SOURCE_LINE 00001904 "  if($self->{opt}->{keeproot}) {"
NSQ_SOURCE_LINE 00001905 "    $tree = $self->collapse({}, @$tree);"
NSQ_SOURCE_LINE 00001906 "  }"
NSQ_SOURCE_LINE 00001907 "  else {"
NSQ_SOURCE_LINE 00001908 "    $tree = $self->collapse(@{$tree->[1]});"
NSQ_SOURCE_LINE 00001909 "  }"
NSQ_SOURCE_LINE 00001910 ""
NSQ_SOURCE_LINE 00001911 "  if($self->{opt}->{datahandler}) {"
NSQ_SOURCE_LINE 00001912 "    return($self->{opt}->{datahandler}->($self, $tree));"
NSQ_SOURCE_LINE 00001913 "  }"
NSQ_SOURCE_LINE 00001914 ""
NSQ_SOURCE_LINE 00001915 "  return($tree);"
NSQ_SOURCE_LINE 00001916 "}"
NSQ_SOURCE_LINE 00001917 ""
NSQ_SOURCE_LINE 00001918 "*xml_in  = \\&XMLin;"
NSQ_SOURCE_LINE 00001919 "*xml_out = \\&XMLout;"
NSQ_SOURCE_LINE 00001920 ""
NSQ_SOURCE_LINE 00001921 "1;"
NSQ_SOURCE_LINE 00001922 ""
NSQ_SOURCE_LINE 00001923 "__END__"
NSQ_SOURCE_LINE 00001924 ""
NSQ_SOURCE_LINE 00001925 "=head1 STATUS OF THIS MODULE"
NSQ_SOURCE_LINE 00001926 ""
NSQ_SOURCE_LINE 00001927 "The use of this module in new code is B<strongly discouraged>.  Other modules"
NSQ_SOURCE_LINE 00001928 "are available which provide more straightforward and consistent interfaces.  In"
NSQ_SOURCE_LINE 00001929 "particular, L<XML::LibXML> is highly recommended and you can refer to"
NSQ_SOURCE_LINE 00001930 "L<Perl XML::LibXML by Example|http://grantm.github.io/perl-libxml-by-example/>"
NSQ_SOURCE_LINE 00001931 "for a tutorial introduction."
NSQ_SOURCE_LINE 00001932 ""
NSQ_SOURCE_LINE 00001933 "L<XML::Twig> is another excellent alternative."
NSQ_SOURCE_LINE 00001934 ""
NSQ_SOURCE_LINE 00001935 "The major problems with this module are the large number of options (some of"
NSQ_SOURCE_LINE 00001936 "which have unfortunate defaults) and the arbitrary ways in which these options"
NSQ_SOURCE_LINE 00001937 "interact - often producing unexpected results."
NSQ_SOURCE_LINE 00001938 ""
NSQ_SOURCE_LINE 00001939 "Patches with bug fixes and documentation fixes are welcome, but new features"
NSQ_SOURCE_LINE 00001940 "are unlikely to be added."
NSQ_SOURCE_LINE 00001941 ""
NSQ_SOURCE_LINE 00001942 "=head1 QUICK START"
NSQ_SOURCE_LINE 00001943 ""
NSQ_SOURCE_LINE 00001944 "Say you have a script called B<foo> and a file of configuration options"
NSQ_SOURCE_LINE 00001945 "called B<foo.xml> containing the following:"
NSQ_SOURCE_LINE 00001946 ""
NSQ_SOURCE_LINE 00001947 "  <config logdir=\"/var/log/foo/\" debugfile=\"/tmp/foo.debug\">"
NSQ_SOURCE_LINE 00001948 "    <server name=\"sahara\" osname=\"solaris\" osversion=\"2.6\">"
NSQ_SOURCE_LINE 00001949 "      <address>10.0.0.101</address>"
NSQ_SOURCE_LINE 00001950 "      <address>10.0.1.101</address>"
NSQ_SOURCE_LINE 00001951 "    </server>"
NSQ_SOURCE_LINE 00001952 "    <server name=\"gobi\" osname=\"irix\" osversion=\"6.5\">"
NSQ_SOURCE_LINE 00001953 "      <address>10.0.0.102</address>"
NSQ_SOURCE_LINE 00001954 "    </server>"
NSQ_SOURCE_LINE 00001955 "    <server name=\"kalahari\" osname=\"linux\" osversion=\"2.0.34\">"
NSQ_SOURCE_LINE 00001956 "      <address>10.0.0.103</address>"
NSQ_SOURCE_LINE 00001957 "      <address>10.0.1.103</address>"
NSQ_SOURCE_LINE 00001958 "    </server>"
NSQ_SOURCE_LINE 00001959 "  </config>"
NSQ_SOURCE_LINE 00001960 ""
NSQ_SOURCE_LINE 00001961 "The following lines of code in B<foo>:"
NSQ_SOURCE_LINE 00001962 ""
NSQ_SOURCE_LINE 00001963 "  use XML::Simple qw(:strict);"
NSQ_SOURCE_LINE 00001964 ""
NSQ_SOURCE_LINE 00001965 "  my $config = XMLin(undef, KeyAttr => { server => 'name' }, ForceArray => [ 'server', 'address' ]);"
NSQ_SOURCE_LINE 00001966 ""
NSQ_SOURCE_LINE 00001967 "will 'slurp' the configuration options into the hashref $config (because no"
NSQ_SOURCE_LINE 00001968 "filename or XML string was passed as the first argument to C<XMLin()> the name"
NSQ_SOURCE_LINE 00001969 "and location of the XML file will be inferred from name and location of the"
NSQ_SOURCE_LINE 00001970 "script).  You can dump out the contents of the hashref using Data::Dumper:"
NSQ_SOURCE_LINE 00001971 ""
NSQ_SOURCE_LINE 00001972 "  use Data::Dumper;"
NSQ_SOURCE_LINE 00001973 ""
NSQ_SOURCE_LINE 00001974 "  print Dumper($config);"
NSQ_SOURCE_LINE 00001975 ""
NSQ_SOURCE_LINE 00001976 "which will produce something like this (formatting has been adjusted for"
NSQ_SOURCE_LINE 00001977 "brevity):"
NSQ_SOURCE_LINE 00001978 ""
NSQ_SOURCE_LINE 00001979 "  {"
NSQ_SOURCE_LINE 00001980 "      'logdir'        => '/var/log/foo/',"
NSQ_SOURCE_LINE 00001981 "      'debugfile'     => '/tmp/foo.debug',"
NSQ_SOURCE_LINE 00001982 "      'server'        => {"
NSQ_SOURCE_LINE 00001983 "          'sahara'        => {"
NSQ_SOURCE_LINE 00001984 "              'osversion'     => '2.6',"
NSQ_SOURCE_LINE 00001985 "              'osname'        => 'solaris',"
NSQ_SOURCE_LINE 00001986 "              'address'       => [ '10.0.0.101', '10.0.1.101' ]"
NSQ_SOURCE_LINE 00001987 "          },"
NSQ_SOURCE_LINE 00001988 "          'gobi'          => {"
NSQ_SOURCE_LINE 00001989 "              'osversion'     => '6.5',"
NSQ_SOURCE_LINE 00001990 "              'osname'        => 'irix',"
NSQ_SOURCE_LINE 00001991 "              'address'       => [ '10.0.0.102' ]"
NSQ_SOURCE_LINE 00001992 "          },"
NSQ_SOURCE_LINE 00001993 "          'kalahari'      => {"
NSQ_SOURCE_LINE 00001994 "              'osversion'     => '2.0.34',"
NSQ_SOURCE_LINE 00001995 "              'osname'        => 'linux',"
NSQ_SOURCE_LINE 00001996 "              'address'       => [ '10.0.0.103', '10.0.1.103' ]"
NSQ_SOURCE_LINE 00001997 "          }"
NSQ_SOURCE_LINE 00001998 "      }"
NSQ_SOURCE_LINE 00001999 "  }"
NSQ_SOURCE_LINE 00002000 ""
NSQ_SOURCE_LINE 00002001 "Your script could then access the name of the log directory like this:"
NSQ_SOURCE_LINE 00002002 ""
NSQ_SOURCE_LINE 00002003 "  print $config->{logdir};"
NSQ_SOURCE_LINE 00002004 ""
NSQ_SOURCE_LINE 00002005 "similarly, the second address on the server 'kalahari' could be referenced as:"
NSQ_SOURCE_LINE 00002006 ""
NSQ_SOURCE_LINE 00002007 "  print $config->{server}->{kalahari}->{address}->[1];"
NSQ_SOURCE_LINE 00002008 ""
NSQ_SOURCE_LINE 00002009 "Note: If the mapping between the output of Data::Dumper and the print"
NSQ_SOURCE_LINE 00002010 "statements above is not obvious to you, then please refer to the 'references'"
NSQ_SOURCE_LINE 00002011 "tutorial (AKA: \"Mark's very short tutorial about references\") at L<perlreftut>."
NSQ_SOURCE_LINE 00002012 ""
NSQ_SOURCE_LINE 00002013 "In this example, the C<< ForceArray >> option was used to list elements that"
NSQ_SOURCE_LINE 00002014 "might occur multiple times and should therefore be represented as arrayrefs"
NSQ_SOURCE_LINE 00002015 "(even when only one element is present)."
NSQ_SOURCE_LINE 00002016 ""
NSQ_SOURCE_LINE 00002017 "The C<< KeyAttr >> option was used to indicate that each C<< <server> >>"
NSQ_SOURCE_LINE 00002018 "element has a unique identifier in the C<< name >> attribute.  This allows you"
NSQ_SOURCE_LINE 00002019 "to index directly to a particular server record using the name as a hash key"
NSQ_SOURCE_LINE 00002020 "(as shown above)."
NSQ_SOURCE_LINE 00002021 ""
NSQ_SOURCE_LINE 00002022 "For simple requirements, that's really all there is to it.  If you want to"
NSQ_SOURCE_LINE 00002023 "store your XML in a different directory or file, or pass it in as a string or"
NSQ_SOURCE_LINE 00002024 "even pass it in via some derivative of an IO::Handle, you'll need to check out"
NSQ_SOURCE_LINE 00002025 "L<\"OPTIONS\">.  If you want to turn off or tweak the array folding feature (that"
NSQ_SOURCE_LINE 00002026 "neat little transformation that produced $config->{server}) you'll find options"
NSQ_SOURCE_LINE 00002027 "for that as well."
NSQ_SOURCE_LINE 00002028 ""
NSQ_SOURCE_LINE 00002029 "If you want to generate XML (for example to write a modified version of"
NSQ_SOURCE_LINE 00002030 "$config back out as XML), check out C<XMLout()>."
NSQ_SOURCE_LINE 00002031 ""
NSQ_SOURCE_LINE 00002032 "If your needs are not so simple, this may not be the module for you.  In that"
NSQ_SOURCE_LINE 00002033 "case, you might want to read L<\"WHERE TO FROM HERE?\">."
NSQ_SOURCE_LINE 00002034 ""
NSQ_SOURCE_LINE 00002035 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00002036 ""
NSQ_SOURCE_LINE 00002037 "The XML::Simple module provides a simple API layer on top of an underlying XML"
NSQ_SOURCE_LINE 00002038 "parsing module (either XML::Parser or one of the SAX2 parser modules).  Two"
NSQ_SOURCE_LINE 00002039 "functions are exported: C<XMLin()> and C<XMLout()>.  Note: you can explicitly"
NSQ_SOURCE_LINE 00002040 "request the lower case versions of the function names: C<xml_in()> and"
NSQ_SOURCE_LINE 00002041 "C<xml_out()>."
NSQ_SOURCE_LINE 00002042 ""
NSQ_SOURCE_LINE 00002043 "The simplest approach is to call these two functions directly, but an"
NSQ_SOURCE_LINE 00002044 "optional object oriented interface (see L<\"OPTIONAL OO INTERFACE\"> below)"
NSQ_SOURCE_LINE 00002045 "allows them to be called as methods of an B<XML::Simple> object.  The object"
NSQ_SOURCE_LINE 00002046 "interface can also be used at either end of a SAX pipeline."
NSQ_SOURCE_LINE 00002047 ""
NSQ_SOURCE_LINE 00002048 "=head2 XMLin()"
NSQ_SOURCE_LINE 00002049 ""
NSQ_SOURCE_LINE 00002050 "Parses XML formatted data and returns a reference to a data structure which"
NSQ_SOURCE_LINE 00002051 "contains the same information in a more readily accessible form.  (Skip"
NSQ_SOURCE_LINE 00002052 "down to L<\"EXAMPLES\"> below, for more sample code)."
NSQ_SOURCE_LINE 00002053 ""
NSQ_SOURCE_LINE 00002054 "C<XMLin()> accepts an optional XML specifier followed by zero or more 'name =>"
NSQ_SOURCE_LINE 00002055 "value' option pairs.  The XML specifier can be one of the following:"
NSQ_SOURCE_LINE 00002056 ""
NSQ_SOURCE_LINE 00002057 "=over 4"
NSQ_SOURCE_LINE 00002058 ""
NSQ_SOURCE_LINE 00002059 "=item A filename"
NSQ_SOURCE_LINE 00002060 ""
NSQ_SOURCE_LINE 00002061 "If the filename contains no directory components C<XMLin()> will look for the"
NSQ_SOURCE_LINE 00002062 "file in each directory in the SearchPath (see L<\"OPTIONS\"> below) or in the"
NSQ_SOURCE_LINE 00002063 "current directory if the SearchPath option is not defined.  eg:"
NSQ_SOURCE_LINE 00002064 ""
NSQ_SOURCE_LINE 00002065 "  $ref = XMLin('/etc/params.xml');"
NSQ_SOURCE_LINE 00002066 ""
NSQ_SOURCE_LINE 00002067 "Note, the filename '-' can be used to parse from STDIN."
NSQ_SOURCE_LINE 00002068 ""
NSQ_SOURCE_LINE 00002069 "=item undef"
NSQ_SOURCE_LINE 00002070 ""
NSQ_SOURCE_LINE 00002071 "If there is no XML specifier, C<XMLin()> will check the script directory and"
NSQ_SOURCE_LINE 00002072 "each of the SearchPath directories for a file with the same name as the script"
NSQ_SOURCE_LINE 00002073 "but with the extension '.xml'.  Note: if you wish to specify options, you"
NSQ_SOURCE_LINE 00002074 "must specify the value 'undef'.  eg:"
NSQ_SOURCE_LINE 00002075 ""
NSQ_SOURCE_LINE 00002076 "  $ref = XMLin(undef, ForceArray => 1);"
NSQ_SOURCE_LINE 00002077 ""
NSQ_SOURCE_LINE 00002078 "=item A string of XML"
NSQ_SOURCE_LINE 00002079 ""
NSQ_SOURCE_LINE 00002080 "A string containing XML (recognised by the presence of '<' and '>' characters)"
NSQ_SOURCE_LINE 00002081 "will be parsed directly.  eg:"
NSQ_SOURCE_LINE 00002082 ""
NSQ_SOURCE_LINE 00002083 "  $ref = XMLin('<opt username=\"bob\" password=\"flurp\" />');"
NSQ_SOURCE_LINE 00002084 ""
NSQ_SOURCE_LINE 00002085 "=item An IO::Handle object"
NSQ_SOURCE_LINE 00002086 ""
NSQ_SOURCE_LINE 00002087 "An IO::Handle object will be read to EOF and its contents parsed. eg:"
NSQ_SOURCE_LINE 00002088 ""
NSQ_SOURCE_LINE 00002089 "  $fh = IO::File->new('/etc/params.xml');"
NSQ_SOURCE_LINE 00002090 "  $ref = XMLin($fh);"
NSQ_SOURCE_LINE 00002091 ""
NSQ_SOURCE_LINE 00002092 "=back"
NSQ_SOURCE_LINE 00002093 ""
NSQ_SOURCE_LINE 00002094 "=head2 XMLout()"
NSQ_SOURCE_LINE 00002095 ""
NSQ_SOURCE_LINE 00002096 "Takes a data structure (generally a hashref) and returns an XML encoding of"
NSQ_SOURCE_LINE 00002097 "that structure.  If the resulting XML is parsed using C<XMLin()>, it should"
NSQ_SOURCE_LINE 00002098 "return a data structure equivalent to the original (see caveats below)."
NSQ_SOURCE_LINE 00002099 ""
NSQ_SOURCE_LINE 00002100 "The C<XMLout()> function can also be used to output the XML as SAX events"
NSQ_SOURCE_LINE 00002101 "see the C<Handler> option and L<\"SAX SUPPORT\"> for more details)."
NSQ_SOURCE_LINE 00002102 ""
NSQ_SOURCE_LINE 00002103 "When translating hashes to XML, hash keys which have a leading '-' will be"
NSQ_SOURCE_LINE 00002104 "silently skipped.  This is the approved method for marking elements of a"
NSQ_SOURCE_LINE 00002105 "data structure which should be ignored by C<XMLout>.  (Note: If these items"
NSQ_SOURCE_LINE 00002106 "were not skipped the key names would be emitted as element or attribute names"
NSQ_SOURCE_LINE 00002107 "with a leading '-' which would not be valid XML)."
NSQ_SOURCE_LINE 00002108 ""
NSQ_SOURCE_LINE 00002109 "=head2 Caveats"
NSQ_SOURCE_LINE 00002110 ""
NSQ_SOURCE_LINE 00002111 "Some care is required in creating data structures which will be passed to"
NSQ_SOURCE_LINE 00002112 "C<XMLout()>.  Hash keys from the data structure will be encoded as either XML"
NSQ_SOURCE_LINE 00002113 "element names or attribute names.  Therefore, you should use hash key names"
NSQ_SOURCE_LINE 00002114 "which conform to the relatively strict XML naming rules:"
NSQ_SOURCE_LINE 00002115 ""
NSQ_SOURCE_LINE 00002116 "Names in XML must begin with a letter.  The remaining characters may be"
NSQ_SOURCE_LINE 00002117 "letters, digits, hyphens (-), underscores (_) or full stops (.).  It is also"
NSQ_SOURCE_LINE 00002118 "allowable to include one colon (:) in an element name but this should only be"
NSQ_SOURCE_LINE 00002119 "used when working with namespaces (B<XML::Simple> can only usefully work with"
NSQ_SOURCE_LINE 00002120 "namespaces when teamed with a SAX Parser)."
NSQ_SOURCE_LINE 00002121 ""
NSQ_SOURCE_LINE 00002122 "You can use other punctuation characters in hash values (just not in hash"
NSQ_SOURCE_LINE 00002123 "keys) however B<XML::Simple> does not support dumping binary data."
NSQ_SOURCE_LINE 00002124 ""
NSQ_SOURCE_LINE 00002125 "If you break these rules, the current implementation of C<XMLout()> will"
NSQ_SOURCE_LINE 00002126 "simply emit non-compliant XML which will be rejected if you try to read it"
NSQ_SOURCE_LINE 00002127 "back in.  (A later version of B<XML::Simple> might take a more proactive"
NSQ_SOURCE_LINE 00002128 "approach)."
NSQ_SOURCE_LINE 00002129 ""
NSQ_SOURCE_LINE 00002130 "Note also that although you can nest hashes and arrays to arbitrary levels,"
NSQ_SOURCE_LINE 00002131 "circular data structures are not supported and will cause C<XMLout()> to die."
NSQ_SOURCE_LINE 00002132 ""
NSQ_SOURCE_LINE 00002133 "If you wish to 'round-trip' arbitrary data structures from Perl to XML and back"
NSQ_SOURCE_LINE 00002134 "to Perl, then you should probably disable array folding (using the KeyAttr"
NSQ_SOURCE_LINE 00002135 "option) both with C<XMLout()> and with C<XMLin()>.  If you still don't get the"
NSQ_SOURCE_LINE 00002136 "expected results, you may prefer to use L<XML::Dumper> which is designed for"
NSQ_SOURCE_LINE 00002137 "exactly that purpose."
NSQ_SOURCE_LINE 00002138 ""
NSQ_SOURCE_LINE 00002139 "Refer to L<\"WHERE TO FROM HERE?\"> if C<XMLout()> is too simple for your needs."
NSQ_SOURCE_LINE 00002140 ""
NSQ_SOURCE_LINE 00002141 ""
NSQ_SOURCE_LINE 00002142 "=head1 OPTIONS"
NSQ_SOURCE_LINE 00002143 ""
NSQ_SOURCE_LINE 00002144 "B<XML::Simple> supports a number of options (in fact as each release of"
NSQ_SOURCE_LINE 00002145 "B<XML::Simple> adds more options, the module's claim to the name 'Simple'"
NSQ_SOURCE_LINE 00002146 "becomes increasingly tenuous).  If you find yourself repeatedly having to"
NSQ_SOURCE_LINE 00002147 "specify the same options, you might like to investigate L<\"OPTIONAL OO"
NSQ_SOURCE_LINE 00002148 "INTERFACE\"> below."
NSQ_SOURCE_LINE 00002149 ""
NSQ_SOURCE_LINE 00002150 "If you can't be bothered reading the documentation, refer to"
NSQ_SOURCE_LINE 00002151 "L<\"STRICT MODE\"> to automatically catch common mistakes."
NSQ_SOURCE_LINE 00002152 ""
NSQ_SOURCE_LINE 00002153 "Because there are so many options, it's hard for new users to know which ones"
NSQ_SOURCE_LINE 00002154 "are important, so here are the two you really need to know about:"
NSQ_SOURCE_LINE 00002155 ""
NSQ_SOURCE_LINE 00002156 "=over 4"
NSQ_SOURCE_LINE 00002157 ""
NSQ_SOURCE_LINE 00002158 "=item *"
NSQ_SOURCE_LINE 00002159 ""
NSQ_SOURCE_LINE 00002160 "check out C<ForceArray> because you'll almost certainly want to turn it on"
NSQ_SOURCE_LINE 00002161 ""
NSQ_SOURCE_LINE 00002162 "=item *"
NSQ_SOURCE_LINE 00002163 ""
NSQ_SOURCE_LINE 00002164 "make sure you know what the C<KeyAttr> option does and what its default value is"
NSQ_SOURCE_LINE 00002165 "because it may surprise you otherwise (note in particular that 'KeyAttr'"
NSQ_SOURCE_LINE 00002166 "affects both C<XMLin> and C<XMLout>)"
NSQ_SOURCE_LINE 00002167 ""
NSQ_SOURCE_LINE 00002168 "=back"
NSQ_SOURCE_LINE 00002169 ""
NSQ_SOURCE_LINE 00002170 "The option name headings below have a trailing 'comment' - a hash followed by"
NSQ_SOURCE_LINE 00002171 "two pieces of metadata:"
NSQ_SOURCE_LINE 00002172 ""
NSQ_SOURCE_LINE 00002173 "=over 4"
NSQ_SOURCE_LINE 00002174 ""
NSQ_SOURCE_LINE 00002175 "=item *"
NSQ_SOURCE_LINE 00002176 ""
NSQ_SOURCE_LINE 00002177 "Options are marked with 'I<in>' if they are recognised by C<XMLin()> and"
NSQ_SOURCE_LINE 00002178 "'I<out>' if they are recognised by C<XMLout()>."
NSQ_SOURCE_LINE 00002179 ""
NSQ_SOURCE_LINE 00002180 "=item *"
NSQ_SOURCE_LINE 00002181 ""
NSQ_SOURCE_LINE 00002182 "Each option is also flagged to indicate whether it is:"
NSQ_SOURCE_LINE 00002183 ""
NSQ_SOURCE_LINE 00002184 " 'important'   - don't use the module until you understand this one"
NSQ_SOURCE_LINE 00002185 " 'handy'       - you can skip this on the first time through"
NSQ_SOURCE_LINE 00002186 " 'advanced'    - you can skip this on the second time through"
NSQ_SOURCE_LINE 00002187 " 'SAX only'    - don't worry about this unless you're using SAX (or"
NSQ_SOURCE_LINE 00002188 "                 alternatively if you need this, you also need SAX)"
NSQ_SOURCE_LINE 00002189 " 'seldom used' - you'll probably never use this unless you were the"
NSQ_SOURCE_LINE 00002190 "                 person that requested the feature"
NSQ_SOURCE_LINE 00002191 ""
NSQ_SOURCE_LINE 00002192 "=back"
NSQ_SOURCE_LINE 00002193 ""
NSQ_SOURCE_LINE 00002194 "The options are listed alphabetically:"
NSQ_SOURCE_LINE 00002195 ""
NSQ_SOURCE_LINE 00002196 "Note: option names are no longer case sensitive so you can use the mixed case"
NSQ_SOURCE_LINE 00002197 "versions shown here; all lower case as required by versions 2.03 and earlier;"
NSQ_SOURCE_LINE 00002198 "or you can add underscores between the words (eg: key_attr)."
NSQ_SOURCE_LINE 00002199 ""
NSQ_SOURCE_LINE 00002200 ""
NSQ_SOURCE_LINE 00002201 "=head2 AttrIndent => 1 I<# out - handy>"
NSQ_SOURCE_LINE 00002202 ""
NSQ_SOURCE_LINE 00002203 "When you are using C<XMLout()>, enable this option to have attributes printed"
NSQ_SOURCE_LINE 00002204 "one-per-line with sensible indentation rather than all on one line."
NSQ_SOURCE_LINE 00002205 ""
NSQ_SOURCE_LINE 00002206 "=head2 Cache => [ cache schemes ] I<# in - advanced>"
NSQ_SOURCE_LINE 00002207 ""
NSQ_SOURCE_LINE 00002208 "Because loading the B<XML::Parser> module and parsing an XML file can consume a"
NSQ_SOURCE_LINE 00002209 "significant number of CPU cycles, it is often desirable to cache the output of"
NSQ_SOURCE_LINE 00002210 "C<XMLin()> for later reuse."
NSQ_SOURCE_LINE 00002211 ""
NSQ_SOURCE_LINE 00002212 "When parsing from a named file, B<XML::Simple> supports a number of caching"
NSQ_SOURCE_LINE 00002213 "schemes.  The 'Cache' option may be used to specify one or more schemes (using"
NSQ_SOURCE_LINE 00002214 "an anonymous array).  Each scheme will be tried in turn in the hope of finding"
NSQ_SOURCE_LINE 00002215 "a cached pre-parsed representation of the XML file.  If no cached copy is"
NSQ_SOURCE_LINE 00002216 "found, the file will be parsed and the first cache scheme in the list will be"
NSQ_SOURCE_LINE 00002217 "used to save a copy of the results.  The following cache schemes have been"
NSQ_SOURCE_LINE 00002218 "implemented:"
NSQ_SOURCE_LINE 00002219 ""
NSQ_SOURCE_LINE 00002220 "=over 4"
NSQ_SOURCE_LINE 00002221 ""
NSQ_SOURCE_LINE 00002222 "=item storable"
NSQ_SOURCE_LINE 00002223 ""
NSQ_SOURCE_LINE 00002224 "Utilises B<Storable.pm> to read/write a cache file with the same name as the"
NSQ_SOURCE_LINE 00002225 "XML file but with the extension .stor"
NSQ_SOURCE_LINE 00002226 ""
NSQ_SOURCE_LINE 00002227 "=item memshare"
NSQ_SOURCE_LINE 00002228 ""
NSQ_SOURCE_LINE 00002229 "When a file is first parsed, a copy of the resulting data structure is retained"
NSQ_SOURCE_LINE 00002230 "in memory in the B<XML::Simple> module's namespace.  Subsequent calls to parse"
NSQ_SOURCE_LINE 00002231 "the same file will return a reference to this structure.  This cached version"
NSQ_SOURCE_LINE 00002232 "will persist only for the life of the Perl interpreter (which in the case of"
NSQ_SOURCE_LINE 00002233 "mod_perl for example, may be some significant time)."
NSQ_SOURCE_LINE 00002234 ""
NSQ_SOURCE_LINE 00002235 "Because each caller receives a reference to the same data structure, a change"
NSQ_SOURCE_LINE 00002236 "made by one caller will be visible to all.  For this reason, the reference"
NSQ_SOURCE_LINE 00002237 "returned should be treated as read-only."
NSQ_SOURCE_LINE 00002238 ""
NSQ_SOURCE_LINE 00002239 "=item memcopy"
NSQ_SOURCE_LINE 00002240 ""
NSQ_SOURCE_LINE 00002241 "This scheme works identically to 'memshare' (above) except that each caller"
NSQ_SOURCE_LINE 00002242 "receives a reference to a new data structure which is a copy of the cached"
NSQ_SOURCE_LINE 00002243 "version.  Copying the data structure will add a little processing overhead,"
NSQ_SOURCE_LINE 00002244 "therefore this scheme should only be used where the caller intends to modify"
NSQ_SOURCE_LINE 00002245 "the data structure (or wishes to protect itself from others who might).  This"
NSQ_SOURCE_LINE 00002246 "scheme uses B<Storable.pm> to perform the copy."
NSQ_SOURCE_LINE 00002247 ""
NSQ_SOURCE_LINE 00002248 "=back"
NSQ_SOURCE_LINE 00002249 ""
NSQ_SOURCE_LINE 00002250 "Warning! The memory-based caching schemes compare the timestamp on the file to"
NSQ_SOURCE_LINE 00002251 "the time when it was last parsed.  If the file is stored on an NFS filesystem"
NSQ_SOURCE_LINE 00002252 "(or other network share) and the clock on the file server is not exactly"
NSQ_SOURCE_LINE 00002253 "synchronised with the clock where your script is run, updates to the source XML"
NSQ_SOURCE_LINE 00002254 "file may appear to be ignored."
NSQ_SOURCE_LINE 00002255 ""
NSQ_SOURCE_LINE 00002256 "=head2 ContentKey => 'keyname' I<# in+out - seldom used>"
NSQ_SOURCE_LINE 00002257 ""
NSQ_SOURCE_LINE 00002258 "When text content is parsed to a hash value, this option lets you specify a"
NSQ_SOURCE_LINE 00002259 "name for the hash key to override the default 'content'.  So for example:"
NSQ_SOURCE_LINE 00002260 ""
NSQ_SOURCE_LINE 00002261 "  XMLin('<opt one=\"1\">Text</opt>', ContentKey => 'text')"
NSQ_SOURCE_LINE 00002262 ""
NSQ_SOURCE_LINE 00002263 "will parse to:"
NSQ_SOURCE_LINE 00002264 ""
NSQ_SOURCE_LINE 00002265 "  { 'one' => 1, 'text' => 'Text' }"
NSQ_SOURCE_LINE 00002266 ""
NSQ_SOURCE_LINE 00002267 "instead of:"
NSQ_SOURCE_LINE 00002268 ""
NSQ_SOURCE_LINE 00002269 "  { 'one' => 1, 'content' => 'Text' }"
NSQ_SOURCE_LINE 00002270 ""
NSQ_SOURCE_LINE 00002271 "C<XMLout()> will also honour the value of this option when converting a hashref"
NSQ_SOURCE_LINE 00002272 "to XML."
NSQ_SOURCE_LINE 00002273 ""
NSQ_SOURCE_LINE 00002274 "You can also prefix your selected key name with a '-' character to have"
NSQ_SOURCE_LINE 00002275 "C<XMLin()> try a little harder to eliminate unnecessary 'content' keys after"
NSQ_SOURCE_LINE 00002276 "array folding.  For example:"
NSQ_SOURCE_LINE 00002277 ""
NSQ_SOURCE_LINE 00002278 "  XMLin("
NSQ_SOURCE_LINE 00002279 "    '<opt><item name=\"one\">First</item><item name=\"two\">Second</item></opt>',"
NSQ_SOURCE_LINE 00002280 "    KeyAttr => {item => 'name'},"
NSQ_SOURCE_LINE 00002281 "    ForceArray => [ 'item' ],"
NSQ_SOURCE_LINE 00002282 "    ContentKey => '-content'"
NSQ_SOURCE_LINE 00002283 "  )"
NSQ_SOURCE_LINE 00002284 ""
NSQ_SOURCE_LINE 00002285 "will parse to:"
NSQ_SOURCE_LINE 00002286 ""
NSQ_SOURCE_LINE 00002287 "  {"
NSQ_SOURCE_LINE 00002288 "    'item' => {"
NSQ_SOURCE_LINE 00002289 "      'one' =>  'First'"
NSQ_SOURCE_LINE 00002290 "      'two' =>  'Second'"
NSQ_SOURCE_LINE 00002291 "    }"
NSQ_SOURCE_LINE 00002292 "  }"
NSQ_SOURCE_LINE 00002293 ""
NSQ_SOURCE_LINE 00002294 "rather than this (without the '-'):"
NSQ_SOURCE_LINE 00002295 ""
NSQ_SOURCE_LINE 00002296 "  {"
NSQ_SOURCE_LINE 00002297 "    'item' => {"
NSQ_SOURCE_LINE 00002298 "      'one' => { 'content' => 'First' }"
NSQ_SOURCE_LINE 00002299 "      'two' => { 'content' => 'Second' }"
NSQ_SOURCE_LINE 00002300 "    }"
NSQ_SOURCE_LINE 00002301 "  }"
NSQ_SOURCE_LINE 00002302 ""
NSQ_SOURCE_LINE 00002303 "=head2 DataHandler => code_ref I<# in - SAX only>"
NSQ_SOURCE_LINE 00002304 ""
NSQ_SOURCE_LINE 00002305 "When you use an B<XML::Simple> object as a SAX handler, it will return a"
NSQ_SOURCE_LINE 00002306 "'simple tree' data structure in the same format as C<XMLin()> would return.  If"
NSQ_SOURCE_LINE 00002307 "this option is set (to a subroutine reference), then when the tree is built the"
NSQ_SOURCE_LINE 00002308 "subroutine will be called and passed two arguments: a reference to the"
NSQ_SOURCE_LINE 00002309 "B<XML::Simple> object and a reference to the data tree.  The return value from"
NSQ_SOURCE_LINE 00002310 "the subroutine will be returned to the SAX driver.  (See L<\"SAX SUPPORT\"> for"
NSQ_SOURCE_LINE 00002311 "more details)."
NSQ_SOURCE_LINE 00002312 ""
NSQ_SOURCE_LINE 00002313 "=head2 ForceArray => 1 I<# in - important>"
NSQ_SOURCE_LINE 00002314 ""
NSQ_SOURCE_LINE 00002315 "This option should be set to '1' to force nested elements to be represented"
NSQ_SOURCE_LINE 00002316 "as arrays even when there is only one.  Eg, with ForceArray enabled, this"
NSQ_SOURCE_LINE 00002317 "XML:"
NSQ_SOURCE_LINE 00002318 ""
NSQ_SOURCE_LINE 00002319 "    <opt>"
NSQ_SOURCE_LINE 00002320 "      <name>value</name>"
NSQ_SOURCE_LINE 00002321 "    </opt>"
NSQ_SOURCE_LINE 00002322 ""
NSQ_SOURCE_LINE 00002323 "would parse to this:"
NSQ_SOURCE_LINE 00002324 ""
NSQ_SOURCE_LINE 00002325 "    {"
NSQ_SOURCE_LINE 00002326 "      'name' => ["
NSQ_SOURCE_LINE 00002327 "                  'value'"
NSQ_SOURCE_LINE 00002328 "                ]"
NSQ_SOURCE_LINE 00002329 "    }"
NSQ_SOURCE_LINE 00002330 ""
NSQ_SOURCE_LINE 00002331 "instead of this (the default):"
NSQ_SOURCE_LINE 00002332 ""
NSQ_SOURCE_LINE 00002333 "    {"
NSQ_SOURCE_LINE 00002334 "      'name' => 'value'"
NSQ_SOURCE_LINE 00002335 "    }"
NSQ_SOURCE_LINE 00002336 ""
NSQ_SOURCE_LINE 00002337 "This option is especially useful if the data structure is likely to be written"
NSQ_SOURCE_LINE 00002338 "back out as XML and the default behaviour of rolling single nested elements up"
NSQ_SOURCE_LINE 00002339 "into attributes is not desirable."
NSQ_SOURCE_LINE 00002340 ""
NSQ_SOURCE_LINE 00002341 "If you are using the array folding feature, you should almost certainly enable"
NSQ_SOURCE_LINE 00002342 "this option.  If you do not, single nested elements will not be parsed to"
NSQ_SOURCE_LINE 00002343 "arrays and therefore will not be candidates for folding to a hash.  (Given that"
NSQ_SOURCE_LINE 00002344 "the default value of 'KeyAttr' enables array folding, the default value of this"
NSQ_SOURCE_LINE 00002345 "option should probably also have been enabled too - sorry)."
NSQ_SOURCE_LINE 00002346 ""
NSQ_SOURCE_LINE 00002347 "=head2 ForceArray => [ names ] I<# in - important>"
NSQ_SOURCE_LINE 00002348 ""
NSQ_SOURCE_LINE 00002349 "This alternative (and preferred) form of the 'ForceArray' option allows you to"
NSQ_SOURCE_LINE 00002350 "specify a list of element names which should always be forced into an array"
NSQ_SOURCE_LINE 00002351 "representation, rather than the 'all or nothing' approach above."
NSQ_SOURCE_LINE 00002352 ""
NSQ_SOURCE_LINE 00002353 "It is also possible (since version 2.05) to include compiled regular"
NSQ_SOURCE_LINE 00002354 "expressions in the list - any element names which match the pattern will be"
NSQ_SOURCE_LINE 00002355 "forced to arrays.  If the list contains only a single regex, then it is not"
NSQ_SOURCE_LINE 00002356 "necessary to enclose it in an arrayref.  Eg:"
NSQ_SOURCE_LINE 00002357 ""
NSQ_SOURCE_LINE 00002358 "  ForceArray => qr/_list$/"
NSQ_SOURCE_LINE 00002359 ""
NSQ_SOURCE_LINE 00002360 "=head2 ForceContent => 1 I<# in - seldom used>"
NSQ_SOURCE_LINE 00002361 ""
NSQ_SOURCE_LINE 00002362 "When C<XMLin()> parses elements which have text content as well as attributes,"
NSQ_SOURCE_LINE 00002363 "the text content must be represented as a hash value rather than a simple"
NSQ_SOURCE_LINE 00002364 "scalar.  This option allows you to force text content to always parse to"
NSQ_SOURCE_LINE 00002365 "a hash value even when there are no attributes.  So for example:"
NSQ_SOURCE_LINE 00002366 ""
NSQ_SOURCE_LINE 00002367 "  XMLin('<opt><x>text1</x><y a=\"2\">text2</y></opt>', ForceContent => 1)"
NSQ_SOURCE_LINE 00002368 ""
NSQ_SOURCE_LINE 00002369 "will parse to:"
NSQ_SOURCE_LINE 00002370 ""
NSQ_SOURCE_LINE 00002371 "  {"
NSQ_SOURCE_LINE 00002372 "    'x' => {           'content' => 'text1' },"
NSQ_SOURCE_LINE 00002373 "    'y' => { 'a' => 2, 'content' => 'text2' }"
NSQ_SOURCE_LINE 00002374 "  }"
NSQ_SOURCE_LINE 00002375 ""
NSQ_SOURCE_LINE 00002376 "instead of:"
NSQ_SOURCE_LINE 00002377 ""
NSQ_SOURCE_LINE 00002378 "  {"
NSQ_SOURCE_LINE 00002379 "    'x' => 'text1',"
NSQ_SOURCE_LINE 00002380 "    'y' => { 'a' => 2, 'content' => 'text2' }"
NSQ_SOURCE_LINE 00002381 "  }"
NSQ_SOURCE_LINE 00002382 ""
NSQ_SOURCE_LINE 00002383 "=head2 GroupTags => { grouping tag => grouped tag } I<# in+out - handy>"
NSQ_SOURCE_LINE 00002384 ""
NSQ_SOURCE_LINE 00002385 "You can use this option to eliminate extra levels of indirection in your Perl"
NSQ_SOURCE_LINE 00002386 "data structure.  For example this XML:"
NSQ_SOURCE_LINE 00002387 ""
NSQ_SOURCE_LINE 00002388 "  <opt>"
NSQ_SOURCE_LINE 00002389 "   <searchpath>"
NSQ_SOURCE_LINE 00002390 "     <dir>/usr/bin</dir>"
NSQ_SOURCE_LINE 00002391 "     <dir>/usr/local/bin</dir>"
NSQ_SOURCE_LINE 00002392 "     <dir>/usr/X11/bin</dir>"
NSQ_SOURCE_LINE 00002393 "   </searchpath>"
NSQ_SOURCE_LINE 00002394 " </opt>"
NSQ_SOURCE_LINE 00002395 ""
NSQ_SOURCE_LINE 00002396 "Would normally be read into a structure like this:"
NSQ_SOURCE_LINE 00002397 ""
NSQ_SOURCE_LINE 00002398 "  {"
NSQ_SOURCE_LINE 00002399 "    searchpath => {"
NSQ_SOURCE_LINE 00002400 "                    dir => [ '/usr/bin', '/usr/local/bin', '/usr/X11/bin' ]"
NSQ_SOURCE_LINE 00002401 "                  }"
NSQ_SOURCE_LINE 00002402 "  }"
NSQ_SOURCE_LINE 00002403 ""
NSQ_SOURCE_LINE 00002404 "But when read in with the appropriate value for 'GroupTags':"
NSQ_SOURCE_LINE 00002405 ""
NSQ_SOURCE_LINE 00002406 "  my $opt = XMLin($xml, GroupTags => { searchpath => 'dir' });"
NSQ_SOURCE_LINE 00002407 ""
NSQ_SOURCE_LINE 00002408 "It will return this simpler structure:"
NSQ_SOURCE_LINE 00002409 ""
NSQ_SOURCE_LINE 00002410 "  {"
NSQ_SOURCE_LINE 00002411 "    searchpath => [ '/usr/bin', '/usr/local/bin', '/usr/X11/bin' ]"
NSQ_SOURCE_LINE 00002412 "  }"
NSQ_SOURCE_LINE 00002413 ""
NSQ_SOURCE_LINE 00002414 "The grouping element (C<< <searchpath> >> in the example) must not contain any"
NSQ_SOURCE_LINE 00002415 "attributes or elements other than the grouped element."
NSQ_SOURCE_LINE 00002416 ""
NSQ_SOURCE_LINE 00002417 "You can specify multiple 'grouping element' to 'grouped element' mappings in"
NSQ_SOURCE_LINE 00002418 "the same hashref.  If this option is combined with C<KeyAttr>, the array"
NSQ_SOURCE_LINE 00002419 "folding will occur first and then the grouped element names will be eliminated."
NSQ_SOURCE_LINE 00002420 ""
NSQ_SOURCE_LINE 00002421 "C<XMLout> will also use the grouptag mappings to re-introduce the tags around"
NSQ_SOURCE_LINE 00002422 "the grouped elements.  Beware though that this will occur in all places that"
NSQ_SOURCE_LINE 00002423 "the 'grouping tag' name occurs - you probably don't want to use the same name"
NSQ_SOURCE_LINE 00002424 "for elements as well as attributes."
NSQ_SOURCE_LINE 00002425 ""
NSQ_SOURCE_LINE 00002426 "=head2 Handler => object_ref I<# out - SAX only>"
NSQ_SOURCE_LINE 00002427 ""
NSQ_SOURCE_LINE 00002428 "Use the 'Handler' option to have C<XMLout()> generate SAX events rather than"
NSQ_SOURCE_LINE 00002429 "returning a string of XML.  For more details see L<\"SAX SUPPORT\"> below."
NSQ_SOURCE_LINE 00002430 ""
NSQ_SOURCE_LINE 00002431 "Note: the current implementation of this option generates a string of XML"
NSQ_SOURCE_LINE 00002432 "and uses a SAX parser to translate it into SAX events.  The normal encoding"
NSQ_SOURCE_LINE 00002433 "rules apply here - your data must be UTF8 encoded unless you specify an"
NSQ_SOURCE_LINE 00002434 "alternative encoding via the 'XMLDecl' option; and by the time the data reaches"
NSQ_SOURCE_LINE 00002435 "the handler object, it will be in UTF8 form regardless of the encoding you"
NSQ_SOURCE_LINE 00002436 "supply.  A future implementation of this option may generate the events"
NSQ_SOURCE_LINE 00002437 "directly."
NSQ_SOURCE_LINE 00002438 ""
NSQ_SOURCE_LINE 00002439 "=head2 KeepRoot => 1 I<# in+out - handy>"
NSQ_SOURCE_LINE 00002440 ""
NSQ_SOURCE_LINE 00002441 "In its attempt to return a data structure free of superfluous detail and"
NSQ_SOURCE_LINE 00002442 "unnecessary levels of indirection, C<XMLin()> normally discards the root"
NSQ_SOURCE_LINE 00002443 "element name.  Setting the 'KeepRoot' option to '1' will cause the root element"
NSQ_SOURCE_LINE 00002444 "name to be retained.  So after executing this code:"
NSQ_SOURCE_LINE 00002445 ""
NSQ_SOURCE_LINE 00002446 "  $config = XMLin('<config tempdir=\"/tmp\" />', KeepRoot => 1)"
NSQ_SOURCE_LINE 00002447 ""
NSQ_SOURCE_LINE 00002448 "You'll be able to reference the tempdir as"
NSQ_SOURCE_LINE 00002449 "C<$config-E<gt>{config}-E<gt>{tempdir}> instead of the default"
NSQ_SOURCE_LINE 00002450 "C<$config-E<gt>{tempdir}>."
NSQ_SOURCE_LINE 00002451 ""
NSQ_SOURCE_LINE 00002452 "Similarly, setting the 'KeepRoot' option to '1' will tell C<XMLout()> that the"
NSQ_SOURCE_LINE 00002453 "data structure already contains a root element name and it is not necessary to"
NSQ_SOURCE_LINE 00002454 "add another."
NSQ_SOURCE_LINE 00002455 ""
NSQ_SOURCE_LINE 00002456 "=head2 KeyAttr => [ list ] I<# in+out - important>"
NSQ_SOURCE_LINE 00002457 ""
NSQ_SOURCE_LINE 00002458 "This option controls the 'array folding' feature which translates nested"
NSQ_SOURCE_LINE 00002459 "elements from an array to a hash.  It also controls the 'unfolding' of hashes"
NSQ_SOURCE_LINE 00002460 "to arrays."
NSQ_SOURCE_LINE 00002461 ""
NSQ_SOURCE_LINE 00002462 "For example, this XML:"
NSQ_SOURCE_LINE 00002463 ""
NSQ_SOURCE_LINE 00002464 "    <opt>"
NSQ_SOURCE_LINE 00002465 "      <user login=\"grep\" fullname=\"Gary R Epstein\" />"
NSQ_SOURCE_LINE 00002466 "      <user login=\"stty\" fullname=\"Simon T Tyson\" />"
NSQ_SOURCE_LINE 00002467 "    </opt>"
NSQ_SOURCE_LINE 00002468 ""
NSQ_SOURCE_LINE 00002469 "would, by default, parse to this:"
NSQ_SOURCE_LINE 00002470 ""
NSQ_SOURCE_LINE 00002471 "    {"
NSQ_SOURCE_LINE 00002472 "      'user' => ["
NSQ_SOURCE_LINE 00002473 "                  {"
NSQ_SOURCE_LINE 00002474 "                    'login' => 'grep',"
NSQ_SOURCE_LINE 00002475 "                    'fullname' => 'Gary R Epstein'"
NSQ_SOURCE_LINE 00002476 "                  },"
NSQ_SOURCE_LINE 00002477 "                  {"
NSQ_SOURCE_LINE 00002478 "                    'login' => 'stty',"
NSQ_SOURCE_LINE 00002479 "                    'fullname' => 'Simon T Tyson'"
NSQ_SOURCE_LINE 00002480 "                  }"
NSQ_SOURCE_LINE 00002481 "                ]"
NSQ_SOURCE_LINE 00002482 "    }"
NSQ_SOURCE_LINE 00002483 ""
NSQ_SOURCE_LINE 00002484 "If the option 'KeyAttr => \"login\"' were used to specify that the 'login'"
NSQ_SOURCE_LINE 00002485 "attribute is a key, the same XML would parse to:"
NSQ_SOURCE_LINE 00002486 ""
NSQ_SOURCE_LINE 00002487 "    {"
NSQ_SOURCE_LINE 00002488 "      'user' => {"
NSQ_SOURCE_LINE 00002489 "                  'stty' => {"
NSQ_SOURCE_LINE 00002490 "                              'fullname' => 'Simon T Tyson'"
NSQ_SOURCE_LINE 00002491 "                            },"
NSQ_SOURCE_LINE 00002492 "                  'grep' => {"
NSQ_SOURCE_LINE 00002493 "                              'fullname' => 'Gary R Epstein'"
NSQ_SOURCE_LINE 00002494 "                            }"
NSQ_SOURCE_LINE 00002495 "                }"
NSQ_SOURCE_LINE 00002496 "    }"
NSQ_SOURCE_LINE 00002497 ""
NSQ_SOURCE_LINE 00002498 "The key attribute names should be supplied in an arrayref if there is more"
NSQ_SOURCE_LINE 00002499 "than one.  C<XMLin()> will attempt to match attribute names in the order"
NSQ_SOURCE_LINE 00002500 "supplied.  C<XMLout()> will use the first attribute name supplied when"
NSQ_SOURCE_LINE 00002501 "'unfolding' a hash into an array."
NSQ_SOURCE_LINE 00002502 ""
NSQ_SOURCE_LINE 00002503 "Note 1: The default value for 'KeyAttr' is ['name', 'key', 'id'].  If you do"
NSQ_SOURCE_LINE 00002504 "not want folding on input or unfolding on output you must set this option"
NSQ_SOURCE_LINE 00002505 "to an empty list to disable the feature."
NSQ_SOURCE_LINE 00002506 ""
NSQ_SOURCE_LINE 00002507 "Note 2: If you wish to use this option, you should also enable the"
NSQ_SOURCE_LINE 00002508 "C<ForceArray> option.  Without 'ForceArray', a single nested element will be"
NSQ_SOURCE_LINE 00002509 "rolled up into a scalar rather than an array and therefore will not be folded"
NSQ_SOURCE_LINE 00002510 "(since only arrays get folded)."
NSQ_SOURCE_LINE 00002511 ""
NSQ_SOURCE_LINE 00002512 "=head2 KeyAttr => { list } I<# in+out - important>"
NSQ_SOURCE_LINE 00002513 ""
NSQ_SOURCE_LINE 00002514 "This alternative (and preferred) method of specifying the key attributes"
NSQ_SOURCE_LINE 00002515 "allows more fine grained control over which elements are folded and on which"
NSQ_SOURCE_LINE 00002516 "attributes.  For example the option 'KeyAttr => { package => 'id' } will cause"
NSQ_SOURCE_LINE 00002517 "any package elements to be folded on the 'id' attribute.  No other elements"
NSQ_SOURCE_LINE 00002518 "which have an 'id' attribute will be folded at all."
NSQ_SOURCE_LINE 00002519 ""
NSQ_SOURCE_LINE 00002520 "Note: C<XMLin()> will generate a warning (or a fatal error in L<\"STRICT MODE\">)"
NSQ_SOURCE_LINE 00002521 "if this syntax is used and an element which does not have the specified key"
NSQ_SOURCE_LINE 00002522 "attribute is encountered (eg: a 'package' element without an 'id' attribute, to"
NSQ_SOURCE_LINE 00002523 "use the example above).  Warnings can be suppressed with the lexical"
NSQ_SOURCE_LINE 00002524 "C<no warnings;> pragma or C<no warnings 'XML::Simple';>."
NSQ_SOURCE_LINE 00002525 ""
NSQ_SOURCE_LINE 00002526 "Two further variations are made possible by prefixing a '+' or a '-' character"
NSQ_SOURCE_LINE 00002527 "to the attribute name:"
NSQ_SOURCE_LINE 00002528 ""
NSQ_SOURCE_LINE 00002529 "The option 'KeyAttr => { user => \"+login\" }' will cause this XML:"
NSQ_SOURCE_LINE 00002530 ""
NSQ_SOURCE_LINE 00002531 "    <opt>"
NSQ_SOURCE_LINE 00002532 "      <user login=\"grep\" fullname=\"Gary R Epstein\" />"
NSQ_SOURCE_LINE 00002533 "      <user login=\"stty\" fullname=\"Simon T Tyson\" />"
NSQ_SOURCE_LINE 00002534 "    </opt>"
NSQ_SOURCE_LINE 00002535 ""
NSQ_SOURCE_LINE 00002536 "to parse to this data structure:"
NSQ_SOURCE_LINE 00002537 ""
NSQ_SOURCE_LINE 00002538 "    {"
NSQ_SOURCE_LINE 00002539 "      'user' => {"
NSQ_SOURCE_LINE 00002540 "                  'stty' => {"
NSQ_SOURCE_LINE 00002541 "                              'fullname' => 'Simon T Tyson',"
NSQ_SOURCE_LINE 00002542 "                              'login'    => 'stty'"
NSQ_SOURCE_LINE 00002543 "                            },"
NSQ_SOURCE_LINE 00002544 "                  'grep' => {"
NSQ_SOURCE_LINE 00002545 "                              'fullname' => 'Gary R Epstein',"
NSQ_SOURCE_LINE 00002546 "                              'login'    => 'grep'"
NSQ_SOURCE_LINE 00002547 "                            }"
NSQ_SOURCE_LINE 00002548 "                }"
NSQ_SOURCE_LINE 00002549 "    }"
NSQ_SOURCE_LINE 00002550 ""
NSQ_SOURCE_LINE 00002551 "The '+' indicates that the value of the key attribute should be copied rather"
NSQ_SOURCE_LINE 00002552 "than moved to the folded hash key."
NSQ_SOURCE_LINE 00002553 ""
NSQ_SOURCE_LINE 00002554 "A '-' prefix would produce this result:"
NSQ_SOURCE_LINE 00002555 ""
NSQ_SOURCE_LINE 00002556 "    {"
NSQ_SOURCE_LINE 00002557 "      'user' => {"
NSQ_SOURCE_LINE 00002558 "                  'stty' => {"
NSQ_SOURCE_LINE 00002559 "                              'fullname' => 'Simon T Tyson',"
NSQ_SOURCE_LINE 00002560 "                              '-login'    => 'stty'"
NSQ_SOURCE_LINE 00002561 "                            },"
NSQ_SOURCE_LINE 00002562 "                  'grep' => {"
NSQ_SOURCE_LINE 00002563 "                              'fullname' => 'Gary R Epstein',"
NSQ_SOURCE_LINE 00002564 "                              '-login'    => 'grep'"
NSQ_SOURCE_LINE 00002565 "                            }"
NSQ_SOURCE_LINE 00002566 "                }"
NSQ_SOURCE_LINE 00002567 "    }"
NSQ_SOURCE_LINE 00002568 ""
NSQ_SOURCE_LINE 00002569 "As described earlier, C<XMLout> will ignore hash keys starting with a '-'."
NSQ_SOURCE_LINE 00002570 ""
NSQ_SOURCE_LINE 00002571 "=head2 NoAttr => 1 I<# in+out - handy>"
NSQ_SOURCE_LINE 00002572 ""
NSQ_SOURCE_LINE 00002573 "When used with C<XMLout()>, the generated XML will contain no attributes."
NSQ_SOURCE_LINE 00002574 "All hash key/values will be represented as nested elements instead."
NSQ_SOURCE_LINE 00002575 ""
NSQ_SOURCE_LINE 00002576 "When used with C<XMLin()>, any attributes in the XML will be ignored."
NSQ_SOURCE_LINE 00002577 ""
NSQ_SOURCE_LINE 00002578 "=head2 NoEscape => 1 I<# out - seldom used>"
NSQ_SOURCE_LINE 00002579 ""
NSQ_SOURCE_LINE 00002580 "By default, C<XMLout()> will translate the characters 'E<lt>', 'E<gt>', '&' and"
NSQ_SOURCE_LINE 00002581 "'\"' to '&lt;', '&gt;', '&amp;' and '&quot' respectively.  Use this option to"
NSQ_SOURCE_LINE 00002582 "suppress escaping (presumably because you've already escaped the data in some"
NSQ_SOURCE_LINE 00002583 "more sophisticated manner)."
NSQ_SOURCE_LINE 00002584 ""
NSQ_SOURCE_LINE 00002585 "=head2 NoIndent => 1 I<# out - seldom used>"
NSQ_SOURCE_LINE 00002586 ""
NSQ_SOURCE_LINE 00002587 "Set this option to 1 to disable C<XMLout()>'s default 'pretty printing' mode."
NSQ_SOURCE_LINE 00002588 "With this option enabled, the XML output will all be on one line (unless there"
NSQ_SOURCE_LINE 00002589 "are newlines in the data) - this may be easier for downstream processing."
NSQ_SOURCE_LINE 00002590 ""
NSQ_SOURCE_LINE 00002591 "=head2 NoSort => 1 I<# out - seldom used>"
NSQ_SOURCE_LINE 00002592 ""
NSQ_SOURCE_LINE 00002593 "Newer versions of XML::Simple sort elements and attributes alphabetically (*),"
NSQ_SOURCE_LINE 00002594 "by default.  Enable this option to suppress the sorting - possibly for"
NSQ_SOURCE_LINE 00002595 "backwards compatibility."
NSQ_SOURCE_LINE 00002596 ""
NSQ_SOURCE_LINE 00002597 "* Actually, sorting is alphabetical but 'key' attribute or element names (as in"
NSQ_SOURCE_LINE 00002598 "'KeyAttr') sort first.  Also, when a hash of hashes is 'unfolded', the elements"
NSQ_SOURCE_LINE 00002599 "are sorted alphabetically by the value of the key field."
NSQ_SOURCE_LINE 00002600 ""
NSQ_SOURCE_LINE 00002601 "=head2 NormaliseSpace => 0 | 1 | 2 I<# in - handy>"
NSQ_SOURCE_LINE 00002602 ""
NSQ_SOURCE_LINE 00002603 "This option controls how whitespace in text content is handled.  Recognised"
NSQ_SOURCE_LINE 00002604 "values for the option are:"
NSQ_SOURCE_LINE 00002605 ""
NSQ_SOURCE_LINE 00002606 "=over 4"
NSQ_SOURCE_LINE 00002607 ""
NSQ_SOURCE_LINE 00002608 "=item *"
NSQ_SOURCE_LINE 00002609 ""
NSQ_SOURCE_LINE 00002610 "0 = (default) whitespace is passed through unaltered (except of course for the"
NSQ_SOURCE_LINE 00002611 "normalisation of whitespace in attribute values which is mandated by the XML"
NSQ_SOURCE_LINE 00002612 "recommendation)"
NSQ_SOURCE_LINE 00002613 ""
NSQ_SOURCE_LINE 00002614 "=item *"
NSQ_SOURCE_LINE 00002615 ""
NSQ_SOURCE_LINE 00002616 "1 = whitespace is normalised in any value used as a hash key (normalising means"
NSQ_SOURCE_LINE 00002617 "removing leading and trailing whitespace and collapsing sequences of whitespace"
NSQ_SOURCE_LINE 00002618 "characters to a single space)"
NSQ_SOURCE_LINE 00002619 ""
NSQ_SOURCE_LINE 00002620 "=item *"
NSQ_SOURCE_LINE 00002621 ""
NSQ_SOURCE_LINE 00002622 "2 = whitespace is normalised in all text content"
NSQ_SOURCE_LINE 00002623 ""
NSQ_SOURCE_LINE 00002624 "=back"
NSQ_SOURCE_LINE 00002625 ""
NSQ_SOURCE_LINE 00002626 "Note: you can spell this option with a 'z' if that is more natural for you."
NSQ_SOURCE_LINE 00002627 ""
NSQ_SOURCE_LINE 00002628 "=head2 NSExpand => 1 I<# in+out handy - SAX only>"
NSQ_SOURCE_LINE 00002629 ""
NSQ_SOURCE_LINE 00002630 "This option controls namespace expansion - the translation of element and"
NSQ_SOURCE_LINE 00002631 "attribute names of the form 'prefix:name' to '{uri}name'.  For example the"
NSQ_SOURCE_LINE 00002632 "element name 'xsl:template' might be expanded to:"
NSQ_SOURCE_LINE 00002633 "'{http://www.w3.org/1999/XSL/Transform}template'."
NSQ_SOURCE_LINE 00002634 ""
NSQ_SOURCE_LINE 00002635 "By default, C<XMLin()> will return element names and attribute names exactly as"
NSQ_SOURCE_LINE 00002636 "they appear in the XML.  Setting this option to 1 will cause all element and"
NSQ_SOURCE_LINE 00002637 "attribute names to be expanded to include their namespace prefix."
NSQ_SOURCE_LINE 00002638 ""
NSQ_SOURCE_LINE 00002639 "I<Note: You must be using a SAX parser for this option to work (ie: it does not"
NSQ_SOURCE_LINE 00002640 "work with XML::Parser)>."
NSQ_SOURCE_LINE 00002641 ""
NSQ_SOURCE_LINE 00002642 "This option also controls whether C<XMLout()> performs the reverse translation"
NSQ_SOURCE_LINE 00002643 "from '{uri}name' back to 'prefix:name'.  The default is no translation.  If"
NSQ_SOURCE_LINE 00002644 "your data contains expanded names, you should set this option to 1 otherwise"
NSQ_SOURCE_LINE 00002645 "C<XMLout> will emit XML which is not well formed."
NSQ_SOURCE_LINE 00002646 ""
NSQ_SOURCE_LINE 00002647 "I<Note: You must have the XML::NamespaceSupport module installed if you want"
NSQ_SOURCE_LINE 00002648 "C<XMLout()> to translate URIs back to prefixes>."
NSQ_SOURCE_LINE 00002649 ""
NSQ_SOURCE_LINE 00002650 "=head2 NumericEscape => 0 | 1 | 2 I<# out - handy>"
NSQ_SOURCE_LINE 00002651 ""
NSQ_SOURCE_LINE 00002652 "Use this option to have 'high' (non-ASCII) characters in your Perl data"
NSQ_SOURCE_LINE 00002653 "structure converted to numeric entities (eg: &#8364;) in the XML output.  Three"
NSQ_SOURCE_LINE 00002654 "levels are possible:"
NSQ_SOURCE_LINE 00002655 ""
NSQ_SOURCE_LINE 00002656 "0 - default: no numeric escaping (OK if you're writing out UTF8)"
NSQ_SOURCE_LINE 00002657 ""
NSQ_SOURCE_LINE 00002658 "1 - only characters above 0xFF are escaped (ie: characters in the 0x80-FF range are not escaped), possibly useful with ISO8859-1 output"
NSQ_SOURCE_LINE 00002659 ""
NSQ_SOURCE_LINE 00002660 "2 - all characters above 0x7F are escaped (good for plain ASCII output)"
NSQ_SOURCE_LINE 00002661 ""
NSQ_SOURCE_LINE 00002662 "=head2 OutputFile => <file specifier> I<# out - handy>"
NSQ_SOURCE_LINE 00002663 ""
NSQ_SOURCE_LINE 00002664 "The default behaviour of C<XMLout()> is to return the XML as a string.  If you"
NSQ_SOURCE_LINE 00002665 "wish to write the XML to a file, simply supply the filename using the"
NSQ_SOURCE_LINE 00002666 "'OutputFile' option."
NSQ_SOURCE_LINE 00002667 ""
NSQ_SOURCE_LINE 00002668 "This option also accepts an IO handle object - especially useful in Perl 5.8.0"
NSQ_SOURCE_LINE 00002669 "and later for output using an encoding other than UTF-8, eg:"
NSQ_SOURCE_LINE 00002670 ""
NSQ_SOURCE_LINE 00002671 "  open my $fh, '>:encoding(iso-8859-1)', $path or die \"open($path): $!\";"
NSQ_SOURCE_LINE 00002672 "  XMLout($ref, OutputFile => $fh);"
NSQ_SOURCE_LINE 00002673 ""
NSQ_SOURCE_LINE 00002674 "Note, XML::Simple does not require that the object you pass in to the"
NSQ_SOURCE_LINE 00002675 "OutputFile option inherits from L<IO::Handle> - it simply assumes the object"
NSQ_SOURCE_LINE 00002676 "supports a C<print> method."
NSQ_SOURCE_LINE 00002677 ""
NSQ_SOURCE_LINE 00002678 "=head2 ParserOpts => [ XML::Parser Options ] I<# in - don't use this>"
NSQ_SOURCE_LINE 00002679 ""
NSQ_SOURCE_LINE 00002680 "I<Note: This option is now officially deprecated.  If you find it useful, email"
NSQ_SOURCE_LINE 00002681 "the author with an example of what you use it for.  Do not use this option to"
NSQ_SOURCE_LINE 00002682 "set the ProtocolEncoding, that's just plain wrong - fix the XML>."
NSQ_SOURCE_LINE 00002683 ""
NSQ_SOURCE_LINE 00002684 "This option allows you to pass parameters to the constructor of the underlying"
NSQ_SOURCE_LINE 00002685 "XML::Parser object (which of course assumes you're not using SAX)."
NSQ_SOURCE_LINE 00002686 ""
NSQ_SOURCE_LINE 00002687 "=head2 RootName => 'string' I<# out - handy>"
NSQ_SOURCE_LINE 00002688 ""
NSQ_SOURCE_LINE 00002689 "By default, when C<XMLout()> generates XML, the root element will be named"
NSQ_SOURCE_LINE 00002690 "'opt'.  This option allows you to specify an alternative name."
NSQ_SOURCE_LINE 00002691 ""
NSQ_SOURCE_LINE 00002692 "Specifying either undef or the empty string for the RootName option will"
NSQ_SOURCE_LINE 00002693 "produce XML with no root elements.  In most cases the resulting XML fragment"
NSQ_SOURCE_LINE 00002694 "will not be 'well formed' and therefore could not be read back in by C<XMLin()>."
NSQ_SOURCE_LINE 00002695 "Nevertheless, the option has been found to be useful in certain circumstances."
NSQ_SOURCE_LINE 00002696 ""
NSQ_SOURCE_LINE 00002697 "=head2 SearchPath => [ list ] I<# in - handy>"
NSQ_SOURCE_LINE 00002698 ""
NSQ_SOURCE_LINE 00002699 "If you pass C<XMLin()> a filename, but the filename include no directory"
NSQ_SOURCE_LINE 00002700 "component, you can use this option to specify which directories should be"
NSQ_SOURCE_LINE 00002701 "searched to locate the file.  You might use this option to search first in the"
NSQ_SOURCE_LINE 00002702 "user's home directory, then in a global directory such as /etc."
NSQ_SOURCE_LINE 00002703 ""
NSQ_SOURCE_LINE 00002704 "If a filename is provided to C<XMLin()> but SearchPath is not defined, the"
NSQ_SOURCE_LINE 00002705 "file is assumed to be in the current directory."
NSQ_SOURCE_LINE 00002706 ""
NSQ_SOURCE_LINE 00002707 "If the first parameter to C<XMLin()> is undefined, the default SearchPath"
NSQ_SOURCE_LINE 00002708 "will contain only the directory in which the script itself is located."
NSQ_SOURCE_LINE 00002709 "Otherwise the default SearchPath will be empty."
NSQ_SOURCE_LINE 00002710 ""
NSQ_SOURCE_LINE 00002711 "=head2 StrictMode => 1 | 0  I<# in+out seldom used>"
NSQ_SOURCE_LINE 00002712 ""
NSQ_SOURCE_LINE 00002713 "This option allows you to turn L<STRICT MODE> on or off for a particular call,"
NSQ_SOURCE_LINE 00002714 "regardless of whether it was enabled at the time XML::Simple was loaded."
NSQ_SOURCE_LINE 00002715 ""
NSQ_SOURCE_LINE 00002716 "=head2 SuppressEmpty => 1 | '' | undef I<# in+out - handy>"
NSQ_SOURCE_LINE 00002717 ""
NSQ_SOURCE_LINE 00002718 "This option controls what C<XMLin()> should do with empty elements (no"
NSQ_SOURCE_LINE 00002719 "attributes and no content).  The default behaviour is to represent them as"
NSQ_SOURCE_LINE 00002720 "empty hashes.  Setting this option to a true value (eg: 1) will cause empty"
NSQ_SOURCE_LINE 00002721 "elements to be skipped altogether.  Setting the option to 'undef' or the empty"
NSQ_SOURCE_LINE 00002722 "string will cause empty elements to be represented as the undefined value or"
NSQ_SOURCE_LINE 00002723 "the empty string respectively.  The latter two alternatives are a little"
NSQ_SOURCE_LINE 00002724 "easier to test for in your code than a hash with no keys."
NSQ_SOURCE_LINE 00002725 ""
NSQ_SOURCE_LINE 00002726 "The option also controls what C<XMLout()> does with undefined values.  Setting"
NSQ_SOURCE_LINE 00002727 "the option to undef causes undefined values to be output as empty elements"
NSQ_SOURCE_LINE 00002728 "(rather than empty attributes), it also suppresses the generation of warnings"
NSQ_SOURCE_LINE 00002729 "about undefined values.  Setting the option to a true value (eg: 1) causes"
NSQ_SOURCE_LINE 00002730 "undefined values to be skipped altogether on output."
NSQ_SOURCE_LINE 00002731 ""
NSQ_SOURCE_LINE 00002732 "=head2 ValueAttr => [ names ] I<# in - handy>"
NSQ_SOURCE_LINE 00002733 ""
NSQ_SOURCE_LINE 00002734 "Use this option to deal elements which always have a single attribute and no"
NSQ_SOURCE_LINE 00002735 "content.  Eg:"
NSQ_SOURCE_LINE 00002736 ""
NSQ_SOURCE_LINE 00002737 "  <opt>"
NSQ_SOURCE_LINE 00002738 "    <colour value=\"red\" />"
NSQ_SOURCE_LINE 00002739 "    <size   value=\"XXL\" />"
NSQ_SOURCE_LINE 00002740 "  </opt>"
NSQ_SOURCE_LINE 00002741 ""
NSQ_SOURCE_LINE 00002742 "Setting C<< ValueAttr => [ 'value' ] >> will cause the above XML to parse to:"
NSQ_SOURCE_LINE 00002743 ""
NSQ_SOURCE_LINE 00002744 "  {"
NSQ_SOURCE_LINE 00002745 "    colour => 'red',"
NSQ_SOURCE_LINE 00002746 "    size   => 'XXL'"
NSQ_SOURCE_LINE 00002747 "  }"
NSQ_SOURCE_LINE 00002748 ""
NSQ_SOURCE_LINE 00002749 "instead of this (the default):"
NSQ_SOURCE_LINE 00002750 ""
NSQ_SOURCE_LINE 00002751 "  {"
NSQ_SOURCE_LINE 00002752 "    colour => { value => 'red' },"
NSQ_SOURCE_LINE 00002753 "    size   => { value => 'XXL' }"
NSQ_SOURCE_LINE 00002754 "  }"
NSQ_SOURCE_LINE 00002755 ""
NSQ_SOURCE_LINE 00002756 "Note: This form of the ValueAttr option is not compatible with C<XMLout()> -"
NSQ_SOURCE_LINE 00002757 "since the attribute name is discarded at parse time, the original XML cannot be"
NSQ_SOURCE_LINE 00002758 "reconstructed."
NSQ_SOURCE_LINE 00002759 ""
NSQ_SOURCE_LINE 00002760 "=head2 ValueAttr => { element => attribute, ... } I<# in+out - handy>"
NSQ_SOURCE_LINE 00002761 ""
NSQ_SOURCE_LINE 00002762 "This (preferred) form of the ValueAttr option requires you to specify both"
NSQ_SOURCE_LINE 00002763 "the element and the attribute names.  This is not only safer, it also allows"
NSQ_SOURCE_LINE 00002764 "the original XML to be reconstructed by C<XMLout()>."
NSQ_SOURCE_LINE 00002765 ""
NSQ_SOURCE_LINE 00002766 "Note: You probably don't want to use this option and the NoAttr option at the"
NSQ_SOURCE_LINE 00002767 "same time."
NSQ_SOURCE_LINE 00002768 ""
NSQ_SOURCE_LINE 00002769 "=head2 Variables => { name => value } I<# in - handy>"
NSQ_SOURCE_LINE 00002770 ""
NSQ_SOURCE_LINE 00002771 "This option allows variables in the XML to be expanded when the file is read."
NSQ_SOURCE_LINE 00002772 "(there is no facility for putting the variable names back if you regenerate"
NSQ_SOURCE_LINE 00002773 "XML using C<XMLout>)."
NSQ_SOURCE_LINE 00002774 ""
NSQ_SOURCE_LINE 00002775 "A 'variable' is any text of the form C<${name}> which occurs in an attribute"
NSQ_SOURCE_LINE 00002776 "value or in the text content of an element.  If 'name' matches a key in the"
NSQ_SOURCE_LINE 00002777 "supplied hashref, C<${name}> will be replaced with the corresponding value from"
NSQ_SOURCE_LINE 00002778 "the hashref.  If no matching key is found, the variable will not be replaced."
NSQ_SOURCE_LINE 00002779 "Names must match the regex: C<[\\w.]+> (ie: only 'word' characters and dots are"
NSQ_SOURCE_LINE 00002780 "allowed)."
NSQ_SOURCE_LINE 00002781 ""
NSQ_SOURCE_LINE 00002782 "=head2 VarAttr => 'attr_name' I<# in - handy>"
NSQ_SOURCE_LINE 00002783 ""
NSQ_SOURCE_LINE 00002784 "In addition to the variables defined using C<Variables>, this option allows"
NSQ_SOURCE_LINE 00002785 "variables to be defined in the XML.  A variable definition consists of an"
NSQ_SOURCE_LINE 00002786 "element with an attribute called 'attr_name' (the value of the C<VarAttr>"
NSQ_SOURCE_LINE 00002787 "option).  The value of the attribute will be used as the variable name and the"
NSQ_SOURCE_LINE 00002788 "text content of the element will be used as the value.  A variable defined in"
NSQ_SOURCE_LINE 00002789 "this way will override a variable defined using the C<Variables> option.  For"
NSQ_SOURCE_LINE 00002790 "example:"
NSQ_SOURCE_LINE 00002791 ""
NSQ_SOURCE_LINE 00002792 "  XMLin( '<opt>"
NSQ_SOURCE_LINE 00002793 "            <dir name=\"prefix\">/usr/local/apache</dir>"
NSQ_SOURCE_LINE 00002794 "            <dir name=\"exec_prefix\">${prefix}</dir>"
NSQ_SOURCE_LINE 00002795 "            <dir name=\"bindir\">${exec_prefix}/bin</dir>"
NSQ_SOURCE_LINE 00002796 "          </opt>',"
NSQ_SOURCE_LINE 00002797 "         VarAttr => 'name', ContentKey => '-content'"
NSQ_SOURCE_LINE 00002798 "        );"
NSQ_SOURCE_LINE 00002799 ""
NSQ_SOURCE_LINE 00002800 "produces the following data structure:"
NSQ_SOURCE_LINE 00002801 ""
NSQ_SOURCE_LINE 00002802 "  {"
NSQ_SOURCE_LINE 00002803 "    dir => {"
NSQ_SOURCE_LINE 00002804 "             prefix      => '/usr/local/apache',"
NSQ_SOURCE_LINE 00002805 "             exec_prefix => '/usr/local/apache',"
NSQ_SOURCE_LINE 00002806 "             bindir      => '/usr/local/apache/bin',"
NSQ_SOURCE_LINE 00002807 "           }"
NSQ_SOURCE_LINE 00002808 "  }"
NSQ_SOURCE_LINE 00002809 ""
NSQ_SOURCE_LINE 00002810 "=head2 XMLDecl => 1  or  XMLDecl => 'string'  I<# out - handy>"
NSQ_SOURCE_LINE 00002811 ""
NSQ_SOURCE_LINE 00002812 "If you want the output from C<XMLout()> to start with the optional XML"
NSQ_SOURCE_LINE 00002813 "declaration, simply set the option to '1'.  The default XML declaration is:"
NSQ_SOURCE_LINE 00002814 ""
NSQ_SOURCE_LINE 00002815 "        <?xml version='1.0' standalone='yes'?>"
NSQ_SOURCE_LINE 00002816 ""
NSQ_SOURCE_LINE 00002817 "If you want some other string (for example to declare an encoding value), set"
NSQ_SOURCE_LINE 00002818 "the value of this option to the complete string you require."
NSQ_SOURCE_LINE 00002819 ""
NSQ_SOURCE_LINE 00002820 ""
NSQ_SOURCE_LINE 00002821 "=head1 OPTIONAL OO INTERFACE"
NSQ_SOURCE_LINE 00002822 ""
NSQ_SOURCE_LINE 00002823 "The procedural interface is both simple and convenient however there are a"
NSQ_SOURCE_LINE 00002824 "couple of reasons why you might prefer to use the object oriented (OO)"
NSQ_SOURCE_LINE 00002825 "interface:"
NSQ_SOURCE_LINE 00002826 ""
NSQ_SOURCE_LINE 00002827 "=over 4"
NSQ_SOURCE_LINE 00002828 ""
NSQ_SOURCE_LINE 00002829 "=item *"
NSQ_SOURCE_LINE 00002830 ""
NSQ_SOURCE_LINE 00002831 "to define a set of default values which should be used on all subsequent calls"
NSQ_SOURCE_LINE 00002832 "to C<XMLin()> or C<XMLout()>"
NSQ_SOURCE_LINE 00002833 ""
NSQ_SOURCE_LINE 00002834 "=item *"
NSQ_SOURCE_LINE 00002835 ""
NSQ_SOURCE_LINE 00002836 "to override methods in B<XML::Simple> to provide customised behaviour"
NSQ_SOURCE_LINE 00002837 ""
NSQ_SOURCE_LINE 00002838 "=back"
NSQ_SOURCE_LINE 00002839 ""
NSQ_SOURCE_LINE 00002840 "The default values for the options described above are unlikely to suit"
NSQ_SOURCE_LINE 00002841 "everyone.  The OO interface allows you to effectively override B<XML::Simple>'s"
NSQ_SOURCE_LINE 00002842 "defaults with your preferred values.  It works like this:"
NSQ_SOURCE_LINE 00002843 ""
NSQ_SOURCE_LINE 00002844 "First create an XML::Simple parser object with your preferred defaults:"
NSQ_SOURCE_LINE 00002845 ""
NSQ_SOURCE_LINE 00002846 "  my $xs = XML::Simple->new(ForceArray => 1, KeepRoot => 1);"
NSQ_SOURCE_LINE 00002847 ""
NSQ_SOURCE_LINE 00002848 "then call C<XMLin()> or C<XMLout()> as a method of that object:"
NSQ_SOURCE_LINE 00002849 ""
NSQ_SOURCE_LINE 00002850 "  my $ref = $xs->XMLin($xml);"
NSQ_SOURCE_LINE 00002851 "  my $xml = $xs->XMLout($ref);"
NSQ_SOURCE_LINE 00002852 ""
NSQ_SOURCE_LINE 00002853 "You can also specify options when you make the method calls and these values"
NSQ_SOURCE_LINE 00002854 "will be merged with the values specified when the object was created.  Values"
NSQ_SOURCE_LINE 00002855 "specified in a method call take precedence."
NSQ_SOURCE_LINE 00002856 ""
NSQ_SOURCE_LINE 00002857 "Note: when called as methods, the C<XMLin()> and C<XMLout()> routines may be"
NSQ_SOURCE_LINE 00002858 "called as C<xml_in()> or C<xml_out()>.  The method names are aliased so the"
NSQ_SOURCE_LINE 00002859 "only difference is the aesthetics."
NSQ_SOURCE_LINE 00002860 ""
NSQ_SOURCE_LINE 00002861 "=head2 Parsing Methods"
NSQ_SOURCE_LINE 00002862 ""
NSQ_SOURCE_LINE 00002863 "You can explicitly call one of the following methods rather than rely on the"
NSQ_SOURCE_LINE 00002864 "C<xml_in()> method automatically determining whether the target to be parsed is"
NSQ_SOURCE_LINE 00002865 "a string, a file or a filehandle:"
NSQ_SOURCE_LINE 00002866 ""
NSQ_SOURCE_LINE 00002867 "=over 4"
NSQ_SOURCE_LINE 00002868 ""
NSQ_SOURCE_LINE 00002869 "=item parse_string(text)"
NSQ_SOURCE_LINE 00002870 ""
NSQ_SOURCE_LINE 00002871 "Works exactly like the C<xml_in()> method but assumes the first argument is"
NSQ_SOURCE_LINE 00002872 "a string of XML (or a reference to a scalar containing a string of XML)."
NSQ_SOURCE_LINE 00002873 ""
NSQ_SOURCE_LINE 00002874 "=item parse_file(filename)"
NSQ_SOURCE_LINE 00002875 ""
NSQ_SOURCE_LINE 00002876 "Works exactly like the C<xml_in()> method but assumes the first argument is"
NSQ_SOURCE_LINE 00002877 "the name of a file containing XML."
NSQ_SOURCE_LINE 00002878 ""
NSQ_SOURCE_LINE 00002879 "=item parse_fh(file_handle)"
NSQ_SOURCE_LINE 00002880 ""
NSQ_SOURCE_LINE 00002881 "Works exactly like the C<xml_in()> method but assumes the first argument is"
NSQ_SOURCE_LINE 00002882 "a filehandle which can be read to get XML."
NSQ_SOURCE_LINE 00002883 ""
NSQ_SOURCE_LINE 00002884 "=back"
NSQ_SOURCE_LINE 00002885 ""
NSQ_SOURCE_LINE 00002886 "=head2 Hook Methods"
NSQ_SOURCE_LINE 00002887 ""
NSQ_SOURCE_LINE 00002888 "You can make your own class which inherits from XML::Simple and overrides"
NSQ_SOURCE_LINE 00002889 "certain behaviours.  The following methods may provide useful 'hooks' upon"
NSQ_SOURCE_LINE 00002890 "which to hang your modified behaviour.  You may find other undocumented methods"
NSQ_SOURCE_LINE 00002891 "by examining the source, but those may be subject to change in future releases."
NSQ_SOURCE_LINE 00002892 ""
NSQ_SOURCE_LINE 00002893 "=over 4"
NSQ_SOURCE_LINE 00002894 ""
NSQ_SOURCE_LINE 00002895 "=item new_xml_parser()"
NSQ_SOURCE_LINE 00002896 ""
NSQ_SOURCE_LINE 00002897 "This method will be called when a new XML::Parser object must be constructed"
NSQ_SOURCE_LINE 00002898 "(either because XML::SAX is not installed or XML::Parser is preferred)."
NSQ_SOURCE_LINE 00002899 ""
NSQ_SOURCE_LINE 00002900 "=item handle_options(direction, name => value ...)"
NSQ_SOURCE_LINE 00002901 ""
NSQ_SOURCE_LINE 00002902 "This method will be called when one of the parsing methods or the C<XMLout()>"
NSQ_SOURCE_LINE 00002903 "method is called.  The initial argument will be a string (either 'in' or 'out')"
NSQ_SOURCE_LINE 00002904 "and the remaining arguments will be name value pairs."
NSQ_SOURCE_LINE 00002905 ""
NSQ_SOURCE_LINE 00002906 "=item default_config_file()"
NSQ_SOURCE_LINE 00002907 ""
NSQ_SOURCE_LINE 00002908 "Calculates and returns the name of the file which should be parsed if no"
NSQ_SOURCE_LINE 00002909 "filename is passed to C<XMLin()> (default: C<$0.xml>)."
NSQ_SOURCE_LINE 00002910 ""
NSQ_SOURCE_LINE 00002911 "=item build_simple_tree(filename, string)"
NSQ_SOURCE_LINE 00002912 ""
NSQ_SOURCE_LINE 00002913 "Called from C<XMLin()> or any of the parsing methods.  Takes either a file name"
NSQ_SOURCE_LINE 00002914 "as the first argument or C<undef> followed by a 'string' as the second"
NSQ_SOURCE_LINE 00002915 "argument.  Returns a simple tree data structure.  You could override this"
NSQ_SOURCE_LINE 00002916 "method to apply your own transformations before the data structure is returned"
NSQ_SOURCE_LINE 00002917 "to the caller."
NSQ_SOURCE_LINE 00002918 ""
NSQ_SOURCE_LINE 00002919 "=item new_hashref()"
NSQ_SOURCE_LINE 00002920 ""
NSQ_SOURCE_LINE 00002921 "When the 'simple tree' data structure is being built, this method will be"
NSQ_SOURCE_LINE 00002922 "called to create any required anonymous hashrefs."
NSQ_SOURCE_LINE 00002923 ""
NSQ_SOURCE_LINE 00002924 "=item sorted_keys(name, hashref)"
NSQ_SOURCE_LINE 00002925 ""
NSQ_SOURCE_LINE 00002926 "Called when C<XMLout()> is translating a hashref to XML.  This routine returns"
NSQ_SOURCE_LINE 00002927 "a list of hash keys in the order that the corresponding attributes/elements"
NSQ_SOURCE_LINE 00002928 "should appear in the output."
NSQ_SOURCE_LINE 00002929 ""
NSQ_SOURCE_LINE 00002930 "=item escape_value(string)"
NSQ_SOURCE_LINE 00002931 ""
NSQ_SOURCE_LINE 00002932 "Called from C<XMLout()>, takes a string and returns a copy of the string with"
NSQ_SOURCE_LINE 00002933 "XML character escaping rules applied."
NSQ_SOURCE_LINE 00002934 ""
NSQ_SOURCE_LINE 00002935 "=item escape_attr(string)"
NSQ_SOURCE_LINE 00002936 ""
NSQ_SOURCE_LINE 00002937 "Called from C<XMLout()>, to handle attribute values.  By default, just calls"
NSQ_SOURCE_LINE 00002938 "C<escape_value()>, but you can override this method if you want attributes"
NSQ_SOURCE_LINE 00002939 "escaped differently than text content."
NSQ_SOURCE_LINE 00002940 ""
NSQ_SOURCE_LINE 00002941 "=item numeric_escape(string)"
NSQ_SOURCE_LINE 00002942 ""
NSQ_SOURCE_LINE 00002943 "Called from C<escape_value()>, to handle non-ASCII characters (depending on the"
NSQ_SOURCE_LINE 00002944 "value of the NumericEscape option)."
NSQ_SOURCE_LINE 00002945 ""
NSQ_SOURCE_LINE 00002946 "=item copy_hash(hashref, extra_key => value, ...)"
NSQ_SOURCE_LINE 00002947 ""
NSQ_SOURCE_LINE 00002948 "Called from C<XMLout()>, when 'unfolding' a hash of hashes into an array of"
NSQ_SOURCE_LINE 00002949 "hashes.  You might wish to override this method if you're using tied hashes and"
NSQ_SOURCE_LINE 00002950 "don't want them to get untied."
NSQ_SOURCE_LINE 00002951 ""
NSQ_SOURCE_LINE 00002952 "=back"
NSQ_SOURCE_LINE 00002953 ""
NSQ_SOURCE_LINE 00002954 "=head2 Cache Methods"
NSQ_SOURCE_LINE 00002955 ""
NSQ_SOURCE_LINE 00002956 "XML::Simple implements three caching schemes ('storable', 'memshare' and"
NSQ_SOURCE_LINE 00002957 "'memcopy').  You can implement a custom caching scheme by implementing"
NSQ_SOURCE_LINE 00002958 "two methods - one for reading from the cache and one for writing to it."
NSQ_SOURCE_LINE 00002959 ""
NSQ_SOURCE_LINE 00002960 "For example, you might implement a new 'dbm' scheme that stores cached data"
NSQ_SOURCE_LINE 00002961 "structures using the L<MLDBM> module.  First, you would add a"
NSQ_SOURCE_LINE 00002962 "C<cache_read_dbm()> method which accepted a filename for use as a lookup key"
NSQ_SOURCE_LINE 00002963 "and returned a data structure on success, or undef on failure.  Then, you would"
NSQ_SOURCE_LINE 00002964 "implement a C<cache_read_dbm()> method which accepted a data structure and a"
NSQ_SOURCE_LINE 00002965 "filename."
NSQ_SOURCE_LINE 00002966 ""
NSQ_SOURCE_LINE 00002967 "You would use this caching scheme by specifying the option:"
NSQ_SOURCE_LINE 00002968 ""
NSQ_SOURCE_LINE 00002969 "  Cache => [ 'dbm' ]"
NSQ_SOURCE_LINE 00002970 ""
NSQ_SOURCE_LINE 00002971 "=head1 STRICT MODE"
NSQ_SOURCE_LINE 00002972 ""
NSQ_SOURCE_LINE 00002973 "If you import the B<XML::Simple> routines like this:"
NSQ_SOURCE_LINE 00002974 ""
NSQ_SOURCE_LINE 00002975 "  use XML::Simple qw(:strict);"
NSQ_SOURCE_LINE 00002976 ""
NSQ_SOURCE_LINE 00002977 "the following common mistakes will be detected and treated as fatal errors"
NSQ_SOURCE_LINE 00002978 ""
NSQ_SOURCE_LINE 00002979 "=over 4"
NSQ_SOURCE_LINE 00002980 ""
NSQ_SOURCE_LINE 00002981 "=item *"
NSQ_SOURCE_LINE 00002982 ""
NSQ_SOURCE_LINE 00002983 "Failing to explicitly set the C<KeyAttr> option - if you can't be bothered"
NSQ_SOURCE_LINE 00002984 "reading about this option, turn it off with: KeyAttr => [ ]"
NSQ_SOURCE_LINE 00002985 ""
NSQ_SOURCE_LINE 00002986 "=item *"
NSQ_SOURCE_LINE 00002987 ""
NSQ_SOURCE_LINE 00002988 "Failing to explicitly set the C<ForceArray> option - if you can't be bothered"
NSQ_SOURCE_LINE 00002989 "reading about this option, set it to the safest mode with: ForceArray => 1"
NSQ_SOURCE_LINE 00002990 ""
NSQ_SOURCE_LINE 00002991 "=item *"
NSQ_SOURCE_LINE 00002992 ""
NSQ_SOURCE_LINE 00002993 "Setting ForceArray to an array, but failing to list all the elements from the"
NSQ_SOURCE_LINE 00002994 "KeyAttr hash."
NSQ_SOURCE_LINE 00002995 ""
NSQ_SOURCE_LINE 00002996 "=item *"
NSQ_SOURCE_LINE 00002997 ""
NSQ_SOURCE_LINE 00002998 "Data error - KeyAttr is set to say { part => 'partnum' } but the XML contains"
NSQ_SOURCE_LINE 00002999 "one or more E<lt>partE<gt> elements without a 'partnum' attribute (or nested"
NSQ_SOURCE_LINE 00003000 "element).  Note: if strict mode is not set but C<use warnings;> is in force,"
NSQ_SOURCE_LINE 00003001 "this condition triggers a warning."
NSQ_SOURCE_LINE 00003002 ""
NSQ_SOURCE_LINE 00003003 "=item *"
NSQ_SOURCE_LINE 00003004 ""
NSQ_SOURCE_LINE 00003005 "Data error - as above, but non-unique values are present in the key attribute"
NSQ_SOURCE_LINE 00003006 "(eg: more than one E<lt>partE<gt> element with the same partnum).  This will"
NSQ_SOURCE_LINE 00003007 "also trigger a warning if strict mode is not enabled."
NSQ_SOURCE_LINE 00003008 ""
NSQ_SOURCE_LINE 00003009 "=item *"
NSQ_SOURCE_LINE 00003010 ""
NSQ_SOURCE_LINE 00003011 "Data error - as above, but value of key attribute (eg: partnum) is not a"
NSQ_SOURCE_LINE 00003012 "scalar string (due to nested elements etc).  This will also trigger a warning"
NSQ_SOURCE_LINE 00003013 "if strict mode is not enabled."
NSQ_SOURCE_LINE 00003014 ""
NSQ_SOURCE_LINE 00003015 "=back"
NSQ_SOURCE_LINE 00003016 ""
NSQ_SOURCE_LINE 00003017 "=head1 SAX SUPPORT"
NSQ_SOURCE_LINE 00003018 ""
NSQ_SOURCE_LINE 00003019 "From version 1.08_01, B<XML::Simple> includes support for SAX (the Simple API"
NSQ_SOURCE_LINE 00003020 "for XML) - specifically SAX2."
NSQ_SOURCE_LINE 00003021 ""
NSQ_SOURCE_LINE 00003022 "In a typical SAX application, an XML parser (or SAX 'driver') module generates"
NSQ_SOURCE_LINE 00003023 "SAX events (start of element, character data, end of element, etc) as it parses"
NSQ_SOURCE_LINE 00003024 "an XML document and a 'handler' module processes the events to extract the"
NSQ_SOURCE_LINE 00003025 "required data.  This simple model allows for some interesting and powerful"
NSQ_SOURCE_LINE 00003026 "possibilities:"
NSQ_SOURCE_LINE 00003027 ""
NSQ_SOURCE_LINE 00003028 "=over 4"
NSQ_SOURCE_LINE 00003029 ""
NSQ_SOURCE_LINE 00003030 "=item *"
NSQ_SOURCE_LINE 00003031 ""
NSQ_SOURCE_LINE 00003032 "Applications written to the SAX API can extract data from huge XML documents"
NSQ_SOURCE_LINE 00003033 "without the memory overheads of a DOM or tree API."
NSQ_SOURCE_LINE 00003034 ""
NSQ_SOURCE_LINE 00003035 "=item *"
NSQ_SOURCE_LINE 00003036 ""
NSQ_SOURCE_LINE 00003037 "The SAX API allows for plug and play interchange of parser modules without"
NSQ_SOURCE_LINE 00003038 "having to change your code to fit a new module's API.  A number of SAX parsers"
NSQ_SOURCE_LINE 00003039 "are available with capabilities ranging from extreme portability to blazing"
NSQ_SOURCE_LINE 00003040 "performance."
NSQ_SOURCE_LINE 00003041 ""
NSQ_SOURCE_LINE 00003042 "=item *"
NSQ_SOURCE_LINE 00003043 ""
NSQ_SOURCE_LINE 00003044 "A SAX 'filter' module can implement both a handler interface for receiving"
NSQ_SOURCE_LINE 00003045 "data and a generator interface for passing modified data on to a downstream"
NSQ_SOURCE_LINE 00003046 "handler.  Filters can be chained together in 'pipelines'."
NSQ_SOURCE_LINE 00003047 ""
NSQ_SOURCE_LINE 00003048 "=item *"
NSQ_SOURCE_LINE 00003049 ""
NSQ_SOURCE_LINE 00003050 "One filter module might split a data stream to direct data to two or more"
NSQ_SOURCE_LINE 00003051 "downstream handlers."
NSQ_SOURCE_LINE 00003052 ""
NSQ_SOURCE_LINE 00003053 "=item *"
NSQ_SOURCE_LINE 00003054 ""
NSQ_SOURCE_LINE 00003055 "Generating SAX events is not the exclusive preserve of XML parsing modules."
NSQ_SOURCE_LINE 00003056 "For example, a module might extract data from a relational database using DBI"
NSQ_SOURCE_LINE 00003057 "and pass it on to a SAX pipeline for filtering and formatting."
NSQ_SOURCE_LINE 00003058 ""
NSQ_SOURCE_LINE 00003059 "=back"
NSQ_SOURCE_LINE 00003060 ""
NSQ_SOURCE_LINE 00003061 "B<XML::Simple> can operate at either end of a SAX pipeline.  For example,"
NSQ_SOURCE_LINE 00003062 "you can take a data structure in the form of a hashref and pass it into a"
NSQ_SOURCE_LINE 00003063 "SAX pipeline using the 'Handler' option on C<XMLout()>:"
NSQ_SOURCE_LINE 00003064 ""
NSQ_SOURCE_LINE 00003065 "  use XML::Simple;"
NSQ_SOURCE_LINE 00003066 "  use Some::SAX::Filter;"
NSQ_SOURCE_LINE 00003067 "  use XML::SAX::Writer;"
NSQ_SOURCE_LINE 00003068 ""
NSQ_SOURCE_LINE 00003069 "  my $ref = {"
NSQ_SOURCE_LINE 00003070 "               ....   # your data here"
NSQ_SOURCE_LINE 00003071 "            };"
NSQ_SOURCE_LINE 00003072 ""
NSQ_SOURCE_LINE 00003073 "  my $writer = XML::SAX::Writer->new();"
NSQ_SOURCE_LINE 00003074 "  my $filter = Some::SAX::Filter->new(Handler => $writer);"
NSQ_SOURCE_LINE 00003075 "  my $simple = XML::Simple->new(Handler => $filter);"
NSQ_SOURCE_LINE 00003076 "  $simple->XMLout($ref);"
NSQ_SOURCE_LINE 00003077 ""
NSQ_SOURCE_LINE 00003078 "You can also put B<XML::Simple> at the opposite end of the pipeline to take"
NSQ_SOURCE_LINE 00003079 "advantage of the simple 'tree' data structure once the relevant data has been"
NSQ_SOURCE_LINE 00003080 "isolated through filtering:"
NSQ_SOURCE_LINE 00003081 ""
NSQ_SOURCE_LINE 00003082 "  use XML::SAX;"
NSQ_SOURCE_LINE 00003083 "  use Some::SAX::Filter;"
NSQ_SOURCE_LINE 00003084 "  use XML::Simple;"
NSQ_SOURCE_LINE 00003085 ""
NSQ_SOURCE_LINE 00003086 "  my $simple = XML::Simple->new(ForceArray => 1, KeyAttr => ['partnum']);"
NSQ_SOURCE_LINE 00003087 "  my $filter = Some::SAX::Filter->new(Handler => $simple);"
NSQ_SOURCE_LINE 00003088 "  my $parser = XML::SAX::ParserFactory->parser(Handler => $filter);"
NSQ_SOURCE_LINE 00003089 ""
NSQ_SOURCE_LINE 00003090 "  my $ref = $parser->parse_uri('some_huge_file.xml');"
NSQ_SOURCE_LINE 00003091 ""
NSQ_SOURCE_LINE 00003092 "  print $ref->{part}->{'555-1234'};"
NSQ_SOURCE_LINE 00003093 ""
NSQ_SOURCE_LINE 00003094 "You can build a filter by using an XML::Simple object as a handler and setting"
NSQ_SOURCE_LINE 00003095 "its DataHandler option to point to a routine which takes the resulting tree,"
NSQ_SOURCE_LINE 00003096 "modifies it and sends it off as SAX events to a downstream handler:"
NSQ_SOURCE_LINE 00003097 ""
NSQ_SOURCE_LINE 00003098 "  my $writer = XML::SAX::Writer->new();"
NSQ_SOURCE_LINE 00003099 "  my $filter = XML::Simple->new("
NSQ_SOURCE_LINE 00003100 "                 DataHandler => sub {"
NSQ_SOURCE_LINE 00003101 "                                  my $simple = shift;"
NSQ_SOURCE_LINE 00003102 "                                  my $data = shift;"
NSQ_SOURCE_LINE 00003103 ""
NSQ_SOURCE_LINE 00003104 "                                  # Modify $data here"
NSQ_SOURCE_LINE 00003105 ""
NSQ_SOURCE_LINE 00003106 "                                  $simple->XMLout($data, Handler => $writer);"
NSQ_SOURCE_LINE 00003107 "                                }"
NSQ_SOURCE_LINE 00003108 "               );"
NSQ_SOURCE_LINE 00003109 "  my $parser = XML::SAX::ParserFactory->parser(Handler => $filter);"
NSQ_SOURCE_LINE 00003110 ""
NSQ_SOURCE_LINE 00003111 "  $parser->parse_uri($filename);"
NSQ_SOURCE_LINE 00003112 ""
NSQ_SOURCE_LINE 00003113 "I<Note: In this last example, the 'Handler' option was specified in the call to"
NSQ_SOURCE_LINE 00003114 "C<XMLout()> but it could also have been specified in the constructor>."
NSQ_SOURCE_LINE 00003115 ""
NSQ_SOURCE_LINE 00003116 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00003117 ""
NSQ_SOURCE_LINE 00003118 "If you don't care which parser module B<XML::Simple> uses then skip this"
NSQ_SOURCE_LINE 00003119 "section entirely (it looks more complicated than it really is)."
NSQ_SOURCE_LINE 00003120 ""
NSQ_SOURCE_LINE 00003121 "B<XML::Simple> will default to using a B<SAX> parser if one is available or"
NSQ_SOURCE_LINE 00003122 "B<XML::Parser> if SAX is not available."
NSQ_SOURCE_LINE 00003123 ""
NSQ_SOURCE_LINE 00003124 "You can dictate which parser module is used by setting either the environment"
NSQ_SOURCE_LINE 00003125 "variable 'XML_SIMPLE_PREFERRED_PARSER' or the package variable"
NSQ_SOURCE_LINE 00003126 "$XML::Simple::PREFERRED_PARSER to contain the module name.  The following rules"
NSQ_SOURCE_LINE 00003127 "are used:"
NSQ_SOURCE_LINE 00003128 ""
NSQ_SOURCE_LINE 00003129 "=over 4"
NSQ_SOURCE_LINE 00003130 ""
NSQ_SOURCE_LINE 00003131 "=item *"
NSQ_SOURCE_LINE 00003132 ""
NSQ_SOURCE_LINE 00003133 "The package variable takes precedence over the environment variable if both are defined.  To force B<XML::Simple> to ignore the environment settings and use"
NSQ_SOURCE_LINE 00003134 "its default rules, you can set the package variable to an empty string."
NSQ_SOURCE_LINE 00003135 ""
NSQ_SOURCE_LINE 00003136 "=item *"
NSQ_SOURCE_LINE 00003137 ""
NSQ_SOURCE_LINE 00003138 "If the 'preferred parser' is set to the string 'XML::Parser', then"
NSQ_SOURCE_LINE 00003139 "L<XML::Parser> will be used (or C<XMLin()> will die if L<XML::Parser> is not"
NSQ_SOURCE_LINE 00003140 "installed)."
NSQ_SOURCE_LINE 00003141 ""
NSQ_SOURCE_LINE 00003142 "=item *"
NSQ_SOURCE_LINE 00003143 ""
NSQ_SOURCE_LINE 00003144 "If the 'preferred parser' is set to some other value, then it is assumed to be"
NSQ_SOURCE_LINE 00003145 "the name of a SAX parser module and is passed to L<XML::SAX::ParserFactory>."
NSQ_SOURCE_LINE 00003146 "If L<XML::SAX> is not installed, or the requested parser module is not"
NSQ_SOURCE_LINE 00003147 "installed, then C<XMLin()> will die."
NSQ_SOURCE_LINE 00003148 ""
NSQ_SOURCE_LINE 00003149 "=item *"
NSQ_SOURCE_LINE 00003150 ""
NSQ_SOURCE_LINE 00003151 "If the 'preferred parser' is not defined at all (the normal default"
NSQ_SOURCE_LINE 00003152 "state), an attempt will be made to load L<XML::SAX>.  If L<XML::SAX> is"
NSQ_SOURCE_LINE 00003153 "installed, then a parser module will be selected according to"
NSQ_SOURCE_LINE 00003154 "L<XML::SAX::ParserFactory>'s normal rules (which typically means the last SAX"
NSQ_SOURCE_LINE 00003155 "parser installed)."
NSQ_SOURCE_LINE 00003156 ""
NSQ_SOURCE_LINE 00003157 "=item *"
NSQ_SOURCE_LINE 00003158 ""
NSQ_SOURCE_LINE 00003159 "if the 'preferred parser' is not defined and B<XML::SAX> is not"
NSQ_SOURCE_LINE 00003160 "installed, then B<XML::Parser> will be used.  C<XMLin()> will die if"
NSQ_SOURCE_LINE 00003161 "L<XML::Parser> is not installed."
NSQ_SOURCE_LINE 00003162 ""
NSQ_SOURCE_LINE 00003163 "=back"
NSQ_SOURCE_LINE 00003164 ""
NSQ_SOURCE_LINE 00003165 "Note: The B<XML::SAX> distribution includes an XML parser written entirely in"
NSQ_SOURCE_LINE 00003166 "Perl.  It is very portable but it is not very fast.  You should consider"
NSQ_SOURCE_LINE 00003167 "installing L<XML::LibXML> or L<XML::SAX::Expat> if they are available for your"
NSQ_SOURCE_LINE 00003168 "platform."
NSQ_SOURCE_LINE 00003169 ""
NSQ_SOURCE_LINE 00003170 "=head1 ERROR HANDLING"
NSQ_SOURCE_LINE 00003171 ""
NSQ_SOURCE_LINE 00003172 "The XML standard is very clear on the issue of non-compliant documents.  An"
NSQ_SOURCE_LINE 00003173 "error in parsing any single element (for example a missing end tag) must cause"
NSQ_SOURCE_LINE 00003174 "the whole document to be rejected.  B<XML::Simple> will die with an appropriate"
NSQ_SOURCE_LINE 00003175 "message if it encounters a parsing error."
NSQ_SOURCE_LINE 00003176 ""
NSQ_SOURCE_LINE 00003177 "If dying is not appropriate for your application, you should arrange to call"
NSQ_SOURCE_LINE 00003178 "C<XMLin()> in an eval block and look for errors in $@.  eg:"
NSQ_SOURCE_LINE 00003179 ""
NSQ_SOURCE_LINE 00003180 "    my $config = eval { XMLin() };"
NSQ_SOURCE_LINE 00003181 "    PopUpMessage($@) if($@);"
NSQ_SOURCE_LINE 00003182 ""
NSQ_SOURCE_LINE 00003183 "Note, there is a common misconception that use of B<eval> will significantly"
NSQ_SOURCE_LINE 00003184 "slow down a script.  While that may be true when the code being eval'd is in a"
NSQ_SOURCE_LINE 00003185 "string, it is not true of code like the sample above."
NSQ_SOURCE_LINE 00003186 ""
NSQ_SOURCE_LINE 00003187 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00003188 ""
NSQ_SOURCE_LINE 00003189 "When C<XMLin()> reads the following very simple piece of XML:"
NSQ_SOURCE_LINE 00003190 ""
NSQ_SOURCE_LINE 00003191 "    <opt username=\"testuser\" password=\"frodo\"></opt>"
NSQ_SOURCE_LINE 00003192 ""
NSQ_SOURCE_LINE 00003193 "it returns the following data structure:"
NSQ_SOURCE_LINE 00003194 ""
NSQ_SOURCE_LINE 00003195 "    {"
NSQ_SOURCE_LINE 00003196 "      'username' => 'testuser',"
NSQ_SOURCE_LINE 00003197 "      'password' => 'frodo'"
NSQ_SOURCE_LINE 00003198 "    }"
NSQ_SOURCE_LINE 00003199 ""
NSQ_SOURCE_LINE 00003200 "The identical result could have been produced with this alternative XML:"
NSQ_SOURCE_LINE 00003201 ""
NSQ_SOURCE_LINE 00003202 "    <opt username=\"testuser\" password=\"frodo\" />"
NSQ_SOURCE_LINE 00003203 ""
NSQ_SOURCE_LINE 00003204 "Or this (although see 'ForceArray' option for variations):"
NSQ_SOURCE_LINE 00003205 ""
NSQ_SOURCE_LINE 00003206 "    <opt>"
NSQ_SOURCE_LINE 00003207 "      <username>testuser</username>"
NSQ_SOURCE_LINE 00003208 "      <password>frodo</password>"
NSQ_SOURCE_LINE 00003209 "    </opt>"
NSQ_SOURCE_LINE 00003210 ""
NSQ_SOURCE_LINE 00003211 "Repeated nested elements are represented as anonymous arrays:"
NSQ_SOURCE_LINE 00003212 ""
NSQ_SOURCE_LINE 00003213 "    <opt>"
NSQ_SOURCE_LINE 00003214 "      <person firstname=\"Joe\" lastname=\"Smith\">"
NSQ_SOURCE_LINE 00003215 "        <email>joe@smith.com</email>"
NSQ_SOURCE_LINE 00003216 "        <email>jsmith@yahoo.com</email>"
NSQ_SOURCE_LINE 00003217 "      </person>"
NSQ_SOURCE_LINE 00003218 "      <person firstname=\"Bob\" lastname=\"Smith\">"
NSQ_SOURCE_LINE 00003219 "        <email>bob@smith.com</email>"
NSQ_SOURCE_LINE 00003220 "      </person>"
NSQ_SOURCE_LINE 00003221 "    </opt>"
NSQ_SOURCE_LINE 00003222 ""
NSQ_SOURCE_LINE 00003223 "    {"
NSQ_SOURCE_LINE 00003224 "      'person' => ["
NSQ_SOURCE_LINE 00003225 "                    {"
NSQ_SOURCE_LINE 00003226 "                      'email' => ["
NSQ_SOURCE_LINE 00003227 "                                   'joe@smith.com',"
NSQ_SOURCE_LINE 00003228 "                                   'jsmith@yahoo.com'"
NSQ_SOURCE_LINE 00003229 "                                 ],"
NSQ_SOURCE_LINE 00003230 "                      'firstname' => 'Joe',"
NSQ_SOURCE_LINE 00003231 "                      'lastname' => 'Smith'"
NSQ_SOURCE_LINE 00003232 "                    },"
NSQ_SOURCE_LINE 00003233 "                    {"
NSQ_SOURCE_LINE 00003234 "                      'email' => 'bob@smith.com',"
NSQ_SOURCE_LINE 00003235 "                      'firstname' => 'Bob',"
NSQ_SOURCE_LINE 00003236 "                      'lastname' => 'Smith'"
NSQ_SOURCE_LINE 00003237 "                    }"
NSQ_SOURCE_LINE 00003238 "                  ]"
NSQ_SOURCE_LINE 00003239 "    }"
NSQ_SOURCE_LINE 00003240 ""
NSQ_SOURCE_LINE 00003241 "Nested elements with a recognised key attribute are transformed (folded) from"
NSQ_SOURCE_LINE 00003242 "an array into a hash keyed on the value of that attribute (see the C<KeyAttr>"
NSQ_SOURCE_LINE 00003243 "option):"
NSQ_SOURCE_LINE 00003244 ""
NSQ_SOURCE_LINE 00003245 "    <opt>"
NSQ_SOURCE_LINE 00003246 "      <person key=\"jsmith\" firstname=\"Joe\" lastname=\"Smith\" />"
NSQ_SOURCE_LINE 00003247 "      <person key=\"tsmith\" firstname=\"Tom\" lastname=\"Smith\" />"
NSQ_SOURCE_LINE 00003248 "      <person key=\"jbloggs\" firstname=\"Joe\" lastname=\"Bloggs\" />"
NSQ_SOURCE_LINE 00003249 "    </opt>"
NSQ_SOURCE_LINE 00003250 ""
NSQ_SOURCE_LINE 00003251 "    {"
NSQ_SOURCE_LINE 00003252 "      'person' => {"
NSQ_SOURCE_LINE 00003253 "                    'jbloggs' => {"
NSQ_SOURCE_LINE 00003254 "                                   'firstname' => 'Joe',"
NSQ_SOURCE_LINE 00003255 "                                   'lastname' => 'Bloggs'"
NSQ_SOURCE_LINE 00003256 "                                 },"
NSQ_SOURCE_LINE 00003257 "                    'tsmith' => {"
NSQ_SOURCE_LINE 00003258 "                                  'firstname' => 'Tom',"
NSQ_SOURCE_LINE 00003259 "                                  'lastname' => 'Smith'"
NSQ_SOURCE_LINE 00003260 "                                },"
NSQ_SOURCE_LINE 00003261 "                    'jsmith' => {"
NSQ_SOURCE_LINE 00003262 "                                  'firstname' => 'Joe',"
NSQ_SOURCE_LINE 00003263 "                                  'lastname' => 'Smith'"
NSQ_SOURCE_LINE 00003264 "                                }"
NSQ_SOURCE_LINE 00003265 "                  }"
NSQ_SOURCE_LINE 00003266 "    }"
NSQ_SOURCE_LINE 00003267 ""
NSQ_SOURCE_LINE 00003268 ""
NSQ_SOURCE_LINE 00003269 "The <anon> tag can be used to form anonymous arrays:"
NSQ_SOURCE_LINE 00003270 ""
NSQ_SOURCE_LINE 00003271 "    <opt>"
NSQ_SOURCE_LINE 00003272 "      <head><anon>Col 1</anon><anon>Col 2</anon><anon>Col 3</anon></head>"
NSQ_SOURCE_LINE 00003273 "      <data><anon>R1C1</anon><anon>R1C2</anon><anon>R1C3</anon></data>"
NSQ_SOURCE_LINE 00003274 "      <data><anon>R2C1</anon><anon>R2C2</anon><anon>R2C3</anon></data>"
NSQ_SOURCE_LINE 00003275 "      <data><anon>R3C1</anon><anon>R3C2</anon><anon>R3C3</anon></data>"
NSQ_SOURCE_LINE 00003276 "    </opt>"
NSQ_SOURCE_LINE 00003277 ""
NSQ_SOURCE_LINE 00003278 "    {"
NSQ_SOURCE_LINE 00003279 "      'head' => ["
NSQ_SOURCE_LINE 00003280 "                  [ 'Col 1', 'Col 2', 'Col 3' ]"
NSQ_SOURCE_LINE 00003281 "                ],"
NSQ_SOURCE_LINE 00003282 "      'data' => ["
NSQ_SOURCE_LINE 00003283 "                  [ 'R1C1', 'R1C2', 'R1C3' ],"
NSQ_SOURCE_LINE 00003284 "                  [ 'R2C1', 'R2C2', 'R2C3' ],"
NSQ_SOURCE_LINE 00003285 "                  [ 'R3C1', 'R3C2', 'R3C3' ]"
NSQ_SOURCE_LINE 00003286 "                ]"
NSQ_SOURCE_LINE 00003287 "    }"
NSQ_SOURCE_LINE 00003288 ""
NSQ_SOURCE_LINE 00003289 "Anonymous arrays can be nested to arbitrary levels and as a special case, if"
NSQ_SOURCE_LINE 00003290 "the surrounding tags for an XML document contain only an anonymous array the"
NSQ_SOURCE_LINE 00003291 "arrayref will be returned directly rather than the usual hashref:"
NSQ_SOURCE_LINE 00003292 ""
NSQ_SOURCE_LINE 00003293 "    <opt>"
NSQ_SOURCE_LINE 00003294 "      <anon><anon>Col 1</anon><anon>Col 2</anon></anon>"
NSQ_SOURCE_LINE 00003295 "      <anon><anon>R1C1</anon><anon>R1C2</anon></anon>"
NSQ_SOURCE_LINE 00003296 "      <anon><anon>R2C1</anon><anon>R2C2</anon></anon>"
NSQ_SOURCE_LINE 00003297 "    </opt>"
NSQ_SOURCE_LINE 00003298 ""
NSQ_SOURCE_LINE 00003299 "    ["
NSQ_SOURCE_LINE 00003300 "      [ 'Col 1', 'Col 2' ],"
NSQ_SOURCE_LINE 00003301 "      [ 'R1C1', 'R1C2' ],"
NSQ_SOURCE_LINE 00003302 "      [ 'R2C1', 'R2C2' ]"
NSQ_SOURCE_LINE 00003303 "    ]"
NSQ_SOURCE_LINE 00003304 ""
NSQ_SOURCE_LINE 00003305 "Elements which only contain text content will simply be represented as a"
NSQ_SOURCE_LINE 00003306 "scalar.  Where an element has both attributes and text content, the element"
NSQ_SOURCE_LINE 00003307 "will be represented as a hashref with the text content in the 'content' key"
NSQ_SOURCE_LINE 00003308 "(see the C<ContentKey> option):"
NSQ_SOURCE_LINE 00003309 ""
NSQ_SOURCE_LINE 00003310 "  <opt>"
NSQ_SOURCE_LINE 00003311 "    <one>first</one>"
NSQ_SOURCE_LINE 00003312 "    <two attr=\"value\">second</two>"
NSQ_SOURCE_LINE 00003313 "  </opt>"
NSQ_SOURCE_LINE 00003314 ""
NSQ_SOURCE_LINE 00003315 "  {"
NSQ_SOURCE_LINE 00003316 "    'one' => 'first',"
NSQ_SOURCE_LINE 00003317 "    'two' => { 'attr' => 'value', 'content' => 'second' }"
NSQ_SOURCE_LINE 00003318 "  }"
NSQ_SOURCE_LINE 00003319 ""
NSQ_SOURCE_LINE 00003320 "Mixed content (elements which contain both text content and nested elements)"
NSQ_SOURCE_LINE 00003321 "will be not be represented in a useful way - element order and significant"
NSQ_SOURCE_LINE 00003322 "whitespace will be lost.  If you need to work with mixed content, then"
NSQ_SOURCE_LINE 00003323 "XML::Simple is not the right tool for your job - check out the next section."
NSQ_SOURCE_LINE 00003324 ""
NSQ_SOURCE_LINE 00003325 "=head1 WHERE TO FROM HERE?"
NSQ_SOURCE_LINE 00003326 ""
NSQ_SOURCE_LINE 00003327 "B<XML::Simple> is able to present a simple API because it makes some"
NSQ_SOURCE_LINE 00003328 "assumptions on your behalf.  These include:"
NSQ_SOURCE_LINE 00003329 ""
NSQ_SOURCE_LINE 00003330 "=over 4"
NSQ_SOURCE_LINE 00003331 ""
NSQ_SOURCE_LINE 00003332 "=item *"
NSQ_SOURCE_LINE 00003333 ""
NSQ_SOURCE_LINE 00003334 "You're not interested in text content consisting only of whitespace"
NSQ_SOURCE_LINE 00003335 ""
NSQ_SOURCE_LINE 00003336 "=item *"
NSQ_SOURCE_LINE 00003337 ""
NSQ_SOURCE_LINE 00003338 "You don't mind that when things get slurped into a hash the order is lost"
NSQ_SOURCE_LINE 00003339 ""
NSQ_SOURCE_LINE 00003340 "=item *"
NSQ_SOURCE_LINE 00003341 ""
NSQ_SOURCE_LINE 00003342 "You don't want fine-grained control of the formatting of generated XML"
NSQ_SOURCE_LINE 00003343 ""
NSQ_SOURCE_LINE 00003344 "=item *"
NSQ_SOURCE_LINE 00003345 ""
NSQ_SOURCE_LINE 00003346 "You would never use a hash key that was not a legal XML element name"
NSQ_SOURCE_LINE 00003347 ""
NSQ_SOURCE_LINE 00003348 "=item *"
NSQ_SOURCE_LINE 00003349 ""
NSQ_SOURCE_LINE 00003350 "You don't need help converting between different encodings"
NSQ_SOURCE_LINE 00003351 ""
NSQ_SOURCE_LINE 00003352 "=back"
NSQ_SOURCE_LINE 00003353 ""
NSQ_SOURCE_LINE 00003354 "In a serious XML project, you'll probably outgrow these assumptions fairly"
NSQ_SOURCE_LINE 00003355 "quickly.  This section of the document used to offer some advice on choosing a"
NSQ_SOURCE_LINE 00003356 "more powerful option.  That advice has now grown into the 'Perl-XML FAQ'"
NSQ_SOURCE_LINE 00003357 "document which you can find at: L<http://perl-xml.sourceforge.net/faq/>"
NSQ_SOURCE_LINE 00003358 ""
NSQ_SOURCE_LINE 00003359 "The advice in the FAQ boils down to a quick explanation of tree versus"
NSQ_SOURCE_LINE 00003360 "event based parsers and then recommends:"
NSQ_SOURCE_LINE 00003361 ""
NSQ_SOURCE_LINE 00003362 "For event based parsing, use SAX (do not set out to write any new code for"
NSQ_SOURCE_LINE 00003363 "XML::Parser's handler API - it is obsolete)."
NSQ_SOURCE_LINE 00003364 ""
NSQ_SOURCE_LINE 00003365 "For tree-based parsing, you could choose between the 'Perlish' approach of"
NSQ_SOURCE_LINE 00003366 "L<XML::Twig> and more standards based DOM implementations - preferably one with"
NSQ_SOURCE_LINE 00003367 "XPath support such as L<XML::LibXML>."
NSQ_SOURCE_LINE 00003368 ""
NSQ_SOURCE_LINE 00003369 ""
NSQ_SOURCE_LINE 00003370 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00003371 ""
NSQ_SOURCE_LINE 00003372 "B<XML::Simple> requires either L<XML::Parser> or L<XML::SAX>."
NSQ_SOURCE_LINE 00003373 ""
NSQ_SOURCE_LINE 00003374 "To generate documents with namespaces, L<XML::NamespaceSupport> is required."
NSQ_SOURCE_LINE 00003375 ""
NSQ_SOURCE_LINE 00003376 "The optional caching functions require L<Storable>."
NSQ_SOURCE_LINE 00003377 ""
NSQ_SOURCE_LINE 00003378 "Answers to Frequently Asked Questions about XML::Simple are bundled with this"
NSQ_SOURCE_LINE 00003379 "distribution as: L<XML::Simple::FAQ>"
NSQ_SOURCE_LINE 00003380 ""
NSQ_SOURCE_LINE 00003381 "=head1 COPYRIGHT"
NSQ_SOURCE_LINE 00003382 ""
NSQ_SOURCE_LINE 00003383 "Copyright 1999-2004 Grant McLean E<lt>grantm@cpan.orgE<gt>"
NSQ_SOURCE_LINE 00003384 ""
NSQ_SOURCE_LINE 00003385 "This library is free software; you can redistribute it and/or modify it"
NSQ_SOURCE_LINE 00003386 "under the same terms as Perl itself."
NSQ_SOURCE_LINE 00003387 ""
NSQ_SOURCE_LINE 00003388 "=cut"
NSQ_SOURCE_LINE 00003389 ""
NSQ_SOURCE_LINE 00003390 ""
BODY_END
