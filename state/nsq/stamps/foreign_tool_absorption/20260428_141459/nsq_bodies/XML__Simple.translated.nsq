NSQ_SOURCE_LINE 00000446 "##############################################################################"
NSQ_SOURCE_LINE 00000447 "# Method: new_xml_parser()"
NSQ_SOURCE_LINE 00000448 "#"
NSQ_SOURCE_LINE 00000449 "# Simply calls the XML::Parser constructor.  Override this method to customise"
NSQ_SOURCE_LINE 00000450 "# the behaviour of the parser."
NSQ_SOURCE_LINE 00000451 "#"
NSQ_SOURCE_LINE 00000452 ""
