NSQ_SOURCE_LINE 00001933 "    my $new = ( ref $self )->from_object("
NSQ_SOURCE_LINE 00001934 "        object => $self,"
NSQ_SOURCE_LINE 00001935 "        locale => $self->{locale},"
NSQ_SOURCE_LINE 00001936 "        ( $self->{formatter} ? ( formatter => $self->{formatter} ) : () ),"
NSQ_SOURCE_LINE 00001937 "    );"
