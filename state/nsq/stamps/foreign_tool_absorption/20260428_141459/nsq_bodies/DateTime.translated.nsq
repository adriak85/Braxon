NSQ_SOURCE_LINE 00001459 ""
NSQ_SOURCE_LINE 00001460 "sub hires_epoch {"
NSQ_SOURCE_LINE 00001461 "    my $self = shift;"
NSQ_SOURCE_LINE 00001462 ""
