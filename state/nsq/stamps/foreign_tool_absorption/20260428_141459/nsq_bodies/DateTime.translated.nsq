NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 "    return $self->{utc_c}{epoch}"
NSQ_SOURCE_LINE 00001456 "        = ( $self->{utc_rd_days} - 719163 ) * SECONDS_PER_DAY"
