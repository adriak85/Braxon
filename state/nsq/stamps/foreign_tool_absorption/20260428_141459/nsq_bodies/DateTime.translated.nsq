NSQ_SOURCE_LINE 00000170 "                optional => 1,"
NSQ_SOURCE_LINE 00000171 "            },"
NSQ_SOURCE_LINE 00000172 "        },"
NSQ_SOURCE_LINE 00000173 "    );"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    sub new {"
NSQ_SOURCE_LINE 00000176 "        my $class = shift;"
NSQ_SOURCE_LINE 00000177 "        my %p     = $validator->(@_);"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "        Carp::croak("
NSQ_SOURCE_LINE 00000180 "            \"Invalid day of month (day = $p{day} - month = $p{month} - year = $p{year})\\n\""
NSQ_SOURCE_LINE 00000181 "            )"
NSQ_SOURCE_LINE 00000182 "            if $p{day} > 28"
NSQ_SOURCE_LINE 00000183 "            && $p{day} > $class->_month_length( $p{year}, $p{month} );"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "        return $class->_new(%p);"
NSQ_SOURCE_LINE 00000186 "    }"
NSQ_SOURCE_LINE 00000187 "}"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "sub _new {"
NSQ_SOURCE_LINE 00000190 "    my $class = shift;"
NSQ_SOURCE_LINE 00000191 "    my %p     = @_;"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    Carp::croak('Constructor called with reference, we expected a package')"
NSQ_SOURCE_LINE 00000194 "        if ref $class;"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "    # If this method is called from somewhere other than new(), then some of"
NSQ_SOURCE_LINE 00000197 "    # these defaults may not get applied."
NSQ_SOURCE_LINE 00000198 "    $p{month}      = 1                          unless exists $p{month};"
NSQ_SOURCE_LINE 00000199 "    $p{day}        = 1                          unless exists $p{day};"
NSQ_SOURCE_LINE 00000200 "    $p{hour}       = 0                          unless exists $p{hour};"
NSQ_SOURCE_LINE 00000201 "    $p{minute}     = 0                          unless exists $p{minute};"
NSQ_SOURCE_LINE 00000202 "    $p{second}     = 0                          unless exists $p{second};"
NSQ_SOURCE_LINE 00000203 "    $p{nanosecond} = 0                          unless exists $p{nanosecond};"
NSQ_SOURCE_LINE 00000204 "    $p{time_zone}  = $class->_default_time_zone unless exists $p{time_zone};"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    my $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    $self->_set_locale( $p{locale} );"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    $self->{tz} = ("
NSQ_SOURCE_LINE 00000211 "        ref $p{time_zone}"
NSQ_SOURCE_LINE 00000212 "        ? $p{time_zone}"
NSQ_SOURCE_LINE 00000213 "        : DateTime::TimeZone->new( name => $p{time_zone} )"
NSQ_SOURCE_LINE 00000214 "    );"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    $self->{local_rd_days} = $class->_ymd2rd( @p{qw( year month day )} );"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "    $self->{local_rd_secs}"
NSQ_SOURCE_LINE 00000219 "        = $class->_time_as_seconds( @p{qw( hour minute second )} );"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "    $self->{offset_modifier} = 0;"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "    $self->{rd_nanosecs} = $p{nanosecond};"
NSQ_SOURCE_LINE 00000224 "    $self->{formatter}   = $p{formatter};"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "    $self->_normalize_nanoseconds("
NSQ_SOURCE_LINE 00000227 "        $self->{local_rd_secs},"
NSQ_SOURCE_LINE 00000228 "        $self->{rd_nanosecs}"
NSQ_SOURCE_LINE 00000229 "    );"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "    # Set this explicitly since it can't be calculated accurately"
NSQ_SOURCE_LINE 00000232 "    # without knowing our time zone offset, and it's possible that the"
NSQ_SOURCE_LINE 00000233 "    # offset can't be calculated without having at least a rough guess"
NSQ_SOURCE_LINE 00000234 "    # of the datetime's year. This year need not be correct, as long"
NSQ_SOURCE_LINE 00000235 "    # as its equal or greater to the correct number, so we fudge by"
NSQ_SOURCE_LINE 00000236 "    # adding one to the local year given to the constructor."
NSQ_SOURCE_LINE 00000237 "    $self->{utc_year} = $p{year} + 1;"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "    $self->_maybe_future_dst_warning( $p{year}, $p{time_zone} );"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    $self->_calc_utc_rd;"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "    $self->_handle_offset_modifier( $p{second} );"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "    $self->_calc_local_rd;"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    if ( $p{second} > 59 ) {"
NSQ_SOURCE_LINE 00000248 "        if ("
NSQ_SOURCE_LINE 00000249 "            $self->{tz}->is_floating"
NSQ_SOURCE_LINE 00000250 "            ||"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "            # If true, this means that the actual calculated leap"
NSQ_SOURCE_LINE 00000253 "            # second does not occur in the second given to new()"
NSQ_SOURCE_LINE 00000254 "            ( $self->{utc_rd_secs} - 86399 < $p{second} - 59 )"
NSQ_SOURCE_LINE 00000255 "        ) {"
NSQ_SOURCE_LINE 00000256 "            Carp::croak(\"Invalid second value ($p{second})\\n\");"
NSQ_SOURCE_LINE 00000257 "        }"
NSQ_SOURCE_LINE 00000258 "    }"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "    return $self;"
NSQ_SOURCE_LINE 00000261 "}"
NSQ_SOURCE_LINE 00000262 ""
