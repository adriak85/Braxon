NSQ_SOURCE_LINE 00000459 "{"
NSQ_SOURCE_LINE 00000460 "    my $named_validator = validation_for("
NSQ_SOURCE_LINE 00000461 "        name             => '_check_named_from_epoch_params',"
NSQ_SOURCE_LINE 00000462 "        name_is_optional => 1,"
NSQ_SOURCE_LINE 00000463 "        params           => {"
NSQ_SOURCE_LINE 00000464 "            epoch     => { type => t('Num') },"
NSQ_SOURCE_LINE 00000465 "            formatter => {"
NSQ_SOURCE_LINE 00000466 "                type     => t('Formatter'),"
NSQ_SOURCE_LINE 00000467 "                optional => 1"
NSQ_SOURCE_LINE 00000468 "            },"
NSQ_SOURCE_LINE 00000469 "            locale => {"
NSQ_SOURCE_LINE 00000470 "                type     => t('Locale'),"
NSQ_SOURCE_LINE 00000471 "                optional => 1"
NSQ_SOURCE_LINE 00000472 "            },"
NSQ_SOURCE_LINE 00000473 "            time_zone => {"
NSQ_SOURCE_LINE 00000474 "                type     => t('TimeZone'),"
NSQ_SOURCE_LINE 00000475 "                optional => 1"
NSQ_SOURCE_LINE 00000476 "            },"
NSQ_SOURCE_LINE 00000477 "        },"
NSQ_SOURCE_LINE 00000478 "    );"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "    my $one_param_validator = validation_for("
NSQ_SOURCE_LINE 00000481 "        name             => '_check_one_from_epoch_param',"
NSQ_SOURCE_LINE 00000482 "        name_is_optional => 1,"
NSQ_SOURCE_LINE 00000483 "        params           => [ { type => t('Num') } ],"
NSQ_SOURCE_LINE 00000484 "    );"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "    sub from_epoch {"
NSQ_SOURCE_LINE 00000487 "        my $class = shift;"
NSQ_SOURCE_LINE 00000488 "        my %p;"
NSQ_SOURCE_LINE 00000489 "        if ( @_ == 1 && !is_HashRef( $_[0] ) ) {"
NSQ_SOURCE_LINE 00000490 "            ( $p{epoch} ) = $one_param_validator->(@_);"
NSQ_SOURCE_LINE 00000491 "        }"
NSQ_SOURCE_LINE 00000492 "        else {"
NSQ_SOURCE_LINE 00000493 "            %p = $named_validator->(@_);"
NSQ_SOURCE_LINE 00000494 "        }"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "        my %args;"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "        # This does two things. First, if given a negative non-integer epoch,"
NSQ_SOURCE_LINE 00000499 "        # it will round the epoch _down_ to the next second and then adjust"
NSQ_SOURCE_LINE 00000500 "        # the nanoseconds to be positive. In other words, -0.5 corresponds to"
NSQ_SOURCE_LINE 00000501 "        # a second of -1 and a nanosecond value of 500,000. Before this code"
NSQ_SOURCE_LINE 00000502 "        # was implemented our handling of negative non-integer epochs was"
NSQ_SOURCE_LINE 00000503 "        # quite broken, and would end up rounding some values up, so that -0.5"
NSQ_SOURCE_LINE 00000504 "        # become 0.5 (which is obviously wrong!)."
NSQ_SOURCE_LINE 00000505 "        #"
NSQ_SOURCE_LINE 00000506 "        # Second, it rounds any decimal values to the nearest microsecond"
NSQ_SOURCE_LINE 00000507 "        # (1E6). Here's what Christian Hansen, who wrote this patch, says:"
NSQ_SOURCE_LINE 00000508 "        #"
NSQ_SOURCE_LINE 00000509 "        #     Perl is typically compiled with NV as a double. A double with a"
NSQ_SOURCE_LINE 00000510 "        #     significand precision of 53 bits can only represent a nanosecond"
NSQ_SOURCE_LINE 00000511 "        #     epoch without loss of precision if the duration from zero epoch"
NSQ_SOURCE_LINE 00000512 "        #     is less than ≈ ±104 days. With microseconds the duration is"
NSQ_SOURCE_LINE 00000513 "        #     ±104,000 days, which is ≈ ±285 years."
NSQ_SOURCE_LINE 00000514 "        if ( int $p{epoch} != $p{epoch} ) {"
NSQ_SOURCE_LINE 00000515 "            my ( $floor, $nano, $second );"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "            $floor  = $nano = fmod( $p{epoch}, 1.0 );"
NSQ_SOURCE_LINE 00000518 "            $second = floor( $p{epoch} - $floor );"
NSQ_SOURCE_LINE 00000519 "            if ( $nano < 0 ) {"
NSQ_SOURCE_LINE 00000520 "                $nano += 1;"
NSQ_SOURCE_LINE 00000521 "            }"
NSQ_SOURCE_LINE 00000522 "            $p{epoch}         = $second + floor( $floor - $nano );"
NSQ_SOURCE_LINE 00000523 "            $args{nanosecond} = floor( $nano * 1E6 + 0.5 ) * 1E3;"
NSQ_SOURCE_LINE 00000524 "        }"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "        # Note, for very large negative values this may give a"
NSQ_SOURCE_LINE 00000527 "        # blatantly wrong answer."
NSQ_SOURCE_LINE 00000528 "        @args{qw( second minute hour day month year )}"
NSQ_SOURCE_LINE 00000529 "            = ( gmtime( $p{epoch} ) )[ 0 .. 5 ];"
NSQ_SOURCE_LINE 00000530 "        $args{year} += 1900;"
NSQ_SOURCE_LINE 00000531 "        $args{month}++;"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "        my $self = $class->_new( %p, %args, time_zone => 'UTC' );"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "        $self->_maybe_future_dst_warning( $self->year, $p{time_zone} );"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "        $self->set_time_zone( $p{time_zone} ) if exists $p{time_zone};"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "        return $self;"
NSQ_SOURCE_LINE 00000540 "    }"
NSQ_SOURCE_LINE 00000541 "}"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "sub now {"
NSQ_SOURCE_LINE 00000544 "    my $class = shift;"
NSQ_SOURCE_LINE 00000545 "    return $class->from_epoch( epoch => $class->_core_time, @_ );"
NSQ_SOURCE_LINE 00000546 "}"
