NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "sub _set_locale {"
NSQ_SOURCE_LINE 00000270 "    my $self   = shift;"
NSQ_SOURCE_LINE 00000271 "    my $locale = shift;"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "    if ( defined $locale && ref $locale ) {"
