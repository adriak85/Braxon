NSQ_SOURCE_LINE 00001944 "sub _compare_overload {"
NSQ_SOURCE_LINE 00001945 ""
NSQ_SOURCE_LINE 00001946 "    # note: $_[1]->compare( $_[0] ) is an error when $_[1] is not a"
NSQ_SOURCE_LINE 00001947 "    # DateTime (such as the INFINITY value)"
NSQ_SOURCE_LINE 00001948 ""
NSQ_SOURCE_LINE 00001949 "    return undef unless defined $_[1];"
NSQ_SOURCE_LINE 00001950 ""
NSQ_SOURCE_LINE 00001951 "    return $_[2] ? -$_[0]->compare( $_[1] ) : $_[0]->compare( $_[1] );"
NSQ_SOURCE_LINE 00001952 "}"
NSQ_SOURCE_LINE 00001953 ""
NSQ_SOURCE_LINE 00001954 "sub _string_compare_overload {"
NSQ_SOURCE_LINE 00001955 "    my ( $dt1, $dt2, $flip ) = @_;"
NSQ_SOURCE_LINE 00001956 ""
NSQ_SOURCE_LINE 00001957 "    # One is a DateTime object, one isn't. Just stringify and compare."
NSQ_SOURCE_LINE 00001958 "    if ( !DateTime::Helpers::can( $dt2, 'utc_rd_values' ) ) {"
NSQ_SOURCE_LINE 00001959 "        my $sign = $flip ? -1 : 1;"
NSQ_SOURCE_LINE 00001960 "        return $sign * ( \"$dt1\" cmp \"$dt2\" );"
NSQ_SOURCE_LINE 00001961 "    }"
NSQ_SOURCE_LINE 00001962 "    else {"
NSQ_SOURCE_LINE 00001963 "        my $meth = $dt1->can('_compare_overload');"
NSQ_SOURCE_LINE 00001964 "        goto $meth;"
NSQ_SOURCE_LINE 00001965 "    }"
NSQ_SOURCE_LINE 00001966 "}"
NSQ_SOURCE_LINE 00001967 ""
NSQ_SOURCE_LINE 00001968 "sub compare {"
NSQ_SOURCE_LINE 00001969 "    shift->_compare( @_, 0 );"
NSQ_SOURCE_LINE 00001970 "}"
NSQ_SOURCE_LINE 00001971 ""
NSQ_SOURCE_LINE 00001972 "sub compare_ignore_floating {"
NSQ_SOURCE_LINE 00001973 "    shift->_compare( @_, 1 );"
NSQ_SOURCE_LINE 00001974 "}"
NSQ_SOURCE_LINE 00001975 ""
NSQ_SOURCE_LINE 00001976 "sub _compare {"
NSQ_SOURCE_LINE 00001977 "    my ( undef, $dt1, $dt2, $consistent ) = ref $_[0] ? ( undef, @_ ) : @_;"
NSQ_SOURCE_LINE 00001978 ""
NSQ_SOURCE_LINE 00001979 "    return undef unless defined $dt2;"
NSQ_SOURCE_LINE 00001980 ""
NSQ_SOURCE_LINE 00001981 "    if ( !ref $dt2 && ( $dt2 == INFINITY || $dt2 == NEG_INFINITY ) ) {"
NSQ_SOURCE_LINE 00001982 "        return $dt1->{utc_rd_days} <=> $dt2;"
NSQ_SOURCE_LINE 00001983 "    }"
NSQ_SOURCE_LINE 00001984 ""
NSQ_SOURCE_LINE 00001985 "    unless ( DateTime::Helpers::can( $dt1, 'utc_rd_values' )"
NSQ_SOURCE_LINE 00001986 "        && DateTime::Helpers::can( $dt2, 'utc_rd_values' ) ) {"
NSQ_SOURCE_LINE 00001987 "        my $dt1_string = overload::StrVal($dt1);"
NSQ_SOURCE_LINE 00001988 "        my $dt2_string = overload::StrVal($dt2);"
NSQ_SOURCE_LINE 00001989 ""
NSQ_SOURCE_LINE 00001990 "        Carp::croak( 'A DateTime object can only be compared to'"
NSQ_SOURCE_LINE 00001991 "                . \" another DateTime object ($dt1_string, $dt2_string).\" );"
NSQ_SOURCE_LINE 00001992 "    }"
NSQ_SOURCE_LINE 00001993 ""
NSQ_SOURCE_LINE 00001994 "    if (   !$consistent"
NSQ_SOURCE_LINE 00001995 "        && DateTime::Helpers::can( $dt1, 'time_zone' )"
NSQ_SOURCE_LINE 00001996 "        && DateTime::Helpers::can( $dt2, 'time_zone' ) ) {"
NSQ_SOURCE_LINE 00001997 "        my $is_floating1 = $dt1->time_zone->is_floating;"
NSQ_SOURCE_LINE 00001998 "        my $is_floating2 = $dt2->time_zone->is_floating;"
NSQ_SOURCE_LINE 00001999 ""
NSQ_SOURCE_LINE 00002000 "        if ( $is_floating1 && !$is_floating2 ) {"
NSQ_SOURCE_LINE 00002001 "            $dt1 = $dt1->clone->set_time_zone( $dt2->time_zone );"
NSQ_SOURCE_LINE 00002002 "        }"
NSQ_SOURCE_LINE 00002003 "        elsif ( $is_floating2 && !$is_floating1 ) {"
NSQ_SOURCE_LINE 00002004 "            $dt2 = $dt2->clone->set_time_zone( $dt1->time_zone );"
NSQ_SOURCE_LINE 00002005 "        }"
NSQ_SOURCE_LINE 00002006 "    }"
NSQ_SOURCE_LINE 00002007 ""
NSQ_SOURCE_LINE 00002008 "    my @dt1_components = $dt1->utc_rd_values;"
NSQ_SOURCE_LINE 00002009 "    my @dt2_components = $dt2->utc_rd_values;"
NSQ_SOURCE_LINE 00002010 ""
NSQ_SOURCE_LINE 00002011 "    for my $i ( 0 .. 2 ) {"
NSQ_SOURCE_LINE 00002012 "        return $dt1_components[$i] <=> $dt2_components[$i]"
NSQ_SOURCE_LINE 00002013 "            if $dt1_components[$i] != $dt2_components[$i];"
NSQ_SOURCE_LINE 00002014 "    }"
NSQ_SOURCE_LINE 00002015 ""
NSQ_SOURCE_LINE 00002016 "    return 0;"
NSQ_SOURCE_LINE 00002017 "}"
NSQ_SOURCE_LINE 00002018 ""
NSQ_SOURCE_LINE 00002019 "sub is_between {"
NSQ_SOURCE_LINE 00002020 "    my $self  = shift;"
NSQ_SOURCE_LINE 00002021 "    my $lower = shift;"
NSQ_SOURCE_LINE 00002022 "    my $upper = shift;"
NSQ_SOURCE_LINE 00002023 ""
NSQ_SOURCE_LINE 00002024 "    return $self->compare($lower) > 0 && $self->compare($upper) < 0;"
NSQ_SOURCE_LINE 00002025 "}"
NSQ_SOURCE_LINE 00002026 ""
NSQ_SOURCE_LINE 00002027 "sub _string_equals_overload {"
NSQ_SOURCE_LINE 00002028 "    my ( $class, $dt1, $dt2 ) = ref $_[0] ? ( undef, @_ ) : @_;"
NSQ_SOURCE_LINE 00002029 ""
NSQ_SOURCE_LINE 00002030 "    if ( !DateTime::Helpers::can( $dt2, 'utc_rd_values' ) ) {"
NSQ_SOURCE_LINE 00002031 "        return \"$dt1\" eq \"$dt2\";"
NSQ_SOURCE_LINE 00002032 "    }"
NSQ_SOURCE_LINE 00002033 ""
NSQ_SOURCE_LINE 00002034 "    $class ||= ref $dt1;"
NSQ_SOURCE_LINE 00002035 "    return !$class->compare( $dt1, $dt2 );"
NSQ_SOURCE_LINE 00002036 "}"
NSQ_SOURCE_LINE 00002037 ""
NSQ_SOURCE_LINE 00002038 "sub _string_not_equals_overload {"
