NSQ_SOURCE_LINE 00002163 "    }"
NSQ_SOURCE_LINE 00002164 "}"
NSQ_SOURCE_LINE 00002165 ""
NSQ_SOURCE_LINE 00002166 "{"
NSQ_SOURCE_LINE 00002167 "    my %TruncateDefault = ("
NSQ_SOURCE_LINE 00002168 "        month      => 1,"
NSQ_SOURCE_LINE 00002169 "        day        => 1,"
NSQ_SOURCE_LINE 00002170 "        hour       => 0,"
NSQ_SOURCE_LINE 00002171 "        minute     => 0,"
NSQ_SOURCE_LINE 00002172 "        second     => 0,"
NSQ_SOURCE_LINE 00002173 "        nanosecond => 0,"
NSQ_SOURCE_LINE 00002174 "    );"
NSQ_SOURCE_LINE 00002175 ""
NSQ_SOURCE_LINE 00002176 "    my $validator = validation_for("
NSQ_SOURCE_LINE 00002177 "        name             => '_check_truncate_params',"
NSQ_SOURCE_LINE 00002178 "        name_is_optional => 1,"
NSQ_SOURCE_LINE 00002179 "        params           => {"
NSQ_SOURCE_LINE 00002180 "            to => { type => t('TruncationLevel') },"
NSQ_SOURCE_LINE 00002181 "        },"
NSQ_SOURCE_LINE 00002182 "    );"
NSQ_SOURCE_LINE 00002183 ""
NSQ_SOURCE_LINE 00002184 "    my $re = join '|', 'year', 'week', 'local_week', 'quarter',"
NSQ_SOURCE_LINE 00002185 "        grep { $_ ne 'nanosecond' } keys %TruncateDefault;"
NSQ_SOURCE_LINE 00002186 "    my $spec = { to => { regex => qr/^(?:$re)$/ } };"
NSQ_SOURCE_LINE 00002187 ""
NSQ_SOURCE_LINE 00002188 "    ## no critic (Subroutines::ProhibitBuiltinHomonyms)"
NSQ_SOURCE_LINE 00002189 "    sub truncate {"
NSQ_SOURCE_LINE 00002190 "        my $self = shift;"
NSQ_SOURCE_LINE 00002191 "        my %p    = $validator->(@_);"
NSQ_SOURCE_LINE 00002192 ""
NSQ_SOURCE_LINE 00002193 "        my %new;"
NSQ_SOURCE_LINE 00002194 "        if ( $p{to} eq 'week' || $p{to} eq 'local_week' ) {"
NSQ_SOURCE_LINE 00002195 "            my $first_day_of_week"
NSQ_SOURCE_LINE 00002196 "                = ( $p{to} eq 'local_week' )"
NSQ_SOURCE_LINE 00002197 "                ? $self->{locale}->first_day_of_week"
NSQ_SOURCE_LINE 00002198 "                : 1;"
NSQ_SOURCE_LINE 00002199 ""
NSQ_SOURCE_LINE 00002200 "            my $day_diff = ( $self->day_of_week - $first_day_of_week ) % 7;"
NSQ_SOURCE_LINE 00002201 ""
NSQ_SOURCE_LINE 00002202 "            if ($day_diff) {"
NSQ_SOURCE_LINE 00002203 "                $self->add( days => -1 * $day_diff );"
NSQ_SOURCE_LINE 00002204 "            }"
NSQ_SOURCE_LINE 00002205 ""
NSQ_SOURCE_LINE 00002206 "            # This can fail if the truncate ends up giving us an invalid local"
NSQ_SOURCE_LINE 00002207 "            # date time. If that happens we need to reverse the addition we"
NSQ_SOURCE_LINE 00002208 "            # just did. See https://rt.cpan.org/Ticket/Display.html?id=93347."
NSQ_SOURCE_LINE 00002209 "            try {"
NSQ_SOURCE_LINE 00002210 "                $self->truncate( to => 'day' );"
NSQ_SOURCE_LINE 00002211 "            }"
NSQ_SOURCE_LINE 00002212 "            catch {"
NSQ_SOURCE_LINE 00002213 "                $self->add( days => $day_diff );"
NSQ_SOURCE_LINE 00002214 "                die $_;"
NSQ_SOURCE_LINE 00002215 "            };"
NSQ_SOURCE_LINE 00002216 "        }"
NSQ_SOURCE_LINE 00002217 "        elsif ( $p{to} eq 'quarter' ) {"
NSQ_SOURCE_LINE 00002218 "            %new = ("
NSQ_SOURCE_LINE 00002219 "                year       => $self->year,"
NSQ_SOURCE_LINE 00002220 "                month      => int( ( $self->month - 1 ) / 3 ) * 3 + 1,"
NSQ_SOURCE_LINE 00002221 "                day        => 1,"
NSQ_SOURCE_LINE 00002222 "                hour       => 0,"
NSQ_SOURCE_LINE 00002223 "                minute     => 0,"
NSQ_SOURCE_LINE 00002224 "                second     => 0,"
NSQ_SOURCE_LINE 00002225 "                nanosecond => 0,"
NSQ_SOURCE_LINE 00002226 "            );"
NSQ_SOURCE_LINE 00002227 "        }"
NSQ_SOURCE_LINE 00002228 "        else {"
NSQ_SOURCE_LINE 00002229 "            my $truncate;"
NSQ_SOURCE_LINE 00002230 "            for my $f (qw( year month day hour minute second nanosecond )) {"
NSQ_SOURCE_LINE 00002231 "                $new{$f} = $truncate ? $TruncateDefault{$f} : $self->$f();"
NSQ_SOURCE_LINE 00002232 ""
NSQ_SOURCE_LINE 00002233 "                $truncate = 1 if $p{to} eq $f;"
NSQ_SOURCE_LINE 00002234 "            }"
NSQ_SOURCE_LINE 00002235 "        }"
NSQ_SOURCE_LINE 00002236 ""
NSQ_SOURCE_LINE 00002237 "        my $new_dt = $self->_new_from_self( %new, _skip_validation => 1 );"
NSQ_SOURCE_LINE 00002238 ""
NSQ_SOURCE_LINE 00002239 "        %$self = %$new_dt;"
NSQ_SOURCE_LINE 00002240 ""
NSQ_SOURCE_LINE 00002241 "        return $self;"
NSQ_SOURCE_LINE 00002242 "    }"
NSQ_SOURCE_LINE 00002243 "}"
NSQ_SOURCE_LINE 00002244 ""
NSQ_SOURCE_LINE 00002245 "sub set_time_zone {"
NSQ_SOURCE_LINE 00002246 "    my ( $self, $tz ) = @_;"
NSQ_SOURCE_LINE 00002247 ""
NSQ_SOURCE_LINE 00002248 "    if ( ref $tz ) {"
NSQ_SOURCE_LINE 00002249 ""
NSQ_SOURCE_LINE 00002250 "        # This is a bit of a hack but it works because time zone objects"
NSQ_SOURCE_LINE 00002251 "        # are singletons, and if it doesn't work all we lose is a little"
NSQ_SOURCE_LINE 00002252 "        # bit of speed."
NSQ_SOURCE_LINE 00002253 "        return $self if $self->{tz} eq $tz;"
NSQ_SOURCE_LINE 00002254 "    }"
NSQ_SOURCE_LINE 00002255 "    else {"
NSQ_SOURCE_LINE 00002256 "        return $self if $self->{tz}->name eq $tz;"
NSQ_SOURCE_LINE 00002257 "    }"
NSQ_SOURCE_LINE 00002258 ""
NSQ_SOURCE_LINE 00002259 "    my $was_floating = $self->{tz}->is_floating;"
NSQ_SOURCE_LINE 00002260 ""
NSQ_SOURCE_LINE 00002261 "    my $old_tz = $self->{tz};"
NSQ_SOURCE_LINE 00002262 "    $self->{tz} = ref $tz ? $tz : DateTime::TimeZone->new( name => $tz );"
NSQ_SOURCE_LINE 00002263 ""
NSQ_SOURCE_LINE 00002264 "    $self->_handle_offset_modifier( $self->second, 1 );"
NSQ_SOURCE_LINE 00002265 ""
NSQ_SOURCE_LINE 00002266 "    my $e;"
NSQ_SOURCE_LINE 00002267 "    try {"
NSQ_SOURCE_LINE 00002268 "        # if it either was or now is floating (but not both)"
NSQ_SOURCE_LINE 00002269 "        if ( $self->{tz}->is_floating xor $was_floating ) {"
NSQ_SOURCE_LINE 00002270 "            $self->_calc_utc_rd;"
NSQ_SOURCE_LINE 00002271 "        }"
NSQ_SOURCE_LINE 00002272 "        elsif ( !$was_floating ) {"
NSQ_SOURCE_LINE 00002273 "            $self->_calc_local_rd;"
NSQ_SOURCE_LINE 00002274 "        }"
NSQ_SOURCE_LINE 00002275 "    }"
NSQ_SOURCE_LINE 00002276 "    catch {"
NSQ_SOURCE_LINE 00002277 "        $e = $_;"
NSQ_SOURCE_LINE 00002278 "    };"
NSQ_SOURCE_LINE 00002279 ""
NSQ_SOURCE_LINE 00002280 "    # If we can't recalc the RD values then we shouldn't keep the new TZ. RT"
NSQ_SOURCE_LINE 00002281 "    # #83940"
NSQ_SOURCE_LINE 00002282 "    if ($e) {"
NSQ_SOURCE_LINE 00002283 "        $self->{tz} = $old_tz;"
NSQ_SOURCE_LINE 00002284 "        die $e;"
NSQ_SOURCE_LINE 00002285 "    }"
NSQ_SOURCE_LINE 00002286 ""
NSQ_SOURCE_LINE 00002287 "    return $self;"
NSQ_SOURCE_LINE 00002288 "}"
NSQ_SOURCE_LINE 00002289 ""
NSQ_SOURCE_LINE 00002290 "sub STORABLE_freeze {"
NSQ_SOURCE_LINE 00002291 "    my $self = shift;"
NSQ_SOURCE_LINE 00002292 ""
NSQ_SOURCE_LINE 00002293 "    my $serialized = q{};"
NSQ_SOURCE_LINE 00002294 "    for my $key ("
NSQ_SOURCE_LINE 00002295 "        qw( utc_rd_days"
NSQ_SOURCE_LINE 00002296 "        utc_rd_secs"
NSQ_SOURCE_LINE 00002297 "        rd_nanosecs )"
NSQ_SOURCE_LINE 00002298 "    ) {"
NSQ_SOURCE_LINE 00002299 "        $serialized .= \"$key:$self->{$key}|\";"
NSQ_SOURCE_LINE 00002300 "    }"
NSQ_SOURCE_LINE 00002301 ""
NSQ_SOURCE_LINE 00002302 "    # not used yet, but may be handy in the future."
NSQ_SOURCE_LINE 00002303 "    $serialized .= 'version:' . ( $DateTime::VERSION || 'git' );"
NSQ_SOURCE_LINE 00002304 ""
NSQ_SOURCE_LINE 00002305 "    # Formatter needs to be returned as a reference since it may be"
NSQ_SOURCE_LINE 00002306 "    # undef or a class name, and Storable will complain if extra"
NSQ_SOURCE_LINE 00002307 "    # return values aren't refs"
NSQ_SOURCE_LINE 00002308 "    return $serialized, $self->{locale}, $self->{tz}, \\$self->{formatter};"
NSQ_SOURCE_LINE 00002309 "}"
NSQ_SOURCE_LINE 00002310 ""
NSQ_SOURCE_LINE 00002311 "sub STORABLE_thaw {"
NSQ_SOURCE_LINE 00002312 "    my $self = shift;"
NSQ_SOURCE_LINE 00002313 "    shift;"
NSQ_SOURCE_LINE 00002314 "    my $serialized = shift;"
NSQ_SOURCE_LINE 00002315 ""
NSQ_SOURCE_LINE 00002316 "    my %serialized = map { split /:/ } split /\\|/, $serialized;"
NSQ_SOURCE_LINE 00002317 ""
NSQ_SOURCE_LINE 00002318 "    my ( $locale, $tz, $formatter );"
NSQ_SOURCE_LINE 00002319 ""
NSQ_SOURCE_LINE 00002320 "    # more recent code version"
NSQ_SOURCE_LINE 00002321 "    if (@_) {"
NSQ_SOURCE_LINE 00002322 "        ( $locale, $tz, $formatter ) = @_;"
NSQ_SOURCE_LINE 00002323 "    }"
NSQ_SOURCE_LINE 00002324 "    else {"
NSQ_SOURCE_LINE 00002325 "        $tz = DateTime::TimeZone->new( name => delete $serialized{tz} );"
NSQ_SOURCE_LINE 00002326 ""
NSQ_SOURCE_LINE 00002327 "        $locale = DateTime::Locale->load( delete $serialized{locale} );"
NSQ_SOURCE_LINE 00002328 "    }"
NSQ_SOURCE_LINE 00002329 ""
NSQ_SOURCE_LINE 00002330 "    delete $serialized{version};"
NSQ_SOURCE_LINE 00002331 ""
NSQ_SOURCE_LINE 00002332 "    my $object = bless {"
NSQ_SOURCE_LINE 00002333 "        utc_vals => ["
NSQ_SOURCE_LINE 00002334 "            $serialized{utc_rd_days},"
NSQ_SOURCE_LINE 00002335 "            $serialized{utc_rd_secs},"
NSQ_SOURCE_LINE 00002336 "            $serialized{rd_nanosecs},"
NSQ_SOURCE_LINE 00002337 "        ],"
NSQ_SOURCE_LINE 00002338 "        tz => $tz,"
NSQ_SOURCE_LINE 00002339 "        },"
NSQ_SOURCE_LINE 00002340 "        'DateTime::_Thawed';"
NSQ_SOURCE_LINE 00002341 ""
NSQ_SOURCE_LINE 00002342 "    my %formatter = defined $$formatter ? ( formatter => $$formatter ) : ();"
NSQ_SOURCE_LINE 00002343 "    my $new       = ( ref $self )->from_object("
NSQ_SOURCE_LINE 00002344 "        object => $object,"
NSQ_SOURCE_LINE 00002345 "        locale => $locale,"
NSQ_SOURCE_LINE 00002346 "        %formatter,"
NSQ_SOURCE_LINE 00002347 "    );"
NSQ_SOURCE_LINE 00002348 ""
NSQ_SOURCE_LINE 00002349 "    %$self = %$new;"
NSQ_SOURCE_LINE 00002350 ""
NSQ_SOURCE_LINE 00002351 "    return $self;"
NSQ_SOURCE_LINE 00002352 "}"
NSQ_SOURCE_LINE 00002353 ""
NSQ_SOURCE_LINE 00002354 "## no critic (Modules::ProhibitMultiplePackages)"
NSQ_SOURCE_LINE 00002355 "package    # hide from PAUSE"
NSQ_SOURCE_LINE 00002356 "    DateTime::_Thawed;"
NSQ_SOURCE_LINE 00002357 ""
NSQ_SOURCE_LINE 00002358 "sub utc_rd_values { @{ $_[0]->{utc_vals} } }"
NSQ_SOURCE_LINE 00002359 ""
NSQ_SOURCE_LINE 00002360 "sub time_zone { $_[0]->{tz} }"
NSQ_SOURCE_LINE 00002361 ""
NSQ_SOURCE_LINE 00002362 "1;"
NSQ_SOURCE_LINE 00002363 ""
NSQ_SOURCE_LINE 00002364 "# ABSTRACT: A date and time object for Perl"
NSQ_SOURCE_LINE 00002365 ""
NSQ_SOURCE_LINE 00002366 "__END__"
NSQ_SOURCE_LINE 00002367 ""
NSQ_SOURCE_LINE 00002368 "=pod"
NSQ_SOURCE_LINE 00002369 ""
NSQ_SOURCE_LINE 00002370 "=encoding UTF-8"
NSQ_SOURCE_LINE 00002371 ""
NSQ_SOURCE_LINE 00002372 "=head1 NAME"
NSQ_SOURCE_LINE 00002373 ""
NSQ_SOURCE_LINE 00002374 "DateTime - A date and time object for Perl"
NSQ_SOURCE_LINE 00002375 ""
NSQ_SOURCE_LINE 00002376 "=head1 VERSION"
NSQ_SOURCE_LINE 00002377 ""
NSQ_SOURCE_LINE 00002378 "version 1.66"
NSQ_SOURCE_LINE 00002379 ""
NSQ_SOURCE_LINE 00002380 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00002381 ""
NSQ_SOURCE_LINE 00002382 "    use DateTime;"
NSQ_SOURCE_LINE 00002383 ""
NSQ_SOURCE_LINE 00002384 "    $dt = DateTime->new("
NSQ_SOURCE_LINE 00002385 "        year       => 1964,"
NSQ_SOURCE_LINE 00002386 "        month      => 10,"
NSQ_SOURCE_LINE 00002387 "        day        => 16,"
NSQ_SOURCE_LINE 00002388 "        hour       => 16,"
NSQ_SOURCE_LINE 00002389 "        minute     => 12,"
NSQ_SOURCE_LINE 00002390 "        second     => 47,"
NSQ_SOURCE_LINE 00002391 "        nanosecond => 500000000,"
NSQ_SOURCE_LINE 00002392 "        time_zone  => 'Asia/Taipei',"
NSQ_SOURCE_LINE 00002393 "    );"
NSQ_SOURCE_LINE 00002394 ""
NSQ_SOURCE_LINE 00002395 "    $dt = DateTime->from_epoch( epoch => $epoch );"
NSQ_SOURCE_LINE 00002396 "    $dt = DateTime->now;    # same as ( epoch => time )"
NSQ_SOURCE_LINE 00002397 ""
NSQ_SOURCE_LINE 00002398 "    $year  = $dt->year;"
NSQ_SOURCE_LINE 00002399 "    $month = $dt->month;        # 1-12"
NSQ_SOURCE_LINE 00002400 ""
NSQ_SOURCE_LINE 00002401 "    $day = $dt->day;            # 1-31"
NSQ_SOURCE_LINE 00002402 ""
NSQ_SOURCE_LINE 00002403 "    $dow = $dt->day_of_week;    # 1-7 (Monday is 1)"
NSQ_SOURCE_LINE 00002404 ""
NSQ_SOURCE_LINE 00002405 "    $hour   = $dt->hour;        # 0-23"
NSQ_SOURCE_LINE 00002406 "    $minute = $dt->minute;      # 0-59"
NSQ_SOURCE_LINE 00002407 ""
NSQ_SOURCE_LINE 00002408 "    $second = $dt->second;      # 0-61 (leap seconds!)"
NSQ_SOURCE_LINE 00002409 ""
NSQ_SOURCE_LINE 00002410 "    $doy = $dt->day_of_year;    # 1-366 (leap years)"
NSQ_SOURCE_LINE 00002411 ""
NSQ_SOURCE_LINE 00002412 "    $doq = $dt->day_of_quarter; # 1.."
NSQ_SOURCE_LINE 00002413 ""
NSQ_SOURCE_LINE 00002414 "    $qtr = $dt->quarter;        # 1-4"
NSQ_SOURCE_LINE 00002415 ""
NSQ_SOURCE_LINE 00002416 "    # all of the start-at-1 methods above have corresponding start-at-0"
NSQ_SOURCE_LINE 00002417 "    # methods, such as $dt->day_of_month_0, $dt->month_0 and so on"
NSQ_SOURCE_LINE 00002418 ""
NSQ_SOURCE_LINE 00002419 "    $ymd = $dt->ymd;         # 2002-12-06"
NSQ_SOURCE_LINE 00002420 "    $ymd = $dt->ymd('/');    # 2002/12/06"
NSQ_SOURCE_LINE 00002421 ""
NSQ_SOURCE_LINE 00002422 "    $mdy = $dt->mdy;         # 12-06-2002"
NSQ_SOURCE_LINE 00002423 "    $mdy = $dt->mdy('/');    # 12/06/2002"
NSQ_SOURCE_LINE 00002424 ""
NSQ_SOURCE_LINE 00002425 "    $dmy = $dt->dmy;         # 06-12-2002"
NSQ_SOURCE_LINE 00002426 "    $dmy = $dt->dmy('/');    # 06/12/2002"
NSQ_SOURCE_LINE 00002427 ""
NSQ_SOURCE_LINE 00002428 "    $hms = $dt->hms;         # 14:02:29"
NSQ_SOURCE_LINE 00002429 "    $hms = $dt->hms('!');    # 14!02!29"
NSQ_SOURCE_LINE 00002430 ""
NSQ_SOURCE_LINE 00002431 "    $is_leap = $dt->is_leap_year;"
NSQ_SOURCE_LINE 00002432 ""
NSQ_SOURCE_LINE 00002433 "    # these are localizable, see Locales section"
NSQ_SOURCE_LINE 00002434 "    $month_name = $dt->month_name;    # January, February, ..."
NSQ_SOURCE_LINE 00002435 "    $month_abbr = $dt->month_abbr;    # Jan, Feb, ..."
NSQ_SOURCE_LINE 00002436 "    $day_name   = $dt->day_name;      # Monday, Tuesday, ..."
NSQ_SOURCE_LINE 00002437 "    $day_abbr   = $dt->day_abbr;      # Mon, Tue, ..."
NSQ_SOURCE_LINE 00002438 ""
NSQ_SOURCE_LINE 00002439 "    # May not work for all possible datetime, see the docs on this"
NSQ_SOURCE_LINE 00002440 "    # method for more details."
NSQ_SOURCE_LINE 00002441 "    $epoch_time = $dt->epoch;"
NSQ_SOURCE_LINE 00002442 ""
NSQ_SOURCE_LINE 00002443 "    $dt2 = $dt + $duration_object;"
NSQ_SOURCE_LINE 00002444 ""
NSQ_SOURCE_LINE 00002445 "    $dt3 = $dt - $duration_object;"
NSQ_SOURCE_LINE 00002446 ""
NSQ_SOURCE_LINE 00002447 "    $duration_object = $dt - $dt2;"
NSQ_SOURCE_LINE 00002448 ""
NSQ_SOURCE_LINE 00002449 "    $dt->set( year => 1882 );"
NSQ_SOURCE_LINE 00002450 ""
NSQ_SOURCE_LINE 00002451 "    $dt->set_time_zone('America/Chicago');"
NSQ_SOURCE_LINE 00002452 ""
NSQ_SOURCE_LINE 00002453 "    $dt->set_formatter($formatter);"
NSQ_SOURCE_LINE 00002454 ""
NSQ_SOURCE_LINE 00002455 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00002456 ""
NSQ_SOURCE_LINE 00002457 "DateTime is a class for the representation of date/time combinations, and is"
NSQ_SOURCE_LINE 00002458 "part of the Perl DateTime project."
NSQ_SOURCE_LINE 00002459 ""
NSQ_SOURCE_LINE 00002460 "It represents the Gregorian calendar, extended backwards in time before its"
NSQ_SOURCE_LINE 00002461 "creation (in 1582). This is sometimes known as the \"proleptic Gregorian"
NSQ_SOURCE_LINE 00002462 "calendar\". In this calendar, the first day of the calendar (the epoch), is the"
NSQ_SOURCE_LINE 00002463 "first day of year 1, which corresponds to the date which was (incorrectly)"
NSQ_SOURCE_LINE 00002464 "believed to be the birth of Jesus Christ."
NSQ_SOURCE_LINE 00002465 ""
NSQ_SOURCE_LINE 00002466 "The calendar represented does have a year 0, and in that way differs from how"
NSQ_SOURCE_LINE 00002467 "dates are often written using \"BCE/CE\" or \"BC/AD\"."
NSQ_SOURCE_LINE 00002468 ""
NSQ_SOURCE_LINE 00002469 "For infinite datetimes, please see the L<DateTime::Infinite|DateTime::Infinite>"
NSQ_SOURCE_LINE 00002470 "module."
NSQ_SOURCE_LINE 00002471 ""
NSQ_SOURCE_LINE 00002472 "=head1 USAGE"
NSQ_SOURCE_LINE 00002473 ""
NSQ_SOURCE_LINE 00002474 "=head2 0-based Versus 1-based Numbers"
NSQ_SOURCE_LINE 00002475 ""
NSQ_SOURCE_LINE 00002476 "The C<DateTime> module follows a simple logic for determining whether or not a"
NSQ_SOURCE_LINE 00002477 "given number is 0-based or 1-based."
NSQ_SOURCE_LINE 00002478 ""
NSQ_SOURCE_LINE 00002479 "Month, day of month, day of week, and day of year are 1-based. Any method that"
NSQ_SOURCE_LINE 00002480 "is 1-based also has an equivalent 0-based method ending in C<_0>. So for"
NSQ_SOURCE_LINE 00002481 "example, this class provides both C<day_of_week> and C<day_of_week_0> methods."
NSQ_SOURCE_LINE 00002482 ""
NSQ_SOURCE_LINE 00002483 "The C<day_of_week_0> method still treats Monday as the first day of the week."
NSQ_SOURCE_LINE 00002484 ""
NSQ_SOURCE_LINE 00002485 "All I<time>-related numbers such as hour, minute, and second are 0-based."
NSQ_SOURCE_LINE 00002486 ""
NSQ_SOURCE_LINE 00002487 "Years are neither, as they can be both positive or negative, unlike any other"
NSQ_SOURCE_LINE 00002488 "datetime component. There I<is> a year 0."
NSQ_SOURCE_LINE 00002489 ""
NSQ_SOURCE_LINE 00002490 "There is no C<quarter_0> method."
NSQ_SOURCE_LINE 00002491 ""
NSQ_SOURCE_LINE 00002492 "=head2 Error Handling"
NSQ_SOURCE_LINE 00002493 ""
NSQ_SOURCE_LINE 00002494 "Some errors may cause this module to die with an error string. This can only"
NSQ_SOURCE_LINE 00002495 "happen when calling constructor methods, methods that change the object, such"
NSQ_SOURCE_LINE 00002496 "as C<set>, or methods that take parameters. Methods that retrieve information"
NSQ_SOURCE_LINE 00002497 "about the object, such as C<year> or C<epoch>, will never die."
NSQ_SOURCE_LINE 00002498 ""
NSQ_SOURCE_LINE 00002499 "=head2 Locales"
NSQ_SOURCE_LINE 00002500 ""
NSQ_SOURCE_LINE 00002501 "All the object methods which return names or abbreviations return data based on"
NSQ_SOURCE_LINE 00002502 "a locale. This is done by setting the locale when constructing a DateTime"
NSQ_SOURCE_LINE 00002503 "object. If this is not set, then C<\"en-US\"> is used."
NSQ_SOURCE_LINE 00002504 ""
NSQ_SOURCE_LINE 00002505 "=head2 Floating DateTimes"
NSQ_SOURCE_LINE 00002506 ""
NSQ_SOURCE_LINE 00002507 "The default time zone for new DateTime objects, except where stated otherwise,"
NSQ_SOURCE_LINE 00002508 "is the \"floating\" time zone. This concept comes from the iCal standard. A"
NSQ_SOURCE_LINE 00002509 "floating datetime is one which is not anchored to any particular time zone. In"
NSQ_SOURCE_LINE 00002510 "addition, floating datetimes do not include leap seconds, since we cannot apply"
NSQ_SOURCE_LINE 00002511 "them without knowing the datetime's time zone."
NSQ_SOURCE_LINE 00002512 ""
NSQ_SOURCE_LINE 00002513 "The results of date math and comparison between a floating datetime and one"
NSQ_SOURCE_LINE 00002514 "with a real time zone are not really valid, because one includes leap seconds"
NSQ_SOURCE_LINE 00002515 "and the other does not. Similarly, the results of datetime math between two"
NSQ_SOURCE_LINE 00002516 "floating datetimes and two datetimes with time zones are not really comparable."
NSQ_SOURCE_LINE 00002517 ""
NSQ_SOURCE_LINE 00002518 "If you are planning to use any objects with a real time zone, it is strongly"
NSQ_SOURCE_LINE 00002519 "recommended that you B<do not> mix these with floating datetimes."
NSQ_SOURCE_LINE 00002520 ""
NSQ_SOURCE_LINE 00002521 "=head2 Math"
NSQ_SOURCE_LINE 00002522 ""
NSQ_SOURCE_LINE 00002523 "If you are going to be doing date math, please read the section L<How DateTime"
NSQ_SOURCE_LINE 00002524 "Math Works>."
NSQ_SOURCE_LINE 00002525 ""
NSQ_SOURCE_LINE 00002526 "=head2 Determining the Local Time Zone Can Be Slow"
NSQ_SOURCE_LINE 00002527 ""
NSQ_SOURCE_LINE 00002528 "If C<$ENV{TZ}> is not set, it may involve reading a number of files in F</etc>"
NSQ_SOURCE_LINE 00002529 "or elsewhere. If you know that the local time zone won't change while your code"
NSQ_SOURCE_LINE 00002530 "is running, and you need to make many objects for the local time zone, it is"
NSQ_SOURCE_LINE 00002531 "strongly recommended that you retrieve the local time zone once and cache it:"
NSQ_SOURCE_LINE 00002532 ""
NSQ_SOURCE_LINE 00002533 "    my $local_time_zone = DateTime::TimeZone->new( name => 'local' );"
NSQ_SOURCE_LINE 00002534 ""
NSQ_SOURCE_LINE 00002535 "    # then everywhere else"
NSQ_SOURCE_LINE 00002536 ""
NSQ_SOURCE_LINE 00002537 "    my $dt = DateTime->new( ..., time_zone => $local_time_zone );"
NSQ_SOURCE_LINE 00002538 ""
NSQ_SOURCE_LINE 00002539 "DateTime itself does not do this internally because local time zones can"
NSQ_SOURCE_LINE 00002540 "change, and there's no good way to determine if it's changed without doing all"
NSQ_SOURCE_LINE 00002541 "the work to look it up."
NSQ_SOURCE_LINE 00002542 ""
NSQ_SOURCE_LINE 00002543 "=head2 Far Future DST"
NSQ_SOURCE_LINE 00002544 ""
NSQ_SOURCE_LINE 00002545 "Do not try to use named time zones (like \"America/Chicago\") with dates very far"
NSQ_SOURCE_LINE 00002546 "in the future (thousands of years). The current implementation of"
NSQ_SOURCE_LINE 00002547 "C<DateTime::TimeZone> will use a huge amount of memory calculating all the DST"
NSQ_SOURCE_LINE 00002548 "changes from now until the future date. Use UTC or the floating time zone and"
NSQ_SOURCE_LINE 00002549 "you will be safe."
NSQ_SOURCE_LINE 00002550 ""
NSQ_SOURCE_LINE 00002551 "=head2 Globally Setting a Default Time Zone"
NSQ_SOURCE_LINE 00002552 ""
NSQ_SOURCE_LINE 00002553 "B<Warning: This is very dangerous. Do this at your own risk!>"
NSQ_SOURCE_LINE 00002554 ""
NSQ_SOURCE_LINE 00002555 "By default, C<DateTime> uses either the floating time zone or UTC for newly"
NSQ_SOURCE_LINE 00002556 "created objects, depending on the constructor."
NSQ_SOURCE_LINE 00002557 ""
NSQ_SOURCE_LINE 00002558 "You can force C<DateTime> to use a different time zone by setting the"
NSQ_SOURCE_LINE 00002559 "C<PERL_DATETIME_DEFAULT_TZ> environment variable."
NSQ_SOURCE_LINE 00002560 ""
NSQ_SOURCE_LINE 00002561 "As noted above, this is very dangerous, as it affects all code that creates a"
NSQ_SOURCE_LINE 00002562 "C<DateTime> object, including modules from CPAN. If those modules expect the"
NSQ_SOURCE_LINE 00002563 "normal default, then setting this can cause confusing breakage or subtly broken"
NSQ_SOURCE_LINE 00002564 "data. Before setting this variable, you are strongly encouraged to audit your"
NSQ_SOURCE_LINE 00002565 "CPAN dependencies to see how they use C<DateTime>. Try running the test suite"
NSQ_SOURCE_LINE 00002566 "for each dependency with this environment variable set before using this in"
NSQ_SOURCE_LINE 00002567 "production."
NSQ_SOURCE_LINE 00002568 ""
NSQ_SOURCE_LINE 00002569 "=head2 Upper and Lower Bounds"
NSQ_SOURCE_LINE 00002570 ""
NSQ_SOURCE_LINE 00002571 "Internally, dates are represented the number of days before or after"
NSQ_SOURCE_LINE 00002572 "0001-01-01. This is stored as an integer, meaning that the upper and lower"
NSQ_SOURCE_LINE 00002573 "bounds are based on your Perl's integer size (C<$Config{ivsize}>)."
NSQ_SOURCE_LINE 00002574 ""
NSQ_SOURCE_LINE 00002575 "The limit on 32-bit systems is around 2^29 days, which gets you to year"
NSQ_SOURCE_LINE 00002576 "(+/-)1,469,903. On a 64-bit system you get 2^62 days, to year"
NSQ_SOURCE_LINE 00002577 "(+/-)12,626,367,463,883,278 (12.626 quadrillion)."
NSQ_SOURCE_LINE 00002578 ""
NSQ_SOURCE_LINE 00002579 "=head1 METHODS"
NSQ_SOURCE_LINE 00002580 ""
NSQ_SOURCE_LINE 00002581 "DateTime provides many methods. The documentation breaks them down into groups"
NSQ_SOURCE_LINE 00002582 "based on what they do (constructor, accessors, modifiers, etc.)."
NSQ_SOURCE_LINE 00002583 ""
NSQ_SOURCE_LINE 00002584 "=head2 Constructors"
NSQ_SOURCE_LINE 00002585 ""
NSQ_SOURCE_LINE 00002586 "All constructors can die when invalid parameters are given."
NSQ_SOURCE_LINE 00002587 ""
NSQ_SOURCE_LINE 00002588 "=head3 Warnings"
NSQ_SOURCE_LINE 00002589 ""
NSQ_SOURCE_LINE 00002590 "Currently, constructors will warn if you try to create a far future DateTime"
NSQ_SOURCE_LINE 00002591 "(year >= 5000) with any time zone besides floating or UTC. This can be very"
NSQ_SOURCE_LINE 00002592 "slow if the time zone has future DST transitions that need to be calculated. If"
NSQ_SOURCE_LINE 00002593 "the date is sufficiently far in the future this can be I<really> slow"
NSQ_SOURCE_LINE 00002594 "(minutes)."
NSQ_SOURCE_LINE 00002595 ""
NSQ_SOURCE_LINE 00002596 "All warnings from DateTime use the C<DateTime> category and can be suppressed"
NSQ_SOURCE_LINE 00002597 "with:"
NSQ_SOURCE_LINE 00002598 ""
NSQ_SOURCE_LINE 00002599 "    no warnings 'DateTime';"
NSQ_SOURCE_LINE 00002600 ""
NSQ_SOURCE_LINE 00002601 "This warning may be removed in the future if L<DateTime::TimeZone> is made much"
NSQ_SOURCE_LINE 00002602 "faster."
NSQ_SOURCE_LINE 00002603 ""
NSQ_SOURCE_LINE 00002604 "=head3 DateTime->new( ... )"
NSQ_SOURCE_LINE 00002605 ""
NSQ_SOURCE_LINE 00002606 "    my $dt = DateTime->new("
NSQ_SOURCE_LINE 00002607 "        year       => 1966,"
NSQ_SOURCE_LINE 00002608 "        month      => 10,"
NSQ_SOURCE_LINE 00002609 "        day        => 25,"
NSQ_SOURCE_LINE 00002610 "        hour       => 7,"
NSQ_SOURCE_LINE 00002611 "        minute     => 15,"
NSQ_SOURCE_LINE 00002612 "        second     => 47,"
NSQ_SOURCE_LINE 00002613 "        nanosecond => 500000000,"
NSQ_SOURCE_LINE 00002614 "        time_zone  => 'America/Chicago',"
NSQ_SOURCE_LINE 00002615 "    );"
NSQ_SOURCE_LINE 00002616 ""
NSQ_SOURCE_LINE 00002617 "This class method accepts the following parameters:"
NSQ_SOURCE_LINE 00002618 ""
NSQ_SOURCE_LINE 00002619 "=over 4"
NSQ_SOURCE_LINE 00002620 ""
NSQ_SOURCE_LINE 00002621 "=item * year"
NSQ_SOURCE_LINE 00002622 ""
NSQ_SOURCE_LINE 00002623 "An integer year for the DateTime. This can be any integer number within the"
NSQ_SOURCE_LINE 00002624 "valid range for your system (See L</Upper and Lower Bounds>). This is required."
NSQ_SOURCE_LINE 00002625 ""
NSQ_SOURCE_LINE 00002626 "=item * month"
NSQ_SOURCE_LINE 00002627 ""
NSQ_SOURCE_LINE 00002628 "An integer from 1-12. Defaults to 1."
NSQ_SOURCE_LINE 00002629 ""
NSQ_SOURCE_LINE 00002630 "=item * day"
NSQ_SOURCE_LINE 00002631 ""
NSQ_SOURCE_LINE 00002632 "An integer from 1-31. The value will be validated based on the month, to"
NSQ_SOURCE_LINE 00002633 "prevent creating invalid dates like February 30. Defaults to 1."
NSQ_SOURCE_LINE 00002634 ""
NSQ_SOURCE_LINE 00002635 "=item * hour"
NSQ_SOURCE_LINE 00002636 ""
NSQ_SOURCE_LINE 00002637 "An integer from 0-23. Hour 0 is midnight at the beginning of the given date."
NSQ_SOURCE_LINE 00002638 "Defaults to 0."
NSQ_SOURCE_LINE 00002639 ""
NSQ_SOURCE_LINE 00002640 "=item * minute"
NSQ_SOURCE_LINE 00002641 ""
NSQ_SOURCE_LINE 00002642 "An integer from 0-59. Defaults to 0."
NSQ_SOURCE_LINE 00002643 ""
NSQ_SOURCE_LINE 00002644 "=item * second"
NSQ_SOURCE_LINE 00002645 ""
NSQ_SOURCE_LINE 00002646 "An integer from 0-61. Values of 60 or 61 are only allowed when the specified"
NSQ_SOURCE_LINE 00002647 "date and time have a leap second. Defaults to 0."
NSQ_SOURCE_LINE 00002648 ""
NSQ_SOURCE_LINE 00002649 "=item * nanosecond"
NSQ_SOURCE_LINE 00002650 ""
NSQ_SOURCE_LINE 00002651 "An integer that is greater than or equal to 0. If this number is greater than 1"
NSQ_SOURCE_LINE 00002652 "billion, it will be normalized into the second value for the DateTime object."
NSQ_SOURCE_LINE 00002653 "Defaults to 0"
NSQ_SOURCE_LINE 00002654 ""
NSQ_SOURCE_LINE 00002655 "=item * locale"
NSQ_SOURCE_LINE 00002656 ""
NSQ_SOURCE_LINE 00002657 "A string containing a locale code, like C<\"en-US\"> or C<\"zh-Hant-TW\">, or an"
NSQ_SOURCE_LINE 00002658 "object returned by C<< DateTime::Locale->load >>. See the L<DateTime::Locale>"
NSQ_SOURCE_LINE 00002659 "documentation for details. Defaults to the value of C<< DateTime->DefaultLocale"
NSQ_SOURCE_LINE 00002660 ">>, or C<\"en-US\"> if the class default has not been set."
NSQ_SOURCE_LINE 00002661 ""
NSQ_SOURCE_LINE 00002662 "=item * time_zone"
NSQ_SOURCE_LINE 00002663 ""
NSQ_SOURCE_LINE 00002664 "A string containing a time zone name like \"America/Chicago\" or a"
NSQ_SOURCE_LINE 00002665 "L<DateTime::TimeZone> object. Defaults to the value of"
NSQ_SOURCE_LINE 00002666 "C<$ENV{PERL_DATETIME_DEFAULT_TZ}> or \"floating\" if that env var is not set. See"
NSQ_SOURCE_LINE 00002667 "L</Globally Setting a Default Time Zone> for more details on that env var (and"
NSQ_SOURCE_LINE 00002668 "why you should not use it)."
NSQ_SOURCE_LINE 00002669 ""
NSQ_SOURCE_LINE 00002670 "A string will simply be passed to the C<< DateTime::TimeZone->new >> method as"
NSQ_SOURCE_LINE 00002671 "its C<name> parameter. This string may be an Olson DB time zone name"
NSQ_SOURCE_LINE 00002672 "(\"America/Chicago\"), an offset string (\"+0630\"), or the words \"floating\" or"
NSQ_SOURCE_LINE 00002673 "\"local\". See the C<DateTime::TimeZone> documentation for more details."
NSQ_SOURCE_LINE 00002674 ""
NSQ_SOURCE_LINE 00002675 "=item * formatter"
NSQ_SOURCE_LINE 00002676 ""
NSQ_SOURCE_LINE 00002677 "An object or class name with a C<format_datetime> method. This will be used to"
NSQ_SOURCE_LINE 00002678 "stringify the DateTime object. This is optional. If it is not specified, then"
NSQ_SOURCE_LINE 00002679 "stringification calls C<< $self->iso8601 >>."
NSQ_SOURCE_LINE 00002680 ""
NSQ_SOURCE_LINE 00002681 "=back"
NSQ_SOURCE_LINE 00002682 ""
NSQ_SOURCE_LINE 00002683 "Invalid parameter types (like an array reference) will cause the constructor to"
NSQ_SOURCE_LINE 00002684 "die."
NSQ_SOURCE_LINE 00002685 ""
NSQ_SOURCE_LINE 00002686 "=head4 Parsing Dates"
NSQ_SOURCE_LINE 00002687 ""
NSQ_SOURCE_LINE 00002688 "B<This module does not parse dates!> That means there is no constructor to"
NSQ_SOURCE_LINE 00002689 "which you can pass things like \"March 3, 1970 12:34\"."
NSQ_SOURCE_LINE 00002690 ""
NSQ_SOURCE_LINE 00002691 "Instead, take a look at the various"
NSQ_SOURCE_LINE 00002692 "L<DateTime::Format::*|https://metacpan.org/search?q=datetime%3A%3Aformat>"
NSQ_SOURCE_LINE 00002693 "modules on CPAN. These parse all sorts of different date formats, and you're"
NSQ_SOURCE_LINE 00002694 "bound to find something that can handle your particular needs."
NSQ_SOURCE_LINE 00002695 ""
NSQ_SOURCE_LINE 00002696 "=head4 Ambiguous Local Times"
NSQ_SOURCE_LINE 00002697 ""
NSQ_SOURCE_LINE 00002698 "Because of Daylight Saving Time, it is possible to specify a local time that is"
NSQ_SOURCE_LINE 00002699 "ambiguous. For example, in the US in 2003, the transition from to saving to"
NSQ_SOURCE_LINE 00002700 "standard time occurred on October 26, at 02:00:00 local time. The local clock"
NSQ_SOURCE_LINE 00002701 "changed from 01:59:59 (saving time) to 01:00:00 (standard time). This means"
NSQ_SOURCE_LINE 00002702 "that the hour from 01:00:00 through 01:59:59 actually occurs twice, though the"
NSQ_SOURCE_LINE 00002703 "UTC time continues to move forward."
NSQ_SOURCE_LINE 00002704 ""
NSQ_SOURCE_LINE 00002705 "If you specify an ambiguous time, then the latest UTC time is always used, in"
NSQ_SOURCE_LINE 00002706 "effect always choosing standard time. In this case, you can simply subtract an"
NSQ_SOURCE_LINE 00002707 "hour from the object in order to move to saving time, for example:"
NSQ_SOURCE_LINE 00002708 ""
NSQ_SOURCE_LINE 00002709 "    # This object represent 01:30:00 standard time"
NSQ_SOURCE_LINE 00002710 "    my $dt = DateTime->new("
NSQ_SOURCE_LINE 00002711 "        year      => 2003,"
NSQ_SOURCE_LINE 00002712 "        month     => 10,"
NSQ_SOURCE_LINE 00002713 "        day       => 26,"
NSQ_SOURCE_LINE 00002714 "        hour      => 1,"
NSQ_SOURCE_LINE 00002715 "        minute    => 30,"
NSQ_SOURCE_LINE 00002716 "        second    => 0,"
NSQ_SOURCE_LINE 00002717 "        time_zone => 'America/Chicago',"
NSQ_SOURCE_LINE 00002718 "    );"
NSQ_SOURCE_LINE 00002719 ""
NSQ_SOURCE_LINE 00002720 "    print $dt->hms;    # prints 01:30:00"
NSQ_SOURCE_LINE 00002721 ""
NSQ_SOURCE_LINE 00002722 "    # Now the object represent 01:30:00 saving time"
NSQ_SOURCE_LINE 00002723 "    $dt->subtract( hours => 1 );"
NSQ_SOURCE_LINE 00002724 ""
NSQ_SOURCE_LINE 00002725 "    print $dt->hms;    # still prints 01:30:00"
NSQ_SOURCE_LINE 00002726 ""
NSQ_SOURCE_LINE 00002727 "Alternately, you could create the object with the UTC time zone and then call"
NSQ_SOURCE_LINE 00002728 "the C<set_time_zone> method to change the time zone. This is a good way to"
NSQ_SOURCE_LINE 00002729 "ensure that the time is not ambiguous."
NSQ_SOURCE_LINE 00002730 ""
NSQ_SOURCE_LINE 00002731 "=head4 Invalid Local Times"
NSQ_SOURCE_LINE 00002732 ""
NSQ_SOURCE_LINE 00002733 "Another problem introduced by Daylight Saving Time is that certain local times"
NSQ_SOURCE_LINE 00002734 "just do not exist. For example, in the US in 2003, the transition from standard"
NSQ_SOURCE_LINE 00002735 "to saving time occurred on April 6, at the change to 2:00:00 local time. The"
NSQ_SOURCE_LINE 00002736 "local clock changed from 01:59:59 (standard time) to 03:00:00 (saving time)."
NSQ_SOURCE_LINE 00002737 "This means that there is no 02:00:00 through 02:59:59 on April 6!"
NSQ_SOURCE_LINE 00002738 ""
NSQ_SOURCE_LINE 00002739 "Attempting to create an invalid time currently causes a fatal error."
NSQ_SOURCE_LINE 00002740 ""
NSQ_SOURCE_LINE 00002741 "=head3 DateTime->from_epoch( epoch => $epoch, ... )"
NSQ_SOURCE_LINE 00002742 ""
NSQ_SOURCE_LINE 00002743 "This class method can be used to construct a new DateTime object from an epoch"
NSQ_SOURCE_LINE 00002744 "time instead of components. Just as with the C<new> method, it accepts"
NSQ_SOURCE_LINE 00002745 "C<time_zone>, C<locale>, and C<formatter> parameters."
NSQ_SOURCE_LINE 00002746 ""
NSQ_SOURCE_LINE 00002747 "You can also call it with a single unnamed argument, which will be treated as"
NSQ_SOURCE_LINE 00002748 "the epoch value."
NSQ_SOURCE_LINE 00002749 ""
NSQ_SOURCE_LINE 00002750 "If the epoch value is a non-integral value, it will be rounded to nearest"
NSQ_SOURCE_LINE 00002751 "microsecond."
NSQ_SOURCE_LINE 00002752 ""
NSQ_SOURCE_LINE 00002753 "By default, the returned object will be in the UTC time zone."
NSQ_SOURCE_LINE 00002754 ""
NSQ_SOURCE_LINE 00002755 "If you pass a C<time_zone>, then this time zone will be applied I<after> the"
NSQ_SOURCE_LINE 00002756 "object is constructed. In other words, the epoch value is always interpreted as"
NSQ_SOURCE_LINE 00002757 "being in the UTC time zone. Here's an example:"
NSQ_SOURCE_LINE 00002758 ""
NSQ_SOURCE_LINE 00002759 "    my $dt = DateTime->from_epoch("
NSQ_SOURCE_LINE 00002760 "        epoch     => 0,"
NSQ_SOURCE_LINE 00002761 "        time_zone => 'Asia/Tokyo'"
NSQ_SOURCE_LINE 00002762 "    );"
NSQ_SOURCE_LINE 00002763 "    say $dt; # Prints 1970-01-01T09:00:00 as Asia/Tokyo is +09:00 from UTC."
NSQ_SOURCE_LINE 00002764 "    $dt->set_time_zone('UTC');"
NSQ_SOURCE_LINE 00002765 "    say $dt; # Prints 1970-01-01T00:00:00"
NSQ_SOURCE_LINE 00002766 ""
NSQ_SOURCE_LINE 00002767 "=head3 DateTime->now( ... )"
NSQ_SOURCE_LINE 00002768 ""
NSQ_SOURCE_LINE 00002769 "This class method is equivalent to calling C<from_epoch> with the value"
NSQ_SOURCE_LINE 00002770 "returned from Perl's C<time> function. Just as with the C<new> method, it"
NSQ_SOURCE_LINE 00002771 "accepts C<time_zone> and C<locale> parameters."
NSQ_SOURCE_LINE 00002772 ""
NSQ_SOURCE_LINE 00002773 "By default, the returned object will be in the UTC time zone."
NSQ_SOURCE_LINE 00002774 ""
NSQ_SOURCE_LINE 00002775 "If you want sub-second resolution, use the L<DateTime::HiRes> module's C<<"
NSQ_SOURCE_LINE 00002776 "DateTime::HiRes->now >> method instead."
NSQ_SOURCE_LINE 00002777 ""
NSQ_SOURCE_LINE 00002778 "=head3 DateTime->today( ... )"
NSQ_SOURCE_LINE 00002779 ""
NSQ_SOURCE_LINE 00002780 "This class method is equivalent to:"
NSQ_SOURCE_LINE 00002781 ""
NSQ_SOURCE_LINE 00002782 "    DateTime->now(@_)->truncate( to => 'day' );"
NSQ_SOURCE_LINE 00002783 ""
NSQ_SOURCE_LINE 00002784 "=head3 DateTime->last_day_of_month( ... )"
NSQ_SOURCE_LINE 00002785 ""
NSQ_SOURCE_LINE 00002786 "This constructor takes the same arguments as can be given to the C<new> method,"
NSQ_SOURCE_LINE 00002787 "except for C<day>. Additionally, both C<year> and C<month> are required."
NSQ_SOURCE_LINE 00002788 ""
NSQ_SOURCE_LINE 00002789 "=head3 DateTime->from_day_of_year( ... )"
NSQ_SOURCE_LINE 00002790 ""
NSQ_SOURCE_LINE 00002791 "This constructor takes the same arguments as can be given to the C<new> method,"
NSQ_SOURCE_LINE 00002792 "except that it does not accept a C<month> or C<day> argument. Instead, it"
NSQ_SOURCE_LINE 00002793 "requires both C<year> and C<day_of_year>. The day of year must be between 1 and"
NSQ_SOURCE_LINE 00002794 "366, and 366 is only allowed for leap years."
NSQ_SOURCE_LINE 00002795 ""
NSQ_SOURCE_LINE 00002796 "=head3 DateTime->from_object( object => $object, ... )"
NSQ_SOURCE_LINE 00002797 ""
NSQ_SOURCE_LINE 00002798 "This class method can be used to construct a new DateTime object from any"
NSQ_SOURCE_LINE 00002799 "object that implements the C<utc_rd_values> method. All C<DateTime::Calendar>"
NSQ_SOURCE_LINE 00002800 "modules must implement this method in order to provide cross-calendar"
NSQ_SOURCE_LINE 00002801 "compatibility. This method accepts a C<locale> and C<formatter> parameter"
NSQ_SOURCE_LINE 00002802 ""
NSQ_SOURCE_LINE 00002803 "If the object passed to this method has a C<time_zone> method, that is used to"
NSQ_SOURCE_LINE 00002804 "set the time zone of the newly created C<DateTime> object."
NSQ_SOURCE_LINE 00002805 ""
NSQ_SOURCE_LINE 00002806 "Otherwise, the returned object will be in the floating time zone."
NSQ_SOURCE_LINE 00002807 ""
NSQ_SOURCE_LINE 00002808 "=head3 $dt->clone"
NSQ_SOURCE_LINE 00002809 ""
NSQ_SOURCE_LINE 00002810 "This object method returns a new object that is replica of the object upon"
NSQ_SOURCE_LINE 00002811 "which the method is called."
NSQ_SOURCE_LINE 00002812 ""
NSQ_SOURCE_LINE 00002813 "=head2 \"Get\" Methods"
NSQ_SOURCE_LINE 00002814 ""
NSQ_SOURCE_LINE 00002815 "This class has many methods for retrieving information about an object."
NSQ_SOURCE_LINE 00002816 ""
NSQ_SOURCE_LINE 00002817 "=head3 $dt->year"
NSQ_SOURCE_LINE 00002818 ""
NSQ_SOURCE_LINE 00002819 "Returns the year."
NSQ_SOURCE_LINE 00002820 ""
NSQ_SOURCE_LINE 00002821 "=head3 $dt->ce_year"
NSQ_SOURCE_LINE 00002822 ""
NSQ_SOURCE_LINE 00002823 "Returns the year according to the BCE/CE numbering system. The year before year"
NSQ_SOURCE_LINE 00002824 "1 in this system is year -1, aka \"1 BCE\"."
NSQ_SOURCE_LINE 00002825 ""
NSQ_SOURCE_LINE 00002826 "=head3 $dt->era_name"
NSQ_SOURCE_LINE 00002827 ""
NSQ_SOURCE_LINE 00002828 "Returns the long name of the current era, something like \"Before Christ\". See"
NSQ_SOURCE_LINE 00002829 "the L</Locales> section for more details."
NSQ_SOURCE_LINE 00002830 ""
NSQ_SOURCE_LINE 00002831 "=head3 $dt->era_abbr"
NSQ_SOURCE_LINE 00002832 ""
NSQ_SOURCE_LINE 00002833 "Returns the abbreviated name of the current era, something like \"BC\". See the"
NSQ_SOURCE_LINE 00002834 "L</Locales> section for more details."
NSQ_SOURCE_LINE 00002835 ""
NSQ_SOURCE_LINE 00002836 "=head3 $dt->christian_era"
NSQ_SOURCE_LINE 00002837 ""
NSQ_SOURCE_LINE 00002838 "Returns a string, either \"BC\" or \"AD\", according to the year."
NSQ_SOURCE_LINE 00002839 ""
NSQ_SOURCE_LINE 00002840 "=head3 $dt->secular_era"
NSQ_SOURCE_LINE 00002841 ""
NSQ_SOURCE_LINE 00002842 "Returns a string, either \"BCE\" or \"CE\", according to the year."
NSQ_SOURCE_LINE 00002843 ""
NSQ_SOURCE_LINE 00002844 "=head3 $dt->year_with_era"
NSQ_SOURCE_LINE 00002845 ""
NSQ_SOURCE_LINE 00002846 "Returns a string containing the year immediately followed by the appropriate"
NSQ_SOURCE_LINE 00002847 "era abbreviation, based on the object's locale. The year is the absolute value"
NSQ_SOURCE_LINE 00002848 "of C<ce_year>, so that year 1 is \"1\" and year 0 is \"1BC\". See the L</Locales>"
NSQ_SOURCE_LINE 00002849 "section for more details."
NSQ_SOURCE_LINE 00002850 ""
NSQ_SOURCE_LINE 00002851 "=head3 $dt->year_with_christian_era"
NSQ_SOURCE_LINE 00002852 ""
NSQ_SOURCE_LINE 00002853 "Like C<year_with_era>, but uses the C<christian_era> method to get the era"
NSQ_SOURCE_LINE 00002854 "name."
NSQ_SOURCE_LINE 00002855 ""
NSQ_SOURCE_LINE 00002856 "=head3 $dt->year_with_secular_era"
NSQ_SOURCE_LINE 00002857 ""
NSQ_SOURCE_LINE 00002858 "Like C<year_with_era>, but uses the C<secular_era> method to get the era name."
NSQ_SOURCE_LINE 00002859 ""
NSQ_SOURCE_LINE 00002860 "=head3 $dt->month"
NSQ_SOURCE_LINE 00002861 ""
NSQ_SOURCE_LINE 00002862 "Returns the month of the year, from 1..12."
NSQ_SOURCE_LINE 00002863 ""
NSQ_SOURCE_LINE 00002864 "Also available as C<< $dt->mon >>."
NSQ_SOURCE_LINE 00002865 ""
NSQ_SOURCE_LINE 00002866 "=head3 $dt->month_name"
NSQ_SOURCE_LINE 00002867 ""
NSQ_SOURCE_LINE 00002868 "Returns the name of the current month. See the L</Locales> section for more"
NSQ_SOURCE_LINE 00002869 "details."
NSQ_SOURCE_LINE 00002870 ""
NSQ_SOURCE_LINE 00002871 "=head3 $dt->month_abbr"
NSQ_SOURCE_LINE 00002872 ""
NSQ_SOURCE_LINE 00002873 "Returns the abbreviated name of the current month. See the L</Locales> section"
NSQ_SOURCE_LINE 00002874 "for more details."
NSQ_SOURCE_LINE 00002875 ""
NSQ_SOURCE_LINE 00002876 "=head3 $dt->day"
NSQ_SOURCE_LINE 00002877 ""
NSQ_SOURCE_LINE 00002878 "Returns the day of the month, from 1..31."
NSQ_SOURCE_LINE 00002879 ""
NSQ_SOURCE_LINE 00002880 "Also available as C<< $dt->mday >> and C<< $dt->day_of_month >>."
NSQ_SOURCE_LINE 00002881 ""
NSQ_SOURCE_LINE 00002882 "=head3 $dt->day_of_week"
NSQ_SOURCE_LINE 00002883 ""
NSQ_SOURCE_LINE 00002884 "Returns the day of the week as a number, from 1..7, with 1 being Monday and 7"
NSQ_SOURCE_LINE 00002885 "being Sunday."
NSQ_SOURCE_LINE 00002886 ""
NSQ_SOURCE_LINE 00002887 "Also available as C<< $dt->wday >> and C<< $dt->dow >>."
NSQ_SOURCE_LINE 00002888 ""
NSQ_SOURCE_LINE 00002889 "=head3 $dt->local_day_of_week"
NSQ_SOURCE_LINE 00002890 ""
NSQ_SOURCE_LINE 00002891 "Returns the day of the week as a number, from 1..7. The day corresponding to 1"
NSQ_SOURCE_LINE 00002892 "will vary based on the locale. See the L</Locales> section for more details."
NSQ_SOURCE_LINE 00002893 ""
NSQ_SOURCE_LINE 00002894 "=head3 $dt->day_name"
NSQ_SOURCE_LINE 00002895 ""
NSQ_SOURCE_LINE 00002896 "Returns the name of the current day of the week. See the L</Locales> section"
NSQ_SOURCE_LINE 00002897 "for more details."
NSQ_SOURCE_LINE 00002898 ""
NSQ_SOURCE_LINE 00002899 "=head3 $dt->day_abbr"
NSQ_SOURCE_LINE 00002900 ""
NSQ_SOURCE_LINE 00002901 "Returns the abbreviated name of the current day of the week. See the"
NSQ_SOURCE_LINE 00002902 "L</Locales> section for more details."
NSQ_SOURCE_LINE 00002903 ""
NSQ_SOURCE_LINE 00002904 "=head3 $dt->day_of_year"
NSQ_SOURCE_LINE 00002905 ""
NSQ_SOURCE_LINE 00002906 "Returns the day of the year."
NSQ_SOURCE_LINE 00002907 ""
NSQ_SOURCE_LINE 00002908 "Also available as C<< $dt->doy >>."
NSQ_SOURCE_LINE 00002909 ""
NSQ_SOURCE_LINE 00002910 "=head3 $dt->quarter"
NSQ_SOURCE_LINE 00002911 ""
NSQ_SOURCE_LINE 00002912 "Returns the quarter of the year, from 1..4."
NSQ_SOURCE_LINE 00002913 ""
NSQ_SOURCE_LINE 00002914 "=head3 $dt->quarter_name"
NSQ_SOURCE_LINE 00002915 ""
NSQ_SOURCE_LINE 00002916 "Returns the name of the current quarter. See the L</Locales> section for more"
NSQ_SOURCE_LINE 00002917 "details."
NSQ_SOURCE_LINE 00002918 ""
NSQ_SOURCE_LINE 00002919 "=head3 $dt->quarter_abbr"
NSQ_SOURCE_LINE 00002920 ""
NSQ_SOURCE_LINE 00002921 "Returns the abbreviated name of the current quarter. See the L</Locales>"
NSQ_SOURCE_LINE 00002922 "section for more details."
NSQ_SOURCE_LINE 00002923 ""
NSQ_SOURCE_LINE 00002924 "=head3 $dt->day_of_quarter"
NSQ_SOURCE_LINE 00002925 ""
NSQ_SOURCE_LINE 00002926 "Returns the day of the quarter."
NSQ_SOURCE_LINE 00002927 ""
NSQ_SOURCE_LINE 00002928 "Also available as C<< $dt->doq >>."
NSQ_SOURCE_LINE 00002929 ""
NSQ_SOURCE_LINE 00002930 "=head3 $dt->weekday_of_month"
NSQ_SOURCE_LINE 00002931 ""
NSQ_SOURCE_LINE 00002932 "Returns a number from 1..5 indicating which week day of the month this is. For"
NSQ_SOURCE_LINE 00002933 "example, June 9, 2003 is the second Monday of the month, and so this method"
NSQ_SOURCE_LINE 00002934 "returns 2 for that date."
NSQ_SOURCE_LINE 00002935 ""
NSQ_SOURCE_LINE 00002936 "=head3 $dt->ymd($optional_separator), $dt->mdy(...), $dt->dmy(...)"
NSQ_SOURCE_LINE 00002937 ""
NSQ_SOURCE_LINE 00002938 "Each method returns the year, month, and day, in the order indicated by the"
NSQ_SOURCE_LINE 00002939 "method name. Years are zero-padded to four digits. Months and days are 0-padded"
NSQ_SOURCE_LINE 00002940 "to two digits."
NSQ_SOURCE_LINE 00002941 ""
NSQ_SOURCE_LINE 00002942 "By default, the values are separated by a dash (-), but this can be overridden"
NSQ_SOURCE_LINE 00002943 "by passing a value to the method."
NSQ_SOURCE_LINE 00002944 ""
NSQ_SOURCE_LINE 00002945 "The C<< $dt->ymd >> method is also available as C<< $dt->date >>."
NSQ_SOURCE_LINE 00002946 ""
NSQ_SOURCE_LINE 00002947 "=head3 $dt->hour"
NSQ_SOURCE_LINE 00002948 ""
NSQ_SOURCE_LINE 00002949 "Returns the hour of the day, from 0..23."
NSQ_SOURCE_LINE 00002950 ""
NSQ_SOURCE_LINE 00002951 "=head3 $dt->hour_1"
NSQ_SOURCE_LINE 00002952 ""
NSQ_SOURCE_LINE 00002953 "Returns the hour of the day, from 1..24."
NSQ_SOURCE_LINE 00002954 ""
NSQ_SOURCE_LINE 00002955 "=head3 $dt->hour_12"
NSQ_SOURCE_LINE 00002956 ""
NSQ_SOURCE_LINE 00002957 "Returns the hour of the day, from 1..12."
NSQ_SOURCE_LINE 00002958 ""
NSQ_SOURCE_LINE 00002959 "=head3 $dt->hour_12_0"
NSQ_SOURCE_LINE 00002960 ""
NSQ_SOURCE_LINE 00002961 "Returns the hour of the day, from 0..11."
NSQ_SOURCE_LINE 00002962 ""
NSQ_SOURCE_LINE 00002963 "=head3 $dt->am_or_pm"
NSQ_SOURCE_LINE 00002964 ""
NSQ_SOURCE_LINE 00002965 "Returns the appropriate localized abbreviation, depending on the current hour."
NSQ_SOURCE_LINE 00002966 ""
NSQ_SOURCE_LINE 00002967 "=head3 $dt->minute"
NSQ_SOURCE_LINE 00002968 ""
NSQ_SOURCE_LINE 00002969 "Returns the minute of the hour, from 0..59."
NSQ_SOURCE_LINE 00002970 ""
NSQ_SOURCE_LINE 00002971 "Also available as C<< $dt->min >>."
NSQ_SOURCE_LINE 00002972 ""
NSQ_SOURCE_LINE 00002973 "=head3 $dt->second"
NSQ_SOURCE_LINE 00002974 ""
NSQ_SOURCE_LINE 00002975 "Returns the second, from 0..61. The values 60 and 61 are used for leap seconds."
NSQ_SOURCE_LINE 00002976 ""
NSQ_SOURCE_LINE 00002977 "Also available as C<< $dt->sec >>."
NSQ_SOURCE_LINE 00002978 ""
NSQ_SOURCE_LINE 00002979 "=head3 $dt->fractional_second"
NSQ_SOURCE_LINE 00002980 ""
NSQ_SOURCE_LINE 00002981 "Returns the second, as a real number from 0.0 until 61.999999999"
NSQ_SOURCE_LINE 00002982 ""
NSQ_SOURCE_LINE 00002983 "The values 60 and 61 are used for leap seconds."
NSQ_SOURCE_LINE 00002984 ""
NSQ_SOURCE_LINE 00002985 "=head3 $dt->millisecond"
NSQ_SOURCE_LINE 00002986 ""
NSQ_SOURCE_LINE 00002987 "Returns the fractional part of the second as milliseconds (1E-3 seconds)."
NSQ_SOURCE_LINE 00002988 ""
NSQ_SOURCE_LINE 00002989 "Half a second is 500 milliseconds."
NSQ_SOURCE_LINE 00002990 ""
NSQ_SOURCE_LINE 00002991 "This value will always be rounded down to the nearest integer."
NSQ_SOURCE_LINE 00002992 ""
NSQ_SOURCE_LINE 00002993 "=head3 $dt->microsecond"
NSQ_SOURCE_LINE 00002994 ""
NSQ_SOURCE_LINE 00002995 "Returns the fractional part of the second as microseconds (1E-6 seconds)."
NSQ_SOURCE_LINE 00002996 ""
NSQ_SOURCE_LINE 00002997 "Half a second is 500,000 microseconds."
NSQ_SOURCE_LINE 00002998 ""
NSQ_SOURCE_LINE 00002999 "This value will always be rounded down to the nearest integer."
NSQ_SOURCE_LINE 00003000 ""
NSQ_SOURCE_LINE 00003001 "=head3 $dt->nanosecond"
NSQ_SOURCE_LINE 00003002 ""
NSQ_SOURCE_LINE 00003003 "Returns the fractional part of the second as nanoseconds (1E-9 seconds)."
NSQ_SOURCE_LINE 00003004 ""
NSQ_SOURCE_LINE 00003005 " Half a second is 500,000,000 nanoseconds."
NSQ_SOURCE_LINE 00003006 ""
NSQ_SOURCE_LINE 00003007 "=head3 $dt->hms($optional_separator)"
NSQ_SOURCE_LINE 00003008 ""
NSQ_SOURCE_LINE 00003009 "Returns the hour, minute, and second, all zero-padded to two digits. If no"
NSQ_SOURCE_LINE 00003010 "separator is specified, a colon (:) is used by default."
NSQ_SOURCE_LINE 00003011 ""
NSQ_SOURCE_LINE 00003012 "Also available as C<< $dt->time >>."
NSQ_SOURCE_LINE 00003013 ""
NSQ_SOURCE_LINE 00003014 "=head3 $dt->datetime($optional_separator)"
NSQ_SOURCE_LINE 00003015 ""
NSQ_SOURCE_LINE 00003016 "This method is equivalent to:"
NSQ_SOURCE_LINE 00003017 ""
NSQ_SOURCE_LINE 00003018 "    $dt->ymd('-') . 'T' . $dt->hms(':')"
NSQ_SOURCE_LINE 00003019 ""
NSQ_SOURCE_LINE 00003020 "The C<$optional_separator> parameter allows you to override the separator"
NSQ_SOURCE_LINE 00003021 "between the date and time, for e.g. C<< $dt->datetime(q{ }) >>."
NSQ_SOURCE_LINE 00003022 ""
NSQ_SOURCE_LINE 00003023 "This method is also available as C<< $dt->iso8601 >>, but it's not really a"
NSQ_SOURCE_LINE 00003024 "very good ISO8601 format, as it lacks a time zone. If called as C<<"
NSQ_SOURCE_LINE 00003025 "$dt->iso8601 >> you cannot change the separator, as ISO8601 specifies that \"T\""
NSQ_SOURCE_LINE 00003026 "must be used to separate them."
NSQ_SOURCE_LINE 00003027 ""
NSQ_SOURCE_LINE 00003028 "=head3 $dt->rfc3339"
NSQ_SOURCE_LINE 00003029 ""
NSQ_SOURCE_LINE 00003030 "This formats a datetime in RFC3339 format. This is the same as C<<"
NSQ_SOURCE_LINE 00003031 "$dt->datetime >> with an added offset at the end of the string except if the"
NSQ_SOURCE_LINE 00003032 "time zone is the floating time zone."
NSQ_SOURCE_LINE 00003033 ""
NSQ_SOURCE_LINE 00003034 "If the offset is '+00:00' then this is represented as 'Z'. Otherwise the offset"
NSQ_SOURCE_LINE 00003035 "is formatted with a leading sign (+/-) and a colon separated numeric offset"
NSQ_SOURCE_LINE 00003036 "with hours and minutes. If the offset has a non-zero seconds component, that is"
NSQ_SOURCE_LINE 00003037 "also included."
NSQ_SOURCE_LINE 00003038 ""
NSQ_SOURCE_LINE 00003039 "=head3 $dt->stringify"
NSQ_SOURCE_LINE 00003040 ""
NSQ_SOURCE_LINE 00003041 "This method returns a stringified version of the object. It is also how"
NSQ_SOURCE_LINE 00003042 "stringification overloading is implemented. If the object has a formatter, then"
NSQ_SOURCE_LINE 00003043 "its C<format_datetime> method is used to produce a string. Otherwise, this"
NSQ_SOURCE_LINE 00003044 "method calls C<< $dt->iso8601 >> to produce a string. See L</Formatters And"
NSQ_SOURCE_LINE 00003045 "Stringification> for details."
NSQ_SOURCE_LINE 00003046 ""
NSQ_SOURCE_LINE 00003047 "=head3 $dt->is_leap_year"
NSQ_SOURCE_LINE 00003048 ""
NSQ_SOURCE_LINE 00003049 "This method returns a boolean value indicating whether or not the datetime"
NSQ_SOURCE_LINE 00003050 "object is in a leap year."
NSQ_SOURCE_LINE 00003051 ""
NSQ_SOURCE_LINE 00003052 "=head3 $dt->is_last_day_of_month"
NSQ_SOURCE_LINE 00003053 ""
NSQ_SOURCE_LINE 00003054 "This method returns a boolean value indicating whether or not the datetime"
NSQ_SOURCE_LINE 00003055 "object is the last day of the month."
NSQ_SOURCE_LINE 00003056 ""
NSQ_SOURCE_LINE 00003057 "=head3 $dt->is_last_day_of_quarter"
NSQ_SOURCE_LINE 00003058 ""
NSQ_SOURCE_LINE 00003059 "This method returns a boolean value indicating whether or not the datetime"
NSQ_SOURCE_LINE 00003060 "object is the last day of the quarter."
NSQ_SOURCE_LINE 00003061 ""
NSQ_SOURCE_LINE 00003062 "=head3 $dt->is_last_day_of_year"
NSQ_SOURCE_LINE 00003063 ""
NSQ_SOURCE_LINE 00003064 "This method returns a boolean value indicating whether or not the datetime"
NSQ_SOURCE_LINE 00003065 "object is the last day of the year."
NSQ_SOURCE_LINE 00003066 ""
NSQ_SOURCE_LINE 00003067 "=head3 $dt->month_length"
NSQ_SOURCE_LINE 00003068 ""
NSQ_SOURCE_LINE 00003069 "This method returns the number of days in the current month."
NSQ_SOURCE_LINE 00003070 ""
NSQ_SOURCE_LINE 00003071 "=head3 $dt->quarter_length"
NSQ_SOURCE_LINE 00003072 ""
NSQ_SOURCE_LINE 00003073 "This method returns the number of days in the current quarter."
NSQ_SOURCE_LINE 00003074 ""
NSQ_SOURCE_LINE 00003075 "=head3 $dt->year_length"
NSQ_SOURCE_LINE 00003076 ""
NSQ_SOURCE_LINE 00003077 "This method returns the number of days in the current year."
NSQ_SOURCE_LINE 00003078 ""
NSQ_SOURCE_LINE 00003079 "=head3 $dt->week"
NSQ_SOURCE_LINE 00003080 ""
NSQ_SOURCE_LINE 00003081 "   my ( $week_year, $week_number ) = $dt->week;"
NSQ_SOURCE_LINE 00003082 ""
NSQ_SOURCE_LINE 00003083 "Returns information about the calendar week for the date. The values returned"
NSQ_SOURCE_LINE 00003084 "by this method are also available separately through the C<< $dt->week_year >>"
NSQ_SOURCE_LINE 00003085 "and C<< $dt->week_number >> methods."
NSQ_SOURCE_LINE 00003086 ""
NSQ_SOURCE_LINE 00003087 "The first week of the year is defined by ISO as the one which contains the"
NSQ_SOURCE_LINE 00003088 "fourth day of January, which is equivalent to saying that it's the first week"
NSQ_SOURCE_LINE 00003089 "to overlap the new year by at least four days."
NSQ_SOURCE_LINE 00003090 ""
NSQ_SOURCE_LINE 00003091 "Typically the week year will be the same as the year that the object is in, but"
NSQ_SOURCE_LINE 00003092 "dates at the very beginning of a calendar year often end up in the last week of"
NSQ_SOURCE_LINE 00003093 "the prior year, and similarly, the final few days of the year may be placed in"
NSQ_SOURCE_LINE 00003094 "the first week of the next year."
NSQ_SOURCE_LINE 00003095 ""
NSQ_SOURCE_LINE 00003096 "=head3 $dt->week_year"
NSQ_SOURCE_LINE 00003097 ""
NSQ_SOURCE_LINE 00003098 "Returns the year of the week. See C<< $dt->week >> for details."
NSQ_SOURCE_LINE 00003099 ""
NSQ_SOURCE_LINE 00003100 "=head3 $dt->week_number"
NSQ_SOURCE_LINE 00003101 ""
NSQ_SOURCE_LINE 00003102 "Returns the week of the year, from 1..53. See C<< $dt->week >> for details."
NSQ_SOURCE_LINE 00003103 ""
NSQ_SOURCE_LINE 00003104 "=head3 $dt->week_of_month"
NSQ_SOURCE_LINE 00003105 ""
NSQ_SOURCE_LINE 00003106 "The week of the month, from 0..5. The first week of the month is the first week"
NSQ_SOURCE_LINE 00003107 "that contains a Thursday. This is based on the ICU definition of week of month,"
NSQ_SOURCE_LINE 00003108 "and correlates to the ISO8601 week of year definition. A day in the week"
NSQ_SOURCE_LINE 00003109 "I<before> the week with the first Thursday will be week 0."
NSQ_SOURCE_LINE 00003110 ""
NSQ_SOURCE_LINE 00003111 "=head3 $dt->jd, $dt->mjd"
NSQ_SOURCE_LINE 00003112 ""
NSQ_SOURCE_LINE 00003113 "These return the Julian Day and Modified Julian Day, respectively. The value"
NSQ_SOURCE_LINE 00003114 "returned is a floating point number. The fractional portion of the number"
NSQ_SOURCE_LINE 00003115 "represents the time portion of the datetime."
NSQ_SOURCE_LINE 00003116 ""
NSQ_SOURCE_LINE 00003117 "The Julian Day is a count of days since the beginning of the Julian Period,"
NSQ_SOURCE_LINE 00003118 "which starts with day 0 at noon on January 1, -4712."
NSQ_SOURCE_LINE 00003119 ""
NSQ_SOURCE_LINE 00003120 "The Modified Julian Day is a count of days since midnight on November 17, 1858."
NSQ_SOURCE_LINE 00003121 ""
NSQ_SOURCE_LINE 00003122 "These methods always refer to the local time, so the Julian Day is the same for"
NSQ_SOURCE_LINE 00003123 "a given datetime regardless of its time zone. Or in other words,"
NSQ_SOURCE_LINE 00003124 "2020-12-04T13:01:57 in \"America/Chicago\" has the same Julian Day as"
NSQ_SOURCE_LINE 00003125 "2020-12-04T13:01:57 in \"Asia/Taipei\"."
NSQ_SOURCE_LINE 00003126 ""
NSQ_SOURCE_LINE 00003127 "=head3 $dt->time_zone"
NSQ_SOURCE_LINE 00003128 ""
NSQ_SOURCE_LINE 00003129 "This returns the L<DateTime::TimeZone> object for the datetime object."
NSQ_SOURCE_LINE 00003130 ""
NSQ_SOURCE_LINE 00003131 "=head3 $dt->offset"
NSQ_SOURCE_LINE 00003132 ""
NSQ_SOURCE_LINE 00003133 "This returns the offset from UTC, in seconds, of the datetime object's time"
NSQ_SOURCE_LINE 00003134 "zone."
NSQ_SOURCE_LINE 00003135 ""
NSQ_SOURCE_LINE 00003136 "=head3 $dt->is_dst"
NSQ_SOURCE_LINE 00003137 ""
NSQ_SOURCE_LINE 00003138 "Returns a boolean indicating whether or not the datetime's time zone is"
NSQ_SOURCE_LINE 00003139 "currently in Daylight Saving Time or not."
NSQ_SOURCE_LINE 00003140 ""
NSQ_SOURCE_LINE 00003141 "=head3 $dt->time_zone_long_name"
NSQ_SOURCE_LINE 00003142 ""
NSQ_SOURCE_LINE 00003143 "This is a shortcut for C<< $dt->time_zone->name >>. It's provided so that one"
NSQ_SOURCE_LINE 00003144 "can use \"%{time_zone_long_name}\" as a strftime format specifier."
NSQ_SOURCE_LINE 00003145 ""
NSQ_SOURCE_LINE 00003146 "=head3 $dt->time_zone_short_name"
NSQ_SOURCE_LINE 00003147 ""
NSQ_SOURCE_LINE 00003148 "This method returns the time zone abbreviation for the current time zone, such"
NSQ_SOURCE_LINE 00003149 "as \"PST\" or \"GMT\". These names are B<not> definitive, and should not be used in"
NSQ_SOURCE_LINE 00003150 "any application intended for general use by users around the world. That's"
NSQ_SOURCE_LINE 00003151 "because it's possible for multiple time zones to have the same abbreviation."
NSQ_SOURCE_LINE 00003152 ""
NSQ_SOURCE_LINE 00003153 "=head3 $dt->strftime( $format, ... )"
NSQ_SOURCE_LINE 00003154 ""
NSQ_SOURCE_LINE 00003155 "This method implements functionality similar to the C<strftime> method in C."
NSQ_SOURCE_LINE 00003156 "However, if given multiple format strings, then it will return multiple"
NSQ_SOURCE_LINE 00003157 "scalars, one for each format string."
NSQ_SOURCE_LINE 00003158 ""
NSQ_SOURCE_LINE 00003159 "See the L<strftime Patterns> section for a list of all possible strftime"
NSQ_SOURCE_LINE 00003160 "patterns."
NSQ_SOURCE_LINE 00003161 ""
NSQ_SOURCE_LINE 00003162 "If you give a pattern that doesn't exist, then it is simply treated as text."
NSQ_SOURCE_LINE 00003163 ""
NSQ_SOURCE_LINE 00003164 "Note that any deviation from the POSIX standard is probably a bug. DateTime"
NSQ_SOURCE_LINE 00003165 "should match the output of C<POSIX::strftime> for any given pattern."
NSQ_SOURCE_LINE 00003166 ""
NSQ_SOURCE_LINE 00003167 "=head3 $dt->format_cldr( $format, ... )"
NSQ_SOURCE_LINE 00003168 ""
NSQ_SOURCE_LINE 00003169 "This method implements formatting based on the CLDR date patterns. If given"
NSQ_SOURCE_LINE 00003170 "multiple format strings, then it will return multiple scalars, one for each"
NSQ_SOURCE_LINE 00003171 "format string."
NSQ_SOURCE_LINE 00003172 ""
NSQ_SOURCE_LINE 00003173 "See the L<CLDR Patterns> section for a list of all possible CLDR patterns."
NSQ_SOURCE_LINE 00003174 ""
NSQ_SOURCE_LINE 00003175 "If you give a pattern that doesn't exist, then it is simply treated as text."
NSQ_SOURCE_LINE 00003176 ""
NSQ_SOURCE_LINE 00003177 "=head3 $dt->epoch"
NSQ_SOURCE_LINE 00003178 ""
NSQ_SOURCE_LINE 00003179 "Returns the UTC epoch value for the datetime object. Datetimes before the start"
NSQ_SOURCE_LINE 00003180 "of the epoch will be returned as a negative number."
NSQ_SOURCE_LINE 00003181 ""
NSQ_SOURCE_LINE 00003182 "The return value from this method is always an integer number of seconds."
NSQ_SOURCE_LINE 00003183 ""
NSQ_SOURCE_LINE 00003184 "Since the epoch does not account for leap seconds, the epoch time for"
NSQ_SOURCE_LINE 00003185 "1972-12-31T23:59:60 (UTC) is exactly the same as that for 1973-01-01T00:00:00."
NSQ_SOURCE_LINE 00003186 ""
NSQ_SOURCE_LINE 00003187 "=head3 $dt->hires_epoch"
NSQ_SOURCE_LINE 00003188 ""
NSQ_SOURCE_LINE 00003189 "Returns the epoch as a floating point number. The floating point portion of the"
NSQ_SOURCE_LINE 00003190 "value represents the nanosecond value of the object. This method is provided"
NSQ_SOURCE_LINE 00003191 "for compatibility with the C<Time::HiRes> module."
NSQ_SOURCE_LINE 00003192 ""
NSQ_SOURCE_LINE 00003193 "Note that this method suffers from the imprecision of floating point numbers,"
NSQ_SOURCE_LINE 00003194 "and the result may end up rounded to an arbitrary degree depending on your"
NSQ_SOURCE_LINE 00003195 "platform."
NSQ_SOURCE_LINE 00003196 ""
NSQ_SOURCE_LINE 00003197 "    my $dt = DateTime->new( year => 2012, nanosecond => 4 );"
NSQ_SOURCE_LINE 00003198 "    say $dt->hires_epoch;"
NSQ_SOURCE_LINE 00003199 ""
NSQ_SOURCE_LINE 00003200 "On my system, this simply prints C<1325376000> because adding C<0.000000004> to"
NSQ_SOURCE_LINE 00003201 "C<1325376000> returns C<1325376000>."
NSQ_SOURCE_LINE 00003202 ""
NSQ_SOURCE_LINE 00003203 "=head3 $dt->is_finite, $dt->is_infinite"
NSQ_SOURCE_LINE 00003204 ""
NSQ_SOURCE_LINE 00003205 "These methods allow you to distinguish normal datetime objects from infinite"
NSQ_SOURCE_LINE 00003206 "ones. Infinite datetime objects are documented in L<DateTime::Infinite>."
NSQ_SOURCE_LINE 00003207 ""
NSQ_SOURCE_LINE 00003208 "=head3 $dt->utc_rd_values"
NSQ_SOURCE_LINE 00003209 ""
NSQ_SOURCE_LINE 00003210 "Returns the current UTC Rata Die days, seconds, and nanoseconds as a three"
NSQ_SOURCE_LINE 00003211 "element list. This exists primarily to allow other calendar modules to create"
NSQ_SOURCE_LINE 00003212 "objects based on the values provided by this object."
NSQ_SOURCE_LINE 00003213 ""
NSQ_SOURCE_LINE 00003214 "=head3 $dt->local_rd_values"
NSQ_SOURCE_LINE 00003215 ""
NSQ_SOURCE_LINE 00003216 "Returns the current local Rata Die days, seconds, and nanoseconds as a three"
NSQ_SOURCE_LINE 00003217 "element list. This exists for the benefit of other modules which might want to"
NSQ_SOURCE_LINE 00003218 "use this information for date math, such as L<DateTime::Event::Recurrence>."
NSQ_SOURCE_LINE 00003219 ""
NSQ_SOURCE_LINE 00003220 "=head3 $dt->leap_seconds"
NSQ_SOURCE_LINE 00003221 ""
NSQ_SOURCE_LINE 00003222 "Returns the number of leap seconds that have happened up to the datetime"
NSQ_SOURCE_LINE 00003223 "represented by the object. For floating datetimes, this always returns 0."
NSQ_SOURCE_LINE 00003224 ""
NSQ_SOURCE_LINE 00003225 "=head3 $dt->utc_rd_as_seconds"
NSQ_SOURCE_LINE 00003226 ""
NSQ_SOURCE_LINE 00003227 "Returns the current UTC Rata Die days and seconds purely as seconds. This"
NSQ_SOURCE_LINE 00003228 "number ignores any fractional seconds stored in the object, as well as leap"
NSQ_SOURCE_LINE 00003229 "seconds."
NSQ_SOURCE_LINE 00003230 ""
NSQ_SOURCE_LINE 00003231 "=head3 $dt->locale"
NSQ_SOURCE_LINE 00003232 ""
NSQ_SOURCE_LINE 00003233 "Returns the datetime's L<DateTime::Locale> object."
NSQ_SOURCE_LINE 00003234 ""
NSQ_SOURCE_LINE 00003235 "=head3 $dt->formatter"
NSQ_SOURCE_LINE 00003236 ""
NSQ_SOURCE_LINE 00003237 "Returns the current formatter object or class. See L<Formatters And"
NSQ_SOURCE_LINE 00003238 "Stringification> for details."
NSQ_SOURCE_LINE 00003239 ""
NSQ_SOURCE_LINE 00003240 "=head2 \"Set\" Methods"
NSQ_SOURCE_LINE 00003241 ""
NSQ_SOURCE_LINE 00003242 "The remaining methods provided by C<DateTime>, except where otherwise"
NSQ_SOURCE_LINE 00003243 "specified, return the object itself, thus making method chaining possible. For"
NSQ_SOURCE_LINE 00003244 "example:"
NSQ_SOURCE_LINE 00003245 ""
NSQ_SOURCE_LINE 00003246 "    my $dt = DateTime->now->set_time_zone( 'Australia/Sydney' );"
NSQ_SOURCE_LINE 00003247 ""
NSQ_SOURCE_LINE 00003248 "    my $first = DateTime"
NSQ_SOURCE_LINE 00003249 "                    ->last_day_of_month( year => 2003, month => 3 )"
NSQ_SOURCE_LINE 00003250 "                    ->add( days => 1 )"
NSQ_SOURCE_LINE 00003251 "                    ->subtract( seconds => 1 );"
NSQ_SOURCE_LINE 00003252 ""
NSQ_SOURCE_LINE 00003253 "=head3 $dt->set( .. )"
NSQ_SOURCE_LINE 00003254 ""
NSQ_SOURCE_LINE 00003255 "This method can be used to change the local components of a date time. This"
NSQ_SOURCE_LINE 00003256 "method accepts any parameter allowed by the C<new> method except for C<locale>"
NSQ_SOURCE_LINE 00003257 "or C<time_zone>. Use C<set_locale> and C<set_time_zone> for those instead."
NSQ_SOURCE_LINE 00003258 ""
NSQ_SOURCE_LINE 00003259 "This method performs parameter validation just like the C<new> method."
NSQ_SOURCE_LINE 00003260 ""
NSQ_SOURCE_LINE 00003261 "B<Do not use this method to do date math. Use the C<add> and C<subtract>"
NSQ_SOURCE_LINE 00003262 "methods instead.>"
NSQ_SOURCE_LINE 00003263 ""
NSQ_SOURCE_LINE 00003264 "=head3 $dt->set_year, $dt->set_month, etc."
NSQ_SOURCE_LINE 00003265 ""
NSQ_SOURCE_LINE 00003266 "DateTime has a C<set_*> method for every item that can be passed to the"
NSQ_SOURCE_LINE 00003267 "constructor:"
NSQ_SOURCE_LINE 00003268 ""
NSQ_SOURCE_LINE 00003269 "=over 4"
NSQ_SOURCE_LINE 00003270 ""
NSQ_SOURCE_LINE 00003271 "=item * $dt->set_year"
NSQ_SOURCE_LINE 00003272 ""
NSQ_SOURCE_LINE 00003273 "=item * $dt->set_month"
NSQ_SOURCE_LINE 00003274 ""
NSQ_SOURCE_LINE 00003275 "=item * $dt->set_day"
NSQ_SOURCE_LINE 00003276 ""
NSQ_SOURCE_LINE 00003277 "=item * $dt->set_hour"
NSQ_SOURCE_LINE 00003278 ""
NSQ_SOURCE_LINE 00003279 "=item * $dt->set_minute"
NSQ_SOURCE_LINE 00003280 ""
NSQ_SOURCE_LINE 00003281 "=item * $dt->set_second"
NSQ_SOURCE_LINE 00003282 ""
NSQ_SOURCE_LINE 00003283 "=item * $dt->set_nanosecond"
NSQ_SOURCE_LINE 00003284 ""
NSQ_SOURCE_LINE 00003285 "=back"
NSQ_SOURCE_LINE 00003286 ""
NSQ_SOURCE_LINE 00003287 "These are shortcuts to calling C<set> with a single key. They all take a single"
NSQ_SOURCE_LINE 00003288 "parameter."
NSQ_SOURCE_LINE 00003289 ""
NSQ_SOURCE_LINE 00003290 "=head3 $dt->truncate( to => ... )"
NSQ_SOURCE_LINE 00003291 ""
NSQ_SOURCE_LINE 00003292 "This method allows you to reset some of the local time components in the object"
NSQ_SOURCE_LINE 00003293 "to their \"zero\" values. The C<to> parameter is used to specify which values to"
NSQ_SOURCE_LINE 00003294 "truncate, and it may be one of C<\"year\">, C<\"quarter\">, C<\"month\">, C<\"week\">,"
NSQ_SOURCE_LINE 00003295 "C<\"local_week\">, C<\"day\">, C<\"hour\">, C<\"minute\">, or C<\"second\">."
NSQ_SOURCE_LINE 00003296 ""
NSQ_SOURCE_LINE 00003297 "For example, if C<\"month\"> is specified, then the local day becomes 1, and the"
NSQ_SOURCE_LINE 00003298 "hour, minute, and second all become 0."
NSQ_SOURCE_LINE 00003299 ""
NSQ_SOURCE_LINE 00003300 "If C<\"week\"> is given, then the datetime is set to the Monday of the week in"
NSQ_SOURCE_LINE 00003301 "which it occurs, and the time components are all set to 0. If you truncate to"
NSQ_SOURCE_LINE 00003302 "C<\"local_week\">, then the first day of the week is locale-dependent. For"
NSQ_SOURCE_LINE 00003303 "example, in the C<\"en-US\"> locale, the first day of the week is Sunday."
NSQ_SOURCE_LINE 00003304 ""
NSQ_SOURCE_LINE 00003305 "=head3 $dt->set_locale($locale)"
NSQ_SOURCE_LINE 00003306 ""
NSQ_SOURCE_LINE 00003307 "Sets the object's locale. You can provide either a locale code like C<\"en-US\">"
NSQ_SOURCE_LINE 00003308 "or an object returned by C<< DateTime::Locale->load >>."
NSQ_SOURCE_LINE 00003309 ""
NSQ_SOURCE_LINE 00003310 "=head3 $dt->set_time_zone($tz)"
NSQ_SOURCE_LINE 00003311 ""
NSQ_SOURCE_LINE 00003312 "This method accepts either a time zone object or a string that can be passed as"
NSQ_SOURCE_LINE 00003313 "the C<name> parameter to C<< DateTime::TimeZone->new >>. If the new time zone's"
NSQ_SOURCE_LINE 00003314 "offset is different from the old time zone, then the I<local> time is adjusted"
NSQ_SOURCE_LINE 00003315 "accordingly."
NSQ_SOURCE_LINE 00003316 ""
NSQ_SOURCE_LINE 00003317 "For example:"
NSQ_SOURCE_LINE 00003318 ""
NSQ_SOURCE_LINE 00003319 "    my $dt = DateTime->new("
NSQ_SOURCE_LINE 00003320 "        year      => 2000,"
NSQ_SOURCE_LINE 00003321 "        month     => 5,"
NSQ_SOURCE_LINE 00003322 "        day       => 10,"
NSQ_SOURCE_LINE 00003323 "        hour      => 15,"
NSQ_SOURCE_LINE 00003324 "        minute    => 15,"
NSQ_SOURCE_LINE 00003325 "        time_zone => 'America/Los_Angeles',"
NSQ_SOURCE_LINE 00003326 "    );"
NSQ_SOURCE_LINE 00003327 ""
NSQ_SOURCE_LINE 00003328 "    print $dt->hour;    # prints 15"
NSQ_SOURCE_LINE 00003329 ""
NSQ_SOURCE_LINE 00003330 "    $dt->set_time_zone('America/Chicago');"
NSQ_SOURCE_LINE 00003331 ""
NSQ_SOURCE_LINE 00003332 "    print $dt->hour;    # prints 17"
NSQ_SOURCE_LINE 00003333 ""
NSQ_SOURCE_LINE 00003334 "If the old time zone was a floating time zone, then no adjustments to the local"
NSQ_SOURCE_LINE 00003335 "time are made, except to account for leap seconds. If the new time zone is"
NSQ_SOURCE_LINE 00003336 "floating, then the I<UTC> time is adjusted in order to leave the local time"
NSQ_SOURCE_LINE 00003337 "untouched."
NSQ_SOURCE_LINE 00003338 ""
NSQ_SOURCE_LINE 00003339 "Fans of Tsai Ming-Liang's films will be happy to know that this does work:"
NSQ_SOURCE_LINE 00003340 ""
NSQ_SOURCE_LINE 00003341 "    my $dt = DateTime->now( time_zone => 'Asia/Taipei' );"
NSQ_SOURCE_LINE 00003342 "    $dt->set_time_zone('Europe/Paris');"
NSQ_SOURCE_LINE 00003343 ""
NSQ_SOURCE_LINE 00003344 "Yes, now we can know \"ni3 na4 bian1 ji2 dian3?\""
NSQ_SOURCE_LINE 00003345 ""
NSQ_SOURCE_LINE 00003346 "=head3 $dt->set_formatter($formatter)"
NSQ_SOURCE_LINE 00003347 ""
NSQ_SOURCE_LINE 00003348 "Sets the formatter for the object. See L<Formatters And Stringification> for"
NSQ_SOURCE_LINE 00003349 "details."
NSQ_SOURCE_LINE 00003350 ""
NSQ_SOURCE_LINE 00003351 "You can set this to C<undef> to revert to the default formatter."
NSQ_SOURCE_LINE 00003352 ""
NSQ_SOURCE_LINE 00003353 "=head2 Math Methods"
NSQ_SOURCE_LINE 00003354 ""
NSQ_SOURCE_LINE 00003355 "Like the set methods, math related methods always return the object itself, to"
NSQ_SOURCE_LINE 00003356 "allow for chaining:"
NSQ_SOURCE_LINE 00003357 ""
NSQ_SOURCE_LINE 00003358 "    $dt->add( days => 1 )->subtract( seconds => 1 );"
NSQ_SOURCE_LINE 00003359 ""
NSQ_SOURCE_LINE 00003360 "=head3 $dt->duration_class"
NSQ_SOURCE_LINE 00003361 ""
NSQ_SOURCE_LINE 00003362 "This returns L<C<\"DateTime::Duration\">|DateTime::Duration>, but exists so that"
NSQ_SOURCE_LINE 00003363 "a subclass of C<DateTime> can provide a different value."
NSQ_SOURCE_LINE 00003364 ""
NSQ_SOURCE_LINE 00003365 "=head3 $dt->add_duration($duration_object)"
NSQ_SOURCE_LINE 00003366 ""
NSQ_SOURCE_LINE 00003367 "This method adds a L<DateTime::Duration> to the current datetime. See the"
NSQ_SOURCE_LINE 00003368 "L<DateTime::Duration> docs for more details."
NSQ_SOURCE_LINE 00003369 ""
NSQ_SOURCE_LINE 00003370 "=head3 $dt->add( parameters for DateTime::Duration )"
NSQ_SOURCE_LINE 00003371 ""
NSQ_SOURCE_LINE 00003372 "This method is syntactic sugar around the C<< $dt->add_duration >> method. It"
NSQ_SOURCE_LINE 00003373 "simply creates a new L<DateTime::Duration> object using the parameters given,"
NSQ_SOURCE_LINE 00003374 "and then calls the C<< $dt->add_duration >> method."
NSQ_SOURCE_LINE 00003375 ""
NSQ_SOURCE_LINE 00003376 "=head3 $dt->add($duration_object)"
NSQ_SOURCE_LINE 00003377 ""
NSQ_SOURCE_LINE 00003378 "A synonym of C<< $dt->add_duration($duration_object) >>."
NSQ_SOURCE_LINE 00003379 ""
NSQ_SOURCE_LINE 00003380 "=head3 $dt->subtract_duration($duration_object)"
NSQ_SOURCE_LINE 00003381 ""
NSQ_SOURCE_LINE 00003382 "When given a L<DateTime::Duration> object, this method simply calls C<<"
NSQ_SOURCE_LINE 00003383 "$dur->inverse >> on that object and passes that new duration to the C<<"
NSQ_SOURCE_LINE 00003384 "$self->add_duration >> method."
NSQ_SOURCE_LINE 00003385 ""
NSQ_SOURCE_LINE 00003386 "=head3 $dt->subtract( DateTime::Duration->new parameters )"
NSQ_SOURCE_LINE 00003387 ""
NSQ_SOURCE_LINE 00003388 "Like C<< $dt->add >>, this is syntactic sugar for the C<<"
NSQ_SOURCE_LINE 00003389 "$dt->subtract_duration >> method."
NSQ_SOURCE_LINE 00003390 ""
NSQ_SOURCE_LINE 00003391 "=head3 $dt->subtract($duration_object)"
NSQ_SOURCE_LINE 00003392 ""
NSQ_SOURCE_LINE 00003393 "A synonym of C<< $dt->subtract_duration($duration_object) >>."
NSQ_SOURCE_LINE 00003394 ""
NSQ_SOURCE_LINE 00003395 "=head3 $dt->subtract_datetime($datetime)"
NSQ_SOURCE_LINE 00003396 ""
NSQ_SOURCE_LINE 00003397 "This method returns a new L<DateTime::Duration> object representing the"
NSQ_SOURCE_LINE 00003398 "difference between the two dates. The duration is B<relative> to the object"
NSQ_SOURCE_LINE 00003399 "from which C<$datetime> is subtracted. For example:"
NSQ_SOURCE_LINE 00003400 ""
NSQ_SOURCE_LINE 00003401 "    2003-03-15 00:00:00.00000000"
NSQ_SOURCE_LINE 00003402 " -  2003-02-15 00:00:00.00000000"
NSQ_SOURCE_LINE 00003403 " -------------------------------"
NSQ_SOURCE_LINE 00003404 " = 1 month"
NSQ_SOURCE_LINE 00003405 ""
NSQ_SOURCE_LINE 00003406 "Note that this duration is not an absolute measure of the amount of time"
NSQ_SOURCE_LINE 00003407 "between the two datetimes, because the length of a month varies, as well as due"
NSQ_SOURCE_LINE 00003408 "to the presence of leap seconds."
NSQ_SOURCE_LINE 00003409 ""
NSQ_SOURCE_LINE 00003410 "The returned duration may have deltas for months, days, minutes, seconds, and"
NSQ_SOURCE_LINE 00003411 "nanoseconds."
NSQ_SOURCE_LINE 00003412 ""
NSQ_SOURCE_LINE 00003413 "=head3 $dt->delta_md($datetime), $dt->delta_days($datetime)"
NSQ_SOURCE_LINE 00003414 ""
NSQ_SOURCE_LINE 00003415 "Each of these methods returns a new L<DateTime::Duration> object representing"
NSQ_SOURCE_LINE 00003416 "some portion of the difference between two datetimes.  The C<< $dt->delta_md >>"
NSQ_SOURCE_LINE 00003417 "method returns a duration which contains only the month and day portions of the"
NSQ_SOURCE_LINE 00003418 "duration is represented. The C<< $dt->delta_days >> method returns a duration"
NSQ_SOURCE_LINE 00003419 "which contains only days."
NSQ_SOURCE_LINE 00003420 ""
NSQ_SOURCE_LINE 00003421 "The C<< $dt->delta_md >> and C<< $dt->delta_days >> methods truncate the"
NSQ_SOURCE_LINE 00003422 "duration so that any fractional portion of a day is ignored. Both of these"
NSQ_SOURCE_LINE 00003423 "methods operate on the date portion of a datetime only, and so effectively"
NSQ_SOURCE_LINE 00003424 "ignore the time zone."
NSQ_SOURCE_LINE 00003425 ""
NSQ_SOURCE_LINE 00003426 "Unlike the subtraction methods, B<these methods always return a positive (or"
NSQ_SOURCE_LINE 00003427 "zero) duration>."
NSQ_SOURCE_LINE 00003428 ""
NSQ_SOURCE_LINE 00003429 "=head3 $dt->delta_ms($datetime)"
NSQ_SOURCE_LINE 00003430 ""
NSQ_SOURCE_LINE 00003431 "Returns a duration which contains only minutes and seconds. Any day and month"
NSQ_SOURCE_LINE 00003432 "differences are converted to minutes and seconds. This method B<always returns"
NSQ_SOURCE_LINE 00003433 "a positive (or zero) duration>."
NSQ_SOURCE_LINE 00003434 ""
NSQ_SOURCE_LINE 00003435 "=head3 $dt->subtract_datetime_absolute($datetime)"
NSQ_SOURCE_LINE 00003436 ""
NSQ_SOURCE_LINE 00003437 "This method returns a new L<DateTime::Duration> object representing the"
NSQ_SOURCE_LINE 00003438 "difference between the two dates in seconds and nanoseconds. This is the only"
NSQ_SOURCE_LINE 00003439 "way to accurately measure the absolute amount of time between two datetimes,"
NSQ_SOURCE_LINE 00003440 "since units larger than a second do not represent a fixed number of seconds."
NSQ_SOURCE_LINE 00003441 ""
NSQ_SOURCE_LINE 00003442 "Note that because of leap seconds, this may not return the same result as doing"
NSQ_SOURCE_LINE 00003443 "this math based on the value returned by C<< $dt->epoch >>."
NSQ_SOURCE_LINE 00003444 ""
NSQ_SOURCE_LINE 00003445 "=head3 $dt->is_between( $lower, $upper )"
NSQ_SOURCE_LINE 00003446 ""
NSQ_SOURCE_LINE 00003447 "Checks whether C<$dt> is strictly between two other DateTime objects."
NSQ_SOURCE_LINE 00003448 ""
NSQ_SOURCE_LINE 00003449 "\"Strictly\" means that C<$dt> must be greater than C<$lower> and less than"
NSQ_SOURCE_LINE 00003450 "C<$upper>. If it is I<equal> to either object then this method returns false."
NSQ_SOURCE_LINE 00003451 ""
NSQ_SOURCE_LINE 00003452 "=head2 Class Methods"
NSQ_SOURCE_LINE 00003453 ""
NSQ_SOURCE_LINE 00003454 "=head3 DateTime->DefaultLocale($locale)"
NSQ_SOURCE_LINE 00003455 ""
NSQ_SOURCE_LINE 00003456 "This can be used to specify the default locale to be used when creating"
NSQ_SOURCE_LINE 00003457 "DateTime objects. If unset, then C<\"en-US\"> is used."
NSQ_SOURCE_LINE 00003458 ""
NSQ_SOURCE_LINE 00003459 "This exists for backwards compatibility, but is probably best avoided. This"
NSQ_SOURCE_LINE 00003460 "will change the default locale for every C<DateTime> object created in your"
NSQ_SOURCE_LINE 00003461 "application, even those created by third party libraries which also use"
NSQ_SOURCE_LINE 00003462 "C<DateTime>."
NSQ_SOURCE_LINE 00003463 ""
NSQ_SOURCE_LINE 00003464 "=head3 DateTime->compare( $dt1, $dt2 ), DateTime->compare_ignore_floating( $dt1, $dt2 )"
NSQ_SOURCE_LINE 00003465 ""
NSQ_SOURCE_LINE 00003466 "    $cmp = DateTime->compare( $dt1, $dt2 );"
NSQ_SOURCE_LINE 00003467 ""
NSQ_SOURCE_LINE 00003468 "    $cmp = DateTime->compare_ignore_floating( $dt1, $dt2 );"
NSQ_SOURCE_LINE 00003469 ""
NSQ_SOURCE_LINE 00003470 "This method compare two DateTime objects. The semantics are compatible with"
NSQ_SOURCE_LINE 00003471 "Perl's C<sort> function; it returns C<-1> if C<< $dt1 < $dt2 >>, C<0> if C<$dt1"
NSQ_SOURCE_LINE 00003472 "== $dt2>, C<1> if C<< $dt1 > $dt2 >>."
NSQ_SOURCE_LINE 00003473 ""
NSQ_SOURCE_LINE 00003474 "If one of the two DateTime objects has a floating time zone, it will first be"
NSQ_SOURCE_LINE 00003475 "converted to the time zone of the other object. This is what you want most of"
NSQ_SOURCE_LINE 00003476 "the time, but it can lead to inconsistent results when you compare a number of"
NSQ_SOURCE_LINE 00003477 "DateTime objects, some of which are floating, and some of which are in other"
NSQ_SOURCE_LINE 00003478 "time zones."
NSQ_SOURCE_LINE 00003479 ""
NSQ_SOURCE_LINE 00003480 "If you want to have consistent results (because you want to sort an array of"
NSQ_SOURCE_LINE 00003481 "objects, for example), you can use the C<compare_ignore_floating> method:"
NSQ_SOURCE_LINE 00003482 ""
NSQ_SOURCE_LINE 00003483 "    @dates = sort { DateTime->compare_ignore_floating( $a, $b ) } @dates;"
NSQ_SOURCE_LINE 00003484 ""
NSQ_SOURCE_LINE 00003485 "In this case, objects with a floating time zone will be sorted as if they were"
NSQ_SOURCE_LINE 00003486 "UTC times."
NSQ_SOURCE_LINE 00003487 ""
NSQ_SOURCE_LINE 00003488 "Since DateTime objects overload comparison operators, this:"
NSQ_SOURCE_LINE 00003489 ""
NSQ_SOURCE_LINE 00003490 "    @dates = sort @dates;"
NSQ_SOURCE_LINE 00003491 ""
NSQ_SOURCE_LINE 00003492 "is equivalent to this:"
NSQ_SOURCE_LINE 00003493 ""
NSQ_SOURCE_LINE 00003494 "    @dates = sort { DateTime->compare( $a, $b ) } @dates;"
NSQ_SOURCE_LINE 00003495 ""
NSQ_SOURCE_LINE 00003496 "DateTime objects can be compared to any other calendar class that implements"
NSQ_SOURCE_LINE 00003497 "the C<utc_rd_values> method."
NSQ_SOURCE_LINE 00003498 ""
NSQ_SOURCE_LINE 00003499 "=head2 Testing Code That Uses DateTime"
NSQ_SOURCE_LINE 00003500 ""
NSQ_SOURCE_LINE 00003501 "If you are trying to test code that calls uses DateTime, you may want to be to"
NSQ_SOURCE_LINE 00003502 "explicitly set the value returned by Perl's C<time> builtin. This builtin is"
NSQ_SOURCE_LINE 00003503 "called by C<< DateTime->now >> and C<< DateTime->today >>."
NSQ_SOURCE_LINE 00003504 ""
NSQ_SOURCE_LINE 00003505 "You can override C<CORE::GLOBAL::time>, but this will only work if you do this"
NSQ_SOURCE_LINE 00003506 "B<before> loading DateTime. If doing this is inconvenient, you can also"
NSQ_SOURCE_LINE 00003507 "override C<DateTime::_core_time>:"
NSQ_SOURCE_LINE 00003508 ""
NSQ_SOURCE_LINE 00003509 "    no warnings 'redefine';"
NSQ_SOURCE_LINE 00003510 "    local *DateTime::_core_time = sub { return 42 };"
NSQ_SOURCE_LINE 00003511 ""
NSQ_SOURCE_LINE 00003512 "DateTime is guaranteed to call this subroutine to get the current C<time>"
NSQ_SOURCE_LINE 00003513 "value. You can also override the C<_core_time> sub in a subclass of DateTime"
NSQ_SOURCE_LINE 00003514 "and use that."
NSQ_SOURCE_LINE 00003515 ""
NSQ_SOURCE_LINE 00003516 "=head2 How DateTime Math Works"
NSQ_SOURCE_LINE 00003517 ""
NSQ_SOURCE_LINE 00003518 "It's important to have some understanding of how datetime math is implemented"
NSQ_SOURCE_LINE 00003519 "in order to effectively use this module and L<DateTime::Duration>."
NSQ_SOURCE_LINE 00003520 ""
NSQ_SOURCE_LINE 00003521 "=head3 Making Things Simple"
NSQ_SOURCE_LINE 00003522 ""
NSQ_SOURCE_LINE 00003523 "If you want to simplify your life and not have to think too hard about the"
NSQ_SOURCE_LINE 00003524 "nitty-gritty of datetime math, I have several recommendations:"
NSQ_SOURCE_LINE 00003525 ""
NSQ_SOURCE_LINE 00003526 "=over 4"
NSQ_SOURCE_LINE 00003527 ""
NSQ_SOURCE_LINE 00003528 "=item * use the floating time zone"
NSQ_SOURCE_LINE 00003529 ""
NSQ_SOURCE_LINE 00003530 "If you do not care about time zones or leap seconds, use the \"floating\""
NSQ_SOURCE_LINE 00003531 "timezone:"
NSQ_SOURCE_LINE 00003532 ""
NSQ_SOURCE_LINE 00003533 "    my $dt = DateTime->now( time_zone => 'floating' );"
NSQ_SOURCE_LINE 00003534 ""
NSQ_SOURCE_LINE 00003535 "Math done on two objects in the floating time zone produces very predictable"
NSQ_SOURCE_LINE 00003536 "results."
NSQ_SOURCE_LINE 00003537 ""
NSQ_SOURCE_LINE 00003538 "Note that in most cases you will want to start by creating an object in a"
NSQ_SOURCE_LINE 00003539 "specific zone and I<then> convert it to the floating time zone. When an object"
NSQ_SOURCE_LINE 00003540 "goes from a real zone to the floating zone, the time for the object remains the"
NSQ_SOURCE_LINE 00003541 "same."
NSQ_SOURCE_LINE 00003542 ""
NSQ_SOURCE_LINE 00003543 "This means that passing the floating zone to a constructor may not do what you"
NSQ_SOURCE_LINE 00003544 "want."
NSQ_SOURCE_LINE 00003545 ""
NSQ_SOURCE_LINE 00003546 "    my $dt = DateTime->now( time_zone => 'floating' );"
NSQ_SOURCE_LINE 00003547 ""
NSQ_SOURCE_LINE 00003548 "is equivalent to"
NSQ_SOURCE_LINE 00003549 ""
NSQ_SOURCE_LINE 00003550 "    my $dt = DateTime->now( time_zone => 'UTC' )->set_time_zone('floating');"
NSQ_SOURCE_LINE 00003551 ""
NSQ_SOURCE_LINE 00003552 "This might not be what you wanted. Instead, you may prefer to do this:"
NSQ_SOURCE_LINE 00003553 ""
NSQ_SOURCE_LINE 00003554 "    my $dt = DateTime->now( time_zone => 'local' )->set_time_zone('floating');"
NSQ_SOURCE_LINE 00003555 ""
NSQ_SOURCE_LINE 00003556 "=item * use UTC for all calculations"
NSQ_SOURCE_LINE 00003557 ""
NSQ_SOURCE_LINE 00003558 "If you do care about time zones (particularly DST) or leap seconds, try to use"
NSQ_SOURCE_LINE 00003559 "non-UTC time zones for presentation and user input only. Convert to UTC"
NSQ_SOURCE_LINE 00003560 "immediately and convert back to the local time zone for presentation:"
NSQ_SOURCE_LINE 00003561 ""
NSQ_SOURCE_LINE 00003562 "    my $dt = DateTime->new( %user_input, time_zone => $user_tz );"
NSQ_SOURCE_LINE 00003563 "    $dt->set_time_zone('UTC');"
NSQ_SOURCE_LINE 00003564 ""
NSQ_SOURCE_LINE 00003565 "    # do various operations - store it, retrieve it, add, subtract, etc."
NSQ_SOURCE_LINE 00003566 ""
NSQ_SOURCE_LINE 00003567 "    $dt->set_time_zone($user_tz);"
NSQ_SOURCE_LINE 00003568 "    print $dt->datetime;"
NSQ_SOURCE_LINE 00003569 ""
NSQ_SOURCE_LINE 00003570 "=item * math on non-UTC time zones"
NSQ_SOURCE_LINE 00003571 ""
NSQ_SOURCE_LINE 00003572 "If you need to do date math on objects with non-UTC time zones, please read the"
NSQ_SOURCE_LINE 00003573 "caveats below carefully. The results C<DateTime> produces are predictable,"
NSQ_SOURCE_LINE 00003574 "correct, and mostly intuitive, but datetime math gets very ugly when time zones"
NSQ_SOURCE_LINE 00003575 "are involved, and there are a few strange corner cases involving subtraction of"
NSQ_SOURCE_LINE 00003576 "two datetimes across a DST change."
NSQ_SOURCE_LINE 00003577 ""
NSQ_SOURCE_LINE 00003578 "If you can always use the floating or UTC time zones, you can skip ahead to"
NSQ_SOURCE_LINE 00003579 "L<Leap Seconds and Date Math>"
NSQ_SOURCE_LINE 00003580 ""
NSQ_SOURCE_LINE 00003581 "=item * date vs datetime math"
NSQ_SOURCE_LINE 00003582 ""
NSQ_SOURCE_LINE 00003583 "If you only care about the date (calendar) portion of a datetime, you should"
NSQ_SOURCE_LINE 00003584 "use either C<< $dt->delta_md >> or C<< $dt->delta_days >>, not C<<"
NSQ_SOURCE_LINE 00003585 "$dt->subtract_datetime >>. This will give predictable, unsurprising results,"
NSQ_SOURCE_LINE 00003586 "free from DST-related complications."
NSQ_SOURCE_LINE 00003587 ""
NSQ_SOURCE_LINE 00003588 "=item * $dt->subtract_datetime and $dt->add_duration"
NSQ_SOURCE_LINE 00003589 ""
NSQ_SOURCE_LINE 00003590 "You must convert your datetime objects to the UTC time zone before doing date"
NSQ_SOURCE_LINE 00003591 "math if you want to make sure that the following formulas are always true:"
NSQ_SOURCE_LINE 00003592 ""
NSQ_SOURCE_LINE 00003593 "    $dt2 - $dt1 = $dur"
NSQ_SOURCE_LINE 00003594 "    $dt1 + $dur = $dt2"
NSQ_SOURCE_LINE 00003595 "    $dt2 - $dur = $dt1"
NSQ_SOURCE_LINE 00003596 ""
NSQ_SOURCE_LINE 00003597 "Note that using C<< $dt->delta_days >> ensures that this formula always works,"
NSQ_SOURCE_LINE 00003598 "regardless of the time zones of the objects involved, as does using C<<"
NSQ_SOURCE_LINE 00003599 "$dt->subtract_datetime_absolute >>. Other methods of subtraction are not always"
NSQ_SOURCE_LINE 00003600 "reversible."
NSQ_SOURCE_LINE 00003601 ""
NSQ_SOURCE_LINE 00003602 "=item * never do math on two objects where only one is in the floating time zone"
NSQ_SOURCE_LINE 00003603 ""
NSQ_SOURCE_LINE 00003604 "The date math code accounts for leap seconds whenever the C<DateTime> object is"
NSQ_SOURCE_LINE 00003605 "not in the floating time zone. If you try to do math where one object is in the"
NSQ_SOURCE_LINE 00003606 "floating zone and the other isn't, the results will be confusing and wrong."
NSQ_SOURCE_LINE 00003607 ""
NSQ_SOURCE_LINE 00003608 "=back"
NSQ_SOURCE_LINE 00003609 ""
NSQ_SOURCE_LINE 00003610 "=head3 Adding a Duration to a DateTime"
NSQ_SOURCE_LINE 00003611 ""
NSQ_SOURCE_LINE 00003612 "The parts of a duration can be broken down into five parts. These are months,"
NSQ_SOURCE_LINE 00003613 "days, minutes, seconds, and nanoseconds. Adding one month to a date is"
NSQ_SOURCE_LINE 00003614 "different than adding 4 weeks or 28, 29, 30, or 31 days.  Similarly, due to DST"
NSQ_SOURCE_LINE 00003615 "and leap seconds, adding a day can be different than adding 86,400 seconds, and"
NSQ_SOURCE_LINE 00003616 "adding a minute is not exactly the same as 60 seconds."
NSQ_SOURCE_LINE 00003617 ""
NSQ_SOURCE_LINE 00003618 "We cannot convert between these units, except for seconds and nanoseconds,"
NSQ_SOURCE_LINE 00003619 "because there is no fixed conversion between most pairs of units. That is"
NSQ_SOURCE_LINE 00003620 "because of things like leap seconds, DST changes, etc."
NSQ_SOURCE_LINE 00003621 ""
NSQ_SOURCE_LINE 00003622 "C<DateTime> always adds (or subtracts) days, then months, minutes, and then"
NSQ_SOURCE_LINE 00003623 "seconds and nanoseconds. If there are any boundary overflows, these are"
NSQ_SOURCE_LINE 00003624 "normalized at each step. For the days and months the local (not UTC) values are"
NSQ_SOURCE_LINE 00003625 "used. For minutes and seconds, the local values are used. This generally just"
NSQ_SOURCE_LINE 00003626 "works."
NSQ_SOURCE_LINE 00003627 ""
NSQ_SOURCE_LINE 00003628 "This means that adding one month and one day to February 28, 2003 will produce"
NSQ_SOURCE_LINE 00003629 "the date April 1, 2003, not March 29, 2003."
NSQ_SOURCE_LINE 00003630 ""
NSQ_SOURCE_LINE 00003631 "    my $dt = DateTime->new( year => 2003, month => 2, day => 28 );"
NSQ_SOURCE_LINE 00003632 ""
NSQ_SOURCE_LINE 00003633 "    $dt->add( months => 1, days => 1 );"
NSQ_SOURCE_LINE 00003634 ""
NSQ_SOURCE_LINE 00003635 "    # 2003-04-01 - the result"
NSQ_SOURCE_LINE 00003636 ""
NSQ_SOURCE_LINE 00003637 "On the other hand, if we add months first, and then separately add days, we end"
NSQ_SOURCE_LINE 00003638 "up with March 29, 2003:"
NSQ_SOURCE_LINE 00003639 ""
NSQ_SOURCE_LINE 00003640 "    $dt->add( months => 1 )->add( days => 1 );"
NSQ_SOURCE_LINE 00003641 ""
NSQ_SOURCE_LINE 00003642 "    # 2003-03-29"
NSQ_SOURCE_LINE 00003643 ""
NSQ_SOURCE_LINE 00003644 "We see similar strangeness when math crosses a DST boundary:"
NSQ_SOURCE_LINE 00003645 ""
NSQ_SOURCE_LINE 00003646 "    my $dt = DateTime->new("
NSQ_SOURCE_LINE 00003647 "        year      => 2003,"
NSQ_SOURCE_LINE 00003648 "        month     => 4,"
NSQ_SOURCE_LINE 00003649 "        day       => 5,"
NSQ_SOURCE_LINE 00003650 "        hour      => 1,"
NSQ_SOURCE_LINE 00003651 "        minute    => 58,"
NSQ_SOURCE_LINE 00003652 "        time_zone => \"America/Chicago\","
NSQ_SOURCE_LINE 00003653 "    );"
NSQ_SOURCE_LINE 00003654 ""
NSQ_SOURCE_LINE 00003655 "    $dt->add( days => 1, minutes => 3 );"
NSQ_SOURCE_LINE 00003656 "    # 2003-04-06 02:01:00"
NSQ_SOURCE_LINE 00003657 ""
NSQ_SOURCE_LINE 00003658 "    $dt->add( minutes => 3 )->add( days => 1 );"
NSQ_SOURCE_LINE 00003659 "    # 2003-04-06 03:01:00"
NSQ_SOURCE_LINE 00003660 ""
NSQ_SOURCE_LINE 00003661 "Note that if you converted the datetime object to UTC first you would get"
NSQ_SOURCE_LINE 00003662 "predictable results."
NSQ_SOURCE_LINE 00003663 ""
NSQ_SOURCE_LINE 00003664 "If you want to know how many seconds a L<DateTime::Duration> object represents,"
NSQ_SOURCE_LINE 00003665 "you have to add it to a datetime to find out, so you could do:"
NSQ_SOURCE_LINE 00003666 ""
NSQ_SOURCE_LINE 00003667 "    my $now   = DateTime->now( time_zone => 'UTC' );"
NSQ_SOURCE_LINE 00003668 "    my $later = $now->clone->add_duration($duration);"
NSQ_SOURCE_LINE 00003669 ""
NSQ_SOURCE_LINE 00003670 "    my $seconds_dur = $later->subtract_datetime_absolute($now);"
NSQ_SOURCE_LINE 00003671 ""
NSQ_SOURCE_LINE 00003672 "This returns a L<DateTime::Duration> which only contains seconds and"
NSQ_SOURCE_LINE 00003673 "nanoseconds."
NSQ_SOURCE_LINE 00003674 ""
NSQ_SOURCE_LINE 00003675 "If we were add the duration to a different C<DateTime> object we might get a"
NSQ_SOURCE_LINE 00003676 "different number of seconds."
NSQ_SOURCE_LINE 00003677 ""
NSQ_SOURCE_LINE 00003678 "L<DateTime::Duration> supports three different end-of-month algorithms for"
NSQ_SOURCE_LINE 00003679 "adding months. This comes into play when an addition results in a day past the"
NSQ_SOURCE_LINE 00003680 "end of the following month (for example, adding one month to January 30)."
NSQ_SOURCE_LINE 00003681 ""
NSQ_SOURCE_LINE 00003682 "    # 2010-08-31 + 1 month = 2010-10-01"
NSQ_SOURCE_LINE 00003683 "    $dt->add( months => 1, end_of_month => 'wrap' );"
NSQ_SOURCE_LINE 00003684 ""
NSQ_SOURCE_LINE 00003685 "    # 2010-01-30 + 1 month = 2010-02-28"
NSQ_SOURCE_LINE 00003686 "    $dt->add( months => 1, end_of_month => 'limit' );"
NSQ_SOURCE_LINE 00003687 ""
NSQ_SOURCE_LINE 00003688 "    # 2010-04-30 + 1 month = 2010-05-31"
NSQ_SOURCE_LINE 00003689 "    $dt->add( months => 1, end_of_month => 'preserve' );"
NSQ_SOURCE_LINE 00003690 ""
NSQ_SOURCE_LINE 00003691 "By default, it uses C<\"wrap\"> for positive durations and C<\"preserve\"> for"
NSQ_SOURCE_LINE 00003692 "negative durations. See L<DateTime::Duration> for a detailed explanation of"
NSQ_SOURCE_LINE 00003693 "these algorithms."
NSQ_SOURCE_LINE 00003694 ""
NSQ_SOURCE_LINE 00003695 "If you need to do lots of work with durations, take a look at the"
NSQ_SOURCE_LINE 00003696 "L<DateTime::Format::Duration> module, which lets you present information from"
NSQ_SOURCE_LINE 00003697 "durations in many useful ways."
NSQ_SOURCE_LINE 00003698 ""
NSQ_SOURCE_LINE 00003699 "There are other subtract/delta methods in C<DateTime> to generate different"
NSQ_SOURCE_LINE 00003700 "types of durations. These methods are C<< $dt->subtract_datetime >>, C<<"
NSQ_SOURCE_LINE 00003701 "$dt->subtract_datetime_absolute >>, C<< $dt->delta_md >>, C<< $dt->delta_days"
NSQ_SOURCE_LINE 00003702 ">>, and C<< $dt->delta_ms >>."
NSQ_SOURCE_LINE 00003703 ""
NSQ_SOURCE_LINE 00003704 "=head3 DateTime Subtraction"
NSQ_SOURCE_LINE 00003705 ""
NSQ_SOURCE_LINE 00003706 "Date subtraction is done based solely on the two object's local datetimes, with"
NSQ_SOURCE_LINE 00003707 "one exception to handle DST changes. Also, if the two datetime objects are in"
NSQ_SOURCE_LINE 00003708 "different time zones, one of them is converted to the other's time zone first"
NSQ_SOURCE_LINE 00003709 "before subtraction. This is best explained through examples:"
NSQ_SOURCE_LINE 00003710 ""
NSQ_SOURCE_LINE 00003711 "The first of these probably makes the most sense:"
NSQ_SOURCE_LINE 00003712 ""
NSQ_SOURCE_LINE 00003713 "    # not DST"
NSQ_SOURCE_LINE 00003714 "    my $dt1 = DateTime->new("
NSQ_SOURCE_LINE 00003715 "        year      => 2003,"
NSQ_SOURCE_LINE 00003716 "        month     => 5,"
NSQ_SOURCE_LINE 00003717 "        day       => 6,"
NSQ_SOURCE_LINE 00003718 "        time_zone => 'America/Chicago',"
NSQ_SOURCE_LINE 00003719 "    );"
NSQ_SOURCE_LINE 00003720 ""
NSQ_SOURCE_LINE 00003721 "    # is DST"
NSQ_SOURCE_LINE 00003722 "    my $dt2 = DateTime->new("
NSQ_SOURCE_LINE 00003723 "        year      => 2003,"
NSQ_SOURCE_LINE 00003724 "        month     => 11,"
NSQ_SOURCE_LINE 00003725 "        day       => 6,"
NSQ_SOURCE_LINE 00003726 "        time_zone => 'America/Chicago',"
NSQ_SOURCE_LINE 00003727 "    );"
NSQ_SOURCE_LINE 00003728 ""
NSQ_SOURCE_LINE 00003729 "    # 6 months"
NSQ_SOURCE_LINE 00003730 "    my $dur = $dt2->subtract_datetime($dt1);"
NSQ_SOURCE_LINE 00003731 ""
NSQ_SOURCE_LINE 00003732 "Nice and simple."
NSQ_SOURCE_LINE 00003733 ""
NSQ_SOURCE_LINE 00003734 "This one is a little trickier, but still fairly logical:"
NSQ_SOURCE_LINE 00003735 ""
NSQ_SOURCE_LINE 00003736 "    # is DST"
NSQ_SOURCE_LINE 00003737 "    my $dt1 = DateTime->new("
NSQ_SOURCE_LINE 00003738 "        year      => 2003,"
NSQ_SOURCE_LINE 00003739 "        month     => 4,"
NSQ_SOURCE_LINE 00003740 "        day       => 5,"
NSQ_SOURCE_LINE 00003741 "        hour      => 1,"
NSQ_SOURCE_LINE 00003742 "        minute    => 58,"
NSQ_SOURCE_LINE 00003743 "        time_zone => \"America/Chicago\","
NSQ_SOURCE_LINE 00003744 "    );"
NSQ_SOURCE_LINE 00003745 ""
NSQ_SOURCE_LINE 00003746 "    # not DST"
NSQ_SOURCE_LINE 00003747 "    my $dt2 = DateTime->new("
NSQ_SOURCE_LINE 00003748 "        year      => 2003,"
NSQ_SOURCE_LINE 00003749 "        month     => 4,"
NSQ_SOURCE_LINE 00003750 "        day       => 7,"
NSQ_SOURCE_LINE 00003751 "        hour      => 2,"
NSQ_SOURCE_LINE 00003752 "        minute    => 1,"
NSQ_SOURCE_LINE 00003753 "        time_zone => \"America/Chicago\","
NSQ_SOURCE_LINE 00003754 "    );"
NSQ_SOURCE_LINE 00003755 ""
NSQ_SOURCE_LINE 00003756 "    # 2 days and 3 minutes"
NSQ_SOURCE_LINE 00003757 "    my $dur = $dt2->subtract_datetime($dt1);"
NSQ_SOURCE_LINE 00003758 ""
NSQ_SOURCE_LINE 00003759 "Which contradicts the result this one gives, even though they both make sense:"
NSQ_SOURCE_LINE 00003760 ""
NSQ_SOURCE_LINE 00003761 "    # is DST"
NSQ_SOURCE_LINE 00003762 "    my $dt1 = DateTime->new("
NSQ_SOURCE_LINE 00003763 "        year      => 2003,"
NSQ_SOURCE_LINE 00003764 "        month     => 4,"
NSQ_SOURCE_LINE 00003765 "        day       => 5,"
NSQ_SOURCE_LINE 00003766 "        hour      => 1,"
NSQ_SOURCE_LINE 00003767 "        minute    => 58,"
NSQ_SOURCE_LINE 00003768 "        time_zone => \"America/Chicago\","
NSQ_SOURCE_LINE 00003769 "    );"
NSQ_SOURCE_LINE 00003770 ""
NSQ_SOURCE_LINE 00003771 "    # not DST"
NSQ_SOURCE_LINE 00003772 "    my $dt2 = DateTime->new("
NSQ_SOURCE_LINE 00003773 "        year      => 2003,"
NSQ_SOURCE_LINE 00003774 "        month     => 4,"
NSQ_SOURCE_LINE 00003775 "        day       => 6,"
NSQ_SOURCE_LINE 00003776 "        hour      => 3,"
NSQ_SOURCE_LINE 00003777 "        minute    => 1,"
NSQ_SOURCE_LINE 00003778 "        time_zone => \"America/Chicago\","
NSQ_SOURCE_LINE 00003779 "    );"
NSQ_SOURCE_LINE 00003780 ""
NSQ_SOURCE_LINE 00003781 "    # 1 day and 3 minutes"
NSQ_SOURCE_LINE 00003782 "    my $dur = $dt2->subtract_datetime($dt1);"
NSQ_SOURCE_LINE 00003783 ""
NSQ_SOURCE_LINE 00003784 "This last example illustrates the \"DST\" exception mentioned earlier. The"
NSQ_SOURCE_LINE 00003785 "exception accounts for the fact 2003-04-06 only lasts 23 hours."
NSQ_SOURCE_LINE 00003786 ""
NSQ_SOURCE_LINE 00003787 "And finally:"
NSQ_SOURCE_LINE 00003788 ""
NSQ_SOURCE_LINE 00003789 "    my $dt2 = DateTime->new("
NSQ_SOURCE_LINE 00003790 "        year      => 2003,"
NSQ_SOURCE_LINE 00003791 "        month     => 10,"
NSQ_SOURCE_LINE 00003792 "        day       => 26,"
NSQ_SOURCE_LINE 00003793 "        hour      => 1,"
NSQ_SOURCE_LINE 00003794 "        time_zone => 'America/Chicago',"
NSQ_SOURCE_LINE 00003795 "    );"
NSQ_SOURCE_LINE 00003796 ""
NSQ_SOURCE_LINE 00003797 "    my $dt1 = $dt2->clone->subtract( hours => 1 );"
NSQ_SOURCE_LINE 00003798 ""
NSQ_SOURCE_LINE 00003799 "    # 60 minutes"
NSQ_SOURCE_LINE 00003800 "    my $dur = $dt2->subtract_datetime($dt1);"
NSQ_SOURCE_LINE 00003801 ""
NSQ_SOURCE_LINE 00003802 "This seems obvious until you realize that subtracting 60 minutes from C<$dt2>"
NSQ_SOURCE_LINE 00003803 "in the above example still leaves the clock time at \"01:00:00\". This time we"
NSQ_SOURCE_LINE 00003804 "are accounting for a 25 hour day."
NSQ_SOURCE_LINE 00003805 ""
NSQ_SOURCE_LINE 00003806 "=head3 Reversibility"
NSQ_SOURCE_LINE 00003807 ""
NSQ_SOURCE_LINE 00003808 "Date math operations are not always reversible. This is because of the way that"
NSQ_SOURCE_LINE 00003809 "addition operations are ordered. As was discussed earlier, adding 1 day and 3"
NSQ_SOURCE_LINE 00003810 "minutes in one call to C<< $dt->add >> is not the same as first adding 3"
NSQ_SOURCE_LINE 00003811 "minutes and 1 day in two separate calls."
NSQ_SOURCE_LINE 00003812 ""
NSQ_SOURCE_LINE 00003813 "If we take a duration returned from C<< $dt->subtract_datetime >> and then try"
NSQ_SOURCE_LINE 00003814 "to add or subtract that duration from one of the datetimes we just used, we"
NSQ_SOURCE_LINE 00003815 "sometimes get interesting results:"
NSQ_SOURCE_LINE 00003816 ""
NSQ_SOURCE_LINE 00003817 "    my $dt1 = DateTime->new("
NSQ_SOURCE_LINE 00003818 "        year      => 2003,"
NSQ_SOURCE_LINE 00003819 "        month     => 4,"
NSQ_SOURCE_LINE 00003820 "        day       => 5,"
NSQ_SOURCE_LINE 00003821 "        hour      => 1,"
NSQ_SOURCE_LINE 00003822 "        minute    => 58,"
NSQ_SOURCE_LINE 00003823 "        time_zone => \"America/Chicago\","
NSQ_SOURCE_LINE 00003824 "    );"
NSQ_SOURCE_LINE 00003825 ""
NSQ_SOURCE_LINE 00003826 "    my $dt2 = DateTime->new("
NSQ_SOURCE_LINE 00003827 "        year      => 2003,"
NSQ_SOURCE_LINE 00003828 "        month     => 4,"
NSQ_SOURCE_LINE 00003829 "        day       => 6,"
NSQ_SOURCE_LINE 00003830 "        hour      => 3,"
NSQ_SOURCE_LINE 00003831 "        minute    => 1,"
NSQ_SOURCE_LINE 00003832 "        time_zone => \"America/Chicago\","
NSQ_SOURCE_LINE 00003833 "    );"
NSQ_SOURCE_LINE 00003834 ""
NSQ_SOURCE_LINE 00003835 "    # 1 day and 3 minutes"
NSQ_SOURCE_LINE 00003836 "    my $dur = $dt2->subtract_datetime($dt1);"
NSQ_SOURCE_LINE 00003837 ""
NSQ_SOURCE_LINE 00003838 "    # gives us $dt2"
NSQ_SOURCE_LINE 00003839 "    $dt1->add_duration($dur);"
NSQ_SOURCE_LINE 00003840 ""
NSQ_SOURCE_LINE 00003841 "    # gives us 2003-04-05 02:58:00 - 1 hour later than $dt1"
NSQ_SOURCE_LINE 00003842 "    $dt2->subtract_duration($dur);"
NSQ_SOURCE_LINE 00003843 ""
NSQ_SOURCE_LINE 00003844 "The C<< $dt->subtract_duration >> operation gives us a (perhaps) unexpected"
NSQ_SOURCE_LINE 00003845 "answer because it first subtracts one day to get 2003-04-05T03:01:00 and then"
NSQ_SOURCE_LINE 00003846 "subtracts 3 minutes to get the final result."
NSQ_SOURCE_LINE 00003847 ""
NSQ_SOURCE_LINE 00003848 "If we explicitly reverse the order we can get the original value of C<$dt1>."
NSQ_SOURCE_LINE 00003849 "This can be facilitated by the L<DateTime::Duration> class's C<<"
NSQ_SOURCE_LINE 00003850 "$dur->calendar_duration >> and C<< $dur->clock_duration >> methods:"
NSQ_SOURCE_LINE 00003851 ""
NSQ_SOURCE_LINE 00003852 "    $dt2->subtract_duration( $dur->clock_duration )"
NSQ_SOURCE_LINE 00003853 "        ->subtract_duration( $dur->calendar_duration );"
NSQ_SOURCE_LINE 00003854 ""
NSQ_SOURCE_LINE 00003855 "=head3 Leap Seconds and Date Math"
NSQ_SOURCE_LINE 00003856 ""
NSQ_SOURCE_LINE 00003857 "The presence of leap seconds can cause even more anomalies in date math. For"
NSQ_SOURCE_LINE 00003858 "example, the following is a legal datetime:"
NSQ_SOURCE_LINE 00003859 ""
NSQ_SOURCE_LINE 00003860 "    my $dt = DateTime->new("
NSQ_SOURCE_LINE 00003861 "        year      => 1972,"
NSQ_SOURCE_LINE 00003862 "        month     => 12,"
NSQ_SOURCE_LINE 00003863 "        day       => 31,"
NSQ_SOURCE_LINE 00003864 "        hour      => 23,"
NSQ_SOURCE_LINE 00003865 "        minute    => 59,"
NSQ_SOURCE_LINE 00003866 "        second    => 60,"
NSQ_SOURCE_LINE 00003867 "        time_zone => 'UTC'"
NSQ_SOURCE_LINE 00003868 "    );"
NSQ_SOURCE_LINE 00003869 ""
NSQ_SOURCE_LINE 00003870 "If we add one month ..."
NSQ_SOURCE_LINE 00003871 ""
NSQ_SOURCE_LINE 00003872 "    $dt->add( months => 1 );"
NSQ_SOURCE_LINE 00003873 ""
NSQ_SOURCE_LINE 00003874 "... the datetime is now \"1973-02-01 00:00:00\", because there is no 23:59:60 on"
NSQ_SOURCE_LINE 00003875 "1973-01-31."
NSQ_SOURCE_LINE 00003876 ""
NSQ_SOURCE_LINE 00003877 "Leap seconds also force us to distinguish between minutes and seconds during"
NSQ_SOURCE_LINE 00003878 "date math. Given the following datetime ..."
NSQ_SOURCE_LINE 00003879 ""
NSQ_SOURCE_LINE 00003880 "    my $dt = DateTime->new("
NSQ_SOURCE_LINE 00003881 "        year      => 1972,"
NSQ_SOURCE_LINE 00003882 "        month     => 12,"
NSQ_SOURCE_LINE 00003883 "        day       => 31,"
NSQ_SOURCE_LINE 00003884 "        hour      => 23,"
NSQ_SOURCE_LINE 00003885 "        minute    => 59,"
NSQ_SOURCE_LINE 00003886 "        second    => 30,"
NSQ_SOURCE_LINE 00003887 "        time_zone => 'UTC'"
NSQ_SOURCE_LINE 00003888 "    );"
NSQ_SOURCE_LINE 00003889 ""
NSQ_SOURCE_LINE 00003890 "... we will get different results when adding 1 minute than we get if we add 60"
NSQ_SOURCE_LINE 00003891 "seconds. This is because in this case, the last minute of the day, beginning at"
NSQ_SOURCE_LINE 00003892 "23:59:00, actually contains 61 seconds."
NSQ_SOURCE_LINE 00003893 ""
NSQ_SOURCE_LINE 00003894 "Here are the results we get:"
NSQ_SOURCE_LINE 00003895 ""
NSQ_SOURCE_LINE 00003896 "    # 1972-12-31 23:59:30 - our starting datetime"
NSQ_SOURCE_LINE 00003897 "    my $dt = DateTime->new("
NSQ_SOURCE_LINE 00003898 "        year      => 1972,"
NSQ_SOURCE_LINE 00003899 "        month     => 12,"
NSQ_SOURCE_LINE 00003900 "        day       => 31,"
NSQ_SOURCE_LINE 00003901 "        hour      => 23,"
NSQ_SOURCE_LINE 00003902 "        minute    => 59,"
NSQ_SOURCE_LINE 00003903 "        second    => 30,"
NSQ_SOURCE_LINE 00003904 "        time_zone => 'UTC'"
NSQ_SOURCE_LINE 00003905 "    );"
NSQ_SOURCE_LINE 00003906 ""
NSQ_SOURCE_LINE 00003907 "    # 1973-01-01 00:00:30 - one minute later"
NSQ_SOURCE_LINE 00003908 "    $dt->clone->add( minutes => 1 );"
NSQ_SOURCE_LINE 00003909 ""
NSQ_SOURCE_LINE 00003910 "    # 1973-01-01 00:00:29 - 60 seconds later"
NSQ_SOURCE_LINE 00003911 "    $dt->clone->add( seconds => 60 );"
NSQ_SOURCE_LINE 00003912 ""
NSQ_SOURCE_LINE 00003913 "    # 1973-01-01 00:00:30 - 61 seconds later"
NSQ_SOURCE_LINE 00003914 "    $dt->clone->add( seconds => 61 );"
NSQ_SOURCE_LINE 00003915 ""
NSQ_SOURCE_LINE 00003916 "=head3 Local vs. UTC and 24 hours vs. 1 day"
NSQ_SOURCE_LINE 00003917 ""
NSQ_SOURCE_LINE 00003918 "When math crosses a daylight saving boundary, a single day may have more or"
NSQ_SOURCE_LINE 00003919 "less than 24 hours."
NSQ_SOURCE_LINE 00003920 ""
NSQ_SOURCE_LINE 00003921 "For example, if you do this ..."
NSQ_SOURCE_LINE 00003922 ""
NSQ_SOURCE_LINE 00003923 "    my $dt = DateTime->new("
NSQ_SOURCE_LINE 00003924 "        year      => 2003,"
NSQ_SOURCE_LINE 00003925 "        month     => 4,"
NSQ_SOURCE_LINE 00003926 "        day       => 5,"
NSQ_SOURCE_LINE 00003927 "        hour      => 2,"
NSQ_SOURCE_LINE 00003928 "        time_zone => 'America/Chicago',"
NSQ_SOURCE_LINE 00003929 "    );"
NSQ_SOURCE_LINE 00003930 ""
NSQ_SOURCE_LINE 00003931 "    $dt->add( days => 1 );"
NSQ_SOURCE_LINE 00003932 ""
NSQ_SOURCE_LINE 00003933 "... then you will produce an I<invalid> local time, and therefore an exception"
NSQ_SOURCE_LINE 00003934 "will be thrown."
NSQ_SOURCE_LINE 00003935 ""
NSQ_SOURCE_LINE 00003936 "However, this works ..."
NSQ_SOURCE_LINE 00003937 ""
NSQ_SOURCE_LINE 00003938 "    my $dt = DateTime->new("
NSQ_SOURCE_LINE 00003939 "        year      => 2003,"
NSQ_SOURCE_LINE 00003940 "        month     => 4,"
NSQ_SOURCE_LINE 00003941 "        day       => 5,"
NSQ_SOURCE_LINE 00003942 "        hour      => 2,"
NSQ_SOURCE_LINE 00003943 "        time_zone => 'America/Chicago',"
NSQ_SOURCE_LINE 00003944 "    );"
NSQ_SOURCE_LINE 00003945 ""
NSQ_SOURCE_LINE 00003946 "    $dt->add( hours => 24 );"
NSQ_SOURCE_LINE 00003947 ""
NSQ_SOURCE_LINE 00003948 "... and produces a datetime with the local time of \"03:00\"."
NSQ_SOURCE_LINE 00003949 ""
NSQ_SOURCE_LINE 00003950 "If all this makes your head hurt, there is a simple alternative. Just convert"
NSQ_SOURCE_LINE 00003951 "your datetime object to the \"UTC\" time zone before doing date math on it, and"
NSQ_SOURCE_LINE 00003952 "switch it back to the local time zone afterwards. This avoids the possibility"
NSQ_SOURCE_LINE 00003953 "of having date math throw an exception, and makes sure that 1 day equals 24"
NSQ_SOURCE_LINE 00003954 "hours. Of course, this may not always be desirable, so caveat user!"
NSQ_SOURCE_LINE 00003955 ""
NSQ_SOURCE_LINE 00003956 "=head2 Overloading"
NSQ_SOURCE_LINE 00003957 ""
NSQ_SOURCE_LINE 00003958 "This module explicitly overloads the addition (+), subtraction (-), string and"
NSQ_SOURCE_LINE 00003959 "numeric comparison operators. This means that the following all do sensible"
NSQ_SOURCE_LINE 00003960 "things:"
NSQ_SOURCE_LINE 00003961 ""
NSQ_SOURCE_LINE 00003962 "    my $new_dt = $dt + $duration_obj;"
NSQ_SOURCE_LINE 00003963 ""
NSQ_SOURCE_LINE 00003964 "    my $new_dt = $dt - $duration_obj;"
NSQ_SOURCE_LINE 00003965 ""
NSQ_SOURCE_LINE 00003966 "    my $duration_obj = $dt - $new_dt;"
NSQ_SOURCE_LINE 00003967 ""
NSQ_SOURCE_LINE 00003968 "    for my $dt ( sort @dts ) {...}"
NSQ_SOURCE_LINE 00003969 ""
NSQ_SOURCE_LINE 00003970 "Additionally, the fallback parameter is set to true, so other derivable"
NSQ_SOURCE_LINE 00003971 "operators (+=, -=, etc.) will work properly. Do not expect increment (++) or"
NSQ_SOURCE_LINE 00003972 "decrement (--) to do anything useful."
NSQ_SOURCE_LINE 00003973 ""
NSQ_SOURCE_LINE 00003974 "The string comparison operators, C<eq> or C<ne>, will use the string value to"
NSQ_SOURCE_LINE 00003975 "compare with non-DateTime objects."
NSQ_SOURCE_LINE 00003976 ""
NSQ_SOURCE_LINE 00003977 "DateTime objects do not have a numeric value, using C<==> or C<< <=> >> to"
NSQ_SOURCE_LINE 00003978 "compare a DateTime object with a non-DateTime object will result in an"
NSQ_SOURCE_LINE 00003979 "exception. To safely sort mixed DateTime and non-DateTime objects, use C<sort {"
NSQ_SOURCE_LINE 00003980 "$a cmp $b } @dates>."
NSQ_SOURCE_LINE 00003981 ""
NSQ_SOURCE_LINE 00003982 "The module also overloads stringification using the object's formatter,"
NSQ_SOURCE_LINE 00003983 "defaulting to C<iso8601> method. See L<Formatters And Stringification> for"
NSQ_SOURCE_LINE 00003984 "details."
NSQ_SOURCE_LINE 00003985 ""
NSQ_SOURCE_LINE 00003986 "=head2 Formatters And Stringification"
NSQ_SOURCE_LINE 00003987 ""
NSQ_SOURCE_LINE 00003988 "You can optionally specify a C<formatter>, which is usually a"
NSQ_SOURCE_LINE 00003989 "C<DateTime::Format::*> object or class, to control the stringification of the"
NSQ_SOURCE_LINE 00003990 "DateTime object."
NSQ_SOURCE_LINE 00003991 ""
NSQ_SOURCE_LINE 00003992 "Any of the constructor methods can accept a formatter argument:"
NSQ_SOURCE_LINE 00003993 ""
NSQ_SOURCE_LINE 00003994 "    my $formatter = DateTime::Format::Strptime->new(...);"
NSQ_SOURCE_LINE 00003995 "    my $dt        = DateTime->new( year => 2004, formatter => $formatter );"
NSQ_SOURCE_LINE 00003996 ""
NSQ_SOURCE_LINE 00003997 "Or, you can set it afterwards:"
NSQ_SOURCE_LINE 00003998 ""
NSQ_SOURCE_LINE 00003999 "    $dt->set_formatter($formatter);"
NSQ_SOURCE_LINE 00004000 "    $formatter = $dt->formatter;"
NSQ_SOURCE_LINE 00004001 ""
NSQ_SOURCE_LINE 00004002 "Once you set the formatter, the overloaded stringification method will use the"
NSQ_SOURCE_LINE 00004003 "formatter. If unspecified, the C<iso8601> method is used."
NSQ_SOURCE_LINE 00004004 ""
NSQ_SOURCE_LINE 00004005 "A formatter can be handy when you know that in your application you want to"
NSQ_SOURCE_LINE 00004006 "stringify your DateTime objects into a special format all the time, for example"
NSQ_SOURCE_LINE 00004007 "in Postgres format."
NSQ_SOURCE_LINE 00004008 ""
NSQ_SOURCE_LINE 00004009 "If you provide a formatter class name or object, it must implement a"
NSQ_SOURCE_LINE 00004010 "C<format_datetime> method. This method will be called with just the C<DateTime>"
NSQ_SOURCE_LINE 00004011 "object as its argument."
NSQ_SOURCE_LINE 00004012 ""
NSQ_SOURCE_LINE 00004013 "=head2 CLDR Patterns"
NSQ_SOURCE_LINE 00004014 ""
NSQ_SOURCE_LINE 00004015 "The CLDR pattern language is both more powerful and more complex than strftime."
NSQ_SOURCE_LINE 00004016 "Unlike strftime patterns, you often have to explicitly escape text that you do"
NSQ_SOURCE_LINE 00004017 "not want formatted, as the patterns are simply letters without any prefix."
NSQ_SOURCE_LINE 00004018 ""
NSQ_SOURCE_LINE 00004019 "For example, C<\"yyyy-MM-dd\"> is a valid CLDR pattern. If you want to include"
NSQ_SOURCE_LINE 00004020 "any lower or upper case ASCII characters as-is, you can surround them with"
NSQ_SOURCE_LINE 00004021 "single quotes ('). If you want to include a single quote, you must escape it as"
NSQ_SOURCE_LINE 00004022 "two single quotes ('')."
NSQ_SOURCE_LINE 00004023 ""
NSQ_SOURCE_LINE 00004024 "    my $pattern1 = q{'Today is ' EEEE};"
NSQ_SOURCE_LINE 00004025 "    my $pattern2 = q{'It is now' h 'o''clock' a};"
NSQ_SOURCE_LINE 00004026 ""
NSQ_SOURCE_LINE 00004027 "Spaces and any non-letter text will always be passed through as-is."
NSQ_SOURCE_LINE 00004028 ""
NSQ_SOURCE_LINE 00004029 "Many CLDR patterns which produce numbers will pad the number with leading"
NSQ_SOURCE_LINE 00004030 "zeroes depending on the length of the format specifier. For example, C<\"h\">"
NSQ_SOURCE_LINE 00004031 "represents the current hour from 1-12. If you specify C<\"hh\"> then hours 1-9"
NSQ_SOURCE_LINE 00004032 "will have a leading zero prepended."
NSQ_SOURCE_LINE 00004033 ""
NSQ_SOURCE_LINE 00004034 "However, CLDR often uses five of a letter to represent the narrow form of a"
NSQ_SOURCE_LINE 00004035 "pattern. This inconsistency is necessary for backwards compatibility."
NSQ_SOURCE_LINE 00004036 ""
NSQ_SOURCE_LINE 00004037 "There are many cases where CLDR patterns distinguish between the \"format\" and"
NSQ_SOURCE_LINE 00004038 "\"stand-alone\" forms of a pattern. The format pattern is used when the thing in"
NSQ_SOURCE_LINE 00004039 "question is being placed into a larger string. The stand-alone form is used"
NSQ_SOURCE_LINE 00004040 "when displaying that item by itself, for example in a calendar."
NSQ_SOURCE_LINE 00004041 ""
NSQ_SOURCE_LINE 00004042 "There are also many cases where CLDR provides three sizes for each item, wide"
NSQ_SOURCE_LINE 00004043 "(the full name), abbreviated, and narrow. The narrow form is often just a"
NSQ_SOURCE_LINE 00004044 "single character, for example \"T\" for \"Tuesday\", and may not be unique."
NSQ_SOURCE_LINE 00004045 ""
NSQ_SOURCE_LINE 00004046 "CLDR provides a fairly complex system for localizing time zones that we ignore"
NSQ_SOURCE_LINE 00004047 "entirely. The time zone patterns just use the information provided by"
NSQ_SOURCE_LINE 00004048 "C<DateTime::TimeZone>, and I<do not follow the CLDR spec>."
NSQ_SOURCE_LINE 00004049 ""
NSQ_SOURCE_LINE 00004050 "The output of a CLDR pattern is always localized, when applicable."
NSQ_SOURCE_LINE 00004051 ""
NSQ_SOURCE_LINE 00004052 "CLDR provides the following patterns:"
NSQ_SOURCE_LINE 00004053 ""
NSQ_SOURCE_LINE 00004054 "=over 4"
NSQ_SOURCE_LINE 00004055 ""
NSQ_SOURCE_LINE 00004056 "=item * G{1,3}"
NSQ_SOURCE_LINE 00004057 ""
NSQ_SOURCE_LINE 00004058 "The abbreviated era (BC, AD)."
NSQ_SOURCE_LINE 00004059 ""
NSQ_SOURCE_LINE 00004060 "=item * GGGG"
NSQ_SOURCE_LINE 00004061 ""
NSQ_SOURCE_LINE 00004062 "The wide era (Before Christ, Anno Domini)."
NSQ_SOURCE_LINE 00004063 ""
NSQ_SOURCE_LINE 00004064 "=item * GGGGG"
NSQ_SOURCE_LINE 00004065 ""
NSQ_SOURCE_LINE 00004066 "The narrow era, if it exists (but it mostly doesn't)."
NSQ_SOURCE_LINE 00004067 ""
NSQ_SOURCE_LINE 00004068 "=item * y and y{3,}"
NSQ_SOURCE_LINE 00004069 ""
NSQ_SOURCE_LINE 00004070 "The year, zero-prefixed as needed. Negative years will start with a \"-\", and"
NSQ_SOURCE_LINE 00004071 "this will be included in the length calculation."
NSQ_SOURCE_LINE 00004072 ""
NSQ_SOURCE_LINE 00004073 "In other, words the \"yyyyy\" pattern will format year -1234 as \"-1234\", not"
NSQ_SOURCE_LINE 00004074 "\"-01234\"."
NSQ_SOURCE_LINE 00004075 ""
NSQ_SOURCE_LINE 00004076 "=item * yy"
NSQ_SOURCE_LINE 00004077 ""
NSQ_SOURCE_LINE 00004078 "This is a special case. It always produces a two-digit year, so \"1976\" becomes"
NSQ_SOURCE_LINE 00004079 "\"76\". Negative years will start with a \"-\", making them one character longer."
NSQ_SOURCE_LINE 00004080 ""
NSQ_SOURCE_LINE 00004081 "=item * Y{1,}"
NSQ_SOURCE_LINE 00004082 ""
NSQ_SOURCE_LINE 00004083 "The year in \"week of the year\" calendars, from C<< $dt->week_year >>."
NSQ_SOURCE_LINE 00004084 ""
NSQ_SOURCE_LINE 00004085 "=item * u{1,}"
NSQ_SOURCE_LINE 00004086 ""
NSQ_SOURCE_LINE 00004087 "Same as \"y\" except that \"uu\" is not a special case."
NSQ_SOURCE_LINE 00004088 ""
NSQ_SOURCE_LINE 00004089 "=item * Q{1,2}"
NSQ_SOURCE_LINE 00004090 ""
NSQ_SOURCE_LINE 00004091 "The quarter as a number (1..4)."
NSQ_SOURCE_LINE 00004092 ""
NSQ_SOURCE_LINE 00004093 "=item * QQQ"
NSQ_SOURCE_LINE 00004094 ""
NSQ_SOURCE_LINE 00004095 "The abbreviated format form for the quarter."
NSQ_SOURCE_LINE 00004096 ""
NSQ_SOURCE_LINE 00004097 "=item * QQQQ"
NSQ_SOURCE_LINE 00004098 ""
NSQ_SOURCE_LINE 00004099 "The wide format form for the quarter."
NSQ_SOURCE_LINE 00004100 ""
NSQ_SOURCE_LINE 00004101 "=item * q{1,2}"
NSQ_SOURCE_LINE 00004102 ""
NSQ_SOURCE_LINE 00004103 "The quarter as a number (1..4)."
NSQ_SOURCE_LINE 00004104 ""
NSQ_SOURCE_LINE 00004105 "=item * qqq"
NSQ_SOURCE_LINE 00004106 ""
NSQ_SOURCE_LINE 00004107 "The abbreviated stand-alone form for the quarter."
NSQ_SOURCE_LINE 00004108 ""
NSQ_SOURCE_LINE 00004109 "=item * qqqq"
NSQ_SOURCE_LINE 00004110 ""
NSQ_SOURCE_LINE 00004111 "The wide stand-alone form for the quarter."
NSQ_SOURCE_LINE 00004112 ""
NSQ_SOURCE_LINE 00004113 "=item * M{1,2}"
NSQ_SOURCE_LINE 00004114 ""
NSQ_SOURCE_LINE 00004115 "The numerical month."
NSQ_SOURCE_LINE 00004116 ""
NSQ_SOURCE_LINE 00004117 "=item * MMM"
NSQ_SOURCE_LINE 00004118 ""
NSQ_SOURCE_LINE 00004119 "The abbreviated format form for the month."
NSQ_SOURCE_LINE 00004120 ""
NSQ_SOURCE_LINE 00004121 "=item * MMMM"
NSQ_SOURCE_LINE 00004122 ""
NSQ_SOURCE_LINE 00004123 "The wide format form for the month."
NSQ_SOURCE_LINE 00004124 ""
NSQ_SOURCE_LINE 00004125 "=item * MMMMM"
NSQ_SOURCE_LINE 00004126 ""
NSQ_SOURCE_LINE 00004127 "The narrow format form for the month."
NSQ_SOURCE_LINE 00004128 ""
NSQ_SOURCE_LINE 00004129 "=item * L{1,2}"
NSQ_SOURCE_LINE 00004130 ""
NSQ_SOURCE_LINE 00004131 "The numerical month."
NSQ_SOURCE_LINE 00004132 ""
NSQ_SOURCE_LINE 00004133 "=item * LLL"
NSQ_SOURCE_LINE 00004134 ""
NSQ_SOURCE_LINE 00004135 "The abbreviated stand-alone form for the month."
NSQ_SOURCE_LINE 00004136 ""
NSQ_SOURCE_LINE 00004137 "=item * LLLL"
NSQ_SOURCE_LINE 00004138 ""
NSQ_SOURCE_LINE 00004139 "The wide stand-alone form for the month."
NSQ_SOURCE_LINE 00004140 ""
NSQ_SOURCE_LINE 00004141 "=item * LLLLL"
NSQ_SOURCE_LINE 00004142 ""
NSQ_SOURCE_LINE 00004143 "The narrow stand-alone form for the month."
NSQ_SOURCE_LINE 00004144 ""
NSQ_SOURCE_LINE 00004145 "=item * w{1,2}"
NSQ_SOURCE_LINE 00004146 ""
NSQ_SOURCE_LINE 00004147 "The week of the year, from C<< $dt->week_number >>."
NSQ_SOURCE_LINE 00004148 ""
NSQ_SOURCE_LINE 00004149 "=item * W"
NSQ_SOURCE_LINE 00004150 ""
NSQ_SOURCE_LINE 00004151 "The week of the month, from C<< $dt->week_of_month >>."
NSQ_SOURCE_LINE 00004152 ""
NSQ_SOURCE_LINE 00004153 "=item * d{1,2}"
NSQ_SOURCE_LINE 00004154 ""
NSQ_SOURCE_LINE 00004155 "The numeric day of the month."
NSQ_SOURCE_LINE 00004156 ""
NSQ_SOURCE_LINE 00004157 "=item * D{1,3}"
NSQ_SOURCE_LINE 00004158 ""
NSQ_SOURCE_LINE 00004159 "The numeric day of the year."
NSQ_SOURCE_LINE 00004160 ""
NSQ_SOURCE_LINE 00004161 "=item * F"
NSQ_SOURCE_LINE 00004162 ""
NSQ_SOURCE_LINE 00004163 "The day of the week in the month, from C<< $dt->weekday_of_month >>."
NSQ_SOURCE_LINE 00004164 ""
NSQ_SOURCE_LINE 00004165 "=item * g{1,}"
NSQ_SOURCE_LINE 00004166 ""
NSQ_SOURCE_LINE 00004167 "The modified Julian day, from C<< $dt->mjd >>."
NSQ_SOURCE_LINE 00004168 ""
NSQ_SOURCE_LINE 00004169 "=item * E{1,3} and eee"
NSQ_SOURCE_LINE 00004170 ""
NSQ_SOURCE_LINE 00004171 "The abbreviated format form for the day of the week."
NSQ_SOURCE_LINE 00004172 ""
NSQ_SOURCE_LINE 00004173 "=item * EEEE and eeee"
NSQ_SOURCE_LINE 00004174 ""
NSQ_SOURCE_LINE 00004175 "The wide format form for the day of the week."
NSQ_SOURCE_LINE 00004176 ""
NSQ_SOURCE_LINE 00004177 "=item * EEEEE and eeeee"
NSQ_SOURCE_LINE 00004178 ""
NSQ_SOURCE_LINE 00004179 "The narrow format form for the day of the week."
NSQ_SOURCE_LINE 00004180 ""
NSQ_SOURCE_LINE 00004181 "=item * e{1,2}"
NSQ_SOURCE_LINE 00004182 ""
NSQ_SOURCE_LINE 00004183 "The I<local> numeric day of the week, from 1 to 7. This number depends on what"
NSQ_SOURCE_LINE 00004184 "day is considered the first day of the week, which varies by locale. For"
NSQ_SOURCE_LINE 00004185 "example, in the US, Sunday is the first day of the week, so this returns 2 for"
NSQ_SOURCE_LINE 00004186 "Monday."
NSQ_SOURCE_LINE 00004187 ""
NSQ_SOURCE_LINE 00004188 "=item * c"
NSQ_SOURCE_LINE 00004189 ""
NSQ_SOURCE_LINE 00004190 "The numeric day of the week from 1 to 7, treating Monday as the first of the"
NSQ_SOURCE_LINE 00004191 "week, regardless of locale."
NSQ_SOURCE_LINE 00004192 ""
NSQ_SOURCE_LINE 00004193 "=item * ccc"
NSQ_SOURCE_LINE 00004194 ""
NSQ_SOURCE_LINE 00004195 "The abbreviated stand-alone form for the day of the week."
NSQ_SOURCE_LINE 00004196 ""
NSQ_SOURCE_LINE 00004197 "=item * cccc"
NSQ_SOURCE_LINE 00004198 ""
NSQ_SOURCE_LINE 00004199 "The wide stand-alone form for the day of the week."
NSQ_SOURCE_LINE 00004200 ""
NSQ_SOURCE_LINE 00004201 "=item * ccccc"
NSQ_SOURCE_LINE 00004202 ""
NSQ_SOURCE_LINE 00004203 "The narrow format form for the day of the week."
NSQ_SOURCE_LINE 00004204 ""
NSQ_SOURCE_LINE 00004205 "=item * a"
NSQ_SOURCE_LINE 00004206 ""
NSQ_SOURCE_LINE 00004207 "The localized form of AM or PM for the time."
NSQ_SOURCE_LINE 00004208 ""
NSQ_SOURCE_LINE 00004209 "=item * h{1,2}"
NSQ_SOURCE_LINE 00004210 ""
NSQ_SOURCE_LINE 00004211 "The hour from 1-12."
NSQ_SOURCE_LINE 00004212 ""
NSQ_SOURCE_LINE 00004213 "=item * H{1,2}"
NSQ_SOURCE_LINE 00004214 ""
NSQ_SOURCE_LINE 00004215 "The hour from 0-23."
NSQ_SOURCE_LINE 00004216 ""
NSQ_SOURCE_LINE 00004217 "=item * K{1,2}"
NSQ_SOURCE_LINE 00004218 ""
NSQ_SOURCE_LINE 00004219 "The hour from 0-11."
NSQ_SOURCE_LINE 00004220 ""
NSQ_SOURCE_LINE 00004221 "=item * k{1,2}"
NSQ_SOURCE_LINE 00004222 ""
NSQ_SOURCE_LINE 00004223 "The hour from 1-24."
NSQ_SOURCE_LINE 00004224 ""
NSQ_SOURCE_LINE 00004225 "=item * j{1,2}"
NSQ_SOURCE_LINE 00004226 ""
NSQ_SOURCE_LINE 00004227 "The hour, in 12 or 24 hour form, based on the preferred form for the locale. In"
NSQ_SOURCE_LINE 00004228 "other words, this is equivalent to either \"h{1,2}\" or \"H{1,2}\"."
NSQ_SOURCE_LINE 00004229 ""
NSQ_SOURCE_LINE 00004230 "=item * m{1,2}"
NSQ_SOURCE_LINE 00004231 ""
NSQ_SOURCE_LINE 00004232 "The minute."
NSQ_SOURCE_LINE 00004233 ""
NSQ_SOURCE_LINE 00004234 "=item * s{1,2}"
NSQ_SOURCE_LINE 00004235 ""
NSQ_SOURCE_LINE 00004236 "The second."
NSQ_SOURCE_LINE 00004237 ""
NSQ_SOURCE_LINE 00004238 "=item * S{1,}"
NSQ_SOURCE_LINE 00004239 ""
NSQ_SOURCE_LINE 00004240 "The fractional portion of the seconds, rounded based on the length of the"
NSQ_SOURCE_LINE 00004241 "specifier. This returned I<without> a leading decimal point, but may have"
NSQ_SOURCE_LINE 00004242 "leading or trailing zeroes."
NSQ_SOURCE_LINE 00004243 ""
NSQ_SOURCE_LINE 00004244 "=item * A{1,}"
NSQ_SOURCE_LINE 00004245 ""
NSQ_SOURCE_LINE 00004246 "The millisecond of the day, based on the current time. In other words, if it is"
NSQ_SOURCE_LINE 00004247 "12:00:00.00, this returns 43200000."
NSQ_SOURCE_LINE 00004248 ""
NSQ_SOURCE_LINE 00004249 "=item * z{1,3}"
NSQ_SOURCE_LINE 00004250 ""
NSQ_SOURCE_LINE 00004251 "The time zone short name."
NSQ_SOURCE_LINE 00004252 ""
NSQ_SOURCE_LINE 00004253 "=item * zzzz"
NSQ_SOURCE_LINE 00004254 ""
NSQ_SOURCE_LINE 00004255 "The time zone long name."
NSQ_SOURCE_LINE 00004256 ""
NSQ_SOURCE_LINE 00004257 "=item * Z{1,3}"
NSQ_SOURCE_LINE 00004258 ""
NSQ_SOURCE_LINE 00004259 "The time zone offset."
NSQ_SOURCE_LINE 00004260 ""
NSQ_SOURCE_LINE 00004261 "=item * ZZZZ"
NSQ_SOURCE_LINE 00004262 ""
NSQ_SOURCE_LINE 00004263 "The time zone short name and the offset as one string, so something like"
NSQ_SOURCE_LINE 00004264 "\"CDT-0500\"."
NSQ_SOURCE_LINE 00004265 ""
NSQ_SOURCE_LINE 00004266 "=item * ZZZZZ"
NSQ_SOURCE_LINE 00004267 ""
NSQ_SOURCE_LINE 00004268 "The time zone offset as a sexagesimal number, so something like \"-05:00\". (This"
NSQ_SOURCE_LINE 00004269 "is useful for W3C format.)"
NSQ_SOURCE_LINE 00004270 ""
NSQ_SOURCE_LINE 00004271 "=item * v{1,3}"
NSQ_SOURCE_LINE 00004272 ""
NSQ_SOURCE_LINE 00004273 "The time zone short name."
NSQ_SOURCE_LINE 00004274 ""
NSQ_SOURCE_LINE 00004275 "=item * vvvv"
NSQ_SOURCE_LINE 00004276 ""
NSQ_SOURCE_LINE 00004277 "The time zone long name."
NSQ_SOURCE_LINE 00004278 ""
NSQ_SOURCE_LINE 00004279 "=item * V{1,3}"
NSQ_SOURCE_LINE 00004280 ""
NSQ_SOURCE_LINE 00004281 "The time zone short name."
NSQ_SOURCE_LINE 00004282 ""
NSQ_SOURCE_LINE 00004283 "=item * VVVV"
NSQ_SOURCE_LINE 00004284 ""
NSQ_SOURCE_LINE 00004285 "The time zone long name."
NSQ_SOURCE_LINE 00004286 ""
NSQ_SOURCE_LINE 00004287 "=back"
NSQ_SOURCE_LINE 00004288 ""
NSQ_SOURCE_LINE 00004289 "=head3 CLDR \"Available Formats\""
NSQ_SOURCE_LINE 00004290 ""
NSQ_SOURCE_LINE 00004291 "The CLDR data includes pre-defined formats for various patterns such as \"month"
NSQ_SOURCE_LINE 00004292 "and day\" or \"time of day\". Using these formats lets you render information"
NSQ_SOURCE_LINE 00004293 "about a datetime in the most natural way for users from a given locale."
NSQ_SOURCE_LINE 00004294 ""
NSQ_SOURCE_LINE 00004295 "These formats are indexed by a key that is itself a CLDR pattern. When you look"
NSQ_SOURCE_LINE 00004296 "these up, you get back a different CLDR pattern suitable for the locale."
NSQ_SOURCE_LINE 00004297 ""
NSQ_SOURCE_LINE 00004298 "Let's look at some example We'll use C<2008-02-05T18:30:30> as our example"
NSQ_SOURCE_LINE 00004299 "datetime value, and see how this is rendered for the C<\"en-US\"> and C<\"fr-FR\">"
NSQ_SOURCE_LINE 00004300 "locales."
NSQ_SOURCE_LINE 00004301 ""
NSQ_SOURCE_LINE 00004302 "=over 4"
NSQ_SOURCE_LINE 00004303 ""
NSQ_SOURCE_LINE 00004304 "=item * C<MMMd>"
NSQ_SOURCE_LINE 00004305 ""
NSQ_SOURCE_LINE 00004306 "The abbreviated month and day as number. For C<en-US>, we get the pattern C<MMM"
NSQ_SOURCE_LINE 00004307 "d>, which renders as C<Feb 5>. For C<fr-FR>, we get the pattern C<d MMM>, which"
NSQ_SOURCE_LINE 00004308 "renders as C<5 févr.>."
NSQ_SOURCE_LINE 00004309 ""
NSQ_SOURCE_LINE 00004310 "=item * C<yQQQ>"
NSQ_SOURCE_LINE 00004311 ""
NSQ_SOURCE_LINE 00004312 "The year and abbreviated quarter of year. For C<en-US>, we get the pattern"
NSQ_SOURCE_LINE 00004313 "C<QQQ y>, which renders as C<Q1 2008>. For C<fr-FR>, we get the same pattern,"
NSQ_SOURCE_LINE 00004314 "C<QQQ y>, which renders as C<T1 2008>."
NSQ_SOURCE_LINE 00004315 ""
NSQ_SOURCE_LINE 00004316 "=item * C<hm>"
NSQ_SOURCE_LINE 00004317 ""
NSQ_SOURCE_LINE 00004318 "The 12-hour time of day without seconds. For C<en-US>, we get the pattern"
NSQ_SOURCE_LINE 00004319 "C<h:mm a>, which renders as C<6:30 PM>. For C<fr-FR>, we get the exact same"
NSQ_SOURCE_LINE 00004320 "pattern and rendering."
NSQ_SOURCE_LINE 00004321 ""
NSQ_SOURCE_LINE 00004322 "=back"
NSQ_SOURCE_LINE 00004323 ""
NSQ_SOURCE_LINE 00004324 "The available formats for each locale are documented in the POD for that"
NSQ_SOURCE_LINE 00004325 "locale. To get back the format, you use the C<< $locale->format_for >> method."
NSQ_SOURCE_LINE 00004326 "For example:"
NSQ_SOURCE_LINE 00004327 ""
NSQ_SOURCE_LINE 00004328 "    say $dt->format_cldr( $dt->locale->format_for('MMMd') );"
NSQ_SOURCE_LINE 00004329 ""
NSQ_SOURCE_LINE 00004330 "=head2 strftime Patterns"
NSQ_SOURCE_LINE 00004331 ""
NSQ_SOURCE_LINE 00004332 "The following patterns are allowed in the format string given to the C<<"
NSQ_SOURCE_LINE 00004333 "$dt->strftime >> method:"
NSQ_SOURCE_LINE 00004334 ""
NSQ_SOURCE_LINE 00004335 "=over 4"
NSQ_SOURCE_LINE 00004336 ""
NSQ_SOURCE_LINE 00004337 "=item * %a"
NSQ_SOURCE_LINE 00004338 ""
NSQ_SOURCE_LINE 00004339 "The abbreviated weekday name."
NSQ_SOURCE_LINE 00004340 ""
NSQ_SOURCE_LINE 00004341 "=item * %A"
NSQ_SOURCE_LINE 00004342 ""
NSQ_SOURCE_LINE 00004343 "The full weekday name."
NSQ_SOURCE_LINE 00004344 ""
NSQ_SOURCE_LINE 00004345 "=item * %b"
NSQ_SOURCE_LINE 00004346 ""
NSQ_SOURCE_LINE 00004347 "The abbreviated month name."
NSQ_SOURCE_LINE 00004348 ""
NSQ_SOURCE_LINE 00004349 "=item * %B"
NSQ_SOURCE_LINE 00004350 ""
NSQ_SOURCE_LINE 00004351 "The full month name."
NSQ_SOURCE_LINE 00004352 ""
NSQ_SOURCE_LINE 00004353 "=item * %c"
NSQ_SOURCE_LINE 00004354 ""
NSQ_SOURCE_LINE 00004355 "The default datetime format for the object's locale."
NSQ_SOURCE_LINE 00004356 ""
NSQ_SOURCE_LINE 00004357 "=item * %C"
NSQ_SOURCE_LINE 00004358 ""
NSQ_SOURCE_LINE 00004359 "The century number (year/100) as a 2-digit integer."
NSQ_SOURCE_LINE 00004360 ""
NSQ_SOURCE_LINE 00004361 "=item * %d"
NSQ_SOURCE_LINE 00004362 ""
NSQ_SOURCE_LINE 00004363 "The day of the month as a decimal number (range 01 to 31)."
NSQ_SOURCE_LINE 00004364 ""
NSQ_SOURCE_LINE 00004365 "=item * %D"
NSQ_SOURCE_LINE 00004366 ""
NSQ_SOURCE_LINE 00004367 "Equivalent to %m/%d/%y. This is not a good standard format if you want folks"
NSQ_SOURCE_LINE 00004368 "from both the United States and the rest of the world to understand the date!"
NSQ_SOURCE_LINE 00004369 ""
NSQ_SOURCE_LINE 00004370 "=item * %e"
NSQ_SOURCE_LINE 00004371 ""
NSQ_SOURCE_LINE 00004372 "Like %d, the day of the month as a decimal number, but a leading zero is"
NSQ_SOURCE_LINE 00004373 "replaced by a space."
NSQ_SOURCE_LINE 00004374 ""
NSQ_SOURCE_LINE 00004375 "=item * %F"
NSQ_SOURCE_LINE 00004376 ""
NSQ_SOURCE_LINE 00004377 "Equivalent to %Y-%m-%d (the ISO 8601 date format)"
NSQ_SOURCE_LINE 00004378 ""
NSQ_SOURCE_LINE 00004379 "=item * %G"
NSQ_SOURCE_LINE 00004380 ""
NSQ_SOURCE_LINE 00004381 "The ISO 8601 year with century as a decimal number. The 4-digit year"
NSQ_SOURCE_LINE 00004382 "corresponding to the ISO week number (see %V). This has the same format and"
NSQ_SOURCE_LINE 00004383 "value as %Y, except that if the ISO week number belongs to the previous or next"
NSQ_SOURCE_LINE 00004384 "year, that year is used instead. (TZ)"
NSQ_SOURCE_LINE 00004385 ""
NSQ_SOURCE_LINE 00004386 "=item * %g"
NSQ_SOURCE_LINE 00004387 ""
NSQ_SOURCE_LINE 00004388 "Like %G, but without century, i.e., with a 2-digit year (00-99)."
NSQ_SOURCE_LINE 00004389 ""
NSQ_SOURCE_LINE 00004390 "=item * %h"
NSQ_SOURCE_LINE 00004391 ""
NSQ_SOURCE_LINE 00004392 "Equivalent to %b."
NSQ_SOURCE_LINE 00004393 ""
NSQ_SOURCE_LINE 00004394 "=item * %H"
NSQ_SOURCE_LINE 00004395 ""
NSQ_SOURCE_LINE 00004396 "The hour as a decimal number using a 24-hour clock (range 00 to 23)."
NSQ_SOURCE_LINE 00004397 ""
NSQ_SOURCE_LINE 00004398 "=item * %I"
NSQ_SOURCE_LINE 00004399 ""
NSQ_SOURCE_LINE 00004400 "The hour as a decimal number using a 12-hour clock (range 01 to 12)."
NSQ_SOURCE_LINE 00004401 ""
NSQ_SOURCE_LINE 00004402 "=item * %j"
NSQ_SOURCE_LINE 00004403 ""
NSQ_SOURCE_LINE 00004404 "The day of the year as a decimal number (range 001 to 366)."
NSQ_SOURCE_LINE 00004405 ""
NSQ_SOURCE_LINE 00004406 "=item * %k"
NSQ_SOURCE_LINE 00004407 ""
NSQ_SOURCE_LINE 00004408 "The hour (24-hour clock) as a decimal number (range 0 to 23); single digits are"
NSQ_SOURCE_LINE 00004409 "preceded by a blank. (See also %H.)"
NSQ_SOURCE_LINE 00004410 ""
NSQ_SOURCE_LINE 00004411 "=item * %l"
NSQ_SOURCE_LINE 00004412 ""
NSQ_SOURCE_LINE 00004413 "The hour (12-hour clock) as a decimal number (range 1 to 12); single digits are"
NSQ_SOURCE_LINE 00004414 "preceded by a blank. (See also %I.)"
NSQ_SOURCE_LINE 00004415 ""
NSQ_SOURCE_LINE 00004416 "=item * %m"
NSQ_SOURCE_LINE 00004417 ""
NSQ_SOURCE_LINE 00004418 "The month as a decimal number (range 01 to 12)."
NSQ_SOURCE_LINE 00004419 ""
NSQ_SOURCE_LINE 00004420 "=item * %M"
NSQ_SOURCE_LINE 00004421 ""
NSQ_SOURCE_LINE 00004422 "The minute as a decimal number (range 00 to 59)."
NSQ_SOURCE_LINE 00004423 ""
NSQ_SOURCE_LINE 00004424 "=item * %n"
NSQ_SOURCE_LINE 00004425 ""
NSQ_SOURCE_LINE 00004426 "A newline character."
NSQ_SOURCE_LINE 00004427 ""
NSQ_SOURCE_LINE 00004428 "=item * %N"
NSQ_SOURCE_LINE 00004429 ""
NSQ_SOURCE_LINE 00004430 "The fractional seconds digits. Default is 9 digits (nanoseconds)."
NSQ_SOURCE_LINE 00004431 ""
NSQ_SOURCE_LINE 00004432 "    %3N   milliseconds (3 digits)"
NSQ_SOURCE_LINE 00004433 "    %6N   microseconds (6 digits)"
NSQ_SOURCE_LINE 00004434 "    %9N   nanoseconds  (9 digits)"
NSQ_SOURCE_LINE 00004435 ""
NSQ_SOURCE_LINE 00004436 "This value will always be rounded down to the nearest integer."
NSQ_SOURCE_LINE 00004437 ""
NSQ_SOURCE_LINE 00004438 "=item * %p"
NSQ_SOURCE_LINE 00004439 ""
NSQ_SOURCE_LINE 00004440 "Either `AM' or `PM' according to the given time value, or the corresponding"
NSQ_SOURCE_LINE 00004441 "strings for the current locale. Noon is treated as `pm' and midnight as `am'."
NSQ_SOURCE_LINE 00004442 ""
NSQ_SOURCE_LINE 00004443 "=item * %P"
NSQ_SOURCE_LINE 00004444 ""
NSQ_SOURCE_LINE 00004445 "Like %p but in lowercase: `am' or `pm' or a corresponding string for the"
NSQ_SOURCE_LINE 00004446 "current locale."
NSQ_SOURCE_LINE 00004447 ""
NSQ_SOURCE_LINE 00004448 "=item * %r"
NSQ_SOURCE_LINE 00004449 ""
NSQ_SOURCE_LINE 00004450 "The time in a.m. or p.m. notation. In the POSIX locale this is equivalent to"
NSQ_SOURCE_LINE 00004451 "`%I:%M:%S %p'."
NSQ_SOURCE_LINE 00004452 ""
NSQ_SOURCE_LINE 00004453 "=item * %R"
NSQ_SOURCE_LINE 00004454 ""
NSQ_SOURCE_LINE 00004455 "The time in 24-hour notation (%H:%M). (SU) For a version including the seconds,"
NSQ_SOURCE_LINE 00004456 "see %T below."
NSQ_SOURCE_LINE 00004457 ""
NSQ_SOURCE_LINE 00004458 "=item * %s"
NSQ_SOURCE_LINE 00004459 ""
NSQ_SOURCE_LINE 00004460 "The number of seconds since the epoch."
NSQ_SOURCE_LINE 00004461 ""
NSQ_SOURCE_LINE 00004462 "=item * %S"
NSQ_SOURCE_LINE 00004463 ""
NSQ_SOURCE_LINE 00004464 "The second as a decimal number (range 00 to 61)."
NSQ_SOURCE_LINE 00004465 ""
NSQ_SOURCE_LINE 00004466 "=item * %t"
NSQ_SOURCE_LINE 00004467 ""
NSQ_SOURCE_LINE 00004468 "A tab character."
NSQ_SOURCE_LINE 00004469 ""
NSQ_SOURCE_LINE 00004470 "=item * %T"
NSQ_SOURCE_LINE 00004471 ""
NSQ_SOURCE_LINE 00004472 "The time in 24-hour notation (%H:%M:%S)."
NSQ_SOURCE_LINE 00004473 ""
NSQ_SOURCE_LINE 00004474 "=item * %u"
NSQ_SOURCE_LINE 00004475 ""
NSQ_SOURCE_LINE 00004476 "The day of the week as a decimal, range 1 to 7, Monday being 1. See also %w."
NSQ_SOURCE_LINE 00004477 ""
NSQ_SOURCE_LINE 00004478 "=item * %U"
NSQ_SOURCE_LINE 00004479 ""
NSQ_SOURCE_LINE 00004480 "The week number of the current year as a decimal number, range 00 to 53,"
NSQ_SOURCE_LINE 00004481 "starting with the first Sunday as the first day of week 01. See also %V and %W."
NSQ_SOURCE_LINE 00004482 ""
NSQ_SOURCE_LINE 00004483 "=item * %V"
NSQ_SOURCE_LINE 00004484 ""
NSQ_SOURCE_LINE 00004485 "The ISO 8601:1988 week number of the current year as a decimal number, range 01"
NSQ_SOURCE_LINE 00004486 "to 53, where week 1 is the first week that has at least 4 days in the current"
NSQ_SOURCE_LINE 00004487 "year, and with Monday as the first day of the week. See also %U and %W."
NSQ_SOURCE_LINE 00004488 ""
NSQ_SOURCE_LINE 00004489 "=item * %w"
NSQ_SOURCE_LINE 00004490 ""
NSQ_SOURCE_LINE 00004491 "The day of the week as a decimal, range 0 to 6, Sunday being 0. See also %u."
NSQ_SOURCE_LINE 00004492 ""
NSQ_SOURCE_LINE 00004493 "=item * %W"
NSQ_SOURCE_LINE 00004494 ""
NSQ_SOURCE_LINE 00004495 "The week number of the current year as a decimal number, range 00 to 53,"
NSQ_SOURCE_LINE 00004496 "starting with the first Monday as the first day of week 01."
NSQ_SOURCE_LINE 00004497 ""
NSQ_SOURCE_LINE 00004498 "=item * %x"
NSQ_SOURCE_LINE 00004499 ""
NSQ_SOURCE_LINE 00004500 "The default date format for the object's locale."
NSQ_SOURCE_LINE 00004501 ""
NSQ_SOURCE_LINE 00004502 "=item * %X"
NSQ_SOURCE_LINE 00004503 ""
NSQ_SOURCE_LINE 00004504 "The default time format for the object's locale."
NSQ_SOURCE_LINE 00004505 ""
NSQ_SOURCE_LINE 00004506 "=item * %y"
NSQ_SOURCE_LINE 00004507 ""
NSQ_SOURCE_LINE 00004508 "The year as a decimal number without a century (range 00 to 99)."
NSQ_SOURCE_LINE 00004509 ""
NSQ_SOURCE_LINE 00004510 "=item * %Y"
NSQ_SOURCE_LINE 00004511 ""
NSQ_SOURCE_LINE 00004512 "The year as a decimal number including the century."
NSQ_SOURCE_LINE 00004513 ""
NSQ_SOURCE_LINE 00004514 "=item * %z"
NSQ_SOURCE_LINE 00004515 ""
NSQ_SOURCE_LINE 00004516 "The time-zone as hour offset from UTC. Required to emit RFC822-conformant dates"
NSQ_SOURCE_LINE 00004517 "(using \"%a, %d %b %Y %H:%M:%S %z\")."
NSQ_SOURCE_LINE 00004518 ""
NSQ_SOURCE_LINE 00004519 "=item * %Z"
NSQ_SOURCE_LINE 00004520 ""
NSQ_SOURCE_LINE 00004521 "The short name for the time zone, typically an abbreviation like \"EST\" or"
NSQ_SOURCE_LINE 00004522 "\"AEST\"."
NSQ_SOURCE_LINE 00004523 ""
NSQ_SOURCE_LINE 00004524 "=item * %%"
NSQ_SOURCE_LINE 00004525 ""
NSQ_SOURCE_LINE 00004526 "A literal `%' character."
NSQ_SOURCE_LINE 00004527 ""
NSQ_SOURCE_LINE 00004528 "=item * %{method}"
NSQ_SOURCE_LINE 00004529 ""
NSQ_SOURCE_LINE 00004530 "Any method name may be specified using the format C<%{method}> name where"
NSQ_SOURCE_LINE 00004531 "\"method\" is a valid C<DateTime> object method."
NSQ_SOURCE_LINE 00004532 ""
NSQ_SOURCE_LINE 00004533 "=back"
NSQ_SOURCE_LINE 00004534 ""
NSQ_SOURCE_LINE 00004535 "=head2 DateTime and Storable"
NSQ_SOURCE_LINE 00004536 ""
NSQ_SOURCE_LINE 00004537 "C<DateTime> implements L<Storable> hooks in order to reduce the size of a"
NSQ_SOURCE_LINE 00004538 "serialized C<DateTime> object."
NSQ_SOURCE_LINE 00004539 ""
NSQ_SOURCE_LINE 00004540 "=head1 DEVELOPMENT TOOLS"
NSQ_SOURCE_LINE 00004541 ""
NSQ_SOURCE_LINE 00004542 "If you're working on the C<DateTIme> code base, there are a few extra non-Perl"
NSQ_SOURCE_LINE 00004543 "tools that you may find useful, notably"
NSQ_SOURCE_LINE 00004544 "L<precious|https://github.com/houseabsolute/precious>, a meta-linter/tidier."
NSQ_SOURCE_LINE 00004545 "You can install all the necessary tools in C<$HOME/bin> by running"
NSQ_SOURCE_LINE 00004546 "F<./dev-bin/install-dev-tools.sh>."
NSQ_SOURCE_LINE 00004547 ""
NSQ_SOURCE_LINE 00004548 "Try running C<precious tidy -a> to tidy all the tidyable files in the repo, and"
NSQ_SOURCE_LINE 00004549 "C<precious lint -a> to run all the lint checks."
NSQ_SOURCE_LINE 00004550 ""
NSQ_SOURCE_LINE 00004551 "You can enable a git pre-commit hook for linting by running F<./git/setup.pl>."
NSQ_SOURCE_LINE 00004552 ""
NSQ_SOURCE_LINE 00004553 "Note that linting will be checked in CI, and it's okay to submit a PR which"
NSQ_SOURCE_LINE 00004554 "fails the linting check, but it's extra nice to fix these yourself."
NSQ_SOURCE_LINE 00004555 ""
NSQ_SOURCE_LINE 00004556 "=head1 THE DATETIME PROJECT ECOSYSTEM"
NSQ_SOURCE_LINE 00004557 ""
NSQ_SOURCE_LINE 00004558 "This module is part of a larger ecosystem of modules in the DateTime family."
NSQ_SOURCE_LINE 00004559 ""
NSQ_SOURCE_LINE 00004560 "=head2 L<DateTime::Set>"
NSQ_SOURCE_LINE 00004561 ""
NSQ_SOURCE_LINE 00004562 "The L<DateTime::Set> module represents sets (including recurrences) of"
NSQ_SOURCE_LINE 00004563 "datetimes. Many modules return sets or recurrences."
NSQ_SOURCE_LINE 00004564 ""
NSQ_SOURCE_LINE 00004565 "=head2 Format Modules"
NSQ_SOURCE_LINE 00004566 ""
NSQ_SOURCE_LINE 00004567 "The various format modules exist to parse and format datetimes. For example,"
NSQ_SOURCE_LINE 00004568 "L<DateTime::Format::HTTP> parses dates according to the RFC 1123 format:"
NSQ_SOURCE_LINE 00004569 ""
NSQ_SOURCE_LINE 00004570 "    my $datetime"
NSQ_SOURCE_LINE 00004571 "        = DateTime::Format::HTTP->parse_datetime("
NSQ_SOURCE_LINE 00004572 "        'Thu Feb  3 17:03:55 GMT 1994');"
NSQ_SOURCE_LINE 00004573 ""
NSQ_SOURCE_LINE 00004574 "    print DateTime::Format::HTTP->format_datetime($datetime);"
NSQ_SOURCE_LINE 00004575 ""
NSQ_SOURCE_LINE 00004576 "Most format modules are suitable for use as a C<formatter> with a DateTime"
NSQ_SOURCE_LINE 00004577 "object."
NSQ_SOURCE_LINE 00004578 ""
NSQ_SOURCE_LINE 00004579 "All format modules start with"
NSQ_SOURCE_LINE 00004580 "L<DateTime::Format::|https://metacpan.org/search?q=datetime%3A%3Aformat>."
NSQ_SOURCE_LINE 00004581 ""
NSQ_SOURCE_LINE 00004582 "=head2 Calendar Modules"
NSQ_SOURCE_LINE 00004583 ""
NSQ_SOURCE_LINE 00004584 "There are a number of modules on CPAN that implement non-Gregorian calendars,"
NSQ_SOURCE_LINE 00004585 "such as the Chinese, Mayan, and Julian calendars."
NSQ_SOURCE_LINE 00004586 ""
NSQ_SOURCE_LINE 00004587 "All calendar modules start with"
NSQ_SOURCE_LINE 00004588 "L<DateTime::Calendar::|https://metacpan.org/search?q=datetime%3A%3Acalendar>."
NSQ_SOURCE_LINE 00004589 ""
NSQ_SOURCE_LINE 00004590 "=head2 Event Modules"
NSQ_SOURCE_LINE 00004591 ""
NSQ_SOURCE_LINE 00004592 "There are a number of modules that calculate the dates for events, such as"
NSQ_SOURCE_LINE 00004593 "Easter, Sunrise, etc."
NSQ_SOURCE_LINE 00004594 ""
NSQ_SOURCE_LINE 00004595 "All event modules start with"
NSQ_SOURCE_LINE 00004596 "L<DateTime::Event::|https://metacpan.org/search?q=datetime%3A%3Aevent>."
NSQ_SOURCE_LINE 00004597 ""
NSQ_SOURCE_LINE 00004598 "=head2 Others"
NSQ_SOURCE_LINE 00004599 ""
NSQ_SOURCE_LINE 00004600 "There are many other modules that work with DateTime, including modules in the"
NSQ_SOURCE_LINE 00004601 "L<DateTimeX namespace|https://metacpan.org/search?q=datetimex> namespace, as"
NSQ_SOURCE_LINE 00004602 "well as others."
NSQ_SOURCE_LINE 00004603 ""
NSQ_SOURCE_LINE 00004604 "See L<MetaCPAN|https://metacpan.org/search?q=datetime> for more modules."
NSQ_SOURCE_LINE 00004605 ""
NSQ_SOURCE_LINE 00004606 "=head1 KNOWN BUGS"
NSQ_SOURCE_LINE 00004607 ""
NSQ_SOURCE_LINE 00004608 "The tests in F<20infinite.t> seem to fail on some machines, particularly on"
NSQ_SOURCE_LINE 00004609 "Win32. This appears to be related to Perl's internal handling of IEEE infinity"
NSQ_SOURCE_LINE 00004610 "and NaN, and seems to be highly platform/compiler/phase of moon dependent."
NSQ_SOURCE_LINE 00004611 ""
NSQ_SOURCE_LINE 00004612 "If you don't plan to use infinite datetimes you can probably ignore this. This"
NSQ_SOURCE_LINE 00004613 "will be fixed (perhaps) in future versions."
NSQ_SOURCE_LINE 00004614 ""
NSQ_SOURCE_LINE 00004615 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00004616 ""
NSQ_SOURCE_LINE 00004617 "L<A Date with Perl|http://presentations.houseabsolute.com/a-date-with-perl/> -"
NSQ_SOURCE_LINE 00004618 "a talk I've given at a few YAPCs."
NSQ_SOURCE_LINE 00004619 ""
NSQ_SOURCE_LINE 00004620 "L<datetime@perl.org mailing list|http://lists.perl.org/list/datetime.html>"
NSQ_SOURCE_LINE 00004621 ""
NSQ_SOURCE_LINE 00004622 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00004623 ""
NSQ_SOURCE_LINE 00004624 "Bugs may be submitted at L<https://github.com/houseabsolute/DateTime.pm/issues>."
NSQ_SOURCE_LINE 00004625 ""
NSQ_SOURCE_LINE 00004626 "There is a mailing list available for users of this distribution,"
NSQ_SOURCE_LINE 00004627 "L<mailto:datetime@perl.org>."
NSQ_SOURCE_LINE 00004628 ""
NSQ_SOURCE_LINE 00004629 "=head1 SOURCE"
NSQ_SOURCE_LINE 00004630 ""
NSQ_SOURCE_LINE 00004631 "The source code repository for DateTime can be found at L<https://github.com/houseabsolute/DateTime.pm>."
NSQ_SOURCE_LINE 00004632 ""
NSQ_SOURCE_LINE 00004633 "=head1 DONATIONS"
NSQ_SOURCE_LINE 00004634 ""
NSQ_SOURCE_LINE 00004635 "If you'd like to thank me for the work I've done on this module, please"
NSQ_SOURCE_LINE 00004636 "consider making a \"donation\" to me via PayPal. I spend a lot of free time"
NSQ_SOURCE_LINE 00004637 "creating free software, and would appreciate any support you'd care to offer."
NSQ_SOURCE_LINE 00004638 ""
NSQ_SOURCE_LINE 00004639 "Please note that B<I am not suggesting that you must do this> in order for me"
NSQ_SOURCE_LINE 00004640 "to continue working on this particular software. I will continue to do so,"
NSQ_SOURCE_LINE 00004641 "inasmuch as I have in the past, for as long as it interests me."
NSQ_SOURCE_LINE 00004642 ""
NSQ_SOURCE_LINE 00004643 "Similarly, a donation made in this way will probably not make me work on this"
NSQ_SOURCE_LINE 00004644 "software much more, unless I get so many donations that I can consider working"
NSQ_SOURCE_LINE 00004645 "on free software full time (let's all have a chuckle at that together)."
NSQ_SOURCE_LINE 00004646 ""
NSQ_SOURCE_LINE 00004647 "To donate, log into PayPal and send money to autarch@urth.org, or use the"
NSQ_SOURCE_LINE 00004648 "button at L<https://houseabsolute.com/foss-donations/>."
NSQ_SOURCE_LINE 00004649 ""
