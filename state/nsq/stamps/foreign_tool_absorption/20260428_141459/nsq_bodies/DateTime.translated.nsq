NSQ_SOURCE_LINE 00001448 ""
NSQ_SOURCE_LINE 00001449 "sub epoch {"
NSQ_SOURCE_LINE 00001450 "    my $self = shift;"
NSQ_SOURCE_LINE 00001451 ""
NSQ_SOURCE_LINE 00001452 "    return $self->{utc_c}{epoch}"
