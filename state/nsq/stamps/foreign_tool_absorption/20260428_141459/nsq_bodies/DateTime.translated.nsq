NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    @LeapYearMonthLengths = @MonthLengths;"
NSQ_SOURCE_LINE 00000101 "    $LeapYearMonthLengths[1]++;"
NSQ_SOURCE_LINE 00000102 ""
