NSQ_SOURCE_LINE 00000414 "sub _calc_local_rd {"
NSQ_SOURCE_LINE 00000415 "    my $self = shift;"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "    delete $self->{local_c};"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "    # We must short circuit for UTC times or else we could end up with"
NSQ_SOURCE_LINE 00000420 "    # loops between DateTime.pm and DateTime::TimeZone"
NSQ_SOURCE_LINE 00000421 "    if ( $self->{tz}->is_utc || $self->{tz}->is_floating ) {"
NSQ_SOURCE_LINE 00000422 "        $self->{local_rd_days} = $self->{utc_rd_days};"
NSQ_SOURCE_LINE 00000423 "        $self->{local_rd_secs} = $self->{utc_rd_secs};"
NSQ_SOURCE_LINE 00000424 "    }"
NSQ_SOURCE_LINE 00000425 "    else {"
NSQ_SOURCE_LINE 00000426 "        my $offset = $self->offset;"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "        $self->{local_rd_days} = $self->{utc_rd_days};"
NSQ_SOURCE_LINE 00000429 "        $self->{local_rd_secs} = $self->{utc_rd_secs} + $offset;"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "        # intentionally ignore leap seconds here"
NSQ_SOURCE_LINE 00000432 "        $self->_normalize_tai_seconds("
NSQ_SOURCE_LINE 00000433 "            $self->{local_rd_days},"
NSQ_SOURCE_LINE 00000434 "            $self->{local_rd_secs}"
NSQ_SOURCE_LINE 00000435 "        );"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "        $self->{local_rd_secs} += $self->{offset_modifier};"
NSQ_SOURCE_LINE 00000438 "    }"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "    $self->_calc_local_components;"
