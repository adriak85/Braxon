NSQ_SOURCE_LINE 00000735 "    sub from_day_of_year {"
NSQ_SOURCE_LINE 00000736 "        my $class = shift;"
NSQ_SOURCE_LINE 00000737 "        my %p     = $validator->(@_);"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "        Carp::croak(\"$p{year} is not a leap year.\\n\")"
NSQ_SOURCE_LINE 00000740 "            if $p{day_of_year} == 366 && !$class->_is_leap_year( $p{year} );"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "        my $month = 1;"
NSQ_SOURCE_LINE 00000743 "        my $day   = delete $p{day_of_year};"
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "        if ( $day > 31 ) {"
NSQ_SOURCE_LINE 00000746 "            my $length = $class->_month_length( $p{year}, $month );"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "            while ( $day > $length ) {"
NSQ_SOURCE_LINE 00000749 "                $day -= $length;"
NSQ_SOURCE_LINE 00000750 "                $month++;"
NSQ_SOURCE_LINE 00000751 "                $length = $class->_month_length( $p{year}, $month );"
NSQ_SOURCE_LINE 00000752 "            }"
NSQ_SOURCE_LINE 00000753 "        }"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "        return $class->_new("
NSQ_SOURCE_LINE 00000756 "            %p,"
NSQ_SOURCE_LINE 00000757 "            month => $month,"
NSQ_SOURCE_LINE 00000758 "            day   => $day,"
NSQ_SOURCE_LINE 00000759 "        );"
NSQ_SOURCE_LINE 00000760 "    }"
NSQ_SOURCE_LINE 00000761 "}"
