NSQ_SOURCE_LINE 00002085 "                optional => 1,"
NSQ_SOURCE_LINE 00002086 "            },"
NSQ_SOURCE_LINE 00002087 "            nanosecond => {"
NSQ_SOURCE_LINE 00002088 "                type     => t('Nanosecond'),"
NSQ_SOURCE_LINE 00002089 "                optional => 1,"
NSQ_SOURCE_LINE 00002090 "            },"
NSQ_SOURCE_LINE 00002091 "            locale => {"
NSQ_SOURCE_LINE 00002092 "                type     => t('Locale'),"
NSQ_SOURCE_LINE 00002093 "                optional => 1,"
NSQ_SOURCE_LINE 00002094 "            },"
NSQ_SOURCE_LINE 00002095 "        },"
NSQ_SOURCE_LINE 00002096 "    );"
NSQ_SOURCE_LINE 00002097 ""
NSQ_SOURCE_LINE 00002098 "    ## no critic (NamingConventions::ProhibitAmbiguousNames)"
NSQ_SOURCE_LINE 00002099 "    sub set {"
NSQ_SOURCE_LINE 00002100 "        my $self = shift;"
NSQ_SOURCE_LINE 00002101 "        my %p    = $validator->(@_);"
NSQ_SOURCE_LINE 00002102 ""
NSQ_SOURCE_LINE 00002103 "        if ( $p{locale} ) {"
NSQ_SOURCE_LINE 00002104 "            carp 'You passed a locale to the set() method.'"
NSQ_SOURCE_LINE 00002105 "                . ' You should use set_locale() instead, as using set() may alter the local time near a DST boundary.';"
NSQ_SOURCE_LINE 00002106 "        }"
NSQ_SOURCE_LINE 00002107 ""
NSQ_SOURCE_LINE 00002108 "        my $new_dt = $self->_new_from_self(%p);"
NSQ_SOURCE_LINE 00002109 ""
NSQ_SOURCE_LINE 00002110 "        %$self = %$new_dt;"
NSQ_SOURCE_LINE 00002111 ""
NSQ_SOURCE_LINE 00002112 "        return $self;"
NSQ_SOURCE_LINE 00002113 "    }"
NSQ_SOURCE_LINE 00002114 "}"
NSQ_SOURCE_LINE 00002115 ""
NSQ_SOURCE_LINE 00002116 "sub set_year       { $_[0]->set( year       => $_[1] ) }"
NSQ_SOURCE_LINE 00002117 "sub set_month      { $_[0]->set( month      => $_[1] ) }"
NSQ_SOURCE_LINE 00002118 "sub set_day        { $_[0]->set( day        => $_[1] ) }"
NSQ_SOURCE_LINE 00002119 "sub set_hour       { $_[0]->set( hour       => $_[1] ) }"
NSQ_SOURCE_LINE 00002120 "sub set_minute     { $_[0]->set( minute     => $_[1] ) }"
NSQ_SOURCE_LINE 00002121 "sub set_second     { $_[0]->set( second     => $_[1] ) }"
NSQ_SOURCE_LINE 00002122 "sub set_nanosecond { $_[0]->set( nanosecond => $_[1] ) }"
NSQ_SOURCE_LINE 00002123 ""
NSQ_SOURCE_LINE 00002124 "# These two are special cased because ... if the local time is the hour of a"
NSQ_SOURCE_LINE 00002125 "# DST change where the same local time occurs twice then passing it through"
NSQ_SOURCE_LINE 00002126 "# _new() can actually change the underlying UTC time, which is bad."
NSQ_SOURCE_LINE 00002127 ""
NSQ_SOURCE_LINE 00002128 "{"
NSQ_SOURCE_LINE 00002129 "    my $validator = validation_for("
NSQ_SOURCE_LINE 00002130 "        name             => '_check_set_locale_params',"
NSQ_SOURCE_LINE 00002131 "        name_is_optional => 1,"
NSQ_SOURCE_LINE 00002132 "        params           => ["
NSQ_SOURCE_LINE 00002133 "            { type => t( 'Maybe', of => t('Locale') ) },"
NSQ_SOURCE_LINE 00002134 "        ],"
NSQ_SOURCE_LINE 00002135 "    );"
NSQ_SOURCE_LINE 00002136 ""
NSQ_SOURCE_LINE 00002137 "    sub set_locale {"
NSQ_SOURCE_LINE 00002138 "        my $self = shift;"
NSQ_SOURCE_LINE 00002139 "        my ($locale) = $validator->(@_);"
NSQ_SOURCE_LINE 00002140 ""
NSQ_SOURCE_LINE 00002141 "        $self->_set_locale($locale);"
NSQ_SOURCE_LINE 00002142 ""
NSQ_SOURCE_LINE 00002143 "        return $self;"
NSQ_SOURCE_LINE 00002144 "    }"
NSQ_SOURCE_LINE 00002145 "}"
NSQ_SOURCE_LINE 00002146 ""
NSQ_SOURCE_LINE 00002147 "{"
NSQ_SOURCE_LINE 00002148 "    my $validator = validation_for("
NSQ_SOURCE_LINE 00002149 "        name             => '_check_set_formatter_params',"
NSQ_SOURCE_LINE 00002150 "        name_is_optional => 1,"
NSQ_SOURCE_LINE 00002151 "        params           => ["
NSQ_SOURCE_LINE 00002152 "            { type => t( 'Maybe', of => t('Formatter') ) },"
NSQ_SOURCE_LINE 00002153 "        ],"
NSQ_SOURCE_LINE 00002154 "    );"
NSQ_SOURCE_LINE 00002155 ""
NSQ_SOURCE_LINE 00002156 "    sub set_formatter {"
NSQ_SOURCE_LINE 00002157 "        my $self = shift;"
NSQ_SOURCE_LINE 00002158 "        my ($formatter) = $validator->(@_);"
NSQ_SOURCE_LINE 00002159 ""
NSQ_SOURCE_LINE 00002160 "        $self->{formatter} = $formatter;"
NSQ_SOURCE_LINE 00002161 ""
