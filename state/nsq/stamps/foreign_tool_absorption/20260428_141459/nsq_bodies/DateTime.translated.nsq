NSQ_SOURCE_LINE 00000275 "    }"
NSQ_SOURCE_LINE 00000276 "    else {"
NSQ_SOURCE_LINE 00000277 "        $self->{locale}"
NSQ_SOURCE_LINE 00000278 "            = $locale"
NSQ_SOURCE_LINE 00000279 "            ? DateTime::Locale->load($locale)"
NSQ_SOURCE_LINE 00000280 "            : $self->DefaultLocale;"
NSQ_SOURCE_LINE 00000281 "    }"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "    return;"
NSQ_SOURCE_LINE 00000284 "}"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "# This method exists for the benefit of internal methods which create"
NSQ_SOURCE_LINE 00000287 "# a new object based on the current object, like set() and truncate()."
NSQ_SOURCE_LINE 00000288 "sub _new_from_self {"
NSQ_SOURCE_LINE 00000289 "    my $self = shift;"
NSQ_SOURCE_LINE 00000290 "    my %p    = @_;"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "    my %old = map { $_ => $self->$_() } qw("
NSQ_SOURCE_LINE 00000293 "        year month day"
NSQ_SOURCE_LINE 00000294 "        hour minute second"
NSQ_SOURCE_LINE 00000295 "        nanosecond"
NSQ_SOURCE_LINE 00000296 "        locale time_zone"
NSQ_SOURCE_LINE 00000297 "    );"
NSQ_SOURCE_LINE 00000298 "    $old{formatter} = $self->formatter"
NSQ_SOURCE_LINE 00000299 "        if defined $self->formatter;"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "    my $method = delete $p{_skip_validation} ? '_new' : 'new';"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "    return ( ref $self )->$method( %old, %p );"
NSQ_SOURCE_LINE 00000304 "}"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "sub _handle_offset_modifier {"
NSQ_SOURCE_LINE 00000307 "    my $self = shift;"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "    $self->{offset_modifier} = 0;"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "    return if $self->{tz}->is_floating;"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "    my $second       = shift;"
NSQ_SOURCE_LINE 00000314 "    my $utc_is_valid = shift;"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "    my $utc_rd_days = $self->{utc_rd_days};"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "    my $offset"
NSQ_SOURCE_LINE 00000319 "        = $utc_is_valid ? $self->offset : $self->_offset_for_local_datetime;"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "    if (   $offset >= 0"
NSQ_SOURCE_LINE 00000322 "        && $self->{local_rd_secs} >= $offset ) {"
NSQ_SOURCE_LINE 00000323 "        if ( $second < 60 && $offset > 0 ) {"
NSQ_SOURCE_LINE 00000324 "            $self->{offset_modifier}"
NSQ_SOURCE_LINE 00000325 "                = $self->_day_length( $utc_rd_days - 1 ) - SECONDS_PER_DAY;"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "            $self->{local_rd_secs} += $self->{offset_modifier};"
NSQ_SOURCE_LINE 00000328 "        }"
NSQ_SOURCE_LINE 00000329 "        elsif ("
NSQ_SOURCE_LINE 00000330 "            $second == 60"
NSQ_SOURCE_LINE 00000331 "            && ("
NSQ_SOURCE_LINE 00000332 "                ( $self->{local_rd_secs} == $offset && $offset > 0 )"
NSQ_SOURCE_LINE 00000333 "                || (   $offset == 0"
NSQ_SOURCE_LINE 00000334 "                    && $self->{local_rd_secs} > 86399 )"
NSQ_SOURCE_LINE 00000335 "            )"
NSQ_SOURCE_LINE 00000336 "        ) {"
NSQ_SOURCE_LINE 00000337 "            my $mod"
NSQ_SOURCE_LINE 00000338 "                = $self->_day_length( $utc_rd_days - 1 ) - SECONDS_PER_DAY;"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "            unless ( $mod == 0 ) {"
NSQ_SOURCE_LINE 00000341 "                $self->{utc_rd_secs} -= $mod;"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "                $self->_normalize_seconds;"
NSQ_SOURCE_LINE 00000344 "            }"
NSQ_SOURCE_LINE 00000345 "        }"
NSQ_SOURCE_LINE 00000346 "    }"
NSQ_SOURCE_LINE 00000347 "    elsif ($offset < 0"
NSQ_SOURCE_LINE 00000348 "        && $self->{local_rd_secs} >= SECONDS_PER_DAY + $offset ) {"
NSQ_SOURCE_LINE 00000349 "        if ( $second < 60 ) {"
NSQ_SOURCE_LINE 00000350 "            $self->{offset_modifier}"
NSQ_SOURCE_LINE 00000351 "                = $self->_day_length( $utc_rd_days - 1 ) - SECONDS_PER_DAY;"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "            $self->{local_rd_secs} += $self->{offset_modifier};"
NSQ_SOURCE_LINE 00000354 "        }"
NSQ_SOURCE_LINE 00000355 "        elsif ($second == 60"
NSQ_SOURCE_LINE 00000356 "            && $self->{local_rd_secs} == SECONDS_PER_DAY + $offset ) {"
NSQ_SOURCE_LINE 00000357 "            my $mod"
NSQ_SOURCE_LINE 00000358 "                = $self->_day_length( $utc_rd_days - 1 ) - SECONDS_PER_DAY;"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "            unless ( $mod == 0 ) {"
NSQ_SOURCE_LINE 00000361 "                $self->{utc_rd_secs} -= $mod;"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "                $self->_normalize_seconds;"
NSQ_SOURCE_LINE 00000364 "            }"
NSQ_SOURCE_LINE 00000365 "        }"
NSQ_SOURCE_LINE 00000366 "    }"
NSQ_SOURCE_LINE 00000367 "}"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "sub _calc_utc_rd {"
NSQ_SOURCE_LINE 00000370 "    my $self = shift;"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "    delete $self->{utc_c};"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "    if ( $self->{tz}->is_utc || $self->{tz}->is_floating ) {"
NSQ_SOURCE_LINE 00000375 "        $self->{utc_rd_days} = $self->{local_rd_days};"
NSQ_SOURCE_LINE 00000376 "        $self->{utc_rd_secs} = $self->{local_rd_secs};"
NSQ_SOURCE_LINE 00000377 "    }"
NSQ_SOURCE_LINE 00000378 "    else {"
NSQ_SOURCE_LINE 00000379 "        my $offset = $self->_offset_for_local_datetime;"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "        $offset += $self->{offset_modifier};"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "        $self->{utc_rd_days} = $self->{local_rd_days};"
NSQ_SOURCE_LINE 00000384 "        $self->{utc_rd_secs} = $self->{local_rd_secs} - $offset;"
NSQ_SOURCE_LINE 00000385 "    }"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "    # We account for leap seconds in the new() method and nowhere else"
NSQ_SOURCE_LINE 00000388 "    # except date math."
NSQ_SOURCE_LINE 00000389 "    $self->_normalize_tai_seconds("
NSQ_SOURCE_LINE 00000390 "        $self->{utc_rd_days},"
NSQ_SOURCE_LINE 00000391 "        $self->{utc_rd_secs}"
NSQ_SOURCE_LINE 00000392 "    );"
NSQ_SOURCE_LINE 00000393 "}"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "sub _normalize_seconds {"
NSQ_SOURCE_LINE 00000396 "    my $self = shift;"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "    return if $self->{utc_rd_secs} >= 0 && $self->{utc_rd_secs} <= 86399;"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "    if ( $self->{tz}->is_floating ) {"
NSQ_SOURCE_LINE 00000401 "        $self->_normalize_tai_seconds("
