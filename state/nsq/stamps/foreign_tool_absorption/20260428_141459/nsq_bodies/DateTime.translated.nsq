NSQ_SOURCE_LINE 00000088 "sub duration_class () {'DateTime::Duration'}"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "my ("
NSQ_SOURCE_LINE 00000091 "    @MonthLengths,"
