NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    @LeapYearQuarterLengths = @QuarterLengths;"
NSQ_SOURCE_LINE 00000106 "    $LeapYearQuarterLengths[0]++;"
