NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "{"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    # I'd rather use Class::Data::Inheritable for this, but there's no"
NSQ_SOURCE_LINE 00000112 "    # way to add the module-loading behavior to an accessor it"
NSQ_SOURCE_LINE 00000113 "    # creates, despite what its docs say!"
NSQ_SOURCE_LINE 00000114 "    my $DefaultLocale;"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    sub DefaultLocale {"
NSQ_SOURCE_LINE 00000117 "        shift;"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "        if (@_) {"
NSQ_SOURCE_LINE 00000120 "            my $lang = shift;"
