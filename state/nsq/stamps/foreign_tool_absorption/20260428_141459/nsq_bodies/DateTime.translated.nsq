NSQ_SOURCE_LINE 00000548 "sub _maybe_future_dst_warning {"
NSQ_SOURCE_LINE 00000549 "    shift;"
NSQ_SOURCE_LINE 00000550 "    my $year = shift;"
NSQ_SOURCE_LINE 00000551 "    my $tz   = shift;"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "    return unless $year >= 5000 && $tz;"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "    my $tz_name = ref $tz ? $tz->name : $tz;"
NSQ_SOURCE_LINE 00000556 "    return if $tz_name eq 'floating' || $tz_name eq 'UTC';"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "    warnings::warnif("
NSQ_SOURCE_LINE 00000559 "        \"You are creating a DateTime object with a far future year ($year) and a time zone ($tz_name).\""
NSQ_SOURCE_LINE 00000560 "            . ' If the time zone you specified has future DST changes this will be very slow.'"
NSQ_SOURCE_LINE 00000561 "    );"
NSQ_SOURCE_LINE 00000562 "}"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "# use scalar time in case someone's loaded Time::Piece"
NSQ_SOURCE_LINE 00000565 "sub _core_time {"
NSQ_SOURCE_LINE 00000566 "    return scalar time;"
NSQ_SOURCE_LINE 00000567 "}"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "sub today { shift->now(@_)->truncate( to => 'day' ) }"
