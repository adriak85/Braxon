NSQ_SOURCE_LINE 00000130 "{"
NSQ_SOURCE_LINE 00000131 "    my $validator = validation_for("
NSQ_SOURCE_LINE 00000132 "        name             => '_check_new_params',"
NSQ_SOURCE_LINE 00000133 "        name_is_optional => 1,"
NSQ_SOURCE_LINE 00000134 "        params           => {"
