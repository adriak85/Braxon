NSQ_SOURCE_LINE 00000571 "{"
NSQ_SOURCE_LINE 00000572 "    my $validator = validation_for("
NSQ_SOURCE_LINE 00000573 "        name             => '_check_from_object_params',"
NSQ_SOURCE_LINE 00000574 "        name_is_optional => 1,"
NSQ_SOURCE_LINE 00000575 "        params           => {"
NSQ_SOURCE_LINE 00000576 "            object => { type => t('ConvertibleObject') },"
NSQ_SOURCE_LINE 00000577 "            locale => {"
NSQ_SOURCE_LINE 00000578 "                type     => t('Locale'),"
NSQ_SOURCE_LINE 00000579 "                optional => 1,"
NSQ_SOURCE_LINE 00000580 "            },"
NSQ_SOURCE_LINE 00000581 "            formatter => {"
NSQ_SOURCE_LINE 00000582 "                type     => t('Formatter'),"
NSQ_SOURCE_LINE 00000583 "                optional => 1,"
NSQ_SOURCE_LINE 00000584 "            },"
NSQ_SOURCE_LINE 00000585 "        },"
