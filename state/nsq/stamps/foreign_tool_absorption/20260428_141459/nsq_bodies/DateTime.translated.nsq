NSQ_SOURCE_LINE 00001478 "# returns a result that is relative to the first datetime"
NSQ_SOURCE_LINE 00001479 "sub subtract_datetime {"
NSQ_SOURCE_LINE 00001480 "    my $dt1 = shift;"
NSQ_SOURCE_LINE 00001481 "    my $dt2 = shift;"
NSQ_SOURCE_LINE 00001482 ""
NSQ_SOURCE_LINE 00001483 "    $dt2 = $dt2->clone->set_time_zone( $dt1->time_zone )"
NSQ_SOURCE_LINE 00001484 "        unless $dt1->time_zone eq $dt2->time_zone;"
NSQ_SOURCE_LINE 00001485 ""
NSQ_SOURCE_LINE 00001486 "    # We only want a negative duration if $dt2 > $dt1 ($self)"
NSQ_SOURCE_LINE 00001487 "    my ( $bigger, $smaller, $negative ) = ("
NSQ_SOURCE_LINE 00001488 "        $dt1 >= $dt2"
NSQ_SOURCE_LINE 00001489 "        ? ( $dt1, $dt2, 0 )"
NSQ_SOURCE_LINE 00001490 "        : ( $dt2, $dt1, 1 )"
NSQ_SOURCE_LINE 00001491 "    );"
NSQ_SOURCE_LINE 00001492 ""
NSQ_SOURCE_LINE 00001493 "    my $is_floating = $dt1->time_zone->is_floating"
NSQ_SOURCE_LINE 00001494 "        && $dt2->time_zone->is_floating;"
NSQ_SOURCE_LINE 00001495 ""
NSQ_SOURCE_LINE 00001496 "    my $minute_length = 60;"
NSQ_SOURCE_LINE 00001497 "    unless ($is_floating) {"
NSQ_SOURCE_LINE 00001498 "        my ( $utc_rd_days, $utc_rd_secs ) = $smaller->utc_rd_values;"
NSQ_SOURCE_LINE 00001499 ""
NSQ_SOURCE_LINE 00001500 "        if ( $utc_rd_secs >= 86340 && !$is_floating ) {"
NSQ_SOURCE_LINE 00001501 ""
NSQ_SOURCE_LINE 00001502 "            # If the smaller of the two datetimes occurs in the last"
NSQ_SOURCE_LINE 00001503 "            # UTC minute of the UTC day, then that minute may not be"
NSQ_SOURCE_LINE 00001504 "            # 60 seconds long. If we need to subtract a minute from"
NSQ_SOURCE_LINE 00001505 "            # the larger datetime's minutes count in order to adjust"
NSQ_SOURCE_LINE 00001506 "            # the seconds difference to be positive, we need to know"
NSQ_SOURCE_LINE 00001507 "            # how long that minute was. If one of the datetimes is"
NSQ_SOURCE_LINE 00001508 "            # floating, we just assume a minute is 60 seconds."
NSQ_SOURCE_LINE 00001509 ""
NSQ_SOURCE_LINE 00001510 "            $minute_length = $dt1->_day_length($utc_rd_days) - 86340;"
NSQ_SOURCE_LINE 00001511 "        }"
NSQ_SOURCE_LINE 00001512 "    }"
NSQ_SOURCE_LINE 00001513 ""
NSQ_SOURCE_LINE 00001514 "    # This is a gross hack that basically figures out if the bigger of"
NSQ_SOURCE_LINE 00001515 "    # the two datetimes is the day of a DST change. If it's a 23 hour"
NSQ_SOURCE_LINE 00001516 "    # day (switching _to_ DST) then we subtract 60 minutes from the"
NSQ_SOURCE_LINE 00001517 "    # local time. If it's a 25 hour day then we add 60 minutes to the"
NSQ_SOURCE_LINE 00001518 "    # local time."
NSQ_SOURCE_LINE 00001519 "    #"
NSQ_SOURCE_LINE 00001520 "    # This produces the most \"intuitive\" results, though there are"
NSQ_SOURCE_LINE 00001521 "    # still reversibility problems with the resultant duration."
NSQ_SOURCE_LINE 00001522 "    #"
NSQ_SOURCE_LINE 00001523 "    # However, if the two objects are on the same (local) date, and we"
NSQ_SOURCE_LINE 00001524 "    # are not crossing a DST change, we don't want to invoke the hack"
NSQ_SOURCE_LINE 00001525 "    # - see 38local-subtract.t"
NSQ_SOURCE_LINE 00001526 "    my $bigger_min = $bigger->hour * 60 + $bigger->minute;"
NSQ_SOURCE_LINE 00001527 "    if (   $bigger->time_zone->has_dst_changes"
NSQ_SOURCE_LINE 00001528 "        && $bigger->is_dst != $smaller->is_dst ) {"
NSQ_SOURCE_LINE 00001529 ""
NSQ_SOURCE_LINE 00001530 "        $bigger_min -= 60"
NSQ_SOURCE_LINE 00001531 ""
NSQ_SOURCE_LINE 00001532 "            # it's a 23 hour (local) day"
NSQ_SOURCE_LINE 00001533 "            if ("
NSQ_SOURCE_LINE 00001534 "            $bigger->is_dst"
NSQ_SOURCE_LINE 00001535 "            && do {"
NSQ_SOURCE_LINE 00001536 "                my $prev_day = try { $bigger->clone->subtract( days => 1 ) };"
NSQ_SOURCE_LINE 00001537 "                $prev_day && !$prev_day->is_dst ? 1 : 0;"
NSQ_SOURCE_LINE 00001538 "            }"
NSQ_SOURCE_LINE 00001539 "            );"
NSQ_SOURCE_LINE 00001540 ""
NSQ_SOURCE_LINE 00001541 "        $bigger_min += 60"
NSQ_SOURCE_LINE 00001542 ""
NSQ_SOURCE_LINE 00001543 "            # it's a 25 hour (local) day"
NSQ_SOURCE_LINE 00001544 "            if ("
NSQ_SOURCE_LINE 00001545 "            !$bigger->is_dst"
NSQ_SOURCE_LINE 00001546 "            && do {"
NSQ_SOURCE_LINE 00001547 "                my $prev_day = try { $bigger->clone->subtract( days => 1 ) };"
NSQ_SOURCE_LINE 00001548 "                $prev_day && $prev_day->is_dst ? 1 : 0;"
NSQ_SOURCE_LINE 00001549 "            }"
NSQ_SOURCE_LINE 00001550 "            );"
NSQ_SOURCE_LINE 00001551 "    }"
NSQ_SOURCE_LINE 00001552 ""
NSQ_SOURCE_LINE 00001553 "    my ( $months, $days, $minutes, $seconds, $nanoseconds )"
NSQ_SOURCE_LINE 00001554 "        = $dt1->_adjust_for_positive_difference("
NSQ_SOURCE_LINE 00001555 "        $bigger->year * 12 + $bigger->month,"
NSQ_SOURCE_LINE 00001556 "        $smaller->year * 12 + $smaller->month,"
NSQ_SOURCE_LINE 00001557 ""
NSQ_SOURCE_LINE 00001558 "        $bigger->day, $smaller->day,"
NSQ_SOURCE_LINE 00001559 ""
NSQ_SOURCE_LINE 00001560 "        $bigger_min, $smaller->hour * 60 + $smaller->minute,"
NSQ_SOURCE_LINE 00001561 ""
NSQ_SOURCE_LINE 00001562 "        $bigger->second, $smaller->second,"
NSQ_SOURCE_LINE 00001563 ""
NSQ_SOURCE_LINE 00001564 "        $bigger->nanosecond, $smaller->nanosecond,"
NSQ_SOURCE_LINE 00001565 ""
NSQ_SOURCE_LINE 00001566 "        $minute_length,"
NSQ_SOURCE_LINE 00001567 ""
NSQ_SOURCE_LINE 00001568 "        # XXX - using the smaller as the month length is"
NSQ_SOURCE_LINE 00001569 "        # somewhat arbitrary, we could also use the bigger -"
NSQ_SOURCE_LINE 00001570 "        # either way we have reversibility problems"
NSQ_SOURCE_LINE 00001571 "        $dt1->_month_length( $smaller->year, $smaller->month ),"
NSQ_SOURCE_LINE 00001572 "        );"
NSQ_SOURCE_LINE 00001573 ""
NSQ_SOURCE_LINE 00001574 "    if ($negative) {"
NSQ_SOURCE_LINE 00001575 "        for ( $months, $days, $minutes, $seconds, $nanoseconds ) {"
NSQ_SOURCE_LINE 00001576 ""
NSQ_SOURCE_LINE 00001577 "            # Some versions of Perl can end up with -0 if we do \"0 * -1\"!!"
NSQ_SOURCE_LINE 00001578 "            $_ *= -1 if $_;"
NSQ_SOURCE_LINE 00001579 "        }"
NSQ_SOURCE_LINE 00001580 "    }"
NSQ_SOURCE_LINE 00001581 ""
NSQ_SOURCE_LINE 00001582 "    return $dt1->duration_class->new("
NSQ_SOURCE_LINE 00001583 "        months      => $months,"
NSQ_SOURCE_LINE 00001584 "        days        => $days,"
NSQ_SOURCE_LINE 00001585 "        minutes     => $minutes,"
NSQ_SOURCE_LINE 00001586 "        seconds     => $seconds,"
NSQ_SOURCE_LINE 00001587 "        nanoseconds => $nanoseconds,"
NSQ_SOURCE_LINE 00001588 "    );"
NSQ_SOURCE_LINE 00001589 "}"
NSQ_SOURCE_LINE 00001590 ""
NSQ_SOURCE_LINE 00001591 "## no critic (Subroutines::ProhibitManyArgs)"
NSQ_SOURCE_LINE 00001592 "sub _adjust_for_positive_difference {"
NSQ_SOURCE_LINE 00001593 "    my ("
NSQ_SOURCE_LINE 00001594 "        $self,"
NSQ_SOURCE_LINE 00001595 "        $month1, $month2,"
NSQ_SOURCE_LINE 00001596 "        $day1,   $day2,"
NSQ_SOURCE_LINE 00001597 "        $min1,   $min2,"
NSQ_SOURCE_LINE 00001598 "        $sec1,   $sec2,"
NSQ_SOURCE_LINE 00001599 "        $nano1,  $nano2,"
NSQ_SOURCE_LINE 00001600 "        $minute_length,"
NSQ_SOURCE_LINE 00001601 "        $month_length,"
NSQ_SOURCE_LINE 00001602 "    ) = @_;"
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "    if ( $nano1 < $nano2 ) {"
NSQ_SOURCE_LINE 00001605 "        $sec1--;"
NSQ_SOURCE_LINE 00001606 "        $nano1 += MAX_NANOSECONDS;"
NSQ_SOURCE_LINE 00001607 "    }"
NSQ_SOURCE_LINE 00001608 ""
NSQ_SOURCE_LINE 00001609 "    if ( $sec1 < $sec2 ) {"
NSQ_SOURCE_LINE 00001610 "        $min1--;"
NSQ_SOURCE_LINE 00001611 "        $sec1 += $minute_length;"
NSQ_SOURCE_LINE 00001612 "    }"
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "    # A day always has 24 * 60 minutes, though the minutes may vary in"
NSQ_SOURCE_LINE 00001615 "    # length."
NSQ_SOURCE_LINE 00001616 "    if ( $min1 < $min2 ) {"
NSQ_SOURCE_LINE 00001617 "        $day1--;"
NSQ_SOURCE_LINE 00001618 "        $min1 += 24 * 60;"
NSQ_SOURCE_LINE 00001619 "    }"
NSQ_SOURCE_LINE 00001620 ""
NSQ_SOURCE_LINE 00001621 "    if ( $day1 < $day2 ) {"
NSQ_SOURCE_LINE 00001622 "        $month1--;"
NSQ_SOURCE_LINE 00001623 "        $day1 += $month_length;"
NSQ_SOURCE_LINE 00001624 "    }"
NSQ_SOURCE_LINE 00001625 ""
NSQ_SOURCE_LINE 00001626 "    return ("
NSQ_SOURCE_LINE 00001627 "        $month1 - $month2,"
NSQ_SOURCE_LINE 00001628 "        $day1 - $day2,"
NSQ_SOURCE_LINE 00001629 "        $min1 - $min2,"
NSQ_SOURCE_LINE 00001630 "        $sec1 - $sec2,"
NSQ_SOURCE_LINE 00001631 "        $nano1 - $nano2,"
NSQ_SOURCE_LINE 00001632 "    );"
NSQ_SOURCE_LINE 00001633 "}"
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "sub subtract_datetime_absolute {"
NSQ_SOURCE_LINE 00001636 "    my $self = shift;"
NSQ_SOURCE_LINE 00001637 "    my $dt   = shift;"
NSQ_SOURCE_LINE 00001638 ""
NSQ_SOURCE_LINE 00001639 "    my $utc_rd_secs1 = $self->utc_rd_as_seconds;"
NSQ_SOURCE_LINE 00001640 "    $utc_rd_secs1 += $self->_accumulated_leap_seconds( $self->{utc_rd_days} )"
NSQ_SOURCE_LINE 00001641 "        if !$self->time_zone->is_floating;"
NSQ_SOURCE_LINE 00001642 ""
NSQ_SOURCE_LINE 00001643 "    my $utc_rd_secs2 = $dt->utc_rd_as_seconds;"
NSQ_SOURCE_LINE 00001644 "    $utc_rd_secs2 += $self->_accumulated_leap_seconds( $dt->{utc_rd_days} )"
NSQ_SOURCE_LINE 00001645 "        if !$dt->time_zone->is_floating;"
NSQ_SOURCE_LINE 00001646 ""
NSQ_SOURCE_LINE 00001647 "    my $seconds     = $utc_rd_secs1 - $utc_rd_secs2;"
NSQ_SOURCE_LINE 00001648 "    my $nanoseconds = $self->nanosecond - $dt->nanosecond;"
NSQ_SOURCE_LINE 00001649 ""
NSQ_SOURCE_LINE 00001650 "    if ( $nanoseconds < 0 ) {"
NSQ_SOURCE_LINE 00001651 "        $seconds--;"
NSQ_SOURCE_LINE 00001652 "        $nanoseconds += MAX_NANOSECONDS;"
NSQ_SOURCE_LINE 00001653 "    }"
NSQ_SOURCE_LINE 00001654 ""
NSQ_SOURCE_LINE 00001655 "    return $self->duration_class->new("
NSQ_SOURCE_LINE 00001656 "        seconds     => $seconds,"
NSQ_SOURCE_LINE 00001657 "        nanoseconds => $nanoseconds,"
NSQ_SOURCE_LINE 00001658 "    );"
NSQ_SOURCE_LINE 00001659 "}"
NSQ_SOURCE_LINE 00001660 ""
NSQ_SOURCE_LINE 00001661 "sub delta_md {"
NSQ_SOURCE_LINE 00001662 "    my $self = shift;"
NSQ_SOURCE_LINE 00001663 "    my $dt   = shift;"
NSQ_SOURCE_LINE 00001664 ""
NSQ_SOURCE_LINE 00001665 "    my ( $smaller, $bigger ) = sort $self, $dt;"
NSQ_SOURCE_LINE 00001666 ""
NSQ_SOURCE_LINE 00001667 "    my ( $months, $days, undef, undef, undef )"
NSQ_SOURCE_LINE 00001668 "        = $dt->_adjust_for_positive_difference("
NSQ_SOURCE_LINE 00001669 "        $bigger->year * 12 + $bigger->month,"
NSQ_SOURCE_LINE 00001670 "        $smaller->year * 12 + $smaller->month,"
NSQ_SOURCE_LINE 00001671 ""
NSQ_SOURCE_LINE 00001672 "        $bigger->day, $smaller->day,"
NSQ_SOURCE_LINE 00001673 ""
NSQ_SOURCE_LINE 00001674 "        0, 0,"
NSQ_SOURCE_LINE 00001675 ""
NSQ_SOURCE_LINE 00001676 "        0, 0,"
NSQ_SOURCE_LINE 00001677 ""
NSQ_SOURCE_LINE 00001678 "        0, 0,"
NSQ_SOURCE_LINE 00001679 ""
NSQ_SOURCE_LINE 00001680 "        60,"
NSQ_SOURCE_LINE 00001681 ""
NSQ_SOURCE_LINE 00001682 "        $smaller->_month_length( $smaller->year, $smaller->month ),"
NSQ_SOURCE_LINE 00001683 "        );"
NSQ_SOURCE_LINE 00001684 ""
NSQ_SOURCE_LINE 00001685 "    return $self->duration_class->new("
NSQ_SOURCE_LINE 00001686 "        months => $months,"
NSQ_SOURCE_LINE 00001687 "        days   => $days"
NSQ_SOURCE_LINE 00001688 "    );"
NSQ_SOURCE_LINE 00001689 "}"
NSQ_SOURCE_LINE 00001690 ""
NSQ_SOURCE_LINE 00001691 "sub delta_days {"
NSQ_SOURCE_LINE 00001692 "    my $self = shift;"
NSQ_SOURCE_LINE 00001693 "    my $dt   = shift;"
NSQ_SOURCE_LINE 00001694 ""
NSQ_SOURCE_LINE 00001695 "    my $days"
NSQ_SOURCE_LINE 00001696 "        = abs( ( $self->local_rd_values )[0] - ( $dt->local_rd_values )[0] );"
NSQ_SOURCE_LINE 00001697 ""
NSQ_SOURCE_LINE 00001698 "    $self->duration_class->new( days => $days );"
NSQ_SOURCE_LINE 00001699 "}"
NSQ_SOURCE_LINE 00001700 ""
NSQ_SOURCE_LINE 00001701 "sub delta_ms {"
NSQ_SOURCE_LINE 00001702 "    my $self = shift;"
NSQ_SOURCE_LINE 00001703 "    my $dt   = shift;"
NSQ_SOURCE_LINE 00001704 ""
NSQ_SOURCE_LINE 00001705 "    my ( $smaller, $greater ) = sort $self, $dt;"
NSQ_SOURCE_LINE 00001706 ""
NSQ_SOURCE_LINE 00001707 "    my $days = int( $greater->jd - $smaller->jd );"
NSQ_SOURCE_LINE 00001708 ""
NSQ_SOURCE_LINE 00001709 "    my $dur = $greater->subtract_datetime($smaller);"
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 "    my %p;"
NSQ_SOURCE_LINE 00001712 "    $p{hours}   = $dur->hours + ( $days * 24 );"
NSQ_SOURCE_LINE 00001713 "    $p{minutes} = $dur->minutes;"
NSQ_SOURCE_LINE 00001714 "    $p{seconds} = $dur->seconds;"
NSQ_SOURCE_LINE 00001715 ""
NSQ_SOURCE_LINE 00001716 "    return $self->duration_class->new(%p);"
NSQ_SOURCE_LINE 00001717 "}"
NSQ_SOURCE_LINE 00001718 ""
NSQ_SOURCE_LINE 00001719 "sub _add_overload {"
NSQ_SOURCE_LINE 00001720 "    my ( $dt, $dur, $reversed ) = @_;"
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "    if ($reversed) {"
NSQ_SOURCE_LINE 00001723 "        ( $dur, $dt ) = ( $dt, $dur );"
NSQ_SOURCE_LINE 00001724 "    }"
NSQ_SOURCE_LINE 00001725 ""
NSQ_SOURCE_LINE 00001726 "    unless ( DateTime::Helpers::isa( $dur, 'DateTime::Duration' ) ) {"
NSQ_SOURCE_LINE 00001727 "        my $class     = ref $dt;"
NSQ_SOURCE_LINE 00001728 "        my $dt_string = overload::StrVal($dt);"
NSQ_SOURCE_LINE 00001729 ""
NSQ_SOURCE_LINE 00001730 "        Carp::croak( \"Cannot add $dur to a $class object ($dt_string).\\n\""
NSQ_SOURCE_LINE 00001731 "                . ' Only a DateTime::Duration object can '"
NSQ_SOURCE_LINE 00001732 "                . \" be added to a $class object.\" );"
NSQ_SOURCE_LINE 00001733 "    }"
NSQ_SOURCE_LINE 00001734 ""
NSQ_SOURCE_LINE 00001735 "    return $dt->clone->add_duration($dur);"
NSQ_SOURCE_LINE 00001736 "}"
NSQ_SOURCE_LINE 00001737 ""
NSQ_SOURCE_LINE 00001738 "sub _subtract_overload {"
NSQ_SOURCE_LINE 00001739 "    my ( $date1, $date2, $reversed ) = @_;"
NSQ_SOURCE_LINE 00001740 ""
NSQ_SOURCE_LINE 00001741 "    if ($reversed) {"
NSQ_SOURCE_LINE 00001742 "        ( $date2, $date1 ) = ( $date1, $date2 );"
NSQ_SOURCE_LINE 00001743 "    }"
NSQ_SOURCE_LINE 00001744 ""
NSQ_SOURCE_LINE 00001745 "    if ( DateTime::Helpers::isa( $date2, 'DateTime::Duration' ) ) {"
NSQ_SOURCE_LINE 00001746 "        my $new = $date1->clone;"
NSQ_SOURCE_LINE 00001747 "        $new->add_duration( $date2->inverse );"
NSQ_SOURCE_LINE 00001748 "        return $new;"
NSQ_SOURCE_LINE 00001749 "    }"
NSQ_SOURCE_LINE 00001750 "    elsif ( DateTime::Helpers::isa( $date2, 'DateTime' ) ) {"
NSQ_SOURCE_LINE 00001751 "        return $date1->subtract_datetime($date2);"
NSQ_SOURCE_LINE 00001752 "    }"
NSQ_SOURCE_LINE 00001753 "    else {"
NSQ_SOURCE_LINE 00001754 "        my $class     = ref $date1;"
NSQ_SOURCE_LINE 00001755 "        my $dt_string = overload::StrVal($date1);"
NSQ_SOURCE_LINE 00001756 ""
NSQ_SOURCE_LINE 00001757 "        Carp::croak("
NSQ_SOURCE_LINE 00001758 "            \"Cannot subtract $date2 from a $class object ($dt_string).\\n\""
NSQ_SOURCE_LINE 00001759 "                . ' Only a DateTime::Duration or DateTime object can '"
NSQ_SOURCE_LINE 00001760 "                . \" be subtracted from a $class object.\" );"
NSQ_SOURCE_LINE 00001761 "    }"
NSQ_SOURCE_LINE 00001762 "}"
NSQ_SOURCE_LINE 00001763 ""
NSQ_SOURCE_LINE 00001764 "sub add {"
NSQ_SOURCE_LINE 00001765 "    my $self = shift;"
NSQ_SOURCE_LINE 00001766 ""
NSQ_SOURCE_LINE 00001767 "    return $self->add_duration( $self->_duration_object_from_args(@_) );"
NSQ_SOURCE_LINE 00001768 "}"
NSQ_SOURCE_LINE 00001769 ""
NSQ_SOURCE_LINE 00001770 "sub subtract {"
NSQ_SOURCE_LINE 00001771 "    my $self = shift;"
NSQ_SOURCE_LINE 00001772 ""
NSQ_SOURCE_LINE 00001773 "    my %eom;"
NSQ_SOURCE_LINE 00001774 "    if ( @_ % 2 == 0 ) {"
NSQ_SOURCE_LINE 00001775 "        my %p = @_;"
NSQ_SOURCE_LINE 00001776 ""
NSQ_SOURCE_LINE 00001777 "        $eom{end_of_month} = delete $p{end_of_month}"
NSQ_SOURCE_LINE 00001778 "            if exists $p{end_of_month};"
NSQ_SOURCE_LINE 00001779 "    }"
NSQ_SOURCE_LINE 00001780 ""
NSQ_SOURCE_LINE 00001781 "    my $dur = $self->_duration_object_from_args(@_)->inverse(%eom);"
NSQ_SOURCE_LINE 00001782 ""
NSQ_SOURCE_LINE 00001783 "    return $self->add_duration($dur);"
NSQ_SOURCE_LINE 00001784 "}"
NSQ_SOURCE_LINE 00001785 ""
NSQ_SOURCE_LINE 00001786 "# Syntactic sugar for add and subtract: use a duration object if it's"
NSQ_SOURCE_LINE 00001787 "# supplied, otherwise build a new one from the arguments."
NSQ_SOURCE_LINE 00001788 ""
NSQ_SOURCE_LINE 00001789 "sub _duration_object_from_args {"
NSQ_SOURCE_LINE 00001790 "    my $self = shift;"
NSQ_SOURCE_LINE 00001791 ""
NSQ_SOURCE_LINE 00001792 "    return $_[0]"
NSQ_SOURCE_LINE 00001793 "        if @_ == 1 && blessed( $_[0] ) && $_[0]->isa( $self->duration_class );"
NSQ_SOURCE_LINE 00001794 ""
NSQ_SOURCE_LINE 00001795 "    return $self->duration_class->new(@_);"
NSQ_SOURCE_LINE 00001796 "}"
NSQ_SOURCE_LINE 00001797 ""
NSQ_SOURCE_LINE 00001798 "sub subtract_duration { return $_[0]->add_duration( $_[1]->inverse ) }"
NSQ_SOURCE_LINE 00001799 ""
NSQ_SOURCE_LINE 00001800 "{"
NSQ_SOURCE_LINE 00001801 "    my $validator = validation_for("
NSQ_SOURCE_LINE 00001802 "        name             => '_check_add_duration_params',"
NSQ_SOURCE_LINE 00001803 "        name_is_optional => 1,"
NSQ_SOURCE_LINE 00001804 "        params           => ["
NSQ_SOURCE_LINE 00001805 "            { type => t('Duration') },"
NSQ_SOURCE_LINE 00001806 "        ],"
NSQ_SOURCE_LINE 00001807 "    );"
NSQ_SOURCE_LINE 00001808 ""
NSQ_SOURCE_LINE 00001809 "    ## no critic (Subroutines::ProhibitExcessComplexity)"
NSQ_SOURCE_LINE 00001810 "    sub add_duration {"
NSQ_SOURCE_LINE 00001811 "        my $self = shift;"
NSQ_SOURCE_LINE 00001812 "        my ($dur) = $validator->(@_);"
NSQ_SOURCE_LINE 00001813 ""
NSQ_SOURCE_LINE 00001814 "        # simple optimization"
NSQ_SOURCE_LINE 00001815 "        return $self if $dur->is_zero;"
NSQ_SOURCE_LINE 00001816 ""
NSQ_SOURCE_LINE 00001817 "        my %deltas = $dur->deltas;"
NSQ_SOURCE_LINE 00001818 ""
NSQ_SOURCE_LINE 00001819 "        # This bit isn't quite right since DateTime::Infinite::Future -"
NSQ_SOURCE_LINE 00001820 "        # infinite duration should NaN"
NSQ_SOURCE_LINE 00001821 "        for my $val ( values %deltas ) {"
NSQ_SOURCE_LINE 00001822 "            my $inf;"
NSQ_SOURCE_LINE 00001823 "            if ( $val == INFINITY ) {"
NSQ_SOURCE_LINE 00001824 "                $inf = DateTime::Infinite::Future->new;"
NSQ_SOURCE_LINE 00001825 "            }"
NSQ_SOURCE_LINE 00001826 "            elsif ( $val == NEG_INFINITY ) {"
NSQ_SOURCE_LINE 00001827 "                $inf = DateTime::Infinite::Past->new;"
NSQ_SOURCE_LINE 00001828 "            }"
NSQ_SOURCE_LINE 00001829 ""
NSQ_SOURCE_LINE 00001830 "            if ($inf) {"
NSQ_SOURCE_LINE 00001831 "                %$self = %$inf;"
NSQ_SOURCE_LINE 00001832 "                bless $self, ref $inf;"
NSQ_SOURCE_LINE 00001833 ""
NSQ_SOURCE_LINE 00001834 "                return $self;"
NSQ_SOURCE_LINE 00001835 "            }"
NSQ_SOURCE_LINE 00001836 "        }"
NSQ_SOURCE_LINE 00001837 ""
NSQ_SOURCE_LINE 00001838 "        return $self if $self->is_infinite;"
NSQ_SOURCE_LINE 00001839 ""
NSQ_SOURCE_LINE 00001840 "        my %orig = %{$self};"
NSQ_SOURCE_LINE 00001841 "        try {"
NSQ_SOURCE_LINE 00001842 "            $self->_add_duration($dur);"
NSQ_SOURCE_LINE 00001843 "        }"
NSQ_SOURCE_LINE 00001844 "        catch {"
NSQ_SOURCE_LINE 00001845 "            %{$self} = %orig;"
NSQ_SOURCE_LINE 00001846 "            die $_;"
NSQ_SOURCE_LINE 00001847 "        };"
NSQ_SOURCE_LINE 00001848 "    }"
NSQ_SOURCE_LINE 00001849 "}"
NSQ_SOURCE_LINE 00001850 ""
NSQ_SOURCE_LINE 00001851 "sub _add_duration {"
NSQ_SOURCE_LINE 00001852 "    my $self = shift;"
NSQ_SOURCE_LINE 00001853 "    my $dur  = shift;"
NSQ_SOURCE_LINE 00001854 ""
NSQ_SOURCE_LINE 00001855 "    my %deltas = $dur->deltas;"
NSQ_SOURCE_LINE 00001856 ""
NSQ_SOURCE_LINE 00001857 "    if ( $deltas{days} ) {"
NSQ_SOURCE_LINE 00001858 "        $self->{local_rd_days} += $deltas{days};"
NSQ_SOURCE_LINE 00001859 ""
NSQ_SOURCE_LINE 00001860 "        $self->{utc_year} += int( $deltas{days} / 365 ) + 1;"
NSQ_SOURCE_LINE 00001861 "    }"
NSQ_SOURCE_LINE 00001862 ""
NSQ_SOURCE_LINE 00001863 "    if ( $deltas{months} ) {"
NSQ_SOURCE_LINE 00001864 ""
NSQ_SOURCE_LINE 00001865 "        # For preserve mode, if it is the last day of the month, make"
NSQ_SOURCE_LINE 00001866 "        # it the 0th day of the following month (which then will"
NSQ_SOURCE_LINE 00001867 "        # normalize back to the last day of the new month)."
NSQ_SOURCE_LINE 00001868 "        my ( $y, $m, $d ) = ("
NSQ_SOURCE_LINE 00001869 "              $dur->is_preserve_mode"
NSQ_SOURCE_LINE 00001870 "            ? $self->_rd2ymd( $self->{local_rd_days} + 1 )"
NSQ_SOURCE_LINE 00001871 "            : $self->_rd2ymd( $self->{local_rd_days} )"
NSQ_SOURCE_LINE 00001872 "        );"
NSQ_SOURCE_LINE 00001873 ""
NSQ_SOURCE_LINE 00001874 "        $d -= 1 if $dur->is_preserve_mode;"
NSQ_SOURCE_LINE 00001875 ""
NSQ_SOURCE_LINE 00001876 "        if ( !$dur->is_wrap_mode && $d > 28 ) {"
NSQ_SOURCE_LINE 00001877 ""
NSQ_SOURCE_LINE 00001878 "            # find the rd for the last day of our target month"
NSQ_SOURCE_LINE 00001879 "            $self->{local_rd_days}"
NSQ_SOURCE_LINE 00001880 "                = $self->_ymd2rd( $y, $m + $deltas{months} + 1, 0 );"
NSQ_SOURCE_LINE 00001881 ""
NSQ_SOURCE_LINE 00001882 "            # what day of the month is it? (discard year and month)"
NSQ_SOURCE_LINE 00001883 "            my $last_day"
NSQ_SOURCE_LINE 00001884 "                = ( $self->_rd2ymd( $self->{local_rd_days} ) )[2];"
NSQ_SOURCE_LINE 00001885 ""
NSQ_SOURCE_LINE 00001886 "            # if our original day was less than the last day,"
NSQ_SOURCE_LINE 00001887 "            # use that instead"
NSQ_SOURCE_LINE 00001888 "            $self->{local_rd_days} -= $last_day - $d if $last_day > $d;"
NSQ_SOURCE_LINE 00001889 "        }"
NSQ_SOURCE_LINE 00001890 "        else {"
NSQ_SOURCE_LINE 00001891 "            $self->{local_rd_days}"
NSQ_SOURCE_LINE 00001892 "                = $self->_ymd2rd( $y, $m + $deltas{months}, $d );"
NSQ_SOURCE_LINE 00001893 "        }"
NSQ_SOURCE_LINE 00001894 ""
NSQ_SOURCE_LINE 00001895 "        $self->{utc_year} += int( $deltas{months} / 12 ) + 1;"
NSQ_SOURCE_LINE 00001896 "    }"
NSQ_SOURCE_LINE 00001897 ""
NSQ_SOURCE_LINE 00001898 "    if ( $deltas{days} || $deltas{months} ) {"
NSQ_SOURCE_LINE 00001899 "        $self->_calc_utc_rd;"
NSQ_SOURCE_LINE 00001900 ""
NSQ_SOURCE_LINE 00001901 "        $self->_handle_offset_modifier( $self->second );"
NSQ_SOURCE_LINE 00001902 "    }"
NSQ_SOURCE_LINE 00001903 ""
NSQ_SOURCE_LINE 00001904 "    if ( $deltas{minutes} ) {"
NSQ_SOURCE_LINE 00001905 "        $self->{utc_rd_secs} += $deltas{minutes} * 60;"
NSQ_SOURCE_LINE 00001906 ""
NSQ_SOURCE_LINE 00001907 "        # This intentionally ignores leap seconds"
NSQ_SOURCE_LINE 00001908 "        $self->_normalize_tai_seconds("
NSQ_SOURCE_LINE 00001909 "            $self->{utc_rd_days},"
NSQ_SOURCE_LINE 00001910 "            $self->{utc_rd_secs}"
NSQ_SOURCE_LINE 00001911 "        );"
NSQ_SOURCE_LINE 00001912 "    }"
NSQ_SOURCE_LINE 00001913 ""
NSQ_SOURCE_LINE 00001914 "    if ( $deltas{seconds} || $deltas{nanoseconds} ) {"
NSQ_SOURCE_LINE 00001915 "        $self->{utc_rd_secs} += $deltas{seconds};"
NSQ_SOURCE_LINE 00001916 ""
NSQ_SOURCE_LINE 00001917 "        if ( $deltas{nanoseconds} ) {"
NSQ_SOURCE_LINE 00001918 "            $self->{rd_nanosecs} += $deltas{nanoseconds};"
NSQ_SOURCE_LINE 00001919 "            $self->_normalize_nanoseconds("
NSQ_SOURCE_LINE 00001920 "                $self->{utc_rd_secs},"
NSQ_SOURCE_LINE 00001921 "                $self->{rd_nanosecs}"
NSQ_SOURCE_LINE 00001922 "            );"
NSQ_SOURCE_LINE 00001923 "        }"
NSQ_SOURCE_LINE 00001924 ""
NSQ_SOURCE_LINE 00001925 "        $self->_normalize_seconds;"
NSQ_SOURCE_LINE 00001926 ""
NSQ_SOURCE_LINE 00001927 "        # This might be some big number much bigger than 60, but"
NSQ_SOURCE_LINE 00001928 "        # that's ok (there are tests in 19leap_second.t to confirm"
NSQ_SOURCE_LINE 00001929 "        # that)"
NSQ_SOURCE_LINE 00001930 "        $self->_handle_offset_modifier( $self->second + $deltas{seconds} );"
NSQ_SOURCE_LINE 00001931 "    }"
