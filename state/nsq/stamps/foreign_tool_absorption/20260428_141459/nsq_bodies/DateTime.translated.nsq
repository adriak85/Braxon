NSQ_SOURCE_LINE 00001374 "    sub format_cldr {"
NSQ_SOURCE_LINE 00001375 "        my $self = shift;"
NSQ_SOURCE_LINE 00001376 ""
NSQ_SOURCE_LINE 00001377 "        # make a copy or caller's scalars get munged"
NSQ_SOURCE_LINE 00001378 "        my @p = @_;"
NSQ_SOURCE_LINE 00001379 ""
NSQ_SOURCE_LINE 00001380 "        my @r;"
NSQ_SOURCE_LINE 00001381 "        for my $p (@p) {"
NSQ_SOURCE_LINE 00001382 "            $p =~ s/\\G"
NSQ_SOURCE_LINE 00001383 "                    (?:"
NSQ_SOURCE_LINE 00001384 "                      '((?:[^']|'')*)' # quote escaped bit of text"
NSQ_SOURCE_LINE 00001385 "                                       # it needs to end with one"
NSQ_SOURCE_LINE 00001386 "                                       # quote not followed by"
NSQ_SOURCE_LINE 00001387 "                                       # another"
NSQ_SOURCE_LINE 00001388 "                      |"
NSQ_SOURCE_LINE 00001389 "                      (([a-zA-Z])\\3*)     # could be a pattern"
NSQ_SOURCE_LINE 00001390 "                      |"
NSQ_SOURCE_LINE 00001391 "                      (.)                 # anything else"
NSQ_SOURCE_LINE 00001392 "                    )"
NSQ_SOURCE_LINE 00001393 "                   /"
NSQ_SOURCE_LINE 00001394 "                    defined $1"
NSQ_SOURCE_LINE 00001395 "                    ? $1"
NSQ_SOURCE_LINE 00001396 "                    : defined $2"
NSQ_SOURCE_LINE 00001397 "                    ? $self->_cldr_pattern($2)"
NSQ_SOURCE_LINE 00001398 "                    : defined $4"
NSQ_SOURCE_LINE 00001399 "                    ? $4"
NSQ_SOURCE_LINE 00001400 "                    : undef # should never get here"
NSQ_SOURCE_LINE 00001401 "                   /sgex;"
NSQ_SOURCE_LINE 00001402 ""
