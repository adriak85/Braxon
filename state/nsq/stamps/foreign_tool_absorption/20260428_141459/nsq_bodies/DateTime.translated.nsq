NSQ_SOURCE_LINE 00002042 "sub _normalize_nanoseconds {"
NSQ_SOURCE_LINE 00002043 "    use integer;"
NSQ_SOURCE_LINE 00002044 ""
NSQ_SOURCE_LINE 00002045 "    # seconds, nanoseconds"
NSQ_SOURCE_LINE 00002046 "    if ( $_[2] < 0 ) {"
NSQ_SOURCE_LINE 00002047 "        my $overflow = 1 + $_[2] / MAX_NANOSECONDS;"
NSQ_SOURCE_LINE 00002048 "        $_[2] += $overflow * MAX_NANOSECONDS;"
NSQ_SOURCE_LINE 00002049 "        $_[1] -= $overflow;"
NSQ_SOURCE_LINE 00002050 "    }"
NSQ_SOURCE_LINE 00002051 "    elsif ( $_[2] >= MAX_NANOSECONDS ) {"
NSQ_SOURCE_LINE 00002052 "        my $overflow = $_[2] / MAX_NANOSECONDS;"
NSQ_SOURCE_LINE 00002053 "        $_[2] -= $overflow * MAX_NANOSECONDS;"
NSQ_SOURCE_LINE 00002054 "        $_[1] += $overflow;"
NSQ_SOURCE_LINE 00002055 "    }"
