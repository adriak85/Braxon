NSQ_SOURCE_LINE 00000588 "    sub from_object {"
NSQ_SOURCE_LINE 00000589 "        my $class = shift;"
NSQ_SOURCE_LINE 00000590 "        my %p     = $validator->(@_);"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "        my $object = delete $p{object};"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "        if ( $object->isa('DateTime::Infinite') ) {"
NSQ_SOURCE_LINE 00000595 "            return $object->clone;"
NSQ_SOURCE_LINE 00000596 "        }"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "        my ( $rd_days, $rd_secs, $rd_nanosecs ) = $object->utc_rd_values;"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "        # A kludge because until all calendars are updated to return all"
NSQ_SOURCE_LINE 00000601 "        # three values, $rd_nanosecs could be undef"
NSQ_SOURCE_LINE 00000602 "        $rd_nanosecs ||= 0;"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "        # This is a big hack to let _seconds_as_components operate naively"
NSQ_SOURCE_LINE 00000605 "        # on the given value. If the object _is_ on a leap second, we'll"
NSQ_SOURCE_LINE 00000606 "        # add that to the generated seconds value later."
NSQ_SOURCE_LINE 00000607 "        my $leap_seconds = 0;"
NSQ_SOURCE_LINE 00000608 "        if (   $object->can('time_zone')"
NSQ_SOURCE_LINE 00000609 "            && !$object->time_zone->is_floating"
NSQ_SOURCE_LINE 00000610 "            && $rd_secs > 86399"
NSQ_SOURCE_LINE 00000611 "            && $rd_secs <= $class->_day_length($rd_days) ) {"
NSQ_SOURCE_LINE 00000612 "            $leap_seconds = $rd_secs - 86399;"
NSQ_SOURCE_LINE 00000613 "            $rd_secs -= $leap_seconds;"
NSQ_SOURCE_LINE 00000614 "        }"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "        my %args;"
NSQ_SOURCE_LINE 00000617 "        @args{qw( year month day )} = $class->_rd2ymd($rd_days);"
NSQ_SOURCE_LINE 00000618 "        @args{qw( hour minute second )}"
NSQ_SOURCE_LINE 00000619 "            = $class->_seconds_as_components($rd_secs);"
NSQ_SOURCE_LINE 00000620 "        $args{nanosecond} = $rd_nanosecs;"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "        $args{second} += $leap_seconds;"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "        my $new = $class->new( %p, %args, time_zone => 'UTC' );"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "        if ( $object->can('time_zone') ) {"
NSQ_SOURCE_LINE 00000627 "            $new->set_time_zone( $object->time_zone );"
NSQ_SOURCE_LINE 00000628 "        }"
NSQ_SOURCE_LINE 00000629 "        else {"
NSQ_SOURCE_LINE 00000630 "            $new->set_time_zone( $class->_default_time_zone );"
NSQ_SOURCE_LINE 00000631 "        }"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "        return $new;"
NSQ_SOURCE_LINE 00000634 "    }"
NSQ_SOURCE_LINE 00000635 "}"
NSQ_SOURCE_LINE 00000636 ""
