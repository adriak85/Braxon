NSQ_SOURCE_LINE 00000059 "# for some reason, overloading doesn't work unless fallback is listed"
NSQ_SOURCE_LINE 00000060 "# early."
NSQ_SOURCE_LINE 00000061 "#"
NSQ_SOURCE_LINE 00000062 "# 3rd parameter ( $_[2] ) means the parameters are 'reversed'."
NSQ_SOURCE_LINE 00000063 "# see: \"Calling conventions for binary operations\" in overload docs."
NSQ_SOURCE_LINE 00000064 "#"
NSQ_SOURCE_LINE 00000065 "use overload ("
NSQ_SOURCE_LINE 00000066 "    fallback => 1,"
NSQ_SOURCE_LINE 00000067 "    '<=>'    => '_compare_overload',"
NSQ_SOURCE_LINE 00000068 "    'cmp'    => '_string_compare_overload',"
NSQ_SOURCE_LINE 00000069 "    q{\"\"}    => 'stringify',"
NSQ_SOURCE_LINE 00000070 "    bool     => sub {1},"
NSQ_SOURCE_LINE 00000071 "    '-'      => '_subtract_overload',"
NSQ_SOURCE_LINE 00000072 "    '+'      => '_add_overload',"
NSQ_SOURCE_LINE 00000073 "    'eq'     => '_string_equals_overload',"
NSQ_SOURCE_LINE 00000074 "    'ne'     => '_string_not_equals_overload',"
NSQ_SOURCE_LINE 00000075 ");"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "# Have to load this after overloading is defined, after BEGIN blocks"
NSQ_SOURCE_LINE 00000078 "# or else weird crashes ensue"
NSQ_SOURCE_LINE 00000079 "require DateTime::Infinite;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "sub MAX_NANOSECONDS () {1_000_000_000}                  # 1E9 = almost 32 bits"
NSQ_SOURCE_LINE 00000082 "sub INFINITY ()        { 100**100**100**100 }"
NSQ_SOURCE_LINE 00000083 "sub NEG_INFINITY ()    { -1 * ( 100**100**100**100 ) }"
