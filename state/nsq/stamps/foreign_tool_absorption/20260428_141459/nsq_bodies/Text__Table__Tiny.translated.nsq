BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Text::Table::Tiny;"
NSQ_SOURCE_LINE 00000002 "$Text::Table::Tiny::VERSION = '1.03';"
NSQ_SOURCE_LINE 00000003 "use 5.008;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use utf8;"
NSQ_SOURCE_LINE 00000007 "use parent 'Exporter';"
NSQ_SOURCE_LINE 00000008 "use Carp                    qw/ croak /;"
NSQ_SOURCE_LINE 00000009 "use Ref::Util         0.202 qw/ is_arrayref /;"
NSQ_SOURCE_LINE 00000010 "use String::TtyLength 0.02  qw/ tty_width /;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw/ generate_table /;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# Legacy package globals, that can be used to customise the look."
NSQ_SOURCE_LINE 00000015 "# These are only used in the \"classic\" style."
NSQ_SOURCE_LINE 00000016 "# I wish I could drop them, but I don't want to break anyone's code."
NSQ_SOURCE_LINE 00000017 "our $COLUMN_SEPARATOR     = '|';"
NSQ_SOURCE_LINE 00000018 "our $ROW_SEPARATOR        = '-';"
NSQ_SOURCE_LINE 00000019 "our $CORNER_MARKER        = '+';"
NSQ_SOURCE_LINE 00000020 "our $HEADER_ROW_SEPARATOR = '=';"
NSQ_SOURCE_LINE 00000021 "our $HEADER_CORNER_MARKER = 'O';"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "my %arguments = ("
NSQ_SOURCE_LINE 00000024 "    rows => \"the rows, including a possible header row, of the table\","
NSQ_SOURCE_LINE 00000025 "    header_row => \"if true, indicates that the first row is a header row\","
NSQ_SOURCE_LINE 00000026 "    separate_rows => \"if true, a separate rule will be drawn between each row\","
NSQ_SOURCE_LINE 00000027 "    top_and_tail => \"if true, miss out top and bottom edges of table\","
NSQ_SOURCE_LINE 00000028 "    align => \"either single alignment, or an array per of alignments per col\","
NSQ_SOURCE_LINE 00000029 "    style => \"styling of table, one of classic, boxrule, or norule\","
NSQ_SOURCE_LINE 00000030 "    indent => \"indent every row of the table a certain number of spaces\","
NSQ_SOURCE_LINE 00000031 "    compact => \"narrow columns (no space either side of content)\","
NSQ_SOURCE_LINE 00000032 "    header => \"array ref with header columns\","
NSQ_SOURCE_LINE 00000033 ");"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "my %charsets = ("
NSQ_SOURCE_LINE 00000036 "    classic => { TLC => '+', TT => '+', TRC => '+', HR => '-', VR => '|', FHR => '=', LT => '+', RT => '+', FLT => 'O', FRT => 'O', HC => '+', FHC => 'O', BLC => '+', BT => '+', BRC => '+' },"
NSQ_SOURCE_LINE 00000037 "    boxrule => { TLC => '┌', TT => '┬', TRC => '┐', HR => '─', VR => '│', FHR => '═', LT => '├', RT => '┤', FLT => '╞', FRT => '╡', HC => '┼', FHC => '╪', BLC => '└', BT => '┴', BRC => '┘' },"
NSQ_SOURCE_LINE 00000038 "    norule  => { TLC => ' ', TT => ' ', TRC => ' ', HR => ' ', VR => ' ', FHR => ' ', LT => ' ', RT => ' ', FLT => ' ', FRT => ' ', HC => ' ', FHC => ' ', BLC => ' ', BT => ' ', BRC => ' ' },"
NSQ_SOURCE_LINE 00000039 ");"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "sub generate_table"
NSQ_SOURCE_LINE 00000042 "{"
NSQ_SOURCE_LINE 00000043 "    my %param   = @_;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    foreach my $arg (keys %param) {"
NSQ_SOURCE_LINE 00000046 "        croak \"unknown argument '$arg'\" if not exists $arguments{$arg};"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    my $rows    = $param{rows} or croak \"you must pass the 'rows' argument!\";"
NSQ_SOURCE_LINE 00000050 "    my @rows    = @$rows;"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    if (exists($param{header}) && exists($param{header_row})) {"
NSQ_SOURCE_LINE 00000053 "        croak \"you can't pass both header and header_row arguments\";"
NSQ_SOURCE_LINE 00000054 "    }"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    if (exists $param{header}) {"
NSQ_SOURCE_LINE 00000057 "        if (not is_arrayref($param{header})) {"
NSQ_SOURCE_LINE 00000058 "            croak \"the 'header' argument expects an arrayref\\n\""
NSQ_SOURCE_LINE 00000059 "        }"
NSQ_SOURCE_LINE 00000060 "        unshift(@rows, $param{header});"
NSQ_SOURCE_LINE 00000061 "        $param{header_row} = 1;"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 "    my @widths  = _calculate_widths(\\@rows);"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    $param{style} = 'classic' if not defined $param{style};"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "    $param{indent} = '' if not defined $param{indent};"
NSQ_SOURCE_LINE 00000068 "    $param{indent} = ' ' x $param{indent} if $param{indent} =~ /^[0-9]+$/;"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    my $style   = $param{style};"
NSQ_SOURCE_LINE 00000071 "    croak \"unknown style '$style'\" if not exists($charsets{ $style });"
NSQ_SOURCE_LINE 00000072 "    my $char    = $charsets{$style};"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    if ($style eq 'classic') {"
NSQ_SOURCE_LINE 00000075 "        $char->{TLC} = $char->{TRC} = $char->{TT} = $char->{LT} = $char->{RT} = $char->{HC} = $char->{BLC} = $char->{BT} = $char->{BRC} = $CORNER_MARKER;"
NSQ_SOURCE_LINE 00000076 "        $char->{HR}  = $ROW_SEPARATOR;"
NSQ_SOURCE_LINE 00000077 "        $char->{VR}  = $COLUMN_SEPARATOR;"
NSQ_SOURCE_LINE 00000078 "        $char->{FLT} = $char->{FRT} = $char->{FHC} = $HEADER_CORNER_MARKER;"
NSQ_SOURCE_LINE 00000079 "        $char->{FHR} = $HEADER_ROW_SEPARATOR;"
NSQ_SOURCE_LINE 00000080 "    }"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    my $header;"
NSQ_SOURCE_LINE 00000083 "    my @align;"
NSQ_SOURCE_LINE 00000084 "    if (defined $param{align}) {"
NSQ_SOURCE_LINE 00000085 "        @align = is_arrayref($param{align})"
NSQ_SOURCE_LINE 00000086 "               ? @{ $param{align} }"
NSQ_SOURCE_LINE 00000087 "               : ($param{align}) x int(@widths)"
NSQ_SOURCE_LINE 00000088 "               ;"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 "    else {"
NSQ_SOURCE_LINE 00000091 "        @align = ('l') x int(@widths);"
NSQ_SOURCE_LINE 00000092 "    }"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    $header = shift @rows if $param{header_row};"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    my $table = _top_border(\\%param, \\@widths, $char)"
NSQ_SOURCE_LINE 00000097 "                ._header_row(\\%param, $header, \\@widths, \\@align, $char)"
NSQ_SOURCE_LINE 00000098 "                ._header_rule(\\%param, \\@widths, $char)"
NSQ_SOURCE_LINE 00000099 "                ._body(\\%param, \\@rows, \\@widths, \\@align, $char)"
NSQ_SOURCE_LINE 00000100 "                ._bottom_border(\\%param, \\@widths, $char);"
NSQ_SOURCE_LINE 00000101 "    chop($table);"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "    return $table;"
NSQ_SOURCE_LINE 00000104 "}"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "sub _top_border"
NSQ_SOURCE_LINE 00000107 "{"
NSQ_SOURCE_LINE 00000108 "    my ($param, $widths, $char) = @_;"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "    return '' if $param->{top_and_tail};"
NSQ_SOURCE_LINE 00000111 "    return _rule_row($param, $widths, $char->{TLC}, $char->{HR}, $char->{TT}, $char->{TRC});"
NSQ_SOURCE_LINE 00000112 "}"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "sub _bottom_border"
NSQ_SOURCE_LINE 00000115 "{"
NSQ_SOURCE_LINE 00000116 "    my ($param, $widths, $char) = @_;"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    return '' if $param->{top_and_tail};"
NSQ_SOURCE_LINE 00000119 "    return _rule_row($param, $widths, $char->{BLC}, $char->{HR}, $char->{BT}, $char->{BRC});"
NSQ_SOURCE_LINE 00000120 "}"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "sub _rule_row"
NSQ_SOURCE_LINE 00000123 "{"
NSQ_SOURCE_LINE 00000124 "    my ($param, $widths, $le, $hr, $cross, $re) = @_;"
NSQ_SOURCE_LINE 00000125 "    my $pad = $param->{compact} ? '' : $hr;"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "    return $param->{indent}"
NSQ_SOURCE_LINE 00000128 "           .$le"
NSQ_SOURCE_LINE 00000129 "           .join($cross, map { $pad.($hr x $_).$pad } @$widths)"
NSQ_SOURCE_LINE 00000130 "           .$re"
NSQ_SOURCE_LINE 00000131 "           .\"\\n\""
NSQ_SOURCE_LINE 00000132 "           ;"
NSQ_SOURCE_LINE 00000133 "}"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "sub _header_row"
NSQ_SOURCE_LINE 00000136 "{"
NSQ_SOURCE_LINE 00000137 "    my ($param, $row, $widths, $align, $char) = @_;"
NSQ_SOURCE_LINE 00000138 "    return '' unless $param->{header_row};"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "    return _text_row($param, $row, $widths, $align, $char);"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "sub _header_rule"
NSQ_SOURCE_LINE 00000144 "{"
NSQ_SOURCE_LINE 00000145 "    my ($param, $widths, $char) = @_;"
NSQ_SOURCE_LINE 00000146 "    return '' unless $param->{header_row};"
NSQ_SOURCE_LINE 00000147 "    my $fancy = $param->{separate_rows} ? 'F' : '';"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    return _rule_row($param, $widths, $char->{\"${fancy}LT\"}, $char->{\"${fancy}HR\"}, $char->{\"${fancy}HC\"}, $char->{\"${fancy}RT\"});"
NSQ_SOURCE_LINE 00000150 "}"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "sub _body"
NSQ_SOURCE_LINE 00000153 "{"
NSQ_SOURCE_LINE 00000154 "    my ($param, $rows, $widths, $align, $char) = @_;"
NSQ_SOURCE_LINE 00000155 "    my $divider = $param->{separate_rows} ? _rule_row($param, $widths, $char->{LT}, $char->{HR}, $char->{HC}, $char->{RT}) : '';"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    return join($divider, map { _text_row($param, $_, $widths, $align, $char) } @$rows);"
NSQ_SOURCE_LINE 00000158 "}"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "sub _text_row"
NSQ_SOURCE_LINE 00000161 "{"
NSQ_SOURCE_LINE 00000162 "    my ($param, $row, $widths, $align, $char) = @_;"
NSQ_SOURCE_LINE 00000163 "    my @columns = @$row;"
NSQ_SOURCE_LINE 00000164 "    my $text = $param->{indent}.$char->{VR};"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "    for (my $i = 0; $i < @$widths; $i++) {"
NSQ_SOURCE_LINE 00000167 "        $text .= _format_column($columns[$i], $widths->[$i], $align->[$i], $param, $char);"
NSQ_SOURCE_LINE 00000168 "        $text .= $char->{VR};"
NSQ_SOURCE_LINE 00000169 "    }"
NSQ_SOURCE_LINE 00000170 "    $text .= \"\\n\";"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    return $text;"
NSQ_SOURCE_LINE 00000173 "}"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "sub _format_column"
NSQ_SOURCE_LINE 00000176 "{"
NSQ_SOURCE_LINE 00000177 "    my ($text, $width, $align, $param, $char) = @_;"
NSQ_SOURCE_LINE 00000178 "    $text  = ''  if not defined $text;"
NSQ_SOURCE_LINE 00000179 "    $align = 'l' if not defined $align;"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "    my $pad = $param->{compact} ? '' : ' ';"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    if ($align eq 'r' || $align eq 'right') {"
NSQ_SOURCE_LINE 00000184 "        return $pad.' ' x ($width - tty_width($text)).$text.$pad;"
NSQ_SOURCE_LINE 00000185 "    }"
NSQ_SOURCE_LINE 00000186 "    elsif ($align eq 'c' || $align eq 'center' || $align eq 'centre') {"
NSQ_SOURCE_LINE 00000187 "        my $total_spaces = $width - tty_width($text);"
NSQ_SOURCE_LINE 00000188 "        my $left_spaces  = int($total_spaces / 2);"
NSQ_SOURCE_LINE 00000189 "        my $right_spaces = $left_spaces;"
NSQ_SOURCE_LINE 00000190 "        $right_spaces++ if $total_spaces % 2 == 1;"
NSQ_SOURCE_LINE 00000191 "        return $pad.(' ' x $left_spaces).$text.(' ' x $right_spaces).$pad;"
NSQ_SOURCE_LINE 00000192 "    }"
NSQ_SOURCE_LINE 00000193 "    else {"
NSQ_SOURCE_LINE 00000194 "        return $pad.$text.' ' x ($width - tty_width($text)).$pad;"
NSQ_SOURCE_LINE 00000195 "    }"
NSQ_SOURCE_LINE 00000196 "}"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "sub _calculate_widths"
NSQ_SOURCE_LINE 00000199 "{"
NSQ_SOURCE_LINE 00000200 "    my $rows = shift;"
NSQ_SOURCE_LINE 00000201 "    my @widths;"
NSQ_SOURCE_LINE 00000202 "    foreach my $row (@$rows) {"
NSQ_SOURCE_LINE 00000203 "        my @columns = @$row;"
NSQ_SOURCE_LINE 00000204 "        for (my $i = 0; $i < @columns; $i++) {"
NSQ_SOURCE_LINE 00000205 "            next unless defined($columns[$i]);"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "            my $width = tty_width($columns[$i]);"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "            $widths[$i] = $width if !defined($widths[$i])"
NSQ_SOURCE_LINE 00000210 "                                 || $width > $widths[$i];"
NSQ_SOURCE_LINE 00000211 "        }"
NSQ_SOURCE_LINE 00000212 "    }"
NSQ_SOURCE_LINE 00000213 "    return @widths;"
NSQ_SOURCE_LINE 00000214 "}"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "# Back-compat: 'table' is an alias for 'generate_table', but isn't exported"
NSQ_SOURCE_LINE 00000217 "*table = \\&generate_table;"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "1;"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "__END__"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=pod"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=encoding utf8"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=head1 NAME"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "Text::Table::Tiny - generate simple text tables from 2D arrays"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 " use Text::Table::Tiny 1.02 qw/ generate_table /;"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 " my $rows = ["
NSQ_SOURCE_LINE 00000236 "   [qw/ Pokemon     Type     Count /],"
NSQ_SOURCE_LINE 00000237 "   [qw/ Abra        Psychic      5 /],"
NSQ_SOURCE_LINE 00000238 "   [qw/ Ekans       Poison     123 /],"
NSQ_SOURCE_LINE 00000239 "   [qw/ Feraligatr  Water     5678 /],"
NSQ_SOURCE_LINE 00000240 " ];"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 " print generate_table(rows => $rows, header_row => 1), \"\\n\";"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "This module provides a single function, C<generate_table>, which formats"
NSQ_SOURCE_LINE 00000248 "a two-dimensional array of data as a text table."
NSQ_SOURCE_LINE 00000249 "It handles text that includes ANSI escape codes and wide Unicode characters."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "There are a number of options for adjusting the output format,"
NSQ_SOURCE_LINE 00000252 "but the intention is that the default option is good enough for most uses."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "The example shown in the SYNOPSIS generates the following table:"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 " +------------+---------+-------+"
NSQ_SOURCE_LINE 00000257 " | Pokemon    | Type    | Count |"
NSQ_SOURCE_LINE 00000258 " +------------+---------+-------+"
NSQ_SOURCE_LINE 00000259 " | Abra       | Psychic | 5     |"
NSQ_SOURCE_LINE 00000260 " | Ekans      | Poison  | 123   |"
NSQ_SOURCE_LINE 00000261 " | Feraligatr | Water   | 5678  |"
NSQ_SOURCE_LINE 00000262 " +------------+---------+-------+"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "Support for wide characters was added in 1.02,"
NSQ_SOURCE_LINE 00000265 "so if you need that,"
NSQ_SOURCE_LINE 00000266 "you should specify that as your minimum required version,"
NSQ_SOURCE_LINE 00000267 "as per the SYNOPSIS."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "The interface changed with version 0.04,"
NSQ_SOURCE_LINE 00000270 "so if you use the C<generate_table()> function illustrated above,"
NSQ_SOURCE_LINE 00000271 "then you need to require at least version 0.04 of this module."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "Some of the options described below were added in version 1.00,"
NSQ_SOURCE_LINE 00000274 "so your best bet is to require at least version 1.00."
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=head2 generate_table()"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "The C<generate_table> function understands a number of arguments,"
NSQ_SOURCE_LINE 00000280 "which are passed as a hash."
NSQ_SOURCE_LINE 00000281 "The only required argument is B<rows>."
NSQ_SOURCE_LINE 00000282 "Where arguments were not supported in the original release,"
NSQ_SOURCE_LINE 00000283 "the first supporting version is noted."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "If you pass an unknown argument,"
NSQ_SOURCE_LINE 00000286 "C<generate_table> will die with an error message."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=over 4"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=item *"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "rows"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "Takes an array reference which should contain one or more rows"
NSQ_SOURCE_LINE 00000296 "of data, where each row is an array reference."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=item *"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "header_row"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "If given a true value, the first row in the data will be interpreted"
NSQ_SOURCE_LINE 00000304 "as a header row, and separated from the rest of the table with a ruled line."
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=item *"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "header"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "Takes an array reference which has the header row to use for the table."
NSQ_SOURCE_LINE 00000312 "You can't use this option together with C<header_row>."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "Added in 1.03"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=item *"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "separate_rows"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "If given a true value, a separator line will be drawn between every row in"
NSQ_SOURCE_LINE 00000321 "the table,"
NSQ_SOURCE_LINE 00000322 "and a thicker line will be used for the header separator."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=item *"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "top_and_tail"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "If given a true value, then the top and bottom border lines will be skipped."
NSQ_SOURCE_LINE 00000329 "This reduces the vertical height of the generated table."
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "Added in 0.04."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "=item *"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "align"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "This takes an array ref with one entry per column,"
NSQ_SOURCE_LINE 00000338 "to specify the alignment of that column."
NSQ_SOURCE_LINE 00000339 "Legal values are 'l', 'c', and 'r'."
NSQ_SOURCE_LINE 00000340 "You can also specify a single alignment for all columns."
NSQ_SOURCE_LINE 00000341 "ANSI escape codes are handled."
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "Added in 1.00."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=item *"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "style"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "Specifies the format of the output table."
NSQ_SOURCE_LINE 00000350 "The default is C<'classic'>,"
NSQ_SOURCE_LINE 00000351 "but other options are C<'boxrule'> and C<'norule'>."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "If you use the C<boxrule> style,"
NSQ_SOURCE_LINE 00000354 "you'll probably need to run C<binmode(STDOUT, ':utf8')>."
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "Added in 1.00."
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=item *"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "indent"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "Specify an indent that should be prefixed to every line"
NSQ_SOURCE_LINE 00000364 "of the generated table."
NSQ_SOURCE_LINE 00000365 "This can either be a string of spaces,"
NSQ_SOURCE_LINE 00000366 "or an integer giving the number of spaces wanted."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "Added in 1.00."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=item *"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "compact"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "If set to a true value then we omit the single space padding on either"
NSQ_SOURCE_LINE 00000375 "side of every column."
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "Added in 1.00."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=back"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=head2 EXAMPLES"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "If you just pass the data and no other options:"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 " generate_table(rows => $rows);"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "You get minimal ruling:"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 " +------------+---------+-------+"
NSQ_SOURCE_LINE 00000391 " | Pokemon    | Type    | Count |"
NSQ_SOURCE_LINE 00000392 " | Abra       | Psychic | 5     |"
NSQ_SOURCE_LINE 00000393 " | Ekans      | Poison  | 123   |"
NSQ_SOURCE_LINE 00000394 " | Feraligatr | Water   | 5678  |"
NSQ_SOURCE_LINE 00000395 " +------------+---------+-------+"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "If you want a separate header, set the header_row option to a true value,"
NSQ_SOURCE_LINE 00000398 "as shown in the SYNOPSIS."
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "To take up fewer lines,"
NSQ_SOURCE_LINE 00000401 "you can miss out the top and bottom rules,"
NSQ_SOURCE_LINE 00000402 "by setting C<top_and_tail> to a true value:"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 " generate_table(rows => $rows, header_row => 1, top_and_tail => 1);"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "This will generate the following:"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 " | Pokemon    | Type    | Count |"
NSQ_SOURCE_LINE 00000409 " +------------+---------+-------+"
NSQ_SOURCE_LINE 00000410 " | Abra       | Psychic | 5     |"
NSQ_SOURCE_LINE 00000411 " | Ekans      | Poison  | 123   |"
NSQ_SOURCE_LINE 00000412 " | Feraligatr | Water   | 5678  |"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "If you want a more stylish looking table,"
NSQ_SOURCE_LINE 00000415 "set the C<style> parameter to C<'boxrule'>:"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 " binmode(STDOUT,':utf8');"
NSQ_SOURCE_LINE 00000418 " generate_table(rows => $rows, header_row => 1, style => 'boxrule');"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "This uses the ANSI box rule characters."
NSQ_SOURCE_LINE 00000421 "Note that you will need to ensure UTF output."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 " ┌────────────┬─────────┬───────┐"
NSQ_SOURCE_LINE 00000424 " │ Pokemon    │ Type    │ Count │"
NSQ_SOURCE_LINE 00000425 " ├────────────┼─────────┼───────┤"
NSQ_SOURCE_LINE 00000426 " │ Abra       │ Psychic │ 5     │"
NSQ_SOURCE_LINE 00000427 " │ Ekans      │ Poison  │ 123   │"
NSQ_SOURCE_LINE 00000428 " │ Feraligatr │ Water   │ 5678  │"
NSQ_SOURCE_LINE 00000429 " └────────────┴─────────┴───────┘"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "You might want to right-align numeric values:"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 " generate_table( ... , align => [qw/ l l r /] );"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "The C<align> parameter can either take an arrayref,"
NSQ_SOURCE_LINE 00000436 "or a string with an alignment to apply to all columns:"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 " ┌────────────┬─────────┬───────┐"
NSQ_SOURCE_LINE 00000439 " │ Pokemon    │ Type    │ Count │"
NSQ_SOURCE_LINE 00000440 " ├────────────┼─────────┼───────┤"
NSQ_SOURCE_LINE 00000441 " │ Abra       │ Psychic │     5 │"
NSQ_SOURCE_LINE 00000442 " │ Ekans      │ Poison  │   123 │"
NSQ_SOURCE_LINE 00000443 " │ Feraligatr │ Water   │  5678 │"
NSQ_SOURCE_LINE 00000444 " └────────────┴─────────┴───────┘"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "If you're using the boxrule style,"
NSQ_SOURCE_LINE 00000447 "you might feel you can remove the padding on either side of every column,"
NSQ_SOURCE_LINE 00000448 "done by setting C<compact> to a true value:"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 " ┌──────────┬───────┬─────┐"
NSQ_SOURCE_LINE 00000451 " │Pokemon   │Type   │Count│"
NSQ_SOURCE_LINE 00000452 " ├──────────┼───────┼─────┤"
NSQ_SOURCE_LINE 00000453 " │Abra      │Psychic│    5│"
NSQ_SOURCE_LINE 00000454 " │Ekans     │Poison │  123│"
NSQ_SOURCE_LINE 00000455 " │Feraligatr│Water  │ 5678│"
NSQ_SOURCE_LINE 00000456 " └──────────┴───────┴─────┘"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "You can also ask for a rule between each row,"
NSQ_SOURCE_LINE 00000459 "in which case the header rule becomes stronger."
NSQ_SOURCE_LINE 00000460 "This works best when combined with the boxrule style:"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 " generate_table( ... , separate_rows => 1 );"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "Which results in the following:"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 " ┌────────────┬─────────┬───────┐"
NSQ_SOURCE_LINE 00000467 " │ Pokemon    │ Type    │ Count │"
NSQ_SOURCE_LINE 00000468 " ╞════════════╪═════════╪═══════╡"
NSQ_SOURCE_LINE 00000469 " │ Abra       │ Psychic │     5 │"
NSQ_SOURCE_LINE 00000470 " ├────────────┼─────────┼───────┤"
NSQ_SOURCE_LINE 00000471 " │ Ekans      │ Poison  │   123 │"
NSQ_SOURCE_LINE 00000472 " ├────────────┼─────────┼───────┤"
NSQ_SOURCE_LINE 00000473 " │ Feraligatr │ Water   │  5678 │"
NSQ_SOURCE_LINE 00000474 " └────────────┴─────────┴───────┘"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "You can use this with the other styles,"
NSQ_SOURCE_LINE 00000477 "but I'm not sure you'd want to."
NSQ_SOURCE_LINE 00000478 " "
NSQ_SOURCE_LINE 00000479 "If you just want columnar output,"
NSQ_SOURCE_LINE 00000480 "use the C<norule> style:"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 " generate_table( ... , style => 'norule' );"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "which results in:"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "  "
NSQ_SOURCE_LINE 00000487 "  Pokemon      Type      Count"
NSQ_SOURCE_LINE 00000488 "  "
NSQ_SOURCE_LINE 00000489 "  Abra         Psychic       5"
NSQ_SOURCE_LINE 00000490 "  Ekans        Poison      123"
NSQ_SOURCE_LINE 00000491 "  Feraligatr   Water      5678"
NSQ_SOURCE_LINE 00000492 "   "
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "Note that everywhere you saw a line on the previous tables,"
NSQ_SOURCE_LINE 00000495 "there will be a space character in this version."
NSQ_SOURCE_LINE 00000496 "So you may want to combine the C<top_and_tail> option,"
NSQ_SOURCE_LINE 00000497 "to suppress the extra blank lines before and after"
NSQ_SOURCE_LINE 00000498 "the body of the table."
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "My L<blog post|http://neilb.org/2019/08/06/text-table-tiny-changes.html>"
NSQ_SOURCE_LINE 00000504 "where I described changes to formatting;"
NSQ_SOURCE_LINE 00000505 "this has more examples."
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "There are many modules for formatting text tables on CPAN."
NSQ_SOURCE_LINE 00000508 "A good number of them are listed in the"
NSQ_SOURCE_LINE 00000509 "L<See Also|https://metacpan.org/pod/Text::Table::Manifold#See-Also>"
NSQ_SOURCE_LINE 00000510 "section of the documentation for L<Text::Table::Manifold>."
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 ""
