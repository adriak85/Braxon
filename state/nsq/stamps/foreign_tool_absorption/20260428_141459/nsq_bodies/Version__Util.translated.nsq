BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Version::Util;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use version 0.77;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000009 "our $DATE = '2022-09-22'; # DATE"
NSQ_SOURCE_LINE 00000010 "our $DIST = 'Version-Util'; # DIST"
NSQ_SOURCE_LINE 00000011 "our $VERSION = '0.732'; # VERSION"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000015 "                       cmp_version"
NSQ_SOURCE_LINE 00000016 "                       version_eq version_ne"
NSQ_SOURCE_LINE 00000017 "                       version_lt version_le version_gt version_ge"
NSQ_SOURCE_LINE 00000018 "                       version_between version_in"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "                       min_version max_version"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "                       add_version subtract_version"
NSQ_SOURCE_LINE 00000023 "               );"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub cmp_version {"
NSQ_SOURCE_LINE 00000026 "    my $res; eval { $res = version->parse($_[0]) <=> version->parse($_[1]) }; die \"Can't cmp_version $_[0] & $_[1]: $@\" if $@; $res;"
NSQ_SOURCE_LINE 00000027 "}"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub version_eq {"
NSQ_SOURCE_LINE 00000030 "    my $res; eval { $res = version->parse($_[0]) == version->parse($_[1]) }; die \"Can't version_eq $_[0] & $_[1]: $@\" if $@; $res;"
NSQ_SOURCE_LINE 00000031 "}"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "sub version_ne {"
NSQ_SOURCE_LINE 00000034 "    my $res; eval { $res = version->parse($_[0]) != version->parse($_[1]) }; die \"Can't version_ne $_[0] & $_[1]: $@\" if $@; $res;"
NSQ_SOURCE_LINE 00000035 "}"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub version_lt {"
NSQ_SOURCE_LINE 00000038 "    my $res; eval { $res = version->parse($_[0]) <  version->parse($_[1]) }; die \"Can't version_lt $_[0] & $_[1]: $@\" if $@; $res;"
NSQ_SOURCE_LINE 00000039 "}"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "sub version_le {"
NSQ_SOURCE_LINE 00000042 "    my $res; eval { $res = version->parse($_[0]) <= version->parse($_[1]) }; die \"Can't version_le $_[0] & $_[1]: $@\" if $@; $res;"
NSQ_SOURCE_LINE 00000043 "}"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "sub version_gt {"
NSQ_SOURCE_LINE 00000046 "    my $res; eval { $res = version->parse($_[0]) >  version->parse($_[1]) }; die \"Can't version_gt $_[0] & $_[1]: $@\" if $@; $res;"
NSQ_SOURCE_LINE 00000047 "}"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "sub version_ge {"
NSQ_SOURCE_LINE 00000050 "    my $res; eval { $res = version->parse($_[0]) >= version->parse($_[1]) }; die \"Can't version_ge $_[0] & $_[1]: $@\" if $@; $res;"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "sub version_between {"
NSQ_SOURCE_LINE 00000054 "    my $v0 = shift;"
NSQ_SOURCE_LINE 00000055 "    my $v; eval { $v = version->parse($v0) };"
NSQ_SOURCE_LINE 00000056 "    die \"Can't version_between for $v0: $@\" if $@;"
NSQ_SOURCE_LINE 00000057 "    while (@_) {"
NSQ_SOURCE_LINE 00000058 "        my $v1 = shift;"
NSQ_SOURCE_LINE 00000059 "        my $v2 = shift;"
NSQ_SOURCE_LINE 00000060 "        my $return; eval { $return++ if $v >= version->parse($v1) && $v <= version->parse($v2) };"
NSQ_SOURCE_LINE 00000061 "        return 1 if $return;"
NSQ_SOURCE_LINE 00000062 "        die \"Can't version_between $v1 <= $v0 <= $v2: $@\" if $@;"
NSQ_SOURCE_LINE 00000063 "    }"
NSQ_SOURCE_LINE 00000064 "    0;"
NSQ_SOURCE_LINE 00000065 "}"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "sub version_in {"
NSQ_SOURCE_LINE 00000068 "    my $v0 = shift;"
NSQ_SOURCE_LINE 00000069 "    my $v; eval { $v = version->parse($v0) };"
NSQ_SOURCE_LINE 00000070 "    die \"Can't version_in for $v0: $@\" if $@;"
NSQ_SOURCE_LINE 00000071 "    for (@_) {"
NSQ_SOURCE_LINE 00000072 "        my $return; eval { $return++ if $v == version->parse($_) };"
NSQ_SOURCE_LINE 00000073 "        return 1 if $return;"
NSQ_SOURCE_LINE 00000074 "        die \"Can't version_in: $v0 == $_: $@\" if $@;"
NSQ_SOURCE_LINE 00000075 "    }"
NSQ_SOURCE_LINE 00000076 "    0;"
NSQ_SOURCE_LINE 00000077 "}"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "sub _max2 {"
NSQ_SOURCE_LINE 00000080 "    $_[0] > $_[1] ? $_[0] : $_[1];"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "sub min_version {"
NSQ_SOURCE_LINE 00000084 "    my @v = sort {"
NSQ_SOURCE_LINE 00000085 "        my $res; eval { $res = version->parse($a) <=> version->parse($b) };"
NSQ_SOURCE_LINE 00000086 "        die \"Can't min_version: Can't sort $a vs $b: $@\" if $@;"
NSQ_SOURCE_LINE 00000087 "        $res;"
NSQ_SOURCE_LINE 00000088 "    } @_;"
NSQ_SOURCE_LINE 00000089 "    @v ? $v[0] : undef;"
NSQ_SOURCE_LINE 00000090 "}"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "sub max_version {"
NSQ_SOURCE_LINE 00000093 "    my @v = sort {"
NSQ_SOURCE_LINE 00000094 "        my $res; eval { $res = version->parse($a) <=> version->parse($b) };"
NSQ_SOURCE_LINE 00000095 "        die \"Can't max_version: Can't sort $a vs $b: $@\" if $@;"
NSQ_SOURCE_LINE 00000096 "        $res;"
NSQ_SOURCE_LINE 00000097 "    } @_;"
NSQ_SOURCE_LINE 00000098 "    @v ? $v[-1] : undef;"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "sub _add_or_subtract_version {"
NSQ_SOURCE_LINE 00000102 "    my ($which, $v, $inc) = @_;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    state $re = qr/\\Av?(\\d{1,15})(?:\\.(\\d{1,3}))?(?:\\.(\\d{1,3}))?\\z/;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    $v =~ $re or die \"Invalid version '$v', must match $re\";"
NSQ_SOURCE_LINE 00000107 "    my ($v_maj, $v_min, $v_pl) = ($1, $2, $3);"
NSQ_SOURCE_LINE 00000108 "    $v_min //= '';"
NSQ_SOURCE_LINE 00000109 "    $v_pl //= '';"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    $inc =~ $re or die \"Invalid increment '$inc', must match $re\";"
NSQ_SOURCE_LINE 00000112 "    my ($inc_maj, $inc_min, $inc_pl) = ($1, $2, $3);"
NSQ_SOURCE_LINE 00000113 "    $inc_min //= '';"
NSQ_SOURCE_LINE 00000114 "    $inc_pl //= '';"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    my $width_min = _max2(length($v_min), length($inc_min));"
NSQ_SOURCE_LINE 00000117 "    my $width_pl  = _max2(length($v_pl ), length($inc_pl ));"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "    $v_min .= \"0\" x ($width_min-length($v_min)) if $width_min;"
NSQ_SOURCE_LINE 00000120 "    $v_pl  .= \"0\" x ($width_pl -length($v_pl )) if $width_pl;"
NSQ_SOURCE_LINE 00000121 "    $inc_min .= \"0\" x ($width_min-length($inc_min)) if $width_min;"
NSQ_SOURCE_LINE 00000122 "    $inc_pl  .= \"0\" x ($width_pl -length($inc_pl )) if $width_pl;"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "    if ($which eq 'subtract') {"
NSQ_SOURCE_LINE 00000125 "        $inc_min = \"-$inc_min\" if length($inc_min);"
NSQ_SOURCE_LINE 00000126 "        $inc_pl  = \"-$inc_pl\"  if length($inc_pl );"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "    }"
NSQ_SOURCE_LINE 00000129 "    $v_min = 0 if !length($v_min) && $width_min;"
NSQ_SOURCE_LINE 00000130 "    $v_pl  = 0 if !length($v_pl)  && $width_pl;"
NSQ_SOURCE_LINE 00000131 "    $inc_min = 0 if !length($inc_min) && $width_min;"
NSQ_SOURCE_LINE 00000132 "    $inc_pl  = 0 if !length($inc_pl)  && $width_pl;"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "    if ($width_pl) {"
NSQ_SOURCE_LINE 00000135 "        my $limit = \"1\" . (\"0\" x $width_pl);"
NSQ_SOURCE_LINE 00000136 "        $v_pl += $inc_pl;"
NSQ_SOURCE_LINE 00000137 "        if ($v_pl < 0) {"
NSQ_SOURCE_LINE 00000138 "            $v_pl += $limit;"
NSQ_SOURCE_LINE 00000139 "            $v_min--;"
NSQ_SOURCE_LINE 00000140 "        } elsif ($v_pl >= $limit) {"
NSQ_SOURCE_LINE 00000141 "            $v_pl -= $limit;"
NSQ_SOURCE_LINE 00000142 "            $v_min++;"
NSQ_SOURCE_LINE 00000143 "        }"
NSQ_SOURCE_LINE 00000144 "        $v_pl = (\"0\" x ($width_pl -length($v_pl))) . $v_pl"
NSQ_SOURCE_LINE 00000145 "    }"
NSQ_SOURCE_LINE 00000146 "    if ($width_min) {"
NSQ_SOURCE_LINE 00000147 "        my $limit = \"1\" . (\"0\" x $width_min);"
NSQ_SOURCE_LINE 00000148 "        $v_min += $inc_min;"
NSQ_SOURCE_LINE 00000149 "        if ($v_min < 0) {"
NSQ_SOURCE_LINE 00000150 "            $v_min += $limit;"
NSQ_SOURCE_LINE 00000151 "            $v_maj--;"
NSQ_SOURCE_LINE 00000152 "        } elsif ($v_min >= $limit) {"
NSQ_SOURCE_LINE 00000153 "            $v_min -= $limit;"
NSQ_SOURCE_LINE 00000154 "            $v_maj++;"
NSQ_SOURCE_LINE 00000155 "        }"
NSQ_SOURCE_LINE 00000156 "        $v_min = (\"0\" x ($width_min -length($v_min))) . $v_min;"
NSQ_SOURCE_LINE 00000157 "    }"
NSQ_SOURCE_LINE 00000158 "    $v_maj += $inc_maj;"
NSQ_SOURCE_LINE 00000159 "    die \"Version subtraction results in negative version ($v - $inc)\""
NSQ_SOURCE_LINE 00000160 "        if $v_maj < 0;"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    $v_maj . ($width_min ? \".$v_min\" : '') . ($width_pl ? \".$v_pl\" : \"\");"
NSQ_SOURCE_LINE 00000163 "}"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "sub add_version {"
NSQ_SOURCE_LINE 00000166 "    _add_or_subtract_version('add', @_);"
NSQ_SOURCE_LINE 00000167 "}"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "sub subtract_version {"
NSQ_SOURCE_LINE 00000170 "    _add_or_subtract_version('subtract', @_);"
NSQ_SOURCE_LINE 00000171 "}"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "1;"
NSQ_SOURCE_LINE 00000174 "# ABSTRACT: Version-number utilities"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "__END__"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=pod"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head1 NAME"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "Version::Util - Version-number utilities"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=head1 VERSION"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "This document describes version 0.732 of Version::Util (from Perl distribution Version-Util), released on 2022-09-22."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "This module provides several convenient functions related to version numbers,"
NSQ_SOURCE_LINE 00000193 "e.g. for comparing them."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "=head2 cmp_version($v1, $v2) => -1|0|1"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "Equivalent to:"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 " version->parse($v1) <=> version->parse($v2)"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=head2 version_eq($v1, $v2) => BOOL"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=head2 version_ne($v1, $v2) => BOOL"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=head2 version_lt($v1, $v2) => BOOL"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head2 version_le($v1, $v2) => BOOL"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=head2 version_gt($v1, $v2) => BOOL"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "=head2 version_ge($v1, $v2) => BOOL"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=head2 version_between($v, $v1, $v2[, $v1b, $v2b, ...]) => BOOL"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=head2 version_in($v, $v1[, $v2, ...]) => BOOL"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=head2 min_version($v1, ...) => $max_v"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=head2 max_version($v1, ...) => $max_v"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=head2 add_version($v, $increment) => $new_v"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "Add C<$increment> to version C<$v>. Both increment and version must match:"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 " /\\Av?\\d{1,3}(?:\\.\\d{1,3}){0,2}\\z/"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "so trial/dev releases like C<v1.2.3_1> are not currently supported. Some"
NSQ_SOURCE_LINE 00000230 "examples:"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 " 0.1 + 0.1 -> 0.2"
NSQ_SOURCE_LINE 00000233 " 0.01 + 0.001 -> 0.011"
NSQ_SOURCE_LINE 00000234 " 0.01 + 0.1 -> 0.11"
NSQ_SOURCE_LINE 00000235 " 0.9 + 0.1 -> 1.0"
NSQ_SOURCE_LINE 00000236 " 0.99 + 0.1 -> 1.09"
NSQ_SOURCE_LINE 00000237 " 1.1.0 + 0.0.1 -> 1.1.1"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=head2 subtract_version($v, $decrement) => $new_v"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "Subtract C<$decrement> from version C<$v>. This is the reverse operation for"
NSQ_SOURCE_LINE 00000242 "C<add_version>."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Will die if the result is negative."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "Please visit the project's homepage at L<https://metacpan.org/release/Version-Util>."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "Source repository is at L<https://github.com/perlancar/perl-Version-Util>."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "L<version>"
NSQ_SOURCE_LINE 00000257 ""
