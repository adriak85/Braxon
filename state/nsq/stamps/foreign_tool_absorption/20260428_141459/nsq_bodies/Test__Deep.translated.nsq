NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "our $LeafWrapper; # to wrap simple values in a test; if not set, shallow()"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "our $DNE = \\\"\";"
NSQ_SOURCE_LINE 00000036 "our $DNE_ADDR = Scalar::Util::refaddr($DNE);"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "# if no sub name is supplied then we use the package name in lower case"
NSQ_SOURCE_LINE 00000039 "my @constructors = ("
NSQ_SOURCE_LINE 00000040 "  All               => \"\","
NSQ_SOURCE_LINE 00000041 "  Any               => \"\","
NSQ_SOURCE_LINE 00000042 "  Array             => \"\","
NSQ_SOURCE_LINE 00000043 "  ArrayEach         => \"array_each\","
NSQ_SOURCE_LINE 00000044 "  ArrayElementsOnly => \"\","
NSQ_SOURCE_LINE 00000045 "  ArrayLength       => \"\","
NSQ_SOURCE_LINE 00000046 "  ArrayLengthOnly   => \"\","
NSQ_SOURCE_LINE 00000047 "  Blessed           => \"\","
NSQ_SOURCE_LINE 00000048 "  Boolean           => \"bool\","
NSQ_SOURCE_LINE 00000049 "  Code              => \"\","
NSQ_SOURCE_LINE 00000050 "  Hash              => \"\","
NSQ_SOURCE_LINE 00000051 "  HashEach          => \"hash_each\","
NSQ_SOURCE_LINE 00000052 "  HashKeys          => \"\","
NSQ_SOURCE_LINE 00000053 "  HashKeysOnly      => \"\","
NSQ_SOURCE_LINE 00000054 "  Ignore            => \"\","
