NSQ_SOURCE_LINE 00000143 "sub import {"
NSQ_SOURCE_LINE 00000144 "  my $self = shift;"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "  my $from_notest = grep {$_ eq '_notest'} @_;"
NSQ_SOURCE_LINE 00000147 "  if ($from_notest) {"
NSQ_SOURCE_LINE 00000148 "      @_ = grep {$_ ne '_notest'} @_;"
NSQ_SOURCE_LINE 00000149 "  } else {"
NSQ_SOURCE_LINE 00000150 "    require Test::Builder;"
NSQ_SOURCE_LINE 00000151 "    $Test = Test::Builder->new;"
NSQ_SOURCE_LINE 00000152 "  }"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "  my @sans_preload = grep {; $_ ne ':preload' } @_;"
NSQ_SOURCE_LINE 00000155 "  if (@_ != @sans_preload) {"
NSQ_SOURCE_LINE 00000156 "    require Test::Deep::All;"
NSQ_SOURCE_LINE 00000157 "    require Test::Deep::Any;"
NSQ_SOURCE_LINE 00000158 "    require Test::Deep::Array;"
NSQ_SOURCE_LINE 00000159 "    require Test::Deep::ArrayEach;"
NSQ_SOURCE_LINE 00000160 "    require Test::Deep::ArrayElementsOnly;"
NSQ_SOURCE_LINE 00000161 "    require Test::Deep::ArrayLength;"
NSQ_SOURCE_LINE 00000162 "    require Test::Deep::ArrayLengthOnly;"
NSQ_SOURCE_LINE 00000163 "    require Test::Deep::Blessed;"
NSQ_SOURCE_LINE 00000164 "    require Test::Deep::Boolean;"
NSQ_SOURCE_LINE 00000165 "    require Test::Deep::Cache::Simple;"
NSQ_SOURCE_LINE 00000166 "    require Test::Deep::Cache;"
NSQ_SOURCE_LINE 00000167 "    require Test::Deep::Class;"
NSQ_SOURCE_LINE 00000168 "    require Test::Deep::Cmp;"
NSQ_SOURCE_LINE 00000169 "    require Test::Deep::Code;"
NSQ_SOURCE_LINE 00000170 "    require Test::Deep::Hash;"
NSQ_SOURCE_LINE 00000171 "    require Test::Deep::HashEach;"
NSQ_SOURCE_LINE 00000172 "    require Test::Deep::HashElements;"
NSQ_SOURCE_LINE 00000173 "    require Test::Deep::HashKeys;"
NSQ_SOURCE_LINE 00000174 "    require Test::Deep::HashKeysOnly;"
NSQ_SOURCE_LINE 00000175 "    require Test::Deep::Ignore;"
NSQ_SOURCE_LINE 00000176 "    require Test::Deep::Isa;"
NSQ_SOURCE_LINE 00000177 "    require Test::Deep::ListMethods;"
NSQ_SOURCE_LINE 00000178 "    require Test::Deep::Methods;"
NSQ_SOURCE_LINE 00000179 "    require Test::Deep::MM;"
NSQ_SOURCE_LINE 00000180 "    require Test::Deep::None;"
NSQ_SOURCE_LINE 00000181 "    require Test::Deep::Number;"
NSQ_SOURCE_LINE 00000182 "    require Test::Deep::Obj;"
NSQ_SOURCE_LINE 00000183 "    require Test::Deep::Ref;"
NSQ_SOURCE_LINE 00000184 "    require Test::Deep::RefType;"
NSQ_SOURCE_LINE 00000185 "    require Test::Deep::Regexp;"
NSQ_SOURCE_LINE 00000186 "    require Test::Deep::RegexpMatches;"
NSQ_SOURCE_LINE 00000187 "    require Test::Deep::RegexpOnly;"
NSQ_SOURCE_LINE 00000188 "    require Test::Deep::RegexpRef;"
NSQ_SOURCE_LINE 00000189 "    require Test::Deep::RegexpRefOnly;"
NSQ_SOURCE_LINE 00000190 "    require Test::Deep::RegexpVersion;"
NSQ_SOURCE_LINE 00000191 "    require Test::Deep::ScalarRef;"
NSQ_SOURCE_LINE 00000192 "    require Test::Deep::ScalarRefOnly;"
NSQ_SOURCE_LINE 00000193 "    require Test::Deep::Set;"
NSQ_SOURCE_LINE 00000194 "    require Test::Deep::Shallow;"
NSQ_SOURCE_LINE 00000195 "    require Test::Deep::Stack;"
NSQ_SOURCE_LINE 00000196 "    require Test::Deep::String;"
NSQ_SOURCE_LINE 00000197 "  }"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "  $self->export_to_level(1, $self, @_);"
NSQ_SOURCE_LINE 00000200 "}"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "# this is ugly, I should never have exported a sub called isa now I"
NSQ_SOURCE_LINE 00000203 "# have to try figure out if the recipient wanted my isa or if a class"
NSQ_SOURCE_LINE 00000204 "# imported us and UNIVERSAL::isa is being called on that class."
NSQ_SOURCE_LINE 00000205 "# Luckily our isa always expects 1 argument and U::isa always expects"
NSQ_SOURCE_LINE 00000206 "# 2, so we can figure out (assuming the caller is not buggy)."
NSQ_SOURCE_LINE 00000207 "sub isa"
NSQ_SOURCE_LINE 00000208 "{"
NSQ_SOURCE_LINE 00000209 "  if (@_ == 1)"
NSQ_SOURCE_LINE 00000210 "  {"
NSQ_SOURCE_LINE 00000211 "    goto &Isa;"
NSQ_SOURCE_LINE 00000212 "  }"
NSQ_SOURCE_LINE 00000213 "  else"
NSQ_SOURCE_LINE 00000214 "  {"
NSQ_SOURCE_LINE 00000215 "    goto &UNIVERSAL::isa;"
NSQ_SOURCE_LINE 00000216 "  }"
NSQ_SOURCE_LINE 00000217 "}"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "sub cmp_deeply"
NSQ_SOURCE_LINE 00000220 "{"
NSQ_SOURCE_LINE 00000221 "  my ($d1, $d2, $name) = @_;"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "  my ($ok, $stack) = cmp_details($d1, $d2);"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "  if (not $Test->ok($ok, $name))"
NSQ_SOURCE_LINE 00000226 "  {"
NSQ_SOURCE_LINE 00000227 "    my $diag = deep_diag($stack);"
NSQ_SOURCE_LINE 00000228 "    $Test->diag($diag);"
NSQ_SOURCE_LINE 00000229 "  }"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "  return $ok;"
NSQ_SOURCE_LINE 00000232 "}"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "sub cmp_details"
NSQ_SOURCE_LINE 00000235 "{"
NSQ_SOURCE_LINE 00000236 "  my ($d1, $d2) = @_;"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "  local $Stack = Test::Deep::Stack->new;"
NSQ_SOURCE_LINE 00000239 "  local $CompareCache = Test::Deep::Cache->new;"
NSQ_SOURCE_LINE 00000240 "  local %WrapCache;"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "  my $ok = descend($d1, $d2);"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "  return ($ok, $Stack);"
NSQ_SOURCE_LINE 00000245 "}"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "sub eq_deeply"
NSQ_SOURCE_LINE 00000248 "{"
NSQ_SOURCE_LINE 00000249 "  my ($d1, $d2) = @_;"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "  my ($ok) = cmp_details($d1, $d2);"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "  return $ok"
NSQ_SOURCE_LINE 00000254 "}"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "sub eq_deeply_cache"
NSQ_SOURCE_LINE 00000257 "{"
NSQ_SOURCE_LINE 00000258 "  # this is like cross between eq_deeply and descend(). It doesn't start"
NSQ_SOURCE_LINE 00000259 "  # with a new $CompareCache but if the comparison fails it will leave"
NSQ_SOURCE_LINE 00000260 "  # $CompareCache as if nothing happened. However, if the comparison"
NSQ_SOURCE_LINE 00000261 "  # succeeds then $CompareCache retains all the new information"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "  # this allows Set and Bag to handle circular refs"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "  my ($d1, $d2, $name) = @_;"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "  local $Stack = Test::Deep::Stack->new;"
NSQ_SOURCE_LINE 00000268 "  $CompareCache->local;"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "  my $ok = descend($d1, $d2);"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "  $CompareCache->finish($ok);"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "  return $ok;"
NSQ_SOURCE_LINE 00000275 "}"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "sub deep_diag"
NSQ_SOURCE_LINE 00000278 "{"
NSQ_SOURCE_LINE 00000279 "  my $stack = shift;"
NSQ_SOURCE_LINE 00000280 "  # ick! incArrow and other things expect the stack has to be visible"
NSQ_SOURCE_LINE 00000281 "  # in a well known place . TODO clean this up"
NSQ_SOURCE_LINE 00000282 "  local $Stack = $stack;"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "  my $where = render_stack('$data', $stack);"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "  confess \"No stack to diagnose\" unless $stack;"
NSQ_SOURCE_LINE 00000287 "  my $last = $stack->getLast;"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "  my $diag;"
NSQ_SOURCE_LINE 00000290 "  my $message;"
NSQ_SOURCE_LINE 00000291 "  my $got;"
NSQ_SOURCE_LINE 00000292 "  my $expected;"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "  my $exp = $last->{exp};"
NSQ_SOURCE_LINE 00000295 "  if (Scalar::Util::blessed($exp))"
NSQ_SOURCE_LINE 00000296 "  {"
NSQ_SOURCE_LINE 00000297 "    if ($exp->can(\"diagnostics\"))"
NSQ_SOURCE_LINE 00000298 "    {"
NSQ_SOURCE_LINE 00000299 "      $diag = $exp->diagnostics($where, $last);"
NSQ_SOURCE_LINE 00000300 "      $diag =~ s/\\n+$/\\n/;"
NSQ_SOURCE_LINE 00000301 "    }"
NSQ_SOURCE_LINE 00000302 "    else"
NSQ_SOURCE_LINE 00000303 "    {"
NSQ_SOURCE_LINE 00000304 "      if ($exp->can(\"diag_message\"))"
NSQ_SOURCE_LINE 00000305 "      {"
NSQ_SOURCE_LINE 00000306 "        $message = $exp->diag_message($where);"
NSQ_SOURCE_LINE 00000307 "      }"
NSQ_SOURCE_LINE 00000308 "    }"
NSQ_SOURCE_LINE 00000309 "  }"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "  if (not defined $diag)"
NSQ_SOURCE_LINE 00000312 "  {"
NSQ_SOURCE_LINE 00000313 "    $got //= $exp->renderGot($last->{got});"
NSQ_SOURCE_LINE 00000314 "    $expected //= $exp->renderExp;"
NSQ_SOURCE_LINE 00000315 "    $message //= \"Compared $where\";"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "    $diag = <<EOM"
NSQ_SOURCE_LINE 00000318 "$message"
NSQ_SOURCE_LINE 00000319 "   got : $got"
NSQ_SOURCE_LINE 00000320 "expect : $expected"
NSQ_SOURCE_LINE 00000321 "EOM"
NSQ_SOURCE_LINE 00000322 "  }"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "  return $diag;"
NSQ_SOURCE_LINE 00000325 "}"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "sub render_val"
NSQ_SOURCE_LINE 00000328 "{"
NSQ_SOURCE_LINE 00000329 "  my $val = shift;"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "  my $rendered;"
NSQ_SOURCE_LINE 00000332 "  if (defined $val)"
NSQ_SOURCE_LINE 00000333 "  {"
NSQ_SOURCE_LINE 00000334 "     $rendered = ref($val) ?"
NSQ_SOURCE_LINE 00000335 "       (Scalar::Util::refaddr($val) eq $DNE_ADDR ?"
NSQ_SOURCE_LINE 00000336 "         \"Does not exist\" :"
NSQ_SOURCE_LINE 00000337 "        overload::StrVal($val)"
NSQ_SOURCE_LINE 00000338 "      ) :"
NSQ_SOURCE_LINE 00000339 "      qq('$val');"
NSQ_SOURCE_LINE 00000340 "  }"
NSQ_SOURCE_LINE 00000341 "  else"
NSQ_SOURCE_LINE 00000342 "  {"
NSQ_SOURCE_LINE 00000343 "    $rendered = \"undef\";"
NSQ_SOURCE_LINE 00000344 "  }"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "  return $rendered;"
NSQ_SOURCE_LINE 00000347 "}"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "sub descend"
NSQ_SOURCE_LINE 00000350 "{"
NSQ_SOURCE_LINE 00000351 "  my ($d1, $d2) = @_;"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "  if (!ref $d1 and !ref $d2)"
NSQ_SOURCE_LINE 00000354 "  {"
NSQ_SOURCE_LINE 00000355 "    # Shortcut comparison for the non-reference case."
NSQ_SOURCE_LINE 00000356 "    if (defined $d1)"
NSQ_SOURCE_LINE 00000357 "    {"
NSQ_SOURCE_LINE 00000358 "      return 1 if defined $d2 and $d1 eq $d2;"
NSQ_SOURCE_LINE 00000359 "    }"
NSQ_SOURCE_LINE 00000360 "    else"
NSQ_SOURCE_LINE 00000361 "    {"
NSQ_SOURCE_LINE 00000362 "      return 1 if !defined $d2;"
NSQ_SOURCE_LINE 00000363 "    }"
NSQ_SOURCE_LINE 00000364 "  }"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "  if (! $Expects and Scalar::Util::blessed($d1) and $d1->isa(\"Test::Deep::Cmp\"))"
NSQ_SOURCE_LINE 00000367 "  {"
NSQ_SOURCE_LINE 00000368 "    my $where = $Stack->render('$data');"
NSQ_SOURCE_LINE 00000369 "    confess \"Found a special comparison in $where\\nYou can only use specials in the expects structure\";"
NSQ_SOURCE_LINE 00000370 "  }"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "  if (ref $d1 and ref $d2)"
NSQ_SOURCE_LINE 00000373 "  {"
NSQ_SOURCE_LINE 00000374 "    # this check is only done when we're comparing 2 expecteds against each"
NSQ_SOURCE_LINE 00000375 "    # other"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "    if ($Expects and Scalar::Util::blessed($d1) and $d1->isa(\"Test::Deep::Cmp\"))"
NSQ_SOURCE_LINE 00000378 "    {"
NSQ_SOURCE_LINE 00000379 "      # check they are the same class"
NSQ_SOURCE_LINE 00000380 "      return 0 unless Test::Deep::blessed(Scalar::Util::blessed($d2))->descend($d1);"
NSQ_SOURCE_LINE 00000381 "      if ($d1->can(\"compare\"))"
NSQ_SOURCE_LINE 00000382 "      {"
NSQ_SOURCE_LINE 00000383 "        return $d1->compare($d2);"
NSQ_SOURCE_LINE 00000384 "      }"
NSQ_SOURCE_LINE 00000385 "    }"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "    my $s1 = Scalar::Util::refaddr($d1);"
NSQ_SOURCE_LINE 00000388 "    my $s2 = Scalar::Util::refaddr($d2);"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "    if ($s1 eq $s2)"
NSQ_SOURCE_LINE 00000391 "    {"
NSQ_SOURCE_LINE 00000392 "      return 1;"
NSQ_SOURCE_LINE 00000393 "    }"
NSQ_SOURCE_LINE 00000394 "    if ($CompareCache->cmp($d1, $d2))"
NSQ_SOURCE_LINE 00000395 "    {"
NSQ_SOURCE_LINE 00000396 "      # we've tried comparing these already so either they turned out to"
NSQ_SOURCE_LINE 00000397 "      # be the same or we must be in a loop and we have to assume they're"
NSQ_SOURCE_LINE 00000398 "      # the same"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "      return 1;"
NSQ_SOURCE_LINE 00000401 "    }"
NSQ_SOURCE_LINE 00000402 "    else"
NSQ_SOURCE_LINE 00000403 "    {"
NSQ_SOURCE_LINE 00000404 "      $CompareCache->add($d1, $d2)"
NSQ_SOURCE_LINE 00000405 "    }"
NSQ_SOURCE_LINE 00000406 "  }"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "  $d2 = wrap($d2);"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "  $Stack->push({exp => $d2, got => $d1});"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "  if (ref($d1) and (Scalar::Util::refaddr($d1) == $DNE_ADDR))"
NSQ_SOURCE_LINE 00000413 "  {"
NSQ_SOURCE_LINE 00000414 "    # whatever it was supposed to be, it didn't exist and so it's an"
NSQ_SOURCE_LINE 00000415 "    # automatic fail"
NSQ_SOURCE_LINE 00000416 "    return 0;"
NSQ_SOURCE_LINE 00000417 "  }"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "  if ($d2->descend($d1))"
NSQ_SOURCE_LINE 00000420 "  {"
NSQ_SOURCE_LINE 00000421 "#    print \"d1 = $d1, d2 = $d2\\nok\\n\";"
NSQ_SOURCE_LINE 00000422 "    $Stack->pop;"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "    return 1;"
NSQ_SOURCE_LINE 00000425 "  }"
NSQ_SOURCE_LINE 00000426 "  else"
NSQ_SOURCE_LINE 00000427 "  {"
NSQ_SOURCE_LINE 00000428 "#    print \"d1 = $d1, d2 = $d2\\nnot ok\\n\";"
NSQ_SOURCE_LINE 00000429 "    return 0;"
NSQ_SOURCE_LINE 00000430 "  }"
NSQ_SOURCE_LINE 00000431 "}"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "sub wrap"
NSQ_SOURCE_LINE 00000434 "{"
NSQ_SOURCE_LINE 00000435 "  my $data = shift;"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "  my $class = Scalar::Util::blessed($data);"
NSQ_SOURCE_LINE 00000438 "  return $data if defined $class and $data->isa(\"Test::Deep::Cmp\");"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "  if (defined $class and $data->can('as_test_deep_cmp')) {"
NSQ_SOURCE_LINE 00000441 "    my $cmp = $data->as_test_deep_cmp;"
NSQ_SOURCE_LINE 00000442 "    return $cmp if $cmp->isa('Test::Deep::Cmp');"
NSQ_SOURCE_LINE 00000443 "    Carp::confess(\"object in expected structure provides as_test_deep_cmp but it did not return a Test::Deep::Cmp\");"
NSQ_SOURCE_LINE 00000444 "  }"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "  my $reftype = _td_reftype($data);"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "  my $cmp;"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "  if($reftype eq '')"
NSQ_SOURCE_LINE 00000451 "  {"
NSQ_SOURCE_LINE 00000452 "    $cmp = $Test::Deep::LeafWrapper"
NSQ_SOURCE_LINE 00000453 "         ? $Test::Deep::LeafWrapper->($data)"
NSQ_SOURCE_LINE 00000454 "         : shallow($data);"
NSQ_SOURCE_LINE 00000455 "  }"
NSQ_SOURCE_LINE 00000456 "  else"
NSQ_SOURCE_LINE 00000457 "  {"
NSQ_SOURCE_LINE 00000458 "    my $addr = Scalar::Util::refaddr($data);"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "    return $WrapCache{$addr} if $WrapCache{$addr};"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "    if($reftype eq 'ARRAY')"
NSQ_SOURCE_LINE 00000463 "    {"
NSQ_SOURCE_LINE 00000464 "      $cmp = array($data);"
NSQ_SOURCE_LINE 00000465 "    }"
NSQ_SOURCE_LINE 00000466 "    elsif($reftype eq 'HASH')"
NSQ_SOURCE_LINE 00000467 "    {"
NSQ_SOURCE_LINE 00000468 "      $cmp = hash($data);"
NSQ_SOURCE_LINE 00000469 "    }"
NSQ_SOURCE_LINE 00000470 "    elsif($reftype eq 'SCALAR' or $reftype eq 'REF')"
NSQ_SOURCE_LINE 00000471 "    {"
NSQ_SOURCE_LINE 00000472 "      $cmp = scalref($data);"
NSQ_SOURCE_LINE 00000473 "    }"
NSQ_SOURCE_LINE 00000474 "    elsif(($reftype eq 'Regexp') or ($reftype eq 'REGEXP'))"
NSQ_SOURCE_LINE 00000475 "    {"
NSQ_SOURCE_LINE 00000476 "      $cmp = regexpref($data);"
NSQ_SOURCE_LINE 00000477 "    }"
NSQ_SOURCE_LINE 00000478 "    else"
NSQ_SOURCE_LINE 00000479 "    {"
NSQ_SOURCE_LINE 00000480 "      $cmp = $Test::Deep::LeafWrapper"
NSQ_SOURCE_LINE 00000481 "           ? $Test::Deep::LeafWrapper->($data)"
NSQ_SOURCE_LINE 00000482 "           : shallow($data);"
NSQ_SOURCE_LINE 00000483 "    }"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "    $WrapCache{$addr} = $cmp;"
NSQ_SOURCE_LINE 00000486 "  }"
NSQ_SOURCE_LINE 00000487 "  return $cmp;"
NSQ_SOURCE_LINE 00000488 "}"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "sub _td_reftype"
NSQ_SOURCE_LINE 00000491 "{"
NSQ_SOURCE_LINE 00000492 "  my $val = shift;"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "  my $reftype = Scalar::Util::reftype($val);"
NSQ_SOURCE_LINE 00000495 "  return '' unless defined $reftype;"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "  return $reftype unless $Test::Deep::RegexpVersion::OldStyle;"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "  my $blessed = Scalar::Util::blessed($val);"
NSQ_SOURCE_LINE 00000500 "  return $reftype unless defined $blessed;"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "  if ($blessed && $blessed eq \"Regexp\" and $reftype eq \"SCALAR\")"
NSQ_SOURCE_LINE 00000503 "  {"
NSQ_SOURCE_LINE 00000504 "    $reftype = \"Regexp\""
NSQ_SOURCE_LINE 00000505 "  }"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "  return $reftype;"
NSQ_SOURCE_LINE 00000508 "}"
NSQ_SOURCE_LINE 00000509 ""
