NSQ_SOURCE_LINE 00000511 "{"
NSQ_SOURCE_LINE 00000512 "  my ($var, $stack) = @_;"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "  return $stack->render($var);"
