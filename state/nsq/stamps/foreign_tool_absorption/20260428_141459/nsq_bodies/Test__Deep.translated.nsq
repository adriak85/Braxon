NSQ_SOURCE_LINE 00000056 "  ListMethods       => \"\","
NSQ_SOURCE_LINE 00000057 "  Methods           => \"\","
NSQ_SOURCE_LINE 00000058 "  None              => \"\","
NSQ_SOURCE_LINE 00000059 "  Number            => \"num\","
NSQ_SOURCE_LINE 00000060 "  Obj               => \"obj_isa\","
NSQ_SOURCE_LINE 00000061 "  RefType           => \"\","
NSQ_SOURCE_LINE 00000062 "  Regexp            => \"re\","
NSQ_SOURCE_LINE 00000063 "  RegexpMatches     => \"\","
NSQ_SOURCE_LINE 00000064 "  RegexpOnly        => \"\","
NSQ_SOURCE_LINE 00000065 "  RegexpRef         => \"\","
NSQ_SOURCE_LINE 00000066 "  RegexpRefOnly     => \"\","
NSQ_SOURCE_LINE 00000067 "  ScalarRef         => \"scalref\","
NSQ_SOURCE_LINE 00000068 "  ScalarRefOnly     => \"\","
NSQ_SOURCE_LINE 00000069 "  Shallow           => \"\","
NSQ_SOURCE_LINE 00000070 "  String            => \"str\","
NSQ_SOURCE_LINE 00000071 ");"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "my @CONSTRUCTORS_FROM_CLASSES;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "while (my ($pkg, $name) = splice @constructors, 0, 2)"
NSQ_SOURCE_LINE 00000076 "{"
NSQ_SOURCE_LINE 00000077 "  $name = lc($pkg) unless $name;"
NSQ_SOURCE_LINE 00000078 "  my $full_pkg = \"Test::Deep::$pkg\";"
NSQ_SOURCE_LINE 00000079 "  my $file = \"$full_pkg.pm\";"
NSQ_SOURCE_LINE 00000080 "  $file =~ s#::#/#g;"
NSQ_SOURCE_LINE 00000081 "  my $sub = sub {"
NSQ_SOURCE_LINE 00000082 "    # We might be in the middle of testing one of the globals that require()"
NSQ_SOURCE_LINE 00000083 "    # overwrites. To simplify test authorship, we'll preserve any existing"
NSQ_SOURCE_LINE 00000084 "    # value."
NSQ_SOURCE_LINE 00000085 "    {"
NSQ_SOURCE_LINE 00000086 "      local $@;"
NSQ_SOURCE_LINE 00000087 "      local $!;"
NSQ_SOURCE_LINE 00000088 "      local $^E;"
NSQ_SOURCE_LINE 00000089 "      require $file;"
NSQ_SOURCE_LINE 00000090 "    }"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    return $full_pkg->new(@_);"
NSQ_SOURCE_LINE 00000093 "  };"
NSQ_SOURCE_LINE 00000094 "  {"
NSQ_SOURCE_LINE 00000095 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000096 "    *{$name} = $sub;"
NSQ_SOURCE_LINE 00000097 "  }"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "  push @CONSTRUCTORS_FROM_CLASSES, $name;"
NSQ_SOURCE_LINE 00000100 "}"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "{"
NSQ_SOURCE_LINE 00000103 "  our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000104 "    descend render_stack cmp_details deep_diag"
NSQ_SOURCE_LINE 00000105 "    true false"
NSQ_SOURCE_LINE 00000106 "  );"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "  our %EXPORT_TAGS;"
NSQ_SOURCE_LINE 00000109 "  $EXPORT_TAGS{preload} = [];"
NSQ_SOURCE_LINE 00000110 "  $EXPORT_TAGS{v0} = ["
NSQ_SOURCE_LINE 00000111 "    qw("
NSQ_SOURCE_LINE 00000112 "      Isa"
NSQ_SOURCE_LINE 00000113 "      blessed"
NSQ_SOURCE_LINE 00000114 "      obj_isa"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "      all any array array_each arrayelementsonly arraylength arraylengthonly"
NSQ_SOURCE_LINE 00000117 "      bag bool cmp_bag cmp_deeply cmp_methods cmp_set code eq_deeply"
NSQ_SOURCE_LINE 00000118 "      hash hash_each hashkeys hashkeysonly ignore isa listmethods methods"
NSQ_SOURCE_LINE 00000119 "      noclass none noneof num re reftype regexpmatches regexponly regexpref"
NSQ_SOURCE_LINE 00000120 "      regexprefonly scalarrefonly scalref set shallow str subbagof subhashof"
NSQ_SOURCE_LINE 00000121 "      subsetof superbagof superhashof supersetof useclass"
NSQ_SOURCE_LINE 00000122 "    )"
NSQ_SOURCE_LINE 00000123 "  ];"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "  $EXPORT_TAGS{v1} = ["
NSQ_SOURCE_LINE 00000126 "    qw("
NSQ_SOURCE_LINE 00000127 "      obj_isa"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "      all any array array_each arrayelementsonly arraylength arraylengthonly"
NSQ_SOURCE_LINE 00000130 "      bag bool cmp_bag cmp_deeply cmp_methods cmp_set code eq_deeply"
NSQ_SOURCE_LINE 00000131 "      hash hash_each hashkeys hashkeysonly ignore listmethods methods"
NSQ_SOURCE_LINE 00000132 "      noclass none noneof num re reftype regexpmatches regexponly regexpref"
NSQ_SOURCE_LINE 00000133 "      regexprefonly scalarrefonly scalref set shallow str subbagof subhashof"
NSQ_SOURCE_LINE 00000134 "      subsetof superbagof superhashof supersetof useclass"
NSQ_SOURCE_LINE 00000135 "    )"
