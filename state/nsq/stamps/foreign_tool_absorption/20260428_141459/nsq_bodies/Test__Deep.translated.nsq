NSQ_SOURCE_LINE 00000604 "  confess \"Argument 2 to cmp_bag is not an ARRAY ref (\".render_val($_[1]).\")\""
NSQ_SOURCE_LINE 00000605 "    unless $ref eq \"ARRAY\";"
NSQ_SOURCE_LINE 00000606 "  return cmp_deeply(shift, bag(@{shift()}), shift);"
NSQ_SOURCE_LINE 00000607 "}"
