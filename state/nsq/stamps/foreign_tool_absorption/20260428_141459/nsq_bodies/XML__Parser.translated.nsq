NSQ_SOURCE_LINE 00000009 "package XML::Parser;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use strict;"
NSQ_SOURCE_LINE 00000012 "use warnings;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our ( $VERSION, $LWP_load_failed );"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "use Carp;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "BEGIN {"
NSQ_SOURCE_LINE 00000019 "    require XML::Parser::Expat;"
NSQ_SOURCE_LINE 00000020 "    $VERSION = '2.58';"
NSQ_SOURCE_LINE 00000021 "    die \"Parser.pm and Expat.pm versions don't match\""
NSQ_SOURCE_LINE 00000022 "      unless $VERSION eq $XML::Parser::Expat::VERSION;"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "$LWP_load_failed = 0;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "sub new {"
NSQ_SOURCE_LINE 00000028 "    my ( $class, %args ) = @_;"
NSQ_SOURCE_LINE 00000029 "    my $style = $args{Style};"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    my $nonexopt = $args{Non_Expat_Options} ||= {};"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    $nonexopt->{Style}             = 1;"
NSQ_SOURCE_LINE 00000034 "    $nonexopt->{Non_Expat_Options} = 1;"
NSQ_SOURCE_LINE 00000035 "    $nonexopt->{Handlers}          = 1;"
NSQ_SOURCE_LINE 00000036 "    $nonexopt->{_HNDL_TYPES}       = 1;"
NSQ_SOURCE_LINE 00000037 "    $nonexopt->{NoLWP}             = 1;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    $args{_HNDL_TYPES}          = {%XML::Parser::Expat::Handler_Setters};"
NSQ_SOURCE_LINE 00000040 "    $args{_HNDL_TYPES}->{Init}  = 1;"
NSQ_SOURCE_LINE 00000041 "    $args{_HNDL_TYPES}->{Final} = 1;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    $args{Handlers} ||= {};"
NSQ_SOURCE_LINE 00000044 "    my $handlers = $args{Handlers};"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    if ( defined($style) ) {"
NSQ_SOURCE_LINE 00000047 "        my $stylepkg = $style;"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "        if ( $stylepkg !~ /::/ ) {"
NSQ_SOURCE_LINE 00000050 "            $stylepkg = \"\\u$style\";"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "            eval {"
NSQ_SOURCE_LINE 00000053 "                my $fullpkg   = \"XML::Parser::Style::$stylepkg\";"
NSQ_SOURCE_LINE 00000054 "                my $stylefile = $fullpkg;"
NSQ_SOURCE_LINE 00000055 "                $stylefile =~ s/::/\\//g;"
NSQ_SOURCE_LINE 00000056 "                require \"$stylefile.pm\";"
NSQ_SOURCE_LINE 00000057 "                $stylepkg = $fullpkg;"
NSQ_SOURCE_LINE 00000058 "            };"
NSQ_SOURCE_LINE 00000059 "            if ($@) {"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "                # fallback to old behaviour"
NSQ_SOURCE_LINE 00000062 "                $stylepkg = \"XML::Parser::$stylepkg\";"
NSQ_SOURCE_LINE 00000063 "            }"
NSQ_SOURCE_LINE 00000064 "        }"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "        foreach my $htype ( keys %{ $args{_HNDL_TYPES} } ) {"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "            # Handlers explicitly given override"
NSQ_SOURCE_LINE 00000069 "            # handlers from the Style package"
NSQ_SOURCE_LINE 00000070 "            unless ( defined( $handlers->{$htype} ) ) {"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "                # A handler in the style package must either have"
NSQ_SOURCE_LINE 00000073 "                # exactly the right case as the type name or a"
NSQ_SOURCE_LINE 00000074 "                # completely lower case version of it."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "                my $hname = \"${stylepkg}::$htype\";"
NSQ_SOURCE_LINE 00000077 "                if ( defined(&$hname) ) {"
NSQ_SOURCE_LINE 00000078 "                    $handlers->{$htype} = \\&$hname;"
NSQ_SOURCE_LINE 00000079 "                    next;"
NSQ_SOURCE_LINE 00000080 "                }"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "                $hname = \"${stylepkg}::\\L$htype\";"
NSQ_SOURCE_LINE 00000083 "                if ( defined(&$hname) ) {"
NSQ_SOURCE_LINE 00000084 "                    $handlers->{$htype} = \\&$hname;"
NSQ_SOURCE_LINE 00000085 "                    next;"
NSQ_SOURCE_LINE 00000086 "                }"
NSQ_SOURCE_LINE 00000087 "            }"
NSQ_SOURCE_LINE 00000088 "        }"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "    unless ( defined( $handlers->{ExternEnt} )"
NSQ_SOURCE_LINE 00000092 "        or defined( $handlers->{ExternEntFin} ) ) {"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "        if ( $args{NoLWP} or $LWP_load_failed ) {"
NSQ_SOURCE_LINE 00000095 "            $handlers->{ExternEnt}    = \\&file_ext_ent_handler;"
NSQ_SOURCE_LINE 00000096 "            $handlers->{ExternEntFin} = \\&file_ext_ent_cleanup;"
NSQ_SOURCE_LINE 00000097 "        }"
NSQ_SOURCE_LINE 00000098 "        else {"
NSQ_SOURCE_LINE 00000099 "            # The following just bootstraps the real LWP external entity"
NSQ_SOURCE_LINE 00000100 "            # handler"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "            $handlers->{ExternEnt} = \\&initial_ext_ent_handler;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "            # No cleanup function available until LWPExternEnt.pl loaded"
NSQ_SOURCE_LINE 00000105 "        }"
NSQ_SOURCE_LINE 00000106 "    }"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "    $args{Pkg} ||= caller;"
NSQ_SOURCE_LINE 00000109 "    bless \\%args, $class;"
NSQ_SOURCE_LINE 00000110 "}    # End of new"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "sub setHandlers {"
NSQ_SOURCE_LINE 00000113 "    my ( $self, @handler_pairs ) = @_;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    croak('Uneven number of arguments to setHandlers method')"
NSQ_SOURCE_LINE 00000116 "      if ( int(@handler_pairs) & 1 );"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    my @ret;"
NSQ_SOURCE_LINE 00000119 "    while (@handler_pairs) {"
NSQ_SOURCE_LINE 00000120 "        my $type    = shift @handler_pairs;"
NSQ_SOURCE_LINE 00000121 "        my $handler = shift @handler_pairs;"
NSQ_SOURCE_LINE 00000122 "        unless ( defined( $self->{_HNDL_TYPES}->{$type} ) ) {"
NSQ_SOURCE_LINE 00000123 "            my @types = sort keys %{ $self->{_HNDL_TYPES} };"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "            croak(\"Unknown Parser handler type: $type\\n Valid types: @types\");"
NSQ_SOURCE_LINE 00000126 "        }"
NSQ_SOURCE_LINE 00000127 "        push( @ret, $type, $self->{Handlers}->{$type} );"
NSQ_SOURCE_LINE 00000128 "        $self->{Handlers}->{$type} = $handler;"
NSQ_SOURCE_LINE 00000129 "    }"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    return @ret;"
NSQ_SOURCE_LINE 00000132 "}"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "sub parse_start {"
NSQ_SOURCE_LINE 00000135 "    my $self          = shift;"
NSQ_SOURCE_LINE 00000136 "    my @expat_options = ();"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "    for my $key ( keys %{$self} ) {"
NSQ_SOURCE_LINE 00000139 "        push( @expat_options, $key, $self->{$key} )"
NSQ_SOURCE_LINE 00000140 "          unless exists $self->{Non_Expat_Options}->{$key};"
NSQ_SOURCE_LINE 00000141 "    }"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    my %handlers = %{ $self->{Handlers} };"
NSQ_SOURCE_LINE 00000144 "    my $init     = delete $handlers{Init};"
NSQ_SOURCE_LINE 00000145 "    my $final    = delete $handlers{Final};"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    my $expatnb = XML::Parser::ExpatNB->new( @expat_options, @_ );"
NSQ_SOURCE_LINE 00000148 "    $expatnb->setHandlers(%handlers);"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "    if (defined($init)) {"
NSQ_SOURCE_LINE 00000151 "        eval { &$init($expatnb) };"
NSQ_SOURCE_LINE 00000152 "        if ($@) {"
NSQ_SOURCE_LINE 00000153 "            $expatnb->release;"
NSQ_SOURCE_LINE 00000154 "            die $@;"
NSQ_SOURCE_LINE 00000155 "        }"
NSQ_SOURCE_LINE 00000156 "    }"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    $expatnb->{_State_} = 1;"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "    $expatnb->{FinalHandler} = $final"
NSQ_SOURCE_LINE 00000161 "      if defined($final);"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    return $expatnb;"
NSQ_SOURCE_LINE 00000164 "}"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "sub parse {"
NSQ_SOURCE_LINE 00000167 "    my $self          = shift;"
NSQ_SOURCE_LINE 00000168 "    my $arg           = shift;"
NSQ_SOURCE_LINE 00000169 "    my @expat_options = ();"
NSQ_SOURCE_LINE 00000170 "    for my $key ( keys %{$self} ) {"
NSQ_SOURCE_LINE 00000171 "        push( @expat_options, $key, $self->{$key} )"
NSQ_SOURCE_LINE 00000172 "          unless exists $self->{Non_Expat_Options}->{$key};"
NSQ_SOURCE_LINE 00000173 "    }"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    my $expat    = XML::Parser::Expat->new( @expat_options, @_ );"
NSQ_SOURCE_LINE 00000176 "    my %handlers = %{ $self->{Handlers} };"
NSQ_SOURCE_LINE 00000177 "    my $init     = delete $handlers{Init};"
NSQ_SOURCE_LINE 00000178 "    my $final    = delete $handlers{Final};"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    $expat->setHandlers(%handlers);"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    if ( $self->{Base} ) {"
NSQ_SOURCE_LINE 00000183 "        $expat->base( $self->{Base} );"
NSQ_SOURCE_LINE 00000184 "    }"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "    if (defined($init)) {"
NSQ_SOURCE_LINE 00000187 "        eval { &$init($expat) };"
NSQ_SOURCE_LINE 00000188 "        if ($@) {"
NSQ_SOURCE_LINE 00000189 "            $expat->release;"
NSQ_SOURCE_LINE 00000190 "            die $@;"
NSQ_SOURCE_LINE 00000191 "        }"
NSQ_SOURCE_LINE 00000192 "    }"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    my @result = ();"
NSQ_SOURCE_LINE 00000195 "    my $result;"
NSQ_SOURCE_LINE 00000196 "    eval { $result = $expat->parse($arg); };"
NSQ_SOURCE_LINE 00000197 "    my $err = $@;"
NSQ_SOURCE_LINE 00000198 "    if ($err) {"
NSQ_SOURCE_LINE 00000199 "        $expat->release;"
NSQ_SOURCE_LINE 00000200 "        die $err;"
NSQ_SOURCE_LINE 00000201 "    }"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    if ( $result and defined($final) ) {"
NSQ_SOURCE_LINE 00000204 "        my $want = wantarray;"
NSQ_SOURCE_LINE 00000205 "        eval {"
NSQ_SOURCE_LINE 00000206 "            if ($want) {"
NSQ_SOURCE_LINE 00000207 "                @result = &$final($expat);"
NSQ_SOURCE_LINE 00000208 "            }"
NSQ_SOURCE_LINE 00000209 "            else {"
NSQ_SOURCE_LINE 00000210 "                $result = &$final($expat);"
NSQ_SOURCE_LINE 00000211 "            }"
NSQ_SOURCE_LINE 00000212 "        };"
NSQ_SOURCE_LINE 00000213 "        $err = $@;"
NSQ_SOURCE_LINE 00000214 "    }"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    $expat->release;"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "    die $err if $err;"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "    return unless defined wantarray;"
NSQ_SOURCE_LINE 00000221 "    return wantarray ? @result : $result;"
NSQ_SOURCE_LINE 00000222 "}"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "sub parsestring {"
NSQ_SOURCE_LINE 00000225 "    my $self = shift;"
NSQ_SOURCE_LINE 00000226 "    $self->parse(@_);"
NSQ_SOURCE_LINE 00000227 "}"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "sub parsefile {"
NSQ_SOURCE_LINE 00000230 "    my $self = shift;"
NSQ_SOURCE_LINE 00000231 "    my $file = shift;"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "    open( my $fh, '<', $file ) or croak \"Couldn't open $file:\\n$!\";"
NSQ_SOURCE_LINE 00000234 "    binmode($fh);"
NSQ_SOURCE_LINE 00000235 "    my @ret;"
NSQ_SOURCE_LINE 00000236 "    my $ret;"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "    my $old_base = $self->{Base};"
NSQ_SOURCE_LINE 00000239 "    $self->{Base} = $file;"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    if (wantarray) {"
NSQ_SOURCE_LINE 00000242 "        eval { @ret = $self->parse( $fh, @_ ); };"
NSQ_SOURCE_LINE 00000243 "    }"
NSQ_SOURCE_LINE 00000244 "    else {"
NSQ_SOURCE_LINE 00000245 "        eval { $ret = $self->parse( $fh, @_ ); };"
NSQ_SOURCE_LINE 00000246 "    }"
NSQ_SOURCE_LINE 00000247 "    my $err = $@;"
NSQ_SOURCE_LINE 00000248 "    $self->{Base} = $old_base;"
NSQ_SOURCE_LINE 00000249 "    close($fh);"
NSQ_SOURCE_LINE 00000250 "    die $err if $err;"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    return unless defined wantarray;"
NSQ_SOURCE_LINE 00000253 "    return wantarray ? @ret : $ret;"
NSQ_SOURCE_LINE 00000254 "}"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "sub initial_ext_ent_handler {"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "    # This just bootstraps in the real lwp_ext_ent_handler which"
NSQ_SOURCE_LINE 00000259 "    # also loads the URI and LWP modules."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "    unless ($LWP_load_failed) {"
NSQ_SOURCE_LINE 00000262 "        my $stat = do {"
NSQ_SOURCE_LINE 00000263 "            no warnings;"
NSQ_SOURCE_LINE 00000264 "            eval { require('XML/Parser/LWPExternEnt.pl'); };"
NSQ_SOURCE_LINE 00000265 "        };"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "        if ($stat) {"
NSQ_SOURCE_LINE 00000268 "            $_[0]->setHandlers("
NSQ_SOURCE_LINE 00000269 "                ExternEnt    => \\&lwp_ext_ent_handler,"
NSQ_SOURCE_LINE 00000270 "                ExternEntFin => \\&lwp_ext_ent_cleanup"
NSQ_SOURCE_LINE 00000271 "            );"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "            goto &lwp_ext_ent_handler;"
NSQ_SOURCE_LINE 00000274 "        }"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "        # Failed to load lwp handler, act as if NoLWP"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "        $LWP_load_failed = 1;"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "        my $cmsg = \"Couldn't load LWP based external entity handler\\n\" . \"Switching to file-based external entity handler\\n\" . \" (To avoid this message, use NoLWP option to XML::Parser)\\n\";"
NSQ_SOURCE_LINE 00000281 "        warn($cmsg);"
NSQ_SOURCE_LINE 00000282 "    }"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    $_[0]->setHandlers("
NSQ_SOURCE_LINE 00000285 "        ExternEnt    => \\&file_ext_ent_handler,"
NSQ_SOURCE_LINE 00000286 "        ExternEntFin => \\&file_ext_ent_cleanup"
NSQ_SOURCE_LINE 00000287 "    );"
NSQ_SOURCE_LINE 00000288 "    goto &file_ext_ent_handler;"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "}"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "sub file_ext_ent_handler {"
NSQ_SOURCE_LINE 00000293 "    my ( $xp, $base, $path ) = @_;"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "    # Prepend base only for relative paths"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "    if ( defined($base)"
NSQ_SOURCE_LINE 00000298 "        and not( $path =~ m!^(?:[\\\\/]|\\w+:)! ) ) {"
NSQ_SOURCE_LINE 00000299 "        my $newpath = $base;"
NSQ_SOURCE_LINE 00000300 "        $newpath =~ s![^\\\\/:]*$!$path!;"
NSQ_SOURCE_LINE 00000301 "        $path = $newpath;"
NSQ_SOURCE_LINE 00000302 "    }"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "    if (   $path =~ /^\\s*[|>+]/"
NSQ_SOURCE_LINE 00000305 "        or $path =~ /\\|\\s*$/ ) {"
NSQ_SOURCE_LINE 00000306 "        $xp->{ErrorMessage} .= \"System ID ($path) contains Perl IO control characters\";"
NSQ_SOURCE_LINE 00000307 "        return undef;"
NSQ_SOURCE_LINE 00000308 "    }"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "    require IO::File;"
NSQ_SOURCE_LINE 00000311 "    my $fh = IO::File->new($path, '<');"
NSQ_SOURCE_LINE 00000312 "    unless ( defined $fh ) {"
NSQ_SOURCE_LINE 00000313 "        $xp->{ErrorMessage} .= \"Failed to open $path:\\n$!\";"
NSQ_SOURCE_LINE 00000314 "        return undef;"
NSQ_SOURCE_LINE 00000315 "    }"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "    $xp->{_BaseStack} ||= [];"
NSQ_SOURCE_LINE 00000318 "    $xp->{_FhStack}   ||= [];"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "    push( @{ $xp->{_BaseStack} }, $base );"
NSQ_SOURCE_LINE 00000321 "    push( @{ $xp->{_FhStack} },   $fh );"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "    $xp->base($path);"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "    return $fh;"
NSQ_SOURCE_LINE 00000326 "}"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "sub file_ext_ent_cleanup {"
NSQ_SOURCE_LINE 00000329 "    my ($xp) = @_;"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "    my $fh = pop( @{ $xp->{_FhStack} } );"
NSQ_SOURCE_LINE 00000332 "    $fh->close;"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "    my $base = pop( @{ $xp->{_BaseStack} } );"
NSQ_SOURCE_LINE 00000335 "    $xp->base($base);"
NSQ_SOURCE_LINE 00000336 "}"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "1;"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "__END__"
