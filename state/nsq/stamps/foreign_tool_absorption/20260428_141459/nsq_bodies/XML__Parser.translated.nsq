NSQ_SOURCE_LINE 00000342 "=for markdown [![Build Status](https://github.com/cpan-authors/XML-Parser/actions/workflows/testsuite.yml/badge.svg)](https://github.com/cpan-authors/XML-Parser/actions/workflows/testsuite.yml) [![Coverage](https://codecov.io/gh/cpan-authors/XML-Parser/graph/badge.svg)](https://codecov.io/gh/cpan-authors/XML-Parser)"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "=head1 NAME"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "XML::Parser - A perl module for parsing XML documents"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "  use XML::Parser;"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "  $p1 = XML::Parser->new(Style => 'Debug');"
NSQ_SOURCE_LINE 00000353 "  $p1->parsefile('REC-xml-19980210.xml');"
NSQ_SOURCE_LINE 00000354 "  $p1->parse('<foo id=\"me\">Hello World</foo>');"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "  # Alternative"
NSQ_SOURCE_LINE 00000357 "  $p2 = XML::Parser->new(Handlers => {Start => \\&handle_start,"
NSQ_SOURCE_LINE 00000358 "                                     End   => \\&handle_end,"
NSQ_SOURCE_LINE 00000359 "                                     Char  => \\&handle_char});"
NSQ_SOURCE_LINE 00000360 "  $p2->parse($socket);"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "  # Another alternative"
NSQ_SOURCE_LINE 00000363 "  $p3 = XML::Parser->new(ErrorContext => 2);"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "  $p3->setHandlers(Char    => \\&text,"
NSQ_SOURCE_LINE 00000366 "                   Default => \\&other);"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "  open(my $fh, 'xmlgenerator |');"
NSQ_SOURCE_LINE 00000369 "  $p3->parse($fh, ProtocolEncoding => 'ISO-8859-1');"
NSQ_SOURCE_LINE 00000370 "  close($fh);"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "  $p3->parsefile('junk.xml', ErrorContext => 3);"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=begin man"
NSQ_SOURCE_LINE 00000375 ".ds PI"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "=end man"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "This module provides ways to parse XML documents. It is built on top of"
NSQ_SOURCE_LINE 00000382 "L<XML::Parser::Expat>, which is a lower level interface to James Clark's"
NSQ_SOURCE_LINE 00000383 "expat library. Each call to one of the parsing methods creates a new"
NSQ_SOURCE_LINE 00000384 "instance of XML::Parser::Expat which is then used to parse the document."
NSQ_SOURCE_LINE 00000385 "Expat options may be provided when the XML::Parser object is created."
NSQ_SOURCE_LINE 00000386 "These options are then passed on to the Expat object on each parse call."
NSQ_SOURCE_LINE 00000387 "They can also be given as extra arguments to the parse methods, in which"
NSQ_SOURCE_LINE 00000388 "case they override options given at XML::Parser creation time."
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "The behavior of the parser is controlled either by C<L</STYLES>> and/or"
NSQ_SOURCE_LINE 00000391 "C<L</HANDLERS>> options, or by L</setHandlers> method. These all provide"
NSQ_SOURCE_LINE 00000392 "mechanisms for XML::Parser to set the handlers needed by XML::Parser::Expat."
NSQ_SOURCE_LINE 00000393 "If neither C<Style> nor C<Handlers> are specified, then parsing just"
NSQ_SOURCE_LINE 00000394 "checks the document for being well-formed."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "When underlying handlers get called, they receive as their first parameter"
NSQ_SOURCE_LINE 00000397 "the I<Expat> object, not the Parser object."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=head1 METHODS"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=over 4"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=item new"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "This is a class method, the constructor for XML::Parser. Options are passed"
NSQ_SOURCE_LINE 00000406 "as keyword value pairs. Recognized options are:"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "=over 4"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "=item * Style"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "This option provides an easy way to create a given style of parser. The"
NSQ_SOURCE_LINE 00000413 "built in styles are: L<\"Debug\">, L<\"Subs\">, L<\"Tree\">, L<\"Objects\">,"
NSQ_SOURCE_LINE 00000414 "and L<\"Stream\">. These are all defined in separate packages under"
NSQ_SOURCE_LINE 00000415 "C<XML::Parser::Style::*>, and you can find further documentation for"
NSQ_SOURCE_LINE 00000416 "each style both below, and in those packages."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "Custom styles can be provided by giving a full package name containing"
NSQ_SOURCE_LINE 00000419 "at least one '::'. This package should then have subs defined for each"
NSQ_SOURCE_LINE 00000420 "handler it wishes to have installed. See L<\"STYLES\"> below"
NSQ_SOURCE_LINE 00000421 "for a discussion of each built in style."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "=item * Handlers"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "When provided, this option should be an anonymous hash containing as"
NSQ_SOURCE_LINE 00000426 "keys the type of handler and as values a sub reference to handle that"
NSQ_SOURCE_LINE 00000427 "type of event. All the handlers get passed as their 1st parameter the"
NSQ_SOURCE_LINE 00000428 "instance of expat that is parsing the document. Further details on"
NSQ_SOURCE_LINE 00000429 "handlers can be found in L<\"HANDLERS\">. Any handler set here"
NSQ_SOURCE_LINE 00000430 "overrides the corresponding handler set with the Style option."
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "=item * Pkg"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "Some styles will refer to subs defined in this package. If not provided,"
NSQ_SOURCE_LINE 00000435 "it defaults to the package which called the constructor."
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=item * ErrorContext"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "This is an Expat option. When this option is defined, errors are reported"
NSQ_SOURCE_LINE 00000440 "in context. The value should be the number of lines to show on either side"
NSQ_SOURCE_LINE 00000441 "of the line in which the error occurred."
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "=item * ProtocolEncoding"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "This is an Expat option. This sets the protocol encoding name. It defaults"
NSQ_SOURCE_LINE 00000446 "to none. The built-in encodings are: C<UTF-8>, C<ISO-8859-1>, C<UTF-16>, and"
NSQ_SOURCE_LINE 00000447 "C<US-ASCII>. Other encodings may be used if they have encoding maps in one"
NSQ_SOURCE_LINE 00000448 "of the directories in the @Encoding_Path list. Check L<\"ENCODINGS\"> for"
NSQ_SOURCE_LINE 00000449 "more information on encoding maps. Setting the protocol encoding overrides"
NSQ_SOURCE_LINE 00000450 "any encoding in the XML declaration."
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "=item * Namespaces"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "This is an Expat option. If this is set to a true value, then namespace"
NSQ_SOURCE_LINE 00000455 "processing is done during the parse. See L<XML::Parser::Expat/\"Namespaces\">"
NSQ_SOURCE_LINE 00000456 "for further discussion of namespace processing."
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "=item * NoExpand"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "This is an Expat option. Normally, the parser will try to expand references"
NSQ_SOURCE_LINE 00000461 "to entities defined in the internal subset. If this option is set to a true"
NSQ_SOURCE_LINE 00000462 "value, and a default handler is also set, then the default handler will be"
NSQ_SOURCE_LINE 00000463 "called when an entity reference is seen in text. This has no effect if a"
NSQ_SOURCE_LINE 00000464 "default handler has not been registered, and it has no effect on the expansion"
NSQ_SOURCE_LINE 00000465 "of entity references inside attribute values."
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "=item * Stream_Delimiter"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "This is an Expat option. It takes a string value. When this string is found"
NSQ_SOURCE_LINE 00000470 "alone on a line while parsing from a stream, then the parse is ended as if it"
NSQ_SOURCE_LINE 00000471 "saw an end of file. The intended use is with a stream of xml documents in a"
NSQ_SOURCE_LINE 00000472 "MIME multipart format. The string should not contain a trailing newline."
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=item * ParseParamEnt"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "This is an Expat option. Unless standalone is set to \"yes\" in the XML"
NSQ_SOURCE_LINE 00000477 "declaration, setting this to a true value allows the external DTD to be read,"
NSQ_SOURCE_LINE 00000478 "and parameter entities to be parsed and expanded."
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "B<Implicit vs explicit parameter entity parsing:> When C<ParseParamEnt> is"
NSQ_SOURCE_LINE 00000481 "not set, parameter entity references (e.g. C<%foo;>) in the internal DTD"
NSQ_SOURCE_LINE 00000482 "subset are passed through to the B<Default> handler as literal text. This is"
NSQ_SOURCE_LINE 00000483 "the mode that XML::Twig and other DTD round-tripping tools rely on."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "When C<ParseParamEnt> is set to a true value, or when a declaration handler"
NSQ_SOURCE_LINE 00000486 "(B<Entity>, B<Element>, or B<Attlist>) is registered, parameter entity parsing"
NSQ_SOURCE_LINE 00000487 "is activated. In this mode, PE references are resolved by expat (via the"
NSQ_SOURCE_LINE 00000488 "B<ExternEnt> handler) and subsequent declarations are routed to their"
NSQ_SOURCE_LINE 00000489 "dedicated declaration handlers instead of the Default handler."
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "=item * NoLWP"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "This option has no effect if the ExternEnt or ExternEntFin handlers are"
NSQ_SOURCE_LINE 00000494 "directly set. Otherwise, if true, it forces the use of a file based external"
NSQ_SOURCE_LINE 00000495 "entity handler."
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "=item * BillionLaughsAttackProtectionMaximumAmplification"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "Sets the maximum amplification factor for the Billion Laughs attack"
NSQ_SOURCE_LINE 00000500 "protection.  See L<\"SECURITY\"> below for details."
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "This is an Expat option."
NSQ_SOURCE_LINE 00000503 "Requires libexpat E<gt>= 2.4.0 built with C<XML_DTD> or C<XML_GE>."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=item * BillionLaughsAttackProtectionActivationThreshold"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "Sets the activation threshold (in bytes) for the Billion Laughs attack"
NSQ_SOURCE_LINE 00000508 "protection.  See L<\"SECURITY\"> below for details."
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "This is an Expat option."
NSQ_SOURCE_LINE 00000511 "Requires libexpat E<gt>= 2.4.0 built with C<XML_DTD> or C<XML_GE>."
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "=item * AllocTrackerMaximumAmplification"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "Sets the maximum amplification factor for the allocation tracker."
NSQ_SOURCE_LINE 00000516 "See L<\"SECURITY\"> below for details."
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "This is an Expat option."
NSQ_SOURCE_LINE 00000519 "Requires libexpat E<gt>= 2.7.2 built with C<XML_DTD> or C<XML_GE>."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "=item * AllocTrackerActivationThreshold"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "Sets the activation threshold (in bytes) for the allocation tracker."
NSQ_SOURCE_LINE 00000524 "See L<\"SECURITY\"> below for details."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "This is an Expat option."
NSQ_SOURCE_LINE 00000527 "Requires libexpat E<gt>= 2.7.2 built with C<XML_DTD> or C<XML_GE>."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=item * ReparseDeferralEnabled"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "Enables or disables reparse deferral, a security mechanism that prevents"
NSQ_SOURCE_LINE 00000532 "certain token-boundary attacks.  See L<\"SECURITY\"> below for details."
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "This is an Expat option."
NSQ_SOURCE_LINE 00000535 "Requires libexpat E<gt>= 2.6.0."
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "=item * Non_Expat_Options"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "If provided, this should be an anonymous hash whose keys are options that"
NSQ_SOURCE_LINE 00000540 "shouldn't be passed to Expat. This should only be of concern to those"
NSQ_SOURCE_LINE 00000541 "subclassing XML::Parser."
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "=back"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "=item  setHandlers(TYPE, HANDLER [, TYPE, HANDLER [...]])"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "This method registers handlers for various parser events. It overrides any"
NSQ_SOURCE_LINE 00000548 "previous handlers registered through the Style or Handler options or through"
NSQ_SOURCE_LINE 00000549 "earlier calls to setHandlers. By providing a false or undefined value as"
NSQ_SOURCE_LINE 00000550 "the handler, the existing handler can be unset."
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "This method returns a list of type, handler pairs corresponding to the"
NSQ_SOURCE_LINE 00000553 "input. The handlers returned are the ones that were in effect prior to"
NSQ_SOURCE_LINE 00000554 "the call."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "See a description of the handler types in L<\"HANDLERS\">."
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "=item parse(SOURCE [, OPT => OPT_VALUE [...]])"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "The SOURCE parameter should either be a string containing the whole XML"
NSQ_SOURCE_LINE 00000561 "document, or it should be an open IO::Handle. Constructor options to"
NSQ_SOURCE_LINE 00000562 "XML::Parser::Expat given as keyword-value pairs may follow the SOURCE"
NSQ_SOURCE_LINE 00000563 "parameter. These override, for this call, any options or attributes passed"
NSQ_SOURCE_LINE 00000564 "through from the XML::Parser instance."
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "A die call is thrown if a parse error occurs. Otherwise it will return 1"
NSQ_SOURCE_LINE 00000567 "or whatever is returned from the B<Final> handler, if one is installed."
NSQ_SOURCE_LINE 00000568 "In other words, what parse may return depends on the style."
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "See L<\"ERROR HANDLING\"> below for how to catch and handle parse errors."
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "=item parsestring"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "This is just an alias for parse for backwards compatibility."
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "=item parsefile(FILE [, OPT => OPT_VALUE [...]])"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "Open FILE for reading, then call parse with the open handle. The file"
NSQ_SOURCE_LINE 00000579 "is closed no matter how parse returns. A die call is thrown if the file"
NSQ_SOURCE_LINE 00000580 "cannot be opened or if a parse error occurs. Returns what parse returns."
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "=item parse_start([ OPT => OPT_VALUE [...]])"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "Create and return a new instance of XML::Parser::ExpatNB. Constructor"
NSQ_SOURCE_LINE 00000585 "options may be provided. If an init handler has been provided, it is"
NSQ_SOURCE_LINE 00000586 "called before returning the ExpatNB object. Documents are parsed by"
NSQ_SOURCE_LINE 00000587 "making incremental calls to the parse_more method of this object, which"
NSQ_SOURCE_LINE 00000588 "takes a string. A single call to the parse_done method of this object,"
NSQ_SOURCE_LINE 00000589 "which takes no arguments, indicates that the document is finished."
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "If there is a final handler installed, it is executed by the parse_done"
NSQ_SOURCE_LINE 00000592 "method before returning and the parse_done method returns whatever is"
NSQ_SOURCE_LINE 00000593 "returned by the final handler."
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "=back"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "=head1 HANDLERS"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "Expat is an event based parser. As the parser recognizes parts of the"
NSQ_SOURCE_LINE 00000600 "document (say the start or end tag for an XML element), then any handlers"
NSQ_SOURCE_LINE 00000601 "registered for that type of an event are called with suitable parameters."
NSQ_SOURCE_LINE 00000602 "All handlers receive an instance of XML::Parser::Expat as their first"
NSQ_SOURCE_LINE 00000603 "argument. See L<XML::Parser::Expat/\"METHODS\"> for a discussion of the"
NSQ_SOURCE_LINE 00000604 "methods that can be called on this object."
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "=head2 Init                (Expat)"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "This is called just before the parsing of the document starts."
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "=head2 Final                (Expat)"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "This is called just after parsing has finished, but only if no errors"
NSQ_SOURCE_LINE 00000613 "occurred during the parse. Parse returns what this returns."
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "=head2 Start                (Expat, Element [, Attr, Val [,...]])"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "This event is generated when an XML start tag is recognized. Element is the"
NSQ_SOURCE_LINE 00000618 "name of the XML element type that is opened with the start tag. The Attr &"
NSQ_SOURCE_LINE 00000619 "Val pairs are generated for each attribute in the start tag."
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "=head2 End                (Expat, Element)"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "This event is generated when an XML end tag is recognized. Note that"
NSQ_SOURCE_LINE 00000624 "an XML empty tag (<foo/>) generates both a start and an end event."
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "=head2 Char                (Expat, String)"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "This event is generated when non-markup is recognized. The non-markup"
NSQ_SOURCE_LINE 00000629 "sequence of characters is in String. A single non-markup sequence of"
NSQ_SOURCE_LINE 00000630 "characters may generate multiple calls to this handler. Whatever the"
NSQ_SOURCE_LINE 00000631 "encoding of the string in the original document, this is given to the"
NSQ_SOURCE_LINE 00000632 "handler in UTF-8."
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "B<Important:> Because the underlying expat library parses in fixed-size"
NSQ_SOURCE_LINE 00000635 "chunks, character data that spans a buffer boundary will arrive as two or"
NSQ_SOURCE_LINE 00000636 "more consecutive Char events. This typically occurs with files larger than"
NSQ_SOURCE_LINE 00000637 "about 32 KiB and is not a bug. To obtain the complete text of an element,"
NSQ_SOURCE_LINE 00000638 "accumulate the strings delivered between Start and End events:"
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "  my $current_text;"
NSQ_SOURCE_LINE 00000641 "  sub start_handler { $current_text = ''; }"
NSQ_SOURCE_LINE 00000642 "  sub char_handler  { $current_text .= $_[1]; }"
NSQ_SOURCE_LINE 00000643 "  sub end_handler   { print \"complete text: $current_text\\n\"; }"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "The Stream style (C<< XML::Parser::Style::Stream >>) already performs this"
NSQ_SOURCE_LINE 00000646 "accumulation automatically."
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "=head2 Proc                (Expat, Target, Data)"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "This event is generated when a processing instruction is recognized."
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "=head2 Comment                (Expat, Data)"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "This event is generated when a comment is recognized."
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "=head2 CdataStart        (Expat)"
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "This is called at the start of a CDATA section."
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "=head2 CdataEnd                (Expat)"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "This is called at the end of a CDATA section."
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "=head2 Default                (Expat, String)"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "This is called for any characters that don't have a registered handler."
NSQ_SOURCE_LINE 00000667 "This includes both characters that are part of markup for which no"
NSQ_SOURCE_LINE 00000668 "events are generated (markup declarations) and characters that"
NSQ_SOURCE_LINE 00000669 "could generate events, but for which no handler has been registered."
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "Whatever the encoding in the original document, the string is returned to"
NSQ_SOURCE_LINE 00000672 "the handler in UTF-8."
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "=head2 Unparsed                (Expat, Entity, Base, Sysid, Pubid, Notation)"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "This is called for a declaration of an unparsed entity. Entity is the name"
NSQ_SOURCE_LINE 00000677 "of the entity. Base is the base to be used for resolving a relative URI."
NSQ_SOURCE_LINE 00000678 "Sysid is the system id. Pubid is the public id. Notation is the notation"
NSQ_SOURCE_LINE 00000679 "name. Base and Pubid may be undefined."
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "=head2 Notation                (Expat, Notation, Base, Sysid, Pubid)"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "This is called for a declaration of notation. Notation is the notation name."
NSQ_SOURCE_LINE 00000684 "Base is the base to be used for resolving a relative URI. Sysid is the system"
NSQ_SOURCE_LINE 00000685 "id. Pubid is the public id. Base, Sysid, and Pubid may all be undefined."
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "=head2 ExternEnt        (Expat, Base, Sysid, Pubid)"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "This is called when an external entity is referenced. Base is the base to be"
NSQ_SOURCE_LINE 00000690 "used for resolving a relative URI. Sysid is the system id. Pubid is the public"
NSQ_SOURCE_LINE 00000691 "id. Base, and Pubid may be undefined."
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "This handler should either return a string, which represents the contents of"
NSQ_SOURCE_LINE 00000694 "the external entity, or return an open filehandle that can be read to obtain"
NSQ_SOURCE_LINE 00000695 "the contents of the external entity, or return undef, which indicates the"
NSQ_SOURCE_LINE 00000696 "external entity couldn't be found and will generate a parse error."
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "If an open filehandle is returned, it must be returned as either a glob"
NSQ_SOURCE_LINE 00000699 "(*FOO) or as a reference to a glob (e.g. an instance of IO::Handle)."
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "A default handler is installed for this event. The default handler is"
NSQ_SOURCE_LINE 00000702 "XML::Parser::lwp_ext_ent_handler unless the NoLWP option was provided with"
NSQ_SOURCE_LINE 00000703 "a true value, otherwise XML::Parser::file_ext_ent_handler is the default"
NSQ_SOURCE_LINE 00000704 "handler for external entities. Even without the NoLWP option, if the"
NSQ_SOURCE_LINE 00000705 "URI or LWP modules are missing, the file based handler ends up being used"
NSQ_SOURCE_LINE 00000706 "after giving a warning on the first external entity reference."
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "The LWP external entity handler will use proxies defined in the environment"
NSQ_SOURCE_LINE 00000709 "(http_proxy, ftp_proxy, etc.)."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "Please note that the LWP external entity handler reads the entire"
NSQ_SOURCE_LINE 00000712 "entity into a string and returns it, where as the file handler opens a"
NSQ_SOURCE_LINE 00000713 "filehandle."
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "Also note that the file external entity handler will likely choke on"
NSQ_SOURCE_LINE 00000716 "absolute URIs or file names that don't fit the conventions of the local"
NSQ_SOURCE_LINE 00000717 "operating system."
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "The expat base method can be used to set a basename for"
NSQ_SOURCE_LINE 00000720 "relative pathnames. If no basename is given, or if the basename is itself"
NSQ_SOURCE_LINE 00000721 "a relative name, then it is relative to the current working directory."
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "=head2 ExternEntFin        (Expat)"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "This is called after parsing an external entity. It's not called unless"
NSQ_SOURCE_LINE 00000726 "an ExternEnt handler is also set. There is a default handler installed"
NSQ_SOURCE_LINE 00000727 "that pairs with the default ExternEnt handler."
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "If you're going to install your own ExternEnt handler, then you should"
NSQ_SOURCE_LINE 00000730 "set (or unset) this handler too."
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "=head2 Entity                (Expat, Name, Val, Sysid, Pubid, Ndata, IsParam)"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "This is called when an entity is declared. For internal entities, the Val"
NSQ_SOURCE_LINE 00000735 "parameter will contain the value and the remaining three parameters will be"
NSQ_SOURCE_LINE 00000736 "undefined. For external entities, the Val parameter will be undefined, the"
NSQ_SOURCE_LINE 00000737 "Sysid parameter will have the system id, the Pubid parameter will have the"
NSQ_SOURCE_LINE 00000738 "public id if it was provided (it will be undefined otherwise), the Ndata"
NSQ_SOURCE_LINE 00000739 "parameter will contain the notation for unparsed entities. If this is a"
NSQ_SOURCE_LINE 00000740 "parameter entity declaration, then the IsParam parameter is true."
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "Note that this handler and the Unparsed handler above overlap. If both are"
NSQ_SOURCE_LINE 00000743 "set, then this handler will not be called for unparsed entities."
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "=head2 Element                (Expat, Name, Model)"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "The element handler is called when an element declaration is found. Name"
NSQ_SOURCE_LINE 00000748 "is the element name, and Model is the content model as an XML::Parser::Content"
NSQ_SOURCE_LINE 00000749 "object. See L<XML::Parser::Expat/\"XML::Parser::ContentModel Methods\">"
NSQ_SOURCE_LINE 00000750 "for methods available for this class."
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "=head2 Attlist                (Expat, Elname, Attname, Type, Default, Fixed)"
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "This handler is called for each attribute in an ATTLIST declaration."
NSQ_SOURCE_LINE 00000755 "So an ATTLIST declaration that has multiple attributes will generate multiple"
NSQ_SOURCE_LINE 00000756 "calls to this handler. The Elname parameter is the name of the element with"
NSQ_SOURCE_LINE 00000757 "which the attribute is being associated. The Attname parameter is the name"
NSQ_SOURCE_LINE 00000758 "of the attribute. Type is the attribute type, given as a string. Default is"
NSQ_SOURCE_LINE 00000759 "the default value, which will either be \"#REQUIRED\", \"#IMPLIED\" or a quoted"
NSQ_SOURCE_LINE 00000760 "string (i.e. the returned string will begin and end with a quote character)."
NSQ_SOURCE_LINE 00000761 "If Fixed is true, then this is a fixed attribute."
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "=head2 Doctype                (Expat, Name, Sysid, Pubid, Internal)"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "This handler is called for DOCTYPE declarations. Name is the document type"
NSQ_SOURCE_LINE 00000766 "name. Sysid is the system id of the document type, if it was provided,"
NSQ_SOURCE_LINE 00000767 "otherwise it's undefined. Pubid is the public id of the document type,"
NSQ_SOURCE_LINE 00000768 "which will be undefined if no public id was given. Internal will be"
NSQ_SOURCE_LINE 00000769 "true or false, indicating whether or not the doctype declaration contains"
NSQ_SOURCE_LINE 00000770 "an internal subset."
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "=head2 * DoctypeFin                (Expat)"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "This handler is called after parsing of the DOCTYPE declaration has finished,"
NSQ_SOURCE_LINE 00000775 "including any internal or external DTD declarations."
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "=head2 XMLDecl                (Expat, Version, Encoding, Standalone)"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "This handler is called for xml declarations. Version is a string containing"
NSQ_SOURCE_LINE 00000780 "the version. Encoding is either undefined or contains an encoding string."
NSQ_SOURCE_LINE 00000781 "Standalone will be either true, false, or undefined if the standalone attribute"
NSQ_SOURCE_LINE 00000782 "is yes, no, or not made respectively."
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "=head1 STYLES"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "=head2 Debug"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "This just prints out the document in outline form. Nothing special is"
NSQ_SOURCE_LINE 00000789 "returned by parse."
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "=head2 Subs"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "Each time an element starts, a sub by that name in the package specified"
NSQ_SOURCE_LINE 00000794 "by the Pkg option is called with the same parameters that the Start"
NSQ_SOURCE_LINE 00000795 "handler gets called with."
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "Each time an element ends, a sub with that name appended with an underscore"
NSQ_SOURCE_LINE 00000798 "(\"_\"), is called with the same parameters that the End handler gets called"
NSQ_SOURCE_LINE 00000799 "with."
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "Nothing special is returned by parse."
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "=head2 Tree"
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "Parse will return a parse tree for the document. Each node in the tree"
NSQ_SOURCE_LINE 00000806 "takes the form of a tag, content pair. Text nodes are represented with"
NSQ_SOURCE_LINE 00000807 "a pseudo-tag of \"0\" and the string that is their content. For elements,"
NSQ_SOURCE_LINE 00000808 "the content is an array reference. The first item in the array is a"
NSQ_SOURCE_LINE 00000809 "(possibly empty) hash reference containing attributes. The remainder of"
NSQ_SOURCE_LINE 00000810 "the array is a sequence of tag-content pairs representing the content"
NSQ_SOURCE_LINE 00000811 "of the element."
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "So for example the result of parsing:"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "  <foo><head id=\"a\">Hello <em>there</em></head><bar>Howdy<ref/></bar>do</foo>"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "would be:"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "             Tag   Content"
NSQ_SOURCE_LINE 00000820 "  =================================================================="
NSQ_SOURCE_LINE 00000821 "  [foo, [{}, head, [{id => \"a\"}, 0, \"Hello \",  em, [{}, 0, \"there\"]],"
NSQ_SOURCE_LINE 00000822 "              bar, [         {}, 0, \"Howdy\",  ref, [{}]],"
NSQ_SOURCE_LINE 00000823 "                0, \"do\""
NSQ_SOURCE_LINE 00000824 "        ]"
NSQ_SOURCE_LINE 00000825 "  ]"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "The root document \"foo\", has 3 children: a \"head\" element, a \"bar\""
NSQ_SOURCE_LINE 00000828 "element and the text \"do\". After the empty attribute hash, these are"
NSQ_SOURCE_LINE 00000829 "represented in it's contents by 3 tag-content pairs."
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "=head2 Objects"
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "This is similar to the Tree style, except that a hash object is created for"
NSQ_SOURCE_LINE 00000834 "each element. The corresponding object will be in the class whose name"
NSQ_SOURCE_LINE 00000835 "is created by appending \"::\" and the element name to the package set with"
NSQ_SOURCE_LINE 00000836 "the Pkg option. Non-markup text will be in the ::Characters class. The"
NSQ_SOURCE_LINE 00000837 "contents of the corresponding object will be in an anonymous array that"
NSQ_SOURCE_LINE 00000838 "is the value of the Kids property for that object."
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "=head2 Stream"
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "This style also uses the Pkg package. If none of the subs that this"
NSQ_SOURCE_LINE 00000843 "style looks for is there, then the effect of parsing with this style is"
NSQ_SOURCE_LINE 00000844 "to print a canonical copy of the document without comments or declarations."
NSQ_SOURCE_LINE 00000845 "All the subs receive as their 1st parameter the Expat instance for the"
NSQ_SOURCE_LINE 00000846 "document they're parsing."
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "It looks for the following routines:"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "=over 4"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "=item * StartDocument"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "Called at the start of the parse ."
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "=item * StartTag"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "Called for every start tag with a second parameter of the element type. The $_"
NSQ_SOURCE_LINE 00000859 "variable will contain a copy of the tag and the %_ variable will contain"
NSQ_SOURCE_LINE 00000860 "attribute values supplied for that element."
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "=item * EndTag"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "Called for every end tag with a second parameter of the element type. The $_"
NSQ_SOURCE_LINE 00000865 "variable will contain a copy of the end tag."
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 "=item * Text"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "Called just before start or end tags with accumulated non-markup text in"
NSQ_SOURCE_LINE 00000870 "the $_ variable."
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "=item * PI"
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "Called for processing instructions. The $_ variable will contain a copy of"
NSQ_SOURCE_LINE 00000875 "the PI and the target and data are sent as 2nd and 3rd parameters"
NSQ_SOURCE_LINE 00000876 "respectively."
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "=item * EndDocument"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "Called at conclusion of the parse."
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "=back"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "=head1 ENCODINGS"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "XML documents may be encoded in character sets other than Unicode as"
NSQ_SOURCE_LINE 00000887 "long as they may be mapped into the Unicode character set. Expat has"
NSQ_SOURCE_LINE 00000888 "further restrictions on encodings. Read the xmlparse.h header file in"
NSQ_SOURCE_LINE 00000889 "the expat distribution to see details on these restrictions."
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "Expat has built-in encodings for: C<UTF-8>, C<ISO-8859-1>, C<UTF-16>, and"
NSQ_SOURCE_LINE 00000892 "C<US-ASCII>. Encodings are set either through the XML declaration"
NSQ_SOURCE_LINE 00000893 "encoding attribute or through the ProtocolEncoding option to XML::Parser"
NSQ_SOURCE_LINE 00000894 "or XML::Parser::Expat."
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "For encodings other than the built-ins, expat calls the function"
NSQ_SOURCE_LINE 00000897 "load_encoding in the Expat package with the encoding name. This function"
NSQ_SOURCE_LINE 00000898 "looks for a file in the path list @XML::Parser::Expat::Encoding_Path, that"
NSQ_SOURCE_LINE 00000899 "matches the lower-cased name with a '.enc' extension. The first one it"
NSQ_SOURCE_LINE 00000900 "finds, it loads."
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "If you wish to build your own encoding maps, check out the XML::Encoding"
NSQ_SOURCE_LINE 00000903 "module from CPAN."
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "=head1 ERROR HANDLING"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "XML::Parser throws an exception (dies) when it encounters a parse error."
NSQ_SOURCE_LINE 00000908 "This includes malformed XML, encoding errors, and other problems detected"
NSQ_SOURCE_LINE 00000909 "by the underlying expat library."
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "The C<parse>, C<parsefile>, and C<parse_done> methods may all throw"
NSQ_SOURCE_LINE 00000912 "exceptions. To handle parse errors gracefully in your application, wrap"
NSQ_SOURCE_LINE 00000913 "the parse call in an C<eval> block:"
NSQ_SOURCE_LINE 00000914 ""
NSQ_SOURCE_LINE 00000915 "  my $parser = XML::Parser->new(Style => 'Tree');"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "  my $tree = eval { $parser->parsefile('data.xml') };"
NSQ_SOURCE_LINE 00000918 "  if ($@) {"
NSQ_SOURCE_LINE 00000919 "    # Handle the parse error"
NSQ_SOURCE_LINE 00000920 "    warn \"Parse failed: $@\";"
NSQ_SOURCE_LINE 00000921 "  }"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "The error message (in C<$@>) will include the line number, column number,"
NSQ_SOURCE_LINE 00000924 "and byte position where the error was detected. For additional context"
NSQ_SOURCE_LINE 00000925 "around the error location, set the B<ErrorContext> option when constructing"
NSQ_SOURCE_LINE 00000926 "the parser:"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "  my $parser = XML::Parser->new("
NSQ_SOURCE_LINE 00000929 "    Style        => 'Tree',"
NSQ_SOURCE_LINE 00000930 "    ErrorContext  => 2,"
NSQ_SOURCE_LINE 00000931 "  );"
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "This will include 2 lines of context on either side of the error in the"
NSQ_SOURCE_LINE 00000934 "error message."
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "=head1 SECURITY"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "XML::Parser relies on the expat C library for parsing. Modern versions of"
NSQ_SOURCE_LINE 00000939 "expat include several security mechanisms that can be tuned through"
NSQ_SOURCE_LINE 00000940 "constructor options passed to C<new()>. These options are forwarded directly"
NSQ_SOURCE_LINE 00000941 "to L<XML::Parser::Expat> and take effect for every subsequent C<parse>,"
NSQ_SOURCE_LINE 00000942 "C<parsefile>, or C<parse_start> call on the parser instance."
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "All of these options will C<croak> at runtime if the underlying libexpat does"
NSQ_SOURCE_LINE 00000945 "not support them."
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "=head2 Billion Laughs Attack Protection"
NSQ_SOURCE_LINE 00000948 ""
NSQ_SOURCE_LINE 00000949 "The Billion Laughs attack (also known as an XML bomb) uses deeply nested"
NSQ_SOURCE_LINE 00000950 "entity definitions to cause exponential expansion, consuming memory and CPU."
NSQ_SOURCE_LINE 00000951 "Expat E<gt>= 2.4.0 (built with C<XML_DTD> or C<XML_GE>) includes built-in"
NSQ_SOURCE_LINE 00000952 "protection controlled by two parameters:"
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "=over 4"
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "=item B<BillionLaughsAttackProtectionMaximumAmplification>"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "The maximum ratio between the size of the expanded output and the size of"
NSQ_SOURCE_LINE 00000959 "the input.  For example, a value of C<100.0> means the parser will abort if"
NSQ_SOURCE_LINE 00000960 "entity expansion would produce output more than 100 times the size of the"
NSQ_SOURCE_LINE 00000961 "input."
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "=item B<BillionLaughsAttackProtectionActivationThreshold>"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "The number of bytes of expanded output before the amplification limit takes"
NSQ_SOURCE_LINE 00000966 "effect.  This prevents false positives on small documents that happen to"
NSQ_SOURCE_LINE 00000967 "have a high amplification ratio."
NSQ_SOURCE_LINE 00000968 ""
NSQ_SOURCE_LINE 00000969 "=back"
NSQ_SOURCE_LINE 00000970 ""
NSQ_SOURCE_LINE 00000971 "=head2 Allocation Tracker"
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "Expat E<gt>= 2.7.2 (built with C<XML_DTD> or C<XML_GE>) adds a second layer"
NSQ_SOURCE_LINE 00000974 "of amplification tracking through the allocation tracker, which measures"
NSQ_SOURCE_LINE 00000975 "memory allocation rather than output size:"
NSQ_SOURCE_LINE 00000976 ""
NSQ_SOURCE_LINE 00000977 "=over 4"
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "=item B<AllocTrackerMaximumAmplification>"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "The maximum ratio of allocated memory to input size."
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 "=item B<AllocTrackerActivationThreshold>"
NSQ_SOURCE_LINE 00000984 ""
NSQ_SOURCE_LINE 00000985 "The number of bytes of allocation before the limit takes effect."
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "=back"
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "=head2 Reparse Deferral"
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "Expat E<gt>= 2.6.0 includes reparse deferral, which prevents attacks that"
NSQ_SOURCE_LINE 00000992 "exploit token boundaries.  Rather than reparsing incomplete tokens"
NSQ_SOURCE_LINE 00000993 "immediately, the parser defers until more input arrives."
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "=over 4"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "=item B<ReparseDeferralEnabled>"
NSQ_SOURCE_LINE 00000998 ""
NSQ_SOURCE_LINE 00000999 "A boolean.  Set to a true value to enable reparse deferral, or C<0> to"
NSQ_SOURCE_LINE 00001000 "disable it."
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "=back"
NSQ_SOURCE_LINE 00001003 ""
NSQ_SOURCE_LINE 00001004 "For full details on each option, see L<XML::Parser::Expat/\"new\">."
NSQ_SOURCE_LINE 00001005 ""
NSQ_SOURCE_LINE 00001006 "  # Example: tighten Billion Laughs limits"
NSQ_SOURCE_LINE 00001007 "  my $parser = XML::Parser->new("
NSQ_SOURCE_LINE 00001008 "    Style => 'Tree',"
NSQ_SOURCE_LINE 00001009 "    BillionLaughsAttackProtectionMaximumAmplification => 50,"
NSQ_SOURCE_LINE 00001010 "    BillionLaughsAttackProtectionActivationThreshold  => 1024,"
NSQ_SOURCE_LINE 00001011 "  );"
NSQ_SOURCE_LINE 00001012 ""
