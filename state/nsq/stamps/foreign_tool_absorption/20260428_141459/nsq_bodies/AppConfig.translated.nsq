NSQ_SOURCE_LINE 00000001 "#============================================================================"
NSQ_SOURCE_LINE 00000002 "#"
NSQ_SOURCE_LINE 00000003 "# AppConfig.pm"
NSQ_SOURCE_LINE 00000004 "#"
NSQ_SOURCE_LINE 00000005 "# Perl5 module for reading and parsing configuration files and command line "
NSQ_SOURCE_LINE 00000006 "# arguments."
NSQ_SOURCE_LINE 00000007 "#"
NSQ_SOURCE_LINE 00000008 "# Written by Andy Wardley <abw@wardley.org>"
NSQ_SOURCE_LINE 00000009 "#"
NSQ_SOURCE_LINE 00000010 "# Copyright (C) 1997-2007 Andy Wardley.  All Rights Reserved."
NSQ_SOURCE_LINE 00000011 "# Copyright (C) 1997,1998 Canon Research Centre Europe Ltd."
NSQ_SOURCE_LINE 00000012 "#=========================================================================="
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "package AppConfig;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "use 5.006;"
NSQ_SOURCE_LINE 00000017 "use strict;"
NSQ_SOURCE_LINE 00000018 "use warnings;"
NSQ_SOURCE_LINE 00000019 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000020 "our $VERSION = '1.71';"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "# variable expansion constants"
NSQ_SOURCE_LINE 00000023 "use constant EXPAND_NONE   => 0;"
NSQ_SOURCE_LINE 00000024 "use constant EXPAND_VAR    => 1;"
NSQ_SOURCE_LINE 00000025 "use constant EXPAND_UID    => 2;"
NSQ_SOURCE_LINE 00000026 "use constant EXPAND_ENV    => 4;"
NSQ_SOURCE_LINE 00000027 "use constant EXPAND_ALL    => EXPAND_VAR | EXPAND_UID | EXPAND_ENV;"
NSQ_SOURCE_LINE 00000028 "use constant EXPAND_WARN   => 8;"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "# argument count types"
NSQ_SOURCE_LINE 00000031 "use constant ARGCOUNT_NONE => 0;"
NSQ_SOURCE_LINE 00000032 "use constant ARGCOUNT_ONE  => 1;"
NSQ_SOURCE_LINE 00000033 "use constant ARGCOUNT_LIST => 2;"
NSQ_SOURCE_LINE 00000034 "use constant ARGCOUNT_HASH => 3;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "# Exporter tagsets"
NSQ_SOURCE_LINE 00000037 "our @EXPAND = qw("
NSQ_SOURCE_LINE 00000038 "    EXPAND_NONE"
NSQ_SOURCE_LINE 00000039 "    EXPAND_VAR"
NSQ_SOURCE_LINE 00000040 "    EXPAND_UID"
NSQ_SOURCE_LINE 00000041 "    EXPAND_ENV "
NSQ_SOURCE_LINE 00000042 "    EXPAND_ALL"
NSQ_SOURCE_LINE 00000043 "    EXPAND_WARN"
NSQ_SOURCE_LINE 00000044 ");"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "our @ARGCOUNT = qw("
NSQ_SOURCE_LINE 00000047 "    ARGCOUNT_NONE"
NSQ_SOURCE_LINE 00000048 "    ARGCOUNT_ONE"
NSQ_SOURCE_LINE 00000049 "    ARGCOUNT_LIST"
NSQ_SOURCE_LINE 00000050 "    ARGCOUNT_HASH"
NSQ_SOURCE_LINE 00000051 ");"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "our @EXPORT_OK   = ( @EXPAND, @ARGCOUNT );"
NSQ_SOURCE_LINE 00000054 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000055 "    expand   => [ @EXPAND   ],"
NSQ_SOURCE_LINE 00000056 "    argcount => [ @ARGCOUNT ],"
NSQ_SOURCE_LINE 00000057 ");"
NSQ_SOURCE_LINE 00000058 "our $AUTOLOAD;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "require AppConfig::State;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000063 "# new(\\%config, @vars)"
NSQ_SOURCE_LINE 00000064 "#"
NSQ_SOURCE_LINE 00000065 "# Module constructor.  All parameters passed are forwarded onto the "
NSQ_SOURCE_LINE 00000066 "# AppConfig::State constructor.  Returns a reference to a newly created "
NSQ_SOURCE_LINE 00000067 "# AppConfig object."
NSQ_SOURCE_LINE 00000068 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "sub new {"
NSQ_SOURCE_LINE 00000071 "    my $class = shift;"
NSQ_SOURCE_LINE 00000072 "    bless {"
NSQ_SOURCE_LINE 00000073 "        STATE => AppConfig::State->new(@_)"
NSQ_SOURCE_LINE 00000074 "    }, $class;"
NSQ_SOURCE_LINE 00000075 "}"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000079 "# file(@files)"
NSQ_SOURCE_LINE 00000080 "#"
NSQ_SOURCE_LINE 00000081 "# The file() method is called to parse configuration files.  An "
NSQ_SOURCE_LINE 00000082 "# AppConfig::File object is instantiated and stored internally for"
NSQ_SOURCE_LINE 00000083 "# use in subsequent calls to file()."
NSQ_SOURCE_LINE 00000084 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub file {"
NSQ_SOURCE_LINE 00000087 "    my $self  = shift;"
NSQ_SOURCE_LINE 00000088 "    my $state = $self->{ STATE };"
NSQ_SOURCE_LINE 00000089 "    my $file;"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "    require AppConfig::File;"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    # create an AppConfig::File object if one isn't defined "
NSQ_SOURCE_LINE 00000094 "    $file = $self->{ FILE } ||= AppConfig::File->new($state);"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    # call on the AppConfig::File object to process files."
NSQ_SOURCE_LINE 00000097 "    $file->parse(@_);"
NSQ_SOURCE_LINE 00000098 "}"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000102 "# args(\\@args)"
NSQ_SOURCE_LINE 00000103 "#"
NSQ_SOURCE_LINE 00000104 "# The args() method is called to parse command line arguments.  An "
NSQ_SOURCE_LINE 00000105 "# AppConfig::Args object is instantiated and then stored internally for"
NSQ_SOURCE_LINE 00000106 "# use in subsequent calls to args()."
NSQ_SOURCE_LINE 00000107 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "sub args {"
NSQ_SOURCE_LINE 00000110 "    my $self  = shift;"
NSQ_SOURCE_LINE 00000111 "    my $state = $self->{ STATE };"
NSQ_SOURCE_LINE 00000112 "    my $args;"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "    require AppConfig::Args;"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    # create an AppConfig::Args object if one isn't defined"
NSQ_SOURCE_LINE 00000117 "    $args = $self->{ ARGS } ||= AppConfig::Args->new($state);"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "    # call on the AppConfig::Args object to process arguments."
NSQ_SOURCE_LINE 00000120 "    $args->parse(shift);"
NSQ_SOURCE_LINE 00000121 "}"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000125 "# getopt(@config, \\@args)"
NSQ_SOURCE_LINE 00000126 "#"
NSQ_SOURCE_LINE 00000127 "# The getopt() method is called to parse command line arguments.  The"
NSQ_SOURCE_LINE 00000128 "# AppConfig::Getopt module is require()'d and an AppConfig::Getopt object"
NSQ_SOURCE_LINE 00000129 "# is created to parse the arguments."
NSQ_SOURCE_LINE 00000130 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "sub getopt {"
NSQ_SOURCE_LINE 00000133 "    my $self  = shift;"
NSQ_SOURCE_LINE 00000134 "    my $state = $self->{ STATE };"
NSQ_SOURCE_LINE 00000135 "    my $getopt;"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    require AppConfig::Getopt;"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    # create an AppConfig::Getopt object if one isn't defined"
NSQ_SOURCE_LINE 00000140 "    $getopt = $self->{ GETOPT } ||= AppConfig::Getopt->new($state);"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "    # call on the AppConfig::Getopt object to process arguments."
NSQ_SOURCE_LINE 00000143 "    $getopt->parse(@_);"
NSQ_SOURCE_LINE 00000144 "}"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000148 "# cgi($query)"
NSQ_SOURCE_LINE 00000149 "#"
NSQ_SOURCE_LINE 00000150 "# The cgi() method is called to parse a CGI query string.  An "
NSQ_SOURCE_LINE 00000151 "# AppConfig::CGI object is instantiated and then stored internally for"
NSQ_SOURCE_LINE 00000152 "# use in subsequent calls to args()."
NSQ_SOURCE_LINE 00000153 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "sub cgi {"
NSQ_SOURCE_LINE 00000156 "    my $self  = shift;"
NSQ_SOURCE_LINE 00000157 "    my $state = $self->{ STATE };"
NSQ_SOURCE_LINE 00000158 "    my $cgi;"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "    require AppConfig::CGI;"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    # create an AppConfig::CGI object if one isn't defined"
NSQ_SOURCE_LINE 00000163 "    $cgi = $self->{ CGI } ||= AppConfig::CGI->new($state);"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "    # call on the AppConfig::CGI object to process a query."
NSQ_SOURCE_LINE 00000166 "    $cgi->parse(shift);"
NSQ_SOURCE_LINE 00000167 "}"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000170 "# AUTOLOAD"
NSQ_SOURCE_LINE 00000171 "#"
NSQ_SOURCE_LINE 00000172 "# Autoload function called whenever an unresolved object method is "
NSQ_SOURCE_LINE 00000173 "# called.  All methods are delegated to the $self->{ STATE } "
NSQ_SOURCE_LINE 00000174 "# AppConfig::State object."
NSQ_SOURCE_LINE 00000175 "#"
NSQ_SOURCE_LINE 00000176 "#------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000179 "    my $self = shift;"
NSQ_SOURCE_LINE 00000180 "    my $method;"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    # splat the leading package name"
NSQ_SOURCE_LINE 00000183 "    ($method = $AUTOLOAD) =~ s/.*:://;"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "    # ignore destructor"
NSQ_SOURCE_LINE 00000186 "    $method eq 'DESTROY' && return;"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "    # delegate method call to AppConfig::State object in $self->{ STATE } "
NSQ_SOURCE_LINE 00000189 "    $self->{ STATE }->$method(@_);"
NSQ_SOURCE_LINE 00000190 "}"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "1;"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "__END__"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=head1 NAME"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "AppConfig - Perl5 module for reading configuration files and parsing command line arguments."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "    use AppConfig;"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "    # create a new AppConfig object"
NSQ_SOURCE_LINE 00000205 "    my $config = AppConfig->new( \\%cfg );"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "    # define a new variable"
NSQ_SOURCE_LINE 00000208 "    $config->define( $varname => \\%varopts );"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    # create/define combined"
NSQ_SOURCE_LINE 00000211 "    my $config = AppConfig->new( \\%cfg, "
NSQ_SOURCE_LINE 00000212 "        $varname => \\%varopts,"
NSQ_SOURCE_LINE 00000213 "        $varname => \\%varopts,"
NSQ_SOURCE_LINE 00000214 "        ..."
NSQ_SOURCE_LINE 00000215 "    );"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "    # set/get the value"
NSQ_SOURCE_LINE 00000218 "    $config->set( $varname, $value );"
NSQ_SOURCE_LINE 00000219 "    $config->get($varname);"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "    # shortcut form"
NSQ_SOURCE_LINE 00000222 "    $config->varname($value);"
NSQ_SOURCE_LINE 00000223 "    $config->varname;"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "    # read configuration file"
NSQ_SOURCE_LINE 00000226 "    $config->file($file);"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "    # parse command line options"
NSQ_SOURCE_LINE 00000229 "    $config->args(\\@args);      # default to \\@ARGV"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "    # advanced command line options with Getopt::Long"
NSQ_SOURCE_LINE 00000232 "    $config->getopt(\\@args);    # default to \\@ARGV"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "    # parse CGI parameters (GET method)"
NSQ_SOURCE_LINE 00000235 "    $config->cgi($query);       # default to $ENV{ QUERY_STRING }"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=head1 OVERVIEW"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "AppConfig is a Perl5 module for managing application configuration "
NSQ_SOURCE_LINE 00000240 "information.  It maintains the state of any number of variables and "
NSQ_SOURCE_LINE 00000241 "provides methods for parsing configuration files, command line "
NSQ_SOURCE_LINE 00000242 "arguments and CGI script parameters."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Variables values may be set via configuration files.  Variables may be "
NSQ_SOURCE_LINE 00000245 "flags (On/Off), take a single value, or take multiple values stored as a"
NSQ_SOURCE_LINE 00000246 "list or hash.  The number of arguments a variable expects is determined"
NSQ_SOURCE_LINE 00000247 "by its configuration when defined."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "    # flags"
NSQ_SOURCE_LINE 00000250 "    verbose "
NSQ_SOURCE_LINE 00000251 "    nohelp"
NSQ_SOURCE_LINE 00000252 "    debug = On"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "    # single value"
NSQ_SOURCE_LINE 00000255 "    home  = /home/abw/"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    # multiple list value"
NSQ_SOURCE_LINE 00000258 "    file = /tmp/file1"
NSQ_SOURCE_LINE 00000259 "    file = /tmp/file2"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "    # multiple hash value"
NSQ_SOURCE_LINE 00000262 "    book  camel = Programming Perl"
NSQ_SOURCE_LINE 00000263 "    book  llama = Learning Perl"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "The '-' prefix can be used to reset a variable to its default value and"
NSQ_SOURCE_LINE 00000266 "the '+' prefix can be used to set it to 1"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "    -verbose"
NSQ_SOURCE_LINE 00000269 "    +debug"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Variable, environment variable and tilde (home directory) expansions"
NSQ_SOURCE_LINE 00000272 "can be applied (selectively, if necessary) to the values read from "
NSQ_SOURCE_LINE 00000273 "configuration files:"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "    home = ~                    # home directory"
NSQ_SOURCE_LINE 00000276 "    nntp = ${NNTPSERVER}        # environment variable"
NSQ_SOURCE_LINE 00000277 "    html = $home/html           # internal variables"
NSQ_SOURCE_LINE 00000278 "    img  = $html/images"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "Configuration files may be arranged in blocks as per the style of Win32 "
NSQ_SOURCE_LINE 00000281 "\"INI\" files."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "    [file]"
NSQ_SOURCE_LINE 00000284 "    site = kfs"
NSQ_SOURCE_LINE 00000285 "    src  = ~/websrc/docs/$site"
NSQ_SOURCE_LINE 00000286 "    lib  = ~/websrc/lib"
NSQ_SOURCE_LINE 00000287 "    dest = ~/public_html/$site"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "    [page]"
NSQ_SOURCE_LINE 00000290 "    header = $lib/header"
NSQ_SOURCE_LINE 00000291 "    footer = $lib/footer"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "You can also use Perl's \"heredoc\" syntax to define a large block of"
NSQ_SOURCE_LINE 00000294 "text in a configuration file."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "    multiline = <<FOOBAR"
NSQ_SOURCE_LINE 00000297 "    line 1"
NSQ_SOURCE_LINE 00000298 "    line 2"
NSQ_SOURCE_LINE 00000299 "    FOOBAR"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "    paths  exe  = \"${PATH}:${HOME}/.bin\""
NSQ_SOURCE_LINE 00000302 "    paths  link = <<'FOO'"
NSQ_SOURCE_LINE 00000303 "    ${LD_LIBARRAY_PATH}:${HOME}/lib"
NSQ_SOURCE_LINE 00000304 "    FOO"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "Variables may also be set by parsing command line arguments."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "    myapp -verbose -site kfs -file f1 -file f2"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "AppConfig provides a simple method (args()) for parsing command line "
NSQ_SOURCE_LINE 00000311 "arguments.  A second method (getopt()) allows more complex argument "
NSQ_SOURCE_LINE 00000312 "processing by delegation to Johan Vroman's Getopt::Long module."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "AppConfig also allows variables to be set by parameters passed to a "
NSQ_SOURCE_LINE 00000315 "CGI script via the URL (GET method)."
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "    http://www.nowhere.com/cgi-bin/myapp?verbose&site=kfs"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=head1 PREREQUISITES"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "AppConfig requires Perl 5.005 or later.  "
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "The L<Getopt::Long> and L<Test::More> modules should be installed."
NSQ_SOURCE_LINE 00000324 "If you are using a recent version of Perl (e.g. 5.8.0) then these"
NSQ_SOURCE_LINE 00000325 "should already be installed."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "=head1 OBTAINING AND INSTALLING THE AppConfig MODULE BUNDLE"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "The AppConfig module bundle is available from CPAN.  As the 'perlmod' "
NSQ_SOURCE_LINE 00000330 "manual page explains:"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "    CPAN stands for the Comprehensive Perl Archive Network."
NSQ_SOURCE_LINE 00000333 "    This is a globally replicated collection of all known Perl"
NSQ_SOURCE_LINE 00000334 "    materials, including hundreds of unbundled modules.  "
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "    [...]"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "    For an up-to-date listing of CPAN sites, see"
NSQ_SOURCE_LINE 00000339 "    http://www.perl.com/perl/ or ftp://ftp.perl.com/perl/ ."
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "Within the CPAN archive, AppConfig is in the category:"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "    12) Option, Argument, Parameter and Configuration File Processing"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "The module is available in the following directories:"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "    /modules/by-module/AppConfig/AppConfig-<version>.tar.gz"
NSQ_SOURCE_LINE 00000348 "    /authors/id/ABW/AppConfig-<version>.tar.gz"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "AppConfig is distributed as a single gzipped tar archive file:"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "    AppConfig-<version>.tar.gz"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "Note that \"<version>\" represents the current AppConfig version"
NSQ_SOURCE_LINE 00000355 "number, of the form \"n.nn\", e.g. \"3.14\".  See the REVISION section"
NSQ_SOURCE_LINE 00000356 "below to determine the current version number for AppConfig."
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "Unpack the archive to create a AppConfig installation directory:"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "    gunzip AppConfig-<version>.tar.gz"
NSQ_SOURCE_LINE 00000361 "    tar xvf AppConfig-<version>.tar"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "'cd' into that directory, make, test and install the modules:"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "    cd AppConfig-<version>"
NSQ_SOURCE_LINE 00000366 "    perl Makefile.PL"
NSQ_SOURCE_LINE 00000367 "    make"
NSQ_SOURCE_LINE 00000368 "    make test"
NSQ_SOURCE_LINE 00000369 "    make install"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "The 't' sub-directory contains a number of test scripts that are run when "
NSQ_SOURCE_LINE 00000372 "a 'make test' is run."
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "The 'make install' will install the module on your system.  You may need "
NSQ_SOURCE_LINE 00000375 "administrator privileges to perform this task.  If you install the module "
NSQ_SOURCE_LINE 00000376 "in a local directory (for example, by executing \"perl Makefile.PL"
NSQ_SOURCE_LINE 00000377 "LIB=~/lib\" in the above - see C<perldoc MakeMaker> for full details), you"
NSQ_SOURCE_LINE 00000378 "will need to ensure that the PERL5LIB environment variable is set to"
NSQ_SOURCE_LINE 00000379 "include the location, or add a line to your scripts explicitly naming the"
NSQ_SOURCE_LINE 00000380 "library location:"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "    use lib '/local/path/to/lib';"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "The 'examples' sub-directory contains some simple examples of using the "
NSQ_SOURCE_LINE 00000385 "AppConfig modules."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "=head2 USING THE AppConfig MODULE"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "To import and use the L<AppConfig> module the following line should "
NSQ_SOURCE_LINE 00000392 "appear in your Perl script:"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "     use AppConfig;"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "To import constants defined by the AppConfig module, specify the name of"
NSQ_SOURCE_LINE 00000397 "one or more of the constant or tag sets as parameters to C<use>:"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "    use AppConfig qw(:expand :argcount);"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "See L<CONSTANT DEFINITIONS> below for more information on the constant"
NSQ_SOURCE_LINE 00000402 "tagsets defined by AppConfig."
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "AppConfig is implemented using object-oriented methods.  A "
NSQ_SOURCE_LINE 00000405 "new AppConfig object is created and initialized using the "
NSQ_SOURCE_LINE 00000406 "new() method.  This returns a reference to a new AppConfig "
NSQ_SOURCE_LINE 00000407 "object."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "    my $config = AppConfig->new();"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "This will create and return a reference to a new AppConfig object."
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "In doing so, the AppConfig object also creates an internal reference"
NSQ_SOURCE_LINE 00000414 "to an AppConfig::State object in which to store variable state.  All "
NSQ_SOURCE_LINE 00000415 "arguments passed into the AppConfig constructor are passed directly"
NSQ_SOURCE_LINE 00000416 "to the AppConfig::State constructor.  "
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "The first (optional) parameter may be a reference to a hash array"
NSQ_SOURCE_LINE 00000419 "containing configuration information.  "
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "    my $config = AppConfig->new( {"
NSQ_SOURCE_LINE 00000422 "            CASE   => 1,"
NSQ_SOURCE_LINE 00000423 "            ERROR  => \\&my_error,"
NSQ_SOURCE_LINE 00000424 "            GLOBAL => { "
NSQ_SOURCE_LINE 00000425 "                    DEFAULT  => \"<unset>\", "
NSQ_SOURCE_LINE 00000426 "                    ARGCOUNT => ARGCOUNT_ONE,"
NSQ_SOURCE_LINE 00000427 "                },"
NSQ_SOURCE_LINE 00000428 "        } );"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "See L<AppConfig::State> for full details of the configuration options"
NSQ_SOURCE_LINE 00000431 "available.  These are, in brief:"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=over 4"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "=item CASE"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "Used to set case sensitivity for variable names (default: off)."
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "=item CREATE"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "Used to indicate that undefined variables should be created automatically"
NSQ_SOURCE_LINE 00000442 "(default: off)."
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "=item GLOBAL "
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "Reference to a hash array of global values used by default when defining "
NSQ_SOURCE_LINE 00000447 "variables.  Valid global values are DEFAULT, ARGCOUNT, EXPAND, VALIDATE"
NSQ_SOURCE_LINE 00000448 "and ACTION."
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "=item PEDANTIC"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "Used to indicate that command line and configuration file parsing routines"
NSQ_SOURCE_LINE 00000453 "should return immediately on encountering an error."
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=item ERROR"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "Used to provide a error handling routine.  Arguments as per printf()."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "=back"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "Subsequent parameters may be variable definitions.  These are passed "
NSQ_SOURCE_LINE 00000462 "to the define() method, described below in L<DEFINING VARIABLES>."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "    my $config = AppConfig->new(\"foo\", \"bar\", \"baz\");"
NSQ_SOURCE_LINE 00000465 "    my $config = AppConfig->new( { CASE => 1 }, qw(foo bar baz) );"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "Note that any unresolved method calls to AppConfig are automatically "
NSQ_SOURCE_LINE 00000468 "delegated to the AppConfig::State object.  In practice, it means that"
NSQ_SOURCE_LINE 00000469 "it is possible to treat the AppConfig object as if it were an "
NSQ_SOURCE_LINE 00000470 "AppConfig::State object:"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "    # create AppConfig"
NSQ_SOURCE_LINE 00000473 "    my $config = AppConfig->new('foo', 'bar');"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "    # methods get passed through to internal AppConfig::State"
NSQ_SOURCE_LINE 00000476 "    $config->foo(100);"
NSQ_SOURCE_LINE 00000477 "    $config->set('bar', 200);"
NSQ_SOURCE_LINE 00000478 "    $config->define('baz');"
NSQ_SOURCE_LINE 00000479 "    $config->baz(300);"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "=head2 DEFINING VARIABLES"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "The C<define()> method (delegated to AppConfig::State) is used to "
NSQ_SOURCE_LINE 00000484 "pre-declare a variable and specify its configuration."
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "    $config->define(\"foo\");"
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "Variables may also be defined directly from the AppConfig new()"
NSQ_SOURCE_LINE 00000489 "constructor."
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "    my $config = AppConfig->new(\"foo\");"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "In both simple examples above, a new variable called \"foo\" is defined.  A "
NSQ_SOURCE_LINE 00000494 "reference to a hash array may also be passed to specify configuration "
NSQ_SOURCE_LINE 00000495 "information for the variable:"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "    $config->define(\"foo\", {"
NSQ_SOURCE_LINE 00000498 "            DEFAULT   => 99,"
NSQ_SOURCE_LINE 00000499 "            ALIAS     => 'metavar1',"
NSQ_SOURCE_LINE 00000500 "        });"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "Configuration items specified in the GLOBAL option to the module "
NSQ_SOURCE_LINE 00000503 "constructor are applied by default when variables are created.  e.g."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "    my $config = AppConfig->new( { "
NSQ_SOURCE_LINE 00000506 "        GLOBAL => {"
NSQ_SOURCE_LINE 00000507 "            DEFAULT  => \"<undef>\","
NSQ_SOURCE_LINE 00000508 "            ARGCOUNT => ARGCOUNT_ONE,"
NSQ_SOURCE_LINE 00000509 "        }"
NSQ_SOURCE_LINE 00000510 "    } );"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "    $config->define(\"foo\");"
NSQ_SOURCE_LINE 00000513 "    $config->define(\"bar\", { ARGCOUNT => ARGCOUNT_NONE } );"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "is equivalent to:"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "    my $config = AppConfig->new();"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "    $config->define( \"foo\", {"
NSQ_SOURCE_LINE 00000520 "        DEFAULT  => \"<undef>\","
NSQ_SOURCE_LINE 00000521 "        ARGCOUNT => ARGCOUNT_ONE,"
NSQ_SOURCE_LINE 00000522 "    } );"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "    $config->define( \"bar\", "
NSQ_SOURCE_LINE 00000525 "        DEFAULT  => \"<undef>\","
NSQ_SOURCE_LINE 00000526 "        ARGCOUNT => ARGCOUNT_NONE,"
NSQ_SOURCE_LINE 00000527 "    } );"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "Multiple variables may be defined in the same call to define()."
NSQ_SOURCE_LINE 00000530 "Configuration hashes for variables can be omitted."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "    $config->define(\"foo\", \"bar\" => { ALIAS = \"boozer\" }, \"baz\");"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "See L<AppConfig::State> for full details of the configuration options"
NSQ_SOURCE_LINE 00000535 "available when defining variables.  These are, in brief:"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "=over "
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "=item DEFAULT"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "The default value for the variable (default: undef)."
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "=item ALIAS"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "One or more (list reference or \"list|like|this\") alternative names for the"
NSQ_SOURCE_LINE 00000546 "variable."
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "=item ARGCOUNT"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "Specifies the number and type of arguments that the variable expects."
NSQ_SOURCE_LINE 00000551 "Constants in C<:expand> tag set define ARGCOUNT_NONE - simple on/off flag"
NSQ_SOURCE_LINE 00000552 "(default), ARGCOUNT_ONE - single value, ARGCOUNT_LIST - multiple values"
NSQ_SOURCE_LINE 00000553 "accessed via list reference, ARGCOUNT_HASH - hash table, \"key=value\","
NSQ_SOURCE_LINE 00000554 "accessed via hash reference."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "=item ARGS "
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "Used to provide an argument specification string to pass to Getopt::Long "
NSQ_SOURCE_LINE 00000559 "via AppConfig::Getopt.  E.g. \"=i\", \":s\", \"=s@\".  This can also be used to "
NSQ_SOURCE_LINE 00000560 "implicitly set the ARGCOUNT value (C</^!/> = ARGCOUNT_NONE, C</@/> = "
NSQ_SOURCE_LINE 00000561 "ARGCOUNT_LIST, C</%/> = ARGCOUNT_HASH, C</[=:].*/> = ARGCOUNT_ONE)"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "=item EXPAND"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "Specifies which variable expansion policies should be used when parsing "
NSQ_SOURCE_LINE 00000566 "configuration files.  Constants in C<:expand> tag set define:"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "    EXPAND_NONE - no expansion (default) "
NSQ_SOURCE_LINE 00000569 "    EXPAND_VAR  - expand C<$var> or C<$(var)> as other variables"
NSQ_SOURCE_LINE 00000570 "    EXPAND_UID  - expand C<~> and C<~uid> as user's home directory "
NSQ_SOURCE_LINE 00000571 "    EXPAND_ENV - expand C<${var}> as environment variable"
NSQ_SOURCE_LINE 00000572 "    EXPAND_ALL - do all expansions. "
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "=item VALIDATE"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "Regex which the intended variable value should match or code reference "
NSQ_SOURCE_LINE 00000577 "which returns 1 to indicate successful validation (variable may now be set)."
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "=item ACTION"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "Code reference to be called whenever variable value changes."
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "=back"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "=head2 COMPACT FORMAT DEFINITION"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "Variables can be specified using a compact format.  This is identical to "
NSQ_SOURCE_LINE 00000588 "the specification format of Getopt::Long and is of the form:"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "    \"name|alias|alias<argopts>\""
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "The first element indicates the variable name and subsequent ALIAS "
NSQ_SOURCE_LINE 00000593 "values may be added, each separated by a vertical bar '|'."
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "The E<lt>argoptsE<gt> element indicates the ARGCOUNT value and may be one of "
NSQ_SOURCE_LINE 00000596 "the following;"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "    !                  ARGCOUNT_NONE"
NSQ_SOURCE_LINE 00000599 "    =s                 ARGCOUNT_ONE"
NSQ_SOURCE_LINE 00000600 "    =s@                ARGCOUNT_LIST"
NSQ_SOURCE_LINE 00000601 "    =s%                ARGCOUNT_HASH"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "Additional constructs supported by Getopt::Long may be specified instead"
NSQ_SOURCE_LINE 00000604 "of the \"=s\" element (e.g. \"=f\").  The entire E<lt>argoptsE<gt> element "
NSQ_SOURCE_LINE 00000605 "is stored in the ARGS parameter for the variable and is passed intact to "
NSQ_SOURCE_LINE 00000606 "Getopt::Long when the getopt() method is called.  "
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "The following examples demonstrate use of the compact format, with their"
NSQ_SOURCE_LINE 00000609 "equivalent full specifications:"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "    $config->define(\"foo|bar|baz!\");"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "    $config->define("
NSQ_SOURCE_LINE 00000614 "            \"foo\" => { "
NSQ_SOURCE_LINE 00000615 "                ALIAS    => \"bar|baz\", "
NSQ_SOURCE_LINE 00000616 "                ARGCOUNT => ARGCOUNT_NONE,"
NSQ_SOURCE_LINE 00000617 "            });"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "    $config->define(\"name=s\");"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "    $config->define("
NSQ_SOURCE_LINE 00000622 "            \"name\" => { "
NSQ_SOURCE_LINE 00000623 "                ARGCOUNT => ARGCOUNT_ONE,"
NSQ_SOURCE_LINE 00000624 "            });"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "    $config->define(\"file|filelist|f=s@\");"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "    $config->define("
NSQ_SOURCE_LINE 00000629 "            \"file\" => { "
NSQ_SOURCE_LINE 00000630 "                ALIAS    => \"filelist|f\", "
NSQ_SOURCE_LINE 00000631 "                ARGCOUNT => ARGCOUNT_LIST,"
NSQ_SOURCE_LINE 00000632 "            });"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "    $config->define(\"user|u=s%\");"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "    $config->define("
NSQ_SOURCE_LINE 00000637 "            \"user\" => { "
NSQ_SOURCE_LINE 00000638 "                ALIAS    => \"u\", "
NSQ_SOURCE_LINE 00000639 "                ARGCOUNT => ARGCOUNT_HASH,"
NSQ_SOURCE_LINE 00000640 "            });"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "Additional configuration options may be specified by hash reference, as per "
NSQ_SOURCE_LINE 00000643 "normal.  The compact definition format will override any configuration "
NSQ_SOURCE_LINE 00000644 "values provided for ARGS and ARGCOUNT."
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "    $config->define(\"file|filelist|f=s@\", { VALIDATE => \\&check_file } );"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "=head2 READING AND MODIFYING VARIABLE VALUES"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "AppConfig defines two methods (via AppConfig::State) to manipulate variable "
NSQ_SOURCE_LINE 00000651 "values"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "    set($variable, $value);"
NSQ_SOURCE_LINE 00000654 "    get($variable);"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "Once defined, variables may be accessed directly as object methods where"
NSQ_SOURCE_LINE 00000657 "the method name is the same as the variable name.  i.e."
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "    $config->set(\"verbose\", 1);"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "is equivalent to "
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "    $config->verbose(1); "
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "Note that AppConfig defines the following methods:"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "    new();"
NSQ_SOURCE_LINE 00000668 "    file();"
NSQ_SOURCE_LINE 00000669 "    args();"
NSQ_SOURCE_LINE 00000670 "    getopt();"
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "And also, through delegation to AppConfig::State:"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "    define()"
NSQ_SOURCE_LINE 00000675 "    get()"
NSQ_SOURCE_LINE 00000676 "    set()"
NSQ_SOURCE_LINE 00000677 "    varlist()"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "If you define a variable with one of the above names, you will not be able"
NSQ_SOURCE_LINE 00000680 "to access it directly as an object method.  i.e."
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "    $config->file();"
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "This will call the file() method, instead of returning the value of the "
NSQ_SOURCE_LINE 00000685 "'file' variable.  You can work around this by explicitly calling get() and "
NSQ_SOURCE_LINE 00000686 "set() on a variable whose name conflicts:"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "    $config->get('file');"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "or by defining a \"safe\" alias by which the variable can be accessed:"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "    $config->define(\"file\", { ALIAS => \"fileopt\" });"
NSQ_SOURCE_LINE 00000693 "or"
NSQ_SOURCE_LINE 00000694 "    $config->define(\"file|fileopt\");"
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "    ..."
NSQ_SOURCE_LINE 00000697 "    $config->fileopt();"
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "Without parameters, the current value of the variable is returned.  If"
NSQ_SOURCE_LINE 00000700 "a parameter is specified, the variable is set to that value and the "
NSQ_SOURCE_LINE 00000701 "result of the set() operation is returned."
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "    $config->age(29);        # sets 'age' to 29, returns 1 (ok)"
NSQ_SOURCE_LINE 00000704 "    print $config->age();    # prints \"29\""
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "The varlist() method can be used to extract a number of variables into"
NSQ_SOURCE_LINE 00000707 "a hash array.  The first parameter should be a regular expression "
NSQ_SOURCE_LINE 00000708 "used for matching against the variable names. "
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "    my %vars = $config->varlist(\"^file\");   # all \"file*\" variables"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "A second parameter may be specified (any true value) to indicate that "
NSQ_SOURCE_LINE 00000713 "the part of the variable name matching the regex should be removed "
NSQ_SOURCE_LINE 00000714 "when copied to the target hash."
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "    $config->file_name(\"/tmp/file\");"
NSQ_SOURCE_LINE 00000717 "    $config->file_path(\"/foo:/bar:/baz\");"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "    my %vars = $config->varlist(\"^file_\", 1);"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "    # %vars:"
NSQ_SOURCE_LINE 00000722 "    #    name => /tmp/file"
NSQ_SOURCE_LINE 00000723 "    #    path => \"/foo:/bar:/baz\""
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "=head2 READING CONFIGURATION FILES"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "The AppConfig module provides a streamlined interface for reading "
NSQ_SOURCE_LINE 00000729 "configuration files with the AppConfig::File module.  The file() method"
NSQ_SOURCE_LINE 00000730 "automatically loads the AppConfig::File module and creates an object "
NSQ_SOURCE_LINE 00000731 "to process the configuration file or files.  Variables stored in the "
NSQ_SOURCE_LINE 00000732 "internal AppConfig::State are automatically updated with values specified "
NSQ_SOURCE_LINE 00000733 "in the configuration file.  "
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "    $config->file($filename);"
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "Multiple files may be passed to file() and should indicate the file name "
NSQ_SOURCE_LINE 00000738 "or be a reference to an open file handle or glob."
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "    $config->file($filename, $filehandle, \\*STDIN, ...);"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "The file may contain blank lines and comments (prefixed by '#') which "
NSQ_SOURCE_LINE 00000743 "are ignored.  Continutation lines may be marked by ending the line with "
NSQ_SOURCE_LINE 00000744 "a '\\'."
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "    # this is a comment"
NSQ_SOURCE_LINE 00000747 "    callsign = alpha bravo camel delta echo foxtrot golf hipowls \\"
NSQ_SOURCE_LINE 00000748 "               india juliet kilo llama mike november oscar papa  \\"
NSQ_SOURCE_LINE 00000749 "               quebec romeo sierra tango umbrella victor whiskey \\"
NSQ_SOURCE_LINE 00000750 "               x-ray yankee zebra"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "Variables that are simple flags and do not expect an argument (ARGCOUNT = "
NSQ_SOURCE_LINE 00000753 "ARGCOUNT_NONE) can be specified without any value.  They will be set with "
NSQ_SOURCE_LINE 00000754 "the value 1, with any value explicitly specified (except \"0\" and \"off\")"
NSQ_SOURCE_LINE 00000755 "being ignored.  The variable may also be specified with a \"no\" prefix to "
NSQ_SOURCE_LINE 00000756 "implicitly set the variable to 0."
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "    verbose                              # on  (1)"
NSQ_SOURCE_LINE 00000759 "    verbose = 1                          # on  (1)"
NSQ_SOURCE_LINE 00000760 "    verbose = 0                          # off (0)"
NSQ_SOURCE_LINE 00000761 "    verbose off                          # off (0)"
NSQ_SOURCE_LINE 00000762 "    verbose on                           # on  (1)"
NSQ_SOURCE_LINE 00000763 "    verbose mumble                       # on  (1)"
NSQ_SOURCE_LINE 00000764 "    noverbose                            # off (0)"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "Variables that expect an argument (ARGCOUNT = ARGCOUNT_ONE) will be set to "
NSQ_SOURCE_LINE 00000767 "whatever follows the variable name, up to the end of the current line "
NSQ_SOURCE_LINE 00000768 "(including any continuation lines).  An optional equals sign may be inserted "
NSQ_SOURCE_LINE 00000769 "between the variable and value for clarity."
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "    room = /home/kitchen     "
NSQ_SOURCE_LINE 00000772 "    room   /home/bedroom"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "Each subsequent re-definition of the variable value overwrites the previous"
NSQ_SOURCE_LINE 00000775 "value."
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "    print $config->room();               # prints \"/home/bedroom\""
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "Variables may be defined to accept multiple values (ARGCOUNT = ARGCOUNT_LIST)."
NSQ_SOURCE_LINE 00000780 "Each subsequent definition of the variable adds the value to the list of"
NSQ_SOURCE_LINE 00000781 "previously set values for the variable.  "
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "    drink = coffee"
NSQ_SOURCE_LINE 00000784 "    drink = tea"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "A reference to a list of values is returned when the variable is requested."
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "    my $beverages = $config->drink();"
NSQ_SOURCE_LINE 00000789 "    print join(\", \", @$beverages);      # prints \"coffee, tea\""
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "Variables may also be defined as hash lists (ARGCOUNT = ARGCOUNT_HASH)."
NSQ_SOURCE_LINE 00000792 "Each subsequent definition creates a new key and value in the hash array."
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "    alias l=\"ls -CF\""
NSQ_SOURCE_LINE 00000795 "    alias e=\"emacs\""
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "A reference to the hash is returned when the variable is requested."
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "    my $aliases = $config->alias();"
NSQ_SOURCE_LINE 00000800 "    foreach my $k (keys %$aliases) {"
NSQ_SOURCE_LINE 00000801 "        print \"$k => $aliases->{ $k }\\n\";"
NSQ_SOURCE_LINE 00000802 "    }"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "The '-' prefix can be used to reset a variable to its default value and"
NSQ_SOURCE_LINE 00000805 "the '+' prefix can be used to set it to 1"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "    -verbose"
NSQ_SOURCE_LINE 00000808 "    +debug"
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "=head2 VARIABLE EXPANSION"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "Variable values may contain references to other AppConfig variables, "
NSQ_SOURCE_LINE 00000813 "environment variables and/or users' home directories.  These will be "
NSQ_SOURCE_LINE 00000814 "expanded depending on the EXPAND value for each variable or the GLOBAL"
NSQ_SOURCE_LINE 00000815 "EXPAND value."
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "Three different expansion types may be applied:"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "    bin = ~/bin          # expand '~' to home dir if EXPAND_UID"
NSQ_SOURCE_LINE 00000820 "    tmp = ~abw/tmp       # as above, but home dir for user 'abw'"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "    perl = $bin/perl     # expand value of 'bin' variable if EXPAND_VAR"
NSQ_SOURCE_LINE 00000823 "    ripl = $(bin)/ripl   # as above with explicit parens"
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "    home = ${HOME}       # expand HOME environment var if EXPAND_ENV"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "See L<AppConfig::State> for more information on expanding variable values."
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "The configuration files may have variables arranged in blocks.  A block "
NSQ_SOURCE_LINE 00000830 "header, consisting of the block name in square brackets, introduces a "
NSQ_SOURCE_LINE 00000831 "configuration block.  The block name and an underscore are then prefixed "
NSQ_SOURCE_LINE 00000832 "to the names of all variables subsequently referenced in that block.  The "
NSQ_SOURCE_LINE 00000833 "block continues until the next block definition or to the end of the current "
NSQ_SOURCE_LINE 00000834 "file."
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "    [block1]"
NSQ_SOURCE_LINE 00000837 "    foo = 10             # block1_foo = 10"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "    [block2]"
NSQ_SOURCE_LINE 00000840 "    foo = 20             # block2_foo = 20"
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "=head2 PARSING COMMAND LINE OPTIONS"
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "There are two methods for processing command line options.  The first, "
NSQ_SOURCE_LINE 00000845 "args(), is a small and efficient implementation which offers basic "
NSQ_SOURCE_LINE 00000846 "functionality.  The second, getopt(), offers a more powerful and complete"
NSQ_SOURCE_LINE 00000847 "facility by delegating the task to Johan Vroman's Getopt::Long module.  "
NSQ_SOURCE_LINE 00000848 "The trade-off between args() and getopt() is essentially one of speed/size"
NSQ_SOURCE_LINE 00000849 "against flexibility.  Use as appropriate.  Both implement on-demand loading "
NSQ_SOURCE_LINE 00000850 "of modules and incur no overhead until used.  "
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "The args() method is used to parse simple command line options.  It"
NSQ_SOURCE_LINE 00000853 "automatically loads the AppConfig::Args module and creates an object "
NSQ_SOURCE_LINE 00000854 "to process the command line arguments.  Variables stored in the internal"
NSQ_SOURCE_LINE 00000855 "AppConfig::State are automatically updated with values specified in the "
NSQ_SOURCE_LINE 00000856 "arguments.  "
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "The method should be passed a reference to a list of arguments to parse."
NSQ_SOURCE_LINE 00000859 "The @ARGV array is used if args() is called without parameters."
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "    $config->args(\\@myargs);"
NSQ_SOURCE_LINE 00000862 "    $config->args();               # uses @ARGV"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "Arguments are read and shifted from the array until the first is"
NSQ_SOURCE_LINE 00000865 "encountered that is not prefixed by '-' or '--'.  At that point, the"
NSQ_SOURCE_LINE 00000866 "method returns 1 to indicate success, leaving any unprocessed arguments"
NSQ_SOURCE_LINE 00000867 "remaining in the list."
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "Each argument should be the name or alias of a variable prefixed by "
NSQ_SOURCE_LINE 00000870 "'-' or '--'.  Arguments that are not prefixed as such (and are not an"
NSQ_SOURCE_LINE 00000871 "additional parameter to a previous argument) will cause a warning to be"
NSQ_SOURCE_LINE 00000872 "raised.  If the PEDANTIC option is set, the method will return 0 "
NSQ_SOURCE_LINE 00000873 "immediately.  With PEDANTIC unset (default), the method will continue"
NSQ_SOURCE_LINE 00000874 "to parse the rest of the arguments, returning 0 when done."
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "If the variable is a simple flag (ARGCOUNT = ARGCOUNT_NONE)"
NSQ_SOURCE_LINE 00000877 "then it is set to the value 1.  The variable may be prefixed by \"no\" to"
NSQ_SOURCE_LINE 00000878 "set its value to 0."
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "    myprog -verbose --debug -notaste     # $config->verbose(1)"
NSQ_SOURCE_LINE 00000881 "                                         # $config->debug(1)"
NSQ_SOURCE_LINE 00000882 "                                         # $config->taste(0)"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "Variables that expect an additional argument (ARGCOUNT != 0) will be set to "
NSQ_SOURCE_LINE 00000885 "the value of the argument following it.  "
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "    myprog -f /tmp/myfile                # $config->file('/tmp/file');"
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "Variables that expect multiple values (ARGCOUNT = ARGCOUNT_LIST or"
NSQ_SOURCE_LINE 00000890 "ARGCOUNT_HASH) will have successive values added each time the option"
NSQ_SOURCE_LINE 00000891 "is encountered."
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "    myprog -file /tmp/foo -file /tmp/bar # $config->file('/tmp/foo')"
NSQ_SOURCE_LINE 00000894 "                                         # $config->file('/tmp/bar')"
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "    # file => [ '/tmp/foo', '/tmp/bar' ]"
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "    myprog -door \"jim=Jim Morrison\" -door \"ray=Ray Manzarek\""
NSQ_SOURCE_LINE 00000899 "                                    # $config->door(\"jim=Jim Morrison\");"
NSQ_SOURCE_LINE 00000900 "                                    # $config->door(\"ray=Ray Manzarek\");"
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "    # door => { 'jim' => 'Jim Morrison', 'ray' => 'Ray Manzarek' }"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "See L<AppConfig::Args> for further details on parsing command line"
NSQ_SOURCE_LINE 00000905 "arguments."
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "The getopt() method provides a way to use the power and flexibility of"
NSQ_SOURCE_LINE 00000908 "the Getopt::Long module to parse command line arguments and have the "
NSQ_SOURCE_LINE 00000909 "internal values of the AppConfig object updates automatically."
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "The first (non-list reference) parameters may contain a number of "
NSQ_SOURCE_LINE 00000912 "configuration string to pass to Getopt::Long::Configure.  A reference "
NSQ_SOURCE_LINE 00000913 "to a list of arguments may additionally be passed or @ARGV is used by "
NSQ_SOURCE_LINE 00000914 "default."
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "    $config->getopt();                       # uses @ARGV"
NSQ_SOURCE_LINE 00000917 "    $config->getopt(\\@myargs);"
NSQ_SOURCE_LINE 00000918 "    $config->getopt(qw(auto_abbrev debug));  # uses @ARGV"
NSQ_SOURCE_LINE 00000919 "    $config->getopt(qw(debug), \\@myargs);"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "See Getopt::Long for details of the configuration options available."
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "The getopt() method constructs a specification string for each internal"
NSQ_SOURCE_LINE 00000924 "variable and then initializes Getopt::Long with these values.  The"
NSQ_SOURCE_LINE 00000925 "specification string is constructed from the name, any aliases (delimited"
NSQ_SOURCE_LINE 00000926 "by a vertical bar '|') and the value of the ARGS parameter."
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "    $config->define(\"foo\", {"
NSQ_SOURCE_LINE 00000929 "        ARGS  => \"=i\","
NSQ_SOURCE_LINE 00000930 "        ALIAS => \"bar|baz\","
NSQ_SOURCE_LINE 00000931 "    });"
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "    # Getopt::Long specification: \"foo|bar|baz=i\""
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "Errors and warning generated by the Getopt::Long module are trapped and "
NSQ_SOURCE_LINE 00000936 "handled by the AppConfig error handler.  This may be a user-defined "
NSQ_SOURCE_LINE 00000937 "routine installed with the ERROR configuration option."
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "Please note that the AppConfig::Getopt interface is still experimental"
NSQ_SOURCE_LINE 00000940 "and may not be 100% operational.  This is almost undoubtedly due to "
NSQ_SOURCE_LINE 00000941 "problems in AppConfig::Getopt rather than Getopt::Long."
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "=head2 PARSING CGI PARAMETERS"
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 "The cgi() method provides an interface to the AppConfig::CGI module"
NSQ_SOURCE_LINE 00000946 "for updating variable values based on the parameters appended to the"
NSQ_SOURCE_LINE 00000947 "URL for a CGI script.  This is commonly known as the CGI "
NSQ_SOURCE_LINE 00000948 "\"GET\" method.  The CGI \"POST\" method is currently not supported."
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "Parameter definitions are separated from the CGI script name by a "
NSQ_SOURCE_LINE 00000951 "question mark and from each other by ampersands.  Where variables"
NSQ_SOURCE_LINE 00000952 "have specific values, these are appended to the variable with an "
NSQ_SOURCE_LINE 00000953 "equals sign:"
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 "    http://www.here.com/cgi-bin/myscript?foo=bar&baz=qux&verbose"
NSQ_SOURCE_LINE 00000956 ""
NSQ_SOURCE_LINE 00000957 "        # $config->foo('bar');"
NSQ_SOURCE_LINE 00000958 "        # $config->baz('qux');"
NSQ_SOURCE_LINE 00000959 "        # $config->verbose(1);"
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "Certain values specified in a URL must be escaped in the appropriate "
NSQ_SOURCE_LINE 00000962 "manner (see CGI specifications at http://www.w3c.org/ for full details).  "
NSQ_SOURCE_LINE 00000963 "The AppConfig::CGI module automatically unescapes the CGI query string"
NSQ_SOURCE_LINE 00000964 "to restore the parameters to their intended values."
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "    http://where.com/mycgi?title=%22The+Wrong+Trousers%22"
NSQ_SOURCE_LINE 00000967 ""
NSQ_SOURCE_LINE 00000968 "    # $config->title('\"The Wrong Trousers\"');"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "Please be considerate of the security implications of providing writable"
NSQ_SOURCE_LINE 00000971 "access to script variables via CGI."
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "    http://rebel.alliance.com/cgi-bin/..."
NSQ_SOURCE_LINE 00000974 "        .../send_report?file=%2Fetc%2Fpasswd&email=darth%40empire.com"
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "To avoid any accidental or malicious changing of \"private\" variables, "
NSQ_SOURCE_LINE 00000977 "define only the \"public\" variables before calling the cgi() (or any "
NSQ_SOURCE_LINE 00000978 "other) method.  Further variables can subsequently be defined which "
NSQ_SOURCE_LINE 00000979 "can not be influenced by the CGI parameters."
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "    $config->define('verbose', 'debug')"
NSQ_SOURCE_LINE 00000982 "    $config->cgi();             # can only set verbose and debug"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "    $config->define('email', 'file');"
NSQ_SOURCE_LINE 00000985 "    $config->file($cfgfile);    # can set verbose, debug, email + file"
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 "=head1 CONSTANT DEFINITIONS"
NSQ_SOURCE_LINE 00000989 ""
NSQ_SOURCE_LINE 00000990 "A number of constants are defined by the AppConfig module.  These may be"
NSQ_SOURCE_LINE 00000991 "accessed directly (e.g. AppConfig::EXPAND_VARS) or by first importing them"
NSQ_SOURCE_LINE 00000992 "into the caller's package.  Constants are imported by specifying their "
NSQ_SOURCE_LINE 00000993 "names as arguments to C<use AppConfig> or by importing a set of constants"
NSQ_SOURCE_LINE 00000994 "identified by its \"tag set\" name."
NSQ_SOURCE_LINE 00000995 ""
NSQ_SOURCE_LINE 00000996 "    use AppConfig qw(ARGCOUNT_NONE ARGCOUNT_ONE);"
NSQ_SOURCE_LINE 00000997 ""
NSQ_SOURCE_LINE 00000998 "    use AppConfig qw(:argcount);"
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "The following tag sets are defined:"
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "=over 4"
NSQ_SOURCE_LINE 00001003 ""
NSQ_SOURCE_LINE 00001004 "=item :expand"
NSQ_SOURCE_LINE 00001005 ""
NSQ_SOURCE_LINE 00001006 "The ':expand' tagset defines the following constants:"
NSQ_SOURCE_LINE 00001007 ""
NSQ_SOURCE_LINE 00001008 "    EXPAND_NONE"
NSQ_SOURCE_LINE 00001009 "    EXPAND_VAR"
NSQ_SOURCE_LINE 00001010 "    EXPAND_UID "
NSQ_SOURCE_LINE 00001011 "    EXPAND_ENV"
NSQ_SOURCE_LINE 00001012 "    EXPAND_ALL       # EXPAND_VAR | EXPAND_UID | EXPAND_ENV"
NSQ_SOURCE_LINE 00001013 "    EXPAND_WARN"
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "See AppConfig::File for full details of the use of these constants."
NSQ_SOURCE_LINE 00001016 ""
NSQ_SOURCE_LINE 00001017 "=item :argcount"
NSQ_SOURCE_LINE 00001018 ""
NSQ_SOURCE_LINE 00001019 "The ':argcount' tagset defines the following constants:"
NSQ_SOURCE_LINE 00001020 ""
NSQ_SOURCE_LINE 00001021 "    ARGCOUNT_NONE"
NSQ_SOURCE_LINE 00001022 "    ARGCOUNT_ONE"
NSQ_SOURCE_LINE 00001023 "    ARGCOUNT_LIST "
NSQ_SOURCE_LINE 00001024 "    ARGCOUNT_HASH"
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "See AppConfig::State for full details of the use of these constants."
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "=back"
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "=head1 REPOSITORY"
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "L<https://github.com/neilbowers/AppConfig>"
NSQ_SOURCE_LINE 00001033 ""
