BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use 5.008003;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "package Sub::Delete;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "$VERSION = '1.00003';"
NSQ_SOURCE_LINE 00000006 "@EXPORT = delete_sub;"
NSQ_SOURCE_LINE 00000007 "use Exporter 5.57 'import';"
NSQ_SOURCE_LINE 00000008 "use constant point0 => 0+$] eq 5.01;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "# This sub must come before any lexical vars."
NSQ_SOURCE_LINE 00000011 "sub strict_eval($) {"
NSQ_SOURCE_LINE 00000012 " local %^H if point0;"
NSQ_SOURCE_LINE 00000013 " local *@;"
NSQ_SOURCE_LINE 00000014 " use#"
NSQ_SOURCE_LINE 00000015 "  strict 'vars';"
NSQ_SOURCE_LINE 00000016 " local $SIG{__WARN__} = sub {};"
NSQ_SOURCE_LINE 00000017 " eval shift"
NSQ_SOURCE_LINE 00000018 "}"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "my %sigils = qw( SCALAR $  ARRAY @  HASH % );"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub delete_sub {"
NSQ_SOURCE_LINE 00000023 "\tmy $sub = shift;"
NSQ_SOURCE_LINE 00000024 "\tmy($stashname, $key) = $sub =~ /(.*::)((?:(?!::).)*)\\z/s"
NSQ_SOURCE_LINE 00000025 "\t\t? ($1,$2) : (caller().\"::\", $sub);"
NSQ_SOURCE_LINE 00000026 "\texists +(my $stash = \\%$stashname)->{$key} or return;"
NSQ_SOURCE_LINE 00000027 "\tref $stash->{$key} eq 'SCALAR' and  # perl5.10 constant"
NSQ_SOURCE_LINE 00000028 "\t\tdelete $stash->{$key}, return;"
NSQ_SOURCE_LINE 00000029 "\tmy $globname = \"$stashname$key\"; "
NSQ_SOURCE_LINE 00000030 "\tmy $glob = *$globname; # autovivify the glob in case future perl"
NSQ_SOURCE_LINE 00000031 "\tdefined *$glob{CODE} or return;  # versions add new funny stuff"
NSQ_SOURCE_LINE 00000032 "\tmy $check_importedness"
NSQ_SOURCE_LINE 00000033 "\t = $stashname =~ /^(?:(?!\\d)\\w*(?:::\\w*)*)\\z/"
NSQ_SOURCE_LINE 00000034 "\t   && $key    =~ /^(?!\\d)\\w+\\z/;"
NSQ_SOURCE_LINE 00000035 "\tmy %imported_slots;"
NSQ_SOURCE_LINE 00000036 "\tmy $package;"
NSQ_SOURCE_LINE 00000037 "\tif($check_importedness) {"
NSQ_SOURCE_LINE 00000038 "\t\t$package = substr $stashname, 0, -2;"
NSQ_SOURCE_LINE 00000039 "\t\tfor (qw \"SCALAR ARRAY HASH\") {"
NSQ_SOURCE_LINE 00000040 "\t\t\tdefined *$glob{$_} or next;"
NSQ_SOURCE_LINE 00000041 "\t\t\t$imported_slots{$_} = strict_eval"
NSQ_SOURCE_LINE 00000042 "\t\t\t  \"package $package; 0 && $sigils{$_}$key; 1\""
NSQ_SOURCE_LINE 00000043 "\t\t}"
NSQ_SOURCE_LINE 00000044 "\t}"
NSQ_SOURCE_LINE 00000045 "        delete $stash->{$key};"
NSQ_SOURCE_LINE 00000046 "\tkeys %imported_slots == 1 and exists $imported_slots{SCALAR}"
NSQ_SOURCE_LINE 00000047 "\t and !$imported_slots{SCALAR} and Internals::SvREFCNT $$glob =>== 1"
NSQ_SOURCE_LINE 00000048 "\t and !defined *$glob{IO} and !defined *$glob{FORMAT}"
NSQ_SOURCE_LINE 00000049 "\t and return; # empty glob"
NSQ_SOURCE_LINE 00000050 "\tmy $newglob = \\*$globname;"
NSQ_SOURCE_LINE 00000051 "\tlocal *alias = *$newglob;"
NSQ_SOURCE_LINE 00000052 "\tdefined *$glob{$_} and ("
NSQ_SOURCE_LINE 00000053 "\t !$check_importedness || $imported_slots{$_}"
NSQ_SOURCE_LINE 00000054 "\t  ? *$newglob"
NSQ_SOURCE_LINE 00000055 "\t  : *alias"
NSQ_SOURCE_LINE 00000056 "\t) = *$glob{$_}"
NSQ_SOURCE_LINE 00000057 "\t\tfor qw \"SCALAR ARRAY HASH\";"
NSQ_SOURCE_LINE 00000058 "\tdefined *$glob{$_} and *$newglob = *$glob{$_}"
NSQ_SOURCE_LINE 00000059 "\t\tfor qw \"IO FORMAT\";"
NSQ_SOURCE_LINE 00000060 "\treturn # nothing;"
NSQ_SOURCE_LINE 00000061 "}"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "1;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "__END__"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=head1 NAME"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "Sub::Delete - Perl module enabling one to delete subroutines"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head1 VERSION"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "1.00003"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    use Sub::Delete;"
NSQ_SOURCE_LINE 00000078 "    sub foo {}"
NSQ_SOURCE_LINE 00000079 "    delete_sub 'foo';"
NSQ_SOURCE_LINE 00000080 "    eval 'foo();1' or die; # dies"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "This module provides one function, C<delete_sub>, that deletes the"
NSQ_SOURCE_LINE 00000085 "subroutine whose name is passed to it. (To load the module without"
NSQ_SOURCE_LINE 00000086 "importing the function, write S<C<use Sub::Delete();>>.)"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "This does more than simply undefine"
NSQ_SOURCE_LINE 00000089 "the subroutine in the manner of C<undef &foo>, which leaves a stub that"
NSQ_SOURCE_LINE 00000090 "can trigger AUTOLOAD (and, consequently, won't work for deleting methods)."
NSQ_SOURCE_LINE 00000091 "The subroutine is completely obliterated from the"
NSQ_SOURCE_LINE 00000092 "symbol table (though there may be"
NSQ_SOURCE_LINE 00000093 "references to it elsewhere, including in compiled code)."
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=head1 PREREQUISITES"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "This module requires L<perl> 5.8.3 or higher."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "If you take a reference to a glob containing a subroutine, and then delete"
NSQ_SOURCE_LINE 00000102 "the subroutine with C<delete_sub>, you will find that the glob you "
NSQ_SOURCE_LINE 00000103 "referenced still has a subroutine in it. This is because C<delete_sub>"
NSQ_SOURCE_LINE 00000104 "removes a glob, replaces it with another, and then copies the contents of"
NSQ_SOURCE_LINE 00000105 "the old glob into the new one, except for the C<CODE> slot. (This is nearly"
NSQ_SOURCE_LINE 00000106 "impossible to fix without breaking constant::lexical.)"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "=head1 BUGS"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "If you find any bugs, please report them to the author via e-mail."
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=head1 AUTHOR & COPYRIGHT"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "Copyright (C) 2008-10 Father Chrysostomos (sprout at, um, cpan dot org)"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "This program is free software; you may redistribute or modify it (or both)"
NSQ_SOURCE_LINE 00000117 "under the same terms as perl."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "L<perltodo>, which has C<delete &sub> listed as a possible future feature"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "L<Symbol::Glob> and L<Symbol::Util>, both of which predate this module (but"
NSQ_SOURCE_LINE 00000124 "I only discovered them recently), and which allow one to delete any"
NSQ_SOURCE_LINE 00000125 "arbitrary slot from a glob. Neither of them takes perl 5.10 constants"
NSQ_SOURCE_LINE 00000126 "into account, however. They also both differ from this module, in that a"
NSQ_SOURCE_LINE 00000127 "subroutine referenced in compiled code can no longer be called if deleted"
NSQ_SOURCE_LINE 00000128 "from its glob. The entire glob must be replaced (which this module does)."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=cut"
BODY_END
