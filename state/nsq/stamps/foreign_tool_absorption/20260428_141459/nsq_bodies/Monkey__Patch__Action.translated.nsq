NSQ_SOURCE_LINE 00000001 "package Monkey::Patch::Action;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2018-04-02'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.061'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 "use strict;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Monkey::Patch::Action::Handle;"
NSQ_SOURCE_LINE 00000011 "use Scalar::Util qw(blessed);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw(patch_package patch_object);"
NSQ_SOURCE_LINE 00000015 "our %EXPORT_TAGS = (all => \\@EXPORT_OK);"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "sub patch_package {"
NSQ_SOURCE_LINE 00000018 "    my ($package, $subname, $action, $code, @extra) = @_;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    die \"Please specify action\" unless $action;"
NSQ_SOURCE_LINE 00000021 "    if ($action eq 'delete') {"
NSQ_SOURCE_LINE 00000022 "        die \"code not needed for 'delete' action\" if $code;"
NSQ_SOURCE_LINE 00000023 "    } else {"
NSQ_SOURCE_LINE 00000024 "        die \"Please specify code\" unless $code;"
NSQ_SOURCE_LINE 00000025 "    }"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    my $name = \"$package\\::$subname\";"
NSQ_SOURCE_LINE 00000028 "    my $type;"
NSQ_SOURCE_LINE 00000029 "    if ($action eq 'add') {"
NSQ_SOURCE_LINE 00000030 "        die \"Adding $name: must not already exist\" if defined(&$name);"
NSQ_SOURCE_LINE 00000031 "        $type = 'sub';"
NSQ_SOURCE_LINE 00000032 "    } elsif ($action eq 'replace') {"
NSQ_SOURCE_LINE 00000033 "        die \"Replacing $name: must already exist\" unless defined(&$name);"
NSQ_SOURCE_LINE 00000034 "        $type = 'sub';"
NSQ_SOURCE_LINE 00000035 "    } elsif ($action eq 'add_or_replace') {"
NSQ_SOURCE_LINE 00000036 "        $type = 'sub';"
NSQ_SOURCE_LINE 00000037 "    } elsif ($action eq 'wrap') {"
NSQ_SOURCE_LINE 00000038 "        die \"Wrapping $name: must already exist\" unless defined(&$name);"
NSQ_SOURCE_LINE 00000039 "        $type = 'wrap';"
NSQ_SOURCE_LINE 00000040 "    } elsif ($action eq 'delete') {"
NSQ_SOURCE_LINE 00000041 "        $type = 'delete';"
NSQ_SOURCE_LINE 00000042 "    } else {"
NSQ_SOURCE_LINE 00000043 "        die \"Unknown action '$action', please use either \"."
NSQ_SOURCE_LINE 00000044 "            \"wrap/add/replace/add_or_replace/delete\";"
NSQ_SOURCE_LINE 00000045 "    }"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    my @caller = caller(0);"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    Monkey::Patch::Action::Handle->new("
NSQ_SOURCE_LINE 00000050 "        package => $package,"
NSQ_SOURCE_LINE 00000051 "        subname => $subname,"
NSQ_SOURCE_LINE 00000052 "        extra   => \\@extra,"
NSQ_SOURCE_LINE 00000053 "        patcher => \\@caller,"
NSQ_SOURCE_LINE 00000054 "        code    => $code,"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "        -type   => $type,"
NSQ_SOURCE_LINE 00000057 "    );"
NSQ_SOURCE_LINE 00000058 "}"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub patch_object {"
NSQ_SOURCE_LINE 00000061 "    my ($obj, $methname, $action0, $code0, @extra) = @_;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    die \"'$obj' not an object\" unless blessed($obj);"
NSQ_SOURCE_LINE 00000064 "    die \"Please specify action\" unless $action0;"
NSQ_SOURCE_LINE 00000065 "    die \"Invalid action '$action0', please choose add|replace|add_or_replace|wrap|delete\""
NSQ_SOURCE_LINE 00000066 "        unless $action0 =~ /\\A(add|replace|add_or_replace|wrap|delete)\\z/;"
NSQ_SOURCE_LINE 00000067 "    if ($action0 eq 'delete') {"
NSQ_SOURCE_LINE 00000068 "        die \"code not needed for 'delete' action\" if $code0;"
NSQ_SOURCE_LINE 00000069 "    } else {"
NSQ_SOURCE_LINE 00000070 "        die \"Please specify code\" unless $code0;"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    my $package = ref($obj);"
NSQ_SOURCE_LINE 00000074 "    my $name = \"$package\\::$methname\";"
NSQ_SOURCE_LINE 00000075 "    my $action = defined(&$name) ? 'wrap' : 'add';"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    my $code = sub {"
NSQ_SOURCE_LINE 00000078 "        my $ctx  = $action eq 'wrap' ? shift : undef;"
NSQ_SOURCE_LINE 00000079 "        my $self = $_[0];"
NSQ_SOURCE_LINE 00000080 "        no warnings 'numeric';"
NSQ_SOURCE_LINE 00000081 "        if ($obj == $self) {"
NSQ_SOURCE_LINE 00000082 "            if ($action0 eq 'add') {"
NSQ_SOURCE_LINE 00000083 "                $code0->(@_);"
NSQ_SOURCE_LINE 00000084 "            } elsif ($action0 eq 'replace') {"
NSQ_SOURCE_LINE 00000085 "                $code0->(@_);"
NSQ_SOURCE_LINE 00000086 "            } elsif ($action0 eq 'add_or_replace') {"
NSQ_SOURCE_LINE 00000087 "                $code0->(@_);"
NSQ_SOURCE_LINE 00000088 "            } elsif ($action0 eq 'wrap') {"
NSQ_SOURCE_LINE 00000089 "                my $octx = {%$ctx};"
NSQ_SOURCE_LINE 00000090 "                $code0->($octx, @_);"
NSQ_SOURCE_LINE 00000091 "            } elsif ($action0 eq 'delete') {"
NSQ_SOURCE_LINE 00000092 "                die \"Undefined method '$methname' for object '$obj'\";"
NSQ_SOURCE_LINE 00000093 "            } else {"
NSQ_SOURCE_LINE 00000094 "                die \"BUG: Unknown action '$action0'\";"
NSQ_SOURCE_LINE 00000095 "            }"
NSQ_SOURCE_LINE 00000096 "        } else {"
NSQ_SOURCE_LINE 00000097 "            if ($action eq 'wrap') {"
NSQ_SOURCE_LINE 00000098 "                return $ctx->{orig}->(@_);"
NSQ_SOURCE_LINE 00000099 "            } else {"
NSQ_SOURCE_LINE 00000100 "                die \"Undefined method '$methname' for object '$obj'\";"
NSQ_SOURCE_LINE 00000101 "            }"
NSQ_SOURCE_LINE 00000102 "        }"
NSQ_SOURCE_LINE 00000103 "    };"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    patch_package($package, $methname, $action, $code, @extra);"
NSQ_SOURCE_LINE 00000106 "}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "1;"
NSQ_SOURCE_LINE 00000109 "# ABSTRACT: Wrap/add/replace/delete subs from other package (with restore)"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "__END__"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=pod"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=head1 NAME"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "Monkey::Patch::Action - Wrap/add/replace/delete subs from other package (with restore)"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=head1 VERSION"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "This document describes version 0.061 of Monkey::Patch::Action (from Perl distribution Monkey-Patch-Action), released on 2018-04-02."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "Patching package or class:"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 " use Monkey::Patch::Action qw(patch_package);"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 " package Foo;"
NSQ_SOURCE_LINE 00000132 " sub sub1  { say \"Foo's sub1\" }"
NSQ_SOURCE_LINE 00000133 " sub sub2  { say \"Foo's sub2, args=\", join(\",\", @_) }"
NSQ_SOURCE_LINE 00000134 " sub meth1 { my $self = shift; say \"Foo's meth1\" }"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 " package Bar;"
NSQ_SOURCE_LINE 00000137 " our @ISA = qw(Foo);"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 " package main;"
NSQ_SOURCE_LINE 00000140 " my $h; # handle object"
NSQ_SOURCE_LINE 00000141 " my $foo = Foo->new;"
NSQ_SOURCE_LINE 00000142 " my $bar = Bar->new;"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 " # replacing a subroutine"
NSQ_SOURCE_LINE 00000145 " $h = patch_package('Foo', 'sub1', 'replace', sub { \"qux\" });"
NSQ_SOURCE_LINE 00000146 " Foo::sub1(); # says \"qux\""
NSQ_SOURCE_LINE 00000147 " undef $h;"
NSQ_SOURCE_LINE 00000148 " Foo::sub1(); # says \"Foo's sub1\""
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 " # adding a subroutine"
NSQ_SOURCE_LINE 00000151 " $h = patch_package('Foo', 'sub3', 'add', sub { \"qux\" });"
NSQ_SOURCE_LINE 00000152 " Foo::sub3(); # says \"qux\""
NSQ_SOURCE_LINE 00000153 " undef $h;"
NSQ_SOURCE_LINE 00000154 " Foo::sub3(); # dies"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 " # deleting a subroutine"
NSQ_SOURCE_LINE 00000157 " $h = patch_package('Foo', 'sub2', 'delete');"
NSQ_SOURCE_LINE 00000158 " Foo::sub2(); # dies"
NSQ_SOURCE_LINE 00000159 " undef $h;"
NSQ_SOURCE_LINE 00000160 " Foo::sub2(); # says \"Foo's sub2, args=\""
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 " # wrapping a subroutine"
NSQ_SOURCE_LINE 00000163 " $h = patch_package('Foo', 'sub2', 'wrap',"
NSQ_SOURCE_LINE 00000164 "     sub {"
NSQ_SOURCE_LINE 00000165 "         my $ctx = shift;"
NSQ_SOURCE_LINE 00000166 "         say \"wrapping $ctx->{package}::$ctx->{subname}\";"
NSQ_SOURCE_LINE 00000167 "         $ctx->{orig}->(@_);"
NSQ_SOURCE_LINE 00000168 "     }"
NSQ_SOURCE_LINE 00000169 " );"
NSQ_SOURCE_LINE 00000170 " Foo::sub2(1,2,3); # says \"wrapping Foo::sub2\" then \"Foo's sub2, args=1,2,3\""
NSQ_SOURCE_LINE 00000171 " undef $h;"
NSQ_SOURCE_LINE 00000172 " Foo::sub2(1,2,3); # says \"Foo's sub2, args=1,2,3\""
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 " # stacking patches (note: can actually be unapplied in random order)"
NSQ_SOURCE_LINE 00000175 " my ($h2, $h3);"
NSQ_SOURCE_LINE 00000176 " $h  = patch_package('Foo', 'sub1', 'replace', sub { \"qux\" });"
NSQ_SOURCE_LINE 00000177 " Foo::sub1(); # says \"qux\""
NSQ_SOURCE_LINE 00000178 " $h2 = patch_package('Foo', 'sub1', 'delete');"
NSQ_SOURCE_LINE 00000179 " Foo::sub1(); # dies"
NSQ_SOURCE_LINE 00000180 " $h3 = patch_package('Foo', 'sub1', 'replace', sub { \"quux\" });"
NSQ_SOURCE_LINE 00000181 " Foo::sub1(); # says \"quux\""
NSQ_SOURCE_LINE 00000182 " undef $h3;"
NSQ_SOURCE_LINE 00000183 " Foo::sub1(); # dies"
NSQ_SOURCE_LINE 00000184 " undef $h2;"
NSQ_SOURCE_LINE 00000185 " Foo::sub1(); # says \"qux\""
NSQ_SOURCE_LINE 00000186 " undef $h;"
NSQ_SOURCE_LINE 00000187 " Foo::sub1(); # says \"Foo's sub1\""
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "Patching object:"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 " use Monkey::Patch::Action qw(patch_package);"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 " package Foo;"
NSQ_SOURCE_LINE 00000194 " sub meth1 { say \"Foo's meth1\" }"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 " package Bar;"
NSQ_SOURCE_LINE 00000197 " our @ISA = qw(Foo);"
NSQ_SOURCE_LINE 00000198 " sub meth2 { say \"Bar's meth2\" }"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 " package main;"
NSQ_SOURCE_LINE 00000201 " my $h; # handle object"
NSQ_SOURCE_LINE 00000202 " my $foo1 = Foo->new;"
NSQ_SOURCE_LINE 00000203 " my $foo2 = Foo->new;"
NSQ_SOURCE_LINE 00000204 " my $bar1 = Bar->new;"
NSQ_SOURCE_LINE 00000205 " my $bar2 = Bar->new;"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 " # replacing a method"
NSQ_SOURCE_LINE 00000208 " $h = patch_object($foo1, 'meth1', 'replace', sub { say \"Foo's modified meth1\" });"
NSQ_SOURCE_LINE 00000209 " $foo1->meth1; # says \"Foo's modified meth1\""
NSQ_SOURCE_LINE 00000210 " $foo2->meth1; # says \"Foo's meth1\""
NSQ_SOURCE_LINE 00000211 " undef $h;"
NSQ_SOURCE_LINE 00000212 " $foo1->meth1; # says \"Foo's meth1\""
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 " $h = patch_object($bar1, 'meth3', 'add', sub { \"Bar's meth3\" });"
NSQ_SOURCE_LINE 00000215 " $bar1->meth3; # says \"Bar's meth3\""
NSQ_SOURCE_LINE 00000216 " $bar2->meth3; # dies"
NSQ_SOURCE_LINE 00000217 " undef $h;"
NSQ_SOURCE_LINE 00000218 " $bar1->meth3; # dies"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 " # deleting a method"
NSQ_SOURCE_LINE 00000221 " $h = patch_object($foo1, 'meth1', 'delete');"
NSQ_SOURCE_LINE 00000222 " $foo1->meth1; # dies"
NSQ_SOURCE_LINE 00000223 " $foo2->meth1; # says \"Foo's meth1\""
NSQ_SOURCE_LINE 00000224 " undef $h;"
NSQ_SOURCE_LINE 00000225 " $foo1->meth1; # says \"Foo's meth1\""
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 " # wrapping a method"
NSQ_SOURCE_LINE 00000228 " $h = patch_object($foo1, 'meth1', 'wrap',"
NSQ_SOURCE_LINE 00000229 "     sub {"
NSQ_SOURCE_LINE 00000230 "         my $ctx = shift;"
NSQ_SOURCE_LINE 00000231 "         say \"Wrapping $ctx->{package}::$ctx->{subname}\";"
NSQ_SOURCE_LINE 00000232 "         $ctx->{orig}->(@_);"
NSQ_SOURCE_LINE 00000233 "     }"
NSQ_SOURCE_LINE 00000234 " );"
NSQ_SOURCE_LINE 00000235 " $foo1->meth1; # says \"Wrapping Foo::meth1\" then \"Foo's meth1\""
NSQ_SOURCE_LINE 00000236 " $foo2->meth1; # says \"Foo's meth1\""
NSQ_SOURCE_LINE 00000237 " undef $h;"
NSQ_SOURCE_LINE 00000238 " $foo1->meth1; # says \"Foo's meth1\""
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "Monkey-patching is the act of modifying a package at runtime: adding a"
NSQ_SOURCE_LINE 00000243 "subroutine/method, replacing/deleting/wrapping another, etc. Perl makes it easy"
NSQ_SOURCE_LINE 00000244 "to do that, for example:"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 " # add a subroutine"
NSQ_SOURCE_LINE 00000247 " *{\"Target::sub1\"} = sub { ... };"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 " # another way, can be done from any file"
NSQ_SOURCE_LINE 00000250 " package Target;"
NSQ_SOURCE_LINE 00000251 " sub sub2 { ... }"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 " # delete a subroutine"
NSQ_SOURCE_LINE 00000254 " undef *{\"Target::sub3\"};"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "This module makes things even easier by helping you apply a stack of patches and"
NSQ_SOURCE_LINE 00000257 "unapply them later in flexible order."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=head2 patch_package"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "Usage:"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 " patch_package($package, $subname, $action, $code, @extra) => HANDLE"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "Patch C<$package>'s subroutine named C<$subname>. C<$action> is either:"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=over"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "=item * C<wrap>"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "C<$subname> must already exist. C<code> is required."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Your code receives a context hash as its first argument, followed by any"
NSQ_SOURCE_LINE 00000276 "arguments the subroutine would have normally gotten. Context hash contains:"
NSQ_SOURCE_LINE 00000277 "C<orig> (the original subroutine that is being wrapped), C<subname>, C<package>,"
NSQ_SOURCE_LINE 00000278 "C<extra>."
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "=item * C<add>"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "C<subname> must not already exist. C<code> is required."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=item * C<replace>"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "C<subname> must already exist. C<code> is required."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=item * C<add_or_replace>"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "C<code> is required."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=item * C<delete>"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "C<code> is not needed."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=back"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "Die on error."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "Function returns a handle object. As soon as you lose the value of the handle"
NSQ_SOURCE_LINE 00000301 "(by calling in void context, assigning over the variable, undeffing the"
NSQ_SOURCE_LINE 00000302 "variable, letting it go out of scope, etc), the patch is unapplied."
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "Patches can be unapplied in random order, but unapplying a patch where the next"
NSQ_SOURCE_LINE 00000305 "patch is a wrapper can lead to an error. Example: first patch (P1) adds a"
NSQ_SOURCE_LINE 00000306 "subroutine and second patch (P2) wraps it. If P1 is unapplied before P2, the"
NSQ_SOURCE_LINE 00000307 "subroutine is now no longer there, and P2 no longer works. Unapplying P1 after"
NSQ_SOURCE_LINE 00000308 "P2 works, of course."
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=head2 patch_object"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "Usage:"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 " patch_object($obj, $methname, $action, $code, @extra) => HANDLE"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "Basically just a wrapper for C<patch_package> to patch \"only specific"
NSQ_SOURCE_LINE 00000317 "object(s)\". Basically it does something like this:"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 " die \"'$obj' is not an object\" unless blessed($obj);"
NSQ_SOURCE_LINE 00000320 " my $package = ref($obj);"
NSQ_SOURCE_LINE 00000321 " patch_package($package, $methname, 'wrap',"
NSQ_SOURCE_LINE 00000322 "     sub {"
NSQ_SOURCE_LINE 00000323 "         my $ctx = shift;"
NSQ_SOURCE_LINE 00000324 "         my $self = shift;"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "         my $o = $ctx->{extra}[0];"
NSQ_SOURCE_LINE 00000327 "         no warnings 'numeric';"
NSQ_SOURCE_LINE 00000328 "         if ($o == $self) {"
NSQ_SOURCE_LINE 00000329 "             # do stuff"
NSQ_SOURCE_LINE 00000330 "         } else {"
NSQ_SOURCE_LINE 00000331 "             # not our target object"
NSQ_SOURCE_LINE 00000332 "             $ctx->{orig}->(@_);"
NSQ_SOURCE_LINE 00000333 "         }"
NSQ_SOURCE_LINE 00000334 "     },"
NSQ_SOURCE_LINE 00000335 " );"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=head1 FAQ"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "=head2 Differences with Monkey::Patch?"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "This module is based on the wonderful L<Monkey::Patch> by Paul Driver. The"
NSQ_SOURCE_LINE 00000342 "differences are:"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "=over"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "=item *"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "This module adds the ability to add/replace/delete subroutines instead of just"
NSQ_SOURCE_LINE 00000349 "wrapping them."
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=item *"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "Interface to patch_package() is slightly different (see previous item for the"
NSQ_SOURCE_LINE 00000354 "cause)."
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "=item *"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "Using this module, the wrapper receives a context hash instead of just the"
NSQ_SOURCE_LINE 00000359 "original subroutine."
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=item *"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=back"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "=head2 How to patch classes and objects?"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "Patching a class is basically the same as patching any other package, since Perl"
NSQ_SOURCE_LINE 00000368 "implements a class with a package. One thing to note is that to call a parent's"
NSQ_SOURCE_LINE 00000369 "method inside your wrapper code, instead of:"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 " $self->SUPER::methname(...)"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "you need to do something like:"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 " use SUPER;"
NSQ_SOURCE_LINE 00000376 " SUPER::find_parent(ref($self), 'methname')->methname(...)"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "Patching an object is also basically patching a class/package, because Perl does"
NSQ_SOURCE_LINE 00000379 "not have per-object method like Ruby. But if you just want to provide a modified"
NSQ_SOURCE_LINE 00000380 "behavior for a certain object only, you can do something like:"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 " patch_package($package, $methname, 'wrap',"
NSQ_SOURCE_LINE 00000383 " sub {"
NSQ_SOURCE_LINE 00000384 "     my $ctx = shift;"
NSQ_SOURCE_LINE 00000385 "     my $self = shift;"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "     my $obj = $ctx->{extra}[0];"
NSQ_SOURCE_LINE 00000388 "     no warnings 'numeric';"
NSQ_SOURCE_LINE 00000389 "     if ($obj == $self) {"
NSQ_SOURCE_LINE 00000390 "         # do stuff"
NSQ_SOURCE_LINE 00000391 "     }"
NSQ_SOURCE_LINE 00000392 "     $ctx->{orig}->(@_);"
NSQ_SOURCE_LINE 00000393 " }, $obj);"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "This is basically what L</\"patch_object\"> does."
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "Please visit the project's homepage at L<https://metacpan.org/release/Monkey-Patch-Action>."
