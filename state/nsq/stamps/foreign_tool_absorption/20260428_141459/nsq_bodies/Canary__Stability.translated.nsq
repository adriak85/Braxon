BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "=head1 NAME"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "Canary::Stability - canary to check perl compatibility for schmorp's modules"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 " # in Makefile.PL"
NSQ_SOURCE_LINE 00000008 " use Canary::Stability DISTNAME => 2001, MINIMUM_PERL_VERSION;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "This module is used by Schmorp's modules during configuration stage to"
NSQ_SOURCE_LINE 00000013 "test the installed perl for compatibility with his modules."
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "It's not, at this stage, meant as a tool for other module authors,"
NSQ_SOURCE_LINE 00000016 "although in principle nothing prevents them from subscribing to the same"
NSQ_SOURCE_LINE 00000017 "ideas."
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "See the F<Makefile.PL> in L<Coro> or L<AnyEvent> for usage examples."
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "=cut"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "package Canary::Stability;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "BEGIN {"
NSQ_SOURCE_LINE 00000026 "   $VERSION = 2013;"
NSQ_SOURCE_LINE 00000027 "}"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub sgr {"
NSQ_SOURCE_LINE 00000030 "   # we just assume ANSI almost everywhere"
NSQ_SOURCE_LINE 00000031 "   # red 31, yellow 33, green 32"
NSQ_SOURCE_LINE 00000032 "   local $| = 1;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "   $ENV{PERL_CANARY_STABILITY_COLOUR} ne 0"
NSQ_SOURCE_LINE 00000035 "   and ((-t STDOUT and length $ENV{TERM}) or $ENV{PERL_CANARY_STABILITY_COLOUR})"
NSQ_SOURCE_LINE 00000036 "   and print \"\\e[$_[0]m\";"
NSQ_SOURCE_LINE 00000037 "}"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "sub import {"
NSQ_SOURCE_LINE 00000040 "   my (undef, $distname, $minvers, $minperl) = @_;"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "   $ENV{PERL_CANARY_STABILITY_DISABLE}"
NSQ_SOURCE_LINE 00000043 "      and return;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "   $minperl ||= 5.008002;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "   print <<EOF;"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "***"
NSQ_SOURCE_LINE 00000050 "*** Canary::Stability COMPATIBILITY AND SUPPORT CHECK"
NSQ_SOURCE_LINE 00000051 "*** ================================================="
NSQ_SOURCE_LINE 00000052 "***"
NSQ_SOURCE_LINE 00000053 "*** Hi!"
NSQ_SOURCE_LINE 00000054 "***"
NSQ_SOURCE_LINE 00000055 "*** I do my best to provide predictable and reliable software."
NSQ_SOURCE_LINE 00000056 "***"
NSQ_SOURCE_LINE 00000057 "*** However, in recent releases, P5P (who maintain perl) have been"
NSQ_SOURCE_LINE 00000058 "*** introducing regressions that are sometimes subtle and at other times"
NSQ_SOURCE_LINE 00000059 "*** catastrophic, often for personal preferences with little or no concern"
NSQ_SOURCE_LINE 00000060 "*** for existing code, most notably CPAN."
NSQ_SOURCE_LINE 00000061 "***"
NSQ_SOURCE_LINE 00000062 "*** For this reason, it has become very hard for me to maintain the level"
NSQ_SOURCE_LINE 00000063 "*** of reliability and support I have committed myself to in the past, at"
NSQ_SOURCE_LINE 00000064 "*** least with some perl versions: I simply can't keep up working around new"
NSQ_SOURCE_LINE 00000065 "*** bugs or gratituous incompatibilities, and in turn you might suffer from"
NSQ_SOURCE_LINE 00000066 "*** unanticipated problems."
NSQ_SOURCE_LINE 00000067 "***"
NSQ_SOURCE_LINE 00000068 "*** Therefore I have introduced a support and compatibility check, the results"
NSQ_SOURCE_LINE 00000069 "*** of which follow below, together with a FAQ and some recommendations."
NSQ_SOURCE_LINE 00000070 "***"
NSQ_SOURCE_LINE 00000071 "*** This check is just to let you know that there might be a risk, so you can"
NSQ_SOURCE_LINE 00000072 "*** make judgement calls on how to proceed - it will not keep the module from"
NSQ_SOURCE_LINE 00000073 "*** installing or working."
NSQ_SOURCE_LINE 00000074 "***"
NSQ_SOURCE_LINE 00000075 "EOF"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "   if ($minvers > $VERSION) {"
NSQ_SOURCE_LINE 00000078 "      sgr 33;"
NSQ_SOURCE_LINE 00000079 "      print <<EOF;"
NSQ_SOURCE_LINE 00000080 "*** The stability canary says: (nothing, it died of old age)."
NSQ_SOURCE_LINE 00000081 "***"
NSQ_SOURCE_LINE 00000082 "*** Your Canary::Stability module (used by $distname) is too old."
NSQ_SOURCE_LINE 00000083 "*** This is not a fatal problem - while you might want to upgrade to version"
NSQ_SOURCE_LINE 00000084 "*** $minvers (currently installed version: $VERSION) to get better support"
NSQ_SOURCE_LINE 00000085 "*** status testing, you might also not want to care at all, and all will"
NSQ_SOURCE_LINE 00000086 "*** be well as long $distname works well enough for you, as the stability"
NSQ_SOURCE_LINE 00000087 "*** canary is only used when installing the distribution."
NSQ_SOURCE_LINE 00000088 "***"
NSQ_SOURCE_LINE 00000089 "EOF"
NSQ_SOURCE_LINE 00000090 "   } elsif ($] < $minperl) {"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "      sgr 33;"
NSQ_SOURCE_LINE 00000093 "      print <<EOF;"
NSQ_SOURCE_LINE 00000094 "*** The stability canary says: chirp (it seems concerned about something)."
NSQ_SOURCE_LINE 00000095 "***"
NSQ_SOURCE_LINE 00000096 "*** Your perl version ($]) is older than the $distname distribution"
NSQ_SOURCE_LINE 00000097 "*** likes ($minperl). This is not a fatal problem - the module might work"
NSQ_SOURCE_LINE 00000098 "*** well with your version of perl, but it does mean the author likely"
NSQ_SOURCE_LINE 00000099 "*** won't do anything to make it work if it breaks."
NSQ_SOURCE_LINE 00000100 "***"
NSQ_SOURCE_LINE 00000101 "EOF"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "      if ($ENV{AUTOMATED_TESTING}) {"
NSQ_SOURCE_LINE 00000104 "         print <<EOF;"
NSQ_SOURCE_LINE 00000105 "*** Since this is an AUTOMATED_TESTING environment, the stability canary"
NSQ_SOURCE_LINE 00000106 "*** decided to fail cleanly here, rather than to generate a false test"
NSQ_SOURCE_LINE 00000107 "*** result."
NSQ_SOURCE_LINE 00000108 "***"
NSQ_SOURCE_LINE 00000109 "EOF"
NSQ_SOURCE_LINE 00000110 "         exit 0;"
NSQ_SOURCE_LINE 00000111 "      }"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "   } elsif (defined $Internals::StabilityBranchVersion) {"
NSQ_SOURCE_LINE 00000114 "      # note to people studying this modules sources:"
NSQ_SOURCE_LINE 00000115 "      # the above test is not considered a clean or stable way to"
NSQ_SOURCE_LINE 00000116 "      # test for the stability branch."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "      sgr 32;"
NSQ_SOURCE_LINE 00000119 "      print <<EOF;"
NSQ_SOURCE_LINE 00000120 "*** The stability canary says: chirp! chirp! (it seems to be quite excited)"
NSQ_SOURCE_LINE 00000121 "***"
NSQ_SOURCE_LINE 00000122 "*** It seems you are running schmorp's stability branch of perl."
NSQ_SOURCE_LINE 00000123 "*** All should be well, and if it isn't, you should report this as a bug"
NSQ_SOURCE_LINE 00000124 "*** to the $distname author."
NSQ_SOURCE_LINE 00000125 "***"
NSQ_SOURCE_LINE 00000126 "EOF"
NSQ_SOURCE_LINE 00000127 "   } elsif ($] < 5.021) {"
NSQ_SOURCE_LINE 00000128 "      #sgr 32;"
NSQ_SOURCE_LINE 00000129 "      print <<EOF;"
NSQ_SOURCE_LINE 00000130 "*** The stability canary says: chirp! chirp! (it seems to be quite happy)"
NSQ_SOURCE_LINE 00000131 "***"
NSQ_SOURCE_LINE 00000132 "*** Your version of perl ($]) is quite supported by $distname, nothing"
NSQ_SOURCE_LINE 00000133 "*** else to be said, hope it comes in handy."
NSQ_SOURCE_LINE 00000134 "***"
NSQ_SOURCE_LINE 00000135 "EOF"
NSQ_SOURCE_LINE 00000136 "   } else {"
NSQ_SOURCE_LINE 00000137 "      sgr 31;"
NSQ_SOURCE_LINE 00000138 "      print <<EOF;"
NSQ_SOURCE_LINE 00000139 "*** The stability canary says: (nothing, it was driven away by harsh weather)"
NSQ_SOURCE_LINE 00000140 "***"
NSQ_SOURCE_LINE 00000141 "*** It seems you are running perl version $], likely the \"official\" or"
NSQ_SOURCE_LINE 00000142 "*** \"standard\" version. While there is nothing wrong with doing that,"
NSQ_SOURCE_LINE 00000143 "*** standard perl versions 5.022 and up are not supported by $distname."
NSQ_SOURCE_LINE 00000144 "*** While this might be fatal, it might also be all right - if you run into"
NSQ_SOURCE_LINE 00000145 "*** problems, you might want to downgrade your perl or switch to the"
NSQ_SOURCE_LINE 00000146 "*** stability branch."
NSQ_SOURCE_LINE 00000147 "***"
NSQ_SOURCE_LINE 00000148 "*** If everything works fine, you can ignore this message."
NSQ_SOURCE_LINE 00000149 "***"
NSQ_SOURCE_LINE 00000150 "EOF"
NSQ_SOURCE_LINE 00000151 "      sgr 0;"
NSQ_SOURCE_LINE 00000152 "      print <<EOF;"
NSQ_SOURCE_LINE 00000153 "***"
NSQ_SOURCE_LINE 00000154 "*** Stability canary mini-FAQ:"
NSQ_SOURCE_LINE 00000155 "***"
NSQ_SOURCE_LINE 00000156 "*** Do I need to do anything?"
NSQ_SOURCE_LINE 00000157 "***    With luck, no. While some distributions are known to fail"
NSQ_SOURCE_LINE 00000158 "***    already, most should probably work. This message is here"
NSQ_SOURCE_LINE 00000159 "***    to alert you that your perl is not supported by $distname,"
NSQ_SOURCE_LINE 00000160 "***    and if things go wrong, you either need to downgrade, or"
NSQ_SOURCE_LINE 00000161 "***    sidegrade to the stability variant of your perl version,"
NSQ_SOURCE_LINE 00000162 "***    or simply live with the consequences."
NSQ_SOURCE_LINE 00000163 "***"
NSQ_SOURCE_LINE 00000164 "*** What is this canary thing?"
NSQ_SOURCE_LINE 00000165 "***    It's purpose is to check support status of $distname with"
NSQ_SOURCE_LINE 00000166 "***    respect to your perl version."
NSQ_SOURCE_LINE 00000167 "***"
NSQ_SOURCE_LINE 00000168 "*** What is this \"stability branch\"?"
NSQ_SOURCE_LINE 00000169 "***    It's a branch or fork of the official perl, by schmorp, to"
NSQ_SOURCE_LINE 00000170 "***    improve stability and compatibility with existing modules."
NSQ_SOURCE_LINE 00000171 "***"
NSQ_SOURCE_LINE 00000172 "*** How can I skip this prompt on automated installs?"
NSQ_SOURCE_LINE 00000173 "***    Set PERL_CANARY_STABILITY_NOPROMPT=1 in your environment."
NSQ_SOURCE_LINE 00000174 "***    More info is in the Canary::Stability manpage."
NSQ_SOURCE_LINE 00000175 "***"
NSQ_SOURCE_LINE 00000176 "*** Long version of this FAQ: http://stableperl.schmorp.de/faq.html"
NSQ_SOURCE_LINE 00000177 "*** Stability Branch homepage: http://stableperl.schmorp.de/"
NSQ_SOURCE_LINE 00000178 "***"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "EOF"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "      unless ($ENV{PERL_CANARY_STABILITY_NOPROMPT}) {"
NSQ_SOURCE_LINE 00000183 "         require ExtUtils::MakeMaker;"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "         ExtUtils::MakeMaker::prompt (\"Continue anyways? \", \"y\") =~ /^y/i"
NSQ_SOURCE_LINE 00000186 "            or die \"FATAL: User aborted configuration of $distname.\\n\";"
NSQ_SOURCE_LINE 00000187 "      }"
NSQ_SOURCE_LINE 00000188 "   }"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "   sgr 0;"
NSQ_SOURCE_LINE 00000191 "}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=head1 ENVIRONMENT VARIABLES"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=over 4"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "=item C<PERL_CANARY_STABILITY_NOPROMPT=1>"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "Do not prompt the user on alert messages."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=item C<PERL_CANARY_STABILITY_COLOUR=0>"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "Disable use of colour."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=item C<PERL_CANARY_STABILITY_COLOUR=1>"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "Force use of colour."
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=item C<PERL_CANARY_STABILITY_DISABLE=1>"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "Disable this modules functionality completely."
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "=item C<AUTOMATED_TESTING=1>"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "When this variable is set to a true value and the perl minimum version"
NSQ_SOURCE_LINE 00000216 "requirement is not met, the module will exit, which should skip testing"
NSQ_SOURCE_LINE 00000217 "under automated testing environments."
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "This is done to avoid false failure or success reports when the chances of"
NSQ_SOURCE_LINE 00000220 "success are already quite low and the failures are not supported by the"
NSQ_SOURCE_LINE 00000221 "author."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=back"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 " Marc Lehmann <schmorp@schmorp.de>"
NSQ_SOURCE_LINE 00000228 " http://software.schmorp.de/pkg/Canary-Stability.html"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=cut"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "1"
NSQ_SOURCE_LINE 00000233 ""
BODY_END
