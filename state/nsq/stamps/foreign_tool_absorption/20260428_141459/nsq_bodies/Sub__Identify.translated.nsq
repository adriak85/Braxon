BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Sub::Identify;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use Exporter;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "BEGIN {"
NSQ_SOURCE_LINE 00000007 "    our $VERSION = '0.14';"
NSQ_SOURCE_LINE 00000008 "    our @ISA = ('Exporter');"
NSQ_SOURCE_LINE 00000009 "    our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000010 "        all => ["
NSQ_SOURCE_LINE 00000011 "            our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000012 "                sub_name"
NSQ_SOURCE_LINE 00000013 "                stash_name"
NSQ_SOURCE_LINE 00000014 "                sub_fullname"
NSQ_SOURCE_LINE 00000015 "                get_code_info"
NSQ_SOURCE_LINE 00000016 "                get_code_location"
NSQ_SOURCE_LINE 00000017 "                is_sub_constant"
NSQ_SOURCE_LINE 00000018 "            )"
NSQ_SOURCE_LINE 00000019 "        ]"
NSQ_SOURCE_LINE 00000020 "    );"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    our $IsPurePerl = 1;"
NSQ_SOURCE_LINE 00000023 "    unless ($ENV{PERL_SUB_IDENTIFY_PP}) {"
NSQ_SOURCE_LINE 00000024 "        if ("
NSQ_SOURCE_LINE 00000025 "            eval {"
NSQ_SOURCE_LINE 00000026 "                require XSLoader;"
NSQ_SOURCE_LINE 00000027 "                XSLoader::load(__PACKAGE__, $VERSION);"
NSQ_SOURCE_LINE 00000028 "                1;"
NSQ_SOURCE_LINE 00000029 "            }"
NSQ_SOURCE_LINE 00000030 "        ) {"
NSQ_SOURCE_LINE 00000031 "            $IsPurePerl = 0;"
NSQ_SOURCE_LINE 00000032 "        }"
NSQ_SOURCE_LINE 00000033 "        else {"
NSQ_SOURCE_LINE 00000034 "            die $@ if $@ && $@ !~ /object version|loadable object/;"
NSQ_SOURCE_LINE 00000035 "        }"
NSQ_SOURCE_LINE 00000036 "    }"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    if ($IsPurePerl) {"
NSQ_SOURCE_LINE 00000039 "        require B;"
NSQ_SOURCE_LINE 00000040 "        *get_code_info = sub ($) {"
NSQ_SOURCE_LINE 00000041 "            my ($coderef) = @_;"
NSQ_SOURCE_LINE 00000042 "            ref $coderef or return;"
NSQ_SOURCE_LINE 00000043 "            my $cv = B::svref_2object($coderef);"
NSQ_SOURCE_LINE 00000044 "            $cv->isa('B::CV') or return;"
NSQ_SOURCE_LINE 00000045 "            # bail out if GV is undefined"
NSQ_SOURCE_LINE 00000046 "            $cv->GV->isa('B::SPECIAL') and return;"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "            return ($cv->GV->STASH->NAME, $cv->GV->NAME);"
NSQ_SOURCE_LINE 00000049 "        };"
NSQ_SOURCE_LINE 00000050 "        *get_code_location = sub ($) {"
NSQ_SOURCE_LINE 00000051 "            my ($coderef) = @_;"
NSQ_SOURCE_LINE 00000052 "            ref $coderef or return;"
NSQ_SOURCE_LINE 00000053 "            my $cv = B::svref_2object($coderef);"
NSQ_SOURCE_LINE 00000054 "            $cv->isa('B::CV') && $cv->START->isa('B::COP')"
NSQ_SOURCE_LINE 00000055 "                or return;"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "            return ($cv->START->file, $cv->START->line);"
NSQ_SOURCE_LINE 00000058 "        };"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 "    if ($IsPurePerl || $] < 5.016) {"
NSQ_SOURCE_LINE 00000061 "        require B;"
NSQ_SOURCE_LINE 00000062 "        *is_sub_constant = sub ($) {"
NSQ_SOURCE_LINE 00000063 "            my ($coderef) = @_;"
NSQ_SOURCE_LINE 00000064 "            ref $coderef or return 0;"
NSQ_SOURCE_LINE 00000065 "            my $cv = B::svref_2object($coderef);"
NSQ_SOURCE_LINE 00000066 "            $cv->isa('B::CV') or return 0;"
NSQ_SOURCE_LINE 00000067 "            my $p = prototype $coderef;"
NSQ_SOURCE_LINE 00000068 "            defined $p && $p eq \"\" or return 0;"
NSQ_SOURCE_LINE 00000069 "            return ($cv->CvFLAGS & B::CVf_CONST()) == B::CVf_CONST();"
NSQ_SOURCE_LINE 00000070 "        };"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub stash_name   ($) { (get_code_info($_[0]))[0] }"
NSQ_SOURCE_LINE 00000075 "sub sub_name     ($) { (get_code_info($_[0]))[1] }"
NSQ_SOURCE_LINE 00000076 "sub sub_fullname ($) { join '::', get_code_info($_[0]) }"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "1;"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "__END__"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=head1 NAME"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "Sub::Identify - Retrieve names of code references"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "    use Sub::Identify ':all';"
NSQ_SOURCE_LINE 00000089 "    my $subname = sub_name( $some_coderef );"
NSQ_SOURCE_LINE 00000090 "    my $packagename = stash_name( $some_coderef );"
NSQ_SOURCE_LINE 00000091 "    # or, to get all at once..."
NSQ_SOURCE_LINE 00000092 "    my $fully_qualified_name = sub_fullname( $some_coderef );"
NSQ_SOURCE_LINE 00000093 "    defined $subname"
NSQ_SOURCE_LINE 00000094 "        and say \"this coderef points to sub $subname in package $packagename\";"
NSQ_SOURCE_LINE 00000095 "    my ($file, $line) = get_code_location( $some_coderef );"
NSQ_SOURCE_LINE 00000096 "    $file"
NSQ_SOURCE_LINE 00000097 "        and say \"this coderef is defined at line $line in file $file\";"
NSQ_SOURCE_LINE 00000098 "    is_sub_constant( $some_coderef )"
NSQ_SOURCE_LINE 00000099 "        and say \"this coderef points to a constant subroutine\";"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "C<Sub::Identify> allows you to retrieve the real name of code references."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "It provides six functions, all of them taking a code reference."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "C<sub_name> returns the name of the code reference passed as an"
NSQ_SOURCE_LINE 00000108 "argument (or C<__ANON__> if it's an anonymous code reference),"
NSQ_SOURCE_LINE 00000109 "C<stash_name> returns its package, and C<sub_fullname> returns the"
NSQ_SOURCE_LINE 00000110 "concatenation of the two."
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "C<get_code_info> returns a list of two elements, the package and the"
NSQ_SOURCE_LINE 00000113 "subroutine name (in case of you want both and are worried by the speed.)"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "In case of subroutine aliasing, those functions always return the"
NSQ_SOURCE_LINE 00000116 "original name."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "C<get_code_location> returns a two-element list containing the file"
NSQ_SOURCE_LINE 00000119 "name and the line number where the subroutine has been defined."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "C<is_sub_constant> returns a boolean value indicating whether the"
NSQ_SOURCE_LINE 00000122 "subroutine is a constant or not."
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "=head2 Pure-Perl version"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "By default C<Sub::Identify> tries to load an XS implementation of the"
NSQ_SOURCE_LINE 00000127 "C<get_code_info>, C<get_code_location> and (on perl versions 5.16.0 and later)"
NSQ_SOURCE_LINE 00000128 "C<is_sub_constant> functions, for speed; if that fails, or if the environment"
NSQ_SOURCE_LINE 00000129 "variable C<PERL_SUB_IDENTIFY_PP> is defined to a true value, it will fall"
NSQ_SOURCE_LINE 00000130 "back to a pure perl implementation, that uses perl's introspection mechanism,"
NSQ_SOURCE_LINE 00000131 "provided by the C<B> module."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "L<Sub::Util>, part of the module distribution L<Scalar::List::Utils>"
NSQ_SOURCE_LINE 00000136 "since version 1.40. Since this will be a core module starting with perl"
NSQ_SOURCE_LINE 00000137 "5.22.0, it is encouraged to migrate to Sub::Util when possible."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "L<Sub::Name>"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "A git repository for the sources is at L<https://github.com/rgs/Sub-Identify>."
NSQ_SOURCE_LINE 00000144 ""
