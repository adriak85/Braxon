NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub new {"
NSQ_SOURCE_LINE 00000026 "    my $class = shift;"
NSQ_SOURCE_LINE 00000027 "    my %args = @_;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    my $tod = 0;"
NSQ_SOURCE_LINE 00000030 "    if (defined $args{hour}) {"
NSQ_SOURCE_LINE 00000031 "        die \"'hour' must be an integer\""
NSQ_SOURCE_LINE 00000032 "            unless $args{hour} == int($args{hour});"
NSQ_SOURCE_LINE 00000033 "        die \"'hour' must be between 0 & 23\""
NSQ_SOURCE_LINE 00000034 "            unless $args{hour} >= 0 && $args{hour} <= 23;"
NSQ_SOURCE_LINE 00000035 "        $tod += delete($args{hour}) * 3600;"
NSQ_SOURCE_LINE 00000036 "    } else {"
NSQ_SOURCE_LINE 00000037 "        die \"Please specify 'hour'\";"
NSQ_SOURCE_LINE 00000038 "    }"
NSQ_SOURCE_LINE 00000039 "    if (defined $args{minute}) {"
NSQ_SOURCE_LINE 00000040 "        die \"'minute' must be an integer\""
NSQ_SOURCE_LINE 00000041 "            unless $args{minute} == int($args{minute});"
NSQ_SOURCE_LINE 00000042 "        die \"'minute' must be between 0 & 59\""
NSQ_SOURCE_LINE 00000043 "            unless $args{minute} >= 0 && $args{minute} <= 59;"
NSQ_SOURCE_LINE 00000044 "        $tod += delete($args{minute}) * 60;"
NSQ_SOURCE_LINE 00000045 "    } else {"
NSQ_SOURCE_LINE 00000046 "        die \"Please specify 'minute'\";"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 "    if (defined $args{second}) {"
NSQ_SOURCE_LINE 00000049 "        die \"'second' must be an integer\""
NSQ_SOURCE_LINE 00000050 "            unless $args{second} == int($args{second});"
NSQ_SOURCE_LINE 00000051 "        die \"'second' must be between 0 & 59\""
NSQ_SOURCE_LINE 00000052 "            unless $args{second} >= 0 && $args{second} <= 59;"
NSQ_SOURCE_LINE 00000053 "        $tod += delete($args{second});"
NSQ_SOURCE_LINE 00000054 "    } else {"
NSQ_SOURCE_LINE 00000055 "        die \"Please specify 'second'\";"
NSQ_SOURCE_LINE 00000056 "    }"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    if (defined $args{nanosecond}) {"
NSQ_SOURCE_LINE 00000059 "        die \"'nanosecond' must be an integer\""
NSQ_SOURCE_LINE 00000060 "            unless $args{nanosecond} == int($args{nanosecond});"
NSQ_SOURCE_LINE 00000061 "        die \"'nanosecond' must be between 0 & 999_999_999\""
NSQ_SOURCE_LINE 00000062 "            unless $args{nanosecond} >= 0 && $args{nanosecond} <= 999_999_999;"
NSQ_SOURCE_LINE 00000063 "        $tod += delete($args{nanosecond}) / 1e9;"
NSQ_SOURCE_LINE 00000064 "    }"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    die \"Unknown parameter(s): \".join(\", \", sort keys %args) if keys %args;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    return bless \\$tod, $class;"
NSQ_SOURCE_LINE 00000069 "}"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "sub from_float {"
NSQ_SOURCE_LINE 00000072 "    my $class = shift;"
NSQ_SOURCE_LINE 00000073 "    my %args = @_;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    my $tod;"
NSQ_SOURCE_LINE 00000076 "    if (defined $args{float}) {"
NSQ_SOURCE_LINE 00000077 "        $tod = delete($args{float}) + 0;"
NSQ_SOURCE_LINE 00000078 "        die \"'float' must be between 0-86400\""
NSQ_SOURCE_LINE 00000079 "            unless $tod >= 0 && $tod < 86400;"
NSQ_SOURCE_LINE 00000080 "    } else {"
NSQ_SOURCE_LINE 00000081 "        die \"Please specify 'float'\";"
NSQ_SOURCE_LINE 00000082 "    }"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    die \"Unknown parameter(s): \".join(\", \", sort keys %args) if keys %args;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    return bless \\$tod, $class;"
NSQ_SOURCE_LINE 00000087 "}"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "sub from_hms {"
NSQ_SOURCE_LINE 00000090 "    my $class = shift;"
NSQ_SOURCE_LINE 00000091 "    my %args = @_;"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    my $tod;"
NSQ_SOURCE_LINE 00000094 "    if (defined $args{hms}) {"
NSQ_SOURCE_LINE 00000095 "        my $hms = delete $args{hms};"
NSQ_SOURCE_LINE 00000096 "        $hms =~ /\\A([0-9]{1,2}):([0-9]{1,2})(?::([0-9]{1,2})(\\.[0-9]{1,9})?)?\\z/"
NSQ_SOURCE_LINE 00000097 "            or die \"Invalid hms '$hms', must be hh:mm:ss or hh:mm\";"
NSQ_SOURCE_LINE 00000098 "        $tod = $class->new("
NSQ_SOURCE_LINE 00000099 "            hour=>$1, minute=>$2,"
NSQ_SOURCE_LINE 00000100 "            second => defined($3) ? $3 : 0,"
NSQ_SOURCE_LINE 00000101 "            nanosecond=>defined($4) ? $4*1e9 : 0);"
NSQ_SOURCE_LINE 00000102 "    } else {"
NSQ_SOURCE_LINE 00000103 "        die \"Please specify 'hms'\";"
NSQ_SOURCE_LINE 00000104 "    }"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    die \"Unknown parameter(s): \".join(\", \", sort keys %args) if keys %args;"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "    $tod;"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "sub _now {"
NSQ_SOURCE_LINE 00000112 "    require Time::Local;"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "    my ($class, $utc, $time) = @_;"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    my @time = $utc ? gmtime($time) : localtime($time);"
NSQ_SOURCE_LINE 00000117 "    @time[0..2] = (0,0,0);"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "    my $time_bod = $utc ?"
NSQ_SOURCE_LINE 00000120 "        Time::Local::timegm(@time) : Time::Local::timelocal(@time);"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    my $tod = $time - $time_bod;"
NSQ_SOURCE_LINE 00000123 "    return bless \\$tod, $class;"
NSQ_SOURCE_LINE 00000124 "}"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "sub now_local {"
NSQ_SOURCE_LINE 00000127 "    my $class = shift;"
NSQ_SOURCE_LINE 00000128 "    $class->_now(0, time());"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "sub now_utc {"
NSQ_SOURCE_LINE 00000132 "    my $class = shift;"
NSQ_SOURCE_LINE 00000133 "    $class->_now(1, time());"
NSQ_SOURCE_LINE 00000134 "}"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "sub hires_now_local {"
NSQ_SOURCE_LINE 00000137 "    require Time::HiRes;"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    my $class = shift;"
NSQ_SOURCE_LINE 00000140 "    $class->_now(0, Time::HiRes::time());"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "sub hires_now_utc {"
NSQ_SOURCE_LINE 00000144 "    require Time::HiRes;"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    my $class = shift;"
NSQ_SOURCE_LINE 00000147 "    $class->_now(1, Time::HiRes::time());"
NSQ_SOURCE_LINE 00000148 "}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "sub _elements {"
NSQ_SOURCE_LINE 00000151 "    my $self = shift;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    my $n = $$self;"
NSQ_SOURCE_LINE 00000154 "    my $hour   = int($n / 3600); $n -= $hour*3600;"
NSQ_SOURCE_LINE 00000155 "    my $minute = int($n /   60); $n -= $minute*60;"
NSQ_SOURCE_LINE 00000156 "    my $second = int($n);        $n -= $second;"
NSQ_SOURCE_LINE 00000157 "    my $nanosecond = sprintf(\"%.0f\", $n*1e9);"
NSQ_SOURCE_LINE 00000158 "    ($hour, $minute, $second, $nanosecond);"
NSQ_SOURCE_LINE 00000159 "}"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "sub hour {"
NSQ_SOURCE_LINE 00000162 "    my $self = shift;"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "    my ($hour, $minute, $second, $nanosecond) = $self->_elements;"
NSQ_SOURCE_LINE 00000165 "    $hour;"
NSQ_SOURCE_LINE 00000166 "}"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "sub minute {"
NSQ_SOURCE_LINE 00000169 "    my $self = shift;"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    my ($hour, $minute, $second, $nanosecond) = $self->_elements;"
NSQ_SOURCE_LINE 00000172 "    $minute;"
NSQ_SOURCE_LINE 00000173 "}"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "sub second {"
NSQ_SOURCE_LINE 00000176 "    my $self = shift;"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "    my ($hour, $minute, $second, $nanosecond) = $self->_elements;"
NSQ_SOURCE_LINE 00000179 "    $second;"
NSQ_SOURCE_LINE 00000180 "}"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "sub nanosecond {"
NSQ_SOURCE_LINE 00000183 "    my $self = shift;"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "    my ($hour, $minute, $second, $nanosecond) = $self->_elements;"
NSQ_SOURCE_LINE 00000186 "    $nanosecond;"
NSQ_SOURCE_LINE 00000187 "}"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "sub float {"
NSQ_SOURCE_LINE 00000190 "    my $self = shift;"
NSQ_SOURCE_LINE 00000191 "    $$self;"
NSQ_SOURCE_LINE 00000192 "}"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "sub hms {"
NSQ_SOURCE_LINE 00000195 "    my ($self, $sep) = @_;"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "    $sep //= \":\";"
NSQ_SOURCE_LINE 00000198 "    my ($hour, $minute, $second, $nanosecond) = $self->_elements;"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    sprintf(\"%02d%s%02d%s%02d\", $hour, $sep, $minute, $sep, $second);"
NSQ_SOURCE_LINE 00000201 "}"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "sub stringify {"
NSQ_SOURCE_LINE 00000204 "    my $self = shift;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    my ($hour, $minute, $second, $nanosecond) = $self->_elements;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    if ($nanosecond) {"
NSQ_SOURCE_LINE 00000209 "        sprintf("
NSQ_SOURCE_LINE 00000210 "            \"%02d:%02d:%s%.11g\","
NSQ_SOURCE_LINE 00000211 "            $hour,"
NSQ_SOURCE_LINE 00000212 "            $minute,"
NSQ_SOURCE_LINE 00000213 "            $second < 10 ? \"0\" : \"\","
NSQ_SOURCE_LINE 00000214 "            $second + $nanosecond/1e9);"
NSQ_SOURCE_LINE 00000215 "    } else {"
NSQ_SOURCE_LINE 00000216 "        sprintf(\"%02d:%02d:%02d\", $hour, $minute, $second);"
NSQ_SOURCE_LINE 00000217 "    }"
NSQ_SOURCE_LINE 00000218 "}"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "sub strftime {"
NSQ_SOURCE_LINE 00000221 "    # XXX"
NSQ_SOURCE_LINE 00000222 "}"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "sub compare {"
NSQ_SOURCE_LINE 00000225 "    my $class = ref $_[0] ? undef : shift;"
NSQ_SOURCE_LINE 00000226 "    my ($tod1, $tod2) = @_;"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "    unless ($tod1->can('float') && $tod2->can('float')) {"
NSQ_SOURCE_LINE 00000229 "        die \"A Date::TimeOfDay object can only be compared to another \"."
NSQ_SOURCE_LINE 00000230 "            \"Date::TimeOfDay object\";"
NSQ_SOURCE_LINE 00000231 "    }"
NSQ_SOURCE_LINE 00000232 "    $tod1->float <=> $tod2->float;"
NSQ_SOURCE_LINE 00000233 "}"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "sub _compare_overload {"
NSQ_SOURCE_LINE 00000236 "    my ($tod1, $tod2, $flip) = @_;"
NSQ_SOURCE_LINE 00000237 "    ($flip ? -1:1) * (compare($tod1, $tod2));"
NSQ_SOURCE_LINE 00000238 "}"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "sub _string_compare_overload {"
NSQ_SOURCE_LINE 00000241 "    my ($tod1, $tod2, $flip) = @_;"
NSQ_SOURCE_LINE 00000242 "    ($flip ? -1:1) * (\"$tod1\" cmp \"$tod2\");"
NSQ_SOURCE_LINE 00000243 "}"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "sub _string_equals_overload {"
NSQ_SOURCE_LINE 00000246 "    my ($tod1, $tod2) = @_;"
NSQ_SOURCE_LINE 00000247 "    \"$tod1\" eq \"$tod2\";"
NSQ_SOURCE_LINE 00000248 "}"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "sub _string_not_equals_overload {"
NSQ_SOURCE_LINE 00000251 "    my ($tod1, $tod2) = @_;"
NSQ_SOURCE_LINE 00000252 "    \"$tod1\" ne \"$tod2\";"
NSQ_SOURCE_LINE 00000253 "}"
