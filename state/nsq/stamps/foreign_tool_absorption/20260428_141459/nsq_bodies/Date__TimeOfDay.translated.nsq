NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=head1 NAME"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "Date::TimeOfDay - Represent time of day (hh:mm:ss)"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=head1 VERSION"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "This document describes version 0.006 of Date::TimeOfDay (from Perl distribution Date-TimeOfDay), released on 2022-09-22."
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 " use Date::TimeOfDay;"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 " my $tod = Date::TimeOfDay->new("
NSQ_SOURCE_LINE 00000277 "     hour=>23, minute=>59, second=>59,"
NSQ_SOURCE_LINE 00000278 "     # nanosecond => 999_999_999, # optional"
NSQ_SOURCE_LINE 00000279 " );"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "B<EARLY RELEASE, API MIGHT CHANGE WITHOUT NOTICE.>"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "This is a simple module to represent time of day. Interface is modelled after"
NSQ_SOURCE_LINE 00000286 "L<DateTime>. Internal representation is currently float (number of seconds from"
NSQ_SOURCE_LINE 00000287 "midnight 00:00:00). Currently does not handle leap second nor time zone."
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "TODO:"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 " * set"
NSQ_SOURCE_LINE 00000292 " * strftime"
NSQ_SOURCE_LINE 00000293 " * add DateTime + TimeOfDay"
NSQ_SOURCE_LINE 00000294 " * add TimeOfDay + TimeOfDay"
NSQ_SOURCE_LINE 00000295 " * convert to duration"
NSQ_SOURCE_LINE 00000296 " * convert to another time zone"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "=head1 METHODS"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=head2 new"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=head2 from_hms"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "Example:"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 " my $tod = Date::TimeOfDay->from_hms(hms => \"23:59:59\");"
NSQ_SOURCE_LINE 00000307 " say $tod; # => \"23:59:59\""
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head2 from_float"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "Example:"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 " my $tod = Date::TimeOfDay->from_float(float => 86399);"
NSQ_SOURCE_LINE 00000314 " say $tod; # => \"23:59:59\""
