NSQ_SOURCE_LINE 00000001 "package Text::Table::TinyWide;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2016-10-19'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.001'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.006;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use List::Util qw();"
NSQ_SOURCE_LINE 00000011 "use Text::WideChar::Util qw(mbswidth mbpad);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw/ generate_table /;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our $COLUMN_SEPARATOR = '|';"
NSQ_SOURCE_LINE 00000017 "our $ROW_SEPARATOR = '-';"
NSQ_SOURCE_LINE 00000018 "our $CORNER_MARKER = '+';"
NSQ_SOURCE_LINE 00000019 "our $HEADER_ROW_SEPARATOR = '=';"
NSQ_SOURCE_LINE 00000020 "our $HEADER_CORNER_MARKER = 'O';"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub generate_table {"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    my %params = @_;"
NSQ_SOURCE_LINE 00000025 "    my $rows = $params{rows} or die \"Must provide rows!\";"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    # foreach col, get the biggest width"
NSQ_SOURCE_LINE 00000028 "    my $widths = _maxwidths($rows);"
NSQ_SOURCE_LINE 00000029 "    my $max_index = _max_array_index($rows);"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    # use that to get the field format and separators"
NSQ_SOURCE_LINE 00000032 "    my $format = _get_format($widths);"
NSQ_SOURCE_LINE 00000033 "    my $row_sep = _get_row_separator($widths);"
NSQ_SOURCE_LINE 00000034 "    my $head_row_sep = _get_header_row_separator($widths);"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    # here we go..."
NSQ_SOURCE_LINE 00000037 "    my @table;"
NSQ_SOURCE_LINE 00000038 "    push @table, $row_sep;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    # if the first row's a header:"
NSQ_SOURCE_LINE 00000041 "    my $data_begins = 0;"
NSQ_SOURCE_LINE 00000042 "    if ( $params{header_row} ) {"
NSQ_SOURCE_LINE 00000043 "        my $header_row = $rows->[0];"
NSQ_SOURCE_LINE 00000044 "        $data_begins++;"
NSQ_SOURCE_LINE 00000045 "        push @table, sprintf("
NSQ_SOURCE_LINE 00000046 "                         $format,"
NSQ_SOURCE_LINE 00000047 "                         map { mbpad((defined($header_row->[$_]) ? $header_row->[$_] : ''), $widths->[$_]) } (0..$max_index)"
NSQ_SOURCE_LINE 00000048 "                     );"
NSQ_SOURCE_LINE 00000049 "        push @table, $params{separate_rows} ? $head_row_sep : $row_sep;"
NSQ_SOURCE_LINE 00000050 "    }"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    # then the data"
NSQ_SOURCE_LINE 00000053 "    foreach my $row ( @{ $rows }[$data_begins..$#$rows] ) {"
NSQ_SOURCE_LINE 00000054 "        push @table, sprintf("
NSQ_SOURCE_LINE 00000055 "\t    $format,"
NSQ_SOURCE_LINE 00000056 "\t    map { mbpad((defined($row->[$_]) ? $row->[$_] : ''), $widths->[$_]) } (0..$max_index)"
NSQ_SOURCE_LINE 00000057 "\t);"
NSQ_SOURCE_LINE 00000058 "        push @table, $row_sep if $params{separate_rows};"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    # this will have already done the bottom if called explicitly"
NSQ_SOURCE_LINE 00000062 "    push @table, $row_sep unless $params{separate_rows};"
NSQ_SOURCE_LINE 00000063 "    return join(\"\\n\",grep {$_} @table);"
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "sub _get_cols_and_rows ($) {"
NSQ_SOURCE_LINE 00000067 "    my $rows = shift;"
NSQ_SOURCE_LINE 00000068 "    return ( List::Util::max( map { scalar @$_ } @$rows), scalar @$rows);"
NSQ_SOURCE_LINE 00000069 "}"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "sub _maxwidths {"
NSQ_SOURCE_LINE 00000072 "    my $rows = shift;"
NSQ_SOURCE_LINE 00000073 "    # what's the longest array in this list of arrays?"
NSQ_SOURCE_LINE 00000074 "    my $max_index = _max_array_index($rows);"
NSQ_SOURCE_LINE 00000075 "    my $widths = [];"
NSQ_SOURCE_LINE 00000076 "    for my $i (0..$max_index) {"
NSQ_SOURCE_LINE 00000077 "        # go through the $i-th element of each array, find the longest"
NSQ_SOURCE_LINE 00000078 "        my $max = List::Util::max(map {defined $$_[$i] ? mbswidth($$_[$i]) : 0} @$rows);"
NSQ_SOURCE_LINE 00000079 "        push @$widths, $max;"
NSQ_SOURCE_LINE 00000080 "    }"
NSQ_SOURCE_LINE 00000081 "    return $widths;"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "# return highest top-index from all rows in case they're different lengths"
NSQ_SOURCE_LINE 00000085 "sub _max_array_index {"
NSQ_SOURCE_LINE 00000086 "    my $rows = shift;"
NSQ_SOURCE_LINE 00000087 "    return List::Util::max( map { $#$_ } @$rows );"
NSQ_SOURCE_LINE 00000088 "}"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "sub _get_format {"
NSQ_SOURCE_LINE 00000091 "    my $widths = shift;"
NSQ_SOURCE_LINE 00000092 "    return \"$COLUMN_SEPARATOR \".join(\" $COLUMN_SEPARATOR \",map { \"%s\" } @$widths).\" $COLUMN_SEPARATOR\";"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub _get_row_separator {"
NSQ_SOURCE_LINE 00000096 "    my $widths = shift;"
NSQ_SOURCE_LINE 00000097 "    return \"$CORNER_MARKER$ROW_SEPARATOR\".join(\"$ROW_SEPARATOR$CORNER_MARKER$ROW_SEPARATOR\",map { $ROW_SEPARATOR x $_ } @$widths).\"$ROW_SEPARATOR$CORNER_MARKER\";"
NSQ_SOURCE_LINE 00000098 "}"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "sub _get_header_row_separator {"
NSQ_SOURCE_LINE 00000101 "    my $widths = shift;"
NSQ_SOURCE_LINE 00000102 "    return \"$HEADER_CORNER_MARKER$HEADER_ROW_SEPARATOR\".join(\"$HEADER_ROW_SEPARATOR$HEADER_CORNER_MARKER$HEADER_ROW_SEPARATOR\",map { $HEADER_ROW_SEPARATOR x $_ } @$widths).\"$HEADER_ROW_SEPARATOR$HEADER_CORNER_MARKER\";"
NSQ_SOURCE_LINE 00000103 "}"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "# Back-compat: 'table' is an alias for 'generate_table', but isn't exported"
NSQ_SOURCE_LINE 00000106 "{"
NSQ_SOURCE_LINE 00000107 "    no warnings 'once';"
NSQ_SOURCE_LINE 00000108 "    *table = \\&generate_table;"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "1;"
NSQ_SOURCE_LINE 00000112 "# ABSTRACT: Text::Table::Tiny + support for wide character"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "__END__"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=pod"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=head1 NAME"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "Text::Table::TinyWide - Text::Table::Tiny + support for wide character"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "=head1 VERSION"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "This document describes version 0.001 of Text::Table::TinyWide (from Perl distribution Text-Table-TinyWide), released on 2016-10-19."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 " use Text::Table::TinyWide qw/ generate_table /;"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 " my $rows = ["
NSQ_SOURCE_LINE 00000133 "     # header row"
NSQ_SOURCE_LINE 00000134 "     ['Name', 'Rank', 'Serial'],"
NSQ_SOURCE_LINE 00000135 "     # rows"
NSQ_SOURCE_LINE 00000136 "     [\"\\x{7231}\\x{4E3D}\\x{4E1D}\", 'pvt', '123456'],"
NSQ_SOURCE_LINE 00000137 "     ['bob',   'cpl', '98765321'],"
NSQ_SOURCE_LINE 00000138 "     ['carol', 'brig gen', '8745'],"
NSQ_SOURCE_LINE 00000139 " ];"
NSQ_SOURCE_LINE 00000140 " binmode('STDOUT', ':utf8');"
NSQ_SOURCE_LINE 00000141 " print generate_table(rows => $rows, header_row => 1);"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "This module is like L<Text::Table::Tiny> (0.04) with added support for wide"
NSQ_SOURCE_LINE 00000146 "characters. With this module, text with wide characters will still line up."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "Interface, options, and format variables are the same as in Text::Table::Tiny."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=for Pod::Coverage ^(.+)$"
NSQ_SOURCE_LINE 00000151 ""
