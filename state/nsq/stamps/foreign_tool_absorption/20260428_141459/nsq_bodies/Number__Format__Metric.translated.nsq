BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Number::Format::Metric;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use locale;"
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use utf8;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000012 "our $DATE = '2025-09-24'; # DATE"
NSQ_SOURCE_LINE 00000013 "our $DIST = 'Number-Format-Metric'; # DIST"
NSQ_SOURCE_LINE 00000014 "our $VERSION = '0.604'; # VERSION"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000017 "                       format_metric"
NSQ_SOURCE_LINE 00000018 "               );"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "sub format_metric {"
NSQ_SOURCE_LINE 00000021 "    my ($num, $opts) = @_;"
NSQ_SOURCE_LINE 00000022 "    $opts //= {};"
NSQ_SOURCE_LINE 00000023 "    $opts->{base} //= 2;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    my $im    = $opts->{i_mark} // 1;"
NSQ_SOURCE_LINE 00000026 "    my $base0 = $opts->{base};"
NSQ_SOURCE_LINE 00000027 "    my $base  = $base0 == 2 ? 1024 : 1000;"
NSQ_SOURCE_LINE 00000028 "    my $uck   = $opts->{uppercase_k};"
NSQ_SOURCE_LINE 00000029 "    my $latin = $opts->{latin_only};"
NSQ_SOURCE_LINE 00000030 "    my $addp  = $opts->{additional_prefix} // '';"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    my $rank;"
NSQ_SOURCE_LINE 00000033 "    my $prefix;"
NSQ_SOURCE_LINE 00000034 "    if ($num == 0) {"
NSQ_SOURCE_LINE 00000035 "        $rank = 0;"
NSQ_SOURCE_LINE 00000036 "        $prefix = \"\";"
NSQ_SOURCE_LINE 00000037 "    } else {"
NSQ_SOURCE_LINE 00000038 "        $rank = int(log(abs($num))/log($base));"
NSQ_SOURCE_LINE 00000039 "        if    ($rank ==  0 && abs($num) >= 1) { $prefix = \"\"  }"
NSQ_SOURCE_LINE 00000040 "        elsif ($rank ==  1) { my $k = $uck ? \"K\" : \"k\"; $prefix = $im && $base0==10 ? \"${k}i\" : $k } # kilo"
NSQ_SOURCE_LINE 00000041 "        elsif ($rank ==  2) { $prefix = $im && $base0==10 ? \"Mi\" : \"M\" } # mega"
NSQ_SOURCE_LINE 00000042 "        elsif ($rank ==  3) { $prefix = $im && $base0==10 ? \"Gi\" : \"G\" } # giga"
NSQ_SOURCE_LINE 00000043 "        elsif ($rank ==  4) { $prefix = $im && $base0==10 ? \"Ti\" : \"T\" } # tera"
NSQ_SOURCE_LINE 00000044 "        elsif ($rank ==  5) { $prefix = $im && $base0==10 ? \"Pi\" : \"P\" } # peta"
NSQ_SOURCE_LINE 00000045 "        elsif ($rank >=  8) { $prefix = $im && $base0==10 ? \"Yi\" : \"Y\" } # yotta"
NSQ_SOURCE_LINE 00000046 "        elsif ($rank ==  7) { $prefix = $im && $base0==10 ? \"Zi\" : \"Z\" } # zetta"
NSQ_SOURCE_LINE 00000047 "        elsif ($rank ==  6) { $prefix = $im && $base0==10 ? \"Ei\" : \"E\" } # exa"
NSQ_SOURCE_LINE 00000048 "        elsif ($rank ==  0) { $prefix = \"m\" } # milli"
NSQ_SOURCE_LINE 00000049 "        elsif ($rank == -1) { $prefix = $latin ? \"mc\" : \"μ\" } # micro"
NSQ_SOURCE_LINE 00000050 "        elsif ($rank == -2) { $prefix = \"n\" } # nano"
NSQ_SOURCE_LINE 00000051 "        elsif ($rank == -3) { $prefix = \"p\" } # pico"
NSQ_SOURCE_LINE 00000052 "        elsif ($rank == -4) { $prefix = \"f\" } # femto"
NSQ_SOURCE_LINE 00000053 "        elsif ($rank == -5) { $prefix = \"a\" } # atto"
NSQ_SOURCE_LINE 00000054 "        elsif ($rank == -6) { $prefix = \"z\" } # zepto"
NSQ_SOURCE_LINE 00000055 "        elsif ($rank <= -7) { $prefix = \"y\" } # yocto"
NSQ_SOURCE_LINE 00000056 "    }"
NSQ_SOURCE_LINE 00000057 "    $prefix .= $addp;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    my $prec = $opts->{precision} // 1;"
NSQ_SOURCE_LINE 00000060 "    $num = $num / $base**($rank <= 0 && abs($num) < 1 ? $rank-1 : $rank);"
NSQ_SOURCE_LINE 00000061 "    if ($opts->{return_array}) {"
NSQ_SOURCE_LINE 00000062 "        return [$num, $prefix];"
NSQ_SOURCE_LINE 00000063 "    } else {"
NSQ_SOURCE_LINE 00000064 "        my $snum = sprintf(\"%.${prec}f\", $num);"
NSQ_SOURCE_LINE 00000065 "        return $snum . $prefix;"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 "}"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "1;"
NSQ_SOURCE_LINE 00000070 "# ABSTRACT: Format number with metric prefix, with some options"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "__END__"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=pod"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=head1 NAME"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "Number::Format::Metric - Format number with metric prefix, with some options"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=head1 VERSION"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "This document describes version 0.604 of Number::Format::Metric (from Perl distribution Number-Format-Metric), released on 2025-09-24."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 " use Number::Format::Metric qw(format_metric);"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 " # precision option"
NSQ_SOURCE_LINE 00000091 " format_metric(14     , {base=>10});               # => \"14.0\""
NSQ_SOURCE_LINE 00000092 " format_metric(14     , {base=>10, precision=>0}); # => \"14\""
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 " # base 2 vs base 10"
NSQ_SOURCE_LINE 00000095 " format_metric(12001  , {base=> 2, precision=>1});                 # => \"11.7k\""
NSQ_SOURCE_LINE 00000096 " format_metric(12001  , {base=>10, precision=>3});                 # => \"12.001ki\""
NSQ_SOURCE_LINE 00000097 " format_metric(-0.0017, {base=>10});                               # => \"-1.7m\""
NSQ_SOURCE_LINE 00000098 " format_metric(1.26e6 , {base=>10});                               # => \"1.3Mi\""
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 " # don't use \"i\" mark for base 10"
NSQ_SOURCE_LINE 00000101 " format_metric(12001  , {base=>10, precision=>3, i_mark=>0});      # => \"12.001k\""
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 " # uppercase_k option"
NSQ_SOURCE_LINE 00000104 " format_metric(12001  , {base=>10, precision=>3, uppercase_k=>1}); # => \"12.001Ki\""
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 " # additional_prefix option"
NSQ_SOURCE_LINE 00000107 " format_metric(12001  , {base=> 2, precision=>1, additional_prefix=>\"b\"});    # => \"11.7kb\""
NSQ_SOURCE_LINE 00000108 " format_metric(12001  , {base=>10, precision=>1, additional_prefix=>\"bps\"});  # => \"12.0kbps\""
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 " # latin_only option"
NSQ_SOURCE_LINE 00000111 " format_metric(2.3e-6 , {base=>10, precision=>1, additional_prefix=>\"g\"});                # => \"2.3μg\""
NSQ_SOURCE_LINE 00000112 " format_metric(2.3e-6 , {base=>10, precision=>1, additional_prefix=>\"g\", latin_only=>1}); # => \"2.3mcg\""
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "None exported by default but all of them exportable."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=head2 format_metric($num, \\%opts) => STR"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "Format C<$num> using metric prefix. Locale settings are respected (this module"
NSQ_SOURCE_LINE 00000121 "uses L<locale>)."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "Might produce non-Latin Unicode characters (e.g. \"μ\" for 1e-6 prefix), unless if"
NSQ_SOURCE_LINE 00000124 "you set the C<latin_only> option, in which case \"μ\" will be shown as \"mc\"."
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "Known options:"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=over"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=item * base => INT (either 2 or 10, default: 2)"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=item * precision => INT"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=item * i_mark => BOOL (default: 1)"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "Give \"i\" suffix to prefixes when in base 10 for k, M, G, T, and so on."
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=item * uppercase_k => BOOL (default: 0)"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "When set to true, will use \"K\" instead of \"k\" for kilo."
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=item * latin_only => BOOL (default: 0)"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "When set to true, will use \"mc\" instead of \"μ\" for micro."
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=item * additional_prefix => STR"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "String to add after the prefix, e.g. \"b\" (for byte), \"g\" (for gram), etc."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=back"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "Please visit the project's homepage at L<https://metacpan.org/release/Number-Format-Metric>."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "Source repository is at L<https://github.com/perlancar/perl-Number-Format-Metric>."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head2 Unformatting numbers"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "L<Data::Sah::Coerce> coerce module:"
NSQ_SOURCE_LINE 00000165 "L<Data::Sah::Coerce::perl::To_float::From_str::suffix_datasize> and"
NSQ_SOURCE_LINE 00000166 "L<Data::Sah::Coerce::perl::To_float::From_str::suffix_datasize>. Example of"
NSQ_SOURCE_LINE 00000167 "using this can be seen in L<datasize-from-metric> and L<dataspeed-from-metric>"
NSQ_SOURCE_LINE 00000168 "(included in the L<App::DataSizeSpeedUtils> distribution)."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "=head2 Other number formatting modules"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "L<Number::Format> can format several kinds of numbers e.g. bytes (\"2.3KB\") or"
NSQ_SOURCE_LINE 00000173 "prices (\"USD 5,000\") as well as format using template (\"picture\") like"
NSQ_SOURCE_LINE 00000174 "`sprintf`. But for metric prefixes it only supports kilo, kibi, mega, mebi,"
NSQ_SOURCE_LINE 00000175 "giga, gibi. It can also unformat numbers back to floating point form."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "L<Format::Human::Bytes> supports formatting bytes with prefixes kilo, mega,"
NSQ_SOURCE_LINE 00000178 "giga, and tera."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "L<Number::Bytes::Human> supports formatting with prefixes kilo (2^10) to yotta"
NSQ_SOURCE_LINE 00000181 "(2^70), but does not support smaller prefixes, e.g. milli, micro, etc."
NSQ_SOURCE_LINE 00000182 "Obviously."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "L<https://en.wikipedia.org/wiki/Metric_prefix>"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=head1 AUTHOR"
