NSQ_SOURCE_LINE 00000019 "sub mode_merge {"
NSQ_SOURCE_LINE 00000020 "    my ($l, $r, $config_vars) = @_;"
NSQ_SOURCE_LINE 00000021 "    my $mm = __PACKAGE__->new(config => $config_vars);"
NSQ_SOURCE_LINE 00000022 "    $mm->merge($l, $r);"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "has config => (is => \"rw\");"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "# hash of modename => handler"
NSQ_SOURCE_LINE 00000028 "has modes => (is => 'rw', default => sub { {} });"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "has combine_rules => (is => 'rw');"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "# merging process state"
NSQ_SOURCE_LINE 00000033 "has path => (is => \"rw\", default => sub { [] });"
NSQ_SOURCE_LINE 00000034 "has errors => (is => \"rw\", default => sub { [] });"
NSQ_SOURCE_LINE 00000035 "has mem => (is => \"rw\", default => sub { {} }); # for handling circular refs. {key=>{res=>[...], todo=>[sub1, ...]}, ...}"
NSQ_SOURCE_LINE 00000036 "has cur_mem_key => (is => \"rw\"); # for handling circular refs. instead of passing around this as argument, we put it here."
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "sub _in($$) {"
NSQ_SOURCE_LINE 00000039 "    state $load_dmp = do { require Data::Dmp };"
NSQ_SOURCE_LINE 00000040 "    my ($self, $needle, $haystack) = @_;"
NSQ_SOURCE_LINE 00000041 "    return 0 unless defined($needle);"
NSQ_SOURCE_LINE 00000042 "    my $r1 = ref($needle);"
NSQ_SOURCE_LINE 00000043 "    my $f1 = $r1 ? Data::Dmp::dmp($needle) : undef;"
NSQ_SOURCE_LINE 00000044 "    for (@$haystack) {"
NSQ_SOURCE_LINE 00000045 "        my $r2 = ref($_);"
NSQ_SOURCE_LINE 00000046 "        next if $r1 xor $r2;"
NSQ_SOURCE_LINE 00000047 "        return 1 if  $r2 && $f1 eq Data::Dmp::dmp($_);"
NSQ_SOURCE_LINE 00000048 "        return 1 if !$r2 && $needle eq $_;"
NSQ_SOURCE_LINE 00000049 "    }"
NSQ_SOURCE_LINE 00000050 "    0;"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "sub BUILD {"
NSQ_SOURCE_LINE 00000054 "    require Data::ModeMerge::Config;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    my ($self, $args) = @_;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    if ($self->config) {"
NSQ_SOURCE_LINE 00000059 "        # some sanity checks"
NSQ_SOURCE_LINE 00000060 "        my $is_hashref = ref($self->config) eq 'HASH';"
NSQ_SOURCE_LINE 00000061 "        die \"config must be a hashref or a Data::ModeMerge::Config\" unless"
NSQ_SOURCE_LINE 00000062 "            $is_hashref || UNIVERSAL::isa($self->config, \"Data::ModeMerge::Config\");"
NSQ_SOURCE_LINE 00000063 "        $self->config(Data::ModeMerge::Config->new(%{ $self->config })) if $is_hashref;"
NSQ_SOURCE_LINE 00000064 "    } else {"
NSQ_SOURCE_LINE 00000065 "        $self->config(Data::ModeMerge::Config->new);"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    for (qw(NORMAL KEEP ADD CONCAT SUBTRACT DELETE)) {"
NSQ_SOURCE_LINE 00000069 "\t$self->register_mode($_);"
NSQ_SOURCE_LINE 00000070 "    }"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "    if (!$self->combine_rules) {"
NSQ_SOURCE_LINE 00000073 "        $self->combine_rules({"
NSQ_SOURCE_LINE 00000074 "            # \"left + right\" => [which mode to use, which mode after merge]"
NSQ_SOURCE_LINE 00000075 "            'ADD+ADD'            => ['ADD'     , 'ADD'   ],"
NSQ_SOURCE_LINE 00000076 "            #'ADD+CONCAT'         => undef,"
NSQ_SOURCE_LINE 00000077 "            'ADD+DELETE'         => ['DELETE'  , 'DELETE'],"
NSQ_SOURCE_LINE 00000078 "            #'ADD+KEEP'           => undef,"
NSQ_SOURCE_LINE 00000079 "            'ADD+NORMAL'         => ['NORMAL'  , 'NORMAL'],"
NSQ_SOURCE_LINE 00000080 "            'ADD+SUBTRACT'       => ['SUBTRACT', 'ADD'   ],"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "            #'CONCAT+ADD'         => undef,"
NSQ_SOURCE_LINE 00000083 "            'CONCAT+CONCAT'      => ['CONCAT'  , 'CONCAT'],"
NSQ_SOURCE_LINE 00000084 "            'CONCAT+DELETE'      => ['DELETE'  , 'DELETE'],"
NSQ_SOURCE_LINE 00000085 "            #'CONCAT+KEEP'        => undef,"
NSQ_SOURCE_LINE 00000086 "            'CONCAT+NORMAL'      => ['NORMAL'  , 'NORMAL'],"
NSQ_SOURCE_LINE 00000087 "            #'CONCAT+SUBTRACT'    => undef,"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "            'DELETE+ADD'         => ['NORMAL'  , 'ADD'     ],"
NSQ_SOURCE_LINE 00000090 "            'DELETE+CONCAT'      => ['NORMAL'  , 'CONCAT'  ],"
NSQ_SOURCE_LINE 00000091 "            'DELETE+DELETE'      => ['DELETE'  , 'DELETE'  ],"
NSQ_SOURCE_LINE 00000092 "            'DELETE+KEEP'        => ['NORMAL'  , 'KEEP'    ],"
NSQ_SOURCE_LINE 00000093 "            'DELETE+NORMAL'      => ['NORMAL'  , 'NORMAL'  ],"
NSQ_SOURCE_LINE 00000094 "            'DELETE+SUBTRACT'    => ['NORMAL'  , 'SUBTRACT'],"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "            'KEEP+ADD'          => ['KEEP', 'KEEP'],"
NSQ_SOURCE_LINE 00000097 "            'KEEP+CONCAT'       => ['KEEP', 'KEEP'],"
NSQ_SOURCE_LINE 00000098 "            'KEEP+DELETE'       => ['KEEP', 'KEEP'],"
NSQ_SOURCE_LINE 00000099 "            'KEEP+KEEP'         => ['KEEP', 'KEEP'],"
NSQ_SOURCE_LINE 00000100 "            'KEEP+NORMAL'       => ['KEEP', 'KEEP'],"
NSQ_SOURCE_LINE 00000101 "            'KEEP+SUBTRACT'     => ['KEEP', 'KEEP'],"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "            'NORMAL+ADD'        => ['ADD'     , 'NORMAL'],"
NSQ_SOURCE_LINE 00000104 "            'NORMAL+CONCAT'     => ['CONCAT'  , 'NORMAL'],"
NSQ_SOURCE_LINE 00000105 "            'NORMAL+DELETE'     => ['DELETE'  , 'NORMAL'],"
NSQ_SOURCE_LINE 00000106 "            'NORMAL+KEEP'       => ['NORMAL'  , 'KEEP'  ],"
NSQ_SOURCE_LINE 00000107 "            'NORMAL+NORMAL'     => ['NORMAL'  , 'NORMAL'],"
NSQ_SOURCE_LINE 00000108 "            'NORMAL+SUBTRACT'   => ['SUBTRACT', 'NORMAL'],"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "            'SUBTRACT+ADD'      => ['SUBTRACT', 'SUBTRACT'],"
NSQ_SOURCE_LINE 00000111 "            #'SUBTRACT+CONCAT'   => undef,"
NSQ_SOURCE_LINE 00000112 "            'SUBTRACT+DELETE'   => ['DELETE'  , 'DELETE'  ],"
NSQ_SOURCE_LINE 00000113 "            #'SUBTRACT+KEEP'     => undef,"
NSQ_SOURCE_LINE 00000114 "            'SUBTRACT+NORMAL'   => ['NORMAL'  , 'NORMAL'  ],"
NSQ_SOURCE_LINE 00000115 "            'SUBTRACT+SUBTRACT' => ['ADD'     , 'SUBTRACT'],"
NSQ_SOURCE_LINE 00000116 "        });"
NSQ_SOURCE_LINE 00000117 "    }"
NSQ_SOURCE_LINE 00000118 "}"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "sub push_error {"
NSQ_SOURCE_LINE 00000121 "    my ($self, $errmsg) = @_;"
NSQ_SOURCE_LINE 00000122 "    push @{ $self->errors }, [[@{ $self->path }], $errmsg];"
NSQ_SOURCE_LINE 00000123 "    return;"
NSQ_SOURCE_LINE 00000124 "}"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "sub register_mode {"
NSQ_SOURCE_LINE 00000127 "    my ($self, $name0) = @_;"
NSQ_SOURCE_LINE 00000128 "    my $obj;"
NSQ_SOURCE_LINE 00000129 "    if (ref($name0)) {"
NSQ_SOURCE_LINE 00000130 "        my $obj = $name0;"
NSQ_SOURCE_LINE 00000131 "    } elsif ($name0 =~ /^\\w+(::\\w+)+$/) {"
NSQ_SOURCE_LINE 00000132 "        eval \"require $name0; \\$obj = $name0->new\";"
NSQ_SOURCE_LINE 00000133 "        die \"Can't load module $name0: $@\" if $@;"
NSQ_SOURCE_LINE 00000134 "    } elsif ($name0 =~ /^\\w+$/) {"
NSQ_SOURCE_LINE 00000135 "        my $modname = \"Data::ModeMerge::Mode::$name0\";"
NSQ_SOURCE_LINE 00000136 "        eval \"require $modname; \\$obj = $modname->new\";"
NSQ_SOURCE_LINE 00000137 "        die \"Can't load module $modname: $@\" if $@;"
NSQ_SOURCE_LINE 00000138 "    } else {"
NSQ_SOURCE_LINE 00000139 "        die \"Invalid mode name $name0\";"
NSQ_SOURCE_LINE 00000140 "    }"
NSQ_SOURCE_LINE 00000141 "    my $name = $obj->name;"
NSQ_SOURCE_LINE 00000142 "    die \"Mode $name already registered\" if $self->modes->{$name};"
NSQ_SOURCE_LINE 00000143 "    $obj->merger($self);"
NSQ_SOURCE_LINE 00000144 "    $self->modes->{$name} = $obj;"
NSQ_SOURCE_LINE 00000145 "}"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "sub check_prefix {"
NSQ_SOURCE_LINE 00000148 "    my ($self, $hash_key) = @_;"
NSQ_SOURCE_LINE 00000149 "    die \"Hash key not a string\" if ref($hash_key);"
NSQ_SOURCE_LINE 00000150 "    my $dis = $self->config->disable_modes;"
NSQ_SOURCE_LINE 00000151 "    if (defined($dis) && ref($dis) ne 'ARRAY') {"
NSQ_SOURCE_LINE 00000152 "        $self->push_error(\"Invalid config value `disable_modes`: must be an array\");"
NSQ_SOURCE_LINE 00000153 "        return;"
NSQ_SOURCE_LINE 00000154 "    }"
NSQ_SOURCE_LINE 00000155 "    for my $mh (sort { $b->precedence_level <=> $a->precedence_level }"
NSQ_SOURCE_LINE 00000156 "                grep { !$dis || !$self->_in($_->name, $dis) }"
NSQ_SOURCE_LINE 00000157 "                values %{ $self->modes }) {"
NSQ_SOURCE_LINE 00000158 "        if ($mh->check_prefix($hash_key)) {"
NSQ_SOURCE_LINE 00000159 "            return $mh->name;"
NSQ_SOURCE_LINE 00000160 "        }"
NSQ_SOURCE_LINE 00000161 "    }"
NSQ_SOURCE_LINE 00000162 "    return;"
NSQ_SOURCE_LINE 00000163 "}"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "sub check_prefix_on_hash {"
NSQ_SOURCE_LINE 00000166 "    my ($self, $hash) = @_;"
NSQ_SOURCE_LINE 00000167 "    die \"Not a hash\" unless ref($hash) eq 'HASH';"
NSQ_SOURCE_LINE 00000168 "    my $res = 0;"
NSQ_SOURCE_LINE 00000169 "    for (keys %$hash) {"
NSQ_SOURCE_LINE 00000170 "\tdo { $res++; last } if $self->check_prefix($_);"
NSQ_SOURCE_LINE 00000171 "    }"
NSQ_SOURCE_LINE 00000172 "    $res;"
NSQ_SOURCE_LINE 00000173 "}"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "sub add_prefix {"
NSQ_SOURCE_LINE 00000176 "    my ($self, $hash_key, $mode) = @_;"
NSQ_SOURCE_LINE 00000177 "    die \"Hash key not a string\" if ref($hash_key);"
NSQ_SOURCE_LINE 00000178 "    my $dis = $self->config->disable_modes;"
NSQ_SOURCE_LINE 00000179 "    if (defined($dis) && ref($dis) ne 'ARRAY') {"
NSQ_SOURCE_LINE 00000180 "        die \"Invalid config value `disable_modes`: must be an array\";"
NSQ_SOURCE_LINE 00000181 "    }"
NSQ_SOURCE_LINE 00000182 "    if ($dis && $self->_in($mode, $dis)) {"
NSQ_SOURCE_LINE 00000183 "        $self->push_error(\"Can't add prefix for currently disabled mode `$mode`\");"
NSQ_SOURCE_LINE 00000184 "        return $hash_key;"
NSQ_SOURCE_LINE 00000185 "    }"
NSQ_SOURCE_LINE 00000186 "    my $mh = $self->modes->{$mode} or die \"Unknown mode: $mode\";"
NSQ_SOURCE_LINE 00000187 "    $mh->add_prefix($hash_key);"
NSQ_SOURCE_LINE 00000188 "}"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "sub remove_prefix {"
NSQ_SOURCE_LINE 00000191 "    my ($self, $hash_key) = @_;"
NSQ_SOURCE_LINE 00000192 "    die \"Hash key not a string\" if ref($hash_key);"
NSQ_SOURCE_LINE 00000193 "    my $dis = $self->config->disable_modes;"
NSQ_SOURCE_LINE 00000194 "    if (defined($dis) && ref($dis) ne 'ARRAY') {"
NSQ_SOURCE_LINE 00000195 "        die \"Invalid config value `disable_modes`: must be an array\";"
NSQ_SOURCE_LINE 00000196 "    }"
NSQ_SOURCE_LINE 00000197 "    for my $mh (sort { $b->precedence_level <=> $a->precedence_level }"
NSQ_SOURCE_LINE 00000198 "                grep { !$dis || !$self->_in($_->name, $dis) }"
NSQ_SOURCE_LINE 00000199 "                values %{ $self->modes }) {"
NSQ_SOURCE_LINE 00000200 "        if ($mh->check_prefix($hash_key)) {"
NSQ_SOURCE_LINE 00000201 "            my $r = $mh->remove_prefix($hash_key);"
NSQ_SOURCE_LINE 00000202 "            if (wantarray) { return ($r, $mh->name) }"
NSQ_SOURCE_LINE 00000203 "            else           { return $r }"
NSQ_SOURCE_LINE 00000204 "        }"
NSQ_SOURCE_LINE 00000205 "    }"
NSQ_SOURCE_LINE 00000206 "    if (wantarray) { return ($hash_key, $self->config->default_mode) }"
NSQ_SOURCE_LINE 00000207 "    else           { return $hash_key }"
NSQ_SOURCE_LINE 00000208 "}"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "sub remove_prefix_on_hash {"
NSQ_SOURCE_LINE 00000211 "    my ($self, $hash) = @_;"
NSQ_SOURCE_LINE 00000212 "    die \"Not a hash\" unless ref($hash) eq 'HASH';"
NSQ_SOURCE_LINE 00000213 "    for (keys %$hash) {"
NSQ_SOURCE_LINE 00000214 "\tmy $old = $_;"
NSQ_SOURCE_LINE 00000215 "\t$_ = $self->remove_prefix($_);"
NSQ_SOURCE_LINE 00000216 "\tnext unless $old ne $_;"
NSQ_SOURCE_LINE 00000217 "\tdie \"Conflict when removing prefix on hash: $old -> $_ but $_ already exists\""
NSQ_SOURCE_LINE 00000218 "\t    if exists $hash->{$_};"
NSQ_SOURCE_LINE 00000219 "\t$hash->{$_} = $hash->{$old};"
NSQ_SOURCE_LINE 00000220 "\tdelete $hash->{$old};"
NSQ_SOURCE_LINE 00000221 "    }"
NSQ_SOURCE_LINE 00000222 "    $hash;"
NSQ_SOURCE_LINE 00000223 "}"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "sub merge {"
NSQ_SOURCE_LINE 00000226 "    my ($self, $l, $r) = @_;"
NSQ_SOURCE_LINE 00000227 "    $self->path([]);"
NSQ_SOURCE_LINE 00000228 "    $self->errors([]);"
NSQ_SOURCE_LINE 00000229 "    $self->mem({});"
NSQ_SOURCE_LINE 00000230 "    $self->cur_mem_key(undef);"
NSQ_SOURCE_LINE 00000231 "    my ($key, $res, $backup) = $self->_merge(undef, $l, $r);"
NSQ_SOURCE_LINE 00000232 "    {"
NSQ_SOURCE_LINE 00000233 "        success => !@{ $self->errors },"
NSQ_SOURCE_LINE 00000234 "        error   => (@{ $self->errors } ?"
NSQ_SOURCE_LINE 00000235 "                    join(\", \","
NSQ_SOURCE_LINE 00000236 "                         map { sprintf(\"/%s: %s\", join(\"/\", @{ $_->[0] }), $_->[1]) }"
NSQ_SOURCE_LINE 00000237 "                             @{ $self->errors }) : ''),"
NSQ_SOURCE_LINE 00000238 "        result  => $res,"
NSQ_SOURCE_LINE 00000239 "        backup  => $backup,"
NSQ_SOURCE_LINE 00000240 "    };"
NSQ_SOURCE_LINE 00000241 "}"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "# handle circular refs: process todo's"
NSQ_SOURCE_LINE 00000244 "sub _process_todo {"
NSQ_SOURCE_LINE 00000245 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000246 "    if ($self->cur_mem_key) {"
NSQ_SOURCE_LINE 00000247 "        for my $mk (keys %{ $self->mem }) {"
NSQ_SOURCE_LINE 00000248 "            my $res = $self->mem->{$mk}{res};"
NSQ_SOURCE_LINE 00000249 "            if (defined($res) && @{ $self->mem->{$mk}{todo} }) {"
NSQ_SOURCE_LINE 00000250 "                #print \"DEBUG: processing todo for mem<$mk>\\n\";"
NSQ_SOURCE_LINE 00000251 "                for (@{  $self->mem->{$mk}{todo} }) {"
NSQ_SOURCE_LINE 00000252 "                    $_->(@$res);"
NSQ_SOURCE_LINE 00000253 "                    return if @{ $self->errors };"
NSQ_SOURCE_LINE 00000254 "                }"
NSQ_SOURCE_LINE 00000255 "                $self->mem->{$mk}{todo} = [];"
NSQ_SOURCE_LINE 00000256 "            }"
NSQ_SOURCE_LINE 00000257 "        }"
NSQ_SOURCE_LINE 00000258 "    }"
NSQ_SOURCE_LINE 00000259 "}"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "sub _merge {"
NSQ_SOURCE_LINE 00000262 "    my ($self, $key, $l, $r, $mode) = @_;"
NSQ_SOURCE_LINE 00000263 "    my $c = $self->config;"
NSQ_SOURCE_LINE 00000264 "    $mode //= $c->default_mode;"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "    my $mh = $self->modes->{$mode};"
NSQ_SOURCE_LINE 00000267 "    die \"Can't find handler for mode $mode\" unless $mh;"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "    # determine which merge method we will call"
NSQ_SOURCE_LINE 00000270 "    my $rl = ref($l);"
NSQ_SOURCE_LINE 00000271 "    my $rr = ref($r);"
NSQ_SOURCE_LINE 00000272 "    my $tl = $rl eq 'HASH' ? 'HASH' : $rl eq 'ARRAY' ? 'ARRAY' : $rl eq 'CODE' ? 'CODE' : !$rl ? 'SCALAR' : '';"
NSQ_SOURCE_LINE 00000273 "    my $tr = $rr eq 'HASH' ? 'HASH' : $rr eq 'ARRAY' ? 'ARRAY' : $rr eq 'CODE' ? 'CODE' : !$rr ? 'SCALAR' : '';"
NSQ_SOURCE_LINE 00000274 "    if (!$tl) { $self->push_error(\"Unknown type in left side: $rl\"); return }"
NSQ_SOURCE_LINE 00000275 "    if (!$tr) { $self->push_error(\"Unknown type in right side: $rr\"); return }"
NSQ_SOURCE_LINE 00000276 "    if (!$c->allow_create_array && $tl ne 'ARRAY' && $tr eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000277 "        $self->push_error(\"Not allowed to create array\"); return;"
NSQ_SOURCE_LINE 00000278 "    }"
NSQ_SOURCE_LINE 00000279 "    if (!$c->allow_create_hash && $tl ne 'HASH' && $tr eq 'HASH') {"
NSQ_SOURCE_LINE 00000280 "        $self->push_error(\"Not allowed to create hash\"); return;"
NSQ_SOURCE_LINE 00000281 "    }"
NSQ_SOURCE_LINE 00000282 "    if (!$c->allow_destroy_array && $tl eq 'ARRAY' && $tr ne 'ARRAY') {"
NSQ_SOURCE_LINE 00000283 "        $self->push_error(\"Not allowed to destroy array\"); return;"
NSQ_SOURCE_LINE 00000284 "    }"
NSQ_SOURCE_LINE 00000285 "    if (!$c->allow_destroy_hash && $tl eq 'HASH' && $tr ne 'HASH') {"
NSQ_SOURCE_LINE 00000286 "        $self->push_error(\"Not allowed to destroy hash\"); return;"
NSQ_SOURCE_LINE 00000287 "    }"
NSQ_SOURCE_LINE 00000288 "    my $meth = \"merge_${tl}_${tr}\";"
NSQ_SOURCE_LINE 00000289 "    if (!$mh->can($meth)) { $self->push_error(\"No merge method found for $tl + $tr (mode $mode)\"); return }"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "    #$self->_process_todo;"
NSQ_SOURCE_LINE 00000292 "    # handle circular refs: add to todo if necessary"
NSQ_SOURCE_LINE 00000293 "    my $memkey;"
NSQ_SOURCE_LINE 00000294 "    if ($rl || $rr) {"
NSQ_SOURCE_LINE 00000295 "        $memkey = sprintf \"%s%s %s%s %s %s\","
NSQ_SOURCE_LINE 00000296 "            (defined($l) ? ($rl ? 2 : 1) : 0),"
NSQ_SOURCE_LINE 00000297 "            (defined($l) ? \"$l\" : ''),"
NSQ_SOURCE_LINE 00000298 "            (defined($r) ? ($rr ? 2 : 1) : 0),"
NSQ_SOURCE_LINE 00000299 "            (defined($r) ? \"$r\" : ''),"
NSQ_SOURCE_LINE 00000300 "            $mode,"
NSQ_SOURCE_LINE 00000301 "            $self->config;"
NSQ_SOURCE_LINE 00000302 "        #print \"DEBUG: number of keys in mem = \".scalar(keys %{ $self->mem }).\"\\n\";"
NSQ_SOURCE_LINE 00000303 "        #print \"DEBUG: mem keys = \\n\".join(\"\", map { \"  $_\\n\" } keys %{ $self->mem }) if keys %{ $self->mem };"
NSQ_SOURCE_LINE 00000304 "        #print \"DEBUG: calculating memkey = <$memkey>\\n\";"
NSQ_SOURCE_LINE 00000305 "    }"
NSQ_SOURCE_LINE 00000306 "    if ($memkey) {"
NSQ_SOURCE_LINE 00000307 "        if (exists $self->mem->{$memkey}) {"
NSQ_SOURCE_LINE 00000308 "            $self->_process_todo;"
NSQ_SOURCE_LINE 00000309 "            if (defined $self->mem->{$memkey}{res}) {"
NSQ_SOURCE_LINE 00000310 "                #print \"DEBUG: already calculated, using cached result\\n\";"
NSQ_SOURCE_LINE 00000311 "                return @{ $self->mem->{$memkey}{res} };"
NSQ_SOURCE_LINE 00000312 "            } else {"
NSQ_SOURCE_LINE 00000313 "                #print \"DEBUG: detecting circular\\n\";"
NSQ_SOURCE_LINE 00000314 "                return ($key, undef, undef, 1);"
NSQ_SOURCE_LINE 00000315 "            }"
NSQ_SOURCE_LINE 00000316 "        } else {"
NSQ_SOURCE_LINE 00000317 "            $self->mem->{$memkey} = {res=>undef, todo=>[]};"
NSQ_SOURCE_LINE 00000318 "            $self->cur_mem_key($memkey);"
NSQ_SOURCE_LINE 00000319 "            #print \"DEBUG: invoking \".$mh->name.\"'s $meth(\".dmp($key).\", \".dmp($l).\", \".dmp($r).\")\\n\";"
NSQ_SOURCE_LINE 00000320 "            my ($newkey, $res, $backup) = $mh->$meth($key, $l, $r);"
NSQ_SOURCE_LINE 00000321 "            #print \"DEBUG: setting res for mem<$memkey>\\n\";"
NSQ_SOURCE_LINE 00000322 "            $self->mem->{$memkey}{res} = [$newkey, $res, $backup];"
NSQ_SOURCE_LINE 00000323 "            $self->_process_todo;"
NSQ_SOURCE_LINE 00000324 "            return ($newkey, $res, $backup);"
NSQ_SOURCE_LINE 00000325 "        }"
NSQ_SOURCE_LINE 00000326 "    } else {"
NSQ_SOURCE_LINE 00000327 "        $self->_process_todo;"
NSQ_SOURCE_LINE 00000328 "        #print \"DEBUG: invoking \".$mh->name.\"'s $meth(\".dmp($key).\", \".dmp($l).\", \".dmp($r).\")\\n\";"
NSQ_SOURCE_LINE 00000329 "        return $mh->$meth($key, $l, $r);"
NSQ_SOURCE_LINE 00000330 "    }"
NSQ_SOURCE_LINE 00000331 "}"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "# returns 1 if a is included in b (e.g. [user => \"jajang\"] in included in [user"
NSQ_SOURCE_LINE 00000334 "# => jajang => \"quota\"], but [user => \"paijo\"] is not)"
NSQ_SOURCE_LINE 00000335 "sub _path_is_included {"
NSQ_SOURCE_LINE 00000336 "    my ($self, $p1, $p2) = @_;"
NSQ_SOURCE_LINE 00000337 "    my $res = 1;"
NSQ_SOURCE_LINE 00000338 "    for my $i (0..@$p1-1) {"
NSQ_SOURCE_LINE 00000339 "        do { $res = 0; last } if !defined($p2->[$i]) || $p1->[$i] ne $p2->[$i];"
NSQ_SOURCE_LINE 00000340 "    }"
NSQ_SOURCE_LINE 00000341 "    #print \"_path_is_included([\".join(\", \", @$p1).\"], [\".join(\", \", @$p2).\"])? $res\\n\";"
NSQ_SOURCE_LINE 00000342 "    $res;"
NSQ_SOURCE_LINE 00000343 "}"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "1;"
NSQ_SOURCE_LINE 00000346 "# ABSTRACT: Merge two nested data structures, with merging modes and options"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "__END__"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "=pod"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=head1 NAME"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "Data::ModeMerge - Merge two nested data structures, with merging modes and options"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "=head1 VERSION"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "This document describes version 0.360 of Data::ModeMerge (from Perl distribution Data-ModeMerge), released on 2021-08-15."
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "    use Data::ModeMerge;"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "    my $hash1 = { a=>1,    c=>1, d=>{  da =>[1]} };"
NSQ_SOURCE_LINE 00000367 "    my $hash2 = { a=>2, \"-c\"=>2, d=>{\"+da\"=>[2]} };"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "    # if you want Data::ModeMerge to behave like many other merging"
NSQ_SOURCE_LINE 00000371 "    # modules (e.g. Hash::Merge or Data::Merger), turn off modes"
NSQ_SOURCE_LINE 00000372 "    # (prefix) parsing and options key parsing."
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "    my $mm = Data::ModeMerge->new(config => {parse_prefix=>0, options_key=>undef});"
NSQ_SOURCE_LINE 00000375 "    my $res = $mm->merge($hash1, $hash2);"
NSQ_SOURCE_LINE 00000376 "    die $res->{error} if $res->{error};"
NSQ_SOURCE_LINE 00000377 "    # $res->{result} -> { a=>2, c=>1, \"-c\"=>2, d=>{da=>[1], \"+da\"=>[2]} }"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    # otherwise Data::ModeMerge will parse prefix as well as options"
NSQ_SOURCE_LINE 00000381 "    # key"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "    my $res = $mm->merge($hash1, $hash2);"
NSQ_SOURCE_LINE 00000384 "    die $res->{error} if $res->{error};"
NSQ_SOURCE_LINE 00000385 "    # $res->{result} -> { a=>2, c=>-1, d=>{da=>[1,2]} }"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "    $res = $merge({  a =>1, {  a2 =>1, \"\"=>{parse_prefix=>0}},"
NSQ_SOURCE_LINE 00000388 "                  {\".a\"=>2, {\".a2\"=>2                       }});"
NSQ_SOURCE_LINE 00000389 "    # $res->{result} -> { a=>12, {a2=>1, \".a2\"=>2} }, parse_prefix is turned off in just the subhash"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "    # procedural interface"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "    my $res = mode_merge($hash1, $hash2, {allow_destroy_hash=>0});"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "There are already several modules on CPAN to do recursive data"
NSQ_SOURCE_LINE 00000399 "structure merging, like L<Data::Merger> and"
NSQ_SOURCE_LINE 00000400 "L<Hash::Merge>. C<Data::ModeMerge> differs in that it offers merging"
NSQ_SOURCE_LINE 00000401 "\"modes\" and \"options\". It provides greater flexibility on what the"
NSQ_SOURCE_LINE 00000402 "result of a merge between two data should/can be. This module may or"
NSQ_SOURCE_LINE 00000403 "may not be what you need."
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "One application of this module is in handling configuration. Often"
NSQ_SOURCE_LINE 00000406 "there are multiple levels of configuration, e.g. in your typical Unix"
NSQ_SOURCE_LINE 00000407 "command-line program there are system-wide config file in /etc,"
NSQ_SOURCE_LINE 00000408 "per-user config file under ~/, and command-line options. It's"
NSQ_SOURCE_LINE 00000409 "convenient programatically to load each of those in a hash and then"
NSQ_SOURCE_LINE 00000410 "merge system-wide hash with the per-user hash, and then merge the"
NSQ_SOURCE_LINE 00000411 "result with the command-line hash to get the a single hash as the"
NSQ_SOURCE_LINE 00000412 "final configuration. Your program can from there on deal with this"
NSQ_SOURCE_LINE 00000413 "just one hash instead of three."
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "In a typical merging process between two hashes (left-side and"
NSQ_SOURCE_LINE 00000416 "right-side), when there is a conflicting key, then the right-side key"
NSQ_SOURCE_LINE 00000417 "will override the left-side. This is usually the desired behaviour in"
NSQ_SOURCE_LINE 00000418 "our said program as the system-wide config is there to provide"
NSQ_SOURCE_LINE 00000419 "defaults, and the per-user config (and the command-line arguments)"
NSQ_SOURCE_LINE 00000420 "allow a user to override those defaults."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "But suppose that the user wants to I<unset> a certain configuration"
NSQ_SOURCE_LINE 00000423 "setting that is defined by the system-wide config? She can't do that"
NSQ_SOURCE_LINE 00000424 "unless she edits the system-wide config (in which she might need admin"
NSQ_SOURCE_LINE 00000425 "rights), or the program allows the user to disregard the system-wide"
NSQ_SOURCE_LINE 00000426 "config. The latter is usually what's implemented by many Unix"
NSQ_SOURCE_LINE 00000427 "programs, e.g. the C<-noconfig> command-line option in C<mplayer>. But"
NSQ_SOURCE_LINE 00000428 "this has two drawbacks: a slightly added complexity in the program"
NSQ_SOURCE_LINE 00000429 "(need to provide a special, extra comand-line option) and the user"
NSQ_SOURCE_LINE 00000430 "loses all the default settings in the system-wide config. What she"
NSQ_SOURCE_LINE 00000431 "needed in the first place was to just unset I<a single setting> (a"
NSQ_SOURCE_LINE 00000432 "single key-value pair of the hash)."
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "L<Data::ModeMerge> comes to the rescue. It provides a so-called"
NSQ_SOURCE_LINE 00000435 "C<DELETE mode>."
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 " mode_merge({foo=>1, bar=>2}, {\"!foo\"=>undef, bar=>3, baz=>1});"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "will result ini:"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 " {bar=>3, baz=>1}"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "The C<!> prefix tells Data::ModeMerge to do a DELETE mode merging. So"
NSQ_SOURCE_LINE 00000444 "the final result will lack the C<foo> key."
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "On the other hand, what if the system admin wants to I<protect> a"
NSQ_SOURCE_LINE 00000447 "certain configuration setting from being overriden by the user or the"
NSQ_SOURCE_LINE 00000448 "command-line? This is useful in a hosting or other retrictive"
NSQ_SOURCE_LINE 00000449 "environment where we want to limit users' freedom to some levels. This"
NSQ_SOURCE_LINE 00000450 "is possible via the KEEP mode merging."
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 " mode_merge({\"^bar\"=>2, \"^baz\"=>1}, {bar=>3, \"!baz\"=>0, qux=>7});"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "will result in:"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 " {\"^bar\"=>2, \"^baz\"=>1, qux=>7}"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "effectively protecting C<bar> and C<baz> from being"
NSQ_SOURCE_LINE 00000459 "overriden/deleted/etc."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "Aside from the two mentioned modes, there are also a few others"
NSQ_SOURCE_LINE 00000462 "available by default: ADD (prefix C<+>), CONCAT (prefix C<.>),"
NSQ_SOURCE_LINE 00000463 "SUBTRACT (prefix C<->), as well as the plain ol' NORMAL/override"
NSQ_SOURCE_LINE 00000464 "(optional prefix C<*>)."
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "You can add other modes by writing a mode handler module."
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "You can change the default prefixes for each mode if you want. You can"
NSQ_SOURCE_LINE 00000469 "disable each mode individually."
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "You can default to always using a certain mode, like the NORMAL mode,"
NSQ_SOURCE_LINE 00000472 "and ignore all the prefixes, in which case Data::ModeMerge will behave"
NSQ_SOURCE_LINE 00000473 "like most other merge modules."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "There are a few other options like whether or not the right side is"
NSQ_SOURCE_LINE 00000476 "allowed a \"change the structure\" of the left side (e.g. replacing a"
NSQ_SOURCE_LINE 00000477 "scalar with an array/hash, destroying an existing array/hash with"
NSQ_SOURCE_LINE 00000478 "scalar), maximum length of scalar/array/hash, etc."
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "You can change default mode, prefixes, disable/enable modes, etc on a"
NSQ_SOURCE_LINE 00000481 "per-hash basis using the so-called B<options key>. See the B<OPTIONS"
NSQ_SOURCE_LINE 00000482 "KEY> section for more details."
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "This module can handle (though not all possible cases)"
NSQ_SOURCE_LINE 00000485 "circular/recursive references."
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=for Pod::Coverage ^(BUILD)$"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "=head1 MERGING PREFIXES AND YOUR DATA"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "Merging with this module means you need to be careful when your hash"
NSQ_SOURCE_LINE 00000492 "keys might contain one of the mode prefixes characters by accident,"
NSQ_SOURCE_LINE 00000493 "because it will trigger the wrong merge mode and moreover the prefix"
NSQ_SOURCE_LINE 00000494 "characters will be B<stripped> from the final result (unless you"
NSQ_SOURCE_LINE 00000495 "configure the module not to do so)."
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "A rather common case is when you have regexes in your hash"
NSQ_SOURCE_LINE 00000498 "keys. Regexes often begins with C<^>, which coincidentally is a prefix"
NSQ_SOURCE_LINE 00000499 "for the KEEP mode. Or perhaps you have dot filenames as hash keys,"
NSQ_SOURCE_LINE 00000500 "where it clashes with the CONCAT mode. Or perhaps shell wildcards,"
NSQ_SOURCE_LINE 00000501 "where C<*> is also used as the prefix for NORMAL mode."
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "To avoid clashes, you can either:"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=over 4"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "=item * exclude the keys using"
NSQ_SOURCE_LINE 00000508 "C<exclude_merge>/C<include_merge>/C<exclude_parse>/C<include_parse>"
NSQ_SOURCE_LINE 00000509 "config settings"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=item * turn off some modes which you don't want via the"
NSQ_SOURCE_LINE 00000512 "C<disable_modes> config"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=item * change the prefix for that mode so that it doesn't clash with"
NSQ_SOURCE_LINE 00000515 "your data via the C<set_prefix> config"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=item * disable prefix parsing altogether via setting C<parse_prefix>"
NSQ_SOURCE_LINE 00000518 "config to 0"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=back"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "You can do this via the configuration, or on a per-hash basis, using"
NSQ_SOURCE_LINE 00000523 "the options key."
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "See L<Data::ModeMerge::Config> for more details on configuration."
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "=head1 OPTIONS KEY"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "Aside from merging mode prefixes, you also need to watch out if your"
NSQ_SOURCE_LINE 00000530 "hash contains a \"\" (empty string) key, because by default this is the"
NSQ_SOURCE_LINE 00000531 "key used for options key."
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "Options key are used to specify configuration on a per-hash basis."
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "If your hash keys might contain \"\" keys which are not meant to be an"
NSQ_SOURCE_LINE 00000536 "options key, you can either:"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "=over 4"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "=item * change the name of the key for options key, via setting"
NSQ_SOURCE_LINE 00000541 "C<options_key> config to another string."
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "=item * turn off options key mechanism,"
NSQ_SOURCE_LINE 00000544 "by setting C<options_key> config to undef."
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "=back"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "See L<Data::ModeMerge::Config> for more details about options key."
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "=head1 MERGING MODES"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "=head2 NORMAL (optional '*' prefix on left/right side)"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 " mode_merge({  a =>11, b=>12}, {  b =>22, c=>23}); # {a=>11, b=>22, c=>23}"
NSQ_SOURCE_LINE 00000555 " mode_merge({\"*a\"=>11, b=>12}, {\"*b\"=>22, c=>23}); # {a=>11, b=>22, c=>23}"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "=head2 ADD ('+' prefix on the right side)"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 " mode_merge({i=>3}, {\"+i\"=>4, \"+j\"=>1}); # {i=>7, j=>1}"
NSQ_SOURCE_LINE 00000560 " mode_merge({a=>[1]}, {\"+a\"=>[2, 3]}); # {a=>[1, 2, 3]}"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "Additive merge on hashes will be treated like a normal merge."
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "=head2 CONCAT ('.' prefix on the right side)"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 " mode_merge({i=>3}, {\".i\"=>4, \".j\"=>1}); # {i=>34, j=>1}"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "Concative merge on arrays will be treated like additive merge."
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "=head2 SUBTRACT ('-' prefix on the right side)"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 " mode_merge({i=>3}, {\"-i\"=>4}); # {i=>-1}"
NSQ_SOURCE_LINE 00000573 " mode_merge({a=>[\"a\",\"b\",\"c\"]}, {\"-a\"=>[\"b\"]}); # {a=>[\"a\",\"c\"]}"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "Subtractive merge on hashes behaves like a normal merge, except that"
NSQ_SOURCE_LINE 00000576 "each key on the right-side hash without any prefix will be assumed to"
NSQ_SOURCE_LINE 00000577 "have a DELETE prefix, i.e.:"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 " mode_merge({h=>{a=>1, b=>1}}, {-h=>{a=>2, \"+b\"=>2, c=>2}})"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "is equivalent to:"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 " mode_merge({h=>{a=>1, b=>1}}, {h=>{\"!a\"=>2, \"+b\"=>2, \"!c\"=>2}})"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "and will merge to become:"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 " {h=>{b=>3}}"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "=head2 DELETE ('!' prefix on the right side)"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 " mode_merge({x=>WHATEVER}, {\"!x\"=>WHATEVER}); # {}"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=head2 KEEP ('^' prefix on the left/right side)"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "If you add '^' prefix on the left side, it will be protected from"
NSQ_SOURCE_LINE 00000596 "being replaced/deleted/etc."
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 " mode_merge({'^x'=>WHATEVER1}, {\"x\"=>WHATEVER2}); # {x=>WHATEVER1}"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "For hashes, KEEP mode means that all keys on the left side will not be"
NSQ_SOURCE_LINE 00000601 "replaced/modified/deleted, *but* you can still add more keys from the"
NSQ_SOURCE_LINE 00000602 "right side hash."
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 " mode_merge({a=>1, b=>2, c=>3},"
NSQ_SOURCE_LINE 00000605 "            {a=>4, '^c'=>1, d=>5},"
NSQ_SOURCE_LINE 00000606 "            {default_mode=>'KEEP'});"
NSQ_SOURCE_LINE 00000607 "            # {a=>1, b=>2, c=>3, d=>5}"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "Multiple prefixes on the right side is allowed, where the merging will"
NSQ_SOURCE_LINE 00000610 "be done by precedence level (highest first):"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 " mode_merge({a=>[1,2]}, {'-a'=>[1], '+a'=>[10]}); # {a=>[2,10]}"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "but not on the left side:"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 " mode_merge({a=>1, '^a'=>2}, {a=>3}); # error!"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "Precedence levels (from highest to lowest):"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 " KEEP"
NSQ_SOURCE_LINE 00000621 " NORMAL"
NSQ_SOURCE_LINE 00000622 " SUBTRACT"
NSQ_SOURCE_LINE 00000623 " CONCAT ADD"
NSQ_SOURCE_LINE 00000624 " DELETE"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "=head1 CREATING AND USING YOUR OWN MODE"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "Let's say you want to add a mode named C<FOO>. It will have the prefix"
NSQ_SOURCE_LINE 00000629 "'?'."
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "Create the mode handler class,"
NSQ_SOURCE_LINE 00000632 "e.g. C<Data::ModeMerge::Mode::FOO>. It's probably best to subclass"
NSQ_SOURCE_LINE 00000633 "from L<Data::ModeMerge::Mode::Base>. The class must implement name(),"
NSQ_SOURCE_LINE 00000634 "precedence_level(), default_prefix(), default_prefix_re(), and"
NSQ_SOURCE_LINE 00000635 "merge_{SCALAR,ARRAY,HASH}_{SCALAR,ARRAY,HASH}(). For more details, see"
NSQ_SOURCE_LINE 00000636 "the source code of Base.pm and one of the mode handlers"
NSQ_SOURCE_LINE 00000637 "(e.g. NORMAL.pm)."
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "To use the mode, register it:"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 " my $mm = Data::ModeMerge->new;"
NSQ_SOURCE_LINE 00000642 " $mm->register_mode('FOO');"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "This will require C<Data::ModeMerge::Mode::FOO>. After that, define"
NSQ_SOURCE_LINE 00000645 "the operations against other modes:"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 " # if there's FOO on the left and NORMAL on the right, what mode"
NSQ_SOURCE_LINE 00000648 " # should the merge be done in (FOO), and what the mode should be"
NSQ_SOURCE_LINE 00000649 " # after the merge? (NORMAL)"
NSQ_SOURCE_LINE 00000650 " $mm->combine_rules->{\"FOO+NORMAL\"} = [\"FOO\", \"NORMAL\"];"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 " # we don't define FOO+ADD"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 " $mm->combine_rules->{\"FOO+KEEP\"} = [\"KEEP\", \"KEEP\"];"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 " # and so on"
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "=head2 mode_merge($l, $r[, $config_vars])"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "A non-OO wrapper for merge() method. Exported by default. See C<merge>"
NSQ_SOURCE_LINE 00000663 "method for more details."
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "=head1 ATTRIBUTES"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "=head2 config"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "A hashref for config. See L<Data::ModeMerge::Config>."
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "=head2 modes"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "=head2 combine_rules"
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "=head2 path"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "=head2 errors"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "=head2 mem"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "=head2 cur_mem_key"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "=head1 METHODS"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "For typical usage, you only need merge()."
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "=head2 push_error($errmsg)"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "Used by mode handlers to push error when doing merge. End users"
NSQ_SOURCE_LINE 00000690 "normally should not need this."
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "=head2 register_mode($name_or_package_or_obj)"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "Register a mode. Will die if mode with the same name already exists."
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "=head2 check_prefix($hash_key)"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "Check whether hash key has prefix for certain mode. Return the name of"
NSQ_SOURCE_LINE 00000699 "the mode, or undef if no prefix is detected."
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "=head2 check_prefix_on_hash($hash)"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "This is like C<check_prefix> but performed on every key of the"
NSQ_SOURCE_LINE 00000704 "specified hash. Return true if any of the key contain a merge prefix."
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "=head2 add_prefix($hash_key, $mode)"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "Return hash key with added prefix with specified mode. Log merge error"
NSQ_SOURCE_LINE 00000709 "if mode is unknown or is disabled."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "=head2 remove_prefix($hash_key)"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "Return hash key will any prefix removed."
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "=head2 remove_prefix_on_hash($hash)"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "This is like C<remove_prefix> but performed on every key of the"
NSQ_SOURCE_LINE 00000718 "specified hash. Return the same hash but with prefixes removed."
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "=head2 merge($l, $r)"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "Merge two nested data structures. Returns the result hash: {"
NSQ_SOURCE_LINE 00000723 "success=>0|1, error=>'...', result=>..., backup=>... }. The 'error'"
NSQ_SOURCE_LINE 00000724 "key is set to contain an error message if there is an error. The merge"
NSQ_SOURCE_LINE 00000725 "result is in the 'result' key. The 'backup' key contains replaced"
NSQ_SOURCE_LINE 00000726 "elements from the original hash/array."
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "=head1 FAQ"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "=head2 What is this module good for? Why would I want to use this module instead of the other hash merge modules?"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "If you just need to (deeply) merge two hashes, chances are you do not"
NSQ_SOURCE_LINE 00000733 "need this module. Use, for example, L<Hash::Merge>, which is also"
NSQ_SOURCE_LINE 00000734 "flexible enough because it allows you to set merging behaviour for"
NSQ_SOURCE_LINE 00000735 "merging different types (e.g. SCALAR vs ARRAY)."
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "You might need this module if your data is recursive/self-referencing"
NSQ_SOURCE_LINE 00000738 "(which, last time I checked, is not handled well by Hash::Merge), or"
NSQ_SOURCE_LINE 00000739 "if you want to be able to merge differently (i.e. apply different"
NSQ_SOURCE_LINE 00000740 "merging B<modes>) according to different prefixes on the key, or"
NSQ_SOURCE_LINE 00000741 "through special key. In other words, you specify merging modes from"
NSQ_SOURCE_LINE 00000742 "inside the hash itself."
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "I originally wrote Data::ModeMerge this for L<Data::Schema> and"
NSQ_SOURCE_LINE 00000745 "L<Config::Tree>. I want to reuse the \"parent\" schema (or"
NSQ_SOURCE_LINE 00000746 "configuration) in more ways other than just override conflicting"
NSQ_SOURCE_LINE 00000747 "keys. I also want to be able to allow the parent to protect certain"
NSQ_SOURCE_LINE 00000748 "keys from being overriden. I found these two features lacking in all"
NSQ_SOURCE_LINE 00000749 "merging modules that I've evaluated prior to writing Data::ModeMerge."
NSQ_SOURCE_LINE 00000750 ""
