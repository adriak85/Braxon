NSQ_SOURCE_LINE 00000010 "#"
NSQ_SOURCE_LINE 00000011 "# This program is distributed in the hope that it will be useful, but"
NSQ_SOURCE_LINE 00000012 "# WITHOUT ANY WARRANTY; without even the implied warranty of"
NSQ_SOURCE_LINE 00000013 "# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU"
NSQ_SOURCE_LINE 00000014 "# General Public License for more details."
NSQ_SOURCE_LINE 00000015 "#"
NSQ_SOURCE_LINE 00000016 "# You should have received a copy of the GNU General Public License"
NSQ_SOURCE_LINE 00000017 "# along with this program; if not, write to the Free Software"
NSQ_SOURCE_LINE 00000018 "# Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA"
NSQ_SOURCE_LINE 00000019 "# 02110-1301 USA"
NSQ_SOURCE_LINE 00000020 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "use strict;"
NSQ_SOURCE_LINE 00000023 "use integer;"
NSQ_SOURCE_LINE 00000024 "use vars qw($VERSION);"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "$VERSION = \"1.38\";"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "# ---======================= Public Methods ======================---"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000031 "# new([@columns])"
NSQ_SOURCE_LINE 00000032 "#"
NSQ_SOURCE_LINE 00000033 "# Instantiate a new Text::TabularDisplay instance.  Optionally takes"
NSQ_SOURCE_LINE 00000034 "# column names, which are passed to the columns method."
NSQ_SOURCE_LINE 00000035 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000036 "sub new {"
NSQ_SOURCE_LINE 00000037 "    my $class = shift;"
NSQ_SOURCE_LINE 00000038 "    return $class->clone"
NSQ_SOURCE_LINE 00000039 "        if ref $class && UNIVERSAL::isa($class, __PACKAGE__);"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    my $self = bless {"
NSQ_SOURCE_LINE 00000042 "        _COLUMNS => [ ],"
NSQ_SOURCE_LINE 00000043 "        _DATA    => [ ],"
NSQ_SOURCE_LINE 00000044 "        _LENGTHS => [ ],"
NSQ_SOURCE_LINE 00000045 "        _SIZE    => 0,"
NSQ_SOURCE_LINE 00000046 "    } => $class;"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "    $self->columns(@_) if (@_);"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    return $self;"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000054 "# clone"
NSQ_SOURCE_LINE 00000055 "#"
NSQ_SOURCE_LINE 00000056 "# Clones a Text::TabluarDisplay instance."
NSQ_SOURCE_LINE 00000057 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000058 "sub clone {"
NSQ_SOURCE_LINE 00000059 "    my $self = shift;"
NSQ_SOURCE_LINE 00000060 "    my $class = ref $self || return $self->new;"
NSQ_SOURCE_LINE 00000061 "    my $clone = $class->new($self->columns);"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    for (@{ $self->{ _DATA } }) {"
NSQ_SOURCE_LINE 00000064 "        $clone->add(@$_);"
NSQ_SOURCE_LINE 00000065 "    }"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "    return $clone;"
NSQ_SOURCE_LINE 00000068 "}"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000071 "# columns([@columns])"
NSQ_SOURCE_LINE 00000072 "#"
NSQ_SOURCE_LINE 00000073 "# Returns a list of column names in list context, but returns the"
NSQ_SOURCE_LINE 00000074 "# number of columns in scalar context."
NSQ_SOURCE_LINE 00000075 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000076 "sub columns {"
NSQ_SOURCE_LINE 00000077 "    my $self = shift;"
NSQ_SOURCE_LINE 00000078 "    my @columns;"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "    if (@_) {"
NSQ_SOURCE_LINE 00000081 "        my $cnum = $self->{ _SIZE };"
NSQ_SOURCE_LINE 00000082 "        if ($cnum > scalar @_) {"
NSQ_SOURCE_LINE 00000083 "            push @_, \"\""
NSQ_SOURCE_LINE 00000084 "                while ($self->columns > scalar @_);"
NSQ_SOURCE_LINE 00000085 "        }"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "        @{ $self->{ _COLUMNS } } = ();"
NSQ_SOURCE_LINE 00000088 "        $self->_add($self->{ _COLUMNS }, $self->{ _LENGTHS }, \\$self->{ _SIZE }, [ @_ ]);"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 "    @columns = @{ $self->{ _COLUMNS }->[0] || [ ]};"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    return wantarray ? @columns : scalar @columns;"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000096 "# add(@data)"
NSQ_SOURCE_LINE 00000097 "#"
NSQ_SOURCE_LINE 00000098 "# Adds a row to the instance.  Returns $self, for chaining:"
NSQ_SOURCE_LINE 00000099 "#   $self->add(@one)->add(@two)->add(@three);"
NSQ_SOURCE_LINE 00000100 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000101 "sub add {"
NSQ_SOURCE_LINE 00000102 "    my $self = shift;"
NSQ_SOURCE_LINE 00000103 "    my $add = UNIVERSAL::isa($_[0], 'ARRAY') ? shift : [ @_ ];"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    if (@$add) {"
NSQ_SOURCE_LINE 00000106 "        $self->_add($self->{ _DATA }, $self->{ _LENGTHS }, \\$self->{ _SIZE }, $add);"
NSQ_SOURCE_LINE 00000107 "    }"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    return $self;"
NSQ_SOURCE_LINE 00000110 "}"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000113 "# render([$start, $end])"
NSQ_SOURCE_LINE 00000114 "#"
NSQ_SOURCE_LINE 00000115 "# Returns the data formatted as a table.  By default, all rows are"
NSQ_SOURCE_LINE 00000116 "# returned; if $start or $end are specified, then only those indexes"
NSQ_SOURCE_LINE 00000117 "# are returned.  Those are the start and end indexes!"
NSQ_SOURCE_LINE 00000118 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000119 "sub render {"
NSQ_SOURCE_LINE 00000120 "    my $self = shift;"
NSQ_SOURCE_LINE 00000121 "    my $start = shift || 0;"
NSQ_SOURCE_LINE 00000122 "    my $end = shift || $#{ $self->{ _DATA } };"
NSQ_SOURCE_LINE 00000123 "    my $size = $self->{ _SIZE };"
NSQ_SOURCE_LINE 00000124 "    my ($bar, @columns, $datum, @text);"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "    $bar = join \"+\", \"\","
NSQ_SOURCE_LINE 00000127 "                     map( { \"-\" x ($_ + 2) } @{ $self->{ _LENGTHS } }),"
NSQ_SOURCE_LINE 00000128 "                     \"\";"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    push @text, $bar;"
NSQ_SOURCE_LINE 00000131 "    if (@columns = $self->columns) {"
NSQ_SOURCE_LINE 00000132 "        push @text, _format_line(\\@columns, $self->{ _LENGTHS });"
NSQ_SOURCE_LINE 00000133 "        push @text, $bar;"
NSQ_SOURCE_LINE 00000134 "    }"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    for (my $i = $start; $i <= $end; $i++) {"
NSQ_SOURCE_LINE 00000137 "        $datum = $self->{ _DATA }->[$i];"
NSQ_SOURCE_LINE 00000138 "        last unless defined $datum;"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "        # Pad the array if there are more elements in @columns"
NSQ_SOURCE_LINE 00000141 "        push @$datum, \"\""
NSQ_SOURCE_LINE 00000142 "            until (@$datum == $size);"
NSQ_SOURCE_LINE 00000143 "        push @text, _format_line($datum, $self->{ _LENGTHS });"
NSQ_SOURCE_LINE 00000144 "    }"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    push @text, $bar;"
NSQ_SOURCE_LINE 00000147 "    return join \"\\n\", @text;"
NSQ_SOURCE_LINE 00000148 "}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "sub items {"
NSQ_SOURCE_LINE 00000151 "    my $self = shift;"
NSQ_SOURCE_LINE 00000152 "    return scalar @{ $self->{ _DATA } };"
NSQ_SOURCE_LINE 00000153 "}"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "# ----------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000156 "# reset()"
NSQ_SOURCE_LINE 00000157 "#"
NSQ_SOURCE_LINE 00000158 "# Resets the instance."
NSQ_SOURCE_LINE 00000159 "# ----------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000160 "sub reset {"
NSQ_SOURCE_LINE 00000161 "    my $self = shift;"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    @{ $self->{ _COLUMNS } } = ();"
NSQ_SOURCE_LINE 00000164 "    @{ $self->{ _LENGTHS } } = ();"
NSQ_SOURCE_LINE 00000165 "    @{ $self->{ _DATA    } } = ();"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    $self->columns(@_) if (@_);"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    return $self;"
NSQ_SOURCE_LINE 00000170 "}"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "# ----------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000173 "# populate(\\@data)"
NSQ_SOURCE_LINE 00000174 "#"
NSQ_SOURCE_LINE 00000175 "# populate() takes a reference to an array of references to arrays,"
NSQ_SOURCE_LINE 00000176 "# and calls add() repeatedly.  Primarily for use with DBI's"
NSQ_SOURCE_LINE 00000177 "# selectall_arrayref() method."
NSQ_SOURCE_LINE 00000178 "# ----------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000179 "sub populate {"
NSQ_SOURCE_LINE 00000180 "    my $self = shift;"
NSQ_SOURCE_LINE 00000181 "    (@_) or return $self;"
NSQ_SOURCE_LINE 00000182 "    my $data = UNIVERSAL::isa($_[0], 'ARRAY') ? shift : [ @_ ];"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "    for (my $i = 0; $i <= $#$data; $i++) {"
NSQ_SOURCE_LINE 00000185 "        $self->add($data->[$i]);"
NSQ_SOURCE_LINE 00000186 "    }"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "    return $self;"
NSQ_SOURCE_LINE 00000189 "}"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "# ----------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000193 "# paginate($items_per_page)"
NSQ_SOURCE_LINE 00000194 "#"
NSQ_SOURCE_LINE 00000195 "# Returns a list of rendered pages, with $items_per_page - 4 elements"
NSQ_SOURCE_LINE 00000196 "# on each (operational overhead)"
NSQ_SOURCE_LINE 00000197 "# ----------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000198 "sub paginate {"
NSQ_SOURCE_LINE 00000199 "    my $self = shift;"
NSQ_SOURCE_LINE 00000200 "    my $items_per_page = shift || 62;"
NSQ_SOURCE_LINE 00000201 "    my ($items, $pages, $current, @pages);"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    $items = $self->items;"
NSQ_SOURCE_LINE 00000204 "    $pages = $items / $items_per_page;"
NSQ_SOURCE_LINE 00000205 "    $pages += 1 if $items % $items_per_page;"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "    for (my $i = 0; $i < $pages; $i++) {"
NSQ_SOURCE_LINE 00000208 "        push @pages, $self->render($current, $items_per_page);"
NSQ_SOURCE_LINE 00000209 "        $current += $items_per_page;"
NSQ_SOURCE_LINE 00000210 "    }"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "    return @pages;"
NSQ_SOURCE_LINE 00000213 "}"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "# ---====================== Private Methods ======================---"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000220 "# _add(\\@where, \\@lengths, \\@add)"
NSQ_SOURCE_LINE 00000221 "#"
NSQ_SOURCE_LINE 00000222 "# Adds @add to @where and modifies @lengths, as necessary"
NSQ_SOURCE_LINE 00000223 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000224 "sub _add {"
NSQ_SOURCE_LINE 00000225 "    my $self = shift;"
NSQ_SOURCE_LINE 00000226 "    my ($where, $length, $size, $add) = @_;"
NSQ_SOURCE_LINE 00000227 "    my @data;"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "    $$size = scalar @$add"
NSQ_SOURCE_LINE 00000230 "        if (scalar @$add > $$size);"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    for (my $i = 0; $i <= $#$add; $i++) {"
NSQ_SOURCE_LINE 00000233 "        my $l = _column_length($add->[$i]);"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "        push @data, $add->[$i];"
NSQ_SOURCE_LINE 00000236 "        $length->[$i] = $l"
NSQ_SOURCE_LINE 00000237 "            unless $length->[$i] && $length->[$i] > $l;"
NSQ_SOURCE_LINE 00000238 "    }"
NSQ_SOURCE_LINE 00000239 "    push @$where, \\@data;"
NSQ_SOURCE_LINE 00000240 "}"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000243 "# _format_line(\\@columns, \\@lengths)"
NSQ_SOURCE_LINE 00000244 "#"
NSQ_SOURCE_LINE 00000245 "# Returns a formatted line out of @columns; the size of $column[$i]"
NSQ_SOURCE_LINE 00000246 "# is determined by $length[$i]."
NSQ_SOURCE_LINE 00000247 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000248 "sub _format_line {"
NSQ_SOURCE_LINE 00000249 "    my ($columns, $lengths) = @_;"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "    my $height = 0;"
NSQ_SOURCE_LINE 00000252 "    my @col_lines;"
NSQ_SOURCE_LINE 00000253 "    for (@$columns) {"
NSQ_SOURCE_LINE 00000254 "        my @lines = split \"\\n\", ((defined $_ && length $_) ? $_ : ' ');"
NSQ_SOURCE_LINE 00000255 "        $height = scalar @lines"
NSQ_SOURCE_LINE 00000256 "            if $height < @lines;"
NSQ_SOURCE_LINE 00000257 "        push @col_lines, \\@lines;"
NSQ_SOURCE_LINE 00000258 "    }"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "    my @lines;"
NSQ_SOURCE_LINE 00000261 "    for my $h (0 .. $height - 1 ) {"
NSQ_SOURCE_LINE 00000262 "        my @line;"
NSQ_SOURCE_LINE 00000263 "        for (my $i = 0; $i <= $#$columns; $i++) {"
NSQ_SOURCE_LINE 00000264 "            my $val = defined($col_lines[$i][$h]) ? $col_lines[$i][$h] : '';"
NSQ_SOURCE_LINE 00000265 "            push @line, sprintf \" %-\" . $lengths->[$i] . \"s \", $val;"
NSQ_SOURCE_LINE 00000266 "        }"
NSQ_SOURCE_LINE 00000267 "        push @lines, join '|', \"\", @line, \"\";"
NSQ_SOURCE_LINE 00000268 "    }"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "    return join \"\\n\", @lines;"
NSQ_SOURCE_LINE 00000271 "}"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000274 "# _column_length($str)"
NSQ_SOURCE_LINE 00000275 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000276 "sub _column_length"
NSQ_SOURCE_LINE 00000277 "{"
NSQ_SOURCE_LINE 00000278 "    my ($str) = @_;"
NSQ_SOURCE_LINE 00000279 "    $str = '' unless defined $str;"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "    my $len = 0;"
NSQ_SOURCE_LINE 00000282 "    for (split \"\\n\", $str) {"
NSQ_SOURCE_LINE 00000283 "        $len = length"
NSQ_SOURCE_LINE 00000284 "            if $len < length;"
NSQ_SOURCE_LINE 00000285 "    }"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    # untaint $len"
NSQ_SOURCE_LINE 00000288 "    unless ($len =~ m|^(\\d+)$|s)"
NSQ_SOURCE_LINE 00000289 "        { die 'invalid length: ' . $len }"
NSQ_SOURCE_LINE 00000290 "    $len = $1;"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "    return $len;"
NSQ_SOURCE_LINE 00000293 "}"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "1;"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "__END__"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=head1 NAME"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "Text::TabularDisplay - Display text in formatted table output"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "    use Text::TabularDisplay;"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "    my $table = Text::TabularDisplay->new(@columns);"
NSQ_SOURCE_LINE 00000308 "    $table->add(@row)"
NSQ_SOURCE_LINE 00000309 "        while (@row = $sth->fetchrow);"
NSQ_SOURCE_LINE 00000310 "    print $table->render;"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "    +----+--------------+"
NSQ_SOURCE_LINE 00000313 "    | id | name         |"
NSQ_SOURCE_LINE 00000314 "    +----+--------------+"
NSQ_SOURCE_LINE 00000315 "    | 1  | Tom          |"
NSQ_SOURCE_LINE 00000316 "    | 2  | Dick         |"
NSQ_SOURCE_LINE 00000317 "    | 3  | Barry        |"
NSQ_SOURCE_LINE 00000318 "    |    |  (aka Bazza) |"
NSQ_SOURCE_LINE 00000319 "    | 4  | Harry        |"
NSQ_SOURCE_LINE 00000320 "    +----+--------------+"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "Text::TabularDisplay simplifies displaying textual data in a table."
NSQ_SOURCE_LINE 00000326 "The output is identical to the columnar display of query results in"
NSQ_SOURCE_LINE 00000327 "the mysql text monitor.  For example, this data:"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "    1, \"Tom Jones\", \"(666) 555-1212\""
NSQ_SOURCE_LINE 00000330 "    2, \"Barnaby Jones\", \"(666) 555-1213\""
NSQ_SOURCE_LINE 00000331 "    3, \"Bridget Jones\", \"(666) 555-1214\""
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "Used like so:"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "    my $t = Text::TabularDisplay->new(qw(id name phone));"
NSQ_SOURCE_LINE 00000336 "    $t->add(1, \"Tom Jones\", \"(666) 555-1212\");"
NSQ_SOURCE_LINE 00000337 "    $t->add(2, \"Barnaby Jones\", \"(666) 555-1213\");"
NSQ_SOURCE_LINE 00000338 "    $t->add(3, \"Bridget Jones\", \"(666) 555-1214\");"
NSQ_SOURCE_LINE 00000339 "    print $t->render;"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "Produces:"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "    +----+---------------+----------------+"
NSQ_SOURCE_LINE 00000344 "    | id | name          | phone          |"
NSQ_SOURCE_LINE 00000345 "    +----+---------------+----------------+"
NSQ_SOURCE_LINE 00000346 "    | 1  | Tom Jones     | (666) 555-1212 |"
NSQ_SOURCE_LINE 00000347 "    | 2  | Barnaby Jones | (666) 555-1213 |"
NSQ_SOURCE_LINE 00000348 "    | 3  | Bridget Jones | (666) 555-1214 |"
NSQ_SOURCE_LINE 00000349 "    +----+---------------+----------------+"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=head1 METHODS"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "Text::TabularDisplay has four primary methods: new(), columns(),"
NSQ_SOURCE_LINE 00000355 "add(), and render().  new() creates a new Text::TabularDisplay"
NSQ_SOURCE_LINE 00000356 "instance; columns() sets the column headers in the output table;"
NSQ_SOURCE_LINE 00000357 "add() adds data to the instance; and render() returns a formatted"
NSQ_SOURCE_LINE 00000358 "string representation of the instance."
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "There are also a few auxiliary convenience methods: clone(), items(),"
NSQ_SOURCE_LINE 00000361 "reset(), populate(), and paginate()."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=over"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "=item B<new>"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "A Text::TabularDisplay instance can be created with column names"
NSQ_SOURCE_LINE 00000368 "passed as constructor args, so these two calls produce similar"
NSQ_SOURCE_LINE 00000369 "objects:"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "    my $t1 = Text::TabularDisplay->new;"
NSQ_SOURCE_LINE 00000372 "    $t1->columns(qw< one two >);"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "    my $t2 = Text::TabularDisplay->new(qw< one two >);"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "Calling new() on a Text::TabularDisplay instance returns a clone of"
NSQ_SOURCE_LINE 00000377 "the object.  See L<Text::TabularDisplay/clone>."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=item B<columns>"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "Gets or sets the column names for an instance.  This method is called"
NSQ_SOURCE_LINE 00000382 "automatically by the constructor with any parameters that are passed"
NSQ_SOURCE_LINE 00000383 "to the constructor (if any are passed)."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "When called in scalar context, columns() returns the I<number of"
NSQ_SOURCE_LINE 00000386 "columns in the instance>, rather than the columns themselves.  In list"
NSQ_SOURCE_LINE 00000387 "context, copies of the columns names are returned; the names of the"
NSQ_SOURCE_LINE 00000388 "columns cannot be modified this way."
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "=item B<add>"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "Takes a list of items and appends it to the list of items to be"
NSQ_SOURCE_LINE 00000393 "displayed.  add() can also take a reference to an array, so that large"
NSQ_SOURCE_LINE 00000394 "arrays don't need to be copied."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "As elements are processed, add() maintains the width of each column"
NSQ_SOURCE_LINE 00000397 "so that the resulting table has the correct dimensions."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "add() returns $self, so that calls to add() can be chained:"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "    $t->add(@one)->add(@two)->add(@three);"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=item B<render>"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "render() does most of the actual work. It returns a string containing"
NSQ_SOURCE_LINE 00000406 "the data added via add(), formatted as a table, with a header"
NSQ_SOURCE_LINE 00000407 "containing the column names."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "render() does not change the state of the object; it can be called"
NSQ_SOURCE_LINE 00000410 "multiple times, with identical output (including identical running"
NSQ_SOURCE_LINE 00000411 "time: the output of render is not cached)."
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "If there are no columns defined, then the output table does not"
NSQ_SOURCE_LINE 00000414 "contains a row of column names.  Compare these two sequences:"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "    my $t = Text::TabularDisplay->new;"
NSQ_SOURCE_LINE 00000417 "    $t->add(qw< 1 2 3 4 >);"
NSQ_SOURCE_LINE 00000418 "    $t->add(qw< 5 6 7 8 >);"
NSQ_SOURCE_LINE 00000419 "    print $t->render;"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "    $t->columns(qw< one two three four >);"
NSQ_SOURCE_LINE 00000422 "    print $t->render;"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "    # Example 1 output"
NSQ_SOURCE_LINE 00000425 "    +---+---+---+---+"
NSQ_SOURCE_LINE 00000426 "    | 1 | 2 | 3 | 4 |"
NSQ_SOURCE_LINE 00000427 "    | 5 | 6 | 7 | 8 |"
NSQ_SOURCE_LINE 00000428 "    +---+---+---+---+"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "    # Example 2 output"
NSQ_SOURCE_LINE 00000431 "    +-----+-----+-------+------+"
NSQ_SOURCE_LINE 00000432 "    | one | two | three | four |"
NSQ_SOURCE_LINE 00000433 "    +-----+-----+-------+------+"
NSQ_SOURCE_LINE 00000434 "    | 1   | 2   | 3     | 4    |"
NSQ_SOURCE_LINE 00000435 "    | 5   | 6   | 7     | 8    |"
NSQ_SOURCE_LINE 00000436 "    +-----+-----+-------+------+"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "render() takes optional $start and $end arguments; these indicate the"
NSQ_SOURCE_LINE 00000439 "start and end I<indexes> for the data to be rendered.  This can be"
NSQ_SOURCE_LINE 00000440 "used for paging and the like:"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "    $t->add(1, 2, 3)->add(4, 5, 6)->add(7, 8, 9)->add(10, 11, 12);"
NSQ_SOURCE_LINE 00000443 "    print $t->render(0, 1), \"\\n\";"
NSQ_SOURCE_LINE 00000444 "    print $t->render(2, 3), \"\\n\";"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "Produces:"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "    +-------+--------+-------+"
NSQ_SOURCE_LINE 00000449 "    | First | Second | Third |"
NSQ_SOURCE_LINE 00000450 "    +-------+--------+-------+"
NSQ_SOURCE_LINE 00000451 "    | 1     | 2      | 3     |"
NSQ_SOURCE_LINE 00000452 "    | 4     | 5      | 6     |"
NSQ_SOURCE_LINE 00000453 "    +-------+--------+-------+"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "    +-------+--------+-------+"
NSQ_SOURCE_LINE 00000456 "    | First | Second | Third |"
NSQ_SOURCE_LINE 00000457 "    +-------+--------+-------+"
NSQ_SOURCE_LINE 00000458 "    | 7     | 8      | 9     |"
NSQ_SOURCE_LINE 00000459 "    | 10    | 11     | 12    |"
NSQ_SOURCE_LINE 00000460 "    +-------+--------+-------+"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "As an aside, note the chaining of calls to add()."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "The elements in the table are padded such that there is the same"
NSQ_SOURCE_LINE 00000465 "number of items in each row, including the header.  Thus:"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "    $t->columns(qw< One Two >);"
NSQ_SOURCE_LINE 00000468 "    print $t->render;"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "    +-----+-----+----+"
NSQ_SOURCE_LINE 00000471 "    | One | Two |    |"
NSQ_SOURCE_LINE 00000472 "    +-----+-----+----+"
NSQ_SOURCE_LINE 00000473 "    | 1   | 2   | 3  |"
NSQ_SOURCE_LINE 00000474 "    | 4   | 5   | 6  |"
NSQ_SOURCE_LINE 00000475 "    | 7   | 8   | 9  |"
NSQ_SOURCE_LINE 00000476 "    | 10  | 11  | 12 |"
NSQ_SOURCE_LINE 00000477 "    +-----+-----+----+"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "And:"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "    $t->columns(qw< One Two Three Four>);"
NSQ_SOURCE_LINE 00000482 "    print $t->render;"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "    +-----+-----+-------+------+"
NSQ_SOURCE_LINE 00000485 "    | One | Two | Three | Four |"
NSQ_SOURCE_LINE 00000486 "    +-----+-----+-------+------+"
NSQ_SOURCE_LINE 00000487 "    | 1   | 2   | 3     |      |"
NSQ_SOURCE_LINE 00000488 "    | 4   | 5   | 6     |      |"
NSQ_SOURCE_LINE 00000489 "    | 7   | 8   | 9     |      |"
NSQ_SOURCE_LINE 00000490 "    | 10  | 11  | 12    |      |"
NSQ_SOURCE_LINE 00000491 "    +-----+-----+-------+------+"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "=back"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "=head1 OTHER METHODS"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "=over 4"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "=item clone()"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "The clone() method returns an identical copy of a Text::TabularDisplay"
NSQ_SOURCE_LINE 00000502 "instance, completely separate from the cloned instance."
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "=item items()"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "The items() method returns the number of elements currently stored in"
NSQ_SOURCE_LINE 00000507 "the data structure:"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "    printf \"There are %d elements in \\$t.\\n\", $t->items;"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=item reset()"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "Reset deletes the data from the instance, including columns.  If"
NSQ_SOURCE_LINE 00000514 "passed arguments, it passes them to columns(), just like new()."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=item populate()"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "populate() as a special case of add(); populate() expects a reference"
NSQ_SOURCE_LINE 00000519 "to an array of references to arrays, such as returned by DBI's"
NSQ_SOURCE_LINE 00000520 "selectall_arrayref method:"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "    $sql = \"SELECT \" . join(\", \", @c) . \" FROM mytable\";"
NSQ_SOURCE_LINE 00000523 "    $t->columns(@c);"
NSQ_SOURCE_LINE 00000524 "    $t->populate($dbh->selectall_arrayref($sql));"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "This is for convenience only; the implementation maps this to multiple"
NSQ_SOURCE_LINE 00000527 "calls to add()."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=back"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "=head1 NOTES / ISSUES"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "Text::TabularDisplay assumes it is handling strings, and does stringy"
NSQ_SOURCE_LINE 00000534 "things with the data, like length() and sprintf().  Non-character data"
NSQ_SOURCE_LINE 00000535 "can be passed in, of course, but will be treated as strings; this may"
NSQ_SOURCE_LINE 00000536 "have ramifications for objects that implement overloading."
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "The biggest issue, though, is that this module duplicates a some of the"
NSQ_SOURCE_LINE 00000539 "functionality of Data::ShowTable.  Of course, Data::ShowTable is a"
NSQ_SOURCE_LINE 00000540 "large, complex monolithic tool that does a lot of things, while"
NSQ_SOURCE_LINE 00000541 "Text::TabularDisplay is small and fast."
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000544 ""
