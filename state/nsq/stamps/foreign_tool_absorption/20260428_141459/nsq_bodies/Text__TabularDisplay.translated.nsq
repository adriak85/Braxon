NSQ_SOURCE_LINE 00000001 "package Text::TabularDisplay;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "# -------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000004 "# Text::TabularDisplay - Display text in formatted table output"
NSQ_SOURCE_LINE 00000005 "# Copyright (C) 2004-2014 darren chamberlain <darren@cpan.org>"
NSQ_SOURCE_LINE 00000006 "#"
