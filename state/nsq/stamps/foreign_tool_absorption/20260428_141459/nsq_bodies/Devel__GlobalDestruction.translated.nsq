BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Devel::GlobalDestruction;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.14';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Sub::Exporter::Progressive -setup => {"
NSQ_SOURCE_LINE 00000009 "  exports => [ qw(in_global_destruction) ],"
NSQ_SOURCE_LINE 00000010 "  groups  => { default => [ -all ] },"
NSQ_SOURCE_LINE 00000011 "};"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "# we run 5.14+ - everything is in core"
NSQ_SOURCE_LINE 00000014 "#"
NSQ_SOURCE_LINE 00000015 "if (defined ${^GLOBAL_PHASE}) {"
NSQ_SOURCE_LINE 00000016 "  eval 'sub in_global_destruction () { ${^GLOBAL_PHASE} eq q[DESTRUCT] }; 1'"
NSQ_SOURCE_LINE 00000017 "    or die $@;"
NSQ_SOURCE_LINE 00000018 "}"
NSQ_SOURCE_LINE 00000019 "# try to load the xs version if it was compiled"
NSQ_SOURCE_LINE 00000020 "#"
NSQ_SOURCE_LINE 00000021 "elsif (eval {"
NSQ_SOURCE_LINE 00000022 "  require Devel::GlobalDestruction::XS;"
NSQ_SOURCE_LINE 00000023 "  no warnings 'once';"
NSQ_SOURCE_LINE 00000024 "  *in_global_destruction = \\&Devel::GlobalDestruction::XS::in_global_destruction;"
NSQ_SOURCE_LINE 00000025 "  1;"
NSQ_SOURCE_LINE 00000026 "}) {"
NSQ_SOURCE_LINE 00000027 "  # the eval already installed everything, nothing to do"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 "else {"
NSQ_SOURCE_LINE 00000030 "  # internally, PL_main_cv is set to Nullcv immediately before entering"
NSQ_SOURCE_LINE 00000031 "  # global destruction and we can use B to detect that.  B::main_cv will"
NSQ_SOURCE_LINE 00000032 "  # only ever be a B::CV or a B::SPECIAL that is a reference to 0"
NSQ_SOURCE_LINE 00000033 "  require B;"
NSQ_SOURCE_LINE 00000034 "  eval 'sub in_global_destruction () { ${B::main_cv()} == 0 }; 1'"
NSQ_SOURCE_LINE 00000035 "    or die $@;"
NSQ_SOURCE_LINE 00000036 "}"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "1;  # keep require happy"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "__END__"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=head1 NAME"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "Devel::GlobalDestruction - Provides function returning the equivalent of"
NSQ_SOURCE_LINE 00000046 "C<${^GLOBAL_PHASE} eq 'DESTRUCT'> for older perls."
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    package Foo;"
NSQ_SOURCE_LINE 00000051 "    use Devel::GlobalDestruction;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    use namespace::clean; # to avoid having an \"in_global_destruction\" method"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    sub DESTROY {"
NSQ_SOURCE_LINE 00000056 "        return if in_global_destruction;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "        do_something_a_little_tricky();"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "Perl's global destruction is a little tricky to deal with WRT finalizers"
NSQ_SOURCE_LINE 00000064 "because it's not ordered and objects can sometimes disappear."
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "Writing defensive destructors is hard and annoying, and usually if global"
NSQ_SOURCE_LINE 00000067 "destruction is happening you only need the destructors that free up non"
NSQ_SOURCE_LINE 00000068 "process local resources to actually execute."
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "For these constructors you can avoid the mess by simply bailing out if global"
NSQ_SOURCE_LINE 00000071 "destruction is in effect."
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "This module uses L<Sub::Exporter::Progressive> so the exports may be renamed,"
NSQ_SOURCE_LINE 00000076 "aliased, etc. if L<Sub::Exporter> is present."
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=over 4"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=item in_global_destruction"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Returns true if the interpreter is in global destruction. In perl 5.14+, this"
NSQ_SOURCE_LINE 00000083 "returns C<${^GLOBAL_PHASE} eq 'DESTRUCT'>, and on earlier perls, detects it using"
NSQ_SOURCE_LINE 00000084 "the value of C<PL_main_cv> or C<PL_dirty>."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=back"
NSQ_SOURCE_LINE 00000087 ""
