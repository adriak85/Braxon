BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package DBIx::UpdateTable::FromHoH;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2020-05-06'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'DBIx-UpdateTable-FromHoH'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.002'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 "use Log::ger;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Exporter;"
NSQ_SOURCE_LINE 00000014 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000015 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000016 "                       update_table_from_hoh"
NSQ_SOURCE_LINE 00000017 "               );"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "our %SPEC;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub _eq {"
NSQ_SOURCE_LINE 00000022 "    my ($v1, $v2) = @_;"
NSQ_SOURCE_LINE 00000023 "    my $v1_def = defined $v1;"
NSQ_SOURCE_LINE 00000024 "    my $v2_def = defined $v2;"
NSQ_SOURCE_LINE 00000025 "    return 1 if !$v1_def && !$v2_def;"
NSQ_SOURCE_LINE 00000026 "    return 0 if $v1_def xor $v2_def;"
NSQ_SOURCE_LINE 00000027 "    $v1 eq $v2;"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "$SPEC{update_table_from_hoh} = {"
NSQ_SOURCE_LINE 00000031 "    v => 1.1,"
NSQ_SOURCE_LINE 00000032 "    summary => 'Update database table from hash-of-hash',"
NSQ_SOURCE_LINE 00000033 "    description => <<'_',"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "Given a table `t1` like this:"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    id    col1    col2    col3"
NSQ_SOURCE_LINE 00000038 "    --    ----    ----    ----"
NSQ_SOURCE_LINE 00000039 "    1     a       b       foo"
NSQ_SOURCE_LINE 00000040 "    2     c       c       bar"
NSQ_SOURCE_LINE 00000041 "    3     g       h       qux"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "this code:"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    my $res = update_table_from_hoh("
NSQ_SOURCE_LINE 00000046 "        dbh => $dbh,"
NSQ_SOURCE_LINE 00000047 "        table => 't1',"
NSQ_SOURCE_LINE 00000048 "        key_column => 'id',"
NSQ_SOURCE_LINE 00000049 "        hoh => {"
NSQ_SOURCE_LINE 00000050 "            1 => {col1=>'a', col2=>'b'},"
NSQ_SOURCE_LINE 00000051 "            2 => {col1=>'c', col2=>'d'},"
NSQ_SOURCE_LINE 00000052 "            4 => {col1=>'e', col2=>'f'},"
NSQ_SOURCE_LINE 00000053 "        },"
NSQ_SOURCE_LINE 00000054 "    );"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "will perform these SQL queries:"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    UPDATE TABLE t1 SET col2='d' WHERE id='2';"
NSQ_SOURCE_LINE 00000059 "    INSERT INTO t1 (id,col1,col2) VALUES (4,'e','f');"
NSQ_SOURCE_LINE 00000060 "    DELETE FROM t1 WHERE id='3';"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "to make table `t1` become like this:"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    id    col1    col2    col3"
NSQ_SOURCE_LINE 00000065 "    --    ----    ----    ----"
NSQ_SOURCE_LINE 00000066 "    1     a       b       foo"
NSQ_SOURCE_LINE 00000067 "    2     c       d       bar"
NSQ_SOURCE_LINE 00000068 "    4     e       f       qux"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "_"
NSQ_SOURCE_LINE 00000071 "    args => {"
NSQ_SOURCE_LINE 00000072 "        dbh => {"
NSQ_SOURCE_LINE 00000073 "            schema => ['obj*'],"
NSQ_SOURCE_LINE 00000074 "            req => 1,"
NSQ_SOURCE_LINE 00000075 "        },"
NSQ_SOURCE_LINE 00000076 "        table => {"
NSQ_SOURCE_LINE 00000077 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000078 "            req => 1,"
NSQ_SOURCE_LINE 00000079 "        },"
NSQ_SOURCE_LINE 00000080 "        hoh => {"
NSQ_SOURCE_LINE 00000081 "            schema => 'hoh*',"
NSQ_SOURCE_LINE 00000082 "            req => 1,"
NSQ_SOURCE_LINE 00000083 "        },"
NSQ_SOURCE_LINE 00000084 "        key_column => {"
NSQ_SOURCE_LINE 00000085 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000086 "            req => 1,"
NSQ_SOURCE_LINE 00000087 "        },"
NSQ_SOURCE_LINE 00000088 "        data_columns => {"
NSQ_SOURCE_LINE 00000089 "            schema => ['array*', of=>'str*'],"
NSQ_SOURCE_LINE 00000090 "        },"
NSQ_SOURCE_LINE 00000091 "        use_tx => {"
NSQ_SOURCE_LINE 00000092 "            schema => 'bool*',"
NSQ_SOURCE_LINE 00000093 "            default => 1,"
NSQ_SOURCE_LINE 00000094 "        },"
NSQ_SOURCE_LINE 00000095 "        extra_insert_columns => {"
NSQ_SOURCE_LINE 00000096 "            schema => ['hos*'], # XXX or code"
NSQ_SOURCE_LINE 00000097 "        },"
NSQ_SOURCE_LINE 00000098 "        extra_update_columns => {"
NSQ_SOURCE_LINE 00000099 "            schema => ['hos*'], # XXX or code"
NSQ_SOURCE_LINE 00000100 "        },"
NSQ_SOURCE_LINE 00000101 "    },"
NSQ_SOURCE_LINE 00000102 "};"
NSQ_SOURCE_LINE 00000103 "sub update_table_from_hoh {"
NSQ_SOURCE_LINE 00000104 "    my %args = @_;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    my $dbh = $args{dbh};"
NSQ_SOURCE_LINE 00000107 "    my $table = $args{table};"
NSQ_SOURCE_LINE 00000108 "    my $hoh = $args{hoh};"
NSQ_SOURCE_LINE 00000109 "    my $key_column = $args{key_column};"
NSQ_SOURCE_LINE 00000110 "    my $data_columns = $args{data_columns};"
NSQ_SOURCE_LINE 00000111 "    my $use_tx = $args{use_tx} // 1;"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "    unless ($data_columns) {"
NSQ_SOURCE_LINE 00000114 "        my %columns;"
NSQ_SOURCE_LINE 00000115 "        for my $key (keys %$hoh) {"
NSQ_SOURCE_LINE 00000116 "            my $row = $hoh->{$key};"
NSQ_SOURCE_LINE 00000117 "            $columns{ $_ }++ for keys %$row;"
NSQ_SOURCE_LINE 00000118 "        }"
NSQ_SOURCE_LINE 00000119 "        $data_columns = [sort keys %columns];"
NSQ_SOURCE_LINE 00000120 "    }"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    my @columns = @$data_columns;"
NSQ_SOURCE_LINE 00000123 "    push @columns, $key_column unless grep { $_ eq $key_column } @columns;"
NSQ_SOURCE_LINE 00000124 "    my $columns_str = join(\",\", @columns);"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "    $dbh->begin_work if $use_tx;"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "    my $hoh_table = {};"
NSQ_SOURCE_LINE 00000129 "  GET_ROWS: {"
NSQ_SOURCE_LINE 00000130 "        my $sth = $dbh->prepare(\"SELECT $columns_str FROM $table\");"
NSQ_SOURCE_LINE 00000131 "        $sth->execute;"
NSQ_SOURCE_LINE 00000132 "        while (my $row = $sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000133 "            $hoh_table->{ $row->{$key_column} } = $row;"
NSQ_SOURCE_LINE 00000134 "        }"
NSQ_SOURCE_LINE 00000135 "    }"
NSQ_SOURCE_LINE 00000136 "    my $num_rows_unchanged = keys %$hoh_table;"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "    my $num_rows_deleted = 0;"
NSQ_SOURCE_LINE 00000139 "  DELETE: {"
NSQ_SOURCE_LINE 00000140 "        for my $key (sort keys %$hoh_table) {"
NSQ_SOURCE_LINE 00000141 "            unless (exists $hoh->{$key}) {"
NSQ_SOURCE_LINE 00000142 "                $dbh->do(\"DELETE FROM $table WHERE $key_column=?\", {}, $key);"
NSQ_SOURCE_LINE 00000143 "                $num_rows_deleted++;"
NSQ_SOURCE_LINE 00000144 "                $num_rows_unchanged--;"
NSQ_SOURCE_LINE 00000145 "            }"
NSQ_SOURCE_LINE 00000146 "        }"
NSQ_SOURCE_LINE 00000147 "    }"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    my $num_rows_updated = 0;"
NSQ_SOURCE_LINE 00000150 "  UPDATE: {"
NSQ_SOURCE_LINE 00000151 "        for my $key (sort keys %$hoh) {"
NSQ_SOURCE_LINE 00000152 "            next unless exists $hoh_table->{$key};"
NSQ_SOURCE_LINE 00000153 "            my @update_columns;"
NSQ_SOURCE_LINE 00000154 "            my @values;"
NSQ_SOURCE_LINE 00000155 "            for my $column (@columns) {"
NSQ_SOURCE_LINE 00000156 "                next if $column eq $key_column;"
NSQ_SOURCE_LINE 00000157 "                unless (_eq($hoh_table->{$key}{$column}, $hoh->{$key}{$column})) {"
NSQ_SOURCE_LINE 00000158 "                    push @update_columns, $column;"
NSQ_SOURCE_LINE 00000159 "                    push @values, $hoh->{$key}{$column};"
NSQ_SOURCE_LINE 00000160 "                }"
NSQ_SOURCE_LINE 00000161 "            }"
NSQ_SOURCE_LINE 00000162 "            next unless @update_columns;"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "            for my $column (keys %{ $args{extra_update_columns} // {}}) {"
NSQ_SOURCE_LINE 00000165 "                next if grep { $column eq $_ } @columns;"
NSQ_SOURCE_LINE 00000166 "                push @update_columns, $column;"
NSQ_SOURCE_LINE 00000167 "                push @values, $args{extra_update_columns}{$column};"
NSQ_SOURCE_LINE 00000168 "            }"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "            $dbh->do(\"UPDATE $table SET \"."
NSQ_SOURCE_LINE 00000171 "                         join(\",\", map {\"$_=?\"} @update_columns)."
NSQ_SOURCE_LINE 00000172 "                         \" WHERE $key_column=?\","
NSQ_SOURCE_LINE 00000173 "                     {},"
NSQ_SOURCE_LINE 00000174 "                     @values, $key);"
NSQ_SOURCE_LINE 00000175 "            $num_rows_updated++;"
NSQ_SOURCE_LINE 00000176 "            $num_rows_unchanged--;"
NSQ_SOURCE_LINE 00000177 "        }"
NSQ_SOURCE_LINE 00000178 "    }"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    my $num_rows_inserted = 0;"
NSQ_SOURCE_LINE 00000181 "  INSERT: {"
NSQ_SOURCE_LINE 00000182 "        my @insert_columns = @columns;"
NSQ_SOURCE_LINE 00000183 "        my @extra_insert_columns = keys %{ $args{extra_insert_columns} // {} };"
NSQ_SOURCE_LINE 00000184 "        for my $column (@extra_insert_columns) { push @insert_columns, $column unless grep { $_ eq $column } @insert_columns }"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "        my $insert_columns_str = join(\",\", @insert_columns);"
NSQ_SOURCE_LINE 00000187 "        my $placeholders_str = join(\",\", map {\"?\"} @insert_columns);"
NSQ_SOURCE_LINE 00000188 "        for my $key (sort keys %$hoh) {"
NSQ_SOURCE_LINE 00000189 "            unless (exists $hoh_table->{$key}) {"
NSQ_SOURCE_LINE 00000190 "                my @values;"
NSQ_SOURCE_LINE 00000191 "                for my $column (@insert_columns) {"
NSQ_SOURCE_LINE 00000192 "                    if ($column eq $key_column) {"
NSQ_SOURCE_LINE 00000193 "                        push @values, $key;"
NSQ_SOURCE_LINE 00000194 "                    } elsif (grep { $column eq $_ } @extra_insert_columns) {"
NSQ_SOURCE_LINE 00000195 "                        push @values, $args{extra_insert_columns}{$column};"
NSQ_SOURCE_LINE 00000196 "                    } else {"
NSQ_SOURCE_LINE 00000197 "                        push @values, $hoh->{$key}{$column};"
NSQ_SOURCE_LINE 00000198 "                    }"
NSQ_SOURCE_LINE 00000199 "                }"
NSQ_SOURCE_LINE 00000200 "                $dbh->do(\"INSERT INTO $table ($insert_columns_str) VALUES ($placeholders_str)\", {}, @values);"
NSQ_SOURCE_LINE 00000201 "                $num_rows_inserted++;"
NSQ_SOURCE_LINE 00000202 "            }"
NSQ_SOURCE_LINE 00000203 "        }"
NSQ_SOURCE_LINE 00000204 "    }"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    $dbh->commit if $use_tx;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    [$num_rows_deleted || $num_rows_inserted || $num_rows_updated ? 200 : 304,"
NSQ_SOURCE_LINE 00000209 "     \"OK\","
NSQ_SOURCE_LINE 00000210 "     {"
NSQ_SOURCE_LINE 00000211 "         num_rows_deleted   => $num_rows_deleted,"
NSQ_SOURCE_LINE 00000212 "         num_rows_inserted  => $num_rows_inserted,"
NSQ_SOURCE_LINE 00000213 "         num_rows_updated   => $num_rows_updated,"
NSQ_SOURCE_LINE 00000214 "         num_rows_unchanged => $num_rows_unchanged,"
NSQ_SOURCE_LINE 00000215 "     }];"
NSQ_SOURCE_LINE 00000216 "}"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "1;"
NSQ_SOURCE_LINE 00000219 "# ABSTRACT: Update database table from hash-of-hash"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "__END__"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=pod"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "=head1 NAME"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "DBIx::UpdateTable::FromHoH - Update database table from hash-of-hash"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=head1 VERSION"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "This document describes version 0.002 of DBIx::UpdateTable::FromHoH (from Perl distribution DBIx-UpdateTable-FromHoH), released on 2020-05-06."
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "Currently only tested on SQLite."
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head2 update_table_from_hoh"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Usage:"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 " update_table_from_hoh(%args) -> [status, msg, payload, meta]"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "Update database table from hash-of-hash."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "Given a table C<t1> like this:"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 " id    col1    col2    col3"
NSQ_SOURCE_LINE 00000253 " --    ----    ----    ----"
NSQ_SOURCE_LINE 00000254 " 1     a       b       foo"
NSQ_SOURCE_LINE 00000255 " 2     c       c       bar"
NSQ_SOURCE_LINE 00000256 " 3     g       h       qux"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "this code:"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 " my $res = update_table_from_hoh("
NSQ_SOURCE_LINE 00000261 "     dbh => $dbh,"
NSQ_SOURCE_LINE 00000262 "     table => 't1',"
NSQ_SOURCE_LINE 00000263 "     key_column => 'id',"
NSQ_SOURCE_LINE 00000264 "     hoh => {"
NSQ_SOURCE_LINE 00000265 "         1 => {col1=>'a', col2=>'b'},"
NSQ_SOURCE_LINE 00000266 "         2 => {col1=>'c', col2=>'d'},"
NSQ_SOURCE_LINE 00000267 "         4 => {col1=>'e', col2=>'f'},"
NSQ_SOURCE_LINE 00000268 "     },"
NSQ_SOURCE_LINE 00000269 " );"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "will perform these SQL queries:"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 " UPDATE TABLE t1 SET col2='d' WHERE id='2';"
NSQ_SOURCE_LINE 00000274 " INSERT INTO t1 (id,col1,col2) VALUES (4,'e','f');"
NSQ_SOURCE_LINE 00000275 " DELETE FROM t1 WHERE id='3';"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "to make table C<t1> become like this:"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 " id    col1    col2    col3"
NSQ_SOURCE_LINE 00000280 " --    ----    ----    ----"
NSQ_SOURCE_LINE 00000281 " 1     a       b       foo"
NSQ_SOURCE_LINE 00000282 " 2     c       d       bar"
NSQ_SOURCE_LINE 00000283 " 4     e       f       qux"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=over 4"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=item * B<data_columns> => I<array[str]>"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=item * B<dbh>* => I<obj>"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=item * B<extra_insert_columns> => I<hos>"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=item * B<extra_update_columns> => I<hos>"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=item * B<hoh>* => I<hoh>"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=item * B<key_column>* => I<str>"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=item * B<table>* => I<str>"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=item * B<use_tx> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=back"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "First element (status) is an integer containing HTTP status code"
NSQ_SOURCE_LINE 00000313 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000314 "(msg) is a string containing error message, or 'OK' if status is"
NSQ_SOURCE_LINE 00000315 "200. Third element (payload) is optional, the actual result. Fourth"
NSQ_SOURCE_LINE 00000316 "element (meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000317 "that contains extra information."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "Return value:  (any)"
NSQ_SOURCE_LINE 00000320 ""
