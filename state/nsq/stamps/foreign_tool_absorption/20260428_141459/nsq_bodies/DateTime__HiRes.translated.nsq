NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "# ABSTRACT: Create DateTime objects with sub-second current time resolution"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "__END__"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "=pod"
NSQ_SOURCE_LINE 00000020 ""
