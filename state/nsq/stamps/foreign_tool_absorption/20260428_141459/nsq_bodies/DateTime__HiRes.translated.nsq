NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "=head1 NAME"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "DateTime::HiRes - Create DateTime objects with sub-second current time resolution"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "=head1 VERSION"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "version 0.04"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    use DateTime::HiRes;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    my $dt = DateTime::HiRes->now;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "This module enables you to generate DateTime objects that represent the current"
NSQ_SOURCE_LINE 00000040 "time with sub-second resolution."
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=head1 METHODS"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "This class provides the following methods:"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=head2 DateTime::HiRes->now( ... )"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "Similar to C<DateTime-E<gt>now> but uses C<Time::HiRes::time()> instead of"
NSQ_SOURCE_LINE 00000049 "Perl's C<CORE::time()> to determine the current time. The returned object will"
NSQ_SOURCE_LINE 00000050 "have fractional second information stored as nanoseconds. The sub-second"
NSQ_SOURCE_LINE 00000051 "precision of C<Time::HiRes> is highly system dependent and will vary from one"
NSQ_SOURCE_LINE 00000052 "platform to the next."
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "Just like C<DateTime-E<gt>now> it accepts \"time_zone\" and \"locale\" parameters."
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=head1 CREDITS"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "Everyone at the DateTime C<Asylum>."
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "L<DateTime>, L<Time::HiRes>"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "Bugs may be submitted at L<https://github.com/houseabsolute/DateTime-HiRes/issues>."
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "I am also usually active on IRC as 'autarch' on C<irc://irc.perl.org>."
NSQ_SOURCE_LINE 00000069 ""
