NSQ_SOURCE_LINE 00002577 "             defined( $options->{ContentHandler} )  or"
NSQ_SOURCE_LINE 00002578 "             defined( $options->{DTDHandler} )      or"
NSQ_SOURCE_LINE 00002579 "             defined( $options->{DocumentHandler} ) or"
NSQ_SOURCE_LINE 00002580 "             defined( $options->{LexicalHandler} )  or"
NSQ_SOURCE_LINE 00002581 "             defined( $options->{ErrorHandler} )    or"
NSQ_SOURCE_LINE 00002582 "             defined( $options->{DeclHandler} ) ) {"
NSQ_SOURCE_LINE 00002583 "            "
NSQ_SOURCE_LINE 00002584 "             $options->{Handler} = XML::SAX::Base::NoHandler->new;"
NSQ_SOURCE_LINE 00002585 "    }"
NSQ_SOURCE_LINE 00002586 ""
NSQ_SOURCE_LINE 00002587 "    my $self = bless $options, $class;"
NSQ_SOURCE_LINE 00002588 "    # turn NS processing on by default"
NSQ_SOURCE_LINE 00002589 "    $self->set_feature('http://xml.org/sax/features/namespaces', 1);"
NSQ_SOURCE_LINE 00002590 "    return $self;"
