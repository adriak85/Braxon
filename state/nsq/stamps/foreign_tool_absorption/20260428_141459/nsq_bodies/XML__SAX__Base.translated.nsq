NSQ_SOURCE_LINE 00002751 "            );"
NSQ_SOURCE_LINE 00002752 "    }"
NSQ_SOURCE_LINE 00002753 "    throw XML::SAX::Exception::NotRecognized("
NSQ_SOURCE_LINE 00002754 "        Message => \"The feature '$feat' is not recognized by \" . ref($self),"
NSQ_SOURCE_LINE 00002755 "        Exception => undef,"
NSQ_SOURCE_LINE 00002756 "        );"
