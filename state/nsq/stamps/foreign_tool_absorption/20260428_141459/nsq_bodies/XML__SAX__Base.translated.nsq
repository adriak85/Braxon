NSQ_SOURCE_LINE 00002735 "    my $feat = shift;"
NSQ_SOURCE_LINE 00002736 "    my $value = shift;"
NSQ_SOURCE_LINE 00002737 "    # check %FEATURES to see if it's there, and set it if so"
NSQ_SOURCE_LINE 00002738 "    # throw XML::SAX::Exception::NotRecognized if it's not there"
NSQ_SOURCE_LINE 00002739 "    # throw XML::SAX::Exception::NotSupported if it's there but we"
NSQ_SOURCE_LINE 00002740 "    # don't support it"
NSQ_SOURCE_LINE 00002741 "    "
NSQ_SOURCE_LINE 00002742 "    my %features = $self->get_features();"
NSQ_SOURCE_LINE 00002743 "    if (exists $features{$feat}) {"
NSQ_SOURCE_LINE 00002744 "        my %supported = map { $_ => 1 } $self->supported_features();"
NSQ_SOURCE_LINE 00002745 "        if ($supported{$feat}) {"
NSQ_SOURCE_LINE 00002746 "            return $self->{__PACKAGE__ . \"::Features\"}{$feat} = $value;"
NSQ_SOURCE_LINE 00002747 "        }"
NSQ_SOURCE_LINE 00002748 "        throw XML::SAX::Exception::NotSupported("
NSQ_SOURCE_LINE 00002749 "            Message => \"The feature '$feat' is not supported by \" . ref($self),"
