NSQ_SOURCE_LINE 00002701 "# get_feature"
NSQ_SOURCE_LINE 00002702 "#-------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00002703 "sub get_feature {"
NSQ_SOURCE_LINE 00002704 "    my $self = shift;"
NSQ_SOURCE_LINE 00002705 "    my $feat = shift;"
NSQ_SOURCE_LINE 00002706 ""
NSQ_SOURCE_LINE 00002707 "    # check %FEATURES to see if it's there, and return it if so"
NSQ_SOURCE_LINE 00002708 "    # throw XML::SAX::Exception::NotRecognized if it's not there"
NSQ_SOURCE_LINE 00002709 "    # throw XML::SAX::Exception::NotSupported if it's there but we"
NSQ_SOURCE_LINE 00002710 "    # don't support it"
NSQ_SOURCE_LINE 00002711 "    "
NSQ_SOURCE_LINE 00002712 "    my %features = $self->get_features();"
NSQ_SOURCE_LINE 00002713 "    if (exists $features{$feat}) {"
NSQ_SOURCE_LINE 00002714 "        my %supported = map { $_ => 1 } $self->supported_features();"
NSQ_SOURCE_LINE 00002715 "        if ($supported{$feat}) {"
NSQ_SOURCE_LINE 00002716 "            return $self->{__PACKAGE__ . \"::Features\"}{$feat};"
NSQ_SOURCE_LINE 00002717 "        }"
NSQ_SOURCE_LINE 00002718 "        throw XML::SAX::Exception::NotSupported("
NSQ_SOURCE_LINE 00002719 "            Message => \"The feature '$feat' is not supported by \" . ref($self),"
NSQ_SOURCE_LINE 00002720 "            Exception => undef,"
NSQ_SOURCE_LINE 00002721 "            );"
NSQ_SOURCE_LINE 00002722 "    }"
NSQ_SOURCE_LINE 00002723 "    throw XML::SAX::Exception::NotRecognized("
NSQ_SOURCE_LINE 00002724 "        Message => \"The feature '$feat' is not recognized by \" . ref($self),"
NSQ_SOURCE_LINE 00002725 "        Exception => undef,"
NSQ_SOURCE_LINE 00002726 "        );"
NSQ_SOURCE_LINE 00002727 "}"
