NSQ_SOURCE_LINE 00000001 "use 5.008001; # sane UTF-8 support"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "package YAML::Tiny; # git description: v1.75-3-g85169f1"
NSQ_SOURCE_LINE 00000005 "# XXX-INGY is 5.8.1 too old/broken for utf8?"
NSQ_SOURCE_LINE 00000006 "# XXX-XDG Lancaster consensus was that it was sufficient until"
NSQ_SOURCE_LINE 00000007 "# proven otherwise"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $VERSION = '1.76';"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "#####################################################################"
NSQ_SOURCE_LINE 00000012 "# The YAML::Tiny API."
NSQ_SOURCE_LINE 00000013 "#"
NSQ_SOURCE_LINE 00000014 "# These are the currently documented API functions/methods and"
NSQ_SOURCE_LINE 00000015 "# exports:"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "use Exporter;"
NSQ_SOURCE_LINE 00000018 "our @ISA       = qw{ Exporter  };"
NSQ_SOURCE_LINE 00000019 "our @EXPORT    = qw{ Load Dump };"
NSQ_SOURCE_LINE 00000020 "our @EXPORT_OK = qw{ LoadFile DumpFile freeze thaw };"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "###"
NSQ_SOURCE_LINE 00000023 "# Functional/Export API:"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub Dump {"
NSQ_SOURCE_LINE 00000026 "    return YAML::Tiny->new(@_)->_dump_string;"
NSQ_SOURCE_LINE 00000027 "}"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "# XXX-INGY Returning last document seems a bad behavior."
NSQ_SOURCE_LINE 00000030 "# XXX-XDG I think first would seem more natural, but I don't know"
NSQ_SOURCE_LINE 00000031 "# that it's worth changing now"
NSQ_SOURCE_LINE 00000032 "sub Load {"
NSQ_SOURCE_LINE 00000033 "    my $self = YAML::Tiny->_load_string(@_);"
NSQ_SOURCE_LINE 00000034 "    if ( wantarray ) {"
NSQ_SOURCE_LINE 00000035 "        return @$self;"
NSQ_SOURCE_LINE 00000036 "    } else {"
NSQ_SOURCE_LINE 00000037 "        # To match YAML.pm, return the last document"
NSQ_SOURCE_LINE 00000038 "        return $self->[-1];"
NSQ_SOURCE_LINE 00000039 "    }"
NSQ_SOURCE_LINE 00000040 "}"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "# XXX-INGY Do we really need freeze and thaw?"
NSQ_SOURCE_LINE 00000043 "# XXX-XDG I don't think so.  I'd support deprecating them."
NSQ_SOURCE_LINE 00000044 "BEGIN {"
NSQ_SOURCE_LINE 00000045 "    *freeze = \\&Dump;"
NSQ_SOURCE_LINE 00000046 "    *thaw   = \\&Load;"
NSQ_SOURCE_LINE 00000047 "}"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "sub DumpFile {"
NSQ_SOURCE_LINE 00000050 "    my $file = shift;"
NSQ_SOURCE_LINE 00000051 "    return YAML::Tiny->new(@_)->_dump_file($file);"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub LoadFile {"
NSQ_SOURCE_LINE 00000055 "    my $file = shift;"
NSQ_SOURCE_LINE 00000056 "    my $self = YAML::Tiny->_load_file($file);"
NSQ_SOURCE_LINE 00000057 "    if ( wantarray ) {"
NSQ_SOURCE_LINE 00000058 "        return @$self;"
NSQ_SOURCE_LINE 00000059 "    } else {"
NSQ_SOURCE_LINE 00000060 "        # Return only the last document to match YAML.pm,"
NSQ_SOURCE_LINE 00000061 "        return $self->[-1];"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 "}"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "###"
NSQ_SOURCE_LINE 00000067 "# Object Oriented API:"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "# Create an empty YAML::Tiny object"
NSQ_SOURCE_LINE 00000070 "# XXX-INGY Why do we use ARRAY object?"
NSQ_SOURCE_LINE 00000071 "# NOTE: I get it now, but I think it's confusing and not needed."
NSQ_SOURCE_LINE 00000072 "# Will change it on a branch later, for review."
NSQ_SOURCE_LINE 00000073 "#"
NSQ_SOURCE_LINE 00000074 "# XXX-XDG I don't support changing it yet.  It's a very well-documented"
NSQ_SOURCE_LINE 00000075 "# \"API\" of YAML::Tiny.  I'd support deprecating it, but Adam suggested"
NSQ_SOURCE_LINE 00000076 "# we not change it until YAML.pm's own OO API is established so that"
NSQ_SOURCE_LINE 00000077 "# users only have one API change to digest, not two"
NSQ_SOURCE_LINE 00000078 "sub new {"
NSQ_SOURCE_LINE 00000079 "    my $class = shift;"
NSQ_SOURCE_LINE 00000080 "    bless [ @_ ], $class;"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "# XXX-INGY It probably doesn't matter, and it's probably too late to"
NSQ_SOURCE_LINE 00000084 "# change, but 'read/write' are the wrong names. Read and Write"
NSQ_SOURCE_LINE 00000085 "# are actions that take data from storage to memory"
NSQ_SOURCE_LINE 00000086 "# characters/strings. These take the data to/from storage to native"
NSQ_SOURCE_LINE 00000087 "# Perl objects, which the terms dump and load are meant. As long as"
NSQ_SOURCE_LINE 00000088 "# this is a legacy quirk to YAML::Tiny it's ok, but I'd prefer not"
NSQ_SOURCE_LINE 00000089 "# to add new {read,write}_* methods to this API."
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "sub read_string {"
NSQ_SOURCE_LINE 00000092 "    my $self = shift;"
NSQ_SOURCE_LINE 00000093 "    $self->_load_string(@_);"
NSQ_SOURCE_LINE 00000094 "}"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "sub write_string {"
NSQ_SOURCE_LINE 00000097 "    my $self = shift;"
NSQ_SOURCE_LINE 00000098 "    $self->_dump_string(@_);"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "sub read {"
NSQ_SOURCE_LINE 00000102 "    my $self = shift;"
NSQ_SOURCE_LINE 00000103 "    $self->_load_file(@_);"
NSQ_SOURCE_LINE 00000104 "}"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "sub write {"
NSQ_SOURCE_LINE 00000107 "    my $self = shift;"
NSQ_SOURCE_LINE 00000108 "    $self->_dump_file(@_);"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "#####################################################################"
NSQ_SOURCE_LINE 00000115 "# Constants"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "# Printed form of the unprintable characters in the lowest range"
NSQ_SOURCE_LINE 00000118 "# of ASCII characters, listed by ASCII ordinal position."
NSQ_SOURCE_LINE 00000119 "my @UNPRINTABLE = qw("
NSQ_SOURCE_LINE 00000120 "    0    x01  x02  x03  x04  x05  x06  a"
NSQ_SOURCE_LINE 00000121 "    b    t    n    v    f    r    x0E  x0F"
NSQ_SOURCE_LINE 00000122 "    x10  x11  x12  x13  x14  x15  x16  x17"
NSQ_SOURCE_LINE 00000123 "    x18  x19  x1A  e    x1C  x1D  x1E  x1F"
NSQ_SOURCE_LINE 00000124 ");"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "# Printable characters for escapes"
NSQ_SOURCE_LINE 00000127 "my %UNESCAPES = ("
NSQ_SOURCE_LINE 00000128 "    0 => \"\\x00\", z => \"\\x00\", N    => \"\\x85\","
NSQ_SOURCE_LINE 00000129 "    a => \"\\x07\", b => \"\\x08\", t    => \"\\x09\","
NSQ_SOURCE_LINE 00000130 "    n => \"\\x0a\", v => \"\\x0b\", f    => \"\\x0c\","
NSQ_SOURCE_LINE 00000131 "    r => \"\\x0d\", e => \"\\x1b\", '\\\\' => '\\\\',"
NSQ_SOURCE_LINE 00000132 ");"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "# XXX-INGY"
NSQ_SOURCE_LINE 00000135 "# I(ngy) need to decide if these values should be quoted in"
NSQ_SOURCE_LINE 00000136 "# YAML::Tiny or not. Probably yes."
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "# These 3 values have special meaning when unquoted and using the"
NSQ_SOURCE_LINE 00000139 "# default YAML schema. They need quotes if they are strings."
NSQ_SOURCE_LINE 00000140 "my %QUOTE = map { $_ => 1 } qw{"
NSQ_SOURCE_LINE 00000141 "    null true false"
NSQ_SOURCE_LINE 00000142 "};"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "# The commented out form is simpler, but overloaded the Perl regex"
NSQ_SOURCE_LINE 00000145 "# engine due to recursion and backtracking problems on strings"
NSQ_SOURCE_LINE 00000146 "# larger than 32,000ish characters. Keep it for reference purposes."
NSQ_SOURCE_LINE 00000147 "# qr/\\\"((?:\\\\.|[^\\\"])*)\\\"/"
NSQ_SOURCE_LINE 00000148 "my $re_capture_double_quoted = qr/\\\"([^\\\\\"]*(?:\\\\.[^\\\\\"]*)*)\\\"/;"
NSQ_SOURCE_LINE 00000149 "my $re_capture_single_quoted = qr/\\'([^\\']*(?:\\'\\'[^\\']*)*)\\'/;"
NSQ_SOURCE_LINE 00000150 "# unquoted re gets trailing space that needs to be stripped"
NSQ_SOURCE_LINE 00000151 "my $re_capture_unquoted_key  = qr/([^:]+(?::+\\S(?:[^:]*|.*?(?=:)))*)(?=\\s*\\:(?:\\s+|$))/;"
NSQ_SOURCE_LINE 00000152 "my $re_trailing_comment      = qr/(?:\\s+\\#.*)?/;"
NSQ_SOURCE_LINE 00000153 "my $re_key_value_separator   = qr/\\s*:(?:\\s+(?:\\#.*)?|$)/;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "#####################################################################"
NSQ_SOURCE_LINE 00000160 "# YAML::Tiny Implementation."
NSQ_SOURCE_LINE 00000161 "#"
NSQ_SOURCE_LINE 00000162 "# These are the private methods that do all the work. They may change"
NSQ_SOURCE_LINE 00000163 "# at any time."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "###"
NSQ_SOURCE_LINE 00000167 "# Loader functions:"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "# Create an object from a file"
NSQ_SOURCE_LINE 00000170 "sub _load_file {"
NSQ_SOURCE_LINE 00000171 "    my $class = ref $_[0] ? ref shift : shift;"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    # Check the file"
NSQ_SOURCE_LINE 00000174 "    my $file = shift or $class->_error( 'You did not specify a file name' );"
NSQ_SOURCE_LINE 00000175 "    $class->_error( \"File '$file' does not exist\" )"
NSQ_SOURCE_LINE 00000176 "        unless -e $file;"
NSQ_SOURCE_LINE 00000177 "    $class->_error( \"'$file' is a directory, not a file\" )"
NSQ_SOURCE_LINE 00000178 "        unless -f _;"
NSQ_SOURCE_LINE 00000179 "    $class->_error( \"Insufficient permissions to read '$file'\" )"
NSQ_SOURCE_LINE 00000180 "        unless -r _;"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    # Open unbuffered with strict UTF-8 decoding and no translation layers"
NSQ_SOURCE_LINE 00000183 "    open( my $fh, \"<:unix:encoding(UTF-8)\", $file );"
NSQ_SOURCE_LINE 00000184 "    unless ( $fh ) {"
NSQ_SOURCE_LINE 00000185 "        $class->_error(\"Failed to open file '$file': $!\");"
NSQ_SOURCE_LINE 00000186 "    }"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "    # flock if available (or warn if not possible for OS-specific reasons)"
NSQ_SOURCE_LINE 00000189 "    if ( _can_flock() ) {"
NSQ_SOURCE_LINE 00000190 "        flock( $fh, Fcntl::LOCK_SH() )"
NSQ_SOURCE_LINE 00000191 "            or warn \"Couldn't lock '$file' for reading: $!\";"
NSQ_SOURCE_LINE 00000192 "    }"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    # slurp the contents"
NSQ_SOURCE_LINE 00000195 "    my $contents = eval {"
NSQ_SOURCE_LINE 00000196 "        use warnings FATAL => 'utf8';"
NSQ_SOURCE_LINE 00000197 "        local $/;"
NSQ_SOURCE_LINE 00000198 "        <$fh>"
NSQ_SOURCE_LINE 00000199 "    };"
NSQ_SOURCE_LINE 00000200 "    if ( my $err = $@ ) {"
NSQ_SOURCE_LINE 00000201 "        $class->_error(\"Error reading from file '$file': $err\");"
NSQ_SOURCE_LINE 00000202 "    }"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "    # close the file (release the lock)"
NSQ_SOURCE_LINE 00000205 "    unless ( close $fh ) {"
NSQ_SOURCE_LINE 00000206 "        $class->_error(\"Failed to close file '$file': $!\");"
NSQ_SOURCE_LINE 00000207 "    }"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "    $class->_load_string( $contents );"
NSQ_SOURCE_LINE 00000210 "}"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "# Create an object from a string"
NSQ_SOURCE_LINE 00000213 "sub _load_string {"
NSQ_SOURCE_LINE 00000214 "    my $class  = ref $_[0] ? ref shift : shift;"
NSQ_SOURCE_LINE 00000215 "    my $self   = bless [], $class;"
NSQ_SOURCE_LINE 00000216 "    my $string = $_[0];"
NSQ_SOURCE_LINE 00000217 "    eval {"
NSQ_SOURCE_LINE 00000218 "        unless ( defined $string ) {"
NSQ_SOURCE_LINE 00000219 "            die \\\"Did not provide a string to load\";"
NSQ_SOURCE_LINE 00000220 "        }"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "        # Check if Perl has it marked as characters, but it's internally"
NSQ_SOURCE_LINE 00000223 "        # inconsistent.  E.g. maybe latin1 got read on a :utf8 layer"
NSQ_SOURCE_LINE 00000224 "        if ( utf8::is_utf8($string) && ! utf8::valid($string) ) {"
NSQ_SOURCE_LINE 00000225 "            die \\<<'...';"
NSQ_SOURCE_LINE 00000226 "Read an invalid UTF-8 string (maybe mixed UTF-8 and 8-bit character set)."
NSQ_SOURCE_LINE 00000227 "Did you decode with lax \":utf8\" instead of strict \":encoding(UTF-8)\"?"
NSQ_SOURCE_LINE 00000228 "..."
NSQ_SOURCE_LINE 00000229 "        }"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "        # Ensure Unicode character semantics, even for 0x80-0xff"
NSQ_SOURCE_LINE 00000232 "        utf8::upgrade($string);"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "        # Check for and strip any leading UTF-8 BOM"
NSQ_SOURCE_LINE 00000235 "        $string =~ s/^\\x{FEFF}//;"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "        # Check for some special cases"
NSQ_SOURCE_LINE 00000238 "        return $self unless length $string;"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "        # Split the file into lines"
NSQ_SOURCE_LINE 00000241 "        my @lines = grep { ! /^\\s*(?:\\#.*)?\\z/ }"
NSQ_SOURCE_LINE 00000242 "                split /(?:\\015{1,2}\\012|\\015|\\012)/, $string;"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "        # Strip the initial YAML header"
NSQ_SOURCE_LINE 00000245 "        @lines and $lines[0] =~ /^\\%YAML[: ][\\d\\.]+.*\\z/ and shift @lines;"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "        # A nibbling parser"
NSQ_SOURCE_LINE 00000248 "        my $in_document = 0;"
NSQ_SOURCE_LINE 00000249 "        while ( @lines ) {"
NSQ_SOURCE_LINE 00000250 "            # Do we have a document header?"
NSQ_SOURCE_LINE 00000251 "            if ( $lines[0] =~ /^---\\s*(?:(.+)\\s*)?\\z/ ) {"
NSQ_SOURCE_LINE 00000252 "                # Handle scalar documents"
NSQ_SOURCE_LINE 00000253 "                shift @lines;"
NSQ_SOURCE_LINE 00000254 "                if ( defined $1 and $1 !~ /^(?:\\#.+|\\%YAML[: ][\\d\\.]+)\\z/ ) {"
NSQ_SOURCE_LINE 00000255 "                    push @$self,"
NSQ_SOURCE_LINE 00000256 "                        $self->_load_scalar( \"$1\", [ undef ], \\@lines );"
NSQ_SOURCE_LINE 00000257 "                    next;"
NSQ_SOURCE_LINE 00000258 "                }"
NSQ_SOURCE_LINE 00000259 "                $in_document = 1;"
NSQ_SOURCE_LINE 00000260 "            }"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "            if ( ! @lines or $lines[0] =~ /^(?:---|\\.\\.\\.)/ ) {"
NSQ_SOURCE_LINE 00000263 "                # A naked document"
NSQ_SOURCE_LINE 00000264 "                push @$self, undef;"
NSQ_SOURCE_LINE 00000265 "                while ( @lines and $lines[0] !~ /^---/ ) {"
NSQ_SOURCE_LINE 00000266 "                    shift @lines;"
NSQ_SOURCE_LINE 00000267 "                }"
NSQ_SOURCE_LINE 00000268 "                $in_document = 0;"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "            # XXX The final '-+$' is to look for -- which ends up being an"
NSQ_SOURCE_LINE 00000271 "            # error later."
NSQ_SOURCE_LINE 00000272 "            } elsif ( ! $in_document && @$self ) {"
NSQ_SOURCE_LINE 00000273 "                # only the first document can be explicit"
NSQ_SOURCE_LINE 00000274 "                die \\\"YAML::Tiny failed to classify the line '$lines[0]'\";"
NSQ_SOURCE_LINE 00000275 "            } elsif ( $lines[0] =~ /^\\s*\\-(?:\\s|$|-+$)/ ) {"
NSQ_SOURCE_LINE 00000276 "                # An array at the root"
NSQ_SOURCE_LINE 00000277 "                my $document = [ ];"
NSQ_SOURCE_LINE 00000278 "                push @$self, $document;"
NSQ_SOURCE_LINE 00000279 "                $self->_load_array( $document, [ 0 ], \\@lines );"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "            } elsif ( $lines[0] =~ /^(\\s*)\\S/ ) {"
NSQ_SOURCE_LINE 00000282 "                # A hash at the root"
NSQ_SOURCE_LINE 00000283 "                my $document = { };"
NSQ_SOURCE_LINE 00000284 "                push @$self, $document;"
NSQ_SOURCE_LINE 00000285 "                $self->_load_hash( $document, [ length($1) ], \\@lines );"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "            } else {"
NSQ_SOURCE_LINE 00000288 "                # Shouldn't get here.  @lines have whitespace-only lines"
NSQ_SOURCE_LINE 00000289 "                # stripped, and previous match is a line with any"
NSQ_SOURCE_LINE 00000290 "                # non-whitespace.  So this clause should only be reachable via"
NSQ_SOURCE_LINE 00000291 "                # a perlbug where \\s is not symmetric with \\S"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "                # uncoverable statement"
NSQ_SOURCE_LINE 00000294 "                die \\\"YAML::Tiny failed to classify the line '$lines[0]'\";"
NSQ_SOURCE_LINE 00000295 "            }"
NSQ_SOURCE_LINE 00000296 "        }"
NSQ_SOURCE_LINE 00000297 "    };"
NSQ_SOURCE_LINE 00000298 "    my $err = $@;"
NSQ_SOURCE_LINE 00000299 "    if ( ref $err eq 'SCALAR' ) {"
NSQ_SOURCE_LINE 00000300 "        $self->_error(${$err});"
NSQ_SOURCE_LINE 00000301 "    } elsif ( $err ) {"
NSQ_SOURCE_LINE 00000302 "        $self->_error($err);"
NSQ_SOURCE_LINE 00000303 "    }"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "    return $self;"
NSQ_SOURCE_LINE 00000306 "}"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "sub _unquote_single {"
NSQ_SOURCE_LINE 00000309 "    my ($self, $string) = @_;"
NSQ_SOURCE_LINE 00000310 "    return '' unless length $string;"
NSQ_SOURCE_LINE 00000311 "    $string =~ s/\\'\\'/\\'/g;"
NSQ_SOURCE_LINE 00000312 "    return $string;"
NSQ_SOURCE_LINE 00000313 "}"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "sub _unquote_double {"
NSQ_SOURCE_LINE 00000316 "    my ($self, $string) = @_;"
NSQ_SOURCE_LINE 00000317 "    return '' unless length $string;"
NSQ_SOURCE_LINE 00000318 "    $string =~ s/\\\\\"/\"/g;"
NSQ_SOURCE_LINE 00000319 "    $string =~"
NSQ_SOURCE_LINE 00000320 "        s{\\\\([Nnever\\\\fartz0b]|x([0-9a-fA-F]{2}))}"
NSQ_SOURCE_LINE 00000321 "         {(length($1)>1)?pack(\"H2\",$2):$UNESCAPES{$1}}gex;"
NSQ_SOURCE_LINE 00000322 "    return $string;"
NSQ_SOURCE_LINE 00000323 "}"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "# Load a YAML scalar string to the actual Perl scalar"
NSQ_SOURCE_LINE 00000326 "sub _load_scalar {"
NSQ_SOURCE_LINE 00000327 "    my ($self, $string, $indent, $lines) = @_;"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "    # Trim trailing whitespace"
NSQ_SOURCE_LINE 00000330 "    $string =~ s/\\s*\\z//;"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "    # Explitic null/undef"
NSQ_SOURCE_LINE 00000333 "    return undef if $string eq '~';"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "    # Single quote"
NSQ_SOURCE_LINE 00000336 "    if ( $string =~ /^$re_capture_single_quoted$re_trailing_comment\\z/ ) {"
NSQ_SOURCE_LINE 00000337 "        return $self->_unquote_single($1);"
NSQ_SOURCE_LINE 00000338 "    }"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "    # Double quote."
NSQ_SOURCE_LINE 00000341 "    if ( $string =~ /^$re_capture_double_quoted$re_trailing_comment\\z/ ) {"
NSQ_SOURCE_LINE 00000342 "        return $self->_unquote_double($1);"
NSQ_SOURCE_LINE 00000343 "    }"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "    # Special cases"
NSQ_SOURCE_LINE 00000346 "    if ( $string =~ /^[\\'\\\"!&]/ ) {"
NSQ_SOURCE_LINE 00000347 "        die \\\"YAML::Tiny does not support a feature in line '$string'\";"
NSQ_SOURCE_LINE 00000348 "    }"
NSQ_SOURCE_LINE 00000349 "    return {} if $string =~ /^{}(?:\\s+\\#.*)?\\z/;"
NSQ_SOURCE_LINE 00000350 "    return [] if $string =~ /^\\[\\](?:\\s+\\#.*)?\\z/;"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "    # Regular unquoted string"
NSQ_SOURCE_LINE 00000353 "    if ( $string !~ /^[>|]/ ) {"
NSQ_SOURCE_LINE 00000354 "        die \\\"YAML::Tiny found illegal characters in plain scalar: '$string'\""
NSQ_SOURCE_LINE 00000355 "            if $string =~ /^(?:-(?:\\s|$)|[\\@\\%\\`])/ or"
NSQ_SOURCE_LINE 00000356 "                $string =~ /:(?:\\s|$)/;"
NSQ_SOURCE_LINE 00000357 "        $string =~ s/\\s+#.*\\z//;"
NSQ_SOURCE_LINE 00000358 "        return $string;"
NSQ_SOURCE_LINE 00000359 "    }"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "    # Error"
NSQ_SOURCE_LINE 00000362 "    die \\\"YAML::Tiny failed to find multi-line scalar content\" unless @$lines;"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "    # Check the indent depth"
NSQ_SOURCE_LINE 00000365 "    $lines->[0]   =~ /^(\\s*)/;"
NSQ_SOURCE_LINE 00000366 "    $indent->[-1] = length(\"$1\");"
NSQ_SOURCE_LINE 00000367 "    if ( defined $indent->[-2] and $indent->[-1] <= $indent->[-2] ) {"
NSQ_SOURCE_LINE 00000368 "        die \\\"YAML::Tiny found bad indenting in line '$lines->[0]'\";"
NSQ_SOURCE_LINE 00000369 "    }"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "    # Pull the lines"
NSQ_SOURCE_LINE 00000372 "    my @multiline = ();"
NSQ_SOURCE_LINE 00000373 "    while ( @$lines ) {"
NSQ_SOURCE_LINE 00000374 "        $lines->[0] =~ /^(\\s*)/;"
NSQ_SOURCE_LINE 00000375 "        last unless length($1) >= $indent->[-1];"
NSQ_SOURCE_LINE 00000376 "        push @multiline, substr(shift(@$lines), $indent->[-1]);"
NSQ_SOURCE_LINE 00000377 "    }"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "    my $j = (substr($string, 0, 1) eq '>') ? ' ' : \"\\n\";"
NSQ_SOURCE_LINE 00000380 "    my $t = (substr($string, 1, 1) eq '-') ? ''  : \"\\n\";"
NSQ_SOURCE_LINE 00000381 "    return join( $j, @multiline ) . $t;"
NSQ_SOURCE_LINE 00000382 "}"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "# Load an array"
NSQ_SOURCE_LINE 00000385 "sub _load_array {"
NSQ_SOURCE_LINE 00000386 "    my ($self, $array, $indent, $lines) = @_;"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "    while ( @$lines ) {"
NSQ_SOURCE_LINE 00000389 "        # Check for a new document"
NSQ_SOURCE_LINE 00000390 "        if ( $lines->[0] =~ /^(?:---|\\.\\.\\.)/ ) {"
NSQ_SOURCE_LINE 00000391 "            while ( @$lines and $lines->[0] !~ /^---/ ) {"
NSQ_SOURCE_LINE 00000392 "                shift @$lines;"
NSQ_SOURCE_LINE 00000393 "            }"
NSQ_SOURCE_LINE 00000394 "            return 1;"
NSQ_SOURCE_LINE 00000395 "        }"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "        # Check the indent level"
NSQ_SOURCE_LINE 00000398 "        $lines->[0] =~ /^(\\s*)/;"
NSQ_SOURCE_LINE 00000399 "        if ( length($1) < $indent->[-1] ) {"
NSQ_SOURCE_LINE 00000400 "            return 1;"
NSQ_SOURCE_LINE 00000401 "        } elsif ( length($1) > $indent->[-1] ) {"
NSQ_SOURCE_LINE 00000402 "            die \\\"YAML::Tiny found bad indenting in line '$lines->[0]'\";"
NSQ_SOURCE_LINE 00000403 "        }"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "        if ( $lines->[0] =~ /^(\\s*\\-\\s+)[^\\'\\\"]\\S*\\s*:(?:\\s+|$)/ ) {"
NSQ_SOURCE_LINE 00000406 "            # Inline nested hash"
NSQ_SOURCE_LINE 00000407 "            my $indent2 = length(\"$1\");"
NSQ_SOURCE_LINE 00000408 "            $lines->[0] =~ s/-/ /;"
NSQ_SOURCE_LINE 00000409 "            push @$array, { };"
NSQ_SOURCE_LINE 00000410 "            $self->_load_hash( $array->[-1], [ @$indent, $indent2 ], $lines );"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "        } elsif ( $lines->[0] =~ /^\\s*\\-\\s*\\z/ ) {"
NSQ_SOURCE_LINE 00000413 "            shift @$lines;"
NSQ_SOURCE_LINE 00000414 "            unless ( @$lines ) {"
NSQ_SOURCE_LINE 00000415 "                push @$array, undef;"
NSQ_SOURCE_LINE 00000416 "                return 1;"
NSQ_SOURCE_LINE 00000417 "            }"
NSQ_SOURCE_LINE 00000418 "            if ( $lines->[0] =~ /^(\\s*)\\-/ ) {"
NSQ_SOURCE_LINE 00000419 "                my $indent2 = length(\"$1\");"
NSQ_SOURCE_LINE 00000420 "                if ( $indent->[-1] == $indent2 ) {"
NSQ_SOURCE_LINE 00000421 "                    # Null array entry"
NSQ_SOURCE_LINE 00000422 "                    push @$array, undef;"
NSQ_SOURCE_LINE 00000423 "                } else {"
NSQ_SOURCE_LINE 00000424 "                    # Naked indenter"
NSQ_SOURCE_LINE 00000425 "                    push @$array, [ ];"
NSQ_SOURCE_LINE 00000426 "                    $self->_load_array("
NSQ_SOURCE_LINE 00000427 "                        $array->[-1], [ @$indent, $indent2 ], $lines"
NSQ_SOURCE_LINE 00000428 "                    );"
NSQ_SOURCE_LINE 00000429 "                }"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "            } elsif ( $lines->[0] =~ /^(\\s*)\\S/ ) {"
NSQ_SOURCE_LINE 00000432 "                push @$array, { };"
NSQ_SOURCE_LINE 00000433 "                $self->_load_hash("
NSQ_SOURCE_LINE 00000434 "                    $array->[-1], [ @$indent, length(\"$1\") ], $lines"
NSQ_SOURCE_LINE 00000435 "                );"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "            } else {"
NSQ_SOURCE_LINE 00000438 "                die \\\"YAML::Tiny failed to classify line '$lines->[0]'\";"
NSQ_SOURCE_LINE 00000439 "            }"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "        } elsif ( $lines->[0] =~ /^\\s*\\-(\\s*)(.+?)\\s*\\z/ ) {"
NSQ_SOURCE_LINE 00000442 "            # Array entry with a value"
NSQ_SOURCE_LINE 00000443 "            shift @$lines;"
NSQ_SOURCE_LINE 00000444 "            push @$array, $self->_load_scalar("
NSQ_SOURCE_LINE 00000445 "                \"$2\", [ @$indent, undef ], $lines"
NSQ_SOURCE_LINE 00000446 "            );"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "        } elsif ( defined $indent->[-2] and $indent->[-1] == $indent->[-2] ) {"
NSQ_SOURCE_LINE 00000449 "            # This is probably a structure like the following..."
NSQ_SOURCE_LINE 00000450 "            # ---"
NSQ_SOURCE_LINE 00000451 "            # foo:"
NSQ_SOURCE_LINE 00000452 "            # - list"
NSQ_SOURCE_LINE 00000453 "            # bar: value"
NSQ_SOURCE_LINE 00000454 "            #"
NSQ_SOURCE_LINE 00000455 "            # ... so lets return and let the hash parser handle it"
NSQ_SOURCE_LINE 00000456 "            return 1;"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "        } else {"
NSQ_SOURCE_LINE 00000459 "            die \\\"YAML::Tiny failed to classify line '$lines->[0]'\";"
NSQ_SOURCE_LINE 00000460 "        }"
NSQ_SOURCE_LINE 00000461 "    }"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "    return 1;"
NSQ_SOURCE_LINE 00000464 "}"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "# Load a hash"
NSQ_SOURCE_LINE 00000467 "sub _load_hash {"
NSQ_SOURCE_LINE 00000468 "    my ($self, $hash, $indent, $lines) = @_;"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "    while ( @$lines ) {"
NSQ_SOURCE_LINE 00000471 "        # Check for a new document"
NSQ_SOURCE_LINE 00000472 "        if ( $lines->[0] =~ /^(?:---|\\.\\.\\.)/ ) {"
NSQ_SOURCE_LINE 00000473 "            while ( @$lines and $lines->[0] !~ /^---/ ) {"
NSQ_SOURCE_LINE 00000474 "                shift @$lines;"
NSQ_SOURCE_LINE 00000475 "            }"
NSQ_SOURCE_LINE 00000476 "            return 1;"
NSQ_SOURCE_LINE 00000477 "        }"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "        # Check the indent level"
NSQ_SOURCE_LINE 00000480 "        $lines->[0] =~ /^(\\s*)/;"
NSQ_SOURCE_LINE 00000481 "        if ( length($1) < $indent->[-1] ) {"
NSQ_SOURCE_LINE 00000482 "            return 1;"
NSQ_SOURCE_LINE 00000483 "        } elsif ( length($1) > $indent->[-1] ) {"
NSQ_SOURCE_LINE 00000484 "            die \\\"YAML::Tiny found bad indenting in line '$lines->[0]'\";"
NSQ_SOURCE_LINE 00000485 "        }"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "        # Find the key"
NSQ_SOURCE_LINE 00000488 "        my $key;"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "        # Quoted keys"
NSQ_SOURCE_LINE 00000491 "        if ( $lines->[0] =~"
NSQ_SOURCE_LINE 00000492 "            s/^\\s*$re_capture_single_quoted$re_key_value_separator//"
NSQ_SOURCE_LINE 00000493 "        ) {"
NSQ_SOURCE_LINE 00000494 "            $key = $self->_unquote_single($1);"
NSQ_SOURCE_LINE 00000495 "        }"
NSQ_SOURCE_LINE 00000496 "        elsif ( $lines->[0] =~"
NSQ_SOURCE_LINE 00000497 "            s/^\\s*$re_capture_double_quoted$re_key_value_separator//"
NSQ_SOURCE_LINE 00000498 "        ) {"
NSQ_SOURCE_LINE 00000499 "            $key = $self->_unquote_double($1);"
NSQ_SOURCE_LINE 00000500 "        }"
NSQ_SOURCE_LINE 00000501 "        elsif ( $lines->[0] =~"
NSQ_SOURCE_LINE 00000502 "            s/^\\s*$re_capture_unquoted_key$re_key_value_separator//"
NSQ_SOURCE_LINE 00000503 "        ) {"
NSQ_SOURCE_LINE 00000504 "            $key = $1;"
NSQ_SOURCE_LINE 00000505 "            $key =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00000506 "        }"
NSQ_SOURCE_LINE 00000507 "        elsif ( $lines->[0] =~ /^\\s*\\?/ ) {"
NSQ_SOURCE_LINE 00000508 "            die \\\"YAML::Tiny does not support a feature in line '$lines->[0]'\";"
NSQ_SOURCE_LINE 00000509 "        }"
NSQ_SOURCE_LINE 00000510 "        else {"
NSQ_SOURCE_LINE 00000511 "            die \\\"YAML::Tiny failed to classify line '$lines->[0]'\";"
NSQ_SOURCE_LINE 00000512 "        }"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "        if ( exists $hash->{$key} ) {"
NSQ_SOURCE_LINE 00000515 "            warn \"YAML::Tiny found a duplicate key '$key' in line '$lines->[0]'\";"
NSQ_SOURCE_LINE 00000516 "        }"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "        # Do we have a value?"
NSQ_SOURCE_LINE 00000519 "        if ( length $lines->[0] ) {"
NSQ_SOURCE_LINE 00000520 "            # Yes"
NSQ_SOURCE_LINE 00000521 "            $hash->{$key} = $self->_load_scalar("
NSQ_SOURCE_LINE 00000522 "                shift(@$lines), [ @$indent, undef ], $lines"
NSQ_SOURCE_LINE 00000523 "            );"
NSQ_SOURCE_LINE 00000524 "        } else {"
NSQ_SOURCE_LINE 00000525 "            # An indent"
NSQ_SOURCE_LINE 00000526 "            shift @$lines;"
NSQ_SOURCE_LINE 00000527 "            unless ( @$lines ) {"
NSQ_SOURCE_LINE 00000528 "                $hash->{$key} = undef;"
NSQ_SOURCE_LINE 00000529 "                return 1;"
NSQ_SOURCE_LINE 00000530 "            }"
NSQ_SOURCE_LINE 00000531 "            if ( $lines->[0] =~ /^(\\s*)-/ ) {"
NSQ_SOURCE_LINE 00000532 "                $hash->{$key} = [];"
NSQ_SOURCE_LINE 00000533 "                $self->_load_array("
NSQ_SOURCE_LINE 00000534 "                    $hash->{$key}, [ @$indent, length($1) ], $lines"
NSQ_SOURCE_LINE 00000535 "                );"
NSQ_SOURCE_LINE 00000536 "            } elsif ( $lines->[0] =~ /^(\\s*)./ ) {"
NSQ_SOURCE_LINE 00000537 "                my $indent2 = length(\"$1\");"
NSQ_SOURCE_LINE 00000538 "                if ( $indent->[-1] >= $indent2 ) {"
NSQ_SOURCE_LINE 00000539 "                    # Null hash entry"
NSQ_SOURCE_LINE 00000540 "                    $hash->{$key} = undef;"
NSQ_SOURCE_LINE 00000541 "                } else {"
NSQ_SOURCE_LINE 00000542 "                    $hash->{$key} = {};"
NSQ_SOURCE_LINE 00000543 "                    $self->_load_hash("
NSQ_SOURCE_LINE 00000544 "                        $hash->{$key}, [ @$indent, length($1) ], $lines"
NSQ_SOURCE_LINE 00000545 "                    );"
NSQ_SOURCE_LINE 00000546 "                }"
NSQ_SOURCE_LINE 00000547 "            }"
NSQ_SOURCE_LINE 00000548 "        }"
NSQ_SOURCE_LINE 00000549 "    }"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "    return 1;"
NSQ_SOURCE_LINE 00000552 "}"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "###"
NSQ_SOURCE_LINE 00000556 "# Dumper functions:"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "# Save an object to a file"
NSQ_SOURCE_LINE 00000559 "sub _dump_file {"
NSQ_SOURCE_LINE 00000560 "    my $self = shift;"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "    require Fcntl;"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "    # Check the file"
NSQ_SOURCE_LINE 00000565 "    my $file = shift or $self->_error( 'You did not specify a file name' );"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "    my $fh;"
NSQ_SOURCE_LINE 00000568 "    # flock if available (or warn if not possible for OS-specific reasons)"
NSQ_SOURCE_LINE 00000569 "    if ( _can_flock() ) {"
NSQ_SOURCE_LINE 00000570 "        # Open without truncation (truncate comes after lock)"
NSQ_SOURCE_LINE 00000571 "        my $flags = Fcntl::O_WRONLY()|Fcntl::O_CREAT();"
NSQ_SOURCE_LINE 00000572 "        sysopen( $fh, $file, $flags )"
NSQ_SOURCE_LINE 00000573 "            or $self->_error(\"Failed to open file '$file' for writing: $!\");"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "        # Use no translation and strict UTF-8"
NSQ_SOURCE_LINE 00000576 "        binmode( $fh, \":raw:encoding(UTF-8)\");"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "        flock( $fh, Fcntl::LOCK_EX() )"
NSQ_SOURCE_LINE 00000579 "            or warn \"Couldn't lock '$file' for reading: $!\";"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "        # truncate and spew contents"
NSQ_SOURCE_LINE 00000582 "        truncate $fh, 0;"
NSQ_SOURCE_LINE 00000583 "        seek $fh, 0, 0;"
NSQ_SOURCE_LINE 00000584 "    }"
NSQ_SOURCE_LINE 00000585 "    else {"
NSQ_SOURCE_LINE 00000586 "        open $fh, \">:unix:encoding(UTF-8)\", $file;"
NSQ_SOURCE_LINE 00000587 "    }"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "    # serialize and spew to the handle"
NSQ_SOURCE_LINE 00000590 "    print {$fh} $self->_dump_string;"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "    # close the file (release the lock)"
NSQ_SOURCE_LINE 00000593 "    unless ( close $fh ) {"
NSQ_SOURCE_LINE 00000594 "        $self->_error(\"Failed to close file '$file': $!\");"
NSQ_SOURCE_LINE 00000595 "    }"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "    return 1;"
NSQ_SOURCE_LINE 00000598 "}"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "# Save an object to a string"
NSQ_SOURCE_LINE 00000601 "sub _dump_string {"
NSQ_SOURCE_LINE 00000602 "    my $self = shift;"
NSQ_SOURCE_LINE 00000603 "    return '' unless ref $self && @$self;"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "    # Iterate over the documents"
NSQ_SOURCE_LINE 00000606 "    my $indent = 0;"
NSQ_SOURCE_LINE 00000607 "    my @lines  = ();"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "    eval {"
NSQ_SOURCE_LINE 00000610 "        foreach my $cursor ( @$self ) {"
NSQ_SOURCE_LINE 00000611 "            push @lines, '---';"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "            # An empty document"
NSQ_SOURCE_LINE 00000614 "            if ( ! defined $cursor ) {"
NSQ_SOURCE_LINE 00000615 "                # Do nothing"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "            # A scalar document"
NSQ_SOURCE_LINE 00000618 "            } elsif ( ! ref $cursor ) {"
NSQ_SOURCE_LINE 00000619 "                $lines[-1] .= ' ' . $self->_dump_scalar( $cursor );"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "            # A list at the root"
NSQ_SOURCE_LINE 00000622 "            } elsif ( ref $cursor eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000623 "                unless ( @$cursor ) {"
NSQ_SOURCE_LINE 00000624 "                    $lines[-1] .= ' []';"
NSQ_SOURCE_LINE 00000625 "                    next;"
NSQ_SOURCE_LINE 00000626 "                }"
NSQ_SOURCE_LINE 00000627 "                push @lines, $self->_dump_array( $cursor, $indent, {} );"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "            # A hash at the root"
NSQ_SOURCE_LINE 00000630 "            } elsif ( ref $cursor eq 'HASH' ) {"
NSQ_SOURCE_LINE 00000631 "                unless ( %$cursor ) {"
NSQ_SOURCE_LINE 00000632 "                    $lines[-1] .= ' {}';"
NSQ_SOURCE_LINE 00000633 "                    next;"
NSQ_SOURCE_LINE 00000634 "                }"
NSQ_SOURCE_LINE 00000635 "                push @lines, $self->_dump_hash( $cursor, $indent, {} );"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "            } else {"
NSQ_SOURCE_LINE 00000638 "                die \\(\"Cannot serialize \" . ref($cursor));"
NSQ_SOURCE_LINE 00000639 "            }"
NSQ_SOURCE_LINE 00000640 "        }"
NSQ_SOURCE_LINE 00000641 "    };"
NSQ_SOURCE_LINE 00000642 "    if ( ref $@ eq 'SCALAR' ) {"
NSQ_SOURCE_LINE 00000643 "        $self->_error(${$@});"
NSQ_SOURCE_LINE 00000644 "    } elsif ( $@ ) {"
NSQ_SOURCE_LINE 00000645 "        $self->_error($@);"
NSQ_SOURCE_LINE 00000646 "    }"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "    join '', map { \"$_\\n\" } @lines;"
NSQ_SOURCE_LINE 00000649 "}"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "sub _has_internal_string_value {"
NSQ_SOURCE_LINE 00000652 "    my $value = shift;"
NSQ_SOURCE_LINE 00000653 "    my $b_obj = B::svref_2object(\\$value);  # for round trip problem"
NSQ_SOURCE_LINE 00000654 "    return $b_obj->FLAGS & B::SVf_POK();"
NSQ_SOURCE_LINE 00000655 "}"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "sub _dump_scalar {"
NSQ_SOURCE_LINE 00000658 "    my $string = $_[1];"
NSQ_SOURCE_LINE 00000659 "    my $is_key = $_[2];"
NSQ_SOURCE_LINE 00000660 "    # Check this before checking length or it winds up looking like a string!"
NSQ_SOURCE_LINE 00000661 "    my $has_string_flag = _has_internal_string_value($string);"
NSQ_SOURCE_LINE 00000662 "    return '~'  unless defined $string;"
NSQ_SOURCE_LINE 00000663 "    return \"''\" unless length  $string;"
NSQ_SOURCE_LINE 00000664 "    if (Scalar::Util::looks_like_number($string)) {"
NSQ_SOURCE_LINE 00000665 "        # keys and values that have been used as strings get quoted"
NSQ_SOURCE_LINE 00000666 "        if ( $is_key || $has_string_flag ) {"
NSQ_SOURCE_LINE 00000667 "            return qq['$string'];"
NSQ_SOURCE_LINE 00000668 "        }"
NSQ_SOURCE_LINE 00000669 "        else {"
NSQ_SOURCE_LINE 00000670 "            return $string;"
NSQ_SOURCE_LINE 00000671 "        }"
NSQ_SOURCE_LINE 00000672 "    }"
NSQ_SOURCE_LINE 00000673 "    if ( $string =~ /[\\x00-\\x09\\x0b-\\x0d\\x0e-\\x1f\\x7f-\\x9f\\'\\n]/ ) {"
NSQ_SOURCE_LINE 00000674 "        $string =~ s/\\\\/\\\\\\\\/g;"
NSQ_SOURCE_LINE 00000675 "        $string =~ s/\"/\\\\\"/g;"
NSQ_SOURCE_LINE 00000676 "        $string =~ s/\\n/\\\\n/g;"
NSQ_SOURCE_LINE 00000677 "        $string =~ s/[\\x85]/\\\\N/g;"
NSQ_SOURCE_LINE 00000678 "        $string =~ s/([\\x00-\\x1f])/\\\\$UNPRINTABLE[ord($1)]/g;"
NSQ_SOURCE_LINE 00000679 "        $string =~ s/([\\x7f-\\x9f])/'\\x' . sprintf(\"%X\",ord($1))/ge;"
NSQ_SOURCE_LINE 00000680 "        return qq|\"$string\"|;"
NSQ_SOURCE_LINE 00000681 "    }"
NSQ_SOURCE_LINE 00000682 "    if ( $string =~ /(?:^[~!@#%&*|>?:,'\"`{}\\[\\]]|^-+$|\\s|:\\z)/ or"
NSQ_SOURCE_LINE 00000683 "        $QUOTE{$string}"
NSQ_SOURCE_LINE 00000684 "    ) {"
NSQ_SOURCE_LINE 00000685 "        return \"'$string'\";"
NSQ_SOURCE_LINE 00000686 "    }"
NSQ_SOURCE_LINE 00000687 "    return $string;"
NSQ_SOURCE_LINE 00000688 "}"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "sub _dump_array {"
NSQ_SOURCE_LINE 00000691 "    my ($self, $array, $indent, $seen) = @_;"
NSQ_SOURCE_LINE 00000692 "    if ( $seen->{refaddr($array)}++ ) {"
NSQ_SOURCE_LINE 00000693 "        die \\\"YAML::Tiny does not support circular references\";"
NSQ_SOURCE_LINE 00000694 "    }"
NSQ_SOURCE_LINE 00000695 "    my @lines  = ();"
NSQ_SOURCE_LINE 00000696 "    foreach my $el ( @$array ) {"
NSQ_SOURCE_LINE 00000697 "        my $line = ('  ' x $indent) . '-';"
NSQ_SOURCE_LINE 00000698 "        my $type = ref $el;"
NSQ_SOURCE_LINE 00000699 "        if ( ! $type ) {"
NSQ_SOURCE_LINE 00000700 "            $line .= ' ' . $self->_dump_scalar( $el );"
NSQ_SOURCE_LINE 00000701 "            push @lines, $line;"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "        } elsif ( $type eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000704 "            if ( @$el ) {"
NSQ_SOURCE_LINE 00000705 "                push @lines, $line;"
NSQ_SOURCE_LINE 00000706 "                push @lines, $self->_dump_array( $el, $indent + 1, $seen );"
NSQ_SOURCE_LINE 00000707 "            } else {"
NSQ_SOURCE_LINE 00000708 "                $line .= ' []';"
NSQ_SOURCE_LINE 00000709 "                push @lines, $line;"
NSQ_SOURCE_LINE 00000710 "            }"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "        } elsif ( $type eq 'HASH' ) {"
NSQ_SOURCE_LINE 00000713 "            if ( keys %$el ) {"
NSQ_SOURCE_LINE 00000714 "                push @lines, $line;"
NSQ_SOURCE_LINE 00000715 "                push @lines, $self->_dump_hash( $el, $indent + 1, $seen );"
NSQ_SOURCE_LINE 00000716 "            } else {"
NSQ_SOURCE_LINE 00000717 "                $line .= ' {}';"
NSQ_SOURCE_LINE 00000718 "                push @lines, $line;"
NSQ_SOURCE_LINE 00000719 "            }"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "        } else {"
NSQ_SOURCE_LINE 00000722 "            die \\\"YAML::Tiny does not support $type references\";"
NSQ_SOURCE_LINE 00000723 "        }"
NSQ_SOURCE_LINE 00000724 "    }"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "    @lines;"
NSQ_SOURCE_LINE 00000727 "}"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "sub _dump_hash {"
NSQ_SOURCE_LINE 00000730 "    my ($self, $hash, $indent, $seen) = @_;"
NSQ_SOURCE_LINE 00000731 "    if ( $seen->{refaddr($hash)}++ ) {"
NSQ_SOURCE_LINE 00000732 "        die \\\"YAML::Tiny does not support circular references\";"
NSQ_SOURCE_LINE 00000733 "    }"
NSQ_SOURCE_LINE 00000734 "    my @lines  = ();"
NSQ_SOURCE_LINE 00000735 "    foreach my $name ( sort keys %$hash ) {"
NSQ_SOURCE_LINE 00000736 "        my $el   = $hash->{$name};"
NSQ_SOURCE_LINE 00000737 "        my $line = ('  ' x $indent) . $self->_dump_scalar($name, 1) . \":\";"
NSQ_SOURCE_LINE 00000738 "        my $type = ref $el;"
NSQ_SOURCE_LINE 00000739 "        if ( ! $type ) {"
NSQ_SOURCE_LINE 00000740 "            $line .= ' ' . $self->_dump_scalar( $el );"
NSQ_SOURCE_LINE 00000741 "            push @lines, $line;"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "        } elsif ( $type eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000744 "            if ( @$el ) {"
NSQ_SOURCE_LINE 00000745 "                push @lines, $line;"
NSQ_SOURCE_LINE 00000746 "                push @lines, $self->_dump_array( $el, $indent + 1, $seen );"
NSQ_SOURCE_LINE 00000747 "            } else {"
NSQ_SOURCE_LINE 00000748 "                $line .= ' []';"
NSQ_SOURCE_LINE 00000749 "                push @lines, $line;"
NSQ_SOURCE_LINE 00000750 "            }"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "        } elsif ( $type eq 'HASH' ) {"
NSQ_SOURCE_LINE 00000753 "            if ( keys %$el ) {"
NSQ_SOURCE_LINE 00000754 "                push @lines, $line;"
NSQ_SOURCE_LINE 00000755 "                push @lines, $self->_dump_hash( $el, $indent + 1, $seen );"
NSQ_SOURCE_LINE 00000756 "            } else {"
NSQ_SOURCE_LINE 00000757 "                $line .= ' {}';"
NSQ_SOURCE_LINE 00000758 "                push @lines, $line;"
NSQ_SOURCE_LINE 00000759 "            }"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "        } else {"
NSQ_SOURCE_LINE 00000762 "            die \\\"YAML::Tiny does not support $type references\";"
NSQ_SOURCE_LINE 00000763 "        }"
NSQ_SOURCE_LINE 00000764 "    }"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "    @lines;"
NSQ_SOURCE_LINE 00000767 "}"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "#####################################################################"
NSQ_SOURCE_LINE 00000772 "# DEPRECATED API methods:"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "# Error storage (DEPRECATED as of 1.57)"
NSQ_SOURCE_LINE 00000775 "our $errstr    = '';"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "# Set error"
NSQ_SOURCE_LINE 00000778 "sub _error {"
NSQ_SOURCE_LINE 00000779 "    require Carp;"
NSQ_SOURCE_LINE 00000780 "    $errstr = $_[1];"
NSQ_SOURCE_LINE 00000781 "    $errstr =~ s/ at \\S+ line \\d+.*//;"
NSQ_SOURCE_LINE 00000782 "    Carp::croak( $errstr );"
NSQ_SOURCE_LINE 00000783 "}"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "# Retrieve error"
NSQ_SOURCE_LINE 00000786 "my $errstr_warned;"
NSQ_SOURCE_LINE 00000787 "sub errstr {"
NSQ_SOURCE_LINE 00000788 "    require Carp;"
NSQ_SOURCE_LINE 00000789 "    Carp::carp( \"YAML::Tiny->errstr and \\$YAML::Tiny::errstr is deprecated\" )"
NSQ_SOURCE_LINE 00000790 "        unless $errstr_warned++;"
NSQ_SOURCE_LINE 00000791 "    $errstr;"
NSQ_SOURCE_LINE 00000792 "}"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "#####################################################################"
NSQ_SOURCE_LINE 00000798 "# Helper functions. Possibly not needed."
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "# Use to detect nv or iv"
NSQ_SOURCE_LINE 00000802 "use B;"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "# XXX-INGY Is flock YAML::Tiny's responsibility?"
NSQ_SOURCE_LINE 00000805 "# Some platforms can't flock :-("
NSQ_SOURCE_LINE 00000806 "# XXX-XDG I think it is.  When reading and writing files, we ought"
NSQ_SOURCE_LINE 00000807 "# to be locking whenever possible.  People (foolishly) use YAML"
NSQ_SOURCE_LINE 00000808 "# files for things like session storage, which has race issues."
NSQ_SOURCE_LINE 00000809 "my $HAS_FLOCK;"
NSQ_SOURCE_LINE 00000810 "sub _can_flock {"
NSQ_SOURCE_LINE 00000811 "    if ( defined $HAS_FLOCK ) {"
NSQ_SOURCE_LINE 00000812 "        return $HAS_FLOCK;"
NSQ_SOURCE_LINE 00000813 "    }"
NSQ_SOURCE_LINE 00000814 "    else {"
NSQ_SOURCE_LINE 00000815 "        require Config;"
NSQ_SOURCE_LINE 00000816 "        my $c = \\%Config::Config;"
NSQ_SOURCE_LINE 00000817 "        $HAS_FLOCK = grep { $c->{$_} } qw/d_flock d_fcntl_can_lock d_lockf/;"
NSQ_SOURCE_LINE 00000818 "        require Fcntl if $HAS_FLOCK;"
NSQ_SOURCE_LINE 00000819 "        return $HAS_FLOCK;"
NSQ_SOURCE_LINE 00000820 "    }"
NSQ_SOURCE_LINE 00000821 "}"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "# XXX-INGY Is this core in 5.8.1? Can we remove this?"
NSQ_SOURCE_LINE 00000825 "# XXX-XDG Scalar::Util 1.18 didn't land until 5.8.8, so we need this"
NSQ_SOURCE_LINE 00000826 "#####################################################################"
NSQ_SOURCE_LINE 00000827 "# Use Scalar::Util if possible, otherwise emulate it"
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "use Scalar::Util ();"
NSQ_SOURCE_LINE 00000830 "BEGIN {"
NSQ_SOURCE_LINE 00000831 "    local $@;"
NSQ_SOURCE_LINE 00000832 "    if ( eval { Scalar::Util->VERSION(1.18); } ) {"
NSQ_SOURCE_LINE 00000833 "        *refaddr = *Scalar::Util::refaddr;"
NSQ_SOURCE_LINE 00000834 "    }"
NSQ_SOURCE_LINE 00000835 "    else {"
NSQ_SOURCE_LINE 00000836 "        eval <<'END_PERL';"
NSQ_SOURCE_LINE 00000837 "# Scalar::Util failed to load or too old"
NSQ_SOURCE_LINE 00000838 "sub refaddr {"
NSQ_SOURCE_LINE 00000839 "    my $pkg = ref($_[0]) or return undef;"
NSQ_SOURCE_LINE 00000840 "    if ( !! UNIVERSAL::can($_[0], 'can') ) {"
NSQ_SOURCE_LINE 00000841 "        bless $_[0], 'Scalar::Util::Fake';"
NSQ_SOURCE_LINE 00000842 "    } else {"
NSQ_SOURCE_LINE 00000843 "        $pkg = undef;"
NSQ_SOURCE_LINE 00000844 "    }"
NSQ_SOURCE_LINE 00000845 "    \"$_[0]\" =~ /0x(\\w+)/;"
NSQ_SOURCE_LINE 00000846 "    my $i = do { no warnings 'portable'; hex $1 };"
NSQ_SOURCE_LINE 00000847 "    bless $_[0], $pkg if defined $pkg;"
NSQ_SOURCE_LINE 00000848 "    $i;"
NSQ_SOURCE_LINE 00000849 "}"
NSQ_SOURCE_LINE 00000850 "END_PERL"
NSQ_SOURCE_LINE 00000851 "    }"
NSQ_SOURCE_LINE 00000852 "}"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "delete $YAML::Tiny::{refaddr};"
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "1;"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "# XXX-INGY Doc notes I'm putting up here. Changing the doc when it's wrong"
NSQ_SOURCE_LINE 00000859 "# but leaving grey area stuff up here."
NSQ_SOURCE_LINE 00000860 "#"
NSQ_SOURCE_LINE 00000861 "# I would like to change Read/Write to Load/Dump below without"
NSQ_SOURCE_LINE 00000862 "# changing the actual API names."
NSQ_SOURCE_LINE 00000863 "#"
NSQ_SOURCE_LINE 00000864 "# It might be better to put Load/Dump API in the SYNOPSIS instead of the"
NSQ_SOURCE_LINE 00000865 "# dubious OO API."
NSQ_SOURCE_LINE 00000866 "#"
NSQ_SOURCE_LINE 00000867 "# null and bool explanations may be outdated."
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "__END__"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "=pod"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "=head1 NAME"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "YAML::Tiny - Read/Write YAML files with as little code as possible"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "=head1 VERSION"
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 "version 1.76"
NSQ_SOURCE_LINE 00000880 ""
NSQ_SOURCE_LINE 00000881 "=head1 PREAMBLE"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "The YAML specification is huge. Really, B<really> huge. It contains all the"
NSQ_SOURCE_LINE 00000884 "functionality of XML, except with flexibility and choice, which makes it"
NSQ_SOURCE_LINE 00000885 "easier to read, but with a formal specification that is more complex than"
NSQ_SOURCE_LINE 00000886 "XML."
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "The original pure-Perl implementation L<YAML> costs just over 4 megabytes"
NSQ_SOURCE_LINE 00000889 "of memory to load. Just like with Windows F<.ini> files (3 meg to load) and"
NSQ_SOURCE_LINE 00000890 "CSS (3.5 meg to load) the situation is just asking for a B<YAML::Tiny>"
NSQ_SOURCE_LINE 00000891 "module, an incomplete but correct and usable subset of the functionality,"
NSQ_SOURCE_LINE 00000892 "in as little code as possible."
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "Like the other C<::Tiny> modules, YAML::Tiny has no non-core dependencies,"
NSQ_SOURCE_LINE 00000895 "does not require a compiler to install, is back-compatible to Perl v5.8.1,"
NSQ_SOURCE_LINE 00000896 "and can be inlined into other modules if needed."
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "In exchange for adding this extreme flexibility, it provides support"
NSQ_SOURCE_LINE 00000899 "for only a limited subset of YAML. But the subset supported contains most"
NSQ_SOURCE_LINE 00000900 "of the features for the more common uses of YAML."
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "Assuming F<file.yml> like this:"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "    ---"
NSQ_SOURCE_LINE 00000907 "    rootproperty: blah"
NSQ_SOURCE_LINE 00000908 "    section:"
NSQ_SOURCE_LINE 00000909 "      one: two"
NSQ_SOURCE_LINE 00000910 "      three: four"
NSQ_SOURCE_LINE 00000911 "      Foo: Bar"
NSQ_SOURCE_LINE 00000912 "      empty: ~"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 ""
NSQ_SOURCE_LINE 00000915 "Read and write F<file.yml> like this:"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "    use YAML::Tiny;"
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "    # Open the config"
NSQ_SOURCE_LINE 00000920 "    my $yaml = YAML::Tiny->read( 'file.yml' );"
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "    # Get a reference to the first document"
NSQ_SOURCE_LINE 00000923 "    my $config = $yaml->[0];"
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "    # Or read properties directly"
NSQ_SOURCE_LINE 00000926 "    my $root = $yaml->[0]->{rootproperty};"
NSQ_SOURCE_LINE 00000927 "    my $one  = $yaml->[0]->{section}->{one};"
NSQ_SOURCE_LINE 00000928 "    my $Foo  = $yaml->[0]->{section}->{Foo};"
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "    # Change data directly"
NSQ_SOURCE_LINE 00000931 "    $yaml->[0]->{newsection} = { this => 'that' }; # Add a section"
NSQ_SOURCE_LINE 00000932 "    $yaml->[0]->{section}->{Foo} = 'Not Bar!';     # Change a value"
NSQ_SOURCE_LINE 00000933 "    delete $yaml->[0]->{section};                  # Delete a value"
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "    # Save the document back to the file"
NSQ_SOURCE_LINE 00000936 "    $yaml->write( 'file.yml' );"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "To create a new YAML file from scratch:"
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "    # Create a new object with a single hashref document"
NSQ_SOURCE_LINE 00000941 "    my $yaml = YAML::Tiny->new( { wibble => \"wobble\" } );"
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "    # Add an arrayref document"
NSQ_SOURCE_LINE 00000944 "    push @$yaml, [ 'foo', 'bar', 'baz' ];"
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "    # Save both documents to a file"
NSQ_SOURCE_LINE 00000947 "    $yaml->write( 'data.yml' );"
NSQ_SOURCE_LINE 00000948 ""
NSQ_SOURCE_LINE 00000949 "Then F<data.yml> will contain:"
NSQ_SOURCE_LINE 00000950 ""
NSQ_SOURCE_LINE 00000951 "    ---"
NSQ_SOURCE_LINE 00000952 "    wibble: wobble"
NSQ_SOURCE_LINE 00000953 "    ---"
NSQ_SOURCE_LINE 00000954 "    - foo"
NSQ_SOURCE_LINE 00000955 "    - bar"
NSQ_SOURCE_LINE 00000956 "    - baz"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "B<YAML::Tiny> is a perl class for reading and writing YAML-style files,"
NSQ_SOURCE_LINE 00000961 "written with as little code as possible, reducing load time and memory"
NSQ_SOURCE_LINE 00000962 "overhead."
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "Most of the time it is accepted that Perl applications use a lot"
NSQ_SOURCE_LINE 00000965 "of memory and modules. The B<::Tiny> family of modules is specifically"
NSQ_SOURCE_LINE 00000966 "intended to provide an ultralight and zero-dependency alternative to"
NSQ_SOURCE_LINE 00000967 "many more-thorough standard modules."
NSQ_SOURCE_LINE 00000968 ""
NSQ_SOURCE_LINE 00000969 "This module is primarily for reading human-written files (like simple"
NSQ_SOURCE_LINE 00000970 "config files) and generating very simple human-readable files. Note that"
NSQ_SOURCE_LINE 00000971 "I said B<human-readable> and not B<geek-readable>. The sort of files that"
NSQ_SOURCE_LINE 00000972 "your average manager or secretary should be able to look at and make"
NSQ_SOURCE_LINE 00000973 "sense of."
NSQ_SOURCE_LINE 00000974 ""
NSQ_SOURCE_LINE 00000975 "=for stopwords normalise"
NSQ_SOURCE_LINE 00000976 ""
NSQ_SOURCE_LINE 00000977 "L<YAML::Tiny> does not generate comments, it won't necessarily preserve the"
NSQ_SOURCE_LINE 00000978 "order of your hashes, and it will normalise if reading in and writing out"
NSQ_SOURCE_LINE 00000979 "again."
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "It only supports a very basic subset of the full YAML specification."
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 "=for stopwords embeddable"
NSQ_SOURCE_LINE 00000984 ""
NSQ_SOURCE_LINE 00000985 "Usage is targeted at files like Perl's META.yml, for which a small and"
NSQ_SOURCE_LINE 00000986 "easily-embeddable module is extremely attractive."
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 "Features will only be added if they are human readable, and can be written"
NSQ_SOURCE_LINE 00000989 "in a few lines of code. Please don't be offended if your request is"
NSQ_SOURCE_LINE 00000990 "refused. Someone has to draw the line, and for YAML::Tiny that someone"
NSQ_SOURCE_LINE 00000991 "is me."
NSQ_SOURCE_LINE 00000992 ""
NSQ_SOURCE_LINE 00000993 "If you need something with more power move up to L<YAML> (7 megabytes of"
NSQ_SOURCE_LINE 00000994 "memory overhead) or L<YAML::XS> (6 megabytes memory overhead and requires"
NSQ_SOURCE_LINE 00000995 "a C compiler)."
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "To restate, L<YAML::Tiny> does B<not> preserve your comments, whitespace,"
NSQ_SOURCE_LINE 00000998 "or the order of your YAML data. But it should round-trip from Perl"
NSQ_SOURCE_LINE 00000999 "structure to file and back again just fine."
NSQ_SOURCE_LINE 00001000 ""
NSQ_SOURCE_LINE 00001001 "=head1 METHODS"
NSQ_SOURCE_LINE 00001002 ""
NSQ_SOURCE_LINE 00001003 "=for Pod::Coverage HAVE_UTF8 refaddr"
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "=head2 new"
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "The constructor C<new> creates a C<YAML::Tiny> object as a blessed array"
NSQ_SOURCE_LINE 00001008 "reference.  Any arguments provided are taken as separate documents"
NSQ_SOURCE_LINE 00001009 "to be serialized."
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "=head2 read $filename"
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "The C<read> constructor reads a YAML file from a file name,"
NSQ_SOURCE_LINE 00001014 "and returns a new C<YAML::Tiny> object containing the parsed content."
NSQ_SOURCE_LINE 00001015 ""
NSQ_SOURCE_LINE 00001016 "Returns the object on success or throws an error on failure."
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "=head2 read_string $string;"
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "The C<read_string> constructor reads YAML data from a character string, and"
NSQ_SOURCE_LINE 00001021 "returns a new C<YAML::Tiny> object containing the parsed content.  If you have"
NSQ_SOURCE_LINE 00001022 "read the string from a file yourself, be sure that you have correctly decoded"
NSQ_SOURCE_LINE 00001023 "it into characters first."
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "Returns the object on success or throws an error on failure."
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "=head2 write $filename"
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "The C<write> method generates the file content for the properties, and"
NSQ_SOURCE_LINE 00001030 "writes it to disk using UTF-8 encoding to the filename specified."
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "Returns true on success or throws an error on failure."
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "=head2 write_string"
NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "Generates the file content for the object and returns it as a character"
NSQ_SOURCE_LINE 00001037 "string.  This may contain non-ASCII characters and should be encoded"
NSQ_SOURCE_LINE 00001038 "before writing it to a file."
NSQ_SOURCE_LINE 00001039 ""
NSQ_SOURCE_LINE 00001040 "Returns true on success or throws an error on failure."
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "=for stopwords errstr"
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 "=head2 errstr (DEPRECATED)"
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "Prior to version 1.57, some errors were fatal and others were available only"
NSQ_SOURCE_LINE 00001047 "via the C<$YAML::Tiny::errstr> variable, which could be accessed via the"
NSQ_SOURCE_LINE 00001048 "C<errstr()> method."
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "Starting with version 1.57, all errors are fatal and throw exceptions."
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "The C<$errstr> variable is still set when exceptions are thrown, but"
NSQ_SOURCE_LINE 00001053 "C<$errstr> and the C<errstr()> method are deprecated and may be removed in a"
NSQ_SOURCE_LINE 00001054 "future release.  The first use of C<errstr()> will issue a deprecation"
NSQ_SOURCE_LINE 00001055 "warning."
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "YAML::Tiny implements a number of functions to add compatibility with"
NSQ_SOURCE_LINE 00001060 "the L<YAML> API. These should be a drop-in replacement."
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "=head2 Dump"
NSQ_SOURCE_LINE 00001063 ""
NSQ_SOURCE_LINE 00001064 "  my $string = Dump(list-of-Perl-data-structures);"
NSQ_SOURCE_LINE 00001065 ""
NSQ_SOURCE_LINE 00001066 "Turn Perl data into YAML. This function works very much like"
NSQ_SOURCE_LINE 00001067 "Data::Dumper::Dumper()."
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "It takes a list of Perl data structures and dumps them into a serialized"
NSQ_SOURCE_LINE 00001070 "form."
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "It returns a character string containing the YAML stream.  Be sure to encode"
NSQ_SOURCE_LINE 00001073 "it as UTF-8 before serializing to a file or socket."
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "The structures can be references or plain scalars."
NSQ_SOURCE_LINE 00001076 ""
NSQ_SOURCE_LINE 00001077 "Dies on any error."
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "=head2 Load"
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "  my @data_structures = Load(string-containing-a-YAML-stream);"
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "Turn YAML into Perl data. This is the opposite of Dump."
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "Just like L<Storable>'s thaw() function or the eval() function in relation"
NSQ_SOURCE_LINE 00001086 "to L<Data::Dumper>."
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "It parses a character string containing a valid YAML stream into a list of"
NSQ_SOURCE_LINE 00001089 "Perl data structures representing the individual YAML documents.  Be sure to"
NSQ_SOURCE_LINE 00001090 "decode the character string  correctly if the string came from a file or"
NSQ_SOURCE_LINE 00001091 "socket."
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "  my $last_data_structure = Load(string-containing-a-YAML-stream);"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "For consistency with YAML.pm, when Load is called in scalar context, it"
NSQ_SOURCE_LINE 00001096 "returns the data structure corresponding to the last of the YAML documents"
NSQ_SOURCE_LINE 00001097 "found in the input stream."
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "Dies on any error."
NSQ_SOURCE_LINE 00001100 ""
NSQ_SOURCE_LINE 00001101 "=head2 freeze() and thaw()"
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 "Aliases to Dump() and Load() for L<Storable> fans. This will also allow"
NSQ_SOURCE_LINE 00001104 "YAML::Tiny to be plugged directly into modules like POE.pm, that use the"
NSQ_SOURCE_LINE 00001105 "freeze/thaw API for internal serialization."
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 "=head2 DumpFile(filepath, list)"
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "Writes the YAML stream to a file with UTF-8 encoding instead of just"
NSQ_SOURCE_LINE 00001110 "returning a string."
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 "Dies on any error."
NSQ_SOURCE_LINE 00001113 ""
NSQ_SOURCE_LINE 00001114 "=head2 LoadFile(filepath)"
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "Reads the YAML stream from a UTF-8 encoded file instead of a string."
NSQ_SOURCE_LINE 00001117 ""
NSQ_SOURCE_LINE 00001118 "Dies on any error."
NSQ_SOURCE_LINE 00001119 ""
NSQ_SOURCE_LINE 00001120 "=head1 YAML TINY SPECIFICATION"
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "This section of the documentation provides a specification for \"YAML Tiny\","
NSQ_SOURCE_LINE 00001123 "a subset of the YAML specification."
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "It is based on and described comparatively to the YAML 1.1 Working Draft"
NSQ_SOURCE_LINE 00001126 "2004-12-28 specification, located at L<http://yaml.org/spec/current.html>."
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "Terminology and chapter numbers are based on that specification."
NSQ_SOURCE_LINE 00001129 ""
NSQ_SOURCE_LINE 00001130 "=head2 1. Introduction and Goals"
NSQ_SOURCE_LINE 00001131 ""
NSQ_SOURCE_LINE 00001132 "The purpose of the YAML Tiny specification is to describe a useful subset"
NSQ_SOURCE_LINE 00001133 "of the YAML specification that can be used for typical document-oriented"
NSQ_SOURCE_LINE 00001134 "use cases such as configuration files and simple data structure dumps."
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 "=for stopwords extensibility"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "Many specification elements that add flexibility or extensibility are"
NSQ_SOURCE_LINE 00001139 "intentionally removed, as is support for complex data structures, class"
NSQ_SOURCE_LINE 00001140 "and object-orientation."
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "In general, the YAML Tiny language targets only those data structures"
NSQ_SOURCE_LINE 00001143 "available in JSON, with the additional limitation that only simple keys"
NSQ_SOURCE_LINE 00001144 "are supported."
NSQ_SOURCE_LINE 00001145 ""
NSQ_SOURCE_LINE 00001146 "As a result, all possible YAML Tiny documents should be able to be"
NSQ_SOURCE_LINE 00001147 "transformed into an equivalent JSON document, although the reverse is"
NSQ_SOURCE_LINE 00001148 "not necessarily true (but will be true in simple cases)."
NSQ_SOURCE_LINE 00001149 ""
NSQ_SOURCE_LINE 00001150 "=for stopwords PCRE"
NSQ_SOURCE_LINE 00001151 ""
NSQ_SOURCE_LINE 00001152 "As a result of these simplifications the YAML Tiny specification should"
NSQ_SOURCE_LINE 00001153 "be implementable in a (relatively) small amount of code in any language"
NSQ_SOURCE_LINE 00001154 "that supports Perl Compatible Regular Expressions (PCRE)."
NSQ_SOURCE_LINE 00001155 ""
NSQ_SOURCE_LINE 00001156 "=head2 2. Introduction"
NSQ_SOURCE_LINE 00001157 ""
NSQ_SOURCE_LINE 00001158 "YAML Tiny supports three data structures. These are scalars (in a variety"
NSQ_SOURCE_LINE 00001159 "of forms), block-form sequences and block-form mappings. Flow-style"
NSQ_SOURCE_LINE 00001160 "sequences and mappings are not supported, with some minor exceptions"
NSQ_SOURCE_LINE 00001161 "detailed later."
NSQ_SOURCE_LINE 00001162 ""
NSQ_SOURCE_LINE 00001163 "The use of three dashes \"---\" to indicate the start of a new document is"
NSQ_SOURCE_LINE 00001164 "supported, and multiple documents per file/stream is allowed."
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 "Both line and inline comments are supported."
NSQ_SOURCE_LINE 00001167 ""
NSQ_SOURCE_LINE 00001168 "Scalars are supported via the plain style, single quote and double quote,"
NSQ_SOURCE_LINE 00001169 "as well as literal-style and folded-style multi-line scalars."
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 "The use of explicit tags is not supported."
NSQ_SOURCE_LINE 00001172 ""
NSQ_SOURCE_LINE 00001173 "The use of \"null\" type scalars is supported via the ~ character."
NSQ_SOURCE_LINE 00001174 ""
NSQ_SOURCE_LINE 00001175 "The use of \"bool\" type scalars is not supported."
NSQ_SOURCE_LINE 00001176 ""
NSQ_SOURCE_LINE 00001177 "=for stopwords serializer"
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "However, serializer implementations should take care to explicitly escape"
NSQ_SOURCE_LINE 00001180 "strings that match a \"bool\" keyword in the following set to prevent other"
NSQ_SOURCE_LINE 00001181 "implementations that do support \"bool\" accidentally reading a string as a"
NSQ_SOURCE_LINE 00001182 "boolean"
NSQ_SOURCE_LINE 00001183 ""
NSQ_SOURCE_LINE 00001184 "  y|Y|yes|Yes|YES|n|N|no|No|NO"
NSQ_SOURCE_LINE 00001185 "  |true|True|TRUE|false|False|FALSE"
NSQ_SOURCE_LINE 00001186 "  |on|On|ON|off|Off|OFF"
NSQ_SOURCE_LINE 00001187 ""
NSQ_SOURCE_LINE 00001188 "The use of anchors and aliases is not supported."
NSQ_SOURCE_LINE 00001189 ""
NSQ_SOURCE_LINE 00001190 "The use of directives is supported only for the %YAML directive."
NSQ_SOURCE_LINE 00001191 ""
NSQ_SOURCE_LINE 00001192 "=head2 3. Processing YAML Tiny Information"
NSQ_SOURCE_LINE 00001193 ""
NSQ_SOURCE_LINE 00001194 "B<Processes>"
NSQ_SOURCE_LINE 00001195 ""
NSQ_SOURCE_LINE 00001196 "=for stopwords deserialization"
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "The YAML specification dictates three-phase serialization and three-phase"
NSQ_SOURCE_LINE 00001199 "deserialization."
NSQ_SOURCE_LINE 00001200 ""
NSQ_SOURCE_LINE 00001201 "The YAML Tiny specification does not mandate any particular methodology"
NSQ_SOURCE_LINE 00001202 "or mechanism for parsing."
NSQ_SOURCE_LINE 00001203 ""
NSQ_SOURCE_LINE 00001204 "Any compliant parser is only required to parse a single document at a"
NSQ_SOURCE_LINE 00001205 "time. The ability to support streaming documents is optional and most"
NSQ_SOURCE_LINE 00001206 "likely non-typical."
NSQ_SOURCE_LINE 00001207 ""
NSQ_SOURCE_LINE 00001208 "=for stopwords acyclic"
NSQ_SOURCE_LINE 00001209 ""
NSQ_SOURCE_LINE 00001210 "Because anchors and aliases are not supported, the resulting representation"
NSQ_SOURCE_LINE 00001211 "graph is thus directed but (unlike the main YAML specification) B<acyclic>."
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 "Circular references/pointers are not possible, and any YAML Tiny serializer"
NSQ_SOURCE_LINE 00001214 "detecting a circular reference should error with an appropriate message."
NSQ_SOURCE_LINE 00001215 ""
NSQ_SOURCE_LINE 00001216 "B<Presentation Stream>"
NSQ_SOURCE_LINE 00001217 ""
NSQ_SOURCE_LINE 00001218 "=for stopwords unicode"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "YAML Tiny reads and write UTF-8 encoded files.  Operations on strings expect"
NSQ_SOURCE_LINE 00001221 "or produce Unicode characters not UTF-8 encoded bytes."
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 "B<Loading Failure Points>"
NSQ_SOURCE_LINE 00001224 ""
NSQ_SOURCE_LINE 00001225 "=for stopwords modality"
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "=for stopwords parsers"
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 "YAML Tiny parsers and emitters are not expected to recover from, or"
NSQ_SOURCE_LINE 00001230 "adapt to, errors. The specific error modality of any implementation is"
NSQ_SOURCE_LINE 00001231 "not dictated (return codes, exceptions, etc.) but is expected to be"
NSQ_SOURCE_LINE 00001232 "consistent."
NSQ_SOURCE_LINE 00001233 ""
NSQ_SOURCE_LINE 00001234 "=head2 4. Syntax"
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 "B<Character Set>"
NSQ_SOURCE_LINE 00001237 ""
NSQ_SOURCE_LINE 00001238 "YAML Tiny streams are processed in memory as Unicode characters and"
NSQ_SOURCE_LINE 00001239 "read/written with UTF-8 encoding."
NSQ_SOURCE_LINE 00001240 ""
NSQ_SOURCE_LINE 00001241 "The escaping and unescaping of the 8-bit YAML escapes is required."
NSQ_SOURCE_LINE 00001242 ""
NSQ_SOURCE_LINE 00001243 "The escaping and unescaping of 16-bit and 32-bit YAML escapes is not"
NSQ_SOURCE_LINE 00001244 "required."
NSQ_SOURCE_LINE 00001245 ""
NSQ_SOURCE_LINE 00001246 "B<Indicator Characters>"
NSQ_SOURCE_LINE 00001247 ""
NSQ_SOURCE_LINE 00001248 "Support for the \"~\" null/undefined indicator is required."
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "Implementations may represent this as appropriate for the underlying"
NSQ_SOURCE_LINE 00001251 "language."
NSQ_SOURCE_LINE 00001252 ""
NSQ_SOURCE_LINE 00001253 "Support for the \"-\" block sequence indicator is required."
NSQ_SOURCE_LINE 00001254 ""
NSQ_SOURCE_LINE 00001255 "Support for the \"?\" mapping key indicator is B<not> required."
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "Support for the \":\" mapping value indicator is required."
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "Support for the \",\" flow collection indicator is B<not> required."
NSQ_SOURCE_LINE 00001260 ""
NSQ_SOURCE_LINE 00001261 "Support for the \"[\" flow sequence indicator is B<not> required, with"
NSQ_SOURCE_LINE 00001262 "one exception (detailed below)."
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "Support for the \"]\" flow sequence indicator is B<not> required, with"
NSQ_SOURCE_LINE 00001265 "one exception (detailed below)."
NSQ_SOURCE_LINE 00001266 ""
NSQ_SOURCE_LINE 00001267 "Support for the \"{\" flow mapping indicator is B<not> required, with"
NSQ_SOURCE_LINE 00001268 "one exception (detailed below)."
NSQ_SOURCE_LINE 00001269 ""
NSQ_SOURCE_LINE 00001270 "Support for the \"}\" flow mapping indicator is B<not> required, with"
NSQ_SOURCE_LINE 00001271 "one exception (detailed below)."
NSQ_SOURCE_LINE 00001272 ""
NSQ_SOURCE_LINE 00001273 "Support for the \"#\" comment indicator is required."
NSQ_SOURCE_LINE 00001274 ""
NSQ_SOURCE_LINE 00001275 "Support for the \"&\" anchor indicator is B<not> required."
NSQ_SOURCE_LINE 00001276 ""
NSQ_SOURCE_LINE 00001277 "Support for the \"*\" alias indicator is B<not> required."
NSQ_SOURCE_LINE 00001278 ""
NSQ_SOURCE_LINE 00001279 "Support for the \"!\" tag indicator is B<not> required."
NSQ_SOURCE_LINE 00001280 ""
NSQ_SOURCE_LINE 00001281 "Support for the \"|\" literal block indicator is required."
NSQ_SOURCE_LINE 00001282 ""
NSQ_SOURCE_LINE 00001283 "Support for the \">\" folded block indicator is required."
NSQ_SOURCE_LINE 00001284 ""
NSQ_SOURCE_LINE 00001285 "Support for the \"'\" single quote indicator is required."
NSQ_SOURCE_LINE 00001286 ""
NSQ_SOURCE_LINE 00001287 "Support for the \"\"\" double quote indicator is required."
NSQ_SOURCE_LINE 00001288 ""
NSQ_SOURCE_LINE 00001289 "Support for the \"%\" directive indicator is required, but only"
NSQ_SOURCE_LINE 00001290 "for the special case of a %YAML version directive before the"
NSQ_SOURCE_LINE 00001291 "\"---\" document header, or on the same line as the document header."
NSQ_SOURCE_LINE 00001292 ""
NSQ_SOURCE_LINE 00001293 "For example:"
NSQ_SOURCE_LINE 00001294 ""
NSQ_SOURCE_LINE 00001295 "  %YAML 1.1"
NSQ_SOURCE_LINE 00001296 "  ---"
NSQ_SOURCE_LINE 00001297 "  - A sequence with a single element"
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "Special Exception:"
NSQ_SOURCE_LINE 00001300 ""
NSQ_SOURCE_LINE 00001301 "To provide the ability to support empty sequences"
NSQ_SOURCE_LINE 00001302 "and mappings, support for the constructs [] (empty sequence) and {}"
NSQ_SOURCE_LINE 00001303 "(empty mapping) are required."
NSQ_SOURCE_LINE 00001304 ""
NSQ_SOURCE_LINE 00001305 "For example,"
NSQ_SOURCE_LINE 00001306 ""
NSQ_SOURCE_LINE 00001307 "  %YAML 1.1"
NSQ_SOURCE_LINE 00001308 "  # A document consisting of only an empty mapping"
NSQ_SOURCE_LINE 00001309 "  --- {}"
NSQ_SOURCE_LINE 00001310 "  # A document consisting of only an empty sequence"
NSQ_SOURCE_LINE 00001311 "  --- []"
NSQ_SOURCE_LINE 00001312 "  # A document consisting of an empty mapping within a sequence"
NSQ_SOURCE_LINE 00001313 "  - foo"
NSQ_SOURCE_LINE 00001314 "  - {}"
NSQ_SOURCE_LINE 00001315 "  - bar"
NSQ_SOURCE_LINE 00001316 ""
NSQ_SOURCE_LINE 00001317 "B<Syntax Primitives>"
NSQ_SOURCE_LINE 00001318 ""
NSQ_SOURCE_LINE 00001319 "Other than the empty sequence and mapping cases described above, YAML Tiny"
NSQ_SOURCE_LINE 00001320 "supports only the indentation-based block-style group of contexts."
NSQ_SOURCE_LINE 00001321 ""
NSQ_SOURCE_LINE 00001322 "All five scalar contexts are supported."
NSQ_SOURCE_LINE 00001323 ""
NSQ_SOURCE_LINE 00001324 "Indentation spaces work as per the YAML specification in all cases."
NSQ_SOURCE_LINE 00001325 ""
NSQ_SOURCE_LINE 00001326 "Comments work as per the YAML specification in all simple cases."
NSQ_SOURCE_LINE 00001327 "Support for indented multi-line comments is B<not> required."
NSQ_SOURCE_LINE 00001328 ""
NSQ_SOURCE_LINE 00001329 "Separation spaces work as per the YAML specification in all cases."
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 "B<YAML Tiny Character Stream>"
NSQ_SOURCE_LINE 00001332 ""
NSQ_SOURCE_LINE 00001333 "The only directive supported by the YAML Tiny specification is the"
NSQ_SOURCE_LINE 00001334 "%YAML language/version identifier. Although detected, this directive"
NSQ_SOURCE_LINE 00001335 "will have no control over the parsing itself."
NSQ_SOURCE_LINE 00001336 ""
NSQ_SOURCE_LINE 00001337 "=for stopwords recognise"
NSQ_SOURCE_LINE 00001338 ""
NSQ_SOURCE_LINE 00001339 "The parser must recognise both the YAML 1.0 and YAML 1.1+ formatting"
NSQ_SOURCE_LINE 00001340 "of this directive (as well as the commented form, although no explicit"
NSQ_SOURCE_LINE 00001341 "code should be needed to deal with this case, being a comment anyway)"
NSQ_SOURCE_LINE 00001342 ""
NSQ_SOURCE_LINE 00001343 "That is, all of the following should be supported."
NSQ_SOURCE_LINE 00001344 ""
NSQ_SOURCE_LINE 00001345 "  --- #YAML:1.0"
NSQ_SOURCE_LINE 00001346 "  - foo"
NSQ_SOURCE_LINE 00001347 ""
NSQ_SOURCE_LINE 00001348 "  %YAML:1.0"
NSQ_SOURCE_LINE 00001349 "  ---"
NSQ_SOURCE_LINE 00001350 "  - foo"
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "  % YAML 1.1"
NSQ_SOURCE_LINE 00001353 "  ---"
NSQ_SOURCE_LINE 00001354 "  - foo"
NSQ_SOURCE_LINE 00001355 ""
NSQ_SOURCE_LINE 00001356 "Support for the %TAG directive is B<not> required."
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 "Support for additional directives is B<not> required."
NSQ_SOURCE_LINE 00001359 ""
NSQ_SOURCE_LINE 00001360 "Support for the document boundary marker \"---\" is required."
NSQ_SOURCE_LINE 00001361 ""
NSQ_SOURCE_LINE 00001362 "Support for the document boundary market \"...\" is B<not> required."
NSQ_SOURCE_LINE 00001363 ""
NSQ_SOURCE_LINE 00001364 "If necessary, a document boundary should simply be indicated with a"
NSQ_SOURCE_LINE 00001365 "\"---\" marker, with no preceding \"...\" marker."
NSQ_SOURCE_LINE 00001366 ""
NSQ_SOURCE_LINE 00001367 "Support for empty streams (containing no documents) is required."
NSQ_SOURCE_LINE 00001368 ""
NSQ_SOURCE_LINE 00001369 "Support for implicit document starts is required."
NSQ_SOURCE_LINE 00001370 ""
NSQ_SOURCE_LINE 00001371 "That is, the following must be equivalent."
NSQ_SOURCE_LINE 00001372 ""
NSQ_SOURCE_LINE 00001373 " # Full form"
NSQ_SOURCE_LINE 00001374 " %YAML 1.1"
NSQ_SOURCE_LINE 00001375 " ---"
NSQ_SOURCE_LINE 00001376 " foo: bar"
NSQ_SOURCE_LINE 00001377 ""
NSQ_SOURCE_LINE 00001378 " # Implicit form"
NSQ_SOURCE_LINE 00001379 " foo: bar"
NSQ_SOURCE_LINE 00001380 ""
NSQ_SOURCE_LINE 00001381 "B<Nodes>"
NSQ_SOURCE_LINE 00001382 ""
NSQ_SOURCE_LINE 00001383 "Support for nodes optional anchor and tag properties is B<not> required."
NSQ_SOURCE_LINE 00001384 ""
NSQ_SOURCE_LINE 00001385 "Support for node anchors is B<not> required."
NSQ_SOURCE_LINE 00001386 ""
NSQ_SOURCE_LINE 00001387 "Support for node tags is B<not> required."
NSQ_SOURCE_LINE 00001388 ""
NSQ_SOURCE_LINE 00001389 "Support for alias nodes is B<not> required."
NSQ_SOURCE_LINE 00001390 ""
NSQ_SOURCE_LINE 00001391 "Support for flow nodes is B<not> required."
NSQ_SOURCE_LINE 00001392 ""
NSQ_SOURCE_LINE 00001393 "Support for block nodes is required."
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 "B<Scalar Styles>"
NSQ_SOURCE_LINE 00001396 ""
NSQ_SOURCE_LINE 00001397 "Support for all five scalar styles is required as per the YAML"
NSQ_SOURCE_LINE 00001398 "specification, although support for quoted scalars spanning more"
NSQ_SOURCE_LINE 00001399 "than one line is B<not> required."
NSQ_SOURCE_LINE 00001400 ""
NSQ_SOURCE_LINE 00001401 "Support for multi-line scalar documents starting on the header"
NSQ_SOURCE_LINE 00001402 "is not required."
NSQ_SOURCE_LINE 00001403 ""
NSQ_SOURCE_LINE 00001404 "Support for the chomping indicators on multi-line scalar styles"
NSQ_SOURCE_LINE 00001405 "is required."
NSQ_SOURCE_LINE 00001406 ""
NSQ_SOURCE_LINE 00001407 "B<Collection Styles>"
NSQ_SOURCE_LINE 00001408 ""
NSQ_SOURCE_LINE 00001409 "Support for block-style sequences is required."
NSQ_SOURCE_LINE 00001410 ""
NSQ_SOURCE_LINE 00001411 "Support for flow-style sequences is B<not> required."
NSQ_SOURCE_LINE 00001412 ""
NSQ_SOURCE_LINE 00001413 "Support for block-style mappings is required."
NSQ_SOURCE_LINE 00001414 ""
NSQ_SOURCE_LINE 00001415 "Support for flow-style mappings is B<not> required."
NSQ_SOURCE_LINE 00001416 ""
NSQ_SOURCE_LINE 00001417 "Both sequences and mappings should be able to be arbitrarily"
NSQ_SOURCE_LINE 00001418 "nested."
NSQ_SOURCE_LINE 00001419 ""
NSQ_SOURCE_LINE 00001420 "Support for plain-style mapping keys is required."
NSQ_SOURCE_LINE 00001421 ""
NSQ_SOURCE_LINE 00001422 "Support for quoted keys in mappings is B<not> required."
NSQ_SOURCE_LINE 00001423 ""
NSQ_SOURCE_LINE 00001424 "Support for \"?\"-indicated explicit keys is B<not> required."
NSQ_SOURCE_LINE 00001425 ""
NSQ_SOURCE_LINE 00001426 "=for stopwords endeth"
NSQ_SOURCE_LINE 00001427 ""
NSQ_SOURCE_LINE 00001428 "Here endeth the specification."
NSQ_SOURCE_LINE 00001429 ""
NSQ_SOURCE_LINE 00001430 "=head2 Additional Perl-Specific Notes"
NSQ_SOURCE_LINE 00001431 ""
NSQ_SOURCE_LINE 00001432 "For some Perl applications, it's important to know if you really have a"
NSQ_SOURCE_LINE 00001433 "number and not a string."
NSQ_SOURCE_LINE 00001434 ""
NSQ_SOURCE_LINE 00001435 "That is, in some contexts is important that 3 the number is distinctive"
NSQ_SOURCE_LINE 00001436 "from \"3\" the string."
NSQ_SOURCE_LINE 00001437 ""
NSQ_SOURCE_LINE 00001438 "Because even Perl itself is not trivially able to understand the difference"
NSQ_SOURCE_LINE 00001439 "(certainly without XS-based modules) Perl implementations of the YAML Tiny"
NSQ_SOURCE_LINE 00001440 "specification are not required to retain the distinctiveness of 3 vs \"3\"."
NSQ_SOURCE_LINE 00001441 ""
NSQ_SOURCE_LINE 00001442 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00001443 ""
NSQ_SOURCE_LINE 00001444 "Bugs should be reported via the CPAN bug tracker at"
NSQ_SOURCE_LINE 00001445 ""
NSQ_SOURCE_LINE 00001446 "L<http://rt.cpan.org/NoAuth/ReportBug.html?Queue=YAML-Tiny>"
NSQ_SOURCE_LINE 00001447 ""
NSQ_SOURCE_LINE 00001448 "=begin html"
NSQ_SOURCE_LINE 00001449 ""
NSQ_SOURCE_LINE 00001450 "For other issues, or commercial enhancement or support, please contact"
NSQ_SOURCE_LINE 00001451 "<a href=\"http://ali.as/\">Adam Kennedy</a> directly."
NSQ_SOURCE_LINE 00001452 ""
NSQ_SOURCE_LINE 00001453 "=end html"
NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 "=head1 AUTHOR"
