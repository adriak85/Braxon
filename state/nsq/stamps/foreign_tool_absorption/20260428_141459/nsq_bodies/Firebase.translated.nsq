BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Firebase;"
NSQ_SOURCE_LINE 00000002 "$Firebase::VERSION = '1.0002';"
NSQ_SOURCE_LINE 00000003 "use Moo;"
NSQ_SOURCE_LINE 00000004 "use Firebase::Auth;"
NSQ_SOURCE_LINE 00000005 "use HTTP::Thin;"
NSQ_SOURCE_LINE 00000006 "use HTTP::Request::Common qw(DELETE PUT GET POST);"
NSQ_SOURCE_LINE 00000007 "use Ouch;"
NSQ_SOURCE_LINE 00000008 "use JSON;"
NSQ_SOURCE_LINE 00000009 "use URI;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "has firebase => ("
NSQ_SOURCE_LINE 00000012 "    is          => 'ro',"
NSQ_SOURCE_LINE 00000013 "    required    => 1,"
NSQ_SOURCE_LINE 00000014 ");"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "has auth => ("
NSQ_SOURCE_LINE 00000017 "    is          => 'ro',"
NSQ_SOURCE_LINE 00000018 "    predicate   => 'has_auth',"
NSQ_SOURCE_LINE 00000019 ");"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "has authobj        => ("
NSQ_SOURCE_LINE 00000022 "    is          => 'rw',"
NSQ_SOURCE_LINE 00000023 "    lazy        => 1,"
NSQ_SOURCE_LINE 00000024 "    predicate   => 'has_authobj',"
NSQ_SOURCE_LINE 00000025 "    default     => sub {"
NSQ_SOURCE_LINE 00000026 "        Firebase::Auth->new(%{$_[0]->auth});"
NSQ_SOURCE_LINE 00000027 "    },"
NSQ_SOURCE_LINE 00000028 ");"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "has debug => ("
NSQ_SOURCE_LINE 00000031 "    is          => 'rw',"
NSQ_SOURCE_LINE 00000032 "    default     => sub { '' },"
NSQ_SOURCE_LINE 00000033 ");"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "has agent => ("
NSQ_SOURCE_LINE 00000036 "    is          => 'ro',"
NSQ_SOURCE_LINE 00000037 "    required    => 0,"
NSQ_SOURCE_LINE 00000038 "    lazy        => 1,"
NSQ_SOURCE_LINE 00000039 "    default     => sub { HTTP::Thin->new() },"
NSQ_SOURCE_LINE 00000040 ");"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "sub get {"
NSQ_SOURCE_LINE 00000043 "    my ($self, $path, $params) = @_;"
NSQ_SOURCE_LINE 00000044 "    my $uri = $self->create_uri($path, $params);"
NSQ_SOURCE_LINE 00000045 "    return $self->process_request( GET $uri );"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub delete {"
NSQ_SOURCE_LINE 00000049 "    my ($self, $path) = @_;"
NSQ_SOURCE_LINE 00000050 "    my $uri = $self->create_uri($path);"
NSQ_SOURCE_LINE 00000051 "    return $self->process_request( DELETE $uri );"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub put {"
NSQ_SOURCE_LINE 00000055 "    my ($self, $path, $params) = @_;"
NSQ_SOURCE_LINE 00000056 "    my $uri = $self->create_uri($path);"
NSQ_SOURCE_LINE 00000057 "    my $request = POST($uri->as_string, Content_Type => 'form-data', Content => to_json($params));"
NSQ_SOURCE_LINE 00000058 "    $request->method('PUT'); # because HTTP::Request::Common treats PUT as GET rather than POST"
NSQ_SOURCE_LINE 00000059 "    return $self->process_request( $request );"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "sub patch {"
NSQ_SOURCE_LINE 00000063 "    my ($self, $path, $params) = @_;"
NSQ_SOURCE_LINE 00000064 "    my $uri = $self->create_uri($path);"
NSQ_SOURCE_LINE 00000065 "    my $request = POST($uri->as_string, Content_Type => 'form-data', Content => to_json($params));"
NSQ_SOURCE_LINE 00000066 "    $request->method('PATCH'); # because HTTP::Request::Common treats PUT as GET rather than POST"
NSQ_SOURCE_LINE 00000067 "    return $self->process_request( $request );"
NSQ_SOURCE_LINE 00000068 "}"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "sub post {"
NSQ_SOURCE_LINE 00000071 "    my ($self, $path, $params) = @_;"
NSQ_SOURCE_LINE 00000072 "    my $uri = $self->create_uri($path);"
NSQ_SOURCE_LINE 00000073 "    my $request = POST($uri->as_string, Content_Type => 'form-data', Content => to_json($params));"
NSQ_SOURCE_LINE 00000074 "    return $self->process_request( $request );"
NSQ_SOURCE_LINE 00000075 "}"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "sub create_uri {"
NSQ_SOURCE_LINE 00000078 "    my ($self, $path) = @_;"
NSQ_SOURCE_LINE 00000079 "    my $url = 'https://'.$self->firebase.'.firebaseio.com/'.$path.'.json';"
NSQ_SOURCE_LINE 00000080 "    $url .= '?auth='.$self->authobj->create_token if $self->has_authobj || $self->has_auth;"
NSQ_SOURCE_LINE 00000081 "    return URI->new($url);"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "sub process_request {"
NSQ_SOURCE_LINE 00000085 "    my $self = shift;"
NSQ_SOURCE_LINE 00000086 "    $self->process_response($self->agent->request( @_ ));"
NSQ_SOURCE_LINE 00000087 "}"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "sub process_response {"
NSQ_SOURCE_LINE 00000090 "    my ($self, $response) = @_;"
NSQ_SOURCE_LINE 00000091 "    $self->debug($response->header('X-Firebase-Auth-Debug'));"
NSQ_SOURCE_LINE 00000092 "    if ($response->is_success) {"
NSQ_SOURCE_LINE 00000093 "        if ($response->decoded_content eq 'null') {"
NSQ_SOURCE_LINE 00000094 "            return undef;"
NSQ_SOURCE_LINE 00000095 "        }"
NSQ_SOURCE_LINE 00000096 "        else {"
NSQ_SOURCE_LINE 00000097 "            my $result = eval { from_json($response->decoded_content) }; "
NSQ_SOURCE_LINE 00000098 "            if ($@) {"
NSQ_SOURCE_LINE 00000099 "                warn $response->decoded_content;"
NSQ_SOURCE_LINE 00000100 "                ouch 500, 'Server returned unparsable content.';#, { error => $@, content => $response->decoded_content };"
NSQ_SOURCE_LINE 00000101 "            }"
NSQ_SOURCE_LINE 00000102 "            return $result;"
NSQ_SOURCE_LINE 00000103 "        }"
NSQ_SOURCE_LINE 00000104 "    }"
NSQ_SOURCE_LINE 00000105 "    else {"
NSQ_SOURCE_LINE 00000106 "        ouch 500, $response->status_line, $response->decoded_content;"
NSQ_SOURCE_LINE 00000107 "    }"
NSQ_SOURCE_LINE 00000108 "}"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=head1 NAME"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "Firebase - An interface to firebase.com."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 VERSION"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "version 1.0002"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 " use Firebase;"
NSQ_SOURCE_LINE 00000121 " "
NSQ_SOURCE_LINE 00000122 " my $fb = Firebase->new(firebase => 'myfirebase', auth => { secret => 'xxxxxxx', data => { uid => 'xxx', username => 'fred' }, admin => \\1 } );"
NSQ_SOURCE_LINE 00000123 " "
NSQ_SOURCE_LINE 00000124 " my $result = $fb->put('foo', { this => 'that' });"
NSQ_SOURCE_LINE 00000125 " my $result = $fb->get('foo'); # or $fb->get('foo/this');"
NSQ_SOURCE_LINE 00000126 " my $result = $fb->delete('foo');"
NSQ_SOURCE_LINE 00000127 " "
NSQ_SOURCE_LINE 00000128 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "This is a light-weight wrapper around the Firebase REST API. Firebase is a real-time web service that acts as both a queue and a datastore. It's used for building real-time web apps and web services."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "More info at L<https://www.firebase.com/docs/rest-api-quickstart.html>."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=head1 METHODS"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=head2 new"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "Constructor"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=over"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=item firebase"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "Required. The name of your firebase."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=item auth"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "The parameters you'd pass to create a C<Firebase::Auth> object. This is a shortcut for constructing the object yourself and passing it into C<authobj>."
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=item authobj"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "A L<Firebase::Auth> object. Will be generated for you automatically if you don't supply one, but do supply C<auth>."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=item agent"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "A user agent. An L<HTTP::Thin> object will be generated for you automatically if you don't supply one."
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=back"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head2 get"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "Fetch some data from firebase."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=over"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=item path"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "The path to the info you want to fetch."
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=back"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=head2 put"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "Put some data into a firebase."
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=over"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=item path"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "The path where the info should be stored."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=item params"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "A hash reference of parameters to be stored at this location."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "B<Warning:> Firebase doesn't work with arrays, so you can nest scalars and hashes here, but not arrays."
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=back"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=head2 patch"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "Partial update of data in a location"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "=over"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "=item path"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "The path where the info should be stored."
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=item params"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "A hash reference of parameters to be updated at this location."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=back"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head2 post"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "Adds data to an existing location, creating a hash of objects below the path."
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=over"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=item path"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "The path where the info should be stored."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=item params"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "A hash reference of parameters to be stored at this location."
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "B<Warning:> Firebase doesn't work with arrays, so you can nest scalars and hashes here, but not arrays."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=back"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=head2 delete"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "Delete some data from a firebase."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=over"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=item path"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "The path where the info is that you want deleted."
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=back"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head2 debug"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "If C<debug> has been set to a true value in C<Firebase::Auth>, this will return the debug message returned with the previous response."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=head2 create_uri"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "Creates a URI to a firebase data segment. You almost certainly want to use C<get>, C<put> or C<delete> instead."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=over"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=item path"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "The path to the data."
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=item params"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "Any parameters you need to pass for any reason."
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=back"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head2 process_request"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "Requests data and runs it through C<process_response>. You almost certainly want to use C<get>, C<put> or C<delete> instead."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "=over"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=item request"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "An L<HTTP::Request> object."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=back"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=head2 process_response"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "Checks for errors, decodes json, and returns a result. You almost certainly want to use C<get>, C<put> or C<delete> instead."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "=over"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "=item response"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "An L<HTTP::Response> object."
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=back"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 ""
