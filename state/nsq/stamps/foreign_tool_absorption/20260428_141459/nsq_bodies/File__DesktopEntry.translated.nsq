NSQ_SOURCE_LINE 00000001 "package File::DesktopEntry;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use vars qw/$AUTOLOAD/;"
NSQ_SOURCE_LINE 00000007 "use Carp;"
NSQ_SOURCE_LINE 00000008 "use Encode;"
NSQ_SOURCE_LINE 00000009 "use File::Spec;"
NSQ_SOURCE_LINE 00000010 "use File::BaseDir 0.03 qw/data_files data_home/;"
NSQ_SOURCE_LINE 00000011 "use URI::Escape;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our $VERSION = '0.23';"
NSQ_SOURCE_LINE 00000014 "our $VERBOSE = 0;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "if ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000017 "    eval q/use Win32::Process/;"
NSQ_SOURCE_LINE 00000018 "    die $@ if $@;"
