NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "=head1 NAME"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "File::DesktopEntry - Object to handle .desktop files"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    use File::DesktopEntry;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    my $entry = File::DesktopEntry->new('firefox');"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    print \"Using \".$entry->Name.\" to open http://perl.org\\n\";"
NSQ_SOURCE_LINE 00000032 "    $entry->run('http://perl.org');"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "This module is designed to work with F<.desktop> files. The format of these files"
NSQ_SOURCE_LINE 00000037 "is specified by the freedesktop \"Desktop Entry\" specification. This module can"
NSQ_SOURCE_LINE 00000038 "parse these files but also knows how to run the applications defined by these"
NSQ_SOURCE_LINE 00000039 "files."
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "For this module version 1.0 of the specification was used."
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "This module was written to support L<File::MimeInfo::Applications>."
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "Please remember: case is significant for the names of Desktop Entry keys."
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 VARIABLES"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "You can set the global variable C<$File::DesktopEntry::VERBOSE>. If set the"
NSQ_SOURCE_LINE 00000050 "module prints a warning every time a command gets executed."
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "The global variable C<$File::DesktopEntry::LOCALE> tells you what the default"
NSQ_SOURCE_LINE 00000053 "locale being used is. However, changing it will not change the default locale."
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "=head1 AUTOLOAD"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "All methods that start with a capital are autoloaded as C<get(KEY)> where"
NSQ_SOURCE_LINE 00000058 "key is the autoloaded method name."
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=head1 METHODS"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=over 4"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=item C<new(FILE)>"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=item C<new(\\$TEXT)>"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=item C<new(NAME)>"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "Constructor. FILE, NAME or TEXT are optional arguments."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "When a name is given (a string without 'C</>', 'C<\\>' or 'C<.>') a lookup is"
NSQ_SOURCE_LINE 00000073 "done using File::BaseDir. If the file found in this lookup is not writable or"
NSQ_SOURCE_LINE 00000074 "if no file was found, the XDG_DATA_HOME path will be used when writing."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=cut"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "our $LOCALE = 'C';"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "# POSIX setlocale(LC_MESSAGES) not supported on all platforms"
NSQ_SOURCE_LINE 00000081 "# so we do it ourselves ..."
NSQ_SOURCE_LINE 00000082 "# string might look like lang_COUNTRY.ENCODING@MODIFIER"
NSQ_SOURCE_LINE 00000083 "for (qw/LC_ALL LC_MESSAGES LANGUAGE LANG/) {"
NSQ_SOURCE_LINE 00000084 "    next unless $ENV{$_};"
NSQ_SOURCE_LINE 00000085 "    $LOCALE = $ENV{$_};"
NSQ_SOURCE_LINE 00000086 "    last;"
NSQ_SOURCE_LINE 00000087 "}"
NSQ_SOURCE_LINE 00000088 "our $_locale = _parse_lang($LOCALE);"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "sub new {"
NSQ_SOURCE_LINE 00000091 "    my ($class, $file) = @_;"
NSQ_SOURCE_LINE 00000092 "    my $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000093 "    if (! defined $file) { # initialize new file"
NSQ_SOURCE_LINE 00000094 "        $self->set(Version => '1.0', Encoding => 'UTF-8');"
NSQ_SOURCE_LINE 00000095 "    }"
NSQ_SOURCE_LINE 00000096 "    elsif (ref $file)           { $self->read($file)   } # SCALAR"
NSQ_SOURCE_LINE 00000097 "    elsif ($file =~ /[\\/\\\\\\.]/) { $$self{file} = $file } # file"
NSQ_SOURCE_LINE 00000098 "    else {"
NSQ_SOURCE_LINE 00000099 "        $$self{file} = $class->lookup($file);     # name"
NSQ_SOURCE_LINE 00000100 "        $$self{name} = $file;"
NSQ_SOURCE_LINE 00000101 "    }"
NSQ_SOURCE_LINE 00000102 "    return $self;"
NSQ_SOURCE_LINE 00000103 "}"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000106 "    $AUTOLOAD =~ s/.*:://;"
NSQ_SOURCE_LINE 00000107 "    return if $AUTOLOAD eq 'DESTROY';"
NSQ_SOURCE_LINE 00000108 "    croak \"No such method: File::DesktopEntry::$AUTOLOAD\""
NSQ_SOURCE_LINE 00000109 "        unless $AUTOLOAD =~ /^[A-Z][A-Za-z0-9-]+$/;"
NSQ_SOURCE_LINE 00000110 "    return $_[0]->get($AUTOLOAD);"
NSQ_SOURCE_LINE 00000111 "}"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=item C<lookup(NAME)>"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "Returns a filename for a desktop entry with desktop file id NAME."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=cut"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "sub lookup {"
NSQ_SOURCE_LINE 00000120 "    my (undef, $name) = @_;"
NSQ_SOURCE_LINE 00000121 "    $name .= '.desktop';"
NSQ_SOURCE_LINE 00000122 "    my $file = data_files('applications', $name);"
NSQ_SOURCE_LINE 00000123 "    if (! $file and $name =~ /-/) {"
NSQ_SOURCE_LINE 00000124 "        # name contains \"-\" and was not found"
NSQ_SOURCE_LINE 00000125 "        my @name = split /-/, $name;"
NSQ_SOURCE_LINE 00000126 "        $file = data_files('applications', @name);"
NSQ_SOURCE_LINE 00000127 "    }"
NSQ_SOURCE_LINE 00000128 "    return $file;"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "sub _parse_lang {"
NSQ_SOURCE_LINE 00000132 "    # lang might look like lang_COUNTRY.ENCODING@MODIFIER"
NSQ_SOURCE_LINE 00000133 "    my $lang = shift;"
NSQ_SOURCE_LINE 00000134 "    return '' if !$lang or $lang eq 'C' or $lang eq 'POSIX';"
NSQ_SOURCE_LINE 00000135 "    $lang =~ m{^"
NSQ_SOURCE_LINE 00000136 "        ([^_@\\.]+)        # lang       $1"
NSQ_SOURCE_LINE 00000137 "        (?: _  ([^@\\.]+) )?    # COUNTRY  $2"
NSQ_SOURCE_LINE 00000138 "        (?: \\.  [^@]+    )?    # ENCODING"
NSQ_SOURCE_LINE 00000139 "        (?: \\@ (.+)      )?    # MODIFIER $3"
NSQ_SOURCE_LINE 00000140 "    $}x or return '';"
NSQ_SOURCE_LINE 00000141 "    my ($l, $c, $m) = ($1, $2, $3);"
NSQ_SOURCE_LINE 00000142 "    my @locale = ("
NSQ_SOURCE_LINE 00000143 "        $l,"
NSQ_SOURCE_LINE 00000144 "        ($m         ? \"$l\\@$m\"     : ()),"
NSQ_SOURCE_LINE 00000145 "        ($c         ? \"$l\\_$c\"     : ()),"
NSQ_SOURCE_LINE 00000146 "        (($m && $c) ? \"$l\\_$c\\@$m\" : ())  );"
NSQ_SOURCE_LINE 00000147 "    return join '|', reverse @locale;"
NSQ_SOURCE_LINE 00000148 "}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=item C<wants_uris( )>"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "Returns true if the Exec string for this desktop entry specifies that the"
NSQ_SOURCE_LINE 00000153 "application uses URIs instead of paths. This can be used to determine"
NSQ_SOURCE_LINE 00000154 "whether an application uses a VFS library."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=item C<wants_list( )>"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "Returns true if the Exec string for this desktop entry specifies that the"
NSQ_SOURCE_LINE 00000159 "application can handle multiple arguments at once."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=cut"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "sub wants_uris {"
NSQ_SOURCE_LINE 00000165 "    my $self = shift;"
NSQ_SOURCE_LINE 00000166 "    my $exec = $self->get('Exec');"
NSQ_SOURCE_LINE 00000167 "    croak \"No Exec string defined for desktop entry\" unless length $exec;"
NSQ_SOURCE_LINE 00000168 "    $exec =~ s/\\%\\%//g;"
NSQ_SOURCE_LINE 00000169 "    return $exec =~ /\\%U/i;"
NSQ_SOURCE_LINE 00000170 "}"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "sub wants_list {"
NSQ_SOURCE_LINE 00000173 "    my $self = shift;"
NSQ_SOURCE_LINE 00000174 "    my $exec = $self->get('Exec');"
NSQ_SOURCE_LINE 00000175 "    croak \"No Exec string defined for desktop entry\" unless length $exec;"
NSQ_SOURCE_LINE 00000176 "    $exec =~ s/\\%\\%//g;"
NSQ_SOURCE_LINE 00000177 "    return $exec !~ /\\%[fud]/; # we default to %F if no /\\%[FUD]/i is found"
NSQ_SOURCE_LINE 00000178 "}"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=item C<run(@FILES)>"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "Forks and runs the application specified in this Desktop Entry"
NSQ_SOURCE_LINE 00000183 "with arguments FILES as a background process. Returns the pid."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "The child process fails when this is not a Desktop Entry of type Application"
NSQ_SOURCE_LINE 00000186 "or if the Exec key is missing or invalid."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "If the desktop entry specifies that the program needs to be executed in a"
NSQ_SOURCE_LINE 00000189 "terminal the $TERMINAL environment variable is used. If this variable is not"
NSQ_SOURCE_LINE 00000190 "set C<xterm -e> is used as default."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "(On Windows this method returns a L<Win32::Process> object.)"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=item C<system(@FILES)>"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "Like C<run()> but using the C<system()> system call."
NSQ_SOURCE_LINE 00000197 "It only return after the application has ended."
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "=item C<exec(@FILES)>"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "Like C<run()> but using the C<exec()> system call. This method"
NSQ_SOURCE_LINE 00000202 "is expected not to return but to replace the current process with the"
NSQ_SOURCE_LINE 00000203 "application you try to run."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "On Windows this method doesn't always work the way you want it to"
NSQ_SOURCE_LINE 00000206 "due to the C<fork()> emulation on this platform. Try using C<run()> or"
NSQ_SOURCE_LINE 00000207 "C<system()> instead."
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=cut"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "sub run {"
NSQ_SOURCE_LINE 00000212 "    my $pid = fork;"
NSQ_SOURCE_LINE 00000213 "    return $pid if $pid; # parent process"
NSQ_SOURCE_LINE 00000214 "    unshift @_, 'exec'; goto \\&_run;"
NSQ_SOURCE_LINE 00000215 "}"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "sub system { unshift @_, 'system'; goto \\&_run }"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "sub exec   { unshift @_, 'exec';   goto \\&_run }"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "sub _run {"
NSQ_SOURCE_LINE 00000222 "    my $call = shift;"
NSQ_SOURCE_LINE 00000223 "    my $self = shift;"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "    croak \"Desktop entry is not an Application\""
NSQ_SOURCE_LINE 00000226 "        unless $self->get('Type') eq 'Application';"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "    my @exec = $self->parse_Exec(@_);"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "    my $t = $self->get('Terminal');"
NSQ_SOURCE_LINE 00000231 "    if ($t and $t eq 'true') {"
NSQ_SOURCE_LINE 00000232 "        my $term = $ENV{TERMINAL} || 'xterm -e';"
NSQ_SOURCE_LINE 00000233 "        unshift @exec, _split($term);"
NSQ_SOURCE_LINE 00000234 "    }"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "    my $cwd;"
NSQ_SOURCE_LINE 00000237 "    if (my $path = $self->get('Path')) {"
NSQ_SOURCE_LINE 00000238 "        require Cwd;"
NSQ_SOURCE_LINE 00000239 "        $cwd = Cwd::getcwd();"
NSQ_SOURCE_LINE 00000240 "        chdir $path or croak \"Could not change to dir: $path\";"
NSQ_SOURCE_LINE 00000241 "        $ENV{PWD} = $path;"
NSQ_SOURCE_LINE 00000242 "        warn \"Running from directory: $path\\n\" if $VERBOSE;"
NSQ_SOURCE_LINE 00000243 "    }"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "    warn \"Running: \"._quote(@exec).\"\\n\" if $VERBOSE;"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    if ($call eq 'exec') { CORE::exec   {$exec[0]} @exec; exit 1 }"
NSQ_SOURCE_LINE 00000248 "    else                 { CORE::system {$exec[0]} @exec         }"
NSQ_SOURCE_LINE 00000249 "    warn \"Error: $!\\n\" if $VERBOSE and $?;"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "    if (defined $cwd) {"
NSQ_SOURCE_LINE 00000252 "        chdir $cwd or croak \"Could not change back to dir: $cwd\";"
NSQ_SOURCE_LINE 00000253 "        $ENV{PWD} = $cwd;"
NSQ_SOURCE_LINE 00000254 "    }"
NSQ_SOURCE_LINE 00000255 "}"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=item C<parse_Exec(@FILES)>"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "Expands the Exec format in this desktop entry with. Returns a properly quoted"
NSQ_SOURCE_LINE 00000260 "string in scalar context or a list of words in list context. Dies when the"
NSQ_SOURCE_LINE 00000261 "Exec key is invalid."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "It supports the following fields:"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "    %f    single file"
NSQ_SOURCE_LINE 00000266 "    %F    multiple files"
NSQ_SOURCE_LINE 00000267 "    %u    single url"
NSQ_SOURCE_LINE 00000268 "    %U    multiple urls"
NSQ_SOURCE_LINE 00000269 "    %i    Icon field prefixed by --icon"
NSQ_SOURCE_LINE 00000270 "    %c    Name field, possibly translated"
NSQ_SOURCE_LINE 00000271 "    %k    location of this .desktop file"
NSQ_SOURCE_LINE 00000272 "    %%    literal '%'"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "If necessary this method tries to convert between paths and URLs but this"
NSQ_SOURCE_LINE 00000275 "is not perfect."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "Fields that are deprecated, but (still) supported by this module:"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "    %d    single directory"
NSQ_SOURCE_LINE 00000280 "    %D    multiple directories"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "The fields C<%n>, C<%N>, C<%v> and C<%m> are deprecated and will cause a"
NSQ_SOURCE_LINE 00000283 "warning if C<$VERBOSE> is used. Any other unknown fields will cause an error."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "The fields C<%F>, C<%U>, C<%D> and C<%i> can only occur as separate words"
NSQ_SOURCE_LINE 00000286 "because they expand to multiple arguments."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "Also see L</LIMITATIONS>."
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=cut"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "sub parse_Exec {"
NSQ_SOURCE_LINE 00000293 "    my ($self, @argv) = @_;"
NSQ_SOURCE_LINE 00000294 "    my @format = _split( $self->get('Exec') );"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "    # Check format"
NSQ_SOURCE_LINE 00000297 "    my $seen = 0;"
NSQ_SOURCE_LINE 00000298 "    for (@format) {"
NSQ_SOURCE_LINE 00000299 "        my $s = $_; # copy;"
NSQ_SOURCE_LINE 00000300 "        $s =~ s/\\%\\%//g;"
NSQ_SOURCE_LINE 00000301 "        $seen += ($s =~ /\\%[fFuUdD]/);"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "        die \"Exec key for '\".$self->get('Name').\"' contains \" ."
NSQ_SOURCE_LINE 00000304 "            \"'\\%F\\', '\\%U' or '\\%D' at the wrong place\\n\""
NSQ_SOURCE_LINE 00000305 "            if $s !~ /^\\%[FUD]$/ and $s =~ /\\%[FUD]/;"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "        die \"Exec key for '\".$self->get('Name').\"' contains \" ."
NSQ_SOURCE_LINE 00000308 "            \"unknown field code '$1'\\n\""
NSQ_SOURCE_LINE 00000309 "            if $s =~ /(\\%[^fFuUdDnNickvm])/;"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "        croak \"Application '\".$self->get('Name').\"' \"."
NSQ_SOURCE_LINE 00000312 "              \"takes only one argument\""
NSQ_SOURCE_LINE 00000313 "            if @argv > 1 and $s =~ /\\%[fud]/;"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "        warn \"Exec key for '\".$self->get('Name').\"' contains \" ."
NSQ_SOURCE_LINE 00000316 "             \"deprecated field codes\\n\""
NSQ_SOURCE_LINE 00000317 "            if $VERBOSE and $s =~ /%([nNvm])/;"
NSQ_SOURCE_LINE 00000318 "    }"
NSQ_SOURCE_LINE 00000319 "    if    ($seen == 0) { push @format, '%F' }"
NSQ_SOURCE_LINE 00000320 "    elsif ($seen >  1) {"
NSQ_SOURCE_LINE 00000321 "        # not allowed according to the spec"
NSQ_SOURCE_LINE 00000322 "        warn \"Exec key for '\".$self->get('Name').\"' contains \" ."
NSQ_SOURCE_LINE 00000323 "             \"multiple fields for files or uris.\\n\""
NSQ_SOURCE_LINE 00000324 "    }"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "    # Expand format"
NSQ_SOURCE_LINE 00000327 "    my @exec;"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "    for (@format) {"
NSQ_SOURCE_LINE 00000330 "        if (/^\\%([FUD])$/) {"
NSQ_SOURCE_LINE 00000331 "            push @exec,"
NSQ_SOURCE_LINE 00000332 "                ($1 eq 'F') ? _paths(@argv) :"
NSQ_SOURCE_LINE 00000333 "                ($1 eq 'U') ? _uris(@argv)  : _dirs(@argv)  ;"
NSQ_SOURCE_LINE 00000334 "        }"
NSQ_SOURCE_LINE 00000335 "        elsif ($_ eq '%i') {"
NSQ_SOURCE_LINE 00000336 "            my $icon = $self->get('Icon');"
NSQ_SOURCE_LINE 00000337 "            push @exec, '--icon', $icon if defined($icon);"
NSQ_SOURCE_LINE 00000338 "        }"
NSQ_SOURCE_LINE 00000339 "        else { # expand with word ( e.g. --input=%f )"
NSQ_SOURCE_LINE 00000340 "            my $bad;"
NSQ_SOURCE_LINE 00000341 "            s/\\%(.)/"
NSQ_SOURCE_LINE 00000342 "                ($1 eq '%') ? '%'                :"
NSQ_SOURCE_LINE 00000343 "                ($1 eq 'f') ? (_paths(@argv))[0] :"
NSQ_SOURCE_LINE 00000344 "                ($1 eq 'u') ? (_uris(@argv) )[0] :"
NSQ_SOURCE_LINE 00000345 "                ($1 eq 'd') ? (_dirs(@argv) )[0] :"
NSQ_SOURCE_LINE 00000346 "                ($1 eq 'c') ? $self->get('Name') :"
NSQ_SOURCE_LINE 00000347 "                ($1 eq 'k') ? $$self{file}       : '' ;"
NSQ_SOURCE_LINE 00000348 "            /eg;"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "            push @exec, $_;"
NSQ_SOURCE_LINE 00000351 "        }"
NSQ_SOURCE_LINE 00000352 "    }"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "    if (wantarray and $^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000355 "        # Win32 requires different quoting *sigh*"
NSQ_SOURCE_LINE 00000356 "        for (grep /\"/, @exec) {"
NSQ_SOURCE_LINE 00000357 "                s#\"#\\\\\"#g;"
NSQ_SOURCE_LINE 00000358 "                $_ = qq#\"$_\"#;"
NSQ_SOURCE_LINE 00000359 "        }"
NSQ_SOURCE_LINE 00000360 "    }"
NSQ_SOURCE_LINE 00000361 "    return wantarray ? (@exec) : _quote(@exec);"
NSQ_SOURCE_LINE 00000362 "}"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "sub _split {"
NSQ_SOURCE_LINE 00000365 "    # Reverse quoting and break string in words."
NSQ_SOURCE_LINE 00000366 "    # It allows single quotes to be used, which the spec doesn't."
NSQ_SOURCE_LINE 00000367 "    my $string = shift;"
NSQ_SOURCE_LINE 00000368 "    my @args;"
NSQ_SOURCE_LINE 00000369 "    while ($string =~ /\\S/) {"
NSQ_SOURCE_LINE 00000370 "        if ($string =~ /^(['\"])/) {"
NSQ_SOURCE_LINE 00000371 "            my $q = $1;"
NSQ_SOURCE_LINE 00000372 "            $string =~ s/^($q(\\\\.|[^$q])*$q)//s;"
NSQ_SOURCE_LINE 00000373 "            push @args, $1 if defined $1;"
NSQ_SOURCE_LINE 00000374 "        }"
NSQ_SOURCE_LINE 00000375 "        $string =~ s/(\\S*)\\s*//; # also fallback for above regex"
NSQ_SOURCE_LINE 00000376 "        push @args, $1 if defined $1;"
NSQ_SOURCE_LINE 00000377 "    }"
NSQ_SOURCE_LINE 00000378 "    @args = grep length($_), @args;"
NSQ_SOURCE_LINE 00000379 "    for (@args) {"
NSQ_SOURCE_LINE 00000380 "        if (/^([\"'])(.*)\\1$/s) {"
NSQ_SOURCE_LINE 00000381 "            $_ = $2;"
NSQ_SOURCE_LINE 00000382 "            s/\\\\([\"`\\$\\\\])/$1/g; # remove backslashes"
NSQ_SOURCE_LINE 00000383 "        }"
NSQ_SOURCE_LINE 00000384 "    }"
NSQ_SOURCE_LINE 00000385 "    return @args;"
NSQ_SOURCE_LINE 00000386 "}"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "sub _quote {"
NSQ_SOURCE_LINE 00000389 "    # Turn a list of words in a properly quoted Exec key"
NSQ_SOURCE_LINE 00000390 "    my @words = @_; # copy;"
NSQ_SOURCE_LINE 00000391 "    return join ' ', map {"
NSQ_SOURCE_LINE 00000392 "        if (/([\\s\"'`\\\\<>~\\|\\&;\\$\\*\\?#\\(\\)])/) { # reserved chars"
NSQ_SOURCE_LINE 00000393 "            s/([\"`\\$\\\\])/\\\\$1/g; # add backslashes"
NSQ_SOURCE_LINE 00000394 "            $_ = qq/\"$_\"/;       # add quotes"
NSQ_SOURCE_LINE 00000395 "        }"
NSQ_SOURCE_LINE 00000396 "        $_;"
NSQ_SOURCE_LINE 00000397 "    } grep defined($_), @words;"
NSQ_SOURCE_LINE 00000398 "}"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "sub _paths {"
NSQ_SOURCE_LINE 00000401 "    # Check if we need to convert file:// uris to paths"
NSQ_SOURCE_LINE 00000402 "    # support file:/path file://localhost/path and file:///path"
NSQ_SOURCE_LINE 00000403 "    # A path like file://host/path is replace by smb://host/path"
NSQ_SOURCE_LINE 00000404 "    # which the app probably can't open"
NSQ_SOURCE_LINE 00000405 "    map {"
NSQ_SOURCE_LINE 00000406 "        $_ = _uri_to_path($_) if s#^file:(?://localhost/+|/|///+)(?!/)#/#i;"
NSQ_SOURCE_LINE 00000407 "        s#^file://(?!/)#smb://#i;"
NSQ_SOURCE_LINE 00000408 "        $_;"
NSQ_SOURCE_LINE 00000409 "    } @_;"
NSQ_SOURCE_LINE 00000410 "}"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "sub _dirs {"
NSQ_SOURCE_LINE 00000413 "    # Like _paths, but makes the path a directory"
NSQ_SOURCE_LINE 00000414 "    map {"
NSQ_SOURCE_LINE 00000415 "        if (-d $_) { $_ }"
NSQ_SOURCE_LINE 00000416 "        else {"
NSQ_SOURCE_LINE 00000417 "            my ($vol, $dirs, undef) = File::Spec->splitpath($_);"
NSQ_SOURCE_LINE 00000418 "            File::Spec->catpath($vol, $dirs, '');"
NSQ_SOURCE_LINE 00000419 "        }"
NSQ_SOURCE_LINE 00000420 "    } _paths(@_);"
NSQ_SOURCE_LINE 00000421 "}"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "sub _uris {"
NSQ_SOURCE_LINE 00000424 "    # Convert paths to file:// uris"
NSQ_SOURCE_LINE 00000425 "    map {"
NSQ_SOURCE_LINE 00000426 "        m#^\\w+://# ? $_ : 'file://'._path_to_uri($_);"
NSQ_SOURCE_LINE 00000427 "    } @_;"
NSQ_SOURCE_LINE 00000428 "}"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "sub _uri_to_path {"
NSQ_SOURCE_LINE 00000431 "    my $x = Encode::encode('utf8', $_);"
NSQ_SOURCE_LINE 00000432 "    $x = uri_unescape($x);"
NSQ_SOURCE_LINE 00000433 "    return Encode::decode('utf8', $x);"
NSQ_SOURCE_LINE 00000434 "}"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "sub _path_to_uri {"
NSQ_SOURCE_LINE 00000437 "    my $path = File::Spec->rel2abs(shift);"
NSQ_SOURCE_LINE 00000438 "    my ($volume, $directories, $file) = File::Spec->splitpath($path);"
NSQ_SOURCE_LINE 00000439 "    my $uri = '';"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "    # actually, on Windows, File URIs look like this:"
NSQ_SOURCE_LINE 00000442 "    # file:///C:/Program%20Files/MyApp/app.exe"
NSQ_SOURCE_LINE 00000443 "    # ref: https://blogs.msdn.microsoft.com/ie/2006/12/06/file-uris-in-windows/"
NSQ_SOURCE_LINE 00000444 "    if ($volume) {"
NSQ_SOURCE_LINE 00000445 "        $uri .= '/' . $volume;"
NSQ_SOURCE_LINE 00000446 "    }"
NSQ_SOURCE_LINE 00000447 "    $uri .= join '/', map { uri_escape_utf8($_) } File::Spec->splitdir($directories . $file);"
NSQ_SOURCE_LINE 00000448 "    return $uri;"
NSQ_SOURCE_LINE 00000449 "}"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "=item C<get(KEY)>"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "=item C<get(GROUP, KEY)>"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "Get a value for KEY from GROUP. If GROUP is not specified 'Desktop Entry' is"
NSQ_SOURCE_LINE 00000456 "used. All values are treated as string, so e.g. booleans will be returned as"
NSQ_SOURCE_LINE 00000457 "the literal strings \"true\" and \"false\"."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "When KEY does not contain a language code you get the translation in the"
NSQ_SOURCE_LINE 00000460 "current locale if available or a sensible default. The request a specific"
NSQ_SOURCE_LINE 00000461 "language you can add the language part. E.g. C<< $entry->get('Name[nl_NL]') >>"
NSQ_SOURCE_LINE 00000462 "can return either the value of the 'Name[nl_NL]', the 'Name[nl]' or the 'Name'"
NSQ_SOURCE_LINE 00000463 "key in the Desktop Entry file. Exact language parsing order can be found in the"
NSQ_SOURCE_LINE 00000464 "spec. To force you get the untranslated key use either 'Name[C]' or"
NSQ_SOURCE_LINE 00000465 "'Name[POSIX]'."
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "=cut"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "# used for (un-)escaping strings"
NSQ_SOURCE_LINE 00000470 "my %Chr = (s => ' ', n => \"\\n\", r => \"\\r\", t => \"\\t\", '\\\\' => '\\\\');"
NSQ_SOURCE_LINE 00000471 "my %Esc = reverse %Chr;"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "sub get {"
NSQ_SOURCE_LINE 00000474 "    my ($self, $group, $key) ="
NSQ_SOURCE_LINE 00000475 "        (@_ == 2) ? ($_[0], '', $_[1]) : (@_) ;"
NSQ_SOURCE_LINE 00000476 "    my $locale = $_locale;"
NSQ_SOURCE_LINE 00000477 "    if ($key =~ /^(.*?)\\[(.*?)\\]$/) {"
NSQ_SOURCE_LINE 00000478 "        $key = $1;"
NSQ_SOURCE_LINE 00000479 "        $locale = _parse_lang($2);"
NSQ_SOURCE_LINE 00000480 "    }"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "    my @lang = split /\\|/, $locale;"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "    # Get values that match locale from group"
NSQ_SOURCE_LINE 00000485 "    $self->read() unless $$self{groups};"
NSQ_SOURCE_LINE 00000486 "    my $i = $self->_group($group);"
NSQ_SOURCE_LINE 00000487 "    return undef unless defined $i;"
NSQ_SOURCE_LINE 00000488 "    my $lang = join('|', map quotemeta($_), @lang) || 'C';"
NSQ_SOURCE_LINE 00000489 "    my %matches = ( $$self{groups}[$i] =~"
NSQ_SOURCE_LINE 00000490 "        /^(\\Q$key\\E\\[(?:$lang)\\]|\\Q$key\\E)[^\\S\\n]*=[^\\S\\n]*(.*?)\\s*$/gm );"
NSQ_SOURCE_LINE 00000491 "    return undef unless keys %matches;"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "    # Find preferred value"
NSQ_SOURCE_LINE 00000494 "    my @keys = (map($key.\"[$_]\", @lang), $key);"
NSQ_SOURCE_LINE 00000495 "    my ($value) = grep defined($_), @matches{@keys};"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "    # Parse string (replace \\n, \\t, etc.)"
NSQ_SOURCE_LINE 00000498 "    $value =~ s/\\\\(.)/$Chr{$1}||$1/eg;"
NSQ_SOURCE_LINE 00000499 "    return $value;"
NSQ_SOURCE_LINE 00000500 "}"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "sub _group { # returns index for a group name"
NSQ_SOURCE_LINE 00000503 "    my ($self, $group, $dont_die) = @_;"
NSQ_SOURCE_LINE 00000504 "    $group ||= 'Desktop Entry';"
NSQ_SOURCE_LINE 00000505 "    croak \"Group name contains invalid characters: $group\""
NSQ_SOURCE_LINE 00000506 "        if $group =~ /[\\[\\]\\r\\n]/;"
NSQ_SOURCE_LINE 00000507 "    for my $i (0 .. $#{$$self{groups}}) {"
NSQ_SOURCE_LINE 00000508 "        return $i if $$self{groups}[$i] =~ /^\\[\\Q$group\\E\\]/;"
NSQ_SOURCE_LINE 00000509 "    }"
NSQ_SOURCE_LINE 00000510 "    return undef;"
NSQ_SOURCE_LINE 00000511 "}"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "=item C<set(KEY =E<gt> VALUE, ...)>"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "=item C<set(GROUP, KEY =E<gt> VALUE, ...)>"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "Set values for one or more keys. If GROUP is not given \"Desktop Entry\" is used."
NSQ_SOURCE_LINE 00000518 "All values are treated as strings, backslashes, newlines and tabs are escaped."
NSQ_SOURCE_LINE 00000519 "To set a boolean key you need to use the literal strings \"true\" and \"false\"."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "Unlike the C<get()> call languages are not handled automatically for C<set()>."
NSQ_SOURCE_LINE 00000522 "KEY should include the language part if you want to set a translation."
NSQ_SOURCE_LINE 00000523 "E.g. C<< $entry->set(\"Name[nl_NL]\" => \"Tekst Verwerker\") >> will set a Dutch"
NSQ_SOURCE_LINE 00000524 "translation for the Name key. Using either \"Name[C]\" or \"Name[POSIX]\" will"
NSQ_SOURCE_LINE 00000525 "be equivalent with not giving a language argument."
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "When setting the Exec key without specifying a group it will be parsed"
NSQ_SOURCE_LINE 00000528 "and quoted correctly as required by the spec. You can use quoted arguments"
NSQ_SOURCE_LINE 00000529 "to include whitespace in a argument, escaping whitespace does not work."
NSQ_SOURCE_LINE 00000530 "To circumvent this quoting explicitly give the group name 'Desktop Entry'."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "=cut"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "sub set {"
NSQ_SOURCE_LINE 00000535 "    my $self = shift;"
NSQ_SOURCE_LINE 00000536 "    my ($group, @data) = ($#_ % 2) ? (undef, @_) : (@_) ;"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "    $self->read() unless $$self{groups} or ! $$self{file};"
NSQ_SOURCE_LINE 00000539 "    my $i = $self->_group($group);"
NSQ_SOURCE_LINE 00000540 "    unless (defined $i) {"
NSQ_SOURCE_LINE 00000541 "        $group ||= 'Desktop Entry';"
NSQ_SOURCE_LINE 00000542 "        push @{$$self{groups}}, \"[$group]\\n\";"
NSQ_SOURCE_LINE 00000543 "        $i = $#{$$self{groups}};"
NSQ_SOURCE_LINE 00000544 "    }"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "    while (@data) {"
NSQ_SOURCE_LINE 00000547 "        my ($k, $v) = splice(@data, 0, 2);"
NSQ_SOURCE_LINE 00000548 "        $k =~ s/\\[(C|POSIX)\\]$//;  # remove default locale"
NSQ_SOURCE_LINE 00000549 "        my ($word) = ($k =~ /^(.*?)(\\[.*?\\])?$/);"
NSQ_SOURCE_LINE 00000550 "            # separate key and locale"
NSQ_SOURCE_LINE 00000551 "        croak \"BUG: Key missing: $k\" unless length $word;"
NSQ_SOURCE_LINE 00000552 "        carp \"Key contains invalid characters: $k\""
NSQ_SOURCE_LINE 00000553 "            if $word =~ /[^A-Za-z0-9-]/;"
NSQ_SOURCE_LINE 00000554 "        $v = _quote( _split($v) ) if ! $group and $k eq 'Exec';"
NSQ_SOURCE_LINE 00000555 "            # Exec key needs extra quoting"
NSQ_SOURCE_LINE 00000556 "        $v =~ s/([\\\\\\n\\r\\t])/\\\\$Esc{$1}/g; # add escapes"
NSQ_SOURCE_LINE 00000557 "        $$self{groups}[$i] =~ s/^\\Q$k\\E=.*$/$k=$v/m and next;"
NSQ_SOURCE_LINE 00000558 "        $$self{groups}[$i] .= \"$k=$v\\n\";"
NSQ_SOURCE_LINE 00000559 "    }"
NSQ_SOURCE_LINE 00000560 "}"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "=item C<text()>"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "Returns the (modified) text of the file."
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "=cut"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "sub text {"
NSQ_SOURCE_LINE 00000569 "    $_[0]->read() unless $_[0]{groups};"
NSQ_SOURCE_LINE 00000570 "    return '' unless $_[0]{groups};"
NSQ_SOURCE_LINE 00000571 "    s/\\n?$/\\n/ for @{$_[0]{groups}}; # just to be sure"
NSQ_SOURCE_LINE 00000572 "    return join \"\\n\", @{$_[0]{groups}};"
NSQ_SOURCE_LINE 00000573 "}"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "=item C<read(FILE)>"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "=item C<read(\\$SCALAR)>"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "Read Desktop Entry data from file or memory buffer."
NSQ_SOURCE_LINE 00000580 "Without argument defaults to file given at constructor."
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "If you gave a file, text buffer or name to the constructor this method will"
NSQ_SOURCE_LINE 00000583 "be called automatically."
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "=item C<read_fh(IO)>"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "Read Desktop Entry data from filehandle or IO object."
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "=cut"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "sub read {"
NSQ_SOURCE_LINE 00000592 "    my ($self, $file) = @_;"
NSQ_SOURCE_LINE 00000593 "    $file ||= $$self{file};"
NSQ_SOURCE_LINE 00000594 "    croak \"DesktopEntry has no filename to read from\" unless length $file;"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "    my $fh;"
NSQ_SOURCE_LINE 00000597 "    unless (ref $file)  {"
NSQ_SOURCE_LINE 00000598 "        open $fh, \"<$file\" or croak \"Could not open file: $file\";"
NSQ_SOURCE_LINE 00000599 "    }"
NSQ_SOURCE_LINE 00000600 "    else {"
NSQ_SOURCE_LINE 00000601 "        open $fh, '<', $file or croak \"Could not open SCALAR ref !?\";"
NSQ_SOURCE_LINE 00000602 "    }"
NSQ_SOURCE_LINE 00000603 "    binmode $fh, ':utf8';"
NSQ_SOURCE_LINE 00000604 "    $self->read_fh($fh);"
NSQ_SOURCE_LINE 00000605 "    close $fh;"
NSQ_SOURCE_LINE 00000606 "}"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "sub read_fh {"
NSQ_SOURCE_LINE 00000609 "    my ($self, $fh) = @_;"
NSQ_SOURCE_LINE 00000610 "    $$self{groups} = [];"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "    # Read groups"
NSQ_SOURCE_LINE 00000613 "    my $group = '';"
NSQ_SOURCE_LINE 00000614 "    while (my $l = <$fh>) {"
NSQ_SOURCE_LINE 00000615 "        $l =~ s/\\r?\\n$/\\n/; # DOS to Unix conversion"
NSQ_SOURCE_LINE 00000616 "        if ($l =~ /^\\[(.*?)\\]\\s*$/) {"
NSQ_SOURCE_LINE 00000617 "            push @{$$self{groups}}, $group"
NSQ_SOURCE_LINE 00000618 "                if length $group;"
NSQ_SOURCE_LINE 00000619 "            $group = '';"
NSQ_SOURCE_LINE 00000620 "        }"
NSQ_SOURCE_LINE 00000621 "        $group .= $l;"
NSQ_SOURCE_LINE 00000622 "    }"
NSQ_SOURCE_LINE 00000623 "    push @{$$self{groups}}, $group;"
NSQ_SOURCE_LINE 00000624 "    s/\\n\\n$/\\n/ for @{$$self{groups}}; # remove last empty line"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "    # Some checks"
NSQ_SOURCE_LINE 00000627 "    for (qw/Name Type/) {"
NSQ_SOURCE_LINE 00000628 "        carp \"Required key missing in Desktop Entry: $_\""
NSQ_SOURCE_LINE 00000629 "            unless defined $self->get($_);"
NSQ_SOURCE_LINE 00000630 "    }"
NSQ_SOURCE_LINE 00000631 "    my $enc = $self->get('Encoding');"
NSQ_SOURCE_LINE 00000632 "    carp \"Desktop Entry uses unsupported encoding: $enc\""
NSQ_SOURCE_LINE 00000633 "        if $enc and $enc ne 'UTF-8';"
NSQ_SOURCE_LINE 00000634 "}"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "=item C<write(FILE)>"
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "Write the Desktop Entry data to FILE. Without arguments it writes to"
NSQ_SOURCE_LINE 00000639 "the filename given to the constructor if any."
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "The keys Name and Type are required. Type can be either C<Application>,"
NSQ_SOURCE_LINE 00000642 "C<Link> or C<Directory>. For an application set the optional key C<Exec>. For"
NSQ_SOURCE_LINE 00000643 "a link set the C<URL> key."
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "=cut"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "# Officially we should check lines end with LF - this is \\n on Unix"
NSQ_SOURCE_LINE 00000648 "# but on Windows \\n is CR LF, which breaks the spec"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "sub write {"
NSQ_SOURCE_LINE 00000651 "    my $self = shift;"
NSQ_SOURCE_LINE 00000652 "    my $file = shift || $$self{file};"
NSQ_SOURCE_LINE 00000653 "    unless ($$self{groups}) {"
NSQ_SOURCE_LINE 00000654 "        if ($$self{file}) { $self->read() }"
NSQ_SOURCE_LINE 00000655 "        else { croak \"Can not write empty Desktop Entry file\" }"
NSQ_SOURCE_LINE 00000656 "    }"
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "    # Check keys"
NSQ_SOURCE_LINE 00000659 "    for (qw/Name Type/) {"
NSQ_SOURCE_LINE 00000660 "        croak \"Can not write a desktop file without a $_ field\""
NSQ_SOURCE_LINE 00000661 "            unless defined $self->get($_);"
NSQ_SOURCE_LINE 00000662 "    }"
NSQ_SOURCE_LINE 00000663 "    $self->set(Version => '1.0', Encoding => 'UTF-8');"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "    # Check file writable"
NSQ_SOURCE_LINE 00000666 "    $file = $self->_data_home_file"
NSQ_SOURCE_LINE 00000667 "        if (! $file or ! -w $file) and defined $$self{name};"
NSQ_SOURCE_LINE 00000668 "    croak \"No file given for writing Desktop Entry\" unless length $file;"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "    # Write file"
NSQ_SOURCE_LINE 00000671 "    s/\\n?$/\\n/ for @{$$self{groups}}; # just to be sure"
NSQ_SOURCE_LINE 00000672 "    open OUT, \">$file\" or die \"Could not write file: $file\\n\";"
NSQ_SOURCE_LINE 00000673 "    binmode OUT, ':utf8' unless $] < 5.008;"
NSQ_SOURCE_LINE 00000674 "    print OUT join \"\\n\", @{$$self{groups}};"
NSQ_SOURCE_LINE 00000675 "    close OUT;"
NSQ_SOURCE_LINE 00000676 "}"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "sub _data_home_file {"
NSQ_SOURCE_LINE 00000679 "    # create new file name in XDG_DATA_HOME from name"
NSQ_SOURCE_LINE 00000680 "    my $self = shift;"
NSQ_SOURCE_LINE 00000681 "    my @parts = split /-/, $$self{name};"
NSQ_SOURCE_LINE 00000682 "    $parts[-1] .= '.desktop';"
NSQ_SOURCE_LINE 00000683 "    my $dir = data_home('applications', @parts[0 .. $#parts-1]);"
NSQ_SOURCE_LINE 00000684 "    unless (-d $dir) { # create dir if it doesn't exist"
NSQ_SOURCE_LINE 00000685 "        require File::Path;"
NSQ_SOURCE_LINE 00000686 "        File::Path::mkpath($dir);"
NSQ_SOURCE_LINE 00000687 "    }"
NSQ_SOURCE_LINE 00000688 "    return data_home('applications', @parts);"
NSQ_SOURCE_LINE 00000689 "}"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "=back"
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "=head2 Backwards Compatibility"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "Methods supported for backwards compatibility with 0.02."
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "=over 4"
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "=item C<new_from_file(FILE)>"
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "Alias for C<new(FILE)>."
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "=item C<new_from_data(TEXT)>"
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "Alias for C<new(\\$TEXT)>."
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "=item C<get_value(NAME, GROUP, LANG)>"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "Identical to C<get(GROUP, \"NAME[LANG]\")>."
NSQ_SOURCE_LINE 00000710 "LANG defaults to 'C', GROUP is optional."
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "=cut"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "sub new_from_file { $_[0]->new($_[1])  }"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "sub new_from_data { $_[0]->new(\\$_[1]) }"
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "sub get_value {"
NSQ_SOURCE_LINE 00000719 "    my ($self, $key, $group, $locale) = @_;"
NSQ_SOURCE_LINE 00000720 "    $locale ||= 'C';"
NSQ_SOURCE_LINE 00000721 "    $key .= \"[$locale]\";"
NSQ_SOURCE_LINE 00000722 "    $group ? $self->get($group, $key) : $self->get($key);"
NSQ_SOURCE_LINE 00000723 "}"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "=back"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "=head1 NON-UNIX PLATFORMS"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "This module has a few bits of code to make it work on Windows. It handles"
NSQ_SOURCE_LINE 00000730 "C<file://> uri a bit different and it uses L<Win32::Process>. On other"
NSQ_SOURCE_LINE 00000731 "platforms your mileage may vary."
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "Please note that the specification is targeting Unix platforms only and"
NSQ_SOURCE_LINE 00000734 "will only have limited relevance on other platforms. Any platform-dependent"
NSQ_SOURCE_LINE 00000735 "behavior in this module should be considered an extension of the spec."
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "=cut"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "if ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000740 "    # Re-define some modules - I assume this block gets optimized away by the"
NSQ_SOURCE_LINE 00000741 "    # interpreter when not running on windows."
NSQ_SOURCE_LINE 00000742 "    no warnings;"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "    # Wrap _paths() to remove first '/'"
NSQ_SOURCE_LINE 00000745 "    # As a special case translate SMB file:// uris"
NSQ_SOURCE_LINE 00000746 "    my $_paths = \\&_paths;"
NSQ_SOURCE_LINE 00000747 "    *_paths = sub {"
NSQ_SOURCE_LINE 00000748 "        my @paths = map {"
NSQ_SOURCE_LINE 00000749 "            s#^file:////(?!/)#smb://#;"
NSQ_SOURCE_LINE 00000750 "            $_;"
NSQ_SOURCE_LINE 00000751 "        } @_;"
NSQ_SOURCE_LINE 00000752 "        map {"
NSQ_SOURCE_LINE 00000753 "            s#^/+([a-z]:/)#$1#i;"
NSQ_SOURCE_LINE 00000754 "            $_;"
NSQ_SOURCE_LINE 00000755 "        } &$_paths(@paths);"
NSQ_SOURCE_LINE 00000756 "    };"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "    # Wrap _uris() to remove '\\' in path"
NSQ_SOURCE_LINE 00000759 "    my $_uris = \\&_uris;"
NSQ_SOURCE_LINE 00000760 "    *_uris = sub {"
NSQ_SOURCE_LINE 00000761 "        map {"
NSQ_SOURCE_LINE 00000762 "            s#\\\\#/#g;"
NSQ_SOURCE_LINE 00000763 "            $_;"
NSQ_SOURCE_LINE 00000764 "        } &$_uris(@_);"
NSQ_SOURCE_LINE 00000765 "    };"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "    # Using Win32::Process because fork is not native on win32"
NSQ_SOURCE_LINE 00000768 "    # Effect is that closing an application spawned with fork"
NSQ_SOURCE_LINE 00000769 "    # can kill the parent process as well when using Gtk2"
NSQ_SOURCE_LINE 00000770 "    *run = sub {"
NSQ_SOURCE_LINE 00000771 "        my ($self, @files) = @_;"
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "        my $cmd = eval { $self->parse_Exec(@files) };"
NSQ_SOURCE_LINE 00000774 "        warn $@ if $@; # run should not die"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "        my $bin = (_split($cmd))[0];"
NSQ_SOURCE_LINE 00000777 "        unless (-f $bin) { # we need the real binary path"
NSQ_SOURCE_LINE 00000778 "            my ($b) = grep {-f $_}"
NSQ_SOURCE_LINE 00000779 "                     map File::Spec->catfile($_, $bin),"
NSQ_SOURCE_LINE 00000780 "                     split /[:;]/, $ENV{PATH} ;"
NSQ_SOURCE_LINE 00000781 "            if (-f $b) { $bin = $b }"
NSQ_SOURCE_LINE 00000782 "            else {"
NSQ_SOURCE_LINE 00000783 "                warn \"Could not find application: $bin\\n\";"
NSQ_SOURCE_LINE 00000784 "                return;"
NSQ_SOURCE_LINE 00000785 "            }"
NSQ_SOURCE_LINE 00000786 "        }"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "        my $dir = $self->get('Path') || '.';"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "        if ($VERBOSE) {"
NSQ_SOURCE_LINE 00000791 "                warn \"Running from directory: $dir\" unless $dir eq '.';"
NSQ_SOURCE_LINE 00000792 "                warn \"Running: $cmd\\n\";"
NSQ_SOURCE_LINE 00000793 "        }"
NSQ_SOURCE_LINE 00000794 "        my $obj;"
NSQ_SOURCE_LINE 00000795 "        eval {"
NSQ_SOURCE_LINE 00000796 "            Win32::Process::Create("
NSQ_SOURCE_LINE 00000797 "                $obj, $bin, $cmd, 0, &NORMAL_PRIORITY_CLASS, $dir );"
NSQ_SOURCE_LINE 00000798 "        };"
NSQ_SOURCE_LINE 00000799 "        warn $@ if $@;"
NSQ_SOURCE_LINE 00000800 "        return $obj;"
NSQ_SOURCE_LINE 00000801 "    };"
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "}"
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "1;"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "__END__"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "If you try to exec a remote file with an application that can only handle files"
NSQ_SOURCE_LINE 00000812 "on the local file system we should -according to the spec- download the file to"
NSQ_SOURCE_LINE 00000813 "a temp location. This is not supported. Use the C<wants_uris()> method to check"
NSQ_SOURCE_LINE 00000814 "if an application supports urls."
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 "The values of the various Desktop Entry keys are not parsed (except for the"
NSQ_SOURCE_LINE 00000817 "Exec key). This means that booleans will be returned as the strings \"true\" and"
NSQ_SOURCE_LINE 00000818 "\"false\" and lists will still be \";\" separated."
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "If the icon is given as name and not as path it should be resolved for the C<%i>"
NSQ_SOURCE_LINE 00000821 "code in the Exec key. We need a separate module for the icon spec to deal with"
NSQ_SOURCE_LINE 00000822 "this."
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "According to the spec comments can contain any encoding. However since this"
NSQ_SOURCE_LINE 00000825 "module read files as utf8, invalid UTF-8 characters in a comment will cause"
NSQ_SOURCE_LINE 00000826 "an error."
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "There is no support for Legacy-Mixed Encoding. Everybody is using utf8 now"
NSQ_SOURCE_LINE 00000829 "... right ?"
NSQ_SOURCE_LINE 00000830 ""
