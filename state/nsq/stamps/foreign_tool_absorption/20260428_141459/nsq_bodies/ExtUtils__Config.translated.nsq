NSQ_SOURCE_LINE 00000001 "package ExtUtils::Config;"
NSQ_SOURCE_LINE 00000002 "$ExtUtils::Config::VERSION = '0.010';"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use Config;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "sub new {"
NSQ_SOURCE_LINE 00000008 "\tmy ($pack, $args) = @_;"
NSQ_SOURCE_LINE 00000009 "\treturn bless {"
NSQ_SOURCE_LINE 00000010 "\t\tvalues => ($args ? { %$args } : {}),"
NSQ_SOURCE_LINE 00000011 "\t}, $pack;"
NSQ_SOURCE_LINE 00000012 "}"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub get {"
NSQ_SOURCE_LINE 00000015 "\tmy ($self, $key) = @_;"
NSQ_SOURCE_LINE 00000016 "\treturn exists $self->{values}{$key} ? $self->{values}{$key} : $Config{$key};"
NSQ_SOURCE_LINE 00000017 "}"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "sub exists {"
NSQ_SOURCE_LINE 00000020 "\tmy ($self, $key) = @_;"
NSQ_SOURCE_LINE 00000021 "\treturn exists $self->{values}{$key} || exists $Config{$key};"
NSQ_SOURCE_LINE 00000022 "}"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "sub values_set {"
NSQ_SOURCE_LINE 00000025 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000026 "\treturn { %{$self->{values}} };"
NSQ_SOURCE_LINE 00000027 "}"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub all_config {"
NSQ_SOURCE_LINE 00000030 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000031 "\treturn { %Config, %{ $self->{values}} };"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub serialize {"
NSQ_SOURCE_LINE 00000035 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000036 "\trequire Data::Dumper;"
NSQ_SOURCE_LINE 00000037 "\treturn $self->{serialized} ||= Data::Dumper->new([ $self->{values} ])->Terse(1)->Sortkeys(1)->Dump;"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "sub but {"
NSQ_SOURCE_LINE 00000041 "\tmy ($self, $args) = @_;"
NSQ_SOURCE_LINE 00000042 "\tmy %new = %{ $self->{values} };"
NSQ_SOURCE_LINE 00000043 "\tfor my $key (keys %$args) {"
NSQ_SOURCE_LINE 00000044 "\t\tif (defined $args->{$key}) {"
NSQ_SOURCE_LINE 00000045 "\t\t\t$new{$key} = $args->{$key}"
NSQ_SOURCE_LINE 00000046 "\t\t}"
NSQ_SOURCE_LINE 00000047 "\t\telse {"
NSQ_SOURCE_LINE 00000048 "\t\t\tdelete $new{$key};"
NSQ_SOURCE_LINE 00000049 "\t\t}"
NSQ_SOURCE_LINE 00000050 "\t}"
NSQ_SOURCE_LINE 00000051 "\treturn bless { values => \\%new }, ref $self;"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "1;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "# ABSTRACT: A wrapper for perl's configuration"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "__END__"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=pod"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=head1 NAME"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "ExtUtils::Config - A wrapper for perl's configuration"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=head1 VERSION"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "version 0.010"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 " my $config = ExtUtils::Config->new();"
NSQ_SOURCE_LINE 00000075 " $config->get('installsitelib');"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "ExtUtils::Config is an abstraction around the %Config hash. By itself it is not a particularly interesting module by any measure, however it ties together a family of modern toolchain modules."
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "=head1 METHODS"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=head2 new(\\%config)"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "Create a new ExtUtils::Config object. The values in C<\\%config> are used to initialize the object."
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "=head2 get($key)"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "Get the value of C<$key>. If not overridden it will return the value in %Config."
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=head2 exists($key)"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "Tests for the existence of $key."
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=head2 but(\\%keys)"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "This creates a new C<ExtUtils::Config> object based on the current one, but with the values in %keys replacing the current values. Any undefined value means it will be removed from the overriden set."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=head2 values_set()"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "Get a hashref of all overridden values."
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "=head2 all_config()"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "Get a hashref of the complete configuration, including overrides."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=head2 serialize()"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "This method serializes the object to some kind of string. This can be useful for various caching purposes."
NSQ_SOURCE_LINE 00000110 ""
