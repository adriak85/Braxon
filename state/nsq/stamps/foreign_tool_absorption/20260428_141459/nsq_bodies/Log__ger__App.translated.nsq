BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Log::ger::App;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000007 "our $DATE = '2024-01-22'; # DATE"
NSQ_SOURCE_LINE 00000008 "our $DIST = 'Log-ger-App'; # DIST"
NSQ_SOURCE_LINE 00000009 "our $VERSION = '0.025'; # VERSION"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our $DEBUG = defined($ENV{LOG_GER_APP_DEBUG}) ? $ENV{LOG_GER_APP_DEBUG} : 0;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "# last import args"
NSQ_SOURCE_LINE 00000014 "our @IMPORT_ARGS;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub _set_level {"
NSQ_SOURCE_LINE 00000017 "    my $name = shift;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    while (my ($source, $param, $note) = splice @_, 0, 3) {"
NSQ_SOURCE_LINE 00000020 "        if ($source eq 'val') {"
NSQ_SOURCE_LINE 00000021 "            if (defined $param) {"
NSQ_SOURCE_LINE 00000022 "                warn \"[lga] Setting $name to $param (from $note)\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000023 "                return $param;"
NSQ_SOURCE_LINE 00000024 "            }"
NSQ_SOURCE_LINE 00000025 "        } elsif ($source eq 'envset') {"
NSQ_SOURCE_LINE 00000026 "            my $prefix = $param;"
NSQ_SOURCE_LINE 00000027 "            if (defined $ENV{\"${prefix}LOG_LEVEL\"}) {"
NSQ_SOURCE_LINE 00000028 "                my $val = $ENV{\"${prefix}LOG_LEVEL\"};"
NSQ_SOURCE_LINE 00000029 "                warn \"[lga] Setting $name to $val (from environment ${prefix}LOG_LEVEL)\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000030 "                return $val;"
NSQ_SOURCE_LINE 00000031 "            }"
NSQ_SOURCE_LINE 00000032 "            if ($ENV{\"${prefix}TRACE\"}) {"
NSQ_SOURCE_LINE 00000033 "                warn \"[lga] Setting $name to trace (from environment ${prefix}TRACE)\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000034 "                return 'trace';"
NSQ_SOURCE_LINE 00000035 "            }"
NSQ_SOURCE_LINE 00000036 "            if ($ENV{\"${prefix}DEBUG\"}) {"
NSQ_SOURCE_LINE 00000037 "                warn \"[lga] Setting $name to debug (from environment ${prefix}DEBUG)\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000038 "                return 'debug';"
NSQ_SOURCE_LINE 00000039 "            }"
NSQ_SOURCE_LINE 00000040 "            if ($ENV{\"${prefix}VERBOSE\"}) {"
NSQ_SOURCE_LINE 00000041 "                warn \"[lga] Setting $name to info (from environment ${prefix}VERBOSE)\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000042 "                return 'info';"
NSQ_SOURCE_LINE 00000043 "            }"
NSQ_SOURCE_LINE 00000044 "            if ($ENV{\"${prefix}QUIET\"}) {"
NSQ_SOURCE_LINE 00000045 "                warn \"[lga] Setting $name to trace (from environment ${prefix}QUIET)\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000046 "                return 'error';"
NSQ_SOURCE_LINE 00000047 "            }"
NSQ_SOURCE_LINE 00000048 "        } else {"
NSQ_SOURCE_LINE 00000049 "            die \"BUG: Unknown level source '$source'\";"
NSQ_SOURCE_LINE 00000050 "        }"
NSQ_SOURCE_LINE 00000051 "    }"
NSQ_SOURCE_LINE 00000052 "    'warn';"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "sub _is_daemon {"
NSQ_SOURCE_LINE 00000056 "    return $main::IS_DAEMON if defined $main::IS_DAEMON;"
NSQ_SOURCE_LINE 00000057 "    for ("
NSQ_SOURCE_LINE 00000058 "        \"App/Daemon.pm\","
NSQ_SOURCE_LINE 00000059 "        \"Daemon/Easy.pm\","
NSQ_SOURCE_LINE 00000060 "        \"Daemon/Daemonize.pm\","
NSQ_SOURCE_LINE 00000061 "        \"Daemon/Generic.pm\","
NSQ_SOURCE_LINE 00000062 "        \"Daemonise.pm\","
NSQ_SOURCE_LINE 00000063 "        \"Daemon/Simple.pm\","
NSQ_SOURCE_LINE 00000064 "        \"HTTP/Daemon.pm\","
NSQ_SOURCE_LINE 00000065 "        \"IO/Socket/INET/Daemon.pm\","
NSQ_SOURCE_LINE 00000066 "        #\"Mojo/Server/Daemon.pm\", # simply loading Mojo::UserAgent will load this too"
NSQ_SOURCE_LINE 00000067 "        \"MooseX/Daemonize.pm\","
NSQ_SOURCE_LINE 00000068 "        \"Net/Daemon.pm\","
NSQ_SOURCE_LINE 00000069 "        \"Net/Server.pm\","
NSQ_SOURCE_LINE 00000070 "        \"Proc/Daemon.pm\","
NSQ_SOURCE_LINE 00000071 "        \"Proc/PID/File.pm\","
NSQ_SOURCE_LINE 00000072 "        \"Win32/Daemon/Simple.pm\") {"
NSQ_SOURCE_LINE 00000073 "        return 1 if $INC{$_};"
NSQ_SOURCE_LINE 00000074 "    }"
NSQ_SOURCE_LINE 00000075 "    0;"
NSQ_SOURCE_LINE 00000076 "}"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "sub import {"
NSQ_SOURCE_LINE 00000079 "    no warnings 'once'; # $Log::ger::Current_Level"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    my ($pkg, %args) = @_;"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "    require Log::ger;"
NSQ_SOURCE_LINE 00000084 "    require Log::ger::Util;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    my $extra_conf = delete $args{extra_conf};"
NSQ_SOURCE_LINE 00000087 "    my $level_arg = delete $args{level};"
NSQ_SOURCE_LINE 00000088 "    my $default_level_arg = delete $args{default_level};"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    my $default_level_var_name = delete($args{default_level_var_name});"
NSQ_SOURCE_LINE 00000091 "    $default_level_var_name = \"Default_Log_Level\" unless defined $default_level_var_name;"
NSQ_SOURCE_LINE 00000092 "    $default_level_var_name = \"main::$default_level_var_name\" unless $default_level_var_name =~ /::/;"
NSQ_SOURCE_LINE 00000093 "    my $default_level_var_value = do {"
NSQ_SOURCE_LINE 00000094 "        no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000095 "        ${\"$default_level_var_name\"};"
NSQ_SOURCE_LINE 00000096 "    };"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    my $level = _set_level("
NSQ_SOURCE_LINE 00000099 "        \"general log level\","
NSQ_SOURCE_LINE 00000100 "        val => $level_arg, \"import argument 'level'\","
NSQ_SOURCE_LINE 00000101 "        envset => \"\", \"\","
NSQ_SOURCE_LINE 00000102 "        val => $default_level_arg, \"import argument 'default_level'\","
NSQ_SOURCE_LINE 00000103 "        val => $default_level_var_value, \"\\$$default_level_var_name\","
NSQ_SOURCE_LINE 00000104 "        val => 'warn', \"fallback value\","
NSQ_SOURCE_LINE 00000105 "    );"
NSQ_SOURCE_LINE 00000106 "    $Log::ger::Current_Level = Log::ger::Util::numeric_level($level);"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "    my $is_daemon = delete $args{daemon};"
NSQ_SOURCE_LINE 00000109 "    $is_daemon = _is_daemon() if !defined($is_daemon);"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    my $is_oneliner = $0 eq '-e';"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "    my $progname = delete $args{name};"
NSQ_SOURCE_LINE 00000114 "    unless (defined $progname) {"
NSQ_SOURCE_LINE 00000115 "        ($progname = $0) =~ s!.+/!!;"
NSQ_SOURCE_LINE 00000116 "        $progname =~ s/\\.pl$//;"
NSQ_SOURCE_LINE 00000117 "    }"
NSQ_SOURCE_LINE 00000118 "    unless (length $progname) {"
NSQ_SOURCE_LINE 00000119 "        $progname = \"prog\";"
NSQ_SOURCE_LINE 00000120 "    }"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    # configuration for Log::ger::Output::Composite"
NSQ_SOURCE_LINE 00000123 "    my %conf = ("
NSQ_SOURCE_LINE 00000124 "        outputs => {},"
NSQ_SOURCE_LINE 00000125 "        %{ $extra_conf // {} },"
NSQ_SOURCE_LINE 00000126 "    );"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "    my %off_categories = ("
NSQ_SOURCE_LINE 00000129 "        # some known categories that are not normally logged to screen or"
NSQ_SOURCE_LINE 00000130 "        # (error) file log"
NSQ_SOURCE_LINE 00000131 "        #'_dumps'  => 'off', # e.g. in download-bca, download-mandiri"
NSQ_SOURCE_LINE 00000132 "        '_access' => 'off', # e.g. in WWW::PAUSE::Simple"
NSQ_SOURCE_LINE 00000133 "    );"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "    # add Screen"
NSQ_SOURCE_LINE 00000136 "    {"
NSQ_SOURCE_LINE 00000137 "        last if $is_daemon;"
NSQ_SOURCE_LINE 00000138 "        my $olevel = _set_level("
NSQ_SOURCE_LINE 00000139 "            \"screen log level\","
NSQ_SOURCE_LINE 00000140 "            envset => \"SCREEN_\", \"\","
NSQ_SOURCE_LINE 00000141 "            val => $level, \"general log level\","
NSQ_SOURCE_LINE 00000142 "        );"
NSQ_SOURCE_LINE 00000143 "        last if $olevel eq 'off';"
NSQ_SOURCE_LINE 00000144 "        my $fmt ="
NSQ_SOURCE_LINE 00000145 "            ($ENV{LOG_ADD_STACK_TRACE} ? '[stack %T] ': '')."
NSQ_SOURCE_LINE 00000146 "            ($ENV{LOG_ADD_LOCATION} ? '[location %l] ': '')."
NSQ_SOURCE_LINE 00000147 "            ($ENV{LOG_ADD_TIMESTAMP} ? '[%d] ': '')."
NSQ_SOURCE_LINE 00000148 "            ($ENV{LOG_ADD_MEMORY_INFO} ? '[vmsize %_{vmsize}K] ': '')."
NSQ_SOURCE_LINE 00000149 "            '%m';"
NSQ_SOURCE_LINE 00000150 "        $conf{outputs}{Screen} = {"
NSQ_SOURCE_LINE 00000151 "            conf   => { formatter => sub { \"$progname: $_[0]\" }, colorize_tags => 1 },"
NSQ_SOURCE_LINE 00000152 "            level  => $olevel,"
NSQ_SOURCE_LINE 00000153 "            category_level => \\%off_categories,"
NSQ_SOURCE_LINE 00000154 "            layout => [Pattern => {format => $fmt}],"
NSQ_SOURCE_LINE 00000155 "        };"
NSQ_SOURCE_LINE 00000156 "    }"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    # add File"
NSQ_SOURCE_LINE 00000159 "    {"
NSQ_SOURCE_LINE 00000160 "        my $file_name = delete $args{file_name};"
NSQ_SOURCE_LINE 00000161 "        unless (defined $file_name) {"
NSQ_SOURCE_LINE 00000162 "            $file_name = \"$progname.log\";"
NSQ_SOURCE_LINE 00000163 "        }"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "        my $file_dir  = delete $args{file_dir};"
NSQ_SOURCE_LINE 00000166 "        unless (defined $file_dir) {"
NSQ_SOURCE_LINE 00000167 "            require PERLANCAR::File::HomeDir;"
NSQ_SOURCE_LINE 00000168 "            $file_dir = $> || $^O eq 'MSWin32' ?"
NSQ_SOURCE_LINE 00000169 "                PERLANCAR::File::HomeDir::get_my_home_dir() :"
NSQ_SOURCE_LINE 00000170 "                  (-d \"/var/log\" ? \"/var/log\" : \"/\");"
NSQ_SOURCE_LINE 00000171 "        }"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "        last if $0 eq '-';"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "        my $file_path = \"$file_dir/$file_name\";"
NSQ_SOURCE_LINE 00000176 "        my $olevel = _set_level("
NSQ_SOURCE_LINE 00000177 "            \"file ($file_path) log level\","
NSQ_SOURCE_LINE 00000178 "            envset => \"FILE_\", \"\","
NSQ_SOURCE_LINE 00000179 "            val => $level, \"general log level\","
NSQ_SOURCE_LINE 00000180 "        );"
NSQ_SOURCE_LINE 00000181 "        last if $olevel eq 'off';"
NSQ_SOURCE_LINE 00000182 "        my $fmt ="
NSQ_SOURCE_LINE 00000183 "            '[pid %P] [%d] '."
NSQ_SOURCE_LINE 00000184 "            ($ENV{LOG_ADD_MEMORY_INFO} ? '[vmsize %_{vmsize}K] ': '')."
NSQ_SOURCE_LINE 00000185 "            '%m';"
NSQ_SOURCE_LINE 00000186 "        $conf{outputs}{File} = {"
NSQ_SOURCE_LINE 00000187 "            conf   => { path => $file_path },"
NSQ_SOURCE_LINE 00000188 "            level  => $olevel,"
NSQ_SOURCE_LINE 00000189 "            category_level => \\%off_categories,"
NSQ_SOURCE_LINE 00000190 "            layout => [Pattern => {format => $fmt}],"
NSQ_SOURCE_LINE 00000191 "        };"
NSQ_SOURCE_LINE 00000192 "    }"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    # add Syslog"
NSQ_SOURCE_LINE 00000195 "    {"
NSQ_SOURCE_LINE 00000196 "        last unless $is_daemon;"
NSQ_SOURCE_LINE 00000197 "        my $olevel = _set_level("
NSQ_SOURCE_LINE 00000198 "            \"syslog log level\","
NSQ_SOURCE_LINE 00000199 "            envset => \"SYSLOG_\", \"\","
NSQ_SOURCE_LINE 00000200 "            val => $level, \"general log level\","
NSQ_SOURCE_LINE 00000201 "        );"
NSQ_SOURCE_LINE 00000202 "        last if $olevel eq 'off';"
NSQ_SOURCE_LINE 00000203 "        $conf{outputs}{Syslog} = {"
NSQ_SOURCE_LINE 00000204 "            conf => { ident => $progname, facility => 'daemon' },"
NSQ_SOURCE_LINE 00000205 "            level => $olevel,"
NSQ_SOURCE_LINE 00000206 "            category_level => \\%off_categories,"
NSQ_SOURCE_LINE 00000207 "        };"
NSQ_SOURCE_LINE 00000208 "    }"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    if (my $outputs = delete $args{outputs}) {"
NSQ_SOURCE_LINE 00000211 "        for my $o (sort keys %$outputs) {"
NSQ_SOURCE_LINE 00000212 "            if ($conf{outputs}{$o}) {"
NSQ_SOURCE_LINE 00000213 "                warn \"[lga] OVERWRITING output '$o' using output from 'outputs' argument\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000214 "            } else {"
NSQ_SOURCE_LINE 00000215 "                warn \"[lga] Adding output '$o' from 'outputs' argument\\n\" if $DEBUG;"
NSQ_SOURCE_LINE 00000216 "            }"
NSQ_SOURCE_LINE 00000217 "            $conf{outputs}{$o} = $outputs->{$o};"
NSQ_SOURCE_LINE 00000218 "        }"
NSQ_SOURCE_LINE 00000219 "    }"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "    die \"Unknown argument(s): \".join(\", \", sort keys %args)"
NSQ_SOURCE_LINE 00000222 "        if keys %args;"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "    # save, for those who want to check or modify"
NSQ_SOURCE_LINE 00000225 "    @IMPORT_ARGS = @_;"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    require Log::ger::Output;"
NSQ_SOURCE_LINE 00000228 "    Log::ger::Output->set('Composite', %conf);"
NSQ_SOURCE_LINE 00000229 "}"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "1;"
NSQ_SOURCE_LINE 00000232 "# ABSTRACT: An easy way to use Log::ger in applications"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "__END__"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=pod"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=head1 NAME"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "Log::ger::App - An easy way to use Log::ger in applications"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head1 VERSION"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "version 0.025"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "In your script:"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 " use Log::ger::App;"
NSQ_SOURCE_LINE 00000253 " use Your::App::Module; # your module which uses Log::ger to do its logging"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "If you also do logging in your script:"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 " use Log::ger::App;"
NSQ_SOURCE_LINE 00000258 " use Log::ger;"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 " log_warn(\"Some log ...\");"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "This module basically loads L<Log::ger::Output::Composite> with some sensible"
NSQ_SOURCE_LINE 00000265 "defaults and allows customizing some aspects via environment variable."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head2 Default outputs"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 " Code                            Screen  File                   Syslog"
NSQ_SOURCE_LINE 00000270 " ------------------------------  ------  ----                   ------"
NSQ_SOURCE_LINE 00000271 " One-liner (-e)                  y       -                      -"
NSQ_SOURCE_LINE 00000272 " Script running as normal user   y       ~/PROGNAME.log         -"
NSQ_SOURCE_LINE 00000273 " Script running as root          y       /var/log/PROGNAME.log  -"
NSQ_SOURCE_LINE 00000274 " Daemon                          -       /var/log/PROGNAME.log  y"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "=head2 Determining if script is a daemon"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "Log::ger::App assumes your script is a daemon if some daemon-related modules are"
NSQ_SOURCE_LINE 00000279 "loaded, e.g. L<App::Daemon>, L<HTTP::Daemon>, L<Net::Daemon>, etc (see the"
NSQ_SOURCE_LINE 00000280 "source code for the complete list). Alternatively, you can also set"
NSQ_SOURCE_LINE 00000281 "C<$main::IS_DAEMON> to 1 (0) to specifically state that your script is (not) a"
NSQ_SOURCE_LINE 00000282 "daemon. Or, you can set it via import argument (see L</\"import\">)."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=head2 Setting general log level"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "B<Via import argument 'level'.> You can set general log level via import"
NSQ_SOURCE_LINE 00000287 "argument C<level> (see L</\"import\">) but users of your script will not be able"
NSQ_SOURCE_LINE 00000288 "to customize it:"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 " use Log::ger::App level => 'debug'; # hard-coded to debug, not recommended"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "B<Via environment variables.> You can also set general log level from"
NSQ_SOURCE_LINE 00000293 "environment using C<LOG_LEVEL> (e.g. C<LOG_LEVEL=trace> to set level to trace or"
NSQ_SOURCE_LINE 00000294 "C<LOG_LEVEL=0> to turn off logging). Alternatively, you can set to C<trace>"
NSQ_SOURCE_LINE 00000295 "using C<TRACE=1>, or C<debug> with C<DEBUG=1>, C<info> with C<VERBOSE=1>,"
NSQ_SOURCE_LINE 00000296 "C<error> with C<QUIET=1>."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "B<Via import argument 'default_level'>. If the environment variables does not"
NSQ_SOURCE_LINE 00000299 "provide a value, next the import argument C<default_level> is consulted. This is"
NSQ_SOURCE_LINE 00000300 "the preferred method of setting default level:"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 " use Log::ger::App default_level => 'info'; # be verbose by default. unless changed by env vars"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "B<Via main package variable $main::Default_Log_Level>. The next value to be"
NSQ_SOURCE_LINE 00000305 "consulted is the main package variable C<$main::Default_Log_Level>. The name of"
NSQ_SOURCE_LINE 00000306 "the variable can be customized using the import argument"
NSQ_SOURCE_LINE 00000307 "C<default_level_var_name>. Note that you need to set the variable's value before"
NSQ_SOURCE_LINE 00000308 "loading Log::ger::App, so this does not work:"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 " use Log::ger::App;"
NSQ_SOURCE_LINE 00000311 " our $Default_Log_Level = 'info';"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "this does not also:"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 " our $Default_Log_Level = 'info';"
NSQ_SOURCE_LINE 00000316 " use Log::ger::App;"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "but this does:"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 " BEGIN { our $Default_Log_Level = 'info' }"
NSQ_SOURCE_LINE 00000321 " use Log::ger::App;"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "B<Fallback value \"warn\">. The fallback level is warn, if all the above does not"
NSQ_SOURCE_LINE 00000324 "provide a value."
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "=head2 Setting per-output log level"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "B<Via environment variables.> You can set level for each output using"
NSQ_SOURCE_LINE 00000329 "I<OUTPUT_NAME>_{C<LOG_LEVEL|TRACE|DEBUG|VERBOSE|QUIET>} environment variables."
NSQ_SOURCE_LINE 00000330 "For example, C<SCREEN_DEBUG=1> to set screen level to C<debug> or"
NSQ_SOURCE_LINE 00000331 "C<FILE_LOG_LEVEL=off> to turn off file logging."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "B<General level.> If the environment variables do not provide a value, the"
NSQ_SOURCE_LINE 00000334 "general level (see L</\"Setting general log level\">) will be used."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "=head2 Showing timestamp"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "Timestamps are shown in log files. On the screen, timestamps are not shown by"
NSQ_SOURCE_LINE 00000339 "default. To show timestamps on the screen, set C<LOG_ADD_TIMESTAMP> to true. For"
NSQ_SOURCE_LINE 00000340 "example, when timestamps are not shown:"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 " myprog: First log message"
NSQ_SOURCE_LINE 00000343 " myprog: Doing task 1 ..."
NSQ_SOURCE_LINE 00000344 " myprog: Doing task 2 ..."
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "When timestamps are shown:"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 " myprog: [2018-08-30T15:14:50] First log message"
NSQ_SOURCE_LINE 00000349 " myprog: [2018-08-30T15:14:50] Doing task 1 ..."
NSQ_SOURCE_LINE 00000350 " myprog: [2018-08-30T15:15:01] Doing task 2 ..."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=head2 import"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "Usage:"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 " $pkg->import(%args)"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "Arguments:"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "=over"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "=item * level"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "str|num. Explicitly set a hard-coded level. Not recommended because of lack of"
NSQ_SOURCE_LINE 00000367 "flexibility. See instead: L</default_level>."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=item * default_level"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "str|num. Instead of hard-coding level with L</level>, you can set a default"
NSQ_SOURCE_LINE 00000372 "level. Environment variables will be consulted first (as described in"
NSQ_SOURCE_LINE 00000373 "L</DESCRIPTION>) before falling back to this level."
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=item * default_level_var_name"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "str. Optional. Name of scalar variable (without the sigil) to be consulted for"
NSQ_SOURCE_LINE 00000378 "the default level (after the C<default_level> import argument). If the name of"
NSQ_SOURCE_LINE 00000379 "the variable does not contain package name, it will be assumed to be in the"
NSQ_SOURCE_LINE 00000380 "\"main\" package. The default value is C<main::Default_Log_Level>."
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=item * name"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "str. Explicitly set program name. Otherwise, default will be taken from C<$0>"
NSQ_SOURCE_LINE 00000385 "(after path and '.pl' suffix is removed) or set to C<prog>."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "Program name will be shown on the screen, e.g.:"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 " myprog: First log message"
NSQ_SOURCE_LINE 00000390 " myprog: Doing task 1 ..."
NSQ_SOURCE_LINE 00000391 " myprog: Doing task 2 ..."
NSQ_SOURCE_LINE 00000392 " myprog: Exiting ..."
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "=item * file_name"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "str. Explicitly set log filename. By default, filename will be set to"
NSQ_SOURCE_LINE 00000397 "I<name>.log."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=item * file_dir"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "str. Explicitly set log file's directory. By default, it is user's home (if not"
NSQ_SOURCE_LINE 00000402 "running as root), or F</var/log> (if running as root)."
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "=item * daemon"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "bool. Explicitly tell Log::ger::App that your application is a daemon or not."
NSQ_SOURCE_LINE 00000407 "Otherwise, Log::ger::App will try some heuristics to guess whether your"
NSQ_SOURCE_LINE 00000408 "application is a daemon: from the value of C<$main::IS_DAEMON> and from the"
NSQ_SOURCE_LINE 00000409 "presence of modules like L<HTTP::Daemon>, L<Proc::Daemon>, etc."
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=item * outputs"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "hash. Specify extra outputs. Will be added to L<Log::ger::Output::Composite>'s"
NSQ_SOURCE_LINE 00000414 "C<outputs> configuration."
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "Example:"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 " outputs => {"
NSQ_SOURCE_LINE 00000419 "     DirWriteRotate => {"
NSQ_SOURCE_LINE 00000420 "         conf => {dir=>'/home/ujang/log', max_size=>10_000},"
NSQ_SOURCE_LINE 00000421 "         level => 'off',"
NSQ_SOURCE_LINE 00000422 "         category_level => {Dump => 'info'},"
NSQ_SOURCE_LINE 00000423 "     },"
NSQ_SOURCE_LINE 00000424 " },"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=item * extra_conf"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "Hash. Specify extra configuration, will be added to"
NSQ_SOURCE_LINE 00000429 "L<Log::ger::Output::Composite>'s configuration."
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "Example:"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 " extra_conf => {"
NSQ_SOURCE_LINE 00000434 "     category_level => {Dump => 'off'},"
NSQ_SOURCE_LINE 00000435 " },"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=back"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "=head1 VARIABLES"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=head2 $DEBUG"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "Default is false. If set to true, will show more details about how log level,"
NSQ_SOURCE_LINE 00000444 "etc is set."
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "=head2 @IMPORT_ARGS"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "Will be set with the last aguments passed to import(), for informational"
NSQ_SOURCE_LINE 00000449 "purposes."
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "=head2 LOG_GER_APP_DEBUG"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "Used to set the default for C<$DEBUG>."
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "=head2 LOG_ADD_LOCATION"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "Boolean. Default to false. If set to true, will add location to the log:"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 " [file /some/path.pm:123]"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "=head2 LOG_ADD_STACK_TRACE"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "Boolean. Default to false. If set to true, will add stack trace to the log:"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 " [stack ...]"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=head2 LOG_ADD_TIMESTAMP"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "Boolean. Default to false. If set to true, will add timestamps to the screen"
NSQ_SOURCE_LINE 00000472 "log. Normally, timestamps will only be added to the file log."
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=head2 LOG_ADD_MEMORY_INFO"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "Boolean. Default to false. If set to true, will add memory info to log (see"
NSQ_SOURCE_LINE 00000477 "C<%_{vmtime}> pattern in L<Log::ger::Layout::Pattern>)."
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "=head2 LOG_LEVEL"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "String. Can be set to C<off> or numeric/string log level."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "=head2 TRACE"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "Bool."
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=head2 DEBUG"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "Bool."
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "=head2 VERBOSE"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "Bool."
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "=head2 QUIET"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "Bool."
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "=head2 SCREEN_LOG_LEVEL"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=head2 SCREEN_TRACE"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "=head2 SCREEN_DEBUG"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=head2 SCREEN_VERBOSE"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "=head2 SCREEN_QUIET"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=head2 FILE_LOG_LEVEL"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=head2 FILE_TRACE"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "=head2 FILE_DEBUG"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "=head2 FILE_VERBOSE"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=head2 FILE_QUIET"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "=head2 SYSLOG_LOG_LEVEL"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "=head2 SYSLOG_TRACE"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "=head2 SYSLOG_DEBUG"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "=head2 SYSLOG_VERBOSE"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "=head2 SYSLOG_QUIET"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=head1 FAQS"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "=head2 How do I turn off file logging?"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "By default, file logging is on unless running as a Perl one-liner (under"
NSQ_SOURCE_LINE 00000534 "C<perl>'s C<-e>)."
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "To explicitly turn file logging off, you can set I<FILE_LEVEL> environment"
NSQ_SOURCE_LINE 00000537 "variable to C<off>, for example:"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 " BEGIN { $ENV{FILE_LEVEL} //= \"off\" }"
NSQ_SOURCE_LINE 00000540 " use Log::ger::App;"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "=head2 How do I turn off screen logging?"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "By default, screen logging is on unless script is a daemon."
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "To explicitly turn screen logging off, you can set I<SCREEN_LEVEL> environment"
NSQ_SOURCE_LINE 00000547 "variable to C<off>, for example:"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 " BEGIN { $ENV{SCREEN_LEVEL} //= \"off\" }"
NSQ_SOURCE_LINE 00000550 " use Log::ger::App;"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "=head2 How do I turn off syslog logging?"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "By default, syslog logging is on if script is a daemon."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "To explicitly turn syslog logging off, you can set I<SYSLOG_LEVEL> environment"
NSQ_SOURCE_LINE 00000557 "variable to C<off>, for example:"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 " BEGIN { $ENV{SYSLOG_LEVEL} //= \"off\" }"
NSQ_SOURCE_LINE 00000560 " use Log::ger::App;"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "=head2 Why doesn't setting $main::Default_Log_Level work?"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "Note that you need to set the variable's value before loading Log::ger::App, so"
NSQ_SOURCE_LINE 00000565 "this does not work:"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 " use Log::ger::App;"
NSQ_SOURCE_LINE 00000568 " our $Default_Log_Level = 'info';"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "this does not also:"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 " our $Default_Log_Level = 'info';"
NSQ_SOURCE_LINE 00000573 " use Log::ger::App;"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "but this does:"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 " BEGIN { our $Default_Log_Level = 'info' }"
NSQ_SOURCE_LINE 00000578 " use Log::ger::App;"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "=head2 Why doesn't re-setting log level using Log::ger::Util::set_level() work?"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "(This FAQ item is from L<Log::ger::Output::Composite>'s, slightly modified)."
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "The Log::ger::Output::Composite plugin that Log::ger::App uses sets its own"
NSQ_SOURCE_LINE 00000585 "levels and logs using a multilevel routine (which gets called for all levels)."
NSQ_SOURCE_LINE 00000586 "Re-setting log level dynamically via L<Log::ger::Util>'s C<set_level> will not"
NSQ_SOURCE_LINE 00000587 "work as intended, which is fortunate or unfortunate depending on your need."
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "If you want to override all levels settings with a single value, you can use"
NSQ_SOURCE_LINE 00000590 "C<Log::ger::Output::Composite::set_level>, for example:"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 " Log::ger::Util::set_level('trace'); # also set this too"
NSQ_SOURCE_LINE 00000593 " Log::ger::Output::Composite::set_level('trace');"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "This sets an internal level setting which is respected and has the highest"
NSQ_SOURCE_LINE 00000596 "precedence so all levels settings will use this instead. If previously you have:"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 " Log::ger::Output->set(Composite => ("
NSQ_SOURCE_LINE 00000599 "     outputs => {"
NSQ_SOURCE_LINE 00000600 "         File   => {conf=>{path=>'/foo'}, level=>'debug'},"
NSQ_SOURCE_LINE 00000601 "         Screen => {level=>'info', category_level=>{MyApp=>'warn'}},"
NSQ_SOURCE_LINE 00000602 "     },"
NSQ_SOURCE_LINE 00000603 "     category_level => {"
NSQ_SOURCE_LINE 00000604 "         'MyApp::SubModule1' => 'debug',"
NSQ_SOURCE_LINE 00000605 "     },"
NSQ_SOURCE_LINE 00000606 " ));"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "then after the C<Log::ger::Output::Composite::set_level('trace')>, all the above"
NSQ_SOURCE_LINE 00000609 "per-category and per-output levels will be set to C<trace>."
NSQ_SOURCE_LINE 00000610 ""
