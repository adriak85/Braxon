NSQ_SOURCE_LINE 00000005 "package Regexp::Util;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $AUTHORITY = 'cpan:TOBYINK';"
NSQ_SOURCE_LINE 00000008 "our $VERSION   = '0.005';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "require XSLoader;"
NSQ_SOURCE_LINE 00000011 "XSLoader::load(__PACKAGE__, $VERSION);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "eval 'require re';"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "require Exporter::Tiny;"
NSQ_SOURCE_LINE 00000016 "our @ISA = qw( Exporter::Tiny );"
NSQ_SOURCE_LINE 00000017 "our @EXPORT;"
NSQ_SOURCE_LINE 00000018 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000019 "\tis_regexp"
NSQ_SOURCE_LINE 00000020 "\tregexp_seen_evals"
NSQ_SOURCE_LINE 00000021 "\tregexp_is_foreign"
NSQ_SOURCE_LINE 00000022 "\tserialize_regexp"
NSQ_SOURCE_LINE 00000023 "\tdeserialize_regexp"
NSQ_SOURCE_LINE 00000024 "\t"
NSQ_SOURCE_LINE 00000025 "\tregexp_pattern regmust regname regnames regnames_count"
NSQ_SOURCE_LINE 00000026 ");"
NSQ_SOURCE_LINE 00000027 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000028 "\tall     => \\@EXPORT_OK,"
NSQ_SOURCE_LINE 00000029 "\tdefault => \\@EXPORT,"
NSQ_SOURCE_LINE 00000030 ");"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub regexp_is_foreign"
NSQ_SOURCE_LINE 00000033 "{"
NSQ_SOURCE_LINE 00000034 "\t_regexp_engine_id($_[0]) != _regexp_engine_id(qr//);"
NSQ_SOURCE_LINE 00000035 "}"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub serialize_regexp"
NSQ_SOURCE_LINE 00000038 "{"
NSQ_SOURCE_LINE 00000039 "\tmy $re = shift;"
NSQ_SOURCE_LINE 00000040 "\t"
NSQ_SOURCE_LINE 00000041 "\tif (not is_regexp($re))"
NSQ_SOURCE_LINE 00000042 "\t{"
NSQ_SOURCE_LINE 00000043 "\t\trequire Carp;"
NSQ_SOURCE_LINE 00000044 "\t\tCarp::croak(\"Cannot serialize non-regexp\");"
NSQ_SOURCE_LINE 00000045 "\t}"
NSQ_SOURCE_LINE 00000046 "\t"
NSQ_SOURCE_LINE 00000047 "\tif (regexp_seen_evals($re))"
NSQ_SOURCE_LINE 00000048 "\t{"
NSQ_SOURCE_LINE 00000049 "\t\trequire Carp;"
NSQ_SOURCE_LINE 00000050 "\t\tCarp::croak(\"Cannot serialize regexp containing evals\");"
NSQ_SOURCE_LINE 00000051 "\t}"
NSQ_SOURCE_LINE 00000052 "\t"
NSQ_SOURCE_LINE 00000053 "\tif (regexp_is_foreign($re))"
NSQ_SOURCE_LINE 00000054 "\t{"
NSQ_SOURCE_LINE 00000055 "\t\trequire Carp;"
NSQ_SOURCE_LINE 00000056 "\t\tCarp::croak(\"Cannot serialize regexp using plugin re engine\");"
NSQ_SOURCE_LINE 00000057 "\t}"
NSQ_SOURCE_LINE 00000058 "\t"
NSQ_SOURCE_LINE 00000059 "\tmy $str = re::regexp_pattern($re);"
NSQ_SOURCE_LINE 00000060 "\treturn \"qr/$str/\" if $str !~ m{\\/};"
NSQ_SOURCE_LINE 00000061 "\treturn \"qr!$str!\" if $str !~ m{\\!};"
NSQ_SOURCE_LINE 00000062 "\treturn \"qr#$str#\" if $str !~ m{\\#};"
NSQ_SOURCE_LINE 00000063 "\t"
NSQ_SOURCE_LINE 00000064 "\trequire B;"
NSQ_SOURCE_LINE 00000065 "\tsprintf('do { my $re = %s; qr/$re/ }', B::perlstring($str));"
NSQ_SOURCE_LINE 00000066 "}"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "my $safe;"
NSQ_SOURCE_LINE 00000069 "sub deserialize_regexp"
NSQ_SOURCE_LINE 00000070 "{"
NSQ_SOURCE_LINE 00000071 "\tmy $str = shift;"
NSQ_SOURCE_LINE 00000072 "\t"
NSQ_SOURCE_LINE 00000073 "\tif (!defined $str or ref $str)"
NSQ_SOURCE_LINE 00000074 "\t{"
NSQ_SOURCE_LINE 00000075 "\t\trequire Carp;"
NSQ_SOURCE_LINE 00000076 "\t\tCarp::croak(\"Cannot deserialize regexp\");"
NSQ_SOURCE_LINE 00000077 "\t}"
NSQ_SOURCE_LINE 00000078 "\t"
NSQ_SOURCE_LINE 00000079 "\t$safe ||= do {"
NSQ_SOURCE_LINE 00000080 "\t\trequire Safe;"
NSQ_SOURCE_LINE 00000081 "\t\tmy $cpt = Safe->new;"
NSQ_SOURCE_LINE 00000082 "\t\t$cpt->permit(qw/ :base_core :base_mem sprintf qr /);"
NSQ_SOURCE_LINE 00000083 "\t\t$cpt;"
NSQ_SOURCE_LINE 00000084 "\t};"
NSQ_SOURCE_LINE 00000085 "\t"
NSQ_SOURCE_LINE 00000086 "\tmy $re = $safe->reval($str) or do {"
NSQ_SOURCE_LINE 00000087 "\t\t(my $e = $@) =~"
NSQ_SOURCE_LINE 00000088 "\t\t\ts/ at \\(eval \\d+\\) .+//;"
NSQ_SOURCE_LINE 00000089 "\t\tchomp $e;"
NSQ_SOURCE_LINE 00000090 "\t\trequire Carp;"
NSQ_SOURCE_LINE 00000091 "\t\tCarp::croak(\"Cannot deserialize regexp: $e\");"
NSQ_SOURCE_LINE 00000092 "\t};"
NSQ_SOURCE_LINE 00000093 "\t"
NSQ_SOURCE_LINE 00000094 "\treturn $re if is_regexp($re);"
NSQ_SOURCE_LINE 00000095 "\t"
NSQ_SOURCE_LINE 00000096 "\trequire Carp;"
NSQ_SOURCE_LINE 00000097 "\tCarp::croak(\"Cannot deserialize regexp: eval returned $re\");"
NSQ_SOURCE_LINE 00000098 "}"
NSQ_SOURCE_LINE 00000099 ""
