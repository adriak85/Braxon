NSQ_SOURCE_LINE 00000128 "=head1 NAME"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "Regexp::Util - A selection of general-utility regexp subroutines"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "   use Regexp::Util qw( :all );"
NSQ_SOURCE_LINE 00000135 "   "
NSQ_SOURCE_LINE 00000136 "   my $stringified = serialize_regexp( qr/^foo/ );"
NSQ_SOURCE_LINE 00000137 "   my $regexp      = deserialize_regexp( $stringified );"
NSQ_SOURCE_LINE 00000138 "   "
NSQ_SOURCE_LINE 00000139 "   \"foobar\" =~ $regexp;"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "This module provides the following functions:"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=over"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=item C<< is_regexp($ref) >>"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "Returns a boolean indicating whether C<< $ref >> is a regexp reference."
NSQ_SOURCE_LINE 00000150 "Is not tricked by blessed regexps."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=item C<< regexp_seen_evals($re) >>"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "Returns true if C<< $re >> contains embedded Perl code."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=item C<< regexp_is_foreign($re) >>"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "Returns true if C<< $re >> uses a regexp engine plugin."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "(Since Perl 5.10, it has been possible to use regexp engine plugins,"
NSQ_SOURCE_LINE 00000161 "such as L<re::engine::PCRE> and L<re::engine::RE2>.)"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=item C<< serialize_regexp($re) >>"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "Serializes the regexp to a string of Perl code."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "Croaks if the regexp contains embedded Perl code, or uses a regexp engine"
NSQ_SOURCE_LINE 00000168 "plugin."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "=item C<< deserialize_regexp($str) >>"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "Evaluates a string of Perl code generated by C<serialize_regexp> to"
NSQ_SOURCE_LINE 00000173 "return the original regexp object. Uses L<Safe>, and also checks that"
NSQ_SOURCE_LINE 00000174 "the return value is a regexp, so should be I<somewhat> safer than"
NSQ_SOURCE_LINE 00000175 "C<< eval($str) >>."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=back"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "This module can also re-export C<< regexp_pattern($re) >>,"
NSQ_SOURCE_LINE 00000180 "C<< regmust($re) >>, C<< regname($name, $all) >>,"
NSQ_SOURCE_LINE 00000181 "C<< regnames($all) >>, and C<< regnames_count() >> from L<re>"
NSQ_SOURCE_LINE 00000182 "for convenience."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=head1 BUGS"
NSQ_SOURCE_LINE 00000185 ""
