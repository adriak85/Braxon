NSQ_SOURCE_LINE 00000101 "\tgoto \\&re::regexp_pattern;"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub regmust {"
NSQ_SOURCE_LINE 00000105 "\tgoto \\&re::regmust;"
NSQ_SOURCE_LINE 00000106 "}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "sub regname {"
NSQ_SOURCE_LINE 00000109 "\tgoto \\&re::regname;"
NSQ_SOURCE_LINE 00000110 "}"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "sub regnames {"
NSQ_SOURCE_LINE 00000113 "\tgoto \\&re::regnames;"
NSQ_SOURCE_LINE 00000114 "}"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "sub regnames_count {"
NSQ_SOURCE_LINE 00000117 "\tgoto \\&re::regnames_count;"
NSQ_SOURCE_LINE 00000118 "}"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "1;"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "__END__"
