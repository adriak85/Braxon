BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Time::Duration;"
NSQ_SOURCE_LINE 00000002 "$Time::Duration::VERSION = '1.21';"
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use constant DEBUG => 0;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "require Exporter;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our @ISA         = ('Exporter');"
NSQ_SOURCE_LINE 00000011 "our @EXPORT      = qw( later later_exact earlier earlier_exact"
NSQ_SOURCE_LINE 00000012 "                       ago ago_exact from_now from_now_exact"
NSQ_SOURCE_LINE 00000013 "                       duration duration_exact"
NSQ_SOURCE_LINE 00000014 "                       concise"
NSQ_SOURCE_LINE 00000015 "                     );"
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK   = ('interval', @EXPORT);"
NSQ_SOURCE_LINE 00000017 "our $MILLISECOND = 0;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "# ALL SUBS ARE PURE FUNCTIONS"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub concise ($) {"
NSQ_SOURCE_LINE 00000024 "  my $string = $_[0];"
NSQ_SOURCE_LINE 00000025 "  DEBUG and print \"in : $string\\n\";"
NSQ_SOURCE_LINE 00000026 "  $string =~ tr/,//d;"
NSQ_SOURCE_LINE 00000027 "  $string =~ s/\\band\\b//;"
NSQ_SOURCE_LINE 00000028 "  $string =~ s/\\b(year|day|hour|minute|second)s?\\b/substr($1,0,1)/eg;"
NSQ_SOURCE_LINE 00000029 "  $string =~ s/\\b(millisecond)s?\\b/ms/g;"
NSQ_SOURCE_LINE 00000030 "  $string =~ s/\\s*(\\d+)\\s*/$1/g;"
NSQ_SOURCE_LINE 00000031 "  return $string;"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub later          { interval(      $_[0], $_[1], ' earlier',  ' later',    'right then'); }"
NSQ_SOURCE_LINE 00000035 "sub later_exact    { interval_exact($_[0], $_[1], ' earlier',  ' later',    'right then'); }"
NSQ_SOURCE_LINE 00000036 "sub earlier        { interval(      $_[0], $_[1], ' later',    ' earlier',  'right then'); }"
NSQ_SOURCE_LINE 00000037 "sub earlier_exact  { interval_exact($_[0], $_[1], ' later',    ' earlier',  'right then'); }"
NSQ_SOURCE_LINE 00000038 "sub ago            { interval(      $_[0], $_[1], ' from now', ' ago',      'right now');  }"
NSQ_SOURCE_LINE 00000039 "sub ago_exact      { interval_exact($_[0], $_[1], ' from now', ' ago',      'right now');  }"
NSQ_SOURCE_LINE 00000040 "sub from_now       { interval(      $_[0], $_[1], ' ago',      ' from now', 'right now');  }"
NSQ_SOURCE_LINE 00000041 "sub from_now_exact { interval_exact($_[0], $_[1], ' ago',      ' from now', 'right now');  }"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
NSQ_SOURCE_LINE 00000044 "sub duration_exact {"
NSQ_SOURCE_LINE 00000045 "  my $span = $_[0];   # interval in seconds"
NSQ_SOURCE_LINE 00000046 "  my $precision = int($_[1] || 0) || 2;  # precision (default: 2)"
NSQ_SOURCE_LINE 00000047 "  return '0 seconds' unless $span;"
NSQ_SOURCE_LINE 00000048 "  _render('',"
NSQ_SOURCE_LINE 00000049 "          _separate(abs $span));"
NSQ_SOURCE_LINE 00000050 "}"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "sub duration {"
NSQ_SOURCE_LINE 00000053 "  my $span = $_[0];   # interval in seconds"
NSQ_SOURCE_LINE 00000054 "  my $precision = int($_[1] || 0) || 2;  # precision (default: 2)"
NSQ_SOURCE_LINE 00000055 "  return '0 seconds' unless $span;"
NSQ_SOURCE_LINE 00000056 "  _render('',"
NSQ_SOURCE_LINE 00000057 "          _approximate($precision,"
NSQ_SOURCE_LINE 00000058 "                       _separate(abs $span)));"
NSQ_SOURCE_LINE 00000059 "}"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "sub interval_exact {"
NSQ_SOURCE_LINE 00000064 "  my $span = $_[0];                    # interval, in seconds"
NSQ_SOURCE_LINE 00000065 "                                       # precision is ignored"
NSQ_SOURCE_LINE 00000066 "  my $direction = ($span < 0) ? $_[2]  # what a neg number gets"
NSQ_SOURCE_LINE 00000067 "                : ($span > 0) ? $_[3]  # what a pos number gets"
NSQ_SOURCE_LINE 00000068 "                : return        $_[4]; # what zero gets"
NSQ_SOURCE_LINE 00000069 "  _render($direction,"
NSQ_SOURCE_LINE 00000070 "          _separate($span));"
NSQ_SOURCE_LINE 00000071 "}"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "sub interval {"
NSQ_SOURCE_LINE 00000074 "  my $span = $_[0];                     # interval, in seconds"
NSQ_SOURCE_LINE 00000075 "  my $precision = int($_[1] || 0) || 2; # precision (default: 2)"
NSQ_SOURCE_LINE 00000076 "  my $direction = ($span < 0) ? $_[2]   # what a neg number gets"
NSQ_SOURCE_LINE 00000077 "                : ($span > 0) ? $_[3]   # what a pos number gets"
NSQ_SOURCE_LINE 00000078 "                : return        $_[4];  # what zero gets"
NSQ_SOURCE_LINE 00000079 "  _render($direction,"
NSQ_SOURCE_LINE 00000080 "          _approximate($precision,"
NSQ_SOURCE_LINE 00000081 "                       _separate($span)));"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#~#"
NSQ_SOURCE_LINE 00000085 "#"
NSQ_SOURCE_LINE 00000086 "# The actual figuring is below here"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "use constant MINUTE => 60;"
NSQ_SOURCE_LINE 00000089 "use constant HOUR => 3600;"
NSQ_SOURCE_LINE 00000090 "use constant DAY  => 24 * HOUR;"
NSQ_SOURCE_LINE 00000091 "use constant YEAR => 365 * DAY;"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "sub _separate {"
NSQ_SOURCE_LINE 00000094 "  # Breakdown of seconds into units, starting with the most significant"
NSQ_SOURCE_LINE 00000095 "  "
NSQ_SOURCE_LINE 00000096 "  my $remainder = abs $_[0]; # remainder"
NSQ_SOURCE_LINE 00000097 "  my $this; # scratch"
NSQ_SOURCE_LINE 00000098 "  my @wheel; # retval"
NSQ_SOURCE_LINE 00000099 "  "
NSQ_SOURCE_LINE 00000100 "  # Years:"
NSQ_SOURCE_LINE 00000101 "  $this = int($remainder / (365 * 24 * 60 * 60));"
NSQ_SOURCE_LINE 00000102 "  push @wheel, ['year', $this, 1_000_000_000];"
NSQ_SOURCE_LINE 00000103 "  $remainder -= $this * (365 * 24 * 60 * 60);"
NSQ_SOURCE_LINE 00000104 "    "
NSQ_SOURCE_LINE 00000105 "  # Days:"
NSQ_SOURCE_LINE 00000106 "  $this = int($remainder / (24 * 60 * 60));"
NSQ_SOURCE_LINE 00000107 "  push @wheel, ['day', $this, 365];"
NSQ_SOURCE_LINE 00000108 "  $remainder -= $this * (24 * 60 * 60);"
NSQ_SOURCE_LINE 00000109 "    "
NSQ_SOURCE_LINE 00000110 "  # Hours:"
NSQ_SOURCE_LINE 00000111 "  $this = int($remainder / (60 * 60));"
NSQ_SOURCE_LINE 00000112 "  push @wheel, ['hour', $this, 24];"
NSQ_SOURCE_LINE 00000113 "  $remainder -= $this * (60 * 60);"
NSQ_SOURCE_LINE 00000114 "  "
NSQ_SOURCE_LINE 00000115 "  # Minutes:"
NSQ_SOURCE_LINE 00000116 "  $this = int($remainder / 60);"
NSQ_SOURCE_LINE 00000117 "  push @wheel, ['minute', $this, 60];"
NSQ_SOURCE_LINE 00000118 "  $remainder -= $this * 60;"
NSQ_SOURCE_LINE 00000119 "  "
NSQ_SOURCE_LINE 00000120 "  push @wheel, ['second', int($remainder), 60];"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "\t# Thanks to Steven Haryanto (http://search.cpan.org/~sharyanto/) for the basis of this change."
NSQ_SOURCE_LINE 00000123 "\tif ($MILLISECOND) {"
NSQ_SOURCE_LINE 00000124 "\t\t$remainder -= int($remainder);"
NSQ_SOURCE_LINE 00000125 "\t\tpush @wheel, ['millisecond', sprintf(\"%0.f\", $remainder * 1000), 1000];"
NSQ_SOURCE_LINE 00000126 "\t}"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "  return @wheel;"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
NSQ_SOURCE_LINE 00000132 "sub _approximate {"
NSQ_SOURCE_LINE 00000133 "  # Now nudge the wheels into an acceptably (im)precise configuration"
NSQ_SOURCE_LINE 00000134 "  my($precision, @wheel) = @_;"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 " Fix:"
NSQ_SOURCE_LINE 00000137 "  {"
NSQ_SOURCE_LINE 00000138 "    # Constraints for leaving this block:"
NSQ_SOURCE_LINE 00000139 "    #  1) number of nonzero wheels must be <= $precision"
NSQ_SOURCE_LINE 00000140 "    #  2) no wheels can be improperly expressed (like having \"60\" for mins)"
NSQ_SOURCE_LINE 00000141 "  "
NSQ_SOURCE_LINE 00000142 "    my $nonzero_count = 0;"
NSQ_SOURCE_LINE 00000143 "    my $improperly_expressed;"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    DEBUG and print join ' ', '#', (map \"${$_}[1] ${$_}[0]\",  @wheel), \"\\n\";"
NSQ_SOURCE_LINE 00000146 "    for(my $i = 0; $i < @wheel; $i++) {"
NSQ_SOURCE_LINE 00000147 "      my $this = $wheel[$i];"
NSQ_SOURCE_LINE 00000148 "      next if $this->[1] == 0; # Zeros require no attention."
NSQ_SOURCE_LINE 00000149 "      ++$nonzero_count;"
NSQ_SOURCE_LINE 00000150 "      next if $i == 0; # the years wheel is never improper or over any limit; skip"
NSQ_SOURCE_LINE 00000151 "      "
NSQ_SOURCE_LINE 00000152 "      if($nonzero_count > $precision) {"
NSQ_SOURCE_LINE 00000153 "        # This is one nonzero wheel too many!"
NSQ_SOURCE_LINE 00000154 "        DEBUG and print '', $this->[0], \" is one nonzero too many!\\n\";"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "        # Incr previous wheel if we're big enough:"
NSQ_SOURCE_LINE 00000157 "        if($this->[1] >= ($this->[-1] / 2)) {"
NSQ_SOURCE_LINE 00000158 "          DEBUG and printf \"incrementing %s from %s to %s\\n\","
NSQ_SOURCE_LINE 00000159 "           $wheel[$i-1][0], $wheel[$i-1][1], 1 + $wheel[$i-1][1], ;"
NSQ_SOURCE_LINE 00000160 "          ++$wheel[$i-1][1];"
NSQ_SOURCE_LINE 00000161 "        }"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "        # Reset this and subsequent wheels to 0:"
NSQ_SOURCE_LINE 00000164 "        for(my $j = $i; $j < @wheel; $j++) { $wheel[$j][1] = 0 }"
NSQ_SOURCE_LINE 00000165 "        redo Fix; # Start over."
NSQ_SOURCE_LINE 00000166 "      } elsif($this->[1] >= $this->[-1]) {"
NSQ_SOURCE_LINE 00000167 "        # It's an improperly expressed wheel.  (Like \"60\" on the mins wheel)"
NSQ_SOURCE_LINE 00000168 "        $improperly_expressed = $i;"
NSQ_SOURCE_LINE 00000169 "        DEBUG and print '', $this->[0], ' (', $this->[1], "
NSQ_SOURCE_LINE 00000170 "           \") is improper!\\n\";"
NSQ_SOURCE_LINE 00000171 "      }"
NSQ_SOURCE_LINE 00000172 "    }"
NSQ_SOURCE_LINE 00000173 "    "
NSQ_SOURCE_LINE 00000174 "    if(defined $improperly_expressed) {"
NSQ_SOURCE_LINE 00000175 "      # Only fix the least-significant improperly expressed wheel (at a time)."
NSQ_SOURCE_LINE 00000176 "      DEBUG and printf \"incrementing %s from %s to %s\\n\","
NSQ_SOURCE_LINE 00000177 "       $wheel[$improperly_expressed-1][0], $wheel[$improperly_expressed-1][1], "
NSQ_SOURCE_LINE 00000178 "        1 + $wheel[$improperly_expressed-1][1], ;"
NSQ_SOURCE_LINE 00000179 "      ++$wheel[ $improperly_expressed - 1][1];"
NSQ_SOURCE_LINE 00000180 "      $wheel[ $improperly_expressed][1] = 0;"
NSQ_SOURCE_LINE 00000181 "      # We never have a \"150\" in the minutes slot -- if it's improper,"
NSQ_SOURCE_LINE 00000182 "      #  it's only by having been rounded up to the limit."
NSQ_SOURCE_LINE 00000183 "      redo Fix; # Start over."
NSQ_SOURCE_LINE 00000184 "    }"
NSQ_SOURCE_LINE 00000185 "    "
NSQ_SOURCE_LINE 00000186 "    # Otherwise there's not too many nonzero wheels, and there's no"
NSQ_SOURCE_LINE 00000187 "    #  improperly expressed wheels, so fall thru..."
NSQ_SOURCE_LINE 00000188 "  }"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "  return @wheel;"
NSQ_SOURCE_LINE 00000191 "}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
NSQ_SOURCE_LINE 00000194 "sub _render {"
NSQ_SOURCE_LINE 00000195 "  # Make it into English"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "  my $direction = shift @_;"
NSQ_SOURCE_LINE 00000198 "  my @wheel = map"
NSQ_SOURCE_LINE 00000199 "        {;"
NSQ_SOURCE_LINE 00000200 "            (  $_->[1] == 0) ? ()  # zero wheels"
NSQ_SOURCE_LINE 00000201 "            : ($_->[1] == 1) ? \"${$_}[1] ${$_}[0]\"  # singular"
NSQ_SOURCE_LINE 00000202 "            :                  \"${$_}[1] ${$_}[0]s\" # plural"
NSQ_SOURCE_LINE 00000203 "        }"
NSQ_SOURCE_LINE 00000204 "        @_"
NSQ_SOURCE_LINE 00000205 "  ;"
NSQ_SOURCE_LINE 00000206 "  return \"just now\" unless @wheel; # sanity"
NSQ_SOURCE_LINE 00000207 "  $wheel[-1] .= $direction;"
NSQ_SOURCE_LINE 00000208 "  return $wheel[0] if @wheel == 1;"
NSQ_SOURCE_LINE 00000209 "  return \"$wheel[0] and $wheel[1]\" if @wheel == 2;"
NSQ_SOURCE_LINE 00000210 "  $wheel[-1] = \"and $wheel[-1]\";"
NSQ_SOURCE_LINE 00000211 "  return join q{, }, @wheel;"
NSQ_SOURCE_LINE 00000212 "}"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
NSQ_SOURCE_LINE 00000215 "1;"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "__END__"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "so \"1y 0d 1h 50m 50s\", N=3, so you round at minutes to \"1y 0d 1h 51m 0s\","
NSQ_SOURCE_LINE 00000220 "#That's okay, so fall thru."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "so \"1y 1d 0h 59m 50s\", N=3, so you round at minutes to \"1y 1d 0h 60m 0s\","
NSQ_SOURCE_LINE 00000223 "but that's not improperly expressed, so you loop around and get"
NSQ_SOURCE_LINE 00000224 "\"1y 1d 1h 0m 0s\", which is short enough, and is properly expressed."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=head1 NAME"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "Time::Duration - rounded or exact English expression of durations"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "Example use in a program that ends by noting its runtime:"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "  my $start_time = time();"
NSQ_SOURCE_LINE 00000235 "  use Time::Duration;"
NSQ_SOURCE_LINE 00000236 "  "
NSQ_SOURCE_LINE 00000237 "  # then things that take all that time, and then ends:"
NSQ_SOURCE_LINE 00000238 "  print \"Runtime \", duration(time() - $start_time), \".\\n\";"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "Example use in a program that reports age of a file:"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "  use Time::Duration;"
NSQ_SOURCE_LINE 00000243 "  my $file = 'that_file';"
NSQ_SOURCE_LINE 00000244 "  my $age = $^T - (stat($file))[9];  # 9 = modtime"
NSQ_SOURCE_LINE 00000245 "  print \"$file was modified \", ago($age);"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "This module provides functions for expressing durations in rounded or exact"
NSQ_SOURCE_LINE 00000250 "terms."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "In the first example in the Synopsis, using duration($interval_seconds):"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "If the C<time() - $start_time> is 3 seconds, this prints"
NSQ_SOURCE_LINE 00000256 "\"Runtime: B<3 seconds>.\".  If it's 0 seconds, it's \"Runtime: B<0 seconds>.\"."
NSQ_SOURCE_LINE 00000257 "If it's 1 second, it's \"Runtime: B<1 second>.\".  If it's 125 seconds, you"
NSQ_SOURCE_LINE 00000258 "get \"Runtime: B<2 minutes and 5 seconds>.\".  If it's 3820 seconds (which"
NSQ_SOURCE_LINE 00000259 "is exactly 1h, 3m, 40s), you get it rounded to fit within two expressed"
NSQ_SOURCE_LINE 00000260 "units: \"Runtime: B<1 hour and 4 minutes>.\".  Using duration_exact instead"
NSQ_SOURCE_LINE 00000261 "would return \"Runtime: B<1 hour, 3 minutes, and 40 seconds>\"."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "In the second example in the Synopsis, using ago($interval_seconds):"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "If the $age is 3 seconds, this prints"
NSQ_SOURCE_LINE 00000266 "\"I<file> was modified B<3 seconds ago>\".  If it's 0 seconds, it's"
NSQ_SOURCE_LINE 00000267 "\"I<file> was modified B<just now>\", as a special case.  If it's 1 second,"
NSQ_SOURCE_LINE 00000268 "it's \"from B<1 second ago>\".  If it's 125 seconds, you get \"I<file> was"
NSQ_SOURCE_LINE 00000269 "modified B<2 minutes and 5 seconds ago>\".  If it's 3820 seconds (which"
NSQ_SOURCE_LINE 00000270 "is exactly 1h, 3m, 40s), you get it rounded to fit within two expressed"
NSQ_SOURCE_LINE 00000271 "units: \"I<file> was modified B<1 hour and 4 minutes ago>\".  "
NSQ_SOURCE_LINE 00000272 "Using ago_exact instead"
NSQ_SOURCE_LINE 00000273 "would return \"I<file> was modified B<1 hour, 3 minutes, and 40 seconds"
NSQ_SOURCE_LINE 00000274 "ago>\".  And if the file's"
NSQ_SOURCE_LINE 00000275 "modtime is, surprisingly, three seconds into the future, $age is -3,"
NSQ_SOURCE_LINE 00000276 "and you'll get the equally and appropriately surprising"
NSQ_SOURCE_LINE 00000277 "\"I<file> was modified B<3 seconds from now>.\""
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=head1 MILLISECOND MODE"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "By default, this module assumes input is an integer representing number"
NSQ_SOURCE_LINE 00000282 "of seconds and only emits results based on the integer part of any"
NSQ_SOURCE_LINE 00000283 "floating-point values passed to it.  However, if you set the variable"
NSQ_SOURCE_LINE 00000284 "C<$Time::Duration::MILLISECOND> to any true value, then the methods will"
NSQ_SOURCE_LINE 00000285 "interpret inputs as floating-point numbers and will emit results containing"
NSQ_SOURCE_LINE 00000286 "information about the number of milliseconds in the value."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "For example, C<duration(1.021)> will return B<1 second and 21 milliseconds>"
NSQ_SOURCE_LINE 00000289 "in this mode."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "Millisecond mode is not enabled by default because this module sees heavy use"
NSQ_SOURCE_LINE 00000292 "and existing users of it may be relying on its implicit truncation of non-integer"
NSQ_SOURCE_LINE 00000293 "arguments."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "This module provides all the following functions, which are all exported"
NSQ_SOURCE_LINE 00000299 "by default when you call C<use Time::Duration;>."
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=over"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=item duration($seconds)"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=item duration($seconds, $precision)"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "Returns English text expressing the approximate time duration "
NSQ_SOURCE_LINE 00000309 "of abs($seconds), with at most S<C<$precision || 2>> expressed units."
NSQ_SOURCE_LINE 00000310 "(That is, duration($seconds) is the same as duration($seconds,2).)"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "For example, duration(120) or duration(-120) is \"2 minutes\".  And"
NSQ_SOURCE_LINE 00000313 "duration(0) is \"0 seconds\"."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "The precision figure means that no more than that many units will"
NSQ_SOURCE_LINE 00000316 "be used in expressing the time duration.  For example,"
NSQ_SOURCE_LINE 00000317 "31,629,659 seconds is a duration of I<exactly>"
NSQ_SOURCE_LINE 00000318 "1 year, 1 day, 2 hours, and 59 seconds (assuming 1 year = exactly"
NSQ_SOURCE_LINE 00000319 "365 days, as we do assume in this module).  However, if you wanted"
NSQ_SOURCE_LINE 00000320 "an approximation of this to at most two expressed (i.e., nonzero) units, it"
NSQ_SOURCE_LINE 00000321 "would round it and truncate it to \"1 year and 1 day\".  Max of 3 expressed"
NSQ_SOURCE_LINE 00000322 "units would get you \"1 year, 1 day, and 2 hours\".  Max of 4 expressed"
NSQ_SOURCE_LINE 00000323 "units would get you \"1 year, 1 day, 2 hours, and 59 seconds\","
NSQ_SOURCE_LINE 00000324 "which happens to be exactly true.  Max of 5 (or more) expressed units"
NSQ_SOURCE_LINE 00000325 "would get you the same, since there are only four nonzero units possible"
NSQ_SOURCE_LINE 00000326 "in for that duration."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=item duration_exact($seconds)"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "Same as duration($seconds), except that the returned value is an exact"
NSQ_SOURCE_LINE 00000331 "(unrounded) expression of $seconds.  For example, duration_exact(31629659)"
NSQ_SOURCE_LINE 00000332 "returns \"1 year, 1 day, 2 hours, and 59 seconds later\","
NSQ_SOURCE_LINE 00000333 "which is I<exactly> true."
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "=item ago($seconds)"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=item ago($seconds, $precision)"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "For a positive value of seconds, this prints the same as"
NSQ_SOURCE_LINE 00000341 "C<duration($seconds, [$precision]) . S<' ago'>>.  For example,"
NSQ_SOURCE_LINE 00000342 "ago(120) is \"2 minutes ago\".  For a negative value of seconds,"
NSQ_SOURCE_LINE 00000343 "this prints the same as"
NSQ_SOURCE_LINE 00000344 "C<duration($seconds, [$precision]) . S<' from now'>>.  For example,"
NSQ_SOURCE_LINE 00000345 "ago(-120) is \"2 minutes from now\".  As a special case, ago(0)"
NSQ_SOURCE_LINE 00000346 "returns \"right now\"."
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "=item ago_exact($seconds)"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "Same as ago($seconds), except that the returned value is an exact"
NSQ_SOURCE_LINE 00000351 "(unrounded) expression of $seconds."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=item from_now($seconds)"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "=item from_now($seconds, $precision)"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "=item from_now_exact($seconds)"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "The same as ago(-$seconds), ago(-$seconds, $precision), "
NSQ_SOURCE_LINE 00000361 "ago_exact(-$seconds).  For example, from_now(120) is \"2 minutes from now\"."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "=item later($seconds)"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "=item later($seconds, $precision)"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "For a positive value of seconds, this prints the same as"
NSQ_SOURCE_LINE 00000369 "C<duration($seconds, [$precision]) . S<' later'>>.  For example,"
NSQ_SOURCE_LINE 00000370 "ago(120) is \"2 minutes later\".  For a negative value of seconds,"
NSQ_SOURCE_LINE 00000371 "this prints the same as"
NSQ_SOURCE_LINE 00000372 "C<duration($seconds, [$precision]) . S<' earlier'>>.  For example,"
NSQ_SOURCE_LINE 00000373 "later(-120) is \"2 minutes earlier\".  As a special case, later(0)"
NSQ_SOURCE_LINE 00000374 "returns \"right then\"."
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "=item later_exact($seconds)"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "Same as later($seconds), except that the returned value is an exact"
NSQ_SOURCE_LINE 00000379 "(unrounded) expression of $seconds."
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=item earlier($seconds)"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "=item earlier($seconds, $precision)"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=item earlier_exact($seconds)"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "The same as later(-$seconds), later(-$seconds, $precision), "
NSQ_SOURCE_LINE 00000388 "later_exact(-$seconds).  For example, earlier(120) is \"2 minutes earlier\"."
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "=item concise( I<function(> ... ) )"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "Concise takes the string output of one of the above functions and makes"
NSQ_SOURCE_LINE 00000394 "it more concise.  For example, "
NSQ_SOURCE_LINE 00000395 "C<< ago(4567) >> returns \"1 hour and 16 minutes ago\", but"
NSQ_SOURCE_LINE 00000396 "C<< concise(ago(4567)) >> returns \"1h16m ago\"."
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "=back"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "=head1 I18N/L10N NOTES"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "Little of the internals of this module are English-specific.  See source"
NSQ_SOURCE_LINE 00000405 "and/or contact me if you're interested in making a localized version"
NSQ_SOURCE_LINE 00000406 "for some other language than English."
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "=head1 BACKSTORY"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "I wrote the basic C<ago()> function for use in Infobot"
NSQ_SOURCE_LINE 00000413 "(C<http://www.infobot.org>), because I was tired of this sort of"
NSQ_SOURCE_LINE 00000414 "response from the Purl Infobot:"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "  me> Purl, seen Woozle?"
NSQ_SOURCE_LINE 00000417 "  <Purl> Woozle was last seen on #perl 20 days, 7 hours, 32 minutes"
NSQ_SOURCE_LINE 00000418 "  and 40 seconds ago, saying: Wuzzle!"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "I figured if it was 20 days ago, I don't care about the seconds.  So"
NSQ_SOURCE_LINE 00000421 "once I had written C<ago()>, I abstracted the code a bit and got"
NSQ_SOURCE_LINE 00000422 "all the other functions."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "=head1 CAVEAT"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "This module calls a durational \"year\" an interval of exactly 365"
NSQ_SOURCE_LINE 00000428 "days of exactly 24 hours each, with no provision for leap years or"
NSQ_SOURCE_LINE 00000429 "monkey business with 23/25 hour days (much less leap seconds!).  But"
NSQ_SOURCE_LINE 00000430 "since the main work of this module is approximation, that shouldn't"
NSQ_SOURCE_LINE 00000431 "be a great problem for most purposes."
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "L<Time::Elapsed> - similarly converts durations to natural language,"
NSQ_SOURCE_LINE 00000437 "but in addition to English also supports Danish, German, French, and Turkish."
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "L<Date::Interval|Date::Interval>, which is similarly named, but does"
NSQ_SOURCE_LINE 00000440 "something rather different."
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "I<Star Trek: The Next Generation> (1987-1994), where the character"
NSQ_SOURCE_LINE 00000443 "Data would express time durations like"
NSQ_SOURCE_LINE 00000444 "\"1 year, 20 days, 22 hours, 59 minutes, and 35 seconds\""
NSQ_SOURCE_LINE 00000445 "instead of rounding to \"1 year and 21 days\".  This is because no-one"
NSQ_SOURCE_LINE 00000446 "ever told him to use Time::Duration."
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 ""
