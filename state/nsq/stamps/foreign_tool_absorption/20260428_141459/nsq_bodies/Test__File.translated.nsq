NSQ_SOURCE_LINE 00000895 "=item file_mode_is( FILENAME, MODE [, NAME ] )"
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "Ok if the file exists and the mode matches, not ok if the file does"
NSQ_SOURCE_LINE 00000898 "not exist or the mode does not match."
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "This test automatically skips if it thinks it is on a Windows"
NSQ_SOURCE_LINE 00000901 "platform."
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "Contributed by Shawn Sorichetti C<< <ssoriche@coloredblocks.net> >>"
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "=cut"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "sub file_mode_is {"
NSQ_SOURCE_LINE 00000908 "\tif( _win32() ) {"
NSQ_SOURCE_LINE 00000909 "\t\t$Test->skip( \"file_mode_is doesn't work on Windows\" );"
NSQ_SOURCE_LINE 00000910 "\t\treturn;"
NSQ_SOURCE_LINE 00000911 "\t\t}"
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000914 "\tmy $mode     = shift;"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "\tmy $name     = shift || sprintf(\"%s mode is %04o\", $filename, $mode);"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "\tmy $ok = -e $filename && ((stat($filename))[2] & 07777) == $mode;"
NSQ_SOURCE_LINE 00000919 ""
NSQ_SOURCE_LINE 00000920 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00000921 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00000922 "\t\t}"
