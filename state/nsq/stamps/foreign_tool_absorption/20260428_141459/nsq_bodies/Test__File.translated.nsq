NSQ_SOURCE_LINE 00001785 ""
NSQ_SOURCE_LINE 00001786 "* check number of links to file"
NSQ_SOURCE_LINE 00001787 ""
NSQ_SOURCE_LINE 00001788 "* check path parts (directory, filename, extension)"
NSQ_SOURCE_LINE 00001789 ""
