NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=encoding utf8"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=head1 NAME"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "Test::File -- test file attributes"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "  use Test::File;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "This modules provides a collection of test utilities for file"
NSQ_SOURCE_LINE 00000050 "attributes."
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "Some file attributes depend on the owner of the process testing the"
NSQ_SOURCE_LINE 00000053 "file in the same way the file test operators do.  For instance, root"
NSQ_SOURCE_LINE 00000054 "(or super-user or Administrator) may always be able to read files no"
NSQ_SOURCE_LINE 00000055 "matter the permissions."
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "Some attributes don't make sense outside of Unix, either, so some"
NSQ_SOURCE_LINE 00000058 "tests automatically skip if they think they won't work on the"
NSQ_SOURCE_LINE 00000059 "platform.  If you have a way to make these functions work on Windows,"
NSQ_SOURCE_LINE 00000060 "for instance, please send me a patch. :) If you want to pretend to be"
NSQ_SOURCE_LINE 00000061 "Windows on a non-Windows machine (for instance, to test C<skip()>),"
NSQ_SOURCE_LINE 00000062 "you can set the C<PRETEND_TO_BE_WINDOWS> environment variable."
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "The optional NAME parameter for every function allows you to specify a"
NSQ_SOURCE_LINE 00000065 "name for the test.  If not supplied, a reasonable default will be"
NSQ_SOURCE_LINE 00000066 "generated."
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=head2 Functions"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=over 4"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=cut"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub _is_plain_file {"
NSQ_SOURCE_LINE 00000075 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "\tmy $message = do {"
NSQ_SOURCE_LINE 00000078 "\t\t   if( ! -e $filename ) { \"does not exist\" }"
NSQ_SOURCE_LINE 00000079 "\t\telsif( ! -f _ )         { \"is not a plain file\" }"
NSQ_SOURCE_LINE 00000080 "\t\telsif( -d _ )           { \"is a directory\"  }"
NSQ_SOURCE_LINE 00000081 "\t\telse { () }"
NSQ_SOURCE_LINE 00000082 "\t\t};"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "\tif( $message ) {"
NSQ_SOURCE_LINE 00000085 "\t\t$Test->diag( \"file [$filename] $message\");"
NSQ_SOURCE_LINE 00000086 "\t\treturn 0;"
NSQ_SOURCE_LINE 00000087 "\t\t}"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "\treturn 1;"
NSQ_SOURCE_LINE 00000090 "\t}"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "sub _normalize {"
NSQ_SOURCE_LINE 00000093 "\tmy $file = shift;"
NSQ_SOURCE_LINE 00000094 "\treturn unless defined $file;"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "\treturn $file =~ m|/|"
NSQ_SOURCE_LINE 00000097 "\t\t? File::Spec->catfile( split m|/|, $file )"
NSQ_SOURCE_LINE 00000098 "\t\t: $file;"
NSQ_SOURCE_LINE 00000099 "\t}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "sub _win32 {"
NSQ_SOURCE_LINE 00000102 "\treturn 0 if $^O eq 'darwin';"
NSQ_SOURCE_LINE 00000103 "\treturn $ENV{PRETEND_TO_BE_WIN32} if defined $ENV{PRETEND_TO_BE_WIN32};"
NSQ_SOURCE_LINE 00000104 "\treturn $^O =~ m/Win/ || $^O eq 'msys';"
NSQ_SOURCE_LINE 00000105 "\t}"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "# returns true if symlinks can't exist"
NSQ_SOURCE_LINE 00000108 "BEGIN {"
NSQ_SOURCE_LINE 00000109 "\tmy $cannot_symlink;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "\tsub _no_symlinks_here {"
NSQ_SOURCE_LINE 00000112 "\t\treturn $cannot_symlink if defined $cannot_symlink;"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "\t\t$cannot_symlink = ! do {"
NSQ_SOURCE_LINE 00000115 "\t\t\teval {"
NSQ_SOURCE_LINE 00000116 "\t\t\t\tsymlink(\"\",\"\");                 # symlink exist in perl"
NSQ_SOURCE_LINE 00000117 "\t\t\t\t_IsSymlinkCreationAllowed()\t\t# symlink is ok in current session"
NSQ_SOURCE_LINE 00000118 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000119 "\t\t};"
NSQ_SOURCE_LINE 00000120 "\t}"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "\tsub _IsSymlinkCreationAllowed {"
NSQ_SOURCE_LINE 00000123 "\t\tif ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000124 "\t\t\t#"
NSQ_SOURCE_LINE 00000125 "\t\t\t# Bare copy of Perl's Win32::IsSymlinkCreationAllowed but with Test::File::Win32 namespace instead of Win32"
NSQ_SOURCE_LINE 00000126 "\t\t\t#"
NSQ_SOURCE_LINE 00000127 "\t\t\tmy(undef, $major, $minor, $build) = Test::File::Win32::GetOSVersion();"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "\t\t\t# Vista was the first Windows version with symlink support"
NSQ_SOURCE_LINE 00000130 "\t\t\treturn !!0 if $major < 6;"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "\t\t\t# Since Windows 10 1703, enabling the developer mode allows to create"
NSQ_SOURCE_LINE 00000133 "\t\t\t# symlinks regardless of process privileges"
NSQ_SOURCE_LINE 00000134 "\t\t\tif ($major > 10 || ($major == 10 && ($minor > 0 || $build > 15063))) {"
NSQ_SOURCE_LINE 00000135 "\t\t\t\treturn !!1 if Test::File::Win32::IsDeveloperModeEnabled();"
NSQ_SOURCE_LINE 00000136 "\t\t\t}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "\t\t\tmy $privs = Test::File::Win32::GetProcessPrivileges();"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "\t\t\treturn !!0 unless $privs;"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "\t\t\t# It doesn't matter if the permission is enabled or not, it just has to"
NSQ_SOURCE_LINE 00000143 "\t\t\t# exist. CreateSymbolicLink() will automatically enable it when needed."
NSQ_SOURCE_LINE 00000144 "\t\t\treturn exists $privs->{SeCreateSymbolicLinkPrivilege};"
NSQ_SOURCE_LINE 00000145 "\t\t}"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "\t\t1;"
NSQ_SOURCE_LINE 00000148 "\t}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=item has_symlinks"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "Returns true is this module thinks that the current system supports"
NSQ_SOURCE_LINE 00000153 "symlinks."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "This is not a test function. It's something that tests can use to"
NSQ_SOURCE_LINE 00000156 "determine what it should expect or skip."
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=cut"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "\tsub has_symlinks { ! _no_symlinks_here() }"
NSQ_SOURCE_LINE 00000161 "}"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "# owner_is and owner_isn't should skip on OS where the question makes no"
NSQ_SOURCE_LINE 00000164 "# sense.  I really don't know a good way to test for that, so I'm going"
NSQ_SOURCE_LINE 00000165 "# to skip on the two OS's that I KNOW aren't multi-user.  I'd love to add"
NSQ_SOURCE_LINE 00000166 "# more if anyone knows of any"
NSQ_SOURCE_LINE 00000167 "#   Note:  I don't have a dos or mac os < 10 machine to test this on"
NSQ_SOURCE_LINE 00000168 "sub _obviously_non_multi_user {"
NSQ_SOURCE_LINE 00000169 "\tforeach my $os ( qw(dos MacOS) ) { return 1 if $^O eq $os }"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "\treturn 0 if $^O eq 'MSWin32';"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "\teval { my $holder = getpwuid(0) };"
NSQ_SOURCE_LINE 00000174 "\treturn 1 if $@;"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "\teval { my $holder = getgrgid(0) };"
NSQ_SOURCE_LINE 00000177 "\treturn 1 if $@;"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "\treturn 0;"
NSQ_SOURCE_LINE 00000180 "\t}"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=item file_exists_ok( FILENAME [, NAME ] )"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "Ok if the file exists, and not ok otherwise."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=cut"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "sub file_exists_ok {"
NSQ_SOURCE_LINE 00000189 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000190 "\tmy $name     = shift || \"$filename exists\";"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "\tmy $ok = -e $filename;"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00000195 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00000196 "\t\t}"
NSQ_SOURCE_LINE 00000197 "\telse {"
NSQ_SOURCE_LINE 00000198 "\t\t$Test->diag(\"file [$filename] does not exist\");"
NSQ_SOURCE_LINE 00000199 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00000200 "\t\t}"
NSQ_SOURCE_LINE 00000201 "\t}"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=item file_not_exists_ok( FILENAME [, NAME ] )"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "Ok if the file does not exist, and not okay if it does exist."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=cut"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "sub file_not_exists_ok {"
NSQ_SOURCE_LINE 00000210 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000211 "\tmy $name     = shift || \"$filename does not exist\";"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "\tmy $ok = not -e $filename;"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00000216 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00000217 "\t\t}"
NSQ_SOURCE_LINE 00000218 "\telse {"
NSQ_SOURCE_LINE 00000219 "\t\t$Test->diag(\"file [$filename] exists\");"
NSQ_SOURCE_LINE 00000220 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00000221 "\t\t}"
NSQ_SOURCE_LINE 00000222 "\t}"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=item file_empty_ok( FILENAME [, NAME ] )"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "Ok if the file exists and has empty size, not ok if the file does not"
NSQ_SOURCE_LINE 00000227 "exist or exists with non-zero size."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "Previously this tried to test any sort of file. Sometime in the future"
NSQ_SOURCE_LINE 00000230 "this will fail if the argument is not a plain file or is a directory."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=cut"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "sub file_empty_ok {"
NSQ_SOURCE_LINE 00000235 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000236 "\tmy $name     = shift || \"$filename is empty\";"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "\treturn $Test->ok( 0, $name ) unless _is_plain_file( $filename );"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "\tmy $ok = -z $filename;"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00000243 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00000244 "\t\t}"
NSQ_SOURCE_LINE 00000245 "\telse {"
NSQ_SOURCE_LINE 00000246 "\t\t$Test->diag( \"file [$filename] exists with non-zero size\" );"
NSQ_SOURCE_LINE 00000247 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00000248 "\t\t}"
NSQ_SOURCE_LINE 00000249 "\t}"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=item file_not_empty_ok( FILENAME [, NAME ] )"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "Ok if the file exists and has non-zero size, not ok if the file does"
NSQ_SOURCE_LINE 00000254 "not exist or exists with zero size."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "Previously this tried to test any sort of file. Sometime in the future"
NSQ_SOURCE_LINE 00000257 "this will fail if the argument is not a plain file or is a directory."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=cut"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "sub file_not_empty_ok {"
NSQ_SOURCE_LINE 00000262 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000263 "\tmy $name     = shift || \"$filename is not empty\";"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "\treturn $Test->ok( 0, $name ) unless _is_plain_file( $filename );"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "\tmy $ok = not -z _;"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00000270 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00000271 "\t\t}"
NSQ_SOURCE_LINE 00000272 "\telse {"
NSQ_SOURCE_LINE 00000273 "\t\t$Test->diag( \"file [$filename] exists with zero size\" );"
NSQ_SOURCE_LINE 00000274 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00000275 "\t\t}"
NSQ_SOURCE_LINE 00000276 "\t}"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=item file_size_ok( FILENAME, SIZE [, NAME ]  )"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "Ok if the file exists and has SIZE size in bytes (exactly), not ok if"
NSQ_SOURCE_LINE 00000281 "the file does not exist or exists with size other than SIZE."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "Previously this tried to test any sort of file. Sometime in the future"
NSQ_SOURCE_LINE 00000284 "this will fail if the argument is not a plain file or is a directory."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=cut"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "sub file_size_ok {"
NSQ_SOURCE_LINE 00000289 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000290 "\tmy $expected = int shift;"
NSQ_SOURCE_LINE 00000291 "\tmy $name     = shift || \"$filename has right size\";"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "\treturn $Test->ok( 0, $name ) unless _is_plain_file( $filename );"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "\tmy $ok = ( -s $filename ) == $expected;"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00000298 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00000299 "\t\t}"
NSQ_SOURCE_LINE 00000300 "\telse {"
NSQ_SOURCE_LINE 00000301 "\t\tmy $actual = -s $filename;"
NSQ_SOURCE_LINE 00000302 "\t\t$Test->diag("
NSQ_SOURCE_LINE 00000303 "\t\t\t\"file [$filename] has actual size [$actual] not [$expected]\" );"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00000306 "\t\t}"
NSQ_SOURCE_LINE 00000307 "\t}"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=item file_max_size_ok( FILENAME, MAX [, NAME ] )"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "Ok if the file exists and has size less than or equal to MAX bytes, not"
NSQ_SOURCE_LINE 00000312 "ok if the file does not exist or exists with size greater than MAX"
NSQ_SOURCE_LINE 00000313 "bytes."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "Previously this tried to test any sort of file. Sometime in the future"
NSQ_SOURCE_LINE 00000316 "this will fail if the argument is not a plain file or is a directory."
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=cut"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "sub file_max_size_ok {"
NSQ_SOURCE_LINE 00000321 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000322 "\tmy $max      = int shift;"
NSQ_SOURCE_LINE 00000323 "\tmy $name     = shift || \"$filename is under $max bytes\";"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "\treturn $Test->ok( 0, $name ) unless _is_plain_file( $filename );"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "\tmy $ok = ( -s $filename ) <= $max;"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00000330 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00000331 "\t\t}"
NSQ_SOURCE_LINE 00000332 "\telse {"
NSQ_SOURCE_LINE 00000333 "\t\tmy $actual = -s $filename;"
NSQ_SOURCE_LINE 00000334 "\t\t$Test->diag("
NSQ_SOURCE_LINE 00000335 "\t\t\t\"file [$filename] has actual size [$actual] \" ."
NSQ_SOURCE_LINE 00000336 "\t\t\t\"greater than [$max]\""
NSQ_SOURCE_LINE 00000337 "\t\t\t);"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00000340 "\t\t}"
NSQ_SOURCE_LINE 00000341 "\t}"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "=item file_min_size_ok( FILENAME, MIN [, NAME ] )"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "Ok if the file exists and has size greater than or equal to MIN bytes,"
NSQ_SOURCE_LINE 00000346 "not ok if the file does not exist or exists with size less than MIN"
NSQ_SOURCE_LINE 00000347 "bytes."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "Previously this tried to test any sort of file. Sometime in the future"
NSQ_SOURCE_LINE 00000350 "this will fail if the argument is not a plain file or is a directory."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=cut"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "sub file_min_size_ok {"
NSQ_SOURCE_LINE 00000355 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000356 "\tmy $min      = int shift;"
NSQ_SOURCE_LINE 00000357 "\tmy $name     = shift || \"$filename is over $min bytes\";"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "\treturn $Test->ok( 0, $name ) unless _is_plain_file( $filename );"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "\tmy $ok = ( -s $filename ) >= $min;"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00000364 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00000365 "\t\t}"
NSQ_SOURCE_LINE 00000366 "\telse {"
NSQ_SOURCE_LINE 00000367 "\t\tmy $actual = -s $filename;"
NSQ_SOURCE_LINE 00000368 "\t\t$Test->diag("
NSQ_SOURCE_LINE 00000369 "\t\t\t\"file [$filename] has actual size \"."
NSQ_SOURCE_LINE 00000370 "\t\t\t\"[$actual] less than [$min]\""
NSQ_SOURCE_LINE 00000371 "\t\t\t);"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00000374 "\t\t}"
NSQ_SOURCE_LINE 00000375 "\t}"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "=item file_line_count_is( FILENAME, COUNT [, NAME ]  )"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "Ok if the file exists and has COUNT lines (exactly), not ok if the"
NSQ_SOURCE_LINE 00000380 "file does not exist or exists with a line count other than COUNT."
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "This function uses the current value of C<$/> as the line ending and"
NSQ_SOURCE_LINE 00000383 "counts the lines by reading them and counting how many it read."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "Previously this tried to test any sort of file. Sometime in the future"
NSQ_SOURCE_LINE 00000386 "this will fail if the argument is not a plain file or is a directory."
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "=cut"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "sub _ENOFILE   () { -1 }"
NSQ_SOURCE_LINE 00000391 "sub _ECANTOPEN () { -2 }"
NSQ_SOURCE_LINE 00000392 "sub _ENOTPLAIN () { -3 }"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "sub _file_line_counter {"
NSQ_SOURCE_LINE 00000395 "\tmy $filename = shift;"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "\treturn _ENOFILE   unless -e $filename;"
NSQ_SOURCE_LINE 00000398 "\treturn _ENOTPLAIN unless -f $filename;"
NSQ_SOURCE_LINE 00000399 "\treturn _ECANTOPEN unless open my( $fh ), \"<\", $filename;"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "\tmy $count = 0;"
NSQ_SOURCE_LINE 00000402 "\twhile( <$fh> ) { $count++ }"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "\treturn $count;"
NSQ_SOURCE_LINE 00000405 "\t}"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "# XXX: lots of cut and pasting here, needs refactoring"
NSQ_SOURCE_LINE 00000408 "# looks like the refactoring might be worse than this though"
NSQ_SOURCE_LINE 00000409 "sub file_line_count_is {"
NSQ_SOURCE_LINE 00000410 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000411 "\tmy $expected = shift;"
NSQ_SOURCE_LINE 00000412 "\tmy $name     = do {"
NSQ_SOURCE_LINE 00000413 "\t\tno warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000414 "\t\tshift || \"$filename line count is $expected lines\";"
NSQ_SOURCE_LINE 00000415 "\t\t};"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "\treturn $Test->ok( 0, $name ) unless _is_plain_file( $filename );"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "\tunless( defined $expected && int( $expected ) == $expected ) {"
NSQ_SOURCE_LINE 00000420 "\t\tno warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000421 "\t\t$Test->diag( \"file_line_count_is expects a positive whole number for \" ."
NSQ_SOURCE_LINE 00000422 "\t\t\t\"the second argument. Got [$expected]\" );"
NSQ_SOURCE_LINE 00000423 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000424 "\t\t}"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "\tmy $got = _file_line_counter( $filename );"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "\tif( $got eq _ENOFILE ) {"
NSQ_SOURCE_LINE 00000429 "\t\t$Test->diag( \"file [$filename] does not exist\" );"
NSQ_SOURCE_LINE 00000430 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000431 "\t\t}"
NSQ_SOURCE_LINE 00000432 "\telsif( $got eq _ENOTPLAIN ) {"
NSQ_SOURCE_LINE 00000433 "\t\t$Test->diag( \"file [$filename] is not a plain file\" );"
NSQ_SOURCE_LINE 00000434 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000435 "\t\t}"
NSQ_SOURCE_LINE 00000436 "\telsif( $got == _ECANTOPEN ) {"
NSQ_SOURCE_LINE 00000437 "\t\t$Test->diag( \"file [$filename] could not be opened: \\$! is [$!]\" );"
NSQ_SOURCE_LINE 00000438 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000439 "\t\t}"
NSQ_SOURCE_LINE 00000440 "\telsif( $got == $expected ) {"
NSQ_SOURCE_LINE 00000441 "\t\t$Test->ok( 1, $name );"
NSQ_SOURCE_LINE 00000442 "\t\t}"
NSQ_SOURCE_LINE 00000443 "\telse {"
NSQ_SOURCE_LINE 00000444 "\t\t$Test->diag( \"expected [$expected] lines in [$filename], \" ."
NSQ_SOURCE_LINE 00000445 "\t\t\t\"got [$got] lines\" );"
NSQ_SOURCE_LINE 00000446 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000447 "\t\t}"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "\t}"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "=item file_line_count_isnt( FILENAME, COUNT [, NAME ]  )"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "Ok if the file exists and doesn't have exactly COUNT lines, not ok if"
NSQ_SOURCE_LINE 00000454 "the file does not exist or exists with a line count of COUNT. Read"
NSQ_SOURCE_LINE 00000455 "that carefully: the file must exist for this test to pass!"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "This function uses the current value of C<$/> as the line ending and"
NSQ_SOURCE_LINE 00000458 "counts the lines by reading them and counting how many it read."
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "Previously this tried to test any sort of file. Sometime in the future"
NSQ_SOURCE_LINE 00000461 "this will fail if the argument is not a plain file or is a directory."
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "=cut"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "sub file_line_count_isnt {"
NSQ_SOURCE_LINE 00000466 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000467 "\tmy $expected = shift;"
NSQ_SOURCE_LINE 00000468 "\tmy $name     = do {"
NSQ_SOURCE_LINE 00000469 "\t\tno warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000470 "\t\tshift || \"$filename line count is not $expected lines\";"
NSQ_SOURCE_LINE 00000471 "\t\t};"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "\treturn $Test->ok( 0, $name ) unless _is_plain_file( $filename );"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "\tunless( defined $expected && int( $expected ) == $expected ) {"
NSQ_SOURCE_LINE 00000476 "\t\tno warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000477 "\t\t$Test->diag( \"file_line_count_is expects a positive whole number for \" ."
NSQ_SOURCE_LINE 00000478 "\t\t\t\"the second argument. Got [$expected]\" );"
NSQ_SOURCE_LINE 00000479 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000480 "\t\t}"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "\tmy $got = _file_line_counter( $filename );"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "\tif( $got eq _ENOFILE ) {"
NSQ_SOURCE_LINE 00000485 "\t\t$Test->diag( \"file [$filename] does not exist\" );"
NSQ_SOURCE_LINE 00000486 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000487 "\t\t}"
NSQ_SOURCE_LINE 00000488 "\telsif( $got eq _ENOTPLAIN ) {"
NSQ_SOURCE_LINE 00000489 "\t\t$Test->diag( \"file [$filename] is not a plain file\" );"
NSQ_SOURCE_LINE 00000490 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000491 "\t\t}"
NSQ_SOURCE_LINE 00000492 "\telsif( $got == _ECANTOPEN ) {"
NSQ_SOURCE_LINE 00000493 "\t\t$Test->diag( \"file [$filename] could not be opened: \\$! is [$!]\" );"
NSQ_SOURCE_LINE 00000494 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000495 "\t\t}"
NSQ_SOURCE_LINE 00000496 "\telsif( $got != $expected ) {"
NSQ_SOURCE_LINE 00000497 "\t\t$Test->ok( 1, $name );"
NSQ_SOURCE_LINE 00000498 "\t\t}"
NSQ_SOURCE_LINE 00000499 "\telse {"
NSQ_SOURCE_LINE 00000500 "\t\t$Test->diag( \"expected something other than [$expected] lines in [$filename], \" ."
NSQ_SOURCE_LINE 00000501 "\t\t\t\"but got [$got] lines\" );"
NSQ_SOURCE_LINE 00000502 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000503 "\t\t}"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "\t}"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "=item file_line_count_between( FILENAME, MIN, MAX, [, NAME ]  )"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "Ok if the file exists and has a line count between MIN and MAX,"
NSQ_SOURCE_LINE 00000510 "inclusively."
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "This function uses the current value of C<$/> as the line ending and"
NSQ_SOURCE_LINE 00000513 "counts the lines by reading them and counting how many it read."
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "Previously this tried to test any sort of file. Sometime in the future"
NSQ_SOURCE_LINE 00000516 "this will fail if the argument is not a plain file or is a directory."
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "=cut"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "sub file_line_count_between {"
NSQ_SOURCE_LINE 00000521 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000522 "\tmy $min      = shift;"
NSQ_SOURCE_LINE 00000523 "\tmy $max      = shift;"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "\tmy $name = do {"
NSQ_SOURCE_LINE 00000526 "\t\tno warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000527 "\t\tshift || \"$filename line count is between [$min] and [$max] lines\";"
NSQ_SOURCE_LINE 00000528 "\t\t};"
NSQ_SOURCE_LINE 00000529 "\treturn $Test->ok( 0, $name ) unless _is_plain_file( $filename );"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "\tforeach my $ref ( \\$min, \\$max ) {"
NSQ_SOURCE_LINE 00000532 "\t\tunless( defined $$ref && int( $$ref ) == $$ref ) {"
NSQ_SOURCE_LINE 00000533 "\t\t\tno warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000534 "\t\t\t$Test->diag( \"file_line_count_between expects positive whole numbers for \" ."
NSQ_SOURCE_LINE 00000535 "\t\t\t\t\"the second and third arguments. Got [$min] and [$max]\" );"
NSQ_SOURCE_LINE 00000536 "\t\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000537 "\t\t\t}"
NSQ_SOURCE_LINE 00000538 "\t\t}"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "\tmy $got = _file_line_counter( $filename );"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "\tif( $got eq _ENOFILE ) {"
NSQ_SOURCE_LINE 00000543 "\t\t$Test->diag( \"file [$filename] does not exist\" );"
NSQ_SOURCE_LINE 00000544 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000545 "\t\t}"
NSQ_SOURCE_LINE 00000546 "\telsif( $got eq _ENOTPLAIN ) {"
NSQ_SOURCE_LINE 00000547 "\t\t$Test->diag( \"file [$filename] is not a plain file\" );"
NSQ_SOURCE_LINE 00000548 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000549 "\t\t}"
NSQ_SOURCE_LINE 00000550 "\telsif( $got == _ECANTOPEN ) {"
NSQ_SOURCE_LINE 00000551 "\t\t$Test->diag( \"file [$filename] could not be opened: \\$! is [$!]\" );"
NSQ_SOURCE_LINE 00000552 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000553 "\t\t}"
NSQ_SOURCE_LINE 00000554 "\telsif( $min <= $got and $got <= $max ) {"
NSQ_SOURCE_LINE 00000555 "\t\t$Test->ok( 1, $name );"
NSQ_SOURCE_LINE 00000556 "\t\t}"
NSQ_SOURCE_LINE 00000557 "\telse {"
NSQ_SOURCE_LINE 00000558 "\t\t$Test->diag( \"expected a line count between [$min] and [$max] \" ."
NSQ_SOURCE_LINE 00000559 "\t\t\t\"in [$filename], but got [$got] lines\""
NSQ_SOURCE_LINE 00000560 "\t\t\t);"
NSQ_SOURCE_LINE 00000561 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000562 "\t\t}"
NSQ_SOURCE_LINE 00000563 "\t}"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "=item file_contains_like ( FILENAME, PATTERN [, NAME ] )"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "Ok if the file exists and its contents (as one big string) match"
NSQ_SOURCE_LINE 00000568 "PATTERN, not ok if the file does not exist, is not readable, or exists"
NSQ_SOURCE_LINE 00000569 "but doesn't match PATTERN."
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "Since the file contents are read into memory, you should not use this"
NSQ_SOURCE_LINE 00000572 "for large files.  Besides memory consumption, test diagnostics for"
NSQ_SOURCE_LINE 00000573 "failing tests might be difficult to decipher.  However, for short"
NSQ_SOURCE_LINE 00000574 "files this works very well."
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "Because the entire contents are treated as one large string, you can"
NSQ_SOURCE_LINE 00000577 "make a pattern that tests multiple lines.  Don't forget that you may"
NSQ_SOURCE_LINE 00000578 "need to use the /s modifier for such patterns:"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "\t# make sure file has one or more paragraphs with CSS class X"
NSQ_SOURCE_LINE 00000581 "\tfile_contains_like($html_file, qr{<p class=\"X\">.*?</p>}s);"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "Contrariwise, if you need to match at the beginning or end of a line"
NSQ_SOURCE_LINE 00000584 "inside the file, use the /m modifier:"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "\t# make sure file has a setting for foo"
NSQ_SOURCE_LINE 00000587 "\tfile_contains_like($config_file, qr/^ foo \\s* = \\s* \\w+ $/mx);"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "If you want to test your file contents against multiple patterns, but"
NSQ_SOURCE_LINE 00000590 "don't want to have the file read in repeatedly, you can pass an"
NSQ_SOURCE_LINE 00000591 "arrayref of patterns instead of a single pattern, like so:"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "\t# make sure our template has rendered correctly"
NSQ_SOURCE_LINE 00000594 "\tfile_contains_like($template_out,"
NSQ_SOURCE_LINE 00000595 "\t\t["
NSQ_SOURCE_LINE 00000596 "\t\tqr/^ $title_line $/mx,"
NSQ_SOURCE_LINE 00000597 "\t\tmap { qr/^ $_ $/mx } @chapter_headings,"
NSQ_SOURCE_LINE 00000598 "\t\tqr/^ $footer_line $/mx,"
NSQ_SOURCE_LINE 00000599 "\t\t]);"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "Please note that if you do this, and your file does not exist or is"
NSQ_SOURCE_LINE 00000602 "not readable, you'll only get one test failure instead of a failure"
NSQ_SOURCE_LINE 00000603 "for each pattern.  This could cause your test plan to be off, although"
NSQ_SOURCE_LINE 00000604 "you may not care at that point because your test failed anyway.  If"
NSQ_SOURCE_LINE 00000605 "you do care, either skip the test plan altogether by employing"
NSQ_SOURCE_LINE 00000606 "L<Test::More>'s C<done_testing()> function, or use"
NSQ_SOURCE_LINE 00000607 "L</file_readable_ok> in conjunction with a C<SKIP> block."
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "Contributed by Buddy Burden C<< <barefoot@cpan.org> >>."
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "=item file_contains_unlike ( FILENAME, PATTERN [, NAME ] )"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "Ok if the file exists and its contents (as one big string) do B<not>"
NSQ_SOURCE_LINE 00000614 "match PATTERN, not ok if the file does not exist, is not readable, or"
NSQ_SOURCE_LINE 00000615 "exists but matches PATTERN."
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "All notes and caveats for L</file_contains_like> apply to this"
NSQ_SOURCE_LINE 00000618 "function as well."
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "Contributed by Buddy Burden C<< <barefoot@cpan.org> >>."
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "=item file_contains_utf8_like ( FILENAME, PATTERN [, NAME ] )"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "The same as C<file_contains_like>, except the file is opened as UTF-8."
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "=item file_contains_utf8_unlike ( FILENAME, PATTERN [, NAME ] )"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "The same as C<file_contains_unlike>, except the file is opened as UTF-8."
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "=item file_contains_encoded_like ( FILENAME, ENCODING, PATTERN [, NAME ] )"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "The same as C<file_contains_like>, except the file is opened with ENCODING"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "=item file_contains_encoded_unlike ( FILENAME, ENCODING, PATTERN [, NAME ] )"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "The same as C<file_contains_unlike>, except the file is opened with ENCODING."
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "=cut"
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "sub file_contains_like {"
NSQ_SOURCE_LINE 00000641 "\tlocal $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000642 "\t_file_contains(like => \"contains\", undef, @_);"
NSQ_SOURCE_LINE 00000643 "\t}"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "sub file_contains_unlike {"
NSQ_SOURCE_LINE 00000646 "\tlocal $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000647 "\t_file_contains(unlike => \"doesn't contain\", undef, @_);"
NSQ_SOURCE_LINE 00000648 "\t}"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "sub file_contains_utf8_like {"
NSQ_SOURCE_LINE 00000651 "\tlocal $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000652 "\t_file_contains(like => \"contains\", 'UTF-8', @_);"
NSQ_SOURCE_LINE 00000653 "\t}"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "sub file_contains_utf8_unlike {"
NSQ_SOURCE_LINE 00000656 "\tlocal $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000657 "\t_file_contains(unlike => \"doesn't contain\", 'UTF-8', @_);"
NSQ_SOURCE_LINE 00000658 "\t}"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "sub file_contains_encoded_like {"
NSQ_SOURCE_LINE 00000661 "\tlocal $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000662 "\tmy $filename = shift;"
NSQ_SOURCE_LINE 00000663 "\tmy $encoding = shift;"
NSQ_SOURCE_LINE 00000664 "\t_file_contains(like => \"contains\", $encoding, $filename, @_);"
NSQ_SOURCE_LINE 00000665 "\t}"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "sub file_contains_encoded_unlike {"
NSQ_SOURCE_LINE 00000668 "\tlocal $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000669 "\tmy $filename = shift;"
NSQ_SOURCE_LINE 00000670 "\tmy $encoding = shift;"
NSQ_SOURCE_LINE 00000671 "\t_file_contains(unlike => \"doesn't contain\", $encoding, $filename, @_);"
NSQ_SOURCE_LINE 00000672 "\t}"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "sub _file_contains {"
NSQ_SOURCE_LINE 00000675 "\tmy $method   = shift;"
NSQ_SOURCE_LINE 00000676 "\tmy $verb     = shift;"
NSQ_SOURCE_LINE 00000677 "\tmy $encoding = shift;"
NSQ_SOURCE_LINE 00000678 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000679 "\tmy $patterns = shift;"
NSQ_SOURCE_LINE 00000680 "\tmy $name     = shift;"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "\tmy (@patterns, %patterns);"
NSQ_SOURCE_LINE 00000683 "\tif (ref $patterns eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000684 "\t\t@patterns = @$patterns;"
NSQ_SOURCE_LINE 00000685 "\t\t%patterns = map { $_ => $name || \"$filename $verb $_\" } @patterns;"
NSQ_SOURCE_LINE 00000686 "\t\t}"
NSQ_SOURCE_LINE 00000687 "\telse {"
NSQ_SOURCE_LINE 00000688 "\t\t@patterns = ($patterns);"
NSQ_SOURCE_LINE 00000689 "\t\t%patterns = ( $patterns => $name || \"$filename $verb $patterns\" );"
NSQ_SOURCE_LINE 00000690 "\t\t}"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "\t# for purpose of checking the file's existence, just use the first"
NSQ_SOURCE_LINE 00000693 "\t# test name as the name"
NSQ_SOURCE_LINE 00000694 "\t$name = $patterns{$patterns[0]};"
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "\treturn $Test->ok( 0, $name ) unless _is_plain_file( $filename );"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "\tunless( -r $filename ) {"
NSQ_SOURCE_LINE 00000699 "\t\t$Test->diag( \"file [$filename] is not readable\" );"
NSQ_SOURCE_LINE 00000700 "\t\treturn $Test->ok(0, $name);"
NSQ_SOURCE_LINE 00000701 "\t\t}"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "\t# do the slurp"
NSQ_SOURCE_LINE 00000704 "\tmy $file_contents;"
NSQ_SOURCE_LINE 00000705 "\t{"
NSQ_SOURCE_LINE 00000706 "\tunless (open(FH, $filename)) {"
NSQ_SOURCE_LINE 00000707 "\t\t$Test->diag( \"file [$filename] could not be opened: \\$! is [$!]\" );"
NSQ_SOURCE_LINE 00000708 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000709 "\t\t}"
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "\tif (defined $encoding) {"
NSQ_SOURCE_LINE 00000712 "\t\tbinmode FH, \":encoding($encoding)\";"
NSQ_SOURCE_LINE 00000713 "\t\t}"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "\tlocal $/ = undef;"
NSQ_SOURCE_LINE 00000716 "\t$file_contents = <FH>;"
NSQ_SOURCE_LINE 00000717 "\tclose FH;"
NSQ_SOURCE_LINE 00000718 "\t}"
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "\tforeach my $p (@patterns) {"
NSQ_SOURCE_LINE 00000721 "\t\t$Test->$method($file_contents, $p, $patterns{$p});"
NSQ_SOURCE_LINE 00000722 "\t\t}"
NSQ_SOURCE_LINE 00000723 "\t}"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "=item file_readable_ok( FILENAME [, NAME ] )"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "Ok if the file exists and is readable, not ok if the file does not"
NSQ_SOURCE_LINE 00000728 "exist or is not readable."
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "=cut"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "sub file_readable_ok {"
NSQ_SOURCE_LINE 00000733 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000734 "\tmy $name     = shift || \"$filename is readable\";"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "\tmy $ok = -r $filename;"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00000739 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00000740 "\t\t}"
NSQ_SOURCE_LINE 00000741 "\telse {"
NSQ_SOURCE_LINE 00000742 "\t\t$Test->diag( \"file [$filename] is not readable\" );"
NSQ_SOURCE_LINE 00000743 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00000744 "\t\t}"
NSQ_SOURCE_LINE 00000745 "\t}"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "=item file_not_readable_ok( FILENAME [, NAME ] )"
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "Ok if the file exists and is not readable, not ok if the file does not"
NSQ_SOURCE_LINE 00000750 "exist or is readable."
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "=cut"
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "sub file_not_readable_ok {"
NSQ_SOURCE_LINE 00000755 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000756 "\tmy $name     = shift || \"$filename is not readable\";"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "\tmy $ok = not -r $filename;"
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00000761 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00000762 "\t\t}"
NSQ_SOURCE_LINE 00000763 "\telse {"
NSQ_SOURCE_LINE 00000764 "\t\t$Test->diag( \"file [$filename] is readable\" );"
