NSQ_SOURCE_LINE 00000924 "\t\t$Test->diag(sprintf(\"file [%s] mode is not %04o\", $filename, $mode) );"
NSQ_SOURCE_LINE 00000925 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00000926 "\t\t}"
NSQ_SOURCE_LINE 00000927 "\t}"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "=item file_mode_isnt( FILENAME, MODE [, NAME ] )"
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "Ok if the file exists and mode does not match, not ok if the file does"
NSQ_SOURCE_LINE 00000932 "not exist or mode does match."
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "This test automatically skips if it thinks it is on a Windows"
NSQ_SOURCE_LINE 00000935 "platform."
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "Contributed by Shawn Sorichetti C<< <ssoriche@coloredblocks.net> >>"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "=cut"
NSQ_SOURCE_LINE 00000940 ""
NSQ_SOURCE_LINE 00000941 "sub file_mode_isnt {"
NSQ_SOURCE_LINE 00000942 "\tif( _win32() ) {"
NSQ_SOURCE_LINE 00000943 "\t\t$Test->skip( \"file_mode_isnt doesn't work on Windows\" );"
NSQ_SOURCE_LINE 00000944 "\t\treturn;"
NSQ_SOURCE_LINE 00000945 "\t\t}"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000948 "\tmy $mode     = shift;"
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "\tmy $name     = shift || sprintf(\"%s mode is not %04o\",$filename,$mode);"
NSQ_SOURCE_LINE 00000951 ""
NSQ_SOURCE_LINE 00000952 "\tmy $ok = not (-e $filename && ((stat($filename))[2] & 07777) == $mode);"
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00000955 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00000956 "\t\t}"
NSQ_SOURCE_LINE 00000957 "\telse {"
NSQ_SOURCE_LINE 00000958 "\t\t$Test->diag(sprintf(\"file [%s] mode is %04o\",$filename,$mode));"
NSQ_SOURCE_LINE 00000959 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00000960 "\t\t}"
NSQ_SOURCE_LINE 00000961 "\t}"
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "=item file_mode_has( FILENAME, MODE [, NAME ] )"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "Ok if the file exists and has all the bits in mode turned on, not ok"
NSQ_SOURCE_LINE 00000966 "if the file does not exist or the mode does not match.  That is, C<<"
NSQ_SOURCE_LINE 00000967 "FILEMODE & MODE == MODE >> must be true."
NSQ_SOURCE_LINE 00000968 ""
NSQ_SOURCE_LINE 00000969 "This test automatically skips if it thinks it is on a Windows"
NSQ_SOURCE_LINE 00000970 "platform."
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "Contributed by Ricardo Signes C<< <rjbs@cpan.org> >>"
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "=cut"
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "sub file_mode_has {"
NSQ_SOURCE_LINE 00000977 "\tif( _win32() ) {"
NSQ_SOURCE_LINE 00000978 "\t\t$Test->skip( \"file_mode_has doesn't work on Windows\" );"
NSQ_SOURCE_LINE 00000979 "\t\treturn;"
NSQ_SOURCE_LINE 00000980 "\t\t}"
NSQ_SOURCE_LINE 00000981 ""
NSQ_SOURCE_LINE 00000982 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00000983 "\tmy $mode     = shift;"
NSQ_SOURCE_LINE 00000984 ""
NSQ_SOURCE_LINE 00000985 "\tmy $name     = shift || sprintf(\"%s mode has all bits of %04o\", $filename, $mode);"
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "\tmy $present = -e $filename;"
NSQ_SOURCE_LINE 00000988 "\tmy $gotmode = $present ? (stat($filename))[2] : undef;"
NSQ_SOURCE_LINE 00000989 "\tmy $ok      = $present && ($gotmode & $mode) == $mode;"
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00000992 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00000993 "\t\t}"
NSQ_SOURCE_LINE 00000994 "\telse {"
NSQ_SOURCE_LINE 00000995 "\t\tmy $missing = ($gotmode ^ $mode) & $mode;"
NSQ_SOURCE_LINE 00000996 "\t\t$Test->diag(sprintf(\"file [%s] mode is missing component %04o\", $filename, $missing) );"
NSQ_SOURCE_LINE 00000997 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00000998 "\t\t}"
NSQ_SOURCE_LINE 00000999 "\t}"
NSQ_SOURCE_LINE 00001000 ""
NSQ_SOURCE_LINE 00001001 "=item file_mode_hasnt( FILENAME, MODE [, NAME ] )"
NSQ_SOURCE_LINE 00001002 ""
NSQ_SOURCE_LINE 00001003 "Ok if the file exists and has all the bits in mode turned off, not ok"
NSQ_SOURCE_LINE 00001004 "if the file does not exist or the mode does not match.  That is,"
NSQ_SOURCE_LINE 00001005 "C<< FILEMODE & MODE == 0 >> must be true."
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "This test automatically skips if it thinks it is on a"
NSQ_SOURCE_LINE 00001008 "Windows platform."
NSQ_SOURCE_LINE 00001009 ""
NSQ_SOURCE_LINE 00001010 "Contributed by Ricardo Signes C<< <rjbs@cpan.org> >>"
NSQ_SOURCE_LINE 00001011 ""
NSQ_SOURCE_LINE 00001012 "=cut"
NSQ_SOURCE_LINE 00001013 ""
NSQ_SOURCE_LINE 00001014 "sub file_mode_hasnt {"
NSQ_SOURCE_LINE 00001015 "\tif( _win32() ) {"
NSQ_SOURCE_LINE 00001016 "\t\t$Test->skip( \"file_mode_hasnt doesn't work on Windows\" );"
NSQ_SOURCE_LINE 00001017 "\t\treturn;"
NSQ_SOURCE_LINE 00001018 "\t\t}"
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00001021 "\tmy $mode     = shift;"
NSQ_SOURCE_LINE 00001022 ""
NSQ_SOURCE_LINE 00001023 "\tmy $name     = shift || sprintf(\"%s mode has no bits of %04o\", $filename, $mode);"
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "\tmy $present = -e $filename;"
NSQ_SOURCE_LINE 00001026 "\tmy $gotmode = $present ? (stat($filename))[2] : undef;"
NSQ_SOURCE_LINE 00001027 "\tmy $ok      = $present && ($gotmode & $mode) == 0;"
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00001030 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00001031 "\t\t}"
NSQ_SOURCE_LINE 00001032 "\telse {"
NSQ_SOURCE_LINE 00001033 "\t\tmy $bad = $gotmode & $mode;"
NSQ_SOURCE_LINE 00001034 "\t\t$Test->diag(sprintf(\"file [%s] mode has forbidden component %04o\", $filename, $bad) );"
NSQ_SOURCE_LINE 00001035 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00001036 "\t\t}"
NSQ_SOURCE_LINE 00001037 "\t}"
NSQ_SOURCE_LINE 00001038 ""
NSQ_SOURCE_LINE 00001039 "=item file_is_symlink_ok( FILENAME [, NAME ] )"
NSQ_SOURCE_LINE 00001040 ""
NSQ_SOURCE_LINE 00001041 "Ok if FILENAME is a symlink, even if it points to a non-existent"
NSQ_SOURCE_LINE 00001042 "file. This test automatically skips if the operating system does"
NSQ_SOURCE_LINE 00001043 "not support symlinks."
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "=cut"
NSQ_SOURCE_LINE 00001046 ""
NSQ_SOURCE_LINE 00001047 "sub file_is_symlink_ok {"
NSQ_SOURCE_LINE 00001048 "\tif( _no_symlinks_here() ) {"
NSQ_SOURCE_LINE 00001049 "\t\t$Test->skip("
NSQ_SOURCE_LINE 00001050 "\t\t\t\"file_is_symlink_ok doesn't work on systems without symlinks\" );"
NSQ_SOURCE_LINE 00001051 "\t\treturn;"
NSQ_SOURCE_LINE 00001052 "\t\t}"
NSQ_SOURCE_LINE 00001053 ""
NSQ_SOURCE_LINE 00001054 "\tmy $file = shift;"
NSQ_SOURCE_LINE 00001055 "\tmy $name = shift || \"$file is a symlink\";"
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "\tif( -l $file ) {"
NSQ_SOURCE_LINE 00001058 "\t\t$Test->ok(1, $name)"
NSQ_SOURCE_LINE 00001059 "\t\t}"
NSQ_SOURCE_LINE 00001060 "\telse {"
NSQ_SOURCE_LINE 00001061 "\t\t$Test->diag( \"file [$file] is not a symlink\" );"
NSQ_SOURCE_LINE 00001062 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00001063 "\t\t}"
NSQ_SOURCE_LINE 00001064 "\t}"
NSQ_SOURCE_LINE 00001065 ""
NSQ_SOURCE_LINE 00001066 "=item file_is_not_symlink_ok( FILENAME [, NAME ] )"
NSQ_SOURCE_LINE 00001067 ""
NSQ_SOURCE_LINE 00001068 "Ok if FILENAME is a not symlink. This test automatically skips if the"
NSQ_SOURCE_LINE 00001069 "operating system does not support symlinks. If the file does not"
NSQ_SOURCE_LINE 00001070 "exist, the test fails."
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "=cut"
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 "sub file_is_not_symlink_ok {"
NSQ_SOURCE_LINE 00001075 "\tif( _no_symlinks_here() ) {"
NSQ_SOURCE_LINE 00001076 "\t\t$Test->skip("
NSQ_SOURCE_LINE 00001077 "\t\t\t\"file_is_symlink_ok doesn't work on systems without symlinks\" );"
NSQ_SOURCE_LINE 00001078 "\t\treturn;"
NSQ_SOURCE_LINE 00001079 "\t\t}"
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "\tmy $file = shift;"
NSQ_SOURCE_LINE 00001082 "\tmy $name = shift || \"$file is not a symlink\";"
NSQ_SOURCE_LINE 00001083 ""
NSQ_SOURCE_LINE 00001084 "\tunless( -e $file ) {"
NSQ_SOURCE_LINE 00001085 "\t\t$Test->diag( \"file [$file] does not exist\" );"
NSQ_SOURCE_LINE 00001086 "\t\treturn $Test->ok(0, $name);"
NSQ_SOURCE_LINE 00001087 "\t\t}"
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "\tif( ! -l $file ) {"
NSQ_SOURCE_LINE 00001090 "\t\t$Test->ok(1, $name)"
NSQ_SOURCE_LINE 00001091 "\t\t}"
NSQ_SOURCE_LINE 00001092 "\telse {"
NSQ_SOURCE_LINE 00001093 "\t\t$Test->diag( \"file [$file] is a symlink\" );"
NSQ_SOURCE_LINE 00001094 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00001095 "\t\t}"
NSQ_SOURCE_LINE 00001096 "\t}"
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "=item symlink_target_exists_ok( SYMLINK [, TARGET] [, NAME ] )"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "Ok if FILENAME is a symlink and it points to a existing file. With the"
NSQ_SOURCE_LINE 00001101 "optional TARGET argument, the test fails if SYMLINK's target is not"
NSQ_SOURCE_LINE 00001102 "TARGET. This test automatically skips if the operating system does not"
NSQ_SOURCE_LINE 00001103 "support symlinks. If the file does not exist, the test fails."
NSQ_SOURCE_LINE 00001104 ""
NSQ_SOURCE_LINE 00001105 "=cut"
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 "sub symlink_target_exists_ok {"
NSQ_SOURCE_LINE 00001108 "\tif( _no_symlinks_here() ) {"
NSQ_SOURCE_LINE 00001109 "\t\t$Test->skip("
NSQ_SOURCE_LINE 00001110 "\t\t\t\"symlink_target_exists_ok doesn't work on systems without symlinks\""
NSQ_SOURCE_LINE 00001111 "\t\t\t);"
NSQ_SOURCE_LINE 00001112 "\t\treturn;"
NSQ_SOURCE_LINE 00001113 "\t\t}"
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "\tmy $file = shift;"
NSQ_SOURCE_LINE 00001116 "\tmy $dest = shift || readlink( $file );"
NSQ_SOURCE_LINE 00001117 "\tmy $name = shift || \"$file is a symlink\";"
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 "\tunless( -l $file )"
NSQ_SOURCE_LINE 00001120 "\t\t{"
NSQ_SOURCE_LINE 00001121 "\t\t$Test->diag( \"file [$file] is not a symlink\" );"
NSQ_SOURCE_LINE 00001122 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001123 "\t\t}"
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "\tunless( -e $dest ) {"
NSQ_SOURCE_LINE 00001126 "\t\t$Test->diag( \"symlink [$file] points to non-existent target [$dest]\" );"
NSQ_SOURCE_LINE 00001127 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001128 "\t\t}"
NSQ_SOURCE_LINE 00001129 ""
NSQ_SOURCE_LINE 00001130 "\tmy $actual = readlink( $file );"
NSQ_SOURCE_LINE 00001131 "\tunless( $dest eq $actual ) {"
NSQ_SOURCE_LINE 00001132 "\t\t$Test->diag("
NSQ_SOURCE_LINE 00001133 "\t\t\t\"symlink [$file] points to\\n\" ."
NSQ_SOURCE_LINE 00001134 "\t\t\t\"         got: $actual\\n\" ."
NSQ_SOURCE_LINE 00001135 "\t\t\t\"    expected: $dest\\n\""
NSQ_SOURCE_LINE 00001136 "\t\t\t);"
NSQ_SOURCE_LINE 00001137 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001138 "\t\t}"
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "\t$Test->ok( 1, $name );"
NSQ_SOURCE_LINE 00001141 "\t}"
NSQ_SOURCE_LINE 00001142 ""
NSQ_SOURCE_LINE 00001143 "=item symlink_target_dangles_ok( SYMLINK [, NAME ] )"
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "Ok if FILENAME is a symlink and if it doesn't point to a existing"
NSQ_SOURCE_LINE 00001146 "file. This test automatically skips if the operating system does not"
NSQ_SOURCE_LINE 00001147 "support symlinks. If the file does not exist, the test fails."
NSQ_SOURCE_LINE 00001148 ""
NSQ_SOURCE_LINE 00001149 "=cut"
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "sub symlink_target_dangles_ok"
NSQ_SOURCE_LINE 00001152 "\t{"
NSQ_SOURCE_LINE 00001153 "\tif( _no_symlinks_here() ) {"
NSQ_SOURCE_LINE 00001154 "\t\t$Test->skip("
NSQ_SOURCE_LINE 00001155 "\t\t\t\"symlink_target_dangles_ok doesn't work on systems without symlinks\" );"
NSQ_SOURCE_LINE 00001156 "\t\treturn;"
NSQ_SOURCE_LINE 00001157 "\t\t}"
NSQ_SOURCE_LINE 00001158 ""
NSQ_SOURCE_LINE 00001159 "\tmy $file = shift;"
NSQ_SOURCE_LINE 00001160 "\tmy $dest = readlink( $file );"
NSQ_SOURCE_LINE 00001161 "\tmy $name = shift || \"$file is a symlink\";"
NSQ_SOURCE_LINE 00001162 ""
NSQ_SOURCE_LINE 00001163 "\tunless( -l $file ) {"
NSQ_SOURCE_LINE 00001164 "\t\t$Test->diag( \"file [$file] is not a symlink\" );"
NSQ_SOURCE_LINE 00001165 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001166 "\t\t}"
NSQ_SOURCE_LINE 00001167 ""
NSQ_SOURCE_LINE 00001168 "\tif( -e $dest ) {"
NSQ_SOURCE_LINE 00001169 "\t\t$Test->diag("
NSQ_SOURCE_LINE 00001170 "\t\t\t\"symlink [$file] points to existing file [$dest] but shouldn't\" );"
NSQ_SOURCE_LINE 00001171 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001172 "\t\t}"
NSQ_SOURCE_LINE 00001173 ""
NSQ_SOURCE_LINE 00001174 "\t$Test->ok( 1, $name );"
NSQ_SOURCE_LINE 00001175 "\t}"
NSQ_SOURCE_LINE 00001176 ""
NSQ_SOURCE_LINE 00001177 "=item symlink_target_is( SYMLINK, TARGET [, NAME ] )"
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "Ok if FILENAME is a symlink and if points to TARGET. This test"
NSQ_SOURCE_LINE 00001180 "automatically skips if the operating system does not support symlinks."
NSQ_SOURCE_LINE 00001181 "If the file does not exist, the test fails."
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "=cut"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "sub symlink_target_is {"
NSQ_SOURCE_LINE 00001186 "\tif( _no_symlinks_here() ) {"
NSQ_SOURCE_LINE 00001187 "\t\t$Test->skip("
NSQ_SOURCE_LINE 00001188 "\t\t\t\"symlink_target_is doesn't work on systems without symlinks\" );"
NSQ_SOURCE_LINE 00001189 "\t\treturn;"
NSQ_SOURCE_LINE 00001190 "\t\t}"
NSQ_SOURCE_LINE 00001191 ""
NSQ_SOURCE_LINE 00001192 "\tmy $file = shift;"
NSQ_SOURCE_LINE 00001193 "\tmy $dest = shift;"
NSQ_SOURCE_LINE 00001194 "\tmy $name = shift || \"symlink $file points to $dest\";"
NSQ_SOURCE_LINE 00001195 ""
NSQ_SOURCE_LINE 00001196 "\tunless( -l $file ) {"
NSQ_SOURCE_LINE 00001197 "\t\t$Test->diag( \"file [$file] is not a symlink\" );"
NSQ_SOURCE_LINE 00001198 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001199 "\t\t}"
NSQ_SOURCE_LINE 00001200 ""
NSQ_SOURCE_LINE 00001201 "\tmy $actual_dest = readlink( $file );"
NSQ_SOURCE_LINE 00001202 "\tmy $link_error  = $!;"
NSQ_SOURCE_LINE 00001203 ""
NSQ_SOURCE_LINE 00001204 "\tunless( defined $actual_dest ) {"
NSQ_SOURCE_LINE 00001205 "\t\t$Test->diag( \"symlink [$file] does not have a defined target\" );"
NSQ_SOURCE_LINE 00001206 "\t\t$Test->diag( \"readlink error: $link_error\" ) if defined $link_error;"
NSQ_SOURCE_LINE 00001207 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001208 "\t\t}"
NSQ_SOURCE_LINE 00001209 ""
NSQ_SOURCE_LINE 00001210 "\tif( $dest eq $actual_dest ) {"
NSQ_SOURCE_LINE 00001211 "\t\t$Test->ok( 1, $name );"
NSQ_SOURCE_LINE 00001212 "\t\t}"
NSQ_SOURCE_LINE 00001213 "\telse {"
NSQ_SOURCE_LINE 00001214 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001215 "\t\t$Test->diag(\"       got: $actual_dest\" );"
NSQ_SOURCE_LINE 00001216 "\t\t$Test->diag(\"  expected: $dest\" );"
NSQ_SOURCE_LINE 00001217 "\t\t}"
NSQ_SOURCE_LINE 00001218 "\t}"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "=item symlink_target_is_absolute_ok( SYMLINK [, NAME ] )"
NSQ_SOURCE_LINE 00001221 ""
NSQ_SOURCE_LINE 00001222 "Ok if FILENAME is a symlink and if its target is an absolute path."
NSQ_SOURCE_LINE 00001223 "This test automatically skips if the operating system does not support"
NSQ_SOURCE_LINE 00001224 "symlinks. If the file does not exist, the test fails."
NSQ_SOURCE_LINE 00001225 ""
NSQ_SOURCE_LINE 00001226 "=cut"
NSQ_SOURCE_LINE 00001227 ""
NSQ_SOURCE_LINE 00001228 "sub symlink_target_is_absolute_ok {"
NSQ_SOURCE_LINE 00001229 "\tif( _no_symlinks_here() ) {"
NSQ_SOURCE_LINE 00001230 "\t\t$Test->skip("
NSQ_SOURCE_LINE 00001231 "\t\t\t\"symlink_target_exists_ok doesn't work on systems without symlinks\" );"
NSQ_SOURCE_LINE 00001232 "\t\treturn;"
NSQ_SOURCE_LINE 00001233 "\t\t}"
NSQ_SOURCE_LINE 00001234 ""
NSQ_SOURCE_LINE 00001235 "\tmy( $from, $from_base, $to, $to_base, $name ) = @_;"
NSQ_SOURCE_LINE 00001236 "\tmy $link     = readlink( $from );"
NSQ_SOURCE_LINE 00001237 "\tmy $link_err = defined( $link ) ? '' : $!; # $! doesn't always get reset"
NSQ_SOURCE_LINE 00001238 "\tmy $link_abs = abs_path( rel2abs($link, $from_base) );"
NSQ_SOURCE_LINE 00001239 "\tmy $to_abs   = abs_path( rel2abs($to, $to_base) );"
NSQ_SOURCE_LINE 00001240 ""
NSQ_SOURCE_LINE 00001241 "\tif (defined( $link_abs ) && defined( $to_abs ) && $link_abs eq $to_abs) {"
NSQ_SOURCE_LINE 00001242 "\t\t$Test->ok( 1, $name );"
NSQ_SOURCE_LINE 00001243 "\t\t}"
NSQ_SOURCE_LINE 00001244 "\telse {"
NSQ_SOURCE_LINE 00001245 "\t\t$Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001246 "\t\t$link     ||= 'undefined';"
NSQ_SOURCE_LINE 00001247 "\t\t$link_abs ||= 'undefined';"
NSQ_SOURCE_LINE 00001248 "\t\t$to_abs   ||= 'undefined';"
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "\t\t$Test->diag(\"    link: $from\");"
NSQ_SOURCE_LINE 00001251 "\t\t$Test->diag(\"     got: $link\");"
NSQ_SOURCE_LINE 00001252 "\t\t$Test->diag(\"    (abs): $link_abs\");"
NSQ_SOURCE_LINE 00001253 "\t\t$Test->diag(\"  expected: $to\");"
NSQ_SOURCE_LINE 00001254 "\t\t$Test->diag(\"    (abs): $to_abs\");"
NSQ_SOURCE_LINE 00001255 "\t\t$Test->diag(\"  readlink() error: $link_err\") if ($link_err);"
NSQ_SOURCE_LINE 00001256 "\t\t}"
NSQ_SOURCE_LINE 00001257 "\t}"
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "=item dir_exists_ok( DIRECTORYNAME [, NAME ] )"
NSQ_SOURCE_LINE 00001260 ""
NSQ_SOURCE_LINE 00001261 "Ok if the file exists and is a directory, not ok if the file doesn't exist, or exists but isn't a"
NSQ_SOURCE_LINE 00001262 "directory."
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "Contributed by Buddy Burden C<< <barefoot@cpan.org> >>."
NSQ_SOURCE_LINE 00001265 ""
NSQ_SOURCE_LINE 00001266 "=cut"
NSQ_SOURCE_LINE 00001267 ""
NSQ_SOURCE_LINE 00001268 "sub dir_exists_ok {"
NSQ_SOURCE_LINE 00001269 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00001270 "\tmy $name     = shift || \"$filename is a directory\";"
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 "\tunless( -e $filename ) {"
NSQ_SOURCE_LINE 00001273 "\t\t$Test->diag( \"directory [$filename] does not exist\" );"
NSQ_SOURCE_LINE 00001274 "\t\treturn $Test->ok(0, $name);"
NSQ_SOURCE_LINE 00001275 "\t\t}"
NSQ_SOURCE_LINE 00001276 ""
NSQ_SOURCE_LINE 00001277 "\tmy $ok = -d $filename;"
NSQ_SOURCE_LINE 00001278 ""
NSQ_SOURCE_LINE 00001279 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00001280 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00001281 "\t\t}"
NSQ_SOURCE_LINE 00001282 "\telse {"
NSQ_SOURCE_LINE 00001283 "\t\t$Test->diag( \"file [$filename] exists but is not a directory\" );"
NSQ_SOURCE_LINE 00001284 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00001285 "\t\t}"
NSQ_SOURCE_LINE 00001286 "\t}"
NSQ_SOURCE_LINE 00001287 ""
NSQ_SOURCE_LINE 00001288 "=item dir_contains_ok( DIRECTORYNAME, FILENAME [, NAME ] )"
NSQ_SOURCE_LINE 00001289 ""
NSQ_SOURCE_LINE 00001290 "Ok if the directory exists and contains the file, not ok if the directory doesn't exist, or exists"
NSQ_SOURCE_LINE 00001291 "but doesn't contain the file."
NSQ_SOURCE_LINE 00001292 ""
NSQ_SOURCE_LINE 00001293 "Contributed by Buddy Burden C<< <barefoot@cpan.org> >>."
NSQ_SOURCE_LINE 00001294 ""
NSQ_SOURCE_LINE 00001295 "=cut"
NSQ_SOURCE_LINE 00001296 ""
NSQ_SOURCE_LINE 00001297 "sub dir_contains_ok {"
NSQ_SOURCE_LINE 00001298 "\tmy $dirname  = _normalize( shift );"
NSQ_SOURCE_LINE 00001299 "\tmy $filename = _normalize( shift );"
NSQ_SOURCE_LINE 00001300 "\tmy $name     = shift || \"directory $dirname contains file $filename\";"
NSQ_SOURCE_LINE 00001301 ""
NSQ_SOURCE_LINE 00001302 "\tunless( -d $dirname ) {"
NSQ_SOURCE_LINE 00001303 "\t\t$Test->diag( \"directory [$dirname] does not exist\" );"
NSQ_SOURCE_LINE 00001304 "\t\treturn $Test->ok(0, $name);"
NSQ_SOURCE_LINE 00001305 "\t\t}"
NSQ_SOURCE_LINE 00001306 ""
NSQ_SOURCE_LINE 00001307 "\tmy $ok = -e File::Spec->catfile($dirname, $filename);"
NSQ_SOURCE_LINE 00001308 ""
NSQ_SOURCE_LINE 00001309 "\tif( $ok ) {"
NSQ_SOURCE_LINE 00001310 "\t\t$Test->ok(1, $name);"
NSQ_SOURCE_LINE 00001311 "\t\t}"
NSQ_SOURCE_LINE 00001312 "\telse {"
NSQ_SOURCE_LINE 00001313 "\t\t$Test->diag( \"file [$filename] does not exist in directory $dirname\" );"
NSQ_SOURCE_LINE 00001314 "\t\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00001315 "\t\t}"
NSQ_SOURCE_LINE 00001316 "\t}"
NSQ_SOURCE_LINE 00001317 ""
NSQ_SOURCE_LINE 00001318 "=item link_count_is_ok( FILE, LINK_COUNT [, NAME ] )"
NSQ_SOURCE_LINE 00001319 ""
NSQ_SOURCE_LINE 00001320 "Ok if the link count to FILE is LINK_COUNT. LINK_COUNT is interpreted"
NSQ_SOURCE_LINE 00001321 "as an integer. A LINK_COUNT that evaluates to 0 returns Ok if the file"
NSQ_SOURCE_LINE 00001322 "does not exist."
NSQ_SOURCE_LINE 00001323 ""
NSQ_SOURCE_LINE 00001324 ""
NSQ_SOURCE_LINE 00001325 "=cut"
NSQ_SOURCE_LINE 00001326 ""
NSQ_SOURCE_LINE 00001327 "sub link_count_is_ok {"
NSQ_SOURCE_LINE 00001328 "\tmy $file   = shift;"
NSQ_SOURCE_LINE 00001329 "\tmy $count  = int( 0 + shift );"
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 "\tmy $name   = shift || \"$file has a link count of [$count]\";"
NSQ_SOURCE_LINE 00001332 ""
NSQ_SOURCE_LINE 00001333 "\tmy $actual = ( stat $file )[3];"
NSQ_SOURCE_LINE 00001334 ""
NSQ_SOURCE_LINE 00001335 "\tunless( $actual == $count ) {"
NSQ_SOURCE_LINE 00001336 "\t\t$Test->diag("
NSQ_SOURCE_LINE 00001337 "\t\t\t\"file [$file] points has [$actual] links: expected [$count]\" );"
NSQ_SOURCE_LINE 00001338 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001339 "\t\t}"
NSQ_SOURCE_LINE 00001340 ""
NSQ_SOURCE_LINE 00001341 "\t$Test->ok( 1, $name );"
NSQ_SOURCE_LINE 00001342 "\t}"
NSQ_SOURCE_LINE 00001343 ""
NSQ_SOURCE_LINE 00001344 "=item link_count_gt_ok( FILE, LINK_COUNT [, NAME ] )"
NSQ_SOURCE_LINE 00001345 ""
NSQ_SOURCE_LINE 00001346 "Ok if the link count to FILE is greater than LINK_COUNT. LINK_COUNT is"
NSQ_SOURCE_LINE 00001347 "interpreted as an integer. A LINK_COUNT that evaluates to 0 returns Ok"
NSQ_SOURCE_LINE 00001348 "if the file has at least one link."
NSQ_SOURCE_LINE 00001349 ""
NSQ_SOURCE_LINE 00001350 "=cut"
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "sub link_count_gt_ok {"
NSQ_SOURCE_LINE 00001353 "\tmy $file   = shift;"
NSQ_SOURCE_LINE 00001354 "\tmy $count  = int( 0 + shift );"
NSQ_SOURCE_LINE 00001355 ""
NSQ_SOURCE_LINE 00001356 "\tmy $name   = shift || \"$file has a link count of [$count]\";"
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 "\tmy $actual = (stat $file )[3];"
NSQ_SOURCE_LINE 00001359 ""
NSQ_SOURCE_LINE 00001360 "\tunless( $actual > $count ) {"
NSQ_SOURCE_LINE 00001361 "\t\t$Test->diag("
NSQ_SOURCE_LINE 00001362 "\t\t\t\"file [$file] points has [$actual] links: \"."
NSQ_SOURCE_LINE 00001363 "\t\t\t\"expected more than [$count]\" );"
NSQ_SOURCE_LINE 00001364 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001365 "\t\t}"
NSQ_SOURCE_LINE 00001366 ""
NSQ_SOURCE_LINE 00001367 "\t$Test->ok( 1, $name );"
NSQ_SOURCE_LINE 00001368 "\t}"
NSQ_SOURCE_LINE 00001369 ""
NSQ_SOURCE_LINE 00001370 "=item link_count_lt_ok( FILE, LINK_COUNT [, NAME ] )"
NSQ_SOURCE_LINE 00001371 ""
NSQ_SOURCE_LINE 00001372 "Ok if the link count to FILE is less than LINK_COUNT. LINK_COUNT is"
NSQ_SOURCE_LINE 00001373 "interpreted as an integer. A LINK_COUNT that evaluates to 0 returns Ok"
NSQ_SOURCE_LINE 00001374 "if the file has at least one link."
NSQ_SOURCE_LINE 00001375 ""
NSQ_SOURCE_LINE 00001376 "=cut"
NSQ_SOURCE_LINE 00001377 ""
NSQ_SOURCE_LINE 00001378 "sub link_count_lt_ok {"
NSQ_SOURCE_LINE 00001379 "\tmy $file   = shift;"
NSQ_SOURCE_LINE 00001380 "\tmy $count  = int( 0 + shift );"
NSQ_SOURCE_LINE 00001381 ""
NSQ_SOURCE_LINE 00001382 "\tmy $name   = shift || \"$file has a link count of [$count]\";"
NSQ_SOURCE_LINE 00001383 ""
NSQ_SOURCE_LINE 00001384 "\tmy $actual = (stat $file )[3];"
NSQ_SOURCE_LINE 00001385 ""
NSQ_SOURCE_LINE 00001386 "\tunless( $actual < $count ) {"
NSQ_SOURCE_LINE 00001387 "\t\t$Test->diag("
NSQ_SOURCE_LINE 00001388 "\t\t\t\"file [$file] points has [$actual] links: \"."
NSQ_SOURCE_LINE 00001389 "\t\t\t\"expected less than [$count]\" );"
NSQ_SOURCE_LINE 00001390 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001391 "\t\t}"
NSQ_SOURCE_LINE 00001392 ""
NSQ_SOURCE_LINE 00001393 "\t$Test->ok( 1, $name );"
NSQ_SOURCE_LINE 00001394 "\t}"
NSQ_SOURCE_LINE 00001395 ""
NSQ_SOURCE_LINE 00001396 ""
NSQ_SOURCE_LINE 00001397 "# owner_is, owner_isnt, group_is and group_isnt are almost"
NSQ_SOURCE_LINE 00001398 "# identical in the beginning, so I'm writing a skeleton they can all use."
NSQ_SOURCE_LINE 00001399 "# I can't think of a better name..."
NSQ_SOURCE_LINE 00001400 "sub _dm_skeleton {"
NSQ_SOURCE_LINE 00001401 "\tno warnings 'uninitialized';"
NSQ_SOURCE_LINE 00001402 ""
NSQ_SOURCE_LINE 00001403 "\tif( _obviously_non_multi_user() ) {"
NSQ_SOURCE_LINE 00001404 "\t\tmy $calling_sub = (caller(1))[3];"
NSQ_SOURCE_LINE 00001405 "\t\t$Test->skip( $calling_sub . \" only works on a multi-user OS\" );"
NSQ_SOURCE_LINE 00001406 "\t\treturn 'skip';"
NSQ_SOURCE_LINE 00001407 "\t\t}"
NSQ_SOURCE_LINE 00001408 ""
NSQ_SOURCE_LINE 00001409 "\tmy $filename      = _normalize( shift );"
NSQ_SOURCE_LINE 00001410 "\tmy $testing_for   = shift;"
NSQ_SOURCE_LINE 00001411 "\tmy $name          = shift;"
NSQ_SOURCE_LINE 00001412 ""
NSQ_SOURCE_LINE 00001413 "\tunless( defined $filename ) {"
NSQ_SOURCE_LINE 00001414 "\t\t$Test->diag( \"file name not specified\" );"
NSQ_SOURCE_LINE 00001415 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001416 "\t\t}"
NSQ_SOURCE_LINE 00001417 ""
NSQ_SOURCE_LINE 00001418 "\tunless( -e $filename ) {"
NSQ_SOURCE_LINE 00001419 "\t\t$Test->diag( \"file [$filename] does not exist\" );"
NSQ_SOURCE_LINE 00001420 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001421 "\t\t}"
NSQ_SOURCE_LINE 00001422 ""
NSQ_SOURCE_LINE 00001423 "\treturn;"
NSQ_SOURCE_LINE 00001424 "\t}"
NSQ_SOURCE_LINE 00001425 ""
NSQ_SOURCE_LINE 00001426 "=item owner_is( FILE , OWNER [, NAME ] )"
NSQ_SOURCE_LINE 00001427 ""
NSQ_SOURCE_LINE 00001428 "Ok if FILE's owner is the same as OWNER.  OWNER may be a text user name"
NSQ_SOURCE_LINE 00001429 "or a numeric userid.  Test skips on Dos, and Mac OS <= 9."
NSQ_SOURCE_LINE 00001430 "If the file does not exist, the test fails."
NSQ_SOURCE_LINE 00001431 ""
NSQ_SOURCE_LINE 00001432 "Contributed by Dylan Martin"
NSQ_SOURCE_LINE 00001433 ""
NSQ_SOURCE_LINE 00001434 "=cut"
NSQ_SOURCE_LINE 00001435 ""
NSQ_SOURCE_LINE 00001436 "sub owner_is {"
NSQ_SOURCE_LINE 00001437 "\tmy $filename      = shift;"
NSQ_SOURCE_LINE 00001438 "\tmy $owner         = shift;"
NSQ_SOURCE_LINE 00001439 "\tmy $name          = shift || \"$filename belongs to $owner\";"
NSQ_SOURCE_LINE 00001440 ""
NSQ_SOURCE_LINE 00001441 "\tmy $err = _dm_skeleton( $filename, $owner, $name );"
NSQ_SOURCE_LINE 00001442 "\treturn if( defined( $err ) && $err eq 'skip' );"
NSQ_SOURCE_LINE 00001443 "\treturn $err if defined($err);"
NSQ_SOURCE_LINE 00001444 ""
NSQ_SOURCE_LINE 00001445 "\tmy $owner_uid = _get_uid( $owner );"
NSQ_SOURCE_LINE 00001446 "\tunless( defined $owner_uid ) {"
NSQ_SOURCE_LINE 00001447 "\t\t$Test->diag(\"user [$owner] does not exist on this system\");"
NSQ_SOURCE_LINE 00001448 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001449 "\t\t}"
NSQ_SOURCE_LINE 00001450 ""
NSQ_SOURCE_LINE 00001451 "\tmy $file_uid = ( stat $filename )[4];"
NSQ_SOURCE_LINE 00001452 ""
NSQ_SOURCE_LINE 00001453 "\tunless( defined $file_uid ) {"
NSQ_SOURCE_LINE 00001454 "\t\t$Test->skip(\"stat failed to return owner uid for $filename\");"
NSQ_SOURCE_LINE 00001455 "\t\treturn;"
NSQ_SOURCE_LINE 00001456 "\t\t}"
NSQ_SOURCE_LINE 00001457 ""
NSQ_SOURCE_LINE 00001458 "\treturn $Test->ok( 1, $name ) if $file_uid == $owner_uid;"
NSQ_SOURCE_LINE 00001459 ""
NSQ_SOURCE_LINE 00001460 "\tmy $real_owner = ( getpwuid $file_uid )[0];"
NSQ_SOURCE_LINE 00001461 "\tunless( defined $real_owner ) {"
NSQ_SOURCE_LINE 00001462 "\t\t$Test->diag(\"file does not belong to $owner\");"
NSQ_SOURCE_LINE 00001463 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001464 "\t\t}"
NSQ_SOURCE_LINE 00001465 ""
NSQ_SOURCE_LINE 00001466 "\t$Test->diag( \"file [$filename] belongs to $real_owner ($file_uid), \"."
NSQ_SOURCE_LINE 00001467 "\t\t\t\"not $owner ($owner_uid)\" );"
NSQ_SOURCE_LINE 00001468 "\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001469 "\t}"
NSQ_SOURCE_LINE 00001470 ""
NSQ_SOURCE_LINE 00001471 "=item owner_isnt( FILE, OWNER [, NAME ] )"
NSQ_SOURCE_LINE 00001472 ""
NSQ_SOURCE_LINE 00001473 "Ok if FILE's owner is not the same as OWNER.  OWNER may be a text user name"
NSQ_SOURCE_LINE 00001474 "or a numeric userid.  Test skips on Dos and Mac OS <= 9.  If the file"
NSQ_SOURCE_LINE 00001475 "does not exist, the test fails."
NSQ_SOURCE_LINE 00001476 ""
NSQ_SOURCE_LINE 00001477 "Contributed by Dylan Martin"
NSQ_SOURCE_LINE 00001478 ""
NSQ_SOURCE_LINE 00001479 "=cut"
NSQ_SOURCE_LINE 00001480 ""
NSQ_SOURCE_LINE 00001481 "sub owner_isnt {"
NSQ_SOURCE_LINE 00001482 "\tmy $filename      = shift;"
NSQ_SOURCE_LINE 00001483 "\tmy $owner         = shift;"
NSQ_SOURCE_LINE 00001484 "\tmy $name          = shift || \"$filename doesn't belong to $owner\";"
NSQ_SOURCE_LINE 00001485 ""
NSQ_SOURCE_LINE 00001486 "\tmy $err = _dm_skeleton( $filename, $owner, $name );"
NSQ_SOURCE_LINE 00001487 "\treturn if( defined( $err ) && $err eq 'skip' );"
NSQ_SOURCE_LINE 00001488 "\treturn $err if defined($err);"
NSQ_SOURCE_LINE 00001489 ""
NSQ_SOURCE_LINE 00001490 "\tmy $owner_uid = _get_uid( $owner );"
NSQ_SOURCE_LINE 00001491 "\tunless( defined $owner_uid ) {"
NSQ_SOURCE_LINE 00001492 "\t\treturn $Test->ok( 1, $name );"
NSQ_SOURCE_LINE 00001493 "\t\t}"
NSQ_SOURCE_LINE 00001494 ""
NSQ_SOURCE_LINE 00001495 "\tmy $file_uid  = ( stat $filename )[4];"
NSQ_SOURCE_LINE 00001496 ""
NSQ_SOURCE_LINE 00001497 "\t#$Test->diag( \"owner_isnt: $owner_uid $file_uid\" );"
NSQ_SOURCE_LINE 00001498 "\treturn $Test->ok( 1, $name ) if $file_uid != $owner_uid;"
NSQ_SOURCE_LINE 00001499 ""
NSQ_SOURCE_LINE 00001500 "\t$Test->diag( \"file [$filename] belongs to $owner ($owner_uid)\" );"
NSQ_SOURCE_LINE 00001501 "\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001502 "\t}"
NSQ_SOURCE_LINE 00001503 ""
NSQ_SOURCE_LINE 00001504 "=item group_is( FILE , GROUP [, NAME ] )"
NSQ_SOURCE_LINE 00001505 ""
NSQ_SOURCE_LINE 00001506 "Ok if FILE's group is the same as GROUP.  GROUP may be a text group name or"
NSQ_SOURCE_LINE 00001507 "a numeric group id.  Test skips on Dos, Mac OS <= 9 and any other operating"
NSQ_SOURCE_LINE 00001508 "systems that do not support getpwuid() and friends.  If the file does not"
NSQ_SOURCE_LINE 00001509 "exist, the test fails."
NSQ_SOURCE_LINE 00001510 ""
NSQ_SOURCE_LINE 00001511 "Contributed by Dylan Martin"
NSQ_SOURCE_LINE 00001512 ""
NSQ_SOURCE_LINE 00001513 "=cut"
NSQ_SOURCE_LINE 00001514 ""
NSQ_SOURCE_LINE 00001515 "sub group_is {"
NSQ_SOURCE_LINE 00001516 "\tmy $filename      = shift;"
NSQ_SOURCE_LINE 00001517 "\tmy $group         = shift;"
NSQ_SOURCE_LINE 00001518 "\tmy $name          = ( shift || \"$filename belongs to group $group\" );"
NSQ_SOURCE_LINE 00001519 ""
NSQ_SOURCE_LINE 00001520 "\tmy $err = _dm_skeleton( $filename, $group, $name );"
NSQ_SOURCE_LINE 00001521 "\treturn if( defined( $err ) && $err eq 'skip' );"
NSQ_SOURCE_LINE 00001522 "\treturn $err if defined($err);"
NSQ_SOURCE_LINE 00001523 ""
NSQ_SOURCE_LINE 00001524 "\tmy $group_gid = _get_gid( $group );"
NSQ_SOURCE_LINE 00001525 "\tunless( defined $group_gid ) {"
NSQ_SOURCE_LINE 00001526 "\t\t$Test->diag(\"group [$group] does not exist on this system\");"
NSQ_SOURCE_LINE 00001527 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001528 "\t\t}"
NSQ_SOURCE_LINE 00001529 ""
NSQ_SOURCE_LINE 00001530 "\tmy $file_gid  = ( stat $filename )[5];"
NSQ_SOURCE_LINE 00001531 ""
NSQ_SOURCE_LINE 00001532 "\tunless( defined $file_gid ) {"
NSQ_SOURCE_LINE 00001533 "\t\t$Test->skip(\"stat failed to return group gid for $filename\");"
NSQ_SOURCE_LINE 00001534 "\t\treturn;"
NSQ_SOURCE_LINE 00001535 "\t\t}"
NSQ_SOURCE_LINE 00001536 ""
NSQ_SOURCE_LINE 00001537 "\treturn $Test->ok( 1, $name ) if $file_gid == $group_gid;"
NSQ_SOURCE_LINE 00001538 ""
NSQ_SOURCE_LINE 00001539 "\tmy $real_group = ( getgrgid $file_gid )[0];"
NSQ_SOURCE_LINE 00001540 "\tunless( defined $real_group ) {"
NSQ_SOURCE_LINE 00001541 "\t\t$Test->diag(\"file does not belong to $group\");"
NSQ_SOURCE_LINE 00001542 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001543 "\t\t}"
NSQ_SOURCE_LINE 00001544 ""
NSQ_SOURCE_LINE 00001545 "\t$Test->diag( \"file [$filename] belongs to $real_group ($file_gid), \"."
NSQ_SOURCE_LINE 00001546 "\t\t\t\"not $group ($group_gid)\" );"
NSQ_SOURCE_LINE 00001547 ""
NSQ_SOURCE_LINE 00001548 "\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001549 "\t}"
NSQ_SOURCE_LINE 00001550 ""
NSQ_SOURCE_LINE 00001551 "=item group_isnt( FILE , GROUP [, NAME ] )"
NSQ_SOURCE_LINE 00001552 ""
NSQ_SOURCE_LINE 00001553 "Ok if FILE's group is not the same as GROUP.  GROUP may be a text group name or"
NSQ_SOURCE_LINE 00001554 "a numeric group id.  Test skips on Dos, Mac OS <= 9 and any other operating"
NSQ_SOURCE_LINE 00001555 "systems that do not support getpwuid() and friends.  If the file does not"
NSQ_SOURCE_LINE 00001556 "exist, the test fails."
NSQ_SOURCE_LINE 00001557 ""
NSQ_SOURCE_LINE 00001558 "Contributed by Dylan Martin"
NSQ_SOURCE_LINE 00001559 ""
NSQ_SOURCE_LINE 00001560 "=cut"
NSQ_SOURCE_LINE 00001561 ""
NSQ_SOURCE_LINE 00001562 "sub group_isnt {"
NSQ_SOURCE_LINE 00001563 "\tmy $filename      = shift;"
NSQ_SOURCE_LINE 00001564 "\tmy $group         = shift;"
NSQ_SOURCE_LINE 00001565 "\tmy $name          = shift || \"$filename does not belong to group $group\";"
NSQ_SOURCE_LINE 00001566 ""
NSQ_SOURCE_LINE 00001567 "\tmy $err = _dm_skeleton( $filename, $group, $name );"
NSQ_SOURCE_LINE 00001568 "\treturn if( defined( $err ) && $err eq 'skip' );"
NSQ_SOURCE_LINE 00001569 "\treturn $err if defined($err);"
NSQ_SOURCE_LINE 00001570 ""
NSQ_SOURCE_LINE 00001571 "\tmy $group_gid = _get_gid( $group );"
NSQ_SOURCE_LINE 00001572 "\tmy $file_gid  = ( stat $filename )[5];"
NSQ_SOURCE_LINE 00001573 ""
NSQ_SOURCE_LINE 00001574 "\tunless( defined $file_gid ) {"
NSQ_SOURCE_LINE 00001575 "\t\t$Test->skip(\"stat failed to return group gid for $filename\");"
NSQ_SOURCE_LINE 00001576 "\t\treturn;"
NSQ_SOURCE_LINE 00001577 "\t\t}"
NSQ_SOURCE_LINE 00001578 ""
NSQ_SOURCE_LINE 00001579 "\treturn $Test->ok( 1, $name ) if $file_gid != $group_gid;"
NSQ_SOURCE_LINE 00001580 ""
NSQ_SOURCE_LINE 00001581 "\t$Test->diag( \"file [$filename] belongs to $group ($group_gid)\" );"
NSQ_SOURCE_LINE 00001582 "\t\treturn $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00001583 "\t}"
NSQ_SOURCE_LINE 00001584 ""
NSQ_SOURCE_LINE 00001585 "sub _get_uid {"
NSQ_SOURCE_LINE 00001586 "\tmy $arg = shift;"
NSQ_SOURCE_LINE 00001587 ""
NSQ_SOURCE_LINE 00001588 "\t# the name might be numeric (why would you do that?), so we need"
NSQ_SOURCE_LINE 00001589 "\t# to figure out which of several possibilities we have. And, 0 means"
NSQ_SOURCE_LINE 00001590 "\t# root, so we have to be very careful with the values."
NSQ_SOURCE_LINE 00001591 ""
NSQ_SOURCE_LINE 00001592 "\t# maybe the argument is a UID. First, it has to be numeric. If it's"
NSQ_SOURCE_LINE 00001593 "\t# a UID, we'll get the same UID back. But, if we get back a value"
NSQ_SOURCE_LINE 00001594 "\t# that doesn't mean that we are done. There might be a name with"
NSQ_SOURCE_LINE 00001595 "\t# the same value."
NSQ_SOURCE_LINE 00001596 "\t#"
NSQ_SOURCE_LINE 00001597 "\t# Don't use this value in comparisons! An undef could be turned"
NSQ_SOURCE_LINE 00001598 "\t# into zero!"
NSQ_SOURCE_LINE 00001599 "\tmy $from_uid = (getpwuid($arg))[2] if $arg =~ /\\A[0-9]+\\z/;"
NSQ_SOURCE_LINE 00001600 ""
NSQ_SOURCE_LINE 00001601 "\t# Now try the argument as a name. If it's a name, then we'll get"
NSQ_SOURCE_LINE 00001602 "\t# back a UID. Maybe we get back nothing."
NSQ_SOURCE_LINE 00001603 "\tmy $from_nam = (getpwnam($arg))[2];"
NSQ_SOURCE_LINE 00001604 ""
NSQ_SOURCE_LINE 00001605 "\treturn do {"
NSQ_SOURCE_LINE 00001606 "\t\t# first case, we got back nothing from getpwnam but did get"
NSQ_SOURCE_LINE 00001607 "\t\t# something from getpwuid. The arg is not a name and is a"
NSQ_SOURCE_LINE 00001608 "\t\t# UID."
NSQ_SOURCE_LINE 00001609 "\t\t   if( defined $from_uid and not defined $from_nam ) { $arg }"
NSQ_SOURCE_LINE 00001610 "\t\t# second case, we got back nothing from getpwuid but did get"
NSQ_SOURCE_LINE 00001611 "\t\t# something from getpwnam. The arg is a name and is not a"
NSQ_SOURCE_LINE 00001612 "\t\t# UID."
NSQ_SOURCE_LINE 00001613 "\t\telsif( not defined $from_uid and defined $from_nam ) { $from_nam }"
NSQ_SOURCE_LINE 00001614 "\t\t# Now, what happens if neither are defined? The argument does"
NSQ_SOURCE_LINE 00001615 "\t\t# not correspond to a name or GID on the system. Since no such"
NSQ_SOURCE_LINE 00001616 "\t\t# user exists, we return undef."
NSQ_SOURCE_LINE 00001617 "\t\telsif( not defined $from_uid and not defined $from_nam ) { undef }"
NSQ_SOURCE_LINE 00001618 "\t\t# But what if they are both defined? The argument could represent"
NSQ_SOURCE_LINE 00001619 "\t\t# a UID and a name, and those could be different users! In this"
NSQ_SOURCE_LINE 00001620 "\t\t# case, we'll choose the original argument. That might be wrong,"
NSQ_SOURCE_LINE 00001621 "\t\t# so the best we can do is a warning."
NSQ_SOURCE_LINE 00001622 "\t\telse {"
NSQ_SOURCE_LINE 00001623 "\t\t\tcarp( \"Found both a UID or name for <$arg>. Guessing the UID is <$arg>.\" );"
NSQ_SOURCE_LINE 00001624 "\t\t\t$arg"
NSQ_SOURCE_LINE 00001625 "\t\t\t}"
NSQ_SOURCE_LINE 00001626 "\t\t};"
NSQ_SOURCE_LINE 00001627 "\t}"
NSQ_SOURCE_LINE 00001628 ""
NSQ_SOURCE_LINE 00001629 "sub _get_gid {"
NSQ_SOURCE_LINE 00001630 "\tmy $arg = shift;"
NSQ_SOURCE_LINE 00001631 ""
NSQ_SOURCE_LINE 00001632 "\t# the name might be numeric (why would you do that?), so we need"
NSQ_SOURCE_LINE 00001633 "\t# to figure out which of several possibilities we have. And, 0 means"
NSQ_SOURCE_LINE 00001634 "\t# root, so we have to be very careful with the values."
NSQ_SOURCE_LINE 00001635 ""
NSQ_SOURCE_LINE 00001636 "\t# maybe the argument is a GID. First, it has to be numeric. If it's"
NSQ_SOURCE_LINE 00001637 "\t# a GID, we'll get the same GID back. But, if we get back a value"
NSQ_SOURCE_LINE 00001638 "\t# that doesn't mean that we are done. There might be a name with"
NSQ_SOURCE_LINE 00001639 "\t# the same value."
NSQ_SOURCE_LINE 00001640 "\t#"
NSQ_SOURCE_LINE 00001641 "\t# Don't use this value in comparisons! An undef could be turned"
NSQ_SOURCE_LINE 00001642 "\t# into zero!"
NSQ_SOURCE_LINE 00001643 "\tmy $from_gid = (getgrgid($arg))[2] if $arg =~ /\\A[0-9]+\\z/;"
NSQ_SOURCE_LINE 00001644 ""
NSQ_SOURCE_LINE 00001645 "\t# Now try the argument as a name. If it's a name, then we'll get"
NSQ_SOURCE_LINE 00001646 "\t# back a GID. Maybe we get back nothing."
NSQ_SOURCE_LINE 00001647 "\tmy $from_nam = (getgrnam($arg))[2];"
NSQ_SOURCE_LINE 00001648 ""
NSQ_SOURCE_LINE 00001649 "\treturn do {"
NSQ_SOURCE_LINE 00001650 "\t\t# first case, we got back nothing from getgrnam but did get"
NSQ_SOURCE_LINE 00001651 "\t\t# something from getpwuid. The arg is not a name and is a"
NSQ_SOURCE_LINE 00001652 "\t\t# GID."
NSQ_SOURCE_LINE 00001653 "\t\t   if( defined $from_gid and not defined $from_nam ) { $arg }"
NSQ_SOURCE_LINE 00001654 "\t\t# second case, we got back nothing from getgrgid but did get"
NSQ_SOURCE_LINE 00001655 "\t\t# something from getgrnam. The arg is a name and is not a"
NSQ_SOURCE_LINE 00001656 "\t\t# GID."
NSQ_SOURCE_LINE 00001657 "\t\telsif( not defined $from_gid and defined $from_nam ) { $from_nam }"
NSQ_SOURCE_LINE 00001658 "\t\t# Now, what happens if neither are defined? The argument does"
NSQ_SOURCE_LINE 00001659 "\t\t# not correspond to a name or GID on the system. Since no such"
NSQ_SOURCE_LINE 00001660 "\t\t# user exists, we return undef."
NSQ_SOURCE_LINE 00001661 "\t\telsif( not defined $from_gid and not defined $from_nam ) { undef }"
NSQ_SOURCE_LINE 00001662 "\t\t# But what if they are both defined? The argument could represent"
NSQ_SOURCE_LINE 00001663 "\t\t# a GID and a name, and those could be different users! In this"
NSQ_SOURCE_LINE 00001664 "\t\t# case, we'll choose the original argument. That might be wrong,"
NSQ_SOURCE_LINE 00001665 "\t\t# so the best we can do is a warning."
NSQ_SOURCE_LINE 00001666 "\t\telse {"
NSQ_SOURCE_LINE 00001667 "\t\t\tcarp( \"Found both a GID or name for <$arg>. Guessing the GID is <$arg>.\" );"
NSQ_SOURCE_LINE 00001668 "\t\t\t$arg;"
NSQ_SOURCE_LINE 00001669 "\t\t\t}"
NSQ_SOURCE_LINE 00001670 "\t\t};"
NSQ_SOURCE_LINE 00001671 "\t}"
NSQ_SOURCE_LINE 00001672 ""
NSQ_SOURCE_LINE 00001673 "=item file_mtime_age_ok( FILE [, WITHIN_SECONDS ] [, NAME ] )"
NSQ_SOURCE_LINE 00001674 ""
NSQ_SOURCE_LINE 00001675 "Ok if FILE's modified time is WITHIN_SECONDS inclusive of the system's current time."
NSQ_SOURCE_LINE 00001676 "This test uses stat() to obtain the mtime. If the file does not exist the test"
NSQ_SOURCE_LINE 00001677 "returns failure. If stat() fails, the test is skipped."
NSQ_SOURCE_LINE 00001678 ""
NSQ_SOURCE_LINE 00001679 "=cut"
NSQ_SOURCE_LINE 00001680 ""
NSQ_SOURCE_LINE 00001681 "sub file_mtime_age_ok {"
NSQ_SOURCE_LINE 00001682 "\tmy $filename    = shift;"
NSQ_SOURCE_LINE 00001683 "\tmy $within_secs = shift || 0;"
NSQ_SOURCE_LINE 00001684 "\tmy $name        = shift || \"$filename mtime within $within_secs seconds of current time\";"
NSQ_SOURCE_LINE 00001685 ""
NSQ_SOURCE_LINE 00001686 "\tmy $time        = time();"
NSQ_SOURCE_LINE 00001687 ""
NSQ_SOURCE_LINE 00001688 "\tmy $filetime = _stat_file($filename, 9);"
NSQ_SOURCE_LINE 00001689 ""
NSQ_SOURCE_LINE 00001690 "\treturn if ( $filetime == -1 ); #skip"
NSQ_SOURCE_LINE 00001691 ""
NSQ_SOURCE_LINE 00001692 "\treturn $Test->ok(1, $name) if ( $filetime + $within_secs > $time-1  );"
NSQ_SOURCE_LINE 00001693 ""
NSQ_SOURCE_LINE 00001694 "\t$Test->diag( \"file [$filename] mtime [$filetime] is not $within_secs seconds within current system time [$time].\");"
NSQ_SOURCE_LINE 00001695 "\treturn $Test->ok(0, $name);"
NSQ_SOURCE_LINE 00001696 "\t}"
NSQ_SOURCE_LINE 00001697 ""
NSQ_SOURCE_LINE 00001698 "=item file_mtime_gt_ok( FILE, UNIXTIME [, NAME ] )"
NSQ_SOURCE_LINE 00001699 ""
NSQ_SOURCE_LINE 00001700 "Ok if FILE's mtime is > UNIXTIME. This test uses stat() to get the mtime. If stat() fails"
NSQ_SOURCE_LINE 00001701 "this test is skipped. If FILE does not exist, this test fails."
NSQ_SOURCE_LINE 00001702 ""
NSQ_SOURCE_LINE 00001703 "=cut"
NSQ_SOURCE_LINE 00001704 ""
NSQ_SOURCE_LINE 00001705 "sub file_mtime_gt_ok {"
NSQ_SOURCE_LINE 00001706 "\tmy $filename    = shift;"
NSQ_SOURCE_LINE 00001707 "\tmy $time        = int shift;"
NSQ_SOURCE_LINE 00001708 "\tmy $name        = shift || \"$filename mtime is greater than unix timestamp $time\";"
NSQ_SOURCE_LINE 00001709 ""
NSQ_SOURCE_LINE 00001710 "\tmy $filetime = _stat_file($filename, 9);"
NSQ_SOURCE_LINE 00001711 ""
NSQ_SOURCE_LINE 00001712 "\treturn if ( $filetime == -1 ); #skip"
NSQ_SOURCE_LINE 00001713 ""
NSQ_SOURCE_LINE 00001714 "\treturn $Test->ok(1, $name) if ( $filetime > $time );"
NSQ_SOURCE_LINE 00001715 ""
NSQ_SOURCE_LINE 00001716 "\t$Test->diag( \"file [$filename] mtime [$filetime] not greater than $time\" );"
NSQ_SOURCE_LINE 00001717 "\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00001718 "\t}"
NSQ_SOURCE_LINE 00001719 ""
NSQ_SOURCE_LINE 00001720 "=item file_mtime_lt_ok( FILE, UNIXTIME, [, NAME ] )"
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "Ok if FILE's modified time is < UNIXTIME.  This test uses stat() to get the mtime. If stat() fails"
NSQ_SOURCE_LINE 00001723 "this test is skipped. If FILE does not exist, this test fails."
NSQ_SOURCE_LINE 00001724 ""
NSQ_SOURCE_LINE 00001725 "=cut"
NSQ_SOURCE_LINE 00001726 ""
NSQ_SOURCE_LINE 00001727 "sub file_mtime_lt_ok {"
NSQ_SOURCE_LINE 00001728 "\tmy $filename = shift;"
NSQ_SOURCE_LINE 00001729 "\tmy $time = int shift;"
NSQ_SOURCE_LINE 00001730 "\tmy $name = shift || \"$filename mtime less than unix timestamp $time\";"
NSQ_SOURCE_LINE 00001731 ""
NSQ_SOURCE_LINE 00001732 "  # gets mtime"
NSQ_SOURCE_LINE 00001733 "\tmy $filetime = _stat_file($filename, 9);"
NSQ_SOURCE_LINE 00001734 ""
NSQ_SOURCE_LINE 00001735 "\treturn if ( $filetime == -1 ); #skip"
NSQ_SOURCE_LINE 00001736 ""
NSQ_SOURCE_LINE 00001737 "\treturn $Test->ok(1, $name) if ( $filetime < $time );"
NSQ_SOURCE_LINE 00001738 ""
NSQ_SOURCE_LINE 00001739 "\t$Test->diag( \"file [$filename] mtime [$filetime] not less than $time\" );"
NSQ_SOURCE_LINE 00001740 "\t$Test->ok(0, $name);"
NSQ_SOURCE_LINE 00001741 "\t}"
NSQ_SOURCE_LINE 00001742 ""
NSQ_SOURCE_LINE 00001743 "# private function to safely stat a file"
NSQ_SOURCE_LINE 00001744 "#"
NSQ_SOURCE_LINE 00001745 "# Arugments:"
NSQ_SOURCE_LINE 00001746 "# filename     file to perform on"
NSQ_SOURCE_LINE 00001747 "# attr_pos     pos of the array returned from stat we want to compare. perldoc -f stat"
NSQ_SOURCE_LINE 00001748 "#"
NSQ_SOURCE_LINE 00001749 "# Returns:"
NSQ_SOURCE_LINE 00001750 "# -1        - stat failed"
NSQ_SOURCE_LINE 00001751 "#  0        - failure (file doesn't exist etc)"
NSQ_SOURCE_LINE 00001752 "#  filetime - on success, time requested provided by stat"
NSQ_SOURCE_LINE 00001753 "#"
NSQ_SOURCE_LINE 00001754 "sub _stat_file {"
NSQ_SOURCE_LINE 00001755 "\tmy $filename    = _normalize( shift );"
NSQ_SOURCE_LINE 00001756 "\tmy $attr_pos    = shift;"
NSQ_SOURCE_LINE 00001757 ""
NSQ_SOURCE_LINE 00001758 "\tunless( defined $filename ) {"
NSQ_SOURCE_LINE 00001759 "\t\t$Test->diag( \"file name not specified\" );"
NSQ_SOURCE_LINE 00001760 "\t\treturn 0;"
NSQ_SOURCE_LINE 00001761 "\t\t}"
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 "\tunless( -e $filename ) {"
NSQ_SOURCE_LINE 00001764 "\t\t$Test->diag( \"file [$filename] does not exist\" );"
NSQ_SOURCE_LINE 00001765 "\t\treturn 0;"
NSQ_SOURCE_LINE 00001766 "\t\t}"
NSQ_SOURCE_LINE 00001767 ""
NSQ_SOURCE_LINE 00001768 "\tmy $filetime = ( stat($filename) )[$attr_pos];"
NSQ_SOURCE_LINE 00001769 ""
NSQ_SOURCE_LINE 00001770 "\tunless( $filetime ) {"
NSQ_SOURCE_LINE 00001771 "\t\t$Test->diag( \"stat of $filename failed\" );"
NSQ_SOURCE_LINE 00001772 "\t\treturn -1; #skip on stat failure"
NSQ_SOURCE_LINE 00001773 "\t\t}"
NSQ_SOURCE_LINE 00001774 ""
NSQ_SOURCE_LINE 00001775 "\treturn $filetime;"
NSQ_SOURCE_LINE 00001776 "\t}"
NSQ_SOURCE_LINE 00001777 ""
NSQ_SOURCE_LINE 00001778 "=back"
NSQ_SOURCE_LINE 00001779 ""
NSQ_SOURCE_LINE 00001780 "=head1 TO DO"
NSQ_SOURCE_LINE 00001781 ""
