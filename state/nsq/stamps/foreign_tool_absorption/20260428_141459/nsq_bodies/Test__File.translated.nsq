NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "our $VERSION = '1.995';"
NSQ_SOURCE_LINE 00000033 "XSLoader::load(__PACKAGE__, $VERSION) if $^O eq 'MSWin32';"
NSQ_SOURCE_LINE 00000034 ""
