NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "use strict;"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "our $imp_data_size = 0;"
NSQ_SOURCE_LINE 00000102 "our @ISA = qw( DBD::File::db );"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub set_versions {"
NSQ_SOURCE_LINE 00000105 "    my $this = shift;"
NSQ_SOURCE_LINE 00000106 "    $this->{csv_version} = $DBD::CSV::VERSION;"
NSQ_SOURCE_LINE 00000107 "    return $this->SUPER::set_versions ();"
NSQ_SOURCE_LINE 00000108 "    } # set_versions"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "my %csv_xs_attr;"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "sub init_valid_attributes {"
NSQ_SOURCE_LINE 00000113 "    my $dbh = shift;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    # Straight from Text::CSV_XS.pm"
NSQ_SOURCE_LINE 00000116 "    my @xs_attr = @c_SHORT;"
NSQ_SOURCE_LINE 00000117 "    @csv_xs_attr{@xs_attr} = ();"
NSQ_SOURCE_LINE 00000118 "    # Dynamically add \"new\" attributes - available in Text::CSV_XS-1.20"
NSQ_SOURCE_LINE 00000119 "    if (my @ka = eval { Text::CSV_XS->known_attributes }) {"
NSQ_SOURCE_LINE 00000120 "\tfor (grep { m/^[a-su-z]/ && !exists $csv_xs_attr{$_} } @ka) {"
NSQ_SOURCE_LINE 00000121 "\t    push @xs_attr => $_;"
NSQ_SOURCE_LINE 00000122 "\t    $csv_xs_attr{$_} = undef;"
NSQ_SOURCE_LINE 00000123 "\t    }"
NSQ_SOURCE_LINE 00000124 "\t};"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "    $dbh->{csv_xs_valid_attrs} = [ @xs_attr ];"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "    $dbh->{csv_valid_attrs} = { map {(\"csv_$_\" => 1 )} @xs_attr, qw("
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "\tclass tables in csv_in out csv_out skip_first_row"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "\tnull sep quote escape bom"
NSQ_SOURCE_LINE 00000133 "\t)};"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "    $dbh->{csv_readonly_attrs} = { };"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    $dbh->{csv_meta} = \"csv_tables\";"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    return $dbh->SUPER::init_valid_attributes ();"
NSQ_SOURCE_LINE 00000140 "    } # init_valid_attributes"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "sub get_csv_versions {"
NSQ_SOURCE_LINE 00000143 "    my ($dbh, $table) = @_;"
NSQ_SOURCE_LINE 00000144 "    $table ||= \"\";"
NSQ_SOURCE_LINE 00000145 "    my $class = $dbh->{ImplementorClass};"
NSQ_SOURCE_LINE 00000146 "    $class =~ s/::db$/::Table/;"
NSQ_SOURCE_LINE 00000147 "    my $meta;"
NSQ_SOURCE_LINE 00000148 "    $table and (undef, $meta) = $class->get_table_meta ($dbh, $table, 1);"
NSQ_SOURCE_LINE 00000149 "    unless ($meta) {"
NSQ_SOURCE_LINE 00000150 "\t$meta = {};"
NSQ_SOURCE_LINE 00000151 "\t$class->bootstrap_table_meta ($dbh, $meta, $table);"
NSQ_SOURCE_LINE 00000152 "\t}"
NSQ_SOURCE_LINE 00000153 "    my $dvsn  = eval { $meta->{csv_class}->VERSION (); };"
NSQ_SOURCE_LINE 00000154 "    my $dtype = $meta->{csv_class};"
NSQ_SOURCE_LINE 00000155 "    $dvsn and $dtype .= \" ($dvsn)\";"
NSQ_SOURCE_LINE 00000156 "    return sprintf \"%s using %s\", $dbh->{csv_version}, $dtype;"
NSQ_SOURCE_LINE 00000157 "    } # get_csv_versions"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "sub get_info {"
NSQ_SOURCE_LINE 00000160 "    my ($dbh, $info_type) = @_;"
NSQ_SOURCE_LINE 00000161 "    require  DBD::CSV::GetInfo;"
NSQ_SOURCE_LINE 00000162 "    my $v = $DBD::CSV::GetInfo::info{int ($info_type)};"
NSQ_SOURCE_LINE 00000163 "    ref $v eq \"CODE\" and $v = $v->($dbh);"
NSQ_SOURCE_LINE 00000164 "    return $v;"
NSQ_SOURCE_LINE 00000165 "    } # get_info"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "sub type_info_all {"
NSQ_SOURCE_LINE 00000168 "#   my $dbh = shift;"
NSQ_SOURCE_LINE 00000169 "    require   DBD::CSV::TypeInfo;"
NSQ_SOURCE_LINE 00000170 "    return [@$DBD::CSV::TypeInfo::type_info_all];"
NSQ_SOURCE_LINE 00000171 "    } # type_info_all"
