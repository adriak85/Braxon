NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub connect {"
NSQ_SOURCE_LINE 00000075 "    my ($drh, $dbname, $user, $auth, $attr) = @_;"
NSQ_SOURCE_LINE 00000076 "    if ($attr && ref $attr eq \"HASH\") {"
NSQ_SOURCE_LINE 00000077 "\t# Top-level aliasses"
NSQ_SOURCE_LINE 00000078 "\tforeach my $key (grep { exists $attr->{$_} } @f_SHORT) {"
NSQ_SOURCE_LINE 00000079 "\t    my $f_key = \"f_$key\";"
NSQ_SOURCE_LINE 00000080 "\t    exists $attr->{$f_key} and next;"
NSQ_SOURCE_LINE 00000081 "\t    $attr->{$f_key} = delete $attr->{$key};"
NSQ_SOURCE_LINE 00000082 "\t    }"
NSQ_SOURCE_LINE 00000083 "\tforeach my $key (grep { exists $attr->{$_} } @c_SHORT) {"
NSQ_SOURCE_LINE 00000084 "\t    my $c_key = \"csv_$key\";"
NSQ_SOURCE_LINE 00000085 "\t    exists $attr->{$c_key} and next;"
NSQ_SOURCE_LINE 00000086 "\t    $attr->{$c_key} = delete $attr->{$key};"
NSQ_SOURCE_LINE 00000087 "\t    }"
NSQ_SOURCE_LINE 00000088 "\t}"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    my $dbh = $drh->DBD::File::dr::connect ($dbname, $user, $auth, $attr);"
NSQ_SOURCE_LINE 00000091 "    $dbh and $dbh->{Active} = 1;"
NSQ_SOURCE_LINE 00000092 "    $dbh;"
NSQ_SOURCE_LINE 00000093 "    } # connect"
NSQ_SOURCE_LINE 00000094 ""
