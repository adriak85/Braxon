NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "use Text::CSV_XS ();"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "our @CSV_TYPES = ("
NSQ_SOURCE_LINE 00000052 "    Text::CSV_XS::IV (), # SQL_TINYINT"
NSQ_SOURCE_LINE 00000053 "    Text::CSV_XS::IV (), # SQL_BIGINT"
NSQ_SOURCE_LINE 00000054 "    Text::CSV_XS::PV (), # SQL_LONGVARBINARY"
NSQ_SOURCE_LINE 00000055 "    Text::CSV_XS::PV (), # SQL_VARBINARY"
