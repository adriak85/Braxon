NSQ_SOURCE_LINE 00000173 "# --- STATEMENT ----------------------------------------------------------------"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "package DBD::CSV::st;"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "use strict;"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "our $imp_data_size = 0;"
NSQ_SOURCE_LINE 00000180 "our @ISA = qw( DBD::File::st );"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "package DBD::CSV::Statement;"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "use strict;"
NSQ_SOURCE_LINE 00000185 "use Carp;"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "our @ISA = qw( DBD::File::Statement );"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "package DBD::CSV::Table;"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "use strict;"
NSQ_SOURCE_LINE 00000192 "use Carp;"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "our @ISA = qw( DBD::File::Table );"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "my %compat_map;"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "{   my %class_mapped;"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    sub _register_compat_map {"
NSQ_SOURCE_LINE 00000201 "\tmy $class = shift;"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "\tmy $x = 0;"
NSQ_SOURCE_LINE 00000204 "\tif (!%compat_map) {"
NSQ_SOURCE_LINE 00000205 "\t    $compat_map{$_} = \"f_$_\"   for @f_SHORT;"
NSQ_SOURCE_LINE 00000206 "\t    $compat_map{$_} = \"csv_$_\" for @c_SHORT;"
NSQ_SOURCE_LINE 00000207 "\t    $x++;"
NSQ_SOURCE_LINE 00000208 "\t    }"
NSQ_SOURCE_LINE 00000209 "\tif ($class and !$class_mapped{$class}++ and"
NSQ_SOURCE_LINE 00000210 "\t\tmy @ka = eval { $class->known_attributes }) {"
NSQ_SOURCE_LINE 00000211 "\t    # exclude types"
NSQ_SOURCE_LINE 00000212 "\t    $compat_map{$_} = \"csv_$_\" for grep m/^[a-su-z]/ => @ka;"
NSQ_SOURCE_LINE 00000213 "\t    $x++;"
NSQ_SOURCE_LINE 00000214 "\t    }"
NSQ_SOURCE_LINE 00000215 "\tif ($x) {"
NSQ_SOURCE_LINE 00000216 "\t    __PACKAGE__->register_compat_map (\\%compat_map);"
NSQ_SOURCE_LINE 00000217 "\t    }"
NSQ_SOURCE_LINE 00000218 "\t} # _register_compat_map"
NSQ_SOURCE_LINE 00000219 "    }"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "#sub DESTROY {"
NSQ_SOURCE_LINE 00000222 "#    my $self = shift or return;"
NSQ_SOURCE_LINE 00000223 "#"
NSQ_SOURCE_LINE 00000224 "#    $self->{meta} and delete $self->{meta}{csv_in};"
NSQ_SOURCE_LINE 00000225 "#    } # DESTROY"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "sub bootstrap_table_meta {"
NSQ_SOURCE_LINE 00000228 "    my ($self, $dbh, $meta, $table) = @_;"
NSQ_SOURCE_LINE 00000229 "    $meta->{csv_class} ||= $dbh->{csv_class} || \"Text::CSV_XS\";"
NSQ_SOURCE_LINE 00000230 "    $meta->{csv_eol}   ||= $dbh->{csv_eol}   || \"\\r\\n\";"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    _register_compat_map ($meta->{csv_class});"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "    exists $meta->{csv_skip_first_row} or"
NSQ_SOURCE_LINE 00000235 "\t$meta->{csv_skip_first_row} = $dbh->{csv_skip_first_row};"
NSQ_SOURCE_LINE 00000236 "    exists $meta->{csv_bom} or"
NSQ_SOURCE_LINE 00000237 "\t$meta->{csv_bom} = exists $dbh->{bom} ? $dbh->{bom} : $dbh->{csv_bom};"
NSQ_SOURCE_LINE 00000238 "    $self->SUPER::bootstrap_table_meta ($dbh, $meta, $table);"
NSQ_SOURCE_LINE 00000239 "    } # bootstrap_table_meta"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "sub init_table_meta {"
NSQ_SOURCE_LINE 00000242 "    my ($self, $dbh, $meta, $table) = @_;"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "    _register_compat_map ($meta->{csv_class});"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "    $self->SUPER::init_table_meta ($dbh, $table, $meta);"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "    my $csv_in = $meta->{csv_in} || $dbh->{csv_csv_in};"
NSQ_SOURCE_LINE 00000249 "    unless ($csv_in) {"
NSQ_SOURCE_LINE 00000250 "\tmy %opts = ( binary => 1, auto_diag => 1 );"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "\t# Allow specific Text::CSV_XS options"
NSQ_SOURCE_LINE 00000253 "\tforeach my $attr (@{$dbh->{csv_xs_valid_attrs}}) {"
NSQ_SOURCE_LINE 00000254 "\t    $attr eq \"eol\" and next; # Handles below"
NSQ_SOURCE_LINE 00000255 "\t    exists $dbh->{\"csv_$attr\"} and $opts{$attr} = $dbh->{\"csv_$attr\"};"
NSQ_SOURCE_LINE 00000256 "\t    }"
NSQ_SOURCE_LINE 00000257 "\t$dbh->{csv_null} || $meta->{csv_null} and"
NSQ_SOURCE_LINE 00000258 "\t    $opts{Text::CSV_XS->version < 1.18 ? \"always_quote\" : \"quote_empty\"} ="
NSQ_SOURCE_LINE 00000259 "\t    $opts{blank_is_undef} = 1;"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "\tmy $class = $meta->{csv_class};"
NSQ_SOURCE_LINE 00000262 "\tmy $eol   = $meta->{csv_eol};"
NSQ_SOURCE_LINE 00000263 "\t$eol =~ m/^\\A(?:[\\r\\n]|\\r\\n)\\Z/ or $opts{eol} = $eol;"
NSQ_SOURCE_LINE 00000264 "\tfor ([ \"sep\",    ',' ],"
NSQ_SOURCE_LINE 00000265 "\t     [ \"quote\",  '\"' ],"
NSQ_SOURCE_LINE 00000266 "\t     [ \"escape\", '\"' ],"
NSQ_SOURCE_LINE 00000267 "\t     ) {"
NSQ_SOURCE_LINE 00000268 "\t    my ($attr, $def) = ($_->[0].\"_char\", $_->[1]);"
NSQ_SOURCE_LINE 00000269 "\t    $opts{$attr} ="
NSQ_SOURCE_LINE 00000270 "\t\texists $meta->{$attr} ? $meta->{$attr} :"
NSQ_SOURCE_LINE 00000271 "\t\t    exists $dbh->{\"csv_$attr\"} ? $dbh->{\"csv_$attr\"} : $def;"
NSQ_SOURCE_LINE 00000272 "\t    }"
NSQ_SOURCE_LINE 00000273 "\t$meta->{csv_in}  = $class->new (\\%opts) or"
NSQ_SOURCE_LINE 00000274 "\t    $class->error_diag;"
NSQ_SOURCE_LINE 00000275 "\t$opts{eol} = $eol;"
NSQ_SOURCE_LINE 00000276 "\t$meta->{csv_out} = $class->new (\\%opts) or"
NSQ_SOURCE_LINE 00000277 "\t    $class->error_diag;"
NSQ_SOURCE_LINE 00000278 "\t}"
NSQ_SOURCE_LINE 00000279 "    } # init_table_meta"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "sub table_meta_attr_changed {"
NSQ_SOURCE_LINE 00000282 "    my ($class, $meta, $attr, $value) = @_;"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    _register_compat_map ($meta->{csv_class});"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "    (my $csv_attr = $attr) =~ s/^csv_//;"
NSQ_SOURCE_LINE 00000287 "    if (exists $csv_xs_attr{$csv_attr}) {"
NSQ_SOURCE_LINE 00000288 "\tfor (\"csv_in\", \"csv_out\") {"
NSQ_SOURCE_LINE 00000289 "\t    exists $meta->{$_} && exists $meta->{$_}{$csv_attr} and"
NSQ_SOURCE_LINE 00000290 "\t\t$meta->{$_}{$csv_attr} = $value;"
NSQ_SOURCE_LINE 00000291 "\t    }"
NSQ_SOURCE_LINE 00000292 "\t}"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "    $class->SUPER::table_meta_attr_changed ($meta, $attr, $value);"
NSQ_SOURCE_LINE 00000295 "    } # table_meta_attr_changed"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "sub open_data {"
NSQ_SOURCE_LINE 00000298 "    my ($self, $meta, $attrs, $flags) = @_;"
NSQ_SOURCE_LINE 00000299 "    $self->SUPER::open_file ($meta, $attrs, $flags);"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "    if ($meta && $meta->{fh}) {"
NSQ_SOURCE_LINE 00000302 "\t$attrs->{csv_csv_in}  = $meta->{csv_in};"
NSQ_SOURCE_LINE 00000303 "\t$attrs->{csv_csv_out} = $meta->{csv_out};"
NSQ_SOURCE_LINE 00000304 "\tif (my $types = $meta->{types}) {"
NSQ_SOURCE_LINE 00000305 "\t    # XXX $meta->{types} is nowhere assigned and should better $meta->{csv_types}"
NSQ_SOURCE_LINE 00000306 "\t    # The 'types' array contains DBI types, but we need types"
NSQ_SOURCE_LINE 00000307 "\t    # suitable for Text::CSV_XS."
NSQ_SOURCE_LINE 00000308 "\t    my $t = [];"
NSQ_SOURCE_LINE 00000309 "\t    for (@{$types}) {"
NSQ_SOURCE_LINE 00000310 "\t\t$_ = $_"
NSQ_SOURCE_LINE 00000311 "\t\t    ? $DBD::CSV::dr::CSV_TYPES[$_ + 6] || Text::CSV_XS::PV ()"
NSQ_SOURCE_LINE 00000312 "\t\t    : Text::CSV_XS::PV ();"
NSQ_SOURCE_LINE 00000313 "\t\tpush @$t, $_;"
NSQ_SOURCE_LINE 00000314 "\t\t}"
NSQ_SOURCE_LINE 00000315 "\t    $meta->{types} = $t;"
NSQ_SOURCE_LINE 00000316 "\t    }"
NSQ_SOURCE_LINE 00000317 "\tif (!$flags->{createMode}) {"
NSQ_SOURCE_LINE 00000318 "\t    my $array;"
NSQ_SOURCE_LINE 00000319 "\t    my $skipRows = defined $meta->{skip_rows}"
NSQ_SOURCE_LINE 00000320 "\t\t? $meta->{skip_rows}"
NSQ_SOURCE_LINE 00000321 "\t\t: defined $meta->{csv_skip_first_row}"
NSQ_SOURCE_LINE 00000322 "\t\t    ? 1"
NSQ_SOURCE_LINE 00000323 "\t\t    : exists $meta->{col_names} ? 0 : 1;"
NSQ_SOURCE_LINE 00000324 "\t    defined $meta->{skip_rows} or"
NSQ_SOURCE_LINE 00000325 "\t\t$meta->{skip_rows} = $skipRows;"
NSQ_SOURCE_LINE 00000326 "\t    if ($meta->{csv_bom}) {"
NSQ_SOURCE_LINE 00000327 "\t\tmy @hdr = $attrs->{csv_csv_in}->header ($meta->{fh}) or"
NSQ_SOURCE_LINE 00000328 "\t\t    croak \"Failed using the header row: \".$attrs->{csv_csv_in}->error_diag;"
NSQ_SOURCE_LINE 00000329 "\t\t$meta->{col_names} ||= \\@hdr;"
NSQ_SOURCE_LINE 00000330 "\t\t$skipRows and $skipRows = 0;"
NSQ_SOURCE_LINE 00000331 "\t\t}"
NSQ_SOURCE_LINE 00000332 "\t    if ($skipRows--) {"
NSQ_SOURCE_LINE 00000333 "\t\t$array = $attrs->{csv_csv_in}->getline ($meta->{fh}) or"
NSQ_SOURCE_LINE 00000334 "\t\t    croak \"Missing first row due to \".$attrs->{csv_csv_in}->error_diag;"
NSQ_SOURCE_LINE 00000335 "\t\tunless ($meta->{raw_header}) {"
NSQ_SOURCE_LINE 00000336 "\t\t    s/\\W/_/g for @$array;"
NSQ_SOURCE_LINE 00000337 "\t\t    }"
NSQ_SOURCE_LINE 00000338 "\t\tdefined $meta->{col_names} or"
NSQ_SOURCE_LINE 00000339 "\t\t    $meta->{col_names} = $array;"
NSQ_SOURCE_LINE 00000340 "\t\twhile ($skipRows--) {"
NSQ_SOURCE_LINE 00000341 "\t\t    $attrs->{csv_csv_in}->getline ($meta->{fh});"
NSQ_SOURCE_LINE 00000342 "\t\t    }"
NSQ_SOURCE_LINE 00000343 "\t\t}"
NSQ_SOURCE_LINE 00000344 "\t    # lockMode is set 1 for DELETE, INSERT or UPDATE"
NSQ_SOURCE_LINE 00000345 "\t    # no other case need seeking"
NSQ_SOURCE_LINE 00000346 "\t    $flags->{lockMode} and # $meta->{fh}->can (\"tell\") and"
NSQ_SOURCE_LINE 00000347 "\t\t$meta->{first_row_pos} = $meta->{fh}->tell ();"
NSQ_SOURCE_LINE 00000348 "\t    exists $meta->{col_names} and"
NSQ_SOURCE_LINE 00000349 "\t\t$array = $meta->{col_names};"
NSQ_SOURCE_LINE 00000350 "\t    if (!$meta->{col_names} || !@{$meta->{col_names}}) {"
NSQ_SOURCE_LINE 00000351 "\t\t# No column names given; fetch first row and create default"
NSQ_SOURCE_LINE 00000352 "\t\t# names."
NSQ_SOURCE_LINE 00000353 "\t\tmy $ar = $meta->{cached_row} ="
NSQ_SOURCE_LINE 00000354 "\t\t    $attrs->{csv_csv_in}->getline ($meta->{fh});"
NSQ_SOURCE_LINE 00000355 "\t\t$array = $meta->{col_names};"
NSQ_SOURCE_LINE 00000356 "\t\tpush @$array, map { \"col$_\" } 0 .. $#$ar;"
NSQ_SOURCE_LINE 00000357 "\t\t}"
NSQ_SOURCE_LINE 00000358 "\t    }"
NSQ_SOURCE_LINE 00000359 "\t}"
NSQ_SOURCE_LINE 00000360 "    } # open_file"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "no warnings 'once';"
NSQ_SOURCE_LINE 00000363 "$DBI::VERSION < 1.623 and"
NSQ_SOURCE_LINE 00000364 "    *open_file = \\&open_data;"
NSQ_SOURCE_LINE 00000365 "use warnings;"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "sub _csv_diag {"
NSQ_SOURCE_LINE 00000368 "    my @diag = $_[0]->error_diag;"
NSQ_SOURCE_LINE 00000369 "    for (2, 3) {"
NSQ_SOURCE_LINE 00000370 "\tdefined $diag[$_] or $diag[$_] = \"?\";"
NSQ_SOURCE_LINE 00000371 "\t}"
NSQ_SOURCE_LINE 00000372 "    return @diag;"
NSQ_SOURCE_LINE 00000373 "    } # _csv_diag"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "sub fetch_row {"
NSQ_SOURCE_LINE 00000376 "    my ($self, $data) = @_;"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "    my $tbl = $self->{meta};"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    exists $tbl->{cached_row} and"
NSQ_SOURCE_LINE 00000381 "\treturn $self->{row} = delete $tbl->{cached_row};"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "    my $csv = $self->{csv_csv_in} or"
NSQ_SOURCE_LINE 00000384 "\treturn do { $data->set_err ($DBI::stderr, \"Fetch from undefined handle\"); undef };"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "    my $fields = eval { $csv->getline ($tbl->{fh}) };"
NSQ_SOURCE_LINE 00000387 "    unless ($fields) {"
NSQ_SOURCE_LINE 00000388 "\t$csv->eof and return;"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "\tmy @diag = _csv_diag ($csv);"
NSQ_SOURCE_LINE 00000391 "\t$diag[0] == 2012 and return; # Also EOF (broken in Text::CSV_XS-1.10)"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "\tmy $file = $tbl->{f_fqfn};"
NSQ_SOURCE_LINE 00000394 "\tcroak \"Error $diag[0] while reading file $file: $diag[1] \\@ line $diag[3] pos $diag[2]\";"
NSQ_SOURCE_LINE 00000395 "\t}"
NSQ_SOURCE_LINE 00000396 "    @$fields < @{$tbl->{col_names}} and"
NSQ_SOURCE_LINE 00000397 "\tpush @$fields, (undef) x (@{$tbl->{col_names}} - @$fields);"
NSQ_SOURCE_LINE 00000398 "    $self->{row} = (@$fields ? $fields : undef);"
NSQ_SOURCE_LINE 00000399 "    } # fetch_row"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "sub push_row {"
NSQ_SOURCE_LINE 00000402 "    my ($self, $data, $fields) = @_;"
NSQ_SOURCE_LINE 00000403 "    my $tbl = $self->{meta};"
NSQ_SOURCE_LINE 00000404 "    my $csv = $self->{csv_csv_out};"
NSQ_SOURCE_LINE 00000405 "    my $fh  = $tbl->{fh};"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "    unless ($csv->print ($fh, $fields)) {"
NSQ_SOURCE_LINE 00000408 "\tmy @diag = _csv_diag ($csv);"
NSQ_SOURCE_LINE 00000409 "\tmy $file = $tbl->{f_fqfn};"
NSQ_SOURCE_LINE 00000410 "\treturn do { $data->set_err ($DBI::stderr,"
NSQ_SOURCE_LINE 00000411 "\t    \"Error $diag[0] while writing file $file: $diag[1] \\@ line $diag[3] pos $diag[2]\"); undef };"
NSQ_SOURCE_LINE 00000412 "\t}"
NSQ_SOURCE_LINE 00000413 "    1;"
NSQ_SOURCE_LINE 00000414 "    } # push_row"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "no warnings 'once';"
NSQ_SOURCE_LINE 00000417 "*push_names = \\&push_row;"
NSQ_SOURCE_LINE 00000418 "use warnings;"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "1;"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "__END__"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "=head1 NAME"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "DBD::CSV - DBI driver for CSV files"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "    use DBI;"
NSQ_SOURCE_LINE 00000431 "    # See \"Creating database handle\" below"
NSQ_SOURCE_LINE 00000432 "    $dbh = DBI->connect (\"dbi:CSV:\", undef, undef, {"
NSQ_SOURCE_LINE 00000433 "        f_ext      => \".csv/r\","
NSQ_SOURCE_LINE 00000434 "        RaiseError => 1,"
NSQ_SOURCE_LINE 00000435 "        }) or die \"Cannot connect: $DBI::errstr\";"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "    # Simple statements"
NSQ_SOURCE_LINE 00000438 "    $dbh->do (\"CREATE TABLE foo (id INTEGER, name CHAR (10))\");"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "    # Selecting"
NSQ_SOURCE_LINE 00000441 "    my $sth = $dbh->prepare (\"select * from foo\");"
NSQ_SOURCE_LINE 00000442 "    $sth->execute;"
NSQ_SOURCE_LINE 00000443 "    $sth->bind_columns (\\my ($id, $name));"
NSQ_SOURCE_LINE 00000444 "    while ($sth->fetch) {"
NSQ_SOURCE_LINE 00000445 "\tprint \"id: $id, name: $name\\n\";"
NSQ_SOURCE_LINE 00000446 "\t}"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "    # Updates"
NSQ_SOURCE_LINE 00000449 "    my $sth = $dbh->prepare (\"UPDATE foo SET name = ? WHERE id = ?\");"
NSQ_SOURCE_LINE 00000450 "    $sth->execute (\"DBI rocks!\", 1);"
NSQ_SOURCE_LINE 00000451 "    $sth->finish;"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "    $dbh->disconnect;"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "The DBD::CSV module is yet another driver for the DBI (Database independent"
NSQ_SOURCE_LINE 00000458 "interface for Perl). This one is based on the SQL \"engine\" SQL::Statement"
NSQ_SOURCE_LINE 00000459 "and the abstract DBI driver DBD::File and implements access to so-called"
NSQ_SOURCE_LINE 00000460 "CSV files (Comma Separated Values). Such files are often used for exporting"
NSQ_SOURCE_LINE 00000461 "MS Access and MS Excel data."
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "See L<DBI> for details on DBI, L<SQL::Statement> for details on"
NSQ_SOURCE_LINE 00000464 "SQL::Statement and L<DBD::File> for details on the base class DBD::File."
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "=head2 Prerequisites"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "The only system dependent feature that DBD::File uses, is the C<flock ()>"
NSQ_SOURCE_LINE 00000469 "function. Thus the module should run (in theory) on any system with"
NSQ_SOURCE_LINE 00000470 "a working C<flock ()>, in particular on all Unix machines and on Windows"
NSQ_SOURCE_LINE 00000471 "NT. Under Windows 95 and MacOS the use of C<flock ()> is disabled, thus"
NSQ_SOURCE_LINE 00000472 "the module should still be usable."
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "Unlike other DBI drivers, you don't need an external SQL engine or a"
NSQ_SOURCE_LINE 00000475 "running server. All you need are the following Perl modules, available"
NSQ_SOURCE_LINE 00000476 "from any CPAN mirror, for example"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "  http://search.cpan.org/"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "=over 4"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "=item DBI"
NSQ_SOURCE_LINE 00000483 "X<DBI>"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "A recent version of the L<DBI> (Database independent interface for Perl)."
NSQ_SOURCE_LINE 00000486 "See below why."
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "=item DBD::File"
NSQ_SOURCE_LINE 00000489 "X<DBD::File>"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "This is the base class for DBD::CSV, and it is part of the DBI"
NSQ_SOURCE_LINE 00000492 "distribution. As DBD::CSV requires a matching version of L<DBD::File>"
NSQ_SOURCE_LINE 00000493 "which is (partly) developed by the same team that maintains"
NSQ_SOURCE_LINE 00000494 "DBD::CSV. See META.json or Makefile.PL for the minimum versions."
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=item SQL::Statement"
NSQ_SOURCE_LINE 00000497 "X<SQL::Statement>"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "A simple SQL engine. This module defines all of the SQL syntax for"
NSQ_SOURCE_LINE 00000500 "DBD::CSV, new SQL support is added with each release so you should"
NSQ_SOURCE_LINE 00000501 "look for updates to SQL::Statement regularly."
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "It is possible to run C<DBD::CSV> without this module if you define"
NSQ_SOURCE_LINE 00000504 "the environment variable C<$DBI_SQL_NANO> to 1. This will reduce the"
NSQ_SOURCE_LINE 00000505 "SQL support a lot though. See L<DBI::SQL::Nano> for more details. Note"
NSQ_SOURCE_LINE 00000506 "that the test suite does only test in this mode in the development"
NSQ_SOURCE_LINE 00000507 "environment."
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=item Text::CSV_XS"
NSQ_SOURCE_LINE 00000510 "X<Text::CSV_XS>"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "This module is used to read and write rows in a CSV file."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=back"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=head2 Installation"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "Installing this module (and the prerequisites from above) is quite simple."
NSQ_SOURCE_LINE 00000519 "The simplest way is to install the bundle:"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "    $ cpan Bundle::DBD::CSV"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "Alternatively, you can name them all"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "    $ cpan Text::CSV_XS DBI DBD::CSV"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "or even trust C<cpan> to resolve all dependencies for you:"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "    $ cpan DBD::CSV"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "If you cannot, for whatever reason, use cpan, fetch all modules from"
NSQ_SOURCE_LINE 00000532 "CPAN, and build with a sequence like:"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "    gzip -d < DBD-CSV-0.40.tgz | tar xf -"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "(this is for Unix users, Windows users would prefer WinZip or something"
NSQ_SOURCE_LINE 00000537 "similar) and then enter the following:"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "    cd DBD-CSV-0.40"
NSQ_SOURCE_LINE 00000540 "    perl Makefile.PL"
NSQ_SOURCE_LINE 00000541 "    make test"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "If any tests fail, let us know. Otherwise go on with"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "    make install UNINST=1"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "Note that you almost definitely need root or administrator permissions."
NSQ_SOURCE_LINE 00000548 "If you don't have them, read the ExtUtils::MakeMaker man page for details"
NSQ_SOURCE_LINE 00000549 "on installing in your own directories. L<ExtUtils::MakeMaker>."
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "=head2 Supported SQL Syntax"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "All SQL processing for DBD::CSV is done by SQL::Statement. See"
NSQ_SOURCE_LINE 00000554 "L<SQL::Statement> for more specific information about its feature set."
NSQ_SOURCE_LINE 00000555 "Features include joins, aliases, built-in and user-defined functions,"
NSQ_SOURCE_LINE 00000556 "and more.  See L<SQL::Statement::Syntax> for a description of the SQL"
NSQ_SOURCE_LINE 00000557 "syntax supported in DBD::CSV."
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "Table- and column-names are case insensitive unless quoted. Column names"
NSQ_SOURCE_LINE 00000560 "will be sanitized unless L</raw_header> is true."
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "=head1 Using DBD::CSV with DBI"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "For most things, DBD-CSV operates the same as any DBI driver."
NSQ_SOURCE_LINE 00000565 "See L<DBI> for detailed usage."
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "=head2 Creating a database handle (connect)"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "Creating a database handle usually implies connecting to a database server."
NSQ_SOURCE_LINE 00000570 "Thus this command reads"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "    use DBI;"
NSQ_SOURCE_LINE 00000573 "    my $dbh = DBI->connect (\"dbi:CSV:\", \"\", \"\", {"
NSQ_SOURCE_LINE 00000574 "\tf_dir => \"/home/user/folder\","
NSQ_SOURCE_LINE 00000575 "\t});"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "The directory tells the driver where it should create or open tables (a.k.a."
NSQ_SOURCE_LINE 00000578 "files). It defaults to the current directory, so the following are equivalent:"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "    $dbh = DBI->connect (\"dbi:CSV:\");"
NSQ_SOURCE_LINE 00000581 "    $dbh = DBI->connect (\"dbi:CSV:\", undef, undef, { f_dir => \".\" });"
NSQ_SOURCE_LINE 00000582 "    $dbh = DBI->connect (\"dbi:CSV:f_dir=.\");"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "We were told, that VMS might - for whatever reason - require:"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "    $dbh = DBI->connect (\"dbi:CSV:f_dir=\");"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "The preferred way of passing the arguments is by driver attributes:"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "    # specify most possible flags via driver flags"
NSQ_SOURCE_LINE 00000591 "    $dbh = DBI->connect (\"dbi:CSV:\", undef, undef, {"
NSQ_SOURCE_LINE 00000592 "        f_schema         => undef,"
NSQ_SOURCE_LINE 00000593 "        f_dir            => \"data\","
NSQ_SOURCE_LINE 00000594 "        f_dir_search     => [],"
NSQ_SOURCE_LINE 00000595 "        f_ext            => \".csv/r\","
NSQ_SOURCE_LINE 00000596 "        f_lock           => 2,"
NSQ_SOURCE_LINE 00000597 "        f_encoding       => \"utf8\","
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "        csv_eol          => \"\\r\\n\","
NSQ_SOURCE_LINE 00000600 "        csv_sep_char     => \",\","
NSQ_SOURCE_LINE 00000601 "        csv_quote_char   => '\"',"
NSQ_SOURCE_LINE 00000602 "        csv_escape_char  => '\"',"
NSQ_SOURCE_LINE 00000603 "        csv_class        => \"Text::CSV_XS\","
NSQ_SOURCE_LINE 00000604 "        csv_null         => 1,"
NSQ_SOURCE_LINE 00000605 "        csv_bom          => 0,"
NSQ_SOURCE_LINE 00000606 "        csv_tables       => {"
NSQ_SOURCE_LINE 00000607 "            syspwd => {"
NSQ_SOURCE_LINE 00000608 "                sep_char    => \":\","
NSQ_SOURCE_LINE 00000609 "                quote_char  => undef,"
NSQ_SOURCE_LINE 00000610 "                escape_char => undef,"
NSQ_SOURCE_LINE 00000611 "                file        => \"/etc/passwd\","
NSQ_SOURCE_LINE 00000612 "                col_names   => [qw( login password"
NSQ_SOURCE_LINE 00000613 "                                    uid gid realname"
NSQ_SOURCE_LINE 00000614 "                                    directory shell )],"
NSQ_SOURCE_LINE 00000615 "\t\t},"
NSQ_SOURCE_LINE 00000616 "            },"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "        RaiseError       => 1,"
NSQ_SOURCE_LINE 00000619 "        PrintError       => 1,"
NSQ_SOURCE_LINE 00000620 "        FetchHashKeyName => \"NAME_lc\","
NSQ_SOURCE_LINE 00000621 "        }) or die $DBI::errstr;"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "but you may set these attributes in the DSN as well, separated by semicolons."
NSQ_SOURCE_LINE 00000624 "Pay attention to the semi-colon for C<csv_sep_char> (as seen in many CSV"
NSQ_SOURCE_LINE 00000625 "exports from MS Excel) is being escaped in below example, as is would"
NSQ_SOURCE_LINE 00000626 "otherwise be seen as attribute separator:"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "    $dbh = DBI->connect ("
NSQ_SOURCE_LINE 00000629 "\t\"dbi:CSV:f_dir=$ENV{HOME}/csvdb;f_ext=.csv;f_lock=2;\" ."
NSQ_SOURCE_LINE 00000630 "\t\"f_encoding=utf8;csv_eol=\\n;csv_sep_char=\\\\;;\" ."
NSQ_SOURCE_LINE 00000631 "\t\"csv_quote_char=\\\";csv_escape_char=\\\\;csv_class=Text::CSV_XS;\" ."
NSQ_SOURCE_LINE 00000632 "\t\"csv_null=1\") or die $DBI::errstr;"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "Using attributes in the DSN is easier to use when the DSN is derived from an"
NSQ_SOURCE_LINE 00000635 "outside source (environment variable, database entry, or configure file),"
NSQ_SOURCE_LINE 00000636 "whereas specifying entries in the attribute hash is easier to read and to"
NSQ_SOURCE_LINE 00000637 "maintain."
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "The default value for C<csv_binary> is C<1> (True)."
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "The default value for C<csv_auto_diag> is <1>. Note that this might cause"
NSQ_SOURCE_LINE 00000642 "trouble on perl versions older than 5.8.9, so up to and including perl"
NSQ_SOURCE_LINE 00000643 "version 5.8.8 it might be required to use C<;csv_auto_diag=0> inside the"
NSQ_SOURCE_LINE 00000644 "C<DSN> or C<csv_auto_diag => 0> inside the attributes."
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "=head2 Creating and dropping tables"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "You can create and drop tables with commands like the following:"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "    $dbh->do (\"CREATE TABLE $table (id INTEGER, name CHAR (64))\");"
NSQ_SOURCE_LINE 00000651 "    $dbh->do (\"DROP TABLE $table\");"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "Note that currently only the column names will be stored and no other data."
NSQ_SOURCE_LINE 00000654 "Thus all other information including column type (INTEGER or CHAR (x), for"
NSQ_SOURCE_LINE 00000655 "example), column attributes (NOT NULL, PRIMARY KEY, ...) will silently be"
NSQ_SOURCE_LINE 00000656 "discarded. This may change in a later release."
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "A drop just removes the file without any warning."
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "See L<DBI> for more details."
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "Table names cannot be arbitrary, due to restrictions of the SQL syntax."
NSQ_SOURCE_LINE 00000663 "I recommend that table names are valid SQL identifiers: The first"
NSQ_SOURCE_LINE 00000664 "character is alphabetic, followed by an arbitrary number of alphanumeric"
NSQ_SOURCE_LINE 00000665 "characters. If you want to use other files, the file names must start"
NSQ_SOURCE_LINE 00000666 "with \"/\", \"./\" or \"../\" and they must not contain white space."
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "=head2 Inserting, fetching and modifying data"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "The following examples insert some data in a table and fetch it back:"
NSQ_SOURCE_LINE 00000671 "First, an example where the column data is concatenated in the SQL string:"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "    $dbh->do (\"INSERT INTO $table VALUES (1, \"."
NSQ_SOURCE_LINE 00000674 "\t       $dbh->quote (\"foobar\") . \")\");"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "Note the use of the quote method for escaping the word \"foobar\". Any"
NSQ_SOURCE_LINE 00000677 "string must be escaped, even if it does not contain binary data."
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "Next, an example using parameters:"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "    $dbh->do (\"INSERT INTO $table VALUES (?, ?)\", undef, 2,"
NSQ_SOURCE_LINE 00000682 "\t      \"It's a string!\");"
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "Note that you don't need to quote column data passed as parameters."
NSQ_SOURCE_LINE 00000685 "This version is particularly well designed for"
NSQ_SOURCE_LINE 00000686 "loops. Whenever performance is an issue, I recommend using this method."
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "You might wonder about the C<undef>. Don't wonder, just take it as it"
NSQ_SOURCE_LINE 00000689 "is. :-) It's an attribute argument that I have never used and will be"
NSQ_SOURCE_LINE 00000690 "passed to the prepare method as the second argument."
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "To retrieve data, you can use the following:"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "    my $query = \"SELECT * FROM $table WHERE id > 1 ORDER BY id\";"
NSQ_SOURCE_LINE 00000695 "    my $sth   = $dbh->prepare ($query);"
NSQ_SOURCE_LINE 00000696 "    $sth->execute ();"
NSQ_SOURCE_LINE 00000697 "    while (my $row = $sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000698 "\tprint \"Found result row: id = \", $row->{id},"
NSQ_SOURCE_LINE 00000699 "\t      \", name = \", $row->{name};"
NSQ_SOURCE_LINE 00000700 "\t}"
NSQ_SOURCE_LINE 00000701 "    $sth->finish ();"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "Again, column binding works: The same example again."
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "    my $sth = $dbh->prepare (qq;"
NSQ_SOURCE_LINE 00000706 "\tSELECT * FROM $table WHERE id > 1 ORDER BY id;"
NSQ_SOURCE_LINE 00000707 "\t;);"
NSQ_SOURCE_LINE 00000708 "    $sth->execute;"
NSQ_SOURCE_LINE 00000709 "    my ($id, $name);"
NSQ_SOURCE_LINE 00000710 "    $sth->bind_columns (undef, \\$id, \\$name);"
NSQ_SOURCE_LINE 00000711 "    while ($sth->fetch) {"
NSQ_SOURCE_LINE 00000712 "\tprint \"Found result row: id = $id, name = $name\\n\";"
NSQ_SOURCE_LINE 00000713 "\t}"
NSQ_SOURCE_LINE 00000714 "    $sth->finish;"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "Of course you can even use input parameters. Here's the same example"
NSQ_SOURCE_LINE 00000717 "for the third time:"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "    my $sth = $dbh->prepare (\"SELECT * FROM $table WHERE id = ?\");"
NSQ_SOURCE_LINE 00000720 "    $sth->bind_columns (undef, \\$id, \\$name);"
NSQ_SOURCE_LINE 00000721 "    for (my $i = 1; $i <= 2; $i++) {"
NSQ_SOURCE_LINE 00000722 "\t$sth->execute ($id);"
NSQ_SOURCE_LINE 00000723 "\tif ($sth->fetch) {"
NSQ_SOURCE_LINE 00000724 "\t    print \"Found result row: id = $id, name = $name\\n\";"
NSQ_SOURCE_LINE 00000725 "\t    }"
NSQ_SOURCE_LINE 00000726 "\t$sth->finish;"
NSQ_SOURCE_LINE 00000727 "\t}"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "See L<DBI> for details on these methods. See L<SQL::Statement> for"
NSQ_SOURCE_LINE 00000730 "details on the WHERE clause."
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "Data rows are modified with the UPDATE statement:"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "    $dbh->do (\"UPDATE $table SET id = 3 WHERE id = 1\");"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "Likewise you use the DELETE statement for removing rows:"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "    $dbh->do (\"DELETE FROM $table WHERE id > 1\");"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "=head2 Error handling"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "In the above examples we have never cared about return codes. Of"
NSQ_SOURCE_LINE 00000743 "course, this is not recommended. Instead we should have written (for"
NSQ_SOURCE_LINE 00000744 "example):"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "    my $sth = $dbh->prepare (\"SELECT * FROM $table WHERE id = ?\") or"
NSQ_SOURCE_LINE 00000747 "\tdie \"prepare: \" . $dbh->errstr ();"
NSQ_SOURCE_LINE 00000748 "    $sth->bind_columns (undef, \\$id, \\$name) or"
NSQ_SOURCE_LINE 00000749 "\tdie \"bind_columns: \" . $dbh->errstr ();"
NSQ_SOURCE_LINE 00000750 "    for (my $i = 1; $i <= 2; $i++) {"
NSQ_SOURCE_LINE 00000751 "\t$sth->execute ($id) or"
NSQ_SOURCE_LINE 00000752 "\t    die \"execute: \" . $dbh->errstr ();"
NSQ_SOURCE_LINE 00000753 "\t$sth->fetch and"
NSQ_SOURCE_LINE 00000754 "\t    print \"Found result row: id = $id, name = $name\\n\";"
NSQ_SOURCE_LINE 00000755 "\t}"
NSQ_SOURCE_LINE 00000756 "    $sth->finish ($id) or die \"finish: \" . $dbh->errstr ();"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "Obviously this is tedious. Fortunately we have DBI's I<RaiseError>"
NSQ_SOURCE_LINE 00000759 "attribute:"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "    $dbh->{RaiseError} = 1;"
NSQ_SOURCE_LINE 00000762 "    $@ = \"\";"
NSQ_SOURCE_LINE 00000763 "    eval {"
NSQ_SOURCE_LINE 00000764 "\tmy $sth = $dbh->prepare (\"SELECT * FROM $table WHERE id = ?\");"
NSQ_SOURCE_LINE 00000765 "\t$sth->bind_columns (undef, \\$id, \\$name);"
NSQ_SOURCE_LINE 00000766 "\tfor (my $i = 1; $i <= 2; $i++) {"
NSQ_SOURCE_LINE 00000767 "\t    $sth->execute ($id);"
NSQ_SOURCE_LINE 00000768 "\t    $sth->fetch and"
NSQ_SOURCE_LINE 00000769 "\t\tprint \"Found result row: id = $id, name = $name\\n\";"
NSQ_SOURCE_LINE 00000770 "\t    }"
NSQ_SOURCE_LINE 00000771 "\t$sth->finish ($id);"
NSQ_SOURCE_LINE 00000772 "\t};"
NSQ_SOURCE_LINE 00000773 "    $@ and die \"SQL database error: $@\";"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "This is not only shorter, it even works when using DBI methods within"
NSQ_SOURCE_LINE 00000776 "subroutines."
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "=head1 DBI database handle attributes"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "=head2 Metadata"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "The following attributes are handled by DBI itself and not by DBD::File,"
NSQ_SOURCE_LINE 00000783 "thus they all work as expected:"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "    Active"
NSQ_SOURCE_LINE 00000786 "    ActiveKids"
NSQ_SOURCE_LINE 00000787 "    CachedKids"
NSQ_SOURCE_LINE 00000788 "    CompatMode             (Not used)"
NSQ_SOURCE_LINE 00000789 "    InactiveDestroy"
NSQ_SOURCE_LINE 00000790 "    Kids"
NSQ_SOURCE_LINE 00000791 "    PrintError"
NSQ_SOURCE_LINE 00000792 "    RaiseError"
NSQ_SOURCE_LINE 00000793 "    Warn                   (Not used)"
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "The following DBI attributes are handled by DBD::File:"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "=over 4"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "=item AutoCommit"
NSQ_SOURCE_LINE 00000800 "X<AutoCommit>"
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "Always on"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "=item ChopBlanks"
NSQ_SOURCE_LINE 00000805 "X<ChopBlanks>"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "Works"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "=item NUM_OF_FIELDS"
NSQ_SOURCE_LINE 00000810 "X<NUM_OF_FIELDS>"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "Valid after C<$sth-E<gt>execute>"
NSQ_SOURCE_LINE 00000813 ""
NSQ_SOURCE_LINE 00000814 "=item NUM_OF_PARAMS"
NSQ_SOURCE_LINE 00000815 "X<NUM_OF_PARAMS>"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "Valid after C<$sth-E<gt>prepare>"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "=item NAME"
NSQ_SOURCE_LINE 00000820 "X<NAME>"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "=item NAME_lc"
NSQ_SOURCE_LINE 00000823 "X<NAME_lc>"
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "=item NAME_uc"
NSQ_SOURCE_LINE 00000826 "X<NAME_uc>"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "Valid after C<$sth-E<gt>execute>; undef for Non-Select statements."
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "=item NULLABLE"
NSQ_SOURCE_LINE 00000831 "X<NULLABLE>"
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "Not really working. Always returns an array ref of one's, as DBD::CSV"
NSQ_SOURCE_LINE 00000834 "does not verify input data. Valid after C<$sth-E<gt>execute>; undef for"
NSQ_SOURCE_LINE 00000835 "non-Select statements."
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "=back"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "These attributes and methods are not supported:"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "    bind_param_inout"
NSQ_SOURCE_LINE 00000842 "    CursorName"
NSQ_SOURCE_LINE 00000843 "    LongReadLen"
NSQ_SOURCE_LINE 00000844 "    LongTruncOk"
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "=head1 DBD-CSV specific database handle attributes"
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "In addition to the DBI attributes, you can use the following dbh"
NSQ_SOURCE_LINE 00000849 "attributes:"
NSQ_SOURCE_LINE 00000850 ""
NSQ_SOURCE_LINE 00000851 "=head2 DBD::File attributes"
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "=over 4"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "=item f_dir"
NSQ_SOURCE_LINE 00000856 "X<f_dir>"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "This attribute is used for setting the directory where CSV files are"
NSQ_SOURCE_LINE 00000859 "opened. Usually you set it in the dbh and it defaults to the current"
NSQ_SOURCE_LINE 00000860 "directory (\".\"). However, it may be overridden in statement handles."
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "=item f_dir_search"
NSQ_SOURCE_LINE 00000863 "X<f_dir_search>"
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "This attribute optionally defines a list of extra directories to search"
NSQ_SOURCE_LINE 00000866 "when opening existing tables. It should be an anonymous list or an array"
NSQ_SOURCE_LINE 00000867 "reference listing all folders where tables could be found."
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "    my $dbh = DBI->connect (\"dbi:CSV:\", \"\", \"\", {"
NSQ_SOURCE_LINE 00000870 "\tf_dir        => \"data\","
NSQ_SOURCE_LINE 00000871 "\tf_dir_search => [ \"ref/data\", \"ref/old\" ],"
NSQ_SOURCE_LINE 00000872 "\tf_ext        => \".csv/r\","
NSQ_SOURCE_LINE 00000873 "\t}) or die $DBI::errstr;"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "=item f_ext"
NSQ_SOURCE_LINE 00000876 "X<f_ext>"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "This attribute is used for setting the file extension."
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "=item f_schema"
NSQ_SOURCE_LINE 00000881 "X<f_schema>"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "This attribute allows you to set the database schema name. The default is"
NSQ_SOURCE_LINE 00000884 "to use the owner of C<f_dir>. C<undef> is allowed, but not in the DSN part."
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "    my $dbh = DBI->connect (\"dbi:CSV:\", \"\", \"\", {"
NSQ_SOURCE_LINE 00000887 "\tf_schema => undef,"
NSQ_SOURCE_LINE 00000888 "\tf_dir    => \"data\","
NSQ_SOURCE_LINE 00000889 "\tf_ext    => \".csv/r\","
NSQ_SOURCE_LINE 00000890 "\t}) or die $DBI::errstr;"
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "=item f_encoding"
NSQ_SOURCE_LINE 00000893 "X<f_encoding>"
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "This attribute allows you to set the encoding of the data. With CSV, it is not"
NSQ_SOURCE_LINE 00000896 "possible to set (and remember) the encoding on a column basis, but DBD::File"
NSQ_SOURCE_LINE 00000897 "now allows the encoding to be set on the underlying file. If this attribute is"
NSQ_SOURCE_LINE 00000898 "not set, or undef is passed, the file will be seen as binary."
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "=item f_lock"
NSQ_SOURCE_LINE 00000901 "X<f_lock>"
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "With this attribute you can specify a locking mode to be used (if locking is"
NSQ_SOURCE_LINE 00000904 "supported at all) for opening tables. By default, tables are opened with a"
NSQ_SOURCE_LINE 00000905 "shared lock for reading, and with an exclusive lock for writing. The"
NSQ_SOURCE_LINE 00000906 "supported modes are:"
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "=over 2"
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "=item 0"
NSQ_SOURCE_LINE 00000911 "X<0>"
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "Force no locking at all."
NSQ_SOURCE_LINE 00000914 ""
NSQ_SOURCE_LINE 00000915 "=item 1"
NSQ_SOURCE_LINE 00000916 "X<1>"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "Only shared locks will be used."
NSQ_SOURCE_LINE 00000919 ""
NSQ_SOURCE_LINE 00000920 "=item 2"
NSQ_SOURCE_LINE 00000921 "X<2>"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "Only exclusive locks will be used."
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "=back"
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "=back"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "But see L<DBD::File/\"KNOWN BUGS\">."
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "=head2 DBD::CSV specific attributes"
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "=over 4"
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "=item csv_class"
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "The attribute I<csv_class> controls the CSV parsing engine. This defaults"
NSQ_SOURCE_LINE 00000938 "to C<Text::CSV_XS>, but C<Text::CSV> can be used in some cases, too."
NSQ_SOURCE_LINE 00000939 "Please be aware that C<Text::CSV> does not care about any edge case as"
NSQ_SOURCE_LINE 00000940 "C<Text::CSV_XS> does and that C<Text::CSV> is probably about 100 times"
NSQ_SOURCE_LINE 00000941 "slower than C<Text::CSV_XS>."
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "In order to use the specified class other than C<Text::CSV_XS>, it needs"
NSQ_SOURCE_LINE 00000944 "to be loaded before use.  C<DBD::CSV> does not C<require>/C<use> the"
NSQ_SOURCE_LINE 00000945 "specified class itself."
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "=back"
NSQ_SOURCE_LINE 00000948 ""
NSQ_SOURCE_LINE 00000949 "=head2 Text::CSV_XS specific attributes"
NSQ_SOURCE_LINE 00000950 ""
NSQ_SOURCE_LINE 00000951 "=over 4"
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "=item csv_eol"
NSQ_SOURCE_LINE 00000954 "X<csv_eol>"
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "=item csv_sep_char"
NSQ_SOURCE_LINE 00000957 "X<csv_sep_char>"
NSQ_SOURCE_LINE 00000958 ""
NSQ_SOURCE_LINE 00000959 "=item csv_quote_char"
NSQ_SOURCE_LINE 00000960 "X<csv_quote_char>"
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "=item csv_escape_char"
NSQ_SOURCE_LINE 00000963 "X<csv_escape_char>"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "=item csv_csv"
NSQ_SOURCE_LINE 00000966 "X<csv_csv>"
NSQ_SOURCE_LINE 00000967 ""
NSQ_SOURCE_LINE 00000968 "The attributes I<csv_eol>, I<csv_sep_char>, I<csv_quote_char> and"
NSQ_SOURCE_LINE 00000969 "I<csv_escape_char> are corresponding to the respective attributes of the"
NSQ_SOURCE_LINE 00000970 "I<csv_class> (usually Text::CSV_CS) object. You may want to set these"
NSQ_SOURCE_LINE 00000971 "attributes if you have unusual CSV files like F</etc/passwd> or MS Excel"
NSQ_SOURCE_LINE 00000972 "generated CSV files with a semicolon as separator. Defaults are"
NSQ_SOURCE_LINE 00000973 "C<\\015\\012>\", C<,>, C<\"> and C<\">, respectively."
NSQ_SOURCE_LINE 00000974 ""
NSQ_SOURCE_LINE 00000975 "The I<csv_eol> attribute defines the end-of-line pattern, which is better"
NSQ_SOURCE_LINE 00000976 "known as a record separator pattern since it separates records.  The default"
NSQ_SOURCE_LINE 00000977 "is windows-style end-of-lines C<\\015\\012> for output (writing) and unset for"
NSQ_SOURCE_LINE 00000978 "input (reading), so if on unix you may want to set this to newline (C<\\n>)"
NSQ_SOURCE_LINE 00000979 "like this:"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "  $dbh->{csv_eol} = \"\\n\";"
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 "It is also possible to use multi-character patterns as record separators."
NSQ_SOURCE_LINE 00000984 "For example this file uses newlines as field separators (sep_char) and"
NSQ_SOURCE_LINE 00000985 "the pattern \"\\n__ENDREC__\\n\" as the record separators (eol):"
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "  name"
NSQ_SOURCE_LINE 00000988 "  city"
NSQ_SOURCE_LINE 00000989 "  __ENDREC__"
NSQ_SOURCE_LINE 00000990 "  joe"
NSQ_SOURCE_LINE 00000991 "  seattle"
NSQ_SOURCE_LINE 00000992 "  __ENDREC__"
NSQ_SOURCE_LINE 00000993 "  sue"
NSQ_SOURCE_LINE 00000994 "  portland"
NSQ_SOURCE_LINE 00000995 "  __ENDREC__"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "To handle this file, you'd do this:"
NSQ_SOURCE_LINE 00000998 ""
NSQ_SOURCE_LINE 00000999 "  $dbh->{eol}      = \"\\n__ENDREC__\\n\" ,"
NSQ_SOURCE_LINE 00001000 "  $dbh->{sep_char} = \"\\n\""
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "The attributes are used to create an instance of the class I<csv_class>,"
NSQ_SOURCE_LINE 00001003 "by default Text::CSV_XS. Alternatively you may pass an instance as"
NSQ_SOURCE_LINE 00001004 "I<csv_csv>, the latter takes precedence. Note that the I<binary>"
NSQ_SOURCE_LINE 00001005 "attribute I<must> be set to a true value in that case."
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "Additionally you may overwrite these attributes on a per-table base in"
NSQ_SOURCE_LINE 00001008 "the I<csv_tables> attribute."
NSQ_SOURCE_LINE 00001009 ""
NSQ_SOURCE_LINE 00001010 "=item csv_null"
NSQ_SOURCE_LINE 00001011 "X<csv_null>"
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "With this option set, all new statement handles will set C<always_quote>"
NSQ_SOURCE_LINE 00001014 "and C<blank_is_undef> in the CSV parser and writer, so it knows how to"
NSQ_SOURCE_LINE 00001015 "distinguish between the empty string and C<undef> or C<NULL>. You cannot"
NSQ_SOURCE_LINE 00001016 "reset it with a false value. You can pass it to connect, or set it later:"
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "  $dbh = DBI->connect (\"dbi:CSV:\", \"\", \"\", { csv_null => 1 });"
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "  $dbh->{csv_null} = 1;"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "=item csv_bom"
NSQ_SOURCE_LINE 00001023 "X<csv_bom>"
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "With this option set, the CSV parser will try to detect BOM (Byte Order Mark)"
NSQ_SOURCE_LINE 00001026 "in the header line. This requires L<Text::CSV_XS> version 1.22 or higher."
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "  $dbh = DBI->connect (\"dbi:CSV:\", \"\", \"\", { csv_bom => 1 });"
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "  $dbh->{csv_bom} = 1;"
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "=item csv_tables"
NSQ_SOURCE_LINE 00001033 "X<csv_tables>"
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 "This hash ref is used for storing table dependent metadata. For any"
NSQ_SOURCE_LINE 00001036 "table it contains an element with the table name as key and another"
NSQ_SOURCE_LINE 00001037 "hash ref with the following attributes:"
NSQ_SOURCE_LINE 00001038 ""
NSQ_SOURCE_LINE 00001039 "=over 4"
NSQ_SOURCE_LINE 00001040 ""
NSQ_SOURCE_LINE 00001041 "=item o"
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "All valid attributes to the CSV parsing module. Any of them can optionally"
NSQ_SOURCE_LINE 00001044 "be prefixed with C<csv_>."
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "=item o"
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "All attributes valid to DBD::File"
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "=back"
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "If you pass it C<f_file> or its alias C<file>, C<f_ext> has no effect, but"
NSQ_SOURCE_LINE 00001053 "C<f_dir> and C<f_encoding> still have."
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 "  csv_tables => {"
NSQ_SOURCE_LINE 00001056 "      syspwd => {                   # Table name"
NSQ_SOURCE_LINE 00001057 "          csv_sep_char => \":\",      # Text::CSV_XS"
NSQ_SOURCE_LINE 00001058 "          quote_char   => undef,    # Text::CSV_XS"
NSQ_SOURCE_LINE 00001059 "          escape_char  => undef,    # Text::CSV_XS"
NSQ_SOURCE_LINE 00001060 "          f_dir        => \"/etc\",   # DBD::File"
NSQ_SOURCE_LINE 00001061 "          f_file       => \"passwd\", # DBD::File"
NSQ_SOURCE_LINE 00001062 "          col_names    =>           # DBD::File"
NSQ_SOURCE_LINE 00001063 "            [qw( login password uid gid realname directory shell )],"
NSQ_SOURCE_LINE 00001064 "          },"
NSQ_SOURCE_LINE 00001065 "      },"
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "=item csv_*"
NSQ_SOURCE_LINE 00001068 "X<csv_*>"
NSQ_SOURCE_LINE 00001069 ""
NSQ_SOURCE_LINE 00001070 "All other attributes that start with C<csv_> and are not described above"
NSQ_SOURCE_LINE 00001071 "will be passed to C<Text::CSV_XS> (without the C<csv_> prefix). These"
NSQ_SOURCE_LINE 00001072 "extra options are only likely to be useful for reading (select)"
NSQ_SOURCE_LINE 00001073 "handles. Examples:"
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "  $dbh->{csv_allow_whitespace}    = 1;"
NSQ_SOURCE_LINE 00001076 "  $dbh->{csv_allow_loose_quotes}  = 1;"
NSQ_SOURCE_LINE 00001077 "  $dbh->{csv_allow_loose_escapes} = 1;"
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "See the C<Text::CSV_XS> documentation for the full list and the documentation."
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "=back"
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "=head2 Driver specific attributes"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "=over 4"
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 "=item f_file"
NSQ_SOURCE_LINE 00001088 "X<f_file>"
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "The name of the file used for the table; defaults to"
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "    \"$dbh->{f_dir}/$table\""
NSQ_SOURCE_LINE 00001093 ""
NSQ_SOURCE_LINE 00001094 "=item eol"
NSQ_SOURCE_LINE 00001095 "X<eol>"
NSQ_SOURCE_LINE 00001096 ""
NSQ_SOURCE_LINE 00001097 "=item sep_char"
NSQ_SOURCE_LINE 00001098 "X<sep_char>"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "=item quote_char"
NSQ_SOURCE_LINE 00001101 "X<quote_char>"
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 "=item escape_char"
NSQ_SOURCE_LINE 00001104 "X<escape_char>"
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 "=item class"
NSQ_SOURCE_LINE 00001107 "X<class>"
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "=item csv"
NSQ_SOURCE_LINE 00001110 "X<csv>"
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 "These correspond to the attributes I<csv_eol>, I<csv_sep_char>,"
NSQ_SOURCE_LINE 00001113 "I<csv_quote_char>, I<csv_escape_char>, I<csv_class> and I<csv_csv>."
NSQ_SOURCE_LINE 00001114 "The difference is that they work on a per-table basis."
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "=item col_names"
NSQ_SOURCE_LINE 00001117 "X<col_names>"
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 "=item skip_first_row"
NSQ_SOURCE_LINE 00001120 "X<skip_first_row>"
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "By default DBD::CSV assumes that column names are stored in the first row"
NSQ_SOURCE_LINE 00001123 "of the CSV file and sanitizes them (see C<raw_header> below). If this is"
NSQ_SOURCE_LINE 00001124 "not the case, you can supply an array ref of table names with the"
NSQ_SOURCE_LINE 00001125 "I<col_names> attribute. In that case the attribute I<skip_first_row> will"
NSQ_SOURCE_LINE 00001126 "be set to FALSE."
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "If you supply an empty array ref, the driver will read the first row"
NSQ_SOURCE_LINE 00001129 "for you, count the number of columns and create column names like"
NSQ_SOURCE_LINE 00001130 "C<col0>, C<col1>, ..."
NSQ_SOURCE_LINE 00001131 ""
NSQ_SOURCE_LINE 00001132 "Note that column names that match reserved SQL words will cause unwanted"
NSQ_SOURCE_LINE 00001133 "and sometimes confusing errors. If your CSV has headers that match reserved"
NSQ_SOURCE_LINE 00001134 "words, you will require these two attributes."
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 "If C<test.csv> looks like"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 " select,from"
NSQ_SOURCE_LINE 00001139 " 1,2"
NSQ_SOURCE_LINE 00001140 ""
NSQ_SOURCE_LINE 00001141 "the select query would result in C<select select, from from test;>, which"
NSQ_SOURCE_LINE 00001142 "obviously is illegal SQL."
NSQ_SOURCE_LINE 00001143 ""
NSQ_SOURCE_LINE 00001144 "=item raw_header"
NSQ_SOURCE_LINE 00001145 "X<raw_header>"
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 "Due to the SQL standard, field names cannot contain special characters"
NSQ_SOURCE_LINE 00001148 "like a dot (C<.>) or a space (C< >) unless the column names are quoted."
NSQ_SOURCE_LINE 00001149 "Following the approach of mdb_tools, all these tokens are translated to an"
NSQ_SOURCE_LINE 00001150 "underscore (C<_>) when reading the first line of the CSV file, so all field"
NSQ_SOURCE_LINE 00001151 "names are 'sanitized'. If you do not want this to happen, set C<raw_header>"
NSQ_SOURCE_LINE 00001152 "to a true value and the entries in the first line of the CSV data will be"
NSQ_SOURCE_LINE 00001153 "used verbatim for column headers and field names.  DBD::CSV cannot guarantee"
NSQ_SOURCE_LINE 00001154 "that any part in the toolchain will work if field names have those characters,"
NSQ_SOURCE_LINE 00001155 "and the chances are high that the SQL statements will fail."
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "Currently, the sanitizing of headers is as simple as"
NSQ_SOURCE_LINE 00001158 ""
NSQ_SOURCE_LINE 00001159 "  s/\\W/_/g;"
NSQ_SOURCE_LINE 00001160 ""
NSQ_SOURCE_LINE 00001161 "Note that headers (column names) might be folded in other parts of the code"
NSQ_SOURCE_LINE 00001162 "stack, specifically SQL::Statement, whose docs mention:"
NSQ_SOURCE_LINE 00001163 ""
NSQ_SOURCE_LINE 00001164 " Wildcards are expanded to lower cased identifiers. This might"
NSQ_SOURCE_LINE 00001165 " confuse some people, but it was easier to implement."
NSQ_SOURCE_LINE 00001166 ""
NSQ_SOURCE_LINE 00001167 "That means that in"
NSQ_SOURCE_LINE 00001168 ""
NSQ_SOURCE_LINE 00001169 " my $sth = $dbh->prepare (\"select * from foo\");"
NSQ_SOURCE_LINE 00001170 " $sth->execute;"
NSQ_SOURCE_LINE 00001171 " while (my $row = $sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00001172 "     say for keys %$row;"
NSQ_SOURCE_LINE 00001173 "     }"
NSQ_SOURCE_LINE 00001174 ""
NSQ_SOURCE_LINE 00001175 "all keys will show as all lower case, regardless of the original header."
NSQ_SOURCE_LINE 00001176 ""
NSQ_SOURCE_LINE 00001177 "=back"
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "It's strongly recommended to check the attributes supported by"
NSQ_SOURCE_LINE 00001180 "L<DBD::File/Metadata>."
NSQ_SOURCE_LINE 00001181 ""
NSQ_SOURCE_LINE 00001182 "Example: Suppose you want to use F</etc/passwd> as a CSV file. :-)"
NSQ_SOURCE_LINE 00001183 "There simplest way is:"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "    use DBI;"
NSQ_SOURCE_LINE 00001186 "    my $dbh = DBI->connect (\"dbi:CSV:\", undef, undef, {"
NSQ_SOURCE_LINE 00001187 "\tf_dir           => \"/etc\","
NSQ_SOURCE_LINE 00001188 "\tcsv_sep_char    => \":\","
NSQ_SOURCE_LINE 00001189 "\tcsv_quote_char  => undef,"
NSQ_SOURCE_LINE 00001190 "\tcsv_escape_char => undef,"
NSQ_SOURCE_LINE 00001191 "\t});"
NSQ_SOURCE_LINE 00001192 "    $dbh->{csv_tables}{passwd} = {"
NSQ_SOURCE_LINE 00001193 "\tcol_names => [qw( login password uid gid realname"
NSQ_SOURCE_LINE 00001194 "\t\t\t  directory shell )];"
NSQ_SOURCE_LINE 00001195 "\t};"
NSQ_SOURCE_LINE 00001196 "    $sth = $dbh->prepare (\"SELECT * FROM passwd\");"
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "Another possibility where you leave all the defaults as they are and"
NSQ_SOURCE_LINE 00001199 "override them on a per table basis:"
NSQ_SOURCE_LINE 00001200 ""
NSQ_SOURCE_LINE 00001201 "    require DBI;"
NSQ_SOURCE_LINE 00001202 "    my $dbh = DBI->connect (\"dbi:CSV:\");"
NSQ_SOURCE_LINE 00001203 "    $dbh->{csv_tables}{passwd} = {"
NSQ_SOURCE_LINE 00001204 "\teol         => \"\\n\","
NSQ_SOURCE_LINE 00001205 "\tsep_char    => \":\","
NSQ_SOURCE_LINE 00001206 "\tquote_char  => undef,"
NSQ_SOURCE_LINE 00001207 "\tescape_char => undef,"
NSQ_SOURCE_LINE 00001208 "\tf_file      => \"/etc/passwd\","
NSQ_SOURCE_LINE 00001209 "\tcol_names   => [qw( login password uid gid"
NSQ_SOURCE_LINE 00001210 "\t\t\t    realname directory shell )],"
NSQ_SOURCE_LINE 00001211 "\t};"
NSQ_SOURCE_LINE 00001212 "    $sth = $dbh->prepare (\"SELECT * FROM passwd\");"
NSQ_SOURCE_LINE 00001213 ""
NSQ_SOURCE_LINE 00001214 "=head2 Driver private methods"
NSQ_SOURCE_LINE 00001215 ""
NSQ_SOURCE_LINE 00001216 "These methods are inherited from DBD::File:"
NSQ_SOURCE_LINE 00001217 ""
NSQ_SOURCE_LINE 00001218 "=over 4"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "=item data_sources"
NSQ_SOURCE_LINE 00001221 "X<data_sources>"
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 "The C<data_sources> method returns a list of sub-directories of the current"
NSQ_SOURCE_LINE 00001224 "directory in the form \"dbi:CSV:directory=$dirname\"."
NSQ_SOURCE_LINE 00001225 ""
NSQ_SOURCE_LINE 00001226 "If you want to read the sub-directories of another directory, use"
NSQ_SOURCE_LINE 00001227 ""
NSQ_SOURCE_LINE 00001228 "    my $drh  = DBI->install_driver (\"CSV\");"
NSQ_SOURCE_LINE 00001229 "    my @list = $drh->data_sources (f_dir => \"/usr/local/csv_data\");"
NSQ_SOURCE_LINE 00001230 ""
NSQ_SOURCE_LINE 00001231 "=item list_tables"
NSQ_SOURCE_LINE 00001232 "X<list_tables>"
NSQ_SOURCE_LINE 00001233 ""
NSQ_SOURCE_LINE 00001234 "This method returns a list of file-names inside $dbh->{directory}."
NSQ_SOURCE_LINE 00001235 "Example:"
NSQ_SOURCE_LINE 00001236 ""
NSQ_SOURCE_LINE 00001237 "    my $dbh  = DBI->connect (\"dbi:CSV:directory=/usr/local/csv_data\");"
NSQ_SOURCE_LINE 00001238 "    my @list = $dbh->func (\"list_tables\");"
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "Note that the list includes all files contained in the directory, even"
NSQ_SOURCE_LINE 00001241 "those that have non-valid table names, from the view of SQL. See"
NSQ_SOURCE_LINE 00001242 "L<Creating and dropping tables> above."
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "=back"
NSQ_SOURCE_LINE 00001245 ""
NSQ_SOURCE_LINE 00001246 "=head1 KNOWN ISSUES"
NSQ_SOURCE_LINE 00001247 ""
NSQ_SOURCE_LINE 00001248 "=over 4"
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "=item *"
NSQ_SOURCE_LINE 00001251 ""
NSQ_SOURCE_LINE 00001252 "The module is using flock () internally. However, this function is not"
NSQ_SOURCE_LINE 00001253 "available on some platforms. Use of flock () is disabled on MacOS and"
NSQ_SOURCE_LINE 00001254 "Windows 95: There's no locking at all (perhaps not so important on"
NSQ_SOURCE_LINE 00001255 "these operating systems, as they are for single users anyways)."
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "=back"
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "=head1 TODO"
NSQ_SOURCE_LINE 00001260 ""
NSQ_SOURCE_LINE 00001261 "=over 4"
NSQ_SOURCE_LINE 00001262 ""
NSQ_SOURCE_LINE 00001263 "=item Tests"
NSQ_SOURCE_LINE 00001264 "X<Tests>"
NSQ_SOURCE_LINE 00001265 ""
NSQ_SOURCE_LINE 00001266 "Aim for a full 100% code coverage"
NSQ_SOURCE_LINE 00001267 ""
