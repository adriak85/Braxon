NSQ_SOURCE_LINE 00000057 "    Text::CSV_XS::PV (), # SQL_LONGVARCHAR"
NSQ_SOURCE_LINE 00000058 "    Text::CSV_XS::PV (), # SQL_ALL_TYPES"
NSQ_SOURCE_LINE 00000059 "    Text::CSV_XS::PV (), # SQL_CHAR"
NSQ_SOURCE_LINE 00000060 "    Text::CSV_XS::NV (), # SQL_NUMERIC"
NSQ_SOURCE_LINE 00000061 "    Text::CSV_XS::NV (), # SQL_DECIMAL"
