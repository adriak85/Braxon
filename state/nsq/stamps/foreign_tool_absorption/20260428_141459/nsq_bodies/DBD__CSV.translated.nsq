NSQ_SOURCE_LINE 00000063 "    Text::CSV_XS::IV (), # SQL_SMALLINT"
NSQ_SOURCE_LINE 00000064 "    Text::CSV_XS::NV (), # SQL_FLOAT"
NSQ_SOURCE_LINE 00000065 "    Text::CSV_XS::NV (), # SQL_REAL"
