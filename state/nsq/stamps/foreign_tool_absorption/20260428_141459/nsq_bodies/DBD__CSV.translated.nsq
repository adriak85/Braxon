NSQ_SOURCE_LINE 00001300 ""
NSQ_SOURCE_LINE 00001301 "=item Data dictionary"
NSQ_SOURCE_LINE 00001302 "X<Data dictionary>"
NSQ_SOURCE_LINE 00001303 ""
