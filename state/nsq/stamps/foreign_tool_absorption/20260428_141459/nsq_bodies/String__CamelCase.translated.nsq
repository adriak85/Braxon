NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "convert from under_score text to CamelCase one."
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=head2 decamelize($CamelCase)"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "convert from CamelCase text to under_score one."
