NSQ_SOURCE_LINE 00000009 "# -----------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000010 "package String::CamelCase;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use warnings;"
NSQ_SOURCE_LINE 00000013 "use strict;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our $VERSION = '0.04';"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "use base qw(Exporter);"
NSQ_SOURCE_LINE 00000018 "our @EXPORT_OK = qw(camelize decamelize wordsplit);"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "1;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub wordsplit"
NSQ_SOURCE_LINE 00000023 "{"
NSQ_SOURCE_LINE 00000024 "\tmy $s = shift;"
NSQ_SOURCE_LINE 00000025 "\tsplit( /[_\\s]+|\\b|(?<![A-Z])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])/, $s );"
NSQ_SOURCE_LINE 00000026 "}"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "sub camelize"
NSQ_SOURCE_LINE 00000029 "{"
NSQ_SOURCE_LINE 00000030 "\tmy $s = shift;"
NSQ_SOURCE_LINE 00000031 "\tjoin('', map{ ucfirst $_ } split(/(?<=[A-Za-z])_(?=[A-Za-z])|\\b/, $s));"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub decamelize"
NSQ_SOURCE_LINE 00000035 "{"
NSQ_SOURCE_LINE 00000036 "\tmy $s = shift;"
NSQ_SOURCE_LINE 00000037 "\t$s =~ s{([^a-zA-Z]?)([A-Z]*)([A-Z])([a-z]?)}{"
NSQ_SOURCE_LINE 00000038 "\t\tmy $fc = pos($s)==0;"
NSQ_SOURCE_LINE 00000039 "\t\tmy ($p0,$p1,$p2,$p3) = ($1,lc$2,lc$3,$4);"
NSQ_SOURCE_LINE 00000040 "\t\tmy $t = $p0 || $fc ? $p0 : '_';"
NSQ_SOURCE_LINE 00000041 "\t\t$t .= $p3 ? $p1 ? \"${p1}_$p2$p3\" : \"$p2$p3\" : \"$p1$p2\";"
NSQ_SOURCE_LINE 00000042 "\t\t$t;"
NSQ_SOURCE_LINE 00000043 "\t}ge;"
NSQ_SOURCE_LINE 00000044 "\t$s;"
NSQ_SOURCE_LINE 00000045 "}"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "__END__"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=head1 NAME"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "String::CamelCase - camelcase, de-camelcase"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=head1 VERSION"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "Version 0.03"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 " use String::CamelCase qw(camelize decamelize wordsplit);"
NSQ_SOURCE_LINE 00000060 " print camelize(\"some_keyword\");  # ==> SomeKeyword"
NSQ_SOURCE_LINE 00000061 " print decamelize(\"SomeKeyword\"); # ==> some_keyword"
NSQ_SOURCE_LINE 00000062 " print wordsplit(\"some_keyword\"); # ==> (some, keyword)"
NSQ_SOURCE_LINE 00000063 " print wordsplit(\"SomeKeyword\");  # ==> (Some, Keyword)"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "=head1 EXPORT"
