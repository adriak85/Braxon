BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Test::Needs;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "no warnings 'once';"
NSQ_SOURCE_LINE 00000005 "our $VERSION = '0.002010';"
NSQ_SOURCE_LINE 00000006 "$VERSION =~ tr/_//d;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "BEGIN {"
NSQ_SOURCE_LINE 00000009 "  *_WORK_AROUND_HINT_LEAKAGE"
NSQ_SOURCE_LINE 00000010 "    = \"$]\" < 5.011 && !(\"$]\" >= 5.009004 && \"$]\" < 5.010001)"
NSQ_SOURCE_LINE 00000011 "    ? sub(){1} : sub(){0};"
NSQ_SOURCE_LINE 00000012 "  *_WORK_AROUND_BROKEN_MODULE_STATE"
NSQ_SOURCE_LINE 00000013 "    = \"$]\" < 5.009"
NSQ_SOURCE_LINE 00000014 "    ? sub(){1} : sub(){0};"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "  # this allows regexes to match wide characters in vstrings"
NSQ_SOURCE_LINE 00000017 "  if (\"$]\" >= 5.006001 && \"$]\" <= 5.006002) {"
NSQ_SOURCE_LINE 00000018 "    require utf8;"
NSQ_SOURCE_LINE 00000019 "    utf8->import;"
NSQ_SOURCE_LINE 00000020 "  }"
NSQ_SOURCE_LINE 00000021 "}"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "our @EXPORT = qw(test_needs);"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "our $Level = 0;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "sub _try_require {"
NSQ_SOURCE_LINE 00000028 "  local %^H"
NSQ_SOURCE_LINE 00000029 "    if _WORK_AROUND_HINT_LEAKAGE;"
NSQ_SOURCE_LINE 00000030 "  my ($module) = @_;"
NSQ_SOURCE_LINE 00000031 "  (my $file = \"$module.pm\") =~ s{::|'}{/}g;"
NSQ_SOURCE_LINE 00000032 "  my $err;"
NSQ_SOURCE_LINE 00000033 "  {"
NSQ_SOURCE_LINE 00000034 "    local $@;"
NSQ_SOURCE_LINE 00000035 "    eval { require $file }"
NSQ_SOURCE_LINE 00000036 "      or $err = $@;"
NSQ_SOURCE_LINE 00000037 "  }"
NSQ_SOURCE_LINE 00000038 "  if (defined $err) {"
NSQ_SOURCE_LINE 00000039 "    delete $INC{$file}"
NSQ_SOURCE_LINE 00000040 "      if _WORK_AROUND_BROKEN_MODULE_STATE;"
NSQ_SOURCE_LINE 00000041 "    die $err"
NSQ_SOURCE_LINE 00000042 "      unless $err =~ /\\ACan't locate \\Q$file\\E/;"
NSQ_SOURCE_LINE 00000043 "    return !1;"
NSQ_SOURCE_LINE 00000044 "  }"
NSQ_SOURCE_LINE 00000045 "  !0;"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub _croak {"
NSQ_SOURCE_LINE 00000049 "  my $message = join '', @_;"
NSQ_SOURCE_LINE 00000050 "  my $i = 1;"
NSQ_SOURCE_LINE 00000051 "  while (my ($p, $f, $l) = caller($i++)) {"
NSQ_SOURCE_LINE 00000052 "    next"
NSQ_SOURCE_LINE 00000053 "      if $p =~ /\\ATest::Needs(?:::|\\z)/;"
NSQ_SOURCE_LINE 00000054 "    die \"$message at $f line $l.\\n\";"
NSQ_SOURCE_LINE 00000055 "  }"
NSQ_SOURCE_LINE 00000056 "  die $message;"
NSQ_SOURCE_LINE 00000057 "}"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "sub _try_version {"
NSQ_SOURCE_LINE 00000060 "  my ($module, $version) = @_;"
NSQ_SOURCE_LINE 00000061 "  local $@;"
NSQ_SOURCE_LINE 00000062 "  !!eval { $module->VERSION($version); 1 };"
NSQ_SOURCE_LINE 00000063 "}"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "sub _numify_version {"
NSQ_SOURCE_LINE 00000066 "  for ($_[0]) {"
NSQ_SOURCE_LINE 00000067 "    return"
NSQ_SOURCE_LINE 00000068 "        !$_ ? 0"
NSQ_SOURCE_LINE 00000069 "      : /^[0-9]+(?:\\.[0-9]+)?$/ ? sprintf('%.6f', $_)"
NSQ_SOURCE_LINE 00000070 "      : /^v?([0-9]+(?:\\.[0-9]+)*)$/"
NSQ_SOURCE_LINE 00000071 "        ? sprintf('%d.%03d%03d', ((split /\\./, $1), 0, 0)[0..2])"
NSQ_SOURCE_LINE 00000072 "      : /^([\\x05-\\x07])(.*)$/s"
NSQ_SOURCE_LINE 00000073 "        ? sprintf('%d.%03d%03d', ((map ord, /(.)/gs), 0, 0)[0..2])"
NSQ_SOURCE_LINE 00000074 "      : _croak qq{version \"$_\" does not look like a number};"
NSQ_SOURCE_LINE 00000075 "  }"
NSQ_SOURCE_LINE 00000076 "}"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "sub _find_missing {"
NSQ_SOURCE_LINE 00000079 "  my @bad = map {"
NSQ_SOURCE_LINE 00000080 "    my ($module, $version) = @$_;"
NSQ_SOURCE_LINE 00000081 "    $module eq 'perl' ? do {"
NSQ_SOURCE_LINE 00000082 "      $version = _numify_version($version);"
NSQ_SOURCE_LINE 00000083 "      \"$]\" < $version ? (sprintf \"perl %s (have %.6f)\", $version, $]) : ()"
NSQ_SOURCE_LINE 00000084 "    }"
NSQ_SOURCE_LINE 00000085 "    : $module =~ /^\\d|[^\\w:]|:::|[^:]:[^:]|^:|:$/"
NSQ_SOURCE_LINE 00000086 "      ? _croak sprintf qq{\"%s\" does not look like a module name}, $module"
NSQ_SOURCE_LINE 00000087 "    : _try_require($module) ? ("
NSQ_SOURCE_LINE 00000088 "      defined $version && !_try_version($module, $version)"
NSQ_SOURCE_LINE 00000089 "        ? \"$module $version (have \".(defined $module->VERSION ? $module->VERSION : 'undef').')'"
NSQ_SOURCE_LINE 00000090 "        : ()"
NSQ_SOURCE_LINE 00000091 "    )"
NSQ_SOURCE_LINE 00000092 "    : $version ? \"$module $version\""
NSQ_SOURCE_LINE 00000093 "    : $module;"
NSQ_SOURCE_LINE 00000094 "  }"
NSQ_SOURCE_LINE 00000095 "  _pairs(@_);"
NSQ_SOURCE_LINE 00000096 "  @bad ? \"Need \" . join(', ', @bad) : undef;"
NSQ_SOURCE_LINE 00000097 "}"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "sub import {"
NSQ_SOURCE_LINE 00000100 "  my $class = shift;"
NSQ_SOURCE_LINE 00000101 "  my $target = caller;"
NSQ_SOURCE_LINE 00000102 "  if (@_) {"
NSQ_SOURCE_LINE 00000103 "    local $Level = $Level + 1;"
NSQ_SOURCE_LINE 00000104 "    test_needs(@_);"
NSQ_SOURCE_LINE 00000105 "  }"
NSQ_SOURCE_LINE 00000106 "  no strict 'refs';"
NSQ_SOURCE_LINE 00000107 "  *{\"${target}::$_\"} = \\&{\"${class}::$_\"}"
NSQ_SOURCE_LINE 00000108 "    for @{\"${class}::EXPORT\"};"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "sub test_needs {"
NSQ_SOURCE_LINE 00000112 "  my $missing = _find_missing(@_);"
NSQ_SOURCE_LINE 00000113 "  local $Level = $Level + 1;"
NSQ_SOURCE_LINE 00000114 "  if ($missing) {"
NSQ_SOURCE_LINE 00000115 "    if ($ENV{RELEASE_TESTING}) {"
NSQ_SOURCE_LINE 00000116 "      _fail(\"$missing due to RELEASE_TESTING\");"
NSQ_SOURCE_LINE 00000117 "    }"
NSQ_SOURCE_LINE 00000118 "    else {"
NSQ_SOURCE_LINE 00000119 "      _skip($missing);"
NSQ_SOURCE_LINE 00000120 "    }"
NSQ_SOURCE_LINE 00000121 "  }"
NSQ_SOURCE_LINE 00000122 "  return 1;"
NSQ_SOURCE_LINE 00000123 "}"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "sub _skip {"
NSQ_SOURCE_LINE 00000126 "  local $Level = $Level + 1;"
NSQ_SOURCE_LINE 00000127 "  _fail_or_skip($_[0], 0)"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 "sub _fail {"
NSQ_SOURCE_LINE 00000130 "  local $Level = $Level + 1;"
NSQ_SOURCE_LINE 00000131 "  _fail_or_skip($_[0], 1)"
NSQ_SOURCE_LINE 00000132 "}"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "sub _pairs {"
NSQ_SOURCE_LINE 00000135 "  map +("
NSQ_SOURCE_LINE 00000136 "    ref eq 'HASH' ? do {"
NSQ_SOURCE_LINE 00000137 "      my $arg = $_;"
NSQ_SOURCE_LINE 00000138 "      map [ $_ => $arg->{$_} ], sort keys %$arg;"
NSQ_SOURCE_LINE 00000139 "    }"
NSQ_SOURCE_LINE 00000140 "    : ref eq 'ARRAY' ? do {"
NSQ_SOURCE_LINE 00000141 "      my $arg = $_;"
NSQ_SOURCE_LINE 00000142 "      map [ @{$arg}[$_*2,$_*2+1] ], 0 .. int($#$arg / 2);"
NSQ_SOURCE_LINE 00000143 "    }"
NSQ_SOURCE_LINE 00000144 "    : [ $_ ]"
NSQ_SOURCE_LINE 00000145 "  ), @_;"
NSQ_SOURCE_LINE 00000146 "}"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "sub _fail_or_skip {"
NSQ_SOURCE_LINE 00000149 "  my ($message, $fail) = @_;"
NSQ_SOURCE_LINE 00000150 "  if ($INC{'Test2/API.pm'}) {"
NSQ_SOURCE_LINE 00000151 "    my $ctx = Test2::API::context(level => $Level);"
NSQ_SOURCE_LINE 00000152 "    my $hub = $ctx->hub;"
NSQ_SOURCE_LINE 00000153 "    if ($fail) {"
NSQ_SOURCE_LINE 00000154 "      $ctx->ok(0, \"Test::Needs modules available\", [$message]);"
NSQ_SOURCE_LINE 00000155 "    }"
NSQ_SOURCE_LINE 00000156 "    else {"
NSQ_SOURCE_LINE 00000157 "      my $plan = $hub->plan;"
NSQ_SOURCE_LINE 00000158 "      my $tests = $hub->count;"
NSQ_SOURCE_LINE 00000159 "      if ($plan || $tests) {"
NSQ_SOURCE_LINE 00000160 "        my $skips"
NSQ_SOURCE_LINE 00000161 "          = $plan && $plan ne 'NO PLAN' ? $plan - $tests : 1;"
NSQ_SOURCE_LINE 00000162 "        $ctx->skip(\"Test::Needs modules not available\") for 1 .. $skips;"
NSQ_SOURCE_LINE 00000163 "        $ctx->note($message);"
NSQ_SOURCE_LINE 00000164 "      }"
NSQ_SOURCE_LINE 00000165 "      else {"
NSQ_SOURCE_LINE 00000166 "        $ctx->plan(0, 'SKIP', $message);"
NSQ_SOURCE_LINE 00000167 "      }"
NSQ_SOURCE_LINE 00000168 "    }"
NSQ_SOURCE_LINE 00000169 "    $ctx->done_testing;"
NSQ_SOURCE_LINE 00000170 "    $ctx->release if $Test2::API::VERSION < 1.302053;"
NSQ_SOURCE_LINE 00000171 "    $ctx->send_event('+'._t2_terminate_event());"
NSQ_SOURCE_LINE 00000172 "  }"
NSQ_SOURCE_LINE 00000173 "  elsif ($INC{'Test/Builder.pm'}) {"
NSQ_SOURCE_LINE 00000174 "    local $Test::Builder::Level = $Test::Builder::Level + $Level;"
NSQ_SOURCE_LINE 00000175 "    my $tb = Test::Builder->new;"
NSQ_SOURCE_LINE 00000176 "    my $has_plan = Test::Builder->can('has_plan') ? 'has_plan'"
NSQ_SOURCE_LINE 00000177 "      : sub { $_[0]->expected_tests || eval { $_[0]->current_test($_[0]->current_test); 'no_plan' } };"
NSQ_SOURCE_LINE 00000178 "    my $tests = $tb->current_test;"
NSQ_SOURCE_LINE 00000179 "    if ($fail) {"
NSQ_SOURCE_LINE 00000180 "      $tb->plan(tests => 1)"
NSQ_SOURCE_LINE 00000181 "        unless $tb->$has_plan;"
NSQ_SOURCE_LINE 00000182 "      $tests++;"
NSQ_SOURCE_LINE 00000183 "      $tb->ok(0, \"Test::Needs modules available\");"
NSQ_SOURCE_LINE 00000184 "      $tb->diag($message);"
NSQ_SOURCE_LINE 00000185 "    }"
NSQ_SOURCE_LINE 00000186 "    else {"
NSQ_SOURCE_LINE 00000187 "      my $plan = $tb->$has_plan;"
NSQ_SOURCE_LINE 00000188 "      if ($plan || $tests) {"
NSQ_SOURCE_LINE 00000189 "        my $skips"
NSQ_SOURCE_LINE 00000190 "          = $plan && $plan ne 'no_plan' ? $plan - $tests : 1;"
NSQ_SOURCE_LINE 00000191 "        $tb->skip(\"Test::Needs modules not available\")"
NSQ_SOURCE_LINE 00000192 "          for 1 .. $skips;"
NSQ_SOURCE_LINE 00000193 "        $tests += $skips;"
NSQ_SOURCE_LINE 00000194 "        Test::Builder->can('note') ? $tb->note($message) : print \"# $message\\n\";"
NSQ_SOURCE_LINE 00000195 "      }"
NSQ_SOURCE_LINE 00000196 "      else {"
NSQ_SOURCE_LINE 00000197 "        $tb->skip_all($message);"
NSQ_SOURCE_LINE 00000198 "      }"
NSQ_SOURCE_LINE 00000199 "    }"
NSQ_SOURCE_LINE 00000200 "    $tb->done_testing($tests)"
NSQ_SOURCE_LINE 00000201 "      if Test::Builder->can('done_testing');"
NSQ_SOURCE_LINE 00000202 "    die bless {} => 'Test::Builder::Exception'"
NSQ_SOURCE_LINE 00000203 "      if Test::Builder->can('parent') && $tb->parent;"
NSQ_SOURCE_LINE 00000204 "  }"
NSQ_SOURCE_LINE 00000205 "  else {"
NSQ_SOURCE_LINE 00000206 "    if ($fail) {"
NSQ_SOURCE_LINE 00000207 "      print \"1..1\\n\";"
NSQ_SOURCE_LINE 00000208 "      print \"not ok 1 - Test::Needs modules available\\n\";"
NSQ_SOURCE_LINE 00000209 "      print STDERR \"# $message\\n\";"
NSQ_SOURCE_LINE 00000210 "      exit 1;"
NSQ_SOURCE_LINE 00000211 "    }"
NSQ_SOURCE_LINE 00000212 "    else {"
NSQ_SOURCE_LINE 00000213 "      print \"1..0 # SKIP $message\\n\";"
NSQ_SOURCE_LINE 00000214 "    }"
NSQ_SOURCE_LINE 00000215 "  }"
NSQ_SOURCE_LINE 00000216 "  exit 0;"
NSQ_SOURCE_LINE 00000217 "}"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "my $terminate_event;"
NSQ_SOURCE_LINE 00000220 "sub _t2_terminate_event () {"
NSQ_SOURCE_LINE 00000221 "  return $terminate_event"
NSQ_SOURCE_LINE 00000222 "    if $terminate_event;"
NSQ_SOURCE_LINE 00000223 "  local $@;"
NSQ_SOURCE_LINE 00000224 "  $terminate_event = eval sprintf <<'END_CODE', __LINE__+2, __FILE__ or die \"$@\";"
NSQ_SOURCE_LINE 00000225 "#line %d \"%s\""
NSQ_SOURCE_LINE 00000226 "    package # hide"
NSQ_SOURCE_LINE 00000227 "      Test::Needs::Event::Terminate;"
NSQ_SOURCE_LINE 00000228 "    use Test2::Event ();"
NSQ_SOURCE_LINE 00000229 "    our @ISA = qw(Test2::Event);"
NSQ_SOURCE_LINE 00000230 "    sub no_display { 1 }"
NSQ_SOURCE_LINE 00000231 "    sub terminate { 0 }"
NSQ_SOURCE_LINE 00000232 "    __PACKAGE__;"
NSQ_SOURCE_LINE 00000233 "END_CODE"
NSQ_SOURCE_LINE 00000234 "    (my $pm = \"$terminate_event.pm\") =~ s{::}{/}g;"
NSQ_SOURCE_LINE 00000235 "    $INC{$pm} = __FILE__;"
NSQ_SOURCE_LINE 00000236 "    $terminate_event;"
NSQ_SOURCE_LINE 00000237 "}"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "1;"
NSQ_SOURCE_LINE 00000240 "__END__"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=pod"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=encoding utf-8"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head1 NAME"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "Test::Needs - Skip tests when modules not available"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "  # need one module"
NSQ_SOURCE_LINE 00000253 "  use Test::Needs 'Some::Module';"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "  # need multiple modules"
NSQ_SOURCE_LINE 00000256 "  use Test::Needs 'Some::Module', 'Some::Other::Module';"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "  # need a given version of a module"
NSQ_SOURCE_LINE 00000259 "  use Test::Needs {"
NSQ_SOURCE_LINE 00000260 "    'Some::Module' => '1.005',"
NSQ_SOURCE_LINE 00000261 "  };"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "  # check later"
NSQ_SOURCE_LINE 00000264 "  use Test::Needs;"
NSQ_SOURCE_LINE 00000265 "  test_needs 'Some::Module';"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "  # skips remainder of subtest"
NSQ_SOURCE_LINE 00000268 "  use Test::More;"
NSQ_SOURCE_LINE 00000269 "  use Test::Needs;"
NSQ_SOURCE_LINE 00000270 "  subtest 'my subtest' => sub {"
NSQ_SOURCE_LINE 00000271 "    test_needs 'Some::Module';"
NSQ_SOURCE_LINE 00000272 "    ..."
NSQ_SOURCE_LINE 00000273 "  };"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "  # check perl version"
NSQ_SOURCE_LINE 00000276 "  use Test::Needs { perl => 5.020 };"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "Skip test scripts if modules are not available.  The requested modules will be"
NSQ_SOURCE_LINE 00000281 "loaded, and optionally have their versions checked.  If the module is missing,"
NSQ_SOURCE_LINE 00000282 "the test script will be skipped.  Modules that are found but fail to compile"
NSQ_SOURCE_LINE 00000283 "will exit with an error rather than skip."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "If used in a subtest, the remainder of the subtest will be skipped."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "Skipping will work even if some tests have already been run, or if a plan has"
NSQ_SOURCE_LINE 00000288 "been declared."
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "Versions are checked via a C<< $module->VERSION($wanted_version) >> call."
NSQ_SOURCE_LINE 00000291 "Versions must be provided in a format that will be accepted.  No extra"
NSQ_SOURCE_LINE 00000292 "processing is done on them."
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "If C<perl> is used as a module, the version is checked against the running perl"
NSQ_SOURCE_LINE 00000295 "version (L<$]|perlvar/$]>).  The version can be specified as a number,"
NSQ_SOURCE_LINE 00000296 "dotted-decimal string, v-string, or version object."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "If the C<RELEASE_TESTING> environment variable is set, the tests will fail"
NSQ_SOURCE_LINE 00000299 "rather than skip.  Subtests will be aborted, but the test script will continue"
NSQ_SOURCE_LINE 00000300 "running after that point."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=head2 test_needs"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "Has the same interface as when using Test::Needs in a C<use>."
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=over 4"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "=item L<Test::Requires>"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "A similar module, with some important differences.  L<Test::Requires> will act"
NSQ_SOURCE_LINE 00000315 "as a C<use> statement (despite its name), calling the import sub.  Under"
NSQ_SOURCE_LINE 00000316 "C<RELEASE_TESTING>, it will BAIL_OUT if a module fails to load rather than"
NSQ_SOURCE_LINE 00000317 "using a normal test fail.  It also doesn't distinguish between missing modules"
NSQ_SOURCE_LINE 00000318 "and broken modules."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "=item L<Test2::Require::Module>"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "Part of the L<Test2> ecosystem.  Only supports running as a C<use> command to"
NSQ_SOURCE_LINE 00000323 "skip an entire plan."
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "=item L<Test2::Require::Perl>"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "Part of the L<Test2> ecosystem.  Only supports running as a C<use> command to"
NSQ_SOURCE_LINE 00000328 "skip an entire plan.  Checks perl versions."
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=item L<Test::If>"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "Acts as a C<use> statement.  Only supports running as a C<use> command to skip"
NSQ_SOURCE_LINE 00000333 "an entire plan.  Can skip based on subref results."
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "=back"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=head1 AUTHORS"
