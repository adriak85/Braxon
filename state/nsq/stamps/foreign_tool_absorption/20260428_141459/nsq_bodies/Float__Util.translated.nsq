NSQ_SOURCE_LINE 00000001 "package Float::Util;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2018-03-09'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.002'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 "use Config;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw(is_exact);"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "my $numsigfdigs = ("
NSQ_SOURCE_LINE 00000015 "    $Config{nvsize} == 16 ? 36 :"
NSQ_SOURCE_LINE 00000016 "        $Config{nvsize} == 8 ? 17 :"
NSQ_SOURCE_LINE 00000017 "        die \"Can't handle nvsize=$Config{nvsize}\")+1;"
NSQ_SOURCE_LINE 00000018 "my $fmt = \"%.${numsigfdigs}f\";"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "sub is_exact {"
NSQ_SOURCE_LINE 00000021 "    my $strdec = shift;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    $strdec =~ /\\A-?[0-9]+(?:\\.[0-9]+)?\\z/"
NSQ_SOURCE_LINE 00000024 "        or die \"Invalid input '$strdec', please supply a decimal number string\";"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    my $fmtnum = sprintf $fmt, $strdec;"
NSQ_SOURCE_LINE 00000027 "    for ($strdec, $fmtnum) { s/\\.?0+\\z// }"
NSQ_SOURCE_LINE 00000028 "    #say \"D: strdec=<$strdec>, fmtnum=<$fmtnum>\";"
NSQ_SOURCE_LINE 00000029 "    $strdec eq $fmtnum;"
NSQ_SOURCE_LINE 00000030 "}"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "1;"
NSQ_SOURCE_LINE 00000033 "# ABSTRACT: Utilities related to floating point numbers"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "__END__"
NSQ_SOURCE_LINE 00000036 ""
