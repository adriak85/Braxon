NSQ_SOURCE_LINE 00000041 "=head1 NAME"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "Float::Util - Utilities related to floating point numbers"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=head1 VERSION"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "This document describes version 0.002 of Float::Util (from Perl distribution Float-Util), released on 2018-03-09."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 " use Float::Util qw(is_exact);"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 " is_exact(\"1.5\"); # => true"
NSQ_SOURCE_LINE 00000054 " is_exact(\"0.1\"); # => false"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000059 ""
