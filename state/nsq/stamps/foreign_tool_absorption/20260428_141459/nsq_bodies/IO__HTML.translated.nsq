NSQ_SOURCE_LINE 00000001 "#---------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000002 "package IO::HTML;"
NSQ_SOURCE_LINE 00000003 "#"
NSQ_SOURCE_LINE 00000004 "# Copyright 2020 Christopher J. Madsen"
NSQ_SOURCE_LINE 00000005 "#"
NSQ_SOURCE_LINE 00000006 "# Author: Christopher J. Madsen <perl@cjmweb.net>"
NSQ_SOURCE_LINE 00000007 "# Created: 14 Jan 2012"
NSQ_SOURCE_LINE 00000008 "#"
NSQ_SOURCE_LINE 00000009 "# This program is free software; you can redistribute it and/or modify"
NSQ_SOURCE_LINE 00000010 "# it under the same terms as Perl itself."
NSQ_SOURCE_LINE 00000011 "#"
NSQ_SOURCE_LINE 00000012 "# This program is distributed in the hope that it will be useful,"
NSQ_SOURCE_LINE 00000013 "# but WITHOUT ANY WARRANTY; without even the implied warranty of"
NSQ_SOURCE_LINE 00000014 "# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See either the"
NSQ_SOURCE_LINE 00000015 "# GNU General Public License or the Artistic License for more details."
NSQ_SOURCE_LINE 00000016 "#"
NSQ_SOURCE_LINE 00000017 "# ABSTRACT: Open an HTML file with automatic charset detection"
NSQ_SOURCE_LINE 00000018 "#---------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "use 5.008;"
NSQ_SOURCE_LINE 00000021 "use strict;"
NSQ_SOURCE_LINE 00000022 "use warnings;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "use Carp 'croak';"
NSQ_SOURCE_LINE 00000025 "use Encode 2.10 qw(decode find_encoding); # need utf-8-strict encoding"
NSQ_SOURCE_LINE 00000026 "use Exporter 5.57 'import';"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "our $VERSION = '1.004';"
NSQ_SOURCE_LINE 00000029 "# This file is part of IO-HTML 1.004 (September 26, 2020)"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "our $bytes_to_check   ||= 1024;"
NSQ_SOURCE_LINE 00000033 "our $default_encoding ||= 'cp1252';"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "our @EXPORT    = qw(html_file);"
NSQ_SOURCE_LINE 00000036 "our @EXPORT_OK = qw(find_charset_in html_file_and_encoding html_outfile"
NSQ_SOURCE_LINE 00000037 "                    sniff_encoding);"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000040 "  rw  => [qw( html_file html_file_and_encoding html_outfile )],"
NSQ_SOURCE_LINE 00000041 "  all => [ @EXPORT, @EXPORT_OK ],"
NSQ_SOURCE_LINE 00000042 ");"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "#====================================================================="
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "sub html_file"
NSQ_SOURCE_LINE 00000048 "{"
NSQ_SOURCE_LINE 00000049 "  (&html_file_and_encoding)[0]; # return just the filehandle"
NSQ_SOURCE_LINE 00000050 "} # end html_file"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "# Note: I made html_file and html_file_and_encoding separate functions"
NSQ_SOURCE_LINE 00000054 "# (instead of making html_file context-sensitive) because I wanted to"
NSQ_SOURCE_LINE 00000055 "# use html_file in function calls (i.e. list context) without having"
NSQ_SOURCE_LINE 00000056 "# to write \"scalar html_file\" all the time."
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "sub html_file_and_encoding"
NSQ_SOURCE_LINE 00000059 "{"
NSQ_SOURCE_LINE 00000060 "  my ($filename, $options) = @_;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "  $options ||= {};"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "  open(my $in, '<:raw', $filename) or croak \"Failed to open $filename: $!\";"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "  my ($encoding, $bom) = sniff_encoding($in, $filename, $options);"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "  if (not defined $encoding) {"
NSQ_SOURCE_LINE 00000070 "    croak \"No default encoding specified\""
NSQ_SOURCE_LINE 00000071 "        unless defined($encoding = $default_encoding);"
NSQ_SOURCE_LINE 00000072 "    $encoding = find_encoding($encoding) if $options->{encoding};"
NSQ_SOURCE_LINE 00000073 "  } # end if we didn't find an encoding"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "  binmode $in, sprintf(\":encoding(%s):crlf\","
NSQ_SOURCE_LINE 00000076 "                       $options->{encoding} ? $encoding->name : $encoding);"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "  return ($in, $encoding, $bom);"
NSQ_SOURCE_LINE 00000079 "} # end html_file_and_encoding"
NSQ_SOURCE_LINE 00000080 "#---------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "sub html_outfile"
NSQ_SOURCE_LINE 00000084 "{"
NSQ_SOURCE_LINE 00000085 "  my ($filename, $encoding, $bom) = @_;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "  if (not defined $encoding) {"
NSQ_SOURCE_LINE 00000088 "    croak \"No default encoding specified\""
NSQ_SOURCE_LINE 00000089 "        unless defined($encoding = $default_encoding);"
NSQ_SOURCE_LINE 00000090 "  } # end if we didn't find an encoding"
NSQ_SOURCE_LINE 00000091 "  elsif (ref $encoding) {"
NSQ_SOURCE_LINE 00000092 "    $encoding = $encoding->name;"
NSQ_SOURCE_LINE 00000093 "  }"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "  open(my $out, \">:encoding($encoding)\", $filename)"
NSQ_SOURCE_LINE 00000096 "      or croak \"Failed to open $filename: $!\";"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "  print $out \"\\x{FeFF}\" if $bom;"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "  return $out;"
NSQ_SOURCE_LINE 00000101 "} # end html_outfile"
NSQ_SOURCE_LINE 00000102 "#---------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "sub sniff_encoding"
NSQ_SOURCE_LINE 00000106 "{"
NSQ_SOURCE_LINE 00000107 "  my ($in, $filename, $options) = @_;"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "  $filename = 'file' unless defined $filename;"
NSQ_SOURCE_LINE 00000110 "  $options ||= {};"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "  my $pos = tell $in;"
NSQ_SOURCE_LINE 00000113 "  croak \"Could not seek $filename: $!\" if $pos < 0;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "  croak \"Could not read $filename: $!\""
NSQ_SOURCE_LINE 00000116 "      unless defined read $in, my($buf), $bytes_to_check;"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "  seek $in, $pos, 0 or croak \"Could not seek $filename: $!\";"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "  # Check for BOM:"
NSQ_SOURCE_LINE 00000122 "  my $bom;"
NSQ_SOURCE_LINE 00000123 "  my $encoding = do {"
NSQ_SOURCE_LINE 00000124 "    if ($buf =~ /^\\xFe\\xFF/) {"
NSQ_SOURCE_LINE 00000125 "      $bom = 2;"
NSQ_SOURCE_LINE 00000126 "      'UTF-16BE';"
NSQ_SOURCE_LINE 00000127 "    } elsif ($buf =~ /^\\xFF\\xFe/) {"
NSQ_SOURCE_LINE 00000128 "      $bom = 2;"
NSQ_SOURCE_LINE 00000129 "      'UTF-16LE';"
NSQ_SOURCE_LINE 00000130 "    } elsif ($buf =~ /^\\xEF\\xBB\\xBF/) {"
NSQ_SOURCE_LINE 00000131 "      $bom = 3;"
NSQ_SOURCE_LINE 00000132 "      'utf-8-strict';"
NSQ_SOURCE_LINE 00000133 "    } else {"
NSQ_SOURCE_LINE 00000134 "      find_charset_in($buf, $options); # check for <meta charset>"
NSQ_SOURCE_LINE 00000135 "    }"
NSQ_SOURCE_LINE 00000136 "  }; # end $encoding"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "  if ($bom) {"
NSQ_SOURCE_LINE 00000139 "    seek $in, $bom, 1 or croak \"Could not seek $filename: $!\";"
NSQ_SOURCE_LINE 00000140 "    $bom = 1;"
NSQ_SOURCE_LINE 00000141 "  }"
NSQ_SOURCE_LINE 00000142 "  elsif (not defined $encoding) { # try decoding as UTF-8"
NSQ_SOURCE_LINE 00000143 "    my $test = decode('utf-8-strict', $buf, Encode::FB_QUIET);"
NSQ_SOURCE_LINE 00000144 "    if ($buf =~ /^(?:                   # nothing left over"
NSQ_SOURCE_LINE 00000145 "         | [\\xC2-\\xDF]                  # incomplete 2-byte char"
NSQ_SOURCE_LINE 00000146 "         | [\\xE0-\\xEF] [\\x80-\\xBF]?     # incomplete 3-byte char"
NSQ_SOURCE_LINE 00000147 "         | [\\xF0-\\xF4] [\\x80-\\xBF]{0,2} # incomplete 4-byte char"
NSQ_SOURCE_LINE 00000148 "        )\\z/x and $test =~ /[^\\x00-\\x7F]/) {"
NSQ_SOURCE_LINE 00000149 "      $encoding = 'utf-8-strict';"
NSQ_SOURCE_LINE 00000150 "    } # end if valid UTF-8 with at least one multi-byte character:"
NSQ_SOURCE_LINE 00000151 "  } # end if testing for UTF-8"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "  if (defined $encoding and $options->{encoding} and not ref $encoding) {"
NSQ_SOURCE_LINE 00000154 "    $encoding = find_encoding($encoding);"
NSQ_SOURCE_LINE 00000155 "  } # end if $encoding is a string and we want an object"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "  return wantarray ? ($encoding, $bom) : $encoding;"
NSQ_SOURCE_LINE 00000158 "} # end sniff_encoding"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "#====================================================================="
NSQ_SOURCE_LINE 00000161 "# Based on HTML5 8.2.2.2 Determining the character encoding:"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "# Get attribute from current position of $_"
NSQ_SOURCE_LINE 00000164 "sub _get_attribute"
NSQ_SOURCE_LINE 00000165 "{"
NSQ_SOURCE_LINE 00000166 "  m!\\G[\\x09\\x0A\\x0C\\x0D /]+!gc; # skip whitespace or /"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "  return if /\\G>/gc or not /\\G(=?[^\\x09\\x0A\\x0C\\x0D =]*)/gc;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "  my ($name, $value) = (lc $1, '');"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "  if (/\\G[\\x09\\x0A\\x0C\\x0D ]*=[\\x09\\x0A\\x0C\\x0D ]*/gc) {"
NSQ_SOURCE_LINE 00000173 "    if (/\\G\"/gc) {"
NSQ_SOURCE_LINE 00000174 "      # Double-quoted attribute value"
NSQ_SOURCE_LINE 00000175 "      /\\G([^\"]*)(\"?)/gc;"
NSQ_SOURCE_LINE 00000176 "      return unless $2; # Incomplete attribute (missing closing quote)"
NSQ_SOURCE_LINE 00000177 "      $value = lc $1;"
NSQ_SOURCE_LINE 00000178 "    } elsif (/\\G'/gc) {"
NSQ_SOURCE_LINE 00000179 "      # Single-quoted attribute value"
NSQ_SOURCE_LINE 00000180 "      /\\G([^']*)('?)/gc;"
NSQ_SOURCE_LINE 00000181 "      return unless $2; # Incomplete attribute (missing closing quote)"
NSQ_SOURCE_LINE 00000182 "      $value = lc $1;"
NSQ_SOURCE_LINE 00000183 "    } else {"
NSQ_SOURCE_LINE 00000184 "      # Unquoted attribute value"
NSQ_SOURCE_LINE 00000185 "      /\\G([^\\x09\\x0A\\x0C\\x0D >]*)/gc;"
NSQ_SOURCE_LINE 00000186 "      $value = lc $1;"
NSQ_SOURCE_LINE 00000187 "    }"
NSQ_SOURCE_LINE 00000188 "  } # end if attribute has value"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "  return wantarray ? ($name, $value) : 1;"
NSQ_SOURCE_LINE 00000191 "} # end _get_attribute"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "# Examine a meta value for a charset:"
NSQ_SOURCE_LINE 00000194 "sub _get_charset_from_meta"
NSQ_SOURCE_LINE 00000195 "{"
NSQ_SOURCE_LINE 00000196 "  for (shift) {"
NSQ_SOURCE_LINE 00000197 "    while (/charset[\\x09\\x0A\\x0C\\x0D ]*=[\\x09\\x0A\\x0C\\x0D ]*/ig) {"
NSQ_SOURCE_LINE 00000198 "      return $1 if (/\\G\"([^\"]*)\"/gc or"
NSQ_SOURCE_LINE 00000199 "                    /\\G'([^']*)'/gc or"
NSQ_SOURCE_LINE 00000200 "                    /\\G(?!['\"])([^\\x09\\x0A\\x0C\\x0D ;]+)/gc);"
NSQ_SOURCE_LINE 00000201 "    }"
NSQ_SOURCE_LINE 00000202 "  } # end for value"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "  return undef;"
NSQ_SOURCE_LINE 00000205 "} # end _get_charset_from_meta"
NSQ_SOURCE_LINE 00000206 "#---------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "sub find_charset_in"
NSQ_SOURCE_LINE 00000210 "{"
NSQ_SOURCE_LINE 00000211 "  for (shift) {"
NSQ_SOURCE_LINE 00000212 "    my $options = shift || {};"
NSQ_SOURCE_LINE 00000213 "    # search only the first $bytes_to_check bytes (default 1024)"
NSQ_SOURCE_LINE 00000214 "    my $stop = length > $bytes_to_check ? $bytes_to_check : length;"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    my $expect_pragma = (defined $options->{need_pragma}"
NSQ_SOURCE_LINE 00000217 "                         ? $options->{need_pragma} : 1);"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "    pos() = 0;"
NSQ_SOURCE_LINE 00000220 "    while (pos() < $stop) {"
NSQ_SOURCE_LINE 00000221 "      if (/\\G<!--.*?(?<=--)>/sgc) {"
NSQ_SOURCE_LINE 00000222 "      } # Skip comment"
NSQ_SOURCE_LINE 00000223 "      elsif (m!\\G<meta(?=[\\x09\\x0A\\x0C\\x0D /])!gic) {"
NSQ_SOURCE_LINE 00000224 "        my ($got_pragma, $need_pragma, $charset);"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "        while (my ($name, $value) = &_get_attribute) {"
NSQ_SOURCE_LINE 00000227 "          if ($name eq 'http-equiv' and $value eq 'content-type') {"
NSQ_SOURCE_LINE 00000228 "            $got_pragma = 1;"
NSQ_SOURCE_LINE 00000229 "          } elsif ($name eq 'content' and not defined $charset) {"
NSQ_SOURCE_LINE 00000230 "            $need_pragma = $expect_pragma"
NSQ_SOURCE_LINE 00000231 "                if defined($charset = _get_charset_from_meta($value));"
NSQ_SOURCE_LINE 00000232 "          } elsif ($name eq 'charset') {"
NSQ_SOURCE_LINE 00000233 "            $charset = $value;"
NSQ_SOURCE_LINE 00000234 "            $need_pragma = 0;"
NSQ_SOURCE_LINE 00000235 "          }"
NSQ_SOURCE_LINE 00000236 "        } # end while more attributes in this <meta> tag"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "        if (defined $need_pragma and (not $need_pragma or $got_pragma)) {"
NSQ_SOURCE_LINE 00000239 "          $charset = 'UTF-8'  if $charset =~ /^utf-?16/;"
NSQ_SOURCE_LINE 00000240 "          $charset = 'cp1252' if $charset eq 'iso-8859-1'; # people lie"
NSQ_SOURCE_LINE 00000241 "          if (my $encoding = find_encoding($charset)) {"
NSQ_SOURCE_LINE 00000242 "            return $options->{encoding} ? $encoding : $encoding->name;"
NSQ_SOURCE_LINE 00000243 "          } # end if charset is a recognized encoding"
NSQ_SOURCE_LINE 00000244 "        } # end if found charset"
NSQ_SOURCE_LINE 00000245 "      } # end elsif <meta"
NSQ_SOURCE_LINE 00000246 "      elsif (m!\\G</?[a-zA-Z][^\\x09\\x0A\\x0C\\x0D >]*!gc) {"
NSQ_SOURCE_LINE 00000247 "        1 while &_get_attribute;"
NSQ_SOURCE_LINE 00000248 "      } # end elsif some other tag"
NSQ_SOURCE_LINE 00000249 "      elsif (m{\\G<[!/?][^>]*}gc) {"
NSQ_SOURCE_LINE 00000250 "      } # skip unwanted things"
NSQ_SOURCE_LINE 00000251 "      elsif (m/\\G</gc) {"
NSQ_SOURCE_LINE 00000252 "      } # skip < that doesn't open anything we recognize"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "      # Advance to the next <:"
NSQ_SOURCE_LINE 00000255 "      m/\\G[^<]+/gc;"
NSQ_SOURCE_LINE 00000256 "    } # end while not at search boundary"
NSQ_SOURCE_LINE 00000257 "  } # end for string"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "  return undef;                 # Couldn't find a charset"
NSQ_SOURCE_LINE 00000260 "} # end find_charset_in"
NSQ_SOURCE_LINE 00000261 "#---------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "# Shortcuts for people who don't like exported functions:"
NSQ_SOURCE_LINE 00000265 "*file               = \\&html_file;"
NSQ_SOURCE_LINE 00000266 "*file_and_encoding  = \\&html_file_and_encoding;"
NSQ_SOURCE_LINE 00000267 "*outfile            = \\&html_outfile;"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "#====================================================================="
NSQ_SOURCE_LINE 00000270 "# Package Return Value:"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "1;"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "__END__"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "=head1 NAME"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "IO::HTML - Open an HTML file with automatic charset detection"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "=head1 VERSION"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "This document describes version 1.004 of"
NSQ_SOURCE_LINE 00000283 "IO::HTML, released September 26, 2020."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "  use IO::HTML;                 # exports html_file by default"
NSQ_SOURCE_LINE 00000288 "  use HTML::TreeBuilder;"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "  my $tree = HTML::TreeBuilder->new_from_file("
NSQ_SOURCE_LINE 00000291 "               html_file('foo.html')"
NSQ_SOURCE_LINE 00000292 "             );"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "  # Alternative interface:"
NSQ_SOURCE_LINE 00000295 "  open(my $in, '<:raw', 'bar.html');"
NSQ_SOURCE_LINE 00000296 "  my $encoding = IO::HTML::sniff_encoding($in, 'bar.html');"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "IO::HTML provides an easy way to open a file containing HTML while"
NSQ_SOURCE_LINE 00000301 "automatically determining its encoding.  It uses the HTML5 encoding"
NSQ_SOURCE_LINE 00000302 "sniffing algorithm specified in section 8.2.2.2 of the draft standard."
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "The algorithm as implemented here is:"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=over"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "=item 1."
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "If the file begins with a byte order mark indicating UTF-16LE,"
NSQ_SOURCE_LINE 00000311 "UTF-16BE, or UTF-8, then that is the encoding."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "=item 2."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "If the first C<$bytes_to_check> bytes of the file contain a C<< <meta> >> tag that"
NSQ_SOURCE_LINE 00000316 "indicates the charset, and Encode recognizes the specified charset"
NSQ_SOURCE_LINE 00000317 "name, then that is the encoding.  (This portion of the algorithm is"
NSQ_SOURCE_LINE 00000318 "implemented by C<find_charset_in>.)"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "The C<< <meta> >> tag can be in one of two formats:"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "  <meta charset=\"...\">"
NSQ_SOURCE_LINE 00000323 "  <meta http-equiv=\"Content-Type\" content=\"...charset=...\">"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "The search is case-insensitive, and the order of attributes within the"
NSQ_SOURCE_LINE 00000326 "tag is irrelevant.  Any additional attributes of the tag are ignored."
NSQ_SOURCE_LINE 00000327 "The first matching tag with a recognized encoding ends the search."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=item 3."
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "If the first C<$bytes_to_check> bytes of the file are valid UTF-8 (with at least 1"
NSQ_SOURCE_LINE 00000332 "non-ASCII character), then the encoding is UTF-8."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "=item 4."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "If all else fails, use the default character encoding.  The HTML5"
NSQ_SOURCE_LINE 00000337 "standard suggests the default encoding should be locale dependent, but"
NSQ_SOURCE_LINE 00000338 "currently it is always C<cp1252> unless you set"
NSQ_SOURCE_LINE 00000339 "C<$IO::HTML::default_encoding> to a different value.  Note:"
NSQ_SOURCE_LINE 00000340 "C<sniff_encoding> does not apply this step; only C<html_file> does"
NSQ_SOURCE_LINE 00000341 "that."
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "=back"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=head1 SUBROUTINES"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=head2 html_file"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "  $filehandle = html_file($filename, \\%options);"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "This function (exported by default) is the primary entry point.  It"
NSQ_SOURCE_LINE 00000352 "opens the file specified by C<$filename> for reading, uses"
NSQ_SOURCE_LINE 00000353 "C<sniff_encoding> to find a suitable encoding layer, and applies it."
NSQ_SOURCE_LINE 00000354 "It also applies the C<:crlf> layer.  If the file begins with a BOM,"
NSQ_SOURCE_LINE 00000355 "the filehandle is positioned just after the BOM."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "The optional second argument is a hashref containing options.  The"
NSQ_SOURCE_LINE 00000358 "possible keys are described under C<find_charset_in>."
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "If C<sniff_encoding> is unable to determine the encoding, it defaults"
NSQ_SOURCE_LINE 00000361 "to C<$IO::HTML::default_encoding>, which is set to C<cp1252>"
NSQ_SOURCE_LINE 00000362 "(a.k.a. Windows-1252) by default.  According to the standard, the"
NSQ_SOURCE_LINE 00000363 "default should be locale dependent, but that is not currently"
NSQ_SOURCE_LINE 00000364 "implemented."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "It dies if the file cannot be opened, or if C<sniff_encoding> cannot"
NSQ_SOURCE_LINE 00000367 "determine the encoding and C<$IO::HTML::default_encoding> has been set"
NSQ_SOURCE_LINE 00000368 "to C<undef>."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=head2 html_file_and_encoding"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "  ($filehandle, $encoding, $bom)"
NSQ_SOURCE_LINE 00000374 "    = html_file_and_encoding($filename, \\%options);"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "This function (exported only by request) is just like C<html_file>,"
NSQ_SOURCE_LINE 00000377 "but returns more information.  In addition to the filehandle, it"
NSQ_SOURCE_LINE 00000378 "returns the name of the encoding used, and a flag indicating whether a"
NSQ_SOURCE_LINE 00000379 "byte order mark was found (if C<$bom> is true, the file began with a"
NSQ_SOURCE_LINE 00000380 "BOM).  This may be useful if you want to write the file out again"
NSQ_SOURCE_LINE 00000381 "(especially in conjunction with the C<html_outfile> function)."
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "The optional second argument is a hashref containing options.  The"
NSQ_SOURCE_LINE 00000384 "possible keys are described under C<find_charset_in>."
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "It dies if the file cannot be opened, or if C<sniff_encoding> cannot"
NSQ_SOURCE_LINE 00000387 "determine the encoding and C<$IO::HTML::default_encoding> has been set"
NSQ_SOURCE_LINE 00000388 "to C<undef>."
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "The result of calling C<html_file_and_encoding> in scalar context is undefined"
NSQ_SOURCE_LINE 00000391 "(in the C sense of there is no guarantee what you'll get)."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "=head2 html_outfile"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "  $filehandle = html_outfile($filename, $encoding, $bom);"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "This function (exported only by request) opens C<$filename> for output"
NSQ_SOURCE_LINE 00000399 "using C<$encoding>, and writes a BOM to it if C<$bom> is true."
NSQ_SOURCE_LINE 00000400 "If C<$encoding> is C<undef>, it defaults to C<$IO::HTML::default_encoding>."
NSQ_SOURCE_LINE 00000401 "C<$encoding> may be either an encoding name or an Encode::Encoding object."
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "It dies if the file cannot be opened, or if both C<$encoding> and"
NSQ_SOURCE_LINE 00000404 "C<$IO::HTML::default_encoding> are C<undef>."
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=head2 sniff_encoding"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "  ($encoding, $bom) = sniff_encoding($filehandle, $filename, \\%options);"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "This function (exported only by request) runs the HTML5 encoding"
NSQ_SOURCE_LINE 00000412 "sniffing algorithm on C<$filehandle> (which must be seekable, and"
NSQ_SOURCE_LINE 00000413 "should have been opened in C<:raw> mode).  C<$filename> is used only"
NSQ_SOURCE_LINE 00000414 "for error messages (if there's a problem using the filehandle), and"
NSQ_SOURCE_LINE 00000415 "defaults to \"file\" if omitted.  The optional third argument is a"
NSQ_SOURCE_LINE 00000416 "hashref containing options.  The possible keys are described under"
NSQ_SOURCE_LINE 00000417 "C<find_charset_in>."
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "It returns Perl's canonical name for the encoding, which is not"
NSQ_SOURCE_LINE 00000420 "necessarily the same as the MIME or IANA charset name.  It returns"
NSQ_SOURCE_LINE 00000421 "C<undef> if the encoding cannot be determined.  C<$bom> is true if the"
NSQ_SOURCE_LINE 00000422 "file began with a byte order mark.  In scalar context, it returns only"
NSQ_SOURCE_LINE 00000423 "C<$encoding>."
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "The filehandle's position is restored to its original position"
NSQ_SOURCE_LINE 00000426 "(normally the beginning of the file) unless C<$bom> is true.  In that"
NSQ_SOURCE_LINE 00000427 "case, the position is immediately after the BOM."
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "Tip: If you want to run C<sniff_encoding> on a file you've already"
NSQ_SOURCE_LINE 00000430 "loaded into a string, open an in-memory file on the string, and pass"
NSQ_SOURCE_LINE 00000431 "that handle:"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "  ($encoding, $bom) = do {"
NSQ_SOURCE_LINE 00000434 "    open(my $fh, '<', \\$string);  sniff_encoding($fh)"
NSQ_SOURCE_LINE 00000435 "  };"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "(This only makes sense if C<$string> contains bytes, not characters.)"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "=head2 find_charset_in"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "  $encoding = find_charset_in($string_containing_HTML, \\%options);"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "This function (exported only by request) looks for charset information"
NSQ_SOURCE_LINE 00000445 "in a C<< <meta> >> tag in a possibly-incomplete HTML document using"
NSQ_SOURCE_LINE 00000446 "the \"two step\" algorithm specified by HTML5.  It does not look for a BOM."
NSQ_SOURCE_LINE 00000447 "The C<< <meta> >> tag must begin within the first C<$IO::HTML::bytes_to_check>"
NSQ_SOURCE_LINE 00000448 "bytes of the string."
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "It returns Perl's canonical name for the encoding, which is not"
NSQ_SOURCE_LINE 00000451 "necessarily the same as the MIME or IANA charset name.  It returns"
NSQ_SOURCE_LINE 00000452 "C<undef> if no charset is specified or if the specified charset is not"
NSQ_SOURCE_LINE 00000453 "recognized by the Encode module."
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "The optional second argument is a hashref containing options.  The"
NSQ_SOURCE_LINE 00000456 "following keys are recognized:"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "=over"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "=item C<encoding>"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "If true, return the L<Encode::Encoding> object instead of its name."
NSQ_SOURCE_LINE 00000463 "Defaults to false."
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=item C<need_pragma>"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "If true (the default), follow the HTML5 spec and examine the"
NSQ_SOURCE_LINE 00000468 "C<content> attribute only of C<< <meta http-equiv=\"Content-Type\" >>."
NSQ_SOURCE_LINE 00000469 "If set to 0, relax the HTML5 spec, and look for \"charset=\" in the"
NSQ_SOURCE_LINE 00000470 "C<content> attribute of I<every> meta tag."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=back"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "By default, only C<html_file> is exported.  Other functions may be"
NSQ_SOURCE_LINE 00000477 "exported on request."
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "For people who prefer not to export functions, all functions beginning"
NSQ_SOURCE_LINE 00000480 "with C<html_> have an alias without that prefix (e.g. you can call"
NSQ_SOURCE_LINE 00000481 "C<IO::HTML::file(...)> instead of C<IO::HTML::html_file(...)>.  These"
NSQ_SOURCE_LINE 00000482 "aliases are not exportable."
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "=for Pod::Coverage"
NSQ_SOURCE_LINE 00000485 "file"
NSQ_SOURCE_LINE 00000486 "file_and_encoding"
NSQ_SOURCE_LINE 00000487 "outfile"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "The following export tags are available:"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "=over"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "=item C<:all>"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "All exportable functions."
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "=item C<:rw>"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "C<html_file>, C<html_file_and_encoding>, C<html_outfile>."
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=back"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "The HTML5 specification, section 8.2.2.2 Determining the character encoding:"
NSQ_SOURCE_LINE 00000506 "L<http://www.w3.org/TR/html5/syntax.html#determining-the-character-encoding>"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "=head1 DIAGNOSTICS"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "=over"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "=item C<< Could not read %s: %s >>"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "The specified file could not be read from for the reason specified by C<$!>."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=item C<< Could not seek %s: %s >>"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "The specified file could not be rewound for the reason specified by C<$!>."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "=item C<< Failed to open %s: %s >>"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "The specified file could not be opened for reading for the reason"
NSQ_SOURCE_LINE 00000525 "specified by C<$!>."
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "=item C<< No default encoding specified >>"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "The C<sniff_encoding> algorithm didn't find an encoding to use, and"
NSQ_SOURCE_LINE 00000531 "you set C<$IO::HTML::default_encoding> to C<undef>."
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=back"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "=head1 CONFIGURATION AND ENVIRONMENT"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "There are two global variables that affect IO::HTML.  If you need to"
NSQ_SOURCE_LINE 00000539 "change them, you should do so using C<local> if possible:"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "  my $file = do {"
NSQ_SOURCE_LINE 00000542 "    # This file may define the charset later in the header"
NSQ_SOURCE_LINE 00000543 "    local $IO::HTML::bytes_to_check = 4096;"
NSQ_SOURCE_LINE 00000544 "    html_file(...);"
NSQ_SOURCE_LINE 00000545 "  };"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "=over"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "=item C<$bytes_to_check>"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "This is the number of bytes that C<sniff_encoding> will read from the"
NSQ_SOURCE_LINE 00000552 "stream.  It is also the number of bytes that C<find_charset_in> will"
NSQ_SOURCE_LINE 00000553 "search for a C<< <meta> >> tag containing charset information."
NSQ_SOURCE_LINE 00000554 "It must be a positive integer."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "The HTML 5 specification recommends using the default value of 1024,"
NSQ_SOURCE_LINE 00000557 "but some pages do not follow the specification."
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "=item C<$default_encoding>"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "This is the encoding that C<html_file> and C<html_file_and_encoding>"
NSQ_SOURCE_LINE 00000562 "will use if no encoding can be detected by C<sniff_encoding>."
NSQ_SOURCE_LINE 00000563 "The default value is C<cp1252> (a.k.a. Windows-1252)."
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "Setting it to C<undef> will cause the file subroutines to croak if"
NSQ_SOURCE_LINE 00000566 "C<sniff_encoding> fails to determine the encoding.  (C<sniff_encoding>"
NSQ_SOURCE_LINE 00000567 "itself does not use C<$default_encoding>)."
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "=back"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "=head1 DEPENDENCIES"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "IO::HTML has no non-core dependencies for Perl 5.8.7+.  With earlier"
NSQ_SOURCE_LINE 00000574 "versions of Perl 5.8, you need to upgrade L<Encode> to at least"
NSQ_SOURCE_LINE 00000575 "version 2.10, and"
NSQ_SOURCE_LINE 00000576 "you may need to upgrade L<Exporter> to at least version"
NSQ_SOURCE_LINE 00000577 "5.57."
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "=head1 INCOMPATIBILITIES"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "None reported."
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "=head1 BUGS AND LIMITATIONS"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "No bugs have been reported."
NSQ_SOURCE_LINE 00000586 ""
