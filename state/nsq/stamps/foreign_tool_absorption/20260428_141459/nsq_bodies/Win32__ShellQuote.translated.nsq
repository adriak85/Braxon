BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Win32::ShellQuote;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings FATAL => 'all';"
NSQ_SOURCE_LINE 00000004 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000005 "use Carp;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.003001';"
NSQ_SOURCE_LINE 00000008 "$VERSION = eval $VERSION;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000011 "    quote_native"
NSQ_SOURCE_LINE 00000012 "    quote_cmd"
NSQ_SOURCE_LINE 00000013 "    quote_system_list"
NSQ_SOURCE_LINE 00000014 "    quote_system_string"
NSQ_SOURCE_LINE 00000015 "    quote_system"
NSQ_SOURCE_LINE 00000016 "    quote_system_cmd"
NSQ_SOURCE_LINE 00000017 "    quote_literal"
NSQ_SOURCE_LINE 00000018 "    cmd_escape"
NSQ_SOURCE_LINE 00000019 "    unquote_native"
NSQ_SOURCE_LINE 00000020 "    cmd_unescape"
NSQ_SOURCE_LINE 00000021 ");"
NSQ_SOURCE_LINE 00000022 "our %EXPORT_TAGS = (all => [@EXPORT_OK]);"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "sub quote_native {"
NSQ_SOURCE_LINE 00000025 "    return join q{ }, quote_system_list(@_);"
NSQ_SOURCE_LINE 00000026 "}"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "sub quote_cmd {"
NSQ_SOURCE_LINE 00000029 "    return cmd_escape(quote_native(@_));"
NSQ_SOURCE_LINE 00000030 "}"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub quote_system_list {"
NSQ_SOURCE_LINE 00000033 "    # have to force quoting, or perl might try to use cmd anyway"
NSQ_SOURCE_LINE 00000034 "    return map { quote_literal($_, 1) } @_;"
NSQ_SOURCE_LINE 00000035 "}"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub quote_system_string {"
NSQ_SOURCE_LINE 00000038 "    my $args = quote_native(@_);"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    if (_has_shell_metachars($args)) {"
NSQ_SOURCE_LINE 00000041 "        $args = cmd_escape($args);"
NSQ_SOURCE_LINE 00000042 "    }"
NSQ_SOURCE_LINE 00000043 "    return $args;"
NSQ_SOURCE_LINE 00000044 "}"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "sub quote_system {"
NSQ_SOURCE_LINE 00000047 "    if (@_ > 1) {"
NSQ_SOURCE_LINE 00000048 "        return quote_system_list(@_);"
NSQ_SOURCE_LINE 00000049 "    }"
NSQ_SOURCE_LINE 00000050 "    else {"
NSQ_SOURCE_LINE 00000051 "        return quote_system_string(@_);"
NSQ_SOURCE_LINE 00000052 "    }"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "sub quote_system_cmd {"
NSQ_SOURCE_LINE 00000056 "    # force cmd, even when running through system"
NSQ_SOURCE_LINE 00000057 "    my $args = quote_native(@_);"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    if (! _has_shell_metachars($args)) {"
NSQ_SOURCE_LINE 00000060 "        # IT BURNS LOOK AWAY"
NSQ_SOURCE_LINE 00000061 "        return '%PATH:~0,0%' . cmd_escape($args);"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 "    return cmd_escape($args);"
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "sub cmd_escape {"
NSQ_SOURCE_LINE 00000068 "    my $string = shift;"
NSQ_SOURCE_LINE 00000069 "    if ($string =~ /[\\r\\n\\0]/) {"
NSQ_SOURCE_LINE 00000070 "        croak \"can't quote newlines to pass through cmd.exe\";"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 "    $string =~ s/([()%!^\"<>&|])/^$1/g;"
NSQ_SOURCE_LINE 00000073 "    return $string;"
NSQ_SOURCE_LINE 00000074 "}"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "sub quote_literal {"
NSQ_SOURCE_LINE 00000077 "    my ($text, $force) = @_;"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    # basic argument quoting.  uses backslashes and quotes to escape"
NSQ_SOURCE_LINE 00000080 "    # everything."
NSQ_SOURCE_LINE 00000081 "    if (!$force && $text ne '' && $text !~ /[ \\t\\n\\x0b\"]/) {"
NSQ_SOURCE_LINE 00000082 "        # no quoting needed"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 "    else {"
NSQ_SOURCE_LINE 00000085 "        $text =~ s{(\\\\*)(?=\"|\\z)}{$1$1}g;"
NSQ_SOURCE_LINE 00000086 "        $text =~ s{\"}{\\\\\"}g;"
NSQ_SOURCE_LINE 00000087 "        $text = qq{\"$text\"};"
NSQ_SOURCE_LINE 00000088 "    }"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    return $text;"
NSQ_SOURCE_LINE 00000091 "}"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "# derived from rules in code in win32.c"
NSQ_SOURCE_LINE 00000094 "sub _has_shell_metachars {"
NSQ_SOURCE_LINE 00000095 "    my $string = shift;"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    return 1"
NSQ_SOURCE_LINE 00000098 "        if $string =~ /%/;"
NSQ_SOURCE_LINE 00000099 "    $string =~ s/(['\"]).*?(\\1|\\z)//sg;"
NSQ_SOURCE_LINE 00000100 "    return $string =~ /[<>|]/;"
NSQ_SOURCE_LINE 00000101 "}"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "sub unquote_native {"
NSQ_SOURCE_LINE 00000104 "    local ($_) = @_;"
NSQ_SOURCE_LINE 00000105 "    my @argv;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    my $length = length"
NSQ_SOURCE_LINE 00000108 "        or return @argv;"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "    m/\\G\\s*/gc;"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "    ARGS: until ( pos == $length ) {"
NSQ_SOURCE_LINE 00000113 "        my $quote_mode;"
NSQ_SOURCE_LINE 00000114 "        my $arg = '';"
NSQ_SOURCE_LINE 00000115 "        CHARS: until ( pos == $length ) {"
NSQ_SOURCE_LINE 00000116 "            if ( m/\\G((?:\\\\\\\\)+)(?=\\\\?(\")?)/gc ) {"
NSQ_SOURCE_LINE 00000117 "                if (defined $2) {"
NSQ_SOURCE_LINE 00000118 "                    $arg .= '\\\\' x (length($1) / 2);"
NSQ_SOURCE_LINE 00000119 "                }"
NSQ_SOURCE_LINE 00000120 "                else {"
NSQ_SOURCE_LINE 00000121 "                    $arg .= $1;"
NSQ_SOURCE_LINE 00000122 "                }"
NSQ_SOURCE_LINE 00000123 "            }"
NSQ_SOURCE_LINE 00000124 "            elsif ( m/\\G\\\\\"/gc ) {"
NSQ_SOURCE_LINE 00000125 "                $arg .= '\"';"
NSQ_SOURCE_LINE 00000126 "            }"
NSQ_SOURCE_LINE 00000127 "            elsif ( m/\\G\"/gc ) {"
NSQ_SOURCE_LINE 00000128 "                if ( $quote_mode && m/\\G\"/gc ) {"
NSQ_SOURCE_LINE 00000129 "                    $arg .= '\"';"
NSQ_SOURCE_LINE 00000130 "                }"
NSQ_SOURCE_LINE 00000131 "                $quote_mode = !$quote_mode;"
NSQ_SOURCE_LINE 00000132 "            }"
NSQ_SOURCE_LINE 00000133 "            elsif ( !$quote_mode && m/\\G\\s+/gc ) {"
NSQ_SOURCE_LINE 00000134 "                last;"
NSQ_SOURCE_LINE 00000135 "            }"
NSQ_SOURCE_LINE 00000136 "            elsif ( m/\\G(.)/sgc ) {"
NSQ_SOURCE_LINE 00000137 "                $arg .= $1;"
NSQ_SOURCE_LINE 00000138 "            }"
NSQ_SOURCE_LINE 00000139 "        }"
NSQ_SOURCE_LINE 00000140 "        push @argv, $arg;"
NSQ_SOURCE_LINE 00000141 "    }"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    return @argv;"
NSQ_SOURCE_LINE 00000144 "}"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "sub cmd_unescape {"
NSQ_SOURCE_LINE 00000147 "    my ($string) = @_;"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000150 "    $string =~ s/\\^(.?)|([^^\"]+)|(\"[^\"]*(?:\"|\\z))/$1$2$3/gs;"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    return $string;"
NSQ_SOURCE_LINE 00000153 "}"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "1;"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "__END__"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=head1 NAME"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "Win32::ShellQuote - Quote argument lists for Win32"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "    use Win32::ShellQuote qw(:all);"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    system quote_system('program.exe', '--switch', 'argument with spaces or other special characters');"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "Quotes argument lists to be used in Win32 in several different"
NSQ_SOURCE_LINE 00000172 "situations."
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "Windows passes its arguments as a single string instead of an array"
NSQ_SOURCE_LINE 00000175 "as other platforms do.  In almost all cases, the standard Win32"
NSQ_SOURCE_LINE 00000176 "L<CommandLineToArgvW|http://msdn.microsoft.com/en-us/library/ms647232.aspx>"
NSQ_SOURCE_LINE 00000177 "function is used to parse this string.  F<cmd.exe> has different"
NSQ_SOURCE_LINE 00000178 "rules for handling quoting, so extra work has to be done if it is"
NSQ_SOURCE_LINE 00000179 "involved.  It isn't possible to consistantly create a single string"
NSQ_SOURCE_LINE 00000180 "that will be handled the same by F<cmd.exe> and the stardard parsing"
NSQ_SOURCE_LINE 00000181 "rules."
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "Perl will try to detect if you need the shell by detecting shell"
NSQ_SOURCE_LINE 00000184 "metacharacters.  The routine that checks that uses different quoting"
NSQ_SOURCE_LINE 00000185 "rules from both F<cmd.exe> and the native Win32 parsing.  Extra"
NSQ_SOURCE_LINE 00000186 "work must therefore be done to protect against this autodetection."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=head1 SUBROUTINES"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=head2 quote_native"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "Quotes as a string to pass directly to a program using native methods"
NSQ_SOURCE_LINE 00000193 "like L<Win32::Spawn()|Win32>.  This is the safest option to use if"
NSQ_SOURCE_LINE 00000194 "possible."
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=head2 quote_cmd"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "Quotes as a string to be run through F<cmd.exe>, such as in a batch file."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=head2 quote_system_list"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "Quotes as a list to be passed to L<system|perlfunc/system> or"
NSQ_SOURCE_LINE 00000203 "L<exec|perlfunc/exec>.  This is equally as safe as L</quote_native>,"
NSQ_SOURCE_LINE 00000204 "but you must ensure you have more than one item being quoted for"
NSQ_SOURCE_LINE 00000205 "the list to be usable with system."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=head2 quote_system_string"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "Like L</quote_system_list>, but returns a single string.  Some"
NSQ_SOURCE_LINE 00000210 "argument lists cannot be properly quoted using this function."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=head2 quote_system"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "Switches between L</quote_system_list> and L</quote_system_string>"
NSQ_SOURCE_LINE 00000215 "based on the number of items quoted."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=head2 quote_system_cmd"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "Quotes as a single string that will always be run with F<cmd.exe>."
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=head2 quote_literal"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "Quotes a single parameter in native form."
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=head2 cmd_escape"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "Escapes a string to be passed untouched by F<cmd.exe>."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=over"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=item *"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "Newlines (\\n or \\r) and null (\\0) can't be properly quoted when"
NSQ_SOURCE_LINE 00000236 "running through F<cmd.exe>."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=item *"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "This module re-implements some under-specified part of the perl"
NSQ_SOURCE_LINE 00000241 "internals to accurately perform its work."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=back"
NSQ_SOURCE_LINE 00000244 ""
