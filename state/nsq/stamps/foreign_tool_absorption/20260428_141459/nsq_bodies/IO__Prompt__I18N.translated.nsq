BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package IO::Prompt::I18N;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000010 "our $DATE = '2023-11-20'; # DATE"
NSQ_SOURCE_LINE 00000011 "our $DIST = 'IO-Prompt-I18N'; # DIST"
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.81'; # VERSION"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw(prompt confirm);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub prompt {"
NSQ_SOURCE_LINE 00000017 "    my ($text, $opts) = @_;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    $text //= \"Enter value\";"
NSQ_SOURCE_LINE 00000020 "    $opts //= {};"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    my $answer;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    my $default;"
NSQ_SOURCE_LINE 00000025 "    $default = ${$opts->{var}} if $opts->{var};"
NSQ_SOURCE_LINE 00000026 "    $default = $opts->{default} if defined($opts->{default});"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    while (1) {"
NSQ_SOURCE_LINE 00000029 "        # prompt"
NSQ_SOURCE_LINE 00000030 "        print $text;"
NSQ_SOURCE_LINE 00000031 "        print \" ($default)\" if defined($default) && $opts->{show_default}//1;"
NSQ_SOURCE_LINE 00000032 "        print \":\" unless $text =~ /[:?]\\s*$/;"
NSQ_SOURCE_LINE 00000033 "        print \" \";"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "        # get input"
NSQ_SOURCE_LINE 00000036 "        $answer = <STDIN>;"
NSQ_SOURCE_LINE 00000037 "        if (!defined($answer)) {"
NSQ_SOURCE_LINE 00000038 "            print \"\\n\";"
NSQ_SOURCE_LINE 00000039 "            $answer = \"\";"
NSQ_SOURCE_LINE 00000040 "        }"
NSQ_SOURCE_LINE 00000041 "        chomp($answer);"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "        # check+process answer"
NSQ_SOURCE_LINE 00000044 "        if (defined($default)) {"
NSQ_SOURCE_LINE 00000045 "            $answer = $default if !length($answer);"
NSQ_SOURCE_LINE 00000046 "        }"
NSQ_SOURCE_LINE 00000047 "        my $success = 1;"
NSQ_SOURCE_LINE 00000048 "        if ($opts->{required}) {"
NSQ_SOURCE_LINE 00000049 "            $success = 0 if !length($answer);"
NSQ_SOURCE_LINE 00000050 "        }"
NSQ_SOURCE_LINE 00000051 "        if ($opts->{regex}) {"
NSQ_SOURCE_LINE 00000052 "            $success = 0 if $answer !~ /$opts->{regex}/;"
NSQ_SOURCE_LINE 00000053 "        }"
NSQ_SOURCE_LINE 00000054 "        last if $success;"
NSQ_SOURCE_LINE 00000055 "    }"
NSQ_SOURCE_LINE 00000056 "    ${$opts->{var}} = $answer if $opts->{var};"
NSQ_SOURCE_LINE 00000057 "    $answer;"
NSQ_SOURCE_LINE 00000058 "}"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub confirm {"
NSQ_SOURCE_LINE 00000061 "    my ($text, $opts) = @_;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    $opts //= {};"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    state $supported_langs = {"
NSQ_SOURCE_LINE 00000066 "        en => {yes_words=>[qw/y yes/], no_words=>[qw/n no/]   , text=>'Confirm'},"
NSQ_SOURCE_LINE 00000067 "        fr => {yes_words=>[qw/o oui/], no_words=>[qw/n non/]  , text=>'Confirmer'},"
NSQ_SOURCE_LINE 00000068 "        id => {yes_words=>[qw/y ya/] , no_words=>[qw/t tidak/], text=>'Konfirmasi'},"
NSQ_SOURCE_LINE 00000069 "    };"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "    $opts->{lang} //= do {"
NSQ_SOURCE_LINE 00000072 "        if ($ENV{LANG} && $ENV{LANG} =~ /^([a-z]{2})/ &&"
NSQ_SOURCE_LINE 00000073 "                $supported_langs->{$1}) {"
NSQ_SOURCE_LINE 00000074 "            $1;"
NSQ_SOURCE_LINE 00000075 "        } elsif ($ENV{LANGUAGE} && $ENV{LANGUAGE} =~ /^([a-z]{2})/ &&"
NSQ_SOURCE_LINE 00000076 "                $supported_langs->{$1}) {"
NSQ_SOURCE_LINE 00000077 "            $1;"
NSQ_SOURCE_LINE 00000078 "        } else {"
NSQ_SOURCE_LINE 00000079 "            'en';"
NSQ_SOURCE_LINE 00000080 "        }"
NSQ_SOURCE_LINE 00000081 "    };"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "    my $lang = $supported_langs->{$opts->{lang}}"
NSQ_SOURCE_LINE 00000084 "        or die \"Unknown language '$opts->{lang}'\";"
NSQ_SOURCE_LINE 00000085 "    $text //= $lang->{text};"
NSQ_SOURCE_LINE 00000086 "    $opts->{yes_words} //= $lang->{yes_words};"
NSQ_SOURCE_LINE 00000087 "    $opts->{no_words}  //= $lang->{no_words};"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    my $default;"
NSQ_SOURCE_LINE 00000090 "    if (defined $opts->{default}) {"
NSQ_SOURCE_LINE 00000091 "        if ($opts->{default}) {"
NSQ_SOURCE_LINE 00000092 "            $default = $opts->{yes_words}[0];"
NSQ_SOURCE_LINE 00000093 "        } else {"
NSQ_SOURCE_LINE 00000094 "            $default = $opts->{no_words}[0];"
NSQ_SOURCE_LINE 00000095 "        }"
NSQ_SOURCE_LINE 00000096 "    }"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    my $suffix;"
NSQ_SOURCE_LINE 00000099 "    my $show_default = 1;"
NSQ_SOURCE_LINE 00000100 "    unless ($text =~ /[?]/) {"
NSQ_SOURCE_LINE 00000101 "        $text .="
NSQ_SOURCE_LINE 00000102 "            join(\"\","
NSQ_SOURCE_LINE 00000103 "                 \" (\","
NSQ_SOURCE_LINE 00000104 "                 join(\"/\","
NSQ_SOURCE_LINE 00000105 "                      (map {$opts->{default} ? uc($_) : lc($_)}"
NSQ_SOURCE_LINE 00000106 "                           @{ $opts->{yes_words} }),"
NSQ_SOURCE_LINE 00000107 "                      (map {defined($opts->{default}) && !$opts->{default} ?"
NSQ_SOURCE_LINE 00000108 "                                        uc($_) : lc($_)}"
NSQ_SOURCE_LINE 00000109 "                           @{ $opts->{no_words} }),"
NSQ_SOURCE_LINE 00000110 "                  ),"
NSQ_SOURCE_LINE 00000111 "                 \")?\","
NSQ_SOURCE_LINE 00000112 "             );"
NSQ_SOURCE_LINE 00000113 "        $show_default = 0; # because we already indicate which using uppercase"
NSQ_SOURCE_LINE 00000114 "    }"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    my $re = join(\"|\", map {quotemeta}"
NSQ_SOURCE_LINE 00000117 "                      (@{$opts->{yes_words}}, @{$opts->{no_words}}));"
NSQ_SOURCE_LINE 00000118 "    $re = qr/\\A($re)\\z/i;"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "    my $answer = prompt($text, {"
NSQ_SOURCE_LINE 00000121 "        required     => 1,"
NSQ_SOURCE_LINE 00000122 "        regex        => $re,"
NSQ_SOURCE_LINE 00000123 "        show_default => $show_default,"
NSQ_SOURCE_LINE 00000124 "        default      => $default,"
NSQ_SOURCE_LINE 00000125 "    });"
NSQ_SOURCE_LINE 00000126 "    (grep {$_ eq $answer} @{$opts->{yes_words}}) ? 1:0;"
NSQ_SOURCE_LINE 00000127 "}"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "1;"
NSQ_SOURCE_LINE 00000130 "# ABSTRACT: Prompt user question, with some options (including I18N)"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "__END__"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=pod"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=head1 NAME"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "IO::Prompt::I18N - Prompt user question, with some options (including I18N)"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=head1 VERSION"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "This document describes version 0.81 of IO::Prompt::I18N (from Perl distribution IO-Prompt-I18N), released on 2023-11-20."
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 " use IO::Prompt::I18N qw(prompt confirm);"
NSQ_SOURCE_LINE 00000149 " use Text::LocaleDomain 'My-App';"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 " my $file = prompt(__\"Enter filename\");"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 " if (confirm(__\"Really delete filename\", {lang=>\"id\", default=>0})) {"
NSQ_SOURCE_LINE 00000154 "     unlink $file;"
NSQ_SOURCE_LINE 00000155 " }"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "This module provides the C<prompt> function to ask for a value from STDIN. It"
NSQ_SOURCE_LINE 00000160 "features prompt text, default value, validation (using regex),"
NSQ_SOURCE_LINE 00000161 "optional/required. It also provides C<confirm> wrapper to ask yes/no, with"
NSQ_SOURCE_LINE 00000162 "localizable text."
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=head2 prompt([ $text[, \\%opts] ]) => val"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "Display C<$text> and ask value from STDIN. Will re-ask if value is not valid."
NSQ_SOURCE_LINE 00000169 "Return the chomp-ed value."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "Options:"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=over"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=item * var => \\$var"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=item * required => bool"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "If set to true then will require that value is not empty (zero-length)."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=item * default => VALUE"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "Set default value."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=item * show_default => bool (default: 1)"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "Whether to show default value if defined."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=item * regex => REGEX"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "Validate using regex."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=back"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=head2 confirm([ $text, [\\%opts] ]) => bool"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "Display C<$text> (defaults to C<Confirm> in English) and ask for yes or no. Will"
NSQ_SOURCE_LINE 00000198 "return bool. Basically a convenient wrapper around C<prompt>."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "Options:"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=over"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=item * lang => str"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "Support several languages (C<id>, C<en>, C<fr>). Default to using LANG/LANGUAGE"
NSQ_SOURCE_LINE 00000207 "or English. Will preset C<yes_words> and C<no_words> and adds the choice of"
NSQ_SOURCE_LINE 00000208 "words to C<$text>. Will die if language is not supported. Here are the supported"
NSQ_SOURCE_LINE 00000209 "languages:"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "  lang  yes_words     no_regex   default text"
NSQ_SOURCE_LINE 00000212 "  ----  ---------     --------   ------------"
NSQ_SOURCE_LINE 00000213 "  en    y, yes        n, no      Confirm"
NSQ_SOURCE_LINE 00000214 "  fr    o, oui        n, non     Confirmer"
NSQ_SOURCE_LINE 00000215 "  id    y, ya         t, tidak   Konfirmasi"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=item * yes_words => array"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "Overrides preset from C<lang>."
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=item * no_words => array"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "Overrides preset from C<lang>."
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=item * default => bool"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "Set default value."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=back"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "Please visit the project's homepage at L<https://metacpan.org/release/IO-Prompt-I18N>."
NSQ_SOURCE_LINE 00000234 ""
