NSQ_SOURCE_LINE 00000001 "package Text::Levenshtein::Flexible;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.008008;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Carp;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "require Exporter;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000013 "    'all' => ["
NSQ_SOURCE_LINE 00000014 "        qw/"
NSQ_SOURCE_LINE 00000015 "        levenshtein"
NSQ_SOURCE_LINE 00000016 "        levenshtein_c"
NSQ_SOURCE_LINE 00000017 "        levenshtein_l"
NSQ_SOURCE_LINE 00000018 "        levenshtein_lc"
NSQ_SOURCE_LINE 00000019 "        levenshtein_l_all"
NSQ_SOURCE_LINE 00000020 "        levenshtein_lc_all"
NSQ_SOURCE_LINE 00000021 "        /"
NSQ_SOURCE_LINE 00000022 "    ]"
NSQ_SOURCE_LINE 00000023 ");"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "our @EXPORT_OK = ( @{ $EXPORT_TAGS{'all'} } );"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "our $VERSION = '0.10';"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "require XSLoader;"
NSQ_SOURCE_LINE 00000030 "XSLoader::load('Text::Levenshtein::Flexible', $VERSION);"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub levenshtein_l_all {"
NSQ_SOURCE_LINE 00000033 "    Text::Levenshtein::Flexible->new(shift)->distance_l_all(@_);"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub levenshtein_lc_all {"
NSQ_SOURCE_LINE 00000037 "    Text::Levenshtein::Flexible->new(splice(@_, 0, 4))->distance_lc_all(@_);"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "1;"
NSQ_SOURCE_LINE 00000041 "__END__"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=head1 NAME"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "Text::Levenshtein::Flexible - XS Levenshtein distance calculation with bounds and costs"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "  use Text::Levenshtein::Flexible;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "Yet another Levenshtein module written in C, but a tad more flexible than the rest."
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "This module uses code from PostgreSQL's levenshtein distance function to"
NSQ_SOURCE_LINE 00000058 "provide the following features on top of plain distance calculation as it is"
NSQ_SOURCE_LINE 00000059 "done by Levenshtein::XS and others:"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=over 4"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=item Distance-limited calculation: if a certain maximum distance is exceeded,"
NSQ_SOURCE_LINE 00000064 "the algorithm aborts without result. This helps performance in situations where"
NSQ_SOURCE_LINE 00000065 "it is clear that results over a certain maximum are not useful."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=item Configurable costs for insert, delete ans substitute operations. The"
NSQ_SOURCE_LINE 00000068 "traditional Levenshtein algorithm assumes equal cost for insertion and deletion"
NSQ_SOURCE_LINE 00000069 "but modifying these allows preferential correction of certain errors."
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=back"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=head2 EXPORT"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "Nothing is exported by default."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "=head2 Exportable"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "The following functions can be exported upon request, e.g.:"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    use Text::Levenshtein::Flexible qw( levenshtein levenshtein_l_all );"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=over 4"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "=item C<levenshtein>"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "=item C<levenshtein_c>"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=item C<levenshtein_l>"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=item C<levenshtein_lc>"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=item C<levenshtein_l_all>"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=item C<levenshtein_lc_all>"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=back"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=head2 Procedural interface"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "The functions listed under L</Exportable> consitute the module's procedural"
NSQ_SOURCE_LINE 00000102 "API. Neither the names nor the huge parameter lists are particularly pretty so"
NSQ_SOURCE_LINE 00000103 "the OO interface is usually recommended."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=head3 levenshtein($src, $dst)"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "Plain Levenshtein distance calculation between the two strings C<$src> and C<$dst>."
NSQ_SOURCE_LINE 00000108 "Always returns an integer. If the strings are too long (currently there is a"
NSQ_SOURCE_LINE 00000109 "hard-coded limit of 255 characters), the function may C<die()>, so call it in an"
NSQ_SOURCE_LINE 00000110 "eval block if this is a possibility."
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=head3 levenshtein_c($src, $dst, $cost_ins, $cost_del, $cost_sub)"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "Distance between the two strings C<$src> and C<$dst> using the specified costs for"
NSQ_SOURCE_LINE 00000115 "insertion, deletion and substitution respectively. Always returns an integer"
NSQ_SOURCE_LINE 00000116 "unless it dies."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=head3 levenshtein_l($src, $dst, $max_distance)"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "Distance between C<$src> and C<$dst> unless it is bigger than C<$max_distance>"
NSQ_SOURCE_LINE 00000121 "(think C<_l>imit!), in which case C<undef> is returned. May die just like the"
NSQ_SOURCE_LINE 00000122 "other functions."
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "=head3 levenshtein_lc($src, $dst, $max_distance, $cost_ins, $cost_del, $cost_sub)"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "Distance between C<$src> and C<$dst> using the specified costs, up to C<$max_distance>,"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=head3 levenshtein_l_all($max_distance, $src, @dst)"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "For an array C<@dst> of strings, return all that are up to C<$max_distance>"
NSQ_SOURCE_LINE 00000131 "from C<$src>. The result is a list of 2-element arrays consisting of"
NSQ_SOURCE_LINE 00000132 "string-distance pairs. To get a list of strings sorted by distance:"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "    map { $_->[0] }"
NSQ_SOURCE_LINE 00000135 "    sort { $a->[1] <=> $b->[1] }"
NSQ_SOURCE_LINE 00000136 "    levenshtein_l_all(2, \"bar\", \"foo\", \"blah\", \"baz\");"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "Note that since the C<*_all> functions were converted to XS as well, this"
NSQ_SOURCE_LINE 00000139 "function delegates to the OO version internally to avoid too much XS code"
NSQ_SOURCE_LINE 00000140 "duplication, so the OO interface is preferable for this in any case."
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=head3 levenshtein_lc_all($max_distance, $cost_ins, $cost_del, $cost_sub, $src, @dst)"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "For an array C<@dst> of strings, return all that are up to C<$max_distance>"
NSQ_SOURCE_LINE 00000145 "from C<$src> when using the specified costs as in levenshtein_c. The result is"
NSQ_SOURCE_LINE 00000146 "the same as for C<levenshtein_l_all> and the remark about the OO version"
NSQ_SOURCE_LINE 00000147 "applies equally here."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "Note that there is no C<levenshtein_all()> function because it is trivial to"
NSQ_SOURCE_LINE 00000150 "write using C<map>."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=head2 Object-oriented interface"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "The OO API will usually be more convenient except for trivial calculations"
NSQ_SOURCE_LINE 00000155 "because it allows to specify limits and costs once and pass only variable data"
NSQ_SOURCE_LINE 00000156 "to object methods. Being implemented in C/XS it is just as fast as the"
NSQ_SOURCE_LINE 00000157 "procedural one, or faster in the case of the list functions."
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=head3 new($max_distance, $cost_ins, $cost_del, $cost_sub)"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "All four constructor arguments are optional but must be defined if they are"
NSQ_SOURCE_LINE 00000162 "used, i.e. you have to specify a number for C<$max_distance> if you want to use"
NSQ_SOURCE_LINE 00000163 "the costs. Pass 1 for costs and some number over 255 times the largest of the"
NSQ_SOURCE_LINE 00000164 "cost values for C<$max_distance> (passing something significantly bigger"
NSQ_SOURCE_LINE 00000165 "doesn't hurt, in case the hardcoded limit for calculations should grow some"
NSQ_SOURCE_LINE 00000166 "day) if you don't care."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=head3 distance($src, $dst)"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "Just for orthogonality, this does the same as C<levenshtein()>."
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=head3 distance_c($src, $dst)"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "Just like C<levenshtein_c()> but using the previously specified costs."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "=head3 distance_l($src, $dst)"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "C<levenshtein_l()>'s modern brother."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=head3 distance_lc($src, $dst)"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "The nicer variant of C<levenshtein_lc()>."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=head3 distance_l_all($src, @dst)"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "Not quite as ugly but otherwise equivalent to C<levenshtein_l_all()>."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=head3 distance_lc_all($src, @dst)"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "Where C<levenshtein_lc_all()> gets really nasty, this does the same in a saner way."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "Of course there's no C<distance_all()> method either."
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=head2 Speed"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "According to a few completely made-up benchmarks,"
NSQ_SOURCE_LINE 00000197 "L<Text::Levenshtein::Flexible> is at least as fast as either"
NSQ_SOURCE_LINE 00000198 "L<Text::Levenshtein::XS> or L<Text::Fuzzy> (Core i5 920) and between 25% and"
NSQ_SOURCE_LINE 00000199 "48% faster on some systems (Phenom II X6 1090T). For pure 8-bit character sets,"
NSQ_SOURCE_LINE 00000200 "L<Text::LevenshteinXS> is usually a tad faster, but it can't deal with"
NSQ_SOURCE_LINE 00000201 "multibyte characters at all. A small benchmark script is included to test on"
NSQ_SOURCE_LINE 00000202 "your system, I'd be interested to hear about any unexpectedly good or bad"
NSQ_SOURCE_LINE 00000203 "performance."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "L<Text::Levenshtein::XS>"
NSQ_SOURCE_LINE 00000208 "L<Text::LevenshteinXS>"
NSQ_SOURCE_LINE 00000209 "L<Text::Fuzzy>"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "Dont even bother with anything else unless you're more interested in the"
NSQ_SOURCE_LINE 00000212 "algorithm than in practical applications as the algorithm is one of the better"
NSQ_SOURCE_LINE 00000213 "examples for something reasonably efficient in C that Perl is terrible at."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "To find this module's lastest updates that are not on CPAN yet, check"
NSQ_SOURCE_LINE 00000216 "L<https://github.com/mbethke/Text-Levenshtein-Flexible>"
NSQ_SOURCE_LINE 00000217 ""
