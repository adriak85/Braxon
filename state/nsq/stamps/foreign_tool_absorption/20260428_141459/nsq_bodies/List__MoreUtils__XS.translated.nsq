NSQ_SOURCE_LINE 00000001 "package List::MoreUtils::XS;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.008_001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use base ('Exporter');"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use vars qw{$VERSION @ISA @EXPORT @EXPORT_OK %EXPORT_TAGS};"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "$VERSION = '0.430';"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "@EXPORT    = ();"
NSQ_SOURCE_LINE 00000013 "@EXPORT_OK = qw(any all none notall one"
NSQ_SOURCE_LINE 00000014 "  any_u all_u none_u notall_u one_u"
NSQ_SOURCE_LINE 00000015 "  reduce_u reduce_0 reduce_1"
NSQ_SOURCE_LINE 00000016 "  true false"
NSQ_SOURCE_LINE 00000017 "  insert_after insert_after_string"
NSQ_SOURCE_LINE 00000018 "  apply indexes slide"
NSQ_SOURCE_LINE 00000019 "  after after_incl before before_incl"
NSQ_SOURCE_LINE 00000020 "  firstidx lastidx onlyidx"
NSQ_SOURCE_LINE 00000021 "  firstval lastval onlyval"
NSQ_SOURCE_LINE 00000022 "  firstres lastres onlyres"
NSQ_SOURCE_LINE 00000023 "  singleton duplicates frequency occurrences mode"
NSQ_SOURCE_LINE 00000024 "  each_array each_arrayref"
NSQ_SOURCE_LINE 00000025 "  pairwise natatime slideatatime"
NSQ_SOURCE_LINE 00000026 "  arrayify mesh zip6 uniq listcmp"
NSQ_SOURCE_LINE 00000027 "  samples minmax minmaxstr part"
NSQ_SOURCE_LINE 00000028 "  bsearch bsearchidx binsert bremove lower_bound upper_bound equal_range"
NSQ_SOURCE_LINE 00000029 "  qsort);"
NSQ_SOURCE_LINE 00000030 "%EXPORT_TAGS = (all => \\@EXPORT_OK);"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "# Load the XS at compile-time so that redefinition warnings will be"
NSQ_SOURCE_LINE 00000033 "# thrown correctly if the XS versions of part or indexes loaded"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "# PERL_DL_NONLAZY must be false, or any errors in loading will just"
NSQ_SOURCE_LINE 00000036 "# cause the perl code to be tested"
NSQ_SOURCE_LINE 00000037 "local $ENV{PERL_DL_NONLAZY} = 0 if $ENV{PERL_DL_NONLAZY};"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "use XSLoader ();"
NSQ_SOURCE_LINE 00000040 "XSLoader::load(\"List::MoreUtils::XS\", \"$VERSION\");"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=pod"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=head1 NAME"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "List::MoreUtils::XS - Provide compiled List::MoreUtils functions"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "  use List::MoreUtils::XS (); # doesn't export anything"
NSQ_SOURCE_LINE 00000051 "  use List::MoreUtils ':all'; # required to import functions"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "  my @procs = get_process_stats->fetchall_array;"
NSQ_SOURCE_LINE 00000054 "  # sort by ppid, then pid"
NSQ_SOURCE_LINE 00000055 "  qsort { $a->[3] <=> $b->[3] or $a->[2] <=> $b->[2] } @procs;"
NSQ_SOURCE_LINE 00000056 "  while( @procs ) {"
NSQ_SOURCE_LINE 00000057 "      my $proc = shift @procs;"
NSQ_SOURCE_LINE 00000058 "      my @children = equal_range { $_->[3] <=> $proc->[2] } @procs;"
NSQ_SOURCE_LINE 00000059 "  }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "  my @left = qw(this is a test);"
NSQ_SOURCE_LINE 00000062 "  my @right = qw(this is also a test);"
NSQ_SOURCE_LINE 00000063 "  my %rlinfo = listcmp @left, @right;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "  # on unsorted"
NSQ_SOURCE_LINE 00000066 "  my $i = firstidx { $_ eq 'yeah' } @foo;"
NSQ_SOURCE_LINE 00000067 "  # on sorted - always first, but might not be 'yeah'"
NSQ_SOURCE_LINE 00000068 "  my $j = lower_bound { $_ cmp 'yeah' } @bar;"
NSQ_SOURCE_LINE 00000069 "  # on sorted - any of occurrences, is surely 'yeah'"
NSQ_SOURCE_LINE 00000070 "  my $k = bsearchidx { $_ cmp 'yeah' } @bar;"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "List::MoreUtils::XS is a backend for List::MoreUtils. Even if it's possible"
NSQ_SOURCE_LINE 00000075 "(because of user wishes) to have it practically independent from"
NSQ_SOURCE_LINE 00000076 "L<List::MoreUtils>, it technically depend on C<List::MoreUtils>. Since it's"
NSQ_SOURCE_LINE 00000077 "only a backend, the API is not public and can change without any warning."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "L<List::Util>, L<List::AllUtils>"
