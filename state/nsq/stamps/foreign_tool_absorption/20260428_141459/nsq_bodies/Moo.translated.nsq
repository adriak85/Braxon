NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "our $VERSION = '2.005005';"
NSQ_SOURCE_LINE 00000030 "$VERSION =~ tr/_//d;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "require Moo::sification;"
NSQ_SOURCE_LINE 00000033 "Moo::sification->import;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "our %MAKERS;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub import {"
NSQ_SOURCE_LINE 00000038 "  my $target = caller;"
NSQ_SOURCE_LINE 00000039 "  my $class = shift;"
NSQ_SOURCE_LINE 00000040 "  if ($INC{'Role/Tiny.pm'} and Role::Tiny->is_role($target)) {"
NSQ_SOURCE_LINE 00000041 "    croak \"Cannot import Moo into a role\";"
NSQ_SOURCE_LINE 00000042 "  }"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "  _set_loaded(caller);"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "  strict->import;"
NSQ_SOURCE_LINE 00000047 "  warnings->import;"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "  $class->_install_subs($target, @_);"
NSQ_SOURCE_LINE 00000050 "  $class->make_class($target);"
NSQ_SOURCE_LINE 00000051 "  return;"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub make_class {"
NSQ_SOURCE_LINE 00000055 "  my ($me, $target) = @_;"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "  my $makers = $MAKERS{$target} ||= {};"
NSQ_SOURCE_LINE 00000058 "  return $target if $makers->{is_class};"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "  my $stash = _getstash($target);"
NSQ_SOURCE_LINE 00000061 "  $makers->{non_methods} = {"
NSQ_SOURCE_LINE 00000062 "    map +($_ => \\&{\"${target}::${_}\"}),"
NSQ_SOURCE_LINE 00000063 "    grep exists &{\"${target}::${_}\"},"
NSQ_SOURCE_LINE 00000064 "    grep !/::\\z/ && !/\\A\\(/,"
NSQ_SOURCE_LINE 00000065 "    keys %$stash"
NSQ_SOURCE_LINE 00000066 "  };"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "  $makers->{is_class} = 1;"
NSQ_SOURCE_LINE 00000069 "  {"
NSQ_SOURCE_LINE 00000070 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000071 "    @{\"${target}::ISA\"} = do {"
NSQ_SOURCE_LINE 00000072 "      require Moo::Object; ('Moo::Object');"
NSQ_SOURCE_LINE 00000073 "    } unless @{\"${target}::ISA\"};"
NSQ_SOURCE_LINE 00000074 "  }"
NSQ_SOURCE_LINE 00000075 "  if ($INC{'Moo/HandleMoose.pm'} && !$Moo::sification::disabled) {"
NSQ_SOURCE_LINE 00000076 "    Moo::HandleMoose::inject_fake_metaclass_for($target);"
NSQ_SOURCE_LINE 00000077 "  }"
NSQ_SOURCE_LINE 00000078 "  return $target;"
NSQ_SOURCE_LINE 00000079 "}"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "sub is_class {"
NSQ_SOURCE_LINE 00000082 "  my ($me, $class) = @_;"
NSQ_SOURCE_LINE 00000083 "  return $MAKERS{$class} && $MAKERS{$class}{is_class};"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub _install_subs {"
NSQ_SOURCE_LINE 00000087 "  my ($me, $target) = @_;"
NSQ_SOURCE_LINE 00000088 "  my %install = $me->_gen_subs($target);"
NSQ_SOURCE_LINE 00000089 "  _install_tracked $target => $_ => $install{$_}"
NSQ_SOURCE_LINE 00000090 "    for sort keys %install;"
NSQ_SOURCE_LINE 00000091 "  return;"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "sub _gen_subs {"
NSQ_SOURCE_LINE 00000095 "  my ($me, $target) = @_;"
NSQ_SOURCE_LINE 00000096 "  return ("
NSQ_SOURCE_LINE 00000097 "    extends => sub {"
NSQ_SOURCE_LINE 00000098 "      $me->_set_superclasses($target, @_);"
NSQ_SOURCE_LINE 00000099 "      $me->_maybe_reset_handlemoose($target);"
NSQ_SOURCE_LINE 00000100 "      return;"
NSQ_SOURCE_LINE 00000101 "    },"
NSQ_SOURCE_LINE 00000102 "    with => sub {"
NSQ_SOURCE_LINE 00000103 "      require Moo::Role;"
NSQ_SOURCE_LINE 00000104 "      Moo::Role->apply_roles_to_package($target, @_);"
NSQ_SOURCE_LINE 00000105 "      $me->_maybe_reset_handlemoose($target);"
NSQ_SOURCE_LINE 00000106 "    },"
NSQ_SOURCE_LINE 00000107 "    has => sub {"
NSQ_SOURCE_LINE 00000108 "      my $name_proto = shift;"
NSQ_SOURCE_LINE 00000109 "      my @name_proto = ref $name_proto eq 'ARRAY' ? @$name_proto : $name_proto;"
NSQ_SOURCE_LINE 00000110 "      if (@_ % 2 != 0) {"
NSQ_SOURCE_LINE 00000111 "        croak \"Invalid options for \" . join(', ', map \"'$_'\", @name_proto)"
NSQ_SOURCE_LINE 00000112 "          . \" attribute(s): even number of arguments expected, got \" . scalar @_;"
NSQ_SOURCE_LINE 00000113 "      }"
NSQ_SOURCE_LINE 00000114 "      my %spec = @_;"
NSQ_SOURCE_LINE 00000115 "      foreach my $name (@name_proto) {"
NSQ_SOURCE_LINE 00000116 "        # Note that when multiple attributes specified, each attribute"
NSQ_SOURCE_LINE 00000117 "        # needs a separate \\%specs hashref"
NSQ_SOURCE_LINE 00000118 "        my $spec_ref = @name_proto > 1 ? +{%spec} : \\%spec;"
NSQ_SOURCE_LINE 00000119 "        $me->_constructor_maker_for($target)"
NSQ_SOURCE_LINE 00000120 "              ->register_attribute_specs($name, $spec_ref);"
NSQ_SOURCE_LINE 00000121 "        $me->_accessor_maker_for($target)"
NSQ_SOURCE_LINE 00000122 "              ->generate_method($target, $name, $spec_ref);"
NSQ_SOURCE_LINE 00000123 "        $me->_maybe_reset_handlemoose($target);"
NSQ_SOURCE_LINE 00000124 "      }"
NSQ_SOURCE_LINE 00000125 "      return;"
NSQ_SOURCE_LINE 00000126 "    },"
NSQ_SOURCE_LINE 00000127 "    (map {"
NSQ_SOURCE_LINE 00000128 "      my $type = $_;"
NSQ_SOURCE_LINE 00000129 "      ("
NSQ_SOURCE_LINE 00000130 "        $type => sub {"
NSQ_SOURCE_LINE 00000131 "          _install_modifier($target, $type, @_);"
NSQ_SOURCE_LINE 00000132 "          return;"
NSQ_SOURCE_LINE 00000133 "        },"
NSQ_SOURCE_LINE 00000134 "      )"
NSQ_SOURCE_LINE 00000135 "    } qw(before after around)),"
NSQ_SOURCE_LINE 00000136 "  );"
NSQ_SOURCE_LINE 00000137 "}"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "sub unimport {"
NSQ_SOURCE_LINE 00000140 "  my $target = caller;"
NSQ_SOURCE_LINE 00000141 "  _unimport_coderefs($target);"
NSQ_SOURCE_LINE 00000142 "}"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "sub _set_superclasses {"
NSQ_SOURCE_LINE 00000145 "  my $class = shift;"
NSQ_SOURCE_LINE 00000146 "  my $target = shift;"
NSQ_SOURCE_LINE 00000147 "  foreach my $superclass (@_) {"
NSQ_SOURCE_LINE 00000148 "    _load_module($superclass);"
NSQ_SOURCE_LINE 00000149 "    if ($INC{'Role/Tiny.pm'} && Role::Tiny->is_role($superclass)) {"
NSQ_SOURCE_LINE 00000150 "      croak \"Can't extend role '$superclass'\";"
NSQ_SOURCE_LINE 00000151 "    }"
NSQ_SOURCE_LINE 00000152 "  }"
NSQ_SOURCE_LINE 00000153 "  @{*{_getglob(\"${target}::ISA\")}} = @_;"
NSQ_SOURCE_LINE 00000154 "  if (my $old = delete $Moo::MAKERS{$target}{constructor}) {"
NSQ_SOURCE_LINE 00000155 "    $old->assert_constructor;"
NSQ_SOURCE_LINE 00000156 "    delete _getstash($target)->{new};"
NSQ_SOURCE_LINE 00000157 "    Moo->_constructor_maker_for($target)"
NSQ_SOURCE_LINE 00000158 "       ->register_attribute_specs(%{$old->all_attribute_specs});"
NSQ_SOURCE_LINE 00000159 "  }"
NSQ_SOURCE_LINE 00000160 "  elsif (!$target->isa('Moo::Object')) {"
NSQ_SOURCE_LINE 00000161 "    Moo->_constructor_maker_for($target);"
NSQ_SOURCE_LINE 00000162 "  }"
NSQ_SOURCE_LINE 00000163 "  $Moo::HandleMoose::MOUSE{$target} = ["
NSQ_SOURCE_LINE 00000164 "    grep defined, map Mouse::Util::find_meta($_), @_"
NSQ_SOURCE_LINE 00000165 "  ] if Mouse::Util->can('find_meta');"
NSQ_SOURCE_LINE 00000166 "}"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "sub _maybe_reset_handlemoose {"
NSQ_SOURCE_LINE 00000169 "  my ($class, $target) = @_;"
NSQ_SOURCE_LINE 00000170 "  if ($INC{'Moo/HandleMoose.pm'} && !$Moo::sification::disabled) {"
NSQ_SOURCE_LINE 00000171 "    Moo::HandleMoose::maybe_reinject_fake_metaclass_for($target);"
NSQ_SOURCE_LINE 00000172 "  }"
NSQ_SOURCE_LINE 00000173 "}"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "sub _accessor_maker_for {"
NSQ_SOURCE_LINE 00000176 "  my ($class, $target) = @_;"
NSQ_SOURCE_LINE 00000177 "  return unless $MAKERS{$target};"
NSQ_SOURCE_LINE 00000178 "  $MAKERS{$target}{accessor} ||= do {"
NSQ_SOURCE_LINE 00000179 "    my $maker_class = do {"
NSQ_SOURCE_LINE 00000180 "      no strict 'refs';"
NSQ_SOURCE_LINE 00000181 "      if (my $m = do {"
NSQ_SOURCE_LINE 00000182 "        my @isa = @{_linear_isa($target)};"
NSQ_SOURCE_LINE 00000183 "        shift @isa;"
NSQ_SOURCE_LINE 00000184 "        if (my ($parent_new) = grep +(defined &{$_.'::new'}), @isa) {"
NSQ_SOURCE_LINE 00000185 "          $MAKERS{$parent_new} && $MAKERS{$parent_new}{accessor};"
NSQ_SOURCE_LINE 00000186 "        }"
NSQ_SOURCE_LINE 00000187 "        else {"
NSQ_SOURCE_LINE 00000188 "          undef;"
NSQ_SOURCE_LINE 00000189 "        }"
NSQ_SOURCE_LINE 00000190 "      }) {"
NSQ_SOURCE_LINE 00000191 "        ref($m);"
NSQ_SOURCE_LINE 00000192 "      } else {"
NSQ_SOURCE_LINE 00000193 "        require Method::Generate::Accessor;"
NSQ_SOURCE_LINE 00000194 "        'Method::Generate::Accessor'"
NSQ_SOURCE_LINE 00000195 "      }"
NSQ_SOURCE_LINE 00000196 "    };"
NSQ_SOURCE_LINE 00000197 "    $maker_class->new;"
NSQ_SOURCE_LINE 00000198 "  }"
NSQ_SOURCE_LINE 00000199 "}"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "sub _constructor_maker_for {"
NSQ_SOURCE_LINE 00000202 "  my ($class, $target) = @_;"
NSQ_SOURCE_LINE 00000203 "  return unless $MAKERS{$target};"
NSQ_SOURCE_LINE 00000204 "  $MAKERS{$target}{constructor} ||= do {"
NSQ_SOURCE_LINE 00000205 "    require Method::Generate::Constructor;"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "    my %construct_opts = ("
NSQ_SOURCE_LINE 00000208 "      package => $target,"
NSQ_SOURCE_LINE 00000209 "      accessor_generator => $class->_accessor_maker_for($target),"
NSQ_SOURCE_LINE 00000210 "      subconstructor_handler => ("
NSQ_SOURCE_LINE 00000211 "        '      if ($Moo::MAKERS{$class}) {'.\"\\n\""
NSQ_SOURCE_LINE 00000212 "        .'        if ($Moo::MAKERS{$class}{constructor}) {'.\"\\n\""
NSQ_SOURCE_LINE 00000213 "        .'          package '.$target.';'.\"\\n\""
NSQ_SOURCE_LINE 00000214 "        .'          return $invoker->SUPER::new(@_);'.\"\\n\""
NSQ_SOURCE_LINE 00000215 "        .'        }'.\"\\n\""
NSQ_SOURCE_LINE 00000216 "        .'        '.$class.'->_constructor_maker_for($class);'.\"\\n\""
NSQ_SOURCE_LINE 00000217 "        .'        return $invoker->new(@_)'.\";\\n\""
NSQ_SOURCE_LINE 00000218 "        .'      } elsif ($INC{\"Moose.pm\"} and my $meta = Class::MOP::get_metaclass_by_name($class)) {'.\"\\n\""
NSQ_SOURCE_LINE 00000219 "        .'        return $meta->new_object('.\"\\n\""
NSQ_SOURCE_LINE 00000220 "        .'          $class->can(\"BUILDARGS\") ? $class->BUILDARGS(@_)'.\"\\n\""
NSQ_SOURCE_LINE 00000221 "        .'                      : $class->Moo::Object::BUILDARGS(@_)'.\"\\n\""
NSQ_SOURCE_LINE 00000222 "        .'        );'.\"\\n\""
NSQ_SOURCE_LINE 00000223 "        .'      }'.\"\\n\""
NSQ_SOURCE_LINE 00000224 "      ),"
NSQ_SOURCE_LINE 00000225 "    );"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    my $con;"
NSQ_SOURCE_LINE 00000228 "    my @isa = @{_linear_isa($target)};"
NSQ_SOURCE_LINE 00000229 "    shift @isa;"
NSQ_SOURCE_LINE 00000230 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000231 "    if (my ($parent_new) = grep +(defined &{$_.'::new'}), @isa) {"
NSQ_SOURCE_LINE 00000232 "      if ($parent_new eq 'Moo::Object') {"
NSQ_SOURCE_LINE 00000233 "        # no special constructor needed"
NSQ_SOURCE_LINE 00000234 "      }"
NSQ_SOURCE_LINE 00000235 "      elsif (my $makers = $MAKERS{$parent_new}) {"
NSQ_SOURCE_LINE 00000236 "        $con = $makers->{constructor};"
NSQ_SOURCE_LINE 00000237 "        $construct_opts{construction_string} = $con->construction_string"
NSQ_SOURCE_LINE 00000238 "          if $con;"
NSQ_SOURCE_LINE 00000239 "      }"
NSQ_SOURCE_LINE 00000240 "      elsif ($parent_new->can('BUILDALL')) {"
NSQ_SOURCE_LINE 00000241 "        $construct_opts{construction_builder} = sub {"
NSQ_SOURCE_LINE 00000242 "          my $inv = $target->can('BUILDARGS') ? '' : 'Moo::Object::';"
NSQ_SOURCE_LINE 00000243 "          'do {'"
NSQ_SOURCE_LINE 00000244 "          .'  my $args = $class->'.$inv.'BUILDARGS(@_);'"
NSQ_SOURCE_LINE 00000245 "          .'  $args->{__no_BUILD__} = 1;'"
NSQ_SOURCE_LINE 00000246 "          .'  $invoker->'.$target.'::SUPER::new($args);'"
NSQ_SOURCE_LINE 00000247 "          .'}'"
NSQ_SOURCE_LINE 00000248 "        };"
NSQ_SOURCE_LINE 00000249 "      }"
NSQ_SOURCE_LINE 00000250 "      else {"
NSQ_SOURCE_LINE 00000251 "        $construct_opts{construction_builder} = sub {"
NSQ_SOURCE_LINE 00000252 "          '$invoker->'.$target.'::SUPER::new('"
NSQ_SOURCE_LINE 00000253 "            .($target->can('FOREIGNBUILDARGS') ?"
NSQ_SOURCE_LINE 00000254 "              '$class->FOREIGNBUILDARGS(@_)' : '@_')"
NSQ_SOURCE_LINE 00000255 "            .')'"
NSQ_SOURCE_LINE 00000256 "        };"
NSQ_SOURCE_LINE 00000257 "      }"
NSQ_SOURCE_LINE 00000258 "    }"
NSQ_SOURCE_LINE 00000259 "    ($con ? ref($con) : 'Method::Generate::Constructor')"
NSQ_SOURCE_LINE 00000260 "      ->new(%construct_opts)"
NSQ_SOURCE_LINE 00000261 "      ->install_delayed"
NSQ_SOURCE_LINE 00000262 "      ->register_attribute_specs(%{$con?$con->all_attribute_specs:{}})"
NSQ_SOURCE_LINE 00000263 "  }"
NSQ_SOURCE_LINE 00000264 "}"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "sub _concrete_methods_of {"
NSQ_SOURCE_LINE 00000267 "  my ($me, $class) = @_;"
NSQ_SOURCE_LINE 00000268 "  my $makers = $MAKERS{$class};"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "  my $non_methods = $makers->{non_methods} || {};"
NSQ_SOURCE_LINE 00000271 "  my $stash = _getstash($class);"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "  my $subs = {"
NSQ_SOURCE_LINE 00000274 "    map {;"
NSQ_SOURCE_LINE 00000275 "      no strict 'refs';"
NSQ_SOURCE_LINE 00000276 "      ${\"${class}::${_}\"} = ${\"${class}::${_}\"};"
NSQ_SOURCE_LINE 00000277 "      ($_ => \\&{\"${class}::${_}\"});"
NSQ_SOURCE_LINE 00000278 "    }"
NSQ_SOURCE_LINE 00000279 "    grep exists &{\"${class}::${_}\"},"
NSQ_SOURCE_LINE 00000280 "    grep !/::\\z/,"
NSQ_SOURCE_LINE 00000281 "    keys %$stash"
NSQ_SOURCE_LINE 00000282 "  };"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "  my %tracked = map +($_ => 1), _check_tracked($class, [ keys %$subs ]);"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "  return {"
NSQ_SOURCE_LINE 00000287 "    map +($_ => \\&{\"${class}::${_}\"}),"
NSQ_SOURCE_LINE 00000288 "    grep !($non_methods->{$_} && $non_methods->{$_} == $subs->{$_}),"
NSQ_SOURCE_LINE 00000289 "    grep !exists $tracked{$_},"
NSQ_SOURCE_LINE 00000290 "    keys %$subs"
NSQ_SOURCE_LINE 00000291 "  };"
NSQ_SOURCE_LINE 00000292 "}"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "1;"
NSQ_SOURCE_LINE 00000295 "__END__"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=pod"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=encoding utf-8"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=head1 NAME"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "Moo - Minimalist Object Orientation (with Moose compatibility)"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "  package Cat::Food;"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "  use Moo;"
NSQ_SOURCE_LINE 00000310 "  use strictures 2;"
NSQ_SOURCE_LINE 00000311 "  use namespace::clean;"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "  sub feed_lion {"
NSQ_SOURCE_LINE 00000314 "    my $self = shift;"
NSQ_SOURCE_LINE 00000315 "    my $amount = shift || 1;"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "    $self->pounds( $self->pounds - $amount );"
NSQ_SOURCE_LINE 00000318 "  }"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "  has taste => ("
NSQ_SOURCE_LINE 00000321 "    is => 'ro',"
NSQ_SOURCE_LINE 00000322 "  );"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "  has brand => ("
NSQ_SOURCE_LINE 00000325 "    is  => 'ro',"
NSQ_SOURCE_LINE 00000326 "    isa => sub {"
NSQ_SOURCE_LINE 00000327 "      die \"Only SWEET-TREATZ supported!\" unless $_[0] eq 'SWEET-TREATZ'"
NSQ_SOURCE_LINE 00000328 "    },"
NSQ_SOURCE_LINE 00000329 "  );"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "  has pounds => ("
NSQ_SOURCE_LINE 00000332 "    is  => 'rw',"
NSQ_SOURCE_LINE 00000333 "    isa => sub { die \"$_[0] is too much cat food!\" unless $_[0] < 15 },"
NSQ_SOURCE_LINE 00000334 "  );"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "  1;"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "And elsewhere:"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "  my $full = Cat::Food->new("
NSQ_SOURCE_LINE 00000341 "      taste  => 'DELICIOUS.',"
NSQ_SOURCE_LINE 00000342 "      brand  => 'SWEET-TREATZ',"
NSQ_SOURCE_LINE 00000343 "      pounds => 10,"
NSQ_SOURCE_LINE 00000344 "  );"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "  $full->feed_lion;"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "  say $full->pounds;"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "C<Moo> is an extremely light-weight Object Orientation system. It allows one to"
NSQ_SOURCE_LINE 00000353 "concisely define objects and roles with a convenient syntax that avoids the"
NSQ_SOURCE_LINE 00000354 "details of Perl's object system.  C<Moo> contains a subset of L<Moose> and is"
NSQ_SOURCE_LINE 00000355 "optimised for rapid startup."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "C<Moo> avoids depending on any XS modules to allow for simple deployments.  The"
NSQ_SOURCE_LINE 00000358 "name C<Moo> is based on the idea that it provides almost -- but not quite --"
NSQ_SOURCE_LINE 00000359 "two thirds of L<Moose>.  As such, the L<Moose::Manual> can serve as an effective"
NSQ_SOURCE_LINE 00000360 "guide to C<Moo> aside from the MOP and Types sections."
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "Unlike L<Mouse> this module does not aim at full compatibility with"
NSQ_SOURCE_LINE 00000363 "L<Moose>'s surface syntax, preferring instead to provide full interoperability"
NSQ_SOURCE_LINE 00000364 "via the metaclass inflation capabilities described in L</MOO AND MOOSE>."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "For a full list of the minor differences between L<Moose> and L<Moo>'s surface"
NSQ_SOURCE_LINE 00000367 "syntax, see L</INCOMPATIBILITIES WITH MOOSE>."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=head1 WHY MOO EXISTS"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "If you want a full object system with a rich Metaprotocol, L<Moose> is"
NSQ_SOURCE_LINE 00000372 "already wonderful."
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "But if you don't want to use L<Moose>, you may not want \"less metaprotocol\""
NSQ_SOURCE_LINE 00000375 "like L<Mouse> offers, but you probably want \"no metaprotocol\", which is what"
NSQ_SOURCE_LINE 00000376 "Moo provides. C<Moo> is ideal for some situations where deployment or startup"
NSQ_SOURCE_LINE 00000377 "time precludes using L<Moose> and L<Mouse>:"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=over 2"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=item * A command line or CGI script where fast startup is essential"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "=item * code designed to be deployed as a single file via L<App::FatPacker>"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=item * A CPAN module that may be used by others in the above situations"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "=back"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "C<Moo> maintains transparent compatibility with L<Moose> so if you install and"
NSQ_SOURCE_LINE 00000390 "load L<Moose> you can use Moo classes and roles in L<Moose> code without"
NSQ_SOURCE_LINE 00000391 "modification."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "Moo -- Minimal Object Orientation -- aims to make it smooth to upgrade to"
NSQ_SOURCE_LINE 00000394 "L<Moose> when you need more than the minimal features offered by Moo."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "=head1 MOO AND MOOSE"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "If L<Moo> detects L<Moose> being loaded, it will automatically register"
NSQ_SOURCE_LINE 00000399 "metaclasses for your L<Moo> and L<Moo::Role> packages, so you should be able"
NSQ_SOURCE_LINE 00000400 "to use them in L<Moose> code without modification."
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "L<Moo> will also create L<Moose type constraints|Moose::Manual::Types> for"
NSQ_SOURCE_LINE 00000403 "L<Moo> classes and roles, so that in Moose classes C<< isa => 'MyMooClass' >>"
NSQ_SOURCE_LINE 00000404 "and C<< isa => 'MyMooRole' >> work the same as for L<Moose> classes and roles."
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "Extending a L<Moose> class or consuming a L<Moose::Role> will also work."
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "Extending a L<Mouse> class or consuming a L<Mouse::Role> will also work. But"
NSQ_SOURCE_LINE 00000409 "note that we don't provide L<Mouse> metaclasses or metaroles so the other way"
NSQ_SOURCE_LINE 00000410 "around doesn't work. This feature exists for L<Any::Moose> users porting to"
NSQ_SOURCE_LINE 00000411 "L<Moo>; enabling L<Mouse> users to use L<Moo> classes is not a priority for us."
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "This means that there is no need for anything like L<Any::Moose> for Moo"
NSQ_SOURCE_LINE 00000414 "code - Moo and Moose code should simply interoperate without problem. To"
NSQ_SOURCE_LINE 00000415 "handle L<Mouse> code, you'll likely need an empty Moo role or class consuming"
NSQ_SOURCE_LINE 00000416 "or extending the L<Mouse> stuff since it doesn't register true L<Moose>"
NSQ_SOURCE_LINE 00000417 "metaclasses like L<Moo> does."
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "If you need to disable the metaclass creation, add:"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "  no Moo::sification;"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "to your code before Moose is loaded, but bear in mind that this switch is"
NSQ_SOURCE_LINE 00000424 "global and turns the mechanism off entirely so don't put this in library code."
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=head1 MOO AND CLASS::XSACCESSOR"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "If a new enough version of L<Class::XSAccessor> is available, it will be used"
NSQ_SOURCE_LINE 00000429 "to generate simple accessors, readers, and writers for better performance."
NSQ_SOURCE_LINE 00000430 "Simple accessors are those without lazy defaults, type checks/coercions, or"
NSQ_SOURCE_LINE 00000431 "triggers.  Simple readers are those without lazy defaults. Readers and writers"
NSQ_SOURCE_LINE 00000432 "generated by L<Class::XSAccessor> will behave slightly differently: they will"
NSQ_SOURCE_LINE 00000433 "reject attempts to call them with the incorrect number of parameters."
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "=head1 MOO VERSUS ANY::MOOSE"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "L<Any::Moose> will load L<Mouse> normally, and L<Moose> in a program using"
NSQ_SOURCE_LINE 00000438 "L<Moose> - which theoretically allows you to get the startup time of L<Mouse>"
NSQ_SOURCE_LINE 00000439 "without disadvantaging L<Moose> users."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "Sadly, this doesn't entirely work, since the selection is load order dependent"
NSQ_SOURCE_LINE 00000442 "- L<Moo>'s metaclass inflation system explained above in L</MOO AND MOOSE> is"
NSQ_SOURCE_LINE 00000443 "significantly more reliable."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "So if you want to write a CPAN module that loads fast or has only pure perl"
NSQ_SOURCE_LINE 00000446 "dependencies but is also fully usable by L<Moose> users, you should be using"
NSQ_SOURCE_LINE 00000447 "L<Moo>."
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "For a full explanation, see the article"
NSQ_SOURCE_LINE 00000450 "L<https://shadow.cat/blog/matt-s-trout/moo-versus-any-moose> which explains"
NSQ_SOURCE_LINE 00000451 "the differing strategies in more detail and provides a direct example of"
NSQ_SOURCE_LINE 00000452 "where L<Moo> succeeds and L<Any::Moose> fails."
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "=head1 PUBLIC METHODS"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "Moo provides several methods to any class using it."
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "=head2 new"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "  Foo::Bar->new( attr1 => 3 );"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "or"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "  Foo::Bar->new({ attr1 => 3 });"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "The constructor for the class.  By default it will accept attributes either as a"
NSQ_SOURCE_LINE 00000467 "hashref, or a list of key value pairs.  This can be customized with the"
NSQ_SOURCE_LINE 00000468 "L</BUILDARGS> method."
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "=head2 does"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "  if ($foo->does('Some::Role1')) {"
NSQ_SOURCE_LINE 00000473 "    ..."
NSQ_SOURCE_LINE 00000474 "  }"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "Returns true if the object composes in the passed role."
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "=head2 DOES"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "  if ($foo->DOES('Some::Role1') || $foo->DOES('Some::Class1')) {"
NSQ_SOURCE_LINE 00000481 "    ..."
NSQ_SOURCE_LINE 00000482 "  }"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "Similar to L</does>, but will also return true for both composed roles and"
NSQ_SOURCE_LINE 00000485 "superclasses."
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=head2 meta"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "  my $meta = Foo::Bar->meta;"
NSQ_SOURCE_LINE 00000490 "  my @methods = $meta->get_method_list;"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "Returns an object that will behave as if it is a"
NSQ_SOURCE_LINE 00000493 "L<Moose metaclass|Moose::Meta::Class> object for the class. If you call"
NSQ_SOURCE_LINE 00000494 "anything other than C<make_immutable> on it, the object will be transparently"
NSQ_SOURCE_LINE 00000495 "upgraded to a genuine L<Moose::Meta::Class> instance, loading Moose in the"
NSQ_SOURCE_LINE 00000496 "process if required. C<make_immutable> itself is a no-op, since we generate"
NSQ_SOURCE_LINE 00000497 "metaclasses that are already immutable, and users converting from Moose had"
NSQ_SOURCE_LINE 00000498 "an unfortunate tendency to accidentally load Moose by calling it."
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "=head1 LIFECYCLE METHODS"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "There are several methods that you can define in your class to control"
NSQ_SOURCE_LINE 00000503 "construction and destruction of objects.  They should be used rather than trying"
NSQ_SOURCE_LINE 00000504 "to modify C<new> or C<DESTROY> yourself."
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "=head2 BUILDARGS"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "  around BUILDARGS => sub {"
NSQ_SOURCE_LINE 00000509 "    my ( $orig, $class, @args ) = @_;"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "    return { attr1 => $args[0] }"
NSQ_SOURCE_LINE 00000512 "      if @args == 1 && !ref $args[0];"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "    return $class->$orig(@args);"
NSQ_SOURCE_LINE 00000515 "  };"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "  Foo::Bar->new( 3 );"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "This class method is used to transform the arguments to C<new> into a hash"
NSQ_SOURCE_LINE 00000520 "reference of attribute values."
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "The default implementation accepts a hash or hash reference of named parameters."
NSQ_SOURCE_LINE 00000523 "If it receives a single argument that isn't a hash reference it will throw an"
NSQ_SOURCE_LINE 00000524 "error."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "You can override this method in your class to handle other types of options"
NSQ_SOURCE_LINE 00000527 "passed to the constructor."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "This method should always return a hash reference of named options."
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "=head2 FOREIGNBUILDARGS"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "  sub FOREIGNBUILDARGS {"
NSQ_SOURCE_LINE 00000534 "    my ( $class, $options ) = @_;"
NSQ_SOURCE_LINE 00000535 "    return $options->{foo};"
NSQ_SOURCE_LINE 00000536 "  }"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "If you are inheriting from a non-Moo class, the arguments passed to the parent"
NSQ_SOURCE_LINE 00000539 "class constructor can be manipulated by defining a C<FOREIGNBUILDARGS> method."
NSQ_SOURCE_LINE 00000540 "It will receive the same arguments as L</BUILDARGS>, and should return a list"
NSQ_SOURCE_LINE 00000541 "of arguments to pass to the parent class constructor."
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "=head2 BUILD"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "  sub BUILD {"
NSQ_SOURCE_LINE 00000546 "    my ($self, $args) = @_;"
NSQ_SOURCE_LINE 00000547 "    die \"foo and bar cannot be used at the same time\""
NSQ_SOURCE_LINE 00000548 "      if exists $args->{foo} && exists $args->{bar};"
NSQ_SOURCE_LINE 00000549 "  }"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "On object creation, any C<BUILD> methods in the class's inheritance hierarchy"
NSQ_SOURCE_LINE 00000552 "will be called on the object and given the results of L</BUILDARGS>.  They each"
NSQ_SOURCE_LINE 00000553 "will be called in order from the parent classes down to the child, and thus"
NSQ_SOURCE_LINE 00000554 "should not themselves call the parent's method.  Typically this is used for"
NSQ_SOURCE_LINE 00000555 "object validation or possibly logging."
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "=head2 DEMOLISH"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "  sub DEMOLISH {"
NSQ_SOURCE_LINE 00000560 "    my ($self, $in_global_destruction) = @_;"
NSQ_SOURCE_LINE 00000561 "    ..."
NSQ_SOURCE_LINE 00000562 "  }"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "When an object is destroyed, any C<DEMOLISH> methods in the inheritance"
NSQ_SOURCE_LINE 00000565 "hierarchy will be called on the object.  They are given boolean to inform them"
NSQ_SOURCE_LINE 00000566 "if global destruction is in progress, and are called from the child class upwards"
NSQ_SOURCE_LINE 00000567 "to the parent.  This is similar to L</BUILD> methods but in the opposite order."
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "Note that this is implemented by a C<DESTROY> method, which is only created on"
NSQ_SOURCE_LINE 00000570 "on the first construction of an object of your class.  This saves on overhead for"
NSQ_SOURCE_LINE 00000571 "classes that are never instantiated or those without C<DEMOLISH> methods.  If you"
NSQ_SOURCE_LINE 00000572 "try to define your own C<DESTROY>, this will cause undefined results."
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "=head1 IMPORTED SUBROUTINES"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "=head2 extends"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "  extends 'Parent::Class';"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "Declares a base class. Multiple superclasses can be passed for multiple"
NSQ_SOURCE_LINE 00000581 "inheritance but please consider using L<roles|Moo::Role> instead.  The class"
NSQ_SOURCE_LINE 00000582 "will be loaded but no errors will be triggered if the class can't be found and"
NSQ_SOURCE_LINE 00000583 "there are already subs in the class."
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "Calling extends more than once will REPLACE your superclasses, not add to"
NSQ_SOURCE_LINE 00000586 "them like 'use base' would."
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "=head2 with"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "  with 'Some::Role1';"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "or"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "  with 'Some::Role1', 'Some::Role2';"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "Composes one or more L<Moo::Role> (or L<Role::Tiny>) roles into the current"
NSQ_SOURCE_LINE 00000597 "class.  An error will be raised if these roles cannot be composed because they"
NSQ_SOURCE_LINE 00000598 "have conflicting method definitions.  The roles will be loaded using the same"
NSQ_SOURCE_LINE 00000599 "mechanism as C<extends> uses."
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "=head2 has"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "  has attr => ("
NSQ_SOURCE_LINE 00000604 "    is => 'ro',"
NSQ_SOURCE_LINE 00000605 "  );"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "Declares an attribute for the class."
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "  package Foo;"
NSQ_SOURCE_LINE 00000610 "  use Moo;"
NSQ_SOURCE_LINE 00000611 "  has 'attr' => ("
NSQ_SOURCE_LINE 00000612 "    is => 'ro'"
NSQ_SOURCE_LINE 00000613 "  );"
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "  package Bar;"
NSQ_SOURCE_LINE 00000616 "  use Moo;"
NSQ_SOURCE_LINE 00000617 "  extends 'Foo';"
NSQ_SOURCE_LINE 00000618 "  has '+attr' => ("
NSQ_SOURCE_LINE 00000619 "    default => sub { \"blah\" },"
NSQ_SOURCE_LINE 00000620 "  );"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "Using the C<+> notation, it's possible to override an attribute."
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "  has [qw(attr1 attr2 attr3)] => ("
NSQ_SOURCE_LINE 00000625 "    is => 'ro',"
NSQ_SOURCE_LINE 00000626 "  );"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "Using an arrayref with multiple attribute names, it's possible to declare"
NSQ_SOURCE_LINE 00000629 "multiple attributes with the same options."
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "The options for C<has> are as follows:"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "=over 2"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "=item C<is>"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "B<required>, may be C<ro>, C<lazy>, C<rwp> or C<rw>."
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "C<ro> stands for \"read-only\" and generates an accessor that dies if you attempt"
NSQ_SOURCE_LINE 00000640 "to write to it - i.e.  a getter only - by defaulting C<reader> to the name of"
NSQ_SOURCE_LINE 00000641 "the attribute."
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "C<lazy> generates a reader like C<ro>, but also sets C<lazy> to 1 and"
NSQ_SOURCE_LINE 00000644 "C<builder> to C<_build_${attribute_name}> to allow on-demand generated"
NSQ_SOURCE_LINE 00000645 "attributes.  This feature was my attempt to fix my incompetence when"
NSQ_SOURCE_LINE 00000646 "originally designing C<lazy_build>, and is also implemented by"
NSQ_SOURCE_LINE 00000647 "L<MooseX::AttributeShortcuts>. There is, however, nothing to stop you"
NSQ_SOURCE_LINE 00000648 "using C<lazy> and C<builder> yourself with C<rwp> or C<rw> - it's just that"
NSQ_SOURCE_LINE 00000649 "this isn't generally a good idea so we don't provide a shortcut for it."
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "C<rwp> stands for \"read-write protected\" and generates a reader like C<ro>, but"
NSQ_SOURCE_LINE 00000652 "also sets C<writer> to C<_set_${attribute_name}> for attributes that are"
NSQ_SOURCE_LINE 00000653 "designed to be written from inside of the class, but read-only from outside."
NSQ_SOURCE_LINE 00000654 "This feature comes from L<MooseX::AttributeShortcuts>."
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "C<rw> stands for \"read-write\" and generates a normal getter/setter by"
NSQ_SOURCE_LINE 00000657 "defaulting the C<accessor> to the name of the attribute specified."
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "=item C<isa>"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "Takes a coderef which is used to validate the attribute.  Unlike L<Moose>, Moo"
NSQ_SOURCE_LINE 00000662 "does not include a basic type system, so instead of doing C<< isa => 'Num' >>,"
NSQ_SOURCE_LINE 00000663 "one should do"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "  use Scalar::Util qw(looks_like_number);"
NSQ_SOURCE_LINE 00000666 "  ..."
NSQ_SOURCE_LINE 00000667 "  isa => sub {"
NSQ_SOURCE_LINE 00000668 "    die \"$_[0] is not a number!\" unless looks_like_number $_[0]"
NSQ_SOURCE_LINE 00000669 "  },"
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "Note that the return value for C<isa> is discarded. Only if the sub dies does"
NSQ_SOURCE_LINE 00000672 "type validation fail."
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "L<Sub::Quote aware|/SUB QUOTE AWARE>"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "Since L<Moo> does B<not> run the C<isa> check before C<coerce> if a coercion"
NSQ_SOURCE_LINE 00000677 "subroutine has been supplied, C<isa> checks are not structural to your code"
NSQ_SOURCE_LINE 00000678 "and can, if desired, be omitted on non-debug builds (although if this results"
NSQ_SOURCE_LINE 00000679 "in an uncaught bug causing your program to break, the L<Moo> authors guarantee"
NSQ_SOURCE_LINE 00000680 "nothing except that you get to keep both halves)."
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "If you want L<Moose> compatible or L<MooseX::Types> style named types, look at"
NSQ_SOURCE_LINE 00000683 "L<Type::Tiny>."
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "To cause your C<isa> entries to be automatically mapped to named"
NSQ_SOURCE_LINE 00000686 "L<Moose::Meta::TypeConstraint> objects (rather than the default behaviour"
NSQ_SOURCE_LINE 00000687 "of creating an anonymous type), set:"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "  $Moo::HandleMoose::TYPE_MAP{$isa_coderef} = sub {"
NSQ_SOURCE_LINE 00000690 "    require MooseX::Types::Something;"
NSQ_SOURCE_LINE 00000691 "    return MooseX::Types::Something::TypeName();"
NSQ_SOURCE_LINE 00000692 "  };"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "Note that this example is purely illustrative; anything that returns a"
NSQ_SOURCE_LINE 00000695 "L<Moose::Meta::TypeConstraint> object or something similar enough to it to"
NSQ_SOURCE_LINE 00000696 "make L<Moose> happy is fine."
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "=item C<coerce>"
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "Takes a coderef which is meant to coerce the attribute.  The basic idea is to"
NSQ_SOURCE_LINE 00000701 "do something like the following:"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 " coerce => sub {"
NSQ_SOURCE_LINE 00000704 "   $_[0] % 2 ? $_[0] : $_[0] + 1"
NSQ_SOURCE_LINE 00000705 " },"
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "Note that L<Moo> will always execute your coercion: this is to permit"
NSQ_SOURCE_LINE 00000708 "C<isa> entries to be used purely for bug trapping, whereas coercions are"
NSQ_SOURCE_LINE 00000709 "always structural to your code. We do, however, apply any supplied C<isa>"
NSQ_SOURCE_LINE 00000710 "check after the coercion has run to ensure that it returned a valid value."
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "L<Sub::Quote aware|/SUB QUOTE AWARE>"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "If the C<isa> option is a blessed object providing a C<coerce> or"
NSQ_SOURCE_LINE 00000715 "C<coercion> method, then the C<coerce> option may be set to just C<1>."
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "=item C<handles>"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "Takes a string"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "  handles => 'RobotRole'"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "Where C<RobotRole> is a L<role|Moo::Role> that defines an interface which"
NSQ_SOURCE_LINE 00000724 "becomes the list of methods to handle."
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "Takes a list of methods"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "  handles => [ qw( one two ) ]"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "Takes a hashref"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "  handles => {"
NSQ_SOURCE_LINE 00000733 "    un => 'one',"
NSQ_SOURCE_LINE 00000734 "  }"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "=item C<trigger>"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "Takes a coderef which will get called any time the attribute is set. This"
NSQ_SOURCE_LINE 00000739 "includes the constructor, but not default or built values. The coderef will be"
NSQ_SOURCE_LINE 00000740 "invoked against the object with the new value as an argument."
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "If you set this to just C<1>, it generates a trigger which calls the"
NSQ_SOURCE_LINE 00000743 "C<_trigger_${attr_name}> method on C<$self>. This feature comes from"
NSQ_SOURCE_LINE 00000744 "L<MooseX::AttributeShortcuts>."
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "Note that Moose also passes the old value, if any; this feature is not yet"
NSQ_SOURCE_LINE 00000747 "supported."
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "L<Sub::Quote aware|/SUB QUOTE AWARE>"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "=item C<default>"
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "Takes a coderef which will get called with $self as its only argument to"
NSQ_SOURCE_LINE 00000754 "populate an attribute if no value for that attribute was supplied to the"
NSQ_SOURCE_LINE 00000755 "constructor. Alternatively, if the attribute is lazy, C<default> executes when"
NSQ_SOURCE_LINE 00000756 "the attribute is first retrieved if no value has yet been provided."
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "If a simple scalar is provided, it will be inlined as a string. Any non-code"
NSQ_SOURCE_LINE 00000759 "reference (hash, array) will result in an error - for that case instead use"
NSQ_SOURCE_LINE 00000760 "a code reference that returns the desired value."
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "Note that if your default is fired during new() there is no guarantee that"
NSQ_SOURCE_LINE 00000763 "other attributes have been populated yet so you should not rely on their"
NSQ_SOURCE_LINE 00000764 "existence."
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "L<Sub::Quote aware|/SUB QUOTE AWARE>"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "=item C<predicate>"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "Takes a method name which will return true if an attribute has a value."
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "If you set this to just C<1>, the predicate is automatically named"
NSQ_SOURCE_LINE 00000773 "C<has_${attr_name}> if your attribute's name does not start with an"
NSQ_SOURCE_LINE 00000774 "underscore, or C<_has_${attr_name_without_the_underscore}> if it does."
NSQ_SOURCE_LINE 00000775 "This feature comes from L<MooseX::AttributeShortcuts>."
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "=item C<builder>"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "Takes a method name which will be called to create the attribute - functions"
NSQ_SOURCE_LINE 00000780 "exactly like default except that instead of calling"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "  $default->($self);"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "Moo will call"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "  $self->$builder;"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "The following features come from L<MooseX::AttributeShortcuts>:"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "If you set this to just C<1>, the builder is automatically named"
NSQ_SOURCE_LINE 00000791 "C<_build_${attr_name}>."
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "If you set this to a coderef or code-convertible object, that variable will be"
NSQ_SOURCE_LINE 00000794 "installed under C<$class::_build_${attr_name}> and the builder set to the same"
NSQ_SOURCE_LINE 00000795 "name."
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "=item C<clearer>"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "Takes a method name which will clear the attribute."
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "If you set this to just C<1>, the clearer is automatically named"
NSQ_SOURCE_LINE 00000802 "C<clear_${attr_name}> if your attribute's name does not start with an"
NSQ_SOURCE_LINE 00000803 "underscore, or C<_clear_${attr_name_without_the_underscore}> if it does."
NSQ_SOURCE_LINE 00000804 "This feature comes from L<MooseX::AttributeShortcuts>."
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "B<NOTE:> If the attribute is C<lazy>, it will be regenerated from C<default> or"
NSQ_SOURCE_LINE 00000807 "C<builder> the next time it is accessed. If it is not lazy, it will be C<undef>."
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "=item C<lazy>"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "B<Boolean>.  Set this if you want values for the attribute to be grabbed"
NSQ_SOURCE_LINE 00000812 "lazily.  This is usually a good idea if you have a L</builder> which requires"
NSQ_SOURCE_LINE 00000813 "another attribute to be set."
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "=item C<required>"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "B<Boolean>.  Set this if the attribute must be passed on object instantiation."
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "=item C<reader>"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "The name of the method that returns the value of the attribute.  If you like"
NSQ_SOURCE_LINE 00000822 "Java style methods, you might set this to C<get_foo>"
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "=item C<writer>"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "The value of this attribute will be the name of the method to set the value of"
NSQ_SOURCE_LINE 00000827 "the attribute.  If you like Java style methods, you might set this to"
NSQ_SOURCE_LINE 00000828 "C<set_foo>."
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "=item C<weak_ref>"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "B<Boolean>.  Set this if you want the reference that the attribute contains to"
NSQ_SOURCE_LINE 00000833 "be weakened. Use this when circular references, which cause memory leaks, are"
NSQ_SOURCE_LINE 00000834 "possible."
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "=item C<init_arg>"
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "Takes the name of the key to look for at instantiation time of the object.  A"
NSQ_SOURCE_LINE 00000839 "common use of this is to make an underscored attribute have a non-underscored"
NSQ_SOURCE_LINE 00000840 "initialization name. C<undef> means that passing the value in on instantiation"
NSQ_SOURCE_LINE 00000841 "is ignored."
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "=item C<moosify>"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "Takes either a coderef or array of coderefs which is meant to transform the"
NSQ_SOURCE_LINE 00000846 "given attributes specifications if necessary when upgrading to a Moose role or"
NSQ_SOURCE_LINE 00000847 "class. You shouldn't need this by default, but is provided as a means of"
NSQ_SOURCE_LINE 00000848 "possible extensibility."
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "=back"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "=head2 before"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "  before foo => sub { ... };"
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "See L<< Class::Method::Modifiers/before method(s) => sub { ... }; >> for full"
NSQ_SOURCE_LINE 00000857 "documentation."
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "=head2 around"
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "  around foo => sub { ... };"
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "See L<< Class::Method::Modifiers/around method(s) => sub { ... }; >> for full"
NSQ_SOURCE_LINE 00000864 "documentation."
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "=head2 after"
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "  after foo => sub { ... };"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "See L<< Class::Method::Modifiers/after method(s) => sub { ... }; >> for full"
NSQ_SOURCE_LINE 00000871 "documentation."
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "=head1 SUB QUOTE AWARE"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "L<Sub::Quote/quote_sub> allows us to create coderefs that are \"inlineable,\""
NSQ_SOURCE_LINE 00000876 "giving us a handy, XS-free speed boost.  Any option that is L<Sub::Quote>"
NSQ_SOURCE_LINE 00000877 "aware can take advantage of this."
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 "To do this, you can write"
NSQ_SOURCE_LINE 00000880 ""
NSQ_SOURCE_LINE 00000881 "  use Sub::Quote;"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "  use Moo;"
NSQ_SOURCE_LINE 00000884 "  use namespace::clean;"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "  has foo => ("
NSQ_SOURCE_LINE 00000887 "    is => 'ro',"
NSQ_SOURCE_LINE 00000888 "    isa => quote_sub(q{ die \"Not <3\" unless $_[0] < 3 })"
NSQ_SOURCE_LINE 00000889 "  );"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "which will be inlined as"
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "  do {"
NSQ_SOURCE_LINE 00000894 "    local @_ = ($_[0]->{foo});"
NSQ_SOURCE_LINE 00000895 "    die \"Not <3\" unless $_[0] < 3;"
NSQ_SOURCE_LINE 00000896 "  }"
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "or to avoid localizing @_,"
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "  has foo => ("
NSQ_SOURCE_LINE 00000901 "    is => 'ro',"
NSQ_SOURCE_LINE 00000902 "    isa => quote_sub(q{ my ($val) = @_; die \"Not <3\" unless $val < 3 })"
NSQ_SOURCE_LINE 00000903 "  );"
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "which will be inlined as"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "  do {"
NSQ_SOURCE_LINE 00000908 "    my ($val) = ($_[0]->{foo});"
NSQ_SOURCE_LINE 00000909 "    die \"Not <3\" unless $val < 3;"
NSQ_SOURCE_LINE 00000910 "  }"
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "See L<Sub::Quote> for more information, including how to pass lexical"
NSQ_SOURCE_LINE 00000913 "captures that will also be compiled into the subroutine."
NSQ_SOURCE_LINE 00000914 ""
NSQ_SOURCE_LINE 00000915 "=head1 CLEANING UP IMPORTS"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "L<Moo> will not clean up imported subroutines for you; you will have"
NSQ_SOURCE_LINE 00000918 "to do that manually. The recommended way to do this is to declare your"
NSQ_SOURCE_LINE 00000919 "imports first, then C<use Moo>, then C<use namespace::clean>."
NSQ_SOURCE_LINE 00000920 "Anything imported before L<namespace::clean> will be scrubbed."
NSQ_SOURCE_LINE 00000921 "Anything imported or declared after will be still be available."
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "  package Record;"
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "  use Digest::MD5 qw(md5_hex);"
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "  use Moo;"
NSQ_SOURCE_LINE 00000928 "  use namespace::clean;"
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "  has name => (is => 'ro', required => 1);"
NSQ_SOURCE_LINE 00000931 "  has id => (is => 'lazy');"
NSQ_SOURCE_LINE 00000932 "  sub _build_id {"
NSQ_SOURCE_LINE 00000933 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000934 "    return md5_hex($self->name);"
NSQ_SOURCE_LINE 00000935 "  }"
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "  1;"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "For example if you were to import these subroutines after"
NSQ_SOURCE_LINE 00000940 "L<namespace::clean> like this"
NSQ_SOURCE_LINE 00000941 ""
NSQ_SOURCE_LINE 00000942 "  use namespace::clean;"
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "  use Digest::MD5 qw(md5_hex);"
NSQ_SOURCE_LINE 00000945 "  use Moo;"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "then any C<Record> C<$r> would have methods such as C<< $r->md5_hex() >>, "
NSQ_SOURCE_LINE 00000948 "C<< $r->has() >> and C<< $r->around() >> - almost certainly not what you"
NSQ_SOURCE_LINE 00000949 "intend!"
NSQ_SOURCE_LINE 00000950 ""
NSQ_SOURCE_LINE 00000951 "L<Moo::Role>s behave slightly differently.  Since their methods are"
NSQ_SOURCE_LINE 00000952 "composed into the consuming class, they can do a little more for you"
NSQ_SOURCE_LINE 00000953 "automatically.  As long as you declare your imports before calling"
NSQ_SOURCE_LINE 00000954 "C<use Moo::Role>, those imports and the ones L<Moo::Role> itself"
NSQ_SOURCE_LINE 00000955 "provides will not be composed into consuming classes so there's usually"
NSQ_SOURCE_LINE 00000956 "no need to use L<namespace::clean>."
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "B<On L<namespace::autoclean>:> Older versions of L<namespace::autoclean> would"
NSQ_SOURCE_LINE 00000959 "inflate Moo classes to full L<Moose> classes, losing the benefits of Moo.  If"
NSQ_SOURCE_LINE 00000960 "you want to use L<namespace::autoclean> with a Moo class, make sure you are"
NSQ_SOURCE_LINE 00000961 "using version 0.16 or newer."
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "=head1 INCOMPATIBILITIES WITH MOOSE"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "=head2 TYPES"
NSQ_SOURCE_LINE 00000966 ""
NSQ_SOURCE_LINE 00000967 "There is no built-in type system.  C<isa> is verified with a coderef; if you"
NSQ_SOURCE_LINE 00000968 "need complex types, L<Type::Tiny> can provide types, type libraries, and"
NSQ_SOURCE_LINE 00000969 "will work seamlessly with both L<Moo> and L<Moose>.  L<Type::Tiny> can be"
NSQ_SOURCE_LINE 00000970 "considered the successor to L<MooseX::Types> and provides a similar API, so"
NSQ_SOURCE_LINE 00000971 "that you can write"
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "  use Types::Standard qw(Int);"
NSQ_SOURCE_LINE 00000974 "  has days_to_live => (is => 'ro', isa => Int);"
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "=head2 API INCOMPATIBILITIES"
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 "C<initializer> is not supported in core since the author considers it to be a"
NSQ_SOURCE_LINE 00000979 "bad idea and Moose best practices recommend avoiding it. Meanwhile C<trigger> or"
NSQ_SOURCE_LINE 00000980 "C<coerce> are more likely to be able to fulfill your needs."
NSQ_SOURCE_LINE 00000981 ""
NSQ_SOURCE_LINE 00000982 "No support for C<super>, C<override>, C<inner>, or C<augment> - the author"
NSQ_SOURCE_LINE 00000983 "considers augment to be a bad idea, and override can be translated:"
NSQ_SOURCE_LINE 00000984 ""
NSQ_SOURCE_LINE 00000985 "  override foo => sub {"
NSQ_SOURCE_LINE 00000986 "    ..."
NSQ_SOURCE_LINE 00000987 "    super();"
NSQ_SOURCE_LINE 00000988 "    ..."
NSQ_SOURCE_LINE 00000989 "  };"
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "  around foo => sub {"
NSQ_SOURCE_LINE 00000992 "    my ($orig, $self) = (shift, shift);"
NSQ_SOURCE_LINE 00000993 "    ..."
NSQ_SOURCE_LINE 00000994 "    $self->$orig(@_);"
NSQ_SOURCE_LINE 00000995 "    ..."
NSQ_SOURCE_LINE 00000996 "  };"
NSQ_SOURCE_LINE 00000997 ""
NSQ_SOURCE_LINE 00000998 "The C<dump> method is not provided by default. The author suggests loading"
NSQ_SOURCE_LINE 00000999 "L<Devel::Dwarn> into C<main::> (via C<perl -MDevel::Dwarn ...> for example) and"
NSQ_SOURCE_LINE 00001000 "using C<< $obj->$::Dwarn() >> instead."
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "L</default> only supports coderefs and plain scalars, because passing a hash"
NSQ_SOURCE_LINE 00001003 "or array reference as a default is almost always incorrect since the value is"
NSQ_SOURCE_LINE 00001004 "then shared between all objects using that default."
NSQ_SOURCE_LINE 00001005 ""
NSQ_SOURCE_LINE 00001006 "C<lazy_build> is not supported; you are instead encouraged to use the"
NSQ_SOURCE_LINE 00001007 "C<< is => 'lazy' >> option supported by L<Moo> and"
NSQ_SOURCE_LINE 00001008 "L<MooseX::AttributeShortcuts>."
NSQ_SOURCE_LINE 00001009 ""
NSQ_SOURCE_LINE 00001010 "C<auto_deref> is not supported since the author considers it a bad idea and"
NSQ_SOURCE_LINE 00001011 "it has been considered best practice to avoid it for some time."
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "C<documentation> will show up in a L<Moose> metaclass created from your class"
NSQ_SOURCE_LINE 00001014 "but is otherwise ignored. Then again, L<Moose> ignores it as well, so this"
NSQ_SOURCE_LINE 00001015 "is arguably not an incompatibility."
NSQ_SOURCE_LINE 00001016 ""
NSQ_SOURCE_LINE 00001017 "Since C<coerce> does not require C<isa> to be defined but L<Moose> does"
NSQ_SOURCE_LINE 00001018 "require it, the metaclass inflation for coerce alone is a trifle insane"
NSQ_SOURCE_LINE 00001019 "and if you attempt to subtype the result will almost certainly break."
NSQ_SOURCE_LINE 00001020 ""
NSQ_SOURCE_LINE 00001021 "Handling of warnings: when you C<use Moo> we enable strict and warnings, in a"
NSQ_SOURCE_LINE 00001022 "similar way to Moose. The authors recommend the use of C<strictures>, which"
NSQ_SOURCE_LINE 00001023 "enables FATAL warnings, and several extra pragmas when used in development:"
NSQ_SOURCE_LINE 00001024 "L<indirect>, L<multidimensional>, and L<bareword::filehandles>."
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "Additionally, L<Moo> supports a set of attribute option shortcuts intended to"
NSQ_SOURCE_LINE 00001027 "reduce common boilerplate.  The set of shortcuts is the same as in the L<Moose>"
NSQ_SOURCE_LINE 00001028 "module L<MooseX::AttributeShortcuts> as of its version 0.009+.  So if you:"
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "  package MyClass;"
NSQ_SOURCE_LINE 00001031 "  use Moo;"
NSQ_SOURCE_LINE 00001032 "  use strictures 2;"
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "The nearest L<Moose> invocation would be:"
NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "  package MyClass;"
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "  use Moose;"
NSQ_SOURCE_LINE 00001039 "  use warnings FATAL => \"all\";"
NSQ_SOURCE_LINE 00001040 "  use MooseX::AttributeShortcuts;"
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "or, if you're inheriting from a non-Moose class,"
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 "  package MyClass;"
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "  use Moose;"
NSQ_SOURCE_LINE 00001047 "  use MooseX::NonMoose;"
NSQ_SOURCE_LINE 00001048 "  use warnings FATAL => \"all\";"
NSQ_SOURCE_LINE 00001049 "  use MooseX::AttributeShortcuts;"
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 "=head2 META OBJECT"
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "There is no meta object.  If you need this level of complexity you need"
NSQ_SOURCE_LINE 00001054 "L<Moose> - Moo is small because it explicitly does not provide a metaprotocol."
NSQ_SOURCE_LINE 00001055 "However, if you load L<Moose>, then"
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "  Class::MOP::class_of($moo_class_or_role)"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "will return an appropriate metaclass pre-populated by L<Moo>."
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "=head2 IMMUTABILITY"
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "Finally, Moose requires you to call"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "  __PACKAGE__->meta->make_immutable;"
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "at the end of your class to get an inlined (i.e. not horribly slow)"
NSQ_SOURCE_LINE 00001068 "constructor. Moo does it automatically the first time ->new is called"
NSQ_SOURCE_LINE 00001069 "on your class. (C<make_immutable> is a no-op in Moo to ease migration.)"
NSQ_SOURCE_LINE 00001070 ""
NSQ_SOURCE_LINE 00001071 "An extension L<MooX::late> exists to ease translating Moose packages"
NSQ_SOURCE_LINE 00001072 "to Moo by providing a more Moose-like interface."
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 "=head1 COMPATIBILITY WITH OLDER PERL VERSIONS"
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 "Moo is compatible with perl versions back to 5.6.  When running on older"
NSQ_SOURCE_LINE 00001077 "versions, additional prerequisites will be required.  If you are packaging a"
NSQ_SOURCE_LINE 00001078 "script with its dependencies, such as with L<App::FatPacker>, you will need to"
NSQ_SOURCE_LINE 00001079 "be certain that the extra prerequisites are included."
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "=over 4"
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "=item L<MRO::Compat>"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "Required on perl versions prior to 5.10.0."
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 "=item L<Devel::GlobalDestruction>"
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "Required on perl versions prior to 5.14.0."
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 "=back"
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "IRC: #moose on irc.perl.org"
NSQ_SOURCE_LINE 00001096 ""
NSQ_SOURCE_LINE 00001097 "=for :html"
NSQ_SOURCE_LINE 00001098 "L<(click for instant chatroom login)|https://chat.mibbit.com/#moose@irc.perl.org>"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "Bugtracker: L<https://rt.cpan.org/Public/Dist/Display.html?Name=Moo>"
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "Git repository: L<git://github.com/moose/Moo.git>"
NSQ_SOURCE_LINE 00001103 ""
