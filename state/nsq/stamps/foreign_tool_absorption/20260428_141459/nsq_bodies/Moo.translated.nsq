NSQ_SOURCE_LINE 00000001 "package Moo;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "no warnings 'once';"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Moo::_Utils qw("
NSQ_SOURCE_LINE 00000007 "  _check_tracked"
NSQ_SOURCE_LINE 00000008 "  _getglob"
NSQ_SOURCE_LINE 00000009 "  _getstash"
NSQ_SOURCE_LINE 00000010 "  _install_coderef"
NSQ_SOURCE_LINE 00000011 "  _install_modifier"
