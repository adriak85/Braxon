NSQ_SOURCE_LINE 00000020 "  our @CARP_NOT = qw("
NSQ_SOURCE_LINE 00000021 "    Method::Generate::Constructor"
NSQ_SOURCE_LINE 00000022 "    Method::Generate::Accessor"
NSQ_SOURCE_LINE 00000023 "    Moo::sification"
