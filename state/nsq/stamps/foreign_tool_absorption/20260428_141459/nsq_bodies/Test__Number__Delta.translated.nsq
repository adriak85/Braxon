BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "package Test::Number::Delta;"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: Compare the difference between numbers against a given tolerance"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '1.06';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use vars qw (@EXPORT @ISA);"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "# Required modules"
NSQ_SOURCE_LINE 00000012 "use Carp;"
NSQ_SOURCE_LINE 00000013 "use Test::Builder;"
NSQ_SOURCE_LINE 00000014 "use Exporter;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "@ISA    = qw( Exporter );"
NSQ_SOURCE_LINE 00000017 "@EXPORT = qw( delta_not_ok delta_ok delta_within delta_not_within );"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "#pod =head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000020 "#pod"
NSQ_SOURCE_LINE 00000021 "#pod   # Import test functions"
NSQ_SOURCE_LINE 00000022 "#pod   use Test::Number::Delta;"
NSQ_SOURCE_LINE 00000023 "#pod"
NSQ_SOURCE_LINE 00000024 "#pod   # Equality test with default tolerance"
NSQ_SOURCE_LINE 00000025 "#pod   delta_ok( 1e-5, 2e-5, 'values within 1e-6');"
NSQ_SOURCE_LINE 00000026 "#pod"
NSQ_SOURCE_LINE 00000027 "#pod   # Inequality test with default tolerance"
NSQ_SOURCE_LINE 00000028 "#pod   delta_not_ok( 1e-5, 2e-5, 'values not within 1e-6');"
NSQ_SOURCE_LINE 00000029 "#pod"
NSQ_SOURCE_LINE 00000030 "#pod   # Provide specific tolerance"
NSQ_SOURCE_LINE 00000031 "#pod   delta_within( 1e-3, 2e-3, 1e-4, 'values within 1e-4');"
NSQ_SOURCE_LINE 00000032 "#pod   delta_not_within( 1e-3, 2e-3, 1e-4, 'values not within 1e-4');"
NSQ_SOURCE_LINE 00000033 "#pod"
NSQ_SOURCE_LINE 00000034 "#pod   # Compare arrays or matrices"
NSQ_SOURCE_LINE 00000035 "#pod   @a = ( 3.14, 1.41 );"
NSQ_SOURCE_LINE 00000036 "#pod   @b = ( 3.15, 1.41 );"
NSQ_SOURCE_LINE 00000037 "#pod   delta_ok( \\@a, \\@b, 'compare @a and @b' );"
NSQ_SOURCE_LINE 00000038 "#pod"
NSQ_SOURCE_LINE 00000039 "#pod   # Set a different default tolerance"
NSQ_SOURCE_LINE 00000040 "#pod   use Test::Number::Delta within => 1e-5;"
NSQ_SOURCE_LINE 00000041 "#pod   delta_ok( 1.1e-5, 2e-5, 'values within 1e-5'); # ok"
NSQ_SOURCE_LINE 00000042 "#pod"
NSQ_SOURCE_LINE 00000043 "#pod   # Set a relative tolerance"
NSQ_SOURCE_LINE 00000044 "#pod   use Test::Number::Delta relative => 1e-3;"
NSQ_SOURCE_LINE 00000045 "#pod   delta_ok( 1.01, 1.0099, 'values within 1.01e-3');"
NSQ_SOURCE_LINE 00000046 "#pod"
NSQ_SOURCE_LINE 00000047 "#pod"
NSQ_SOURCE_LINE 00000048 "#pod =head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000049 "#pod"
NSQ_SOURCE_LINE 00000050 "#pod At some point or another, most programmers find they need to compare"
NSQ_SOURCE_LINE 00000051 "#pod floating-point numbers for equality.  The typical idiom is to test"
NSQ_SOURCE_LINE 00000052 "#pod if the absolute value of the difference of the numbers is within a desired"
NSQ_SOURCE_LINE 00000053 "#pod tolerance, usually called epsilon.  This module provides such a function for use"
NSQ_SOURCE_LINE 00000054 "#pod with L<Test::More>.  Usage is similar to other test functions described in"
NSQ_SOURCE_LINE 00000055 "#pod L<Test::More>.  Semantically, the C<delta_within> function replaces this kind"
NSQ_SOURCE_LINE 00000056 "#pod of construct:"
NSQ_SOURCE_LINE 00000057 "#pod"
NSQ_SOURCE_LINE 00000058 "#pod  ok ( abs($p - $q) < $epsilon, '$p is equal to $q' ) or"
NSQ_SOURCE_LINE 00000059 "#pod      diag \"$p is not equal to $q to within $epsilon\";"
NSQ_SOURCE_LINE 00000060 "#pod"
NSQ_SOURCE_LINE 00000061 "#pod While there's nothing wrong with that construct, it's painful to type it"
NSQ_SOURCE_LINE 00000062 "#pod repeatedly in a test script.  This module does the same thing with a single"
NSQ_SOURCE_LINE 00000063 "#pod function call.  The C<delta_ok> function is similar, but either uses a global"
NSQ_SOURCE_LINE 00000064 "#pod default value for epsilon or else calculates a 'relative' epsilon on"
NSQ_SOURCE_LINE 00000065 "#pod the fly so that epsilon is scaled automatically to the size of the arguments to"
NSQ_SOURCE_LINE 00000066 "#pod C<delta_ok>.  Both functions are exported automatically."
NSQ_SOURCE_LINE 00000067 "#pod"
NSQ_SOURCE_LINE 00000068 "#pod Because checking floating-point equality is not always reliable, it is not"
NSQ_SOURCE_LINE 00000069 "#pod possible to check the 'equal to' boundary of 'less than or equal to"
NSQ_SOURCE_LINE 00000070 "#pod epsilon'.  Therefore, Test::Number::Delta only compares if the absolute value"
NSQ_SOURCE_LINE 00000071 "#pod of the difference is B<less than> epsilon (for equality tests) or"
NSQ_SOURCE_LINE 00000072 "#pod B<greater than> epsilon (for inequality tests)."
NSQ_SOURCE_LINE 00000073 "#pod"
NSQ_SOURCE_LINE 00000074 "#pod =head1 USAGE"
NSQ_SOURCE_LINE 00000075 "#pod"
NSQ_SOURCE_LINE 00000076 "#pod =head2 use Test::Number::Delta;"
NSQ_SOURCE_LINE 00000077 "#pod"
NSQ_SOURCE_LINE 00000078 "#pod With no arguments, epsilon defaults to 1e-6. (An arbitrary choice on the"
NSQ_SOURCE_LINE 00000079 "#pod author's part.)"
NSQ_SOURCE_LINE 00000080 "#pod"
NSQ_SOURCE_LINE 00000081 "#pod =head2 use Test::Number::Delta within => 1e-9;"
NSQ_SOURCE_LINE 00000082 "#pod"
NSQ_SOURCE_LINE 00000083 "#pod To specify a different default value for epsilon, provide a C<within> parameter"
NSQ_SOURCE_LINE 00000084 "#pod when importing the module.  The value must be non-zero."
NSQ_SOURCE_LINE 00000085 "#pod"
NSQ_SOURCE_LINE 00000086 "#pod =head2 use Test::Number::Delta relative => 1e-3;"
NSQ_SOURCE_LINE 00000087 "#pod"
NSQ_SOURCE_LINE 00000088 "#pod As an alternative to using a fixed value for epsilon, provide a C<relative>"
NSQ_SOURCE_LINE 00000089 "#pod parameter when importing the module.  This signals that C<delta_ok> should"
NSQ_SOURCE_LINE 00000090 "#pod test equality with an epsilon that is scaled to the size of the arguments."
NSQ_SOURCE_LINE 00000091 "#pod Epsilon is calculated as the relative value times the absolute value"
NSQ_SOURCE_LINE 00000092 "#pod of the argument with the greatest magnitude.  Mathematically, for arguments"
NSQ_SOURCE_LINE 00000093 "#pod 'x' and 'y':"
NSQ_SOURCE_LINE 00000094 "#pod"
NSQ_SOURCE_LINE 00000095 "#pod  epsilon = relative * max( abs(x), abs(y) )"
NSQ_SOURCE_LINE 00000096 "#pod"
NSQ_SOURCE_LINE 00000097 "#pod For example, a relative value of \"0.01\" would mean that the arguments are equal"
NSQ_SOURCE_LINE 00000098 "#pod if they differ by less than 1% of the larger of the two values.  A relative"
NSQ_SOURCE_LINE 00000099 "#pod value of 1e-6 means that the arguments must differ by less than 1 millionth"
NSQ_SOURCE_LINE 00000100 "#pod of the larger value.  The relative value must be non-zero."
NSQ_SOURCE_LINE 00000101 "#pod"
NSQ_SOURCE_LINE 00000102 "#pod =head2 Combining with a test plan"
NSQ_SOURCE_LINE 00000103 "#pod"
NSQ_SOURCE_LINE 00000104 "#pod  use Test::Number::Delta 'no_plan';"
NSQ_SOURCE_LINE 00000105 "#pod"
NSQ_SOURCE_LINE 00000106 "#pod  # or"
NSQ_SOURCE_LINE 00000107 "#pod"
NSQ_SOURCE_LINE 00000108 "#pod  use Test::Number::Delta within => 1e-9, tests => 1;"
NSQ_SOURCE_LINE 00000109 "#pod"
NSQ_SOURCE_LINE 00000110 "#pod If a test plan has not already been specified, the optional"
NSQ_SOURCE_LINE 00000111 "#pod parameter for Test::Number::Delta may be followed with a test plan (see"
NSQ_SOURCE_LINE 00000112 "#pod L<Test::More> for details).  If a parameter for Test::Number::Delta is"
NSQ_SOURCE_LINE 00000113 "#pod given, it must come first."
NSQ_SOURCE_LINE 00000114 "#pod"
NSQ_SOURCE_LINE 00000115 "#pod =cut"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "my $Test     = Test::Builder->new;"
NSQ_SOURCE_LINE 00000118 "my $Epsilon  = 1e-6;"
NSQ_SOURCE_LINE 00000119 "my $Relative = undef;"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "sub import {"
NSQ_SOURCE_LINE 00000122 "    my $self  = shift;"
NSQ_SOURCE_LINE 00000123 "    my $pack  = caller;"
NSQ_SOURCE_LINE 00000124 "    my $found = grep /within|relative/, @_;"
NSQ_SOURCE_LINE 00000125 "    croak \"Can't specify more than one of 'within' or 'relative'\""
NSQ_SOURCE_LINE 00000126 "      if $found > 1;"
NSQ_SOURCE_LINE 00000127 "    if ($found) {"
NSQ_SOURCE_LINE 00000128 "        my ( $param, $value ) = splice @_, 0, 2;"
NSQ_SOURCE_LINE 00000129 "        croak \"'$param' parameter must be non-zero\""
NSQ_SOURCE_LINE 00000130 "          if $value == 0;"
NSQ_SOURCE_LINE 00000131 "        if ( $param eq 'within' ) {"
NSQ_SOURCE_LINE 00000132 "            $Epsilon = abs($value);"
NSQ_SOURCE_LINE 00000133 "        }"
NSQ_SOURCE_LINE 00000134 "        elsif ( $param eq 'relative' ) {"
NSQ_SOURCE_LINE 00000135 "            $Relative = abs($value);"
NSQ_SOURCE_LINE 00000136 "        }"
NSQ_SOURCE_LINE 00000137 "        else {"
NSQ_SOURCE_LINE 00000138 "            croak \"Test::Number::Delta parameters must come first\";"
NSQ_SOURCE_LINE 00000139 "        }"
NSQ_SOURCE_LINE 00000140 "    }"
NSQ_SOURCE_LINE 00000141 "    $Test->exported_to($pack);"
NSQ_SOURCE_LINE 00000142 "    $Test->plan(@_);"
NSQ_SOURCE_LINE 00000143 "    $self->export_to_level( 1, $self, $_ ) for @EXPORT;"
NSQ_SOURCE_LINE 00000144 "}"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000147 "# _check -- recursive function to perform comparison"
NSQ_SOURCE_LINE 00000148 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "sub _check {"
NSQ_SOURCE_LINE 00000151 "    my ( $p, $q, $e, $name, @indices ) = @_;"
NSQ_SOURCE_LINE 00000152 "    my $epsilon;"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    if ( !defined $e ) {"
NSQ_SOURCE_LINE 00000155 "        $epsilon ="
NSQ_SOURCE_LINE 00000156 "            $Relative"
NSQ_SOURCE_LINE 00000157 "          ? $Relative * ( abs($p) > abs($q) ? abs($p) : abs($q) )"
NSQ_SOURCE_LINE 00000158 "          : $Epsilon;"
NSQ_SOURCE_LINE 00000159 "    }"
NSQ_SOURCE_LINE 00000160 "    else {"
NSQ_SOURCE_LINE 00000161 "        $epsilon = abs($e);"
NSQ_SOURCE_LINE 00000162 "    }"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "    my ( $ok, $diag ) = ( 1, q{} ); # assume true"
NSQ_SOURCE_LINE 00000165 "    if ( ref $p eq 'ARRAY' || ref $q eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000166 "        if ( @$p == @$q ) {"
NSQ_SOURCE_LINE 00000167 "            for my $i ( 0 .. $#{$p} ) {"
NSQ_SOURCE_LINE 00000168 "                my @new_indices;"
NSQ_SOURCE_LINE 00000169 "                ( $ok, $diag, @new_indices ) ="
NSQ_SOURCE_LINE 00000170 "                  _check( $p->[$i], $q->[$i], $e, $name, scalar @indices ? @indices : (), $i, );"
NSQ_SOURCE_LINE 00000171 "                if ( not $ok ) {"
NSQ_SOURCE_LINE 00000172 "                    @indices = @new_indices;"
NSQ_SOURCE_LINE 00000173 "                    last;"
NSQ_SOURCE_LINE 00000174 "                }"
NSQ_SOURCE_LINE 00000175 "            }"
NSQ_SOURCE_LINE 00000176 "        }"
NSQ_SOURCE_LINE 00000177 "        else {"
NSQ_SOURCE_LINE 00000178 "            $ok = 0;"
NSQ_SOURCE_LINE 00000179 "            $diag ="
NSQ_SOURCE_LINE 00000180 "                \"Got an array of length \""
NSQ_SOURCE_LINE 00000181 "              . scalar(@$p)"
NSQ_SOURCE_LINE 00000182 "              . \", but expected an array of length \""
NSQ_SOURCE_LINE 00000183 "              . scalar(@$q);"
NSQ_SOURCE_LINE 00000184 "        }"
NSQ_SOURCE_LINE 00000185 "    }"
NSQ_SOURCE_LINE 00000186 "    else {"
NSQ_SOURCE_LINE 00000187 "        $ok = $p == $q || abs( $p - $q ) < $epsilon;"
NSQ_SOURCE_LINE 00000188 "        if ( !$ok ) {"
NSQ_SOURCE_LINE 00000189 "            my ( $ep, $dp ) = _ep_dp($epsilon);"
NSQ_SOURCE_LINE 00000190 "            $diag = sprintf( \"%.${dp}f and %.${dp}f are not equal\" . \" to within %.${ep}f\","
NSQ_SOURCE_LINE 00000191 "                $p, $q, $epsilon );"
NSQ_SOURCE_LINE 00000192 "        }"
NSQ_SOURCE_LINE 00000193 "    }"
NSQ_SOURCE_LINE 00000194 "    return ( $ok, $diag, scalar(@indices) ? @indices : () );"
NSQ_SOURCE_LINE 00000195 "}"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "sub _ep_dp {"
NSQ_SOURCE_LINE 00000198 "    my $epsilon = shift;"
NSQ_SOURCE_LINE 00000199 "    return ( 0, 0 ) unless $epsilon;"
NSQ_SOURCE_LINE 00000200 "    $epsilon = abs($epsilon);"
NSQ_SOURCE_LINE 00000201 "    my ($exp) = sprintf( \"%e\", $epsilon ) =~ m/e(.+)/;"
NSQ_SOURCE_LINE 00000202 "    my $ep = $exp < 0 ? -$exp : 1;"
NSQ_SOURCE_LINE 00000203 "    my $dp = $ep + 1;"
NSQ_SOURCE_LINE 00000204 "    return ( $ep, $dp );"
NSQ_SOURCE_LINE 00000205 "}"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "sub _diag_default {"
NSQ_SOURCE_LINE 00000208 "    my ($ep) = _ep_dp( abs( $Relative || $Epsilon ) );"
NSQ_SOURCE_LINE 00000209 "    my $diag = \"Arguments are equal to within \";"
NSQ_SOURCE_LINE 00000210 "    $diag .="
NSQ_SOURCE_LINE 00000211 "      $Relative"
NSQ_SOURCE_LINE 00000212 "      ? sprintf( \"relative tolerance %.${ep}f\", abs($Relative) )"
NSQ_SOURCE_LINE 00000213 "      : sprintf( \"%.${ep}f\",                    abs($Epsilon) );"
NSQ_SOURCE_LINE 00000214 "    return $diag;"
NSQ_SOURCE_LINE 00000215 "}"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "#pod =head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000218 "#pod"
NSQ_SOURCE_LINE 00000219 "#pod =cut"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000222 "# delta_within()"
NSQ_SOURCE_LINE 00000223 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "#pod =head2 delta_within"
NSQ_SOURCE_LINE 00000226 "#pod"
NSQ_SOURCE_LINE 00000227 "#pod  delta_within(  $p,  $q, $epsilon, '$p and $q are equal within $epsilon' );"
NSQ_SOURCE_LINE 00000228 "#pod  delta_within( \\@p, \\@q, $epsilon, '@p and @q are equal within $epsilon' );"
NSQ_SOURCE_LINE 00000229 "#pod"
NSQ_SOURCE_LINE 00000230 "#pod This function tests for equality within a given value of epsilon. The test is"
NSQ_SOURCE_LINE 00000231 "#pod true if the absolute value of the difference between $p and $q is B<less than>"
NSQ_SOURCE_LINE 00000232 "#pod epsilon.  If the test is true, it prints an \"OK\" statement for use in testing."
NSQ_SOURCE_LINE 00000233 "#pod If the test is not true, this function prints a failure report and diagnostic."
NSQ_SOURCE_LINE 00000234 "#pod Epsilon must be non-zero."
NSQ_SOURCE_LINE 00000235 "#pod"
NSQ_SOURCE_LINE 00000236 "#pod The values to compare may be scalars or references to arrays.  If the values"
NSQ_SOURCE_LINE 00000237 "#pod are references to arrays, the comparison is done pairwise for each index value"
NSQ_SOURCE_LINE 00000238 "#pod of the array.  The pairwise comparison is recursive, so matrices may"
NSQ_SOURCE_LINE 00000239 "#pod be compared as well."
NSQ_SOURCE_LINE 00000240 "#pod"
NSQ_SOURCE_LINE 00000241 "#pod For example, this code sample compares two matrices:"
NSQ_SOURCE_LINE 00000242 "#pod"
NSQ_SOURCE_LINE 00000243 "#pod     my @a = (   [ 3.14, 6.28 ],"
NSQ_SOURCE_LINE 00000244 "#pod                 [ 1.41, 2.84 ]   );"
NSQ_SOURCE_LINE 00000245 "#pod"
NSQ_SOURCE_LINE 00000246 "#pod     my @b = (   [ 3.14, 6.28 ],"
NSQ_SOURCE_LINE 00000247 "#pod                 [ 1.42, 2.84 ]   );"
NSQ_SOURCE_LINE 00000248 "#pod"
NSQ_SOURCE_LINE 00000249 "#pod     delta_within( \\@a, \\@b, 1e-6, 'compare @a and @b' );"
NSQ_SOURCE_LINE 00000250 "#pod"
NSQ_SOURCE_LINE 00000251 "#pod The sample prints the following:"
NSQ_SOURCE_LINE 00000252 "#pod"
NSQ_SOURCE_LINE 00000253 "#pod     not ok 1 - compare @a and @b"
NSQ_SOURCE_LINE 00000254 "#pod     # At [1][0]: 1.4100000 and 1.4200000 are not equal to within 0.000001"
NSQ_SOURCE_LINE 00000255 "#pod"
NSQ_SOURCE_LINE 00000256 "#pod =cut"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "sub delta_within($$$;$) { ## no critic"
NSQ_SOURCE_LINE 00000259 "    my ( $p, $q, $epsilon, $name ) = @_;"
NSQ_SOURCE_LINE 00000260 "    croak \"Value of epsilon to delta_within must be non-zero\""
NSQ_SOURCE_LINE 00000261 "      if !defined($epsilon) || $epsilon == 0;"
NSQ_SOURCE_LINE 00000262 "    {"
NSQ_SOURCE_LINE 00000263 "        local $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000264 "        _delta_within( $p, $q, $epsilon, $name );"
NSQ_SOURCE_LINE 00000265 "    }"
NSQ_SOURCE_LINE 00000266 "}"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "sub _delta_within {"
NSQ_SOURCE_LINE 00000269 "    my ( $p, $q, $epsilon, $name ) = @_;"
NSQ_SOURCE_LINE 00000270 "    my ( $ok, $diag, @indices ) = _check( $p, $q, $epsilon, $name );"
NSQ_SOURCE_LINE 00000271 "    if (@indices) {"
NSQ_SOURCE_LINE 00000272 "        $diag = \"At [\" . join( \"][\", @indices ) . \"]: $diag\";"
NSQ_SOURCE_LINE 00000273 "    }"
NSQ_SOURCE_LINE 00000274 "    return $Test->ok( $ok, $name ) || $Test->diag($diag);"
NSQ_SOURCE_LINE 00000275 "}"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000278 "# delta_ok()"
NSQ_SOURCE_LINE 00000279 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "#pod =head2 delta_ok"
NSQ_SOURCE_LINE 00000282 "#pod"
NSQ_SOURCE_LINE 00000283 "#pod  delta_ok(  $p,  $q, '$p and $q are close enough to equal' );"
NSQ_SOURCE_LINE 00000284 "#pod  delta_ok( \\@p, \\@q, '@p and @q are close enough to equal' );"
NSQ_SOURCE_LINE 00000285 "#pod"
NSQ_SOURCE_LINE 00000286 "#pod This function tests for equality within a default epsilon value.  See L</USAGE>"
NSQ_SOURCE_LINE 00000287 "#pod for details on changing the default.  Otherwise, this function works the same"
NSQ_SOURCE_LINE 00000288 "#pod as C<delta_within>."
NSQ_SOURCE_LINE 00000289 "#pod"
NSQ_SOURCE_LINE 00000290 "#pod =cut"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "sub delta_ok($$;$) { ## no critic"
NSQ_SOURCE_LINE 00000293 "    my ( $p, $q, $name ) = @_;"
NSQ_SOURCE_LINE 00000294 "    {"
NSQ_SOURCE_LINE 00000295 "        local $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000296 "        _delta_within( $p, $q, undef, $name );"
NSQ_SOURCE_LINE 00000297 "    }"
NSQ_SOURCE_LINE 00000298 "}"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000301 "# delta_not_ok()"
NSQ_SOURCE_LINE 00000302 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "#pod =head2 delta_not_within"
NSQ_SOURCE_LINE 00000305 "#pod"
NSQ_SOURCE_LINE 00000306 "#pod  delta_not_within(  $p,  $q, '$p and $q are different' );"
NSQ_SOURCE_LINE 00000307 "#pod  delta_not_within( \\@p, \\@q, $epsilon, '@p and @q are different' );"
NSQ_SOURCE_LINE 00000308 "#pod"
NSQ_SOURCE_LINE 00000309 "#pod This test compares inequality in excess of a given value of epsilon. The test"
NSQ_SOURCE_LINE 00000310 "#pod is true if the absolute value of the difference between $p and $q is B<greater"
NSQ_SOURCE_LINE 00000311 "#pod than> epsilon.  For array or matrix comparisons, the test is true if I<any>"
NSQ_SOURCE_LINE 00000312 "#pod pair of values differs by more than epsilon.  Otherwise, this function works"
NSQ_SOURCE_LINE 00000313 "#pod the same as C<delta_within>."
NSQ_SOURCE_LINE 00000314 "#pod"
NSQ_SOURCE_LINE 00000315 "#pod =cut"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "sub delta_not_within($$$;$) { ## no critic"
NSQ_SOURCE_LINE 00000318 "    my ( $p, $q, $epsilon, $name ) = @_;"
NSQ_SOURCE_LINE 00000319 "    croak \"Value of epsilon to delta_not_within must be non-zero\""
NSQ_SOURCE_LINE 00000320 "      if !defined($epsilon) || $epsilon == 0;"
NSQ_SOURCE_LINE 00000321 "    {"
NSQ_SOURCE_LINE 00000322 "        local $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000323 "        _delta_not_within( $p, $q, $epsilon, $name );"
NSQ_SOURCE_LINE 00000324 "    }"
NSQ_SOURCE_LINE 00000325 "}"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "sub _delta_not_within($$$;$) { ## no critic"
NSQ_SOURCE_LINE 00000328 "    my ( $p, $q, $epsilon, $name ) = @_;"
NSQ_SOURCE_LINE 00000329 "    my ( $ok, undef, @indices ) = _check( $p, $q, $epsilon, $name );"
NSQ_SOURCE_LINE 00000330 "    $ok = !$ok;"
NSQ_SOURCE_LINE 00000331 "    my ( $ep, $dp ) = _ep_dp($epsilon);"
NSQ_SOURCE_LINE 00000332 "    my $diag ="
NSQ_SOURCE_LINE 00000333 "      defined($epsilon)"
NSQ_SOURCE_LINE 00000334 "      ? sprintf( \"Arguments are equal to within %.${ep}f\", abs($epsilon) )"
NSQ_SOURCE_LINE 00000335 "      : _diag_default();"
NSQ_SOURCE_LINE 00000336 "    return $Test->ok( $ok, $name ) || $Test->diag($diag);"
NSQ_SOURCE_LINE 00000337 "}"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "#pod =head2 delta_not_ok"
NSQ_SOURCE_LINE 00000340 "#pod"
NSQ_SOURCE_LINE 00000341 "#pod  delta_not_ok(  $p,  $q, '$p and $q are different' );"
NSQ_SOURCE_LINE 00000342 "#pod  delta_not_ok( \\@p, \\@q, '@p and @q are different' );"
NSQ_SOURCE_LINE 00000343 "#pod"
NSQ_SOURCE_LINE 00000344 "#pod This function tests for inequality in excess of a default epsilon value.  See"
NSQ_SOURCE_LINE 00000345 "#pod L</USAGE> for details on changing the default.  Otherwise, this function works"
NSQ_SOURCE_LINE 00000346 "#pod the same as C<delta_not_within>."
NSQ_SOURCE_LINE 00000347 "#pod"
NSQ_SOURCE_LINE 00000348 "#pod =cut"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "sub delta_not_ok($$;$) { ## no critic"
NSQ_SOURCE_LINE 00000351 "    my ( $p, $q, $name ) = @_;"
NSQ_SOURCE_LINE 00000352 "    {"
NSQ_SOURCE_LINE 00000353 "        local $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000354 "        _delta_not_within( $p, $q, undef, $name );"
NSQ_SOURCE_LINE 00000355 "    }"
NSQ_SOURCE_LINE 00000356 "}"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "#pod =head1 SEE ALSO"
NSQ_SOURCE_LINE 00000359 "#pod"
NSQ_SOURCE_LINE 00000360 "#pod =for :list"
NSQ_SOURCE_LINE 00000361 "#pod * L<Number::Tolerant>"
NSQ_SOURCE_LINE 00000362 "#pod * L<Test::Deep::NumberTolerant>"
NSQ_SOURCE_LINE 00000363 "#pod"
NSQ_SOURCE_LINE 00000364 "#pod =cut"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "1;"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "__END__"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=pod"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=head1 NAME"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "Test::Number::Delta - Compare the difference between numbers against a given tolerance"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "=head1 VERSION"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "version 1.06"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "  # Import test functions"
NSQ_SOURCE_LINE 00000385 "  use Test::Number::Delta;"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "  # Equality test with default tolerance"
NSQ_SOURCE_LINE 00000388 "  delta_ok( 1e-5, 2e-5, 'values within 1e-6');"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "  # Inequality test with default tolerance"
NSQ_SOURCE_LINE 00000391 "  delta_not_ok( 1e-5, 2e-5, 'values not within 1e-6');"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "  # Provide specific tolerance"
NSQ_SOURCE_LINE 00000394 "  delta_within( 1e-3, 2e-3, 1e-4, 'values within 1e-4');"
NSQ_SOURCE_LINE 00000395 "  delta_not_within( 1e-3, 2e-3, 1e-4, 'values not within 1e-4');"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "  # Compare arrays or matrices"
NSQ_SOURCE_LINE 00000398 "  @a = ( 3.14, 1.41 );"
NSQ_SOURCE_LINE 00000399 "  @b = ( 3.15, 1.41 );"
NSQ_SOURCE_LINE 00000400 "  delta_ok( \\@a, \\@b, 'compare @a and @b' );"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "  # Set a different default tolerance"
NSQ_SOURCE_LINE 00000403 "  use Test::Number::Delta within => 1e-5;"
NSQ_SOURCE_LINE 00000404 "  delta_ok( 1.1e-5, 2e-5, 'values within 1e-5'); # ok"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "  # Set a relative tolerance"
NSQ_SOURCE_LINE 00000407 "  use Test::Number::Delta relative => 1e-3;"
NSQ_SOURCE_LINE 00000408 "  delta_ok( 1.01, 1.0099, 'values within 1.01e-3');"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "At some point or another, most programmers find they need to compare"
NSQ_SOURCE_LINE 00000413 "floating-point numbers for equality.  The typical idiom is to test"
NSQ_SOURCE_LINE 00000414 "if the absolute value of the difference of the numbers is within a desired"
NSQ_SOURCE_LINE 00000415 "tolerance, usually called epsilon.  This module provides such a function for use"
NSQ_SOURCE_LINE 00000416 "with L<Test::More>.  Usage is similar to other test functions described in"
NSQ_SOURCE_LINE 00000417 "L<Test::More>.  Semantically, the C<delta_within> function replaces this kind"
NSQ_SOURCE_LINE 00000418 "of construct:"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 " ok ( abs($p - $q) < $epsilon, '$p is equal to $q' ) or"
NSQ_SOURCE_LINE 00000421 "     diag \"$p is not equal to $q to within $epsilon\";"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "While there's nothing wrong with that construct, it's painful to type it"
NSQ_SOURCE_LINE 00000424 "repeatedly in a test script.  This module does the same thing with a single"
NSQ_SOURCE_LINE 00000425 "function call.  The C<delta_ok> function is similar, but either uses a global"
NSQ_SOURCE_LINE 00000426 "default value for epsilon or else calculates a 'relative' epsilon on"
NSQ_SOURCE_LINE 00000427 "the fly so that epsilon is scaled automatically to the size of the arguments to"
NSQ_SOURCE_LINE 00000428 "C<delta_ok>.  Both functions are exported automatically."
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "Because checking floating-point equality is not always reliable, it is not"
NSQ_SOURCE_LINE 00000431 "possible to check the 'equal to' boundary of 'less than or equal to"
NSQ_SOURCE_LINE 00000432 "epsilon'.  Therefore, Test::Number::Delta only compares if the absolute value"
NSQ_SOURCE_LINE 00000433 "of the difference is B<less than> epsilon (for equality tests) or"
NSQ_SOURCE_LINE 00000434 "B<greater than> epsilon (for inequality tests)."
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "=head1 USAGE"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "=head2 use Test::Number::Delta;"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "With no arguments, epsilon defaults to 1e-6. (An arbitrary choice on the"
NSQ_SOURCE_LINE 00000441 "author's part.)"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "=head2 use Test::Number::Delta within => 1e-9;"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "To specify a different default value for epsilon, provide a C<within> parameter"
NSQ_SOURCE_LINE 00000446 "when importing the module.  The value must be non-zero."
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "=head2 use Test::Number::Delta relative => 1e-3;"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "As an alternative to using a fixed value for epsilon, provide a C<relative>"
NSQ_SOURCE_LINE 00000451 "parameter when importing the module.  This signals that C<delta_ok> should"
NSQ_SOURCE_LINE 00000452 "test equality with an epsilon that is scaled to the size of the arguments."
NSQ_SOURCE_LINE 00000453 "Epsilon is calculated as the relative value times the absolute value"
NSQ_SOURCE_LINE 00000454 "of the argument with the greatest magnitude.  Mathematically, for arguments"
NSQ_SOURCE_LINE 00000455 "'x' and 'y':"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 " epsilon = relative * max( abs(x), abs(y) )"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "For example, a relative value of \"0.01\" would mean that the arguments are equal"
NSQ_SOURCE_LINE 00000460 "if they differ by less than 1% of the larger of the two values.  A relative"
NSQ_SOURCE_LINE 00000461 "value of 1e-6 means that the arguments must differ by less than 1 millionth"
NSQ_SOURCE_LINE 00000462 "of the larger value.  The relative value must be non-zero."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "=head2 Combining with a test plan"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 " use Test::Number::Delta 'no_plan';"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 " # or"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 " use Test::Number::Delta within => 1e-9, tests => 1;"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "If a test plan has not already been specified, the optional"
NSQ_SOURCE_LINE 00000473 "parameter for Test::Number::Delta may be followed with a test plan (see"
NSQ_SOURCE_LINE 00000474 "L<Test::More> for details).  If a parameter for Test::Number::Delta is"
NSQ_SOURCE_LINE 00000475 "given, it must come first."
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "=head2 delta_within"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 " delta_within(  $p,  $q, $epsilon, '$p and $q are equal within $epsilon' );"
NSQ_SOURCE_LINE 00000482 " delta_within( \\@p, \\@q, $epsilon, '@p and @q are equal within $epsilon' );"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "This function tests for equality within a given value of epsilon. The test is"
NSQ_SOURCE_LINE 00000485 "true if the absolute value of the difference between $p and $q is B<less than>"
NSQ_SOURCE_LINE 00000486 "epsilon.  If the test is true, it prints an \"OK\" statement for use in testing."
NSQ_SOURCE_LINE 00000487 "If the test is not true, this function prints a failure report and diagnostic."
NSQ_SOURCE_LINE 00000488 "Epsilon must be non-zero."
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "The values to compare may be scalars or references to arrays.  If the values"
NSQ_SOURCE_LINE 00000491 "are references to arrays, the comparison is done pairwise for each index value"
NSQ_SOURCE_LINE 00000492 "of the array.  The pairwise comparison is recursive, so matrices may"
NSQ_SOURCE_LINE 00000493 "be compared as well."
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "For example, this code sample compares two matrices:"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "    my @a = (   [ 3.14, 6.28 ],"
NSQ_SOURCE_LINE 00000498 "                [ 1.41, 2.84 ]   );"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "    my @b = (   [ 3.14, 6.28 ],"
NSQ_SOURCE_LINE 00000501 "                [ 1.42, 2.84 ]   );"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "    delta_within( \\@a, \\@b, 1e-6, 'compare @a and @b' );"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "The sample prints the following:"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "    not ok 1 - compare @a and @b"
NSQ_SOURCE_LINE 00000508 "    # At [1][0]: 1.4100000 and 1.4200000 are not equal to within 0.000001"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "=head2 delta_ok"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 " delta_ok(  $p,  $q, '$p and $q are close enough to equal' );"
NSQ_SOURCE_LINE 00000513 " delta_ok( \\@p, \\@q, '@p and @q are close enough to equal' );"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "This function tests for equality within a default epsilon value.  See L</USAGE>"
NSQ_SOURCE_LINE 00000516 "for details on changing the default.  Otherwise, this function works the same"
NSQ_SOURCE_LINE 00000517 "as C<delta_within>."
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "=head2 delta_not_within"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 " delta_not_within(  $p,  $q, '$p and $q are different' );"
NSQ_SOURCE_LINE 00000522 " delta_not_within( \\@p, \\@q, $epsilon, '@p and @q are different' );"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "This test compares inequality in excess of a given value of epsilon. The test"
NSQ_SOURCE_LINE 00000525 "is true if the absolute value of the difference between $p and $q is B<greater"
NSQ_SOURCE_LINE 00000526 "than> epsilon.  For array or matrix comparisons, the test is true if I<any>"
NSQ_SOURCE_LINE 00000527 "pair of values differs by more than epsilon.  Otherwise, this function works"
NSQ_SOURCE_LINE 00000528 "the same as C<delta_within>."
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "=head2 delta_not_ok"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 " delta_not_ok(  $p,  $q, '$p and $q are different' );"
NSQ_SOURCE_LINE 00000533 " delta_not_ok( \\@p, \\@q, '@p and @q are different' );"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "This function tests for inequality in excess of a default epsilon value.  See"
NSQ_SOURCE_LINE 00000536 "L</USAGE> for details on changing the default.  Otherwise, this function works"
NSQ_SOURCE_LINE 00000537 "the same as C<delta_not_within>."
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "=over 4"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "=item *"
NSQ_SOURCE_LINE 00000544 ""
