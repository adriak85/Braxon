NSQ_SOURCE_LINE 00001533 "\t\t\tmy $util = $_[0];"
NSQ_SOURCE_LINE 00001534 "\t\t\t$self->{'_util'}{$util} ||= eval { $self->_build_util( $util ) };"
NSQ_SOURCE_LINE 00001535 "\t\t\treturn unless $self->{'_util'}{$util};"
NSQ_SOURCE_LINE 00001536 "\t\t\treturn sub { my $s = shift; $s->{'_util'}{$util}( @_ ) };"
NSQ_SOURCE_LINE 00001537 "\t\t}"
NSQ_SOURCE_LINE 00001538 "\t\tif ( $INC{\"Moose/Meta/TypeConstraint.pm\"} ) {"
NSQ_SOURCE_LINE 00001539 "\t\t\tmy $method = $self->moose_type->can( @_ );"
NSQ_SOURCE_LINE 00001540 "\t\t\treturn sub { shift->moose_type->$method( @_ ) }"
NSQ_SOURCE_LINE 00001541 "\t\t\t\tif $method;"
NSQ_SOURCE_LINE 00001542 "\t\t}"
NSQ_SOURCE_LINE 00001543 "\t} #/ if ( ref( $self ) )"
NSQ_SOURCE_LINE 00001544 "\t"
NSQ_SOURCE_LINE 00001545 "\treturn;"
NSQ_SOURCE_LINE 00001546 "} #/ sub can"
NSQ_SOURCE_LINE 00001547 ""
NSQ_SOURCE_LINE 00001548 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00001549 "\tmy $self = shift;"
