NSQ_SOURCE_LINE 00000133 "\t\t"
NSQ_SOURCE_LINE 00000134 "\t\t# Coverage is checked on Perl 5.26"
NSQ_SOURCE_LINE 00000135 "\t\tif ( $] < 5.010 ) {    # uncoverable statement"
NSQ_SOURCE_LINE 00000136 "\t\t\trequire overload;             # uncoverable statement"
NSQ_SOURCE_LINE 00000137 "\t\t\tpush @_, fallback => 1;       # uncoverable statement"
NSQ_SOURCE_LINE 00000138 "\t\t\tgoto \\&overload::OVERLOAD;    # uncoverable statement"
NSQ_SOURCE_LINE 00000139 "\t\t}"
NSQ_SOURCE_LINE 00000140 "\t\t"
NSQ_SOURCE_LINE 00000141 "\t\tmy $class = shift;"
NSQ_SOURCE_LINE 00000142 "\t\t*{ $class . '::((' } = sub { };"
NSQ_SOURCE_LINE 00000143 "\t\t*{ $class . '::()' } = sub { };"
NSQ_SOURCE_LINE 00000144 "\t\t*{ $class . '::()' } = do { my $x = 1; \\$x };"
NSQ_SOURCE_LINE 00000145 "\t\twhile ( @_ ) {"
NSQ_SOURCE_LINE 00000146 "\t\t\tmy $f = shift;"
NSQ_SOURCE_LINE 00000147 "\t\t\t*{ $class . '::(' . $f } = ref $_[0] ? shift : do {"
NSQ_SOURCE_LINE 00000148 "\t\t\t\tmy $m = shift;"
NSQ_SOURCE_LINE 00000149 "\t\t\t\tsub { shift->$m( @_ ) }"
NSQ_SOURCE_LINE 00000150 "\t\t\t};"
NSQ_SOURCE_LINE 00000151 "\t\t}"
NSQ_SOURCE_LINE 00000152 "\t} #/ sub _install_overloads"
