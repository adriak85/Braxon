NSQ_SOURCE_LINE 00001512 "sub can {"
NSQ_SOURCE_LINE 00001513 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001514 "\t"
NSQ_SOURCE_LINE 00001515 "\treturn !!0"
NSQ_SOURCE_LINE 00001516 "\t\tif $_[0] eq 'type_parameter'"
NSQ_SOURCE_LINE 00001517 "\t\t&& blessed( $_[0] )"
NSQ_SOURCE_LINE 00001518 "\t\t&& $_[0]->has_parameters;"
NSQ_SOURCE_LINE 00001519 "\t\t"
NSQ_SOURCE_LINE 00001520 "\tmy $can = $self->SUPER::can( @_ );"
NSQ_SOURCE_LINE 00001521 "\treturn $can if $can;"
NSQ_SOURCE_LINE 00001522 "\t"
NSQ_SOURCE_LINE 00001523 "\tif ( ref( $self ) ) {"
NSQ_SOURCE_LINE 00001524 "\t\tif ( $_[0] =~ /\\Amy_(.+)\\z/ ) {"
NSQ_SOURCE_LINE 00001525 "\t\t\tmy $method = $self->_lookup_my_method( $1 );"
NSQ_SOURCE_LINE 00001526 "\t\t\treturn $method if $method;"
NSQ_SOURCE_LINE 00001527 "\t\t}"
NSQ_SOURCE_LINE 00001528 "\t\tif ( $self->{is_object} && $object_methods{ $_[0] } ) {"
NSQ_SOURCE_LINE 00001529 "\t\t\trequire Type::Tiny::ConstrainedObject;"
NSQ_SOURCE_LINE 00001530 "\t\t\treturn Type::Tiny::ConstrainedObject->can( $_[0] );"
NSQ_SOURCE_LINE 00001531 "\t\t}"
