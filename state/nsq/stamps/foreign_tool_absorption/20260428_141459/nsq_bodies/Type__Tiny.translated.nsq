NSQ_SOURCE_LINE 00001555 "\t\t\tmy $method = $self->_lookup_my_method( $1 );"
NSQ_SOURCE_LINE 00001556 "\t\t\treturn &$method( $self, @_ ) if $method;"
NSQ_SOURCE_LINE 00001557 "\t\t}"
NSQ_SOURCE_LINE 00001558 "\t\tif ( $self->{is_object} && $object_methods{$m} ) {"
NSQ_SOURCE_LINE 00001559 "\t\t\trequire Type::Tiny::ConstrainedObject;"
NSQ_SOURCE_LINE 00001560 "\t\t\tunshift @_, $self;"
NSQ_SOURCE_LINE 00001561 "\t\t\tno strict 'refs';"
NSQ_SOURCE_LINE 00001562 "\t\t\tgoto \\&{\"Type::Tiny::ConstrainedObject::$m\"};"
NSQ_SOURCE_LINE 00001563 "\t\t}"
