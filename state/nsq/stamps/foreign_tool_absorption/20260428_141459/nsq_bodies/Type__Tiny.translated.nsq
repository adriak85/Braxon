NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "{"
NSQ_SOURCE_LINE 00001118 "\tmy %seen;"
NSQ_SOURCE_LINE 00001119 "\t"
NSQ_SOURCE_LINE 00001120 "\tsub ____make_key {"
NSQ_SOURCE_LINE 00001121 "\t\t#<<<"
NSQ_SOURCE_LINE 00001122 "\t\tjoin ',', map {"
NSQ_SOURCE_LINE 00001123 "\t\t\tTypes::TypeTiny::is_TypeTiny( $_ )  ? sprintf( '$Type::Tiny::ALL_TYPES{%s}', defined( $_->{uniq} ) ? $_->{uniq} : '____CANNOT_KEY____' ) :"
NSQ_SOURCE_LINE 00001124 "\t\t\tref() eq 'ARRAY'                    ? do { $seen{$_}++ ? '____CANNOT_KEY____' : sprintf( '[%s]', ____make_key( @$_ ) ) } :"
NSQ_SOURCE_LINE 00001125 "\t\t\tref() eq 'HASH'                     ? do { $seen{$_}++ ? '____CANNOT_KEY____' : sprintf( '{%s}', ____make_key( do { my %h = %$_; map +( $_, $h{$_} ), sort keys %h; } ) ) } :"
NSQ_SOURCE_LINE 00001126 "\t\t\tref() eq 'SCALAR' || ref() eq 'REF' ? do { $seen{$_}++ ? '____CANNOT_KEY____' : sprintf( '\\\\(%s)', ____make_key( $$_ ) ) } :"
NSQ_SOURCE_LINE 00001127 "\t\t\t!defined()                          ? 'undef' :"
NSQ_SOURCE_LINE 00001128 "\t\t\t!ref()                              ? do { require B; B::perlstring( $_ ) } :"
NSQ_SOURCE_LINE 00001129 "\t\t\t'____CANNOT_KEY____';"
NSQ_SOURCE_LINE 00001130 "\t\t} @_;"
NSQ_SOURCE_LINE 00001131 "\t\t#>>>"
NSQ_SOURCE_LINE 00001132 "\t} #/ sub ____make_key"
NSQ_SOURCE_LINE 00001133 "\tmy %param_cache;"
NSQ_SOURCE_LINE 00001134 "\t"
NSQ_SOURCE_LINE 00001135 "\tsub parameterize {"
NSQ_SOURCE_LINE 00001136 "\t\tmy $self = shift;"
NSQ_SOURCE_LINE 00001137 "\t\t"
NSQ_SOURCE_LINE 00001138 "\t\t$self->is_parameterizable"
NSQ_SOURCE_LINE 00001139 "\t\t\tor @_"
NSQ_SOURCE_LINE 00001140 "\t\t\t? _croak( \"Type '%s' does not accept parameters\", \"$self\" )"
NSQ_SOURCE_LINE 00001141 "\t\t\t: return ( $self );"
NSQ_SOURCE_LINE 00001142 "\t\t\t"
NSQ_SOURCE_LINE 00001143 "\t\t@_ = map Types::TypeTiny::to_TypeTiny( $_ ), @_;"
NSQ_SOURCE_LINE 00001144 "\t\t"
NSQ_SOURCE_LINE 00001145 "\t\t# Generate a key for caching parameterized type constraints,"
NSQ_SOURCE_LINE 00001146 "\t\t# but only if all the parameters are strings or type constraints."
NSQ_SOURCE_LINE 00001147 "\t\t%seen = ();"
NSQ_SOURCE_LINE 00001148 "\t\tmy $key = $self->____make_key( @_ );"
NSQ_SOURCE_LINE 00001149 "\t\tundef( $key )             if $key =~ /____CANNOT_KEY____/;"
NSQ_SOURCE_LINE 00001150 "\t\treturn $param_cache{$key} if defined $key && defined $param_cache{$key};"
NSQ_SOURCE_LINE 00001151 "\t\t"
NSQ_SOURCE_LINE 00001152 "\t\tlocal $Type::Tiny::parameterize_type = $self;"
NSQ_SOURCE_LINE 00001153 "\t\tlocal $_                             = $_[0];"
NSQ_SOURCE_LINE 00001154 "\t\tmy $P;"
NSQ_SOURCE_LINE 00001155 "\t\t"
NSQ_SOURCE_LINE 00001156 "\t\tmy ( $constraint, $compiled ) = $self->constraint_generator->( @_ );"
NSQ_SOURCE_LINE 00001157 "\t\t"
NSQ_SOURCE_LINE 00001158 "\t\tif ( Types::TypeTiny::is_TypeTiny( $constraint ) ) {"
NSQ_SOURCE_LINE 00001159 "\t\t\t$P = $constraint;"
NSQ_SOURCE_LINE 00001160 "\t\t}"
NSQ_SOURCE_LINE 00001161 "\t\telse {"
NSQ_SOURCE_LINE 00001162 "\t\t\tmy %options = ("
NSQ_SOURCE_LINE 00001163 "\t\t\t\tconstraint   => $constraint,"
NSQ_SOURCE_LINE 00001164 "\t\t\t\tdisplay_name => $self->name_generator->( $self, @_ ),"
NSQ_SOURCE_LINE 00001165 "\t\t\t\tparameters   => [@_],"
NSQ_SOURCE_LINE 00001166 "\t\t\t);"
NSQ_SOURCE_LINE 00001167 "\t\t\t$options{compiled_type_constraint} = $compiled"
NSQ_SOURCE_LINE 00001168 "\t\t\t\tif $compiled;"
NSQ_SOURCE_LINE 00001169 "\t\t\t$options{inlined} = $self->inline_generator->( @_ )"
NSQ_SOURCE_LINE 00001170 "\t\t\t\tif $self->has_inline_generator;"
NSQ_SOURCE_LINE 00001171 "\t\t\t$options{type_default} = $self->{type_default_generator}->( @_ )"
NSQ_SOURCE_LINE 00001172 "\t\t\t\tif exists $self->{type_default_generator}; # undocumented"
NSQ_SOURCE_LINE 00001173 "\t\t\texists $options{$_} && !defined $options{$_} && delete $options{$_}"
NSQ_SOURCE_LINE 00001174 "\t\t\t\tfor keys %options;"
NSQ_SOURCE_LINE 00001175 "\t\t\t"
NSQ_SOURCE_LINE 00001176 "\t\t\t$P = $self->create_child_type( %options );"
NSQ_SOURCE_LINE 00001177 "\t\t\t"
NSQ_SOURCE_LINE 00001178 "\t\t\tif ( $self->has_coercion_generator ) {"
NSQ_SOURCE_LINE 00001179 "\t\t\t\tmy @args = @_;"
NSQ_SOURCE_LINE 00001180 "\t\t\t\t$P->{_build_coercion} = sub {"
NSQ_SOURCE_LINE 00001181 "\t\t\t\t\tmy $coercion = shift;"
NSQ_SOURCE_LINE 00001182 "\t\t\t\t\tmy $built    = $self->coercion_generator->( $self, $P, @args );"
NSQ_SOURCE_LINE 00001183 "\t\t\t\t\t$coercion->add_type_coercions( @{ $built->type_coercion_map } ) if $built;"
NSQ_SOURCE_LINE 00001184 "\t\t\t\t\t$coercion->freeze;"
NSQ_SOURCE_LINE 00001185 "\t\t\t\t};"
NSQ_SOURCE_LINE 00001186 "\t\t\t}"
NSQ_SOURCE_LINE 00001187 "\t\t} #/ else [ if ( Types::TypeTiny::is_TypeTiny...)]"
NSQ_SOURCE_LINE 00001188 "\t\t"
NSQ_SOURCE_LINE 00001189 "\t\tif ( defined $key ) {"
NSQ_SOURCE_LINE 00001190 "\t\t\t$param_cache{$key} = $P;"
NSQ_SOURCE_LINE 00001191 "\t\t\tScalar::Util::weaken( $param_cache{$key} );"
NSQ_SOURCE_LINE 00001192 "\t\t}"
NSQ_SOURCE_LINE 00001193 "\t\t"
NSQ_SOURCE_LINE 00001194 "\t\t$P->coercion->freeze unless $self->has_coercion_generator;"
NSQ_SOURCE_LINE 00001195 "\t\t"
NSQ_SOURCE_LINE 00001196 "\t\treturn $P;"
NSQ_SOURCE_LINE 00001197 "\t} #/ sub parameterize"
NSQ_SOURCE_LINE 00001198 "}"
NSQ_SOURCE_LINE 00001199 ""
NSQ_SOURCE_LINE 00001200 "sub check_parameter_count_for_parameterized_type {"
NSQ_SOURCE_LINE 00001201 "\tmy ( $library, $type_name, $args, $max_args, $min_args ) = @_;"
NSQ_SOURCE_LINE 00001202 "\t$args = @$args if ref $args;"
NSQ_SOURCE_LINE 00001203 "\t"
NSQ_SOURCE_LINE 00001204 "\tif ( ( defined $max_args and $args > $max_args ) or ( defined $min_args and $args < $min_args ) ) {"
NSQ_SOURCE_LINE 00001205 "\t\trequire Error::TypeTiny::WrongNumberOfParameters;"
NSQ_SOURCE_LINE 00001206 "\t\tError::TypeTiny::WrongNumberOfParameters->throw("
NSQ_SOURCE_LINE 00001207 "\t\t\ttarget => \"$library\\::$type_name\\[]\","
NSQ_SOURCE_LINE 00001208 "\t\t\t( defined $min_args ) ? ( minimum => $min_args ) : (),"
NSQ_SOURCE_LINE 00001209 "\t\t\t( defined $max_args ) ? ( maximum => $max_args ) : (),"
NSQ_SOURCE_LINE 00001210 "\t\t\tgot => $args,"
NSQ_SOURCE_LINE 00001211 "\t\t);"
NSQ_SOURCE_LINE 00001212 "\t}"
NSQ_SOURCE_LINE 00001213 "\t"
NSQ_SOURCE_LINE 00001214 "\treturn;"
NSQ_SOURCE_LINE 00001215 "}"
NSQ_SOURCE_LINE 00001216 ""
NSQ_SOURCE_LINE 00001217 "sub child_type_class {"
NSQ_SOURCE_LINE 00001218 "\t__PACKAGE__;"
NSQ_SOURCE_LINE 00001219 "}"
NSQ_SOURCE_LINE 00001220 ""
NSQ_SOURCE_LINE 00001221 "sub create_child_type {"
NSQ_SOURCE_LINE 00001222 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001223 "\tmy %moreopts;"
NSQ_SOURCE_LINE 00001224 "\t$moreopts{is_object} = 1 if $self->{is_object};"
NSQ_SOURCE_LINE 00001225 "\treturn $self->child_type_class->new( parent => $self, %moreopts, @_ );"
NSQ_SOURCE_LINE 00001226 "}"
NSQ_SOURCE_LINE 00001227 ""
NSQ_SOURCE_LINE 00001228 "sub complementary_type {"
NSQ_SOURCE_LINE 00001229 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001230 "\tmy $r    = ( $self->{complementary_type} ||= $self->_build_complementary_type );"
NSQ_SOURCE_LINE 00001231 "\tScalar::Util::weaken( $self->{complementary_type} )"
NSQ_SOURCE_LINE 00001232 "\t\tunless Scalar::Util::isweak( $self->{complementary_type} );"
NSQ_SOURCE_LINE 00001233 "\treturn $r;"
NSQ_SOURCE_LINE 00001234 "}"
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 "sub _build_complementary_type {"
NSQ_SOURCE_LINE 00001237 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001238 "\tmy %opts = ("
NSQ_SOURCE_LINE 00001239 "\t\tconstraint   => sub { not $self->check( $_ ) },"
NSQ_SOURCE_LINE 00001240 "\t\tdisplay_name => sprintf( \"~%s\", $self ),"
NSQ_SOURCE_LINE 00001241 "\t);"
NSQ_SOURCE_LINE 00001242 "\t$opts{display_name} =~ s/^\\~{2}//;"
NSQ_SOURCE_LINE 00001243 "\t$opts{inlined} = sub { shift; \"not(\" . $self->inline_check( @_ ) . \")\" }"
NSQ_SOURCE_LINE 00001244 "\t\tif $self->can_be_inlined;"
NSQ_SOURCE_LINE 00001245 "\t$opts{display_name} = $opts{name} = $self->{complement_name}"
NSQ_SOURCE_LINE 00001246 "\t\tif $self->{complement_name};"
NSQ_SOURCE_LINE 00001247 "\treturn \"Type::Tiny\"->new( %opts );"
NSQ_SOURCE_LINE 00001248 "} #/ sub _build_complementary_type"
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "sub _instantiate_moose_type {"
NSQ_SOURCE_LINE 00001251 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001252 "\tmy %opts = @_;"
NSQ_SOURCE_LINE 00001253 "\trequire Moose::Meta::TypeConstraint;"
NSQ_SOURCE_LINE 00001254 "\treturn \"Moose::Meta::TypeConstraint\"->new( %opts );"
NSQ_SOURCE_LINE 00001255 "}"
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "sub _build_moose_type {"
NSQ_SOURCE_LINE 00001258 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001259 "\t"
NSQ_SOURCE_LINE 00001260 "\tmy $r;"
NSQ_SOURCE_LINE 00001261 "\tif ( $self->{_is_core} ) {"
NSQ_SOURCE_LINE 00001262 "\t\trequire Moose::Util::TypeConstraints;"
NSQ_SOURCE_LINE 00001263 "\t\t$r = Moose::Util::TypeConstraints::find_type_constraint( $self->name );"
NSQ_SOURCE_LINE 00001264 "\t\t$r->{\"Types::TypeTiny::to_TypeTiny\"} = $self;"
NSQ_SOURCE_LINE 00001265 "\t\tScalar::Util::weaken( $r->{\"Types::TypeTiny::to_TypeTiny\"} );"
NSQ_SOURCE_LINE 00001266 "\t}"
NSQ_SOURCE_LINE 00001267 "\telse {"
NSQ_SOURCE_LINE 00001268 "\t\t# Type::Tiny is more flexible than Moose, allowing"
NSQ_SOURCE_LINE 00001269 "\t\t# inlined to return a list. So we need to wrap the"
NSQ_SOURCE_LINE 00001270 "\t\t# inlined coderef to make sure Moose gets a single"
NSQ_SOURCE_LINE 00001271 "\t\t# string."
NSQ_SOURCE_LINE 00001272 "\t\t#"
NSQ_SOURCE_LINE 00001273 "\t\tmy $wrapped_inlined = sub {"
NSQ_SOURCE_LINE 00001274 "\t\t\tshift;"
NSQ_SOURCE_LINE 00001275 "\t\t\t$self->inline_check( @_ );"
NSQ_SOURCE_LINE 00001276 "\t\t};"
NSQ_SOURCE_LINE 00001277 "\t\t"
NSQ_SOURCE_LINE 00001278 "\t\tmy %opts;"
NSQ_SOURCE_LINE 00001279 "\t\t$opts{name}   = $self->qualified_name if $self->has_library && !$self->is_anon;"
NSQ_SOURCE_LINE 00001280 "\t\t$opts{parent} = $self->parent->moose_type if $self->has_parent;"
NSQ_SOURCE_LINE 00001281 "\t\t$opts{constraint} = $self->constraint unless $self->_is_null_constraint;"
NSQ_SOURCE_LINE 00001282 "\t\t$opts{message}    = $self->message   if $self->has_message;"
NSQ_SOURCE_LINE 00001283 "\t\t$opts{inlined}    = $wrapped_inlined if $self->has_inlined;"
NSQ_SOURCE_LINE 00001284 "\t\t"
NSQ_SOURCE_LINE 00001285 "\t\t$r                                   = $self->_instantiate_moose_type( %opts );"
NSQ_SOURCE_LINE 00001286 "\t\t$r->{\"Types::TypeTiny::to_TypeTiny\"} = $self;"
NSQ_SOURCE_LINE 00001287 "\t\t$self->{moose_type}                  = $r;                                     # prevent recursion"
NSQ_SOURCE_LINE 00001288 "\t\t$r->coercion( $self->coercion->moose_coercion ) if $self->has_coercion;"
NSQ_SOURCE_LINE 00001289 "\t} #/ else [ if ( $self->{_is_core})]"
NSQ_SOURCE_LINE 00001290 "\t"
NSQ_SOURCE_LINE 00001291 "\treturn $r;"
NSQ_SOURCE_LINE 00001292 "} #/ sub _build_moose_type"
NSQ_SOURCE_LINE 00001293 ""
NSQ_SOURCE_LINE 00001294 "sub _build_mouse_type {"
NSQ_SOURCE_LINE 00001295 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001296 "\t"
NSQ_SOURCE_LINE 00001297 "\tmy %options;"
NSQ_SOURCE_LINE 00001298 "\t$options{name} = $self->qualified_name if $self->has_library && !$self->is_anon;"
NSQ_SOURCE_LINE 00001299 "\t$options{parent}     = $self->parent->mouse_type if $self->has_parent;"
NSQ_SOURCE_LINE 00001300 "\t$options{constraint} = $self->constraint unless $self->_is_null_constraint;"
NSQ_SOURCE_LINE 00001301 "\t$options{message}    = $self->message if $self->has_message;"
NSQ_SOURCE_LINE 00001302 "\t"
NSQ_SOURCE_LINE 00001303 "\trequire Mouse::Meta::TypeConstraint;"
NSQ_SOURCE_LINE 00001304 "\tmy $r = \"Mouse::Meta::TypeConstraint\"->new( %options );"
NSQ_SOURCE_LINE 00001305 "\t"
NSQ_SOURCE_LINE 00001306 "\t$self->{mouse_type} = $r;    # prevent recursion"
NSQ_SOURCE_LINE 00001307 "\t$r->_add_type_coercions("
NSQ_SOURCE_LINE 00001308 "\t\t$self->coercion->freeze->_codelike_type_coercion_map( 'mouse_type' ) )"
NSQ_SOURCE_LINE 00001309 "\t\tif $self->has_coercion;"
NSQ_SOURCE_LINE 00001310 "\t\t"
NSQ_SOURCE_LINE 00001311 "\treturn $r;"
NSQ_SOURCE_LINE 00001312 "} #/ sub _build_mouse_type"
NSQ_SOURCE_LINE 00001313 ""
NSQ_SOURCE_LINE 00001314 "sub exportables {"
NSQ_SOURCE_LINE 00001315 "\tmy ( $self, $base_name, $tag ) = ( shift, @_ ); # $tag is undocumented"
NSQ_SOURCE_LINE 00001316 "\tif ( not $self->is_anon ) {"
NSQ_SOURCE_LINE 00001317 "\t\t$base_name ||= $self->name;"
NSQ_SOURCE_LINE 00001318 "\t}"
NSQ_SOURCE_LINE 00001319 "\t$tag ||= 0;"
NSQ_SOURCE_LINE 00001320 ""
NSQ_SOURCE_LINE 00001321 "\tmy @exportables;"
NSQ_SOURCE_LINE 00001322 "\treturn \\@exportables if ! $base_name;"
NSQ_SOURCE_LINE 00001323 ""
NSQ_SOURCE_LINE 00001324 "\trequire Eval::TypeTiny;"
NSQ_SOURCE_LINE 00001325 ""
NSQ_SOURCE_LINE 00001326 "\tpush @exportables, {"
NSQ_SOURCE_LINE 00001327 "\t\tname => $base_name,"
NSQ_SOURCE_LINE 00001328 "\t\tcode => Eval::TypeTiny::type_to_coderef( $self ),"
NSQ_SOURCE_LINE 00001329 "\t\ttags => [ 'types' ],"
NSQ_SOURCE_LINE 00001330 "\t} if $tag eq 'types' || !$tag;"
NSQ_SOURCE_LINE 00001331 ""
NSQ_SOURCE_LINE 00001332 "\tpush @exportables, {"
NSQ_SOURCE_LINE 00001333 "\t\tname => sprintf( 'is_%s', $base_name ),"
NSQ_SOURCE_LINE 00001334 "\t\tcode => $self->compiled_check,"
NSQ_SOURCE_LINE 00001335 "\t\ttags => [ 'is' ],"
NSQ_SOURCE_LINE 00001336 "\t} if $tag eq 'is' || !$tag;"
NSQ_SOURCE_LINE 00001337 ""
NSQ_SOURCE_LINE 00001338 "\tpush @exportables, {"
NSQ_SOURCE_LINE 00001339 "\t\tname => sprintf( 'assert_%s', $base_name ),"
NSQ_SOURCE_LINE 00001340 "\t\tcode => $self->_overload_coderef,"
NSQ_SOURCE_LINE 00001341 "\t\ttags => [ 'assert' ],"
NSQ_SOURCE_LINE 00001342 "\t} if $tag eq 'assert' || !$tag;"
NSQ_SOURCE_LINE 00001343 ""
NSQ_SOURCE_LINE 00001344 "\tpush @exportables, {"
NSQ_SOURCE_LINE 00001345 "\t\tname => sprintf( 'to_%s', $base_name ),"
NSQ_SOURCE_LINE 00001346 "\t\tcode => $self->has_coercion && $self->coercion->frozen"
NSQ_SOURCE_LINE 00001347 "\t\t\t? $self->coercion->compiled_coercion"
NSQ_SOURCE_LINE 00001348 "\t\t\t: sub ($) { $self->coerce( $_[0] ) },"
NSQ_SOURCE_LINE 00001349 "\t\ttags => [ 'to' ],"
NSQ_SOURCE_LINE 00001350 "\t} if $tag eq 'to' || !$tag;"
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "\treturn \\@exportables;"
NSQ_SOURCE_LINE 00001353 "}"
NSQ_SOURCE_LINE 00001354 ""
NSQ_SOURCE_LINE 00001355 "sub exportables_by_tag {"
NSQ_SOURCE_LINE 00001356 "\tmy ( $self, $tag, $base_name ) = ( shift, @_ );"
NSQ_SOURCE_LINE 00001357 "\tmy @matched = grep {"
NSQ_SOURCE_LINE 00001358 "\t\tmy $e = $_;"
NSQ_SOURCE_LINE 00001359 "\t\tgrep $_ eq $tag, @{ $e->{tags} || [] };"
NSQ_SOURCE_LINE 00001360 "\t} @{ $self->exportables( $base_name, $tag ) };"
NSQ_SOURCE_LINE 00001361 "\treturn @matched if wantarray;"
NSQ_SOURCE_LINE 00001362 "\t_croak( 'Expected to find one exportable tagged \"%s\", found %d', $tag, scalar @matched )"
NSQ_SOURCE_LINE 00001363 "\t\tunless @matched == 1;"
