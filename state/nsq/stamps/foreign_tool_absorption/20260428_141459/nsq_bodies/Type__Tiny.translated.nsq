NSQ_SOURCE_LINE 00001593 "sub _build_util {"
NSQ_SOURCE_LINE 00001594 "\tmy ( $self, $func ) = @_;"
NSQ_SOURCE_LINE 00001595 "\tScalar::Util::weaken( my $type = $self );"
NSQ_SOURCE_LINE 00001596 "\t"
NSQ_SOURCE_LINE 00001597 "\tif ( $func eq 'grep'"
NSQ_SOURCE_LINE 00001598 "\t\t|| $func eq 'first'"
NSQ_SOURCE_LINE 00001599 "\t\t|| $func eq 'any'"
NSQ_SOURCE_LINE 00001600 "\t\t|| $func eq 'all'"
NSQ_SOURCE_LINE 00001601 "\t\t|| $func eq 'assert_any'"
NSQ_SOURCE_LINE 00001602 "\t\t|| $func eq 'assert_all' )"
NSQ_SOURCE_LINE 00001603 "\t{"
NSQ_SOURCE_LINE 00001604 "\t\tmy ( $inline, $compiled );"
NSQ_SOURCE_LINE 00001605 "\t\t"
NSQ_SOURCE_LINE 00001606 "\t\tif ( $self->can_be_inlined ) {"
NSQ_SOURCE_LINE 00001607 "\t\t\t$inline = $self->inline_check( '$_' );"
NSQ_SOURCE_LINE 00001608 "\t\t}"
NSQ_SOURCE_LINE 00001609 "\t\telse {"
NSQ_SOURCE_LINE 00001610 "\t\t\t$compiled = $self->compiled_check;"
NSQ_SOURCE_LINE 00001611 "\t\t\t$inline   = '$compiled->($_)';"
NSQ_SOURCE_LINE 00001612 "\t\t}"
NSQ_SOURCE_LINE 00001613 "\t\t"
NSQ_SOURCE_LINE 00001614 "\t\tif ( $func eq 'grep' ) {"
NSQ_SOURCE_LINE 00001615 "\t\t\treturn eval \"sub { grep { $inline } \\@_ }\";"
NSQ_SOURCE_LINE 00001616 "\t\t}"
NSQ_SOURCE_LINE 00001617 "\t\telsif ( $func eq 'first' ) {"
NSQ_SOURCE_LINE 00001618 "\t\t\treturn eval \"sub { for (\\@_) { return \\$_ if ($inline) }; undef; }\";"
NSQ_SOURCE_LINE 00001619 "\t\t}"
NSQ_SOURCE_LINE 00001620 "\t\telsif ( $func eq 'any' ) {"
NSQ_SOURCE_LINE 00001621 "\t\t\treturn eval \"sub { for (\\@_) { return !!1 if ($inline) }; !!0; }\";"
NSQ_SOURCE_LINE 00001622 "\t\t}"
NSQ_SOURCE_LINE 00001623 "\t\telsif ( $func eq 'assert_any' ) {"
NSQ_SOURCE_LINE 00001624 "\t\t\tmy $qname = B::perlstring( $self->name );"
NSQ_SOURCE_LINE 00001625 "\t\t\treturn"
NSQ_SOURCE_LINE 00001626 "\t\t\t\teval"
NSQ_SOURCE_LINE 00001627 "\t\t\t\t\"sub { for (\\@_) { return \\@_ if ($inline) }; Type::Tiny::_failed_check(\\$type, $qname, \\@_ ? \\$_[-1] : undef); }\";"
NSQ_SOURCE_LINE 00001628 "\t\t}"
NSQ_SOURCE_LINE 00001629 "\t\telsif ( $func eq 'all' ) {"
NSQ_SOURCE_LINE 00001630 "\t\t\treturn eval \"sub { for (\\@_) { return !!0 unless ($inline) }; !!1; }\";"
NSQ_SOURCE_LINE 00001631 "\t\t}"
NSQ_SOURCE_LINE 00001632 "\t\telsif ( $func eq 'assert_all' ) {"
NSQ_SOURCE_LINE 00001633 "\t\t\tmy $qname = B::perlstring( $self->name );"
NSQ_SOURCE_LINE 00001634 "\t\t\treturn"
NSQ_SOURCE_LINE 00001635 "\t\t\t\teval"
NSQ_SOURCE_LINE 00001636 "\t\t\t\t\"sub { my \\$idx = 0; for (\\@_) { Type::Tiny::_failed_check(\\$type, $qname, \\$_, varname => sprintf('\\$_[%d]', \\$idx)) unless ($inline); ++\\$idx }; \\@_; }\";"
NSQ_SOURCE_LINE 00001637 "\t\t}"
NSQ_SOURCE_LINE 00001638 "\t} #/ if ( $func eq 'grep' ||...)"
NSQ_SOURCE_LINE 00001639 "\t"
NSQ_SOURCE_LINE 00001640 "\tif ( $func eq 'map' ) {"
NSQ_SOURCE_LINE 00001641 "\t\tmy ( $inline, $compiled );"
NSQ_SOURCE_LINE 00001642 "\t\tmy $c = $self->_assert_coercion;"
NSQ_SOURCE_LINE 00001643 "\t\t"
NSQ_SOURCE_LINE 00001644 "\t\tif ( $c->can_be_inlined ) {"
NSQ_SOURCE_LINE 00001645 "\t\t\t$inline = $c->inline_coercion( '$_' );"
NSQ_SOURCE_LINE 00001646 "\t\t}"
NSQ_SOURCE_LINE 00001647 "\t\telse {"
NSQ_SOURCE_LINE 00001648 "\t\t\t$compiled = $c->compiled_coercion;"
NSQ_SOURCE_LINE 00001649 "\t\t\t$inline   = '$compiled->($_)';"
NSQ_SOURCE_LINE 00001650 "\t\t}"
NSQ_SOURCE_LINE 00001651 "\t\t"
NSQ_SOURCE_LINE 00001652 "\t\treturn eval \"sub { map { $inline } \\@_ }\";"
NSQ_SOURCE_LINE 00001653 "\t} #/ if ( $func eq 'map' )"
NSQ_SOURCE_LINE 00001654 "\t"
NSQ_SOURCE_LINE 00001655 "\tif ( $func eq 'sort' || $func eq 'rsort' ) {"
NSQ_SOURCE_LINE 00001656 "\t\tmy ( $inline, $compiled );"
NSQ_SOURCE_LINE 00001657 "\t\t"
NSQ_SOURCE_LINE 00001658 "\t\tmy $ptype = $self->find_parent( sub { $_->has_sorter } );"
NSQ_SOURCE_LINE 00001659 "\t\t_croak \"No sorter for this type constraint\" unless $ptype;"
NSQ_SOURCE_LINE 00001660 "\t\t"
NSQ_SOURCE_LINE 00001661 "\t\tmy $sorter = $ptype->sorter;"
NSQ_SOURCE_LINE 00001662 "\t\t"
NSQ_SOURCE_LINE 00001663 "\t\t# Schwarzian transformation"
NSQ_SOURCE_LINE 00001664 "\t\tif ( ref( $sorter ) eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00001665 "\t\t\tmy $sort_key;"
NSQ_SOURCE_LINE 00001666 "\t\t\t( $sorter, $sort_key ) = @$sorter;"
NSQ_SOURCE_LINE 00001667 "\t\t\t"
NSQ_SOURCE_LINE 00001668 "\t\t\tif ( $func eq 'sort' ) {"
NSQ_SOURCE_LINE 00001669 "\t\t\t\treturn"
NSQ_SOURCE_LINE 00001670 "\t\t\t\t\teval"
NSQ_SOURCE_LINE 00001671 "\t\t\t\t\t\"our (\\$a, \\$b); sub { map \\$_->[0], sort { \\$sorter->(\\$a->[1],\\$b->[1]) } map [\\$_,\\$sort_key->(\\$_)], \\@_ }\";"
NSQ_SOURCE_LINE 00001672 "\t\t\t}"
NSQ_SOURCE_LINE 00001673 "\t\t\telsif ( $func eq 'rsort' ) {"
NSQ_SOURCE_LINE 00001674 "\t\t\t\treturn"
NSQ_SOURCE_LINE 00001675 "\t\t\t\t\teval"
NSQ_SOURCE_LINE 00001676 "\t\t\t\t\t\"our (\\$a, \\$b); sub { map \\$_->[0], sort { \\$sorter->(\\$b->[1],\\$a->[1]) } map [\\$_,\\$sort_key->(\\$_)], \\@_ }\";"
NSQ_SOURCE_LINE 00001677 "\t\t\t}"
NSQ_SOURCE_LINE 00001678 "\t\t} #/ if ( ref( $sorter ) eq...)"
NSQ_SOURCE_LINE 00001679 "\t\t"
NSQ_SOURCE_LINE 00001680 "\t\t# Simple sort"
NSQ_SOURCE_LINE 00001681 "\t\telse {"
NSQ_SOURCE_LINE 00001682 "\t\t\tif ( $func eq 'sort' ) {"
NSQ_SOURCE_LINE 00001683 "\t\t\t\treturn eval \"our (\\$a, \\$b); sub { sort { \\$sorter->(\\$a,\\$b) } \\@_ }\";"
NSQ_SOURCE_LINE 00001684 "\t\t\t}"
NSQ_SOURCE_LINE 00001685 "\t\t\telsif ( $func eq 'rsort' ) {"
NSQ_SOURCE_LINE 00001686 "\t\t\t\treturn eval \"our (\\$a, \\$b); sub { sort { \\$sorter->(\\$b,\\$a) } \\@_ }\";"
NSQ_SOURCE_LINE 00001687 "\t\t\t}"
NSQ_SOURCE_LINE 00001688 "\t\t}"
NSQ_SOURCE_LINE 00001689 "\t} #/ if ( $func eq 'sort' ||...)"
NSQ_SOURCE_LINE 00001690 "\t"
NSQ_SOURCE_LINE 00001691 "\tdie \"Unknown function: $func\";"
NSQ_SOURCE_LINE 00001692 "} #/ sub _build_util"
