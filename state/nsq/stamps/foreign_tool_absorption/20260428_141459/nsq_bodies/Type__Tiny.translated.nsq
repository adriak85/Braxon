NSQ_SOURCE_LINE 00000202 "\t\t\t} #/ if ( blessed $tc[0] )"
NSQ_SOURCE_LINE 00000203 "\t\t\telsif ( ref $tc[0] eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000204 "\t\t\t\trequire Type::Tiny::_HalfOp;"
