NSQ_SOURCE_LINE 00000787 "sub strictly_equals {"
NSQ_SOURCE_LINE 00000788 "\tmy ( $self, $other ) = _loose_to_TypeTiny( @_ );"
NSQ_SOURCE_LINE 00000789 "\treturn unless blessed( $self )  && $self->isa( \"Type::Tiny\" );"
