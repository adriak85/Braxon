NSQ_SOURCE_LINE 00000208 "\t\trequire Type::Tiny::Intersection;"
NSQ_SOURCE_LINE 00000209 "\t\t\"Type::Tiny::Intersection\"->new_by_overload( type_constraints => \\@tc );"
NSQ_SOURCE_LINE 00000210 "\t},"
NSQ_SOURCE_LINE 00000211 "\tq(~)  => sub { shift->complementary_type },"
NSQ_SOURCE_LINE 00000212 "\tq(==) => sub { $_[0]->equals( $_[1] ) },"
NSQ_SOURCE_LINE 00000213 "\tq(!=) => sub { not $_[0]->equals( $_[1] ) },"
NSQ_SOURCE_LINE 00000214 "\tq(<)  => sub { my $m = $_[0]->can( 'is_subtype_of' ); $m->( _swap @_ ) },"
NSQ_SOURCE_LINE 00000215 "\tq(>)  => sub {"
NSQ_SOURCE_LINE 00000216 "\t\tmy $m = $_[0]->can( 'is_subtype_of' );"
NSQ_SOURCE_LINE 00000217 "\t\t$m->( reverse _swap @_ );"
NSQ_SOURCE_LINE 00000218 "\t},"
NSQ_SOURCE_LINE 00000219 "\tq(<=) => sub { my $m = $_[0]->can( 'is_a_type_of' ); $m->( _swap @_ ) },"
NSQ_SOURCE_LINE 00000220 "\tq(>=) => sub {"
NSQ_SOURCE_LINE 00000221 "\t\tmy $m = $_[0]->can( 'is_a_type_of' );"
NSQ_SOURCE_LINE 00000222 "\t\t$m->( reverse _swap @_ );"
NSQ_SOURCE_LINE 00000223 "\t},"
NSQ_SOURCE_LINE 00000224 "\tq(eq)  => sub { \"$_[0]\" eq \"$_[1]\" },"
NSQ_SOURCE_LINE 00000225 "\tq(cmp) => sub { $_[2] ? ( \"$_[1]\" cmp \"$_[0]\" ) : ( \"$_[0]\" cmp \"$_[1]\" ) },"
NSQ_SOURCE_LINE 00000226 "\tq(0+)  => sub { $_[0]{uniq} },"
NSQ_SOURCE_LINE 00000227 "\tq(/)   => sub { ( _STRICT_MODE xor $_[2] ) ? $_[0] : $_[1] },"
NSQ_SOURCE_LINE 00000228 ");"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "__PACKAGE__->_install_overloads("
NSQ_SOURCE_LINE 00000231 "\tq(~~) => sub { $_[0]->check( $_[1] ) },"
NSQ_SOURCE_LINE 00000232 ") if Type::Tiny::SUPPORT_SMARTMATCH;"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "# Would be easy to just return sub { $self->assert_return(@_) }"
NSQ_SOURCE_LINE 00000235 "# but try to build a more efficient coderef whenever possible."
NSQ_SOURCE_LINE 00000236 "#"
NSQ_SOURCE_LINE 00000237 "sub _overload_coderef {"
NSQ_SOURCE_LINE 00000238 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000239 "\t"
NSQ_SOURCE_LINE 00000240 "\t# Bypass generating a coderef if we've already got the best possible one."
NSQ_SOURCE_LINE 00000241 "\t#"
NSQ_SOURCE_LINE 00000242 "\treturn $self->{_overload_coderef} if $self->{_overload_coderef_no_rebuild};"
NSQ_SOURCE_LINE 00000243 "\t"
NSQ_SOURCE_LINE 00000244 "\t# Subclasses of Type::Tiny might override assert_return to do some kind"
NSQ_SOURCE_LINE 00000245 "\t# of interesting thing. In that case, we can't rely on it having identical"
NSQ_SOURCE_LINE 00000246 "\t# behaviour to Type::Tiny::inline_assert."
NSQ_SOURCE_LINE 00000247 "\t#"
NSQ_SOURCE_LINE 00000248 "\t$self->{_overrides_assert_return} ="
NSQ_SOURCE_LINE 00000249 "\t\t( $self->can( 'assert_return' ) != \\&assert_return )"
NSQ_SOURCE_LINE 00000250 "\t\tunless exists $self->{_overrides_assert_return};"
NSQ_SOURCE_LINE 00000251 "\t\t"
NSQ_SOURCE_LINE 00000252 "\tif ( $self->{_overrides_assert_return} ) {"
NSQ_SOURCE_LINE 00000253 "\t\t$self->{_overload_coderef} ||= do {"
NSQ_SOURCE_LINE 00000254 "\t\t\tScalar::Util::weaken( my $weak = $self );"
NSQ_SOURCE_LINE 00000255 "\t\t\tsub { $weak->assert_return( @_ ) };"
NSQ_SOURCE_LINE 00000256 "\t\t};"
NSQ_SOURCE_LINE 00000257 "\t\t++$self->{_overload_coderef_no_rebuild};"
NSQ_SOURCE_LINE 00000258 "\t}"
NSQ_SOURCE_LINE 00000259 "\telsif ( exists( &Sub::Quote::quote_sub ) ) {"
NSQ_SOURCE_LINE 00000260 "\t"
NSQ_SOURCE_LINE 00000261 "\t\t# Use `=` instead of `||=` because we want to overwrite non-Sub::Quote"
NSQ_SOURCE_LINE 00000262 "\t\t# coderef if possible."
NSQ_SOURCE_LINE 00000263 "\t\t$self->{_overload_coderef} = $self->can_be_inlined"
NSQ_SOURCE_LINE 00000264 "\t\t\t? Sub::Quote::quote_sub("
NSQ_SOURCE_LINE 00000265 "\t\t\t$self->inline_assert( '$_[0]' ),"
NSQ_SOURCE_LINE 00000266 "\t\t\t)"
NSQ_SOURCE_LINE 00000267 "\t\t\t: Sub::Quote::quote_sub("
NSQ_SOURCE_LINE 00000268 "\t\t\t$self->inline_assert( '$_[0]', '$type' ),"
NSQ_SOURCE_LINE 00000269 "\t\t\t{ '$type' => \\$self },"
NSQ_SOURCE_LINE 00000270 "\t\t\t);"
NSQ_SOURCE_LINE 00000271 "\t\t++$self->{_overload_coderef_no_rebuild};"
NSQ_SOURCE_LINE 00000272 "\t} #/ elsif ( exists( &Sub::Quote::quote_sub...))"
NSQ_SOURCE_LINE 00000273 "\telse {"
NSQ_SOURCE_LINE 00000274 "\t\trequire Eval::TypeTiny;"
NSQ_SOURCE_LINE 00000275 "\t\t$self->{_overload_coderef} ||= $self->can_be_inlined"
NSQ_SOURCE_LINE 00000276 "\t\t\t? Eval::TypeTiny::eval_closure("
NSQ_SOURCE_LINE 00000277 "\t\t\tsource => sprintf("
NSQ_SOURCE_LINE 00000278 "\t\t\t\t'sub { %s }', $self->inline_assert( '$_[0]', undef, no_wrapper => 1 )"
NSQ_SOURCE_LINE 00000279 "\t\t\t),"
NSQ_SOURCE_LINE 00000280 "\t\t\tdescription => sprintf( \"compiled assertion 'assert_%s'\", $self ),"
NSQ_SOURCE_LINE 00000281 "\t\t\t)"
NSQ_SOURCE_LINE 00000282 "\t\t\t: Eval::TypeTiny::eval_closure("
NSQ_SOURCE_LINE 00000283 "\t\t\tsource => sprintf("
NSQ_SOURCE_LINE 00000284 "\t\t\t\t'sub { %s }', $self->inline_assert( '$_[0]', '$type', no_wrapper => 1 )"
NSQ_SOURCE_LINE 00000285 "\t\t\t),"
NSQ_SOURCE_LINE 00000286 "\t\t\tdescription => sprintf( \"compiled assertion 'assert_%s'\", $self ),"
NSQ_SOURCE_LINE 00000287 "\t\t\tenvironment => { '$type' => \\$self },"
NSQ_SOURCE_LINE 00000288 "\t\t\t);"
NSQ_SOURCE_LINE 00000289 "\t} #/ else [ if ( $self->{_overrides_assert_return...})]"
NSQ_SOURCE_LINE 00000290 "\t"
NSQ_SOURCE_LINE 00000291 "\t$self->{_overload_coderef};"
NSQ_SOURCE_LINE 00000292 "} #/ sub _overload_coderef"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "our %ALL_TYPES;"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "my $QFS;"
NSQ_SOURCE_LINE 00000297 "my $uniq = 1;"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "sub new {"
NSQ_SOURCE_LINE 00000300 "\tmy $class  = shift;"
NSQ_SOURCE_LINE 00000301 "\tmy %params = ( @_ == 1 ) ? %{ $_[0] } : @_;"
NSQ_SOURCE_LINE 00000302 "\t"
NSQ_SOURCE_LINE 00000303 "\tfor ( qw/ name display_name library / ) {"
NSQ_SOURCE_LINE 00000304 "\t\t$params{$_} = $params{$_} . '' if defined $params{$_};"
NSQ_SOURCE_LINE 00000305 "\t}"
NSQ_SOURCE_LINE 00000306 "\t"
NSQ_SOURCE_LINE 00000307 "\tmy $level = 0;"
NSQ_SOURCE_LINE 00000308 "\twhile ( not exists $params{definition_context} and $level < 20 ) {"
NSQ_SOURCE_LINE 00000309 "\t\tour $_TT_GUTS ||= do {"
NSQ_SOURCE_LINE 00000310 "\t\t\tmy $g = join '|', map quotemeta, grep !m{^Types::}, @InternalPackages;"
NSQ_SOURCE_LINE 00000311 "\t\t\tqr/\\A(?:$g)\\z/o"
NSQ_SOURCE_LINE 00000312 "\t\t};"
NSQ_SOURCE_LINE 00000313 "\t\tmy $package = caller $level;"
NSQ_SOURCE_LINE 00000314 "\t\tif ( $package !~ $_TT_GUTS ) {"
NSQ_SOURCE_LINE 00000315 "\t\t\t@{ $params{definition_context} = {} }{ qw/ package file line / } = caller $level;"
NSQ_SOURCE_LINE 00000316 "\t\t}"
NSQ_SOURCE_LINE 00000317 "\t\t++$level;"
NSQ_SOURCE_LINE 00000318 "\t}"
NSQ_SOURCE_LINE 00000319 "\t"
NSQ_SOURCE_LINE 00000320 "\tif ( exists $params{parent} ) {"
NSQ_SOURCE_LINE 00000321 "\t\t$params{parent} ="
NSQ_SOURCE_LINE 00000322 "\t\t\tref( $params{parent} ) =~ /^Type::Tiny\\b/"
NSQ_SOURCE_LINE 00000323 "\t\t\t? $params{parent}"
NSQ_SOURCE_LINE 00000324 "\t\t\t: Types::TypeTiny::to_TypeTiny( $params{parent} );"
NSQ_SOURCE_LINE 00000325 "\t\t\t"
NSQ_SOURCE_LINE 00000326 "\t\t_croak \"Parent must be an instance of %s\", __PACKAGE__"
NSQ_SOURCE_LINE 00000327 "\t\t\tunless blessed( $params{parent} )"
NSQ_SOURCE_LINE 00000328 "\t\t\t&& $params{parent}->isa( __PACKAGE__ );"
NSQ_SOURCE_LINE 00000329 "\t\t\t"
NSQ_SOURCE_LINE 00000330 "\t\tif ( $params{parent}->deprecated and not exists $params{deprecated} ) {"
NSQ_SOURCE_LINE 00000331 "\t\t\t$params{deprecated} = 1;"
NSQ_SOURCE_LINE 00000332 "\t\t}"
NSQ_SOURCE_LINE 00000333 "\t} #/ if ( exists $params{parent...})"
NSQ_SOURCE_LINE 00000334 "\t"
NSQ_SOURCE_LINE 00000335 "\tif ( exists $params{constraint}"
NSQ_SOURCE_LINE 00000336 "\t\tand defined $params{constraint}"
NSQ_SOURCE_LINE 00000337 "\t\tand not ref $params{constraint} )"
NSQ_SOURCE_LINE 00000338 "\t{"
NSQ_SOURCE_LINE 00000339 "\t\trequire Eval::TypeTiny;"
NSQ_SOURCE_LINE 00000340 "\t\tmy $code = $params{constraint};"
NSQ_SOURCE_LINE 00000341 "\t\t$params{constraint} = Eval::TypeTiny::eval_closure("
NSQ_SOURCE_LINE 00000342 "\t\t\tsource      => sprintf( 'sub ($) { %s }', $code ),"
NSQ_SOURCE_LINE 00000343 "\t\t\tdescription => \"anonymous check\","
NSQ_SOURCE_LINE 00000344 "\t\t);"
NSQ_SOURCE_LINE 00000345 "\t\t$params{inlined} ||= sub {"
NSQ_SOURCE_LINE 00000346 "\t\t\tmy ( $type ) = @_;"
NSQ_SOURCE_LINE 00000347 "\t\t\tmy $inlined  = $_ eq '$_' ? \"do { $code }\" : \"do { local \\$_ = $_; $code }\";"
NSQ_SOURCE_LINE 00000348 "\t\t\t$type->has_parent ? ( undef, $inlined ) : $inlined;"
NSQ_SOURCE_LINE 00000349 "\t\t\t}"
NSQ_SOURCE_LINE 00000350 "\t\t\tif ( !exists $params{parent} or $params{parent}->can_be_inlined );"
NSQ_SOURCE_LINE 00000351 "\t} #/ if ( exists $params{constraint...})"
NSQ_SOURCE_LINE 00000352 "\t"
NSQ_SOURCE_LINE 00000353 "\t# canonicalize to a boolean"
NSQ_SOURCE_LINE 00000354 "\t$params{deprecated} = !!$params{deprecated};"
NSQ_SOURCE_LINE 00000355 "\t"
NSQ_SOURCE_LINE 00000356 "\t$params{name} = \"__ANON__\" unless exists $params{name};"
NSQ_SOURCE_LINE 00000357 "\t$params{uniq} = $uniq++;"
NSQ_SOURCE_LINE 00000358 "\t"
NSQ_SOURCE_LINE 00000359 "\tif ( $params{name} ne \"__ANON__\" ) {"
NSQ_SOURCE_LINE 00000360 "\t"
NSQ_SOURCE_LINE 00000361 "\t\t# First try a fast ASCII-only expression, but fall back to Unicode"
NSQ_SOURCE_LINE 00000362 "\t\t$params{name} =~ /^_{0,2}[A-Z][A-Za-z0-9_]+$/sm"
NSQ_SOURCE_LINE 00000363 "\t\t\tor eval q( use 5.008; $params{name} =~ /^_{0,2}\\p{Lu}[\\p{L}0-9_]+$/sm )"
NSQ_SOURCE_LINE 00000364 "\t\t\tor _croak '\"%s\" is not a valid type name', $params{name};"
NSQ_SOURCE_LINE 00000365 "\t}"
NSQ_SOURCE_LINE 00000366 "\t"
NSQ_SOURCE_LINE 00000367 "\tif ( exists $params{coercion} and !ref $params{coercion} and $params{coercion} )"
NSQ_SOURCE_LINE 00000368 "\t{"
NSQ_SOURCE_LINE 00000369 "\t\t$params{parent}->has_coercion"
NSQ_SOURCE_LINE 00000370 "\t\t\tor _croak"
NSQ_SOURCE_LINE 00000371 "\t\t\t\"coercion => 1 requires type to have a direct parent with a coercion\";"
NSQ_SOURCE_LINE 00000372 "\t\t\t"
NSQ_SOURCE_LINE 00000373 "\t\t$params{coercion} = $params{parent}->coercion->type_coercion_map;"
NSQ_SOURCE_LINE 00000374 "\t}"
NSQ_SOURCE_LINE 00000375 "\t"
NSQ_SOURCE_LINE 00000376 "\tif ( !exists $params{inlined}"
NSQ_SOURCE_LINE 00000377 "\t\tand exists $params{constraint}"
NSQ_SOURCE_LINE 00000378 "\t\tand ( !exists $params{parent} or $params{parent}->can_be_inlined )"
NSQ_SOURCE_LINE 00000379 "\t\tand $QFS ||= \"Sub::Quote\"->can( \"quoted_from_sub\" ) )"
NSQ_SOURCE_LINE 00000380 "\t{"
NSQ_SOURCE_LINE 00000381 "\t\tmy ( undef, $perlstring, $captures ) = @{ $QFS->( $params{constraint} ) || [] };"
NSQ_SOURCE_LINE 00000382 "\t\t"
NSQ_SOURCE_LINE 00000383 "\t\t$params{inlined} = sub {"
NSQ_SOURCE_LINE 00000384 "\t\t\tmy ( $self, $var ) = @_;"
NSQ_SOURCE_LINE 00000385 "\t\t\tmy $code = Sub::Quote::inlinify("
NSQ_SOURCE_LINE 00000386 "\t\t\t\t$perlstring,"
NSQ_SOURCE_LINE 00000387 "\t\t\t\t$var,"
NSQ_SOURCE_LINE 00000388 "\t\t\t\t$var eq q($_) ? '' : \"local \\$_ = $var;\","
NSQ_SOURCE_LINE 00000389 "\t\t\t\t1,"
NSQ_SOURCE_LINE 00000390 "\t\t\t);"
NSQ_SOURCE_LINE 00000391 "\t\t\t$code = sprintf( '%s and %s', $self->parent->inline_check( $var ), $code )"
NSQ_SOURCE_LINE 00000392 "\t\t\t\tif $self->has_parent;"
NSQ_SOURCE_LINE 00000393 "\t\t\treturn $code;"
NSQ_SOURCE_LINE 00000394 "\t\t\t}"
NSQ_SOURCE_LINE 00000395 "\t\t\tif $perlstring && !$captures;"
NSQ_SOURCE_LINE 00000396 "\t} #/ if ( !exists $params{inlined...})"
NSQ_SOURCE_LINE 00000397 "\t"
NSQ_SOURCE_LINE 00000398 "\tmy $self = bless \\%params, $class;"
NSQ_SOURCE_LINE 00000399 "\t"
NSQ_SOURCE_LINE 00000400 "\tunless ( $params{tmp} ) {"
NSQ_SOURCE_LINE 00000401 "\t\tmy $uniq = $self->{uniq};"
NSQ_SOURCE_LINE 00000402 "\t\t"
NSQ_SOURCE_LINE 00000403 "\t\t$ALL_TYPES{$uniq} = $self;"
NSQ_SOURCE_LINE 00000404 "\t\tScalar::Util::weaken( $ALL_TYPES{$uniq} );"
NSQ_SOURCE_LINE 00000405 "\t\t"
NSQ_SOURCE_LINE 00000406 "\t\tmy $tmp = $self;"
NSQ_SOURCE_LINE 00000407 "\t\tScalar::Util::weaken( $tmp );"
NSQ_SOURCE_LINE 00000408 "\t\t$Moo::HandleMoose::TYPE_MAP{ $self->_stringify_no_magic } = sub { $tmp };"
NSQ_SOURCE_LINE 00000409 "\t} #/ unless ( $params{tmp} )"
NSQ_SOURCE_LINE 00000410 "\t"
NSQ_SOURCE_LINE 00000411 "\tif ( ref( $params{coercion} ) eq q(CODE) ) {"
NSQ_SOURCE_LINE 00000412 "\t\trequire Types::Standard;"
NSQ_SOURCE_LINE 00000413 "\t\tmy $code = delete( $params{coercion} );"
NSQ_SOURCE_LINE 00000414 "\t\t$self->{coercion} = $self->_build_coercion;"
NSQ_SOURCE_LINE 00000415 "\t\t$self->coercion->add_type_coercions( Types::Standard::Any(), $code );"
NSQ_SOURCE_LINE 00000416 "\t}"
NSQ_SOURCE_LINE 00000417 "\telsif ( ref( $params{coercion} ) eq q(ARRAY) ) {"
NSQ_SOURCE_LINE 00000418 "\t\tmy $arr = delete( $params{coercion} );"
NSQ_SOURCE_LINE 00000419 "\t\t$self->{coercion} = $self->_build_coercion;"
NSQ_SOURCE_LINE 00000420 "\t\t$self->coercion->add_type_coercions( @$arr );"
NSQ_SOURCE_LINE 00000421 "\t}"
NSQ_SOURCE_LINE 00000422 "\t"
NSQ_SOURCE_LINE 00000423 "\t# Documenting this here because it's too weird to be in the pod."
NSQ_SOURCE_LINE 00000424 "\t# There's a secret attribute called \"_build_coercion\" which takes a"
NSQ_SOURCE_LINE 00000425 "\t# coderef. If present, then when $type->coercion is lazy built,"
NSQ_SOURCE_LINE 00000426 "\t# the blank Type::Coercion object gets passed to the coderef,"
NSQ_SOURCE_LINE 00000427 "\t# allowing the coderef to manipulate it a little. This is used by"
NSQ_SOURCE_LINE 00000428 "\t# Types::TypeTiny to allow it to build a coercion for the TypeTiny"
NSQ_SOURCE_LINE 00000429 "\t# type constraint without needing to load Type::Coercion yet."
NSQ_SOURCE_LINE 00000430 "\t"
NSQ_SOURCE_LINE 00000431 "\tif ( $params{my_methods} ) {"
NSQ_SOURCE_LINE 00000432 "\t\trequire Eval::TypeTiny;"
NSQ_SOURCE_LINE 00000433 "\t\tScalar::Util::reftype( $params{my_methods}{$_} ) eq 'CODE'"
NSQ_SOURCE_LINE 00000434 "\t\t\tand /\\A[^0-9\\W]\\w+\\z/"
NSQ_SOURCE_LINE 00000435 "\t\t\tand Eval::TypeTiny::set_subname("
NSQ_SOURCE_LINE 00000436 "\t\t\t\tsprintf( \"%s::my_%s\", $self->qualified_name, $_ ),"
NSQ_SOURCE_LINE 00000437 "\t\t\t\t$params{my_methods}{$_},"
NSQ_SOURCE_LINE 00000438 "\t\t\t) for keys %{ $params{my_methods} };"
NSQ_SOURCE_LINE 00000439 "\t} #/ if ( $params{my_methods...})"
NSQ_SOURCE_LINE 00000440 "\t"
NSQ_SOURCE_LINE 00000441 "\t# In general, mutating a type constraint after it's been created"
NSQ_SOURCE_LINE 00000442 "\t# is a bad idea and will probably not work. However some places are"
NSQ_SOURCE_LINE 00000443 "\t# especially harmful and can lead to confusing errors, so allow"
NSQ_SOURCE_LINE 00000444 "\t# subclasses to lock down particular keys."
NSQ_SOURCE_LINE 00000445 "\t#"
NSQ_SOURCE_LINE 00000446 "\t$self->_lockdown( sub {"
NSQ_SOURCE_LINE 00000447 "\t\t&Internals::SvREADONLY( $_, !!1 ) for @_;"
NSQ_SOURCE_LINE 00000448 "\t} );"
NSQ_SOURCE_LINE 00000449 "\t"
NSQ_SOURCE_LINE 00000450 "\treturn $self;"
NSQ_SOURCE_LINE 00000451 "} #/ sub new"
NSQ_SOURCE_LINE 00000452 ""
