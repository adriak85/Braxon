NSQ_SOURCE_LINE 00001704 "sub hand_optimized_type_constraint { shift->{hand_optimized_type_constraint} }"
NSQ_SOURCE_LINE 00001705 ""
NSQ_SOURCE_LINE 00001706 "sub has_hand_optimized_type_constraint {"
NSQ_SOURCE_LINE 00001707 "\texists( shift->{hand_optimized_type_constraint} );"
NSQ_SOURCE_LINE 00001708 "}"
NSQ_SOURCE_LINE 00001709 "sub type_parameter { ( shift->parameters || [] )->[0] }"
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 "sub parameterized_from {"
NSQ_SOURCE_LINE 00001712 "\t$_[0]->is_parameterized ? shift->parent : _croak( \"Not a parameterized type\" );"
NSQ_SOURCE_LINE 00001713 "}"
NSQ_SOURCE_LINE 00001714 "sub has_parameterized_from { $_[0]->is_parameterized }"
NSQ_SOURCE_LINE 00001715 ""
NSQ_SOURCE_LINE 00001716 "# some stuff for Mouse-compatible API"
NSQ_SOURCE_LINE 00001717 "sub __is_parameterized      { shift->is_parameterized( @_ ) }"
NSQ_SOURCE_LINE 00001718 "sub _add_type_coercions     { shift->coercion->add_type_coercions( @_ ) }"
NSQ_SOURCE_LINE 00001719 "sub _as_string              { shift->qualified_name( @_ ) }"
NSQ_SOURCE_LINE 00001720 "sub _compiled_type_coercion { shift->coercion->compiled_coercion( @_ ) }"
NSQ_SOURCE_LINE 00001721 "sub _identity               { Scalar::Util::refaddr( shift ) }"
NSQ_SOURCE_LINE 00001722 ""
NSQ_SOURCE_LINE 00001723 "sub _unite {"
NSQ_SOURCE_LINE 00001724 "\trequire Type::Tiny::Union;"
NSQ_SOURCE_LINE 00001725 "\t\"Type::Tiny::Union\"->new( type_constraints => \\@_ );"
NSQ_SOURCE_LINE 00001726 "}"
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "# Hooks for Type::Tie"
NSQ_SOURCE_LINE 00001729 "sub TIESCALAR {"
NSQ_SOURCE_LINE 00001730 "\trequire Type::Tie;"
NSQ_SOURCE_LINE 00001731 "\tunshift @_, 'Type::Tie::SCALAR';"
NSQ_SOURCE_LINE 00001732 "\tgoto \\&Type::Tie::SCALAR::TIESCALAR;"
NSQ_SOURCE_LINE 00001733 "}"
NSQ_SOURCE_LINE 00001734 ""
NSQ_SOURCE_LINE 00001735 "sub TIEARRAY {"
NSQ_SOURCE_LINE 00001736 "\trequire Type::Tie;"
NSQ_SOURCE_LINE 00001737 "\tunshift @_, 'Type::Tie::ARRAY';"
NSQ_SOURCE_LINE 00001738 "\tgoto \\&Type::Tie::ARRAY::TIEARRAY;"
NSQ_SOURCE_LINE 00001739 "}"
NSQ_SOURCE_LINE 00001740 ""
NSQ_SOURCE_LINE 00001741 "sub TIEHASH {"
NSQ_SOURCE_LINE 00001742 "\trequire Type::Tie;"
NSQ_SOURCE_LINE 00001743 "\tunshift @_, 'Type::Tie::HASH';"
NSQ_SOURCE_LINE 00001744 "\tgoto \\&Type::Tie::HASH::TIEHASH;"
NSQ_SOURCE_LINE 00001745 "}"
NSQ_SOURCE_LINE 00001746 ""
NSQ_SOURCE_LINE 00001747 "1;"
NSQ_SOURCE_LINE 00001748 ""
NSQ_SOURCE_LINE 00001749 "__END__"
NSQ_SOURCE_LINE 00001750 ""
NSQ_SOURCE_LINE 00001751 "=pod"
NSQ_SOURCE_LINE 00001752 ""
NSQ_SOURCE_LINE 00001753 "=encoding utf-8"
NSQ_SOURCE_LINE 00001754 ""
NSQ_SOURCE_LINE 00001755 "=for stopwords Moo(se)-compatible MooseX MouseX MooX Moose-compat invocant"
NSQ_SOURCE_LINE 00001756 ""
NSQ_SOURCE_LINE 00001757 "=head1 NAME"
NSQ_SOURCE_LINE 00001758 ""
NSQ_SOURCE_LINE 00001759 "Type::Tiny - tiny, yet Moo(se)-compatible type constraint"
NSQ_SOURCE_LINE 00001760 ""
NSQ_SOURCE_LINE 00001761 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 "  use v5.36;"
NSQ_SOURCE_LINE 00001764 "  "
NSQ_SOURCE_LINE 00001765 "  package Horse {"
NSQ_SOURCE_LINE 00001766 "    use Moo;"
NSQ_SOURCE_LINE 00001767 "    use Types::Standard qw( Str Int Enum ArrayRef Object );"
NSQ_SOURCE_LINE 00001768 "    use Type::Params qw( signature_for );"
NSQ_SOURCE_LINE 00001769 "    use namespace::autoclean;"
NSQ_SOURCE_LINE 00001770 "    "
NSQ_SOURCE_LINE 00001771 "    has name => ("
NSQ_SOURCE_LINE 00001772 "      is       => 'ro',"
NSQ_SOURCE_LINE 00001773 "      isa      => Str,"
NSQ_SOURCE_LINE 00001774 "      required => 1,"
NSQ_SOURCE_LINE 00001775 "    );"
NSQ_SOURCE_LINE 00001776 "    "
NSQ_SOURCE_LINE 00001777 "    has gender => ("
NSQ_SOURCE_LINE 00001778 "      is       => 'ro',"
NSQ_SOURCE_LINE 00001779 "      isa      => Enum[qw( f m )],"
NSQ_SOURCE_LINE 00001780 "    );"
NSQ_SOURCE_LINE 00001781 "    "
NSQ_SOURCE_LINE 00001782 "    has age => ("
NSQ_SOURCE_LINE 00001783 "      is       => 'rw',"
NSQ_SOURCE_LINE 00001784 "      isa      => Int->where( '$_ >= 0' ),"
NSQ_SOURCE_LINE 00001785 "    );"
NSQ_SOURCE_LINE 00001786 "    "
NSQ_SOURCE_LINE 00001787 "    has children => ("
NSQ_SOURCE_LINE 00001788 "      is       => 'ro',"
NSQ_SOURCE_LINE 00001789 "      isa      => ArrayRef[Object],"
NSQ_SOURCE_LINE 00001790 "      default  => sub { return [] },"
NSQ_SOURCE_LINE 00001791 "    );"
NSQ_SOURCE_LINE 00001792 "    "
NSQ_SOURCE_LINE 00001793 "    # method signature"
NSQ_SOURCE_LINE 00001794 "    signature_for add_child => ("
NSQ_SOURCE_LINE 00001795 "      method     => Object,"
NSQ_SOURCE_LINE 00001796 "      positional => [ Object ],"
NSQ_SOURCE_LINE 00001797 "    );"
NSQ_SOURCE_LINE 00001798 "    "
NSQ_SOURCE_LINE 00001799 "    sub add_child ( $self, $child ) {"
NSQ_SOURCE_LINE 00001800 "      push $self->children->@*, $child;"
NSQ_SOURCE_LINE 00001801 "      return $self;"
NSQ_SOURCE_LINE 00001802 "    }"
NSQ_SOURCE_LINE 00001803 "  }"
NSQ_SOURCE_LINE 00001804 "  "
NSQ_SOURCE_LINE 00001805 "  package main;"
NSQ_SOURCE_LINE 00001806 "  "
NSQ_SOURCE_LINE 00001807 "  my $boldruler = Horse->new("
NSQ_SOURCE_LINE 00001808 "    name    => \"Bold Ruler\","
NSQ_SOURCE_LINE 00001809 "    gender  => 'm',"
NSQ_SOURCE_LINE 00001810 "    age     => 16,"
NSQ_SOURCE_LINE 00001811 "  );"
NSQ_SOURCE_LINE 00001812 "  "
NSQ_SOURCE_LINE 00001813 "  my $secretariat = Horse->new("
NSQ_SOURCE_LINE 00001814 "    name    => \"Secretariat\","
NSQ_SOURCE_LINE 00001815 "    gender  => 'm',"
NSQ_SOURCE_LINE 00001816 "    age     => 0,"
NSQ_SOURCE_LINE 00001817 "  );"
NSQ_SOURCE_LINE 00001818 "  "
NSQ_SOURCE_LINE 00001819 "  $boldruler->add_child( $secretariat );"
NSQ_SOURCE_LINE 00001820 ""
NSQ_SOURCE_LINE 00001821 "=head1 STATUS"
NSQ_SOURCE_LINE 00001822 ""
NSQ_SOURCE_LINE 00001823 "This module is covered by the"
NSQ_SOURCE_LINE 00001824 "L<Type-Tiny stability policy|Type::Tiny::Manual::Policies/\"STABILITY\">."
NSQ_SOURCE_LINE 00001825 ""
NSQ_SOURCE_LINE 00001826 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00001827 ""
NSQ_SOURCE_LINE 00001828 "This documents the internals of the L<Type::Tiny> class. L<Type::Tiny::Manual>"
NSQ_SOURCE_LINE 00001829 "is a better starting place if you're new."
NSQ_SOURCE_LINE 00001830 ""
NSQ_SOURCE_LINE 00001831 "L<Type::Tiny> is a small class for creating Moose-like type constraint"
NSQ_SOURCE_LINE 00001832 "objects which are compatible with Moo, Moose and Mouse."
NSQ_SOURCE_LINE 00001833 ""
NSQ_SOURCE_LINE 00001834 "   use Scalar::Util qw(looks_like_number);"
NSQ_SOURCE_LINE 00001835 "   use Type::Tiny;"
NSQ_SOURCE_LINE 00001836 "   "
NSQ_SOURCE_LINE 00001837 "   my $NUM = \"Type::Tiny\"->new("
NSQ_SOURCE_LINE 00001838 "      name       => \"Number\","
NSQ_SOURCE_LINE 00001839 "      constraint => sub { looks_like_number($_) },"
NSQ_SOURCE_LINE 00001840 "      message    => sub { \"$_ ain't a number\" },"
NSQ_SOURCE_LINE 00001841 "   );"
NSQ_SOURCE_LINE 00001842 "   "
NSQ_SOURCE_LINE 00001843 "   package Ermintrude {"
NSQ_SOURCE_LINE 00001844 "      use Moo;"
NSQ_SOURCE_LINE 00001845 "      has favourite_number => (is => \"ro\", isa => $NUM);"
NSQ_SOURCE_LINE 00001846 "   }"
NSQ_SOURCE_LINE 00001847 "   "
NSQ_SOURCE_LINE 00001848 "   package Bullwinkle {"
NSQ_SOURCE_LINE 00001849 "      use Moose;"
NSQ_SOURCE_LINE 00001850 "      has favourite_number => (is => \"ro\", isa => $NUM);"
NSQ_SOURCE_LINE 00001851 "   }"
NSQ_SOURCE_LINE 00001852 "   "
NSQ_SOURCE_LINE 00001853 "   package Maisy {"
NSQ_SOURCE_LINE 00001854 "      use Mouse;"
NSQ_SOURCE_LINE 00001855 "      has favourite_number => (is => \"ro\", isa => $NUM);"
NSQ_SOURCE_LINE 00001856 "   }"
NSQ_SOURCE_LINE 00001857 ""
NSQ_SOURCE_LINE 00001858 "Type::Tiny conforms to L<Type::API::Constraint>,"
NSQ_SOURCE_LINE 00001859 "L<Type::API::Constraint::Coercible>,"
NSQ_SOURCE_LINE 00001860 "L<Type::API::Constraint::Constructor>, and"
NSQ_SOURCE_LINE 00001861 "L<Type::API::Constraint::Inlinable>."
NSQ_SOURCE_LINE 00001862 ""
NSQ_SOURCE_LINE 00001863 "Maybe now we won't need to have separate MooseX, MouseX and MooX versions"
NSQ_SOURCE_LINE 00001864 "of everything? We can but hope..."
NSQ_SOURCE_LINE 00001865 ""
NSQ_SOURCE_LINE 00001866 "=head2 Constructor"
NSQ_SOURCE_LINE 00001867 ""
NSQ_SOURCE_LINE 00001868 "=over"
NSQ_SOURCE_LINE 00001869 ""
NSQ_SOURCE_LINE 00001870 "=item C<< new(%attributes) >>"
NSQ_SOURCE_LINE 00001871 ""
NSQ_SOURCE_LINE 00001872 "Moose-style constructor function."
NSQ_SOURCE_LINE 00001873 ""
NSQ_SOURCE_LINE 00001874 "=back"
NSQ_SOURCE_LINE 00001875 ""
NSQ_SOURCE_LINE 00001876 "=head2 Attributes"
NSQ_SOURCE_LINE 00001877 ""
NSQ_SOURCE_LINE 00001878 "Attributes are named values that may be passed to the constructor. For"
NSQ_SOURCE_LINE 00001879 "each attribute, there is a corresponding reader method. For example:"
NSQ_SOURCE_LINE 00001880 ""
NSQ_SOURCE_LINE 00001881 "   my $type = Type::Tiny->new( name => \"Foo\" );"
NSQ_SOURCE_LINE 00001882 "   print $type->name, \"\\n\";   # says \"Foo\""
NSQ_SOURCE_LINE 00001883 ""
NSQ_SOURCE_LINE 00001884 "=head3 Important attributes"
NSQ_SOURCE_LINE 00001885 ""
NSQ_SOURCE_LINE 00001886 "These are the attributes you are likely to be most interested in"
NSQ_SOURCE_LINE 00001887 "providing when creating your own type constraints, and most interested"
NSQ_SOURCE_LINE 00001888 "in reading when dealing with type constraint objects."
NSQ_SOURCE_LINE 00001889 ""
NSQ_SOURCE_LINE 00001890 "=over"
NSQ_SOURCE_LINE 00001891 ""
NSQ_SOURCE_LINE 00001892 "=item C<< constraint >>"
NSQ_SOURCE_LINE 00001893 ""
NSQ_SOURCE_LINE 00001894 "Coderef to validate a value (C<< $_ >>) against the type constraint."
NSQ_SOURCE_LINE 00001895 "The coderef will not be called unless the value is known to pass any"
NSQ_SOURCE_LINE 00001896 "parent type constraint (see C<parent> below)."
NSQ_SOURCE_LINE 00001897 ""
NSQ_SOURCE_LINE 00001898 "Alternatively, a string of Perl code checking C<< $_ >> can be passed"
NSQ_SOURCE_LINE 00001899 "as a parameter to the constructor, and will be converted to a coderef."
NSQ_SOURCE_LINE 00001900 ""
NSQ_SOURCE_LINE 00001901 "Defaults to C<< sub { 1 } >> - i.e. a coderef that passes all values."
NSQ_SOURCE_LINE 00001902 ""
NSQ_SOURCE_LINE 00001903 "=item C<< parent >>"
NSQ_SOURCE_LINE 00001904 ""
NSQ_SOURCE_LINE 00001905 "Optional attribute; parent type constraint. For example, an \"Integer\""
NSQ_SOURCE_LINE 00001906 "type constraint might have a parent \"Number\"."
NSQ_SOURCE_LINE 00001907 ""
NSQ_SOURCE_LINE 00001908 "If provided, must be a Type::Tiny object."
NSQ_SOURCE_LINE 00001909 ""
NSQ_SOURCE_LINE 00001910 "=item C<< inlined >>"
NSQ_SOURCE_LINE 00001911 ""
NSQ_SOURCE_LINE 00001912 "A coderef which returns a string of Perl code suitable for inlining this"
NSQ_SOURCE_LINE 00001913 "type. Optional."
NSQ_SOURCE_LINE 00001914 ""
NSQ_SOURCE_LINE 00001915 "(The coderef will be called in list context and can actually return"
NSQ_SOURCE_LINE 00001916 "a list of strings which will be joined with C<< && >>. If the first item"
NSQ_SOURCE_LINE 00001917 "on the list is undef, it will be substituted with the type's parent's"
NSQ_SOURCE_LINE 00001918 "inline check.)"
NSQ_SOURCE_LINE 00001919 ""
NSQ_SOURCE_LINE 00001920 "If C<constraint> (above) is a coderef generated via L<Sub::Quote>, then"
NSQ_SOURCE_LINE 00001921 "Type::Tiny I<may> be able to automatically generate C<inlined> for you."
NSQ_SOURCE_LINE 00001922 "If C<constraint> (above) is a string, it will be able to."
NSQ_SOURCE_LINE 00001923 ""
NSQ_SOURCE_LINE 00001924 "=item C<< name >>"
NSQ_SOURCE_LINE 00001925 ""
NSQ_SOURCE_LINE 00001926 "The name of the type constraint. These need to conform to certain naming"
NSQ_SOURCE_LINE 00001927 "rules (they must begin with an uppercase letter and continue using only"
NSQ_SOURCE_LINE 00001928 "letters, digits 0-9 and underscores)."
NSQ_SOURCE_LINE 00001929 ""
NSQ_SOURCE_LINE 00001930 "Optional; if not supplied will be an anonymous type constraint."
NSQ_SOURCE_LINE 00001931 ""
NSQ_SOURCE_LINE 00001932 "=item C<< display_name >>"
NSQ_SOURCE_LINE 00001933 ""
NSQ_SOURCE_LINE 00001934 "A name to display for the type constraint when stringified. These don't"
NSQ_SOURCE_LINE 00001935 "have to conform to any naming rules. Optional; a default name will be"
NSQ_SOURCE_LINE 00001936 "calculated from the C<name>."
NSQ_SOURCE_LINE 00001937 ""
NSQ_SOURCE_LINE 00001938 "=item C<< library >>"
NSQ_SOURCE_LINE 00001939 ""
NSQ_SOURCE_LINE 00001940 "The package name of the type library this type is associated with."
NSQ_SOURCE_LINE 00001941 "Optional. Informational only: setting this attribute does not install"
NSQ_SOURCE_LINE 00001942 "the type into the package."
NSQ_SOURCE_LINE 00001943 ""
NSQ_SOURCE_LINE 00001944 "=item C<< deprecated >>"
NSQ_SOURCE_LINE 00001945 ""
NSQ_SOURCE_LINE 00001946 "Optional boolean indicating whether a type constraint is deprecated."
NSQ_SOURCE_LINE 00001947 "L<Type::Library> will issue a warning if you attempt to import a deprecated"
NSQ_SOURCE_LINE 00001948 "type constraint, but otherwise the type will continue to function as normal."
NSQ_SOURCE_LINE 00001949 "There will not be deprecation warnings every time you validate a value, for"
NSQ_SOURCE_LINE 00001950 "instance. If omitted, defaults to the parent's deprecation status (or false"
NSQ_SOURCE_LINE 00001951 "if there's no parent)."
NSQ_SOURCE_LINE 00001952 ""
NSQ_SOURCE_LINE 00001953 "=item C<< message >>"
NSQ_SOURCE_LINE 00001954 ""
NSQ_SOURCE_LINE 00001955 "Coderef that returns an error message when C<< $_ >> does not validate"
NSQ_SOURCE_LINE 00001956 "against the type constraint. Optional (there's a vaguely sensible default.)"
NSQ_SOURCE_LINE 00001957 ""
NSQ_SOURCE_LINE 00001958 "=item C<< coercion >>"
NSQ_SOURCE_LINE 00001959 ""
NSQ_SOURCE_LINE 00001960 "A L<Type::Coercion> object associated with this type."
NSQ_SOURCE_LINE 00001961 ""
NSQ_SOURCE_LINE 00001962 "Generally speaking this attribute should not be passed to the constructor;"
NSQ_SOURCE_LINE 00001963 "you should rely on the default lazily-built coercion object."
NSQ_SOURCE_LINE 00001964 ""
NSQ_SOURCE_LINE 00001965 "You may pass C<< coercion => 1 >> to the constructor to inherit coercions"
NSQ_SOURCE_LINE 00001966 "from the constraint's parent. (This requires the parent constraint to have"
NSQ_SOURCE_LINE 00001967 "a coercion.)"
NSQ_SOURCE_LINE 00001968 ""
NSQ_SOURCE_LINE 00001969 "If an arrayref is passed to the constructor (C<< coercion => [ ... ] >>),"
NSQ_SOURCE_LINE 00001970 "then the coercion object will be lazily built and this array will be fed to"
NSQ_SOURCE_LINE 00001971 "its C<add_type_coercions> method. If a coderef is passed to the constructor"
NSQ_SOURCE_LINE 00001972 "(C<< coercion => sub { ... } >>), then the coercion object will be lazily built"
NSQ_SOURCE_LINE 00001973 "and this code will be used as a coercion from B<Any>."
NSQ_SOURCE_LINE 00001974 ""
NSQ_SOURCE_LINE 00001975 "=item C<< sorter >>"
NSQ_SOURCE_LINE 00001976 ""
NSQ_SOURCE_LINE 00001977 "A coderef which can be passed two values conforming to this type constraint"
NSQ_SOURCE_LINE 00001978 "and returns -1, 0, or 1 to put them in order. Alternatively an arrayref"
NSQ_SOURCE_LINE 00001979 "containing a pair of coderefs — a sorter and a pre-processor for the"
NSQ_SOURCE_LINE 00001980 "Schwarzian transform. Optional."
NSQ_SOURCE_LINE 00001981 ""
NSQ_SOURCE_LINE 00001982 "The idea is to allow for:"
NSQ_SOURCE_LINE 00001983 ""
NSQ_SOURCE_LINE 00001984 "  @sorted = Int->sort( 2, 1, 11 );    # => 1, 2, 11"
NSQ_SOURCE_LINE 00001985 "  @sorted = Str->sort( 2, 1, 11 );    # => 1, 11, 2 "
NSQ_SOURCE_LINE 00001986 ""
NSQ_SOURCE_LINE 00001987 "=item C<< type_default >>"
NSQ_SOURCE_LINE 00001988 ""
NSQ_SOURCE_LINE 00001989 "A coderef which returns a sensible default value for this type. For example,"
NSQ_SOURCE_LINE 00001990 "for a B<Counter> type, a sensible default might be \"0\":"
NSQ_SOURCE_LINE 00001991 ""
NSQ_SOURCE_LINE 00001992 "  my $Size = Type::Tiny->new("
NSQ_SOURCE_LINE 00001993 "    name          => 'Size',"
NSQ_SOURCE_LINE 00001994 "    parent        => Types::Standard::Enum[ qw( XS S M L XL ) ],"
NSQ_SOURCE_LINE 00001995 "    type_default  => sub { return 'M'; },"
NSQ_SOURCE_LINE 00001996 "  );"
NSQ_SOURCE_LINE 00001997 "  "
NSQ_SOURCE_LINE 00001998 "  package Tshirt {"
NSQ_SOURCE_LINE 00001999 "    use Moo;"
NSQ_SOURCE_LINE 00002000 "    has size => ("
NSQ_SOURCE_LINE 00002001 "      is       => 'ro',"
NSQ_SOURCE_LINE 00002002 "      isa      => $Size,"
NSQ_SOURCE_LINE 00002003 "      default  => $Size->type_default,"
NSQ_SOURCE_LINE 00002004 "    );"
NSQ_SOURCE_LINE 00002005 "  }"
NSQ_SOURCE_LINE 00002006 ""
NSQ_SOURCE_LINE 00002007 "Child types will inherit a type default from their parent unless the child"
NSQ_SOURCE_LINE 00002008 "has a C<constraint>. If a type neither has nor inherits a type default, then"
NSQ_SOURCE_LINE 00002009 "calling C<type_default> will return undef."
NSQ_SOURCE_LINE 00002010 ""
NSQ_SOURCE_LINE 00002011 "As a special case, this:"
NSQ_SOURCE_LINE 00002012 ""
NSQ_SOURCE_LINE 00002013 "  $type->type_default( @args )"
NSQ_SOURCE_LINE 00002014 ""
NSQ_SOURCE_LINE 00002015 "Will return:"
NSQ_SOURCE_LINE 00002016 ""
NSQ_SOURCE_LINE 00002017 "  sub {"
NSQ_SOURCE_LINE 00002018 "    local $_ = \\@args;"
NSQ_SOURCE_LINE 00002019 "    $type->type_default->( @_ );"
NSQ_SOURCE_LINE 00002020 "  }"
NSQ_SOURCE_LINE 00002021 ""
NSQ_SOURCE_LINE 00002022 "Many of the types defined in L<Types::Standard> and other bundled type"
NSQ_SOURCE_LINE 00002023 "libraries have type defaults, but discovering them is left as an exercise"
NSQ_SOURCE_LINE 00002024 "for the reader."
NSQ_SOURCE_LINE 00002025 ""
NSQ_SOURCE_LINE 00002026 "=item C<< my_methods >>"
NSQ_SOURCE_LINE 00002027 ""
NSQ_SOURCE_LINE 00002028 "Experimental hashref of additional methods that can be called on the type"
NSQ_SOURCE_LINE 00002029 "constraint object."
NSQ_SOURCE_LINE 00002030 ""
NSQ_SOURCE_LINE 00002031 "=item C<< exception_class >>"
NSQ_SOURCE_LINE 00002032 ""
NSQ_SOURCE_LINE 00002033 "The class used to throw an exception when a value fails its type check."
NSQ_SOURCE_LINE 00002034 "Defaults to \"Error::TypeTiny::Assertion\", which is usually good. This class"
NSQ_SOURCE_LINE 00002035 "is expected to provide a C<throw_cb> method compatible with the method of"
NSQ_SOURCE_LINE 00002036 "that name in L<Error::TypeTiny>."
NSQ_SOURCE_LINE 00002037 ""
NSQ_SOURCE_LINE 00002038 "If a parent type constraint has a custom C<exception_class>, then this"
NSQ_SOURCE_LINE 00002039 "will be \"inherited\" by its children."
NSQ_SOURCE_LINE 00002040 ""
NSQ_SOURCE_LINE 00002041 "=back"
NSQ_SOURCE_LINE 00002042 ""
NSQ_SOURCE_LINE 00002043 "=head3 Attributes related to parameterizable and parameterized types"
NSQ_SOURCE_LINE 00002044 ""
NSQ_SOURCE_LINE 00002045 "The following additional attributes are used for parameterizable (e.g."
NSQ_SOURCE_LINE 00002046 "C<ArrayRef>) and parameterized (e.g. C<< ArrayRef[Int] >>) type"
NSQ_SOURCE_LINE 00002047 "constraints. Unlike Moose, these aren't handled by separate subclasses."
NSQ_SOURCE_LINE 00002048 ""
NSQ_SOURCE_LINE 00002049 "=over"
NSQ_SOURCE_LINE 00002050 ""
NSQ_SOURCE_LINE 00002051 "=item C<< constraint_generator >>"
NSQ_SOURCE_LINE 00002052 ""
NSQ_SOURCE_LINE 00002053 "Coderef that is called when a type constraint is parameterized. When called,"
NSQ_SOURCE_LINE 00002054 "it is passed the list of parameters, though any parameter which looks like a"
NSQ_SOURCE_LINE 00002055 "foreign type constraint (Moose type constraints, Mouse type constraints, etc,"
NSQ_SOURCE_LINE 00002056 "I<< and coderefs(!!!) >>) is first coerced to a native Type::Tiny object."
NSQ_SOURCE_LINE 00002057 ""
NSQ_SOURCE_LINE 00002058 "Note that for compatibility with the Moose API, the base type is I<not>"
NSQ_SOURCE_LINE 00002059 "passed to the constraint generator, but can be found in the package variable"
NSQ_SOURCE_LINE 00002060 "C<< $Type::Tiny::parameterize_type >>. The first parameter is also available"
NSQ_SOURCE_LINE 00002061 "as C<< $_ >>."
NSQ_SOURCE_LINE 00002062 ""
NSQ_SOURCE_LINE 00002063 "Types I<can> be parameterized with an empty parameter list. For example,"
NSQ_SOURCE_LINE 00002064 "in L<Types::Standard>, C<Tuple> is just an alias for C<ArrayRef> but"
NSQ_SOURCE_LINE 00002065 "C<< Tuple[] >> will only allow zero-length arrayrefs to pass the constraint."
NSQ_SOURCE_LINE 00002066 "If you wish C<< YourType >> and C<< YourType[] >> to mean the same thing,"
NSQ_SOURCE_LINE 00002067 "then do:"
NSQ_SOURCE_LINE 00002068 ""
NSQ_SOURCE_LINE 00002069 " return $Type::Tiny::parameterize_type unless @_;"
NSQ_SOURCE_LINE 00002070 ""
NSQ_SOURCE_LINE 00002071 "The constraint generator should generate and return a new constraint coderef"
NSQ_SOURCE_LINE 00002072 "based on the parameters. Alternatively, the constraint generator can return a"
NSQ_SOURCE_LINE 00002073 "fully-formed Type::Tiny object, in which case the C<name_generator>,"
NSQ_SOURCE_LINE 00002074 "C<inline_generator>, and C<coercion_generator> attributes documented below"
NSQ_SOURCE_LINE 00002075 "are ignored."
NSQ_SOURCE_LINE 00002076 ""
NSQ_SOURCE_LINE 00002077 "Optional; providing a generator makes this type into a parameterizable"
NSQ_SOURCE_LINE 00002078 "type constraint. If there is no generator, attempting to parameterize the"
NSQ_SOURCE_LINE 00002079 "type constraint will throw an exception."
NSQ_SOURCE_LINE 00002080 ""
NSQ_SOURCE_LINE 00002081 "=item C<< name_generator >>"
NSQ_SOURCE_LINE 00002082 ""
NSQ_SOURCE_LINE 00002083 "A coderef which generates a new display_name based on parameters. Called with"
NSQ_SOURCE_LINE 00002084 "the same parameters and package variables as the C<constraint_generator>."
NSQ_SOURCE_LINE 00002085 "Expected to return a string."
NSQ_SOURCE_LINE 00002086 ""
NSQ_SOURCE_LINE 00002087 "Optional; the default is reasonable."
NSQ_SOURCE_LINE 00002088 ""
NSQ_SOURCE_LINE 00002089 "=item C<< inline_generator >>"
NSQ_SOURCE_LINE 00002090 ""
NSQ_SOURCE_LINE 00002091 "A coderef which generates a new inlining coderef based on parameters. Called"
NSQ_SOURCE_LINE 00002092 "with the same parameters and package variables as the C<constraint_generator>."
NSQ_SOURCE_LINE 00002093 "Expected to return a coderef."
NSQ_SOURCE_LINE 00002094 ""
NSQ_SOURCE_LINE 00002095 "Optional."
NSQ_SOURCE_LINE 00002096 ""
NSQ_SOURCE_LINE 00002097 "=item C<< coercion_generator >>"
NSQ_SOURCE_LINE 00002098 ""
NSQ_SOURCE_LINE 00002099 "A coderef which generates a new L<Type::Coercion> object based on parameters."
NSQ_SOURCE_LINE 00002100 "It is passed the parent type, child type, and list of parameters. It should"
NSQ_SOURCE_LINE 00002101 "have access to the same package variables as the C<constraint_generator>."
NSQ_SOURCE_LINE 00002102 "Expected to return a blessed object."
NSQ_SOURCE_LINE 00002103 ""
NSQ_SOURCE_LINE 00002104 "Optional."
NSQ_SOURCE_LINE 00002105 ""
NSQ_SOURCE_LINE 00002106 "=item C<< deep_explanation >>"
NSQ_SOURCE_LINE 00002107 ""
NSQ_SOURCE_LINE 00002108 "This API is not finalized. Coderef used by L<Error::TypeTiny::Assertion> to"
NSQ_SOURCE_LINE 00002109 "peek inside parameterized types and figure out why a value doesn't pass the"
NSQ_SOURCE_LINE 00002110 "constraint."
NSQ_SOURCE_LINE 00002111 ""
NSQ_SOURCE_LINE 00002112 "=item C<< parameters >>"
NSQ_SOURCE_LINE 00002113 ""
NSQ_SOURCE_LINE 00002114 "In parameterized types, returns an arrayref of the parameters."
NSQ_SOURCE_LINE 00002115 ""
NSQ_SOURCE_LINE 00002116 "=back"
NSQ_SOURCE_LINE 00002117 ""
NSQ_SOURCE_LINE 00002118 "=head3 Lazy generated attributes"
NSQ_SOURCE_LINE 00002119 ""
NSQ_SOURCE_LINE 00002120 "The following attributes should not be usually passed to the constructor;"
NSQ_SOURCE_LINE 00002121 "unless you're doing something especially unusual, you should rely on the"
NSQ_SOURCE_LINE 00002122 "default lazily-built return values."
NSQ_SOURCE_LINE 00002123 ""
NSQ_SOURCE_LINE 00002124 "=over"
NSQ_SOURCE_LINE 00002125 ""
NSQ_SOURCE_LINE 00002126 "=item C<< compiled_check >>"
NSQ_SOURCE_LINE 00002127 ""
NSQ_SOURCE_LINE 00002128 "Coderef to validate a value (C<< $_[0] >>) against the type constraint."
NSQ_SOURCE_LINE 00002129 "This coderef is expected to also handle all validation for the parent"
NSQ_SOURCE_LINE 00002130 "type constraints."
NSQ_SOURCE_LINE 00002131 ""
NSQ_SOURCE_LINE 00002132 "=item C<< definition_context >>"
NSQ_SOURCE_LINE 00002133 ""
NSQ_SOURCE_LINE 00002134 "Hashref of information indicating where the type constraint was originally"
NSQ_SOURCE_LINE 00002135 "defined. Type::Tiny will generate this based on C<caller> if you do not"
NSQ_SOURCE_LINE 00002136 "supply it. The hashref will ordinarily contain keys C<\"package\">, C<\"file\">,"
NSQ_SOURCE_LINE 00002137 "and C<\"line\">."
NSQ_SOURCE_LINE 00002138 ""
NSQ_SOURCE_LINE 00002139 "For parameterized types and compound types (e.g. unions and intersections),"
NSQ_SOURCE_LINE 00002140 "this may not be especially meaningful information."
NSQ_SOURCE_LINE 00002141 ""
NSQ_SOURCE_LINE 00002142 "=item C<< complementary_type >>"
NSQ_SOURCE_LINE 00002143 ""
NSQ_SOURCE_LINE 00002144 "A complementary type for this type. For example, the complementary type"
NSQ_SOURCE_LINE 00002145 "for an integer type would be all things that are not integers, including"
NSQ_SOURCE_LINE 00002146 "floating point numbers, but also alphabetic strings, arrayrefs, filehandles,"
NSQ_SOURCE_LINE 00002147 "etc."
NSQ_SOURCE_LINE 00002148 ""
NSQ_SOURCE_LINE 00002149 "=item C<< moose_type >>, C<< mouse_type >>"
NSQ_SOURCE_LINE 00002150 ""
NSQ_SOURCE_LINE 00002151 "Objects equivalent to this type constraint, but as a"
NSQ_SOURCE_LINE 00002152 "L<Moose::Meta::TypeConstraint> or L<Mouse::Meta::TypeConstraint>."
NSQ_SOURCE_LINE 00002153 ""
NSQ_SOURCE_LINE 00002154 "It should rarely be necessary to obtain a L<Moose::Meta::TypeConstraint>"
NSQ_SOURCE_LINE 00002155 "object from L<Type::Tiny> because the L<Type::Tiny> object itself should"
NSQ_SOURCE_LINE 00002156 "be usable pretty much anywhere a L<Moose::Meta::TypeConstraint> is expected."
NSQ_SOURCE_LINE 00002157 ""
NSQ_SOURCE_LINE 00002158 "=back"
NSQ_SOURCE_LINE 00002159 ""
NSQ_SOURCE_LINE 00002160 "=head2 Methods"
NSQ_SOURCE_LINE 00002161 ""
NSQ_SOURCE_LINE 00002162 "=head3 Predicate methods"
NSQ_SOURCE_LINE 00002163 ""
NSQ_SOURCE_LINE 00002164 "These methods return booleans indicating information about the type"
NSQ_SOURCE_LINE 00002165 "constraint. They are each tightly associated with a particular attribute."
NSQ_SOURCE_LINE 00002166 "(See L</\"Attributes\">.)"
NSQ_SOURCE_LINE 00002167 ""
NSQ_SOURCE_LINE 00002168 "=over"
NSQ_SOURCE_LINE 00002169 ""
NSQ_SOURCE_LINE 00002170 "=item C<has_parent>, C<has_library>, C<has_inlined>, C<has_constraint_generator>, C<has_inline_generator>, C<has_coercion_generator>, C<has_parameters>, C<has_message>, C<has_deep_explanation>, C<has_sorter>"
NSQ_SOURCE_LINE 00002171 ""
NSQ_SOURCE_LINE 00002172 "Simple Moose-style predicate methods indicating the presence or"
NSQ_SOURCE_LINE 00002173 "absence of an attribute."
NSQ_SOURCE_LINE 00002174 ""
NSQ_SOURCE_LINE 00002175 "=item C<has_coercion>"
NSQ_SOURCE_LINE 00002176 ""
NSQ_SOURCE_LINE 00002177 "Predicate method with a little extra DWIM. Returns false if the coercion is"
NSQ_SOURCE_LINE 00002178 "a no-op."
NSQ_SOURCE_LINE 00002179 ""
NSQ_SOURCE_LINE 00002180 "=item C<< is_anon >>"
NSQ_SOURCE_LINE 00002181 ""
NSQ_SOURCE_LINE 00002182 "Returns true iff the type constraint does not have a C<name>."
NSQ_SOURCE_LINE 00002183 ""
NSQ_SOURCE_LINE 00002184 "=item C<< is_parameterized >>, C<< is_parameterizable >>"
NSQ_SOURCE_LINE 00002185 ""
NSQ_SOURCE_LINE 00002186 "Indicates whether a type has been parameterized (e.g. C<< ArrayRef[Int] >>)"
NSQ_SOURCE_LINE 00002187 "or could potentially be (e.g. C<< ArrayRef >>)."
NSQ_SOURCE_LINE 00002188 ""
NSQ_SOURCE_LINE 00002189 "=item C<< has_parameterized_from >>"
NSQ_SOURCE_LINE 00002190 ""
NSQ_SOURCE_LINE 00002191 "Useless alias for C<is_parameterized>."
NSQ_SOURCE_LINE 00002192 ""
NSQ_SOURCE_LINE 00002193 "=back"
NSQ_SOURCE_LINE 00002194 ""
NSQ_SOURCE_LINE 00002195 "=head3 Validation and coercion"
NSQ_SOURCE_LINE 00002196 ""
NSQ_SOURCE_LINE 00002197 "The following methods are used for coercing and validating values"
NSQ_SOURCE_LINE 00002198 "against a type constraint:"
NSQ_SOURCE_LINE 00002199 ""
NSQ_SOURCE_LINE 00002200 "=over"
NSQ_SOURCE_LINE 00002201 ""
NSQ_SOURCE_LINE 00002202 "=item C<< check($value) >>"
NSQ_SOURCE_LINE 00002203 ""
NSQ_SOURCE_LINE 00002204 "Returns true iff the value passes the type constraint."
NSQ_SOURCE_LINE 00002205 ""
NSQ_SOURCE_LINE 00002206 "=item C<< validate($value) >>"
NSQ_SOURCE_LINE 00002207 ""
NSQ_SOURCE_LINE 00002208 "Returns the error message for the value; returns an explicit undef if the"
NSQ_SOURCE_LINE 00002209 "value passes the type constraint."
NSQ_SOURCE_LINE 00002210 ""
NSQ_SOURCE_LINE 00002211 "=item C<< assert_valid($value) >>"
NSQ_SOURCE_LINE 00002212 ""
NSQ_SOURCE_LINE 00002213 "Like C<< check($value) >> but dies if the value does not pass the type"
NSQ_SOURCE_LINE 00002214 "constraint."
NSQ_SOURCE_LINE 00002215 ""
NSQ_SOURCE_LINE 00002216 "Yes, that's three very similar methods. Blame L<Moose::Meta::TypeConstraint>"
NSQ_SOURCE_LINE 00002217 "whose API I'm attempting to emulate. :-)"
NSQ_SOURCE_LINE 00002218 ""
NSQ_SOURCE_LINE 00002219 "=item C<< assert_return($value) >>"
NSQ_SOURCE_LINE 00002220 ""
NSQ_SOURCE_LINE 00002221 "Like C<< assert_valid($value) >> but returns the value if it passes the type"
NSQ_SOURCE_LINE 00002222 "constraint."
NSQ_SOURCE_LINE 00002223 ""
NSQ_SOURCE_LINE 00002224 "This seems a more useful behaviour than C<< assert_valid($value) >>. I would"
NSQ_SOURCE_LINE 00002225 "have just changed C<< assert_valid($value) >> to do this, except that there"
NSQ_SOURCE_LINE 00002226 "are edge cases where it could break Moose compatibility."
NSQ_SOURCE_LINE 00002227 ""
NSQ_SOURCE_LINE 00002228 "=item C<< get_message($value) >>"
NSQ_SOURCE_LINE 00002229 ""
NSQ_SOURCE_LINE 00002230 "Returns the error message for the value; even if the value passes the type"
NSQ_SOURCE_LINE 00002231 "constraint."
NSQ_SOURCE_LINE 00002232 ""
NSQ_SOURCE_LINE 00002233 "=item C<< validate_explain($value, $varname) >>"
NSQ_SOURCE_LINE 00002234 ""
NSQ_SOURCE_LINE 00002235 "Like C<validate> but instead of a string error message, returns an arrayref"
NSQ_SOURCE_LINE 00002236 "of strings explaining the reasoning why the value does not meet the type"
NSQ_SOURCE_LINE 00002237 "constraint, examining parent types, etc."
NSQ_SOURCE_LINE 00002238 ""
NSQ_SOURCE_LINE 00002239 "The C<< $varname >> is an optional string like C<< '$foo' >> indicating the"
NSQ_SOURCE_LINE 00002240 "name of the variable being checked."
NSQ_SOURCE_LINE 00002241 ""
NSQ_SOURCE_LINE 00002242 "=item C<< coerce($value) >>"
NSQ_SOURCE_LINE 00002243 ""
NSQ_SOURCE_LINE 00002244 "Attempt to coerce C<< $value >> to this type, returning the original value"
NSQ_SOURCE_LINE 00002245 "otherwise."
NSQ_SOURCE_LINE 00002246 ""
NSQ_SOURCE_LINE 00002247 "=item C<< check_coerce($value) >>"
NSQ_SOURCE_LINE 00002248 ""
NSQ_SOURCE_LINE 00002249 "Attempt to coerce C<< $value >> to this type, returning undef otherwise."
NSQ_SOURCE_LINE 00002250 ""
NSQ_SOURCE_LINE 00002251 "=item C<< assert_coerce($value) >>"
NSQ_SOURCE_LINE 00002252 ""
NSQ_SOURCE_LINE 00002253 "Attempt to coerce C<< $value >> to this type. Throws an exception if this is"
NSQ_SOURCE_LINE 00002254 "not possible."
NSQ_SOURCE_LINE 00002255 ""
NSQ_SOURCE_LINE 00002256 "=back"
NSQ_SOURCE_LINE 00002257 ""
NSQ_SOURCE_LINE 00002258 "=head3 Child type constraint creation and parameterization"
NSQ_SOURCE_LINE 00002259 ""
NSQ_SOURCE_LINE 00002260 "These methods generate new type constraint objects that inherit from the"
NSQ_SOURCE_LINE 00002261 "constraint they are called upon:"
NSQ_SOURCE_LINE 00002262 ""
NSQ_SOURCE_LINE 00002263 "=over"
NSQ_SOURCE_LINE 00002264 ""
NSQ_SOURCE_LINE 00002265 "=item C<< create_child_type(%attributes) >>"
NSQ_SOURCE_LINE 00002266 ""
NSQ_SOURCE_LINE 00002267 "Construct a new Type::Tiny object with this object as its parent."
NSQ_SOURCE_LINE 00002268 ""
NSQ_SOURCE_LINE 00002269 "=item C<< where($coderef) >>"
NSQ_SOURCE_LINE 00002270 ""
NSQ_SOURCE_LINE 00002271 "Shortcut for creating an anonymous child type constraint. Use it like"
NSQ_SOURCE_LINE 00002272 "C<< HashRef->where(sub { exists($_->{name}) }) >>. That said, you can"
NSQ_SOURCE_LINE 00002273 "get a similar result using overloaded C<< & >>:"
NSQ_SOURCE_LINE 00002274 ""
NSQ_SOURCE_LINE 00002275 "   HashRef & sub { exists($_->{name}) }"
NSQ_SOURCE_LINE 00002276 ""
NSQ_SOURCE_LINE 00002277 "Like the C<< constraint >> attribute, this will accept a string of Perl"
NSQ_SOURCE_LINE 00002278 "code:"
NSQ_SOURCE_LINE 00002279 ""
NSQ_SOURCE_LINE 00002280 "   HashRef->where('exists($_->{name})')"
NSQ_SOURCE_LINE 00002281 ""
NSQ_SOURCE_LINE 00002282 "=item C<< child_type_class >>"
NSQ_SOURCE_LINE 00002283 ""
NSQ_SOURCE_LINE 00002284 "The class that create_child_type will construct by default."
NSQ_SOURCE_LINE 00002285 ""
NSQ_SOURCE_LINE 00002286 "=item C<< parameterize(@parameters) >>"
NSQ_SOURCE_LINE 00002287 ""
NSQ_SOURCE_LINE 00002288 "Creates a new parameterized type; throws an exception if called on a"
NSQ_SOURCE_LINE 00002289 "non-parameterizable type."
NSQ_SOURCE_LINE 00002290 ""
NSQ_SOURCE_LINE 00002291 "=item C<< of(@parameters) >>"
NSQ_SOURCE_LINE 00002292 ""
NSQ_SOURCE_LINE 00002293 "A cute alias for C<parameterize>. Use it like C<< ArrayRef->of(Int) >>."
NSQ_SOURCE_LINE 00002294 ""
NSQ_SOURCE_LINE 00002295 "=item C<< plus_coercions($type1, $code1, ...) >>"
NSQ_SOURCE_LINE 00002296 ""
NSQ_SOURCE_LINE 00002297 "Shorthand for creating a new child type constraint with the same coercions"
NSQ_SOURCE_LINE 00002298 "as this one, but then adding some extra coercions (at a higher priority than"
NSQ_SOURCE_LINE 00002299 "the existing ones)."
NSQ_SOURCE_LINE 00002300 ""
NSQ_SOURCE_LINE 00002301 "=item C<< plus_fallback_coercions($type1, $code1, ...) >>"
NSQ_SOURCE_LINE 00002302 ""
NSQ_SOURCE_LINE 00002303 "Like C<plus_coercions>, but added at a lower priority."
NSQ_SOURCE_LINE 00002304 ""
NSQ_SOURCE_LINE 00002305 "=item C<< minus_coercions($type1, ...) >>"
NSQ_SOURCE_LINE 00002306 ""
NSQ_SOURCE_LINE 00002307 "Shorthand for creating a new child type constraint with fewer type coercions."
NSQ_SOURCE_LINE 00002308 ""
NSQ_SOURCE_LINE 00002309 "=item C<< no_coercions >>"
NSQ_SOURCE_LINE 00002310 ""
NSQ_SOURCE_LINE 00002311 "Shorthand for creating a new child type constraint with no coercions at all."
NSQ_SOURCE_LINE 00002312 ""
NSQ_SOURCE_LINE 00002313 "=back"
NSQ_SOURCE_LINE 00002314 ""
NSQ_SOURCE_LINE 00002315 "=head3 Type relationship introspection methods"
NSQ_SOURCE_LINE 00002316 ""
NSQ_SOURCE_LINE 00002317 "These methods allow you to determine a type constraint's relationship to"
NSQ_SOURCE_LINE 00002318 "other type constraints in an organised hierarchy:"
NSQ_SOURCE_LINE 00002319 ""
NSQ_SOURCE_LINE 00002320 "=over"
NSQ_SOURCE_LINE 00002321 ""
NSQ_SOURCE_LINE 00002322 "=item C<< equals($other) >>, C<< is_subtype_of($other) >>, C<< is_supertype_of($other) >>, C<< is_a_type_of($other) >>"
NSQ_SOURCE_LINE 00002323 ""
NSQ_SOURCE_LINE 00002324 "Compare two types. See L<Moose::Meta::TypeConstraint> for what these all mean."
NSQ_SOURCE_LINE 00002325 "(OK, Moose doesn't define C<is_supertype_of>, but you get the idea, right?)"
NSQ_SOURCE_LINE 00002326 ""
NSQ_SOURCE_LINE 00002327 "Note that these have a slightly DWIM side to them. If you create two"
NSQ_SOURCE_LINE 00002328 "L<Type::Tiny::Class> objects which test the same class, they're considered"
NSQ_SOURCE_LINE 00002329 "equal. And:"
NSQ_SOURCE_LINE 00002330 ""
NSQ_SOURCE_LINE 00002331 "   my $subtype_of_Num = Types::Standard::Num->create_child_type;"
NSQ_SOURCE_LINE 00002332 "   my $subtype_of_Int = Types::Standard::Int->create_child_type;"
NSQ_SOURCE_LINE 00002333 "   $subtype_of_Int->is_subtype_of( $subtype_of_Num );  # true"
NSQ_SOURCE_LINE 00002334 ""
NSQ_SOURCE_LINE 00002335 "=item C<< strictly_equals($other) >>, C<< is_strictly_subtype_of($other) >>, C<< is_strictly_supertype_of($other) >>, C<< is_strictly_a_type_of($other) >>"
NSQ_SOURCE_LINE 00002336 ""
NSQ_SOURCE_LINE 00002337 "Stricter versions of the type comparison functions. These only care about"
NSQ_SOURCE_LINE 00002338 "explicit inheritance via C<parent>."
NSQ_SOURCE_LINE 00002339 ""
NSQ_SOURCE_LINE 00002340 "   my $subtype_of_Num = Types::Standard::Num->create_child_type;"
NSQ_SOURCE_LINE 00002341 "   my $subtype_of_Int = Types::Standard::Int->create_child_type;"
NSQ_SOURCE_LINE 00002342 "   $subtype_of_Int->is_strictly_subtype_of( $subtype_of_Num );  # false"
NSQ_SOURCE_LINE 00002343 ""
NSQ_SOURCE_LINE 00002344 "=item C<< parents >>"
NSQ_SOURCE_LINE 00002345 ""
NSQ_SOURCE_LINE 00002346 "Returns a list of all this type constraint's ancestor constraints. For"
NSQ_SOURCE_LINE 00002347 "example, if called on the C<Str> type constraint would return the list"
NSQ_SOURCE_LINE 00002348 "C<< (Value, Defined, Item, Any) >>."
NSQ_SOURCE_LINE 00002349 ""
NSQ_SOURCE_LINE 00002350 "I<< Due to a historical misunderstanding, this differs from the Moose"
NSQ_SOURCE_LINE 00002351 "implementation of the C<parents> method. In Moose, C<parents> only returns the"
NSQ_SOURCE_LINE 00002352 "immediate parent type constraints, and because type constraints only have"
NSQ_SOURCE_LINE 00002353 "one immediate parent, this is effectively an alias for C<parent>. The"
NSQ_SOURCE_LINE 00002354 "extension module L<MooseX::Meta::TypeConstraint::Intersection> is the only"
NSQ_SOURCE_LINE 00002355 "place where multiple type constraints are returned; and they are returned"
NSQ_SOURCE_LINE 00002356 "as an arrayref in violation of the base class' documentation. I'm keeping"
NSQ_SOURCE_LINE 00002357 "my behaviour as it seems more useful. >>"
NSQ_SOURCE_LINE 00002358 ""
NSQ_SOURCE_LINE 00002359 "=item C<< find_parent($coderef) >>"
NSQ_SOURCE_LINE 00002360 ""
NSQ_SOURCE_LINE 00002361 "Loops through the parent type constraints I<< including the invocant"
NSQ_SOURCE_LINE 00002362 "itself >> and returns the nearest ancestor type constraint where the"
NSQ_SOURCE_LINE 00002363 "coderef evaluates to true. Within the coderef the ancestor currently"
NSQ_SOURCE_LINE 00002364 "being checked is C<< $_ >>. Returns undef if there is no match."
NSQ_SOURCE_LINE 00002365 ""
NSQ_SOURCE_LINE 00002366 "In list context also returns the number of type constraints which had"
NSQ_SOURCE_LINE 00002367 "been looped through before the matching constraint was found."
NSQ_SOURCE_LINE 00002368 ""
NSQ_SOURCE_LINE 00002369 "=item C<< find_constraining_type >>"
NSQ_SOURCE_LINE 00002370 ""
NSQ_SOURCE_LINE 00002371 "Finds the nearest ancestor type constraint (including the type itself)"
NSQ_SOURCE_LINE 00002372 "which has a C<constraint> coderef."
NSQ_SOURCE_LINE 00002373 ""
NSQ_SOURCE_LINE 00002374 "Equivalent to:"
NSQ_SOURCE_LINE 00002375 ""
NSQ_SOURCE_LINE 00002376 "   $type->find_parent(sub { not $_->_is_null_constraint })"
NSQ_SOURCE_LINE 00002377 ""
NSQ_SOURCE_LINE 00002378 "=item C<< coercibles >>"
NSQ_SOURCE_LINE 00002379 ""
NSQ_SOURCE_LINE 00002380 "Return a type constraint which is the union of type constraints that can be"
NSQ_SOURCE_LINE 00002381 "coerced to this one (including this one). If this type constraint has no"
NSQ_SOURCE_LINE 00002382 "coercions, returns itself."
NSQ_SOURCE_LINE 00002383 ""
NSQ_SOURCE_LINE 00002384 "=item C<< type_parameter >>"
NSQ_SOURCE_LINE 00002385 ""
NSQ_SOURCE_LINE 00002386 "In parameterized type constraints, returns the first item on the list of"
NSQ_SOURCE_LINE 00002387 "parameters; otherwise returns undef. For example:"
NSQ_SOURCE_LINE 00002388 ""
NSQ_SOURCE_LINE 00002389 "   ( ArrayRef[Int] )->type_parameter;    # returns Int"
NSQ_SOURCE_LINE 00002390 "   ( ArrayRef[Int] )->parent;            # returns ArrayRef"
NSQ_SOURCE_LINE 00002391 ""
NSQ_SOURCE_LINE 00002392 "Note that parameterizable type constraints can perfectly legitimately take"
NSQ_SOURCE_LINE 00002393 "multiple parameters (several of the parameterizable type constraints in"
NSQ_SOURCE_LINE 00002394 "L<Types::Standard> do). This method only returns the first such parameter."
NSQ_SOURCE_LINE 00002395 "L</\"Attributes related to parameterizable and parameterized types\">"
NSQ_SOURCE_LINE 00002396 "documents the C<parameters> attribute, which returns an arrayref of all"
NSQ_SOURCE_LINE 00002397 "the parameters."
NSQ_SOURCE_LINE 00002398 ""
NSQ_SOURCE_LINE 00002399 "=item C<< parameterized_from >>"
NSQ_SOURCE_LINE 00002400 ""
NSQ_SOURCE_LINE 00002401 "Harder to spell alias for C<parent> that only works for parameterized"
NSQ_SOURCE_LINE 00002402 "types."
NSQ_SOURCE_LINE 00002403 ""
NSQ_SOURCE_LINE 00002404 "=back"
NSQ_SOURCE_LINE 00002405 ""
NSQ_SOURCE_LINE 00002406 "I<< Hint for people subclassing Type::Tiny: >>"
NSQ_SOURCE_LINE 00002407 "Since version 1.006000, the methods for determining subtype, supertype, and"
NSQ_SOURCE_LINE 00002408 "type equality should I<not> be overridden in subclasses of Type::Tiny. This"
NSQ_SOURCE_LINE 00002409 "is because of the problem of diamond inheritance. If X and Y are both"
NSQ_SOURCE_LINE 00002410 "subclasses of Type::Tiny, they I<both> need to be consulted to figure out"
NSQ_SOURCE_LINE 00002411 "how type constraints are related; not just one of them should be overriding"
NSQ_SOURCE_LINE 00002412 "these methods. See the source code for L<Type::Tiny::Enum> for an example of"
NSQ_SOURCE_LINE 00002413 "how subclasses can give hints about type relationships to Type::Tiny."
NSQ_SOURCE_LINE 00002414 "Summary: push a coderef onto C<< @Type::Tiny::CMP >>. This coderef will be"
NSQ_SOURCE_LINE 00002415 "passed two type constraints. It should then return one of the constants"
NSQ_SOURCE_LINE 00002416 "Type::Tiny::CMP_SUBTYPE (first type is a subtype of second type),"
NSQ_SOURCE_LINE 00002417 "Type::Tiny::CMP_SUPERTYPE (second type is a subtype of first type),"
NSQ_SOURCE_LINE 00002418 "Type::Tiny::CMP_EQUAL (the two types are exactly the same),"
NSQ_SOURCE_LINE 00002419 "Type::Tiny::CMP_EQUIVALENT (the two types are effectively the same), or"
NSQ_SOURCE_LINE 00002420 "Type::Tiny::CMP_UNKNOWN (your coderef couldn't establish any relationship)."
NSQ_SOURCE_LINE 00002421 ""
NSQ_SOURCE_LINE 00002422 "=head3 Type relationship introspection function"
NSQ_SOURCE_LINE 00002423 ""
NSQ_SOURCE_LINE 00002424 "=over"
NSQ_SOURCE_LINE 00002425 ""
NSQ_SOURCE_LINE 00002426 "=item C<< Type::Tiny::cmp($type1, $type2) >>"
NSQ_SOURCE_LINE 00002427 ""
NSQ_SOURCE_LINE 00002428 "The subtype/supertype relationship between types results in a partial"
NSQ_SOURCE_LINE 00002429 "ordering of type constraints."
NSQ_SOURCE_LINE 00002430 ""
NSQ_SOURCE_LINE 00002431 "This function will return one of the constants:"
NSQ_SOURCE_LINE 00002432 "Type::Tiny::CMP_SUBTYPE (first type is a subtype of second type),"
NSQ_SOURCE_LINE 00002433 "Type::Tiny::CMP_SUPERTYPE (second type is a subtype of first type),"
NSQ_SOURCE_LINE 00002434 "Type::Tiny::CMP_EQUAL (the two types are exactly the same),"
NSQ_SOURCE_LINE 00002435 "Type::Tiny::CMP_EQUIVALENT (the two types are effectively the same), or"
NSQ_SOURCE_LINE 00002436 "Type::Tiny::CMP_UNKNOWN (couldn't establish any relationship)."
NSQ_SOURCE_LINE 00002437 "In numeric contexts, these evaluate to -1, 1, 0, 0, and 0, making it"
NSQ_SOURCE_LINE 00002438 "potentially usable with C<sort> (though you may need to silence warnings"
NSQ_SOURCE_LINE 00002439 "about treating the empty string as a numeric value)."
NSQ_SOURCE_LINE 00002440 ""
NSQ_SOURCE_LINE 00002441 "=back"
NSQ_SOURCE_LINE 00002442 ""
NSQ_SOURCE_LINE 00002443 "=head3 List processing methods"
NSQ_SOURCE_LINE 00002444 ""
NSQ_SOURCE_LINE 00002445 "=over"
NSQ_SOURCE_LINE 00002446 ""
NSQ_SOURCE_LINE 00002447 "=item C<< grep(@list) >>"
NSQ_SOURCE_LINE 00002448 ""
NSQ_SOURCE_LINE 00002449 "Filters a list to return just the items that pass the type check."
NSQ_SOURCE_LINE 00002450 ""
NSQ_SOURCE_LINE 00002451 "  @integers = Int->grep(@list);"
NSQ_SOURCE_LINE 00002452 ""
NSQ_SOURCE_LINE 00002453 "=item C<< first(@list) >>"
NSQ_SOURCE_LINE 00002454 ""
NSQ_SOURCE_LINE 00002455 "Filters the list to return the first item on the list that passes"
NSQ_SOURCE_LINE 00002456 "the type check, or undef if none do."
NSQ_SOURCE_LINE 00002457 ""
NSQ_SOURCE_LINE 00002458 "  $first_lady = Woman->first(@people);"
NSQ_SOURCE_LINE 00002459 ""
NSQ_SOURCE_LINE 00002460 "=item C<< map(@list) >>"
NSQ_SOURCE_LINE 00002461 ""
NSQ_SOURCE_LINE 00002462 "Coerces a list of items. Only works on types which have a coercion."
NSQ_SOURCE_LINE 00002463 ""
NSQ_SOURCE_LINE 00002464 "  @truths = Bool->map(@list);"
NSQ_SOURCE_LINE 00002465 ""
NSQ_SOURCE_LINE 00002466 "=item C<< sort(@list) >>"
NSQ_SOURCE_LINE 00002467 ""
NSQ_SOURCE_LINE 00002468 "Sorts a list of items according to the type's preferred sorting mechanism,"
NSQ_SOURCE_LINE 00002469 "or if the type doesn't have a sorter coderef, uses the parent type. If no"
NSQ_SOURCE_LINE 00002470 "ancestor type constraint has a sorter, throws an exception. The C<Str>,"
NSQ_SOURCE_LINE 00002471 "C<StrictNum>, C<LaxNum>, and C<Enum> type constraints include sorters."
NSQ_SOURCE_LINE 00002472 ""
NSQ_SOURCE_LINE 00002473 "  @sorted_numbers = Num->sort( Num->grep(@list) );"
NSQ_SOURCE_LINE 00002474 ""
NSQ_SOURCE_LINE 00002475 "=item C<< rsort(@list) >>"
NSQ_SOURCE_LINE 00002476 ""
NSQ_SOURCE_LINE 00002477 "Like C<sort> but backwards."
NSQ_SOURCE_LINE 00002478 ""
NSQ_SOURCE_LINE 00002479 "=item C<< any(@list) >>"
NSQ_SOURCE_LINE 00002480 ""
NSQ_SOURCE_LINE 00002481 "Returns true if any of the list match the type."
NSQ_SOURCE_LINE 00002482 ""
NSQ_SOURCE_LINE 00002483 "  if ( Int->any(@numbers) ) {"
NSQ_SOURCE_LINE 00002484 "    say \"there was at least one integer\";"
NSQ_SOURCE_LINE 00002485 "  }"
NSQ_SOURCE_LINE 00002486 ""
NSQ_SOURCE_LINE 00002487 "=item C<< all(@list) >>"
NSQ_SOURCE_LINE 00002488 ""
NSQ_SOURCE_LINE 00002489 "Returns true if all of the list match the type."
NSQ_SOURCE_LINE 00002490 ""
NSQ_SOURCE_LINE 00002491 "  if ( Int->all(@numbers) ) {"
NSQ_SOURCE_LINE 00002492 "    say \"they were all integers\";"
NSQ_SOURCE_LINE 00002493 "  }"
NSQ_SOURCE_LINE 00002494 ""
NSQ_SOURCE_LINE 00002495 "=item C<< assert_any(@list) >>"
NSQ_SOURCE_LINE 00002496 ""
NSQ_SOURCE_LINE 00002497 "Like C<any> but instead of returning a boolean, returns the entire original"
NSQ_SOURCE_LINE 00002498 "list if any item on it matches the type, and dies if none does."
NSQ_SOURCE_LINE 00002499 ""
NSQ_SOURCE_LINE 00002500 "=item C<< assert_all(@list) >>"
NSQ_SOURCE_LINE 00002501 ""
NSQ_SOURCE_LINE 00002502 "Like C<all> but instead of returning a boolean, returns the original list if"
NSQ_SOURCE_LINE 00002503 "all items on it match the type, but dies as soon as it finds one that does"
NSQ_SOURCE_LINE 00002504 "not."
NSQ_SOURCE_LINE 00002505 ""
NSQ_SOURCE_LINE 00002506 "=back"
NSQ_SOURCE_LINE 00002507 ""
NSQ_SOURCE_LINE 00002508 "=head3 Inlining methods"
NSQ_SOURCE_LINE 00002509 ""
NSQ_SOURCE_LINE 00002510 "=for stopwords uated"
NSQ_SOURCE_LINE 00002511 ""
NSQ_SOURCE_LINE 00002512 "The following methods are used to generate strings of Perl code which"
NSQ_SOURCE_LINE 00002513 "may be pasted into stringy C<eval>uated subs to perform type checks:"
NSQ_SOURCE_LINE 00002514 ""
NSQ_SOURCE_LINE 00002515 "=over"
NSQ_SOURCE_LINE 00002516 ""
NSQ_SOURCE_LINE 00002517 "=item C<< can_be_inlined >>"
NSQ_SOURCE_LINE 00002518 ""
NSQ_SOURCE_LINE 00002519 "Returns boolean indicating if this type can be inlined."
NSQ_SOURCE_LINE 00002520 ""
NSQ_SOURCE_LINE 00002521 "=item C<< inline_check($varname) >>"
NSQ_SOURCE_LINE 00002522 ""
NSQ_SOURCE_LINE 00002523 "Creates a type constraint check for a particular variable as a string of"
NSQ_SOURCE_LINE 00002524 "Perl code. For example:"
NSQ_SOURCE_LINE 00002525 ""
NSQ_SOURCE_LINE 00002526 "   print( Types::Standard::Num->inline_check('$foo') );"
NSQ_SOURCE_LINE 00002527 ""
NSQ_SOURCE_LINE 00002528 "prints the following output:"
NSQ_SOURCE_LINE 00002529 ""
NSQ_SOURCE_LINE 00002530 "   (!ref($foo) && Scalar::Util::looks_like_number($foo))"
NSQ_SOURCE_LINE 00002531 ""
NSQ_SOURCE_LINE 00002532 "For Moose-compat, there is an alias C<< _inline_check >> for this method."
NSQ_SOURCE_LINE 00002533 ""
NSQ_SOURCE_LINE 00002534 "=item C<< inline_assert($varname) >>"
NSQ_SOURCE_LINE 00002535 ""
NSQ_SOURCE_LINE 00002536 "Much like C<inline_check> but outputs a statement of the form:"
NSQ_SOURCE_LINE 00002537 ""
NSQ_SOURCE_LINE 00002538 "   ... or die ...;"
NSQ_SOURCE_LINE 00002539 ""
NSQ_SOURCE_LINE 00002540 "Can also be called line C<< inline_assert($varname, $typevarname, %extras) >>."
NSQ_SOURCE_LINE 00002541 "In this case, it will generate a string of code that may include"
NSQ_SOURCE_LINE 00002542 "C<< $typevarname >> which is supposed to be the name of a variable holding"
NSQ_SOURCE_LINE 00002543 "the type itself. (This is kinda complicated, but it allows a useful string"
NSQ_SOURCE_LINE 00002544 "to still be produced if the type is not inlineable.) The C<< %extras >> are"
NSQ_SOURCE_LINE 00002545 "additional options to be passed to L<Error::TypeTiny::Assertion>'s constructor"
NSQ_SOURCE_LINE 00002546 "and must be key-value pairs of strings only, no references or undefs."
NSQ_SOURCE_LINE 00002547 ""
NSQ_SOURCE_LINE 00002548 "=back"
NSQ_SOURCE_LINE 00002549 ""
NSQ_SOURCE_LINE 00002550 "=head3 Other methods"
NSQ_SOURCE_LINE 00002551 ""
NSQ_SOURCE_LINE 00002552 "=over"
NSQ_SOURCE_LINE 00002553 ""
NSQ_SOURCE_LINE 00002554 "=item C<< qualified_name >>"
NSQ_SOURCE_LINE 00002555 ""
NSQ_SOURCE_LINE 00002556 "For non-anonymous type constraints that have a library, returns a qualified"
NSQ_SOURCE_LINE 00002557 "C<< \"MyLib::MyType\" >> sort of name. Otherwise, returns the same as C<name>."
NSQ_SOURCE_LINE 00002558 ""
NSQ_SOURCE_LINE 00002559 "=item C<< isa($class) >>, C<< can($method) >>, C<< AUTOLOAD(@args) >>"
NSQ_SOURCE_LINE 00002560 ""
NSQ_SOURCE_LINE 00002561 "If Moose is loaded, then the combination of these methods is used to mock"
NSQ_SOURCE_LINE 00002562 "a Moose::Meta::TypeConstraint."
NSQ_SOURCE_LINE 00002563 ""
NSQ_SOURCE_LINE 00002564 "If Mouse is loaded, then C<isa> mocks Mouse::Meta::TypeConstraint."
NSQ_SOURCE_LINE 00002565 ""
NSQ_SOURCE_LINE 00002566 "=item C<< DOES($role) >>"
NSQ_SOURCE_LINE 00002567 ""
NSQ_SOURCE_LINE 00002568 "Overridden to advertise support for various roles."
NSQ_SOURCE_LINE 00002569 ""
NSQ_SOURCE_LINE 00002570 "See also L<Type::API::Constraint>, etc."
NSQ_SOURCE_LINE 00002571 ""
NSQ_SOURCE_LINE 00002572 "=item C<< TIESCALAR >>, C<< TIEARRAY >>, C<< TIEHASH >>"
NSQ_SOURCE_LINE 00002573 ""
NSQ_SOURCE_LINE 00002574 "These are provided as hooks that wrap L<Type::Tie>. They allow the following"
NSQ_SOURCE_LINE 00002575 "to work:"
NSQ_SOURCE_LINE 00002576 ""
NSQ_SOURCE_LINE 00002577 "   use Types::Standard qw(Int);"
NSQ_SOURCE_LINE 00002578 "   tie my @list, Int;"
NSQ_SOURCE_LINE 00002579 "   push @list, 123, 456;   # ok"
NSQ_SOURCE_LINE 00002580 "   push @list, \"Hello\";    # dies"
NSQ_SOURCE_LINE 00002581 ""
NSQ_SOURCE_LINE 00002582 "=item C<< exportables( $base_name ) >>"
NSQ_SOURCE_LINE 00002583 ""
NSQ_SOURCE_LINE 00002584 "Returns a list of the functions a type library should export if it contains"
NSQ_SOURCE_LINE 00002585 "this type constraint."
NSQ_SOURCE_LINE 00002586 ""
NSQ_SOURCE_LINE 00002587 "Example:"
NSQ_SOURCE_LINE 00002588 ""
NSQ_SOURCE_LINE 00002589 "  ["
NSQ_SOURCE_LINE 00002590 "    { name => 'Int',        tags => [ 'types' ],  code => sub { ... } },"
NSQ_SOURCE_LINE 00002591 "    { name => 'is_Int',     tags => [ 'is' ],     code => sub { ... } },"
NSQ_SOURCE_LINE 00002592 "    { name => 'assert_Int', tags => [ 'assert' ], code => sub { ... } },"
NSQ_SOURCE_LINE 00002593 "    { name => 'to_Int',     tags => [ 'to' ],     code => sub { ... } },"
NSQ_SOURCE_LINE 00002594 "  ]"
NSQ_SOURCE_LINE 00002595 ""
NSQ_SOURCE_LINE 00002596 "C<< $base_name >> is optional, but allows you to get a list of exportables"
NSQ_SOURCE_LINE 00002597 "using a specific name. This is useful if the type constraint has a name"
NSQ_SOURCE_LINE 00002598 "which wouldn't be a legal Perl function name."
NSQ_SOURCE_LINE 00002599 ""
NSQ_SOURCE_LINE 00002600 "=item C<< exportables_by_tag( $tag, $base_name ) >>"
NSQ_SOURCE_LINE 00002601 ""
NSQ_SOURCE_LINE 00002602 "Filters C<exportables> by a specific tag name. In list context, returns all"
NSQ_SOURCE_LINE 00002603 "matching exportables. In scalar context returns a single matching exportable"
NSQ_SOURCE_LINE 00002604 "and dies if multiple exportables match, or none do!"
NSQ_SOURCE_LINE 00002605 ""
NSQ_SOURCE_LINE 00002606 "=back"
NSQ_SOURCE_LINE 00002607 ""
NSQ_SOURCE_LINE 00002608 "The following methods exist for Moose/Mouse compatibility, but do not do"
NSQ_SOURCE_LINE 00002609 "anything useful."
NSQ_SOURCE_LINE 00002610 ""
NSQ_SOURCE_LINE 00002611 "=over"
NSQ_SOURCE_LINE 00002612 ""
NSQ_SOURCE_LINE 00002613 "=item C<< compile_type_constraint >>"
NSQ_SOURCE_LINE 00002614 ""
NSQ_SOURCE_LINE 00002615 "=item C<< hand_optimized_type_constraint >>"
NSQ_SOURCE_LINE 00002616 ""
NSQ_SOURCE_LINE 00002617 "=item C<< has_hand_optimized_type_constraint >>"
NSQ_SOURCE_LINE 00002618 ""
NSQ_SOURCE_LINE 00002619 "=item C<< inline_environment >>"
NSQ_SOURCE_LINE 00002620 ""
NSQ_SOURCE_LINE 00002621 "=item C<< meta >>"
NSQ_SOURCE_LINE 00002622 ""
NSQ_SOURCE_LINE 00002623 "=back"
NSQ_SOURCE_LINE 00002624 ""
NSQ_SOURCE_LINE 00002625 "=head2 Other Functions"
NSQ_SOURCE_LINE 00002626 ""
NSQ_SOURCE_LINE 00002627 "=over"
NSQ_SOURCE_LINE 00002628 ""
NSQ_SOURCE_LINE 00002629 "=item *"
NSQ_SOURCE_LINE 00002630 ""
NSQ_SOURCE_LINE 00002631 "C<< check_parameter_count_for_parameterized_type( $lib, $typename, $args, $max, $min ) >>"
NSQ_SOURCE_LINE 00002632 ""
NSQ_SOURCE_LINE 00002633 "Utility function used by some types from Types::Standard, etc."
NSQ_SOURCE_LINE 00002634 ""
NSQ_SOURCE_LINE 00002635 "Will throw a L<Error::TypeTiny::WrongNumberOfParameters> exception referencing"
NSQ_SOURCE_LINE 00002636 "C<< \"$lib::\\$typename\\[]\" >> if C<< $args >> is greater than C<< $max >> or"
NSQ_SOURCE_LINE 00002637 "less than C<< $min >>, if they're defined. If C<< $args >> is an arrayref,"
NSQ_SOURCE_LINE 00002638 "will use the length of the array."
NSQ_SOURCE_LINE 00002639 ""
NSQ_SOURCE_LINE 00002640 "=back"
NSQ_SOURCE_LINE 00002641 ""
NSQ_SOURCE_LINE 00002642 "=head2 Overloading"
NSQ_SOURCE_LINE 00002643 ""
NSQ_SOURCE_LINE 00002644 "=over"
NSQ_SOURCE_LINE 00002645 ""
NSQ_SOURCE_LINE 00002646 "=item *"
NSQ_SOURCE_LINE 00002647 ""
NSQ_SOURCE_LINE 00002648 "Stringification is overloaded to return the qualified name."
NSQ_SOURCE_LINE 00002649 ""
NSQ_SOURCE_LINE 00002650 "=item *"
NSQ_SOURCE_LINE 00002651 ""
NSQ_SOURCE_LINE 00002652 "Boolification is overloaded to always return true."
NSQ_SOURCE_LINE 00002653 ""
NSQ_SOURCE_LINE 00002654 "=item *"
NSQ_SOURCE_LINE 00002655 ""
NSQ_SOURCE_LINE 00002656 "Coderefification is overloaded to call C<assert_return>."
NSQ_SOURCE_LINE 00002657 ""
NSQ_SOURCE_LINE 00002658 "=item *"
NSQ_SOURCE_LINE 00002659 ""
NSQ_SOURCE_LINE 00002660 "On Perl 5.10.1 and above, smart match is overloaded to call C<check>."
NSQ_SOURCE_LINE 00002661 ""
NSQ_SOURCE_LINE 00002662 "=item *"
NSQ_SOURCE_LINE 00002663 ""
NSQ_SOURCE_LINE 00002664 "The C<< == >> operator is overloaded to call C<equals>."
NSQ_SOURCE_LINE 00002665 ""
NSQ_SOURCE_LINE 00002666 "=item *"
NSQ_SOURCE_LINE 00002667 ""
NSQ_SOURCE_LINE 00002668 "The C<< < >> and C<< > >> operators are overloaded to call C<is_subtype_of>"
NSQ_SOURCE_LINE 00002669 "and C<is_supertype_of>."
NSQ_SOURCE_LINE 00002670 ""
NSQ_SOURCE_LINE 00002671 "=item *"
NSQ_SOURCE_LINE 00002672 ""
NSQ_SOURCE_LINE 00002673 "The C<< ~ >> operator is overloaded to call C<complementary_type>."
NSQ_SOURCE_LINE 00002674 ""
NSQ_SOURCE_LINE 00002675 "=item *"
NSQ_SOURCE_LINE 00002676 ""
NSQ_SOURCE_LINE 00002677 "The C<< | >> operator is overloaded to build a union of two type constraints."
NSQ_SOURCE_LINE 00002678 "See L<Type::Tiny::Union>."
NSQ_SOURCE_LINE 00002679 ""
NSQ_SOURCE_LINE 00002680 "=item *"
NSQ_SOURCE_LINE 00002681 ""
NSQ_SOURCE_LINE 00002682 "The C<< & >> operator is overloaded to build the intersection of two type"
NSQ_SOURCE_LINE 00002683 "constraints. See L<Type::Tiny::Intersection>."
NSQ_SOURCE_LINE 00002684 ""
NSQ_SOURCE_LINE 00002685 "=item *"
NSQ_SOURCE_LINE 00002686 ""
NSQ_SOURCE_LINE 00002687 "The C<< / >> operator provides magical L<Devel::StrictMode> support."
NSQ_SOURCE_LINE 00002688 "If C<< $ENV{PERL_STRICT} >> (or a few other environment variables) is true,"
NSQ_SOURCE_LINE 00002689 "then it returns the left operand. Normally it returns the right operand."
NSQ_SOURCE_LINE 00002690 ""
NSQ_SOURCE_LINE 00002691 "=back"
NSQ_SOURCE_LINE 00002692 ""
NSQ_SOURCE_LINE 00002693 "Previous versions of Type::Tiny would overload the C<< + >> operator to"
NSQ_SOURCE_LINE 00002694 "call C<plus_coercions> or C<plus_fallback_coercions> as appropriate."
NSQ_SOURCE_LINE 00002695 "Support for this was dropped after 0.040."
NSQ_SOURCE_LINE 00002696 ""
NSQ_SOURCE_LINE 00002697 "=head2 Constants"
NSQ_SOURCE_LINE 00002698 ""
NSQ_SOURCE_LINE 00002699 "=over"
NSQ_SOURCE_LINE 00002700 ""
NSQ_SOURCE_LINE 00002701 "=item C<< Type::Tiny::SUPPORT_SMARTMATCH >>"
NSQ_SOURCE_LINE 00002702 ""
NSQ_SOURCE_LINE 00002703 "Indicates whether the smart match overload is supported on your"
NSQ_SOURCE_LINE 00002704 "version of Perl."
NSQ_SOURCE_LINE 00002705 ""
NSQ_SOURCE_LINE 00002706 "=back"
NSQ_SOURCE_LINE 00002707 ""
NSQ_SOURCE_LINE 00002708 "=head2 Package Variables"
NSQ_SOURCE_LINE 00002709 ""
NSQ_SOURCE_LINE 00002710 "=over"
NSQ_SOURCE_LINE 00002711 ""
NSQ_SOURCE_LINE 00002712 "=item C<< $Type::Tiny::DD >>"
NSQ_SOURCE_LINE 00002713 ""
NSQ_SOURCE_LINE 00002714 "This undef by default but may be set to a coderef that Type::Tiny"
NSQ_SOURCE_LINE 00002715 "and related modules will use to dump data structures in things like"
NSQ_SOURCE_LINE 00002716 "error messages."
NSQ_SOURCE_LINE 00002717 ""
NSQ_SOURCE_LINE 00002718 "Otherwise Type::Tiny uses it's own routine to dump data structures."
NSQ_SOURCE_LINE 00002719 "C<< $DD >> may then be set to a number to limit the lengths of the"
NSQ_SOURCE_LINE 00002720 "dumps. (Default limit is 72.)"
NSQ_SOURCE_LINE 00002721 ""
NSQ_SOURCE_LINE 00002722 "This is a package variable (rather than get/set class methods) to allow"
NSQ_SOURCE_LINE 00002723 "for easy localization."
NSQ_SOURCE_LINE 00002724 ""
NSQ_SOURCE_LINE 00002725 "=item C<< $Type::Tiny::AvoidCallbacks >>"
NSQ_SOURCE_LINE 00002726 ""
NSQ_SOURCE_LINE 00002727 "If this variable is set to true (you should usually do it in a"
NSQ_SOURCE_LINE 00002728 "C<local> scope), it acts as a hint for type constraints, when"
NSQ_SOURCE_LINE 00002729 "generating inlined code, to avoid making any callbacks to"
NSQ_SOURCE_LINE 00002730 "variables and functions defined outside the inlined code itself."
NSQ_SOURCE_LINE 00002731 ""
NSQ_SOURCE_LINE 00002732 "This should have the effect that C<< $type->inline_check('$foo') >>"
NSQ_SOURCE_LINE 00002733 "will return a string of code capable of checking the type on"
NSQ_SOURCE_LINE 00002734 "Perl installations that don't have Type::Tiny installed. This"
NSQ_SOURCE_LINE 00002735 "is intended to allow Type::Tiny to be used with things like"
NSQ_SOURCE_LINE 00002736 "L<Mite>."
NSQ_SOURCE_LINE 00002737 ""
NSQ_SOURCE_LINE 00002738 "The variable works on the honour system. Types need to explicitly"
NSQ_SOURCE_LINE 00002739 "check it and decide to generate different code based on its"
NSQ_SOURCE_LINE 00002740 "truth value. The bundled types in L<Types::Standard>,"
NSQ_SOURCE_LINE 00002741 "L<Types::Common::Numeric>, and L<Types::Common::String> all do."
NSQ_SOURCE_LINE 00002742 "(B<StrMatch> is sometimes unable to, and will issue a warning"
NSQ_SOURCE_LINE 00002743 "if it needs to rely on callbacks when asked not to.)"
NSQ_SOURCE_LINE 00002744 ""
NSQ_SOURCE_LINE 00002745 "Most normal users can ignore this."
NSQ_SOURCE_LINE 00002746 ""
NSQ_SOURCE_LINE 00002747 "=item C<< $Type::Tiny::SafePackage >>"
NSQ_SOURCE_LINE 00002748 ""
NSQ_SOURCE_LINE 00002749 "This is the string \"package Type::Tiny;\" which is sometimes inserted"
NSQ_SOURCE_LINE 00002750 "into strings of inlined code to avoid namespace clashes. In most cases,"
NSQ_SOURCE_LINE 00002751 "you do not need to change this. However, if you are inlining type"
NSQ_SOURCE_LINE 00002752 "constraint code, saving that code into Perl modules, and uploading them"
NSQ_SOURCE_LINE 00002753 "to CPAN, you may wish to change it to avoid problems with the CPAN"
NSQ_SOURCE_LINE 00002754 "indexer. Most normal users of Type::Tiny do not need to be aware of this."
NSQ_SOURCE_LINE 00002755 ""
NSQ_SOURCE_LINE 00002756 "=back"
NSQ_SOURCE_LINE 00002757 ""
NSQ_SOURCE_LINE 00002758 "=head2 Environment"
NSQ_SOURCE_LINE 00002759 ""
NSQ_SOURCE_LINE 00002760 "=over"
NSQ_SOURCE_LINE 00002761 ""
NSQ_SOURCE_LINE 00002762 "=item C<PERL_TYPE_TINY_XS>"
NSQ_SOURCE_LINE 00002763 ""
NSQ_SOURCE_LINE 00002764 "Currently this has more effect on L<Types::Standard> than Type::Tiny. In"
NSQ_SOURCE_LINE 00002765 "future it may be used to trigger or suppress the loading XS implementations"
NSQ_SOURCE_LINE 00002766 "of parts of Type::Tiny."
NSQ_SOURCE_LINE 00002767 ""
NSQ_SOURCE_LINE 00002768 "=back"
NSQ_SOURCE_LINE 00002769 ""
NSQ_SOURCE_LINE 00002770 "=head1 BUGS"
NSQ_SOURCE_LINE 00002771 ""
NSQ_SOURCE_LINE 00002772 "Please report any bugs to"
NSQ_SOURCE_LINE 00002773 "L<https://github.com/tobyink/p5-type-tiny/issues>."
NSQ_SOURCE_LINE 00002774 ""
