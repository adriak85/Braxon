NSQ_SOURCE_LINE 00001566 "\t\t}"
NSQ_SOURCE_LINE 00001567 "\t\tif ( $INC{\"Moose/Meta/TypeConstraint.pm\"} ) {"
NSQ_SOURCE_LINE 00001568 "\t\t\tmy $method = $self->moose_type->can( $m );"
NSQ_SOURCE_LINE 00001569 "\t\t\treturn $self->moose_type->$method( @_ ) if $method;"
NSQ_SOURCE_LINE 00001570 "\t\t}"
NSQ_SOURCE_LINE 00001571 "\t} #/ if ( ref( $self ) )"
NSQ_SOURCE_LINE 00001572 "\t"
NSQ_SOURCE_LINE 00001573 "\t_croak q[Can't locate object method \"%s\" via package \"%s\"], $m,"
NSQ_SOURCE_LINE 00001574 "\t\tref( $self ) || $self;"
NSQ_SOURCE_LINE 00001575 "} #/ sub AUTOLOAD"
