NSQ_SOURCE_LINE 00000614 "sub _build_compiled_check {"
NSQ_SOURCE_LINE 00000615 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000616 "\t"
NSQ_SOURCE_LINE 00000617 "\tlocal our $AvoidCallbacks = 0;"
NSQ_SOURCE_LINE 00000618 "\t"
NSQ_SOURCE_LINE 00000619 "\tif ( $self->_is_null_constraint and $self->has_parent ) {"
NSQ_SOURCE_LINE 00000620 "\t\treturn $self->parent->compiled_check;"
NSQ_SOURCE_LINE 00000621 "\t}"
NSQ_SOURCE_LINE 00000622 "\t"
NSQ_SOURCE_LINE 00000623 "\trequire Eval::TypeTiny;"
NSQ_SOURCE_LINE 00000624 "\treturn Eval::TypeTiny::eval_closure("
NSQ_SOURCE_LINE 00000625 "\t\tsource      => sprintf( 'sub ($) { %s }',      $self->inline_check( '$_[0]' ) ),"
NSQ_SOURCE_LINE 00000626 "\t\tdescription => sprintf( \"compiled check '%s'\", $self ),"
NSQ_SOURCE_LINE 00000627 "\t) if $self->can_be_inlined;"
NSQ_SOURCE_LINE 00000628 "\t"
NSQ_SOURCE_LINE 00000629 "\tmy @constraints;"
NSQ_SOURCE_LINE 00000630 "\tpush @constraints, $self->parent->compiled_check if $self->has_parent;"
NSQ_SOURCE_LINE 00000631 "\tpush @constraints, $self->constraint             if !$self->_is_null_constraint;"
NSQ_SOURCE_LINE 00000632 "\treturn $null_constraint unless @constraints;"
NSQ_SOURCE_LINE 00000633 "\t"
NSQ_SOURCE_LINE 00000634 "\treturn sub ($) {"
NSQ_SOURCE_LINE 00000635 "\t\tlocal $_ = $_[0];"
NSQ_SOURCE_LINE 00000636 "\t\tfor my $c ( @constraints ) {"
NSQ_SOURCE_LINE 00000637 "\t\t\treturn unless $c->( @_ );"
NSQ_SOURCE_LINE 00000638 "\t\t}"
NSQ_SOURCE_LINE 00000639 "\t\treturn !!1;"
NSQ_SOURCE_LINE 00000640 "\t};"
NSQ_SOURCE_LINE 00000641 "} #/ sub _build_compiled_check"
