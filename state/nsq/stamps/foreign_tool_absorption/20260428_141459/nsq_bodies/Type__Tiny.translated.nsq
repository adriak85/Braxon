NSQ_SOURCE_LINE 00000158 "\t\t\t? $_[0]->_stringify_no_magic"
NSQ_SOURCE_LINE 00000159 "\t\t\t: $_[0]->display_name;"
NSQ_SOURCE_LINE 00000160 "\t},"
NSQ_SOURCE_LINE 00000161 "\tq(bool) => sub { 1 },"
NSQ_SOURCE_LINE 00000162 "\tq(&{})  => \"_overload_coderef\","
NSQ_SOURCE_LINE 00000163 "\tq(|)    => sub {"
NSQ_SOURCE_LINE 00000164 "\t\tmy @tc = _swap @_;"
NSQ_SOURCE_LINE 00000165 "\t\tif ( !_FIXED_PRECEDENCE && $_[2] ) {"
NSQ_SOURCE_LINE 00000166 "\t\t\tif ( blessed $tc[0] ) {"
NSQ_SOURCE_LINE 00000167 "\t\t\t\tif ( blessed $tc[0] eq \"Type::Tiny::_HalfOp\" ) {"
NSQ_SOURCE_LINE 00000168 "\t\t\t\t\tmy $type  = $tc[0]->{type};"
NSQ_SOURCE_LINE 00000169 "\t\t\t\t\tmy $param = $tc[0]->{param};"
NSQ_SOURCE_LINE 00000170 "\t\t\t\t\tmy $op    = $tc[0]->{op};"
NSQ_SOURCE_LINE 00000171 "\t\t\t\t\trequire Type::Tiny::Union;"
NSQ_SOURCE_LINE 00000172 "\t\t\t\t\treturn \"Type::Tiny::_HalfOp\"->new("
NSQ_SOURCE_LINE 00000173 "\t\t\t\t\t\t$op,"
NSQ_SOURCE_LINE 00000174 "\t\t\t\t\t\t$param,"
NSQ_SOURCE_LINE 00000175 "\t\t\t\t\t\t\"Type::Tiny::Union\"->new_by_overload( type_constraints => [ $type, $tc[1] ] ),"
NSQ_SOURCE_LINE 00000176 "\t\t\t\t\t);"
NSQ_SOURCE_LINE 00000177 "\t\t\t\t} #/ if ( blessed $tc[0] eq...)"
NSQ_SOURCE_LINE 00000178 "\t\t\t} #/ if ( blessed $tc[0] )"
NSQ_SOURCE_LINE 00000179 "\t\t\telsif ( ref $tc[0] eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000180 "\t\t\t\trequire Type::Tiny::_HalfOp;"
NSQ_SOURCE_LINE 00000181 "\t\t\t\treturn \"Type::Tiny::_HalfOp\"->new( '|', @tc );"
NSQ_SOURCE_LINE 00000182 "\t\t\t}"
NSQ_SOURCE_LINE 00000183 "\t\t} #/ if ( !_FIXED_PRECEDENCE...)"
NSQ_SOURCE_LINE 00000184 "\t\trequire Type::Tiny::Union;"
NSQ_SOURCE_LINE 00000185 "\t\treturn \"Type::Tiny::Union\"->new_by_overload( type_constraints => \\@tc );"
NSQ_SOURCE_LINE 00000186 "\t},"
NSQ_SOURCE_LINE 00000187 "\tq(&) => sub {"
NSQ_SOURCE_LINE 00000188 "\t\tmy @tc = _swap @_;"
NSQ_SOURCE_LINE 00000189 "\t\tif ( !_FIXED_PRECEDENCE && $_[2] ) {"
