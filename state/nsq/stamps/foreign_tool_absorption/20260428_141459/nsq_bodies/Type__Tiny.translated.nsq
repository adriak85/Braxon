NSQ_SOURCE_LINE 00000986 "sub inline_check {"
NSQ_SOURCE_LINE 00000987 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000988 "\t_croak 'Cannot inline type constraint check for \"%s\"', $self"
NSQ_SOURCE_LINE 00000989 "\t\tunless $self->can_be_inlined;"
NSQ_SOURCE_LINE 00000990 "\t\t"
NSQ_SOURCE_LINE 00000991 "\treturn $self->parent->inline_check( @_ )"
NSQ_SOURCE_LINE 00000992 "\t\tif $self->has_parent && $self->_is_null_constraint;"
NSQ_SOURCE_LINE 00000993 "\treturn '(!!1)'"
NSQ_SOURCE_LINE 00000994 "\t\tif !$self->has_parent && $self->_is_null_constraint;"
NSQ_SOURCE_LINE 00000995 "\t\t"
NSQ_SOURCE_LINE 00000996 "\tlocal $_ = $_[0];"
NSQ_SOURCE_LINE 00000997 "\tmy @r = $self->inlined->( $self, @_ );"
NSQ_SOURCE_LINE 00000998 "\tif ( @r and not defined $r[0] ) {"
NSQ_SOURCE_LINE 00000999 "\t\t_croak 'Inlining type constraint check for \"%s\" returned undef!', $self"
NSQ_SOURCE_LINE 00001000 "\t\t\tunless $self->has_parent;"
NSQ_SOURCE_LINE 00001001 "\t\t$r[0] = $self->parent->inline_check( @_ );"
NSQ_SOURCE_LINE 00001002 "\t}"
NSQ_SOURCE_LINE 00001003 "\tmy $r = join \" && \" => map {"
NSQ_SOURCE_LINE 00001004 "\t\t/\\A(?:[A-Z](?:\\w)*::[A-Z](?:\\w|::)*)\\(\\$\\w+(?:\\[\\d+\\]|\\{[^}]+\\})?\\)\\z/i ? $_ :"
NSQ_SOURCE_LINE 00001005 "\t\t/[;{}]/ && !/\\Ado \\{.+\\}\\z/ ? \"do { $SafePackage $_ }\" :"
NSQ_SOURCE_LINE 00001006 "\t\t\"($_)\""
NSQ_SOURCE_LINE 00001007 "\t} @r;"
NSQ_SOURCE_LINE 00001008 "\treturn @r == 1 ? $r : \"($r)\";"
NSQ_SOURCE_LINE 00001009 "} #/ sub inline_check"
