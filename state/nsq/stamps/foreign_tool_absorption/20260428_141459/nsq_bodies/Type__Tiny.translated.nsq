NSQ_SOURCE_LINE 00001011 "sub inline_assert {"
NSQ_SOURCE_LINE 00001012 "\trequire B;"
NSQ_SOURCE_LINE 00001013 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00001014 "\tmy ( $varname, $typevarname, %extras ) = @_;"
NSQ_SOURCE_LINE 00001015 "\t"
NSQ_SOURCE_LINE 00001016 "\t$extras{exception_class} ||= $self->exception_class;"
NSQ_SOURCE_LINE 00001017 "\t"
NSQ_SOURCE_LINE 00001018 "\tmy $inline_check;"
NSQ_SOURCE_LINE 00001019 "\tif ( $self->can_be_inlined ) {"
NSQ_SOURCE_LINE 00001020 "\t\t$inline_check = sprintf( '(%s)', $self->inline_check( $varname ) );"
NSQ_SOURCE_LINE 00001021 "\t}"
NSQ_SOURCE_LINE 00001022 "\telsif ( $typevarname ) {"
NSQ_SOURCE_LINE 00001023 "\t\t$inline_check = sprintf( '%s->check(%s)', $typevarname, $varname );"
NSQ_SOURCE_LINE 00001024 "\t}"
NSQ_SOURCE_LINE 00001025 "\telse {"
NSQ_SOURCE_LINE 00001026 "\t\t_croak 'Cannot inline type constraint check for \"%s\"', $self;"
NSQ_SOURCE_LINE 00001027 "\t}"
NSQ_SOURCE_LINE 00001028 "\t"
NSQ_SOURCE_LINE 00001029 "\tmy $do_wrapper = !delete $extras{no_wrapper};"
NSQ_SOURCE_LINE 00001030 "\t"
NSQ_SOURCE_LINE 00001031 "\tmy $inline_throw;"
NSQ_SOURCE_LINE 00001032 "\tif ( $typevarname ) {"
NSQ_SOURCE_LINE 00001033 "\t\t$inline_throw = sprintf("
NSQ_SOURCE_LINE 00001034 "\t\t\t'Type::Tiny::_failed_check(%s, %s, %s, %s)',"
NSQ_SOURCE_LINE 00001035 "\t\t\t$typevarname,"
NSQ_SOURCE_LINE 00001036 "\t\t\tB::perlstring( \"$self\" ),"
NSQ_SOURCE_LINE 00001037 "\t\t\t$varname,"
NSQ_SOURCE_LINE 00001038 "\t\t\tjoin("
NSQ_SOURCE_LINE 00001039 "\t\t\t\t',', map +( B::perlstring( $_ ) => B::perlstring( $extras{$_} ) ),"
NSQ_SOURCE_LINE 00001040 "\t\t\t\tsort keys %extras"
NSQ_SOURCE_LINE 00001041 "\t\t\t),"
NSQ_SOURCE_LINE 00001042 "\t\t);"
NSQ_SOURCE_LINE 00001043 "\t} #/ if ( $typevarname )"
NSQ_SOURCE_LINE 00001044 "\telse {"
NSQ_SOURCE_LINE 00001045 "\t\t$inline_throw = sprintf("
NSQ_SOURCE_LINE 00001046 "\t\t\t'Type::Tiny::_failed_check(%s, %s, %s, %s)',"
NSQ_SOURCE_LINE 00001047 "\t\t\t$self->{uniq},"
NSQ_SOURCE_LINE 00001048 "\t\t\tB::perlstring( \"$self\" ),"
NSQ_SOURCE_LINE 00001049 "\t\t\t$varname,"
NSQ_SOURCE_LINE 00001050 "\t\t\tjoin("
NSQ_SOURCE_LINE 00001051 "\t\t\t\t',', map +( B::perlstring( $_ ) => B::perlstring( $extras{$_} ) ),"
NSQ_SOURCE_LINE 00001052 "\t\t\t\tsort keys %extras"
NSQ_SOURCE_LINE 00001053 "\t\t\t),"
NSQ_SOURCE_LINE 00001054 "\t\t);"
NSQ_SOURCE_LINE 00001055 "\t} #/ else [ if ( $typevarname ) ]"
NSQ_SOURCE_LINE 00001056 "\t"
NSQ_SOURCE_LINE 00001057 "\t$do_wrapper"
NSQ_SOURCE_LINE 00001058 "\t\t? qq[do { no warnings \"void\"; $SafePackage $inline_check or $inline_throw; $varname };]"
NSQ_SOURCE_LINE 00001059 "\t\t: qq[     no warnings \"void\"; $SafePackage $inline_check or $inline_throw; $varname   ];"
NSQ_SOURCE_LINE 00001060 "} #/ sub inline_assert"
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "sub _failed_check {"
NSQ_SOURCE_LINE 00001063 "\tmy ( $self, $name, $value, %attrs ) = @_;"
NSQ_SOURCE_LINE 00001064 "\t$self = $ALL_TYPES{$self} if defined $self && !ref $self;"
NSQ_SOURCE_LINE 00001065 "\t"
NSQ_SOURCE_LINE 00001066 "\tmy $exception_class = delete( $attrs{exception_class} )"
NSQ_SOURCE_LINE 00001067 "\t\t|| ( ref $self ? $self->exception_class : 'Error::TypeTiny::Assertion' );"
NSQ_SOURCE_LINE 00001068 "\tmy $callback = delete( $attrs{on_die} );"
NSQ_SOURCE_LINE 00001069 ""
NSQ_SOURCE_LINE 00001070 "\tif ( $self ) {"
NSQ_SOURCE_LINE 00001071 "\t\treturn $exception_class->throw_cb("
NSQ_SOURCE_LINE 00001072 "\t\t\t$callback,"
NSQ_SOURCE_LINE 00001073 "\t\t\tmessage => $self->get_message( $value ),"
NSQ_SOURCE_LINE 00001074 "\t\t\ttype    => $self,"
NSQ_SOURCE_LINE 00001075 "\t\t\tvalue   => $value,"
NSQ_SOURCE_LINE 00001076 "\t\t\t%attrs,"
NSQ_SOURCE_LINE 00001077 "\t\t);"
NSQ_SOURCE_LINE 00001078 "\t}"
NSQ_SOURCE_LINE 00001079 "\telse {"
NSQ_SOURCE_LINE 00001080 "\t\treturn $exception_class->throw_cb("
NSQ_SOURCE_LINE 00001081 "\t\t\t$callback,"
NSQ_SOURCE_LINE 00001082 "\t\t\tmessage => sprintf( '%s did not pass type constraint \"%s\"', _dd( $value ), $name ),"
NSQ_SOURCE_LINE 00001083 "\t\t\tvalue => $value,"
NSQ_SOURCE_LINE 00001084 "\t\t\t%attrs,"
NSQ_SOURCE_LINE 00001085 "\t\t);"
NSQ_SOURCE_LINE 00001086 "\t}"
NSQ_SOURCE_LINE 00001087 "} #/ sub _failed_check"
