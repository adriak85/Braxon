NSQ_SOURCE_LINE 00000795 "\tmy ( $self, $other ) = _loose_to_TypeTiny( @_ );"
NSQ_SOURCE_LINE 00000796 "\treturn unless blessed( $self )  && $self->isa( \"Type::Tiny\" );"
NSQ_SOURCE_LINE 00000797 "\treturn unless blessed( $other ) && $other->isa( \"Type::Tiny\" );"
