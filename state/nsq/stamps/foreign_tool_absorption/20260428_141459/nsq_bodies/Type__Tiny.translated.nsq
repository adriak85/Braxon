NSQ_SOURCE_LINE 00000907 "\t\treturn ["
NSQ_SOURCE_LINE 00000908 "\t\t\tsprintf( '\"%s\" is a subtype of \"%s\"', $self, $self->parent ),"
NSQ_SOURCE_LINE 00000909 "\t\t\t@$parent"
NSQ_SOURCE_LINE 00000910 "\t\t\t]"
NSQ_SOURCE_LINE 00000911 "\t\t\tif $parent;"
NSQ_SOURCE_LINE 00000912 "\t}"
NSQ_SOURCE_LINE 00000913 "\t"
NSQ_SOURCE_LINE 00000914 "\tmy $message = sprintf("
NSQ_SOURCE_LINE 00000915 "\t\t'%s%s',"
NSQ_SOURCE_LINE 00000916 "\t\t$self->get_message( $value ),"
NSQ_SOURCE_LINE 00000917 "\t\t$varname eq q{$_} ? '' : sprintf( ' (in %s)', $varname ),"
NSQ_SOURCE_LINE 00000918 "\t);"
NSQ_SOURCE_LINE 00000919 "\t"
NSQ_SOURCE_LINE 00000920 "\tif ( $self->is_parameterized and $self->parent->has_deep_explanation ) {"
NSQ_SOURCE_LINE 00000921 "\t\tmy $deep = $self->parent->deep_explanation->( $self, $value, $varname );"
NSQ_SOURCE_LINE 00000922 "\t\treturn [ $message, @$deep ] if $deep;"
NSQ_SOURCE_LINE 00000923 "\t}"
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "\tlocal $SIG{__WARN__} = sub {};"
NSQ_SOURCE_LINE 00000926 "\treturn ["
NSQ_SOURCE_LINE 00000927 "\t\t$message,"
NSQ_SOURCE_LINE 00000928 "\t\tsprintf( '\"%s\" is defined as: %s', $self, $self->_perlcode )"
NSQ_SOURCE_LINE 00000929 "\t];"
NSQ_SOURCE_LINE 00000930 "} #/ sub validate_explain"
