NSQ_SOURCE_LINE 00000478 "sub _dd {"
NSQ_SOURCE_LINE 00000479 "\t@_ = $_ unless @_;"
NSQ_SOURCE_LINE 00000480 "\tmy ( $value ) = @_;"
NSQ_SOURCE_LINE 00000481 "\t"
NSQ_SOURCE_LINE 00000482 "\tgoto $DD if ref( $DD ) eq q(CODE);"
NSQ_SOURCE_LINE 00000483 "\t"
NSQ_SOURCE_LINE 00000484 "\trequire B;"
NSQ_SOURCE_LINE 00000485 "\t"
NSQ_SOURCE_LINE 00000486 "\t!defined $value  ? 'Undef'"
NSQ_SOURCE_LINE 00000487 "\t\t: !ref $value ? sprintf( 'Value %s', B::perlstring( $value ) )"
NSQ_SOURCE_LINE 00000488 "\t\t: do {"
NSQ_SOURCE_LINE 00000489 "\t\tmy $N = 0+ ( defined( $DD ) ? $DD : 72 );"
NSQ_SOURCE_LINE 00000490 "\t\trequire Data::Dumper;"
NSQ_SOURCE_LINE 00000491 "\t\tlocal $Data::Dumper::Indent   = 0;"
NSQ_SOURCE_LINE 00000492 "\t\tlocal $Data::Dumper::Useqq    = 1;"
NSQ_SOURCE_LINE 00000493 "\t\tlocal $Data::Dumper::Terse    = 1;"
NSQ_SOURCE_LINE 00000494 "\t\tlocal $Data::Dumper::Sortkeys = 1;"
NSQ_SOURCE_LINE 00000495 "\t\tlocal $Data::Dumper::Maxdepth = 2;"
NSQ_SOURCE_LINE 00000496 "\t\tmy $str;"
NSQ_SOURCE_LINE 00000497 "\t\teval {"
NSQ_SOURCE_LINE 00000498 "\t\t\tlocal $SIG{__WARN__} = sub {};"
NSQ_SOURCE_LINE 00000499 "\t\t\t$str = Data::Dumper::Dumper( $value );"
NSQ_SOURCE_LINE 00000500 "\t\t\t$str = substr( $str, 0, $N - 12 ) . '...' . substr( $str, -1, 1 )"
NSQ_SOURCE_LINE 00000501 "\t\t\t\tif length( $str ) >= $N;"
NSQ_SOURCE_LINE 00000502 "\t\t\t1;"
NSQ_SOURCE_LINE 00000503 "\t\t} or do { $str = 'which cannot be dumped' };"
NSQ_SOURCE_LINE 00000504 "\t\t\"Reference $str\";"
NSQ_SOURCE_LINE 00000505 "\t} #/ do"
NSQ_SOURCE_LINE 00000506 "} #/ sub _dd"
NSQ_SOURCE_LINE 00000507 ""
