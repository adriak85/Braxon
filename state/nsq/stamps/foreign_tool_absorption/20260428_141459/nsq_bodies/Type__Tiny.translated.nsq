NSQ_SOURCE_LINE 00001109 "sub is_parameterizable {"
NSQ_SOURCE_LINE 00001110 "\tshift->has_constraint_generator;"
NSQ_SOURCE_LINE 00001111 "}"
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "sub is_parameterized {"
