NSQ_SOURCE_LINE 00000681 "our @CMP;"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "sub CMP_SUPERTYPE ()  { -1 }"
NSQ_SOURCE_LINE 00000684 "sub CMP_EQUAL ()      { 0 }"
NSQ_SOURCE_LINE 00000685 "sub CMP_EQUIVALENT () { '0E0' }"
NSQ_SOURCE_LINE 00000686 "sub CMP_SUBTYPE ()    { 1 }"
NSQ_SOURCE_LINE 00000687 "sub CMP_UNKNOWN ()    { ''; }"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "# avoid getting mixed up with cmp operator at compile time"
NSQ_SOURCE_LINE 00000690 "*cmp = sub {"
NSQ_SOURCE_LINE 00000691 "\tmy ( $A, $B ) = _loose_to_TypeTiny( $_[0], $_[1] );"
NSQ_SOURCE_LINE 00000692 "\treturn unless blessed( $A ) && $A->isa( \"Type::Tiny\" );"
NSQ_SOURCE_LINE 00000693 "\treturn unless blessed( $B ) && $B->isa( \"Type::Tiny\" );"
NSQ_SOURCE_LINE 00000694 "\tfor my $comparator ( @CMP ) {"
NSQ_SOURCE_LINE 00000695 "\t\tmy $result = $comparator->( $A, $B );"
NSQ_SOURCE_LINE 00000696 "\t\tnext if $result eq CMP_UNKNOWN;"
NSQ_SOURCE_LINE 00000697 "\t\tif ( $result eq CMP_EQUIVALENT ) {"
NSQ_SOURCE_LINE 00000698 "\t\t\tmy $prefer = @_ == 3 ? $_[2] : CMP_EQUAL;"
NSQ_SOURCE_LINE 00000699 "\t\t\treturn $prefer;"
NSQ_SOURCE_LINE 00000700 "\t\t}"
NSQ_SOURCE_LINE 00000701 "\t\treturn $result;"
NSQ_SOURCE_LINE 00000702 "\t}"
NSQ_SOURCE_LINE 00000703 "\treturn CMP_UNKNOWN;"
NSQ_SOURCE_LINE 00000704 "};"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "push @CMP, sub {"
NSQ_SOURCE_LINE 00000707 "\tmy ( $A, $B ) = @_;"
NSQ_SOURCE_LINE 00000708 "\treturn CMP_EQUAL"
NSQ_SOURCE_LINE 00000709 "\t\tif Scalar::Util::refaddr( $A ) == Scalar::Util::refaddr( $B );"
NSQ_SOURCE_LINE 00000710 "\t\t"
NSQ_SOURCE_LINE 00000711 "\treturn CMP_EQUIVALENT"
NSQ_SOURCE_LINE 00000712 "\t\tif Scalar::Util::refaddr( $A->compiled_check ) =="
NSQ_SOURCE_LINE 00000713 "\t\tScalar::Util::refaddr( $B->compiled_check );"
NSQ_SOURCE_LINE 00000714 "\t\t"
NSQ_SOURCE_LINE 00000715 "\tmy $A_stem = $A->find_constraining_type;"
NSQ_SOURCE_LINE 00000716 "\tmy $B_stem = $B->find_constraining_type;"
NSQ_SOURCE_LINE 00000717 "\treturn CMP_EQUIVALENT"
NSQ_SOURCE_LINE 00000718 "\t\tif Scalar::Util::refaddr( $A_stem ) == Scalar::Util::refaddr( $B_stem );"
NSQ_SOURCE_LINE 00000719 "\treturn CMP_EQUIVALENT"
NSQ_SOURCE_LINE 00000720 "\t\tif Scalar::Util::refaddr( $A_stem->compiled_check ) =="
NSQ_SOURCE_LINE 00000721 "\t\tScalar::Util::refaddr( $B_stem->compiled_check );"
NSQ_SOURCE_LINE 00000722 "\t\t"
NSQ_SOURCE_LINE 00000723 "\tif ( $A_stem->can_be_inlined and $B_stem->can_be_inlined ) {"
NSQ_SOURCE_LINE 00000724 "\t\treturn CMP_EQUIVALENT"
NSQ_SOURCE_LINE 00000725 "\t\t\tif $A_stem->inline_check( '$WOLFIE' ) eq $B_stem->inline_check( '$WOLFIE' );"
NSQ_SOURCE_LINE 00000726 "\t}"
NSQ_SOURCE_LINE 00000727 "\t"
NSQ_SOURCE_LINE 00000728 "\tA_IS_SUBTYPE: {"
NSQ_SOURCE_LINE 00000729 "\t\tmy $A_prime = $A_stem;"
NSQ_SOURCE_LINE 00000730 "\t\twhile ( $A_prime->has_parent ) {"
NSQ_SOURCE_LINE 00000731 "\t\t\t$A_prime = $A_prime->parent;"
NSQ_SOURCE_LINE 00000732 "\t\t\treturn CMP_SUBTYPE"
NSQ_SOURCE_LINE 00000733 "\t\t\t\tif Scalar::Util::refaddr( $A_prime ) == Scalar::Util::refaddr( $B_stem );"
NSQ_SOURCE_LINE 00000734 "\t\t\treturn CMP_SUBTYPE"
NSQ_SOURCE_LINE 00000735 "\t\t\t\tif Scalar::Util::refaddr( $A_prime->compiled_check ) =="
NSQ_SOURCE_LINE 00000736 "\t\t\t\tScalar::Util::refaddr( $B_stem->compiled_check );"
NSQ_SOURCE_LINE 00000737 "\t\t\tif ( $A_prime->can_be_inlined and $B_stem->can_be_inlined ) {"
NSQ_SOURCE_LINE 00000738 "\t\t\t\treturn CMP_SUBTYPE"
NSQ_SOURCE_LINE 00000739 "\t\t\t\t\tif $A_prime->inline_check( '$WOLFIE' ) eq $B_stem->inline_check( '$WOLFIE' );"
NSQ_SOURCE_LINE 00000740 "\t\t\t}"
NSQ_SOURCE_LINE 00000741 "\t\t} #/ while ( $A_prime->has_parent)"
NSQ_SOURCE_LINE 00000742 "\t} #/ A_IS_SUBTYPE:"
NSQ_SOURCE_LINE 00000743 "\t"
NSQ_SOURCE_LINE 00000744 "\tB_IS_SUBTYPE: {"
NSQ_SOURCE_LINE 00000745 "\t\tmy $B_prime = $B_stem;"
NSQ_SOURCE_LINE 00000746 "\t\twhile ( $B_prime->has_parent ) {"
NSQ_SOURCE_LINE 00000747 "\t\t\t$B_prime = $B_prime->parent;"
NSQ_SOURCE_LINE 00000748 "\t\t\treturn CMP_SUPERTYPE"
NSQ_SOURCE_LINE 00000749 "\t\t\t\tif Scalar::Util::refaddr( $B_prime ) == Scalar::Util::refaddr( $A_stem );"
NSQ_SOURCE_LINE 00000750 "\t\t\treturn CMP_SUPERTYPE"
NSQ_SOURCE_LINE 00000751 "\t\t\t\tif Scalar::Util::refaddr( $B_prime->compiled_check ) =="
NSQ_SOURCE_LINE 00000752 "\t\t\t\tScalar::Util::refaddr( $A_stem->compiled_check );"
NSQ_SOURCE_LINE 00000753 "\t\t\tif ( $A_stem->can_be_inlined and $B_prime->can_be_inlined ) {"
NSQ_SOURCE_LINE 00000754 "\t\t\t\treturn CMP_SUPERTYPE"
NSQ_SOURCE_LINE 00000755 "\t\t\t\t\tif $B_prime->inline_check( '$WOLFIE' ) eq $A_stem->inline_check( '$WOLFIE' );"
NSQ_SOURCE_LINE 00000756 "\t\t\t}"
NSQ_SOURCE_LINE 00000757 "\t\t} #/ while ( $B_prime->has_parent)"
NSQ_SOURCE_LINE 00000758 "\t} #/ B_IS_SUBTYPE:"
NSQ_SOURCE_LINE 00000759 "\t"
NSQ_SOURCE_LINE 00000760 "\treturn CMP_UNKNOWN;"
NSQ_SOURCE_LINE 00000761 "};"
