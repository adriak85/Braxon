NSQ_SOURCE_LINE 00000195 "\t\t\t\t\trequire Type::Tiny::Intersection;"
NSQ_SOURCE_LINE 00000196 "\t\t\t\t\treturn \"Type::Tiny::_HalfOp\"->new("
NSQ_SOURCE_LINE 00000197 "\t\t\t\t\t\t$op,"
NSQ_SOURCE_LINE 00000198 "\t\t\t\t\t\t$param,"
NSQ_SOURCE_LINE 00000199 "\t\t\t\t\t\t\"Type::Tiny::Intersection\"->new_by_overload( type_constraints => [ $type, $tc[1] ] ),"
NSQ_SOURCE_LINE 00000200 "\t\t\t\t\t);"
