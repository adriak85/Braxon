NSQ_SOURCE_LINE 00000001 "package Data::Sah::Util::Type;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2016-12-09'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.46'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "require Exporter;"
NSQ_SOURCE_LINE 00000011 "our @ISA       = qw(Exporter);"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw(get_type is_type is_simple is_numeric is_collection is_ref);"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# XXX absorb and use metadata from Data::Sah::Type::*"
NSQ_SOURCE_LINE 00000015 "our $type_metas = {"
NSQ_SOURCE_LINE 00000016 "    all   => {scalar=>0, numeric=>0, ref=>0},"
NSQ_SOURCE_LINE 00000017 "    any   => {scalar=>0, numeric=>0, ref=>0},"
NSQ_SOURCE_LINE 00000018 "    array => {scalar=>0, numeric=>0, ref=>1},"
NSQ_SOURCE_LINE 00000019 "    bool  => {scalar=>1, numeric=>0, ref=>0},"
NSQ_SOURCE_LINE 00000020 "    buf   => {scalar=>1, numeric=>0, ref=>0},"
NSQ_SOURCE_LINE 00000021 "    cistr => {scalar=>1, numeric=>0, ref=>0},"
NSQ_SOURCE_LINE 00000022 "    code  => {scalar=>1, numeric=>0, ref=>1},"
NSQ_SOURCE_LINE 00000023 "    float => {scalar=>1, numeric=>1, ref=>0},"
NSQ_SOURCE_LINE 00000024 "    hash  => {scalar=>0, numeric=>0, ref=>1},"
NSQ_SOURCE_LINE 00000025 "    int   => {scalar=>1, numeric=>1, ref=>0},"
NSQ_SOURCE_LINE 00000026 "    num   => {scalar=>1, numeric=>1, ref=>0},"
NSQ_SOURCE_LINE 00000027 "    obj   => {scalar=>1, numeric=>0, ref=>1},"
NSQ_SOURCE_LINE 00000028 "    re    => {scalar=>1, numeric=>0, ref=>1, simple=>1},"
NSQ_SOURCE_LINE 00000029 "    str   => {scalar=>1, numeric=>0, ref=>0},"
NSQ_SOURCE_LINE 00000030 "    undef => {scalar=>1, numeric=>0, ref=>0},"
NSQ_SOURCE_LINE 00000031 "    date     => {scalar=>1, numeric=>0, ref=>0},"
NSQ_SOURCE_LINE 00000032 "    duration => {scalar=>1, numeric=>0, ref=>0},"
NSQ_SOURCE_LINE 00000033 "};"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "sub get_type {"
NSQ_SOURCE_LINE 00000036 "    my $sch = shift;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    if (ref($sch) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000039 "        $sch = $sch->[0];"
NSQ_SOURCE_LINE 00000040 "    }"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "    if (defined($sch) && !ref($sch)) {"
NSQ_SOURCE_LINE 00000043 "        $sch =~ s/\\*\\z//;"
NSQ_SOURCE_LINE 00000044 "        return $sch;"
NSQ_SOURCE_LINE 00000045 "    } else {"
NSQ_SOURCE_LINE 00000046 "        return undef;"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "sub _normalize {"
NSQ_SOURCE_LINE 00000051 "    require Data::Sah::Normalize;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    my ($sch, $opts) = @_;"
NSQ_SOURCE_LINE 00000054 "    return $sch if $opts->{schema_is_normalized};"
NSQ_SOURCE_LINE 00000055 "    return Data::Sah::Normalize::normalize_schema($sch);"
NSQ_SOURCE_LINE 00000056 "}"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "# for any|all to pass a criteria, we assume that all of the schemas in the 'of'"
NSQ_SOURCE_LINE 00000059 "# clause must also pass (and there must not be '!of', 'of&', or that kind of"
NSQ_SOURCE_LINE 00000060 "# thing."
NSQ_SOURCE_LINE 00000061 "sub _handle_any_all {"
NSQ_SOURCE_LINE 00000062 "    my ($sch, $opts, $crit) = @_;"
NSQ_SOURCE_LINE 00000063 "    $sch = _normalize($sch, $opts);"
NSQ_SOURCE_LINE 00000064 "    return 0 if $sch->[1]{'of.op'};"
NSQ_SOURCE_LINE 00000065 "    my $of = $sch->[1]{of};"
NSQ_SOURCE_LINE 00000066 "    return 0 unless $of && ref($of) eq 'ARRAY' && @$of;"
NSQ_SOURCE_LINE 00000067 "    for (@$of) {"
NSQ_SOURCE_LINE 00000068 "        return 0 unless $crit->($_);"
NSQ_SOURCE_LINE 00000069 "    }"
NSQ_SOURCE_LINE 00000070 "    1;"
NSQ_SOURCE_LINE 00000071 "}"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "sub is_type {"
NSQ_SOURCE_LINE 00000074 "    my ($sch, $opts) = @_;"
NSQ_SOURCE_LINE 00000075 "    $opts //= {};"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    my $type = get_type($sch) or return undef;"
NSQ_SOURCE_LINE 00000078 "    my $tmeta = $type_metas->{$type} or return undef;"
NSQ_SOURCE_LINE 00000079 "    $type;"
NSQ_SOURCE_LINE 00000080 "}"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "sub is_simple {"
NSQ_SOURCE_LINE 00000083 "    my ($sch, $opts) = @_;"
NSQ_SOURCE_LINE 00000084 "    $opts //= {};"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    my $type = get_type($sch) or return undef;"
NSQ_SOURCE_LINE 00000087 "    my $tmeta = $type_metas->{$type} or return undef;"
NSQ_SOURCE_LINE 00000088 "    if ($type eq 'any' || $type eq 'all') {"
NSQ_SOURCE_LINE 00000089 "        return _handle_any_all($sch, $opts, sub { is_simple(shift) });"
NSQ_SOURCE_LINE 00000090 "    }"
NSQ_SOURCE_LINE 00000091 "    return $tmeta->{simple} // ($tmeta->{scalar} && !$tmeta->{ref});"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "sub is_collection {"
NSQ_SOURCE_LINE 00000095 "    my ($sch, $opts) = @_;"
NSQ_SOURCE_LINE 00000096 "    $opts //= {};"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    my $type = get_type($sch) or return undef;"
NSQ_SOURCE_LINE 00000099 "    my $tmeta = $type_metas->{$type} or return undef;"
NSQ_SOURCE_LINE 00000100 "    if ($type eq 'any' || $type eq 'all') {"
NSQ_SOURCE_LINE 00000101 "        return _handle_any_all($sch, $opts, sub { is_collection(shift) });"
NSQ_SOURCE_LINE 00000102 "    }"
NSQ_SOURCE_LINE 00000103 "    return !$tmeta->{scalar};"
NSQ_SOURCE_LINE 00000104 "}"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "sub is_numeric {"
NSQ_SOURCE_LINE 00000107 "    my ($sch, $opts) = @_;"
NSQ_SOURCE_LINE 00000108 "    $opts //= {};"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "    my $type = get_type($sch) or return undef;"
NSQ_SOURCE_LINE 00000111 "    my $tmeta = $type_metas->{$type} or return undef;"
NSQ_SOURCE_LINE 00000112 "    if ($type eq 'any' || $type eq 'all') {"
NSQ_SOURCE_LINE 00000113 "        return _handle_any_all($sch, $opts, sub { is_numeric(shift) });"
NSQ_SOURCE_LINE 00000114 "    }"
NSQ_SOURCE_LINE 00000115 "    return $tmeta->{numeric};"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "sub is_ref {"
NSQ_SOURCE_LINE 00000119 "    my ($sch, $opts) = @_;"
NSQ_SOURCE_LINE 00000120 "    $opts //= {};"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    my $type = get_type($sch) or return undef;"
NSQ_SOURCE_LINE 00000123 "    my $tmeta = $type_metas->{$type} or return undef;"
NSQ_SOURCE_LINE 00000124 "    if ($type eq 'any' || $type eq 'all') {"
NSQ_SOURCE_LINE 00000125 "        return _handle_any_all($sch, $opts, sub { is_ref(shift) });"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 "    return $tmeta->{ref};"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "1;"
NSQ_SOURCE_LINE 00000131 "# ABSTRACT: Utility functions related to types"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "__END__"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=pod"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 NAME"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "Data::Sah::Util::Type - Utility functions related to types"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=head1 VERSION"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "This document describes version 0.46 of Data::Sah::Util::Type (from Perl distribution Data-Sah-Util-Type), released on 2016-12-09."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 " use Data::Sah::Util::Type qw("
NSQ_SOURCE_LINE 00000150 "     get_type"
NSQ_SOURCE_LINE 00000151 "     is_type"
NSQ_SOURCE_LINE 00000152 "     is_simple is_numeric is_collection is_ref"
NSQ_SOURCE_LINE 00000153 " );"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 " say get_type(\"int\");                          # -> int"
NSQ_SOURCE_LINE 00000156 " say get_type(\"int*\");                         # -> int"
NSQ_SOURCE_LINE 00000157 " say get_type([int => min=>0]);                # -> int"
NSQ_SOURCE_LINE 00000158 " say get_type(\"foo\");                          # -> foo (doesn't check type is known)"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 " say is_type(\"int*\");                          # -> 1"
NSQ_SOURCE_LINE 00000161 " say is_type(\"foo\");                           # -> 0"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 " say is_simple(\"int\");                          # -> 1"
NSQ_SOURCE_LINE 00000164 " say is_simple(\"array\");                        # -> 0"
NSQ_SOURCE_LINE 00000165 " say is_simple([any => of => [\"float\", \"str\"]); # -> 1"
NSQ_SOURCE_LINE 00000166 " say is_simple(\"re\");                           # -> 1"
NSQ_SOURCE_LINE 00000167 " say is_simple(\"foo\");                          # -> 0"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 " say is_collection(\"array*\");            # -> 1"
NSQ_SOURCE_LINE 00000170 " say is_collection([\"hash\", of=>\"int\"]); # -> 1"
NSQ_SOURCE_LINE 00000171 " say is_collection(\"str\");               # -> 0"
NSQ_SOURCE_LINE 00000172 " say is_collection(\"foo\");               # -> 0"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 " say is_ref(\"code*\"); # -> 1"
NSQ_SOURCE_LINE 00000175 " say is_ref(\"array\"); # -> 1"
NSQ_SOURCE_LINE 00000176 " say is_ref(\"str\");   # -> 0"
NSQ_SOURCE_LINE 00000177 " say is_ref(\"foo\");   # -> 0"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 " say is_numeric([\"int\", min=>0]); # -> 1"
NSQ_SOURCE_LINE 00000180 " say is_numeric(\"str\");           # -> 0"
NSQ_SOURCE_LINE 00000181 " say is_numeric(\"foo\");           # -> 0"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "This module provides some secondary utility functions related to L<Sah> and"
NSQ_SOURCE_LINE 00000186 "L<Data::Sah>. It is deliberately distributed separately from the Data-Sah main"
NSQ_SOURCE_LINE 00000187 "distribution to be differentiated from Data::Sah::Util which contains \"primary\""
NSQ_SOURCE_LINE 00000188 "utilities and is distributed with Data-Sah."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "Reference table for simple/collection/ref/numeric criteria of builtin types:"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 " +----------+-----------+---------------+--------+------------+"
NSQ_SOURCE_LINE 00000193 " | type     | is_simple | is_collection | is_ref | is_numeric |"
NSQ_SOURCE_LINE 00000194 " +----------+-----------+---------------+--------+------------+"
NSQ_SOURCE_LINE 00000195 " | array    |           | 1             | 1      |            |"
NSQ_SOURCE_LINE 00000196 " | bool     | 1         |               |        |            |"
NSQ_SOURCE_LINE 00000197 " | buf      | 1         |               |        |            |"
NSQ_SOURCE_LINE 00000198 " | cistr    | 1         |               |        |            |"
NSQ_SOURCE_LINE 00000199 " | code     |           |               | 1      |            |"
NSQ_SOURCE_LINE 00000200 " | date     | 1         |               |        |            |"
NSQ_SOURCE_LINE 00000201 " | duration | 1         |               |        |            |"
NSQ_SOURCE_LINE 00000202 " | float    | 1         |               |        | 1          |"
NSQ_SOURCE_LINE 00000203 " | hash     |           | 1             | 1      |            |"
NSQ_SOURCE_LINE 00000204 " | int      | 1         |               |        | 1          |"
NSQ_SOURCE_LINE 00000205 " | num      | 1         |               |        | 1          |"
NSQ_SOURCE_LINE 00000206 " | obj      |           |               | 1      |            |"
NSQ_SOURCE_LINE 00000207 " | re       | 1         |               | 1      |            |"
NSQ_SOURCE_LINE 00000208 " | str      | 1         |               |        |            |"
NSQ_SOURCE_LINE 00000209 " | undef    | 1         |               |        |            |"
NSQ_SOURCE_LINE 00000210 " +----------+-----------+---------------+--------+------------+"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "None exported by default, but they are exportable."
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=head2 get_type($sch) => STR"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "Return type name."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=head2 is_type($sch) => STR"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "Return type name if type in schema is known, or undef."
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=head2 is_simple($sch[, \\%opts]) => BOOL"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "Simple means \"scalar\" or can be represented as a scalar. This is currently used"
NSQ_SOURCE_LINE 00000227 "to determine if a builtin type can be specified as an argument or option value"
NSQ_SOURCE_LINE 00000228 "in command-line."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "This includes C<re>, C<bool>, as well as C<date> and C<duration>."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "If type is C<all>, then for this routine to be true all of the mentioned types"
NSQ_SOURCE_LINE 00000233 "must be simple. If type is C<any>, then for this routine to be true at least one"
NSQ_SOURCE_LINE 00000234 "of the mentioned types must be simple."
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "Options:"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=over"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=item * schema_is_normalized => BOOL"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=back"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head2 is_collection($sch[, \\%opts]) => BOOL"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "Collection means C<array> or C<hash>."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "If type is C<all>, then for this routine to be true all of the mentioned types"
NSQ_SOURCE_LINE 00000249 "must be collection. If type is C<any>, then for this routine to be true at least"
NSQ_SOURCE_LINE 00000250 "one of the mentioned types must be collection."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=head2 is_ref($sch[, \\%opts]) => BOOL"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "\"Ref\" means generally a reference in Perl. But C<date> and C<duration> are not"
NSQ_SOURCE_LINE 00000255 "regarded as \"ref\". Regular expression on the other hand is regarded as a ref."
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "If type is C<all>, then for this routine to be true all of the mentioned types"
NSQ_SOURCE_LINE 00000258 "must be \"ref\". If type is C<any>, then for this routine to be true at least one"
NSQ_SOURCE_LINE 00000259 "of the mentioned types must be \"ref\"."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=head2 is_numeric($sch[, \\%opts]) => BOOL"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "Currently, only C<num>, C<int>, and C<float> are numeric."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "If type is C<all>, then for this routine to be true all of the mentioned types"
NSQ_SOURCE_LINE 00000266 "must be numeric. If type is C<any>, then for this routine to be true at least"
NSQ_SOURCE_LINE 00000267 "one of the mentioned types must be numeric."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Please visit the project's homepage at L<https://metacpan.org/release/Data-Sah-Util-Type>."
NSQ_SOURCE_LINE 00000272 ""
