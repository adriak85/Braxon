NSQ_SOURCE_LINE 00000710 "      if ($self->{block_mode}){"
NSQ_SOURCE_LINE 00000711 "        if ($check_type eq 'regexp'){"
NSQ_SOURCE_LINE 00000712 "          $msg = \"[b] text match /$lshort/\";"
NSQ_SOURCE_LINE 00000713 "        } else {"
NSQ_SOURCE_LINE 00000714 "          $msg = \"[b] text has '\".$lshort.\"'\";"
NSQ_SOURCE_LINE 00000715 "        }"
NSQ_SOURCE_LINE 00000716 "      } else {"
