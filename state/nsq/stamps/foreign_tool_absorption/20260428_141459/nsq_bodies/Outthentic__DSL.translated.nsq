NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "        my $i = 0;"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "        my $code_to_print = join \"\\n\", map { my $v=$_; $i++; \"[$i] $v\" }  @$code;"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "        if ($code->[0]=~s/^\\!(.*)//) {"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "          my $ext_runner = $1;"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "          my $language = (split /\\\\/, $ext_runner)[-1];"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "          if ($language eq 'perl') {"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "              shift @$code;"
NSQ_SOURCE_LINE 00000574 "              my $code_to_eval = join \"\\n\", @$code;"
NSQ_SOURCE_LINE 00000575 "              $results = eval \"package main; $code_to_eval\";"
NSQ_SOURCE_LINE 00000576 "              confess \"eval error; sub:handle_code; code:\\n$code_to_print\\nerror: $@\" if $@;"
NSQ_SOURCE_LINE 00000577 "              $self->debug(\"code OK. inline(perl). $code_to_eval\") if $self->{debug_mod} >= 3;"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "          } else {"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "            my $source_file = File::Temp->new( DIR => $self->{cache_dir} , UNLINK => 0 );"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "            shift @$code;"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "            my $code_to_eval = join \"\\n\", @$code;"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "            open SOURCE_CODE, '>', $source_file or die \"can't open source code file $source_file to write: $!\";"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "            print SOURCE_CODE $code_to_eval;"
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "            close SOURCE_CODE;"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "            if ($language eq 'bash'){"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "              if ($self->{languages}->{$language}){"
NSQ_SOURCE_LINE 00000596 "                $ext_runner = \"bash -c '\".($self->{languages}->{$language}).\" && source $source_file'\";"
NSQ_SOURCE_LINE 00000597 "              }else{"
NSQ_SOURCE_LINE 00000598 "                  $ext_runner = \"bash -c 'source $source_file'\";"
NSQ_SOURCE_LINE 00000599 "              }"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "            } else {"
NSQ_SOURCE_LINE 00000602 "              $ext_runner = $self->{languages}->{$language} if $self->{languages}->{$language};"
NSQ_SOURCE_LINE 00000603 "              $ext_runner.=' '.$source_file;"
NSQ_SOURCE_LINE 00000604 "            }"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "            my $st = system(\"$ext_runner 2>$source_file.err 1>$source_file.out\");  "
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "            if ($st != 0){"
NSQ_SOURCE_LINE 00000610 "              confess \"$ext_runner failed, see $source_file.err for details\";"
NSQ_SOURCE_LINE 00000611 "            }"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "            $self->debug(\"code OK. inline. $ext_runner\") if $self->{debug_mod} >= 2;"
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "            open EXT_OUT, \"$source_file.out\" or die \"can't open file $source_file.out to read: $!\";"
NSQ_SOURCE_LINE 00000616 "            $results = join \"\", <EXT_OUT>;"
NSQ_SOURCE_LINE 00000617 "            close EXT_OUT;"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "            unless ($ENV{OTX_KEEP_SOURCE_FILES}) {"
NSQ_SOURCE_LINE 00000620 "              unlink(\"$source_file.out\");"
NSQ_SOURCE_LINE 00000621 "              unlink(\"$source_file.err\");"
NSQ_SOURCE_LINE 00000622 "              unlink(\"$source_file\");"
NSQ_SOURCE_LINE 00000623 "            }"
NSQ_SOURCE_LINE 00000624 "        } "
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "      } else {"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "        my $code_to_eval = join \"\\n\", @$code;"
NSQ_SOURCE_LINE 00000631 "        $results = eval \"package main; $code_to_eval\";"
NSQ_SOURCE_LINE 00000632 "        confess \"eval error; sub:handle_code; code:\\n$code_to_print\\nerror: $@\" if $@;"
NSQ_SOURCE_LINE 00000633 "        $self->debug(\"code OK. multiline. $code_to_eval\") if $self->{debug_mod} >= 3;"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "      }"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "  }"
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "  return $results;"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "}"
