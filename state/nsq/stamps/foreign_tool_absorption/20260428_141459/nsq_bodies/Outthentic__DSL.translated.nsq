NSQ_SOURCE_LINE 00000547 "sub handle_code {"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "    my $self = shift;"
NSQ_SOURCE_LINE 00000550 "    my $code = shift;"
NSQ_SOURCE_LINE 00000551 "    my $results;"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "    if (! ref $code) {"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "        $results = eval \"package main; $code;\";"
