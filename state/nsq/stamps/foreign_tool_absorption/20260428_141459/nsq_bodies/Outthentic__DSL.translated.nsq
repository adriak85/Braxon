NSQ_SOURCE_LINE 00000810 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "Outthentic::DSL - language to verify (un)structured text."
NSQ_SOURCE_LINE 00000813 ""
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "=head1 Install"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "    $ cpanm Outthentic::DSL"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "=head1 Developing"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "    $ git clone https://github.com/melezhik/outthentic-dsl.git "
NSQ_SOURCE_LINE 00000823 "    $ cd outthentic-dsl"
NSQ_SOURCE_LINE 00000824 "    $ perl Makefile.PL && make && make install"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "=head1 Glossary"
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "=head2 Input text"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "An arbitrary, often unstructured text being verified. It could be any text."
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "Examples:"
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "=over"
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "=item *"
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "html code"
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "=item *"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "xml code"
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "=item *"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "json "
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "=item *"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "plain text"
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "=item *"
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 "emails :-)"
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "=item *"
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "http headers"
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "=item *"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "another program languages code"
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "=back"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "=head2 Outthentic DSL"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "=over"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "=item *"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "Is a language to verify I<arbitrary> text"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 ""
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "=item *"
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "Outthentic DSL is both imperative and declarative language"
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "=back"
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "=head3 Declarative way"
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "You define rules ( check expressions ) to describe expected content."
NSQ_SOURCE_LINE 00000898 ""
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "=head3 Imperative way"
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "You I<extend> a process of verification using regular programming languages - like Perl, Bash and Ruby, see examples below."
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "=head2 DSL code"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "A program code written on Outthentic DSL language to verify text input."
NSQ_SOURCE_LINE 00000908 ""
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "=head2 Search context"
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "Verification process is taken in a  I<context>."
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "By default search context I<is equal> to an original text input stream."
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "However a search context might be changed in some situations ( see within, text blocks and ranges expressions )."
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "=head2 DSL parser"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "DSL parser is the program which:"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "=over"
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "=item *"
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "parses DSL code"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "=item *"
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "parses text input"
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "=item *"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "verifies text input ( line by line ) against a check expressions ( line by line )"
NSQ_SOURCE_LINE 00000940 ""
NSQ_SOURCE_LINE 00000941 ""
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "=back"
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "=head2 Verification process"
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "Verification process consists of matching lines of text input against check expressions."
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "This is schematic description of the process:"
NSQ_SOURCE_LINE 00000951 ""
NSQ_SOURCE_LINE 00000952 "    For every check expression in a check expressions list:"
NSQ_SOURCE_LINE 00000953 "        * Mark this check step in `unknown' state."
NSQ_SOURCE_LINE 00000954 "        * For every line in input text:"
NSQ_SOURCE_LINE 00000955 "            * Verify if it matches check expression. If line matches then mark step in `succeeded' state."
NSQ_SOURCE_LINE 00000956 "            * Next line."
NSQ_SOURCE_LINE 00000957 "        End of lines loop."
NSQ_SOURCE_LINE 00000958 "        * If the check step marked in `unknown' state, then mark it in `failed' state.  "
NSQ_SOURCE_LINE 00000959 "        * Next check expression."
NSQ_SOURCE_LINE 00000960 "    End of expressions loop."
NSQ_SOURCE_LINE 00000961 "    "
NSQ_SOURCE_LINE 00000962 "    Check if all check steps are succeeded. If so then input text is considered verified, else - not verified."
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "A final I<presentation> of verification results should be implemented in a certain L<client|#clients> I<using> L<parser api|#parser-api> and not being defined at this scope."
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 ""
NSQ_SOURCE_LINE 00000967 ""
NSQ_SOURCE_LINE 00000968 "=head2 Parser API"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "Outthentic::DSL provides program API for I<client applications>. "
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "This is example of verification some text against 2 lines;"
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "    use Outthentic::DSL;"
NSQ_SOURCE_LINE 00000975 "    "
NSQ_SOURCE_LINE 00000976 "    my $otx = Outthentic::DSL->new(<<HERE, { debug_mod => 0 });"
NSQ_SOURCE_LINE 00000977 "        Hello"
NSQ_SOURCE_LINE 00000978 "        My name is Outthentic!"
NSQ_SOURCE_LINE 00000979 "    HERE"
NSQ_SOURCE_LINE 00000980 "    "
NSQ_SOURCE_LINE 00000981 "    $otx->validate(<<'CHECK');"
NSQ_SOURCE_LINE 00000982 "        Hello"
NSQ_SOURCE_LINE 00000983 "        regexp: My\\s+name\\s+is\\s+\\S+"
NSQ_SOURCE_LINE 00000984 "    CHECK"
NSQ_SOURCE_LINE 00000985 "    "
NSQ_SOURCE_LINE 00000986 "    print \"status\\tcheck\\n\";"
NSQ_SOURCE_LINE 00000987 "    print \"==========================\\n\";"
NSQ_SOURCE_LINE 00000988 "    "
NSQ_SOURCE_LINE 00000989 "    for my $r (@{$otx->results}) {"
NSQ_SOURCE_LINE 00000990 "        print $r->{status} ? 'true' : 'false', \"\\t\", $r->{message}, \"\\n\";"
NSQ_SOURCE_LINE 00000991 "    }"
NSQ_SOURCE_LINE 00000992 ""
NSQ_SOURCE_LINE 00000993 "Output:"
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "    status  check"
NSQ_SOURCE_LINE 00000996 "    =========================="
NSQ_SOURCE_LINE 00000997 "    true    text has 'Hello'"
NSQ_SOURCE_LINE 00000998 "    true    text match /My\\s+name\\s+is\\s+\\S+/"
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "Methods list:"
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 ""
NSQ_SOURCE_LINE 00001003 "=head3 new"
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "This is constructor to create an Outthentic::DSL instance. "
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "Obligatory parameters are:"
NSQ_SOURCE_LINE 00001008 ""
NSQ_SOURCE_LINE 00001009 "=over"
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "=item *"
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "text"
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 ""
NSQ_SOURCE_LINE 00001016 "=back"
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "input text to get verified"
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "    Outthentic::DSL->new(\"Hi! Welcome to my birthday party.\\nLet's have a fun\" );"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "Optional parameters are passed as hash:"
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "=over"
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "=item *"
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "match_l - truncate check expressions to a C<match_l> bytes when generating results"
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "=back"
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 "This is useful when debugging long check expressions:"
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 "    use Outthentic::DSL;"
NSQ_SOURCE_LINE 00001036 "    "
NSQ_SOURCE_LINE 00001037 "    my $otx = Outthentic::DSL->new( 'A'x99 , { match_l  => 9 });"
NSQ_SOURCE_LINE 00001038 "    "
NSQ_SOURCE_LINE 00001039 "    $otx->validate('A'x99);"
NSQ_SOURCE_LINE 00001040 "    "
NSQ_SOURCE_LINE 00001041 "    print \"status\\tcheck\\n\";"
NSQ_SOURCE_LINE 00001042 "    print \"==========================\\n\";"
NSQ_SOURCE_LINE 00001043 "    "
NSQ_SOURCE_LINE 00001044 "    for my $r (@{$otx->results}) {"
NSQ_SOURCE_LINE 00001045 "        print $r->{status} ? 'true' : 'false', \"\\t\", $r->{message}, \"\\n\";"
NSQ_SOURCE_LINE 00001046 "    }"
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "Output:"
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "    status  check"
NSQ_SOURCE_LINE 00001051 "    =========================="
NSQ_SOURCE_LINE 00001052 "    true    text has 'AAAAAAAAA'"
NSQ_SOURCE_LINE 00001053 ""
NSQ_SOURCE_LINE 00001054 "Default value is C<40>."
NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 "=over"
NSQ_SOURCE_LINE 00001057 ""
NSQ_SOURCE_LINE 00001058 "=item *"
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "debug_mod - enable debug mode"
NSQ_SOURCE_LINE 00001061 ""
NSQ_SOURCE_LINE 00001062 "=over"
NSQ_SOURCE_LINE 00001063 ""
NSQ_SOURCE_LINE 00001064 "=item *"
NSQ_SOURCE_LINE 00001065 ""
NSQ_SOURCE_LINE 00001066 "Possible values is one of: C<0,1,2,3,4>"
NSQ_SOURCE_LINE 00001067 ""
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 ""
NSQ_SOURCE_LINE 00001070 "=item *"
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "Set to 1 or 2 or 3 or 4 if you want to see some debug information appeared at console."
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 "=item *"
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 "Increasing debug_mod value results in more low level information appeared."
NSQ_SOURCE_LINE 00001079 ""
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 ""
NSQ_SOURCE_LINE 00001082 "=item *"
NSQ_SOURCE_LINE 00001083 ""
NSQ_SOURCE_LINE 00001084 "Default value is C<0> - means do not emit debug messages."
NSQ_SOURCE_LINE 00001085 ""
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "=back"
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "=back"
NSQ_SOURCE_LINE 00001093 ""
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "=head3 validate"
NSQ_SOURCE_LINE 00001096 ""
NSQ_SOURCE_LINE 00001097 "Perform verification process. "
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "Obligatory parameter is:"
NSQ_SOURCE_LINE 00001100 ""
NSQ_SOURCE_LINE 00001101 "=over"
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 "=item *"
NSQ_SOURCE_LINE 00001104 ""
NSQ_SOURCE_LINE 00001105 "a string with DSL code"
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 ""
NSQ_SOURCE_LINE 00001108 "=back"
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "Example:"
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 "    $otx->validate(<<'CHECK');"
NSQ_SOURCE_LINE 00001113 "    "
NSQ_SOURCE_LINE 00001114 "      # there should be digits"
NSQ_SOURCE_LINE 00001115 "      regexp: \\d"
NSQ_SOURCE_LINE 00001116 "      # and greetings"
NSQ_SOURCE_LINE 00001117 "      regexp: hello \\s+ \\w+"
NSQ_SOURCE_LINE 00001118 "    "
NSQ_SOURCE_LINE 00001119 "    CHECK"
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "=head3 results"
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "Returns validation results as array containing { type, status, message } hashes."
NSQ_SOURCE_LINE 00001126 ""
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "=head2 Outthentic clients"
NSQ_SOURCE_LINE 00001129 ""
NSQ_SOURCE_LINE 00001130 "Client is a external program using DSL API. Existed Outthentic clients:"
NSQ_SOURCE_LINE 00001131 ""
NSQ_SOURCE_LINE 00001132 "=over"
NSQ_SOURCE_LINE 00001133 ""
NSQ_SOURCE_LINE 00001134 "=item *"
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 "L<Swat|https://github.com/melezhik/swat> - web application testing tool"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 ""
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "=item *"
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "L<Outthentic|https://github.com/melezhik/outthentic> -  multipurpose scenarios framework"
NSQ_SOURCE_LINE 00001143 ""
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 ""
NSQ_SOURCE_LINE 00001146 "=back"
NSQ_SOURCE_LINE 00001147 ""
NSQ_SOURCE_LINE 00001148 ""
NSQ_SOURCE_LINE 00001149 "=head1 DSL code syntax"
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "Outthentic DSL code comprises following entities:"
NSQ_SOURCE_LINE 00001152 ""
NSQ_SOURCE_LINE 00001153 "=over"
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "=item *"
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "Comments"
NSQ_SOURCE_LINE 00001158 ""
NSQ_SOURCE_LINE 00001159 ""
NSQ_SOURCE_LINE 00001160 ""
NSQ_SOURCE_LINE 00001161 "=item *"
NSQ_SOURCE_LINE 00001162 ""
NSQ_SOURCE_LINE 00001163 "Blank lines"
NSQ_SOURCE_LINE 00001164 ""
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 ""
NSQ_SOURCE_LINE 00001167 "=item *"
NSQ_SOURCE_LINE 00001168 ""
NSQ_SOURCE_LINE 00001169 "Check expressions:"
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 "=over"
NSQ_SOURCE_LINE 00001172 ""
NSQ_SOURCE_LINE 00001173 "=item *"
NSQ_SOURCE_LINE 00001174 ""
NSQ_SOURCE_LINE 00001175 "plain     strings"
NSQ_SOURCE_LINE 00001176 ""
NSQ_SOURCE_LINE 00001177 ""
NSQ_SOURCE_LINE 00001178 "=item *"
NSQ_SOURCE_LINE 00001179 ""
NSQ_SOURCE_LINE 00001180 "regular   expressions"
NSQ_SOURCE_LINE 00001181 ""
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "=item *"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "text      blocks"
NSQ_SOURCE_LINE 00001186 ""
NSQ_SOURCE_LINE 00001187 ""
NSQ_SOURCE_LINE 00001188 "=item *"
NSQ_SOURCE_LINE 00001189 ""
NSQ_SOURCE_LINE 00001190 "within    expressions"
NSQ_SOURCE_LINE 00001191 ""
NSQ_SOURCE_LINE 00001192 ""
NSQ_SOURCE_LINE 00001193 "=item *"
NSQ_SOURCE_LINE 00001194 ""
NSQ_SOURCE_LINE 00001195 "asserts   expressions"
NSQ_SOURCE_LINE 00001196 ""
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "=item *"
NSQ_SOURCE_LINE 00001199 ""
NSQ_SOURCE_LINE 00001200 "validator expressions"
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 ""
NSQ_SOURCE_LINE 00001203 "=item *"
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "range     expressions"
NSQ_SOURCE_LINE 00001206 ""
NSQ_SOURCE_LINE 00001207 ""
NSQ_SOURCE_LINE 00001208 "=back"
NSQ_SOURCE_LINE 00001209 ""
NSQ_SOURCE_LINE 00001210 ""
NSQ_SOURCE_LINE 00001211 ""
NSQ_SOURCE_LINE 00001212 "=item *"
NSQ_SOURCE_LINE 00001213 ""
NSQ_SOURCE_LINE 00001214 "Code expressions"
NSQ_SOURCE_LINE 00001215 ""
NSQ_SOURCE_LINE 00001216 ""
NSQ_SOURCE_LINE 00001217 ""
NSQ_SOURCE_LINE 00001218 "=item *"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "Generator expressions"
NSQ_SOURCE_LINE 00001221 ""
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 ""
NSQ_SOURCE_LINE 00001224 "=back"
NSQ_SOURCE_LINE 00001225 ""
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "=head1 Check expressions"
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 "Check expressions define patterns to match against an input text stream. "
NSQ_SOURCE_LINE 00001230 ""
NSQ_SOURCE_LINE 00001231 "Here is a simple example:"
NSQ_SOURCE_LINE 00001232 ""
NSQ_SOURCE_LINE 00001233 "    use Outthentic::DSL;"
NSQ_SOURCE_LINE 00001234 "    "
NSQ_SOURCE_LINE 00001235 "    my $otx = Outthentic::DSL->new(<<'HERE');"
NSQ_SOURCE_LINE 00001236 "      HELLO"
NSQ_SOURCE_LINE 00001237 "      HELLO WORLD"
NSQ_SOURCE_LINE 00001238 "      My birth day is: 1977-04-16"
NSQ_SOURCE_LINE 00001239 "    HERE"
NSQ_SOURCE_LINE 00001240 "    "
NSQ_SOURCE_LINE 00001241 "    $otx->validate(<<'CHECK');"
NSQ_SOURCE_LINE 00001242 "      HELLO"
NSQ_SOURCE_LINE 00001243 "      regexp: \\d\\d\\d\\d-\\d\\d-\\d\\d"
NSQ_SOURCE_LINE 00001244 "    CHECK"
NSQ_SOURCE_LINE 00001245 "    "
NSQ_SOURCE_LINE 00001246 "    print \"status\\tcheck\\n\";"
NSQ_SOURCE_LINE 00001247 "    print \"==========================\\n\";"
NSQ_SOURCE_LINE 00001248 "    "
NSQ_SOURCE_LINE 00001249 "    for my $r (@{$otx->results}) {"
NSQ_SOURCE_LINE 00001250 "        print $r->{status} ? 'true' : 'false', \"\\t\", $r->{message}, \"\\n\";"
NSQ_SOURCE_LINE 00001251 "    }"
NSQ_SOURCE_LINE 00001252 ""
NSQ_SOURCE_LINE 00001253 "Output:"
NSQ_SOURCE_LINE 00001254 ""
NSQ_SOURCE_LINE 00001255 "    status  check"
NSQ_SOURCE_LINE 00001256 "    =========================="
NSQ_SOURCE_LINE 00001257 "    true    text has 'HELLO'"
NSQ_SOURCE_LINE 00001258 "    true    text match /\\d\\d\\d\\d-\\d\\d-\\d\\d/"
NSQ_SOURCE_LINE 00001259 ""
NSQ_SOURCE_LINE 00001260 "There are two basic types of check expressions:"
NSQ_SOURCE_LINE 00001261 ""
NSQ_SOURCE_LINE 00001262 "=over"
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "=item *"
NSQ_SOURCE_LINE 00001265 ""
NSQ_SOURCE_LINE 00001266 "L<plain text expressions|#plain-text-expressions> "
NSQ_SOURCE_LINE 00001267 ""
NSQ_SOURCE_LINE 00001268 ""
NSQ_SOURCE_LINE 00001269 ""
NSQ_SOURCE_LINE 00001270 "=item *"
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 "L<regular expressions|#regular-expressions>."
NSQ_SOURCE_LINE 00001273 ""
NSQ_SOURCE_LINE 00001274 ""
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "=back"
NSQ_SOURCE_LINE 00001277 ""
NSQ_SOURCE_LINE 00001278 ""
NSQ_SOURCE_LINE 00001279 "=head1 Plain text expressions "
NSQ_SOURCE_LINE 00001280 ""
NSQ_SOURCE_LINE 00001281 "Plain text expressions define a lines an input text to contain."
NSQ_SOURCE_LINE 00001282 ""
NSQ_SOURCE_LINE 00001283 "    use Outthentic::DSL;"
NSQ_SOURCE_LINE 00001284 "    "
NSQ_SOURCE_LINE 00001285 "    my $otx = Outthentic::DSL->new(<<'HERE');"
NSQ_SOURCE_LINE 00001286 "      I am ok, really"
NSQ_SOURCE_LINE 00001287 "      HELLO Outthentic !!!"
NSQ_SOURCE_LINE 00001288 "    HERE"
NSQ_SOURCE_LINE 00001289 "    "
NSQ_SOURCE_LINE 00001290 "    $otx->validate(<<'CHECK');"
NSQ_SOURCE_LINE 00001291 "      I am ok"
NSQ_SOURCE_LINE 00001292 "      HELLO Outthentic"
NSQ_SOURCE_LINE 00001293 "    CHECK"
NSQ_SOURCE_LINE 00001294 "    "
NSQ_SOURCE_LINE 00001295 "    print \"status\\tcheck\\n\";"
NSQ_SOURCE_LINE 00001296 "    print \"==========================\\n\";"
NSQ_SOURCE_LINE 00001297 "    "
NSQ_SOURCE_LINE 00001298 "    for my $r (@{$otx->results}) {"
NSQ_SOURCE_LINE 00001299 "        print $r->{status} ? 'true' : 'false', \"\\t\", $r->{message}, \"\\n\";"
NSQ_SOURCE_LINE 00001300 "    }"
NSQ_SOURCE_LINE 00001301 ""
NSQ_SOURCE_LINE 00001302 "Output:"
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 "    status  check"
NSQ_SOURCE_LINE 00001305 "    =========================="
NSQ_SOURCE_LINE 00001306 "    true    text has 'I am ok'"
NSQ_SOURCE_LINE 00001307 "    true    text has 'HELLO Outthentic'"
NSQ_SOURCE_LINE 00001308 ""
NSQ_SOURCE_LINE 00001309 "Plain text expressions are case sensitive:"
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 "    use Outthentic::DSL;"
NSQ_SOURCE_LINE 00001312 "    "
NSQ_SOURCE_LINE 00001313 "    my $otx = Outthentic::DSL->new(<<'HERE');"
NSQ_SOURCE_LINE 00001314 "      I am ok"
NSQ_SOURCE_LINE 00001315 "    HERE"
NSQ_SOURCE_LINE 00001316 "    "
NSQ_SOURCE_LINE 00001317 "    $otx->validate(<<'CHECK');"
NSQ_SOURCE_LINE 00001318 "      I am OK"
NSQ_SOURCE_LINE 00001319 "    CHECK"
NSQ_SOURCE_LINE 00001320 "    "
NSQ_SOURCE_LINE 00001321 "    print \"status\\tcheck\\n\";"
NSQ_SOURCE_LINE 00001322 "    print \"==========================\\n\";"
NSQ_SOURCE_LINE 00001323 "    "
NSQ_SOURCE_LINE 00001324 "    for my $r (@{$otx->results}) {"
NSQ_SOURCE_LINE 00001325 "        print $r->{status} ? 'true' : 'false', \"\\t\", $r->{message}, \"\\n\";"
NSQ_SOURCE_LINE 00001326 "    }"
NSQ_SOURCE_LINE 00001327 ""
NSQ_SOURCE_LINE 00001328 "Output:"
NSQ_SOURCE_LINE 00001329 ""
NSQ_SOURCE_LINE 00001330 "    status  check"
NSQ_SOURCE_LINE 00001331 "    =========================="
NSQ_SOURCE_LINE 00001332 "    false   text has 'I am OK'"
NSQ_SOURCE_LINE 00001333 ""
NSQ_SOURCE_LINE 00001334 ""
NSQ_SOURCE_LINE 00001335 "=head1 Regular expressions"
NSQ_SOURCE_LINE 00001336 ""
NSQ_SOURCE_LINE 00001337 "Similarly to plain text matching, you may require that input lines match some regular expressions."
NSQ_SOURCE_LINE 00001338 ""
NSQ_SOURCE_LINE 00001339 "This should be L<Perl Regular Expressions|http://perldoc.perl.org/perlre.html>."
NSQ_SOURCE_LINE 00001340 ""
NSQ_SOURCE_LINE 00001341 "Example:"
NSQ_SOURCE_LINE 00001342 ""
NSQ_SOURCE_LINE 00001343 "    use Outthentic::DSL;"
NSQ_SOURCE_LINE 00001344 "    "
NSQ_SOURCE_LINE 00001345 "    my $otx = Outthentic::DSL->new(<<'HERE');"
NSQ_SOURCE_LINE 00001346 "      2001-01-02"
NSQ_SOURCE_LINE 00001347 "      Name: Outthentic"
NSQ_SOURCE_LINE 00001348 "      App Version Number: 1.1.10"
NSQ_SOURCE_LINE 00001349 "    HERE"
NSQ_SOURCE_LINE 00001350 "    "
NSQ_SOURCE_LINE 00001351 "    $otx->validate(<<'CHECK');"
NSQ_SOURCE_LINE 00001352 "      regexp: \\d\\d\\d\\d-\\d\\d-\\d\\d # date in format of YYYY-MM-DD"
NSQ_SOURCE_LINE 00001353 "      regexp: Name:\\s+\\w+ # name"
NSQ_SOURCE_LINE 00001354 "      regexp: App Version Number:\\s+\\d+\\.\\d+\\.\\d+ # version number"
NSQ_SOURCE_LINE 00001355 "    CHECK"
NSQ_SOURCE_LINE 00001356 "    "
NSQ_SOURCE_LINE 00001357 "    for my $r (@{$otx->results}) {"
NSQ_SOURCE_LINE 00001358 "        print $r->{status} ? 'true' : 'false', \"\\t\", $r->{message}, \"\\n\";"
NSQ_SOURCE_LINE 00001359 "    }"
NSQ_SOURCE_LINE 00001360 ""
NSQ_SOURCE_LINE 00001361 "Output:"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "    true    text match /\\d\\d\\d\\d-\\d\\d-\\d\\d/"
NSQ_SOURCE_LINE 00001364 "    true    text match /Name:\\s+\\w+/"
NSQ_SOURCE_LINE 00001365 "    true    text match /App Version Number:\\s+\\d+\\.\\d+\\.\\d+/"
NSQ_SOURCE_LINE 00001366 ""
NSQ_SOURCE_LINE 00001367 ""
NSQ_SOURCE_LINE 00001368 "=head1 One or many?"
NSQ_SOURCE_LINE 00001369 ""
NSQ_SOURCE_LINE 00001370 "=over"
NSQ_SOURCE_LINE 00001371 ""
NSQ_SOURCE_LINE 00001372 "=item *"
NSQ_SOURCE_LINE 00001373 ""
NSQ_SOURCE_LINE 00001374 "Parser does not care about I<how many times> check expression matches an input text."
NSQ_SOURCE_LINE 00001375 ""
NSQ_SOURCE_LINE 00001376 ""
NSQ_SOURCE_LINE 00001377 ""
NSQ_SOURCE_LINE 00001378 "=item *"
NSQ_SOURCE_LINE 00001379 ""
NSQ_SOURCE_LINE 00001380 "If at least I<one line> in a text matches the check expression - I<this check> is considered as successful."
NSQ_SOURCE_LINE 00001381 ""
NSQ_SOURCE_LINE 00001382 ""
NSQ_SOURCE_LINE 00001383 ""
NSQ_SOURCE_LINE 00001384 "=item *"
NSQ_SOURCE_LINE 00001385 ""
NSQ_SOURCE_LINE 00001386 "If you use I<capturing> regex expressions, parser  I<accumulates> all captured data to make it possible further processing."
NSQ_SOURCE_LINE 00001387 ""
NSQ_SOURCE_LINE 00001388 ""
NSQ_SOURCE_LINE 00001389 ""
NSQ_SOURCE_LINE 00001390 "=back"
NSQ_SOURCE_LINE 00001391 ""
NSQ_SOURCE_LINE 00001392 "Example:"
NSQ_SOURCE_LINE 00001393 ""
NSQ_SOURCE_LINE 00001394 "    use Outthentic::DSL;"
NSQ_SOURCE_LINE 00001395 "    use Data::Dumper;"
NSQ_SOURCE_LINE 00001396 "    "
NSQ_SOURCE_LINE 00001397 "    my $otx = Outthentic::DSL->new(<<'HERE');"
NSQ_SOURCE_LINE 00001398 "        1 - for one"
NSQ_SOURCE_LINE 00001399 "        2 - for two"
NSQ_SOURCE_LINE 00001400 "        3 - for three"
NSQ_SOURCE_LINE 00001401 "    HERE"
NSQ_SOURCE_LINE 00001402 "    "
NSQ_SOURCE_LINE 00001403 "    $otx->validate(<<'CHECK');"
NSQ_SOURCE_LINE 00001404 "    "
NSQ_SOURCE_LINE 00001405 "    regexp: (\\d+)\\s+-\\s+for\\s+(\\w+)"
NSQ_SOURCE_LINE 00001406 "    "
NSQ_SOURCE_LINE 00001407 "    CHECK"
NSQ_SOURCE_LINE 00001408 "    "
NSQ_SOURCE_LINE 00001409 "    print Dumper($otx->{captures});"
NSQ_SOURCE_LINE 00001410 ""
NSQ_SOURCE_LINE 00001411 "Output:"
NSQ_SOURCE_LINE 00001412 ""
NSQ_SOURCE_LINE 00001413 "    ["
NSQ_SOURCE_LINE 00001414 "      ["
NSQ_SOURCE_LINE 00001415 "        '1',"
NSQ_SOURCE_LINE 00001416 "        'one'"
NSQ_SOURCE_LINE 00001417 "      ],"
NSQ_SOURCE_LINE 00001418 "      ["
NSQ_SOURCE_LINE 00001419 "        '2',"
NSQ_SOURCE_LINE 00001420 "        'two'"
NSQ_SOURCE_LINE 00001421 "      ],"
NSQ_SOURCE_LINE 00001422 "      ["
NSQ_SOURCE_LINE 00001423 "        '3',"
NSQ_SOURCE_LINE 00001424 "        'three'"
NSQ_SOURCE_LINE 00001425 "      ]"
NSQ_SOURCE_LINE 00001426 "    ]"
NSQ_SOURCE_LINE 00001427 ""
NSQ_SOURCE_LINE 00001428 "See L<\"captures\"|#captures> section for full explanation of a captures mechanism."
NSQ_SOURCE_LINE 00001429 ""
NSQ_SOURCE_LINE 00001430 ""
NSQ_SOURCE_LINE 00001431 "=head1 Comments, blank lines and text blocks"
NSQ_SOURCE_LINE 00001432 ""
NSQ_SOURCE_LINE 00001433 "Comments and blank lines don't impact verification process but you may use them for the sake of DSL code readability."
NSQ_SOURCE_LINE 00001434 ""
NSQ_SOURCE_LINE 00001435 ""
NSQ_SOURCE_LINE 00001436 "=head1 Comments"
NSQ_SOURCE_LINE 00001437 ""
NSQ_SOURCE_LINE 00001438 "Comment lines start with C<#> symbol, comments are ignored by parser."
NSQ_SOURCE_LINE 00001439 ""
NSQ_SOURCE_LINE 00001440 "DSL code:"
NSQ_SOURCE_LINE 00001441 ""
NSQ_SOURCE_LINE 00001442 "    # comments could be represented at a distinct line, like here"
NSQ_SOURCE_LINE 00001443 "    The beginning of story"
NSQ_SOURCE_LINE 00001444 "    Hello World # or could be added for the existed expression to the right, like here"
NSQ_SOURCE_LINE 00001445 ""
NSQ_SOURCE_LINE 00001446 ""
NSQ_SOURCE_LINE 00001447 "=head1 Blank lines"
NSQ_SOURCE_LINE 00001448 ""
NSQ_SOURCE_LINE 00001449 "Blank lines are ignored as well."
NSQ_SOURCE_LINE 00001450 ""
NSQ_SOURCE_LINE 00001451 "DSL code:"
NSQ_SOURCE_LINE 00001452 ""
NSQ_SOURCE_LINE 00001453 "    # every story has the beginning"
NSQ_SOURCE_LINE 00001454 "    The beginning of a story"
NSQ_SOURCE_LINE 00001455 "    # then 2 blank lines"
NSQ_SOURCE_LINE 00001456 "    "
NSQ_SOURCE_LINE 00001457 "    "
NSQ_SOURCE_LINE 00001458 "    # end has the end"
NSQ_SOURCE_LINE 00001459 "    The end of a story"
NSQ_SOURCE_LINE 00001460 ""
NSQ_SOURCE_LINE 00001461 "But you B<can't ignore> blank lines in a I<text blocks>, see L<text blocks|#text-blocks> subsection for details."
NSQ_SOURCE_LINE 00001462 ""
NSQ_SOURCE_LINE 00001463 "Use C<:blank_line> marker to match blank lines inside text blocks."
NSQ_SOURCE_LINE 00001464 ""
NSQ_SOURCE_LINE 00001465 "DSL code:"
NSQ_SOURCE_LINE 00001466 ""
NSQ_SOURCE_LINE 00001467 "    # :blank_line marker matches blank lines"
NSQ_SOURCE_LINE 00001468 "    # this is especially useful"
NSQ_SOURCE_LINE 00001469 "    # when match in text blocks context:"
NSQ_SOURCE_LINE 00001470 "    "
NSQ_SOURCE_LINE 00001471 "    begin:"
NSQ_SOURCE_LINE 00001472 "        this line followed by 2 blank lines"
NSQ_SOURCE_LINE 00001473 "        :blank_line"
NSQ_SOURCE_LINE 00001474 "        :blank_line"
NSQ_SOURCE_LINE 00001475 "    end:"
NSQ_SOURCE_LINE 00001476 ""
NSQ_SOURCE_LINE 00001477 ""
NSQ_SOURCE_LINE 00001478 "=head1 Text blocks"
NSQ_SOURCE_LINE 00001479 ""
NSQ_SOURCE_LINE 00001480 "Sometimes you need to match a text against a I<sequence of lines> like in code below."
NSQ_SOURCE_LINE 00001481 ""
NSQ_SOURCE_LINE 00001482 "    use Outthentic::DSL;"
NSQ_SOURCE_LINE 00001483 "    "
NSQ_SOURCE_LINE 00001484 "    my $otx = Outthentic::DSL->new(<<'HERE');"
NSQ_SOURCE_LINE 00001485 "      this string followed by"
NSQ_SOURCE_LINE 00001486 "      that string followed by"
NSQ_SOURCE_LINE 00001487 "      another one string"
NSQ_SOURCE_LINE 00001488 "      with that string"
NSQ_SOURCE_LINE 00001489 "      at the very end."
NSQ_SOURCE_LINE 00001490 "    HERE"
NSQ_SOURCE_LINE 00001491 "    "
NSQ_SOURCE_LINE 00001492 "    $otx->validate(<<'CHECK');"
NSQ_SOURCE_LINE 00001493 "    "
NSQ_SOURCE_LINE 00001494 "      # this text block"
NSQ_SOURCE_LINE 00001495 "      # consists of 5 strings"
NSQ_SOURCE_LINE 00001496 "      # going consecutive"
NSQ_SOURCE_LINE 00001497 "      "
NSQ_SOURCE_LINE 00001498 "      begin:"
NSQ_SOURCE_LINE 00001499 "          # plain strings"
NSQ_SOURCE_LINE 00001500 "          this string followed by"
NSQ_SOURCE_LINE 00001501 "          that string followed by"
NSQ_SOURCE_LINE 00001502 "          another one"
NSQ_SOURCE_LINE 00001503 "          # regexp patterns:"
NSQ_SOURCE_LINE 00001504 "          regexp: with\\s+(this|that)"
NSQ_SOURCE_LINE 00001505 "          # and the last one in a block"
NSQ_SOURCE_LINE 00001506 "          at the very end"
NSQ_SOURCE_LINE 00001507 "      end:"
NSQ_SOURCE_LINE 00001508 "      "
NSQ_SOURCE_LINE 00001509 "    CHECK"
NSQ_SOURCE_LINE 00001510 "    "
NSQ_SOURCE_LINE 00001511 "    for my $r (@{$otx->results}) {"
NSQ_SOURCE_LINE 00001512 "        print $r->{status} ? 'true' : 'false', \"\\t\", $r->{message}, \"\\n\";"
NSQ_SOURCE_LINE 00001513 "    }"
NSQ_SOURCE_LINE 00001514 ""
NSQ_SOURCE_LINE 00001515 "Output:"
NSQ_SOURCE_LINE 00001516 ""
NSQ_SOURCE_LINE 00001517 "    true    [b] text has 'this string followed by'"
NSQ_SOURCE_LINE 00001518 "    true    [b] text has 'that string followed by'"
NSQ_SOURCE_LINE 00001519 "    true    [b] text has 'another one'"
NSQ_SOURCE_LINE 00001520 "    true    [b] text match /with\\s+(this|that)/"
NSQ_SOURCE_LINE 00001521 "    true    [b] text has 'at the very end'"
NSQ_SOURCE_LINE 00001522 ""
NSQ_SOURCE_LINE 00001523 "A negative example:"
NSQ_SOURCE_LINE 00001524 ""
NSQ_SOURCE_LINE 00001525 "    my $otx = Outthentic::DSL->new(<<'HERE');"
NSQ_SOURCE_LINE 00001526 "        that string followed by"
NSQ_SOURCE_LINE 00001527 "        this string followed by"
NSQ_SOURCE_LINE 00001528 "        another one string"
NSQ_SOURCE_LINE 00001529 "        with that string"
NSQ_SOURCE_LINE 00001530 "        at the very end."
NSQ_SOURCE_LINE 00001531 "    HERE"
NSQ_SOURCE_LINE 00001532 "    "
NSQ_SOURCE_LINE 00001533 "    $otx->validate(<<'CHECK');"
NSQ_SOURCE_LINE 00001534 "    "
NSQ_SOURCE_LINE 00001535 "      # this text block"
NSQ_SOURCE_LINE 00001536 "      # consists of 5 strings"
NSQ_SOURCE_LINE 00001537 "      # going consecutive"
NSQ_SOURCE_LINE 00001538 "      "
NSQ_SOURCE_LINE 00001539 "      begin:"
NSQ_SOURCE_LINE 00001540 "          # plain strings"
NSQ_SOURCE_LINE 00001541 "          this string followed by"
NSQ_SOURCE_LINE 00001542 "          that string followed by"
NSQ_SOURCE_LINE 00001543 "          another one"
NSQ_SOURCE_LINE 00001544 "          # regex patterns:"
NSQ_SOURCE_LINE 00001545 "          regexp: with\\s+(this|that)"
NSQ_SOURCE_LINE 00001546 "          # and the last one in a block"
NSQ_SOURCE_LINE 00001547 "          at the very end"
NSQ_SOURCE_LINE 00001548 "      end:"
NSQ_SOURCE_LINE 00001549 "      "
NSQ_SOURCE_LINE 00001550 "    CHECK"
NSQ_SOURCE_LINE 00001551 "    "
NSQ_SOURCE_LINE 00001552 "    for my $r (@{$otx->results}) {"
NSQ_SOURCE_LINE 00001553 "        print $r->{status} ? 'true' : 'false', \"\\t\", $r->{message}, \"\\n\";"
NSQ_SOURCE_LINE 00001554 "    }"
NSQ_SOURCE_LINE 00001555 ""
NSQ_SOURCE_LINE 00001556 "Output:"
NSQ_SOURCE_LINE 00001557 ""
NSQ_SOURCE_LINE 00001558 "    true    [b] text has 'this string followed by'"
NSQ_SOURCE_LINE 00001559 "    false   [b] text has 'that string followed by'"
NSQ_SOURCE_LINE 00001560 "    true    [b] text has 'another one'"
NSQ_SOURCE_LINE 00001561 "    true    [b] text match /with\\s+(this|that)/"
NSQ_SOURCE_LINE 00001562 "    true    [b] text has 'at the very end'"
NSQ_SOURCE_LINE 00001563 ""
NSQ_SOURCE_LINE 00001564 "C<begin:>, C<end:> markers decorate text blocks content. "
NSQ_SOURCE_LINE 00001565 ""
NSQ_SOURCE_LINE 00001566 "Markers should not be followed by any text at the same line."
NSQ_SOURCE_LINE 00001567 ""
NSQ_SOURCE_LINE 00001568 ""
NSQ_SOURCE_LINE 00001569 "=head2 Don't forget to close the block ..."
NSQ_SOURCE_LINE 00001570 ""
NSQ_SOURCE_LINE 00001571 "Be aware if you leave \"dangling\" C<begin:> marker without closing C<end:> parser will remain in a I<text block> mode "
NSQ_SOURCE_LINE 00001572 "till the end of the file, which is probably not you want:"
NSQ_SOURCE_LINE 00001573 ""
NSQ_SOURCE_LINE 00001574 "DSL code:"
NSQ_SOURCE_LINE 00001575 ""
NSQ_SOURCE_LINE 00001576 "    begin:"
NSQ_SOURCE_LINE 00001577 "        here we begin"
NSQ_SOURCE_LINE 00001578 "        and till the very end "
NSQ_SOURCE_LINE 00001579 "        of this text"
NSQ_SOURCE_LINE 00001580 "        we remain in `text block` mode"
NSQ_SOURCE_LINE 00001581 ""
NSQ_SOURCE_LINE 00001582 ""
NSQ_SOURCE_LINE 00001583 "=head1 Code expressions"
NSQ_SOURCE_LINE 00001584 ""
NSQ_SOURCE_LINE 00001585 "Code expressions are just a pieces of 'some language code' you may inline and execute B<during parsing> process."
NSQ_SOURCE_LINE 00001586 ""
NSQ_SOURCE_LINE 00001587 "By default, if I<language> is no set Perl language is assumed. Here is example:"
NSQ_SOURCE_LINE 00001588 ""
NSQ_SOURCE_LINE 00001589 "    use Outthentic::DSL;"
NSQ_SOURCE_LINE 00001590 "    "
NSQ_SOURCE_LINE 00001591 "    my $otx = Outthentic::DSL->new('hello');"
NSQ_SOURCE_LINE 00001592 "    "
NSQ_SOURCE_LINE 00001593 "    $otx->validate(<<'CHECK');"
NSQ_SOURCE_LINE 00001594 "      hello"
NSQ_SOURCE_LINE 00001595 "      code: print \"hi there!\\n\";"
NSQ_SOURCE_LINE 00001596 "    CHECK"
NSQ_SOURCE_LINE 00001597 "    "
NSQ_SOURCE_LINE 00001598 "    for my $r (@{$otx->results}) {"
NSQ_SOURCE_LINE 00001599 "        print $r->{status} ? 'true' : 'false', \"\\t\", $r->{message}, \"\\n\";"
NSQ_SOURCE_LINE 00001600 "    }"
NSQ_SOURCE_LINE 00001601 ""
NSQ_SOURCE_LINE 00001602 "Output:"
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "    hi there!"
NSQ_SOURCE_LINE 00001605 "    true    text has 'hello'"
NSQ_SOURCE_LINE 00001606 ""
NSQ_SOURCE_LINE 00001607 "As you may notice code expression here has no impact on verification process, this trivial example just shows"
NSQ_SOURCE_LINE 00001608 "that you may inline some programming languages code into Outthentic DSL. See L<generators|#generators> section on"
NSQ_SOURCE_LINE 00001609 "how dynamically create new check expressions using common programming languages."
NSQ_SOURCE_LINE 00001610 ""
NSQ_SOURCE_LINE 00001611 "You may use other languages in code expressions, not only Perl. "
NSQ_SOURCE_LINE 00001612 ""
NSQ_SOURCE_LINE 00001613 "Use C<here> document style ( see L<multiline expressions|#Multiline> section ) and proper shebang to"
NSQ_SOURCE_LINE 00001614 "insert code written in other languages. Here are some examples:"
NSQ_SOURCE_LINE 00001615 ""
NSQ_SOURCE_LINE 00001616 ""
NSQ_SOURCE_LINE 00001617 "=head2 perl5"
NSQ_SOURCE_LINE 00001618 ""
NSQ_SOURCE_LINE 00001619 "    code:  <<HERE"
NSQ_SOURCE_LINE 00001620 "    !perl"
NSQ_SOURCE_LINE 00001621 "    "
NSQ_SOURCE_LINE 00001622 "    print 'hi there!'"
NSQ_SOURCE_LINE 00001623 "    HERE"
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 ""
NSQ_SOURCE_LINE 00001626 "=head2 bash "
NSQ_SOURCE_LINE 00001627 ""
NSQ_SOURCE_LINE 00001628 "    code:  <<HERE"
NSQ_SOURCE_LINE 00001629 "    !bash"
NSQ_SOURCE_LINE 00001630 "    "
NSQ_SOURCE_LINE 00001631 "    echo 'hi there!'"
NSQ_SOURCE_LINE 00001632 "    HERE"
NSQ_SOURCE_LINE 00001633 ""
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "=head2 ruby"
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 "    code: <<CODE"
NSQ_SOURCE_LINE 00001638 "    !ruby"
NSQ_SOURCE_LINE 00001639 "    "
NSQ_SOURCE_LINE 00001640 "    puts 'hi there!'"
NSQ_SOURCE_LINE 00001641 "    CODE"
NSQ_SOURCE_LINE 00001642 ""
NSQ_SOURCE_LINE 00001643 ""
NSQ_SOURCE_LINE 00001644 "=head1 Asserts"
NSQ_SOURCE_LINE 00001645 ""
NSQ_SOURCE_LINE 00001646 "Asserts expressions consists of assert value, and description - a short string to describe assert."
NSQ_SOURCE_LINE 00001647 ""
NSQ_SOURCE_LINE 00001648 "Assert value should be I<something> to be treated as false or true in Perl, here is examples:"
NSQ_SOURCE_LINE 00001649 ""
NSQ_SOURCE_LINE 00001650 "DSL code"
NSQ_SOURCE_LINE 00001651 ""
NSQ_SOURCE_LINE 00001652 "    # you may have assert expressions as is"
NSQ_SOURCE_LINE 00001653 "    # then assert value should be Perl value to be treated as true or false"
NSQ_SOURCE_LINE 00001654 "    # "
NSQ_SOURCE_LINE 00001655 "    assert: 0     this is not true in Perl"
NSQ_SOURCE_LINE 00001656 "    assert: 1     this is true in Perl"
NSQ_SOURCE_LINE 00001657 "    assert: \"OK\"  none empty string is for true in Perl"
NSQ_SOURCE_LINE 00001658 "    assert: \"\"    empty string is for false in Perl"
NSQ_SOURCE_LINE 00001659 ""
NSQ_SOURCE_LINE 00001660 "Asserts almost always to be created dynamically with generators. See the next section."
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 ""
NSQ_SOURCE_LINE 00001663 "=head1 Generators"
NSQ_SOURCE_LINE 00001664 ""
NSQ_SOURCE_LINE 00001665 "=over"
NSQ_SOURCE_LINE 00001666 ""
NSQ_SOURCE_LINE 00001667 "=item *"
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 "Generators is the way to I<generate new Outthentic entities on the fly>."
NSQ_SOURCE_LINE 00001670 ""
NSQ_SOURCE_LINE 00001671 ""
NSQ_SOURCE_LINE 00001672 ""
NSQ_SOURCE_LINE 00001673 "=item *"
NSQ_SOURCE_LINE 00001674 ""
NSQ_SOURCE_LINE 00001675 "Generator expressions like code expressions are just a piece of code to be executed."
NSQ_SOURCE_LINE 00001676 ""
NSQ_SOURCE_LINE 00001677 ""
NSQ_SOURCE_LINE 00001678 ""
NSQ_SOURCE_LINE 00001679 "=item *"
NSQ_SOURCE_LINE 00001680 ""
NSQ_SOURCE_LINE 00001681 "The only requirement for generator code - it should return I<new Outthentic entities>."
NSQ_SOURCE_LINE 00001682 ""
NSQ_SOURCE_LINE 00001683 ""
NSQ_SOURCE_LINE 00001684 ""
NSQ_SOURCE_LINE 00001685 "=back"
NSQ_SOURCE_LINE 00001686 ""
NSQ_SOURCE_LINE 00001687 "If you use Perl in generator expressions ( which is by default ) - last statement in your"
NSQ_SOURCE_LINE 00001688 "code should be one of three:"
NSQ_SOURCE_LINE 00001689 ""
NSQ_SOURCE_LINE 00001690 "=over"
NSQ_SOURCE_LINE 00001691 ""
NSQ_SOURCE_LINE 00001692 "=item 1."
NSQ_SOURCE_LINE 00001693 ""
NSQ_SOURCE_LINE 00001694 "reference to array of strings where every string should I<represent> a I<new> Outthentic entity"
NSQ_SOURCE_LINE 00001695 ""
NSQ_SOURCE_LINE 00001696 ""
NSQ_SOURCE_LINE 00001697 "=item 2."
NSQ_SOURCE_LINE 00001698 ""
NSQ_SOURCE_LINE 00001699 "string to represent a I<new> Outthentic entities, this could be multiline string"
NSQ_SOURCE_LINE 00001700 ""
NSQ_SOURCE_LINE 00001701 ""
NSQ_SOURCE_LINE 00001702 "=item 3."
NSQ_SOURCE_LINE 00001703 ""
NSQ_SOURCE_LINE 00001704 "path to file with check expressions - new outthentic entities "
NSQ_SOURCE_LINE 00001705 ""
NSQ_SOURCE_LINE 00001706 ""
NSQ_SOURCE_LINE 00001707 "=back"
NSQ_SOURCE_LINE 00001708 ""
NSQ_SOURCE_LINE 00001709 "Usually first two options most convenient way."
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 "If you use languages I<other than Perl> to produce new Outthentic entities you should print them "
NSQ_SOURCE_LINE 00001712 "into B<stdout>. See examples below."
NSQ_SOURCE_LINE 00001713 ""
NSQ_SOURCE_LINE 00001714 "A new Outthentic entities are passed back to parser and executed immediately."
NSQ_SOURCE_LINE 00001715 ""
NSQ_SOURCE_LINE 00001716 "Generators expressions start with C<generator:> marker."
NSQ_SOURCE_LINE 00001717 ""
NSQ_SOURCE_LINE 00001718 "Here is simple example."
NSQ_SOURCE_LINE 00001719 ""
NSQ_SOURCE_LINE 00001720 "    use Outthentic::DSL;"
NSQ_SOURCE_LINE 00001721 "    "
NSQ_SOURCE_LINE 00001722 "    my $otx = Outthentic::DSL->new('HELLO');"
NSQ_SOURCE_LINE 00001723 "    "
NSQ_SOURCE_LINE 00001724 "    $otx->validate(<<'CHECK');"
NSQ_SOURCE_LINE 00001725 "      generator: [ 'H', 'E', 'L', 'O' ];"
NSQ_SOURCE_LINE 00001726 "    CHECK"
NSQ_SOURCE_LINE 00001727 "    "
NSQ_SOURCE_LINE 00001728 "    for my $r (@{$otx->results}) {"
NSQ_SOURCE_LINE 00001729 "        print $r->{status} ? 'true' : 'false', \"\\t\", $r->{message}, \"\\n\";"
NSQ_SOURCE_LINE 00001730 "    }"
NSQ_SOURCE_LINE 00001731 ""
NSQ_SOURCE_LINE 00001732 "Output:"
NSQ_SOURCE_LINE 00001733 ""
NSQ_SOURCE_LINE 00001734 "    true    text has 'H'"
NSQ_SOURCE_LINE 00001735 "    true    text has 'E'"
NSQ_SOURCE_LINE 00001736 "    true    text has 'L'"
NSQ_SOURCE_LINE 00001737 "    true    text has 'O'"
NSQ_SOURCE_LINE 00001738 ""
NSQ_SOURCE_LINE 00001739 "If you use other languages to generate expressions, "
NSQ_SOURCE_LINE 00001740 "you just need to print entries into stdout. Here are some generators examples for other languages:"
NSQ_SOURCE_LINE 00001741 ""
NSQ_SOURCE_LINE 00001742 "Original check expressions list:"
NSQ_SOURCE_LINE 00001743 ""
NSQ_SOURCE_LINE 00001744 "    Say"
NSQ_SOURCE_LINE 00001745 "    HELLO"
NSQ_SOURCE_LINE 00001746 ""
NSQ_SOURCE_LINE 00001747 "This generator creates 3 new check expressions:"
NSQ_SOURCE_LINE 00001748 ""
NSQ_SOURCE_LINE 00001749 "    generator: <<CODE"
NSQ_SOURCE_LINE 00001750 "    !bash"
NSQ_SOURCE_LINE 00001751 "      echo say"
NSQ_SOURCE_LINE 00001752 "      echo hello"
NSQ_SOURCE_LINE 00001753 "      echo again"
NSQ_SOURCE_LINE 00001754 "    CODE"
NSQ_SOURCE_LINE 00001755 ""
NSQ_SOURCE_LINE 00001756 "Or if you prefer Ruby:"
NSQ_SOURCE_LINE 00001757 ""
NSQ_SOURCE_LINE 00001758 "    generator: <<CODE"
NSQ_SOURCE_LINE 00001759 "    !ruby"
NSQ_SOURCE_LINE 00001760 "      puts 'say'"
NSQ_SOURCE_LINE 00001761 "      puts 'hello'"
NSQ_SOURCE_LINE 00001762 "      puts 'again'"
NSQ_SOURCE_LINE 00001763 "    CODE"
NSQ_SOURCE_LINE 00001764 ""
NSQ_SOURCE_LINE 00001765 "Updated check list:"
NSQ_SOURCE_LINE 00001766 ""
NSQ_SOURCE_LINE 00001767 "    Say"
NSQ_SOURCE_LINE 00001768 "    HELLO"
NSQ_SOURCE_LINE 00001769 "    say"
NSQ_SOURCE_LINE 00001770 "    hello"
NSQ_SOURCE_LINE 00001771 "    again"
NSQ_SOURCE_LINE 00001772 ""
NSQ_SOURCE_LINE 00001773 "Here is more complicated example using Perl language."
NSQ_SOURCE_LINE 00001774 ""
NSQ_SOURCE_LINE 00001775 "    # this generator creates"
NSQ_SOURCE_LINE 00001776 "    # comments"
NSQ_SOURCE_LINE 00001777 "    # and plain string check expressions:"
NSQ_SOURCE_LINE 00001778 "    "
NSQ_SOURCE_LINE 00001779 "    use Outthentic::DSL;"
NSQ_SOURCE_LINE 00001780 "    "
NSQ_SOURCE_LINE 00001781 "    my $otx = Outthentic::DSL->new(<<'HERE');"
NSQ_SOURCE_LINE 00001782 "      foo value"
NSQ_SOURCE_LINE 00001783 "      bar value"
NSQ_SOURCE_LINE 00001784 "    HERE"
NSQ_SOURCE_LINE 00001785 "    "
NSQ_SOURCE_LINE 00001786 "    $otx->validate(<<'CHECK');"
NSQ_SOURCE_LINE 00001787 "    "
NSQ_SOURCE_LINE 00001788 "        generator: <<CODE"
NSQ_SOURCE_LINE 00001789 "    "
NSQ_SOURCE_LINE 00001790 "          my %d = ( 'foo' => 'foo value', 'bar' => 'bar value' );"
NSQ_SOURCE_LINE 00001791 "          join \"\\n\", map { ( \"# $_\" , $d{$_} ) } keys %d;"
NSQ_SOURCE_LINE 00001792 "    "
NSQ_SOURCE_LINE 00001793 "        CODE"
NSQ_SOURCE_LINE 00001794 "    "
NSQ_SOURCE_LINE 00001795 "    CHECK"
NSQ_SOURCE_LINE 00001796 "    "
NSQ_SOURCE_LINE 00001797 "    for my $r (@{$otx->results}) {"
NSQ_SOURCE_LINE 00001798 "        print $r->{status} ? 'true' : 'false', \"\\t\", $r->{message}, \"\\n\";"
NSQ_SOURCE_LINE 00001799 "    }"
NSQ_SOURCE_LINE 00001800 ""
NSQ_SOURCE_LINE 00001801 "A check list being generated:"
NSQ_SOURCE_LINE 00001802 ""
NSQ_SOURCE_LINE 00001803 "    # foo"
NSQ_SOURCE_LINE 00001804 "    foo value"
NSQ_SOURCE_LINE 00001805 "    # bar"
NSQ_SOURCE_LINE 00001806 "    bar value"
NSQ_SOURCE_LINE 00001807 ""
NSQ_SOURCE_LINE 00001808 "Output:"
NSQ_SOURCE_LINE 00001809 ""
NSQ_SOURCE_LINE 00001810 "    true    text has 'foo value'"
NSQ_SOURCE_LINE 00001811 "    true    text has 'bar value'"
NSQ_SOURCE_LINE 00001812 ""
NSQ_SOURCE_LINE 00001813 "Generators could produce not only check expressions but code expressions and ... another generators."
NSQ_SOURCE_LINE 00001814 ""
NSQ_SOURCE_LINE 00001815 "So ... use your imagination power! ..."
NSQ_SOURCE_LINE 00001816 ""
NSQ_SOURCE_LINE 00001817 "This is fictional example."
NSQ_SOURCE_LINE 00001818 ""
NSQ_SOURCE_LINE 00001819 "Input Text:"
NSQ_SOURCE_LINE 00001820 ""
NSQ_SOURCE_LINE 00001821 "    A"
NSQ_SOURCE_LINE 00001822 "    AA"
NSQ_SOURCE_LINE 00001823 "    AAA"
NSQ_SOURCE_LINE 00001824 "    AAAA"
NSQ_SOURCE_LINE 00001825 "    AAAAA"
NSQ_SOURCE_LINE 00001826 ""
NSQ_SOURCE_LINE 00001827 "DSL code:"
NSQ_SOURCE_LINE 00001828 ""
NSQ_SOURCE_LINE 00001829 "    generator:  <<CODE"
NSQ_SOURCE_LINE 00001830 "    "
NSQ_SOURCE_LINE 00001831 "    sub next_number {                       "
NSQ_SOURCE_LINE 00001832 "        my $i = shift;                       "
NSQ_SOURCE_LINE 00001833 "        $i++;                               "
NSQ_SOURCE_LINE 00001834 "        return if $i>=5;                 "
NSQ_SOURCE_LINE 00001835 "        ["
NSQ_SOURCE_LINE 00001836 "          'regexp: ^'.('A' x $i).'$',      "
NSQ_SOURCE_LINE 00001837 "          \"generator: next_number(\".$i.\")\""
NSQ_SOURCE_LINE 00001838 "        ]"
NSQ_SOURCE_LINE 00001839 "    }"
NSQ_SOURCE_LINE 00001840 "    CODE"
NSQ_SOURCE_LINE 00001841 ""
NSQ_SOURCE_LINE 00001842 "Generators are commonly used to create an asserts. "
NSQ_SOURCE_LINE 00001843 ""
NSQ_SOURCE_LINE 00001844 "This is short example for Ruby language:"
NSQ_SOURCE_LINE 00001845 ""
NSQ_SOURCE_LINE 00001846 "    number: (\\d+)"
NSQ_SOURCE_LINE 00001847 "    "
NSQ_SOURCE_LINE 00001848 "    generator: <<CODE"
NSQ_SOURCE_LINE 00001849 "    !ruby"
NSQ_SOURCE_LINE 00001850 "        puts \"assert: #{capture()[0] == 10}, you've got 10!\"  "
NSQ_SOURCE_LINE 00001851 "    CODE"
NSQ_SOURCE_LINE 00001852 ""
NSQ_SOURCE_LINE 00001853 ""
NSQ_SOURCE_LINE 00001854 "=head1 Validators"
NSQ_SOURCE_LINE 00001855 ""
NSQ_SOURCE_LINE 00001856 "WARNING!!! You should prefer asserts over validators. Validators feature will be deprecated soon!"
NSQ_SOURCE_LINE 00001857 ""
NSQ_SOURCE_LINE 00001858 "Validator expressions are perl code expressions used for dynamic verification."
NSQ_SOURCE_LINE 00001859 ""
NSQ_SOURCE_LINE 00001860 "Validator expressions start with C<validator:> marker."
NSQ_SOURCE_LINE 00001861 ""
NSQ_SOURCE_LINE 00001862 "A Perl code inside validator block should I<return> array reference. "
NSQ_SOURCE_LINE 00001863 ""
NSQ_SOURCE_LINE 00001864 "=over"
NSQ_SOURCE_LINE 00001865 ""
NSQ_SOURCE_LINE 00001866 "=item *"
NSQ_SOURCE_LINE 00001867 ""
NSQ_SOURCE_LINE 00001868 "Once code is executed a returned array structure treated as:"
NSQ_SOURCE_LINE 00001869 ""
NSQ_SOURCE_LINE 00001870 ""
NSQ_SOURCE_LINE 00001871 ""
NSQ_SOURCE_LINE 00001872 "=item *"
NSQ_SOURCE_LINE 00001873 ""
NSQ_SOURCE_LINE 00001874 "first element - is a status number ( Perl true or false )"
NSQ_SOURCE_LINE 00001875 ""
NSQ_SOURCE_LINE 00001876 ""
NSQ_SOURCE_LINE 00001877 ""
NSQ_SOURCE_LINE 00001878 "=item *"
NSQ_SOURCE_LINE 00001879 ""
NSQ_SOURCE_LINE 00001880 "second element - is a helpful message "
NSQ_SOURCE_LINE 00001881 ""
NSQ_SOURCE_LINE 00001882 ""
NSQ_SOURCE_LINE 00001883 ""
NSQ_SOURCE_LINE 00001884 "=back"
NSQ_SOURCE_LINE 00001885 ""
NSQ_SOURCE_LINE 00001886 "Validators a kind of check expressions with check logic I<expressed> in program code. Here is examples:"
NSQ_SOURCE_LINE 00001887 ""
NSQ_SOURCE_LINE 00001888 "    # this is always true"
NSQ_SOURCE_LINE 00001889 "    validator: [ 10>1 , 'ten is bigger then one' ]"
NSQ_SOURCE_LINE 00001890 "    "
NSQ_SOURCE_LINE 00001891 "    # and this is not"
NSQ_SOURCE_LINE 00001892 "    validator: [ 1>10, 'one is bigger then ten'  ]"
NSQ_SOURCE_LINE 00001893 "    "
NSQ_SOURCE_LINE 00001894 "    # this one depends on previous check"
NSQ_SOURCE_LINE 00001895 "    regexp: credit card number: (\\d+)"
NSQ_SOURCE_LINE 00001896 "    validator: [ captures()[0][0] == '0101010101', 'I know your secrets!'  ]"
NSQ_SOURCE_LINE 00001897 "    "
NSQ_SOURCE_LINE 00001898 "    "
NSQ_SOURCE_LINE 00001899 "    # and this could be any"
NSQ_SOURCE_LINE 00001900 "    validator: [ int(rand(2)) > 1, 'I am lucky!'  ]"
NSQ_SOURCE_LINE 00001901 ""
NSQ_SOURCE_LINE 00001902 "Validators are often used in conjunction with the L<captures expressions|#captures>. This is another example."
NSQ_SOURCE_LINE 00001903 ""
NSQ_SOURCE_LINE 00001904 "Input text:"
NSQ_SOURCE_LINE 00001905 ""
NSQ_SOURCE_LINE 00001906 "    # my family ages list"
NSQ_SOURCE_LINE 00001907 "    alex    38"
NSQ_SOURCE_LINE 00001908 "    julia   32"
NSQ_SOURCE_LINE 00001909 "    jan     2"
NSQ_SOURCE_LINE 00001910 ""
NSQ_SOURCE_LINE 00001911 "DSL code:"
NSQ_SOURCE_LINE 00001912 ""
NSQ_SOURCE_LINE 00001913 "    # let's capture name and age chunks"
NSQ_SOURCE_LINE 00001914 "    regexp: /(\\w+)\\s+(\\d+)/"
NSQ_SOURCE_LINE 00001915 "    "
NSQ_SOURCE_LINE 00001916 "    validator: <<CODE"
NSQ_SOURCE_LINE 00001917 "    my $total=0;                        "
NSQ_SOURCE_LINE 00001918 "    for my $c (@{captures()}) {         "
NSQ_SOURCE_LINE 00001919 "        $total+=$c->[0];                "
NSQ_SOURCE_LINE 00001920 "    }                                   "
NSQ_SOURCE_LINE 00001921 "    [ ( $total == 72 ), \"total age\" ] "
NSQ_SOURCE_LINE 00001922 "    "
NSQ_SOURCE_LINE 00001923 "    CODE"
NSQ_SOURCE_LINE 00001924 ""
NSQ_SOURCE_LINE 00001925 ""
NSQ_SOURCE_LINE 00001926 "=head1 Multiline expressions"
NSQ_SOURCE_LINE 00001927 ""
NSQ_SOURCE_LINE 00001928 ""
NSQ_SOURCE_LINE 00001929 "=head2 Multilines in check expressions"
NSQ_SOURCE_LINE 00001930 ""
NSQ_SOURCE_LINE 00001931 "When parser parses check expressions it does it in a I<single line mode> :"
NSQ_SOURCE_LINE 00001932 ""
NSQ_SOURCE_LINE 00001933 "=over"
NSQ_SOURCE_LINE 00001934 ""
NSQ_SOURCE_LINE 00001935 "=item *"
NSQ_SOURCE_LINE 00001936 ""
NSQ_SOURCE_LINE 00001937 "check expression is always single line string"
NSQ_SOURCE_LINE 00001938 ""
NSQ_SOURCE_LINE 00001939 ""
NSQ_SOURCE_LINE 00001940 ""
NSQ_SOURCE_LINE 00001941 "=item *"
NSQ_SOURCE_LINE 00001942 ""
NSQ_SOURCE_LINE 00001943 "input text is parsed in line by line mode, thus every line is validated against a single line check expression"
NSQ_SOURCE_LINE 00001944 ""
NSQ_SOURCE_LINE 00001945 ""
NSQ_SOURCE_LINE 00001946 ""
NSQ_SOURCE_LINE 00001947 "=back"
NSQ_SOURCE_LINE 00001948 ""
NSQ_SOURCE_LINE 00001949 "Here is example."
NSQ_SOURCE_LINE 00001950 ""
NSQ_SOURCE_LINE 00001951 "Input text:"
NSQ_SOURCE_LINE 00001952 ""
NSQ_SOURCE_LINE 00001953 "    Multiline"
NSQ_SOURCE_LINE 00001954 "    string"
NSQ_SOURCE_LINE 00001955 "    here"
NSQ_SOURCE_LINE 00001956 ""
NSQ_SOURCE_LINE 00001957 "DSL code:"
NSQ_SOURCE_LINE 00001958 ""
NSQ_SOURCE_LINE 00001959 "    # check list"
NSQ_SOURCE_LINE 00001960 "    # always"
NSQ_SOURCE_LINE 00001961 "    # consists of"
NSQ_SOURCE_LINE 00001962 "    # single line expressions"
NSQ_SOURCE_LINE 00001963 "    "
NSQ_SOURCE_LINE 00001964 "    Multiline"
NSQ_SOURCE_LINE 00001965 "    string"
NSQ_SOURCE_LINE 00001966 "    here"
NSQ_SOURCE_LINE 00001967 "    regexp: Multiline \\n string \\n here"
NSQ_SOURCE_LINE 00001968 ""
NSQ_SOURCE_LINE 00001969 "Results:"
NSQ_SOURCE_LINE 00001970 ""
NSQ_SOURCE_LINE 00001971 "    +--------+---------------------------------------+"
NSQ_SOURCE_LINE 00001972 "    | status | message                               |"
NSQ_SOURCE_LINE 00001973 "    +--------+---------------------------------------+"
NSQ_SOURCE_LINE 00001974 "    | OK     | matches \"Multiline\"                   |"
NSQ_SOURCE_LINE 00001975 "    | OK     | matches \"string\"                      |"
NSQ_SOURCE_LINE 00001976 "    | OK     | matches \"here\"                        |"
NSQ_SOURCE_LINE 00001977 "    | FAIL   | matches /Multiline \\n string \\n here/ |"
NSQ_SOURCE_LINE 00001978 "    +--------+---------------------------------------+"
NSQ_SOURCE_LINE 00001979 ""
NSQ_SOURCE_LINE 00001980 "Use text blocks if you want to I<represent> multiline checks."
NSQ_SOURCE_LINE 00001981 ""
NSQ_SOURCE_LINE 00001982 ""
NSQ_SOURCE_LINE 00001983 "=head2 Multilines in code expressions, generators and validators"
NSQ_SOURCE_LINE 00001984 ""
NSQ_SOURCE_LINE 00001985 "Perl expressions, validators and generators could contain multilines expressions"
NSQ_SOURCE_LINE 00001986 ""
NSQ_SOURCE_LINE 00001987 "There are two ways to write multiline expressions:"
NSQ_SOURCE_LINE 00001988 ""
NSQ_SOURCE_LINE 00001989 "=over"
NSQ_SOURCE_LINE 00001990 ""
NSQ_SOURCE_LINE 00001991 "=item *"
NSQ_SOURCE_LINE 00001992 ""
NSQ_SOURCE_LINE 00001993 "using back slash delimiters to split multiline string to many chunks"
NSQ_SOURCE_LINE 00001994 ""
NSQ_SOURCE_LINE 00001995 ""
NSQ_SOURCE_LINE 00001996 ""
NSQ_SOURCE_LINE 00001997 "=item *"
NSQ_SOURCE_LINE 00001998 ""
NSQ_SOURCE_LINE 00001999 "using HERE documents expressions "
NSQ_SOURCE_LINE 00002000 ""
NSQ_SOURCE_LINE 00002001 ""
NSQ_SOURCE_LINE 00002002 ""
NSQ_SOURCE_LINE 00002003 "=back"
NSQ_SOURCE_LINE 00002004 ""
NSQ_SOURCE_LINE 00002005 ""
NSQ_SOURCE_LINE 00002006 "=head3 Back slash delimiters"
NSQ_SOURCE_LINE 00002007 ""
NSQ_SOURCE_LINE 00002008 "C<\\> delimiters breaks a single line text on a multi lines."
NSQ_SOURCE_LINE 00002009 ""
NSQ_SOURCE_LINE 00002010 "Example:"
NSQ_SOURCE_LINE 00002011 ""
NSQ_SOURCE_LINE 00002012 "    # What about to validate stdout"
NSQ_SOURCE_LINE 00002013 "    # With sqlite database entries?"
NSQ_SOURCE_LINE 00002014 "    "
NSQ_SOURCE_LINE 00002015 "    generator:                                                          \\"
NSQ_SOURCE_LINE 00002016 "    "
NSQ_SOURCE_LINE 00002017 "    use DBI;                                                            \\"
NSQ_SOURCE_LINE 00002018 "    my $dbh = DBI->connect(\"dbi:SQLite:dbname=t/data/test.db\",\"\",\"\");   \\"
NSQ_SOURCE_LINE 00002019 "    my $sth = $dbh->prepare(\"SELECT name from users\");                  \\"
NSQ_SOURCE_LINE 00002020 "    $sth->execute();                                                    \\"
NSQ_SOURCE_LINE 00002021 "    my $results = $sth->fetchall_arrayref;                              \\"
NSQ_SOURCE_LINE 00002022 "    "
NSQ_SOURCE_LINE 00002023 "    [ map { $_->[0] } @${results} ]                                     \\"
NSQ_SOURCE_LINE 00002024 ""
NSQ_SOURCE_LINE 00002025 ""
NSQ_SOURCE_LINE 00002026 "=head3 HERE documents expressions "
NSQ_SOURCE_LINE 00002027 ""
NSQ_SOURCE_LINE 00002028 "Is alternative to make your multiline code more readable:"
NSQ_SOURCE_LINE 00002029 ""
NSQ_SOURCE_LINE 00002030 "    # What about to validate stdout"
NSQ_SOURCE_LINE 00002031 "    # With sqlite database entries?"
NSQ_SOURCE_LINE 00002032 "    "
NSQ_SOURCE_LINE 00002033 "    generator: <<CODE"
NSQ_SOURCE_LINE 00002034 "    "
NSQ_SOURCE_LINE 00002035 "      use DBI;                                                            "
NSQ_SOURCE_LINE 00002036 "      my $dbh = DBI->connect(\"dbi:SQLite:dbname=t/data/test.db\",\"\",\"\");   "
NSQ_SOURCE_LINE 00002037 "      my $sth = $dbh->prepare(\"SELECT name from users\");                  "
NSQ_SOURCE_LINE 00002038 "      $sth->execute();                                                    "
NSQ_SOURCE_LINE 00002039 "      my $results = $sth->fetchall_arrayref;                              "
NSQ_SOURCE_LINE 00002040 "      "
NSQ_SOURCE_LINE 00002041 "      [ map { $_->[0] } @${results} ]"
NSQ_SOURCE_LINE 00002042 "      "
NSQ_SOURCE_LINE 00002043 "    CODE"
NSQ_SOURCE_LINE 00002044 ""
NSQ_SOURCE_LINE 00002045 ""
NSQ_SOURCE_LINE 00002046 "=head1 Captures"
NSQ_SOURCE_LINE 00002047 ""
NSQ_SOURCE_LINE 00002048 "Captures are pieces of data get captured when parser validate lines against a regular expressions:"
NSQ_SOURCE_LINE 00002049 ""
NSQ_SOURCE_LINE 00002050 "Input text:"
NSQ_SOURCE_LINE 00002051 ""
NSQ_SOURCE_LINE 00002052 "    # my family ages list."
NSQ_SOURCE_LINE 00002053 "    alex    38"
NSQ_SOURCE_LINE 00002054 "    julia   32"
NSQ_SOURCE_LINE 00002055 "    jan     2"
NSQ_SOURCE_LINE 00002056 "    "
NSQ_SOURCE_LINE 00002057 "    "
NSQ_SOURCE_LINE 00002058 "    # let's capture name and age chunks"
NSQ_SOURCE_LINE 00002059 "    regexp: /(\\w+)\\s+(\\d+)/"
NSQ_SOURCE_LINE 00002060 "    code: << CODE                                 "
NSQ_SOURCE_LINE 00002061 "        for my $c (@{captures}){            "
NSQ_SOURCE_LINE 00002062 "            print \"name:\", $c->[0], \"\\n\";   "
NSQ_SOURCE_LINE 00002063 "            print \"age:\", $c->[1], \"\\n\";    "
NSQ_SOURCE_LINE 00002064 "        }"
NSQ_SOURCE_LINE 00002065 "    CODE"
NSQ_SOURCE_LINE 00002066 ""
NSQ_SOURCE_LINE 00002067 "Data accessible via captures():"
NSQ_SOURCE_LINE 00002068 ""
NSQ_SOURCE_LINE 00002069 "    ["
NSQ_SOURCE_LINE 00002070 "        ['alex',    38 ]"
NSQ_SOURCE_LINE 00002071 "        ['julia',   32 ]"
NSQ_SOURCE_LINE 00002072 "        ['jan',     2  ]"
NSQ_SOURCE_LINE 00002073 "    ]"
NSQ_SOURCE_LINE 00002074 ""
NSQ_SOURCE_LINE 00002075 "Usually captured data is good candidates for assert checks."
NSQ_SOURCE_LINE 00002076 ""
NSQ_SOURCE_LINE 00002077 "DSL code:"
NSQ_SOURCE_LINE 00002078 ""
NSQ_SOURCE_LINE 00002079 "    generator: << CODE"
NSQ_SOURCE_LINE 00002080 "    !ruby"
NSQ_SOURCE_LINE 00002081 "      total=0                 "
NSQ_SOURCE_LINE 00002082 "      captures().each do |c|"
NSQ_SOURCE_LINE 00002083 "        total+=c[0]"
NSQ_SOURCE_LINE 00002084 "      end           "
NSQ_SOURCE_LINE 00002085 "      puts \"assert: #{total == 72} 'total age of my family'\""
NSQ_SOURCE_LINE 00002086 "    CODE"
NSQ_SOURCE_LINE 00002087 ""
NSQ_SOURCE_LINE 00002088 ""
NSQ_SOURCE_LINE 00002089 "=head2 captures() function"
NSQ_SOURCE_LINE 00002090 ""
NSQ_SOURCE_LINE 00002091 "captures() function returns an array reference holding all the chunks captured during I<latest regular expression check>."
NSQ_SOURCE_LINE 00002092 ""
NSQ_SOURCE_LINE 00002093 "Here is another example:"
NSQ_SOURCE_LINE 00002094 ""
NSQ_SOURCE_LINE 00002095 "    # check if stdout contains lines"
NSQ_SOURCE_LINE 00002096 "    # with date formatted as date: YYYY-MM-DD"
NSQ_SOURCE_LINE 00002097 "    # and then check if first date found is yesterday"
NSQ_SOURCE_LINE 00002098 "    "
NSQ_SOURCE_LINE 00002099 "    regexp: date: (\\d\\d\\d\\d)-(\\d\\d)-(\\d\\d)"
NSQ_SOURCE_LINE 00002100 "    "
NSQ_SOURCE_LINE 00002101 "    generator:  <<CODE"
NSQ_SOURCE_LINE 00002102 "      use DateTime;                       "
NSQ_SOURCE_LINE 00002103 "      my $c = captures()->[0];            "
NSQ_SOURCE_LINE 00002104 "      my $dt = DateTime->new( year => $c->[0], month => $c->[1], day => $c->[2]  ); "
NSQ_SOURCE_LINE 00002105 "      my $yesterday = DateTime->now->subtract( days =>  1 );                        "
NSQ_SOURCE_LINE 00002106 "      my $true_or_false = (DateTime->compare($dt, $yesterday) == 0);"
NSQ_SOURCE_LINE 00002107 "      [ "
NSQ_SOURCE_LINE 00002108 "        \"assert: $true_or_false first day found is - $dt and this is a yesterday\""
NSQ_SOURCE_LINE 00002109 "      ];"
NSQ_SOURCE_LINE 00002110 "    CODE"
NSQ_SOURCE_LINE 00002111 ""
NSQ_SOURCE_LINE 00002112 ""
NSQ_SOURCE_LINE 00002113 "=head2 capture() function"
NSQ_SOURCE_LINE 00002114 ""
NSQ_SOURCE_LINE 00002115 "capture() function returns a I<first element> of captures array. "
NSQ_SOURCE_LINE 00002116 ""
NSQ_SOURCE_LINE 00002117 "it is useful when you need data I<related> only  I<first> successfully matched line."
NSQ_SOURCE_LINE 00002118 ""
NSQ_SOURCE_LINE 00002119 "DSL code:"
NSQ_SOURCE_LINE 00002120 ""
NSQ_SOURCE_LINE 00002121 "    # check if  text contains numbers"
NSQ_SOURCE_LINE 00002122 "    # a first number should be greater then ten"
NSQ_SOURCE_LINE 00002123 "    "
NSQ_SOURCE_LINE 00002124 "    regexp: (\\d+)"
NSQ_SOURCE_LINE 00002125 "    generator: [ \"assert: \".( capture()->[0] >  10 ).\" first number is greater than 10 \" ]"
NSQ_SOURCE_LINE 00002126 ""
NSQ_SOURCE_LINE 00002127 ""
NSQ_SOURCE_LINE 00002128 "=head1 Search context modificators"
NSQ_SOURCE_LINE 00002129 ""
NSQ_SOURCE_LINE 00002130 "Search context modificators are special check expressions which not only validate text but modify search context."
NSQ_SOURCE_LINE 00002131 ""
NSQ_SOURCE_LINE 00002132 "By default search context is equal to original input text stream. "
NSQ_SOURCE_LINE 00002133 ""
NSQ_SOURCE_LINE 00002134 "That means parser executes validation use all the lines when performing checks "
NSQ_SOURCE_LINE 00002135 ""
NSQ_SOURCE_LINE 00002136 "However there are two search context modificators to change this behavior:"
NSQ_SOURCE_LINE 00002137 ""
NSQ_SOURCE_LINE 00002138 "=over"
NSQ_SOURCE_LINE 00002139 ""
NSQ_SOURCE_LINE 00002140 "=item *"
NSQ_SOURCE_LINE 00002141 ""
NSQ_SOURCE_LINE 00002142 "within expressions"
NSQ_SOURCE_LINE 00002143 ""
NSQ_SOURCE_LINE 00002144 ""
NSQ_SOURCE_LINE 00002145 ""
NSQ_SOURCE_LINE 00002146 "=item *"
NSQ_SOURCE_LINE 00002147 ""
NSQ_SOURCE_LINE 00002148 "range expressions"
NSQ_SOURCE_LINE 00002149 ""
NSQ_SOURCE_LINE 00002150 ""
NSQ_SOURCE_LINE 00002151 ""
NSQ_SOURCE_LINE 00002152 "=back"
NSQ_SOURCE_LINE 00002153 ""
NSQ_SOURCE_LINE 00002154 ""
NSQ_SOURCE_LINE 00002155 "=head2 Within expressions"
NSQ_SOURCE_LINE 00002156 ""
NSQ_SOURCE_LINE 00002157 "Within expression acts like regular expression - checks text against given patterns "
NSQ_SOURCE_LINE 00002158 ""
NSQ_SOURCE_LINE 00002159 "Text input:"
NSQ_SOURCE_LINE 00002160 ""
NSQ_SOURCE_LINE 00002161 "    These are my colors"
NSQ_SOURCE_LINE 00002162 "    "
NSQ_SOURCE_LINE 00002163 "    color: red"
NSQ_SOURCE_LINE 00002164 "    color: green"
NSQ_SOURCE_LINE 00002165 "    color: blue"
NSQ_SOURCE_LINE 00002166 "    color: brown"
NSQ_SOURCE_LINE 00002167 "    color: back"
NSQ_SOURCE_LINE 00002168 "    "
NSQ_SOURCE_LINE 00002169 "    That is it!"
NSQ_SOURCE_LINE 00002170 ""
NSQ_SOURCE_LINE 00002171 "DSL code:"
NSQ_SOURCE_LINE 00002172 ""
NSQ_SOURCE_LINE 00002173 "    # I need one of 3 colors:"
NSQ_SOURCE_LINE 00002174 "    "
NSQ_SOURCE_LINE 00002175 "    within: color: (red|green|blue)"
NSQ_SOURCE_LINE 00002176 ""
NSQ_SOURCE_LINE 00002177 "Then if checks given by within statement succeed I<next> checks will be executed I<in a context of> succeeded lines:"
NSQ_SOURCE_LINE 00002178 ""
NSQ_SOURCE_LINE 00002179 "    # but I really need a green one"
NSQ_SOURCE_LINE 00002180 "    green"
NSQ_SOURCE_LINE 00002181 ""
NSQ_SOURCE_LINE 00002182 "The code above does follows:"
NSQ_SOURCE_LINE 00002183 ""
NSQ_SOURCE_LINE 00002184 "=over"
NSQ_SOURCE_LINE 00002185 ""
NSQ_SOURCE_LINE 00002186 "=item *"
NSQ_SOURCE_LINE 00002187 ""
NSQ_SOURCE_LINE 00002188 "try to validate input text against regular expression \"color: (red|green|blue)\""
NSQ_SOURCE_LINE 00002189 ""
NSQ_SOURCE_LINE 00002190 ""
NSQ_SOURCE_LINE 00002191 ""
NSQ_SOURCE_LINE 00002192 "=item *"
NSQ_SOURCE_LINE 00002193 ""
NSQ_SOURCE_LINE 00002194 "if validation is successful new search context is set to all I<matching> lines"
NSQ_SOURCE_LINE 00002195 ""
NSQ_SOURCE_LINE 00002196 ""
NSQ_SOURCE_LINE 00002197 ""
NSQ_SOURCE_LINE 00002198 "=back"
NSQ_SOURCE_LINE 00002199 ""
NSQ_SOURCE_LINE 00002200 "These are:"
NSQ_SOURCE_LINE 00002201 ""
NSQ_SOURCE_LINE 00002202 "    color: red"
NSQ_SOURCE_LINE 00002203 "    color: green"
NSQ_SOURCE_LINE 00002204 "    color: blue"
NSQ_SOURCE_LINE 00002205 ""
NSQ_SOURCE_LINE 00002206 "=over"
NSQ_SOURCE_LINE 00002207 ""
NSQ_SOURCE_LINE 00002208 "=item *"
NSQ_SOURCE_LINE 00002209 ""
NSQ_SOURCE_LINE 00002210 "thus next plain string checks expression will be executed against new search context"
NSQ_SOURCE_LINE 00002211 ""
NSQ_SOURCE_LINE 00002212 ""
NSQ_SOURCE_LINE 00002213 "=back"
NSQ_SOURCE_LINE 00002214 ""
NSQ_SOURCE_LINE 00002215 "Results:"
NSQ_SOURCE_LINE 00002216 ""
NSQ_SOURCE_LINE 00002217 "    +--------+------------------------------------------------+"
NSQ_SOURCE_LINE 00002218 "    | status | message                                        |"
NSQ_SOURCE_LINE 00002219 "    +--------+------------------------------------------------+"
NSQ_SOURCE_LINE 00002220 "    | OK     | matches /color: (red|green|blue)/              |"
NSQ_SOURCE_LINE 00002221 "    | OK     | /color: (red|green|blue)/ matches green        |"
NSQ_SOURCE_LINE 00002222 "    +--------+------------------------------------------------+"
NSQ_SOURCE_LINE 00002223 ""
NSQ_SOURCE_LINE 00002224 "Here more examples:"
NSQ_SOURCE_LINE 00002225 ""
NSQ_SOURCE_LINE 00002226 "    # try to find a date string in following format"
NSQ_SOURCE_LINE 00002227 "    within: date: \\d\\d\\d\\d-\\d\\d-\\d\\d"
NSQ_SOURCE_LINE 00002228 "    "
NSQ_SOURCE_LINE 00002229 "    # we only need a dates in 2000 year"
NSQ_SOURCE_LINE 00002230 "    2000-"
NSQ_SOURCE_LINE 00002231 ""
NSQ_SOURCE_LINE 00002232 "Within expressions could be sequential, which effectively means using C<&&> logical operators for within expressions:"
NSQ_SOURCE_LINE 00002233 ""
NSQ_SOURCE_LINE 00002234 "    # try to find a date string in following format"
NSQ_SOURCE_LINE 00002235 "    within: date: \\d\\d\\d\\d-\\d\\d-\\d\\d"
NSQ_SOURCE_LINE 00002236 "    "
NSQ_SOURCE_LINE 00002237 "    # and try to find year of 2000 in a date string"
NSQ_SOURCE_LINE 00002238 "    within: 2000-\\d\\d-\\d\\d"
NSQ_SOURCE_LINE 00002239 "    "
NSQ_SOURCE_LINE 00002240 "    # and try to find month 04 in a date string"
NSQ_SOURCE_LINE 00002241 "    within: \\d\\d\\d\\d-04-\\d\\d"
NSQ_SOURCE_LINE 00002242 ""
NSQ_SOURCE_LINE 00002243 "Speaking in human language chained within expressions acts like I<specifications>. "
NSQ_SOURCE_LINE 00002244 ""
NSQ_SOURCE_LINE 00002245 "When you may start with some generic assumptions and then make your requirements more specific. A failure on any step of chain results in"
NSQ_SOURCE_LINE 00002246 "immediate break. "
NSQ_SOURCE_LINE 00002247 ""
NSQ_SOURCE_LINE 00002248 ""
NSQ_SOURCE_LINE 00002249 "=head1 Range expressions"
NSQ_SOURCE_LINE 00002250 ""
NSQ_SOURCE_LINE 00002251 "Range expressions also act like I<search context modificators> - they change search area to one included"
NSQ_SOURCE_LINE 00002252 "I<between> lines matching right and left regular expression of between statement."
NSQ_SOURCE_LINE 00002253 ""
NSQ_SOURCE_LINE 00002254 "It is very similar to what Perl L<range operator|http://perldoc.perl.org/perlop.html#Range-Operators> does "
NSQ_SOURCE_LINE 00002255 "when extracting pieces of lines inside stream:"
NSQ_SOURCE_LINE 00002256 ""
NSQ_SOURCE_LINE 00002257 "    while (<STDOUT>){"
NSQ_SOURCE_LINE 00002258 "        if /foo/ ... /bar/"
NSQ_SOURCE_LINE 00002259 "    }"
NSQ_SOURCE_LINE 00002260 ""
NSQ_SOURCE_LINE 00002261 "Outthentic analogy for this is range expression:"
NSQ_SOURCE_LINE 00002262 ""
NSQ_SOURCE_LINE 00002263 "    between: foo bar"
NSQ_SOURCE_LINE 00002264 ""
NSQ_SOURCE_LINE 00002265 "Between statement takes 2 arguments - left and right regular expression to setup search area boundaries."
NSQ_SOURCE_LINE 00002266 ""
NSQ_SOURCE_LINE 00002267 "A search context will be all the lines included between line matching left expression and line matching right expression."
NSQ_SOURCE_LINE 00002268 ""
NSQ_SOURCE_LINE 00002269 "A matching (boundary) lines are not included in range. "
NSQ_SOURCE_LINE 00002270 ""
NSQ_SOURCE_LINE 00002271 "These are few examples:"
NSQ_SOURCE_LINE 00002272 ""
NSQ_SOURCE_LINE 00002273 "Parsing html output"
NSQ_SOURCE_LINE 00002274 ""
NSQ_SOURCE_LINE 00002275 "Input text:"
NSQ_SOURCE_LINE 00002276 ""
NSQ_SOURCE_LINE 00002277 "    <table cols=10 rows=10>"
NSQ_SOURCE_LINE 00002278 "        <tr>"
NSQ_SOURCE_LINE 00002279 "            <td>one</td>"
NSQ_SOURCE_LINE 00002280 "        </tr>"
NSQ_SOURCE_LINE 00002281 "        <tr>"
NSQ_SOURCE_LINE 00002282 "            <td>two</td>"
NSQ_SOURCE_LINE 00002283 "        </tr>"
NSQ_SOURCE_LINE 00002284 "        <tr>"
NSQ_SOURCE_LINE 00002285 "            <td>the</td>"
NSQ_SOURCE_LINE 00002286 "        </tr>"
NSQ_SOURCE_LINE 00002287 "    </table>"
NSQ_SOURCE_LINE 00002288 ""
NSQ_SOURCE_LINE 00002289 "DSL code:"
NSQ_SOURCE_LINE 00002290 ""
NSQ_SOURCE_LINE 00002291 "    # between expression:"
NSQ_SOURCE_LINE 00002292 "    between: <table.*> <\\/table>"
NSQ_SOURCE_LINE 00002293 "    regexp: <td>(\\S+)<\\/td>"
NSQ_SOURCE_LINE 00002294 "    "
NSQ_SOURCE_LINE 00002295 "    # or even so"
NSQ_SOURCE_LINE 00002296 "    between: <tr.*> <\\/tr>"
NSQ_SOURCE_LINE 00002297 "    regexp: <td>(\\S+)<\\/td>"
NSQ_SOURCE_LINE 00002298 ""
NSQ_SOURCE_LINE 00002299 ""
NSQ_SOURCE_LINE 00002300 "=head2 Multiple range expressions"
NSQ_SOURCE_LINE 00002301 ""
NSQ_SOURCE_LINE 00002302 "Multiple range expressions could not be nested, every new between statement discards old search context and setup new one:"
NSQ_SOURCE_LINE 00002303 ""
NSQ_SOURCE_LINE 00002304 "Input text:"
NSQ_SOURCE_LINE 00002305 ""
NSQ_SOURCE_LINE 00002306 "    foo"
NSQ_SOURCE_LINE 00002307 "    "
NSQ_SOURCE_LINE 00002308 "        1"
NSQ_SOURCE_LINE 00002309 "        2"
NSQ_SOURCE_LINE 00002310 "        3"
NSQ_SOURCE_LINE 00002311 "    "
NSQ_SOURCE_LINE 00002312 "        FOO"
NSQ_SOURCE_LINE 00002313 "            100"
NSQ_SOURCE_LINE 00002314 "        BAR"
NSQ_SOURCE_LINE 00002315 "    "
NSQ_SOURCE_LINE 00002316 "    bar"
NSQ_SOURCE_LINE 00002317 "    "
NSQ_SOURCE_LINE 00002318 "    FOO"
NSQ_SOURCE_LINE 00002319 "    "
NSQ_SOURCE_LINE 00002320 "        10"
NSQ_SOURCE_LINE 00002321 "        20"
NSQ_SOURCE_LINE 00002322 "        30"
NSQ_SOURCE_LINE 00002323 "    "
NSQ_SOURCE_LINE 00002324 "    BAR"
NSQ_SOURCE_LINE 00002325 ""
NSQ_SOURCE_LINE 00002326 "DSL code:"
NSQ_SOURCE_LINE 00002327 ""
NSQ_SOURCE_LINE 00002328 "    between: foo bar"
NSQ_SOURCE_LINE 00002329 "    "
NSQ_SOURCE_LINE 00002330 "    code: print \"# foo/bar start\""
NSQ_SOURCE_LINE 00002331 "    "
NSQ_SOURCE_LINE 00002332 "    # here will be everything"
NSQ_SOURCE_LINE 00002333 "    # between foo and bar lines"
NSQ_SOURCE_LINE 00002334 "    "
NSQ_SOURCE_LINE 00002335 "    regexp: \\d+"
NSQ_SOURCE_LINE 00002336 "    "
NSQ_SOURCE_LINE 00002337 "    code: <<CODE                           "
NSQ_SOURCE_LINE 00002338 "    for my $i (@{captures()}) {     "
NSQ_SOURCE_LINE 00002339 "        print \"# \", $i->[0], \"\\n\"   "
NSQ_SOURCE_LINE 00002340 "    }                               "
NSQ_SOURCE_LINE 00002341 "    print \"# foo/bar end\""
NSQ_SOURCE_LINE 00002342 "    "
NSQ_SOURCE_LINE 00002343 "    CODE"
NSQ_SOURCE_LINE 00002344 "    "
NSQ_SOURCE_LINE 00002345 "    between: FOO BAR"
NSQ_SOURCE_LINE 00002346 "    "
NSQ_SOURCE_LINE 00002347 "    code: print \"# FOO/BAR start\""
NSQ_SOURCE_LINE 00002348 "    "
NSQ_SOURCE_LINE 00002349 "    # here will be everything"
NSQ_SOURCE_LINE 00002350 "    # between FOO and BAR lines"
NSQ_SOURCE_LINE 00002351 "    # NOT necessarily inside foo bar block"
NSQ_SOURCE_LINE 00002352 "    "
NSQ_SOURCE_LINE 00002353 "    regexp: \\d+"
NSQ_SOURCE_LINE 00002354 "    "
NSQ_SOURCE_LINE 00002355 "    code:  <<CODE"
NSQ_SOURCE_LINE 00002356 "    for my $i (@{captures()}) {     "
NSQ_SOURCE_LINE 00002357 "        print \"#\", $i->[0], \"\\n\";   "
NSQ_SOURCE_LINE 00002358 "    }                               "
NSQ_SOURCE_LINE 00002359 "    print \"# FOO/BAR end\""
NSQ_SOURCE_LINE 00002360 "    "
NSQ_SOURCE_LINE 00002361 "    CODE"
NSQ_SOURCE_LINE 00002362 ""
NSQ_SOURCE_LINE 00002363 "Output:"
NSQ_SOURCE_LINE 00002364 ""
NSQ_SOURCE_LINE 00002365 "    # foo/bar start"
NSQ_SOURCE_LINE 00002366 "    # 1"
NSQ_SOURCE_LINE 00002367 "    # 2"
NSQ_SOURCE_LINE 00002368 "    # 3"
NSQ_SOURCE_LINE 00002369 "    # 100"
NSQ_SOURCE_LINE 00002370 "    # foo/bar end"
NSQ_SOURCE_LINE 00002371 "    "
NSQ_SOURCE_LINE 00002372 "    # FOO/BAR start"
NSQ_SOURCE_LINE 00002373 "    # 100"
NSQ_SOURCE_LINE 00002374 "    # 10"
NSQ_SOURCE_LINE 00002375 "    # 20"
NSQ_SOURCE_LINE 00002376 "    # 30"
NSQ_SOURCE_LINE 00002377 "    # FOO/BAR end"
NSQ_SOURCE_LINE 00002378 ""
NSQ_SOURCE_LINE 00002379 ""
NSQ_SOURCE_LINE 00002380 "=head2 Restoring search context"
NSQ_SOURCE_LINE 00002381 ""
NSQ_SOURCE_LINE 00002382 "And finally to restore search context use C<reset\\_context:> statement."
NSQ_SOURCE_LINE 00002383 ""
NSQ_SOURCE_LINE 00002384 "Input text:"
NSQ_SOURCE_LINE 00002385 ""
NSQ_SOURCE_LINE 00002386 "    hello"
NSQ_SOURCE_LINE 00002387 "    foo"
NSQ_SOURCE_LINE 00002388 "        hello"
NSQ_SOURCE_LINE 00002389 "        hello"
NSQ_SOURCE_LINE 00002390 "    bar"
NSQ_SOURCE_LINE 00002391 ""
NSQ_SOURCE_LINE 00002392 "DSL code:"
NSQ_SOURCE_LINE 00002393 ""
NSQ_SOURCE_LINE 00002394 "    between foo bar"
NSQ_SOURCE_LINE 00002395 "    "
NSQ_SOURCE_LINE 00002396 "    # all check expressions here"
NSQ_SOURCE_LINE 00002397 "    # will be applied to the chunks"
NSQ_SOURCE_LINE 00002398 "    # between /foo/ ... /bar/"
NSQ_SOURCE_LINE 00002399 "    "
NSQ_SOURCE_LINE 00002400 "    hello       # should match 2 times"
NSQ_SOURCE_LINE 00002401 "    "
NSQ_SOURCE_LINE 00002402 "    # if you want to get back to an original search context"
NSQ_SOURCE_LINE 00002403 "    # just say reset_context:"
NSQ_SOURCE_LINE 00002404 "    "
NSQ_SOURCE_LINE 00002405 "    reset_context:"
NSQ_SOURCE_LINE 00002406 "    hello       # should match three times"
NSQ_SOURCE_LINE 00002407 ""
NSQ_SOURCE_LINE 00002408 ""
NSQ_SOURCE_LINE 00002409 "=head2 Range expressions caveats"
NSQ_SOURCE_LINE 00002410 ""
NSQ_SOURCE_LINE 00002411 "Range expressions can't verify continuous lists."
NSQ_SOURCE_LINE 00002412 ""
NSQ_SOURCE_LINE 00002413 "That means range expression only verifies that there are I<some set> of lines inside some range."
NSQ_SOURCE_LINE 00002414 "It is not necessary should be continuous."
NSQ_SOURCE_LINE 00002415 ""
NSQ_SOURCE_LINE 00002416 "Example."
NSQ_SOURCE_LINE 00002417 ""
NSQ_SOURCE_LINE 00002418 "Input text:"
NSQ_SOURCE_LINE 00002419 ""
NSQ_SOURCE_LINE 00002420 "    foo"
NSQ_SOURCE_LINE 00002421 "        1"
NSQ_SOURCE_LINE 00002422 "        a"
NSQ_SOURCE_LINE 00002423 "        2"
NSQ_SOURCE_LINE 00002424 "        b"
NSQ_SOURCE_LINE 00002425 "        3"
NSQ_SOURCE_LINE 00002426 "        c"
NSQ_SOURCE_LINE 00002427 "    bar"
NSQ_SOURCE_LINE 00002428 ""
NSQ_SOURCE_LINE 00002429 "DSL code:"
NSQ_SOURCE_LINE 00002430 ""
NSQ_SOURCE_LINE 00002431 "    between: foo bar"
NSQ_SOURCE_LINE 00002432 "        1"
NSQ_SOURCE_LINE 00002433 "        code: print capture()->[0], \"\\n\""
NSQ_SOURCE_LINE 00002434 "        2"
NSQ_SOURCE_LINE 00002435 "        code: print capture()->[0], \"\\n\""
NSQ_SOURCE_LINE 00002436 "        3"
NSQ_SOURCE_LINE 00002437 "        code: print capture()->[0], \"\\n\""
NSQ_SOURCE_LINE 00002438 ""
NSQ_SOURCE_LINE 00002439 "Output:"
NSQ_SOURCE_LINE 00002440 ""
NSQ_SOURCE_LINE 00002441 "        1 "
NSQ_SOURCE_LINE 00002442 "        2 "
NSQ_SOURCE_LINE 00002443 "        3 "
NSQ_SOURCE_LINE 00002444 ""
NSQ_SOURCE_LINE 00002445 "If you need check continuous sequences checks use text blocks."
NSQ_SOURCE_LINE 00002446 ""
NSQ_SOURCE_LINE 00002447 ""
NSQ_SOURCE_LINE 00002448 "=head1 Experimental features"
NSQ_SOURCE_LINE 00002449 ""
NSQ_SOURCE_LINE 00002450 "Below is highly experimental features purely tested. You may use it on your own risk! ;)"
NSQ_SOURCE_LINE 00002451 ""
NSQ_SOURCE_LINE 00002452 ""
NSQ_SOURCE_LINE 00002453 "=head2 Streams"
NSQ_SOURCE_LINE 00002454 ""
NSQ_SOURCE_LINE 00002455 "Streams are alternative for captures. Consider following example."
NSQ_SOURCE_LINE 00002456 ""
NSQ_SOURCE_LINE 00002457 "Input text:"
NSQ_SOURCE_LINE 00002458 ""
NSQ_SOURCE_LINE 00002459 "    foo"
NSQ_SOURCE_LINE 00002460 "        a"
NSQ_SOURCE_LINE 00002461 "        b"
NSQ_SOURCE_LINE 00002462 "        c"
NSQ_SOURCE_LINE 00002463 "    bar"
NSQ_SOURCE_LINE 00002464 "    "
NSQ_SOURCE_LINE 00002465 "    foo"
NSQ_SOURCE_LINE 00002466 "        1"
NSQ_SOURCE_LINE 00002467 "        2"
NSQ_SOURCE_LINE 00002468 "        3"
NSQ_SOURCE_LINE 00002469 "    bar"
NSQ_SOURCE_LINE 00002470 "    "
NSQ_SOURCE_LINE 00002471 "    foo"
NSQ_SOURCE_LINE 00002472 "        0"
NSQ_SOURCE_LINE 00002473 "        00"
NSQ_SOURCE_LINE 00002474 "        000"
NSQ_SOURCE_LINE 00002475 "    bar"
NSQ_SOURCE_LINE 00002476 ""
NSQ_SOURCE_LINE 00002477 "DSL code:"
NSQ_SOURCE_LINE 00002478 ""
NSQ_SOURCE_LINE 00002479 "    begin:"
NSQ_SOURCE_LINE 00002480 "    "
NSQ_SOURCE_LINE 00002481 "        foo"
NSQ_SOURCE_LINE 00002482 "    "
NSQ_SOURCE_LINE 00002483 "            regexp: (\\S+)"
NSQ_SOURCE_LINE 00002484 "            code: print '#', ( join ' ', map {$_->[0]} @{captures()} ), \"\\n\""
NSQ_SOURCE_LINE 00002485 "    "
NSQ_SOURCE_LINE 00002486 "            regexp: (\\S+)"
NSQ_SOURCE_LINE 00002487 "            code: print '#', ( join ' ', map {$_->[0]} @{captures()} ), \"\\n\""
NSQ_SOURCE_LINE 00002488 "    "
NSQ_SOURCE_LINE 00002489 "            regexp: (\\S+)"
NSQ_SOURCE_LINE 00002490 "            code: print '#', ( join ' ', map {$_->[0]} @{captures()} ), \"\\n\""
NSQ_SOURCE_LINE 00002491 "    "
NSQ_SOURCE_LINE 00002492 "    "
NSQ_SOURCE_LINE 00002493 "        bar"
NSQ_SOURCE_LINE 00002494 "    "
NSQ_SOURCE_LINE 00002495 "    end:"
NSQ_SOURCE_LINE 00002496 ""
NSQ_SOURCE_LINE 00002497 "Output:"
NSQ_SOURCE_LINE 00002498 ""
NSQ_SOURCE_LINE 00002499 "    # a 1 0"
NSQ_SOURCE_LINE 00002500 "    # b 2 00"
NSQ_SOURCE_LINE 00002501 "    # c 3 000"
NSQ_SOURCE_LINE 00002502 ""
NSQ_SOURCE_LINE 00002503 "Notice something interesting? Output direction has been inverted."
NSQ_SOURCE_LINE 00002504 ""
NSQ_SOURCE_LINE 00002505 "The reason for this is Outthentic check expression works in \"line by line scanning\" mode "
NSQ_SOURCE_LINE 00002506 "when text input gets verified line by line against given check expression. "
NSQ_SOURCE_LINE 00002507 ""
NSQ_SOURCE_LINE 00002508 "Once all lines are matched they get dropped into one heap without preserving original \"group context\". "
NSQ_SOURCE_LINE 00002509 ""
NSQ_SOURCE_LINE 00002510 "What if we would like to print all matching lines grouped by text blocks they belong to?"
NSQ_SOURCE_LINE 00002511 ""
NSQ_SOURCE_LINE 00002512 "As it's more convenient way ..."
NSQ_SOURCE_LINE 00002513 ""
NSQ_SOURCE_LINE 00002514 "This is where streams feature comes to rescue."
NSQ_SOURCE_LINE 00002515 ""
NSQ_SOURCE_LINE 00002516 "Streams - are all the data successfully matched for given I<group context>. "
NSQ_SOURCE_LINE 00002517 ""
NSQ_SOURCE_LINE 00002518 "Streams are I<applicable> for text blocks and range expressions."
NSQ_SOURCE_LINE 00002519 ""
NSQ_SOURCE_LINE 00002520 "Let's rewrite last example."
NSQ_SOURCE_LINE 00002521 ""
NSQ_SOURCE_LINE 00002522 "DSL code:"
NSQ_SOURCE_LINE 00002523 ""
NSQ_SOURCE_LINE 00002524 "    begin:"
NSQ_SOURCE_LINE 00002525 "    "
NSQ_SOURCE_LINE 00002526 "        foo"
NSQ_SOURCE_LINE 00002527 "            regexp: \\S+"
NSQ_SOURCE_LINE 00002528 "            regexp: \\S+"
NSQ_SOURCE_LINE 00002529 "            regexp: \\S+"
NSQ_SOURCE_LINE 00002530 "        bar"
NSQ_SOURCE_LINE 00002531 "    "
NSQ_SOURCE_LINE 00002532 "        code:  <<CODE"
NSQ_SOURCE_LINE 00002533 "            for my $s (@{stream()}) {           "
NSQ_SOURCE_LINE 00002534 "                print \"# \";                     "
NSQ_SOURCE_LINE 00002535 "                for my $i (@{$s}){              "
NSQ_SOURCE_LINE 00002536 "                    print $i;                   "
NSQ_SOURCE_LINE 00002537 "                }                               "
NSQ_SOURCE_LINE 00002538 "                print \"\\n\";                     "
NSQ_SOURCE_LINE 00002539 "            }"
NSQ_SOURCE_LINE 00002540 "    "
NSQ_SOURCE_LINE 00002541 "    CODE"
NSQ_SOURCE_LINE 00002542 "    "
NSQ_SOURCE_LINE 00002543 "    end:"
NSQ_SOURCE_LINE 00002544 ""
NSQ_SOURCE_LINE 00002545 "Stream function returns an arrays of I<streams>. Every stream holds all the matched lines for given I<logical block>."
NSQ_SOURCE_LINE 00002546 ""
NSQ_SOURCE_LINE 00002547 "Streams preserve group context. Number of streams relates to the number of successfully matched groups."
NSQ_SOURCE_LINE 00002548 ""
NSQ_SOURCE_LINE 00002549 "Streams data presentation is much closer to what was originally given in text input:"
NSQ_SOURCE_LINE 00002550 ""
NSQ_SOURCE_LINE 00002551 "Output:"
NSQ_SOURCE_LINE 00002552 ""
NSQ_SOURCE_LINE 00002553 "    # foo a b  c    bar"
NSQ_SOURCE_LINE 00002554 "    # foo 1 2  3    bar"
NSQ_SOURCE_LINE 00002555 "    # foo 0 00 000  bar"
NSQ_SOURCE_LINE 00002556 ""
NSQ_SOURCE_LINE 00002557 "Stream could be specially useful when combined with range expressions of I<various> ranges lengths."
NSQ_SOURCE_LINE 00002558 ""
NSQ_SOURCE_LINE 00002559 "For example."
NSQ_SOURCE_LINE 00002560 ""
NSQ_SOURCE_LINE 00002561 "Input text:"
NSQ_SOURCE_LINE 00002562 ""
NSQ_SOURCE_LINE 00002563 "    foo"
NSQ_SOURCE_LINE 00002564 "        2"
NSQ_SOURCE_LINE 00002565 "        4"
NSQ_SOURCE_LINE 00002566 "        6"
NSQ_SOURCE_LINE 00002567 "        8"
NSQ_SOURCE_LINE 00002568 "    bar"
NSQ_SOURCE_LINE 00002569 "    "
NSQ_SOURCE_LINE 00002570 "    foo"
NSQ_SOURCE_LINE 00002571 "        1"
NSQ_SOURCE_LINE 00002572 "        3"
NSQ_SOURCE_LINE 00002573 "    bar"
NSQ_SOURCE_LINE 00002574 "    "
NSQ_SOURCE_LINE 00002575 "    foo"
NSQ_SOURCE_LINE 00002576 "        0"
NSQ_SOURCE_LINE 00002577 "        0"
NSQ_SOURCE_LINE 00002578 "        0"
NSQ_SOURCE_LINE 00002579 "    bar"
NSQ_SOURCE_LINE 00002580 ""
NSQ_SOURCE_LINE 00002581 "DSL code:"
NSQ_SOURCE_LINE 00002582 ""
NSQ_SOURCE_LINE 00002583 "    between: foo bar"
NSQ_SOURCE_LINE 00002584 "    "
NSQ_SOURCE_LINE 00002585 "    regexp: \\d+"
NSQ_SOURCE_LINE 00002586 "    "
NSQ_SOURCE_LINE 00002587 "    code:  <<CODE"
NSQ_SOURCE_LINE 00002588 "        for my $s (@{stream()}) {           "
NSQ_SOURCE_LINE 00002589 "            print \"# \";                     "
NSQ_SOURCE_LINE 00002590 "            for my $i (@{$s}){              "
NSQ_SOURCE_LINE 00002591 "                print $i;                   "
NSQ_SOURCE_LINE 00002592 "            }                               "
NSQ_SOURCE_LINE 00002593 "            print \"\\n\";                     "
NSQ_SOURCE_LINE 00002594 "        }"
NSQ_SOURCE_LINE 00002595 "    "
NSQ_SOURCE_LINE 00002596 "    CODE"
NSQ_SOURCE_LINE 00002597 ""
NSQ_SOURCE_LINE 00002598 "Output:"
NSQ_SOURCE_LINE 00002599 ""
NSQ_SOURCE_LINE 00002600 "    # 2 4 6 8"
NSQ_SOURCE_LINE 00002601 "    # 1 3"
NSQ_SOURCE_LINE 00002602 "    # 0 0 0"
NSQ_SOURCE_LINE 00002603 ""
NSQ_SOURCE_LINE 00002604 ""
NSQ_SOURCE_LINE 00002605 "=head1 Examples"
NSQ_SOURCE_LINE 00002606 ""
NSQ_SOURCE_LINE 00002607 "=over"
NSQ_SOURCE_LINE 00002608 ""
NSQ_SOURCE_LINE 00002609 "=item *"
NSQ_SOURCE_LINE 00002610 ""
NSQ_SOURCE_LINE 00002611 "Some code examples mostly mentioned at this documentation could be found at C<examples/> directory"
NSQ_SOURCE_LINE 00002612 ""
NSQ_SOURCE_LINE 00002613 ""
NSQ_SOURCE_LINE 00002614 "=item *"
NSQ_SOURCE_LINE 00002615 ""
NSQ_SOURCE_LINE 00002616 "A plenty of other L<examples|https://github.com/melezhik/outthentic/tree/master/examples> could be found at Outthentic module"
NSQ_SOURCE_LINE 00002617 ""
NSQ_SOURCE_LINE 00002618 ""
NSQ_SOURCE_LINE 00002619 "=back"
NSQ_SOURCE_LINE 00002620 ""
NSQ_SOURCE_LINE 00002621 ""
NSQ_SOURCE_LINE 00002622 "=head1 Environment variables"
NSQ_SOURCE_LINE 00002623 ""
NSQ_SOURCE_LINE 00002624 "I'll document these variables later. Here is just a list:"
NSQ_SOURCE_LINE 00002625 ""
NSQ_SOURCE_LINE 00002626 "=over"
NSQ_SOURCE_LINE 00002627 ""
NSQ_SOURCE_LINE 00002628 "=item *"
NSQ_SOURCE_LINE 00002629 ""
NSQ_SOURCE_LINE 00002630 "OUT_KEEP_SOURCE_FILES"
NSQ_SOURCE_LINE 00002631 ""
NSQ_SOURCE_LINE 00002632 ""
NSQ_SOURCE_LINE 00002633 "=item *"
NSQ_SOURCE_LINE 00002634 ""
NSQ_SOURCE_LINE 00002635 "OTX_DEBUG"
NSQ_SOURCE_LINE 00002636 ""
NSQ_SOURCE_LINE 00002637 ""
NSQ_SOURCE_LINE 00002638 "=back"
NSQ_SOURCE_LINE 00002639 ""
NSQ_SOURCE_LINE 00002640 ""
