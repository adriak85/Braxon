NSQ_SOURCE_LINE 00000155 "sub check_line {"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    my $self = shift;"
NSQ_SOURCE_LINE 00000158 "    my $pattern = shift;"
NSQ_SOURCE_LINE 00000159 "    my $check_type = shift;"
NSQ_SOURCE_LINE 00000160 "    my $message = shift;"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    my $status = 0;"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "    s/\\s+$// for $pattern;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "    $self->reset_captures;"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    my @captures = ();"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    $self->create_context;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    $self->debug(\"[lookup] $pattern ...\") if $self->{debug_mod} >= 2;"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "    my @original_context   = @{$self->{original_context}};"
NSQ_SOURCE_LINE 00000175 "    my @context_new        = ();"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    # dynamic context "
NSQ_SOURCE_LINE 00000178 "    my $dc = $self->{context_modificator}->change_context("
NSQ_SOURCE_LINE 00000179 "        $self->{current_context},"
NSQ_SOURCE_LINE 00000180 "        $self->{original_context},"
NSQ_SOURCE_LINE 00000181 "        $self->{succeeded}"
NSQ_SOURCE_LINE 00000182 "    );"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "    $self->debug(\"context modificator applied: \".(ref $self->{context_modificator})) "
NSQ_SOURCE_LINE 00000185 "        if $self->{debug_mod} >=2;"
NSQ_SOURCE_LINE 00000186 "        "
NSQ_SOURCE_LINE 00000187 "    if ( $self->{debug_mod} >= 2 ) {"
NSQ_SOURCE_LINE 00000188 "        for my $dcl (@$dc){ "
NSQ_SOURCE_LINE 00000189 "            $self->debug(\"[dc] $dcl->[0]\");"
NSQ_SOURCE_LINE 00000190 "        } "
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "    };"
NSQ_SOURCE_LINE 00000193 "    "
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    $self->reset_succeeded;"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "    if ($check_type eq 'default'){"
NSQ_SOURCE_LINE 00000198 "        for my $c (@{$dc}){"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "            my $ln = $c->[0];"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "            next if $ln =~/#dsl_note:/; # skip debug entries"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "            if ( index($ln,$pattern) != -1){"
NSQ_SOURCE_LINE 00000205 "                $status = 1;"
NSQ_SOURCE_LINE 00000206 "                $self->{last_match_line} = $ln;"
NSQ_SOURCE_LINE 00000207 "                push @{$self->{succeeded}}, $c;"
NSQ_SOURCE_LINE 00000208 "            }"
NSQ_SOURCE_LINE 00000209 "        }"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "    }elsif($check_type eq 'regexp'){"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "        for my $c (@{$dc}) {"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "            my $re = qr/$pattern/;"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "            my $ln = $c->[0];"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "            next if $ln eq \":blank_line\";"
NSQ_SOURCE_LINE 00000221 "            next if $ln =~/#dsl_note:/;"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "            my @foo = ($ln =~ /$re/g);"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "            if (scalar @foo){"
NSQ_SOURCE_LINE 00000226 "                push @captures, [@foo];"
NSQ_SOURCE_LINE 00000227 "                $status = 1;"
NSQ_SOURCE_LINE 00000228 "                push @{$self->{succeeded}}, $c;"
NSQ_SOURCE_LINE 00000229 "                push @context_new, $c if $self->{within_mode};"
NSQ_SOURCE_LINE 00000230 "                $self->{last_match_line} = $ln;"
NSQ_SOURCE_LINE 00000231 "            }"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "        }"
NSQ_SOURCE_LINE 00000234 "    }else {"
NSQ_SOURCE_LINE 00000235 "        confess \"unknown check_type: $check_type\";"
NSQ_SOURCE_LINE 00000236 "    }"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "    $self->{last_check_status} = $status;"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "    if ( $self->{debug_mod} >= 2 ){"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "        my $i = 1;"
NSQ_SOURCE_LINE 00000245 "        my $j = 1;"
NSQ_SOURCE_LINE 00000246 "        for my $cpp (@captures){"
NSQ_SOURCE_LINE 00000247 "            for my $cp (@{$cpp}){"
NSQ_SOURCE_LINE 00000248 "                $self->debug(\"CAP[$i,$j]: $cp\");"
NSQ_SOURCE_LINE 00000249 "                $j++;"
NSQ_SOURCE_LINE 00000250 "            }"
NSQ_SOURCE_LINE 00000251 "            $i++;"
NSQ_SOURCE_LINE 00000252 "            $j=1;"
NSQ_SOURCE_LINE 00000253 "        }"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "        for my $s (@{$self->{succeeded}}){"
NSQ_SOURCE_LINE 00000256 "            $self->debug(\"SUCC: $s->[0]\");"
NSQ_SOURCE_LINE 00000257 "        }"
NSQ_SOURCE_LINE 00000258 "    }"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "    $self->{captures} = [ @captures ];"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "    if ($self->{cache_dir}){"
NSQ_SOURCE_LINE 00000263 "      open CAPTURES, '>', $self->{cache_dir}.'/captures.json' "
NSQ_SOURCE_LINE 00000264 "        or confess \"can't open \".($self->{cache_dir}).\"captures.json to write $!\";"
NSQ_SOURCE_LINE 00000265 "      print CAPTURES encode_json($self->{captures});"
NSQ_SOURCE_LINE 00000266 "      $self->debug(\"CAPTURES saved at \".$self->{cache_dir}.'/captures.json')"
NSQ_SOURCE_LINE 00000267 "        if $self->{debug_mod} >= 1;"
NSQ_SOURCE_LINE 00000268 "      close CAPTURES;"
NSQ_SOURCE_LINE 00000269 "    }"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "    # update context"
NSQ_SOURCE_LINE 00000272 "    if ( $self->{within_mode} and $status ){"
NSQ_SOURCE_LINE 00000273 "        $self->{current_context} = [@context_new];"
NSQ_SOURCE_LINE 00000274 "        $self->debug(\"[WITH] within mode: modify search context to: $context_new[0][0]\") "
NSQ_SOURCE_LINE 00000275 "          if $self->{debug_mod} >= 2 "
NSQ_SOURCE_LINE 00000276 "    }elsif ( $self->{within_mode} and ! $status ){"
NSQ_SOURCE_LINE 00000277 "        $self->{current_context} = []; # empty context if within expression has not passed "
NSQ_SOURCE_LINE 00000278 "        $self->debug('within mode: modify search context to: '.(Dumper([@context_new]))) if $self->{debug_mod} >= 2 "
NSQ_SOURCE_LINE 00000279 "    }"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "    $self->add_result({ status => $status , message => $message });"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    $self->{context_modificator}->update_stream("
NSQ_SOURCE_LINE 00000285 "        $self->{current_context},"
NSQ_SOURCE_LINE 00000286 "        $self->{original_context},"
NSQ_SOURCE_LINE 00000287 "        $self->{succeeded}, "
NSQ_SOURCE_LINE 00000288 "        \\($self->{stream}),"
NSQ_SOURCE_LINE 00000289 "    );"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "    return $status;"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "}"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "sub validate {"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "    my $self        = shift;"
NSQ_SOURCE_LINE 00000298 "    my $check_list  = shift;"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "    my $block_type;"
NSQ_SOURCE_LINE 00000301 "    my @multiline_block;"
NSQ_SOURCE_LINE 00000302 "    my $here_str_mode = 0;"
NSQ_SOURCE_LINE 00000303 "    my $here_str_marker;"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "    my @lines;"
NSQ_SOURCE_LINE 00000306 "    if (  -f $check_list ){"
NSQ_SOURCE_LINE 00000307 "      open my $ff, $check_list or die \"can't open file check_list to read: $!\";"
NSQ_SOURCE_LINE 00000308 "      while (my $ii = <$ff>){"
NSQ_SOURCE_LINE 00000309 "        push @lines, $ii;"
NSQ_SOURCE_LINE 00000310 "      }"
NSQ_SOURCE_LINE 00000311 "      close $ff;"
NSQ_SOURCE_LINE 00000312 "    } else {"
NSQ_SOURCE_LINE 00000313 "     @lines = ( ref $check_list  ) ? @{$check_list} : ( split \"\\n\", $check_list ); "
NSQ_SOURCE_LINE 00000314 "    }"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "    LINE: for my $l ( @lines ) {"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "        chomp $l;"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "        $self->debug(\"[dsl::$block_type] $l\") if $self->{debug_mod} >= 2;"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "        next LINE unless $l =~ /\\S/; # skip blank lines"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "        next LINE if $l=~ /^\\s*#(.*)/; # skip comments"
NSQ_SOURCE_LINE 00000325 "        "
NSQ_SOURCE_LINE 00000326 "        if ($here_str_mode && $l=~s/^$here_str_marker\\s*$//) {"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "          $here_str_mode = 0;"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "          $self->debug(\"here string mode off\") if $self->{debug_mod} >= 2;"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "          $self->debug(\"flushing $block_type block\") if $self->{debug_mod} >= 2;"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "          no strict 'refs';"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "          my $name = \"handle_\"; "
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "          $name.=$block_type;"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "          &$name($self, [ @multiline_block ] );"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "          undef @multiline_block; undef $block_type;"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "          next LINE;"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "        } "
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "        if ( $block_type and $l!~/\\\\\\s*$/ and ! $here_str_mode  ){"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "          no strict 'refs';"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "          my $name = \"handle_\"; "
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "          $name.=$block_type;"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "          $self->debug(\"flushing $block_type block\") if $self->{debug_mod} >= 2;"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "          &$name($self, [ @multiline_block ] );"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "          undef @multiline_block; undef $block_type;"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "        }"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "        if ( $block_type and $l=~/^\\s*(code|generator|validator):\\s*(.*)/ and ! $here_str_mode  ){"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "          no strict 'refs';"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "          my $name = \"handle_\"; "
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "          $name.=$block_type;"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "          $self->debug(\"flushing $block_type block\") if $self->{debug_mod} >= 2;"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "          &$name($self, [ @multiline_block ] );"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "          undef @multiline_block; undef $block_type;"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "        }"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "        if ( $block_type && ( $l=~s/\\\\\\s*$// or $here_str_mode )) { # multiline block"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "           # this is multiline block or here string,"
NSQ_SOURCE_LINE 00000385 "           # accumulate lines until meet line not ending with '\\' ( for multiline blocks )"
NSQ_SOURCE_LINE 00000386 "           # or here string end marker ( for here stings )"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "           push @multiline_block, $l;"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "           next LINE;"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "        } "
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "        if ( $l=~/^\\s*begin:\\s*$/) { # begining  of the text block"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "            do { undef @multiline_block; undef $block_type } if $block_type; "
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "            die \"you can't switch to text block mode when within mode is enabled\" if $self->{within_mode};"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "            $self->{context_modificator} = Outthentic::DSL::Context::TextBlock->new();"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "            $self->debug('text block start') if $self->{debug_mod} >= 2;"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "            $self->{block_mode} = 1;"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "            $self->reset_succeeded();"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "        } elsif ($l=~/^\\s*end:\\s*$/) { # end of the text block"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "            $self->{block_mode} = 0;"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "            $self->reset_context();"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "            $self->debug('text block end') if $self->{debug_mod} >= 2;"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "        } elsif ($l=~/^\\s*reset_context:\\s*$/) {"
NSQ_SOURCE_LINE 00000419 ""
