BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "# $Id: CheckLib.pm,v 1.25 2008/10/27 12:16:23 drhyde Exp $"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "package Devel::CheckLib;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use 5.00405; #postfix foreach"
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use vars qw($VERSION @ISA @EXPORT);"
NSQ_SOURCE_LINE 00000008 "$VERSION = '1.16';"
NSQ_SOURCE_LINE 00000009 "use Config qw(%Config);"
NSQ_SOURCE_LINE 00000010 "use Text::ParseWords qw(quotewords shellwords);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use File::Spec;"
NSQ_SOURCE_LINE 00000013 "use File::Temp;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "require Exporter;"
NSQ_SOURCE_LINE 00000016 "@ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000017 "@EXPORT = qw(assert_lib check_lib_or_exit check_lib);"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "# localising prevents the warningness leaking out of this module"
NSQ_SOURCE_LINE 00000020 "local $^W = 1;    # use warnings is a 5.6-ism"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "_findcc(); # bomb out early if there's no compiler"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=head1 NAME"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "Devel::CheckLib - check that a library is available"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "Devel::CheckLib is a perl module that checks whether a particular C"
NSQ_SOURCE_LINE 00000031 "library and its headers are available."
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    use Devel::CheckLib;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    check_lib_or_exit( lib => 'jpeg', header => 'jpeglib.h' );"
NSQ_SOURCE_LINE 00000038 "    check_lib_or_exit( lib => [ 'iconv', 'jpeg' ] );"
NSQ_SOURCE_LINE 00000039 "  "
NSQ_SOURCE_LINE 00000040 "    # or prompt for path to library and then do this:"
NSQ_SOURCE_LINE 00000041 "    check_lib_or_exit( lib => 'jpeg', libpath => $additional_path );"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=head1 USING IT IN Makefile.PL or Build.PL"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "If you want to use this from Makefile.PL or Build.PL, do"
NSQ_SOURCE_LINE 00000046 "not simply copy the module into your distribution as this may cause"
NSQ_SOURCE_LINE 00000047 "problems when PAUSE and search.cpan.org index the distro.  Instead, use"
NSQ_SOURCE_LINE 00000048 "the use-devel-checklib script."
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "=head1 HOW IT WORKS"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "You pass named parameters to a function, describing to it how to build"
NSQ_SOURCE_LINE 00000053 "and link to the libraries."
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "It works by trying to compile some code - which defaults to this:"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    int main(int argc, char *argv[]) { return 0; }"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "and linking it to the specified libraries.  If something pops out the end"
NSQ_SOURCE_LINE 00000060 "which looks executable, it gets executed, and if main() returns 0 we know"
NSQ_SOURCE_LINE 00000061 "that it worked.  That tiny program is"
NSQ_SOURCE_LINE 00000062 "built once for each library that you specify, and (without linking) once"
NSQ_SOURCE_LINE 00000063 "for each header file."
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "If you want to check for the presence of particular functions in a"
NSQ_SOURCE_LINE 00000066 "library, or even that those functions return particular results, then"
NSQ_SOURCE_LINE 00000067 "you can pass your own function body for main() thus:"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    check_lib_or_exit("
NSQ_SOURCE_LINE 00000070 "        function => 'foo();if(libversion() > 5) return 0; else return 1;'"
NSQ_SOURCE_LINE 00000071 "        incpath  => ..."
NSQ_SOURCE_LINE 00000072 "        libpath  => ..."
NSQ_SOURCE_LINE 00000073 "        lib      => ..."
NSQ_SOURCE_LINE 00000074 "        header   => ..."
NSQ_SOURCE_LINE 00000075 "    );"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "In that case, it will fail to build if either foo() or libversion() don't"
NSQ_SOURCE_LINE 00000078 "exist, and main() will return the wrong value if libversion()'s return"
NSQ_SOURCE_LINE 00000079 "value isn't what you want."
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "All of these take the same named parameters and are exported by default."
NSQ_SOURCE_LINE 00000084 "To avoid exporting them, C<use Devel::CheckLib ()>."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=head2 assert_lib"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "This takes several named parameters, all of which are optional, and dies"
NSQ_SOURCE_LINE 00000089 "with an error message if any of the libraries listed can"
NSQ_SOURCE_LINE 00000090 "not be found.  B<Note>: dying in a Makefile.PL or Build.PL may provoke"
NSQ_SOURCE_LINE 00000091 "a 'FAIL' report from CPAN Testers' automated smoke testers.  Use "
NSQ_SOURCE_LINE 00000092 "C<check_lib_or_exit> instead."
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "The named parameters are:"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=over"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "=item lib"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "Must be either a string with the name of a single "
NSQ_SOURCE_LINE 00000101 "library or a reference to an array of strings of library names.  Depending"
NSQ_SOURCE_LINE 00000102 "on the compiler found, library names will be fed to the compiler either as"
NSQ_SOURCE_LINE 00000103 "C<-l> arguments or as C<.lib> file names.  (E.g. C<-ljpeg> or C<jpeg.lib>)"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=item libpath"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "a string or an array of strings"
NSQ_SOURCE_LINE 00000108 "representing additional paths to search for libraries."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=item LIBS"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "a C<ExtUtils::MakeMaker>-style space-separated list of"
NSQ_SOURCE_LINE 00000113 "libraries (each preceded by '-l') and directories (preceded by '-L')."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "This can also be supplied on the command-line."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=item debug"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "If true - emit information during processing that can be used for"
NSQ_SOURCE_LINE 00000120 "debugging."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=back"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "And libraries are no use without header files, so ..."
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=over"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=item header"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "Must be either a string with the name of a single "
NSQ_SOURCE_LINE 00000131 "header file or a reference to an array of strings of header file names."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=item incpath"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "a string or an array of strings"
NSQ_SOURCE_LINE 00000136 "representing additional paths to search for headers."
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=item INC"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "a C<ExtUtils::MakeMaker>-style space-separated list of"
NSQ_SOURCE_LINE 00000141 "incpaths, each preceded by '-I'."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "This can also be supplied on the command-line."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=item ccflags"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "Extra flags to pass to the compiler."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=item ldflags"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "Extra flags to pass to the linker."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=item analyze_binary"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "a callback function that will be invoked in order to perform custom"
NSQ_SOURCE_LINE 00000156 "analysis of the generated binary. The callback arguments are the"
NSQ_SOURCE_LINE 00000157 "library name and the path to the binary just compiled."
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "It is possible to use this callback, for instance, to inspect the"
NSQ_SOURCE_LINE 00000160 "binary for further dependencies."
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=item not_execute"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "Do not try to execute generated binary. Only check that compilation has not failed."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=back"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=head2 check_lib_or_exit"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "This behaves exactly the same as C<assert_lib()> except that instead of"
NSQ_SOURCE_LINE 00000171 "dieing, it warns (with exactly the same error message) and exits."
NSQ_SOURCE_LINE 00000172 "This is intended for use in Makefile.PL / Build.PL"
NSQ_SOURCE_LINE 00000173 "when you might want to prompt the user for various paths and"
NSQ_SOURCE_LINE 00000174 "things before checking that what they've told you is sane."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "If any library or header is missing, it exits with an exit value of 0 to avoid"
NSQ_SOURCE_LINE 00000177 "causing a CPAN Testers 'FAIL' report.  CPAN Testers should ignore this"
NSQ_SOURCE_LINE 00000178 "result -- which is what you want if an external library dependency is not"
NSQ_SOURCE_LINE 00000179 "available."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=head2 check_lib"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "This behaves exactly the same as C<assert_lib()> except that it is silent,"
NSQ_SOURCE_LINE 00000184 "returning false instead of dieing, or true otherwise."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=cut"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "sub check_lib_or_exit {"
NSQ_SOURCE_LINE 00000189 "    eval 'assert_lib(@_)';"
NSQ_SOURCE_LINE 00000190 "    if($@) {"
NSQ_SOURCE_LINE 00000191 "        warn $@;"
NSQ_SOURCE_LINE 00000192 "        exit;"
NSQ_SOURCE_LINE 00000193 "    }"
NSQ_SOURCE_LINE 00000194 "}"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "sub check_lib {"
NSQ_SOURCE_LINE 00000197 "    eval 'assert_lib(@_)';"
NSQ_SOURCE_LINE 00000198 "    return $@ ? 0 : 1;"
NSQ_SOURCE_LINE 00000199 "}"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "# borrowed from Text::ParseWords"
NSQ_SOURCE_LINE 00000202 "sub _parse_line {"
NSQ_SOURCE_LINE 00000203 "    my($delimiter, $keep, $line) = @_;"
NSQ_SOURCE_LINE 00000204 "    my($word, @pieces);"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    no warnings 'uninitialized';  # we will be testing undef strings"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    while (length($line)) {"
NSQ_SOURCE_LINE 00000209 "        # This pattern is optimised to be stack conservative on older perls."
NSQ_SOURCE_LINE 00000210 "        # Do not refactor without being careful and testing it on very long strings."
NSQ_SOURCE_LINE 00000211 "        # See Perl bug #42980 for an example of a stack busting input."
NSQ_SOURCE_LINE 00000212 "        $line =~ s/^"
NSQ_SOURCE_LINE 00000213 "                    (?:"
NSQ_SOURCE_LINE 00000214 "                        # double quoted string"
NSQ_SOURCE_LINE 00000215 "                        (\")                             # $quote"
NSQ_SOURCE_LINE 00000216 "                        ((?>[^\\\\\"]*(?:\\\\.[^\\\\\"]*)*))\"   # $quoted"
NSQ_SOURCE_LINE 00000217 "        | # --OR--"
NSQ_SOURCE_LINE 00000218 "                        # singe quoted string"
NSQ_SOURCE_LINE 00000219 "                        (')                             # $quote"
NSQ_SOURCE_LINE 00000220 "                        ((?>[^\\\\']*(?:\\\\.[^\\\\']*)*))'   # $quoted"
NSQ_SOURCE_LINE 00000221 "                    |   # --OR--"
NSQ_SOURCE_LINE 00000222 "                        # unquoted string"
NSQ_SOURCE_LINE 00000223 "                        (                               # $unquoted"
NSQ_SOURCE_LINE 00000224 "                            (?:\\\\.|[^\\\\\"'])*?"
NSQ_SOURCE_LINE 00000225 "                        )"
NSQ_SOURCE_LINE 00000226 "                        # followed by"
NSQ_SOURCE_LINE 00000227 "                        (                               # $delim"
NSQ_SOURCE_LINE 00000228 "                            \\Z(?!\\n)                    # EOL"
NSQ_SOURCE_LINE 00000229 "                        |   # --OR--"
NSQ_SOURCE_LINE 00000230 "                            (?-x:$delimiter)            # delimiter"
NSQ_SOURCE_LINE 00000231 "                        |   # --OR--"
NSQ_SOURCE_LINE 00000232 "                            (?!^)(?=[\"'])               # a quote"
NSQ_SOURCE_LINE 00000233 "                        )"
NSQ_SOURCE_LINE 00000234 "        )//xs or return;    # extended layout"
NSQ_SOURCE_LINE 00000235 "        my ($quote, $quoted, $unquoted, $delim) = (($1 ? ($1,$2) : ($3,$4)), $5, $6);"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "        return() unless( defined($quote) || length($unquoted) || length($delim));"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "        if ($keep) {"
NSQ_SOURCE_LINE 00000240 "            $quoted = \"$quote$quoted$quote\";"
NSQ_SOURCE_LINE 00000241 "        }"
NSQ_SOURCE_LINE 00000242 "        else {"
NSQ_SOURCE_LINE 00000243 "            $unquoted =~ s/\\\\(.)/$1/sg;"
NSQ_SOURCE_LINE 00000244 "            if (defined $quote) {"
NSQ_SOURCE_LINE 00000245 "                $quoted =~ s/\\\\(.)/$1/sg if ($quote eq '\"');"
NSQ_SOURCE_LINE 00000246 "            }"
NSQ_SOURCE_LINE 00000247 "        }"
NSQ_SOURCE_LINE 00000248 "        $word .= substr($line, 0, 0); # leave results tainted"
NSQ_SOURCE_LINE 00000249 "        $word .= defined $quote ? $quoted : $unquoted;"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "        if (length($delim)) {"
NSQ_SOURCE_LINE 00000252 "            push(@pieces, $word);"
NSQ_SOURCE_LINE 00000253 "            push(@pieces, $delim) if ($keep eq 'delimiters');"
NSQ_SOURCE_LINE 00000254 "            undef $word;"
NSQ_SOURCE_LINE 00000255 "        }"
NSQ_SOURCE_LINE 00000256 "        if (!length($line)) {"
NSQ_SOURCE_LINE 00000257 "            push(@pieces, $word);"
NSQ_SOURCE_LINE 00000258 "        }"
NSQ_SOURCE_LINE 00000259 "    }"
NSQ_SOURCE_LINE 00000260 "    return(@pieces);"
NSQ_SOURCE_LINE 00000261 "}"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "sub _parsewords {"
NSQ_SOURCE_LINE 00000264 "    return shellwords @_ if $^O ne 'MSWin32';"
NSQ_SOURCE_LINE 00000265 "    # for Win32, take off \"\" but leave \\"
NSQ_SOURCE_LINE 00000266 "    map { my $s=$_; $s =~ s/^\"(.*)\"$/$1/; $s } grep defined && length, quotewords '\\s+', 1, @_;"
NSQ_SOURCE_LINE 00000267 "}"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "sub _compile_cmd {"
NSQ_SOURCE_LINE 00000270 "    my ($Config_cc, $cc, $cfile, $exefile, $incpaths, $ld, $Config_libs, $lib, $libpaths) = @_;"
NSQ_SOURCE_LINE 00000271 "    my @sys_cmd = @$cc;"
NSQ_SOURCE_LINE 00000272 "    if ( $Config_cc eq 'cl' ) {                 # Microsoft compiler"
NSQ_SOURCE_LINE 00000273 "\t# this is horribly sensitive to the order of arguments"
NSQ_SOURCE_LINE 00000274 "\tpush @sys_cmd,"
NSQ_SOURCE_LINE 00000275 "\t    $cfile,"
NSQ_SOURCE_LINE 00000276 "\t    (defined $lib ? \"${lib}.lib\" : ()),"
NSQ_SOURCE_LINE 00000277 "\t    \"/Fe$exefile\","
NSQ_SOURCE_LINE 00000278 "\t    (map '/I'.$_, @$incpaths),"
NSQ_SOURCE_LINE 00000279 "\t    \"/link\","
NSQ_SOURCE_LINE 00000280 "\t    @$ld,"
NSQ_SOURCE_LINE 00000281 "\t    _parsewords($Config_libs),"
NSQ_SOURCE_LINE 00000282 "\t    (defined $lib ? map '/libpath:'.$_, @$libpaths : ()),"
NSQ_SOURCE_LINE 00000283 "\t    ;"
NSQ_SOURCE_LINE 00000284 "    } elsif($Config_cc =~ /bcc32(\\.exe)?/) {    # Borland"
NSQ_SOURCE_LINE 00000285 "\tpush @sys_cmd,"
NSQ_SOURCE_LINE 00000286 "\t    @$ld,"
NSQ_SOURCE_LINE 00000287 "\t    (map \"-I$_\", @$incpaths),"
NSQ_SOURCE_LINE 00000288 "\t    \"-o$exefile\","
NSQ_SOURCE_LINE 00000289 "\t    (defined $lib ? ((map \"-L$_\", @$libpaths), \"-l$lib\") : ()),"
NSQ_SOURCE_LINE 00000290 "\t    $cfile,"
NSQ_SOURCE_LINE 00000291 "\t    ;"
NSQ_SOURCE_LINE 00000292 "    } else { # Unix-ish: gcc, Sun, AIX (gcc, cc), ..."
NSQ_SOURCE_LINE 00000293 "\tpush @sys_cmd,"
NSQ_SOURCE_LINE 00000294 "\t    (map \"-I$_\", @$incpaths),"
NSQ_SOURCE_LINE 00000295 "\t    $cfile,"
NSQ_SOURCE_LINE 00000296 "\t    (!defined $lib ? () : ("
NSQ_SOURCE_LINE 00000297 "\t      (map \"-L$_\", @$libpaths),"
NSQ_SOURCE_LINE 00000298 "\t      ($^O eq 'darwin' ? (map { \"-Wl,-rpath,$_\" } @$libpaths) : ()),"
NSQ_SOURCE_LINE 00000299 "\t      \"-l$lib\","
NSQ_SOURCE_LINE 00000300 "\t    )),"
NSQ_SOURCE_LINE 00000301 "\t    @$ld,"
NSQ_SOURCE_LINE 00000302 "\t    \"-o\", $exefile,"
NSQ_SOURCE_LINE 00000303 "\t    ;"
NSQ_SOURCE_LINE 00000304 "    }"
NSQ_SOURCE_LINE 00000305 "    @sys_cmd;"
NSQ_SOURCE_LINE 00000306 "}"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "sub _make_cfile {"
NSQ_SOURCE_LINE 00000309 "    my ($use_headers, $function, $debug) = @_;"
NSQ_SOURCE_LINE 00000310 "    my $code = '';"
NSQ_SOURCE_LINE 00000311 "    $code .= qq{#include <$_>\\n} for @$use_headers;"
NSQ_SOURCE_LINE 00000312 "    $code .= \"int main(int argc, char *argv[]) { \".($function || 'return 0;').\" }\\n\";"
NSQ_SOURCE_LINE 00000313 "    if ($debug) {"
NSQ_SOURCE_LINE 00000314 "\t(my $c = $code) =~ s:^:# :gm;"
NSQ_SOURCE_LINE 00000315 "\twarn \"# Code:\\n$c\\n\";"
NSQ_SOURCE_LINE 00000316 "    }"
NSQ_SOURCE_LINE 00000317 "    my ($ch, $cfile) = File::Temp::tempfile("
NSQ_SOURCE_LINE 00000318 "\t'assertlibXXXXXXXX', SUFFIX => '.c'"
NSQ_SOURCE_LINE 00000319 "    );"
NSQ_SOURCE_LINE 00000320 "    print $ch $code;"
NSQ_SOURCE_LINE 00000321 "    close $ch;"
NSQ_SOURCE_LINE 00000322 "    (my $ofile = $cfile) =~ s/\\.c$/$Config{_o}/;"
NSQ_SOURCE_LINE 00000323 "    ($cfile, $ofile);"
NSQ_SOURCE_LINE 00000324 "}"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "sub assert_lib {"
NSQ_SOURCE_LINE 00000327 "    my %args = @_;"
NSQ_SOURCE_LINE 00000328 "    $args{$_} = [$args{$_}]"
NSQ_SOURCE_LINE 00000329 "        for grep $args{$_} && !ref($args{$_}), qw(lib libpath header incpath);"
NSQ_SOURCE_LINE 00000330 "    my @libs = @{$args{lib} || []};"
NSQ_SOURCE_LINE 00000331 "    my @libpaths = @{$args{libpath} || []};"
NSQ_SOURCE_LINE 00000332 "    my @headers = @{$args{header} || []};"
NSQ_SOURCE_LINE 00000333 "    my @incpaths = @{$args{incpath} || []};"
NSQ_SOURCE_LINE 00000334 "    my $analyze_binary = $args{analyze_binary};"
NSQ_SOURCE_LINE 00000335 "    my $execute = !$args{not_execute};"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "    my @argv = @ARGV;"
NSQ_SOURCE_LINE 00000338 "    push @argv, _parse_line('\\s+', 0, $ENV{PERL_MM_OPT}||'');"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "    # work-a-like for Makefile.PL's LIBS and INC arguments"
NSQ_SOURCE_LINE 00000341 "    # if given as command-line argument, append to %args"
NSQ_SOURCE_LINE 00000342 "    for my $arg (@argv) {"
NSQ_SOURCE_LINE 00000343 "        for my $mm_attr_key (qw(LIBS INC)) {"
NSQ_SOURCE_LINE 00000344 "            if (my ($mm_attr_value) = $arg =~ /\\A $mm_attr_key = (.*)/x) {"
NSQ_SOURCE_LINE 00000345 "            # it is tempting to put some \\s* into the expression, but the"
NSQ_SOURCE_LINE 00000346 "            # MM command-line parser only accepts LIBS etc. followed by =,"
NSQ_SOURCE_LINE 00000347 "            # so we should not be any more lenient with whitespace than that"
NSQ_SOURCE_LINE 00000348 "                $args{$mm_attr_key} .= \" $mm_attr_value\";"
NSQ_SOURCE_LINE 00000349 "            }"
NSQ_SOURCE_LINE 00000350 "        }"
NSQ_SOURCE_LINE 00000351 "    }"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "    if(defined($args{LIBS})) {"
NSQ_SOURCE_LINE 00000354 "        foreach my $arg (_parsewords($args{LIBS})) {"
NSQ_SOURCE_LINE 00000355 "            die(\"LIBS argument badly-formed: $arg\\n\") unless($arg =~ /^-[lLR]/);"
NSQ_SOURCE_LINE 00000356 "            push @{$arg =~ /^-l/ ? \\@libs : \\@libpaths}, substr($arg, 2);"
NSQ_SOURCE_LINE 00000357 "        }"
NSQ_SOURCE_LINE 00000358 "    }"
NSQ_SOURCE_LINE 00000359 "    if(defined($args{INC})) {"
NSQ_SOURCE_LINE 00000360 "        foreach my $arg (_parsewords($args{INC})) {"
NSQ_SOURCE_LINE 00000361 "            die(\"INC argument badly-formed: $arg\\n\") unless($arg =~ /^-I/);"
NSQ_SOURCE_LINE 00000362 "            push @incpaths, substr($arg, 2);"
NSQ_SOURCE_LINE 00000363 "        }"
NSQ_SOURCE_LINE 00000364 "    }"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "    my ($cc, $ld) = _findcc($args{debug}, $args{ccflags}, $args{ldflags});"
NSQ_SOURCE_LINE 00000367 "    my @missing;"
NSQ_SOURCE_LINE 00000368 "    my @wrongresult;"
NSQ_SOURCE_LINE 00000369 "    my @wronganalysis;"
NSQ_SOURCE_LINE 00000370 "    my @use_headers;"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "    # first figure out which headers we can't find ..."
NSQ_SOURCE_LINE 00000373 "    for my $header (@headers) {"
NSQ_SOURCE_LINE 00000374 "        push @use_headers, $header;"
NSQ_SOURCE_LINE 00000375 "        my ($cfile, $ofile) = _make_cfile(\\@use_headers, '', $args{debug});"
NSQ_SOURCE_LINE 00000376 "        my $exefile = File::Temp::mktemp( 'assertlibXXXXXXXX' ) . $Config{_exe};"
NSQ_SOURCE_LINE 00000377 "        my @sys_cmd = _compile_cmd($Config{cc}, $cc, $cfile, $exefile, \\@incpaths, $ld, $Config{libs});"
NSQ_SOURCE_LINE 00000378 "        warn \"# @sys_cmd\\n\" if $args{debug};"
NSQ_SOURCE_LINE 00000379 "        my $rv = $args{debug} ? system(@sys_cmd) : _quiet_system(@sys_cmd);"
NSQ_SOURCE_LINE 00000380 "        push @missing, $header if $rv != 0 || ! -f $exefile;"
NSQ_SOURCE_LINE 00000381 "        _cleanup_exe($exefile);"
NSQ_SOURCE_LINE 00000382 "        unlink $cfile;"
NSQ_SOURCE_LINE 00000383 "    }"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "    # now do each library in turn with headers"
NSQ_SOURCE_LINE 00000386 "    my ($cfile, $ofile) = _make_cfile(\\@use_headers, @args{qw(function debug)});"
NSQ_SOURCE_LINE 00000387 "    for my $lib ( @libs ) {"
NSQ_SOURCE_LINE 00000388 "        last if $Config{cc} eq 'CC/DECC';          # VMS"
NSQ_SOURCE_LINE 00000389 "        my $exefile = File::Temp::mktemp( 'assertlibXXXXXXXX' ) . $Config{_exe};"
NSQ_SOURCE_LINE 00000390 "        my @sys_cmd = _compile_cmd($Config{cc}, $cc, $cfile, $exefile, \\@incpaths, $ld, $Config{libs}, $lib, \\@libpaths);"
NSQ_SOURCE_LINE 00000391 "        warn \"# @sys_cmd\\n\" if $args{debug};"
NSQ_SOURCE_LINE 00000392 "        local $ENV{LD_RUN_PATH} = join(\":\", grep $_, @libpaths, $ENV{LD_RUN_PATH}) unless $^O eq 'MSWin32' or $^O eq 'darwin';"
NSQ_SOURCE_LINE 00000393 "        local $ENV{PATH} = join(\";\", @libpaths).\";\".$ENV{PATH} if $^O eq 'MSWin32';"
NSQ_SOURCE_LINE 00000394 "        my $rv = $args{debug} ? system(@sys_cmd) : _quiet_system(@sys_cmd);"
NSQ_SOURCE_LINE 00000395 "        if ($rv != 0 || ! -f $exefile) {"
NSQ_SOURCE_LINE 00000396 "            push @missing, $lib;"
NSQ_SOURCE_LINE 00000397 "        }"
NSQ_SOURCE_LINE 00000398 "        else {"
NSQ_SOURCE_LINE 00000399 "            chmod 0755, $exefile;"
NSQ_SOURCE_LINE 00000400 "            my $absexefile = File::Spec->rel2abs($exefile);"
NSQ_SOURCE_LINE 00000401 "            $absexefile = '\"'.$absexefile.'\"' if $absexefile =~ m/\\s/;"
NSQ_SOURCE_LINE 00000402 "            warn \"# Execute($execute): $absexefile\\n\" if $args{debug};"
NSQ_SOURCE_LINE 00000403 "            if ($execute) {"
NSQ_SOURCE_LINE 00000404 "                my $retval = system($absexefile);"
NSQ_SOURCE_LINE 00000405 "                warn \"# return value: $retval\\n\" if $args{debug};"
NSQ_SOURCE_LINE 00000406 "                push @wrongresult, $lib if $retval != 0;"
NSQ_SOURCE_LINE 00000407 "            }"
NSQ_SOURCE_LINE 00000408 "            push @wronganalysis, $lib"
NSQ_SOURCE_LINE 00000409 "                if $analyze_binary and !$analyze_binary->($lib, $exefile);"
NSQ_SOURCE_LINE 00000410 "        }"
NSQ_SOURCE_LINE 00000411 "        _cleanup_exe($exefile);"
NSQ_SOURCE_LINE 00000412 "    }"
NSQ_SOURCE_LINE 00000413 "    unlink $cfile;"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "    my $miss_string = join( q{, }, map qq{'$_'}, @missing );"
NSQ_SOURCE_LINE 00000416 "    die(\"Can't link/include C library $miss_string, aborting.\\n\") if @missing;"
NSQ_SOURCE_LINE 00000417 "    my $wrong_string = join( q{, }, map qq{'$_'}, @wrongresult);"
NSQ_SOURCE_LINE 00000418 "    die(\"wrong result: $wrong_string\\n\") if @wrongresult;"
NSQ_SOURCE_LINE 00000419 "    my $analysis_string = join(q{, }, map qq{'$_'}, @wronganalysis );"
NSQ_SOURCE_LINE 00000420 "    die(\"wrong analysis: $analysis_string\") if @wronganalysis;"
NSQ_SOURCE_LINE 00000421 "}"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "sub _cleanup_exe {"
NSQ_SOURCE_LINE 00000424 "    my ($exefile) = @_;"
NSQ_SOURCE_LINE 00000425 "    my $ofile = $exefile;"
NSQ_SOURCE_LINE 00000426 "    $ofile =~ s/$Config{_exe}$/$Config{_o}/;"
NSQ_SOURCE_LINE 00000427 "    # List of files to remove"
NSQ_SOURCE_LINE 00000428 "    my @rmfiles;"
NSQ_SOURCE_LINE 00000429 "    push @rmfiles, $exefile, $ofile, \"$exefile\\.manifest\";"
NSQ_SOURCE_LINE 00000430 "    if ( $Config{cc} eq 'cl' ) {"
NSQ_SOURCE_LINE 00000431 "        # MSVC also creates foo.ilk and foo.pdb"
NSQ_SOURCE_LINE 00000432 "        my $ilkfile = $exefile;"
NSQ_SOURCE_LINE 00000433 "        $ilkfile =~ s/$Config{_exe}$/.ilk/;"
NSQ_SOURCE_LINE 00000434 "        my $pdbfile = $exefile;"
NSQ_SOURCE_LINE 00000435 "        $pdbfile =~ s/$Config{_exe}$/.pdb/;"
NSQ_SOURCE_LINE 00000436 "\tpush @rmfiles, $ilkfile, $pdbfile;"
NSQ_SOURCE_LINE 00000437 "    }"
NSQ_SOURCE_LINE 00000438 "    foreach (grep -f, @rmfiles) {"
NSQ_SOURCE_LINE 00000439 "\tunlink $_ or warn \"Could not remove $_: $!\";"
NSQ_SOURCE_LINE 00000440 "    }"
NSQ_SOURCE_LINE 00000441 "    return"
NSQ_SOURCE_LINE 00000442 "}"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "# return ($cc, $ld)"
NSQ_SOURCE_LINE 00000445 "# where $cc is an array ref of compiler name, compiler flags"
NSQ_SOURCE_LINE 00000446 "# where $ld is an array ref of linker flags"
NSQ_SOURCE_LINE 00000447 "sub _findcc {"
NSQ_SOURCE_LINE 00000448 "    my ($debug, $user_ccflags, $user_ldflags) = @_;"
NSQ_SOURCE_LINE 00000449 "    # Need to use $keep=1 to work with MSWin32 backslashes and quotes"
NSQ_SOURCE_LINE 00000450 "    my $Config_ccflags =  $Config{ccflags};  # use copy so ASPerl will compile"
NSQ_SOURCE_LINE 00000451 "    $Config_ccflags =~ s:-O\\S*::; # stop GCC optimising away test code"
NSQ_SOURCE_LINE 00000452 "    my @Config_ldflags = ();"
NSQ_SOURCE_LINE 00000453 "    for my $config_val ( @Config{qw(ldflags)} ){"
NSQ_SOURCE_LINE 00000454 "        push @Config_ldflags, $config_val if ( $config_val =~ /\\S/ );"
NSQ_SOURCE_LINE 00000455 "    }"
NSQ_SOURCE_LINE 00000456 "    my @ccflags = grep { length } _parsewords($Config_ccflags||'', $user_ccflags||'');"
NSQ_SOURCE_LINE 00000457 "    my @ldflags = grep { length && $_ !~ m/^-Wl/ } _parsewords(@Config_ldflags, $user_ldflags||'');"
NSQ_SOURCE_LINE 00000458 "    my @paths = split(/$Config{path_sep}/, $ENV{PATH});"
NSQ_SOURCE_LINE 00000459 "    my @cc = _parsewords($Config{cc});"
NSQ_SOURCE_LINE 00000460 "    if (check_compiler ($cc[0], $debug)) {"
NSQ_SOURCE_LINE 00000461 "\treturn ( [ @cc, @ccflags ], \\@ldflags );"
NSQ_SOURCE_LINE 00000462 "    }"
NSQ_SOURCE_LINE 00000463 "    # Find the extension for executables."
NSQ_SOURCE_LINE 00000464 "    my $exe = $Config{_exe};"
NSQ_SOURCE_LINE 00000465 "    if ($^O eq 'cygwin') {"
NSQ_SOURCE_LINE 00000466 "\t$exe = '';"
NSQ_SOURCE_LINE 00000467 "    }"
NSQ_SOURCE_LINE 00000468 "    foreach my $path (@paths) {"
NSQ_SOURCE_LINE 00000469 "\t# Look for \"$path/$cc[0].exe\""
NSQ_SOURCE_LINE 00000470 "        my $compiler = File::Spec->catfile($path, $cc[0]) . $exe;"
NSQ_SOURCE_LINE 00000471 "\tif (check_compiler ($compiler, $debug)) {"
NSQ_SOURCE_LINE 00000472 "\t    return ([ $compiler, @cc[1 .. $#cc], @ccflags ], \\@ldflags)"
NSQ_SOURCE_LINE 00000473 "\t}"
NSQ_SOURCE_LINE 00000474 "        next if ! $exe;"
NSQ_SOURCE_LINE 00000475 "\t# Look for \"$path/$cc[0]\" without the .exe, if necessary."
NSQ_SOURCE_LINE 00000476 "        $compiler = File::Spec->catfile($path, $cc[0]);"
NSQ_SOURCE_LINE 00000477 "\tif (check_compiler ($compiler, $debug)) {"
NSQ_SOURCE_LINE 00000478 "\t    return ([ $compiler, @cc[1 .. $#cc], @ccflags ], \\@ldflags)"
NSQ_SOURCE_LINE 00000479 "\t}"
NSQ_SOURCE_LINE 00000480 "    }"
NSQ_SOURCE_LINE 00000481 "    die(\"Couldn't find your C compiler.\\n\");"
NSQ_SOURCE_LINE 00000482 "}"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "sub check_compiler"
NSQ_SOURCE_LINE 00000485 "{"
NSQ_SOURCE_LINE 00000486 "    my ($compiler, $debug) = @_;"
NSQ_SOURCE_LINE 00000487 "    if (-f $compiler && -x $compiler) {"
NSQ_SOURCE_LINE 00000488 "\twarn \"# Compiler seems to be $compiler\\n\" if $debug;"
NSQ_SOURCE_LINE 00000489 "\treturn 1;"
NSQ_SOURCE_LINE 00000490 "    }"
NSQ_SOURCE_LINE 00000491 "    warn \"# Compiler was not $compiler\\n\" if $debug;"
NSQ_SOURCE_LINE 00000492 "    return '';"
NSQ_SOURCE_LINE 00000493 "}"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "# code substantially borrowed from IPC::Run3"
NSQ_SOURCE_LINE 00000497 "sub _quiet_system {"
NSQ_SOURCE_LINE 00000498 "    my (@cmd) = @_;"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "    # save handles"
NSQ_SOURCE_LINE 00000501 "    local *STDOUT_SAVE;"
NSQ_SOURCE_LINE 00000502 "    local *STDERR_SAVE;"
NSQ_SOURCE_LINE 00000503 "    open STDOUT_SAVE, \">&STDOUT\" or die \"CheckLib: $! saving STDOUT\";"
NSQ_SOURCE_LINE 00000504 "    open STDERR_SAVE, \">&STDERR\" or die \"CheckLib: $! saving STDERR\";"
NSQ_SOURCE_LINE 00000505 "    "
NSQ_SOURCE_LINE 00000506 "    # redirect to nowhere"
NSQ_SOURCE_LINE 00000507 "    local *DEV_NULL;"
NSQ_SOURCE_LINE 00000508 "    open DEV_NULL, \">\" . File::Spec->devnull "
NSQ_SOURCE_LINE 00000509 "        or die \"CheckLib: $! opening handle to null device\";"
NSQ_SOURCE_LINE 00000510 "    open STDOUT, \">&\" . fileno DEV_NULL"
NSQ_SOURCE_LINE 00000511 "        or die \"CheckLib: $! redirecting STDOUT to null handle\";"
NSQ_SOURCE_LINE 00000512 "    open STDERR, \">&\" . fileno DEV_NULL"
NSQ_SOURCE_LINE 00000513 "        or die \"CheckLib: $! redirecting STDERR to null handle\";"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "    # run system command"
NSQ_SOURCE_LINE 00000516 "    my $rv = system(@cmd);"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "    # restore handles"
NSQ_SOURCE_LINE 00000519 "    open STDOUT, \">&\" . fileno STDOUT_SAVE"
NSQ_SOURCE_LINE 00000520 "        or die \"CheckLib: $! restoring STDOUT handle\";"
NSQ_SOURCE_LINE 00000521 "    open STDERR, \">&\" . fileno STDERR_SAVE"
NSQ_SOURCE_LINE 00000522 "        or die \"CheckLib: $! restoring STDERR handle\";"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "    return $rv;"
NSQ_SOURCE_LINE 00000525 "}"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "=head1 PLATFORMS SUPPORTED"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "You must have a C compiler installed.  We check for C<$Config{cc}>,"
NSQ_SOURCE_LINE 00000530 "both literally as it is in Config.pm and also in the $PATH."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "It has been tested with varying degrees of rigorousness on:"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=over"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "=item gcc (on Linux, *BSD, Mac OS X, Solaris, Cygwin)"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "=item Sun's compiler tools on Solaris"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "=item IBM's tools on AIX"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "=item SGI's tools on Irix 6.5"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "=item Microsoft's tools on Windows"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "=item MinGW on Windows (with Strawberry Perl)"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "=item Borland's tools on Windows"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "=item QNX"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "=back"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "=head1 WARNINGS, BUGS and FEEDBACK"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "This is a very early release intended primarily for feedback from"
NSQ_SOURCE_LINE 00000557 "people who have discussed it.  The interface may change and it has"
NSQ_SOURCE_LINE 00000558 "not been adequately tested."
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "Feedback is most welcome, including constructive criticism."
NSQ_SOURCE_LINE 00000561 "Bug reports should be made using L<http://rt.cpan.org/> or by email."
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "When submitting a bug report, please include the output from running:"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "    perl -V"
NSQ_SOURCE_LINE 00000566 "    perl -MDevel::CheckLib -e0"
