NSQ_SOURCE_LINE 00000001 "use 5.006;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "package Capture::Tiny;"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: Capture STDOUT and STDERR from Perl, XS or external programs"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.50';"
NSQ_SOURCE_LINE 00000007 "use Carp ();"
NSQ_SOURCE_LINE 00000008 "use Exporter ();"
NSQ_SOURCE_LINE 00000009 "use IO::Handle ();"
NSQ_SOURCE_LINE 00000010 "use File::Spec ();"
NSQ_SOURCE_LINE 00000011 "use File::Temp qw/tempfile tmpnam/;"
NSQ_SOURCE_LINE 00000012 "use Scalar::Util qw/reftype blessed/;"
NSQ_SOURCE_LINE 00000013 "# Get PerlIO or fake it"
NSQ_SOURCE_LINE 00000014 "BEGIN {"
NSQ_SOURCE_LINE 00000015 "  local $@;"
NSQ_SOURCE_LINE 00000016 "  eval { require PerlIO; PerlIO->can('get_layers') }"
NSQ_SOURCE_LINE 00000017 "    or *PerlIO::get_layers = sub { return () };"
NSQ_SOURCE_LINE 00000018 "}"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000021 "# create API subroutines and export them"
NSQ_SOURCE_LINE 00000022 "# [do STDOUT flag, do STDERR flag, do merge flag, do tee flag]"
NSQ_SOURCE_LINE 00000023 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "my %api = ("
NSQ_SOURCE_LINE 00000026 "  capture         => [1,1,0,0],"
NSQ_SOURCE_LINE 00000027 "  capture_stdout  => [1,0,0,0],"
NSQ_SOURCE_LINE 00000028 "  capture_stderr  => [0,1,0,0],"
NSQ_SOURCE_LINE 00000029 "  capture_merged  => [1,1,1,0],"
NSQ_SOURCE_LINE 00000030 "  tee             => [1,1,0,1],"
NSQ_SOURCE_LINE 00000031 "  tee_stdout      => [1,0,0,1],"
NSQ_SOURCE_LINE 00000032 "  tee_stderr      => [0,1,0,1],"
NSQ_SOURCE_LINE 00000033 "  tee_merged      => [1,1,1,1],"
NSQ_SOURCE_LINE 00000034 ");"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "for my $sub ( keys %api ) {"
NSQ_SOURCE_LINE 00000037 "  my $args = join q{, }, @{$api{$sub}};"
NSQ_SOURCE_LINE 00000038 "  eval \"sub $sub(&;@) {unshift \\@_, $args; goto \\\\&_capture_tee;}\"; ## no critic"
NSQ_SOURCE_LINE 00000039 "}"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "our @ISA = qw/Exporter/;"
NSQ_SOURCE_LINE 00000042 "our @EXPORT_OK = keys %api;"
NSQ_SOURCE_LINE 00000043 "our %EXPORT_TAGS = ( 'all' => \\@EXPORT_OK );"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000046 "# constants and fixtures"
NSQ_SOURCE_LINE 00000047 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "my $IS_WIN32 = $^O eq 'MSWin32';"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "##our $DEBUG = $ENV{PERL_CAPTURE_TINY_DEBUG};"
NSQ_SOURCE_LINE 00000052 "##"
NSQ_SOURCE_LINE 00000053 "##my $DEBUGFH;"
NSQ_SOURCE_LINE 00000054 "##open $DEBUGFH, \"> DEBUG\" if $DEBUG;"
NSQ_SOURCE_LINE 00000055 "##"
NSQ_SOURCE_LINE 00000056 "##*_debug = $DEBUG ? sub(@) { print {$DEBUGFH} @_ } : sub(){0};"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "our $TIMEOUT = 30;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000061 "# command to tee output -- the argument is a filename that must"
NSQ_SOURCE_LINE 00000062 "# be opened to signal that the process is ready to receive input."
NSQ_SOURCE_LINE 00000063 "# This is annoying, but seems to be the best that can be done"
NSQ_SOURCE_LINE 00000064 "# as a simple, portable IPC technique"
NSQ_SOURCE_LINE 00000065 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000066 "my @cmd = ($^X, '-C0', '-e', <<'HERE');"
NSQ_SOURCE_LINE 00000067 "use Fcntl;"
NSQ_SOURCE_LINE 00000068 "$SIG{HUP}=sub{exit};"
NSQ_SOURCE_LINE 00000069 "if ( my $fn=shift ) {"
NSQ_SOURCE_LINE 00000070 "    sysopen(my $fh, qq{$fn}, O_WRONLY|O_CREAT|O_EXCL) or die $!;"
NSQ_SOURCE_LINE 00000071 "    print {$fh} $$;"
NSQ_SOURCE_LINE 00000072 "    close $fh;"
NSQ_SOURCE_LINE 00000073 "}"
NSQ_SOURCE_LINE 00000074 "my $buf; while (sysread(STDIN, $buf, 2048)) {"
NSQ_SOURCE_LINE 00000075 "    syswrite(STDOUT, $buf); syswrite(STDERR, $buf);"
NSQ_SOURCE_LINE 00000076 "}"
NSQ_SOURCE_LINE 00000077 "HERE"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000080 "# filehandle manipulation"
NSQ_SOURCE_LINE 00000081 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "sub _relayer {"
NSQ_SOURCE_LINE 00000084 "  my ($fh, $apply_layers) = @_;"
NSQ_SOURCE_LINE 00000085 "  # _debug(\"# requested layers (@{$layers}) for @{[fileno $fh]}\\n\");"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "  # eliminate pseudo-layers"
NSQ_SOURCE_LINE 00000088 "  binmode( $fh, \":raw\" );"
NSQ_SOURCE_LINE 00000089 "  # strip off real layers until only :unix is left"
NSQ_SOURCE_LINE 00000090 "  while ( 1 < ( my $layers =()= PerlIO::get_layers( $fh, output => 1 ) ) ) {"
NSQ_SOURCE_LINE 00000091 "      binmode( $fh, \":pop\" );"
NSQ_SOURCE_LINE 00000092 "  }"
NSQ_SOURCE_LINE 00000093 "  # apply other layers"
NSQ_SOURCE_LINE 00000094 "  my @to_apply = @$apply_layers;"
NSQ_SOURCE_LINE 00000095 "  shift @to_apply; # eliminate initial :unix"
NSQ_SOURCE_LINE 00000096 "  # _debug(\"# applying layers  (unix @to_apply) to @{[fileno $fh]}\\n\");"
NSQ_SOURCE_LINE 00000097 "  binmode($fh, \":\" . join(\":\",@to_apply));"
NSQ_SOURCE_LINE 00000098 "}"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "sub _name {"
NSQ_SOURCE_LINE 00000101 "  my $glob = shift;"
NSQ_SOURCE_LINE 00000102 "  no strict 'refs'; ## no critic"
NSQ_SOURCE_LINE 00000103 "  return *{$glob}{NAME};"
NSQ_SOURCE_LINE 00000104 "}"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "sub _open {"
NSQ_SOURCE_LINE 00000107 "  open $_[0], $_[1] or Carp::confess \"Error from open(\" . join(q{, }, @_) . \"): $!\";"
NSQ_SOURCE_LINE 00000108 "  # _debug( \"# open \" . join( \", \" , map { defined $_ ? _name($_) : 'undef' } @_ ) . \" as \" . fileno( $_[0] ) . \"\\n\" );"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "sub _close {"
NSQ_SOURCE_LINE 00000112 "  # _debug( \"# closing \" . ( defined $_[0] ? _name($_[0]) : 'undef' )  . \" on \" . fileno( $_[0] ) . \"\\n\" );"
NSQ_SOURCE_LINE 00000113 "  close $_[0] or Carp::confess \"Error from close(\" . join(q{, }, @_) . \"): $!\";"
NSQ_SOURCE_LINE 00000114 "}"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "my %dup; # cache this so STDIN stays fd0"
NSQ_SOURCE_LINE 00000117 "my %proxy_count;"
NSQ_SOURCE_LINE 00000118 "sub _proxy_std {"
NSQ_SOURCE_LINE 00000119 "  my %proxies;"
NSQ_SOURCE_LINE 00000120 "  if ( ! defined fileno STDIN ) {"
NSQ_SOURCE_LINE 00000121 "    $proxy_count{stdin}++;"
NSQ_SOURCE_LINE 00000122 "    if (defined $dup{stdin}) {"
NSQ_SOURCE_LINE 00000123 "      _open \\*STDIN, \"<&=\" . fileno($dup{stdin});"
NSQ_SOURCE_LINE 00000124 "      # _debug( \"# restored proxy STDIN as \" . (defined fileno STDIN ? fileno STDIN : 'undef' ) . \"\\n\" );"
NSQ_SOURCE_LINE 00000125 "    }"
NSQ_SOURCE_LINE 00000126 "    else {"
NSQ_SOURCE_LINE 00000127 "      _open \\*STDIN, \"<\" . File::Spec->devnull;"
NSQ_SOURCE_LINE 00000128 "      # _debug( \"# proxied STDIN as \" . (defined fileno STDIN ? fileno STDIN : 'undef' ) . \"\\n\" );"
NSQ_SOURCE_LINE 00000129 "      _open $dup{stdin} = IO::Handle->new, \"<&=STDIN\";"
NSQ_SOURCE_LINE 00000130 "    }"
NSQ_SOURCE_LINE 00000131 "    $proxies{stdin} = \\*STDIN;"
NSQ_SOURCE_LINE 00000132 "    binmode(STDIN, ':utf8') if $] >= 5.008; ## no critic"
NSQ_SOURCE_LINE 00000133 "  }"
NSQ_SOURCE_LINE 00000134 "  if ( ! defined fileno STDOUT ) {"
NSQ_SOURCE_LINE 00000135 "    $proxy_count{stdout}++;"
NSQ_SOURCE_LINE 00000136 "    if (defined $dup{stdout}) {"
NSQ_SOURCE_LINE 00000137 "      _open \\*STDOUT, \">&=\" . fileno($dup{stdout});"
NSQ_SOURCE_LINE 00000138 "      # _debug( \"# restored proxy STDOUT as \" . (defined fileno STDOUT ? fileno STDOUT : 'undef' ) . \"\\n\" );"
NSQ_SOURCE_LINE 00000139 "    }"
NSQ_SOURCE_LINE 00000140 "    else {"
NSQ_SOURCE_LINE 00000141 "      _open \\*STDOUT, \">\" . File::Spec->devnull;"
NSQ_SOURCE_LINE 00000142 "       # _debug( \"# proxied STDOUT as \" . (defined fileno STDOUT ? fileno STDOUT : 'undef' ) . \"\\n\" );"
NSQ_SOURCE_LINE 00000143 "      _open $dup{stdout} = IO::Handle->new, \">&=STDOUT\";"
NSQ_SOURCE_LINE 00000144 "    }"
NSQ_SOURCE_LINE 00000145 "    $proxies{stdout} = \\*STDOUT;"
NSQ_SOURCE_LINE 00000146 "    binmode(STDOUT, ':utf8') if $] >= 5.008; ## no critic"
NSQ_SOURCE_LINE 00000147 "  }"
NSQ_SOURCE_LINE 00000148 "  if ( ! defined fileno STDERR ) {"
NSQ_SOURCE_LINE 00000149 "    $proxy_count{stderr}++;"
NSQ_SOURCE_LINE 00000150 "    if (defined $dup{stderr}) {"
NSQ_SOURCE_LINE 00000151 "      _open \\*STDERR, \">&=\" . fileno($dup{stderr});"
NSQ_SOURCE_LINE 00000152 "       # _debug( \"# restored proxy STDERR as \" . (defined fileno STDERR ? fileno STDERR : 'undef' ) . \"\\n\" );"
NSQ_SOURCE_LINE 00000153 "    }"
NSQ_SOURCE_LINE 00000154 "    else {"
NSQ_SOURCE_LINE 00000155 "      _open \\*STDERR, \">\" . File::Spec->devnull;"
NSQ_SOURCE_LINE 00000156 "       # _debug( \"# proxied STDERR as \" . (defined fileno STDERR ? fileno STDERR : 'undef' ) . \"\\n\" );"
NSQ_SOURCE_LINE 00000157 "      _open $dup{stderr} = IO::Handle->new, \">&=STDERR\";"
NSQ_SOURCE_LINE 00000158 "    }"
NSQ_SOURCE_LINE 00000159 "    $proxies{stderr} = \\*STDERR;"
NSQ_SOURCE_LINE 00000160 "    binmode(STDERR, ':utf8') if $] >= 5.008; ## no critic"
NSQ_SOURCE_LINE 00000161 "  }"
NSQ_SOURCE_LINE 00000162 "  return %proxies;"
NSQ_SOURCE_LINE 00000163 "}"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "sub _unproxy {"
NSQ_SOURCE_LINE 00000166 "  my (%proxies) = @_;"
NSQ_SOURCE_LINE 00000167 "  # _debug( \"# unproxying: \" . join(\" \", keys %proxies) . \"\\n\" );"
NSQ_SOURCE_LINE 00000168 "  for my $p ( keys %proxies ) {"
NSQ_SOURCE_LINE 00000169 "    $proxy_count{$p}--;"
NSQ_SOURCE_LINE 00000170 "    # _debug( \"# unproxied \" . uc($p) . \" ($proxy_count{$p} left)\\n\" );"
NSQ_SOURCE_LINE 00000171 "    if ( ! $proxy_count{$p} ) {"
NSQ_SOURCE_LINE 00000172 "      _close $proxies{$p};"
NSQ_SOURCE_LINE 00000173 "      _close $dup{$p} unless $] < 5.008; # 5.6 will have already closed this as dup"
NSQ_SOURCE_LINE 00000174 "      delete $dup{$p};"
NSQ_SOURCE_LINE 00000175 "    }"
NSQ_SOURCE_LINE 00000176 "  }"
NSQ_SOURCE_LINE 00000177 "}"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "sub _copy_std {"
NSQ_SOURCE_LINE 00000180 "  my %handles;"
NSQ_SOURCE_LINE 00000181 "  for my $h ( qw/stdout stderr stdin/ ) {"
NSQ_SOURCE_LINE 00000182 "    next if $h eq 'stdin' && ! $IS_WIN32; # WIN32 hangs on tee without STDIN copied"
NSQ_SOURCE_LINE 00000183 "    my $redir = $h eq 'stdin' ? \"<&\" : \">&\";"
NSQ_SOURCE_LINE 00000184 "    _open $handles{$h} = IO::Handle->new(), $redir . uc($h); # \">&STDOUT\" or \"<&STDIN\""
NSQ_SOURCE_LINE 00000185 "  }"
NSQ_SOURCE_LINE 00000186 "  return \\%handles;"
NSQ_SOURCE_LINE 00000187 "}"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "# In some cases we open all (prior to forking) and in others we only open"
NSQ_SOURCE_LINE 00000190 "# the output handles (setting up redirection)"
NSQ_SOURCE_LINE 00000191 "sub _open_std {"
NSQ_SOURCE_LINE 00000192 "  my ($handles) = @_;"
NSQ_SOURCE_LINE 00000193 "  _open \\*STDIN, \"<&\" . fileno $handles->{stdin} if defined $handles->{stdin};"
NSQ_SOURCE_LINE 00000194 "  _open \\*STDOUT, \">&\" . fileno $handles->{stdout} if defined $handles->{stdout};"
NSQ_SOURCE_LINE 00000195 "  _open \\*STDERR, \">&\" . fileno $handles->{stderr} if defined $handles->{stderr};"
NSQ_SOURCE_LINE 00000196 "}"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000199 "# private subs"
NSQ_SOURCE_LINE 00000200 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "sub _start_tee {"
NSQ_SOURCE_LINE 00000203 "  my ($which, $stash) = @_; # $which is \"stdout\" or \"stderr\""
NSQ_SOURCE_LINE 00000204 "  # setup pipes"
NSQ_SOURCE_LINE 00000205 "  $stash->{$_}{$which} = IO::Handle->new for qw/tee reader/;"
NSQ_SOURCE_LINE 00000206 "  pipe $stash->{reader}{$which}, $stash->{tee}{$which};"
NSQ_SOURCE_LINE 00000207 "  # _debug( \"# pipe for $which\\: \" .  _name($stash->{tee}{$which}) . \" \" . fileno( $stash->{tee}{$which} ) . \" => \" . _name($stash->{reader}{$which}) . \" \" . fileno( $stash->{reader}{$which}) . \"\\n\" );"
NSQ_SOURCE_LINE 00000208 "  select((select($stash->{tee}{$which}), $|=1)[0]); # autoflush"
NSQ_SOURCE_LINE 00000209 "  # setup desired redirection for parent and child"
NSQ_SOURCE_LINE 00000210 "  $stash->{new}{$which} = $stash->{tee}{$which};"
NSQ_SOURCE_LINE 00000211 "  $stash->{child}{$which} = {"
NSQ_SOURCE_LINE 00000212 "    stdin   => $stash->{reader}{$which},"
NSQ_SOURCE_LINE 00000213 "    stdout  => $stash->{old}{$which},"
NSQ_SOURCE_LINE 00000214 "    stderr  => $stash->{capture}{$which},"
NSQ_SOURCE_LINE 00000215 "  };"
NSQ_SOURCE_LINE 00000216 "  # flag file is used to signal the child is ready"
NSQ_SOURCE_LINE 00000217 "  $stash->{flag_files}{$which} = scalar( tmpnam() ) . $$;"
NSQ_SOURCE_LINE 00000218 "  # execute @cmd as a separate process"
NSQ_SOURCE_LINE 00000219 "  if ( $IS_WIN32 ) {"
NSQ_SOURCE_LINE 00000220 "    my $old_eval_err=$@;"
NSQ_SOURCE_LINE 00000221 "    undef $@;"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "    eval \"use Win32API::File qw/GetOsFHandle SetHandleInformation fileLastError HANDLE_FLAG_INHERIT INVALID_HANDLE_VALUE/ \";"
NSQ_SOURCE_LINE 00000224 "    # _debug( \"# Win32API::File loaded\\n\") unless $@;"
NSQ_SOURCE_LINE 00000225 "    my $os_fhandle = GetOsFHandle( $stash->{tee}{$which} );"
NSQ_SOURCE_LINE 00000226 "    # _debug( \"# Couldn't get OS handle: \" . fileLastError() . \"\\n\") if ! defined $os_fhandle || $os_fhandle == INVALID_HANDLE_VALUE();"
NSQ_SOURCE_LINE 00000227 "    my $result = SetHandleInformation( $os_fhandle, HANDLE_FLAG_INHERIT(), 0);"
NSQ_SOURCE_LINE 00000228 "    # _debug( $result ? \"# set no-inherit flag on $which tee\\n\" : (\"# can't disable tee handle flag inherit: \" . fileLastError() . \"\\n\"));"
NSQ_SOURCE_LINE 00000229 "    _open_std( $stash->{child}{$which} );"
NSQ_SOURCE_LINE 00000230 "    $stash->{pid}{$which} = system(1, @cmd, $stash->{flag_files}{$which});"
NSQ_SOURCE_LINE 00000231 "    # not restoring std here as it all gets redirected again shortly anyway"
NSQ_SOURCE_LINE 00000232 "    $@=$old_eval_err;"
NSQ_SOURCE_LINE 00000233 "  }"
NSQ_SOURCE_LINE 00000234 "  else { # use fork"
NSQ_SOURCE_LINE 00000235 "    _fork_exec( $which, $stash );"
NSQ_SOURCE_LINE 00000236 "  }"
NSQ_SOURCE_LINE 00000237 "}"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "sub _fork_exec {"
NSQ_SOURCE_LINE 00000240 "  my ($which, $stash) = @_; # $which is \"stdout\" or \"stderr\""
NSQ_SOURCE_LINE 00000241 "  my $pid = fork;"
NSQ_SOURCE_LINE 00000242 "  if ( not defined $pid ) {"
NSQ_SOURCE_LINE 00000243 "    Carp::confess \"Couldn't fork(): $!\";"
NSQ_SOURCE_LINE 00000244 "  }"
NSQ_SOURCE_LINE 00000245 "  elsif ($pid == 0) { # child"
NSQ_SOURCE_LINE 00000246 "    # _debug( \"# in child process ...\\n\" );"
NSQ_SOURCE_LINE 00000247 "    untie *STDIN; untie *STDOUT; untie *STDERR;"
NSQ_SOURCE_LINE 00000248 "    _close $stash->{tee}{$which};"
NSQ_SOURCE_LINE 00000249 "    # _debug( \"# redirecting handles in child ...\\n\" );"
NSQ_SOURCE_LINE 00000250 "    _open_std( $stash->{child}{$which} );"
NSQ_SOURCE_LINE 00000251 "    # _debug( \"# calling exec on command ...\\n\" );"
NSQ_SOURCE_LINE 00000252 "    exec @cmd, $stash->{flag_files}{$which};"
NSQ_SOURCE_LINE 00000253 "  }"
NSQ_SOURCE_LINE 00000254 "  $stash->{pid}{$which} = $pid"
NSQ_SOURCE_LINE 00000255 "}"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "my $have_usleep = eval \"use Time::HiRes 'usleep'; 1\";"
NSQ_SOURCE_LINE 00000258 "sub _files_exist {"
NSQ_SOURCE_LINE 00000259 "  return 1 if @_ == grep { -f } @_;"
NSQ_SOURCE_LINE 00000260 "  Time::HiRes::usleep(1000) if $have_usleep;"
NSQ_SOURCE_LINE 00000261 "  return 0;"
NSQ_SOURCE_LINE 00000262 "}"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "sub _wait_for_tees {"
NSQ_SOURCE_LINE 00000265 "  my ($stash) = @_;"
NSQ_SOURCE_LINE 00000266 "  my $start = time;"
NSQ_SOURCE_LINE 00000267 "  my @files = values %{$stash->{flag_files}};"
NSQ_SOURCE_LINE 00000268 "  my $timeout = defined $ENV{PERL_CAPTURE_TINY_TIMEOUT}"
NSQ_SOURCE_LINE 00000269 "              ? $ENV{PERL_CAPTURE_TINY_TIMEOUT} : $TIMEOUT;"
NSQ_SOURCE_LINE 00000270 "  1 until _files_exist(@files) || ($timeout && (time - $start > $timeout));"
NSQ_SOURCE_LINE 00000271 "  Carp::confess \"Timed out waiting for subprocesses to start\" if ! _files_exist(@files);"
NSQ_SOURCE_LINE 00000272 "  unlink $_ for @files;"
NSQ_SOURCE_LINE 00000273 "}"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "sub _kill_tees {"
NSQ_SOURCE_LINE 00000276 "  my ($stash) = @_;"
NSQ_SOURCE_LINE 00000277 "  if ( $IS_WIN32 ) {"
NSQ_SOURCE_LINE 00000278 "    # _debug( \"# closing handles\\n\");"
NSQ_SOURCE_LINE 00000279 "    close($_) for values %{ $stash->{tee} };"
NSQ_SOURCE_LINE 00000280 "    # _debug( \"# waiting for subprocesses to finish\\n\");"
NSQ_SOURCE_LINE 00000281 "    my $start = time;"
NSQ_SOURCE_LINE 00000282 "    1 until wait == -1 || (time - $start > 30);"
NSQ_SOURCE_LINE 00000283 "  }"
NSQ_SOURCE_LINE 00000284 "  else {"
NSQ_SOURCE_LINE 00000285 "    _close $_ for values %{ $stash->{tee} };"
NSQ_SOURCE_LINE 00000286 "    waitpid $_, 0 for values %{ $stash->{pid} };"
NSQ_SOURCE_LINE 00000287 "  }"
NSQ_SOURCE_LINE 00000288 "}"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "sub _slurp {"
NSQ_SOURCE_LINE 00000291 "  my ($name, $stash) = @_;"
NSQ_SOURCE_LINE 00000292 "  my ($fh, $pos) = map { $stash->{$_}{$name} } qw/capture pos/;"
NSQ_SOURCE_LINE 00000293 "  # _debug( \"# slurping captured $name from \" . fileno($fh) . \" at pos $pos with layers: @{[PerlIO::get_layers($fh)]}\\n\");"
NSQ_SOURCE_LINE 00000294 "  seek( $fh, $pos, 0 ) or die \"Couldn't seek on capture handle for $name\\n\";"
NSQ_SOURCE_LINE 00000295 "  my $text = do { local $/; scalar readline $fh };"
NSQ_SOURCE_LINE 00000296 "  return defined($text) ? $text : \"\";"
NSQ_SOURCE_LINE 00000297 "}"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000300 "# _capture_tee() -- generic main sub for capturing or teeing"
NSQ_SOURCE_LINE 00000301 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "sub _capture_tee {"
NSQ_SOURCE_LINE 00000304 "  # _debug( \"# starting _capture_tee with (@_)...\\n\" );"
NSQ_SOURCE_LINE 00000305 "  my ($do_stdout, $do_stderr, $do_merge, $do_tee, $code, @opts) = @_;"
NSQ_SOURCE_LINE 00000306 "  my %do = ($do_stdout ? (stdout => 1) : (),  $do_stderr ? (stderr => 1) : ());"
NSQ_SOURCE_LINE 00000307 "  Carp::confess(\"Custom capture options must be given as key/value pairs\\n\")"
NSQ_SOURCE_LINE 00000308 "    unless @opts % 2 == 0;"
NSQ_SOURCE_LINE 00000309 "  my $stash = { capture => { @opts } };"
NSQ_SOURCE_LINE 00000310 "  for ( keys %{$stash->{capture}} ) {"
NSQ_SOURCE_LINE 00000311 "    my $fh = $stash->{capture}{$_};"
NSQ_SOURCE_LINE 00000312 "    Carp::confess \"Custom handle for $_ must be seekable\\n\""
NSQ_SOURCE_LINE 00000313 "      unless ref($fh) eq 'GLOB' || (blessed($fh) && $fh->isa(\"IO::Seekable\"));"
NSQ_SOURCE_LINE 00000314 "  }"
NSQ_SOURCE_LINE 00000315 "  # save existing filehandles and setup captures"
NSQ_SOURCE_LINE 00000316 "  local *CT_ORIG_STDIN  = *STDIN ;"
NSQ_SOURCE_LINE 00000317 "  local *CT_ORIG_STDOUT = *STDOUT;"
NSQ_SOURCE_LINE 00000318 "  local *CT_ORIG_STDERR = *STDERR;"
NSQ_SOURCE_LINE 00000319 "  # find initial layers"
NSQ_SOURCE_LINE 00000320 "  my %layers = ("
NSQ_SOURCE_LINE 00000321 "    stdin   => [PerlIO::get_layers(\\*STDIN) ],"
NSQ_SOURCE_LINE 00000322 "    stdout  => [PerlIO::get_layers(\\*STDOUT, output => 1)],"
NSQ_SOURCE_LINE 00000323 "    stderr  => [PerlIO::get_layers(\\*STDERR, output => 1)],"
NSQ_SOURCE_LINE 00000324 "  );"
NSQ_SOURCE_LINE 00000325 "  # _debug( \"# existing layers for $_\\: @{$layers{$_}}\\n\" ) for qw/stdin stdout stderr/;"
NSQ_SOURCE_LINE 00000326 "  # get layers from underlying glob of tied filehandles if we can"
NSQ_SOURCE_LINE 00000327 "  # (this only works for things that work like Tie::StdHandle)"
NSQ_SOURCE_LINE 00000328 "  $layers{stdout} = [PerlIO::get_layers(tied *STDOUT)]"
NSQ_SOURCE_LINE 00000329 "    if tied(*STDOUT) && (reftype tied *STDOUT eq 'GLOB');"
NSQ_SOURCE_LINE 00000330 "  $layers{stderr} = [PerlIO::get_layers(tied *STDERR)]"
NSQ_SOURCE_LINE 00000331 "    if tied(*STDERR) && (reftype tied *STDERR eq 'GLOB');"
NSQ_SOURCE_LINE 00000332 "  # _debug( \"# tied object corrected layers for $_\\: @{$layers{$_}}\\n\" ) for qw/stdin stdout stderr/;"
NSQ_SOURCE_LINE 00000333 "  # bypass scalar filehandles and tied handles"
NSQ_SOURCE_LINE 00000334 "  # localize scalar STDIN to get a proxy to pick up FD0, then restore later to CT_ORIG_STDIN"
NSQ_SOURCE_LINE 00000335 "  my %localize;"
NSQ_SOURCE_LINE 00000336 "  $localize{stdin}++,  local(*STDIN)"
NSQ_SOURCE_LINE 00000337 "    if grep { $_ eq 'scalar' } @{$layers{stdin}};"
NSQ_SOURCE_LINE 00000338 "  $localize{stdout}++, local(*STDOUT)"
NSQ_SOURCE_LINE 00000339 "    if $do_stdout && grep { $_ eq 'scalar' } @{$layers{stdout}};"
NSQ_SOURCE_LINE 00000340 "  $localize{stderr}++, local(*STDERR)"
NSQ_SOURCE_LINE 00000341 "    if ($do_stderr || $do_merge) && grep { $_ eq 'scalar' } @{$layers{stderr}};"
NSQ_SOURCE_LINE 00000342 "  $localize{stdin}++, local(*STDIN), _open( \\*STDIN, \"<&=0\")"
NSQ_SOURCE_LINE 00000343 "    if tied *STDIN && $] >= 5.008;"
NSQ_SOURCE_LINE 00000344 "  $localize{stdout}++, local(*STDOUT), _open( \\*STDOUT, \">&=1\")"
NSQ_SOURCE_LINE 00000345 "    if $do_stdout && tied *STDOUT && $] >= 5.008;"
NSQ_SOURCE_LINE 00000346 "  $localize{stderr}++, local(*STDERR), _open( \\*STDERR, \">&=2\")"
NSQ_SOURCE_LINE 00000347 "    if ($do_stderr || $do_merge) && tied *STDERR && $] >= 5.008;"
NSQ_SOURCE_LINE 00000348 "  # _debug( \"# localized $_\\n\" ) for keys %localize;"
NSQ_SOURCE_LINE 00000349 "  # proxy any closed/localized handles so we don't use fds 0, 1 or 2"
NSQ_SOURCE_LINE 00000350 "  my %proxy_std = _proxy_std();"
NSQ_SOURCE_LINE 00000351 "  # _debug( \"# proxy std: @{ [%proxy_std] }\\n\" );"
NSQ_SOURCE_LINE 00000352 "  # update layers after any proxying"
NSQ_SOURCE_LINE 00000353 "  $layers{stdout} = [PerlIO::get_layers(\\*STDOUT, output => 1)] if $proxy_std{stdout};"
NSQ_SOURCE_LINE 00000354 "  $layers{stderr} = [PerlIO::get_layers(\\*STDERR, output => 1)] if $proxy_std{stderr};"
NSQ_SOURCE_LINE 00000355 "  # _debug( \"# post-proxy layers for $_\\: @{$layers{$_}}\\n\" ) for qw/stdin stdout stderr/;"
NSQ_SOURCE_LINE 00000356 "  # store old handles and setup handles for capture"
NSQ_SOURCE_LINE 00000357 "  $stash->{old} = _copy_std();"
NSQ_SOURCE_LINE 00000358 "  $stash->{new} = { %{$stash->{old}} }; # default to originals"
NSQ_SOURCE_LINE 00000359 "  for ( keys %do ) {"
NSQ_SOURCE_LINE 00000360 "    $stash->{new}{$_} = ($stash->{capture}{$_} ||= File::Temp->new);"
NSQ_SOURCE_LINE 00000361 "    seek( $stash->{capture}{$_}, 0, 2 ) or die \"Could not seek on capture handle for $_\\n\";"
NSQ_SOURCE_LINE 00000362 "    $stash->{pos}{$_} = tell $stash->{capture}{$_};"
NSQ_SOURCE_LINE 00000363 "    # _debug(\"# will capture $_ on \" . fileno($stash->{capture}{$_}).\"\\n\" );"
NSQ_SOURCE_LINE 00000364 "    _start_tee( $_ => $stash ) if $do_tee; # tees may change $stash->{new}"
NSQ_SOURCE_LINE 00000365 "  }"
NSQ_SOURCE_LINE 00000366 "  _wait_for_tees( $stash ) if $do_tee;"
NSQ_SOURCE_LINE 00000367 "  # finalize redirection"
NSQ_SOURCE_LINE 00000368 "  $stash->{new}{stderr} = $stash->{new}{stdout} if $do_merge;"
NSQ_SOURCE_LINE 00000369 "  # _debug( \"# redirecting in parent ...\\n\" );"
NSQ_SOURCE_LINE 00000370 "  _open_std( $stash->{new} );"
NSQ_SOURCE_LINE 00000371 "  # execute user provided code"
NSQ_SOURCE_LINE 00000372 "  my ($exit_code, $inner_error, $outer_error, $orig_pid, @result);"
NSQ_SOURCE_LINE 00000373 "  {"
NSQ_SOURCE_LINE 00000374 "    $orig_pid = $$;"
NSQ_SOURCE_LINE 00000375 "    local *STDIN = *CT_ORIG_STDIN if $localize{stdin}; # get original, not proxy STDIN"
NSQ_SOURCE_LINE 00000376 "    # _debug( \"# finalizing layers ...\\n\" );"
NSQ_SOURCE_LINE 00000377 "    _relayer(\\*STDOUT, $layers{stdout}) if $do_stdout;"
NSQ_SOURCE_LINE 00000378 "    _relayer(\\*STDERR, $layers{stderr}) if $do_stderr;"
NSQ_SOURCE_LINE 00000379 "    # _debug( \"# running code $code ...\\n\" );"
NSQ_SOURCE_LINE 00000380 "    my $old_eval_err=$@;"
NSQ_SOURCE_LINE 00000381 "    undef $@;"
NSQ_SOURCE_LINE 00000382 "    eval { @result = $code->(); $inner_error = $@ };"
NSQ_SOURCE_LINE 00000383 "    $exit_code = $?; # save this for later"
NSQ_SOURCE_LINE 00000384 "    $outer_error = $@; # save this for later"
NSQ_SOURCE_LINE 00000385 "    STDOUT->flush if $do_stdout;"
NSQ_SOURCE_LINE 00000386 "    STDERR->flush if $do_stderr;"
NSQ_SOURCE_LINE 00000387 "    $@ = $old_eval_err;"
NSQ_SOURCE_LINE 00000388 "  }"
NSQ_SOURCE_LINE 00000389 "  # restore prior filehandles and shut down tees"
NSQ_SOURCE_LINE 00000390 "  # _debug( \"# restoring filehandles ...\\n\" );"
NSQ_SOURCE_LINE 00000391 "  _open_std( $stash->{old} );"
NSQ_SOURCE_LINE 00000392 "  _close( $_ ) for values %{$stash->{old}}; # don't leak fds"
NSQ_SOURCE_LINE 00000393 "  # shouldn't need relayering originals, but see rt.perl.org #114404"
NSQ_SOURCE_LINE 00000394 "  _relayer(\\*STDOUT, $layers{stdout}) if $do_stdout;"
NSQ_SOURCE_LINE 00000395 "  _relayer(\\*STDERR, $layers{stderr}) if $do_stderr;"
NSQ_SOURCE_LINE 00000396 "  _unproxy( %proxy_std );"
NSQ_SOURCE_LINE 00000397 "  # _debug( \"# killing tee subprocesses ...\\n\" ) if $do_tee;"
NSQ_SOURCE_LINE 00000398 "  _kill_tees( $stash ) if $do_tee;"
NSQ_SOURCE_LINE 00000399 "  # return captured output, but shortcut in void context"
NSQ_SOURCE_LINE 00000400 "  # unless we have to echo output to tied/scalar handles;"
NSQ_SOURCE_LINE 00000401 "  my %got;"
NSQ_SOURCE_LINE 00000402 "  if ( $orig_pid == $$ and ( defined wantarray or ($do_tee && keys %localize) ) ) {"
NSQ_SOURCE_LINE 00000403 "    for ( keys %do ) {"
NSQ_SOURCE_LINE 00000404 "      _relayer($stash->{capture}{$_}, $layers{$_});"
NSQ_SOURCE_LINE 00000405 "      $got{$_} = _slurp($_, $stash);"
NSQ_SOURCE_LINE 00000406 "      # _debug(\"# slurped \" . length($got{$_}) . \" bytes from $_\\n\");"
NSQ_SOURCE_LINE 00000407 "    }"
NSQ_SOURCE_LINE 00000408 "    print CT_ORIG_STDOUT $got{stdout}"
NSQ_SOURCE_LINE 00000409 "      if $do_stdout && $do_tee && $localize{stdout};"
NSQ_SOURCE_LINE 00000410 "    print CT_ORIG_STDERR $got{stderr}"
NSQ_SOURCE_LINE 00000411 "      if $do_stderr && $do_tee && $localize{stderr};"
NSQ_SOURCE_LINE 00000412 "  }"
NSQ_SOURCE_LINE 00000413 "  $? = $exit_code;"
NSQ_SOURCE_LINE 00000414 "  $@ = $inner_error if $inner_error;"
NSQ_SOURCE_LINE 00000415 "  die $outer_error if $outer_error;"
NSQ_SOURCE_LINE 00000416 "  # _debug( \"# ending _capture_tee with (@_)...\\n\" );"
NSQ_SOURCE_LINE 00000417 "  return unless defined wantarray;"
NSQ_SOURCE_LINE 00000418 "  my @return;"
NSQ_SOURCE_LINE 00000419 "  push @return, $got{stdout} if $do_stdout;"
NSQ_SOURCE_LINE 00000420 "  push @return, $got{stderr} if $do_stderr && ! $do_merge;"
NSQ_SOURCE_LINE 00000421 "  push @return, @result;"
NSQ_SOURCE_LINE 00000422 "  return wantarray ? @return : $return[0];"
NSQ_SOURCE_LINE 00000423 "}"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "1;"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "__END__"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "=pod"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=head1 NAME"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "Capture::Tiny - Capture STDOUT and STDERR from Perl, XS or external programs"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=head1 VERSION"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "version 0.50"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "  use Capture::Tiny ':all';"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "  # capture from external command"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "  ($stdout, $stderr, $exit) = capture {"
NSQ_SOURCE_LINE 00000448 "    system( $cmd, @args );"
NSQ_SOURCE_LINE 00000449 "  };"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "  # capture from arbitrary code (Perl or external)"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "  ($stdout, $stderr, @result) = capture {"
NSQ_SOURCE_LINE 00000454 "    # your code here"
NSQ_SOURCE_LINE 00000455 "  };"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "  # capture partial or merged output"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "  $stdout = capture_stdout { ... };"
NSQ_SOURCE_LINE 00000460 "  $stderr = capture_stderr { ... };"
NSQ_SOURCE_LINE 00000461 "  $merged = capture_merged { ... };"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "  # tee output"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "  ($stdout, $stderr) = tee {"
NSQ_SOURCE_LINE 00000466 "    # your code here"
NSQ_SOURCE_LINE 00000467 "  };"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "  $stdout = tee_stdout { ... };"
NSQ_SOURCE_LINE 00000470 "  $stderr = tee_stderr { ... };"
NSQ_SOURCE_LINE 00000471 "  $merged = tee_merged { ... };"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "Capture::Tiny provides a simple, portable way to capture almost anything sent"
NSQ_SOURCE_LINE 00000476 "to STDOUT or STDERR, regardless of whether it comes from Perl, from XS code or"
NSQ_SOURCE_LINE 00000477 "from an external program.  Optionally, output can be teed so that it is"
NSQ_SOURCE_LINE 00000478 "captured while being passed through to the original filehandles.  Yes, it even"
NSQ_SOURCE_LINE 00000479 "works on Windows (usually).  Stop guessing which of a dozen capturing modules"
NSQ_SOURCE_LINE 00000480 "to use in any particular situation and just use this one."
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "=head1 USAGE"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "The following functions are available.  None are exported by default."
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "=head2 capture"
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "  ($stdout, $stderr, @result) = capture \\&code;"
NSQ_SOURCE_LINE 00000489 "  $stdout = capture \\&code;"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "The C<capture> function takes a code reference and returns what is sent to"
NSQ_SOURCE_LINE 00000492 "STDOUT and STDERR as well as any return values from the code reference.  In"
NSQ_SOURCE_LINE 00000493 "scalar context, it returns only STDOUT.  If no output was received for a"
NSQ_SOURCE_LINE 00000494 "filehandle, it returns an empty string for that filehandle.  Regardless of calling"
NSQ_SOURCE_LINE 00000495 "context, all output is captured -- nothing is passed to the existing filehandles."
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "It is prototyped to take a subroutine reference as an argument. Thus, it"
NSQ_SOURCE_LINE 00000498 "can be called in block form:"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "  ($stdout, $stderr) = capture {"
NSQ_SOURCE_LINE 00000501 "    # your code here ..."
NSQ_SOURCE_LINE 00000502 "  };"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "Note that the coderef is evaluated in list context.  If you wish to force"
NSQ_SOURCE_LINE 00000505 "scalar context on the return value, you must use the C<scalar> keyword."
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "  ($stdout, $stderr, $count) = capture {"
NSQ_SOURCE_LINE 00000508 "    my @list = qw/one two three/;"
NSQ_SOURCE_LINE 00000509 "    return scalar @list; # $count will be 3"
NSQ_SOURCE_LINE 00000510 "  };"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "Also note that within the coderef, the C<@_> variable will be empty.  So don't"
NSQ_SOURCE_LINE 00000513 "use arguments from a surrounding subroutine without copying them to an array"
NSQ_SOURCE_LINE 00000514 "first:"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "  sub wont_work {"
NSQ_SOURCE_LINE 00000517 "    my ($stdout, $stderr) = capture { do_stuff( @_ ) };    # WRONG"
NSQ_SOURCE_LINE 00000518 "    ..."
NSQ_SOURCE_LINE 00000519 "  }"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "  sub will_work {"
NSQ_SOURCE_LINE 00000522 "    my @args = @_;"
NSQ_SOURCE_LINE 00000523 "    my ($stdout, $stderr) = capture { do_stuff( @args ) }; # RIGHT"
NSQ_SOURCE_LINE 00000524 "    ..."
NSQ_SOURCE_LINE 00000525 "  }"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "Captures are normally done to an anonymous temporary filehandle.  To"
NSQ_SOURCE_LINE 00000528 "capture via a named file (e.g. to externally monitor a long-running capture),"
NSQ_SOURCE_LINE 00000529 "provide custom filehandles as a trailing list of option pairs:"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "  my $out_fh = IO::File->new(\"out.txt\", \"w+\");"
NSQ_SOURCE_LINE 00000532 "  my $err_fh = IO::File->new(\"err.txt\", \"w+\");"
NSQ_SOURCE_LINE 00000533 "  capture { ... } stdout => $out_fh, stderr => $err_fh;"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "The filehandles must be read/write and seekable.  Modifying the files or"
NSQ_SOURCE_LINE 00000536 "filehandles during a capture operation will give unpredictable results."
NSQ_SOURCE_LINE 00000537 "Existing IO layers on them may be changed by the capture."
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "When called in void context, C<capture> saves memory and time by"
NSQ_SOURCE_LINE 00000540 "not reading back from the capture handles."
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "=head2 capture_stdout"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "  ($stdout, @result) = capture_stdout \\&code;"
NSQ_SOURCE_LINE 00000545 "  $stdout = capture_stdout \\&code;"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "The C<capture_stdout> function works just like C<capture> except only"
NSQ_SOURCE_LINE 00000548 "STDOUT is captured.  STDERR is not captured."
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "=head2 capture_stderr"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "  ($stderr, @result) = capture_stderr \\&code;"
NSQ_SOURCE_LINE 00000553 "  $stderr = capture_stderr \\&code;"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "The C<capture_stderr> function works just like C<capture> except only"
NSQ_SOURCE_LINE 00000556 "STDERR is captured.  STDOUT is not captured."
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "=head2 capture_merged"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "  ($merged, @result) = capture_merged \\&code;"
NSQ_SOURCE_LINE 00000561 "  $merged = capture_merged \\&code;"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "The C<capture_merged> function works just like C<capture> except STDOUT and"
NSQ_SOURCE_LINE 00000564 "STDERR are merged. (Technically, STDERR is redirected to the same capturing"
NSQ_SOURCE_LINE 00000565 "handle as STDOUT before executing the function.)"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "Caution: STDOUT and STDERR output in the merged result are not guaranteed to be"
NSQ_SOURCE_LINE 00000568 "properly ordered due to buffering."
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "=head2 tee"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "  ($stdout, $stderr, @result) = tee \\&code;"
NSQ_SOURCE_LINE 00000573 "  $stdout = tee \\&code;"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "The C<tee> function works just like C<capture>, except that output is captured"
NSQ_SOURCE_LINE 00000576 "as well as passed on to the original STDOUT and STDERR."
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "When called in void context, C<tee> saves memory and time by"
NSQ_SOURCE_LINE 00000579 "not reading back from the capture handles, except when the"
NSQ_SOURCE_LINE 00000580 "original STDOUT or STDERR were tied or opened to a scalar"
NSQ_SOURCE_LINE 00000581 "handle."
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "=head2 tee_stdout"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "  ($stdout, @result) = tee_stdout \\&code;"
NSQ_SOURCE_LINE 00000586 "  $stdout = tee_stdout \\&code;"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "The C<tee_stdout> function works just like C<tee> except only"
NSQ_SOURCE_LINE 00000589 "STDOUT is teed.  STDERR is not teed (output goes to STDERR as usual)."
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "=head2 tee_stderr"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "  ($stderr, @result) = tee_stderr \\&code;"
NSQ_SOURCE_LINE 00000594 "  $stderr = tee_stderr \\&code;"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "The C<tee_stderr> function works just like C<tee> except only"
NSQ_SOURCE_LINE 00000597 "STDERR is teed.  STDOUT is not teed (output goes to STDOUT as usual)."
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "=head2 tee_merged"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "  ($merged, @result) = tee_merged \\&code;"
NSQ_SOURCE_LINE 00000602 "  $merged = tee_merged \\&code;"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "The C<tee_merged> function works just like C<capture_merged> except that output"
NSQ_SOURCE_LINE 00000605 "is captured as well as passed on to STDOUT."
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "Caution: STDOUT and STDERR output in the merged result are not guaranteed to be"
NSQ_SOURCE_LINE 00000608 "properly ordered due to buffering."
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "=head2 Portability"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "Portability is a goal, not a guarantee.  C<tee> requires fork, except on"
NSQ_SOURCE_LINE 00000615 "Windows where C<system(1, @cmd)> is used instead.  Not tested on any"
NSQ_SOURCE_LINE 00000616 "particularly esoteric platforms yet.  See the"
NSQ_SOURCE_LINE 00000617 "L<CPAN Testers Matrix|http://matrix.cpantesters.org/?dist=Capture-Tiny>"
NSQ_SOURCE_LINE 00000618 "for test result by platform."
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "=head2 PerlIO layers"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "Capture::Tiny does its best to preserve PerlIO layers such as ':utf8' or"
NSQ_SOURCE_LINE 00000623 "':crlf' when capturing (only for Perl 5.8.1+) .  Layers should be applied to"
NSQ_SOURCE_LINE 00000624 "STDOUT or STDERR I<before> the call to C<capture> or C<tee>.  This may not work"
NSQ_SOURCE_LINE 00000625 "for tied filehandles (see below)."
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "=head2 Modifying filehandles before capturing"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "Generally speaking, you should do little or no manipulation of the standard IO"
NSQ_SOURCE_LINE 00000630 "filehandles prior to using Capture::Tiny.  In particular, closing, reopening,"
NSQ_SOURCE_LINE 00000631 "localizing or tying standard filehandles prior to capture may cause a variety of"
NSQ_SOURCE_LINE 00000632 "unexpected, undesirable and/or unreliable behaviors, as described below."
NSQ_SOURCE_LINE 00000633 "Capture::Tiny does its best to compensate for these situations, but the"
NSQ_SOURCE_LINE 00000634 "results may not be what you desire."
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "=head3 Closed filehandles"
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "Capture::Tiny will work even if STDIN, STDOUT or STDERR have been previously"
NSQ_SOURCE_LINE 00000639 "closed.  However, since they will be reopened to capture or tee output, any"
NSQ_SOURCE_LINE 00000640 "code within the captured block that depends on finding them closed will, of"
NSQ_SOURCE_LINE 00000641 "course, not find them to be closed.  If they started closed, Capture::Tiny will"
NSQ_SOURCE_LINE 00000642 "close them again when the capture block finishes."
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "Note that this reopening will happen even for STDIN or a filehandle not being"
NSQ_SOURCE_LINE 00000645 "captured to ensure that the filehandle used for capture is not opened to file"
NSQ_SOURCE_LINE 00000646 "descriptor 0, as this causes problems on various platforms."
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "Prior to Perl 5.12, closed STDIN combined with PERL_UNICODE=D leaks filehandles"
NSQ_SOURCE_LINE 00000649 "and also breaks tee() for undiagnosed reasons.  So don't do that."
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "=head3 Localized filehandles"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "If code localizes any of Perl's standard filehandles before capturing, the capture"
NSQ_SOURCE_LINE 00000654 "will affect the localized filehandles and not the original ones.  External system"
NSQ_SOURCE_LINE 00000655 "calls are not affected by localizing a filehandle in Perl and will continue"
NSQ_SOURCE_LINE 00000656 "to send output to the original filehandles (which will thus not be captured)."
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "=head3 Scalar filehandles"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "If STDOUT or STDERR are reopened to scalar filehandles prior to the call to"
NSQ_SOURCE_LINE 00000661 "C<capture> or C<tee>, then Capture::Tiny will override the output filehandle for"
NSQ_SOURCE_LINE 00000662 "the duration of the C<capture> or C<tee> call and then, for C<tee>, send captured"
NSQ_SOURCE_LINE 00000663 "output to the output filehandle after the capture is complete.  (Requires Perl"
NSQ_SOURCE_LINE 00000664 "5.8)"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "Capture::Tiny attempts to preserve the semantics of STDIN opened to a scalar"
NSQ_SOURCE_LINE 00000667 "reference, but note that external processes will not be able to read from such"
NSQ_SOURCE_LINE 00000668 "a handle.  Capture::Tiny tries to ensure that external processes will read from"
NSQ_SOURCE_LINE 00000669 "the null device instead, but this is not guaranteed."
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "=head3 Tied output filehandles"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "If STDOUT or STDERR are tied prior to the call to C<capture> or C<tee>, then"
NSQ_SOURCE_LINE 00000674 "Capture::Tiny will attempt to override the tie for the duration of the"
NSQ_SOURCE_LINE 00000675 "C<capture> or C<tee> call and then send captured output to the tied filehandle after"
NSQ_SOURCE_LINE 00000676 "the capture is complete.  (Requires Perl 5.8)"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "Capture::Tiny may not succeed resending UTF-8 encoded data to a tied"
NSQ_SOURCE_LINE 00000679 "STDOUT or STDERR filehandle.  Characters may appear as bytes.  If the tied filehandle"
NSQ_SOURCE_LINE 00000680 "is based on L<Tie::StdHandle>, then Capture::Tiny will attempt to determine"
NSQ_SOURCE_LINE 00000681 "appropriate layers like C<:utf8> from the underlying filehandle and do the right"
NSQ_SOURCE_LINE 00000682 "thing."
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "=head3 Tied input filehandle"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "Capture::Tiny attempts to preserve the semantics of tied STDIN, but this"
NSQ_SOURCE_LINE 00000687 "requires Perl 5.8 and is not entirely predictable.  External processes"
NSQ_SOURCE_LINE 00000688 "will not be able to read from such a handle."
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "Unless having STDIN tied is crucial, it may be safest to localize STDIN when"
NSQ_SOURCE_LINE 00000691 "capturing:"
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "  my ($out, $err) = do { local *STDIN; capture { ... } };"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "=head2 Modifying filehandles during a capture"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "Attempting to modify STDIN, STDOUT or STDERR I<during> C<capture> or C<tee> is"
NSQ_SOURCE_LINE 00000698 "almost certainly going to cause problems.  Don't do that."
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "=head3 Forking inside a capture"
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "Forks aren't portable.  The behavior of filehandles during a fork is even"
NSQ_SOURCE_LINE 00000703 "less so.  If Capture::Tiny detects that a fork has occurred within a"
NSQ_SOURCE_LINE 00000704 "capture, it will shortcut in the child process and return empty strings for"
NSQ_SOURCE_LINE 00000705 "captures.  Other problems may occur in the child or parent, as well."
NSQ_SOURCE_LINE 00000706 "Forking in a capture block is not recommended."
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "=head3 Using threads"
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "Filehandles are global.  Mixing up I/O and captures in different threads"
NSQ_SOURCE_LINE 00000711 "without coordination is going to cause problems.  Besides, threads are"
NSQ_SOURCE_LINE 00000712 "officially discouraged."
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "=head3 Dropping privileges during a capture"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "If you drop privileges during a capture, temporary files created to"
NSQ_SOURCE_LINE 00000717 "facilitate the capture may not be cleaned up afterwards."
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "=head2 No support for Perl 5.8.0"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "It's just too buggy when it comes to layers and UTF-8.  Perl 5.8.1 or later"
NSQ_SOURCE_LINE 00000722 "is recommended."
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "=head2 Limited support for Perl 5.6"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "Perl 5.6 predates PerlIO.  UTF-8 data may not be captured correctly."
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "=head2 PERL_CAPTURE_TINY_TIMEOUT"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "Capture::Tiny uses subprocesses internally for C<tee>.  By default,"
NSQ_SOURCE_LINE 00000733 "Capture::Tiny will timeout with an error if such subprocesses are not ready to"
NSQ_SOURCE_LINE 00000734 "receive data within 30 seconds (or whatever is the value of"
NSQ_SOURCE_LINE 00000735 "C<$Capture::Tiny::TIMEOUT>).  An alternate timeout may be specified by setting"
NSQ_SOURCE_LINE 00000736 "the C<PERL_CAPTURE_TINY_TIMEOUT> environment variable.  Setting it to zero will"
NSQ_SOURCE_LINE 00000737 "disable timeouts.  B<NOTE>, this does not timeout the code reference being"
NSQ_SOURCE_LINE 00000738 "captured -- this only prevents Capture::Tiny itself from hanging your process"
NSQ_SOURCE_LINE 00000739 "waiting for its child processes to be ready to proceed."
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "This module was inspired by L<IO::CaptureOutput>, which provides"
NSQ_SOURCE_LINE 00000744 "similar functionality without the ability to tee output and with more"
NSQ_SOURCE_LINE 00000745 "complicated code and API.  L<IO::CaptureOutput> does not handle layers"
NSQ_SOURCE_LINE 00000746 "or most of the unusual cases described in the L</LIMITATIONS> section and"
NSQ_SOURCE_LINE 00000747 "I no longer recommend it."
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "There are many other CPAN modules that provide some sort of output capture,"
NSQ_SOURCE_LINE 00000750 "albeit with various limitations that make them appropriate only in particular"
NSQ_SOURCE_LINE 00000751 "circumstances.  I'm probably missing some.  The long list is provided to show"
NSQ_SOURCE_LINE 00000752 "why I felt Capture::Tiny was necessary."
NSQ_SOURCE_LINE 00000753 ""
