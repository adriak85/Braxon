NSQ_SOURCE_LINE 00000001 "#-*- perl -*-"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "package Unicode::LineBreak;"
NSQ_SOURCE_LINE 00000004 "require 5.008;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "### Pragmas:"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 "use vars qw($VERSION @EXPORT_OK @ISA $Config @Config);"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "### Exporting:"
NSQ_SOURCE_LINE 00000012 "use Exporter;"
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw(UNICODE_VERSION SOMBOK_VERSION context);"
NSQ_SOURCE_LINE 00000014 "our %EXPORT_TAGS = ('all' => [@EXPORT_OK]);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "### Inheritance:"
NSQ_SOURCE_LINE 00000017 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "### Other modules:"
NSQ_SOURCE_LINE 00000020 "use Carp qw(croak carp);"
NSQ_SOURCE_LINE 00000021 "use Encode qw(is_utf8);"
NSQ_SOURCE_LINE 00000022 "use MIME::Charset;"
NSQ_SOURCE_LINE 00000023 "use Unicode::GCString;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "### Globals"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "### The package version"
NSQ_SOURCE_LINE 00000028 "our $VERSION = '2019.001';"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "### Public Configuration Attributes"
NSQ_SOURCE_LINE 00000031 "our @Config = ("
NSQ_SOURCE_LINE 00000032 "    BreakIndent => 'YES',"
NSQ_SOURCE_LINE 00000033 "    CharMax => 998,"
NSQ_SOURCE_LINE 00000034 "    ColMax => 76,"
NSQ_SOURCE_LINE 00000035 "    ColMin => 0,"
NSQ_SOURCE_LINE 00000036 "    ComplexBreaking => 'YES',"
NSQ_SOURCE_LINE 00000037 "    Context => 'NONEASTASIAN',"
NSQ_SOURCE_LINE 00000038 "    EAWidth => undef,"
NSQ_SOURCE_LINE 00000039 "    Format => 'SIMPLE',"
NSQ_SOURCE_LINE 00000040 "    HangulAsAL => 'NO',"
NSQ_SOURCE_LINE 00000041 "    LBClass => undef,"
NSQ_SOURCE_LINE 00000042 "    LegacyCM => 'YES',"
NSQ_SOURCE_LINE 00000043 "    Newline => \"\\n\","
NSQ_SOURCE_LINE 00000044 "    Prep => undef,"
NSQ_SOURCE_LINE 00000045 "    Sizing => 'UAX11',"
NSQ_SOURCE_LINE 00000046 "    Urgent => undef,"
NSQ_SOURCE_LINE 00000047 "    ViramaAsJoiner => 'YES',"
NSQ_SOURCE_LINE 00000048 ");"
NSQ_SOURCE_LINE 00000049 "our $Config = {};"
NSQ_SOURCE_LINE 00000050 "eval { require Unicode::LineBreak::Defaults; };"
NSQ_SOURCE_LINE 00000051 "push @Config, (%$Config);"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "### Exportable constants"
NSQ_SOURCE_LINE 00000054 "use Unicode::LineBreak::Constants;"
NSQ_SOURCE_LINE 00000055 "use constant 1.01;"
NSQ_SOURCE_LINE 00000056 "my $package = __PACKAGE__;"
NSQ_SOURCE_LINE 00000057 "my @consts = grep { s/^${package}::(\\w\\w+)$/$1/ } keys %constant::declared;"
NSQ_SOURCE_LINE 00000058 "push @EXPORT_OK, @consts;"
NSQ_SOURCE_LINE 00000059 "push @{$EXPORT_TAGS{'all'}}, @consts;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "### Load XS module"
NSQ_SOURCE_LINE 00000062 "require XSLoader;"
NSQ_SOURCE_LINE 00000063 "XSLoader::load('Unicode::LineBreak', $VERSION);"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "### Load dynamic constants"
NSQ_SOURCE_LINE 00000066 "foreach my $p ((['EA', EAWidths()], ['LB', LBClasses()])) {"
NSQ_SOURCE_LINE 00000067 "    my $prop = shift @{$p};"
NSQ_SOURCE_LINE 00000068 "    my $idx = 0;"
NSQ_SOURCE_LINE 00000069 "    foreach my $val (@{$p}) {"
NSQ_SOURCE_LINE 00000070 "        no strict;"
NSQ_SOURCE_LINE 00000071 "        my $const = \"${prop}_${val}\";"
NSQ_SOURCE_LINE 00000072 "        *{$const} = eval \"sub { $idx }\";"
NSQ_SOURCE_LINE 00000073 "        push @EXPORT_OK, $const;"
NSQ_SOURCE_LINE 00000074 "        push @{$EXPORT_TAGS{'all'}}, $const;"
NSQ_SOURCE_LINE 00000075 "        $idx++;"
NSQ_SOURCE_LINE 00000076 "    }"
NSQ_SOURCE_LINE 00000077 "}"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "### Privates"
NSQ_SOURCE_LINE 00000080 "my $EASTASIAN_CHARSETS = qr{"
NSQ_SOURCE_LINE 00000081 "    ^BIG5 |"
NSQ_SOURCE_LINE 00000082 "    ^CP9\\d\\d |"
NSQ_SOURCE_LINE 00000083 "    ^EUC- |"
NSQ_SOURCE_LINE 00000084 "    ^GB18030 | ^GB2312 | ^GBK |"
NSQ_SOURCE_LINE 00000085 "    ^HZ |"
NSQ_SOURCE_LINE 00000086 "    ^ISO-2022- |"
NSQ_SOURCE_LINE 00000087 "    ^KS_C_5601 |"
NSQ_SOURCE_LINE 00000088 "    ^SHIFT_JIS"
NSQ_SOURCE_LINE 00000089 "}ix;"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "my $EASTASIAN_LANGUAGES = qr{"
NSQ_SOURCE_LINE 00000092 "    ^AIN |"
NSQ_SOURCE_LINE 00000093 "    ^JA\\b | ^JPN |"
NSQ_SOURCE_LINE 00000094 "    ^KO\\b | ^KOR |"
NSQ_SOURCE_LINE 00000095 "    ^ZH\\b | ^CHI"
NSQ_SOURCE_LINE 00000096 "}ix;"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "use overload"
NSQ_SOURCE_LINE 00000099 "    '%{}' => \\&as_hashref,"
NSQ_SOURCE_LINE 00000100 "    '${}' => \\&as_scalarref,"
NSQ_SOURCE_LINE 00000101 "    '\"\"' => \\&as_string,"
NSQ_SOURCE_LINE 00000102 "    ;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub new {"
NSQ_SOURCE_LINE 00000105 "    my $class = shift;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "    my $self = __PACKAGE__->_new();"
NSQ_SOURCE_LINE 00000108 "    $self->config(@Config);"
NSQ_SOURCE_LINE 00000109 "    $self->config(@_);"
NSQ_SOURCE_LINE 00000110 "    bless $self, $class;"
NSQ_SOURCE_LINE 00000111 "}"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "sub config ($@) {"
NSQ_SOURCE_LINE 00000114 "    my $self = shift;"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    # Get config."
NSQ_SOURCE_LINE 00000117 "    if (scalar @_ == 1) {"
NSQ_SOURCE_LINE 00000118 "        my $k = shift;"
NSQ_SOURCE_LINE 00000119 "        my $ret;"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "        if (uc $k eq uc 'CharactersMax') {"
NSQ_SOURCE_LINE 00000122 "            return $self->_config('CharMax');"
NSQ_SOURCE_LINE 00000123 "        } elsif (uc $k eq uc 'ColumnsMax') {"
NSQ_SOURCE_LINE 00000124 "            return $self->_config('ColMax');"
NSQ_SOURCE_LINE 00000125 "        } elsif (uc $k eq uc 'ColumnsMin') {"
NSQ_SOURCE_LINE 00000126 "            return $self->_config('ColMin');"
NSQ_SOURCE_LINE 00000127 "        } elsif (uc $k eq uc 'SizingMethod') {"
NSQ_SOURCE_LINE 00000128 "            return $self->_config('Sizing');"
NSQ_SOURCE_LINE 00000129 "        } elsif (uc $k eq uc 'TailorEA') {"
NSQ_SOURCE_LINE 00000130 "            carp \"$k is obsoleted.  Use EAWidth\";"
NSQ_SOURCE_LINE 00000131 "            $ret = $self->_config('EAWidth');"
NSQ_SOURCE_LINE 00000132 "            if (! defined $ret) {"
NSQ_SOURCE_LINE 00000133 "                return [];"
NSQ_SOURCE_LINE 00000134 "            } else {"
NSQ_SOURCE_LINE 00000135 "                return [map { ($_->[0] => $_->[1]) } @{$ret}];"
NSQ_SOURCE_LINE 00000136 "            }"
NSQ_SOURCE_LINE 00000137 "        } elsif (uc $k eq uc 'TailorLB') {"
NSQ_SOURCE_LINE 00000138 "            carp \"$k is obsoleted.  Use LBClass\";"
NSQ_SOURCE_LINE 00000139 "            $ret = $self->_config('LBClass');"
NSQ_SOURCE_LINE 00000140 "            if (! defined $ret) {"
NSQ_SOURCE_LINE 00000141 "                return [];"
NSQ_SOURCE_LINE 00000142 "            } else {"
NSQ_SOURCE_LINE 00000143 "                return [map { ($_->[0] => $_->[1]) } @{$ret}];"
NSQ_SOURCE_LINE 00000144 "            }"
NSQ_SOURCE_LINE 00000145 "        } elsif (uc $k eq uc 'UrgentBreaking') {"
NSQ_SOURCE_LINE 00000146 "            return $self->_config('Urgent');"
NSQ_SOURCE_LINE 00000147 "        } elsif (uc $k eq uc 'UserBreaking') {"
NSQ_SOURCE_LINE 00000148 "            carp \"$k is obsoleted.  Use Prep\";"
NSQ_SOURCE_LINE 00000149 "            $ret = $self->_config('Prep');"
NSQ_SOURCE_LINE 00000150 "            if (! defined $ret) {"
NSQ_SOURCE_LINE 00000151 "                return [];"
NSQ_SOURCE_LINE 00000152 "            } else {"
NSQ_SOURCE_LINE 00000153 "                return $ret;"
NSQ_SOURCE_LINE 00000154 "            }"
NSQ_SOURCE_LINE 00000155 "        } else {"
NSQ_SOURCE_LINE 00000156 "            return $self->_config($k);"
NSQ_SOURCE_LINE 00000157 "        }"
NSQ_SOURCE_LINE 00000158 "    }"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "    # Set config."
NSQ_SOURCE_LINE 00000161 "    my @config = ();"
NSQ_SOURCE_LINE 00000162 "    while (0 < scalar @_) {"
NSQ_SOURCE_LINE 00000163 "        my $k = shift;"
NSQ_SOURCE_LINE 00000164 "        my $v = shift;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "        if (uc $k eq uc 'CharactersMax') {"
NSQ_SOURCE_LINE 00000167 "            push @config, 'CharMax' => $v;"
NSQ_SOURCE_LINE 00000168 "        } elsif (uc $k eq uc 'ColumnsMax') {"
NSQ_SOURCE_LINE 00000169 "            push @config, 'ColMax' => $v;"
NSQ_SOURCE_LINE 00000170 "        } elsif (uc $k eq uc 'ColumnsMin') {"
NSQ_SOURCE_LINE 00000171 "            push @config, 'ColMin' => $v;"
NSQ_SOURCE_LINE 00000172 "        } elsif (uc $k eq uc 'SizingMethod') {"
NSQ_SOURCE_LINE 00000173 "            push @config, 'Sizing' => $v;"
NSQ_SOURCE_LINE 00000174 "        } elsif (uc $k eq uc 'TailorLB') {"
NSQ_SOURCE_LINE 00000175 "            carp \"$k is obsoleted.  Use LBClass\";"
NSQ_SOURCE_LINE 00000176 "            push @config, 'LBClass' => undef;"
NSQ_SOURCE_LINE 00000177 "            if (! defined $v) {"
NSQ_SOURCE_LINE 00000178 "                ;"
NSQ_SOURCE_LINE 00000179 "            } else {"
NSQ_SOURCE_LINE 00000180 "                my @v = @{$v};"
NSQ_SOURCE_LINE 00000181 "                while (scalar(@v)) {"
NSQ_SOURCE_LINE 00000182 "                    my $k = shift @v;"
NSQ_SOURCE_LINE 00000183 "                    my $v = shift @v;"
NSQ_SOURCE_LINE 00000184 "                    push @config, 'LBClass' => [ $k => $v ];"
NSQ_SOURCE_LINE 00000185 "                }"
NSQ_SOURCE_LINE 00000186 "            }"
NSQ_SOURCE_LINE 00000187 "        } elsif (uc $k eq uc 'TailorEA') {"
NSQ_SOURCE_LINE 00000188 "            carp \"$k is obsoleted.  Use EAWidth\";"
NSQ_SOURCE_LINE 00000189 "            push @config, 'EAWidth' => undef;"
NSQ_SOURCE_LINE 00000190 "            if (! defined $v) {"
NSQ_SOURCE_LINE 00000191 "                ;"
NSQ_SOURCE_LINE 00000192 "            } else {"
NSQ_SOURCE_LINE 00000193 "                my @v = @{$v};"
NSQ_SOURCE_LINE 00000194 "                while (scalar(@v)) {"
NSQ_SOURCE_LINE 00000195 "                    my $k = shift @v;"
NSQ_SOURCE_LINE 00000196 "                    my $v = shift @v;"
NSQ_SOURCE_LINE 00000197 "                    push @config, 'EAWidth' => [ $k => $v ];"
NSQ_SOURCE_LINE 00000198 "                }"
NSQ_SOURCE_LINE 00000199 "            }"
NSQ_SOURCE_LINE 00000200 "        } elsif (uc $k eq uc 'UserBreaking') {"
NSQ_SOURCE_LINE 00000201 "            carp \"$k is obsoleted.  Use Prep\";"
NSQ_SOURCE_LINE 00000202 "            push @config, 'Prep' => undef;"
NSQ_SOURCE_LINE 00000203 "            if (! defined $v) {"
NSQ_SOURCE_LINE 00000204 "                ;"
NSQ_SOURCE_LINE 00000205 "            } elsif (ref $v eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000206 "                push @config, map { ('Prep' => $_) } @{$v};"
NSQ_SOURCE_LINE 00000207 "            } else {"
NSQ_SOURCE_LINE 00000208 "                push @config, 'Prep' => $v;"
NSQ_SOURCE_LINE 00000209 "            }"
NSQ_SOURCE_LINE 00000210 "        } elsif (uc $k eq uc 'UrgentBreaking') {"
NSQ_SOURCE_LINE 00000211 "            push @config, 'Urgent' => $v;"
NSQ_SOURCE_LINE 00000212 "        } else {"
NSQ_SOURCE_LINE 00000213 "            push @config, $k => $v;"
NSQ_SOURCE_LINE 00000214 "        }"
NSQ_SOURCE_LINE 00000215 "    }"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "    $self->_config(@config) if scalar @config;"
NSQ_SOURCE_LINE 00000218 "}"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "sub context (@) {"
NSQ_SOURCE_LINE 00000221 "    my %opts = @_;"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "    my $charset;"
NSQ_SOURCE_LINE 00000224 "    my $language;"
NSQ_SOURCE_LINE 00000225 "    my $context;"
NSQ_SOURCE_LINE 00000226 "    foreach my $k (keys %opts) {"
NSQ_SOURCE_LINE 00000227 "        if (uc $k eq 'CHARSET') {"
NSQ_SOURCE_LINE 00000228 "            if (ref $opts{$k}) {"
NSQ_SOURCE_LINE 00000229 "                $charset = $opts{$k}->as_string;"
NSQ_SOURCE_LINE 00000230 "            } else {"
NSQ_SOURCE_LINE 00000231 "                $charset = MIME::Charset->new($opts{$k})->as_string;"
NSQ_SOURCE_LINE 00000232 "            }"
NSQ_SOURCE_LINE 00000233 "        } elsif (uc $k eq 'LANGUAGE') {"
NSQ_SOURCE_LINE 00000234 "            $language = uc $opts{$k};"
NSQ_SOURCE_LINE 00000235 "            $language =~ s/_/-/;"
NSQ_SOURCE_LINE 00000236 "        }"
NSQ_SOURCE_LINE 00000237 "    }"
NSQ_SOURCE_LINE 00000238 "    if ($charset and $charset =~ /$EASTASIAN_CHARSETS/) {"
NSQ_SOURCE_LINE 00000239 "        $context = 'EASTASIAN';"
NSQ_SOURCE_LINE 00000240 "    } elsif ($language and $language =~ /$EASTASIAN_LANGUAGES/) {"
NSQ_SOURCE_LINE 00000241 "        $context = 'EASTASIAN';"
NSQ_SOURCE_LINE 00000242 "    } else {"
NSQ_SOURCE_LINE 00000243 "        $context = 'NONEASTASIAN';"
NSQ_SOURCE_LINE 00000244 "    }"
NSQ_SOURCE_LINE 00000245 "    $context;"
NSQ_SOURCE_LINE 00000246 "}"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "1;"
BODY_END
