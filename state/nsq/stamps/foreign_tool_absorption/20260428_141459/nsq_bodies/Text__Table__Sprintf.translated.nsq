NSQ_SOURCE_LINE 00000370 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=head2 table"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "Usage:"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 " my $table_str = Text::Table::Sprintf::table(%params);"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "The C<table> function understands these arguments, which are passed as a hash."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=over"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=item * rows"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "Aoaos. Required. Takes an array reference which should contain one or more rows"
NSQ_SOURCE_LINE 00000385 "of data, where each row is an array reference."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "=item * header_row"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "Bool. Optional. Defaults to false. If given a true value, the first row in the"
NSQ_SOURCE_LINE 00000390 "data will be interpreted as a header row, and separated from the rest of the"
NSQ_SOURCE_LINE 00000391 "table with a ruled line."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "=item * separate_rows"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "Bool. Optional. Defaults to false. If set to true, will draw separator line"
NSQ_SOURCE_LINE 00000396 "between data rows."
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "=item * align"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "Str or array of str. Optional. Declare alignment for all columns or for"
NSQ_SOURCE_LINE 00000401 "individul columns. Valid alignment value is 'l' (for left) or 'r' (for right),"
NSQ_SOURCE_LINE 00000402 "center alignment is currently not supported. Default alignment is left."
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "=back"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "=head2 generate_table"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "Alias for L</table>, for compatibility with L<Text::Table::Tiny>."
NSQ_SOURCE_LINE 00000409 ""
