NSQ_SOURCE_LINE 00000001 "# we strive for minimality"
NSQ_SOURCE_LINE 00000002 "## no critic: TestingAndDebugging::RequireUseStrict"
NSQ_SOURCE_LINE 00000003 "package Text::Table::Sprintf;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "#IFUNBUILT"
NSQ_SOURCE_LINE 00000006 "# # use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000007 "# # use warnings;"
NSQ_SOURCE_LINE 00000008 "#END IFUNBUILT"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000011 "our $DATE = '2023-11-11'; # DATE"
NSQ_SOURCE_LINE 00000012 "our $DIST = 'Text-Table-Sprintf'; # DIST"
NSQ_SOURCE_LINE 00000013 "our $VERSION = '0.008'; # VERSION"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our %FEATURES = ("
NSQ_SOURCE_LINE 00000016 "    set_v => {"
NSQ_SOURCE_LINE 00000017 "        TextTable => 1,"
NSQ_SOURCE_LINE 00000018 "    },"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    features => {"
NSQ_SOURCE_LINE 00000021 "        TextTable => {"
NSQ_SOURCE_LINE 00000022 "            can_align_cell_containing_wide_character => 0,"
NSQ_SOURCE_LINE 00000023 "            can_align_cell_containing_color_code     => 0,"
NSQ_SOURCE_LINE 00000024 "            can_align_cell_containing_newline        => 0,"
NSQ_SOURCE_LINE 00000025 "            can_use_box_character                    => 0,"
NSQ_SOURCE_LINE 00000026 "            can_customize_border                     => 0,"
NSQ_SOURCE_LINE 00000027 "            can_halign                               => {"
NSQ_SOURCE_LINE 00000028 "                value => 1,"
NSQ_SOURCE_LINE 00000029 "                summary => 'Only support l (left) and r (right) alignment, not c (center)',"
NSQ_SOURCE_LINE 00000030 "            },"
NSQ_SOURCE_LINE 00000031 "            can_halign_individual_row                => 0,"
NSQ_SOURCE_LINE 00000032 "            can_halign_individual_column             => 0,"
NSQ_SOURCE_LINE 00000033 "            can_halign_individual_cell               => 0,"
NSQ_SOURCE_LINE 00000034 "            can_valign                               => 0,"
NSQ_SOURCE_LINE 00000035 "            can_valign_individual_row                => 0,"
NSQ_SOURCE_LINE 00000036 "            can_valign_individual_column             => 0,"
NSQ_SOURCE_LINE 00000037 "            can_valign_individual_cell               => 0,"
NSQ_SOURCE_LINE 00000038 "            can_rowspan                              => 0,"
NSQ_SOURCE_LINE 00000039 "            can_colspan                              => 0,"
NSQ_SOURCE_LINE 00000040 "            can_color                                => 0,"
NSQ_SOURCE_LINE 00000041 "            can_color_theme                          => 0,"
NSQ_SOURCE_LINE 00000042 "            can_set_cell_height                      => 0,"
NSQ_SOURCE_LINE 00000043 "            can_set_cell_height_of_individual_row    => 0,"
NSQ_SOURCE_LINE 00000044 "            can_set_cell_width                       => 0,"
NSQ_SOURCE_LINE 00000045 "            can_set_cell_width_of_individual_column  => 0,"
NSQ_SOURCE_LINE 00000046 "            speed                                    => 'fast',"
NSQ_SOURCE_LINE 00000047 "            can_hpad                                 => 0,"
NSQ_SOURCE_LINE 00000048 "            can_hpad_individual_row                  => 0,"
NSQ_SOURCE_LINE 00000049 "            can_hpad_individual_column               => 0,"
NSQ_SOURCE_LINE 00000050 "            can_hpad_individual_cell                 => 0,"
NSQ_SOURCE_LINE 00000051 "            can_vpad                                 => 0,"
NSQ_SOURCE_LINE 00000052 "            can_vpad_individual_row                  => 0,"
NSQ_SOURCE_LINE 00000053 "            can_vpad_individual_column               => 0,"
NSQ_SOURCE_LINE 00000054 "            can_vpad_individual_cell                 => 0,"
NSQ_SOURCE_LINE 00000055 "        },"
NSQ_SOURCE_LINE 00000056 "    },"
NSQ_SOURCE_LINE 00000057 ");"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "sub table {"
NSQ_SOURCE_LINE 00000060 "    my %params = @_;"
NSQ_SOURCE_LINE 00000061 "    my $rows = $params{rows} or die \"Must provide rows!\";"
NSQ_SOURCE_LINE 00000062 "    # XXX check that all rows contain the same number of columns"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    return \"\" unless @$rows;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    # determine the width of each column"
NSQ_SOURCE_LINE 00000067 "    my @widths;"
NSQ_SOURCE_LINE 00000068 "    for my $row (@$rows) {"
NSQ_SOURCE_LINE 00000069 "        for (0..$#{$row}) {"
NSQ_SOURCE_LINE 00000070 "            my $len = length $row->[$_];"
NSQ_SOURCE_LINE 00000071 "            $widths[$_] = $len if !defined $widths[$_] || $widths[$_] < $len;"
NSQ_SOURCE_LINE 00000072 "        }"
NSQ_SOURCE_LINE 00000073 "    }"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    # determine the alignment of each column"
NSQ_SOURCE_LINE 00000076 "    my @aligns = @$rows ? (map {'l'} @{$rows->[0]}) : ();"
NSQ_SOURCE_LINE 00000077 "    if ($params{align}) {"
NSQ_SOURCE_LINE 00000078 "        if (ref $params{align} eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000079 "            @aligns = @{ $params{align} }"
NSQ_SOURCE_LINE 00000080 "        } else {"
NSQ_SOURCE_LINE 00000081 "            $_ = $params{align} for @aligns;"
NSQ_SOURCE_LINE 00000082 "        }"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    # determine the sprintf format for a single row"
NSQ_SOURCE_LINE 00000086 "    my $rowfmt = join("
NSQ_SOURCE_LINE 00000087 "        \"\","
NSQ_SOURCE_LINE 00000088 "        (map { ($_ ? \"\" : \"|\") . \" %\".($aligns[$_] eq 'r' ? '':'-').\"$widths[$_]s |\" } 0..$#widths),"
NSQ_SOURCE_LINE 00000089 "        \"\\n\");"
NSQ_SOURCE_LINE 00000090 "    my $line = join("
NSQ_SOURCE_LINE 00000091 "        \"\","
NSQ_SOURCE_LINE 00000092 "        (map { ($_ ? \"\" : \"+\") . (\"-\" x ($widths[$_]+2)) . \"+\" } 0..$#widths),"
NSQ_SOURCE_LINE 00000093 "        \"\\n\");"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    # determine the sprintf format for the whole table"
NSQ_SOURCE_LINE 00000096 "    my $tblfmt;"
NSQ_SOURCE_LINE 00000097 "    if ($params{header_row}) {"
NSQ_SOURCE_LINE 00000098 "        $tblfmt = join("
NSQ_SOURCE_LINE 00000099 "            \"\","
NSQ_SOURCE_LINE 00000100 "            $line,"
NSQ_SOURCE_LINE 00000101 "            $rowfmt,"
NSQ_SOURCE_LINE 00000102 "            $line,"
NSQ_SOURCE_LINE 00000103 "            (map { $rowfmt . ($params{separate_rows} && $_ < $#{$rows} ? $line : '') } 1..@$rows-1),"
NSQ_SOURCE_LINE 00000104 "            $line,"
NSQ_SOURCE_LINE 00000105 "        );"
NSQ_SOURCE_LINE 00000106 "    } else {"
NSQ_SOURCE_LINE 00000107 "        $tblfmt = join("
NSQ_SOURCE_LINE 00000108 "            \"\","
NSQ_SOURCE_LINE 00000109 "            $line,"
NSQ_SOURCE_LINE 00000110 "            (map { $rowfmt . ($params{separate_rows} && $_ < $#{$rows} ? $line : '') } 1..@$rows),"
NSQ_SOURCE_LINE 00000111 "            $line,"
NSQ_SOURCE_LINE 00000112 "        );"
NSQ_SOURCE_LINE 00000113 "    }"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    # generate table"
NSQ_SOURCE_LINE 00000116 "    sprintf $tblfmt, map { @$_ } @$rows;"
NSQ_SOURCE_LINE 00000117 "}"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "{"
NSQ_SOURCE_LINE 00000120 "#IFUNBUILT"
NSQ_SOURCE_LINE 00000121 "# #     no warnings 'once';"
NSQ_SOURCE_LINE 00000122 "#END IFUNBUILT"
NSQ_SOURCE_LINE 00000123 "    *generate_table = \\&table;"
NSQ_SOURCE_LINE 00000124 "}"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "1;"
NSQ_SOURCE_LINE 00000127 "# ABSTRACT: Generate simple text tables from 2D arrays using sprintf()"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "__END__"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=pod"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=head1 NAME"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "Text::Table::Sprintf - Generate simple text tables from 2D arrays using sprintf()"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 VERSION"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "This document describes version 0.008 of Text::Table::Sprintf (from Perl distribution Text-Table-Sprintf), released on 2023-11-11."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 " use Text::Table::Sprintf;"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 " my $rows = ["
NSQ_SOURCE_LINE 00000148 "     # header row"
NSQ_SOURCE_LINE 00000149 "     ['Name', 'Rank', 'Serial'],"
NSQ_SOURCE_LINE 00000150 "     # rows"
NSQ_SOURCE_LINE 00000151 "     ['alice', 'pvt', '123456'],"
NSQ_SOURCE_LINE 00000152 "     ['bob',   'cpl', '98765321'],"
NSQ_SOURCE_LINE 00000153 "     ['carol', 'brig gen', '8745'],"
NSQ_SOURCE_LINE 00000154 " ];"
NSQ_SOURCE_LINE 00000155 " print Text::Table::Sprintf::table(rows => $rows, header_row => 1);"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "This module provides a single function, C<table>, which formats a"
NSQ_SOURCE_LINE 00000160 "two-dimensional array of data as a simple text table."
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "The example shown in the SYNOPSIS generates the following table:"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 " +-------+----------+----------+"
NSQ_SOURCE_LINE 00000165 " | Name  | Rank     | Serial   |"
NSQ_SOURCE_LINE 00000166 " +-------+----------+----------+"
NSQ_SOURCE_LINE 00000167 " | alice | pvt      | 123456   |"
NSQ_SOURCE_LINE 00000168 " | bob   | cpl      | 98765321 |"
NSQ_SOURCE_LINE 00000169 " | carol | brig gen | 8745     |"
NSQ_SOURCE_LINE 00000170 " +-------+----------+----------+"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "This module models its interface on L<Text::Table::Tiny> 0.03, employs the same"
NSQ_SOURCE_LINE 00000173 "technique of using C<sprintf()>, but takes the technique further by using a"
NSQ_SOURCE_LINE 00000174 "single large format and C<sprintf> the whole table. This results in even more"
NSQ_SOURCE_LINE 00000175 "performance gain (see benchmark result or benchmark using"
NSQ_SOURCE_LINE 00000176 "L<Acme::CPANModules::TextTable>)."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "Caveats: make sure each row contains the same number of elements. Otherwise, the"
NSQ_SOURCE_LINE 00000179 "table will not be correctly formatted (cells might move to another row/column)."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=for Pod::Coverage ^(max)$"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=head1 DECLARED FEATURES"
