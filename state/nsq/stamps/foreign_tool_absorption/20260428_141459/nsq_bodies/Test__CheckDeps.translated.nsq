BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Test::CheckDeps;"
NSQ_SOURCE_LINE 00000002 "{"
NSQ_SOURCE_LINE 00000003 "  $Test::CheckDeps::VERSION = '0.010';"
NSQ_SOURCE_LINE 00000004 "}"
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings FATAL => 'all';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Exporter 5.57 'import';"
NSQ_SOURCE_LINE 00000009 "our @EXPORT = qw/check_dependencies/;"
NSQ_SOURCE_LINE 00000010 "our @EXPORT_OK = qw/check_dependencies_opts/;"
NSQ_SOURCE_LINE 00000011 "our %EXPORT_TAGS = (all => [ @EXPORT, @EXPORT_OK ] );"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use CPAN::Meta 2.120920;"
NSQ_SOURCE_LINE 00000014 "use CPAN::Meta::Check 0.007 qw/check_requirements requirements_for/;"
NSQ_SOURCE_LINE 00000015 "use List::Util qw/first/;"
NSQ_SOURCE_LINE 00000016 "use Test::Builder;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "my $builder = Test::Builder->new;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "my %level_of = ("
NSQ_SOURCE_LINE 00000021 "\trequires   => 0,"
NSQ_SOURCE_LINE 00000022 "\tclassic    => 1,"
NSQ_SOURCE_LINE 00000023 "\trecommends => 2,"
NSQ_SOURCE_LINE 00000024 "\tsuggests   => 3,"
NSQ_SOURCE_LINE 00000025 ");"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "sub check_dependencies {"
NSQ_SOURCE_LINE 00000028 "\tmy $level = $level_of{shift || 'classic'};"
NSQ_SOURCE_LINE 00000029 "\tlocal $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000030 "\tmy $metafile = first { -e $_ } qw/MYMETA.json MYMETA.yml META.json META.yml/ or return $builder->ok(0, \"No META information provided\\n\");"
NSQ_SOURCE_LINE 00000031 "\tmy $meta = CPAN::Meta->load_file($metafile);"
NSQ_SOURCE_LINE 00000032 "\tcheck_dependencies_opts($meta, $_, 'requires') for qw/configure build test runtime/;"
NSQ_SOURCE_LINE 00000033 "\tcheck_dependencies_opts($meta, 'runtime', 'conflicts') if $level >= $level_of{classic};"
NSQ_SOURCE_LINE 00000034 "\tif ($level >= $level_of{recommends}) {"
NSQ_SOURCE_LINE 00000035 "\t\t$builder->todo_start('recommends are not mandatory');"
NSQ_SOURCE_LINE 00000036 "\t\tcheck_dependencies_opts($meta, $_, 'recommends') for qw/configure build test runtime/;"
NSQ_SOURCE_LINE 00000037 "\t\t$builder->todo_end();"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "\t\tif ($level >= $level_of{suggests}) {"
NSQ_SOURCE_LINE 00000040 "\t\t\t$builder->todo_start('suggests are not mandatory');"
NSQ_SOURCE_LINE 00000041 "\t\t\tcheck_dependencies_opts($meta, $_, 'suggests') for qw/configure build test runtime/;"
NSQ_SOURCE_LINE 00000042 "\t\t\t$builder->todo_end();"
NSQ_SOURCE_LINE 00000043 "\t\t}"
NSQ_SOURCE_LINE 00000044 "\t}"
NSQ_SOURCE_LINE 00000045 "\tcheck_dependencies_opts($meta, 'develop', 'requires') if $ENV{AUTHOR_TESTING};"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "\treturn;"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "sub check_dependencies_opts {"
NSQ_SOURCE_LINE 00000051 "\tmy ($meta, $phases, $type) = @_;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "\tmy $reqs = requirements_for($meta, $phases, $type);"
NSQ_SOURCE_LINE 00000054 "\tmy $raw = $reqs->as_string_hash;"
NSQ_SOURCE_LINE 00000055 "\tmy $ret = check_requirements($reqs, $type);"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "\tlocal $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000058 "\tfor my $module (sort keys %{$ret}) {"
NSQ_SOURCE_LINE 00000059 "\t\t$builder->ok(!defined $ret->{$module}, \"$module satisfies '\" . $raw->{$module} . \"'\")"
NSQ_SOURCE_LINE 00000060 "\t\t\tor $builder->diag($ret->{$module});"
NSQ_SOURCE_LINE 00000061 "\t\t\t# Note: when in a TODO, diag behaves like note"
NSQ_SOURCE_LINE 00000062 "\t}"
NSQ_SOURCE_LINE 00000063 "\treturn;"
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "1;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "#ABSTRACT: Check for presence of dependencies"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "# vim: set ts=2 sw=2 noet nolist :"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "__END__"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=pod"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=head1 NAME"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "Test::CheckDeps - Check for presence of dependencies"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head1 VERSION"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "version 0.010"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 " use Test::More 0.94;"
NSQ_SOURCE_LINE 00000087 " use Test::CheckDeps 0.007;"
NSQ_SOURCE_LINE 00000088 " "
NSQ_SOURCE_LINE 00000089 " check_dependencies();"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 " done_testing();"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "This module adds a test that assures all dependencies have been installed properly. If requested, it can bail out all testing on error."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=head2 check_dependencies( [ level ])"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "Check dependencies based on a local MYMETA or META file."
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "The C<level> argument is optional. It can be one of:"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=over 4"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=item * requires"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "All 'requires' dependencies are checked (the configure, build, test and"
NSQ_SOURCE_LINE 00000110 "runtime phases are always checked, and the develop phase is also tested when"
NSQ_SOURCE_LINE 00000111 "AUTHOR_TESTING is set)"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=item * classic"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "As C<requires>, but 'conflicts' dependencies are also checked."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=item * recommends"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "As C<classic>, but 'recommends' dependencies are also checked, as TODO tests."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=item * suggests"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "As C<recommends>, but 'suggests' dependencies are also checked, as TODO tests."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=back"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "When not provided, C<level> defaults to C<classic> ('requires' and 'conflicts'"
NSQ_SOURCE_LINE 00000128 "dependencies are checked)."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=head2 check_dependencies_opts($meta, $phase, $type)"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "Check dependencies in L<CPAN::Meta> object $meta for phase C<$phase> (configure, build, test, runtime, develop) and type C<$type>(requires, recommends, suggests, conflicts). You probably just want to use C<check_dependencies> though."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "Leon Timmermans <leont@cpan.org>"
