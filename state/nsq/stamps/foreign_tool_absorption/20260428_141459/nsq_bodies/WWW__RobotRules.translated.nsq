NSQ_SOURCE_LINE 00000001 "package WWW::RobotRules;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "$VERSION = \"6.02\";"
NSQ_SOURCE_LINE 00000004 "sub Version { $VERSION; }"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use URI ();"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "sub new {"
NSQ_SOURCE_LINE 00000012 "    my($class, $ua) = @_;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "    # This ugly hack is needed to ensure backwards compatibility."
NSQ_SOURCE_LINE 00000015 "    # The \"WWW::RobotRules\" class is now really abstract."
NSQ_SOURCE_LINE 00000016 "    $class = \"WWW::RobotRules::InCore\" if $class eq \"WWW::RobotRules\";"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "    my $self = bless { }, $class;"
NSQ_SOURCE_LINE 00000019 "    $self->agent($ua);"
NSQ_SOURCE_LINE 00000020 "    $self;"
NSQ_SOURCE_LINE 00000021 "}"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "sub parse {"
NSQ_SOURCE_LINE 00000025 "    my($self, $robot_txt_uri, $txt, $fresh_until) = @_;"
NSQ_SOURCE_LINE 00000026 "    $robot_txt_uri = URI->new(\"$robot_txt_uri\");"
NSQ_SOURCE_LINE 00000027 "    my $netloc = $robot_txt_uri->host . \":\" . $robot_txt_uri->port;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    $self->clear_rules($netloc);"
NSQ_SOURCE_LINE 00000030 "    $self->fresh_until($netloc, $fresh_until || (time + 365*24*3600));"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    my $ua;"
NSQ_SOURCE_LINE 00000033 "    my $is_me = 0;\t\t# 1 iff this record is for me"
NSQ_SOURCE_LINE 00000034 "    my $is_anon = 0;\t\t# 1 iff this record is for *"
NSQ_SOURCE_LINE 00000035 "    my $seen_disallow = 0;      # watch for missing record separators"
NSQ_SOURCE_LINE 00000036 "    my @me_disallowed = ();\t# rules disallowed for me"
NSQ_SOURCE_LINE 00000037 "    my @anon_disallowed = ();\t# rules disallowed for *"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    # blank lines are significant, so turn CRLF into LF to avoid generating"
NSQ_SOURCE_LINE 00000040 "    # false ones"
NSQ_SOURCE_LINE 00000041 "    $txt =~ s/\\015\\012/\\012/g;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    # split at \\012 (LF) or \\015 (CR) (Mac text files have just CR for EOL)"
NSQ_SOURCE_LINE 00000044 "    for(split(/[\\012\\015]/, $txt)) {"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "\t# Lines containing only a comment are discarded completely, and"
NSQ_SOURCE_LINE 00000047 "        # therefore do not indicate a record boundary."
NSQ_SOURCE_LINE 00000048 "\tnext if /^\\s*\\#/;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "\ts/\\s*\\#.*//;        # remove comments at end-of-line"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "\tif (/^\\s*$/) {\t    # blank line"
NSQ_SOURCE_LINE 00000053 "\t    last if $is_me; # That was our record. No need to read the rest."
NSQ_SOURCE_LINE 00000054 "\t    $is_anon = 0;"
NSQ_SOURCE_LINE 00000055 "\t    $seen_disallow = 0;"
NSQ_SOURCE_LINE 00000056 "\t}"
NSQ_SOURCE_LINE 00000057 "        elsif (/^\\s*User-Agent\\s*:\\s*(.*)/i) {"
NSQ_SOURCE_LINE 00000058 "\t    $ua = $1;"
NSQ_SOURCE_LINE 00000059 "\t    $ua =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "\t    if ($seen_disallow) {"
NSQ_SOURCE_LINE 00000062 "\t\t# treat as start of a new record"
NSQ_SOURCE_LINE 00000063 "\t\t$seen_disallow = 0;"
NSQ_SOURCE_LINE 00000064 "\t\tlast if $is_me; # That was our record. No need to read the rest."
NSQ_SOURCE_LINE 00000065 "\t\t$is_anon = 0;"
NSQ_SOURCE_LINE 00000066 "\t    }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "\t    if ($is_me) {"
NSQ_SOURCE_LINE 00000069 "\t\t# This record already had a User-agent that"
NSQ_SOURCE_LINE 00000070 "\t\t# we matched, so just continue."
NSQ_SOURCE_LINE 00000071 "\t    }"
NSQ_SOURCE_LINE 00000072 "\t    elsif ($ua eq '*') {"
NSQ_SOURCE_LINE 00000073 "\t\t$is_anon = 1;"
NSQ_SOURCE_LINE 00000074 "\t    }"
NSQ_SOURCE_LINE 00000075 "\t    elsif($self->is_me($ua)) {"
NSQ_SOURCE_LINE 00000076 "\t\t$is_me = 1;"
NSQ_SOURCE_LINE 00000077 "\t    }"
NSQ_SOURCE_LINE 00000078 "\t}"
NSQ_SOURCE_LINE 00000079 "\telsif (/^\\s*Disallow\\s*:\\s*(.*)/i) {"
NSQ_SOURCE_LINE 00000080 "\t    unless (defined $ua) {"
NSQ_SOURCE_LINE 00000081 "\t\twarn \"RobotRules <$robot_txt_uri>: Disallow without preceding User-agent\\n\" if $^W;"
NSQ_SOURCE_LINE 00000082 "\t\t$is_anon = 1;  # assume that User-agent: * was intended"
NSQ_SOURCE_LINE 00000083 "\t    }"
NSQ_SOURCE_LINE 00000084 "\t    my $disallow = $1;"
NSQ_SOURCE_LINE 00000085 "\t    $disallow =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00000086 "\t    $seen_disallow = 1;"
NSQ_SOURCE_LINE 00000087 "\t    if (length $disallow) {"
NSQ_SOURCE_LINE 00000088 "\t\tmy $ignore;"
NSQ_SOURCE_LINE 00000089 "\t\teval {"
NSQ_SOURCE_LINE 00000090 "\t\t    my $u = URI->new_abs($disallow, $robot_txt_uri);"
NSQ_SOURCE_LINE 00000091 "\t\t    $ignore++ if $u->scheme ne $robot_txt_uri->scheme;"
NSQ_SOURCE_LINE 00000092 "\t\t    $ignore++ if lc($u->host) ne lc($robot_txt_uri->host);"
NSQ_SOURCE_LINE 00000093 "\t\t    $ignore++ if $u->port ne $robot_txt_uri->port;"
NSQ_SOURCE_LINE 00000094 "\t\t    $disallow = $u->path_query;"
NSQ_SOURCE_LINE 00000095 "\t\t    $disallow = \"/\" unless length $disallow;"
NSQ_SOURCE_LINE 00000096 "\t\t};"
NSQ_SOURCE_LINE 00000097 "\t\tnext if $@;"
NSQ_SOURCE_LINE 00000098 "\t\tnext if $ignore;"
NSQ_SOURCE_LINE 00000099 "\t    }"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "\t    if ($is_me) {"
NSQ_SOURCE_LINE 00000102 "\t\tpush(@me_disallowed, $disallow);"
NSQ_SOURCE_LINE 00000103 "\t    }"
NSQ_SOURCE_LINE 00000104 "\t    elsif ($is_anon) {"
NSQ_SOURCE_LINE 00000105 "\t\tpush(@anon_disallowed, $disallow);"
NSQ_SOURCE_LINE 00000106 "\t    }"
NSQ_SOURCE_LINE 00000107 "\t}"
NSQ_SOURCE_LINE 00000108 "        elsif (/\\S\\s*:/) {"
NSQ_SOURCE_LINE 00000109 "             # ignore"
NSQ_SOURCE_LINE 00000110 "        }"
NSQ_SOURCE_LINE 00000111 "\telse {"
NSQ_SOURCE_LINE 00000112 "\t    warn \"RobotRules <$robot_txt_uri>: Malformed record: <$_>\\n\" if $^W;"
NSQ_SOURCE_LINE 00000113 "\t}"
NSQ_SOURCE_LINE 00000114 "    }"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    if ($is_me) {"
NSQ_SOURCE_LINE 00000117 "\t$self->push_rules($netloc, @me_disallowed);"
NSQ_SOURCE_LINE 00000118 "    }"
NSQ_SOURCE_LINE 00000119 "    else {"
NSQ_SOURCE_LINE 00000120 "\t$self->push_rules($netloc, @anon_disallowed);"
NSQ_SOURCE_LINE 00000121 "    }"
NSQ_SOURCE_LINE 00000122 "}"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "#"
NSQ_SOURCE_LINE 00000126 "# Returns TRUE if the given name matches the"
NSQ_SOURCE_LINE 00000127 "# name of this robot"
NSQ_SOURCE_LINE 00000128 "#"
NSQ_SOURCE_LINE 00000129 "sub is_me {"
NSQ_SOURCE_LINE 00000130 "    my($self, $ua_line) = @_;"
NSQ_SOURCE_LINE 00000131 "    my $me = $self->agent;"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    # See whether my short-name is a substring of the"
NSQ_SOURCE_LINE 00000134 "    #  \"User-Agent: ...\" line that we were passed:"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    if(index(lc($me), lc($ua_line)) >= 0) {"
NSQ_SOURCE_LINE 00000137 "      return 1;"
NSQ_SOURCE_LINE 00000138 "    }"
NSQ_SOURCE_LINE 00000139 "    else {"
NSQ_SOURCE_LINE 00000140 "      return '';"
NSQ_SOURCE_LINE 00000141 "    }"
NSQ_SOURCE_LINE 00000142 "}"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "sub allowed {"
NSQ_SOURCE_LINE 00000146 "    my($self, $uri) = @_;"
NSQ_SOURCE_LINE 00000147 "    $uri = URI->new(\"$uri\");"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    return 1 unless $uri->scheme eq 'http' or $uri->scheme eq 'https';"
NSQ_SOURCE_LINE 00000150 "     # Robots.txt applies to only those schemes."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    my $netloc = $uri->host . \":\" . $uri->port;"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    my $fresh_until = $self->fresh_until($netloc);"
NSQ_SOURCE_LINE 00000155 "    return -1 if !defined($fresh_until) || $fresh_until < time;"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    my $str = $uri->path_query;"
NSQ_SOURCE_LINE 00000158 "    my $rule;"
NSQ_SOURCE_LINE 00000159 "    for $rule ($self->rules($netloc)) {"
NSQ_SOURCE_LINE 00000160 "\treturn 1 unless length $rule;"
NSQ_SOURCE_LINE 00000161 "\treturn 0 if index($str, $rule) == 0;"
NSQ_SOURCE_LINE 00000162 "    }"
NSQ_SOURCE_LINE 00000163 "    return 1;"
NSQ_SOURCE_LINE 00000164 "}"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "# The following methods must be provided by the subclass."
NSQ_SOURCE_LINE 00000168 "sub agent;"
NSQ_SOURCE_LINE 00000169 "sub visit;"
NSQ_SOURCE_LINE 00000170 "sub no_visits;"
NSQ_SOURCE_LINE 00000171 "sub last_visits;"
NSQ_SOURCE_LINE 00000172 "sub fresh_until;"
NSQ_SOURCE_LINE 00000173 "sub push_rules;"
NSQ_SOURCE_LINE 00000174 "sub clear_rules;"
NSQ_SOURCE_LINE 00000175 "sub rules;"
NSQ_SOURCE_LINE 00000176 "sub dump;"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "package WWW::RobotRules::InCore;"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "use vars qw(@ISA);"
NSQ_SOURCE_LINE 00000183 "@ISA = qw(WWW::RobotRules);"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "sub agent {"
NSQ_SOURCE_LINE 00000188 "    my ($self, $name) = @_;"
NSQ_SOURCE_LINE 00000189 "    my $old = $self->{'ua'};"
NSQ_SOURCE_LINE 00000190 "    if ($name) {"
NSQ_SOURCE_LINE 00000191 "        # Strip it so that it's just the short name."
NSQ_SOURCE_LINE 00000192 "        # I.e., \"FooBot\"                                      => \"FooBot\""
NSQ_SOURCE_LINE 00000193 "        #       \"FooBot/1.2\"                                  => \"FooBot\""
NSQ_SOURCE_LINE 00000194 "        #       \"FooBot/1.2 [http://foobot.int; foo@bot.int]\" => \"FooBot\""
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "\t$name = $1 if $name =~ m/(\\S+)/; # get first word"
NSQ_SOURCE_LINE 00000197 "\t$name =~ s!/.*!!;  # get rid of version"
NSQ_SOURCE_LINE 00000198 "\tunless ($old && $old eq $name) {"
NSQ_SOURCE_LINE 00000199 "\t    delete $self->{'loc'}; # all old info is now stale"
NSQ_SOURCE_LINE 00000200 "\t    $self->{'ua'} = $name;"
NSQ_SOURCE_LINE 00000201 "\t}"
NSQ_SOURCE_LINE 00000202 "    }"
NSQ_SOURCE_LINE 00000203 "    $old;"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "sub visit {"
NSQ_SOURCE_LINE 00000208 "    my($self, $netloc, $time) = @_;"
NSQ_SOURCE_LINE 00000209 "    return unless $netloc;"
NSQ_SOURCE_LINE 00000210 "    $time ||= time;"
NSQ_SOURCE_LINE 00000211 "    $self->{'loc'}{$netloc}{'last'} = $time;"
NSQ_SOURCE_LINE 00000212 "    my $count = \\$self->{'loc'}{$netloc}{'count'};"
NSQ_SOURCE_LINE 00000213 "    if (!defined $$count) {"
NSQ_SOURCE_LINE 00000214 "\t$$count = 1;"
NSQ_SOURCE_LINE 00000215 "    }"
NSQ_SOURCE_LINE 00000216 "    else {"
NSQ_SOURCE_LINE 00000217 "\t$$count++;"
NSQ_SOURCE_LINE 00000218 "    }"
NSQ_SOURCE_LINE 00000219 "}"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "sub no_visits {"
NSQ_SOURCE_LINE 00000223 "    my ($self, $netloc) = @_;"
NSQ_SOURCE_LINE 00000224 "    $self->{'loc'}{$netloc}{'count'};"
NSQ_SOURCE_LINE 00000225 "}"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "sub last_visit {"
NSQ_SOURCE_LINE 00000229 "    my ($self, $netloc) = @_;"
NSQ_SOURCE_LINE 00000230 "    $self->{'loc'}{$netloc}{'last'};"
NSQ_SOURCE_LINE 00000231 "}"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "sub fresh_until {"
NSQ_SOURCE_LINE 00000235 "    my ($self, $netloc, $fresh_until) = @_;"
NSQ_SOURCE_LINE 00000236 "    my $old = $self->{'loc'}{$netloc}{'fresh'};"
NSQ_SOURCE_LINE 00000237 "    if (defined $fresh_until) {"
NSQ_SOURCE_LINE 00000238 "\t$self->{'loc'}{$netloc}{'fresh'} = $fresh_until;"
NSQ_SOURCE_LINE 00000239 "    }"
NSQ_SOURCE_LINE 00000240 "    $old;"
NSQ_SOURCE_LINE 00000241 "}"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "sub push_rules {"
NSQ_SOURCE_LINE 00000245 "    my($self, $netloc, @rules) = @_;"
NSQ_SOURCE_LINE 00000246 "    push (@{$self->{'loc'}{$netloc}{'rules'}}, @rules);"
NSQ_SOURCE_LINE 00000247 "}"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "sub clear_rules {"
NSQ_SOURCE_LINE 00000251 "    my($self, $netloc) = @_;"
NSQ_SOURCE_LINE 00000252 "    delete $self->{'loc'}{$netloc}{'rules'};"
NSQ_SOURCE_LINE 00000253 "}"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "sub rules {"
NSQ_SOURCE_LINE 00000257 "    my($self, $netloc) = @_;"
NSQ_SOURCE_LINE 00000258 "    if (defined $self->{'loc'}{$netloc}{'rules'}) {"
NSQ_SOURCE_LINE 00000259 "\treturn @{$self->{'loc'}{$netloc}{'rules'}};"
NSQ_SOURCE_LINE 00000260 "    }"
NSQ_SOURCE_LINE 00000261 "    else {"
NSQ_SOURCE_LINE 00000262 "\treturn ();"
NSQ_SOURCE_LINE 00000263 "    }"
NSQ_SOURCE_LINE 00000264 "}"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "sub dump"
NSQ_SOURCE_LINE 00000268 "{"
NSQ_SOURCE_LINE 00000269 "    my $self = shift;"
NSQ_SOURCE_LINE 00000270 "    for (keys %$self) {"
NSQ_SOURCE_LINE 00000271 "\tnext if $_ eq 'loc';"
NSQ_SOURCE_LINE 00000272 "\tprint \"$_ = $self->{$_}\\n\";"
NSQ_SOURCE_LINE 00000273 "    }"
NSQ_SOURCE_LINE 00000274 "    for (keys %{$self->{'loc'}}) {"
NSQ_SOURCE_LINE 00000275 "\tmy @rules = $self->rules($_);"
NSQ_SOURCE_LINE 00000276 "\tprint \"$_: \", join(\"; \", @rules), \"\\n\";"
NSQ_SOURCE_LINE 00000277 "    }"
NSQ_SOURCE_LINE 00000278 "}"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "1;"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "__END__"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "# Bender: \"Well, I don't have anything else"
NSQ_SOURCE_LINE 00000287 "#          planned for today.  Let's get drunk!\""
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=head1 NAME"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "WWW::RobotRules - database of robots.txt-derived permissions"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 " use WWW::RobotRules;"
NSQ_SOURCE_LINE 00000296 " my $rules = WWW::RobotRules->new('MOMspider/1.0');"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 " use LWP::Simple qw(get);"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 " {"
NSQ_SOURCE_LINE 00000301 "   my $url = \"http://some.place/robots.txt\";"
NSQ_SOURCE_LINE 00000302 "   my $robots_txt = get $url;"
NSQ_SOURCE_LINE 00000303 "   $rules->parse($url, $robots_txt) if defined $robots_txt;"
NSQ_SOURCE_LINE 00000304 " }"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 " {"
NSQ_SOURCE_LINE 00000307 "   my $url = \"http://some.other.place/robots.txt\";"
NSQ_SOURCE_LINE 00000308 "   my $robots_txt = get $url;"
NSQ_SOURCE_LINE 00000309 "   $rules->parse($url, $robots_txt) if defined $robots_txt;"
NSQ_SOURCE_LINE 00000310 " }"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 " # Now we can check if a URL is valid for those servers"
NSQ_SOURCE_LINE 00000313 " # whose \"robots.txt\" files we've gotten and parsed:"
NSQ_SOURCE_LINE 00000314 " if($rules->allowed($url)) {"
NSQ_SOURCE_LINE 00000315 "     $c = get $url;"
NSQ_SOURCE_LINE 00000316 "     ..."
NSQ_SOURCE_LINE 00000317 " }"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "This module parses F</robots.txt> files as specified in"
NSQ_SOURCE_LINE 00000322 "\"A Standard for Robot Exclusion\", at"
NSQ_SOURCE_LINE 00000323 "<http://www.robotstxt.org/wc/norobots.html>"
NSQ_SOURCE_LINE 00000324 "Webmasters can use the F</robots.txt> file to forbid conforming"
NSQ_SOURCE_LINE 00000325 "robots from accessing parts of their web site."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "The parsed files are kept in a WWW::RobotRules object, and this object"
NSQ_SOURCE_LINE 00000328 "provides methods to check if access to a given URL is prohibited.  The"
NSQ_SOURCE_LINE 00000329 "same WWW::RobotRules object can be used for one or more parsed"
NSQ_SOURCE_LINE 00000330 "F</robots.txt> files on any number of hosts."
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "The following methods are provided:"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "=over 4"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "=item $rules = WWW::RobotRules->new($robot_name)"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "This is the constructor for WWW::RobotRules objects.  The first"
NSQ_SOURCE_LINE 00000339 "argument given to new() is the name of the robot."
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "=item $rules->parse($robot_txt_url, $content, $fresh_until)"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "The parse() method takes as arguments the URL that was used to"
NSQ_SOURCE_LINE 00000344 "retrieve the F</robots.txt> file, and the contents of the file."
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "=item $rules->allowed($uri)"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "Returns TRUE if this robot is allowed to retrieve this URL."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "=item $rules->agent([$name])"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "Get/set the agent name. NOTE: Changing the agent name will clear the robots.txt"
NSQ_SOURCE_LINE 00000353 "rules and expire times out of the cache."
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "=back"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=head1 ROBOTS.TXT"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "The format and semantics of the \"/robots.txt\" file are as follows"
NSQ_SOURCE_LINE 00000360 "(this is an edited abstract of"
NSQ_SOURCE_LINE 00000361 "<http://www.robotstxt.org/wc/norobots.html>):"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "The file consists of one or more records separated by one or more"
NSQ_SOURCE_LINE 00000364 "blank lines. Each record contains lines of the form"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "  <field-name>: <value>"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "The field name is case insensitive.  Text after the '#' character on a"
NSQ_SOURCE_LINE 00000369 "line is ignored during parsing.  This is used for comments.  The"
NSQ_SOURCE_LINE 00000370 "following <field-names> can be used:"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=over 3"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=item User-Agent"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "The value of this field is the name of the robot the record is"
NSQ_SOURCE_LINE 00000377 "describing access policy for.  If more than one I<User-Agent> field is"
NSQ_SOURCE_LINE 00000378 "present the record describes an identical access policy for more than"
NSQ_SOURCE_LINE 00000379 "one robot. At least one field needs to be present per record.  If the"
NSQ_SOURCE_LINE 00000380 "value is '*', the record describes the default access policy for any"
NSQ_SOURCE_LINE 00000381 "robot that has not not matched any of the other records."
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "The I<User-Agent> fields must occur before the I<Disallow> fields.  If a"
NSQ_SOURCE_LINE 00000384 "record contains a I<User-Agent> field after a I<Disallow> field, that"
NSQ_SOURCE_LINE 00000385 "constitutes a malformed record.  This parser will assume that a blank"
NSQ_SOURCE_LINE 00000386 "line should have been placed before that I<User-Agent> field, and will"
NSQ_SOURCE_LINE 00000387 "break the record into two.  All the fields before the I<User-Agent> field"
NSQ_SOURCE_LINE 00000388 "will constitute a record, and the I<User-Agent> field will be the first"
NSQ_SOURCE_LINE 00000389 "field in a new record."
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "=item Disallow"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "The value of this field specifies a partial URL that is not to be"
NSQ_SOURCE_LINE 00000394 "visited. This can be a full path, or a partial path; any URL that"
NSQ_SOURCE_LINE 00000395 "starts with this value will not be retrieved"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=back"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "Unrecognized records are ignored."
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=head1 ROBOTS.TXT EXAMPLES"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "The following example \"/robots.txt\" file specifies that no robots"
NSQ_SOURCE_LINE 00000404 "should visit any URL starting with \"/cyberworld/map/\" or \"/tmp/\":"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "  User-agent: *"
NSQ_SOURCE_LINE 00000407 "  Disallow: /cyberworld/map/ # This is an infinite virtual URL space"
NSQ_SOURCE_LINE 00000408 "  Disallow: /tmp/ # these will soon disappear"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "This example \"/robots.txt\" file specifies that no robots should visit"
NSQ_SOURCE_LINE 00000411 "any URL starting with \"/cyberworld/map/\", except the robot called"
NSQ_SOURCE_LINE 00000412 "\"cybermapper\":"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "  User-agent: *"
NSQ_SOURCE_LINE 00000415 "  Disallow: /cyberworld/map/ # This is an infinite virtual URL space"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "  # Cybermapper knows where to go."
NSQ_SOURCE_LINE 00000418 "  User-agent: cybermapper"
NSQ_SOURCE_LINE 00000419 "  Disallow:"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "This example indicates that no robots should visit this site further:"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "  # go away"
NSQ_SOURCE_LINE 00000424 "  User-agent: *"
NSQ_SOURCE_LINE 00000425 "  Disallow: /"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "This is an example of a malformed robots.txt file."
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "  # robots.txt for ancientcastle.example.com"
NSQ_SOURCE_LINE 00000430 "  # I've locked myself away."
NSQ_SOURCE_LINE 00000431 "  User-agent: *"
NSQ_SOURCE_LINE 00000432 "  Disallow: /"
NSQ_SOURCE_LINE 00000433 "  # The castle is your home now, so you can go anywhere you like."
NSQ_SOURCE_LINE 00000434 "  User-agent: Belle"
NSQ_SOURCE_LINE 00000435 "  Disallow: /west-wing/ # except the west wing!"
NSQ_SOURCE_LINE 00000436 "  # It's good to be the Prince..."
NSQ_SOURCE_LINE 00000437 "  User-agent: Beast"
NSQ_SOURCE_LINE 00000438 "  Disallow:"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "This file is missing the required blank lines between records."
NSQ_SOURCE_LINE 00000441 "However, the intention is clear."
NSQ_SOURCE_LINE 00000442 ""
