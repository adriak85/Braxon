NSQ_SOURCE_LINE 00000004 "package Text::MicroTemplate;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "require Exporter;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use strict;"
NSQ_SOURCE_LINE 00000009 "use warnings;"
NSQ_SOURCE_LINE 00000010 "use constant DEBUG => $ENV{MICRO_TEMPLATE_DEBUG} || 0;"
NSQ_SOURCE_LINE 00000011 "use 5.00800;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Scalar::Util;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our $VERSION = '0.24';"
NSQ_SOURCE_LINE 00000016 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000017 "our @EXPORT_OK = qw(encoded_string build_mt render_mt);"
NSQ_SOURCE_LINE 00000018 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000019 "    all => [ @EXPORT_OK ],"
NSQ_SOURCE_LINE 00000020 ");"
NSQ_SOURCE_LINE 00000021 "our $_mt_setter = '';"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub new {"
NSQ_SOURCE_LINE 00000024 "    my $class = shift;"
NSQ_SOURCE_LINE 00000025 "    my $self = bless {"
NSQ_SOURCE_LINE 00000026 "        code                => undef,"
NSQ_SOURCE_LINE 00000027 "        comment_mark        => '#',"
NSQ_SOURCE_LINE 00000028 "        expression_mark     => '=',"
NSQ_SOURCE_LINE 00000029 "        line_start          => '?',"
NSQ_SOURCE_LINE 00000030 "        template            => undef,"
NSQ_SOURCE_LINE 00000031 "        tree                => [],"
NSQ_SOURCE_LINE 00000032 "        tag_start           => '<?',"
NSQ_SOURCE_LINE 00000033 "        tag_end             => '?>',"
NSQ_SOURCE_LINE 00000034 "        escape_func         => \\&_inline_escape_html,"
NSQ_SOURCE_LINE 00000035 "        prepend             => '',"
NSQ_SOURCE_LINE 00000036 "        package_name        => undef, # defaults to caller"
NSQ_SOURCE_LINE 00000037 "        @_ == 1 ? ref($_[0]) ? %{$_[0]} : (template => $_[0]) : @_,"
NSQ_SOURCE_LINE 00000038 "    }, $class;"
NSQ_SOURCE_LINE 00000039 "    if (defined $self->{template}) {"
NSQ_SOURCE_LINE 00000040 "        $self->parse($self->{template});"
NSQ_SOURCE_LINE 00000041 "    }"
NSQ_SOURCE_LINE 00000042 "    unless (defined $self->{package_name}) {"
NSQ_SOURCE_LINE 00000043 "        $self->{package_name} = 'main';"
NSQ_SOURCE_LINE 00000044 "        my $i = 0;"
NSQ_SOURCE_LINE 00000045 "        while (my $c = caller(++$i)) {"
NSQ_SOURCE_LINE 00000046 "            if ($c !~ /^Text::MicroTemplate\\b/) {"
NSQ_SOURCE_LINE 00000047 "                $self->{package_name} = $c;"
NSQ_SOURCE_LINE 00000048 "                last;"
NSQ_SOURCE_LINE 00000049 "            }"
NSQ_SOURCE_LINE 00000050 "        }"
NSQ_SOURCE_LINE 00000051 "    }"
NSQ_SOURCE_LINE 00000052 "    $self;"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "sub escape_func {"
NSQ_SOURCE_LINE 00000056 "    my $self = shift;"
NSQ_SOURCE_LINE 00000057 "    if (@_) {"
NSQ_SOURCE_LINE 00000058 "        $self->{escape_func} = shift;"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 "    $self->{escape_func};"
NSQ_SOURCE_LINE 00000061 "}"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "sub package_name {"
NSQ_SOURCE_LINE 00000064 "    my $self = shift;"
NSQ_SOURCE_LINE 00000065 "    if (@_) {"
NSQ_SOURCE_LINE 00000066 "        $self->{package_name} = shift;"
NSQ_SOURCE_LINE 00000067 "    }"
NSQ_SOURCE_LINE 00000068 "    $self->{package_name};"
NSQ_SOURCE_LINE 00000069 "}"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "sub template { shift->{template} }"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "sub code {"
NSQ_SOURCE_LINE 00000074 "    my $self = shift;"
NSQ_SOURCE_LINE 00000075 "    unless (defined $self->{code}) {"
NSQ_SOURCE_LINE 00000076 "        $self->_build();"
NSQ_SOURCE_LINE 00000077 "    }"
NSQ_SOURCE_LINE 00000078 "    $self->{code};"
NSQ_SOURCE_LINE 00000079 "}"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "sub _build {"
NSQ_SOURCE_LINE 00000082 "    my $self = shift;"
NSQ_SOURCE_LINE 00000083 "    "
NSQ_SOURCE_LINE 00000084 "    my $escape_func = $self->{escape_func} || '';"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    my $embed_escape_func = ref($escape_func) eq 'CODE'"
NSQ_SOURCE_LINE 00000087 "        ? $escape_func"
NSQ_SOURCE_LINE 00000088 "        : sub{ $escape_func . \"(@_)\" };"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    # Compile"
NSQ_SOURCE_LINE 00000091 "    my @lines;"
NSQ_SOURCE_LINE 00000092 "    my $last_was_code;"
NSQ_SOURCE_LINE 00000093 "    my $last_text;"
NSQ_SOURCE_LINE 00000094 "    for my $line (@{$self->{tree}}) {"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "        # New line"
NSQ_SOURCE_LINE 00000097 "        push @lines, '';"
NSQ_SOURCE_LINE 00000098 "        for (my $j = 0; $j < @{$line}; $j += 2) {"
NSQ_SOURCE_LINE 00000099 "            my $type  = $line->[$j];"
NSQ_SOURCE_LINE 00000100 "            my $value = $line->[$j + 1];"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "            if ($type ne 'text' && defined $last_text) {"
NSQ_SOURCE_LINE 00000103 "                # do not mess the start of current line, since it might be"
NSQ_SOURCE_LINE 00000104 "                # the start of \"=pod\", etc."
NSQ_SOURCE_LINE 00000105 "                $lines["
NSQ_SOURCE_LINE 00000106 "                    $j == 0 && @lines >= 2 ? -2 : -1"
NSQ_SOURCE_LINE 00000107 "                ] .= \"\\$_MT .=\\\"$last_text\\\";\";"
NSQ_SOURCE_LINE 00000108 "                undef $last_text;"
NSQ_SOURCE_LINE 00000109 "            }"
NSQ_SOURCE_LINE 00000110 "            "
NSQ_SOURCE_LINE 00000111 "            # Need to fix line ending?"
NSQ_SOURCE_LINE 00000112 "            my $newline = chomp $value;"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "            # add semicolon to last line of code"
NSQ_SOURCE_LINE 00000115 "            if ($last_was_code && $type ne 'code') {"
NSQ_SOURCE_LINE 00000116 "                $lines[-1] .= ';';"
NSQ_SOURCE_LINE 00000117 "                undef $last_was_code;"
NSQ_SOURCE_LINE 00000118 "            }"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "            # Text"
NSQ_SOURCE_LINE 00000121 "            if ($type eq 'text') {"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "                # Quote and fix line ending"
NSQ_SOURCE_LINE 00000124 "                $value = quotemeta($value);"
NSQ_SOURCE_LINE 00000125 "                $value .= '\\n' if $newline;"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "                $last_text = defined $last_text ? \"$last_text$value\" : $value;"
NSQ_SOURCE_LINE 00000128 "            }"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "            # Code"
NSQ_SOURCE_LINE 00000131 "            if ($type eq 'code') {"
NSQ_SOURCE_LINE 00000132 "                $lines[-1] .= $value;"
NSQ_SOURCE_LINE 00000133 "                $last_was_code = 1;"
NSQ_SOURCE_LINE 00000134 "            }"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "            # Expression"
NSQ_SOURCE_LINE 00000137 "            if ($type eq 'expr') {"
NSQ_SOURCE_LINE 00000138 "                my $escaped = $embed_escape_func->('$_MT_T');"
NSQ_SOURCE_LINE 00000139 "                if ($newline && $value =~ /\\n/) {"
NSQ_SOURCE_LINE 00000140 "                    $value .= \"\\n\"; # temporary workaround for t/13-heredoc.t"
NSQ_SOURCE_LINE 00000141 "                }"
NSQ_SOURCE_LINE 00000142 "                $lines[-1] .= \"\\$_MT_T = $value;\\$_MT .= ref \\$_MT_T eq 'Text::MicroTemplate::EncodedString' ? \\$\\$_MT_T : $escaped; \\$_MT_T = '';\";"
NSQ_SOURCE_LINE 00000143 "            }"
NSQ_SOURCE_LINE 00000144 "        }"
NSQ_SOURCE_LINE 00000145 "    }"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    # add semicolon to last line of code"
NSQ_SOURCE_LINE 00000148 "    if ($last_was_code) {"
NSQ_SOURCE_LINE 00000149 "        $lines[-1] .= \"\\n;\";"
NSQ_SOURCE_LINE 00000150 "    }"
NSQ_SOURCE_LINE 00000151 "    # add last text line(s)"
NSQ_SOURCE_LINE 00000152 "    if (defined $last_text) {"
NSQ_SOURCE_LINE 00000153 "        $lines[-1] .= \"\\$_MT .=\\\"$last_text\\\";\";"
NSQ_SOURCE_LINE 00000154 "    }"
NSQ_SOURCE_LINE 00000155 "    "
NSQ_SOURCE_LINE 00000156 "    # Wrap"
NSQ_SOURCE_LINE 00000157 "    $lines[0]   = q/sub { my $_MT = ''; local $/ . $self->{package_name} . q/::_MTREF = \\$_MT; my $_MT_T = '';/ . (@lines ? $lines[0] : '');"
NSQ_SOURCE_LINE 00000158 "    $lines[-1] .= q/return $_MT; }/;"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "    $self->{code} = join \"\\n\", @lines;"
NSQ_SOURCE_LINE 00000161 "    return $self;"
NSQ_SOURCE_LINE 00000162 "}"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "# I am so smart! I am so smart! S-M-R-T! I mean S-M-A-R-T..."
NSQ_SOURCE_LINE 00000165 "sub parse {"
NSQ_SOURCE_LINE 00000166 "    my ($self, $tmpl) = @_;"
NSQ_SOURCE_LINE 00000167 "    $self->{template} = $tmpl;"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    # Clean start"
NSQ_SOURCE_LINE 00000170 "    delete $self->{tree};"
NSQ_SOURCE_LINE 00000171 "    delete $self->{code};"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    # Tags"
NSQ_SOURCE_LINE 00000174 "    my $line_start    = quotemeta $self->{line_start};"
NSQ_SOURCE_LINE 00000175 "    my $tag_start     = quotemeta $self->{tag_start};"
NSQ_SOURCE_LINE 00000176 "    my $tag_end       = quotemeta $self->{tag_end};"
NSQ_SOURCE_LINE 00000177 "    my $cmnt_mark     = quotemeta $self->{comment_mark};"
NSQ_SOURCE_LINE 00000178 "    my $expr_mark     = quotemeta $self->{expression_mark};"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    # Tokenize"
NSQ_SOURCE_LINE 00000181 "    my $state = 'text';"
NSQ_SOURCE_LINE 00000182 "    my @lines = split /(\\n)/, $tmpl;"
NSQ_SOURCE_LINE 00000183 "    my $tokens = [];"
NSQ_SOURCE_LINE 00000184 "    while (@lines) {"
NSQ_SOURCE_LINE 00000185 "        my $line = shift @lines;"
NSQ_SOURCE_LINE 00000186 "        my $newline = undef;"
NSQ_SOURCE_LINE 00000187 "        if (@lines) {"
NSQ_SOURCE_LINE 00000188 "            shift @lines;"
NSQ_SOURCE_LINE 00000189 "            $newline = 1;"
NSQ_SOURCE_LINE 00000190 "        }"
NSQ_SOURCE_LINE 00000191 "        "
NSQ_SOURCE_LINE 00000192 "        if ($state eq 'text') {"
NSQ_SOURCE_LINE 00000193 "            # Perl line without return value"
NSQ_SOURCE_LINE 00000194 "            if ($line =~ /^$line_start\\s+(.*)$/) {"
NSQ_SOURCE_LINE 00000195 "                push @{$self->{tree}}, ['code', $1];"
NSQ_SOURCE_LINE 00000196 "                next;"
NSQ_SOURCE_LINE 00000197 "            }"
NSQ_SOURCE_LINE 00000198 "            # Perl line with return value"
NSQ_SOURCE_LINE 00000199 "            if ($line =~ /^$line_start$expr_mark\\s+(.+)$/) {"
NSQ_SOURCE_LINE 00000200 "                push @{$self->{tree}}, ["
NSQ_SOURCE_LINE 00000201 "                    'expr', $1,"
NSQ_SOURCE_LINE 00000202 "                    $newline ? ('text', \"\\n\") : (),"
NSQ_SOURCE_LINE 00000203 "                ];"
NSQ_SOURCE_LINE 00000204 "                next;"
NSQ_SOURCE_LINE 00000205 "            }"
NSQ_SOURCE_LINE 00000206 "            # Comment line, dummy token needed for line count"
NSQ_SOURCE_LINE 00000207 "            if ($line =~ /^$line_start$cmnt_mark/) {"
NSQ_SOURCE_LINE 00000208 "                push @{$self->{tree}}, [];"
NSQ_SOURCE_LINE 00000209 "                next;"
NSQ_SOURCE_LINE 00000210 "            }"
NSQ_SOURCE_LINE 00000211 "        }"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "        # Escaped line ending?"
NSQ_SOURCE_LINE 00000214 "        if ($line =~ /(\\\\+)$/) {"
NSQ_SOURCE_LINE 00000215 "            my $length = length $1;"
NSQ_SOURCE_LINE 00000216 "            # Newline escaped"
NSQ_SOURCE_LINE 00000217 "            if ($length == 1) {"
NSQ_SOURCE_LINE 00000218 "                $line =~ s/\\\\$//;"
NSQ_SOURCE_LINE 00000219 "            }"
NSQ_SOURCE_LINE 00000220 "            # Backslash escaped"
NSQ_SOURCE_LINE 00000221 "            if ($length >= 2) {"
NSQ_SOURCE_LINE 00000222 "                $line =~ s/\\\\\\\\$/\\\\/;"
NSQ_SOURCE_LINE 00000223 "                $line .= \"\\n\";"
NSQ_SOURCE_LINE 00000224 "            }"
NSQ_SOURCE_LINE 00000225 "        } else {"
NSQ_SOURCE_LINE 00000226 "            $line .= \"\\n\" if $newline;"
NSQ_SOURCE_LINE 00000227 "        }"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "        # Mixed line"
NSQ_SOURCE_LINE 00000230 "        for my $token (split /"
NSQ_SOURCE_LINE 00000231 "            ("
NSQ_SOURCE_LINE 00000232 "                $tag_start$expr_mark     # Expression"
NSQ_SOURCE_LINE 00000233 "            |"
NSQ_SOURCE_LINE 00000234 "                $tag_start$cmnt_mark     # Comment"
NSQ_SOURCE_LINE 00000235 "            |"
NSQ_SOURCE_LINE 00000236 "                $tag_start               # Code"
NSQ_SOURCE_LINE 00000237 "            |"
NSQ_SOURCE_LINE 00000238 "                $tag_end                 # End"
NSQ_SOURCE_LINE 00000239 "            )"
NSQ_SOURCE_LINE 00000240 "        /x, $line) {"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "            # handle tags and bail out"
NSQ_SOURCE_LINE 00000243 "            if ($token eq '') {"
NSQ_SOURCE_LINE 00000244 "                next;"
NSQ_SOURCE_LINE 00000245 "            } elsif ($token =~ /^$tag_end$/) {"
NSQ_SOURCE_LINE 00000246 "                $state = 'text';"
NSQ_SOURCE_LINE 00000247 "                next;"
NSQ_SOURCE_LINE 00000248 "            } elsif ($token =~ /^$tag_start$/) {"
NSQ_SOURCE_LINE 00000249 "                $state = 'code';"
NSQ_SOURCE_LINE 00000250 "                next;"
NSQ_SOURCE_LINE 00000251 "            } elsif ($token =~ /^$tag_start$cmnt_mark$/) {"
NSQ_SOURCE_LINE 00000252 "                $state = 'cmnt';"
NSQ_SOURCE_LINE 00000253 "                next;"
NSQ_SOURCE_LINE 00000254 "            } elsif ($token =~ /^$tag_start$expr_mark$/) {"
NSQ_SOURCE_LINE 00000255 "                $state = 'expr';"
NSQ_SOURCE_LINE 00000256 "                next;"
NSQ_SOURCE_LINE 00000257 "            }"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "            # value"
NSQ_SOURCE_LINE 00000260 "            if ($state eq 'text') {"
NSQ_SOURCE_LINE 00000261 "                push @$tokens, $state, $token;"
NSQ_SOURCE_LINE 00000262 "            } elsif ($state eq 'cmnt') {"
NSQ_SOURCE_LINE 00000263 "                next; # ignore comments"
NSQ_SOURCE_LINE 00000264 "            } elsif ($state eq 'cont') {"
NSQ_SOURCE_LINE 00000265 "                $tokens->[-1] .= $token;"
NSQ_SOURCE_LINE 00000266 "            } else {"
NSQ_SOURCE_LINE 00000267 "                # state is code or expr"
NSQ_SOURCE_LINE 00000268 "                push @$tokens, $state, $token;"
NSQ_SOURCE_LINE 00000269 "                $state = 'cont';"
NSQ_SOURCE_LINE 00000270 "            }"
NSQ_SOURCE_LINE 00000271 "        }"
NSQ_SOURCE_LINE 00000272 "        if ($state eq 'text') {"
NSQ_SOURCE_LINE 00000273 "            push @{$self->{tree}}, $tokens;"
NSQ_SOURCE_LINE 00000274 "            $tokens = [];"
NSQ_SOURCE_LINE 00000275 "        }"
NSQ_SOURCE_LINE 00000276 "    }"
NSQ_SOURCE_LINE 00000277 "    push @{$self->{tree}}, $tokens"
NSQ_SOURCE_LINE 00000278 "        if @$tokens;"
NSQ_SOURCE_LINE 00000279 "    "
NSQ_SOURCE_LINE 00000280 "    return $self;"
NSQ_SOURCE_LINE 00000281 "}"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "sub _context {"
NSQ_SOURCE_LINE 00000284 "    my ($self, $text, $line) = @_;"
NSQ_SOURCE_LINE 00000285 "    my @lines  = split /\\n/, $text;"
NSQ_SOURCE_LINE 00000286 "    "
NSQ_SOURCE_LINE 00000287 "    join '', map {"
NSQ_SOURCE_LINE 00000288 "        0 < $_ && $_ <= @lines ? sprintf(\"%4d: %s\\n\", $_, $lines[$_ - 1]) : ''"
NSQ_SOURCE_LINE 00000289 "    } ($line - 2) .. ($line + 2);"
NSQ_SOURCE_LINE 00000290 "}"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "# Debug goodness"
NSQ_SOURCE_LINE 00000293 "sub _error {"
NSQ_SOURCE_LINE 00000294 "    my ($self, $error, $line_offset, $from) = @_;"
NSQ_SOURCE_LINE 00000295 "    "
NSQ_SOURCE_LINE 00000296 "    # Line"
NSQ_SOURCE_LINE 00000297 "    if ($error =~ /^(.*)\\s+at\\s+\\(eval\\s+\\d+\\)\\s+line\\s+(\\d+)/) {"
NSQ_SOURCE_LINE 00000298 "        my $reason = $1;"
NSQ_SOURCE_LINE 00000299 "        my $line   = $2 - $line_offset;"
NSQ_SOURCE_LINE 00000300 "        my $delim  = '-' x 76;"
NSQ_SOURCE_LINE 00000301 "        "
NSQ_SOURCE_LINE 00000302 "        my $report = \"$reason at line $line in template passed from $from.\\n\";"
NSQ_SOURCE_LINE 00000303 "        my $template = $self->_context($self->{template}, $line);"
NSQ_SOURCE_LINE 00000304 "        $report .= \"$delim\\n$template$delim\\n\";"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "        # Advanced debugging"
NSQ_SOURCE_LINE 00000307 "        if (DEBUG) {"
NSQ_SOURCE_LINE 00000308 "            my $code = $self->_context($self->code, $line);"
NSQ_SOURCE_LINE 00000309 "            $report .= \"$code$delim\\n\";"
NSQ_SOURCE_LINE 00000310 "            $report .= $error;"
NSQ_SOURCE_LINE 00000311 "        }"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "        return $report;"
NSQ_SOURCE_LINE 00000314 "    }"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "    # No line found"
NSQ_SOURCE_LINE 00000317 "    return \"Template error: $error\";"
NSQ_SOURCE_LINE 00000318 "}"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "# create raw string (that does not need to be escaped)"
NSQ_SOURCE_LINE 00000321 "sub encoded_string {"
NSQ_SOURCE_LINE 00000322 "    Text::MicroTemplate::EncodedString->new($_[0]);"
NSQ_SOURCE_LINE 00000323 "}"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "sub _inline_escape_html{"
NSQ_SOURCE_LINE 00000327 "    my($variable) = @_;"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "    my $source = qq{"
NSQ_SOURCE_LINE 00000330 "        do{"
NSQ_SOURCE_LINE 00000331 "            $variable =~ s/([&><\"'])/\\$Text::MicroTemplate::_escape_table{\\$1}/ge;"
NSQ_SOURCE_LINE 00000332 "            $variable;"
NSQ_SOURCE_LINE 00000333 "        }"
NSQ_SOURCE_LINE 00000334 "    }; #\" for poor editors"
NSQ_SOURCE_LINE 00000335 "    $source =~ s/\\n//g; # to keep line numbers"
NSQ_SOURCE_LINE 00000336 "    return $source;"
NSQ_SOURCE_LINE 00000337 "}"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "our %_escape_table = ( '&' => '&amp;', '>' => '&gt;', '<' => '&lt;', q{\"} => '&quot;', q{'} => '&#39;' );"
NSQ_SOURCE_LINE 00000340 "sub escape_html {"
NSQ_SOURCE_LINE 00000341 "    my $str = shift;"
NSQ_SOURCE_LINE 00000342 "    return ''"
NSQ_SOURCE_LINE 00000343 "        unless defined $str;"
NSQ_SOURCE_LINE 00000344 "    return $str->as_string"
NSQ_SOURCE_LINE 00000345 "        if ref $str eq 'Text::MicroTemplate::EncodedString';"
NSQ_SOURCE_LINE 00000346 "    $str =~ s/([&><\"'])/$_escape_table{$1}/ge; #' for poor editors"
NSQ_SOURCE_LINE 00000347 "    return $str;"
NSQ_SOURCE_LINE 00000348 "}"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "sub build_mt {"
NSQ_SOURCE_LINE 00000351 "    my $mt = Text::MicroTemplate->new(@_);"
NSQ_SOURCE_LINE 00000352 "    $mt->build();"
NSQ_SOURCE_LINE 00000353 "}"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "sub build {"
NSQ_SOURCE_LINE 00000356 "    my $_mt = shift;"
NSQ_SOURCE_LINE 00000357 "    Scalar::Util::weaken($_mt) if $_mt_setter;"
NSQ_SOURCE_LINE 00000358 "    my $_code = $_mt->code;"
NSQ_SOURCE_LINE 00000359 "    my $_from = sub {"
NSQ_SOURCE_LINE 00000360 "        my $i = 0;"
NSQ_SOURCE_LINE 00000361 "        while (my @c = caller(++$i)) {"
NSQ_SOURCE_LINE 00000362 "            return \"$c[1] at line $c[2]\""
NSQ_SOURCE_LINE 00000363 "                if $c[0] ne __PACKAGE__;"
NSQ_SOURCE_LINE 00000364 "        }"
NSQ_SOURCE_LINE 00000365 "        '';"
NSQ_SOURCE_LINE 00000366 "    }->();"
NSQ_SOURCE_LINE 00000367 "    my $line_offset = (() = ($_mt->{prepend} =~ /\\n/sg)) + 5;"
NSQ_SOURCE_LINE 00000368 "    my $expr = << \"...\";"
NSQ_SOURCE_LINE 00000369 "package $_mt->{package_name};"
NSQ_SOURCE_LINE 00000370 "sub {"
NSQ_SOURCE_LINE 00000371 "    ${_mt_setter}local \\$SIG{__WARN__} = sub { print STDERR \\$_mt->_error(shift, $line_offset, \\$_from) };"
NSQ_SOURCE_LINE 00000372 "    $_mt->{prepend}"
NSQ_SOURCE_LINE 00000373 "    Text::MicroTemplate::encoded_string(("
NSQ_SOURCE_LINE 00000374 "        $_code"
NSQ_SOURCE_LINE 00000375 "    )->(\\@_));"
NSQ_SOURCE_LINE 00000376 "}"
NSQ_SOURCE_LINE 00000377 "..."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "    if(DEBUG >= 2){"
NSQ_SOURCE_LINE 00000380 "        DEBUG >= 3 ? die $expr : warn $expr;"
NSQ_SOURCE_LINE 00000381 "    }"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "    my $die_msg;"
NSQ_SOURCE_LINE 00000384 "    {"
NSQ_SOURCE_LINE 00000385 "        local $@;"
NSQ_SOURCE_LINE 00000386 "        if (my $_builder = eval($expr)) {"
NSQ_SOURCE_LINE 00000387 "            return $_builder;"
NSQ_SOURCE_LINE 00000388 "        }"
NSQ_SOURCE_LINE 00000389 "        $die_msg = $_mt->_error($@, $line_offset, $_from);"
NSQ_SOURCE_LINE 00000390 "    }"
NSQ_SOURCE_LINE 00000391 "    die $die_msg;"
NSQ_SOURCE_LINE 00000392 "}"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "sub render_mt {"
NSQ_SOURCE_LINE 00000395 "    my $builder = build_mt(shift);"
NSQ_SOURCE_LINE 00000396 "    $builder->(@_);"
NSQ_SOURCE_LINE 00000397 "}"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "# ? $_mt->filter(sub { s/\\s+//smg; s/[\\r\\n]//g; })->(sub { ... ? });"
NSQ_SOURCE_LINE 00000400 "sub filter {"
NSQ_SOURCE_LINE 00000401 "    my ($self, $callback) = @_;"
NSQ_SOURCE_LINE 00000402 "    my $mtref = do {"
NSQ_SOURCE_LINE 00000403 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000404 "        ${\"$self->{package_name}::_MTREF\"};"
NSQ_SOURCE_LINE 00000405 "    };"
NSQ_SOURCE_LINE 00000406 "    my $before = $$mtref;"
NSQ_SOURCE_LINE 00000407 "    $$mtref = '';"
NSQ_SOURCE_LINE 00000408 "    return sub {"
NSQ_SOURCE_LINE 00000409 "        my $inner_func = shift;"
NSQ_SOURCE_LINE 00000410 "        $inner_func->(@_);"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "        ## sub { s/foo/bar/g } is a valid filter"
NSQ_SOURCE_LINE 00000413 "        ## sub { DateTime::Format::Foo->parse_string(shift) } is valid too"
NSQ_SOURCE_LINE 00000414 "        local $_ = $$mtref;"
NSQ_SOURCE_LINE 00000415 "        my $retval = $callback->($$mtref);"
NSQ_SOURCE_LINE 00000416 "        no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000417 "        if (($retval =~ /^\\d+$/ and $_ ne $$mtref) or (defined $retval and !$retval)) {"
NSQ_SOURCE_LINE 00000418 "            $$mtref = $before . $_;"
NSQ_SOURCE_LINE 00000419 "        } else {"
NSQ_SOURCE_LINE 00000420 "            $$mtref = $before . $retval;"
NSQ_SOURCE_LINE 00000421 "        }"
NSQ_SOURCE_LINE 00000422 "    }"
NSQ_SOURCE_LINE 00000423 "}"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "package Text::MicroTemplate::EncodedString;"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "use strict;"
NSQ_SOURCE_LINE 00000428 "use warnings;"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "use overload q{\"\"} => sub { shift->as_string }, fallback => 1;"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "sub new {"
NSQ_SOURCE_LINE 00000433 "    my ($klass, $str) = @_;"
NSQ_SOURCE_LINE 00000434 "    bless \\$str, $klass;"
NSQ_SOURCE_LINE 00000435 "}"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "sub as_string {"
NSQ_SOURCE_LINE 00000438 "    my $self = shift;"
NSQ_SOURCE_LINE 00000439 "    $$self;"
NSQ_SOURCE_LINE 00000440 "}"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "1;"
NSQ_SOURCE_LINE 00000443 "__END__"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=head1 NAME"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "Text::MicroTemplate - Micro template engine with Perl5 language"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "    use Text::MicroTemplate qw(:all);"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "    # compile template, and render"
NSQ_SOURCE_LINE 00000454 "    $renderer = build_mt('hello, <?= $_[0] ?>');"
NSQ_SOURCE_LINE 00000455 "    $html = $renderer->('John')->as_string;"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "    # or in one line"
NSQ_SOURCE_LINE 00000458 "    $html = render_mt('hello, <?= $_[0] ?>', 'John')->as_string;"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "    # complex form"
NSQ_SOURCE_LINE 00000461 "    $mt = Text::MicroTemplate->new("
NSQ_SOURCE_LINE 00000462 "        template => 'hello, <?= $query->param('user') ?>',"
NSQ_SOURCE_LINE 00000463 "    );"
NSQ_SOURCE_LINE 00000464 "    $code = $mt->code;"
NSQ_SOURCE_LINE 00000465 "    $renderer = eval << \"...\" or die $@;"
NSQ_SOURCE_LINE 00000466 "    sub {"
NSQ_SOURCE_LINE 00000467 "        my \\$query = shift;"
NSQ_SOURCE_LINE 00000468 "        $code->();"
NSQ_SOURCE_LINE 00000469 "    }"
NSQ_SOURCE_LINE 00000470 "    ..."
NSQ_SOURCE_LINE 00000471 "    $html = $renderer->(CGI->new)->as_string;"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "Text::MicroTemplate is a standalone, fast, intelligent, extensible template engine with following features."
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "=head2 standalone"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "Text::MicroTemplate does not rely on other CPAN modules."
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "=head2 fast"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "Based on L<Mojo::Template>, expressions in the template is perl code."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "=head2 intelligent"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "Text::MicroTemplate automatically escapes variables when and only when necessary."
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "=head2 extensible"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "Text::MicroTemplate does not provide features like template cache or including other files by itself.  However, it is easy to add you own (that suites the most to your application), by wrapping the result of the module (which is a perl expression)."
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "The module only provides basic building blocks for a template engine.  Refer to L<Text::MicroTemplate::File> for higher-level interface."
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "=head1 TEMPLATE SYNTAX"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "The template language is Perl5 itself!"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "    # output the result of expression with automatic escape"
NSQ_SOURCE_LINE 00000500 "    <?= $expr ?>             (tag style)"
NSQ_SOURCE_LINE 00000501 "    ?= $expr                 (per-line)"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "    # execute perl code (tag style)"
NSQ_SOURCE_LINE 00000504 "    <? foo() ?>"
NSQ_SOURCE_LINE 00000505 "    ? foo()"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "    # comment (tag style)"
NSQ_SOURCE_LINE 00000508 "    <?# comment ?>"
NSQ_SOURCE_LINE 00000509 "    ?# comment"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "    # loops"
NSQ_SOURCE_LINE 00000512 "    <ul>"
NSQ_SOURCE_LINE 00000513 "    ? for my $item (@list) {"
NSQ_SOURCE_LINE 00000514 "    <li><?= $item ?></li>"
NSQ_SOURCE_LINE 00000515 "    ? }"
NSQ_SOURCE_LINE 00000516 "    </ul>"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "=head1 EXPORTABLE FUNCTIONS"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=head2 build_mt($template)"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "Returns a subref that renders given template.  Parameters are equivalent to Text::MicroTemplate->new."
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "    # build template renderer at startup time and use it multiple times"
NSQ_SOURCE_LINE 00000525 "    my $renderer = build_mt('hello, <?= $_[0] ?>!');"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "    sub run {"
NSQ_SOURCE_LINE 00000528 "        ..."
NSQ_SOURCE_LINE 00000529 "        my $hello = $renderer->($query->param('user'));"
NSQ_SOURCE_LINE 00000530 "        ..."
NSQ_SOURCE_LINE 00000531 "    }"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "=head2 render_mt($template, @args)"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "Utility function that combines build_mt and call to the generated template builder."
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "    # render"
NSQ_SOURCE_LINE 00000538 "    $hello = render_mt('hello, <?= $_[0] ?>!', 'John');"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "    # print as HTML"
NSQ_SOURCE_LINE 00000541 "    print $hello->as_string;"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "    # use the result in another template (no double-escapes)"
NSQ_SOURCE_LINE 00000544 "    $enc = render_mt('<h1><?= $_[0] ?></h1>', $hello);"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "Internally, the function is equivalent to:"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "    build_mt($template)->(@_);"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "=head2 encoded_string($str)"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "wraps given string to an object that will not be escaped by the template engine"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "=head1 OO-STYLE INTERFACE"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "Text::MicroTemplate provides OO-style interface to handle more complex cases."
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "=head2 new($template)"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "=head2 new(%args)"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "=head2 new(\\%args)"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "Constructs template renderer.  In the second or third form, parameters below are recognized."
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "=head3 template"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "template string (mandatory)"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "=head3 escape_func"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "escape function (defaults to L<Text::MicroTemplate::escape_html>), no escape when set to undef"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "=head3 package_name"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "package under where the renderer is compiled (defaults to caller package)"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "=head3 prepend"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "Prepends Perl code to the template."
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "=head2 code()"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "returns perl code that renders the template when evaluated"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "=head2 filter(sub filter_func { ... })->(sub { template lines })"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "filters given template lines"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "    ? $_mt->filter(sub { s/Hello/Good bye/g })->(sub {"
NSQ_SOURCE_LINE 00000591 "    Hello, John!"
NSQ_SOURCE_LINE 00000592 "    ? })"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "=head1 DEBUG"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "The C<MICRO_TEMPLATE_DEBUG> environment variable helps debugging."
NSQ_SOURCE_LINE 00000597 "The value C<1> extends debugging messages, C<2> reports compiled"
NSQ_SOURCE_LINE 00000598 "Perl code with C<warn()>, C<3> is like C<2> but uses C<die()>."
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "=head1 SEE ALSO"
