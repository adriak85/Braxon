BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package persona;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "$VERSION= '0.16';"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "# be as strict and verbose as possible"
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "# modules that we need"
NSQ_SOURCE_LINE 00000010 "use List::Util qw( first );"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "# persona and semaphore to indicate @INC watcher is installed for this process"
NSQ_SOURCE_LINE 00000013 "my $process_persona;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "# regular expression to check"
NSQ_SOURCE_LINE 00000016 "my $all;"
NSQ_SOURCE_LINE 00000017 "my @only_for;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "# are we debugging?"
NSQ_SOURCE_LINE 00000020 "BEGIN {"
NSQ_SOURCE_LINE 00000021 "    my $debug= $ENV{DEBUG} || 0;"
NSQ_SOURCE_LINE 00000022 "    $debug= 0 if $debug !~ m#^[0-9]+$#; ## only numeric constants"
NSQ_SOURCE_LINE 00000023 "    eval \"sub DEBUG () { $debug }\";"
NSQ_SOURCE_LINE 00000024 "}    #BEGIN"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "# log pipe if we're debugging"
NSQ_SOURCE_LINE 00000027 "BEGIN {"
NSQ_SOURCE_LINE 00000028 "    *TELL= DEBUG"
NSQ_SOURCE_LINE 00000029 "       ? sub {"
NSQ_SOURCE_LINE 00000030 "             my $format = shift() . \"\\n\";"
NSQ_SOURCE_LINE 00000031 "             printf STDERR $format, @_;"
NSQ_SOURCE_LINE 00000032 "         }"
NSQ_SOURCE_LINE 00000033 "       : sub { };"
NSQ_SOURCE_LINE 00000034 "}    #BEGIN"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "# satisfy -require-"
NSQ_SOURCE_LINE 00000037 "1;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "#-------------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000040 "#"
NSQ_SOURCE_LINE 00000041 "# Class methods"
NSQ_SOURCE_LINE 00000042 "#"
NSQ_SOURCE_LINE 00000043 "#-------------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000044 "# path2source"
NSQ_SOURCE_LINE 00000045 "#"
NSQ_SOURCE_LINE 00000046 "# Convert a given handle to source code for a given persona"
NSQ_SOURCE_LINE 00000047 "#"
NSQ_SOURCE_LINE 00000048 "#  IN: 1 class (ignored)"
NSQ_SOURCE_LINE 00000049 "#      2 path"
NSQ_SOURCE_LINE 00000050 "#      3 persona to parse for (default: current)"
NSQ_SOURCE_LINE 00000051 "# OUT: 1 scalar reference to source code or undef"
NSQ_SOURCE_LINE 00000052 "#      2 number of lines skipped (optional)"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub path2source {"
NSQ_SOURCE_LINE 00000055 "    my ( undef, $path, $persona )= @_;"
NSQ_SOURCE_LINE 00000056 "    $persona= $process_persona if !defined $persona;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    # could not open file, let the outside handle this"
NSQ_SOURCE_LINE 00000059 "    open( my $handle, '<', $path ) or return;"
NSQ_SOURCE_LINE 00000060 "    TELL 'Parsing %s', $path if DEBUG;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    # no persona, so we don't need to do any parsing at all"
NSQ_SOURCE_LINE 00000063 "    if ( !$persona ) {"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "        # enable slurp mode"
NSQ_SOURCE_LINE 00000066 "        local $/;"
NSQ_SOURCE_LINE 00000067 "        my $source= readline $handle;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "        # we're done"
NSQ_SOURCE_LINE 00000070 "        return wantarray ? ( \\$source, 0 ) : \\$source;"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    # initializations"
NSQ_SOURCE_LINE 00000074 "    my $done;"
NSQ_SOURCE_LINE 00000075 "    my $skipped= 0;"
NSQ_SOURCE_LINE 00000076 "    my $active=  1;"
NSQ_SOURCE_LINE 00000077 "    my $line_nr= 0;"
NSQ_SOURCE_LINE 00000078 "    my $source=  '';"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "    # until we reach end of file"
NSQ_SOURCE_LINE 00000081 "  LINE:"
NSQ_SOURCE_LINE 00000082 "    while (1) {"
NSQ_SOURCE_LINE 00000083 "        my $line= readline $handle;"
NSQ_SOURCE_LINE 00000084 "        last LINE if !defined $line;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "        # seen __END__ or __DATA__, no further looking needed here"
NSQ_SOURCE_LINE 00000087 "        if ($done) {"
NSQ_SOURCE_LINE 00000088 "            $source .= $line;"
NSQ_SOURCE_LINE 00000089 "            next LINE;"
NSQ_SOURCE_LINE 00000090 "        }"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "        # reached the end of logical code, continue without further looking"
NSQ_SOURCE_LINE 00000093 "        elsif ( $line =~ m#^__(?:DATA|END)__$# ) {  ## syn hilite"
NSQ_SOURCE_LINE 00000094 "            $done= 1;"
NSQ_SOURCE_LINE 00000095 "            $source .= $line;"
NSQ_SOURCE_LINE 00000096 "            next LINE;"
NSQ_SOURCE_LINE 00000097 "        }"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "        # we've seen a line and want to remember that"
NSQ_SOURCE_LINE 00000100 "        $line_nr++;"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "        # code for new persona?"
NSQ_SOURCE_LINE 00000103 "        if ( $line =~ m/^#PERSONA\\s*(.*)/ ) {"
NSQ_SOURCE_LINE 00000104 "            my $rest= $1;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "            # all personas"
NSQ_SOURCE_LINE 00000107 "            if ( !$rest ) {"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "                # switching from inactive persona to all"
NSQ_SOURCE_LINE 00000110 "                if ( !$active ) {"
NSQ_SOURCE_LINE 00000111 "                    $active= 1;"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "                    # make sure errors / stack traces have right line info"
NSQ_SOURCE_LINE 00000114 "                    $source .= sprintf \"#line %d %s (all personas)\\n\","
NSQ_SOURCE_LINE 00000115 "                      $line_nr + 1, $path;"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "                    # don't bother adding the line with #PERSONA"
NSQ_SOURCE_LINE 00000118 "                    next LINE;"
NSQ_SOURCE_LINE 00000119 "                }"
NSQ_SOURCE_LINE 00000120 "            }"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "            # we have an expression"
NSQ_SOURCE_LINE 00000123 "            else {"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "                # huh?"
NSQ_SOURCE_LINE 00000126 "                die \"Found illegal characters in PERSONA specification:\\n$rest\""
NSQ_SOURCE_LINE 00000127 "                  if $rest =~ m#[^\\w\\s\\(\\)\\|!]#;"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "                # change simple list into expression"
NSQ_SOURCE_LINE 00000130 "                1 while $rest =~ s#(?<!\\!)(\\w+)\\s+(\\w+)#$1 || $2#;"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "                # create evallable expression"
NSQ_SOURCE_LINE 00000133 "                my %value= ( $persona => 1 );"
NSQ_SOURCE_LINE 00000134 "                $rest =~ s#(\\w+)# $value{$1} || 0 #ge;"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "                # evaluate expression"
NSQ_SOURCE_LINE 00000137 "                my $ok= eval $rest;"
NSQ_SOURCE_LINE 00000138 "                die \"Error in evaluation persona specification:\\n'$rest'\\n$@\""
NSQ_SOURCE_LINE 00000139 "                  if $@;"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "                # stop copying code for now"
NSQ_SOURCE_LINE 00000142 "                if ( !$ok ) {"
NSQ_SOURCE_LINE 00000143 "                    $active= undef;"
NSQ_SOURCE_LINE 00000144 "                }"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "                # switching from inactive persona to all"
NSQ_SOURCE_LINE 00000147 "                elsif ( !$active ) {"
NSQ_SOURCE_LINE 00000148 "                    $active= 1;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "                    # make sure errors / stack traces have right line info"
NSQ_SOURCE_LINE 00000151 "                    $source .="
NSQ_SOURCE_LINE 00000152 "                      sprintf \"#line %d %s (allowed by persona '%s')\\n\","
NSQ_SOURCE_LINE 00000153 "                      $line_nr + 1, $path, $persona;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "                    # don't bother adding the line with #PERSONA"
NSQ_SOURCE_LINE 00000156 "                    next LINE;"
NSQ_SOURCE_LINE 00000157 "                }"
NSQ_SOURCE_LINE 00000158 "            }"
NSQ_SOURCE_LINE 00000159 "        }"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "        # we're not doing this line"
NSQ_SOURCE_LINE 00000162 "        $skipped++, next LINE if !$active;"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "        # new package, make sure it knows about PERSONA if it doesn't yet"
NSQ_SOURCE_LINE 00000165 "        if ( $line =~ m#^\\s*package\\s+([\\w:]+)\\s*;# ) {"
NSQ_SOURCE_LINE 00000166 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000167 "            my $sub= $1 . '::PERSONA';"
NSQ_SOURCE_LINE 00000168 "            *{$sub}= \\&main::PERSONA if !exists &$sub;"
NSQ_SOURCE_LINE 00000169 "        }"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "        # we'll do this line"
NSQ_SOURCE_LINE 00000172 "        $source .= $line;"
NSQ_SOURCE_LINE 00000173 "    }"
NSQ_SOURCE_LINE 00000174 "    # show source if *really* debugging"
NSQ_SOURCE_LINE 00000175 "    TELL $source if DEBUG > 2;"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    return wantarray ? ( \\$source, $skipped ) : \\$source;"
NSQ_SOURCE_LINE 00000178 "} #path2source"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "#-------------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000181 "#"
NSQ_SOURCE_LINE 00000182 "# Standard Perl features"
NSQ_SOURCE_LINE 00000183 "#"
NSQ_SOURCE_LINE 00000184 "#-------------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000185 "# import"
NSQ_SOURCE_LINE 00000186 "#"
NSQ_SOURCE_LINE 00000187 "#  IN: 1 class (ignored)"
NSQ_SOURCE_LINE 00000188 "#      2 .. N attributes"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "sub import {"
NSQ_SOURCE_LINE 00000191 "    my ( undef, @attr )= @_;"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    # assume we want to set persona if only one parameter"
NSQ_SOURCE_LINE 00000194 "    unshift @attr, 'persona' if @attr == 1;"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "    # fetch name's name"
NSQ_SOURCE_LINE 00000197 "    my $name= $ENV{ENV_PERSONA} || 'PERSONA';"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "    # fetch parameters we know"
NSQ_SOURCE_LINE 00000200 "    my @only_for_new;"
NSQ_SOURCE_LINE 00000201 "    my @huh;"
NSQ_SOURCE_LINE 00000202 "    while ( my ( $key, $value ) = splice @attr, 0, 2 ) {"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "        # setting module specification "
NSQ_SOURCE_LINE 00000205 "        if ( $key eq 'only_for' ) {"
NSQ_SOURCE_LINE 00000206 "            push @only_for_new, $value;"
NSQ_SOURCE_LINE 00000207 "        }"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "        # setting persona"
NSQ_SOURCE_LINE 00000210 "        elsif ( $key eq 'persona' ) {"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "            # huh?"
NSQ_SOURCE_LINE 00000213 "            die \"Already have '$process_persona' as persona, \""
NSQ_SOURCE_LINE 00000214 "              . \"cannot specify '$value' now\""
NSQ_SOURCE_LINE 00000215 "              if defined $process_persona and $value ne $process_persona;"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "            $ENV{$name}= $value;"
NSQ_SOURCE_LINE 00000218 "        }"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "        # don't know what to do with this"
NSQ_SOURCE_LINE 00000221 "        else {"
NSQ_SOURCE_LINE 00000222 "            push @huh, $key;"
NSQ_SOURCE_LINE 00000223 "        }"
NSQ_SOURCE_LINE 00000224 "    }"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "    # find persona we need to work for"
NSQ_SOURCE_LINE 00000227 "    if ( !defined $process_persona ) {"
NSQ_SOURCE_LINE 00000228 "        $process_persona= $ENV{$name};"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "        # too bad, we don't have a persona"
NSQ_SOURCE_LINE 00000231 "        $process_persona= '' if !defined $process_persona;"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "        # force some sanity"
NSQ_SOURCE_LINE 00000234 "        die \"Persona may only contain alphanumeric characters,\""
NSQ_SOURCE_LINE 00000235 "          . \" e.g. '$process_persona'\""
NSQ_SOURCE_LINE 00000236 "          if $process_persona =~ s#\\W##sg;"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "        # create constant in main (for easy access later)"
NSQ_SOURCE_LINE 00000239 "        die $@ if !eval \"sub main::PERSONA () { '$process_persona' }; 1\";"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "        # we have a persona, great!"
NSQ_SOURCE_LINE 00000242 "        if ($process_persona) {"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "            # install handler if we have a persona"
NSQ_SOURCE_LINE 00000245 "            unshift @INC, \\&_inc_handler;"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "            # we're being called in a script"
NSQ_SOURCE_LINE 00000248 "            if ( !( ()= caller(3) )                # only 3 levels below us"
NSQ_SOURCE_LINE 00000249 "                 and ( (caller(0))[1] ne '-e' )    # not a one liner"
NSQ_SOURCE_LINE 00000250 "                 and ( (caller(2))[3] eq '(eval)'  # but an eval at lowest level"
NSQ_SOURCE_LINE 00000251 "               ) ) {"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "                # make sure we will process this file"
NSQ_SOURCE_LINE 00000254 "                unshift @only_for, qr#^$0$#;  ## syn hilite"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "                # do the script, but through the @INC handler"
NSQ_SOURCE_LINE 00000257 "                TELL 'Recursively calling script for \"%s\"', $process_persona"
NSQ_SOURCE_LINE 00000258 "                  if DEBUG;"
NSQ_SOURCE_LINE 00000259 "                do $0;"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "                # we're done, nothing left to do at this level"
NSQ_SOURCE_LINE 00000262 "                exit;"
NSQ_SOURCE_LINE 00000263 "            }"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "            TELL 'Interpreting source code as \"%s\"', $process_persona if DEBUG;"
NSQ_SOURCE_LINE 00000266 "        }"
NSQ_SOURCE_LINE 00000267 "    }"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "    # extra parameters"
NSQ_SOURCE_LINE 00000270 "    die \"Don't know what to do with @{[ sort @huh ]}\" if @huh;"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "    # we have some kind of specification which modules to check"
NSQ_SOURCE_LINE 00000273 "    if (@only_for_new) {"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "        # normalize all new settings"
NSQ_SOURCE_LINE 00000276 "      ONLY_FOR:"
NSQ_SOURCE_LINE 00000277 "        foreach my $only_for (@only_for_new) {"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "            # need to check what we have"
NSQ_SOURCE_LINE 00000280 "            if ( my $ref= ref $only_for ) {"
NSQ_SOURCE_LINE 00000281 "                die \"Can only handle references of type '$ref'\""
NSQ_SOURCE_LINE 00000282 "                  if $ref ne 'Regexp';"
NSQ_SOURCE_LINE 00000283 "    "
NSQ_SOURCE_LINE 00000284 "                # it's ok"
NSQ_SOURCE_LINE 00000285 "                push @only_for, $only_for;"
NSQ_SOURCE_LINE 00000286 "            }"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "            # do all and everything"
NSQ_SOURCE_LINE 00000289 "            elsif ( $only_for eq '*' ) {"
NSQ_SOURCE_LINE 00000290 "                $all= 1;"
NSQ_SOURCE_LINE 00000291 "                @only_for= @only_for_new= ();"
NSQ_SOURCE_LINE 00000292 "                TELL \"Look for personas in all files\" if DEBUG;"
NSQ_SOURCE_LINE 00000293 "                last ONLY_FOR;"
NSQ_SOURCE_LINE 00000294 "            }"
NSQ_SOURCE_LINE 00000295 "    "
NSQ_SOURCE_LINE 00000296 "            # just a string, make it a regexp"
NSQ_SOURCE_LINE 00000297 "            else {"
NSQ_SOURCE_LINE 00000298 "                push @only_for, qr#^$only_for#;"
NSQ_SOURCE_LINE 00000299 "            }"
NSQ_SOURCE_LINE 00000300 "        }"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "        TELL \"Added regular expression for matching file names:\\n  %s\","
NSQ_SOURCE_LINE 00000303 "          join( \"\\n  \", @only_for[ -@only_for_new .. $#only_for ] ),"
NSQ_SOURCE_LINE 00000304 "          if DEBUG and @only_for_new;"
NSQ_SOURCE_LINE 00000305 "    }"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "    # export constant to the caller if not done so already"
NSQ_SOURCE_LINE 00000308 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000309 "    my $sub= caller() . '::PERSONA';"
NSQ_SOURCE_LINE 00000310 "    *{$sub}= \\&main::PERSONA if !exists &$sub;"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "    return;"
NSQ_SOURCE_LINE 00000313 "} #import"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "#-------------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000316 "#"
NSQ_SOURCE_LINE 00000317 "# Internal subroutines"
NSQ_SOURCE_LINE 00000318 "#"
NSQ_SOURCE_LINE 00000319 "#-------------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000320 "# _inc_handler"
NSQ_SOURCE_LINE 00000321 "#"
NSQ_SOURCE_LINE 00000322 "#  IN: 1 code reference to this sub"
NSQ_SOURCE_LINE 00000323 "#      2 file to look for"
NSQ_SOURCE_LINE 00000324 "# OUT: 1 handle to read source from"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "sub _inc_handler {"
NSQ_SOURCE_LINE 00000327 "    my ( $self, $file )= @_;"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "    # shouldn't handle this file, let require handle it (again)"
NSQ_SOURCE_LINE 00000330 "    if ( !$all and !first { $file =~ m#$_# } @only_for ) {"
NSQ_SOURCE_LINE 00000331 "        TELL 'Not handling %s', $file if DEBUG > 1;"
NSQ_SOURCE_LINE 00000332 "        return undef;"
NSQ_SOURCE_LINE 00000333 "    }"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "    # can't find ourselves?"
NSQ_SOURCE_LINE 00000336 "    my $first= first { $INC[$_] eq $self } 0 .. $#INC;"
NSQ_SOURCE_LINE 00000337 "    die \"Could not find INC handler in @INC\" if !defined $first;"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "    # could not find file, let require handle it (again)"
NSQ_SOURCE_LINE 00000340 "    my $path= first { -e } map { \"$INC[$_]/$file\" } $first + 1 .. $#INC;"
NSQ_SOURCE_LINE 00000341 "    if ( !$path ) {"
NSQ_SOURCE_LINE 00000342 "        TELL 'Could not find %s', $file if DEBUG > 1;"
NSQ_SOURCE_LINE 00000343 "        return undef;"
NSQ_SOURCE_LINE 00000344 "    }"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "    # parse the source"
NSQ_SOURCE_LINE 00000347 "    my ( $source, $skipped )= __PACKAGE__->path2source($path);"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "    # could not open file, or nothing skipped, let -require- handle it"
NSQ_SOURCE_LINE 00000350 "    return undef if !$source or !$skipped;"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "    # set %INC correctly"
NSQ_SOURCE_LINE 00000353 "    $path =~ s#^\\./##; # normalize just as perl does"
NSQ_SOURCE_LINE 00000354 "    $INC{$file}="
NSQ_SOURCE_LINE 00000355 "      \"$path (skipped $skipped lines for persona '$process_persona')\";"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "    # make sure that __FILE__ will be correct as well"
NSQ_SOURCE_LINE 00000358 "    $$source= \"#line 1 $path\\n$$source\";"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "    # convert source to handle, so require can handle it"
NSQ_SOURCE_LINE 00000361 "    open( my $require, '<', $source )"
NSQ_SOURCE_LINE 00000362 "      or die \"Could not open in-memory source for reading: $!\";"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "    return $require;"
NSQ_SOURCE_LINE 00000365 "}    #_inc_handler"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "#-------------------------------------------------------------------------------"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "__END__"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=head1 NAME"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "persona - control which code will be loaded for an execution context"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "  $ PERSONA=cron perl foo.pl"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "  foo.pl"
NSQ_SOURCE_LINE 00000380 "  ================="
NSQ_SOURCE_LINE 00000381 "  use persona only_for => '*';  # all modules, maybe regex"
NSQ_SOURCE_LINE 00000382 "  use Foo;"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "  Foo.pm"
NSQ_SOURCE_LINE 00000385 "  ================="
NSQ_SOURCE_LINE 00000386 "  package Foo;"
NSQ_SOURCE_LINE 00000387 "  # code to be compiled always"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "  #PERSONA cron || app || book"
NSQ_SOURCE_LINE 00000390 "  # code to be compiled only for the \"cron\", \"app\" and \"book\" personas"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "  #PERSONA"
NSQ_SOURCE_LINE 00000393 "  # code to be compiled always"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "  #PERSONA !cron"
NSQ_SOURCE_LINE 00000396 "  # code to be compiled for all personas except \"cron\""
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "  #PERSONA !( app || book )"
NSQ_SOURCE_LINE 00000399 "  # code to be compiled for all personas except \"app\" and \"book\""
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "  my $limit = PERSONA eq 'app' ? 100 : 10; # code using the constant"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=head1 VERSION"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "This documentation describes version 0.16."
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "This module was born out of the need to be able to easily specify which"
NSQ_SOURCE_LINE 00000410 "subroutines of a module should be available (as in \"compiled\") in different"
NSQ_SOURCE_LINE 00000411 "sets of mod_perl environments (e.g. the visitors front end web servers, or"
NSQ_SOURCE_LINE 00000412 "the personnel's back-office web servers).  This both from a memory, database"
NSQ_SOURCE_LINE 00000413 "and CPU usage point of view, as well as from the viewpoint of security."
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "This is most useful when using a database abstraction layer such as"
NSQ_SOURCE_LINE 00000416 "L<Class::DBI> or L<DBIx::Class>, where all of the code pertaining to an"
NSQ_SOURCE_LINE 00000417 "object is located in one file, while only parts of the code are actually"
NSQ_SOURCE_LINE 00000418 "needed (or wanted) on specific execution contexts."
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "=head1 OVERVIEW"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "By specifying an environment variable, by default C<PERSONA>, it is possible"
NSQ_SOURCE_LINE 00000423 "to indicate the persona for which the source code should be compiled.  Any"
NSQ_SOURCE_LINE 00000424 "modules that are indicated to support persona dependent code will then be"
NSQ_SOURCE_LINE 00000425 "checked for existence of persona conditional markers, and any code that is"
NSQ_SOURCE_LINE 00000426 "after a persona marker that does not match the currently selected persona,"
NSQ_SOURCE_LINE 00000427 "will be discarded during compilation."
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "Most likely, not all modules that you load need to be checked for persona"
NSQ_SOURCE_LINE 00000430 "specific code.  Therefor you must indicate which modules you want this check"
NSQ_SOURCE_LINE 00000431 "to be performed for.  This can be done with the C<only_for> parameter when"
NSQ_SOURCE_LINE 00000432 "loading the C<persona> module:"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 " use persona only_for => 'Foo';"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "will check all files that start with C<Foo>, such as:"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "  Foo.pm"
NSQ_SOURCE_LINE 00000439 "  FooBar.pm"
NSQ_SOURCE_LINE 00000440 "  Foo/Bar.pm"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "but not:"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "  Bar.pm"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "You can also specify a regular expression that way:"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 " use persona only_for => qr/^(?:Foo|Bar)\\.pm$/;"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "will only check the C<Foo.pm> and C<Bar.pm> files.  Usually the modules of"
NSQ_SOURCE_LINE 00000451 "a certain context that you want checked, share a common prefix.  It is then"
NSQ_SOURCE_LINE 00000452 "usually easier to specify the setting on the command line:"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 " $ PERSONA=cron perl -Mpersona=only_for,Foo script.pl"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "would execute the script C<script.pl> for the persona C<cron> and have all"
NSQ_SOURCE_LINE 00000457 "modules that start with C<Foo> checked for persona dependent code.  Only code"
NSQ_SOURCE_LINE 00000458 "that is to be included for all personas, or specifically for the C<cron>"
NSQ_SOURCE_LINE 00000459 "persona, will be compiled."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "Suppose we want to have a method C<override_access> available only for the"
NSQ_SOURCE_LINE 00000462 "C<backoffice> persona.  This can be done this way:"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 " #PERSONA backoffice"
NSQ_SOURCE_LINE 00000465 " sub override_access { # only for the back office persona"
NSQ_SOURCE_LINE 00000466 "     # code..."
NSQ_SOURCE_LINE 00000467 " }"
NSQ_SOURCE_LINE 00000468 " #PERSONA"
NSQ_SOURCE_LINE 00000469 " sub has_access {      # for all personas"
NSQ_SOURCE_LINE 00000470 "     # code..."
NSQ_SOURCE_LINE 00000471 " }"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "It is also possible to have code compiled for all personas B<except> a specific"
NSQ_SOURCE_LINE 00000474 "one:"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 " #PERSONA !cron"
NSQ_SOURCE_LINE 00000477 " sub not_for_cron {"
NSQ_SOURCE_LINE 00000478 "     # code..."
NSQ_SOURCE_LINE 00000479 " }"
NSQ_SOURCE_LINE 00000480 " #PERSONA"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "would make the subroutine C<not_for_cron> available for personas B<except>"
NSQ_SOURCE_LINE 00000483 "C<cron>.  It is also possible to have code compiled for a set of personas:"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 " #PERSONA cron || backoffice"
NSQ_SOURCE_LINE 00000486 " sub for_cron_and_backoffice {"
NSQ_SOURCE_LINE 00000487 "     # code..."
NSQ_SOURCE_LINE 00000488 " }"
NSQ_SOURCE_LINE 00000489 " #PERSONA"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "would make the subroutine C<for_cron_and_backoffice> available for the personas"
NSQ_SOURCE_LINE 00000492 "C<cron> and C<backoffice>."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "Or it is possible to have code compiled for all personas B<except> for a"
NSQ_SOURCE_LINE 00000495 "set of personas:"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 " #PERSONA !( app || book )"
NSQ_SOURCE_LINE 00000498 " sub not_for_app_or_book {"
NSQ_SOURCE_LINE 00000499 "     # code..."
NSQ_SOURCE_LINE 00000500 " }"
NSQ_SOURCE_LINE 00000501 "would make the subroutine C<not_for_app_or_book> available for all personas"
NSQ_SOURCE_LINE 00000502 "B<except> C<app> and C<book>."
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "Basically any valid expression consisting of C< \\\\w \\\\s ( ) ! || > is allowed:"
NSQ_SOURCE_LINE 00000505 "if that expression yields a true value, then that code will be compiled."
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "If you're lazy, and you don't care about any overhead while compiling code,"
NSQ_SOURCE_LINE 00000508 "you can indicate that you want B<all> modules checked for PERSONA specific"
NSQ_SOURCE_LINE 00000509 "code by specifying C<'*'> as the indication of which files should be checked."
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 " use persona only_for => '*';"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "If you want to specify multiple conditions, you can specify C<only_for> more"
NSQ_SOURCE_LINE 00000514 "than once:"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 " use persona only_for => 'Foo', only_for => 'Bar';"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "To facilitate more complex persona dependencies, all namespaces seen by this"
NSQ_SOURCE_LINE 00000519 "module automatically have the constant PERSONA imported into it.  This allows"
NSQ_SOURCE_LINE 00000520 "the constant to be used in actual code (which will then be optimized away by"
NSQ_SOURCE_LINE 00000521 "the Perl compiler so that the code that shouldn't be compiled for that persona,"
NSQ_SOURCE_LINE 00000522 "really isn't available for execution in the end)."
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "If you want to make sure that the use of the C<PERSONA> constant in a file"
NSQ_SOURCE_LINE 00000525 "will not break code when using L<strict> (which you B<should>!), you can add:"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "  use strict;"
NSQ_SOURCE_LINE 00000528 "  use persona;  # compilation error without this"
NSQ_SOURCE_LINE 00000529 "  print \"Running code for persona \" . PERSONA . \"\\n\""
NSQ_SOURCE_LINE 00000530 "    if PERSONA;"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "in that file.  That will export the PERSONA constant, even when it is not"
NSQ_SOURCE_LINE 00000533 "set.  Another example from L<Class::DBI> / L<DBIx::Class>::"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "  __PACKAGE__->columns( All => ( PERSONA eq 'backoffice' ? @all : @subset ) );"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "which will only use all columns when executing as the backoffice persona."
NSQ_SOURCE_LINE 00000538 "Otherwise only a subset of columns will be available."
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "=head1 SPECIFYING PERSONA WITHOUT ENVIRONMENT VARIABLES"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "In order to be able to easily support operating systems that have shells that"
NSQ_SOURCE_LINE 00000543 "do not support easy setting of environment variables on the command line, you"
NSQ_SOURCE_LINE 00000544 "can also specify the persona from the command line while loading this module:"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 " $ perl -Mpersona=cron bar.pl"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "will run set the persona to \"cron\".  This can also be combined with other"
NSQ_SOURCE_LINE 00000549 "parameters, such as:"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 " $ perl -Mpersona=only_for,*,persona,cron bar.pl"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "would process all files loaded for the C<cron> persona.  Alternately, the same"
NSQ_SOURCE_LINE 00000554 "is possible in source:"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 " use persona 'cron';"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "would select the C<cron> persona, but only if no other persona was selected"
NSQ_SOURCE_LINE 00000559 "before."
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "The test-suite contains some examples.  More to be added as time permits."
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "=head1 THEORY OF OPERATION"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "When the C<import> class method of C<persona> is first called, it looks at"
NSQ_SOURCE_LINE 00000568 "whether there is a C<ENV_PERSONA> environment variable is specified.  If it"
NSQ_SOURCE_LINE 00000569 "is, its value is used as the name of the environment variable to check for"
NSQ_SOURCE_LINE 00000570 "the value to be assigned to the persona.  If the C<ENV_PERSONA> environment"
NSQ_SOURCE_LINE 00000571 "variable is not found, C<PERSONA> will be assumed for the name to check."
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "If there is a non-empty persona value specified, then an C<@INC> handler is"
NSQ_SOURCE_LINE 00000574 "installed.  This handler is offered each file that is C<require>d or C<use>d"
NSQ_SOURCE_LINE 00000575 "from that moment onward.  If it is B<not> a file that should be checked for"
NSQ_SOURCE_LINE 00000576 "persona conditional code, it is given back to the normal C<require> handling."
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "If the import method determines it is being called from a script that is being"
NSQ_SOURCE_LINE 00000579 "called from the command line, it will C<do> the script and then C<exit>."
NSQ_SOURCE_LINE 00000580 "This causes the script itself be called with C<require>, and thus be handled"
NSQ_SOURCE_LINE 00000581 "by the C<@INC> handler we installed."
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "If it B<is> a file that should be checked, it is searched in the C<@INC>"
NSQ_SOURCE_LINE 00000584 "array.  If found, it is opened and all the lines that should be part of the"
NSQ_SOURCE_LINE 00000585 "code for the current persona, are added to an in-memory buffer.  Then a memory"
NSQ_SOURCE_LINE 00000586 "file handle is opened on that buffer and returned for normal C<require>"
NSQ_SOURCE_LINE 00000587 "handling.  To make sure that any errors or stack traces show the right line"
NSQ_SOURCE_LINE 00000588 "numbers, appropriate #line directives are added to the source being offered"
NSQ_SOURCE_LINE 00000589 "to the perl compilation process."
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "Please do:"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 " perldoc -f require"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "for more information about @INC handlers."
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "=head1 CLASS METHODS"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "Some class methods are provided as building bricks for more advanced usage of"
NSQ_SOURCE_LINE 00000600 "the persona functionality."
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "=head2 path2source"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 " my $source_ref = persona->path2source($path);  # current persona"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 " my ( $source_ref, $skipped ) = persona->path2source( $path, $persona );"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "Process the file given by the absolute path name for the given persona.  Assume"
NSQ_SOURCE_LINE 00000609 "the current process' persona if none given.  Returns a reference to the scalar"
NSQ_SOURCE_LINE 00000610 "containing the processed source, or undef if the file could not be opened."
NSQ_SOURCE_LINE 00000611 "Optionally also returns the number of lines in the original source that were"
NSQ_SOURCE_LINE 00000612 "skipped."
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "This functionality is specifically handy for deployment procedures where source"
NSQ_SOURCE_LINE 00000615 "files are pre-processed for execution in their intended context, rather than"
NSQ_SOURCE_LINE 00000616 "doing this at compilation time each time.  This removes the need for having"
NSQ_SOURCE_LINE 00000617 "this module installed in production environments and reduces possible problems"
NSQ_SOURCE_LINE 00000618 "with wrong persona settings in an execution context."
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "=head1 REQUIRED MODULES"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 " (none)"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "=head1 MODULE RATING"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "If you want to find out how this module is appreciated by other people, please"
NSQ_SOURCE_LINE 00000627 "check out this module's rating at L<http://cpanratings.perl.org/p/persona> (if"
NSQ_SOURCE_LINE 00000628 "there are any ratings for this module).  If you like this module, or otherwise"
NSQ_SOURCE_LINE 00000629 "would like to have your opinion known, you can add your rating of this module"
NSQ_SOURCE_LINE 00000630 "at L<http://cpanratings.perl.org/rate/?distribution=persona>."
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "=head1 ACKNOWLEDGEMENTS"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "Inspired by the function of L<load> and L<ifdef> modules from the same author."
NSQ_SOURCE_LINE 00000635 "And thanks to the pressure (perhaps unknowingly) exerted by the Amsterdam Perl"
NSQ_SOURCE_LINE 00000636 "Mongers."
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "=head2 %INC SETTING"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "Please note that if any lines were removed from the source, the path name in"
NSQ_SOURCE_LINE 00000643 "C<%INC> will be postfixed with the string:"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "  (skipped %d lines for persona '%s')"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "where the %d will be filled with the number of lines skipped, and the %s will"
NSQ_SOURCE_LINE 00000648 "be filled with the persona for which the lines were removed.  Also note that"
NSQ_SOURCE_LINE 00000649 "the __FILE__ compiler constant will B<not> have this information postfixed,"
NSQ_SOURCE_LINE 00000650 "as that is more or less expected to be just containing a path at all times."
NSQ_SOURCE_LINE 00000651 ""
