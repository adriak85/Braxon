NSQ_SOURCE_LINE 00000005 "package CPAN::Common::Index;"
NSQ_SOURCE_LINE 00000006 "# ABSTRACT: Common library for searching CPAN modules, authors and distributions"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.010';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Carp ();"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Class::Tiny;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000015 "# Document abstract methods"
NSQ_SOURCE_LINE 00000016 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "#pod =method search_packages (ABSTRACT)"
NSQ_SOURCE_LINE 00000019 "#pod"
NSQ_SOURCE_LINE 00000020 "#pod     $result = $index->search_packages( { package => \"Moose\" });"
NSQ_SOURCE_LINE 00000021 "#pod     @result = $index->search_packages( \\%advanced_query );"
NSQ_SOURCE_LINE 00000022 "#pod"
NSQ_SOURCE_LINE 00000023 "#pod Searches the index for a package such as listed in the CPAN"
NSQ_SOURCE_LINE 00000024 "#pod F<02packages.details.txt> file.  The query must be provided as a hash"
NSQ_SOURCE_LINE 00000025 "#pod reference.  Valid keys are"
NSQ_SOURCE_LINE 00000026 "#pod"
NSQ_SOURCE_LINE 00000027 "#pod =for :list"
NSQ_SOURCE_LINE 00000028 "#pod * package -- a string, regular expression or code reference"
NSQ_SOURCE_LINE 00000029 "#pod * version -- a version number or code reference"
NSQ_SOURCE_LINE 00000030 "#pod * dist -- a string, regular expression or code reference"
NSQ_SOURCE_LINE 00000031 "#pod"
NSQ_SOURCE_LINE 00000032 "#pod If the query term is a string or version number, the query will be for an exact"
NSQ_SOURCE_LINE 00000033 "#pod match.  If a code reference, the code will be called with the value of the"
NSQ_SOURCE_LINE 00000034 "#pod field for each potential match.  It should return true if it matches."
NSQ_SOURCE_LINE 00000035 "#pod"
NSQ_SOURCE_LINE 00000036 "#pod Not all backends will implement support for all fields or all types of queries."
NSQ_SOURCE_LINE 00000037 "#pod If it does not implement either, it should \"decline\" the query with an empty"
NSQ_SOURCE_LINE 00000038 "#pod return."
NSQ_SOURCE_LINE 00000039 "#pod"
NSQ_SOURCE_LINE 00000040 "#pod The return should be context aware, returning either a"
NSQ_SOURCE_LINE 00000041 "#pod single result or a list of results."
NSQ_SOURCE_LINE 00000042 "#pod"
NSQ_SOURCE_LINE 00000043 "#pod The result must be formed as follows:"
NSQ_SOURCE_LINE 00000044 "#pod"
NSQ_SOURCE_LINE 00000045 "#pod     {"
NSQ_SOURCE_LINE 00000046 "#pod       package => 'MOOSE',"
NSQ_SOURCE_LINE 00000047 "#pod       version => '2.0802',"
NSQ_SOURCE_LINE 00000048 "#pod       uri     => \"cpan:///distfile/ETHER/Moose-2.0802.tar.gz\""
NSQ_SOURCE_LINE 00000049 "#pod     }"
NSQ_SOURCE_LINE 00000050 "#pod"
NSQ_SOURCE_LINE 00000051 "#pod The C<uri> field should be a valid URI.  It may be a L<URI::cpan> or any other"
NSQ_SOURCE_LINE 00000052 "#pod URI.  (It is up to a client to do something useful with any given URI scheme.)"
NSQ_SOURCE_LINE 00000053 "#pod"
NSQ_SOURCE_LINE 00000054 "#pod =method search_authors (ABSTRACT)"
NSQ_SOURCE_LINE 00000055 "#pod"
NSQ_SOURCE_LINE 00000056 "#pod     $result = $index->search_authors( { id => \"DAGOLDEN\" });"
NSQ_SOURCE_LINE 00000057 "#pod     @result = $index->search_authors( \\%advanced_query );"
NSQ_SOURCE_LINE 00000058 "#pod"
NSQ_SOURCE_LINE 00000059 "#pod Searches the index for author data such as from the CPAN F<01mailrc.txt> file."
NSQ_SOURCE_LINE 00000060 "#pod The query must be provided as a hash reference.  Valid keys are"
NSQ_SOURCE_LINE 00000061 "#pod"
NSQ_SOURCE_LINE 00000062 "#pod =for :list"
NSQ_SOURCE_LINE 00000063 "#pod * id -- a string, regular expression or code reference"
NSQ_SOURCE_LINE 00000064 "#pod * fullname -- a string, regular expression or code reference"
NSQ_SOURCE_LINE 00000065 "#pod * email -- a string, regular expression or code reference"
NSQ_SOURCE_LINE 00000066 "#pod"
NSQ_SOURCE_LINE 00000067 "#pod If the query term is a string, the query will be for an exact match.  If a code"
NSQ_SOURCE_LINE 00000068 "#pod reference, the code will be called with the value of the field for each"
NSQ_SOURCE_LINE 00000069 "#pod potential match.  It should return true if it matches."
NSQ_SOURCE_LINE 00000070 "#pod"
NSQ_SOURCE_LINE 00000071 "#pod Not all backends will implement support for all fields or all types of queries."
NSQ_SOURCE_LINE 00000072 "#pod If it does not implement either, it should \"decline\" the query with an empty"
NSQ_SOURCE_LINE 00000073 "#pod return."
NSQ_SOURCE_LINE 00000074 "#pod"
NSQ_SOURCE_LINE 00000075 "#pod The return should be context aware, returning either a single result or a list"
NSQ_SOURCE_LINE 00000076 "#pod of results."
NSQ_SOURCE_LINE 00000077 "#pod"
NSQ_SOURCE_LINE 00000078 "#pod The result must be formed as follows:"
NSQ_SOURCE_LINE 00000079 "#pod"
NSQ_SOURCE_LINE 00000080 "#pod     {"
NSQ_SOURCE_LINE 00000081 "#pod         id       => 'DAGOLDEN',"
NSQ_SOURCE_LINE 00000082 "#pod         fullname => 'David Golden',"
NSQ_SOURCE_LINE 00000083 "#pod         email    => 'dagolden@cpan.org',"
NSQ_SOURCE_LINE 00000084 "#pod     }"
NSQ_SOURCE_LINE 00000085 "#pod"
NSQ_SOURCE_LINE 00000086 "#pod The C<email> field may not reflect an actual email address.  The 01mailrc file"
NSQ_SOURCE_LINE 00000087 "#pod on CPAN often shows \"CENSORED\" when email addresses are concealed."
NSQ_SOURCE_LINE 00000088 "#pod"
NSQ_SOURCE_LINE 00000089 "#pod =cut"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000092 "# stub methods"
NSQ_SOURCE_LINE 00000093 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "#pod =method index_age"
NSQ_SOURCE_LINE 00000096 "#pod"
NSQ_SOURCE_LINE 00000097 "#pod     $epoch = $index->index_age;"
NSQ_SOURCE_LINE 00000098 "#pod"
NSQ_SOURCE_LINE 00000099 "#pod Returns the modification time of the index in epoch seconds.  This may not make sense"
NSQ_SOURCE_LINE 00000100 "#pod for some backends.  By default it returns the current time."
NSQ_SOURCE_LINE 00000101 "#pod"
NSQ_SOURCE_LINE 00000102 "#pod =cut"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub index_age { time }"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "#pod =method refresh_index"
NSQ_SOURCE_LINE 00000107 "#pod"
NSQ_SOURCE_LINE 00000108 "#pod     $index->refresh_index;"
NSQ_SOURCE_LINE 00000109 "#pod"
NSQ_SOURCE_LINE 00000110 "#pod This ensures the index source is up to date.  For example, a remote"
NSQ_SOURCE_LINE 00000111 "#pod mirror file would be re-downloaded.  By default, it does nothing."
NSQ_SOURCE_LINE 00000112 "#pod"
NSQ_SOURCE_LINE 00000113 "#pod =cut"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "sub refresh_index { 1 }"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "#pod =method attributes"
NSQ_SOURCE_LINE 00000118 "#pod"
NSQ_SOURCE_LINE 00000119 "#pod Return attributes and default values as a hash reference.  By default"
NSQ_SOURCE_LINE 00000120 "#pod returns an empty hash reference."
NSQ_SOURCE_LINE 00000121 "#pod"
NSQ_SOURCE_LINE 00000122 "#pod =cut"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "sub attributes { {} }"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "#pod =method validate_attributes"
NSQ_SOURCE_LINE 00000127 "#pod"
NSQ_SOURCE_LINE 00000128 "#pod     $self->validate_attributes;"
NSQ_SOURCE_LINE 00000129 "#pod"
NSQ_SOURCE_LINE 00000130 "#pod This is called by the constructor to validate any arguments.  Subclasses"
NSQ_SOURCE_LINE 00000131 "#pod should override the default one to perform validation.  It should not be"
NSQ_SOURCE_LINE 00000132 "#pod called by application code.  By default, it does nothing."
NSQ_SOURCE_LINE 00000133 "#pod"
NSQ_SOURCE_LINE 00000134 "#pod =cut"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "sub validate_attributes { 1 }"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "1;"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "# vim: ts=4 sts=4 sw=4 et:"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "__END__"
NSQ_SOURCE_LINE 00000144 ""
