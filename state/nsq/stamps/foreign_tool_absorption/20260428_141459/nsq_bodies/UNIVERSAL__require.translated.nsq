STAMP_SYSTEM_ACTIVE true
BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package UNIVERSAL::require;"
NSQ_SOURCE_LINE 00000002 "$UNIVERSAL::require::VERSION = '0.19';"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "# We do this because UNIVERSAL.pm uses CORE::require().  We're going"
NSQ_SOURCE_LINE 00000005 "# to put our own require() into UNIVERSAL and that makes an ambiguity."
NSQ_SOURCE_LINE 00000006 "# So we load it up beforehand to avoid that."
NSQ_SOURCE_LINE 00000007 "BEGIN { require UNIVERSAL }"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "package UNIVERSAL;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use 5.006;"
NSQ_SOURCE_LINE 00000012 "use strict;"
NSQ_SOURCE_LINE 00000013 "use warnings;"
NSQ_SOURCE_LINE 00000014 "use Carp;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "# regexp for valid module name. Lifted from Module::Runtime"
NSQ_SOURCE_LINE 00000017 "my $module_name_rx = qr/[A-Z_a-z][0-9A-Z_a-z]*(?:::[0-9A-Z_a-z]+)*/;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "our $Level = 0;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "=pod"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "=head1 NAME"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "UNIVERSAL::require - require() modules from a variable [deprecated]"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "  # This only needs to be said once in your program."
NSQ_SOURCE_LINE 00000030 "  require UNIVERSAL::require;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "  # Same as \"require Some::Module\""
NSQ_SOURCE_LINE 00000033 "  my $module = 'Some::Module';"
NSQ_SOURCE_LINE 00000034 "  $module->require or die $@;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "  # Same as \"use Some::Module\""
NSQ_SOURCE_LINE 00000037 "  BEGIN { $module->use or die $@ }"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "Before using this module, you should look at the alternatives,"
NSQ_SOURCE_LINE 00000043 "some of which are listed in SEE ALSO below."
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "This module provides a safe mechanism for loading a module at runtime,"
NSQ_SOURCE_LINE 00000046 "when you have the name of the module in a variable."
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "If you've ever had to do this..."
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    eval \"require $module\";"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "to get around the bareword caveats on require(), this module is for"
NSQ_SOURCE_LINE 00000053 "you.  It creates a universal require() class method that will work"
NSQ_SOURCE_LINE 00000054 "with every Perl module and its secure.  So instead of doing some"
NSQ_SOURCE_LINE 00000055 "arcane eval() work, you can do this:"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    $module->require;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "It doesn't save you much typing, but it'll make a lot more sense to"
NSQ_SOURCE_LINE 00000060 "someone who's not a ninth level Perl acolyte."
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=head1 Methods"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=head3 require"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "  my $return_val = $module->require           or die $@;"
NSQ_SOURCE_LINE 00000067 "  my $return_val = $module->require($version) or die $@;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "This works exactly like Perl's require, except without the bareword"
NSQ_SOURCE_LINE 00000070 "restriction, and it doesn't die.  Since require() is placed in the"
NSQ_SOURCE_LINE 00000071 "UNIVERSAL namespace, it will work on B<any> module.  You just have to"
NSQ_SOURCE_LINE 00000072 "use UNIVERSAL::require somewhere in your code."
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "Should the module require fail, or not be a high enough $version, it"
NSQ_SOURCE_LINE 00000075 "will simply return false and B<not die>.  The error will be in"
NSQ_SOURCE_LINE 00000076 "$@ as well as $UNIVERSAL::require::ERROR."
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "    $module->require or die $@;"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=cut"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "sub require {"
NSQ_SOURCE_LINE 00000083 "    my($module, $want_version) = @_;"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    $UNIVERSAL::require::ERROR = '';"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    croak(\"UNIVERSAL::require() can only be run as a class method\")"
NSQ_SOURCE_LINE 00000088 "      if ref $module; "
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    croak(\"invalid module name '$module'\") if $module !~ /\\A$module_name_rx\\z/;"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    croak(\"UNIVERSAL::require() takes no or one arguments\") if @_ > 2;"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    my($call_package, $call_file, $call_line) = caller($Level);"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    # Load the module."
NSQ_SOURCE_LINE 00000097 "    my $file = $module . '.pm';"
NSQ_SOURCE_LINE 00000098 "    $file =~ s{::}{/}g;"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    # For performance reasons, check if its already been loaded.  This makes"
NSQ_SOURCE_LINE 00000101 "    # things about 4 times faster."
NSQ_SOURCE_LINE 00000102 "    # We use the eval { } to make sure $@ is not set. See RT #44444 for details"
NSQ_SOURCE_LINE 00000103 "    return eval { 1 } if $INC{$file};"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    my $return = eval qq{ "
NSQ_SOURCE_LINE 00000106 "#line $call_line \"$call_file\""
NSQ_SOURCE_LINE 00000107 "CORE::require(\\$file); "
NSQ_SOURCE_LINE 00000108 "};"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "    # Check for module load failure."
NSQ_SOURCE_LINE 00000111 "    if( !$return ) {"
NSQ_SOURCE_LINE 00000112 "        $UNIVERSAL::require::ERROR = $@;"
NSQ_SOURCE_LINE 00000113 "        return $return;"
NSQ_SOURCE_LINE 00000114 "    }"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    # Module version check."
NSQ_SOURCE_LINE 00000117 "    if( @_ == 2 ) {"
NSQ_SOURCE_LINE 00000118 "        eval qq{"
NSQ_SOURCE_LINE 00000119 "#line $call_line \"$call_file\""
NSQ_SOURCE_LINE 00000120 "\\$module->VERSION($want_version);"
NSQ_SOURCE_LINE 00000121 "1;"
NSQ_SOURCE_LINE 00000122 "}       or do {"
NSQ_SOURCE_LINE 00000123 "            $UNIVERSAL::require::ERROR = $@;"
NSQ_SOURCE_LINE 00000124 "            return 0;"
NSQ_SOURCE_LINE 00000125 "        };"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 "    return $return;"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=head3 use"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    my $require_return = $module->use           or die $@;"
NSQ_SOURCE_LINE 00000134 "    my $require_return = $module->use(@imports) or die $@;"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "Like C<UNIVERSAL::require>, this allows you to C<use> a $module without"
NSQ_SOURCE_LINE 00000137 "having to eval to work around the bareword requirement.  It returns the"
NSQ_SOURCE_LINE 00000138 "same as require."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "Should either the require or the import fail it will return false.  The"
NSQ_SOURCE_LINE 00000141 "error will be in $@."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "If possible, call this inside a BEGIN block to emulate a normal C<use>"
NSQ_SOURCE_LINE 00000144 "as closely as possible."
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    BEGIN { $module->use }"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "=cut"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "sub use {"
NSQ_SOURCE_LINE 00000151 "    my($module, @imports) = @_;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    local $Level = 1;"
NSQ_SOURCE_LINE 00000154 "    my $return = $module->require or return 0;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    my($call_package, $call_file, $call_line) = caller;"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    eval qq{"
NSQ_SOURCE_LINE 00000159 "package $call_package;"
NSQ_SOURCE_LINE 00000160 "#line $call_line \"$call_file\""
NSQ_SOURCE_LINE 00000161 "\\$module->import(\\@imports);"
NSQ_SOURCE_LINE 00000162 "1;"
NSQ_SOURCE_LINE 00000163 "}   or do {"
NSQ_SOURCE_LINE 00000164 "        $UNIVERSAL::require::ERROR = $@;"
NSQ_SOURCE_LINE 00000165 "        return 0;"
NSQ_SOURCE_LINE 00000166 "    };"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    return $return;"
NSQ_SOURCE_LINE 00000169 "}"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=head1 SECURITY NOTES"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "UNIVERSAL::require makes use of C<eval STRING>.  In previous versions"
NSQ_SOURCE_LINE 00000175 "of UNIVERSAL::require it was discovered that one could craft a class"
NSQ_SOURCE_LINE 00000176 "name which would result in code being executed.  This hole has been"
NSQ_SOURCE_LINE 00000177 "closed.  The only variables now exposed to C<eval STRING> are the"
NSQ_SOURCE_LINE 00000178 "caller's package, filename and line which are not tainted."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "UNIVERSAL::require is taint clean."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=head1 COPYRIGHT"
NSQ_SOURCE_LINE 00000184 ""
