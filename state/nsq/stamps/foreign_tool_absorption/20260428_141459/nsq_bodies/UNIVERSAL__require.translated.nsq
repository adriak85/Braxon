SOURCE_NAME UNIVERSAL::require
SOURCE_SHA256 cd9821fbb21f3952a890e7132ac27f94b0bb8264e002fa07e8d0a5a71d790003
RUNTIME_AUTHORITY nsq_substrate
FOREIGN_RUNTIME_ALLOWED false
NO_PARALLEL_RUNTIME true
