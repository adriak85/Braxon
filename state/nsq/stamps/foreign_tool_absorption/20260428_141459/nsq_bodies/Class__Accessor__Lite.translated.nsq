NSQ_SOURCE_LINE 00000001 "package Class::Accessor::Lite;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "our $VERSION = '0.08';"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "sub croak {require Carp; Carp::croak(@_)}"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "sub import {"
NSQ_SOURCE_LINE 00000010 "    shift;"
NSQ_SOURCE_LINE 00000011 "    my %args = @_;"
NSQ_SOURCE_LINE 00000012 "    my $pkg = caller(0);"
NSQ_SOURCE_LINE 00000013 "    my %key_ctor = ("
NSQ_SOURCE_LINE 00000014 "        rw => \\&_mk_accessors,"
NSQ_SOURCE_LINE 00000015 "        ro => \\&_mk_ro_accessors,"
NSQ_SOURCE_LINE 00000016 "        wo => \\&_mk_wo_accessors,"
NSQ_SOURCE_LINE 00000017 "    );"
NSQ_SOURCE_LINE 00000018 "    for my $key (sort keys %key_ctor) {"
NSQ_SOURCE_LINE 00000019 "        if (defined $args{$key}) {"
NSQ_SOURCE_LINE 00000020 "            croak(\"value of the '$key' parameter should be an arrayref\")"
NSQ_SOURCE_LINE 00000021 "                unless ref($args{$key}) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000022 "            $key_ctor{$key}->($pkg, @{$args{$key}});"
NSQ_SOURCE_LINE 00000023 "        }"
NSQ_SOURCE_LINE 00000024 "    }"
NSQ_SOURCE_LINE 00000025 "    _mk_new($pkg)"
NSQ_SOURCE_LINE 00000026 "        if $args{new};"
NSQ_SOURCE_LINE 00000027 "    1;"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "sub mk_new_and_accessors {"
NSQ_SOURCE_LINE 00000031 "    (undef, my @properties) = @_;"
NSQ_SOURCE_LINE 00000032 "    my $pkg = caller(0);"
NSQ_SOURCE_LINE 00000033 "    _mk_new($pkg);"
NSQ_SOURCE_LINE 00000034 "    _mk_accessors($pkg, @properties);"
NSQ_SOURCE_LINE 00000035 "}"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub mk_new {"
NSQ_SOURCE_LINE 00000038 "    my $pkg = caller(0);"
NSQ_SOURCE_LINE 00000039 "    _mk_new($pkg);"
NSQ_SOURCE_LINE 00000040 "}"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "sub mk_accessors {"
NSQ_SOURCE_LINE 00000043 "    (undef, my @properties) = @_;"
NSQ_SOURCE_LINE 00000044 "    my $pkg = caller(0);"
NSQ_SOURCE_LINE 00000045 "    _mk_accessors($pkg, @properties);"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub mk_ro_accessors {"
NSQ_SOURCE_LINE 00000049 "    (undef, my @properties) = @_;"
NSQ_SOURCE_LINE 00000050 "    my $pkg = caller(0);"
NSQ_SOURCE_LINE 00000051 "    _mk_ro_accessors($pkg, @properties);"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub mk_wo_accessors {"
NSQ_SOURCE_LINE 00000055 "    (undef, my @properties) = @_;"
NSQ_SOURCE_LINE 00000056 "    my $pkg = caller(0);"
NSQ_SOURCE_LINE 00000057 "    _mk_wo_accessors($pkg, @properties);"
NSQ_SOURCE_LINE 00000058 "}"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub _mk_new {"
NSQ_SOURCE_LINE 00000061 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000062 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000063 "    *{$pkg . '::new'} = __m_new($pkg);"
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "sub _mk_accessors {"
NSQ_SOURCE_LINE 00000067 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000068 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000069 "    for my $n (@_) {"
NSQ_SOURCE_LINE 00000070 "        *{$pkg . '::' . $n} = __m($n);"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub _mk_ro_accessors {"
NSQ_SOURCE_LINE 00000075 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000076 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000077 "    for my $n (@_) {"
NSQ_SOURCE_LINE 00000078 "        *{$pkg . '::' . $n} = __m_ro($pkg, $n);"
NSQ_SOURCE_LINE 00000079 "    }"
NSQ_SOURCE_LINE 00000080 "}"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "sub _mk_wo_accessors {"
NSQ_SOURCE_LINE 00000083 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000084 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000085 "    for my $n (@_) {"
NSQ_SOURCE_LINE 00000086 "        *{$pkg . '::' . $n} = __m_wo($pkg, $n);"
NSQ_SOURCE_LINE 00000087 "    }"
NSQ_SOURCE_LINE 00000088 "}"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "sub __m_new {"
NSQ_SOURCE_LINE 00000091 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000092 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000093 "    return sub {"
NSQ_SOURCE_LINE 00000094 "        my $klass = shift;"
NSQ_SOURCE_LINE 00000095 "        bless {"
NSQ_SOURCE_LINE 00000096 "            (@_ == 1 && ref($_[0]) eq 'HASH' ? %{$_[0]} : @_),"
NSQ_SOURCE_LINE 00000097 "        }, $klass;"
NSQ_SOURCE_LINE 00000098 "    };"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "sub __m {"
NSQ_SOURCE_LINE 00000102 "    my $n = shift;"
NSQ_SOURCE_LINE 00000103 "    sub {"
NSQ_SOURCE_LINE 00000104 "        return $_[0]->{$n} if @_ == 1;"
NSQ_SOURCE_LINE 00000105 "        return $_[0]->{$n} = $_[1] if @_ == 2;"
NSQ_SOURCE_LINE 00000106 "        shift->{$n} = \\@_;"
NSQ_SOURCE_LINE 00000107 "    };"
NSQ_SOURCE_LINE 00000108 "}"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "sub __m_ro {"
NSQ_SOURCE_LINE 00000111 "    my ($pkg, $n) = @_;"
NSQ_SOURCE_LINE 00000112 "    sub {"
NSQ_SOURCE_LINE 00000113 "        if (@_ == 1) {"
NSQ_SOURCE_LINE 00000114 "            return $_[0]->{$n} if @_ == 1;"
NSQ_SOURCE_LINE 00000115 "        } else {"
NSQ_SOURCE_LINE 00000116 "            my $caller = caller(0);"
NSQ_SOURCE_LINE 00000117 "            croak(\"'$caller' cannot access the value of '$n' on objects of class '$pkg'\");"
NSQ_SOURCE_LINE 00000118 "        }"
NSQ_SOURCE_LINE 00000119 "    };"
NSQ_SOURCE_LINE 00000120 "}"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "sub __m_wo {"
NSQ_SOURCE_LINE 00000123 "    my ($pkg, $n) = @_;"
NSQ_SOURCE_LINE 00000124 "    sub {"
NSQ_SOURCE_LINE 00000125 "        if (@_ == 1) {"
NSQ_SOURCE_LINE 00000126 "            my $caller = caller(0);"
NSQ_SOURCE_LINE 00000127 "            croak(\"'$caller' cannot alter the value of '$n' on objects of class '$pkg'\")"
NSQ_SOURCE_LINE 00000128 "        } else {"
NSQ_SOURCE_LINE 00000129 "            return $_[0]->{$n} = $_[1] if @_ == 2;"
NSQ_SOURCE_LINE 00000130 "            shift->{$n} = \\@_;"
NSQ_SOURCE_LINE 00000131 "        }"
NSQ_SOURCE_LINE 00000132 "    };"
NSQ_SOURCE_LINE 00000133 "}"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "1;"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "__END__"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=head1 NAME"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "Class::Accessor::Lite - a minimalistic variant of Class::Accessor"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    package MyPackage;"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    use Class::Accessor::Lite ("
NSQ_SOURCE_LINE 00000149 "        new => 1,"
NSQ_SOURCE_LINE 00000150 "        rw  => [ qw(foo bar) ],"
NSQ_SOURCE_LINE 00000151 "        ro  => [ qw(baz) ],"
NSQ_SOURCE_LINE 00000152 "        wo  => [ qw(hoge) ],"
NSQ_SOURCE_LINE 00000153 "    );"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "The module is a variant of C<Class::Accessor>.  It is fast and requires less typing, has no dependencies to other modules, and does not mess up the @ISA."
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=head1 THE USE STATEMENT"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "The use statement (i.e. the C<import> function) of the module takes a single hash as an argument that specifies the types and the names of the properties.  Recognises the following keys."
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=over 4"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=item new => $true_or_false"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "the default constructor is created if the value evaluates to true, otherwise nothing is done (the default behaviour)"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=item rw => \\@name_of_the_properties"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "creates a read / write accessor for the name of the properties passed through as an arrayref"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=item ro => \\@name_of_the_properties"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "creates a read-only accessor for the name of the properties passed through as an arrayref"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=item wo => \\@name_of_the_properties"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "creates a write-only accessor for the name of the properties passed through as an arrayref"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=back"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "For more detailed explanation read the following section describing the behaviour of each function that actually creates the accessors."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "As of version 0.04 the properties can be specified as the arguments to the C<use> statement (as can be seen in the SYNOPSIS) which is now the recommended way of using the module, but for compatibility the following functions are provided as well."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=head2 Class::Accessor::Lite->mk_accessors(@name_of_the_properties)"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "Creates an accessor in current package under the name specified by the arguments that access the properties (of a hashref) with the same name."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=head2 Class::Accessor::Lite->mk_ro_accessors(@name_of_the_properties)"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "Same as mk_accessors() except it will generate read-only accessors (i.e. true accessors).  If you attempt to set a value with these accessors it will throw an exception."
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "=head2 Class::Accessor::Lite->mk_wo_accessors(@name_of_the_properties)"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "Same as mk_accessors() except it will generate write-only accessors (i.e. mutators).  If you attempt to read a value with these accessors it will throw an exception."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=head2 Class::Accessor::Lite->mk_new()"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "Creates the C<new> function that accepts a hash or a hashref as the initial properties of the object."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=head2 Class::Accessor::Lite->mk_new_and_accessors(@name_of_the_properties)"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "DEPRECATED.  Use the new \"use Class::Accessor::Lite (...)\" style."
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=head1 FAQ"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=head2 Can I use C<Class::Accessor::Lite> in an inherited module?"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "Yes in most cases, when the class object in the super class is implemented using a hashref.  However you _should_ _not_ create the constructor for the inherited class by calling C<<Class::Accessor::Lite->new()>> or by C<<use Class::Accessor::Lite (new => 1)>>.  The only other thing that C<Class::Accessor::Lite> does is to set up the accessor functions for given property names through a blessed hashref."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "=head2 What happens when passing more than one arguments to the accessor?"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "When the accessor built by Class::Accessor::Lite is given more than one arguments, a reference to the arguments will be saved as an arrayref.  This behaviour might not be necessary but is implemented as is to maintain compatibility with L<Class::Accessor::Fast>."
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "    my @data = (1, 2, 3);"
NSQ_SOURCE_LINE 00000220 "    $obj->someproperty(@data);"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "    $obj->someproperty->[2]++; # $data[3] is incremented"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "In general, you should pass an arrayref to set an arrayref to a property."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "    my @data = (1, 2, 3);"
NSQ_SOURCE_LINE 00000227 "    $obj->someproperty([ @data ]); # save a copy using arrayref"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "    $obj->someproper->[2]++; # @data is not modified"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000232 ""
