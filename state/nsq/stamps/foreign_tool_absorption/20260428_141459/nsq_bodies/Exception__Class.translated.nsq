BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Exception::Class;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.008001;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '1.45';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Carp qw( croak );"
NSQ_SOURCE_LINE 00000011 "use Exception::Class::Base;"
NSQ_SOURCE_LINE 00000012 "use Scalar::Util qw( blessed reftype );"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our $BASE_EXC_CLASS;"
NSQ_SOURCE_LINE 00000015 "BEGIN { $BASE_EXC_CLASS ||= 'Exception::Class::Base'; }"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "our %CLASSES;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "sub import {"
NSQ_SOURCE_LINE 00000020 "    my $class = shift;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    ## no critic (Variables::ProhibitPackageVars)"
NSQ_SOURCE_LINE 00000023 "    local $Exception::Class::Caller = caller();"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    my %c;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    my %needs_parent;"
NSQ_SOURCE_LINE 00000028 "    while ( my $subclass = shift ) {"
NSQ_SOURCE_LINE 00000029 "        my $def = ref $_[0] ? shift : {};"
NSQ_SOURCE_LINE 00000030 "        $def->{isa}"
NSQ_SOURCE_LINE 00000031 "            = $def->{isa}"
NSQ_SOURCE_LINE 00000032 "            ? ( ref $def->{isa} ? $def->{isa} : [ $def->{isa} ] )"
NSQ_SOURCE_LINE 00000033 "            : [];"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "        $c{$subclass} = $def;"
NSQ_SOURCE_LINE 00000036 "    }"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    # We need to sort by length because if we check for keys in the"
NSQ_SOURCE_LINE 00000039 "    # Foo::Bar:: stash, this creates a \"Bar::\" key in the Foo:: stash!"
NSQ_SOURCE_LINE 00000040 "MAKE_CLASSES:"
NSQ_SOURCE_LINE 00000041 "    foreach my $subclass ( sort { length $a <=> length $b } keys %c ) {"
NSQ_SOURCE_LINE 00000042 "        my $def = $c{$subclass};"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "        # We already made this one."
NSQ_SOURCE_LINE 00000045 "        next if $CLASSES{$subclass};"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "        {"
NSQ_SOURCE_LINE 00000048 "            ## no critic (TestingAndDebugging::ProhibitNoStrict)"
NSQ_SOURCE_LINE 00000049 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000050 "            foreach my $parent ( @{ $def->{isa} } ) {"
NSQ_SOURCE_LINE 00000051 "                unless ( keys %{\"$parent\\::\"} ) {"
NSQ_SOURCE_LINE 00000052 "                    $needs_parent{$subclass} = {"
NSQ_SOURCE_LINE 00000053 "                        parents => $def->{isa},"
NSQ_SOURCE_LINE 00000054 "                        def     => $def"
NSQ_SOURCE_LINE 00000055 "                    };"
NSQ_SOURCE_LINE 00000056 "                    next MAKE_CLASSES;"
NSQ_SOURCE_LINE 00000057 "                }"
NSQ_SOURCE_LINE 00000058 "            }"
NSQ_SOURCE_LINE 00000059 "        }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "        $class->_make_subclass("
NSQ_SOURCE_LINE 00000062 "            subclass => $subclass,"
NSQ_SOURCE_LINE 00000063 "            def      => $def || {},"
NSQ_SOURCE_LINE 00000064 "        );"
NSQ_SOURCE_LINE 00000065 "    }"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "    foreach my $subclass ( keys %needs_parent ) {"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "        # This will be used to spot circular references."
NSQ_SOURCE_LINE 00000070 "        my %seen;"
NSQ_SOURCE_LINE 00000071 "        $class->_make_parents( \\%needs_parent, $subclass, \\%seen );"
NSQ_SOURCE_LINE 00000072 "    }"
NSQ_SOURCE_LINE 00000073 "}"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "sub _make_parents {"
NSQ_SOURCE_LINE 00000076 "    my $class    = shift;"
NSQ_SOURCE_LINE 00000077 "    my $needs    = shift;"
NSQ_SOURCE_LINE 00000078 "    my $subclass = shift;"
NSQ_SOURCE_LINE 00000079 "    my $seen     = shift;"
NSQ_SOURCE_LINE 00000080 "    my $child    = shift;    # Just for error messages."
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    ## no critic (TestingAndDebugging::ProhibitNoStrict, TestingAndDebugging::ProhibitProlongedStrictureOverride)"
NSQ_SOURCE_LINE 00000083 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    # What if someone makes a typo in specifying their 'isa' param?"
NSQ_SOURCE_LINE 00000086 "    # This should catch it. Either it's been made because it didn't"
NSQ_SOURCE_LINE 00000087 "    # have missing parents OR it's in our hash as needing a parent."
NSQ_SOURCE_LINE 00000088 "    # If neither of these is true then the _only_ place it is"
NSQ_SOURCE_LINE 00000089 "    # mentioned is in the 'isa' param for some other class, which is"
NSQ_SOURCE_LINE 00000090 "    # not a good enough reason to make a new class."
NSQ_SOURCE_LINE 00000091 "    die"
NSQ_SOURCE_LINE 00000092 "        \"Class $subclass appears to be a typo as it is only specified in the 'isa' param for $child\\n\""
NSQ_SOURCE_LINE 00000093 "        unless exists $needs->{$subclass}"
NSQ_SOURCE_LINE 00000094 "        || $CLASSES{$subclass}"
NSQ_SOURCE_LINE 00000095 "        || keys %{\"$subclass\\::\"};"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    foreach my $c ( @{ $needs->{$subclass}{parents} } ) {"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "        # It's been made"
NSQ_SOURCE_LINE 00000100 "        next if $CLASSES{$c} || keys %{\"$c\\::\"};"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "        die \"There appears to be some circularity involving $subclass\\n\""
NSQ_SOURCE_LINE 00000103 "            if $seen->{$subclass};"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "        $seen->{$subclass} = 1;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "        $class->_make_parents( $needs, $c, $seen, $subclass );"
NSQ_SOURCE_LINE 00000108 "    }"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "    return if $CLASSES{$subclass} || keys %{\"$subclass\\::\"};"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "    $class->_make_subclass("
NSQ_SOURCE_LINE 00000113 "        subclass => $subclass,"
NSQ_SOURCE_LINE 00000114 "        def      => $needs->{$subclass}{def}"
NSQ_SOURCE_LINE 00000115 "    );"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "sub _make_subclass {"
NSQ_SOURCE_LINE 00000119 "    my $class = shift;"
NSQ_SOURCE_LINE 00000120 "    my %p     = @_;"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    my $subclass = $p{subclass};"
NSQ_SOURCE_LINE 00000123 "    my $def      = $p{def};"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "    my $isa;"
NSQ_SOURCE_LINE 00000126 "    if ( $def->{isa} ) {"
NSQ_SOURCE_LINE 00000127 "        $isa = ref $def->{isa} ? join q{ }, @{ $def->{isa} } : $def->{isa};"
NSQ_SOURCE_LINE 00000128 "    }"
NSQ_SOURCE_LINE 00000129 "    $isa ||= $BASE_EXC_CLASS;"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    my $version_name = 'VERSION';"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    my $code = <<\"EOPERL\";"
NSQ_SOURCE_LINE 00000134 "package $subclass;"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "use base qw($isa);"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "our \\$$version_name = '1.1';"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "1;"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "EOPERL"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    if ( $def->{description} ) {"
NSQ_SOURCE_LINE 00000145 "        ( my $desc = $def->{description} ) =~ s/([\\\\\\'])/\\\\$1/g;"
NSQ_SOURCE_LINE 00000146 "        $code .= <<\"EOPERL\";"
NSQ_SOURCE_LINE 00000147 "sub description"
NSQ_SOURCE_LINE 00000148 "{"
NSQ_SOURCE_LINE 00000149 "    return '$desc';"
NSQ_SOURCE_LINE 00000150 "}"
NSQ_SOURCE_LINE 00000151 "EOPERL"
NSQ_SOURCE_LINE 00000152 "    }"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    my @fields;"
NSQ_SOURCE_LINE 00000155 "    if ( my $fields = $def->{fields} ) {"
NSQ_SOURCE_LINE 00000156 "        @fields"
NSQ_SOURCE_LINE 00000157 "            = ref $fields && reftype $fields eq 'ARRAY' ? @$fields : $fields;"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "        $code"
NSQ_SOURCE_LINE 00000160 "            .= 'sub Fields { return ($_[0]->SUPER::Fields, '"
NSQ_SOURCE_LINE 00000161 "            . join( ', ', map {\"'$_'\"} @fields )"
NSQ_SOURCE_LINE 00000162 "            . \") }\\n\\n\";"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "        foreach my $field (@fields) {"
NSQ_SOURCE_LINE 00000165 "            croak"
NSQ_SOURCE_LINE 00000166 "                \"Invalid field name <$field>. A field name must be a legal Perl identifier.\""
NSQ_SOURCE_LINE 00000167 "                unless $field =~ /\\A[a-z_][a-z0-9_]*\\z/i;"
NSQ_SOURCE_LINE 00000168 "            $code .= sprintf( \"sub %s { \\$_[0]->{%s} }\\n\", $field, $field );"
NSQ_SOURCE_LINE 00000169 "        }"
NSQ_SOURCE_LINE 00000170 "    }"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    if ( my $alias = $def->{alias} ) {"
NSQ_SOURCE_LINE 00000173 "        ## no critic (Variables::ProhibitPackageVars)"
NSQ_SOURCE_LINE 00000174 "        die 'Cannot make alias without caller'"
NSQ_SOURCE_LINE 00000175 "            unless defined $Exception::Class::Caller;"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "        ## no critic (TestingAndDebugging::ProhibitNoStrict)"
NSQ_SOURCE_LINE 00000178 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000179 "        *{\"$Exception::Class::Caller\\::$alias\"}"
NSQ_SOURCE_LINE 00000180 "            = sub { $subclass->throw(@_) };"
NSQ_SOURCE_LINE 00000181 "    }"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    if ( my $defaults = $def->{defaults} ) {"
NSQ_SOURCE_LINE 00000184 "        $code"
NSQ_SOURCE_LINE 00000185 "            .= \"sub _defaults { return shift->SUPER::_defaults, our \\%_DEFAULTS }\\n\";"
NSQ_SOURCE_LINE 00000186 "        ## no critic (TestingAndDebugging::ProhibitNoStrict)"
NSQ_SOURCE_LINE 00000187 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000188 "        *{\"$subclass\\::_DEFAULTS\"} = {%$defaults};"
NSQ_SOURCE_LINE 00000189 "    }"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "    ## no critic (BuiltinFunctions::ProhibitStringyEval, ErrorHandling::RequireCheckingReturnValueOfEval)"
NSQ_SOURCE_LINE 00000192 "    eval $code;"
NSQ_SOURCE_LINE 00000193 "    die $@ if $@;"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    ( my $filename = \"$subclass.pm\" ) =~ s{::}{/}g;"
NSQ_SOURCE_LINE 00000196 "    $INC{$filename} = __FILE__;"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "    $CLASSES{$subclass} = 1;"
NSQ_SOURCE_LINE 00000199 "}"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "sub caught {"
NSQ_SOURCE_LINE 00000202 "    my $e = $@;"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "    return $e unless $_[1];"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    return unless blessed($e) && $e->isa( $_[1] );"
NSQ_SOURCE_LINE 00000207 "    return $e;"
NSQ_SOURCE_LINE 00000208 "}"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "sub Classes { sort keys %Exception::Class::CLASSES }"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "1;"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "# ABSTRACT: A module that allows you to declare real exception classes in Perl"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "__END__"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "=pod"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head1 NAME"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "Exception::Class - A module that allows you to declare real exception classes in Perl"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=head1 VERSION"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "version 1.45"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "  use Exception::Class ("
NSQ_SOURCE_LINE 00000233 "      'MyException',"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "      'AnotherException' => { isa => 'MyException' },"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "      'YetAnotherException' => {"
NSQ_SOURCE_LINE 00000238 "          isa         => 'AnotherException',"
NSQ_SOURCE_LINE 00000239 "          description => 'These exceptions are related to IPC'"
NSQ_SOURCE_LINE 00000240 "      },"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "      'ExceptionWithFields' => {"
NSQ_SOURCE_LINE 00000243 "          isa    => 'YetAnotherException',"
NSQ_SOURCE_LINE 00000244 "          fields => [ 'grandiosity', 'quixotic' ],"
NSQ_SOURCE_LINE 00000245 "          alias  => 'throw_fields',"
NSQ_SOURCE_LINE 00000246 "      },"
NSQ_SOURCE_LINE 00000247 "  );"
NSQ_SOURCE_LINE 00000248 "  use Scalar::Util qw( blessed );"
NSQ_SOURCE_LINE 00000249 "  use Try::Tiny;"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "  try {"
NSQ_SOURCE_LINE 00000252 "      MyException->throw( error => 'I feel funny.' );"
NSQ_SOURCE_LINE 00000253 "  }"
NSQ_SOURCE_LINE 00000254 "  catch {"
NSQ_SOURCE_LINE 00000255 "      die $_ unless blessed $_ && $_->can('rethrow');"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "      if ( $_->isa('Exception::Class') ) {"
NSQ_SOURCE_LINE 00000258 "          warn $_->error, \"\\n\", $_->trace->as_string, \"\\n\";"
NSQ_SOURCE_LINE 00000259 "          warn join ' ', $_->euid, $_->egid, $_->uid, $_->gid, $_->pid, $_->time;"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "          exit;"
NSQ_SOURCE_LINE 00000262 "      }"
NSQ_SOURCE_LINE 00000263 "      elsif ( $_->isa('ExceptionWithFields') ) {"
NSQ_SOURCE_LINE 00000264 "          if ( $_->quixotic ) {"
NSQ_SOURCE_LINE 00000265 "              handle_quixotic_exception();"
NSQ_SOURCE_LINE 00000266 "          }"
NSQ_SOURCE_LINE 00000267 "          else {"
NSQ_SOURCE_LINE 00000268 "              handle_non_quixotic_exception();"
NSQ_SOURCE_LINE 00000269 "          }"
NSQ_SOURCE_LINE 00000270 "      }"
NSQ_SOURCE_LINE 00000271 "      else {"
NSQ_SOURCE_LINE 00000272 "          $_->rethrow;"
NSQ_SOURCE_LINE 00000273 "      }"
NSQ_SOURCE_LINE 00000274 "  };"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "  # without Try::Tiny"
NSQ_SOURCE_LINE 00000277 "  eval { ... };"
NSQ_SOURCE_LINE 00000278 "  if ( my $e = Exception::Class->caught ) { ... }"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "  # use an alias - without parens subroutine name is checked at"
NSQ_SOURCE_LINE 00000281 "  # compile time"
NSQ_SOURCE_LINE 00000282 "  throw_fields error => \"No strawberry\", grandiosity => \"quite a bit\";"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "B<RECOMMENDATION 1>: If you are writing modern Perl code with L<Moose> or"
NSQ_SOURCE_LINE 00000287 "L<Moo> I highly recommend using L<Throwable> instead of this module."
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "B<RECOMMENDATION 2>: Whether or not you use L<Throwable>, you should use"
NSQ_SOURCE_LINE 00000290 "L<Try::Tiny>."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "Exception::Class allows you to declare exception hierarchies in your modules in"
NSQ_SOURCE_LINE 00000293 "a \"Java-esque\" manner."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "It features a simple interface allowing programmers to 'declare' exception"
NSQ_SOURCE_LINE 00000296 "classes at compile time. It also has a base exception class,"
NSQ_SOURCE_LINE 00000297 "L<Exception::Class::Base>, that can be easily extended."
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "It is designed to make structured exception handling simpler and better by"
NSQ_SOURCE_LINE 00000300 "encouraging people to use hierarchies of exceptions in their applications, as"
NSQ_SOURCE_LINE 00000301 "opposed to a single catch-all exception class."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "This module does not implement any try/catch syntax. Please see the \"OTHER"
NSQ_SOURCE_LINE 00000304 "EXCEPTION MODULES (try/catch syntax)\" section for more information on how to"
NSQ_SOURCE_LINE 00000305 "get this syntax."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "You will also want to look at the documentation for L<Exception::Class::Base>,"
NSQ_SOURCE_LINE 00000308 "which is the default base class for all exception objects created by this"
NSQ_SOURCE_LINE 00000309 "module."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "=for Pod::Coverage     Classes"
NSQ_SOURCE_LINE 00000312 "    caught"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=head1 DECLARING EXCEPTION CLASSES"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "Importing C<Exception::Class> allows you to automagically create"
NSQ_SOURCE_LINE 00000317 "L<Exception::Class::Base> subclasses. You can also create subclasses via the"
NSQ_SOURCE_LINE 00000318 "traditional means of defining your own subclass with C<@ISA>.  These two"
NSQ_SOURCE_LINE 00000319 "methods may be easily combined, so that you could subclass an exception class"
NSQ_SOURCE_LINE 00000320 "defined via the automagic import, if you desired this."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "The syntax for the magic declarations is as follows:"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "  'MANDATORY CLASS NAME' => \\%optional_hashref"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "The hashref may contain the following options:"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=over 4"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=item * isa"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "This is the class's parent class. If this isn't provided then the class name in"
NSQ_SOURCE_LINE 00000333 "C<$Exception::Class::BASE_EXC_CLASS> is assumed to be the parent (see below)."
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "This parameter lets you create arbitrarily deep class hierarchies.  This can be"
NSQ_SOURCE_LINE 00000336 "any other L<Exception::Class::Base> subclass in your declaration I<or> a"
NSQ_SOURCE_LINE 00000337 "subclass loaded from a module."
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "To change the default exception class you will need to change the value of"
NSQ_SOURCE_LINE 00000340 "C<$Exception::Class::BASE_EXC_CLASS> I<before> calling C<import>. To do this"
NSQ_SOURCE_LINE 00000341 "simply do something like this:"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "  BEGIN { $Exception::Class::BASE_EXC_CLASS = 'SomeExceptionClass'; }"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "If anyone can come up with a more elegant way to do this please let me know."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "CAVEAT: If you want to automagically subclass an L<Exception::Class::Base>"
NSQ_SOURCE_LINE 00000348 "subclass loaded from a file, then you I<must> compile the class (via use or"
NSQ_SOURCE_LINE 00000349 "require or some other magic) I<before> you import C<Exception::Class> or you'll"
NSQ_SOURCE_LINE 00000350 "get a compile time error."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=item * fields"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "This allows you to define additional attributes for your exception class. Any"
NSQ_SOURCE_LINE 00000355 "field you define can be passed to the C<throw> or C<new> methods as additional"
NSQ_SOURCE_LINE 00000356 "parameters for the constructor. In addition, your exception object will have an"
NSQ_SOURCE_LINE 00000357 "accessor method for the fields you define."
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "This parameter can be either a scalar (for a single field) or an array"
NSQ_SOURCE_LINE 00000360 "reference if you need to define multiple fields."
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "Each field name must be a legal Perl identifier: it starts with a ASCII letter"
NSQ_SOURCE_LINE 00000363 "or underscore, and is followed by zero or more ASCII letters, ASCII digits, or"
NSQ_SOURCE_LINE 00000364 "underscores. If a field name does not match this, the creation of that"
NSQ_SOURCE_LINE 00000365 "exception class croaks."
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "Fields will be inherited by subclasses."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=item * alias"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "Specifying an alias causes this class to create a subroutine of the specified"
NSQ_SOURCE_LINE 00000372 "name in the I<caller's> namespace. Calling this subroutine is equivalent to"
NSQ_SOURCE_LINE 00000373 "calling C<< <class>->throw(@_) >> for the given exception class."
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "Besides convenience, using aliases also allows for additional compile time"
NSQ_SOURCE_LINE 00000376 "checking. If the alias is called I<without parentheses>, as in C<throw_fields"
NSQ_SOURCE_LINE 00000377 "\"an error occurred\">, then Perl checks for the existence of the C<throw_fields>"
NSQ_SOURCE_LINE 00000378 "subroutine at compile time. If instead you do C<<"
NSQ_SOURCE_LINE 00000379 "ExceptionWithFields->throw(...) >>, then Perl checks the class name at runtime,"
NSQ_SOURCE_LINE 00000380 "meaning that typos may sneak through."
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=item * description"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "Each exception class has a description method that returns a fixed string. This"
NSQ_SOURCE_LINE 00000385 "should describe the exception I<class> (as opposed to any particular exception"
NSQ_SOURCE_LINE 00000386 "object). This may be useful for debugging if you start catching exceptions you"
NSQ_SOURCE_LINE 00000387 "weren't expecting (particularly if someone forgot to document them) and you"
NSQ_SOURCE_LINE 00000388 "don't understand the error messages."
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "=back"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "The C<Exception::Class> magic attempts to detect circular class hierarchies and"
NSQ_SOURCE_LINE 00000393 "will die if it finds one. It also detects missing links in a chain, for example"
NSQ_SOURCE_LINE 00000394 "if you declare Bar to be a subclass of Foo and never declare Foo."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "=head1 L<Try::Tiny>"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "If you are interested in adding try/catch/finally syntactic sugar to your code"
NSQ_SOURCE_LINE 00000399 "then I recommend you check out L<Try::Tiny>. This is a great module that helps"
NSQ_SOURCE_LINE 00000400 "you ignore some of the weirdness with C<eval> and C<$@>. Here's an example of"
NSQ_SOURCE_LINE 00000401 "how the two modules work together:"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "  use Exception::Class ( 'My::Exception' );"
NSQ_SOURCE_LINE 00000404 "  use Scalar::Util qw( blessed );"
NSQ_SOURCE_LINE 00000405 "  use Try::Tiny;"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "  try {"
NSQ_SOURCE_LINE 00000408 "      might_throw();"
NSQ_SOURCE_LINE 00000409 "  }"
NSQ_SOURCE_LINE 00000410 "  catch {"
NSQ_SOURCE_LINE 00000411 "      if ( blessed $_ && $_->isa('My::Exception') ) {"
NSQ_SOURCE_LINE 00000412 "          handle_it();"
NSQ_SOURCE_LINE 00000413 "      }"
NSQ_SOURCE_LINE 00000414 "      else {"
NSQ_SOURCE_LINE 00000415 "          die $_;"
NSQ_SOURCE_LINE 00000416 "      }"
NSQ_SOURCE_LINE 00000417 "  };"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "Note that you B<cannot> use C<< Exception::Class->caught >> with L<Try::Tiny>."
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "=head1 Catching Exceptions Without L<Try::Tiny>"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "C<Exception::Class> provides some syntactic sugar for catching exceptions in a"
NSQ_SOURCE_LINE 00000424 "safe manner:"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "  eval {...};"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "  if ( my $e = Exception::Class->caught('My::Error') ) {"
NSQ_SOURCE_LINE 00000429 "      cleanup();"
NSQ_SOURCE_LINE 00000430 "      do_something_with_exception($e);"
NSQ_SOURCE_LINE 00000431 "  }"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "The C<caught> method takes a class name and returns an exception object if the"
NSQ_SOURCE_LINE 00000434 "last thrown exception is of the given class, or a subclass of that class. If it"
NSQ_SOURCE_LINE 00000435 "is not given any arguments, it simply returns C<$@>."
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "You should B<always> make a copy of the exception object, rather than using"
NSQ_SOURCE_LINE 00000438 "C<$@> directly. This is necessary because if your C<cleanup> function uses"
NSQ_SOURCE_LINE 00000439 "C<eval>, or calls something which uses it, then C<$@> is overwritten. Copying"
NSQ_SOURCE_LINE 00000440 "the exception preserves it for the call to C<do_something_with_exception>."
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "Exception objects also provide a caught method so you can write:"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "  if ( my $e = My::Error->caught ) {"
NSQ_SOURCE_LINE 00000445 "      cleanup();"
NSQ_SOURCE_LINE 00000446 "      do_something_with_exception($e);"
NSQ_SOURCE_LINE 00000447 "  }"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "=head2 Uncatchable Exceptions"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "Internally, the C<caught> method will call C<isa> on the exception object. You"
NSQ_SOURCE_LINE 00000452 "could make an exception \"uncatchable\" by overriding C<isa> in that class like"
NSQ_SOURCE_LINE 00000453 "this:"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 " package Exception::Uncatchable;"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 " sub isa { shift->rethrow }"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "Of course, this only works if you always call C<< Exception::Class->caught >>"
NSQ_SOURCE_LINE 00000460 "after an C<eval>."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "=head1 USAGE RECOMMENDATION"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "If you're creating a complex system that throws lots of different types of"
NSQ_SOURCE_LINE 00000465 "exceptions, consider putting all the exception declarations in one place. For"
NSQ_SOURCE_LINE 00000466 "an app called Foo you might make a C<Foo::Exceptions> module and use that in"
NSQ_SOURCE_LINE 00000467 "all your code. This module could just contain the code to make"
NSQ_SOURCE_LINE 00000468 "C<Exception::Class> do its automagic class creation. Doing this allows you to"
NSQ_SOURCE_LINE 00000469 "more easily see what exceptions you have, and makes it easier to keep track of"
NSQ_SOURCE_LINE 00000470 "them."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "This might look something like this:"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "  package Foo::Bar::Exceptions;"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "  use Exception::Class ("
NSQ_SOURCE_LINE 00000477 "      Foo::Bar::Exception::Senses =>"
NSQ_SOURCE_LINE 00000478 "          { description => 'sense-related exception' },"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "      Foo::Bar::Exception::Smell => {"
NSQ_SOURCE_LINE 00000481 "          isa         => 'Foo::Bar::Exception::Senses',"
NSQ_SOURCE_LINE 00000482 "          fields      => 'odor',"
NSQ_SOURCE_LINE 00000483 "          description => 'stinky!'"
NSQ_SOURCE_LINE 00000484 "      },"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "      Foo::Bar::Exception::Taste => {"
NSQ_SOURCE_LINE 00000487 "          isa         => 'Foo::Bar::Exception::Senses',"
NSQ_SOURCE_LINE 00000488 "          fields      => [ 'taste', 'bitterness' ],"
NSQ_SOURCE_LINE 00000489 "          description => 'like, gag me with a spoon!'"
NSQ_SOURCE_LINE 00000490 "      },"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "      ..."
NSQ_SOURCE_LINE 00000493 "  );"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "You may want to create a real module to subclass L<Exception::Class::Base> as"
NSQ_SOURCE_LINE 00000496 "well, particularly if you want your exceptions to have more methods."
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "=head2 Subclassing Exception::Class::Base"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "As part of your usage of C<Exception::Class>, you may want to create your own"
NSQ_SOURCE_LINE 00000501 "base exception class which subclasses L<Exception::Class::Base>. You should"
NSQ_SOURCE_LINE 00000502 "feel free to subclass any of the methods documented above. For example, you may"
NSQ_SOURCE_LINE 00000503 "want to subclass C<new> to add additional information to your exception"
NSQ_SOURCE_LINE 00000504 "objects."
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "=head1 Exception::Class FUNCTIONS"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "The C<Exception::Class> method offers one function, C<Classes>, which is not"
NSQ_SOURCE_LINE 00000509 "exported. This method returns a list of the classes that have been created by"
NSQ_SOURCE_LINE 00000510 "calling the C<Exception::Class> C<import> method.  Note that this is I<all> the"
NSQ_SOURCE_LINE 00000511 "subclasses that have been created, so it may include subclasses created by"
NSQ_SOURCE_LINE 00000512 "things like CPAN modules, etc. Also note that if you simply define a subclass"
NSQ_SOURCE_LINE 00000513 "via the normal Perl method of setting C<@ISA> or C<use base>, then your"
NSQ_SOURCE_LINE 00000514 "subclass will not be included."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "Bugs may be submitted at L<https://github.com/houseabsolute/Exception-Class/issues>."
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "I am also usually active on IRC as 'autarch' on C<irc://irc.perl.org>."
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "The source code repository for Exception-Class can be found at L<https://github.com/houseabsolute/Exception-Class>."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "=head1 DONATIONS"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "If you'd like to thank me for the work I've done on this module, please"
NSQ_SOURCE_LINE 00000529 "consider making a \"donation\" to me via PayPal. I spend a lot of free time"
NSQ_SOURCE_LINE 00000530 "creating free software, and would appreciate any support you'd care to offer."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "Please note that B<I am not suggesting that you must do this> in order for me"
NSQ_SOURCE_LINE 00000533 "to continue working on this particular software. I will continue to do so,"
NSQ_SOURCE_LINE 00000534 "inasmuch as I have in the past, for as long as it interests me."
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "Similarly, a donation made in this way will probably not make me work on this"
NSQ_SOURCE_LINE 00000537 "software much more, unless I get so many donations that I can consider working"
NSQ_SOURCE_LINE 00000538 "on free software full time (let's all have a chuckle at that together)."
NSQ_SOURCE_LINE 00000539 ""
