NSQ_SOURCE_LINE 00000001 "package String::PerlQuote;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2016-10-07'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.02'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter;"
NSQ_SOURCE_LINE 00000011 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000013 "                       single_quote"
NSQ_SOURCE_LINE 00000014 "                       double_quote"
NSQ_SOURCE_LINE 00000015 "               );"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "# BEGIN COPY PASTE FROM Data::Dump"
NSQ_SOURCE_LINE 00000018 "my %esc = ("
NSQ_SOURCE_LINE 00000019 "    \"\\a\" => \"\\\\a\","
NSQ_SOURCE_LINE 00000020 "    \"\\b\" => \"\\\\b\","
NSQ_SOURCE_LINE 00000021 "    \"\\t\" => \"\\\\t\","
NSQ_SOURCE_LINE 00000022 "    \"\\n\" => \"\\\\n\","
NSQ_SOURCE_LINE 00000023 "    \"\\f\" => \"\\\\f\","
NSQ_SOURCE_LINE 00000024 "    \"\\r\" => \"\\\\r\","
NSQ_SOURCE_LINE 00000025 "    \"\\e\" => \"\\\\e\","
NSQ_SOURCE_LINE 00000026 ");"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "# put a string value in double quotes"
NSQ_SOURCE_LINE 00000029 "sub double_quote {"
NSQ_SOURCE_LINE 00000030 "  local($_) = $_[0];"
NSQ_SOURCE_LINE 00000031 "  # If there are many '\"' we might want to use qq() instead"
NSQ_SOURCE_LINE 00000032 "  s/([\\\\\\\"\\@\\$])/\\\\$1/g;"
NSQ_SOURCE_LINE 00000033 "  return qq(\"$_\") unless /[^\\040-\\176]/;  # fast exit"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "  s/([\\a\\b\\t\\n\\f\\r\\e])/$esc{$1}/g;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "  # no need for 3 digits in escape for these"
NSQ_SOURCE_LINE 00000038 "  s/([\\0-\\037])(?!\\d)/sprintf('\\\\%o',ord($1))/eg;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "  s/([\\0-\\037\\177-\\377])/sprintf('\\\\x%02X',ord($1))/eg;"
NSQ_SOURCE_LINE 00000041 "  s/([^\\040-\\176])/sprintf('\\\\x{%X}',ord($1))/eg;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "  return qq(\"$_\");"
NSQ_SOURCE_LINE 00000044 "}"
NSQ_SOURCE_LINE 00000045 "# END COPY PASTE FROM Data::Dump"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "sub single_quote {"
NSQ_SOURCE_LINE 00000048 "  local($_) = $_[0];"
NSQ_SOURCE_LINE 00000049 "  s/([\\\\'])/\\\\$1/g;"
NSQ_SOURCE_LINE 00000050 "  return qq('$_');"
NSQ_SOURCE_LINE 00000051 "}"
NSQ_SOURCE_LINE 00000052 "1;"
NSQ_SOURCE_LINE 00000053 "# ABSTRACT: Quote a string as Perl does"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "__END__"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=pod"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=head1 NAME"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "String::PerlQuote - Quote a string as Perl does"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "=head1 VERSION"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "This document describes version 0.02 of String::PerlQuote (from Perl distribution String-PerlQuote), released on 2016-10-07."
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head2 double_quote($str) => STR"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "Quote or encode C<$str> to the Perl double quote (C<\">) literal representation"
NSQ_SOURCE_LINE 00000074 "of the string. Example:"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 " say double_quote(\"a\");        # => \"a\"     (with the quotes)"
NSQ_SOURCE_LINE 00000077 " say double_quote(\"a\\n\");      # => \"a\\n\""
NSQ_SOURCE_LINE 00000078 " say double_quote('\"');        # => \"\\\"\""
NSQ_SOURCE_LINE 00000079 " say double_quote('$foo');     # => \"\\$foo\""
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "This code is taken from C<quote()> in L<Data::Dump>. Maybe I didn't look more"
NSQ_SOURCE_LINE 00000082 "closely, but I couldn't a module that provides a function to do something like"
NSQ_SOURCE_LINE 00000083 "this. L<String::Escape>, for example, provides C<qqbackslash> but it does not"
NSQ_SOURCE_LINE 00000084 "escape C<$>."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=head2 single_quote($str) => STR"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "Like C<double_quote> but will produce a Perl single quote literal representation"
NSQ_SOURCE_LINE 00000089 "instead of the double quote ones. In single quotes, only literal backslash C<\\>"
NSQ_SOURCE_LINE 00000090 "and single quote character C<'> are escaped, the rest are displayed as-is, so"
NSQ_SOURCE_LINE 00000091 "the result might span multiple lines or contain other non-printable characters."
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 " say single_quote(\"Mom's\");    # => 'Mom\\'s' (with the quotes)"
NSQ_SOURCE_LINE 00000094 " say single_quote(\"a\\\\\");      # => 'a\\\\\""
NSQ_SOURCE_LINE 00000095 " say single_quote('\"');        # => '\"'"
NSQ_SOURCE_LINE 00000096 " say single_quote(\"\\$foo\");    # => '$foo'"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "Please visit the project's homepage at L<https://metacpan.org/release/String-PerlQuote>."
NSQ_SOURCE_LINE 00000101 ""
