BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Package::Stash; # git description: v0.39-2-ga9a8cce"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use 5.008001;"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: Routines for manipulating stashes"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.40';"
NSQ_SOURCE_LINE 00000008 "our $IMPLEMENTATION;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Module::Implementation 0.06;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "BEGIN {"
NSQ_SOURCE_LINE 00000013 "    local $ENV{PACKAGE_STASH_IMPLEMENTATION} = $IMPLEMENTATION"
NSQ_SOURCE_LINE 00000014 "      if ( $IMPLEMENTATION and not $ENV{PACKAGE_STASH_IMPLEMENTATION} );"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "    Module::Implementation::build_loader_sub("
NSQ_SOURCE_LINE 00000017 "        implementations => [ 'XS', 'PP' ],"
NSQ_SOURCE_LINE 00000018 "        symbols         => [qw("
NSQ_SOURCE_LINE 00000019 "            new"
NSQ_SOURCE_LINE 00000020 "            name"
NSQ_SOURCE_LINE 00000021 "            namespace"
NSQ_SOURCE_LINE 00000022 "            add_symbol"
NSQ_SOURCE_LINE 00000023 "            remove_glob"
NSQ_SOURCE_LINE 00000024 "            has_symbol"
NSQ_SOURCE_LINE 00000025 "            get_symbol"
NSQ_SOURCE_LINE 00000026 "            get_or_add_symbol"
NSQ_SOURCE_LINE 00000027 "            remove_symbol"
NSQ_SOURCE_LINE 00000028 "            list_all_symbols"
NSQ_SOURCE_LINE 00000029 "            get_all_symbols"
NSQ_SOURCE_LINE 00000030 "        )],"
NSQ_SOURCE_LINE 00000031 "    )->();"
NSQ_SOURCE_LINE 00000032 "    $IMPLEMENTATION = Module::Implementation::implementation_for(__PACKAGE__);"
NSQ_SOURCE_LINE 00000033 "}"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "__END__"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=pod"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=head1 NAME"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "Package::Stash - Routines for manipulating stashes"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=head1 VERSION"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "version 0.40"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "  my $stash = Package::Stash->new('Foo');"
NSQ_SOURCE_LINE 00000052 "  $stash->add_symbol('%foo', {bar => 1});"
NSQ_SOURCE_LINE 00000053 "  # $Foo::foo{bar} == 1"
NSQ_SOURCE_LINE 00000054 "  $stash->has_symbol('$foo') # false"
NSQ_SOURCE_LINE 00000055 "  my $namespace = $stash->namespace;"
NSQ_SOURCE_LINE 00000056 "  *{ $namespace->{foo} }{HASH} # {bar => 1}"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "Manipulating stashes (Perl's symbol tables) is occasionally necessary, but"
NSQ_SOURCE_LINE 00000061 "incredibly messy, and easy to get wrong. This module hides all of that behind a"
NSQ_SOURCE_LINE 00000062 "simple API."
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "NOTE: Most methods in this class require a variable specification that includes"
NSQ_SOURCE_LINE 00000065 "a sigil. If this sigil is absent, it is assumed to represent the IO slot."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "Due to limitations in the typeglob API available to perl code, and to typeglob"
NSQ_SOURCE_LINE 00000068 "manipulation in perl being quite slow, this module provides two"
NSQ_SOURCE_LINE 00000069 "implementations - one in pure perl, and one using XS. The XS implementation is"
NSQ_SOURCE_LINE 00000070 "to be preferred for most usages; the pure perl one is provided for cases where"
NSQ_SOURCE_LINE 00000071 "XS modules are not a possibility. The current implementation in use can be set"
NSQ_SOURCE_LINE 00000072 "by setting C<$ENV{PACKAGE_STASH_IMPLEMENTATION}> or"
NSQ_SOURCE_LINE 00000073 "C<$Package::Stash::IMPLEMENTATION> before loading Package::Stash (with the"
NSQ_SOURCE_LINE 00000074 "environment variable taking precedence), otherwise, it will use the XS"
NSQ_SOURCE_LINE 00000075 "implementation if possible, falling back to the pure perl one."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "=head1 METHODS"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=head2 new $package_name"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "Creates a new C<Package::Stash> object, for the package given as the only"
NSQ_SOURCE_LINE 00000082 "argument."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head2 name"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "Returns the name of the package that this object represents."
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=head2 namespace"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "Returns the raw stash itself."
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head2 add_symbol $variable $value %opts"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "Adds a new package symbol, for the symbol given as C<$variable>, and optionally"
NSQ_SOURCE_LINE 00000095 "gives it an initial value of C<$value>. C<$variable> should be the name of"
NSQ_SOURCE_LINE 00000096 "variable including the sigil, so"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "  Package::Stash->new('Foo')->add_symbol('%foo')"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "will create C<%Foo::foo>."
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "Valid options (all optional) are C<filename>, C<first_line_num>, and"
NSQ_SOURCE_LINE 00000103 "C<last_line_num>."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "C<$opts{filename}>, C<$opts{first_line_num}>, and C<$opts{last_line_num}> can"
NSQ_SOURCE_LINE 00000106 "be used to indicate where the symbol should be regarded as having been defined."
NSQ_SOURCE_LINE 00000107 "Currently these values are only used if the symbol is a subroutine ('C<&>'"
NSQ_SOURCE_LINE 00000108 "sigil) and only if C<$^P & 0x10> is true, in which case the special C<%DB::sub>"
NSQ_SOURCE_LINE 00000109 "hash is updated to record the values of C<filename>, C<first_line_num>, and"
NSQ_SOURCE_LINE 00000110 "C<last_line_num> for the subroutine. If these are not passed, their values are"
NSQ_SOURCE_LINE 00000111 "inferred (as much as possible) from C<caller> information."
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head2 remove_glob $name"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "Removes all package variables with the given name, regardless of sigil."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=head2 has_symbol $variable"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "Returns whether or not the given package variable (including sigil) exists."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=head2 get_symbol $variable"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "Returns the value of the given package variable (including sigil)."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head2 get_or_add_symbol $variable"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "Like C<get_symbol>, except that it will return an empty hashref or"
NSQ_SOURCE_LINE 00000128 "arrayref if the variable doesn't exist."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=head2 remove_symbol $variable"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "Removes the package variable described by C<$variable> (which includes the"
NSQ_SOURCE_LINE 00000133 "sigil); other variables with the same name but different sigils will be"
NSQ_SOURCE_LINE 00000134 "untouched."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head2 list_all_symbols $type_filter"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "Returns a list of package variable names in the package, without sigils. If a"
NSQ_SOURCE_LINE 00000139 "C<type_filter> is passed, it is used to select package variables of a given"
NSQ_SOURCE_LINE 00000140 "type, where valid types are the slots of a typeglob ('SCALAR', 'CODE', 'HASH',"
NSQ_SOURCE_LINE 00000141 "etc). Note that if the package contained any C<BEGIN> blocks, perl will leave"
NSQ_SOURCE_LINE 00000142 "an empty typeglob in the C<BEGIN> slot, so this will show up if no filter is"
NSQ_SOURCE_LINE 00000143 "used (and similarly for C<INIT>, C<END>, etc)."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=head2 get_all_symbols $type_filter"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "Returns a hashref, keyed by the variable names in the package. If"
NSQ_SOURCE_LINE 00000148 "C<$type_filter> is passed, the hash will contain every variable of that type in"
NSQ_SOURCE_LINE 00000149 "the package as values, otherwise, it will contain the typeglobs corresponding"
NSQ_SOURCE_LINE 00000150 "to the variable names (basically, a clone of the stash)."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=for stopwords profilers"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "This is especially useful for debuggers and profilers, which use C<%DB::sub> to"
NSQ_SOURCE_LINE 00000155 "determine where the source code for a subroutine can be found.  See"
NSQ_SOURCE_LINE 00000156 "L<http://perldoc.perl.org/perldebguts.html#Debugger-Internals> for more"
NSQ_SOURCE_LINE 00000157 "information about C<%DB::sub>."
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=head1 WORKING WITH VARIABLES"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "It is important to note, that when working with scalar variables, the default"
NSQ_SOURCE_LINE 00000162 "behavior is to B<copy> values."
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "  my $stash = Package::Stash->new('Some::Namespace');"
NSQ_SOURCE_LINE 00000165 "  my $variable = 1;"
NSQ_SOURCE_LINE 00000166 "  # $Some::Namespace::name is a copy of $variable"
NSQ_SOURCE_LINE 00000167 "  $stash->add_symbol('$name', $variable);"
NSQ_SOURCE_LINE 00000168 "  $variable++"
NSQ_SOURCE_LINE 00000169 "  # $Some::Namespace::name == 1 , $variable == 2"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "This will likely confuse people who expect it to work the same as typeglob"
NSQ_SOURCE_LINE 00000172 "assignment, which simply creates new references to existing variables."
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "  my $variable = 1;"
NSQ_SOURCE_LINE 00000175 "  {"
NSQ_SOURCE_LINE 00000176 "      no strict 'refs';"
NSQ_SOURCE_LINE 00000177 "      # assign $Package::Stash::name = $variable"
NSQ_SOURCE_LINE 00000178 "      *{'Package::Stash::name'} = \\$variable;"
NSQ_SOURCE_LINE 00000179 "  }"
NSQ_SOURCE_LINE 00000180 "  $variable++ # affects both names"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "If this behaviour is desired when working with Package::Stash, simply pass"
NSQ_SOURCE_LINE 00000183 "Package::Stash a scalar ref:"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "  my $stash = Package::Stash->new('Some::Namespace');"
NSQ_SOURCE_LINE 00000186 "  my $variable = 1;"
NSQ_SOURCE_LINE 00000187 "  # $Some::Namespace::name is now $variable"
NSQ_SOURCE_LINE 00000188 "  $stash->add_symbol('$name', \\$variable);"
NSQ_SOURCE_LINE 00000189 "  $variable++"
NSQ_SOURCE_LINE 00000190 "  # $Some::Namespace::name == 2 , $variable == 2"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "This will be what you want as well if you're ever working with L<Readonly>"
NSQ_SOURCE_LINE 00000193 "variables:"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "  use Readonly;"
NSQ_SOURCE_LINE 00000196 "  Readonly my $value, 'hello';"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "  $stash->add_symbol('$name', \\$value); # reference"
NSQ_SOURCE_LINE 00000199 "  print $Some::Namespace::name; # hello"
NSQ_SOURCE_LINE 00000200 "  # Tries to modify the read-only 'hello' and dies."
NSQ_SOURCE_LINE 00000201 "  $Some::Namespace::name .= \" world\";"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "  $stash->add_symbol('$name', $value); # copy"
NSQ_SOURCE_LINE 00000204 "  print $Some::Namespace::name; # hello"
NSQ_SOURCE_LINE 00000205 "  # No problem, modifying a copy, not the original"
NSQ_SOURCE_LINE 00000206 "  $Some::Namespace::name .= \" world\";"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=head1 BUGS / CAVEATS"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=over 4"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=item * Prior to perl 5.10, scalar slots are only considered to exist if they are defined"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "This is due to a shortcoming within perl itself. See"
NSQ_SOURCE_LINE 00000215 "L<perlref/Making References> point 7 for more information."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=item * GLOB and FORMAT variables are not (yet) accessible through this module."
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "=item * Also, see the BUGS section for the specific backends (L<Package::Stash::XS> and L<Package::Stash::PP>)"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=back"
NSQ_SOURCE_LINE 00000222 ""
