NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "sub Parse_Date"
NSQ_SOURCE_LINE 00000295 "{"
NSQ_SOURCE_LINE 00000296 "    croak \"Usage: (\\$year,\\$month,\\$day) = Parse_Date(\\$date[,\\$lang]);\\n\" unless ((@_ == 1) or (@_ == 2));"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "    my($date) = shift;"
NSQ_SOURCE_LINE 00000299 "    my($lang) = shift || 0;"
NSQ_SOURCE_LINE 00000300 "    my($year,$month,$day);"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "    $lang = Language() unless (($lang >= 1) and ($lang <= Languages()));"
NSQ_SOURCE_LINE 00000303 "    unless ($date =~ /\\b([\\x41-\\x5A\\x61-\\x7A\\xC0-\\xD6\\xD8-\\xF6\\xF8-\\xFF]{3})\\s+([0123]??\\d)\\b/)"
NSQ_SOURCE_LINE 00000304 "    {"
NSQ_SOURCE_LINE 00000305 "        return();"
NSQ_SOURCE_LINE 00000306 "    }"
NSQ_SOURCE_LINE 00000307 "    $month = $1;"
NSQ_SOURCE_LINE 00000308 "    $day   = $2;"
NSQ_SOURCE_LINE 00000309 "    unless ($date =~ /\\b(19\\d\\d|20\\d\\d)\\b/)"
NSQ_SOURCE_LINE 00000310 "    {"
NSQ_SOURCE_LINE 00000311 "        return();"
NSQ_SOURCE_LINE 00000312 "    }"
NSQ_SOURCE_LINE 00000313 "    $year  = $1;"
NSQ_SOURCE_LINE 00000314 "    $month = Decode_Month($month,$lang);"
NSQ_SOURCE_LINE 00000315 "    unless ($month > 0)"
NSQ_SOURCE_LINE 00000316 "    {"
NSQ_SOURCE_LINE 00000317 "        return();"
NSQ_SOURCE_LINE 00000318 "    }"
NSQ_SOURCE_LINE 00000319 "    unless (check_date($year,$month,$day))"
NSQ_SOURCE_LINE 00000320 "    {"
NSQ_SOURCE_LINE 00000321 "        return();"
NSQ_SOURCE_LINE 00000322 "    }"
NSQ_SOURCE_LINE 00000323 "    return($year,$month,$day);"
NSQ_SOURCE_LINE 00000324 "}"
