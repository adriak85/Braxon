NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "sub Decode_Date_EU2"
NSQ_SOURCE_LINE 00000113 "{"
NSQ_SOURCE_LINE 00000114 "    croak \"Usage: (\\$year,\\$month,\\$day) = Decode_Date_EU2(\\$date[,\\$lang]);\\n\" unless ((@_ == 1) or (@_ == 2));"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    my($buffer) = shift;"
NSQ_SOURCE_LINE 00000117 "    my($lang)   = shift || 0;"
NSQ_SOURCE_LINE 00000118 "    my($year,$month,$day,$length);"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "    $lang = Language() unless (($lang >= 1) and ($lang <= Languages()));"
NSQ_SOURCE_LINE 00000121 "    if ($buffer =~ /^\\D*  (\\d+)  [^A-Za-z0-9\\xC0-\\xD6\\xD8-\\xF6\\xF8-\\xFF]*  ([A-Za-z\\xC0-\\xD6\\xD8-\\xF6\\xF8-\\xFF]+)  [^A-Za-z0-9\\xC0-\\xD6\\xD8-\\xF6\\xF8-\\xFF]*  (\\d+)  \\D*$/x)"
NSQ_SOURCE_LINE 00000122 "    {"
NSQ_SOURCE_LINE 00000123 "        ($day,$month,$year) = ($1,$2,$3);"
NSQ_SOURCE_LINE 00000124 "        $month = Decode_Month($month,$lang);"
NSQ_SOURCE_LINE 00000125 "        unless ($month > 0)"
NSQ_SOURCE_LINE 00000126 "        {"
NSQ_SOURCE_LINE 00000127 "            return(); # can't decode month!"
NSQ_SOURCE_LINE 00000128 "        }"
NSQ_SOURCE_LINE 00000129 "    }"
NSQ_SOURCE_LINE 00000130 "    elsif ($buffer =~ /^\\D*  0*(\\d+)  \\D*$/x)"
NSQ_SOURCE_LINE 00000131 "    {"
NSQ_SOURCE_LINE 00000132 "        $buffer = $1;"
NSQ_SOURCE_LINE 00000133 "        $length = length($buffer);"
NSQ_SOURCE_LINE 00000134 "        if    ($length == 3)"
NSQ_SOURCE_LINE 00000135 "        {"
NSQ_SOURCE_LINE 00000136 "            $day   = substr($buffer,0,1);"
NSQ_SOURCE_LINE 00000137 "            $month = substr($buffer,1,1);"
NSQ_SOURCE_LINE 00000138 "            $year  = substr($buffer,2,1);"
NSQ_SOURCE_LINE 00000139 "        }"
NSQ_SOURCE_LINE 00000140 "        elsif ($length == 4)"
NSQ_SOURCE_LINE 00000141 "        {"
NSQ_SOURCE_LINE 00000142 "            $day   = substr($buffer,0,1);"
NSQ_SOURCE_LINE 00000143 "            $month = substr($buffer,1,1);"
NSQ_SOURCE_LINE 00000144 "            $year  = substr($buffer,2,2);"
NSQ_SOURCE_LINE 00000145 "        }"
NSQ_SOURCE_LINE 00000146 "        elsif ($length == 5)"
NSQ_SOURCE_LINE 00000147 "        {"
NSQ_SOURCE_LINE 00000148 "            $day   = substr($buffer,0,1);"
NSQ_SOURCE_LINE 00000149 "            $month = substr($buffer,1,2);"
NSQ_SOURCE_LINE 00000150 "            $year  = substr($buffer,3,2);"
NSQ_SOURCE_LINE 00000151 "        }"
NSQ_SOURCE_LINE 00000152 "        elsif ($length == 6)"
NSQ_SOURCE_LINE 00000153 "        {"
NSQ_SOURCE_LINE 00000154 "            $day   = substr($buffer,0,2);"
NSQ_SOURCE_LINE 00000155 "            $month = substr($buffer,2,2);"
NSQ_SOURCE_LINE 00000156 "            $year  = substr($buffer,4,2);"
NSQ_SOURCE_LINE 00000157 "        }"
NSQ_SOURCE_LINE 00000158 "        elsif ($length == 7)"
NSQ_SOURCE_LINE 00000159 "        {"
NSQ_SOURCE_LINE 00000160 "            $day   = substr($buffer,0,1);"
NSQ_SOURCE_LINE 00000161 "            $month = substr($buffer,1,2);"
NSQ_SOURCE_LINE 00000162 "            $year  = substr($buffer,3,4);"
NSQ_SOURCE_LINE 00000163 "        }"
NSQ_SOURCE_LINE 00000164 "        elsif ($length == 8)"
NSQ_SOURCE_LINE 00000165 "        {"
NSQ_SOURCE_LINE 00000166 "            $day   = substr($buffer,0,2);"
NSQ_SOURCE_LINE 00000167 "            $month = substr($buffer,2,2);"
NSQ_SOURCE_LINE 00000168 "            $year  = substr($buffer,4,4);"
NSQ_SOURCE_LINE 00000169 "        }"
NSQ_SOURCE_LINE 00000170 "        else { return(); } # wrong number of digits!"
NSQ_SOURCE_LINE 00000171 "    }"
NSQ_SOURCE_LINE 00000172 "    elsif ($buffer =~ /^\\D*  (\\d+)  \\D+  (\\d+)  \\D+  (\\d+)  \\D*$/x)"
NSQ_SOURCE_LINE 00000173 "    {"
NSQ_SOURCE_LINE 00000174 "        ($day,$month,$year) = ($1,$2,$3);"
NSQ_SOURCE_LINE 00000175 "    }"
NSQ_SOURCE_LINE 00000176 "    else { return(); } # no match at all!"
NSQ_SOURCE_LINE 00000177 "    $year = Moving_Window($year);"
NSQ_SOURCE_LINE 00000178 "    if (check_date($year,$month,$day))"
NSQ_SOURCE_LINE 00000179 "    {"
NSQ_SOURCE_LINE 00000180 "        return($year,$month,$day);"
NSQ_SOURCE_LINE 00000181 "    }"
NSQ_SOURCE_LINE 00000182 "    else { return(); } # not a valid date!"
NSQ_SOURCE_LINE 00000183 "}"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "sub Decode_Date_US2"
NSQ_SOURCE_LINE 00000186 "{"
NSQ_SOURCE_LINE 00000187 "    croak \"Usage: (\\$year,\\$month,\\$day) = Decode_Date_US2(\\$date[,\\$lang]);\\n\" unless ((@_ == 1) or (@_ == 2));"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "    my($buffer) = shift;"
NSQ_SOURCE_LINE 00000190 "    my($lang)   = shift || 0;"
NSQ_SOURCE_LINE 00000191 "    my($year,$month,$day,$length);"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    $lang = Language() unless (($lang >= 1) and ($lang <= Languages()));"
NSQ_SOURCE_LINE 00000194 "    if ($buffer =~ /^[^A-Za-z0-9\\xC0-\\xD6\\xD8-\\xF6\\xF8-\\xFF]*  ([A-Za-z\\xC0-\\xD6\\xD8-\\xF6\\xF8-\\xFF]+)  [^A-Za-z0-9\\xC0-\\xD6\\xD8-\\xF6\\xF8-\\xFF]*  0*(\\d+)  \\D*$/x)"
NSQ_SOURCE_LINE 00000195 "    {"
NSQ_SOURCE_LINE 00000196 "        ($month,$buffer) = ($1,$2);"
NSQ_SOURCE_LINE 00000197 "        $month = Decode_Month($month,$lang);"
NSQ_SOURCE_LINE 00000198 "        unless ($month > 0)"
NSQ_SOURCE_LINE 00000199 "        {"
NSQ_SOURCE_LINE 00000200 "            return(); # can't decode month!"
NSQ_SOURCE_LINE 00000201 "        }"
NSQ_SOURCE_LINE 00000202 "        $length = length($buffer);"
NSQ_SOURCE_LINE 00000203 "        if    ($length == 2)"
NSQ_SOURCE_LINE 00000204 "        {"
NSQ_SOURCE_LINE 00000205 "            $day  = substr($buffer,0,1);"
NSQ_SOURCE_LINE 00000206 "            $year = substr($buffer,1,1);"
NSQ_SOURCE_LINE 00000207 "        }"
NSQ_SOURCE_LINE 00000208 "        elsif ($length == 3)"
NSQ_SOURCE_LINE 00000209 "        {"
NSQ_SOURCE_LINE 00000210 "            $day  = substr($buffer,0,1);"
NSQ_SOURCE_LINE 00000211 "            $year = substr($buffer,1,2);"
NSQ_SOURCE_LINE 00000212 "        }"
NSQ_SOURCE_LINE 00000213 "        elsif ($length == 4)"
NSQ_SOURCE_LINE 00000214 "        {"
NSQ_SOURCE_LINE 00000215 "            $day  = substr($buffer,0,2);"
NSQ_SOURCE_LINE 00000216 "            $year = substr($buffer,2,2);"
NSQ_SOURCE_LINE 00000217 "        }"
NSQ_SOURCE_LINE 00000218 "        elsif ($length == 5)"
NSQ_SOURCE_LINE 00000219 "        {"
NSQ_SOURCE_LINE 00000220 "            $day  = substr($buffer,0,1);"
NSQ_SOURCE_LINE 00000221 "            $year = substr($buffer,1,4);"
NSQ_SOURCE_LINE 00000222 "        }"
NSQ_SOURCE_LINE 00000223 "        elsif ($length == 6)"
NSQ_SOURCE_LINE 00000224 "        {"
NSQ_SOURCE_LINE 00000225 "            $day  = substr($buffer,0,2);"
NSQ_SOURCE_LINE 00000226 "            $year = substr($buffer,2,4);"
NSQ_SOURCE_LINE 00000227 "        }"
NSQ_SOURCE_LINE 00000228 "        else { return(); } # wrong number of digits!"
NSQ_SOURCE_LINE 00000229 "    }"
NSQ_SOURCE_LINE 00000230 "    elsif ($buffer =~ /^[^A-Za-z0-9\\xC0-\\xD6\\xD8-\\xF6\\xF8-\\xFF]*  ([A-Za-z\\xC0-\\xD6\\xD8-\\xF6\\xF8-\\xFF]+)  [^A-Za-z0-9\\xC0-\\xD6\\xD8-\\xF6\\xF8-\\xFF]*  (\\d+)  \\D+  (\\d+)  \\D*$/x)"
NSQ_SOURCE_LINE 00000231 "    {"
NSQ_SOURCE_LINE 00000232 "        ($month,$day,$year) = ($1,$2,$3);"
NSQ_SOURCE_LINE 00000233 "        $month = Decode_Month($month,$lang);"
NSQ_SOURCE_LINE 00000234 "        unless ($month > 0)"
NSQ_SOURCE_LINE 00000235 "        {"
NSQ_SOURCE_LINE 00000236 "            return(); # can't decode month!"
NSQ_SOURCE_LINE 00000237 "        }"
NSQ_SOURCE_LINE 00000238 "    }"
NSQ_SOURCE_LINE 00000239 "    elsif ($buffer =~ /^\\D*  0*(\\d+)  \\D*$/x)"
NSQ_SOURCE_LINE 00000240 "    {"
NSQ_SOURCE_LINE 00000241 "        $buffer = $1;"
NSQ_SOURCE_LINE 00000242 "        $length = length($buffer);"
NSQ_SOURCE_LINE 00000243 "        if    ($length == 3)"
NSQ_SOURCE_LINE 00000244 "        {"
NSQ_SOURCE_LINE 00000245 "            $month = substr($buffer,0,1);"
NSQ_SOURCE_LINE 00000246 "            $day   = substr($buffer,1,1);"
