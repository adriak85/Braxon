NSQ_SOURCE_LINE 00000248 "        }"
NSQ_SOURCE_LINE 00000249 "        elsif ($length == 4)"
NSQ_SOURCE_LINE 00000250 "        {"
NSQ_SOURCE_LINE 00000251 "            $month = substr($buffer,0,1);"
