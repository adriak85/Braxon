NSQ_SOURCE_LINE 00000285 "    else { return(); } # no match at all!"
NSQ_SOURCE_LINE 00000286 "    $year = Moving_Window($year);"
NSQ_SOURCE_LINE 00000287 "    if (check_date($year,$month,$day))"
