NSQ_SOURCE_LINE 00000001 "package FFI::Platypus::Type::Enum;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use constant 1.32 ();"
NSQ_SOURCE_LINE 00000006 "use 5.008001;"
NSQ_SOURCE_LINE 00000007 "use Ref::Util qw( is_plain_arrayref is_plain_hashref is_ref );"
NSQ_SOURCE_LINE 00000008 "use Scalar::Util qw( dualvar );"
NSQ_SOURCE_LINE 00000009 "use Carp qw( croak );"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "# ABSTRACT: Custom platypus type for dealing with C enumerated types"
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.06'; # VERSION"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our @CARP_NOT = qw( FFI::Platypus );"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "sub ffi_custom_type_api_1"
NSQ_SOURCE_LINE 00000018 "{"
NSQ_SOURCE_LINE 00000019 "  my %config = defined $_[2] && is_plain_hashref $_[2]"
NSQ_SOURCE_LINE 00000020 "    ? %{ splice(@_, 2, 1) }"
NSQ_SOURCE_LINE 00000021 "    : ();"
NSQ_SOURCE_LINE 00000022 "  my(undef, undef, @values) = @_;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "  my $index = 0;"
NSQ_SOURCE_LINE 00000025 "  my %str_lookup;"
NSQ_SOURCE_LINE 00000026 "  my %int_lookup;"
NSQ_SOURCE_LINE 00000027 "  my $prefix = defined $config{prefix} ? $config{prefix} : '';"
NSQ_SOURCE_LINE 00000028 "  $config{rev} ||= 'str';"
NSQ_SOURCE_LINE 00000029 "  ($config{rev} =~ /^(int|str|dualvar)$/) or croak(\"rev must be either 'int', 'str', or 'dualvar'\");"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "  $config{casing} ||= 'upper';"
NSQ_SOURCE_LINE 00000032 "  ($config{casing} =~ /^(upper|keep)$/) or croak(\"casing must be either 'upper' or 'keep'\");"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "  foreach my $value (@values)"
NSQ_SOURCE_LINE 00000035 "  {"
NSQ_SOURCE_LINE 00000036 "    my $name;"
NSQ_SOURCE_LINE 00000037 "    my @aliases;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    if(is_plain_arrayref $value)"
NSQ_SOURCE_LINE 00000040 "    {"
NSQ_SOURCE_LINE 00000041 "      my %opt;"
NSQ_SOURCE_LINE 00000042 "      if(@$value % 2)"
NSQ_SOURCE_LINE 00000043 "      {"
NSQ_SOURCE_LINE 00000044 "        ($name,%opt) = @$value;"
NSQ_SOURCE_LINE 00000045 "      }"
NSQ_SOURCE_LINE 00000046 "      else"
NSQ_SOURCE_LINE 00000047 "      {"
NSQ_SOURCE_LINE 00000048 "        ($name,$index,%opt) = @$value;"
NSQ_SOURCE_LINE 00000049 "      }"
NSQ_SOURCE_LINE 00000050 "      @aliases = @{ delete $opt{alias} || [] };"
NSQ_SOURCE_LINE 00000051 "      croak(\"unrecognized options: @{[ sort keys %opt ]}\") if %opt;"
NSQ_SOURCE_LINE 00000052 "    }"
NSQ_SOURCE_LINE 00000053 "    elsif(!is_ref $value)"
NSQ_SOURCE_LINE 00000054 "    {"
NSQ_SOURCE_LINE 00000055 "      $name = $value;"
NSQ_SOURCE_LINE 00000056 "    }"
NSQ_SOURCE_LINE 00000057 "    else"
NSQ_SOURCE_LINE 00000058 "    {"
NSQ_SOURCE_LINE 00000059 "      croak(\"not a array ref or scalar: $value\");"
NSQ_SOURCE_LINE 00000060 "    }"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    if($index < 0)"
NSQ_SOURCE_LINE 00000063 "    {"
NSQ_SOURCE_LINE 00000064 "      $config{type} ||= 'senum';"
NSQ_SOURCE_LINE 00000065 "    }"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "    if(my $packages = $config{package})"
NSQ_SOURCE_LINE 00000068 "    {"
NSQ_SOURCE_LINE 00000069 "      foreach my $package (is_plain_arrayref $packages ? @$packages : $packages)"
NSQ_SOURCE_LINE 00000070 "      {"
NSQ_SOURCE_LINE 00000071 "        foreach my $name ($name,@aliases)"
NSQ_SOURCE_LINE 00000072 "        {"
NSQ_SOURCE_LINE 00000073 "          my $full = join '::', $package, $prefix . ( $config{casing} eq 'upper' ? uc($name) : $name );"
NSQ_SOURCE_LINE 00000074 "          constant->import($full, $index);"
NSQ_SOURCE_LINE 00000075 "        }"
NSQ_SOURCE_LINE 00000076 "      }"
NSQ_SOURCE_LINE 00000077 "    }"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    croak(\"$name declared twice\") if exists $str_lookup{$name};"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    $int_lookup{$index} = $name unless exists $int_lookup{$index};"
NSQ_SOURCE_LINE 00000082 "    $str_lookup{$_}     = $index for @aliases;"
NSQ_SOURCE_LINE 00000083 "    $str_lookup{$name}  = $index++;"
NSQ_SOURCE_LINE 00000084 "  }"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "  $config{type} ||= 'enum';"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "  if(defined $config{maps})"
NSQ_SOURCE_LINE 00000089 "  {"
NSQ_SOURCE_LINE 00000090 "    if(is_plain_arrayref $config{maps})"
NSQ_SOURCE_LINE 00000091 "    {"
NSQ_SOURCE_LINE 00000092 "      @{ $config{maps} } = (\\%str_lookup, \\%int_lookup, $config{type});"
NSQ_SOURCE_LINE 00000093 "    }"
NSQ_SOURCE_LINE 00000094 "    else"
NSQ_SOURCE_LINE 00000095 "    {"
NSQ_SOURCE_LINE 00000096 "      croak(\"maps is not an array reference\");"
NSQ_SOURCE_LINE 00000097 "    }"
NSQ_SOURCE_LINE 00000098 "  }"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "  my %type = ("
NSQ_SOURCE_LINE 00000101 "    native_type    => $config{type},"
NSQ_SOURCE_LINE 00000102 "    perl_to_native => sub {"
NSQ_SOURCE_LINE 00000103 "      exists $str_lookup{$_[0]}"
NSQ_SOURCE_LINE 00000104 "        ? $str_lookup{$_[0]}"
NSQ_SOURCE_LINE 00000105 "        : exists $int_lookup{$_[0]}"
NSQ_SOURCE_LINE 00000106 "          ? $_[0]"
NSQ_SOURCE_LINE 00000107 "          : croak(\"illegal enum value $_[0]\");"
NSQ_SOURCE_LINE 00000108 "    },"
NSQ_SOURCE_LINE 00000109 "  );"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "  if($config{rev} eq 'str')"
NSQ_SOURCE_LINE 00000112 "  {"
NSQ_SOURCE_LINE 00000113 "    $type{native_to_perl} = sub {"
NSQ_SOURCE_LINE 00000114 "      exists $int_lookup{$_[0]}"
NSQ_SOURCE_LINE 00000115 "        ? $int_lookup{$_[0]}"
NSQ_SOURCE_LINE 00000116 "        : $_[0];"
NSQ_SOURCE_LINE 00000117 "    }"
NSQ_SOURCE_LINE 00000118 "  }"
NSQ_SOURCE_LINE 00000119 "  elsif($config{rev} eq 'dualvar')"
NSQ_SOURCE_LINE 00000120 "  {"
NSQ_SOURCE_LINE 00000121 "    $type{native_to_perl} = sub {"
NSQ_SOURCE_LINE 00000122 "      exists $int_lookup{$_[0]}"
NSQ_SOURCE_LINE 00000123 "        ? dualvar( $_[0], $int_lookup{$_[0]} )"
NSQ_SOURCE_LINE 00000124 "        : $_[0];"
NSQ_SOURCE_LINE 00000125 "    };"
NSQ_SOURCE_LINE 00000126 "  }"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "  \\%type;"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "1;"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "__END__"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=pod"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 NAME"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "FFI::Platypus::Type::Enum - Custom platypus type for dealing with C enumerated types"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=head1 VERSION"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "version 0.06"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "C:"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 " enum {"
NSQ_SOURCE_LINE 00000152 "   DEFAULT,"
NSQ_SOURCE_LINE 00000153 "   BETTER,"
NSQ_SOURCE_LINE 00000154 "   BEST = 12"
NSQ_SOURCE_LINE 00000155 " } foo_t;"
NSQ_SOURCE_LINE 00000156 " "
NSQ_SOURCE_LINE 00000157 " foo_t"
NSQ_SOURCE_LINE 00000158 " f(foo_t arg)"
NSQ_SOURCE_LINE 00000159 " {"
NSQ_SOURCE_LINE 00000160 "   return foo_t;"
NSQ_SOURCE_LINE 00000161 " }"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "Perl with strings:"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 " use FFI::Platypus 1.00;"
NSQ_SOURCE_LINE 00000166 " my $ffi = FFI::Platypus->new( api => 1 );"
NSQ_SOURCE_LINE 00000167 " "
NSQ_SOURCE_LINE 00000168 " $ffi->load_custom_type('::Enum', 'foo_t',"
NSQ_SOURCE_LINE 00000169 "   'default',"
NSQ_SOURCE_LINE 00000170 "   'better',"
NSQ_SOURCE_LINE 00000171 "   ['best' => 12],"
NSQ_SOURCE_LINE 00000172 " );"
NSQ_SOURCE_LINE 00000173 " "
NSQ_SOURCE_LINE 00000174 " $ffi->attach( f => ['foo_t'] => 'foo_t' );"
NSQ_SOURCE_LINE 00000175 " "
NSQ_SOURCE_LINE 00000176 " f(\"default\") eq 'default';  # true"
NSQ_SOURCE_LINE 00000177 " f(\"default\") eq 'better';   # false"
NSQ_SOURCE_LINE 00000178 " "
NSQ_SOURCE_LINE 00000179 " print f(\"default\"), \"\\n\";   # default"
NSQ_SOURCE_LINE 00000180 " print f(\"better\"),  \"\\n\";   # better"
NSQ_SOURCE_LINE 00000181 " print f(\"best\"),    \"\\n\";   # best"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "Perl with constants:"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 " use FFI::Platypus 1.00;"
NSQ_SOURCE_LINE 00000186 " my $ffi = FFI::Platypus->new( api => 1 );"
NSQ_SOURCE_LINE 00000187 " "
NSQ_SOURCE_LINE 00000188 " $ffi->load_custom_type('::Enum', 'foo_t',"
NSQ_SOURCE_LINE 00000189 "   { rev => 'int', package => 'Foo', prefix => 'FOO_' },"
NSQ_SOURCE_LINE 00000190 "   'default',"
NSQ_SOURCE_LINE 00000191 "   'better',"
NSQ_SOURCE_LINE 00000192 "   ['best' => 12],"
NSQ_SOURCE_LINE 00000193 " );"
NSQ_SOURCE_LINE 00000194 " "
NSQ_SOURCE_LINE 00000195 " $ffi->attach( f => ['foo_t'] => 'foo_t' );"
NSQ_SOURCE_LINE 00000196 " "
NSQ_SOURCE_LINE 00000197 " f(Foo::FOO_DEFAULT) == Foo::FOO_DEFAULT;   # true"
NSQ_SOURCE_LINE 00000198 " f(Foo::FOO_DEFAULT) == Foo::FOO_BETTER;    # false"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "This type plugin is a helper for making enumerated types.  It makes the most sense"
NSQ_SOURCE_LINE 00000203 "to use this when you have an enumerated type with a small number of possible values."
NSQ_SOURCE_LINE 00000204 "For a large set of enumerated values or constants, see L<FFI::Platypus::Constant>."
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "This type plugin has two modes:"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=over 4"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=item string"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "In string mode, string representations of the enum values are converted into"
NSQ_SOURCE_LINE 00000213 "the integer enum values when passed into C, and the enums are converted back"
NSQ_SOURCE_LINE 00000214 "into strings when coming from C back into Perl.  You can also pass in the"
NSQ_SOURCE_LINE 00000215 "integer values."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=item constant"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "In constant mode, constants are defined in the specified package, and with"
NSQ_SOURCE_LINE 00000220 "the optional prefix.  The string representation or integer constants can"
NSQ_SOURCE_LINE 00000221 "be passed into C, but the integer constants are returned from C back into"
NSQ_SOURCE_LINE 00000222 "Perl."
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=back"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "In both modes, if you attempt to pass in a value that isn't one of the possible"
NSQ_SOURCE_LINE 00000227 "enum values, an exception will be thrown."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=head1 OPTIONS"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "The general form of the custom type load is:"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 " $ffi->load_custom_type('::Enum', $name, \\%options, @values);"
NSQ_SOURCE_LINE 00000234 " $ffi->load_custom_type('::Enum', $name, @values);"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "The enumerated values are specified as a list of strings and array references."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=over 4"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=item string"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 " $ffi->load_custom_type('::Enum', $name, $string1, $string2, ... );"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "For strings the constant value starts at zero (0) and increases by one for each"
NSQ_SOURCE_LINE 00000245 "possible value."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=item array reference"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 " $ffi->load_custom_type('::Enum', $name, [ $value_name, $value, %options ]);"
NSQ_SOURCE_LINE 00000250 " $ffi->load_custom_type('::Enum', $name, [ $value_name, %options ]);"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "You can use an array reference to include an explicit integer value, rather"
NSQ_SOURCE_LINE 00000253 "than using the implicit incremented value.  You can also use the array"
NSQ_SOURCE_LINE 00000254 "reference for value options.  If the value isn't included (that is if"
NSQ_SOURCE_LINE 00000255 "there are an odd number of values in the array reference), then the"
NSQ_SOURCE_LINE 00000256 "implicit incremented value will be used."
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "Value options:"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=over 4"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=item alias"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 " $ffi->load_custom_type('::Enum, $name, [ $value_name, $value, alias => \\@aliases ]);"
NSQ_SOURCE_LINE 00000265 " $ffi->load_custom_type('::Enum, $name, [ $value_name, alias => \\@aliases ]);"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "The C<alias> option lets you specify value aliases.  For example, suppose you have"
NSQ_SOURCE_LINE 00000268 "an enum definition like:"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 " enum {"
NSQ_SOURCE_LINE 00000271 "   FOO,"
NSQ_SOURCE_LINE 00000272 "   BAR,"
NSQ_SOURCE_LINE 00000273 "   BAZ=BAR,"
NSQ_SOURCE_LINE 00000274 "   ABC,"
NSQ_SOURCE_LINE 00000275 "   XYZ"
NSQ_SOURCE_LINE 00000276 " } foo_t;"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "The Perl definition would be:"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 " $ffi->load_custom_type('::Enum', 'foo_t',"
NSQ_SOURCE_LINE 00000281 "   'foo',"
NSQ_SOURCE_LINE 00000282 "   ['bar', alias => ['baz']],"
NSQ_SOURCE_LINE 00000283 "   'abc',"
NSQ_SOURCE_LINE 00000284 "   'xyz',"
NSQ_SOURCE_LINE 00000285 " );"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=back"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=back"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "Type options may be passed in as a hash reference after the type name."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "Type options:"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=over 4"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=item maps"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 " my @maps;"
NSQ_SOURCE_LINE 00000300 " $ffi->load_custom_type('::Enum', $name, { maps => \\@maps }, ... );"
NSQ_SOURCE_LINE 00000301 " my($str,$int,$type) = @maps;"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "If set to an empty array reference, this will be filled with the string, integer"
NSQ_SOURCE_LINE 00000304 "and native type for the enum."
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=item package"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 " $ffi->load_custom_type('::Enum', $name, { package => $package  }, ... );"
NSQ_SOURCE_LINE 00000309 " $ffi->load_custom_type('::Enum', $name, { package => \\@package }, ... );  # version 0.05"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "This option specifies the Perl package where constants will be defined."
NSQ_SOURCE_LINE 00000312 "If not specified, then no constants will be generated.  Unless otherwise"
NSQ_SOURCE_LINE 00000313 "specified (see 'casing' below), the constants will be the upper case of"
NSQ_SOURCE_LINE 00000314 "the value names as per the usual convention."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "[version 0.05]"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "As of version 0.05, you can specify multiple packages to create the constants via"
NSQ_SOURCE_LINE 00000319 "an array reference."
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "=item prefix"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 " $ffi->load_custom_type('::Enum', $name, { prefix => $prefix }, ... );"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "This specifies an optional prefix to give each constant.  If not specified,"
NSQ_SOURCE_LINE 00000326 "then no prefix will be used."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=item rev"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 " $ffi->load_custom_type('::Enum', $name, { rev => 'int'     }, ... );"
NSQ_SOURCE_LINE 00000331 " $ffi->load_custom_type('::Enum', $name, { rev => 'str'     }, ... );"
NSQ_SOURCE_LINE 00000332 " $ffi->load_custom_type('::Enum', $name, { rev => 'dualvar' }, ... );  # version 0.05"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "This specifies what should be returned for C functions that return the"
NSQ_SOURCE_LINE 00000335 "enumerated type.  For strings, use C<str>, and for integer constants use"
NSQ_SOURCE_LINE 00000336 "C<int>."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "(C<rev> is short for \"reverse\")"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "[version 0.05]"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "As of version 0.05, dualvar can be specified to return a string/integer"
NSQ_SOURCE_LINE 00000343 "dualvar."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=item type"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 " $ffi->load_custom_type('::Enum', $name, { type => $type }, ... );"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "This specifies the integer type that should be used for the enumerated"
NSQ_SOURCE_LINE 00000350 "type.  The default is to use C<enum> for types that only have positive"
NSQ_SOURCE_LINE 00000351 "possible values and C<senum> for types that have possible negative values."
NSQ_SOURCE_LINE 00000352 "(Note that on some platforms these two types may actually be the same)."
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "You can also use other integer types, which is useful if the enum is"
NSQ_SOURCE_LINE 00000355 "only used to define constants, and the values are stored in a type"
NSQ_SOURCE_LINE 00000356 "smaller than the default for C<enum> or C<senum>.  For example:"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "C:"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 " enum {"
NSQ_SOURCE_LINE 00000361 "   DEFAULT,"
NSQ_SOURCE_LINE 00000362 "   BETTER,"
NSQ_SOURCE_LINE 00000363 "   BEST = 12"
NSQ_SOURCE_LINE 00000364 " } foo_enum;"
NSQ_SOURCE_LINE 00000365 " typedef uint8_t foo_t;"
NSQ_SOURCE_LINE 00000366 " "
NSQ_SOURCE_LINE 00000367 " /*"
NSQ_SOURCE_LINE 00000368 "  * you are expected to use the constants from foo_enum,"
NSQ_SOURCE_LINE 00000369 "  * but the signature actually uses a uint8_t"
NSQ_SOURCE_LINE 00000370 "  */"
NSQ_SOURCE_LINE 00000371 " void f(foo_t);"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "Perl:"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 " $ffi->load_custom_type('::Enum', 'foo_t',"
NSQ_SOURCE_LINE 00000376 "   { type => 'uint8' },"
NSQ_SOURCE_LINE 00000377 "   'default',"
NSQ_SOURCE_LINE 00000378 "   'better',"
NSQ_SOURCE_LINE 00000379 "   [best => 12],"
NSQ_SOURCE_LINE 00000380 " );"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 " $ffi->attach( f => [ 'foo_t' ] => 'void' );"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "=item casing"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "[version 0.06]"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 " $ffi->load_custom_type('::Enum', $name, { casing => 'upper' }, ... );"
NSQ_SOURCE_LINE 00000389 " $ffi->load_custom_type('::Enum', $name, { casing => 'keep'  }, ... );"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "When in constant mode, all constant names are by default generated in"
NSQ_SOURCE_LINE 00000392 "uppercase as is conventional.  However, some libraries will on occasion"
NSQ_SOURCE_LINE 00000393 "define constant names in mixed case.  For these cases, the C<casing> option,"
NSQ_SOURCE_LINE 00000394 "added in version 0.06, can be set to C<keep> to prevent the names from being"
NSQ_SOURCE_LINE 00000395 "modified.  The only other allowed value is C<upper>, which is the default."
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=back"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=over 4"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=item L<FFI::Platypus>"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "=item L<FFI::C>"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=back"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "=head1 AUTHOR"
