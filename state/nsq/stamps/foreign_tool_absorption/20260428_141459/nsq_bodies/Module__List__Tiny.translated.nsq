NSQ_SOURCE_LINE 00000001 "package Module::List::Tiny;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2020-09-21'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.004003'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "#IFUNBUILT"
NSQ_SOURCE_LINE 00000007 "# # use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000008 "# # use warnings;"
NSQ_SOURCE_LINE 00000009 "#END IFUNBUILT"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "# do our own exporting to be Tiny"
NSQ_SOURCE_LINE 00000012 "sub import {"
NSQ_SOURCE_LINE 00000013 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000014 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000015 "    for my $sym (@_) {"
NSQ_SOURCE_LINE 00000016 "        if ($sym eq 'list_modules') { *{\"$caller\\::$sym\"} = \\&{$sym} }"
NSQ_SOURCE_LINE 00000017 "        else { die \"$sym is not exported!\" }"
NSQ_SOURCE_LINE 00000018 "    }"
NSQ_SOURCE_LINE 00000019 "}"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub list_modules($$) {"
NSQ_SOURCE_LINE 00000022 "    my($prefix, $options) = @_;"
NSQ_SOURCE_LINE 00000023 "    my $trivial_syntax = $options->{trivial_syntax};"
NSQ_SOURCE_LINE 00000024 "    my($root_leaf_rx, $root_notleaf_rx);"
NSQ_SOURCE_LINE 00000025 "    my($notroot_leaf_rx, $notroot_notleaf_rx);"
NSQ_SOURCE_LINE 00000026 "    if($trivial_syntax) {"
NSQ_SOURCE_LINE 00000027 "        $root_leaf_rx = $notroot_leaf_rx = qr#:?(?:[^/:]+:)*[^/:]+:?#;"
NSQ_SOURCE_LINE 00000028 "        $root_notleaf_rx = $notroot_notleaf_rx ="
NSQ_SOURCE_LINE 00000029 "            qr#:?(?:[^/:]+:)*[^/:]+#;"
NSQ_SOURCE_LINE 00000030 "    } else {"
NSQ_SOURCE_LINE 00000031 "        $root_leaf_rx = $root_notleaf_rx = qr/[a-zA-Z_][0-9a-zA-Z_]*/;"
NSQ_SOURCE_LINE 00000032 "        $notroot_leaf_rx = $notroot_notleaf_rx = qr/[0-9a-zA-Z_]+/;"
NSQ_SOURCE_LINE 00000033 "    }"
NSQ_SOURCE_LINE 00000034 "    die \"bad module name prefix `$prefix'\""
NSQ_SOURCE_LINE 00000035 "        unless $prefix =~ /\\A(?:${root_notleaf_rx}::"
NSQ_SOURCE_LINE 00000036 "                               (?:${notroot_notleaf_rx}::)*)?\\z/x &&"
NSQ_SOURCE_LINE 00000037 "                                   $prefix !~ /(?:\\A|[^:]::)\\.\\.?::/;"
NSQ_SOURCE_LINE 00000038 "    my $list_modules = $options->{list_modules};"
NSQ_SOURCE_LINE 00000039 "    my $list_prefixes = $options->{list_prefixes};"
NSQ_SOURCE_LINE 00000040 "    my $list_pod = $options->{list_pod};"
NSQ_SOURCE_LINE 00000041 "    my $use_pod_dir = $options->{use_pod_dir};"
NSQ_SOURCE_LINE 00000042 "    return {} unless $list_modules || $list_prefixes || $list_pod;"
NSQ_SOURCE_LINE 00000043 "    my $recurse = $options->{recurse};"
NSQ_SOURCE_LINE 00000044 "    my $return_path = $options->{return_path};"
NSQ_SOURCE_LINE 00000045 "    my @prefixes = ($prefix);"
NSQ_SOURCE_LINE 00000046 "    my %seen_prefixes;"
NSQ_SOURCE_LINE 00000047 "    my %results;"
NSQ_SOURCE_LINE 00000048 "    while(@prefixes) {"
NSQ_SOURCE_LINE 00000049 "        my $prefix = pop(@prefixes);"
NSQ_SOURCE_LINE 00000050 "        my @dir_suffix = split(/::/, $prefix);"
NSQ_SOURCE_LINE 00000051 "        my $module_rx ="
NSQ_SOURCE_LINE 00000052 "            $prefix eq \"\" ? $root_leaf_rx : $notroot_leaf_rx;"
NSQ_SOURCE_LINE 00000053 "        my $pm_rx = qr/\\A($module_rx)\\.pmc?\\z/;"
NSQ_SOURCE_LINE 00000054 "        my $pod_rx = qr/\\A($module_rx)\\.pod\\z/;"
NSQ_SOURCE_LINE 00000055 "        my $dir_rx ="
NSQ_SOURCE_LINE 00000056 "            $prefix eq \"\" ? $root_notleaf_rx : $notroot_notleaf_rx;"
NSQ_SOURCE_LINE 00000057 "        $dir_rx = qr/\\A$dir_rx\\z/;"
NSQ_SOURCE_LINE 00000058 "        foreach my $incdir (@INC) {"
NSQ_SOURCE_LINE 00000059 "            my $dir = join(\"/\", $incdir, @dir_suffix);"
NSQ_SOURCE_LINE 00000060 "            opendir(my $dh, $dir) or next;"
NSQ_SOURCE_LINE 00000061 "            while(defined(my $entry = readdir($dh))) {"
NSQ_SOURCE_LINE 00000062 "                if(($list_modules && $entry =~ $pm_rx) ||"
NSQ_SOURCE_LINE 00000063 "                       ($list_pod &&"
NSQ_SOURCE_LINE 00000064 "                        $entry =~ $pod_rx)) {"
NSQ_SOURCE_LINE 00000065 "                    $results{$prefix.$1} = $return_path ? \"$dir/$entry\" : undef"
NSQ_SOURCE_LINE 00000066 "                        if !exists($results{$prefix.$1});"
NSQ_SOURCE_LINE 00000067 "                } elsif(($list_prefixes || $recurse) &&"
NSQ_SOURCE_LINE 00000068 "                            ($entry ne '.' && $entry ne '..') &&"
NSQ_SOURCE_LINE 00000069 "                            $entry =~ $dir_rx &&"
NSQ_SOURCE_LINE 00000070 "                            -d join(\"/\", $dir,"
NSQ_SOURCE_LINE 00000071 "                                    $entry)) {"
NSQ_SOURCE_LINE 00000072 "                    my $newpfx = $prefix.$entry.\"::\";"
NSQ_SOURCE_LINE 00000073 "                    next if exists $seen_prefixes{$newpfx};"
NSQ_SOURCE_LINE 00000074 "                    $results{$newpfx} = $return_path ? \"$dir/$entry/\" : undef"
NSQ_SOURCE_LINE 00000075 "                        if !exists($results{$newpfx}) && $list_prefixes;"
NSQ_SOURCE_LINE 00000076 "                    push @prefixes, $newpfx if $recurse;"
NSQ_SOURCE_LINE 00000077 "                }"
NSQ_SOURCE_LINE 00000078 "            }"
NSQ_SOURCE_LINE 00000079 "            next unless $list_pod && $use_pod_dir;"
NSQ_SOURCE_LINE 00000080 "            $dir = join(\"/\", $dir, \"pod\");"
NSQ_SOURCE_LINE 00000081 "            opendir($dh, $dir) or next;"
NSQ_SOURCE_LINE 00000082 "            while(defined(my $entry = readdir($dh))) {"
NSQ_SOURCE_LINE 00000083 "                if($entry =~ $pod_rx) {"
NSQ_SOURCE_LINE 00000084 "                    $results{$prefix.$1} = $return_path ? \"$dir/$entry\" : undef;"
NSQ_SOURCE_LINE 00000085 "                }"
NSQ_SOURCE_LINE 00000086 "            }"
NSQ_SOURCE_LINE 00000087 "        }"
NSQ_SOURCE_LINE 00000088 "    }"
NSQ_SOURCE_LINE 00000089 "    return \\%results;"
NSQ_SOURCE_LINE 00000090 "}"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "1;"
NSQ_SOURCE_LINE 00000093 "# ABSTRACT: A fork of Module::List that starts faster"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "__END__"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=pod"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=head1 NAME"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "Module::List::Tiny - A fork of Module::List that starts faster"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=head1 VERSION"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "This document describes version 0.004003 of Module::List::Tiny (from Perl distribution Module-List-Tiny), released on 2020-09-21."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 " use Module::List::Tiny qw(list_modules);"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 " $id_modules = list_modules(\"Data::ID::\", { list_modules => 1});"
NSQ_SOURCE_LINE 00000114 " $prefixes = list_modules(\"\", { list_prefixes => 1, recurse => 1 });"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "This module is a fork of L<Module::List>. It's exactly like Module::List 0.004,"
NSQ_SOURCE_LINE 00000119 "except with lower startup overhead (see benchmarks in"
NSQ_SOURCE_LINE 00000120 "L<Bencher::Scenario::ListingModules::Startup>). To accomplish this, it:"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=over"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "=item * does its own exporting instead of using L<Exporter>"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=item * avoids using L<Carp> and uses the good old C<die>"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=item * avoids using L<IO::Dir> and uses plain C<opendir>"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "The problem is that IO::Dir brings in a bunch of other modules."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=item * avoids using L<File::Spec> and hard-code path separator as C</>"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "C</> happens to work everywhere with current platforms anyway."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=back"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=head2 list_modules"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "Please see L<Module::List> for more documentation."
NSQ_SOURCE_LINE 00000143 ""
