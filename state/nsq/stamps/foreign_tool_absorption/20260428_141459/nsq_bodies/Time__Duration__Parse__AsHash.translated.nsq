BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Time::Duration::Parse::AsHash;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2017-01-02'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.10.6'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "#IFUNBUILT"
NSQ_SOURCE_LINE 00000007 "# # use strict;"
NSQ_SOURCE_LINE 00000008 "# # use warnings;"
NSQ_SOURCE_LINE 00000009 "#END IFUNBUILT"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Exporter;"
NSQ_SOURCE_LINE 00000012 "our @ISA    = qw( Exporter );"
NSQ_SOURCE_LINE 00000013 "our @EXPORT = qw( parse_duration );"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "my %Units = ( map(($_, \"nanoseconds\" ), qw(ns nanosecond nanoseconds)),"
NSQ_SOURCE_LINE 00000016 "              map(($_, \"milliseconds\"), qw(ms millisecond milliseconds milisecond miliseconds)),"
NSQ_SOURCE_LINE 00000017 "              map(($_, \"microseconds\"), qw(microsecond microseconds)),"
NSQ_SOURCE_LINE 00000018 "              map(($_, \"seconds\"), qw(s second seconds sec secs)),"
NSQ_SOURCE_LINE 00000019 "              map(($_, \"minutes\"), qw(m minute minutes min mins)),"
NSQ_SOURCE_LINE 00000020 "              map(($_,   \"hours\"), qw(h hr hour hours)),"
NSQ_SOURCE_LINE 00000021 "              map(($_,    \"days\"), qw(d day days)),"
NSQ_SOURCE_LINE 00000022 "              map(($_,   \"weeks\"), qw(w week weeks)),"
NSQ_SOURCE_LINE 00000023 "              map(($_,  \"months\"), qw(M month months mon mons mo mos)),"
NSQ_SOURCE_LINE 00000024 "              map(($_,   \"years\"), qw(y year years)),"
NSQ_SOURCE_LINE 00000025 "              map(($_, \"decades\"), qw(decade decades)),"
NSQ_SOURCE_LINE 00000026 "          );"
NSQ_SOURCE_LINE 00000027 "my %Converts = ("
NSQ_SOURCE_LINE 00000028 "    nanoseconds  => [\"seconds\" => 1e-9],"
NSQ_SOURCE_LINE 00000029 "    microseconds => [\"seconds\" => 1e-6],"
NSQ_SOURCE_LINE 00000030 "    milliseconds => [\"seconds\" => 1e-3],"
NSQ_SOURCE_LINE 00000031 "    decades      => [\"years\"   => 10],"
NSQ_SOURCE_LINE 00000032 ");"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub parse_duration {"
NSQ_SOURCE_LINE 00000035 "    my $timespec = shift;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    # You can have an optional leading '+', which has no effect"
NSQ_SOURCE_LINE 00000038 "    $timespec =~ s/^\\s*\\+\\s*//;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    # Treat a plain number as a number of seconds (and parse it later)"
NSQ_SOURCE_LINE 00000041 "    if ($timespec =~ /^\\s*(-?\\d+(?:[.,]\\d+)?)\\s*$/) {"
NSQ_SOURCE_LINE 00000042 "        $timespec = \"$1s\";"
NSQ_SOURCE_LINE 00000043 "    }"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    # Convert hh:mm(:ss)? to something we understand"
NSQ_SOURCE_LINE 00000046 "    $timespec =~ s/\\b(\\d+):(\\d\\d):(\\d\\d(?:\\.\\d+)?)\\b/$1h $2m $3s/g;"
NSQ_SOURCE_LINE 00000047 "    $timespec =~ s/\\b(\\d+):(\\d\\d)\\b/$1h $2m/g;"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    my %res;"
NSQ_SOURCE_LINE 00000050 "    while ($timespec =~ s/^\\s*(-?\\d+(?:[.,]\\d+)?)\\s*([a-zA-Z]+)(?:\\s*(?:,|and)\\s*)*//i) {"
NSQ_SOURCE_LINE 00000051 "        my($amount, $unit) = ($1, $2);"
NSQ_SOURCE_LINE 00000052 "        $unit = lc($unit) unless length($unit) == 1;"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "        if (my $canon_unit = $Units{$unit}) {"
NSQ_SOURCE_LINE 00000055 "            $amount =~ s/,/./;"
NSQ_SOURCE_LINE 00000056 "            if (my $convert = $Converts{$canon_unit}) {"
NSQ_SOURCE_LINE 00000057 "                $canon_unit = $convert->[0];"
NSQ_SOURCE_LINE 00000058 "                $amount *= $convert->[1];"
NSQ_SOURCE_LINE 00000059 "            }"
NSQ_SOURCE_LINE 00000060 "            $res{$canon_unit} += $amount;"
NSQ_SOURCE_LINE 00000061 "        } else {"
NSQ_SOURCE_LINE 00000062 "            die \"Unknown timespec: $1 $2\";"
NSQ_SOURCE_LINE 00000063 "        }"
NSQ_SOURCE_LINE 00000064 "    }"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    if ($timespec =~ /\\S/) {"
NSQ_SOURCE_LINE 00000067 "        die \"Unknown timespec: $timespec\";"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    for (keys %res) {"
NSQ_SOURCE_LINE 00000071 "        delete $res{$_} if $res{$_} == 0;"
NSQ_SOURCE_LINE 00000072 "    }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    if ($_[0]) {"
NSQ_SOURCE_LINE 00000075 "        return"
NSQ_SOURCE_LINE 00000076 "            ( $res{seconds} || 0) +"
NSQ_SOURCE_LINE 00000077 "            (($res{minutes} || 0) *        60) +"
NSQ_SOURCE_LINE 00000078 "            (($res{hours}   || 0) *      3600) +"
NSQ_SOURCE_LINE 00000079 "            (($res{days}    || 0) *     86400) +"
NSQ_SOURCE_LINE 00000080 "            (($res{weeks}   || 0) *   7*86400) +"
NSQ_SOURCE_LINE 00000081 "            (($res{months}  || 0) *  30*86400) +"
NSQ_SOURCE_LINE 00000082 "            (($res{years}   || 0) * 365*86400);"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    \\%res;"
NSQ_SOURCE_LINE 00000086 "}"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "1;"
NSQ_SOURCE_LINE 00000089 "# ABSTRACT: Parse string that represents time duration"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "__END__"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=pod"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head1 NAME"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "Time::Duration::Parse::AsHash - Parse string that represents time duration"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=head1 VERSION"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "version 0.10.6"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 " use Time::Duration::Parse::AsHash;"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 " my $res = parse_duration(\"2 minutes and 3 seconds\");    # => {minutes=>2, seconds=>3}"
NSQ_SOURCE_LINE 00000110 "    $res = parse_duration(\"2m3.2s\", 1); # => 123.2"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "    $res = parse_duration(\"01:02:03\", 1); # => 3723"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "Time::Duration::Parse::AsHash is like L<Time::Duration::Parse> except:"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=over"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=item * By default it returns a hashref of parsed duration elements instead of number of seconds"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "There are some circumstances when you want this, e.g. when feeding into"
NSQ_SOURCE_LINE 00000123 "L<DateTime::Duration> and you want to count for leap seconds."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "To return number of seconds like Time::Duration::Parse, pass a true value as the"
NSQ_SOURCE_LINE 00000126 "second argument."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=item * By default seconds are not rounded"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "For example: C<\"0.1s\"> or C<100ms> will return result C<< { seconds => 0.1 } >>,"
NSQ_SOURCE_LINE 00000131 "and C<\"2.3s\"> will return C<< { seconds => 2.3 } >>."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "Also, <01:02:03> being recognized as C<1h2min3s>,"
NSQ_SOURCE_LINE 00000134 "C<01:02:03.4567> will also be recognized as C<1h2min3.4567s>."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=item * It recognizes more duration units"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "C<milliseconds> (C<ms>), which will be returned in the C<seconds> key, for"
NSQ_SOURCE_LINE 00000139 "example C<\"400ms\"> returns C<< { seconds => 0.4 } >>."
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "C<microseconds>. This will also be returned in C<seconds> key."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "C<nanoseconds> (C<ns>). This will also be returned in C<seconds> key."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "C<decades>. This will be returned in C<years> key, for example C<\"1.5 decades\">"
NSQ_SOURCE_LINE 00000146 "will return C<< { years => 15 } >>."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "=item * It has a lower startup overhead"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "By avoiding modules like L<Carp> and L<Exporter::Lite>, even L<strict> and"
NSQ_SOURCE_LINE 00000151 "L<warnings> (starts up in ~3m vs ~9ms on my computer)."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=back"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=head2 parse_duration($str [, $as_secs ]) => hash"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "Parses duration string and returns hash (unless when the second argument is"
NSQ_SOURCE_LINE 00000160 "true, in which case will return the number of seconds). Dies on parse failure."
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "Currently two forms of string are recognized: the first is a series of number"
NSQ_SOURCE_LINE 00000163 "and time units (e.g. \"2 days, 3 hours, 4.5 minutes\" or \"2h3m4s\") and the second"
NSQ_SOURCE_LINE 00000164 "is time in the format of hh:mm:ss (the seconds can contain decimal numbers) or"
NSQ_SOURCE_LINE 00000165 "hh:mm."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "This function is exported by default."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "Note that if the function is instructed to return number of seconds, the result"
NSQ_SOURCE_LINE 00000170 "is an approximation: leap seconds are not regarded (so a minute is always 60"
NSQ_SOURCE_LINE 00000171 "seconds), a month is always 30 days, a year is always 365 days."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "L<Time::Duration::Parse>"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000178 ""
