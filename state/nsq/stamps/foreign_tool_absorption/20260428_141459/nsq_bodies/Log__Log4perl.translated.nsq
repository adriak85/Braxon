NSQ_SOURCE_LINE 00000360 "}"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "##################################################"
NSQ_SOURCE_LINE 00000363 "sub get_logger {  # Get an instance (shortcut)"
NSQ_SOURCE_LINE 00000364 "##################################################"
NSQ_SOURCE_LINE 00000365 "    # get_logger() can be called in the following ways:"
NSQ_SOURCE_LINE 00000366 "    #"
NSQ_SOURCE_LINE 00000367 "    #   (1) Log::Log4perl::get_logger()     => ()"
NSQ_SOURCE_LINE 00000368 "    #   (2) Log::Log4perl->get_logger()     => (\"Log::Log4perl\")"
NSQ_SOURCE_LINE 00000369 "    #   (3) Log::Log4perl::get_logger($cat) => ($cat)"
NSQ_SOURCE_LINE 00000370 "    #   "
NSQ_SOURCE_LINE 00000371 "    #   (5) Log::Log4perl->get_logger($cat) => (\"Log::Log4perl\", $cat)"
NSQ_SOURCE_LINE 00000372 "    #   (6)   L4pSubclass->get_logger($cat) => (\"L4pSubclass\", $cat)"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "    # Note that (4) L4pSubclass->get_logger() => (\"L4pSubclass\")"
NSQ_SOURCE_LINE 00000375 "    # is indistinguishable from (3) and therefore can't be allowed."
NSQ_SOURCE_LINE 00000376 "    # Wrapper classes always have to specify the category explicitly."
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "    my $category;"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    if(@_ == 0) {"
NSQ_SOURCE_LINE 00000381 "          # 1"
NSQ_SOURCE_LINE 00000382 "        my $level = 0;"
NSQ_SOURCE_LINE 00000383 "        do { $category = scalar caller($level++);"
NSQ_SOURCE_LINE 00000384 "        } while exists $WRAPPERS_REGISTERED{ $category };"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "    } elsif(@_ == 1) {"
NSQ_SOURCE_LINE 00000387 "          # 2, 3"
NSQ_SOURCE_LINE 00000388 "        $category = $_[0];"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "        my $level = 0;"
NSQ_SOURCE_LINE 00000391 "        while(exists $WRAPPERS_REGISTERED{ $category }) { "
NSQ_SOURCE_LINE 00000392 "            $category = scalar caller($level++);"
NSQ_SOURCE_LINE 00000393 "        }"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "    } else {"
NSQ_SOURCE_LINE 00000396 "          # 5, 6"
NSQ_SOURCE_LINE 00000397 "        $category = $_[1];"
NSQ_SOURCE_LINE 00000398 "    }"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "    # Delegate this to the logger module"
NSQ_SOURCE_LINE 00000401 "    return Log::Log4perl::Logger->get_logger($category);"
NSQ_SOURCE_LINE 00000402 "}"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "###########################################"
NSQ_SOURCE_LINE 00000405 "sub caller_depth_offset {"
NSQ_SOURCE_LINE 00000406 "###########################################"
NSQ_SOURCE_LINE 00000407 "    my( $level ) = @_;"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "    my $category;"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "    { "
NSQ_SOURCE_LINE 00000412 "        my $category = scalar caller($level + 1);"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "        if(defined $category and"
NSQ_SOURCE_LINE 00000415 "           exists $WRAPPERS_REGISTERED{ $category }) {"
NSQ_SOURCE_LINE 00000416 "            $level++;"
NSQ_SOURCE_LINE 00000417 "            redo;"
NSQ_SOURCE_LINE 00000418 "        }"
NSQ_SOURCE_LINE 00000419 "    }"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "    return $level;"
NSQ_SOURCE_LINE 00000422 "}"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "##################################################"
NSQ_SOURCE_LINE 00000425 "sub appenders {  # Get a hashref of all defined appender wrappers"
NSQ_SOURCE_LINE 00000426 "##################################################"
NSQ_SOURCE_LINE 00000427 "    return \\%Log::Log4perl::Logger::APPENDER_BY_NAME;"
NSQ_SOURCE_LINE 00000428 "}"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "##################################################"
NSQ_SOURCE_LINE 00000431 "sub add_appender { # Add an appender to the system, but don't assign"
NSQ_SOURCE_LINE 00000432 "\t           # it to a logger yet"
NSQ_SOURCE_LINE 00000433 "##################################################"
NSQ_SOURCE_LINE 00000434 "    my($class, $appender) = @_;"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "    my $name = $appender->name();"
NSQ_SOURCE_LINE 00000437 "    die \"Mandatory parameter 'name' missing in appender\" unless defined $name;"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "      # Make it known by name in the Log4perl universe"
NSQ_SOURCE_LINE 00000440 "      # (so that composite appenders can find it)"
NSQ_SOURCE_LINE 00000441 "    Log::Log4perl->appenders()->{ $name } = $appender;"
NSQ_SOURCE_LINE 00000442 "}"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "##################################################"
NSQ_SOURCE_LINE 00000445 "# Return number of appenders changed"
NSQ_SOURCE_LINE 00000446 "sub appender_thresholds_adjust {  # Readjust appender thresholds"
NSQ_SOURCE_LINE 00000447 "##################################################"
NSQ_SOURCE_LINE 00000448 "        # If someone calls L4p-> and not L4p::"
NSQ_SOURCE_LINE 00000449 "    shift if $_[0] eq __PACKAGE__;"
NSQ_SOURCE_LINE 00000450 "    my($delta, $appenders) = @_;"
NSQ_SOURCE_LINE 00000451 "\tmy $retval = 0;"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "    if($delta == 0) {"
NSQ_SOURCE_LINE 00000454 "          # Nothing to do, no delta given."
NSQ_SOURCE_LINE 00000455 "        return;"
NSQ_SOURCE_LINE 00000456 "    }"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "    if(defined $appenders) {"
NSQ_SOURCE_LINE 00000459 "            # Map names to objects"
NSQ_SOURCE_LINE 00000460 "        $appenders = [map { "
NSQ_SOURCE_LINE 00000461 "                       die \"Unkown appender: '$_'\" unless exists"
NSQ_SOURCE_LINE 00000462 "                          $Log::Log4perl::Logger::APPENDER_BY_NAME{"
NSQ_SOURCE_LINE 00000463 "                            $_};"
NSQ_SOURCE_LINE 00000464 "                       $Log::Log4perl::Logger::APPENDER_BY_NAME{"
NSQ_SOURCE_LINE 00000465 "                         $_} "
NSQ_SOURCE_LINE 00000466 "                      } @$appenders];"
NSQ_SOURCE_LINE 00000467 "    } else {"
NSQ_SOURCE_LINE 00000468 "            # Just hand over all known appenders"
NSQ_SOURCE_LINE 00000469 "        $appenders = [values %{Log::Log4perl::appenders()}] unless "
NSQ_SOURCE_LINE 00000470 "            defined $appenders;"
NSQ_SOURCE_LINE 00000471 "    }"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "        # Change all appender thresholds;"
NSQ_SOURCE_LINE 00000474 "    foreach my $app (@$appenders) {"
NSQ_SOURCE_LINE 00000475 "        my $old_thres = $app->threshold();"
NSQ_SOURCE_LINE 00000476 "        my $new_thres;"
NSQ_SOURCE_LINE 00000477 "        if($delta > 0) {"
NSQ_SOURCE_LINE 00000478 "            $new_thres = Log::Log4perl::Level::get_higher_level("
NSQ_SOURCE_LINE 00000479 "                             $old_thres, $delta);"
NSQ_SOURCE_LINE 00000480 "        } else {"
NSQ_SOURCE_LINE 00000481 "            $new_thres = Log::Log4perl::Level::get_lower_level("
NSQ_SOURCE_LINE 00000482 "                             $old_thres, -$delta);"
NSQ_SOURCE_LINE 00000483 "        }"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "        ++$retval if ($app->threshold($new_thres) == $new_thres);"
NSQ_SOURCE_LINE 00000486 "    }"
NSQ_SOURCE_LINE 00000487 "\treturn $retval;"
NSQ_SOURCE_LINE 00000488 "}"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "##################################################"
NSQ_SOURCE_LINE 00000491 "sub appender_by_name {  # Get a (real) appender by name"
NSQ_SOURCE_LINE 00000492 "##################################################"
NSQ_SOURCE_LINE 00000493 "        # If someone calls L4p->appender_by_name and not L4p::appender_by_name"
NSQ_SOURCE_LINE 00000494 "    shift if $_[0] eq __PACKAGE__;"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "    my($name) = @_;"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "    if(defined $name and"
NSQ_SOURCE_LINE 00000499 "       exists $Log::Log4perl::Logger::APPENDER_BY_NAME{"
NSQ_SOURCE_LINE 00000500 "                 $name}) {"
NSQ_SOURCE_LINE 00000501 "        return $Log::Log4perl::Logger::APPENDER_BY_NAME{"
NSQ_SOURCE_LINE 00000502 "                 $name}->{appender};"
NSQ_SOURCE_LINE 00000503 "    } else {"
NSQ_SOURCE_LINE 00000504 "        return undef;"
NSQ_SOURCE_LINE 00000505 "    }"
NSQ_SOURCE_LINE 00000506 "}"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "##################################################"
NSQ_SOURCE_LINE 00000509 "sub eradicate_appender {  # Remove an appender from the system"
NSQ_SOURCE_LINE 00000510 "##################################################"
NSQ_SOURCE_LINE 00000511 "        # If someone calls L4p->... and not L4p::..."
NSQ_SOURCE_LINE 00000512 "    shift if $_[0] eq __PACKAGE__;"
NSQ_SOURCE_LINE 00000513 "    Log::Log4perl::Logger->eradicate_appender(@_);"
NSQ_SOURCE_LINE 00000514 "}"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "##################################################"
NSQ_SOURCE_LINE 00000517 "sub infiltrate_lwp {  # "
NSQ_SOURCE_LINE 00000518 "##################################################"
NSQ_SOURCE_LINE 00000519 "    no warnings qw(redefine);"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "    my $l4p_wrapper = sub {"
NSQ_SOURCE_LINE 00000522 "        my($prio, @message) = @_;"
NSQ_SOURCE_LINE 00000523 "        local $Log::Log4perl::caller_depth ="
NSQ_SOURCE_LINE 00000524 "              $Log::Log4perl::caller_depth + 2;"
NSQ_SOURCE_LINE 00000525 "        get_logger(scalar caller(1))->log($prio, @message);"
NSQ_SOURCE_LINE 00000526 "    };"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "    *LWP::Debug::trace = sub { "
NSQ_SOURCE_LINE 00000529 "        $l4p_wrapper->($INFO, @_); "
NSQ_SOURCE_LINE 00000530 "    };"
NSQ_SOURCE_LINE 00000531 "    *LWP::Debug::conns ="
NSQ_SOURCE_LINE 00000532 "    *LWP::Debug::debug = sub { "
NSQ_SOURCE_LINE 00000533 "        $l4p_wrapper->($DEBUG, @_); "
NSQ_SOURCE_LINE 00000534 "    };"
NSQ_SOURCE_LINE 00000535 "}"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "##################################################"
NSQ_SOURCE_LINE 00000538 "sub easy_closure_create {"
NSQ_SOURCE_LINE 00000539 "##################################################"
NSQ_SOURCE_LINE 00000540 "    my($caller_pkg, $entry, $code, $logger) = @_;"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "    print(\"easy_closure: Setting shortcut $caller_pkg\\::$entry \", "
NSQ_SOURCE_LINE 00000545 "         \"(logger=$logger\\n\") if _INTERNAL_DEBUG;"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "    $EASY_CLOSURES->{ $caller_pkg }->{ $entry } = $logger;"
NSQ_SOURCE_LINE 00000548 "    *{\"$caller_pkg\\::$entry\"} = $code;"
NSQ_SOURCE_LINE 00000549 "}"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "###########################################"
NSQ_SOURCE_LINE 00000552 "sub easy_closure_cleanup {"
NSQ_SOURCE_LINE 00000553 "###########################################"
NSQ_SOURCE_LINE 00000554 "    my($caller_pkg, $entry) = @_;"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "    no warnings 'redefine';"
NSQ_SOURCE_LINE 00000557 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "    my $logger = $EASY_CLOSURES->{ $caller_pkg }->{ $entry };"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "    print(\"easy_closure: Nuking easy shortcut $caller_pkg\\::$entry \", "
NSQ_SOURCE_LINE 00000562 "         \"(logger=$logger\\n\") if _INTERNAL_DEBUG;"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "    *{\"$caller_pkg\\::$entry\"} = sub { };"
NSQ_SOURCE_LINE 00000565 "    delete $EASY_CLOSURES->{ $caller_pkg }->{ $entry };"
NSQ_SOURCE_LINE 00000566 "}"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "##################################################"
NSQ_SOURCE_LINE 00000569 "sub easy_closure_category_cleanup {"
NSQ_SOURCE_LINE 00000570 "##################################################"
NSQ_SOURCE_LINE 00000571 "    my($caller_pkg) = @_;"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "    if(! exists $EASY_CLOSURES->{ $caller_pkg } ) {"
NSQ_SOURCE_LINE 00000574 "        return 1;"
NSQ_SOURCE_LINE 00000575 "    }"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "    for my $entry ( keys %{ $EASY_CLOSURES->{ $caller_pkg } } ) {"
NSQ_SOURCE_LINE 00000578 "        easy_closure_cleanup( $caller_pkg, $entry );"
NSQ_SOURCE_LINE 00000579 "    }"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "    delete $EASY_CLOSURES->{ $caller_pkg };"
NSQ_SOURCE_LINE 00000582 "}"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "###########################################"
NSQ_SOURCE_LINE 00000585 "sub easy_closure_global_cleanup {"
NSQ_SOURCE_LINE 00000586 "###########################################"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "    for my $caller_pkg ( keys %$EASY_CLOSURES ) {"
NSQ_SOURCE_LINE 00000589 "        easy_closure_category_cleanup( $caller_pkg );"
NSQ_SOURCE_LINE 00000590 "    }"
NSQ_SOURCE_LINE 00000591 "}"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "###########################################"
NSQ_SOURCE_LINE 00000594 "sub easy_closure_logger_remove {"
NSQ_SOURCE_LINE 00000595 "###########################################"
NSQ_SOURCE_LINE 00000596 "    my($class, $logger) = @_;"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "    PKG: for my $caller_pkg ( keys %$EASY_CLOSURES ) {"
NSQ_SOURCE_LINE 00000599 "        for my $entry ( keys %{ $EASY_CLOSURES->{ $caller_pkg } } ) {"
NSQ_SOURCE_LINE 00000600 "            if( $logger == $EASY_CLOSURES->{ $caller_pkg }->{ $entry } ) {"
NSQ_SOURCE_LINE 00000601 "                easy_closure_category_cleanup( $caller_pkg );"
NSQ_SOURCE_LINE 00000602 "                next PKG;"
NSQ_SOURCE_LINE 00000603 "            }"
NSQ_SOURCE_LINE 00000604 "        }"
NSQ_SOURCE_LINE 00000605 "    }"
NSQ_SOURCE_LINE 00000606 "}"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "##################################################"
NSQ_SOURCE_LINE 00000609 "sub remove_logger {"
NSQ_SOURCE_LINE 00000610 "##################################################"
NSQ_SOURCE_LINE 00000611 "    my ($class, $logger) = @_;"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "    # Any stealth logger convenience function still using it will"
NSQ_SOURCE_LINE 00000614 "    # now become a no-op."
NSQ_SOURCE_LINE 00000615 "    Log::Log4perl->easy_closure_logger_remove( $logger );"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "    # Remove the logger from the system"
NSQ_SOURCE_LINE 00000618 "      # Need to split this up in two lines, or CVS will"
NSQ_SOURCE_LINE 00000619 "      # mess it up."
NSQ_SOURCE_LINE 00000620 "    delete $Log::Log4perl::Logger::LOGGERS_BY_NAME->{ "
NSQ_SOURCE_LINE 00000621 "      $logger->{category} };"
NSQ_SOURCE_LINE 00000622 "}"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "1;"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "__END__"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "=encoding utf8"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "=head1 NAME"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "Log::Log4perl - Log4j implementation for Perl"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000635 "        "
NSQ_SOURCE_LINE 00000636 "\t\t# Easy mode if you like it simple ..."
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "    use Log::Log4perl qw(:easy);"
NSQ_SOURCE_LINE 00000639 "    Log::Log4perl->easy_init($ERROR);"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "    DEBUG \"This doesn't go anywhere\";"
NSQ_SOURCE_LINE 00000642 "    ERROR \"This gets logged\";"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "        # ... or standard mode for more features:"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "    Log::Log4perl::init('/etc/log4perl.conf');"
NSQ_SOURCE_LINE 00000647 "    "
NSQ_SOURCE_LINE 00000648 "    --or--"
NSQ_SOURCE_LINE 00000649 "    "
NSQ_SOURCE_LINE 00000650 "        # Check config every 10 secs"
NSQ_SOURCE_LINE 00000651 "    Log::Log4perl::init_and_watch('/etc/log4perl.conf',10);"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "    --then--"
NSQ_SOURCE_LINE 00000654 "    "
NSQ_SOURCE_LINE 00000655 "    $logger = Log::Log4perl->get_logger('house.bedrm.desk.topdrwr');"
NSQ_SOURCE_LINE 00000656 "    "
NSQ_SOURCE_LINE 00000657 "    $logger->debug('this is a debug message');"
NSQ_SOURCE_LINE 00000658 "    $logger->info('this is an info message');"
NSQ_SOURCE_LINE 00000659 "    $logger->warn('etc');"
NSQ_SOURCE_LINE 00000660 "    $logger->error('..');"
NSQ_SOURCE_LINE 00000661 "    $logger->fatal('..');"
NSQ_SOURCE_LINE 00000662 "    "
NSQ_SOURCE_LINE 00000663 "    #####/etc/log4perl.conf###############################"
NSQ_SOURCE_LINE 00000664 "    log4perl.logger.house              = WARN,  FileAppndr1"
NSQ_SOURCE_LINE 00000665 "    log4perl.logger.house.bedroom.desk = DEBUG, FileAppndr1"
NSQ_SOURCE_LINE 00000666 "    "
NSQ_SOURCE_LINE 00000667 "    log4perl.appender.FileAppndr1      = Log::Log4perl::Appender::File"
NSQ_SOURCE_LINE 00000668 "    log4perl.appender.FileAppndr1.filename = desk.log "
NSQ_SOURCE_LINE 00000669 "    log4perl.appender.FileAppndr1.layout   = \\"
NSQ_SOURCE_LINE 00000670 "                            Log::Log4perl::Layout::SimpleLayout"
NSQ_SOURCE_LINE 00000671 "    ######################################################"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "=head1 ABSTRACT"
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "Log::Log4perl provides a powerful logging API for your application"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "Log::Log4perl lets you remote-control and fine-tune the logging behaviour"
NSQ_SOURCE_LINE 00000680 "of your system from the outside. It implements the widely popular "
NSQ_SOURCE_LINE 00000681 "(Java-based) Log4j logging package in pure Perl. "
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "B<For a detailed tutorial on Log::Log4perl usage, please read> "
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "L<http://www.perl.com/pub/a/2002/09/11/log4perl.html>"
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "Logging beats a debugger if you want to know what's going on "
NSQ_SOURCE_LINE 00000688 "in your code during runtime. However, traditional logging packages"
NSQ_SOURCE_LINE 00000689 "are too static and generate a flood of log messages in your log files"
NSQ_SOURCE_LINE 00000690 "that won't help you."
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "C<Log::Log4perl> is different. It allows you to control the number of "
NSQ_SOURCE_LINE 00000693 "logging messages generated at three different levels:"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "=over 4"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "=item *"
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "At a central location in your system (either in a configuration file or"
NSQ_SOURCE_LINE 00000700 "in the startup code) you specify I<which components> (classes, functions) "
NSQ_SOURCE_LINE 00000701 "of your system should generate logs."
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "=item *"
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "You specify how detailed the logging of these components should be by"
NSQ_SOURCE_LINE 00000706 "specifying logging I<levels>."
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "=item *"
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "You also specify which so-called I<appenders> you want to feed your"
NSQ_SOURCE_LINE 00000711 "log messages to (\"Print it to the screen and also append it to /tmp/my.log\")"
NSQ_SOURCE_LINE 00000712 "and which format (\"Write the date first, then the file name and line "
NSQ_SOURCE_LINE 00000713 "number, and then the log message\") they should be in."
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "=back"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "This is a very powerful and flexible mechanism. You can turn on and off"
NSQ_SOURCE_LINE 00000718 "your logs at any time, specify the level of detail and make that"
NSQ_SOURCE_LINE 00000719 "dependent on the subsystem that's currently executed. "
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "Let me give you an example: You might "
NSQ_SOURCE_LINE 00000722 "find out that your system has a problem in the "
NSQ_SOURCE_LINE 00000723 "C<MySystem::Helpers::ScanDir>"
NSQ_SOURCE_LINE 00000724 "component. Turning on detailed debugging logs all over the system would"
NSQ_SOURCE_LINE 00000725 "generate a flood of useless log messages and bog your system down beyond"
NSQ_SOURCE_LINE 00000726 "recognition. With C<Log::Log4perl>, however, you can tell the system:"
NSQ_SOURCE_LINE 00000727 "\"Continue to log only severe errors to the log file. Open a second"
NSQ_SOURCE_LINE 00000728 "log file, turn on full debug logs in the C<MySystem::Helpers::ScanDir>"
NSQ_SOURCE_LINE 00000729 "component and dump all messages originating from there into the new"
NSQ_SOURCE_LINE 00000730 "log file\". And all this is possible by just changing the parameters"
NSQ_SOURCE_LINE 00000731 "in a configuration file, which your system can re-read even "
NSQ_SOURCE_LINE 00000732 "while it's running!"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "=head1 How to use it"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "The C<Log::Log4perl> package can be initialized in two ways: Either"
NSQ_SOURCE_LINE 00000737 "via Perl commands or via a C<log4j>-style configuration file."
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "=head2 Initialize via a configuration file"
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "This is the easiest way to prepare your system for using"
NSQ_SOURCE_LINE 00000742 "C<Log::Log4perl>. Use a configuration file like this:"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "    ############################################################"
NSQ_SOURCE_LINE 00000745 "    # A simple root logger with a Log::Log4perl::Appender::File "
NSQ_SOURCE_LINE 00000746 "    # file appender in Perl."
NSQ_SOURCE_LINE 00000747 "    ############################################################"
NSQ_SOURCE_LINE 00000748 "    log4perl.rootLogger=ERROR, LOGFILE"
NSQ_SOURCE_LINE 00000749 "    "
NSQ_SOURCE_LINE 00000750 "    log4perl.appender.LOGFILE=Log::Log4perl::Appender::File"
NSQ_SOURCE_LINE 00000751 "    log4perl.appender.LOGFILE.filename=/var/log/myerrs.log"
NSQ_SOURCE_LINE 00000752 "    log4perl.appender.LOGFILE.mode=append"
NSQ_SOURCE_LINE 00000753 "    "
NSQ_SOURCE_LINE 00000754 "    log4perl.appender.LOGFILE.layout=PatternLayout"
NSQ_SOURCE_LINE 00000755 "    log4perl.appender.LOGFILE.layout.ConversionPattern=[%r] %F %L %c - %m%n"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "These lines define your standard logger that's appending severe"
NSQ_SOURCE_LINE 00000758 "errors to C</var/log/myerrs.log>, using the format"
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "    [millisecs] source-filename line-number class - message newline"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "Assuming that this configuration file is saved as C<log.conf>, you need to "
NSQ_SOURCE_LINE 00000763 "read it in the startup section of your code, using the following"
NSQ_SOURCE_LINE 00000764 "commands:"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "  use Log::Log4perl;"
NSQ_SOURCE_LINE 00000767 "  Log::Log4perl->init(\"log.conf\");"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "After that's done I<somewhere> in the code, you can retrieve"
NSQ_SOURCE_LINE 00000770 "logger objects I<anywhere> in the code. Note that"
NSQ_SOURCE_LINE 00000771 "there's no need to carry any logger references around with your "
NSQ_SOURCE_LINE 00000772 "functions and methods. You can get a logger anytime via a singleton"
NSQ_SOURCE_LINE 00000773 "mechanism:"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "    package My::MegaPackage;"
NSQ_SOURCE_LINE 00000776 "    use  Log::Log4perl;"
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "    sub some_method {"
NSQ_SOURCE_LINE 00000779 "        my($param) = @_;"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "        my $log = Log::Log4perl->get_logger(\"My::MegaPackage\");"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "        $log->debug(\"Debug message\");"
NSQ_SOURCE_LINE 00000784 "        $log->info(\"Info message\");"
NSQ_SOURCE_LINE 00000785 "        $log->error(\"Error message\");"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "        ..."
NSQ_SOURCE_LINE 00000788 "    }"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "With the configuration file above, C<Log::Log4perl> will write"
NSQ_SOURCE_LINE 00000791 "\"Error message\" to the specified log file, but won't do anything for "
NSQ_SOURCE_LINE 00000792 "the C<debug()> and C<info()> calls, because the log level has been set"
NSQ_SOURCE_LINE 00000793 "to C<ERROR> for all components in the first line of "
NSQ_SOURCE_LINE 00000794 "configuration file shown above."
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "Why C<Log::Log4perl-E<gt>get_logger> and"
NSQ_SOURCE_LINE 00000797 "not C<Log::Log4perl-E<gt>new>? We don't want to create a new"
NSQ_SOURCE_LINE 00000798 "object every time. Usually in OO-Programming, you create an object"
NSQ_SOURCE_LINE 00000799 "once and use the reference to it to call its methods. However,"
NSQ_SOURCE_LINE 00000800 "this requires that you pass around the object to all functions"
NSQ_SOURCE_LINE 00000801 "and the last thing we want is pollute each and every function/method"
NSQ_SOURCE_LINE 00000802 "we're using with a handle to the C<Logger>:"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "    sub function {  # Brrrr!!"
NSQ_SOURCE_LINE 00000805 "        my($logger, $some, $other, $parameters) = @_;"
NSQ_SOURCE_LINE 00000806 "    }"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "Instead, if a function/method wants a reference to the logger, it"
NSQ_SOURCE_LINE 00000809 "just calls the Logger's static C<get_logger($category)> method to obtain"
NSQ_SOURCE_LINE 00000810 "a reference to the I<one and only> possible logger object of"
NSQ_SOURCE_LINE 00000811 "a certain category."
NSQ_SOURCE_LINE 00000812 "That's called a I<singleton> if you're a Gamma fan."
NSQ_SOURCE_LINE 00000813 ""
NSQ_SOURCE_LINE 00000814 "How does the logger know"
NSQ_SOURCE_LINE 00000815 "which messages it is supposed to log and which ones to suppress?"
NSQ_SOURCE_LINE 00000816 "C<Log::Log4perl> works with inheritance: The config file above didn't "
NSQ_SOURCE_LINE 00000817 "specify anything about C<My::MegaPackage>. "
NSQ_SOURCE_LINE 00000818 "And yet, we've defined a logger of the category "
NSQ_SOURCE_LINE 00000819 "C<My::MegaPackage>."
NSQ_SOURCE_LINE 00000820 "In this case, C<Log::Log4perl> will walk up the namespace hierarchy"
NSQ_SOURCE_LINE 00000821 "(C<My> and then we're at the root) to figure out if a log level is"
NSQ_SOURCE_LINE 00000822 "defined somewhere. In the case above, the log level at the root"
NSQ_SOURCE_LINE 00000823 "(root I<always> defines a log level, but not necessarily an appender)"
NSQ_SOURCE_LINE 00000824 "defines that "
NSQ_SOURCE_LINE 00000825 "the log level is supposed to be C<ERROR> -- meaning that I<DEBUG>"
NSQ_SOURCE_LINE 00000826 "and I<INFO> messages are suppressed. Note that this 'inheritance' is"
NSQ_SOURCE_LINE 00000827 "unrelated to Perl's class inheritance, it is merely related to the"
NSQ_SOURCE_LINE 00000828 "logger namespace."
NSQ_SOURCE_LINE 00000829 "By the way, if you're ever in doubt about what a logger's category is, "
NSQ_SOURCE_LINE 00000830 "use C<$logger-E<gt>category()> to retrieve it."
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "=head2 Log Levels"
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "There are six predefined log levels: C<FATAL>, C<ERROR>, C<WARN>, C<INFO>,"
NSQ_SOURCE_LINE 00000835 "C<DEBUG>, and C<TRACE> (in descending priority). Your configured logging level"
NSQ_SOURCE_LINE 00000836 "has to at least match the priority of the logging message."
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "If your configured logging level is C<WARN>, then messages logged "
NSQ_SOURCE_LINE 00000839 "with C<info()>, C<debug()>, and C<trace()> will be suppressed. "
NSQ_SOURCE_LINE 00000840 "C<fatal()>, C<error()> and C<warn()> will make their way through,"
NSQ_SOURCE_LINE 00000841 "because their priority is higher or equal than the configured setting."
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "Instead of calling the methods"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "    $logger->trace(\"...\");  # Log a trace message"
NSQ_SOURCE_LINE 00000846 "    $logger->debug(\"...\");  # Log a debug message"
NSQ_SOURCE_LINE 00000847 "    $logger->info(\"...\");   # Log a info message"
NSQ_SOURCE_LINE 00000848 "    $logger->warn(\"...\");   # Log a warn message"
NSQ_SOURCE_LINE 00000849 "    $logger->error(\"...\");  # Log a error message"
NSQ_SOURCE_LINE 00000850 "    $logger->fatal(\"...\");  # Log a fatal message"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "you could also call the C<log()> method with the appropriate level"
NSQ_SOURCE_LINE 00000853 "using the constants defined in C<Log::Log4perl::Level>:"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "    use Log::Log4perl::Level;"
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "    $logger->log($TRACE, \"...\");"
NSQ_SOURCE_LINE 00000858 "    $logger->log($DEBUG, \"...\");"
NSQ_SOURCE_LINE 00000859 "    $logger->log($INFO, \"...\");"
NSQ_SOURCE_LINE 00000860 "    $logger->log($WARN, \"...\");"
NSQ_SOURCE_LINE 00000861 "    $logger->log($ERROR, \"...\");"
NSQ_SOURCE_LINE 00000862 "    $logger->log($FATAL, \"...\");"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "This form is rarely used, but it comes in handy if you want to log "
NSQ_SOURCE_LINE 00000865 "at different levels depending on an exit code of a function:"
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 "    $logger->log( $exit_level{ $rc }, \"...\");"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "As for needing more logging levels than these predefined ones: It's"
NSQ_SOURCE_LINE 00000870 "usually best to steer your logging behaviour via the category "
NSQ_SOURCE_LINE 00000871 "mechanism instead."
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "If you need to find out if the currently configured logging"
NSQ_SOURCE_LINE 00000874 "level would allow a logger's logging statement to go through, use the"
NSQ_SOURCE_LINE 00000875 "logger's C<is_I<level>()> methods:"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "    $logger->is_trace()    # True if trace messages would go through"
NSQ_SOURCE_LINE 00000878 "    $logger->is_debug()    # True if debug messages would go through"
NSQ_SOURCE_LINE 00000879 "    $logger->is_info()     # True if info messages would go through"
NSQ_SOURCE_LINE 00000880 "    $logger->is_warn()     # True if warn messages would go through"
NSQ_SOURCE_LINE 00000881 "    $logger->is_error()    # True if error messages would go through"
NSQ_SOURCE_LINE 00000882 "    $logger->is_fatal()    # True if fatal messages would go through"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "Example: C<$logger-E<gt>is_warn()> returns true if the logger's current"
NSQ_SOURCE_LINE 00000885 "level, as derived from either the logger's category (or, in absence of"
NSQ_SOURCE_LINE 00000886 "that, one of the logger's parent's level setting) is "
NSQ_SOURCE_LINE 00000887 "C<$WARN>, C<$ERROR> or C<$FATAL>."
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "Also available are a series of more Java-esque functions which return"
NSQ_SOURCE_LINE 00000890 "the same values. These are of the format C<isI<Level>Enabled()>,"
NSQ_SOURCE_LINE 00000891 "so C<$logger-E<gt>isDebugEnabled()> is synonymous to "
NSQ_SOURCE_LINE 00000892 "C<$logger-E<gt>is_debug()>."
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "These level checking functions"
NSQ_SOURCE_LINE 00000896 "will come in handy later, when we want to block unnecessary"
NSQ_SOURCE_LINE 00000897 "expensive parameter construction in case the logging level is too"
NSQ_SOURCE_LINE 00000898 "low to log the statement anyway, like in:"
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "    if($logger->is_error()) {"
NSQ_SOURCE_LINE 00000901 "        $logger->error(\"Erroneous array: @super_long_array\");"
NSQ_SOURCE_LINE 00000902 "    }"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "If we had just written"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "    $logger->error(\"Erroneous array: @super_long_array\");"
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "then Perl would have interpolated"
NSQ_SOURCE_LINE 00000909 "C<@super_long_array> into the string via an expensive operation"
NSQ_SOURCE_LINE 00000910 "only to figure out shortly after that the string can be ignored"
NSQ_SOURCE_LINE 00000911 "entirely because the configured logging level is lower than C<$ERROR>."
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "The to-be-logged"
NSQ_SOURCE_LINE 00000914 "message passed to all of the functions described above can"
NSQ_SOURCE_LINE 00000915 "consist of an arbitrary number of arguments, which the logging functions"
NSQ_SOURCE_LINE 00000916 "just chain together to a single string. Therefore"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "    $logger->debug(\"Hello \", \"World\", \"!\");  # and"
NSQ_SOURCE_LINE 00000919 "    $logger->debug(\"Hello World!\");"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "are identical."
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "Note that even if one of the methods above returns true, it doesn't "
NSQ_SOURCE_LINE 00000924 "necessarily mean that the message will actually get logged. "
NSQ_SOURCE_LINE 00000925 "What is_debug() checks is that"
NSQ_SOURCE_LINE 00000926 "the logger used is configured to let a message of the given priority "
NSQ_SOURCE_LINE 00000927 "(DEBUG) through. But after this check, Log4perl will eventually apply custom "
NSQ_SOURCE_LINE 00000928 "filters and forward the message to one or more appenders. None of this"
NSQ_SOURCE_LINE 00000929 "gets checked by is_xxx(), for the simple reason that it's "
NSQ_SOURCE_LINE 00000930 "impossible to know what a custom filter does with a message without"
NSQ_SOURCE_LINE 00000931 "having the actual message or what an appender does to a message without"
NSQ_SOURCE_LINE 00000932 "actually having it log it."
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "=head2 Log and die or warn"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "Often, when you croak / carp / warn / die, you want to log those messages."
NSQ_SOURCE_LINE 00000937 "Rather than doing the following:"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "    $logger->fatal($err) && die($err);"
NSQ_SOURCE_LINE 00000940 ""
NSQ_SOURCE_LINE 00000941 "you can use the following:"
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "    $logger->logdie($err);"
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 "And if instead of using"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "    warn($message);"
NSQ_SOURCE_LINE 00000948 "    $logger->warn($message);"
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "to both issue a warning via Perl's warn() mechanism and make sure you have"
NSQ_SOURCE_LINE 00000951 "the same message in the log file as well, use:"
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "    $logger->logwarn($message);"
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 "Since there is"
NSQ_SOURCE_LINE 00000956 "an ERROR level between WARN and FATAL, there are two additional helper"
NSQ_SOURCE_LINE 00000957 "functions in case you'd like to use ERROR for either warn() or die():"
NSQ_SOURCE_LINE 00000958 ""
NSQ_SOURCE_LINE 00000959 "    $logger->error_warn();"
NSQ_SOURCE_LINE 00000960 "    $logger->error_die();"
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "Finally, there's the Carp functions that, in addition to logging,"
NSQ_SOURCE_LINE 00000963 "also pass the stringified message to their companions in the Carp package:"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "    $logger->logcarp();        # warn w/ 1-level stack trace"
NSQ_SOURCE_LINE 00000966 "    $logger->logcluck();       # warn w/ full stack trace"
NSQ_SOURCE_LINE 00000967 "    $logger->logcroak();       # die w/ 1-level stack trace"
NSQ_SOURCE_LINE 00000968 "    $logger->logconfess();     # die w/ full stack trace"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "=head2 Appenders"
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "If you don't define any appenders, nothing will happen. Appenders will"
NSQ_SOURCE_LINE 00000973 "be triggered whenever the configured logging level requires a message"
NSQ_SOURCE_LINE 00000974 "to be logged and not suppressed."
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "C<Log::Log4perl> doesn't define any appenders by default, not even the root"
NSQ_SOURCE_LINE 00000977 "logger has one."
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "C<Log::Log4perl> already comes with a standard set of appenders:"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "    Log::Log4perl::Appender::Screen"
NSQ_SOURCE_LINE 00000982 "    Log::Log4perl::Appender::ScreenColoredLevels"
NSQ_SOURCE_LINE 00000983 "    Log::Log4perl::Appender::File"
NSQ_SOURCE_LINE 00000984 "    Log::Log4perl::Appender::Socket"
NSQ_SOURCE_LINE 00000985 "    Log::Log4perl::Appender::DBI"
NSQ_SOURCE_LINE 00000986 "    Log::Log4perl::Appender::Synchronized"
NSQ_SOURCE_LINE 00000987 "    Log::Log4perl::Appender::RRDs"
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "to log to the screen, to files and to databases. "
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "On CPAN, you can find additional appenders like"
NSQ_SOURCE_LINE 00000992 ""
NSQ_SOURCE_LINE 00000993 "    Log::Log4perl::Layout::XMLLayout"
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "by Guido Carls E<lt>gcarls@cpan.orgE<gt>."
NSQ_SOURCE_LINE 00000996 "It allows for hooking up Log::Log4perl with the graphical Log Analyzer"
NSQ_SOURCE_LINE 00000997 "Chainsaw (see "
NSQ_SOURCE_LINE 00000998 "L<Log::Log4perl::FAQ/\"Can I use Log::Log4perl with log4j's Chainsaw?\">)."
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "=head2 Additional Appenders via Log::Dispatch"
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "C<Log::Log4perl> also supports I<Dave Rolskys> excellent C<Log::Dispatch>"
NSQ_SOURCE_LINE 00001003 "framework which implements a wide variety of different appenders. "
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "Here's the list of appender modules currently available via C<Log::Dispatch>:"
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "       Log::Dispatch::ApacheLog"
NSQ_SOURCE_LINE 00001008 "       Log::Dispatch::DBI (by Tatsuhiko Miyagawa)"
NSQ_SOURCE_LINE 00001009 "       Log::Dispatch::Email,"
NSQ_SOURCE_LINE 00001010 "       Log::Dispatch::Email::MailSend,"
NSQ_SOURCE_LINE 00001011 "       Log::Dispatch::Email::MailSendmail,"
NSQ_SOURCE_LINE 00001012 "       Log::Dispatch::Email::MIMELite"
NSQ_SOURCE_LINE 00001013 "       Log::Dispatch::File"
NSQ_SOURCE_LINE 00001014 "       Log::Dispatch::FileRotate (by Mark Pfeiffer)"
NSQ_SOURCE_LINE 00001015 "       Log::Dispatch::Handle"
NSQ_SOURCE_LINE 00001016 "       Log::Dispatch::Screen"
NSQ_SOURCE_LINE 00001017 "       Log::Dispatch::Syslog"
NSQ_SOURCE_LINE 00001018 "       Log::Dispatch::Tk (by Dominique Dumont)"
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "Please note that in order to use any of these additional appenders, you"
NSQ_SOURCE_LINE 00001021 "have to fetch Log::Dispatch from CPAN and install it. Also the particular"
NSQ_SOURCE_LINE 00001022 "appender you're using might require installing the particular module."
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "For additional information on appenders, please check the"
NSQ_SOURCE_LINE 00001025 "L<Log::Log4perl::Appender> manual page."
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "=head2 Appender Example"
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "Now let's assume that we want to log C<info()> or"
NSQ_SOURCE_LINE 00001030 "higher prioritized messages in the C<Foo::Bar> category"
NSQ_SOURCE_LINE 00001031 "to both STDOUT and to a log file, say C<test.log>."
NSQ_SOURCE_LINE 00001032 "In the initialization section of your system,"
NSQ_SOURCE_LINE 00001033 "just define two appenders using the readily available"
NSQ_SOURCE_LINE 00001034 "C<Log::Log4perl::Appender::File> and C<Log::Log4perl::Appender::Screen> "
NSQ_SOURCE_LINE 00001035 "modules:"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "  use Log::Log4perl;"
NSQ_SOURCE_LINE 00001038 ""
NSQ_SOURCE_LINE 00001039 "     # Configuration in a string ..."
NSQ_SOURCE_LINE 00001040 "  my $conf = q("
NSQ_SOURCE_LINE 00001041 "    log4perl.category.Foo.Bar          = INFO, Logfile, Screen"
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "    log4perl.appender.Logfile          = Log::Log4perl::Appender::File"
NSQ_SOURCE_LINE 00001044 "    log4perl.appender.Logfile.filename = test.log"
NSQ_SOURCE_LINE 00001045 "    log4perl.appender.Logfile.layout   = Log::Log4perl::Layout::PatternLayout"
NSQ_SOURCE_LINE 00001046 "    log4perl.appender.Logfile.layout.ConversionPattern = [%r] %F %L %m%n"
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "    log4perl.appender.Screen         = Log::Log4perl::Appender::Screen"
NSQ_SOURCE_LINE 00001049 "    log4perl.appender.Screen.stderr  = 0"
NSQ_SOURCE_LINE 00001050 "    log4perl.appender.Screen.layout = Log::Log4perl::Layout::SimpleLayout"
NSQ_SOURCE_LINE 00001051 "  );"
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "     # ... passed as a reference to init()"
NSQ_SOURCE_LINE 00001054 "  Log::Log4perl::init( \\$conf );"
NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 "Once the initialization shown above has happened once, typically in"
NSQ_SOURCE_LINE 00001057 "the startup code of your system, just use the defined logger anywhere in "
NSQ_SOURCE_LINE 00001058 "your system:"
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "  ##########################"
NSQ_SOURCE_LINE 00001061 "  # ... in some function ..."
NSQ_SOURCE_LINE 00001062 "  ##########################"
NSQ_SOURCE_LINE 00001063 "  my $log = Log::Log4perl::get_logger(\"Foo::Bar\");"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "    # Logs both to STDOUT and to the file test.log"
NSQ_SOURCE_LINE 00001066 "  $log->info(\"Important Info!\");"
NSQ_SOURCE_LINE 00001067 ""
NSQ_SOURCE_LINE 00001068 "The C<layout> settings specified in the configuration section define the "
NSQ_SOURCE_LINE 00001069 "format in which the"
NSQ_SOURCE_LINE 00001070 "message is going to be logged by the specified appender. The format shown"
NSQ_SOURCE_LINE 00001071 "for the file appender is logging not only the message but also the number of"
NSQ_SOURCE_LINE 00001072 "milliseconds since the program has started (%r), the name of the file"
NSQ_SOURCE_LINE 00001073 "the call to the logger has happened and the line number there (%F and"
NSQ_SOURCE_LINE 00001074 "%L), the message itself (%m) and a OS-specific newline character (%n):"
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 "    [187] ./myscript.pl 27 Important Info!"
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 "The"
NSQ_SOURCE_LINE 00001079 "screen appender above, on the other hand, "
NSQ_SOURCE_LINE 00001080 "uses a C<SimpleLayout>, which logs the "
NSQ_SOURCE_LINE 00001081 "debug level, a hyphen (-) and the log message:"
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "    INFO - Important Info!"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "For more detailed info on layout formats, see L<Log Layouts>. "
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 "In the configuration sample above, we chose to define a I<category> "
NSQ_SOURCE_LINE 00001088 "logger (C<Foo::Bar>)."
NSQ_SOURCE_LINE 00001089 "This will cause only messages originating from"
NSQ_SOURCE_LINE 00001090 "this specific category logger to be logged in the defined format"
NSQ_SOURCE_LINE 00001091 "and locations."
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "=head2 Logging newlines"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "There's some controversy between different logging systems as to when and "
NSQ_SOURCE_LINE 00001096 "where newlines are supposed to be added to logged messages."
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "The Log4perl way is that a logging statement I<should not> "
NSQ_SOURCE_LINE 00001099 "contain a newline:"
NSQ_SOURCE_LINE 00001100 ""
NSQ_SOURCE_LINE 00001101 "    $logger->info(\"Some message\");"
NSQ_SOURCE_LINE 00001102 "    $logger->info(\"Another message\");"
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 "If this is supposed to end up in a log file like"
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 "    Some message"
NSQ_SOURCE_LINE 00001107 "    Another message"
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "then an appropriate appender layout like \"%m%n\" will take care of adding"
NSQ_SOURCE_LINE 00001110 "a newline at the end of each message to make sure every message is "
NSQ_SOURCE_LINE 00001111 "printed on its own line."
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "Other logging systems, Log::Dispatch in particular, recommend adding the"
NSQ_SOURCE_LINE 00001114 "newline to the log statement. This doesn't work well, however, if you, say,"
NSQ_SOURCE_LINE 00001115 "replace your file appender by a database appender, and all of a sudden"
NSQ_SOURCE_LINE 00001116 "those newlines scattered around the code don't make sense anymore."
NSQ_SOURCE_LINE 00001117 ""
NSQ_SOURCE_LINE 00001118 "Assigning matching layouts to different appenders and leaving newlines"
NSQ_SOURCE_LINE 00001119 "out of the code solves this problem. If you inherited code that has logging"
NSQ_SOURCE_LINE 00001120 "statements with newlines and want to make it work with Log4perl, read"
NSQ_SOURCE_LINE 00001121 "the L<Log::Log4perl::Layout::PatternLayout> documentation on how to "
NSQ_SOURCE_LINE 00001122 "accomplish that."
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 "=head2 Configuration files"
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "As shown above, you can define C<Log::Log4perl> loggers both from within"
NSQ_SOURCE_LINE 00001127 "your Perl code or from configuration files. The latter have the unbeatable"
NSQ_SOURCE_LINE 00001128 "advantage that you can modify your system's logging behaviour without "
NSQ_SOURCE_LINE 00001129 "interfering with the code at all. So even if your code is being run by "
NSQ_SOURCE_LINE 00001130 "somebody who's totally oblivious to Perl, they still can adapt the"
NSQ_SOURCE_LINE 00001131 "module's logging behaviour to their needs."
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "C<Log::Log4perl> has been designed to understand C<Log4j> configuration"
NSQ_SOURCE_LINE 00001134 "files -- as used by the original Java implementation. Instead of "
NSQ_SOURCE_LINE 00001135 "reiterating the format description in [2], let me just list three"
NSQ_SOURCE_LINE 00001136 "examples (also derived from [2]), which should also illustrate"
NSQ_SOURCE_LINE 00001137 "how it works:"
NSQ_SOURCE_LINE 00001138 ""
NSQ_SOURCE_LINE 00001139 "    log4j.rootLogger=DEBUG, A1"
NSQ_SOURCE_LINE 00001140 "    log4j.appender.A1=org.apache.log4j.ConsoleAppender"
NSQ_SOURCE_LINE 00001141 "    log4j.appender.A1.layout=org.apache.log4j.PatternLayout"
NSQ_SOURCE_LINE 00001142 "    log4j.appender.A1.layout.ConversionPattern=%-4r %-5p %c %x - %m%n"
NSQ_SOURCE_LINE 00001143 ""
NSQ_SOURCE_LINE 00001144 "This enables messages of priority C<DEBUG> or higher in the root"
NSQ_SOURCE_LINE 00001145 "hierarchy and has the system write them to the console. "
NSQ_SOURCE_LINE 00001146 "C<ConsoleAppender> is a Java appender, but C<Log::Log4perl> jumps"
NSQ_SOURCE_LINE 00001147 "through a significant number of hoops internally to map these to their"
NSQ_SOURCE_LINE 00001148 "corresponding Perl classes, C<Log::Log4perl::Appender::Screen> in this case."
NSQ_SOURCE_LINE 00001149 ""
NSQ_SOURCE_LINE 00001150 "Second example:"
NSQ_SOURCE_LINE 00001151 ""
NSQ_SOURCE_LINE 00001152 "    log4perl.rootLogger=DEBUG, A1"
NSQ_SOURCE_LINE 00001153 "    log4perl.appender.A1=Log::Log4perl::Appender::Screen"
NSQ_SOURCE_LINE 00001154 "    log4perl.appender.A1.layout=PatternLayout"
NSQ_SOURCE_LINE 00001155 "    log4perl.appender.A1.layout.ConversionPattern=%d %-5p %c - %m%n"
NSQ_SOURCE_LINE 00001156 "    log4perl.logger.com.foo=WARN"
NSQ_SOURCE_LINE 00001157 ""
NSQ_SOURCE_LINE 00001158 "This defines two loggers: The root logger and the C<com.foo> logger."
NSQ_SOURCE_LINE 00001159 "The root logger is easily triggered by debug-messages, "
NSQ_SOURCE_LINE 00001160 "but the C<com.foo> logger makes sure that messages issued within"
NSQ_SOURCE_LINE 00001161 "the C<Com::Foo> component and below are only forwarded to the appender"
NSQ_SOURCE_LINE 00001162 "if they're of priority I<warning> or higher. "
NSQ_SOURCE_LINE 00001163 ""
NSQ_SOURCE_LINE 00001164 "Note that the C<com.foo> logger doesn't define an appender. Therefore,"
NSQ_SOURCE_LINE 00001165 "it will just propagate the message up the hierarchy until the root logger"
NSQ_SOURCE_LINE 00001166 "picks it up and forwards it to the one and only appender of the root"
NSQ_SOURCE_LINE 00001167 "category, using the format defined for it."
NSQ_SOURCE_LINE 00001168 ""
NSQ_SOURCE_LINE 00001169 "Third example:"
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 "    log4j.rootLogger=DEBUG, stdout, R"
NSQ_SOURCE_LINE 00001172 "    log4j.appender.stdout=org.apache.log4j.ConsoleAppender"
NSQ_SOURCE_LINE 00001173 "    log4j.appender.stdout.layout=org.apache.log4j.PatternLayout"
NSQ_SOURCE_LINE 00001174 "    log4j.appender.stdout.layout.ConversionPattern=%5p (%F:%L) - %m%n"
NSQ_SOURCE_LINE 00001175 "    log4j.appender.R=org.apache.log4j.RollingFileAppender"
NSQ_SOURCE_LINE 00001176 "    log4j.appender.R.File=example.log"
NSQ_SOURCE_LINE 00001177 "    log4j.appender.R.layout=org.apache.log4j.PatternLayout"
NSQ_SOURCE_LINE 00001178 "    log4j.appender.R.layout.ConversionPattern=%p %c - %m%n"
NSQ_SOURCE_LINE 00001179 ""
NSQ_SOURCE_LINE 00001180 "The root logger defines two appenders here: C<stdout>, which uses "
NSQ_SOURCE_LINE 00001181 "C<org.apache.log4j.ConsoleAppender> (ultimately mapped by C<Log::Log4perl>"
NSQ_SOURCE_LINE 00001182 "to L<Log::Log4perl::Appender::Screen>) to write to the screen. And"
NSQ_SOURCE_LINE 00001183 "C<R>, a C<org.apache.log4j.RollingFileAppender> "
NSQ_SOURCE_LINE 00001184 "(mapped by C<Log::Log4perl> to "
NSQ_SOURCE_LINE 00001185 "L<Log::Dispatch::FileRotate> with the C<File> attribute specifying the"
NSQ_SOURCE_LINE 00001186 "log file."
NSQ_SOURCE_LINE 00001187 ""
NSQ_SOURCE_LINE 00001188 "See L<Log::Log4perl::Config> for more examples and syntax explanations."
NSQ_SOURCE_LINE 00001189 ""
NSQ_SOURCE_LINE 00001190 "=head2 Log Layouts"
NSQ_SOURCE_LINE 00001191 ""
NSQ_SOURCE_LINE 00001192 "If the logging engine passes a message to an appender, because it thinks"
NSQ_SOURCE_LINE 00001193 "it should be logged, the appender doesn't just"
NSQ_SOURCE_LINE 00001194 "write it out haphazardly. There's ways to tell the appender how to format"
NSQ_SOURCE_LINE 00001195 "the message and add all sorts of interesting data to it: The date and"
NSQ_SOURCE_LINE 00001196 "time when the event happened, the file, the line number, the"
NSQ_SOURCE_LINE 00001197 "debug level of the logger and others."
NSQ_SOURCE_LINE 00001198 ""
NSQ_SOURCE_LINE 00001199 "There's currently two layouts defined in C<Log::Log4perl>: "
NSQ_SOURCE_LINE 00001200 "C<Log::Log4perl::Layout::SimpleLayout> and"
NSQ_SOURCE_LINE 00001201 "C<Log::Log4perl::Layout::PatternLayout>:"
NSQ_SOURCE_LINE 00001202 ""
NSQ_SOURCE_LINE 00001203 "=over 4 "
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "=item C<Log::Log4perl::SimpleLayout> "
NSQ_SOURCE_LINE 00001206 ""
NSQ_SOURCE_LINE 00001207 "formats a message in a simple"
NSQ_SOURCE_LINE 00001208 "way and just prepends it by the debug level and a hyphen:"
NSQ_SOURCE_LINE 00001209 "C<\"$level - $message>, for example C<\"FATAL - Can't open password file\">."
NSQ_SOURCE_LINE 00001210 ""
NSQ_SOURCE_LINE 00001211 "=item C<Log::Log4perl::Layout::PatternLayout> "
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 "on the other hand is very powerful and "
NSQ_SOURCE_LINE 00001214 "allows for a very flexible format in C<printf>-style. The format"
NSQ_SOURCE_LINE 00001215 "string can contain a number of placeholders which will be"
NSQ_SOURCE_LINE 00001216 "replaced by the logging engine when it's time to log the message:"
NSQ_SOURCE_LINE 00001217 ""
NSQ_SOURCE_LINE 00001218 "    %c Category of the logging event."
NSQ_SOURCE_LINE 00001219 "    %C Fully qualified package (or class) name of the caller"
NSQ_SOURCE_LINE 00001220 "    %d Current date in yyyy/MM/dd hh:mm:ss format"
NSQ_SOURCE_LINE 00001221 "    %F File where the logging event occurred"
NSQ_SOURCE_LINE 00001222 "    %H Hostname (if Sys::Hostname is available)"
NSQ_SOURCE_LINE 00001223 "    %l Fully qualified name of the calling method followed by the"
NSQ_SOURCE_LINE 00001224 "       callers source the file name and line number between "
NSQ_SOURCE_LINE 00001225 "       parentheses."
NSQ_SOURCE_LINE 00001226 "    %L Line number within the file where the log statement was issued"
NSQ_SOURCE_LINE 00001227 "    %m The message to be logged"
NSQ_SOURCE_LINE 00001228 "    %m{chomp} The message to be logged, stripped off a trailing newline"
NSQ_SOURCE_LINE 00001229 "    %M Method or function where the logging request was issued"
NSQ_SOURCE_LINE 00001230 "    %n Newline (OS-independent)"
NSQ_SOURCE_LINE 00001231 "    %p Priority of the logging event"
NSQ_SOURCE_LINE 00001232 "    %P pid of the current process"
NSQ_SOURCE_LINE 00001233 "    %r Number of milliseconds elapsed from program start to logging "
NSQ_SOURCE_LINE 00001234 "       event"
NSQ_SOURCE_LINE 00001235 "    %R Number of milliseconds elapsed from last logging event to"
NSQ_SOURCE_LINE 00001236 "       current logging event "
NSQ_SOURCE_LINE 00001237 "    %T A stack trace of functions called"
NSQ_SOURCE_LINE 00001238 "    %x The topmost NDC (see below)"
NSQ_SOURCE_LINE 00001239 "    %X{key} The entry 'key' of the MDC (see below)"
NSQ_SOURCE_LINE 00001240 "    %% A literal percent (%) sign"
NSQ_SOURCE_LINE 00001241 ""
NSQ_SOURCE_LINE 00001242 "NDC and MDC are explained in L<\"Nested Diagnostic Context (NDC)\">"
NSQ_SOURCE_LINE 00001243 "and L<\"Mapped Diagnostic Context (MDC)\">."
NSQ_SOURCE_LINE 00001244 ""
NSQ_SOURCE_LINE 00001245 "Also, C<%d> can be fine-tuned to display only certain characteristics"
NSQ_SOURCE_LINE 00001246 "of a date, according to the SimpleDateFormat in the Java World"
NSQ_SOURCE_LINE 00001247 "(L<http://java.sun.com/j2se/1.3/docs/api/java/text/SimpleDateFormat.html>)"
NSQ_SOURCE_LINE 00001248 ""
NSQ_SOURCE_LINE 00001249 "In this way, C<%d{HH:mm}> displays only hours and minutes of the current date,"
NSQ_SOURCE_LINE 00001250 "while C<%d{yy, EEEE}> displays a two-digit year, followed by a spelled-out day"
NSQ_SOURCE_LINE 00001251 "(like C<Wednesday>). "
NSQ_SOURCE_LINE 00001252 ""
NSQ_SOURCE_LINE 00001253 "Similar options are available for shrinking the displayed category or"
NSQ_SOURCE_LINE 00001254 "limit file/path components, C<%F{1}> only displays the source file I<name>"
NSQ_SOURCE_LINE 00001255 "without any path components while C<%F> logs the full path. %c{2} only"
NSQ_SOURCE_LINE 00001256 "logs the last two components of the current category, C<Foo::Bar::Baz> "
NSQ_SOURCE_LINE 00001257 "becomes C<Bar::Baz> and saves space."
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "If those placeholders aren't enough, then you can define your own right in"
NSQ_SOURCE_LINE 00001260 "the config file like this:"
NSQ_SOURCE_LINE 00001261 ""
NSQ_SOURCE_LINE 00001262 "    log4perl.PatternLayout.cspec.U = sub { return \"UID $<\" }"
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "See L<Log::Log4perl::Layout::PatternLayout> for further details on"
NSQ_SOURCE_LINE 00001265 "customized specifiers."
NSQ_SOURCE_LINE 00001266 ""
NSQ_SOURCE_LINE 00001267 "Please note that the subroutines you're defining in this way are going"
NSQ_SOURCE_LINE 00001268 "to be run in the C<main> namespace, so be sure to fully qualify functions"
NSQ_SOURCE_LINE 00001269 "and variables if they're located in different packages."
NSQ_SOURCE_LINE 00001270 ""
NSQ_SOURCE_LINE 00001271 "SECURITY NOTE: this feature means arbitrary perl code can be embedded in the "
NSQ_SOURCE_LINE 00001272 "config file.  In the rare case where the people who have access to your config "
NSQ_SOURCE_LINE 00001273 "file are different from the people who write your code and shouldn't have "
NSQ_SOURCE_LINE 00001274 "execute rights, you might want to call"
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "    Log::Log4perl::Config->allow_code(0);"
NSQ_SOURCE_LINE 00001277 ""
NSQ_SOURCE_LINE 00001278 "before you call init(). Alternatively you can supply a restricted set of"
NSQ_SOURCE_LINE 00001279 "Perl opcodes that can be embedded in the config file as described in"
NSQ_SOURCE_LINE 00001280 "L<\"Restricting what Opcodes can be in a Perl Hook\">."
NSQ_SOURCE_LINE 00001281 ""
NSQ_SOURCE_LINE 00001282 "=back"
NSQ_SOURCE_LINE 00001283 ""
NSQ_SOURCE_LINE 00001284 "All placeholders are quantifiable, just like in I<printf>. Following this "
NSQ_SOURCE_LINE 00001285 "tradition, C<%-20c> will reserve 20 chars for the category and left-justify it."
NSQ_SOURCE_LINE 00001286 ""
NSQ_SOURCE_LINE 00001287 "For more details on logging and how to use the flexible and the simple"
NSQ_SOURCE_LINE 00001288 "format, check out the original C<log4j> website under"
NSQ_SOURCE_LINE 00001289 ""
NSQ_SOURCE_LINE 00001290 "L<SimpleLayout|http://logging.apache.org/log4j/1.2/apidocs/org/apache/log4j/SimpleLayout.html>"
NSQ_SOURCE_LINE 00001291 "and"
NSQ_SOURCE_LINE 00001292 "L<PatternLayout|http://logging.apache.org/log4j/1.2/apidocs/org/apache/log4j/PatternLayout.html>"
NSQ_SOURCE_LINE 00001293 ""
NSQ_SOURCE_LINE 00001294 "=head2 Penalties"
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 "Logging comes with a price tag. C<Log::Log4perl> has been optimized"
NSQ_SOURCE_LINE 00001297 "to allow for maximum performance, both with logging enabled and disabled."
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "But you need to be aware that there's a small hit every time your code"
NSQ_SOURCE_LINE 00001300 "encounters a log statement -- no matter if logging is enabled or not. "
NSQ_SOURCE_LINE 00001301 "C<Log::Log4perl> has been designed to keep this so low that it will"
NSQ_SOURCE_LINE 00001302 "be unnoticeable to most applications."
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 "Here's a couple of tricks which help C<Log::Log4perl> to avoid"
NSQ_SOURCE_LINE 00001305 "unnecessary delays:"
NSQ_SOURCE_LINE 00001306 ""
NSQ_SOURCE_LINE 00001307 "You can save serious time if you're logging something like"
NSQ_SOURCE_LINE 00001308 ""
NSQ_SOURCE_LINE 00001309 "        # Expensive in non-debug mode!"
NSQ_SOURCE_LINE 00001310 "    for (@super_long_array) {"
NSQ_SOURCE_LINE 00001311 "        $logger->debug(\"Element: $_\");"
NSQ_SOURCE_LINE 00001312 "    }"
NSQ_SOURCE_LINE 00001313 ""
NSQ_SOURCE_LINE 00001314 "and C<@super_long_array> is fairly big, so looping through it is pretty"
NSQ_SOURCE_LINE 00001315 "expensive. Only you, the programmer, knows that going through that C<for>"
NSQ_SOURCE_LINE 00001316 "loop can be skipped entirely if the current logging level for the "
NSQ_SOURCE_LINE 00001317 "actual component is higher than C<debug>."
NSQ_SOURCE_LINE 00001318 "In this case, use this instead:"
NSQ_SOURCE_LINE 00001319 ""
NSQ_SOURCE_LINE 00001320 "        # Cheap in non-debug mode!"
NSQ_SOURCE_LINE 00001321 "    if($logger->is_debug()) {"
NSQ_SOURCE_LINE 00001322 "        for (@super_long_array) {"
NSQ_SOURCE_LINE 00001323 "            $logger->debug(\"Element: $_\");"
NSQ_SOURCE_LINE 00001324 "        }"
NSQ_SOURCE_LINE 00001325 "    }"
NSQ_SOURCE_LINE 00001326 ""
NSQ_SOURCE_LINE 00001327 "If you're afraid that generating the parameters to the"
NSQ_SOURCE_LINE 00001328 "logging function is fairly expensive, use closures:"
NSQ_SOURCE_LINE 00001329 ""
NSQ_SOURCE_LINE 00001330 "        # Passed as subroutine ref"
NSQ_SOURCE_LINE 00001331 "    use Data::Dumper;"
NSQ_SOURCE_LINE 00001332 "    $logger->debug(sub { Dumper($data) } );"
NSQ_SOURCE_LINE 00001333 ""
NSQ_SOURCE_LINE 00001334 "This won't unravel C<$data> via Dumper() unless it's actually needed"
NSQ_SOURCE_LINE 00001335 "because it's logged. "
NSQ_SOURCE_LINE 00001336 ""
NSQ_SOURCE_LINE 00001337 "Also, Log::Log4perl lets you specify arguments"
NSQ_SOURCE_LINE 00001338 "to logger functions in I<message output filter syntax>:"
NSQ_SOURCE_LINE 00001339 ""
NSQ_SOURCE_LINE 00001340 "    $logger->debug(\"Structure: \","
NSQ_SOURCE_LINE 00001341 "                   { filter => \\&Dumper,"
NSQ_SOURCE_LINE 00001342 "                     value  => $someref });"
NSQ_SOURCE_LINE 00001343 ""
NSQ_SOURCE_LINE 00001344 "In this way, shortly before Log::Log4perl sending the"
NSQ_SOURCE_LINE 00001345 "message out to any appenders, it will be searching all arguments for"
NSQ_SOURCE_LINE 00001346 "hash references and treat them in a special way:"
NSQ_SOURCE_LINE 00001347 ""
NSQ_SOURCE_LINE 00001348 "It will invoke the function given as a reference with the C<filter> key"
NSQ_SOURCE_LINE 00001349 "(C<Data::Dumper::Dumper()>) and pass it the value that came with"
NSQ_SOURCE_LINE 00001350 "the key named C<value> as an argument."
NSQ_SOURCE_LINE 00001351 "The anonymous hash in the call above will be replaced by the return "
NSQ_SOURCE_LINE 00001352 "value of the filter function."
NSQ_SOURCE_LINE 00001353 ""
NSQ_SOURCE_LINE 00001354 "=head1 Categories"
NSQ_SOURCE_LINE 00001355 ""
NSQ_SOURCE_LINE 00001356 "B<Categories are also called \"Loggers\" in Log4perl, both refer"
NSQ_SOURCE_LINE 00001357 "to the same thing and these terms are used interchangeably.>"
NSQ_SOURCE_LINE 00001358 "C<Log::Log4perl> uses I<categories> to determine if a log statement in"
NSQ_SOURCE_LINE 00001359 "a component should be executed or suppressed at the current logging level."
NSQ_SOURCE_LINE 00001360 "Most of the time, these categories are just the classes the log statements"
NSQ_SOURCE_LINE 00001361 "are located in:"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "    package Candy::Twix;"
NSQ_SOURCE_LINE 00001364 ""
NSQ_SOURCE_LINE 00001365 "    sub new { "
NSQ_SOURCE_LINE 00001366 "        my $logger = Log::Log4perl->get_logger(\"Candy::Twix\");"
NSQ_SOURCE_LINE 00001367 "        $logger->debug(\"Creating a new Twix bar\");"
NSQ_SOURCE_LINE 00001368 "        bless {}, shift;"
NSQ_SOURCE_LINE 00001369 "    }"
NSQ_SOURCE_LINE 00001370 " "
NSQ_SOURCE_LINE 00001371 "    # ..."
NSQ_SOURCE_LINE 00001372 ""
NSQ_SOURCE_LINE 00001373 "    package Candy::Snickers;"
NSQ_SOURCE_LINE 00001374 ""
NSQ_SOURCE_LINE 00001375 "    sub new { "
NSQ_SOURCE_LINE 00001376 "        my $logger = Log::Log4perl->get_logger(\"Candy.Snickers\");"
NSQ_SOURCE_LINE 00001377 "        $logger->debug(\"Creating a new Snickers bar\");"
NSQ_SOURCE_LINE 00001378 "        bless {}, shift;"
NSQ_SOURCE_LINE 00001379 "    }"
NSQ_SOURCE_LINE 00001380 ""
NSQ_SOURCE_LINE 00001381 "    # ..."
NSQ_SOURCE_LINE 00001382 ""
NSQ_SOURCE_LINE 00001383 "    package main;"
NSQ_SOURCE_LINE 00001384 "    Log::Log4perl->init(\"mylogdefs.conf\");"
NSQ_SOURCE_LINE 00001385 ""
NSQ_SOURCE_LINE 00001386 "        # => \"LOG> Creating a new Snickers bar\""
NSQ_SOURCE_LINE 00001387 "    my $first = Candy::Snickers->new();"
NSQ_SOURCE_LINE 00001388 "        # => \"LOG> Creating a new Twix bar\""
NSQ_SOURCE_LINE 00001389 "    my $second = Candy::Twix->new();"
NSQ_SOURCE_LINE 00001390 ""
NSQ_SOURCE_LINE 00001391 "Note that you can separate your category hierarchy levels"
NSQ_SOURCE_LINE 00001392 "using either dots like"
NSQ_SOURCE_LINE 00001393 "in Java (.) or double-colons (::) like in Perl. Both notations"
NSQ_SOURCE_LINE 00001394 "are equivalent and are handled the same way internally."
NSQ_SOURCE_LINE 00001395 ""
NSQ_SOURCE_LINE 00001396 "However, categories are just there to make"
NSQ_SOURCE_LINE 00001397 "use of inheritance: if you invoke a logger in a sub-category, "
NSQ_SOURCE_LINE 00001398 "it will bubble up the hierarchy and call the appropriate appenders."
NSQ_SOURCE_LINE 00001399 "Internally, categories are not related to the class hierarchy of the program"
NSQ_SOURCE_LINE 00001400 "at all -- they're purely virtual. You can use arbitrary categories --"
NSQ_SOURCE_LINE 00001401 "for example in the following program, which isn't oo-style, but"
NSQ_SOURCE_LINE 00001402 "procedural:"
NSQ_SOURCE_LINE 00001403 ""
NSQ_SOURCE_LINE 00001404 "    sub print_portfolio {"
NSQ_SOURCE_LINE 00001405 ""
NSQ_SOURCE_LINE 00001406 "        my $log = Log::Log4perl->get_logger(\"user.portfolio\");"
NSQ_SOURCE_LINE 00001407 "        $log->debug(\"Quotes requested: @_\");"
NSQ_SOURCE_LINE 00001408 ""
NSQ_SOURCE_LINE 00001409 "        for(@_) {"
NSQ_SOURCE_LINE 00001410 "            print \"$_: \", get_quote($_), \"\\n\";"
NSQ_SOURCE_LINE 00001411 "        }"
NSQ_SOURCE_LINE 00001412 "    }"
NSQ_SOURCE_LINE 00001413 ""
NSQ_SOURCE_LINE 00001414 "    sub get_quote {"
NSQ_SOURCE_LINE 00001415 ""
NSQ_SOURCE_LINE 00001416 "        my $log = Log::Log4perl->get_logger(\"internet.quotesystem\");"
NSQ_SOURCE_LINE 00001417 "        $log->debug(\"Fetching quote: $_[0]\");"
NSQ_SOURCE_LINE 00001418 ""
NSQ_SOURCE_LINE 00001419 "        return yahoo_quote($_[0]);"
NSQ_SOURCE_LINE 00001420 "    }"
NSQ_SOURCE_LINE 00001421 ""
NSQ_SOURCE_LINE 00001422 "The logger in first function, C<print_portfolio>, is assigned the"
NSQ_SOURCE_LINE 00001423 "(virtual) C<user.portfolio> category. Depending on the C<Log4perl>"
NSQ_SOURCE_LINE 00001424 "configuration, this will either call a C<user.portfolio> appender,"
NSQ_SOURCE_LINE 00001425 "a C<user> appender, or an appender assigned to root -- without"
NSQ_SOURCE_LINE 00001426 "C<user.portfolio> having any relevance to the class system used in "
NSQ_SOURCE_LINE 00001427 "the program."
NSQ_SOURCE_LINE 00001428 "The logger in the second function adheres to the "
NSQ_SOURCE_LINE 00001429 "C<internet.quotesystem> category -- again, maybe because it's bundled "
NSQ_SOURCE_LINE 00001430 "with other Internet functions, but not because there would be"
NSQ_SOURCE_LINE 00001431 "a class of this name somewhere."
NSQ_SOURCE_LINE 00001432 ""
NSQ_SOURCE_LINE 00001433 "However, be careful, don't go overboard: if you're developing a system"
NSQ_SOURCE_LINE 00001434 "in object-oriented style, using the class hierarchy is usually your best"
NSQ_SOURCE_LINE 00001435 "choice. Think about the people taking over your code one day: The"
NSQ_SOURCE_LINE 00001436 "class hierarchy is probably what they know right up front, so it's easy"
NSQ_SOURCE_LINE 00001437 "for them to tune the logging to their needs."
NSQ_SOURCE_LINE 00001438 ""
NSQ_SOURCE_LINE 00001439 "=head2 Turn off a component"
NSQ_SOURCE_LINE 00001440 ""
NSQ_SOURCE_LINE 00001441 "C<Log4perl> doesn't only allow you to selectively switch I<on> a category"
NSQ_SOURCE_LINE 00001442 "of log messages, you can also use the mechanism to selectively I<disable>"
NSQ_SOURCE_LINE 00001443 "logging in certain components whereas logging is kept turned on in higher-level"
NSQ_SOURCE_LINE 00001444 "categories. This mechanism comes in handy if you find that while bumping "
NSQ_SOURCE_LINE 00001445 "up the logging level of a high-level (i. e. close to root) category, "
NSQ_SOURCE_LINE 00001446 "that one component logs more than it should, "
NSQ_SOURCE_LINE 00001447 ""
NSQ_SOURCE_LINE 00001448 "Here's how it works: "
NSQ_SOURCE_LINE 00001449 ""
NSQ_SOURCE_LINE 00001450 "    ############################################################"
NSQ_SOURCE_LINE 00001451 "    # Turn off logging in a lower-level category while keeping"
NSQ_SOURCE_LINE 00001452 "    # it active in higher-level categories."
NSQ_SOURCE_LINE 00001453 "    ############################################################"
NSQ_SOURCE_LINE 00001454 "    log4perl.rootLogger=DEBUG, LOGFILE"
NSQ_SOURCE_LINE 00001455 "    log4perl.logger.deep.down.the.hierarchy = ERROR, LOGFILE"
NSQ_SOURCE_LINE 00001456 ""
NSQ_SOURCE_LINE 00001457 "    # ... Define appenders ..."
NSQ_SOURCE_LINE 00001458 ""
NSQ_SOURCE_LINE 00001459 "This way, log messages issued from within "
NSQ_SOURCE_LINE 00001460 "C<Deep::Down::The::Hierarchy> and below will be"
NSQ_SOURCE_LINE 00001461 "logged only if they're C<ERROR> or worse, while in all other system components"
NSQ_SOURCE_LINE 00001462 "even C<DEBUG> messages will be logged."
NSQ_SOURCE_LINE 00001463 ""
NSQ_SOURCE_LINE 00001464 "=head2 Return Values"
NSQ_SOURCE_LINE 00001465 ""
NSQ_SOURCE_LINE 00001466 "All logging methods return values indicating if their message"
NSQ_SOURCE_LINE 00001467 "actually reached one or more appenders. If the message has been"
NSQ_SOURCE_LINE 00001468 "suppressed because of level constraints, C<undef> is returned."
NSQ_SOURCE_LINE 00001469 ""
NSQ_SOURCE_LINE 00001470 "For example,"
NSQ_SOURCE_LINE 00001471 ""
NSQ_SOURCE_LINE 00001472 "    my $ret = $logger->info(\"Message\");"
NSQ_SOURCE_LINE 00001473 ""
NSQ_SOURCE_LINE 00001474 "will return C<undef> if the system debug level for the current category"
NSQ_SOURCE_LINE 00001475 "is not C<INFO> or more permissive. "
NSQ_SOURCE_LINE 00001476 "If Log::Log4perl"
NSQ_SOURCE_LINE 00001477 "forwarded the message to one or more appenders, the number of appenders"
NSQ_SOURCE_LINE 00001478 "is returned."
NSQ_SOURCE_LINE 00001479 ""
NSQ_SOURCE_LINE 00001480 "If appenders decide to veto on the message with an appender threshold,"
NSQ_SOURCE_LINE 00001481 "the log method's return value will have them excluded. This means that if"
NSQ_SOURCE_LINE 00001482 "you've got one appender holding an appender threshold and you're "
NSQ_SOURCE_LINE 00001483 "logging a message"
NSQ_SOURCE_LINE 00001484 "which passes the system's log level hurdle but not the appender threshold,"
NSQ_SOURCE_LINE 00001485 "C<0> will be returned by the log function."
NSQ_SOURCE_LINE 00001486 ""
NSQ_SOURCE_LINE 00001487 "The bottom line is: Logging functions will return a I<true> value if the message"
NSQ_SOURCE_LINE 00001488 "made it through to one or more appenders and a I<false> value if it didn't."
NSQ_SOURCE_LINE 00001489 "This allows for constructs like"
NSQ_SOURCE_LINE 00001490 ""
NSQ_SOURCE_LINE 00001491 "    $logger->fatal(\"@_\") or print STDERR \"@_\\n\";"
NSQ_SOURCE_LINE 00001492 ""
NSQ_SOURCE_LINE 00001493 "which will ensure that the fatal message isn't lost"
NSQ_SOURCE_LINE 00001494 "if the current level is lower than FATAL or printed twice if "
NSQ_SOURCE_LINE 00001495 "the level is acceptable but an appender already points to STDERR."
NSQ_SOURCE_LINE 00001496 ""
NSQ_SOURCE_LINE 00001497 "=head2 Pitfalls with Categories"
NSQ_SOURCE_LINE 00001498 ""
NSQ_SOURCE_LINE 00001499 "Be careful with just blindly reusing the system's packages as"
NSQ_SOURCE_LINE 00001500 "categories. If you do, you'll get into trouble with inherited methods."
NSQ_SOURCE_LINE 00001501 "Imagine the following class setup:"
NSQ_SOURCE_LINE 00001502 ""
NSQ_SOURCE_LINE 00001503 "    use Log::Log4perl;"
NSQ_SOURCE_LINE 00001504 ""
NSQ_SOURCE_LINE 00001505 "    ###########################################"
NSQ_SOURCE_LINE 00001506 "    package Bar;"
NSQ_SOURCE_LINE 00001507 "    ###########################################"
NSQ_SOURCE_LINE 00001508 "    sub new {"
NSQ_SOURCE_LINE 00001509 "        my($class) = @_;"
NSQ_SOURCE_LINE 00001510 "        my $logger = Log::Log4perl::get_logger(__PACKAGE__);"
NSQ_SOURCE_LINE 00001511 "        $logger->debug(\"Creating instance\");"
NSQ_SOURCE_LINE 00001512 "        bless {}, $class;"
NSQ_SOURCE_LINE 00001513 "    }"
NSQ_SOURCE_LINE 00001514 "    ###########################################"
NSQ_SOURCE_LINE 00001515 "    package Bar::Twix;"
NSQ_SOURCE_LINE 00001516 "    ###########################################"
NSQ_SOURCE_LINE 00001517 "    our @ISA = qw(Bar);"
NSQ_SOURCE_LINE 00001518 ""
NSQ_SOURCE_LINE 00001519 "    ###########################################"
NSQ_SOURCE_LINE 00001520 "    package main;"
NSQ_SOURCE_LINE 00001521 "    ###########################################"
NSQ_SOURCE_LINE 00001522 "    Log::Log4perl->init(\\ qq{"
NSQ_SOURCE_LINE 00001523 "    log4perl.category.Bar.Twix = DEBUG, Screen"
NSQ_SOURCE_LINE 00001524 "    log4perl.appender.Screen = Log::Log4perl::Appender::Screen"
NSQ_SOURCE_LINE 00001525 "    log4perl.appender.Screen.layout = SimpleLayout"
NSQ_SOURCE_LINE 00001526 "    });"
NSQ_SOURCE_LINE 00001527 ""
NSQ_SOURCE_LINE 00001528 "    my $bar = Bar::Twix->new();"
NSQ_SOURCE_LINE 00001529 ""
NSQ_SOURCE_LINE 00001530 "C<Bar::Twix> just inherits everything from C<Bar>, including the constructor"
NSQ_SOURCE_LINE 00001531 "C<new()>."
NSQ_SOURCE_LINE 00001532 "Contrary to what you might be thinking at first, this won't log anything. "
NSQ_SOURCE_LINE 00001533 "Reason for this is the C<get_logger()> call in package C<Bar>, which"
NSQ_SOURCE_LINE 00001534 "will always get a logger of the C<Bar> category, even if we call C<new()> via"
NSQ_SOURCE_LINE 00001535 "the C<Bar::Twix> package, which will make perl go up the inheritance "
NSQ_SOURCE_LINE 00001536 "tree to actually execute C<Bar::new()>. Since we've only defined logging"
NSQ_SOURCE_LINE 00001537 "behaviour for C<Bar::Twix> in the configuration file, nothing will happen."
NSQ_SOURCE_LINE 00001538 ""
NSQ_SOURCE_LINE 00001539 "This can be fixed by changing the C<get_logger()> method in C<Bar::new()>"
NSQ_SOURCE_LINE 00001540 "to obtain a logger of the category matching the"
NSQ_SOURCE_LINE 00001541 "I<actual> class of the object, like in"
NSQ_SOURCE_LINE 00001542 ""
NSQ_SOURCE_LINE 00001543 "        # ... in Bar::new() ..."
NSQ_SOURCE_LINE 00001544 "    my $logger = Log::Log4perl::get_logger( $class );"
NSQ_SOURCE_LINE 00001545 ""
NSQ_SOURCE_LINE 00001546 "In a method other than the constructor, the class name of the actual"
NSQ_SOURCE_LINE 00001547 "object can be obtained by calling C<ref()> on the object reference, so"
NSQ_SOURCE_LINE 00001548 ""
NSQ_SOURCE_LINE 00001549 "    package BaseClass;"
NSQ_SOURCE_LINE 00001550 "    use Log::Log4perl qw( get_logger );"
NSQ_SOURCE_LINE 00001551 ""
NSQ_SOURCE_LINE 00001552 "    sub new { "
NSQ_SOURCE_LINE 00001553 "        bless {}, shift; "
NSQ_SOURCE_LINE 00001554 "    }"
NSQ_SOURCE_LINE 00001555 ""
NSQ_SOURCE_LINE 00001556 "    sub method {"
NSQ_SOURCE_LINE 00001557 "        my( $self ) = @_;"
NSQ_SOURCE_LINE 00001558 ""
NSQ_SOURCE_LINE 00001559 "        get_logger( ref $self )->debug( \"message\" );"
NSQ_SOURCE_LINE 00001560 "    }"
NSQ_SOURCE_LINE 00001561 ""
NSQ_SOURCE_LINE 00001562 "    package SubClass;"
NSQ_SOURCE_LINE 00001563 "    our @ISA = qw(BaseClass);"
NSQ_SOURCE_LINE 00001564 ""
NSQ_SOURCE_LINE 00001565 "is the recommended pattern to make sure that "
NSQ_SOURCE_LINE 00001566 ""
NSQ_SOURCE_LINE 00001567 "    my $sub = SubClass->new();"
NSQ_SOURCE_LINE 00001568 "    $sub->meth();"
NSQ_SOURCE_LINE 00001569 ""
NSQ_SOURCE_LINE 00001570 "starts logging if the C<\"SubClass\"> category "
NSQ_SOURCE_LINE 00001571 "(and not the C<\"BaseClass\"> category has logging enabled at the DEBUG level."
NSQ_SOURCE_LINE 00001572 ""
NSQ_SOURCE_LINE 00001573 "=head2 Initialize once and only once"
NSQ_SOURCE_LINE 00001574 ""
NSQ_SOURCE_LINE 00001575 "It's important to realize that Log::Log4perl gets initialized once and only"
NSQ_SOURCE_LINE 00001576 "once, typically at the start of a program or system. Calling C<init()>"
NSQ_SOURCE_LINE 00001577 "more than once will cause it to clobber the existing configuration and"
NSQ_SOURCE_LINE 00001578 "I<replace> it by the new one."
NSQ_SOURCE_LINE 00001579 ""
NSQ_SOURCE_LINE 00001580 "If you're in a traditional CGI environment, where every request is"
NSQ_SOURCE_LINE 00001581 "handled by a new process, calling C<init()> every time is fine. In"
NSQ_SOURCE_LINE 00001582 "persistent environments like C<mod_perl>, however, Log::Log4perl"
NSQ_SOURCE_LINE 00001583 "should be initialized either at system startup time (Apache offers"
NSQ_SOURCE_LINE 00001584 "startup handlers for that) or via"
NSQ_SOURCE_LINE 00001585 ""
NSQ_SOURCE_LINE 00001586 "        # Init or skip if already done"
NSQ_SOURCE_LINE 00001587 "    Log::Log4perl->init_once($conf_file);"
NSQ_SOURCE_LINE 00001588 ""
NSQ_SOURCE_LINE 00001589 "C<init_once()> is identical to C<init()>, just with the exception"
NSQ_SOURCE_LINE 00001590 "that it will leave a potentially existing configuration alone and "
NSQ_SOURCE_LINE 00001591 "will only call C<init()> if Log::Log4perl hasn't been initialized yet."
NSQ_SOURCE_LINE 00001592 ""
NSQ_SOURCE_LINE 00001593 "If you're just curious if Log::Log4perl has been initialized yet, the"
NSQ_SOURCE_LINE 00001594 "check"
NSQ_SOURCE_LINE 00001595 ""
NSQ_SOURCE_LINE 00001596 "    if(Log::Log4perl->initialized()) {"
NSQ_SOURCE_LINE 00001597 "        # Yes, Log::Log4perl has already been initialized"
NSQ_SOURCE_LINE 00001598 "    } else {"
NSQ_SOURCE_LINE 00001599 "        # No, not initialized yet ..."
NSQ_SOURCE_LINE 00001600 "    }"
NSQ_SOURCE_LINE 00001601 ""
NSQ_SOURCE_LINE 00001602 "can be used."
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "If you're afraid that the components of your system are stepping on "
NSQ_SOURCE_LINE 00001605 "each other's toes or if you are thinking that different components should"
NSQ_SOURCE_LINE 00001606 "initialize Log::Log4perl separately, try to consolidate your system"
NSQ_SOURCE_LINE 00001607 "to use a centralized Log4perl configuration file and use "
NSQ_SOURCE_LINE 00001608 "Log4perl's I<categories> to separate your components."
NSQ_SOURCE_LINE 00001609 ""
NSQ_SOURCE_LINE 00001610 "=head2 Custom Filters"
NSQ_SOURCE_LINE 00001611 ""
NSQ_SOURCE_LINE 00001612 "Log4perl allows the use of customized filters in its appenders"
NSQ_SOURCE_LINE 00001613 "to control the output of messages. These filters might grep for"
NSQ_SOURCE_LINE 00001614 "certain text chunks in a message, verify that its priority"
NSQ_SOURCE_LINE 00001615 "matches or exceeds a certain level or that this is the 10th"
NSQ_SOURCE_LINE 00001616 "time the same message has been submitted -- and come to a log/no log "
NSQ_SOURCE_LINE 00001617 "decision based upon these circumstantial facts."
NSQ_SOURCE_LINE 00001618 ""
NSQ_SOURCE_LINE 00001619 "Check out L<Log::Log4perl::Filter> for detailed instructions "
NSQ_SOURCE_LINE 00001620 "on how to use them."
NSQ_SOURCE_LINE 00001621 ""
NSQ_SOURCE_LINE 00001622 "=head2 Performance"
NSQ_SOURCE_LINE 00001623 ""
NSQ_SOURCE_LINE 00001624 "The performance of Log::Log4perl calls obviously depends on a lot of things."
NSQ_SOURCE_LINE 00001625 "But to give you a general idea, here's some rough numbers:"
NSQ_SOURCE_LINE 00001626 ""
NSQ_SOURCE_LINE 00001627 "On a Pentium 4 Linux box at 2.4 GHz, you'll get through"
NSQ_SOURCE_LINE 00001628 ""
NSQ_SOURCE_LINE 00001629 "=over 4"
NSQ_SOURCE_LINE 00001630 ""
NSQ_SOURCE_LINE 00001631 "=item *"
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "500,000 suppressed log statements per second"
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "=item *"
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 "30,000 logged messages per second (using an in-memory appender)"
NSQ_SOURCE_LINE 00001638 ""
NSQ_SOURCE_LINE 00001639 "=item *"
NSQ_SOURCE_LINE 00001640 ""
NSQ_SOURCE_LINE 00001641 "init_and_watch delay mode: 300,000 suppressed, 30,000 logged."
NSQ_SOURCE_LINE 00001642 "init_and_watch signal mode: 450,000 suppressed, 30,000 logged."
NSQ_SOURCE_LINE 00001643 ""
NSQ_SOURCE_LINE 00001644 "=back"
NSQ_SOURCE_LINE 00001645 ""
NSQ_SOURCE_LINE 00001646 "Numbers depend on the complexity of the Log::Log4perl configuration."
NSQ_SOURCE_LINE 00001647 "For a more detailed benchmark test, check the C<docs/benchmark.results.txt> "
NSQ_SOURCE_LINE 00001648 "document in the Log::Log4perl distribution."
NSQ_SOURCE_LINE 00001649 ""
NSQ_SOURCE_LINE 00001650 "=head1 Cool Tricks"
NSQ_SOURCE_LINE 00001651 ""
NSQ_SOURCE_LINE 00001652 "Here's a collection of useful tricks for the advanced C<Log::Log4perl> user."
NSQ_SOURCE_LINE 00001653 "For more, check the FAQ, either in the distribution "
NSQ_SOURCE_LINE 00001654 "(L<Log::Log4perl::FAQ>) or on L<http://log4perl.sourceforge.net>."
NSQ_SOURCE_LINE 00001655 ""
NSQ_SOURCE_LINE 00001656 "=head2 Shortcuts"
NSQ_SOURCE_LINE 00001657 ""
NSQ_SOURCE_LINE 00001658 "When getting an instance of a logger, instead of saying"
NSQ_SOURCE_LINE 00001659 ""
NSQ_SOURCE_LINE 00001660 "    use Log::Log4perl;"
NSQ_SOURCE_LINE 00001661 "    my $logger = Log::Log4perl->get_logger();"
NSQ_SOURCE_LINE 00001662 ""
NSQ_SOURCE_LINE 00001663 "it's often more convenient to import the C<get_logger> method from "
NSQ_SOURCE_LINE 00001664 "C<Log::Log4perl> into the current namespace:"
NSQ_SOURCE_LINE 00001665 ""
NSQ_SOURCE_LINE 00001666 "    use Log::Log4perl qw(get_logger);"
NSQ_SOURCE_LINE 00001667 "    my $logger = get_logger();"
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 "Please note this difference: To obtain the root logger, please use"
NSQ_SOURCE_LINE 00001670 "C<get_logger(\"\")>, call it without parameters (C<get_logger()>), you'll"
NSQ_SOURCE_LINE 00001671 "get the logger of a category named after the current package. "
NSQ_SOURCE_LINE 00001672 "C<get_logger()> is equivalent to C<get_logger(__PACKAGE__)>."
NSQ_SOURCE_LINE 00001673 ""
NSQ_SOURCE_LINE 00001674 "=head2 Alternative initialization"
NSQ_SOURCE_LINE 00001675 ""
NSQ_SOURCE_LINE 00001676 "Instead of having C<init()> read in a configuration file by specifying"
NSQ_SOURCE_LINE 00001677 "a file name or passing it a reference to an open filehandle"
NSQ_SOURCE_LINE 00001678 "(C<Log::Log4perl-E<gt>init( \\*FILE )>),"
NSQ_SOURCE_LINE 00001679 "you can "
NSQ_SOURCE_LINE 00001680 "also pass in a reference to a string, containing the content of"
NSQ_SOURCE_LINE 00001681 "the file:"
NSQ_SOURCE_LINE 00001682 ""
NSQ_SOURCE_LINE 00001683 "    Log::Log4perl->init( \\$config_text );"
NSQ_SOURCE_LINE 00001684 ""
NSQ_SOURCE_LINE 00001685 "Also, if you've got the C<name=value> pairs of the configuration in"
NSQ_SOURCE_LINE 00001686 "a hash, you can just as well initialize C<Log::Log4perl> with"
NSQ_SOURCE_LINE 00001687 "a reference to it:"
NSQ_SOURCE_LINE 00001688 ""
NSQ_SOURCE_LINE 00001689 "    my %key_value_pairs = ("
NSQ_SOURCE_LINE 00001690 "        \"log4perl.rootLogger\"       => \"ERROR, LOGFILE\","
NSQ_SOURCE_LINE 00001691 "        \"log4perl.appender.LOGFILE\" => \"Log::Log4perl::Appender::File\","
NSQ_SOURCE_LINE 00001692 "        ..."
NSQ_SOURCE_LINE 00001693 "    );"
NSQ_SOURCE_LINE 00001694 ""
NSQ_SOURCE_LINE 00001695 "    Log::Log4perl->init( \\%key_value_pairs );"
NSQ_SOURCE_LINE 00001696 ""
NSQ_SOURCE_LINE 00001697 "Or also you can use a URL, see below:"
NSQ_SOURCE_LINE 00001698 ""
NSQ_SOURCE_LINE 00001699 "=head2 Using LWP to parse URLs"
NSQ_SOURCE_LINE 00001700 ""
NSQ_SOURCE_LINE 00001701 "(This section borrowed from XML::DOM::Parser by T.J. Mather)."
NSQ_SOURCE_LINE 00001702 ""
NSQ_SOURCE_LINE 00001703 "The init() function now also supports URLs, e.g. I<http://www.erols.com/enno/xsa.xml>."
NSQ_SOURCE_LINE 00001704 "It uses LWP to download the file and then calls parse() on the resulting string."
NSQ_SOURCE_LINE 00001705 "By default it will use a L<LWP::UserAgent> that is created as follows:"
NSQ_SOURCE_LINE 00001706 ""
NSQ_SOURCE_LINE 00001707 " use LWP::UserAgent;"
NSQ_SOURCE_LINE 00001708 " $LWP_USER_AGENT = LWP::UserAgent->new;"
NSQ_SOURCE_LINE 00001709 " $LWP_USER_AGENT->env_proxy;"
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 "Note that env_proxy reads proxy settings from environment variables, which is what Log4perl needs to"
NSQ_SOURCE_LINE 00001712 "do to get through our firewall. If you want to use a different LWP::UserAgent, you can "
NSQ_SOURCE_LINE 00001713 "set it with"
NSQ_SOURCE_LINE 00001714 ""
NSQ_SOURCE_LINE 00001715 "    Log::Log4perl::Config::set_LWP_UserAgent($my_agent);"
NSQ_SOURCE_LINE 00001716 ""
NSQ_SOURCE_LINE 00001717 "Currently, LWP is used when the filename (passed to parsefile) starts with one of"
NSQ_SOURCE_LINE 00001718 "the following URL schemes: http, https, ftp, wais, gopher, or file (followed by a colon.)"
NSQ_SOURCE_LINE 00001719 ""
NSQ_SOURCE_LINE 00001720 "Don't use this feature with init_and_watch()."
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "=head2 Automatic reloading of changed configuration files"
NSQ_SOURCE_LINE 00001723 ""
NSQ_SOURCE_LINE 00001724 "Instead of just statically initializing Log::Log4perl via"
NSQ_SOURCE_LINE 00001725 ""
NSQ_SOURCE_LINE 00001726 "    Log::Log4perl->init($conf_file);"
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "there's a way to have Log::Log4perl periodically check for changes"
NSQ_SOURCE_LINE 00001729 "in the configuration and reload it if necessary:"
NSQ_SOURCE_LINE 00001730 ""
NSQ_SOURCE_LINE 00001731 "    Log::Log4perl->init_and_watch($conf_file, $delay);"
NSQ_SOURCE_LINE 00001732 ""
NSQ_SOURCE_LINE 00001733 "In this mode, Log::Log4perl will examine the configuration file "
NSQ_SOURCE_LINE 00001734 "C<$conf_file> every C<$delay> seconds for changes via the file's"
NSQ_SOURCE_LINE 00001735 "last modification timestamp. If the file has been updated, it will"
NSQ_SOURCE_LINE 00001736 "be reloaded and replace the current Log::Log4perl configuration."
NSQ_SOURCE_LINE 00001737 ""
NSQ_SOURCE_LINE 00001738 "The way this works is that with every logger function called "
NSQ_SOURCE_LINE 00001739 "(debug(), is_debug(), etc.), Log::Log4perl will check if the delay "
NSQ_SOURCE_LINE 00001740 "interval has expired. If so, it will run a -M file check on the "
NSQ_SOURCE_LINE 00001741 "configuration file. If its timestamp has been modified, the current"
NSQ_SOURCE_LINE 00001742 "configuration will be dumped and new content of the file will be"
NSQ_SOURCE_LINE 00001743 "loaded."
NSQ_SOURCE_LINE 00001744 ""
NSQ_SOURCE_LINE 00001745 "This convenience comes at a price, though: Calling time() with every"
NSQ_SOURCE_LINE 00001746 "logging function call, especially the ones that are \"suppressed\" (!), "
NSQ_SOURCE_LINE 00001747 "will slow down these Log4perl calls by about 40%."
NSQ_SOURCE_LINE 00001748 ""
NSQ_SOURCE_LINE 00001749 "To alleviate this performance hit a bit, C<init_and_watch()> "
NSQ_SOURCE_LINE 00001750 "can be configured to listen for a Unix signal to reload the "
NSQ_SOURCE_LINE 00001751 "configuration instead:"
NSQ_SOURCE_LINE 00001752 ""
NSQ_SOURCE_LINE 00001753 "    Log::Log4perl->init_and_watch($conf_file, 'HUP');"
NSQ_SOURCE_LINE 00001754 ""
NSQ_SOURCE_LINE 00001755 "This will set up a signal handler for SIGHUP and reload the configuration"
NSQ_SOURCE_LINE 00001756 "if the application receives this signal, e.g. via the C<kill> command:"
NSQ_SOURCE_LINE 00001757 ""
NSQ_SOURCE_LINE 00001758 "    kill -HUP pid"
NSQ_SOURCE_LINE 00001759 ""
NSQ_SOURCE_LINE 00001760 "where C<pid> is the process ID of the application. This will bring you back"
NSQ_SOURCE_LINE 00001761 "to about 85% of Log::Log4perl's normal execution speed for suppressed"
NSQ_SOURCE_LINE 00001762 "statements. For details, check out L<\"Performance\">. For more info"
NSQ_SOURCE_LINE 00001763 "on the signal handler, look for L<Log::Log4perl::Config::Watch/\"SIGNAL MODE\">."
NSQ_SOURCE_LINE 00001764 ""
NSQ_SOURCE_LINE 00001765 "If you have a somewhat long delay set between physical config file checks"
NSQ_SOURCE_LINE 00001766 "or don't want to use the signal associated with the config file watcher,"
NSQ_SOURCE_LINE 00001767 "you can trigger a configuration reload at the next possible time by"
NSQ_SOURCE_LINE 00001768 "calling C<Log::Log4perl::Config-E<gt>watcher-E<gt>force_next_check()>."
NSQ_SOURCE_LINE 00001769 ""
NSQ_SOURCE_LINE 00001770 "One thing to watch out for: If the configuration file contains a syntax"
NSQ_SOURCE_LINE 00001771 "or other fatal error, a running application will stop with C<die> if"
NSQ_SOURCE_LINE 00001772 "this damaged configuration will be loaded during runtime, triggered"
NSQ_SOURCE_LINE 00001773 "either by a signal or if the delay period expired and the change is "
NSQ_SOURCE_LINE 00001774 "detected. This behaviour might change in the future."
NSQ_SOURCE_LINE 00001775 ""
NSQ_SOURCE_LINE 00001776 "To allow the application to intercept and control a configuration reload"
NSQ_SOURCE_LINE 00001777 "in init_and_watch mode, a callback can be specified:"
NSQ_SOURCE_LINE 00001778 ""
NSQ_SOURCE_LINE 00001779 "    Log::Log4perl->init_and_watch($conf_file, 10, { "
NSQ_SOURCE_LINE 00001780 "            preinit_callback => \\&callback });"
NSQ_SOURCE_LINE 00001781 ""
NSQ_SOURCE_LINE 00001782 "If Log4perl determines that the configuration needs to be reloaded, it will"
NSQ_SOURCE_LINE 00001783 "call the C<preinit_callback> function without parameters. If the callback"
NSQ_SOURCE_LINE 00001784 "returns a true value, Log4perl will proceed and reload the configuration.  If"
NSQ_SOURCE_LINE 00001785 "the callback returns a false value, Log4perl will keep the old configuration"
NSQ_SOURCE_LINE 00001786 "and skip reloading it until the next time around.  Inside the callback, an"
NSQ_SOURCE_LINE 00001787 "application can run all kinds of checks, including accessing the configuration"
NSQ_SOURCE_LINE 00001788 "file, which is available via"
NSQ_SOURCE_LINE 00001789 "C<Log::Log4perl::Config-E<gt>watcher()-E<gt>file()>."
NSQ_SOURCE_LINE 00001790 ""
NSQ_SOURCE_LINE 00001791 "=head2 Variable Substitution"
NSQ_SOURCE_LINE 00001792 ""
NSQ_SOURCE_LINE 00001793 "To avoid having to retype the same expressions over and over again,"
NSQ_SOURCE_LINE 00001794 "Log::Log4perl's configuration files support simple variable substitution."
NSQ_SOURCE_LINE 00001795 "New variables are defined simply by adding"
NSQ_SOURCE_LINE 00001796 ""
NSQ_SOURCE_LINE 00001797 "    varname = value"
NSQ_SOURCE_LINE 00001798 ""
NSQ_SOURCE_LINE 00001799 "lines to the configuration file before using"
NSQ_SOURCE_LINE 00001800 ""
NSQ_SOURCE_LINE 00001801 "    ${varname}"
NSQ_SOURCE_LINE 00001802 ""
NSQ_SOURCE_LINE 00001803 "afterwards to recall the assigned values. Here's an example:"
NSQ_SOURCE_LINE 00001804 ""
NSQ_SOURCE_LINE 00001805 "    layout_class   = Log::Log4perl::Layout::PatternLayout"
NSQ_SOURCE_LINE 00001806 "    layout_pattern = %d %F{1} %L> %m %n"
NSQ_SOURCE_LINE 00001807 "    "
NSQ_SOURCE_LINE 00001808 "    log4perl.category.Bar.Twix = WARN, Logfile, Screen"
NSQ_SOURCE_LINE 00001809 ""
NSQ_SOURCE_LINE 00001810 "    log4perl.appender.Logfile  = Log::Log4perl::Appender::File"
NSQ_SOURCE_LINE 00001811 "    log4perl.appender.Logfile.filename = test.log"
NSQ_SOURCE_LINE 00001812 "    log4perl.appender.Logfile.layout = ${layout_class}"
NSQ_SOURCE_LINE 00001813 "    log4perl.appender.Logfile.layout.ConversionPattern = ${layout_pattern}"
NSQ_SOURCE_LINE 00001814 ""
NSQ_SOURCE_LINE 00001815 "    log4perl.appender.Screen  = Log::Log4perl::Appender::Screen"
NSQ_SOURCE_LINE 00001816 "    log4perl.appender.Screen.layout = ${layout_class}"
NSQ_SOURCE_LINE 00001817 "    log4perl.appender.Screen.layout.ConversionPattern = ${layout_pattern}"
NSQ_SOURCE_LINE 00001818 ""
NSQ_SOURCE_LINE 00001819 "This is a convenient way to define two appenders with the same layout "
NSQ_SOURCE_LINE 00001820 "without having to retype the pattern definitions."
NSQ_SOURCE_LINE 00001821 ""
NSQ_SOURCE_LINE 00001822 "Variable substitution via C<${varname}> "
NSQ_SOURCE_LINE 00001823 "will first try to find an explicitly defined "
NSQ_SOURCE_LINE 00001824 "variable. If that fails, it will check your shell's environment"
NSQ_SOURCE_LINE 00001825 "for a variable of that name. If that also fails, the program will C<die()>."
NSQ_SOURCE_LINE 00001826 ""
NSQ_SOURCE_LINE 00001827 "=head2 Perl Hooks in the Configuration File"
NSQ_SOURCE_LINE 00001828 ""
NSQ_SOURCE_LINE 00001829 "If some of the values used in the Log4perl configuration file "
NSQ_SOURCE_LINE 00001830 "need to be dynamically modified by the program, use Perl hooks:"
NSQ_SOURCE_LINE 00001831 ""
NSQ_SOURCE_LINE 00001832 "    log4perl.appender.File.filename = \\"
NSQ_SOURCE_LINE 00001833 "        sub { return getLogfileName(); }"
NSQ_SOURCE_LINE 00001834 ""
NSQ_SOURCE_LINE 00001835 "Each value starting with the string C<sub {...> is interpreted as Perl code to"
NSQ_SOURCE_LINE 00001836 "be executed at the time the application parses the configuration"
NSQ_SOURCE_LINE 00001837 "via C<Log::Log4perl::init()>. The return value of the subroutine"
NSQ_SOURCE_LINE 00001838 "is used by Log::Log4perl as the configuration value."
NSQ_SOURCE_LINE 00001839 ""
NSQ_SOURCE_LINE 00001840 "The Perl code is executed in the C<main> package, functions in"
NSQ_SOURCE_LINE 00001841 "other packages have to be called in fully-qualified notation."
NSQ_SOURCE_LINE 00001842 ""
NSQ_SOURCE_LINE 00001843 "Here's another example, utilizing an environment variable as a"
NSQ_SOURCE_LINE 00001844 "username for a DBI appender:"
NSQ_SOURCE_LINE 00001845 ""
NSQ_SOURCE_LINE 00001846 "    log4perl.appender.DB.username = \\"
NSQ_SOURCE_LINE 00001847 "        sub { $ENV{DB_USER_NAME } }"
NSQ_SOURCE_LINE 00001848 ""
NSQ_SOURCE_LINE 00001849 "However, please note the difference between these code snippets and those"
NSQ_SOURCE_LINE 00001850 "used for user-defined conversion specifiers as discussed in"
NSQ_SOURCE_LINE 00001851 "L<Log::Log4perl::Layout::PatternLayout>: "
NSQ_SOURCE_LINE 00001852 "While the snippets above are run I<once>"
NSQ_SOURCE_LINE 00001853 "when C<Log::Log4perl::init()> is called, the conversion specifier"
NSQ_SOURCE_LINE 00001854 "snippets are executed I<each time> a message is rendered according to"
NSQ_SOURCE_LINE 00001855 "the PatternLayout."
NSQ_SOURCE_LINE 00001856 ""
NSQ_SOURCE_LINE 00001857 "SECURITY NOTE: this feature means arbitrary perl code can be embedded in the "
NSQ_SOURCE_LINE 00001858 "config file.  In the rare case where the people who have access to your config "
NSQ_SOURCE_LINE 00001859 "file are different from the people who write your code and shouldn't have "
NSQ_SOURCE_LINE 00001860 "execute rights, you might want to set"
NSQ_SOURCE_LINE 00001861 ""
NSQ_SOURCE_LINE 00001862 "    Log::Log4perl::Config->allow_code(0);"
NSQ_SOURCE_LINE 00001863 ""
NSQ_SOURCE_LINE 00001864 "before you call init().  Alternatively you can supply a restricted set of"
NSQ_SOURCE_LINE 00001865 "Perl opcodes that can be embedded in the config file as described in"
NSQ_SOURCE_LINE 00001866 "L<\"Restricting what Opcodes can be in a Perl Hook\">."
NSQ_SOURCE_LINE 00001867 ""
NSQ_SOURCE_LINE 00001868 "=head2 Restricting what Opcodes can be in a Perl Hook"
NSQ_SOURCE_LINE 00001869 ""
NSQ_SOURCE_LINE 00001870 "The value you pass to Log::Log4perl::Config->allow_code() determines whether"
NSQ_SOURCE_LINE 00001871 "the code that is embedded in the config file is eval'd unrestricted, or"
NSQ_SOURCE_LINE 00001872 "eval'd in a Safe compartment.  By default, a value of '1' is assumed,"
NSQ_SOURCE_LINE 00001873 "which does a normal 'eval' without any restrictions. A value of '0' "
NSQ_SOURCE_LINE 00001874 "however prevents any embedded code from being evaluated."
NSQ_SOURCE_LINE 00001875 ""
NSQ_SOURCE_LINE 00001876 "If you would like fine-grained control over what can and cannot be included"
NSQ_SOURCE_LINE 00001877 "in embedded code, then please utilize the following methods:"
NSQ_SOURCE_LINE 00001878 ""
NSQ_SOURCE_LINE 00001879 " Log::Log4perl::Config->allow_code( $allow );"
NSQ_SOURCE_LINE 00001880 " Log::Log4perl::Config->allowed_code_ops($op1, $op2, ... );"
NSQ_SOURCE_LINE 00001881 " Log::Log4perl::Config->vars_shared_with_safe_compartment( [ \\%vars | $package, \\@vars ] );"
NSQ_SOURCE_LINE 00001882 " Log::Log4perl::Config->allowed_code_ops_convenience_map( [ \\%map | $name, \\@mask ] );"
NSQ_SOURCE_LINE 00001883 ""
NSQ_SOURCE_LINE 00001884 "Log::Log4perl::Config-E<gt>allowed_code_ops() takes a list of opcode masks"
NSQ_SOURCE_LINE 00001885 "that are allowed to run in the compartment.  The opcode masks must be"
NSQ_SOURCE_LINE 00001886 "specified as described in L<Opcode>:"
NSQ_SOURCE_LINE 00001887 ""
NSQ_SOURCE_LINE 00001888 " Log::Log4perl::Config->allowed_code_ops(':subprocess');"
NSQ_SOURCE_LINE 00001889 ""
NSQ_SOURCE_LINE 00001890 "This example would allow Perl operations like backticks, system, fork, and"
NSQ_SOURCE_LINE 00001891 "waitpid to be executed in the compartment.  Of course, you probably don't"
NSQ_SOURCE_LINE 00001892 "want to use this mask -- it would allow exactly what the Safe compartment is"
NSQ_SOURCE_LINE 00001893 "designed to prevent."
NSQ_SOURCE_LINE 00001894 ""
NSQ_SOURCE_LINE 00001895 "Log::Log4perl::Config-E<gt>vars_shared_with_safe_compartment() "
NSQ_SOURCE_LINE 00001896 "takes the symbols which"
NSQ_SOURCE_LINE 00001897 "should be exported into the Safe compartment before the code is evaluated. "
NSQ_SOURCE_LINE 00001898 "The keys of this hash are the package names that the symbols are in, and the"
NSQ_SOURCE_LINE 00001899 "values are array references to the literal symbol names.  For convenience,"
NSQ_SOURCE_LINE 00001900 "the default settings export the '%ENV' hash from the 'main' package into the"
NSQ_SOURCE_LINE 00001901 "compartment:"
NSQ_SOURCE_LINE 00001902 ""
NSQ_SOURCE_LINE 00001903 " Log::Log4perl::Config->vars_shared_with_safe_compartment("
NSQ_SOURCE_LINE 00001904 "   main => [ '%ENV' ],"
NSQ_SOURCE_LINE 00001905 " );"
NSQ_SOURCE_LINE 00001906 ""
NSQ_SOURCE_LINE 00001907 "Log::Log4perl::Config-E<gt>allowed_code_ops_convenience_map() is an accessor"
NSQ_SOURCE_LINE 00001908 "method to a map of convenience names to opcode masks. At present, the"
NSQ_SOURCE_LINE 00001909 "following convenience names are defined:"
NSQ_SOURCE_LINE 00001910 ""
NSQ_SOURCE_LINE 00001911 " safe        = [ ':browse' ]"
NSQ_SOURCE_LINE 00001912 " restrictive = [ ':default' ]"
NSQ_SOURCE_LINE 00001913 ""
NSQ_SOURCE_LINE 00001914 "For convenience, if Log::Log4perl::Config-E<gt>allow_code() is called with a"
NSQ_SOURCE_LINE 00001915 "value which is a key of the map previously defined with"
NSQ_SOURCE_LINE 00001916 "Log::Log4perl::Config-E<gt>allowed_code_ops_convenience_map(), then the"
NSQ_SOURCE_LINE 00001917 "allowed opcodes are set according to the value defined in the map. If this"
NSQ_SOURCE_LINE 00001918 "is confusing, consider the following:"
NSQ_SOURCE_LINE 00001919 ""
NSQ_SOURCE_LINE 00001920 " use Log::Log4perl;"
NSQ_SOURCE_LINE 00001921 " "
NSQ_SOURCE_LINE 00001922 " my $config = <<'END';"
NSQ_SOURCE_LINE 00001923 "  log4perl.logger = INFO, Main"
NSQ_SOURCE_LINE 00001924 "  log4perl.appender.Main = Log::Log4perl::Appender::File"
NSQ_SOURCE_LINE 00001925 "  log4perl.appender.Main.filename = \\"
NSQ_SOURCE_LINE 00001926 "      sub { \"example\" . getpwuid($<) . \".log\" }"
NSQ_SOURCE_LINE 00001927 "  log4perl.appender.Main.layout = Log::Log4perl::Layout::SimpleLayout"
NSQ_SOURCE_LINE 00001928 " END"
NSQ_SOURCE_LINE 00001929 " "
NSQ_SOURCE_LINE 00001930 " $Log::Log4perl::Config->allow_code('restrictive');"
NSQ_SOURCE_LINE 00001931 " Log::Log4perl->init( \\$config );       # will fail"
NSQ_SOURCE_LINE 00001932 " $Log::Log4perl::Config->allow_code('safe');"
NSQ_SOURCE_LINE 00001933 " Log::Log4perl->init( \\$config );       # will succeed"
NSQ_SOURCE_LINE 00001934 ""
NSQ_SOURCE_LINE 00001935 "The reason that the first call to -E<gt>init() fails is because the"
NSQ_SOURCE_LINE 00001936 "'restrictive' name maps to an opcode mask of ':default'.  getpwuid() is not"
NSQ_SOURCE_LINE 00001937 "part of ':default', so -E<gt>init() fails.  The 'safe' name maps to an opcode"
NSQ_SOURCE_LINE 00001938 "mask of ':browse', which allows getpwuid() to run, so -E<gt>init() succeeds."
NSQ_SOURCE_LINE 00001939 ""
NSQ_SOURCE_LINE 00001940 "allowed_code_ops_convenience_map() can be invoked in several ways:"
NSQ_SOURCE_LINE 00001941 ""
NSQ_SOURCE_LINE 00001942 "=over 4"
NSQ_SOURCE_LINE 00001943 ""
NSQ_SOURCE_LINE 00001944 "=item allowed_code_ops_convenience_map()"
NSQ_SOURCE_LINE 00001945 ""
NSQ_SOURCE_LINE 00001946 "Returns the entire convenience name map as a hash reference in scalar"
NSQ_SOURCE_LINE 00001947 "context or a hash in list context."
NSQ_SOURCE_LINE 00001948 ""
NSQ_SOURCE_LINE 00001949 "=item allowed_code_ops_convenience_map( \\%map )"
NSQ_SOURCE_LINE 00001950 ""
NSQ_SOURCE_LINE 00001951 "Replaces the entire convenience name map with the supplied hash reference."
NSQ_SOURCE_LINE 00001952 ""
NSQ_SOURCE_LINE 00001953 "=item allowed_code_ops_convenience_map( $name )"
NSQ_SOURCE_LINE 00001954 ""
NSQ_SOURCE_LINE 00001955 "Returns the opcode mask for the given convenience name, or undef if no such"
NSQ_SOURCE_LINE 00001956 "name is defined in the map."
NSQ_SOURCE_LINE 00001957 ""
NSQ_SOURCE_LINE 00001958 "=item allowed_code_ops_convenience_map( $name, \\@mask )"
NSQ_SOURCE_LINE 00001959 ""
NSQ_SOURCE_LINE 00001960 "Adds the given name/mask pair to the convenience name map.  If the name"
NSQ_SOURCE_LINE 00001961 "already exists in the map, it's value is replaced with the new mask."
NSQ_SOURCE_LINE 00001962 ""
NSQ_SOURCE_LINE 00001963 "=back"
NSQ_SOURCE_LINE 00001964 ""
NSQ_SOURCE_LINE 00001965 "as can vars_shared_with_safe_compartment():"
NSQ_SOURCE_LINE 00001966 ""
NSQ_SOURCE_LINE 00001967 "=over 4"
NSQ_SOURCE_LINE 00001968 ""
NSQ_SOURCE_LINE 00001969 "=item vars_shared_with_safe_compartment()"
NSQ_SOURCE_LINE 00001970 ""
NSQ_SOURCE_LINE 00001971 "Return the entire map of packages to variables as a hash reference in scalar"
NSQ_SOURCE_LINE 00001972 "context or a hash in list context."
NSQ_SOURCE_LINE 00001973 ""
NSQ_SOURCE_LINE 00001974 "=item vars_shared_with_safe_compartment( \\%packages )"
NSQ_SOURCE_LINE 00001975 ""
NSQ_SOURCE_LINE 00001976 "Replaces the entire map of packages to variables with the supplied hash"
NSQ_SOURCE_LINE 00001977 "reference."
NSQ_SOURCE_LINE 00001978 ""
NSQ_SOURCE_LINE 00001979 "=item vars_shared_with_safe_compartment( $package )"
NSQ_SOURCE_LINE 00001980 ""
NSQ_SOURCE_LINE 00001981 "Returns the arrayref of variables to be shared for a specific package."
NSQ_SOURCE_LINE 00001982 ""
NSQ_SOURCE_LINE 00001983 "=item vars_shared_with_safe_compartment( $package, \\@vars )"
NSQ_SOURCE_LINE 00001984 ""
NSQ_SOURCE_LINE 00001985 "Adds the given package / varlist pair to the map.  If the package already"
NSQ_SOURCE_LINE 00001986 "exists in the map, it's value is replaced with the new arrayref of variable"
NSQ_SOURCE_LINE 00001987 "names."
NSQ_SOURCE_LINE 00001988 ""
NSQ_SOURCE_LINE 00001989 "=back"
NSQ_SOURCE_LINE 00001990 ""
NSQ_SOURCE_LINE 00001991 "For more information on opcodes and Safe Compartments, see L<Opcode> and"
NSQ_SOURCE_LINE 00001992 "L<Safe>."
NSQ_SOURCE_LINE 00001993 ""
NSQ_SOURCE_LINE 00001994 "=head2 Changing the Log Level on a Logger"
NSQ_SOURCE_LINE 00001995 ""
NSQ_SOURCE_LINE 00001996 "Log4perl provides some internal functions for quickly adjusting the"
NSQ_SOURCE_LINE 00001997 "log level from within a running Perl program. "
NSQ_SOURCE_LINE 00001998 ""
NSQ_SOURCE_LINE 00001999 "Now, some people might"
NSQ_SOURCE_LINE 00002000 "argue that you should adjust your levels from within an external "
NSQ_SOURCE_LINE 00002001 "Log4perl configuration file, but Log4perl is everybody's darling."
NSQ_SOURCE_LINE 00002002 ""
NSQ_SOURCE_LINE 00002003 "Typically run-time adjusting of levels is done"
NSQ_SOURCE_LINE 00002004 "at the beginning, or in response to some external input (like a"
NSQ_SOURCE_LINE 00002005 "\"more logging\" runtime command for diagnostics)."
NSQ_SOURCE_LINE 00002006 ""
NSQ_SOURCE_LINE 00002007 "You get the log level from a logger object with:"
NSQ_SOURCE_LINE 00002008 ""
NSQ_SOURCE_LINE 00002009 "    $current_level = $logger->level();"
NSQ_SOURCE_LINE 00002010 ""
NSQ_SOURCE_LINE 00002011 "and you may set it with the same method, provided you first"
NSQ_SOURCE_LINE 00002012 "imported the log level constants, with:"
NSQ_SOURCE_LINE 00002013 ""
NSQ_SOURCE_LINE 00002014 "    use Log::Log4perl::Level;"
NSQ_SOURCE_LINE 00002015 ""
NSQ_SOURCE_LINE 00002016 "Then you can set the level on a logger to one of the constants,"
NSQ_SOURCE_LINE 00002017 ""
NSQ_SOURCE_LINE 00002018 "    $logger->level($ERROR); # one of DEBUG, INFO, WARN, ERROR, FATAL"
NSQ_SOURCE_LINE 00002019 ""
NSQ_SOURCE_LINE 00002020 "To B<increase> the level of logging currently being done, use:"
NSQ_SOURCE_LINE 00002021 ""
NSQ_SOURCE_LINE 00002022 "    $logger->more_logging($delta);"
NSQ_SOURCE_LINE 00002023 ""
NSQ_SOURCE_LINE 00002024 "and to B<decrease> it, use:"
NSQ_SOURCE_LINE 00002025 ""
NSQ_SOURCE_LINE 00002026 "    $logger->less_logging($delta);"
NSQ_SOURCE_LINE 00002027 ""
NSQ_SOURCE_LINE 00002028 "$delta must be a positive integer (for now, we may fix this later ;)."
NSQ_SOURCE_LINE 00002029 ""
NSQ_SOURCE_LINE 00002030 "There are also two equivalent functions:"
NSQ_SOURCE_LINE 00002031 ""
NSQ_SOURCE_LINE 00002032 "    $logger->inc_level($delta);"
NSQ_SOURCE_LINE 00002033 "    $logger->dec_level($delta);"
NSQ_SOURCE_LINE 00002034 ""
NSQ_SOURCE_LINE 00002035 "They're included to allow you a choice in readability. Some folks"
NSQ_SOURCE_LINE 00002036 "will prefer more/less_logging, as they're fairly clear in what they"
NSQ_SOURCE_LINE 00002037 "do, and allow the programmer not to worry too much about what a Level"
NSQ_SOURCE_LINE 00002038 "is and whether a higher level means more or less logging. However,"
NSQ_SOURCE_LINE 00002039 "other folks who do understand and have lots of code that deals with"
NSQ_SOURCE_LINE 00002040 "levels will probably prefer the inc_level() and dec_level() methods as"
NSQ_SOURCE_LINE 00002041 "they want to work with Levels and not worry about whether that means"
NSQ_SOURCE_LINE 00002042 "more or less logging. :)"
NSQ_SOURCE_LINE 00002043 ""
NSQ_SOURCE_LINE 00002044 "That diatribe aside, typically you'll use more_logging() or inc_level()"
NSQ_SOURCE_LINE 00002045 "as such:"
NSQ_SOURCE_LINE 00002046 ""
NSQ_SOURCE_LINE 00002047 "    my $v = 0; # default level of verbosity."
NSQ_SOURCE_LINE 00002048 "    "
NSQ_SOURCE_LINE 00002049 "    GetOptions(\"v+\" => \\$v, ...);"
NSQ_SOURCE_LINE 00002050 ""
NSQ_SOURCE_LINE 00002051 "    if( $v ) {"
NSQ_SOURCE_LINE 00002052 "      $logger->more_logging($v); # inc logging level once for each -v in ARGV"
NSQ_SOURCE_LINE 00002053 "    }"
NSQ_SOURCE_LINE 00002054 ""
NSQ_SOURCE_LINE 00002055 "=head2 Custom Log Levels"
NSQ_SOURCE_LINE 00002056 ""
NSQ_SOURCE_LINE 00002057 "First off, let me tell you that creating custom levels is heavily"
NSQ_SOURCE_LINE 00002058 "deprecated by the log4j folks. Indeed, instead of creating additional"
NSQ_SOURCE_LINE 00002059 "levels on top of the predefined DEBUG, INFO, WARN, ERROR and FATAL, "
NSQ_SOURCE_LINE 00002060 "you should use categories to control the amount of logging smartly,"
NSQ_SOURCE_LINE 00002061 "based on the location of the log-active code in the system."
NSQ_SOURCE_LINE 00002062 ""
NSQ_SOURCE_LINE 00002063 "Nevertheless, "
NSQ_SOURCE_LINE 00002064 "Log4perl provides a nice way to create custom levels via the "
NSQ_SOURCE_LINE 00002065 "create_custom_level() routine function. However, this must be done"
NSQ_SOURCE_LINE 00002066 "before the first call to init() or get_logger(). Say you want to create"
NSQ_SOURCE_LINE 00002067 "a NOTIFY logging level that comes after WARN (and thus before INFO)."
NSQ_SOURCE_LINE 00002068 "You'd do such as follows:"
NSQ_SOURCE_LINE 00002069 ""
NSQ_SOURCE_LINE 00002070 "    use Log::Log4perl;"
NSQ_SOURCE_LINE 00002071 "    use Log::Log4perl::Level;"
NSQ_SOURCE_LINE 00002072 ""
NSQ_SOURCE_LINE 00002073 "    Log::Log4perl::Logger::create_custom_level(\"NOTIFY\", \"WARN\");"
NSQ_SOURCE_LINE 00002074 ""
NSQ_SOURCE_LINE 00002075 "And that's it! C<create_custom_level()> creates the following functions /"
NSQ_SOURCE_LINE 00002076 "variables for level FOO:"
NSQ_SOURCE_LINE 00002077 ""
NSQ_SOURCE_LINE 00002078 "    $FOO_INT        # integer to use in L4p::Level::to_level()"
NSQ_SOURCE_LINE 00002079 "    $logger->foo()  # log function to log if level = FOO"
NSQ_SOURCE_LINE 00002080 "    $logger->is_foo()   # true if current level is >= FOO"
NSQ_SOURCE_LINE 00002081 ""
NSQ_SOURCE_LINE 00002082 "These levels can also be used in your"
NSQ_SOURCE_LINE 00002083 "config file, but note that your config file probably won't be"
NSQ_SOURCE_LINE 00002084 "portable to another log4perl or log4j environment unless you've"
NSQ_SOURCE_LINE 00002085 "made the appropriate mods there too."
NSQ_SOURCE_LINE 00002086 ""
NSQ_SOURCE_LINE 00002087 "Since Log4perl translates log levels to syslog and Log::Dispatch if "
NSQ_SOURCE_LINE 00002088 "their appenders are used, you may add mappings for custom levels as well:"
NSQ_SOURCE_LINE 00002089 ""
NSQ_SOURCE_LINE 00002090 "  Log::Log4perl::Level::add_priority(\"NOTIFY\", \"WARN\","
NSQ_SOURCE_LINE 00002091 "                                     $syslog_equiv, $log_dispatch_level);"
NSQ_SOURCE_LINE 00002092 ""
NSQ_SOURCE_LINE 00002093 "For example, if your new custom \"NOTIFY\" level is supposed to map "
NSQ_SOURCE_LINE 00002094 "to syslog level 2 (\"LOG_NOTICE\") and Log::Dispatch level 2 (\"notice\"), use:"
NSQ_SOURCE_LINE 00002095 ""
NSQ_SOURCE_LINE 00002096 "  Log::Log4perl::Logger::create_custom_level(\"NOTIFY\", \"WARN\", 2, 2);"
NSQ_SOURCE_LINE 00002097 ""
NSQ_SOURCE_LINE 00002098 "=head2 System-wide log levels"
NSQ_SOURCE_LINE 00002099 ""
NSQ_SOURCE_LINE 00002100 "As a fairly drastic measure to decrease (or increase) the logging level"
NSQ_SOURCE_LINE 00002101 "all over the system with one single configuration option, use the C<threshold>"
NSQ_SOURCE_LINE 00002102 "keyword in the Log4perl configuration file:"
NSQ_SOURCE_LINE 00002103 ""
NSQ_SOURCE_LINE 00002104 "    log4perl.threshold = ERROR"
NSQ_SOURCE_LINE 00002105 ""
NSQ_SOURCE_LINE 00002106 "sets the system-wide (or hierarchy-wide according to the log4j documentation)"
NSQ_SOURCE_LINE 00002107 "to ERROR and therefore deprives every logger in the system of the right "
NSQ_SOURCE_LINE 00002108 "to log lower-prio messages."
NSQ_SOURCE_LINE 00002109 ""
NSQ_SOURCE_LINE 00002110 "=head2 Easy Mode"
NSQ_SOURCE_LINE 00002111 ""
NSQ_SOURCE_LINE 00002112 "For teaching purposes (especially for [1]), I've put C<:easy> mode into "
NSQ_SOURCE_LINE 00002113 "C<Log::Log4perl>, which just initializes a single root logger with a "
NSQ_SOURCE_LINE 00002114 "defined priority and a screen appender including some nice standard layout:"
NSQ_SOURCE_LINE 00002115 ""
NSQ_SOURCE_LINE 00002116 "    ### Initialization Section"
NSQ_SOURCE_LINE 00002117 "    use Log::Log4perl qw(:easy);"
NSQ_SOURCE_LINE 00002118 "    Log::Log4perl->easy_init($ERROR);  # Set priority of root logger to ERROR"
NSQ_SOURCE_LINE 00002119 ""
NSQ_SOURCE_LINE 00002120 "    ### Application Section"
NSQ_SOURCE_LINE 00002121 "    my $logger = get_logger();"
NSQ_SOURCE_LINE 00002122 "    $logger->fatal(\"This will get logged.\");"
NSQ_SOURCE_LINE 00002123 "    $logger->debug(\"This won't.\");"
NSQ_SOURCE_LINE 00002124 ""
NSQ_SOURCE_LINE 00002125 "This will dump something like"
NSQ_SOURCE_LINE 00002126 ""
NSQ_SOURCE_LINE 00002127 "    2002/08/04 11:43:09 ERROR> script.pl:16 main::function - This will get logged."
NSQ_SOURCE_LINE 00002128 ""
NSQ_SOURCE_LINE 00002129 "to the screen. While this has been proven to work well familiarizing people"
NSQ_SOURCE_LINE 00002130 "with C<Log::Logperl> slowly, effectively avoiding to clobber them over the "
NSQ_SOURCE_LINE 00002131 "head with a "
NSQ_SOURCE_LINE 00002132 "plethora of different knobs to fiddle with (categories, appenders, levels, "
NSQ_SOURCE_LINE 00002133 "layout), the overall mission of C<Log::Log4perl> is to let people use"
NSQ_SOURCE_LINE 00002134 "categories right from the start to get used to the concept. So, let's keep"
NSQ_SOURCE_LINE 00002135 "this one fairly hidden in the man page (congrats on reading this far :)."
NSQ_SOURCE_LINE 00002136 ""
NSQ_SOURCE_LINE 00002137 "=head2 Stealth loggers"
NSQ_SOURCE_LINE 00002138 ""
NSQ_SOURCE_LINE 00002139 "Sometimes, people are lazy. If you're whipping up a 50-line script and want "
NSQ_SOURCE_LINE 00002140 "the comfort of Log::Log4perl without having the burden of carrying a"
NSQ_SOURCE_LINE 00002141 "separate log4perl.conf file or a 5-liner defining that you want to append"
NSQ_SOURCE_LINE 00002142 "your log statements to a file, you can use the following features:"
NSQ_SOURCE_LINE 00002143 ""
NSQ_SOURCE_LINE 00002144 "    use Log::Log4perl qw(:easy);"
NSQ_SOURCE_LINE 00002145 ""
NSQ_SOURCE_LINE 00002146 "    Log::Log4perl->easy_init( { level   => $DEBUG,"
NSQ_SOURCE_LINE 00002147 "                                file    => \">>test.log\" } );"
NSQ_SOURCE_LINE 00002148 ""
NSQ_SOURCE_LINE 00002149 "        # Logs to test.log via stealth logger"
NSQ_SOURCE_LINE 00002150 "    DEBUG(\"Debug this!\");"
NSQ_SOURCE_LINE 00002151 "    INFO(\"Info this!\");"
NSQ_SOURCE_LINE 00002152 "    WARN(\"Warn this!\");"
NSQ_SOURCE_LINE 00002153 "    ERROR(\"Error this!\");"
NSQ_SOURCE_LINE 00002154 ""
NSQ_SOURCE_LINE 00002155 "    some_function();"
NSQ_SOURCE_LINE 00002156 ""
NSQ_SOURCE_LINE 00002157 "    sub some_function {"
NSQ_SOURCE_LINE 00002158 "            # Same here"
NSQ_SOURCE_LINE 00002159 "        FATAL(\"Fatal this!\");"
NSQ_SOURCE_LINE 00002160 "    }"
NSQ_SOURCE_LINE 00002161 ""
NSQ_SOURCE_LINE 00002162 "In C<:easy> mode, C<Log::Log4perl> will instantiate a I<stealth logger>"
NSQ_SOURCE_LINE 00002163 "and introduce the"
NSQ_SOURCE_LINE 00002164 "convenience functions C<TRACE>, C<DEBUG()>, C<INFO()>, C<WARN()>, "
NSQ_SOURCE_LINE 00002165 "C<ERROR()>, C<FATAL()>, and C<ALWAYS> into the package namespace."
NSQ_SOURCE_LINE 00002166 "These functions simply take messages as"
NSQ_SOURCE_LINE 00002167 "arguments and forward them to the stealth loggers methods (C<debug()>,"
NSQ_SOURCE_LINE 00002168 "C<info()>, and so on)."
NSQ_SOURCE_LINE 00002169 ""
NSQ_SOURCE_LINE 00002170 "If a message should never be blocked, regardless of the log level,"
NSQ_SOURCE_LINE 00002171 "use the C<ALWAYS> function which corresponds to a log level of C<OFF>:"
NSQ_SOURCE_LINE 00002172 ""
NSQ_SOURCE_LINE 00002173 "    ALWAYS \"This will be printed regardless of the log level\";"
NSQ_SOURCE_LINE 00002174 ""
NSQ_SOURCE_LINE 00002175 "The C<easy_init> method can be called with a single level value to"
NSQ_SOURCE_LINE 00002176 "create a STDERR appender and a root logger as in"
NSQ_SOURCE_LINE 00002177 ""
NSQ_SOURCE_LINE 00002178 "    Log::Log4perl->easy_init($DEBUG);"
NSQ_SOURCE_LINE 00002179 ""
NSQ_SOURCE_LINE 00002180 "or, as shown below (and in the example above) "
NSQ_SOURCE_LINE 00002181 "with a reference to a hash, specifying values"
NSQ_SOURCE_LINE 00002182 "for C<level> (the logger's priority), C<file> (the appender's data sink),"
NSQ_SOURCE_LINE 00002183 "C<category> (the logger's category and C<layout> for the appender's "
NSQ_SOURCE_LINE 00002184 "pattern layout specification."
NSQ_SOURCE_LINE 00002185 "All key-value pairs are optional, they "
NSQ_SOURCE_LINE 00002186 "default to C<$DEBUG> for C<level>, C<STDERR> for C<file>,"
NSQ_SOURCE_LINE 00002187 "C<\"\"> (root category) for C<category> and "
NSQ_SOURCE_LINE 00002188 "C<%d %m%n> for C<layout>:"
NSQ_SOURCE_LINE 00002189 ""
NSQ_SOURCE_LINE 00002190 "    Log::Log4perl->easy_init( { level    => $DEBUG,"
NSQ_SOURCE_LINE 00002191 "                                file     => \">test.log\","
NSQ_SOURCE_LINE 00002192 "                                utf8     => 1,"
NSQ_SOURCE_LINE 00002193 "                                category => \"Bar::Twix\","
NSQ_SOURCE_LINE 00002194 "                                layout   => '%F{1}-%L-%M: %m%n' } );"
NSQ_SOURCE_LINE 00002195 ""
NSQ_SOURCE_LINE 00002196 "The C<file> parameter takes file names preceded by C<\"E<gt>\">"
NSQ_SOURCE_LINE 00002197 "(overwrite) and C<\"E<gt>E<gt>\"> (append) as arguments. This will"
NSQ_SOURCE_LINE 00002198 "cause C<Log::Log4perl::Appender::File> appenders to be created behind"
NSQ_SOURCE_LINE 00002199 "the scenes. Also the keywords C<STDOUT> and C<STDERR> (no C<E<gt>> or"
NSQ_SOURCE_LINE 00002200 "C<E<gt>E<gt>>) are recognized, which will utilize and configure"
NSQ_SOURCE_LINE 00002201 "C<Log::Log4perl::Appender::Screen> appropriately. The C<utf8> flag,"
NSQ_SOURCE_LINE 00002202 "if set to a true value, runs a C<binmode> command on the file handle"
NSQ_SOURCE_LINE 00002203 "to establish a utf8 line discipline on the file, otherwise you'll get a"
NSQ_SOURCE_LINE 00002204 "'wide character in print' warning message and probably not what you'd"
NSQ_SOURCE_LINE 00002205 "expect as output."
NSQ_SOURCE_LINE 00002206 ""
NSQ_SOURCE_LINE 00002207 "The stealth loggers can be used in different packages, you just need to make"
NSQ_SOURCE_LINE 00002208 "sure you're calling the \"use\" function in every package you're using"
NSQ_SOURCE_LINE 00002209 "C<Log::Log4perl>'s easy services:"
NSQ_SOURCE_LINE 00002210 ""
NSQ_SOURCE_LINE 00002211 "    package Bar::Twix;"
NSQ_SOURCE_LINE 00002212 "    use Log::Log4perl qw(:easy);"
NSQ_SOURCE_LINE 00002213 "    sub eat { DEBUG(\"Twix mjam\"); }"
NSQ_SOURCE_LINE 00002214 ""
NSQ_SOURCE_LINE 00002215 "    package Bar::Mars;"
NSQ_SOURCE_LINE 00002216 "    use Log::Log4perl qw(:easy);"
NSQ_SOURCE_LINE 00002217 "    sub eat { INFO(\"Mars mjam\"); }"
NSQ_SOURCE_LINE 00002218 ""
NSQ_SOURCE_LINE 00002219 "    package main;"
NSQ_SOURCE_LINE 00002220 ""
NSQ_SOURCE_LINE 00002221 "    use Log::Log4perl qw(:easy);"
NSQ_SOURCE_LINE 00002222 ""
NSQ_SOURCE_LINE 00002223 "    Log::Log4perl->easy_init( { level    => $DEBUG,"
NSQ_SOURCE_LINE 00002224 "                                file     => \">>test.log\","
NSQ_SOURCE_LINE 00002225 "                                category => \"Bar::Twix\","
NSQ_SOURCE_LINE 00002226 "                                layout   => '%F{1}-%L-%M: %m%n' },"
NSQ_SOURCE_LINE 00002227 "                              { level    => $DEBUG,"
NSQ_SOURCE_LINE 00002228 "                                file     => \"STDOUT\","
NSQ_SOURCE_LINE 00002229 "                                category => \"Bar::Mars\","
NSQ_SOURCE_LINE 00002230 "                                layout   => '%m%n' },"
NSQ_SOURCE_LINE 00002231 "                            );"
NSQ_SOURCE_LINE 00002232 "    Bar::Twix::eat();"
NSQ_SOURCE_LINE 00002233 "    Bar::Mars::eat();"
NSQ_SOURCE_LINE 00002234 ""
NSQ_SOURCE_LINE 00002235 "As shown above, C<easy_init()> will take any number of different logger "
NSQ_SOURCE_LINE 00002236 "definitions as hash references."
NSQ_SOURCE_LINE 00002237 ""
NSQ_SOURCE_LINE 00002238 "Also, stealth loggers feature the functions C<LOGWARN()>, C<LOGDIE()>,"
NSQ_SOURCE_LINE 00002239 "and C<LOGEXIT()>,"
NSQ_SOURCE_LINE 00002240 "combining a logging request with a subsequent Perl warn() or die() or exit()"
NSQ_SOURCE_LINE 00002241 "statement. So, for example"
NSQ_SOURCE_LINE 00002242 ""
NSQ_SOURCE_LINE 00002243 "    if($all_is_lost) {"
NSQ_SOURCE_LINE 00002244 "        LOGDIE(\"Terrible Problem\");"
NSQ_SOURCE_LINE 00002245 "    }"
NSQ_SOURCE_LINE 00002246 ""
NSQ_SOURCE_LINE 00002247 "will log the message if the package's logger is at least C<FATAL> but"
NSQ_SOURCE_LINE 00002248 "C<die()> (including the traditional output to STDERR) in any case afterwards."
NSQ_SOURCE_LINE 00002249 ""
NSQ_SOURCE_LINE 00002250 "See L<\"Log and die or warn\"> for the similar C<logdie()> and C<logwarn()>"
NSQ_SOURCE_LINE 00002251 "functions of regular (i.e non-stealth) loggers."
NSQ_SOURCE_LINE 00002252 ""
NSQ_SOURCE_LINE 00002253 "Similarily, C<LOGCARP()>, C<LOGCLUCK()>, C<LOGCROAK()>, and C<LOGCONFESS()>"
NSQ_SOURCE_LINE 00002254 "are provided in C<:easy> mode, facilitating the use of C<logcarp()>,"
NSQ_SOURCE_LINE 00002255 "C<logcluck()>, C<logcroak()>, and C<logconfess()> with stealth loggers."
NSQ_SOURCE_LINE 00002256 ""
NSQ_SOURCE_LINE 00002257 "B<When using Log::Log4perl in easy mode, "
NSQ_SOURCE_LINE 00002258 "please make sure you understand the implications of "
NSQ_SOURCE_LINE 00002259 "L</\"Pitfalls with Categories\">>."
NSQ_SOURCE_LINE 00002260 ""
NSQ_SOURCE_LINE 00002261 "By the way, these convenience functions perform exactly as fast as the "
NSQ_SOURCE_LINE 00002262 "standard Log::Log4perl logger methods, there's I<no> performance penalty"
NSQ_SOURCE_LINE 00002263 "whatsoever."
NSQ_SOURCE_LINE 00002264 ""
NSQ_SOURCE_LINE 00002265 "=head2 Nested Diagnostic Context (NDC)"
NSQ_SOURCE_LINE 00002266 ""
NSQ_SOURCE_LINE 00002267 "If you find that your application could use a global (thread-specific)"
NSQ_SOURCE_LINE 00002268 "data stack which your loggers throughout the system have easy access to,"
NSQ_SOURCE_LINE 00002269 "use Nested Diagnostic Contexts (NDCs). Also check out"
NSQ_SOURCE_LINE 00002270 "L<\"Mapped Diagnostic Context (MDC)\">, this might turn out to be even more"
NSQ_SOURCE_LINE 00002271 "useful."
NSQ_SOURCE_LINE 00002272 ""
NSQ_SOURCE_LINE 00002273 "For example, when handling a request of a web client, it's probably "
NSQ_SOURCE_LINE 00002274 "useful to have the user's IP address available in all log statements"
NSQ_SOURCE_LINE 00002275 "within code dealing with this particular request. Instead of passing"
NSQ_SOURCE_LINE 00002276 "this piece of data around between your application functions, you can just"
NSQ_SOURCE_LINE 00002277 "use the global (but thread-specific) NDC mechanism. It allows you"
NSQ_SOURCE_LINE 00002278 "to push data pieces (scalars usually) onto its stack via"
NSQ_SOURCE_LINE 00002279 ""
NSQ_SOURCE_LINE 00002280 "    Log::Log4perl::NDC->push(\"San\");"
NSQ_SOURCE_LINE 00002281 "    Log::Log4perl::NDC->push(\"Francisco\");"
NSQ_SOURCE_LINE 00002282 ""
NSQ_SOURCE_LINE 00002283 "and have your loggers retrieve them again via the \"%x\" placeholder in"
NSQ_SOURCE_LINE 00002284 "the PatternLayout. With the stack values above and a PatternLayout format"
NSQ_SOURCE_LINE 00002285 "like \"%x %m%n\", the call"
NSQ_SOURCE_LINE 00002286 ""
NSQ_SOURCE_LINE 00002287 "    $logger->debug(\"rocks\");"
NSQ_SOURCE_LINE 00002288 ""
NSQ_SOURCE_LINE 00002289 "will end up as "
NSQ_SOURCE_LINE 00002290 ""
NSQ_SOURCE_LINE 00002291 "    San Francisco rocks"
NSQ_SOURCE_LINE 00002292 ""
NSQ_SOURCE_LINE 00002293 "in the log appender."
NSQ_SOURCE_LINE 00002294 ""
NSQ_SOURCE_LINE 00002295 "The stack mechanism allows for nested structures."
NSQ_SOURCE_LINE 00002296 "Just make sure that at the end of the request, you either decrease the stack"
NSQ_SOURCE_LINE 00002297 "one by one by calling"
NSQ_SOURCE_LINE 00002298 ""
NSQ_SOURCE_LINE 00002299 "    Log::Log4perl::NDC->pop();"
NSQ_SOURCE_LINE 00002300 "    Log::Log4perl::NDC->pop();"
NSQ_SOURCE_LINE 00002301 ""
NSQ_SOURCE_LINE 00002302 "or clear out the entire NDC stack by calling"
NSQ_SOURCE_LINE 00002303 ""
NSQ_SOURCE_LINE 00002304 "    Log::Log4perl::NDC->remove();"
NSQ_SOURCE_LINE 00002305 ""
NSQ_SOURCE_LINE 00002306 "Even if you should forget to do that, C<Log::Log4perl> won't grow the stack"
NSQ_SOURCE_LINE 00002307 "indefinitely, but limit it to a maximum, defined in C<Log::Log4perl::NDC>"
NSQ_SOURCE_LINE 00002308 "(currently 5). A call to C<push()> on a full stack will just replace"
NSQ_SOURCE_LINE 00002309 "the topmost element by the new value."
NSQ_SOURCE_LINE 00002310 ""
NSQ_SOURCE_LINE 00002311 "Again, the stack is always available via the \"%x\" placeholder"
NSQ_SOURCE_LINE 00002312 "in the Log::Log4perl::Layout::PatternLayout class whenever a logger"
NSQ_SOURCE_LINE 00002313 "fires. It will replace \"%x\" by the blank-separated list of the"
NSQ_SOURCE_LINE 00002314 "values on the stack. It does that by just calling"
NSQ_SOURCE_LINE 00002315 ""
NSQ_SOURCE_LINE 00002316 "    Log::Log4perl::NDC->get();"
NSQ_SOURCE_LINE 00002317 ""
NSQ_SOURCE_LINE 00002318 "internally. See details on how this standard log4j feature is implemented"
NSQ_SOURCE_LINE 00002319 "in L<Log::Log4perl::NDC>."
NSQ_SOURCE_LINE 00002320 ""
NSQ_SOURCE_LINE 00002321 "=head2 Mapped Diagnostic Context (MDC)"
NSQ_SOURCE_LINE 00002322 ""
NSQ_SOURCE_LINE 00002323 "Just like the previously discussed NDC stores thread-specific"
NSQ_SOURCE_LINE 00002324 "information in a stack structure, the MDC implements a hash table"
NSQ_SOURCE_LINE 00002325 "to store key/value pairs in."
NSQ_SOURCE_LINE 00002326 ""
NSQ_SOURCE_LINE 00002327 "The static method"
NSQ_SOURCE_LINE 00002328 ""
NSQ_SOURCE_LINE 00002329 "    Log::Log4perl::MDC->put($key, $value);"
NSQ_SOURCE_LINE 00002330 ""
NSQ_SOURCE_LINE 00002331 "stores C<$value> under a key C<$key>, with which it can be retrieved later"
NSQ_SOURCE_LINE 00002332 "(possibly in a totally different part of the system) by calling"
NSQ_SOURCE_LINE 00002333 "the C<get> method:"
NSQ_SOURCE_LINE 00002334 ""
NSQ_SOURCE_LINE 00002335 "    my $value = Log::Log4perl::MDC->get($key);"
NSQ_SOURCE_LINE 00002336 ""
NSQ_SOURCE_LINE 00002337 "If no value has been stored previously under C<$key>, the C<get> method"
NSQ_SOURCE_LINE 00002338 "will return C<undef>."
NSQ_SOURCE_LINE 00002339 ""
NSQ_SOURCE_LINE 00002340 "Typically, MDC values are retrieved later on via the C<\"%X{...}\"> placeholder"
NSQ_SOURCE_LINE 00002341 "in C<Log::Log4perl::Layout::PatternLayout>. If the C<get()> method"
NSQ_SOURCE_LINE 00002342 "returns C<undef>, the placeholder will expand to the string C<[undef]>."
NSQ_SOURCE_LINE 00002343 ""
NSQ_SOURCE_LINE 00002344 "An application taking a web request might store the remote host"
NSQ_SOURCE_LINE 00002345 "like"
NSQ_SOURCE_LINE 00002346 ""
NSQ_SOURCE_LINE 00002347 "    Log::Log4perl::MDC->put(\"remote_host\", $r->headers(\"HOST\"));"
NSQ_SOURCE_LINE 00002348 ""
NSQ_SOURCE_LINE 00002349 "at its beginning and if the appender's layout looks something like"
NSQ_SOURCE_LINE 00002350 ""
NSQ_SOURCE_LINE 00002351 "    log4perl.appender.Logfile.layout.ConversionPattern = %X{remote_host}: %m%n"
NSQ_SOURCE_LINE 00002352 ""
NSQ_SOURCE_LINE 00002353 "then a log statement like"
NSQ_SOURCE_LINE 00002354 ""
NSQ_SOURCE_LINE 00002355 "   DEBUG(\"Content delivered\");"
NSQ_SOURCE_LINE 00002356 ""
NSQ_SOURCE_LINE 00002357 "will log something like"
NSQ_SOURCE_LINE 00002358 ""
NSQ_SOURCE_LINE 00002359 "   adsl-63.dsl.snf.pacbell.net: Content delivered "
NSQ_SOURCE_LINE 00002360 ""
NSQ_SOURCE_LINE 00002361 "later on in the program."
NSQ_SOURCE_LINE 00002362 ""
NSQ_SOURCE_LINE 00002363 "For details, please check L<Log::Log4perl::MDC>."
NSQ_SOURCE_LINE 00002364 ""
NSQ_SOURCE_LINE 00002365 "=head2 Resurrecting hidden Log4perl Statements"
NSQ_SOURCE_LINE 00002366 ""
NSQ_SOURCE_LINE 00002367 "Sometimes scripts need to be deployed in environments without having"
NSQ_SOURCE_LINE 00002368 "Log::Log4perl installed yet. On the other hand, you don't want to"
NSQ_SOURCE_LINE 00002369 "live without your Log4perl statements -- they're gonna come in"
NSQ_SOURCE_LINE 00002370 "handy later."
NSQ_SOURCE_LINE 00002371 ""
NSQ_SOURCE_LINE 00002372 "So, just deploy your script with Log4perl statements commented out with the"
NSQ_SOURCE_LINE 00002373 "pattern C<###l4p>, like in"
NSQ_SOURCE_LINE 00002374 ""
NSQ_SOURCE_LINE 00002375 "    ###l4p DEBUG \"It works!\";"
NSQ_SOURCE_LINE 00002376 "    # ..."
NSQ_SOURCE_LINE 00002377 "    ###l4p INFO \"Really!\";"
NSQ_SOURCE_LINE 00002378 ""
NSQ_SOURCE_LINE 00002379 "If Log::Log4perl is available,"
NSQ_SOURCE_LINE 00002380 "use the C<:resurrect> tag to have Log4perl resurrect those buried "
NSQ_SOURCE_LINE 00002381 "statements before the script starts running:"
NSQ_SOURCE_LINE 00002382 ""
NSQ_SOURCE_LINE 00002383 "    use Log::Log4perl qw(:resurrect :easy);"
NSQ_SOURCE_LINE 00002384 ""
NSQ_SOURCE_LINE 00002385 "    ###l4p Log::Log4perl->easy_init($DEBUG);"
NSQ_SOURCE_LINE 00002386 "    ###l4p DEBUG \"It works!\";"
NSQ_SOURCE_LINE 00002387 "    # ..."
NSQ_SOURCE_LINE 00002388 "    ###l4p INFO \"Really!\";"
NSQ_SOURCE_LINE 00002389 ""
NSQ_SOURCE_LINE 00002390 "This will have a source filter kick in and indeed print"
NSQ_SOURCE_LINE 00002391 ""
NSQ_SOURCE_LINE 00002392 "    2004/11/18 22:08:46 It works!"
NSQ_SOURCE_LINE 00002393 "    2004/11/18 22:08:46 Really!"
NSQ_SOURCE_LINE 00002394 ""
NSQ_SOURCE_LINE 00002395 "In environments lacking Log::Log4perl, just comment out the first line"
NSQ_SOURCE_LINE 00002396 "and the script will run nevertheless (but of course without logging):"
NSQ_SOURCE_LINE 00002397 ""
NSQ_SOURCE_LINE 00002398 "    # use Log::Log4perl qw(:resurrect :easy);"
NSQ_SOURCE_LINE 00002399 ""
NSQ_SOURCE_LINE 00002400 "    ###l4p Log::Log4perl->easy_init($DEBUG);"
NSQ_SOURCE_LINE 00002401 "    ###l4p DEBUG \"It works!\";"
NSQ_SOURCE_LINE 00002402 "    # ..."
NSQ_SOURCE_LINE 00002403 "    ###l4p INFO \"Really!\";"
NSQ_SOURCE_LINE 00002404 ""
NSQ_SOURCE_LINE 00002405 "because everything's a regular comment now. Alternatively, put the"
NSQ_SOURCE_LINE 00002406 "magic Log::Log4perl comment resurrection line into your shell's "
NSQ_SOURCE_LINE 00002407 "PERL5OPT environment variable, e.g. for bash:"
NSQ_SOURCE_LINE 00002408 ""
NSQ_SOURCE_LINE 00002409 "    set PERL5OPT=-MLog::Log4perl=:resurrect,:easy"
NSQ_SOURCE_LINE 00002410 "    export PERL5OPT"
NSQ_SOURCE_LINE 00002411 ""
NSQ_SOURCE_LINE 00002412 "This will awaken the giant within an otherwise silent script like"
NSQ_SOURCE_LINE 00002413 "the following:"
NSQ_SOURCE_LINE 00002414 ""
NSQ_SOURCE_LINE 00002415 "    #!/usr/bin/perl"
NSQ_SOURCE_LINE 00002416 ""
NSQ_SOURCE_LINE 00002417 "    ###l4p Log::Log4perl->easy_init($DEBUG);"
NSQ_SOURCE_LINE 00002418 "    ###l4p DEBUG \"It works!\";"
NSQ_SOURCE_LINE 00002419 ""
NSQ_SOURCE_LINE 00002420 "As of C<Log::Log4perl> 1.12, you can even force I<all> modules"
NSQ_SOURCE_LINE 00002421 "loaded by a script to have their hidden Log4perl statements"
NSQ_SOURCE_LINE 00002422 "resurrected. For this to happen, load C<Log::Log4perl::Resurrector>"
NSQ_SOURCE_LINE 00002423 "I<before> loading any modules:"
NSQ_SOURCE_LINE 00002424 ""
NSQ_SOURCE_LINE 00002425 "    use Log::Log4perl qw(:easy);"
NSQ_SOURCE_LINE 00002426 "    use Log::Log4perl::Resurrector;"
NSQ_SOURCE_LINE 00002427 ""
NSQ_SOURCE_LINE 00002428 "    use Foobar; # All hidden Log4perl statements in here will"
NSQ_SOURCE_LINE 00002429 "                # be uncommented before Foobar gets loaded."
NSQ_SOURCE_LINE 00002430 ""
NSQ_SOURCE_LINE 00002431 "    Log::Log4perl->easy_init($DEBUG);"
NSQ_SOURCE_LINE 00002432 "    ..."
NSQ_SOURCE_LINE 00002433 ""
NSQ_SOURCE_LINE 00002434 "Check the C<Log::Log4perl::Resurrector> manpage for more details."
NSQ_SOURCE_LINE 00002435 ""
NSQ_SOURCE_LINE 00002436 "=head2 Access defined appenders"
NSQ_SOURCE_LINE 00002437 ""
NSQ_SOURCE_LINE 00002438 "All appenders defined in the configuration file or via Perl code"
NSQ_SOURCE_LINE 00002439 "can be retrieved by the C<appender_by_name()> class method. This comes"
NSQ_SOURCE_LINE 00002440 "in handy if you want to manipulate or query appender properties after"
NSQ_SOURCE_LINE 00002441 "the Log4perl configuration has been loaded via C<init()>."
NSQ_SOURCE_LINE 00002442 ""
NSQ_SOURCE_LINE 00002443 "Note that internally, Log::Log4perl uses the C<Log::Log4perl::Appender> "
NSQ_SOURCE_LINE 00002444 "wrapper class to control the real appenders (like "
NSQ_SOURCE_LINE 00002445 "C<Log::Log4perl::Appender::File> or C<Log::Dispatch::FileRotate>). "
NSQ_SOURCE_LINE 00002446 "The C<Log::Log4perl::Appender> class has an C<appender> attribute,"
NSQ_SOURCE_LINE 00002447 "pointing to the real appender."
NSQ_SOURCE_LINE 00002448 ""
NSQ_SOURCE_LINE 00002449 "The reason for this is that external appenders like "
NSQ_SOURCE_LINE 00002450 "C<Log::Dispatch::FileRotate> don't support all of Log::Log4perl's "
NSQ_SOURCE_LINE 00002451 "appender control mechanisms (like appender thresholds)."
NSQ_SOURCE_LINE 00002452 ""
NSQ_SOURCE_LINE 00002453 "The previously mentioned method C<appender_by_name()> returns a"
NSQ_SOURCE_LINE 00002454 "reference to the I<real> appender object. If you want access to the"
NSQ_SOURCE_LINE 00002455 "wrapper class (e.g. if you want to modify the appender's threshold),"
NSQ_SOURCE_LINE 00002456 "use the hash C<$Log::Log4perl::Logger::APPENDER_BY_NAME{...}> instead,"
NSQ_SOURCE_LINE 00002457 "which holds references to all appender wrapper objects."
NSQ_SOURCE_LINE 00002458 ""
NSQ_SOURCE_LINE 00002459 "=head2 Modify appender thresholds"
NSQ_SOURCE_LINE 00002460 ""
NSQ_SOURCE_LINE 00002461 "To set an appender's threshold, use its C<threshold()> method:"
NSQ_SOURCE_LINE 00002462 ""
NSQ_SOURCE_LINE 00002463 "    $app->threshold( $FATAL );"
NSQ_SOURCE_LINE 00002464 ""
NSQ_SOURCE_LINE 00002465 "To conveniently adjust I<all> appender thresholds (e.g. because a script"
NSQ_SOURCE_LINE 00002466 "uses more_logging()), use"
NSQ_SOURCE_LINE 00002467 ""
NSQ_SOURCE_LINE 00002468 "       # decrease thresholds of all appenders"
NSQ_SOURCE_LINE 00002469 "    Log::Log4perl->appender_thresholds_adjust(-1);"
NSQ_SOURCE_LINE 00002470 ""
NSQ_SOURCE_LINE 00002471 "This will decrease the thresholds of all appenders in the system by"
NSQ_SOURCE_LINE 00002472 "one level, i.e. WARN becomes INFO, INFO becomes DEBUG, etc. To only modify "
NSQ_SOURCE_LINE 00002473 "selected ones, use"
NSQ_SOURCE_LINE 00002474 ""
NSQ_SOURCE_LINE 00002475 "       # decrease thresholds of selected appenders"
NSQ_SOURCE_LINE 00002476 "    Log::Log4perl->appender_thresholds_adjust(-1, ['AppName1', ...]);"
NSQ_SOURCE_LINE 00002477 ""
NSQ_SOURCE_LINE 00002478 "and pass the names of affected appenders in a ref to an array."
NSQ_SOURCE_LINE 00002479 ""
NSQ_SOURCE_LINE 00002480 "=head1 Advanced configuration within Perl"
NSQ_SOURCE_LINE 00002481 ""
NSQ_SOURCE_LINE 00002482 "Initializing Log::Log4perl can certainly also be done from within Perl."
NSQ_SOURCE_LINE 00002483 "At last, this is what C<Log::Log4perl::Config> does behind the scenes."
NSQ_SOURCE_LINE 00002484 "Log::Log4perl's configuration file parsers are using a publically "
NSQ_SOURCE_LINE 00002485 "available API to set up Log::Log4perl's categories, appenders and layouts."
NSQ_SOURCE_LINE 00002486 ""
NSQ_SOURCE_LINE 00002487 "Here's an example on how to configure two appenders with the same layout"
NSQ_SOURCE_LINE 00002488 "in Perl, without using a configuration file at all:"
NSQ_SOURCE_LINE 00002489 ""
NSQ_SOURCE_LINE 00002490 "  ########################"
NSQ_SOURCE_LINE 00002491 "  # Initialization section"
NSQ_SOURCE_LINE 00002492 "  ########################"
NSQ_SOURCE_LINE 00002493 "  use Log::Log4perl;"
NSQ_SOURCE_LINE 00002494 "  use Log::Log4perl::Layout;"
NSQ_SOURCE_LINE 00002495 "  use Log::Log4perl::Level;"
NSQ_SOURCE_LINE 00002496 ""
NSQ_SOURCE_LINE 00002497 "     # Define a category logger"
NSQ_SOURCE_LINE 00002498 "  my $log = Log::Log4perl->get_logger(\"Foo::Bar\");"
NSQ_SOURCE_LINE 00002499 ""
NSQ_SOURCE_LINE 00002500 "     # Define a layout"
NSQ_SOURCE_LINE 00002501 "  my $layout = Log::Log4perl::Layout::PatternLayout->new(\"[%r] %F %L %m%n\");"
NSQ_SOURCE_LINE 00002502 ""
NSQ_SOURCE_LINE 00002503 "     # Define a file appender"
NSQ_SOURCE_LINE 00002504 "  my $file_appender = Log::Log4perl::Appender->new("
NSQ_SOURCE_LINE 00002505 "                          \"Log::Log4perl::Appender::File\","
NSQ_SOURCE_LINE 00002506 "                          name      => \"filelog\","
NSQ_SOURCE_LINE 00002507 "                          filename  => \"/tmp/my.log\");"
NSQ_SOURCE_LINE 00002508 ""
NSQ_SOURCE_LINE 00002509 "     # Define a stdout appender"
NSQ_SOURCE_LINE 00002510 "  my $stdout_appender =  Log::Log4perl::Appender->new("
NSQ_SOURCE_LINE 00002511 "                          \"Log::Log4perl::Appender::Screen\","
NSQ_SOURCE_LINE 00002512 "                          name      => \"screenlog\","
NSQ_SOURCE_LINE 00002513 "                          stderr    => 0);"
NSQ_SOURCE_LINE 00002514 ""
NSQ_SOURCE_LINE 00002515 "     # Define a mixed stderr/stdout appender"
NSQ_SOURCE_LINE 00002516 "  my $mixed_stdout_stderr_appender = Log::Log4perl::Appender->new("
NSQ_SOURCE_LINE 00002517 "                          \"Log::Log4perl::Appender::Screen\","
NSQ_SOURCE_LINE 00002518 "                          name      => \"screenlog\","
NSQ_SOURCE_LINE 00002519 "                          stderr    => { ERROR => 1, FATAL => 1 });"
NSQ_SOURCE_LINE 00002520 ""
NSQ_SOURCE_LINE 00002521 "     # Have both appenders use the same layout (could be different)"
NSQ_SOURCE_LINE 00002522 "  $stdout_appender->layout($layout);"
NSQ_SOURCE_LINE 00002523 "  $file_appender->layout($layout);"
NSQ_SOURCE_LINE 00002524 ""
NSQ_SOURCE_LINE 00002525 "  $log->add_appender($stdout_appender);"
NSQ_SOURCE_LINE 00002526 "  $log->add_appender($file_appender);"
NSQ_SOURCE_LINE 00002527 "  $log->level($INFO);"
NSQ_SOURCE_LINE 00002528 ""
NSQ_SOURCE_LINE 00002529 "Please note the class of the appender object is passed as a I<string> to"
NSQ_SOURCE_LINE 00002530 "C<Log::Log4perl::Appender> in the I<first> argument. Behind the scenes,"
NSQ_SOURCE_LINE 00002531 "C<Log::Log4perl::Appender> will create the necessary"
NSQ_SOURCE_LINE 00002532 "C<Log::Log4perl::Appender::*> (or C<Log::Dispatch::*>) object and pass"
NSQ_SOURCE_LINE 00002533 "along the name value pairs we provided to"
NSQ_SOURCE_LINE 00002534 "C<Log::Log4perl::Appender-E<gt>new()> after the first argument."
NSQ_SOURCE_LINE 00002535 ""
NSQ_SOURCE_LINE 00002536 "The C<name> value is optional and if you don't provide one,"
NSQ_SOURCE_LINE 00002537 "C<Log::Log4perl::Appender-E<gt>new()> will create a unique one for you."
NSQ_SOURCE_LINE 00002538 "The names and values of additional parameters are dependent on the requirements"
NSQ_SOURCE_LINE 00002539 "of the particular appender class and can be looked up in their"
NSQ_SOURCE_LINE 00002540 "manual pages."
NSQ_SOURCE_LINE 00002541 ""
NSQ_SOURCE_LINE 00002542 "A side note: In case you're wondering if"
NSQ_SOURCE_LINE 00002543 "C<Log::Log4perl::Appender-E<gt>new()> will also take care of the"
NSQ_SOURCE_LINE 00002544 "C<min_level> argument to the C<Log::Dispatch::*> constructors called"
NSQ_SOURCE_LINE 00002545 "behind the scenes -- yes, it does. This is because we want the"
NSQ_SOURCE_LINE 00002546 "C<Log::Dispatch> objects to blindly log everything we send them"
NSQ_SOURCE_LINE 00002547 "(C<debug> is their lowest setting) because I<we> in C<Log::Log4perl>"
NSQ_SOURCE_LINE 00002548 "want to call the shots and decide on when and what to log."
NSQ_SOURCE_LINE 00002549 ""
NSQ_SOURCE_LINE 00002550 "The call to the appender's I<layout()> method specifies the format (as a"
NSQ_SOURCE_LINE 00002551 "previously created C<Log::Log4perl::Layout::PatternLayout> object) in which the"
NSQ_SOURCE_LINE 00002552 "message is being logged in the specified appender. "
NSQ_SOURCE_LINE 00002553 "If you don't specify a layout, the logger will fall back to"
NSQ_SOURCE_LINE 00002554 "C<Log::Log4perl::SimpleLayout>, which logs the debug level, a hyphen (-)"
NSQ_SOURCE_LINE 00002555 "and the log message."
NSQ_SOURCE_LINE 00002556 ""
NSQ_SOURCE_LINE 00002557 "Layouts are objects, here's how you create them:"
NSQ_SOURCE_LINE 00002558 ""
NSQ_SOURCE_LINE 00002559 "        # Create a simple layout"
NSQ_SOURCE_LINE 00002560 "    my $simple = Log::Log4perl::SimpleLayout();"
NSQ_SOURCE_LINE 00002561 ""
NSQ_SOURCE_LINE 00002562 "        # create a flexible layout:"
NSQ_SOURCE_LINE 00002563 "        # (\"yyyy/MM/dd hh:mm:ss (file:lineno)> message\\n\")"
NSQ_SOURCE_LINE 00002564 "    my $pattern = Log::Log4perl::Layout::PatternLayout(\"%d (%F:%L)> %m%n\");"
NSQ_SOURCE_LINE 00002565 ""
NSQ_SOURCE_LINE 00002566 "Every appender has exactly one layout assigned to it. You assign"
NSQ_SOURCE_LINE 00002567 "the layout to the appender using the appender's C<layout()> object:"
NSQ_SOURCE_LINE 00002568 ""
NSQ_SOURCE_LINE 00002569 "    my $app =  Log::Log4perl::Appender->new("
NSQ_SOURCE_LINE 00002570 "                  \"Log::Log4perl::Appender::Screen\","
NSQ_SOURCE_LINE 00002571 "                  name      => \"screenlog\","
NSQ_SOURCE_LINE 00002572 "                  stderr    => 0);"
NSQ_SOURCE_LINE 00002573 ""
NSQ_SOURCE_LINE 00002574 "        # Assign the previously defined flexible layout"
NSQ_SOURCE_LINE 00002575 "    $app->layout($pattern);"
NSQ_SOURCE_LINE 00002576 ""
NSQ_SOURCE_LINE 00002577 "        # Add the appender to a previously defined logger"
NSQ_SOURCE_LINE 00002578 "    $logger->add_appender($app);"
NSQ_SOURCE_LINE 00002579 ""
NSQ_SOURCE_LINE 00002580 "        # ... and you're good to go!"
NSQ_SOURCE_LINE 00002581 "    $logger->debug(\"Blah\");"
NSQ_SOURCE_LINE 00002582 "        # => \"2002/07/10 23:55:35 (test.pl:207)> Blah\\n\""
NSQ_SOURCE_LINE 00002583 ""
NSQ_SOURCE_LINE 00002584 "It's also possible to remove appenders from a logger:"
NSQ_SOURCE_LINE 00002585 ""
NSQ_SOURCE_LINE 00002586 "    $logger->remove_appender($appender_name);"
NSQ_SOURCE_LINE 00002587 ""
NSQ_SOURCE_LINE 00002588 "will remove an appender, specified by name, from a given logger. "
NSQ_SOURCE_LINE 00002589 "Please note that this does"
NSQ_SOURCE_LINE 00002590 "I<not> remove an appender from the system."
NSQ_SOURCE_LINE 00002591 ""
NSQ_SOURCE_LINE 00002592 "To eradicate an appender from the system, "
NSQ_SOURCE_LINE 00002593 "you need to call C<Log::Log4perl-E<gt>eradicate_appender($appender_name)>"
NSQ_SOURCE_LINE 00002594 "which will first remove the appender from every logger in the system"
NSQ_SOURCE_LINE 00002595 "and then will delete all references Log4perl holds to it."
NSQ_SOURCE_LINE 00002596 ""
NSQ_SOURCE_LINE 00002597 "To remove a logger from the system, use "
NSQ_SOURCE_LINE 00002598 "C<Log::Log4perl-E<gt>remove_logger($logger)>. After the remaining "
NSQ_SOURCE_LINE 00002599 "reference C<$logger> goes away, the logger will self-destruct. If the"
NSQ_SOURCE_LINE 00002600 "logger in question is a stealth logger, all of its convenience shortcuts"
NSQ_SOURCE_LINE 00002601 "(DEBUG, INFO, etc) will turn into no-ops."
NSQ_SOURCE_LINE 00002602 ""
NSQ_SOURCE_LINE 00002603 "=head1 How about Log::Dispatch::Config?"
NSQ_SOURCE_LINE 00002604 ""
NSQ_SOURCE_LINE 00002605 "Tatsuhiko Miyagawa's C<Log::Dispatch::Config> is a very clever "
NSQ_SOURCE_LINE 00002606 "simplified logger implementation, covering some of the I<log4j>"
NSQ_SOURCE_LINE 00002607 "functionality. Among the things that "
NSQ_SOURCE_LINE 00002608 "C<Log::Log4perl> can but C<Log::Dispatch::Config> can't are:"
NSQ_SOURCE_LINE 00002609 ""
NSQ_SOURCE_LINE 00002610 "=over 4"
NSQ_SOURCE_LINE 00002611 ""
NSQ_SOURCE_LINE 00002612 "=item *"
NSQ_SOURCE_LINE 00002613 ""
NSQ_SOURCE_LINE 00002614 "You can't assign categories to loggers. For small systems that's fine,"
NSQ_SOURCE_LINE 00002615 "but if you can't turn off and on detailed logging in only a tiny"
NSQ_SOURCE_LINE 00002616 "subsystem of your environment, you're missing out on a majorly"
NSQ_SOURCE_LINE 00002617 "useful log4j feature."
NSQ_SOURCE_LINE 00002618 ""
NSQ_SOURCE_LINE 00002619 "=item *"
NSQ_SOURCE_LINE 00002620 ""
NSQ_SOURCE_LINE 00002621 "Defining appender thresholds. Important if you want to solve problems like"
NSQ_SOURCE_LINE 00002622 "\"log all messages of level FATAL to STDERR, plus log all DEBUG"
NSQ_SOURCE_LINE 00002623 "messages in C<Foo::Bar> to a log file\". If you don't have appenders"
NSQ_SOURCE_LINE 00002624 "thresholds, there's no way to prevent cluttering STDERR with DEBUG messages."
NSQ_SOURCE_LINE 00002625 ""
NSQ_SOURCE_LINE 00002626 "=item *"
NSQ_SOURCE_LINE 00002627 ""
NSQ_SOURCE_LINE 00002628 "PatternLayout specifications in accordance with the standard"
NSQ_SOURCE_LINE 00002629 "(e.g. \"%d{HH:mm}\")."
NSQ_SOURCE_LINE 00002630 ""
NSQ_SOURCE_LINE 00002631 "=back"
NSQ_SOURCE_LINE 00002632 ""
NSQ_SOURCE_LINE 00002633 "Bottom line: Log::Dispatch::Config is fine for small systems with"
NSQ_SOURCE_LINE 00002634 "simple logging requirements. However, if you're"
NSQ_SOURCE_LINE 00002635 "designing a system with lots of subsystems which you need to control"
NSQ_SOURCE_LINE 00002636 "independently, you'll love the features of C<Log::Log4perl>,"
NSQ_SOURCE_LINE 00002637 "which is equally easy to use."
NSQ_SOURCE_LINE 00002638 ""
NSQ_SOURCE_LINE 00002639 "=head1 Using Log::Log4perl with wrapper functions and classes"
NSQ_SOURCE_LINE 00002640 ""
NSQ_SOURCE_LINE 00002641 "If you don't use C<Log::Log4perl> as described above, "
NSQ_SOURCE_LINE 00002642 "but from a wrapper function, the pattern layout will generate wrong data "
NSQ_SOURCE_LINE 00002643 "for %F, %C, %L, and the like. Reason for this is that C<Log::Log4perl>'s "
NSQ_SOURCE_LINE 00002644 "loggers assume a static caller depth to the application that's using them. "
NSQ_SOURCE_LINE 00002645 ""
NSQ_SOURCE_LINE 00002646 "If you're using"
NSQ_SOURCE_LINE 00002647 "one (or more) wrapper functions, C<Log::Log4perl> will indicate where"
NSQ_SOURCE_LINE 00002648 "your logger function called the loggers, not where your application"
NSQ_SOURCE_LINE 00002649 "called your wrapper:"
NSQ_SOURCE_LINE 00002650 ""
NSQ_SOURCE_LINE 00002651 "    use Log::Log4perl qw(:easy);"
NSQ_SOURCE_LINE 00002652 "    Log::Log4perl->easy_init({ level => $DEBUG, "
NSQ_SOURCE_LINE 00002653 "                               layout => \"%M %m%n\" });"
NSQ_SOURCE_LINE 00002654 ""
NSQ_SOURCE_LINE 00002655 "    sub mylog {"
NSQ_SOURCE_LINE 00002656 "        my($message) = @_;"
NSQ_SOURCE_LINE 00002657 ""
NSQ_SOURCE_LINE 00002658 "        DEBUG $message;"
NSQ_SOURCE_LINE 00002659 "    }"
NSQ_SOURCE_LINE 00002660 ""
NSQ_SOURCE_LINE 00002661 "    sub func {"
NSQ_SOURCE_LINE 00002662 "        mylog \"Hello\";"
NSQ_SOURCE_LINE 00002663 "    }"
NSQ_SOURCE_LINE 00002664 ""
NSQ_SOURCE_LINE 00002665 "    func();"
NSQ_SOURCE_LINE 00002666 ""
NSQ_SOURCE_LINE 00002667 "prints"
NSQ_SOURCE_LINE 00002668 ""
NSQ_SOURCE_LINE 00002669 "    main::mylog Hello"
NSQ_SOURCE_LINE 00002670 ""
NSQ_SOURCE_LINE 00002671 "but that's probably not what your application expects. Rather, you'd"
NSQ_SOURCE_LINE 00002672 "want"
NSQ_SOURCE_LINE 00002673 ""
NSQ_SOURCE_LINE 00002674 "    main::func Hello"
NSQ_SOURCE_LINE 00002675 ""
NSQ_SOURCE_LINE 00002676 "because the C<func> function called your logging function."
NSQ_SOURCE_LINE 00002677 ""
NSQ_SOURCE_LINE 00002678 "But don't despair, there's a solution: Just register your wrapper"
NSQ_SOURCE_LINE 00002679 "package with Log4perl beforehand. If Log4perl then finds that it's being "
NSQ_SOURCE_LINE 00002680 "called from a registered wrapper, it will automatically step up to the"
NSQ_SOURCE_LINE 00002681 "next call frame."
NSQ_SOURCE_LINE 00002682 ""
NSQ_SOURCE_LINE 00002683 "    Log::Log4perl->wrapper_register(__PACKAGE__);"
NSQ_SOURCE_LINE 00002684 ""
NSQ_SOURCE_LINE 00002685 "    sub mylog {"
NSQ_SOURCE_LINE 00002686 "        my($message) = @_;"
NSQ_SOURCE_LINE 00002687 ""
NSQ_SOURCE_LINE 00002688 "        DEBUG $message;"
NSQ_SOURCE_LINE 00002689 "    }"
NSQ_SOURCE_LINE 00002690 ""
NSQ_SOURCE_LINE 00002691 "Alternatively, you can increase the value of the global variable"
NSQ_SOURCE_LINE 00002692 "C<$Log::Log4perl::caller_depth> (defaults to 0) by one for every"
NSQ_SOURCE_LINE 00002693 "wrapper that's in between your application and C<Log::Log4perl>,"
NSQ_SOURCE_LINE 00002694 "then C<Log::Log4perl> will compensate for the difference:"
NSQ_SOURCE_LINE 00002695 ""
NSQ_SOURCE_LINE 00002696 "    sub mylog {"
NSQ_SOURCE_LINE 00002697 "        my($message) = @_;"
NSQ_SOURCE_LINE 00002698 ""
NSQ_SOURCE_LINE 00002699 "        local $Log::Log4perl::caller_depth ="
NSQ_SOURCE_LINE 00002700 "              $Log::Log4perl::caller_depth + 1;"
NSQ_SOURCE_LINE 00002701 "        DEBUG $message;"
NSQ_SOURCE_LINE 00002702 "    }"
NSQ_SOURCE_LINE 00002703 ""
NSQ_SOURCE_LINE 00002704 "Also, note that if you're writing a subclass of Log4perl, like"
NSQ_SOURCE_LINE 00002705 ""
NSQ_SOURCE_LINE 00002706 "    package MyL4pWrapper;"
NSQ_SOURCE_LINE 00002707 "    use Log::Log4perl;"
NSQ_SOURCE_LINE 00002708 "    our @ISA = qw(Log::Log4perl);"
NSQ_SOURCE_LINE 00002709 ""
NSQ_SOURCE_LINE 00002710 "and you want to call get_logger() in your code, like"
NSQ_SOURCE_LINE 00002711 ""
NSQ_SOURCE_LINE 00002712 "    use MyL4pWrapper;"
NSQ_SOURCE_LINE 00002713 ""
NSQ_SOURCE_LINE 00002714 "    sub get_logger {"
NSQ_SOURCE_LINE 00002715 "        my $logger = Log::Log4perl->get_logger();"
NSQ_SOURCE_LINE 00002716 "    }"
NSQ_SOURCE_LINE 00002717 ""
NSQ_SOURCE_LINE 00002718 "then the get_logger() call will get a logger for the C<MyL4pWrapper>"
NSQ_SOURCE_LINE 00002719 "category, not for the package calling the wrapper class as in"
NSQ_SOURCE_LINE 00002720 ""
NSQ_SOURCE_LINE 00002721 "    package UserPackage;"
NSQ_SOURCE_LINE 00002722 "    my $logger = MyL4pWrapper->get_logger();"
NSQ_SOURCE_LINE 00002723 ""
NSQ_SOURCE_LINE 00002724 "To have the above call to get_logger return a logger for the "
NSQ_SOURCE_LINE 00002725 "\"UserPackage\" category, you need to tell Log4perl that \"MyL4pWrapper\""
NSQ_SOURCE_LINE 00002726 "is a Log4perl wrapper class:"
NSQ_SOURCE_LINE 00002727 ""
NSQ_SOURCE_LINE 00002728 "    use MyL4pWrapper;"
NSQ_SOURCE_LINE 00002729 "    Log::Log4perl->wrapper_register(__PACKAGE__);"
NSQ_SOURCE_LINE 00002730 ""
NSQ_SOURCE_LINE 00002731 "    sub get_logger {"
NSQ_SOURCE_LINE 00002732 "          # Now gets a logger for the category of the calling package"
NSQ_SOURCE_LINE 00002733 "        my $logger = Log::Log4perl->get_logger();"
NSQ_SOURCE_LINE 00002734 "    }"
NSQ_SOURCE_LINE 00002735 ""
NSQ_SOURCE_LINE 00002736 "This feature works both for Log4perl-relaying classes like the wrapper"
NSQ_SOURCE_LINE 00002737 "described above, and for wrappers that inherit from Log4perl use Log4perl's"
NSQ_SOURCE_LINE 00002738 "get_logger function via inheritance, alike."
NSQ_SOURCE_LINE 00002739 ""
NSQ_SOURCE_LINE 00002740 "=head1 Access to Internals"
NSQ_SOURCE_LINE 00002741 ""
NSQ_SOURCE_LINE 00002742 "The following methods are only of use if you want to peek/poke in"
NSQ_SOURCE_LINE 00002743 "the internals of Log::Log4perl. Be careful not to disrupt its"
NSQ_SOURCE_LINE 00002744 "inner workings."
NSQ_SOURCE_LINE 00002745 ""
NSQ_SOURCE_LINE 00002746 "=over 4"
NSQ_SOURCE_LINE 00002747 ""
NSQ_SOURCE_LINE 00002748 "=item C<< Log::Log4perl->appenders() >>"
NSQ_SOURCE_LINE 00002749 ""
NSQ_SOURCE_LINE 00002750 "To find out which appenders are currently defined (not only"
NSQ_SOURCE_LINE 00002751 "for a particular logger, but overall), a C<appenders()>"
NSQ_SOURCE_LINE 00002752 "method is available to return a reference to a hash mapping appender"
NSQ_SOURCE_LINE 00002753 "names to their Log::Log4perl::Appender object references."
NSQ_SOURCE_LINE 00002754 ""
NSQ_SOURCE_LINE 00002755 "=back"
NSQ_SOURCE_LINE 00002756 ""
NSQ_SOURCE_LINE 00002757 "=head1 Dirty Tricks"
NSQ_SOURCE_LINE 00002758 ""
NSQ_SOURCE_LINE 00002759 "=over 4"
NSQ_SOURCE_LINE 00002760 ""
NSQ_SOURCE_LINE 00002761 "=item infiltrate_lwp()"
NSQ_SOURCE_LINE 00002762 ""
NSQ_SOURCE_LINE 00002763 "The famous LWP::UserAgent module isn't Log::Log4perl-enabled. Often, though,"
NSQ_SOURCE_LINE 00002764 "especially when tracing Web-related problems, it would be helpful to get"
NSQ_SOURCE_LINE 00002765 "some insight on what's happening inside LWP::UserAgent. Ideally, LWP::UserAgent"
NSQ_SOURCE_LINE 00002766 "would even play along in the Log::Log4perl framework."
NSQ_SOURCE_LINE 00002767 ""
NSQ_SOURCE_LINE 00002768 "A call to C<Log::Log4perl-E<gt>infiltrate_lwp()> does exactly this. "
NSQ_SOURCE_LINE 00002769 "In a very rude way, it pulls the rug from under LWP::UserAgent and transforms"
NSQ_SOURCE_LINE 00002770 "its C<debug/conn> messages into C<debug()> calls of loggers of the category"
NSQ_SOURCE_LINE 00002771 "C<\"LWP::UserAgent\">. Similarily, C<LWP::UserAgent>'s C<trace> messages "
NSQ_SOURCE_LINE 00002772 "are turned into C<Log::Log4perl>'s C<info()> method calls. Note that this"
NSQ_SOURCE_LINE 00002773 "only works for LWP::UserAgent versions E<lt> 5.822, because this (and"
NSQ_SOURCE_LINE 00002774 "probably later) versions miss debugging functions entirely."
NSQ_SOURCE_LINE 00002775 ""
NSQ_SOURCE_LINE 00002776 "=item Suppressing 'duplicate' LOGDIE messages"
NSQ_SOURCE_LINE 00002777 ""
NSQ_SOURCE_LINE 00002778 "If a script with a simple Log4perl configuration uses logdie() to catch"
NSQ_SOURCE_LINE 00002779 "errors and stop processing, as in "
NSQ_SOURCE_LINE 00002780 ""
NSQ_SOURCE_LINE 00002781 "    use Log::Log4perl qw(:easy) ;"
NSQ_SOURCE_LINE 00002782 "    Log::Log4perl->easy_init($DEBUG);"
NSQ_SOURCE_LINE 00002783 "    "
NSQ_SOURCE_LINE 00002784 "    shaky_function() or LOGDIE \"It failed!\";"
NSQ_SOURCE_LINE 00002785 ""
NSQ_SOURCE_LINE 00002786 "there's a cosmetic problem: The message gets printed twice:"
NSQ_SOURCE_LINE 00002787 ""
NSQ_SOURCE_LINE 00002788 "    2005/07/10 18:37:14 It failed!"
NSQ_SOURCE_LINE 00002789 "    It failed! at ./t line 12"
NSQ_SOURCE_LINE 00002790 ""
NSQ_SOURCE_LINE 00002791 "The obvious solution is to use LOGEXIT() instead of LOGDIE(), but there's"
NSQ_SOURCE_LINE 00002792 "also a special tag for Log4perl that suppresses the second message:"
NSQ_SOURCE_LINE 00002793 ""
NSQ_SOURCE_LINE 00002794 "    use Log::Log4perl qw(:no_extra_logdie_message);"
NSQ_SOURCE_LINE 00002795 ""
NSQ_SOURCE_LINE 00002796 "This causes logdie() and logcroak() to call exit() instead of die(). To"
NSQ_SOURCE_LINE 00002797 "modify the script exit code in these occasions, set the variable"
NSQ_SOURCE_LINE 00002798 "C<$Log::Log4perl::LOGEXIT_CODE> to the desired value, the default is 1."
NSQ_SOURCE_LINE 00002799 ""
NSQ_SOURCE_LINE 00002800 "=item Redefine values without causing errors"
NSQ_SOURCE_LINE 00002801 ""
NSQ_SOURCE_LINE 00002802 "Log4perl's configuration file parser has a few basic safety mechanisms to "
NSQ_SOURCE_LINE 00002803 "make sure configurations are more or less sane. "
NSQ_SOURCE_LINE 00002804 ""
NSQ_SOURCE_LINE 00002805 "One of these safety measures is catching redefined values. For example, if"
NSQ_SOURCE_LINE 00002806 "you first write"
NSQ_SOURCE_LINE 00002807 ""
NSQ_SOURCE_LINE 00002808 "    log4perl.category = WARN, Logfile"
NSQ_SOURCE_LINE 00002809 ""
NSQ_SOURCE_LINE 00002810 "and then a couple of lines later"
NSQ_SOURCE_LINE 00002811 ""
NSQ_SOURCE_LINE 00002812 "    log4perl.category = TRACE, Logfile"
NSQ_SOURCE_LINE 00002813 ""
NSQ_SOURCE_LINE 00002814 "then you might have unintentionally overwritten the first value and Log4perl"
NSQ_SOURCE_LINE 00002815 "will die on this with an error (suspicious configurations always throw an"
NSQ_SOURCE_LINE 00002816 "error). Now, there's a chance that this is intentional, for example when"
NSQ_SOURCE_LINE 00002817 "you're lumping together several configuration files and actually I<want>"
NSQ_SOURCE_LINE 00002818 "the first value to overwrite the second. In this case use"
NSQ_SOURCE_LINE 00002819 ""
NSQ_SOURCE_LINE 00002820 "    use Log::Log4perl qw(:nostrict);"
NSQ_SOURCE_LINE 00002821 ""
NSQ_SOURCE_LINE 00002822 "to put Log4perl in a more permissive mode."
NSQ_SOURCE_LINE 00002823 ""
NSQ_SOURCE_LINE 00002824 "=item Prevent croak/confess from stringifying"
NSQ_SOURCE_LINE 00002825 ""
NSQ_SOURCE_LINE 00002826 "The logcroak/logconfess functions stringify their arguments before"
NSQ_SOURCE_LINE 00002827 "they pass them to Carp's croak/confess functions. This can get in the"
NSQ_SOURCE_LINE 00002828 "way if you want to throw an object or a hashref as an exception, in"
NSQ_SOURCE_LINE 00002829 "this case use:"
NSQ_SOURCE_LINE 00002830 ""
NSQ_SOURCE_LINE 00002831 "    $Log::Log4perl::STRINGIFY_DIE_MESSAGE = 0;"
NSQ_SOURCE_LINE 00002832 ""
NSQ_SOURCE_LINE 00002833 "    eval {"
NSQ_SOURCE_LINE 00002834 "          # throws { foo => \"bar\" }"
NSQ_SOURCE_LINE 00002835 "          # without stringification"
NSQ_SOURCE_LINE 00002836 "        $logger->logcroak( { foo => \"bar\" } );"
NSQ_SOURCE_LINE 00002837 "    };"
NSQ_SOURCE_LINE 00002838 ""
NSQ_SOURCE_LINE 00002839 "=back"
NSQ_SOURCE_LINE 00002840 ""
NSQ_SOURCE_LINE 00002841 "=head1 EXAMPLE"
NSQ_SOURCE_LINE 00002842 ""
NSQ_SOURCE_LINE 00002843 "A simple example to cut-and-paste and get started:"
NSQ_SOURCE_LINE 00002844 ""
NSQ_SOURCE_LINE 00002845 "    use Log::Log4perl qw(get_logger);"
NSQ_SOURCE_LINE 00002846 "    "
NSQ_SOURCE_LINE 00002847 "    my $conf = q("
NSQ_SOURCE_LINE 00002848 "    log4perl.category.Bar.Twix         = WARN, Logfile"
NSQ_SOURCE_LINE 00002849 "    log4perl.appender.Logfile          = Log::Log4perl::Appender::File"
NSQ_SOURCE_LINE 00002850 "    log4perl.appender.Logfile.filename = test.log"
NSQ_SOURCE_LINE 00002851 "    log4perl.appender.Logfile.layout = \\"
NSQ_SOURCE_LINE 00002852 "        Log::Log4perl::Layout::PatternLayout"
NSQ_SOURCE_LINE 00002853 "    log4perl.appender.Logfile.layout.ConversionPattern = %d %F{1} %L> %m %n"
NSQ_SOURCE_LINE 00002854 "    );"
NSQ_SOURCE_LINE 00002855 "    "
NSQ_SOURCE_LINE 00002856 "    Log::Log4perl::init(\\$conf);"
NSQ_SOURCE_LINE 00002857 "    "
NSQ_SOURCE_LINE 00002858 "    my $logger = get_logger(\"Bar::Twix\");"
NSQ_SOURCE_LINE 00002859 "    $logger->error(\"Blah\");"
NSQ_SOURCE_LINE 00002860 ""
NSQ_SOURCE_LINE 00002861 "This will log something like"
NSQ_SOURCE_LINE 00002862 ""
NSQ_SOURCE_LINE 00002863 "    2002/09/19 23:48:15 t1 25> Blah "
NSQ_SOURCE_LINE 00002864 ""
NSQ_SOURCE_LINE 00002865 "to the log file C<test.log>, which Log4perl will append to or "
NSQ_SOURCE_LINE 00002866 "create it if it doesn't exist already."
NSQ_SOURCE_LINE 00002867 ""
NSQ_SOURCE_LINE 00002868 "=head1 INSTALLATION"
NSQ_SOURCE_LINE 00002869 ""
NSQ_SOURCE_LINE 00002870 "If you want to use external appenders provided with C<Log::Dispatch>,"
NSQ_SOURCE_LINE 00002871 "you need to install C<Log::Dispatch> (2.00 or better) from CPAN,"
NSQ_SOURCE_LINE 00002872 "which itself depends on C<Attribute-Handlers> and"
NSQ_SOURCE_LINE 00002873 "C<Params-Validate>. And a lot of other modules, that's the reason"
NSQ_SOURCE_LINE 00002874 "why we're now shipping Log::Log4perl with its own standard appenders"
NSQ_SOURCE_LINE 00002875 "and only if you wish to use additional ones, you'll have to go through"
NSQ_SOURCE_LINE 00002876 "the C<Log::Dispatch> installation process."
NSQ_SOURCE_LINE 00002877 ""
NSQ_SOURCE_LINE 00002878 "Log::Log4perl needs C<Test::More>, C<Test::Harness> and C<File::Spec>, "
NSQ_SOURCE_LINE 00002879 "but they already come with fairly recent versions of perl."
NSQ_SOURCE_LINE 00002880 "If not, everything's automatically fetched from CPAN if you're using the CPAN "
NSQ_SOURCE_LINE 00002881 "shell (CPAN.pm), because they're listed as dependencies."
NSQ_SOURCE_LINE 00002882 ""
NSQ_SOURCE_LINE 00002883 "C<Time::HiRes> (1.20 or better) is required only if you need the"
NSQ_SOURCE_LINE 00002884 "fine-grained time stamps of the C<%r> parameter in"
NSQ_SOURCE_LINE 00002885 "C<Log::Log4perl::Layout::PatternLayout>."
NSQ_SOURCE_LINE 00002886 ""
NSQ_SOURCE_LINE 00002887 "Manual installation works as usual with"
NSQ_SOURCE_LINE 00002888 ""
NSQ_SOURCE_LINE 00002889 "    perl Makefile.PL"
NSQ_SOURCE_LINE 00002890 "    make"
NSQ_SOURCE_LINE 00002891 "    make test"
NSQ_SOURCE_LINE 00002892 "    make install"
NSQ_SOURCE_LINE 00002893 ""
NSQ_SOURCE_LINE 00002894 "=head1 DEVELOPMENT"
NSQ_SOURCE_LINE 00002895 ""
NSQ_SOURCE_LINE 00002896 "Log::Log4perl is still being actively developed. We will"
NSQ_SOURCE_LINE 00002897 "always make sure the test suite (approx. 500 cases) will pass, but there "
NSQ_SOURCE_LINE 00002898 "might still be bugs. please check L<http://github.com/mschilli/log4perl>"
NSQ_SOURCE_LINE 00002899 "for the latest release. The api has reached a mature state, we will "
NSQ_SOURCE_LINE 00002900 "not change it unless for a good reason."
NSQ_SOURCE_LINE 00002901 ""
NSQ_SOURCE_LINE 00002902 "Bug reports and feedback are always welcome, just email them to our "
NSQ_SOURCE_LINE 00002903 "mailing list shown in the AUTHORS section. We're usually addressing"
NSQ_SOURCE_LINE 00002904 "them immediately."
NSQ_SOURCE_LINE 00002905 ""
NSQ_SOURCE_LINE 00002906 "=head1 REFERENCES"
