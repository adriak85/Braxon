NSQ_SOURCE_LINE 00000271 "##################################################"
NSQ_SOURCE_LINE 00000272 "sub easy_init { # Initialize the root logger with a screen appender"
NSQ_SOURCE_LINE 00000273 "##################################################"
NSQ_SOURCE_LINE 00000274 "    my($class, @args) = @_;"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "    # Did somebody call us with Log::Log4perl::easy_init()?"
NSQ_SOURCE_LINE 00000277 "    if(ref($class) or $class =~ /^\\d+$/) {"
NSQ_SOURCE_LINE 00000278 "        unshift @args, $class;"
NSQ_SOURCE_LINE 00000279 "    }"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "    # Reset everything first"
NSQ_SOURCE_LINE 00000282 "    Log::Log4perl->reset();"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    my @loggers = ();"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "    my %default = ( level    => $DEBUG,"
NSQ_SOURCE_LINE 00000287 "                    file     => \"STDERR\","
NSQ_SOURCE_LINE 00000288 "                    utf8     => undef,"
NSQ_SOURCE_LINE 00000289 "                    category => \"\","
NSQ_SOURCE_LINE 00000290 "                    layout   => \"%d %m%n\","
NSQ_SOURCE_LINE 00000291 "                  );"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "    if(!@args) {"
NSQ_SOURCE_LINE 00000294 "        push @loggers, \\%default;"
NSQ_SOURCE_LINE 00000295 "    } else {"
NSQ_SOURCE_LINE 00000296 "        for my $arg (@args) {"
NSQ_SOURCE_LINE 00000297 "            if($arg =~ /^\\d+$/) {"
NSQ_SOURCE_LINE 00000298 "                my %logger = (%default, level => $arg);"
NSQ_SOURCE_LINE 00000299 "                push @loggers, \\%logger;"
NSQ_SOURCE_LINE 00000300 "            } elsif(ref($arg) eq \"HASH\") {"
NSQ_SOURCE_LINE 00000301 "                my %logger = (%default, %$arg);"
NSQ_SOURCE_LINE 00000302 "                push @loggers, \\%logger;"
NSQ_SOURCE_LINE 00000303 "            } else {"
NSQ_SOURCE_LINE 00000304 "                # I suggest this becomes a croak() after a"
NSQ_SOURCE_LINE 00000305 "                # reasonable deprecation cycle."
NSQ_SOURCE_LINE 00000306 "                carp \"All arguments to easy_init should be either \""
NSQ_SOURCE_LINE 00000307 "                   . \"an integer log level or a hash reference.\";"
NSQ_SOURCE_LINE 00000308 "            }"
NSQ_SOURCE_LINE 00000309 "        }"
NSQ_SOURCE_LINE 00000310 "    }"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "    for my $logger (@loggers) {"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "        my $app;"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "        if($logger->{file} =~ /^stderr$/i) {"
NSQ_SOURCE_LINE 00000317 "            $app = Log::Log4perl::Appender->new("
NSQ_SOURCE_LINE 00000318 "                \"Log::Log4perl::Appender::Screen\","
NSQ_SOURCE_LINE 00000319 "                utf8 => $logger->{utf8});"
NSQ_SOURCE_LINE 00000320 "        } elsif($logger->{file} =~ /^stdout$/i) {"
NSQ_SOURCE_LINE 00000321 "            $app = Log::Log4perl::Appender->new("
NSQ_SOURCE_LINE 00000322 "                \"Log::Log4perl::Appender::Screen\","
NSQ_SOURCE_LINE 00000323 "                stderr => 0,"
NSQ_SOURCE_LINE 00000324 "                utf8   => $logger->{utf8});"
NSQ_SOURCE_LINE 00000325 "        } else {"
NSQ_SOURCE_LINE 00000326 "            my $binmode;"
NSQ_SOURCE_LINE 00000327 "            if($logger->{file} =~ s/^(:.*?)>/>/) {"
NSQ_SOURCE_LINE 00000328 "                $binmode = $1;"
NSQ_SOURCE_LINE 00000329 "            }"
NSQ_SOURCE_LINE 00000330 "            $logger->{file} =~ /^(>)?(>)?/;"
NSQ_SOURCE_LINE 00000331 "            my $mode = ($2 ? \"append\" : \"write\");"
NSQ_SOURCE_LINE 00000332 "            $logger->{file} =~ s/.*>+\\s*//g;"
NSQ_SOURCE_LINE 00000333 "            $app = Log::Log4perl::Appender->new("
NSQ_SOURCE_LINE 00000334 "                \"Log::Log4perl::Appender::File\","
NSQ_SOURCE_LINE 00000335 "                filename => $logger->{file},"
NSQ_SOURCE_LINE 00000336 "                mode     => $mode,"
NSQ_SOURCE_LINE 00000337 "                utf8     => $logger->{utf8},"
NSQ_SOURCE_LINE 00000338 "                binmode  => $binmode,"
NSQ_SOURCE_LINE 00000339 "            );"
NSQ_SOURCE_LINE 00000340 "        }"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "        my $layout = Log::Log4perl::Layout::PatternLayout->new("
NSQ_SOURCE_LINE 00000343 "                                                        $logger->{layout});"
NSQ_SOURCE_LINE 00000344 "        $app->layout($layout);"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "        my $log = Log::Log4perl->get_logger($logger->{category});"
NSQ_SOURCE_LINE 00000347 "        $log->level($logger->{level});"
NSQ_SOURCE_LINE 00000348 "        $log->add_appender($app);"
NSQ_SOURCE_LINE 00000349 "    }"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "    $Log::Log4perl::Logger::INITIALIZED = 1;"
NSQ_SOURCE_LINE 00000352 "}"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "##################################################"
NSQ_SOURCE_LINE 00000355 "sub wrapper_register {  "
NSQ_SOURCE_LINE 00000356 "##################################################"
NSQ_SOURCE_LINE 00000357 "    my $wrapper = $_[-1];"
NSQ_SOURCE_LINE 00000358 ""
