NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "our $VERSION = '1.57';"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "   # set this to '1' if you're using a wrapper"
NSQ_SOURCE_LINE 00000022 "   # around Log::Log4perl"
NSQ_SOURCE_LINE 00000023 "our $caller_depth = 0;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    #this is a mapping of convenience names to opcode masks used in"
NSQ_SOURCE_LINE 00000026 "    #$ALLOWED_CODE_OPS_IN_CONFIG_FILE below"
NSQ_SOURCE_LINE 00000027 "our %ALLOWED_CODE_OPS = ("
NSQ_SOURCE_LINE 00000028 "    'safe'        => [ ':browse' ],"
NSQ_SOURCE_LINE 00000029 "    'restrictive' => [ ':default' ],"
NSQ_SOURCE_LINE 00000030 ");"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "our %WRAPPERS_REGISTERED = map { $_ => 1 } qw(Log::Log4perl);"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    #set this to the opcodes which are allowed when"
NSQ_SOURCE_LINE 00000035 "    #$ALLOW_CODE_IN_CONFIG_FILE is set to a true value"
NSQ_SOURCE_LINE 00000036 "    #if undefined, there are no restrictions on code that can be"
NSQ_SOURCE_LINE 00000037 "    #excuted"
NSQ_SOURCE_LINE 00000038 "our @ALLOWED_CODE_OPS_IN_CONFIG_FILE;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    #this hash lists things that should be exported into the Safe"
NSQ_SOURCE_LINE 00000041 "    #compartment.  The keys are the package the symbol should be"
NSQ_SOURCE_LINE 00000042 "    #exported from and the values are array references to the names"
NSQ_SOURCE_LINE 00000043 "    #of the symbols (including the leading type specifier)"
NSQ_SOURCE_LINE 00000044 "our %VARS_SHARED_WITH_SAFE_COMPARTMENT = ("
NSQ_SOURCE_LINE 00000045 "    main => [ '%ENV' ],"
NSQ_SOURCE_LINE 00000046 ");"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "    #setting this to a true value will allow Perl code to be executed"
NSQ_SOURCE_LINE 00000049 "    #within the config file.  It works in conjunction with"
NSQ_SOURCE_LINE 00000050 "    #$ALLOWED_CODE_OPS_IN_CONFIG_FILE, which if defined restricts the"
NSQ_SOURCE_LINE 00000051 "    #opcodes which can be executed using the 'Safe' module."
NSQ_SOURCE_LINE 00000052 "    #setting this to a false value disables code execution in the"
NSQ_SOURCE_LINE 00000053 "    #config file"
NSQ_SOURCE_LINE 00000054 "our $ALLOW_CODE_IN_CONFIG_FILE = 1;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    #arrays in a log message will be joined using this character,"
NSQ_SOURCE_LINE 00000057 "    #see Log::Log4perl::Appender::DBI"
NSQ_SOURCE_LINE 00000058 "our $JOIN_MSG_ARRAY_CHAR = '';"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    #version required for XML::DOM, to enable XML Config parsing"
NSQ_SOURCE_LINE 00000061 "    #and XML Config unit tests"
NSQ_SOURCE_LINE 00000062 "our $DOM_VERSION_REQUIRED = '1.29'; "
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "our $CHATTY_DESTROY_METHODS = 0;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "our $LOGDIE_MESSAGE_ON_STDERR = 1;"
NSQ_SOURCE_LINE 00000067 "our $LOGEXIT_CODE             = 1;"
NSQ_SOURCE_LINE 00000068 "our %IMPORT_CALLED;"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "our $EASY_CLOSURES = {};"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "  # to throw refs as exceptions via logcarp/confess, turn this off"
NSQ_SOURCE_LINE 00000073 "our $STRINGIFY_DIE_MESSAGE = 1;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "use constant _INTERNAL_DEBUG => 0;"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "##################################################"
NSQ_SOURCE_LINE 00000078 "sub import {"
NSQ_SOURCE_LINE 00000079 "##################################################"
NSQ_SOURCE_LINE 00000080 "    my($class) = shift;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    my $caller_pkg = caller();"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    return 1 if $IMPORT_CALLED{$caller_pkg}++;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    my(%tags) = map { $_ => 1 } @_;"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "        # Lazy man's logger"
NSQ_SOURCE_LINE 00000089 "    if(exists $tags{':easy'}) {"
NSQ_SOURCE_LINE 00000090 "        $tags{':levels'} = 1;"
NSQ_SOURCE_LINE 00000091 "        $tags{':nowarn'} = 1;"
NSQ_SOURCE_LINE 00000092 "        $tags{'get_logger'} = 1;"
NSQ_SOURCE_LINE 00000093 "    }"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    if(exists $tags{':no_extra_logdie_message'}) {"
NSQ_SOURCE_LINE 00000096 "        $Log::Log4perl::LOGDIE_MESSAGE_ON_STDERR = 0;"
NSQ_SOURCE_LINE 00000097 "        delete $tags{':no_extra_logdie_message'};"
NSQ_SOURCE_LINE 00000098 "    }"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    if(exists $tags{get_logger}) {"
NSQ_SOURCE_LINE 00000101 "        # Export get_logger into the calling module's "
NSQ_SOURCE_LINE 00000102 "        no strict qw(refs);"
NSQ_SOURCE_LINE 00000103 "        *{\"$caller_pkg\\::get_logger\"} = *get_logger;"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "        delete $tags{get_logger};"
NSQ_SOURCE_LINE 00000106 "    }"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "    if(exists $tags{':levels'}) {"
NSQ_SOURCE_LINE 00000109 "        # Export log levels ($DEBUG, $INFO etc.) from Log4perl::Level"
NSQ_SOURCE_LINE 00000110 "        for my $key (keys %Log::Log4perl::Level::PRIORITY) {"
NSQ_SOURCE_LINE 00000111 "            my $name  = \"$caller_pkg\\::$key\";"
NSQ_SOURCE_LINE 00000112 "               # Need to split this up in two lines, or CVS will"
NSQ_SOURCE_LINE 00000113 "               # mess it up."
NSQ_SOURCE_LINE 00000114 "            my $value = $Log::Log4perl::Level::PRIORITY{"
NSQ_SOURCE_LINE 00000115 "              $key};"
NSQ_SOURCE_LINE 00000116 "            no strict qw(refs);"
NSQ_SOURCE_LINE 00000117 "            *{\"$name\"} = \\$value;"
NSQ_SOURCE_LINE 00000118 "        } "
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "        delete $tags{':levels'};"
NSQ_SOURCE_LINE 00000121 "    }"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "        # Lazy man's logger"
NSQ_SOURCE_LINE 00000124 "    if(exists $tags{':easy'}) {"
NSQ_SOURCE_LINE 00000125 "        delete $tags{':easy'};"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "            # Define default logger object in caller's package"
NSQ_SOURCE_LINE 00000128 "        my $logger = get_logger(\"$caller_pkg\");"
NSQ_SOURCE_LINE 00000129 "        "
NSQ_SOURCE_LINE 00000130 "            # Define DEBUG, INFO, etc. routines in caller's package"
NSQ_SOURCE_LINE 00000131 "        for(qw(TRACE DEBUG INFO WARN ERROR FATAL ALWAYS)) {"
NSQ_SOURCE_LINE 00000132 "            my $level   = $_;"
NSQ_SOURCE_LINE 00000133 "            $level = \"OFF\" if $level eq \"ALWAYS\";"
NSQ_SOURCE_LINE 00000134 "            my $lclevel = lc($_);"
NSQ_SOURCE_LINE 00000135 "            easy_closure_create($caller_pkg, $_, sub {"
NSQ_SOURCE_LINE 00000136 "                Log::Log4perl::Logger::init_warn() unless "
NSQ_SOURCE_LINE 00000137 "                    $Log::Log4perl::Logger::INITIALIZED or"
NSQ_SOURCE_LINE 00000138 "                    $Log::Log4perl::Logger::NON_INIT_WARNED;"
NSQ_SOURCE_LINE 00000139 "                $logger->{$level}->($logger, @_, $level);"
NSQ_SOURCE_LINE 00000140 "            }, $logger);"
NSQ_SOURCE_LINE 00000141 "        }"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "            # Define LOGCROAK, LOGCLUCK, etc. routines in caller's package"
NSQ_SOURCE_LINE 00000144 "        for(qw(LOGCROAK LOGCLUCK LOGCARP LOGCONFESS)) {"
NSQ_SOURCE_LINE 00000145 "            my $method = \"Log::Log4perl::Logger::\" . lc($_);"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "            easy_closure_create($caller_pkg, $_, sub {"
NSQ_SOURCE_LINE 00000148 "                unshift @_, $logger;"
NSQ_SOURCE_LINE 00000149 "                goto &$method;"
NSQ_SOURCE_LINE 00000150 "            }, $logger);"
NSQ_SOURCE_LINE 00000151 "        }"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "            # Define LOGDIE, LOGWARN"
NSQ_SOURCE_LINE 00000154 "         easy_closure_create($caller_pkg, \"LOGDIE\", sub {"
NSQ_SOURCE_LINE 00000155 "             Log::Log4perl::Logger::init_warn() unless "
NSQ_SOURCE_LINE 00000156 "                     $Log::Log4perl::Logger::INITIALIZED or"
NSQ_SOURCE_LINE 00000157 "                     $Log::Log4perl::Logger::NON_INIT_WARNED;"
NSQ_SOURCE_LINE 00000158 "             $logger->{FATAL}->($logger, @_, \"FATAL\");"
NSQ_SOURCE_LINE 00000159 "             $Log::Log4perl::LOGDIE_MESSAGE_ON_STDERR ?"
NSQ_SOURCE_LINE 00000160 "                 CORE::die(Log::Log4perl::Logger::callerline(join '', @_)) :"
NSQ_SOURCE_LINE 00000161 "                 exit $Log::Log4perl::LOGEXIT_CODE;"
NSQ_SOURCE_LINE 00000162 "         }, $logger);"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "         easy_closure_create($caller_pkg, \"LOGEXIT\", sub {"
NSQ_SOURCE_LINE 00000165 "            Log::Log4perl::Logger::init_warn() unless "
NSQ_SOURCE_LINE 00000166 "                    $Log::Log4perl::Logger::INITIALIZED or"
NSQ_SOURCE_LINE 00000167 "                    $Log::Log4perl::Logger::NON_INIT_WARNED;"
NSQ_SOURCE_LINE 00000168 "            $logger->{FATAL}->($logger, @_, \"FATAL\");"
NSQ_SOURCE_LINE 00000169 "            exit $Log::Log4perl::LOGEXIT_CODE;"
NSQ_SOURCE_LINE 00000170 "         }, $logger);"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "        easy_closure_create($caller_pkg, \"LOGWARN\", sub {"
NSQ_SOURCE_LINE 00000173 "            Log::Log4perl::Logger::init_warn() unless "
NSQ_SOURCE_LINE 00000174 "                    $Log::Log4perl::Logger::INITIALIZED or"
NSQ_SOURCE_LINE 00000175 "                    $Log::Log4perl::Logger::NON_INIT_WARNED;"
NSQ_SOURCE_LINE 00000176 "            $logger->{WARN}->($logger, @_, \"WARN\");"
NSQ_SOURCE_LINE 00000177 "            CORE::warn(Log::Log4perl::Logger::callerline(join '', @_))"
NSQ_SOURCE_LINE 00000178 "                if $Log::Log4perl::LOGDIE_MESSAGE_ON_STDERR;"
NSQ_SOURCE_LINE 00000179 "        }, $logger);"
NSQ_SOURCE_LINE 00000180 "    }"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    if(exists $tags{':nowarn'}) {"
NSQ_SOURCE_LINE 00000183 "        $Log::Log4perl::Logger::NON_INIT_WARNED = 1;"
NSQ_SOURCE_LINE 00000184 "        delete $tags{':nowarn'};"
NSQ_SOURCE_LINE 00000185 "    }"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "    if(exists $tags{':nostrict'}) {"
NSQ_SOURCE_LINE 00000188 "        $Log::Log4perl::Logger::NO_STRICT = 1;"
NSQ_SOURCE_LINE 00000189 "        delete $tags{':nostrict'};"
NSQ_SOURCE_LINE 00000190 "    }"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "    if(exists $tags{':resurrect'}) {"
NSQ_SOURCE_LINE 00000193 "        my $FILTER_MODULE = \"Filter::Util::Call\";"
NSQ_SOURCE_LINE 00000194 "        if(! Log::Log4perl::Util::module_available($FILTER_MODULE)) {"
NSQ_SOURCE_LINE 00000195 "            die \"$FILTER_MODULE required with :resurrect\" ."
NSQ_SOURCE_LINE 00000196 "                \"(install from CPAN)\";"
NSQ_SOURCE_LINE 00000197 "        }"
NSQ_SOURCE_LINE 00000198 "        eval \"require $FILTER_MODULE\" or die \"Cannot pull in $FILTER_MODULE\";"
NSQ_SOURCE_LINE 00000199 "        Filter::Util::Call::filter_add("
NSQ_SOURCE_LINE 00000200 "            sub {"
NSQ_SOURCE_LINE 00000201 "                my($status);"
NSQ_SOURCE_LINE 00000202 "                s/^\\s*###l4p// if"
NSQ_SOURCE_LINE 00000203 "                    ($status = Filter::Util::Call::filter_read()) > 0;"
NSQ_SOURCE_LINE 00000204 "                $status;"
NSQ_SOURCE_LINE 00000205 "                });"
NSQ_SOURCE_LINE 00000206 "        delete $tags{':resurrect'};"
NSQ_SOURCE_LINE 00000207 "    }"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "    if(keys %tags) {"
NSQ_SOURCE_LINE 00000210 "        # We received an Option we couldn't understand."
NSQ_SOURCE_LINE 00000211 "        die \"Unknown Option(s): @{[keys %tags]}\";"
NSQ_SOURCE_LINE 00000212 "    }"
NSQ_SOURCE_LINE 00000213 "}"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "##################################################"
NSQ_SOURCE_LINE 00000216 "sub initialized {"
NSQ_SOURCE_LINE 00000217 "##################################################"
NSQ_SOURCE_LINE 00000218 "    return $Log::Log4perl::Logger::INITIALIZED;"
