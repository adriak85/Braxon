NSQ_SOURCE_LINE 00000001 "package Stream::Buffered;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use FileHandle; # for seek etc."
NSQ_SOURCE_LINE 00000006 "use Stream::Buffered::Auto;"
NSQ_SOURCE_LINE 00000007 "use Stream::Buffered::File;"
NSQ_SOURCE_LINE 00000008 "use Stream::Buffered::PerlIO;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $VERSION = 0.03;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our $MaxMemoryBufferSize = 1024 * 1024;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub new {"
NSQ_SOURCE_LINE 00000015 "    my($class, $length) = @_;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "    # $MaxMemoryBufferSize = 0  -> Always temp file"
NSQ_SOURCE_LINE 00000018 "    # $MaxMemoryBufferSize = -1 -> Always PerlIO"
NSQ_SOURCE_LINE 00000019 "    my $backend;"
NSQ_SOURCE_LINE 00000020 "    if ($MaxMemoryBufferSize < 0) {"
NSQ_SOURCE_LINE 00000021 "        $backend = \"PerlIO\";"
NSQ_SOURCE_LINE 00000022 "    } elsif ($MaxMemoryBufferSize == 0) {"
NSQ_SOURCE_LINE 00000023 "        $backend = \"File\";"
NSQ_SOURCE_LINE 00000024 "    } elsif (!$length) {"
NSQ_SOURCE_LINE 00000025 "        $backend = \"Auto\";"
NSQ_SOURCE_LINE 00000026 "    } elsif ($length > $MaxMemoryBufferSize) {"
NSQ_SOURCE_LINE 00000027 "        $backend = \"File\";"
NSQ_SOURCE_LINE 00000028 "    } else {"
NSQ_SOURCE_LINE 00000029 "        $backend = \"PerlIO\";"
NSQ_SOURCE_LINE 00000030 "    }"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    $class->create($backend, $length, $MaxMemoryBufferSize);"
NSQ_SOURCE_LINE 00000033 "}"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "sub create {"
NSQ_SOURCE_LINE 00000036 "    my($class, $backend, $length, $max) = @_;"
NSQ_SOURCE_LINE 00000037 "    (__PACKAGE__ . \"::$backend\")->new($length, $max);"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "sub print;"
NSQ_SOURCE_LINE 00000041 "sub rewind;"
NSQ_SOURCE_LINE 00000042 "sub size;"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "1;"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "__END__"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "=head1 NAME"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "Stream::Buffered - temporary buffer to save bytes"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "  my $buf = Stream::Buffered->new($length);"
NSQ_SOURCE_LINE 00000055 "  $buf->print($bytes);"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "  my $size = $buf->size;"
NSQ_SOURCE_LINE 00000058 "  my $fh   = $buf->rewind;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "Stream::Buffered is a buffer class to store arbitrary length of byte"
NSQ_SOURCE_LINE 00000063 "strings and then get a seekable filehandle once everything is"
NSQ_SOURCE_LINE 00000064 "buffered. It uses PerlIO and/or temporary file to save the buffer"
NSQ_SOURCE_LINE 00000065 "depending on the length of the size."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "L<Plack::Request>"
