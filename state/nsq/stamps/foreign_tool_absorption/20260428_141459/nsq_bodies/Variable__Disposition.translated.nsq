NSQ_SOURCE_LINE 00000001 "package Variable::Disposition;"
NSQ_SOURCE_LINE 00000002 "# ABSTRACT: dispose of variables"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use parent qw(Exporter);"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.005';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "=head1 NAME"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "Variable::Disposition - helper functions for disposing of variables"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 " use feature qw(say);"
NSQ_SOURCE_LINE 00000017 " use Variable::Disposition;"
NSQ_SOURCE_LINE 00000018 " my $x = [];"
NSQ_SOURCE_LINE 00000019 " dispose $x;"
NSQ_SOURCE_LINE 00000020 " say '$x is no longer defined';"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "Provides some basic helper functions for making sure variables go away"
NSQ_SOURCE_LINE 00000025 "when you want them to."
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "Currently provides L</dispose> as a default import. To avoid this:"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 " use Variable::Disposition ();"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "In addition, L</retain> and L</retain_future> are available as optional"
NSQ_SOURCE_LINE 00000032 "imports."
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 " use Variable::Disposition qw(dispose retain retain_future);"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "The C< :all > tag can be used to import every available function:"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 " use Variable::Disposition qw(:all);"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "but it would be safer to use a version instead:"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 " use Variable::Disposition qw(:v1);"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "since these are guaranteed not to change in future."
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "Other functions for use with L<Future> and L<IO::Async> are likely to be"
NSQ_SOURCE_LINE 00000047 "added later."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=cut"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "our @EXPORT_OK = qw(dispose retain retain_future);"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000054 "    all => [ @EXPORT_OK ],"
NSQ_SOURCE_LINE 00000055 "    v1  => [ qw(dispose retain retain_future) ],"
NSQ_SOURCE_LINE 00000056 ");"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "our @EXPORT = qw(dispose);"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "use Scalar::Util ();"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "our %RETAINED;"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=cut"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=head2 dispose"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "Undefines the given variable, then checks that the original ref was destroyed."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 " my $x = [1,2,3];"
NSQ_SOURCE_LINE 00000073 " dispose $x;"
NSQ_SOURCE_LINE 00000074 " # $x is no longer defined."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "This is primarily intended for cases where you no longer need a variable, and want"
NSQ_SOURCE_LINE 00000077 "to ensure that you haven't accidentally captured a strong reference to it elsewhere."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "Note that this clears the B<caller>'s variable."
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "This function is defined with a prototype of ($), since it is only intended for use"
NSQ_SOURCE_LINE 00000082 "on scalar variables. To clear multiple variables, use a L<foreach> loop:"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 " my ($x, $y, $z) = ...;"
NSQ_SOURCE_LINE 00000085 " dispose $_ for $x, $y, $z;"
NSQ_SOURCE_LINE 00000086 " is($x, undef);"
NSQ_SOURCE_LINE 00000087 " is($y, undef);"
NSQ_SOURCE_LINE 00000088 " is($z, undef);"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "=cut"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "sub dispose($) {"
NSQ_SOURCE_LINE 00000093 "    die \"Variable not defined\" unless defined $_[0];"
NSQ_SOURCE_LINE 00000094 "    die \"Variable was not a ref\" unless ref $_[0];"
NSQ_SOURCE_LINE 00000095 "    delete $RETAINED{$_[0]}; # just in case we'd previously retained this one"
NSQ_SOURCE_LINE 00000096 "    Scalar::Util::weaken(my $copy = $_[0]);"
NSQ_SOURCE_LINE 00000097 "    undef $_[0];"
NSQ_SOURCE_LINE 00000098 "    die \"Variable was not released\" if defined $copy;"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=head2 retain"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "Keeps a copy of this variable until program exit or L</dispose>."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "Returns the original variable."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=cut"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "sub retain($) {"
NSQ_SOURCE_LINE 00000110 "    die \"Variable not defined\" unless defined $_[0];"
NSQ_SOURCE_LINE 00000111 "    die \"Variable was not a ref\" unless ref $_[0];"
NSQ_SOURCE_LINE 00000112 "    $RETAINED{$_[0]} = $_[0];"
NSQ_SOURCE_LINE 00000113 "    $_[0]"
NSQ_SOURCE_LINE 00000114 "}"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=head2 retain_future"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "Holds a copy of the given L<Future> until it's marked ready, then releases our copy."
NSQ_SOURCE_LINE 00000119 "Does not use L</dispose>, since that could interfere with other callbacks attached"
NSQ_SOURCE_LINE 00000120 "to the L<Future>."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "Since Future 0.36, this behaviour is directly available via the L<Future/retain> method,"
NSQ_SOURCE_LINE 00000123 "so it is recommended to use that instead of this function."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "Returns the original L<Future>."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=cut"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "sub retain_future {"
NSQ_SOURCE_LINE 00000130 "    my ($f) = @_;"
NSQ_SOURCE_LINE 00000131 "    die \"Variable does not seem to be a Future, since it has no ->on_ready method\" unless $f->can('on_ready');"
NSQ_SOURCE_LINE 00000132 "    return $f->retain;"
NSQ_SOURCE_LINE 00000133 "}"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "1;"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "__END__"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=over 4"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=item * L<Devel::Refcount> - assert_oneref is almost identical to this, although it doesn't clear the variable it's called on"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=item * L<Closure::Explicit> - provides a sub{} wrapper that will complain if you capture a lexical without explicitly declaring that you're going to do that."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=back"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "Tom Molesworth <cpan@perlsite.co.uk>"
