NSQ_SOURCE_LINE 00000141 "sub init_meta {"
NSQ_SOURCE_LINE 00000142 "    shift;"
NSQ_SOURCE_LINE 00000143 "    my %args = @_;"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    my $class = $args{for_class}"
NSQ_SOURCE_LINE 00000146 "        or throw_exception( InitMetaRequiresClass => params => \\%args );"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    my $base_class = $args{base_class} || 'Moose::Object';"
NSQ_SOURCE_LINE 00000149 "    my $metaclass  = $args{metaclass}  || 'Moose::Meta::Class';"
NSQ_SOURCE_LINE 00000150 "    my $meta_name  = exists $args{meta_name} ? $args{meta_name} : 'meta';"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    throw_exception( MetaclassNotLoaded => class_name => $metaclass )"
NSQ_SOURCE_LINE 00000153 "        unless is_class_loaded($metaclass);"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "    throw_exception( MetaclassMustBeASubclassOfMooseMetaClass => class_name => $metaclass )"
NSQ_SOURCE_LINE 00000156 "        unless $metaclass->isa('Moose::Meta::Class');"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    # make a subtype for each Moose class"
NSQ_SOURCE_LINE 00000159 "    class_type($class)"
NSQ_SOURCE_LINE 00000160 "        unless find_type_constraint($class);"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    my $meta;"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "    if ( $meta = Class::MOP::get_metaclass_by_name($class) ) {"
NSQ_SOURCE_LINE 00000165 "        unless ( $meta->isa(\"Moose::Meta::Class\") ) {"
NSQ_SOURCE_LINE 00000166 "            if ( $meta->isa('Moose::Meta::Role') ) {"
NSQ_SOURCE_LINE 00000167 "                throw_exception( MetaclassIsARoleNotASubclassOfGivenMetaclass => role_name => $class,"
NSQ_SOURCE_LINE 00000168 "                                                                                 metaclass => $metaclass,"
NSQ_SOURCE_LINE 00000169 "                                                                                 role      => $meta"
NSQ_SOURCE_LINE 00000170 "                               );"
NSQ_SOURCE_LINE 00000171 "            } else {"
NSQ_SOURCE_LINE 00000172 "                throw_exception( MetaclassIsNotASubclassOfGivenMetaclass => class_name => $class,"
NSQ_SOURCE_LINE 00000173 "                                                                            metaclass  => $metaclass,"
NSQ_SOURCE_LINE 00000174 "                                                                            class      => $meta"
NSQ_SOURCE_LINE 00000175 "                               );"
NSQ_SOURCE_LINE 00000176 "            }"
NSQ_SOURCE_LINE 00000177 "        }"
NSQ_SOURCE_LINE 00000178 "    } else {"
NSQ_SOURCE_LINE 00000179 "        # no metaclass"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "        # now we check whether our ancestors have metaclass, and if so borrow that"
NSQ_SOURCE_LINE 00000182 "        my ( undef, @isa ) = @{ mro::get_linear_isa($class) };"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "        foreach my $ancestor ( @isa ) {"
NSQ_SOURCE_LINE 00000185 "            my $ancestor_meta = Class::MOP::get_metaclass_by_name($ancestor) || next;"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "            my $ancestor_meta_class = $ancestor_meta->_real_ref_name;"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "            # if we have an ancestor metaclass that inherits $metaclass, we use"
NSQ_SOURCE_LINE 00000190 "            # that. This is like _fix_metaclass_incompatibility, but we can do it now."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "            # the case of having an ancestry is not very common, but arises in"
NSQ_SOURCE_LINE 00000193 "            # e.g. Reaction"
NSQ_SOURCE_LINE 00000194 "            unless ( $metaclass->isa( $ancestor_meta_class ) ) {"
NSQ_SOURCE_LINE 00000195 "                if ( $ancestor_meta_class->isa($metaclass) ) {"
NSQ_SOURCE_LINE 00000196 "                    $metaclass = $ancestor_meta_class;"
NSQ_SOURCE_LINE 00000197 "                }"
NSQ_SOURCE_LINE 00000198 "            }"
NSQ_SOURCE_LINE 00000199 "        }"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "        $meta = $metaclass->initialize($class);"
NSQ_SOURCE_LINE 00000202 "        my $filename = module_notional_filename($meta->name);"
NSQ_SOURCE_LINE 00000203 "        $INC{$filename} = '(set by Moose)'"
NSQ_SOURCE_LINE 00000204 "            unless exists $INC{$filename};"
NSQ_SOURCE_LINE 00000205 "    }"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "    if (defined $meta_name) {"
NSQ_SOURCE_LINE 00000208 "        # also check for inherited non moose 'meta' method?"
NSQ_SOURCE_LINE 00000209 "        my $existing = $meta->get_method($meta_name);"
NSQ_SOURCE_LINE 00000210 "        if ($existing && !$existing->isa('Class::MOP::Method::Meta')) {"
NSQ_SOURCE_LINE 00000211 "            Carp::cluck \"Moose is overwriting an existing method named \""
NSQ_SOURCE_LINE 00000212 "                      . \"$meta_name in class $class with a method \""
NSQ_SOURCE_LINE 00000213 "                      . \"which returns the class's metaclass. If this is \""
NSQ_SOURCE_LINE 00000214 "                      . \"actually what you want, you should remove the \""
NSQ_SOURCE_LINE 00000215 "                      . \"existing method, otherwise, you should rename or \""
NSQ_SOURCE_LINE 00000216 "                      . \"disable this generated method using the \""
NSQ_SOURCE_LINE 00000217 "                      . \"'-meta_name' option to 'use Moose'.\";"
NSQ_SOURCE_LINE 00000218 "        }"
NSQ_SOURCE_LINE 00000219 "        $meta->_add_meta_method($meta_name);"
NSQ_SOURCE_LINE 00000220 "    }"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "    # make sure they inherit from Moose::Object"
NSQ_SOURCE_LINE 00000223 "    $meta->superclasses($base_class)"
NSQ_SOURCE_LINE 00000224 "      unless $meta->superclasses();"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "    return $meta;"
NSQ_SOURCE_LINE 00000227 "}"
NSQ_SOURCE_LINE 00000228 ""
