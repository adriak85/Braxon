NSQ_SOURCE_LINE 00000131 "    with_meta => ["
NSQ_SOURCE_LINE 00000132 "        qw( extends with has before after around override augment )"
NSQ_SOURCE_LINE 00000133 "    ],"
NSQ_SOURCE_LINE 00000134 "    as_is => ["
NSQ_SOURCE_LINE 00000135 "        qw( super inner ),"
NSQ_SOURCE_LINE 00000136 "        'Carp::confess',"
NSQ_SOURCE_LINE 00000137 "        'Scalar::Util::blessed',"
