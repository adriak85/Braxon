NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "sub has {"
NSQ_SOURCE_LINE 00000066 "    my $meta = shift;"
NSQ_SOURCE_LINE 00000067 "    my $name = shift;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    my %context = Moose::Util::_caller_info;"
NSQ_SOURCE_LINE 00000070 "    $context{context} = 'has declaration';"
NSQ_SOURCE_LINE 00000071 "    $context{type} = 'class';"
NSQ_SOURCE_LINE 00000072 "    my @options = ( definition_context => \\%context, @_ );"
NSQ_SOURCE_LINE 00000073 "    my $attrs = ( ref($name) eq 'ARRAY' ) ? $name : [ ($name) ];"
NSQ_SOURCE_LINE 00000074 "    $meta->add_attribute( $_, @options ) for @$attrs;"
NSQ_SOURCE_LINE 00000075 "}"
NSQ_SOURCE_LINE 00000076 ""
