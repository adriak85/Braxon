NSQ_SOURCE_LINE 00000087 "}"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "our $SUPER_PACKAGE;"
NSQ_SOURCE_LINE 00000090 "our $SUPER_BODY;"
NSQ_SOURCE_LINE 00000091 "our @SUPER_ARGS;"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "sub super {"
NSQ_SOURCE_LINE 00000094 "    if (@_) {"
NSQ_SOURCE_LINE 00000095 "        carp 'Arguments passed to super() are ignored';"
NSQ_SOURCE_LINE 00000096 "    }"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    # This check avoids a recursion loop - see"
NSQ_SOURCE_LINE 00000099 "    # t/bugs/super_recursion.t"
NSQ_SOURCE_LINE 00000100 "    return if defined $SUPER_PACKAGE && $SUPER_PACKAGE ne caller();"
NSQ_SOURCE_LINE 00000101 "    return unless $SUPER_BODY; $SUPER_BODY->(@SUPER_ARGS);"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub override {"
NSQ_SOURCE_LINE 00000105 "    my $meta = shift;"
NSQ_SOURCE_LINE 00000106 "    my ( $name, $method ) = @_;"
NSQ_SOURCE_LINE 00000107 "    $meta->add_override_method_modifier( $name => $method );"
NSQ_SOURCE_LINE 00000108 "}"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "sub inner {"
NSQ_SOURCE_LINE 00000111 "    my $pkg = caller();"
NSQ_SOURCE_LINE 00000112 "    our ( %INNER_BODY, %INNER_ARGS );"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "    if ( my $body = $INNER_BODY{$pkg} ) {"
NSQ_SOURCE_LINE 00000115 "        my @args = @{ $INNER_ARGS{$pkg} };"
NSQ_SOURCE_LINE 00000116 "        local $INNER_ARGS{$pkg};"
NSQ_SOURCE_LINE 00000117 "        local $INNER_BODY{$pkg};"
NSQ_SOURCE_LINE 00000118 "        return $body->(@args);"
NSQ_SOURCE_LINE 00000119 "    } else {"
NSQ_SOURCE_LINE 00000120 "        return;"
NSQ_SOURCE_LINE 00000121 "    }"
NSQ_SOURCE_LINE 00000122 "}"
NSQ_SOURCE_LINE 00000123 ""
