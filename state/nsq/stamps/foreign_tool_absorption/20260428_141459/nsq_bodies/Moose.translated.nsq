NSQ_SOURCE_LINE 00000043 "sub extends {"
NSQ_SOURCE_LINE 00000044 "    my $meta = shift;"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    unless ( @_ )"
NSQ_SOURCE_LINE 00000047 "    {"
NSQ_SOURCE_LINE 00000048 "        throw_exception( ExtendsMissingArgs => class_name => $meta->name );"
NSQ_SOURCE_LINE 00000049 "    }"
NSQ_SOURCE_LINE 00000050 "    # this checks the metaclass to make sure"
NSQ_SOURCE_LINE 00000051 "    # it is correct, sometimes it can get out"
NSQ_SOURCE_LINE 00000052 "    # of sync when the classes are being built"
NSQ_SOURCE_LINE 00000053 "    $meta->superclasses(@_);"
