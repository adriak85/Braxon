BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Browser::Open;"
NSQ_SOURCE_LINE 00000002 "our $VERSION = '0.04';"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 "use Carp;"
NSQ_SOURCE_LINE 00000009 "use File::Spec::Functions qw( catfile );"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use parent 'Exporter';"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "@Browser::Open::EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000014 "  open_browser"
NSQ_SOURCE_LINE 00000015 "  open_browser_cmd"
NSQ_SOURCE_LINE 00000016 "  open_browser_cmd_all"
NSQ_SOURCE_LINE 00000017 ");"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "my @known_commands = ("
NSQ_SOURCE_LINE 00000020 "  ['', $ENV{BROWSER}],"
NSQ_SOURCE_LINE 00000021 "  ['darwin',  '/usr/bin/open', 1],"
NSQ_SOURCE_LINE 00000022 "  ['cygwin',  'start'],"
NSQ_SOURCE_LINE 00000023 "  ['MSWin32', 'start', undef, 1],"
NSQ_SOURCE_LINE 00000024 "  ['solaris', 'xdg-open'],"
NSQ_SOURCE_LINE 00000025 "  ['solaris', 'firefox'],"
NSQ_SOURCE_LINE 00000026 "  ['linux',   'sensible-browser'],"
NSQ_SOURCE_LINE 00000027 "  ['linux',   'xdg-open'],"
NSQ_SOURCE_LINE 00000028 "  ['linux',   'x-www-browser'],"
NSQ_SOURCE_LINE 00000029 "  ['linux',   'www-browser'],"
NSQ_SOURCE_LINE 00000030 "  ['linux',   'htmlview'],"
NSQ_SOURCE_LINE 00000031 "  ['linux',   'gnome-open'],"
NSQ_SOURCE_LINE 00000032 "  ['linux',   'gnome-moz-remote'],"
NSQ_SOURCE_LINE 00000033 "  ['linux',   'kfmclient'],"
NSQ_SOURCE_LINE 00000034 "  ['linux',   'exo-open'],"
NSQ_SOURCE_LINE 00000035 "  ['linux',   'firefox'],"
NSQ_SOURCE_LINE 00000036 "  ['linux',   'seamonkey'],"
NSQ_SOURCE_LINE 00000037 "  ['linux',   'opera'],"
NSQ_SOURCE_LINE 00000038 "  ['linux',   'mozilla'],"
NSQ_SOURCE_LINE 00000039 "  ['linux',   'iceweasel'],"
NSQ_SOURCE_LINE 00000040 "  ['linux',   'netscape'],"
NSQ_SOURCE_LINE 00000041 "  ['linux',   'galeon'],"
NSQ_SOURCE_LINE 00000042 "  ['linux',   'opera'],"
NSQ_SOURCE_LINE 00000043 "  ['linux',   'w3m'],"
NSQ_SOURCE_LINE 00000044 "  ['linux',   'lynx'],"
NSQ_SOURCE_LINE 00000045 "  ['freebsd', 'xdg-open'],"
NSQ_SOURCE_LINE 00000046 "  ['freebsd', 'gnome-open'],"
NSQ_SOURCE_LINE 00000047 "  ['freebsd', 'gnome-moz-remote'],"
NSQ_SOURCE_LINE 00000048 "  ['freebsd', 'kfmclient'],"
NSQ_SOURCE_LINE 00000049 "  ['freebsd', 'exo-open'],"
NSQ_SOURCE_LINE 00000050 "  ['freebsd', 'firefox'],"
NSQ_SOURCE_LINE 00000051 "  ['freebsd', 'seamonkey'],"
NSQ_SOURCE_LINE 00000052 "  ['freebsd', 'opera'],"
NSQ_SOURCE_LINE 00000053 "  ['freebsd', 'mozilla'],"
NSQ_SOURCE_LINE 00000054 "  ['freebsd', 'netscape'],"
NSQ_SOURCE_LINE 00000055 "  ['freebsd', 'galeon'],"
NSQ_SOURCE_LINE 00000056 "  ['freebsd', 'opera'],"
NSQ_SOURCE_LINE 00000057 "  ['freebsd', 'w3m'],"
NSQ_SOURCE_LINE 00000058 "  ['freebsd', 'lynx'],"
NSQ_SOURCE_LINE 00000059 "  ['',        'open'],"
NSQ_SOURCE_LINE 00000060 "  ['',        'start'],"
NSQ_SOURCE_LINE 00000061 ");"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "##################################"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "sub open_browser {"
NSQ_SOURCE_LINE 00000066 "  my ($url, $all) = @_;"
NSQ_SOURCE_LINE 00000067 "  croak('Missing required parameter $url, ') unless $url;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "  my $cmd = $all ? open_browser_cmd_all() : open_browser_cmd();"
NSQ_SOURCE_LINE 00000070 "  return unless $cmd;"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "  return system($cmd, $url);"
NSQ_SOURCE_LINE 00000073 "}"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "sub open_browser_cmd {"
NSQ_SOURCE_LINE 00000076 "  return _check_all_cmds($^O);"
NSQ_SOURCE_LINE 00000077 "}"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "sub open_browser_cmd_all {"
NSQ_SOURCE_LINE 00000080 "  return _check_all_cmds('');"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "##################################"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub _check_all_cmds {"
NSQ_SOURCE_LINE 00000087 "  my ($filter) = @_;"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "  foreach my $spec (@known_commands) {"
NSQ_SOURCE_LINE 00000090 "    my ($osname, $cmd, $exact, $no_search) = @$spec;"
NSQ_SOURCE_LINE 00000091 "    next unless $cmd;"
NSQ_SOURCE_LINE 00000092 "    next if $osname && $filter && $osname ne $filter;"
NSQ_SOURCE_LINE 00000093 "    next if $no_search && !$filter && $osname ne $^O;"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    return $cmd if $exact && -x $cmd;"
NSQ_SOURCE_LINE 00000096 "    return $cmd if $no_search;"
NSQ_SOURCE_LINE 00000097 "    $cmd = _search_in_path($cmd);"
NSQ_SOURCE_LINE 00000098 "    return $cmd if $cmd;"
NSQ_SOURCE_LINE 00000099 "  }"
NSQ_SOURCE_LINE 00000100 "  return;"
NSQ_SOURCE_LINE 00000101 "}"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "sub _search_in_path {"
NSQ_SOURCE_LINE 00000104 "  my $cmd = shift;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "  for my $path (split(/:/, $ENV{PATH})) {"
NSQ_SOURCE_LINE 00000107 "    next unless $path;"
NSQ_SOURCE_LINE 00000108 "    my $file = catfile($path, $cmd);"
NSQ_SOURCE_LINE 00000109 "    return $file if -x $file;"
NSQ_SOURCE_LINE 00000110 "  }"
NSQ_SOURCE_LINE 00000111 "  return;"
NSQ_SOURCE_LINE 00000112 "}"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "1;"
NSQ_SOURCE_LINE 00000116 "__END__"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=head1 NAME"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "Browser::Open - open a browser in a given URL"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=head1 VERSION"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "version 0.03"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "    use Browser::Open qw( open_browser );"
NSQ_SOURCE_LINE 00000130 "    "
NSQ_SOURCE_LINE 00000131 "    ### Try commands specific to the current Operating System"
NSQ_SOURCE_LINE 00000132 "    my $ok = open_browser($url);"
NSQ_SOURCE_LINE 00000133 "    # ! defined($ok): no recognized command found"
NSQ_SOURCE_LINE 00000134 "    # $ok == 0: command found and executed"
NSQ_SOURCE_LINE 00000135 "    # $ok != 0: command found, error while executing"
NSQ_SOURCE_LINE 00000136 "    "
NSQ_SOURCE_LINE 00000137 "    ### Try all known commands"
NSQ_SOURCE_LINE 00000138 "    my $ok = open_browser($url, 1);"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "The functions optionaly exported by this module allows you to open URLs"
NSQ_SOURCE_LINE 00000144 "in the user browser."
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "A set of known commands per OS-name is tested for presence, and the"
NSQ_SOURCE_LINE 00000147 "first one found is executed. With an optional parameter, all known"
NSQ_SOURCE_LINE 00000148 "commands are checked."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "The L<\"open_browser\"> uses the C<system()> function to execute the"
NSQ_SOURCE_LINE 00000151 "command. If you want more control, you can get the command with the"
NSQ_SOURCE_LINE 00000152 "L<\"open_browser_cmd\"> or L<\"open_browser_cmd_all\"> functions and then"
NSQ_SOURCE_LINE 00000153 "use whatever method you want to execute it."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=head1 API"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "All functions are B<not> exported by default. You must ask for them"
NSQ_SOURCE_LINE 00000159 "explicitly."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head2 open_browser"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "    my $ok = open_browser($url, $all);"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "Find an appropriate command and executes it with your C<$url>. If"
NSQ_SOURCE_LINE 00000167 "C<$all> is false, the default, only commands that match the current OS"
NSQ_SOURCE_LINE 00000168 "will be tested. If true, all known commands will be tested."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "If no command was found, returns C<undef>."
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "If a command is found, returns the exit code of the execution attempt, 0"
NSQ_SOURCE_LINE 00000173 "for success. See the C<system()> for more information about this"
NSQ_SOURCE_LINE 00000174 "exit code."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "If no C<$url> is given, an exception will be thrown:"
NSQ_SOURCE_LINE 00000177 "C<< Missing required parameter $url >>."
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=head2 open_browser_cmd"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    my $cmd = open_browser_cmd();"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "Returns the best command found to open a URL on your system."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "If no command was found, returns C<undef>."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=head2 open_browser_cmd_all"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "    my $cmd = open_browser_cmd_all();"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "Returns the first command found to open a URL."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "If no command was found, returns C<undef>."
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "Pedro Melo, C<< <melo at cpan.org> >>"
