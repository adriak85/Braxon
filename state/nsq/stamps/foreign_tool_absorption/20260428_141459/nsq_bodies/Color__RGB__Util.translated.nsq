NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 " say rgb2grayscale('0033CC');                     # => 555555 # default 'average' algo"
NSQ_SOURCE_LINE 00000643 " say rgb2grayscale('0033CC', 'weighted_average'); # => 353535"
NSQ_SOURCE_LINE 00000644 ""
