NSQ_SOURCE_LINE 00000671 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "None are exported by default, but they are exportable."
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "=head2 assign_rgb_color"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "Usage:"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 " my $rgb = assign_rgb_color($str);"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "Map a string to an RGB color. This is done by producing SHA-1 digest (160bit, 20"
NSQ_SOURCE_LINE 00000684 "bytes) of the string, then taking the first, 10th, and last byte to become the"
NSQ_SOURCE_LINE 00000685 "RGB color."
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "See also: L</assign_rgb_dark_color> and L</assign_rgb_light_color>."
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "=head2 assign_rgb_dark_color"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "Like L</assign_rgb_color> except that it will make sure the assigned color is"
NSQ_SOURCE_LINE 00000692 "dark."
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "=head2 assign_rgb_light_color"
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "Like L</assign_rgb_color> except that it will make sure the assigned color is"
NSQ_SOURCE_LINE 00000697 "light."
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "=head2 hsl2hsv"
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "Usage:"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 " my $hsl = hsl2hsv(\"0 1 0.5\"); # => \"0 1 1\""
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "Convert HSL to HSV."
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "See also: L</hsv2hsl>."
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "=head2 hsl2rgb"
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "Usage:"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 " my $rgb = hsl2rgb(\"0 1 0.5\"); # => ff0000"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "Convert HSL to RGB. HSL should be given in a whitespace-separated H,S,L values"
NSQ_SOURCE_LINE 00000716 "e.g. \"0 1 0.5\". H (hue degree) has a range from 0-360 where 0 is red, 120 is"
NSQ_SOURCE_LINE 00000717 "green, 240 is blue and 360 is back to red. S (saturation) has a range from 0-1"
NSQ_SOURCE_LINE 00000718 "where 0 is gray and 1 is fully saturated hue. L (lumination) has a range from"
NSQ_SOURCE_LINE 00000719 "0-1 where 0 is fully black, 0.5 fully saturated, and 1 is fully white."
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "See also L</rgb2hsl>."
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "=head2 hsv2hsl"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "Usage:"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 " my $hsl = hsv2hsl(\"0 1 1\"); # => \"0 1 0.5\""
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "Convert HSV to HSL."
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "See also L</hsl2hsv>."
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "=head2 hsv2rgb"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "Usage:"
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 " my $rgb = hsv2rgb(\"0 1 1\"); # => ff0000"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "Convert HSV to RGB. HSV should be given in a whitespace-separated H,S,V values"
NSQ_SOURCE_LINE 00000740 "e.g. \"0 1 1\". H (hue degree) has a range from 0-360 where 0 is red, 120 is"
NSQ_SOURCE_LINE 00000741 "green, 240 is blue and 360 is back to red. S (saturation) has a range from 0-1"
NSQ_SOURCE_LINE 00000742 "where 0 is gray and 1 is fully saturated hue. V (value) has a range from 0-1"
NSQ_SOURCE_LINE 00000743 "where 0 is black and 1 is white."
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "See also L</rgb2hsv>."
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "=head2 int2rgb"
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "Usage:"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 " my $rgb = int2rgb(0xffffff); # => ffffff"
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "Convert integer to RGB string."
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "See also L</rgb2int>."
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "=head2 mix_2_rgb_colors"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "Usage:"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 " my $mixed_rgb = mix_2_rgb_colors($rgb1, $rgb2, $pct);"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "Mix 2 RGB colors. C<$pct> is a number between 0 and 1, by default 0.5 (halfway),"
NSQ_SOURCE_LINE 00000764 "the closer to 1 the closer the resulting color to C<$rgb2>."
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "See also L</mix_rgb_colors>, L</tint_rgb_color>."
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "=head2 mix_rgb_colors"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "Usage:"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 " my $mixed_rgb = mix_rgb_colors($color1, $weight1, $color2, $weight2, ...);"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "Mix several RGB colors."
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "See also L</mix_2_rgb_colors>."
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "=head2 rand_rgb_color"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "Usage:"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 " my $rgb = rand_rgb_color([ $low_limit [ , $high_limit ] ]);"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "Generate a random RGB color. You can specify the limit. Otherwise, they default"
NSQ_SOURCE_LINE 00000785 "to the full range (000000 to ffffff)."
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "See also L</rand_rgb_colors>."
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "=head2 rand_rgb_colors"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "Usage:"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 " my @rgbs = rand_rgb_colors([ \\%opts ], $num=1);"
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "Produce C<$num> random RGB colors, with some options. It does not (yet) create a"
NSQ_SOURCE_LINE 00000796 "palette of optimally distinct colors, but will make reasonable attempt to make"
NSQ_SOURCE_LINE 00000797 "the colors different from one another."
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "Known options:"
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "=over"
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "=item * from_color"
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "RGB value, lower limit, optional."
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "=item * to_color"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "RGB value, high limit, optional."
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "=item * light_color"
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "Boolean, default true. By default, this function will create light RGB colors,"
NSQ_SOURCE_LINE 00000814 "assuming the background color is dark, which is often the case in terminal. If"
NSQ_SOURCE_LINE 00000815 "this option is set to false, will create dark colors instead, If this option is"
NSQ_SOURCE_LINE 00000816 "set to undef, will create both dark and light colors."
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "=item * avoid_colors"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "Arrayref or hashref. List of colors to be avoided. You can put, for example,"
NSQ_SOURCE_LINE 00000821 "colors that you've already assigned/picked for your palette and don't want to"
NSQ_SOURCE_LINE 00000822 "use again."
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "=item * max_attempts"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "Uint, default 1000. Number of attempts to try generating the next random color"
NSQ_SOURCE_LINE 00000827 "if the generated color is rejected because it is light/dark, or because it's in"
NSQ_SOURCE_LINE 00000828 "C<avoid_colors>."
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "When the number of attempts has been exceeded, the generated color is used"
NSQ_SOURCE_LINE 00000831 "anyway."
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "=item * hash_prefix"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "Whether to add hash prefix to produced color codes (\"#123456\") or not"
NSQ_SOURCE_LINE 00000836 "(\"123456\")."
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "=back"
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "See also L</rand_rgb_color>."
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "=head2 reverse_rgb_color"
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "Usage:"
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 " my $reversed = reverse_rgb_color($rgb);"
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "Reverse C<$rgb>."
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "=head2 rgb2grayscale"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "Usage:"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 " my $rgb_gs = rgb2grayscale($rgb [ , $algo ]);"
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "Convert C<$rgb> to grayscale RGB value. There are several algorithms (C<$algo>)"
NSQ_SOURCE_LINE 00000857 "to choose from:"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "=over"
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "=item * average"
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "The Average method takes the average value of R, G, and B as the grayscale"
NSQ_SOURCE_LINE 00000864 "value."
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 " Grayscale = (R + G + B ) / 3."
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "The average method is simple but does not take into account the non-linearity of"
NSQ_SOURCE_LINE 00000869 "human vision (eyes are most sensitive to green, less to red, least to blue)."
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "=item * weighted_average"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "This method gives weights to each of red, green, blue elements to take into"
NSQ_SOURCE_LINE 00000874 "account the sensitivity of human eyes."
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 " Grayscale  = 0.299R + 0.587G + 0.114B"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "=back"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "See also L<rgb2sepia>."
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "=head2 rgb2hsl"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "Usage:"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 " my $hsl = rgb2hsl($rgb); # example: \"0 1 0.5\""
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "Convert RGB (0-255) to HSL. The result is a space-separated H, S, L values."
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "See also L</hsl2rgb>."
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "=head2 rgb2hsv"
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "Usage:"
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 " my $hsv = rgb2hsv($rgb); # example: \"0 1 255\""
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "Convert RGB (0-255) to HSV. The result is a space-separated H, S, V values."
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "See also L</hsv2rgb>."
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "=head2 rgb2int"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "Usage:"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 " my $int = rgb2int(\"ffffff\"); # => 16777216, which is 0xffffff"
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "Convert RGB string to integer."
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "See also L</int2rgb>."
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "=head2 rgb2sepia"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "Usage:"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 " my $rgb_sepia = rgb2sepia($rgb);"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "Convert C<$rgb> to sepia tone RGB value."
NSQ_SOURCE_LINE 00000919 ""
NSQ_SOURCE_LINE 00000920 "See also L<rgb2grayscale>."
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "=head2 rgb_closest_to"
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "Usage:"
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 " my $colorname = rgb_closest_to( [ \\%opts , ] $color);"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "Return the primary color C<$color> is closest to. Options:"
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "=over"
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "=item * colors"
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "A hash of color names and RGB values. If unspecified, the default is:"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 " {"
NSQ_SOURCE_LINE 00000937 "  black   => \"000000\","
NSQ_SOURCE_LINE 00000938 "  blue    => \"0000ff\","
NSQ_SOURCE_LINE 00000939 "  brown   => \"663333\","
NSQ_SOURCE_LINE 00000940 "  cyan    => \"00ffff\", # a.k.a. aqua"
NSQ_SOURCE_LINE 00000941 "  green   => \"00ff00\","
NSQ_SOURCE_LINE 00000942 "  grey    => \"808080\","
NSQ_SOURCE_LINE 00000943 "  magenta => \"ff00ff\", # a.k.a. fuchsia"
NSQ_SOURCE_LINE 00000944 "  orange  => \"ff8000\","
NSQ_SOURCE_LINE 00000945 "  pink    => \"ffcccc\","
NSQ_SOURCE_LINE 00000946 "  purple  => \"800080\", # a.k.a. violet"
NSQ_SOURCE_LINE 00000947 "  red     => \"ff0000\","
NSQ_SOURCE_LINE 00000948 "  white   => \"ffffff\","
NSQ_SOURCE_LINE 00000949 "  yellow  => \"ffff00\","
NSQ_SOURCE_LINE 00000950 " }"
NSQ_SOURCE_LINE 00000951 ""
NSQ_SOURCE_LINE 00000952 "=back"
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "=head2 rgb_diff"
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "Usage:"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 " my $dist = rgb_diff($rgb1, $rgb2[ , $algo ])"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "Calculate difference between two RGB colors, using one of several algorithms."
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "=over"
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "=item * euclidean"
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "The default. It calculates the distance as:"
NSQ_SOURCE_LINE 00000967 ""
NSQ_SOURCE_LINE 00000968 " ( (R1-R2)**2 + (G1-G2)**2 + (B1-B2)**2 )**0.5"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "which is the same as what L</\"rgb_distance\">() would produce."
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "=item * approx1"
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "This algorithm, described in [1] as \"a low cost approximation\" and \"a"
NSQ_SOURCE_LINE 00000975 "combination both weighted Euclidean distance functions, where the weight factors"
NSQ_SOURCE_LINE 00000976 "depend on how big the 'red' component of the colour is\" with \"results that are"
NSQ_SOURCE_LINE 00000977 "very close to L*u*v\" and \"a more stable algorithm\", uses the following formula:"
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 " ( 2*(R1-R2)**2 + 4*(G1-G2)**2 + 3*(B1-B2)**2 + Rm*((R1-R2)**2 - (B1-B2)**2)/256 )**0.5"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "where, Rm or \"R mean\" is (R1+R2)/2."
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 "=item * approx2"
NSQ_SOURCE_LINE 00000984 ""
NSQ_SOURCE_LINE 00000985 "Like C<approx1>, but uses this formula:"
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 " ( 2*(R1-R2)**2 + 4*(G1-G2)**2 + 3*(B1-B2)**2 )**0.5  # if Rm < 128"
NSQ_SOURCE_LINE 00000988 " ( 3*(R1-R2)**2 + 4*(G1-G2)**2 + 2*(B1-B2)**2 )**0.5  # otherwise"
NSQ_SOURCE_LINE 00000989 ""
NSQ_SOURCE_LINE 00000990 "=item * hsv_euclidean"
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "Convert the RGB values to HSV, then calculate the HSV distance. Please see"
NSQ_SOURCE_LINE 00000993 "source code for details."
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "=item * hsv_hue1"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "Like C<hsv_euclidean> but puts more emphasis on hue difference. This algorithm"
NSQ_SOURCE_LINE 00000998 "is used, for example, by L<Color::ANSI::Util> when mapping RGB 24bit color to"
NSQ_SOURCE_LINE 00000999 "the \"closest\" the ANSI 256-color or 16-color. This algorithm tends to choose the"
NSQ_SOURCE_LINE 00001000 "hued colors instead of favoring to fallback on white/gray, which is more"
NSQ_SOURCE_LINE 00001001 "preferred."
NSQ_SOURCE_LINE 00001002 ""
NSQ_SOURCE_LINE 00001003 "=back"
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "TODO: redmean low-cost approximation, CMC l:c."
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "For more about color difference, try reading"
NSQ_SOURCE_LINE 00001008 "L<https://en.wikipedia.org/wiki/Color_difference>."
NSQ_SOURCE_LINE 00001009 ""
NSQ_SOURCE_LINE 00001010 "[1] https://www.compuphase.com/cmetric.htm"
NSQ_SOURCE_LINE 00001011 ""
NSQ_SOURCE_LINE 00001012 "See also L<rgb_distance>."
NSQ_SOURCE_LINE 00001013 ""
NSQ_SOURCE_LINE 00001014 "=head2 rgb_distance"
NSQ_SOURCE_LINE 00001015 ""
NSQ_SOURCE_LINE 00001016 "Usage:"
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 " my $dist = rgb_distance($rgb1, $rgb2)"
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "Calculate the euclidean RGB distance, using this formula:"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 " ( (R1-R2)**2 + (G1-G2)**2 + (B1-B2)**2 )**0.5"
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "For example, the distance between \"000000\" and \"ffffff\" is ~441.67, while the"
NSQ_SOURCE_LINE 00001025 "distance between \"ffff00\" and \"ffffff\" is 255."
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "See also L<rgb_diff>."
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "=head2 rgb_is_dark"
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "Usage:"
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 " my $is_dark = rgb_is_dark($rgb)"
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 "Return true if C<$rgb> is a \"dark\" color, which is determined by checking if the"
NSQ_SOURCE_LINE 00001036 "RGB distance to \"000000\" is smaller than to \"ffffff\"."
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "See also L</rgb_is_light>."
NSQ_SOURCE_LINE 00001039 ""
NSQ_SOURCE_LINE 00001040 "=head2 rgb_is_light"
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "Usage:"
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 " my $is_light = rgb_is_light($rgb)"
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "Return true if C<$rgb> is a \"light\" color, which is determined by checking if"
NSQ_SOURCE_LINE 00001047 "the RGB distance to \"000000\" is larger than to \"ffffff\"."
NSQ_SOURCE_LINE 00001048 ""
NSQ_SOURCE_LINE 00001049 "See also L</rgb_is_dark>."
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 "=head2 rgb_luminance"
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "Usage:"
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 " my $luminance = rgb_luminance($rgb);"
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "Calculate standard/objective luminance from RGB value using this formula:"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 " (0.2126*R) + (0.7152*G) + (0.0722*B)"
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "where R, G, and B range from 0 to 1. Return a number from 0 to 1."
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "=head2 tint_rgb_color"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "Usage:"
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 " my $new_rgb = tint_rgb_color($rgb, $tint_rgb, $pct)"
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "Tint C<$rgb> with C<$tint_rgb>. $pct is by default 0.5. It is similar to mixing,"
NSQ_SOURCE_LINE 00001070 "but the less luminance the color is the less it is tinted with the tint color."
NSQ_SOURCE_LINE 00001071 "This has the effect of black color still being black instead of becoming tinted."
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "See also L<mix_2_rgb_colors>, L<mix_rgb_colors>."
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00001076 ""
NSQ_SOURCE_LINE 00001077 "Please visit the project's homepage at L<https://metacpan.org/release/Color-RGB-Util>."
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "=head1 SOURCE"
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "Source repository is at L<https://github.com/perlancar/perl-Color-RGB-Util>."
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "L<Color::ANSI::Util>"
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "perlancar <perlancar@cpan.org>"
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 "=head1 CONTRIBUTOR"
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "=for stopwords Steven Haryanto"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "Steven Haryanto <stevenharyanto@gmail.com>"
NSQ_SOURCE_LINE 00001096 ""
NSQ_SOURCE_LINE 00001097 "=head1 CONTRIBUTING"
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "To contribute, you can send patches by email/via RT, or send pull requests on"
NSQ_SOURCE_LINE 00001101 "GitHub."
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 "Most of the time, you don't need to build the distribution yourself. You can"
NSQ_SOURCE_LINE 00001104 "simply modify the code, then test via:"
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 " % prove -l"
NSQ_SOURCE_LINE 00001107 ""
NSQ_SOURCE_LINE 00001108 "If you want to build the distribution (e.g. to try to install it locally on your"
NSQ_SOURCE_LINE 00001109 "system), you can install L<Dist::Zilla>,"
NSQ_SOURCE_LINE 00001110 "L<Dist::Zilla::PluginBundle::Author::PERLANCAR>,"
NSQ_SOURCE_LINE 00001111 "L<Pod::Weaver::PluginBundle::Author::PERLANCAR>, and sometimes one or two other"
NSQ_SOURCE_LINE 00001112 "Dist::Zilla- and/or Pod::Weaver plugins. Any additional steps required beyond"
NSQ_SOURCE_LINE 00001113 "that are considered a bug and can be reported to me."
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "=head1 COPYRIGHT AND LICENSE"
NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "This software is copyright (c) 2025 by perlancar <perlancar@cpan.org>."
