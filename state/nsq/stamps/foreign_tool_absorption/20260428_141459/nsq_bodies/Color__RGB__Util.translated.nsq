NSQ_SOURCE_LINE 00000052 "sub _wrap_h {"
NSQ_SOURCE_LINE 00000053 "    my $h = shift;"
NSQ_SOURCE_LINE 00000054 "    $h %= 360 if abs($h) > 360;"
NSQ_SOURCE_LINE 00000055 "    $h >= 0 ? $h : 360+$h;"
NSQ_SOURCE_LINE 00000056 "}"
