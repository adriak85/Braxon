NSQ_SOURCE_LINE 00000058 "sub assign_rgb_color {"
NSQ_SOURCE_LINE 00000059 "    require Digest::SHA;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    my ($str) = @_;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    my $sha1 = Digest::SHA::sha1_hex($str);"
NSQ_SOURCE_LINE 00000064 "    substr($sha1, 0, 2) ."
NSQ_SOURCE_LINE 00000065 "    substr($sha1, 18, 2) ."
NSQ_SOURCE_LINE 00000066 "    substr($sha1, 38, 2);"
NSQ_SOURCE_LINE 00000067 "}"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "sub assign_rgb_dark_color {"
NSQ_SOURCE_LINE 00000070 "    my $str = shift;"
