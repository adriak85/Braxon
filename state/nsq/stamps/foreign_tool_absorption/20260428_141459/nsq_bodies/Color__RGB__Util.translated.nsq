NSQ_SOURCE_LINE 00000046 "my $re_rgb = qr/\\A#?([0-9A-Fa-f]{2})([0-9A-Fa-f]{2})([0-9A-Fa-f]{2})\\z/;"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub _min {"
NSQ_SOURCE_LINE 00000049 "    $_[0] < $_[1] ? $_[0] : $_[1];"
