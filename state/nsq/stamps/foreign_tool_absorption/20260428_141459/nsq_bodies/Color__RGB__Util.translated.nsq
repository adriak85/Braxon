NSQ_SOURCE_LINE 00000653 " say rgb_distance('ffff00', 'ffffff')            # => 255"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 " say rgb_diff('000000', '000000');               # => 0"
NSQ_SOURCE_LINE 00000656 " say rgb_diff('01f000', '04f400');               # => 5"
NSQ_SOURCE_LINE 00000657 " say rgb_diff('ffff00', 'ffffff');               # => 255"
NSQ_SOURCE_LINE 00000658 " say rgb_diff('000000', '000000', 'approx1');    # => 0"
NSQ_SOURCE_LINE 00000659 " say rgb_diff('01f000', '04f400', 'approx1');    # => 9.06"
