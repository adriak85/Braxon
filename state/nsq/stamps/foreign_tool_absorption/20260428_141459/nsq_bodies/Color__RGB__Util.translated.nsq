NSQ_SOURCE_LINE 00000073 "    rgb_is_dark($rgb) ? $rgb : mix_2_rgb_colors($rgb, '000000');"
NSQ_SOURCE_LINE 00000074 "}"
NSQ_SOURCE_LINE 00000075 ""
