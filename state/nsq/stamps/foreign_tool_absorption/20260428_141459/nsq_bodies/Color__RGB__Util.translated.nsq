NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "sub int2rgb {"
NSQ_SOURCE_LINE 00000084 "    my $int = shift;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    return sprintf(\"%02x%02x%02x\","
NSQ_SOURCE_LINE 00000087 "                   ($int & 0xff0000) >> 16,"
NSQ_SOURCE_LINE 00000088 "                   ($int & 0x00ff00) >>  8,"
NSQ_SOURCE_LINE 00000089 "                   ($int & 0x0000ff),"
NSQ_SOURCE_LINE 00000090 "               );"
NSQ_SOURCE_LINE 00000091 "}"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "sub mix_2_rgb_colors {"
NSQ_SOURCE_LINE 00000094 "    my ($rgb1, $rgb2, $pct) = @_;"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    $pct //= 0.5;"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    my ($r1, $g1, $b1) ="
NSQ_SOURCE_LINE 00000099 "        $rgb1 =~ $re_rgb or die \"Invalid rgb1 color '$rgb1', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000100 "    my ($r2, $g2, $b2) ="
NSQ_SOURCE_LINE 00000101 "        $rgb2 =~ $re_rgb or die \"Invalid rgb2 color '$rgb2', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000102 "    for ($r1, $g1, $b1, $r2, $g2, $b2) { $_ = hex $_ }"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    return sprintf(\"%02x%02x%02x\","
NSQ_SOURCE_LINE 00000105 "                   $r1 + $pct*($r2-$r1),"
NSQ_SOURCE_LINE 00000106 "                   $g1 + $pct*($g2-$g1),"
NSQ_SOURCE_LINE 00000107 "                   $b1 + $pct*($b2-$b1),"
NSQ_SOURCE_LINE 00000108 "               );"
NSQ_SOURCE_LINE 00000109 "}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "sub mix_rgb_colors {"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "    my (@weights, @r, @g, @b);"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    while (@_ >= 2) {"
NSQ_SOURCE_LINE 00000116 "        my ($rgb, $weight) = splice @_, 0, 2;"
NSQ_SOURCE_LINE 00000117 "        my ($r, $g, $b) = $rgb =~ $re_rgb"
NSQ_SOURCE_LINE 00000118 "            or die \"Invalid rgb color '$rgb', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000119 "        push @r, hex $r;"
NSQ_SOURCE_LINE 00000120 "        push @g, hex $g;"
NSQ_SOURCE_LINE 00000121 "        push @b, hex $b;"
NSQ_SOURCE_LINE 00000122 "        push @weights, $weight;"
NSQ_SOURCE_LINE 00000123 "    }"
NSQ_SOURCE_LINE 00000124 "    my $tot_r = 0; for (0..$#r) { $tot_r += $r[$_]*$weights[$_] }"
NSQ_SOURCE_LINE 00000125 "    my $tot_g = 0; for (0..$#g) { $tot_g += $g[$_]*$weights[$_] }"
NSQ_SOURCE_LINE 00000126 "    my $tot_b = 0; for (0..$#b) { $tot_b += $b[$_]*$weights[$_] }"
NSQ_SOURCE_LINE 00000127 "    my $tot_weight = 0; $tot_weight += $_ for @weights;"
NSQ_SOURCE_LINE 00000128 "    die \"Zero/negative total weight\" unless $tot_weight > 0;"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    return sprintf(\"%02x%02x%02x\","
NSQ_SOURCE_LINE 00000131 "                   $tot_r / $tot_weight,"
NSQ_SOURCE_LINE 00000132 "                   $tot_g / $tot_weight,"
NSQ_SOURCE_LINE 00000133 "                   $tot_b / $tot_weight,"
NSQ_SOURCE_LINE 00000134 "               );"
NSQ_SOURCE_LINE 00000135 "}"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "$SPEC{rand_rgb_color} = {"
NSQ_SOURCE_LINE 00000138 "    v => 1.1,"
NSQ_SOURCE_LINE 00000139 "    summary => 'Generate a random RGB color',"
NSQ_SOURCE_LINE 00000140 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000141 "    args => {"
NSQ_SOURCE_LINE 00000142 "        from_color => {"
NSQ_SOURCE_LINE 00000143 "            schema => 'color::rgb24',"
NSQ_SOURCE_LINE 00000144 "            default => '000000',"
NSQ_SOURCE_LINE 00000145 "            pos => 0,"
NSQ_SOURCE_LINE 00000146 "        },"
NSQ_SOURCE_LINE 00000147 "        to_color => {"
NSQ_SOURCE_LINE 00000148 "            schema => 'color::rgb24',"
NSQ_SOURCE_LINE 00000149 "            default => 'ffffff',"
NSQ_SOURCE_LINE 00000150 "            pos => 1,"
NSQ_SOURCE_LINE 00000151 "        },"
NSQ_SOURCE_LINE 00000152 "    },"
NSQ_SOURCE_LINE 00000153 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000154 "    result => {"
NSQ_SOURCE_LINE 00000155 "        schema => 'color::rgb24*',"
NSQ_SOURCE_LINE 00000156 "    },"
NSQ_SOURCE_LINE 00000157 "};"
NSQ_SOURCE_LINE 00000158 "sub rand_rgb_color {"
NSQ_SOURCE_LINE 00000159 "    my ($rgb1, $rgb2) = @_;"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    $rgb1 //= '000000';"
NSQ_SOURCE_LINE 00000162 "    my ($r1, $g1, $b1) ="
NSQ_SOURCE_LINE 00000163 "        $rgb1 =~ $re_rgb or die \"Invalid rgb1 color '$rgb1', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000164 "    $rgb2 //= 'ffffff';"
NSQ_SOURCE_LINE 00000165 "    my ($r2, $g2, $b2) ="
NSQ_SOURCE_LINE 00000166 "        $rgb2 =~ $re_rgb or die \"Invalid rgb2 color '$rgb2', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000167 "    for ($r1, $g1, $b1, $r2, $g2, $b2) { $_ = hex $_ }"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    return sprintf(\"%02x%02x%02x\","
NSQ_SOURCE_LINE 00000170 "                   $r1 + rand()*($r2-$r1+1),"
NSQ_SOURCE_LINE 00000171 "                   $g1 + rand()*($g2-$g1+1),"
NSQ_SOURCE_LINE 00000172 "                   $b1 + rand()*($b2-$b1+1),"
NSQ_SOURCE_LINE 00000173 "               );"
NSQ_SOURCE_LINE 00000174 "}"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "sub rand_rgb_colors {"
NSQ_SOURCE_LINE 00000177 "    my $opts = ref $_[0] eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000178 "    my $num = shift // 1;"
NSQ_SOURCE_LINE 00000179 "    my $light_color  = exists($opts->{light_color}) ? $opts->{light_color} : 1;"
NSQ_SOURCE_LINE 00000180 "    my $max_attempts = $opts->{max_attempts} // 1000;"
NSQ_SOURCE_LINE 00000181 "    my $avoid_colors = $opts->{avoid_colors};"
NSQ_SOURCE_LINE 00000182 "    my $hash_prefix  = $opts->{hash_prefix};"
NSQ_SOURCE_LINE 00000183 "    my $from_color   = $opts->{from_color};"
NSQ_SOURCE_LINE 00000184 "    my $to_color     = $opts->{to_color};"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "    my $num_check = 10;"
NSQ_SOURCE_LINE 00000187 "    my $min_distance = rgb_diff(\"000000\", \"ffffff\", \"approx2\") / 2 / $num;"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "    my @res;"
NSQ_SOURCE_LINE 00000190 "    while (@res < $num) {"
NSQ_SOURCE_LINE 00000191 "        my $num_attempts = 0;"
NSQ_SOURCE_LINE 00000192 "        my $rgb;"
NSQ_SOURCE_LINE 00000193 "        while (1) {"
NSQ_SOURCE_LINE 00000194 "            $rgb = rand_rgb_color($from_color, $to_color);"
NSQ_SOURCE_LINE 00000195 "            my $reject = 0;"
NSQ_SOURCE_LINE 00000196 "          REJECT: {"
NSQ_SOURCE_LINE 00000197 "                if ($light_color) {"
NSQ_SOURCE_LINE 00000198 "                    do { $reject++; last } if rgb_is_dark($rgb);"
NSQ_SOURCE_LINE 00000199 "                } elsif (defined $light_color) {"
NSQ_SOURCE_LINE 00000200 "                    do { $reject++; last } if rgb_is_light($rgb);"
NSQ_SOURCE_LINE 00000201 "                }"
NSQ_SOURCE_LINE 00000202 "                if ($avoid_colors && ref $avoid_colors eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000203 "                    do { $reject++; last } if grep { $rgb eq $_ } @$avoid_colors;"
NSQ_SOURCE_LINE 00000204 "                }"
NSQ_SOURCE_LINE 00000205 "                if ($avoid_colors && ref $avoid_colors eq 'HASH') {"
NSQ_SOURCE_LINE 00000206 "                    do { $reject++; last } if $avoid_colors->{$rgb}"
NSQ_SOURCE_LINE 00000207 "                }"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "                for (1..$num_check) {"
NSQ_SOURCE_LINE 00000210 "                    last if @res-$_ < 0;"
NSQ_SOURCE_LINE 00000211 "                    my $prev_rgb = $res[ @res - $_ ];"
NSQ_SOURCE_LINE 00000212 "                    do { $reject++; last REJECT } if rgb_diff($rgb, $prev_rgb, \"approx2\") < $min_distance;"
NSQ_SOURCE_LINE 00000213 "                }"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "            } # REJECT"
NSQ_SOURCE_LINE 00000216 "            last if !$reject;"
NSQ_SOURCE_LINE 00000217 "            last if ++$num_attempts >= $max_attempts;"
NSQ_SOURCE_LINE 00000218 "        }"
NSQ_SOURCE_LINE 00000219 "        push @res, ($hash_prefix ? \"#\" : \"\") . $rgb;"
NSQ_SOURCE_LINE 00000220 "    }"
NSQ_SOURCE_LINE 00000221 "    @res;"
NSQ_SOURCE_LINE 00000222 "}"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "sub reverse_rgb_color {"
NSQ_SOURCE_LINE 00000225 "    my ($rgb) = @_;"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    my ($r, $g, $b) ="
NSQ_SOURCE_LINE 00000228 "        $rgb =~ $re_rgb or die \"Invalid rgb color '$rgb', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000229 "    for ($r, $g, $b) { $_ = hex $_ }"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "    return sprintf(\"%02x%02x%02x\", 255-$r, 255-$g, 255-$b);"
NSQ_SOURCE_LINE 00000232 "}"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "sub rgb2grayscale {"
NSQ_SOURCE_LINE 00000235 "    my ($rgb, $algo) = @_;"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "    my ($r, $g, $b) ="
NSQ_SOURCE_LINE 00000238 "        $rgb =~ $re_rgb or die \"Invalid rgb color '$rgb', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000239 "    for ($r, $g, $b) { $_ = hex $_ }"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    $algo //= 'average';"
NSQ_SOURCE_LINE 00000242 "    if ($algo eq 'weighted_average') {"
NSQ_SOURCE_LINE 00000243 "        my $avg = int(0.299*$r + 0.587*$g + 0.114*$b);"
NSQ_SOURCE_LINE 00000244 "        return sprintf(\"%02x%02x%02x\", $avg, $avg, $avg);"
NSQ_SOURCE_LINE 00000245 "    } elsif ($algo eq 'average') {"
NSQ_SOURCE_LINE 00000246 "        my $avg = int(($r + $g + $b)/3);"
NSQ_SOURCE_LINE 00000247 "        return sprintf(\"%02x%02x%02x\", $avg, $avg, $avg);"
NSQ_SOURCE_LINE 00000248 "    } else {"
NSQ_SOURCE_LINE 00000249 "        die \"Unknown algo '$algo'\";"
NSQ_SOURCE_LINE 00000250 "    }"
NSQ_SOURCE_LINE 00000251 "}"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "sub rgb2int {"
NSQ_SOURCE_LINE 00000254 "    my $rgb = shift;"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "    # just to check"
NSQ_SOURCE_LINE 00000257 "    $rgb =~ $re_rgb or die \"Invalid rgb color '$rgb', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "    hex($rgb);"
NSQ_SOURCE_LINE 00000260 "}"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "sub rgb2sepia {"
NSQ_SOURCE_LINE 00000263 "    my ($rgb) = @_;"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "    my ($r, $g, $b) ="
NSQ_SOURCE_LINE 00000266 "        $rgb =~ $re_rgb or die \"Invalid rgb color '$rgb', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000267 "    for ($r, $g, $b) { $_ = hex $_ }"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "    # reference: http://www.techrepublic.com/blog/howdoi/how-do-i-convert-images-to-grayscale-and-sepia-tone-using-c/120"
NSQ_SOURCE_LINE 00000270 "    my $or = ($r*0.393) + ($g*0.769) + ($b*0.189);"
NSQ_SOURCE_LINE 00000271 "    my $og = ($r*0.349) + ($g*0.686) + ($b*0.168);"
NSQ_SOURCE_LINE 00000272 "    my $ob = ($r*0.272) + ($g*0.534) + ($b*0.131);"
NSQ_SOURCE_LINE 00000273 "    for ($or, $og, $ob) { $_ = 255 if $_ > 255 }"
NSQ_SOURCE_LINE 00000274 "    return sprintf(\"%02x%02x%02x\", $or, $og, $ob);"
NSQ_SOURCE_LINE 00000275 "}"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "sub rgb_diff {"
NSQ_SOURCE_LINE 00000278 "    my ($rgb1, $rgb2, $algo) = @_;"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "    $algo //= 'euclidean';"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "    my ($r1, $g1, $b1) ="
NSQ_SOURCE_LINE 00000283 "        $rgb1 =~ $re_rgb or die \"Invalid rgb1 color '$rgb1', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000284 "    my ($r2, $g2, $b2) ="
NSQ_SOURCE_LINE 00000285 "        $rgb2 =~ $re_rgb or die \"Invalid rgb2 color '$rgb2', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000286 "    for ($r1, $g1, $b1, $r2, $g2, $b2) { $_ = hex $_ }"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "    my $dr2 = ($r1-$r2)**2;"
NSQ_SOURCE_LINE 00000289 "    my $dg2 = ($g1-$g2)**2;"
NSQ_SOURCE_LINE 00000290 "    my $db2 = ($b1-$b2)**2;"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "    if ($algo eq 'approx1' || $algo eq 'approx2') {"
NSQ_SOURCE_LINE 00000293 "        my $rm = ($r1 + $r2)/2;"
NSQ_SOURCE_LINE 00000294 "        if ($algo eq 'approx1') {"
NSQ_SOURCE_LINE 00000295 "            return (2*$dr2 + 4*$dg2 + 3*$db2 + $rm*($dr2 - $db2)/256 )**0.5;"
NSQ_SOURCE_LINE 00000296 "        } else { # approx2"
NSQ_SOURCE_LINE 00000297 "            if ($rm < 128) {"
NSQ_SOURCE_LINE 00000298 "                return (3*$dr2 + 4*$dg2 + 2*$db2)**0.5;"
NSQ_SOURCE_LINE 00000299 "            } else {"
NSQ_SOURCE_LINE 00000300 "                return (2*$dr2 + 4*$dg2 + 3*$db2)**0.5;"
NSQ_SOURCE_LINE 00000301 "            }"
NSQ_SOURCE_LINE 00000302 "        }"
NSQ_SOURCE_LINE 00000303 "    } elsif ($algo eq 'hsv_euclidean' || $algo eq 'hsv_hue1') {"
NSQ_SOURCE_LINE 00000304 "        my $hsv1 = rgb2hsv($rgb1);"
NSQ_SOURCE_LINE 00000305 "        my ($h1, $s1, $v1) = split / /, $hsv1;"
NSQ_SOURCE_LINE 00000306 "        my $hsv2 = rgb2hsv($rgb2);"
NSQ_SOURCE_LINE 00000307 "        my ($h2, $s2, $v2) = split / /, $hsv2;"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "        my $dh2 = ( _min(abs($h2-$h1), 360-abs($h2-$h1))/180 )**2;"
NSQ_SOURCE_LINE 00000310 "        my $ds2 = ( $s2-$s1 )**2;"
NSQ_SOURCE_LINE 00000311 "        my $dv2 = ( ($v2-$v1)/255.0 )**2;"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "        if ($algo eq 'hsv_hue1') {"
NSQ_SOURCE_LINE 00000314 "            return (5*$dh2 + $ds2 + $dv2)**0.5;"
NSQ_SOURCE_LINE 00000315 "        } else { # hsv_euclidean"
NSQ_SOURCE_LINE 00000316 "            return ($dh2 + $ds2 + $dv2)**0.5;"
NSQ_SOURCE_LINE 00000317 "        }"
NSQ_SOURCE_LINE 00000318 "    } elsif ($algo eq 'euclidean') {"
NSQ_SOURCE_LINE 00000319 "        return ($dr2 + $dg2 + $db2)**0.5;"
NSQ_SOURCE_LINE 00000320 "    } else {"
NSQ_SOURCE_LINE 00000321 "        die \"Unknown algo '$algo'\";"
NSQ_SOURCE_LINE 00000322 "    }"
NSQ_SOURCE_LINE 00000323 "}"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "sub rgb_distance {"
NSQ_SOURCE_LINE 00000326 "    my ($rgb1, $rgb2) = @_;"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "    my ($r1, $g1, $b1) ="
NSQ_SOURCE_LINE 00000329 "        $rgb1 =~ $re_rgb or die \"Invalid rgb1 color '$rgb1', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000330 "    my ($r2, $g2, $b2) ="
NSQ_SOURCE_LINE 00000331 "        $rgb2 =~ $re_rgb or die \"Invalid rgb2 color '$rgb2', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000332 "    for ($r1, $g1, $b1, $r2, $g2, $b2) { $_ = hex $_ }"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "    (($r1-$r2)**2 + ($g1-$g2)**2 + ($b1-$b2)**2)**0.5;"
NSQ_SOURCE_LINE 00000335 "}"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "sub rgb_is_dark {"
NSQ_SOURCE_LINE 00000338 "    my ($rgb) = @_;"
NSQ_SOURCE_LINE 00000339 "    rgb_distance($rgb, \"000000\") < rgb_distance($rgb, \"ffffff\") ? 1:0;"
NSQ_SOURCE_LINE 00000340 "}"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "sub rgb_is_light {"
NSQ_SOURCE_LINE 00000343 "    my ($rgb) = @_;"
NSQ_SOURCE_LINE 00000344 "    rgb_distance($rgb, \"000000\") > rgb_distance($rgb, \"ffffff\") ? 1:0;"
NSQ_SOURCE_LINE 00000345 "}"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "sub _rgb_luminance {"
NSQ_SOURCE_LINE 00000348 "    my ($r, $g, $b) = @_;"
NSQ_SOURCE_LINE 00000349 "    0.2126*$r/255 + 0.7152*$g/255 + 0.0722*$b/255;"
NSQ_SOURCE_LINE 00000350 "}"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "sub rgb_luminance {"
NSQ_SOURCE_LINE 00000353 "    my ($rgb) = @_;"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "    my ($r, $g, $b) ="
NSQ_SOURCE_LINE 00000356 "        $rgb =~ $re_rgb or die \"Invalid rgb color '$rgb', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000357 "    for ($r, $g, $b) { $_ = hex $_ }"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "    return _rgb_luminance($r, $g, $b);"
NSQ_SOURCE_LINE 00000360 "}"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "sub tint_rgb_color {"
NSQ_SOURCE_LINE 00000363 "    my ($rgb1, $rgb2, $pct) = @_;"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "    $pct //= 0.5;"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "    my ($r1, $g1, $b1) ="
NSQ_SOURCE_LINE 00000368 "        $rgb1 =~ $re_rgb or die \"Invalid rgb1 color '$rgb1', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000369 "    my ($r2, $g2, $b2) ="
NSQ_SOURCE_LINE 00000370 "        $rgb2 =~ $re_rgb or die \"Invalid rgb2 color '$rgb2', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000371 "    for ($r1, $g1, $b1, $r2, $g2, $b2) { $_ = hex $_ }"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "    my $lum = _rgb_luminance($r1, $g1, $b1);"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "    return sprintf(\"%02x%02x%02x\","
NSQ_SOURCE_LINE 00000376 "                   $r1 + $pct*($r2-$r1)*$lum,"
NSQ_SOURCE_LINE 00000377 "                   $g1 + $pct*($g2-$g1)*$lum,"
NSQ_SOURCE_LINE 00000378 "                   $b1 + $pct*($b2-$b1)*$lum,"
NSQ_SOURCE_LINE 00000379 "               );"
NSQ_SOURCE_LINE 00000380 "}"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "sub rgb2hsl {"
NSQ_SOURCE_LINE 00000383 "    my ($rgb) = @_;"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "    my ($r, $g, $b) ="
NSQ_SOURCE_LINE 00000386 "        $rgb =~ $re_rgb or die \"Invalid rgb color '$rgb', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000387 "    for ($r, $g, $b) { $_ = hex($_)/255 }"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "    my $max = $r;"
NSQ_SOURCE_LINE 00000390 "    my $maxc = 'r';"
NSQ_SOURCE_LINE 00000391 "    my $min = $r;"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "    if ($g > $max) {"
NSQ_SOURCE_LINE 00000394 "        $max = $g;"
NSQ_SOURCE_LINE 00000395 "        $maxc = 'g';"
NSQ_SOURCE_LINE 00000396 "    }"
NSQ_SOURCE_LINE 00000397 "    if ($b > $max) {"
NSQ_SOURCE_LINE 00000398 "        $max = $b;"
NSQ_SOURCE_LINE 00000399 "        $maxc = 'b';"
NSQ_SOURCE_LINE 00000400 "    }"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "    if ($g < $min) {"
NSQ_SOURCE_LINE 00000403 "        $min = $g;"
NSQ_SOURCE_LINE 00000404 "    }"
NSQ_SOURCE_LINE 00000405 "    if ($b < $min) {"
NSQ_SOURCE_LINE 00000406 "        $min = $b;"
NSQ_SOURCE_LINE 00000407 "    }"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "    my ($h, $s, $l);"
NSQ_SOURCE_LINE 00000410 "    if ($max == $min) {"
NSQ_SOURCE_LINE 00000411 "        $h = 0;"
NSQ_SOURCE_LINE 00000412 "    } elsif ($maxc eq 'r') {"
NSQ_SOURCE_LINE 00000413 "        $h = 60 * (($g - $b) / ($max - $min)) % 360;"
NSQ_SOURCE_LINE 00000414 "    } elsif ($maxc eq 'g') {"
NSQ_SOURCE_LINE 00000415 "        $h = (60 * (($b - $r) / ($max - $min)) + 120);"
NSQ_SOURCE_LINE 00000416 "    } elsif ($maxc eq 'b') {"
NSQ_SOURCE_LINE 00000417 "        $h = (60 * (($r - $g) / ($max - $min)) + 240);"
NSQ_SOURCE_LINE 00000418 "    }"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "    $l = ($max + $min) / 2;"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "    if ($max == $min) {"
NSQ_SOURCE_LINE 00000423 "        $s = 0;"
NSQ_SOURCE_LINE 00000424 "    } elsif($l <= .5) {"
NSQ_SOURCE_LINE 00000425 "        $s = ($max - $min) / ($max + $min);"
NSQ_SOURCE_LINE 00000426 "    } else {"
NSQ_SOURCE_LINE 00000427 "        $s = ($max - $min) / (2 - ($max + $min));"
NSQ_SOURCE_LINE 00000428 "    }"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "    return sprintf(\"%.3g %.3g %.3g\", $h, $s, $l);"
NSQ_SOURCE_LINE 00000431 "}"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "sub rgb2hsv {"
NSQ_SOURCE_LINE 00000434 "    my ($rgb) = @_;"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "    my ($r, $g, $b) ="
NSQ_SOURCE_LINE 00000437 "        $rgb =~ $re_rgb or die \"Invalid rgb color '$rgb', must be in 'ffffff' form\";"
NSQ_SOURCE_LINE 00000438 "    for ($r, $g, $b) { $_ = hex($_)/255 }"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "    my $max = $r;"
NSQ_SOURCE_LINE 00000441 "    my $maxc = 'r';"
NSQ_SOURCE_LINE 00000442 "    my $min = $r;"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "    if ($g > $max) {"
NSQ_SOURCE_LINE 00000445 "        $max = $g;"
NSQ_SOURCE_LINE 00000446 "        $maxc = 'g';"
NSQ_SOURCE_LINE 00000447 "    }"
NSQ_SOURCE_LINE 00000448 "    if($b > $max) {"
NSQ_SOURCE_LINE 00000449 "        $max = $b;"
NSQ_SOURCE_LINE 00000450 "        $maxc = 'b';"
NSQ_SOURCE_LINE 00000451 "    }"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "    if($g < $min) {"
NSQ_SOURCE_LINE 00000454 "        $min = $g;"
NSQ_SOURCE_LINE 00000455 "    }"
NSQ_SOURCE_LINE 00000456 "    if($b < $min) {"
NSQ_SOURCE_LINE 00000457 "        $min = $b;"
NSQ_SOURCE_LINE 00000458 "    }"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "    my ($h, $s, $v);"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "    if ($max == $min) {"
NSQ_SOURCE_LINE 00000463 "        $h = 0;"
NSQ_SOURCE_LINE 00000464 "    } elsif ($maxc eq 'r') {"
NSQ_SOURCE_LINE 00000465 "        $h = 60 * (($g - $b) / ($max - $min)) % 360;"
NSQ_SOURCE_LINE 00000466 "    } elsif ($maxc eq 'g') {"
NSQ_SOURCE_LINE 00000467 "        $h = (60 * (($b - $r) / ($max - $min)) + 120);"
NSQ_SOURCE_LINE 00000468 "    } elsif ($maxc eq 'b') {"
NSQ_SOURCE_LINE 00000469 "        $h = (60 * (($r - $g) / ($max - $min)) + 240);"
NSQ_SOURCE_LINE 00000470 "    }"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "    $v = $max;"
NSQ_SOURCE_LINE 00000473 "    if($max == 0) {"
NSQ_SOURCE_LINE 00000474 "        $s = 0;"
NSQ_SOURCE_LINE 00000475 "    } else {"
NSQ_SOURCE_LINE 00000476 "        $s = 1 - ($min / $max);"
NSQ_SOURCE_LINE 00000477 "    }"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "    return sprintf(\"%.3g %.3g %.3g\", $h, $s, $v);"
NSQ_SOURCE_LINE 00000480 "}"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "sub hsl2hsv {"
NSQ_SOURCE_LINE 00000483 "    my $hsl = shift;"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "    my ($h, $s, $l) = split / /, $hsl;"
NSQ_SOURCE_LINE 00000486 "    $h>=0 && $h<=360 or $h = _wrap_h($h); $s>=0 && $s<=1 or die \"Invalid S in HSL '$hsl', must be in 0-1\"; $l>=0 && $l<=1 or die \"Invalid L in HSL '$hsl', must be in 0-1\";"
NSQ_SOURCE_LINE 00000487 "    my $_h = $h;"
NSQ_SOURCE_LINE 00000488 "    my $_s;"
NSQ_SOURCE_LINE 00000489 "    my $_v;"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "    $l *= 2;"
NSQ_SOURCE_LINE 00000492 "    $s *= ($l <= 1) ? $l : 2-$l;"
NSQ_SOURCE_LINE 00000493 "    $_v = ($l+$s) / 2;"
NSQ_SOURCE_LINE 00000494 "    $_s = (2*$s) / ($l+$s);"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "    \"$_h $_s $_v\";"
NSQ_SOURCE_LINE 00000497 "}"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "sub hsv2hsl {"
NSQ_SOURCE_LINE 00000500 "    my $hsv = shift;"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "    my ($h, $s, $v) = split / /, $hsv;"
NSQ_SOURCE_LINE 00000503 "    $h>=0 && $h<=360 or $h = _wrap_h($h); $s>=0 && $s<=1 or die \"Invalid S in HSV '$hsv', must be in 0-1\"; $v>=0 && $v<=1 or die \"Invalid V in HSV '$hsv', must be in 0-1\";"
NSQ_SOURCE_LINE 00000504 "    my $_h = $h;"
NSQ_SOURCE_LINE 00000505 "    my $_s = $s * $v;"
NSQ_SOURCE_LINE 00000506 "    my $_l = (2-$s) * $v;"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "    $_s /= $_l <= 1 ? ($_l==0 ? 1 : $_l) : (2-$_l);"
NSQ_SOURCE_LINE 00000509 "    $_l /= 2;"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "    \"$_h $_s $_l\";"
NSQ_SOURCE_LINE 00000512 "}"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "sub hsl2rgb {"
NSQ_SOURCE_LINE 00000515 "    hsv2rgb(hsl2hsv(shift));"
NSQ_SOURCE_LINE 00000516 "}"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "sub hsv2rgb {"
NSQ_SOURCE_LINE 00000519 "    my $hsv = shift;"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "    my ($h, $s, $v) = split / /, $hsv;"
NSQ_SOURCE_LINE 00000522 "    $h>=0 && $h<=360 or $h = _wrap_h($h); $s>=0 && $s<=1 or die \"Invalid S in HSV '$hsv', must be in 0-1\"; $v>=0 && $v<=1 or die \"Invalid V in HSV '$hsv', must be in 0-1\";"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "    my $i = int($h/60);"
NSQ_SOURCE_LINE 00000525 "    my $f = $h/60 - $i;"
NSQ_SOURCE_LINE 00000526 "    my $p = $v * (1-$s);"
NSQ_SOURCE_LINE 00000527 "    my $q = $v * (1-$f*$s);"
NSQ_SOURCE_LINE 00000528 "    my $t = $v * (1-(1-$f)*$s);"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "    my ($r, $g, $b);"
NSQ_SOURCE_LINE 00000531 "    if ($i==0) {"
NSQ_SOURCE_LINE 00000532 "        $r = $v; $g = $t; $b = $p;"
NSQ_SOURCE_LINE 00000533 "    } elsif ($i==1) {"
NSQ_SOURCE_LINE 00000534 "        $r = $q; $g = $v; $b = $p;"
NSQ_SOURCE_LINE 00000535 "    } elsif ($i==2) {"
NSQ_SOURCE_LINE 00000536 "        $r = $p; $g = $v; $b = $t;"
NSQ_SOURCE_LINE 00000537 "    } elsif ($i==3) {"
NSQ_SOURCE_LINE 00000538 "        $r = $p; $g = $q; $b = $v;"
NSQ_SOURCE_LINE 00000539 "    } elsif ($i==4) {"
NSQ_SOURCE_LINE 00000540 "        $r = $t; $g = $p; $b = $v;"
NSQ_SOURCE_LINE 00000541 "    } else {"
NSQ_SOURCE_LINE 00000542 "        $r = $v; $g = $p; $b = $q;"
NSQ_SOURCE_LINE 00000543 "    }"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "    return sprintf(\"%02x%02x%02x\", $r*255, $g*255, $b*255);"
NSQ_SOURCE_LINE 00000546 "}"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "my $basic_colors = {"
NSQ_SOURCE_LINE 00000549 "    black   => \"000000\","
NSQ_SOURCE_LINE 00000550 "    blue    => \"0000ff\","
NSQ_SOURCE_LINE 00000551 "    brown   => \"663333\","
NSQ_SOURCE_LINE 00000552 "    cyan    => \"00ffff\", # a.k.a. aqua"
NSQ_SOURCE_LINE 00000553 "    green   => \"00ff00\","
NSQ_SOURCE_LINE 00000554 "    grey    => \"808080\","
NSQ_SOURCE_LINE 00000555 "    magenta => \"ff00ff\", # a.k.a. fuchsia"
NSQ_SOURCE_LINE 00000556 "    orange  => \"ff8000\","
NSQ_SOURCE_LINE 00000557 "    pink    => \"ffcccc\","
NSQ_SOURCE_LINE 00000558 "    purple  => \"800080\", # a.k.a. violet"
NSQ_SOURCE_LINE 00000559 "    red     => \"ff0000\","
NSQ_SOURCE_LINE 00000560 "    white   => \"ffffff\","
NSQ_SOURCE_LINE 00000561 "    yellow  => \"ffff00\","
NSQ_SOURCE_LINE 00000562 "};"
NSQ_SOURCE_LINE 00000563 "sub rgb_closest_to {"
NSQ_SOURCE_LINE 00000564 "    my $opts = ref($_[0]) eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000565 "    my $colors = $opts->{colors} // $basic_colors;"
NSQ_SOURCE_LINE 00000566 "    my $rgb = shift;"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "    my $min_diff; my $closest_color;"
NSQ_SOURCE_LINE 00000569 "    for my $colorname (sort keys %$colors) {"
NSQ_SOURCE_LINE 00000570 "        my $diff = rgb_diff($rgb, $colors->{$colorname}, 'hsv_hue1');"
NSQ_SOURCE_LINE 00000571 "        if (!defined($min_diff) || $min_diff > $diff) {"
NSQ_SOURCE_LINE 00000572 "            $closest_color = $colorname;"
NSQ_SOURCE_LINE 00000573 "            $min_diff = $diff;"
NSQ_SOURCE_LINE 00000574 "        }"
NSQ_SOURCE_LINE 00000575 "    }"
NSQ_SOURCE_LINE 00000576 "    $closest_color;"
NSQ_SOURCE_LINE 00000577 "}"
