NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "=head1 NAME"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "Color::RGB::Util - Utilities related to RGB colors"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "=head1 VERSION"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "This document describes version 0.609 of Color::RGB::Util (from Perl distribution Color-RGB-Util), released on 2025-03-19."
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 " use Color::RGB::Util qw("
NSQ_SOURCE_LINE 00000599 "     assign_rgb_color"
NSQ_SOURCE_LINE 00000600 "     assign_rgb_dark_color"
NSQ_SOURCE_LINE 00000601 "     assign_rgb_light_color"
NSQ_SOURCE_LINE 00000602 "     int2rgb"
NSQ_SOURCE_LINE 00000603 "     mix_2_rgb_colors"
NSQ_SOURCE_LINE 00000604 "     mix_rgb_colors"
NSQ_SOURCE_LINE 00000605 "     rand_rgb_color"
NSQ_SOURCE_LINE 00000606 "     rand_rgb_colors"
NSQ_SOURCE_LINE 00000607 "     reverse_rgb_color"
NSQ_SOURCE_LINE 00000608 "     rgb2grayscale"
NSQ_SOURCE_LINE 00000609 "     rgb2int"
NSQ_SOURCE_LINE 00000610 "     rgb2sepia"
NSQ_SOURCE_LINE 00000611 "     rgb_closest_to"
NSQ_SOURCE_LINE 00000612 "     rgb_diff"
NSQ_SOURCE_LINE 00000613 "     rgb_distance"
NSQ_SOURCE_LINE 00000614 "     rgb_is_dark"
NSQ_SOURCE_LINE 00000615 "     rgb_is_light"
NSQ_SOURCE_LINE 00000616 "     rgb_luminance"
NSQ_SOURCE_LINE 00000617 "     tint_rgb_color"
NSQ_SOURCE_LINE 00000618 " );"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 " say assign_rgb_color(\"foo\");                    # 0b5d33"
NSQ_SOURCE_LINE 00000621 " say assign_rgb_dark_color(\"foo\");               # 0b5d33"
NSQ_SOURCE_LINE 00000622 " say assign_rgb_light_color(\"foo\");              # 85ae99"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 " say int2rgb(0xffffff);                          # ffffff"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 " say mix_2_rgb_colors('#ff0000', '#ffffff');     # pink (red + white)"
NSQ_SOURCE_LINE 00000627 " say mix_2_rgb_colors('ff0000', 'ffffff', 0.75); # pink with a whiter shade"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 " say mix_rgb_colors('ff0000', 1, 'ffffff', 1);   # pink (red + white 1 : 1)"
NSQ_SOURCE_LINE 00000630 " say mix_rgb_colors('ff0000', 1, 'ffffff', 3);   # pink with a whiter shade (red + white 1 : 3)"
NSQ_SOURCE_LINE 00000631 " say mix_rgb_colors('ff0000', 1, 'ffffff', 1, '0000ff', 0.5);   # bluish pink"
