BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Test::NoWarnings;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Carp                      ();"
NSQ_SOURCE_LINE 00000007 "use Exporter                  ();"
NSQ_SOURCE_LINE 00000008 "use Test::Builder             ();"
NSQ_SOURCE_LINE 00000009 "use Test::NoWarnings::Warning ();"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our ( $VERSION, @EXPORT_OK, @ISA, $do_end_test );"
NSQ_SOURCE_LINE 00000012 "BEGIN {"
NSQ_SOURCE_LINE 00000013 "    $VERSION   = '1.06';"
NSQ_SOURCE_LINE 00000014 "    @ISA       = 'Exporter';"
NSQ_SOURCE_LINE 00000015 "    @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000016 "        clear_warnings"
NSQ_SOURCE_LINE 00000017 "        had_no_warnings"
NSQ_SOURCE_LINE 00000018 "        warnings"
NSQ_SOURCE_LINE 00000019 "    );"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "    # Do we add the warning test at the end?"
NSQ_SOURCE_LINE 00000022 "    $do_end_test = 0;"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "my $TEST     = Test::Builder->new;"
NSQ_SOURCE_LINE 00000026 "my $PID      = $$;"
NSQ_SOURCE_LINE 00000027 "my @WARNINGS = ();"
NSQ_SOURCE_LINE 00000028 "my $EARLY    = 0;"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "$SIG{__WARN__} = make_catcher(\\@WARNINGS);"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub import {"
NSQ_SOURCE_LINE 00000033 "    $do_end_test = 1;"
NSQ_SOURCE_LINE 00000034 "    if ( grep { $_ eq ':early' } @_ ) {"
NSQ_SOURCE_LINE 00000035 "        @_ = grep { $_ ne ':early' } @_;"
NSQ_SOURCE_LINE 00000036 "        $EARLY = 1;"
NSQ_SOURCE_LINE 00000037 "    }"
NSQ_SOURCE_LINE 00000038 "    goto &Exporter::import;"
NSQ_SOURCE_LINE 00000039 "}"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "# the END block must be after the \"use Test::Builder\" to make sure it runs"
NSQ_SOURCE_LINE 00000042 "# before Test::Builder's end block"
NSQ_SOURCE_LINE 00000043 "# only run the test if there have been other tests"
NSQ_SOURCE_LINE 00000044 "END {"
NSQ_SOURCE_LINE 00000045 "    had_no_warnings() if $do_end_test;"
NSQ_SOURCE_LINE 00000046 "}"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub make_warning {"
NSQ_SOURCE_LINE 00000049 "    local $SIG{__WARN__};"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    my $msg     = shift;"
NSQ_SOURCE_LINE 00000052 "    my $warning = Test::NoWarnings::Warning->new;"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    $warning->setMessage($msg);"
NSQ_SOURCE_LINE 00000055 "    $warning->fillTest($TEST);"
NSQ_SOURCE_LINE 00000056 "    $warning->fillTrace(__PACKAGE__);"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    $Carp::Internal{__PACKAGE__.\"\"}++;"
NSQ_SOURCE_LINE 00000059 "    local $Carp::CarpLevel = $Carp::CarpLevel + 1;"
NSQ_SOURCE_LINE 00000060 "    $warning->fillCarp($msg);"
NSQ_SOURCE_LINE 00000061 "    $Carp::Internal{__PACKAGE__.\"\"}--;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    return $warning;"
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "# this make a subroutine which can be used in $SIG{__WARN__}"
NSQ_SOURCE_LINE 00000067 "# it takes one argument, a ref to an array"
NSQ_SOURCE_LINE 00000068 "# it will push the details of the warning onto the end of the array."
NSQ_SOURCE_LINE 00000069 "sub make_catcher {"
NSQ_SOURCE_LINE 00000070 "    my $array = shift;"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "    return sub {"
NSQ_SOURCE_LINE 00000073 "        my $msg = shift;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "        # Generate the warning"
NSQ_SOURCE_LINE 00000076 "        $Carp::Internal{__PACKAGE__.\"\"}++;"
NSQ_SOURCE_LINE 00000077 "        push(@$array, make_warning($msg));"
NSQ_SOURCE_LINE 00000078 "        $Carp::Internal{__PACKAGE__.\"\"}--;"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "        # Show the diag early rather than at the end"
NSQ_SOURCE_LINE 00000081 "        if ( $EARLY ) {"
NSQ_SOURCE_LINE 00000082 "            $TEST->diag( $array->[-1]->toString );"
NSQ_SOURCE_LINE 00000083 "        }"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "        return $msg;"
NSQ_SOURCE_LINE 00000086 "    };"
NSQ_SOURCE_LINE 00000087 "}"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "sub had_no_warnings {"
NSQ_SOURCE_LINE 00000090 "    return 0 if $$ != $PID;"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    $do_end_test = 0; # for use with done_testing"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    local $SIG{__WARN__};"
NSQ_SOURCE_LINE 00000095 "    my $name = shift || \"no warnings\";"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    my $ok;"
NSQ_SOURCE_LINE 00000098 "    my $diag;"
NSQ_SOURCE_LINE 00000099 "    if ( @WARNINGS == 0 ) {"
NSQ_SOURCE_LINE 00000100 "        $ok = 1;"
NSQ_SOURCE_LINE 00000101 "    } else {"
NSQ_SOURCE_LINE 00000102 "        $ok = 0;"
NSQ_SOURCE_LINE 00000103 "        $diag = \"There were \" . scalar(@WARNINGS) . \" warning(s)\\n\";"
NSQ_SOURCE_LINE 00000104 "        unless ( $EARLY ) {"
NSQ_SOURCE_LINE 00000105 "            $diag .= join \"----------\\n\", map { $_->toString } @WARNINGS;"
NSQ_SOURCE_LINE 00000106 "        }"
NSQ_SOURCE_LINE 00000107 "    }"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    $TEST->ok($ok, $name) || $TEST->diag($diag);"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    return $ok;"
NSQ_SOURCE_LINE 00000112 "}"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "sub clear_warnings {"
NSQ_SOURCE_LINE 00000115 "    local $SIG{__WARN__};"
NSQ_SOURCE_LINE 00000116 "    @WARNINGS = ();"
NSQ_SOURCE_LINE 00000117 "}"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "sub warnings {"
NSQ_SOURCE_LINE 00000120 "    local $SIG{__WARN__};"
NSQ_SOURCE_LINE 00000121 "    return @WARNINGS;"
NSQ_SOURCE_LINE 00000122 "}"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "sub builder {"
NSQ_SOURCE_LINE 00000125 "    local $SIG{__WARN__};"
NSQ_SOURCE_LINE 00000126 "    if ( @_ ) {"
NSQ_SOURCE_LINE 00000127 "        $TEST = shift;"
NSQ_SOURCE_LINE 00000128 "    }"
NSQ_SOURCE_LINE 00000129 "    return $TEST;"
NSQ_SOURCE_LINE 00000130 "}"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "1;"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "__END__"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=pod"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=head1 NAME"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "Test::NoWarnings - Make sure you didn't emit any warnings while testing"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "For scripts that have no plan"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "  use Test::More 'no_plan';"
NSQ_SOURCE_LINE 00000147 "  use Test::NoWarnings;"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "that's it, you don't need to do anything else"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "For scripts that look like"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "  use Test::More tests => x;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "change to"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "  use Test::More tests => x + 1;"
NSQ_SOURCE_LINE 00000158 "  use Test::NoWarnings;"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "For scripts that use L<done_testing|Test::More/done_testing>, use:"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "  use Test::More;"
NSQ_SOURCE_LINE 00000163 "  use Test::NoWarnings 'had_no_warnings';"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "  ... # your actual tests"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "  had_no_warnings;"
NSQ_SOURCE_LINE 00000168 "  done_testing;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "In general, your tests shouldn't produce warnings. This modules causes any"
NSQ_SOURCE_LINE 00000173 "warnings to be captured and stored. It automatically adds an extra test that"
NSQ_SOURCE_LINE 00000174 "will run when your script ends to check that there were no warnings. If"
NSQ_SOURCE_LINE 00000175 "there were any warnings, the test will give a \"not ok\" and diagnostics of"
NSQ_SOURCE_LINE 00000176 "where, when and what the warning was, including a stack trace of what was"
NSQ_SOURCE_LINE 00000177 "going on when the it occurred."
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "If some of your tests B<are supposed to> produce warnings then you should be"
NSQ_SOURCE_LINE 00000180 "capturing and checking them with L<Test::Warn>, that way L<Test::NoWarnings>"
NSQ_SOURCE_LINE 00000181 "will not see them and so not complain."
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "The test is run by an C<END> block in Test::NoWarnings. It will not be run"
NSQ_SOURCE_LINE 00000184 "when any forked children exit."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=head1 USAGE"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "Simply by using the module, you automatically get an extra test at the end"
NSQ_SOURCE_LINE 00000189 "of your script that checks that no warnings were emitted. So just stick"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "  use Test::NoWarnings;"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "at the top of your script and continue as normal."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "If you want more control you can invoke the test manually at any time with"
NSQ_SOURCE_LINE 00000196 "C<had_no_warnings>."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "The warnings your test has generated so far are stored in an array. You can"
NSQ_SOURCE_LINE 00000199 "look inside and clear this whenever you want with C<warnings()> and"
NSQ_SOURCE_LINE 00000200 "C<clear_warnings>, however, if you are doing this sort of thing then you"
NSQ_SOURCE_LINE 00000201 "probably want to use L<Test::Warn> in combination with L<Test::NoWarnings>."
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "If you have a test script written using L<done_testing|Test::More/done_testing>"
NSQ_SOURCE_LINE 00000204 "and no test plan, you have to call L</had_no_warnings> before you call"
NSQ_SOURCE_LINE 00000205 "L<done_testing|Test::More/done_testing>."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=head2 use vs require"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "You will almost always want to do"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "  use Test::NoWarnings;"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "If you do a C<require> rather than a C<use>, then there will be no automatic"
NSQ_SOURCE_LINE 00000214 "test at the end of your script."
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=head2 Output"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "If warning is captured during your test then the details will output as part"
NSQ_SOURCE_LINE 00000219 "of the diagnostics. You will get:"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=over 2"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=item *"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "the number and name of the test that was executed just before the warning"
NSQ_SOURCE_LINE 00000226 "(if no test had been executed these will be 0 and '')"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=item *"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "the message passed to C<warn>,"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=item *"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "a full dump of the stack when warn was called, courtesy of the C<Carp>"
NSQ_SOURCE_LINE 00000235 "module"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=back"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "By default, all warning messages will be emitted in one block at the end of"
NSQ_SOURCE_LINE 00000240 "your test script."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head2 The :early pragma"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "One common complaint from people using Test::NoWarnings is that all of the"
NSQ_SOURCE_LINE 00000245 "warnings are emitted in one go at the end. While this is the safest and"
NSQ_SOURCE_LINE 00000246 "most correct time to emit these diagnostics, it can make debugging these"
NSQ_SOURCE_LINE 00000247 "warnings difficult."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "As of Test::NoWarnings 1.04 you can provide an experimental C<:early> pragma"
NSQ_SOURCE_LINE 00000250 "when loading the module to force warnings to be thrown via diag at the time"
NSQ_SOURCE_LINE 00000251 "that they actually occur."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "  use Test::NoWarnings ':early';"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "As this will cause the diag to be emitted against the previous test and not"
NSQ_SOURCE_LINE 00000256 "the one in which the warning actually occurred it is recommended that the"
NSQ_SOURCE_LINE 00000257 "pragma be turned on only for debugging and left off when not needed."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=head2 had_no_warnings"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "This checks that there have been warnings emitted by your test scripts."
NSQ_SOURCE_LINE 00000264 "Usually you will not call this explicitly as it is called automatically when"
NSQ_SOURCE_LINE 00000265 "your script finishes."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head2 clear_warnings"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "This will clear the array of warnings that have been captured. If the array"
NSQ_SOURCE_LINE 00000270 "is empty then a call to C<had_no_warnings()> will produce a pass result."
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "=head2 warnings"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "This will return the array of warnings captured so far. Each element of this"
NSQ_SOURCE_LINE 00000275 "array is an object containing information about the warning. The following"
NSQ_SOURCE_LINE 00000276 "methods are available on these object."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=over 2"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "=item *"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "$warn->getMessage"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "Get the message that would been printed by the warning."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=item *"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "$warn->getCarp"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "Get a stack trace of what was going on when the warning happened, this stack"
NSQ_SOURCE_LINE 00000291 "trace is just a string generated by the L<Carp> module."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=item *"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "$warn->getTrace"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "Get a stack trace object generated by the L<Devel::StackTrace> module. This"
NSQ_SOURCE_LINE 00000298 "will return undef if L<Devel::StackTrace> is not installed."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=item *"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "$warn->getTest"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "Get the number of the test that executed before the warning was emitted."
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=item *"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "$warn->getTestName"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "Get the name of the test that executed before the warning was emitted."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "=back"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=head1 PITFALLS"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "When counting your tests for the plan, don't forget to include the test that"
NSQ_SOURCE_LINE 00000317 "runs automatically when your script ends."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "Checking for warnings is done using L<< C<$SIG{__WARN__}>|perlvar/%SIG >>."
NSQ_SOURCE_LINE 00000320 "If other modules use this hook, it can interfere with this module's operation."
NSQ_SOURCE_LINE 00000321 "For example, using the L<Carp::Always> module will cause this module to always"
NSQ_SOURCE_LINE 00000322 "report no warnings."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "Bugs should be reported via the CPAN bug tracker at"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "L<https://rt.cpan.org/Ticket/Create.html?Queue=Test-NoWarnings>"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "For other issues, contact the author."
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=head1 HISTORY"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "This was previously known as L<Test::Warn::None>"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "L<Test::Builder>, L<Test::Warn>"
