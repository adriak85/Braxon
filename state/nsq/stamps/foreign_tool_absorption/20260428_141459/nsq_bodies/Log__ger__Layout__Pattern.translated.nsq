NSQ_SOURCE_LINE 00000001 "package Log::ger::Layout::Pattern;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Devel::Caller::Util;"
NSQ_SOURCE_LINE 00000008 "use Log::ger ();"
NSQ_SOURCE_LINE 00000009 "use Time::HiRes qw(time);"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000012 "our $DATE = '2024-01-22'; # DATE"
NSQ_SOURCE_LINE 00000013 "our $DIST = 'Log-ger-Layout-Pattern'; # DIST"
NSQ_SOURCE_LINE 00000014 "our $VERSION = '0.009'; # VERSION"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our $time_start = time();"
NSQ_SOURCE_LINE 00000017 "our $time_now   = $time_start;"
NSQ_SOURCE_LINE 00000018 "our $time_last  = $time_start;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "my %per_message_data;"
NSQ_SOURCE_LINE 00000021 "my %cache;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "our %format_for = ("
NSQ_SOURCE_LINE 00000024 "    'c' => sub { $_[1]{category} },"
NSQ_SOURCE_LINE 00000025 "    'C' => sub { $per_message_data{caller0}[0] },"
NSQ_SOURCE_LINE 00000026 "    'd' => sub {"
NSQ_SOURCE_LINE 00000027 "        my @t = localtime($time_now);"
NSQ_SOURCE_LINE 00000028 "        sprintf("
NSQ_SOURCE_LINE 00000029 "            \"%04d-%02d-%02dT%02d:%02d:%02d\","
NSQ_SOURCE_LINE 00000030 "            $t[5]+1900, $t[4]+1, $t[3],"
NSQ_SOURCE_LINE 00000031 "            $t[2], $t[1], $t[0],"
NSQ_SOURCE_LINE 00000032 "        );"
NSQ_SOURCE_LINE 00000033 "    },"
NSQ_SOURCE_LINE 00000034 "    'D' => sub {"
NSQ_SOURCE_LINE 00000035 "        my @t = gmtime($time_now);"
NSQ_SOURCE_LINE 00000036 "        sprintf("
NSQ_SOURCE_LINE 00000037 "            \"%04d-%02d-%02dT%02d:%02d:%02d\","
NSQ_SOURCE_LINE 00000038 "            $t[5]+1900, $t[4]+1, $t[3],"
NSQ_SOURCE_LINE 00000039 "            $t[2], $t[1], $t[0],"
NSQ_SOURCE_LINE 00000040 "        );"
NSQ_SOURCE_LINE 00000041 "    },"
NSQ_SOURCE_LINE 00000042 "    'F' => sub { $per_message_data{caller0}[1] },"
NSQ_SOURCE_LINE 00000043 "    'H' => sub {"
NSQ_SOURCE_LINE 00000044 "        require Sys::Hostname;"
NSQ_SOURCE_LINE 00000045 "        Sys::Hostname::hostname();"
NSQ_SOURCE_LINE 00000046 "    },"
NSQ_SOURCE_LINE 00000047 "    'l' => sub {"
NSQ_SOURCE_LINE 00000048 "        sprintf("
NSQ_SOURCE_LINE 00000049 "            \"%s%s(%s:%d)\","
NSQ_SOURCE_LINE 00000050 "            $per_message_data{caller1}[3],"
NSQ_SOURCE_LINE 00000051 "            $per_message_data{caller1}[3] ? ' ' : '',"
NSQ_SOURCE_LINE 00000052 "            $per_message_data{caller0}[1],"
NSQ_SOURCE_LINE 00000053 "            $per_message_data{caller0}[2],"
NSQ_SOURCE_LINE 00000054 "        );"
NSQ_SOURCE_LINE 00000055 "    },"
NSQ_SOURCE_LINE 00000056 "    'L' => sub { $per_message_data{caller0}[2] },"
NSQ_SOURCE_LINE 00000057 "    'm' => sub { $_[0] },"
NSQ_SOURCE_LINE 00000058 "    'M' => sub {"
NSQ_SOURCE_LINE 00000059 "        $per_message_data{caller1}[3] // '';"
NSQ_SOURCE_LINE 00000060 "    },"
NSQ_SOURCE_LINE 00000061 "    'n' => sub { \"\\n\" },"
NSQ_SOURCE_LINE 00000062 "    'p' => sub { $_[3] },"
NSQ_SOURCE_LINE 00000063 "    'P' => sub { $$ },"
NSQ_SOURCE_LINE 00000064 "    'r' => sub { sprintf(\"%.3f\", $time_now - $time_start) },"
NSQ_SOURCE_LINE 00000065 "    'R' => sub { sprintf(\"%.3f\", $time_now - $time_last ) },"
NSQ_SOURCE_LINE 00000066 "    'T' => sub {"
NSQ_SOURCE_LINE 00000067 "        join(\", \", map { \"$_->[3] called at $_->[1] line $_->[2]\" }"
NSQ_SOURCE_LINE 00000068 "                 @{ $per_message_data{callers} });"
NSQ_SOURCE_LINE 00000069 "    },"
NSQ_SOURCE_LINE 00000070 "    '_{vmsize}' => sub {"
NSQ_SOURCE_LINE 00000071 "        unless ($cache{pid_stat_time} &&"
NSQ_SOURCE_LINE 00000072 "                $cache{pid_stat_time} >= $time_now-1) {"
NSQ_SOURCE_LINE 00000073 "            open my $fh, \"<\", \"/proc/$$/stat\" or die;"
NSQ_SOURCE_LINE 00000074 "            $cache{pid_stat} = [split /\\s+/, scalar(<$fh>)];"
NSQ_SOURCE_LINE 00000075 "            $cache{pid_stat_time} = $time_now;"
NSQ_SOURCE_LINE 00000076 "            close $fh;"
NSQ_SOURCE_LINE 00000077 "        }"
NSQ_SOURCE_LINE 00000078 "        sprintf(\"%d\", $cache{pid_stat}[22]/1024);"
NSQ_SOURCE_LINE 00000079 "    },"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    # test"
NSQ_SOURCE_LINE 00000082 "    #'z' => sub { use DD; my $i = 0; while (my @c = caller($i++)) { dd \\@c } },"
NSQ_SOURCE_LINE 00000083 "    '%' => sub { '%' },"
NSQ_SOURCE_LINE 00000084 ");"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub meta { +{"
NSQ_SOURCE_LINE 00000087 "    v => 2,"
NSQ_SOURCE_LINE 00000088 "} }"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "my $re = qr/%(_\\{\\w+\\}|[A-Za-z%])/;"
NSQ_SOURCE_LINE 00000091 "sub _layout {"
NSQ_SOURCE_LINE 00000092 "    my $format = shift;"
NSQ_SOURCE_LINE 00000093 "    my $packages_to_ignore = shift;"
NSQ_SOURCE_LINE 00000094 "    my $subroutines_to_ignore = shift;"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    ($time_last, $time_now) = ($time_now, time());"
NSQ_SOURCE_LINE 00000097 "    %per_message_data = ();"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    my %mentioned_formats;"
NSQ_SOURCE_LINE 00000100 "    while ($format =~ m/$re/g) {"
NSQ_SOURCE_LINE 00000101 "        if (exists $format_for{$1}) {"
NSQ_SOURCE_LINE 00000102 "            $mentioned_formats{$1} = 1;"
NSQ_SOURCE_LINE 00000103 "        } else {"
NSQ_SOURCE_LINE 00000104 "            die \"Unknown format '%$1'\";"
NSQ_SOURCE_LINE 00000105 "        }"
NSQ_SOURCE_LINE 00000106 "    }"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "    if ($mentioned_formats{C} ||"
NSQ_SOURCE_LINE 00000109 "            $mentioned_formats{F} ||"
NSQ_SOURCE_LINE 00000110 "            $mentioned_formats{L} ||"
NSQ_SOURCE_LINE 00000111 "            $mentioned_formats{l}"
NSQ_SOURCE_LINE 00000112 "        ) {"
NSQ_SOURCE_LINE 00000113 "        $per_message_data{caller0}  ="
NSQ_SOURCE_LINE 00000114 "            [Devel::Caller::Util::caller (0, 0, $packages_to_ignore, $subroutines_to_ignore)];"
NSQ_SOURCE_LINE 00000115 "    }"
NSQ_SOURCE_LINE 00000116 "    if ($mentioned_formats{l} ||"
NSQ_SOURCE_LINE 00000117 "            $mentioned_formats{M}"
NSQ_SOURCE_LINE 00000118 "        ) {"
NSQ_SOURCE_LINE 00000119 "        $per_message_data{caller1}  ="
NSQ_SOURCE_LINE 00000120 "            [Devel::Caller::Util::caller (1, 0, $packages_to_ignore, $subroutines_to_ignore)];"
NSQ_SOURCE_LINE 00000121 "    }"
NSQ_SOURCE_LINE 00000122 "    if ($mentioned_formats{T}) {"
NSQ_SOURCE_LINE 00000123 "        $per_message_data{callers} ="
NSQ_SOURCE_LINE 00000124 "            [Devel::Caller::Util::callers(0, 0, $packages_to_ignore, $subroutines_to_ignore)];"
NSQ_SOURCE_LINE 00000125 "    }"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "    $format =~ s#$re#$format_for{$1}->(@_)#eg;"
NSQ_SOURCE_LINE 00000128 "    $format;"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "sub get_hooks {"
NSQ_SOURCE_LINE 00000132 "    my %plugin_conf = @_;"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "    $plugin_conf{format} or die \"Please specify format\";"
NSQ_SOURCE_LINE 00000135 "    $plugin_conf{packages_to_ignore} //= qr/\\A(?:Try::Tiny|Log::ger(?:::.+)?)\\z/;"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    return {"
NSQ_SOURCE_LINE 00000138 "        create_layouter => ["
NSQ_SOURCE_LINE 00000139 "            __PACKAGE__, # key"
NSQ_SOURCE_LINE 00000140 "            50,          # priority"
NSQ_SOURCE_LINE 00000141 "            sub {        # hook"
NSQ_SOURCE_LINE 00000142 "                my %hook_args = @_; # see Log::ger::Manual::Internals/\"Arguments passed to hook\""
NSQ_SOURCE_LINE 00000143 "                my $layouter = sub {"
NSQ_SOURCE_LINE 00000144 "                    _layout($plugin_conf{format}, $plugin_conf{packages_to_ignore}, $plugin_conf{subroutines_to_ignore}, @_);"
NSQ_SOURCE_LINE 00000145 "                };"
NSQ_SOURCE_LINE 00000146 "                [$layouter];"
NSQ_SOURCE_LINE 00000147 "            }],"
NSQ_SOURCE_LINE 00000148 "    };"
NSQ_SOURCE_LINE 00000149 "}"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "1;"
NSQ_SOURCE_LINE 00000152 "# ABSTRACT: Pattern layout"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "__END__"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=pod"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=head1 NAME"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "Log::ger::Layout::Pattern - Pattern layout"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=head1 VERSION"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "version 0.009"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 " use Log::ger::Layout 'Pattern', format => '%d (%F:%L)> %m';"
NSQ_SOURCE_LINE 00000171 " use Log::ger;"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "Known placeholder in format string:"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 " %c Category of the logging event"
NSQ_SOURCE_LINE 00000178 " %C Fully qualified package (or class) name of the caller"
NSQ_SOURCE_LINE 00000179 " %d Current date in ISO8601 format (YYYY-MM-DD<T>hh:mm:ss) (localtime)"
NSQ_SOURCE_LINE 00000180 " %D Current date in ISO8601 format (YYYY-MM-DD<T>hh:mm:ss) (GMT)"
NSQ_SOURCE_LINE 00000181 " %F File where the logging event occurred"
NSQ_SOURCE_LINE 00000182 " %H Hostname (if Sys::Hostname is available)"
NSQ_SOURCE_LINE 00000183 " %l Fully qualified name of the calling method followed by the"
NSQ_SOURCE_LINE 00000184 "    callers source the file name and line number between"
NSQ_SOURCE_LINE 00000185 "    parentheses."
NSQ_SOURCE_LINE 00000186 " %L Line number within the file where the log statement was issued"
NSQ_SOURCE_LINE 00000187 " %m The message to be logged"
NSQ_SOURCE_LINE 00000188 " %M Method or function where the logging request was issued"
NSQ_SOURCE_LINE 00000189 " %n Newline (OS-independent)"
NSQ_SOURCE_LINE 00000190 " %p Level (\"priority\")of the logging event"
NSQ_SOURCE_LINE 00000191 " %P pid of the current process"
NSQ_SOURCE_LINE 00000192 " %r Number of seconds elapsed from program start to logging event"
NSQ_SOURCE_LINE 00000193 " %R Number of seconds elapsed from last logging event to current"
NSQ_SOURCE_LINE 00000194 "    logging event"
NSQ_SOURCE_LINE 00000195 " %T A stack trace of functions called"
NSQ_SOURCE_LINE 00000196 " %% A literal percent (%) sign"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 " %_{vmsize}  Process virtual memory size, in KB."
NSQ_SOURCE_LINE 00000199 "    Currently works on Linux only. Value is cached for 1 second."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=for Pod::Coverage ^(.+)$"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=head1 CONFIGURATION"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=head2 format"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=head2 packages_to_ignore"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "Regex or arrayref. When producing caller or stack trace information, will pass"
NSQ_SOURCE_LINE 00000210 "this to L<Devel::Caller::Util>'s C<caller()> or C<callers()>."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=head2 subroutines_to_ignore"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "Regex or arrayref. When producing caller or stack trace information, will pass"
NSQ_SOURCE_LINE 00000215 "this to L<Devel::Caller::Util>'s C<caller()> or C<callers()>."
NSQ_SOURCE_LINE 00000216 ""
