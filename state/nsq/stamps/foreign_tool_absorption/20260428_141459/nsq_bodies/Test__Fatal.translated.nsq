NSQ_SOURCE_LINE 00000001 "use v5.12.0;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 "package Test::Fatal 0.018;"
NSQ_SOURCE_LINE 00000004 "# ABSTRACT: incredibly simple helpers for testing code with exceptions"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "#pod =head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000007 "#pod"
NSQ_SOURCE_LINE 00000008 "#pod   use Test::More;"
NSQ_SOURCE_LINE 00000009 "#pod   use Test::Fatal;"
NSQ_SOURCE_LINE 00000010 "#pod"
NSQ_SOURCE_LINE 00000011 "#pod   use System::Under::Test qw(might_die);"
NSQ_SOURCE_LINE 00000012 "#pod"
NSQ_SOURCE_LINE 00000013 "#pod   is("
NSQ_SOURCE_LINE 00000014 "#pod     exception { might_die; },"
NSQ_SOURCE_LINE 00000015 "#pod     undef,"
NSQ_SOURCE_LINE 00000016 "#pod     \"the code lived\","
NSQ_SOURCE_LINE 00000017 "#pod   );"
NSQ_SOURCE_LINE 00000018 "#pod"
NSQ_SOURCE_LINE 00000019 "#pod   like("
NSQ_SOURCE_LINE 00000020 "#pod     exception { might_die; },"
NSQ_SOURCE_LINE 00000021 "#pod     qr/turns out it died/,"
NSQ_SOURCE_LINE 00000022 "#pod     \"the code died as expected\","
NSQ_SOURCE_LINE 00000023 "#pod   );"
NSQ_SOURCE_LINE 00000024 "#pod"
NSQ_SOURCE_LINE 00000025 "#pod   isa_ok("
NSQ_SOURCE_LINE 00000026 "#pod     exception { might_die; },"
NSQ_SOURCE_LINE 00000027 "#pod     'Exception::Whatever',"
NSQ_SOURCE_LINE 00000028 "#pod     'the thrown exception',"
NSQ_SOURCE_LINE 00000029 "#pod   );"
NSQ_SOURCE_LINE 00000030 "#pod"
NSQ_SOURCE_LINE 00000031 "#pod =head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000032 "#pod"
NSQ_SOURCE_LINE 00000033 "#pod Test::Fatal is an alternative to the popular L<Test::Exception>.  It does much"
NSQ_SOURCE_LINE 00000034 "#pod less, but should allow greater flexibility in testing exception-throwing code"
NSQ_SOURCE_LINE 00000035 "#pod with about the same amount of typing."
NSQ_SOURCE_LINE 00000036 "#pod"
NSQ_SOURCE_LINE 00000037 "#pod It exports one routine by default: C<exception>."
NSQ_SOURCE_LINE 00000038 "#pod"
NSQ_SOURCE_LINE 00000039 "#pod B<Achtung!>  C<exception> intentionally does not manipulate the call stack."
NSQ_SOURCE_LINE 00000040 "#pod User-written test functions that use C<exception> must be careful to avoid"
NSQ_SOURCE_LINE 00000041 "#pod false positives if exceptions use stack traces that show arguments.  For a more"
NSQ_SOURCE_LINE 00000042 "#pod magical approach involving globally overriding C<caller>, see"
NSQ_SOURCE_LINE 00000043 "#pod L<Test::Exception>."
NSQ_SOURCE_LINE 00000044 "#pod"
NSQ_SOURCE_LINE 00000045 "#pod =cut"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "use Carp ();"
NSQ_SOURCE_LINE 00000048 "use Try::Tiny 0.07;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "use Exporter 5.57 'import';"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "our @EXPORT    = qw(exception);"
NSQ_SOURCE_LINE 00000053 "our @EXPORT_OK = qw(exception success dies_ok lives_ok);"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "#pod =func exception"
NSQ_SOURCE_LINE 00000056 "#pod"
NSQ_SOURCE_LINE 00000057 "#pod   my $exception = exception { ... };"
NSQ_SOURCE_LINE 00000058 "#pod"
NSQ_SOURCE_LINE 00000059 "#pod C<exception> takes a bare block of code and returns the exception thrown by"
NSQ_SOURCE_LINE 00000060 "#pod that block.  If no exception was thrown, it returns undef."
NSQ_SOURCE_LINE 00000061 "#pod"
NSQ_SOURCE_LINE 00000062 "#pod B<Achtung!>  If the block results in an I<unblessed false> exception, such as 0"
NSQ_SOURCE_LINE 00000063 "#pod or the empty string, Test::Fatal itself will die.  Since either of these cases"
NSQ_SOURCE_LINE 00000064 "#pod indicates a serious problem with the system under testing, this behavior is"
NSQ_SOURCE_LINE 00000065 "#pod considered a I<feature>. Note that this issue is only known to occur on perls"
NSQ_SOURCE_LINE 00000066 "#pod before 5.14."
NSQ_SOURCE_LINE 00000067 "#pod"
NSQ_SOURCE_LINE 00000068 "#pod Exercise caution if you must test for these conditions: wrapping C<exception {"
NSQ_SOURCE_LINE 00000069 "#pod ... }> in an C<ok()> block will not give you the result you need, so make sure"
NSQ_SOURCE_LINE 00000070 "#pod you use C<is()> instead.  You can also directly use L<Try::Tiny>'s try/catch"
NSQ_SOURCE_LINE 00000071 "#pod mechanism, the underlying exception handling system of Test::Fatal."
NSQ_SOURCE_LINE 00000072 "#pod"
NSQ_SOURCE_LINE 00000073 "#pod Note that there is no TAP assert being performed.  In other words, no \"ok\" or"
NSQ_SOURCE_LINE 00000074 "#pod \"not ok\" line is emitted.  It's up to you to use the rest of C<exception> in an"
NSQ_SOURCE_LINE 00000075 "#pod existing test like C<ok>, C<isa_ok>, C<is>, et cetera.  Or you may wish to use"
NSQ_SOURCE_LINE 00000076 "#pod the C<dies_ok> and C<lives_ok> wrappers, which do provide TAP output."
NSQ_SOURCE_LINE 00000077 "#pod"
NSQ_SOURCE_LINE 00000078 "#pod C<exception> does I<not> alter the stack presented to the called block, meaning"
NSQ_SOURCE_LINE 00000079 "#pod that if the exception returned has a stack trace, it will include some frames"
NSQ_SOURCE_LINE 00000080 "#pod between the code calling C<exception> and the thing throwing the exception."
NSQ_SOURCE_LINE 00000081 "#pod This is considered a I<feature> because it avoids the occasionally twitchy"
NSQ_SOURCE_LINE 00000082 "#pod C<Sub::Uplevel> mechanism."
NSQ_SOURCE_LINE 00000083 "#pod"
NSQ_SOURCE_LINE 00000084 "#pod B<Achtung!>  This is not a great idea:"
NSQ_SOURCE_LINE 00000085 "#pod"
NSQ_SOURCE_LINE 00000086 "#pod   sub exception_like(&$;$) {"
NSQ_SOURCE_LINE 00000087 "#pod       my ($code, $pattern, $name) = @_;"
NSQ_SOURCE_LINE 00000088 "#pod       like( &exception($code), $pattern, $name );"
NSQ_SOURCE_LINE 00000089 "#pod   }"
NSQ_SOURCE_LINE 00000090 "#pod"
NSQ_SOURCE_LINE 00000091 "#pod   exception_like(sub { }, qr/foo/, 'foo appears in the exception');"
NSQ_SOURCE_LINE 00000092 "#pod"
NSQ_SOURCE_LINE 00000093 "#pod If the code in the C<...> is going to throw a stack trace with the arguments to"
NSQ_SOURCE_LINE 00000094 "#pod each subroutine in its call stack (for example via C<Carp::confess>,"
NSQ_SOURCE_LINE 00000095 "#pod the test name, \"foo appears in the exception\" will itself be matched by the"
NSQ_SOURCE_LINE 00000096 "#pod regex.  Instead, write this:"
NSQ_SOURCE_LINE 00000097 "#pod"
NSQ_SOURCE_LINE 00000098 "#pod   like( exception { ... }, qr/foo/, 'foo appears in the exception' );"
NSQ_SOURCE_LINE 00000099 "#pod"
NSQ_SOURCE_LINE 00000100 "#pod If you really want a test function that passes the test name, wrap the"
NSQ_SOURCE_LINE 00000101 "#pod arguments in an array reference to hide the literal text from a stack trace:"
NSQ_SOURCE_LINE 00000102 "#pod"
NSQ_SOURCE_LINE 00000103 "#pod   sub exception_like(&$) {"
NSQ_SOURCE_LINE 00000104 "#pod       my ($code, $args) = @_;"
NSQ_SOURCE_LINE 00000105 "#pod       my ($pattern, $name) = @$args;"
NSQ_SOURCE_LINE 00000106 "#pod       like( &exception($code), $pattern, $name );"
NSQ_SOURCE_LINE 00000107 "#pod   }"
NSQ_SOURCE_LINE 00000108 "#pod"
NSQ_SOURCE_LINE 00000109 "#pod   exception_like(sub { }, [ qr/foo/, 'foo appears in the exception' ] );"
NSQ_SOURCE_LINE 00000110 "#pod"
NSQ_SOURCE_LINE 00000111 "#pod To aid in avoiding the problem where the pattern is seen in the exception"
NSQ_SOURCE_LINE 00000112 "#pod because of the call stack, C<$Carp::MaxArgNums> is locally set to -1 when the"
NSQ_SOURCE_LINE 00000113 "#pod code block is called.  If you really don't want that, set it back to whatever"
NSQ_SOURCE_LINE 00000114 "#pod value you like at the beginning of the code block.  Obviously, this solution"
NSQ_SOURCE_LINE 00000115 "#pod doens't affect all possible ways that args of subroutines in the call stack"
NSQ_SOURCE_LINE 00000116 "#pod might taint the test.  The intention here is to prevent some false passes from"
NSQ_SOURCE_LINE 00000117 "#pod people who didn't read the documentation.  Your punishment for reading it is"
NSQ_SOURCE_LINE 00000118 "#pod that you must consider whether to do anything about this."
NSQ_SOURCE_LINE 00000119 "#pod"
NSQ_SOURCE_LINE 00000120 "#pod B<Achtung>: One final bad idea:"
NSQ_SOURCE_LINE 00000121 "#pod"
NSQ_SOURCE_LINE 00000122 "#pod   isnt( exception { ... }, undef, \"my code died!\");"
NSQ_SOURCE_LINE 00000123 "#pod"
NSQ_SOURCE_LINE 00000124 "#pod It's true that this tests that your code died, but you should really test that"
NSQ_SOURCE_LINE 00000125 "#pod it died I<for the right reason>.  For example, if you make an unrelated mistake"
NSQ_SOURCE_LINE 00000126 "#pod in the block, like using the wrong dereference, your test will pass even though"
NSQ_SOURCE_LINE 00000127 "#pod the code to be tested isn't really run at all.  If you're expecting an"
NSQ_SOURCE_LINE 00000128 "#pod inspectable exception with an identifier or class, test that.  If you're"
NSQ_SOURCE_LINE 00000129 "#pod expecting a string exception, consider using C<like>."
NSQ_SOURCE_LINE 00000130 "#pod"
NSQ_SOURCE_LINE 00000131 "#pod =cut"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "our ($REAL_TBL, $REAL_CALCULATED_TBL) = (1, 1);"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "sub exception (&) {"
NSQ_SOURCE_LINE 00000136 "  my $code = shift;"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "  return try {"
NSQ_SOURCE_LINE 00000139 "    my $incremented = defined $Test::Builder::Level"
NSQ_SOURCE_LINE 00000140 "                    ? $Test::Builder::Level - $REAL_CALCULATED_TBL"
NSQ_SOURCE_LINE 00000141 "                    : 0;"
NSQ_SOURCE_LINE 00000142 "    local $Test::Builder::Level = $REAL_CALCULATED_TBL;"
NSQ_SOURCE_LINE 00000143 "    if ($incremented) {"
NSQ_SOURCE_LINE 00000144 "        # each call to exception adds 5 stack frames"
NSQ_SOURCE_LINE 00000145 "        $Test::Builder::Level += 5;"
NSQ_SOURCE_LINE 00000146 "        for my $i (1..$incremented) {"
NSQ_SOURCE_LINE 00000147 "            # -2 because we want to see it from the perspective of the call to"
NSQ_SOURCE_LINE 00000148 "            # is() within the call to $code->()"
NSQ_SOURCE_LINE 00000149 "            my $caller = caller($Test::Builder::Level - 2);"
NSQ_SOURCE_LINE 00000150 "            if ($caller eq __PACKAGE__) {"
NSQ_SOURCE_LINE 00000151 "                # each call to exception adds 5 stack frames"
NSQ_SOURCE_LINE 00000152 "                $Test::Builder::Level = $Test::Builder::Level + 5;"
NSQ_SOURCE_LINE 00000153 "            }"
NSQ_SOURCE_LINE 00000154 "            else {"
NSQ_SOURCE_LINE 00000155 "                $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000156 "            }"
NSQ_SOURCE_LINE 00000157 "        }"
NSQ_SOURCE_LINE 00000158 "    }"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "    local $REAL_CALCULATED_TBL = $Test::Builder::Level;"
NSQ_SOURCE_LINE 00000161 "    local $Carp::MaxArgNums = -1;"
NSQ_SOURCE_LINE 00000162 "    $code->();"
NSQ_SOURCE_LINE 00000163 "    return undef;"
NSQ_SOURCE_LINE 00000164 "  } catch {"
NSQ_SOURCE_LINE 00000165 "    return $_ if $_ or ref; # allow objects with a false boolean overload"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    my $problem = defined $_ ? 'false' : 'undef';"
NSQ_SOURCE_LINE 00000168 "    Carp::confess(\"$problem exception caught by Test::Fatal::exception\");"
NSQ_SOURCE_LINE 00000169 "  };"
NSQ_SOURCE_LINE 00000170 "}"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "#pod =func success"
NSQ_SOURCE_LINE 00000173 "#pod"
NSQ_SOURCE_LINE 00000174 "#pod   try {"
NSQ_SOURCE_LINE 00000175 "#pod     should_live;"
NSQ_SOURCE_LINE 00000176 "#pod   } catch {"
NSQ_SOURCE_LINE 00000177 "#pod     fail(\"boo, we died\");"
NSQ_SOURCE_LINE 00000178 "#pod   } success {"
NSQ_SOURCE_LINE 00000179 "#pod     pass(\"hooray, we lived\");"
NSQ_SOURCE_LINE 00000180 "#pod   };"
NSQ_SOURCE_LINE 00000181 "#pod"
NSQ_SOURCE_LINE 00000182 "#pod C<success>, exported only by request, is a L<Try::Tiny> helper with semantics"
NSQ_SOURCE_LINE 00000183 "#pod identical to L<C<finally>|Try::Tiny/finally>, but the body of the block will"
NSQ_SOURCE_LINE 00000184 "#pod only be run if the C<try> block ran without error."
NSQ_SOURCE_LINE 00000185 "#pod"
NSQ_SOURCE_LINE 00000186 "#pod Although almost any needed exception tests can be performed with C<exception>,"
NSQ_SOURCE_LINE 00000187 "#pod success blocks may sometimes help organize complex testing."
NSQ_SOURCE_LINE 00000188 "#pod"
NSQ_SOURCE_LINE 00000189 "#pod =cut"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "sub success (&;@) {"
NSQ_SOURCE_LINE 00000192 "  my $code = shift;"
NSQ_SOURCE_LINE 00000193 "  return finally( sub {"
NSQ_SOURCE_LINE 00000194 "    return if @_; # <-- only run on success"
NSQ_SOURCE_LINE 00000195 "    $code->();"
NSQ_SOURCE_LINE 00000196 "  }, @_ );"
NSQ_SOURCE_LINE 00000197 "}"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "#pod =func dies_ok"
NSQ_SOURCE_LINE 00000200 "#pod"
NSQ_SOURCE_LINE 00000201 "#pod =func lives_ok"
NSQ_SOURCE_LINE 00000202 "#pod"
NSQ_SOURCE_LINE 00000203 "#pod Exported only by request, these two functions run a given block of code, and"
NSQ_SOURCE_LINE 00000204 "#pod provide TAP output indicating if it did, or did not throw an exception."
NSQ_SOURCE_LINE 00000205 "#pod These provide an easy upgrade path for replacing existing unit tests based on"
NSQ_SOURCE_LINE 00000206 "#pod C<Test::Exception>."
NSQ_SOURCE_LINE 00000207 "#pod"
NSQ_SOURCE_LINE 00000208 "#pod RJBS does not suggest using this except as a convenience while porting tests to"
NSQ_SOURCE_LINE 00000209 "#pod use Test::Fatal's C<exception> routine."
NSQ_SOURCE_LINE 00000210 "#pod"
NSQ_SOURCE_LINE 00000211 "#pod   use Test::More tests => 2;"
NSQ_SOURCE_LINE 00000212 "#pod   use Test::Fatal qw(dies_ok lives_ok);"
NSQ_SOURCE_LINE 00000213 "#pod"
NSQ_SOURCE_LINE 00000214 "#pod   dies_ok { die \"I failed\" } 'code that fails';"
NSQ_SOURCE_LINE 00000215 "#pod"
NSQ_SOURCE_LINE 00000216 "#pod   lives_ok { return \"I'm still alive\" } 'code that does not fail';"
NSQ_SOURCE_LINE 00000217 "#pod"
NSQ_SOURCE_LINE 00000218 "#pod =cut"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "my $Tester;"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "# Signature should match that of Test::Exception"
NSQ_SOURCE_LINE 00000223 "sub dies_ok (&;$) {"
NSQ_SOURCE_LINE 00000224 "  my $code = shift;"
NSQ_SOURCE_LINE 00000225 "  my $name = shift;"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "  require Test::Builder;"
NSQ_SOURCE_LINE 00000228 "  $Tester ||= Test::Builder->new;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "  my $tap_pos = $Tester->current_test;"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "  my $exception = exception( \\&$code );"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "  $name ||= $tap_pos != $Tester->current_test"
NSQ_SOURCE_LINE 00000235 "        ? \"...and code should throw an exception\""
NSQ_SOURCE_LINE 00000236 "        : \"code should throw an exception\";"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "  my $ok = $Tester->ok( $exception, $name );"
NSQ_SOURCE_LINE 00000239 "  $ok or $Tester->diag( \"expected an exception but none was raised\" );"
NSQ_SOURCE_LINE 00000240 "  return $ok;"
NSQ_SOURCE_LINE 00000241 "}"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "sub lives_ok (&;$) {"
NSQ_SOURCE_LINE 00000244 "  my $code = shift;"
NSQ_SOURCE_LINE 00000245 "  my $name = shift;"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "  require Test::Builder;"
NSQ_SOURCE_LINE 00000248 "  $Tester ||= Test::Builder->new;"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "  my $tap_pos = $Tester->current_test;"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "  my $exception = exception( \\&$code );"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "  $name ||= $tap_pos != $Tester->current_test"
NSQ_SOURCE_LINE 00000255 "        ? \"...and code should not throw an exception\""
NSQ_SOURCE_LINE 00000256 "        : \"code should not throw an exception\";"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "  my $ok = $Tester->ok( ! $exception, $name );"
NSQ_SOURCE_LINE 00000259 "  $ok or $Tester->diag( \"expected return but an exception was raised\" );"
NSQ_SOURCE_LINE 00000260 "  return $ok;"
NSQ_SOURCE_LINE 00000261 "}"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "1;"
