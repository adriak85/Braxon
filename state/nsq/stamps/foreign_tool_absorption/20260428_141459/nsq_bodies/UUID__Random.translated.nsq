BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package UUID::Random;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "require 5.006_001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.04';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "sub generate {"
NSQ_SOURCE_LINE 00000011 "  my @chars = ('a'..'f',0..9);"
NSQ_SOURCE_LINE 00000012 "  my @string;"
NSQ_SOURCE_LINE 00000013 "  push(@string, $chars[int(rand(16))]) for(1..32);"
NSQ_SOURCE_LINE 00000014 "  splice(@string,8,0,'-');"
NSQ_SOURCE_LINE 00000015 "  splice(@string,13,0,'-');"
NSQ_SOURCE_LINE 00000016 "  splice(@string,18,0,'-');"
NSQ_SOURCE_LINE 00000017 "  splice(@string,23,0,'-');"
NSQ_SOURCE_LINE 00000018 "  return join('', @string);"
NSQ_SOURCE_LINE 00000019 "}"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "1;"
NSQ_SOURCE_LINE 00000022 "__END__"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=head1 NAME"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "UUID::Random - Generate random uuid strings"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "  use UUID::Random;"
NSQ_SOURCE_LINE 00000031 "  my $uuid = UUID::Random::generate;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "This module generates random uuid strings. It does not satisfy any of the points listed in RFC 4122 (L<http://tools.ietf.org/html/rfc4122>) but the default format."
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "If you need RFC compliant UUID strings have a look at L<Data::UUID>"
NSQ_SOURCE_LINE 00000042 ""
