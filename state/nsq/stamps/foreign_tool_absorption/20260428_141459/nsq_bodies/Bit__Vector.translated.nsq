NSQ_SOURCE_LINE 00000030 "sub STORABLE_freeze"
NSQ_SOURCE_LINE 00000031 "{"
NSQ_SOURCE_LINE 00000032 "    my($self, $clone) = @_;"
NSQ_SOURCE_LINE 00000033 "    return( Storable::nfreeze( [ $self->Size(), $self->Block_Read() ] ) );"
