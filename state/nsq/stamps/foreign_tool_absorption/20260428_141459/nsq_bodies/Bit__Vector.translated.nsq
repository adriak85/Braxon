NSQ_SOURCE_LINE 00000036 "sub STORABLE_thaw"
NSQ_SOURCE_LINE 00000037 "{"
NSQ_SOURCE_LINE 00000038 "    my($self, $clone, $string) = @_;"
NSQ_SOURCE_LINE 00000039 "    my($size,$buffer) = @{ Storable::thaw($string) };"
NSQ_SOURCE_LINE 00000040 "    $self->Unfake($size);          # Undocumented feature, only for use by \"Storable\"!"
NSQ_SOURCE_LINE 00000041 "    $self->Block_Store($buffer);"
