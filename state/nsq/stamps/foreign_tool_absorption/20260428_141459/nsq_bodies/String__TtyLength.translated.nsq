BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package String::TtyLength;"
NSQ_SOURCE_LINE 00000002 "$String::TtyLength::VERSION = '0.03';"
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use parent 'Exporter';"
NSQ_SOURCE_LINE 00000007 "use Unicode::EastAsianWidth 12.0;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our @EXPORT_OK = qw/ tty_length tty_width /;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "my $cursor_position     = qr/\\e\\[[0-9]+;[0-9]+[Hf]/;"
NSQ_SOURCE_LINE 00000012 "my $cursor_movement     = qr/\\e\\[[0-9]+[ABCD]/;"
NSQ_SOURCE_LINE 00000013 "my $save_restore_cursor = qr/\\e\\[[su]/;"
NSQ_SOURCE_LINE 00000014 "my $clear_screen        = qr/\\e\\[2J/;"
NSQ_SOURCE_LINE 00000015 "my $erase_line          = qr/\\e\\[K/;"
NSQ_SOURCE_LINE 00000016 "my $graphics_mode       = qr/\\e\\[[0-9]+(;[0-9]+)*m/;"
NSQ_SOURCE_LINE 00000017 "my $ansi_code           = qr/"
NSQ_SOURCE_LINE 00000018 "                            ("
NSQ_SOURCE_LINE 00000019 "                              $cursor_position"
NSQ_SOURCE_LINE 00000020 "                            | $cursor_movement"
NSQ_SOURCE_LINE 00000021 "                            | $save_restore_cursor"
NSQ_SOURCE_LINE 00000022 "                            | $clear_screen"
NSQ_SOURCE_LINE 00000023 "                            | $erase_line"
NSQ_SOURCE_LINE 00000024 "                            | $graphics_mode"
NSQ_SOURCE_LINE 00000025 "                            )"
NSQ_SOURCE_LINE 00000026 "                            /x;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "                            "
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "sub tty_length"
NSQ_SOURCE_LINE 00000031 "{"
NSQ_SOURCE_LINE 00000032 "    my $string = shift;"
NSQ_SOURCE_LINE 00000033 "    return length(_remove_ansi_codes($string));"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub tty_width"
NSQ_SOURCE_LINE 00000037 "{"
NSQ_SOURCE_LINE 00000038 "    my $string = _remove_ansi_codes(shift);"
NSQ_SOURCE_LINE 00000039 "    my $width  = length($string);"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    $width++ while $string =~ /\\p{InFullwidth}/msg;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    return $width;"
NSQ_SOURCE_LINE 00000044 "}"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "# might make this an exportable function"
NSQ_SOURCE_LINE 00000047 "# as well, but not sure what the right name is :-)"
NSQ_SOURCE_LINE 00000048 "sub _remove_ansi_codes"
NSQ_SOURCE_LINE 00000049 "{"
NSQ_SOURCE_LINE 00000050 "    my $string = shift;"
NSQ_SOURCE_LINE 00000051 "    $string =~ s/$ansi_code//mosg;"
NSQ_SOURCE_LINE 00000052 "    return $string;"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "1;"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "__END__"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=pod"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=encoding utf8"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=head1 NAME"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "String::TtyLength - length or width of string excluding ANSI tty codes"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 " use String::TtyLength 0.02 qw/ tty_length tty_width /;"
NSQ_SOURCE_LINE 00000070 " $length = tty_length(\"\\e[1mbold text\\e[0m\");"
NSQ_SOURCE_LINE 00000071 " print \"length = $length\\n\";"
NSQ_SOURCE_LINE 00000072 " # 9"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 " $width = tty_width(\"😄\");"
NSQ_SOURCE_LINE 00000075 " print \"width = $width\\n\";"
NSQ_SOURCE_LINE 00000076 " # 2"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "This module provides two functions which tell you the length"
NSQ_SOURCE_LINE 00000081 "and width of a string as it will appear on a terminal (tty),"
NSQ_SOURCE_LINE 00000082 "excluding any ANSI escape codes."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "C<tty_length> returns the length of a string excluding any ANSI"
NSQ_SOURCE_LINE 00000085 "tty / terminal escape codes."
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "C<tty_width> returns the number of columns on a terminal that"
NSQ_SOURCE_LINE 00000088 "the string will take up, also excluding any escape codes."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "For non-wide characters,"
NSQ_SOURCE_LINE 00000091 "the functions will return the same value."
NSQ_SOURCE_LINE 00000092 "But consider the following:"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 " my $emoji  = \"😄\";"
NSQ_SOURCE_LINE 00000095 " my $length = tty_length($emoji);   # 1"
NSQ_SOURCE_LINE 00000096 " my $width  = tty_width($emoji);    # 2"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "If you're trying to align text in columns,"
NSQ_SOURCE_LINE 00000099 "then you'll probably want C<tty_width>;"
NSQ_SOURCE_LINE 00000100 "if you just want to know the number of characters,"
NSQ_SOURCE_LINE 00000101 "using C<tty_length>."
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=head2 tty_length( STRING )"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "Takes a single string,"
NSQ_SOURCE_LINE 00000107 "and returns the length of the string,"
NSQ_SOURCE_LINE 00000108 "excluding any escape sequences."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "Note: the escape sequences could include cursor movement,"
NSQ_SOURCE_LINE 00000111 "so the length returned by this function might not be the"
NSQ_SOURCE_LINE 00000112 "number of characters that would be visible on screen."
NSQ_SOURCE_LINE 00000113 "But C<length_of_string_excluding_escape_sequences()>"
NSQ_SOURCE_LINE 00000114 "was just too long."
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=head2 tty_width( STRING )"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "Takes a single string and returns the number of columns"
NSQ_SOURCE_LINE 00000120 "that the string will take up on a terminal."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "You may find that sometimes C<tty_width()> returns the wrong number."
NSQ_SOURCE_LINE 00000123 "If you do, please submit a bug, or email me at the address below."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "This was added in version 0.02 of C<String::TtyLength>,"
NSQ_SOURCE_LINE 00000126 "so you should require at least that version of this module,"
NSQ_SOURCE_LINE 00000127 "as per the SYNOPSIS."
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "C<colorstrip()> in L<Term::ANSIColor>"
NSQ_SOURCE_LINE 00000133 "will remove ANSI color escape sequences from a string,"
NSQ_SOURCE_LINE 00000134 "but not all ANSI escape sequences."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head1 REPOSITORY"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "L<https://github.com/neilb/String-TtyLength>"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 ""
