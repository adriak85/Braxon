BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Test::Memory::Cycle;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "=head1 NAME"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "Test::Memory::Cycle - Check for memory leaks and circular memory references"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "=head1 VERSION"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "Version 1.06"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "=cut"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our $VERSION = '1.06';"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "Perl's garbage collection has one big problem: Circular references"
NSQ_SOURCE_LINE 00000021 "can't get cleaned up.  A circular reference can be as simple as two"
NSQ_SOURCE_LINE 00000022 "references that refer to each other:"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    my $mom = {"
NSQ_SOURCE_LINE 00000025 "        name => \"Marilyn Lester\","
NSQ_SOURCE_LINE 00000026 "    };"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    my $me = {"
NSQ_SOURCE_LINE 00000029 "        name => \"Andy Lester\","
NSQ_SOURCE_LINE 00000030 "        mother => $mom,"
NSQ_SOURCE_LINE 00000031 "    };"
NSQ_SOURCE_LINE 00000032 "    $mom->{son} = $me;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "C<Test::Memory::Cycle> is built on top of C<Devel::Cycle> to give"
NSQ_SOURCE_LINE 00000035 "you an easy way to check for these circular references."
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    use Test::Memory::Cycle;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    my $object = new MyObject;"
NSQ_SOURCE_LINE 00000040 "    # Do stuff with the object."
NSQ_SOURCE_LINE 00000041 "    memory_cycle_ok( $object );"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "You can also use C<memory_cycle_exists()> to make sure that you have a"
NSQ_SOURCE_LINE 00000044 "cycle where you expect to have one."
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=cut"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "use Devel::Cycle qw( find_cycle find_weakened_cycle );"
NSQ_SOURCE_LINE 00000049 "use Test::Builder;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "my $Test = Test::Builder->new;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "sub import {"
NSQ_SOURCE_LINE 00000054 "    my $self = shift;"
NSQ_SOURCE_LINE 00000055 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000056 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000057 "    *{$caller.'::memory_cycle_ok'}              = \\&memory_cycle_ok;"
NSQ_SOURCE_LINE 00000058 "    *{$caller.'::memory_cycle_exists'}          = \\&memory_cycle_exists;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    *{$caller.'::weakened_memory_cycle_ok'}     = \\&weakened_memory_cycle_ok;"
NSQ_SOURCE_LINE 00000061 "    *{$caller.'::weakened_memory_cycle_exists'} = \\&weakened_memory_cycle_exists;"
NSQ_SOURCE_LINE 00000062 "    *{$caller.'::memory_cycle_exists'}          = \\&memory_cycle_exists;"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    *{$caller.'::weakened_memory_cycle_ok'}     = \\&weakened_memory_cycle_ok;"
NSQ_SOURCE_LINE 00000065 "    *{$caller.'::weakened_memory_cycle_exists'} = \\&weakened_memory_cycle_exists;"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "    $Test->exported_to($caller);"
NSQ_SOURCE_LINE 00000068 "    $Test->plan(@_);"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    return;"
NSQ_SOURCE_LINE 00000071 "}"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=head2 C<memory_cycle_ok( I<$reference>, I<$msg> )>"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "Checks that I<$reference> doesn't have any circular memory references."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=cut"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "sub memory_cycle_ok {"
NSQ_SOURCE_LINE 00000082 "    my $ref = shift;"
NSQ_SOURCE_LINE 00000083 "    my $msg = shift;"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    my $cycle_no = 0;"
NSQ_SOURCE_LINE 00000086 "    my @diags;"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "    # Callback function that is called once for each memory cycle found."
NSQ_SOURCE_LINE 00000089 "    my $callback = sub {"
NSQ_SOURCE_LINE 00000090 "        my $path = shift;"
NSQ_SOURCE_LINE 00000091 "        $cycle_no++;"
NSQ_SOURCE_LINE 00000092 "        push( @diags, \"Cycle #$cycle_no\" );"
NSQ_SOURCE_LINE 00000093 "        foreach (@$path) {"
NSQ_SOURCE_LINE 00000094 "            my ($type,$index,$ref,$value) = @$_;"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "            my $str = 'Unknown! This should never happen!';"
NSQ_SOURCE_LINE 00000097 "            my $refdisp = _ref_shortname( $ref );"
NSQ_SOURCE_LINE 00000098 "            my $valuedisp = _ref_shortname( $value );"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "            $str = sprintf( '    %s => %s', $refdisp, $valuedisp )               if $type eq 'SCALAR';"
NSQ_SOURCE_LINE 00000101 "            $str = sprintf( '    %s => %s', \"${refdisp}->[$index]\", $valuedisp ) if $type eq 'ARRAY';"
NSQ_SOURCE_LINE 00000102 "            $str = sprintf( '    %s => %s', \"${refdisp}->{$index}\", $valuedisp ) if $type eq 'HASH';"
NSQ_SOURCE_LINE 00000103 "            $str = sprintf( '    closure %s => %s', \"${refdisp}, $index\", $valuedisp ) if $type eq 'CODE';"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "            push( @diags, $str );"
NSQ_SOURCE_LINE 00000106 "        }"
NSQ_SOURCE_LINE 00000107 "    };"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    find_cycle( $ref, $callback );"
NSQ_SOURCE_LINE 00000110 "    my $ok = !$cycle_no;"
NSQ_SOURCE_LINE 00000111 "    $Test->ok( $ok, $msg );"
NSQ_SOURCE_LINE 00000112 "    $Test->diag( join( \"\\n\", @diags, '' ) ) unless $ok;"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "    return $ok;"
NSQ_SOURCE_LINE 00000115 "} # memory_cycle_ok"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=head2 C<memory_cycle_exists( I<$reference>, I<$msg> )>"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "Checks that I<$reference> B<does> have any circular memory references."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=cut"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "sub memory_cycle_exists {"
NSQ_SOURCE_LINE 00000124 "    my $ref = shift;"
NSQ_SOURCE_LINE 00000125 "    my $msg = shift;"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "    my $cycle_no = 0;"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "    # Callback function that is called once for each memory cycle found."
NSQ_SOURCE_LINE 00000130 "    my $callback = sub { $cycle_no++ };"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    find_cycle( $ref, $callback );"
NSQ_SOURCE_LINE 00000133 "    my $ok = $cycle_no;"
NSQ_SOURCE_LINE 00000134 "    $Test->ok( $ok, $msg );"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    return $ok;"
NSQ_SOURCE_LINE 00000137 "} # memory_cycle_exists"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head2 C<weakened_memory_cycle_ok( I<$reference>, I<$msg> )>"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "Checks that I<$reference> doesn't have any circular memory references, but unlike "
NSQ_SOURCE_LINE 00000142 "C<memory_cycle_ok> this will also check for weakened cycles produced with "
NSQ_SOURCE_LINE 00000143 "Scalar::Util's C<weaken>."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=cut"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "sub weakened_memory_cycle_ok {"
NSQ_SOURCE_LINE 00000148 "    my $ref = shift;"
NSQ_SOURCE_LINE 00000149 "    my $msg = shift;"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    my $cycle_no = 0;"
NSQ_SOURCE_LINE 00000152 "    my @diags;"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    # Callback function that is called once for each memory cycle found."
NSQ_SOURCE_LINE 00000155 "    my $callback = sub {"
NSQ_SOURCE_LINE 00000156 "        my $path = shift;"
NSQ_SOURCE_LINE 00000157 "        $cycle_no++;"
NSQ_SOURCE_LINE 00000158 "        push( @diags, \"Cycle #$cycle_no\" );"
NSQ_SOURCE_LINE 00000159 "        foreach (@$path) {"
NSQ_SOURCE_LINE 00000160 "            my ($type,$index,$ref,$value,$is_weakened) = @$_;"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "            my $str = \"Unknown! This should never happen!\";"
NSQ_SOURCE_LINE 00000163 "            my $refdisp = _ref_shortname( $ref );"
NSQ_SOURCE_LINE 00000164 "            my $valuedisp = _ref_shortname( $value );"
NSQ_SOURCE_LINE 00000165 "            my $weak = $is_weakened ? 'w->' : '';"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "            $str = sprintf( '    %s%s => %s', $weak, $refdisp, $valuedisp )               if $type eq 'SCALAR';"
NSQ_SOURCE_LINE 00000168 "            $str = sprintf( '    %s%s => %s', $weak, \"${refdisp}->[$index]\", $valuedisp ) if $type eq 'ARRAY';"
NSQ_SOURCE_LINE 00000169 "            $str = sprintf( '    %s%s => %s', $weak, \"${refdisp}->{$index}\", $valuedisp ) if $type eq 'HASH';"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "            push( @diags, $str );"
NSQ_SOURCE_LINE 00000172 "        }"
NSQ_SOURCE_LINE 00000173 "    };"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    find_weakened_cycle( $ref, $callback );"
NSQ_SOURCE_LINE 00000176 "    my $ok = !$cycle_no;"
NSQ_SOURCE_LINE 00000177 "    $Test->ok( $ok, $msg );"
NSQ_SOURCE_LINE 00000178 "    $Test->diag( join( \"\\n\", @diags, \"\" ) ) unless $ok;"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    return $ok;"
NSQ_SOURCE_LINE 00000181 "} # weakened_memory_cycle_ok"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=head2 C<weakened_memory_cycle_exists( I<$reference>, I<$msg> )>"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "Checks that I<$reference> B<does> have any circular memory references, but unlike "
NSQ_SOURCE_LINE 00000186 "C<memory_cycle_exists> this will also check for weakened cycles produced with "
NSQ_SOURCE_LINE 00000187 "Scalar::Util's C<weaken>."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=cut"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "sub weakened_memory_cycle_exists {"
NSQ_SOURCE_LINE 00000192 "    my $ref = shift;"
NSQ_SOURCE_LINE 00000193 "    my $msg = shift;"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    my $cycle_no = 0;"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "    # Callback function that is called once for each memory cycle found."
NSQ_SOURCE_LINE 00000198 "    my $callback = sub { $cycle_no++ };"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    find_weakened_cycle( $ref, $callback );"
NSQ_SOURCE_LINE 00000201 "    my $ok = $cycle_no;"
NSQ_SOURCE_LINE 00000202 "    $Test->ok( $ok, $msg );"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "    return $ok;"
NSQ_SOURCE_LINE 00000205 "} # weakened_memory_cycle_exists"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "my %shortnames;"
NSQ_SOURCE_LINE 00000209 "my $new_shortname = \"A\";"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "sub _ref_shortname {"
NSQ_SOURCE_LINE 00000212 "    my $ref = shift;"
NSQ_SOURCE_LINE 00000213 "    my $refstr = \"$ref\";"
NSQ_SOURCE_LINE 00000214 "    my $refdisp = $shortnames{ $refstr };"
NSQ_SOURCE_LINE 00000215 "    if ( !$refdisp ) {"
NSQ_SOURCE_LINE 00000216 "        my $sigil = ref($ref) . \" \";"
NSQ_SOURCE_LINE 00000217 "        $sigil = '%' if $sigil eq \"HASH \";"
NSQ_SOURCE_LINE 00000218 "        $sigil = '@' if $sigil eq \"ARRAY \";"
NSQ_SOURCE_LINE 00000219 "        $sigil = '$' if $sigil eq \"REF \";"
NSQ_SOURCE_LINE 00000220 "        $sigil = '&' if $sigil eq \"CODE \";"
NSQ_SOURCE_LINE 00000221 "        $refdisp = $shortnames{ $refstr } = $sigil . $new_shortname++;"
NSQ_SOURCE_LINE 00000222 "    }"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "    return $refdisp;"
NSQ_SOURCE_LINE 00000225 "}"
NSQ_SOURCE_LINE 00000226 ""
