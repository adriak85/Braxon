NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "1;"
NSQ_SOURCE_LINE 00000037 "# ABSTRACT: Routines for text containing ANSI color codes"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "__END__"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=pod"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=head1 NAME"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "Text::ANSI::Util - Routines for text containing ANSI color codes"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=head1 VERSION"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "This document describes version 0.234 of Text::ANSI::Util (from Perl distribution Text-ANSI-Util), released on 2023-02-27."
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 " use Text::ANSI::Util qw("
NSQ_SOURCE_LINE 00000056 "                       ta_add_color_resets"
NSQ_SOURCE_LINE 00000057 "                       ta_detect"
NSQ_SOURCE_LINE 00000058 "                       ta_extract_codes"
NSQ_SOURCE_LINE 00000059 "                       ta_highlight"
NSQ_SOURCE_LINE 00000060 "                       ta_highlight_all"
NSQ_SOURCE_LINE 00000061 "                       ta_length"
NSQ_SOURCE_LINE 00000062 "                       ta_length_height"
NSQ_SOURCE_LINE 00000063 "                       ta_pad"
NSQ_SOURCE_LINE 00000064 "                       ta_split_codes"
NSQ_SOURCE_LINE 00000065 "                       ta_split_codes_single"
NSQ_SOURCE_LINE 00000066 "                       ta_strip"
NSQ_SOURCE_LINE 00000067 "                       ta_substr"
NSQ_SOURCE_LINE 00000068 "                       ta_trunc"
NSQ_SOURCE_LINE 00000069 "                       ta_wrap"
NSQ_SOURCE_LINE 00000070 "                      );"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 " # detect whether text has ANSI color codes?"
NSQ_SOURCE_LINE 00000073 " say ta_detect(\"red\");       # => false"
NSQ_SOURCE_LINE 00000074 " say ta_detect(\"\\e[31mred\"); # => true"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 " # calculate length of text (excluding the ANSI color codes)"
NSQ_SOURCE_LINE 00000077 " say ta_length(\"red\");       # => 3"
NSQ_SOURCE_LINE 00000078 " say ta_length(\"\\e[31mred\"); # => 3"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 " # strip ANSI color codes"
NSQ_SOURCE_LINE 00000081 " say ta_strip(\"\\e[31mred\"); # => \"red\""
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 " # split codes (ANSI color codes are always on the even positions)"
NSQ_SOURCE_LINE 00000084 " my @parts = ta_split_codes(\"\\e[31mred\"); # => (\"\", \"\\e[31m\", \"red\")"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 " # wrap text to a certain column width, handle ANSI color codes"
NSQ_SOURCE_LINE 00000087 " say ta_wrap(\"....\", 40);"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 " # pad (left, right, center) text to a certain width"
NSQ_SOURCE_LINE 00000090 " say ta_pad(\"foo\", 10);                          # => \"foo       \""
NSQ_SOURCE_LINE 00000091 " say ta_pad(\"foo\", 10, \"left\");                  # => \"       foo\""
NSQ_SOURCE_LINE 00000092 " say ta_pad(\"foo\\nbarbaz\\n\", 10, \"center\", \".\"); # => \"...foo....\\n..barbaz..\\n\""
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 " # truncate text to a certain width while still passing ANSI color codes"
NSQ_SOURCE_LINE 00000095 " use Term::ANSIColor;"
NSQ_SOURCE_LINE 00000096 " my $text = color(\"red\").\"red text\".color(\"reset\"); # => \"\\e[31mred text\\e[0m\""
NSQ_SOURCE_LINE 00000097 " say ta_trunc($text, 5);                            # => \"\\e[31mred t\\e[0m\""
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 " # highlight the first occurrence of some string within text"
NSQ_SOURCE_LINE 00000100 " say ta_highlight(\"some text\", \"ome\", \"\\e[7m\\e[31m\");"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 " # ditto, but highlight all occurrences"
NSQ_SOURCE_LINE 00000103 " say ta_highlight_all(...);"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 " # get substring"
NSQ_SOURCE_LINE 00000106 " my $substr = ta_substr(\"...\", $pos, $len);"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 " # return text but with substring replaced with replacement"
NSQ_SOURCE_LINE 00000109 " say ta_substr(\"...\", $pos, $len, $replacement);"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "This module provides routines for dealing with text that contains ANSI color"
NSQ_SOURCE_LINE 00000114 "codes, e.g. for determining its length/width (excluding the color codes),"
NSQ_SOURCE_LINE 00000115 "stripping the color codes, extracting the color codes, and so on."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "For functions that support wide characters, see L<Text::ANSI::WideUtil>."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "Current caveats:"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=over"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=item * Other ANSI codes (non-color codes) are ignored"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "These are codes like for altering cursor positions, etc."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=item * Single-character CSI (control sequence introducer) currently ignored"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "Only C<ESC+[> (two-character CSI) is currently parsed."
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "BTW, in ASCII terminals, single-character CSI is C<0x9b>. In UTF-8 terminals, it"
NSQ_SOURCE_LINE 00000132 "is C<0xc2, 0x9b> (2 bytes)."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=item * Private-mode- and trailing-intermediate character currently not parsed"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=item * Only color reset code \\e[0m is recognized"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "For simplicity, currently multiple SGR parameters inside a single ANSI color"
NSQ_SOURCE_LINE 00000139 "code is not parsed. This means that color reset code like C<\\e[1;0m> or"
NSQ_SOURCE_LINE 00000140 "C<\\e[31;47;0m> is not recognized, only C<\\e[0m> is. I believe this should not be"
NSQ_SOURCE_LINE 00000141 "a problem with most real-world text out there."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=back"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=head2 ta_add_color_resets(@text) => LIST"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "Make sure that a color reset command (add C<\\e[0m>) to the end of each element"
NSQ_SOURCE_LINE 00000150 "and a replay of all the color codes from the previous element, from the last"
NSQ_SOURCE_LINE 00000151 "color reset) to the start of the next element, and so on. Return the new list."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "This makes each element safe to be combined with other array of text into a"
NSQ_SOURCE_LINE 00000154 "single line, e.g. in a multicolumn/tabular layout. An example:"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "Without color resets:"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 " my @col1 = split /\\n/, \"\\e[31mred\\nmerah\\e[0m\";"
NSQ_SOURCE_LINE 00000159 " my @col2 = split /\\n/, \"\\e[32mgreen\\e[1m\\nhijau tebal\\e[0m\";"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 " printf \"%s | %s\\n\", $col1[0], $col2[0];"
NSQ_SOURCE_LINE 00000162 " printf \"%s | %s\\n\", $col1[1], $col2[1];"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "the printed output:"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 " \\e[31mred | \\e[32mgreen"
NSQ_SOURCE_LINE 00000167 " merah\\e[0m | \\e[1mhijau tebal\\e[0m"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "The C<merah> text on the second line will become green because of the effect of"
NSQ_SOURCE_LINE 00000170 "the last color command printed (C<\\e[32m>). However, with ta_add_color_resets():"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 " my @col1 = ta_add_color_resets(split /\\n/, \"\\e[31mred\\nmerah\\e[0m\");"
NSQ_SOURCE_LINE 00000173 " my @col2 = ta_add_color_resets(split /\\n/, \"\\e[32mgreen\\e[1m\\nhijau tebal\\e[0m\");"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 " printf \"%s | %s\\n\", $col1[0], $col2[0];"
NSQ_SOURCE_LINE 00000176 " printf \"%s | %s\\n\", $col1[1], $col2[1];"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "the printed output (C<< <...> >>) marks the code added by ta_add_color_resets():"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 " \\e[31mred<\\e[0m> | \\e[32mgreen\\e[1m<\\e[0m>"
NSQ_SOURCE_LINE 00000181 " <\\e[31m>merah\\e[0m | <\\e[32m\\e[1m>hijau tebal\\e[0m"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "All the cells are printed with the intended colors."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=head2 ta_detect($text) => BOOL"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "Return true if C<$text> contains ANSI color codes, false otherwise."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=head2 ta_extract_codes($text) => STR"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "This is the opposite of C<ta_strip()>, return only the ANSI codes in C<$text>."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "=head2 ta_highlight($text, $needle, $color) => STR"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "Highlight the first occurrence of C<$needle> in C<$text> with <$color>, taking"
NSQ_SOURCE_LINE 00000196 "care not to mess up existing colors."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "C<$needle> can be a string or a Regexp object."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "Implementation note: to not mess up colors, we save up all color codes from the"
NSQ_SOURCE_LINE 00000201 "last reset (C<\\e[0m>) before inserting the highlight color + highlight text."
NSQ_SOURCE_LINE 00000202 "Then we issue C<\\e[0m> and the saved up color code to return back to the color"
NSQ_SOURCE_LINE 00000203 "state before the highlight is inserted. This is the same technique as described"
NSQ_SOURCE_LINE 00000204 "in C<ta_add_color_resets()>."
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=head2 ta_highlight_all($text, $needle, $color) => STR"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "Like C<ta_highlight()>, but highlight all occurrences instead of only the first."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head2 ta_length($text) => INT"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "Count the number of characters in $text, while ignoring ANSI color codes."
NSQ_SOURCE_LINE 00000213 "Equivalent to C<< length(ta_strip($text)) >>. See also: C<ta_mbswidth()> in"
NSQ_SOURCE_LINE 00000214 "L<Text::ANSI::WideUtil>."
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=head2 ta_length_height($text) => [INT, INT]"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "Like C<ta_length()>, but also gives height (number of lines). For example, C<<"
NSQ_SOURCE_LINE 00000219 "ta_length_height(\"foobar\\nb\\n\") >> gives C<[6, 3]>."
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "See also: C<ta_mbswidth_height()> in L<Text::ANSI::WideUtil>."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=head2 ta_pad($text, $width[, $which[, $padchar[, $truncate]]]) => STR"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "Return C<$text> padded with C<$padchar> to C<$width> columns. C<$which> is"
NSQ_SOURCE_LINE 00000226 "either \"r\" or \"right\" for padding on the right (the default if not specified),"
NSQ_SOURCE_LINE 00000227 "\"l\" or \"left\" for padding on the right, or \"c\" or \"center\" or \"centre\" for"
NSQ_SOURCE_LINE 00000228 "left+right padding to center the text."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "C<$padchar> is whitespace if not specified. It should be string having the width"
NSQ_SOURCE_LINE 00000231 "of 1 column."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "Does *not* handle multiline text; you can split text by C</\\r?\\n/> yourself."
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "See also: C<ta_mbpad()> in L<Text::ANSI::WideUtil>."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=head2 ta_split_codes($text) => LIST"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "Split C<$text> to a list containing alternating ANSI color codes and text. ANSI"
NSQ_SOURCE_LINE 00000240 "color codes are always on the second element, fourth, and so on. Example:"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 " ta_split_codes(\"\");              # => ()"
NSQ_SOURCE_LINE 00000243 " ta_split_codes(\"a\");             # => (\"a\")"
NSQ_SOURCE_LINE 00000244 " ta_split_codes(\"a\\e[31m\");       # => (\"a\", \"\\e[31m\")"
NSQ_SOURCE_LINE 00000245 " ta_split_codes(\"\\e[31ma\");       # => (\"\", \"\\e[31m\", \"a\")"
NSQ_SOURCE_LINE 00000246 " ta_split_codes(\"\\e[31ma\\e[0m\");  # => (\"\", \"\\e[31m\", \"a\", \"\\e[0m\")"
NSQ_SOURCE_LINE 00000247 " ta_split_codes(\"\\e[31ma\\e[0mb\"); # => (\"\", \"\\e[31m\", \"a\", \"\\e[0m\", \"b\")"
NSQ_SOURCE_LINE 00000248 " ta_split_codes(\"\\e[31m\\e[0mb\");  # => (\"\", \"\\e[31m\\e[0m\", \"b\")"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "so you can do something like:"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 " my @parts = ta_split_codes($text);"
NSQ_SOURCE_LINE 00000253 " while (my ($text, $ansicode) = splice(@parts, 0, 2)) {"
NSQ_SOURCE_LINE 00000254 "     ..."
NSQ_SOURCE_LINE 00000255 " }"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=head2 ta_split_codes_single($text) => LIST"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "Like C<ta_split_codes()> but each ANSI color code is split separately, instead"
NSQ_SOURCE_LINE 00000260 "of grouped together. This routine is currently used internally e.g. for"
NSQ_SOURCE_LINE 00000261 "C<ta_wrap()> and C<ta_highlight()> to trace color reset/replay codes."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=head2 ta_strip($text) => STR"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "Strip ANSI color codes from C<$text>, returning the stripped text."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head2 ta_substr($text, $pos, $len[ , $replacement ]) => STR"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "A bit like Perl's C<substr()>. If C<$replacement> is not specified, will return"
NSQ_SOURCE_LINE 00000270 "the substring. If C<$replacement> is specified, will return $text with the"
NSQ_SOURCE_LINE 00000271 "substring replaced by C<$replacement>."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "See also: C<ta_mbsubstr()> in L<Text::ANSI::WideUtil>."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=head2 ta_trunc($text, $width) => STR"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "Truncate C<$text> to C<$width> columns while still including all the ANSI color"
NSQ_SOURCE_LINE 00000278 "codes. This ensures that truncated text still reset colors, etc."
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "Does *not* handle multiline text; you can split text by C</\\r?\\n/> yourself."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "See also: C<ta_mbtrunc()> in L<Text::ANSI::WideUtil>."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=head2 ta_wrap($text, $width, \\%opts) => STR"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "Like L<Text::WideChar::Util>'s C<wrap()> except handles ANSI color codes."
NSQ_SOURCE_LINE 00000287 "Perform color reset at the end of each line and a color replay at the start of"
NSQ_SOURCE_LINE 00000288 "subsequent line so the text is safe for combining in a multicolumn/tabular"
NSQ_SOURCE_LINE 00000289 "layout."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "Options:"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=over"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=item * flindent => STR"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "First line indent. Currently must not contain ANSI color codes or wide"
NSQ_SOURCE_LINE 00000298 "characters."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "=item * slindent => STR"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "Subsequent line indent. Currently must not contain ANSI color codes or wide"
NSQ_SOURCE_LINE 00000303 "characters."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=item * tab_width => INT (default: 8)"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=item * pad => BOOL (default: 0)"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "If set to true, will pad each line to C<$width>. This is convenient if you need"
NSQ_SOURCE_LINE 00000310 "the lines padded, saves calls to ta_pad()."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "=item * return_stats => BOOL (default: 0)"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "If set to true, then instead of returning the wrapped string, function will"
NSQ_SOURCE_LINE 00000315 "return C<< [$wrapped, $stats] >> where C<$stats> is a hash containing some"
NSQ_SOURCE_LINE 00000316 "information like C<max_word_width>, C<min_word_width>."
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=item * keep_trailing_space => BOOL (default: 0)"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "If set to true, then trailing space that separates words will be kept at the end"
NSQ_SOURCE_LINE 00000321 "of wrapped lines. This option is useful if you want to rejoin the lines later."
NSQ_SOURCE_LINE 00000322 "Without this option set to true, wrapping this line at width=4 (quotes shown):"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 " \"some long   line\""
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "will result in:"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 " \"some\""
NSQ_SOURCE_LINE 00000329 " \"long\""
NSQ_SOURCE_LINE 00000330 " \"line\""
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "While if this option is set to true, the result will be:"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 " \"some \""
NSQ_SOURCE_LINE 00000335 " \"long \""
NSQ_SOURCE_LINE 00000336 " \"line\""
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=back"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "Performance: ~500/s on my Core i5 1.7GHz laptop for a ~1KB of text (with zero to"
NSQ_SOURCE_LINE 00000341 "moderate amount of color codes)."
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "See also: C<ta_mbwrap()> in L<Text::ANSI::WideUtil>."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=head1 FAQ"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=over 11"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "=back BEGIN_BLOCK: why_split"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "=head2 Why split functionalities of wide character and color support into multiple modules/distributions?"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "Performance (see numbers in the function description), dependency"
NSQ_SOURCE_LINE 00000354 "(L<Unicode::GCString> is used for wide character support), and overhead (loading"
NSQ_SOURCE_LINE 00000355 "Unicode::GCString)."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=over 11"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=back END_BLOCK: why_split"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=head2 How do I highlight a string case-insensitively?"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "You can currently use a regex for the C<$needle> and use the C<i> modifier."
NSQ_SOURCE_LINE 00000364 "Example:"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 " use Term::ANSIColor;"
NSQ_SOURCE_LINE 00000367 " ta_highlight($text, qr/\\b(foo)\\b/i, color(\"bold red\"));"
