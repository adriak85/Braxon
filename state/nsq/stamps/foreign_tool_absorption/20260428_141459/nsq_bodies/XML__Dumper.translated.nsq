NSQ_SOURCE_LINE 00000001 "# ============================================================"
NSQ_SOURCE_LINE 00000002 "# XML::"
NSQ_SOURCE_LINE 00000003 "#  ____                                  "
NSQ_SOURCE_LINE 00000004 "# |  _ \\ _   _ _ __ ___  _ __   ___ _ __ "
NSQ_SOURCE_LINE 00000005 "# | | | | | | | '_ ` _ \\| '_ \\ / _ \\ '__|"
NSQ_SOURCE_LINE 00000006 "# | |_| | |_| | | | | | | |_) |  __/ |   "
NSQ_SOURCE_LINE 00000007 "# |____/ \\__,_|_| |_| |_| .__/ \\___|_|   "
NSQ_SOURCE_LINE 00000008 "#                       |_|           "
NSQ_SOURCE_LINE 00000009 "# Perl module for dumping Perl objects from/to XML"
NSQ_SOURCE_LINE 00000010 "# ============================================================"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "=head1 NAME"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "XML::Dumper - Perl module for dumping Perl objects from/to XML"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "  # ===== Using an object"
NSQ_SOURCE_LINE 00000019 "  use XML::Dumper;"
NSQ_SOURCE_LINE 00000020 "  $dump = new XML::Dumper;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "  $xml  = $dump->pl2xml( $perl );"
NSQ_SOURCE_LINE 00000023 "  $perl = $dump->xml2pl( $xml );"
NSQ_SOURCE_LINE 00000024 "  $dump->pl2xml( $perl, \"my_perl_data.xml.gz\" );"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "  # ===== Using function calls"
NSQ_SOURCE_LINE 00000027 "  use XML::Dumper;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "  $xml  = pl2xml( $perl );"
NSQ_SOURCE_LINE 00000030 "  $perl = xml2pl( $xml );"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "=head1 EXTENDED SYNOPSIS"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "  use XML::Dumper;"
NSQ_SOURCE_LINE 00000035 "  my $dump = new XML::Dumper;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "  my $perl  = '';"
NSQ_SOURCE_LINE 00000038 "  my $xml   = '';"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "  # ===== Convert Perl code to XML"
NSQ_SOURCE_LINE 00000041 "  $perl = ["
NSQ_SOURCE_LINE 00000042 "    {"
NSQ_SOURCE_LINE 00000043 "\t\tfname       => 'Fred',"
NSQ_SOURCE_LINE 00000044 "\t\tlname       => 'Flintstone',"
NSQ_SOURCE_LINE 00000045 "\t\tresidence   => 'Bedrock'"
NSQ_SOURCE_LINE 00000046 "    },"
NSQ_SOURCE_LINE 00000047 "    {"
NSQ_SOURCE_LINE 00000048 "\t\tfname       => 'Barney',"
NSQ_SOURCE_LINE 00000049 "\t\tlname       => 'Rubble',"
NSQ_SOURCE_LINE 00000050 "\t\tresidence   => 'Bedrock'"
NSQ_SOURCE_LINE 00000051 "    }"
NSQ_SOURCE_LINE 00000052 "  ];"
NSQ_SOURCE_LINE 00000053 "  $xml = $dump->pl2xml( $perl );"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "  # ===== Dump to a file"
NSQ_SOURCE_LINE 00000056 "  my $file = \"dump.xml\";"
NSQ_SOURCE_LINE 00000057 "  $dump->pl2xml( $perl, $file );"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "  # ===== Convert XML to Perl code"
NSQ_SOURCE_LINE 00000060 "  $xml = q|"
NSQ_SOURCE_LINE 00000061 "  <perldata>"
NSQ_SOURCE_LINE 00000062 "   <arrayref>"
NSQ_SOURCE_LINE 00000063 "    <item key=\"0\">"
NSQ_SOURCE_LINE 00000064 "     <hashref>"
NSQ_SOURCE_LINE 00000065 "  \t<item key=\"fname\">Fred</item>"
NSQ_SOURCE_LINE 00000066 "  \t<item key=\"lname\">Flintstone</item>"
NSQ_SOURCE_LINE 00000067 "  \t<item key=\"residence\">Bedrock</item>"
NSQ_SOURCE_LINE 00000068 "     </hashref>"
NSQ_SOURCE_LINE 00000069 "    </item>"
NSQ_SOURCE_LINE 00000070 "    <item key=\"1\">"
NSQ_SOURCE_LINE 00000071 "     <hashref>"
NSQ_SOURCE_LINE 00000072 "  \t<item key=\"fname\">Barney</item>"
NSQ_SOURCE_LINE 00000073 "  \t<item key=\"lname\">Rubble</item>"
NSQ_SOURCE_LINE 00000074 "  \t<item key=\"residence\">Bedrock</item>"
NSQ_SOURCE_LINE 00000075 "     </hashref>"
NSQ_SOURCE_LINE 00000076 "    </item>"
NSQ_SOURCE_LINE 00000077 "   </arrayref>"
NSQ_SOURCE_LINE 00000078 "  </perldata>"
NSQ_SOURCE_LINE 00000079 "  |;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "  my $perl = $dump->xml2pl( $xml );"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "  # ===== Convert an XML file to Perl code"
NSQ_SOURCE_LINE 00000084 "  my $perl = $dump->xml2pl( $file );"
NSQ_SOURCE_LINE 00000085 "  "
NSQ_SOURCE_LINE 00000086 "  # ===== And serialize Perl code to an XML file"
NSQ_SOURCE_LINE 00000087 "  $dump->pl2xml( $perl, $file );"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "  # ===== USE COMPRESSION"
NSQ_SOURCE_LINE 00000090 "  $dump->pl2xml( $perl, $file.\".gz\" );"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "  # ===== INCLUDE AN IN-DOCUMENT DTD"
NSQ_SOURCE_LINE 00000093 "  $dump->dtd;"
NSQ_SOURCE_LINE 00000094 "  my $xml_with_dtd = $dump->pl2xml( $perl );"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "  # ===== USE EXTERNAL DTD"
NSQ_SOURCE_LINE 00000097 "  $dump->dtd( $file, $url );"
NSQ_SOURCE_LINE 00000098 "  my $xml_with_link_to_dtd = $dump->pl2xml( $perl );"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "XML::Dumper dumps Perl data to XML format. XML::Dumper can also read XML data "
NSQ_SOURCE_LINE 00000103 "that was previously dumped by the module and convert it back to Perl. You can"
NSQ_SOURCE_LINE 00000104 "use the module read the XML from a file and write the XML to a file. Perl"
NSQ_SOURCE_LINE 00000105 "objects are blessed back to their original packaging; if the modules are"
NSQ_SOURCE_LINE 00000106 "installed on the system where the perl objects are reconstituted from xml, they"
NSQ_SOURCE_LINE 00000107 "will behave as expected. Intuitively, if the perl objects are converted and"
NSQ_SOURCE_LINE 00000108 "reconstituted in the same environment, all should be well. And it is."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "Additionally, because XML benefits so nicely from compression, XML::Dumper"
NSQ_SOURCE_LINE 00000111 "understands gzipped XML files. It does so with an optional dependency on"
NSQ_SOURCE_LINE 00000112 "Compress::Zlib. So, if you dump a Perl variable with a file that has an"
NSQ_SOURCE_LINE 00000113 "extension of '.xml.gz', it will store and compress the file in gzipped format."
NSQ_SOURCE_LINE 00000114 "Likewise, if you read a file with the extension '.xml.gz', it will uncompress"
NSQ_SOURCE_LINE 00000115 "the file in memory before parsing the XML back into a Perl variable."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "Another fine challenge that this module rises to meet is that it understands"
NSQ_SOURCE_LINE 00000118 "circular definitions and multiple references to a single object. This includes "
NSQ_SOURCE_LINE 00000119 "doubly-linked lists, circular references, and the so-called 'Flyweight' pattern of "
NSQ_SOURCE_LINE 00000120 "Object Oriented programming. So it can take the gnarliest of your perl data, and "
NSQ_SOURCE_LINE 00000121 "should do just fine."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "One caveat; XML::Dumper does not handle binary data. There have been"
NSQ_SOURCE_LINE 00000124 "discussions in the expat mailing list archives discussing the challenges"
NSQ_SOURCE_LINE 00000125 "associated with encoding binary data with XML. I chose the cowardly path"
NSQ_SOURCE_LINE 00000126 "of making the problem a non-issue by not addressing it. To store binary"
NSQ_SOURCE_LINE 00000127 "data, one could encode the data into ASCII before encapsulating the data"
NSQ_SOURCE_LINE 00000128 "as XML, and then reverse the process to restore the data. There are several"
NSQ_SOURCE_LINE 00000129 "Perl modules that one can use for this, Convert::UU, for example. "
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=head2 FUNCTIONS AND METHODS"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=over 4"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=cut"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "package XML::Dumper;"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "require 5.005_62;"
NSQ_SOURCE_LINE 00000140 "use strict;"
NSQ_SOURCE_LINE 00000141 "use warnings;"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "require Exporter;"
NSQ_SOURCE_LINE 00000144 "use XML::Parser;"
NSQ_SOURCE_LINE 00000145 "use overload;"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "our @ISA = qw( Exporter );"
NSQ_SOURCE_LINE 00000148 "our %EXPORT_TAGS = ( );"
NSQ_SOURCE_LINE 00000149 "our @EXPORT_OK = ( );"
NSQ_SOURCE_LINE 00000150 "our @EXPORT = qw( xml2pl pl2xml xml_compare xml_identity );"
NSQ_SOURCE_LINE 00000151 "our $VERSION = '0.81'; "
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "our $COMPRESSION_AVAILABLE;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "BEGIN {"
NSQ_SOURCE_LINE 00000156 "\teval { require Compress::Zlib; };"
NSQ_SOURCE_LINE 00000157 "\tif( $@ ) {"
NSQ_SOURCE_LINE 00000158 "\t\t$COMPRESSION_AVAILABLE = 0;"
NSQ_SOURCE_LINE 00000159 "\t} else {"
NSQ_SOURCE_LINE 00000160 "\t\t$COMPRESSION_AVAILABLE = 1;"
NSQ_SOURCE_LINE 00000161 "\t}"
NSQ_SOURCE_LINE 00000162 "}"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "our $dump = new XML::Dumper;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "# ============================================================"
NSQ_SOURCE_LINE 00000167 "sub new {"
NSQ_SOURCE_LINE 00000168 "# ============================================================"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "=item * new() - XML::Dumper constructor. "
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "Creates a lean, mean, XML dumping machine. It's also completely "
NSQ_SOURCE_LINE 00000173 "at your disposal."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=cut"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "# ------------------------------------------------------------"
NSQ_SOURCE_LINE 00000178 "    my ($class) = map { ref || $_ } shift;"
NSQ_SOURCE_LINE 00000179 "    my $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "\t$self->init( @_ );"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    return $self;"
NSQ_SOURCE_LINE 00000184 "}"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "# ============================================================"
NSQ_SOURCE_LINE 00000187 "sub init {"
NSQ_SOURCE_LINE 00000188 "# ============================================================"
NSQ_SOURCE_LINE 00000189 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000190 "\t$self->{ perldata }          = {};"
NSQ_SOURCE_LINE 00000191 "\t$self->{ xml }               = {};"
NSQ_SOURCE_LINE 00000192 "\t$self->{ xml_parser_params } = { @_ };"
NSQ_SOURCE_LINE 00000193 "\t1;"
NSQ_SOURCE_LINE 00000194 "}"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "# ============================================================"
NSQ_SOURCE_LINE 00000197 "sub dtd {"
NSQ_SOURCE_LINE 00000198 "# ============================================================"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=item * dtd -"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "Generates a Document Type Dictionary for the 'perldata' data"
NSQ_SOURCE_LINE 00000203 "type. The default behaviour is to embed the DTD in the XML,"
NSQ_SOURCE_LINE 00000204 "thereby creating valid XML. Given a filename, the DTD will be"
NSQ_SOURCE_LINE 00000205 "written out to that file and the XML document for your Perl data "
NSQ_SOURCE_LINE 00000206 "will link to the file. Given a filename and an URL, the DTD will"
NSQ_SOURCE_LINE 00000207 "be written out the file and the XML document will link to the URL."
NSQ_SOURCE_LINE 00000208 "XML::Dumper doesn't try really hard to determine where your DTD's"
NSQ_SOURCE_LINE 00000209 "ought to go or relative paths or anything, so be careful with"
NSQ_SOURCE_LINE 00000210 "what arguments you supply this method, or just go with the default"
NSQ_SOURCE_LINE 00000211 "with the embedded DTD. Between DTD's and Schemas, the potential"
NSQ_SOURCE_LINE 00000212 "for more free-form data to be imported and exported becomes"
NSQ_SOURCE_LINE 00000213 "feasible."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "Usage:"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "  dtd();\t\t\t\t# Causes XML to include embedded DTD"
NSQ_SOURCE_LINE 00000218 "  dtd( $file );\t\t\t# DTD saved to $file; XML will link to $file"
NSQ_SOURCE_LINE 00000219 "  dtd( $file, $url );\t# DTD saved to $file; XML will link to $url"
NSQ_SOURCE_LINE 00000220 "  dtd( 0 );\t\t\t\t# Prevents XML from including embedded DTD"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=cut"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "# ------------------------------------------------------------"
NSQ_SOURCE_LINE 00000225 "\tmy $self = ( ref $_[0] && (ref $_[0]) =~ /XML::Dumper/ ) ? shift : $dump;"
NSQ_SOURCE_LINE 00000226 "\tmy $file = shift;"
NSQ_SOURCE_LINE 00000227 "\tmy $url = shift;"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "\tmy $dtd = qq{<!ELEMENT scalar (#PCDATA)>"
NSQ_SOURCE_LINE 00000230 "<!ELEMENT scalarref (#PCDATA)>"
NSQ_SOURCE_LINE 00000231 "<!ATTLIST scalarref "
NSQ_SOURCE_LINE 00000232 "\tblessed_package CDATA #IMPLIED"
NSQ_SOURCE_LINE 00000233 " \tmemory_address CDATA #IMPLIED>"
NSQ_SOURCE_LINE 00000234 "<!ELEMENT arrayref (item*)>"
NSQ_SOURCE_LINE 00000235 "<!ATTLIST arrayref "
NSQ_SOURCE_LINE 00000236 "\tblessed_package CDATA #IMPLIED"
NSQ_SOURCE_LINE 00000237 " \tmemory_address CDATA #IMPLIED>"
NSQ_SOURCE_LINE 00000238 "<!ELEMENT hashref (item*)>"
NSQ_SOURCE_LINE 00000239 "<!ATTLIST hashref "
NSQ_SOURCE_LINE 00000240 "\tblessed_package CDATA #IMPLIED"
NSQ_SOURCE_LINE 00000241 " \tmemory_address CDATA #IMPLIED>"
NSQ_SOURCE_LINE 00000242 "<!ELEMENT item (#PCDATA|scalar|scalarref|arrayref|hashref)*>"
NSQ_SOURCE_LINE 00000243 "<!ATTLIST item "
NSQ_SOURCE_LINE 00000244 "\tkey CDATA #REQUIRED"
NSQ_SOURCE_LINE 00000245 "\tdefined CDATA #IMPLIED>"
NSQ_SOURCE_LINE 00000246 "<!ELEMENT perldata (scalar|scalarref|arrayref|hashref)*>"
NSQ_SOURCE_LINE 00000247 "};"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "\tif( defined $file && $file ) {"
NSQ_SOURCE_LINE 00000250 "\t\topen DTD, \">$file\" or die $!;"
NSQ_SOURCE_LINE 00000251 "\t\tprint DTD $dtd;"
NSQ_SOURCE_LINE 00000252 "\t\tclose DTD;"
NSQ_SOURCE_LINE 00000253 "\t\t$url = defined $url ? $url : $file;"
NSQ_SOURCE_LINE 00000254 "\t\t$self->{ dtd } = qq{"
NSQ_SOURCE_LINE 00000255 "<!DOCTYPE perldata SYSTEM \"$url\">"
NSQ_SOURCE_LINE 00000256 "};"
NSQ_SOURCE_LINE 00000257 "\t} elsif( not defined $file ) {"
NSQ_SOURCE_LINE 00000258 "\t\t$self->{ dtd } = join( \"\\n\", "
NSQ_SOURCE_LINE 00000259 "\t\t\t\"<?xml version=\\\"1.0\\\"?>\","
NSQ_SOURCE_LINE 00000260 "\t\t\t\"<!DOCTYPE perldata [\","
NSQ_SOURCE_LINE 00000261 "\t\t\t( map { /^\\t/ ? $_ : \"  $_\" } split /\\n/, $dtd ),"
NSQ_SOURCE_LINE 00000262 "\t\t\t']>',"
NSQ_SOURCE_LINE 00000263 "\t\t\t'');"
NSQ_SOURCE_LINE 00000264 "\t} else {"
NSQ_SOURCE_LINE 00000265 "\t\tdelete $self->{ dtd };"
NSQ_SOURCE_LINE 00000266 "\t\treturn;"
NSQ_SOURCE_LINE 00000267 "\t}"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "\t$self->{ dtd };"
NSQ_SOURCE_LINE 00000270 "}"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "# ============================================================"
NSQ_SOURCE_LINE 00000273 "sub dump {"
NSQ_SOURCE_LINE 00000274 "# ============================================================"
NSQ_SOURCE_LINE 00000275 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000276 "\tmy $ref = shift;"
NSQ_SOURCE_LINE 00000277 "\tmy $indent = shift;"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "    my $string = '';"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "\t# ===== HANDLE REFERENCE DUMPING"
NSQ_SOURCE_LINE 00000282 "\tif( ref $ref ) {"
NSQ_SOURCE_LINE 00000283 "\t\tno warnings;"
NSQ_SOURCE_LINE 00000284 "\t\tlocal $_ = ref( $ref );"
NSQ_SOURCE_LINE 00000285 "\t\tmy $class = '';"
NSQ_SOURCE_LINE 00000286 "\t\tmy $address = '';"
NSQ_SOURCE_LINE 00000287 "\t\tmy $reused = '';"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "\t\t# ===== HANDLE THE VARIETY OF THINGS A PERL REFERENCE CAN REFER TO"
NSQ_SOURCE_LINE 00000290 "\t\tREFERENCE: {"
NSQ_SOURCE_LINE 00000291 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000292 "\t\t\tOBJECT: {"
NSQ_SOURCE_LINE 00000293 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000294 "\t\t\t\tlast OBJECT if /^(?:SCALAR|HASH|ARRAY)$/;"
NSQ_SOURCE_LINE 00000295 "\t\t\t\t$class = $_;"
NSQ_SOURCE_LINE 00000296 "\t\t\t\t$class = xml_escape( $class );"
NSQ_SOURCE_LINE 00000297 "\t\t\t\t($_,$address) = overload::StrVal( $ref ) =~ /$class=([^(]+)\\(([x0-9A-Fa-f]+)\\)/;"
NSQ_SOURCE_LINE 00000298 "\t\t\t}"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000301 "\t\t\tHAS_MEMORY_ADDRESS: {"
NSQ_SOURCE_LINE 00000302 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000303 "\t\t\t# References which refer to the same memory space point to the "
NSQ_SOURCE_LINE 00000304 "\t\t\t# same thing"
NSQ_SOURCE_LINE 00000305 "\t\t\t\tlast HAS_MEMORY_ADDRESS if( $class );"
NSQ_SOURCE_LINE 00000306 "\t\t\t\t($_,$address) = overload::StrVal( $ref ) =~ /([^(]+)\\(([x0-9A-Fa-f]+)\\)/;"
NSQ_SOURCE_LINE 00000307 "\t\t\t}"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "\t\t\t$reused = exists( $self->{ xml }{ $address } );"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000312 "\t\t\tif( /^SCALAR$/ ) {"
NSQ_SOURCE_LINE 00000313 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000314 "\t\t\t\tmy $type = "
NSQ_SOURCE_LINE 00000315 "\t\t\t\t\t\"<scalarref\". "
NSQ_SOURCE_LINE 00000316 "\t\t\t\t\t($class ? \" blessed_package=\\\"$class\\\"\" : '' ) . "
NSQ_SOURCE_LINE 00000317 "\t\t\t\t\t($address ? \" memory_address=\\\"$address\\\"\" : '' ) ."
NSQ_SOURCE_LINE 00000318 "\t\t\t\t\t( defined $$ref ? '' : \" defined=\\\"false\\\"\" ) ."
NSQ_SOURCE_LINE 00000319 "\t\t\t\t\t\">\";"
NSQ_SOURCE_LINE 00000320 "\t\t\t\t$self->{ xml }{ $address }++ if( $address );"
NSQ_SOURCE_LINE 00000321 "\t\t\t\t$string = \"\\n\" . \" \" x $indent .  $type . ($reused ? '' : xml_escape($$ref)) . \"</scalarref>\";"
NSQ_SOURCE_LINE 00000322 "\t\t\t\tlast REFERENCE;"
NSQ_SOURCE_LINE 00000323 "\t\t\t}"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000326 "\t\t\tif( /^HASH$/ ) {"
NSQ_SOURCE_LINE 00000327 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000328 "\t\t\t\t$self->{ xml }{ $address }++ if( $address );"
NSQ_SOURCE_LINE 00000329 "\t\t\t\tmy $type = "
NSQ_SOURCE_LINE 00000330 "\t\t\t\t\t\"<hashref\". "
NSQ_SOURCE_LINE 00000331 "\t\t\t\t\t($class ? \" blessed_package=\\\"$class\\\"\" : '' ). "
NSQ_SOURCE_LINE 00000332 "\t\t\t\t\t($address && $self->{ xml }{ $address } ? \" memory_address=\\\"$address\\\"\" : '' )."
NSQ_SOURCE_LINE 00000333 "\t\t\t\t\t\">\";"
NSQ_SOURCE_LINE 00000334 "\t\t\t\t$string = \"\\n\" . \" \" x $indent . $type;"
NSQ_SOURCE_LINE 00000335 "\t\t\t\tif( not $reused ) {"
NSQ_SOURCE_LINE 00000336 "\t\t\t\t\t$indent++;"
NSQ_SOURCE_LINE 00000337 "\t\t\t\t\tforeach my $key (sort keys(%$ref)) {"
NSQ_SOURCE_LINE 00000338 "\t\t\t\t\t\tmy $type ="
NSQ_SOURCE_LINE 00000339 "\t\t\t\t\t\t\t\"<item \" ."
NSQ_SOURCE_LINE 00000340 "\t\t\t\t\t\t\t\"key=\\\"\" . xml_escape( $key ) . \"\\\"\" ."
NSQ_SOURCE_LINE 00000341 "\t\t\t\t\t\t\t( defined $ref->{ $key } ? '' : \" defined=\\\"false\\\"\" ) ."
NSQ_SOURCE_LINE 00000342 "\t\t\t\t\t\t\t\">\";"
NSQ_SOURCE_LINE 00000343 "\t\t\t\t\t\t$string .= \"\\n\" . \" \" x $indent . $type;"
NSQ_SOURCE_LINE 00000344 "\t\t\t\t\t\tif (ref($ref->{$key})) {"
NSQ_SOURCE_LINE 00000345 "\t\t\t\t\t\t\t$string .= $self->dump( $ref->{$key}, $indent+1);"
NSQ_SOURCE_LINE 00000346 "\t\t\t\t\t\t\t$string .= \"\\n\" . \" \" x $indent . \"</item>\";"
NSQ_SOURCE_LINE 00000347 "\t\t\t\t\t\t} else {"
NSQ_SOURCE_LINE 00000348 "\t\t\t\t\t\t\t$string .= xml_escape($ref->{$key}) . \"</item>\";"
NSQ_SOURCE_LINE 00000349 "\t\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000350 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000351 "\t\t\t\t\t$indent--;"
NSQ_SOURCE_LINE 00000352 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000353 "\t\t\t\t$string .= \"\\n\" . \" \" x $indent . \"</hashref>\";"
NSQ_SOURCE_LINE 00000354 "\t\t\t\tlast REFERENCE;"
NSQ_SOURCE_LINE 00000355 "\t\t\t}"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000358 "\t\t\tif( /^ARRAY$/ ) {"
NSQ_SOURCE_LINE 00000359 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000360 "\t\t\t\tmy $type = "
NSQ_SOURCE_LINE 00000361 "\t\t\t\t\t\"<arrayref\". "
NSQ_SOURCE_LINE 00000362 "\t\t\t\t\t($class ? \" blessed_package=\\\"$class\\\"\" : '' ). "
NSQ_SOURCE_LINE 00000363 "\t\t\t\t\t($address ? \" memory_address=\\\"$address\\\"\" : '' )."
NSQ_SOURCE_LINE 00000364 "\t\t\t\t\t\">\";"
NSQ_SOURCE_LINE 00000365 "\t\t\t\t$string .= \"\\n\" . \" \" x $indent . $type;"
NSQ_SOURCE_LINE 00000366 "\t\t\t\t$self->{ xml }{ $address }++ if( $address );"
NSQ_SOURCE_LINE 00000367 "\t\t\t\tif( not $reused ) {"
NSQ_SOURCE_LINE 00000368 "\t\t\t\t\t$indent++;"
NSQ_SOURCE_LINE 00000369 "\t\t\t\t\tfor (my $i=0; $i < @$ref; $i++) {"
NSQ_SOURCE_LINE 00000370 "\t\t\t\t\t\tmy $defined;"
NSQ_SOURCE_LINE 00000371 "\t\t\t\t\t\tmy $type ="
NSQ_SOURCE_LINE 00000372 "\t\t\t\t\t\t\t\"<item \" ."
NSQ_SOURCE_LINE 00000373 "\t\t\t\t\t\t\t\"key=\\\"\" . xml_escape( $i ) . \"\\\"\" ."
NSQ_SOURCE_LINE 00000374 "\t\t\t\t\t\t\t( defined $ref->[ $i ] ? '' : \" defined=\\\"false\\\"\" ) ."
NSQ_SOURCE_LINE 00000375 "\t\t\t\t\t\t\t\">\";"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "\t\t\t\t\t\t$string .= \"\\n\" . \" \" x $indent . $type;"
NSQ_SOURCE_LINE 00000378 "\t\t\t\t\t\tif (ref($ref->[$i])) {"
NSQ_SOURCE_LINE 00000379 "\t\t\t\t\t\t\t$string .= $self->dump($ref->[$i], $indent+1);"
NSQ_SOURCE_LINE 00000380 "\t\t\t\t\t\t\t$string .= \"\\n\" . \" \" x $indent . \"</item>\";"
NSQ_SOURCE_LINE 00000381 "\t\t\t\t\t\t} else {"
NSQ_SOURCE_LINE 00000382 "\t\t\t\t\t\t\t$string .= xml_escape($ref->[$i]) . \"</item>\";"
NSQ_SOURCE_LINE 00000383 "\t\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000384 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000385 "\t\t\t\t\t$indent--;"
NSQ_SOURCE_LINE 00000386 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000387 "\t\t\t\t$string .= \"\\n\" . \" \" x $indent . \"</arrayref>\";"
NSQ_SOURCE_LINE 00000388 "\t\t\t\tlast REFERENCE;"
NSQ_SOURCE_LINE 00000389 "\t\t\t}"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "\t\t}"
NSQ_SOURCE_LINE 00000392 "    "
NSQ_SOURCE_LINE 00000393 "    # ===== HANDLE SCALAR DUMPING"
NSQ_SOURCE_LINE 00000394 "    } else {"
NSQ_SOURCE_LINE 00000395 "\t\tmy $type = "
NSQ_SOURCE_LINE 00000396 "\t\t\t\"<scalar\". "
NSQ_SOURCE_LINE 00000397 "\t\t\t( defined $ref ? '' : \" defined=\\\"false\\\"\" ) ."
NSQ_SOURCE_LINE 00000398 "\t\t\t\">\";"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "\t\t$string .= \"\\n\" . \" \" x $indent . $type . xml_escape( $ref ) . \"</scalar>\";"
NSQ_SOURCE_LINE 00000401 "    }"
NSQ_SOURCE_LINE 00000402 "    "
NSQ_SOURCE_LINE 00000403 "    return( $string );"
NSQ_SOURCE_LINE 00000404 "}"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "# ============================================================"
NSQ_SOURCE_LINE 00000407 "sub perl2xml {"
NSQ_SOURCE_LINE 00000408 "# ============================================================"
NSQ_SOURCE_LINE 00000409 "\tpl2xml( @_ );"
NSQ_SOURCE_LINE 00000410 "}"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "# ============================================================"
NSQ_SOURCE_LINE 00000413 "sub pl2xml {"
NSQ_SOURCE_LINE 00000414 "# ============================================================"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "=item * pl2xml( $xml, [ $file ] ) -"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "(Also perl2xml(), for those who enjoy readability over brevity)."
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "Converts Perl data to XML. If a second argument is given, then the Perl data"
NSQ_SOURCE_LINE 00000421 "will be stored to disk as XML, using the second argument as a filename."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "Usage: See Synopsis"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "=cut"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "# ------------------------------------------------------------"
NSQ_SOURCE_LINE 00000428 "\tmy $self = ( ref $_[0] && (ref $_[0]) =~ /XML::Dumper/ ) ? shift : $dump;"
NSQ_SOURCE_LINE 00000429 "\tmy $ref = shift;"
NSQ_SOURCE_LINE 00000430 "\tmy $file = shift;"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "\t$self->init;"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "\tmy $xml = "
NSQ_SOURCE_LINE 00000435 " \t\t( defined $self->{ dtd } ? $self->{ dtd } : '' ) ."
NSQ_SOURCE_LINE 00000436 "\t\t\"<perldata>\" . $self->dump( $ref, 1 ) . \"\\n</perldata>\\n\";"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "\tif( defined $file ) { "
NSQ_SOURCE_LINE 00000439 "\t\tif( $file =~ /\\.xml\\.gz$/i ) {"
NSQ_SOURCE_LINE 00000440 "\t\t\tif( $COMPRESSION_AVAILABLE ) {"
NSQ_SOURCE_LINE 00000441 "\t\t\t\tmy $compressed_xml = Compress::Zlib::memGzip( $xml ) or die \"Failed to compress xml $!\";"
NSQ_SOURCE_LINE 00000442 "\t\t\t\topen FILE, \">:utf8\", $file or die \"Can't open '$file' for writing $!\";"
NSQ_SOURCE_LINE 00000443 "\t\t\t\tbinmode FILE;"
NSQ_SOURCE_LINE 00000444 "\t\t\t\tprint FILE $compressed_xml;"
NSQ_SOURCE_LINE 00000445 "\t\t\t\tclose FILE;"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "\t\t\t} else {"
NSQ_SOURCE_LINE 00000448 "\t\t\t\tmy $uncompressed_file = $file;"
NSQ_SOURCE_LINE 00000449 "\t\t\t\t$uncompressed_file =~ s/\\.gz$//i;"
NSQ_SOURCE_LINE 00000450 "\t\t\t\twarn \"Compress::Zlib not installed. Saving '$file' as '$uncompressed_file'\\n\";"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "\t\t\t\topen FILE, \">:utf8\", $uncompressed_file or die \"Can't open '$uncompressed_file' for writing $!\";"
NSQ_SOURCE_LINE 00000453 "\t\t\t\tprint FILE $xml;"
NSQ_SOURCE_LINE 00000454 "\t\t\t\tclose FILE;"
NSQ_SOURCE_LINE 00000455 "\t\t\t}"
NSQ_SOURCE_LINE 00000456 "\t\t} else {"
NSQ_SOURCE_LINE 00000457 "\t\t\tno warnings; # to shut Perl up about Wide characters for UTF8 output"
NSQ_SOURCE_LINE 00000458 "\t\t\topen FILE, \">$file\" or die \"Can't open '$file' for writing $!\";"
NSQ_SOURCE_LINE 00000459 "\t\t\tprint FILE $xml;"
NSQ_SOURCE_LINE 00000460 "\t\t\tclose FILE;"
NSQ_SOURCE_LINE 00000461 "\t\t}"
NSQ_SOURCE_LINE 00000462 "\t}"
NSQ_SOURCE_LINE 00000463 "\treturn $xml;"
NSQ_SOURCE_LINE 00000464 "}"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "# ============================================================"
NSQ_SOURCE_LINE 00000467 "sub undump {"
NSQ_SOURCE_LINE 00000468 "# ============================================================"
NSQ_SOURCE_LINE 00000469 "# undump"
NSQ_SOURCE_LINE 00000470 "# Takes the XML generated by pl2xml, and recursively undumps it to "
NSQ_SOURCE_LINE 00000471 "# create a data structure in memory.  The top-level object is a scalar, "
NSQ_SOURCE_LINE 00000472 "# a reference to a scalar, a hash, or an array. Hashes and arrays may "
NSQ_SOURCE_LINE 00000473 "# themselves contain scalars, or references to scalars, or references to "
NSQ_SOURCE_LINE 00000474 "# hashes or arrays, with the exception that scalar values are never "
NSQ_SOURCE_LINE 00000475 "# \"undef\" because there's currently no way to represent undef in the "
NSQ_SOURCE_LINE 00000476 "# dumped data."
NSQ_SOURCE_LINE 00000477 "#"
NSQ_SOURCE_LINE 00000478 "# The key to understanding undump is to understand XML::Parser's"
NSQ_SOURCE_LINE 00000479 "# Tree parsing format:"
NSQ_SOURCE_LINE 00000480 "#"
NSQ_SOURCE_LINE 00000481 "# <tag name>, [ { <attributes }, '0', <[text]>, <[children tag-array pair value(s)]...> ]"
NSQ_SOURCE_LINE 00000482 "# ------------------------------------------------------------"
NSQ_SOURCE_LINE 00000483 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000484 "    my $tree = shift;"
NSQ_SOURCE_LINE 00000485 "\tmy $callback = shift;"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "    my $ref = undef;"
NSQ_SOURCE_LINE 00000488 "    my $item;"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "\t# make Perl stop whining about deep recursion and soft references"
NSQ_SOURCE_LINE 00000491 "\tno warnings; "
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "    TREE: for (my $i = 1; $i < $#$tree; $i+=2) {\t\t"
NSQ_SOURCE_LINE 00000494 "\t\tlocal $_ = lc( $tree->[ $i ] );"
NSQ_SOURCE_LINE 00000495 "\t\tmy $class = '';"
NSQ_SOURCE_LINE 00000496 "\t\tmy $address = '';"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "\t\tPERL_TYPES: {"
NSQ_SOURCE_LINE 00000499 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000500 "\t\t\tif( /^scalar$/ ) {"
NSQ_SOURCE_LINE 00000501 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000502 "\t\t\t    $ref = defined $tree->[ $i+1 ][ 2 ] ? $tree->[ $i +1 ][ 2 ] : '';"
NSQ_SOURCE_LINE 00000503 "\t\t\t\tif( exists $tree->[ $i+1 ][ 0 ]{ 'defined' } ) {"
NSQ_SOURCE_LINE 00000504 "\t\t\t\t\tif( $tree->[ $i +1 ][ 0 ]{ 'defined' } =~ /false/i ) {"
NSQ_SOURCE_LINE 00000505 "\t\t\t\t\t\t$ref = undef;"
NSQ_SOURCE_LINE 00000506 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000507 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000508 "\t\t\t    last TREE;"
NSQ_SOURCE_LINE 00000509 "\t\t\t}"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "\t\t\t# ===== FIND PACKAGE"
NSQ_SOURCE_LINE 00000512 "\t\t\tif( $tree->[ $i+1 ] && ref( $tree->[ $i +1 ] ) eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000513 "\t\t\t\tif( exists $tree->[ $i+1 ][0]{ blessed_package } ) {"
NSQ_SOURCE_LINE 00000514 "\t\t\t\t\t$class = $tree->[ $i+1 ][ 0 ]{ blessed_package };"
NSQ_SOURCE_LINE 00000515 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000516 "\t\t\t}"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "\t\t\t# ===== FIND MEMORY ADDRESS"
NSQ_SOURCE_LINE 00000519 "\t\t\tif( $tree->[ $i+1 ] && ref( $tree->[ $i +1 ] ) eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000520 "\t\t\t\tif( exists $tree->[ $i+1 ][0]{ memory_address } ) {"
NSQ_SOURCE_LINE 00000521 "\t\t\t\t\t$address = $tree->[ $i+1 ][ 0 ]{ memory_address };"
NSQ_SOURCE_LINE 00000522 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000523 "\t\t\t}"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "\t\t\tALREADY_EXISTS_IN_MEMORY: {"
NSQ_SOURCE_LINE 00000526 "\t\t\t\tif( exists $self->{ perldata }{ $address } ) {"
NSQ_SOURCE_LINE 00000527 "\t\t\t\t\t$ref = $self->{ perldata }{ $address };"
NSQ_SOURCE_LINE 00000528 "\t\t\t\t\tlast TREE;"
NSQ_SOURCE_LINE 00000529 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000530 "\t\t\t}"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000533 "\t\t\tif( /^scalarref/ ) {"
NSQ_SOURCE_LINE 00000534 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000535 "\t\t\t    $ref = defined $tree->[ $i+1 ][ 2 ] ? \\ $tree->[ $i +1 ][ 2 ] : \\'';"
NSQ_SOURCE_LINE 00000536 "\t\t\t\tif( exists $tree->[ $i+1 ][ 0 ]{ 'defined' } ) {"
NSQ_SOURCE_LINE 00000537 "\t\t\t\t\tif( $tree->[ $i +1 ][ 0 ]{ 'defined' } =~ /false/i ) {"
NSQ_SOURCE_LINE 00000538 "\t\t\t\t\t\t$ref = \\ undef;"
NSQ_SOURCE_LINE 00000539 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000540 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "\t\t\t\t$self->{ perldata }{ $address } = $ref if( $address );"
NSQ_SOURCE_LINE 00000543 "\t\t\t\tif( $class ) {"
NSQ_SOURCE_LINE 00000544 "\t\t\t\t\t# Check class name for nasty stuff..."
NSQ_SOURCE_LINE 00000545 "\t\t\t\t\t$class =~ m/^[\\w-]+(?:::[\\w-]+)*$/"
NSQ_SOURCE_LINE 00000546 "\t\t\t\t\t\tor die \"Refusing to load unsafe class name '$class'\\n\";"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "\t\t\t\t\tunless( int( eval( \"\\%$class\".\"::\")) ) {"
NSQ_SOURCE_LINE 00000549 "\t\t\t\t\t\teval \"require $class;\";"
NSQ_SOURCE_LINE 00000550 "\t\t\t\t\t\tif( $@ ) {"
NSQ_SOURCE_LINE 00000551 "\t\t\t\t\t\t\twarn $@;"
NSQ_SOURCE_LINE 00000552 "\t\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000553 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000554 "\t\t\t\t\t"
NSQ_SOURCE_LINE 00000555 "\t\t\t\t\tbless $ref, $class;"
NSQ_SOURCE_LINE 00000556 "\t\t\t\t\tif( defined $callback && $ref->can( $callback ) ) {"
NSQ_SOURCE_LINE 00000557 "\t\t\t\t\t\t$ref->$callback();"
NSQ_SOURCE_LINE 00000558 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000559 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000560 "\t\t\t\tlast TREE;"
NSQ_SOURCE_LINE 00000561 "\t\t\t}"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000564 "\t\t\tif( /^hash(?:ref)?/ ) {"
NSQ_SOURCE_LINE 00000565 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000566 "\t\t\t\t$ref = {};"
NSQ_SOURCE_LINE 00000567 "\t\t\t\t$self->{ perldata }{ $address } = $ref if( $address );"
NSQ_SOURCE_LINE 00000568 "\t\t\t\tfor (my $j = 1; $j < $#{$tree->[$i+1]}; $j+=2) {"
NSQ_SOURCE_LINE 00000569 "\t\t\t\t\tnext unless $tree->[$i+1][$j] eq 'item';"
NSQ_SOURCE_LINE 00000570 "\t\t\t\t\tmy $item_tree = $tree->[$i+1][$j+1];"
NSQ_SOURCE_LINE 00000571 "\t\t\t\t\tif( exists $item_tree->[0]{ key } ) {"
NSQ_SOURCE_LINE 00000572 "\t\t\t\t\t\tmy $key = $item_tree->[ 0 ]{ key };"
NSQ_SOURCE_LINE 00000573 "\t\t\t\t\t\tif( exists $item_tree->[ 0 ]{ 'defined' } ) {"
NSQ_SOURCE_LINE 00000574 "\t\t\t\t\t\t\tif( $item_tree->[ 0 ]{ 'defined' } =~ /false/ ) {"
NSQ_SOURCE_LINE 00000575 "\t\t\t\t\t\t\t\t$ref->{ $key } = undef;"
NSQ_SOURCE_LINE 00000576 "\t\t\t\t\t\t\t\tnext;"
NSQ_SOURCE_LINE 00000577 "\t\t\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000578 "\t\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000579 "\t\t\t\t\t\t# ===== XML::PARSER IGNORES ZERO-LENGTH STRINGS"
NSQ_SOURCE_LINE 00000580 "\t\t\t\t\t\t# It indicates the presence of a zero-length string by"
NSQ_SOURCE_LINE 00000581 "\t\t\t\t\t\t# not having the array portion of the tag-name/array pair"
NSQ_SOURCE_LINE 00000582 "\t\t\t\t\t\t# values be of length 1. (Which is to say it captures only"
NSQ_SOURCE_LINE 00000583 "\t\t\t\t\t\t# the attributes of the tag and acknowledges that the tag"
NSQ_SOURCE_LINE 00000584 "\t\t\t\t\t\t# is an empty one."
NSQ_SOURCE_LINE 00000585 "\t\t\t\t\t\tif( int( @{ $item_tree } ) == 1 ) {"
NSQ_SOURCE_LINE 00000586 "\t\t\t\t\t\t\t$ref->{ $key } = '';"
NSQ_SOURCE_LINE 00000587 "\t\t\t\t\t\t\tnext;"
NSQ_SOURCE_LINE 00000588 "\t\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000589 "\t\t\t\t\t\t$ref->{ $key } = $self->undump( $item_tree, $callback );"
NSQ_SOURCE_LINE 00000590 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000591 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000592 "\t\t\t\tif( $class ) {"
NSQ_SOURCE_LINE 00000593 "\t\t\t\t\t# Check class name for nasty stuff..."
NSQ_SOURCE_LINE 00000594 "\t\t\t\t\t$class =~ m/^[\\w-]+(?:::[\\w-]+)*$/"
NSQ_SOURCE_LINE 00000595 "\t\t\t\t\t\tor die \"Refusing to load unsafe class name '$class'\\n\";"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "\t\t\t\t\tunless( int( eval( \"\\%$class\".\"::\")) ) {"
NSQ_SOURCE_LINE 00000598 "\t\t\t\t\t\teval \"require $class;\";"
NSQ_SOURCE_LINE 00000599 "\t\t\t\t\t\tif( $@ ) {"
NSQ_SOURCE_LINE 00000600 "\t\t\t\t\t\t\twarn $@;"
NSQ_SOURCE_LINE 00000601 "\t\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000602 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "\t\t\t\t\tbless $ref, $class;"
NSQ_SOURCE_LINE 00000605 "\t\t\t\t\tif( defined $callback && $ref->can( $callback ) ) {"
NSQ_SOURCE_LINE 00000606 "\t\t\t\t\t\t$ref->$callback();"
NSQ_SOURCE_LINE 00000607 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000608 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000609 "\t\t\t\tlast TREE;"
NSQ_SOURCE_LINE 00000610 "\t    \t}"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000613 "\t\t\tif( /^arrayref/ ) {"
NSQ_SOURCE_LINE 00000614 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000615 "\t\t\t\t$ref = [];"
NSQ_SOURCE_LINE 00000616 "\t\t\t\t$self->{ perldata }{ $address } = $ref if( $address );"
NSQ_SOURCE_LINE 00000617 "\t\t\t\tfor (my $j = 1; $j < $#{$tree->[$i+1]}; $j+=2) {"
NSQ_SOURCE_LINE 00000618 "\t\t\t\t\tnext unless $tree->[$i+1][$j] eq 'item';"
NSQ_SOURCE_LINE 00000619 "\t\t\t\t\tmy $item_tree = $tree->[$i+1][$j+1];"
NSQ_SOURCE_LINE 00000620 "\t\t\t\t\tif( exists $item_tree->[0]{ key } ) {"
NSQ_SOURCE_LINE 00000621 "\t\t\t\t\t\tmy $key = $item_tree->[0]{ key };"
NSQ_SOURCE_LINE 00000622 "\t\t\t\t\t\tif( exists $item_tree->[ 0 ]{ 'defined' } ) {"
NSQ_SOURCE_LINE 00000623 "\t\t\t\t\t\t\tif( $item_tree->[ 0 ]{ 'defined' } =~ /false/ ) {"
NSQ_SOURCE_LINE 00000624 "\t\t\t\t\t\t\t\t$ref->[ $key ] = undef;"
NSQ_SOURCE_LINE 00000625 "\t\t\t\t\t\t\t\tnext;"
NSQ_SOURCE_LINE 00000626 "\t\t\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000627 "\t\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000628 "\t\t\t\t\t\t# ===== XML::PARSER IGNORES ZERO-LENGTH STRINGS"
NSQ_SOURCE_LINE 00000629 "\t\t\t\t\t\t# See note above."
NSQ_SOURCE_LINE 00000630 "\t\t\t\t\t\tif( int( @{ $item_tree } ) == 1 ) {"
NSQ_SOURCE_LINE 00000631 "\t\t\t\t\t\t\t$ref->[ $key ] = '';"
NSQ_SOURCE_LINE 00000632 "\t\t\t\t\t\t\tnext;"
NSQ_SOURCE_LINE 00000633 "\t\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000634 "\t\t\t\t\t\t$ref->[ $key ] = $self->undump( $item_tree, $callback );"
NSQ_SOURCE_LINE 00000635 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000636 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000637 "\t\t\t\tif( $class ) {"
NSQ_SOURCE_LINE 00000638 "\t\t\t\t\t# Check class name for nasty stuff..."
NSQ_SOURCE_LINE 00000639 "\t\t\t\t\t$class =~ m/^[\\w-]+(?:::[\\w-]+)*$/"
NSQ_SOURCE_LINE 00000640 "\t\t\t\t\t\tor die \"Refusing to load unsafe class name '$class'\\n\";"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "\t\t\t\t\tunless( int( eval( \"\\%$class\".\"::\")) ) {"
NSQ_SOURCE_LINE 00000643 "\t\t\t\t\t\teval \"require $class;\";"
NSQ_SOURCE_LINE 00000644 "\t\t\t\t\t\tif( $@ ) {"
NSQ_SOURCE_LINE 00000645 "\t\t\t\t\t\t\twarn $@;"
NSQ_SOURCE_LINE 00000646 "\t\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000647 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "\t\t\t\t\tbless $ref, $class;"
NSQ_SOURCE_LINE 00000650 "\t\t\t\t\tif( defined $callback && $ref->can( $callback ) ) {"
NSQ_SOURCE_LINE 00000651 "\t\t\t\t\t\t$ref->$callback();"
NSQ_SOURCE_LINE 00000652 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000653 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000654 "\t\t\t    last TREE;"
NSQ_SOURCE_LINE 00000655 "\t\t\t}"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000658 "\t\t\tif( /^0$/ ) { # SIMPLE SCALAR"
NSQ_SOURCE_LINE 00000659 "\t\t\t# ----------------------------------------"
NSQ_SOURCE_LINE 00000660 "\t\t\t\t$item = $tree->[$i + 1];"
NSQ_SOURCE_LINE 00000661 "\t\t\t}"
NSQ_SOURCE_LINE 00000662 "\t\t}"
NSQ_SOURCE_LINE 00000663 "    }"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "    ## If $ref is not set at this point, it means we've just"
NSQ_SOURCE_LINE 00000666 "    ## encountered a scalar value directly inside the item tag."
NSQ_SOURCE_LINE 00000667 "    "
NSQ_SOURCE_LINE 00000668 "    $ref = $item unless defined( $ref );"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "    return ($ref);"
NSQ_SOURCE_LINE 00000671 "}"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "# ============================================================"
NSQ_SOURCE_LINE 00000674 "sub xml_escape {"
NSQ_SOURCE_LINE 00000675 "# ============================================================"
NSQ_SOURCE_LINE 00000676 "# Transforms and filters input characters to acceptable XML characters "
NSQ_SOURCE_LINE 00000677 "# (or filters them out completely). There's probably a better"
NSQ_SOURCE_LINE 00000678 "# implementation of this in another module, by now."
NSQ_SOURCE_LINE 00000679 "# ------------------------------------------------------------"
NSQ_SOURCE_LINE 00000680 "\tlocal $_ = shift;"
NSQ_SOURCE_LINE 00000681 "\treturn $_ if not defined $_;"
NSQ_SOURCE_LINE 00000682 "    s/&/&amp;/g;"
NSQ_SOURCE_LINE 00000683 "    s/</&lt;/g;"
NSQ_SOURCE_LINE 00000684 "    s/>/&gt;/g;"
NSQ_SOURCE_LINE 00000685 "    s/[\\0\\ca\\cb\\cc\\cd\\ce\\cf\\cg\\ch\\ck\\cl\\cn\\co\\cp\\cq\\cr\\cs\\ct\\cu\\cv\\cw\\cx\\cy\\cz\\c[\\c\\\\c]\\c^\\c_]//g;"
NSQ_SOURCE_LINE 00000686 "    s/'/&apos;/g;"
NSQ_SOURCE_LINE 00000687 "    s/\"/&quot;/g;"
NSQ_SOURCE_LINE 00000688 "    return $_;"
NSQ_SOURCE_LINE 00000689 "}"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "# ============================================================"
NSQ_SOURCE_LINE 00000692 "sub xml2perl {"
NSQ_SOURCE_LINE 00000693 "# ============================================================"
NSQ_SOURCE_LINE 00000694 "\txml2pl( @_ );"
NSQ_SOURCE_LINE 00000695 "}"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "# ============================================================"
NSQ_SOURCE_LINE 00000698 "sub xml2pl {"
NSQ_SOURCE_LINE 00000699 "# ============================================================"
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "=item * xml2pl( $xml_or_filename, [ $callback ] ) -"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "(Also xml2perl(), for those who enjoy readability over brevity.)"
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "Converts XML to a Perl datatype. If this method is given a second argument, "
NSQ_SOURCE_LINE 00000706 "XML::Dumper will use the second argument as a callback (if possible). If"
NSQ_SOURCE_LINE 00000707 "the first argument isn't XML and exists as a file, that file will be read"
NSQ_SOURCE_LINE 00000708 "and its contents will be used as the input XML."
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "Currently, the only supported invocation of callbacks is through soft"
NSQ_SOURCE_LINE 00000711 "references. That is to say, the callback argument ought to be a string"
NSQ_SOURCE_LINE 00000712 "that matches the name of a callable method for your classes. If you have"
NSQ_SOURCE_LINE 00000713 "a congruent interface, this should work like a peach. If your class"
NSQ_SOURCE_LINE 00000714 "interface doesn't have such a named method, it won't be called. "
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "=cut"
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "# ------------------------------------------------------------"
NSQ_SOURCE_LINE 00000719 "\tmy $self = ( ref $_[0] && (ref $_[0]) =~ /XML::Dumper/) ? shift : $dump;"
NSQ_SOURCE_LINE 00000720 "\tmy $xml = shift;"
NSQ_SOURCE_LINE 00000721 "\tmy $callback = shift;"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "\t$self->init;"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "\tif( $xml !~ /\\</ ) {"
NSQ_SOURCE_LINE 00000726 "\t\tmy $file = $xml;"
NSQ_SOURCE_LINE 00000727 "\t\tif( -e $file ) {"
NSQ_SOURCE_LINE 00000728 "\t\t\tmy $gzip_header_signature = pack \"H4\", \"1f8b\";"
NSQ_SOURCE_LINE 00000729 "\t\t\tmy $first_two_bytes;"
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "\t\t\topen FILE, \"<\". $file or die \"Can't open '$file' for reading $!\";"
NSQ_SOURCE_LINE 00000732 "\t\t\tdefined read FILE, $first_two_bytes, 2 or die \"Can't read first two bytes of '$file' $!\";"
NSQ_SOURCE_LINE 00000733 "\t\t\tclose FILE;"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "\t\t\tif( $first_two_bytes eq $gzip_header_signature ) {"
NSQ_SOURCE_LINE 00000736 "\t\t\t\tif( $COMPRESSION_AVAILABLE ) {"
NSQ_SOURCE_LINE 00000737 "\t\t\t\t\tmy $gz = Compress::Zlib::gzopen( $file, \"rb\" );"
NSQ_SOURCE_LINE 00000738 "\t\t\t\t\tmy @xml;"
NSQ_SOURCE_LINE 00000739 "\t\t\t\t\tmy $buffer;"
NSQ_SOURCE_LINE 00000740 "\t\t\t\t\twhile( $gz->gzread( $buffer ) > 0 ) {"
NSQ_SOURCE_LINE 00000741 "\t\t\t\t\t\tpush @xml, $buffer;"
NSQ_SOURCE_LINE 00000742 "\t\t\t\t\t}"
NSQ_SOURCE_LINE 00000743 "\t\t\t\t\t$gz->gzclose();"
NSQ_SOURCE_LINE 00000744 "\t\t\t\t\t$xml = join \"\", @xml;"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "\t\t\t\t} else {"
NSQ_SOURCE_LINE 00000747 "\t\t\t\t\tdie \"Compress::Zlib is not installed. Cannot read gzipped file '$file'\";"
NSQ_SOURCE_LINE 00000748 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000749 "\t\t\t} else {"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "\t\t\t\topen FILE, $file or die \"Can't open file '$file' for reading $!\";"
NSQ_SOURCE_LINE 00000752 "\t\t\t\tmy @xml = <FILE>;"
NSQ_SOURCE_LINE 00000753 "\t\t\t\tclose FILE;"
NSQ_SOURCE_LINE 00000754 "\t\t\t\t$xml = join \"\", @xml;"
NSQ_SOURCE_LINE 00000755 "\t\t\t}"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "\t\t} else {"
NSQ_SOURCE_LINE 00000758 "\t\t\tdie \"'$file' does not exist as a file and is not XML.\\n\";"
NSQ_SOURCE_LINE 00000759 "\t\t}"
NSQ_SOURCE_LINE 00000760 "\t}"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "\tmy $parser = new XML::Parser( %{ $self->{ xml_parser_params }}, Style => 'Tree' );"
NSQ_SOURCE_LINE 00000763 "\tmy $tree = $parser->parse($xml);"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "    # Skip enclosing \"perldata\" level"
NSQ_SOURCE_LINE 00000766 "    my $topItem = $tree->[1];"
NSQ_SOURCE_LINE 00000767 "    my $ref = $self->undump($topItem, $callback);"
NSQ_SOURCE_LINE 00000768 "    "
NSQ_SOURCE_LINE 00000769 "    return($ref);"
NSQ_SOURCE_LINE 00000770 "}"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "# ============================================================"
NSQ_SOURCE_LINE 00000773 "sub xml_compare {"
NSQ_SOURCE_LINE 00000774 "# ============================================================"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "=item * xml_compare( $xml1, $xml2 ) - Compares xml for content"
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "Compares two dumped Perl data structures (that is, compares the xml) for"
NSQ_SOURCE_LINE 00000779 "identity in content. Use this function rather than perl's built-in string "
NSQ_SOURCE_LINE 00000780 "comparison. This function will return true for any two perl data that are "
NSQ_SOURCE_LINE 00000781 "either deep clones of each other, or identical. This method is exported "
NSQ_SOURCE_LINE 00000782 "by default."
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "=cut"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "# ------------------------------------------------------------"
NSQ_SOURCE_LINE 00000787 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000788 "\tmy $xml1 = shift;"
NSQ_SOURCE_LINE 00000789 "\tmy $xml2 = shift;"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "\tmy $class = ref $self;"
NSQ_SOURCE_LINE 00000792 "\tif( $class ne 'XML::Dumper' ) {"
NSQ_SOURCE_LINE 00000793 "\t\t$xml2 = $xml1;"
NSQ_SOURCE_LINE 00000794 "\t\t$xml1 = $self;"
NSQ_SOURCE_LINE 00000795 "\t}"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "\t$xml1 =~ s/(<[^>]*)\\smemory_address=\"\\dx[A-Za-z0-9]+\"([^<]*>)/$1$2/g;"
NSQ_SOURCE_LINE 00000798 "\t$xml2 =~ s/(<[^>]*)\\smemory_address=\"\\dx[A-Za-z0-9]+\"([^<]*>)/$1$2/g;"
NSQ_SOURCE_LINE 00000799 "\t$xml1 =~ s/(<[^>]*)\\sdefined=\\\"false\\\"([^<]>)/$1$2/g; # For backwards "
NSQ_SOURCE_LINE 00000800 "\t$xml2 =~ s/(<[^>]*)\\sdefined=\\\"false\\\"([^<]>)/$1$2/g; # compatibility"
NSQ_SOURCE_LINE 00000801 "\t$xml1 =~ s/<\\?xml .*>//; # Ignore XML declaration"
NSQ_SOURCE_LINE 00000802 "\t$xml2 =~ s/<\\?xml .*>//;"
NSQ_SOURCE_LINE 00000803 "\t$xml1 =~ s/<\\!DOCTYPE perldata \\[.*\\]>//s; # Remove DTD"
NSQ_SOURCE_LINE 00000804 "\t$xml2 =~ s/<\\!DOCTYPE perldata \\[.*\\]>//s;"
NSQ_SOURCE_LINE 00000805 "\t$xml1 =~ s/^\\s*</</; # Remove empty space"
NSQ_SOURCE_LINE 00000806 "\t$xml2 =~ s/^\\s*</</;"
NSQ_SOURCE_LINE 00000807 "\t$xml1 =~ s/>\\s*</></g; "
NSQ_SOURCE_LINE 00000808 "\t$xml2 =~ s/>\\s*</></g;"
NSQ_SOURCE_LINE 00000809 "\t$xml1 =~ s/>\\s*$/>/; "
NSQ_SOURCE_LINE 00000810 "\t$xml2 =~ s/>\\s*$/>/;"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "\treturn $xml1 eq $xml2;"
NSQ_SOURCE_LINE 00000813 "}"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "# ============================================================"
NSQ_SOURCE_LINE 00000816 "sub xml_identity {"
NSQ_SOURCE_LINE 00000817 "# ============================================================"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "=item * xml_identity( $xml1, $xml2 ) - Compares xml for identity"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "Compares two dumped Perl data structures (that is, compares the xml) for"
NSQ_SOURCE_LINE 00000822 "identity in instantiation. This function will return true for any two"
NSQ_SOURCE_LINE 00000823 "perl data that are identical, but not for deep clones of each other. This"
NSQ_SOURCE_LINE 00000824 "method is also exported by default."
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "=cut"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "# ------------------------------------------------------------"
NSQ_SOURCE_LINE 00000829 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000830 "\tmy $xml1 = shift;"
NSQ_SOURCE_LINE 00000831 "\tmy $xml2 = shift;"
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "\tmy $class = ref $self;"
NSQ_SOURCE_LINE 00000834 "\tif( $class ne 'XML::Dumper' ) {"
NSQ_SOURCE_LINE 00000835 "\t\t$xml2 = $xml1;"
NSQ_SOURCE_LINE 00000836 "\t\t$xml1 = $self;"
NSQ_SOURCE_LINE 00000837 "\t}"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "\treturn ( $xml1 eq $xml2 );"
NSQ_SOURCE_LINE 00000840 "}"
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "1;"
NSQ_SOURCE_LINE 00000843 "__END__"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "=back"
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000848 ""
NSQ_SOURCE_LINE 00000849 "By default, the following methods are exported:"
NSQ_SOURCE_LINE 00000850 ""
NSQ_SOURCE_LINE 00000851 "  xml2pl, pl2xml, xml_compare, xml_identity"
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "=head1 BUGS AND DEPENDENCIES"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "XML::Dumper has changed API since 0.4, as a response to a bug report "
NSQ_SOURCE_LINE 00000856 "from PerlMonks. I felt it was necessary, as the functions simply didn't "
NSQ_SOURCE_LINE 00000857 "work as advertised. That is, xml2pl really didnt accept xml as an "
NSQ_SOURCE_LINE 00000858 "argument; what it wanted was an XML Parse tree. To correct for the "
NSQ_SOURCE_LINE 00000859 "API change, simply don't parse the XML before feeding it to XML::Dumper."
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "XML::Dumper also has no understanding of typeglobs (references or not),"
NSQ_SOURCE_LINE 00000862 "references to regular expressions, or references to Perl subroutines."
NSQ_SOURCE_LINE 00000863 "Turns out that Data::Dumper doesn't do references to Perl subroutines,"
NSQ_SOURCE_LINE 00000864 "either, so at least I'm in somewhat good company."
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "XML::Dumper requires one perl module, available from CPAN"
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "\tXML::Parser"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "XML::Parser itself relies on Clark Cooper's Expat implementation in Perl,"
NSQ_SOURCE_LINE 00000871 "which in turn requires James Clark's expat package itself. See the"
NSQ_SOURCE_LINE 00000872 "documentation for XML::Parser for more information."
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "=head1 REVISIONS AND CREDITS"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "The list of credits got so long that I had to move it to the Changes"
NSQ_SOURCE_LINE 00000877 "file. Thanks to all those who've contributed with bug reports and"
NSQ_SOURCE_LINE 00000878 "suggested features! Keep 'em coming!"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "I've had ownership of the module since June of 2002, and very much"
NSQ_SOURCE_LINE 00000881 "appreciate requests on how to make the module better. It has served me"
NSQ_SOURCE_LINE 00000882 "well, both as a learning tool on how I can repay my debt to the Perl"
NSQ_SOURCE_LINE 00000883 "Community, and as a practical module that is useful. I'm thrilled to"
NSQ_SOURCE_LINE 00000884 "be able to offer this bit of code. So, if you have suggestions, bug"
NSQ_SOURCE_LINE 00000885 "reports, or feature requests, please let me know and I'll do my best "
NSQ_SOURCE_LINE 00000886 "to make this a better module."
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "=head1 CURRENT MAINTAINER"
