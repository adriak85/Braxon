NSQ_SOURCE_LINE 00000001 "package File::ShareDir::Tarball;"
NSQ_SOURCE_LINE 00000002 "our $AUTHORITY = 'cpan:YANICK';"
NSQ_SOURCE_LINE 00000003 "# ABSTRACT: Deal transparently with shared files distributed as tarballs"
NSQ_SOURCE_LINE 00000004 "$File::ShareDir::Tarball::VERSION = '0.3.0';"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use parent qw/ Exporter /;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Carp;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use File::ShareDir;"
NSQ_SOURCE_LINE 00000014 "use Archive::Tar;"
NSQ_SOURCE_LINE 00000015 "use File::Temp qw/ tempdir /;"
NSQ_SOURCE_LINE 00000016 "use File::chdir;"
NSQ_SOURCE_LINE 00000017 "use Memoize;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "our @EXPORT_OK   = qw{"
NSQ_SOURCE_LINE 00000020 "    dist_dir dist_file"
NSQ_SOURCE_LINE 00000021 "};"
NSQ_SOURCE_LINE 00000022 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000023 "    all => [ @EXPORT_OK ],"
NSQ_SOURCE_LINE 00000024 ");"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "my $shared_files_tarball = 'shared-files.tar.gz';"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "# we don't want to extract the same dirs again and"
NSQ_SOURCE_LINE 00000029 "# again within a single program"
NSQ_SOURCE_LINE 00000030 "memoize('dist_dir');"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub dist_dir {"
NSQ_SOURCE_LINE 00000033 "    my $dist = shift;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    my $dir = File::ShareDir::dist_dir($dist);"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    # no tarball? Assume regular shared dir"
NSQ_SOURCE_LINE 00000038 "    return $dir unless -f \"$dir/$shared_files_tarball\";"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    my $archive = Archive::Tar->new;"
NSQ_SOURCE_LINE 00000041 "    $archive->read(\"$dir/$shared_files_tarball\");"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    # because that would be a veeery bad idea"
NSQ_SOURCE_LINE 00000044 "    croak \"archive '$shared_files_tarball' contains files with absolute path, aborting\""
NSQ_SOURCE_LINE 00000045 "        if grep { m#^/# } $archive->list_files;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    my $tmpdir = tempdir( CLEANUP => 1 );"
NSQ_SOURCE_LINE 00000048 "    local $CWD = $tmpdir;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    $archive->extract;"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    return $tmpdir;"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "sub dist_file {"
NSQ_SOURCE_LINE 00000056 "    my $dist = File::ShareDir::_DIST(shift);"
NSQ_SOURCE_LINE 00000057 "    my $file = File::ShareDir::_FILE(shift);"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    my $path = dist_dir($dist).'/'.$file;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    return undef unless -e $path;"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    croak(\"Found dist_file '$path', but not a file\")"
NSQ_SOURCE_LINE 00000064 "        unless -f $path;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    croak(\"File '$path', no read permissions\")"
NSQ_SOURCE_LINE 00000067 "        unless -r $path;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    return $path;"
NSQ_SOURCE_LINE 00000070 "}"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "1;"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "__END__"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=pod"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head1 NAME"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "File::ShareDir::Tarball - Deal transparently with shared files distributed as tarballs"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head1 VERSION"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "version 0.3.0"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    use File::ShareDir::Tarball ':all';"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    # use exactly like File::ShareDir"
NSQ_SOURCE_LINE 00000093 "    $dir = dist_dir('File-ShareDir');"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "If the shared files of a distribution are contained in a"
NSQ_SOURCE_LINE 00000098 "tarball (see L<Dist::Zilla::Plugin::ShareDir::Tarball> for"
NSQ_SOURCE_LINE 00000099 "why you would want to do that), automatically"
NSQ_SOURCE_LINE 00000100 "extract the archive in a temporary"
NSQ_SOURCE_LINE 00000101 "directory and return the path to that directory. If called for a regular distribution without a bundle file"
NSQ_SOURCE_LINE 00000102 "(C<shared-files.tar.gz>), it'll return the original shared dir."
NSQ_SOURCE_LINE 00000103 "In other words,"
NSQ_SOURCE_LINE 00000104 "from the consumer point of view, it'll behave just like L<File::ShareDir>."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 EXPORT TAGS"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "=head2 :all"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "Exports C<dist_dir()> and C<dist_file()>."
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=head1 EXPORTABLE FUNCTIONS"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head2 dist_dir( $distribution )"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "Behaves just like C<dist_dir()> from L<File::ShareDir>."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=head2 dist_file( $distribution, $file )"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "Behaves just like C<dist_file()> from L<File::ShareDir>."
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "=over"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=item L<Test::File::ShareDir>"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "To test or use a shared dir that is not deployed yet."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=item L<Dist::Zilla::Plugin::ShareDir::Tarball>"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "L<Dist::Zilla> plugin to create the tarball effortlessly."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=item L<Module::Build::CleanInstall>"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "Provides an alternative to this module by subclassing L<Module::Build> and,"
NSQ_SOURCE_LINE 00000137 "upon installation, remove the files from previous installations as given in"
NSQ_SOURCE_LINE 00000138 "the I<packlist>."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=back"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "Yanick Champoux <yanick@babyl.dyndns.org>"
