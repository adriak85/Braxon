NSQ_SOURCE_LINE 00000001 "package Scalar::Util::Numeric::PP;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2016-01-22'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.04'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "require Exporter;"
NSQ_SOURCE_LINE 00000011 "our @ISA       = qw(Exporter);"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000013 "                       isint"
NSQ_SOURCE_LINE 00000014 "                       isnum"
NSQ_SOURCE_LINE 00000015 "                       isnan"
NSQ_SOURCE_LINE 00000016 "                       isinf"
NSQ_SOURCE_LINE 00000017 "                       isneg"
NSQ_SOURCE_LINE 00000018 "                       isfloat"
NSQ_SOURCE_LINE 00000019 "               );"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub isint {"
NSQ_SOURCE_LINE 00000022 "    local $_ = shift;"
NSQ_SOURCE_LINE 00000023 "    return 0 unless defined;"
NSQ_SOURCE_LINE 00000024 "    return 1 if /\\A\\s*[+-]?(?:0|[1-9][0-9]*)\\s*\\z/s;"
NSQ_SOURCE_LINE 00000025 "    0;"
NSQ_SOURCE_LINE 00000026 "}"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "sub isnan($) {"
NSQ_SOURCE_LINE 00000029 "    local $_ = shift;"
NSQ_SOURCE_LINE 00000030 "    return 0 unless defined;"
NSQ_SOURCE_LINE 00000031 "    return 1 if /\\A\\s*[+-]?nan\\s*\\z/is;"
NSQ_SOURCE_LINE 00000032 "    0;"
NSQ_SOURCE_LINE 00000033 "}"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "sub isinf($) {"
NSQ_SOURCE_LINE 00000036 "    local $_ = shift;"
NSQ_SOURCE_LINE 00000037 "    return 0 unless defined;"
NSQ_SOURCE_LINE 00000038 "    return 1 if /\\A\\s*[+-]?inf(?:inity)?\\s*\\z/is;"
NSQ_SOURCE_LINE 00000039 "    0;"
NSQ_SOURCE_LINE 00000040 "}"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "sub isneg($) {"
NSQ_SOURCE_LINE 00000043 "    local $_ = shift;"
NSQ_SOURCE_LINE 00000044 "    return 0 unless defined;"
NSQ_SOURCE_LINE 00000045 "    return 1 if /\\A\\s*-/;"
NSQ_SOURCE_LINE 00000046 "    0;"
NSQ_SOURCE_LINE 00000047 "}"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "sub isnum($) {"
NSQ_SOURCE_LINE 00000050 "    local $_ = shift;"
NSQ_SOURCE_LINE 00000051 "    return 0 unless defined;"
NSQ_SOURCE_LINE 00000052 "    return 1 if isint($_);"
NSQ_SOURCE_LINE 00000053 "    return 1 if isfloat($_);"
NSQ_SOURCE_LINE 00000054 "    0;"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub isfloat($) {"
NSQ_SOURCE_LINE 00000058 "    local $_ = shift;"
NSQ_SOURCE_LINE 00000059 "    return 0 unless defined;"
NSQ_SOURCE_LINE 00000060 "    return 1 if /\\A\\s*[+-]?"
NSQ_SOURCE_LINE 00000061 "                 (?: (?:0|[1-9][0-9]*)(\\.[0-9]+)? | (\\.[0-9]+) )"
NSQ_SOURCE_LINE 00000062 "                 ([eE][+-]?[0-9]+)?\\s*\\z/sx && $1 || $2 || $3;"
NSQ_SOURCE_LINE 00000063 "    return 1 if isnan($_) || isinf($_);"
NSQ_SOURCE_LINE 00000064 "    0;"
NSQ_SOURCE_LINE 00000065 "}"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "1;"
