NSQ_SOURCE_LINE 00000001 "#-*- perl -*-"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "package MIME::Charset;"
NSQ_SOURCE_LINE 00000004 "use 5.005;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "=head1 NAME"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "MIME::Charset - Charset Information for MIME"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "    use MIME::Charset:"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "    $charset = MIME::Charset->new(\"euc-jp\");"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "Getting charset information:"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "    $benc = $charset->body_encoding; # e.g. \"Q\""
NSQ_SOURCE_LINE 00000019 "    $cset = $charset->as_string; # e.g. \"US-ASCII\""
NSQ_SOURCE_LINE 00000020 "    $henc = $charset->header_encoding; # e.g. \"S\""
NSQ_SOURCE_LINE 00000021 "    $cset = $charset->output_charset; # e.g. \"ISO-2022-JP\""
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "Translating text data:"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    ($text, $charset, $encoding) ="
NSQ_SOURCE_LINE 00000026 "        $charset->header_encode("
NSQ_SOURCE_LINE 00000027 "           \"\\xc9\\xc2\\xc5\\xaa\\xc0\\xde\\xc3\\xef\\xc5\\xaa\"."
NSQ_SOURCE_LINE 00000028 "           \"\\xc7\\xd1\\xca\\xaa\\xbd\\xd0\\xce\\xcf\\xb4\\xef\","
NSQ_SOURCE_LINE 00000029 "           Charset => 'euc-jp');"
NSQ_SOURCE_LINE 00000030 "    # ...returns e.g. (<converted>, \"ISO-2022-JP\", \"B\")."
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "    ($text, $charset, $encoding) ="
NSQ_SOURCE_LINE 00000033 "        $charset->body_encode("
NSQ_SOURCE_LINE 00000034 "            \"Collectioneur path\\xe9tiquement \"."
NSQ_SOURCE_LINE 00000035 "            \"\\xe9clectique de d\\xe9chets\","
NSQ_SOURCE_LINE 00000036 "            Charset => 'latin1');"
NSQ_SOURCE_LINE 00000037 "    # ...returns e.g. (<original>, \"ISO-8859-1\", \"QUOTED-PRINTABLE\")."
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "    $len = $charset->encoded_header_len("
NSQ_SOURCE_LINE 00000040 "        \"Perl\\xe8\\xa8\\x80\\xe8\\xaa\\x9e\","
NSQ_SOURCE_LINE 00000041 "        Charset => 'utf-8',"
NSQ_SOURCE_LINE 00000042 "        Encoding => \"b\");"
NSQ_SOURCE_LINE 00000043 "    # ...returns e.g. 28."
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "Manipulating module defaults:"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    MIME::Charset::alias(\"csEUCKR\", \"euc-kr\");"
NSQ_SOURCE_LINE 00000048 "    MIME::Charset::default(\"iso-8859-1\");"
NSQ_SOURCE_LINE 00000049 "    MIME::Charset::fallback(\"us-ascii\");"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "Non-OO functions (may be deprecated in near future):"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    use MIME::Charset qw(:info);"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    $benc = body_encoding(\"iso-8859-2\"); # \"Q\""
NSQ_SOURCE_LINE 00000056 "    $cset = canonical_charset(\"ANSI X3.4-1968\"); # \"US-ASCII\""
NSQ_SOURCE_LINE 00000057 "    $henc = header_encoding(\"utf-8\"); # \"S\""
NSQ_SOURCE_LINE 00000058 "    $cset = output_charset(\"shift_jis\"); # \"ISO-2022-JP\""
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    use MIME::Charset qw(:trans);"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    ($text, $charset, $encoding) ="
NSQ_SOURCE_LINE 00000063 "        header_encode("
NSQ_SOURCE_LINE 00000064 "           \"\\xc9\\xc2\\xc5\\xaa\\xc0\\xde\\xc3\\xef\\xc5\\xaa\"."
NSQ_SOURCE_LINE 00000065 "           \"\\xc7\\xd1\\xca\\xaa\\xbd\\xd0\\xce\\xcf\\xb4\\xef\","
NSQ_SOURCE_LINE 00000066 "           \"euc-jp\");"
NSQ_SOURCE_LINE 00000067 "    # ...returns (<converted>, \"ISO-2022-JP\", \"B\");"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    ($text, $charset, $encoding) ="
NSQ_SOURCE_LINE 00000070 "        body_encode("
NSQ_SOURCE_LINE 00000071 "            \"Collectioneur path\\xe9tiquement \"."
NSQ_SOURCE_LINE 00000072 "            \"\\xe9clectique de d\\xe9chets\","
NSQ_SOURCE_LINE 00000073 "            \"latin1\");"
NSQ_SOURCE_LINE 00000074 "    # ...returns (<original>, \"ISO-8859-1\", \"QUOTED-PRINTABLE\");"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "    $len = encoded_header_len("
NSQ_SOURCE_LINE 00000077 "        \"Perl\\xe8\\xa8\\x80\\xe8\\xaa\\x9e\", \"b\", \"utf-8\"); # 28"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "MIME::Charset provides information about character sets used for"
NSQ_SOURCE_LINE 00000082 "MIME messages on Internet."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head2 Definitions"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "The B<charset> is ``character set'' used in MIME to refer to a"
NSQ_SOURCE_LINE 00000087 "method of converting a sequence of octets into a sequence of characters."
NSQ_SOURCE_LINE 00000088 "It includes both concepts of ``coded character set'' (CCS) and"
NSQ_SOURCE_LINE 00000089 "``character encoding scheme'' (CES) of ISO/IEC."
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "The B<encoding> is that used in MIME to refer to a method of representing"
NSQ_SOURCE_LINE 00000092 "a body part or a header body as sequence(s) of printable US-ASCII"
NSQ_SOURCE_LINE 00000093 "characters."
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=cut"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "use strict;"
NSQ_SOURCE_LINE 00000098 "use vars qw(@ISA $VERSION @EXPORT @EXPORT_OK %EXPORT_TAGS $Config);"
NSQ_SOURCE_LINE 00000099 "use Exporter;"
NSQ_SOURCE_LINE 00000100 "@ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000101 "@EXPORT = qw(body_encoding canonical_charset header_encoding output_charset"
NSQ_SOURCE_LINE 00000102 "\t     body_encode encoded_header_len header_encode);"
NSQ_SOURCE_LINE 00000103 "@EXPORT_OK = qw(alias default fallback recommended);"
NSQ_SOURCE_LINE 00000104 "%EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000105 "\t\t\"info\" => [qw(body_encoding header_encoding"
NSQ_SOURCE_LINE 00000106 "\t\t\t      canonical_charset output_charset)],"
NSQ_SOURCE_LINE 00000107 "\t\t\"trans\" =>[ qw(body_encode encoded_header_len"
NSQ_SOURCE_LINE 00000108 "\t\t\t       header_encode)],"
NSQ_SOURCE_LINE 00000109 "\t\t);"
NSQ_SOURCE_LINE 00000110 "use Carp qw(croak);"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "use constant USE_ENCODE => ($] >= 5.007003)? 'Encode': '';"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "my @ENCODE_SUBS = qw(FB_CROAK FB_PERLQQ FB_HTMLCREF FB_XMLCREF"
NSQ_SOURCE_LINE 00000115 "\t\t     is_utf8 resolve_alias);"
NSQ_SOURCE_LINE 00000116 "if (USE_ENCODE) {"
NSQ_SOURCE_LINE 00000117 "    eval \"use \".USE_ENCODE.\" \\@ENCODE_SUBS;\";"
NSQ_SOURCE_LINE 00000118 "    if ($@) { # Perl 5.7.3 + Encode 0.40"
NSQ_SOURCE_LINE 00000119 "\teval \"use \".USE_ENCODE.\" qw(is_utf8);\";"
NSQ_SOURCE_LINE 00000120 "\trequire MIME::Charset::_Compat;"
NSQ_SOURCE_LINE 00000121 "\tfor my $sub (@ENCODE_SUBS) {"
NSQ_SOURCE_LINE 00000122 "\t    no strict \"refs\";"
NSQ_SOURCE_LINE 00000123 "\t    *{$sub} = \\&{\"MIME::Charset::_Compat::$sub\"}"
NSQ_SOURCE_LINE 00000124 "\t\tunless $sub eq 'is_utf8';"
NSQ_SOURCE_LINE 00000125 "\t}"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 "} else {"
NSQ_SOURCE_LINE 00000128 "    require MIME::Charset::_Compat;"
NSQ_SOURCE_LINE 00000129 "    for my $sub (@ENCODE_SUBS) {"
NSQ_SOURCE_LINE 00000130 "\tno strict \"refs\";"
NSQ_SOURCE_LINE 00000131 "\t*{$sub} = \\&{\"MIME::Charset::_Compat::$sub\"};"
NSQ_SOURCE_LINE 00000132 "    }"
NSQ_SOURCE_LINE 00000133 "}"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "$VERSION = '1.013.1';"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "######## Private Attributes ########"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "my $DEFAULT_CHARSET = 'US-ASCII';"
NSQ_SOURCE_LINE 00000140 "my $FALLBACK_CHARSET = 'UTF-8';"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "# This table was initially borrowed from Python email package."
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "my %CHARSETS = (# input\t\t    header enc body enc output conv"
NSQ_SOURCE_LINE 00000145 "\t\t'DIN_66003' =>          ['Q',   undef,  undef],"
NSQ_SOURCE_LINE 00000146 "\t\t'ISO-8859-1' =>\t\t['Q',\t'Q',\tundef],"
NSQ_SOURCE_LINE 00000147 "\t\t'ISO-8859-2' =>\t\t['Q',\t'Q',\tundef],"
NSQ_SOURCE_LINE 00000148 "\t\t'ISO-8859-3' =>\t\t['Q',\t'Q',\tundef],"
NSQ_SOURCE_LINE 00000149 "\t\t'ISO-8859-4' =>\t\t['Q',\t'Q',\tundef],"
NSQ_SOURCE_LINE 00000150 "\t\t# ISO-8859-5 is Cyrillic, and not especially used"
NSQ_SOURCE_LINE 00000151 "\t\t# ISO-8859-6 is Arabic, also not particularly used"
NSQ_SOURCE_LINE 00000152 "\t\t# ISO-8859-7 is Greek, 'Q' will not make it readable"
NSQ_SOURCE_LINE 00000153 "\t\t# ISO-8859-8 is Hebrew, 'Q' will not make it readable"
NSQ_SOURCE_LINE 00000154 "\t\t'ISO-8859-9' =>\t\t['Q',\t'Q',\tundef],"
NSQ_SOURCE_LINE 00000155 "\t\t'ISO-8859-10' =>\t['Q',\t'Q',\tundef],"
NSQ_SOURCE_LINE 00000156 "\t\t# ISO-8859-11 is Thai, 'Q' will not make it readable"
NSQ_SOURCE_LINE 00000157 "\t\t'ISO-8859-13' =>\t['Q',\t'Q',\tundef],"
NSQ_SOURCE_LINE 00000158 "\t\t'ISO-8859-14' =>\t['Q',\t'Q',\tundef],"
NSQ_SOURCE_LINE 00000159 "\t\t'ISO-8859-15' =>\t['Q',\t'Q',\tundef],"
NSQ_SOURCE_LINE 00000160 "\t\t'ISO-8859-16' =>\t['Q',\t'Q',\tundef],"
NSQ_SOURCE_LINE 00000161 "\t\t'WINDOWS-1252' =>\t['Q',\t'Q',\tundef],"
NSQ_SOURCE_LINE 00000162 "\t\t'VISCII' =>\t\t['Q',\t'Q',\tundef],"
NSQ_SOURCE_LINE 00000163 "\t\t'US-ASCII' =>\t\t[undef,\tundef,\tundef],"
NSQ_SOURCE_LINE 00000164 "\t\t'BIG5' =>\t\t['B',\t'B',\tundef],"
NSQ_SOURCE_LINE 00000165 "\t\t'GB2312' =>\t\t['B',\t'B',\tundef],"
NSQ_SOURCE_LINE 00000166 "\t\t'HZ-GB-2312' =>\t\t['B',\tundef,\tundef],"
NSQ_SOURCE_LINE 00000167 "\t\t'EUC-JP' =>\t\t['B',\tundef,\t'ISO-2022-JP'],"
NSQ_SOURCE_LINE 00000168 "\t\t'SHIFT_JIS' =>\t\t['B',\tundef,\t'ISO-2022-JP'],"
NSQ_SOURCE_LINE 00000169 "\t\t'ISO-2022-JP' =>\t['B',\tundef,\tundef],"
NSQ_SOURCE_LINE 00000170 "\t\t'ISO-2022-JP-1' =>\t['B',\tundef,\tundef],"
NSQ_SOURCE_LINE 00000171 "\t\t'ISO-2022-JP-2' =>\t['B',\tundef,\tundef],"
NSQ_SOURCE_LINE 00000172 "\t\t'EUC-JISX0213' =>\t['B',\tundef,\t'ISO-2022-JP-3'],"
NSQ_SOURCE_LINE 00000173 "\t\t'SHIFT_JISX0213' =>\t['B',\tundef,\t'ISO-2022-JP-3'],"
NSQ_SOURCE_LINE 00000174 "\t\t'ISO-2022-JP-3' =>\t['B',\tundef,\tundef],"
NSQ_SOURCE_LINE 00000175 "\t\t'EUC-JIS-2004' =>\t['B',\tundef,\t'ISO-2022-JP-2004'],"
NSQ_SOURCE_LINE 00000176 "\t\t'SHIFT_JIS-2004' =>\t['B',\tundef,\t'ISO-2022-JP-2004'],"
NSQ_SOURCE_LINE 00000177 "\t\t'ISO-2022-JP-2004' =>\t['B',\tundef,\tundef],"
NSQ_SOURCE_LINE 00000178 "\t\t'KOI8-R' =>\t\t['B',\t'B',\tundef],"
NSQ_SOURCE_LINE 00000179 "\t\t'TIS-620' =>\t\t['B',\t'B',\tundef], # cf. Mew"
NSQ_SOURCE_LINE 00000180 "\t\t'UTF-16' =>\t\t['B',\t'B',\tundef],"
NSQ_SOURCE_LINE 00000181 "\t\t'UTF-16BE' => \t\t['B',\t'B',\tundef],"
NSQ_SOURCE_LINE 00000182 "\t\t'UTF-16LE' =>\t\t['B',\t'B',\tundef],"
NSQ_SOURCE_LINE 00000183 "\t\t'UTF-32' =>\t\t['B',\t'B',\tundef],"
NSQ_SOURCE_LINE 00000184 "\t\t'UTF-32BE' => \t\t['B',\t'B',\tundef],"
NSQ_SOURCE_LINE 00000185 "\t\t'UTF-32LE' =>\t\t['B',\t'B',\tundef],"
NSQ_SOURCE_LINE 00000186 "\t\t'UTF-7' =>\t\t['Q',\tundef,\tundef],"
NSQ_SOURCE_LINE 00000187 "\t\t'UTF-8' =>\t\t['S',\t'S',\tundef],"
NSQ_SOURCE_LINE 00000188 "\t\t'GSM03.38' =>\t\t[undef,\tundef,\tundef], # not for MIME"
NSQ_SOURCE_LINE 00000189 "\t\t# We're making this one up to represent raw unencoded 8bit"
NSQ_SOURCE_LINE 00000190 "\t\t'8BIT' =>\t\t[undef,\t'B',\t'ISO-8859-1'],"
NSQ_SOURCE_LINE 00000191 "\t\t);"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "# Fix some unexpected or unpreferred names returned by"
NSQ_SOURCE_LINE 00000194 "# Encode::resolve_alias() or used by somebodies else."
NSQ_SOURCE_LINE 00000195 "my %CHARSET_ALIASES = (# unpreferred\t\tpreferred"
NSQ_SOURCE_LINE 00000196 "\t\t       \"ASCII\" =>\t\t\"US-ASCII\","
NSQ_SOURCE_LINE 00000197 "\t\t       \"BIG5-ETEN\" =>\t\t\"BIG5\","
NSQ_SOURCE_LINE 00000198 "\t\t       \"CP1250\" =>\t\t\"WINDOWS-1250\","
NSQ_SOURCE_LINE 00000199 "\t\t       \"CP1251\" =>\t\t\"WINDOWS-1251\","
NSQ_SOURCE_LINE 00000200 "\t\t       \"CP1252\" =>\t\t\"WINDOWS-1252\","
NSQ_SOURCE_LINE 00000201 "\t\t       \"CP1253\" =>\t\t\"WINDOWS-1253\","
NSQ_SOURCE_LINE 00000202 "\t\t       \"CP1254\" =>\t\t\"WINDOWS-1254\","
NSQ_SOURCE_LINE 00000203 "\t\t       \"CP1255\" =>\t\t\"WINDOWS-1255\","
NSQ_SOURCE_LINE 00000204 "\t\t       \"CP1256\" =>\t\t\"WINDOWS-1256\","
NSQ_SOURCE_LINE 00000205 "\t\t       \"CP1257\" =>\t\t\"WINDOWS-1257\","
NSQ_SOURCE_LINE 00000206 "\t\t       \"CP1258\" =>\t\t\"WINDOWS-1258\","
NSQ_SOURCE_LINE 00000207 "\t\t       \"CP874\" =>\t\t\"WINDOWS-874\","
NSQ_SOURCE_LINE 00000208 "\t\t       \"CP936\" =>\t\t\"GBK\","
NSQ_SOURCE_LINE 00000209 "\t\t       \"CP949\" =>\t\t\"KS_C_5601-1987\","
NSQ_SOURCE_LINE 00000210 "\t\t       \"DIN66003\" =>\t\t\"DIN_66003\","
NSQ_SOURCE_LINE 00000211 "\t\t       \"EUC-CN\" =>\t\t\"GB2312\","
NSQ_SOURCE_LINE 00000212 "\t\t       \"HZ\" =>\t\t\t\"HZ-GB-2312\", # RFC 1842"
NSQ_SOURCE_LINE 00000213 "\t\t       \"KS_C_5601\" =>\t\t\"KS_C_5601-1987\","
NSQ_SOURCE_LINE 00000214 "\t\t       \"SHIFTJIS\" =>\t\t\"SHIFT_JIS\","
NSQ_SOURCE_LINE 00000215 "\t\t       \"SHIFTJISX0213\" =>\t\"SHIFT_JISX0213\","
NSQ_SOURCE_LINE 00000216 "\t\t       \"TIS620\" =>\t\t\"TIS-620\", # IANA MIBenum 2259"
NSQ_SOURCE_LINE 00000217 "\t\t       \"UNICODE-1-1-UTF-7\" =>\t\"UTF-7\", # RFC 1642 (obs.)"
NSQ_SOURCE_LINE 00000218 "\t\t       \"UTF8\" =>\t\t\"UTF-8\","
NSQ_SOURCE_LINE 00000219 "\t\t       \"UTF-8-STRICT\" =>\t\"UTF-8\", # Perl internal use"
NSQ_SOURCE_LINE 00000220 "\t\t       \"GSM0338\" =>\t\t\"GSM03.38\", # not for MIME"
NSQ_SOURCE_LINE 00000221 "\t\t       );"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "# Some vendors encode characters beyond standardized mappings using extended"
NSQ_SOURCE_LINE 00000224 "# encoders.  Some other standard encoders need additional encode modules."
NSQ_SOURCE_LINE 00000225 "my %ENCODERS = ("
NSQ_SOURCE_LINE 00000226 "\t\t'EXTENDED' => {"
NSQ_SOURCE_LINE 00000227 "\t\t    'ISO-8859-1' => [['cp1252'], ],     # Encode::Byte"
NSQ_SOURCE_LINE 00000228 "\t\t    'ISO-8859-2' => [['cp1250'], ],     # Encode::Byte"
NSQ_SOURCE_LINE 00000229 "\t\t    'ISO-8859-5' => [['cp1251'], ],     # Encode::Byte"
NSQ_SOURCE_LINE 00000230 "\t\t    'ISO-8859-6' => ["
NSQ_SOURCE_LINE 00000231 "\t\t\t\t     ['cp1256'],        # Encode::Byte"
NSQ_SOURCE_LINE 00000232 "\t\t\t\t     # ['cp1006'],      # ditto, for Farsi"
NSQ_SOURCE_LINE 00000233 "\t\t\t\t    ],"
NSQ_SOURCE_LINE 00000234 "\t\t    'ISO-8859-6-I'=>[['cp1256'], ],     # ditto"
NSQ_SOURCE_LINE 00000235 "\t\t    'ISO-8859-7' => [['cp1253'], ],     # Encode::Byte"
NSQ_SOURCE_LINE 00000236 "\t\t    'ISO-8859-8' => [['cp1255'], ],     # Encode::Byte"
NSQ_SOURCE_LINE 00000237 "\t\t    'ISO-8859-8-I'=>[['cp1255'], ],     # ditto"
NSQ_SOURCE_LINE 00000238 "\t\t    'ISO-8859-9' => [['cp1254'], ],     # Encode::Byte"
NSQ_SOURCE_LINE 00000239 "\t\t    'ISO-8859-13'=> [['cp1257'], ],     # Encode::Byte"
NSQ_SOURCE_LINE 00000240 "\t\t    'GB2312'     => ["
NSQ_SOURCE_LINE 00000241 "\t\t\t\t     ['gb18030',\t'Encode::HanExtra'],"
NSQ_SOURCE_LINE 00000242 "\t\t\t\t     ['cp936'],\t\t# Encode::CN"
NSQ_SOURCE_LINE 00000243 "\t\t\t\t    ],"
NSQ_SOURCE_LINE 00000244 "\t\t    'EUC-JP'     => ["
NSQ_SOURCE_LINE 00000245 "\t\t\t\t     ['eucJP-ascii',\t'Encode::EUCJPASCII'],"
NSQ_SOURCE_LINE 00000246 "\t\t\t\t     # ['cp51932',\t'Encode::EUCJPMS'],"
NSQ_SOURCE_LINE 00000247 "\t\t\t\t    ],"
NSQ_SOURCE_LINE 00000248 "\t\t    'ISO-2022-JP'=> ["
NSQ_SOURCE_LINE 00000249 "\t\t\t\t     ['x-iso2022jp-ascii',"
NSQ_SOURCE_LINE 00000250 "\t\t\t\t      \t\t\t'Encode::EUCJPASCII'],"
NSQ_SOURCE_LINE 00000251 "\t\t\t\t     # ['iso-2022-jp-ms','Encode::ISO2022JPMS'],"
NSQ_SOURCE_LINE 00000252 "\t\t\t\t     # ['cp50220',      'Encode::EUCJPMS'],"
NSQ_SOURCE_LINE 00000253 "\t\t\t\t     # ['cp50221',      'Encode::EUCJPMS'],"
NSQ_SOURCE_LINE 00000254 "\t\t\t\t     ['iso-2022-jp-1'], # Encode::JP (note*)"
NSQ_SOURCE_LINE 00000255 "\t\t\t\t    ],"
NSQ_SOURCE_LINE 00000256 "\t\t    'SHIFT_JIS'  => ["
NSQ_SOURCE_LINE 00000257 "\t\t\t\t     ['cp932'],\t\t# Encode::JP"
NSQ_SOURCE_LINE 00000258 "\t\t\t\t    ],"
NSQ_SOURCE_LINE 00000259 "\t\t    'EUC-JISX0213'  => [['euc-jis-2004', 'Encode::JISX0213'], ],"
NSQ_SOURCE_LINE 00000260 "\t\t    'ISO-2022-JP-3' => [['iso-2022-jp-2004', 'Encode::JISX0213'], ],"
NSQ_SOURCE_LINE 00000261 "\t\t    'SHIFT_JISX0213'=> [['shift_jis-2004', 'Encode::ShiftJIS2004'], ],"
NSQ_SOURCE_LINE 00000262 "\t\t    'EUC-KR'     => [['cp949'], ],      # Encode::KR"
NSQ_SOURCE_LINE 00000263 "\t\t    'BIG5'       => ["
NSQ_SOURCE_LINE 00000264 "\t\t\t\t     # ['big5plus',     'Encode::HanExtra'],"
NSQ_SOURCE_LINE 00000265 "\t\t\t\t     # ['big5-2003',    'Encode::HanExtra'], "
NSQ_SOURCE_LINE 00000266 "\t\t\t\t     ['cp950'],         # Encode::TW"
NSQ_SOURCE_LINE 00000267 "\t\t\t\t     # ['big5-1984',    'Encode::HanExtra'], "
NSQ_SOURCE_LINE 00000268 "\t\t\t\t    ],"
NSQ_SOURCE_LINE 00000269 "\t\t    'TIS-620'    => [['cp874'], ],      # Encode::Byte"
NSQ_SOURCE_LINE 00000270 "\t\t    'UTF-8'      => [['utf8'], ],       # Special name on Perl"
NSQ_SOURCE_LINE 00000271 "\t\t},"
NSQ_SOURCE_LINE 00000272 "\t\t'STANDARD' => {"
NSQ_SOURCE_LINE 00000273 "\t\t    'DIN_66003'     => [['din66003', 'Endode::DIN66003'], ],"
NSQ_SOURCE_LINE 00000274 "\t\t    'ISO-8859-6-E'  => [['iso-8859-6'],],# Encode::Byte"
NSQ_SOURCE_LINE 00000275 "\t\t    'ISO-8859-6-I'  => [['iso-8859-6'],],# ditto"
NSQ_SOURCE_LINE 00000276 "\t\t    'ISO-8859-8-E'  => [['iso-8859-8'],],# Encode::Byte"
NSQ_SOURCE_LINE 00000277 "\t\t    'ISO-8859-8-I'  => [['iso-8859-8'],],# ditto"
NSQ_SOURCE_LINE 00000278 "\t\t    'GB18030'       => [['gb18030',     'Encode::HanExtra'], ],"
NSQ_SOURCE_LINE 00000279 "\t\t    'ISO-2022-JP-2' => [['iso-2022-jp-2','Encode::ISO2022JP2'], ],"
NSQ_SOURCE_LINE 00000280 "\t\t    'EUC-JISX0213'  => [['euc-jisx0213', 'Encode::JISX0213'], ],"
NSQ_SOURCE_LINE 00000281 "\t\t    'ISO-2022-JP-3' => [['iso-2022-jp-3', 'Encode::JISX0213'], ],"
NSQ_SOURCE_LINE 00000282 "\t\t    'EUC-JIS-2004'  => [['euc-jis-2004', 'Encode::JISX0213'], ],"
NSQ_SOURCE_LINE 00000283 "\t\t    'ISO-2022-JP-2004' => [['iso-2022-jp-2004', 'Encode::JISX0213'], ],"
NSQ_SOURCE_LINE 00000284 "\t\t    'SHIFT_JIS-2004'=> [['shift_jis-2004', 'Encode::ShiftJIS2004'], ],"
NSQ_SOURCE_LINE 00000285 "\t\t    'EUC-TW'        => [['euc-tw',      'Encode::HanExtra'], ],"
NSQ_SOURCE_LINE 00000286 "\t\t    'HZ-GB-2312'    => [['hz'], ],\t# Encode::CN"
NSQ_SOURCE_LINE 00000287 "\t\t    'TIS-620'       => [['tis620'], ],  # (note*)"
NSQ_SOURCE_LINE 00000288 "\t\t    'UTF-16'        => [['x-utf16auto', 'MIME::Charset::UTF'],],"
NSQ_SOURCE_LINE 00000289 "\t\t    'UTF-32'        => [['x-utf32auto', 'MIME::Charset::UTF'],],"
NSQ_SOURCE_LINE 00000290 "\t\t    'GSM03.38'      => [['gsm0338'], ],\t# Encode::GSM0338"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "\t\t    # (note*) ISO-8859-11 was not registered by IANA."
NSQ_SOURCE_LINE 00000293 "\t\t    # L<Encode> treats it as canonical name of ``tis-?620''."
NSQ_SOURCE_LINE 00000294 "\t\t},"
NSQ_SOURCE_LINE 00000295 ");"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "# ISO-2022-* escape sequences etc. to detect charset from unencoded data."
NSQ_SOURCE_LINE 00000298 "my @ESCAPE_SEQS = ( "
NSQ_SOURCE_LINE 00000299 "\t\t# ISO-2022-* sequences"
NSQ_SOURCE_LINE 00000300 "\t\t   # escape seq, possible charset"
NSQ_SOURCE_LINE 00000301 "\t\t   # Following sequences are commonly used."
NSQ_SOURCE_LINE 00000302 "\t\t   [\"\\033\\$\\@\",\t\"ISO-2022-JP\"],\t# RFC 1468"
NSQ_SOURCE_LINE 00000303 "\t\t   [\"\\033\\$B\",\t\"ISO-2022-JP\"],\t# ditto"
NSQ_SOURCE_LINE 00000304 "\t\t   [\"\\033(J\",\t\"ISO-2022-JP\"],\t# ditto"
NSQ_SOURCE_LINE 00000305 "\t\t   [\"\\033(I\",\t\"ISO-2022-JP\"],\t# ditto (nonstandard)"
NSQ_SOURCE_LINE 00000306 "\t\t   [\"\\033\\$(D\",\t\"ISO-2022-JP\"],\t# RFC 2237 (note*)"
NSQ_SOURCE_LINE 00000307 "\t\t   # Following sequences are less commonly used."
NSQ_SOURCE_LINE 00000308 "\t\t   [\"\\033.A\",   \"ISO-2022-JP-2\"], # RFC 1554"
NSQ_SOURCE_LINE 00000309 "\t\t   [\"\\033.F\",   \"ISO-2022-JP-2\"], # ditto"
NSQ_SOURCE_LINE 00000310 "\t\t   [\"\\033\\$(C\", \"ISO-2022-JP-2\"], # ditto"
NSQ_SOURCE_LINE 00000311 "\t\t   [\"\\033\\$(O\",\t\"ISO-2022-JP-3\"], # JIS X 0213:2000"
NSQ_SOURCE_LINE 00000312 "\t\t   [\"\\033\\$(P\",\t\"ISO-2022-JP-2004\"], # JIS X 0213:2000/2004"
NSQ_SOURCE_LINE 00000313 "\t\t   [\"\\033\\$(Q\",\t\"ISO-2022-JP-2004\"], # JIS X 0213:2004"
NSQ_SOURCE_LINE 00000314 "\t\t   [\"\\033\\$)C\",\t\"ISO-2022-KR\"],\t# RFC 1557"
NSQ_SOURCE_LINE 00000315 "\t\t   [\"\\033\\$)A\",\t\"ISO-2022-CN\"], # RFC 1922"
NSQ_SOURCE_LINE 00000316 "\t\t   [\"\\033\\$A\",\t\"ISO-2022-CN\"], # ditto (nonstandard)"
NSQ_SOURCE_LINE 00000317 "\t\t   [\"\\033\\$)G\",\t\"ISO-2022-CN\"], # ditto"
NSQ_SOURCE_LINE 00000318 "\t\t   [\"\\033\\$*H\",\t\"ISO-2022-CN\"], # ditto"
NSQ_SOURCE_LINE 00000319 "\t\t   # Other sequences will be used with appropriate charset"
NSQ_SOURCE_LINE 00000320 "\t\t   # parameters, or hardly used."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "\t\t   # note*: This RFC defines ISO-2022-JP-1, superset of "
NSQ_SOURCE_LINE 00000323 "\t\t   # ISO-2022-JP.  But that charset name is rarely used."
NSQ_SOURCE_LINE 00000324 "\t\t   # OTOH many of encoders for ISO-2022-JP recognize this"
NSQ_SOURCE_LINE 00000325 "\t\t   # sequence so that comatibility with EUC-JP will be"
NSQ_SOURCE_LINE 00000326 "\t\t   # guaranteed."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "\t\t# Singlebyte 7-bit sequences"
NSQ_SOURCE_LINE 00000329 "\t\t   # escape seq, possible charset"
NSQ_SOURCE_LINE 00000330 "\t\t   [\"\\033e\",\t\"GSM03.38\"],\t# ESTI GSM 03.38 (note*)"
NSQ_SOURCE_LINE 00000331 "\t\t   [\"\\033\\012\",\t\"GSM03.38\"],\t# ditto"
NSQ_SOURCE_LINE 00000332 "\t\t   [\"\\033<\",\t\"GSM03.38\"],\t# ditto"
NSQ_SOURCE_LINE 00000333 "\t\t   [\"\\033/\",\t\"GSM03.38\"],\t# ditto"
NSQ_SOURCE_LINE 00000334 "\t\t   [\"\\033>\",\t\"GSM03.38\"],\t# ditto"
NSQ_SOURCE_LINE 00000335 "\t\t   [\"\\033\\024\",\t\"GSM03.38\"],\t# ditto"
NSQ_SOURCE_LINE 00000336 "\t\t   [\"\\033(\",\t\"GSM03.38\"],\t# ditto"
NSQ_SOURCE_LINE 00000337 "\t\t   [\"\\033\\@\",\t\"GSM03.38\"],\t# ditto"
NSQ_SOURCE_LINE 00000338 "\t\t   [\"\\033)\",\t\"GSM03.38\"],\t# ditto"
NSQ_SOURCE_LINE 00000339 "\t\t   [\"\\033=\",\t\"GSM03.38\"],\t# ditto"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "\t\t   # note*: This is not used for MIME message."
NSQ_SOURCE_LINE 00000342 "\t\t  );"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "######## Public Configuration Attributes ########"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "$Config = {"
NSQ_SOURCE_LINE 00000347 "    Detect7bit =>      'YES',"
NSQ_SOURCE_LINE 00000348 "    Mapping =>         'EXTENDED',"
NSQ_SOURCE_LINE 00000349 "    Replacement =>     'DEFAULT',"
NSQ_SOURCE_LINE 00000350 "};"
NSQ_SOURCE_LINE 00000351 "local @INC = @INC;"
NSQ_SOURCE_LINE 00000352 "pop @INC if $INC[-1] eq '.';"
NSQ_SOURCE_LINE 00000353 "eval { require MIME::Charset::Defaults; };"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "######## Private Constants ########"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "my $NON7BITRE = qr{"
NSQ_SOURCE_LINE 00000358 "    [^\\x01-\\x7e]"
NSQ_SOURCE_LINE 00000359 "}x;"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "my $NONASCIIRE = qr{"
NSQ_SOURCE_LINE 00000362 "    [^\\x09\\x0a\\x0d\\x20\\x21-\\x7e]"
NSQ_SOURCE_LINE 00000363 "}x;"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "my $ISO2022RE = qr{"
NSQ_SOURCE_LINE 00000366 "    ISO-2022-.+"
NSQ_SOURCE_LINE 00000367 "}ix;"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "my $ASCIITRANSRE = qr{"
NSQ_SOURCE_LINE 00000370 "    HZ-GB-2312 | UTF-7"
NSQ_SOURCE_LINE 00000371 "}ix;"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "######## Public Functions ########"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "=head2 Constructor"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "=over"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=item $charset = MIME::Charset->new([CHARSET [, OPTS]])"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "Create charset object."
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "OPTS may accept following key-value pair."
NSQ_SOURCE_LINE 00000385 "B<NOTE>:"
NSQ_SOURCE_LINE 00000386 "When Unicode/multibyte support is disabled (see L<\"USE_ENCODE\">),"
NSQ_SOURCE_LINE 00000387 "conversion will not be performed.  So this option do not have any effects."
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "=over 4"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "=item Mapping => MAPTYPE"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "Whether to extend mappings actually used for charset names or not."
NSQ_SOURCE_LINE 00000394 "C<\"EXTENDED\"> uses extended mappings."
NSQ_SOURCE_LINE 00000395 "C<\"STANDARD\"> uses standardized strict mappings."
NSQ_SOURCE_LINE 00000396 "Default is C<\"EXTENDED\">."
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "=back"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "=cut"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "sub new {"
NSQ_SOURCE_LINE 00000403 "    my $class = shift;"
NSQ_SOURCE_LINE 00000404 "    my $charset = shift;"
NSQ_SOURCE_LINE 00000405 "    return bless {}, $class unless $charset;"
NSQ_SOURCE_LINE 00000406 "    return bless {}, $class if 75 < length $charset; # w/a for CPAN RT #65796."
NSQ_SOURCE_LINE 00000407 "    my %params = @_;"
NSQ_SOURCE_LINE 00000408 "    my $mapping = uc($params{'Mapping'} || $Config->{Mapping});"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "    if ($charset =~ /\\bhz.?gb.?2312$/i) {"
NSQ_SOURCE_LINE 00000411 "\t# workaround: \"HZ-GB-2312\" mistakenly treated as \"EUC-CN\" by Encode"
NSQ_SOURCE_LINE 00000412 "\t# (2.12)."
NSQ_SOURCE_LINE 00000413 "\t$charset = \"HZ-GB-2312\";"
NSQ_SOURCE_LINE 00000414 "    } elsif ($charset =~ /\\btis-?620$/i) {"
NSQ_SOURCE_LINE 00000415 "\t# workaround: \"TIS620\" treated as ISO-8859-11 by Encode."
NSQ_SOURCE_LINE 00000416 "\t# And \"TIS-620\" not known by some versions of Encode (cf."
NSQ_SOURCE_LINE 00000417 "\t# CPAN RT #20781)."
NSQ_SOURCE_LINE 00000418 "\t$charset = \"TIS-620\";"
NSQ_SOURCE_LINE 00000419 "    } elsif ($charset =~ /\\biso[-_]8859[-_]8[-_]i$/i) {"
NSQ_SOURCE_LINE 00000420 "\t# workaround: \"ISO-8859-8-I\" is treated as an alias of \"ISO-8859-8\""
NSQ_SOURCE_LINE 00000421 "\t# by Encode (3.19): See the note in"
NSQ_SOURCE_LINE 00000422 "\t# https://encoding.spec.whatwg.org/#legacy-single-byte-encodings"
NSQ_SOURCE_LINE 00000423 "\t# However we'll treat these as separate names for compatibility."
NSQ_SOURCE_LINE 00000424 "\t$charset = \"ISO-8859-8-I\";"
NSQ_SOURCE_LINE 00000425 "    } else {"
NSQ_SOURCE_LINE 00000426 "\t$charset = resolve_alias($charset) || $charset"
NSQ_SOURCE_LINE 00000427 "    }"
NSQ_SOURCE_LINE 00000428 "    $charset = $CHARSET_ALIASES{uc($charset)} || uc($charset);"
NSQ_SOURCE_LINE 00000429 "    my ($henc, $benc, $outcset);"
NSQ_SOURCE_LINE 00000430 "    my $spec = $CHARSETS{$charset};"
NSQ_SOURCE_LINE 00000431 "    if ($spec) {"
NSQ_SOURCE_LINE 00000432 "\t($henc, $benc, $outcset) ="
NSQ_SOURCE_LINE 00000433 "\t    ($$spec[0], $$spec[1], USE_ENCODE? $$spec[2]: undef);"
NSQ_SOURCE_LINE 00000434 "    } else {"
NSQ_SOURCE_LINE 00000435 "\t($henc, $benc, $outcset) = ('S', 'B', undef);"
NSQ_SOURCE_LINE 00000436 "    }"
NSQ_SOURCE_LINE 00000437 "    my ($decoder, $encoder);"
NSQ_SOURCE_LINE 00000438 "    if (USE_ENCODE) {"
NSQ_SOURCE_LINE 00000439 "\t$decoder = _find_encoder($charset, $mapping);"
NSQ_SOURCE_LINE 00000440 "\t$encoder = _find_encoder($outcset, $mapping);"
NSQ_SOURCE_LINE 00000441 "    } else {"
NSQ_SOURCE_LINE 00000442 "\t$decoder = $encoder = undef;"
NSQ_SOURCE_LINE 00000443 "    }"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "    bless {"
NSQ_SOURCE_LINE 00000446 "\tInputCharset => $charset,"
NSQ_SOURCE_LINE 00000447 "\tDecoder => $decoder,"
NSQ_SOURCE_LINE 00000448 "\tHeaderEncoding => $henc,"
NSQ_SOURCE_LINE 00000449 "\tBodyEncoding => $benc,"
NSQ_SOURCE_LINE 00000450 "\tOutputCharset => ($outcset || $charset),"
NSQ_SOURCE_LINE 00000451 "\tEncoder => ($encoder || $decoder),"
NSQ_SOURCE_LINE 00000452 "    }, $class;"
NSQ_SOURCE_LINE 00000453 "}"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "my %encoder_cache = ();"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "sub _find_encoder($$) {"
NSQ_SOURCE_LINE 00000458 "    my $charset = uc(shift || \"\");"
NSQ_SOURCE_LINE 00000459 "    return undef unless $charset;"
NSQ_SOURCE_LINE 00000460 "    my $mapping = uc(shift);"
NSQ_SOURCE_LINE 00000461 "    my ($spec, $name, $module, $encoder);"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "    local($@);"
NSQ_SOURCE_LINE 00000464 "    $encoder = $encoder_cache{$charset, $mapping};"
NSQ_SOURCE_LINE 00000465 "    return $encoder if ref $encoder;"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "    foreach my $m (('EXTENDED', 'STANDARD')) {"
NSQ_SOURCE_LINE 00000468 "\tnext if $m eq 'EXTENDED' and $mapping ne 'EXTENDED';"
NSQ_SOURCE_LINE 00000469 "\t$spec = $ENCODERS{$m}->{$charset};"
NSQ_SOURCE_LINE 00000470 "\tnext unless $spec;"
NSQ_SOURCE_LINE 00000471 "\tforeach my $s (@{$spec}) {"
NSQ_SOURCE_LINE 00000472 "\t    ($name, $module) = @{$s};"
NSQ_SOURCE_LINE 00000473 "\t    if ($module) {"
NSQ_SOURCE_LINE 00000474 "\t\tnext unless eval \"require $module;\";"
NSQ_SOURCE_LINE 00000475 "\t    }"
NSQ_SOURCE_LINE 00000476 "\t    $encoder = Encode::find_encoding($name);"
NSQ_SOURCE_LINE 00000477 "\t    last if ref $encoder;"
NSQ_SOURCE_LINE 00000478 "\t}"
NSQ_SOURCE_LINE 00000479 "\tlast if ref $encoder;"
NSQ_SOURCE_LINE 00000480 "    }"
NSQ_SOURCE_LINE 00000481 "    $encoder ||= Encode::find_encoding($charset);"
NSQ_SOURCE_LINE 00000482 "    $encoder_cache{$charset, $mapping} = $encoder if $encoder;"
NSQ_SOURCE_LINE 00000483 "    return $encoder;"
NSQ_SOURCE_LINE 00000484 "}"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "=back"
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "=head2 Getting Information of Charsets"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "=over"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "=item $charset->body_encoding"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "=item body_encoding CHARSET"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "Get recommended transfer-encoding of CHARSET for message body."
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "Returned value will be one of C<\"B\"> (BASE64), C<\"Q\"> (QUOTED-PRINTABLE),"
NSQ_SOURCE_LINE 00000499 "C<\"S\"> (shorter one of either) or"
NSQ_SOURCE_LINE 00000500 "C<undef> (might not be transfer-encoded; either 7BIT or 8BIT).  This may"
NSQ_SOURCE_LINE 00000501 "not be same as encoding for message header."
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "=cut"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "sub body_encoding($) {"
NSQ_SOURCE_LINE 00000506 "    my $self = shift;"
NSQ_SOURCE_LINE 00000507 "    return undef unless $self;"
NSQ_SOURCE_LINE 00000508 "    $self = __PACKAGE__->new($self) unless ref $self;"
NSQ_SOURCE_LINE 00000509 "    $self->{BodyEncoding};"
NSQ_SOURCE_LINE 00000510 "}"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "=item $charset->as_string"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=item canonical_charset CHARSET"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "Get canonical name for charset."
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "=cut"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "sub canonical_charset($) {"
NSQ_SOURCE_LINE 00000521 "    my $self = shift;"
NSQ_SOURCE_LINE 00000522 "    return undef unless $self;"
NSQ_SOURCE_LINE 00000523 "    $self = __PACKAGE__->new($self) unless ref $self;"
NSQ_SOURCE_LINE 00000524 "    $self->{InputCharset};"
NSQ_SOURCE_LINE 00000525 "}"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "sub as_string($) {"
NSQ_SOURCE_LINE 00000528 "    my $self = shift;"
NSQ_SOURCE_LINE 00000529 "    $self->{InputCharset};"
NSQ_SOURCE_LINE 00000530 "}"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "=item $charset->decoder"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "Get L<\"Encode::Encoding\"> object to decode strings to Unicode by charset."
NSQ_SOURCE_LINE 00000535 "If charset is not specified or not known by this module,"
NSQ_SOURCE_LINE 00000536 "undef will be returned."
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "=cut"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "sub decoder($) {"
NSQ_SOURCE_LINE 00000541 "    my $self = shift;"
NSQ_SOURCE_LINE 00000542 "    $self->{Decoder};"
NSQ_SOURCE_LINE 00000543 "}"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "=item $charset->dup"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "Get a copy of charset object."
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "=cut"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "sub dup($) {"
NSQ_SOURCE_LINE 00000552 "    my $self = shift;"
NSQ_SOURCE_LINE 00000553 "    my $obj = __PACKAGE__->new(undef);"
NSQ_SOURCE_LINE 00000554 "    %{$obj} = %{$self};"
NSQ_SOURCE_LINE 00000555 "    $obj;"
NSQ_SOURCE_LINE 00000556 "}"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "=item $charset->encoder([CHARSET])"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "Get L<\"Encode::Encoding\"> object to encode Unicode string using compatible"
NSQ_SOURCE_LINE 00000561 "charset recommended to be used for messages on Internet."
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "If optional CHARSET is specified, replace encoder (and output charset"
NSQ_SOURCE_LINE 00000564 "name) of $charset object with those of CHARSET, therefore,"
NSQ_SOURCE_LINE 00000565 "$charset object will be a converter between original charset and"
NSQ_SOURCE_LINE 00000566 "new CHARSET."
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "=cut"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "sub encoder($$;) {"
NSQ_SOURCE_LINE 00000571 "    my $self = shift;"
NSQ_SOURCE_LINE 00000572 "    my $charset = shift;"
NSQ_SOURCE_LINE 00000573 "    if ($charset) {"
NSQ_SOURCE_LINE 00000574 "\t$charset = __PACKAGE__->new($charset) unless ref $charset;"
NSQ_SOURCE_LINE 00000575 "\t$self->{OutputCharset} = $charset->{InputCharset};"
NSQ_SOURCE_LINE 00000576 "\t$self->{Encoder} = $charset->{Decoder};"
NSQ_SOURCE_LINE 00000577 "\t$self->{BodyEncoding} = $charset->{BodyEncoding};"
NSQ_SOURCE_LINE 00000578 "\t$self->{HeaderEncoding} = $charset->{HeaderEncoding};"
NSQ_SOURCE_LINE 00000579 "    }"
NSQ_SOURCE_LINE 00000580 "    $self->{Encoder};"
NSQ_SOURCE_LINE 00000581 "}"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "=item $charset->header_encoding"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "=item header_encoding CHARSET"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "Get recommended encoding scheme of CHARSET for message header."
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "Returned value will be one of C<\"B\">, C<\"Q\">, C<\"S\"> (shorter one of either)"
NSQ_SOURCE_LINE 00000590 "or C<undef> (might not be encoded).  This may not be same as encoding"
NSQ_SOURCE_LINE 00000591 "for message body."
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=cut"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "sub header_encoding($) {"
NSQ_SOURCE_LINE 00000596 "    my $self = shift;"
NSQ_SOURCE_LINE 00000597 "    return undef unless $self;"
NSQ_SOURCE_LINE 00000598 "    $self = __PACKAGE__->new($self) unless ref $self;"
NSQ_SOURCE_LINE 00000599 "    $self->{HeaderEncoding};"
NSQ_SOURCE_LINE 00000600 "}"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "=item $charset->output_charset"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "=item output_charset CHARSET"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "Get a charset which is compatible with given CHARSET and is recommended"
NSQ_SOURCE_LINE 00000607 "to be used for MIME messages on Internet (if it is known by this module)."
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "When Unicode/multibyte support is disabled (see L<\"USE_ENCODE\">),"
NSQ_SOURCE_LINE 00000610 "this function will simply"
NSQ_SOURCE_LINE 00000611 "return the result of L<\"canonical_charset\">."
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "=cut"
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "sub output_charset($) {"
NSQ_SOURCE_LINE 00000616 "    my $self = shift;"
NSQ_SOURCE_LINE 00000617 "    return undef unless $self;"
NSQ_SOURCE_LINE 00000618 "    $self = __PACKAGE__->new($self) unless ref $self;"
NSQ_SOURCE_LINE 00000619 "    $self->{OutputCharset};"
NSQ_SOURCE_LINE 00000620 "}"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "=back"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "=head2 Translating Text Data"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "=over"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "=item $charset->body_encode(STRING [, OPTS])"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "=item body_encode STRING, CHARSET [, OPTS]"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "Get converted (if needed) data of STRING and recommended transfer-encoding"
NSQ_SOURCE_LINE 00000633 "of that data for message body.  CHARSET is the charset by which STRING"
NSQ_SOURCE_LINE 00000634 "is encoded."
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "OPTS may accept following key-value pairs."
NSQ_SOURCE_LINE 00000637 "B<NOTE>:"
NSQ_SOURCE_LINE 00000638 "When Unicode/multibyte support is disabled (see L<\"USE_ENCODE\">),"
NSQ_SOURCE_LINE 00000639 "conversion will not be performed.  So these options do not have any effects."
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "=over 4"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "=item Detect7bit => YESNO"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "Try auto-detecting 7-bit charset when CHARSET is not given."
NSQ_SOURCE_LINE 00000646 "Default is C<\"YES\">."
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "=item Replacement => REPLACEMENT"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "Specifies error handling scheme.  See L<\"Error Handling\">."
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "=back"
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "3-item list of (I<converted string>, I<charset for output>,"
NSQ_SOURCE_LINE 00000655 "I<transfer-encoding>) will be returned."
NSQ_SOURCE_LINE 00000656 "I<Transfer-encoding> will be either C<\"BASE64\">, C<\"QUOTED-PRINTABLE\">,"
NSQ_SOURCE_LINE 00000657 "C<\"7BIT\"> or C<\"8BIT\">.  If I<charset for output> could not be determined"
NSQ_SOURCE_LINE 00000658 "and I<converted string> contains non-ASCII byte(s), I<charset for output> will"
NSQ_SOURCE_LINE 00000659 "be C<undef> and I<transfer-encoding> will be C<\"BASE64\">."
NSQ_SOURCE_LINE 00000660 "I<Charset for output> will be C<\"US-ASCII\"> if and only if string does not"
NSQ_SOURCE_LINE 00000661 "contain any non-ASCII bytes."
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "=cut"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "sub body_encode {"
NSQ_SOURCE_LINE 00000666 "    my $self = shift;"
NSQ_SOURCE_LINE 00000667 "    my $text;"
NSQ_SOURCE_LINE 00000668 "    if (ref $self) {"
NSQ_SOURCE_LINE 00000669 "\t$text = shift;"
NSQ_SOURCE_LINE 00000670 "    } else {"
NSQ_SOURCE_LINE 00000671 "\t$text = $self;"
NSQ_SOURCE_LINE 00000672 "\t$self = __PACKAGE__->new(shift);"
NSQ_SOURCE_LINE 00000673 "    }"
NSQ_SOURCE_LINE 00000674 "    my ($encoded, $charset) = $self->_text_encode($text, @_);"
NSQ_SOURCE_LINE 00000675 "    return ($encoded, undef, 'BASE64')"
NSQ_SOURCE_LINE 00000676 "\tunless $charset and $charset->{InputCharset};"
NSQ_SOURCE_LINE 00000677 "    my $cset = $charset->{OutputCharset};"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "    # Determine transfer-encoding."
NSQ_SOURCE_LINE 00000680 "    my $enc = $charset->{BodyEncoding};"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "    if (!$enc and $encoded !~ /\\x00/) {\t# Eliminate hostile NUL character."
NSQ_SOURCE_LINE 00000683 "        if ($encoded =~ $NON7BITRE) {\t# String contains 8bit char(s)."
NSQ_SOURCE_LINE 00000684 "            $enc = '8BIT';"
NSQ_SOURCE_LINE 00000685 "\t} elsif ($cset =~ /^($ISO2022RE|$ASCIITRANSRE)$/) {\t# 7BIT."
NSQ_SOURCE_LINE 00000686 "            $enc = '7BIT';"
NSQ_SOURCE_LINE 00000687 "        } else {\t\t\t# Pure ASCII."
NSQ_SOURCE_LINE 00000688 "            $enc = '7BIT';"
NSQ_SOURCE_LINE 00000689 "            $cset = 'US-ASCII';"
NSQ_SOURCE_LINE 00000690 "        }"
NSQ_SOURCE_LINE 00000691 "    } elsif ($enc eq 'S') {"
NSQ_SOURCE_LINE 00000692 "\t$enc = _resolve_S($encoded, 1);"
NSQ_SOURCE_LINE 00000693 "    } elsif ($enc eq 'B') {"
NSQ_SOURCE_LINE 00000694 "        $enc = 'BASE64';"
NSQ_SOURCE_LINE 00000695 "    } elsif ($enc eq 'Q') {"
NSQ_SOURCE_LINE 00000696 "        $enc = 'QUOTED-PRINTABLE';"
NSQ_SOURCE_LINE 00000697 "    } else {"
NSQ_SOURCE_LINE 00000698 "        $enc = 'BASE64';"
NSQ_SOURCE_LINE 00000699 "    }"
NSQ_SOURCE_LINE 00000700 "    return ($encoded, $cset, $enc);"
NSQ_SOURCE_LINE 00000701 "}"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "=item $charset->decode(STRING [,CHECK])"
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "Decode STRING to Unicode."
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "B<Note>:"
NSQ_SOURCE_LINE 00000708 "When Unicode/multibyte support is disabled (see L<\"USE_ENCODE\">),"
NSQ_SOURCE_LINE 00000709 "this function will die."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "=cut"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "sub decode($$$;) {"
NSQ_SOURCE_LINE 00000714 "    my $self = shift;"
NSQ_SOURCE_LINE 00000715 "    my $s = shift;"
NSQ_SOURCE_LINE 00000716 "    my $check = shift || 0;"
NSQ_SOURCE_LINE 00000717 "    $self->{Decoder}->decode($s, $check);"
NSQ_SOURCE_LINE 00000718 "}"
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "=item detect_7bit_charset STRING"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "Guess 7-bit charset that may encode a string STRING."
NSQ_SOURCE_LINE 00000723 "If STRING contains any 8-bit bytes, C<undef> will be returned."
NSQ_SOURCE_LINE 00000724 "Otherwise, Default Charset will be returned for unknown charset."
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "=cut"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "sub detect_7bit_charset($) {"
NSQ_SOURCE_LINE 00000729 "    return $DEFAULT_CHARSET unless &USE_ENCODE;"
NSQ_SOURCE_LINE 00000730 "    my $s = shift;"
NSQ_SOURCE_LINE 00000731 "    return $DEFAULT_CHARSET unless $s;"
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "    # Non-7bit string"
NSQ_SOURCE_LINE 00000734 "    return undef if $s =~ $NON7BITRE;"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "    # Try to detect 7-bit escape sequences."
NSQ_SOURCE_LINE 00000737 "    foreach (@ESCAPE_SEQS) {"
NSQ_SOURCE_LINE 00000738 "\tmy ($seq, $cset) = @$_;"
NSQ_SOURCE_LINE 00000739 "\tif (index($s, $seq) >= 0) {"
NSQ_SOURCE_LINE 00000740 "            my $decoder = __PACKAGE__->new($cset);"
NSQ_SOURCE_LINE 00000741 "            next unless $decoder->{Decoder};"
NSQ_SOURCE_LINE 00000742 "            eval {"
NSQ_SOURCE_LINE 00000743 "\t\tmy $dummy = $s;"
NSQ_SOURCE_LINE 00000744 "\t\t$decoder->decode($dummy, FB_CROAK());"
NSQ_SOURCE_LINE 00000745 "\t    };"
NSQ_SOURCE_LINE 00000746 "\t    if ($@) {"
NSQ_SOURCE_LINE 00000747 "\t\tnext;"
NSQ_SOURCE_LINE 00000748 "\t    }"
NSQ_SOURCE_LINE 00000749 "\t    return $decoder->{InputCharset};"
NSQ_SOURCE_LINE 00000750 "\t}"
NSQ_SOURCE_LINE 00000751 "    }"
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "    # How about HZ, VIQR, UTF-7, ...?"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "    return $DEFAULT_CHARSET;"
NSQ_SOURCE_LINE 00000756 "}"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "sub _detect_7bit_charset {"
NSQ_SOURCE_LINE 00000759 "    detect_7bit_charset(@_);"
NSQ_SOURCE_LINE 00000760 "}"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "=item $charset->encode(STRING [, CHECK])"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "Encode STRING (Unicode or non-Unicode) using compatible charset recommended"
NSQ_SOURCE_LINE 00000765 "to be used for messages on Internet (if this module knows it)."
NSQ_SOURCE_LINE 00000766 "Note that string will be decoded to Unicode then encoded even if compatible charset"
NSQ_SOURCE_LINE 00000767 "was equal to original charset."
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "B<Note>:"
NSQ_SOURCE_LINE 00000770 "When Unicode/multibyte support is disabled (see L<\"USE_ENCODE\">),"
NSQ_SOURCE_LINE 00000771 "this function will die."
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "=cut"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "sub encode($$$;) {"
NSQ_SOURCE_LINE 00000776 "    my $self = shift;"
NSQ_SOURCE_LINE 00000777 "    my $s = shift;"
NSQ_SOURCE_LINE 00000778 "    my $check = shift || 0;"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "    unless (is_utf8($s) or $s =~ /[^\\x00-\\xFF]/) {"
NSQ_SOURCE_LINE 00000781 "\t$s = $self->{Decoder}->decode($s, ($check & 0x1)? FB_CROAK(): 0);"
NSQ_SOURCE_LINE 00000782 "    }"
NSQ_SOURCE_LINE 00000783 "    my $enc = $self->{Encoder}->encode($s, $check);"
NSQ_SOURCE_LINE 00000784 "    Encode::_utf8_off($enc) if is_utf8($enc); # workaround for RT #35120"
NSQ_SOURCE_LINE 00000785 "    $enc;"
NSQ_SOURCE_LINE 00000786 "}"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "=item $charset->encoded_header_len(STRING [, ENCODING])"
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "=item encoded_header_len STRING, ENCODING, CHARSET"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "Get length of encoded STRING for message header"
NSQ_SOURCE_LINE 00000793 "(without folding)."
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "ENCODING may be one of C<\"B\">, C<\"Q\"> or C<\"S\"> (shorter"
NSQ_SOURCE_LINE 00000796 "one of either C<\"B\"> or C<\"Q\">)."
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 "=cut"
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "sub encoded_header_len($$$;) {"
NSQ_SOURCE_LINE 00000801 "    my $self = shift;"
NSQ_SOURCE_LINE 00000802 "    my ($encoding, $s);"
NSQ_SOURCE_LINE 00000803 "    if (ref $self) {"
NSQ_SOURCE_LINE 00000804 "\t$s = shift;"
NSQ_SOURCE_LINE 00000805 "\t$encoding = uc(shift || $self->{HeaderEncoding});"
NSQ_SOURCE_LINE 00000806 "    } else {"
NSQ_SOURCE_LINE 00000807 "\t$s = $self;"
NSQ_SOURCE_LINE 00000808 "\t$encoding = uc(shift);"
NSQ_SOURCE_LINE 00000809 "\t$self  = shift;"
NSQ_SOURCE_LINE 00000810 "\t$self = __PACKAGE__->new($self) unless ref $self;"
NSQ_SOURCE_LINE 00000811 "    }"
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "    #FIXME:$encoding === undef"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "    my $enclen;"
NSQ_SOURCE_LINE 00000816 "    if ($encoding eq 'Q') {"
NSQ_SOURCE_LINE 00000817 "        $enclen = _enclen_Q($s);"
NSQ_SOURCE_LINE 00000818 "    } elsif ($encoding eq 'S' and _resolve_S($s) eq 'Q') {"
NSQ_SOURCE_LINE 00000819 "\t$enclen = _enclen_Q($s);"
NSQ_SOURCE_LINE 00000820 "    } else { # \"B\""
NSQ_SOURCE_LINE 00000821 "        $enclen = _enclen_B($s);"
NSQ_SOURCE_LINE 00000822 "    }"
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "    length($self->{OutputCharset})+$enclen+7;"
NSQ_SOURCE_LINE 00000825 "}"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "sub _enclen_B($) {"
NSQ_SOURCE_LINE 00000828 "    int((length(shift) + 2) / 3) * 4;"
NSQ_SOURCE_LINE 00000829 "}"
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "sub _enclen_Q($;$) {"
NSQ_SOURCE_LINE 00000832 "    my $s = shift;"
NSQ_SOURCE_LINE 00000833 "    my $in_body = shift;"
NSQ_SOURCE_LINE 00000834 "    my @o;"
NSQ_SOURCE_LINE 00000835 "    if ($in_body) {"
NSQ_SOURCE_LINE 00000836 "\t@o = ($s =~ m{([^-\\t\\r\\n !*+/0-9A-Za-z])}go);"
NSQ_SOURCE_LINE 00000837 "    } else {"
NSQ_SOURCE_LINE 00000838 "\t@o = ($s =~ m{([^- !*+/0-9A-Za-z])}gos);"
NSQ_SOURCE_LINE 00000839 "    }"
NSQ_SOURCE_LINE 00000840 "    length($s) + scalar(@o) * 2;"
NSQ_SOURCE_LINE 00000841 "}"
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "sub _resolve_S($;$) {"
NSQ_SOURCE_LINE 00000844 "    my $s = shift;"
NSQ_SOURCE_LINE 00000845 "    my $in_body = shift;"
NSQ_SOURCE_LINE 00000846 "    my $e;"
NSQ_SOURCE_LINE 00000847 "    if ($in_body) {"
NSQ_SOURCE_LINE 00000848 "\t$e = scalar(() = $s =~ m{[^-\\t\\r\\n !*+/0-9A-Za-z]}g);"
NSQ_SOURCE_LINE 00000849 "\treturn (length($s) + 8 < $e * 6) ? 'BASE64' : 'QUOTED-PRINTABLE';"
NSQ_SOURCE_LINE 00000850 "    } else {"
NSQ_SOURCE_LINE 00000851 "\t$e = scalar(() = $s =~ m{[^- !*+/0-9A-Za-z]}g);"
NSQ_SOURCE_LINE 00000852 "\treturn (length($s) + 8 < $e * 6) ? 'B' : 'Q';"
NSQ_SOURCE_LINE 00000853 "    }"
NSQ_SOURCE_LINE 00000854 "}"
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "=item $charset->header_encode(STRING [, OPTS])"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "=item header_encode STRING, CHARSET [, OPTS]"
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 "Get converted (if needed) data of STRING and recommended encoding scheme of"
NSQ_SOURCE_LINE 00000861 "that data for message headers.  CHARSET is the charset by which STRING"
NSQ_SOURCE_LINE 00000862 "is encoded."
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "OPTS may accept following key-value pairs."
NSQ_SOURCE_LINE 00000865 "B<NOTE>:"
NSQ_SOURCE_LINE 00000866 "When Unicode/multibyte support is disabled (see L<\"USE_ENCODE\">),"
NSQ_SOURCE_LINE 00000867 "conversion will not be performed.  So these options do not have any effects."
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "=over 4"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "=item Detect7bit => YESNO"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "Try auto-detecting 7-bit charset when CHARSET is not given."
NSQ_SOURCE_LINE 00000874 "Default is C<\"YES\">."
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "=item Replacement => REPLACEMENT"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "Specifies error handling scheme.  See L<\"Error Handling\">."
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "=back"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "3-item list of (I<converted string>, I<charset for output>,"
NSQ_SOURCE_LINE 00000883 "I<encoding scheme>) will be returned.  I<Encoding scheme> will be"
NSQ_SOURCE_LINE 00000884 "either C<\"B\">, C<\"Q\"> or C<undef> (might not be encoded)."
NSQ_SOURCE_LINE 00000885 "If I<charset for output> could not be determined and I<converted string>"
NSQ_SOURCE_LINE 00000886 "contains non-ASCII byte(s), I<charset for output> will be C<\"8BIT\">"
NSQ_SOURCE_LINE 00000887 "(this is I<not> charset name but a special value to represent unencodable"
NSQ_SOURCE_LINE 00000888 "data) and I<encoding scheme> will be C<undef> (should not be encoded)."
NSQ_SOURCE_LINE 00000889 "I<Charset for output> will be C<\"US-ASCII\"> if and only if string does not"
NSQ_SOURCE_LINE 00000890 "contain any non-ASCII bytes."
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "=cut"
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "sub header_encode {"
NSQ_SOURCE_LINE 00000895 "    my $self = shift;"
NSQ_SOURCE_LINE 00000896 "    my $text;"
NSQ_SOURCE_LINE 00000897 "    if (ref $self) {"
NSQ_SOURCE_LINE 00000898 "\t$text = shift;"
NSQ_SOURCE_LINE 00000899 "    } else {"
NSQ_SOURCE_LINE 00000900 "\t$text = $self;"
NSQ_SOURCE_LINE 00000901 "\t$self = __PACKAGE__->new(shift);"
NSQ_SOURCE_LINE 00000902 "    }"
NSQ_SOURCE_LINE 00000903 "    my ($encoded, $charset) = $self->_text_encode($text, @_);"
NSQ_SOURCE_LINE 00000904 "    return ($encoded, '8BIT', undef)"
NSQ_SOURCE_LINE 00000905 "\tunless $charset and $charset->{InputCharset};"
NSQ_SOURCE_LINE 00000906 "    my $cset = $charset->{OutputCharset};"
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "    # Determine encoding scheme."
NSQ_SOURCE_LINE 00000909 "    my $enc = $charset->{HeaderEncoding};"
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "    if (!$enc and $encoded !~ $NON7BITRE) {"
NSQ_SOURCE_LINE 00000912 "\tunless ($cset =~ /^($ISO2022RE|$ASCIITRANSRE)$/) {\t# 7BIT."
NSQ_SOURCE_LINE 00000913 "            $cset = 'US-ASCII';"
NSQ_SOURCE_LINE 00000914 "        }"
NSQ_SOURCE_LINE 00000915 "    } elsif ($enc eq 'S') {"
NSQ_SOURCE_LINE 00000916 "\t$enc = _resolve_S($encoded);"
NSQ_SOURCE_LINE 00000917 "    } elsif ($enc !~ /^[BQ]$/) {"
NSQ_SOURCE_LINE 00000918 "        $enc = 'B';"
NSQ_SOURCE_LINE 00000919 "    }"
NSQ_SOURCE_LINE 00000920 "    return ($encoded, $cset, $enc);"
NSQ_SOURCE_LINE 00000921 "}"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "sub _text_encode {"
NSQ_SOURCE_LINE 00000924 "    my $charset = shift;"
NSQ_SOURCE_LINE 00000925 "    my $s = shift;"
NSQ_SOURCE_LINE 00000926 "    my %params = @_;"
NSQ_SOURCE_LINE 00000927 "    my $replacement = uc($params{'Replacement'} || $Config->{Replacement});"
NSQ_SOURCE_LINE 00000928 "    my $detect7bit = uc($params{'Detect7bit'} || $Config->{Detect7bit});"
NSQ_SOURCE_LINE 00000929 "    my $encoding = $params{'Encoding'} ||"
NSQ_SOURCE_LINE 00000930 "\t(exists $params{'Encoding'}? undef: 'A'); # undocumented"
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "    if (!$encoding or $encoding ne 'A') { # no 7-bit auto-detection"
NSQ_SOURCE_LINE 00000933 "\t$detect7bit = 'NO';"
NSQ_SOURCE_LINE 00000934 "    }"
NSQ_SOURCE_LINE 00000935 "    unless ($charset->{InputCharset}) {"
NSQ_SOURCE_LINE 00000936 "\tif ($s =~ $NON7BITRE) {"
NSQ_SOURCE_LINE 00000937 "\t    return ($s, undef);"
NSQ_SOURCE_LINE 00000938 "\t} elsif ($detect7bit ne \"NO\") {"
NSQ_SOURCE_LINE 00000939 "\t    $charset = __PACKAGE__->new(&detect_7bit_charset($s));"
NSQ_SOURCE_LINE 00000940 "\t} else {"
NSQ_SOURCE_LINE 00000941 "\t    $charset = __PACKAGE__->new($DEFAULT_CHARSET,"
NSQ_SOURCE_LINE 00000942 "\t\t\t\t\tMapping => 'STANDARD');"
NSQ_SOURCE_LINE 00000943 "\t} "
NSQ_SOURCE_LINE 00000944 "    }"
NSQ_SOURCE_LINE 00000945 "    if (!$encoding or $encoding ne 'A') { # no conversion"
NSQ_SOURCE_LINE 00000946 "\t$charset = $charset->dup;"
NSQ_SOURCE_LINE 00000947 "\t$charset->encoder($charset);"
NSQ_SOURCE_LINE 00000948 "\t$charset->{HeaderEncoding} = $encoding;"
NSQ_SOURCE_LINE 00000949 "\t$charset->{BodyEncoding} = $encoding;"
NSQ_SOURCE_LINE 00000950 "    }"
NSQ_SOURCE_LINE 00000951 "    my $check = ($replacement and $replacement =~ /^\\d+$/)?"
NSQ_SOURCE_LINE 00000952 "\t$replacement:"
NSQ_SOURCE_LINE 00000953 "    {"
NSQ_SOURCE_LINE 00000954 "\t'CROAK' => FB_CROAK(),"
NSQ_SOURCE_LINE 00000955 "\t'STRICT' => FB_CROAK(),"
NSQ_SOURCE_LINE 00000956 "\t'FALLBACK' => FB_CROAK(), # special"
NSQ_SOURCE_LINE 00000957 "\t'PERLQQ' => FB_PERLQQ(),"
NSQ_SOURCE_LINE 00000958 "\t'HTMLCREF' => FB_HTMLCREF(),"
NSQ_SOURCE_LINE 00000959 "\t'XMLCREF' => FB_XMLCREF(),"
NSQ_SOURCE_LINE 00000960 "    }->{$replacement || \"\"} || 0;"
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "    # Encode data by output charset if required.  If failed, fallback to"
NSQ_SOURCE_LINE 00000963 "    # fallback charset."
NSQ_SOURCE_LINE 00000964 "    my $encoded;"
NSQ_SOURCE_LINE 00000965 "    if (is_utf8($s) or $s =~ /[^\\x00-\\xFF]/ or"
NSQ_SOURCE_LINE 00000966 "\t($charset->{InputCharset} || \"\") ne ($charset->{OutputCharset} || \"\")) {"
NSQ_SOURCE_LINE 00000967 "\tif ($check & 0x1) { # CROAK or FALLBACK"
NSQ_SOURCE_LINE 00000968 "\t    eval {"
NSQ_SOURCE_LINE 00000969 "\t\t$encoded = $s;"
NSQ_SOURCE_LINE 00000970 "\t\t$encoded = $charset->encode($encoded, FB_CROAK());"
NSQ_SOURCE_LINE 00000971 "\t    };"
NSQ_SOURCE_LINE 00000972 "\t    if ($@) {"
NSQ_SOURCE_LINE 00000973 "\t\tif ($replacement eq \"FALLBACK\" and $FALLBACK_CHARSET) {"
NSQ_SOURCE_LINE 00000974 "\t\t    my $cset = __PACKAGE__->new($FALLBACK_CHARSET,"
NSQ_SOURCE_LINE 00000975 "\t\t\t\t\t\tMapping => 'STANDARD');"
NSQ_SOURCE_LINE 00000976 "\t\t    # croak unknown charset"
NSQ_SOURCE_LINE 00000977 "\t\t    croak \"unknown charset ``$FALLBACK_CHARSET''\""
NSQ_SOURCE_LINE 00000978 "\t\t\tunless $cset->{Decoder};"
NSQ_SOURCE_LINE 00000979 "\t\t    # charset translation"
NSQ_SOURCE_LINE 00000980 "\t\t    $charset = $charset->dup;"
NSQ_SOURCE_LINE 00000981 "\t\t    $charset->encoder($cset);"
NSQ_SOURCE_LINE 00000982 "\t\t    $encoded = $s;"
NSQ_SOURCE_LINE 00000983 "\t\t    $encoded = $charset->encode($encoded, 0);"
NSQ_SOURCE_LINE 00000984 "\t\t    # replace input & output charsets with fallback charset"
NSQ_SOURCE_LINE 00000985 "\t\t    $cset->encoder($cset);"
NSQ_SOURCE_LINE 00000986 "\t\t    $charset = $cset;"
NSQ_SOURCE_LINE 00000987 "\t\t} else {"
NSQ_SOURCE_LINE 00000988 "\t\t    $@ =~ s/ at .+$//;"
NSQ_SOURCE_LINE 00000989 "\t\t    croak $@;"
NSQ_SOURCE_LINE 00000990 "\t\t}"
NSQ_SOURCE_LINE 00000991 "\t    }"
NSQ_SOURCE_LINE 00000992 "\t} else {"
NSQ_SOURCE_LINE 00000993 "\t    $encoded = $s;"
NSQ_SOURCE_LINE 00000994 "\t    $encoded = $charset->encode($encoded, $check);"
NSQ_SOURCE_LINE 00000995 "\t}"
NSQ_SOURCE_LINE 00000996 "    } else {"
NSQ_SOURCE_LINE 00000997 "        $encoded = $s;"
NSQ_SOURCE_LINE 00000998 "    }"
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "    if ($encoded !~ /$NONASCIIRE/) { # maybe ASCII"
NSQ_SOURCE_LINE 00001001 "\t# check ``ASCII transformation'' charsets"
NSQ_SOURCE_LINE 00001002 "\tif ($charset->{OutputCharset} =~ /^($ASCIITRANSRE)$/) {"
NSQ_SOURCE_LINE 00001003 "\t    my $u = $encoded;"
NSQ_SOURCE_LINE 00001004 "\t    if (USE_ENCODE) {"
NSQ_SOURCE_LINE 00001005 "\t\t$u = $charset->encoder->decode($encoded); # dec. by output"
NSQ_SOURCE_LINE 00001006 "\t    } elsif ($encoded =~ /[+~]/) { # workaround for pre-Encode env."
NSQ_SOURCE_LINE 00001007 "\t\t$u = \"x$u\";"
NSQ_SOURCE_LINE 00001008 "\t    }"
NSQ_SOURCE_LINE 00001009 "\t    if ($u eq $encoded) {"
NSQ_SOURCE_LINE 00001010 "\t\t$charset = $charset->dup;"
NSQ_SOURCE_LINE 00001011 "\t\t$charset->encoder($DEFAULT_CHARSET);"
NSQ_SOURCE_LINE 00001012 "\t    }"
NSQ_SOURCE_LINE 00001013 "\t} elsif ($charset->{OutputCharset} ne \"US-ASCII\") {"
NSQ_SOURCE_LINE 00001014 "\t    $charset = $charset->dup;"
NSQ_SOURCE_LINE 00001015 "\t    $charset->encoder($DEFAULT_CHARSET);"
NSQ_SOURCE_LINE 00001016 "\t}"
NSQ_SOURCE_LINE 00001017 "    }"
NSQ_SOURCE_LINE 00001018 ""
NSQ_SOURCE_LINE 00001019 "    return ($encoded, $charset);"
NSQ_SOURCE_LINE 00001020 "}"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "=item $charset->undecode(STRING [,CHECK])"
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "Encode Unicode string STRING to byte string by input charset of $charset."
NSQ_SOURCE_LINE 00001025 "This is equivalent to C<$charset-E<gt>decoder-E<gt>encode()>."
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "B<Note>:"
NSQ_SOURCE_LINE 00001028 "When Unicode/multibyte support is disabled (see L<\"USE_ENCODE\">),"
NSQ_SOURCE_LINE 00001029 "this function will die."
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "=cut"
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 "sub undecode($$$;) {"
NSQ_SOURCE_LINE 00001034 "    my $self = shift;"
NSQ_SOURCE_LINE 00001035 "    my $s = shift;"
NSQ_SOURCE_LINE 00001036 "    my $check = shift || 0;"
NSQ_SOURCE_LINE 00001037 "    my $enc = $self->{Decoder}->encode($s, $check);"
NSQ_SOURCE_LINE 00001038 "    Encode::_utf8_off($enc); # workaround for RT #35120"
NSQ_SOURCE_LINE 00001039 "    $enc;"
NSQ_SOURCE_LINE 00001040 "}"
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "=back"
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 "=head2 Manipulating Module Defaults"
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "=over"
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "=item alias ALIAS [, CHARSET]"
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "Get/set charset alias for canonical names determined by"
NSQ_SOURCE_LINE 00001051 "L<\"canonical_charset\">."
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "If CHARSET is given and isn't false, ALIAS will be assigned as an alias of"
NSQ_SOURCE_LINE 00001054 "CHARSET.  Otherwise, alias won't be changed.  In both cases,"
NSQ_SOURCE_LINE 00001055 "current charset name that ALIAS is assigned will be returned."
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "=cut"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "sub alias ($;$) {"
NSQ_SOURCE_LINE 00001060 "    my $alias = uc(shift);"
NSQ_SOURCE_LINE 00001061 "    my $charset = uc(shift);"
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "    return $CHARSET_ALIASES{$alias} unless $charset;"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "    $CHARSET_ALIASES{$alias} = $charset;"
NSQ_SOURCE_LINE 00001066 "    return $charset;"
NSQ_SOURCE_LINE 00001067 "}"
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "=item default [CHARSET]"
NSQ_SOURCE_LINE 00001070 ""
NSQ_SOURCE_LINE 00001071 "Get/set default charset."
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "B<Default charset> is used by this module when charset context is"
NSQ_SOURCE_LINE 00001074 "unknown.  Modules using this module are recommended to use this"
NSQ_SOURCE_LINE 00001075 "charset when charset context is unknown or implicit default is"
NSQ_SOURCE_LINE 00001076 "expected.  By default, it is C<\"US-ASCII\">."
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 "If CHARSET is given and isn't false, it will be set to default charset."
NSQ_SOURCE_LINE 00001079 "Otherwise, default charset won't be changed.  In both cases,"
NSQ_SOURCE_LINE 00001080 "current default charset will be returned."
NSQ_SOURCE_LINE 00001081 ""
NSQ_SOURCE_LINE 00001082 "B<NOTE>: Default charset I<should not> be changed."
NSQ_SOURCE_LINE 00001083 ""
NSQ_SOURCE_LINE 00001084 "=cut"
NSQ_SOURCE_LINE 00001085 ""
NSQ_SOURCE_LINE 00001086 "sub default(;$) {"
NSQ_SOURCE_LINE 00001087 "    my $charset = &canonical_charset(shift);"
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "    if ($charset) {"
NSQ_SOURCE_LINE 00001090 "\tcroak \"Unknown charset '$charset'\""
NSQ_SOURCE_LINE 00001091 "\t    unless resolve_alias($charset);"
NSQ_SOURCE_LINE 00001092 "\t$DEFAULT_CHARSET = $charset;"
NSQ_SOURCE_LINE 00001093 "    }"
NSQ_SOURCE_LINE 00001094 "    return $DEFAULT_CHARSET;"
NSQ_SOURCE_LINE 00001095 "}"
NSQ_SOURCE_LINE 00001096 ""
NSQ_SOURCE_LINE 00001097 "=item fallback [CHARSET]"
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "Get/set fallback charset."
NSQ_SOURCE_LINE 00001100 ""
NSQ_SOURCE_LINE 00001101 "B<Fallback charset> is used by this module when conversion by given"
NSQ_SOURCE_LINE 00001102 "charset is failed and C<\"FALLBACK\"> error handling scheme is specified."
NSQ_SOURCE_LINE 00001103 "Modules using this module may use this charset as last resort of charset"
NSQ_SOURCE_LINE 00001104 "for conversion.  By default, it is C<\"UTF-8\">."
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 "If CHARSET is given and isn't false, it will be set to fallback charset."
NSQ_SOURCE_LINE 00001107 "If CHARSET is C<\"NONE\">, fallback charset will be undefined."
NSQ_SOURCE_LINE 00001108 "Otherwise, fallback charset won't be changed.  In any cases,"
NSQ_SOURCE_LINE 00001109 "current fallback charset will be returned."
NSQ_SOURCE_LINE 00001110 ""
NSQ_SOURCE_LINE 00001111 "B<NOTE>: It I<is> useful that C<\"US-ASCII\"> is specified as fallback charset,"
NSQ_SOURCE_LINE 00001112 "since result of conversion will be readable without charset information."
NSQ_SOURCE_LINE 00001113 ""
NSQ_SOURCE_LINE 00001114 "=cut"
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "sub fallback(;$) {"
NSQ_SOURCE_LINE 00001117 "    my $charset = &canonical_charset(shift);"
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 "    if ($charset eq \"NONE\") {"
NSQ_SOURCE_LINE 00001120 "\t$FALLBACK_CHARSET = undef;"
NSQ_SOURCE_LINE 00001121 "    } elsif ($charset) {"
NSQ_SOURCE_LINE 00001122 "\tcroak \"Unknown charset '$charset'\""
NSQ_SOURCE_LINE 00001123 "\t    unless resolve_alias($charset);"
NSQ_SOURCE_LINE 00001124 "\t$FALLBACK_CHARSET = $charset;"
NSQ_SOURCE_LINE 00001125 "    }"
NSQ_SOURCE_LINE 00001126 "    return $FALLBACK_CHARSET;"
NSQ_SOURCE_LINE 00001127 "}"
NSQ_SOURCE_LINE 00001128 ""
NSQ_SOURCE_LINE 00001129 "=item recommended CHARSET [, HEADERENC, BODYENC [, ENCCHARSET]]"
NSQ_SOURCE_LINE 00001130 ""
NSQ_SOURCE_LINE 00001131 "Get/set charset profiles."
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "If optional arguments are given and any of them are not false, profiles"
NSQ_SOURCE_LINE 00001134 "for CHARSET will be set by those arguments.  Otherwise, profiles"
NSQ_SOURCE_LINE 00001135 "won't be changed.  In both cases, current profiles for CHARSET will be"
NSQ_SOURCE_LINE 00001136 "returned as 3-item list of (HEADERENC, BODYENC, ENCCHARSET)."
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "HEADERENC is recommended encoding scheme for message header."
NSQ_SOURCE_LINE 00001139 "It may be one of C<\"B\">, C<\"Q\">, C<\"S\"> (shorter one of either) or"
NSQ_SOURCE_LINE 00001140 "C<undef> (might not be encoded)."
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "BODYENC is recommended transfer-encoding for message body.  It may be"
NSQ_SOURCE_LINE 00001143 "one of C<\"B\">, C<\"Q\">, C<\"S\"> (shorter one of either) or"
NSQ_SOURCE_LINE 00001144 "C<undef> (might not be transfer-encoded)."
NSQ_SOURCE_LINE 00001145 ""
NSQ_SOURCE_LINE 00001146 "ENCCHARSET is a charset which is compatible with given CHARSET and"
NSQ_SOURCE_LINE 00001147 "is recommended to be used for MIME messages on Internet."
NSQ_SOURCE_LINE 00001148 "If conversion is not needed (or this module doesn't know appropriate"
NSQ_SOURCE_LINE 00001149 "charset), ENCCHARSET is C<undef>."
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "B<NOTE>: This function in the future releases can accept more optional"
NSQ_SOURCE_LINE 00001152 "arguments (for example, properties to handle character widths, line folding"
NSQ_SOURCE_LINE 00001153 "behavior, ...).  So format of returned value may probably be changed."
NSQ_SOURCE_LINE 00001154 "Use L<\"header_encoding\">, L<\"body_encoding\"> or L<\"output_charset\"> to get"
NSQ_SOURCE_LINE 00001155 "particular profile."
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "=cut"
NSQ_SOURCE_LINE 00001158 ""
NSQ_SOURCE_LINE 00001159 "sub recommended ($;$;$;$) {"
NSQ_SOURCE_LINE 00001160 "    my $charset = &canonical_charset(shift);"
NSQ_SOURCE_LINE 00001161 "    my $henc = uc(shift) || undef;"
NSQ_SOURCE_LINE 00001162 "    my $benc = uc(shift) || undef;"
NSQ_SOURCE_LINE 00001163 "    my $cset = &canonical_charset(shift);"
NSQ_SOURCE_LINE 00001164 ""
NSQ_SOURCE_LINE 00001165 "    croak \"CHARSET is not specified\" unless $charset;"
NSQ_SOURCE_LINE 00001166 "    croak \"Unknown header encoding\" unless !$henc or $henc =~ /^[BQS]$/;"
NSQ_SOURCE_LINE 00001167 "    croak \"Unknown body encoding\" unless !$benc or $benc =~ /^[BQ]$/;"
NSQ_SOURCE_LINE 00001168 ""
NSQ_SOURCE_LINE 00001169 "    if ($henc or $benc or $cset) {"
NSQ_SOURCE_LINE 00001170 "\t$cset = undef if $charset eq $cset;"
NSQ_SOURCE_LINE 00001171 "\tmy @spec = ($henc, $benc, USE_ENCODE? $cset: undef);"
NSQ_SOURCE_LINE 00001172 "\t$CHARSETS{$charset} = \\@spec;"
NSQ_SOURCE_LINE 00001173 "\treturn @spec;"
NSQ_SOURCE_LINE 00001174 "    } else {"
NSQ_SOURCE_LINE 00001175 "\t$charset = __PACKAGE__->new($charset) unless ref $charset;"
NSQ_SOURCE_LINE 00001176 "\treturn map { $charset->{$_} } qw(HeaderEncoding BodyEncoding"
NSQ_SOURCE_LINE 00001177 "\t\t\t\t\t OutputCharset);"
NSQ_SOURCE_LINE 00001178 "    }"
NSQ_SOURCE_LINE 00001179 "}"
NSQ_SOURCE_LINE 00001180 ""
NSQ_SOURCE_LINE 00001181 "=back"
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "=head2 Constants"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "=over"
NSQ_SOURCE_LINE 00001186 ""
NSQ_SOURCE_LINE 00001187 "=item USE_ENCODE"
NSQ_SOURCE_LINE 00001188 ""
NSQ_SOURCE_LINE 00001189 "Unicode/multibyte support flag."
NSQ_SOURCE_LINE 00001190 "Non-empty string will be set when Unicode and multibyte support is enabled."
NSQ_SOURCE_LINE 00001191 "Currently, this flag will be non-empty on Perl 5.7.3 or later and"
NSQ_SOURCE_LINE 00001192 "empty string on earlier versions of Perl."
NSQ_SOURCE_LINE 00001193 ""
NSQ_SOURCE_LINE 00001194 "=back"
NSQ_SOURCE_LINE 00001195 ""
NSQ_SOURCE_LINE 00001196 "=head2 Error Handling"
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "L<\"body_encode\"> and L<\"header_encode\"> accept following C<Replacement>"
NSQ_SOURCE_LINE 00001199 "options:"
NSQ_SOURCE_LINE 00001200 ""
NSQ_SOURCE_LINE 00001201 "=over"
NSQ_SOURCE_LINE 00001202 ""
NSQ_SOURCE_LINE 00001203 "=item C<\"DEFAULT\">"
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "Put a substitution character in place of a malformed character."
NSQ_SOURCE_LINE 00001206 "For UCM-based encodings, <subchar> will be used."
NSQ_SOURCE_LINE 00001207 ""
NSQ_SOURCE_LINE 00001208 "=item C<\"FALLBACK\">"
NSQ_SOURCE_LINE 00001209 ""
NSQ_SOURCE_LINE 00001210 "Try C<\"DEFAULT\"> scheme using I<fallback charset> (see L<\"fallback\">)."
NSQ_SOURCE_LINE 00001211 "When fallback charset is undefined and conversion causes error,"
NSQ_SOURCE_LINE 00001212 "code will die on error with an error message."
NSQ_SOURCE_LINE 00001213 ""
NSQ_SOURCE_LINE 00001214 "=item C<\"CROAK\">"
NSQ_SOURCE_LINE 00001215 ""
NSQ_SOURCE_LINE 00001216 "Code will die on error immediately with an error message."
NSQ_SOURCE_LINE 00001217 "Therefore, you should trap the fatal error with eval{} unless you"
NSQ_SOURCE_LINE 00001218 "really want to let it die on error."
NSQ_SOURCE_LINE 00001219 "Synonym is C<\"STRICT\">."
NSQ_SOURCE_LINE 00001220 ""
NSQ_SOURCE_LINE 00001221 "=item C<\"PERLQQ\">"
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 "=item C<\"HTMLCREF\">"
NSQ_SOURCE_LINE 00001224 ""
NSQ_SOURCE_LINE 00001225 "=item C<\"XMLCREF\">"
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "Use C<FB_PERLQQ>, C<FB_HTMLCREF> or C<FB_XMLCREF>"
NSQ_SOURCE_LINE 00001228 "scheme defined by L<Encode> module."
NSQ_SOURCE_LINE 00001229 ""
NSQ_SOURCE_LINE 00001230 "=item numeric values"
NSQ_SOURCE_LINE 00001231 ""
NSQ_SOURCE_LINE 00001232 "Numeric values are also allowed."
NSQ_SOURCE_LINE 00001233 "For more details see L<Encode/Handling Malformed Data>."
NSQ_SOURCE_LINE 00001234 ""
NSQ_SOURCE_LINE 00001235 "=back"
NSQ_SOURCE_LINE 00001236 ""
NSQ_SOURCE_LINE 00001237 "If error handling scheme is not specified or unknown scheme is specified,"
NSQ_SOURCE_LINE 00001238 "C<\"DEFAULT\"> will be assumed."
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "=head2 Configuration File"
NSQ_SOURCE_LINE 00001241 ""
NSQ_SOURCE_LINE 00001242 "Built-in defaults for option parameters can be overridden by configuration"
NSQ_SOURCE_LINE 00001243 "file: F<MIME/Charset/Defaults.pm>."
NSQ_SOURCE_LINE 00001244 "For more details read F<MIME/Charset/Defaults.pm.sample>."
NSQ_SOURCE_LINE 00001245 ""
NSQ_SOURCE_LINE 00001246 "=head1 VERSION"
NSQ_SOURCE_LINE 00001247 ""
NSQ_SOURCE_LINE 00001248 "Consult $VERSION variable."
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "Development versions of this module may be found at"
NSQ_SOURCE_LINE 00001251 "L<http://hatuka.nezumi.nu/repos/MIME-Charset/>."
NSQ_SOURCE_LINE 00001252 ""
NSQ_SOURCE_LINE 00001253 "=head2 Incompatible Changes"
NSQ_SOURCE_LINE 00001254 ""
NSQ_SOURCE_LINE 00001255 "=over 4"
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "=item Release 1.001"
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "=over 4"
NSQ_SOURCE_LINE 00001260 ""
NSQ_SOURCE_LINE 00001261 "=item *"
NSQ_SOURCE_LINE 00001262 ""
NSQ_SOURCE_LINE 00001263 "new() method returns an object when CHARSET argument is not specified."
NSQ_SOURCE_LINE 00001264 ""
NSQ_SOURCE_LINE 00001265 "=back"
NSQ_SOURCE_LINE 00001266 ""
NSQ_SOURCE_LINE 00001267 "=item Release 1.005"
NSQ_SOURCE_LINE 00001268 ""
NSQ_SOURCE_LINE 00001269 "=over 4"
NSQ_SOURCE_LINE 00001270 ""
NSQ_SOURCE_LINE 00001271 "=item *"
NSQ_SOURCE_LINE 00001272 ""
NSQ_SOURCE_LINE 00001273 "Restrict characters in encoded-word according to RFC 2047 section 5 (3)."
NSQ_SOURCE_LINE 00001274 "This also affects return value of encoded_header_len() method."
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "=back"
NSQ_SOURCE_LINE 00001277 ""
NSQ_SOURCE_LINE 00001278 "=item Release 1.008.2"
NSQ_SOURCE_LINE 00001279 ""
NSQ_SOURCE_LINE 00001280 "=over 4"
NSQ_SOURCE_LINE 00001281 ""
NSQ_SOURCE_LINE 00001282 "=item *"
NSQ_SOURCE_LINE 00001283 ""
NSQ_SOURCE_LINE 00001284 "body_encoding() method may also returns C<\"S\">."
NSQ_SOURCE_LINE 00001285 ""
NSQ_SOURCE_LINE 00001286 "=item *"
NSQ_SOURCE_LINE 00001287 ""
NSQ_SOURCE_LINE 00001288 "Return value of body_encode() method for UTF-8 may include"
NSQ_SOURCE_LINE 00001289 "C<\"QUOTED-PRINTABLE\"> encoding item that in earlier versions was fixed to"
NSQ_SOURCE_LINE 00001290 "C<\"BASE64\">."
NSQ_SOURCE_LINE 00001291 ""
NSQ_SOURCE_LINE 00001292 "=back"
NSQ_SOURCE_LINE 00001293 ""
NSQ_SOURCE_LINE 00001294 "=back"
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001297 ""
