NSQ_SOURCE_LINE 00000001 "package DBIx::TransactionManager;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use Carp ();"
NSQ_SOURCE_LINE 00000005 "our $VERSION = '1.13';"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "sub new {"
NSQ_SOURCE_LINE 00000008 "    my ($class, $dbh) = @_;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "    unless ($dbh) {"
NSQ_SOURCE_LINE 00000011 "        Carp::croak('missing mandatory parameter dbh');"
NSQ_SOURCE_LINE 00000012 "    }"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "    bless {"
NSQ_SOURCE_LINE 00000015 "        dbh => $dbh,"
NSQ_SOURCE_LINE 00000016 "        active_transactions => [],"
NSQ_SOURCE_LINE 00000017 "        rollbacked_in_nested_transaction => 0,"
NSQ_SOURCE_LINE 00000018 "    }, $class;"
NSQ_SOURCE_LINE 00000019 "}"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub txn_scope {"
NSQ_SOURCE_LINE 00000022 "    DBIx::TransactionManager::ScopeGuard->new( @_ );"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub txn_begin {"
NSQ_SOURCE_LINE 00000026 "    my ($self, %args) = @_;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    my $caller = $args{caller} || [ caller(0) ];"
NSQ_SOURCE_LINE 00000029 "    my $txns   = $self->{active_transactions};"
NSQ_SOURCE_LINE 00000030 "    my $rc = 1;"
NSQ_SOURCE_LINE 00000031 "    if (@$txns == 0 && $self->{dbh}->FETCH('AutoCommit')) {"
NSQ_SOURCE_LINE 00000032 "        $rc = $self->{dbh}->begin_work;"
NSQ_SOURCE_LINE 00000033 "    }"
NSQ_SOURCE_LINE 00000034 "    if ($rc) {"
NSQ_SOURCE_LINE 00000035 "        push @$txns, { caller => $caller, pid => $$ };"
NSQ_SOURCE_LINE 00000036 "    }"
NSQ_SOURCE_LINE 00000037 "}"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "sub txn_rollback {"
NSQ_SOURCE_LINE 00000040 "    my $self = shift;"
NSQ_SOURCE_LINE 00000041 "    my $txns = $self->{active_transactions};"
NSQ_SOURCE_LINE 00000042 "    return unless @$txns;"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "    my $current = pop @$txns; "
NSQ_SOURCE_LINE 00000045 "    if ( @$txns > 0 ) {"
NSQ_SOURCE_LINE 00000046 "        # already popped, so if there's anything, we're in a nested"
NSQ_SOURCE_LINE 00000047 "        # transaction, mate."
NSQ_SOURCE_LINE 00000048 "        $self->{rollbacked_in_nested_transaction}++;"
NSQ_SOURCE_LINE 00000049 "    } else {"
NSQ_SOURCE_LINE 00000050 "        $self->{dbh}->rollback;"
NSQ_SOURCE_LINE 00000051 "        $self->_txn_end;"
NSQ_SOURCE_LINE 00000052 "    }"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "sub txn_commit {"
NSQ_SOURCE_LINE 00000056 "    my $self = shift;"
NSQ_SOURCE_LINE 00000057 "    my $txns = $self->{active_transactions};"
NSQ_SOURCE_LINE 00000058 "    return unless @$txns;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    if ( $self->{rollbacked_in_nested_transaction} ) {"
NSQ_SOURCE_LINE 00000061 "        Carp::croak \"tried to commit but already rollbacked in nested transaction.\";"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    my $current = pop @$txns;"
NSQ_SOURCE_LINE 00000065 "    if (@$txns == 0) {"
NSQ_SOURCE_LINE 00000066 "        $self->{dbh}->commit;"
NSQ_SOURCE_LINE 00000067 "        $self->_txn_end;"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 "}"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "sub _txn_end {"
NSQ_SOURCE_LINE 00000072 "    @{$_[0]->{active_transactions}} = ();"
NSQ_SOURCE_LINE 00000073 "    $_[0]->{rollbacked_in_nested_transaction} = 0;"
NSQ_SOURCE_LINE 00000074 "}"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "sub active_transactions { $_[0]->{active_transactions} }"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "sub in_transaction {"
NSQ_SOURCE_LINE 00000079 "    my $self = shift;"
NSQ_SOURCE_LINE 00000080 "    my $txns = $self->{active_transactions};"
NSQ_SOURCE_LINE 00000081 "    return @$txns ? $txns->[0] : ();"
NSQ_SOURCE_LINE 00000082 "}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "package DBIx::TransactionManager::ScopeGuard;"
NSQ_SOURCE_LINE 00000085 "use Try::Tiny;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "sub new {"
NSQ_SOURCE_LINE 00000088 "    my($class, $obj, %args) = @_;"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    my $caller = $args{caller} || [ caller(1) ];"
NSQ_SOURCE_LINE 00000091 "    $obj->txn_begin( caller => $caller );"
NSQ_SOURCE_LINE 00000092 "    bless [ 0, $obj, $caller, $$ ], $class;"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub rollback {"
NSQ_SOURCE_LINE 00000096 "    return if $_[0]->[0]; # do not run twice."
NSQ_SOURCE_LINE 00000097 "    $_[0]->[1]->txn_rollback;"
NSQ_SOURCE_LINE 00000098 "    $_[0]->[0] = 1;"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "sub commit {"
NSQ_SOURCE_LINE 00000102 "    return if $_[0]->[0]; # do not run twice."
NSQ_SOURCE_LINE 00000103 "    $_[0]->[1]->txn_commit;"
NSQ_SOURCE_LINE 00000104 "    $_[0]->[0] = 1;"
NSQ_SOURCE_LINE 00000105 "}"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "sub DESTROY {"
NSQ_SOURCE_LINE 00000108 "    my($dismiss, $obj, $caller, $pid) = @{ $_[0] };"
NSQ_SOURCE_LINE 00000109 "    return if $dismiss;"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "    if ( $$ != $pid ) {"
NSQ_SOURCE_LINE 00000112 "        return;"
NSQ_SOURCE_LINE 00000113 "    }"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    warn( \"Transaction was aborted without calling an explicit commit or rollback. (Guard created at $caller->[1] line $caller->[2])\" );"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "    try {"
NSQ_SOURCE_LINE 00000118 "        $obj->txn_rollback;"
NSQ_SOURCE_LINE 00000119 "    } catch {"
NSQ_SOURCE_LINE 00000120 "        die \"Rollback failed: $_\";"
NSQ_SOURCE_LINE 00000121 "    };"
NSQ_SOURCE_LINE 00000122 "}"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "1;"
NSQ_SOURCE_LINE 00000125 "__END__"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=head1 NAME"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "DBIx::TransactionManager - Transaction handling for database."
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "RAII style transaction management:"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "    use DBI;"
NSQ_SOURCE_LINE 00000136 "    use DBIx::TransactionManager;"
NSQ_SOURCE_LINE 00000137 "    my $dbh = DBI->connect('dbi:SQLite:');"
NSQ_SOURCE_LINE 00000138 "    my $tm = DBIx::TransactionManager->new($dbh);"
NSQ_SOURCE_LINE 00000139 "    "
NSQ_SOURCE_LINE 00000140 "    # create transaction object"
NSQ_SOURCE_LINE 00000141 "    my $txn = $tm->txn_scope;"
NSQ_SOURCE_LINE 00000142 "    "
NSQ_SOURCE_LINE 00000143 "        # execute query"
NSQ_SOURCE_LINE 00000144 "        $dbh->do(\"insert into foo (id, var) values (1,'baz')\");"
NSQ_SOURCE_LINE 00000145 "        # And you can do multiple database operations here"
NSQ_SOURCE_LINE 00000146 "    "
NSQ_SOURCE_LINE 00000147 "    # and commit it."
NSQ_SOURCE_LINE 00000148 "    $txn->commit;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Nested transaction usage:"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    use DBI;"
NSQ_SOURCE_LINE 00000153 "    use DBIx::TransactionManager;"
NSQ_SOURCE_LINE 00000154 "    my $dbh = DBI->connect('dbi:SQLite:');"
NSQ_SOURCE_LINE 00000155 "    my $tm = DBIx::TransactionManager->new($dbh);"
NSQ_SOURCE_LINE 00000156 "    "
NSQ_SOURCE_LINE 00000157 "    {"
NSQ_SOURCE_LINE 00000158 "        my $txn = $tm->txn_scope;"
NSQ_SOURCE_LINE 00000159 "        $dbh->do(\"insert into foo (id, var) values (1,'baz')\");"
NSQ_SOURCE_LINE 00000160 "        {"
NSQ_SOURCE_LINE 00000161 "            my $txn2 = $tm->txn_scope;"
NSQ_SOURCE_LINE 00000162 "            $dbh->do(\"insert into foo (id, var) values (2,'bab')\");"
NSQ_SOURCE_LINE 00000163 "            $txn2->commit;"
NSQ_SOURCE_LINE 00000164 "        }"
NSQ_SOURCE_LINE 00000165 "        {"
NSQ_SOURCE_LINE 00000166 "            my $txn3 = $tm->txn_scope;"
NSQ_SOURCE_LINE 00000167 "            $dbh->do(\"insert into foo (id, var) values (3,'bee')\");"
NSQ_SOURCE_LINE 00000168 "            $txn3->commit;"
NSQ_SOURCE_LINE 00000169 "        }"
NSQ_SOURCE_LINE 00000170 "        $txn->commit;"
NSQ_SOURCE_LINE 00000171 "    }"
NSQ_SOURCE_LINE 00000172 "    "
NSQ_SOURCE_LINE 00000173 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "DBIx::TransactionManager is a simple transaction manager."
NSQ_SOURCE_LINE 00000176 "like L<DBIx::Class::Storage::TxnScopeGuard>."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "This module provides two futures."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=over 4"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=item RAII based transaction management"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=item Nested transaction management"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=back"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "If you are writing of DBIx::* or O/R Mapper, see L<DBIx::TransactionManager::Developers>."
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=head1 METHODS"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=over 4"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=item my $tm = DBIx::TransactionManager->new($dbh)"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "Creating an instance of this class."
NSQ_SOURCE_LINE 00000197 "C<$dbh> is required."
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "=item my $txn = $tm->txn_scope(%args)"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "Get DBIx::TransactionManager::ScopeGuard's instance object."
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "Options for this method is only for module creators, see L<DBIx::TransactionManager::Developers>."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=back"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=head1 DBIx::TransactionManager::ScopeGuard's METHODS"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "=over 4"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=item $txn->commit()"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "Commit the transaction."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "If the C<$tm> is in a nested transaction, TransactionManager doesn't do COMMIT at here. TM just poped transaction stack and do nothing."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "=item $txn->rollback()"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "Rollback the transaction."
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "If the C<$tm> is in a nested transaction, TransactionManager doesn't do ROLLBACK at here. TM just poped transaction stack and do nothing."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "=back"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=head1 DBIx::TransactionManager and other transaction managers"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "You B<cannot> use other transaction manager and DBIx::TransactionManager at once."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "If you are using O/R mapper, you should use that's transaction management feature."
NSQ_SOURCE_LINE 00000230 ""
