NSQ_SOURCE_LINE 00000001 "package Complete::Tcsh;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2019-12-20'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.030'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "require Exporter;"
NSQ_SOURCE_LINE 00000011 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000013 "                       parse_cmdline"
NSQ_SOURCE_LINE 00000014 "                       format_completion"
NSQ_SOURCE_LINE 00000015 "               );"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "require Complete::Bash;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "our %SPEC;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "$SPEC{':package'} = {"
NSQ_SOURCE_LINE 00000022 "    v => 1.1,"
NSQ_SOURCE_LINE 00000023 "    summary => 'Completion module for tcsh shell',"
NSQ_SOURCE_LINE 00000024 "};"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "$SPEC{parse_cmdline} = {"
NSQ_SOURCE_LINE 00000027 "    v => 1.1,"
NSQ_SOURCE_LINE 00000028 "    summary => 'Parse shell command-line for processing by completion routines',"
NSQ_SOURCE_LINE 00000029 "    description => <<'_',"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "This function converts COMMAND_LINE (str) given by tcsh to become something like"
NSQ_SOURCE_LINE 00000032 "COMP_WORDS (array) and COMP_CWORD (int), like what bash supplies to shell"
NSQ_SOURCE_LINE 00000033 "functions. Currently implemented using `Complete::Bash`'s `parse_cmdline`."
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "_"
NSQ_SOURCE_LINE 00000036 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000037 "    args => {"
NSQ_SOURCE_LINE 00000038 "        cmdline => {"
NSQ_SOURCE_LINE 00000039 "            summary => 'Command-line, defaults to COMMAND_LINE environment',"
NSQ_SOURCE_LINE 00000040 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000041 "            pos => 0,"
NSQ_SOURCE_LINE 00000042 "        },"
NSQ_SOURCE_LINE 00000043 "    },"
NSQ_SOURCE_LINE 00000044 "    result => {"
NSQ_SOURCE_LINE 00000045 "        schema => ['array*', len=>2],"
NSQ_SOURCE_LINE 00000046 "        description => <<'_',"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "Return a 2-element array: `[$words, $cword]`. `$words` is array of str,"
NSQ_SOURCE_LINE 00000049 "equivalent to `COMP_WORDS` provided by bash to shell functions. `$cword` is an"
NSQ_SOURCE_LINE 00000050 "integer, equivalent to `COMP_CWORD` provided by bash to shell functions. The"
NSQ_SOURCE_LINE 00000051 "word to be completed is at `$words->[$cword]`."
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "Note that COMP_LINE includes the command name. If you want the command-line"
NSQ_SOURCE_LINE 00000054 "arguments only (like in `@ARGV`), you need to strip the first element from"
NSQ_SOURCE_LINE 00000055 "`$words` and reduce `$cword` by 1."
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "_"
NSQ_SOURCE_LINE 00000058 "    },"
NSQ_SOURCE_LINE 00000059 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000060 "};"
NSQ_SOURCE_LINE 00000061 "sub parse_cmdline {"
NSQ_SOURCE_LINE 00000062 "    my ($line) = @_;"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    $line //= $ENV{COMMAND_LINE};"
NSQ_SOURCE_LINE 00000065 "    Complete::Bash::parse_cmdline($line, length($line));"
NSQ_SOURCE_LINE 00000066 "}"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "$SPEC{format_completion} = {"
NSQ_SOURCE_LINE 00000069 "    v => 1.1,"
NSQ_SOURCE_LINE 00000070 "    summary => 'Format completion for output (for shell)',"
NSQ_SOURCE_LINE 00000071 "    description => <<'_',"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "tcsh accepts completion reply in the form of one entry per line to STDOUT."
NSQ_SOURCE_LINE 00000074 "Currently the formatting is done using `Complete::Bash`'s `format_completion`"
NSQ_SOURCE_LINE 00000075 "because escaping rule and so on are not yet well defined in tcsh."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "_"
NSQ_SOURCE_LINE 00000078 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000079 "    args => {"
NSQ_SOURCE_LINE 00000080 "        completion => {"
NSQ_SOURCE_LINE 00000081 "            summary => 'Completion answer structure',"
NSQ_SOURCE_LINE 00000082 "            description => <<'_',"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "Either an array or hash, as described in `Complete`."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "_"
NSQ_SOURCE_LINE 00000087 "            schema=>['any*' => of => ['hash*', 'array*']],"
NSQ_SOURCE_LINE 00000088 "            req=>1,"
NSQ_SOURCE_LINE 00000089 "            pos=>0,"
NSQ_SOURCE_LINE 00000090 "        },"
NSQ_SOURCE_LINE 00000091 "    },"
NSQ_SOURCE_LINE 00000092 "    result => {"
NSQ_SOURCE_LINE 00000093 "        summary => 'Formatted string (or array, if `as` is set to `array`)',"
NSQ_SOURCE_LINE 00000094 "        schema => ['any*' => of => ['str*', 'array*']],"
NSQ_SOURCE_LINE 00000095 "    },"
NSQ_SOURCE_LINE 00000096 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000097 "};"
NSQ_SOURCE_LINE 00000098 "sub format_completion {"
NSQ_SOURCE_LINE 00000099 "    Complete::Bash::format_completion(@_);"
NSQ_SOURCE_LINE 00000100 "}"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "1;"
NSQ_SOURCE_LINE 00000103 "# ABSTRACT: Completion module for tcsh shell"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "__END__"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=pod"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=head1 NAME"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "Complete::Tcsh - Completion module for tcsh shell"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=head1 VERSION"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "This document describes version 0.030 of Complete::Tcsh (from Perl distribution Complete-Tcsh), released on 2019-12-20."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "tcsh allows completion to come from various sources. One of the simplest is from"
NSQ_SOURCE_LINE 00000122 "a list of words:"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 " % complete CMDNAME 'p/*/(one two three)/'"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "Another source is from an external command:"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 " % complete CMDNAME 'p/*/`mycompleter --somearg`/'"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "The command receives one environment variables C<COMMAND_LINE> (string, raw"
NSQ_SOURCE_LINE 00000131 "command-line). Unlike bash, tcsh does not (yet) provide something akin to"
NSQ_SOURCE_LINE 00000132 "C<COMP_POINT> in bash. Command is expected to print completion entries, one line"
NSQ_SOURCE_LINE 00000133 "at a time."
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 " % cat foo-complete"
NSQ_SOURCE_LINE 00000136 " #!/usr/bin/perl"
NSQ_SOURCE_LINE 00000137 " use Complete::Tcsh qw(parse_cmdline format_completion);"
NSQ_SOURCE_LINE 00000138 " use Complete::Util qw(complete_array_elem);"
NSQ_SOURCE_LINE 00000139 " my ($words, $cword) = @{ parse_cmdline() };"
NSQ_SOURCE_LINE 00000140 " my $res = complete_array_elem(array=>[qw/--help --verbose --version/], word=>$words->[$cword]);"
NSQ_SOURCE_LINE 00000141 " print format_completion($res);"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 " % complete foo 'p/*/`foo-complete`/'"
NSQ_SOURCE_LINE 00000144 " % foo --v<Tab>"
NSQ_SOURCE_LINE 00000145 " --verbose --version"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "This module provides routines for you to be doing the above."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "Also, unlike bash, currently tcsh does not allow delegating completion to a"
NSQ_SOURCE_LINE 00000150 "shell function."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=head2 format_completion"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Usage:"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 " format_completion($completion) -> str|array"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "Format completion for output (for shell)."
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "tcsh accepts completion reply in the form of one entry per line to STDOUT."
NSQ_SOURCE_LINE 00000164 "Currently the formatting is done using C<Complete::Bash>'s C<format_completion>"
NSQ_SOURCE_LINE 00000165 "because escaping rule and so on are not yet well defined in tcsh."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=over 4"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=item * B<$completion>* => I<hash|array>"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "Completion answer structure."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "Either an array or hash, as described in C<Complete>."
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=back"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "Return value: Formatted string (or array, if `as` is set to `array`) (str|array)"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=head2 parse_cmdline"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "Usage:"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 " parse_cmdline($cmdline) -> array"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "Parse shell command-line for processing by completion routines."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "This function converts COMMAND_LINE (str) given by tcsh to become something like"
NSQ_SOURCE_LINE 00000194 "COMP_WORDS (array) and COMP_CWORD (int), like what bash supplies to shell"
NSQ_SOURCE_LINE 00000195 "functions. Currently implemented using C<Complete::Bash>'s C<parse_cmdline>."
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=over 4"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=item * B<$cmdline> => I<str>"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "Command-line, defaults to COMMAND_LINE environment."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=back"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "Return value:  (array)"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "Return a 2-element array: C<[$words, $cword]>. C<$words> is array of str,"
NSQ_SOURCE_LINE 00000213 "equivalent to C<COMP_WORDS> provided by bash to shell functions. C<$cword> is an"
NSQ_SOURCE_LINE 00000214 "integer, equivalent to C<COMP_CWORD> provided by bash to shell functions. The"
NSQ_SOURCE_LINE 00000215 "word to be completed is at C<< $words-E<gt>[$cword] >>."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "Note that COMP_LINE includes the command name. If you want the command-line"
NSQ_SOURCE_LINE 00000218 "arguments only (like in C<@ARGV>), you need to strip the first element from"
NSQ_SOURCE_LINE 00000219 "C<$words> and reduce C<$cword> by 1."
NSQ_SOURCE_LINE 00000220 ""
