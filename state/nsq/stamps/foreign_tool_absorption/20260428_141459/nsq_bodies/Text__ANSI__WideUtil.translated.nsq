NSQ_SOURCE_LINE 00000032 "# ABSTRACT: Routines for text containing ANSI color codes (wide-character functions only)"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "__END__"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "=pod"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "=head1 NAME"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "Text::ANSI::WideUtil - Routines for text containing ANSI color codes (wide-character functions only)"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=head1 VERSION"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "This document describes version 0.232 of Text::ANSI::WideUtil (from Perl distribution Text-ANSI-WideUtil), released on 2021-04-14."
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 " use Text::ANSI::WideUtil qw("
NSQ_SOURCE_LINE 00000051 "                           ta_mbpad"
NSQ_SOURCE_LINE 00000052 "                           ta_mbsubstr"
NSQ_SOURCE_LINE 00000053 "                           ta_mbswidth"
NSQ_SOURCE_LINE 00000054 "                           ta_mbswidth_height"
NSQ_SOURCE_LINE 00000055 "                           ta_mbtrunc"
NSQ_SOURCE_LINE 00000056 "                           ta_mbwrap"
NSQ_SOURCE_LINE 00000057 "                          );"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 " # calculate visual width of text if printed on terminal (can handle Unicode"
NSQ_SOURCE_LINE 00000060 " # wide characters and exclude the ANSI color codes)"
NSQ_SOURCE_LINE 00000061 " say ta_mbswidth(\"\\e[31mred\");  # => 3"
NSQ_SOURCE_LINE 00000062 " say ta_mbswidth(\"\\e[31m红色\"); # => 4"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 " # ditto, but also return the number of lines"
NSQ_SOURCE_LINE 00000065 " say ta_mbswidth_height(\"\\e[31mred\\n红色\"); # => [4, 2]"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 " # wrap text to a certain column width, handle ANSI color codes"
NSQ_SOURCE_LINE 00000068 " say ta_mbwrap(...);"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 " # pad (left, right, center) text to a certain width"
NSQ_SOURCE_LINE 00000071 " say ta_mbpad(...);"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 " # truncate text to a certain width while still passing ANSI color codes"
NSQ_SOURCE_LINE 00000074 " say ta_mbtrunc(...);"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 " # get substring, like ta_substr()"
NSQ_SOURCE_LINE 00000077 " my $substr = ta_mbsubstr(\"...\", $pos, $len);"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 " # return text but with substring replaced with replacement"
NSQ_SOURCE_LINE 00000080 " say ta_mbsubstr(\"...\", $pos, $len, $replacement);"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "This module contains the wide-character variant (C<ta_mb*()>) for some functions"
NSQ_SOURCE_LINE 00000085 "in L<Text::ANSI::Util>. It is split so only this module requires"
NSQ_SOURCE_LINE 00000086 "L<Text::WideChar::Util> and Text::ANSI::Util can be kept slim."
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=for Pod::Coverage ^(ta_trunc)$"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head2 ta_mbpad($text, $width[, $which[, $padchar[, $truncate]]]) => STR"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "Pad <$text> to C<$width>. Like C<ta_pad()> but it uses C<ta_mbswidth()> to"
NSQ_SOURCE_LINE 00000095 "determine visual width instead of C<ta_length()>. See documentation for"
NSQ_SOURCE_LINE 00000096 "C<ta_pad()> for more details on the other arguments."
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "=head2 ta_mbtrunc($text, $width) => STR"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "Truncate C<$text> to C<$width>. Like C<ta_trunc()> but it uses C<ta_mbswidth()>"
NSQ_SOURCE_LINE 00000101 "to determine visual width instead of C<ta_length()>."
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "=head2 ta_mbswidth($text) => INT"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "Return visual width of C<$text> (in number of columns) if printed on terminal."
NSQ_SOURCE_LINE 00000106 "Equivalent to C<< Text::WideChar::Util::mbswidth(ta_strip($text)) >>. This"
NSQ_SOURCE_LINE 00000107 "function can be used e.g. in making sure that your text aligns vertically when"
NSQ_SOURCE_LINE 00000108 "output to the terminal in tabular/table format."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "Note that C<ta_mbswidth()> handles multiline text correctly, e.g.: C<<"
NSQ_SOURCE_LINE 00000111 "ta_mbswidth(\"foo\\nbarbaz\") >> gives 6 instead of 3-1+8 = 8. It splits the input"
NSQ_SOURCE_LINE 00000112 "text first with C<< /\\r?\\n/ >> as separator."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head2 ta_mbswidth_height($text) => [INT, INT]"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "Like C<ta_mbswidth()>, but also gives height (number of lines). For example, C<<"
NSQ_SOURCE_LINE 00000117 "ta_mbswidth_height(\"西爪哇\\nb\\n\") >> gives C<[6, 3]>."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head2 ta_mbwrap($text, $width, \\%opts) => STR"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "Like C<ta_wrap()>, but it uses C<ta_mbswidth()> to determine visual width"
NSQ_SOURCE_LINE 00000122 "instead of C<ta_length()>."
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "Performance: ~300/s on my Core i5 1.7GHz laptop for a ~1KB of text (with zero to"
NSQ_SOURCE_LINE 00000125 "moderate amount of color codes). As a comparison, Text::WideChar::Util's"
NSQ_SOURCE_LINE 00000126 "mbwrap() can do about 650/s."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=head2 ta_mbsubstr($text, $pos, $len[ , $replacement ]) => STR"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "Like C<ta_substr()>, but handles wide characters. C<$pos> is counted in visual"
NSQ_SOURCE_LINE 00000131 "width, not number of characters."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=head1 FAQ"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=head2 Why split functionalities of wide character and color support into multiple modules/distributions?"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "Performance (see numbers in the function description), dependency"
NSQ_SOURCE_LINE 00000138 "(L<Unicode::GCString> is used for wide character support), and overhead (loading"
NSQ_SOURCE_LINE 00000139 "Unicode::GCString)."
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head2 How do I truncate string based on number of characters instead of columns?"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "You can simply use C<ta_trunc()> even on text containing wide characters."
NSQ_SOURCE_LINE 00000144 "ta_trunc() uses Perl's length() which works on a per-character basis."
NSQ_SOURCE_LINE 00000145 ""
