NSQ_SOURCE_LINE 00000508 "    eval {"
NSQ_SOURCE_LINE 00000509 "        require IO::Uncompress::Brotli;"
NSQ_SOURCE_LINE 00000510 "        push(@enc, 'br');"
NSQ_SOURCE_LINE 00000511 "    };"
NSQ_SOURCE_LINE 00000512 "    # we don't care about announcing the 'identity', 'base64' and"
NSQ_SOURCE_LINE 00000513 "    # 'quoted-printable' stuff"
