NSQ_SOURCE_LINE 00000207 "sub content_charset"
NSQ_SOURCE_LINE 00000208 "{"
NSQ_SOURCE_LINE 00000209 "    my $self = shift;"
NSQ_SOURCE_LINE 00000210 "    if (my $charset = $self->content_type_charset) {"
NSQ_SOURCE_LINE 00000211 "\treturn $charset;"
NSQ_SOURCE_LINE 00000212 "    }"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "    # time to start guessing"
NSQ_SOURCE_LINE 00000215 "    my $cref = $self->decoded_content(ref => 1, charset => \"none\");"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "    # Unicode BOM"
NSQ_SOURCE_LINE 00000218 "    for ($$cref) {"
NSQ_SOURCE_LINE 00000219 "\treturn \"UTF-8\"     if /^\\xEF\\xBB\\xBF/;"
NSQ_SOURCE_LINE 00000220 "\treturn \"UTF-32LE\" if /^\\xFF\\xFE\\x00\\x00/;"
NSQ_SOURCE_LINE 00000221 "\treturn \"UTF-32BE\" if /^\\x00\\x00\\xFE\\xFF/;"
NSQ_SOURCE_LINE 00000222 "\treturn \"UTF-16LE\" if /^\\xFF\\xFE/;"
NSQ_SOURCE_LINE 00000223 "\treturn \"UTF-16BE\" if /^\\xFE\\xFF/;"
NSQ_SOURCE_LINE 00000224 "    }"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "    if ($self->content_is_xml) {"
NSQ_SOURCE_LINE 00000227 "\t# http://www.w3.org/TR/2006/REC-xml-20060816/#sec-guessing"
NSQ_SOURCE_LINE 00000228 "\t# XML entity not accompanied by external encoding information and not"
NSQ_SOURCE_LINE 00000229 "\t# in UTF-8 or UTF-16 encoding must begin with an XML encoding declaration,"
NSQ_SOURCE_LINE 00000230 "\t# in which the first characters must be '<?xml'"
NSQ_SOURCE_LINE 00000231 "\tfor ($$cref) {"
NSQ_SOURCE_LINE 00000232 "\t    return \"UTF-32BE\" if /^\\x00\\x00\\x00</;"
NSQ_SOURCE_LINE 00000233 "\t    return \"UTF-32LE\" if /^<\\x00\\x00\\x00/;"
NSQ_SOURCE_LINE 00000234 "\t    return \"UTF-16BE\" if /^(?:\\x00\\s)*\\x00</;"
NSQ_SOURCE_LINE 00000235 "\t    return \"UTF-16LE\" if /^(?:\\s\\x00)*<\\x00/;"
NSQ_SOURCE_LINE 00000236 "\t    if (/^\\s*(<\\?xml[^\\x00]*?\\?>)/) {"
NSQ_SOURCE_LINE 00000237 "\t\tif ($1 =~ /\\sencoding\\s*=\\s*([\"'])(.*?)\\1/) {"
NSQ_SOURCE_LINE 00000238 "\t\t    my $enc = $2;"
NSQ_SOURCE_LINE 00000239 "\t\t    $enc =~ s/^\\s+//; $enc =~ s/\\s+\\z//;"
NSQ_SOURCE_LINE 00000240 "\t\t    return $enc if $enc;"
NSQ_SOURCE_LINE 00000241 "\t\t}"
NSQ_SOURCE_LINE 00000242 "\t    }"
NSQ_SOURCE_LINE 00000243 "\t}"
NSQ_SOURCE_LINE 00000244 "\treturn \"UTF-8\";"
NSQ_SOURCE_LINE 00000245 "    }"
NSQ_SOURCE_LINE 00000246 "    elsif ($self->content_is_html) {"
NSQ_SOURCE_LINE 00000247 "\t# look for <META charset=\"...\"> or <META content=\"...\">"
NSQ_SOURCE_LINE 00000248 "\t# http://dev.w3.org/html5/spec/Overview.html#determining-the-character-encoding"
NSQ_SOURCE_LINE 00000249 "\trequire IO::HTML;"
NSQ_SOURCE_LINE 00000250 "\t# Use relaxed search to match previous versions of HTTP::Message:"
NSQ_SOURCE_LINE 00000251 "\tmy $encoding = IO::HTML::find_charset_in($$cref, { encoding    => 1,"
NSQ_SOURCE_LINE 00000252 "\t                                                   need_pragma => 0 });"
NSQ_SOURCE_LINE 00000253 "\treturn $encoding->mime_name if $encoding;"
NSQ_SOURCE_LINE 00000254 "    }"
NSQ_SOURCE_LINE 00000255 "    elsif ($self->content_type eq \"application/json\") {"
NSQ_SOURCE_LINE 00000256 "\tfor ($$cref) {"
NSQ_SOURCE_LINE 00000257 "\t    # RFC 4627, ch 3"
NSQ_SOURCE_LINE 00000258 "\t    return \"UTF-32BE\" if /^\\x00\\x00\\x00./s;"
NSQ_SOURCE_LINE 00000259 "\t    return \"UTF-32LE\" if /^.\\x00\\x00\\x00/s;"
NSQ_SOURCE_LINE 00000260 "\t    return \"UTF-16BE\" if /^\\x00.\\x00./s;"
NSQ_SOURCE_LINE 00000261 "\t    return \"UTF-16LE\" if /^.\\x00.\\x00/s;"
NSQ_SOURCE_LINE 00000262 "\t    return \"UTF-8\";"
NSQ_SOURCE_LINE 00000263 "\t}"
NSQ_SOURCE_LINE 00000264 "    }"
NSQ_SOURCE_LINE 00000265 "    if ($self->content_type =~ /^text\\//) {"
NSQ_SOURCE_LINE 00000266 "\tfor ($$cref) {"
NSQ_SOURCE_LINE 00000267 "\t    if (length) {"
NSQ_SOURCE_LINE 00000268 "\t\treturn \"US-ASCII\" unless /[\\x80-\\xFF]/;"
NSQ_SOURCE_LINE 00000269 "\t\trequire Encode;"
NSQ_SOURCE_LINE 00000270 "\t\teval {"
NSQ_SOURCE_LINE 00000271 "\t\t    Encode::decode_utf8($_, Encode::FB_CROAK() | Encode::LEAVE_SRC());"
NSQ_SOURCE_LINE 00000272 "\t\t};"
NSQ_SOURCE_LINE 00000273 "\t\treturn \"UTF-8\" unless $@;"
NSQ_SOURCE_LINE 00000274 "\t\treturn \"ISO-8859-1\";"
NSQ_SOURCE_LINE 00000275 "\t    }"
NSQ_SOURCE_LINE 00000276 "\t}"
NSQ_SOURCE_LINE 00000277 "    }"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "    return undef;"
