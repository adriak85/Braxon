NSQ_SOURCE_LINE 00000723 "    }"
NSQ_SOURCE_LINE 00000724 "}"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "# delegate all other method calls to the headers object."
NSQ_SOURCE_LINE 00000727 "our $AUTOLOAD;"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000730 "    my ( $package, $method ) = $AUTOLOAD =~ m/\\A(.+)::([^:]*)\\z/;"
NSQ_SOURCE_LINE 00000731 "    my $code = $_[0]->can($method);"
NSQ_SOURCE_LINE 00000732 "    Carp::croak("
NSQ_SOURCE_LINE 00000733 "        qq(Can't locate object method \"$method\" via package \"$package\"))"
NSQ_SOURCE_LINE 00000734 "        unless $code;"
NSQ_SOURCE_LINE 00000735 "    goto &$code;"
NSQ_SOURCE_LINE 00000736 "}"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "sub can {"
NSQ_SOURCE_LINE 00000739 "    my ( $self, $method ) = @_;"
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "    if ( my $own_method = $self->SUPER::can($method) ) {"
NSQ_SOURCE_LINE 00000742 "        return $own_method;"
NSQ_SOURCE_LINE 00000743 "    }"
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "    my $headers = ref($self) ? $self->headers : 'HTTP::Headers';"
NSQ_SOURCE_LINE 00000746 "    if ( $headers->can($method) ) {"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "        # We create the function here so that it will not need to be"
NSQ_SOURCE_LINE 00000749 "        # autoloaded or recreated the next time."
NSQ_SOURCE_LINE 00000750 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000751 "        *$method = sub {"
NSQ_SOURCE_LINE 00000752 "            local $Carp::Internal{ +__PACKAGE__ } = 1;"
NSQ_SOURCE_LINE 00000753 "            shift->headers->$method(@_);"
NSQ_SOURCE_LINE 00000754 "        };"
NSQ_SOURCE_LINE 00000755 "        return \\&$method;"
NSQ_SOURCE_LINE 00000756 "    }"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "    return undef;"
NSQ_SOURCE_LINE 00000759 "}"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "sub DESTROY { }    # avoid AUTOLOADing it"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "# Private method to access members in %$self"
NSQ_SOURCE_LINE 00000764 "sub _elem"
NSQ_SOURCE_LINE 00000765 "{"
NSQ_SOURCE_LINE 00000766 "    my $self = shift;"
NSQ_SOURCE_LINE 00000767 "    my $elem = shift;"
NSQ_SOURCE_LINE 00000768 "    my $old = $self->{$elem};"
NSQ_SOURCE_LINE 00000769 "    $self->{$elem} = $_[0] if @_;"
NSQ_SOURCE_LINE 00000770 "    return $old;"
NSQ_SOURCE_LINE 00000771 "}"
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "# Create private _parts attribute from current _content"
NSQ_SOURCE_LINE 00000775 "sub _parts {"
NSQ_SOURCE_LINE 00000776 "    my $self = shift;"
NSQ_SOURCE_LINE 00000777 "    my $ct = $self->content_type;"
NSQ_SOURCE_LINE 00000778 "    if ($ct =~ m,^multipart/,) {"
NSQ_SOURCE_LINE 00000779 "\trequire HTTP::Headers::Util;"
NSQ_SOURCE_LINE 00000780 "\tmy @h = HTTP::Headers::Util::split_header_words($self->header(\"Content-Type\"));"
NSQ_SOURCE_LINE 00000781 "\tdie \"Assert\" unless @h;"
NSQ_SOURCE_LINE 00000782 "\tmy %h = @{$h[0]};"
NSQ_SOURCE_LINE 00000783 "\tif (defined(my $b = $h{boundary})) {"
NSQ_SOURCE_LINE 00000784 "\t    my $str = $self->content;"
NSQ_SOURCE_LINE 00000785 "\t    $str =~ s/\\r?\\n--\\Q$b\\E--.*//s;"
NSQ_SOURCE_LINE 00000786 "\t    if ($str =~ s/(^|.*?\\r?\\n)--\\Q$b\\E\\r?\\n//s) {"
NSQ_SOURCE_LINE 00000787 "\t\t$self->{_parts} = [map $self->_part_class->parse($_),"
NSQ_SOURCE_LINE 00000788 "\t\t\t\t   split(/\\r?\\n--\\Q$b\\E\\r?\\n/, $str)]"
NSQ_SOURCE_LINE 00000789 "\t    }"
NSQ_SOURCE_LINE 00000790 "\t}"
NSQ_SOURCE_LINE 00000791 "    }"
NSQ_SOURCE_LINE 00000792 "    elsif ($ct eq \"message/http\") {"
NSQ_SOURCE_LINE 00000793 "\trequire HTTP::Request;"
NSQ_SOURCE_LINE 00000794 "\trequire HTTP::Response;"
NSQ_SOURCE_LINE 00000795 "\tmy $content = $self->content;"
NSQ_SOURCE_LINE 00000796 "\tmy $class = ($content =~ m,^(HTTP/.*)\\n,) ?"
NSQ_SOURCE_LINE 00000797 "\t    \"HTTP::Response\" : \"HTTP::Request\";"
NSQ_SOURCE_LINE 00000798 "\t$self->{_parts} = [$class->parse($content)];"
NSQ_SOURCE_LINE 00000799 "    }"
NSQ_SOURCE_LINE 00000800 "    elsif ($ct =~ m,^message/,) {"
NSQ_SOURCE_LINE 00000801 "\t$self->{_parts} = [ $self->_part_class->parse($self->content) ];"
NSQ_SOURCE_LINE 00000802 "    }"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "    $self->{_parts} ||= [];"
NSQ_SOURCE_LINE 00000805 "}"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "# Create private _content attribute from current _parts"
NSQ_SOURCE_LINE 00000809 "sub _content {"
NSQ_SOURCE_LINE 00000810 "    my $self = shift;"
NSQ_SOURCE_LINE 00000811 "    my $ct = $self->{_headers}->header(\"Content-Type\") || \"multipart/mixed\";"
NSQ_SOURCE_LINE 00000812 "    if ($ct =~ m,^\\s*message/,i) {"
NSQ_SOURCE_LINE 00000813 "\t_set_content($self, $self->{_parts}[0]->as_string($CRLF), 1);"
NSQ_SOURCE_LINE 00000814 "\treturn;"
NSQ_SOURCE_LINE 00000815 "    }"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "    require HTTP::Headers::Util;"
NSQ_SOURCE_LINE 00000818 "    my @v = HTTP::Headers::Util::split_header_words($ct);"
NSQ_SOURCE_LINE 00000819 "    Carp::carp(\"Multiple Content-Type headers\") if @v > 1;"
NSQ_SOURCE_LINE 00000820 "    @v = @{$v[0]};"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "    my $boundary;"
NSQ_SOURCE_LINE 00000823 "    my $boundary_index;"
NSQ_SOURCE_LINE 00000824 "    for (my @tmp = @v; @tmp;) {"
NSQ_SOURCE_LINE 00000825 "\tmy($k, $v) = splice(@tmp, 0, 2);"
NSQ_SOURCE_LINE 00000826 "\tif ($k eq \"boundary\") {"
NSQ_SOURCE_LINE 00000827 "\t    $boundary = $v;"
NSQ_SOURCE_LINE 00000828 "\t    $boundary_index = @v - @tmp - 1;"
NSQ_SOURCE_LINE 00000829 "\t    last;"
NSQ_SOURCE_LINE 00000830 "\t}"
NSQ_SOURCE_LINE 00000831 "    }"
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "    my @parts = map $_->as_string($CRLF), @{$self->{_parts}};"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "    my $bno = 0;"
NSQ_SOURCE_LINE 00000836 "    $boundary = _boundary() unless defined $boundary;"
NSQ_SOURCE_LINE 00000837 " CHECK_BOUNDARY:"
NSQ_SOURCE_LINE 00000838 "    {"
NSQ_SOURCE_LINE 00000839 "\tfor (@parts) {"
NSQ_SOURCE_LINE 00000840 "\t    if (index($_, $boundary) >= 0) {"
NSQ_SOURCE_LINE 00000841 "\t\t# must have a better boundary"
NSQ_SOURCE_LINE 00000842 "\t\t$boundary = _boundary(++$bno);"
NSQ_SOURCE_LINE 00000843 "\t\tredo CHECK_BOUNDARY;"
NSQ_SOURCE_LINE 00000844 "\t    }"
NSQ_SOURCE_LINE 00000845 "\t}"
NSQ_SOURCE_LINE 00000846 "    }"
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "    if ($boundary_index) {"
NSQ_SOURCE_LINE 00000849 "\t$v[$boundary_index] = $boundary;"
NSQ_SOURCE_LINE 00000850 "    }"
NSQ_SOURCE_LINE 00000851 "    else {"
NSQ_SOURCE_LINE 00000852 "\tpush(@v, boundary => $boundary);"
NSQ_SOURCE_LINE 00000853 "    }"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "    $ct = HTTP::Headers::Util::join_header_words(@v);"
NSQ_SOURCE_LINE 00000856 "    $self->{_headers}->header(\"Content-Type\", $ct);"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "    _set_content($self, \"--$boundary$CRLF\" ."
NSQ_SOURCE_LINE 00000859 "\t                join(\"$CRLF--$boundary$CRLF\", @parts) ."
NSQ_SOURCE_LINE 00000860 "\t\t\t\"$CRLF--$boundary--$CRLF\","
NSQ_SOURCE_LINE 00000861 "                        1);"
NSQ_SOURCE_LINE 00000862 "}"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "sub _boundary"
NSQ_SOURCE_LINE 00000866 "{"
NSQ_SOURCE_LINE 00000867 "    my $size = shift || return \"xYzZY\";"
NSQ_SOURCE_LINE 00000868 "    require MIME::Base64;"
NSQ_SOURCE_LINE 00000869 "    my $b = MIME::Base64::encode(join(\"\", map chr(rand(256)), 1..$size*3), \"\");"
NSQ_SOURCE_LINE 00000870 "    $b =~ s/[\\W]/X/g;  # ensure alnum only"
NSQ_SOURCE_LINE 00000871 "    $b;"
NSQ_SOURCE_LINE 00000872 "}"
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "1;"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "=pod"
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000880 ""
NSQ_SOURCE_LINE 00000881 "=head1 NAME"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "HTTP::Message - HTTP style message (base class)"
NSQ_SOURCE_LINE 00000884 ""
NSQ_SOURCE_LINE 00000885 "=head1 VERSION"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "version 7.01"
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 " use parent 'HTTP::Message';"
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "An C<HTTP::Message> object contains some headers and a content body."
NSQ_SOURCE_LINE 00000896 "The following methods are available:"
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "=over 4"
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "=item $mess = HTTP::Message->new"
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "=item $mess = HTTP::Message->new( $headers )"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "=item $mess = HTTP::Message->new( $headers, $content )"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "This constructs a new message object.  Normally you would want"
NSQ_SOURCE_LINE 00000907 "construct C<HTTP::Request> or C<HTTP::Response> objects instead."
NSQ_SOURCE_LINE 00000908 ""
NSQ_SOURCE_LINE 00000909 "The optional $header argument should be a reference to an"
NSQ_SOURCE_LINE 00000910 "C<HTTP::Headers> object or a plain array reference of key/value pairs."
NSQ_SOURCE_LINE 00000911 "If an C<HTTP::Headers> object is provided then a copy of it will be"
NSQ_SOURCE_LINE 00000912 "embedded into the constructed message, i.e. it will not be owned and"
NSQ_SOURCE_LINE 00000913 "can be modified afterwards without affecting the message."
NSQ_SOURCE_LINE 00000914 ""
NSQ_SOURCE_LINE 00000915 "The optional $content argument should be a string of bytes."
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "=item $mess = HTTP::Message->parse( $str )"
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "This constructs a new message object by parsing the given string."
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "=item $mess->headers"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "Returns the embedded C<HTTP::Headers> object."
NSQ_SOURCE_LINE 00000924 ""
NSQ_SOURCE_LINE 00000925 "=item $mess->headers_as_string"
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "=item $mess->headers_as_string( $eol )"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "Call the as_string() method for the headers in the"
NSQ_SOURCE_LINE 00000930 "message.  This will be the same as"
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "    $mess->headers->as_string"
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "but it will make your program a whole character shorter :-)"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "=item $mess->content"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "=item $mess->content( $bytes )"
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "The content() method sets the raw content if an argument is given.  If no"
NSQ_SOURCE_LINE 00000941 "argument is given the content is not touched.  In either case the"
NSQ_SOURCE_LINE 00000942 "original raw content is returned."
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "If the C<undef> argument is given, the content is reset to its default value,"
NSQ_SOURCE_LINE 00000945 "which is an empty string."
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "Note that the content should be a string of bytes.  Strings in perl"
NSQ_SOURCE_LINE 00000948 "can contain characters outside the range of a byte.  The C<Encode>"
NSQ_SOURCE_LINE 00000949 "module can be used to turn such strings into a string of bytes."
NSQ_SOURCE_LINE 00000950 ""
NSQ_SOURCE_LINE 00000951 "=item $mess->add_content( $bytes )"
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "The add_content() methods appends more data bytes to the end of the"
NSQ_SOURCE_LINE 00000954 "current content buffer."
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "=item $mess->add_content_utf8( $string )"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "The add_content_utf8() method appends the UTF-8 bytes representing the"
NSQ_SOURCE_LINE 00000959 "string to the end of the current content buffer."
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "=item $mess->content_ref"
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "=item $mess->content_ref( \\$bytes )"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "The content_ref() method will return a reference to content buffer string."
NSQ_SOURCE_LINE 00000966 "It can be more efficient to access the content this way if the content"
NSQ_SOURCE_LINE 00000967 "is huge, and it can even be used for direct manipulation of the content,"
NSQ_SOURCE_LINE 00000968 "for instance:"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "  ${$res->content_ref} =~ s/\\bfoo\\b/bar/g;"
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "This example would modify the content buffer in-place."
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "If an argument is passed it will setup the content to reference some"
NSQ_SOURCE_LINE 00000975 "external source.  The content() and add_content() methods"
NSQ_SOURCE_LINE 00000976 "will automatically dereference scalar references passed this way.  For"
NSQ_SOURCE_LINE 00000977 "other references content() will return the reference itself and"
NSQ_SOURCE_LINE 00000978 "add_content() will refuse to do anything."
NSQ_SOURCE_LINE 00000979 ""
NSQ_SOURCE_LINE 00000980 "=item $mess->content_charset"
NSQ_SOURCE_LINE 00000981 ""
NSQ_SOURCE_LINE 00000982 "This returns the charset used by the content in the message.  The"
NSQ_SOURCE_LINE 00000983 "charset is either found as the charset attribute of the"
NSQ_SOURCE_LINE 00000984 "C<Content-Type> header or by guessing."
NSQ_SOURCE_LINE 00000985 ""
NSQ_SOURCE_LINE 00000986 "See L<http://www.w3.org/TR/REC-html40/charset.html#spec-char-encoding>"
NSQ_SOURCE_LINE 00000987 "for details about how charset is determined."
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "=item $mess->decoded_content( %options )"
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "Returns the content with any C<Content-Encoding> undone and, for textual content"
NSQ_SOURCE_LINE 00000992 "(C<Content-Type> values starting with C<text/>, exactly matching"
NSQ_SOURCE_LINE 00000993 "C<application/xml>, or ending with C<+xml>), the raw content's character set"
NSQ_SOURCE_LINE 00000994 "decoded into Perl's Unicode string format. Note that this"
NSQ_SOURCE_LINE 00000995 "L<does not currently|https://github.com/libwww-perl/HTTP-Message/pull/99>"
NSQ_SOURCE_LINE 00000996 "attempt to decode declared character sets for any other content types like"
NSQ_SOURCE_LINE 00000997 "C<application/json> or C<application/javascript>.  If the C<Content-Encoding>"
NSQ_SOURCE_LINE 00000998 "or C<charset> of the message is unknown, this method will fail by returning"
NSQ_SOURCE_LINE 00000999 "C<undef>."
NSQ_SOURCE_LINE 00001000 ""
NSQ_SOURCE_LINE 00001001 "The following options can be specified."
NSQ_SOURCE_LINE 00001002 ""
NSQ_SOURCE_LINE 00001003 "=over"
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "=item C<charset>"
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "This overrides the charset parameter for text content.  The value"
NSQ_SOURCE_LINE 00001008 "C<none> can used to suppress decoding of the charset."
NSQ_SOURCE_LINE 00001009 ""
NSQ_SOURCE_LINE 00001010 "=item C<default_charset>"
NSQ_SOURCE_LINE 00001011 ""
NSQ_SOURCE_LINE 00001012 "This overrides the default charset guessed by content_charset() or"
NSQ_SOURCE_LINE 00001013 "if that fails \"ISO-8859-1\"."
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "=item C<alt_charset>"
NSQ_SOURCE_LINE 00001016 ""
NSQ_SOURCE_LINE 00001017 "If decoding fails because the charset specified in the Content-Type header"
NSQ_SOURCE_LINE 00001018 "isn't recognized by Perl's Encode module, then try decoding using this charset"
NSQ_SOURCE_LINE 00001019 "instead of failing.  The C<alt_charset> might be specified as C<none> to simply"
NSQ_SOURCE_LINE 00001020 "return the string without any decoding of charset as alternative."
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "=item C<charset_strict>"
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "Abort decoding if malformed characters is found in the content.  By"
NSQ_SOURCE_LINE 00001025 "default you get the substitution character (\"\\x{FFFD}\") in place of"
NSQ_SOURCE_LINE 00001026 "malformed characters."
NSQ_SOURCE_LINE 00001027 ""
NSQ_SOURCE_LINE 00001028 "=item C<raise_error>"
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "If TRUE then raise an exception if not able to decode content.  Reason"
NSQ_SOURCE_LINE 00001031 "might be that the specified C<Content-Encoding> or C<charset> is not"
NSQ_SOURCE_LINE 00001032 "supported.  If this option is FALSE, then decoded_content() will return"
NSQ_SOURCE_LINE 00001033 "C<undef> on errors, but will still set $@."
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 "=item C<ref>"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "If TRUE then a reference to decoded content is returned.  This might"
NSQ_SOURCE_LINE 00001038 "be more efficient in cases where the decoded content is identical to"
NSQ_SOURCE_LINE 00001039 "the raw content as no data copying is required in this case."
NSQ_SOURCE_LINE 00001040 ""
NSQ_SOURCE_LINE 00001041 "=back"
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "=item $mess->decodable"
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "=item HTTP::Message::decodable()"
NSQ_SOURCE_LINE 00001046 ""
NSQ_SOURCE_LINE 00001047 "This returns the encoding identifiers that decoded_content() can"
NSQ_SOURCE_LINE 00001048 "process.  In scalar context returns a comma separated string of"
NSQ_SOURCE_LINE 00001049 "identifiers."
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 "This value is suitable for initializing the C<Accept-Encoding> request"
NSQ_SOURCE_LINE 00001052 "header field."
NSQ_SOURCE_LINE 00001053 ""
NSQ_SOURCE_LINE 00001054 "=item $mess->decode"
NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 "This method tries to replace the content of the message with the"
NSQ_SOURCE_LINE 00001057 "decoded version and removes the C<Content-Encoding> header.  Returns"
NSQ_SOURCE_LINE 00001058 "TRUE if successful and FALSE if not."
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "If the message does not have a C<Content-Encoding> header this method"
NSQ_SOURCE_LINE 00001061 "does nothing and returns TRUE."
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "Note that the content of the message is still bytes after this method"
NSQ_SOURCE_LINE 00001064 "has been called and you still need to call decoded_content() if you"
NSQ_SOURCE_LINE 00001065 "want to process its content as a string."
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "=item $mess->encode( $encoding, ... )"
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "Apply the given encodings to the content of the message.  Returns TRUE"
NSQ_SOURCE_LINE 00001070 "if successful. The \"identity\" (non-)encoding is always supported; other"
NSQ_SOURCE_LINE 00001071 "currently supported encodings, subject to availability of required"
NSQ_SOURCE_LINE 00001072 "additional modules, are \"gzip\", \"deflate\", \"x-bzip2\", \"base64\" and \"br\"."
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 "A successful call to this function will set the C<Content-Encoding>"
NSQ_SOURCE_LINE 00001075 "header."
NSQ_SOURCE_LINE 00001076 ""
NSQ_SOURCE_LINE 00001077 "Note that C<multipart/*> or C<message/*> messages can't be encoded and"
NSQ_SOURCE_LINE 00001078 "this method will croak if you try."
NSQ_SOURCE_LINE 00001079 ""
NSQ_SOURCE_LINE 00001080 "=item $mess->parts"
NSQ_SOURCE_LINE 00001081 ""
NSQ_SOURCE_LINE 00001082 "=item $mess->parts( @parts )"
NSQ_SOURCE_LINE 00001083 ""
NSQ_SOURCE_LINE 00001084 "=item $mess->parts( \\@parts )"
NSQ_SOURCE_LINE 00001085 ""
NSQ_SOURCE_LINE 00001086 "Messages can be composite, i.e. contain other messages.  The composite"
NSQ_SOURCE_LINE 00001087 "messages have a content type of C<multipart/*> or C<message/*>.  This"
NSQ_SOURCE_LINE 00001088 "method give access to the contained messages."
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "The argumentless form will return a list of C<HTTP::Message> objects."
NSQ_SOURCE_LINE 00001091 "If the content type of $msg is not C<multipart/*> or C<message/*> then"
NSQ_SOURCE_LINE 00001092 "this will return the empty list.  In scalar context only the first"
NSQ_SOURCE_LINE 00001093 "object is returned.  The returned message parts should be regarded as"
NSQ_SOURCE_LINE 00001094 "read-only (future versions of this library might make it possible"
NSQ_SOURCE_LINE 00001095 "to modify the parent by modifying the parts)."
NSQ_SOURCE_LINE 00001096 ""
NSQ_SOURCE_LINE 00001097 "If the content type of $msg is C<message/*> then there will only be"
NSQ_SOURCE_LINE 00001098 "one part returned."
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "If the content type is C<message/http>, then the return value will be"
NSQ_SOURCE_LINE 00001101 "either an C<HTTP::Request> or an C<HTTP::Response> object."
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 "If a @parts argument is given, then the content of the message will be"
NSQ_SOURCE_LINE 00001104 "modified. The array reference form is provided so that an empty list"
NSQ_SOURCE_LINE 00001105 "can be provided.  The @parts array should contain C<HTTP::Message>"
NSQ_SOURCE_LINE 00001106 "objects.  The @parts objects are owned by $mess after this call and"
NSQ_SOURCE_LINE 00001107 "should not be modified or made part of other messages."
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "When updating the message with this method and the old content type of"
NSQ_SOURCE_LINE 00001110 "$mess is not C<multipart/*> or C<message/*>, then the content type is"
NSQ_SOURCE_LINE 00001111 "set to C<multipart/mixed> and all other content headers are cleared."
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "This method will croak if the content type is C<message/*> and more"
NSQ_SOURCE_LINE 00001114 "than one part is provided."
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "=item $mess->add_part( $part )"
NSQ_SOURCE_LINE 00001117 ""
NSQ_SOURCE_LINE 00001118 "This will add a part to a message.  The $part argument should be"
NSQ_SOURCE_LINE 00001119 "another C<HTTP::Message> object.  If the previous content type of"
NSQ_SOURCE_LINE 00001120 "$mess is not C<multipart/*> then the old content (together with all"
NSQ_SOURCE_LINE 00001121 "content headers) will be made part #1 and the content type made"
NSQ_SOURCE_LINE 00001122 "C<multipart/mixed> before the new part is added.  The $part object is"
NSQ_SOURCE_LINE 00001123 "owned by $mess after this call and should not be modified or made part"
NSQ_SOURCE_LINE 00001124 "of other messages."
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "There is no return value."
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "=item $mess->clear"
NSQ_SOURCE_LINE 00001129 ""
NSQ_SOURCE_LINE 00001130 "Will clear the headers and set the content to the empty string.  There"
NSQ_SOURCE_LINE 00001131 "is no return value"
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "=item $mess->protocol"
NSQ_SOURCE_LINE 00001134 ""
NSQ_SOURCE_LINE 00001135 "=item $mess->protocol( $proto )"
NSQ_SOURCE_LINE 00001136 ""
NSQ_SOURCE_LINE 00001137 "Sets the HTTP protocol used for the message.  The protocol() is a string"
NSQ_SOURCE_LINE 00001138 "like C<HTTP/1.0> or C<HTTP/1.1>."
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "=item $mess->clone"
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "Returns a copy of the message object."
NSQ_SOURCE_LINE 00001143 ""
NSQ_SOURCE_LINE 00001144 "=item $mess->as_string"
NSQ_SOURCE_LINE 00001145 ""
NSQ_SOURCE_LINE 00001146 "=item $mess->as_string( $eol )"
NSQ_SOURCE_LINE 00001147 ""
NSQ_SOURCE_LINE 00001148 "Returns the message formatted as a single string."
NSQ_SOURCE_LINE 00001149 ""
NSQ_SOURCE_LINE 00001150 "The optional $eol parameter specifies the line ending sequence to use."
NSQ_SOURCE_LINE 00001151 "The default is \"\\n\".  If no $eol is given then as_string will ensure"
NSQ_SOURCE_LINE 00001152 "that the returned string is newline terminated (even when the message"
NSQ_SOURCE_LINE 00001153 "content is not).  No extra newline is appended if an explicit $eol is"
NSQ_SOURCE_LINE 00001154 "passed."
NSQ_SOURCE_LINE 00001155 ""
NSQ_SOURCE_LINE 00001156 "=item $mess->dump( %opt )"
NSQ_SOURCE_LINE 00001157 ""
NSQ_SOURCE_LINE 00001158 "Returns the message formatted as a string.  In void context print the string."
NSQ_SOURCE_LINE 00001159 ""
NSQ_SOURCE_LINE 00001160 "This differs from C<< $mess->as_string >> in that it escapes the bytes"
NSQ_SOURCE_LINE 00001161 "of the content so that it's safe to print them and it limits how much"
NSQ_SOURCE_LINE 00001162 "content to print.  The escapes syntax used is the same as for Perl's"
NSQ_SOURCE_LINE 00001163 "double quoted strings.  If there is no content the string \"(no"
NSQ_SOURCE_LINE 00001164 "content)\" is shown in its place."
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 "Options to influence the output can be passed as key/value pairs. The"
NSQ_SOURCE_LINE 00001167 "following options are recognized:"
NSQ_SOURCE_LINE 00001168 ""
NSQ_SOURCE_LINE 00001169 "=over"
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 "=item maxlength => $num"
NSQ_SOURCE_LINE 00001172 ""
NSQ_SOURCE_LINE 00001173 "How much of the content to show.  The default is 512.  Set this to 0"
NSQ_SOURCE_LINE 00001174 "for unlimited."
NSQ_SOURCE_LINE 00001175 ""
NSQ_SOURCE_LINE 00001176 "If the content is longer then the string is chopped at the limit and"
NSQ_SOURCE_LINE 00001177 "the string \"...\\n(### more bytes not shown)\" appended."
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "=item no_content => $str"
NSQ_SOURCE_LINE 00001180 ""
NSQ_SOURCE_LINE 00001181 "Replaces the \"(no content)\" marker."
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "=item prefix => $str"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "A string that will be prefixed to each line of the dump."
NSQ_SOURCE_LINE 00001186 ""
NSQ_SOURCE_LINE 00001187 "=back"
NSQ_SOURCE_LINE 00001188 ""
NSQ_SOURCE_LINE 00001189 "=back"
NSQ_SOURCE_LINE 00001190 ""
NSQ_SOURCE_LINE 00001191 "All methods unknown to C<HTTP::Message> itself are delegated to the"
NSQ_SOURCE_LINE 00001192 "C<HTTP::Headers> object that is part of every message.  This allows"
NSQ_SOURCE_LINE 00001193 "convenient access to these methods.  Refer to L<HTTP::Headers> for"
NSQ_SOURCE_LINE 00001194 "details of these methods:"
NSQ_SOURCE_LINE 00001195 ""
NSQ_SOURCE_LINE 00001196 "    $mess->header( $field => $val )"
NSQ_SOURCE_LINE 00001197 "    $mess->push_header( $field => $val )"
NSQ_SOURCE_LINE 00001198 "    $mess->init_header( $field => $val )"
NSQ_SOURCE_LINE 00001199 "    $mess->remove_header( $field )"
NSQ_SOURCE_LINE 00001200 "    $mess->remove_content_headers"
NSQ_SOURCE_LINE 00001201 "    $mess->header_field_names"
NSQ_SOURCE_LINE 00001202 "    $mess->scan( \\&doit )"
NSQ_SOURCE_LINE 00001203 ""
NSQ_SOURCE_LINE 00001204 "    $mess->date"
NSQ_SOURCE_LINE 00001205 "    $mess->expires"
NSQ_SOURCE_LINE 00001206 "    $mess->if_modified_since"
NSQ_SOURCE_LINE 00001207 "    $mess->if_unmodified_since"
NSQ_SOURCE_LINE 00001208 "    $mess->last_modified"
NSQ_SOURCE_LINE 00001209 "    $mess->content_type"
NSQ_SOURCE_LINE 00001210 "    $mess->content_encoding"
NSQ_SOURCE_LINE 00001211 "    $mess->content_length"
NSQ_SOURCE_LINE 00001212 "    $mess->content_language"
NSQ_SOURCE_LINE 00001213 "    $mess->title"
NSQ_SOURCE_LINE 00001214 "    $mess->user_agent"
NSQ_SOURCE_LINE 00001215 "    $mess->server"
NSQ_SOURCE_LINE 00001216 "    $mess->from"
NSQ_SOURCE_LINE 00001217 "    $mess->referer"
NSQ_SOURCE_LINE 00001218 "    $mess->www_authenticate"
NSQ_SOURCE_LINE 00001219 "    $mess->authorization"
NSQ_SOURCE_LINE 00001220 "    $mess->proxy_authorization"
NSQ_SOURCE_LINE 00001221 "    $mess->authorization_basic"
NSQ_SOURCE_LINE 00001222 "    $mess->proxy_authorization_basic"
NSQ_SOURCE_LINE 00001223 ""
