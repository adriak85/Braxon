NSQ_SOURCE_LINE 00000294 "sub decoded_content"
NSQ_SOURCE_LINE 00000295 "{"
NSQ_SOURCE_LINE 00000296 "    my($self, %opt) = @_;"
NSQ_SOURCE_LINE 00000297 "    my $content_ref;"
NSQ_SOURCE_LINE 00000298 "    my $content_ref_iscopy;"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "    eval {"
NSQ_SOURCE_LINE 00000301 "\t$content_ref = $self->content_ref;"
NSQ_SOURCE_LINE 00000302 "\tdie \"Can't decode ref content\" if ref($content_ref) ne \"SCALAR\";"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "\tmy $content_limit = exists $opt{ max_body_size } ? $opt{ max_body_size }"
NSQ_SOURCE_LINE 00000305 "\t\t\t: defined $self->max_body_size ? $self->max_body_size"
NSQ_SOURCE_LINE 00000306 "\t\t\t: undef"
NSQ_SOURCE_LINE 00000307 "\t\t\t;"
NSQ_SOURCE_LINE 00000308 "\tmy %limiter_options;"
NSQ_SOURCE_LINE 00000309 "\tif( defined $content_limit ) {"
NSQ_SOURCE_LINE 00000310 "\t    %limiter_options = (LimitOutput => 1, Bufsize => $content_limit);"
NSQ_SOURCE_LINE 00000311 "\t};"
NSQ_SOURCE_LINE 00000312 "\tif (my $h = $self->header(\"Content-Encoding\")) {"
NSQ_SOURCE_LINE 00000313 "\t    $h =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00000314 "\t    $h =~ s/\\s+$//;"
NSQ_SOURCE_LINE 00000315 "\t    for my $ce (reverse split(/\\s*,\\s*/, lc($h))) {"
NSQ_SOURCE_LINE 00000316 "\t\tnext unless $ce;"
NSQ_SOURCE_LINE 00000317 "\t\tnext if $ce eq \"identity\" || $ce eq \"none\";"
NSQ_SOURCE_LINE 00000318 "\t\tif ($ce eq \"gzip\" || $ce eq \"x-gzip\") {"
NSQ_SOURCE_LINE 00000319 "\t\t    require Compress::Raw::Zlib; # 'WANT_GZIP_OR_ZLIB', 'Z_BUF_ERROR';"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "\t\t    if( ! $content_ref_iscopy and keys %limiter_options) {"
NSQ_SOURCE_LINE 00000322 "\t\t\t# Create a copy of the input because Zlib will overwrite it"
NSQ_SOURCE_LINE 00000323 "\t\t\t# :-("
NSQ_SOURCE_LINE 00000324 "\t\t\tmy $input = \"$$content_ref\";"
NSQ_SOURCE_LINE 00000325 "\t\t\t$content_ref = \\$input;"
NSQ_SOURCE_LINE 00000326 "\t\t\t$content_ref_iscopy++;"
NSQ_SOURCE_LINE 00000327 "\t\t    };"
NSQ_SOURCE_LINE 00000328 "\t\t    my ($i, $status) = Compress::Raw::Zlib::Inflate->new("
NSQ_SOURCE_LINE 00000329 "\t\t\t%limiter_options,"
NSQ_SOURCE_LINE 00000330 "\t\t\tConsumeInput => 0, # overridden by Zlib if we have %limiter_options :-("
NSQ_SOURCE_LINE 00000331 "\t\t\tWindowBits => Compress::Raw::Zlib::WANT_GZIP_OR_ZLIB(),"
NSQ_SOURCE_LINE 00000332 "\t\t    );"
NSQ_SOURCE_LINE 00000333 "\t\t    my $res = $i->inflate( $content_ref, \\my $output );"
NSQ_SOURCE_LINE 00000334 "\t\t    $res == Compress::Raw::Zlib::Z_BUF_ERROR()"
NSQ_SOURCE_LINE 00000335 "\t\t\tand Carp::croak(\"Decoded content would be larger than $content_limit octets\");"
NSQ_SOURCE_LINE 00000336 "\t\t    $res == Compress::Raw::Zlib::Z_OK()"
NSQ_SOURCE_LINE 00000337 "\t\t    or $res == Compress::Raw::Zlib::Z_STREAM_END()"
NSQ_SOURCE_LINE 00000338 "\t\t    or die \"Can't gunzip content: $res\";"
NSQ_SOURCE_LINE 00000339 "\t\t    $content_ref = \\$output;"
NSQ_SOURCE_LINE 00000340 "\t\t    $content_ref_iscopy++;"
NSQ_SOURCE_LINE 00000341 "\t\t}"
NSQ_SOURCE_LINE 00000342 "\t\telsif ($ce eq 'br') {"
NSQ_SOURCE_LINE 00000343 "\t\t    require IO::Uncompress::Brotli;"
NSQ_SOURCE_LINE 00000344 "\t\t    my $bro = IO::Uncompress::Brotli->create;"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "\t\t    my $output;"
NSQ_SOURCE_LINE 00000347 "\t\t    if( defined $content_limit ) {"
NSQ_SOURCE_LINE 00000348 "\t\t\t$output = eval { $bro->decompress( $$content_ref, $content_limit ); }"
NSQ_SOURCE_LINE 00000349 "\t\t    } else {"
NSQ_SOURCE_LINE 00000350 "\t\t\t$output = eval { $bro->decompress($$content_ref) };"
NSQ_SOURCE_LINE 00000351 "\t\t    }"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "\t\t    $@ and die \"Can't unbrotli content: $@\";"
NSQ_SOURCE_LINE 00000354 "\t\t    $content_ref = \\$output;"
NSQ_SOURCE_LINE 00000355 "\t\t    $content_ref_iscopy++;"
NSQ_SOURCE_LINE 00000356 "\t\t}"
NSQ_SOURCE_LINE 00000357 "\t\telsif ($ce eq \"x-bzip2\" or $ce eq \"bzip2\") {"
NSQ_SOURCE_LINE 00000358 "\t\t    require Compress::Raw::Bzip2;"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "\t\t    if( ! $content_ref_iscopy ) {"
NSQ_SOURCE_LINE 00000361 "\t\t\t# Create a copy of the input because Bzlib2 will overwrite it"
NSQ_SOURCE_LINE 00000362 "\t\t\t# :-("
NSQ_SOURCE_LINE 00000363 "\t\t\tmy $input = \"$$content_ref\";"
NSQ_SOURCE_LINE 00000364 "\t\t\t$content_ref = \\$input;"
NSQ_SOURCE_LINE 00000365 "\t\t\t$content_ref_iscopy++;"
NSQ_SOURCE_LINE 00000366 "\t\t    };"
NSQ_SOURCE_LINE 00000367 "\t\t    my ($i, $status) = Compress::Raw::Bunzip2->new("
NSQ_SOURCE_LINE 00000368 "\t\t\t1, # appendInput"
NSQ_SOURCE_LINE 00000369 "\t\t\t0, # consumeInput"
