NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "    my @dump;"
NSQ_SOURCE_LINE 00000651 "    push(@dump, $opt{preheader}) if $opt{preheader};"
NSQ_SOURCE_LINE 00000652 "    push(@dump, $self->{_headers}->as_string, $content);"
