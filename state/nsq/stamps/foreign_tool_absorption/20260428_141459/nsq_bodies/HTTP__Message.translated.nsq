NSQ_SOURCE_LINE 00000504 "    eval {"
NSQ_SOURCE_LINE 00000505 "        require Compress::Raw::Bzip2;"
NSQ_SOURCE_LINE 00000506 "        push(@enc, \"x-bzip2\", \"bzip2\");"
