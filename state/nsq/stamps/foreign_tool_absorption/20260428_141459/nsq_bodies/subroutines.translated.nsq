NSQ_SOURCE_LINE 00000001 "package subroutines;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2018-12-15'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.001'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "#use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "sub _package_exists {"
NSQ_SOURCE_LINE 00000009 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "    if ($pkg =~ s/::(\\w+)\\z//) {"
NSQ_SOURCE_LINE 00000012 "        return !!${$pkg . \"::\"}{$1 . \"::\"};"
NSQ_SOURCE_LINE 00000013 "    } else {"
NSQ_SOURCE_LINE 00000014 "        return !!$::{$pkg . \"::\"};"
NSQ_SOURCE_LINE 00000015 "    }"
NSQ_SOURCE_LINE 00000016 "}"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "sub import {"
NSQ_SOURCE_LINE 00000019 "    my $class = shift;"
NSQ_SOURCE_LINE 00000020 "    my $noreq = $_[0] eq '-norequire' ? shift : 0;"
NSQ_SOURCE_LINE 00000021 "    my $orig  = shift;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    my $caller = caller();"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    unless ($noreq) {"
NSQ_SOURCE_LINE 00000026 "        (my $orig_pm = \"$orig.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000027 "        require $orig_pm;"
NSQ_SOURCE_LINE 00000028 "    }"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    die \"Cannot use subroutines from '$orig': package does not exist\" unless"
NSQ_SOURCE_LINE 00000031 "        _package_exists($orig);"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    my $symtbl = \\%{$orig . \"::\"};"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    while (my ($k, $v) = each %$symtbl) {"
NSQ_SOURCE_LINE 00000036 "        next if $k =~ /::$/; # subpackage"
NSQ_SOURCE_LINE 00000037 "        if (\"$v\" !~ /^\\*/) {"
NSQ_SOURCE_LINE 00000038 "            # constant"
NSQ_SOURCE_LINE 00000039 "            *{\"$caller\\::$k\"} = \\*{$orig . \"::\"};"
NSQ_SOURCE_LINE 00000040 "        } elsif (defined *$v{CODE}) {"
NSQ_SOURCE_LINE 00000041 "            # subroutine"
NSQ_SOURCE_LINE 00000042 "            *{\"$caller\\::$k\"} = *$v{CODE};"
NSQ_SOURCE_LINE 00000043 "        }"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 "}"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "1;"
NSQ_SOURCE_LINE 00000048 "# ABSTRACT: Use subroutines from another module"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "__END__"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=pod"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=head1 NAME"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "subroutines - Use subroutines from another module"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=head1 VERSION"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "This document describes version 0.001 of subroutines (from Perl distribution subroutines), released on 2018-12-15."
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 " package Your::Module;"
NSQ_SOURCE_LINE 00000067 " use subroutines 'Another::Module';"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "To avoid require()-ing:"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 " use subroutines '-norequire', 'Another::Module';"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "This pragma declares routines in your module that are copied from another"
NSQ_SOURCE_LINE 00000076 "module."
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 " package Your::Module;"
NSQ_SOURCE_LINE 00000079 " use subroutines 'Another::Module';"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "is equivalent to this pseudo-code:"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 " package Your::Module;"
NSQ_SOURCE_LINE 00000084 " BEGIN {"
NSQ_SOURCE_LINE 00000085 "     require Another::Module;"
NSQ_SOURCE_LINE 00000086 "     for my $name (all_subroutines_in(\"Another::Module\")) {"
NSQ_SOURCE_LINE 00000087 "         *{\"Your::Module::$name\"} = \\&{\"Another::Module::$name\"};"
NSQ_SOURCE_LINE 00000088 "     }"
NSQ_SOURCE_LINE 00000089 " }"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "This is a form of code reuse when you cannot do:"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 " package Your::Module;"
NSQ_SOURCE_LINE 00000094 " use parent 'Another::Module';"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "because the original subroutines do not expect to be called as methods, and/or"
NSQ_SOURCE_LINE 00000097 "when your subroutines are not called as methods."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "Another alternative is to declare C<Your::Module> as an alias of"
NSQ_SOURCE_LINE 00000100 "C<Another::Module>, e.g. using L<alias::module>."
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 " package Your::Module;"
NSQ_SOURCE_LINE 00000103 " use alias::module 'Another::Module';"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "but this copies everythng, not just subroutines."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "Please visit the project's homepage at L<https://metacpan.org/release/subroutines>."
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "Source repository is at L<https://github.com/perlancar/perl-subroutines>."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=head1 BUGS"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=subroutines>"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000120 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000121 "feature."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "L<alias::module>"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "L<parent>, L<base>"
