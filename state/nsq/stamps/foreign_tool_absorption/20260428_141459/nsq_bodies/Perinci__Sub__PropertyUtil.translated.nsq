NSQ_SOURCE_LINE 00000001 "package Perinci::Sub::PropertyUtil;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2016-05-10'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.11'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "require Exporter;"
NSQ_SOURCE_LINE 00000011 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000013 "                       declare_property"
NSQ_SOURCE_LINE 00000014 "               );"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub declare_property {"
NSQ_SOURCE_LINE 00000017 "    my %args   = @_;"
NSQ_SOURCE_LINE 00000018 "    my $name   = $args{name}   or die \"Please specify property's name\";"
NSQ_SOURCE_LINE 00000019 "    my $schema = $args{schema} or die \"Please specify property's schema\";"
NSQ_SOURCE_LINE 00000020 "    my $type   = $args{type};"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    $name =~ m!\\A((result|args/\\*)/)?\\w+\\z! or die \"Invalid property name\";"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    # insert the property's schema into Sah::Schema::rinci::function_meta"
NSQ_SOURCE_LINE 00000025 "    {"
NSQ_SOURCE_LINE 00000026 "        require Sah::Schema::rinci::function_meta;"
NSQ_SOURCE_LINE 00000027 "        my $p = $Sah::Schema::rinci::function_meta::schema->[1]{_prop}"
NSQ_SOURCE_LINE 00000028 "            or die \"BUG: Schema structure changed (1a)\";"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "        my $n;"
NSQ_SOURCE_LINE 00000031 "        if ($name =~ m!\\Aresult/(.+)!) {"
NSQ_SOURCE_LINE 00000032 "            $n = $1;"
NSQ_SOURCE_LINE 00000033 "            $p = $p->{result}{_prop}"
NSQ_SOURCE_LINE 00000034 "                or die \"BUG: Schema structure changed (2a)\";"
NSQ_SOURCE_LINE 00000035 "        } elsif ($name =~ m!\\Aargs/\\*/(.+)!) {"
NSQ_SOURCE_LINE 00000036 "            $n = $1;"
NSQ_SOURCE_LINE 00000037 "            $p = $p->{args}{_value_prop}"
NSQ_SOURCE_LINE 00000038 "                or die \"BUG: Schema structure changed (3a)\";"
NSQ_SOURCE_LINE 00000039 "        } else {"
NSQ_SOURCE_LINE 00000040 "            $n = $name;"
NSQ_SOURCE_LINE 00000041 "        }"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "        $p->{$n}"
NSQ_SOURCE_LINE 00000044 "            and die \"Property '$name' is already declared in schema\";"
NSQ_SOURCE_LINE 00000045 "        # XXX we haven't injected $schema"
NSQ_SOURCE_LINE 00000046 "        $p->{$n} = {};"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    # install wrapper handler"
NSQ_SOURCE_LINE 00000050 "    if ($args{wrapper}) {"
NSQ_SOURCE_LINE 00000051 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000052 "        no warnings 'redefine';"
NSQ_SOURCE_LINE 00000053 "        my $n = $name; $n =~ s!(/\\*)?/!__!g;"
NSQ_SOURCE_LINE 00000054 "        *{\"Perinci::Sub::Wrapper::handlemeta_$n\"} ="
NSQ_SOURCE_LINE 00000055 "            sub { $args{wrapper}{meta} };"
NSQ_SOURCE_LINE 00000056 "        *{\"Perinci::Sub::Wrapper::handle_$n\"} ="
NSQ_SOURCE_LINE 00000057 "            $args{wrapper}{handler};"
NSQ_SOURCE_LINE 00000058 "    }"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    # install Perinci::CmdLine help handler"
NSQ_SOURCE_LINE 00000061 "    if ($args{cmdline_help}) {"
NSQ_SOURCE_LINE 00000062 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000063 "        no warnings 'redefine';"
NSQ_SOURCE_LINE 00000064 "        my $n = $name; $n =~ s!/!__!g;"
NSQ_SOURCE_LINE 00000065 "        *{\"Perinci::CmdLine::help_hookmeta_$n\"} ="
NSQ_SOURCE_LINE 00000066 "            sub { $args{cmdline_help}{meta} };"
NSQ_SOURCE_LINE 00000067 "        *{\"Perinci::CmdLine::help_hook_$n\"} ="
NSQ_SOURCE_LINE 00000068 "            $args{cmdline_help}{handler};"
NSQ_SOURCE_LINE 00000069 "    }"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "    # install Perinci::Sub::To::POD help hook"
NSQ_SOURCE_LINE 00000072 "    if ($args{pod}) {"
NSQ_SOURCE_LINE 00000073 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000074 "        no warnings 'redefine';"
NSQ_SOURCE_LINE 00000075 "        my $n = $name; $n =~ s!/!__!g;"
NSQ_SOURCE_LINE 00000076 "        *{\"Perinci::Sub::To::POD::hookmeta_$n\"} ="
NSQ_SOURCE_LINE 00000077 "            sub { $args{pod}{meta} };"
NSQ_SOURCE_LINE 00000078 "        *{\"Perinci::Sub::To::POD::hook_$n\"} ="
NSQ_SOURCE_LINE 00000079 "            $args{pod}{handler};"
NSQ_SOURCE_LINE 00000080 "    }"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "1;"
NSQ_SOURCE_LINE 00000084 "# ABSTRACT: Utility routines for Perinci::Sub::Property::* modules"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "__END__"
