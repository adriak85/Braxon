NSQ_SOURCE_LINE 00000001 "use strict; use warnings;"
NSQ_SOURCE_LINE 00000002 "package boolean;"
NSQ_SOURCE_LINE 00000003 "our $VERSION = '0.46';"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "my ($true, $false);"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use overload"
NSQ_SOURCE_LINE 00000008 "    '\"\"' => sub { ${$_[0]} },"
NSQ_SOURCE_LINE 00000009 "    '!' => sub { ${$_[0]} ? $false : $true },"
NSQ_SOURCE_LINE 00000010 "    fallback => 1;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000013 "@boolean::EXPORT = qw(true false boolean);"
NSQ_SOURCE_LINE 00000014 "@boolean::EXPORT_OK = qw(isTrue isFalse isBoolean);"
NSQ_SOURCE_LINE 00000015 "%boolean::EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000016 "    all    => [@boolean::EXPORT, @boolean::EXPORT_OK],"
NSQ_SOURCE_LINE 00000017 "    test   => [qw(isTrue isFalse isBoolean)],"
NSQ_SOURCE_LINE 00000018 ");"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "sub import {"
NSQ_SOURCE_LINE 00000021 "    my @options = grep $_ ne '-truth', @_;"
NSQ_SOURCE_LINE 00000022 "    $_[0]->truth if @options != @_;"
NSQ_SOURCE_LINE 00000023 "    @_ = @options;"
NSQ_SOURCE_LINE 00000024 "    goto &Exporter::import;"
NSQ_SOURCE_LINE 00000025 "}"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "my ($true_val, $false_val, $bool_vals);"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "BEGIN {"
NSQ_SOURCE_LINE 00000030 "    my $t = 1;"
NSQ_SOURCE_LINE 00000031 "    my $f = 0;"
NSQ_SOURCE_LINE 00000032 "    $true  = do {bless \\$t, 'boolean'};"
NSQ_SOURCE_LINE 00000033 "    $false = do {bless \\$f, 'boolean'};"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    $true_val  = overload::StrVal($true);"
NSQ_SOURCE_LINE 00000036 "    $false_val = overload::StrVal($false);"
NSQ_SOURCE_LINE 00000037 "    $bool_vals = {$true_val => 1, $false_val => 1};"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "# refaddrs change on thread spawn, so CLONE fixes them up"
NSQ_SOURCE_LINE 00000041 "sub CLONE {"
NSQ_SOURCE_LINE 00000042 "    $true_val  = overload::StrVal($true);"
NSQ_SOURCE_LINE 00000043 "    $false_val = overload::StrVal($false);"
NSQ_SOURCE_LINE 00000044 "    $bool_vals = {$true_val => 1, $false_val => 1};"
NSQ_SOURCE_LINE 00000045 "}"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "sub true()  { $true }"
NSQ_SOURCE_LINE 00000048 "sub false() { $false }"
NSQ_SOURCE_LINE 00000049 "sub boolean($) {"
NSQ_SOURCE_LINE 00000050 "    die \"Not enough arguments for boolean::boolean\" if scalar(@_) == 0;"
NSQ_SOURCE_LINE 00000051 "    die \"Too many arguments for boolean::boolean\" if scalar(@_) > 1;"
NSQ_SOURCE_LINE 00000052 "    return not(defined $_[0]) ? false :"
NSQ_SOURCE_LINE 00000053 "    \"$_[0]\" ? $true : $false;"
NSQ_SOURCE_LINE 00000054 "}"
NSQ_SOURCE_LINE 00000055 "sub isTrue($)  {"
NSQ_SOURCE_LINE 00000056 "    not(defined $_[0]) ? false :"
NSQ_SOURCE_LINE 00000057 "    (overload::StrVal($_[0]) eq $true_val)  ? true : false;"
NSQ_SOURCE_LINE 00000058 "}"
NSQ_SOURCE_LINE 00000059 "sub isFalse($) {"
NSQ_SOURCE_LINE 00000060 "    not(defined $_[0]) ? false :"
NSQ_SOURCE_LINE 00000061 "    (overload::StrVal($_[0]) eq $false_val) ? true : false;"
NSQ_SOURCE_LINE 00000062 "}"
NSQ_SOURCE_LINE 00000063 "sub isBoolean($) {"
NSQ_SOURCE_LINE 00000064 "    not(defined $_[0]) ? false :"
NSQ_SOURCE_LINE 00000065 "    (exists $bool_vals->{overload::StrVal($_[0])}) ? true : false;"
NSQ_SOURCE_LINE 00000066 "}"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "sub truth {"
NSQ_SOURCE_LINE 00000069 "    die \"-truth not supported on Perl 5.22 or later\" if $] >= 5.021005;"
NSQ_SOURCE_LINE 00000070 "    # enable modifying true and false"
NSQ_SOURCE_LINE 00000071 "    &Internals::SvREADONLY( \\ !!0, 0);"
NSQ_SOURCE_LINE 00000072 "    &Internals::SvREADONLY( \\ !!1, 0);"
NSQ_SOURCE_LINE 00000073 "    # turn perl internal booleans into blessed booleans:"
NSQ_SOURCE_LINE 00000074 "    ${ \\ !!0 } = $false;"
NSQ_SOURCE_LINE 00000075 "    ${ \\ !!1 } = $true;"
NSQ_SOURCE_LINE 00000076 "    # make true and false read-only again"
NSQ_SOURCE_LINE 00000077 "    &Internals::SvREADONLY( \\ !!0, 1);"
NSQ_SOURCE_LINE 00000078 "    &Internals::SvREADONLY( \\ !!1, 1);"
NSQ_SOURCE_LINE 00000079 "}"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "sub TO_JSON { ${$_[0]} ? \\1 : \\0 }"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "1;"
BODY_END
