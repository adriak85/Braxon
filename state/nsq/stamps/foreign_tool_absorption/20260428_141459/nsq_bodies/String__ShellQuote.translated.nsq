NSQ_SOURCE_LINE 00000001 "# $Id: ShellQuote.pm,v 1.11 2010-06-11 20:08:57 roderick Exp $"
NSQ_SOURCE_LINE 00000002 "#"
NSQ_SOURCE_LINE 00000003 "# Copyright (c) 1997 Roderick Schertler.  All rights reserved.  This"
NSQ_SOURCE_LINE 00000004 "# program is free software; you can redistribute it and/or modify it"
NSQ_SOURCE_LINE 00000005 "# under the same terms as Perl itself."
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "=head1 NAME"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "String::ShellQuote - quote strings for passing through the shell"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "    $string = shell_quote @list;"
NSQ_SOURCE_LINE 00000014 "    $string = shell_quote_best_effort @list;"
NSQ_SOURCE_LINE 00000015 "    $string = shell_comment_quote $string;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "This module contains some functions which are useful for quoting strings"
NSQ_SOURCE_LINE 00000020 "which are going to pass through the shell or a shell-like object."
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "=over"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=cut"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "package String::ShellQuote;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "use strict;"
NSQ_SOURCE_LINE 00000029 "use vars qw($VERSION @ISA @EXPORT);"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "require Exporter;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "$VERSION\t= '1.04';"
NSQ_SOURCE_LINE 00000034 "@ISA\t\t= qw(Exporter);"
NSQ_SOURCE_LINE 00000035 "@EXPORT\t\t= qw(shell_quote shell_quote_best_effort shell_comment_quote);"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub croak {"
NSQ_SOURCE_LINE 00000038 "    require Carp;"
NSQ_SOURCE_LINE 00000039 "    goto &Carp::croak;"
NSQ_SOURCE_LINE 00000040 "}"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "sub _shell_quote_backend {"
NSQ_SOURCE_LINE 00000043 "    my @in = @_;"
NSQ_SOURCE_LINE 00000044 "    my @err = ();"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    if (0) {"
NSQ_SOURCE_LINE 00000047 "\trequire RS::Handy;"
NSQ_SOURCE_LINE 00000048 "\tprint RS::Handy::data_dump(\\@in);"
NSQ_SOURCE_LINE 00000049 "    }"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    return \\@err, '' unless @in;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    my $ret = '';"
NSQ_SOURCE_LINE 00000054 "    my $saw_non_equal = 0;"
NSQ_SOURCE_LINE 00000055 "    foreach (@in) {"
NSQ_SOURCE_LINE 00000056 "\tif (!defined $_ or $_ eq '') {"
NSQ_SOURCE_LINE 00000057 "\t    $_ = \"''\";"
NSQ_SOURCE_LINE 00000058 "\t    next;"
NSQ_SOURCE_LINE 00000059 "\t}"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "\tif (s/\\x00//g) {"
NSQ_SOURCE_LINE 00000062 "\t    push @err, \"No way to quote string containing null (\\\\000) bytes\";"
NSQ_SOURCE_LINE 00000063 "\t}"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    \tmy $escape = 0;"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "\t# = needs quoting when it's the first element (or part of a"
NSQ_SOURCE_LINE 00000068 "\t# series of such elements), as in command position it's a"
NSQ_SOURCE_LINE 00000069 "\t# program-local environment setting"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "\tif (/=/) {"
NSQ_SOURCE_LINE 00000072 "\t    if (!$saw_non_equal) {"
NSQ_SOURCE_LINE 00000073 "\t    \t$escape = 1;"
NSQ_SOURCE_LINE 00000074 "\t    }"
NSQ_SOURCE_LINE 00000075 "\t}"
NSQ_SOURCE_LINE 00000076 "\telse {"
NSQ_SOURCE_LINE 00000077 "\t    $saw_non_equal = 1;"
NSQ_SOURCE_LINE 00000078 "\t}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "\tif (m|[^\\w!%+,\\-./:=@^]|) {"
NSQ_SOURCE_LINE 00000081 "\t    $escape = 1;"
NSQ_SOURCE_LINE 00000082 "\t}"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "\tif ($escape"
NSQ_SOURCE_LINE 00000085 "\t\t|| (!$saw_non_equal && /=/)) {"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "\t    # ' -> '\\''"
NSQ_SOURCE_LINE 00000088 "    \t    s/'/'\\\\''/g;"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "\t    # make multiple ' in a row look simpler"
NSQ_SOURCE_LINE 00000091 "\t    # '\\'''\\'''\\'' -> '\"'''\"'"
NSQ_SOURCE_LINE 00000092 "    \t    s|((?:'\\\\''){2,})|q{'\"} . (q{'} x (length($1) / 4)) . q{\"'}|ge;"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "\t    $_ = \"'$_'\";"
NSQ_SOURCE_LINE 00000095 "\t    s/^''//;"
NSQ_SOURCE_LINE 00000096 "\t    s/''$//;"
NSQ_SOURCE_LINE 00000097 "\t}"
NSQ_SOURCE_LINE 00000098 "    }"
NSQ_SOURCE_LINE 00000099 "    continue {"
NSQ_SOURCE_LINE 00000100 "\t$ret .= \"$_ \";"
NSQ_SOURCE_LINE 00000101 "    }"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "    chop $ret;"
NSQ_SOURCE_LINE 00000104 "    return \\@err, $ret;"
NSQ_SOURCE_LINE 00000105 "}"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=item B<shell_quote> [I<string>]..."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "B<shell_quote> quotes strings so they can be passed through the shell."
NSQ_SOURCE_LINE 00000110 "Each I<string> is quoted so that the shell will pass it along as a"
NSQ_SOURCE_LINE 00000111 "single argument and without further interpretation.  If no I<string>s"
NSQ_SOURCE_LINE 00000112 "are given an empty string is returned."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "If any I<string> can't be safely quoted B<shell_quote> will B<croak>."
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=cut"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "sub shell_quote {"
NSQ_SOURCE_LINE 00000119 "    my ($rerr, $s) = _shell_quote_backend @_;"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "    if (@$rerr) {"
NSQ_SOURCE_LINE 00000122 "    \tmy %seen;"
NSQ_SOURCE_LINE 00000123 "    \t@$rerr = grep { !$seen{$_}++ } @$rerr;"
NSQ_SOURCE_LINE 00000124 "\tmy $s = join '', map { \"shell_quote(): $_\\n\" } @$rerr;"
NSQ_SOURCE_LINE 00000125 "\tchomp $s;"
NSQ_SOURCE_LINE 00000126 "\tcroak $s;"
NSQ_SOURCE_LINE 00000127 "    }"
NSQ_SOURCE_LINE 00000128 "    return $s;"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=item B<shell_quote_best_effort> [I<string>]..."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "This is like B<shell_quote>, excpet if the string can't be safely quoted"
NSQ_SOURCE_LINE 00000134 "it does the best it can and returns the result, instead of dying."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=cut"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "sub shell_quote_best_effort {"
NSQ_SOURCE_LINE 00000139 "    my ($rerr, $s) = _shell_quote_backend @_;"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    return $s;"
NSQ_SOURCE_LINE 00000142 "}"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=item B<shell_comment_quote> [I<string>]"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "B<shell_comment_quote> quotes the I<string> so that it can safely be"
NSQ_SOURCE_LINE 00000147 "included in a shell-style comment (the current algorithm is that a sharp"
NSQ_SOURCE_LINE 00000148 "character is placed after any newlines in the string)."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "This routine might be changed to accept multiple I<string> arguments"
NSQ_SOURCE_LINE 00000151 "in the future.  I haven't done this yet because I'm not sure if the"
NSQ_SOURCE_LINE 00000152 "I<string>s should be joined with blanks ($\") or nothing ($,).  Cast"
NSQ_SOURCE_LINE 00000153 "your vote today!  Be sure to justify your answer."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=cut"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "sub shell_comment_quote {"
NSQ_SOURCE_LINE 00000158 "    return '' unless @_;"
NSQ_SOURCE_LINE 00000159 "    unless (@_ == 1) {"
NSQ_SOURCE_LINE 00000160 "\tcroak \"Too many arguments to shell_comment_quote \""
NSQ_SOURCE_LINE 00000161 "\t    \t    . \"(got \" . @_ . \" expected 1)\";"
NSQ_SOURCE_LINE 00000162 "    }"
NSQ_SOURCE_LINE 00000163 "    local $_ = shift;"
NSQ_SOURCE_LINE 00000164 "    s/\\n/\\n#/g;"
NSQ_SOURCE_LINE 00000165 "    return $_;"
NSQ_SOURCE_LINE 00000166 "}"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "1;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "__END__"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=back"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    $cmd = 'fuser 2>/dev/null ' . shell_quote @files;"
NSQ_SOURCE_LINE 00000177 "    @pids = split ' ', `$cmd`;"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    print CFG \"# Configured by: \","
NSQ_SOURCE_LINE 00000180 "\t\tshell_comment_quote($ENV{LOGNAME}), \"\\n\";"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head1 BUGS"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "Only Bourne shell quoting is supported.  I'd like to add other shells"
NSQ_SOURCE_LINE 00000185 "(particularly cmd.exe), but I'm not familiar with them.  It would be a"
NSQ_SOURCE_LINE 00000186 "big help if somebody supplied the details."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "Roderick Schertler <F<roderick@argon.org>>"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "perl(1)."
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=cut"
BODY_END
