BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Mixin::Event::Dispatch;"
NSQ_SOURCE_LINE 00000002 "# ABSTRACT: Mixin methods for simple event/message dispatch framework"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '2.000';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "# Key name to use for event handlers. Nothing should be"
NSQ_SOURCE_LINE 00000009 "# accessing this directly so we don't mind something"
NSQ_SOURCE_LINE 00000010 "# unreadable, it's only used in two methods which subclasses"
NSQ_SOURCE_LINE 00000011 "# can override at will"
NSQ_SOURCE_LINE 00000012 "use constant EVENT_HANDLER_KEY => '__MED_event_handlers';"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# Legacy support, newer classes probably would turn this off"
NSQ_SOURCE_LINE 00000015 "use constant EVENT_DISPATCH_ON_FALLBACK => 1;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "=encoding utf8"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "=head1 NAME"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "Mixin::Event::Dispatch - mixin methods for simple event/message dispatch framework"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "=head1 VERSION"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "version 2.000"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 " # Add a handler then invoke it"
NSQ_SOURCE_LINE 00000030 " package Some::Class;"
NSQ_SOURCE_LINE 00000031 " use parent qw(Mixin::Event::Dispatch);"
NSQ_SOURCE_LINE 00000032 " sub new { bless {}, shift }"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 " my $obj = Some::Class->new;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 " # Subscribe to events - subscribers will be called with an event object,"
NSQ_SOURCE_LINE 00000037 " # and any event parameters, each time the event is raised."
NSQ_SOURCE_LINE 00000038 " $obj->subscribe_to_event(another_event => (my $code = sub {"
NSQ_SOURCE_LINE 00000039 "   my $ev = shift;"
NSQ_SOURCE_LINE 00000040 "   warn \"[] @_\";"
NSQ_SOURCE_LINE 00000041 " }));"
NSQ_SOURCE_LINE 00000042 " $obj->invoke_event(another_event => 'like this');"
NSQ_SOURCE_LINE 00000043 " # should get output 'Event data: like this'"
NSQ_SOURCE_LINE 00000044 " $obj->unsubscribe_from_event(another_event => $code);"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 " # Note that handlers will be called for each instance of an event until they return false,"
NSQ_SOURCE_LINE 00000047 " # at which point the handler will be removed, so for a permanent handler, make sure to return 1."
NSQ_SOURCE_LINE 00000048 " $obj->add_handler_for_event(some_event => sub { my $self = shift; warn \"had some_event: @_\"; 1; });"
NSQ_SOURCE_LINE 00000049 " $obj->invoke_event(some_event => 'message here');"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 " # Attach event handler for all on_XXX named parameters"
NSQ_SOURCE_LINE 00000052 " package Event::User;"
NSQ_SOURCE_LINE 00000053 " sub configure {"
NSQ_SOURCE_LINE 00000054 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000055 "\tmy %args = @_;"
NSQ_SOURCE_LINE 00000056 "\t$self->add_handler_for_event("
NSQ_SOURCE_LINE 00000057 "\t\tmap { (/^on_(.*)$/) ? ($1 => $args{$_}) : () } keys %args"
NSQ_SOURCE_LINE 00000058 "\t);"
NSQ_SOURCE_LINE 00000059 "\treturn $self;"
NSQ_SOURCE_LINE 00000060 " }"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "Add this in as a parent to your class, and it'll provide some methods for defining event handlers (L</subscribe_to_event> or L</add_handler_for_event>) and calling them (L</invoke_event>)."
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "Note that handlers should return 0 for a one-off handler, and 1 if it should be called again on the next event."
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=head1 SPECIAL EVENTS"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "A single event has been reserved for cases where a callback dies:"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=over 4"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=item * C< event_error > - if a handler is available, this will be called instead of dying whenever any other handler dies. If an C< event_error > handler also fails,"
NSQ_SOURCE_LINE 00000075 "then this error will be re-thrown. As with the other handlers, you can have more than one C< event_error > handler."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "=back"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=cut"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "use List::UtilsBy ();"
NSQ_SOURCE_LINE 00000082 "use Scalar::Util ();"
NSQ_SOURCE_LINE 00000083 "use Mixin::Event::Dispatch::Event;"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "=head1 METHODS"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "=cut"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=head2 invoke_event"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "Takes an C<event> parameter, and optional additional parameters that are passed to any callbacks."
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 " $self->invoke_event('new_message', from => 'fred', subject => 'test message');"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "Returns $self if a handler was found, undef if not."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=cut"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "sub invoke_event {"
NSQ_SOURCE_LINE 00000100 "\tmy ($self, $event_name, @param) = @_;"
NSQ_SOURCE_LINE 00000101 "\tmy $handlers = $self->event_handlers->{$event_name} || [];"
NSQ_SOURCE_LINE 00000102 "\t"
NSQ_SOURCE_LINE 00000103 "\tunless(@$handlers) {"
NSQ_SOURCE_LINE 00000104 "\t\t# Legacy flag - when set, pass control to on_$event_name"
NSQ_SOURCE_LINE 00000105 "\t\t# if we don't have a handler defined."
NSQ_SOURCE_LINE 00000106 "\t\tif($self->can('EVENT_DISPATCH_ON_FALLBACK') && $self->EVENT_DISPATCH_ON_FALLBACK && (my $code = $self->can(\"on_$event_name\"))) {"
NSQ_SOURCE_LINE 00000107 "\t\t\tlocal $@;"
NSQ_SOURCE_LINE 00000108 "\t\t\teval {"
NSQ_SOURCE_LINE 00000109 "\t\t\t\t$code->($self, @_);"
NSQ_SOURCE_LINE 00000110 "\t\t\t\t1;"
NSQ_SOURCE_LINE 00000111 "\t\t\t} or do {"
NSQ_SOURCE_LINE 00000112 "\t\t\t\tdie $@ if $event_name eq 'event_error';"
NSQ_SOURCE_LINE 00000113 "\t\t\t\t$self->invoke_event(event_error => $@) or die \"$@ and no event_error handler found\";"
NSQ_SOURCE_LINE 00000114 "\t\t\t};"
NSQ_SOURCE_LINE 00000115 "\t\t}"
NSQ_SOURCE_LINE 00000116 "\t\treturn $self;"
NSQ_SOURCE_LINE 00000117 "\t}"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "# We should really do this..."
NSQ_SOURCE_LINE 00000120 "#\tmy $ev = Mixin::Event::Dispatch::Event->new("
NSQ_SOURCE_LINE 00000121 "#\t\tname => $event_name,"
NSQ_SOURCE_LINE 00000122 "#\t\tinstance => $self,"
NSQ_SOURCE_LINE 00000123 "#\t\thandlers => [ @$handlers ],"
NSQ_SOURCE_LINE 00000124 "#\t);"
NSQ_SOURCE_LINE 00000125 "#\t$ev->dispatch;"
NSQ_SOURCE_LINE 00000126 "# ... but this gives better performance (examples/benchmark.pl)"
NSQ_SOURCE_LINE 00000127 "\t(bless {"
NSQ_SOURCE_LINE 00000128 "\t\tname => $event_name,"
NSQ_SOURCE_LINE 00000129 "\t\tinstance => $self,"
NSQ_SOURCE_LINE 00000130 "\t\t# Passing a copy since we might change these later and"
NSQ_SOURCE_LINE 00000131 "\t\t# we do not want those changes to affect any events"
NSQ_SOURCE_LINE 00000132 "\t\t# currently in flight"
NSQ_SOURCE_LINE 00000133 "\t\thandlers => [ @$handlers ],"
NSQ_SOURCE_LINE 00000134 "\t}, 'Mixin::Event::Dispatch::Event')->dispatch(@param);"
NSQ_SOURCE_LINE 00000135 "\treturn $self;"
NSQ_SOURCE_LINE 00000136 "}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=head2 subscribe_to_event"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "Subscribe the given coderef to the named event."
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "Called with a list of event name and handler pairs. An"
NSQ_SOURCE_LINE 00000143 "event name can be any string value. The handler is one"
NSQ_SOURCE_LINE 00000144 "of the following:"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=over 4"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "=item * a coderef will be used directly as a handler,"
NSQ_SOURCE_LINE 00000149 "and will be passed the L<Mixin::Event::Dispatch::Event>"
NSQ_SOURCE_LINE 00000150 "object representing this event."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=item * a plain string will be used as a method name"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "=item * a subclass of L<Mixin::Event::Dispatch> will"
NSQ_SOURCE_LINE 00000155 "be used to delegate the event - use this if you have"
NSQ_SOURCE_LINE 00000156 "an object hierarchy and want the parent object to handle"
NSQ_SOURCE_LINE 00000157 "events on the current object"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=back"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "If you have an overloaded object which is both a"
NSQ_SOURCE_LINE 00000162 "L<Mixin::Event::Dispatch> subclass and provides a"
NSQ_SOURCE_LINE 00000163 "coderef overload, it will default to event delegation"
NSQ_SOURCE_LINE 00000164 "behaviour. To ensure the overloaded coderef is used"
NSQ_SOURCE_LINE 00000165 "instead, pass \\&$obj instead."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "All handlers will be given an event (a"
NSQ_SOURCE_LINE 00000168 "L<Mixin::Event::Dispatch::Event> object) as the first"
NSQ_SOURCE_LINE 00000169 "parameter, and any passed event parameters as the"
NSQ_SOURCE_LINE 00000170 "remainder of @_."
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "Example usage:"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 " my $parent = $obj->parent;"
NSQ_SOURCE_LINE 00000175 " $obj->subscribe_to_event("
NSQ_SOURCE_LINE 00000176 "   connect => sub { warn shift->name }, # warns 'connect'"
NSQ_SOURCE_LINE 00000177 "   connect => $parent, # $parent->invoke_event(connect => @_)"
NSQ_SOURCE_LINE 00000178 "   connect => \\&$parent, # $parent's overloaded &{}"
NSQ_SOURCE_LINE 00000179 "   joined  => 'on_joined', # the on_joined method in $obj"
NSQ_SOURCE_LINE 00000180 " );"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "Note that multiple handlers can be assigned to the same"
NSQ_SOURCE_LINE 00000183 "event name."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=cut"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "sub subscribe_to_event {"
NSQ_SOURCE_LINE 00000188 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "# Init if we haven't got a valid event_handlers yet"
NSQ_SOURCE_LINE 00000191 "\t$self->clear_event_handlers unless $self->event_handlers;"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "# Add the defined handlers"
NSQ_SOURCE_LINE 00000194 "\twhile(@_) {"
NSQ_SOURCE_LINE 00000195 "\t\tmy ($ev, $code) = splice @_, 0, 2;"
NSQ_SOURCE_LINE 00000196 "\t\tdie 'Undefined event?' unless defined $ev;"
NSQ_SOURCE_LINE 00000197 "\t\tpush @{$self->event_handlers->{$ev}}, $code;"
NSQ_SOURCE_LINE 00000198 "\t\tScalar::Util::weaken($self->event_handlers->{$ev}[-1]) if ref($code) && Scalar::Util::reftype($code) ne 'CODE'"
NSQ_SOURCE_LINE 00000199 "\t}"
NSQ_SOURCE_LINE 00000200 "\treturn $self;"
NSQ_SOURCE_LINE 00000201 "}"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=head2 unsubscribe_from_event"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "Removes the given coderef from the list of handlers for this event."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "Expects pairs of (event name, coderef) entries for the events to"
NSQ_SOURCE_LINE 00000208 "unsubscribe from."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "Example usage:"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 " $obj->subscribe_to_event("
NSQ_SOURCE_LINE 00000213 "   some_event => (my $code = sub { }),"
NSQ_SOURCE_LINE 00000214 " );"
NSQ_SOURCE_LINE 00000215 " $obj->unsubscribe_from_event("
NSQ_SOURCE_LINE 00000216 "   some_event => $code,"
NSQ_SOURCE_LINE 00000217 " );"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "If you need to unsubscribe from the event currently being"
NSQ_SOURCE_LINE 00000220 "handled, try the L<Mixin::Event::Dispatch::Event/unsubscribe>"
NSQ_SOURCE_LINE 00000221 "method."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "Returns $self."
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=cut"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "sub unsubscribe_from_event {"
NSQ_SOURCE_LINE 00000228 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "# Init if we haven't got a valid event_handlers yet"
NSQ_SOURCE_LINE 00000231 "\t$self->clear_event_handlers unless $self->event_handlers;"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "# Add the defined handlers"
NSQ_SOURCE_LINE 00000234 "\twhile(@_) {"
NSQ_SOURCE_LINE 00000235 "\t\tmy ($ev, $code) = splice @_, 0, 2;"
NSQ_SOURCE_LINE 00000236 "\t\tdie 'Undefined event?' unless defined $ev;"
NSQ_SOURCE_LINE 00000237 "\t\tList::UtilsBy::extract_by {"
NSQ_SOURCE_LINE 00000238 "\t\t\tScalar::Util::refaddr($code) == Scalar::Util::refaddr($_)"
NSQ_SOURCE_LINE 00000239 "\t\t} @{$self->event_handlers->{$ev}} or die \"Was not subscribed to $ev for $code\";"
NSQ_SOURCE_LINE 00000240 "\t}"
NSQ_SOURCE_LINE 00000241 "\treturn $self;"
NSQ_SOURCE_LINE 00000242 "}"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head2 add_handler_for_event"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "Adds handlers to the stack for the given events."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 " $self->add_handler_for_event("
NSQ_SOURCE_LINE 00000249 "   new_message => sub { warn @_; 1 },"
NSQ_SOURCE_LINE 00000250 "   login => sub { warn @_; 1 },"
NSQ_SOURCE_LINE 00000251 "   logout => sub { warn @_; 1 },"
NSQ_SOURCE_LINE 00000252 " );"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=cut"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "sub add_handler_for_event {"
NSQ_SOURCE_LINE 00000257 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "# Init if we haven't got a valid event_handlers yet"
NSQ_SOURCE_LINE 00000260 "\t$self->clear_event_handlers unless $self->event_handlers;"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "# Add the defined handlers"
NSQ_SOURCE_LINE 00000263 "\twhile(@_) {"
NSQ_SOURCE_LINE 00000264 "\t\tmy ($ev, $code) = splice @_, 0, 2;"
NSQ_SOURCE_LINE 00000265 "\t\t# Support legacy interface via wrapper"
NSQ_SOURCE_LINE 00000266 "\t\t# * handler is passed $self"
NSQ_SOURCE_LINE 00000267 "\t\t# * returning false means we want to unsubscribe"
NSQ_SOURCE_LINE 00000268 "\t\tpush @{$self->event_handlers->{$ev}}, sub {"
NSQ_SOURCE_LINE 00000269 "\t\t\tmy $ev = shift;"
NSQ_SOURCE_LINE 00000270 "\t\t\treturn if $code->($ev->instance, @_);"
NSQ_SOURCE_LINE 00000271 "\t\t\t$ev->unsubscribe;"
NSQ_SOURCE_LINE 00000272 "\t\t};"
NSQ_SOURCE_LINE 00000273 "\t}"
NSQ_SOURCE_LINE 00000274 "\treturn $self;"
NSQ_SOURCE_LINE 00000275 "}"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=head2 event_handlers"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "Accessor for the event stack itself - should return a hashref which maps event names to arrayrefs for"
NSQ_SOURCE_LINE 00000280 "the currently defined handlers."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=cut"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "sub event_handlers { shift->{+EVENT_HANDLER_KEY} ||= {} }"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=head2 clear_event_handlers"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "Removes all queued event handlers."
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "Will also be called when defining the first handler to create the initial L</event_handlers> entry, should"
NSQ_SOURCE_LINE 00000291 "be overridden by subclass if something other than $self->{event_handlers} should be used."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=cut"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "sub clear_event_handlers {"
NSQ_SOURCE_LINE 00000296 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000297 "\t$self->{+EVENT_HANDLER_KEY} = { };"
NSQ_SOURCE_LINE 00000298 "\treturn $self;"
NSQ_SOURCE_LINE 00000299 "}"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "1;"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "__END__"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=head1 API HISTORY"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "Version 2.000 (will) implement the L<Mixin::Event::Dispatch::Methods> class."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "Version 1.000 implemented L</subscribe_to_event> and L<Mixin::Event::Dispatch::Event>."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "Version 0.002 changed to use L</event_handlers> instead of C< event_stack > for storing the available handlers (normally only L<invoke_event> and"
NSQ_SOURCE_LINE 00000312 "L<add_handler_for_event> are expected to be called directly)."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=head1 ROLE vs. MIXIN"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "Role systems might work using the L<Mixin::Event::Dispatch::Methods> module, which allows"
NSQ_SOURCE_LINE 00000317 "import of the relevant methods. Try combing this with a thin wrapper using L<Role::Tiny> / L<Moo::Role> /"
NSQ_SOURCE_LINE 00000318 "L<Moose> for that. The C<t/moo-role.t> and C<t/role-tiny.t> tests may provide some"
NSQ_SOURCE_LINE 00000319 "inspiration."
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "Alternatively, you could perhaps use this as a component via L<Class::C3::Componentised>."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "(I haven't really used any of the above options myself, please let me know if I'm spreading"
NSQ_SOURCE_LINE 00000324 "disinformation here)"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "There are at least a dozen similar modules already on CPAN, here's a small sample:"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=over 4"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "=item * L<Event::Distributor> - uses L<Future> to sequence callbacks, implementing"
NSQ_SOURCE_LINE 00000333 "the concepts discussed in"
NSQ_SOURCE_LINE 00000334 "L<Event-Reflexive programming|http://leonerds-code.blogspot.co.uk/search/label/event-reflexive>"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "=item * L<Object::Event> - event callback interface used in several L<AnyEvent> modules."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=item * L<Ambrosia::Event> - part of the L<Ambrosia> web application framework"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "=item * L<Net::MessageBus> - event subscription via TCP-based message bus"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=item * L<Event::Wrappable> - wrapping for event listeners"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "=item * L<MooseX::Event> - node.js-inspired events, for Moose users"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "=item * L<Beam::Emitter> - a L<Moo::Role> for event handling"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "=back"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "Note that some frameworks such as L<Reflex>, L<POE> and L<Mojolicious> already have comprehensive message-passing"
NSQ_SOURCE_LINE 00000351 "and callback interfaces."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "If you're looking for usage examples, try the following:"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "=over 4"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=item * L<Adapter::Async>"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=item * L<Net::Async::AMQP>"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=item * L<EntityModel> - uses this as the underlying event-passing mechanism, with some"
NSQ_SOURCE_LINE 00000362 "support in L<EntityModel::Class> for indicating event usage metadata"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "=item * L<Protocol::PostgreSQL> - mostly an adapter converting PostgreSQL database messages"
NSQ_SOURCE_LINE 00000365 "to/from events using this class"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=item * L<Protocol::IMAP> - the same, but for the IMAPv4bis protocol"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=item * L<Protocol::XMPP> - and again for Jabber/XMPP"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=back"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "Tom Molesworth <cpan@perlsite.co.uk>"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "with thanks to various helpful people on freenode #perl who suggested making L</event_handlers> into an"
NSQ_SOURCE_LINE 00000378 "accessor (to support non-hashref objects) and who patiently tried to explain about roles."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "L<Mixin::Event::Dispatch::Methods> suggested by mst, primarily for better integration with object"
NSQ_SOURCE_LINE 00000381 "systems such as Moo(se)."
NSQ_SOURCE_LINE 00000382 ""
