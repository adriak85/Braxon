BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Heap;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "# heap is mainly here as documentation for the common heap interface."
NSQ_SOURCE_LINE 00000004 "# It defaults to Heap::Fibonacci."
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use vars qw($VERSION);"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "$VERSION = '0.80';"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "sub new {"
NSQ_SOURCE_LINE 00000012 "    use Heap::Fibonacci;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "    return &Heap::Fibonacci::new;"
NSQ_SOURCE_LINE 00000015 "}"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "1;"
NSQ_SOURCE_LINE 00000018 "__END__"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "=head1 NAME"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "Heap - Perl extensions for keeping data partially sorted"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "  use Heap;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "  my $heap = Heap->new;"
NSQ_SOURCE_LINE 00000029 "  my $elem;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "  use Heap::Elem::Num(NumElem);"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "  foreach $i ( 1..100 ) {"
NSQ_SOURCE_LINE 00000034 "      $elem = NumElem( $i );"
NSQ_SOURCE_LINE 00000035 "      $heap->add( $elem );"
NSQ_SOURCE_LINE 00000036 "  }"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "  while( defined( $elem = $heap->extract_top ) ) {"
NSQ_SOURCE_LINE 00000039 "      print \"Smallest is \", $elem->val, \"\\n\";"
NSQ_SOURCE_LINE 00000040 "  }"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "The Heap collection of modules provide routines that manage"
NSQ_SOURCE_LINE 00000045 "a heap of elements.  A heap is a partially sorted structure"
NSQ_SOURCE_LINE 00000046 "that is always able to easily extract the smallest of the"
NSQ_SOURCE_LINE 00000047 "elements in the structure (or the largest if a reversed compare"
NSQ_SOURCE_LINE 00000048 "routine is provided)."
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "If the collection of elements is changing dynamically, the"
NSQ_SOURCE_LINE 00000051 "heap has less overhead than keeping the collection fully"
NSQ_SOURCE_LINE 00000052 "sorted."
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "The elements must be objects as described in L<\"Heap::Elem\">"
NSQ_SOURCE_LINE 00000055 "and all elements inserted into one heap must be mutually"
NSQ_SOURCE_LINE 00000056 "compatible - either the same class exactly or else classes that"
NSQ_SOURCE_LINE 00000057 "differ only in ways unrelated to the B<Heap::Elem> interface."
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=head1 METHODS"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=over 4"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=item $heap = HeapClass::new(); $heap2 = $heap1->new();"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "Returns a new heap object of the specified (sub-)class."
NSQ_SOURCE_LINE 00000066 "This is often used as a subroutine instead of a method,"
NSQ_SOURCE_LINE 00000067 "of course."
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "=item $heap->DESTROY"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "Ensures that no internal circular data references remain."
NSQ_SOURCE_LINE 00000072 "Some variants of Heap ignore this (they have no such references)."
NSQ_SOURCE_LINE 00000073 "Heap users normally need not worry about it, DESTROY is automatically"
NSQ_SOURCE_LINE 00000074 "invoked when the heap reference goes out of scope."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=item $heap->add($elem)"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "Add an element to the heap."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=item $elem = $heap->top"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Return the top element on the heap.  It is B<not> removed from"
NSQ_SOURCE_LINE 00000083 "the heap but will remain at the top.  It will be the smallest"
NSQ_SOURCE_LINE 00000084 "element on the heap (unless a reversed cmp function is being"
NSQ_SOURCE_LINE 00000085 "used, in which case it will be the largest).  Returns I<undef>"
NSQ_SOURCE_LINE 00000086 "if the heap is empty."
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "This method used to be called \"minimum\" instead of \"top\".  The"
NSQ_SOURCE_LINE 00000089 "old name is still supported but is deprecated.  (It was confusing"
NSQ_SOURCE_LINE 00000090 "to use the method \"minimum\" to get the maximum value on the heap"
NSQ_SOURCE_LINE 00000091 "when a reversed cmp function was used for ordering elements.)"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=item $elem = $heap->extract_top"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "Delete the top element from the heap and return it.  Returns"
NSQ_SOURCE_LINE 00000096 "I<undef> if the heap was empty."
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "This method used to be called \"extract_minimum\" instead of"
NSQ_SOURCE_LINE 00000099 "\"extract_top\".  The old name is still supported but is deprecated."
NSQ_SOURCE_LINE 00000100 "(It was confusing to use the method \"extract_minimum\" to get the"
NSQ_SOURCE_LINE 00000101 "maximum value on the heap when a reversed cmp function was used"
NSQ_SOURCE_LINE 00000102 "for ordering elements.)"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=item $heap1->absorb($heap2)"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "Merge all of the elements from I<$heap2> into I<$heap1>."
NSQ_SOURCE_LINE 00000107 "This will leave I<$heap2> empty."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=item $heap1->decrease_key($elem)"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "The element will be moved closed to the top of the"
NSQ_SOURCE_LINE 00000112 "heap if it is now smaller than any higher parent elements."
NSQ_SOURCE_LINE 00000113 "The user must have changed the value of I<$elem> before"
NSQ_SOURCE_LINE 00000114 "I<decrease_key> is called.  Only a decrease is permitted."
NSQ_SOURCE_LINE 00000115 "(This is a decrease according to the I<cmp> function - if it"
NSQ_SOURCE_LINE 00000116 "is a reversed order comparison, then you are only permitted"
NSQ_SOURCE_LINE 00000117 "to increase the value of the element.  To be pedantic, you"
NSQ_SOURCE_LINE 00000118 "may only use I<decrease_key> if"
NSQ_SOURCE_LINE 00000119 "I<$elem->cmp($elem_original) <= 0> if I<$elem_original> were"
NSQ_SOURCE_LINE 00000120 "an elem with the value that I<$elem> had before it was"
NSQ_SOURCE_LINE 00000121 "I<decreased>.)"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=item $elem = $heap->delete($elem)"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "The element is removed from the heap (whether it is at"
NSQ_SOURCE_LINE 00000126 "the top or not)."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=back"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "John Macdonald, john@perlwolf.com"
