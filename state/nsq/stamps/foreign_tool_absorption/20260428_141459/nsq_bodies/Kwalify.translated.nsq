NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "package Kwalify;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "use strict;"
NSQ_SOURCE_LINE 00000017 "use warnings;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "use base qw(Exporter);"
NSQ_SOURCE_LINE 00000020 "use vars qw(@EXPORT_OK $VERSION);"
NSQ_SOURCE_LINE 00000021 "@EXPORT_OK = qw(validate);"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "$VERSION = '1.24';"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub validate ($$) {"
NSQ_SOURCE_LINE 00000026 "    my($schema, $data) = @_;"
NSQ_SOURCE_LINE 00000027 "    my $self = Kwalify::Validator->new;"
NSQ_SOURCE_LINE 00000028 "    $self->validate($schema, $data, \"/\");"
NSQ_SOURCE_LINE 00000029 "    if (@{$self->{errors}}) {"
NSQ_SOURCE_LINE 00000030 "\tdie join(\"\\n\", map { \"  - $_\" } @{$self->{errors}}) . \"\\n\";"
NSQ_SOURCE_LINE 00000031 "    } else {"
NSQ_SOURCE_LINE 00000032 "\t1;"
NSQ_SOURCE_LINE 00000033 "    }"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "package Kwalify::Validator;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "use overload ();"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "sub new {"
NSQ_SOURCE_LINE 00000041 "    my($class) = @_;"
NSQ_SOURCE_LINE 00000042 "    bless { errors => [] }, $class;"
NSQ_SOURCE_LINE 00000043 "}"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "sub validate {"
NSQ_SOURCE_LINE 00000046 "    my($self, $schema, $data, $path, $args) = @_;"
NSQ_SOURCE_LINE 00000047 "    $self->{done} = {};"
NSQ_SOURCE_LINE 00000048 "    $self->_validate($schema, $data, $path, $args);"
NSQ_SOURCE_LINE 00000049 "}"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "sub _validate {"
NSQ_SOURCE_LINE 00000052 "    my($self, $schema, $data, $path, $args) = @_;"
NSQ_SOURCE_LINE 00000053 "    $self->{path} = $path;"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    if (!UNIVERSAL::isa($schema, \"HASH\")) {"
NSQ_SOURCE_LINE 00000056 "\t$self->_die(\"Schema structure must be a hash reference\");"
NSQ_SOURCE_LINE 00000057 "    }"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    my $type = $schema->{type};"
NSQ_SOURCE_LINE 00000060 "    if (!defined $type) {"
NSQ_SOURCE_LINE 00000061 "\t$type = 'str'; # default type;"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 "    my $type_check_method = \"validate_\" . $type;"
NSQ_SOURCE_LINE 00000064 "    if (!$self->can($type_check_method)) {"
NSQ_SOURCE_LINE 00000065 "\t$self->_die(\"Invalid or unimplemented type '$type'\");"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    $self->$type_check_method($schema, $data, $path, $args);"
NSQ_SOURCE_LINE 00000069 "}"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "sub _additional_rules {"
NSQ_SOURCE_LINE 00000072 "    my($self, $schema, $data, $path) = @_;"
NSQ_SOURCE_LINE 00000073 "    no warnings 'uninitialized'; # legal undef values may happen everywhere"
NSQ_SOURCE_LINE 00000074 "    for my $schema_key (keys %$schema) {"
NSQ_SOURCE_LINE 00000075 "\tif (defined $schema->{$schema_key}) {"
NSQ_SOURCE_LINE 00000076 "\t    if ($schema_key eq 'pattern') {"
NSQ_SOURCE_LINE 00000077 "\t\t(my $pattern = $schema->{pattern}) =~ s{^/(.*)/$}{$1};"
NSQ_SOURCE_LINE 00000078 "\t\tif ($data !~ qr{$pattern}) {"
NSQ_SOURCE_LINE 00000079 "\t\t    $self->_error(\"Non-valid data '$data' does not match /$pattern/\");"
NSQ_SOURCE_LINE 00000080 "\t\t}"
NSQ_SOURCE_LINE 00000081 "\t    } elsif ($schema_key eq 'length') {"
NSQ_SOURCE_LINE 00000082 "\t\tif (!UNIVERSAL::isa($schema->{'length'}, \"HASH\")) {"
NSQ_SOURCE_LINE 00000083 "\t\t    $self->_die(\"'length' must be a hash with keys max and/or min\");"
NSQ_SOURCE_LINE 00000084 "\t\t}"
NSQ_SOURCE_LINE 00000085 "\t\tmy $length = length($data);"
NSQ_SOURCE_LINE 00000086 "\t\tfor my $sub_schema_key (keys %{ $schema->{'length'} }) {"
NSQ_SOURCE_LINE 00000087 "\t\t    if ($sub_schema_key eq 'min') {"
NSQ_SOURCE_LINE 00000088 "\t\t\tmy $min = $schema->{'length'}->{min};"
NSQ_SOURCE_LINE 00000089 "\t\t\tif ($length < $min) {"
NSQ_SOURCE_LINE 00000090 "\t\t\t    $self->_error(\"'$data' is too short (length $length < min $min)\");"
NSQ_SOURCE_LINE 00000091 "\t\t\t}"
NSQ_SOURCE_LINE 00000092 "\t\t    } elsif ($sub_schema_key eq 'min-ex') {"
NSQ_SOURCE_LINE 00000093 "\t\t\tmy $min = $schema->{'length'}->{'min-ex'};"
NSQ_SOURCE_LINE 00000094 "\t\t\tif ($length <= $min) {"
NSQ_SOURCE_LINE 00000095 "\t\t\t    $self->_error(\"'$data' is too short (length $length <= min $min)\");"
NSQ_SOURCE_LINE 00000096 "\t\t\t}"
NSQ_SOURCE_LINE 00000097 "\t\t    } elsif ($sub_schema_key eq 'max') {"
NSQ_SOURCE_LINE 00000098 "\t\t\tmy $max = $schema->{'length'}->{max};"
NSQ_SOURCE_LINE 00000099 "\t\t\tif ($length > $max) {"
NSQ_SOURCE_LINE 00000100 "\t\t\t    $self->_error(\"'$data' is too long (length $length > max $max)\");"
NSQ_SOURCE_LINE 00000101 "\t\t\t}"
NSQ_SOURCE_LINE 00000102 "\t\t    } elsif ($sub_schema_key eq 'max-ex') {"
NSQ_SOURCE_LINE 00000103 "\t\t\tmy $max = $schema->{'length'}->{'max-ex'};"
NSQ_SOURCE_LINE 00000104 "\t\t\tif ($length >= $max) {"
NSQ_SOURCE_LINE 00000105 "\t\t\t    $self->_error(\"'$data' is too long (length $length >= max $max)\");"
NSQ_SOURCE_LINE 00000106 "\t\t\t}"
NSQ_SOURCE_LINE 00000107 "\t\t    } else {"
NSQ_SOURCE_LINE 00000108 "\t\t\t$self->_die(\"Unexpected key '$sub_schema_key' in length specification, expected min, max, min-ex and/or max-ex\");"
NSQ_SOURCE_LINE 00000109 "\t\t    }"
NSQ_SOURCE_LINE 00000110 "\t\t}"
NSQ_SOURCE_LINE 00000111 "\t    } elsif ($schema_key eq 'enum') {"
NSQ_SOURCE_LINE 00000112 "\t\tif (!UNIVERSAL::isa($schema->{enum}, 'ARRAY')) {"
NSQ_SOURCE_LINE 00000113 "\t\t    $self->_die(\"'enum' must be an array\");"
NSQ_SOURCE_LINE 00000114 "\t\t}"
NSQ_SOURCE_LINE 00000115 "\t\tmy %valid = map { ($_,1) } @{ $schema->{enum} };"
NSQ_SOURCE_LINE 00000116 "\t\tif (!exists $valid{$data}) {"
NSQ_SOURCE_LINE 00000117 "\t\t    $self->_error(\"'$data': invalid \" . _base_path($path) . \" value\");"
NSQ_SOURCE_LINE 00000118 "\t\t}"
NSQ_SOURCE_LINE 00000119 "\t    } elsif ($schema_key eq 'range') {"
NSQ_SOURCE_LINE 00000120 "\t\tif (!UNIVERSAL::isa($schema->{range}, \"HASH\")) {"
NSQ_SOURCE_LINE 00000121 "\t\t    $self->_die(\"'range' must be a hash with keys max and/or min\");"
NSQ_SOURCE_LINE 00000122 "\t\t}"
NSQ_SOURCE_LINE 00000123 "\t\tmy($lt, $le, $gt, $ge);"
NSQ_SOURCE_LINE 00000124 "\t\t## yes? no?"
NSQ_SOURCE_LINE 00000125 "\t\t# \tif (eval { require Scalar::Util; defined &Scalar::Util::looks_like_number }) {"
NSQ_SOURCE_LINE 00000126 "\t\t# \t    if (Scalar::Util::looks_like_number($data)) {"
NSQ_SOURCE_LINE 00000127 "\t\t# \t\t$lt = sub { $_[0] < $_[1] };"
NSQ_SOURCE_LINE 00000128 "\t\t# \t\t$gt = sub { $_[0] > $_[1] };"
NSQ_SOURCE_LINE 00000129 "\t\t# \t    } else {"
NSQ_SOURCE_LINE 00000130 "\t\t# \t\t$lt = sub { $_[0] lt $_[1] };"
NSQ_SOURCE_LINE 00000131 "\t\t# \t\t$gt = sub { $_[0] gt $_[1] };"
NSQ_SOURCE_LINE 00000132 "\t\t# \t    }"
NSQ_SOURCE_LINE 00000133 "\t\t# \t} else {"
NSQ_SOURCE_LINE 00000134 "\t\t#\t    warn \"Cannot determine whether $data is a number, assume so...\"; # XXX show only once"
NSQ_SOURCE_LINE 00000135 "\t\tno warnings 'numeric';"
NSQ_SOURCE_LINE 00000136 "\t\t$lt = sub { $_[0] < $_[1] };"
NSQ_SOURCE_LINE 00000137 "\t\t$gt = sub { $_[0] > $_[1] };"
NSQ_SOURCE_LINE 00000138 "\t\t$le = sub { $_[0] <= $_[1] };"
NSQ_SOURCE_LINE 00000139 "\t\t$ge = sub { $_[0] >= $_[1] };"
NSQ_SOURCE_LINE 00000140 "\t\t#\t}"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "\t\tfor my $sub_schema_key (keys %{ $schema->{range} }) {"
NSQ_SOURCE_LINE 00000143 "\t\t    if ($sub_schema_key eq 'min') {"
NSQ_SOURCE_LINE 00000144 "\t\t\tmy $min = $schema->{range}->{min};"
NSQ_SOURCE_LINE 00000145 "\t\t\tif ($lt->($data, $min)) {"
NSQ_SOURCE_LINE 00000146 "\t\t\t    $self->_error(\"'$data' is too small (< min $min)\");"
NSQ_SOURCE_LINE 00000147 "\t\t\t}"
NSQ_SOURCE_LINE 00000148 "\t\t    } elsif ($sub_schema_key eq 'min-ex') {"
NSQ_SOURCE_LINE 00000149 "\t\t\tmy $min = $schema->{range}->{'min-ex'};"
NSQ_SOURCE_LINE 00000150 "\t\t\tif ($le->($data, $min)) {"
NSQ_SOURCE_LINE 00000151 "\t\t\t    $self->_error(\"'$data' is too small (<= min $min)\");"
NSQ_SOURCE_LINE 00000152 "\t\t\t}"
NSQ_SOURCE_LINE 00000153 "\t\t    } elsif ($sub_schema_key eq 'max') {"
NSQ_SOURCE_LINE 00000154 "\t\t\tmy $max = $schema->{range}->{max};"
NSQ_SOURCE_LINE 00000155 "\t\t\tif ($gt->($data, $max)) {"
NSQ_SOURCE_LINE 00000156 "\t\t\t    $self->_error(\"'$data' is too large (> max $max)\");"
NSQ_SOURCE_LINE 00000157 "\t\t\t}"
NSQ_SOURCE_LINE 00000158 "\t\t    } elsif ($sub_schema_key eq 'max-ex') {"
NSQ_SOURCE_LINE 00000159 "\t\t\tmy $max = $schema->{range}->{'max-ex'};"
NSQ_SOURCE_LINE 00000160 "\t\t\tif ($ge->($data, $max)) {"
NSQ_SOURCE_LINE 00000161 "\t\t\t    $self->_error(\"'$data' is too large (>= max $max)\");"
NSQ_SOURCE_LINE 00000162 "\t\t\t}"
NSQ_SOURCE_LINE 00000163 "\t\t    } else {"
NSQ_SOURCE_LINE 00000164 "\t\t\t$self->_die(\"Unexpected key '$sub_schema_key' in range specification, expected min, max, min-ex and/or max-ex\");"
NSQ_SOURCE_LINE 00000165 "\t\t    }"
NSQ_SOURCE_LINE 00000166 "\t\t}"
NSQ_SOURCE_LINE 00000167 "\t    } elsif ($schema_key eq 'assert') {"
NSQ_SOURCE_LINE 00000168 "\t\t$self->_die(\"'assert' is not yet implemented\");"
NSQ_SOURCE_LINE 00000169 "\t    } elsif ($schema_key !~ m{^(type|required|unique|name|classname|class|desc)$}) {"
NSQ_SOURCE_LINE 00000170 "\t\t$self->_die(\"Unexpected key '$schema_key' in type specification\");"
NSQ_SOURCE_LINE 00000171 "\t    }"
NSQ_SOURCE_LINE 00000172 "\t}"
NSQ_SOURCE_LINE 00000173 "    }"
NSQ_SOURCE_LINE 00000174 "}"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "sub validate_text {"
NSQ_SOURCE_LINE 00000177 "    my($self, $schema, $data, $path) = @_;"
NSQ_SOURCE_LINE 00000178 "    if (!defined $data || ref $data) {"
NSQ_SOURCE_LINE 00000179 "\treturn $self->_error(\"Non-valid data '\" . (defined $data ? $data : 'undef') . \"', expected text\");"
NSQ_SOURCE_LINE 00000180 "    }"
NSQ_SOURCE_LINE 00000181 "    $self->_additional_rules($schema, $data, $path);"
NSQ_SOURCE_LINE 00000182 "}"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "sub validate_str {"
NSQ_SOURCE_LINE 00000185 "    my($self, $schema, $data, $path) = @_;"
NSQ_SOURCE_LINE 00000186 "    if (!defined $data || ref $data || $data =~ m{^\\d+(\\.\\d+)?$}) {"
NSQ_SOURCE_LINE 00000187 "\treturn $self->_error(\"Non-valid data '\" . (defined $data ? $data : 'undef') . \"', expected a str\");"
NSQ_SOURCE_LINE 00000188 "    }"
NSQ_SOURCE_LINE 00000189 "    $self->_additional_rules($schema, $data, $path);"
NSQ_SOURCE_LINE 00000190 "}"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "sub validate_int {"
NSQ_SOURCE_LINE 00000193 "    my($self, $schema, $data, $path) = @_;"
NSQ_SOURCE_LINE 00000194 "    if ($data !~ m{^[+-]?\\d+$}) { # XXX what about scientific notation?"
NSQ_SOURCE_LINE 00000195 "\t$self->_error(\"Non-valid data '\" . $data . \"', expected an int\");"
NSQ_SOURCE_LINE 00000196 "    }"
NSQ_SOURCE_LINE 00000197 "    $self->_additional_rules($schema, $data, $path);"
NSQ_SOURCE_LINE 00000198 "}"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "sub validate_float {"
NSQ_SOURCE_LINE 00000201 "    my($self, $schema, $data, $path) = @_;"
NSQ_SOURCE_LINE 00000202 "    if ($data !~ m{^[+-]?\\d+\\.\\d+$}) { # XXX other values?"
NSQ_SOURCE_LINE 00000203 "\t$self->_error(\"Non-valid data '\" . $data . \"', expected a float\");"
NSQ_SOURCE_LINE 00000204 "    }"
NSQ_SOURCE_LINE 00000205 "    $self->_additional_rules($schema, $data, $path);"
NSQ_SOURCE_LINE 00000206 "}"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "sub validate_number {"
NSQ_SOURCE_LINE 00000209 "    my($self, $schema, $data, $path) = @_;"
NSQ_SOURCE_LINE 00000210 "    if ($data !~ m{^[+-]?\\d+(\\.\\d+)?$}) { # XXX combine int+float regexp!"
NSQ_SOURCE_LINE 00000211 "\t$self->_error(\"Non-valid data '\" . $data . \"', expected a number\");"
NSQ_SOURCE_LINE 00000212 "    }"
NSQ_SOURCE_LINE 00000213 "    $self->_additional_rules($schema, $data, $path);"
NSQ_SOURCE_LINE 00000214 "}"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "sub validate_bool {"
NSQ_SOURCE_LINE 00000217 "    my($self, $schema, $data, $path) = @_;"
NSQ_SOURCE_LINE 00000218 "    if ($data !~ m{^(yes|true|1|no|false|0)$}) { # XXX correct?"
NSQ_SOURCE_LINE 00000219 "\t$self->_error(\"Non-valid data '\" . $data . \"', expected a boolean\");"
NSQ_SOURCE_LINE 00000220 "    }"
NSQ_SOURCE_LINE 00000221 "    $self->_additional_rules($schema, $data, $path);"
NSQ_SOURCE_LINE 00000222 "}"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "# XXX is this correct?"
NSQ_SOURCE_LINE 00000225 "sub validate_scalar {"
NSQ_SOURCE_LINE 00000226 "    shift->validate_text(@_);"
NSQ_SOURCE_LINE 00000227 "}"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "sub validate_date {"
NSQ_SOURCE_LINE 00000230 "    my($self, $schema, $data, $path) = @_;"
NSQ_SOURCE_LINE 00000231 "    if ($data !~ m{^\\d{4}-\\d{2}-\\d{2}$}) {"
NSQ_SOURCE_LINE 00000232 "\t$self->_error(\"Non-valid data '\" . $data . \"', expected a date (YYYY-MM-DD)\");"
NSQ_SOURCE_LINE 00000233 "    }"
NSQ_SOURCE_LINE 00000234 "    $self->_additional_rules($schema, $data, $path);"
NSQ_SOURCE_LINE 00000235 "}"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "sub validate_time {"
NSQ_SOURCE_LINE 00000238 "    my($self, $schema, $data, $path) = @_;"
NSQ_SOURCE_LINE 00000239 "    if ($data !~ m{^\\d{2}:\\d{2}:\\d{2}$}) {"
NSQ_SOURCE_LINE 00000240 "\t$self->_error(\"Non-valid data '\" . $data . \"', expected a time (HH:MM:SS)\");"
NSQ_SOURCE_LINE 00000241 "    }"
NSQ_SOURCE_LINE 00000242 "    $self->_additional_rules($schema, $data, $path);"
NSQ_SOURCE_LINE 00000243 "}"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "sub validate_timestamp {"
NSQ_SOURCE_LINE 00000246 "    my($self) = @_;"
NSQ_SOURCE_LINE 00000247 "    $self->_error(\"timestamp validation NYI\"); # XXX"
NSQ_SOURCE_LINE 00000248 "}"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "sub validate_any {"
NSQ_SOURCE_LINE 00000251 "    my($self, $schema, $data, $path) = @_;"
NSQ_SOURCE_LINE 00000252 "    $self->_additional_rules($schema, $data, $path);"
NSQ_SOURCE_LINE 00000253 "}"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "sub validate_seq {"
NSQ_SOURCE_LINE 00000256 "    my($self, $schema, $data, $path) = @_;"
NSQ_SOURCE_LINE 00000257 "    if (!exists $schema->{sequence}) {"
NSQ_SOURCE_LINE 00000258 "\t$self->_die(\"'sequence' missing with 'seq' type\");"
NSQ_SOURCE_LINE 00000259 "    }"
NSQ_SOURCE_LINE 00000260 "    my $sequence = $schema->{sequence};"
NSQ_SOURCE_LINE 00000261 "    if (!UNIVERSAL::isa($sequence, 'ARRAY')) {"
NSQ_SOURCE_LINE 00000262 "\t$self->_die(\"Expected array in 'sequence'\");"
NSQ_SOURCE_LINE 00000263 "    }"
NSQ_SOURCE_LINE 00000264 "    if (@$sequence != 1) {"
NSQ_SOURCE_LINE 00000265 "\t$self->_die(\"Expect exactly one element in sequence\");"
NSQ_SOURCE_LINE 00000266 "    }"
NSQ_SOURCE_LINE 00000267 "    if (!UNIVERSAL::isa($data, 'ARRAY')) {"
NSQ_SOURCE_LINE 00000268 "\t$self->_error(\"Non-valid data \" . $data . \", expected sequence\");"
NSQ_SOURCE_LINE 00000269 "\treturn;"
NSQ_SOURCE_LINE 00000270 "    }"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "    return if ($self->{done}{overload::StrVal($data)}{overload::StrVal($schema)});"
NSQ_SOURCE_LINE 00000273 "    $self->{done}{overload::StrVal($data)}{overload::StrVal($schema)} = 1;"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "    my $subschema = $sequence->[0];"
NSQ_SOURCE_LINE 00000276 "    my $unique = _get_boolean($subschema->{unique});"
NSQ_SOURCE_LINE 00000277 "    my %unique_val;"
NSQ_SOURCE_LINE 00000278 "    my %unique_mapping_val;"
NSQ_SOURCE_LINE 00000279 "    my $index = 0;"
NSQ_SOURCE_LINE 00000280 "    for my $elem (@$data) {"
NSQ_SOURCE_LINE 00000281 "\tmy $subpath = _append_path($path, $index);"
NSQ_SOURCE_LINE 00000282 "\t$self->_validate($subschema, $elem, $subpath, { unique_mapping_val => \\%unique_mapping_val});"
NSQ_SOURCE_LINE 00000283 "\tif ($unique) {"
NSQ_SOURCE_LINE 00000284 "\t    if (exists $unique_val{$elem}) {"
NSQ_SOURCE_LINE 00000285 "\t\t$self->_error(\"'$elem' is already used at '$unique_val{$elem}'\");"
NSQ_SOURCE_LINE 00000286 "\t    } else {"
NSQ_SOURCE_LINE 00000287 "\t\t$unique_val{$elem} = $subpath;"
NSQ_SOURCE_LINE 00000288 "\t    }"
NSQ_SOURCE_LINE 00000289 "\t}"
NSQ_SOURCE_LINE 00000290 "\t$index++;"
NSQ_SOURCE_LINE 00000291 "    }"
NSQ_SOURCE_LINE 00000292 "}"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "sub validate_map {"
NSQ_SOURCE_LINE 00000295 "    my($self, $schema, $data, $path, $args) = @_;"
NSQ_SOURCE_LINE 00000296 "    my $unique_mapping_val;"
NSQ_SOURCE_LINE 00000297 "    if ($args && $args->{unique_mapping_val}) {"
NSQ_SOURCE_LINE 00000298 "\t$unique_mapping_val = $args->{unique_mapping_val};"
NSQ_SOURCE_LINE 00000299 "    }"
NSQ_SOURCE_LINE 00000300 "    if (!exists $schema->{mapping}) {"
NSQ_SOURCE_LINE 00000301 "\t$self->_die(\"'mapping' missing with 'map' type\");"
NSQ_SOURCE_LINE 00000302 "    }"
NSQ_SOURCE_LINE 00000303 "    my $mapping = $schema->{mapping};"
NSQ_SOURCE_LINE 00000304 "    if (!UNIVERSAL::isa($mapping, 'HASH')) {"
NSQ_SOURCE_LINE 00000305 "\t$self->_die(\"Expected hash in 'mapping'\");"
NSQ_SOURCE_LINE 00000306 "    }"
NSQ_SOURCE_LINE 00000307 "    if (!defined $data) {"
NSQ_SOURCE_LINE 00000308 "\t$self->_error(\"Undefined data, expected mapping\");"
NSQ_SOURCE_LINE 00000309 "\treturn;"
NSQ_SOURCE_LINE 00000310 "    }"
NSQ_SOURCE_LINE 00000311 "    if (!UNIVERSAL::isa($data, 'HASH')) {"
NSQ_SOURCE_LINE 00000312 "\t$self->_error(\"Non-valid data \" . $data . \", expected mapping\");"
NSQ_SOURCE_LINE 00000313 "\treturn;"
NSQ_SOURCE_LINE 00000314 "    }"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "    return if ($self->{done}{overload::StrVal($data)}{overload::StrVal($schema)});"
NSQ_SOURCE_LINE 00000317 "    $self->{done}{overload::StrVal($data)}{overload::StrVal($schema)} = 1;"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "    my %seen_key;"
NSQ_SOURCE_LINE 00000320 "    my $default_key_schema;"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "    ## Originally this was an each-loop, but this could lead into"
NSQ_SOURCE_LINE 00000323 "    ## endless recursions, because mapping may be reused in Kwalify,"
NSQ_SOURCE_LINE 00000324 "    ## thus the each iterator was shared between recursion levels."
NSQ_SOURCE_LINE 00000325 "    # while(my($key,$subschema) = each %$mapping) {"
NSQ_SOURCE_LINE 00000326 "    for my $key (keys %$mapping) {"
NSQ_SOURCE_LINE 00000327 "\tmy $subschema = $mapping->{$key};"
NSQ_SOURCE_LINE 00000328 "\tif ($key eq '=') { # the \"default\" key"
NSQ_SOURCE_LINE 00000329 "\t    $default_key_schema = $subschema;"
NSQ_SOURCE_LINE 00000330 "\t    next;"
NSQ_SOURCE_LINE 00000331 "\t}"
NSQ_SOURCE_LINE 00000332 "\tmy $subpath = _append_path($path, $key);"
NSQ_SOURCE_LINE 00000333 "\t$self->{path} = $subpath;"
NSQ_SOURCE_LINE 00000334 "\tif (!UNIVERSAL::isa($subschema, 'HASH')) {"
NSQ_SOURCE_LINE 00000335 "\t    $self->_die(\"Expected subschema (a hash)\");"
NSQ_SOURCE_LINE 00000336 "\t}"
NSQ_SOURCE_LINE 00000337 "\tmy $required = _get_boolean($subschema->{required});"
NSQ_SOURCE_LINE 00000338 "\tif (!defined $data->{$key}) {"
NSQ_SOURCE_LINE 00000339 "\t    if ($required) {"
NSQ_SOURCE_LINE 00000340 "\t\t$self->{path} = $path;"
NSQ_SOURCE_LINE 00000341 "\t\t$self->_error(\"Expected required key '$key'\");"
NSQ_SOURCE_LINE 00000342 "\t\tnext;"
NSQ_SOURCE_LINE 00000343 "\t    } else {"
NSQ_SOURCE_LINE 00000344 "\t\t$seen_key{$key}++;"
NSQ_SOURCE_LINE 00000345 "\t\tnext;"
NSQ_SOURCE_LINE 00000346 "\t    }"
NSQ_SOURCE_LINE 00000347 "\t}"
NSQ_SOURCE_LINE 00000348 "\tmy $unique = _get_boolean($subschema->{unique});"
NSQ_SOURCE_LINE 00000349 "\tif ($unique) {"
NSQ_SOURCE_LINE 00000350 "\t    if (defined $unique_mapping_val->{$data->{$key}}->{val} "
NSQ_SOURCE_LINE 00000351 "\t\t&& $unique_mapping_val->{$data->{$key}}->{val} eq $data->{$key}) {"
NSQ_SOURCE_LINE 00000352 "\t\t$self->_error(\"'$data->{$key}' is already used at '$unique_mapping_val->{$data->{$key}}->{path}'\");"
NSQ_SOURCE_LINE 00000353 "\t    } else {"
NSQ_SOURCE_LINE 00000354 "\t\t$unique_mapping_val->{$data->{$key}} = { val  => $data->{$key},"
NSQ_SOURCE_LINE 00000355 "\t\t\t\t\t\t\t path => $subpath,"
NSQ_SOURCE_LINE 00000356 "\t\t\t\t\t\t       };"
NSQ_SOURCE_LINE 00000357 "\t    }"
NSQ_SOURCE_LINE 00000358 "\t}"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "\t$self->_validate($subschema, $data->{$key}, $subpath);"
NSQ_SOURCE_LINE 00000361 "\t$seen_key{$key}++;"
NSQ_SOURCE_LINE 00000362 "    }"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "#    while(my($key,$val) = each %$data) {"
NSQ_SOURCE_LINE 00000365 "    for my $key (keys %$data) {"
NSQ_SOURCE_LINE 00000366 "\tmy $val = $data->{$key};"
NSQ_SOURCE_LINE 00000367 "\tmy $subpath = _append_path($path, $key);"
NSQ_SOURCE_LINE 00000368 "\t$self->{path} = $subpath;"
NSQ_SOURCE_LINE 00000369 "\tif (!$seen_key{$key}) {"
NSQ_SOURCE_LINE 00000370 "\t    if ($default_key_schema) {"
NSQ_SOURCE_LINE 00000371 "\t\t$self->_validate($default_key_schema, $val, $subpath);"
NSQ_SOURCE_LINE 00000372 "\t    } else {"
NSQ_SOURCE_LINE 00000373 "\t\t$self->_error(\"Unexpected key '$key'\");"
NSQ_SOURCE_LINE 00000374 "\t    }"
NSQ_SOURCE_LINE 00000375 "\t}"
NSQ_SOURCE_LINE 00000376 "    }"
NSQ_SOURCE_LINE 00000377 "}"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "sub _die {"
NSQ_SOURCE_LINE 00000380 "    my($self, $msg) = @_;"
NSQ_SOURCE_LINE 00000381 "    $msg = \"[$self->{path}] $msg\";"
NSQ_SOURCE_LINE 00000382 "    die $msg.\"\\n\";"
NSQ_SOURCE_LINE 00000383 "}"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "sub _error {"
NSQ_SOURCE_LINE 00000386 "    my($self, $msg) = @_;"
NSQ_SOURCE_LINE 00000387 "    $msg = \"[$self->{path}] $msg\";"
NSQ_SOURCE_LINE 00000388 "    push @{$self->{errors}}, $msg;"
NSQ_SOURCE_LINE 00000389 "    0;"
NSQ_SOURCE_LINE 00000390 "}"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "# Functions:"
NSQ_SOURCE_LINE 00000393 "sub _append_path {"
NSQ_SOURCE_LINE 00000394 "    my($root, $leaf) = @_;"
NSQ_SOURCE_LINE 00000395 "    $root . ($root !~ m{/$} ? \"/\" : \"\") . $leaf;"
NSQ_SOURCE_LINE 00000396 "}"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "sub _base_path {"
NSQ_SOURCE_LINE 00000399 "    my($path) = @_;"
NSQ_SOURCE_LINE 00000400 "    my($base) = $path =~ m{([^/]+)$};"
NSQ_SOURCE_LINE 00000401 "    $base;"
NSQ_SOURCE_LINE 00000402 "}"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "sub _get_boolean {"
NSQ_SOURCE_LINE 00000405 "    my($val) = @_;"
NSQ_SOURCE_LINE 00000406 "    defined $val && $val =~ m{^(yes|true|1)$}; # XXX check for all boolean trues"
NSQ_SOURCE_LINE 00000407 "}"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "1;"
NSQ_SOURCE_LINE 00000410 "__END__"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "=head1 NAME"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "Kwalify - Kwalify schema for data structures"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "  use Kwalify qw(validate);"
NSQ_SOURCE_LINE 00000419 "  validate($schema, $data);"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "Typically used together with YAML or JSON:"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "  use YAML;"
NSQ_SOURCE_LINE 00000424 "  validate(YAML::LoadFile($schema_file), YAML::LoadFile($data_file));"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "  use JSON;"
NSQ_SOURCE_LINE 00000427 "  validate(decode_json($schema_data), decode_json($data));"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "Kwalify is a Perl implementation for validating data structures"
NSQ_SOURCE_LINE 00000432 "against the Kwalify schema. For a schema definition, see"
NSQ_SOURCE_LINE 00000433 "L<https://web.archive.org/web/20190718083758/http://www.kuwata-lab.com/kwalify/ruby/users-guide.01.html>, but see"
NSQ_SOURCE_LINE 00000434 "also below L</SCHEMA DEFINITION>."
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "=head2 validate($schema_data, $data)"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "Validate I<$data> according to Kwalify schema specified in"
NSQ_SOURCE_LINE 00000439 "I<$schema_data>. Dies if the validation fails."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "B<validate> may be exported."
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "=head1 SCHEMA DEFINITION"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "The original schema definition document is not very specific about"
NSQ_SOURCE_LINE 00000446 "types and behaviour. Here's how B<Kwalify.pm> implements things:"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "=over"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "=item name"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "The name of the schema."
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "=item desc"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "The description for the rule."
NSQ_SOURCE_LINE 00000457 "It is not used for validation."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "=item pattern"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "A pattern matching the valid values."
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "Perl regular expressions are used for patterns. This may or may not be"
NSQ_SOURCE_LINE 00000464 "compatible with other Kwalify validators, so restrict to \"simple\""
NSQ_SOURCE_LINE 00000465 "regular expression constructs to be compatible with other validators."
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "=item enum"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "A list of the valid values."
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "=item range"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "A hash with the valid value ranges for types other than B<seq>, B<map>,"
NSQ_SOURCE_LINE 00000474 "B<bool> and B<any>."
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "=over"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "=item max"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "The maximum inclusive."
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "=item min"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "The minimum inclusive."
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "=item max-ex"
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "The maximum exclusive."
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "=item min-ex"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "The minimum exclusive."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "=back"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=item length"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "Like B<range> but for B<str> and B<text>."
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "=item required"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "A constraint to denote the value is required when B<true>."
NSQ_SOURCE_LINE 00000503 "The default is B<false>."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=item type"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "The default B<type> if omitted is B<str>."
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=over"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=item str"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "Any defined value which is B<not> a number. Most probably you will"
NSQ_SOURCE_LINE 00000514 "want to use B<text> instead of B<str>."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=item int"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "A possibly signed integer. Note that scientific notation is not"
NSQ_SOURCE_LINE 00000519 "supported, and it is also not clear whether it should be supported."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "=item float"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "A possibly signed floating value with a mandatory decimal point. Note"
NSQ_SOURCE_LINE 00000524 "that scientific notation is also not supported here."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "=item number"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "A possibly signed floating value with an optional decimal point (so"
NSQ_SOURCE_LINE 00000529 "either B<int> or B<float>)."
NSQ_SOURCE_LINE 00000530 "Note that scientific notation is also not supported here."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "=item text"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "Any defined value which is either a B<str> or a B<number>."
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "=item bool"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "The values B<yes>, B<true>, and B<1> for true values and the values"
NSQ_SOURCE_LINE 00000539 "B<no>, B<false>, and B<0> for false values are allowed. The ruby"
NSQ_SOURCE_LINE 00000540 "implementation possibly allows more values, but this is not"
NSQ_SOURCE_LINE 00000541 "documented."
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "Note that this definition is problematic, because for example the"
NSQ_SOURCE_LINE 00000544 "string B<no> is a true boolean value in Perl. So one should stick to"
NSQ_SOURCE_LINE 00000545 "B<0> and B<1> as data values, and probably define an additional"
NSQ_SOURCE_LINE 00000546 "B<pattern> or B<enum> to ensure this:"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "    type: bool"
NSQ_SOURCE_LINE 00000549 "    enum: [0, 1]"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "=item date"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "A string matching C<< /^\\d{4}-\\d{2}-\\d{2}$/ >> (i.e. YYYY-MM-DD). Note"
NSQ_SOURCE_LINE 00000554 "that no date range checks are done (yet)."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "=item time"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "A string matching C<< /^\\d{2}:\\d{2}:\\d{2}$/ >> (i.e. HH:MM:SS). Note"
NSQ_SOURCE_LINE 00000559 "that no time range checks are done (yet)."
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "=item timestamp"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "Not supported --- it is not clear what this is supposed to be."
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "=item seq"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "A sequence (list) of rules."
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "=item map"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "A mapping (hash) of rules."
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "The name \"B<=>\" can be used to apply rules to any key."
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "=item scalar"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "Currently the same as B<text>, but it's not clear if this is correct."
NSQ_SOURCE_LINE 00000578 "Originally defined as all but B<seq> and B<map>."
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "=item any"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "Any data type."
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "=back"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "=item unique"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "The value is unique for a B<seq> or a B<map>."
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "=item assert"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "Currently not supported by the Perl implementation."
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "=item classname"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "Previously defined what is now B<class>, see L<https://web.archive.org/web/20190718083758/http://www.kuwata-lab.com/kwalify/ruby/users-guide.01.html>."
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "=item class"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "Currently not used, as there's no genclass action."
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "=item default"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "Currently not used, as there's no genclass action."
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "=back"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "=head1 TECHNICAL NOTES"
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "As B<Kwalify.pm> is a pure validator and de-coupled from a parser (in"
NSQ_SOURCE_LINE 00000611 "fact, it does not need to deal with YAML at all, but just with pure"
NSQ_SOURCE_LINE 00000612 "perl data structures), there's no connection to the original validated"
NSQ_SOURCE_LINE 00000613 "document. This means that no line numbers are available to the"
NSQ_SOURCE_LINE 00000614 "validator. In case of validation errors the validator is only able to"
NSQ_SOURCE_LINE 00000615 "show a path-like expression to the data causing the error."
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "Slaven ReziE<x0107>, E<lt>srezic@cpan.orgE<gt>"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "=head1 COPYRIGHT AND LICENSE"
NSQ_SOURCE_LINE 00000622 ""
