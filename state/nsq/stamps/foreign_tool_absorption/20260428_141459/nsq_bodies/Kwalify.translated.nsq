NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "L<pkwalify>, L<kwalify(1)>."
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "Other non-XML schema languages: L<http://rx.codesimply.com/>"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "=cut"
BODY_END
