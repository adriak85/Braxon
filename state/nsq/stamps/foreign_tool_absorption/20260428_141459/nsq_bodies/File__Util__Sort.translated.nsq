NSQ_SOURCE_LINE 00000684 "# ABSTRACT: Routines related to sorting files in one or more directories"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "__END__"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "=pod"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "=head1 NAME"
NSQ_SOURCE_LINE 00000693 ""
NSQ_SOURCE_LINE 00000694 "File::Util::Sort - Routines related to sorting files in one or more directories"
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "=head1 VERSION"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "This document describes version 0.011 of File::Util::Sort (from Perl distribution File-Util-Sort), released on 2025-05-03."
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "=head2 foremost"
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "Usage:"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 " foremost(%args) -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "Return file(s) which are alphabetically the first."
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "Notes:"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "=over"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "=item * by default dotfiles are not included, use C<--all> (C<-a>) to include them"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "=back"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "Some examples:"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 " # return foremost file in current directory"
NSQ_SOURCE_LINE 00000724 " % foremost -f"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "=over 4"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "=item * B<all> => I<true>"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "Do not ignore entries starting with ."
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "=item * B<detail> => I<true>"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "(No description)"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "=item * B<dirs> => I<array[dirname]> (default: [\".\"])"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "Directory to sort files of, defaults to current directory."
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "=item * B<exclude_filename_pattern> => I<re_from_str>"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "Exclude filenames that match a regex pattern."
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "=item * B<ignore_case> => I<bool>"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "(No description)"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "=item * B<include_filename_pattern> => I<re_from_str>"
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "Only include filenames that match a regex pattern."
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "=item * B<num_ranks> => I<uint>"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "Number of ranks to return."
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "Difference between C<num_results> and C<num_ranks>: C<num_results> (C<-n> option)"
NSQ_SOURCE_LINE 00000761 "specifies number of results regardless of ranks while C<num_ranks> (C<-N> option)"
NSQ_SOURCE_LINE 00000762 "returns number of ranks. For example, if sorting is by reverse size and if"
NSQ_SOURCE_LINE 00000763 "C<num_results> is set to 1 and there are 2 files with the same largest size then"
NSQ_SOURCE_LINE 00000764 "only 1 of those files will be returned. With C<num_ranks> set to 1, both files"
NSQ_SOURCE_LINE 00000765 "will be returned because are they both rank #1."
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "=item * B<num_results> => I<uint>"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "Number of results to return."
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "=item * B<recursive> => I<true>"
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "Recurse into subdirectories."
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "=item * B<type> => I<str>"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "Only include files of certain type."
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "=back"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "First element ($status_code) is an integer containing HTTP-like status code"
NSQ_SOURCE_LINE 00000785 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000786 "($reason) is a string containing error message, or something like \"OK\" if status is"
NSQ_SOURCE_LINE 00000787 "200. Third element ($payload) is the actual result, but usually not present when enveloped result is an error response ($status_code is not 2xx). Fourth"
NSQ_SOURCE_LINE 00000788 "element (%result_meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000789 "that contains extra information, much like how HTTP response headers provide additional metadata."
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "Return value:  (any)"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "=head2 hindmost"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "Usage:"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 " hindmost(%args) -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "Return file(s) which are alphabetically the last."
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "Notes:"
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "=over"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "=item * by default dotfiles are not included, use C<--all> (C<-a>) to include them"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "=back"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "Some examples:"
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 " # return hindmost file in current directory"
NSQ_SOURCE_LINE 00000814 " % hindmost -f"
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "=over 4"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "=item * B<all> => I<true>"
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "Do not ignore entries starting with ."
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "=item * B<detail> => I<true>"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "(No description)"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "=item * B<dirs> => I<array[dirname]> (default: [\".\"])"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "Directory to sort files of, defaults to current directory."
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "=item * B<exclude_filename_pattern> => I<re_from_str>"
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "Exclude filenames that match a regex pattern."
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "=item * B<ignore_case> => I<bool>"
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "(No description)"
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "=item * B<include_filename_pattern> => I<re_from_str>"
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "Only include filenames that match a regex pattern."
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "=item * B<num_ranks> => I<uint>"
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "Number of ranks to return."
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "Difference between C<num_results> and C<num_ranks>: C<num_results> (C<-n> option)"
NSQ_SOURCE_LINE 00000851 "specifies number of results regardless of ranks while C<num_ranks> (C<-N> option)"
NSQ_SOURCE_LINE 00000852 "returns number of ranks. For example, if sorting is by reverse size and if"
NSQ_SOURCE_LINE 00000853 "C<num_results> is set to 1 and there are 2 files with the same largest size then"
NSQ_SOURCE_LINE 00000854 "only 1 of those files will be returned. With C<num_ranks> set to 1, both files"
NSQ_SOURCE_LINE 00000855 "will be returned because are they both rank #1."
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "=item * B<num_results> => I<uint>"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "Number of results to return."
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "=item * B<recursive> => I<true>"
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "Recurse into subdirectories."
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "=item * B<type> => I<str>"
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 "Only include files of certain type."
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "=back"
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "First element ($status_code) is an integer containing HTTP-like status code"
NSQ_SOURCE_LINE 00000875 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000876 "($reason) is a string containing error message, or something like \"OK\" if status is"
NSQ_SOURCE_LINE 00000877 "200. Third element ($payload) is the actual result, but usually not present when enveloped result is an error response ($status_code is not 2xx). Fourth"
NSQ_SOURCE_LINE 00000878 "element (%result_meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000879 "that contains extra information, much like how HTTP response headers provide additional metadata."
NSQ_SOURCE_LINE 00000880 ""
NSQ_SOURCE_LINE 00000881 "Return value:  (any)"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 ""
NSQ_SOURCE_LINE 00000885 "=head2 largest"
