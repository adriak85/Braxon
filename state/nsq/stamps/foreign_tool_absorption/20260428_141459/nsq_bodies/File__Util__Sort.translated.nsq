NSQ_SOURCE_LINE 00000922 "Exclude filenames that match a regex pattern."
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "=item * B<include_filename_pattern> => I<re_from_str>"
