NSQ_SOURCE_LINE 00000001 "package File::Util::Sort;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Log::ger;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Exporter 'import';"
NSQ_SOURCE_LINE 00000009 "use Fcntl ':mode';"
NSQ_SOURCE_LINE 00000010 "use File::chdir;"
NSQ_SOURCE_LINE 00000011 "use Perinci::Sub::Util qw(gen_modified_sub);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000014 "our $DATE = '2025-05-03'; # DATE"
NSQ_SOURCE_LINE 00000015 "our $DIST = 'File-Util-Sort'; # DIST"
NSQ_SOURCE_LINE 00000016 "our $VERSION = '0.011'; # VERSION"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "our %SPEC;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000021 "                       sort_files"
NSQ_SOURCE_LINE 00000022 "                       foremost"
NSQ_SOURCE_LINE 00000023 "                       hindmost"
NSQ_SOURCE_LINE 00000024 "                       largest"
NSQ_SOURCE_LINE 00000025 "                       smallest"
NSQ_SOURCE_LINE 00000026 "                       newest"
NSQ_SOURCE_LINE 00000027 "                       oldest"
NSQ_SOURCE_LINE 00000028 "                       longest_name"
NSQ_SOURCE_LINE 00000029 "                       shortest_name"
NSQ_SOURCE_LINE 00000030 "               );"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "my @file_types = qw(file dir);"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "my @file_fields = qw(name size mtime ctime);"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "our %argspecs_common = ("
NSQ_SOURCE_LINE 00000037 "    dirs => {"
NSQ_SOURCE_LINE 00000038 "        'x.name.is_plural' => 1,"
NSQ_SOURCE_LINE 00000039 "        'x.name.singular' => 'dir',"
NSQ_SOURCE_LINE 00000040 "        summary => 'Directory to sort files of, defaults to current directory',"
NSQ_SOURCE_LINE 00000041 "        schema => ['array*', of=>'dirname*', min_len=>1],"
NSQ_SOURCE_LINE 00000042 "        default => ['.'],"
NSQ_SOURCE_LINE 00000043 "        pos => 0,"
NSQ_SOURCE_LINE 00000044 "        slurpy => 1,"
NSQ_SOURCE_LINE 00000045 "        tags => ['category:input'],"
NSQ_SOURCE_LINE 00000046 "    },"
NSQ_SOURCE_LINE 00000047 "    recursive => {"
NSQ_SOURCE_LINE 00000048 "        summary => 'Recurse into subdirectories',"
NSQ_SOURCE_LINE 00000049 "        schema => 'true*',"
NSQ_SOURCE_LINE 00000050 "        cmdline_aliases => {R=>{}},"
NSQ_SOURCE_LINE 00000051 "        tags => ['category:input'],"
NSQ_SOURCE_LINE 00000052 "    },"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    type => {"
NSQ_SOURCE_LINE 00000055 "        summary => 'Only include files of certain type',"
NSQ_SOURCE_LINE 00000056 "        schema => ['str*', in=>\\@file_types],"
NSQ_SOURCE_LINE 00000057 "        cmdline_aliases => {"
NSQ_SOURCE_LINE 00000058 "            t => {},"
NSQ_SOURCE_LINE 00000059 "            f => {summary=>'Shortcut for `--type=file`', is_flag=>1, code=>sub { $_[0]{type} = 'file' }},"
NSQ_SOURCE_LINE 00000060 "            d => {summary=>'Shortcut for `--type=dir`' , is_flag=>1, code=>sub { $_[0]{type} = 'dir'  }},"
NSQ_SOURCE_LINE 00000061 "        },"
NSQ_SOURCE_LINE 00000062 "        tags => ['category:filtering'],"
NSQ_SOURCE_LINE 00000063 "    },"
NSQ_SOURCE_LINE 00000064 "    exclude_filename_pattern => {"
NSQ_SOURCE_LINE 00000065 "        summary => 'Exclude filenames that match a regex pattern',"
NSQ_SOURCE_LINE 00000066 "        schema => 're_from_str*',"
NSQ_SOURCE_LINE 00000067 "        cmdline_aliases => {X=>{}},"
NSQ_SOURCE_LINE 00000068 "        tags => ['category:filtering'],"
NSQ_SOURCE_LINE 00000069 "    },"
NSQ_SOURCE_LINE 00000070 "    include_filename_pattern => {"
NSQ_SOURCE_LINE 00000071 "        summary => 'Only include filenames that match a regex pattern',"
NSQ_SOURCE_LINE 00000072 "        schema => 're_from_str*',"
NSQ_SOURCE_LINE 00000073 "        cmdline_aliases => {I=>{}},"
NSQ_SOURCE_LINE 00000074 "        tags => ['category:filtering'],"
NSQ_SOURCE_LINE 00000075 "    },"
NSQ_SOURCE_LINE 00000076 "    all => {"
NSQ_SOURCE_LINE 00000077 "        summary => 'Do not ignore entries starting with .',"
NSQ_SOURCE_LINE 00000078 "        schema => 'true*',"
NSQ_SOURCE_LINE 00000079 "        cmdline_aliases => {a=>{}},"
NSQ_SOURCE_LINE 00000080 "        tags => ['category:filtering'],"
NSQ_SOURCE_LINE 00000081 "    },"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "    detail => {"
NSQ_SOURCE_LINE 00000084 "        schema => 'true*',"
NSQ_SOURCE_LINE 00000085 "        cmdline_aliases => {l=>{}},"
NSQ_SOURCE_LINE 00000086 "        tags => ['category:output'],"
NSQ_SOURCE_LINE 00000087 "    },"
NSQ_SOURCE_LINE 00000088 "    num_results => {"
NSQ_SOURCE_LINE 00000089 "        summary => 'Number of results to return',"
NSQ_SOURCE_LINE 00000090 "        schema => 'uint*',"
NSQ_SOURCE_LINE 00000091 "        cmdline_aliases => {n=>{}},"
NSQ_SOURCE_LINE 00000092 "    },"
NSQ_SOURCE_LINE 00000093 "    num_ranks => {"
NSQ_SOURCE_LINE 00000094 "        summary => 'Number of ranks to return',"
NSQ_SOURCE_LINE 00000095 "        schema => 'uint*',"
NSQ_SOURCE_LINE 00000096 "        description => <<'MARKDOWN',"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "Difference between `num_results` and `num_ranks`: `num_results` (`-n` option)"
NSQ_SOURCE_LINE 00000099 "specifies number of results regardless of ranks while `num_ranks` (`-N` option)"
NSQ_SOURCE_LINE 00000100 "returns number of ranks. For example, if sorting is by reverse size and if"
NSQ_SOURCE_LINE 00000101 "`num_results` is set to 1 and there are 2 files with the same largest size then"
NSQ_SOURCE_LINE 00000102 "only 1 of those files will be returned. With `num_ranks` set to 1, both files"
NSQ_SOURCE_LINE 00000103 "will be returned because are they both rank #1."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "MARKDOWN"
NSQ_SOURCE_LINE 00000106 "        cmdline_aliases => {N=>{}},"
NSQ_SOURCE_LINE 00000107 "    },"
NSQ_SOURCE_LINE 00000108 ");"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "our %argspecs_sort = ("
NSQ_SOURCE_LINE 00000111 "    by_code => {"
NSQ_SOURCE_LINE 00000112 "        summary => 'Perl code to sort',"
NSQ_SOURCE_LINE 00000113 "        schema => 'code_from_str*',"
NSQ_SOURCE_LINE 00000114 "        tags => ['category:sorting'],"
NSQ_SOURCE_LINE 00000115 "    },"
NSQ_SOURCE_LINE 00000116 "    by_sortsub => {"
NSQ_SOURCE_LINE 00000117 "        summary => 'Sort::Sub routine name to sort',"
NSQ_SOURCE_LINE 00000118 "        schema =>'str*',"
NSQ_SOURCE_LINE 00000119 "        'x.completion' => ['sortsub_spec'],"
NSQ_SOURCE_LINE 00000120 "        tags => ['category:sorting'],"
NSQ_SOURCE_LINE 00000121 "    },"
NSQ_SOURCE_LINE 00000122 "    sortsub_args => {"
NSQ_SOURCE_LINE 00000123 "        summary => 'Arguments to pass to Sort::Sub routine',"
NSQ_SOURCE_LINE 00000124 "        schema => ['hash*', of=>'str*'],"
NSQ_SOURCE_LINE 00000125 "    },"
NSQ_SOURCE_LINE 00000126 "    by_field => {"
NSQ_SOURCE_LINE 00000127 "        summary => 'Field name to sort against',"
NSQ_SOURCE_LINE 00000128 "        schema => ['str*', in=>\\@file_fields],"
NSQ_SOURCE_LINE 00000129 "        tags => ['category:sorting'],"
NSQ_SOURCE_LINE 00000130 "    },"
NSQ_SOURCE_LINE 00000131 "    reverse => {"
NSQ_SOURCE_LINE 00000132 "        summary => 'Reverse order of sorting',"
NSQ_SOURCE_LINE 00000133 "        schema => 'true*',"
NSQ_SOURCE_LINE 00000134 "        cmdline_aliases => {r=>{}},"
NSQ_SOURCE_LINE 00000135 "        tags => ['category:sorting'],"
NSQ_SOURCE_LINE 00000136 "    },"
NSQ_SOURCE_LINE 00000137 "    key => {"
NSQ_SOURCE_LINE 00000138 "        summary => 'Perl code to generate key to sort against',"
NSQ_SOURCE_LINE 00000139 "        schema => 'code_from_str*',"
NSQ_SOURCE_LINE 00000140 "        description => <<'MARKDOWN',"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "If `key` option is not specified, then: 1) if sorting is `by_code` then the code"
NSQ_SOURCE_LINE 00000143 "will receive files as records (hashes) with keys like `name`, `size`, etc; 2) if"
NSQ_SOURCE_LINE 00000144 "sorting is `by_field` then the associated field is used as key; 3) if sorting is"
NSQ_SOURCE_LINE 00000145 "`by_sortsub` then by default the `name` field will be used as the key."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "To select a field, use this:"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    '$_->{FIELDNAME}'"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "for example:"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    '$_->{size}'"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "Another example, to generate length of name as key:"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    'length($_->{name})'"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "MARKDOWN"
NSQ_SOURCE_LINE 00000160 "            tags => ['category:sorting'],"
NSQ_SOURCE_LINE 00000161 "    },"
NSQ_SOURCE_LINE 00000162 ");"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "our %argspec_ignore_case = ("
NSQ_SOURCE_LINE 00000165 "    ignore_case => {"
NSQ_SOURCE_LINE 00000166 "        schema => 'bool*',"
NSQ_SOURCE_LINE 00000167 "        cmdline_aliases => {i=>{}},"
NSQ_SOURCE_LINE 00000168 "        tags => ['category:sorting'],"
NSQ_SOURCE_LINE 00000169 "    },"
NSQ_SOURCE_LINE 00000170 ");"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "$SPEC{sort_files} = {"
NSQ_SOURCE_LINE 00000173 "    v => 1.1,"
NSQ_SOURCE_LINE 00000174 "    summary => 'Sort files in one or more directories and display the result in a flexible way',"
NSQ_SOURCE_LINE 00000175 "    description => <<'MARKDOWN',"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "MARKDOWN"
NSQ_SOURCE_LINE 00000179 "    args => {"
NSQ_SOURCE_LINE 00000180 "        %argspecs_common,"
NSQ_SOURCE_LINE 00000181 "        %argspecs_sort,"
NSQ_SOURCE_LINE 00000182 "    },"
NSQ_SOURCE_LINE 00000183 "    args_rels => {"
NSQ_SOURCE_LINE 00000184 "        'choose_one&' => ["
NSQ_SOURCE_LINE 00000185 "            [qw/by_field by_sortsub by_code/],"
NSQ_SOURCE_LINE 00000186 "            [qw/num_results num_ranks/],"
NSQ_SOURCE_LINE 00000187 "        ],"
NSQ_SOURCE_LINE 00000188 "    },"
NSQ_SOURCE_LINE 00000189 "};"
NSQ_SOURCE_LINE 00000190 "sub sort_files {"
NSQ_SOURCE_LINE 00000191 "    my %args = @_;"
NSQ_SOURCE_LINE 00000192 "    my $all = $args{all} // 0;"
NSQ_SOURCE_LINE 00000193 "    my $recursive = $args{recursive};"
NSQ_SOURCE_LINE 00000194 "    my $dirs = $args{dirs} // ['.'];"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "    my $code_get_recs;"
NSQ_SOURCE_LINE 00000197 "    $code_get_recs = sub {"
NSQ_SOURCE_LINE 00000198 "        my ($dir, $prefix) = @_;"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "        opendir my $dh, $dir or return [500, \"Can't opendir '$dir': $!\"];"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "        local $CWD = $dir;"
NSQ_SOURCE_LINE 00000203 "        my @recs;"
NSQ_SOURCE_LINE 00000204 "      FILE:"
NSQ_SOURCE_LINE 00000205 "        while (defined(my $e = readdir $dh)) {"
NSQ_SOURCE_LINE 00000206 "            next if $e eq '.' || $e eq '..';"
NSQ_SOURCE_LINE 00000207 "            if (defined $args{include_filename_pattern}) {"
NSQ_SOURCE_LINE 00000208 "                unless ($e =~ $args{include_filename_pattern}) {"
NSQ_SOURCE_LINE 00000209 "                    log_trace \"File $e excluded (not match $args{include_filename_pattern})\";"
NSQ_SOURCE_LINE 00000210 "                    next FILE;"
NSQ_SOURCE_LINE 00000211 "                }"
NSQ_SOURCE_LINE 00000212 "            }"
NSQ_SOURCE_LINE 00000213 "            if (defined $args{exclude_filename_pattern}) {"
NSQ_SOURCE_LINE 00000214 "                if ($e =~ $args{exclude_filename_pattern}) {"
NSQ_SOURCE_LINE 00000215 "                    log_trace \"File $e excluded (matches $args{exclude_filename_pattern})\";"
NSQ_SOURCE_LINE 00000216 "                    next FILE;"
NSQ_SOURCE_LINE 00000217 "                }"
NSQ_SOURCE_LINE 00000218 "            }"
NSQ_SOURCE_LINE 00000219 "            if (!$all) {"
NSQ_SOURCE_LINE 00000220 "                if ($e =~ /\\A\\./) {"
NSQ_SOURCE_LINE 00000221 "                    log_trace \"File $e excluded (dotfile hidden)\";"
NSQ_SOURCE_LINE 00000222 "                    next FILE;"
NSQ_SOURCE_LINE 00000223 "                }"
NSQ_SOURCE_LINE 00000224 "            }"
NSQ_SOURCE_LINE 00000225 "            my $rec = {name=>$e, dir=>(defined $prefix ? \"$prefix/$dir\" : $dir)};"
NSQ_SOURCE_LINE 00000226 "            my @st = lstat $e or do {"
NSQ_SOURCE_LINE 00000227 "                warn \"Can't stat '$e' in '$dir': $!, skipped\";"
NSQ_SOURCE_LINE 00000228 "                next;"
NSQ_SOURCE_LINE 00000229 "            };"
NSQ_SOURCE_LINE 00000230 "            $rec->{size} = $st[7];"
NSQ_SOURCE_LINE 00000231 "            $rec->{mtime} = $st[9];"
NSQ_SOURCE_LINE 00000232 "            $rec->{ctime} = $st[10];"
NSQ_SOURCE_LINE 00000233 "            $rec->{mode} = $st[2];"
NSQ_SOURCE_LINE 00000234 "          FILTER: {"
NSQ_SOURCE_LINE 00000235 "                if (defined $args{type}) {"
NSQ_SOURCE_LINE 00000236 "                    if ($args{type} eq 'file') {"
NSQ_SOURCE_LINE 00000237 "                        unless ($rec->{mode} & S_IFREG) {"
NSQ_SOURCE_LINE 00000238 "                            log_trace \"File '$e' in '$dir': not a regular file, skipped\";"
NSQ_SOURCE_LINE 00000239 "                            goto SKIP_ADD_FILE;"
NSQ_SOURCE_LINE 00000240 "                        }"
NSQ_SOURCE_LINE 00000241 "                    } elsif ($args{type} eq 'dir') {"
NSQ_SOURCE_LINE 00000242 "                        unless ($rec->{mode} & S_IFDIR) {"
NSQ_SOURCE_LINE 00000243 "                            log_trace \"File '$e' in '$dir': not a directory, skipped\";"
NSQ_SOURCE_LINE 00000244 "                            goto SKIP_ADD_FILE;"
NSQ_SOURCE_LINE 00000245 "                        }"
NSQ_SOURCE_LINE 00000246 "                    } else {"
NSQ_SOURCE_LINE 00000247 "                        return [400, \"Invalid value of type '$args{type}'\"];"
NSQ_SOURCE_LINE 00000248 "                    }"
NSQ_SOURCE_LINE 00000249 "                }"
NSQ_SOURCE_LINE 00000250 "            } # FILTER"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "            push @recs, $rec;"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "          SKIP_ADD_FILE:"
NSQ_SOURCE_LINE 00000255 "            if ($recursive && $rec->{mode} & S_IFDIR) {"
NSQ_SOURCE_LINE 00000256 "                log_trace \"Recursing into $dir/$e ...\";"
NSQ_SOURCE_LINE 00000257 "                my $subres = $code_get_recs->($e, $dir);"
NSQ_SOURCE_LINE 00000258 "                if ($subres->[0] == 200) {"
NSQ_SOURCE_LINE 00000259 "                    push @recs, @{ $subres->[2] };"
NSQ_SOURCE_LINE 00000260 "                } else {"
NSQ_SOURCE_LINE 00000261 "                    log_error \"Cannot recurse into $dir/$e: $subres->[0] - $subres->[1]\";"
NSQ_SOURCE_LINE 00000262 "                }"
NSQ_SOURCE_LINE 00000263 "            }"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "        }"
NSQ_SOURCE_LINE 00000266 "        closedir $dh;"
NSQ_SOURCE_LINE 00000267 "        return [200, \"OK\", \\@recs];"
NSQ_SOURCE_LINE 00000268 "    }; # $code_get_files"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "    my @recs;"
NSQ_SOURCE_LINE 00000271 "  DIR:"
NSQ_SOURCE_LINE 00000272 "    for my $dir (@$dirs) {"
NSQ_SOURCE_LINE 00000273 "        my $res = $code_get_recs->($dir);"
NSQ_SOURCE_LINE 00000274 "        return $res unless $res->[0] == 200;"
NSQ_SOURCE_LINE 00000275 "        push @recs, @{ $res->[2] };"
NSQ_SOURCE_LINE 00000276 "    } # DIR"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "    my ($code_key, $code_cmp);"
NSQ_SOURCE_LINE 00000279 "  SET_CODE_CMP: {"
NSQ_SOURCE_LINE 00000280 "        if (defined $args{key}) {"
NSQ_SOURCE_LINE 00000281 "            $code_key = $args{key};"
NSQ_SOURCE_LINE 00000282 "        }"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "        if (defined $args{by_code}) {"
NSQ_SOURCE_LINE 00000285 "            $code_key //= sub { $_[0] };"
NSQ_SOURCE_LINE 00000286 "            $code_cmp = $args{by_code};"
NSQ_SOURCE_LINE 00000287 "            last;"
NSQ_SOURCE_LINE 00000288 "        }"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "        if (defined $args{by_sortsub}) {"
NSQ_SOURCE_LINE 00000291 "            require Sort::Sub;"
NSQ_SOURCE_LINE 00000292 "            $code_key //= sub { $_[0]->{name} };"
NSQ_SOURCE_LINE 00000293 "            $code_cmp = Sort::Sub::gen_sorter($args{by_sortsub}, $args{sortsub_args});"
NSQ_SOURCE_LINE 00000294 "        }"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "        if (defined $args{by_field}) {"
NSQ_SOURCE_LINE 00000297 "            if ($args{by_field} eq 'name') {"
NSQ_SOURCE_LINE 00000298 "                $code_key //= sub { $_[0]->{name} };"
NSQ_SOURCE_LINE 00000299 "                $code_cmp = sub { $_[0] cmp $_[1] };"
NSQ_SOURCE_LINE 00000300 "            } elsif ($args{by_field} eq 'size') {"
NSQ_SOURCE_LINE 00000301 "                $code_key //= sub { $_[0]->{size} };"
NSQ_SOURCE_LINE 00000302 "                $code_cmp = sub { $_[0] <=> $_[1] };"
NSQ_SOURCE_LINE 00000303 "            } elsif ($args{by_field} eq 'ctime') {"
NSQ_SOURCE_LINE 00000304 "                $code_key //= sub { $_[0]->{ctime} };"
NSQ_SOURCE_LINE 00000305 "                $code_cmp = sub { $_[0] <=> $_[1] };"
NSQ_SOURCE_LINE 00000306 "            } elsif ($args{by_field} eq 'mtime') {"
NSQ_SOURCE_LINE 00000307 "                $code_key //= sub { $_[0]->{mtime} };"
NSQ_SOURCE_LINE 00000308 "                $code_cmp = sub { $_[0] <=> $_[1] };"
NSQ_SOURCE_LINE 00000309 "            } else {"
NSQ_SOURCE_LINE 00000310 "                return [400, \"Invalid value in by_field: $args{by_field}\"];"
NSQ_SOURCE_LINE 00000311 "            }"
NSQ_SOURCE_LINE 00000312 "            last;"
NSQ_SOURCE_LINE 00000313 "        }"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "        return [400, \"Please specify one of by_field/by_sortsub/by_code\"];"
NSQ_SOURCE_LINE 00000316 "    } # SET_CODE_CMP"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "    my (@ranks, @sorted_recs);"
NSQ_SOURCE_LINE 00000319 "  SORT: {"
NSQ_SOURCE_LINE 00000320 "        require List::Rank;"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "        my @res = List::Rank::sortrankby("
NSQ_SOURCE_LINE 00000323 "            sub {"
NSQ_SOURCE_LINE 00000324 "                ;"
NSQ_SOURCE_LINE 00000325 "                my ($key1, $key2);"
NSQ_SOURCE_LINE 00000326 "                {"
NSQ_SOURCE_LINE 00000327 "                    local $_ = $a;"
NSQ_SOURCE_LINE 00000328 "                    $key1 = $code_key->($a);"
NSQ_SOURCE_LINE 00000329 "                }"
NSQ_SOURCE_LINE 00000330 "                {"
NSQ_SOURCE_LINE 00000331 "                    local $_ = $b;"
NSQ_SOURCE_LINE 00000332 "                    $key2 = $code_key->($b);"
NSQ_SOURCE_LINE 00000333 "                }"
NSQ_SOURCE_LINE 00000334 "                $args{reverse} ? $code_cmp->($key2, $key1) : $code_cmp->($key1, $key2);"
NSQ_SOURCE_LINE 00000335 "            },"
NSQ_SOURCE_LINE 00000336 "            @recs"
NSQ_SOURCE_LINE 00000337 "        );"
NSQ_SOURCE_LINE 00000338 "        while (my ($e1, $e2) = splice @res, 0, 2) {"
NSQ_SOURCE_LINE 00000339 "            push @sorted_recs, $e1;"
NSQ_SOURCE_LINE 00000340 "            push @ranks, $e2;"
NSQ_SOURCE_LINE 00000341 "        }"
NSQ_SOURCE_LINE 00000342 "    } # SORT"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "  NUM_RESULTS: {"
NSQ_SOURCE_LINE 00000345 "        last unless defined $args{num_results} && $args{num_results} > 0;"
NSQ_SOURCE_LINE 00000346 "        last unless $args{num_results} < @sorted_recs;"
NSQ_SOURCE_LINE 00000347 "        splice @sorted_recs, $args{num_results};"
NSQ_SOURCE_LINE 00000348 "    }"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "  NUM_RANKS: {"
NSQ_SOURCE_LINE 00000351 "        last unless defined $args{num_ranks} && $args{num_ranks} > 0;"
NSQ_SOURCE_LINE 00000352 "        my @res;"
NSQ_SOURCE_LINE 00000353 "        my $i = -1;"
NSQ_SOURCE_LINE 00000354 "        while (1) {"
NSQ_SOURCE_LINE 00000355 "            $i++;"
NSQ_SOURCE_LINE 00000356 "            last if $i >= @sorted_recs;"
NSQ_SOURCE_LINE 00000357 "            my $rank = $ranks[$i];"
NSQ_SOURCE_LINE 00000358 "            $rank =~ s/=\\z//;"
NSQ_SOURCE_LINE 00000359 "            last if $rank > $args{num_ranks};"
NSQ_SOURCE_LINE 00000360 "            push @res, $sorted_recs[$i];"
NSQ_SOURCE_LINE 00000361 "        }"
NSQ_SOURCE_LINE 00000362 "        @sorted_recs = @res;"
NSQ_SOURCE_LINE 00000363 "    }"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "    if ($args{detail}) {"
NSQ_SOURCE_LINE 00000366 "    } else {"
NSQ_SOURCE_LINE 00000367 "        @sorted_recs = map { ($_->{dir} eq '.' ? '' : $_->{dir} eq '/' ? '/' : \"$_->{dir}/\") . $_->{name} } @sorted_recs;"
NSQ_SOURCE_LINE 00000368 "    }"
NSQ_SOURCE_LINE 00000369 "    log_info \"Sorted files: %s\", \\@sorted_recs;"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "    [200, \"OK\", \\@sorted_recs];"
NSQ_SOURCE_LINE 00000372 "}"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "# foremost"
NSQ_SOURCE_LINE 00000375 "gen_modified_sub("
NSQ_SOURCE_LINE 00000376 "    die => 1,"
NSQ_SOURCE_LINE 00000377 "    output_name => 'foremost',"
NSQ_SOURCE_LINE 00000378 "    base_name => 'sort_files',"
NSQ_SOURCE_LINE 00000379 "    remove_args => [keys %argspecs_sort],"
NSQ_SOURCE_LINE 00000380 "    add_args => {"
NSQ_SOURCE_LINE 00000381 "        %argspec_ignore_case,"
NSQ_SOURCE_LINE 00000382 "    },"
NSQ_SOURCE_LINE 00000383 "    summary => 'Return file(s) which are alphabetically the first',"
NSQ_SOURCE_LINE 00000384 "    description => <<'MARKDOWN',"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "Notes:"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "- by default dotfiles are not included, use `--all` (`-a`) to include them"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "Some examples:"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "    # return foremost file in current directory"
NSQ_SOURCE_LINE 00000393 "    % foremost -f"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "MARKDOWN"
NSQ_SOURCE_LINE 00000396 "    output_code => sub {"
NSQ_SOURCE_LINE 00000397 "        my %args = @_;"
NSQ_SOURCE_LINE 00000398 ""
