NSQ_SOURCE_LINE 00000487 "    base_name => 'sort_files',"
NSQ_SOURCE_LINE 00000488 "    remove_args => [keys %argspecs_sort],"
NSQ_SOURCE_LINE 00000489 "    summary => 'Return the smallest file(s) in one or more directories',"
NSQ_SOURCE_LINE 00000490 "    description => <<'MARKDOWN',"
