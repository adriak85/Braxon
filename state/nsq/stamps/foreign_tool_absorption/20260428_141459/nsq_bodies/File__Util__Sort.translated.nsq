NSQ_SOURCE_LINE 00000400 "            $args{num_results} = 1;"
NSQ_SOURCE_LINE 00000401 "        }"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "        sort_files("
NSQ_SOURCE_LINE 00000404 "            %args,"
NSQ_SOURCE_LINE 00000405 "            by_field => 'name',"
NSQ_SOURCE_LINE 00000406 "            ($args{ignore_case} ? (key=>sub {lc $_[0]{name}}) : ()),"
NSQ_SOURCE_LINE 00000407 "        );"
NSQ_SOURCE_LINE 00000408 "    },"
NSQ_SOURCE_LINE 00000409 ");"
NSQ_SOURCE_LINE 00000410 ""
