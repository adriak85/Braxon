NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 ""
NSQ_SOURCE_LINE 00000967 "=head2 longest_name"
NSQ_SOURCE_LINE 00000968 ""
NSQ_SOURCE_LINE 00000969 "Usage:"
NSQ_SOURCE_LINE 00000970 ""
NSQ_SOURCE_LINE 00000971 " longest_name(%args) -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "Return file(s) with the longest name in one or more directories."
NSQ_SOURCE_LINE 00000974 ""
NSQ_SOURCE_LINE 00000975 "Notes:"
NSQ_SOURCE_LINE 00000976 ""
NSQ_SOURCE_LINE 00000977 "=over"
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "=item * by default dotfiles are not included, use C<--all> (C<-a>) to include them"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "=back"
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 "Some examples:"
NSQ_SOURCE_LINE 00000984 ""
NSQ_SOURCE_LINE 00000985 " # return file with the longest name in current directory"
NSQ_SOURCE_LINE 00000986 " % longest-name -f"
NSQ_SOURCE_LINE 00000987 " "
NSQ_SOURCE_LINE 00000988 " # return file(s) with the longest name in /some/dir. if there are multiple"
NSQ_SOURCE_LINE 00000989 " # files with the same length, they will all be returned."
NSQ_SOURCE_LINE 00000990 " % longest-name -N1 -f /some/dir"
NSQ_SOURCE_LINE 00000991 ""
