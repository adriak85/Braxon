NSQ_SOURCE_LINE 00000652 "    summary => 'Return file(s) with the shortest name in one or more directories',"
NSQ_SOURCE_LINE 00000653 "    description => <<'MARKDOWN',"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "Notes:"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "- by default dotfiles are not included, use `--all` (`-a`) to include them"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "Some examples:"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "    # return file with the shortest name in current directory"
NSQ_SOURCE_LINE 00000662 "    % shortest-name -f"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "    # return file(s) with the shortest name in /some/dir. if there are multiple"
NSQ_SOURCE_LINE 00000665 "    # files with the same length, they will all be returned."
NSQ_SOURCE_LINE 00000666 "    % shortest-name -N1 -f /some/dir"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "MARKDOWN"
NSQ_SOURCE_LINE 00000669 "    output_code => sub {"
NSQ_SOURCE_LINE 00000670 "        my %args = @_;"
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "        unless (defined $args{num_results} || defined $args{num_ranks}) {"
NSQ_SOURCE_LINE 00000673 "            $args{num_results} = 1;"
NSQ_SOURCE_LINE 00000674 "        }"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "        sort_files("
NSQ_SOURCE_LINE 00000677 "            %args,"
NSQ_SOURCE_LINE 00000678 "            by_code => sub { length($_[0]{name}) <=> length($_[1]{name}) },"
