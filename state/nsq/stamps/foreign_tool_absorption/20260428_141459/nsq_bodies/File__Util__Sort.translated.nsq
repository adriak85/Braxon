NSQ_SOURCE_LINE 00001013 ""
NSQ_SOURCE_LINE 00001014 "=item * B<include_filename_pattern> => I<re_from_str>"
NSQ_SOURCE_LINE 00001015 ""
NSQ_SOURCE_LINE 00001016 "Only include filenames that match a regex pattern."
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "=item * B<num_ranks> => I<uint>"
