NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "=head2 newest"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "Usage:"
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 " newest(%args) -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "Return the newest file(s) in one or more directories."
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "Notes:"
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "=over"
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "=item * by default dotfiles are not included, use C<--all> (C<-a>) to include them"
NSQ_SOURCE_LINE 00001070 ""
NSQ_SOURCE_LINE 00001071 "=back"
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "Suppose a new file is downloaded in C<~/Downloads>, but you are not sure of its"
NSQ_SOURCE_LINE 00001074 "name. You just want to move that file, which you are pretty sure is the newest"
NSQ_SOURCE_LINE 00001075 "in the C<Downloads> directory, somewhere else. So from the CLI in C<~/Downloads>:"
NSQ_SOURCE_LINE 00001076 ""
NSQ_SOURCE_LINE 00001077 " % mv C<newest -f> /somewhere/else"
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "or, from C</somewhere/else>:"
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 " % mv C<newest -f ~/Downloads> ."
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "If you want to see the filename on stderr as well:"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 " % mv C<newest --verbose -f ~/Downloads> ."
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 "File is deemed as newest by its mtime."
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "Some examples:"
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 " # return newest file in current directory"
NSQ_SOURCE_LINE 00001092 " % newest -f"
NSQ_SOURCE_LINE 00001093 " "
NSQ_SOURCE_LINE 00001094 " # return newest file(s) in /some/dir (if there are multiple files with the"
NSQ_SOURCE_LINE 00001095 " # same newest mtime) they will all be returned"
NSQ_SOURCE_LINE 00001096 " % newest -N1 -f /some/dir"
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "=over 4"
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 "=item * B<all> => I<true>"
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 "Do not ignore entries starting with ."
NSQ_SOURCE_LINE 00001107 ""
NSQ_SOURCE_LINE 00001108 "=item * B<detail> => I<true>"
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "(No description)"
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 "=item * B<dirs> => I<array[dirname]> (default: [\".\"])"
NSQ_SOURCE_LINE 00001113 ""
NSQ_SOURCE_LINE 00001114 "Directory to sort files of, defaults to current directory."
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "=item * B<exclude_filename_pattern> => I<re_from_str>"
NSQ_SOURCE_LINE 00001117 ""
NSQ_SOURCE_LINE 00001118 "Exclude filenames that match a regex pattern."
NSQ_SOURCE_LINE 00001119 ""
NSQ_SOURCE_LINE 00001120 "=item * B<include_filename_pattern> => I<re_from_str>"
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "Only include filenames that match a regex pattern."
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 "=item * B<num_ranks> => I<uint>"
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "Number of ranks to return."
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "Difference between C<num_results> and C<num_ranks>: C<num_results> (C<-n> option)"
NSQ_SOURCE_LINE 00001129 "specifies number of results regardless of ranks while C<num_ranks> (C<-N> option)"
NSQ_SOURCE_LINE 00001130 "returns number of ranks. For example, if sorting is by reverse size and if"
NSQ_SOURCE_LINE 00001131 "C<num_results> is set to 1 and there are 2 files with the same largest size then"
NSQ_SOURCE_LINE 00001132 "only 1 of those files will be returned. With C<num_ranks> set to 1, both files"
NSQ_SOURCE_LINE 00001133 "will be returned because are they both rank #1."
NSQ_SOURCE_LINE 00001134 ""
NSQ_SOURCE_LINE 00001135 "=item * B<num_results> => I<uint>"
NSQ_SOURCE_LINE 00001136 ""
NSQ_SOURCE_LINE 00001137 "Number of results to return."
NSQ_SOURCE_LINE 00001138 ""
NSQ_SOURCE_LINE 00001139 "=item * B<recursive> => I<true>"
NSQ_SOURCE_LINE 00001140 ""
NSQ_SOURCE_LINE 00001141 "Recurse into subdirectories."
