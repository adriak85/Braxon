NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "# newest"
NSQ_SOURCE_LINE 00000517 "gen_modified_sub("
NSQ_SOURCE_LINE 00000518 "    die => 1,"
NSQ_SOURCE_LINE 00000519 "    output_name => 'newest',"
NSQ_SOURCE_LINE 00000520 "    base_name => 'sort_files',"
NSQ_SOURCE_LINE 00000521 "    remove_args => [keys %argspecs_sort],"
NSQ_SOURCE_LINE 00000522 "    summary => 'Return the newest file(s) in one or more directories',"
NSQ_SOURCE_LINE 00000523 "    description => <<'MARKDOWN',"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "Notes:"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "- by default dotfiles are not included, use `--all` (`-a`) to include them"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "Suppose a new file is downloaded in `~/Downloads`, but you are not sure of its"
NSQ_SOURCE_LINE 00000530 "name. You just want to move that file, which you are pretty sure is the newest"
NSQ_SOURCE_LINE 00000531 "in the `Downloads` directory, somewhere else. So from the CLI in `~/Downloads`:"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "    % mv `newest -f` /somewhere/else"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "or, from `/somewhere/else`:"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "    % mv `newest -f ~/Downloads` ."
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "If you want to see the filename on stderr as well:"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "    % mv `newest --verbose -f ~/Downloads` ."
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "File is deemed as newest by its mtime."
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "Some examples:"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "    # return newest file in current directory"
NSQ_SOURCE_LINE 00000548 "    % newest -f"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "    # return newest file(s) in /some/dir (if there are multiple files with the"
NSQ_SOURCE_LINE 00000551 "    # same newest mtime) they will all be returned"
NSQ_SOURCE_LINE 00000552 "    % newest -N1 -f /some/dir"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "MARKDOWN"
NSQ_SOURCE_LINE 00000555 "    output_code => sub {"
NSQ_SOURCE_LINE 00000556 "        my %args = @_;"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "        unless (defined $args{num_results} || defined $args{num_ranks}) {"
NSQ_SOURCE_LINE 00000559 "            $args{num_results} = 1;"
NSQ_SOURCE_LINE 00000560 "        }"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "        sort_files("
NSQ_SOURCE_LINE 00000563 "            %args,"
NSQ_SOURCE_LINE 00000564 "            by_field => 'mtime',"
NSQ_SOURCE_LINE 00000565 "            reverse => 1,"
NSQ_SOURCE_LINE 00000566 "        );"
NSQ_SOURCE_LINE 00000567 "    },"
NSQ_SOURCE_LINE 00000568 ");"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "# oldest"
NSQ_SOURCE_LINE 00000571 "gen_modified_sub("
NSQ_SOURCE_LINE 00000572 "    die => 1,"
NSQ_SOURCE_LINE 00000573 "    output_name => 'oldest',"
NSQ_SOURCE_LINE 00000574 "    base_name => 'sort_files',"
NSQ_SOURCE_LINE 00000575 "    remove_args => [keys %argspecs_sort],"
NSQ_SOURCE_LINE 00000576 "    summary => 'Return the oldest file(s) in one or more directories',"
NSQ_SOURCE_LINE 00000577 "    description => <<'MARKDOWN',"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "Notes:"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "- by default dotfiles are not included, use `--all` (`-a`) to include them"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "File is deemed as oldest by its mtime."
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "Some examples:"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "    # return oldest file in current directory"
NSQ_SOURCE_LINE 00000588 "    % oldest -f"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "    # return oldest file(s) in /some/dir (if there are multiple files with the"
NSQ_SOURCE_LINE 00000591 "    # same oldest mtime) they will all be returned"
NSQ_SOURCE_LINE 00000592 "    % oldest -N1 -f /some/dir"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "MARKDOWN"
NSQ_SOURCE_LINE 00000595 "    output_code => sub {"
NSQ_SOURCE_LINE 00000596 "        my %args = @_;"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "        unless (defined $args{num_results} || defined $args{num_ranks}) {"
NSQ_SOURCE_LINE 00000599 "            $args{num_results} = 1;"
NSQ_SOURCE_LINE 00000600 "        }"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "        sort_files("
NSQ_SOURCE_LINE 00000603 "            %args,"
NSQ_SOURCE_LINE 00000604 "            by_field => 'mtime',"
NSQ_SOURCE_LINE 00000605 "        );"
NSQ_SOURCE_LINE 00000606 "    },"
NSQ_SOURCE_LINE 00000607 ");"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "# longest_name"
NSQ_SOURCE_LINE 00000610 "gen_modified_sub("
NSQ_SOURCE_LINE 00000611 "    die => 1,"
NSQ_SOURCE_LINE 00000612 "    output_name => 'longest_name',"
NSQ_SOURCE_LINE 00000613 "    base_name => 'sort_files',"
NSQ_SOURCE_LINE 00000614 "    remove_args => [keys %argspecs_sort],"
NSQ_SOURCE_LINE 00000615 "    summary => 'Return file(s) with the longest name in one or more directories',"
NSQ_SOURCE_LINE 00000616 "    description => <<'MARKDOWN',"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "Notes:"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "- by default dotfiles are not included, use `--all` (`-a`) to include them"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "Some examples:"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "    # return file with the longest name in current directory"
NSQ_SOURCE_LINE 00000625 "    % longest-name -f"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "    # return file(s) with the longest name in /some/dir. if there are multiple"
NSQ_SOURCE_LINE 00000628 "    # files with the same length, they will all be returned."
NSQ_SOURCE_LINE 00000629 "    % longest-name -N1 -f /some/dir"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "MARKDOWN"
NSQ_SOURCE_LINE 00000632 "    output_code => sub {"
NSQ_SOURCE_LINE 00000633 "        my %args = @_;"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "        unless (defined $args{num_results} || defined $args{num_ranks}) {"
NSQ_SOURCE_LINE 00000636 "            $args{num_results} = 1;"
NSQ_SOURCE_LINE 00000637 "        }"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "        sort_files("
NSQ_SOURCE_LINE 00000640 "            %args,"
NSQ_SOURCE_LINE 00000641 "            by_code => sub { length($_[1]{name}) <=> length($_[0]{name}) },"
NSQ_SOURCE_LINE 00000642 "        );"
NSQ_SOURCE_LINE 00000643 "    },"
NSQ_SOURCE_LINE 00000644 ");"
NSQ_SOURCE_LINE 00000645 ""
