NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "MARKDOWN"
NSQ_SOURCE_LINE 00000468 "    output_code => sub {"
NSQ_SOURCE_LINE 00000469 "        my %args = @_;"
