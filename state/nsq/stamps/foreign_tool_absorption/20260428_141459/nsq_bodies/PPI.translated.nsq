BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package PPI;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "# See POD at end for documentation"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use 5.006;"
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "# Set the version for CPAN"
NSQ_SOURCE_LINE 00000009 "our $VERSION = '1.291';"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our ( $XS_COMPATIBLE, @XS_EXCLUDE ) = ( '0.845' );"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "# Load everything"
NSQ_SOURCE_LINE 00000014 "use PPI::Util                 ();"
NSQ_SOURCE_LINE 00000015 "use PPI::Exception            ();"
NSQ_SOURCE_LINE 00000016 "use PPI::Element              ();"
NSQ_SOURCE_LINE 00000017 "use PPI::Token                ();"
NSQ_SOURCE_LINE 00000018 "use PPI::Statement            ();"
NSQ_SOURCE_LINE 00000019 "use PPI::Structure            ();"
NSQ_SOURCE_LINE 00000020 "use PPI::Document             ();"
NSQ_SOURCE_LINE 00000021 "use PPI::Document::File       ();"
NSQ_SOURCE_LINE 00000022 "use PPI::Document::Fragment   ();"
NSQ_SOURCE_LINE 00000023 "use PPI::Document::Normalized ();"
NSQ_SOURCE_LINE 00000024 "use PPI::Normal               ();"
NSQ_SOURCE_LINE 00000025 "use PPI::Tokenizer            ();"
NSQ_SOURCE_LINE 00000026 "use PPI::Lexer                ();"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "# If it is installed, load in PPI::XS"
NSQ_SOURCE_LINE 00000029 "die"
NSQ_SOURCE_LINE 00000030 "  if !$PPI::XS_DISABLE"
NSQ_SOURCE_LINE 00000031 "  and !eval { require PPI::XS; 1 }"
NSQ_SOURCE_LINE 00000032 "  and $@ !~ /^Can't locate .*? at /;    # ignore failure to load if not installed"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "1;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "__END__"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "=pod"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "=head1 NAME"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "PPI - Parse, Analyze and Manipulate Perl (without perl)"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "  use PPI;"
NSQ_SOURCE_LINE 00000047 "  "
NSQ_SOURCE_LINE 00000048 "  # Create a new empty document"
NSQ_SOURCE_LINE 00000049 "  my $Document = PPI::Document->new;"
NSQ_SOURCE_LINE 00000050 "  "
NSQ_SOURCE_LINE 00000051 "  # Create a document from source"
NSQ_SOURCE_LINE 00000052 "  $Document = PPI::Document->new(\\'print \"Hello World!\\n\"');"
NSQ_SOURCE_LINE 00000053 "  "
NSQ_SOURCE_LINE 00000054 "  # Load a Document from a file"
NSQ_SOURCE_LINE 00000055 "  $Document = PPI::Document->new('Module.pm');"
NSQ_SOURCE_LINE 00000056 "  "
NSQ_SOURCE_LINE 00000057 "  # Does it contain any POD?"
NSQ_SOURCE_LINE 00000058 "  if ( $Document->find_any('PPI::Token::Pod') ) {"
NSQ_SOURCE_LINE 00000059 "      print \"Module contains POD\\n\";"
NSQ_SOURCE_LINE 00000060 "  }"
NSQ_SOURCE_LINE 00000061 "  "
NSQ_SOURCE_LINE 00000062 "  # Get the name of the main package"
NSQ_SOURCE_LINE 00000063 "  $pkg = $Document->find_first('PPI::Statement::Package')->namespace;"
NSQ_SOURCE_LINE 00000064 "  "
NSQ_SOURCE_LINE 00000065 "  # Remove all that nasty documentation"
NSQ_SOURCE_LINE 00000066 "  $Document->prune('PPI::Token::Pod');"
NSQ_SOURCE_LINE 00000067 "  $Document->prune('PPI::Token::Comment');"
NSQ_SOURCE_LINE 00000068 "  "
NSQ_SOURCE_LINE 00000069 "  # Save the file"
NSQ_SOURCE_LINE 00000070 "  $Document->save('Module.pm.stripped');"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=head2 About this Document"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "This is the PPI manual. It describes its reason for existing, its general"
NSQ_SOURCE_LINE 00000077 "structure, its use, an overview of the API, and provides a few"
NSQ_SOURCE_LINE 00000078 "implementation samples."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head2 Background"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "The ability to read, and manipulate Perl (the language) programmatically"
NSQ_SOURCE_LINE 00000083 "other than with perl (the application) was one that caused difficulty"
NSQ_SOURCE_LINE 00000084 "for a long time."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "The cause of this problem was Perl's complex and dynamic grammar."
NSQ_SOURCE_LINE 00000087 "Although there is typically not a huge diversity in the grammar of most"
NSQ_SOURCE_LINE 00000088 "Perl code, certain issues cause large problems when it comes to parsing."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "Indeed, quite early in Perl's history Tom Christiansen introduced the Perl"
NSQ_SOURCE_LINE 00000091 "community to the quote I<\"Nothing but perl can parse Perl\">, or as it is"
NSQ_SOURCE_LINE 00000092 "more often stated now as a truism:"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "B<\"Only perl can parse Perl\">"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "One example of the sorts of things that prevent Perl from being easily parsed"
NSQ_SOURCE_LINE 00000097 "is function signatures, as demonstrated by the following."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "  @result = (dothis $foo, $bar);"
NSQ_SOURCE_LINE 00000100 "  "
NSQ_SOURCE_LINE 00000101 "  # Which of the following is it equivalent to?"
NSQ_SOURCE_LINE 00000102 "  @result = (dothis($foo), $bar);"
NSQ_SOURCE_LINE 00000103 "  @result = dothis($foo, $bar);"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "The first line above can be interpreted in two different ways, depending"
NSQ_SOURCE_LINE 00000106 "on whether the C<&dothis> function is expecting one argument, or two,"
NSQ_SOURCE_LINE 00000107 "or several."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "A \"code parser\" (something that parses for the purpose of execution) such"
NSQ_SOURCE_LINE 00000110 "as perl needs information that is not found in the immediate vicinity of"
NSQ_SOURCE_LINE 00000111 "the statement being parsed."
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "The information might not just be elsewhere in the file, it might not even be"
NSQ_SOURCE_LINE 00000114 "in the same file at all. It might also not be able to determine this"
NSQ_SOURCE_LINE 00000115 "information without the prior execution of a C<BEGIN {}> block, or the"
NSQ_SOURCE_LINE 00000116 "loading and execution of one or more external modules. Or worse the C<&dothis>"
NSQ_SOURCE_LINE 00000117 "function may not even have been written yet."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "B<When parsing Perl as code, you must also execute it.>"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "Even perl itself never really fully understands the structure of the source"
NSQ_SOURCE_LINE 00000122 "code after and indeed B<as> it processes it, and in that sense doesn't"
NSQ_SOURCE_LINE 00000123 "\"parse\" Perl source into anything remotely like a structured document."
NSQ_SOURCE_LINE 00000124 "This makes it of no real use for any task that needs to treat the source"
NSQ_SOURCE_LINE 00000125 "code as a document, and do so reliably and robustly."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "For more information on why it is impossible to parse perl, see Randal"
NSQ_SOURCE_LINE 00000128 "Schwartz's seminal response to the question of \"Why can't you parse Perl\"."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "L<http://www.perlmonks.org/index.pl?node_id=44722>"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "The purpose of PPI is B<not> to parse Perl I<Code>, but to parse Perl"
NSQ_SOURCE_LINE 00000133 "I<Documents>. By treating the problem this way, we are able to parse a"
NSQ_SOURCE_LINE 00000134 "single file containing Perl source code \"isolated\" from any other"
NSQ_SOURCE_LINE 00000135 "resources, such as libraries upon which the code may depend, and"
NSQ_SOURCE_LINE 00000136 "without needing to run an instance of perl alongside or inside the parser."
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "Historically, using an embedded perl parser was widely considered to be"
NSQ_SOURCE_LINE 00000139 "the most likely avenue for finding a solution to parsing Perl. It has been"
NSQ_SOURCE_LINE 00000140 "investigated from time to time, but attempts have generally failed or"
NSQ_SOURCE_LINE 00000141 "suffered from sufficiently bad corner cases that they were abandoned."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=head2 What Does PPI Stand For?"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "C<PPI> is an acronym for the longer original module name"
NSQ_SOURCE_LINE 00000146 "C<Parse::Perl::Isolated>. And in the spirit of the silly acronym games"
NSQ_SOURCE_LINE 00000147 "played by certain unnamed Open Source projects you may have I<hurd> of,"
NSQ_SOURCE_LINE 00000148 "it is also a reverse backronym of \"I Parse Perl\"."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Of course, I could just be lying and have just made that second bit up"
NSQ_SOURCE_LINE 00000151 "10 minutes before the release of PPI 1.000. Besides, B<all> the cool"
NSQ_SOURCE_LINE 00000152 "Perl packages have TLAs (Three Letter Acronyms). It's a rule or something."
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "Why don't you just think of it as the B<Perl Parsing Interface> for simplicity."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "The original name was shortened to prevent the author (and you the users)"
NSQ_SOURCE_LINE 00000157 "from contracting RSI by having to type crazy things like"
NSQ_SOURCE_LINE 00000158 "C<Parse::Perl::Isolated::Token::QuoteLike::Backtick> 100 times a day."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "In acknowledgment that someone may some day come up with a valid solution"
NSQ_SOURCE_LINE 00000161 "for the grammar problem it was decided at the commencement of the project"
NSQ_SOURCE_LINE 00000162 "to leave the C<Parse::Perl> namespace free for any such effort."
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "Since that time I've been able to prove to my own satisfaction that it"
NSQ_SOURCE_LINE 00000165 "B<is> truly impossible to accurately parse Perl as both code and document"
NSQ_SOURCE_LINE 00000166 "at once. For the academics, parsing Perl suffers from the \"Halting Problem\"."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=head2 Why Parse Perl?"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "Once you can accept that we will never be able to parse Perl well enough"
NSQ_SOURCE_LINE 00000171 "to meet the standards of things that treat Perl as code, it is worth"
NSQ_SOURCE_LINE 00000172 "re-examining I<why> we want to \"parse\" Perl at all."
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "What are the things that people might want a \"Perl parser\" for?"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "=over 4"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=item Documentation"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "Analyzing the contents of a Perl document to automatically generate"
NSQ_SOURCE_LINE 00000181 "documentation, in parallel to, or as a replacement for, POD documentation."
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "Allow an indexer to locate and process all the comments and"
NSQ_SOURCE_LINE 00000184 "documentation from code for \"full text search\" applications."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=item Structural and Quality Analysis"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "Determine quality or other metrics across a body of code, and identify"
NSQ_SOURCE_LINE 00000189 "situations relating to particular phrases, techniques or locations."
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "Index functions, variables and packages within Perl code, and doing search"
NSQ_SOURCE_LINE 00000192 "and graph (in the node/edge sense) analysis of large code bases."
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "L<Perl::Critic>, based on PPI, is a large, thriving tool for bug detection"
NSQ_SOURCE_LINE 00000195 "and style analysis of Perl code."
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "=item Refactoring"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "Make structural, syntax, or other changes to code in an automated manner,"
NSQ_SOURCE_LINE 00000200 "either independently or in assistance to an editor. This sort of task list"
NSQ_SOURCE_LINE 00000201 "includes backporting, forward porting, partial evaluation, \"improving\" code,"
NSQ_SOURCE_LINE 00000202 "or whatever. All the sort of things you'd want from a L<Perl::Editor>."
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=item Layout"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "Change the layout of code without changing its meaning. This includes"
NSQ_SOURCE_LINE 00000207 "techniques such as tidying (like L<perltidy>), obfuscation, compressing and"
NSQ_SOURCE_LINE 00000208 "\"squishing\", or to implement formatting preferences or policies."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=item Presentation"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "This includes methods of improving the presentation of code, without changing"
NSQ_SOURCE_LINE 00000213 "the content of the code. Modify, improve, syntax colour etc the presentation"
NSQ_SOURCE_LINE 00000214 "of a Perl document. Generating \"IntelliText\"-like functions."
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=back"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "If we treat this as a baseline for the sort of things we are going to have"
NSQ_SOURCE_LINE 00000219 "to build on top of Perl, then it becomes possible to identify a standard"
NSQ_SOURCE_LINE 00000220 "for how good a Perl parser needs to be."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head2 How good is Good Enough(TM)"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "PPI seeks to be good enough to achieve all of the above tasks, or to provide"
NSQ_SOURCE_LINE 00000225 "a sufficiently good API on which to allow others to implement modules in"
NSQ_SOURCE_LINE 00000226 "these and related areas."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "However, there are going to be limits to this process. Because PPI cannot"
NSQ_SOURCE_LINE 00000229 "adapt to changing grammars, any code written using source filters should not"
NSQ_SOURCE_LINE 00000230 "be assumed to be parsable."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "At one extreme, this includes anything munged by L<Acme::Bleach>, as well"
NSQ_SOURCE_LINE 00000233 "as (arguably) more common cases like L<Switch>. We do not pretend to be"
NSQ_SOURCE_LINE 00000234 "able to always parse code using these modules, although as long as it still"
NSQ_SOURCE_LINE 00000235 "follows a format that looks like Perl syntax, it may be possible to extend"
NSQ_SOURCE_LINE 00000236 "the lexer to handle them."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "The ability to extend PPI to handle lexical additions to the language is on"
NSQ_SOURCE_LINE 00000239 "the drawing board to be done some time post-1.0"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "The goal for success was originally to be able to successfully parse 99% of"
NSQ_SOURCE_LINE 00000242 "all Perl documents contained in CPAN. This means the entire file in each"
NSQ_SOURCE_LINE 00000243 "case."
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "PPI has succeeded in this goal far beyond the expectations of even the"
NSQ_SOURCE_LINE 00000246 "author. At time of writing there are only 28 non-Acme Perl modules in CPAN"
NSQ_SOURCE_LINE 00000247 "that PPI is incapable of parsing. Most of these are so badly broken they"
NSQ_SOURCE_LINE 00000248 "do not compile as Perl code anyway."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "So unless you are actively going out of your way to break PPI, you should"
NSQ_SOURCE_LINE 00000251 "expect that it will handle your code just fine."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=head2 Internationalisation"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "PPI provides partial support for internationalisation and localisation."
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "Specifically, it allows the use of characters from the Latin-1 character"
NSQ_SOURCE_LINE 00000258 "set to be used in quotes, comments, and POD. Primarily, this covers"
NSQ_SOURCE_LINE 00000259 "languages from Europe and South America."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "PPI does B<not> currently provide support for Unicode."
NSQ_SOURCE_LINE 00000262 "If you need Unicode support and would like to help,"
NSQ_SOURCE_LINE 00000263 "contact the author. (contact details below)"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=head2 Round Trip Safe"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "When PPI parses a file it builds B<everything> into the model, including"
NSQ_SOURCE_LINE 00000268 "whitespace. This is needed in order to make the Document fully \"Round Trip\""
NSQ_SOURCE_LINE 00000269 "safe."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "The general concept behind a \"Round Trip\" parser is that it knows what it"
NSQ_SOURCE_LINE 00000272 "is parsing is somewhat uncertain, and so B<expects> to get things wrong"
NSQ_SOURCE_LINE 00000273 "from time to time. In the cases where it parses code wrongly the tree"
NSQ_SOURCE_LINE 00000274 "will serialize back out to the same string of code that was read in,"
NSQ_SOURCE_LINE 00000275 "repairing the parser's mistake as it heads back out to the file."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "The end result is that if you parse in a file and serialize it back out"
NSQ_SOURCE_LINE 00000278 "without changing the tree, you are guaranteed to get the same file you"
NSQ_SOURCE_LINE 00000279 "started with. PPI does this correctly and reliably for 100% of all known"
NSQ_SOURCE_LINE 00000280 "cases."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "B<What goes in, will come out. Every time.>"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "The one minor exception at this time is that if the newlines for your file"
NSQ_SOURCE_LINE 00000285 "are wrong (meaning not matching the platform newline format), PPI will"
NSQ_SOURCE_LINE 00000286 "localise them for you. (It isn't to be convenient, supporting"
NSQ_SOURCE_LINE 00000287 "arbitrary newlines would make some of the code more complicated)"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "Better control of the newline type is on the wish list though, and"
NSQ_SOURCE_LINE 00000290 "anyone wanting to help out is encouraged to contact the author."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=head1 IMPLEMENTATION"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=head2 General Layout"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "PPI is built upon two primary \"parsing\" components, L<PPI::Tokenizer>"
NSQ_SOURCE_LINE 00000297 "and L<PPI::Lexer>, and a large tree of about 70 classes which implement"
NSQ_SOURCE_LINE 00000298 "the various the I<Perl Document Object Model> (PDOM)."
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "The PDOM is conceptually similar in style and intent to the regular DOM or"
NSQ_SOURCE_LINE 00000301 "other code Abstract Syntax Trees (ASTs), but contains some differences"
NSQ_SOURCE_LINE 00000302 "to handle perl-specific cases, and to assist in treating the code as a"
NSQ_SOURCE_LINE 00000303 "document. Please note that it is B<not> an implementation of the official"
NSQ_SOURCE_LINE 00000304 "Document Object Model specification, only somewhat similar to it."
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "On top of the Tokenizer, Lexer and the classes of the PDOM, sit a number"
NSQ_SOURCE_LINE 00000307 "of classes intended to make life a little easier when dealing with PDOM"
NSQ_SOURCE_LINE 00000308 "trees."
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "Both the major parsing components were hand-coded from scratch with only"
NSQ_SOURCE_LINE 00000311 "plain Perl code and a few small utility modules. There are no grammar or"
NSQ_SOURCE_LINE 00000312 "patterns mini-languages, no YACC or LEX style tools and only a small number"
NSQ_SOURCE_LINE 00000313 "of regular expressions."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "This is primarily because of the sheer volume of accumulated cruft that"
NSQ_SOURCE_LINE 00000316 "exists in Perl. Not even perl itself is capable of parsing Perl documents"
NSQ_SOURCE_LINE 00000317 "(remember, it just parses and executes it as code)."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "As a result, PPI needed to be cruftier than perl itself. Feel free to"
NSQ_SOURCE_LINE 00000320 "shudder at this point, and hope you never have to understand the Tokenizer"
NSQ_SOURCE_LINE 00000321 "codebase. Speaking of which..."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=head2 The Tokenizer"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "The Tokenizer takes source code and converts it into a series of tokens. It"
NSQ_SOURCE_LINE 00000326 "does this using a slow but thorough character by character manual process,"
NSQ_SOURCE_LINE 00000327 "rather than using a pattern system or complex regexes."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "Or at least it does so conceptually. If you were to actually trace the code"
NSQ_SOURCE_LINE 00000330 "you would find it's not truly character by character due to a number of"
NSQ_SOURCE_LINE 00000331 "regexps and optimisations throughout the code. This lets the Tokenizer"
NSQ_SOURCE_LINE 00000332 "\"skip ahead\" when it can find shortcuts, so it tends to jump around a line"
NSQ_SOURCE_LINE 00000333 "a bit wildly at times."
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "In practice, the number of times the Tokenizer will B<actually> move the"
NSQ_SOURCE_LINE 00000336 "character cursor itself is only about 5% - 10% higher than the number of"
NSQ_SOURCE_LINE 00000337 "tokens contained in the file. This makes it about as optimal as it can be"
NSQ_SOURCE_LINE 00000338 "made without implementing it in something other than Perl."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "In 2001 when PPI was started, this structure made PPI quite slow, and not"
NSQ_SOURCE_LINE 00000341 "really suitable for interactive tasks. This situation has improved greatly"
NSQ_SOURCE_LINE 00000342 "with multi-gigahertz processors, but can still be painful when working with"
NSQ_SOURCE_LINE 00000343 "very large files."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "The target parsing rate for PPI is about 5000 lines per gigacycle. It is"
NSQ_SOURCE_LINE 00000346 "currently believed to be at about 1500, and the main avenue for making it to"
NSQ_SOURCE_LINE 00000347 "the target speed has now become L<PPI::XS>, a drop-in XS accelerator for"
NSQ_SOURCE_LINE 00000348 "PPI."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "Since L<PPI::XS> has only just gotten off the ground and is currently only"
NSQ_SOURCE_LINE 00000351 "at proof-of-concept stage, this may take a little while. Anyone interested"
NSQ_SOURCE_LINE 00000352 "in helping out with L<PPI::XS> is B<highly> encouraged to contact the"
NSQ_SOURCE_LINE 00000353 "author. In fact, the design of L<PPI::XS> means it's possible to port"
NSQ_SOURCE_LINE 00000354 "one function at a time safely and reliably. So every little bit will help."
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "=head2 The Lexer"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "The Lexer takes a token stream, and converts it to a lexical tree. Because"
NSQ_SOURCE_LINE 00000359 "we are parsing Perl B<documents> this includes whitespace, comments, and"
NSQ_SOURCE_LINE 00000360 "all number of weird things that have no relevance when code is actually"
NSQ_SOURCE_LINE 00000361 "executed."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "An instantiated L<PPI::Lexer> consumes L<PPI::Tokenizer> objects and"
NSQ_SOURCE_LINE 00000364 "produces L<PPI::Document> objects. However you should probably never be"
NSQ_SOURCE_LINE 00000365 "working with the Lexer directly. You should just be able to create"
NSQ_SOURCE_LINE 00000366 "L<PPI::Document> objects and work with them directly."
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "=head2 The Perl Document Object Model"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "The PDOM is a structured collection of data classes that together provide"
NSQ_SOURCE_LINE 00000371 "a correct and scalable model for documents that follow the standard Perl"
NSQ_SOURCE_LINE 00000372 "syntax."
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=head2 The PDOM Class Tree"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "The following lists all of the 72 current PDOM classes, listing with indentation"
NSQ_SOURCE_LINE 00000377 "based on inheritance."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "   PPI::Element"
NSQ_SOURCE_LINE 00000380 "      PPI::Node"
NSQ_SOURCE_LINE 00000381 "         PPI::Document"
NSQ_SOURCE_LINE 00000382 "            PPI::Document::Fragment"
NSQ_SOURCE_LINE 00000383 "         PPI::Statement"
NSQ_SOURCE_LINE 00000384 "            PPI::Statement::Package"
NSQ_SOURCE_LINE 00000385 "            PPI::Statement::Include"
NSQ_SOURCE_LINE 00000386 "            PPI::Statement::Sub"
NSQ_SOURCE_LINE 00000387 "               PPI::Statement::Scheduled"
NSQ_SOURCE_LINE 00000388 "            PPI::Statement::Compound"
NSQ_SOURCE_LINE 00000389 "            PPI::Statement::Break"
NSQ_SOURCE_LINE 00000390 "            PPI::Statement::Given"
NSQ_SOURCE_LINE 00000391 "            PPI::Statement::When"
NSQ_SOURCE_LINE 00000392 "            PPI::Statement::Data"
NSQ_SOURCE_LINE 00000393 "            PPI::Statement::End"
NSQ_SOURCE_LINE 00000394 "            PPI::Statement::Expression"
NSQ_SOURCE_LINE 00000395 "               PPI::Statement::Variable"
NSQ_SOURCE_LINE 00000396 "            PPI::Statement::Null"
NSQ_SOURCE_LINE 00000397 "            PPI::Statement::UnmatchedBrace"
NSQ_SOURCE_LINE 00000398 "            PPI::Statement::Unknown"
NSQ_SOURCE_LINE 00000399 "         PPI::Structure"
NSQ_SOURCE_LINE 00000400 "            PPI::Structure::Block"
NSQ_SOURCE_LINE 00000401 "            PPI::Structure::Subscript"
NSQ_SOURCE_LINE 00000402 "            PPI::Structure::Constructor"
NSQ_SOURCE_LINE 00000403 "            PPI::Structure::Condition"
NSQ_SOURCE_LINE 00000404 "            PPI::Structure::List"
NSQ_SOURCE_LINE 00000405 "            PPI::Structure::For"
NSQ_SOURCE_LINE 00000406 "            PPI::Structure::Given"
NSQ_SOURCE_LINE 00000407 "            PPI::Structure::When"
NSQ_SOURCE_LINE 00000408 "            PPI::Structure::Unknown"
NSQ_SOURCE_LINE 00000409 "      PPI::Token"
NSQ_SOURCE_LINE 00000410 "         PPI::Token::Whitespace"
NSQ_SOURCE_LINE 00000411 "         PPI::Token::Comment"
NSQ_SOURCE_LINE 00000412 "         PPI::Token::Pod"
NSQ_SOURCE_LINE 00000413 "         PPI::Token::Number"
NSQ_SOURCE_LINE 00000414 "            PPI::Token::Number::Binary"
NSQ_SOURCE_LINE 00000415 "            PPI::Token::Number::Octal"
NSQ_SOURCE_LINE 00000416 "            PPI::Token::Number::Hex"
NSQ_SOURCE_LINE 00000417 "            PPI::Token::Number::Float"
NSQ_SOURCE_LINE 00000418 "               PPI::Token::Number::Exp"
NSQ_SOURCE_LINE 00000419 "            PPI::Token::Number::Version"
NSQ_SOURCE_LINE 00000420 "         PPI::Token::Word"
NSQ_SOURCE_LINE 00000421 "         PPI::Token::DashedWord"
NSQ_SOURCE_LINE 00000422 "         PPI::Token::Symbol"
NSQ_SOURCE_LINE 00000423 "            PPI::Token::Magic"
NSQ_SOURCE_LINE 00000424 "         PPI::Token::ArrayIndex"
NSQ_SOURCE_LINE 00000425 "         PPI::Token::Operator"
NSQ_SOURCE_LINE 00000426 "         PPI::Token::Quote"
NSQ_SOURCE_LINE 00000427 "            PPI::Token::Quote::Single"
NSQ_SOURCE_LINE 00000428 "            PPI::Token::Quote::Double"
NSQ_SOURCE_LINE 00000429 "            PPI::Token::Quote::Literal"
NSQ_SOURCE_LINE 00000430 "            PPI::Token::Quote::Interpolate"
NSQ_SOURCE_LINE 00000431 "         PPI::Token::QuoteLike"
NSQ_SOURCE_LINE 00000432 "            PPI::Token::QuoteLike::Backtick"
NSQ_SOURCE_LINE 00000433 "            PPI::Token::QuoteLike::Command"
NSQ_SOURCE_LINE 00000434 "            PPI::Token::QuoteLike::Regexp"
NSQ_SOURCE_LINE 00000435 "            PPI::Token::QuoteLike::Words"
NSQ_SOURCE_LINE 00000436 "            PPI::Token::QuoteLike::Readline"
NSQ_SOURCE_LINE 00000437 "         PPI::Token::Regexp"
NSQ_SOURCE_LINE 00000438 "            PPI::Token::Regexp::Match"
NSQ_SOURCE_LINE 00000439 "            PPI::Token::Regexp::Substitute"
NSQ_SOURCE_LINE 00000440 "            PPI::Token::Regexp::Transliterate"
NSQ_SOURCE_LINE 00000441 "         PPI::Token::HereDoc"
NSQ_SOURCE_LINE 00000442 "         PPI::Token::Cast"
NSQ_SOURCE_LINE 00000443 "         PPI::Token::Structure"
NSQ_SOURCE_LINE 00000444 "         PPI::Token::Label"
NSQ_SOURCE_LINE 00000445 "         PPI::Token::Separator"
NSQ_SOURCE_LINE 00000446 "         PPI::Token::Data"
NSQ_SOURCE_LINE 00000447 "         PPI::Token::End"
NSQ_SOURCE_LINE 00000448 "         PPI::Token::Prototype"
NSQ_SOURCE_LINE 00000449 "         PPI::Token::Attribute"
NSQ_SOURCE_LINE 00000450 "         PPI::Token::Unknown"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "To summarize the above layout, all PDOM objects inherit from the"
NSQ_SOURCE_LINE 00000453 "L<PPI::Element> class."
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "Under this are L<PPI::Token>, strings of content with a known type,"
NSQ_SOURCE_LINE 00000456 "and L<PPI::Node>, syntactically significant containers that hold other"
NSQ_SOURCE_LINE 00000457 "Elements."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "The three most important of these are the L<PPI::Document>, the"
NSQ_SOURCE_LINE 00000460 "L<PPI::Statement> and the L<PPI::Structure> classes."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "=head2 The Document, Statement and Structure"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "At the top of all complete PDOM trees is a L<PPI::Document> object. It"
NSQ_SOURCE_LINE 00000465 "represents a complete file of Perl source code as you might find it on"
NSQ_SOURCE_LINE 00000466 "disk."
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "There are some specialised types of document, such as L<PPI::Document::File>"
NSQ_SOURCE_LINE 00000469 "and L<PPI::Document::Normalized> but for the purposes of the PDOM they are"
NSQ_SOURCE_LINE 00000470 "all just considered to be the same thing."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "Each Document will contain a number of B<Statements>, B<Structures> and"
NSQ_SOURCE_LINE 00000473 "B<Tokens>."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "A L<PPI::Statement> is any series of Tokens and Structures that are treated"
NSQ_SOURCE_LINE 00000476 "as a single contiguous statement by perl itself. You should note that a"
NSQ_SOURCE_LINE 00000477 "Statement is as close as PPI can get to \"parsing\" the code in the sense that"
NSQ_SOURCE_LINE 00000478 "perl-itself parses Perl code when it is building the op-tree."
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "Because of the isolation and Perl's syntax, it is provably impossible for"
NSQ_SOURCE_LINE 00000481 "PPI to accurately determine precedence of operators or which tokens are"
NSQ_SOURCE_LINE 00000482 "implicit arguments to a sub call."
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "So rather than lead you on with a bad guess that has a strong chance of"
NSQ_SOURCE_LINE 00000485 "being wrong, PPI does not attempt to determine precedence or sub parameters"
NSQ_SOURCE_LINE 00000486 "at all."
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "At a fundamental level, it only knows that this series of elements"
NSQ_SOURCE_LINE 00000489 "represents a single Statement as perl sees it, but it can do so with"
NSQ_SOURCE_LINE 00000490 "enough certainty that it can be trusted."
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "However, for specific Statement types the PDOM is able to derive additional"
NSQ_SOURCE_LINE 00000493 "useful information about their meaning. For the best, most useful, and most"
NSQ_SOURCE_LINE 00000494 "heavily used example, see L<PPI::Statement::Include>."
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "A L<PPI::Structure> is any series of tokens contained within matching braces."
NSQ_SOURCE_LINE 00000497 "This includes code blocks, conditions, function argument braces, anonymous"
NSQ_SOURCE_LINE 00000498 "array and hash constructors, lists, scoping braces and all other syntactic"
NSQ_SOURCE_LINE 00000499 "structures represented by a matching pair of braces, including (although it"
NSQ_SOURCE_LINE 00000500 "may not seem obvious at first) C<E<lt>READLINEE<gt>> braces."
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "Each Structure contains none, one, or many Tokens and Structures (the rules"
NSQ_SOURCE_LINE 00000503 "for which vary for the different Structure subclasses)"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "Under the PDOM structure rules, a Statement can B<never> directly contain"
NSQ_SOURCE_LINE 00000506 "another child Statement, a Structure can B<never> directly contain another"
NSQ_SOURCE_LINE 00000507 "child Structure, and a Document can B<never> contain another Document"
NSQ_SOURCE_LINE 00000508 "anywhere in the tree."
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "Aside from these three rules, the PDOM tree is extremely flexible."
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "=head2 The PDOM at Work"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "To demonstrate the PDOM in use lets start with an example showing how the"
NSQ_SOURCE_LINE 00000515 "tree might look for the following chunk of simple Perl code."
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "  #!/usr/bin/perl"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "  print( \"Hello World!\" );"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "  exit();"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "Translated into a PDOM tree it would have the following structure (as shown"
NSQ_SOURCE_LINE 00000524 "via the included L<PPI::Dumper>)."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "  PPI::Document"
NSQ_SOURCE_LINE 00000527 "    PPI::Token::Comment                '#!/usr/bin/perl\\n'"
NSQ_SOURCE_LINE 00000528 "    PPI::Token::Whitespace             '\\n'"
NSQ_SOURCE_LINE 00000529 "    PPI::Statement"
NSQ_SOURCE_LINE 00000530 "      PPI::Token::Word                 'print'"
NSQ_SOURCE_LINE 00000531 "      PPI::Structure::List             ( ... )"
NSQ_SOURCE_LINE 00000532 "        PPI::Token::Whitespace         ' '"
NSQ_SOURCE_LINE 00000533 "        PPI::Statement::Expression"
NSQ_SOURCE_LINE 00000534 "          PPI::Token::Quote::Double    '\"Hello World!\"'"
NSQ_SOURCE_LINE 00000535 "        PPI::Token::Whitespace         ' '"
NSQ_SOURCE_LINE 00000536 "      PPI::Token::Structure            ';'"
NSQ_SOURCE_LINE 00000537 "    PPI::Token::Whitespace             '\\n'"
NSQ_SOURCE_LINE 00000538 "    PPI::Token::Whitespace             '\\n'"
NSQ_SOURCE_LINE 00000539 "    PPI::Statement"
NSQ_SOURCE_LINE 00000540 "      PPI::Token::Word                 'exit'"
NSQ_SOURCE_LINE 00000541 "      PPI::Structure::List             ( ... )"
NSQ_SOURCE_LINE 00000542 "      PPI::Token::Structure            ';'"
NSQ_SOURCE_LINE 00000543 "    PPI::Token::Whitespace             '\\n'"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "Please note that in this example, strings are only listed for the"
NSQ_SOURCE_LINE 00000546 "B<actual> L<PPI::Token> that contains that string. Structures are listed"
NSQ_SOURCE_LINE 00000547 "with the type of brace characters they represent noted."
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "The L<PPI::Dumper> module can be used to generate similar trees yourself."
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "We can make that PDOM dump a little easier to read if we strip out all the"
NSQ_SOURCE_LINE 00000552 "whitespace. Here it is again, sans the distracting whitespace tokens."
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "  PPI::Document"
NSQ_SOURCE_LINE 00000555 "    PPI::Token::Comment                '#!/usr/bin/perl\\n'"
NSQ_SOURCE_LINE 00000556 "    PPI::Statement"
NSQ_SOURCE_LINE 00000557 "      PPI::Token::Word                 'print'"
NSQ_SOURCE_LINE 00000558 "      PPI::Structure::List             ( ... )"
NSQ_SOURCE_LINE 00000559 "        PPI::Statement::Expression"
NSQ_SOURCE_LINE 00000560 "          PPI::Token::Quote::Double    '\"Hello World!\"'"
NSQ_SOURCE_LINE 00000561 "      PPI::Token::Structure            ';'"
NSQ_SOURCE_LINE 00000562 "    PPI::Statement"
NSQ_SOURCE_LINE 00000563 "      PPI::Token::Word                 'exit'"
NSQ_SOURCE_LINE 00000564 "      PPI::Structure::List             ( ... )"
NSQ_SOURCE_LINE 00000565 "      PPI::Token::Structure            ';'"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "As you can see, the tree can get fairly deep at time, especially when every"
NSQ_SOURCE_LINE 00000568 "isolated token in a bracket becomes its own statement. This is needed to"
NSQ_SOURCE_LINE 00000569 "allow anything inside the tree the ability to grow. It also makes the"
NSQ_SOURCE_LINE 00000570 "search and analysis algorithms much more flexible."
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "Because of the depth and complexity of PDOM trees, a vast number of very easy"
NSQ_SOURCE_LINE 00000573 "to use methods have been added wherever possible to help people working with"
NSQ_SOURCE_LINE 00000574 "PDOM trees do normal tasks relatively quickly and efficiently."
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "=head2 Overview of the Primary Classes"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "The main PPI classes, and links to their own documentation, are listed"
NSQ_SOURCE_LINE 00000579 "here in alphabetical order."
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "=over 4"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "=item L<PPI::Document>"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "The Document object, the root of the PDOM."
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "=item L<PPI::Document::Fragment>"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "A cohesive fragment of a larger Document. Although not of any real current"
NSQ_SOURCE_LINE 00000590 "use, it is needed for use in certain internal tree manipulation"
NSQ_SOURCE_LINE 00000591 "algorithms."
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "For example, doing things like cut/copy/paste etc. Very similar to a"
NSQ_SOURCE_LINE 00000594 "L<PPI::Document>, but has some additional methods and does not represent"
NSQ_SOURCE_LINE 00000595 "a lexical scope boundary."
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "A document fragment is also non-serializable, and so cannot be written out"
NSQ_SOURCE_LINE 00000598 "to a file."
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "=item L<PPI::Dumper>"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "A simple class for dumping readable debugging versions of PDOM structures,"
NSQ_SOURCE_LINE 00000603 "such as in the demonstration above."
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "=item L<PPI::Element>"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "The Element class is the abstract base class for all objects within the PDOM"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "=item L<PPI::Find>"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "Implements an instantiable object form of a PDOM tree search."
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "=item L<PPI::Lexer>"
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "The PPI Lexer. Converts Token streams into PDOM trees."
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "=item L<PPI::Node>"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "The Node object, the abstract base class for all PDOM objects that can"
NSQ_SOURCE_LINE 00000620 "contain other Elements, such as the Document, Statement and Structure"
NSQ_SOURCE_LINE 00000621 "objects."
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "=item L<PPI::Statement>"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "The base class for all Perl statements. Generic \"evaluate for side-effects\""
NSQ_SOURCE_LINE 00000626 "statements are of this actual type. Other more interesting statement types"
NSQ_SOURCE_LINE 00000627 "belong to one of its children."
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "See its own documentation for a longer description and list of all of the"
NSQ_SOURCE_LINE 00000630 "different statement types and sub-classes."
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "=item L<PPI::Structure>"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "The abstract base class for all structures. A Structure is a language"
NSQ_SOURCE_LINE 00000635 "construct consisting of matching braces containing a set of other elements."
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "See the L<PPI::Structure> documentation for a description and"
NSQ_SOURCE_LINE 00000638 "list of all of the different structure types and sub-classes."
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "=item L<PPI::Token>"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "A token is the basic unit of content. At its most basic, a Token is just"
NSQ_SOURCE_LINE 00000643 "a string tagged with metadata (its class, and some additional flags in"
NSQ_SOURCE_LINE 00000644 "some cases)."
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "=item L<PPI::Token::_QuoteEngine>"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "The L<PPI::Token::Quote> and L<PPI::Token::QuoteLike> classes provide"
NSQ_SOURCE_LINE 00000649 "abstract base classes for the many and varied types of quote and"
NSQ_SOURCE_LINE 00000650 "quote-like things in Perl. However, much of the actual quote logic is"
NSQ_SOURCE_LINE 00000651 "implemented in a separate quote engine, based at"
NSQ_SOURCE_LINE 00000652 "L<PPI::Token::_QuoteEngine>."
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "Classes that inherit from L<PPI::Token::Quote>, L<PPI::Token::QuoteLike>"
NSQ_SOURCE_LINE 00000655 "and L<PPI::Token::Regexp> are generally parsed only by the Quote Engine."
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "=item L<PPI::Tokenizer>"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "The PPI Tokenizer. One Tokenizer consumes a chunk of text and provides"
NSQ_SOURCE_LINE 00000660 "access to a stream of L<PPI::Token> objects."
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "The Tokenizer is very very complicated, to the point where even the author"
NSQ_SOURCE_LINE 00000663 "treads carefully when working with it."
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "Most of the complication is the result of optimizations which have tripled"
NSQ_SOURCE_LINE 00000666 "the tokenization speed, at the expense of maintainability. We cope with the"
NSQ_SOURCE_LINE 00000667 "spaghetti by heavily commenting everything."
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "=item L<PPI::Transform>"
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "The Perl Document Transformation API. Provides a standard interface and"
NSQ_SOURCE_LINE 00000672 "abstract base class for objects and classes that manipulate Documents."
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "=back"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "=head1 INSTALLING"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "The core PPI distribution is pure Perl and has been kept as tight as"
NSQ_SOURCE_LINE 00000679 "possible and with as few dependencies as possible."
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "It should download and install normally on any platform from within"
NSQ_SOURCE_LINE 00000682 "the CPAN and CPANPLUS applications, or directly using the distribution"
NSQ_SOURCE_LINE 00000683 "tarball. If installing by hand, you may need to install a few small"
NSQ_SOURCE_LINE 00000684 "utility modules first. The exact ones will depend on your version of"
NSQ_SOURCE_LINE 00000685 "perl."
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "There are no special install instructions for PPI, and the normal"
NSQ_SOURCE_LINE 00000688 "C<Perl Makefile.PL>, C<make>, C<make test>, C<make install> instructions"
NSQ_SOURCE_LINE 00000689 "apply."
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "=head1 EXTENDING"
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "The PPI namespace itself is reserved for use by PPI itself."
NSQ_SOURCE_LINE 00000694 "You are recommended to use the PPIx:: namespace for PPI-specific"
NSQ_SOURCE_LINE 00000695 "modifications or prototypes thereof, or Perl:: for modules which provide"
NSQ_SOURCE_LINE 00000696 "a general Perl language-related functions."
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "If what you wish to implement looks like it fits into the PPIx:: namespace,"
NSQ_SOURCE_LINE 00000699 "you should consider contacting the PPI maintainers on GitHub first, as what"
NSQ_SOURCE_LINE 00000700 "you want may already be in progress, or you may wish to consider contributing"
NSQ_SOURCE_LINE 00000701 "to PPI itself."
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "=head1 TO DO"
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "- Many more analysis and utility methods for PDOM classes"
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "- Creation of a PPI::Tutorial document"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "- Add many more key functions to PPI::XS"
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "- We can B<always> write more and better unit tests"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "- Complete the full implementation of -E<gt>literal (1.200)"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "- Full understanding of scoping (due 1.300)"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "The most recent version of PPI is available at the following address."
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "L<https://metacpan.org/pod/PPI>"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "PPI source is maintained in a GitHub repository at the following address."
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "L<https://github.com/Perl-Critic/PPI>"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "Contributions via GitHub pull request are welcome."
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "Bug fixes in the form of pull requests or bug reports with"
NSQ_SOURCE_LINE 00000730 "new (failing) unit tests have the best chance of being addressed"
NSQ_SOURCE_LINE 00000731 "by busy maintainers, and are B<strongly> encouraged."
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "If you cannot provide a test or fix, or don't have time to do so,"
NSQ_SOURCE_LINE 00000734 "then regular bug reports are still accepted and appreciated via the"
NSQ_SOURCE_LINE 00000735 "GitHub bug tracker."
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "L<https://github.com/Perl-Critic/PPI/issues>"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "The C<ppidump> utility that is part of the L<Perl::Critic> distribution"
NSQ_SOURCE_LINE 00000740 "is a useful tool for demonstrating how PPI is parsing (or misparsing)"
NSQ_SOURCE_LINE 00000741 "small code snippets, and for providing information for bug reports."
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "For other issues, questions, or commercial or media-related enquiries,"
NSQ_SOURCE_LINE 00000744 "contact the author."
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "Adam Kennedy E<lt>adamk@cpan.orgE<gt>"
