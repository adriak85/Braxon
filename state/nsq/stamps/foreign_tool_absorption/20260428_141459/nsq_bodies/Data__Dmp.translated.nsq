NSQ_SOURCE_LINE 00000001 "## no critic: Modules::ProhibitAutomaticExportation"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "package Data::Dmp;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000006 "our $DATE = '2022-08-28'; # DATE"
NSQ_SOURCE_LINE 00000007 "our $DIST = 'Data-Dmp'; # DIST"
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.242'; # VERSION"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use 5.010001;"
NSQ_SOURCE_LINE 00000011 "use strict;"
NSQ_SOURCE_LINE 00000012 "use warnings;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "use Scalar::Util qw(looks_like_number blessed reftype refaddr);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "require Exporter;"
NSQ_SOURCE_LINE 00000017 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000018 "our @EXPORT = qw(dd dmp);"
NSQ_SOURCE_LINE 00000019 "our @EXPORT_OK = qw(dd_ellipsis dmp_ellipsis);"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "# for when dealing with circular refs"
NSQ_SOURCE_LINE 00000022 "our %_seen_refaddrs;"
NSQ_SOURCE_LINE 00000023 "our %_subscripts;"
NSQ_SOURCE_LINE 00000024 "our @_fixups;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "our $OPT_MAX_DUMP_LEN_BEFORE_ELLIPSIS = 70;"
NSQ_SOURCE_LINE 00000027 "our $OPT_PERL_VERSION = \"5.010\";"
NSQ_SOURCE_LINE 00000028 "our $OPT_REMOVE_PRAGMAS = 0;"
NSQ_SOURCE_LINE 00000029 "our $OPT_DEPARSE = 1;"
NSQ_SOURCE_LINE 00000030 "our $OPT_STRINGIFY_NUMBERS = 0;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "# BEGIN COPY PASTE FROM Data::Dump"
NSQ_SOURCE_LINE 00000033 "my %esc = ("
NSQ_SOURCE_LINE 00000034 "    \"\\a\" => \"\\\\a\","
NSQ_SOURCE_LINE 00000035 "    \"\\b\" => \"\\\\b\","
NSQ_SOURCE_LINE 00000036 "    \"\\t\" => \"\\\\t\","
NSQ_SOURCE_LINE 00000037 "    \"\\n\" => \"\\\\n\","
NSQ_SOURCE_LINE 00000038 "    \"\\f\" => \"\\\\f\","
NSQ_SOURCE_LINE 00000039 "    \"\\r\" => \"\\\\r\","
NSQ_SOURCE_LINE 00000040 "    \"\\e\" => \"\\\\e\","
NSQ_SOURCE_LINE 00000041 ");"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "# put a string value in double quotes"
NSQ_SOURCE_LINE 00000044 "sub _double_quote {"
NSQ_SOURCE_LINE 00000045 "    local($_) = $_[0];"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    # If there are many '\"' we might want to use qq() instead"
NSQ_SOURCE_LINE 00000048 "    s/([\\\\\\\"\\@\\$])/\\\\$1/g;"
NSQ_SOURCE_LINE 00000049 "    return qq(\"$_\") unless /[^\\040-\\176]/;  # fast exit"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    s/([\\a\\b\\t\\n\\f\\r\\e])/$esc{$1}/g;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    # no need for 3 digits in escape for these"
NSQ_SOURCE_LINE 00000054 "    s/([\\0-\\037])(?!\\d)/sprintf('\\\\%o',ord($1))/eg;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    s/([\\0-\\037\\177-\\377])/sprintf('\\\\x%02X',ord($1))/eg;"
NSQ_SOURCE_LINE 00000057 "    s/([^\\040-\\176])/sprintf('\\\\x{%X}',ord($1))/eg;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    return qq(\"$_\");"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 "# END COPY PASTE FROM Data::Dump"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "# BEGIN COPY PASTE FROM String::PerlQuote"
NSQ_SOURCE_LINE 00000064 "sub _single_quote {"
NSQ_SOURCE_LINE 00000065 "    local($_) = $_[0];"
NSQ_SOURCE_LINE 00000066 "    s/([\\\\'])/\\\\$1/g;"
NSQ_SOURCE_LINE 00000067 "    return qq('$_');"
NSQ_SOURCE_LINE 00000068 "}"
NSQ_SOURCE_LINE 00000069 "# END COPY PASTE FROM String::PerlQuote"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "sub _dump_code {"
NSQ_SOURCE_LINE 00000072 "    my $code = shift;"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    state $deparse = do {"
NSQ_SOURCE_LINE 00000075 "        require B::Deparse;"
NSQ_SOURCE_LINE 00000076 "        B::Deparse->new(\"-l\"); # -i option doesn't have any effect?"
NSQ_SOURCE_LINE 00000077 "    };"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    my $res = $deparse->coderef2text($code);"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    my ($res_before_first_line, $res_after_first_line) ="
NSQ_SOURCE_LINE 00000082 "        $res =~ /(.+?)^(#line .+)/ms;"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    if ($OPT_REMOVE_PRAGMAS) {"
NSQ_SOURCE_LINE 00000085 "        $res_before_first_line = \"{\";"
NSQ_SOURCE_LINE 00000086 "    } elsif ($OPT_PERL_VERSION < 5.016) {"
NSQ_SOURCE_LINE 00000087 "        # older perls' feature.pm doesn't yet support q{no feature ':all';}"
NSQ_SOURCE_LINE 00000088 "        # so we replace it with q{no feature}."
NSQ_SOURCE_LINE 00000089 "        $res_before_first_line =~ s/no feature ':all';/no feature;/m;"
NSQ_SOURCE_LINE 00000090 "    }"
NSQ_SOURCE_LINE 00000091 "    $res_after_first_line =~ s/^#line .+//gm;"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    $res = \"sub\" . $res_before_first_line . $res_after_first_line;"
NSQ_SOURCE_LINE 00000094 "    $res =~ s/^\\s+//gm;"
NSQ_SOURCE_LINE 00000095 "    $res =~ s/\\n+//g;"
NSQ_SOURCE_LINE 00000096 "    $res =~ s/;\\}\\z/}/;"
NSQ_SOURCE_LINE 00000097 "    $res;"
NSQ_SOURCE_LINE 00000098 "}"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "sub _quote_key {"
NSQ_SOURCE_LINE 00000101 "    $_[0] =~ /\\A-?[A-Za-z_][A-Za-z0-9_]*\\z/ ||"
NSQ_SOURCE_LINE 00000102 "        $_[0] =~ /\\A-?[1-9][0-9]{0,8}\\z/ ? $_[0] : _double_quote($_[0]);"
NSQ_SOURCE_LINE 00000103 "}"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "sub _dump {"
NSQ_SOURCE_LINE 00000106 "    my ($val, $subscript) = @_;"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "    my $ref = ref($val);"
NSQ_SOURCE_LINE 00000109 "    if ($ref eq '') {"
NSQ_SOURCE_LINE 00000110 "        if (!defined($val)) {"
NSQ_SOURCE_LINE 00000111 "            return \"undef\";"
NSQ_SOURCE_LINE 00000112 "        } elsif (looks_like_number($val) && !$OPT_STRINGIFY_NUMBERS &&"
NSQ_SOURCE_LINE 00000113 "                     # perl does several normalizations to number literal, e.g."
NSQ_SOURCE_LINE 00000114 "                     # \"+1\" becomes 1, 0123 is octal literal, etc. make sure we"
NSQ_SOURCE_LINE 00000115 "                     # only leave out quote when the number is not normalized"
NSQ_SOURCE_LINE 00000116 "                     $val eq $val+0 &&"
NSQ_SOURCE_LINE 00000117 "                     # perl also doesn't recognize Inf and NaN as numeric"
NSQ_SOURCE_LINE 00000118 "                     # literals (ref: perldata) so these unquoted literals will"
NSQ_SOURCE_LINE 00000119 "                     # choke under 'use strict \"subs\""
NSQ_SOURCE_LINE 00000120 "                     $val !~ /\\A-?(?:inf(?:inity)?|nan)\\z/i"
NSQ_SOURCE_LINE 00000121 "                 ) {"
NSQ_SOURCE_LINE 00000122 "            return $val;"
NSQ_SOURCE_LINE 00000123 "        } else {"
NSQ_SOURCE_LINE 00000124 "            return _double_quote($val);"
NSQ_SOURCE_LINE 00000125 "        }"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 "    my $refaddr = refaddr($val);"
NSQ_SOURCE_LINE 00000128 "    $_subscripts{$refaddr} //= $subscript;"
NSQ_SOURCE_LINE 00000129 "    if ($_seen_refaddrs{$refaddr}++) {"
NSQ_SOURCE_LINE 00000130 "        my $target = \"\\$var\" ."
NSQ_SOURCE_LINE 00000131 "            ($_subscripts{$refaddr} ? \"->$_subscripts{$refaddr}\" : \"\");"
NSQ_SOURCE_LINE 00000132 "        push @_fixups, \"\\$var->$subscript=$target;\";"
NSQ_SOURCE_LINE 00000133 "        return _single_quote($target);"
NSQ_SOURCE_LINE 00000134 "    }"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    my $class;"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "    if ($ref eq 'Regexp' || $ref eq 'REGEXP') {"
NSQ_SOURCE_LINE 00000139 "        require Regexp::Stringify;"
NSQ_SOURCE_LINE 00000140 "        return Regexp::Stringify::stringify_regexp("
NSQ_SOURCE_LINE 00000141 "            regexp=>$val, with_qr=>1, plver=>$OPT_PERL_VERSION);"
NSQ_SOURCE_LINE 00000142 "    }"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    if (blessed $val) {"
NSQ_SOURCE_LINE 00000145 "        $class = $ref;"
NSQ_SOURCE_LINE 00000146 "        $ref = reftype($val);"
NSQ_SOURCE_LINE 00000147 "    }"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    my $res;"
NSQ_SOURCE_LINE 00000150 "    if ($ref eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000151 "        $res = \"[\";"
NSQ_SOURCE_LINE 00000152 "        my $i = 0;"
NSQ_SOURCE_LINE 00000153 "        for (@$val) {"
NSQ_SOURCE_LINE 00000154 "            $res .= \",\" if $i;"
NSQ_SOURCE_LINE 00000155 "            $res .= _dump($_, \"$subscript\\[$i]\");"
NSQ_SOURCE_LINE 00000156 "            $i++;"
NSQ_SOURCE_LINE 00000157 "        }"
NSQ_SOURCE_LINE 00000158 "        $res .= \"]\";"
NSQ_SOURCE_LINE 00000159 "    } elsif ($ref eq 'HASH') {"
NSQ_SOURCE_LINE 00000160 "        $res = \"{\";"
NSQ_SOURCE_LINE 00000161 "        my $i = 0;"
NSQ_SOURCE_LINE 00000162 "        for (sort keys %$val) {"
NSQ_SOURCE_LINE 00000163 "            $res .= \",\" if $i++;"
NSQ_SOURCE_LINE 00000164 "            my $k = _quote_key($_);"
NSQ_SOURCE_LINE 00000165 "            my $v = _dump($val->{$_}, \"$subscript\\{$k}\");"
NSQ_SOURCE_LINE 00000166 "            $res .= \"$k=>$v\";"
NSQ_SOURCE_LINE 00000167 "        }"
NSQ_SOURCE_LINE 00000168 "        $res .= \"}\";"
NSQ_SOURCE_LINE 00000169 "    } elsif ($ref eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000170 "        if (defined $class) {"
NSQ_SOURCE_LINE 00000171 "            $res = \"do{my\\$o=\"._dump($$val, $subscript).\";\\\\\\$o}\";"
NSQ_SOURCE_LINE 00000172 "        } else {"
NSQ_SOURCE_LINE 00000173 "            $res = \"\\\\\"._dump($$val, $subscript);"
NSQ_SOURCE_LINE 00000174 "        }"
NSQ_SOURCE_LINE 00000175 "    } elsif ($ref eq 'REF') {"
NSQ_SOURCE_LINE 00000176 "        $res = \"\\\\\"._dump($$val, $subscript);"
NSQ_SOURCE_LINE 00000177 "    } elsif ($ref eq 'CODE') {"
NSQ_SOURCE_LINE 00000178 "        $res = $OPT_DEPARSE ? _dump_code($val) : 'sub{\"DUMMY\"}';"
NSQ_SOURCE_LINE 00000179 "    } else {"
NSQ_SOURCE_LINE 00000180 "        die \"Sorry, I can't dump $val (ref=$ref) yet\";"
NSQ_SOURCE_LINE 00000181 "    }"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    $res = \"bless($res,\"._double_quote($class).\")\" if defined($class);"
NSQ_SOURCE_LINE 00000184 "    $res;"
NSQ_SOURCE_LINE 00000185 "}"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "our $_is_dd;"
NSQ_SOURCE_LINE 00000188 "our $_is_ellipsis;"
NSQ_SOURCE_LINE 00000189 "sub _dd_or_dmp {"
NSQ_SOURCE_LINE 00000190 "    local %_seen_refaddrs;"
NSQ_SOURCE_LINE 00000191 "    local %_subscripts;"
NSQ_SOURCE_LINE 00000192 "    local @_fixups;"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    my $res;"
NSQ_SOURCE_LINE 00000195 "    if (@_ > 1) {"
NSQ_SOURCE_LINE 00000196 "        $res = \"(\" . join(\",\", map {_dump($_, '')} @_) . \")\";"
NSQ_SOURCE_LINE 00000197 "    } else {"
NSQ_SOURCE_LINE 00000198 "        $res = _dump($_[0], '');"
NSQ_SOURCE_LINE 00000199 "    }"
NSQ_SOURCE_LINE 00000200 "    if (@_fixups) {"
NSQ_SOURCE_LINE 00000201 "        $res = \"do{my\\$var=$res;\" . join(\"\", @_fixups) . \"\\$var}\";"
NSQ_SOURCE_LINE 00000202 "    }"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "    if ($_is_ellipsis) {"
NSQ_SOURCE_LINE 00000205 "        $res = substr($res, 0, $OPT_MAX_DUMP_LEN_BEFORE_ELLIPSIS) . '...'"
NSQ_SOURCE_LINE 00000206 "            if length($res) > $OPT_MAX_DUMP_LEN_BEFORE_ELLIPSIS;"
NSQ_SOURCE_LINE 00000207 "    }"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "    if ($_is_dd) {"
NSQ_SOURCE_LINE 00000210 "        say $res;"
NSQ_SOURCE_LINE 00000211 "        return wantarray() || @_ > 1 ? @_ : $_[0];"
NSQ_SOURCE_LINE 00000212 "    } else {"
NSQ_SOURCE_LINE 00000213 "        return $res;"
NSQ_SOURCE_LINE 00000214 "    }"
NSQ_SOURCE_LINE 00000215 "}"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "sub dd { local $_is_dd=1; _dd_or_dmp(@_) } # goto &sub doesn't work with local"
NSQ_SOURCE_LINE 00000218 "sub dmp { goto &_dd_or_dmp }"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "sub dd_ellipsis { local $_is_dd=1; local $_is_ellipsis=1; _dd_or_dmp(@_) }"
NSQ_SOURCE_LINE 00000221 "sub dmp_ellipsis { local $_is_ellipsis=1; _dd_or_dmp(@_) }"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "1;"
NSQ_SOURCE_LINE 00000224 "# ABSTRACT: Dump Perl data structures as Perl code"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "__END__"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "=pod"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=head1 NAME"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "Data::Dmp - Dump Perl data structures as Perl code"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=head1 VERSION"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "This document describes version 0.242 of Data::Dmp (from Perl distribution Data-Dmp), released on 2022-08-28."
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 " use Data::Dmp; # exports dd() and dmp()"
NSQ_SOURCE_LINE 00000243 " dd [1, 2, 3]; # prints \"[1,2,3]\""
NSQ_SOURCE_LINE 00000244 " $var = dmp({a => 1}); # -> \"{a=>1}\""
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "Print truncated dump (capped at L</$Data::Dmp::OPT_MAX_DUMP_LEN_BEFORE_ELLIPSIS>"
NSQ_SOURCE_LINE 00000247 "characters):"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 " use Data::Dmp qw(dd_ellipsis dmp_ellipsis);"
NSQ_SOURCE_LINE 00000250 " dd_ellipsis [1..100];"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "Data::Dmp is a Perl dumper like L<Data::Dumper>. It's compact (only about 200"
NSQ_SOURCE_LINE 00000255 "lines of code long), starts fast and does not use any non-core modules except"
NSQ_SOURCE_LINE 00000256 "L<Regexp::Stringify> when dumping regexes. It produces compact single-line"
NSQ_SOURCE_LINE 00000257 "output (similar to L<Data::Dumper::Concise>). It roughly has the same speed as"
NSQ_SOURCE_LINE 00000258 "Data::Dumper (usually a bit faster for smaller structures) and faster than"
NSQ_SOURCE_LINE 00000259 "L<Data::Dump>, but does not offer the various formatting options. It supports"
NSQ_SOURCE_LINE 00000260 "dumping objects, regexes, circular structures, coderefs. Its code is first based"
NSQ_SOURCE_LINE 00000261 "on L<Data::Dump>: I removed all the parts that I don't need, particularly the"
NSQ_SOURCE_LINE 00000262 "pretty formatting stuffs) and added some features that I need like proper regex"
NSQ_SOURCE_LINE 00000263 "dumping and coderef deparsing."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=head1 VARIABLES"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=head2 $Data::Dmp::OPT_PERL_VERSION"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "String, default: 5.010."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Set target Perl version. If you set this to, say C<5.010>, then the dumped code"
NSQ_SOURCE_LINE 00000272 "will keep compatibility with Perl 5.10.0. This is used in the following ways:"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "=over"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "=item * passed to L<Regexp::Stringify>"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=item * when dumping code references"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "For example, in perls earlier than 5.016, feature.pm does not understand:"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 " no feature ':all';"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "so we replace it with:"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 " no feature;"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=back"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=head2 $Data::Dmp::OPT_REMOVE_PRAGMAS"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "Bool, default: 0."
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "If set to 1, then pragmas at the start of coderef dump will be removed. Coderef"
NSQ_SOURCE_LINE 00000295 "dump is produced by L<B::Deparse> and is of the form like:"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 " sub { use feature 'current_sub', 'evalbytes', 'fc', 'say', 'state', 'switch', 'unicode_strings', 'unicode_eval'; $a <=> $b }"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "If you want to dump short coderefs, the pragmas might be distracting. You can"
NSQ_SOURCE_LINE 00000300 "turn turn on this option which will make the above dump become:"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 " sub { $a <=> $b }"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "Note that without the pragmas, the dump might be incorrect."
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=head2 $Data::Dmp::OPT_DEPARSE"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "Bool, default: 1."
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "Can be set to 0 to skip deparsing code. Coderefs will be dumped as"
NSQ_SOURCE_LINE 00000311 "C<sub{\"DUMMY\"}> instead, like in Data::Dump."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "=head2 $Data::Dmp::OPT_STRINGIFY_NUMBERS"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "Bool, default: 0."
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "If set to true, will dump numbers as quoted string, e.g. 123 as \"123\" instead of"
NSQ_SOURCE_LINE 00000318 "123. This might be helpful if you want to compute the hash of or get a canonical"
NSQ_SOURCE_LINE 00000319 "representation of data structure."
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "=head2 $Data::Dmp::OPT_MAX_DUMP_LEN_BEFORE_ELLIPSIS"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "Int, default: 70."
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "Used by L</dd_ellipsis> and L</dmp_ellipsis>."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "=head1 BENCHMARKS"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 " [1..10]:"
NSQ_SOURCE_LINE 00000330 "              Rate/s Precision/s  Data::Dump Data::Dumper Data::Dmp"
NSQ_SOURCE_LINE 00000331 " Data::Dump    24404          95          --       -61.6%    -75.6%"
NSQ_SOURCE_LINE 00000332 " Data::Dumper  63580         210 160.5+-1.3%           --    -36.4%"
NSQ_SOURCE_LINE 00000333 " Data::Dmp     99940         130 309.5+-1.7% 57.18+-0.55%        --"
NSQ_SOURCE_LINE 00000334 " "
NSQ_SOURCE_LINE 00000335 " [1..100]:"
NSQ_SOURCE_LINE 00000336 "               Rate/s Precision/s  Data::Dump Data::Dumper Data::Dmp"
NSQ_SOURCE_LINE 00000337 " Data::Dump    2934.3         7.8          --       -75.3%    -76.2%"
NSQ_SOURCE_LINE 00000338 " Data::Dumper   11873          32 304.6+-1.5%           --     -3.7%"
NSQ_SOURCE_LINE 00000339 " Data::Dmp    12323.4           4   320+-1.1%   3.8+-0.28%        --"
NSQ_SOURCE_LINE 00000340 " "
NSQ_SOURCE_LINE 00000341 " Some mixed structure:"
NSQ_SOURCE_LINE 00000342 "              Rate/s Precision/s   Data::Dump   Data::Dmp Data::Dumper"
NSQ_SOURCE_LINE 00000343 " Data::Dump     7161          12           --      -69.3%       -78.7%"
NSQ_SOURCE_LINE 00000344 " Data::Dmp     23303          29 225.43+-0.7%          --       -30.6%"
NSQ_SOURCE_LINE 00000345 " Data::Dumper  33573          56  368.8+-1.1% 44.07+-0.3%           --"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "=head2 dd"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "Usage:"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 " dd($data, ...); # returns $data"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "Exported by default. Like C<Data::Dump>'s C<dd> (a.k.a. C<dump>), print one or"
NSQ_SOURCE_LINE 00000356 "more data to STDOUT. Unlike C<Data::Dump>'s C<dd>, it I<always> prints and"
NSQ_SOURCE_LINE 00000357 "return I<the original data> (like L<XXX>), making it convenient to insert into"
NSQ_SOURCE_LINE 00000358 "expressions. This also removes ambiguity and saves one C<wantarray()> call."
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "=head2 dmp"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "Usage:"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 " my $dump = dmp($data, ...);"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "Exported by default. Return dump result as string. Unlike C<Data::Dump>'s C<dd>"
NSQ_SOURCE_LINE 00000367 "(a.k.a. C<dump>), it I<never> prints and only return the dump result."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=head2 dd_ellipsis"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "Usage:"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 " dd_ellipsis($data, ...); # returns data"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "Just like L</dd>, except will truncate its output to"
NSQ_SOURCE_LINE 00000376 "L</$Data::Dmp::OPT_MAX_DUMP_LEN_BEFORE_ELLIPSIS> characters if dump is too long."
NSQ_SOURCE_LINE 00000377 "Note that truncated dump will probably not be valid Perl code."
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "=head2 dmp_ellipsis"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "Usage:"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 " my $dump = dd_ellipsis($data, ...); # returns data"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "Just like L</dmp>, except will truncate dump result to"
NSQ_SOURCE_LINE 00000386 "L</$Data::Dmp::OPT_MAX_DUMP_LEN_BEFORE_ELLIPSIS> characters if dump is too long."
NSQ_SOURCE_LINE 00000387 "Note that truncated dump will probably not be valid Perl code."
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "=head1 FAQ"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "=head2 When to use Data::Dmp? How does it compare to other dumper modules?"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "Data::Dmp might be suitable for you if you want a relatively fast pure-Perl data"
NSQ_SOURCE_LINE 00000394 "structure dumper to eval-able Perl code. It produces compact, single-line Perl"
NSQ_SOURCE_LINE 00000395 "code but offers little/no formatting options. Data::Dmp and Data::Dump module"
NSQ_SOURCE_LINE 00000396 "family usually produce Perl code that is \"more eval-able\", e.g. it can recreate"
NSQ_SOURCE_LINE 00000397 "circular structure."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "L<Data::Dump> produces visually nicer output (some alignment, use of range"
NSQ_SOURCE_LINE 00000400 "operator to shorten lists, use of base64 for binary data, etc) but no built-in"
NSQ_SOURCE_LINE 00000401 "option to produce compact/single-line output. It's more suitable for debugging."
NSQ_SOURCE_LINE 00000402 "It's also relatively slow. I usually use its variant, L<Data::Dump::Color>, for"
NSQ_SOURCE_LINE 00000403 "console debugging."
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "L<Data::Dumper> is a core module, offers a lot of formatting options (like"
NSQ_SOURCE_LINE 00000406 "disabling hash key sorting, setting verboseness/indent level, and so on) but you"
NSQ_SOURCE_LINE 00000407 "usually have to configure it quite a bit before it does exactly like you want"
NSQ_SOURCE_LINE 00000408 "(that's why there are modules on CPAN that are just wrapping Data::Dumper with"
NSQ_SOURCE_LINE 00000409 "some configuration, like L<Data::Dumper::Concise> et al). It does not support"
NSQ_SOURCE_LINE 00000410 "dumping Perl code that can recreate circular structures."
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "Of course, dumping to eval-able Perl code is slow (not to mention the cost of"
NSQ_SOURCE_LINE 00000413 "re-loading the code back to in-memory data, via eval-ing) compared to dumping to"
NSQ_SOURCE_LINE 00000414 "JSON, YAML, Sereal, or other format. So you need to decide first whether this is"
NSQ_SOURCE_LINE 00000415 "the appropriate route you want to take. (But note that there is also"
NSQ_SOURCE_LINE 00000416 "L<Data::Dumper::Limited> and L<Data::Undump> which uses a format similar to"
NSQ_SOURCE_LINE 00000417 "Data::Dumper but lets you load the serialized data without eval-ing them, thus"
NSQ_SOURCE_LINE 00000418 "achieving the speed comparable to JSON::XS)."
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "=head2 Is the output guaranteed to be single line dump?"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "No. Some things can still produce multiline dump, e.g. newline in regular"
NSQ_SOURCE_LINE 00000423 "expression."
NSQ_SOURCE_LINE 00000424 ""
