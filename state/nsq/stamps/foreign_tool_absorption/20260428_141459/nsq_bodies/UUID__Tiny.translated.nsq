NSQ_SOURCE_LINE 00000001 "package UUID::Tiny;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.008;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use Carp;"
NSQ_SOURCE_LINE 00000007 "use Digest::MD5;"
NSQ_SOURCE_LINE 00000008 "use MIME::Base64;"
NSQ_SOURCE_LINE 00000009 "use Time::HiRes;"
NSQ_SOURCE_LINE 00000010 "use POSIX;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "my $SHA1_CALCULATOR = undef;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "{"
NSQ_SOURCE_LINE 00000015 "    # Check for availability of SHA-1 ..."
NSQ_SOURCE_LINE 00000016 "    local $@; # don't leak an error condition"
NSQ_SOURCE_LINE 00000017 "    eval { require Digest::SHA;  $SHA1_CALCULATOR = Digest::SHA->new(1) } ||"
NSQ_SOURCE_LINE 00000018 "    eval { require Digest::SHA1; $SHA1_CALCULATOR = Digest::SHA1->new() } ||"
NSQ_SOURCE_LINE 00000019 "    eval {"
NSQ_SOURCE_LINE 00000020 "        require Digest::SHA::PurePerl;"
NSQ_SOURCE_LINE 00000021 "        $SHA1_CALCULATOR = Digest::SHA::PurePerl->new(1)"
NSQ_SOURCE_LINE 00000022 "    };"
NSQ_SOURCE_LINE 00000023 "};"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "my $MD5_CALCULATOR = Digest::MD5->new();"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "# ToDo:"
NSQ_SOURCE_LINE 00000029 "# - Check and report for undefined UUIDs with all UUID manipulating functions!"
NSQ_SOURCE_LINE 00000030 "# - Better error propagation for better debugging."
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "=head1 NAME"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "UUID::Tiny - Pure Perl UUID Support With Functional Interface"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "=head1 VERSION"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "Version 1.04"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=cut"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "our $VERSION = '1.04';"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "Create version 1, 3, 4 and 5 UUIDs:"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    use UUID::Tiny ':std';"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    my $v1_mc_UUID      = create_uuid();"
NSQ_SOURCE_LINE 00000054 "    my $v1_mc_UUID_2    = create_uuid(UUID_V1);"
NSQ_SOURCE_LINE 00000055 "    my $v1_mc_UUID_3    = create_uuid(UUID_TIME);"
NSQ_SOURCE_LINE 00000056 "    my $v3_md5_UUID     = create_uuid(UUID_V3, $str);"
NSQ_SOURCE_LINE 00000057 "    my $v3_md5_UUID_2   = create_uuid(UUID_MD5, UUID_NS_DNS, 'caugustin.de');"
NSQ_SOURCE_LINE 00000058 "    my $v4_rand_UUID    = create_uuid(UUID_V4);"
NSQ_SOURCE_LINE 00000059 "    my $v4_rand_UUID_2  = create_uuid(UUID_RANDOM);"
NSQ_SOURCE_LINE 00000060 "    my $v5_sha1_UUID    = create_uuid(UUID_V5, $str);"
NSQ_SOURCE_LINE 00000061 "    my $v5_with_NS_UUID = create_uuid(UUID_SHA1, UUID_NS_DNS, 'caugustin.de');"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    my $v1_mc_UUID_string  = create_uuid_as_string(UUID_V1);"
NSQ_SOURCE_LINE 00000064 "    my $v3_md5_UUID_string = uuid_to_string($v3_md5_UUID);"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    if ( version_of_uuid($v1_mc_UUID) == 1   ) { ... };"
NSQ_SOURCE_LINE 00000067 "    if ( version_of_uuid($v5_sha1_UUID) == 5 ) { ... };"
NSQ_SOURCE_LINE 00000068 "    if ( is_uuid_string($v1_mc_UUID_string)  ) { ... };"
NSQ_SOURCE_LINE 00000069 "    if ( equal_uuids($uuid1, $uuid2)         ) { ... };"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "    my $uuid_time    = time_of_uuid($v1_mc_UUID);"
NSQ_SOURCE_LINE 00000072 "    my $uuid_clk_seq = clk_seq_of_uuid($v1_mc_UUID);"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=cut"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "UUID::Tiny is a lightweight, low dependency Pure Perl module for UUID"
NSQ_SOURCE_LINE 00000080 "creation and testing. This module provides the creation of version 1 time"
NSQ_SOURCE_LINE 00000081 "based UUIDs (using random multicast MAC addresses), version 3 MD5 based UUIDs,"
NSQ_SOURCE_LINE 00000082 "version 4 random UUIDs, and version 5 SHA-1 based UUIDs."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "ATTENTION! UUID::Tiny uses Perl's C<rand()> to create the basic random"
NSQ_SOURCE_LINE 00000085 "numbers, so the created v4 UUIDs are B<not> cryptographically strong!"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "No fancy OO interface, no plethora of different UUID representation formats"
NSQ_SOURCE_LINE 00000088 "and transformations - just string and binary. Conversion, test and time"
NSQ_SOURCE_LINE 00000089 "functions equally accept UUIDs and UUID strings, so don't bother to convert"
NSQ_SOURCE_LINE 00000090 "UUIDs for them!"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "Continuing with 1.0x versions all constants and public functions are exported"
NSQ_SOURCE_LINE 00000093 "by default, but this will change in the future (see below). "
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "UUID::Tiny deliberately uses a minimal functional interface for UUID creation"
NSQ_SOURCE_LINE 00000096 "(and conversion/testing), because in this case OO looks like overkill to me"
NSQ_SOURCE_LINE 00000097 "and makes the creation and use of UUIDs unnecessarily complicated."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "If you need raw performance for UUID creation, or the real MAC address in"
NSQ_SOURCE_LINE 00000100 "version 1 UUIDs, or an OO interface, and if you can afford module compilation"
NSQ_SOURCE_LINE 00000101 "and installation on the target system, then better look at other CPAN UUID"
NSQ_SOURCE_LINE 00000102 "modules like L<Data::UUID>."
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "This module is \"fork safe\", especially for random UUIDs (it works around"
NSQ_SOURCE_LINE 00000105 "Perl's rand() problem when forking processes)."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "This module is currently B<not> \"thread safe\". Even though I've incorporated"
NSQ_SOURCE_LINE 00000108 "some changes proposed by Michael G. Schwern (thanks!), Digest::MD5 and"
NSQ_SOURCE_LINE 00000109 "Digest::SHA seem so have trouble with threads. There is a test file for"
NSQ_SOURCE_LINE 00000110 "threads, but it is de-activated. So use at your own risk!"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=cut"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=head1 DEPENDENCIES"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "This module should run from Perl 5.8 up and uses mostly standard (5.8 core)"
NSQ_SOURCE_LINE 00000118 "modules for its job. No compilation or installation required. These are the"
NSQ_SOURCE_LINE 00000119 "modules UUID::Tiny depends on:"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "    Carp"
NSQ_SOURCE_LINE 00000122 "    Digest::MD5   Perl 5.8 core"
NSQ_SOURCE_LINE 00000123 "    Digest::SHA   Perl 5.10 core (or Digest::SHA1, or Digest::SHA::PurePerl)"
NSQ_SOURCE_LINE 00000124 "    MIME::Base64  Perl 5.8 core"
NSQ_SOURCE_LINE 00000125 "    Time::HiRes   Perl 5.8 core"
NSQ_SOURCE_LINE 00000126 "    POSIX         Perl 5.8 core"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "If you are using this module on a Perl prior to 5.10 and you don't have"
NSQ_SOURCE_LINE 00000129 "Digest::SHA1 installed, you can use Digest::SHA::PurePerl instead."
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=cut"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "=head1 ATTENTION! NEW STANDARD INTERFACE"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "After some debate I'm convinced that it is more Perlish (and far easier to"
NSQ_SOURCE_LINE 00000137 "write) to use all-lowercase function names - without exceptions. And that it"
NSQ_SOURCE_LINE 00000138 "is more polite to export symbols only on demand."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "While the 1.0x versions will continue to export the old, \"legacy\" interface on"
NSQ_SOURCE_LINE 00000141 "default, the future standard interface is available using the C<:std> tag on"
NSQ_SOURCE_LINE 00000142 "import from version 1.02 on:"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    use UUID::Tiny ':std';"
NSQ_SOURCE_LINE 00000145 "    my $md5_uuid = create_uuid(UUID_MD5, $str);"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "In preparation for future version of UUID::Tiny you have to use the"
NSQ_SOURCE_LINE 00000148 "C<:legacy> tag if you want to stay with the version 1.0 interface:"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "    use UUID::Tiny ':legacy';"
NSQ_SOURCE_LINE 00000151 "    my $md5_uuid = create_UUID(UUID_V3, $str);"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=cut"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "use Exporter;"
NSQ_SOURCE_LINE 00000156 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000157 "our @EXPORT;"
NSQ_SOURCE_LINE 00000158 "our @EXPORT_OK;"
NSQ_SOURCE_LINE 00000159 "our %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00000160 "     std =>         [qw("
NSQ_SOURCE_LINE 00000161 "                        UUID_NIL"
NSQ_SOURCE_LINE 00000162 "                        UUID_NS_DNS UUID_NS_URL UUID_NS_OID UUID_NS_X500"
NSQ_SOURCE_LINE 00000163 "                        UUID_V1 UUID_TIME"
NSQ_SOURCE_LINE 00000164 "                        UUID_V3 UUID_MD5"
NSQ_SOURCE_LINE 00000165 "                        UUID_V4 UUID_RANDOM"
NSQ_SOURCE_LINE 00000166 "                        UUID_V5 UUID_SHA1"
NSQ_SOURCE_LINE 00000167 "                        UUID_SHA1_AVAIL"
NSQ_SOURCE_LINE 00000168 "                        create_uuid create_uuid_as_string"
NSQ_SOURCE_LINE 00000169 "                        is_uuid_string"
NSQ_SOURCE_LINE 00000170 "                        uuid_to_string string_to_uuid"
NSQ_SOURCE_LINE 00000171 "                        version_of_uuid time_of_uuid clk_seq_of_uuid"
NSQ_SOURCE_LINE 00000172 "                        equal_uuids"
NSQ_SOURCE_LINE 00000173 "                    )],"
NSQ_SOURCE_LINE 00000174 "    legacy =>       [qw("
NSQ_SOURCE_LINE 00000175 "                        UUID_NIL"
NSQ_SOURCE_LINE 00000176 "                        UUID_NS_DNS UUID_NS_URL UUID_NS_OID UUID_NS_X500"
NSQ_SOURCE_LINE 00000177 "                        UUID_V1"
NSQ_SOURCE_LINE 00000178 "                        UUID_V3"
NSQ_SOURCE_LINE 00000179 "                        UUID_V4"
NSQ_SOURCE_LINE 00000180 "                        UUID_V5"
NSQ_SOURCE_LINE 00000181 "                        UUID_SHA1_AVAIL"
NSQ_SOURCE_LINE 00000182 "                        create_UUID create_UUID_as_string"
NSQ_SOURCE_LINE 00000183 "                        is_UUID_string"
NSQ_SOURCE_LINE 00000184 "                        UUID_to_string string_to_UUID"
NSQ_SOURCE_LINE 00000185 "                        version_of_UUID time_of_UUID clk_seq_of_UUID"
NSQ_SOURCE_LINE 00000186 "                        equal_UUIDs"
NSQ_SOURCE_LINE 00000187 "                    )],"
NSQ_SOURCE_LINE 00000188 ");"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "Exporter::export_tags('legacy');"
NSQ_SOURCE_LINE 00000191 "Exporter::export_ok_tags('std');"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=head1 CONSTANTS"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=cut"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "=over 4"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=item B<NIL UUID>"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "This module provides the NIL UUID (shown with its string representation):"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "    UUID_NIL: '00000000-0000-0000-0000-000000000000'"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=cut"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "use constant UUID_NIL => \"\\x00\" x 16;"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=item B<Pre-defined Namespace UUIDs>"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "This module provides the common pre-defined namespace UUIDs (shown with their"
NSQ_SOURCE_LINE 00000214 "string representation):"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    UUID_NS_DNS:  '6ba7b810-9dad-11d1-80b4-00c04fd430c8'"
NSQ_SOURCE_LINE 00000217 "    UUID_NS_URL:  '6ba7b811-9dad-11d1-80b4-00c04fd430c8'"
NSQ_SOURCE_LINE 00000218 "    UUID_NS_OID:  '6ba7b812-9dad-11d1-80b4-00c04fd430c8'"
NSQ_SOURCE_LINE 00000219 "    UUID_NS_X500: '6ba7b814-9dad-11d1-80b4-00c04fd430c8'"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=cut"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "use constant UUID_NS_DNS  =>"
NSQ_SOURCE_LINE 00000224 "    \"\\x6b\\xa7\\xb8\\x10\\x9d\\xad\\x11\\xd1\\x80\\xb4\\x00\\xc0\\x4f\\xd4\\x30\\xc8\";"
NSQ_SOURCE_LINE 00000225 "use constant UUID_NS_URL  =>"
NSQ_SOURCE_LINE 00000226 "    \"\\x6b\\xa7\\xb8\\x11\\x9d\\xad\\x11\\xd1\\x80\\xb4\\x00\\xc0\\x4f\\xd4\\x30\\xc8\";"
NSQ_SOURCE_LINE 00000227 "use constant UUID_NS_OID  =>"
NSQ_SOURCE_LINE 00000228 "    \"\\x6b\\xa7\\xb8\\x12\\x9d\\xad\\x11\\xd1\\x80\\xb4\\x00\\xc0\\x4f\\xd4\\x30\\xc8\";"
NSQ_SOURCE_LINE 00000229 "use constant UUID_NS_X500 =>"
NSQ_SOURCE_LINE 00000230 "    \"\\x6b\\xa7\\xb8\\x14\\x9d\\xad\\x11\\xd1\\x80\\xb4\\x00\\xc0\\x4f\\xd4\\x30\\xc8\";"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=item B<UUID versions>"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "This module provides the UUID version numbers as constants:"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "    UUID_V1"
NSQ_SOURCE_LINE 00000238 "    UUID_V3"
NSQ_SOURCE_LINE 00000239 "    UUID_V4"
NSQ_SOURCE_LINE 00000240 "    UUID_V5"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "With C<use UUID::Tiny ':std';> you get additional, \"speaking\" constants:"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "    UUID_TIME"
NSQ_SOURCE_LINE 00000245 "    UUID_MD5"
NSQ_SOURCE_LINE 00000246 "    UUID_RANDOM"
NSQ_SOURCE_LINE 00000247 "    UUID_SHA1"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=cut"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "use constant UUID_V1 => 1; use constant UUID_TIME   => 1;"
NSQ_SOURCE_LINE 00000252 "use constant UUID_V3 => 3; use constant UUID_MD5    => 3;"
NSQ_SOURCE_LINE 00000253 "use constant UUID_V4 => 4; use constant UUID_RANDOM => 4;"
NSQ_SOURCE_LINE 00000254 "use constant UUID_V5 => 5; use constant UUID_SHA1   => 5;"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=item B<UUID_SHA1_AVAIL>"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "    my $uuid = create_UUID( UUID_SHA1_AVAIL? UUID_V5 : UUID_V3, $str );"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "This function returns 1 if a module to create SHA-1 digests could be loaded, 0"
NSQ_SOURCE_LINE 00000262 "otherwise."
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "UUID::Tiny (since version 1.02) tries to load Digest::SHA, Digest::SHA1 or"
NSQ_SOURCE_LINE 00000265 "Digest::SHA::PurePerl, but does not die if none of them is found. Instead"
NSQ_SOURCE_LINE 00000266 "C<create_UUID()> and C<create_UUID_as_string()> die when trying to create an"
NSQ_SOURCE_LINE 00000267 "SHA-1 based UUID without an appropriate module available."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=cut"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "sub UUID_SHA1_AVAIL {"
NSQ_SOURCE_LINE 00000272 "    return defined $SHA1_CALCULATOR ? 1 : 0;"
NSQ_SOURCE_LINE 00000273 "}"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=back"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=cut"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "All public functions are exported by default (they should not collide with"
NSQ_SOURCE_LINE 00000282 "other functions)."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "C<create_UUID()> creates standard binary UUIDs in network byte order"
NSQ_SOURCE_LINE 00000285 "(MSB first), C<create_UUID_as_string()> creates the standard string"
NSQ_SOURCE_LINE 00000286 "representation of UUIDs."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "All query and test functions (except C<is_UUID_string>) accept both"
NSQ_SOURCE_LINE 00000289 "representations."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=over 4"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=cut"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=item B<create_UUID()>, B<create_uuid()> (:std)"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "    my $v1_mc_UUID   = create_UUID();"
NSQ_SOURCE_LINE 00000298 "    my $v1_mc_UUID   = create_UUID(UUID_V1);"
NSQ_SOURCE_LINE 00000299 "    my $v3_md5_UUID  = create_UUID(UUID_V3, $ns_uuid, $name_or_filehandle);"
NSQ_SOURCE_LINE 00000300 "    my $v3_md5_UUID  = create_UUID(UUID_V3, $name_or_filehandle);"
NSQ_SOURCE_LINE 00000301 "    my $v4_rand_UUID = create_UUID(UUID_V4);"
NSQ_SOURCE_LINE 00000302 "    my $v5_sha1_UUID = create_UUID(UUID_V5, $ns_uuid, $name_or_filehandle);"
NSQ_SOURCE_LINE 00000303 "    my $v5_sha1_UUID = create_UUID(UUID_V5, $name_or_filehandle);"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "Creates a binary UUID in network byte order (MSB first). For v3 and v5 UUIDs a"
NSQ_SOURCE_LINE 00000306 "C<SCALAR> (normally a string), C<GLOB> (\"classic\" file handle) or C<IO> object"
NSQ_SOURCE_LINE 00000307 "(i.e. C<IO::File>) can be used; files have to be opened for reading."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "I found no hint if and how UUIDs should be created from file content. It seems"
NSQ_SOURCE_LINE 00000310 "to be undefined, but it is useful - so I would suggest to use UUID_NIL as the"
NSQ_SOURCE_LINE 00000311 "namespace UUID, because no \"real name\" is used; UUID_NIL is used by default if"
NSQ_SOURCE_LINE 00000312 "a namespace UUID is missing (only 2 arguments are used)."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=cut"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "sub create_uuid {"
NSQ_SOURCE_LINE 00000317 "    use bytes;"
NSQ_SOURCE_LINE 00000318 "    my ($v, $arg2, $arg3) = (shift || UUID_V1, shift, shift);"
NSQ_SOURCE_LINE 00000319 "    my $uuid    = UUID_NIL;"
NSQ_SOURCE_LINE 00000320 "    my $ns_uuid = string_to_uuid(defined $arg3 ? $arg2 : UUID_NIL);"
NSQ_SOURCE_LINE 00000321 "    my $name    = defined $arg3 ? $arg3 : $arg2;"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "    if ($v == UUID_V1) {"
NSQ_SOURCE_LINE 00000324 "        $uuid = _create_v1_uuid();"
NSQ_SOURCE_LINE 00000325 "    }"
NSQ_SOURCE_LINE 00000326 "    elsif ($v == UUID_V3 ) {"
NSQ_SOURCE_LINE 00000327 "        $uuid = _create_v3_uuid($ns_uuid, $name);"
NSQ_SOURCE_LINE 00000328 "    }"
NSQ_SOURCE_LINE 00000329 "    elsif ($v == UUID_V4) {"
NSQ_SOURCE_LINE 00000330 "        $uuid = _create_v4_uuid();"
NSQ_SOURCE_LINE 00000331 "    }"
NSQ_SOURCE_LINE 00000332 "    elsif ($v == UUID_V5) {"
NSQ_SOURCE_LINE 00000333 "        $uuid = _create_v5_uuid($ns_uuid, $name);"
NSQ_SOURCE_LINE 00000334 "    }"
NSQ_SOURCE_LINE 00000335 "    else {"
NSQ_SOURCE_LINE 00000336 "        croak __PACKAGE__ . \"::create_uuid(): Invalid UUID version '$v'!\";"
NSQ_SOURCE_LINE 00000337 "    }"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "    # Set variant 2 in UUID ..."
NSQ_SOURCE_LINE 00000340 "    substr $uuid, 8, 1, chr(ord(substr $uuid, 8, 1) & 0x3f | 0x80);"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "    return $uuid;"
NSQ_SOURCE_LINE 00000343 "}"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "*create_UUID = \\&create_uuid;"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "sub _create_v1_uuid {"
NSQ_SOURCE_LINE 00000349 "    my $uuid = '';"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "    # Create time and clock sequence ..."
NSQ_SOURCE_LINE 00000352 "    my $timestamp = Time::HiRes::time();"
NSQ_SOURCE_LINE 00000353 "    my $clk_seq   = _get_clk_seq($timestamp);"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "    # hi = time mod (1000000 / 0x100000000)"
NSQ_SOURCE_LINE 00000356 "    my $hi = floor( $timestamp / 65536.0 / 512 * 78125 );"
NSQ_SOURCE_LINE 00000357 "    $timestamp -= $hi * 512.0 * 65536 / 78125;"
NSQ_SOURCE_LINE 00000358 "    my $low = floor( $timestamp * 10000000.0 + 0.5 );"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "    # MAGIC offset: 01B2-1DD2-13814000"
NSQ_SOURCE_LINE 00000361 "    if ( $low < 0xec7ec000 ) {"
NSQ_SOURCE_LINE 00000362 "        $low += 0x13814000;"
NSQ_SOURCE_LINE 00000363 "    }"
NSQ_SOURCE_LINE 00000364 "    else {"
NSQ_SOURCE_LINE 00000365 "        $low -= 0xec7ec000;"
NSQ_SOURCE_LINE 00000366 "        $hi++;"
NSQ_SOURCE_LINE 00000367 "    }"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "    if ( $hi < 0x0e4de22e ) {"
NSQ_SOURCE_LINE 00000370 "        $hi += 0x01b21dd2;"
NSQ_SOURCE_LINE 00000371 "    }"
NSQ_SOURCE_LINE 00000372 "    else {"
NSQ_SOURCE_LINE 00000373 "        $hi -= 0x0e4de22e;    # wrap around"
NSQ_SOURCE_LINE 00000374 "    }"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "    # Set time in UUID ..."
NSQ_SOURCE_LINE 00000377 "    substr $uuid, 0, 4, pack( 'N', $low );            # set time low"
NSQ_SOURCE_LINE 00000378 "    substr $uuid, 4, 2, pack( 'n', $hi & 0xffff );    # set time mid"
NSQ_SOURCE_LINE 00000379 "    substr $uuid, 6, 2, pack( 'n', ( $hi >> 16 ) & 0x0fff );    # set time high"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "    # Set clock sequence in UUID ..."
NSQ_SOURCE_LINE 00000382 "    substr $uuid, 8, 2, pack( 'n', $clk_seq );"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "    # Set random node in UUID ..."
NSQ_SOURCE_LINE 00000385 "    substr $uuid, 10, 6, _random_node_id();"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "    return _set_uuid_version($uuid, 0x10);"
NSQ_SOURCE_LINE 00000388 "}"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "sub _create_v3_uuid {"
NSQ_SOURCE_LINE 00000391 "    my $ns_uuid = shift;"
NSQ_SOURCE_LINE 00000392 "    my $name    = shift;"
NSQ_SOURCE_LINE 00000393 "    my $uuid    = '';"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "    # Create digest in UUID ..."
NSQ_SOURCE_LINE 00000396 "    $MD5_CALCULATOR->reset();"
NSQ_SOURCE_LINE 00000397 "    $MD5_CALCULATOR->add($ns_uuid);"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "    if ( ref($name) =~ m/^(?:GLOB|IO::)/ ) {"
NSQ_SOURCE_LINE 00000400 "        $MD5_CALCULATOR->addfile($name);"
NSQ_SOURCE_LINE 00000401 "    }"
NSQ_SOURCE_LINE 00000402 "    elsif ( ref $name ) {"
NSQ_SOURCE_LINE 00000403 "        croak __PACKAGE__"
NSQ_SOURCE_LINE 00000404 "            . '::create_uuid(): Name for v3 UUID'"
NSQ_SOURCE_LINE 00000405 "            . ' has to be SCALAR, GLOB or IO object, not '"
NSQ_SOURCE_LINE 00000406 "            . ref($name) .'!'"
NSQ_SOURCE_LINE 00000407 "            ;"
NSQ_SOURCE_LINE 00000408 "    }"
NSQ_SOURCE_LINE 00000409 "    elsif ( defined $name ) {"
NSQ_SOURCE_LINE 00000410 "        $MD5_CALCULATOR->add($name);"
NSQ_SOURCE_LINE 00000411 "    }"
NSQ_SOURCE_LINE 00000412 "    else {"
NSQ_SOURCE_LINE 00000413 "        croak __PACKAGE__"
NSQ_SOURCE_LINE 00000414 "            . '::create_uuid(): Name for v3 UUID is not defined!';"
NSQ_SOURCE_LINE 00000415 "    }"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "    # Use only first 16 Bytes ..."
NSQ_SOURCE_LINE 00000418 "    $uuid = substr( $MD5_CALCULATOR->digest(), 0, 16 ); "
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "    return _set_uuid_version( $uuid, 0x30 );"
NSQ_SOURCE_LINE 00000421 "}"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "sub _create_v4_uuid {"
NSQ_SOURCE_LINE 00000424 "    # Create random value in UUID ..."
NSQ_SOURCE_LINE 00000425 "    my $uuid = '';"
NSQ_SOURCE_LINE 00000426 "    for ( 1 .. 4 ) {"
NSQ_SOURCE_LINE 00000427 "        $uuid .= pack 'I', _rand_32bit();"
NSQ_SOURCE_LINE 00000428 "    }"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "    return _set_uuid_version($uuid, 0x40);"
NSQ_SOURCE_LINE 00000431 "}"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "sub _create_v5_uuid {"
NSQ_SOURCE_LINE 00000434 "    my $ns_uuid = shift;"
NSQ_SOURCE_LINE 00000435 "    my $name    = shift;"
NSQ_SOURCE_LINE 00000436 "    my $uuid    = '';"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "    if (!$SHA1_CALCULATOR) {"
NSQ_SOURCE_LINE 00000439 "        croak __PACKAGE__"
NSQ_SOURCE_LINE 00000440 "            . '::create_uuid(): No SHA-1 implementation available! '"
NSQ_SOURCE_LINE 00000441 "            . 'Please install Digest::SHA1, Digest::SHA or '"
NSQ_SOURCE_LINE 00000442 "            . 'Digest::SHA::PurePerl to use SHA-1 based UUIDs.'"
NSQ_SOURCE_LINE 00000443 "            ;"
NSQ_SOURCE_LINE 00000444 "    }"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "    $SHA1_CALCULATOR->reset();"
NSQ_SOURCE_LINE 00000447 "    $SHA1_CALCULATOR->add($ns_uuid);"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "    if ( ref($name) =~ m/^(?:GLOB|IO::)/ ) {"
NSQ_SOURCE_LINE 00000450 "        $SHA1_CALCULATOR->addfile($name);"
NSQ_SOURCE_LINE 00000451 "    } elsif ( ref $name ) {"
NSQ_SOURCE_LINE 00000452 "        croak __PACKAGE__"
NSQ_SOURCE_LINE 00000453 "            . '::create_uuid(): Name for v5 UUID'"
NSQ_SOURCE_LINE 00000454 "            . ' has to be SCALAR, GLOB or IO object, not '"
NSQ_SOURCE_LINE 00000455 "            . ref($name) .'!'"
NSQ_SOURCE_LINE 00000456 "            ;"
NSQ_SOURCE_LINE 00000457 "    } elsif ( defined $name ) {"
NSQ_SOURCE_LINE 00000458 "        $SHA1_CALCULATOR->add($name);"
NSQ_SOURCE_LINE 00000459 "    } else {"
NSQ_SOURCE_LINE 00000460 "        croak __PACKAGE__ "
NSQ_SOURCE_LINE 00000461 "            . '::create_uuid(): Name for v5 UUID is not defined!';"
NSQ_SOURCE_LINE 00000462 "    }"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "    # Use only first 16 Bytes ..."
NSQ_SOURCE_LINE 00000465 "    $uuid = substr( $SHA1_CALCULATOR->digest(), 0, 16 );"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "    return _set_uuid_version($uuid, 0x50);"
NSQ_SOURCE_LINE 00000468 "}"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "sub _set_uuid_version {"
NSQ_SOURCE_LINE 00000471 "    my $uuid = shift;"
NSQ_SOURCE_LINE 00000472 "    my $version = shift;"
NSQ_SOURCE_LINE 00000473 "    substr $uuid, 6, 1, chr( ord( substr( $uuid, 6, 1 ) ) & 0x0f | $version );"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "    return $uuid;"
NSQ_SOURCE_LINE 00000476 "}"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "=item B<create_UUID_as_string()>, B<create_uuid_as_string()> (:std)"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "Similar to C<create_UUID>, but creates a UUID string."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "=cut"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "sub create_uuid_as_string {"
NSQ_SOURCE_LINE 00000486 "    return uuid_to_string(create_uuid(@_));"
NSQ_SOURCE_LINE 00000487 "}"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "*create_UUID_as_string = \\&create_uuid_as_string;"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "=item B<is_UUID_string()>, B<is_uuid_string()> (:std)"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "    my $bool = is_UUID_string($str);"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=cut"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "our $IS_UUID_STRING = qr/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/is;"
NSQ_SOURCE_LINE 00000499 "our $IS_UUID_HEX    = qr/^[0-9a-f]{32}$/is;"
NSQ_SOURCE_LINE 00000500 "our $IS_UUID_Base64 = qr/^[+\\/0-9A-Za-z]{22}(?:==)?$/s;"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "sub is_uuid_string {"
NSQ_SOURCE_LINE 00000503 "    my $uuid = shift;"
NSQ_SOURCE_LINE 00000504 "    return $uuid =~ m/$IS_UUID_STRING/;"
NSQ_SOURCE_LINE 00000505 "}"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "*is_UUID_string = \\&is_uuid_string;"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "=item B<UUID_to_string()>, B<uuid_to_string()> (:std)"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "    my $uuid_str = UUID_to_string($uuid);"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "This function returns C<$uuid> unchanged if it is a UUID string already."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=cut"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "sub uuid_to_string {"
NSQ_SOURCE_LINE 00000519 "    my $uuid = shift;"
NSQ_SOURCE_LINE 00000520 "    use bytes;"
NSQ_SOURCE_LINE 00000521 "    return $uuid"
NSQ_SOURCE_LINE 00000522 "        if $uuid =~ m/$IS_UUID_STRING/;"
NSQ_SOURCE_LINE 00000523 "    croak __PACKAGE__ . \"::uuid_to_string(): Invalid UUID!\""
NSQ_SOURCE_LINE 00000524 "        unless length $uuid == 16;"
NSQ_SOURCE_LINE 00000525 "    return  join '-',"
NSQ_SOURCE_LINE 00000526 "            map { unpack 'H*', $_ }"
NSQ_SOURCE_LINE 00000527 "            map { substr $uuid, 0, $_, '' }"
NSQ_SOURCE_LINE 00000528 "            ( 4, 2, 2, 2, 6 );"
NSQ_SOURCE_LINE 00000529 "}"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "*UUID_to_string = \\&uuid_to_string;"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=item B<string_to_UUID()>, B<string_to_uuid()> (:std)"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "    my $uuid = string_to_UUID($uuid_str);"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "This function returns C<$uuid_str> unchanged if it is a UUID already."
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "In addition to the standard UUID string representation and its URN forms"
NSQ_SOURCE_LINE 00000541 "(starting with C<urn:uuid:> or C<uuid:>), this function accepts 32 digit hex"
NSQ_SOURCE_LINE 00000542 "strings, variants with different positions of C<-> and Base64 encoded UUIDs."
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "Throws an exception if string can't be interpreted as a UUID."
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "If you want to make sure to have a \"pure\" standard UUID representation, check"
NSQ_SOURCE_LINE 00000547 "with C<is_UUID_string>!"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "=cut"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "sub string_to_uuid {"
NSQ_SOURCE_LINE 00000552 "    my $uuid = shift;"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "    use bytes;"
NSQ_SOURCE_LINE 00000555 "    return $uuid if length $uuid == 16;"
NSQ_SOURCE_LINE 00000556 "    return decode_base64($uuid) if ($uuid =~ m/$IS_UUID_Base64/);"
NSQ_SOURCE_LINE 00000557 "    my $str = $uuid;"
NSQ_SOURCE_LINE 00000558 "    $uuid =~ s/^(?:urn:)?(?:uuid:)?//io;"
NSQ_SOURCE_LINE 00000559 "    $uuid =~ tr/-//d;"
NSQ_SOURCE_LINE 00000560 "    return pack 'H*', $uuid if $uuid =~ m/$IS_UUID_HEX/;"
NSQ_SOURCE_LINE 00000561 "    croak __PACKAGE__ . \"::string_to_uuid(): '$str' is no UUID string!\";"
NSQ_SOURCE_LINE 00000562 "}"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "*string_to_UUID = \\&string_to_uuid;"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "=item B<version_of_UUID()>, B<version_of_uuid()> (:std)"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "    my $version = version_of_UUID($uuid);"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "This function accepts binary and string UUIDs."
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "=cut"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "sub version_of_uuid {"
NSQ_SOURCE_LINE 00000576 "    my $uuid = shift;"
NSQ_SOURCE_LINE 00000577 "    use bytes;"
NSQ_SOURCE_LINE 00000578 "    $uuid = string_to_uuid($uuid);"
NSQ_SOURCE_LINE 00000579 "    return (ord(substr($uuid, 6, 1)) & 0xf0) >> 4;"
NSQ_SOURCE_LINE 00000580 "}"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "*version_of_UUID = \\&version_of_uuid;"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "=item B<time_of_UUID()>, B<time_of_uuid()> (:std)"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "    my $uuid_time = time_of_UUID($uuid);"
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "This function accepts UUIDs and UUID strings. Returns the time as a floating"
NSQ_SOURCE_LINE 00000590 "point value, so use C<int()> to get a C<time()> compatible value."
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "Returns C<undef> if the UUID is not version 1."
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "=cut"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "sub time_of_uuid {"
NSQ_SOURCE_LINE 00000597 "    my $uuid = shift;"
NSQ_SOURCE_LINE 00000598 "    use bytes;"
NSQ_SOURCE_LINE 00000599 "    $uuid = string_to_uuid($uuid);"
NSQ_SOURCE_LINE 00000600 "    return unless version_of_uuid($uuid) == 1;"
NSQ_SOURCE_LINE 00000601 "    "
NSQ_SOURCE_LINE 00000602 "    my $low = unpack 'N', substr($uuid, 0, 4);"
NSQ_SOURCE_LINE 00000603 "    my $mid = unpack 'n', substr($uuid, 4, 2);"
NSQ_SOURCE_LINE 00000604 "    my $high = unpack('n', substr($uuid, 6, 2)) & 0x0fff;"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "    my $hi = $mid | $high << 16;"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "    # MAGIC offset: 01B2-1DD2-13814000"
NSQ_SOURCE_LINE 00000609 "    if ($low >= 0x13814000) {"
NSQ_SOURCE_LINE 00000610 "        $low -= 0x13814000;"
NSQ_SOURCE_LINE 00000611 "    }"
NSQ_SOURCE_LINE 00000612 "    else {"
NSQ_SOURCE_LINE 00000613 "        $low += 0xec7ec000;"
NSQ_SOURCE_LINE 00000614 "        $hi --;"
NSQ_SOURCE_LINE 00000615 "    }"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "    if ($hi >= 0x01b21dd2) {"
NSQ_SOURCE_LINE 00000618 "        $hi -= 0x01b21dd2;"
NSQ_SOURCE_LINE 00000619 "    }"
NSQ_SOURCE_LINE 00000620 "    else {"
NSQ_SOURCE_LINE 00000621 "        $hi += 0x0e4de22e;  # wrap around"
NSQ_SOURCE_LINE 00000622 "    }"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "    $low /= 10000000.0;"
NSQ_SOURCE_LINE 00000625 "    $hi  /= 78125.0 / 512 / 65536;  # / 1000000 * 0x10000000"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "    return $hi + $low;"
NSQ_SOURCE_LINE 00000628 "}"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "*time_of_UUID = \\&time_of_uuid;"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "=item B<clk_seq_of_UUID()>, B<clk_seq_of_uuid()> (:std)"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "    my $uuid_clk_seq = clk_seq_of_UUID($uuid);"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "This function accepts UUIDs and UUID strings. Returns the clock sequence for a"
NSQ_SOURCE_LINE 00000638 "version 1 UUID. Returns C<undef> if UUID is not version 1."
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "=cut"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "sub clk_seq_of_uuid {"
NSQ_SOURCE_LINE 00000643 "    use bytes;"
NSQ_SOURCE_LINE 00000644 "    my $uuid = shift;"
NSQ_SOURCE_LINE 00000645 "    $uuid = string_to_uuid($uuid);"
NSQ_SOURCE_LINE 00000646 "    return unless version_of_uuid($uuid) == 1;"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "    my $r = unpack 'n', substr($uuid, 8, 2);"
NSQ_SOURCE_LINE 00000649 "    my $v = $r >> 13;"
NSQ_SOURCE_LINE 00000650 "    my $w = ($v >= 6) ? 3 # 11x"
NSQ_SOURCE_LINE 00000651 "          : ($v >= 4) ? 2 # 10-"
NSQ_SOURCE_LINE 00000652 "          :             1 # 0--"
NSQ_SOURCE_LINE 00000653 "          ;"
NSQ_SOURCE_LINE 00000654 "    $w = 16 - $w;"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "    return $r & ((1 << $w) - 1);"
NSQ_SOURCE_LINE 00000657 "}"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "*clk_seq_of_UUID = \\&clk_seq_of_uuid;"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "=item B<equal_UUIDs()>, B<equal_uuids()> (:std)"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "    my $bool = equal_UUIDs($uuid1, $uuid2);"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "Returns true if the provided UUIDs are equal. Accepts UUIDs and UUID strings"
NSQ_SOURCE_LINE 00000667 "(can be mixed)."
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "=cut"
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "sub equal_uuids {"
NSQ_SOURCE_LINE 00000672 "    my ($u1, $u2) = @_;"
NSQ_SOURCE_LINE 00000673 "    return unless defined $u1 && defined $u2;"
NSQ_SOURCE_LINE 00000674 "    return string_to_uuid($u1) eq string_to_uuid($u2);"
NSQ_SOURCE_LINE 00000675 "}"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "*equal_UUIDs = \\&equal_uuids;"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "#"
NSQ_SOURCE_LINE 00000681 "# Private functions ..."
NSQ_SOURCE_LINE 00000682 "#"
NSQ_SOURCE_LINE 00000683 "my $Last_Pid;"
NSQ_SOURCE_LINE 00000684 "my $Clk_Seq :shared;"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "# There is a problem with $Clk_Seq and rand() on forking a process using"
NSQ_SOURCE_LINE 00000687 "# UUID::Tiny, because the forked process would use the same basic $Clk_Seq and"
NSQ_SOURCE_LINE 00000688 "# the same seed (!) for rand(). $Clk_Seq is UUID::Tiny's problem, but with"
NSQ_SOURCE_LINE 00000689 "# rand() it is Perl's bad behavior. So _init_globals() has to be called every"
NSQ_SOURCE_LINE 00000690 "# time before using $Clk_Seq or rand() ..."
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "sub _init_globals {"
NSQ_SOURCE_LINE 00000693 "    lock $Clk_Seq;"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "    if (!defined $Last_Pid || $Last_Pid != $$) {"
NSQ_SOURCE_LINE 00000696 "        $Last_Pid = $$;"
NSQ_SOURCE_LINE 00000697 "        # $Clk_Seq = _generate_clk_seq();"
NSQ_SOURCE_LINE 00000698 "        # There's a slight chance to get the same value as $Clk_Seq ..."
NSQ_SOURCE_LINE 00000699 "        for (my $i = 0; $i <= 5; $i++) {"
NSQ_SOURCE_LINE 00000700 "            my $new_clk_seq = _generate_clk_seq();"
NSQ_SOURCE_LINE 00000701 "            if (!defined($Clk_Seq) || $new_clk_seq != $Clk_Seq) {"
NSQ_SOURCE_LINE 00000702 "                $Clk_Seq = $new_clk_seq;"
NSQ_SOURCE_LINE 00000703 "                last;"
NSQ_SOURCE_LINE 00000704 "            }"
NSQ_SOURCE_LINE 00000705 "            if ($i == 5) {"
NSQ_SOURCE_LINE 00000706 "                croak __PACKAGE__"
NSQ_SOURCE_LINE 00000707 "                    . \"::_init_globals(): Can't get unique clk_seq!\";"
NSQ_SOURCE_LINE 00000708 "            }"
NSQ_SOURCE_LINE 00000709 "        }"
NSQ_SOURCE_LINE 00000710 "        srand();"
NSQ_SOURCE_LINE 00000711 "    }"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "    return;"
NSQ_SOURCE_LINE 00000714 "}"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "my $Last_Timestamp :shared;"
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "sub _get_clk_seq {"
NSQ_SOURCE_LINE 00000719 "    my $ts = shift;"
NSQ_SOURCE_LINE 00000720 "    _init_globals();"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "    lock $Last_Timestamp;"
NSQ_SOURCE_LINE 00000723 "    lock $Clk_Seq;"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "    #if (!defined $Last_Timestamp || $ts <= $Last_Timestamp) {"
NSQ_SOURCE_LINE 00000726 "    if (defined $Last_Timestamp && $ts <= $Last_Timestamp) {"
NSQ_SOURCE_LINE 00000727 "        #$Clk_Seq = ($Clk_Seq + 1) % 65536;"
NSQ_SOURCE_LINE 00000728 "        # The old variant used modulo, but this looks unnecessary,"
NSQ_SOURCE_LINE 00000729 "        # because we should only use the significant part of the"
NSQ_SOURCE_LINE 00000730 "        # number, and that also lets the counter circle around:"
NSQ_SOURCE_LINE 00000731 "        $Clk_Seq = ($Clk_Seq + 1) & 0x3fff;"
NSQ_SOURCE_LINE 00000732 "    }"
NSQ_SOURCE_LINE 00000733 "    $Last_Timestamp = $ts;"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "    #return $Clk_Seq & 0x03ff; # no longer needed - and it was wrong too!"
NSQ_SOURCE_LINE 00000736 "    return $Clk_Seq;"
NSQ_SOURCE_LINE 00000737 "}"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "sub _generate_clk_seq {"
NSQ_SOURCE_LINE 00000740 "    my $self = shift;"
NSQ_SOURCE_LINE 00000741 "    # _init_globals();"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "    my @data;"
NSQ_SOURCE_LINE 00000744 "    push @data, ''  . $$;"
NSQ_SOURCE_LINE 00000745 "    push @data, ':' . Time::HiRes::time();"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "    # 16 bit digest"
NSQ_SOURCE_LINE 00000748 "    # We should return only the significant part of the number!"
NSQ_SOURCE_LINE 00000749 "    return (unpack 'n', _digest_as_octets(2, @data)) & 0x3fff;"
NSQ_SOURCE_LINE 00000750 "}"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "sub _random_node_id {"
NSQ_SOURCE_LINE 00000753 "    my $self = shift;"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "    my $r1 = _rand_32bit();"
NSQ_SOURCE_LINE 00000756 "    my $r2 = _rand_32bit();"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "    my $hi = ($r1 >> 8) ^ ($r2 & 0xff);"
NSQ_SOURCE_LINE 00000759 "    my $lo = ($r2 >> 8) ^ ($r1 & 0xff);"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "    $hi |= 0x80;"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "    my $id  = substr pack('V', $hi), 0, 3;"
NSQ_SOURCE_LINE 00000764 "       $id .= substr pack('V', $lo), 0, 3;"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "    return $id;"
NSQ_SOURCE_LINE 00000767 "}"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "sub _rand_32bit {"
NSQ_SOURCE_LINE 00000770 "    _init_globals();"
NSQ_SOURCE_LINE 00000771 "    my $v1 = int(rand(65536)) % 65536;"
NSQ_SOURCE_LINE 00000772 "    my $v2 = int(rand(65536)) % 65536;"
NSQ_SOURCE_LINE 00000773 "    return ($v1 << 16) | $v2;"
NSQ_SOURCE_LINE 00000774 "}"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "sub _fold_into_octets {"
NSQ_SOURCE_LINE 00000777 "    use bytes;"
NSQ_SOURCE_LINE 00000778 "    my ($num_octets, $s) = @_;"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "    my $x = \"\\x0\" x $num_octets;"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "    while (length $s > 0) {"
NSQ_SOURCE_LINE 00000783 "        my $n = '';"
NSQ_SOURCE_LINE 00000784 "        while (length $x > 0) {"
NSQ_SOURCE_LINE 00000785 "            my $c = ord(substr $x, -1, 1, '') ^ ord(substr $s, -1, 1, '');"
NSQ_SOURCE_LINE 00000786 "            $n = chr($c) . $n;"
NSQ_SOURCE_LINE 00000787 "            last if length $s <= 0;"
NSQ_SOURCE_LINE 00000788 "        }"
NSQ_SOURCE_LINE 00000789 "        $n = $x . $n;"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "        $x = $n;"
NSQ_SOURCE_LINE 00000792 "    }"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "    return $x;"
NSQ_SOURCE_LINE 00000795 "}"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "sub _digest_as_octets {"
NSQ_SOURCE_LINE 00000798 "    my $num_octets = shift;"
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "    $MD5_CALCULATOR->reset();"
NSQ_SOURCE_LINE 00000801 "    $MD5_CALCULATOR->add($_) for @_;"
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "    return _fold_into_octets($num_octets, $MD5_CALCULATOR->digest);"
NSQ_SOURCE_LINE 00000804 "}"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "=back"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "=cut"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "=head1 DISCUSSION"
NSQ_SOURCE_LINE 00000813 ""
NSQ_SOURCE_LINE 00000814 "=over"
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 "=item B<Why version 1 only with random multi-cast MAC addresses?>"
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "The random multi-cast MAC address gives privacy, and getting the real MAC"
NSQ_SOURCE_LINE 00000819 "address with Perl is really dirty (and slow);"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "=item B<Should version 3 or version 5 be used?>"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "Using SHA-1 reduces the probability of collisions and provides a better"
NSQ_SOURCE_LINE 00000824 "\"randomness\" of the resulting UUID compared to MD5. Version 5 is recommended"
NSQ_SOURCE_LINE 00000825 "in RFC 4122 if backward compatibility is not an issue."
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "Using MD5 (version 3) has a better performance. This could be important with"
NSQ_SOURCE_LINE 00000828 "creating UUIDs from file content rather than names."
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "=back"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "=head1 UUID DEFINITION"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "See RFC 4122 (L<http://www.ietf.org/rfc/rfc4122.txt>) for technical details on"
NSQ_SOURCE_LINE 00000836 "UUIDs. Wikipedia gives a more palatable description at"
NSQ_SOURCE_LINE 00000837 "L<http://en.wikipedia.org/wiki/Universally_unique_identifier>."
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "Christian Augustin, C<< <mail at caugustin.de> >>"
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "=head1 CONTRIBUTORS"
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "Some of this code is based on UUID::Generator by ITO Nobuaki"
NSQ_SOURCE_LINE 00000848 "E<lt>banb@cpan.orgE<gt>. But that module is announced to be marked as"
NSQ_SOURCE_LINE 00000849 "\"deprecated\" in the future and it is much too complicated for my liking."
NSQ_SOURCE_LINE 00000850 ""
NSQ_SOURCE_LINE 00000851 "So I decided to reduce it to the necessary parts and to re-implement those"
NSQ_SOURCE_LINE 00000852 "parts with a functional interface ..."
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "Jesse Vincent, C<< <jesse at bestpractical.com> >>, improved version 1.02 with"
NSQ_SOURCE_LINE 00000855 "his tips and a heavy refactoring."
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "Michael G. Schwern provided a patch for better thread support (as far as"
NSQ_SOURCE_LINE 00000858 "UUID::Tiny can be improved itself) that is incorporated in version 1.04. "
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 ""
