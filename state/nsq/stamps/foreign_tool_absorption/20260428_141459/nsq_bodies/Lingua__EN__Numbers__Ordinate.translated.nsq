BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Lingua::EN::Numbers::Ordinate;"
NSQ_SOURCE_LINE 00000002 "$Lingua::EN::Numbers::Ordinate::VERSION = '1.05';"
NSQ_SOURCE_LINE 00000003 "# ABSTRACT: go from cardinal number (3) to ordinal (\"3rd\")"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use 5.006;"
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 "require Exporter;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our @ISA        = qw/ Exporter  /;"
NSQ_SOURCE_LINE 00000011 "our @EXPORT     = qw/ ordinate  /;"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK  = qw/ ordsuf th /;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "###########################################################################"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "=head1 NAME"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "Lingua::EN::Numbers::Ordinate -- go from cardinal number (3) to ordinal (\"3rd\")"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "  use Lingua::EN::Numbers::Ordinate;"
NSQ_SOURCE_LINE 00000023 "  print ordinate(4), \"\\n\";"
NSQ_SOURCE_LINE 00000024 "   # prints 4th"
NSQ_SOURCE_LINE 00000025 "  print ordinate(-342), \"\\n\";"
NSQ_SOURCE_LINE 00000026 "   # prints -342nd"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "  # Example of actual use:"
NSQ_SOURCE_LINE 00000029 "  ..."
NSQ_SOURCE_LINE 00000030 "  for(my $i = 0; $i < @records; $i++) {"
NSQ_SOURCE_LINE 00000031 "    unless(is_valid($record[$i]) {"
NSQ_SOURCE_LINE 00000032 "      warn \"The \", ordinate($i), \" record is invalid!\\n\"; "
NSQ_SOURCE_LINE 00000033 "      next;"
NSQ_SOURCE_LINE 00000034 "    }"
NSQ_SOURCE_LINE 00000035 "    ..."
NSQ_SOURCE_LINE 00000036 "  }"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "There are two kinds of numbers in English -- cardinals (1, 2, 3...), and"
NSQ_SOURCE_LINE 00000041 "ordinals (1st, 2nd, 3rd...).  This library provides functions for giving"
NSQ_SOURCE_LINE 00000042 "the ordinal form of a number, given its cardinal value."
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=over"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "=item ordinate(SCALAR)"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "Returns a string consisting of that scalar's string form, plus the"
NSQ_SOURCE_LINE 00000051 "appropriate ordinal suffix.  Example: C<ordinate(23)> returns \"23rd\"."
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "As a special case, C<ordinate(undef)> and C<ordinate(\"\")> return \"0th\","
NSQ_SOURCE_LINE 00000054 "not \"th\"."
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "This function is exported by default."
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "=item th(SCALAR)"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "Merely an alias for C<ordinate>, but not exported by default."
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "=item ordsuf(SCALAR)"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "Returns just the appropriate ordinal suffix for the given scalar"
NSQ_SOURCE_LINE 00000065 "numeric value.  This is what C<ordinate> uses to actually do its"
NSQ_SOURCE_LINE 00000066 "work.  For example, C<ordsuf(3)> is \"rd\". "
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "Not exported by default."
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=back"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "The above functions are all prototyped to take a scalar value,"
NSQ_SOURCE_LINE 00000073 "so C<ordinate(@stuff)> is the same as C<ordinate(scalar @stuff)>."
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "* Note that this library knows only about numbers, not number-words."
NSQ_SOURCE_LINE 00000079 "C<ordinate('seven')> might just as well be C<ordinate('superglue')>"
NSQ_SOURCE_LINE 00000080 "or C<ordinate(\"\\x1E\\x9A\")> -- you'll get the fallthru case of the input"
NSQ_SOURCE_LINE 00000081 "string plus \"th\"."
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "* As is unavoidable, C<ordinate(0256)> returns \"174th\" (because ordinate"
NSQ_SOURCE_LINE 00000084 "sees the value 174). Similarly, C<ordinate(1E12)> returns"
NSQ_SOURCE_LINE 00000085 "\"1000000000000th\".  Returning \"trillionth\" would be nice, but that's an"
NSQ_SOURCE_LINE 00000086 "awfully atypical case."
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "* Note that this library's algorithm (as well as the basic concept"
NSQ_SOURCE_LINE 00000089 "and implementation of ordinal numbers) is totally language specific."
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "To pick a trivial example, consider that in French, 1 ordinates"
NSQ_SOURCE_LINE 00000092 "as \"1ier\", whereas 41 ordinates as \"41ieme\"."
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "L<Lingua::EN::Inflect> provides an C<ORD> function,"
NSQ_SOURCE_LINE 00000098 "which returns the ordinal form of a cardinal number."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "L<Lingua::EN::Number::IsOrdinal> provides an C<is_ordinal>"
NSQ_SOURCE_LINE 00000101 "function, which returns true if passed an ordinal number."
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "L<Lingua::EN::Numbers> provides function C<num2en_ordinal()>"
NSQ_SOURCE_LINE 00000104 "which will take a number and return the ordinal as a word."
NSQ_SOURCE_LINE 00000105 "So 3 will result in \"third\"."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=head1 REPOSITORY"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "L<https://github.com/neilb/Lingua-EN-Numbers-Ordinate>"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=head1 COPYRIGHT"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "Copyright (c) 2000 Sean M. Burke.  All rights reserved."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "This library is free software; you can redistribute it and/or"
NSQ_SOURCE_LINE 00000116 "modify it under the same terms as Perl itself."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "Sean M. Burke C<sburke@cpan.org>"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "This has been maintained by Neil Bowers (NEILB)"
NSQ_SOURCE_LINE 00000123 "since 2014."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=cut"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "###########################################################################"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "sub ordsuf ($) {"
NSQ_SOURCE_LINE 00000130 "  return 'th' if not(defined($_[0])) or $_[0] !~ /^-?[0-9]+$/;"
NSQ_SOURCE_LINE 00000131 "   # 'th' for undef, 0, or anything non-number."
NSQ_SOURCE_LINE 00000132 "  my $n = abs($_[0]);  # Throw away the sign."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "  $n %= 100;"
NSQ_SOURCE_LINE 00000135 "  return 'th' if $n == 11 or $n == 12 or $n == 13;"
NSQ_SOURCE_LINE 00000136 "  $n %= 10;"
NSQ_SOURCE_LINE 00000137 "  return 'st' if $n == 1; "
NSQ_SOURCE_LINE 00000138 "  return 'nd' if $n == 2;"
NSQ_SOURCE_LINE 00000139 "  return 'rd' if $n == 3;"
NSQ_SOURCE_LINE 00000140 "  return 'th';"
NSQ_SOURCE_LINE 00000141 "}"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "sub ordinate ($) {"
NSQ_SOURCE_LINE 00000144 "  my $i = $_[0] || 0;"
NSQ_SOURCE_LINE 00000145 "  return $i . ordsuf($i);"
NSQ_SOURCE_LINE 00000146 "}"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "no warnings 'all';"
NSQ_SOURCE_LINE 00000149 "*th = \\&ordinate; # correctly copies the prototype, too."
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "###########################################################################"
NSQ_SOURCE_LINE 00000152 "1;"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "__END__"
BODY_END
