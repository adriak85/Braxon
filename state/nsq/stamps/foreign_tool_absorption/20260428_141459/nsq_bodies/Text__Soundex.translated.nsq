NSQ_SOURCE_LINE 00000009 "# incorporate them into later versions."
NSQ_SOURCE_LINE 00000010 "#"
NSQ_SOURCE_LINE 00000011 "#      - Mark Mielke <mark@mielke.cc>"
NSQ_SOURCE_LINE 00000012 "#"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "package Text::Soundex;"
NSQ_SOURCE_LINE 00000015 "require 5.006;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "use Exporter ();"
NSQ_SOURCE_LINE 00000018 "use XSLoader ();"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "use strict;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "use if $] > 5.016, 'deprecate';"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "our $VERSION   = '3.05';"
NSQ_SOURCE_LINE 00000025 "our @EXPORT_OK = qw(soundex soundex_unicode soundex_nara soundex_nara_unicode"
NSQ_SOURCE_LINE 00000026 "                    $soundex_nocode);"
NSQ_SOURCE_LINE 00000027 "our @EXPORT    = qw(soundex soundex_nara $soundex_nocode);"
NSQ_SOURCE_LINE 00000028 "our @ISA       = qw(Exporter);"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "our $nocode;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "# Previous releases of Text::Soundex made $nocode available as $soundex_nocode."
NSQ_SOURCE_LINE 00000033 "# For now, this part of the interface is exported and maintained."
NSQ_SOURCE_LINE 00000034 "# In the feature, $soundex_nocode will be deprecated."
NSQ_SOURCE_LINE 00000035 "*Text::Soundex::soundex_nocode = \\$nocode;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub soundex_noxs"
NSQ_SOURCE_LINE 00000038 "{"
NSQ_SOURCE_LINE 00000039 "    # Original Soundex algorithm"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    my @results = map {"
NSQ_SOURCE_LINE 00000042 "        my $code = uc($_);"
NSQ_SOURCE_LINE 00000043 "        $code =~ tr/AaEeHhIiOoUuWwYyBbFfPpVvCcGgJjKkQqSsXxZzDdTtLlMmNnRr//cd;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "\tif (length($code)) {"
NSQ_SOURCE_LINE 00000046 "            my $firstchar = substr($code, 0, 1);"
NSQ_SOURCE_LINE 00000047 "\t    $code =~ tr[AaEeHhIiOoUuWwYyBbFfPpVvCcGgJjKkQqSsXxZzDdTtLlMmNnRr]"
NSQ_SOURCE_LINE 00000048 "                       [0000000000000000111111112222222222222222333344555566]s;"
NSQ_SOURCE_LINE 00000049 "\t    ($code = substr($code, 1)) =~ tr/0//d;"
NSQ_SOURCE_LINE 00000050 "\t    substr($firstchar . $code . '000', 0, 4);"
NSQ_SOURCE_LINE 00000051 "\t} else {"
NSQ_SOURCE_LINE 00000052 "\t    $nocode;"
NSQ_SOURCE_LINE 00000053 "\t}"
NSQ_SOURCE_LINE 00000054 "    } @_;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    wantarray ? @results : $results[0];"
NSQ_SOURCE_LINE 00000057 "}"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "sub soundex_nara"
NSQ_SOURCE_LINE 00000060 "{"
NSQ_SOURCE_LINE 00000061 "    # US census (NARA) algorithm."
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    my @results = map {"
NSQ_SOURCE_LINE 00000064 "\tmy $code = uc($_);"
NSQ_SOURCE_LINE 00000065 "        $code =~ tr/AaEeHhIiOoUuWwYyBbFfPpVvCcGgJjKkQqSsXxZzDdTtLlMmNnRr//cd;"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "\tif (length($code)) {"
NSQ_SOURCE_LINE 00000068 "            my $firstchar = substr($code, 0, 1);"
NSQ_SOURCE_LINE 00000069 "\t    $code =~ tr[AaEeHhIiOoUuWwYyBbFfPpVvCcGgJjKkQqSsXxZzDdTtLlMmNnRr]"
NSQ_SOURCE_LINE 00000070 "                       [0000990000009900111111112222222222222222333344555566]s;"
NSQ_SOURCE_LINE 00000071 "            $code =~ s/(.)9\\1/$1/gs;"
NSQ_SOURCE_LINE 00000072 "\t    ($code = substr($code, 1)) =~ tr/09//d;"
NSQ_SOURCE_LINE 00000073 "\t    substr($firstchar . $code . '000', 0, 4);"
NSQ_SOURCE_LINE 00000074 "\t} else {"
NSQ_SOURCE_LINE 00000075 "\t    $nocode"
NSQ_SOURCE_LINE 00000076 "\t}"
NSQ_SOURCE_LINE 00000077 "    } @_;"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    wantarray ? @results : $results[0];"
NSQ_SOURCE_LINE 00000080 "}"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "sub soundex_unicode"
NSQ_SOURCE_LINE 00000083 "{"
NSQ_SOURCE_LINE 00000084 "    require Text::Unidecode unless defined &Text::Unidecode::unidecode;"
NSQ_SOURCE_LINE 00000085 "    soundex(Text::Unidecode::unidecode(@_));"
NSQ_SOURCE_LINE 00000086 "}"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "sub soundex_nara_unicode"
NSQ_SOURCE_LINE 00000089 "{"
NSQ_SOURCE_LINE 00000090 "    require Text::Unidecode unless defined &Text::Unidecode::unidecode;"
NSQ_SOURCE_LINE 00000091 "    soundex_nara(Text::Unidecode::unidecode(@_));"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "eval { XSLoader::load(__PACKAGE__, $VERSION) };"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "if (defined(&soundex_xs)) {"
NSQ_SOURCE_LINE 00000097 "    *soundex = \\&soundex_xs;"
NSQ_SOURCE_LINE 00000098 "} else {"
NSQ_SOURCE_LINE 00000099 "    *soundex = \\&soundex_noxs;"
NSQ_SOURCE_LINE 00000100 "    *soundex_xs = sub {"
NSQ_SOURCE_LINE 00000101 "        require Carp;"
NSQ_SOURCE_LINE 00000102 "        Carp::croak(\"XS implementation of Text::Soundex::soundex_xs() \"."
NSQ_SOURCE_LINE 00000103 "                    \"could not be loaded\");"
NSQ_SOURCE_LINE 00000104 "    };"
NSQ_SOURCE_LINE 00000105 "}"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "1;"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "__END__"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "# Implementation of the soundex algorithm."
NSQ_SOURCE_LINE 00000112 "#"
NSQ_SOURCE_LINE 00000113 "# Some of this documention was written by Mike Stok."
NSQ_SOURCE_LINE 00000114 "#"
NSQ_SOURCE_LINE 00000115 "# Examples:"
NSQ_SOURCE_LINE 00000116 "#"
NSQ_SOURCE_LINE 00000117 "# Euler, Ellery -> E460"
NSQ_SOURCE_LINE 00000118 "# Gauss, Ghosh -> G200"
NSQ_SOURCE_LINE 00000119 "# Hilbert, Heilbronn -> H416"
NSQ_SOURCE_LINE 00000120 "# Knuth, Kant -> K530"
NSQ_SOURCE_LINE 00000121 "# Lloyd, Ladd -> L300"
NSQ_SOURCE_LINE 00000122 "# Lukasiewicz, Lissajous -> L222"
NSQ_SOURCE_LINE 00000123 "#"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 NAME"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "Text::Soundex - Implementation of the soundex algorithm."
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "  use Text::Soundex;"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "  # Original algorithm."
NSQ_SOURCE_LINE 00000134 "  $code = soundex($name);    # Get the soundex code for a name."
NSQ_SOURCE_LINE 00000135 "  @codes = soundex(@names);  # Get the list of codes for a list of names."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "  # American Soundex variant (NARA) - Used for US census data."
NSQ_SOURCE_LINE 00000138 "  $code = soundex_nara($name);    # Get the soundex code for a name."
NSQ_SOURCE_LINE 00000139 "  @codes = soundex_nara(@names);  # Get the list of codes for a list of names."
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "  # Redefine the value that soundex() will return if the input string"
NSQ_SOURCE_LINE 00000142 "  # contains no identifiable sounds within it."
NSQ_SOURCE_LINE 00000143 "  $Text::Soundex::nocode = 'Z000';"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "Soundex is a phonetic algorithm for indexing names by sound, as"
NSQ_SOURCE_LINE 00000148 "pronounced in English. The goal is for names with the same"
NSQ_SOURCE_LINE 00000149 "pronunciation to be encoded to the same representation so that they"
NSQ_SOURCE_LINE 00000150 "can be matched despite minor differences in spelling. Soundex is the"
NSQ_SOURCE_LINE 00000151 "most widely known of all phonetic algorithms and is often used"
NSQ_SOURCE_LINE 00000152 "(incorrectly) as a synonym for \"phonetic algorithm\". Improvements to"
NSQ_SOURCE_LINE 00000153 "Soundex are the basis for many modern phonetic algorithms. (Wikipedia,"
NSQ_SOURCE_LINE 00000154 "2007)"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "This module implements the original soundex algorithm developed by"
NSQ_SOURCE_LINE 00000157 "Robert Russell and Margaret Odell, patented in 1918 and 1922, as well"
NSQ_SOURCE_LINE 00000158 "as a variation called \"American Soundex\" used for US census data, and"
NSQ_SOURCE_LINE 00000159 "current maintained by the National Archives and Records Administration"
NSQ_SOURCE_LINE 00000160 "(NARA)."
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "The soundex algorithm may be recognized from Donald Knuth's"
NSQ_SOURCE_LINE 00000163 "B<The Art of Computer Programming>. The algorithm described by"
NSQ_SOURCE_LINE 00000164 "Knuth is the NARA algorithm."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "The value returned for strings which have no soundex encoding is"
NSQ_SOURCE_LINE 00000167 "defined using C<$Text::Soundex::nocode>. The default value is C<undef>,"
NSQ_SOURCE_LINE 00000168 "however values such as C<'Z000'> are commonly used alternatives."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "For backward compatibility with older versions of this module the"
NSQ_SOURCE_LINE 00000171 "C<$Text::Soundex::nocode> is exported into the caller's namespace as"
NSQ_SOURCE_LINE 00000172 "C<$soundex_nocode>."
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "In scalar context, C<soundex()> returns the soundex code of its first"
NSQ_SOURCE_LINE 00000175 "argument. In list context, a list is returned in which each element is the"
NSQ_SOURCE_LINE 00000176 "soundex code for the corresponding argument passed to C<soundex()>. For"
NSQ_SOURCE_LINE 00000177 "example, the following code assigns @codes the value C<('M200', 'S320')>:"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "   @codes = soundex qw(Mike Stok);"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "To use C<Text::Soundex> to generate codes that can be used to search one"
NSQ_SOURCE_LINE 00000182 "of the publically available US Censuses, a variant of the soundex"
NSQ_SOURCE_LINE 00000183 "algorithm must be used:"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "    use Text::Soundex;"
NSQ_SOURCE_LINE 00000186 "    $code = soundex_nara($name);"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "An example of where these algorithm differ follows:"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    use Text::Soundex;"
NSQ_SOURCE_LINE 00000191 "    print soundex(\"Ashcraft\"), \"\\n\";       # prints: A226"
NSQ_SOURCE_LINE 00000192 "    print soundex_nara(\"Ashcraft\"), \"\\n\";  # prints: A261"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "Donald Knuth's examples of names and the soundex codes they map to"
NSQ_SOURCE_LINE 00000197 "are listed below:"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "  Euler, Ellery -> E460"
NSQ_SOURCE_LINE 00000200 "  Gauss, Ghosh -> G200"
NSQ_SOURCE_LINE 00000201 "  Hilbert, Heilbronn -> H416"
NSQ_SOURCE_LINE 00000202 "  Knuth, Kant -> K530"
NSQ_SOURCE_LINE 00000203 "  Lloyd, Ladd -> L300"
NSQ_SOURCE_LINE 00000204 "  Lukasiewicz, Lissajous -> L222"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "so:"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "  $code = soundex 'Knuth';         # $code contains 'K530'"
NSQ_SOURCE_LINE 00000209 "  @list = soundex qw(Lloyd Gauss); # @list contains 'L300', 'G200'"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "As the soundex algorithm was originally used a B<long> time ago in the US"
NSQ_SOURCE_LINE 00000214 "it considers only the English alphabet and pronunciation. In particular,"
NSQ_SOURCE_LINE 00000215 "non-ASCII characters will be ignored. The recommended method of dealing"
NSQ_SOURCE_LINE 00000216 "with characters that have accents, or other unicode characters, is to use"
NSQ_SOURCE_LINE 00000217 "the Text::Unidecode module available from CPAN. Either use the module"
NSQ_SOURCE_LINE 00000218 "explicitly:"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "    use Text::Soundex;"
NSQ_SOURCE_LINE 00000221 "    use Text::Unidecode;"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "    print soundex(unidecode(\"Fran\\xE7ais\")), \"\\n\"; # Prints \"F652\\n\""
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "Or use the convenient wrapper routine:"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    use Text::Soundex 'soundex_unicode';"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "    print soundex_unicode(\"Fran\\xE7ais\"), \"\\n\";    # Prints \"F652\\n\""
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "Since the soundex algorithm maps a large space (strings of arbitrary"
NSQ_SOURCE_LINE 00000232 "length) onto a small space (single letter plus 3 digits) no inference"
NSQ_SOURCE_LINE 00000233 "can be made about the similarity of two strings which end up with the"
NSQ_SOURCE_LINE 00000234 "same soundex code.  For example, both C<Hilbert> and C<Heilbronn> end"
NSQ_SOURCE_LINE 00000235 "up with a soundex code of C<H416>."
NSQ_SOURCE_LINE 00000236 ""
