NSQ_SOURCE_LINE 00000029 "has log              => sub {"
NSQ_SOURCE_LINE 00000030 "  my $self = shift;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "  # Reduced log output outside of development mode"
NSQ_SOURCE_LINE 00000033 "  my $log = Mojo::Log->new;"
NSQ_SOURCE_LINE 00000034 "  return $log->level($ENV{MOJO_LOG_LEVEL}) if $ENV{MOJO_LOG_LEVEL};"
NSQ_SOURCE_LINE 00000035 "  return $self->mode eq 'development' ? $log : $log->level('info');"
NSQ_SOURCE_LINE 00000036 "};"
