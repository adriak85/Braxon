NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "our $CODENAME = 'Waffle';"
NSQ_SOURCE_LINE 00000060 "our $VERSION  = '9.42';"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "sub BUILD_DYNAMIC {"
NSQ_SOURCE_LINE 00000063 "  my ($class, $method, $dyn_methods) = @_;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "  return sub {"
NSQ_SOURCE_LINE 00000066 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000067 "    my $dynamic = $dyn_methods->{$self->renderer}{$method};"
NSQ_SOURCE_LINE 00000068 "    return $self->build_controller->$dynamic(@_) if $dynamic;"
NSQ_SOURCE_LINE 00000069 "    my $package = ref $self;"
NSQ_SOURCE_LINE 00000070 "    Carp::croak qq{Can't locate object method \"$method\" via package \"$package\"};"
NSQ_SOURCE_LINE 00000071 "  };"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub build_controller {"
NSQ_SOURCE_LINE 00000075 "  my ($self, $tx) = @_;"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "  # Embedded application"
NSQ_SOURCE_LINE 00000078 "  my $stash = {};"
NSQ_SOURCE_LINE 00000079 "  if ($tx && (my $sub = $tx->can('stash'))) { ($stash, $tx) = ($tx->$sub, $tx->tx) }"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "  # Build default controller"
NSQ_SOURCE_LINE 00000082 "  my $defaults = $self->defaults;"
NSQ_SOURCE_LINE 00000083 "  @$stash{keys %$defaults} = values %$defaults;"
NSQ_SOURCE_LINE 00000084 "  my $c = $self->controller_class->new(app => $self, stash => $stash, tx => $tx);"
NSQ_SOURCE_LINE 00000085 "  $c->{tx} ||= $self->build_tx;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "  return $c;"
NSQ_SOURCE_LINE 00000088 "}"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "sub build_tx {"
NSQ_SOURCE_LINE 00000091 "  my $self = shift;"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "  my $tx  = Mojo::Transaction::HTTP->new;"
NSQ_SOURCE_LINE 00000094 "  my $max = $self->max_request_size;"
NSQ_SOURCE_LINE 00000095 "  $tx->req->max_message_size($max) if defined $max;"
NSQ_SOURCE_LINE 00000096 "  $self->plugins->emit_hook(after_build_tx => $tx, $self);"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "  return $tx;"
NSQ_SOURCE_LINE 00000099 "}"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "sub config   { Mojo::Util::_stash(config   => @_) }"
NSQ_SOURCE_LINE 00000102 "sub defaults { Mojo::Util::_stash(defaults => @_) }"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub dispatch {"
NSQ_SOURCE_LINE 00000105 "  my ($self, $c) = @_;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "  my $plugins = $self->plugins->emit_hook(before_dispatch => $c);"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "  my $stash = $c->stash;"
NSQ_SOURCE_LINE 00000110 "  return if $stash->{'mojo.rendered'};"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "  # Try to find a static file"
NSQ_SOURCE_LINE 00000113 "  my $tx = $c->tx;"
NSQ_SOURCE_LINE 00000114 "  $self->static->dispatch($c) and $plugins->emit_hook(after_static => $c) unless $tx->res->code;"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "  # Start timer (ignore static files)"
NSQ_SOURCE_LINE 00000117 "  $c->helpers->log->trace(sub {"
NSQ_SOURCE_LINE 00000118 "    my $req    = $c->req;"
NSQ_SOURCE_LINE 00000119 "    my $method = $req->method;"
NSQ_SOURCE_LINE 00000120 "    my $path   = $req->url->path->to_abs_string;"
NSQ_SOURCE_LINE 00000121 "    $c->helpers->timing->begin('mojo.timer');"
NSQ_SOURCE_LINE 00000122 "    return qq{$method \"$path\"};"
NSQ_SOURCE_LINE 00000123 "  }) unless $stash->{'mojo.static'};"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "  # Routes"
NSQ_SOURCE_LINE 00000126 "  $plugins->emit_hook(before_routes => $c);"
NSQ_SOURCE_LINE 00000127 "  $c->helpers->reply->not_found unless $tx->res->code || $self->routes->dispatch($c) || $tx->res->code;"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "sub handler {"
NSQ_SOURCE_LINE 00000131 "  my $self = shift;"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "  # Dispatcher has to be last in the chain"
NSQ_SOURCE_LINE 00000134 "  ++$self->{dispatch}"
NSQ_SOURCE_LINE 00000135 "    and $self->hook(around_action   => \\&_action)"
NSQ_SOURCE_LINE 00000136 "    and $self->hook(around_dispatch => sub { $_[1]->app->dispatch($_[1]) })"
NSQ_SOURCE_LINE 00000137 "    unless $self->{dispatch};"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "  # Process with chain"
NSQ_SOURCE_LINE 00000140 "  my $c = $self->build_controller(@_);"
NSQ_SOURCE_LINE 00000141 "  $self->plugins->emit_chain(around_dispatch => $c);"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "  # Delayed response"
NSQ_SOURCE_LINE 00000144 "  $c->helpers->log->trace('Nothing has been rendered, expecting delayed response (see FAQ for more)')"
NSQ_SOURCE_LINE 00000145 "    unless $c->stash->{'mojo.rendered'};"
NSQ_SOURCE_LINE 00000146 "}"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "sub helper { shift->renderer->add_helper(@_) }"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "sub hook { shift->plugins->on(@_) }"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "sub new {"
NSQ_SOURCE_LINE 00000153 "  my $self = shift->SUPER::new((ref $_[0] ? %{shift()} : @_), @Mojo::Server::ARGS_OVERRIDE);"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "  my $home = $self->home;"
NSQ_SOURCE_LINE 00000156 "  push @{$self->renderer->paths}, $home->child('templates')->to_string;"
NSQ_SOURCE_LINE 00000157 "  push @{$self->static->paths},   $home->child('public')->to_string;"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "  # Default to controller and application namespace"
NSQ_SOURCE_LINE 00000160 "  my $controller = \"@{[ref $self]}::Controller\";"
NSQ_SOURCE_LINE 00000161 "  my $r          = $self->preload_namespaces([$controller])->routes->namespaces([$controller, ref $self]);"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "  $self->plugin($_) for qw(HeaderCondition DefaultHelpers TagHelpers EPLRenderer EPRenderer);"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "  # Exception handling should be first in chain"
NSQ_SOURCE_LINE 00000166 "  $self->hook(around_dispatch => \\&_exception);"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "  $self->startup;"
NSQ_SOURCE_LINE 00000169 "  $self->warmup;"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "  return $self;"
NSQ_SOURCE_LINE 00000172 "}"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "sub plugin {"
NSQ_SOURCE_LINE 00000175 "  my $self = shift;"
NSQ_SOURCE_LINE 00000176 "  $self->plugins->register_plugin(shift, $self, @_);"
NSQ_SOURCE_LINE 00000177 "}"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "sub server { $_[0]->plugins->emit_hook(before_server_start => @_[1, 0]) }"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "sub start {"
NSQ_SOURCE_LINE 00000182 "  my $self = shift;"
NSQ_SOURCE_LINE 00000183 "  $_->warmup for $self->static, $self->renderer;"
NSQ_SOURCE_LINE 00000184 "  return $self->commands->run(@_ ? @_ : @ARGV);"
NSQ_SOURCE_LINE 00000185 "}"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "sub startup { }"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "sub warmup { Mojo::Loader::load_classes $_ for @{shift->preload_namespaces} }"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "sub _action {"
NSQ_SOURCE_LINE 00000192 "  my ($next, $c, $action, $last) = @_;"
NSQ_SOURCE_LINE 00000193 "  my $val = $action->($c);"
NSQ_SOURCE_LINE 00000194 "  $val->catch(sub { $c->helpers->reply->exception(shift) }) if Scalar::Util::blessed $val && $val->isa('Mojo::Promise');"
NSQ_SOURCE_LINE 00000195 "  return $val;"
NSQ_SOURCE_LINE 00000196 "}"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "sub _die { CORE::die ref $_[0] ? $_[0] : Mojo::Exception->new(shift)->trace }"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "sub _exception {"
NSQ_SOURCE_LINE 00000201 "  my ($next, $c) = @_;"
NSQ_SOURCE_LINE 00000202 "  local $SIG{__DIE__} = \\&_die;"
NSQ_SOURCE_LINE 00000203 "  $c->helpers->reply->exception($@) unless eval { $next->(); 1 };"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "1;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "=encoding utf8"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head1 NAME"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "Mojolicious - Real-time web framework"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "  # Application"
NSQ_SOURCE_LINE 00000217 "  package MyApp;"
NSQ_SOURCE_LINE 00000218 "  use Mojo::Base 'Mojolicious', -signatures;"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "  # Route"
NSQ_SOURCE_LINE 00000221 "  sub startup ($self) {"
NSQ_SOURCE_LINE 00000222 "    $self->routes->get('/hello')->to('foo#hello');"
NSQ_SOURCE_LINE 00000223 "  }"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "  # Controller"
NSQ_SOURCE_LINE 00000226 "  package MyApp::Controller::Foo;"
NSQ_SOURCE_LINE 00000227 "  use Mojo::Base 'Mojolicious::Controller', -signatures;"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "  # Action"
NSQ_SOURCE_LINE 00000230 "  sub hello ($self) {"
NSQ_SOURCE_LINE 00000231 "    $self->render(text => 'Hello World!');"
NSQ_SOURCE_LINE 00000232 "  }"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "An amazing real-time web framework built on top of the powerful L<Mojo> web development toolkit. With support for"
NSQ_SOURCE_LINE 00000237 "RESTful routes, plugins, commands, Perl-ish templates, content negotiation, session management, form validation,"
NSQ_SOURCE_LINE 00000238 "testing framework, static file server, C<CGI>/C<PSGI> detection, first class Unicode support and much more for you to"
NSQ_SOURCE_LINE 00000239 "discover."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "Take a look at our excellent documentation in L<Mojolicious::Guides>!"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head1 HOOKS"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "L<Mojolicious> will emit the following hooks in the listed order."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head2 before_command"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "Emitted right before the application runs a command through the command line interface."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "  $app->hook(before_command => sub ($command, $args) {...});"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "Useful for reconfiguring the application before running a command or to modify the behavior of a command. (Passed the"
NSQ_SOURCE_LINE 00000254 "command object and the command arguments)"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=head2 before_server_start"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "Emitted right before the application server is started, for web servers that support it, which includes all the"
NSQ_SOURCE_LINE 00000259 "built-in ones."
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "  $app->hook(before_server_start => sub ($server, $app) {...});"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "Useful for reconfiguring application servers dynamically or collecting server diagnostics information. (Passed the"
NSQ_SOURCE_LINE 00000264 "server and application objects)"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=head2 after_build_tx"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "Emitted right after the transaction is built and before the HTTP request gets parsed."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "  $app->hook(after_build_tx => sub ($tx, $app) {...});"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "This is a very powerful hook and should not be used lightly, it makes some rather advanced features such as upload"
NSQ_SOURCE_LINE 00000273 "progress bars possible. Note that this hook will not work for embedded applications, because only the host application"
NSQ_SOURCE_LINE 00000274 "gets to build transactions. (Passed the transaction and application objects)"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "=head2 around_dispatch"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "Emitted right after a new request has been received and wraps around the whole dispatch process, so you have to"
NSQ_SOURCE_LINE 00000279 "manually forward to the next hook if you want to continue the chain. Default exception handling with"
NSQ_SOURCE_LINE 00000280 "L<Mojolicious::Plugin::DefaultHelpers/\"reply-E<gt>exception\"> is the first hook in the chain and a call to"
NSQ_SOURCE_LINE 00000281 "L</\"dispatch\"> the last, yours will be in between."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "  $app->hook(around_dispatch => sub ($next, $c) {"
NSQ_SOURCE_LINE 00000284 "    ..."
NSQ_SOURCE_LINE 00000285 "    $next->();"
NSQ_SOURCE_LINE 00000286 "    ..."
NSQ_SOURCE_LINE 00000287 "  });"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "This is a very powerful hook and should not be used lightly, it allows you to, for example, customize application-wide"
NSQ_SOURCE_LINE 00000290 "exception handling, consider it the sledgehammer in your toolbox. (Passed a callback leading to the next hook and the"
NSQ_SOURCE_LINE 00000291 "default controller object)"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=head2 before_dispatch"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "Emitted right before the static file server and router start their work."
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "  $app->hook(before_dispatch => sub ($c) {...});"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "Very useful for rewriting incoming requests and other preprocessing tasks. (Passed the default controller object)"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=head2 after_static"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "Emitted after a static file response has been generated by the static file server."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "  $app->hook(after_static => sub ($c) {...});"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "Mostly used for post-processing static file responses. (Passed the default controller object)"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head2 before_routes"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "Emitted after the static file server determined if a static file should be served and before the router starts its"
NSQ_SOURCE_LINE 00000312 "work."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "  $app->hook(before_routes => sub ($c) {...});"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "Mostly used for custom dispatchers and collecting metrics. (Passed the default controller object)"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=head2 around_action"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "Emitted right before an action gets executed and wraps around it, so you have to manually forward to the next hook if"
NSQ_SOURCE_LINE 00000321 "you want to continue the chain. Default action dispatching is the last hook in the chain, yours will run before it."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "  $app->hook(around_action => sub ($next, $c, $action, $last) {"
NSQ_SOURCE_LINE 00000324 "    ..."
NSQ_SOURCE_LINE 00000325 "    return $next->();"
NSQ_SOURCE_LINE 00000326 "  });"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "This is a very powerful hook and should not be used lightly, it allows you for example to pass additional arguments to"
NSQ_SOURCE_LINE 00000329 "actions or handle return values differently. Note that this hook can trigger more than once for the same request if"
NSQ_SOURCE_LINE 00000330 "there are nested routes. (Passed a callback leading to the next hook, the current controller object, the action"
NSQ_SOURCE_LINE 00000331 "callback and a flag indicating if this action is an endpoint)"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "=head2 before_render"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "Emitted before content is generated by the renderer. Note that this hook can trigger out of order due to its dynamic"
NSQ_SOURCE_LINE 00000336 "nature, and with embedded applications will only work for the application that is rendering."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "  $app->hook(before_render => sub ($c, $args) {...});"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "Mostly used for pre-processing arguments passed to the renderer. (Passed the current controller object and the render"
NSQ_SOURCE_LINE 00000341 "arguments)"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "=head2 after_render"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "Emitted after content has been generated by the renderer that will be assigned to the response. Note that this hook can"
NSQ_SOURCE_LINE 00000346 "trigger out of order due to its dynamic nature, and with embedded applications will only work for the application that"
NSQ_SOURCE_LINE 00000347 "is rendering."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "  $app->hook(after_render => sub ($c, $output, $format) {...});"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "Mostly used for post-processing dynamically generated content. (Passed the current controller object, a reference to"
NSQ_SOURCE_LINE 00000352 "the content and the format)"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=head2 after_dispatch"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "Emitted in reverse order after a response has been generated. Note that this hook can trigger out of order due to its"
NSQ_SOURCE_LINE 00000357 "dynamic nature, and with embedded applications will only work for the application that is generating the response."
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "  $app->hook(after_dispatch => sub ($c) {...});"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "Useful for rewriting outgoing responses and other post-processing tasks. (Passed the current controller object)"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=head1 ATTRIBUTES"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "L<Mojolicious> implements the following attributes."
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=head2 commands"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "  my $commands = $app->commands;"
NSQ_SOURCE_LINE 00000370 "  $app         = $app->commands(Mojolicious::Commands->new);"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "Command line interface for your application, defaults to a L<Mojolicious::Commands> object."
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "  # Add another namespace to load commands from"
NSQ_SOURCE_LINE 00000375 "  push @{$app->commands->namespaces}, 'MyApp::Command';"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "=head2 controller_class"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "  my $class = $app->controller_class;"
NSQ_SOURCE_LINE 00000380 "  $app      = $app->controller_class('Mojolicious::Controller');"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "Class to be used for the default controller, defaults to L<Mojolicious::Controller>. Note that this class needs to have"
NSQ_SOURCE_LINE 00000383 "already been loaded before the first request arrives."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=head2 exception_format"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "  my $format = $app->exception_format;"
NSQ_SOURCE_LINE 00000388 "  $app       = $app->exception_format('txt');"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "Format for HTTP exceptions (C<html>, C<json>, or C<txt>), defaults to C<html>."
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "=head2 home"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "  my $home = $app->home;"
NSQ_SOURCE_LINE 00000395 "  $app     = $app->home(Mojo::Home->new);"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "The home directory of your application, defaults to a L<Mojo::Home> object which stringifies to the actual path."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "  # Portably generate path relative to home directory"
NSQ_SOURCE_LINE 00000400 "  my $path = $app->home->child('data', 'important.txt');"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "=head2 log"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "  my $log = $app->log;"
NSQ_SOURCE_LINE 00000405 "  $app    = $app->log(Mojo::Log->new);"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "The logging layer of your application, defaults to a L<Mojo::Log> object. The level will default to either the"
NSQ_SOURCE_LINE 00000408 "C<MOJO_LOG_LEVEL> environment variable, C<trace> if the L</mode> is C<development>, or C<info> otherwise. All messages"
NSQ_SOURCE_LINE 00000409 "will be written to C<STDERR> by default."
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "  # Log debug message"
NSQ_SOURCE_LINE 00000412 "  $app->log->debug('It works');"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "=head2 max_request_size"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "  my $max = $app->max_request_size;"
NSQ_SOURCE_LINE 00000417 "  $app    = $app->max_request_size(16777216);"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "Maximum request size in bytes, defaults to the value of L<Mojo::Message/\"max_message_size\">. Setting the value to C<0>"
NSQ_SOURCE_LINE 00000420 "will allow requests of indefinite size. Note that increasing this value can also drastically increase memory usage,"
NSQ_SOURCE_LINE 00000421 "should you for example attempt to parse an excessively large request body with the methods L<Mojo::Message/\"dom\"> or"
NSQ_SOURCE_LINE 00000422 "L<Mojo::Message/\"json\">."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "=head2 mode"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "  my $mode = $app->mode;"
NSQ_SOURCE_LINE 00000427 "  $app     = $app->mode('production');"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "The operating mode for your application, defaults to a value from the C<MOJO_MODE> and C<PLACK_ENV> environment"
NSQ_SOURCE_LINE 00000430 "variables or C<development>."
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "=head2 moniker"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "  my $moniker = $app->moniker;"
NSQ_SOURCE_LINE 00000435 "  $app        = $app->moniker('foo_bar');"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "Moniker of this application, often used as default filename for configuration files and the like, defaults to"
NSQ_SOURCE_LINE 00000438 "decamelizing the application class with L<Mojo::Util/\"decamelize\">."
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "=head2 plugins"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "  my $plugins = $app->plugins;"
NSQ_SOURCE_LINE 00000443 "  $app        = $app->plugins(Mojolicious::Plugins->new);"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "The plugin manager, defaults to a L<Mojolicious::Plugins> object. See the L</\"plugin\"> method below if you want to load"
NSQ_SOURCE_LINE 00000446 "a plugin."
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "  # Add another namespace to load plugins from"
NSQ_SOURCE_LINE 00000449 "  push @{$app->plugins->namespaces}, 'MyApp::Plugin';"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "=head2 preload_namespaces"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "  my $namespaces = $app->preload_namespaces;"
NSQ_SOURCE_LINE 00000454 "  $app           = $app->preload_namespaces(['MyApp::Controller']);"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "Namespaces to preload classes from during application startup."
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "=head2 renderer"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "  my $renderer = $app->renderer;"
NSQ_SOURCE_LINE 00000461 "  $app         = $app->renderer(Mojolicious::Renderer->new);"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "Used to render content, defaults to a L<Mojolicious::Renderer> object. For more information about how to generate"
NSQ_SOURCE_LINE 00000464 "content see L<Mojolicious::Guides::Rendering>."
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "  # Enable compression"
NSQ_SOURCE_LINE 00000467 "  $app->renderer->compress(1);"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "  # Add another \"templates\" directory"
NSQ_SOURCE_LINE 00000470 "  push @{$app->renderer->paths}, '/home/sri/templates';"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "  # Add another \"templates\" directory with higher precedence"
NSQ_SOURCE_LINE 00000473 "  unshift @{$app->renderer->paths}, '/home/sri/themes/blue/templates';"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "  # Add another class with templates in DATA section"
NSQ_SOURCE_LINE 00000476 "  push @{$app->renderer->classes}, 'Mojolicious::Plugin::Fun';"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "=head2 routes"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "  my $routes = $app->routes;"
NSQ_SOURCE_LINE 00000481 "  $app       = $app->routes(Mojolicious::Routes->new);"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "The router, defaults to a L<Mojolicious::Routes> object. You use this in your startup method to define the url"
NSQ_SOURCE_LINE 00000484 "endpoints for your application."
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "  # Add routes"
NSQ_SOURCE_LINE 00000487 "  my $r = $app->routes;"
NSQ_SOURCE_LINE 00000488 "  $r->get('/foo/bar')->to('test#foo', title => 'Hello Mojo!');"
NSQ_SOURCE_LINE 00000489 "  $r->post('/baz')->to('test#baz');"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "  # Add another namespace to load controllers from"
NSQ_SOURCE_LINE 00000492 "  push @{$app->routes->namespaces}, 'MyApp::MyController';"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "=head2 secrets"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "  my $secrets = $app->secrets;"
NSQ_SOURCE_LINE 00000497 "  $app        = $app->secrets([$bytes]);"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "Secret passphrases used for signed cookies and the like, defaults to the L</\"moniker\"> of this application, which is"
NSQ_SOURCE_LINE 00000500 "not very secure, so you should change it!!! As long as you are using the insecure default there will be debug messages"
NSQ_SOURCE_LINE 00000501 "in the log file reminding you to change your passphrase. Only the first passphrase is used to create new signatures,"
NSQ_SOURCE_LINE 00000502 "but all of them for verification. So you can increase security without invalidating all your existing signed cookies by"
NSQ_SOURCE_LINE 00000503 "rotating passphrases, just add new ones to the front and remove old ones from the back."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "  # Rotate passphrases"
NSQ_SOURCE_LINE 00000506 "  $app->secrets(['new_passw0rd', 'old_passw0rd', 'very_old_passw0rd']);"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "=head2 sessions"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "  my $sessions = $app->sessions;"
NSQ_SOURCE_LINE 00000511 "  $app         = $app->sessions(Mojolicious::Sessions->new);"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "Signed cookie based session manager, defaults to a L<Mojolicious::Sessions> object. You can usually leave this alone,"
NSQ_SOURCE_LINE 00000514 "see L<Mojolicious::Controller/\"session\"> for more information about working with session data."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "  # Enable encrypted sessions"
NSQ_SOURCE_LINE 00000517 "  $app->sessions->encrypted(1);"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "  # Change name of cookie used for all sessions"
NSQ_SOURCE_LINE 00000520 "  $app->sessions->cookie_name('mysession');"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "  # Disable SameSite feature"
NSQ_SOURCE_LINE 00000523 "  $app->sessions->samesite(undef);"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "=head2 static"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "  my $static = $app->static;"
NSQ_SOURCE_LINE 00000528 "  $app       = $app->static(Mojolicious::Static->new);"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "For serving static files from your C<public> directories, defaults to a L<Mojolicious::Static> object."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "  # Serve static files only with a \"/static\" prefix"
NSQ_SOURCE_LINE 00000533 "  $app->static->prefix('/static');"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "  # Add another \"public\" directory"
NSQ_SOURCE_LINE 00000536 "  push @{$app->static->paths}, '/home/sri/public';"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "  # Add another \"public\" directory with higher precedence"
NSQ_SOURCE_LINE 00000539 "  unshift @{$app->static->paths}, '/home/sri/themes/blue/public';"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "  # Add another class with static files in DATA section"
NSQ_SOURCE_LINE 00000542 "  push @{$app->static->classes}, 'Mojolicious::Plugin::Fun';"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "  # Remove built-in favicon"
NSQ_SOURCE_LINE 00000545 "  delete $app->static->extra->{'favicon.ico'};"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "=head2 types"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "  my $types = $app->types;"
NSQ_SOURCE_LINE 00000550 "  $app      = $app->types(Mojolicious::Types->new);"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "Responsible for connecting file extensions with MIME types, defaults to a L<Mojolicious::Types> object."
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "  # Add custom MIME type"
NSQ_SOURCE_LINE 00000555 "  $app->types->type(twt => 'text/tweet');"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "=head2 ua"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "  my $ua = $app->ua;"
NSQ_SOURCE_LINE 00000560 "  $app   = $app->ua(Mojo::UserAgent->new);"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "A full featured HTTP user agent for use in your applications, defaults to a L<Mojo::UserAgent> object."
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "  # Perform blocking request"
NSQ_SOURCE_LINE 00000565 "  say $app->ua->get('example.com')->result->body;"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "=head2 validator"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "  my $validator = $app->validator;"
NSQ_SOURCE_LINE 00000570 "  $app          = $app->validator(Mojolicious::Validator->new);"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "Validate values, defaults to a L<Mojolicious::Validator> object."
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "  # Add validation check"
NSQ_SOURCE_LINE 00000575 "  $app->validator->add_check(foo => sub ($v, $name, $value) {"
NSQ_SOURCE_LINE 00000576 "    return $value ne 'foo';"
NSQ_SOURCE_LINE 00000577 "  });"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "  # Add validation filter"
NSQ_SOURCE_LINE 00000580 "  $app->validator->add_filter(quotemeta => sub ($v, $name, $value) {"
NSQ_SOURCE_LINE 00000581 "    return quotemeta $value;"
NSQ_SOURCE_LINE 00000582 "  });"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "=head1 METHODS"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "L<Mojolicious> inherits all methods from L<Mojo::Base> and implements the following new ones."
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "=head2 build_controller"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "  my $c = $app->build_controller;"
NSQ_SOURCE_LINE 00000591 "  my $c = $app->build_controller(Mojo::Transaction::HTTP->new);"
NSQ_SOURCE_LINE 00000592 "  my $c = $app->build_controller(Mojolicious::Controller->new);"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "Build default controller object with L</\"controller_class\">."
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "  # Render template from application"
NSQ_SOURCE_LINE 00000597 "  my $foo = $app->build_controller->render_to_string(template => 'foo');"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "=head2 build_tx"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "  my $tx = $app->build_tx;"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "Build L<Mojo::Transaction::HTTP> object and emit L</\"after_build_tx\"> hook."
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "=head2 config"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "  my $hash = $app->config;"
NSQ_SOURCE_LINE 00000608 "  my $foo  = $app->config('foo');"
NSQ_SOURCE_LINE 00000609 "  $app     = $app->config({foo => 'bar', baz => 23});"
NSQ_SOURCE_LINE 00000610 "  $app     = $app->config(foo => 'bar', baz => 23);"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "Application configuration."
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "  # Remove value"
NSQ_SOURCE_LINE 00000615 "  my $foo = delete $app->config->{foo};"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "  # Assign multiple values at once"
NSQ_SOURCE_LINE 00000618 "  $app->config(foo => 'test', bar => 23);"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "=head2 defaults"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "  my $hash = $app->defaults;"
NSQ_SOURCE_LINE 00000623 "  my $foo  = $app->defaults('foo');"
NSQ_SOURCE_LINE 00000624 "  $app     = $app->defaults({foo => 'bar', baz => 23});"
NSQ_SOURCE_LINE 00000625 "  $app     = $app->defaults(foo => 'bar', baz => 23);"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "Default values for L<Mojolicious::Controller/\"stash\">, assigned for every new request."
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "  # Remove value"
NSQ_SOURCE_LINE 00000630 "  my $foo = delete $app->defaults->{foo};"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "  # Assign multiple values at once"
NSQ_SOURCE_LINE 00000633 "  $app->defaults(foo => 'test', bar => 23);"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "=head2 dispatch"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "  $app->dispatch(Mojolicious::Controller->new);"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "The heart of every L<Mojolicious> application, calls the L</\"static\"> and L</\"routes\"> dispatchers for every request"
NSQ_SOURCE_LINE 00000640 "and passes them a L<Mojolicious::Controller> object."
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "=head2 handler"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "  $app->handler(Mojo::Transaction::HTTP->new);"
NSQ_SOURCE_LINE 00000645 "  $app->handler(Mojolicious::Controller->new);"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "Sets up the default controller and emits the L</\"around_dispatch\"> hook for every request."
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "=head2 helper"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "  $app->helper(foo => sub {...});"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "Add or replace a helper that will be available as a method of the controller object and the application object, as well"
NSQ_SOURCE_LINE 00000654 "as a function in C<ep> templates. For a full list of helpers that are available by default see"
NSQ_SOURCE_LINE 00000655 "L<Mojolicious::Plugin::DefaultHelpers> and L<Mojolicious::Plugin::TagHelpers>."
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "  # Helper"
NSQ_SOURCE_LINE 00000658 "  $app->helper(cache => sub { state $cache = {} });"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "  # Application"
NSQ_SOURCE_LINE 00000661 "  $app->cache->{foo} = 'bar';"
NSQ_SOURCE_LINE 00000662 "  my $result = $app->cache->{foo};"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "  # Controller"
NSQ_SOURCE_LINE 00000665 "  $c->cache->{foo} = 'bar';"
NSQ_SOURCE_LINE 00000666 "  my $result = $c->cache->{foo};"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "  # Template"
NSQ_SOURCE_LINE 00000669 "  % cache->{foo} = 'bar';"
NSQ_SOURCE_LINE 00000670 "  %= cache->{foo}"
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "=head2 hook"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "  $app->hook(after_dispatch => sub {...});"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "Extend L<Mojolicious> with hooks, which allow code to be shared with all requests indiscriminately, for a full list of"
NSQ_SOURCE_LINE 00000677 "available hooks see L</\"HOOKS\">."
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "  # Dispatchers will not run if there's already a response code defined"
NSQ_SOURCE_LINE 00000680 "  $app->hook(before_dispatch => sub ($c) {"
NSQ_SOURCE_LINE 00000681 "    $c->render(text => 'Skipped static file server and router!')"
NSQ_SOURCE_LINE 00000682 "      if $c->req->url->path->to_route =~ /do_not_dispatch/;"
NSQ_SOURCE_LINE 00000683 "  });"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "=head2 new"
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "  my $app = Mojolicious->new;"
NSQ_SOURCE_LINE 00000688 "  my $app = Mojolicious->new(moniker => 'foo_bar');"
NSQ_SOURCE_LINE 00000689 "  my $app = Mojolicious->new({moniker => 'foo_bar'});"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "Construct a new L<Mojolicious> application and call L</\"startup\">. Will automatically detect your home directory. Also"
NSQ_SOURCE_LINE 00000692 "sets up the renderer, static file server, a default set of plugins and an L</\"around_dispatch\"> hook with the default"
NSQ_SOURCE_LINE 00000693 "exception handling."
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "=head2 plugin"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "  $app->plugin('some_thing');"
NSQ_SOURCE_LINE 00000698 "  $app->plugin('some_thing', foo => 23);"
NSQ_SOURCE_LINE 00000699 "  $app->plugin('some_thing', {foo => 23});"
NSQ_SOURCE_LINE 00000700 "  $app->plugin('SomeThing');"
NSQ_SOURCE_LINE 00000701 "  $app->plugin('SomeThing', foo => 23);"
NSQ_SOURCE_LINE 00000702 "  $app->plugin('SomeThing', {foo => 23});"
NSQ_SOURCE_LINE 00000703 "  $app->plugin('MyApp::Plugin::SomeThing');"
NSQ_SOURCE_LINE 00000704 "  $app->plugin('MyApp::Plugin::SomeThing', foo => 23);"
NSQ_SOURCE_LINE 00000705 "  $app->plugin('MyApp::Plugin::SomeThing', {foo => 23});"
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "Load a plugin, for a full list of example plugins included in the L<Mojolicious> distribution see"
NSQ_SOURCE_LINE 00000708 "L<Mojolicious::Plugins/\"PLUGINS\">."
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "=head2 server"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "  $app->server(Mojo::Server->new);"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "Emits the L</\"before_server_start\"> hook."
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "=head2 start"
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "  $app->start;"
NSQ_SOURCE_LINE 00000719 "  $app->start(@ARGV);"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "Start the command line interface for your application. For a full list of commands that are available by default see"
NSQ_SOURCE_LINE 00000722 "L<Mojolicious::Commands/\"COMMANDS\">. Note that the options C<-h>/C<--help>, C<--home> and C<-m>/C<--mode>, which are"
NSQ_SOURCE_LINE 00000723 "shared by all commands, will be parsed from C<@ARGV> during compile time."
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "  # Always start daemon"
NSQ_SOURCE_LINE 00000726 "  $app->start('daemon', '-l', 'http://*:8080');"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "=head2 startup"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "  $app->startup;"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "This is your main hook into the application, it will be called at application startup. Meant to be overloaded in a"
NSQ_SOURCE_LINE 00000733 "subclass."
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "  sub startup ($self) {...}"
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "=head2 warmup"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "  $app->warmup;"
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "Preload classes from L</\"preload_namespaces\"> for future use."
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "=head1 HELPERS"
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "In addition to the L</\"ATTRIBUTES\"> and L</\"METHODS\"> above you can also call helpers on L<Mojolicious> objects. This"
NSQ_SOURCE_LINE 00000746 "includes all helpers from L<Mojolicious::Plugin::DefaultHelpers> and L<Mojolicious::Plugin::TagHelpers>. Note that"
NSQ_SOURCE_LINE 00000747 "application helpers are always called with a new default controller object, so they can't depend on or change"
NSQ_SOURCE_LINE 00000748 "controller state, which includes request, response and stash."
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "  # Call helper"
NSQ_SOURCE_LINE 00000751 "  say $app->dumper({foo => 'bar'});"
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "  # Longer version"
NSQ_SOURCE_LINE 00000754 "  say $app->build_controller->helpers->dumper({foo => 'bar'});"
