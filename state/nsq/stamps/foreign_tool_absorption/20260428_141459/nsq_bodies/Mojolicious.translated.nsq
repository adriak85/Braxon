NSQ_SOURCE_LINE 00000038 "has mode               => sub { $ENV{MOJO_MODE} || $ENV{PLACK_ENV} || 'development' };"
NSQ_SOURCE_LINE 00000039 "has moniker            => sub { Mojo::Util::decamelize ref shift };"
NSQ_SOURCE_LINE 00000040 "has plugins            => sub { Mojolicious::Plugins->new };"
NSQ_SOURCE_LINE 00000041 "has preload_namespaces => sub { [] };"
NSQ_SOURCE_LINE 00000042 "has renderer           => sub { Mojolicious::Renderer->new };"
NSQ_SOURCE_LINE 00000043 "has routes             => sub { Mojolicious::Routes->new };"
NSQ_SOURCE_LINE 00000044 "has secrets            => sub {"
NSQ_SOURCE_LINE 00000045 "  my $self = shift;"
