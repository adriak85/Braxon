BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Class::Inspector;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.006;"
NSQ_SOURCE_LINE 00000004 "# We don't want to use strict refs anywhere in this module, since we do a"
NSQ_SOURCE_LINE 00000005 "# lot of things in here that aren't strict refs friendly."
NSQ_SOURCE_LINE 00000006 "use strict qw{vars subs};"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 "use File::Spec ();"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "# ABSTRACT: Get information about a class and its structure"
NSQ_SOURCE_LINE 00000011 "our $VERSION = '1.36'; # VERSION"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# If Unicode is available, enable it so that the"
NSQ_SOURCE_LINE 00000015 "# pattern matches below match unicode method names."
NSQ_SOURCE_LINE 00000016 "# We can safely ignore any failure here."
NSQ_SOURCE_LINE 00000017 "BEGIN {"
NSQ_SOURCE_LINE 00000018 "  local $@;"
NSQ_SOURCE_LINE 00000019 "  eval {"
NSQ_SOURCE_LINE 00000020 "    require utf8;"
NSQ_SOURCE_LINE 00000021 "    utf8->import;"
NSQ_SOURCE_LINE 00000022 "  };"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "# Predefine some regexs"
NSQ_SOURCE_LINE 00000026 "our $RE_IDENTIFIER = qr/\\A[^\\W\\d]\\w*\\z/s;"
NSQ_SOURCE_LINE 00000027 "our $RE_CLASS      = qr/\\A[^\\W\\d]\\w*(?:(?:\\'|::)\\w+)*\\z/s;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "# Are we on something Unix-like?"
NSQ_SOURCE_LINE 00000030 "our $UNIX  = !! ( $File::Spec::ISA[0] eq 'File::Spec::Unix'  );"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "#####################################################################"
NSQ_SOURCE_LINE 00000034 "# Basic Methods"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub _resolved_inc_handler {"
NSQ_SOURCE_LINE 00000038 "  my $class    = shift;"
NSQ_SOURCE_LINE 00000039 "  my $filename = $class->_inc_filename(shift) or return undef;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "  foreach my $inc ( @INC ) {"
NSQ_SOURCE_LINE 00000042 "    my $ref = ref $inc;"
NSQ_SOURCE_LINE 00000043 "    if($ref eq 'CODE') {"
NSQ_SOURCE_LINE 00000044 "      my @ret = $inc->($inc, $filename);"
NSQ_SOURCE_LINE 00000045 "      if(@ret == 1 && ! defined $ret[0]) {"
NSQ_SOURCE_LINE 00000046 "        # do nothing."
NSQ_SOURCE_LINE 00000047 "      } elsif(@ret) {"
NSQ_SOURCE_LINE 00000048 "        return 1;"
NSQ_SOURCE_LINE 00000049 "      }"
NSQ_SOURCE_LINE 00000050 "    }"
NSQ_SOURCE_LINE 00000051 "    elsif($ref eq 'ARRAY' && ref($inc->[0]) eq 'CODE') {"
NSQ_SOURCE_LINE 00000052 "      my @ret = $inc->[0]->($inc, $filename);"
NSQ_SOURCE_LINE 00000053 "      if(@ret) {"
NSQ_SOURCE_LINE 00000054 "        return 1;"
NSQ_SOURCE_LINE 00000055 "      }"
NSQ_SOURCE_LINE 00000056 "    }"
NSQ_SOURCE_LINE 00000057 "    elsif($ref && eval { $inc->can('INC') }) {"
NSQ_SOURCE_LINE 00000058 "      my @ret = $inc->INC($filename);"
NSQ_SOURCE_LINE 00000059 "      if(@ret) {"
NSQ_SOURCE_LINE 00000060 "        return 1;"
NSQ_SOURCE_LINE 00000061 "      }"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 "  }"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "  '';"
NSQ_SOURCE_LINE 00000066 "}"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "sub installed {"
NSQ_SOURCE_LINE 00000069 "  my $class = shift;"
NSQ_SOURCE_LINE 00000070 "  !! ($class->loaded_filename($_[0]) or $class->resolved_filename($_[0]) or $class->_resolved_inc_handler($_[0]));"
NSQ_SOURCE_LINE 00000071 "}"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub loaded {"
NSQ_SOURCE_LINE 00000075 "  my $class = shift;"
NSQ_SOURCE_LINE 00000076 "  my $name  = $class->_class(shift) or return undef;"
NSQ_SOURCE_LINE 00000077 "  $class->_loaded($name);"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "sub _loaded {"
NSQ_SOURCE_LINE 00000081 "  my $class = shift;"
NSQ_SOURCE_LINE 00000082 "  my $name  = shift;"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "  # Handle by far the two most common cases"
NSQ_SOURCE_LINE 00000085 "  # This is very fast and handles 99% of cases."
NSQ_SOURCE_LINE 00000086 "  return 1 if defined ${\"${name}::VERSION\"};"
NSQ_SOURCE_LINE 00000087 "  return 1 if @{\"${name}::ISA\"};"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "  # Are there any symbol table entries other than other namespaces"
NSQ_SOURCE_LINE 00000090 "  foreach ( keys %{\"${name}::\"} ) {"
NSQ_SOURCE_LINE 00000091 "    next if substr($_, -2, 2) eq '::';"
NSQ_SOURCE_LINE 00000092 "    return 1 if defined &{\"${name}::$_\"};"
NSQ_SOURCE_LINE 00000093 "  }"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "  # No functions, and it doesn't have a version, and isn't anything."
NSQ_SOURCE_LINE 00000096 "  # As an absolute last resort, check for an entry in %INC"
NSQ_SOURCE_LINE 00000097 "  my $filename = $class->_inc_filename($name);"
NSQ_SOURCE_LINE 00000098 "  return 1 if defined $INC{$filename};"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "  '';"
NSQ_SOURCE_LINE 00000101 "}"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub filename {"
NSQ_SOURCE_LINE 00000105 "  my $class = shift;"
NSQ_SOURCE_LINE 00000106 "  my $name  = $class->_class(shift) or return undef;"
NSQ_SOURCE_LINE 00000107 "  File::Spec->catfile( split /(?:\\'|::)/, $name ) . '.pm';"
NSQ_SOURCE_LINE 00000108 "}"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "sub resolved_filename {"
NSQ_SOURCE_LINE 00000112 "  my $class     = shift;"
NSQ_SOURCE_LINE 00000113 "  my $filename  = $class->_inc_filename(shift) or return undef;"
NSQ_SOURCE_LINE 00000114 "  my @try_first = @_;"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "  # Look through the @INC path to find the file"
NSQ_SOURCE_LINE 00000117 "  foreach ( @try_first, @INC ) {"
NSQ_SOURCE_LINE 00000118 "    my $full = \"$_/$filename\";"
NSQ_SOURCE_LINE 00000119 "    next unless -e $full;"
NSQ_SOURCE_LINE 00000120 "    return $UNIX ? $full : $class->_inc_to_local($full);"
NSQ_SOURCE_LINE 00000121 "  }"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "  # File not found"
NSQ_SOURCE_LINE 00000124 "  '';"
NSQ_SOURCE_LINE 00000125 "}"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "sub loaded_filename {"
NSQ_SOURCE_LINE 00000129 "  my $class    = shift;"
NSQ_SOURCE_LINE 00000130 "  my $filename = $class->_inc_filename(shift);"
NSQ_SOURCE_LINE 00000131 "  $UNIX ? $INC{$filename} : $class->_inc_to_local($INC{$filename});"
NSQ_SOURCE_LINE 00000132 "}"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "#####################################################################"
NSQ_SOURCE_LINE 00000139 "# Sub Related Methods"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "sub functions {"
NSQ_SOURCE_LINE 00000143 "  my $class = shift;"
NSQ_SOURCE_LINE 00000144 "  my $name  = $class->_class(shift) or return undef;"
NSQ_SOURCE_LINE 00000145 "  return undef unless $class->loaded( $name );"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "  # Get all the CODE symbol table entries"
NSQ_SOURCE_LINE 00000148 "  my @functions = sort grep { /$RE_IDENTIFIER/o }"
NSQ_SOURCE_LINE 00000149 "    grep { defined &{\"${name}::$_\"} }"
NSQ_SOURCE_LINE 00000150 "    keys %{\"${name}::\"};"
NSQ_SOURCE_LINE 00000151 "  \\@functions;"
NSQ_SOURCE_LINE 00000152 "}"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "sub function_refs {"
NSQ_SOURCE_LINE 00000156 "  my $class = shift;"
NSQ_SOURCE_LINE 00000157 "  my $name  = $class->_class(shift) or return undef;"
NSQ_SOURCE_LINE 00000158 "  return undef unless $class->loaded( $name );"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "  # Get all the CODE symbol table entries, but return"
NSQ_SOURCE_LINE 00000161 "  # the actual CODE refs this time."
NSQ_SOURCE_LINE 00000162 "  my @functions = map { \\&{\"${name}::$_\"} }"
NSQ_SOURCE_LINE 00000163 "    sort grep { /$RE_IDENTIFIER/o }"
NSQ_SOURCE_LINE 00000164 "    grep { defined &{\"${name}::$_\"} }"
NSQ_SOURCE_LINE 00000165 "    keys %{\"${name}::\"};"
NSQ_SOURCE_LINE 00000166 "  \\@functions;"
NSQ_SOURCE_LINE 00000167 "}"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "sub function_exists {"
NSQ_SOURCE_LINE 00000171 "  my $class    = shift;"
NSQ_SOURCE_LINE 00000172 "  my $name     = $class->_class( shift ) or return undef;"
NSQ_SOURCE_LINE 00000173 "  my $function = shift or return undef;"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "  # Only works if the class is loaded"
NSQ_SOURCE_LINE 00000176 "  return undef unless $class->loaded( $name );"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "  # Does the GLOB exist and its CODE part exist"
NSQ_SOURCE_LINE 00000179 "  defined &{\"${name}::$function\"};"
NSQ_SOURCE_LINE 00000180 "}"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "sub methods {"
NSQ_SOURCE_LINE 00000184 "  my $class     = shift;"
NSQ_SOURCE_LINE 00000185 "  my $name      = $class->_class( shift ) or return undef;"
NSQ_SOURCE_LINE 00000186 "  my @arguments = map { lc $_ } @_;"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "  # Process the arguments to determine the options"
NSQ_SOURCE_LINE 00000189 "  my %options = ();"
NSQ_SOURCE_LINE 00000190 "  foreach ( @arguments ) {"
NSQ_SOURCE_LINE 00000191 "    if ( $_ eq 'public' ) {"
NSQ_SOURCE_LINE 00000192 "      # Only get public methods"
NSQ_SOURCE_LINE 00000193 "      return undef if $options{private};"
NSQ_SOURCE_LINE 00000194 "      $options{public} = 1;"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "    } elsif ( $_ eq 'private' ) {"
NSQ_SOURCE_LINE 00000197 "      # Only get private methods"
NSQ_SOURCE_LINE 00000198 "      return undef if $options{public};"
NSQ_SOURCE_LINE 00000199 "      $options{private} = 1;"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "    } elsif ( $_ eq 'full' ) {"
NSQ_SOURCE_LINE 00000202 "      # Return the full method name"
NSQ_SOURCE_LINE 00000203 "      return undef if $options{expanded};"
NSQ_SOURCE_LINE 00000204 "      $options{full} = 1;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "    } elsif ( $_ eq 'expanded' ) {"
NSQ_SOURCE_LINE 00000207 "      # Returns class, method and function ref"
NSQ_SOURCE_LINE 00000208 "      return undef if $options{full};"
NSQ_SOURCE_LINE 00000209 "      $options{expanded} = 1;"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "    } else {"
NSQ_SOURCE_LINE 00000212 "      # Unknown or unsupported options"
NSQ_SOURCE_LINE 00000213 "      return undef;"
NSQ_SOURCE_LINE 00000214 "    }"
NSQ_SOURCE_LINE 00000215 "  }"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "  # Only works if the class is loaded"
NSQ_SOURCE_LINE 00000218 "  return undef unless $class->loaded( $name );"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "  # Get the super path ( not including UNIVERSAL )"
NSQ_SOURCE_LINE 00000221 "  # Rather than using Class::ISA, we'll use an inlined version"
NSQ_SOURCE_LINE 00000222 "  # that implements the same basic algorithm."
NSQ_SOURCE_LINE 00000223 "  my @path  = ();"
NSQ_SOURCE_LINE 00000224 "  my @queue = ( $name );"
NSQ_SOURCE_LINE 00000225 "  my %seen  = ( $name => 1 );"
NSQ_SOURCE_LINE 00000226 "  while ( my $cl = shift @queue ) {"
NSQ_SOURCE_LINE 00000227 "    push @path, $cl;"
NSQ_SOURCE_LINE 00000228 "    unshift @queue, grep { ! $seen{$_}++ }"
NSQ_SOURCE_LINE 00000229 "      map { s/^::/main::/; s/\\'/::/g; $_ } ##  no critic"
NSQ_SOURCE_LINE 00000230 "      map { \"$_\" }"
NSQ_SOURCE_LINE 00000231 "      ( @{\"${cl}::ISA\"} );"
NSQ_SOURCE_LINE 00000232 "  }"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "  # Find and merge the function names across the entire super path."
NSQ_SOURCE_LINE 00000235 "  # Sort alphabetically and return."
NSQ_SOURCE_LINE 00000236 "  my %methods = ();"
NSQ_SOURCE_LINE 00000237 "  foreach my $namespace ( @path ) {"
NSQ_SOURCE_LINE 00000238 "    my @functions = grep { ! $methods{$_} }"
NSQ_SOURCE_LINE 00000239 "      grep { /$RE_IDENTIFIER/o }"
NSQ_SOURCE_LINE 00000240 "      grep { defined &{\"${namespace}::$_\"} }"
NSQ_SOURCE_LINE 00000241 "      keys %{\"${namespace}::\"};"
NSQ_SOURCE_LINE 00000242 "    foreach ( @functions ) {"
NSQ_SOURCE_LINE 00000243 "      $methods{$_} = $namespace;"
NSQ_SOURCE_LINE 00000244 "    }"
NSQ_SOURCE_LINE 00000245 "  }"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "  # Filter to public or private methods if needed"
NSQ_SOURCE_LINE 00000248 "  my @methodlist = sort keys %methods;"
NSQ_SOURCE_LINE 00000249 "  @methodlist = grep { ! /^\\_/ } @methodlist if $options{public};"
NSQ_SOURCE_LINE 00000250 "  @methodlist = grep {   /^\\_/ } @methodlist if $options{private};"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "  # Return in the correct format"
NSQ_SOURCE_LINE 00000253 "  @methodlist = map { \"$methods{$_}::$_\" } @methodlist if $options{full};"
NSQ_SOURCE_LINE 00000254 "  @methodlist = map {"
NSQ_SOURCE_LINE 00000255 "    [ \"$methods{$_}::$_\", $methods{$_}, $_, \\&{\"$methods{$_}::$_\"} ]"
NSQ_SOURCE_LINE 00000256 "    } @methodlist if $options{expanded};"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "  \\@methodlist;"
NSQ_SOURCE_LINE 00000259 "}"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "#####################################################################"
NSQ_SOURCE_LINE 00000266 "# Search Methods"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "sub subclasses {"
NSQ_SOURCE_LINE 00000270 "  my $class = shift;"
NSQ_SOURCE_LINE 00000271 "  my $name  = $class->_class( shift ) or return undef;"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "  # Prepare the search queue"
NSQ_SOURCE_LINE 00000274 "  my @found = ();"
NSQ_SOURCE_LINE 00000275 "  my @queue = grep { $_ ne 'main' } $class->_subnames('');"
NSQ_SOURCE_LINE 00000276 "  while ( @queue ) {"
NSQ_SOURCE_LINE 00000277 "    my $c = shift(@queue); # c for class"
NSQ_SOURCE_LINE 00000278 "    if ( $class->_loaded($c) ) {"
NSQ_SOURCE_LINE 00000279 "      # At least one person has managed to misengineer"
NSQ_SOURCE_LINE 00000280 "      # a situation in which ->isa could die, even if the"
NSQ_SOURCE_LINE 00000281 "      # class is real. Trap these cases and just skip"
NSQ_SOURCE_LINE 00000282 "      # over that (bizarre) class. That would at limit"
NSQ_SOURCE_LINE 00000283 "      # problems with finding subclasses to only the"
NSQ_SOURCE_LINE 00000284 "      # modules that have broken ->isa implementation."
NSQ_SOURCE_LINE 00000285 "      local $@;"
NSQ_SOURCE_LINE 00000286 "      eval {"
NSQ_SOURCE_LINE 00000287 "        if ( $c->isa($name) ) {"
NSQ_SOURCE_LINE 00000288 "          # Add to the found list, but don't add the class itself"
NSQ_SOURCE_LINE 00000289 "          push @found, $c unless $c eq $name;"
NSQ_SOURCE_LINE 00000290 "        }"
NSQ_SOURCE_LINE 00000291 "      };"
NSQ_SOURCE_LINE 00000292 "    }"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "    # Add any child namespaces to the head of the queue."
NSQ_SOURCE_LINE 00000295 "    # This keeps the queue length shorted, and allows us"
NSQ_SOURCE_LINE 00000296 "    # not to have to do another sort at the end."
NSQ_SOURCE_LINE 00000297 "    unshift @queue, map { \"${c}::$_\" } $class->_subnames($c);"
NSQ_SOURCE_LINE 00000298 "  }"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "  @found ? \\@found : '';"
NSQ_SOURCE_LINE 00000301 "}"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "sub _subnames {"
NSQ_SOURCE_LINE 00000304 "  my ($class, $name) = @_;"
NSQ_SOURCE_LINE 00000305 "  return sort"
NSQ_SOURCE_LINE 00000306 "    grep {  ## no critic"
NSQ_SOURCE_LINE 00000307 "      substr($_, -2, 2, '') eq '::'"
NSQ_SOURCE_LINE 00000308 "      and"
NSQ_SOURCE_LINE 00000309 "      /$RE_IDENTIFIER/o"
NSQ_SOURCE_LINE 00000310 "    }"
NSQ_SOURCE_LINE 00000311 "    keys %{\"${name}::\"};"
NSQ_SOURCE_LINE 00000312 "}"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "#####################################################################"
NSQ_SOURCE_LINE 00000319 "# Children Related Methods"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "# These can go undocumented for now, until I decide if its best to"
NSQ_SOURCE_LINE 00000322 "# just search the children in namespace only, or if I should do it via"
NSQ_SOURCE_LINE 00000323 "# the file system."
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "# Find all the loaded classes below us"
NSQ_SOURCE_LINE 00000326 "sub children {"
NSQ_SOURCE_LINE 00000327 "  my $class = shift;"
NSQ_SOURCE_LINE 00000328 "  my $name  = $class->_class(shift) or return ();"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "  # Find all the Foo:: elements in our symbol table"
NSQ_SOURCE_LINE 00000331 "  no strict 'refs';"
NSQ_SOURCE_LINE 00000332 "  map { \"${name}::$_\" } sort grep { s/::$// } keys %{\"${name}::\"};  ## no critic"
NSQ_SOURCE_LINE 00000333 "}"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "# As above, but recursively"
NSQ_SOURCE_LINE 00000336 "sub recursive_children {"
NSQ_SOURCE_LINE 00000337 "  my $class    = shift;"
NSQ_SOURCE_LINE 00000338 "  my $name     = $class->_class(shift) or return ();"
NSQ_SOURCE_LINE 00000339 "  my @children = ( $name );"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "  # Do the search using a nicer, more memory efficient"
NSQ_SOURCE_LINE 00000342 "  # variant of actual recursion."
NSQ_SOURCE_LINE 00000343 "  my $i = 0;"
NSQ_SOURCE_LINE 00000344 "  no strict 'refs';"
NSQ_SOURCE_LINE 00000345 "  while ( my $namespace = $children[$i++] ) {"
NSQ_SOURCE_LINE 00000346 "    push @children, map { \"${namespace}::$_\" }"
NSQ_SOURCE_LINE 00000347 "      grep { ! /^::/ } # Ignore things like ::ISA::CACHE::"
NSQ_SOURCE_LINE 00000348 "      grep { s/::$// }  ## no critic"
NSQ_SOURCE_LINE 00000349 "      keys %{\"${namespace}::\"};"
NSQ_SOURCE_LINE 00000350 "  }"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "  sort @children;"
NSQ_SOURCE_LINE 00000353 "}"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "#####################################################################"
NSQ_SOURCE_LINE 00000360 "# Private Methods"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "# Checks and expands ( if needed ) a class name"
NSQ_SOURCE_LINE 00000363 "sub _class {"
NSQ_SOURCE_LINE 00000364 "  my $class = shift;"
NSQ_SOURCE_LINE 00000365 "  my $name  = shift or return '';"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "  # Handle main shorthand"
NSQ_SOURCE_LINE 00000368 "  return 'main' if $name eq '::';"
NSQ_SOURCE_LINE 00000369 "  $name =~ s/\\A::/main::/;"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "  # Check the class name is valid"
NSQ_SOURCE_LINE 00000372 "  $name =~ /$RE_CLASS/o ? $name : '';"
NSQ_SOURCE_LINE 00000373 "}"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "# Create a INC-specific filename, which always uses '/'"
NSQ_SOURCE_LINE 00000376 "# regardless of platform."
NSQ_SOURCE_LINE 00000377 "sub _inc_filename {"
NSQ_SOURCE_LINE 00000378 "  my $class = shift;"
NSQ_SOURCE_LINE 00000379 "  my $name  = $class->_class(shift) or return undef;"
NSQ_SOURCE_LINE 00000380 "  join( '/', split /(?:\\'|::)/, $name ) . '.pm';"
NSQ_SOURCE_LINE 00000381 "}"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "# Convert INC-specific file name to local file name"
NSQ_SOURCE_LINE 00000384 "sub _inc_to_local {"
NSQ_SOURCE_LINE 00000385 "  # Shortcut in the Unix case"
NSQ_SOURCE_LINE 00000386 "  return $_[1] if $UNIX;"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "  # On other places, we have to deal with an unusual path that might look"
NSQ_SOURCE_LINE 00000389 "  # like C:/foo/bar.pm which doesn't fit ANY normal pattern."
NSQ_SOURCE_LINE 00000390 "  # Putting it through splitpath/dir and back again seems to normalise"
NSQ_SOURCE_LINE 00000391 "  # it to a reasonable amount."
NSQ_SOURCE_LINE 00000392 "  my $class              = shift;"
NSQ_SOURCE_LINE 00000393 "  my $inc_name           = shift or return undef;"
NSQ_SOURCE_LINE 00000394 "  my ($vol, $dir, $file) = File::Spec->splitpath( $inc_name );"
NSQ_SOURCE_LINE 00000395 "  $dir = File::Spec->catdir( File::Spec->splitdir( $dir || \"\" ) );"
NSQ_SOURCE_LINE 00000396 "  File::Spec->catpath( $vol, $dir, $file || \"\" );"
NSQ_SOURCE_LINE 00000397 "}"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "1;"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "__END__"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=pod"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=head1 NAME"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "Class::Inspector - Get information about a class and its structure"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=head1 VERSION"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "version 1.36"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "  use Class::Inspector;"
NSQ_SOURCE_LINE 00000418 "  "
NSQ_SOURCE_LINE 00000419 "  # Is a class installed and/or loaded"
NSQ_SOURCE_LINE 00000420 "  Class::Inspector->installed( 'Foo::Class' );"
NSQ_SOURCE_LINE 00000421 "  Class::Inspector->loaded( 'Foo::Class' );"
NSQ_SOURCE_LINE 00000422 "  "
NSQ_SOURCE_LINE 00000423 "  # Filename related information"
NSQ_SOURCE_LINE 00000424 "  Class::Inspector->filename( 'Foo::Class' );"
NSQ_SOURCE_LINE 00000425 "  Class::Inspector->resolved_filename( 'Foo::Class' );"
NSQ_SOURCE_LINE 00000426 "  "
NSQ_SOURCE_LINE 00000427 "  # Get subroutine related information"
NSQ_SOURCE_LINE 00000428 "  Class::Inspector->functions( 'Foo::Class' );"
NSQ_SOURCE_LINE 00000429 "  Class::Inspector->function_refs( 'Foo::Class' );"
NSQ_SOURCE_LINE 00000430 "  Class::Inspector->function_exists( 'Foo::Class', 'bar' );"
NSQ_SOURCE_LINE 00000431 "  Class::Inspector->methods( 'Foo::Class', 'full', 'public' );"
NSQ_SOURCE_LINE 00000432 "  "
NSQ_SOURCE_LINE 00000433 "  # Find all loaded subclasses or something"
NSQ_SOURCE_LINE 00000434 "  Class::Inspector->subclasses( 'Foo::Class' );"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "Class::Inspector allows you to get information about a loaded class. Most or"
NSQ_SOURCE_LINE 00000439 "all of this information can be found in other ways, but they aren't always"
NSQ_SOURCE_LINE 00000440 "very friendly, and usually involve a relatively high level of Perl wizardry,"
NSQ_SOURCE_LINE 00000441 "or strange and unusual looking code. Class::Inspector attempts to provide"
NSQ_SOURCE_LINE 00000442 "an easier, more friendly interface to this information."
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "=head1 METHODS"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "=head2 installed"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 " my $bool = Class::Inspector->installed($class);"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "The C<installed> static method tries to determine if a class is installed"
NSQ_SOURCE_LINE 00000451 "on the machine, or at least available to Perl. It does this by wrapping"
NSQ_SOURCE_LINE 00000452 "around C<resolved_filename>."
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "Returns true if installed/available, false if the class is not installed,"
NSQ_SOURCE_LINE 00000455 "or C<undef> if the class name is invalid."
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "=head2 loaded"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 " my $bool = Class::Inspector->loaded($class);"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "The C<loaded> static method tries to determine if a class is loaded by"
NSQ_SOURCE_LINE 00000462 "looking for symbol table entries."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "This method it uses to determine this will work even if the class does not"
NSQ_SOURCE_LINE 00000465 "have its own file, but is contained inside a single file with multiple"
NSQ_SOURCE_LINE 00000466 "classes in it. Even in the case of some sort of run-time loading class"
NSQ_SOURCE_LINE 00000467 "being used, these typically leave some trace in the symbol table, so an"
NSQ_SOURCE_LINE 00000468 "L<Autoload> or L<Class::Autouse>-based class should correctly appear"
NSQ_SOURCE_LINE 00000469 "loaded."
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "Returns true if the class is loaded, false if not, or C<undef> if the"
NSQ_SOURCE_LINE 00000472 "class name is invalid."
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=head2 filename"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 " my $filename = Class::Inspector->filename($class);"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "For a given class, returns the base filename for the class. This will NOT"
NSQ_SOURCE_LINE 00000479 "be a fully resolved filename, just the part of the filename BELOW the"
NSQ_SOURCE_LINE 00000480 "C<@INC> entry."
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "  print Class->filename( 'Foo::Bar' );"
NSQ_SOURCE_LINE 00000483 "  > Foo/Bar.pm"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "This filename will be returned with the right separator for the local"
NSQ_SOURCE_LINE 00000486 "platform, and should work on all platforms."
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "Returns the filename on success or C<undef> if the class name is invalid."
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "=head2 resolved_filename"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 " my $filename = Class::Inspector->resolved_filename($class);"
NSQ_SOURCE_LINE 00000493 " my $filename = Class::Inspector->resolved_filename($class, @try_first);"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "For a given class, the C<resolved_filename> static method returns the fully"
NSQ_SOURCE_LINE 00000496 "resolved filename for a class. That is, the file that the class would be"
NSQ_SOURCE_LINE 00000497 "loaded from."
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "This is not necessarily the file that the class WAS loaded from, as the"
NSQ_SOURCE_LINE 00000500 "value returned is determined each time it runs, and the C<@INC> include"
NSQ_SOURCE_LINE 00000501 "path may change."
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "To get the actual file for a loaded class, see the C<loaded_filename>"
NSQ_SOURCE_LINE 00000504 "method."
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "Returns the filename for the class, or C<undef> if the class name is"
NSQ_SOURCE_LINE 00000507 "invalid."
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=head2 loaded_filename"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 " my $filename = Class::Inspector->loaded_filename($class);"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "For a given loaded class, the C<loaded_filename> static method determines"
NSQ_SOURCE_LINE 00000514 "(via the C<%INC> hash) the name of the file that it was originally loaded"
NSQ_SOURCE_LINE 00000515 "from."
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "Returns a resolved file path, or false if the class did not have it's own"
NSQ_SOURCE_LINE 00000518 "file."
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=head2 functions"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 " my $arrayref = Class::Inspector->functions($class);"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "For a loaded class, the C<functions> static method returns a list of the"
NSQ_SOURCE_LINE 00000525 "names of all the functions in the classes immediate namespace."
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "Note that this is not the METHODS of the class, just the functions."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "Returns a reference to an array of the function names on success, or C<undef>"
NSQ_SOURCE_LINE 00000530 "if the class name is invalid or the class is not loaded."
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "=head2 function_refs"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 " my $arrayref = Class::Inspector->function_refs($class);"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "For a loaded class, the C<function_refs> static method returns references to"
NSQ_SOURCE_LINE 00000537 "all the functions in the classes immediate namespace."
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "Note that this is not the METHODS of the class, just the functions."
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "Returns a reference to an array of C<CODE> refs of the functions on"
NSQ_SOURCE_LINE 00000542 "success, or C<undef> if the class is not loaded."
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "=head2 function_exists"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 " my $bool = Class::Inspector->function_exists($class, $functon);"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "Given a class and function name the C<function_exists> static method will"
NSQ_SOURCE_LINE 00000549 "check to see if the function exists in the class."
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "Note that this is as a function, not as a method. To see if a method"
NSQ_SOURCE_LINE 00000552 "exists for a class, use the C<can> method for any class or object."
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "Returns true if the function exists, false if not, or C<undef> if the"
NSQ_SOURCE_LINE 00000555 "class or function name are invalid, or the class is not loaded."
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "=head2 methods"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 " my $arrayref = Class::Inspector->methods($class, @options);"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "For a given class name, the C<methods> static method will returns ALL"
NSQ_SOURCE_LINE 00000562 "the methods available to that class. This includes all methods available"
NSQ_SOURCE_LINE 00000563 "from every class up the class' C<@ISA> tree."
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "Returns a reference to an array of the names of all the available methods"
NSQ_SOURCE_LINE 00000566 "on success, or C<undef> if the class name is invalid or the class is not"
NSQ_SOURCE_LINE 00000567 "loaded."
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "A number of options are available to the C<methods> method that will alter"
NSQ_SOURCE_LINE 00000570 "the results returned. These should be listed after the class name, in any"
NSQ_SOURCE_LINE 00000571 "order."
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "  # Only get public methods"
NSQ_SOURCE_LINE 00000574 "  my $method = Class::Inspector->methods( 'My::Class', 'public' );"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "=over 4"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "=item public"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "The C<public> option will return only 'public' methods, as defined by the Perl"
NSQ_SOURCE_LINE 00000581 "convention of prepending an underscore to any 'private' methods. The C<public>"
NSQ_SOURCE_LINE 00000582 "option will effectively remove any methods that start with an underscore."
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "=item private"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "The C<private> options will return only 'private' methods, as defined by the"
NSQ_SOURCE_LINE 00000587 "Perl convention of prepending an underscore to an private methods. The"
NSQ_SOURCE_LINE 00000588 "C<private> option will effectively remove an method that do not start with an"
NSQ_SOURCE_LINE 00000589 "underscore."
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "B<Note: The C<public> and C<private> options are mutually exclusive>"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=item full"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "C<methods> normally returns just the method name. Supplying the C<full> option"
NSQ_SOURCE_LINE 00000596 "will cause the methods to be returned as the full names. That is, instead of"
NSQ_SOURCE_LINE 00000597 "returning C<[ 'method1', 'method2', 'method3' ]>, you would instead get"
NSQ_SOURCE_LINE 00000598 "C<[ 'Class::method1', 'AnotherClass::method2', 'Class::method3' ]>."
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "=item expanded"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "The C<expanded> option will cause a lot more information about method to be"
NSQ_SOURCE_LINE 00000603 "returned. Instead of just the method name, you will instead get an array"
NSQ_SOURCE_LINE 00000604 "reference containing the method name as a single combined name, a la C<full>,"
NSQ_SOURCE_LINE 00000605 "the separate class and method, and a CODE ref to the actual function ( if"
NSQ_SOURCE_LINE 00000606 "available ). Please note that the function reference is not guaranteed to"
NSQ_SOURCE_LINE 00000607 "be available. C<Class::Inspector> is intended at some later time, to work"
NSQ_SOURCE_LINE 00000608 "with modules that have some kind of common run-time loader in place ( e.g"
NSQ_SOURCE_LINE 00000609 "C<Autoloader> or C<Class::Autouse> for example."
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "The response from C<methods( 'Class', 'expanded' )> would look something like"
NSQ_SOURCE_LINE 00000612 "the following."
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "  ["
NSQ_SOURCE_LINE 00000615 "    [ 'Class::method1',   'Class',   'method1', \\&Class::method1   ],"
NSQ_SOURCE_LINE 00000616 "    [ 'Another::method2', 'Another', 'method2', \\&Another::method2 ],"
NSQ_SOURCE_LINE 00000617 "    [ 'Foo::bar',         'Foo',     'bar',     \\&Foo::bar         ],"
NSQ_SOURCE_LINE 00000618 "  ]"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "=back"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "=head2 subclasses"
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 " my $arrayref = Class::Inspector->subclasses($class);"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "The C<subclasses> static method will search then entire namespace (and thus"
NSQ_SOURCE_LINE 00000627 "B<all> currently loaded classes) to find all classes that are subclasses"
NSQ_SOURCE_LINE 00000628 "of the class provided as a the parameter."
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "The actual test will be done by calling C<isa> on the class as a static"
NSQ_SOURCE_LINE 00000631 "method. (i.e. C<My::Class-E<gt>isa($class)>."
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "Returns a reference to a list of the loaded classes that match the class"
NSQ_SOURCE_LINE 00000634 "provided, or false is none match, or C<undef> if the class name provided"
NSQ_SOURCE_LINE 00000635 "is invalid."
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "L<http://ali.as/>, L<Class::Handle>, L<Class::Inspector::Functions>"
NSQ_SOURCE_LINE 00000640 ""
