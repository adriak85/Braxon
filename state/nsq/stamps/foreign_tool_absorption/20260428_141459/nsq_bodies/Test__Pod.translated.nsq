BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Test::Pod;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "=head1 NAME"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "Test::Pod - check for POD errors in files"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "=head1 VERSION"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "Version 1.52"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "=cut"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our $VERSION = '1.52';"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "C<Test::Pod> lets you check the validity of a POD file, and report"
NSQ_SOURCE_LINE 00000021 "its results in standard C<Test::Simple> fashion."
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    use Test::Pod tests => $num_tests;"
NSQ_SOURCE_LINE 00000024 "    pod_file_ok( $file, \"Valid POD file\" );"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "Module authors can include the following in a F<t/pod.t> file and"
NSQ_SOURCE_LINE 00000027 "have C<Test::Pod> automatically find and check all POD files in a"
NSQ_SOURCE_LINE 00000028 "module distribution:"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    use Test::More;"
NSQ_SOURCE_LINE 00000031 "    eval \"use Test::Pod 1.00\";"
NSQ_SOURCE_LINE 00000032 "    plan skip_all => \"Test::Pod 1.00 required for testing POD\" if $@;"
NSQ_SOURCE_LINE 00000033 "    all_pod_files_ok();"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "You can also specify a list of files to check, using the"
NSQ_SOURCE_LINE 00000036 "C<all_pod_files()> function supplied:"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    use strict;"
NSQ_SOURCE_LINE 00000039 "    use Test::More;"
NSQ_SOURCE_LINE 00000040 "    eval \"use Test::Pod 1.00\";"
NSQ_SOURCE_LINE 00000041 "    plan skip_all => \"Test::Pod 1.00 required for testing POD\" if $@;"
NSQ_SOURCE_LINE 00000042 "    my @poddirs = qw( blib script );"
NSQ_SOURCE_LINE 00000043 "    all_pod_files_ok( all_pod_files( @poddirs ) );"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "Or even (if you're running under L<Apache::Test>):"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    use strict;"
NSQ_SOURCE_LINE 00000048 "    use Test::More;"
NSQ_SOURCE_LINE 00000049 "    eval \"use Test::Pod 1.00\";"
NSQ_SOURCE_LINE 00000050 "    plan skip_all => \"Test::Pod 1.00 required for testing POD\" if $@;"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    my @poddirs = qw( blib script );"
NSQ_SOURCE_LINE 00000053 "    use File::Spec::Functions qw( catdir updir );"
NSQ_SOURCE_LINE 00000054 "    all_pod_files_ok("
NSQ_SOURCE_LINE 00000055 "        all_pod_files( map { catdir updir, $_ } @poddirs )"
NSQ_SOURCE_LINE 00000056 "    );"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "Check POD files for errors or warnings in a test file, using"
NSQ_SOURCE_LINE 00000061 "C<Pod::Simple> to do the heavy lifting."
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=cut"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "use Test::Builder;"
NSQ_SOURCE_LINE 00000066 "use Pod::Simple;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "our %ignore_dirs = ("
NSQ_SOURCE_LINE 00000069 "    '.bzr' => 'Bazaar',"
NSQ_SOURCE_LINE 00000070 "    '.git' => 'Git',"
NSQ_SOURCE_LINE 00000071 "    '.hg'  => 'Mercurial',"
NSQ_SOURCE_LINE 00000072 "    '.pc'  => 'quilt',"
NSQ_SOURCE_LINE 00000073 "    '.svn' => 'Subversion',"
NSQ_SOURCE_LINE 00000074 "    CVS    => 'CVS',"
NSQ_SOURCE_LINE 00000075 "    RCS    => 'RCS',"
NSQ_SOURCE_LINE 00000076 "    SCCS   => 'SCCS',"
NSQ_SOURCE_LINE 00000077 "    _darcs => 'darcs',"
NSQ_SOURCE_LINE 00000078 "    _sgbak => 'Vault/Fortress',"
NSQ_SOURCE_LINE 00000079 ");"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "my $Test = Test::Builder->new;"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "sub import {"
NSQ_SOURCE_LINE 00000084 "    my $self = shift;"
NSQ_SOURCE_LINE 00000085 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    for my $func ( qw( pod_file_ok all_pod_files all_pod_files_ok ) ) {"
NSQ_SOURCE_LINE 00000088 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000089 "        *{$caller.\"::\".$func} = \\&$func;"
NSQ_SOURCE_LINE 00000090 "    }"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    $Test->exported_to($caller);"
NSQ_SOURCE_LINE 00000093 "    $Test->plan(@_);"
NSQ_SOURCE_LINE 00000094 "}"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "sub _additional_test_pod_specific_checks {"
NSQ_SOURCE_LINE 00000097 "    my ($ok, $errata, $file) = @_;"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    return $ok;"
NSQ_SOURCE_LINE 00000100 "}"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=head2 pod_file_ok( FILENAME[, TESTNAME ] )"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "C<pod_file_ok()> will okay the test if the POD parses correctly.  Certain"
NSQ_SOURCE_LINE 00000107 "conditions are not reported yet, such as a file with no pod in it at all."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "When it fails, C<pod_file_ok()> will show any pod checking errors as"
NSQ_SOURCE_LINE 00000110 "diagnostics."
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "The optional second argument TESTNAME is the name of the test.  If it"
NSQ_SOURCE_LINE 00000113 "is omitted, C<pod_file_ok()> chooses a default test name \"POD test"
NSQ_SOURCE_LINE 00000114 "for FILENAME\"."
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=cut"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "sub pod_file_ok {"
NSQ_SOURCE_LINE 00000119 "    my $file = shift;"
NSQ_SOURCE_LINE 00000120 "    my $name = @_ ? shift : \"POD test for $file\";"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    if ( !-f $file ) {"
NSQ_SOURCE_LINE 00000123 "        $Test->ok( 0, $name );"
NSQ_SOURCE_LINE 00000124 "        $Test->diag( \"$file does not exist\" );"
NSQ_SOURCE_LINE 00000125 "        return;"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "    my $checker = Pod::Simple->new;"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    $checker->output_string( \\my $trash ); # Ignore any output"
NSQ_SOURCE_LINE 00000131 "    $checker->parse_file( $file );"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    my $ok = !$checker->any_errata_seen;"
NSQ_SOURCE_LINE 00000134 "       $ok = _additional_test_pod_specific_checks( $ok, ($checker->{errata}||={}), $file );"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    $name .= ' (no pod)' if !$checker->content_seen;"
NSQ_SOURCE_LINE 00000137 "    $Test->ok( $ok, $name );"
NSQ_SOURCE_LINE 00000138 "    if ( !$ok ) {"
NSQ_SOURCE_LINE 00000139 "        my $lines = $checker->{errata};"
NSQ_SOURCE_LINE 00000140 "        for my $line ( sort { $a<=>$b } keys %$lines ) {"
NSQ_SOURCE_LINE 00000141 "            my $errors = $lines->{$line};"
NSQ_SOURCE_LINE 00000142 "            $Test->diag( \"$file ($line): $_\" ) for @$errors;"
NSQ_SOURCE_LINE 00000143 "        }"
NSQ_SOURCE_LINE 00000144 "    }"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    return $ok;"
NSQ_SOURCE_LINE 00000147 "} # pod_file_ok"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=head2 all_pod_files_ok( [@entries] )"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "Checks all the files under C<@entries> for valid POD. It runs"
NSQ_SOURCE_LINE 00000152 "L<all_pod_files()> on directories and assumes everything else to be a file to"
NSQ_SOURCE_LINE 00000153 "be tested. It calls the C<plan()> function for you (one test for each file),"
NSQ_SOURCE_LINE 00000154 "so you can't have already called C<plan>."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "If C<@entries> is empty or not passed, the function finds all POD files in"
NSQ_SOURCE_LINE 00000157 "files in the F<blib> directory if it exists, or the F<lib> directory if not."
NSQ_SOURCE_LINE 00000158 "A POD file matches the conditions specified below in L</all_pod_files>."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "If you're testing a module, just make a F<t/pod.t>:"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    use Test::More;"
NSQ_SOURCE_LINE 00000163 "    eval \"use Test::Pod 1.00\";"
NSQ_SOURCE_LINE 00000164 "    plan skip_all => \"Test::Pod 1.00 required for testing POD\" if $@;"
NSQ_SOURCE_LINE 00000165 "    all_pod_files_ok();"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "Returns true if all pod files are ok, or false if any fail."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=cut"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "sub all_pod_files_ok {"
NSQ_SOURCE_LINE 00000172 "    my @args = @_ ? @_ : _starting_points();"
NSQ_SOURCE_LINE 00000173 "    my @files = map { -d $_ ? all_pod_files($_) : $_ } @args;"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    unless (@files) {"
NSQ_SOURCE_LINE 00000176 "        $Test->skip_all( \"No files found in (@args)\\n\" );"
NSQ_SOURCE_LINE 00000177 "        return 1;"
NSQ_SOURCE_LINE 00000178 "    }"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    $Test->plan( tests => scalar @files );"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    my $ok = 1;"
NSQ_SOURCE_LINE 00000183 "    foreach my $file ( @files ) {"
NSQ_SOURCE_LINE 00000184 "        pod_file_ok( $file ) or undef $ok;"
NSQ_SOURCE_LINE 00000185 "    }"
NSQ_SOURCE_LINE 00000186 "    return $ok;"
NSQ_SOURCE_LINE 00000187 "}"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "=head2 all_pod_files( [@dirs] )"
NSQ_SOURCE_LINE 00000190 "X<all_pod_files>"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "Returns a list of all the POD files in I<@dirs> and in directories below. If"
NSQ_SOURCE_LINE 00000193 "no directories are passed, it defaults to F<blib> if F<blib> exists, or else"
NSQ_SOURCE_LINE 00000194 "F<lib> if not. Skips any files in F<CVS>, F<.svn>, F<.git> and similar"
NSQ_SOURCE_LINE 00000195 "directories. See C<%Test::Pod::ignore_dirs> for a list of them."
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "A POD file is:"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "=over 4"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=item * Any file that ends in F<.pl>, F<.PL>, F<.pm>, F<.pod>, F<.psgi> or F<.t>."
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=item * Any file that has a first line with a shebang and \"perl\" on it."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=item * Any file that ends in F<.bat> and has a first line with \"--*-Perl-*--\" on it."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "=back"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "The order of the files returned is machine-dependent.  If you want them"
NSQ_SOURCE_LINE 00000210 "sorted, you'll have to sort them yourself."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=cut"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "sub all_pod_files {"
NSQ_SOURCE_LINE 00000215 "    my @pod;"
NSQ_SOURCE_LINE 00000216 "    require File::Find;"
NSQ_SOURCE_LINE 00000217 "    File::Find::find({"
NSQ_SOURCE_LINE 00000218 "        preprocess => sub { grep {"
NSQ_SOURCE_LINE 00000219 "            !exists $ignore_dirs{$_}"
NSQ_SOURCE_LINE 00000220 "            || !-d File::Spec->catfile($File::Find::dir, $_)"
NSQ_SOURCE_LINE 00000221 "        } @_ },"
NSQ_SOURCE_LINE 00000222 "        wanted   => sub { -f $_ && _is_perl($_) && push @pod, $File::Find::name },"
NSQ_SOURCE_LINE 00000223 "        no_chdir => 1,"
NSQ_SOURCE_LINE 00000224 "    }, @_ ? @_ : _starting_points());"
NSQ_SOURCE_LINE 00000225 "    return @pod;"
NSQ_SOURCE_LINE 00000226 "}"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "sub _starting_points {"
NSQ_SOURCE_LINE 00000229 "    return 'blib' if -e 'blib';"
NSQ_SOURCE_LINE 00000230 "    return 'lib';"
NSQ_SOURCE_LINE 00000231 "}"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "sub _is_perl {"
NSQ_SOURCE_LINE 00000234 "    my $file = shift;"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "    # accept as a Perl file everything that ends with a well known Perl suffix ..."
NSQ_SOURCE_LINE 00000237 "    return 1 if $file =~ /[.](?:PL|p(?:[lm]|od|sgi)|t)$/;"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "    open my $fh, '<', $file or return;"
NSQ_SOURCE_LINE 00000240 "    my $first = <$fh>;"
NSQ_SOURCE_LINE 00000241 "    close $fh;"
NSQ_SOURCE_LINE 00000242 "    return unless $first;"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "    # ... or that has a she-bang as first line ..."
NSQ_SOURCE_LINE 00000245 "    return 1 if $first =~ /^#!.*perl/;"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    # ... or that is a .bat ad has a Perl comment line first"
NSQ_SOURCE_LINE 00000248 "    return 1 if $file =~ /[.]bat$/i && $first =~ /--[*]-Perl-[*]--/;"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "    return;"
NSQ_SOURCE_LINE 00000251 "}"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "This module is managed in an open L<GitHub"
NSQ_SOURCE_LINE 00000256 "repository|http://github.com/perl-pod/test-pod/>. Feel free to fork and"
NSQ_SOURCE_LINE 00000257 "contribute, or to clone L<git://github.com/perl-pod/test-pod.git> and send"
NSQ_SOURCE_LINE 00000258 "patches!"
