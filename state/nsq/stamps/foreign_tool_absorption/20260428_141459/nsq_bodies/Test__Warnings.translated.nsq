NSQ_SOURCE_LINE 00000545 "L<blogs.perl.org: YANWT (Yet Another No-Warnings Tester)|http://blogs.perl.org/users/ether/2013/03/yanwt-yet-another-no-warnings-tester.html>"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "=item *"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "L<strictures> - which makes all warnings fatal in tests, hence lessening the need for special warning testing"
NSQ_SOURCE_LINE 00000550 ""
