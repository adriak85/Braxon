NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 "use warnings;"
NSQ_SOURCE_LINE 00000003 "package Test::Warnings; # git description: v0.037-4-gdc90508"
NSQ_SOURCE_LINE 00000004 "# vim: set ts=8 sts=2 sw=2 tw=100 et :"
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: Test for warnings and the lack of them"
NSQ_SOURCE_LINE 00000006 "# KEYWORDS: testing tests warnings"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.038';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use parent 'Exporter';"
NSQ_SOURCE_LINE 00000011 "use Test::Builder;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000014 "    allow_warnings allowing_warnings"
NSQ_SOURCE_LINE 00000015 "    had_no_warnings"
NSQ_SOURCE_LINE 00000016 "    warnings warning"
NSQ_SOURCE_LINE 00000017 "    allow_patterns"
NSQ_SOURCE_LINE 00000018 "    disallow_patterns"
NSQ_SOURCE_LINE 00000019 ");"
NSQ_SOURCE_LINE 00000020 "our @EXPORT = qw(done_testing);"
NSQ_SOURCE_LINE 00000021 "our %EXPORT_TAGS = ( all => [ @EXPORT_OK, @EXPORT ] );"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "my $warnings_allowed;"
NSQ_SOURCE_LINE 00000024 "my $forbidden_warnings_found;"
NSQ_SOURCE_LINE 00000025 "my $done_testing_called;"
NSQ_SOURCE_LINE 00000026 "my $no_end_test;"
NSQ_SOURCE_LINE 00000027 "my $fail_on_warning;"
NSQ_SOURCE_LINE 00000028 "my $report_warnings;"
NSQ_SOURCE_LINE 00000029 "my @collected_warnings;"
NSQ_SOURCE_LINE 00000030 "my @allowed_patterns;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub import {"
NSQ_SOURCE_LINE 00000033 "    my $class = shift @_;"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    my %names; @names{@_} = ();"
NSQ_SOURCE_LINE 00000036 "    # END block will check for this status"
NSQ_SOURCE_LINE 00000037 "    $no_end_test = exists $names{':no_end_test'};"
NSQ_SOURCE_LINE 00000038 "    # __WARN__ handler will check for this status"
NSQ_SOURCE_LINE 00000039 "    $fail_on_warning = exists $names{':fail_on_warning'};"
NSQ_SOURCE_LINE 00000040 "    # Collect and report warnings at the end"
NSQ_SOURCE_LINE 00000041 "    $report_warnings = exists $names{':report_warnings'};"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    delete @names{qw(:no_end_test :fail_on_warning :report_warnings)};"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    if (not $no_end_test) {"
NSQ_SOURCE_LINE 00000046 "        $names{done_testing} = ();"
NSQ_SOURCE_LINE 00000047 "        my $callpkg = caller(0);"
NSQ_SOURCE_LINE 00000048 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000049 "        no warnings 'once';"
NSQ_SOURCE_LINE 00000050 "        undef *{$callpkg.'::done_testing'} if *{$callpkg.'::done_testing'}{CODE};"
NSQ_SOURCE_LINE 00000051 "    }"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    __PACKAGE__->export_to_level(1, $class, keys %names);"
NSQ_SOURCE_LINE 00000054 "}"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "# swap this out for testing this module only!"
NSQ_SOURCE_LINE 00000057 "my $tb;"
NSQ_SOURCE_LINE 00000058 "sub _builder(;$) {"
NSQ_SOURCE_LINE 00000059 "    if (not @_) {"
NSQ_SOURCE_LINE 00000060 "        $tb ||= Test::Builder->new;"
NSQ_SOURCE_LINE 00000061 "        return $tb;"
NSQ_SOURCE_LINE 00000062 "    }"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "    $tb = shift;"
NSQ_SOURCE_LINE 00000065 "}"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "my $_orig_warn_handler = $SIG{__WARN__};"
NSQ_SOURCE_LINE 00000068 "$SIG{__WARN__} = sub {"
NSQ_SOURCE_LINE 00000069 "    if ($warnings_allowed or grep +($_[0] =~ $_), @allowed_patterns) {"
NSQ_SOURCE_LINE 00000070 "        Test::Builder->new->note($_[0]);"
NSQ_SOURCE_LINE 00000071 "    }"
NSQ_SOURCE_LINE 00000072 "    else {"
NSQ_SOURCE_LINE 00000073 "        $forbidden_warnings_found++;"
NSQ_SOURCE_LINE 00000074 "        push @collected_warnings, $_[0] if $report_warnings;"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "        # TODO: this doesn't handle blessed coderefs... does anyone care?"
NSQ_SOURCE_LINE 00000077 "        goto &$_orig_warn_handler if $_orig_warn_handler"
NSQ_SOURCE_LINE 00000078 "            and (  (ref $_orig_warn_handler eq 'CODE')"
NSQ_SOURCE_LINE 00000079 "                or ($_orig_warn_handler ne 'DEFAULT'"
NSQ_SOURCE_LINE 00000080 "                    and $_orig_warn_handler ne 'IGNORE'"
NSQ_SOURCE_LINE 00000081 "                    and defined &$_orig_warn_handler));"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "        if ($_[0] =~ /\\n$/) {"
NSQ_SOURCE_LINE 00000084 "            warn $_[0];"
NSQ_SOURCE_LINE 00000085 "        } else {"
NSQ_SOURCE_LINE 00000086 "            require Carp;"
NSQ_SOURCE_LINE 00000087 "            Carp::carp($_[0]);"
NSQ_SOURCE_LINE 00000088 "        }"
NSQ_SOURCE_LINE 00000089 "        _builder->ok(0, 'unexpected warning') if $fail_on_warning;"
NSQ_SOURCE_LINE 00000090 "    }"
NSQ_SOURCE_LINE 00000091 "};"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "sub warnings(;&) {"
NSQ_SOURCE_LINE 00000094 "    # if someone manually does warnings->import in the same namespace this is"
NSQ_SOURCE_LINE 00000095 "    # imported into, this sub will be called.  in that case, just return the"
NSQ_SOURCE_LINE 00000096 "    # string \"warnings\" so it calls the correct method."
NSQ_SOURCE_LINE 00000097 "    if (!@_) {"
NSQ_SOURCE_LINE 00000098 "        return 'warnings';"
NSQ_SOURCE_LINE 00000099 "    }"
NSQ_SOURCE_LINE 00000100 "    my $code = shift;"
NSQ_SOURCE_LINE 00000101 "    my @warnings;"
NSQ_SOURCE_LINE 00000102 "    local $SIG{__WARN__} = sub {"
NSQ_SOURCE_LINE 00000103 "        push @warnings, shift;"
NSQ_SOURCE_LINE 00000104 "    };"
NSQ_SOURCE_LINE 00000105 "    $code->();"
NSQ_SOURCE_LINE 00000106 "    @warnings;"
NSQ_SOURCE_LINE 00000107 "}"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "sub warning(&) {"
NSQ_SOURCE_LINE 00000110 "    my @warnings = &warnings(@_);"
NSQ_SOURCE_LINE 00000111 "    return @warnings == 1 ? $warnings[0] : \\@warnings;"
NSQ_SOURCE_LINE 00000112 "}"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "# check for any forbidden warnings, and record that we have done so"
NSQ_SOURCE_LINE 00000115 "# so we do not check again via END"
NSQ_SOURCE_LINE 00000116 "sub done_testing {"
NSQ_SOURCE_LINE 00000117 "    if (Test2::Tools::Basic->can('done_testing')) {"
NSQ_SOURCE_LINE 00000118 "        if (not $no_end_test and not $done_testing_called) {"
NSQ_SOURCE_LINE 00000119 "            # we could use $ctx to create the test, which means not having to adjust Level,"
NSQ_SOURCE_LINE 00000120 "            # but then we need to make _builder Test2-compatible, which seems like a PITA."
NSQ_SOURCE_LINE 00000121 "            local $Test::Builder::Level = $Test::Builder::Level + 3;"
NSQ_SOURCE_LINE 00000122 "            had_no_warnings('no (unexpected) warnings (via done_testing)');"
NSQ_SOURCE_LINE 00000123 "            $done_testing_called = 1;"
NSQ_SOURCE_LINE 00000124 "        }"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "        Test2::Tools::Basic::done_testing(@_);"
NSQ_SOURCE_LINE 00000127 "    }"
NSQ_SOURCE_LINE 00000128 "    elsif (Test::Builder->can('done_testing')) {"
NSQ_SOURCE_LINE 00000129 "        # only do this at the end of all tests, not at the end of a subtest"
NSQ_SOURCE_LINE 00000130 "        my $builder = _builder;"
NSQ_SOURCE_LINE 00000131 "        my $in_subtest_sub = $builder->can('in_subtest');"
NSQ_SOURCE_LINE 00000132 "        if (not $no_end_test and not $done_testing_called"
NSQ_SOURCE_LINE 00000133 "            and not ($in_subtest_sub ? $builder->$in_subtest_sub : $builder->parent)) {"
NSQ_SOURCE_LINE 00000134 "            local $Test::Builder::Level = $Test::Builder::Level + 3;"
NSQ_SOURCE_LINE 00000135 "            had_no_warnings('no (unexpected) warnings (via done_testing)');"
NSQ_SOURCE_LINE 00000136 "            $done_testing_called = 1;"
NSQ_SOURCE_LINE 00000137 "        }"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "        _builder->done_testing(@_);"
NSQ_SOURCE_LINE 00000140 "    }"
NSQ_SOURCE_LINE 00000141 "    else {"
NSQ_SOURCE_LINE 00000142 "        die 'no done_testing available via a Test module';"
NSQ_SOURCE_LINE 00000143 "    }"
NSQ_SOURCE_LINE 00000144 "}"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "# we also monkey-patch Test::Builder::done_testing (which is called by Test::More::done_testing),"
NSQ_SOURCE_LINE 00000147 "# in case Test::More was loaded after Test::Warnings and therefore its version of done_testing was"
NSQ_SOURCE_LINE 00000148 "# imported into the test rather than ours."
NSQ_SOURCE_LINE 00000149 "if (Test::Builder->can('done_testing')) {"
NSQ_SOURCE_LINE 00000150 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000151 "    my $orig = *{'Test::Builder::done_testing'}{CODE};"
NSQ_SOURCE_LINE 00000152 "    no warnings 'redefine';"
NSQ_SOURCE_LINE 00000153 "    *{'Test::Builder::done_testing'} = sub {"
NSQ_SOURCE_LINE 00000154 "        # only do this at the end of all tests, not at the end of a subtest"
NSQ_SOURCE_LINE 00000155 "        my $builder = _builder;"
NSQ_SOURCE_LINE 00000156 "        my $in_subtest_sub = $builder->can('in_subtest');"
NSQ_SOURCE_LINE 00000157 "        if (not $no_end_test and not $done_testing_called"
NSQ_SOURCE_LINE 00000158 "            and not ($in_subtest_sub ? $builder->$in_subtest_sub : $builder->parent)) {"
NSQ_SOURCE_LINE 00000159 "            local $Test::Builder::Level = $Test::Builder::Level + 3;"
NSQ_SOURCE_LINE 00000160 "            had_no_warnings('no (unexpected) warnings (via done_testing)');"
NSQ_SOURCE_LINE 00000161 "            $done_testing_called = 1;"
NSQ_SOURCE_LINE 00000162 "        }"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "        $orig->(@_);"
NSQ_SOURCE_LINE 00000165 "    };"
NSQ_SOURCE_LINE 00000166 "}"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "END {"
NSQ_SOURCE_LINE 00000169 "    if (not $no_end_test"
NSQ_SOURCE_LINE 00000170 "        and not $done_testing_called"
NSQ_SOURCE_LINE 00000171 "        # skip this if there is no plan and no tests have been run (e.g."
NSQ_SOURCE_LINE 00000172 "        # compilation tests of this module!)"
NSQ_SOURCE_LINE 00000173 "        and (_builder->expected_tests or _builder->current_test > 0)"
NSQ_SOURCE_LINE 00000174 "    ) {"
NSQ_SOURCE_LINE 00000175 "        local $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000176 "        had_no_warnings('no (unexpected) warnings (via END block)');"
NSQ_SOURCE_LINE 00000177 "    }"
NSQ_SOURCE_LINE 00000178 "}"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "# setter"
NSQ_SOURCE_LINE 00000181 "sub allow_warnings(;$) {"
NSQ_SOURCE_LINE 00000182 "    $warnings_allowed = @_ || defined $_[0] ? $_[0] : 1;"
NSQ_SOURCE_LINE 00000183 "}"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "# getter"
NSQ_SOURCE_LINE 00000186 "sub allowing_warnings() { $warnings_allowed }"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "# call at any time to assert no (unexpected) warnings so far"
NSQ_SOURCE_LINE 00000189 "sub had_no_warnings(;$) {"
NSQ_SOURCE_LINE 00000190 "    if ($ENV{PERL_TEST_WARNINGS_ONLY_REPORT_WARNINGS}) {"
NSQ_SOURCE_LINE 00000191 "        $forbidden_warnings_found"
NSQ_SOURCE_LINE 00000192 "            and _builder->diag(\"Found $forbidden_warnings_found warnings but allowing them because PERL_TEST_WARNINGS_ONLY_REPORT_WARNINGS is set\");"
NSQ_SOURCE_LINE 00000193 "    }"
NSQ_SOURCE_LINE 00000194 "    else {"
NSQ_SOURCE_LINE 00000195 "        _builder->ok(!$forbidden_warnings_found, shift || 'no (unexpected) warnings');"
NSQ_SOURCE_LINE 00000196 "    }"
NSQ_SOURCE_LINE 00000197 "    if (($report_warnings or $ENV{PERL_TEST_WARNINGS_ONLY_REPORT_WARNINGS})"
NSQ_SOURCE_LINE 00000198 "          and $forbidden_warnings_found) {"
NSQ_SOURCE_LINE 00000199 "        _builder->diag(\"Got the following unexpected warnings:\");"
NSQ_SOURCE_LINE 00000200 "        for my $i (1 .. @collected_warnings) {"
NSQ_SOURCE_LINE 00000201 "            _builder->diag(\"  $i: $collected_warnings[ $i - 1 ]\");"
NSQ_SOURCE_LINE 00000202 "        }"
NSQ_SOURCE_LINE 00000203 "    }"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "# pass one or more regexes (in qr format)"
NSQ_SOURCE_LINE 00000207 "# when called in void context, lasting effect is universal"
NSQ_SOURCE_LINE 00000208 "# otherwise, returns objects: when they go out of scope, the effect is removed"
NSQ_SOURCE_LINE 00000209 "#   (warning disallowed again)."
NSQ_SOURCE_LINE 00000210 "sub allow_patterns(@) {"
NSQ_SOURCE_LINE 00000211 "  push @allowed_patterns, @_;"
NSQ_SOURCE_LINE 00000212 "  return if not defined wantarray;"
NSQ_SOURCE_LINE 00000213 "  return [ map +Test::Warnings::TemporaryWarning->new($_), @_ ];"
NSQ_SOURCE_LINE 00000214 "}"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "sub disallow_patterns(@) {"
NSQ_SOURCE_LINE 00000217 "  foreach my $pattern (@_) {"
NSQ_SOURCE_LINE 00000218 "    @allowed_patterns = grep +($_ ne $pattern), @allowed_patterns;"
NSQ_SOURCE_LINE 00000219 "  }"
NSQ_SOURCE_LINE 00000220 "}"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "package # hide from PAUSE"
NSQ_SOURCE_LINE 00000223 "  Test::Warnings::TemporaryWarning;"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "sub new {"
NSQ_SOURCE_LINE 00000226 "  my ($class, $pattern) = @_;"
NSQ_SOURCE_LINE 00000227 "  bless \\$pattern, $class;"
NSQ_SOURCE_LINE 00000228 "}"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "sub DESTROY {"
NSQ_SOURCE_LINE 00000231 "  Test::Warnings::disallow_patterns(${$_[0]});"
NSQ_SOURCE_LINE 00000232 "}"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "1;"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "__END__"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=pod"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head1 NAME"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Test::Warnings - Test for warnings and the lack of them"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head1 VERSION"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "version 0.038"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    use Test::More;"
NSQ_SOURCE_LINE 00000253 "    use Test::Warnings;"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "    pass('yay!');"
NSQ_SOURCE_LINE 00000256 "    done_testing;"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "emits TAP:"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "    ok 1 - yay!"
NSQ_SOURCE_LINE 00000261 "    ok 2 - no (unexpected) warnings (via done_testing)"
NSQ_SOURCE_LINE 00000262 "    1..2"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "and:"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "    use Test::More tests => 3;"
NSQ_SOURCE_LINE 00000267 "    use Test::Warnings 0.005 ':all';"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "    pass('yay!');"
NSQ_SOURCE_LINE 00000270 "    like(warning { warn \"oh noes!\" }, qr/^oh noes/, 'we warned');"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "emits TAP:"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "    ok 1 - yay!"
NSQ_SOURCE_LINE 00000275 "    ok 2 - we warned"
NSQ_SOURCE_LINE 00000276 "    ok 3 - no (unexpected) warnings (via END block)"
NSQ_SOURCE_LINE 00000277 "    1..3"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "If you've ever tried to use L<Test::NoWarnings> to confirm there are no warnings"
NSQ_SOURCE_LINE 00000282 "generated by your tests, combined with the convenience of C<done_testing> to"
NSQ_SOURCE_LINE 00000283 "not have to declare a"
NSQ_SOURCE_LINE 00000284 "L<test count|Test::More/I love it-when-a-plan-comes-together>,"
NSQ_SOURCE_LINE 00000285 "you'll have discovered that these two features do not play well together,"
NSQ_SOURCE_LINE 00000286 "as the test count will be calculated I<before> the warnings test is run,"
NSQ_SOURCE_LINE 00000287 "resulting in a TAP error. (See C<examples/test_nowarnings.pl> in this"
NSQ_SOURCE_LINE 00000288 "distribution for a demonstration.)"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "This module is intended to be used as a drop-in replacement for"
NSQ_SOURCE_LINE 00000291 "L<Test::NoWarnings>: it also adds an extra test, but runs this test I<before>"
NSQ_SOURCE_LINE 00000292 "C<done_testing> calculates the test count, rather than after.  It does this by"
NSQ_SOURCE_LINE 00000293 "hooking into C<done_testing> as well as via an C<END> block.  You can declare"
NSQ_SOURCE_LINE 00000294 "a plan, or not, and things will still Just Work."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "It is actually equivalent to:"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "    use Test::NoWarnings 1.04 ':early';"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "as warnings are still printed normally as they occur.  You are safe, and"
NSQ_SOURCE_LINE 00000301 "enthusiastically encouraged, to perform a global search-replace of the above"
NSQ_SOURCE_LINE 00000302 "with C<use Test::Warnings;> whether or not your tests have a plan."
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "It can also be used as a replacement for L<Test::Warn>, if you wish to test"
NSQ_SOURCE_LINE 00000305 "the content of expected warnings; read on to find out how."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=for Pod::Coverage done_testing"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "The following functions are available for import (not included by default; you"
NSQ_SOURCE_LINE 00000312 "can also get all of them by importing the tag C<:all>):"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=head2 C<< allow_warnings([bool]) >> - EXPERIMENTAL - MAY BE REMOVED"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "When passed a true value, or no value at all, subsequent warnings will not"
NSQ_SOURCE_LINE 00000317 "result in a test failure; when passed a false value, subsequent warnings will"
NSQ_SOURCE_LINE 00000318 "result in a test failure.  Initial value is C<false>."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "When warnings are allowed, any warnings will instead be emitted via"
NSQ_SOURCE_LINE 00000321 "L<Test::Builder::note|Test::Builder/Output>."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "=head2 C<allowing_warnings> - EXPERIMENTAL - MAY BE REMOVED"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "Returns whether we are currently allowing warnings (set by C<allow_warnings>"
NSQ_SOURCE_LINE 00000326 "as described above)."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=head2 C<< had_no_warnings(<optional test name>) >>"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "Tests whether there have been any warnings so far, not preceded by an"
NSQ_SOURCE_LINE 00000331 "C<allowing_warnings> call.  It is run"
NSQ_SOURCE_LINE 00000332 "automatically at the end of all tests, but can also be called manually at any"
NSQ_SOURCE_LINE 00000333 "time, as often as desired."
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "=head2 C<< warnings( { code } ) >>"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "Given a code block, runs the block and returns a list of all the"
NSQ_SOURCE_LINE 00000338 "(not previously allowed via C<allow_warnings>) warnings issued within.  This"
NSQ_SOURCE_LINE 00000339 "lets you test for the presence of warnings that you not only would I<allow>,"
NSQ_SOURCE_LINE 00000340 "but I<must> be issued.  Testing functions are not provided; given the strings"
NSQ_SOURCE_LINE 00000341 "returned, you can test these yourself using your favourite testing functions,"
NSQ_SOURCE_LINE 00000342 "such as L<Test::More::is|Test::More/is> or L<Test::Deep::cmp_deeply|Test::Deep/cmp_deeply>."
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "You can use this construct as a replacement for"
NSQ_SOURCE_LINE 00000345 "L<Test::Warn::warnings_are|Test::Warn/warnings_are>:"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "    is_deeply("
NSQ_SOURCE_LINE 00000348 "        [ warnings { ... } ],"
NSQ_SOURCE_LINE 00000349 "        ["
NSQ_SOURCE_LINE 00000350 "            'warning message 1',"
NSQ_SOURCE_LINE 00000351 "            'warning message 2',"
NSQ_SOURCE_LINE 00000352 "        ],"
NSQ_SOURCE_LINE 00000353 "        'got expected warnings',"
NSQ_SOURCE_LINE 00000354 "    );"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "or, to replace L<Test::Warn::warnings_like|Test::Warn/warnings_like>:"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "    cmp_deeply("
NSQ_SOURCE_LINE 00000359 "        [ warnings { ... } ],"
NSQ_SOURCE_LINE 00000360 "        bag(    # ordering of messages doesn't matter"
NSQ_SOURCE_LINE 00000361 "            re(qr/warning message 1/),"
NSQ_SOURCE_LINE 00000362 "            re(qr/warning message 2/),"
NSQ_SOURCE_LINE 00000363 "        ),"
NSQ_SOURCE_LINE 00000364 "        'got expected warnings (in any order)',"
NSQ_SOURCE_LINE 00000365 "    );"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "Warnings generated by this code block are I<NOT> propagated further. However,"
NSQ_SOURCE_LINE 00000368 "since they are returned from this function with their filename and line"
NSQ_SOURCE_LINE 00000369 "numbers intact, you can re-issue them yourself immediately after calling"
NSQ_SOURCE_LINE 00000370 "C<warnings(...)>, if desired."
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "Note that C<use Test::Warnings 'warnings'> will give you a C<warnings>"
NSQ_SOURCE_LINE 00000373 "subroutine in your namespace (most likely C<main>, if you're writing a test),"
NSQ_SOURCE_LINE 00000374 "so you (or things you load) can't subsequently do C<< warnings->import >> --"
NSQ_SOURCE_LINE 00000375 "it will result in the error: \"Not enough arguments for"
NSQ_SOURCE_LINE 00000376 "Test::Warnings::warnings at ..., near \"warnings->import\"\".  To work around"
NSQ_SOURCE_LINE 00000377 "this, either use the fully-qualified form (C<Test::warnings>) or make your"
NSQ_SOURCE_LINE 00000378 "calls to the C<warnings> package first."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=head2 C<< warning( { code } ) >>"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "Same as C<< warnings( { code } ) >>, except a scalar is always returned - the"
NSQ_SOURCE_LINE 00000383 "single warning produced, if there was one, or an arrayref otherwise -- which"
NSQ_SOURCE_LINE 00000384 "can be more convenient to use than C<warnings()> if you are expecting exactly"
NSQ_SOURCE_LINE 00000385 "one warning."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "However, you are advised to capture the result from C<warning()> into a temp"
NSQ_SOURCE_LINE 00000388 "variable so you can dump its value if it doesn't contain what you expect."
NSQ_SOURCE_LINE 00000389 "e.g. with this test:"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "    like("
NSQ_SOURCE_LINE 00000392 "        warning { foo() },"
NSQ_SOURCE_LINE 00000393 "        qr/^this is a warning/,"
NSQ_SOURCE_LINE 00000394 "        'got a warning from foo()',"
NSQ_SOURCE_LINE 00000395 "    );"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "if you get two warnings (or none) back instead of one, you'll get an"
NSQ_SOURCE_LINE 00000398 "arrayref, which will result in an unhelpful test failure message like:"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "    #   Failed test 'got a warning from foo()'"
NSQ_SOURCE_LINE 00000401 "    #   at t/mytest.t line 10."
NSQ_SOURCE_LINE 00000402 "    #                   'ARRAY(0xdeadbeef)'"
NSQ_SOURCE_LINE 00000403 "    #     doesn't match '(?^:^this is a warning)'"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "So instead, change your test to:"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "    my $warning = warning { foo() };"
NSQ_SOURCE_LINE 00000408 "    like("
NSQ_SOURCE_LINE 00000409 "        $warning,"
NSQ_SOURCE_LINE 00000410 "        qr/^this is a warning/,"
NSQ_SOURCE_LINE 00000411 "        'got a warning from foo()',"
NSQ_SOURCE_LINE 00000412 "    ) or diag 'got warning(s): ', explain($warning);"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "=head2 allow_patterns"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "  allow_patterns(qr/always allow this warning/);"
NSQ_SOURCE_LINE 00000417 "  {"
NSQ_SOURCE_LINE 00000418 "    my $temp = allow_patterns(qr/only allow in this scope/, qr/another temporary warning/);"
NSQ_SOURCE_LINE 00000419 "    ... stuff ..."
NSQ_SOURCE_LINE 00000420 "  }"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "Given one or more regular expressions, in C<qr/.../> form, add them to the allow-list (warnings will"
NSQ_SOURCE_LINE 00000423 "be emitted with C<note> rather than triggering the warning handler). If the return value is saved in"
NSQ_SOURCE_LINE 00000424 "a local variable, the warning exemption will only be in effect for that local scope (the addition is"
NSQ_SOURCE_LINE 00000425 "reversed at the end of the scope); otherwise, the effect is global."
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "=head2 disallow_patterns"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "Given one or more regular expressions, in C<qr/.../> form, remove it from the allow-list. The"
NSQ_SOURCE_LINE 00000430 "pattern must exactly match a pattern previously provided to L</allow_patterns>."
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "=head1 IMPORT OPTIONS"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "=head2 C<:all>"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "Imports all functions listed above"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "=head2 C<:no_end_test>"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "Disables the addition of a C<had_no_warnings> test"
NSQ_SOURCE_LINE 00000441 "via C<END> or C<done_testing>"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "=head2 C<:fail_on_warning>"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=for stopwords unexempted"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "When used, fail immediately when an unexempted warning is generated (as opposed to waiting until"
NSQ_SOURCE_LINE 00000448 "L</had_no_warnings> or C<done_testing> is called)."
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "I recommend you only turn this option on when debugging a test, to see where a surprise warning is coming from,"
NSQ_SOURCE_LINE 00000451 "and rely on the end-of-tests check otherwise."
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "=head2 C<:report_warnings>"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "When used, C<had_no_warnings()> will print all the unexempted warning content, in case it had been suppressed"
NSQ_SOURCE_LINE 00000456 "earlier by other captures (such as L<Test::Output/stderr_like> or L<Capture::Tiny/capture>)."
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "=head1 OTHER OPTIONS"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "You can temporarily turn off the failure behaviour of this module, swapping it out for reporting"
NSQ_SOURCE_LINE 00000461 "(see C<:report_warnings> above) with:"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "  $ENV{PERL_TEST_WARNINGS_ONLY_REPORT_WARNINGS} = 1;"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "This can be useful for working around problematic modules that have warnings in newer Perl versions."
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=for stopwords smartmatch TODO irc"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "Sometimes new warnings can appear in Perl that should B<not> block"
NSQ_SOURCE_LINE 00000472 "installation -- for example, smartmatch was recently deprecated in"
NSQ_SOURCE_LINE 00000473 "perl 5.17.11, so now any distribution that uses smartmatch and also"
NSQ_SOURCE_LINE 00000474 "tests for warnings cannot be installed under 5.18.0.  You might want to"
NSQ_SOURCE_LINE 00000475 "consider only making warnings fail tests in an author environment -- you can"
NSQ_SOURCE_LINE 00000476 "do this with the L<if> pragma:"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "    use if $ENV{AUTHOR_TESTING} || $ENV{RELEASE_TESTING}, 'Test::Warnings';"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "In future versions of this module, when interfaces are added to test the"
NSQ_SOURCE_LINE 00000481 "content of warnings, there will likely be additional sugar available to"
NSQ_SOURCE_LINE 00000482 "indicate that warnings should be checked only in author tests (or TODO when"
NSQ_SOURCE_LINE 00000483 "not in author testing), but will still provide exported subs.  Comments are"
NSQ_SOURCE_LINE 00000484 "enthusiastically solicited - drop me an email, write up an RT ticket, or come"
NSQ_SOURCE_LINE 00000485 "by C<#perl-qa> on irc!"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=for stopwords Achtung"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "B<Achtung!>  This is not a great idea:"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "    sub warning_like(&$;$) {"
NSQ_SOURCE_LINE 00000492 "        my ($code, $pattern, $name) = @_;"
NSQ_SOURCE_LINE 00000493 "        like( &warning($code), $pattern, $name );"
NSQ_SOURCE_LINE 00000494 "    }"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "    warning_like( { ... }, qr/foo/, 'foo appears in the warning' );"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "If the code in the C<{ ... }> is going to warn with a stack trace with the"
NSQ_SOURCE_LINE 00000499 "arguments to each subroutine in its call stack (for example via C<Carp::cluck>),"
NSQ_SOURCE_LINE 00000500 "the test name, \"foo appears in the warning\" will itself be matched by the"
NSQ_SOURCE_LINE 00000501 "regex (see F<examples/warning_like.t>).  Instead, write this:"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "  like( warning { ... }, qr/foo/, 'foo appears in the warning' );"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "If you are using another module that sets its own warning handler (for example L<Devel::Confess> or"
NSQ_SOURCE_LINE 00000508 "L<diagnostics>) your results may be mixed, as those handlers will interfere with this module's"
NSQ_SOURCE_LINE 00000509 "ability to properly detect and capture warnings in their original form."
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=head1 TO DO (or: POSSIBLE FEATURES COMING IN FUTURE RELEASES)"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "=over"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "=item * C<< allow_warnings(qr/.../) >> - allow some warnings and not others"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=for stopwords subtest subtests"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "=item * more sophisticated handling in subtests - if we save some state on the"
NSQ_SOURCE_LINE 00000520 "L<Test::Builder> object itself, we can allow warnings in a subtest and then"
NSQ_SOURCE_LINE 00000521 "the state will revert when the subtest ends, as well as check for warnings at"
NSQ_SOURCE_LINE 00000522 "the end of every subtest via C<done_testing>."
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "=item * sugar for making failures TODO when testing outside an author"
NSQ_SOURCE_LINE 00000525 "environment"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "=back"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000530 ""
