NSQ_SOURCE_LINE 00000001 "package Regexp::IPv4;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2016-10-18'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.003'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use strict;"
NSQ_SOURCE_LINE 00000007 "use warnings;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000010 "our @EXPORT_OK = qw($IPv4_re);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "my $dig_re = '(?:25[0-5]|2[0-4][0-9]|[0-1]?[0-9]{1,2})';"
NSQ_SOURCE_LINE 00000013 "our $IPv4_re = \"(?:$dig_re(?:\\\\.$dig_re){3})\";"
NSQ_SOURCE_LINE 00000014 "$IPv4_re = qr/$IPv4_re/;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "1;"
NSQ_SOURCE_LINE 00000017 "# ABSTRACT: Regular expression for IPv4 addresses"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "__END__"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "=pod"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "=head1 NAME"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "Regexp::IPv4 - Regular expression for IPv4 addresses"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "=head1 VERSION"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "This document describes version 0.003 of Regexp::IPv4 (from Perl distribution Regexp-IPv4), released on 2016-10-18."
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 " use Regexp::IPv4 qw($IPv4_re);"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 " $address =~ /^$IPv4_re$/ and print \"IPv4 address\\n\";"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "The regex only recognizes the quad-dotted notation of four decimal integers,"
NSQ_SOURCE_LINE 00000042 "ranging from 0 to 255 each. Other notations like 32-bit hexadecimal number (e.g."
NSQ_SOURCE_LINE 00000043 "0xFF0000) or shortened dotted notation (e.g. 255.0.0) are not recognized."
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "If you do not use anchor, beware of cases like:"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 " \"255.255.255.256\" =~ /($IPv4_re)/; # true & capture \"255.255.255.25\""
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "Please visit the project's homepage at L<https://metacpan.org/release/Regexp-IPv4>."
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "Source repository is at L<https://github.com/perlancar/perl-Regexp-IPv4>."
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=head1 BUGS"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=Regexp-IPv4>"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000062 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000063 "feature."
