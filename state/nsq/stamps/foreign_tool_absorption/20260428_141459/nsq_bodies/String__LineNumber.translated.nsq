NSQ_SOURCE_LINE 00000001 "package String::LineNumber;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2014-12-10'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.01'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter;"
NSQ_SOURCE_LINE 00000011 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000013 "                       linenum"
NSQ_SOURCE_LINE 00000014 "               );"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub linenum {"
NSQ_SOURCE_LINE 00000017 "    my ($str, $opts) = @_;"
NSQ_SOURCE_LINE 00000018 "    $opts //= {};"
NSQ_SOURCE_LINE 00000019 "    $opts->{width}      //= 4;"
NSQ_SOURCE_LINE 00000020 "    $opts->{zeropad}    //= 0;"
NSQ_SOURCE_LINE 00000021 "    $opts->{skip_empty} //= 1;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    my $i = 0;"
NSQ_SOURCE_LINE 00000024 "    $str =~ s/^(([\\t ]*\\S)?.*)/"
NSQ_SOURCE_LINE 00000025 "        sprintf(join(\"\","
NSQ_SOURCE_LINE 00000026 "                     \"%\","
NSQ_SOURCE_LINE 00000027 "                     ($opts->{zeropad} && !($opts->{skip_empty}"
NSQ_SOURCE_LINE 00000028 "                                                && !defined($2)) ? \"0\" : \"\"),"
NSQ_SOURCE_LINE 00000029 "                     $opts->{width}, \"s\","
NSQ_SOURCE_LINE 00000030 "                     \"|%s\"),"
NSQ_SOURCE_LINE 00000031 "                ++$i && $opts->{skip_empty} && !defined($2) ? \"\" : $i,"
NSQ_SOURCE_LINE 00000032 "                $1)/meg;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    $str;"
NSQ_SOURCE_LINE 00000035 "}"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "1;"
NSQ_SOURCE_LINE 00000038 "# ABSTRACT: Give line number to each line of string"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "__END__"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=pod"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=head1 NAME"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "String::LineNumber - Give line number to each line of string"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "=head1 VERSION"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "This document describes version 0.01 of String::LineNumber (from Perl distribution String-LineNumber), released on 2014-12-10."
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=head2 linenum($str, \\%opts) => STR"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "Add line numbers. For example:"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "     1|line1"
NSQ_SOURCE_LINE 00000061 "     2|line2"
NSQ_SOURCE_LINE 00000062 "      |"
NSQ_SOURCE_LINE 00000063 "     4|line4"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "Known options:"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=over 4"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "=item * width => INT (default: 4)"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=item * zeropad => BOOL (default: 0)"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "If turned on, will output something like:"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "  0001|line1"
NSQ_SOURCE_LINE 00000076 "  0002|line2"
NSQ_SOURCE_LINE 00000077 "      |"
NSQ_SOURCE_LINE 00000078 "  0004|line4"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=item * skip_empty => BOOL (default: 1)"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "If set to false, keep printing line number even if line is empty:"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "     1|line1"
NSQ_SOURCE_LINE 00000085 "     2|line2"
NSQ_SOURCE_LINE 00000086 "     3|"
NSQ_SOURCE_LINE 00000087 "     4|line4"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=back"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000092 ""
