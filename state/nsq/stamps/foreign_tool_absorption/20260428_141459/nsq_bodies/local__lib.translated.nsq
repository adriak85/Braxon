NSQ_SOURCE_LINE 00000452 "sub setup_env_hash {"
NSQ_SOURCE_LINE 00000453 "  my $self = shift;"
NSQ_SOURCE_LINE 00000454 "  my %env = $self->build_environment_vars;"
NSQ_SOURCE_LINE 00000455 "  for my $key (keys %env) {"
NSQ_SOURCE_LINE 00000456 "    if (defined $env{$key}) {"
NSQ_SOURCE_LINE 00000457 "      $ENV{$key} = $env{$key};"
NSQ_SOURCE_LINE 00000458 "    }"
NSQ_SOURCE_LINE 00000459 "    else {"
NSQ_SOURCE_LINE 00000460 "      delete $ENV{$key};"
NSQ_SOURCE_LINE 00000461 "    }"
NSQ_SOURCE_LINE 00000462 "  }"
NSQ_SOURCE_LINE 00000463 "}"
NSQ_SOURCE_LINE 00000464 ""
