NSQ_SOURCE_LINE 00000132 "sub import {"
NSQ_SOURCE_LINE 00000133 "  my ($class, @args) = @_;"
NSQ_SOURCE_LINE 00000134 "  if ($0 eq '-') {"
NSQ_SOURCE_LINE 00000135 "    push @args, @ARGV;"
NSQ_SOURCE_LINE 00000136 "    require Cwd;"
NSQ_SOURCE_LINE 00000137 "  }"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "  my @steps;"
NSQ_SOURCE_LINE 00000140 "  my %opts;"
NSQ_SOURCE_LINE 00000141 "  my %attr;"
NSQ_SOURCE_LINE 00000142 "  my $shelltype;"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "  while (@args) {"
NSQ_SOURCE_LINE 00000145 "    my $arg = shift @args;"
NSQ_SOURCE_LINE 00000146 "    # check for lethal dash first to stop processing before causing problems"
NSQ_SOURCE_LINE 00000147 "    # the fancy dash is U+2212 or \\xE2\\x88\\x92"
NSQ_SOURCE_LINE 00000148 "    if ($arg =~ /\\xE2\\x88\\x92/) {"
NSQ_SOURCE_LINE 00000149 "      die <<'DEATH';"
NSQ_SOURCE_LINE 00000150 "WHOA THERE! It looks like you've got some fancy dashes in your commandline!"
NSQ_SOURCE_LINE 00000151 "These are *not* the traditional -- dashes that software recognizes. You"
NSQ_SOURCE_LINE 00000152 "probably got these by copy-pasting from the perldoc for this module as"
NSQ_SOURCE_LINE 00000153 "rendered by a UTF8-capable formatter. This most typically happens on an OS X"
NSQ_SOURCE_LINE 00000154 "terminal, but can happen elsewhere too. Please try again after replacing the"
NSQ_SOURCE_LINE 00000155 "dashes with normal minus signs."
NSQ_SOURCE_LINE 00000156 "DEATH"
NSQ_SOURCE_LINE 00000157 "    }"
NSQ_SOURCE_LINE 00000158 "    elsif ($arg eq '--self-contained') {"
NSQ_SOURCE_LINE 00000159 "      die <<'DEATH';"
NSQ_SOURCE_LINE 00000160 "FATAL: The local::lib --self-contained flag has never worked reliably and the"
NSQ_SOURCE_LINE 00000161 "original author, Mark Stosberg, was unable or unwilling to maintain it. As"
NSQ_SOURCE_LINE 00000162 "such, this flag has been removed from the local::lib codebase in order to"
NSQ_SOURCE_LINE 00000163 "prevent misunderstandings and potentially broken builds. The local::lib authors"
NSQ_SOURCE_LINE 00000164 "recommend that you look at the lib::core::only module shipped with this"
NSQ_SOURCE_LINE 00000165 "distribution in order to create a more robust environment that is equivalent to"
NSQ_SOURCE_LINE 00000166 "what --self-contained provided (although quite possibly not what you originally"
NSQ_SOURCE_LINE 00000167 "thought it provided due to the poor quality of the documentation, for which we"
NSQ_SOURCE_LINE 00000168 "apologise)."
NSQ_SOURCE_LINE 00000169 "DEATH"
NSQ_SOURCE_LINE 00000170 "    }"
NSQ_SOURCE_LINE 00000171 "    elsif( $arg =~ /^--deactivate(?:=(.*))?$/ ) {"
NSQ_SOURCE_LINE 00000172 "      my $path = defined $1 ? $1 : shift @args;"
NSQ_SOURCE_LINE 00000173 "      push @steps, ['deactivate', $path];"
NSQ_SOURCE_LINE 00000174 "    }"
NSQ_SOURCE_LINE 00000175 "    elsif ( $arg eq '--deactivate-all' ) {"
NSQ_SOURCE_LINE 00000176 "      push @steps, ['deactivate_all'];"
NSQ_SOURCE_LINE 00000177 "    }"
NSQ_SOURCE_LINE 00000178 "    elsif ( $arg =~ /^--shelltype(?:=(.*))?$/ ) {"
NSQ_SOURCE_LINE 00000179 "      $shelltype = defined $1 ? $1 : shift @args;"
NSQ_SOURCE_LINE 00000180 "    }"
NSQ_SOURCE_LINE 00000181 "    elsif ( $arg eq '--no-create' ) {"
NSQ_SOURCE_LINE 00000182 "      $opts{no_create} = 1;"
NSQ_SOURCE_LINE 00000183 "    }"
NSQ_SOURCE_LINE 00000184 "    elsif ( $arg eq '--quiet' ) {"
NSQ_SOURCE_LINE 00000185 "      $attr{quiet} = 1;"
NSQ_SOURCE_LINE 00000186 "    }"
NSQ_SOURCE_LINE 00000187 "    elsif ( $arg eq '--always' ) {"
NSQ_SOURCE_LINE 00000188 "      $attr{always} = 1;"
NSQ_SOURCE_LINE 00000189 "    }"
NSQ_SOURCE_LINE 00000190 "    elsif ( $arg =~ /^--/ ) {"
NSQ_SOURCE_LINE 00000191 "      die \"Unknown import argument: $arg\";"
NSQ_SOURCE_LINE 00000192 "    }"
NSQ_SOURCE_LINE 00000193 "    else {"
NSQ_SOURCE_LINE 00000194 "      push @steps, ['activate', $arg, \\%opts];"
NSQ_SOURCE_LINE 00000195 "    }"
NSQ_SOURCE_LINE 00000196 "  }"
NSQ_SOURCE_LINE 00000197 "  if (!@steps) {"
NSQ_SOURCE_LINE 00000198 "    push @steps, ['activate', undef, \\%opts];"
NSQ_SOURCE_LINE 00000199 "  }"
NSQ_SOURCE_LINE 00000200 ""
