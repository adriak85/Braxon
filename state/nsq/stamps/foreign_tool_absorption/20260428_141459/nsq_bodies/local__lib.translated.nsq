NSQ_SOURCE_LINE 00000367 "sub activate {"
NSQ_SOURCE_LINE 00000368 "  my ($self, $path, $opts) = @_;"
NSQ_SOURCE_LINE 00000369 "  $opts ||= {};"
NSQ_SOURCE_LINE 00000370 "  $self = $self->new unless ref $self;"
NSQ_SOURCE_LINE 00000371 "  $path = $self->resolve_path($path);"
NSQ_SOURCE_LINE 00000372 "  $self->ensure_dir_structure_for($path, { quiet => $self->quiet })"
NSQ_SOURCE_LINE 00000373 "    unless $opts->{no_create};"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "  $path = $self->normalize_path($path);"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "  my @active_lls = $self->active_paths;"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "  if (grep { $_ eq $path } @active_lls[1 .. $#active_lls]) {"
NSQ_SOURCE_LINE 00000380 "    $self = $self->deactivate($path);"
NSQ_SOURCE_LINE 00000381 "  }"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "  my %args;"
