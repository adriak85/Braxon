NSQ_SOURCE_LINE 00000315 "sub deactivate {"
NSQ_SOURCE_LINE 00000316 "  my ($self, $path) = @_;"
NSQ_SOURCE_LINE 00000317 "  $self = $self->new unless ref $self;"
NSQ_SOURCE_LINE 00000318 "  $path = $self->resolve_path($path);"
NSQ_SOURCE_LINE 00000319 "  $path = $self->normalize_path($path);"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "  my @active_lls = $self->active_paths;"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "  if (!grep { $_ eq $path } @active_lls) {"
NSQ_SOURCE_LINE 00000324 "    warn \"Tried to deactivate inactive local::lib '$path'\\n\";"
NSQ_SOURCE_LINE 00000325 "    return $self;"
NSQ_SOURCE_LINE 00000326 "  }"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "  my %args = ("
NSQ_SOURCE_LINE 00000329 "    bins  => [ _remove_from($self->bins,"
NSQ_SOURCE_LINE 00000330 "      $self->install_base_bin_path($path)) ],"
NSQ_SOURCE_LINE 00000331 "    libs  => [ _remove_from($self->libs,"
NSQ_SOURCE_LINE 00000332 "      $self->install_base_perl_path($path)) ],"
NSQ_SOURCE_LINE 00000333 "    inc   => [ _remove_from($self->inc,"
NSQ_SOURCE_LINE 00000334 "      $self->lib_paths_for($path)) ],"
NSQ_SOURCE_LINE 00000335 "    roots => [ _remove_from($self->roots, $path) ],"
NSQ_SOURCE_LINE 00000336 "  );"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "  $args{extra} = { $self->installer_options_for($args{roots}[0]) };"
