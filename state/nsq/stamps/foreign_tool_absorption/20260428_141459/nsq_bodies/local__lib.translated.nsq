NSQ_SOURCE_LINE 00000026 "my $_path_sep = $Config::Config{path_sep};"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "our $_DIR_JOIN = _WIN32 ? '\\\\' : '/';"
NSQ_SOURCE_LINE 00000029 "our $_DIR_SPLIT = (_WIN32 || $^O eq 'cygwin') ? qr{[\\\\/]}"
NSQ_SOURCE_LINE 00000030 "                                              : qr{/};"
NSQ_SOURCE_LINE 00000031 "our $_ROOT = _WIN32 ? do {"
NSQ_SOURCE_LINE 00000032 "  my $UNC = qr{[\\\\/]{2}[^\\\\/]+[\\\\/][^\\\\/]+};"
NSQ_SOURCE_LINE 00000033 "  qr{^(?:$UNC|[A-Za-z]:|)$_DIR_SPLIT};"
NSQ_SOURCE_LINE 00000034 "} : qr{^/};"
NSQ_SOURCE_LINE 00000035 "our $_PERL;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub _perl {"
NSQ_SOURCE_LINE 00000038 "  if (!$_PERL) {"
NSQ_SOURCE_LINE 00000039 "    # untaint and validate"
NSQ_SOURCE_LINE 00000040 "    ($_PERL, my $exe) = $^X =~ /((?:.*$_DIR_SPLIT)?(.+))/;"
NSQ_SOURCE_LINE 00000041 "    $_PERL = 'perl'"
NSQ_SOURCE_LINE 00000042 "      if $exe !~ /perl/;"
NSQ_SOURCE_LINE 00000043 "    if (_is_abs($_PERL)) {"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 "    elsif (-x $Config::Config{perlpath}) {"
NSQ_SOURCE_LINE 00000046 "      $_PERL = $Config::Config{perlpath};"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 "    elsif ($_PERL =~ $_DIR_SPLIT && -x $_PERL) {"
NSQ_SOURCE_LINE 00000049 "      $_PERL = _rel2abs($_PERL);"
NSQ_SOURCE_LINE 00000050 "    }"
NSQ_SOURCE_LINE 00000051 "    else {"
NSQ_SOURCE_LINE 00000052 "      ($_PERL) ="
NSQ_SOURCE_LINE 00000053 "        map { /(.*)/ }"
NSQ_SOURCE_LINE 00000054 "        grep { -x $_ }"
NSQ_SOURCE_LINE 00000055 "        map { ($_, _WIN32 ? (\"$_.exe\") : ()) }"
NSQ_SOURCE_LINE 00000056 "        map { join($_DIR_JOIN, $_, $_PERL) }"
NSQ_SOURCE_LINE 00000057 "        split /\\Q$_path_sep\\E/, $ENV{PATH};"
NSQ_SOURCE_LINE 00000058 "    }"
NSQ_SOURCE_LINE 00000059 "  }"
NSQ_SOURCE_LINE 00000060 "  $_PERL;"
NSQ_SOURCE_LINE 00000061 "}"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "sub _cwd {"
NSQ_SOURCE_LINE 00000064 "  if (my $cwd"
NSQ_SOURCE_LINE 00000065 "    = defined &Cwd::sys_cwd ? \\&Cwd::sys_cwd"
NSQ_SOURCE_LINE 00000066 "    : defined &Cwd::cwd     ? \\&Cwd::cwd"
NSQ_SOURCE_LINE 00000067 "    : undef"
NSQ_SOURCE_LINE 00000068 "  ) {"
NSQ_SOURCE_LINE 00000069 "    no warnings 'redefine';"
NSQ_SOURCE_LINE 00000070 "    *_cwd = $cwd;"
NSQ_SOURCE_LINE 00000071 "    goto &$cwd;"
NSQ_SOURCE_LINE 00000072 "  }"
NSQ_SOURCE_LINE 00000073 "  my $drive = shift;"
NSQ_SOURCE_LINE 00000074 "  return Win32::GetCwd()"
NSQ_SOURCE_LINE 00000075 "    if _WIN32 && defined &Win32::GetCwd && !$drive;"
NSQ_SOURCE_LINE 00000076 "  local @ENV{qw(PATH IFS CDPATH ENV BASH_ENV)};"
NSQ_SOURCE_LINE 00000077 "  delete @ENV{qw(PATH IFS CDPATH ENV BASH_ENV)};"
NSQ_SOURCE_LINE 00000078 "  my $cmd = $drive ? \"eval { Cwd::getdcwd(q($drive)) }\""
NSQ_SOURCE_LINE 00000079 "                   : 'getcwd';"
NSQ_SOURCE_LINE 00000080 "  my $perl = _perl;"
NSQ_SOURCE_LINE 00000081 "  my $cwd = `\"$perl\" -MCwd -le \"print $cmd\"`;"
NSQ_SOURCE_LINE 00000082 "  chomp $cwd;"
NSQ_SOURCE_LINE 00000083 "  if (!length $cwd && $drive) {"
NSQ_SOURCE_LINE 00000084 "    $cwd = $drive;"
NSQ_SOURCE_LINE 00000085 "  }"
NSQ_SOURCE_LINE 00000086 "  $cwd =~ s/$_DIR_SPLIT?$/$_DIR_JOIN/;"
NSQ_SOURCE_LINE 00000087 "  $cwd;"
NSQ_SOURCE_LINE 00000088 "}"
