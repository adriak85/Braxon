NSQ_SOURCE_LINE 00000473 "sub environment_vars_string {"
NSQ_SOURCE_LINE 00000474 "  my ($self, $shelltype) = @_;"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "  $shelltype ||= $self->guess_shelltype;"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "  my $extra = $self->extra;"
NSQ_SOURCE_LINE 00000479 "  my @envs = ("
NSQ_SOURCE_LINE 00000480 "    PATH                => $self->bins,"
NSQ_SOURCE_LINE 00000481 "    PERL5LIB            => $self->libs,"
NSQ_SOURCE_LINE 00000482 "    PERL_LOCAL_LIB_ROOT => $self->roots,"
NSQ_SOURCE_LINE 00000483 "    map { $_ => $extra->{$_} } sort keys %$extra,"
NSQ_SOURCE_LINE 00000484 "  );"
NSQ_SOURCE_LINE 00000485 "  $self->_build_env_string($shelltype, \\@envs);"
NSQ_SOURCE_LINE 00000486 "}"
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "sub _build_env_string {"
NSQ_SOURCE_LINE 00000489 "  my ($self, $shelltype, $envs) = @_;"
NSQ_SOURCE_LINE 00000490 "  my @envs = @$envs;"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "  my $build_method = \"build_${shelltype}_env_declaration\";"
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "  my $out = '';"
NSQ_SOURCE_LINE 00000495 "  while (@envs) {"
NSQ_SOURCE_LINE 00000496 "    my ($name, $value) = (shift(@envs), shift(@envs));"
NSQ_SOURCE_LINE 00000497 "    if ("
NSQ_SOURCE_LINE 00000498 "        ref $value"
NSQ_SOURCE_LINE 00000499 "        && @$value == 1"
NSQ_SOURCE_LINE 00000500 "        && ref $value->[0]"
NSQ_SOURCE_LINE 00000501 "        && ref $value->[0] eq 'SCALAR'"
NSQ_SOURCE_LINE 00000502 "        && ${$value->[0]} eq $name) {"
NSQ_SOURCE_LINE 00000503 "      next;"
NSQ_SOURCE_LINE 00000504 "    }"
NSQ_SOURCE_LINE 00000505 "    $out .= $self->$build_method($name, $value);"
NSQ_SOURCE_LINE 00000506 "  }"
NSQ_SOURCE_LINE 00000507 "  my $wrap_method = \"wrap_${shelltype}_output\";"
NSQ_SOURCE_LINE 00000508 "  if ($self->can($wrap_method)) {"
NSQ_SOURCE_LINE 00000509 "    return $self->$wrap_method($out);"
NSQ_SOURCE_LINE 00000510 "  }"
NSQ_SOURCE_LINE 00000511 "  return $out;"
NSQ_SOURCE_LINE 00000512 "}"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "sub build_bourne_env_declaration {"
NSQ_SOURCE_LINE 00000515 "  my ($class, $name, $args) = @_;"
NSQ_SOURCE_LINE 00000516 "  my $value = $class->_interpolate($args, '${%s:-}', qr/[\"\\\\\\$!`]/, '\\\\%s');"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "  if (!defined $value) {"
NSQ_SOURCE_LINE 00000519 "    return qq{unset $name;\\n};"
NSQ_SOURCE_LINE 00000520 "  }"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "  $value =~ s/(^|\\G|$_path_sep)\\$\\{$name:-\\}$_path_sep/$1\\${$name}\\${$name:+$_path_sep}/g;"
NSQ_SOURCE_LINE 00000523 "  $value =~ s/$_path_sep\\$\\{$name:-\\}$/\\${$name:+$_path_sep\\${$name}}/;"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "  qq{${name}=\"$value\"; export ${name};\\n}"
NSQ_SOURCE_LINE 00000526 "}"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "sub build_csh_env_declaration {"
NSQ_SOURCE_LINE 00000529 "  my ($class, $name, $args) = @_;"
NSQ_SOURCE_LINE 00000530 "  my ($value, @vars) = $class->_interpolate($args, '${%s}', qr/[\"\\$]/, '\"\\\\%s\"');"
NSQ_SOURCE_LINE 00000531 "  if (!defined $value) {"
NSQ_SOURCE_LINE 00000532 "    return qq{unsetenv $name;\\n};"
NSQ_SOURCE_LINE 00000533 "  }"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "  my $out = '';"
NSQ_SOURCE_LINE 00000536 "  for my $var (@vars) {"
NSQ_SOURCE_LINE 00000537 "    $out .= qq{if ! \\$?$name setenv $name '';\\n};"
NSQ_SOURCE_LINE 00000538 "  }"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "  my $value_without = $value;"
NSQ_SOURCE_LINE 00000541 "  if ($value_without =~ s/(?:^|$_path_sep)\\$\\{$name\\}(?:$_path_sep|$)//g) {"
NSQ_SOURCE_LINE 00000542 "    $out .= qq{if \"\\${$name}\" != '' setenv $name \"$value\";\\n};"
NSQ_SOURCE_LINE 00000543 "    $out .= qq{if \"\\${$name}\" == '' };"
NSQ_SOURCE_LINE 00000544 "  }"
NSQ_SOURCE_LINE 00000545 "  $out .= qq{setenv $name \"$value_without\";\\n};"
NSQ_SOURCE_LINE 00000546 "  return $out;"
NSQ_SOURCE_LINE 00000547 "}"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "sub build_cmd_env_declaration {"
NSQ_SOURCE_LINE 00000550 "  my ($class, $name, $args) = @_;"
NSQ_SOURCE_LINE 00000551 "  my $value = $class->_interpolate($args, '%%%s%%', qr(%), '%s');"
NSQ_SOURCE_LINE 00000552 "  if (!$value) {"
NSQ_SOURCE_LINE 00000553 "    return qq{\\@set $name=\\n};"
NSQ_SOURCE_LINE 00000554 "  }"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "  my $out = '';"
NSQ_SOURCE_LINE 00000557 "  my $value_without = $value;"
NSQ_SOURCE_LINE 00000558 "  if ($value_without =~ s/(?:^|$_path_sep)%$name%(?:$_path_sep|$)//g) {"
NSQ_SOURCE_LINE 00000559 "    $out .= qq{\\@if not \"%$name%\"==\"\" set \"$name=$value\"\\n};"
NSQ_SOURCE_LINE 00000560 "    $out .= qq{\\@if \"%$name%\"==\"\" };"
NSQ_SOURCE_LINE 00000561 "  }"
NSQ_SOURCE_LINE 00000562 "  $out .= qq{\\@set \"$name=$value_without\"\\n};"
NSQ_SOURCE_LINE 00000563 "  return $out;"
NSQ_SOURCE_LINE 00000564 "}"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "sub build_powershell_env_declaration {"
NSQ_SOURCE_LINE 00000567 "  my ($class, $name, $args) = @_;"
NSQ_SOURCE_LINE 00000568 "  my $value = $class->_interpolate($args, '$env:%s', qr/[\"\\$]/, '`%s');"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "  if (!$value) {"
NSQ_SOURCE_LINE 00000571 "    return qq{Remove-Item -ErrorAction 0 Env:\\\\$name;\\n};"
NSQ_SOURCE_LINE 00000572 "  }"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "  my $maybe_path_sep = qq{\\$(if(\"\\$env:$name\"-eq\"\"){\"\"}else{\"$_path_sep\"})};"
NSQ_SOURCE_LINE 00000575 "  $value =~ s/(^|\\G|$_path_sep)\\$env:$name$_path_sep/$1\\$env:$name\"+$maybe_path_sep+\"/g;"
NSQ_SOURCE_LINE 00000576 "  $value =~ s/$_path_sep\\$env:$name$/\"+$maybe_path_sep+\\$env:$name+\"/;"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "  qq{\\$env:$name = \\$(\"$value\");\\n};"
NSQ_SOURCE_LINE 00000579 "}"
NSQ_SOURCE_LINE 00000580 "sub wrap_powershell_output {"
NSQ_SOURCE_LINE 00000581 "  my ($class, $out) = @_;"
NSQ_SOURCE_LINE 00000582 "  return $out || \" \\n\";"
NSQ_SOURCE_LINE 00000583 "}"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "sub build_fish_env_declaration {"
NSQ_SOURCE_LINE 00000586 "  my ($class, $name, $args) = @_;"
NSQ_SOURCE_LINE 00000587 "  my $value = $class->_interpolate($args, '$%s', qr/[\\\\\"'$ ]/, '\\\\%s');"
NSQ_SOURCE_LINE 00000588 "  if (!defined $value) {"
NSQ_SOURCE_LINE 00000589 "    return qq{set -e $name;\\n};"
NSQ_SOURCE_LINE 00000590 "  }"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "  # fish has special handling for PATH, CDPATH, and MANPATH.  They are always"
NSQ_SOURCE_LINE 00000593 "  # treated as arrays, and joined with ; when storing the environment.  Other"
NSQ_SOURCE_LINE 00000594 "  # env vars can be arrays, but will be joined without a separator.  We only"
NSQ_SOURCE_LINE 00000595 "  # really care about PATH, but might as well make this routine more general."
NSQ_SOURCE_LINE 00000596 "  if ($name =~ /^(?:CD|MAN)?PATH$/) {"
NSQ_SOURCE_LINE 00000597 "    $value =~ s/$_path_sep/ /g;"
NSQ_SOURCE_LINE 00000598 "    my $silent = $name =~ /^(?:CD)?PATH$/ ? \" 2>\"._devnull : '';"
NSQ_SOURCE_LINE 00000599 "    return qq{set -x $name $value$silent;\\n};"
NSQ_SOURCE_LINE 00000600 "  }"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "  my $out = '';"
NSQ_SOURCE_LINE 00000603 "  my $value_without = $value;"
NSQ_SOURCE_LINE 00000604 "  if ($value_without =~ s/(?:^|$_path_sep)\\$$name(?:$_path_sep|$)//g) {"
NSQ_SOURCE_LINE 00000605 "    $out .= qq{set -q $name; and set -x $name $value;\\n};"
NSQ_SOURCE_LINE 00000606 "    $out .= qq{set -q $name; or };"
NSQ_SOURCE_LINE 00000607 "  }"
NSQ_SOURCE_LINE 00000608 "  $out .= qq{set -x $name $value_without;\\n};"
NSQ_SOURCE_LINE 00000609 "  $out;"
NSQ_SOURCE_LINE 00000610 "}"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 "sub _interpolate {"
NSQ_SOURCE_LINE 00000613 "  my ($class, $args, $var_pat, $escape, $escape_pat) = @_;"
NSQ_SOURCE_LINE 00000614 "  return"
NSQ_SOURCE_LINE 00000615 "    unless defined $args;"
NSQ_SOURCE_LINE 00000616 "  my @args = ref $args ? @$args : $args;"
NSQ_SOURCE_LINE 00000617 "  return"
NSQ_SOURCE_LINE 00000618 "    unless @args;"
NSQ_SOURCE_LINE 00000619 "  my @vars = map { $$_ } grep { ref $_ eq 'SCALAR' } @args;"
NSQ_SOURCE_LINE 00000620 "  my $string = join $_path_sep, map {"
NSQ_SOURCE_LINE 00000621 "    ref $_ eq 'SCALAR' ? sprintf($var_pat, $$_) : do {"
NSQ_SOURCE_LINE 00000622 "      s/($escape)/sprintf($escape_pat, $1)/ge; $_;"
NSQ_SOURCE_LINE 00000623 "    };"
NSQ_SOURCE_LINE 00000624 "  } @args;"
NSQ_SOURCE_LINE 00000625 "  return wantarray ? ($string, \\@vars) : $string;"
NSQ_SOURCE_LINE 00000626 "}"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "sub pipeline;"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "sub pipeline {"
NSQ_SOURCE_LINE 00000631 "  my @methods = @_;"
NSQ_SOURCE_LINE 00000632 "  my $last = pop(@methods);"
NSQ_SOURCE_LINE 00000633 "  if (@methods) {"
NSQ_SOURCE_LINE 00000634 "    \\sub {"
NSQ_SOURCE_LINE 00000635 "      my ($obj, @args) = @_;"
NSQ_SOURCE_LINE 00000636 "      $obj->${pipeline @methods}("
NSQ_SOURCE_LINE 00000637 "        $obj->$last(@args)"
NSQ_SOURCE_LINE 00000638 "      );"
NSQ_SOURCE_LINE 00000639 "    };"
NSQ_SOURCE_LINE 00000640 "  } else {"
NSQ_SOURCE_LINE 00000641 "    \\sub {"
NSQ_SOURCE_LINE 00000642 "      shift->$last(@_);"
NSQ_SOURCE_LINE 00000643 "    };"
NSQ_SOURCE_LINE 00000644 "  }"
NSQ_SOURCE_LINE 00000645 "}"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "sub resolve_path {"
NSQ_SOURCE_LINE 00000648 "  my ($class, $path) = @_;"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "  $path = $class->${pipeline qw("
NSQ_SOURCE_LINE 00000651 "    resolve_relative_path"
NSQ_SOURCE_LINE 00000652 "    resolve_home_path"
NSQ_SOURCE_LINE 00000653 "    resolve_empty_path"
NSQ_SOURCE_LINE 00000654 "  )}($path);"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "  $path;"
NSQ_SOURCE_LINE 00000657 "}"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "sub resolve_empty_path {"
NSQ_SOURCE_LINE 00000660 "  my ($class, $path) = @_;"
NSQ_SOURCE_LINE 00000661 "  if (defined $path) {"
NSQ_SOURCE_LINE 00000662 "    $path;"
NSQ_SOURCE_LINE 00000663 "  } else {"
NSQ_SOURCE_LINE 00000664 "    '~/perl5';"
NSQ_SOURCE_LINE 00000665 "  }"
NSQ_SOURCE_LINE 00000666 "}"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "sub resolve_home_path {"
NSQ_SOURCE_LINE 00000669 "  my ($class, $path) = @_;"
NSQ_SOURCE_LINE 00000670 "  $path =~ /^~([^\\/]*)/ or return $path;"
NSQ_SOURCE_LINE 00000671 "  my $user = $1;"
NSQ_SOURCE_LINE 00000672 "  my $homedir = do {"
NSQ_SOURCE_LINE 00000673 "    if (! length($user) && defined $ENV{HOME}) {"
NSQ_SOURCE_LINE 00000674 "      $ENV{HOME};"
NSQ_SOURCE_LINE 00000675 "    }"
NSQ_SOURCE_LINE 00000676 "    else {"
NSQ_SOURCE_LINE 00000677 "      require File::Glob;"
NSQ_SOURCE_LINE 00000678 "      File::Glob::bsd_glob(\"~$user\", File::Glob::GLOB_TILDE());"
NSQ_SOURCE_LINE 00000679 "    }"
NSQ_SOURCE_LINE 00000680 "  };"
NSQ_SOURCE_LINE 00000681 "  unless (defined $homedir) {"
NSQ_SOURCE_LINE 00000682 "    require Carp; require Carp::Heavy;"
NSQ_SOURCE_LINE 00000683 "    Carp::croak("
NSQ_SOURCE_LINE 00000684 "      \"Couldn't resolve homedir for \""
NSQ_SOURCE_LINE 00000685 "      .(defined $user ? $user : 'current user')"
NSQ_SOURCE_LINE 00000686 "    );"
NSQ_SOURCE_LINE 00000687 "  }"
NSQ_SOURCE_LINE 00000688 "  $path =~ s/^~[^\\/]*/$homedir/;"
NSQ_SOURCE_LINE 00000689 "  $path;"
NSQ_SOURCE_LINE 00000690 "}"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "sub resolve_relative_path {"
NSQ_SOURCE_LINE 00000693 "  my ($class, $path) = @_;"
NSQ_SOURCE_LINE 00000694 "  _rel2abs($path);"
NSQ_SOURCE_LINE 00000695 "}"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "sub ensure_dir_structure_for {"
NSQ_SOURCE_LINE 00000698 "  my ($class, $path, $opts) = @_;"
NSQ_SOURCE_LINE 00000699 "  $opts ||= {};"
NSQ_SOURCE_LINE 00000700 "  my @dirs;"
NSQ_SOURCE_LINE 00000701 "  foreach my $dir ("
NSQ_SOURCE_LINE 00000702 "    $class->lib_paths_for($path),"
NSQ_SOURCE_LINE 00000703 "    $class->install_base_bin_path($path),"
NSQ_SOURCE_LINE 00000704 "  ) {"
NSQ_SOURCE_LINE 00000705 "    my $d = $dir;"
NSQ_SOURCE_LINE 00000706 "    while (!-d $d) {"
NSQ_SOURCE_LINE 00000707 "      push @dirs, $d;"
NSQ_SOURCE_LINE 00000708 "      require File::Basename;"
NSQ_SOURCE_LINE 00000709 "      $d = File::Basename::dirname($d);"
NSQ_SOURCE_LINE 00000710 "    }"
NSQ_SOURCE_LINE 00000711 "  }"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "  warn \"Attempting to create directory ${path}\\n\""
NSQ_SOURCE_LINE 00000714 "    if !$opts->{quiet} && @dirs;"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "  my %seen;"
NSQ_SOURCE_LINE 00000717 "  foreach my $dir (reverse @dirs) {"
NSQ_SOURCE_LINE 00000718 "    next"
NSQ_SOURCE_LINE 00000719 "      if $seen{$dir}++;"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "    mkdir $dir"
NSQ_SOURCE_LINE 00000722 "      or -d $dir"
NSQ_SOURCE_LINE 00000723 "      or die \"Unable to create $dir: $!\""
NSQ_SOURCE_LINE 00000724 "  }"
NSQ_SOURCE_LINE 00000725 "  return;"
NSQ_SOURCE_LINE 00000726 "}"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "sub guess_shelltype {"
NSQ_SOURCE_LINE 00000729 "  my $shellbin"
NSQ_SOURCE_LINE 00000730 "    = defined $ENV{SHELL} && length $ENV{SHELL}"
NSQ_SOURCE_LINE 00000731 "      ? ($ENV{SHELL} =~ /([\\w.]+)$/)[-1]"
NSQ_SOURCE_LINE 00000732 "    : ( $^O eq 'MSWin32' && exists $ENV{'!EXITCODE'} )"
NSQ_SOURCE_LINE 00000733 "      ? 'bash'"
NSQ_SOURCE_LINE 00000734 "    : ( $^O eq 'MSWin32' && $ENV{PROMPT} && $ENV{COMSPEC} )"
NSQ_SOURCE_LINE 00000735 "      ? ($ENV{COMSPEC} =~ /([\\w.]+)$/)[-1]"
NSQ_SOURCE_LINE 00000736 "    : ( $^O eq 'MSWin32' && !$ENV{PROMPT} )"
NSQ_SOURCE_LINE 00000737 "      ? 'powershell.exe'"
NSQ_SOURCE_LINE 00000738 "    : 'sh';"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "  for ($shellbin) {"
NSQ_SOURCE_LINE 00000741 "    return"
NSQ_SOURCE_LINE 00000742 "        /csh$/                   ? 'csh'"
NSQ_SOURCE_LINE 00000743 "      : /fish$/                  ? 'fish'"
NSQ_SOURCE_LINE 00000744 "      : /command(?:\\.com)?$/i    ? 'cmd'"
NSQ_SOURCE_LINE 00000745 "      : /cmd(?:\\.exe)?$/i        ? 'cmd'"
NSQ_SOURCE_LINE 00000746 "      : /4nt(?:\\.exe)?$/i        ? 'cmd'"
NSQ_SOURCE_LINE 00000747 "      : /powershell(?:\\.exe)?$/i ? 'powershell'"
NSQ_SOURCE_LINE 00000748 "                                 : 'bourne';"
NSQ_SOURCE_LINE 00000749 "  }"
NSQ_SOURCE_LINE 00000750 "}"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "1;"
NSQ_SOURCE_LINE 00000753 "__END__"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "=encoding utf8"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "=head1 NAME"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "local::lib - create and use a local lib/ for perl modules with PERL5LIB"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "In code -"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "  use local::lib; # sets up a local lib at ~/perl5"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "  use local::lib '~/foo'; # same, but ~/foo"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "  # Or..."
NSQ_SOURCE_LINE 00000770 "  use FindBin;"
NSQ_SOURCE_LINE 00000771 "  use local::lib \"$FindBin::Bin/../support\";  # app-local support library"
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "From the shell -"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "  # Install LWP and its missing dependencies to the '~/perl5' directory"
NSQ_SOURCE_LINE 00000776 "  perl -MCPAN -Mlocal::lib -e 'CPAN::install(LWP)'"
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "  # Just print out useful shell commands"
NSQ_SOURCE_LINE 00000779 "  $ perl -Mlocal::lib"
NSQ_SOURCE_LINE 00000780 "  PERL_MB_OPT='--install_base /home/username/perl5'; export PERL_MB_OPT;"
NSQ_SOURCE_LINE 00000781 "  PERL_MM_OPT='INSTALL_BASE=/home/username/perl5'; export PERL_MM_OPT;"
NSQ_SOURCE_LINE 00000782 "  PERL5LIB=\"/home/username/perl5/lib/perl5\"; export PERL5LIB;"
NSQ_SOURCE_LINE 00000783 "  PATH=\"/home/username/perl5/bin:$PATH\"; export PATH;"
NSQ_SOURCE_LINE 00000784 "  PERL_LOCAL_LIB_ROOT=\"/home/usename/perl5:$PERL_LOCAL_LIB_ROOT\"; export PERL_LOCAL_LIB_ROOT;"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "From a F<.bash_profile> or F<.bashrc> file -"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "  eval \"$(perl -I$HOME/perl5/lib/perl5 -Mlocal::lib)\""
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "=head2 The bootstrapping technique"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "A typical way to install local::lib is using what is known as the"
NSQ_SOURCE_LINE 00000793 "\"bootstrapping\" technique.  You would do this if your system administrator"
NSQ_SOURCE_LINE 00000794 "hasn't already installed local::lib.  In this case, you'll need to install"
NSQ_SOURCE_LINE 00000795 "local::lib in your home directory."
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "Even if you do have administrative privileges, you will still want to set up your"
NSQ_SOURCE_LINE 00000798 "environment variables, as discussed in step 4. Without this, you would still"
NSQ_SOURCE_LINE 00000799 "install the modules into the system CPAN installation and also your Perl scripts"
NSQ_SOURCE_LINE 00000800 "will not use the lib/ path you bootstrapped with local::lib."
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "By default local::lib installs itself and the CPAN modules into ~/perl5."
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "Windows users must also see L</Differences when using this module under Win32>."
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "=over 4"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "=item 1."
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "Download and unpack the local::lib tarball from CPAN (search for \"Download\""
NSQ_SOURCE_LINE 00000811 "on the CPAN page about local::lib).  Do this as an ordinary user, not as root"
NSQ_SOURCE_LINE 00000812 "or administrator.  Unpack the file in your home directory or in any other"
NSQ_SOURCE_LINE 00000813 "convenient location."
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "=item 2."
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "Run this:"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "  perl Makefile.PL --bootstrap"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "If the system asks you whether it should automatically configure as much"
NSQ_SOURCE_LINE 00000822 "as possible, you would typically answer yes."
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "=item 3."
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "Run this: (local::lib assumes you have make installed on your system)"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "  make test && make install"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "=item 4."
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "Now we need to setup the appropriate environment variables, so that Perl"
NSQ_SOURCE_LINE 00000833 "starts using our newly generated lib/ directory. If you are using bash or"
NSQ_SOURCE_LINE 00000834 "any other Bourne shells, you can add this to your shell startup script this"
NSQ_SOURCE_LINE 00000835 "way:"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "  echo 'eval \"$(perl -I$HOME/perl5/lib/perl5 -Mlocal::lib)\"' >>~/.bashrc"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "If you are using C shell, you can do this as follows:"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "  % echo $SHELL"
NSQ_SOURCE_LINE 00000842 "  /bin/csh"
NSQ_SOURCE_LINE 00000843 "  $ echo 'eval `perl -I$HOME/perl5/lib/perl5 -Mlocal::lib`' >> ~/.cshrc"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "After writing your shell configuration file, be sure to re-read it to get the"
NSQ_SOURCE_LINE 00000846 "changed settings into your current shell's environment. Bourne shells use"
NSQ_SOURCE_LINE 00000847 "C<. ~/.bashrc> for this, whereas C shells use C<source ~/.cshrc>."
NSQ_SOURCE_LINE 00000848 ""
NSQ_SOURCE_LINE 00000849 "=back"
NSQ_SOURCE_LINE 00000850 ""
NSQ_SOURCE_LINE 00000851 "=head3 Bootstrapping into an alternate directory"
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "In order to install local::lib into a directory other than the default, you need"
NSQ_SOURCE_LINE 00000854 "to specify the name of the directory when you call bootstrap.  Then, when"
NSQ_SOURCE_LINE 00000855 "setting up the environment variables, both perl and local::lib must be told the"
NSQ_SOURCE_LINE 00000856 "location of the bootstrap directory.  The setup process would look as follows:"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "  perl Makefile.PL --bootstrap=~/foo"
NSQ_SOURCE_LINE 00000859 "  make test && make install"
NSQ_SOURCE_LINE 00000860 "  echo 'eval \"$(perl -I$HOME/foo/lib/perl5 -Mlocal::lib=$HOME/foo)\"' >>~/.bashrc"
NSQ_SOURCE_LINE 00000861 "  . ~/.bashrc"
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "=head3 Other bootstrapping options"
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "If you're on a slower machine, or are operating under draconian disk space"
NSQ_SOURCE_LINE 00000866 "limitations, you can disable the automatic generation of manpages from POD when"
NSQ_SOURCE_LINE 00000867 "installing modules by using the C<--no-manpages> argument when bootstrapping:"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "  perl Makefile.PL --bootstrap --no-manpages"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "To avoid doing several bootstrap for several Perl module environments on the"
NSQ_SOURCE_LINE 00000872 "same account, for example if you use it for several different deployed"
NSQ_SOURCE_LINE 00000873 "applications independently, you can use one bootstrapped local::lib"
NSQ_SOURCE_LINE 00000874 "installation to install modules in different directories directly this way:"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "  cd ~/mydir1"
NSQ_SOURCE_LINE 00000877 "  perl -Mlocal::lib=./"
NSQ_SOURCE_LINE 00000878 "  eval $(perl -Mlocal::lib=./)  ### To set the environment for this shell alone"
NSQ_SOURCE_LINE 00000879 "  printenv                      ### You will see that ~/mydir1 is in the PERL5LIB"
NSQ_SOURCE_LINE 00000880 "  perl -MCPAN -e install ...    ### whatever modules you want"
NSQ_SOURCE_LINE 00000881 "  cd ../mydir2"
NSQ_SOURCE_LINE 00000882 "  ... REPEAT ..."
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "If you use F<.bashrc> to activate a local::lib automatically, the local::lib"
NSQ_SOURCE_LINE 00000885 "will be re-enabled in any sub-shells used, overriding adjustments you may have"
NSQ_SOURCE_LINE 00000886 "made in the parent shell.  To avoid this, you can initialize the local::lib in"
NSQ_SOURCE_LINE 00000887 "F<.bash_profile> rather than F<.bashrc>, or protect the local::lib invocation"
NSQ_SOURCE_LINE 00000888 "with a C<$SHLVL> check:"
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "  [ $SHLVL -eq 1 ] && eval \"$(perl -I$HOME/perl5/lib/perl5 -Mlocal::lib)\""
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "If you are working with several C<local::lib> environments, you may want to"
NSQ_SOURCE_LINE 00000893 "remove some of them from the current environment without disturbing the others."
NSQ_SOURCE_LINE 00000894 "You can deactivate one environment like this (using bourne sh):"
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "  eval $(perl -Mlocal::lib=--deactivate,~/path)"
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "which will generate and run the commands needed to remove C<~/path> from your"
NSQ_SOURCE_LINE 00000899 "various search paths. Whichever environment was B<activated most recently> will"
NSQ_SOURCE_LINE 00000900 "remain the target for module installations. That is, if you activate"
NSQ_SOURCE_LINE 00000901 "C<~/path_A> and then you activate C<~/path_B>, new modules you install will go"
NSQ_SOURCE_LINE 00000902 "in C<~/path_B>. If you deactivate C<~/path_B> then modules will be installed"
NSQ_SOURCE_LINE 00000903 "into C<~/pathA> -- but if you deactivate C<~/path_A> then they will still be"
NSQ_SOURCE_LINE 00000904 "installed in C<~/pathB> because pathB was activated later."
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "You can also ask C<local::lib> to clean itself completely out of the current"
NSQ_SOURCE_LINE 00000907 "shell's environment with the C<--deactivate-all> option."
NSQ_SOURCE_LINE 00000908 "For multiple environments for multiple apps you may need to include a modified"
NSQ_SOURCE_LINE 00000909 "version of the C<< use FindBin >> instructions in the \"In code\" sample above."
NSQ_SOURCE_LINE 00000910 "If you did something like the above, you have a set of Perl modules at C<<"
NSQ_SOURCE_LINE 00000911 "~/mydir1/lib >>. If you have a script at C<< ~/mydir1/scripts/myscript.pl >>,"
NSQ_SOURCE_LINE 00000912 "you need to tell it where to find the modules you installed for it at C<<"
NSQ_SOURCE_LINE 00000913 "~/mydir1/lib >>."
NSQ_SOURCE_LINE 00000914 ""
NSQ_SOURCE_LINE 00000915 "In C<< ~/mydir1/scripts/myscript.pl >>:"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "  use strict;"
NSQ_SOURCE_LINE 00000918 "  use warnings;"
NSQ_SOURCE_LINE 00000919 "  use local::lib \"$FindBin::Bin/..\";  ### points to ~/mydir1 and local::lib finds lib"
NSQ_SOURCE_LINE 00000920 "  use lib \"$FindBin::Bin/../lib\";     ### points to ~/mydir1/lib"
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "Put this before any BEGIN { ... } blocks that require the modules you installed."
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "=head2 Differences when using this module under Win32"
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "To set up the proper environment variables for your current session of"
NSQ_SOURCE_LINE 00000927 "C<CMD.exe>, you can use this:"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "  C:\\>perl -Mlocal::lib"
NSQ_SOURCE_LINE 00000930 "  set PERL_MB_OPT=--install_base C:\\DOCUME~1\\ADMINI~1\\perl5"
NSQ_SOURCE_LINE 00000931 "  set PERL_MM_OPT=INSTALL_BASE=C:\\DOCUME~1\\ADMINI~1\\perl5"
NSQ_SOURCE_LINE 00000932 "  set PERL5LIB=C:\\DOCUME~1\\ADMINI~1\\perl5\\lib\\perl5"
NSQ_SOURCE_LINE 00000933 "  set PATH=C:\\DOCUME~1\\ADMINI~1\\perl5\\bin;%PATH%"
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "  ### To set the environment for this shell alone"
NSQ_SOURCE_LINE 00000936 "  C:\\>perl -Mlocal::lib > %TEMP%\\tmp.bat && %TEMP%\\tmp.bat && del %TEMP%\\tmp.bat"
NSQ_SOURCE_LINE 00000937 "  ### instead of $(perl -Mlocal::lib=./)"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "If you want the environment entries to persist, you'll need to add them to the"
NSQ_SOURCE_LINE 00000940 "Control Panel's System applet yourself or use L<App::local::lib::Win32Helper>."
NSQ_SOURCE_LINE 00000941 ""
NSQ_SOURCE_LINE 00000942 "The \"~\" is translated to the user's profile directory (the directory named for"
NSQ_SOURCE_LINE 00000943 "the user under \"Documents and Settings\" (Windows XP or earlier) or \"Users\""
NSQ_SOURCE_LINE 00000944 "(Windows Vista or later)) unless $ENV{HOME} exists. After that, the home"
NSQ_SOURCE_LINE 00000945 "directory is translated to a short name (which means the directory must exist)"
NSQ_SOURCE_LINE 00000946 "and the subdirectories are created."
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "=head3 PowerShell"
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "local::lib also supports PowerShell, and can be used with the"
NSQ_SOURCE_LINE 00000951 "C<Invoke-Expression> cmdlet."
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "  Invoke-Expression \"$(perl -Mlocal::lib)\""
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 "=head1 RATIONALE"
NSQ_SOURCE_LINE 00000956 ""
NSQ_SOURCE_LINE 00000957 "The version of a Perl package on your machine is not always the version you"
NSQ_SOURCE_LINE 00000958 "need.  Obviously, the best thing to do would be to update to the version you"
NSQ_SOURCE_LINE 00000959 "need.  However, you might be in a situation where you're prevented from doing"
NSQ_SOURCE_LINE 00000960 "this.  Perhaps you don't have system administrator privileges; or perhaps you"
NSQ_SOURCE_LINE 00000961 "are using a package management system such as Debian, and nobody has yet gotten"
NSQ_SOURCE_LINE 00000962 "around to packaging up the version you need."
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "local::lib solves this problem by allowing you to create your own directory of"
NSQ_SOURCE_LINE 00000965 "Perl packages downloaded from CPAN (in a multi-user system, this would typically"
NSQ_SOURCE_LINE 00000966 "be within your own home directory).  The existing system Perl installation is"
NSQ_SOURCE_LINE 00000967 "not affected; you simply invoke Perl with special options so that Perl uses the"
NSQ_SOURCE_LINE 00000968 "packages in your own local package directory rather than the system packages."
NSQ_SOURCE_LINE 00000969 "local::lib arranges things so that your locally installed version of the Perl"
NSQ_SOURCE_LINE 00000970 "packages takes precedence over the system installation."
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "If you are using a package management system (such as Debian), you don't need to"
NSQ_SOURCE_LINE 00000973 "worry about Debian and CPAN stepping on each other's toes.  Your local version"
NSQ_SOURCE_LINE 00000974 "of the packages will be written to an entirely separate directory from those"
NSQ_SOURCE_LINE 00000975 "installed by Debian."
NSQ_SOURCE_LINE 00000976 ""
NSQ_SOURCE_LINE 00000977 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "This module provides a quick, convenient way of bootstrapping a user-local Perl"
NSQ_SOURCE_LINE 00000980 "module library located within the user's home directory. It also constructs and"
NSQ_SOURCE_LINE 00000981 "prints out for the user the list of environment variables using the syntax"
NSQ_SOURCE_LINE 00000982 "appropriate for the user's current shell (as specified by the C<SHELL>"
NSQ_SOURCE_LINE 00000983 "environment variable), suitable for directly adding to one's shell"
NSQ_SOURCE_LINE 00000984 "configuration file."
NSQ_SOURCE_LINE 00000985 ""
NSQ_SOURCE_LINE 00000986 "More generally, local::lib allows for the bootstrapping and usage of a"
NSQ_SOURCE_LINE 00000987 "directory containing Perl modules outside of Perl's C<@INC>. This makes it"
NSQ_SOURCE_LINE 00000988 "easier to ship an application with an app-specific copy of a Perl module, or"
NSQ_SOURCE_LINE 00000989 "collection of modules. Useful in cases like when an upstream maintainer hasn't"
NSQ_SOURCE_LINE 00000990 "applied a patch to a module of theirs that you need for your application."
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "On import, local::lib sets the following environment variables to appropriate"
NSQ_SOURCE_LINE 00000993 "values:"
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "=over 4"
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "=item PERL_MB_OPT"
NSQ_SOURCE_LINE 00000998 ""
NSQ_SOURCE_LINE 00000999 "=item PERL_MM_OPT"
NSQ_SOURCE_LINE 00001000 ""
NSQ_SOURCE_LINE 00001001 "=item PERL5LIB"
NSQ_SOURCE_LINE 00001002 ""
NSQ_SOURCE_LINE 00001003 "=item PATH"
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "=item PERL_LOCAL_LIB_ROOT"
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "=back"
NSQ_SOURCE_LINE 00001008 ""
NSQ_SOURCE_LINE 00001009 "When possible, these will be appended to instead of overwritten entirely."
NSQ_SOURCE_LINE 00001010 ""
NSQ_SOURCE_LINE 00001011 "These values are then available for reference by any code after import."
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "=head1 CREATING A SELF-CONTAINED SET OF MODULES"
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "See L<lib::core::only> for one way to do this - but note that"
NSQ_SOURCE_LINE 00001016 "there are a number of caveats, and the best approach is always to perform a"
NSQ_SOURCE_LINE 00001017 "build against a clean perl (i.e. site and vendor as close to empty as possible)."
NSQ_SOURCE_LINE 00001018 ""
NSQ_SOURCE_LINE 00001019 "=head1 IMPORT OPTIONS"
NSQ_SOURCE_LINE 00001020 ""
NSQ_SOURCE_LINE 00001021 "Options are values that can be passed to the C<local::lib> import besides the"
NSQ_SOURCE_LINE 00001022 "directory to use. They are specified as C<use local::lib '--option'[, path];>"
NSQ_SOURCE_LINE 00001023 "or C<perl -Mlocal::lib=--option[,path]>."
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "=head2 --deactivate"
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "Remove the chosen path (or the default path) from the module search paths if it"
NSQ_SOURCE_LINE 00001028 "was added by C<local::lib>, instead of adding it."
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "=head2 --deactivate-all"
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "Remove all directories that were added to search paths by C<local::lib> from the"
NSQ_SOURCE_LINE 00001033 "search paths."
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 "=head2 --quiet"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "Don't output any messages about directories being created."
NSQ_SOURCE_LINE 00001038 ""
NSQ_SOURCE_LINE 00001039 "=head2 --always"
NSQ_SOURCE_LINE 00001040 ""
NSQ_SOURCE_LINE 00001041 "Always add directories to environment variables, ignoring if they are already"
NSQ_SOURCE_LINE 00001042 "included."
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 "=head2 --shelltype"
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "Specify the shell type to use for output.  By default, the shell will be"
NSQ_SOURCE_LINE 00001047 "detected based on the environment.  Should be one of: C<bourne>, C<csh>,"
NSQ_SOURCE_LINE 00001048 "C<cmd>, or C<powershell>."
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "=head2 --no-create"
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "Prevents C<local::lib> from creating directories when activating dirs.  This is"
NSQ_SOURCE_LINE 00001053 "likely to cause issues on Win32 systems."
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 "=head1 CLASS METHODS"
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "=head2 ensure_dir_structure_for"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "=over 4"
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "=item Return value: None"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "=back"
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "Attempts to create a local::lib directory, including subdirectories and all"
NSQ_SOURCE_LINE 00001068 "required parent directories. Throws an exception on failure."
NSQ_SOURCE_LINE 00001069 ""
NSQ_SOURCE_LINE 00001070 "=head2 print_environment_vars_for"
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "=over 4"
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001075 ""
NSQ_SOURCE_LINE 00001076 "=item Return value: None"
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 "=back"
NSQ_SOURCE_LINE 00001079 ""
NSQ_SOURCE_LINE 00001080 "Prints to standard output the variables listed above, properly set to use the"
NSQ_SOURCE_LINE 00001081 "given path as the base directory."
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "=head2 build_environment_vars_for"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "=over 4"
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "=item Return value: %environment_vars"
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 "=back"
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "Returns a hash with the variables listed above, properly set to use the"
NSQ_SOURCE_LINE 00001094 "given path as the base directory."
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 "=head2 setup_env_hash_for"
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "=over 4"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "=item Return value: None"
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 "=back"
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 "Constructs the C<%ENV> keys for the given path, by calling"
NSQ_SOURCE_LINE 00001107 "L</build_environment_vars_for>."
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "=head2 active_paths"
NSQ_SOURCE_LINE 00001110 ""
NSQ_SOURCE_LINE 00001111 "=over 4"
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "=item Arguments: None"
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "=item Return value: @paths"
NSQ_SOURCE_LINE 00001116 ""
NSQ_SOURCE_LINE 00001117 "=back"
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 "Returns a list of active C<local::lib> paths, according to the"
NSQ_SOURCE_LINE 00001120 "C<PERL_LOCAL_LIB_ROOT> environment variable and verified against"
NSQ_SOURCE_LINE 00001121 "what is really in C<@INC>."
NSQ_SOURCE_LINE 00001122 ""
NSQ_SOURCE_LINE 00001123 "=head2 install_base_perl_path"
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "=over 4"
NSQ_SOURCE_LINE 00001126 ""
NSQ_SOURCE_LINE 00001127 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001128 ""
NSQ_SOURCE_LINE 00001129 "=item Return value: $install_base_perl_path"
NSQ_SOURCE_LINE 00001130 ""
NSQ_SOURCE_LINE 00001131 "=back"
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "Returns a path describing where to install the Perl modules for this local"
NSQ_SOURCE_LINE 00001134 "library installation. Appends the directories C<lib> and C<perl5> to the given"
NSQ_SOURCE_LINE 00001135 "path."
NSQ_SOURCE_LINE 00001136 ""
NSQ_SOURCE_LINE 00001137 "=head2 lib_paths_for"
NSQ_SOURCE_LINE 00001138 ""
NSQ_SOURCE_LINE 00001139 "=over 4"
NSQ_SOURCE_LINE 00001140 ""
NSQ_SOURCE_LINE 00001141 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001142 ""
NSQ_SOURCE_LINE 00001143 "=item Return value: @lib_paths"
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "=back"
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 "Returns the list of paths perl will search for libraries, given a base path."
NSQ_SOURCE_LINE 00001148 "This includes the base path itself, the architecture specific subdirectory, and"
NSQ_SOURCE_LINE 00001149 "perl version specific subdirectories.  These paths may not all exist."
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "=head2 install_base_bin_path"
NSQ_SOURCE_LINE 00001152 ""
NSQ_SOURCE_LINE 00001153 "=over 4"
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "=item Return value: $install_base_bin_path"
NSQ_SOURCE_LINE 00001158 ""
NSQ_SOURCE_LINE 00001159 "=back"
NSQ_SOURCE_LINE 00001160 ""
NSQ_SOURCE_LINE 00001161 "Returns a path describing where to install the executable programs for this"
NSQ_SOURCE_LINE 00001162 "local library installation. Appends the directory C<bin> to the given path."
NSQ_SOURCE_LINE 00001163 ""
NSQ_SOURCE_LINE 00001164 "=head2 installer_options_for"
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 "=over 4"
NSQ_SOURCE_LINE 00001167 ""
NSQ_SOURCE_LINE 00001168 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 "=item Return value: %installer_env_vars"
NSQ_SOURCE_LINE 00001171 ""
NSQ_SOURCE_LINE 00001172 "=back"
NSQ_SOURCE_LINE 00001173 ""
NSQ_SOURCE_LINE 00001174 "Returns a hash of environment variables that should be set to cause"
NSQ_SOURCE_LINE 00001175 "installation into the given path."
NSQ_SOURCE_LINE 00001176 ""
NSQ_SOURCE_LINE 00001177 "=head2 resolve_empty_path"
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "=over 4"
NSQ_SOURCE_LINE 00001180 ""
NSQ_SOURCE_LINE 00001181 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "=item Return value: $base_path"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "=back"
NSQ_SOURCE_LINE 00001186 ""
NSQ_SOURCE_LINE 00001187 "Builds and returns the base path into which to set up the local module"
NSQ_SOURCE_LINE 00001188 "installation. Defaults to C<~/perl5>."
NSQ_SOURCE_LINE 00001189 ""
NSQ_SOURCE_LINE 00001190 "=head2 resolve_home_path"
NSQ_SOURCE_LINE 00001191 ""
NSQ_SOURCE_LINE 00001192 "=over 4"
NSQ_SOURCE_LINE 00001193 ""
NSQ_SOURCE_LINE 00001194 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001195 ""
NSQ_SOURCE_LINE 00001196 "=item Return value: $home_path"
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "=back"
NSQ_SOURCE_LINE 00001199 ""
NSQ_SOURCE_LINE 00001200 "Attempts to find the user's home directory."
NSQ_SOURCE_LINE 00001201 "If no definite answer is available, throws an exception."
NSQ_SOURCE_LINE 00001202 ""
NSQ_SOURCE_LINE 00001203 "=head2 resolve_relative_path"
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "=over 4"
NSQ_SOURCE_LINE 00001206 ""
NSQ_SOURCE_LINE 00001207 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 "=item Return value: $absolute_path"
NSQ_SOURCE_LINE 00001210 ""
NSQ_SOURCE_LINE 00001211 "=back"
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 "Translates the given path into an absolute path."
NSQ_SOURCE_LINE 00001214 ""
NSQ_SOURCE_LINE 00001215 "=head2 resolve_path"
NSQ_SOURCE_LINE 00001216 ""
NSQ_SOURCE_LINE 00001217 "=over 4"
NSQ_SOURCE_LINE 00001218 ""
NSQ_SOURCE_LINE 00001219 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001220 ""
NSQ_SOURCE_LINE 00001221 "=item Return value: $absolute_path"
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 "=back"
NSQ_SOURCE_LINE 00001224 ""
NSQ_SOURCE_LINE 00001225 "Calls the following in a pipeline, passing the result from the previous to the"
NSQ_SOURCE_LINE 00001226 "next, in an attempt to find where to configure the environment for a local"
NSQ_SOURCE_LINE 00001227 "library installation: L</resolve_empty_path>, L</resolve_home_path>,"
NSQ_SOURCE_LINE 00001228 "L</resolve_relative_path>. Passes the given path argument to"
NSQ_SOURCE_LINE 00001229 "L</resolve_empty_path> which then returns a result that is passed to"
NSQ_SOURCE_LINE 00001230 "L</resolve_home_path>, which then has its result passed to"
NSQ_SOURCE_LINE 00001231 "L</resolve_relative_path>. The result of this final call is returned from"
NSQ_SOURCE_LINE 00001232 "L</resolve_path>."
NSQ_SOURCE_LINE 00001233 ""
NSQ_SOURCE_LINE 00001234 "=head1 OBJECT INTERFACE"
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 "=head2 new"
NSQ_SOURCE_LINE 00001237 ""
NSQ_SOURCE_LINE 00001238 "=over 4"
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "=item Arguments: %attributes"
NSQ_SOURCE_LINE 00001241 ""
NSQ_SOURCE_LINE 00001242 "=item Return value: $local_lib"
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "=back"
NSQ_SOURCE_LINE 00001245 ""
NSQ_SOURCE_LINE 00001246 "Constructs a new C<local::lib> object, representing the current state of"
NSQ_SOURCE_LINE 00001247 "C<@INC> and the relevant environment variables."
NSQ_SOURCE_LINE 00001248 ""
NSQ_SOURCE_LINE 00001249 "=head1 ATTRIBUTES"
NSQ_SOURCE_LINE 00001250 ""
NSQ_SOURCE_LINE 00001251 "=head2 roots"
NSQ_SOURCE_LINE 00001252 ""
NSQ_SOURCE_LINE 00001253 "An arrayref representing active C<local::lib> directories."
NSQ_SOURCE_LINE 00001254 ""
NSQ_SOURCE_LINE 00001255 "=head2 inc"
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "An arrayref representing C<@INC>."
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "=head2 libs"
NSQ_SOURCE_LINE 00001260 ""
NSQ_SOURCE_LINE 00001261 "An arrayref representing the PERL5LIB environment variable."
NSQ_SOURCE_LINE 00001262 ""
NSQ_SOURCE_LINE 00001263 "=head2 bins"
NSQ_SOURCE_LINE 00001264 ""
NSQ_SOURCE_LINE 00001265 "An arrayref representing the PATH environment variable."
NSQ_SOURCE_LINE 00001266 ""
NSQ_SOURCE_LINE 00001267 "=head2 extra"
NSQ_SOURCE_LINE 00001268 ""
NSQ_SOURCE_LINE 00001269 "A hashref of extra environment variables (e.g. C<PERL_MM_OPT> and"
NSQ_SOURCE_LINE 00001270 "C<PERL_MB_OPT>)"
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 "=head2 no_create"
NSQ_SOURCE_LINE 00001273 ""
NSQ_SOURCE_LINE 00001274 "If set, C<local::lib> will not try to create directories when activating them."
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "=head1 OBJECT METHODS"
NSQ_SOURCE_LINE 00001277 ""
NSQ_SOURCE_LINE 00001278 "=head2 clone"
NSQ_SOURCE_LINE 00001279 ""
NSQ_SOURCE_LINE 00001280 "=over 4"
NSQ_SOURCE_LINE 00001281 ""
NSQ_SOURCE_LINE 00001282 "=item Arguments: %attributes"
NSQ_SOURCE_LINE 00001283 ""
NSQ_SOURCE_LINE 00001284 "=item Return value: $local_lib"
NSQ_SOURCE_LINE 00001285 ""
NSQ_SOURCE_LINE 00001286 "=back"
NSQ_SOURCE_LINE 00001287 ""
NSQ_SOURCE_LINE 00001288 "Constructs a new C<local::lib> object based on the existing one, overriding the"
NSQ_SOURCE_LINE 00001289 "specified attributes."
NSQ_SOURCE_LINE 00001290 ""
NSQ_SOURCE_LINE 00001291 "=head2 activate"
NSQ_SOURCE_LINE 00001292 ""
NSQ_SOURCE_LINE 00001293 "=over 4"
NSQ_SOURCE_LINE 00001294 ""
NSQ_SOURCE_LINE 00001295 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001296 ""
NSQ_SOURCE_LINE 00001297 "=item Return value: $new_local_lib"
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "=back"
NSQ_SOURCE_LINE 00001300 ""
NSQ_SOURCE_LINE 00001301 "Constructs a new instance with the specified path active."
NSQ_SOURCE_LINE 00001302 ""
NSQ_SOURCE_LINE 00001303 "=head2 deactivate"
NSQ_SOURCE_LINE 00001304 ""
NSQ_SOURCE_LINE 00001305 "=over 4"
NSQ_SOURCE_LINE 00001306 ""
NSQ_SOURCE_LINE 00001307 "=item Arguments: $path"
NSQ_SOURCE_LINE 00001308 ""
NSQ_SOURCE_LINE 00001309 "=item Return value: $new_local_lib"
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 "=back"
NSQ_SOURCE_LINE 00001312 ""
NSQ_SOURCE_LINE 00001313 "Constructs a new instance with the specified path deactivated."
NSQ_SOURCE_LINE 00001314 ""
NSQ_SOURCE_LINE 00001315 "=head2 deactivate_all"
NSQ_SOURCE_LINE 00001316 ""
NSQ_SOURCE_LINE 00001317 "=over 4"
NSQ_SOURCE_LINE 00001318 ""
NSQ_SOURCE_LINE 00001319 "=item Arguments: None"
NSQ_SOURCE_LINE 00001320 ""
NSQ_SOURCE_LINE 00001321 "=item Return value: $new_local_lib"
NSQ_SOURCE_LINE 00001322 ""
NSQ_SOURCE_LINE 00001323 "=back"
NSQ_SOURCE_LINE 00001324 ""
NSQ_SOURCE_LINE 00001325 "Constructs a new instance with all C<local::lib> directories deactivated."
NSQ_SOURCE_LINE 00001326 ""
NSQ_SOURCE_LINE 00001327 "=head2 environment_vars_string"
NSQ_SOURCE_LINE 00001328 ""
NSQ_SOURCE_LINE 00001329 "=over 4"
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 "=item Arguments: [ $shelltype ]"
NSQ_SOURCE_LINE 00001332 ""
NSQ_SOURCE_LINE 00001333 "=item Return value: $shell_env_string"
NSQ_SOURCE_LINE 00001334 ""
NSQ_SOURCE_LINE 00001335 "=back"
NSQ_SOURCE_LINE 00001336 ""
NSQ_SOURCE_LINE 00001337 "Returns a string to set up the C<local::lib>, meant to be run by a shell."
NSQ_SOURCE_LINE 00001338 ""
NSQ_SOURCE_LINE 00001339 "=head2 build_environment_vars"
NSQ_SOURCE_LINE 00001340 ""
NSQ_SOURCE_LINE 00001341 "=over 4"
NSQ_SOURCE_LINE 00001342 ""
NSQ_SOURCE_LINE 00001343 "=item Arguments: None"
NSQ_SOURCE_LINE 00001344 ""
NSQ_SOURCE_LINE 00001345 "=item Return value: %environment_vars"
NSQ_SOURCE_LINE 00001346 ""
NSQ_SOURCE_LINE 00001347 "=back"
NSQ_SOURCE_LINE 00001348 ""
NSQ_SOURCE_LINE 00001349 "Returns a hash with the variables listed above, properly set to use the"
NSQ_SOURCE_LINE 00001350 "given path as the base directory."
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "=head2 setup_env_hash"
NSQ_SOURCE_LINE 00001353 ""
NSQ_SOURCE_LINE 00001354 "=over 4"
NSQ_SOURCE_LINE 00001355 ""
NSQ_SOURCE_LINE 00001356 "=item Arguments: None"
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 "=item Return value: None"
NSQ_SOURCE_LINE 00001359 ""
NSQ_SOURCE_LINE 00001360 "=back"
NSQ_SOURCE_LINE 00001361 ""
NSQ_SOURCE_LINE 00001362 "Constructs the C<%ENV> keys for the given path, by calling"
NSQ_SOURCE_LINE 00001363 "L</build_environment_vars>."
NSQ_SOURCE_LINE 00001364 ""
NSQ_SOURCE_LINE 00001365 "=head2 setup_local_lib"
NSQ_SOURCE_LINE 00001366 ""
NSQ_SOURCE_LINE 00001367 "Constructs the C<%ENV> hash using L</setup_env_hash>, and set up C<@INC>."
NSQ_SOURCE_LINE 00001368 ""
NSQ_SOURCE_LINE 00001369 "=head1 A WARNING ABOUT UNINST=1"
NSQ_SOURCE_LINE 00001370 ""
NSQ_SOURCE_LINE 00001371 "Be careful about using local::lib in combination with \"make install UNINST=1\"."
NSQ_SOURCE_LINE 00001372 "The idea of this feature is that will uninstall an old version of a module"
NSQ_SOURCE_LINE 00001373 "before installing a new one. However it lacks a safety check that the old"
NSQ_SOURCE_LINE 00001374 "version and the new version will go in the same directory. Used in combination"
NSQ_SOURCE_LINE 00001375 "with local::lib, you can potentially delete a globally accessible version of a"
NSQ_SOURCE_LINE 00001376 "module while installing the new version in a local place. Only combine \"make"
NSQ_SOURCE_LINE 00001377 "install UNINST=1\" and local::lib if you understand these possible consequences."
NSQ_SOURCE_LINE 00001378 ""
NSQ_SOURCE_LINE 00001379 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00001380 ""
NSQ_SOURCE_LINE 00001381 "=over 4"
NSQ_SOURCE_LINE 00001382 ""
NSQ_SOURCE_LINE 00001383 "=item * Directory names with spaces in them are not well supported by the perl"
NSQ_SOURCE_LINE 00001384 "toolchain and the programs it uses.  Pure-perl distributions should support"
NSQ_SOURCE_LINE 00001385 "spaces, but problems are more likely with dists that require compilation. A"
NSQ_SOURCE_LINE 00001386 "workaround you can do is moving your local::lib to a directory with spaces"
NSQ_SOURCE_LINE 00001387 "B<after> you installed all modules inside your local::lib bootstrap. But be"
NSQ_SOURCE_LINE 00001388 "aware that you can't update or install CPAN modules after the move."
NSQ_SOURCE_LINE 00001389 ""
NSQ_SOURCE_LINE 00001390 "=item * Rather basic shell detection. Right now anything with csh in its name is"
NSQ_SOURCE_LINE 00001391 "assumed to be a C shell or something compatible, and everything else is assumed"
NSQ_SOURCE_LINE 00001392 "to be Bourne, except on Win32 systems. If the C<SHELL> environment variable is"
NSQ_SOURCE_LINE 00001393 "not set, a Bourne-compatible shell is assumed."
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 "=item * Kills any existing PERL_MM_OPT or PERL_MB_OPT."
NSQ_SOURCE_LINE 00001396 ""
NSQ_SOURCE_LINE 00001397 "=item * Should probably auto-fixup CPAN config if not already done."
NSQ_SOURCE_LINE 00001398 ""
NSQ_SOURCE_LINE 00001399 "=item * On VMS and MacOS Classic (pre-OS X), local::lib loads L<File::Spec>."
NSQ_SOURCE_LINE 00001400 "This means any L<File::Spec> version installed in the local::lib will be"
NSQ_SOURCE_LINE 00001401 "ignored by scripts using local::lib.  A workaround for this is using"
NSQ_SOURCE_LINE 00001402 "C<use lib \"$local_lib/lib/perl5\";> instead of using C<local::lib> directly."
NSQ_SOURCE_LINE 00001403 ""
NSQ_SOURCE_LINE 00001404 "=item * Conflicts with L<ExtUtils::MakeMaker>'s C<PREFIX> option."
NSQ_SOURCE_LINE 00001405 "C<local::lib> uses the C<INSTALL_BASE> option, as it has more predictable and"
NSQ_SOURCE_LINE 00001406 "sane behavior.  If something attempts to use the C<PREFIX> option when running"
NSQ_SOURCE_LINE 00001407 "a F<Makefile.PL>, L<ExtUtils::MakeMaker> will refuse to run, as the two"
NSQ_SOURCE_LINE 00001408 "options conflict.  This can be worked around by temporarily unsetting the"
NSQ_SOURCE_LINE 00001409 "C<PERL_MM_OPT> environment variable."
NSQ_SOURCE_LINE 00001410 ""
NSQ_SOURCE_LINE 00001411 "=item * Conflicts with L<Module::Build>'s C<--prefix> option.  Similar to the"
NSQ_SOURCE_LINE 00001412 "previous limitation, but any C<--prefix> option specified will be ignored."
NSQ_SOURCE_LINE 00001413 "This can be worked around by temporarily unsetting the C<PERL_MB_OPT>"
NSQ_SOURCE_LINE 00001414 "environment variable."
NSQ_SOURCE_LINE 00001415 ""
NSQ_SOURCE_LINE 00001416 "=back"
NSQ_SOURCE_LINE 00001417 ""
NSQ_SOURCE_LINE 00001418 "Patches very much welcome for any of the above."
NSQ_SOURCE_LINE 00001419 ""
NSQ_SOURCE_LINE 00001420 "=over 4"
NSQ_SOURCE_LINE 00001421 ""
NSQ_SOURCE_LINE 00001422 "=item * On Win32 systems, does not have a way to write the created environment"
NSQ_SOURCE_LINE 00001423 "variables to the registry, so that they can persist through a reboot."
NSQ_SOURCE_LINE 00001424 ""
NSQ_SOURCE_LINE 00001425 "=back"
NSQ_SOURCE_LINE 00001426 ""
NSQ_SOURCE_LINE 00001427 "=head1 TROUBLESHOOTING"
NSQ_SOURCE_LINE 00001428 ""
NSQ_SOURCE_LINE 00001429 "If you've configured local::lib to install CPAN modules somewhere in to your"
NSQ_SOURCE_LINE 00001430 "home directory, and at some point later you try to install a module with C<cpan"
NSQ_SOURCE_LINE 00001431 "-i Foo::Bar>, but it fails with an error like: C<Warning: You do not have"
NSQ_SOURCE_LINE 00001432 "permissions to install into /usr/lib64/perl5/site_perl/5.8.8/x86_64-linux at"
NSQ_SOURCE_LINE 00001433 "/usr/lib64/perl5/5.8.8/Foo/Bar.pm> and buried within the install log is an"
NSQ_SOURCE_LINE 00001434 "error saying C<'INSTALL_BASE' is not a known MakeMaker parameter name>, then"
NSQ_SOURCE_LINE 00001435 "you've somehow lost your updated ExtUtils::MakeMaker module."
NSQ_SOURCE_LINE 00001436 ""
NSQ_SOURCE_LINE 00001437 "To remedy this situation, rerun the bootstrapping procedure documented above."
NSQ_SOURCE_LINE 00001438 ""
NSQ_SOURCE_LINE 00001439 "Then, run C<rm -r ~/.cpan/build/Foo-Bar*>"
NSQ_SOURCE_LINE 00001440 ""
NSQ_SOURCE_LINE 00001441 "Finally, re-run C<cpan -i Foo::Bar> and it should install without problems."
NSQ_SOURCE_LINE 00001442 ""
NSQ_SOURCE_LINE 00001443 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00001444 ""
NSQ_SOURCE_LINE 00001445 "=over 4"
NSQ_SOURCE_LINE 00001446 ""
NSQ_SOURCE_LINE 00001447 "=item SHELL"
NSQ_SOURCE_LINE 00001448 ""
NSQ_SOURCE_LINE 00001449 "=item COMSPEC"
NSQ_SOURCE_LINE 00001450 ""
NSQ_SOURCE_LINE 00001451 "local::lib looks at the user's C<SHELL> environment variable when printing out"
NSQ_SOURCE_LINE 00001452 "commands to add to the shell configuration file."
NSQ_SOURCE_LINE 00001453 ""
NSQ_SOURCE_LINE 00001454 "On Win32 systems, C<COMSPEC> is also examined."
NSQ_SOURCE_LINE 00001455 ""
NSQ_SOURCE_LINE 00001456 "=back"
NSQ_SOURCE_LINE 00001457 ""
NSQ_SOURCE_LINE 00001458 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001459 ""
NSQ_SOURCE_LINE 00001460 "=over 4"
NSQ_SOURCE_LINE 00001461 ""
NSQ_SOURCE_LINE 00001462 "=item * L<Perl Advent article, 2011|http://perladvent.org/2011/2011-12-01.html>"
NSQ_SOURCE_LINE 00001463 ""
NSQ_SOURCE_LINE 00001464 "=back"
