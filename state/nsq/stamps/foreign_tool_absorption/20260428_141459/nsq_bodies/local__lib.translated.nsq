NSQ_SOURCE_LINE 00000092 "    require File::Spec;"
NSQ_SOURCE_LINE 00000093 "    File::Spec->catdir(@_);"
NSQ_SOURCE_LINE 00000094 "  }"
NSQ_SOURCE_LINE 00000095 "  else {"
