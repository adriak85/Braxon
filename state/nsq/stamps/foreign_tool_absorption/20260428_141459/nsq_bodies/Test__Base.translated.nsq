NSQ_SOURCE_LINE 00000396 "sub is_deep() {"
NSQ_SOURCE_LINE 00000397 "    (my ($self), @_) = find_my_self(@_);"
NSQ_SOURCE_LINE 00000398 "    require Test::Deep;"
NSQ_SOURCE_LINE 00000399 "    Test::Deep::cmp_deeply(@_);"
NSQ_SOURCE_LINE 00000400 "}"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "sub run_is_deep() {"
NSQ_SOURCE_LINE 00000403 "    (my ($self), @_) = find_my_self(@_);"
NSQ_SOURCE_LINE 00000404 "    $self->_assert_plan;"
NSQ_SOURCE_LINE 00000405 "    my ($x, $y) = $self->_section_names(@_);"
NSQ_SOURCE_LINE 00000406 "    for my $block (@{$self->block_list}) {"
NSQ_SOURCE_LINE 00000407 "        next unless exists($block->{$x}) and exists($block->{$y});"
NSQ_SOURCE_LINE 00000408 "        $block->run_filters unless $block->is_filtered;"
NSQ_SOURCE_LINE 00000409 "        is_deep($block->$x, $block->$y,"
NSQ_SOURCE_LINE 00000410 "           $block->name ? $block->name : ()"
NSQ_SOURCE_LINE 00000411 "          );"
NSQ_SOURCE_LINE 00000412 "    }"
NSQ_SOURCE_LINE 00000413 "}"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "sub _pre_eval {"
NSQ_SOURCE_LINE 00000416 "    my $spec = shift;"
NSQ_SOURCE_LINE 00000417 "    return unless defined $spec;"
NSQ_SOURCE_LINE 00000418 "    return $spec unless $spec =~"
NSQ_SOURCE_LINE 00000419 "      s/\\A\\s*<<<(.*?)>>>\\s*$//sm;"
NSQ_SOURCE_LINE 00000420 "    my $eval_code = $1;"
NSQ_SOURCE_LINE 00000421 "    eval \"package main; $eval_code\";"
NSQ_SOURCE_LINE 00000422 "    croak $@ if $@;"
NSQ_SOURCE_LINE 00000423 "    return $spec;"
NSQ_SOURCE_LINE 00000424 "}"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "sub _block_list_init {"
NSQ_SOURCE_LINE 00000427 "    my $spec = $self->spec;"
NSQ_SOURCE_LINE 00000428 "    return [] unless defined $spec;"
NSQ_SOURCE_LINE 00000429 "    $spec = $self->_pre_eval($spec);"
NSQ_SOURCE_LINE 00000430 "    my $cd = $self->block_delim;"
NSQ_SOURCE_LINE 00000431 "    my @hunks = ($spec =~ /^(\\Q${cd}\\E.*?(?=^\\Q${cd}\\E|\\z))/msg);"
NSQ_SOURCE_LINE 00000432 "    my $blocks = $self->_choose_blocks(@hunks);"
NSQ_SOURCE_LINE 00000433 "    $self->block_list($blocks); # Need to set early for possible filter use"
NSQ_SOURCE_LINE 00000434 "    my $seq = 1;"
NSQ_SOURCE_LINE 00000435 "    for my $block (@$blocks) {"
NSQ_SOURCE_LINE 00000436 "        $block->blocks_object($self);"
NSQ_SOURCE_LINE 00000437 "        $block->seq_num($seq++);"
NSQ_SOURCE_LINE 00000438 "    }"
NSQ_SOURCE_LINE 00000439 "    return $blocks;"
NSQ_SOURCE_LINE 00000440 "}"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "sub _choose_blocks {"
NSQ_SOURCE_LINE 00000443 "    my $blocks = [];"
NSQ_SOURCE_LINE 00000444 "    for my $hunk (@_) {"
NSQ_SOURCE_LINE 00000445 "        my $block = $self->_make_block($hunk);"
NSQ_SOURCE_LINE 00000446 "        if (exists $block->{ONLY}) {"
NSQ_SOURCE_LINE 00000447 "            diag \"I found ONLY: maybe you're debugging?\""
NSQ_SOURCE_LINE 00000448 "                unless $self->_no_diag_on_only;"
NSQ_SOURCE_LINE 00000449 "            return [$block];"
NSQ_SOURCE_LINE 00000450 "        }"
NSQ_SOURCE_LINE 00000451 "        next if exists $block->{SKIP};"
NSQ_SOURCE_LINE 00000452 "        push @$blocks, $block;"
NSQ_SOURCE_LINE 00000453 "        if (exists $block->{LAST}) {"
NSQ_SOURCE_LINE 00000454 "            return $blocks;"
NSQ_SOURCE_LINE 00000455 "        }"
NSQ_SOURCE_LINE 00000456 "    }"
NSQ_SOURCE_LINE 00000457 "    return $blocks;"
NSQ_SOURCE_LINE 00000458 "}"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "sub _check_reserved {"
NSQ_SOURCE_LINE 00000461 "    my $id = shift;"
NSQ_SOURCE_LINE 00000462 "    croak \"'$id' is a reserved name. Use something else.\\n\""
NSQ_SOURCE_LINE 00000463 "      if $reserved_section_names->{$id} or"
NSQ_SOURCE_LINE 00000464 "         $id =~ /^_/;"
NSQ_SOURCE_LINE 00000465 "}"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "sub _make_block {"
NSQ_SOURCE_LINE 00000468 "    my $hunk = shift;"
NSQ_SOURCE_LINE 00000469 "    my $cd = $self->block_delim;"
NSQ_SOURCE_LINE 00000470 "    my $dd = $self->data_delim;"
NSQ_SOURCE_LINE 00000471 "    my $block = $self->block_class->new;"
NSQ_SOURCE_LINE 00000472 "    $hunk =~ s/\\A\\Q${cd}\\E[ \\t]*(.*)\\s+// or die;"
NSQ_SOURCE_LINE 00000473 "    my $name = $1;"
NSQ_SOURCE_LINE 00000474 "    my @parts = split /^\\Q${dd}\\E +\\(?(\\w+)\\)? *(.*)?\\n/m, $hunk;"
NSQ_SOURCE_LINE 00000475 "    my $description = shift @parts;"
NSQ_SOURCE_LINE 00000476 "    $description ||= '';"
NSQ_SOURCE_LINE 00000477 "    unless ($description =~ /\\S/) {"
NSQ_SOURCE_LINE 00000478 "        $description = $name;"
NSQ_SOURCE_LINE 00000479 "    }"
NSQ_SOURCE_LINE 00000480 "    $description =~ s/\\s*\\z//;"
NSQ_SOURCE_LINE 00000481 "    $block->set_value(description => $description);"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "    my $section_map = {};"
NSQ_SOURCE_LINE 00000484 "    my $section_order = [];"
NSQ_SOURCE_LINE 00000485 "    while (@parts) {"
NSQ_SOURCE_LINE 00000486 "        my ($type, $filters, $value) = splice(@parts, 0, 3);"
NSQ_SOURCE_LINE 00000487 "        $self->_check_reserved($type);"
NSQ_SOURCE_LINE 00000488 "        $value = '' unless defined $value;"
NSQ_SOURCE_LINE 00000489 "        $filters = '' unless defined $filters;"
NSQ_SOURCE_LINE 00000490 "        if ($filters =~ /:(\\s|\\z)/) {"
NSQ_SOURCE_LINE 00000491 "            croak \"Extra lines not allowed in '$type' section\""
NSQ_SOURCE_LINE 00000492 "              if $value =~ /\\S/;"
NSQ_SOURCE_LINE 00000493 "            ($filters, $value) = split /\\s*:(?:\\s+|\\z)/, $filters, 2;"
NSQ_SOURCE_LINE 00000494 "            $value = '' unless defined $value;"
NSQ_SOURCE_LINE 00000495 "            $value =~ s/^\\s*(.*?)\\s*$/$1/;"
NSQ_SOURCE_LINE 00000496 "        }"
NSQ_SOURCE_LINE 00000497 "        $section_map->{$type} = {"
NSQ_SOURCE_LINE 00000498 "            filters => $filters,"
NSQ_SOURCE_LINE 00000499 "        };"
NSQ_SOURCE_LINE 00000500 "        push @$section_order, $type;"
NSQ_SOURCE_LINE 00000501 "        $block->set_value($type, $value);"
NSQ_SOURCE_LINE 00000502 "    }"
NSQ_SOURCE_LINE 00000503 "    $block->set_value(name => $name);"
NSQ_SOURCE_LINE 00000504 "    $block->set_value(_section_map => $section_map);"
NSQ_SOURCE_LINE 00000505 "    $block->set_value(_section_order => $section_order);"
NSQ_SOURCE_LINE 00000506 "    return $block;"
NSQ_SOURCE_LINE 00000507 "}"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "sub _spec_init {"
NSQ_SOURCE_LINE 00000510 "    return $self->_spec_string"
NSQ_SOURCE_LINE 00000511 "      if $self->_spec_string;"
NSQ_SOURCE_LINE 00000512 "    local $/;"
NSQ_SOURCE_LINE 00000513 "    my $spec;"
NSQ_SOURCE_LINE 00000514 "    if (my $spec_file = $self->_spec_file) {"
NSQ_SOURCE_LINE 00000515 "        open FILE, $spec_file or die $!;"
NSQ_SOURCE_LINE 00000516 "        $spec = <FILE>;"
NSQ_SOURCE_LINE 00000517 "        close FILE;"
NSQ_SOURCE_LINE 00000518 "    }"
NSQ_SOURCE_LINE 00000519 "    else {"
NSQ_SOURCE_LINE 00000520 "        require Scalar::Util;"
NSQ_SOURCE_LINE 00000521 "        my $handle = Scalar::Util::openhandle( \\*main::DATA );"
NSQ_SOURCE_LINE 00000522 "        if ($handle) {"
NSQ_SOURCE_LINE 00000523 "            $spec = <$handle>;"
NSQ_SOURCE_LINE 00000524 "        }"
NSQ_SOURCE_LINE 00000525 "    }"
NSQ_SOURCE_LINE 00000526 "    return $spec;"
NSQ_SOURCE_LINE 00000527 "}"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "sub _strict_warnings() {"
NSQ_SOURCE_LINE 00000530 "    require Filter::Util::Call;"
NSQ_SOURCE_LINE 00000531 "    my $done = 0;"
NSQ_SOURCE_LINE 00000532 "    Filter::Util::Call::filter_add("
NSQ_SOURCE_LINE 00000533 "        sub {"
NSQ_SOURCE_LINE 00000534 "            return 0 if $done;"
NSQ_SOURCE_LINE 00000535 "            my ($data, $end) = ('', '');"
NSQ_SOURCE_LINE 00000536 "            while (my $status = Filter::Util::Call::filter_read()) {"
NSQ_SOURCE_LINE 00000537 "                return $status if $status < 0;"
NSQ_SOURCE_LINE 00000538 "                if (/^__(?:END|DATA)__\\r?$/) {"
NSQ_SOURCE_LINE 00000539 "                    $end = $_;"
NSQ_SOURCE_LINE 00000540 "                    last;"
NSQ_SOURCE_LINE 00000541 "                }"
NSQ_SOURCE_LINE 00000542 "                $data .= $_;"
NSQ_SOURCE_LINE 00000543 "                $_ = '';"
NSQ_SOURCE_LINE 00000544 "            }"
NSQ_SOURCE_LINE 00000545 "            $_ = \"use strict;use warnings;$data$end\";"
NSQ_SOURCE_LINE 00000546 "            $done = 1;"
NSQ_SOURCE_LINE 00000547 "        }"
NSQ_SOURCE_LINE 00000548 "    );"
NSQ_SOURCE_LINE 00000549 "}"
NSQ_SOURCE_LINE 00000550 ""
