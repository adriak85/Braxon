NSQ_SOURCE_LINE 00000572 "#==============================================================================="
NSQ_SOURCE_LINE 00000573 "# Test::Base::Block"
NSQ_SOURCE_LINE 00000574 "#"
NSQ_SOURCE_LINE 00000575 "# This is the default class for accessing a Test::Base block object."
NSQ_SOURCE_LINE 00000576 "#==============================================================================="
NSQ_SOURCE_LINE 00000577 "package Test::Base::Block;"
NSQ_SOURCE_LINE 00000578 "our @ISA = qw(Spiffy);"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "our @EXPORT = qw(block_accessor);"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000583 "    return;"
NSQ_SOURCE_LINE 00000584 "}"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "sub block_accessor() {"
NSQ_SOURCE_LINE 00000587 "    my $accessor = shift;"
NSQ_SOURCE_LINE 00000588 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000589 "    return if defined &$accessor;"
NSQ_SOURCE_LINE 00000590 "    *$accessor = sub {"
NSQ_SOURCE_LINE 00000591 "        my $self = shift;"
NSQ_SOURCE_LINE 00000592 "        if (@_) {"
NSQ_SOURCE_LINE 00000593 "            Carp::croak \"Not allowed to set values for '$accessor'\";"
NSQ_SOURCE_LINE 00000594 "        }"
NSQ_SOURCE_LINE 00000595 "        my @list = @{$self->{$accessor} || []};"
NSQ_SOURCE_LINE 00000596 "        return wantarray"
NSQ_SOURCE_LINE 00000597 "        ? (@list)"
NSQ_SOURCE_LINE 00000598 "        : $list[0];"
NSQ_SOURCE_LINE 00000599 "    };"
NSQ_SOURCE_LINE 00000600 "}"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "block_accessor 'name';"
NSQ_SOURCE_LINE 00000603 "block_accessor 'description';"
NSQ_SOURCE_LINE 00000604 "Spiffy::field 'seq_num';"
NSQ_SOURCE_LINE 00000605 "Spiffy::field 'is_filtered';"
NSQ_SOURCE_LINE 00000606 "Spiffy::field 'blocks_object';"
NSQ_SOURCE_LINE 00000607 "Spiffy::field 'original_values' => {};"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "sub set_value {"
NSQ_SOURCE_LINE 00000610 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000611 "    my $accessor = shift;"
NSQ_SOURCE_LINE 00000612 "    block_accessor $accessor"
NSQ_SOURCE_LINE 00000613 "      unless defined &$accessor;"
NSQ_SOURCE_LINE 00000614 "    $self->{$accessor} = [@_];"
NSQ_SOURCE_LINE 00000615 "}"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "sub run_filters {"
NSQ_SOURCE_LINE 00000618 "    my $map = $self->_section_map;"
NSQ_SOURCE_LINE 00000619 "    my $order = $self->_section_order;"
NSQ_SOURCE_LINE 00000620 "    Carp::croak \"Attempt to filter a block twice\""
NSQ_SOURCE_LINE 00000621 "      if $self->is_filtered;"
NSQ_SOURCE_LINE 00000622 "    for my $type (@$order) {"
NSQ_SOURCE_LINE 00000623 "        my $filters = $map->{$type}{filters};"
NSQ_SOURCE_LINE 00000624 "        my @value = $self->$type;"
NSQ_SOURCE_LINE 00000625 "        $self->original_values->{$type} = $value[0];"
NSQ_SOURCE_LINE 00000626 "        for my $filter ($self->_get_filters($type, $filters)) {"
NSQ_SOURCE_LINE 00000627 "            $Test::Base::Filter::arguments ="
NSQ_SOURCE_LINE 00000628 "              $filter =~ s/=(.*)$// ? $1 : undef;"
NSQ_SOURCE_LINE 00000629 "            my $function = \"main::$filter\";"
NSQ_SOURCE_LINE 00000630 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000631 "            if (defined &$function) {"
NSQ_SOURCE_LINE 00000632 "                local $_ ="
NSQ_SOURCE_LINE 00000633 "                    (@value == 1 and not defined($value[0])) ? undef :"
NSQ_SOURCE_LINE 00000634 "                        join '', @value;"
NSQ_SOURCE_LINE 00000635 "                my $old = $_;"
NSQ_SOURCE_LINE 00000636 "                @value = &$function(@value);"
NSQ_SOURCE_LINE 00000637 "                if (not(@value) or"
NSQ_SOURCE_LINE 00000638 "                    @value == 1 and defined($value[0]) and $value[0] =~ /\\A(\\d+|)\\z/"
NSQ_SOURCE_LINE 00000639 "                ) {"
NSQ_SOURCE_LINE 00000640 "                    if ($value[0] && $_ eq $old) {"
NSQ_SOURCE_LINE 00000641 "                        Test::Base::diag(\"Filters returning numbers are supposed to do munging \\$_: your filter '$function' apparently doesn't.\");"
NSQ_SOURCE_LINE 00000642 "                    }"
NSQ_SOURCE_LINE 00000643 "                    @value = ($_);"
NSQ_SOURCE_LINE 00000644 "                }"
NSQ_SOURCE_LINE 00000645 "            }"
NSQ_SOURCE_LINE 00000646 "            else {"
NSQ_SOURCE_LINE 00000647 "                my $filter_object = $self->blocks_object->filter_class->new;"
NSQ_SOURCE_LINE 00000648 "                die \"Can't find a function or method for '$filter' filter\\n\""
NSQ_SOURCE_LINE 00000649 "                  unless $filter_object->can($filter);"
NSQ_SOURCE_LINE 00000650 "                $filter_object->current_block($self);"
NSQ_SOURCE_LINE 00000651 "                @value = $filter_object->$filter(@value);"
NSQ_SOURCE_LINE 00000652 "            }"
NSQ_SOURCE_LINE 00000653 "            # Set the value after each filter since other filters may be"
NSQ_SOURCE_LINE 00000654 "            # introspecting."
NSQ_SOURCE_LINE 00000655 "            $self->set_value($type, @value);"
NSQ_SOURCE_LINE 00000656 "        }"
NSQ_SOURCE_LINE 00000657 "    }"
NSQ_SOURCE_LINE 00000658 "    $self->is_filtered(1);"
NSQ_SOURCE_LINE 00000659 "}"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "sub _get_filters {"
NSQ_SOURCE_LINE 00000662 "    my $type = shift;"
NSQ_SOURCE_LINE 00000663 "    my $string = shift || '';"
NSQ_SOURCE_LINE 00000664 "    $string =~ s/\\s*(.*?)\\s*/$1/;"
NSQ_SOURCE_LINE 00000665 "    my @filters = ();"
NSQ_SOURCE_LINE 00000666 "    my $map_filters = $self->blocks_object->_filters_map->{$type} || [];"
NSQ_SOURCE_LINE 00000667 "    $map_filters = [ $map_filters ] unless ref $map_filters;"
NSQ_SOURCE_LINE 00000668 "    my @append = ();"
NSQ_SOURCE_LINE 00000669 "    for ("
NSQ_SOURCE_LINE 00000670 "        @{$self->blocks_object->_filters},"
NSQ_SOURCE_LINE 00000671 "        @$map_filters,"
NSQ_SOURCE_LINE 00000672 "        split(/\\s+/, $string),"
NSQ_SOURCE_LINE 00000673 "    ) {"
NSQ_SOURCE_LINE 00000674 "        my $filter = $_;"
NSQ_SOURCE_LINE 00000675 "        last unless length $filter;"
NSQ_SOURCE_LINE 00000676 "        if ($filter =~ s/^-//) {"
NSQ_SOURCE_LINE 00000677 "            @filters = grep { $_ ne $filter } @filters;"
NSQ_SOURCE_LINE 00000678 "        }"
NSQ_SOURCE_LINE 00000679 "        elsif ($filter =~ s/^\\+//) {"
NSQ_SOURCE_LINE 00000680 "            push @append, $filter;"
NSQ_SOURCE_LINE 00000681 "        }"
NSQ_SOURCE_LINE 00000682 "        else {"
NSQ_SOURCE_LINE 00000683 "            push @filters, $filter;"
NSQ_SOURCE_LINE 00000684 "        }"
NSQ_SOURCE_LINE 00000685 "    }"
NSQ_SOURCE_LINE 00000686 "    return @filters, @append;"
NSQ_SOURCE_LINE 00000687 "}"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "{"
NSQ_SOURCE_LINE 00000690 "    %$reserved_section_names = map {"
NSQ_SOURCE_LINE 00000691 "        ($_, 1);"
NSQ_SOURCE_LINE 00000692 "    } keys(%Test::Base::Block::), qw( new DESTROY );"
NSQ_SOURCE_LINE 00000693 "}"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "1;"
BODY_END
