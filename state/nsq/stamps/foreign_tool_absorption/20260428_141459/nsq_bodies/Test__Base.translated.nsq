NSQ_SOURCE_LINE 00000287 "my $name_error = \"Can't determine section names\";"
NSQ_SOURCE_LINE 00000288 "sub _section_names {"
NSQ_SOURCE_LINE 00000289 "    return unless defined $self->spec;"
NSQ_SOURCE_LINE 00000290 "    return @_ if @_ == 2;"
NSQ_SOURCE_LINE 00000291 "    my $block = $self->first_block"
NSQ_SOURCE_LINE 00000292 "      or croak $name_error;"
NSQ_SOURCE_LINE 00000293 "    my @names = grep {"
NSQ_SOURCE_LINE 00000294 "        $_ !~ /^(ONLY|LAST|SKIP)$/;"
NSQ_SOURCE_LINE 00000295 "    } @{$block->{_section_order}[0] || []};"
NSQ_SOURCE_LINE 00000296 "    croak \"$name_error. Need two sections in first block\""
NSQ_SOURCE_LINE 00000297 "      unless @names == 2;"
NSQ_SOURCE_LINE 00000298 "    return @names;"
NSQ_SOURCE_LINE 00000299 "}"
