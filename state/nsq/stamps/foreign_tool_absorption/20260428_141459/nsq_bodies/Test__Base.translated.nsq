NSQ_SOURCE_LINE 00000185 "        $self->_next_list($list);"
NSQ_SOURCE_LINE 00000186 "    }"
NSQ_SOURCE_LINE 00000187 "    my $block = shift @$list;"
NSQ_SOURCE_LINE 00000188 "    if (defined $block and not $block->is_filtered) {"
