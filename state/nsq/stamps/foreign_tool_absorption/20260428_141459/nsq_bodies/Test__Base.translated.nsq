NSQ_SOURCE_LINE 00000257 "provides 'is';"
NSQ_SOURCE_LINE 00000258 "sub is($$;$) {"
NSQ_SOURCE_LINE 00000259 "    (my ($self), @_) = find_my_self(@_);"
NSQ_SOURCE_LINE 00000260 "    my ($actual, $expected, $name) = @_;"
NSQ_SOURCE_LINE 00000261 "    local $Test::Builder::Level = $Test::Builder::Level + 1 unless $HAS_PROVIDER;"
NSQ_SOURCE_LINE 00000262 "    if ($ENV{TEST_SHOW_NO_DIFFS} or"
NSQ_SOURCE_LINE 00000263 "         not defined $actual or"
NSQ_SOURCE_LINE 00000264 "         not defined $expected or"
NSQ_SOURCE_LINE 00000265 "         $actual eq $expected or"
NSQ_SOURCE_LINE 00000266 "         not($self->have_text_diff) or"
NSQ_SOURCE_LINE 00000267 "         $expected !~ /\\n./s"
NSQ_SOURCE_LINE 00000268 "    ) {"
NSQ_SOURCE_LINE 00000269 "        Test::More::is($actual, $expected, $name);"
NSQ_SOURCE_LINE 00000270 "    }"
NSQ_SOURCE_LINE 00000271 "    else {"
NSQ_SOURCE_LINE 00000272 "        $name = '' unless defined $name;"
NSQ_SOURCE_LINE 00000273 "        ok $actual eq $expected, $name;"
NSQ_SOURCE_LINE 00000274 "        diag Text::Diff::diff(\\$expected, \\$actual);"
NSQ_SOURCE_LINE 00000275 "    }"
NSQ_SOURCE_LINE 00000276 "}"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "sub run(&;$) {"
NSQ_SOURCE_LINE 00000279 "    (my ($self), @_) = find_my_self(@_);"
NSQ_SOURCE_LINE 00000280 "    my $callback = shift;"
NSQ_SOURCE_LINE 00000281 "    for my $block (@{$self->block_list}) {"
NSQ_SOURCE_LINE 00000282 "        $block->run_filters unless $block->is_filtered;"
NSQ_SOURCE_LINE 00000283 "        &{$callback}($block);"
NSQ_SOURCE_LINE 00000284 "    }"
NSQ_SOURCE_LINE 00000285 "}"
