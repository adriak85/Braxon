NSQ_SOURCE_LINE 00000138 "sub check_late {"
NSQ_SOURCE_LINE 00000139 "    if ($self->{block_list}) {"
NSQ_SOURCE_LINE 00000140 "        my $caller = (caller(1))[3];"
