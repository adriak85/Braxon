NSQ_SOURCE_LINE 00000159 "      if @_ && $_[0] !~ /^[a-zA-Z]\\w*$/;"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    my $blocks = $self->block_list;"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    my $section_name = shift || '';"
NSQ_SOURCE_LINE 00000164 "    my @blocks = $section_name"
NSQ_SOURCE_LINE 00000165 "    ? (grep { exists $_->{$section_name} } @$blocks)"
NSQ_SOURCE_LINE 00000166 "    : (@$blocks);"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    return scalar(@blocks) unless wantarray;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    return (@blocks) if $self->_filters_delay;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    for my $block (@blocks) {"
NSQ_SOURCE_LINE 00000173 "        $block->run_filters"
NSQ_SOURCE_LINE 00000174 "          unless $block->is_filtered;"
NSQ_SOURCE_LINE 00000175 "    }"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    return (@blocks);"
NSQ_SOURCE_LINE 00000178 "}"
