NSQ_SOURCE_LINE 00000127 "sub find_class {"
NSQ_SOURCE_LINE 00000128 "    my $suffix = shift;"
NSQ_SOURCE_LINE 00000129 "    my $class = ref($self) . \"::$suffix\";"
NSQ_SOURCE_LINE 00000130 "    return $class if $class->can('new');"
NSQ_SOURCE_LINE 00000131 "    $class = __PACKAGE__ . \"::$suffix\";"
NSQ_SOURCE_LINE 00000132 "    return $class if $class->can('new');"
NSQ_SOURCE_LINE 00000133 "    eval \"require $class\";"
NSQ_SOURCE_LINE 00000134 "    return $class if $class->can('new');"
NSQ_SOURCE_LINE 00000135 "    die \"Can't find a class for $suffix\";"
NSQ_SOURCE_LINE 00000136 "}"
