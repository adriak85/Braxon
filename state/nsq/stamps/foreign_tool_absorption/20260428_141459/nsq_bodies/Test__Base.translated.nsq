NSQ_SOURCE_LINE 00000309 "sub run_compare() {"
NSQ_SOURCE_LINE 00000310 "    (my ($self), @_) = find_my_self(@_);"
NSQ_SOURCE_LINE 00000311 "    return unless defined $self->spec;"
NSQ_SOURCE_LINE 00000312 "    $self->_assert_plan;"
NSQ_SOURCE_LINE 00000313 "    my ($x, $y) = $self->_section_names(@_);"
NSQ_SOURCE_LINE 00000314 "    local $Test::Builder::Level = $Test::Builder::Level + 1;"
NSQ_SOURCE_LINE 00000315 "    for my $block (@{$self->block_list}) {"
NSQ_SOURCE_LINE 00000316 "        next unless exists($block->{$x}) and exists($block->{$y});"
NSQ_SOURCE_LINE 00000317 "        $block->run_filters unless $block->is_filtered;"
NSQ_SOURCE_LINE 00000318 "        if (ref $block->$x) {"
NSQ_SOURCE_LINE 00000319 "            is_deeply($block->$x, $block->$y,"
NSQ_SOURCE_LINE 00000320 "                $block->name ? $block->name : ());"
NSQ_SOURCE_LINE 00000321 "        }"
NSQ_SOURCE_LINE 00000322 "        elsif (ref $block->$y eq 'Regexp') {"
NSQ_SOURCE_LINE 00000323 "            my $regexp = ref $y ? $y : $block->$y;"
NSQ_SOURCE_LINE 00000324 "            like($block->$x, $regexp, $block->name ? $block->name : ());"
NSQ_SOURCE_LINE 00000325 "        }"
NSQ_SOURCE_LINE 00000326 "        else {"
NSQ_SOURCE_LINE 00000327 "            is($block->$x, $block->$y, $block->name ? $block->name : ());"
NSQ_SOURCE_LINE 00000328 "        }"
NSQ_SOURCE_LINE 00000329 "    }"
NSQ_SOURCE_LINE 00000330 "}"
