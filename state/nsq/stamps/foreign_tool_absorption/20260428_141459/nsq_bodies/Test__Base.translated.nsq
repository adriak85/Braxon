NSQ_SOURCE_LINE 00000561 "package Test::Base::Handle;"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "sub TIEHANDLE() {"
NSQ_SOURCE_LINE 00000564 "    my $class = shift;"
