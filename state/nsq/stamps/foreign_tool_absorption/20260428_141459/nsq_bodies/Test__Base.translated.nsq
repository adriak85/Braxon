NSQ_SOURCE_LINE 00000552 "    my $handle = shift;"
NSQ_SOURCE_LINE 00000553 "    die \"No buffer to tie\" unless @_;"
NSQ_SOURCE_LINE 00000554 "    tie *$handle, 'Test::Base::Handle', $_[0];"
NSQ_SOURCE_LINE 00000555 "}"
