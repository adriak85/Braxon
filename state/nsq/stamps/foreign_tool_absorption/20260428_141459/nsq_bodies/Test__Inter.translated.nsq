NSQ_SOURCE_LINE 00000006 "###############################################################################"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "require 5.004;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 "use strict;"
NSQ_SOURCE_LINE 00000012 "use File::Basename;"
NSQ_SOURCE_LINE 00000013 "use IO::File;"
NSQ_SOURCE_LINE 00000014 "use Cwd 'abs_path';"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our($VERSION);"
NSQ_SOURCE_LINE 00000017 "$VERSION='1.12';"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "###############################################################################"
NSQ_SOURCE_LINE 00000020 "# BASE METHODS"
NSQ_SOURCE_LINE 00000021 "###############################################################################"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub version {"
NSQ_SOURCE_LINE 00000024 "   my($self) = @_;"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "   return $VERSION;"
NSQ_SOURCE_LINE 00000027 "}"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub new {"
NSQ_SOURCE_LINE 00000030 "   my($class,@args) = @_;"
NSQ_SOURCE_LINE 00000031 "   my($name,%opts);"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "   if (@args % 2) {"
NSQ_SOURCE_LINE 00000034 "      ($name,%opts) = @args;"
NSQ_SOURCE_LINE 00000035 "   } else {"
NSQ_SOURCE_LINE 00000036 "      $name = $0;"
NSQ_SOURCE_LINE 00000037 "      $name =~ s,^\\./,,;"
NSQ_SOURCE_LINE 00000038 "      %opts = @args;"
NSQ_SOURCE_LINE 00000039 "   }"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "   # The basic structure"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "   my $self = {"
NSQ_SOURCE_LINE 00000044 "               'name'     => $name,  # the name of the test script"
NSQ_SOURCE_LINE 00000045 "               'start'    => 1,      # the first test to run"
NSQ_SOURCE_LINE 00000046 "               'end'      => 0,      # the last test to end"
NSQ_SOURCE_LINE 00000047 "               'plan'     => 0,      # the number of tests planned"
NSQ_SOURCE_LINE 00000048 "               'abort'    => 0,      # abort on the first failed test"
NSQ_SOURCE_LINE 00000049 "               'quiet'    => 0,      # if 1, no output on successes"
NSQ_SOURCE_LINE 00000050 "                                     # (this should only be done when"
NSQ_SOURCE_LINE 00000051 "                                     # running as an interactive script)"
NSQ_SOURCE_LINE 00000052 "               'mode'     => 'test', # mode to run script in"
NSQ_SOURCE_LINE 00000053 "               'width'    => 80,     # width of terminal"
NSQ_SOURCE_LINE 00000054 "               'features' => {},     # a list of available features"
NSQ_SOURCE_LINE 00000055 "               'use_lib'  => 'on',   # whether to run 'use lib' when loading"
NSQ_SOURCE_LINE 00000056 "                                     # this module"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "               'skipall'  => '',     # the reason for skipping all"
NSQ_SOURCE_LINE 00000059 "                                     # remaining tests"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "               'plandone' => 0,      # 1 if a plan is done"
NSQ_SOURCE_LINE 00000062 "               'testsrun' => 0,      # 1 if any tests have been run"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "               'libdir'   => '',     # a directory to load modules from"
NSQ_SOURCE_LINE 00000065 "               'testdir'  => '',     # the test directory"
NSQ_SOURCE_LINE 00000066 "              };"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "   bless $self, $class;"
NSQ_SOURCE_LINE 00000069 "   $main::TI_NUM = 0;"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "   # Handle options, environment variables, global variables"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "   my @opts = qw(start end testnum plan abort quiet mode width skip_all);"
NSQ_SOURCE_LINE 00000074 "   my %o    = map { $_,1 } @opts;"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "   no strict 'refs';"
NSQ_SOURCE_LINE 00000077 "   foreach my $opt (@opts) {"
NSQ_SOURCE_LINE 00000078 "      my $OPT = uc(\"ti_$opt\");"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "      my $val;"
NSQ_SOURCE_LINE 00000081 "      if (defined ${ \"main::$OPT\" }) {"
NSQ_SOURCE_LINE 00000082 "         $val = ${ \"main::$OPT\" };"
NSQ_SOURCE_LINE 00000083 "      } elsif (exists $ENV{$OPT}) {"
NSQ_SOURCE_LINE 00000084 "         $val = $ENV{$OPT};"
NSQ_SOURCE_LINE 00000085 "      } elsif (exists $opts{$opt}) {"
NSQ_SOURCE_LINE 00000086 "         $val = $opts{$opt};"
NSQ_SOURCE_LINE 00000087 "      } else {"
NSQ_SOURCE_LINE 00000088 "         next;"
NSQ_SOURCE_LINE 00000089 "      }"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "      &{ \"Test::Inter::$opt\" }($self,$val);"
NSQ_SOURCE_LINE 00000092 "   }"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "   # uncoverable branch true"
NSQ_SOURCE_LINE 00000095 "   if ($$self{'mode'} ne 'test') {"
NSQ_SOURCE_LINE 00000096 "      print \"\\nRunning $name...\\n\";  # uncoverable statement"
NSQ_SOURCE_LINE 00000097 "   }"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "   # We assume that the module is distributed in a directory with the correct"
NSQ_SOURCE_LINE 00000100 "   # hierarchy.  This is:"
NSQ_SOURCE_LINE 00000101 "   #      /some/path      MODDIR"
NSQ_SOURCE_LINE 00000102 "   #                /t    TESTDIR"
NSQ_SOURCE_LINE 00000103 "   #                /lib  LIBDIR"
NSQ_SOURCE_LINE 00000104 "   # We'll find the full path to each."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "   my($moddir,$testdir,$libdir);"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "   # uncoverable branch false"
NSQ_SOURCE_LINE 00000109 "   # uncoverable branch true count:2"
NSQ_SOURCE_LINE 00000110 "   # uncoverable branch false count:2"
NSQ_SOURCE_LINE 00000111 "   # uncoverable branch true count:3"
NSQ_SOURCE_LINE 00000112 "   # uncoverable branch false count:3"
NSQ_SOURCE_LINE 00000113 "   if (-f \"$0\") {"
NSQ_SOURCE_LINE 00000114 "      $moddir = dirname(dirname(abs_path($0)));"
NSQ_SOURCE_LINE 00000115 "   } elsif (-d \"./t\") {"
NSQ_SOURCE_LINE 00000116 "      $moddir = dirname(abs_path('.'));   # uncoverable statement"
NSQ_SOURCE_LINE 00000117 "   } elsif (-d \"../t\") {"
NSQ_SOURCE_LINE 00000118 "      $moddir = dirname(abs_path('..'));  # uncoverable statement"
NSQ_SOURCE_LINE 00000119 "   }"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "   # uncoverable branch false"
NSQ_SOURCE_LINE 00000122 "   if (-d \"$moddir/t\") {"
NSQ_SOURCE_LINE 00000123 "      $testdir = \"$moddir/t\";"
NSQ_SOURCE_LINE 00000124 "   }"
NSQ_SOURCE_LINE 00000125 "   # uncoverable branch false"
NSQ_SOURCE_LINE 00000126 "   if (-d \"$moddir/lib\") {"
NSQ_SOURCE_LINE 00000127 "      $libdir  = \"$moddir/lib\";"
NSQ_SOURCE_LINE 00000128 "   }"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "   $$self{'moddir'}  = $moddir;"
NSQ_SOURCE_LINE 00000131 "   $$self{'testdir'} = $testdir;"
NSQ_SOURCE_LINE 00000132 "   $$self{'libdir'}  = $libdir;"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "   $self->use_lib();"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "   return $self;"
NSQ_SOURCE_LINE 00000137 "}"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "sub use_lib {"
NSQ_SOURCE_LINE 00000140 "   my($self,$val) = @_;"
NSQ_SOURCE_LINE 00000141 "   if (defined $val) {"
NSQ_SOURCE_LINE 00000142 "      $$self{'use_lib'} = $val;"
NSQ_SOURCE_LINE 00000143 "      return;"
NSQ_SOURCE_LINE 00000144 "   }"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "   if ($$self{'use_lib'} eq 'on') {"
NSQ_SOURCE_LINE 00000147 "      foreach my $dir ($$self{'libdir'},$$self{'testdir'}) {"
NSQ_SOURCE_LINE 00000148 "         next  if (! defined $dir);"
NSQ_SOURCE_LINE 00000149 "         eval \"use lib '$dir'\";"
NSQ_SOURCE_LINE 00000150 "      }"
NSQ_SOURCE_LINE 00000151 "   }"
NSQ_SOURCE_LINE 00000152 "}"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "sub testdir {"
NSQ_SOURCE_LINE 00000155 "   my($self,$req) = @_;"
NSQ_SOURCE_LINE 00000156 "   if ($req  &&  $req eq 'mod') {"
NSQ_SOURCE_LINE 00000157 "      return $$self{'moddir'};"
NSQ_SOURCE_LINE 00000158 "   } elsif ($req  &&  $req eq 'lib') {"
NSQ_SOURCE_LINE 00000159 "      return $$self{'libdir'};"
NSQ_SOURCE_LINE 00000160 "   }"
NSQ_SOURCE_LINE 00000161 "   return $$self{'testdir'};"
NSQ_SOURCE_LINE 00000162 "}"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "sub start {"
NSQ_SOURCE_LINE 00000165 "   my($self,$val) = @_;"
NSQ_SOURCE_LINE 00000166 "   $val = 1  if (! defined($val));"
NSQ_SOURCE_LINE 00000167 "   $self->_die(\"start requires an integer value\")  if ($val !~ /^\\d+$/);"
NSQ_SOURCE_LINE 00000168 "   $$self{'start'} = $val;"
NSQ_SOURCE_LINE 00000169 "}"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "sub end {"
NSQ_SOURCE_LINE 00000172 "   my($self,$val) = @_;"
NSQ_SOURCE_LINE 00000173 "   $val = 0  if (! $val);"
NSQ_SOURCE_LINE 00000174 "   $self->_die(\"end requires an integer value\")  if ($val !~ /^\\d+$/);"
NSQ_SOURCE_LINE 00000175 "   $$self{'end'} = $val;"
NSQ_SOURCE_LINE 00000176 "}"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "sub testnum {"
NSQ_SOURCE_LINE 00000179 "   my($self,$val) = @_;"
NSQ_SOURCE_LINE 00000180 "   if (! defined($val)) {"
NSQ_SOURCE_LINE 00000181 "      $$self{'start'} = 1;"
NSQ_SOURCE_LINE 00000182 "      $$self{'end'}   = 0;"
NSQ_SOURCE_LINE 00000183 "   } else {"
NSQ_SOURCE_LINE 00000184 "      $self->_die(\"testnum requires an integer value\")  if ($val !~ /^\\d+$/);"
NSQ_SOURCE_LINE 00000185 "      $$self{'start'} = $$self{'end'} = $val;"
NSQ_SOURCE_LINE 00000186 "   }"
NSQ_SOURCE_LINE 00000187 "}"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "sub plan {"
NSQ_SOURCE_LINE 00000190 "   my($self,$val) = @_;"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "   if ($$self{'plandone'}) {"
NSQ_SOURCE_LINE 00000193 "      $self->_die('Plan/done_testing included twice');"
NSQ_SOURCE_LINE 00000194 "   }"
NSQ_SOURCE_LINE 00000195 "   $$self{'plandone'} = 1;"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "   $val = 0  if (! defined($val));"
NSQ_SOURCE_LINE 00000198 "   $self->_die(\"plan requires an integer value\")  if ($val !~ /^\\d+$/);"
NSQ_SOURCE_LINE 00000199 "   $$self{'plan'} = $val;"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "   if ($val != 0) {"
NSQ_SOURCE_LINE 00000202 "      $self->_plan($val);"
NSQ_SOURCE_LINE 00000203 "   }"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "sub done_testing {"
NSQ_SOURCE_LINE 00000207 "   my($self,$val) = @_;"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "   if ($$self{'plandone'}) {"
NSQ_SOURCE_LINE 00000210 "      $self->_die('Plan/done_testing included twice');"
NSQ_SOURCE_LINE 00000211 "   }"
NSQ_SOURCE_LINE 00000212 "   $$self{'plandone'} = 1;"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "   $val = $main::TI_NUM  if (! $val);"
NSQ_SOURCE_LINE 00000215 "   $self->_die(\"done_testing requires an integer value\")  if ($val !~ /^\\d+$/);"
NSQ_SOURCE_LINE 00000216 "   $self->_plan($val);"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "   if ($val != $main::TI_NUM) {"
NSQ_SOURCE_LINE 00000219 "      $self->_die(\"Ran $main::TI_NUM tests, expected $val\");"
NSQ_SOURCE_LINE 00000220 "   }"
NSQ_SOURCE_LINE 00000221 "}"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "sub abort {"
NSQ_SOURCE_LINE 00000224 "   my($self,$val) = @_;"
NSQ_SOURCE_LINE 00000225 "   $val = 0  if (! $val);"
NSQ_SOURCE_LINE 00000226 "   $$self{'abort'} = $val;"
NSQ_SOURCE_LINE 00000227 "}"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "sub quiet {"
NSQ_SOURCE_LINE 00000230 "   my($self,$val) = @_;"
NSQ_SOURCE_LINE 00000231 "   $val = 0  if (! $val);"
NSQ_SOURCE_LINE 00000232 "   $$self{'quiet'} = $val;"
NSQ_SOURCE_LINE 00000233 "}"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "sub mode {"
NSQ_SOURCE_LINE 00000236 "   my($self,$val) = @_;"
NSQ_SOURCE_LINE 00000237 "   $val = 'test'  if (! $val);"
NSQ_SOURCE_LINE 00000238 "   $$self{'mode'} = $val;"
NSQ_SOURCE_LINE 00000239 "}"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "sub width {"
NSQ_SOURCE_LINE 00000242 "   my($self,$val) = @_;"
NSQ_SOURCE_LINE 00000243 "   $val = 0  if (! $val);"
NSQ_SOURCE_LINE 00000244 "   $$self{'width'} = $val;"
NSQ_SOURCE_LINE 00000245 "}"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "sub skip_all {"
NSQ_SOURCE_LINE 00000248 "   my($self,$reason,@features) = @_;"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "   if (@features) {"
NSQ_SOURCE_LINE 00000251 "      my $skip = 0;"
NSQ_SOURCE_LINE 00000252 "      foreach my $feature (@features) {"
NSQ_SOURCE_LINE 00000253 "         if (! exists $$self{'features'}{$feature}  ||"
NSQ_SOURCE_LINE 00000254 "             ! $$self{'features'}{$feature}) {"
NSQ_SOURCE_LINE 00000255 "            $skip   = 1;"
NSQ_SOURCE_LINE 00000256 "            $reason = \"Required feature ($feature) missing\""
NSQ_SOURCE_LINE 00000257 "              if (! $reason);"
NSQ_SOURCE_LINE 00000258 "            last;"
NSQ_SOURCE_LINE 00000259 "         }"
NSQ_SOURCE_LINE 00000260 "      }"
NSQ_SOURCE_LINE 00000261 "      return  if (! $skip);"
NSQ_SOURCE_LINE 00000262 "   }"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "   if ($$self{'plandone'}  ||"
NSQ_SOURCE_LINE 00000265 "       $$self{'testsrun'}) {"
NSQ_SOURCE_LINE 00000266 "      $reason = 'Remaining tests skipped'  if (! $reason);"
NSQ_SOURCE_LINE 00000267 "      $$self{'skipall'} = $reason;"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "   } else {"
NSQ_SOURCE_LINE 00000270 "      $reason = 'Test script skipped'  if (! $reason);"
NSQ_SOURCE_LINE 00000271 "      $self->_plan(0,$reason);"
NSQ_SOURCE_LINE 00000272 "      exit 0;"
NSQ_SOURCE_LINE 00000273 "   }"
NSQ_SOURCE_LINE 00000274 "}"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "sub _die {"
NSQ_SOURCE_LINE 00000277 "   my($self,$message) = @_;"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "   print \"ERROR: $message\\n\";"
NSQ_SOURCE_LINE 00000280 "   exit 1;"
NSQ_SOURCE_LINE 00000281 "}"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "sub feature {"
NSQ_SOURCE_LINE 00000284 "   my($self,$feature,$val) = @_;"
NSQ_SOURCE_LINE 00000285 "   $$self{'features'}{$feature} = $val;"
NSQ_SOURCE_LINE 00000286 "}"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "sub diag {"
NSQ_SOURCE_LINE 00000289 "   my($self,$message) = @_;"
NSQ_SOURCE_LINE 00000290 "   return  if ($$self{'quiet'} == 2);"
NSQ_SOURCE_LINE 00000291 "   $self->_diag($message);"
NSQ_SOURCE_LINE 00000292 "}"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "sub note {"
NSQ_SOURCE_LINE 00000295 "   my($self,$message) = @_;"
NSQ_SOURCE_LINE 00000296 "   return  if ($$self{'quiet'});"
NSQ_SOURCE_LINE 00000297 "   $self->_diag($message);"
NSQ_SOURCE_LINE 00000298 "}"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "###############################################################################"
NSQ_SOURCE_LINE 00000301 "# LOAD METHODS"
NSQ_SOURCE_LINE 00000302 "###############################################################################"
NSQ_SOURCE_LINE 00000303 "# The routines were originally from Test::More (though they have been"
NSQ_SOURCE_LINE 00000304 "# changed... some to a greater extent than others)."
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "sub require_ok {"
NSQ_SOURCE_LINE 00000307 "   my($self,$module,$mode) = @_;"
NSQ_SOURCE_LINE 00000308 "   $mode = ''  if (! $mode);"
NSQ_SOURCE_LINE 00000309 "   $main::TI_NUM++  unless ($mode eq 'feature');"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "   my $pack = caller;"
NSQ_SOURCE_LINE 00000312 "   my @inc  = map { \"unshift(\\@INC,'$_');\\n\" }"
NSQ_SOURCE_LINE 00000313 "     ($$self{'libdir'},$$self{'testdir'});"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "   my($desc,$code);"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "   if ( $module =~ /^\\d+(?:\\.\\d+)?$/ ) {"
NSQ_SOURCE_LINE 00000318 "      # A perl version check."
NSQ_SOURCE_LINE 00000319 "      $desc   = \"require perl $module\";"
NSQ_SOURCE_LINE 00000320 "      $code   = <<REQUIRE;"
NSQ_SOURCE_LINE 00000321 "require $module;"
NSQ_SOURCE_LINE 00000322 "1;"
NSQ_SOURCE_LINE 00000323 "REQUIRE"
NSQ_SOURCE_LINE 00000324 "   } else {"
NSQ_SOURCE_LINE 00000325 "      $module = qq['$module'] unless $self->_is_module_name($module);"
NSQ_SOURCE_LINE 00000326 "      $desc   = \"require $module\";"
NSQ_SOURCE_LINE 00000327 "      # So the following do not get picked up by cpantorpm-depreq or other"
NSQ_SOURCE_LINE 00000328 "      # tools that try to determine dependencies and prereqs"
NSQ_SOURCE_LINE 00000329 "      my $p   = \"package\";"
NSQ_SOURCE_LINE 00000330 "      my $r   = \"require\";"
NSQ_SOURCE_LINE 00000331 "      $code   = <<REQUIRE;"
NSQ_SOURCE_LINE 00000332 "$p $pack;"
NSQ_SOURCE_LINE 00000333 "@inc"
NSQ_SOURCE_LINE 00000334 "$r $module;"
NSQ_SOURCE_LINE 00000335 "1;"
NSQ_SOURCE_LINE 00000336 "REQUIRE"
NSQ_SOURCE_LINE 00000337 "   }"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "   $desc   .= ' (should not load)'  if ($mode eq 'forbid');"
NSQ_SOURCE_LINE 00000340 "   $desc   .= ' (feature)'          if ($mode eq 'feature');"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "   my($eval_result,$eval_error) = $self->_eval($code);"
NSQ_SOURCE_LINE 00000343 "   chomp($eval_error);"
NSQ_SOURCE_LINE 00000344 "   my @eval_error = split(/\\n/,$eval_error);"
NSQ_SOURCE_LINE 00000345 "   foreach my $err (@eval_error) {"
NSQ_SOURCE_LINE 00000346 "      $err =~ s/ \\(\\@INC contains.*//; # strip out the actual @INC values"
NSQ_SOURCE_LINE 00000347 "   }"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "   my $ok = 1;"
NSQ_SOURCE_LINE 00000350 "   if ($eval_result) {"
NSQ_SOURCE_LINE 00000351 "      # Able to load the module"
NSQ_SOURCE_LINE 00000352 "      if ($mode eq 'forbid') {"
NSQ_SOURCE_LINE 00000353 "         $$self{'skipall'} = 'Loaded a module not supposed to be present';"
NSQ_SOURCE_LINE 00000354 "         $self->_not_ok($desc);"
NSQ_SOURCE_LINE 00000355 "         $self->_diag('Test required that module not be loadable')"
NSQ_SOURCE_LINE 00000356 "           unless ($$self{'quiet'} == 2);"
NSQ_SOURCE_LINE 00000357 "         $ok = 0;"
NSQ_SOURCE_LINE 00000358 "      } elsif ($mode eq 'feature') {"
NSQ_SOURCE_LINE 00000359 "         $self->feature($module,1);"
NSQ_SOURCE_LINE 00000360 "         if (! $$self{'quiet'}) {"
NSQ_SOURCE_LINE 00000361 "            $self->_diag($desc);"
NSQ_SOURCE_LINE 00000362 "            $self->_diag(\"Feature available: $module\");"
NSQ_SOURCE_LINE 00000363 "         }"
NSQ_SOURCE_LINE 00000364 "      } else {"
NSQ_SOURCE_LINE 00000365 "         $self->_ok($desc);"
NSQ_SOURCE_LINE 00000366 "      }"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "   } else {"
NSQ_SOURCE_LINE 00000369 "      # Unable to load the module"
NSQ_SOURCE_LINE 00000370 "      if ($mode eq 'forbid') {"
NSQ_SOURCE_LINE 00000371 "         $self->_ok($desc);"
NSQ_SOURCE_LINE 00000372 "      } elsif ($mode eq 'feature') {"
NSQ_SOURCE_LINE 00000373 "         $self->feature($module,0);"
NSQ_SOURCE_LINE 00000374 "         if (! $$self{'quiet'}) {"
NSQ_SOURCE_LINE 00000375 "            $self->_diag($desc);"
NSQ_SOURCE_LINE 00000376 "            $self->_diag(\"Feature unavailable: $module\");"
NSQ_SOURCE_LINE 00000377 "         }"
NSQ_SOURCE_LINE 00000378 "      } else {"
NSQ_SOURCE_LINE 00000379 "         $$self{'skipall'} = 'Unable to load a required module';"
NSQ_SOURCE_LINE 00000380 "         $self->_not_ok($desc);"
NSQ_SOURCE_LINE 00000381 "         $ok = 0;"
NSQ_SOURCE_LINE 00000382 "      }"
NSQ_SOURCE_LINE 00000383 "   }"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "   return"
NSQ_SOURCE_LINE 00000386 "     if ( ($ok    &&  $$self{'quiet'})  ||"
NSQ_SOURCE_LINE 00000387 "          (! $ok  &&  $$self{'quiet'} == 2) );"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "   foreach my $err (@eval_error) {"
NSQ_SOURCE_LINE 00000390 "      $self->_diag($err);"
NSQ_SOURCE_LINE 00000391 "   }"
NSQ_SOURCE_LINE 00000392 "}"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "sub use_ok {"
NSQ_SOURCE_LINE 00000395 "   my($self,@args) = @_;"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "   my $mode = '';"
NSQ_SOURCE_LINE 00000398 "   if ($args[$#args] eq 'forbid'  ||"
NSQ_SOURCE_LINE 00000399 "       $args[$#args] eq 'feature') {"
NSQ_SOURCE_LINE 00000400 "      $mode = pop(@args);"
NSQ_SOURCE_LINE 00000401 "   }"
NSQ_SOURCE_LINE 00000402 "   $main::TI_NUM++  unless ($mode eq 'feature');"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "   my $pack = caller;"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "   my($code,$desc,$module);"
NSQ_SOURCE_LINE 00000407 "   if ( @args == 1 and $args[0] =~ /^\\d+(?:\\.\\d+)?$/ ) {"
NSQ_SOURCE_LINE 00000408 "      # A perl version check."
NSQ_SOURCE_LINE 00000409 "      $desc   = \"require perl $args[0]\";"
NSQ_SOURCE_LINE 00000410 "      $module = 'perl';"
NSQ_SOURCE_LINE 00000411 "      $code   = <<USE;"
NSQ_SOURCE_LINE 00000412 "use $args[0];"
NSQ_SOURCE_LINE 00000413 "1;"
NSQ_SOURCE_LINE 00000414 "USE"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "   } elsif (@args) {"
NSQ_SOURCE_LINE 00000417 "      $module = shift(@args);"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "      if (! $self->_is_module_name($module)) {"
NSQ_SOURCE_LINE 00000420 "         $self->_not_ok(\"use module: invalid module name: $module\");"
NSQ_SOURCE_LINE 00000421 "         return;"
NSQ_SOURCE_LINE 00000422 "      }"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "      my $vers = '';"
NSQ_SOURCE_LINE 00000425 "      if ( @args  and  $args[0] =~ /^\\d+(?:\\.\\d+)?$/ ) {"
NSQ_SOURCE_LINE 00000426 "         $vers = shift(@args);"
NSQ_SOURCE_LINE 00000427 "      }"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "      my $imports = (@args ? 'qw(' . join(' ',@args) . ')' : '');"
NSQ_SOURCE_LINE 00000430 "      $desc = \"use $module $vers $imports\";"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "      my @inc  = map { \"unshift(\\@INC,'$_');\\n\" } ($$self{'libdir'},$$self{'testdir'});"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "      # So the following do not get picked up by cpantorpm-depreq or other"
NSQ_SOURCE_LINE 00000435 "      # tools that try to determine dependencies and prereqs"
NSQ_SOURCE_LINE 00000436 "      my $p   = \"package\";"
NSQ_SOURCE_LINE 00000437 "      $code = <<USE;"
NSQ_SOURCE_LINE 00000438 "$p $pack;"
NSQ_SOURCE_LINE 00000439 "@inc"
NSQ_SOURCE_LINE 00000440 "use $module $vers $imports;"
NSQ_SOURCE_LINE 00000441 "1;"
NSQ_SOURCE_LINE 00000442 "USE"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "   } else {"
NSQ_SOURCE_LINE 00000445 "      $self->_not_ok('use module: no module specified');"
NSQ_SOURCE_LINE 00000446 "      return;"
NSQ_SOURCE_LINE 00000447 "   }"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "   $desc   .= ' (should not load)'  if ($mode eq 'forbid');"
NSQ_SOURCE_LINE 00000450 "   $desc   .= ' (feature)'          if ($mode eq 'feature');"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "   my($eval_result,$eval_error) = $self->_eval($code);"
NSQ_SOURCE_LINE 00000453 "   chomp($eval_error);"
NSQ_SOURCE_LINE 00000454 "   my @eval_error = split(/\\n/,$eval_error);"
NSQ_SOURCE_LINE 00000455 "   @eval_error    = grep(!/^BEGIN failed--compilation aborted/,@eval_error);"
NSQ_SOURCE_LINE 00000456 "   foreach my $err (@eval_error) {"
NSQ_SOURCE_LINE 00000457 "      $err =~ s/ \\(\\@INC contains.*//; # strip out the actual @INC values"
NSQ_SOURCE_LINE 00000458 "   }"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "   my $ok = 1;"
NSQ_SOURCE_LINE 00000461 "   if ($eval_result) {"
NSQ_SOURCE_LINE 00000462 "      # Able to load the module"
NSQ_SOURCE_LINE 00000463 "      if ($mode eq 'forbid') {"
NSQ_SOURCE_LINE 00000464 "         $$self{'skipall'} = 'Loaded a module not supposed to be present';"
NSQ_SOURCE_LINE 00000465 "         $self->_not_ok($desc);"
NSQ_SOURCE_LINE 00000466 "         $self->_diag('Test required that module not be usable')"
NSQ_SOURCE_LINE 00000467 "           unless ($$self{'quiet'} == 2);"
NSQ_SOURCE_LINE 00000468 "         $ok = 0;"
