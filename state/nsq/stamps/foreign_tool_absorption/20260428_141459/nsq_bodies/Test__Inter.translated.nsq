NSQ_SOURCE_LINE 00000567 "sub _ok_result {"
NSQ_SOURCE_LINE 00000568 "   my($self,@args) = @_;"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "   # Test if we're skipping this test"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "   my($skip,$reason) = $self->_skip_test();"
NSQ_SOURCE_LINE 00000573 "   return ('skip',$reason)  if ($skip);"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "   # No args == always pass"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "   if (@args == 0) {"
NSQ_SOURCE_LINE 00000578 "      return ('pass','Empty test');"
NSQ_SOURCE_LINE 00000579 "   }"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "   # Get the result"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "   my($func,$funcargs,$result) = $self->_get_result(\\@args);"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "   # Get name/expected"
NSQ_SOURCE_LINE 00000586 ""
NSQ_SOURCE_LINE 00000587 "   my($name,$expected);"
NSQ_SOURCE_LINE 00000588 "   if (@args == 1) {"
NSQ_SOURCE_LINE 00000589 "      $name = $args[0];"
NSQ_SOURCE_LINE 00000590 "   } elsif (@args == 2) {"
NSQ_SOURCE_LINE 00000591 "      ($expected,$name) = @args;"
NSQ_SOURCE_LINE 00000592 "   } elsif (@args > 2) {"
NSQ_SOURCE_LINE 00000593 "      return(0,'','Improperly formed test: too many arguments');"
NSQ_SOURCE_LINE 00000594 "   }"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "   # Check the result"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "   my($pass,@diag) = $self->_cmp_result('ok',$func,$funcargs,$result,$expected);"
NSQ_SOURCE_LINE 00000599 "   return($pass,$name,@diag);"
NSQ_SOURCE_LINE 00000600 "}"
NSQ_SOURCE_LINE 00000601 ""
