NSQ_SOURCE_LINE 00000514 "}"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "sub _eval {"
NSQ_SOURCE_LINE 00000517 "   my($self,$code) = @_;"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "   my( $sigdie, $eval_result, $eval_error );"
NSQ_SOURCE_LINE 00000520 "   {"
NSQ_SOURCE_LINE 00000521 "      local( $@, $!, $SIG{__DIE__} ); # isolate eval"
NSQ_SOURCE_LINE 00000522 "      $eval_result = eval $code;"
NSQ_SOURCE_LINE 00000523 "      $eval_error  = $@;"
NSQ_SOURCE_LINE 00000524 "      $sigdie      = $SIG{__DIE__} || undef;"
NSQ_SOURCE_LINE 00000525 "   }"
NSQ_SOURCE_LINE 00000526 "   # make sure that $code got a chance to set $SIG{__DIE__}"
NSQ_SOURCE_LINE 00000527 "   $SIG{__DIE__} = $sigdie if defined $sigdie;"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "   return( $eval_result, $eval_error );"
NSQ_SOURCE_LINE 00000530 "}"
