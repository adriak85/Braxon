NSQ_SOURCE_LINE 00000643 "sub _is_result {"
NSQ_SOURCE_LINE 00000644 "   my($self,$is,@args) = @_;"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "   # Test if we're skipping this test"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "   my($skip,$reason) = $self->_skip_test();"
NSQ_SOURCE_LINE 00000649 "   return ('skip',$reason)  if ($skip);"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "   # Test args"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "   if (@args < 2) {"
NSQ_SOURCE_LINE 00000654 "      return ('fail','','Improperly formed test: too few arguments');"
NSQ_SOURCE_LINE 00000655 "   }"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "   my($func,$funcargs,$result) = $self->_get_result(\\@args);"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "   my($name,$expected);"
NSQ_SOURCE_LINE 00000660 "   if (@args == 1) {"
NSQ_SOURCE_LINE 00000661 "      ($expected) = @args;"
NSQ_SOURCE_LINE 00000662 "   } elsif (@args == 2) {"
NSQ_SOURCE_LINE 00000663 "      ($expected,$name) = @args;"
NSQ_SOURCE_LINE 00000664 "   } else {"
NSQ_SOURCE_LINE 00000665 "      return(0,'','Improperly formed test: too many arguments');"
NSQ_SOURCE_LINE 00000666 "   }"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "   # Check the result"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "   my($pass,@diag) = $self->_cmp_result($is,$func,$funcargs,$result,$expected);"
NSQ_SOURCE_LINE 00000671 "   return($pass,$name,@diag);"
NSQ_SOURCE_LINE 00000672 "}"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "# Returns $func,$args and $results. The first two are returned only if"
NSQ_SOURCE_LINE 00000675 "# there is a function."
NSQ_SOURCE_LINE 00000676 "#"
NSQ_SOURCE_LINE 00000677 "sub _get_result {"
NSQ_SOURCE_LINE 00000678 "   my($self,$args) = @_;"
NSQ_SOURCE_LINE 00000679 "   my($func,@funcargs,@result,$result);"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "   if (ref($$args[0]) eq 'CODE') {"
NSQ_SOURCE_LINE 00000682 "      $func = shift(@$args);"
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "      if (ref($$args[0]) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000685 "         @funcargs = @{ $$args[0] };"
NSQ_SOURCE_LINE 00000686 "         shift(@$args);"
NSQ_SOURCE_LINE 00000687 "      }"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "      @result = &$func(@funcargs);"
NSQ_SOURCE_LINE 00000690 "      return ($func,\\@funcargs,\\@result);"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "   } elsif (ref($$args[0]) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000693 "      @result = @{ $$args[0] };"
NSQ_SOURCE_LINE 00000694 "      shift(@$args);"
NSQ_SOURCE_LINE 00000695 "      return ('','',\\@result);"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "   } else {"
NSQ_SOURCE_LINE 00000698 "      $result = shift(@$args);"
NSQ_SOURCE_LINE 00000699 "      return ('','',$result);"
NSQ_SOURCE_LINE 00000700 "   }"
NSQ_SOURCE_LINE 00000701 "}"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "sub _cmp_result {"
NSQ_SOURCE_LINE 00000704 "   my($self,$type,$func,$funcargs,$result,$expected) = @_;"
NSQ_SOURCE_LINE 00000705 "   my $pass      = 0;"
NSQ_SOURCE_LINE 00000706 "   my $identical = 0;"
NSQ_SOURCE_LINE 00000707 "   my @diag;"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "   if ($type eq 'ok') {"
NSQ_SOURCE_LINE 00000710 "      if (ref($result) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000711 "         foreach my $ele (@$result) {"
NSQ_SOURCE_LINE 00000712 "            $pass = 1  if (defined($ele));"
NSQ_SOURCE_LINE 00000713 "         }"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "      } elsif (ref($result) eq 'HASH') {"
NSQ_SOURCE_LINE 00000716 "         foreach my $key (keys %$result) {"
NSQ_SOURCE_LINE 00000717 "            my $val = $$result{$key};"
NSQ_SOURCE_LINE 00000718 "            $pass   = 1  if (defined($val));"
NSQ_SOURCE_LINE 00000719 "         }"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "      } else {"
NSQ_SOURCE_LINE 00000722 "         $pass = ($result ? 1 : 0);"
NSQ_SOURCE_LINE 00000723 "      }"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "      if (! defined($expected)) {"
NSQ_SOURCE_LINE 00000726 "         # If no expected result passed in, we don't test the results"
NSQ_SOURCE_LINE 00000727 "         $identical = 1;"
NSQ_SOURCE_LINE 00000728 "      } else {"
NSQ_SOURCE_LINE 00000729 "         # Results/expected must be the same structure"
NSQ_SOURCE_LINE 00000730 "         $identical = $self->_cmp_structure($result,$expected);"
NSQ_SOURCE_LINE 00000731 "      }"
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "   } else {"
NSQ_SOURCE_LINE 00000734 "      $identical = $self->_cmp_structure($result,$expected);"
NSQ_SOURCE_LINE 00000735 "      if ($type eq 'is') {"
NSQ_SOURCE_LINE 00000736 "         $pass = $identical;"
NSQ_SOURCE_LINE 00000737 "      } else {"
NSQ_SOURCE_LINE 00000738 "         $pass = 1 - $identical;"
NSQ_SOURCE_LINE 00000739 "      }"
NSQ_SOURCE_LINE 00000740 "   }"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "   if (! $identical  &&  $type ne 'isnt') {"
NSQ_SOURCE_LINE 00000743 "      if ($func) {"
NSQ_SOURCE_LINE 00000744 "         push(@diag,\"Arguments: \" . $self->_stringify($funcargs));"
NSQ_SOURCE_LINE 00000745 "      }"
NSQ_SOURCE_LINE 00000746 "      push(@diag,   \"Results  : \" . $self->_stringify($result));"
NSQ_SOURCE_LINE 00000747 "      push(@diag,   \"Expected : \" . $self->_stringify($expected))  unless ($type eq 'ok'  &&"
NSQ_SOURCE_LINE 00000748 "                                                                           ! defined($result));"
NSQ_SOURCE_LINE 00000749 "   }"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "   return (($pass ? 'pass' : 'fail'),@diag);"
NSQ_SOURCE_LINE 00000752 "}"
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "# Turn a data structure into a string (poor-man's Data::Dumper)"
NSQ_SOURCE_LINE 00000755 "sub _stringify {"
NSQ_SOURCE_LINE 00000756 "   my($self,$s) = @_;"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "   my($str)   = $self->__stringify($s);"
NSQ_SOURCE_LINE 00000759 "   my($width) = $$self{'width'};"
NSQ_SOURCE_LINE 00000760 "   if ($width) {"
NSQ_SOURCE_LINE 00000761 "      $width -= 21;    # The leading string"
NSQ_SOURCE_LINE 00000762 "      $width  = 10  if ($width < 10);"
NSQ_SOURCE_LINE 00000763 "      $str = substr($str,0,$width)  if (length($str)>$width);"
NSQ_SOURCE_LINE 00000764 "   }"
NSQ_SOURCE_LINE 00000765 "   return $str;"
NSQ_SOURCE_LINE 00000766 "}"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "sub __stringify {"
NSQ_SOURCE_LINE 00000769 "   my($self,$s) = @_;"
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "   if (! defined($s)) {"
NSQ_SOURCE_LINE 00000772 "      return '__undef__';"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "   } elsif (ref($s) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000775 "      my $str = '[ ';"
NSQ_SOURCE_LINE 00000776 "      foreach my $val (@$s) {"
NSQ_SOURCE_LINE 00000777 "         $str .= $self->__stringify($val) . ' ';"
NSQ_SOURCE_LINE 00000778 "      }"
NSQ_SOURCE_LINE 00000779 "      $str .= ']';"
NSQ_SOURCE_LINE 00000780 "      return $str;"
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "   } elsif (ref($s) eq 'HASH') {"
NSQ_SOURCE_LINE 00000783 "      my $str = '{ ';"
NSQ_SOURCE_LINE 00000784 "      foreach my $key (sort keys %$s) {"
NSQ_SOURCE_LINE 00000785 "         my $key = $self->__stringify($key);"
NSQ_SOURCE_LINE 00000786 "         my $val = $self->__stringify($$s{$key});"
NSQ_SOURCE_LINE 00000787 "         $str .= \"$key=>$val \";"
NSQ_SOURCE_LINE 00000788 "      }"
NSQ_SOURCE_LINE 00000789 "      $str .= '}';"
NSQ_SOURCE_LINE 00000790 "      return $str;"
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "   } elsif (ref($s)) {"
NSQ_SOURCE_LINE 00000793 "      return '<' . ref($s) . '>';"
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "   } elsif ($s eq '') {"
NSQ_SOURCE_LINE 00000796 "      return \"''\";"
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 "   } else {"
NSQ_SOURCE_LINE 00000799 "      if ($s =~ /\\s/) {"
NSQ_SOURCE_LINE 00000800 "         my $q       = qr/\\'/;  # single quote"
NSQ_SOURCE_LINE 00000801 "         my $qq      = qr/\\\"/;  # double quote"
NSQ_SOURCE_LINE 00000802 "         if ($s !~ $q) {"
NSQ_SOURCE_LINE 00000803 "            return \"'$s'\";"
NSQ_SOURCE_LINE 00000804 "         }"
NSQ_SOURCE_LINE 00000805 "         if ($s !~ $qq) {"
NSQ_SOURCE_LINE 00000806 "            return '\"' . $s . '\"';"
NSQ_SOURCE_LINE 00000807 "         }"
NSQ_SOURCE_LINE 00000808 "         return \"<$s>\";"
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "      } else {"
NSQ_SOURCE_LINE 00000811 "         return $s;"
NSQ_SOURCE_LINE 00000812 "      }"
NSQ_SOURCE_LINE 00000813 "   }"
NSQ_SOURCE_LINE 00000814 "}"
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 "sub _cmp_structure {"
NSQ_SOURCE_LINE 00000817 "   my($self,$s1,$s2) = @_;"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "   return 1  if (! defined($s1)  &&  ! defined($s2)); # undef =  undef"
NSQ_SOURCE_LINE 00000820 "   return 0  if (! defined($s1)  ||  ! defined($s2)); # undef != def"
NSQ_SOURCE_LINE 00000821 "   return 0  if (ref($s1) ne ref($s2)); # must be same type"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "   if (ref($s1) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000824 "      return 0  if ($#$s1 != $#$s2); # two lists must be the same length"
NSQ_SOURCE_LINE 00000825 "      foreach (my $i=0; $i<=$#$s1; $i++) {"
NSQ_SOURCE_LINE 00000826 "         return 0  unless $self->_cmp_structure($$s1[$i],$$s2[$i]);"
NSQ_SOURCE_LINE 00000827 "      }"
NSQ_SOURCE_LINE 00000828 "      return 1;"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "   } elsif (ref($s1) eq 'HASH') {"
NSQ_SOURCE_LINE 00000831 "      my @k1 = keys %$s1;"
NSQ_SOURCE_LINE 00000832 "      my @k2 = keys %$s2;"
NSQ_SOURCE_LINE 00000833 "      return 0  if ($#k1 != $#k2); # two hashes must be the same length"
NSQ_SOURCE_LINE 00000834 "      foreach my $key (@k1) {"
NSQ_SOURCE_LINE 00000835 "         return 0  if (! exists $$s2{$key}); # keys must be the same"
NSQ_SOURCE_LINE 00000836 "         return 0  unless $self->_cmp_structure($$s1{$key},$$s2{$key});"
NSQ_SOURCE_LINE 00000837 "      }"
NSQ_SOURCE_LINE 00000838 "      return 1;"
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "   } elsif (ref($s1)) {"
NSQ_SOURCE_LINE 00000841 "      # Two references (other than ARRAY and HASH are assumed equal."
NSQ_SOURCE_LINE 00000842 "      return 1;"
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "   } else {"
NSQ_SOURCE_LINE 00000845 "      # Two scalars are compared stringwise"
NSQ_SOURCE_LINE 00000846 "      return ($s1 eq $s2);"
NSQ_SOURCE_LINE 00000847 "   }"
NSQ_SOURCE_LINE 00000848 "}"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "sub _skip_test {"
NSQ_SOURCE_LINE 00000851 "   my($self) = @_;"
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "   if ($$self{'skipall'}) {"
NSQ_SOURCE_LINE 00000854 "      return (1,$$self{'skipall'});"
NSQ_SOURCE_LINE 00000855 "   } elsif ( $main::TI_NUM < $$self{'start'}  ||"
NSQ_SOURCE_LINE 00000856 "             ($$self{'end'}  &&  $main::TI_NUM > $$self{'end'}) ) {"
NSQ_SOURCE_LINE 00000857 "      return (1,'Test not in list of tests specified to run');"
NSQ_SOURCE_LINE 00000858 "   }"
NSQ_SOURCE_LINE 00000859 "   return 0;"
NSQ_SOURCE_LINE 00000860 "}"
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "###############################################################################"
NSQ_SOURCE_LINE 00000863 "# FILE METHOD"
NSQ_SOURCE_LINE 00000864 "###############################################################################"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "sub file {"
NSQ_SOURCE_LINE 00000867 "   my($self,$func,$input,$outputdir,$expected,$name,@args) = @_;"
NSQ_SOURCE_LINE 00000868 "   $name = \"\"  if (! $name);"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "   if (! (ref($func) eq 'CODE')) {"
NSQ_SOURCE_LINE 00000871 "      $self->_die(\"file method required a coderef\");"
NSQ_SOURCE_LINE 00000872 "   }"
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "   my @funcargs;"
NSQ_SOURCE_LINE 00000875 "   my $testdir = $$self{'testdir'};"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "   # Input file"
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 "   if ($input) {"
NSQ_SOURCE_LINE 00000880 "      if (-r $input) {"
NSQ_SOURCE_LINE 00000881 "         # Nothing"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "      } elsif (-r \"$testdir/$input\") {"
NSQ_SOURCE_LINE 00000884 "         $input = \"$testdir/$input\";"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "      } else {"
NSQ_SOURCE_LINE 00000887 "         $self->_die(\"Input file not readable: $input\");"
NSQ_SOURCE_LINE 00000888 "      }"
NSQ_SOURCE_LINE 00000889 "      push(@funcargs,$input);"
NSQ_SOURCE_LINE 00000890 "   }"
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "   # Output file and directory"
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "   if (! $outputdir) {"
NSQ_SOURCE_LINE 00000895 "      if (-d $testdir  &&"
NSQ_SOURCE_LINE 00000896 "          -w $testdir) {"
NSQ_SOURCE_LINE 00000897 "         $outputdir = $testdir;"
NSQ_SOURCE_LINE 00000898 "      } else {"
NSQ_SOURCE_LINE 00000899 "         $outputdir = \".\";"
NSQ_SOURCE_LINE 00000900 "      }"
NSQ_SOURCE_LINE 00000901 "   }"
NSQ_SOURCE_LINE 00000902 "   if ($outputdir) {"
NSQ_SOURCE_LINE 00000903 "      if (! -d $outputdir  ||"
NSQ_SOURCE_LINE 00000904 "          ! -w $outputdir) {"
NSQ_SOURCE_LINE 00000905 "         $self->_die(\"Output directory not writable: $outputdir\");"
NSQ_SOURCE_LINE 00000906 "      }"
NSQ_SOURCE_LINE 00000907 "   }"
NSQ_SOURCE_LINE 00000908 "   my $output = \"$outputdir/tmp_test_inter\";"
NSQ_SOURCE_LINE 00000909 "   push(@funcargs,$output);"
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "   # Expected output"
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "   if (! $expected) {"
NSQ_SOURCE_LINE 00000914 "      $self->_die(\"Expected output file not specified\");"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "   } elsif (-r $expected) {"
NSQ_SOURCE_LINE 00000917 "      # Nothing"
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "   } elsif (-r \"$testdir/$expected\") {"
NSQ_SOURCE_LINE 00000920 "      $expected = \"$testdir/$expected\";"
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "   } else {"
NSQ_SOURCE_LINE 00000923 "      $self->_die(\"Expected output file not readable: $expected\");"
NSQ_SOURCE_LINE 00000924 "   }"
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "   # Create the temporary output file."
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "   &$func(@funcargs,@args);"
NSQ_SOURCE_LINE 00000929 "   if (! -r \"$output\") {"
NSQ_SOURCE_LINE 00000930 "      $self->_die(\"Output file not created\");"
NSQ_SOURCE_LINE 00000931 "   }"
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "   # Test each line"
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "   my $in = new IO::File;"
NSQ_SOURCE_LINE 00000936 "   $in->open($output);"
NSQ_SOURCE_LINE 00000937 "   my @out = <$in>;"
NSQ_SOURCE_LINE 00000938 "   $in->close();"
NSQ_SOURCE_LINE 00000939 "   chomp(@out);"
NSQ_SOURCE_LINE 00000940 ""
NSQ_SOURCE_LINE 00000941 "   $in->open($expected);"
NSQ_SOURCE_LINE 00000942 "   my @exp = <$in>;"
NSQ_SOURCE_LINE 00000943 "   $in->close();"
NSQ_SOURCE_LINE 00000944 "   chomp(@exp);"
NSQ_SOURCE_LINE 00000945 "   unlink($output)   if (! $ENV{'TI_NOCLEAN'});"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "   while (@out < @exp) {"
NSQ_SOURCE_LINE 00000948 "      push(@out,'');"
NSQ_SOURCE_LINE 00000949 "   }"
NSQ_SOURCE_LINE 00000950 "   while (@exp < @out) {"
NSQ_SOURCE_LINE 00000951 "      push(@exp,'');"
NSQ_SOURCE_LINE 00000952 "   }"
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "   for (my $i=0; $i<@out; $i++) {"
NSQ_SOURCE_LINE 00000955 "      my $line = $i+1;"
NSQ_SOURCE_LINE 00000956 "      my $n    = ($name ? \"$name : Line $line\" : \"Line $line\");"
NSQ_SOURCE_LINE 00000957 "      $self->_is('is',$out[$i],$exp[$i],$n);"
NSQ_SOURCE_LINE 00000958 "   }"
NSQ_SOURCE_LINE 00000959 "}"
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "###############################################################################"
NSQ_SOURCE_LINE 00000962 "# TESTS METHOD"
NSQ_SOURCE_LINE 00000963 "###############################################################################"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "sub tests {"
NSQ_SOURCE_LINE 00000966 "   my($self,%opts) = @_;"
NSQ_SOURCE_LINE 00000967 ""
NSQ_SOURCE_LINE 00000968 "   #"
NSQ_SOURCE_LINE 00000969 "   # feature => [ FEATURE, FEATURE, ... ]"
NSQ_SOURCE_LINE 00000970 "   # disable => [ FEATURE, FEATURE, ... ]"
NSQ_SOURCE_LINE 00000971 "   #"
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "   my $skip = '';"
NSQ_SOURCE_LINE 00000974 "   if (exists $opts{'feature'}) {"
NSQ_SOURCE_LINE 00000975 "      foreach my $feature (@{ $opts{'feature'} }) {"
NSQ_SOURCE_LINE 00000976 "         $skip = \"Required feature unavailable: $feature\", last"
NSQ_SOURCE_LINE 00000977 "           if (! exists $$self{'features'}{$feature}  ||"
NSQ_SOURCE_LINE 00000978 "               ! $$self{'features'}{$feature});"
NSQ_SOURCE_LINE 00000979 "      }"
NSQ_SOURCE_LINE 00000980 "   }"
NSQ_SOURCE_LINE 00000981 "   if (exists $opts{'disable'}  &&  ! $skip) {"
NSQ_SOURCE_LINE 00000982 "      foreach my $feature (@{ $opts{'disable'} }) {"
NSQ_SOURCE_LINE 00000983 "         $skip = \"Disabled due to feature being available: $feature\", last"
NSQ_SOURCE_LINE 00000984 "           if (exists $$self{'features'}{$feature}  &&"
NSQ_SOURCE_LINE 00000985 "               $$self{'features'}{$feature});"
NSQ_SOURCE_LINE 00000986 "      }"
NSQ_SOURCE_LINE 00000987 "   }"
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "   #"
NSQ_SOURCE_LINE 00000990 "   # name => NAME"
NSQ_SOURCE_LINE 00000991 "   # skip => REASON"
NSQ_SOURCE_LINE 00000992 "   # todo => 0/1"
NSQ_SOURCE_LINE 00000993 "   #"
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "   my $name = '';"
NSQ_SOURCE_LINE 00000996 "   if (exists $opts{'name'}) {"
NSQ_SOURCE_LINE 00000997 "      $name = $opts{'name'};"
NSQ_SOURCE_LINE 00000998 "   }"
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "   if (exists $opts{'skip'}) {"
NSQ_SOURCE_LINE 00001001 "      $skip = $opts{'skip'};"
NSQ_SOURCE_LINE 00001002 "   }"
NSQ_SOURCE_LINE 00001003 ""
NSQ_SOURCE_LINE 00001004 "   my $todo = 0;"
NSQ_SOURCE_LINE 00001005 "   if (exists $opts{'todo'}) {"
NSQ_SOURCE_LINE 00001006 "      $todo = $opts{'todo'};"
NSQ_SOURCE_LINE 00001007 "   }"
NSQ_SOURCE_LINE 00001008 ""
NSQ_SOURCE_LINE 00001009 "   #"
NSQ_SOURCE_LINE 00001010 "   # tests    => STRING OR LISTREF"
NSQ_SOURCE_LINE 00001011 "   # func     => CODEREF"
NSQ_SOURCE_LINE 00001012 "   # expected => STRING OR LISTREF"
NSQ_SOURCE_LINE 00001013 "   #"
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "   # tests"
NSQ_SOURCE_LINE 00001016 "   if (! exists $opts{'tests'}) {"
NSQ_SOURCE_LINE 00001017 "      $self->_die(\"invalid test format: tests required\");"
NSQ_SOURCE_LINE 00001018 "   }"
NSQ_SOURCE_LINE 00001019 "   my $tests = $opts{'tests'};"
NSQ_SOURCE_LINE 00001020 "   my(%tests,$gotexpected);"
NSQ_SOURCE_LINE 00001021 ""
NSQ_SOURCE_LINE 00001022 "   my($ntest,$nexp);"
NSQ_SOURCE_LINE 00001023 "   if (ref($tests) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00001024 "      my @results = @$tests;"
NSQ_SOURCE_LINE 00001025 "      $ntest      = 0;"
NSQ_SOURCE_LINE 00001026 "      foreach my $result (@results) {"
NSQ_SOURCE_LINE 00001027 "         $ntest++;"
NSQ_SOURCE_LINE 00001028 "         $tests{$ntest}{'err'} = 0;"
NSQ_SOURCE_LINE 00001029 "         if (ref($result) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00001030 "            $tests{$ntest}{'args'} = $result;"
NSQ_SOURCE_LINE 00001031 "         } else {"
NSQ_SOURCE_LINE 00001032 "            $tests{$ntest}{'args'} = [$result];"
NSQ_SOURCE_LINE 00001033 "         }"
NSQ_SOURCE_LINE 00001034 "      }"
NSQ_SOURCE_LINE 00001035 "      $gotexpected = 0;"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "   } else {"
NSQ_SOURCE_LINE 00001038 "      ($ntest,$gotexpected,%tests) = $self->_parse($tests);"
NSQ_SOURCE_LINE 00001039 "      $nexp = $ntest  if ($gotexpected);"
NSQ_SOURCE_LINE 00001040 "   }"
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "   # expected"
NSQ_SOURCE_LINE 00001043 "   if (exists $opts{'expected'}) {"
NSQ_SOURCE_LINE 00001044 "      if ($gotexpected) {"
NSQ_SOURCE_LINE 00001045 "         $self->_die(\"invalid test format: expected results included twice\");"
NSQ_SOURCE_LINE 00001046 "      }"
NSQ_SOURCE_LINE 00001047 "      my $expected = $opts{'expected'};"
NSQ_SOURCE_LINE 00001048 ""
NSQ_SOURCE_LINE 00001049 "      if (ref($expected) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00001050 "         my @exp = @$expected;"
NSQ_SOURCE_LINE 00001051 "         $nexp   = 0;"
NSQ_SOURCE_LINE 00001052 "         foreach my $exp (@exp) {"
NSQ_SOURCE_LINE 00001053 "            $nexp++;"
NSQ_SOURCE_LINE 00001054 "            if (ref($exp) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00001055 "               $tests{$nexp}{'expected'} = $exp;"
NSQ_SOURCE_LINE 00001056 "            } else {"
NSQ_SOURCE_LINE 00001057 "               $tests{$nexp}{'expected'} = [$exp];"
NSQ_SOURCE_LINE 00001058 "            }"
NSQ_SOURCE_LINE 00001059 "         }"
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "      } else {"
NSQ_SOURCE_LINE 00001062 "         my($g,%t);"
NSQ_SOURCE_LINE 00001063 "         ($nexp,$g,%t) = $self->_parse($expected);"
NSQ_SOURCE_LINE 00001064 "         if ($g) {"
NSQ_SOURCE_LINE 00001065 "            $self->_die(\"invalid test format: expected results contain '=>'\");"
NSQ_SOURCE_LINE 00001066 "         }"
NSQ_SOURCE_LINE 00001067 "         foreach my $t (1..$nexp) {"
NSQ_SOURCE_LINE 00001068 "            $tests{$t}{'expected'} = $t{$t}{'args'};"
NSQ_SOURCE_LINE 00001069 "         }"
NSQ_SOURCE_LINE 00001070 "      }"
NSQ_SOURCE_LINE 00001071 "      $gotexpected = 1;"
NSQ_SOURCE_LINE 00001072 "   }"
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 "   if ($gotexpected  &&"
NSQ_SOURCE_LINE 00001075 "       ($nexp != 1  &&  $nexp != $ntest)) {"
NSQ_SOURCE_LINE 00001076 "      $self->_die(\"invalid test format: number expected results differs from number of tests\");"
NSQ_SOURCE_LINE 00001077 "   }"
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "   # func"
NSQ_SOURCE_LINE 00001080 "   my $func;"
NSQ_SOURCE_LINE 00001081 "   if (exists $opts{'func'}) {"
NSQ_SOURCE_LINE 00001082 "      $func = $opts{'func'};"
NSQ_SOURCE_LINE 00001083 "      if (ref($func) ne 'CODE') {"
NSQ_SOURCE_LINE 00001084 "         $self->_die(\"invalid test format: func must be a code reference\");"
NSQ_SOURCE_LINE 00001085 "      }"
NSQ_SOURCE_LINE 00001086 "   }"
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "   #"
NSQ_SOURCE_LINE 00001089 "   # Compare results"
NSQ_SOURCE_LINE 00001090 "   #"
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "   foreach my $t (1..$ntest) {"
NSQ_SOURCE_LINE 00001093 "      $main::TI_NUM++;"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "      if ($skip) {"
NSQ_SOURCE_LINE 00001096 "         $self->_skip($skip,$name);"
NSQ_SOURCE_LINE 00001097 "         next;"
NSQ_SOURCE_LINE 00001098 "      }"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "      if ($tests{$t}{'err'}) {"
NSQ_SOURCE_LINE 00001101 "         $self->_not_ok($name);"
NSQ_SOURCE_LINE 00001102 "         $self->diag($tests{$t}{'err'});"
NSQ_SOURCE_LINE 00001103 "         next;"
NSQ_SOURCE_LINE 00001104 "      }"
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 "      my($op,@ret);"
NSQ_SOURCE_LINE 00001107 ""
NSQ_SOURCE_LINE 00001108 "      # Test results"
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "      if ($gotexpected) {"
NSQ_SOURCE_LINE 00001111 "         # Do an 'is' test"
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "         my @a = ('is');"
NSQ_SOURCE_LINE 00001114 "         push(@a,$func)  if ($func);"
NSQ_SOURCE_LINE 00001115 "         push(@a,$tests{$t}{'args'});"
NSQ_SOURCE_LINE 00001116 "         push(@a,($nexp == 1 ? $tests{'1'}{'expected'}"
NSQ_SOURCE_LINE 00001117 "                             : $tests{$t}{'expected'}));"
NSQ_SOURCE_LINE 00001118 "         push(@a,$name);"
NSQ_SOURCE_LINE 00001119 ""
NSQ_SOURCE_LINE 00001120 "         ($op,@ret) = $self->_is_result(@a);"
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "      } else {"
NSQ_SOURCE_LINE 00001123 "         # Do an 'ok' test"
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "         my $result = $tests{$t}{'args'};"
NSQ_SOURCE_LINE 00001126 "         if (@$result == 1) {"
NSQ_SOURCE_LINE 00001127 "            $result = $$result[0];"
NSQ_SOURCE_LINE 00001128 "         }"
NSQ_SOURCE_LINE 00001129 "         ($op,@ret) = $self->_ok_result($result,$name);"
NSQ_SOURCE_LINE 00001130 "      }"
NSQ_SOURCE_LINE 00001131 ""
NSQ_SOURCE_LINE 00001132 "      # Print it out"
NSQ_SOURCE_LINE 00001133 ""
NSQ_SOURCE_LINE 00001134 "      my($name,@diag);"
NSQ_SOURCE_LINE 00001135 "      my $ok = 1;"
NSQ_SOURCE_LINE 00001136 ""
NSQ_SOURCE_LINE 00001137 "      if ($op eq 'skip') {"
NSQ_SOURCE_LINE 00001138 "         my $reason = shift(@ret);"
NSQ_SOURCE_LINE 00001139 "         $self->_skip($reason);"
NSQ_SOURCE_LINE 00001140 ""
NSQ_SOURCE_LINE 00001141 "      } elsif ($op eq 'pass') {"
NSQ_SOURCE_LINE 00001142 "         ($name,@diag) = @ret;"
NSQ_SOURCE_LINE 00001143 "         $self->_ok($name);"
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "      } else {"
NSQ_SOURCE_LINE 00001146 "         ($name,@diag) = @ret;"
NSQ_SOURCE_LINE 00001147 "         $self->_not_ok($name);"
NSQ_SOURCE_LINE 00001148 "         $ok = 0;"
NSQ_SOURCE_LINE 00001149 "      }"
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "      next"
NSQ_SOURCE_LINE 00001152 "        if ( ($ok    &&  $$self{'quiet'})  ||"
NSQ_SOURCE_LINE 00001153 "             (! $ok  &&  $$self{'quiet'} == 2) );"
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "      foreach my $diag (@diag) {"
NSQ_SOURCE_LINE 00001156 "         $self->_diag($diag);"
NSQ_SOURCE_LINE 00001157 "      }"
NSQ_SOURCE_LINE 00001158 "   }"
NSQ_SOURCE_LINE 00001159 "}"
NSQ_SOURCE_LINE 00001160 ""
NSQ_SOURCE_LINE 00001161 "###############################################################################"
NSQ_SOURCE_LINE 00001162 "# TAP METHODS"
NSQ_SOURCE_LINE 00001163 "###############################################################################"
NSQ_SOURCE_LINE 00001164 ""
NSQ_SOURCE_LINE 00001165 "sub _diag {"
NSQ_SOURCE_LINE 00001166 "   my($self,$message) = @_;"
NSQ_SOURCE_LINE 00001167 "   print '#' . ' 'x10 . \"$message\\n\";"
NSQ_SOURCE_LINE 00001168 "}"
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 "sub _plan {"
NSQ_SOURCE_LINE 00001171 "   my($self,$n,$reason) = @_;"
NSQ_SOURCE_LINE 00001172 "   $reason = ''  if (! $reason);"
NSQ_SOURCE_LINE 00001173 ""
NSQ_SOURCE_LINE 00001174 "   if ($$self{'mode'} eq 'test') {"
NSQ_SOURCE_LINE 00001175 ""
NSQ_SOURCE_LINE 00001176 "      # Test mode"
NSQ_SOURCE_LINE 00001177 ""
NSQ_SOURCE_LINE 00001178 "      if (! $n) {"
NSQ_SOURCE_LINE 00001179 "         $reason = ''  if (! $reason);"
NSQ_SOURCE_LINE 00001180 "         print \"1..0 # Skipped $reason\\n\";"
NSQ_SOURCE_LINE 00001181 "         return;"
NSQ_SOURCE_LINE 00001182 "      }"
NSQ_SOURCE_LINE 00001183 ""
NSQ_SOURCE_LINE 00001184 "      print \"1..$n\\n\";"
NSQ_SOURCE_LINE 00001185 ""
NSQ_SOURCE_LINE 00001186 "   } else {"
NSQ_SOURCE_LINE 00001187 ""
NSQ_SOURCE_LINE 00001188 "      if (! $n) {"
NSQ_SOURCE_LINE 00001189 "         print \"  All tests skipped: $reason\\n\";"
NSQ_SOURCE_LINE 00001190 "      } else {"
NSQ_SOURCE_LINE 00001191 "         print \"  Epected number of tests: $n\\n\""
NSQ_SOURCE_LINE 00001192 "           unless ($$self{'quiet'});"
NSQ_SOURCE_LINE 00001193 "      }"
NSQ_SOURCE_LINE 00001194 "   }"
NSQ_SOURCE_LINE 00001195 "}"
NSQ_SOURCE_LINE 00001196 ""
NSQ_SOURCE_LINE 00001197 "sub _ok {"
NSQ_SOURCE_LINE 00001198 "   my($self,$name) = @_;"
NSQ_SOURCE_LINE 00001199 ""
NSQ_SOURCE_LINE 00001200 "   $name = ''  if (! $name);"
NSQ_SOURCE_LINE 00001201 "   $name =~ s/\\#//;"
NSQ_SOURCE_LINE 00001202 ""
NSQ_SOURCE_LINE 00001203 "   $$self{'testsrun'} = 1;"
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "   return  if ($$self{'mode'} ne 'test'  &&"
NSQ_SOURCE_LINE 00001206 "               $$self{'quiet'});"
NSQ_SOURCE_LINE 00001207 ""
NSQ_SOURCE_LINE 00001208 "   print \"ok $main::TI_NUM\" . ' 'x(8-length($main::TI_NUM)) . \"$name\\n\";"
NSQ_SOURCE_LINE 00001209 ""
NSQ_SOURCE_LINE 00001210 "   if ($name =~ /^\\d/  &&  $$self{'quiet'} != 2) {"
NSQ_SOURCE_LINE 00001211 "      $self->_diag('It is strongly recommended that the name of a test not');"
NSQ_SOURCE_LINE 00001212 "      $self->_diag('begin with a digit so it will not be confused with the');"
NSQ_SOURCE_LINE 00001213 "      $self->_diag('test number.');"
NSQ_SOURCE_LINE 00001214 "   }"
NSQ_SOURCE_LINE 00001215 "}"
NSQ_SOURCE_LINE 00001216 ""
NSQ_SOURCE_LINE 00001217 "sub _not_ok {"
NSQ_SOURCE_LINE 00001218 "   my($self,$name) = @_;"
NSQ_SOURCE_LINE 00001219 "   $name = ''  if (! $name);"
NSQ_SOURCE_LINE 00001220 "   $name =~ s/\\#//;"
NSQ_SOURCE_LINE 00001221 ""
NSQ_SOURCE_LINE 00001222 "   $$self{'testsrun'} = 1;"
NSQ_SOURCE_LINE 00001223 ""
NSQ_SOURCE_LINE 00001224 "   print \"not ok $main::TI_NUM\" . ' 'x(4-length($main::TI_NUM)) . \"$name\\n\";"
NSQ_SOURCE_LINE 00001225 ""
NSQ_SOURCE_LINE 00001226 "   if ($$self{'abort'} == 2) {"
NSQ_SOURCE_LINE 00001227 "      exit 1;"
NSQ_SOURCE_LINE 00001228 "   } elsif ($$self{'abort'}) {"
NSQ_SOURCE_LINE 00001229 "      $$self{'skipall'} = 'Tests aborted due to failed test';"
NSQ_SOURCE_LINE 00001230 "   }"
NSQ_SOURCE_LINE 00001231 "}"
NSQ_SOURCE_LINE 00001232 ""
NSQ_SOURCE_LINE 00001233 "sub _skip {"
NSQ_SOURCE_LINE 00001234 "   my($self,$reason,$name) = @_;"
NSQ_SOURCE_LINE 00001235 "   $name = ''  if (! $name);"
NSQ_SOURCE_LINE 00001236 "   $name =~ s/\\#//;"
NSQ_SOURCE_LINE 00001237 ""
NSQ_SOURCE_LINE 00001238 "   $$self{'testsrun'} = 1;"
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "   return  if ($$self{'mode'} ne 'test'  &&"
NSQ_SOURCE_LINE 00001241 "               $$self{'quiet'});"
NSQ_SOURCE_LINE 00001242 ""
NSQ_SOURCE_LINE 00001243 "   print \"ok $main::TI_NUM\" . ' 'x(8-length($main::TI_NUM)) ."
NSQ_SOURCE_LINE 00001244 "     ($name ? \"$name \" : \"\") . \"# SKIPPED $reason\\n\";"
NSQ_SOURCE_LINE 00001245 "}"
NSQ_SOURCE_LINE 00001246 ""
NSQ_SOURCE_LINE 00001247 "###############################################################################"
NSQ_SOURCE_LINE 00001248 "# TEST PARSING METHODS"
NSQ_SOURCE_LINE 00001249 "###############################################################################"
NSQ_SOURCE_LINE 00001250 ""
NSQ_SOURCE_LINE 00001251 "{"
NSQ_SOURCE_LINE 00001252 "   my $l;                         # current line number"
NSQ_SOURCE_LINE 00001253 "   my $sp_opt  = qr/\\s*/;         # optional whitespace"
NSQ_SOURCE_LINE 00001254 "   my $sp      = qr/\\s+/;         # required whitespace"
NSQ_SOURCE_LINE 00001255 "   my $lparen  = qr/\\(/;          # opening paren"
NSQ_SOURCE_LINE 00001256 "   my $lbrack  = qr/\\[/;          # opening brack"
NSQ_SOURCE_LINE 00001257 "   my $lbrace  = qr/\\{/;          # opening brace"
NSQ_SOURCE_LINE 00001258 "   my $q       = qr/\\'/;          # single quote"
NSQ_SOURCE_LINE 00001259 "   my $qq      = qr/\\\"/;          # double quote"
NSQ_SOURCE_LINE 00001260 "   my $token   = qr/\\S+/;         # a token of non-whitespace characters"
NSQ_SOURCE_LINE 00001261 "   my $min_str = qr/.*?/;         # a minimum length string"
NSQ_SOURCE_LINE 00001262 "   my $results = qr/=>/;          # the string to switch to results"
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "   # We'll also need to match delimiters and other special characters that"
NSQ_SOURCE_LINE 00001265 "   # signal the end of a token. The default delimiter is just whitespace,"
NSQ_SOURCE_LINE 00001266 "   # both other end-of-token regular expressions will include closing"
NSQ_SOURCE_LINE 00001267 "   # parens, delimiters, etc."
NSQ_SOURCE_LINE 00001268 "   #"
NSQ_SOURCE_LINE 00001269 "   # The end-of-token regexp will return a match for a special character (if"
NSQ_SOURCE_LINE 00001270 "   # any) that terminates the token. If a token ends a whitespace or EOL,"
NSQ_SOURCE_LINE 00001271 "   # nothing is matched."
NSQ_SOURCE_LINE 00001272 "   #"
NSQ_SOURCE_LINE 00001273 "   my $eot     = qr/()(?:\\s+|$)/;"
NSQ_SOURCE_LINE 00001274 ""
NSQ_SOURCE_LINE 00001275 "   # Allowed delimiters is anything except () [] {} alphanumeric,"
NSQ_SOURCE_LINE 00001276 "   # underscore, and whitespace."
NSQ_SOURCE_LINE 00001277 "   #"
NSQ_SOURCE_LINE 00001278 "   my $delim   = qr/[^\\'\\\"\\(\\)\\[\\]\\{\\}a-zA-Z0-9_ \\t]/;"
NSQ_SOURCE_LINE 00001279 ""
NSQ_SOURCE_LINE 00001280 "   # This takes a string which may contain a partial or complete"
NSQ_SOURCE_LINE 00001281 "   # descritpion of any number of tests, and parses it."
NSQ_SOURCE_LINE 00001282 "   #"
NSQ_SOURCE_LINE 00001283 "   # The string is multiline, and tests must be separated from each other"
NSQ_SOURCE_LINE 00001284 "   # by one or more blank lines.  Lines starting with a pound sign (#)"
NSQ_SOURCE_LINE 00001285 "   # are comments."
NSQ_SOURCE_LINE 00001286 "   #"
NSQ_SOURCE_LINE 00001287 "   # A test may include arguments (or obtained results), expected results,"
NSQ_SOURCE_LINE 00001288 "   # or both."
NSQ_SOURCE_LINE 00001289 "   #"
NSQ_SOURCE_LINE 00001290 "   # Returns"
NSQ_SOURCE_LINE 00001291 "   #    ($n,$gotboth,%tests)"
NSQ_SOURCE_LINE 00001292 "   # where"
NSQ_SOURCE_LINE 00001293 "   #    $n is the number of tests"
NSQ_SOURCE_LINE 00001294 "   #    $gotboth is 1 if both arguments and expected results are obtained"
NSQ_SOURCE_LINE 00001295 "   #    $tests{$i} is the i'th test."
NSQ_SOURCE_LINE 00001296 "   #"
NSQ_SOURCE_LINE 00001297 "   sub _parse {"
NSQ_SOURCE_LINE 00001298 "      my($self,$string) = @_;"
NSQ_SOURCE_LINE 00001299 "      my $t       = 0;"
NSQ_SOURCE_LINE 00001300 "      my $gotboth = -1;"
NSQ_SOURCE_LINE 00001301 "      my %tests   = ();"
NSQ_SOURCE_LINE 00001302 ""
NSQ_SOURCE_LINE 00001303 "      # Split on newlines"
NSQ_SOURCE_LINE 00001304 "      $string = [ split(/\\n/s,$string) ];"
NSQ_SOURCE_LINE 00001305 ""
NSQ_SOURCE_LINE 00001306 "      $t      = 0;"
NSQ_SOURCE_LINE 00001307 "      while (@$string) {"
NSQ_SOURCE_LINE 00001308 "         my $test = $self->_next_test($string);"
NSQ_SOURCE_LINE 00001309 "         last  if (! @$test);"
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 "         # All tests must contain both args/results OR only one of them."
NSQ_SOURCE_LINE 00001312 "         my ($err,$both,$args,$results) = $self->_parse_test($test);"
NSQ_SOURCE_LINE 00001313 "         if ($gotboth == -1) {"
NSQ_SOURCE_LINE 00001314 "            $gotboth = $both;"
NSQ_SOURCE_LINE 00001315 "         } elsif ($gotboth != $both) {"
NSQ_SOURCE_LINE 00001316 "            $err = \"Malformed test [$l]: expected results for some tests, not others\";"
NSQ_SOURCE_LINE 00001317 "         }"
NSQ_SOURCE_LINE 00001318 ""
NSQ_SOURCE_LINE 00001319 "         $t++;"
NSQ_SOURCE_LINE 00001320 "         $tests{$t}{'err'}      = $err;"
NSQ_SOURCE_LINE 00001321 "         $tests{$t}{'args'}     = $args;"
NSQ_SOURCE_LINE 00001322 "         $tests{$t}{'expected'} = $results  if ($gotboth);"
NSQ_SOURCE_LINE 00001323 "      }"
NSQ_SOURCE_LINE 00001324 ""
NSQ_SOURCE_LINE 00001325 "      return ($t,$gotboth,%tests);"
NSQ_SOURCE_LINE 00001326 "   }"
NSQ_SOURCE_LINE 00001327 ""
NSQ_SOURCE_LINE 00001328 "   # Get all lines up to the end of lines or a blank line. Both"
NSQ_SOURCE_LINE 00001329 "   # signal the end of a test."
NSQ_SOURCE_LINE 00001330 "   #"
NSQ_SOURCE_LINE 00001331 "   sub _next_test {"
NSQ_SOURCE_LINE 00001332 "      my($self,$list) = @_;"
NSQ_SOURCE_LINE 00001333 "      my @test;"
NSQ_SOURCE_LINE 00001334 "      my $started     = 0;"
NSQ_SOURCE_LINE 00001335 ""
NSQ_SOURCE_LINE 00001336 "      while (1) {"
NSQ_SOURCE_LINE 00001337 "         last  if (! @$list);"
NSQ_SOURCE_LINE 00001338 "         my $line = shift(@$list);"
NSQ_SOURCE_LINE 00001339 ""
NSQ_SOURCE_LINE 00001340 "         $line =~ s/^\\s*//;"
NSQ_SOURCE_LINE 00001341 "         $line =~ s/\\s*$//;"
NSQ_SOURCE_LINE 00001342 ""
NSQ_SOURCE_LINE 00001343 "         # If it's a blank line, add it to the test. If we've"
NSQ_SOURCE_LINE 00001344 "         # already done test lines, then this signals the end"
NSQ_SOURCE_LINE 00001345 "         # of the test. Otherwise, this is before the test,"
NSQ_SOURCE_LINE 00001346 "         # so keep looking."
NSQ_SOURCE_LINE 00001347 "         if ($line eq '') {"
NSQ_SOURCE_LINE 00001348 "            push(@test,$line);"
NSQ_SOURCE_LINE 00001349 "            next  if (! $started);"
NSQ_SOURCE_LINE 00001350 "            last;"
NSQ_SOURCE_LINE 00001351 "         }"
NSQ_SOURCE_LINE 00001352 ""
NSQ_SOURCE_LINE 00001353 "         # Comments are added to the test as a blank line."
NSQ_SOURCE_LINE 00001354 "         if ($line =~ /^#/) {"
NSQ_SOURCE_LINE 00001355 "            push(@test,'');"
NSQ_SOURCE_LINE 00001356 "            next;"
NSQ_SOURCE_LINE 00001357 "         }"
NSQ_SOURCE_LINE 00001358 ""
NSQ_SOURCE_LINE 00001359 "         push(@test,$line);"
NSQ_SOURCE_LINE 00001360 "         $started = 1;"
NSQ_SOURCE_LINE 00001361 "      }"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "      return []  if (! $started);"
NSQ_SOURCE_LINE 00001364 "      return \\@test;"
NSQ_SOURCE_LINE 00001365 "   }"
NSQ_SOURCE_LINE 00001366 ""
NSQ_SOURCE_LINE 00001367 "   # Parse an entire test. Look for arguments, =>, and expected results."
NSQ_SOURCE_LINE 00001368 "   #"
NSQ_SOURCE_LINE 00001369 "   sub _parse_test {"
NSQ_SOURCE_LINE 00001370 "      my($self,$test) = @_;"
NSQ_SOURCE_LINE 00001371 "      my($err,$both,@args,@results);"
NSQ_SOURCE_LINE 00001372 ""
NSQ_SOURCE_LINE 00001373 "      my $curr        = 'args';"
NSQ_SOURCE_LINE 00001374 ""
NSQ_SOURCE_LINE 00001375 "      while (@$test) {"
NSQ_SOURCE_LINE 00001376 ""
NSQ_SOURCE_LINE 00001377 "         last  if (! $self->_test_line($test));"
NSQ_SOURCE_LINE 00001378 ""
NSQ_SOURCE_LINE 00001379 "         # Check for '=>'"
NSQ_SOURCE_LINE 00001380 ""
NSQ_SOURCE_LINE 00001381 "         if ($self->_parse_begin_results($test)) {"
NSQ_SOURCE_LINE 00001382 "            if ($curr eq 'args') {"
NSQ_SOURCE_LINE 00001383 "               $curr = 'results';"
NSQ_SOURCE_LINE 00001384 "            } else {"
NSQ_SOURCE_LINE 00001385 "               return (\"Malformed test [$l]: '=>' found twice\");"
NSQ_SOURCE_LINE 00001386 "            }"
NSQ_SOURCE_LINE 00001387 "            next;"
NSQ_SOURCE_LINE 00001388 "         }"
NSQ_SOURCE_LINE 00001389 ""
NSQ_SOURCE_LINE 00001390 "         # Get the next item(s) to add."
NSQ_SOURCE_LINE 00001391 ""
NSQ_SOURCE_LINE 00001392 "         my($err,$match,@val) = $self->_parse_token($test,$eot);"
NSQ_SOURCE_LINE 00001393 "         return ($err)  if ($err);"
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 "         if ($curr eq 'args') {"
NSQ_SOURCE_LINE 00001396 "            push(@args,@val);"
NSQ_SOURCE_LINE 00001397 "         } else {"
NSQ_SOURCE_LINE 00001398 "            push(@results,@val);"
NSQ_SOURCE_LINE 00001399 "         }"
NSQ_SOURCE_LINE 00001400 "      }"
NSQ_SOURCE_LINE 00001401 ""
NSQ_SOURCE_LINE 00001402 "      $both = ($curr eq 'results' ? 1 : 0);"
NSQ_SOURCE_LINE 00001403 "      return (\"\",$both,\\@args,\\@results);"
NSQ_SOURCE_LINE 00001404 "   }"
NSQ_SOURCE_LINE 00001405 ""
NSQ_SOURCE_LINE 00001406 "   # Makes sure that the first line in the test contains"
NSQ_SOURCE_LINE 00001407 "   # something. Blank lines are ignored."
NSQ_SOURCE_LINE 00001408 "   #"
NSQ_SOURCE_LINE 00001409 "   sub _test_line {"
NSQ_SOURCE_LINE 00001410 "      my($self,$test) = @_;"
NSQ_SOURCE_LINE 00001411 ""
NSQ_SOURCE_LINE 00001412 "      while (@$test  &&"
NSQ_SOURCE_LINE 00001413 "             (! defined($$test[0])  ||"
NSQ_SOURCE_LINE 00001414 "              $$test[0] eq '')) {"
NSQ_SOURCE_LINE 00001415 "         shift(@$test);"
NSQ_SOURCE_LINE 00001416 "         $l++;"
NSQ_SOURCE_LINE 00001417 "         next;"
NSQ_SOURCE_LINE 00001418 "      }"
NSQ_SOURCE_LINE 00001419 "      return 1  if (@$test);"
NSQ_SOURCE_LINE 00001420 "      return 0;"
NSQ_SOURCE_LINE 00001421 "   }"
NSQ_SOURCE_LINE 00001422 ""
NSQ_SOURCE_LINE 00001423 "   # Check for '=>'."
NSQ_SOURCE_LINE 00001424 "   #"
NSQ_SOURCE_LINE 00001425 "   # Return 1 if found, 0 otherwise."
NSQ_SOURCE_LINE 00001426 "   #"
NSQ_SOURCE_LINE 00001427 "   sub _parse_begin_results {"
NSQ_SOURCE_LINE 00001428 "      my($self,$test) = @_;"
NSQ_SOURCE_LINE 00001429 ""
NSQ_SOURCE_LINE 00001430 "      return 1  if ($$test[0] =~ s/^ $sp_opt $results $eot //x);"
NSQ_SOURCE_LINE 00001431 "      return 0;"
NSQ_SOURCE_LINE 00001432 "   }"
NSQ_SOURCE_LINE 00001433 ""
NSQ_SOURCE_LINE 00001434 "   # Gets the next item to add to the current list."
NSQ_SOURCE_LINE 00001435 "   #"
NSQ_SOURCE_LINE 00001436 "   # Returns ($err,$match,@val) where $match is the character that"
NSQ_SOURCE_LINE 00001437 "   # matched the end of the current element (either a delimiter,"
NSQ_SOURCE_LINE 00001438 "   # closing character, or nothing if the element ends on"
NSQ_SOURCE_LINE 00001439 "   # whitespace/newline)."
NSQ_SOURCE_LINE 00001440 "   #"
NSQ_SOURCE_LINE 00001441 "   sub _parse_token {"
NSQ_SOURCE_LINE 00001442 "      my($self,$test,$EOT) = @_;"
NSQ_SOURCE_LINE 00001443 ""
NSQ_SOURCE_LINE 00001444 "      my($err,$found,$match,@val);"
NSQ_SOURCE_LINE 00001445 ""
NSQ_SOURCE_LINE 00001446 "      {"
NSQ_SOURCE_LINE 00001447 "         last  if (! $self->_test_line($test));"
NSQ_SOURCE_LINE 00001448 ""
NSQ_SOURCE_LINE 00001449 "         # Check for quoted"
NSQ_SOURCE_LINE 00001450 ""
NSQ_SOURCE_LINE 00001451 "         ($err,$found,$match,@val) = $self->_parse_quoted($test,$EOT);"
NSQ_SOURCE_LINE 00001452 "         last  if ($err);"
NSQ_SOURCE_LINE 00001453 "         if ($found) {"
NSQ_SOURCE_LINE 00001454 "            # ''  remains ''"
NSQ_SOURCE_LINE 00001455 "            last;"
NSQ_SOURCE_LINE 00001456 "         }"
NSQ_SOURCE_LINE 00001457 ""
NSQ_SOURCE_LINE 00001458 "         # Check for open"
NSQ_SOURCE_LINE 00001459 ""
NSQ_SOURCE_LINE 00001460 "         ($err,$found,$match,@val) = $self->_parse_open_close($test,$EOT,$lparen,')');"
NSQ_SOURCE_LINE 00001461 "         last  if ($err);"
NSQ_SOURCE_LINE 00001462 "         if ($found) {"
NSQ_SOURCE_LINE 00001463 "            # ()  is an empty list"
NSQ_SOURCE_LINE 00001464 "            if (@val == 1  &&  $val[0] eq '') {"
NSQ_SOURCE_LINE 00001465 "               @val = ();"
NSQ_SOURCE_LINE 00001466 "            }"
NSQ_SOURCE_LINE 00001467 "            last;"
NSQ_SOURCE_LINE 00001468 "         }"
NSQ_SOURCE_LINE 00001469 ""
NSQ_SOURCE_LINE 00001470 "         ($err,$found,$match,@val) = $self->_parse_open_close($test,$EOT,$lbrack,']');"
NSQ_SOURCE_LINE 00001471 "         last  if ($err);"
NSQ_SOURCE_LINE 00001472 "         if ($found) {"
NSQ_SOURCE_LINE 00001473 "            # []  is []"
NSQ_SOURCE_LINE 00001474 "            if (@val == 1  &&  $val[0] eq '') {"
NSQ_SOURCE_LINE 00001475 "               @val = ([]);"
NSQ_SOURCE_LINE 00001476 "            } else {"
NSQ_SOURCE_LINE 00001477 "               @val = ( [@val] );"
NSQ_SOURCE_LINE 00001478 "            }"
NSQ_SOURCE_LINE 00001479 "            last;"
NSQ_SOURCE_LINE 00001480 "         }"
NSQ_SOURCE_LINE 00001481 ""
NSQ_SOURCE_LINE 00001482 "         ($err,$found,$match,@val) = $self->_parse_open_close($test,$EOT,$lbrace,'}');"
NSQ_SOURCE_LINE 00001483 "         last  if ($err);"
NSQ_SOURCE_LINE 00001484 "         if ($found) {"
NSQ_SOURCE_LINE 00001485 "            if (@val == 1  &&  $val[0] eq '') {"
NSQ_SOURCE_LINE 00001486 "               @val = ( {} );"
NSQ_SOURCE_LINE 00001487 "            } elsif (@val % 2 == 0) {"
NSQ_SOURCE_LINE 00001488 "               # Even number of elements"
NSQ_SOURCE_LINE 00001489 "               @val = ( {@val} );"
NSQ_SOURCE_LINE 00001490 "            } elsif (! defined $val[$#val]  ||"
NSQ_SOURCE_LINE 00001491 "                     $val[$#val] eq '') {"
NSQ_SOURCE_LINE 00001492 "               # Odd number of elements with nothing as the"
NSQ_SOURCE_LINE 00001493 "               # last element."
NSQ_SOURCE_LINE 00001494 "               pop(@val);"
NSQ_SOURCE_LINE 00001495 "               @val = ( {@val} );"
NSQ_SOURCE_LINE 00001496 "            } else {"
NSQ_SOURCE_LINE 00001497 "               # Odd number of elements not supported for a hash"
NSQ_SOURCE_LINE 00001498 "               $err = \"Malformed test [$l]: hash with odd number of elements\";"
NSQ_SOURCE_LINE 00001499 "            }"
NSQ_SOURCE_LINE 00001500 "            last;"
NSQ_SOURCE_LINE 00001501 "         }"
NSQ_SOURCE_LINE 00001502 ""
NSQ_SOURCE_LINE 00001503 "         # Check for some other token"
NSQ_SOURCE_LINE 00001504 ""
NSQ_SOURCE_LINE 00001505 "         ($err,$found,$match,@val) = $self->_parse_simple_token($test,$EOT);"
NSQ_SOURCE_LINE 00001506 "         last  if ($err);"
NSQ_SOURCE_LINE 00001507 ""
NSQ_SOURCE_LINE 00001508 "         last;"
NSQ_SOURCE_LINE 00001509 "      }"
NSQ_SOURCE_LINE 00001510 ""
NSQ_SOURCE_LINE 00001511 "      return ($err)            if ($err);"
NSQ_SOURCE_LINE 00001512 "      return (\"Malformed test: unable to parse\")  if (! $found);"
NSQ_SOURCE_LINE 00001513 ""
NSQ_SOURCE_LINE 00001514 "      foreach my $v (@val) {"
NSQ_SOURCE_LINE 00001515 "         $v = ''     if ($v eq '__blank__');"
NSQ_SOURCE_LINE 00001516 "         $v = undef  if ($v eq '__undef__');"
NSQ_SOURCE_LINE 00001517 "         $v =~ s/__nl__/\\n/g  if ($v);"
NSQ_SOURCE_LINE 00001518 "     }"
NSQ_SOURCE_LINE 00001519 "      return (0,$match,@val)  if ($found);"
NSQ_SOURCE_LINE 00001520 "      return (0,0);"
NSQ_SOURCE_LINE 00001521 "   }"
NSQ_SOURCE_LINE 00001522 ""
NSQ_SOURCE_LINE 00001523 "   ###"
NSQ_SOURCE_LINE 00001524 "   ### The next few routines parse parts of the test. Each of them"
NSQ_SOURCE_LINE 00001525 "   ### take as arguments:"
NSQ_SOURCE_LINE 00001526 "   ###"
NSQ_SOURCE_LINE 00001527 "   ###    $test    : the listref containing the unparsed portion of"
NSQ_SOURCE_LINE 00001528 "   ###               the test"
NSQ_SOURCE_LINE 00001529 "   ###    $EOT     : the end of a token"
NSQ_SOURCE_LINE 00001530 "   ###"
NSQ_SOURCE_LINE 00001531 "   ###    + other args as needed."
NSQ_SOURCE_LINE 00001532 "   ###"
NSQ_SOURCE_LINE 00001533 "   ### They all return:"
NSQ_SOURCE_LINE 00001534 "   ###"
NSQ_SOURCE_LINE 00001535 "   ###    $err     : a string containing the error (if any)"
NSQ_SOURCE_LINE 00001536 "   ###    $found   : 1 if something matched"
NSQ_SOURCE_LINE 00001537 "   ###    $match   : the character which terminates the current"
NSQ_SOURCE_LINE 00001538 "   ###               token signaling the start of the next token"
NSQ_SOURCE_LINE 00001539 "   ###               (this will either be a delimiter, a closing"
NSQ_SOURCE_LINE 00001540 "   ###               character, or nothing if the string ended on"
NSQ_SOURCE_LINE 00001541 "   ###               whitespace or a newline)"
NSQ_SOURCE_LINE 00001542 "   ###    @val     : the value (or values) of the token"
NSQ_SOURCE_LINE 00001543 "   ###"
NSQ_SOURCE_LINE 00001544 ""
NSQ_SOURCE_LINE 00001545 "   # Check for a quoted string"
NSQ_SOURCE_LINE 00001546 "   #   'STRING'"
NSQ_SOURCE_LINE 00001547 "   #   \"STRING\""
NSQ_SOURCE_LINE 00001548 "   # The string must be on one line, and everything up to the"
NSQ_SOURCE_LINE 00001549 "   # closing quote is included (the quotes themselves are"
NSQ_SOURCE_LINE 00001550 "   # stripped)."
NSQ_SOURCE_LINE 00001551 "   #"
NSQ_SOURCE_LINE 00001552 "   sub _parse_quoted {"
NSQ_SOURCE_LINE 00001553 "      my($self,$test,$EOT) = @_;"
NSQ_SOURCE_LINE 00001554 ""
NSQ_SOURCE_LINE 00001555 "      if ($$test[0] =~ s/^ $sp_opt $q  ($min_str) $q  $EOT//x  ||"
NSQ_SOURCE_LINE 00001556 "          $$test[0] =~ s/^ $sp_opt $qq ($min_str) $qq $EOT//x) {"
NSQ_SOURCE_LINE 00001557 "         return (0,1,$2,$1);"
NSQ_SOURCE_LINE 00001558 ""
NSQ_SOURCE_LINE 00001559 "      } elsif ($$test[0] =~ /^ $sp_opt $q/x  ||"
NSQ_SOURCE_LINE 00001560 "               $$test[0] =~ /^ $sp_opt $qq/x) {"
NSQ_SOURCE_LINE 00001561 "         return (\"Malformed test [$l]: improper quoting\");"
NSQ_SOURCE_LINE 00001562 "      }"
NSQ_SOURCE_LINE 00001563 "      return (0,0);"
NSQ_SOURCE_LINE 00001564 "   }"
NSQ_SOURCE_LINE 00001565 ""
NSQ_SOURCE_LINE 00001566 "   # Parses an open/close section."
NSQ_SOURCE_LINE 00001567 "   #"
NSQ_SOURCE_LINE 00001568 "   #   ( TOKEN TOKEN ... )"
NSQ_SOURCE_LINE 00001569 "   #   (, TOKEN, TOKEN, ... )"
NSQ_SOURCE_LINE 00001570 "   #"
NSQ_SOURCE_LINE 00001571 "   # $open is a regular expression matching the open, $close is the"
NSQ_SOURCE_LINE 00001572 "   # actual closing character."
NSQ_SOURCE_LINE 00001573 "   #"
NSQ_SOURCE_LINE 00001574 "   # After the closing character must be an $EOT."
NSQ_SOURCE_LINE 00001575 "   #"
NSQ_SOURCE_LINE 00001576 "   sub _parse_open_close {"
NSQ_SOURCE_LINE 00001577 "      my($self,$test,$EOT,$open,$close) = @_;"
NSQ_SOURCE_LINE 00001578 ""
NSQ_SOURCE_LINE 00001579 "      # See if there is an open"
NSQ_SOURCE_LINE 00001580 ""
NSQ_SOURCE_LINE 00001581 "      my($del,$newEOT);"
NSQ_SOURCE_LINE 00001582 "      if ($$test[0] =~ s/^ $sp_opt $open ($delim) $sp_opt //x) {"
NSQ_SOURCE_LINE 00001583 "         $del     = $1;"
NSQ_SOURCE_LINE 00001584 "         $newEOT  = qr/ $sp_opt ($|\\Q$del\\E|\\Q$close\\E) /x;"
NSQ_SOURCE_LINE 00001585 ""
NSQ_SOURCE_LINE 00001586 "      } elsif ($$test[0] =~ s/^ $sp_opt $open $sp_opt //x) {"
NSQ_SOURCE_LINE 00001587 "         $del     = '';"
NSQ_SOURCE_LINE 00001588 "         $newEOT  = qr/ ($sp_opt $|$sp_opt \\Q$close\\E|$sp) /x;"
NSQ_SOURCE_LINE 00001589 ""
NSQ_SOURCE_LINE 00001590 "      } else {"
NSQ_SOURCE_LINE 00001591 "         return (0,0);"
NSQ_SOURCE_LINE 00001592 "      }"
NSQ_SOURCE_LINE 00001593 ""
NSQ_SOURCE_LINE 00001594 "      # If there was, then we need to read tokens until either:"
NSQ_SOURCE_LINE 00001595 "      #    the string is all used up => error"
NSQ_SOURCE_LINE 00001596 "      #    $close is found"
NSQ_SOURCE_LINE 00001597 ""
NSQ_SOURCE_LINE 00001598 "      my($match,@val);"
NSQ_SOURCE_LINE 00001599 "      while (1) {"
NSQ_SOURCE_LINE 00001600 ""
NSQ_SOURCE_LINE 00001601 "         # Get a token. We MUST find something valid even if it is"
NSQ_SOURCE_LINE 00001602 "         # an empty list followed by the closing character."
NSQ_SOURCE_LINE 00001603 "         my($e,$m,@v) = $self->_parse_token($test,$newEOT);"
NSQ_SOURCE_LINE 00001604 "         return ($e)  if ($e);"
NSQ_SOURCE_LINE 00001605 "         $m =~ s/^$sp//;"
NSQ_SOURCE_LINE 00001606 ""
NSQ_SOURCE_LINE 00001607 "         # If we ended on nothing, and $del is something, then we"
NSQ_SOURCE_LINE 00001608 "         # ended on a newline with no delimiter. The next line MUST"
NSQ_SOURCE_LINE 00001609 "         # start with a delimiter or close character or the test is"
NSQ_SOURCE_LINE 00001610 "         # invalid."
NSQ_SOURCE_LINE 00001611 ""
NSQ_SOURCE_LINE 00001612 "         if (! $m  &&  $del) {"
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "            if (! $self->_test_line($test)) {"
NSQ_SOURCE_LINE 00001615 "               return (\"Malformed test [$l]: premature end of test\");"
NSQ_SOURCE_LINE 00001616 "            }"
NSQ_SOURCE_LINE 00001617 ""
NSQ_SOURCE_LINE 00001618 "            if ($$test[0] =~ s/^ $sp_opt $newEOT //x) {"
NSQ_SOURCE_LINE 00001619 "               $m = $1;"
NSQ_SOURCE_LINE 00001620 "            } else {"
NSQ_SOURCE_LINE 00001621 "               return (\"Malformed test [$l]: unexpected token (expected '$close' or '$del')\");"
NSQ_SOURCE_LINE 00001622 "            }"
NSQ_SOURCE_LINE 00001623 "         }"
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 "         # Figure out what value(s) were returned"
NSQ_SOURCE_LINE 00001626 "         if ($m eq $close  &&  ! @v) {"
NSQ_SOURCE_LINE 00001627 "            push(@val,'');"
NSQ_SOURCE_LINE 00001628 "         } else {"
NSQ_SOURCE_LINE 00001629 "            push(@val,@v);"
NSQ_SOURCE_LINE 00001630 "         }"
NSQ_SOURCE_LINE 00001631 ""
NSQ_SOURCE_LINE 00001632 "         last  if ($m eq $close);"
NSQ_SOURCE_LINE 00001633 ""
NSQ_SOURCE_LINE 00001634 "      }"
NSQ_SOURCE_LINE 00001635 ""
NSQ_SOURCE_LINE 00001636 "      # Now we need to find out what character ends this token:"
NSQ_SOURCE_LINE 00001637 ""
NSQ_SOURCE_LINE 00001638 "      if ($$test[0] eq '') {"
NSQ_SOURCE_LINE 00001639 "         # Ended at EOL"
NSQ_SOURCE_LINE 00001640 "         return (0,1,'',@val);"
NSQ_SOURCE_LINE 00001641 "      }"
NSQ_SOURCE_LINE 00001642 "      if ($$test[0] =~ s/^ $sp_opt $EOT //x) {"
NSQ_SOURCE_LINE 00001643 "         return (0,1,$1,@val);"
NSQ_SOURCE_LINE 00001644 "      } else {"
NSQ_SOURCE_LINE 00001645 "         return (\"Malformed test [$l]: unexpected token\");"
NSQ_SOURCE_LINE 00001646 "      }"
NSQ_SOURCE_LINE 00001647 "   }"
NSQ_SOURCE_LINE 00001648 ""
NSQ_SOURCE_LINE 00001649 "   # Checks for a simple token."
NSQ_SOURCE_LINE 00001650 "   #"
NSQ_SOURCE_LINE 00001651 "   sub _parse_simple_token {"
NSQ_SOURCE_LINE 00001652 "      my($self,$test,$EOT) = @_;"
NSQ_SOURCE_LINE 00001653 ""
NSQ_SOURCE_LINE 00001654 "      $$test[0] =~ s/^ $sp_opt (.*?) $EOT//x;"
NSQ_SOURCE_LINE 00001655 "      return (0,1,$2,$1);"
NSQ_SOURCE_LINE 00001656 "   }"
NSQ_SOURCE_LINE 00001657 "}"
NSQ_SOURCE_LINE 00001658 ""
NSQ_SOURCE_LINE 00001659 "1;"
