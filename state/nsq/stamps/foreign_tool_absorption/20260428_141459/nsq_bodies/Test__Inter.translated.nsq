NSQ_SOURCE_LINE 00000470 "         $self->feature($module,1);"
NSQ_SOURCE_LINE 00000471 "         if (! $$self{'quiet'}) {"
NSQ_SOURCE_LINE 00000472 "            $self->_diag($desc);"
NSQ_SOURCE_LINE 00000473 "            $self->_diag(\"Feature available: $module\");"
NSQ_SOURCE_LINE 00000474 "         }"
NSQ_SOURCE_LINE 00000475 "      } else {"
NSQ_SOURCE_LINE 00000476 "         $self->_ok($desc);"
NSQ_SOURCE_LINE 00000477 "      }"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "   } else {"
NSQ_SOURCE_LINE 00000480 "      # Unable to load the module"
NSQ_SOURCE_LINE 00000481 "      if ($mode eq 'forbid') {"
NSQ_SOURCE_LINE 00000482 "         $self->_ok($desc);"
NSQ_SOURCE_LINE 00000483 "      } elsif ($mode eq 'feature') {"
NSQ_SOURCE_LINE 00000484 "         $self->feature($module,0);"
NSQ_SOURCE_LINE 00000485 "         if (! $$self{'quiet'}) {"
NSQ_SOURCE_LINE 00000486 "            $self->_diag($desc);"
NSQ_SOURCE_LINE 00000487 "            $self->_diag(\"Feature unavailable: $module\");"
NSQ_SOURCE_LINE 00000488 "         }"
NSQ_SOURCE_LINE 00000489 "      } else {"
NSQ_SOURCE_LINE 00000490 "         $$self{'skipall'} = 'Unable to load a required module';"
NSQ_SOURCE_LINE 00000491 "         $self->_not_ok($desc);"
NSQ_SOURCE_LINE 00000492 "         $ok = 0;"
NSQ_SOURCE_LINE 00000493 "      }"
NSQ_SOURCE_LINE 00000494 "   }"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "   return"
NSQ_SOURCE_LINE 00000497 "     if ( ($ok    &&  $$self{'quiet'})  ||"
NSQ_SOURCE_LINE 00000498 "          (! $ok  &&  $$self{'quiet'} == 2) );"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "   foreach my $err (@eval_error) {"
