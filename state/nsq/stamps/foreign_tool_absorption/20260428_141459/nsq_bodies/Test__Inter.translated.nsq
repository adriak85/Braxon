NSQ_SOURCE_LINE 00000505 "sub _is_module_name {"
NSQ_SOURCE_LINE 00000506 "   my($self,$module) = @_;"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "   # Module names start with a letter."
NSQ_SOURCE_LINE 00000509 "   # End with an alphanumeric."
NSQ_SOURCE_LINE 00000510 "   # The rest is an alphanumeric or ::"
NSQ_SOURCE_LINE 00000511 "   $module =~ s/\\b::\\b//g;"
NSQ_SOURCE_LINE 00000512 ""
