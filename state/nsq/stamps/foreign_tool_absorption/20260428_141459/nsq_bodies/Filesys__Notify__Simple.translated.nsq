BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Filesys::Notify::Simple;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use 5.008_001;"
NSQ_SOURCE_LINE 00000005 "our $VERSION = '0.14';"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Carp ();"
NSQ_SOURCE_LINE 00000008 "use Cwd;"
NSQ_SOURCE_LINE 00000009 "use constant NO_OPT => $ENV{PERL_FNS_NO_OPT};"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "sub new {"
NSQ_SOURCE_LINE 00000012 "    my($class, $path) = @_;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "    unless (ref $path eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000015 "        Carp::croak('Usage: Filesys::Notify::Simple->new([ $path1, $path2 ])');"
NSQ_SOURCE_LINE 00000016 "    }"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "    my $self = bless { paths => $path }, $class;"
NSQ_SOURCE_LINE 00000019 "    $self->init;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "    $self;"
NSQ_SOURCE_LINE 00000022 "}"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "sub wait {"
NSQ_SOURCE_LINE 00000025 "    my($self, $cb) = @_;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    $self->{watcher} ||= $self->{watcher_cb}->(@{$self->{paths}});"
NSQ_SOURCE_LINE 00000028 "    $self->{watcher}->($cb);"
NSQ_SOURCE_LINE 00000029 "}"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub init {"
NSQ_SOURCE_LINE 00000032 "    my $self = shift;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    local $@;"
NSQ_SOURCE_LINE 00000035 "    if ($^O eq 'linux' && !NO_OPT && eval { require Linux::Inotify2; 1 }) {"
NSQ_SOURCE_LINE 00000036 "        $self->{watcher_cb} = \\&wait_inotify2;"
NSQ_SOURCE_LINE 00000037 "    } elsif ($^O eq 'darwin' && !NO_OPT && eval { require Mac::FSEvents; 1 }) {"
NSQ_SOURCE_LINE 00000038 "        $self->{watcher_cb} = \\&wait_fsevents;"
NSQ_SOURCE_LINE 00000039 "    } elsif (($^O eq 'freebsd' || $^O eq 'openbsd') && !NO_OPT && eval { require Filesys::Notify::KQueue; 1 }) {"
NSQ_SOURCE_LINE 00000040 "        $self->{watcher_cb} = \\&wait_kqueue;"
NSQ_SOURCE_LINE 00000041 "    } elsif ($^O eq 'MSWin32' && !NO_OPT && eval { require Win32::ChangeNotify; 1 }) {"
NSQ_SOURCE_LINE 00000042 "        $self->{watcher_cb} = mk_wait_win32(0); # Not cygwin"
NSQ_SOURCE_LINE 00000043 "    } elsif ($^O eq 'cygwin' && !NO_OPT && eval { require Win32::ChangeNotify; 1 }) {"
NSQ_SOURCE_LINE 00000044 "        $self->{watcher_cb} = mk_wait_win32(1); # Cygwin"
NSQ_SOURCE_LINE 00000045 "    } else {"
NSQ_SOURCE_LINE 00000046 "        $self->{watcher_cb} = \\&wait_timer;"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "sub wait_inotify2 {"
NSQ_SOURCE_LINE 00000051 "    my @path = @_;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    Linux::Inotify2->import;"
NSQ_SOURCE_LINE 00000054 "    my $inotify = Linux::Inotify2->new;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    my $fs = _full_scan(@path);"
NSQ_SOURCE_LINE 00000057 "    for my $path (keys %$fs) {"
NSQ_SOURCE_LINE 00000058 "        $inotify->watch($path, &IN_MODIFY|&IN_CREATE|&IN_DELETE|&IN_DELETE_SELF|&IN_MOVE_SELF|&IN_MOVE)"
NSQ_SOURCE_LINE 00000059 "            or Carp::carp(\"watch failed for $path: $!\");"
NSQ_SOURCE_LINE 00000060 "    }"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    return sub {"
NSQ_SOURCE_LINE 00000063 "        my $cb = shift;"
NSQ_SOURCE_LINE 00000064 "        $inotify->blocking(1);"
NSQ_SOURCE_LINE 00000065 "        my @events = $inotify->read;"
NSQ_SOURCE_LINE 00000066 "        $cb->(map { +{ path => $_->fullname } } @events);"
NSQ_SOURCE_LINE 00000067 "    };"
NSQ_SOURCE_LINE 00000068 "}"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "sub wait_fsevents {"
NSQ_SOURCE_LINE 00000071 "    require IO::Select;"
NSQ_SOURCE_LINE 00000072 "    my @path = @_;"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    my $fs = _full_scan(@path);"
NSQ_SOURCE_LINE 00000075 "    my $sel = IO::Select->new;"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    my %events;"
NSQ_SOURCE_LINE 00000078 "    for my $path (@path) {"
NSQ_SOURCE_LINE 00000079 "        my $fsevents = Mac::FSEvents->new({ path => $path, latency => 1, file_events => 1 });"
NSQ_SOURCE_LINE 00000080 "        my $fh = $fsevents->watch;"
NSQ_SOURCE_LINE 00000081 "        $sel->add($fh);"
NSQ_SOURCE_LINE 00000082 "        $events{fileno $fh} = $fsevents;"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    return sub {"
NSQ_SOURCE_LINE 00000086 "        my $cb = shift;"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "        my @ready = $sel->can_read;"
NSQ_SOURCE_LINE 00000089 "        my @events;"
NSQ_SOURCE_LINE 00000090 "        for my $fh (@ready) {"
NSQ_SOURCE_LINE 00000091 "            my $fsevents = $events{fileno $fh};"
NSQ_SOURCE_LINE 00000092 "            my %uniq;"
NSQ_SOURCE_LINE 00000093 "            my @path = grep !$uniq{$_}++, map { $_->path } $fsevents->read_events;"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "            my $new_fs = _full_scan(@path);"
NSQ_SOURCE_LINE 00000096 "            my $old_fs = +{ map { ($_ => $fs->{$_}) } keys %$new_fs };"
NSQ_SOURCE_LINE 00000097 "            _compare_fs($old_fs, $new_fs, sub { push @events, { path => $_[0] } });"
NSQ_SOURCE_LINE 00000098 "            $fs->{$_} = $new_fs->{$_} for keys %$new_fs;"
NSQ_SOURCE_LINE 00000099 "            last if @events;"
NSQ_SOURCE_LINE 00000100 "        }"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "        $cb->(@events);"
NSQ_SOURCE_LINE 00000103 "    };"
NSQ_SOURCE_LINE 00000104 "}"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "sub wait_kqueue {"
NSQ_SOURCE_LINE 00000107 "    my @path = @_;"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    my $kqueue = Filesys::Notify::KQueue->new("
NSQ_SOURCE_LINE 00000110 "        path => \\@path"
NSQ_SOURCE_LINE 00000111 "    );"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "    return sub { $kqueue->wait(shift) };"
NSQ_SOURCE_LINE 00000114 "}"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "sub mk_wait_win32 {"
NSQ_SOURCE_LINE 00000117 "    my ($is_cygwin) = @_;"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "    return sub {"
NSQ_SOURCE_LINE 00000120 "        my @path = @_;"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "        my $fs = _full_scan(@path);"
NSQ_SOURCE_LINE 00000123 "        my (@notify, @fskey);"
NSQ_SOURCE_LINE 00000124 "        for my $path (keys %$fs) {"
NSQ_SOURCE_LINE 00000125 "            my $winpath = $is_cygwin ? Cygwin::posix_to_win_path($path) : $path;"
NSQ_SOURCE_LINE 00000126 "            # 0x1b means 'DIR_NAME|FILE_NAME|LAST_WRITE|SIZE' = 2|1|0x10|8"
NSQ_SOURCE_LINE 00000127 "            push @notify, Win32::ChangeNotify->new($winpath, 0, 0x1b);"
NSQ_SOURCE_LINE 00000128 "            push @fskey, $path;"
NSQ_SOURCE_LINE 00000129 "        }"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "        return sub {"
NSQ_SOURCE_LINE 00000132 "            my $cb = shift;"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "            my @events;"
NSQ_SOURCE_LINE 00000135 "            while(1) {"
NSQ_SOURCE_LINE 00000136 "                my $idx = Win32::ChangeNotify::wait_any(\\@notify);"
NSQ_SOURCE_LINE 00000137 "                Carp::croak(\"Can't wait notifications, maybe \".scalar(@notify).\" directories exceeds limitation.\") if ! defined $idx;"
NSQ_SOURCE_LINE 00000138 "                if($idx > 0) {"
NSQ_SOURCE_LINE 00000139 "                    --$idx;"
NSQ_SOURCE_LINE 00000140 "                    my $new_fs = _full_scan($fskey[$idx]);"
NSQ_SOURCE_LINE 00000141 "                    $notify[$idx]->reset;"
NSQ_SOURCE_LINE 00000142 "                    my $old_fs = +{ map { ($_ => $fs->{$_}) } keys %$new_fs };"
NSQ_SOURCE_LINE 00000143 "                    _compare_fs($old_fs, $new_fs, sub { push @events, { path => $_[0] } });"
NSQ_SOURCE_LINE 00000144 "                    $fs->{$_} = $new_fs->{$_} for keys %$new_fs;"
NSQ_SOURCE_LINE 00000145 "                    last if @events; # Actually changed"
NSQ_SOURCE_LINE 00000146 "                }"
NSQ_SOURCE_LINE 00000147 "            }"
NSQ_SOURCE_LINE 00000148 "            $cb->(@events);"
NSQ_SOURCE_LINE 00000149 "        }"
NSQ_SOURCE_LINE 00000150 "    }"
NSQ_SOURCE_LINE 00000151 "}"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "sub wait_timer {"
NSQ_SOURCE_LINE 00000154 "    my @path = @_;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    my $fs = _full_scan(@path);"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    return sub {"
NSQ_SOURCE_LINE 00000159 "        my $cb = shift;"
NSQ_SOURCE_LINE 00000160 "        my @events;"
NSQ_SOURCE_LINE 00000161 "        while (1) {"
NSQ_SOURCE_LINE 00000162 "            sleep 2;"
NSQ_SOURCE_LINE 00000163 "            my $new_fs = _full_scan(@path);"
NSQ_SOURCE_LINE 00000164 "            _compare_fs($fs, $new_fs, sub { push @events, { path => $_[0] } });"
NSQ_SOURCE_LINE 00000165 "            $fs = $new_fs;"
NSQ_SOURCE_LINE 00000166 "            last if @events;"
NSQ_SOURCE_LINE 00000167 "        };"
NSQ_SOURCE_LINE 00000168 "        $cb->(@events);"
NSQ_SOURCE_LINE 00000169 "    };"
NSQ_SOURCE_LINE 00000170 "}"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "sub _compare_fs {"
NSQ_SOURCE_LINE 00000173 "    my($old, $new, $cb) = @_;"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    for my $dir (keys %$old) {"
NSQ_SOURCE_LINE 00000176 "        for my $path (keys %{$old->{$dir}}) {"
NSQ_SOURCE_LINE 00000177 "            if (!exists $new->{$dir}{$path}) {"
NSQ_SOURCE_LINE 00000178 "                $cb->($path); # deleted"
NSQ_SOURCE_LINE 00000179 "            } elsif (!$new->{$dir}{$path}{is_dir} &&"
NSQ_SOURCE_LINE 00000180 "                    ( $old->{$dir}{$path}{mtime} != $new->{$dir}{$path}{mtime} ||"
NSQ_SOURCE_LINE 00000181 "                      $old->{$dir}{$path}{size}  != $new->{$dir}{$path}{size})) {"
NSQ_SOURCE_LINE 00000182 "                $cb->($path); # updated"
NSQ_SOURCE_LINE 00000183 "            }"
NSQ_SOURCE_LINE 00000184 "        }"
NSQ_SOURCE_LINE 00000185 "    }"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "    for my $dir (keys %$new) {"
NSQ_SOURCE_LINE 00000188 "        for my $path (sort grep { !exists $old->{$dir}{$_} } keys %{$new->{$dir}}) {"
NSQ_SOURCE_LINE 00000189 "            $cb->($path); # new"
NSQ_SOURCE_LINE 00000190 "        }"
NSQ_SOURCE_LINE 00000191 "    }"
NSQ_SOURCE_LINE 00000192 "}"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "sub _full_scan {"
NSQ_SOURCE_LINE 00000195 "    my @paths = @_;"
NSQ_SOURCE_LINE 00000196 "    require File::Find;"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "    my %map;"
NSQ_SOURCE_LINE 00000199 "    for my $path (@paths) {"
NSQ_SOURCE_LINE 00000200 "        my $fp = eval { Cwd::realpath($path) } or next;"
NSQ_SOURCE_LINE 00000201 "        File::Find::finddepth({"
NSQ_SOURCE_LINE 00000202 "            wanted => sub {"
NSQ_SOURCE_LINE 00000203 "                my $fullname = $File::Find::fullname || File::Spec->rel2abs($File::Find::name);"
NSQ_SOURCE_LINE 00000204 "                $map{Cwd::realpath($File::Find::dir)}{$fullname} = _stat($fullname);"
NSQ_SOURCE_LINE 00000205 "            },"
NSQ_SOURCE_LINE 00000206 "            follow_fast => 1,"
NSQ_SOURCE_LINE 00000207 "            follow_skip => 2,"
NSQ_SOURCE_LINE 00000208 "            no_chdir => 1,"
NSQ_SOURCE_LINE 00000209 "        }, $path);"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "        # remove root entry"
NSQ_SOURCE_LINE 00000212 "        # NOTE: On MSWin32, realpath and rel2abs disagree with path separator."
NSQ_SOURCE_LINE 00000213 "        delete $map{$fp}{File::Spec->rel2abs($fp)};"
NSQ_SOURCE_LINE 00000214 "    }"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    return \\%map;"
NSQ_SOURCE_LINE 00000217 "}"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "sub _stat {"
NSQ_SOURCE_LINE 00000220 "    my $path = shift;"
NSQ_SOURCE_LINE 00000221 "    my @stat = stat $path;"
NSQ_SOURCE_LINE 00000222 "    return { path => $path, mtime => $stat[9], size => $stat[7], is_dir => -d _ };"
NSQ_SOURCE_LINE 00000223 "}"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "1;"
NSQ_SOURCE_LINE 00000227 "__END__"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=encoding utf-8"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=for stopwords"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=head1 NAME"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "Filesys::Notify::Simple - Simple and dumb file system watcher"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "  use Filesys::Notify::Simple;"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "  my $watcher = Filesys::Notify::Simple->new([ \".\" ]);"
NSQ_SOURCE_LINE 00000242 "  $watcher->wait(sub {"
NSQ_SOURCE_LINE 00000243 "      for my $event (@_) {"
NSQ_SOURCE_LINE 00000244 "          $event->{path} # full path of the file updated"
NSQ_SOURCE_LINE 00000245 "      }"
NSQ_SOURCE_LINE 00000246 "  });"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "Filesys::Notify::Simple is a simple but unified interface to get"
NSQ_SOURCE_LINE 00000251 "notifications of changes to a given filesystem path. It utilizes"
NSQ_SOURCE_LINE 00000252 "inotify2 on Linux, fsevents on OS X, kqueue on FreeBSD and"
NSQ_SOURCE_LINE 00000253 "FindFirstChangeNotification on Windows if they're installed, with a"
NSQ_SOURCE_LINE 00000254 "fallback to the full directory scan if they're not available."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "There are some limitations in this module. If you don't like it, use"
NSQ_SOURCE_LINE 00000257 "L<File::ChangeNotify>."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=over 4"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=item *"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "There is no file name based filter. Do it in your own code."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=item *"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "You can not get types of events (created, updated, deleted)."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=item *"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Currently C<wait> method blocks."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=back"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "In return, this module doesn't depend on any non-core"
NSQ_SOURCE_LINE 00000276 "modules. Platform specific optimizations with L<Linux::Inotify2>,"
NSQ_SOURCE_LINE 00000277 "L<Mac::FSEvents>, L<Filesys::Notify::KQueue> and L<Win32::ChangeNotify>"
NSQ_SOURCE_LINE 00000278 "are truely optional."
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "NOTE: Using L<Win32::ChangeNotify> may put additional limitations."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=over 4"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=item *"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "L<Win32::ChangeNotify> uses FindFirstChangeNotificationA so that"
NSQ_SOURCE_LINE 00000287 "Unicode characters can not be handled."
NSQ_SOURCE_LINE 00000288 "On cygwin (1.7 or later), Unicode characters should be able to be handled"
NSQ_SOURCE_LINE 00000289 "when L<Win32::ChangeNotify> is not used."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=item *"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "If more than 64 directories are included under the specified paths,"
NSQ_SOURCE_LINE 00000294 "an error occurrs."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=back"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "Tatsuhiko Miyagawa E<lt>miyagawa@bulknews.netE<gt>"
