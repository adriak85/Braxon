NSQ_SOURCE_LINE 00000024 "=head1 NAME"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "XString - Isolated String helpers from B"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "=head1 VERSION"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "version 0.005"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 " #!perl"
NSQ_SOURCE_LINE 00000035 " "
NSQ_SOURCE_LINE 00000036 " use strict;"
NSQ_SOURCE_LINE 00000037 " use warnings;"
NSQ_SOURCE_LINE 00000038 " "
NSQ_SOURCE_LINE 00000039 " use Test::More;"
NSQ_SOURCE_LINE 00000040 " "
NSQ_SOURCE_LINE 00000041 " use XString;"
NSQ_SOURCE_LINE 00000042 " use B;"
NSQ_SOURCE_LINE 00000043 " "
NSQ_SOURCE_LINE 00000044 " is XString::cstring( q[a'string\"with quotes] ), B::cstring( q[a'string\"with quotes] ), q[\"a'string\\\"with quotes\"];"
NSQ_SOURCE_LINE 00000045 " is XString::perlstring( q[a'string\"with quotes] ), B::perlstring( q[a'string\"with quotes] ), q[\"a'string\\\"with quotes\"];"
NSQ_SOURCE_LINE 00000046 " "
NSQ_SOURCE_LINE 00000047 " done_testing;"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "XString provides the L<B> string helpers in one isolated package."
NSQ_SOURCE_LINE 00000052 "Right now only L<cstring> and L<perlstring> are available."
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "=for markdown [![](https://github.com/atoomic/XString/workflows/linux/badge.svg)](https://github.com/atoomic/XString/actions) [![](https://github.com/atoomic/XString/workflows/macos/badge.svg)](https://github.com/atoomic/XString/actions) [![](https://github.com/atoomic/XString/workflows/windows/badge.svg)](https://github.com/atoomic/XString/actions)"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "=head2 cstring(STR)"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "Similar to B::cstring;"
NSQ_SOURCE_LINE 00000061 "Returns a double-quote-surrounded escaped version of STR which can"
NSQ_SOURCE_LINE 00000062 "be used as a string in C source code."
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=head2 perlstring(STR)"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "Similar to B::perlstring;"
NSQ_SOURCE_LINE 00000067 "Returns a double-quote-surrounded escaped version of STR which can"
NSQ_SOURCE_LINE 00000068 "be used as a string in Perl source code."
NSQ_SOURCE_LINE 00000069 ""
