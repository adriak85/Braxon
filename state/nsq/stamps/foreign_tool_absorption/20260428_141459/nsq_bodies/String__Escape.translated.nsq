BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "=head1 NAME"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "String::Escape - Backslash escapes, quoted phrase, word elision, etc."
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "=cut"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "package String::Escape;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 "use Carp;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use vars qw( $VERSION );"
NSQ_SOURCE_LINE 00000014 "$VERSION = 2010.002;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "########################################################################"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "This module provides a flexible calling interface to some frequently-performed string conversion functions, including applying and removing backslash escapes like \\n and \\t, wrapping and removing double-quotes, and truncating to fit within a desired length."
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "  use String::Escape qw( printable unprintable );"
NSQ_SOURCE_LINE 00000023 "  # Convert control, high-bit chars to \\n or \\xxx escapes"
NSQ_SOURCE_LINE 00000024 "  $output = printable($value);"
NSQ_SOURCE_LINE 00000025 "  # Convert escape sequences back to original chars"
NSQ_SOURCE_LINE 00000026 "  $value = unprintable($input);"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "  use String::Escape qw( elide );"
NSQ_SOURCE_LINE 00000029 "  # Shorten strings to fit, if necessary"
NSQ_SOURCE_LINE 00000030 "  foreach (@_) { print elide( $_, 79 ) . \"\\n\"; }"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "  use String::Escape qw( string2list list2string );"
NSQ_SOURCE_LINE 00000033 "  # Pack and unpack simple lists by quoting each item"
NSQ_SOURCE_LINE 00000034 "  $list = list2string( @list );"
NSQ_SOURCE_LINE 00000035 "  @list = string2list( $list );"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "  use String::Escape qw( escape );"
NSQ_SOURCE_LINE 00000038 "  # Defer selection of escaping routines until runtime"
NSQ_SOURCE_LINE 00000039 "  $escape_name = $use_quotes ? 'qprintable' : 'printable';"
NSQ_SOURCE_LINE 00000040 "  @escaped = escape($escape_name, @values);"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=cut"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "########################################################################"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 INTERFACE"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "All of the public functions described below are available as optional exports."
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "You can either import the specific functions you want, or import only the C<escape()> function and pass it the names of the functions to invoke."
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=cut"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "use Exporter;"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "use vars qw( @ISA @EXPORT_OK );"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "push @ISA, qw( Exporter );"
NSQ_SOURCE_LINE 00000060 "push @EXPORT_OK, qw("
NSQ_SOURCE_LINE 00000061 "\tquote unquote quote_non_words singlequote unsinglequote"
NSQ_SOURCE_LINE 00000062 "\tbackslash unbackslash qqbackslash unqqbackslash"
NSQ_SOURCE_LINE 00000063 "\tprintable unprintable qprintable unqprintable"
NSQ_SOURCE_LINE 00000064 "\tunquotemeta"
NSQ_SOURCE_LINE 00000065 "\telide"
NSQ_SOURCE_LINE 00000066 "\tescape"
NSQ_SOURCE_LINE 00000067 "\tstring2list string2hash list2string list2hash hash2string hash2list"
NSQ_SOURCE_LINE 00000068 ");"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "########################################################################"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=head2 Quoting"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "Each of these functions takes a single simple scalar argument and"
NSQ_SOURCE_LINE 00000076 "returns its escaped (or unescaped) equivalent."
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=over 4"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=item quote($value) : $escaped"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Add double quote characters to each end of the string."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=item unquote($value) : $escaped"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "If the string both begins and ends with double quote characters, they are removed, otherwise the string is returned unchanged."
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=item quote_non_words($value) : $escaped"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "As above, but only quotes empty, punctuated, and multiword values; simple values consisting of alphanumerics without special characters are not quoted."
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=item singlequote($value) : $escaped"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "Add single quote characters to each end of the string."
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=item unsinglequote($value) : $escaped"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "If the string both begins and ends with single quote characters, they are removed, otherwise the string is returned unchanged."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=back"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=cut"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "# $with_surrounding_quotes = quote( $string_value );"
NSQ_SOURCE_LINE 00000105 "sub quote ($) {"
NSQ_SOURCE_LINE 00000106 "\t'\"' . $_[0] . '\"'"
NSQ_SOURCE_LINE 00000107 "}"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "# $remove_surrounding_quotes = quote( $string_value );"
NSQ_SOURCE_LINE 00000110 "sub unquote ($) {"
NSQ_SOURCE_LINE 00000111 "\t( $_[0] =~ m/ \\A [\"] (.*) [\"] \\Z /sx ) ? $1 : $_[0];"
NSQ_SOURCE_LINE 00000112 "}"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "# $word_or_phrase_with_surrounding_quotes = quote( $string_value );"
NSQ_SOURCE_LINE 00000115 "sub quote_non_words ($) {"
NSQ_SOURCE_LINE 00000116 "\t( ! length $_[0] or $_[0] =~ /[^\\w\\_\\-\\/\\.\\:\\#]/ ) ? '\"'.$_[0].'\"' : $_[0]"
NSQ_SOURCE_LINE 00000117 "}"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "# $with_surrounding_quotes = singlequote( $string_value );"
NSQ_SOURCE_LINE 00000120 "sub singlequote ($) {"
NSQ_SOURCE_LINE 00000121 "\t'\\'' . $_[0] . '\\''"
NSQ_SOURCE_LINE 00000122 "}"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "# $remove_surrounding_quotes = singlequote( $string_value );"
NSQ_SOURCE_LINE 00000125 "sub unsinglequote ($) {"
NSQ_SOURCE_LINE 00000126 "\t( $_[0] =~ m/ \\A ['] (.*) ['] \\Z /sx ) ? $1 : $_[0];"
NSQ_SOURCE_LINE 00000127 "}"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "########################################################################"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=head2 Backslash Escaping Functions"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Each of these functions takes a single simple scalar argument and"
NSQ_SOURCE_LINE 00000135 "returns its escaped (or unescaped) equivalent."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "These functions recognize common whitespace sequences C<\\r>, C<\\n>, and C<\\t>, as well as hex escapes C<\\x4F> and ocatal C<\\020>. "
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "When escaping, alphanumeric characters and most punctuation is passed through unchanged; only the return, newline, tab, backslash, dollar, at sign and unprintable control and high-bit characters are escaped."
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=over 4"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=item backslash($value) : $escaped"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "Converts special characters to their backslash-escaped equivalents."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=item unbackslash($value) : $escaped"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "Converts backslash escape sequences in a string back to their original characters."
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "=item qqbackslash($value) : $escaped"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "Converts special characters to their backslash-escaped equivalents and then wraps the results with double quotes."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=item unqqbackslash($value) : $escaped"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Strips surrounding double quotes then converts backslash escape sequences back to their original characters."
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=back"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "Here are a few examples:"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "=over 4"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=item *"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "  print backslash( \"\\tNow is the time\\nfor all good folks\\n\" );"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "  \\tNow is the time\\nfor all good folks\\n"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=item *"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "  print unbackslash( '\\\\tNow is the time\\\\nfor all good folks\\\\n' );"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "  \tNow is the time"
NSQ_SOURCE_LINE 00000176 "  for all good folks"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=back"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=cut"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "use vars qw( %Backslashed %Interpolated );"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "# Earlier definitions are preferred to later ones, thus we output \\n not \\x0d"
NSQ_SOURCE_LINE 00000185 "_define_backslash_escapes("
NSQ_SOURCE_LINE 00000186 "\t( map { $_ => $_ } ( '\\\\', '\"', '$', '@' ) ),"
NSQ_SOURCE_LINE 00000187 "\t( 'r' => \"\\r\", 'n' => \"\\n\", 't' => \"\\t\" ),"
NSQ_SOURCE_LINE 00000188 "\t( map { 'x' . unpack('H2', chr($_)) => chr($_) } (0..255) ),"
NSQ_SOURCE_LINE 00000189 "\t( map { sprintf('%03o', $_) => chr($_) } (0..255) ),"
NSQ_SOURCE_LINE 00000190 ");"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "sub _define_backslash_escapes {"
NSQ_SOURCE_LINE 00000193 "\t%Interpolated = @_;"
NSQ_SOURCE_LINE 00000194 "\t%Backslashed  = reverse @_;"
NSQ_SOURCE_LINE 00000195 "}"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "# $special_characters_escaped = backslash( $source_string );"
NSQ_SOURCE_LINE 00000198 "sub backslash ($) {"
NSQ_SOURCE_LINE 00000199 "\tlocal $_ = ( defined $_[0] ? $_[0] : '' );"
NSQ_SOURCE_LINE 00000200 "\t# Preserve only printable ASCII characters other than \\, \", $, and @"
NSQ_SOURCE_LINE 00000201 "\ts/([^\\x20\\x21\\x24\\x25-\\x39\\x41-\\x5b\\x5d-\\x7e])/\\\\$Backslashed{$1}/gs;"
NSQ_SOURCE_LINE 00000202 "\treturn $_;"
NSQ_SOURCE_LINE 00000203 "}"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "# $original_string = unbackslash( $special_characters_escaped );"
NSQ_SOURCE_LINE 00000206 "sub unbackslash ($) {"
NSQ_SOURCE_LINE 00000207 "\tlocal $_ = ( defined $_[0] ? $_[0] : '' );"
NSQ_SOURCE_LINE 00000208 "\ts/ (\\A|\\G|[^\\\\]) [\\\\] ( [0]\\d\\d | [x][\\da-fA-F]{2} | . ) / $1 . ( $Interpolated{lc($2) }) /gsxe;"
NSQ_SOURCE_LINE 00000209 "\treturn $_;"
NSQ_SOURCE_LINE 00000210 "}"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "# quoted_and_escaped = qqbackslash( $source_string );"
NSQ_SOURCE_LINE 00000213 "sub qqbackslash ($) { quote backslash $_[0] }"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "# $original_string = unqqbackslash( quoted_and_escaped );"
NSQ_SOURCE_LINE 00000216 "sub unqqbackslash ($) { unbackslash unquote $_[0] }"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "########################################################################"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "=head2 Legacy Backslash Functions"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "In addition to the four functions listed above, there is a corresponding set which use a slightly different set of escape sequences."
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "These functions do not support as many escape sequences and use a non-standard"
NSQ_SOURCE_LINE 00000226 "format for hex escapes. In general, the above C<backslash()> functions are"
NSQ_SOURCE_LINE 00000227 "recommended, while these functions are retained for legacy compatibility"
NSQ_SOURCE_LINE 00000228 "purposes."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=over 4"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=item printable($value) : $escaped"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "Converts return, newline, tab, backslash and unprintable"
NSQ_SOURCE_LINE 00000235 "characters to their backslash-escaped equivalents."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "=item unprintable($value) : $escaped"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "Converts backslash escape sequences in a string back to their original value."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=item qprintable($value) : $escaped"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "Converts special characters to their backslash-escaped equivalents and then wraps the results with double quotes."
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "(Note that this is I<not> MIME quoted-printable encoding.)"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=item unqprintable($value) : $escaped"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "Strips surrounding double quotes then converts backslash escape sequences back to their original value."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=back"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=cut"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "use vars qw( %Printable %Unprintable );"
NSQ_SOURCE_LINE 00000256 "%Printable = ("
NSQ_SOURCE_LINE 00000257 "\t( map { chr($_), unpack('H2', chr($_)) } (0..255) ),"
NSQ_SOURCE_LINE 00000258 "\t( \"\\\\\"=>'\\\\', \"\\r\"=>'r', \"\\n\"=>'n', \"\\t\"=>'t', ),"
NSQ_SOURCE_LINE 00000259 "\t( map { $_ => $_ } ( '\"' ) )"
NSQ_SOURCE_LINE 00000260 ");"
NSQ_SOURCE_LINE 00000261 "%Unprintable = ( reverse %Printable );"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "# $special_characters_escaped = printable( $source_string );"
NSQ_SOURCE_LINE 00000264 "sub printable ($) {"
NSQ_SOURCE_LINE 00000265 "\tlocal $_ = ( defined $_[0] ? $_[0] : '' );"
NSQ_SOURCE_LINE 00000266 "\ts/([\\r\\n\\t\\\"\\\\\\x00-\\x1f\\x7F-\\xFF])/ '\\\\' . $Printable{$1} /gsxe;"
NSQ_SOURCE_LINE 00000267 "\treturn $_;"
NSQ_SOURCE_LINE 00000268 "}"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "# $original_string = unprintable( $special_characters_escaped );"
NSQ_SOURCE_LINE 00000271 "sub unprintable ($) {"
NSQ_SOURCE_LINE 00000272 "\tlocal $_ = ( defined $_[0] ? $_[0] : '' );"
NSQ_SOURCE_LINE 00000273 "\ts/((?:\\A|\\G|[^\\\\]))\\\\([rRnNtT\\\"\\\\]|[x]?[\\da-fA-F]{2})/ $1 . $Unprintable{lc($2)} /gsxe;"
NSQ_SOURCE_LINE 00000274 "\treturn $_;"
NSQ_SOURCE_LINE 00000275 "}"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "# quoted_and_escaped = qprintable( $source_string );"
NSQ_SOURCE_LINE 00000278 "sub qprintable ($) { quote_non_words printable $_[0] }"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "# $original_string = unqprintable( quoted_and_escaped );"
NSQ_SOURCE_LINE 00000281 "sub unqprintable ($) { unprintable unquote $_[0] }"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "########################################################################"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=head2 Other Backslash Functions"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "In addition to the functions listed above, there is also one function that mirrors the behavior of Perl's built-in C<quotemeta()> function."
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=over 4"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=item unquotemeta($value) : $escaped"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "Strips out backslashes before any character."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=back"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "=cut"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "sub unquotemeta ($) {"
NSQ_SOURCE_LINE 00000301 "\tlocal $_ = ( defined $_[0] ? $_[0] : '' );"
NSQ_SOURCE_LINE 00000302 "\ts/ (\\A|\\G|[^\\\\]) [\\\\] (.) / $1 . $2 /gsex;"
NSQ_SOURCE_LINE 00000303 "\treturn $_;"
NSQ_SOURCE_LINE 00000304 "}"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "########################################################################"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head2 Elision Function"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "This function extracts the leading portion of a provided string and appends ellipsis if it's longer than the desired maximum excerpt length."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "=over 4"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "=item elide($string) : $elided_string"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=item elide($string, $length) : $elided_string"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=item elide($string, $length, $word_boundary_strictness) : $elided_string"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "=item elide($string, $length, $word_boundary_strictness, $elipses) : $elided_string"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "Return a single-quoted, shortened version of the string, with ellipsis."
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "If the original string is shorter than $length, it is returned unchanged. At most $length characters are returned; if called with a single argument, $length defaults to $DefaultLength."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "Up to $word_boundary_strictness additional characters may be ommited in order to make the elided portion end on a word boundary; you can pass 0 to ignore word boundaries. If not provided, $word_boundary_strictness defaults to $DefaultStrictness."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=item $Elipses"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "The string of characters used to indicate the end of the excerpt. Initialized to '...'."
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "=item $DefaultLength"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "The default target excerpt length, used when the elide function is called with a single argument. Initialized to 60."
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=item $DefaultStrictness"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "The default word-boundary flexibility, used when the elide function is called without the third argument. Initialized to 10."
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "=back"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "Here are a few examples:"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=over 4"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "=item *"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "  $string = 'foo bar baz this that the other';"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "  print elide( $string, 12 );"
NSQ_SOURCE_LINE 00000352 "  # foo bar..."
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "  print elide( $string, 12, 0 );"
NSQ_SOURCE_LINE 00000355 "  # foo bar b..."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "  print elide( $string, 100 );"
NSQ_SOURCE_LINE 00000358 "  # foo bar baz this that the other"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "=back"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "=cut"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "use vars qw( $Elipses $DefaultLength $DefaultStrictness );"
NSQ_SOURCE_LINE 00000365 "$Elipses = '...';"
NSQ_SOURCE_LINE 00000366 "$DefaultLength = 60;"
NSQ_SOURCE_LINE 00000367 "$DefaultStrictness = 10;"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "# $elided_string = elide($string);"
NSQ_SOURCE_LINE 00000370 "# $elided_string = elide($string, $length);"
NSQ_SOURCE_LINE 00000371 "# $elided_string = elide($string, $length, $word_boundary_strictness);"
NSQ_SOURCE_LINE 00000372 "# $elided_string = elide($string, $length, $word_boundary_strictness, $elipses);"
NSQ_SOURCE_LINE 00000373 "sub elide ($;$$) {"
NSQ_SOURCE_LINE 00000374 "\tmy $source     = shift;"
NSQ_SOURCE_LINE 00000375 "\tmy $length     = scalar(@_) ? shift() : $DefaultLength;"
NSQ_SOURCE_LINE 00000376 "\tmy $word_limit = scalar(@_) ? shift() : $DefaultStrictness;"
NSQ_SOURCE_LINE 00000377 "\tmy $elipses    = scalar(@_) ? shift() : $Elipses;"
NSQ_SOURCE_LINE 00000378 "\t"
NSQ_SOURCE_LINE 00000379 "\t# If the source is already short, we don't need to do anything"
NSQ_SOURCE_LINE 00000380 "\treturn $source if (length($source) < $length);"
NSQ_SOURCE_LINE 00000381 "\t"
NSQ_SOURCE_LINE 00000382 "\t# Leave room for the elipses and make sure we include at least one character."
NSQ_SOURCE_LINE 00000383 "\t$length -= length( $elipses );"
NSQ_SOURCE_LINE 00000384 "\t$length = 1 if ( $length < 1 );"
NSQ_SOURCE_LINE 00000385 "\t"
NSQ_SOURCE_LINE 00000386 "\tmy $excerpt;"
NSQ_SOURCE_LINE 00000387 "\t"
NSQ_SOURCE_LINE 00000388 "\t# Try matching $length characters or less at a word boundary."
NSQ_SOURCE_LINE 00000389 "\t$excerpt = ( $source =~ /^(.{0,$length})(?:\\s|\\Z)/ )[0] if ( $word_limit );"
NSQ_SOURCE_LINE 00000390 "\t"
NSQ_SOURCE_LINE 00000391 "\t# If that fails or returns much less than we wanted, ignore boundaries"
NSQ_SOURCE_LINE 00000392 "\t$excerpt = substr($source, 0, $length) if ( "
NSQ_SOURCE_LINE 00000393 "\t\t! defined $excerpt or"
NSQ_SOURCE_LINE 00000394 "\t\tlength($excerpt) < length($source) and"
NSQ_SOURCE_LINE 00000395 "\t\t\t! length($excerpt) || abs($length - length($excerpt)) > $word_limit"
NSQ_SOURCE_LINE 00000396 "\t);"
NSQ_SOURCE_LINE 00000397 "\t"
NSQ_SOURCE_LINE 00000398 "\treturn $excerpt . $elipses;"
NSQ_SOURCE_LINE 00000399 "}"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "########################################################################"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "=head2 escape()"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "These functions provide for the registration of string-escape specification"
NSQ_SOURCE_LINE 00000407 "names and corresponding functions, and then allow the invocation of one or"
NSQ_SOURCE_LINE 00000408 "several of these functions on one or several source string values."
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "=over 4"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "=item escape($escapes, $value) : $escaped_value"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "=item escape($escapes, @values) : @escaped_values"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "Returns an altered copy of the provided values by looking up the escapes string in a registry of string-modification functions."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "If called in a scalar context, operates on the single value passed in; if"
NSQ_SOURCE_LINE 00000419 "called in a list contact, operates identically on each of the provided values."
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "Space-separated compound specifications like 'quoted uppercase' are expanded to a list of functions to be applied in order."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "Valid escape specifications are:"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "=over 4"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "=item one of the keys defined in %Escapes"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "The coresponding specification will be looked up and used."
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "=item a sequence of names separated by whitespace,"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "Each name will be looked up, and each of the associated functions will be applied successively, from left to right."
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "=item a reference to a function"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "The provided function will be called on with each value in turn."
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "=item a reference to an array"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "Each item in the array will be expanded as provided above."
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "=back"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "A fatal error will be generated if you pass an unsupported escape specification, or if the function is called with multiple values in a scalar context."
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "=item String::Escape::names() : @defined_escapes"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "Returns a list of defined escape specification strings."
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "=item String::Escape::add( $escape_name, \\&escape_function );"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "Add a new escape specification and corresponding function."
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=back"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "By default, all of the public functions described below are available as named escape commands, as well as the following built-in functions:"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "=over 4"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "=item *"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "none: Return the string unchanged."
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=item *"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "uppercase: Calls the built-in uc function."
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=item *"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "lowercase: Calls the built-in lc function."
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "=item *"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "initialcase: Calls the built-in lc and ucfirst functions."
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "=back"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "Here are a few examples:"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "=over 4"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "=item *"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "C<print escape('qprintable', \"\\tNow is the time\\nfor all good folks\\n\" );>"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "  \"\\tNow is the time\\nfor all good folks\\n\""
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "=item *"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "C<print escape('uppercase qprintable', \"\\tNow is the time\\nfor all good folks\\n\" );>"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "  \"\\tNOW IS THE TIME\\nFOR ALL GOOD FOLKS\\n\""
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "=item *"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "C<print join '--', escape('printable', \"\\tNow is the time\\n\", \"for all good folks\\n\" );>"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "  \\tNow is the time\\n--for all good folks\\n"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=item *"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "You can add more escaping functions to the supported set by calling add()."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "C<String::Escape::add( 'html', \\&HTML::Entities::encode_entities );>"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "C<print escape('html', \"AT&T\" );>"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "  AT&amp;T"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=back"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "=cut"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "# %Escapes - escaper function references by name"
NSQ_SOURCE_LINE 00000516 "use vars qw( %Escapes );"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "# String::Escape::add( $name, $subroutine );"
NSQ_SOURCE_LINE 00000519 "sub add {"
NSQ_SOURCE_LINE 00000520 "\twhile ( @_ ) {"
NSQ_SOURCE_LINE 00000521 "\t\tmy ( $name, $func ) = ( shift, shift );"
NSQ_SOURCE_LINE 00000522 "\t\t$Escapes{ $name } = $func"
NSQ_SOURCE_LINE 00000523 "\t}"
NSQ_SOURCE_LINE 00000524 "}"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "# @defined_names = String::Escape::names();"
NSQ_SOURCE_LINE 00000527 "sub names {"
NSQ_SOURCE_LINE 00000528 "\tkeys(%Escapes)"
NSQ_SOURCE_LINE 00000529 "}"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "# $escaped = escape($escape_spec, $value);"
NSQ_SOURCE_LINE 00000532 "# @escaped = escape($escape_spec, @values);"
NSQ_SOURCE_LINE 00000533 "sub escape {"
NSQ_SOURCE_LINE 00000534 "\tmy ($escape_spec, @values) = @_;"
NSQ_SOURCE_LINE 00000535 "\t"
NSQ_SOURCE_LINE 00000536 "\tmy @escapes = _expand_escape_spec($escape_spec);"
NSQ_SOURCE_LINE 00000537 "\t"
NSQ_SOURCE_LINE 00000538 "\tforeach my $value ( @values ) {"
NSQ_SOURCE_LINE 00000539 "\t\tforeach my $escaper ( @escapes ) {"
NSQ_SOURCE_LINE 00000540 "\t\t\t$value = &$escaper( $value );"
NSQ_SOURCE_LINE 00000541 "\t\t}"
NSQ_SOURCE_LINE 00000542 "\t}"
NSQ_SOURCE_LINE 00000543 "\t"
NSQ_SOURCE_LINE 00000544 "\tif ( wantarray ) {"
NSQ_SOURCE_LINE 00000545 "\t\t@values"
NSQ_SOURCE_LINE 00000546 "\t} elsif ( @values > 1 ) {"
NSQ_SOURCE_LINE 00000547 "\t\tcroak \"escape called with multiple values but in scalar context\""
NSQ_SOURCE_LINE 00000548 "\t} else {"
NSQ_SOURCE_LINE 00000549 "\t\t$values[0]"
NSQ_SOURCE_LINE 00000550 "\t}"
NSQ_SOURCE_LINE 00000551 "}"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "# @escape_functions = _expand_escape_spec($escape_spec);"
NSQ_SOURCE_LINE 00000554 "sub _expand_escape_spec {"
NSQ_SOURCE_LINE 00000555 "\tmy $escape_spec = shift;"
NSQ_SOURCE_LINE 00000556 "\t"
NSQ_SOURCE_LINE 00000557 "\tif ( ref($escape_spec) eq 'CODE' ) {"
NSQ_SOURCE_LINE 00000558 "\t\treturn $escape_spec;"
NSQ_SOURCE_LINE 00000559 "\t} elsif ( ref($escape_spec) eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000560 "\t\treturn map { _expand_escape_spec($_) } @$escape_spec;"
NSQ_SOURCE_LINE 00000561 "\t} elsif ( ! ref($escape_spec) ) {"
NSQ_SOURCE_LINE 00000562 "\t\treturn map {"
NSQ_SOURCE_LINE 00000563 "\t\t\t_expand_escape_spec($_)"
NSQ_SOURCE_LINE 00000564 "\t\t} map {"
NSQ_SOURCE_LINE 00000565 "\t\t\t$Escapes{$_} or _unsupported_escape_spec( $_ )"
NSQ_SOURCE_LINE 00000566 "\t\t} split(/\\s+/, $escape_spec);"
NSQ_SOURCE_LINE 00000567 "\t} else {"
NSQ_SOURCE_LINE 00000568 "\t_unsupported_escape_spec( $escape_spec );"
NSQ_SOURCE_LINE 00000569 "\t}"
NSQ_SOURCE_LINE 00000570 "}"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "# _unsupported_escape_spec($escape_spec);"
NSQ_SOURCE_LINE 00000573 "sub _unsupported_escape_spec {"
NSQ_SOURCE_LINE 00000574 "\tmy $escape_spec = shift;"
NSQ_SOURCE_LINE 00000575 "\t"
NSQ_SOURCE_LINE 00000576 "\t\tcroak("
NSQ_SOURCE_LINE 00000577 "\t\t\"unsupported escape specification \" ."
NSQ_SOURCE_LINE 00000578 "\t\t( defined($escape_spec) ? \"'$_'\" : 'undef' ) . \"; \" ."
NSQ_SOURCE_LINE 00000579 "\t\t\"should be one of \" . join(', ', names())"
NSQ_SOURCE_LINE 00000580 "\t)"
NSQ_SOURCE_LINE 00000581 "}"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "add("
NSQ_SOURCE_LINE 00000584 "\t'none'            => sub ($) { $_[0]; },"
NSQ_SOURCE_LINE 00000585 "\t"
NSQ_SOURCE_LINE 00000586 "\t'uppercase'       => sub ($) { uc $_[0] },"
NSQ_SOURCE_LINE 00000587 "\t'lowercase'       => sub ($) { lc $_[0] },"
NSQ_SOURCE_LINE 00000588 "\t'initialcase'     => sub ($) { ucfirst lc $_[0] },"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "\t'quote'           => \\&quote,"
NSQ_SOURCE_LINE 00000591 "\t'unquote'         => \\&unquote,"
NSQ_SOURCE_LINE 00000592 "\t'quote_non_words' => \\&quote_non_words,"
NSQ_SOURCE_LINE 00000593 "\t'singlequote'     => \\&singlequote,"
NSQ_SOURCE_LINE 00000594 "\t'unsinglequote'   => \\&unsinglequote,"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "\t'backslash'       => \\&backslash,"
NSQ_SOURCE_LINE 00000597 "\t'unbackslash'     => \\&unbackslash,"
NSQ_SOURCE_LINE 00000598 "\t'qqbackslash'     => \\&qqbackslash, #b"
NSQ_SOURCE_LINE 00000599 "\t'unqqbackslash'   => \\&unqqbackslash,"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "\t'printable'       => \\&printable,"
NSQ_SOURCE_LINE 00000602 "\t'unprintable'     => \\&unprintable,"
NSQ_SOURCE_LINE 00000603 "\t'qprintable'      => \\&qprintable,"
NSQ_SOURCE_LINE 00000604 "\t'unqprintable'    => \\&unqprintable,"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "\t'quotemeta'       => sub ($) { quotemeta $_[0] },"
NSQ_SOURCE_LINE 00000607 "\t'unquotemeta'     => \\&unquotemeta,"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "\t'elide'           => \\&elide,"
NSQ_SOURCE_LINE 00000610 ");"
NSQ_SOURCE_LINE 00000611 ""
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "########################################################################"
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "=head2 Space-separated Lists and Hashes"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "=over 4"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "=item @words = string2list( $space_separated_phrases );"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "Converts a space separated string of words and quoted phrases to an array;"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "=item $space_sparated_string = list2string( @words );"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "Joins an array of strings into a space separated string of words and quoted phrases;"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "=item %hash = string2hash( $string );"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "Converts a space separated string of equal-sign-associated key=value pairs into a simple hash."
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "=item $string = hash2string( %hash );"
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "Converts a simple hash into a space separated string of equal-sign-associated key=value pairs."
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "=item %hash = list2hash( @words );"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "Converts an array of equal-sign-associated key=value strings into a simple hash."
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "=item @words = hash2list( %hash );"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "Converts a hash to an array of equal-sign-associated key=value strings."
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "=back"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "Here are a few examples:"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "=over 4"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "=item *"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "C<print list2string('hello', 'I move next march');>"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "  hello \"I move next march\""
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "=item *"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "C<@list = string2list('one \"second item\" 3 \"four\\nlines\\nof\\ntext\"');>"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "C<print $list[1];>"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "  second item"
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "=item *"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "C<print hash2string( 'foo' =E<gt> 'Animal Cities', 'bar' =E<gt> 'Cheap' );>"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "  foo=\"Animal Cities\" bar=Cheap"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "=item *"
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "C<%hash = string2hash('key=value \"undefined key\" words=\"the cat in the hat\"');>"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "C<print $hash{'words'};>"
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "  the cat in the hat"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "C<print exists $hash{'undefined_key'} and ! defined $hash{'undefined_key'};>"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "  1"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "=back"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "=cut"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "# @words = string2list( $space_separated_phrases );"
NSQ_SOURCE_LINE 00000686 "sub string2list {"
NSQ_SOURCE_LINE 00000687 "\tmy $text = shift;"
NSQ_SOURCE_LINE 00000688 "\t"
NSQ_SOURCE_LINE 00000689 "\tcarp \"string2list called with a non-text argument, '$text'\" if (ref $text);"
NSQ_SOURCE_LINE 00000690 "\t"
NSQ_SOURCE_LINE 00000691 "\tmy @words;"
NSQ_SOURCE_LINE 00000692 "\tmy $word = '';"
NSQ_SOURCE_LINE 00000693 "\t"
NSQ_SOURCE_LINE 00000694 "\twhile ( length $text ) {"
NSQ_SOURCE_LINE 00000695 "\t\tif ($text =~ s/\\A(?: ([^\\\"\\s\\\\]+) | \\\\(.) )//mx) {"
NSQ_SOURCE_LINE 00000696 "\t\t\t$word .= $1;"
NSQ_SOURCE_LINE 00000697 "\t\t} elsif ($text =~ s/\\A\"((?:[^\\\"\\\\]|\\\\.)*)\"//mx) {"
NSQ_SOURCE_LINE 00000698 "\t\t\t$word .= $1;"
NSQ_SOURCE_LINE 00000699 "\t\t} elsif ($text =~ s/\\A\\s+//m){"
NSQ_SOURCE_LINE 00000700 "\t\t\tpush(@words, unprintable($word));"
NSQ_SOURCE_LINE 00000701 "\t\t\t$word = '';"
NSQ_SOURCE_LINE 00000702 "\t\t} elsif ($text =~ s/\\A\"//) {"
NSQ_SOURCE_LINE 00000703 "\t\t\tcarp \"string2list found an unmatched quote at '$text'\";"
NSQ_SOURCE_LINE 00000704 "\t\t\treturn;"
NSQ_SOURCE_LINE 00000705 "\t\t} else {"
NSQ_SOURCE_LINE 00000706 "\t\t\tcarp \"string2list parse exception at '$text'\";"
NSQ_SOURCE_LINE 00000707 "\t\t\treturn;"
NSQ_SOURCE_LINE 00000708 "\t\t}"
NSQ_SOURCE_LINE 00000709 "\t}"
NSQ_SOURCE_LINE 00000710 "\tpush(@words, unprintable($word));"
NSQ_SOURCE_LINE 00000711 "\t"
NSQ_SOURCE_LINE 00000712 "\treturn @words;"
NSQ_SOURCE_LINE 00000713 "}"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "# $space_sparated_string = list2string( @words );"
NSQ_SOURCE_LINE 00000716 "sub list2string {"
NSQ_SOURCE_LINE 00000717 "\tjoin ( ' ', map qprintable($_), @_ );"
NSQ_SOURCE_LINE 00000718 "}"
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "# %hash = list2hash( @words );"
NSQ_SOURCE_LINE 00000721 "sub list2hash {"
NSQ_SOURCE_LINE 00000722 "\tmy @pairs;"
NSQ_SOURCE_LINE 00000723 "\tforeach (@_) {"
NSQ_SOURCE_LINE 00000724 "\t\tmy ($key, $val) = m/\\A(.*?)(?:\\=(.*))?\\Z/s;"
NSQ_SOURCE_LINE 00000725 "\t\tpush @pairs, $key, $val;"
NSQ_SOURCE_LINE 00000726 "\t}"
NSQ_SOURCE_LINE 00000727 "\treturn @pairs;"
NSQ_SOURCE_LINE 00000728 "}"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "# @words = hash2list( %hash );"
NSQ_SOURCE_LINE 00000731 "sub hash2list {"
NSQ_SOURCE_LINE 00000732 "\tmy @words;"
NSQ_SOURCE_LINE 00000733 "\twhile ( scalar @_ ) {"
NSQ_SOURCE_LINE 00000734 "\t\tmy ($key, $value) = ( shift, shift );"
NSQ_SOURCE_LINE 00000735 "\t\tpush @words, qprintable($key) . '=' . qprintable($value)"
NSQ_SOURCE_LINE 00000736 "\t}"
NSQ_SOURCE_LINE 00000737 "\treturn @words;"
NSQ_SOURCE_LINE 00000738 "}"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "# %hash = string2hash( $string );"
NSQ_SOURCE_LINE 00000741 "sub string2hash {"
NSQ_SOURCE_LINE 00000742 "\treturn list2hash( string2list( shift ) );"
NSQ_SOURCE_LINE 00000743 "}"
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "# $string = hash2string( %hash );"
NSQ_SOURCE_LINE 00000746 "sub hash2string {"
NSQ_SOURCE_LINE 00000747 "\tjoin ( ' ', hash2list( @_ ) );"
NSQ_SOURCE_LINE 00000748 "}"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "########################################################################"
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "Numerous modules provide collections of string escaping functions for specific contexts."
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "The string2list function is similar to to the quotewords function in the standard distribution; see L<Text::ParseWords>."
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "Use other packages to stringify more complex data structures; see L<Storable>, L<Data::Dumper>, or other similar package."
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "=cut"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "########################################################################"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "=head1 BUGS"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "The following issues or changes are under consideration for future releases:"
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "=over 4"
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "=item *"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "Does this problem with the \\r character only show up on Windows? (And is it, in fact, a feature rather than a bug?)"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "  http://rt.cpan.org/Public/Bug/Display.html?id=19766"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "=item *"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "Consider changes to word parsing in string2list: Perhaps use \\b word-boundary test in elide's regular expression rather than \\s|\\Z? Perhaps quotes embedded in a word (eg: a@\"!a) shouldn't cause phrase breaks?"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "=item *"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "Check for possible problems in the use of printable escaping functions and list2hash. For example, are the encoded strings for hashes with high-bit characters in their keys properly unquoted and unescaped?"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "=item *"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "We should allow escape specifications to contain = signs and optional arguments, so that users can request certain string lengths with C<escape(\"lowercase elide=20 quoted\", @_>."
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "=back"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "=head1 VERSION"
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "This is version 2010.002."
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "=head1 INSTALLATION"
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "This package should run on any standard Perl 5 installation."
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "To install this package, download the distribution from a CPAN mirror,"
NSQ_SOURCE_LINE 00000804 "unpack the archive file, and execute the standard \"perl Makefile.PL\","
NSQ_SOURCE_LINE 00000805 "\"make test\", \"make install\" sequence or your local equivalent."
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "Once installed, this module's documentation is available as a"
NSQ_SOURCE_LINE 00000811 "manual page via C<perldoc String::Escape> or on CPAN sites"
NSQ_SOURCE_LINE 00000812 "such as C<http://search.cpan.org/dist/String-Escape>."
NSQ_SOURCE_LINE 00000813 ""
NSQ_SOURCE_LINE 00000814 "If you have questions or feedback about this module, please feel free to"
NSQ_SOURCE_LINE 00000815 "contact the author at the address shown below. Although there is no formal"
NSQ_SOURCE_LINE 00000816 "support program, I do attempt to answer email promptly.  Bug reports that"
NSQ_SOURCE_LINE 00000817 "contain a failing test case are greatly appreciated, and suggested patches"
NSQ_SOURCE_LINE 00000818 "will be promptly considered for inclusion in future releases."
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "You can report bugs and request features via the CPAN web tracking system"
NSQ_SOURCE_LINE 00000821 "at C<http://rt.cpan.org/NoAuth/ReportBug.html?Queue=String-Escape> or by "
NSQ_SOURCE_LINE 00000822 "sending mail to C<bug-string-escape at rt.cpan.org>."
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "If you've found this module useful or have feedback about your"
NSQ_SOURCE_LINE 00000825 "experience with it, consider sharing your opinion with other Perl users"
NSQ_SOURCE_LINE 00000826 "by posting your comment to CPAN's ratings system"
NSQ_SOURCE_LINE 00000827 "(C<http://cpanratings.perl.org/rate/?distribution=String-Escape>)."
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "For more general discussion, you may wish to post a message on PerlMonks"
NSQ_SOURCE_LINE 00000830 "(C<http://perlmonks.org/?node=Seekers%20of%20Perl%20Wisdom>) or on the"
NSQ_SOURCE_LINE 00000831 "comp.lang.perl.misc newsgroup"
NSQ_SOURCE_LINE 00000832 "(C<http://groups.google.com/group/comp.lang.perl.misc/topics>)."
