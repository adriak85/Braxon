NSQ_SOURCE_LINE 00000001 "package Sub::Iterator;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2015-01-17'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.01'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter;"
NSQ_SOURCE_LINE 00000011 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000013 "                       gen_array_iterator"
NSQ_SOURCE_LINE 00000014 "                       gen_fh_iterator"
NSQ_SOURCE_LINE 00000015 "               );"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "sub gen_array_iterator {"
NSQ_SOURCE_LINE 00000018 "    my $array = shift;"
NSQ_SOURCE_LINE 00000019 "    my $i = 0;"
NSQ_SOURCE_LINE 00000020 "    return sub {"
NSQ_SOURCE_LINE 00000021 "        if ($i >= @$array) { undef } else { $array->[$i++] }"
NSQ_SOURCE_LINE 00000022 "    };"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub gen_fh_iterator {"
NSQ_SOURCE_LINE 00000026 "    my $fh = shift;"
NSQ_SOURCE_LINE 00000027 "    return sub {"
NSQ_SOURCE_LINE 00000028 "        if (eof($fh)) { undef } else { ~~<$fh> }"
NSQ_SOURCE_LINE 00000029 "    };"
NSQ_SOURCE_LINE 00000030 "}"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "1;"
NSQ_SOURCE_LINE 00000033 "# ABSTRACT: Generate iterator coderefs"
NSQ_SOURCE_LINE 00000034 ""
