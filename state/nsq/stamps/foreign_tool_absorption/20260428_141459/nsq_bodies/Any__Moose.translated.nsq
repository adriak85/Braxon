NSQ_SOURCE_LINE 00000001 "package Any::Moose; # git description: v0.26-20-g4c2f951"
NSQ_SOURCE_LINE 00000002 "# ABSTRACT: (DEPRECATED) use Moo instead!"
NSQ_SOURCE_LINE 00000003 "# KEYWORDS: deprecated Moose Mouse abstraction layer object-oriented"
NSQ_SOURCE_LINE 00000004 "# vim: set ts=8 sts=4 sw=4 tw=115 et :"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.006_002;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $VERSION = '0.27';"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "warnings::warnif('deprecated', 'Any::Moose is deprecated. Please use Moo instead');"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# decide which backend to use"
NSQ_SOURCE_LINE 00000015 "our $PREFERRED;"
NSQ_SOURCE_LINE 00000016 "do {"
NSQ_SOURCE_LINE 00000017 "    local $@;"
NSQ_SOURCE_LINE 00000018 "    if ($ENV{ANY_MOOSE}) {"
NSQ_SOURCE_LINE 00000019 "        $PREFERRED = $ENV{'ANY_MOOSE'};"
NSQ_SOURCE_LINE 00000020 "        warn \"ANY_MOOSE is not set to Moose or Mouse\""
NSQ_SOURCE_LINE 00000021 "            unless $PREFERRED eq 'Moose'"
NSQ_SOURCE_LINE 00000022 "                || $PREFERRED eq 'Mouse';"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "        # if we die here, then perl gives \"unknown error\" which doesn't tell"
NSQ_SOURCE_LINE 00000025 "        # you what the problem is at all. argh."
NSQ_SOURCE_LINE 00000026 "        if ($PREFERRED eq 'Moose' && !eval { require Moose }) {"
NSQ_SOURCE_LINE 00000027 "            warn \"\\$ANY_MOOSE is set to Moose but we cannot load it\";"
NSQ_SOURCE_LINE 00000028 "        }"
NSQ_SOURCE_LINE 00000029 "        elsif ($PREFERRED eq 'Mouse' && !eval { require Mouse }) {"
NSQ_SOURCE_LINE 00000030 "            warn \"\\$ANY_MOOSE is set to Mouse but we cannot load it\";"
NSQ_SOURCE_LINE 00000031 "        }"
NSQ_SOURCE_LINE 00000032 "    }"
NSQ_SOURCE_LINE 00000033 "    elsif ( $INC{'Moo.pm'} && eval { require Moose } ) {"
NSQ_SOURCE_LINE 00000034 "        $PREFERRED = 'Moose';"
NSQ_SOURCE_LINE 00000035 "    }"
NSQ_SOURCE_LINE 00000036 "    elsif (_is_moose_loaded()) {"
NSQ_SOURCE_LINE 00000037 "        $PREFERRED = 'Moose';"
NSQ_SOURCE_LINE 00000038 "    }"
NSQ_SOURCE_LINE 00000039 "    elsif (eval { require Mouse; require Mouse::Util; Mouse::Util->can('get_metaclass_by_name') }) {"
NSQ_SOURCE_LINE 00000040 "        $PREFERRED = 'Mouse';"
NSQ_SOURCE_LINE 00000041 "    }"
NSQ_SOURCE_LINE 00000042 "    elsif (eval { require Moose }) {"
NSQ_SOURCE_LINE 00000043 "        $PREFERRED = 'Moose';"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 "    else {"
NSQ_SOURCE_LINE 00000046 "        require Carp;"
NSQ_SOURCE_LINE 00000047 "        warn \"Unable to locate Mouse or Moose in INC\";"
NSQ_SOURCE_LINE 00000048 "    }"
NSQ_SOURCE_LINE 00000049 "};"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "sub import {"
NSQ_SOURCE_LINE 00000052 "    my $self = shift;"
NSQ_SOURCE_LINE 00000053 "    my $pkg  = caller;"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    # Any::Moose gives you strict and warnings"
NSQ_SOURCE_LINE 00000056 "    strict->import;"
NSQ_SOURCE_LINE 00000057 "    warnings->import;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    # first options are for Mo*se"
NSQ_SOURCE_LINE 00000060 "    unshift @_, 'Moose' if !@_ || ref($_[0]);"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    while (my $module = shift) {"
NSQ_SOURCE_LINE 00000063 "        my $options = @_ && ref($_[0]) ? shift : [];"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "        $options = $self->_canonicalize_options("
NSQ_SOURCE_LINE 00000066 "            module  => $module,"
NSQ_SOURCE_LINE 00000067 "            options => $options,"
NSQ_SOURCE_LINE 00000068 "            package => $pkg,"
NSQ_SOURCE_LINE 00000069 "        );"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "        $self->_install_module($options);"
NSQ_SOURCE_LINE 00000072 "    }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    # give them any_moose too"
NSQ_SOURCE_LINE 00000075 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000076 "    *{$pkg.'::any_moose'} = \\&any_moose;"
NSQ_SOURCE_LINE 00000077 "}"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "sub unimport {"
NSQ_SOURCE_LINE 00000080 "    my $sel = shift;"
NSQ_SOURCE_LINE 00000081 "    my $pkg = caller;"
NSQ_SOURCE_LINE 00000082 "    my $module;"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    if(@_){"
NSQ_SOURCE_LINE 00000085 "        $module = any_moose(shift, $pkg);"
NSQ_SOURCE_LINE 00000086 "    }"
NSQ_SOURCE_LINE 00000087 "    else {"
NSQ_SOURCE_LINE 00000088 "        $module = _backer_of($pkg);"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 "    my $e = do{"
NSQ_SOURCE_LINE 00000091 "        local $@;"
NSQ_SOURCE_LINE 00000092 "        eval \"package $pkg;\\n\""
NSQ_SOURCE_LINE 00000093 "           . '$module->unimport();';"
NSQ_SOURCE_LINE 00000094 "        $@;"
NSQ_SOURCE_LINE 00000095 "   };"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "   if ($e) {"
NSQ_SOURCE_LINE 00000098 "        require Carp;"
NSQ_SOURCE_LINE 00000099 "        Carp::croak(\"Cannot unimport Any::Moose: $e\");"
NSQ_SOURCE_LINE 00000100 "   }"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "   return;"
NSQ_SOURCE_LINE 00000103 "}"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "sub _backer_of {"
NSQ_SOURCE_LINE 00000106 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "    if(exists $INC{'Mouse.pm'}"
NSQ_SOURCE_LINE 00000109 "        and Mouse::Util->can('get_metaclass_by_name')"
NSQ_SOURCE_LINE 00000110 "      ){"
NSQ_SOURCE_LINE 00000111 "        my $meta = Mouse::Util::get_metaclass_by_name($pkg);"
NSQ_SOURCE_LINE 00000112 "        if ($meta) {"
NSQ_SOURCE_LINE 00000113 "            return 'Mouse::Role' if $meta->isa('Mouse::Meta::Role');"
NSQ_SOURCE_LINE 00000114 "            return 'Mouse'       if $meta->isa('Mouse::Meta::Class');"
NSQ_SOURCE_LINE 00000115 "       }"
NSQ_SOURCE_LINE 00000116 "    }"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    if (_is_moose_loaded()) {"
NSQ_SOURCE_LINE 00000119 "        my $meta = Class::MOP::get_metaclass_by_name($pkg);"
NSQ_SOURCE_LINE 00000120 "        if ($meta) {"
NSQ_SOURCE_LINE 00000121 "            return 'Moose::Role' if $meta->isa('Moose::Meta::Role');"
NSQ_SOURCE_LINE 00000122 "            return 'Moose'       if $meta->isa('Moose::Meta::Class');"
NSQ_SOURCE_LINE 00000123 "        }"
NSQ_SOURCE_LINE 00000124 "    }"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "    return undef;"
NSQ_SOURCE_LINE 00000127 "}"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "sub _canonicalize_options {"
NSQ_SOURCE_LINE 00000130 "    my $self = shift;"
NSQ_SOURCE_LINE 00000131 "    my %args = @_;"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    my %options;"
NSQ_SOURCE_LINE 00000134 "    if (ref($args{options}) eq 'HASH') {"
NSQ_SOURCE_LINE 00000135 "        %options = %{ $args{options} };"
NSQ_SOURCE_LINE 00000136 "    }"
NSQ_SOURCE_LINE 00000137 "    else {"
NSQ_SOURCE_LINE 00000138 "        %options = ("
NSQ_SOURCE_LINE 00000139 "            imports => $args{options},"
NSQ_SOURCE_LINE 00000140 "        );"
NSQ_SOURCE_LINE 00000141 "    }"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    $options{package} = $args{package};"
NSQ_SOURCE_LINE 00000144 "    $options{module}  = any_moose($args{module}, $args{package});"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    return \\%options;"
NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "sub _install_module {"
NSQ_SOURCE_LINE 00000150 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000151 "    my $options = shift;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    my $module = $options->{module};"
NSQ_SOURCE_LINE 00000154 "    (my $file = $module . '.pm') =~ s{::}{/}g;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    require $file;"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    my $e = do {"
NSQ_SOURCE_LINE 00000159 "        local $@;"
NSQ_SOURCE_LINE 00000160 "        eval \"package $options->{package};\\n\""
NSQ_SOURCE_LINE 00000161 "           . '$module->import(@{ $options->{imports} });';"
NSQ_SOURCE_LINE 00000162 "        $@;"
NSQ_SOURCE_LINE 00000163 "    };"
NSQ_SOURCE_LINE 00000164 "    if ($e) {"
NSQ_SOURCE_LINE 00000165 "        require Carp;"
NSQ_SOURCE_LINE 00000166 "        Carp::croak(\"Cannot import Any::Moose: $e\");"
NSQ_SOURCE_LINE 00000167 "    }"
NSQ_SOURCE_LINE 00000168 "    return;"
NSQ_SOURCE_LINE 00000169 "}"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "sub any_moose {"
NSQ_SOURCE_LINE 00000172 "    my $fragment = _canonicalize_fragment(shift);"
NSQ_SOURCE_LINE 00000173 "    my $package  = shift || caller;"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    # Mouse gets first dibs because it doesn't introspect existing classes"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    my $backer = _backer_of($package) || '';"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    if ($backer =~ /^Mouse/) {"
NSQ_SOURCE_LINE 00000180 "        $fragment =~ s/^Moose/Mouse/;"
NSQ_SOURCE_LINE 00000181 "        return $fragment;"
NSQ_SOURCE_LINE 00000182 "    }"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "    return $fragment if $backer =~ /^Moose/;"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "    $fragment =~ s/^Moose/Mouse/ if mouse_is_preferred();"
NSQ_SOURCE_LINE 00000187 "    return $fragment;"
NSQ_SOURCE_LINE 00000188 "}"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "for my $name (qw/"
NSQ_SOURCE_LINE 00000191 "    load_class"
NSQ_SOURCE_LINE 00000192 "    is_class_loaded"
NSQ_SOURCE_LINE 00000193 "    class_of"
NSQ_SOURCE_LINE 00000194 "    get_metaclass_by_name"
NSQ_SOURCE_LINE 00000195 "    get_all_metaclass_instances"
NSQ_SOURCE_LINE 00000196 "    get_all_metaclass_names"
NSQ_SOURCE_LINE 00000197 "    load_first_existing_class"
NSQ_SOURCE_LINE 00000198 "        /) {"
NSQ_SOURCE_LINE 00000199 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000200 "    *{__PACKAGE__.\"::$name\"} = moose_is_preferred()"
NSQ_SOURCE_LINE 00000201 "        ? *{\"Class::MOP::$name\"}"
NSQ_SOURCE_LINE 00000202 "        : *{\"Mouse::Util::$name\"};"
NSQ_SOURCE_LINE 00000203 "}"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "sub moose_is_preferred { $PREFERRED eq 'Moose' }"
NSQ_SOURCE_LINE 00000206 "sub mouse_is_preferred { $PREFERRED eq 'Mouse' }"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "sub _is_moose_loaded { exists $INC{'Moose.pm'} }"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "sub is_moose_loaded {"
NSQ_SOURCE_LINE 00000211 "    warnings::warnif('deprecated', \"Any::Moose::is_moose_loaded is deprecated. Please use Any::Moose::moose_is_preferred instead\");"
NSQ_SOURCE_LINE 00000212 "    goto \\&_is_moose_loaded;"
NSQ_SOURCE_LINE 00000213 "}"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "sub _canonicalize_fragment {"
NSQ_SOURCE_LINE 00000216 "    my $fragment = shift;"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "    return 'Moose' if !$fragment;"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "    # any_moose(\"X::Types\") -> any_moose(\"MooseX::Types\")"
NSQ_SOURCE_LINE 00000221 "    $fragment =~ s/^X::/MooseX::/;"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "    # any_moose(\"::Util\") -> any_moose(\"Moose::Util\")"
NSQ_SOURCE_LINE 00000224 "    $fragment =~ s/^::/Moose::/;"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "    # any_moose(\"Mouse::Util\") -> any_moose(\"Moose::Util\")"
NSQ_SOURCE_LINE 00000227 "    $fragment =~ s/^Mouse(X?)\\b/Moose$1/;"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "    # any_moose(\"Util\") -> any_moose(\"Moose::Util\")"
NSQ_SOURCE_LINE 00000230 "    $fragment =~ s/^(?!Moose)/Moose::/;"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    return $fragment;"
NSQ_SOURCE_LINE 00000233 "}"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "1;"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "__END__"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "=pod"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head1 NAME"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "Any::Moose - (DEPRECATED) use Moo instead!"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head1 VERSION"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "version 0.27"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=head1 DEPRECATION"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "日本語翻訳: http://blog.64p.org/entry/2013/02/06/094906"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "Please use L<Moo> instead of Any::Moose for new code."
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "Moo classes and roles will transparently and correctly upgrade to"
NSQ_SOURCE_LINE 00000258 "Moose when needed. This is a fundamentally better design than what"
NSQ_SOURCE_LINE 00000259 "Any::Moose offers. Mouse metaclasses do not interact with Moose"
NSQ_SOURCE_LINE 00000260 "metaclasses which leaks abstractions all over the place."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "Any::Moose had a good run. It was a simplistic but expedient answer"
NSQ_SOURCE_LINE 00000263 "for getting Moose syntax on the cheap but with the transparent"
NSQ_SOURCE_LINE 00000264 "upgrade path to Moose when you needed it. But really, please don't"
NSQ_SOURCE_LINE 00000265 "use it any more. :)"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "You may find L<MooX::late> useful for porting your code from"
NSQ_SOURCE_LINE 00000268 "Any::Moose to Moo."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "For the sparse documentation Any::Moose used to include, see"
NSQ_SOURCE_LINE 00000271 "L<https://metacpan.org/module/SARTAK/Any-Moose-0.18/lib/Any/Moose.pm>"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Bugs may be submitted through L<the RT bug tracker|https://rt.cpan.org/Public/Dist/Display.html?Name=Any-Moose>"
NSQ_SOURCE_LINE 00000276 "(or L<bug-Any-Moose@rt.cpan.org|mailto:bug-Any-Moose@rt.cpan.org>)."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "There is also a mailing list available for users of this distribution, at"
NSQ_SOURCE_LINE 00000279 "L<http://lists.perl.org/list/moose.html>."
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "There is also an irc channel available for users of this distribution, at"
NSQ_SOURCE_LINE 00000282 "L<C<#moose> on C<irc.perl.org>|irc://irc.perl.org/#moose>."
NSQ_SOURCE_LINE 00000283 ""
