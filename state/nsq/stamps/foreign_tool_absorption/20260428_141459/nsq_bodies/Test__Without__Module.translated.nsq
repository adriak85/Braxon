NSQ_SOURCE_LINE 00000001 "package Test::Without::Module;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use Carp qw( croak );"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use vars qw( $VERSION );"
NSQ_SOURCE_LINE 00000006 "$VERSION = '0.23';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use vars qw(%forbidden);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "sub get_forbidden_list {"
NSQ_SOURCE_LINE 00000011 "  \\%forbidden"
NSQ_SOURCE_LINE 00000012 "};"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub import {"
NSQ_SOURCE_LINE 00000015 "  my ($self,@forbidden_modules) = @_;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "  my $forbidden = get_forbidden_list;"
NSQ_SOURCE_LINE 00000018 "  "
NSQ_SOURCE_LINE 00000019 "  for (@forbidden_modules) {"
NSQ_SOURCE_LINE 00000020 "      my $file = module2file($_);"
NSQ_SOURCE_LINE 00000021 "      $forbidden->{$file} = delete $INC{$file};"
NSQ_SOURCE_LINE 00000022 "  };"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "  # Scrub %INC, so that loaded modules disappear"
NSQ_SOURCE_LINE 00000025 "  for my $module (@forbidden_modules) {"
NSQ_SOURCE_LINE 00000026 "    scrub( $module );"
NSQ_SOURCE_LINE 00000027 "  };"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "  @INC = (\\&fake_module, grep { !ref || $_ != \\&fake_module } @INC);"
NSQ_SOURCE_LINE 00000030 "};"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub fake_module {"
NSQ_SOURCE_LINE 00000033 "    my ($self,$module_file,$member_only) = @_;"
NSQ_SOURCE_LINE 00000034 "    # Don't touch $@, or .al files will not load anymore????"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    if (exists get_forbidden_list->{$module_file}) {"
NSQ_SOURCE_LINE 00000037 "      my $module_name = file2module($module_file);"
NSQ_SOURCE_LINE 00000038 "      croak \"Can't locate $module_file in \\@INC (you may need to install the $module_name module) (\\@INC contains: @INC)\";"
NSQ_SOURCE_LINE 00000039 "    };"
NSQ_SOURCE_LINE 00000040 "};"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "sub unimport {"
NSQ_SOURCE_LINE 00000043 "  my ($self,@list) = @_;"
NSQ_SOURCE_LINE 00000044 "  my $module;"
NSQ_SOURCE_LINE 00000045 "  my $forbidden = get_forbidden_list;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "  for $module (@list) {"
NSQ_SOURCE_LINE 00000048 "    my $file = module2file($module);"
NSQ_SOURCE_LINE 00000049 "    if (exists $forbidden->{$file}) {"
NSQ_SOURCE_LINE 00000050 "      my $path = delete $forbidden->{$file};"
NSQ_SOURCE_LINE 00000051 "      if (defined $path) {"
NSQ_SOURCE_LINE 00000052 "        $INC{ $file } = $path;"
NSQ_SOURCE_LINE 00000053 "      }"
NSQ_SOURCE_LINE 00000054 "    } else {"
NSQ_SOURCE_LINE 00000055 "      croak \"Can't allow non-forbidden module $module\";"
NSQ_SOURCE_LINE 00000056 "    };"
NSQ_SOURCE_LINE 00000057 "  };"
NSQ_SOURCE_LINE 00000058 "};"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub file2module {"
NSQ_SOURCE_LINE 00000061 "  my ($mod) = @_;"
NSQ_SOURCE_LINE 00000062 "  $mod =~ s!/!::!g;"
NSQ_SOURCE_LINE 00000063 "  $mod =~ s!\\.pm$!!;"
NSQ_SOURCE_LINE 00000064 "  $mod;"
NSQ_SOURCE_LINE 00000065 "};"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "sub module2file {"
NSQ_SOURCE_LINE 00000068 "  my ($mod) = @_;"
NSQ_SOURCE_LINE 00000069 "  $mod =~ s!::|'!/!g;"
NSQ_SOURCE_LINE 00000070 "  $mod .= \".pm\";"
NSQ_SOURCE_LINE 00000071 "  $mod;"
NSQ_SOURCE_LINE 00000072 "};"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub scrub {"
NSQ_SOURCE_LINE 00000075 "  my ($module) = @_;"
NSQ_SOURCE_LINE 00000076 "  delete $INC{module2file($module)};"
NSQ_SOURCE_LINE 00000077 "};"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "1;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "=head1 NAME"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "Test::Without::Module - Test fallback behaviour in absence of modules"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    use Test::Without::Module qw( My::Module );"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "    # Now, loading of My::Module fails :"
NSQ_SOURCE_LINE 00000090 "    eval { require My::Module; };"
NSQ_SOURCE_LINE 00000091 "    warn $@ if $@;"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    # Now it works again"
NSQ_SOURCE_LINE 00000094 "    eval q{ no Test::Without::Module qw( My::Module ) };"
NSQ_SOURCE_LINE 00000095 "    eval { require My::Module; };"
NSQ_SOURCE_LINE 00000096 "    print \"Found My::Module\" unless $@;"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "This module allows you to deliberately hide modules from a program"
NSQ_SOURCE_LINE 00000101 "even though they are installed. This is mostly useful for testing modules"
NSQ_SOURCE_LINE 00000102 "that have a fallback when a certain dependency module is not installed."
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=head2 EXPORT"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "None. All magic is done via C<use Test::Without::Module LIST> and"
NSQ_SOURCE_LINE 00000107 "C<no Test::Without::Module LIST>."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=head2 Test::Without::Module::get_forbidden_list"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "This function returns a reference to a copy of the current hash of forbidden"
NSQ_SOURCE_LINE 00000112 "modules or an empty hash if none are currently forbidden. This is convenient"
NSQ_SOURCE_LINE 00000113 "if you are testing and/or debugging this module."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=cut"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=head1 ONE LINER"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "A neat trick for using this module from the command line"
NSQ_SOURCE_LINE 00000120 "was mentioned to me by NUFFIN and by Jerrad Pierce:"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "  perl -MTest::Without::Module=Some::Module -w -Iblib/lib t/SomeModule.t"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "That way, you can easily see how your module or test file behaves"
NSQ_SOURCE_LINE 00000125 "when a certain module is unavailable."
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=head1 BUGS"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "=over 4"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=item *"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "There is no lexical scoping"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=back"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=head1 CREDITS"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "Much improvement must be thanked to Aristotle from PerlMonks, he pointed me"
NSQ_SOURCE_LINE 00000140 "to a much less convoluted way to fake a module at"
NSQ_SOURCE_LINE 00000141 "L<https://perlmonks.org?node=192635>."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "I also discussed with him an even more elegant way of overriding"
NSQ_SOURCE_LINE 00000144 "CORE::GLOBAL::require, but the parsing of the overridden subroutine"
NSQ_SOURCE_LINE 00000145 "didn't work out the way I wanted it - CORE::require didn't recognize"
NSQ_SOURCE_LINE 00000146 "barewords as such anymore."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "NUFFIN and Jerrad Pierce pointed out the convenient"
NSQ_SOURCE_LINE 00000149 "use from the command line to interactively watch the"
NSQ_SOURCE_LINE 00000150 "behaviour of the test suite and module in absence"
NSQ_SOURCE_LINE 00000151 "of a module."
NSQ_SOURCE_LINE 00000152 ""
