NSQ_SOURCE_LINE 00000001 "package LWP::Protocol::Patch::CountBytesIn;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2019-10-05'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.001'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000008 "no warnings;"
NSQ_SOURCE_LINE 00000009 "use Log::ger;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Module::Patch ();"
NSQ_SOURCE_LINE 00000012 "use base qw(Module::Patch);"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "use Scalar::Util qw(refaddr);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our %config;"
NSQ_SOURCE_LINE 00000017 "our $bytes_in = 0;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "sub _get_byte_size {"
NSQ_SOURCE_LINE 00000020 "    my($self, @strings) = @_;"
NSQ_SOURCE_LINE 00000021 "    my $bytes = 0;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    {"
NSQ_SOURCE_LINE 00000024 "        use bytes;"
NSQ_SOURCE_LINE 00000025 "        for my $string (@strings) {"
NSQ_SOURCE_LINE 00000026 "            $bytes += length($string);"
NSQ_SOURCE_LINE 00000027 "        }"
NSQ_SOURCE_LINE 00000028 "    }"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    return $bytes;"
NSQ_SOURCE_LINE 00000031 "}"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "sub _wrap_collect {"
NSQ_SOURCE_LINE 00000034 "    my $ctx = shift;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    my ($self, $arg, $response, $collector) = @_;"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    push @{ $response->{handlers}{response_data} }, {"
NSQ_SOURCE_LINE 00000039 "        callback => sub {"
NSQ_SOURCE_LINE 00000040 "            $bytes_in += _get_byte_size(__PACKAGE__, $_[3]);"
NSQ_SOURCE_LINE 00000041 "        },"
NSQ_SOURCE_LINE 00000042 "    };"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "    $ctx->{orig}->(@_);"
NSQ_SOURCE_LINE 00000045 "}"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "sub patch_data {"
NSQ_SOURCE_LINE 00000048 "    return {"
NSQ_SOURCE_LINE 00000049 "        v => 3,"
NSQ_SOURCE_LINE 00000050 "        config => {"
NSQ_SOURCE_LINE 00000051 "        },"
NSQ_SOURCE_LINE 00000052 "        patches => ["
NSQ_SOURCE_LINE 00000053 "            {"
NSQ_SOURCE_LINE 00000054 "                action => 'wrap',"
NSQ_SOURCE_LINE 00000055 "                #mod_version => qr/^6\\./,"
NSQ_SOURCE_LINE 00000056 "                sub_name => 'collect',"
NSQ_SOURCE_LINE 00000057 "                code => \\&_wrap_collect,"
NSQ_SOURCE_LINE 00000058 "            },"
NSQ_SOURCE_LINE 00000059 "        ],"
NSQ_SOURCE_LINE 00000060 "    };"
NSQ_SOURCE_LINE 00000061 "}"
NSQ_SOURCE_LINE 00000062 ""
