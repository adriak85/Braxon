NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "# fields"
NSQ_SOURCE_LINE 00000791 "#"
NSQ_SOURCE_LINE 00000792 "#   object method returning the result of the most recent parse () or the"
NSQ_SOURCE_LINE 00000793 "#   input to the most recent combine (), whichever is more recent.  there"
NSQ_SOURCE_LINE 00000794 "#   are no side-effects."
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "sub fields {"
NSQ_SOURCE_LINE 00000797 "    my $self = shift;"
