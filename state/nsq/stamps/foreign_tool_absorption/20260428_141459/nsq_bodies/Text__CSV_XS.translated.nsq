NSQ_SOURCE_LINE 00000125 "my $last_err = Text::CSV_XS->SetDiag (0);"
NSQ_SOURCE_LINE 00000126 "my $ebcdic   = ord (\"A\") == 0xC1;\t# Faster than $Config{'ebcdic'}"
NSQ_SOURCE_LINE 00000127 "my @internal_kh;"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "# NOT a method: is also used before bless"
NSQ_SOURCE_LINE 00000130 "sub _unhealthy_whitespace {"
NSQ_SOURCE_LINE 00000131 "    my ($self, $aw) = @_;"
NSQ_SOURCE_LINE 00000132 "    $aw or return 0; # no checks needed without allow_whitespace"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "    my $quo = $self->{'quote'};"
NSQ_SOURCE_LINE 00000135 "    defined $quo && length ($quo) or $quo = $self->{'quote_char'};"
NSQ_SOURCE_LINE 00000136 "    my $esc = $self->{'escape_char'};"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "    defined $quo && $quo =~ m/^[ \\t]/ and return 1002;"
NSQ_SOURCE_LINE 00000139 "    defined $esc && $esc =~ m/^[ \\t]/ and return 1002;"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    return 0;"
NSQ_SOURCE_LINE 00000142 "    } # _unhealty_whitespace"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "sub _check_sanity {"
NSQ_SOURCE_LINE 00000145 "    my $self = shift;"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    my $eol = $self->{'eol'};"
NSQ_SOURCE_LINE 00000148 "    my $sep = $self->{'sep'};"
NSQ_SOURCE_LINE 00000149 "    defined $sep && length ($sep) or $sep = $self->{'sep_char'};"
NSQ_SOURCE_LINE 00000150 "    my $quo = $self->{'quote'};"
NSQ_SOURCE_LINE 00000151 "    defined $quo && length ($quo) or $quo = $self->{'quote_char'};"
NSQ_SOURCE_LINE 00000152 "    my $esc = $self->{'escape_char'};"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "#    use DP;::diag (\"SEP: '\", DPeek ($sep),"
NSQ_SOURCE_LINE 00000155 "#\t        \"', QUO: '\", DPeek ($quo),"
NSQ_SOURCE_LINE 00000156 "#\t        \"', ESC: '\", DPeek ($esc),\"'\");"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    # sep_char should not be undefined"
NSQ_SOURCE_LINE 00000159 "    $sep ne \"\"\t\t\tor  return 1008;"
NSQ_SOURCE_LINE 00000160 "    length ($sep) > 16\t\tand return 1006;"
NSQ_SOURCE_LINE 00000161 "    $sep =~ m/[\\r\\n]/\t\tand return 1003;"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    if (defined $quo) {"
NSQ_SOURCE_LINE 00000164 "\t$quo eq $sep\t\tand return 1001;"
NSQ_SOURCE_LINE 00000165 "\tlength ($quo) > 16\tand return 1007;"
NSQ_SOURCE_LINE 00000166 "\t$quo =~ m/[\\r\\n]/\tand return 1003;"
NSQ_SOURCE_LINE 00000167 "\t}"
NSQ_SOURCE_LINE 00000168 "    if (defined $esc) {"
NSQ_SOURCE_LINE 00000169 "\t$esc eq $sep\t\tand return 1001;"
NSQ_SOURCE_LINE 00000170 "\t$esc =~ m/[\\r\\n]/\tand return 1003;"
NSQ_SOURCE_LINE 00000171 "\t}"
NSQ_SOURCE_LINE 00000172 "    if (defined $eol) {"
NSQ_SOURCE_LINE 00000173 "\tlength ($eol) > 16\tand return 1005;"
NSQ_SOURCE_LINE 00000174 "\t}"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    return _unhealthy_whitespace ($self, $self->{'allow_whitespace'});"
NSQ_SOURCE_LINE 00000177 "    } # _check_sanity"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "sub known_attributes {"
NSQ_SOURCE_LINE 00000180 "    sort grep !m/^_/ => \"sep\", \"quote\", keys %def_attr;"
NSQ_SOURCE_LINE 00000181 "    } # known_attributes"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "sub new {"
NSQ_SOURCE_LINE 00000184 "    $last_err = Text::CSV_XS->SetDiag (1000,"
NSQ_SOURCE_LINE 00000185 "\t\"usage: my \\$csv = Text::CSV_XS->new ([{ option => value, ... }]);\");"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "    my $proto = shift;"
NSQ_SOURCE_LINE 00000188 "    my $class = ref $proto || $proto\tor  return;"
NSQ_SOURCE_LINE 00000189 "    @_ > 0 &&   ref $_[0] ne \"HASH\"\tand return;"
NSQ_SOURCE_LINE 00000190 "    my $attr  = shift || {};"
NSQ_SOURCE_LINE 00000191 "    my %attr  = map {"
NSQ_SOURCE_LINE 00000192 "\tmy $k = m/^[a-zA-Z]\\w+$/ ? lc $_ : $_;"
NSQ_SOURCE_LINE 00000193 "\texists $attr_alias{$k} and $k = $attr_alias{$k};"
NSQ_SOURCE_LINE 00000194 "\t($k => $attr->{$_});"
NSQ_SOURCE_LINE 00000195 "\t} keys %{$attr};"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "    my $sep_aliased = 0;"
NSQ_SOURCE_LINE 00000198 "    if (exists $attr{'sep'}) {"
NSQ_SOURCE_LINE 00000199 "\t$attr{'sep_char'} = delete $attr{'sep'};"
NSQ_SOURCE_LINE 00000200 "\t$sep_aliased = 1;"
NSQ_SOURCE_LINE 00000201 "\t}"
NSQ_SOURCE_LINE 00000202 "    my $quote_aliased = 0;"
NSQ_SOURCE_LINE 00000203 "    if (exists $attr{'quote'}) {"
NSQ_SOURCE_LINE 00000204 "\t$attr{'quote_char'} = delete $attr{'quote'};"
NSQ_SOURCE_LINE 00000205 "\t$quote_aliased = 1;"
NSQ_SOURCE_LINE 00000206 "\t}"
NSQ_SOURCE_LINE 00000207 "    exists $attr{'formula_handling'} and"
NSQ_SOURCE_LINE 00000208 "\t$attr{'formula'} = delete $attr{'formula_handling'};"
NSQ_SOURCE_LINE 00000209 "    my $attr_formula = delete $attr{'formula'};"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "    for (keys %attr) {"
NSQ_SOURCE_LINE 00000212 "\tif (m/^[a-z]/ && exists $def_attr{$_}) {"
NSQ_SOURCE_LINE 00000213 "\t    # uncoverable condition false"
NSQ_SOURCE_LINE 00000214 "\t    defined $attr{$_} && m/_char$/ and utf8::decode ($attr{$_});"
NSQ_SOURCE_LINE 00000215 "\t    next;"
NSQ_SOURCE_LINE 00000216 "\t    }"
NSQ_SOURCE_LINE 00000217 "#\tcroak?"
NSQ_SOURCE_LINE 00000218 "\t$last_err = Text::CSV_XS->SetDiag (1000, \"INI - Unknown attribute '$_'\");"
NSQ_SOURCE_LINE 00000219 "\t$attr{'auto_diag'} and error_diag ();"
NSQ_SOURCE_LINE 00000220 "\treturn;"
NSQ_SOURCE_LINE 00000221 "\t}"
NSQ_SOURCE_LINE 00000222 "    if ($sep_aliased) {"
NSQ_SOURCE_LINE 00000223 "\tmy @b = unpack \"U0C*\", $attr{'sep_char'};"
NSQ_SOURCE_LINE 00000224 "\tif (@b > 1) {"
NSQ_SOURCE_LINE 00000225 "\t    $attr{'sep'} = $attr{'sep_char'};"
NSQ_SOURCE_LINE 00000226 "\t    $attr{'sep_char'} = \"\\0\";"
NSQ_SOURCE_LINE 00000227 "\t    }"
NSQ_SOURCE_LINE 00000228 "\telse {"
NSQ_SOURCE_LINE 00000229 "\t    $attr{'sep'} = undef;"
NSQ_SOURCE_LINE 00000230 "\t    }"
NSQ_SOURCE_LINE 00000231 "\t}"
NSQ_SOURCE_LINE 00000232 "    if ($quote_aliased and defined $attr{'quote_char'}) {"
NSQ_SOURCE_LINE 00000233 "\tmy @b = unpack \"U0C*\", $attr{'quote_char'};"
NSQ_SOURCE_LINE 00000234 "\tif (@b > 1) {"
NSQ_SOURCE_LINE 00000235 "\t    $attr{'quote'} = $attr{'quote_char'};"
NSQ_SOURCE_LINE 00000236 "\t    $attr{'quote_char'} = \"\\0\";"
NSQ_SOURCE_LINE 00000237 "\t    }"
NSQ_SOURCE_LINE 00000238 "\telse {"
NSQ_SOURCE_LINE 00000239 "\t    $attr{'quote'} = undef;"
NSQ_SOURCE_LINE 00000240 "\t    }"
NSQ_SOURCE_LINE 00000241 "\t}"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "    my $self = { %def_attr, %attr };"
NSQ_SOURCE_LINE 00000244 "    if (my $ec = _check_sanity ($self)) {"
NSQ_SOURCE_LINE 00000245 "\t$last_err = Text::CSV_XS->SetDiag ($ec);"
NSQ_SOURCE_LINE 00000246 "\t$attr{'auto_diag'} and error_diag ();"
NSQ_SOURCE_LINE 00000247 "\treturn;"
NSQ_SOURCE_LINE 00000248 "\t}"
NSQ_SOURCE_LINE 00000249 "    if (defined $self->{'callbacks'} && ref $self->{'callbacks'} ne \"HASH\") {"
NSQ_SOURCE_LINE 00000250 "\tcarp (\"The 'callbacks' attribute is set but is not a hash: ignored\\n\");"
NSQ_SOURCE_LINE 00000251 "\t$self->{'callbacks'} = undef;"
NSQ_SOURCE_LINE 00000252 "\t}"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "    $last_err = Text::CSV_XS->SetDiag (0);"
NSQ_SOURCE_LINE 00000255 "    defined $\\ && !exists $attr{'eol'} and $self->{'eol'} = $\\;"
NSQ_SOURCE_LINE 00000256 "    bless $self, $class;"
NSQ_SOURCE_LINE 00000257 "    defined $self->{'types'}           and $self->types ($self->{'types'});"
NSQ_SOURCE_LINE 00000258 "    defined $self->{'skip_empty_rows'} and $self->{'skip_empty_rows'} = _supported_skip_empty_rows ($self, $self->{'skip_empty_rows'});"
NSQ_SOURCE_LINE 00000259 "    defined $attr_formula              and $self->{'formula'}         = _supported_formula         ($self, $attr_formula);"
NSQ_SOURCE_LINE 00000260 "    $self;"
NSQ_SOURCE_LINE 00000261 "    } # new"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "# Keep in sync with XS!"
NSQ_SOURCE_LINE 00000264 "my %_cache_id = ( # Only expose what is accessed from within PM"
NSQ_SOURCE_LINE 00000265 "    'quote_char'\t\t=>  0,"
NSQ_SOURCE_LINE 00000266 "    'escape_char'\t\t=>  1,"
NSQ_SOURCE_LINE 00000267 "    'sep_char'\t\t\t=>  2,"
NSQ_SOURCE_LINE 00000268 "    'always_quote'\t\t=>  4,"
