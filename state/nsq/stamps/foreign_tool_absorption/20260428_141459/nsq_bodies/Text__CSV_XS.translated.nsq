NSQ_SOURCE_LINE 00000811 "    } # meta_info"
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "sub is_quoted {"
NSQ_SOURCE_LINE 00000814 "    my ($self, $idx) = @_;"
NSQ_SOURCE_LINE 00000815 "    ref $self->{'_FFLAGS'} &&"
NSQ_SOURCE_LINE 00000816 "\t$idx >= 0 && $idx < @{$self->{'_FFLAGS'}} or return;"
NSQ_SOURCE_LINE 00000817 "    $self->{'_FFLAGS'}[$idx] & CSV_FLAGS_IS_QUOTED  () ? 1 : 0;"
NSQ_SOURCE_LINE 00000818 "    } # is_quoted"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "sub is_binary {"
NSQ_SOURCE_LINE 00000821 "    my ($self, $idx) = @_;"
NSQ_SOURCE_LINE 00000822 "    ref $self->{'_FFLAGS'} &&"
NSQ_SOURCE_LINE 00000823 "\t$idx >= 0 && $idx < @{$self->{'_FFLAGS'}} or return;"
