NSQ_SOURCE_LINE 00000883 "\t}"
NSQ_SOURCE_LINE 00000884 "    $self->{'_STATUS'};"
NSQ_SOURCE_LINE 00000885 "    } # parse"
NSQ_SOURCE_LINE 00000886 ""
