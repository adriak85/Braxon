NSQ_SOURCE_LINE 00000472 "sub _supported_skip_empty_rows {"
NSQ_SOURCE_LINE 00000473 "    my ($self, $f) = @_;"
NSQ_SOURCE_LINE 00000474 "    defined $f or return 0;"
NSQ_SOURCE_LINE 00000475 "    if ($self && $f && ref $f && ref $f eq \"CODE\") {"
NSQ_SOURCE_LINE 00000476 "\t$self->{'_EMPTROW_CB'} = $f;"
NSQ_SOURCE_LINE 00000477 "\treturn 6;"
NSQ_SOURCE_LINE 00000478 "\t}"
NSQ_SOURCE_LINE 00000479 "    $f =~ m/^(?: 0 | undef         )$/xi ? 0 :"
NSQ_SOURCE_LINE 00000480 "    $f =~ m/^(?: 1 | skip          )$/xi ? 1 :"
NSQ_SOURCE_LINE 00000481 "    $f =~ m/^(?: 2 | eof   | stop  )$/xi ? 2 :"
NSQ_SOURCE_LINE 00000482 "    $f =~ m/^(?: 3 | die           )$/xi ? 3 :"
NSQ_SOURCE_LINE 00000483 "    $f =~ m/^(?: 4 | croak         )$/xi ? 4 :"
NSQ_SOURCE_LINE 00000484 "    $f =~ m/^(?: 5 | error         )$/xi ? 5 :"
NSQ_SOURCE_LINE 00000485 "    $f =~ m/^(?: 6 | cb            )$/xi ? 6 : do {"
NSQ_SOURCE_LINE 00000486 "\t$self ||= \"Text::CSV_XS\";"
NSQ_SOURCE_LINE 00000487 "\tcroak ($self->_SetDiagInfo (1500, \"skip_empty_rows '$f' is not supported\"));"
NSQ_SOURCE_LINE 00000488 "\t};"
NSQ_SOURCE_LINE 00000489 "    } # _supported_skip_empty_rows"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "sub skip_empty_rows {"
NSQ_SOURCE_LINE 00000492 "    my $self = shift;"
NSQ_SOURCE_LINE 00000493 "    @_ and $self->_set_attr_N (\"skip_empty_rows\", _supported_skip_empty_rows ($self, shift));"
NSQ_SOURCE_LINE 00000494 "    my $ser = $self->{'skip_empty_rows'};"
NSQ_SOURCE_LINE 00000495 "    $ser == 6 or $self->{'_EMPTROW_CB'} = undef;"
NSQ_SOURCE_LINE 00000496 "    $ser <= 1 ? $ser : $ser == 2 ? \"eof\"   : $ser == 3 ? \"die\"   :"
NSQ_SOURCE_LINE 00000497 "\t\t       $ser == 4 ? \"croak\" : $ser == 5 ? \"error\" :"
NSQ_SOURCE_LINE 00000498 "\t\t       $self->{'_EMPTROW_CB'};"
NSQ_SOURCE_LINE 00000499 "    } # skip_empty_rows"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "sub _SetDiagInfo {"
NSQ_SOURCE_LINE 00000502 "    my ($self, $err, $msg) = @_;"
NSQ_SOURCE_LINE 00000503 "    $self->SetDiag ($err);"
NSQ_SOURCE_LINE 00000504 "    my $em  = $self->error_diag ();"
NSQ_SOURCE_LINE 00000505 "    $em =~ s/^\\d+$// and $msg =~ s/^/# /;"
NSQ_SOURCE_LINE 00000506 "    my $sep = $em =~ m/[;\\n]$/ ? \"\\n\\t\" : \": \";"
NSQ_SOURCE_LINE 00000507 "    join $sep => grep m/\\S\\S\\S/ => $em, $msg;"
NSQ_SOURCE_LINE 00000508 "    } # _SetDiagInfo"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "sub _supported_formula {"
NSQ_SOURCE_LINE 00000511 "    my ($self, $f) = @_;"
NSQ_SOURCE_LINE 00000512 "    defined $f or return 5;"
NSQ_SOURCE_LINE 00000513 "    if ($self && $f && ref $f && ref $f eq \"CODE\") {"
NSQ_SOURCE_LINE 00000514 "\t$self->{'_FORMULA_CB'} = $f;"
NSQ_SOURCE_LINE 00000515 "\treturn 6;"
NSQ_SOURCE_LINE 00000516 "\t}"
NSQ_SOURCE_LINE 00000517 "    $f =~ m/^(?: 0 | none    )$/xi ? 0 :"
NSQ_SOURCE_LINE 00000518 "    $f =~ m/^(?: 1 | die     )$/xi ? 1 :"
NSQ_SOURCE_LINE 00000519 "    $f =~ m/^(?: 2 | croak   )$/xi ? 2 :"
NSQ_SOURCE_LINE 00000520 "    $f =~ m/^(?: 3 | diag    )$/xi ? 3 :"
NSQ_SOURCE_LINE 00000521 "    $f =~ m/^(?: 4 | empty | )$/xi ? 4 :"
NSQ_SOURCE_LINE 00000522 "    $f =~ m/^(?: 5 | undef   )$/xi ? 5 :"
NSQ_SOURCE_LINE 00000523 "    $f =~ m/^(?: 6 | cb      )$/xi ? 6 : do {"
NSQ_SOURCE_LINE 00000524 "\t$self ||= \"Text::CSV_XS\";"
NSQ_SOURCE_LINE 00000525 "\tcroak ($self->_SetDiagInfo (1500, \"formula-handling '$f' is not supported\"));"
NSQ_SOURCE_LINE 00000526 "\t};"
NSQ_SOURCE_LINE 00000527 "    } # _supported_formula"
