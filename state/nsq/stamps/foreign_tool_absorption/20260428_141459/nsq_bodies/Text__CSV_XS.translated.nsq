NSQ_SOURCE_LINE 00000779 "# string"
NSQ_SOURCE_LINE 00000780 "#"
NSQ_SOURCE_LINE 00000781 "#   object method returning the result of the most recent combine () or the"
NSQ_SOURCE_LINE 00000782 "#   input to the most recent parse (), whichever is more recent.  there are"
NSQ_SOURCE_LINE 00000783 "#   no side-effects."
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "sub string {"
NSQ_SOURCE_LINE 00000786 "    my $self = shift;"
