NSQ_SOURCE_LINE 00000271 "    'quote_binary'\t\t=>  7,"
NSQ_SOURCE_LINE 00000272 "    'allow_loose_quotes'\t=>  8,"
NSQ_SOURCE_LINE 00000273 "    'allow_loose_escapes'\t=>  9,"
NSQ_SOURCE_LINE 00000274 "    'allow_unquoted_escape'\t=> 10,"
NSQ_SOURCE_LINE 00000275 "    'allow_whitespace'\t\t=> 11,"
NSQ_SOURCE_LINE 00000276 "    'blank_is_undef'\t\t=> 12,"
NSQ_SOURCE_LINE 00000277 "    'empty_is_undef'\t\t=> 13,"
NSQ_SOURCE_LINE 00000278 "    'auto_diag'\t\t\t=> 14,"
NSQ_SOURCE_LINE 00000279 "    'diag_verbose'\t\t=> 15,"
NSQ_SOURCE_LINE 00000280 "    'escape_null'\t\t=> 16,"
NSQ_SOURCE_LINE 00000281 "    'formula'\t\t\t=> 18,"
NSQ_SOURCE_LINE 00000282 "    'decode_utf8'\t\t=> 21,"
NSQ_SOURCE_LINE 00000283 "    'verbatim'\t\t\t=> 23,"
NSQ_SOURCE_LINE 00000284 "    'strict_eol'\t\t=> 24,"
NSQ_SOURCE_LINE 00000285 "    'strict'\t\t\t=> 28,"
NSQ_SOURCE_LINE 00000286 "    'skip_empty_rows'\t\t=> 29,"
NSQ_SOURCE_LINE 00000287 "    'binary'\t\t\t=> 30,"
NSQ_SOURCE_LINE 00000288 "    'keep_meta_info'\t\t=> 31,"
NSQ_SOURCE_LINE 00000289 "    '_has_hooks'\t\t=> 32,"
NSQ_SOURCE_LINE 00000290 "    '_has_ahead'\t\t=> 33,"
NSQ_SOURCE_LINE 00000291 "    '_is_bound'\t\t\t=> 44,"
NSQ_SOURCE_LINE 00000292 "    'eol'\t\t\t=> 100,"
NSQ_SOURCE_LINE 00000293 "    'sep'\t\t\t=> 116,"
NSQ_SOURCE_LINE 00000294 "    'quote'\t\t\t=> 132,"
NSQ_SOURCE_LINE 00000295 "    'undef_str'\t\t\t=> 148,"
NSQ_SOURCE_LINE 00000296 "    'comment_str'\t\t=> 156,"
NSQ_SOURCE_LINE 00000297 "    'types'\t\t\t=> 92,"
NSQ_SOURCE_LINE 00000298 "    );"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "# A `character'"
NSQ_SOURCE_LINE 00000301 "sub _set_attr_C {"
NSQ_SOURCE_LINE 00000302 "    my ($self, $name, $val, $ec) = @_;"
NSQ_SOURCE_LINE 00000303 "    defined $val and utf8::decode ($val);"
NSQ_SOURCE_LINE 00000304 "    $self->{$name} = $val;"
NSQ_SOURCE_LINE 00000305 "    $ec = _check_sanity ($self) and croak ($self->SetDiag ($ec));"
NSQ_SOURCE_LINE 00000306 "    $self->_cache_set ($_cache_id{$name}, $val);"
NSQ_SOURCE_LINE 00000307 "    } # _set_attr_C"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "# A flag"
NSQ_SOURCE_LINE 00000310 "sub _set_attr_X {"
NSQ_SOURCE_LINE 00000311 "    my ($self, $name, $val) = @_;"
NSQ_SOURCE_LINE 00000312 "    defined $val or $val = 0;"
NSQ_SOURCE_LINE 00000313 "    $self->{$name} = $val;"
NSQ_SOURCE_LINE 00000314 "    $self->_cache_set ($_cache_id{$name}, 0 + $val);"
NSQ_SOURCE_LINE 00000315 "    } # _set_attr_X"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "# A number"
NSQ_SOURCE_LINE 00000318 "sub _set_attr_N {"
NSQ_SOURCE_LINE 00000319 "    my ($self, $name, $val) = @_;"
NSQ_SOURCE_LINE 00000320 "    $self->{$name} = $val;"
NSQ_SOURCE_LINE 00000321 "    $self->_cache_set ($_cache_id{$name}, 0 + $val);"
NSQ_SOURCE_LINE 00000322 "    } # _set_attr_N"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "# Accessor methods."
NSQ_SOURCE_LINE 00000325 "#   It is unwise to change them halfway through a single file!"
NSQ_SOURCE_LINE 00000326 "sub quote_char {"
NSQ_SOURCE_LINE 00000327 "    my $self = shift;"
NSQ_SOURCE_LINE 00000328 "    if (@_) {"
NSQ_SOURCE_LINE 00000329 "\t$self->_set_attr_C (\"quote_char\", shift);"
NSQ_SOURCE_LINE 00000330 "\t$self->_cache_set ($_cache_id{'quote'}, \"\");"
NSQ_SOURCE_LINE 00000331 "\t}"
NSQ_SOURCE_LINE 00000332 "    $self->{'quote_char'};"
NSQ_SOURCE_LINE 00000333 "    } # quote_char"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "sub quote {"
NSQ_SOURCE_LINE 00000336 "    my $self = shift;"
NSQ_SOURCE_LINE 00000337 "    if (@_) {"
NSQ_SOURCE_LINE 00000338 "\tmy $quote = shift;"
NSQ_SOURCE_LINE 00000339 "\tdefined $quote or $quote = \"\";"
NSQ_SOURCE_LINE 00000340 "\tutf8::decode ($quote);"
NSQ_SOURCE_LINE 00000341 "\tmy @b = unpack \"U0C*\", $quote;"
NSQ_SOURCE_LINE 00000342 "\tif (@b > 1) {"
NSQ_SOURCE_LINE 00000343 "\t    @b > 16 and croak ($self->SetDiag (1007));"
NSQ_SOURCE_LINE 00000344 "\t    $self->quote_char (\"\\0\");"
NSQ_SOURCE_LINE 00000345 "\t    }"
NSQ_SOURCE_LINE 00000346 "\telse {"
NSQ_SOURCE_LINE 00000347 "\t    $self->quote_char ($quote);"
NSQ_SOURCE_LINE 00000348 "\t    $quote = \"\";"
NSQ_SOURCE_LINE 00000349 "\t    }"
NSQ_SOURCE_LINE 00000350 "\t$self->{'quote'} = $quote;"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "\tmy $ec = _check_sanity ($self);"
NSQ_SOURCE_LINE 00000353 "\t$ec and croak ($self->SetDiag ($ec));"
