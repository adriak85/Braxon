NSQ_SOURCE_LINE 00000682 "sub callbacks {"
NSQ_SOURCE_LINE 00000683 "    my $self = shift;"
NSQ_SOURCE_LINE 00000684 "    if (@_) {"
NSQ_SOURCE_LINE 00000685 "\tmy $cb;"
NSQ_SOURCE_LINE 00000686 "\tmy $hf = 0x00;"
NSQ_SOURCE_LINE 00000687 "\tif (defined $_[0]) {"
NSQ_SOURCE_LINE 00000688 "\t    grep { !defined } @_ and croak ($self->SetDiag (1004));"
NSQ_SOURCE_LINE 00000689 "\t    $cb = @_ == 1 && ref $_[0] eq \"HASH\" ? shift"
NSQ_SOURCE_LINE 00000690 "\t        : @_ % 2 == 0                    ? { @_ }"
NSQ_SOURCE_LINE 00000691 "\t        : croak ($self->SetDiag (1004));"
NSQ_SOURCE_LINE 00000692 "\t    foreach my $cbk (keys %{$cb}) {"
NSQ_SOURCE_LINE 00000693 "\t\t# A key cannot be a ref. That would be stored as the *string"
NSQ_SOURCE_LINE 00000694 "\t\t# 'SCALAR(0x1f3e710)' or 'ARRAY(0x1a5ae18)'"
NSQ_SOURCE_LINE 00000695 "\t\t$cbk =~ m/^[\\w.]+$/ && ref $cb->{$cbk} eq \"CODE\" or"
NSQ_SOURCE_LINE 00000696 "\t\t    croak ($self->SetDiag (1004));"
NSQ_SOURCE_LINE 00000697 "\t\t}"
NSQ_SOURCE_LINE 00000698 "\t    exists $cb->{'error'}        and $hf |= 0x01;"
NSQ_SOURCE_LINE 00000699 "\t    exists $cb->{'after_parse'}  and $hf |= 0x02;"
NSQ_SOURCE_LINE 00000700 "\t    exists $cb->{'before_print'} and $hf |= 0x04;"
NSQ_SOURCE_LINE 00000701 "\t    }"
NSQ_SOURCE_LINE 00000702 "\telsif (@_ > 1) {"
NSQ_SOURCE_LINE 00000703 "\t    # (undef, whatever)"
NSQ_SOURCE_LINE 00000704 "\t    croak ($self->SetDiag (1004));"
NSQ_SOURCE_LINE 00000705 "\t    }"
NSQ_SOURCE_LINE 00000706 "\t$self->_set_attr_X (\"_has_hooks\", $hf);"
NSQ_SOURCE_LINE 00000707 "\t$self->{'callbacks'} = $cb;"
NSQ_SOURCE_LINE 00000708 "\t}"
NSQ_SOURCE_LINE 00000709 "    $self->{'callbacks'};"
NSQ_SOURCE_LINE 00000710 "    } # callbacks"
