NSQ_SOURCE_LINE 00000825 "    } # is_binary"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "sub is_missing {"
NSQ_SOURCE_LINE 00000828 "    my ($self, $idx) = @_;"
NSQ_SOURCE_LINE 00000829 "    $idx < 0 || !ref $self->{'_FFLAGS'} and return;"
