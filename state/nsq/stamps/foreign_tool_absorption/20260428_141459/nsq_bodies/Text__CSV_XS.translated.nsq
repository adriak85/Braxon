NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "    my @hdr = @{$row};"
NSQ_SOURCE_LINE 00001032 "    ref $args{'munge_column_names'} eq \"CODE\" and"
NSQ_SOURCE_LINE 00001033 "\t@hdr = map { $args{'munge_column_names'}->($_)       } @hdr;"
NSQ_SOURCE_LINE 00001034 "    ref $args{'munge_column_names'} eq \"HASH\" and"
