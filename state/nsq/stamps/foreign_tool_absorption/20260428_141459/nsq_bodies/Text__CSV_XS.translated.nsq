NSQ_SOURCE_LINE 00000715 "#   indicates the reason of failure"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "sub error_diag {"
NSQ_SOURCE_LINE 00000718 "    my $self = shift;"
NSQ_SOURCE_LINE 00000719 "    my @diag = (0 + $last_err, $last_err, 0, 0, 0, 0);"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "    # Docs state to NEVER use UNIVERSAL::isa, because it will *never* call an"
NSQ_SOURCE_LINE 00000722 "    # overridden isa method in any class. Well, that is exacly what I want here"
NSQ_SOURCE_LINE 00000723 "    if ($self && ref $self and # Not a class method or direct call"
NSQ_SOURCE_LINE 00000724 "\t UNIVERSAL::isa ($self, __PACKAGE__) && exists $self->{'_ERROR_DIAG'}) {"
NSQ_SOURCE_LINE 00000725 "\t$diag[0] = 0 + $self->{'_ERROR_DIAG'};"
NSQ_SOURCE_LINE 00000726 "\t$diag[1] =     $self->{'_ERROR_DIAG'};"
NSQ_SOURCE_LINE 00000727 "\t$diag[2] = 1 + $self->{'_ERROR_POS'} if exists $self->{'_ERROR_POS'};"
NSQ_SOURCE_LINE 00000728 "\t$diag[3] =     $self->{'_RECNO'};"
NSQ_SOURCE_LINE 00000729 "\t$diag[4] =     $self->{'_ERROR_FLD'} if exists $self->{'_ERROR_FLD'};"
NSQ_SOURCE_LINE 00000730 "\t$diag[5] =     $self->{'_ERROR_SRC'} if exists $self->{'_ERROR_SRC'} && $self->{'diag_verbose'};"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "\t$diag[0] && $self->{'callbacks'} && $self->{'callbacks'}{'error'} and"
NSQ_SOURCE_LINE 00000733 "\t    return $self->{'callbacks'}{'error'}->(@diag);"
NSQ_SOURCE_LINE 00000734 "\t}"
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "    my $context = wantarray;"
NSQ_SOURCE_LINE 00000737 "    unless (defined $context) {\t# Void context, auto-diag"
NSQ_SOURCE_LINE 00000738 "\tif ($diag[0] && $diag[0] != 2012) {"
NSQ_SOURCE_LINE 00000739 "\t    my $msg = \"# CSV_XS ERROR: $diag[0] - $diag[1] \\@ rec $diag[3] pos $diag[2]\\n\";"
NSQ_SOURCE_LINE 00000740 "\t    $diag[4] and $msg =~ s/$/ field $diag[4]/;"
NSQ_SOURCE_LINE 00000741 "\t    $diag[5] and $msg =~ s/$/ (XS#$diag[5])/;"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "\t    unless ($self && ref $self) {\t# auto_diag"
NSQ_SOURCE_LINE 00000744 "\t\t# called without args in void context"
NSQ_SOURCE_LINE 00000745 "\t\twarn $msg;"
NSQ_SOURCE_LINE 00000746 "\t\treturn;"
NSQ_SOURCE_LINE 00000747 "\t\t}"
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "\t    $self->{'diag_verbose'} && $self->{'_ERROR_INPUT'} and"
NSQ_SOURCE_LINE 00000750 "\t\t$msg .= $self->{'_ERROR_INPUT'}.\"\\n\"."
NSQ_SOURCE_LINE 00000751 "\t\t\t(\" \" x ($diag[2] - 1)).\"^\\n\";"
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "\t    my $lvl = $self->{'auto_diag'};"
NSQ_SOURCE_LINE 00000754 "\t    if ($lvl < 2) {"
