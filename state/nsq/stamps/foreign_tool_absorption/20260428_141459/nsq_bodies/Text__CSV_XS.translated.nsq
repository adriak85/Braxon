NSQ_SOURCE_LINE 00000871 "    my $fields = [];"
NSQ_SOURCE_LINE 00000872 "    my $fflags = [];"
NSQ_SOURCE_LINE 00000873 "    $self->{'_STRING'} = \\$str;"
NSQ_SOURCE_LINE 00000874 "    if (defined $str && $self->Parse ($str, $fields, $fflags)) {"
