NSQ_SOURCE_LINE 00000756 "\t\tif (@c >= 11 && $c[10] && ref $c[10] eq \"HASH\") {"
NSQ_SOURCE_LINE 00000757 "\t\t    my $hints = $c[10];"
NSQ_SOURCE_LINE 00000758 "\t\t    (exists $hints->{'autodie'} && $hints->{'autodie'} or"
NSQ_SOURCE_LINE 00000759 "\t\t     exists $hints->{'guard Fatal'} &&"
NSQ_SOURCE_LINE 00000760 "\t\t    !exists $hints->{'no Fatal'}) and"
NSQ_SOURCE_LINE 00000761 "\t\t\t$lvl++;"
NSQ_SOURCE_LINE 00000762 "\t\t    # Future releases of autodie will probably set $^H{autodie}"
NSQ_SOURCE_LINE 00000763 "\t\t    #  to \"autodie @args\", like \"autodie :all\" or \"autodie open\""
