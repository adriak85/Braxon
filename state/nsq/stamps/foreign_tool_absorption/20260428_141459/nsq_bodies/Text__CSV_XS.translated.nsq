NSQ_SOURCE_LINE 00001380 "\t'in'   => $in,"
NSQ_SOURCE_LINE 00001381 "\t'sink' => $sink,"
NSQ_SOURCE_LINE 00001382 "\t'out'  => $out,"
NSQ_SOURCE_LINE 00001383 "\t'enc'  => $enc,"
NSQ_SOURCE_LINE 00001384 "\t'fho'  => $fho,"
NSQ_SOURCE_LINE 00001385 "\t'fhoc' => $fho_cls,"
NSQ_SOURCE_LINE 00001386 "\t'hdrs' => $hdrs,"
NSQ_SOURCE_LINE 00001387 "\t'key'  => $key,"
NSQ_SOURCE_LINE 00001388 "\t'val'  => $val,"
NSQ_SOURCE_LINE 00001389 "\t'kh'   => $kh,"
NSQ_SOURCE_LINE 00001390 "\t'frag' => $frag,"
NSQ_SOURCE_LINE 00001391 "\t'fltr' => $fltr,"
NSQ_SOURCE_LINE 00001392 "\t'cbai' => $cbai,"
NSQ_SOURCE_LINE 00001393 "\t'cbbo' => $cbbo,"
NSQ_SOURCE_LINE 00001394 "\t'cboi' => $cboi,"
NSQ_SOURCE_LINE 00001395 "\t'hd_s' => $hd_s,"
NSQ_SOURCE_LINE 00001396 "\t'hd_b' => $hd_b,"
NSQ_SOURCE_LINE 00001397 "\t'hd_m' => $hd_m,"
NSQ_SOURCE_LINE 00001398 "\t'hd_c' => $hd_c,"
NSQ_SOURCE_LINE 00001399 "\t};"
NSQ_SOURCE_LINE 00001400 "    } # _csv_attr"
NSQ_SOURCE_LINE 00001401 ""
NSQ_SOURCE_LINE 00001402 "sub csv {"
NSQ_SOURCE_LINE 00001403 "    @_ && ref $_[0] eq __PACKAGE__ and splice @_, 0, 0, \"csv\";"
NSQ_SOURCE_LINE 00001404 "    @_ or croak ($csv_usage);"
NSQ_SOURCE_LINE 00001405 ""
NSQ_SOURCE_LINE 00001406 "    my $c = _csv_attr (@_);"
NSQ_SOURCE_LINE 00001407 ""
NSQ_SOURCE_LINE 00001408 "    my ($csv, $in, $fh, $hdrs) = @{$c}{qw( csv in fh hdrs )};"
NSQ_SOURCE_LINE 00001409 "    my %hdr;"
NSQ_SOURCE_LINE 00001410 "    if (ref $hdrs eq \"HASH\") {"
NSQ_SOURCE_LINE 00001411 "\t%hdr  = %{$hdrs};"
NSQ_SOURCE_LINE 00001412 "\t$hdrs = \"auto\";"
NSQ_SOURCE_LINE 00001413 "\t}"
NSQ_SOURCE_LINE 00001414 ""
NSQ_SOURCE_LINE 00001415 "    if ($c->{'out'} && !$c->{'sink'}) {"
NSQ_SOURCE_LINE 00001416 "\t!$hdrs && ref $c->{'kh'} && $c->{'kh'} == \\@internal_kh and"
NSQ_SOURCE_LINE 00001417 "\t    $hdrs = $c->{'kh'};"
NSQ_SOURCE_LINE 00001418 ""
NSQ_SOURCE_LINE 00001419 "\tif (ref $in eq \"CODE\") {"
NSQ_SOURCE_LINE 00001420 "\t    my $hdr = 1;"
NSQ_SOURCE_LINE 00001421 "\t    while (my $row = $in->($csv)) {"
NSQ_SOURCE_LINE 00001422 "\t\tif (ref $row eq \"ARRAY\") {"
NSQ_SOURCE_LINE 00001423 "\t\t    $csv->print ($fh, $row);"
NSQ_SOURCE_LINE 00001424 "\t\t    next;"
NSQ_SOURCE_LINE 00001425 "\t\t    }"
NSQ_SOURCE_LINE 00001426 "\t\tif (ref $row eq \"HASH\") {"
NSQ_SOURCE_LINE 00001427 "\t\t    if ($hdr) {"
NSQ_SOURCE_LINE 00001428 "\t\t\t$hdrs ||= [ map { $hdr{$_} || $_ } keys %{$row} ];"
NSQ_SOURCE_LINE 00001429 "\t\t\t$csv->print ($fh, $hdrs);"
NSQ_SOURCE_LINE 00001430 "\t\t\t$hdr = 0;"
NSQ_SOURCE_LINE 00001431 "\t\t\t}"
NSQ_SOURCE_LINE 00001432 "\t\t    $csv->print ($fh, [ @{$row}{@{$hdrs}} ]);"
NSQ_SOURCE_LINE 00001433 "\t\t    }"
NSQ_SOURCE_LINE 00001434 "\t\t}"
NSQ_SOURCE_LINE 00001435 "\t    }"
NSQ_SOURCE_LINE 00001436 "\telsif (@{$in} == 0 or ref $in->[0] eq \"ARRAY\") { # aoa"
NSQ_SOURCE_LINE 00001437 "\t    ref $hdrs and $csv->print ($fh, $hdrs);"
NSQ_SOURCE_LINE 00001438 "\t    for (@{$in}) {"
NSQ_SOURCE_LINE 00001439 "\t\t$c->{'cboi'} and $c->{'cboi'}->($csv, $_);"
NSQ_SOURCE_LINE 00001440 "\t\t$c->{'cbbo'} and $c->{'cbbo'}->($csv, $_);"
NSQ_SOURCE_LINE 00001441 "\t\t$csv->print ($fh, $_);"
NSQ_SOURCE_LINE 00001442 "\t\t}"
NSQ_SOURCE_LINE 00001443 "\t    }"
NSQ_SOURCE_LINE 00001444 "\telse { # aoh"
NSQ_SOURCE_LINE 00001445 "\t    my @hdrs = ref $hdrs ? @{$hdrs} : keys %{$in->[0]};"
NSQ_SOURCE_LINE 00001446 "\t    defined $hdrs or $hdrs = \"auto\";"
NSQ_SOURCE_LINE 00001447 "\t    ref $hdrs || $hdrs eq \"auto\" and @hdrs and"
NSQ_SOURCE_LINE 00001448 "\t\t$csv->print ($fh, [ map { $hdr{$_} || $_ } @hdrs ]);"
NSQ_SOURCE_LINE 00001449 "\t    for (@{$in}) {"
NSQ_SOURCE_LINE 00001450 "\t\tlocal %_;"
NSQ_SOURCE_LINE 00001451 "\t\t*_ = $_;"
NSQ_SOURCE_LINE 00001452 "\t\t$c->{'cboi'} and $c->{'cboi'}->($csv, $_);"
NSQ_SOURCE_LINE 00001453 "\t\t$c->{'cbbo'} and $c->{'cbbo'}->($csv, $_);"
NSQ_SOURCE_LINE 00001454 "\t\t$csv->print ($fh, [ @{$_}{@hdrs} ]);"
NSQ_SOURCE_LINE 00001455 "\t\t}"
NSQ_SOURCE_LINE 00001456 "\t    }"
NSQ_SOURCE_LINE 00001457 ""
NSQ_SOURCE_LINE 00001458 "\t$c->{'cls'}     and close $fh;"
NSQ_SOURCE_LINE 00001459 "\t$c->{'fho_cls'} and close $c->{'fho'};"
NSQ_SOURCE_LINE 00001460 "\treturn 1;"
NSQ_SOURCE_LINE 00001461 "\t}"
NSQ_SOURCE_LINE 00001462 ""
NSQ_SOURCE_LINE 00001463 "    my @row1;"
NSQ_SOURCE_LINE 00001464 "    if (defined $c->{'hd_s'} || defined $c->{'hd_b'} || defined $c->{'hd_m'} || defined $c->{'hd_c'}) {"
NSQ_SOURCE_LINE 00001465 "\tmy %harg;"
NSQ_SOURCE_LINE 00001466 "\t!defined $c->{'hd_s'} &&  $c->{'attr'}{'sep_char'} and"
NSQ_SOURCE_LINE 00001467 "\t         $c->{'hd_s'} = [ $c->{'attr'}{'sep_char'} ];"
NSQ_SOURCE_LINE 00001468 "\t!defined $c->{'hd_s'} &&  $c->{'attr'}{'sep'} and"
NSQ_SOURCE_LINE 00001469 "\t         $c->{'hd_s'} = [ $c->{'attr'}{'sep'} ];"
NSQ_SOURCE_LINE 00001470 "\tdefined  $c->{'hd_s'} and $harg{'sep_set'}            = $c->{'hd_s'};"
NSQ_SOURCE_LINE 00001471 "\tdefined  $c->{'hd_b'} and $harg{'detect_bom'}         = $c->{'hd_b'};"
NSQ_SOURCE_LINE 00001472 "\tdefined  $c->{'hd_m'} and $harg{'munge_column_names'} = $hdrs ? \"none\" : $c->{'hd_m'};"
NSQ_SOURCE_LINE 00001473 "\tdefined  $c->{'hd_c'} and $harg{'set_column_names'}   = $hdrs ? 0      : $c->{'hd_c'};"
NSQ_SOURCE_LINE 00001474 "\t@row1 = $csv->header ($fh, \\%harg);"
NSQ_SOURCE_LINE 00001475 "\tmy @hdr = $csv->column_names ();"
NSQ_SOURCE_LINE 00001476 "\t@hdr and $hdrs ||= \\@hdr;"
NSQ_SOURCE_LINE 00001477 "\t}"
NSQ_SOURCE_LINE 00001478 ""
NSQ_SOURCE_LINE 00001479 "    if ($c->{'kh'}) {"
NSQ_SOURCE_LINE 00001480 "\t@internal_kh = ();"
NSQ_SOURCE_LINE 00001481 "\tref $c->{'kh'} eq \"ARRAY\" or croak ($csv->SetDiag (1501));"
NSQ_SOURCE_LINE 00001482 "\t$hdrs ||= \"auto\";"
NSQ_SOURCE_LINE 00001483 "\t}"
NSQ_SOURCE_LINE 00001484 ""
NSQ_SOURCE_LINE 00001485 "    my $key = $c->{'key'};"
NSQ_SOURCE_LINE 00001486 "    if ($key) {"
NSQ_SOURCE_LINE 00001487 "\t!ref $key or ref $key eq \"ARRAY\" && @{$key} > 1 or croak ($csv->SetDiag (1501));"
NSQ_SOURCE_LINE 00001488 "\t$hdrs ||= \"auto\";"
NSQ_SOURCE_LINE 00001489 "\t}"
NSQ_SOURCE_LINE 00001490 "    my $val = $c->{'val'};"
NSQ_SOURCE_LINE 00001491 "    if ($val) {"
NSQ_SOURCE_LINE 00001492 "\t$key\t\t\t\t\t\tor croak ($csv->SetDiag (1502));"
NSQ_SOURCE_LINE 00001493 "\t!ref $val or ref $val eq \"ARRAY\" && @{$val} > 0 or croak ($csv->SetDiag (1503));"
NSQ_SOURCE_LINE 00001494 "\t}"
NSQ_SOURCE_LINE 00001495 ""
NSQ_SOURCE_LINE 00001496 "    $c->{'fltr'} && grep m/\\D/ => keys %{$c->{'fltr'}} and $hdrs ||= \"auto\";"
NSQ_SOURCE_LINE 00001497 "    if (defined $hdrs) {"
NSQ_SOURCE_LINE 00001498 "\tif (!ref $hdrs or ref $hdrs eq \"CODE\") {"
NSQ_SOURCE_LINE 00001499 "\t    my $h = $c->{'hd_b'}"
NSQ_SOURCE_LINE 00001500 "\t\t? [ $csv->column_names () ]"
NSQ_SOURCE_LINE 00001501 "\t\t:   $csv->getline ($fh);"
NSQ_SOURCE_LINE 00001502 "\t    my $has_h = $h && @$h;"
NSQ_SOURCE_LINE 00001503 ""
NSQ_SOURCE_LINE 00001504 "\t    if (ref $hdrs) {"
NSQ_SOURCE_LINE 00001505 "\t\t$has_h or return;"
NSQ_SOURCE_LINE 00001506 "\t\tmy $cr = $hdrs;"
NSQ_SOURCE_LINE 00001507 "\t\t$hdrs  = [ map {  $cr->($hdr{$_} || $_) } @{$h} ];"
NSQ_SOURCE_LINE 00001508 "\t\t}"
NSQ_SOURCE_LINE 00001509 "\t    elsif ($hdrs eq \"skip\") {"
NSQ_SOURCE_LINE 00001510 "\t\t# discard;"
NSQ_SOURCE_LINE 00001511 "\t\t}"
NSQ_SOURCE_LINE 00001512 "\t    elsif ($hdrs eq \"auto\") {"
NSQ_SOURCE_LINE 00001513 "\t\t$has_h or return;"
NSQ_SOURCE_LINE 00001514 "\t\t$hdrs = [ map {      $hdr{$_} || $_ } @{$h} ];"
NSQ_SOURCE_LINE 00001515 "\t\t}"
NSQ_SOURCE_LINE 00001516 "\t    elsif ($hdrs eq \"lc\") {"
NSQ_SOURCE_LINE 00001517 "\t\t$has_h or return;"
NSQ_SOURCE_LINE 00001518 "\t\t$hdrs = [ map { lc ($hdr{$_} || $_) } @{$h} ];"
NSQ_SOURCE_LINE 00001519 "\t\t}"
NSQ_SOURCE_LINE 00001520 "\t    elsif ($hdrs eq \"uc\") {"
NSQ_SOURCE_LINE 00001521 "\t\t$has_h or return;"
NSQ_SOURCE_LINE 00001522 "\t\t$hdrs = [ map { uc ($hdr{$_} || $_) } @{$h} ];"
NSQ_SOURCE_LINE 00001523 "\t\t}"
NSQ_SOURCE_LINE 00001524 "\t    }"
NSQ_SOURCE_LINE 00001525 "\t$c->{'kh'} and $hdrs and @{$c->{'kh'}} = @{$hdrs};"
NSQ_SOURCE_LINE 00001526 "\t}"
NSQ_SOURCE_LINE 00001527 ""
NSQ_SOURCE_LINE 00001528 "    if ($c->{'fltr'}) {"
NSQ_SOURCE_LINE 00001529 "\tmy %f = %{$c->{'fltr'}};"
NSQ_SOURCE_LINE 00001530 "\t# convert headers to index"
NSQ_SOURCE_LINE 00001531 "\tmy @hdr;"
NSQ_SOURCE_LINE 00001532 "\tif (ref $hdrs) {"
NSQ_SOURCE_LINE 00001533 "\t    @hdr = @{$hdrs};"
NSQ_SOURCE_LINE 00001534 "\t    for (0 .. $#hdr) {"
NSQ_SOURCE_LINE 00001535 "\t\texists $f{$hdr[$_]} and $f{$_ + 1} = delete $f{$hdr[$_]};"
NSQ_SOURCE_LINE 00001536 "\t\t}"
NSQ_SOURCE_LINE 00001537 "\t    }"
NSQ_SOURCE_LINE 00001538 "\t$csv->callbacks ('after_parse' => sub {"
NSQ_SOURCE_LINE 00001539 "\t    my ($CSV, $ROW) = @_; # lexical sub-variables in caps"
NSQ_SOURCE_LINE 00001540 "\t    foreach my $FLD (sort keys %f) {"
NSQ_SOURCE_LINE 00001541 "\t\tlocal $_ = $ROW->[$FLD - 1];"
NSQ_SOURCE_LINE 00001542 "\t\tlocal %_;"
NSQ_SOURCE_LINE 00001543 "\t\t@hdr and @_{@hdr} = @{$ROW};"
NSQ_SOURCE_LINE 00001544 "\t\t$f{$FLD}->($CSV, $ROW) or return \\\"skip\";"
NSQ_SOURCE_LINE 00001545 "\t\t$ROW->[$FLD - 1] = $_;"
NSQ_SOURCE_LINE 00001546 "\t\t}"
NSQ_SOURCE_LINE 00001547 "\t    });"
NSQ_SOURCE_LINE 00001548 "\t}"
NSQ_SOURCE_LINE 00001549 ""
NSQ_SOURCE_LINE 00001550 "    my $frag = $c->{'frag'};"
NSQ_SOURCE_LINE 00001551 "    my $ref = ref $hdrs"
NSQ_SOURCE_LINE 00001552 "\t? # aoh"
NSQ_SOURCE_LINE 00001553 "\t  do {"
NSQ_SOURCE_LINE 00001554 "\t    my @h = $csv->column_names ($hdrs);"
NSQ_SOURCE_LINE 00001555 "\t    my %h; $h{$_}++ for @h;"
NSQ_SOURCE_LINE 00001556 "\t    exists $h{''} and croak ($csv->SetDiag (1012));"
NSQ_SOURCE_LINE 00001557 "\t    unless (keys %h == @h) {"
NSQ_SOURCE_LINE 00001558 "\t\tcroak ($csv->_SetDiagInfo (1013, join \", \" =>"
NSQ_SOURCE_LINE 00001559 "\t\t    map { \"$_ ($h{$_})\" } grep { $h{$_} > 1 } keys %h));"
NSQ_SOURCE_LINE 00001560 "\t\t}"
NSQ_SOURCE_LINE 00001561 "\t    $frag ? $csv->fragment ($fh, $frag) :"
NSQ_SOURCE_LINE 00001562 "\t    $key  ? do {"
NSQ_SOURCE_LINE 00001563 "\t\t\tmy ($k, $j, @f) = ref $key ? (undef, @{$key}) : ($key);"
NSQ_SOURCE_LINE 00001564 "\t\t\tif (my @mk = grep { !exists $h{$_} } grep { defined } $k, @f) {"
NSQ_SOURCE_LINE 00001565 "\t\t\t    croak ($csv->_SetDiagInfo (4001, join \", \" => @mk));"
NSQ_SOURCE_LINE 00001566 "\t\t\t    }"
NSQ_SOURCE_LINE 00001567 "\t\t\t+{ map {"
NSQ_SOURCE_LINE 00001568 "\t\t\t    my $r = $_;"
NSQ_SOURCE_LINE 00001569 "\t\t\t    my $K = defined $k ? $r->{$k} : join $j => @{$r}{@f};"
NSQ_SOURCE_LINE 00001570 "\t\t\t    ( $K => ("
NSQ_SOURCE_LINE 00001571 "\t\t\t    $val"
NSQ_SOURCE_LINE 00001572 "\t\t\t\t? ref $val"
NSQ_SOURCE_LINE 00001573 "\t\t\t\t    ? { map { $_ => $r->{$_} } @{$val} }"
NSQ_SOURCE_LINE 00001574 "\t\t\t\t    : $r->{$val}"
NSQ_SOURCE_LINE 00001575 "\t\t\t        : $r ));"
NSQ_SOURCE_LINE 00001576 "\t\t\t    } @{$csv->getline_hr_all ($fh)} }"
NSQ_SOURCE_LINE 00001577 "\t\t\t}"
NSQ_SOURCE_LINE 00001578 "\t\t  : $csv->getline_hr_all ($fh);"
NSQ_SOURCE_LINE 00001579 "\t    }"
NSQ_SOURCE_LINE 00001580 "\t: # aoa"
NSQ_SOURCE_LINE 00001581 "\t    $frag ? $csv->fragment ($fh, $frag)"
NSQ_SOURCE_LINE 00001582 "\t\t  : $csv->getline_all ($fh);"
NSQ_SOURCE_LINE 00001583 "    if ($ref) {"
NSQ_SOURCE_LINE 00001584 "\t@row1 && !$c->{'hd_c'} && !ref $hdrs and unshift @{$ref}, \\@row1;"
NSQ_SOURCE_LINE 00001585 "\t}"
NSQ_SOURCE_LINE 00001586 "    else {"
NSQ_SOURCE_LINE 00001587 "\tText::CSV_XS->auto_diag ();"
NSQ_SOURCE_LINE 00001588 "\t}"
NSQ_SOURCE_LINE 00001589 "    $c->{'cls'}     and close $fh;"
NSQ_SOURCE_LINE 00001590 "    $c->{'fho_cls'} and close $c->{'fho'};"
NSQ_SOURCE_LINE 00001591 "    if ($ref and $c->{'cbai'} || $c->{'cboi'}) {"
NSQ_SOURCE_LINE 00001592 "\t# Default is ARRAYref, but with key =>, you'll get a hashref"
NSQ_SOURCE_LINE 00001593 "\tforeach my $r (ref $ref eq \"ARRAY\" ? @{$ref} : values %{$ref}) {"
NSQ_SOURCE_LINE 00001594 "\t    local %_;"
NSQ_SOURCE_LINE 00001595 "\t    ref $r eq \"HASH\" and *_ = $r;"
NSQ_SOURCE_LINE 00001596 "\t    $c->{'cbai'} and $c->{'cbai'}->($csv, $r);"
NSQ_SOURCE_LINE 00001597 "\t    $c->{'cboi'} and $c->{'cboi'}->($csv, $r);"
NSQ_SOURCE_LINE 00001598 "\t    }"
NSQ_SOURCE_LINE 00001599 "\t}"
NSQ_SOURCE_LINE 00001600 ""
NSQ_SOURCE_LINE 00001601 "    if ($c->{'sink'}) {"
NSQ_SOURCE_LINE 00001602 "\tmy $ro = ref $c->{'out'} or return;"
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "\t$ro eq \"SCALAR\" && ${$c->{'out'}} eq \"skip\" and"
NSQ_SOURCE_LINE 00001605 "\t    return;"
NSQ_SOURCE_LINE 00001606 ""
NSQ_SOURCE_LINE 00001607 "\t$ro eq ref $ref or"
NSQ_SOURCE_LINE 00001608 "\t    croak ($csv->_SetDiagInfo (5001, \"Output type mismatch\"));"
NSQ_SOURCE_LINE 00001609 ""
NSQ_SOURCE_LINE 00001610 "\tif ($ro eq \"ARRAY\") {"
NSQ_SOURCE_LINE 00001611 "\t    if (@{$c->{'out'}} and @$ref and ref $c->{'out'}[0] eq ref $ref->[0]) {"
NSQ_SOURCE_LINE 00001612 "\t\tpush @{$c->{'out'}} => @$ref;"
NSQ_SOURCE_LINE 00001613 "\t\treturn $c->{'out'};"
NSQ_SOURCE_LINE 00001614 "\t\t}"
NSQ_SOURCE_LINE 00001615 "\t    croak ($csv->_SetDiagInfo (5001, \"Output type mismatch\"));"
NSQ_SOURCE_LINE 00001616 "\t    }"
NSQ_SOURCE_LINE 00001617 ""
NSQ_SOURCE_LINE 00001618 "\tif ($ro eq \"HASH\") {"
NSQ_SOURCE_LINE 00001619 "\t    @{$c->{'out'}}{keys %{$ref}} = values %{$ref};"
NSQ_SOURCE_LINE 00001620 "\t    return $c->{'out'};"
NSQ_SOURCE_LINE 00001621 "\t    }"
NSQ_SOURCE_LINE 00001622 ""
NSQ_SOURCE_LINE 00001623 "\tcroak ($csv->_SetDiagInfo (5002, \"Unsupported output type\"));"
NSQ_SOURCE_LINE 00001624 "\t}"
NSQ_SOURCE_LINE 00001625 ""
NSQ_SOURCE_LINE 00001626 "    defined wantarray or"
NSQ_SOURCE_LINE 00001627 "\treturn csv ("
NSQ_SOURCE_LINE 00001628 "\t    'in'      => $ref,"
NSQ_SOURCE_LINE 00001629 "\t    'headers' => $hdrs,"
NSQ_SOURCE_LINE 00001630 "\t    %{$c->{'attr'}},"
NSQ_SOURCE_LINE 00001631 "\t    );"
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "    $last_err ||= $csv->{'_ERROR_DIAG'};"
NSQ_SOURCE_LINE 00001634 "    return $ref;"
NSQ_SOURCE_LINE 00001635 "    } # csv"
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 "1;"
NSQ_SOURCE_LINE 00001638 ""
NSQ_SOURCE_LINE 00001639 "__END__"
NSQ_SOURCE_LINE 00001640 ""
NSQ_SOURCE_LINE 00001641 "=encoding utf-8"
NSQ_SOURCE_LINE 00001642 ""
NSQ_SOURCE_LINE 00001643 "=head1 NAME"
NSQ_SOURCE_LINE 00001644 ""
NSQ_SOURCE_LINE 00001645 "Text::CSV_XS - comma-separated values manipulation routines"
NSQ_SOURCE_LINE 00001646 ""
NSQ_SOURCE_LINE 00001647 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00001648 ""
NSQ_SOURCE_LINE 00001649 " # Functional interface"
NSQ_SOURCE_LINE 00001650 " use Text::CSV_XS qw( csv );"
NSQ_SOURCE_LINE 00001651 ""
NSQ_SOURCE_LINE 00001652 " # Read whole file in memory"
NSQ_SOURCE_LINE 00001653 " my $aoa = csv (in => \"data.csv\");    # as array of array"
NSQ_SOURCE_LINE 00001654 " my $aoh = csv (in => \"data.csv\","
NSQ_SOURCE_LINE 00001655 "                headers => \"auto\");   # as array of hash"
NSQ_SOURCE_LINE 00001656 ""
NSQ_SOURCE_LINE 00001657 " # Write array of arrays as csv file"
NSQ_SOURCE_LINE 00001658 " csv (in => $aoa, out => \"file.csv\", sep_char => \";\");"
NSQ_SOURCE_LINE 00001659 ""
NSQ_SOURCE_LINE 00001660 " # Only show lines where \"code\" is odd"
NSQ_SOURCE_LINE 00001661 " csv (in => \"data.csv\", filter => { code => sub { $_ % 2 }});"
NSQ_SOURCE_LINE 00001662 ""
NSQ_SOURCE_LINE 00001663 ""
NSQ_SOURCE_LINE 00001664 " # Object interface"
NSQ_SOURCE_LINE 00001665 " use Text::CSV_XS;"
NSQ_SOURCE_LINE 00001666 ""
NSQ_SOURCE_LINE 00001667 " my @rows;"
NSQ_SOURCE_LINE 00001668 " # Read/parse CSV"
NSQ_SOURCE_LINE 00001669 " my $csv = Text::CSV_XS->new ({ binary => 1, auto_diag => 1 });"
NSQ_SOURCE_LINE 00001670 " open my $fh, \"<:encoding(utf8)\", \"test.csv\" or die \"test.csv: $!\";"
NSQ_SOURCE_LINE 00001671 " while (my $row = $csv->getline ($fh)) {"
NSQ_SOURCE_LINE 00001672 "     $row->[2] =~ m/pattern/ or next; # 3rd field should match"
NSQ_SOURCE_LINE 00001673 "     push @rows, $row;"
NSQ_SOURCE_LINE 00001674 "     }"
NSQ_SOURCE_LINE 00001675 " close $fh;"
NSQ_SOURCE_LINE 00001676 ""
NSQ_SOURCE_LINE 00001677 " # and write as CSV"
NSQ_SOURCE_LINE 00001678 " open $fh, \">:encoding(utf8)\", \"new.csv\" or die \"new.csv: $!\";"
NSQ_SOURCE_LINE 00001679 " $csv->say ($fh, $_) for @rows;"
NSQ_SOURCE_LINE 00001680 " close $fh or die \"new.csv: $!\";"
NSQ_SOURCE_LINE 00001681 ""
NSQ_SOURCE_LINE 00001682 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00001683 ""
NSQ_SOURCE_LINE 00001684 "Text::CSV_XS  provides facilities for the composition  and decomposition of"
NSQ_SOURCE_LINE 00001685 "comma-separated values.  An instance of the Text::CSV_XS class will combine"
NSQ_SOURCE_LINE 00001686 "fields into a C<CSV> string and parse a C<CSV> string into fields."
NSQ_SOURCE_LINE 00001687 ""
NSQ_SOURCE_LINE 00001688 "The module accepts either strings or files as input  and support the use of"
NSQ_SOURCE_LINE 00001689 "user-specified characters for delimiters, separators, and escapes."
NSQ_SOURCE_LINE 00001690 ""
NSQ_SOURCE_LINE 00001691 "=head2 Embedded newlines"
NSQ_SOURCE_LINE 00001692 ""
NSQ_SOURCE_LINE 00001693 "B<Important Note>:  The default behavior is to accept only ASCII characters"
NSQ_SOURCE_LINE 00001694 "in the range from C<0x20> (space) to C<0x7E> (tilde).   This means that the"
NSQ_SOURCE_LINE 00001695 "fields can not contain newlines. If your data contains newlines embedded in"
NSQ_SOURCE_LINE 00001696 "fields, or characters above C<0x7E> (tilde), or binary data, you B<I<must>>"
NSQ_SOURCE_LINE 00001697 "set C<< binary => 1 >> in the call to L</new>. To cover the widest range of"
NSQ_SOURCE_LINE 00001698 "parsing options, you will always want to set binary."
NSQ_SOURCE_LINE 00001699 ""
NSQ_SOURCE_LINE 00001700 "But you still have the problem  that you have to pass a correct line to the"
NSQ_SOURCE_LINE 00001701 "L</parse> method, which is more complicated from the usual point of usage:"
NSQ_SOURCE_LINE 00001702 ""
NSQ_SOURCE_LINE 00001703 " my $csv = Text::CSV_XS->new ({ binary => 1, eol => $/ });"
NSQ_SOURCE_LINE 00001704 " while (<>) {\t\t#  WRONG!"
NSQ_SOURCE_LINE 00001705 "     $csv->parse ($_);"
NSQ_SOURCE_LINE 00001706 "     my @fields = $csv->fields ();"
NSQ_SOURCE_LINE 00001707 "     }"
NSQ_SOURCE_LINE 00001708 ""
NSQ_SOURCE_LINE 00001709 "this will break, as the C<while> might read broken lines:  it does not care"
NSQ_SOURCE_LINE 00001710 "about the quoting. If you need to support embedded newlines,  the way to go"
NSQ_SOURCE_LINE 00001711 "is to  B<not>  pass L<C<eol>|/eol> in the parser  (it accepts C<\\n>, C<\\r>,"
NSQ_SOURCE_LINE 00001712 "B<and> C<\\r\\n> by default) and then"
NSQ_SOURCE_LINE 00001713 ""
NSQ_SOURCE_LINE 00001714 " my $csv = Text::CSV_XS->new ({ binary => 1 });"
NSQ_SOURCE_LINE 00001715 " open my $fh, \"<\", $file or die \"$file: $!\";"
NSQ_SOURCE_LINE 00001716 " while (my $row = $csv->getline ($fh)) {"
NSQ_SOURCE_LINE 00001717 "     my @fields = @$row;"
NSQ_SOURCE_LINE 00001718 "     }"
NSQ_SOURCE_LINE 00001719 ""
NSQ_SOURCE_LINE 00001720 "The old(er) way of using global file handles is still supported"
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 " while (my $row = $csv->getline (*ARGV)) { ... }"
NSQ_SOURCE_LINE 00001723 ""
NSQ_SOURCE_LINE 00001724 "=head2 Unicode"
NSQ_SOURCE_LINE 00001725 ""
NSQ_SOURCE_LINE 00001726 "Unicode is only tested to work with perl-5.8.2 and up."
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "See also L</BOM>."
NSQ_SOURCE_LINE 00001729 ""
NSQ_SOURCE_LINE 00001730 "The simplest way to ensure the correct encoding is used for  in- and output"
NSQ_SOURCE_LINE 00001731 "is by either setting layers on the filehandles, or setting the L</encoding>"
NSQ_SOURCE_LINE 00001732 "argument for L</csv>."
NSQ_SOURCE_LINE 00001733 ""
NSQ_SOURCE_LINE 00001734 " open my $fh, \"<:encoding(UTF-8)\", \"in.csv\"  or die \"in.csv: $!\";"
NSQ_SOURCE_LINE 00001735 "or"
NSQ_SOURCE_LINE 00001736 " my $aoa = csv (in => \"in.csv\",     encoding => \"UTF-8\");"
NSQ_SOURCE_LINE 00001737 ""
NSQ_SOURCE_LINE 00001738 " open my $fh, \">:encoding(UTF-8)\", \"out.csv\" or die \"out.csv: $!\";"
NSQ_SOURCE_LINE 00001739 "or"
NSQ_SOURCE_LINE 00001740 " csv (in => $aoa, out => \"out.csv\", encoding => \"UTF-8\");"
NSQ_SOURCE_LINE 00001741 ""
NSQ_SOURCE_LINE 00001742 "On parsing (both for  L</getline> and  L</parse>),  if the source is marked"
NSQ_SOURCE_LINE 00001743 "being UTF8, then all fields that are marked binary will also be marked UTF8."
NSQ_SOURCE_LINE 00001744 ""
NSQ_SOURCE_LINE 00001745 "On combining (L</print>  and  L</combine>):  if any of the combining fields"
NSQ_SOURCE_LINE 00001746 "was marked UTF8, the resulting string will be marked as UTF8.  Note however"
NSQ_SOURCE_LINE 00001747 "that all fields  I<before>  the first field marked UTF8 and contained 8-bit"
NSQ_SOURCE_LINE 00001748 "characters that were not upgraded to UTF8,  these will be  C<bytes>  in the"
NSQ_SOURCE_LINE 00001749 "resulting string too, possibly causing unexpected errors.  If you pass data"
NSQ_SOURCE_LINE 00001750 "of different encoding,  or you don't know if there is  different  encoding,"
NSQ_SOURCE_LINE 00001751 "force it to be upgraded before you pass them on:"
NSQ_SOURCE_LINE 00001752 ""
NSQ_SOURCE_LINE 00001753 " $csv->print ($fh, [ map { utf8::upgrade (my $x = $_); $x } @data ]);"
NSQ_SOURCE_LINE 00001754 ""
NSQ_SOURCE_LINE 00001755 "For complete control over encoding, please use L<Text::CSV::Encoded>:"
NSQ_SOURCE_LINE 00001756 ""
NSQ_SOURCE_LINE 00001757 " use Text::CSV::Encoded;"
NSQ_SOURCE_LINE 00001758 " my $csv = Text::CSV::Encoded->new ({"
NSQ_SOURCE_LINE 00001759 "     encoding_in  => \"iso-8859-1\", # the encoding comes into   Perl"
NSQ_SOURCE_LINE 00001760 "     encoding_out => \"cp1252\",     # the encoding comes out of Perl"
NSQ_SOURCE_LINE 00001761 "     });"
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 " $csv = Text::CSV::Encoded->new ({ encoding  => \"utf8\" });"
NSQ_SOURCE_LINE 00001764 " # combine () and print () accept *literally* utf8 encoded data"
NSQ_SOURCE_LINE 00001765 " # parse () and getline () return *literally* utf8 encoded data"
NSQ_SOURCE_LINE 00001766 ""
NSQ_SOURCE_LINE 00001767 " $csv = Text::CSV::Encoded->new ({ encoding  => undef }); # default"
NSQ_SOURCE_LINE 00001768 " # combine () and print () accept UTF8 marked data"
NSQ_SOURCE_LINE 00001769 " # parse () and getline () return UTF8 marked data"
NSQ_SOURCE_LINE 00001770 ""
NSQ_SOURCE_LINE 00001771 "=head2 BOM"
NSQ_SOURCE_LINE 00001772 ""
NSQ_SOURCE_LINE 00001773 "BOM  (or Byte Order Mark)  handling is available only inside the L</header>"
NSQ_SOURCE_LINE 00001774 "method.   This method supports the following encodings: C<utf-8>, C<utf-1>,"
NSQ_SOURCE_LINE 00001775 "C<utf-32be>, C<utf-32le>, C<utf-16be>, C<utf-16le>, C<utf-ebcdic>, C<scsu>,"
NSQ_SOURCE_LINE 00001776 "C<bocu-1>, and C<gb-18030>. See L<Wikipedia|https://en.wikipedia.org/wiki/Byte_order_mark>."
NSQ_SOURCE_LINE 00001777 ""
NSQ_SOURCE_LINE 00001778 "If a file has a BOM, the easiest way to deal with that is"
NSQ_SOURCE_LINE 00001779 ""
NSQ_SOURCE_LINE 00001780 " my $aoh = csv (in => $file, detect_bom => 1);"
NSQ_SOURCE_LINE 00001781 ""
NSQ_SOURCE_LINE 00001782 "All records will be encoded based on the detected BOM."
NSQ_SOURCE_LINE 00001783 ""
NSQ_SOURCE_LINE 00001784 "This implies a call to the  L</header>  method,  which defaults to also set"
NSQ_SOURCE_LINE 00001785 "the L</column_names>. So this is B<not> the same as"
NSQ_SOURCE_LINE 00001786 ""
NSQ_SOURCE_LINE 00001787 " my $aoh = csv (in => $file, headers => \"auto\");"
NSQ_SOURCE_LINE 00001788 ""
NSQ_SOURCE_LINE 00001789 "which only reads the first record to set  L</column_names>  but ignores any"
NSQ_SOURCE_LINE 00001790 "meaning of possible present BOM."
NSQ_SOURCE_LINE 00001791 ""
NSQ_SOURCE_LINE 00001792 "=head1 SPECIFICATION"
NSQ_SOURCE_LINE 00001793 ""
NSQ_SOURCE_LINE 00001794 "While no formal specification for CSV exists, L<RFC 4180|https://datatracker.ietf.org/doc/html/rfc4180>"
NSQ_SOURCE_LINE 00001795 "(I<1>) describes the common format and establishes  C<text/csv> as the MIME"
NSQ_SOURCE_LINE 00001796 "type registered with the IANA. L<RFC 7111|https://datatracker.ietf.org/doc/html/rfc7111>"
NSQ_SOURCE_LINE 00001797 "(I<2>) adds fragments to CSV."
NSQ_SOURCE_LINE 00001798 ""
NSQ_SOURCE_LINE 00001799 "Many informal documents exist that describe the C<CSV> format.   L<\"How To:"
NSQ_SOURCE_LINE 00001800 "The Comma Separated Value (CSV) File Format\"|http://creativyst.com/Doc/Articles/CSV/CSV01.shtml>"
NSQ_SOURCE_LINE 00001801 "(I<3>)  provides an overview of the  C<CSV>  format in the most widely used"
NSQ_SOURCE_LINE 00001802 "applications and explains how it can best be used and supported."
NSQ_SOURCE_LINE 00001803 ""
NSQ_SOURCE_LINE 00001804 " 1) https://datatracker.ietf.org/doc/html/rfc4180"
NSQ_SOURCE_LINE 00001805 " 2) https://datatracker.ietf.org/doc/html/rfc7111"
NSQ_SOURCE_LINE 00001806 " 3) http://creativyst.com/Doc/Articles/CSV/CSV01.shtml"
NSQ_SOURCE_LINE 00001807 ""
NSQ_SOURCE_LINE 00001808 "The basic rules are as follows:"
NSQ_SOURCE_LINE 00001809 ""
NSQ_SOURCE_LINE 00001810 "B<CSV>  is a delimited data format that has fields/columns separated by the"
NSQ_SOURCE_LINE 00001811 "comma character and records/rows separated by newlines. Fields that contain"
NSQ_SOURCE_LINE 00001812 "a special character (comma, newline, or double quote),  must be enclosed in"
NSQ_SOURCE_LINE 00001813 "double quotes. However, if a line contains a single entry that is the empty"
NSQ_SOURCE_LINE 00001814 "string, it may be enclosed in double quotes.  If a field's value contains a"
NSQ_SOURCE_LINE 00001815 "double quote character it is escaped by placing another double quote"
NSQ_SOURCE_LINE 00001816 "character next to it. The C<CSV> file format does not require a specific"
NSQ_SOURCE_LINE 00001817 "character encoding, byte order, or line terminator format."
NSQ_SOURCE_LINE 00001818 ""
NSQ_SOURCE_LINE 00001819 "=over 2"
NSQ_SOURCE_LINE 00001820 ""
NSQ_SOURCE_LINE 00001821 "=item *"
NSQ_SOURCE_LINE 00001822 ""
NSQ_SOURCE_LINE 00001823 "Each record is a single line ended by a line feed  (ASCII/C<LF>=C<0x0A>) or"
NSQ_SOURCE_LINE 00001824 "a carriage return and line feed pair (ASCII/C<CRLF>=C<0x0D 0x0A>), however,"
NSQ_SOURCE_LINE 00001825 "line-breaks may be embedded."
NSQ_SOURCE_LINE 00001826 ""
NSQ_SOURCE_LINE 00001827 "=item *"
NSQ_SOURCE_LINE 00001828 ""
NSQ_SOURCE_LINE 00001829 "Fields are separated by commas."
NSQ_SOURCE_LINE 00001830 ""
NSQ_SOURCE_LINE 00001831 "=item *"
NSQ_SOURCE_LINE 00001832 ""
NSQ_SOURCE_LINE 00001833 "Allowable characters within a C<CSV> field include C<0x09> (C<TAB>) and the"
NSQ_SOURCE_LINE 00001834 "inclusive range of C<0x20> (space) through C<0x7E> (tilde).  In binary mode"
NSQ_SOURCE_LINE 00001835 "all characters are accepted, at least in quoted fields."
NSQ_SOURCE_LINE 00001836 ""
NSQ_SOURCE_LINE 00001837 "=item *"
NSQ_SOURCE_LINE 00001838 ""
NSQ_SOURCE_LINE 00001839 "A field within  C<CSV>  must be surrounded by  double-quotes to  contain  a"
NSQ_SOURCE_LINE 00001840 "separator character (comma)."
NSQ_SOURCE_LINE 00001841 ""
NSQ_SOURCE_LINE 00001842 "=back"
NSQ_SOURCE_LINE 00001843 ""
NSQ_SOURCE_LINE 00001844 "Though this is the most clear and restrictive definition,  Text::CSV_XS  is"
NSQ_SOURCE_LINE 00001845 "way more liberal than this, and allows extension:"
NSQ_SOURCE_LINE 00001846 ""
NSQ_SOURCE_LINE 00001847 "=over 2"
NSQ_SOURCE_LINE 00001848 ""
NSQ_SOURCE_LINE 00001849 "=item *"
NSQ_SOURCE_LINE 00001850 ""
NSQ_SOURCE_LINE 00001851 "Line termination by a single carriage return is accepted by default"
NSQ_SOURCE_LINE 00001852 ""
NSQ_SOURCE_LINE 00001853 "=item *"
NSQ_SOURCE_LINE 00001854 ""
NSQ_SOURCE_LINE 00001855 "The separation-, quote-, and escape character(s) can be any ASCII character"
NSQ_SOURCE_LINE 00001856 "in the range from  C<0x20> (space) to  C<0x7E> (tilde).  Characters outside"
NSQ_SOURCE_LINE 00001857 "this range may or may not work as expected.  Multibyte characters, like UTF"
NSQ_SOURCE_LINE 00001858 "C<U+060C> (ARABIC COMMA),   C<U+FF0C> (FULLWIDTH COMMA),  C<U+241B> (SYMBOL"
NSQ_SOURCE_LINE 00001859 "FOR ESCAPE), C<U+2424> (SYMBOL FOR NEWLINE), C<U+FF02> (FULLWIDTH QUOTATION"
NSQ_SOURCE_LINE 00001860 "MARK), and C<U+201C> (LEFT DOUBLE QUOTATION MARK) (to give some examples of"
NSQ_SOURCE_LINE 00001861 "what might look promising) work for newer versions of perl for C<sep_char>,"
NSQ_SOURCE_LINE 00001862 "and C<quote_char> but not for C<escape_char>."
NSQ_SOURCE_LINE 00001863 ""
NSQ_SOURCE_LINE 00001864 "If you use perl-5.8.2 or higher these three attributes are utf8-decoded, to"
NSQ_SOURCE_LINE 00001865 "increase the likelihood of success. This way C<U+00FE> will be allowed as a"
NSQ_SOURCE_LINE 00001866 "quote character."
NSQ_SOURCE_LINE 00001867 ""
NSQ_SOURCE_LINE 00001868 "=item *"
NSQ_SOURCE_LINE 00001869 ""
NSQ_SOURCE_LINE 00001870 "A field in  C<CSV>  must be surrounded by double-quotes to make an embedded"
NSQ_SOURCE_LINE 00001871 "double-quote, represented by a pair of consecutive double-quotes, valid. In"
NSQ_SOURCE_LINE 00001872 "binary mode you may additionally use the sequence  C<\"0> for representation"
NSQ_SOURCE_LINE 00001873 "of a NULL byte. Using C<0x00> in binary mode is just as valid."
NSQ_SOURCE_LINE 00001874 ""
NSQ_SOURCE_LINE 00001875 "=item *"
NSQ_SOURCE_LINE 00001876 ""
NSQ_SOURCE_LINE 00001877 "Several violations of the above specification may be lifted by passing some"
NSQ_SOURCE_LINE 00001878 "options as attributes to the object constructor."
NSQ_SOURCE_LINE 00001879 ""
NSQ_SOURCE_LINE 00001880 "=back"
NSQ_SOURCE_LINE 00001881 ""
NSQ_SOURCE_LINE 00001882 "=head1 METHODS"
NSQ_SOURCE_LINE 00001883 ""
NSQ_SOURCE_LINE 00001884 "=head2 version"
NSQ_SOURCE_LINE 00001885 "X<version>"
NSQ_SOURCE_LINE 00001886 ""
NSQ_SOURCE_LINE 00001887 "(Class method) Returns the current module version."
NSQ_SOURCE_LINE 00001888 ""
NSQ_SOURCE_LINE 00001889 "=head2 new"
NSQ_SOURCE_LINE 00001890 "X<new>"
NSQ_SOURCE_LINE 00001891 ""
NSQ_SOURCE_LINE 00001892 "(Class method) Returns a new instance of class Text::CSV_XS. The attributes"
NSQ_SOURCE_LINE 00001893 "are described by the (optional) hash ref C<\\%attr>."
NSQ_SOURCE_LINE 00001894 ""
NSQ_SOURCE_LINE 00001895 " my $csv = Text::CSV_XS->new ({ attributes ... });"
NSQ_SOURCE_LINE 00001896 ""
NSQ_SOURCE_LINE 00001897 "The following attributes are available:"
NSQ_SOURCE_LINE 00001898 ""
NSQ_SOURCE_LINE 00001899 "=head3 eol"
NSQ_SOURCE_LINE 00001900 "X<eol>"
NSQ_SOURCE_LINE 00001901 ""
NSQ_SOURCE_LINE 00001902 " my $csv = Text::CSV_XS->new ({ eol => $/ });"
NSQ_SOURCE_LINE 00001903 "           $csv->eol (undef);"
NSQ_SOURCE_LINE 00001904 " my $eol = $csv->eol;"
NSQ_SOURCE_LINE 00001905 ""
NSQ_SOURCE_LINE 00001906 "The end-of-line string to add to rows for L</print> or the record separator"
NSQ_SOURCE_LINE 00001907 "for L</getline>."
NSQ_SOURCE_LINE 00001908 ""
NSQ_SOURCE_LINE 00001909 "When not passed in a B<parser> instance,  the default behavior is to accept"
NSQ_SOURCE_LINE 00001910 "C<\\n>, C<\\r>, and C<\\r\\n>, so it is probably safer to not specify C<eol> at"
NSQ_SOURCE_LINE 00001911 "all. Passing C<undef> or the empty string behave the same."
NSQ_SOURCE_LINE 00001912 ""
NSQ_SOURCE_LINE 00001913 "When not passed in a B<generating> instance,  records are not terminated at"
NSQ_SOURCE_LINE 00001914 "all, so it is probably wise to pass something you expect. A safe choice for"
NSQ_SOURCE_LINE 00001915 "C<eol> on output is either C<$/> or C<\\r\\n>."
NSQ_SOURCE_LINE 00001916 ""
NSQ_SOURCE_LINE 00001917 "Common values for C<eol> are C<\"\\012\"> (C<\\n> or Line Feed),  C<\"\\015\\012\">"
NSQ_SOURCE_LINE 00001918 "(C<\\r\\n> or Carriage Return, Line Feed),  and C<\"\\015\">  (C<\\r> or Carriage"
NSQ_SOURCE_LINE 00001919 "Return). The L<C<eol>|/eol> attribute cannot exceed 7 (ASCII) characters."
NSQ_SOURCE_LINE 00001920 ""
NSQ_SOURCE_LINE 00001921 "If both C<$/> and L<C<eol>|/eol> equal C<\"\\015\">, parsing lines that end on"
NSQ_SOURCE_LINE 00001922 "only a Carriage Return without Line Feed, will be L</parse>d correct."
NSQ_SOURCE_LINE 00001923 ""
NSQ_SOURCE_LINE 00001924 "=head3 eol_type"
NSQ_SOURCE_LINE 00001925 "X<eol_type>"
NSQ_SOURCE_LINE 00001926 ""
NSQ_SOURCE_LINE 00001927 " my $eol = $csv->eol_type;"
NSQ_SOURCE_LINE 00001928 ""
NSQ_SOURCE_LINE 00001929 "This read-only method returns the internal state of  what is considered the"
NSQ_SOURCE_LINE 00001930 "valid EOL for parsing."
NSQ_SOURCE_LINE 00001931 ""
NSQ_SOURCE_LINE 00001932 "=head3 sep_char"
NSQ_SOURCE_LINE 00001933 "X<sep_char>"
NSQ_SOURCE_LINE 00001934 ""
NSQ_SOURCE_LINE 00001935 " my $csv = Text::CSV_XS->new ({ sep_char => \";\" });"
NSQ_SOURCE_LINE 00001936 "         $csv->sep_char (\";\");"
NSQ_SOURCE_LINE 00001937 " my $c = $csv->sep_char;"
NSQ_SOURCE_LINE 00001938 ""
NSQ_SOURCE_LINE 00001939 "The char used to separate fields, by default a comma. (C<,>).  Limited to a"
NSQ_SOURCE_LINE 00001940 "single-byte character, usually in the range from C<0x20> (space) to C<0x7E>"
NSQ_SOURCE_LINE 00001941 "(tilde). When longer sequences are required, use L<C<sep>|/sep>."
NSQ_SOURCE_LINE 00001942 ""
NSQ_SOURCE_LINE 00001943 "The separation character can not be equal to the quote character  or to the"
NSQ_SOURCE_LINE 00001944 "escape character."
NSQ_SOURCE_LINE 00001945 ""
NSQ_SOURCE_LINE 00001946 "See also L</CAVEATS>"
NSQ_SOURCE_LINE 00001947 ""
NSQ_SOURCE_LINE 00001948 "=head3 sep"
NSQ_SOURCE_LINE 00001949 "X<sep>"
NSQ_SOURCE_LINE 00001950 ""
NSQ_SOURCE_LINE 00001951 " my $csv = Text::CSV_XS->new ({ sep => \"\\N{FULLWIDTH COMMA}\" });"
NSQ_SOURCE_LINE 00001952 "           $csv->sep (\";\");"
NSQ_SOURCE_LINE 00001953 " my $sep = $csv->sep;"
NSQ_SOURCE_LINE 00001954 ""
NSQ_SOURCE_LINE 00001955 "The chars used to separate fields, by default undefined. Limited to 8 bytes."
NSQ_SOURCE_LINE 00001956 ""
NSQ_SOURCE_LINE 00001957 "When set, overrules L<C<sep_char>|/sep_char>.  If its length is one byte it"
NSQ_SOURCE_LINE 00001958 "acts as an alias to L<C<sep_char>|/sep_char>."
NSQ_SOURCE_LINE 00001959 ""
NSQ_SOURCE_LINE 00001960 "See also L</CAVEATS>"
NSQ_SOURCE_LINE 00001961 ""
NSQ_SOURCE_LINE 00001962 "=head3 quote_char"
NSQ_SOURCE_LINE 00001963 "X<quote_char>"
NSQ_SOURCE_LINE 00001964 ""
NSQ_SOURCE_LINE 00001965 " my $csv = Text::CSV_XS->new ({ quote_char => \"'\" });"
NSQ_SOURCE_LINE 00001966 "         $csv->quote_char (undef);"
NSQ_SOURCE_LINE 00001967 " my $c = $csv->quote_char;"
NSQ_SOURCE_LINE 00001968 ""
NSQ_SOURCE_LINE 00001969 "The character to quote fields containing blanks or binary data,  by default"
NSQ_SOURCE_LINE 00001970 "the double quote character (C<\">).  A value of undef suppresses quote chars"
NSQ_SOURCE_LINE 00001971 "(for simple cases only). Limited to a single-byte character, usually in the"
NSQ_SOURCE_LINE 00001972 "range from  C<0x20> (space) to  C<0x7E> (tilde).  When longer sequences are"
NSQ_SOURCE_LINE 00001973 "required, use L<C<quote>|/quote>."
NSQ_SOURCE_LINE 00001974 ""
NSQ_SOURCE_LINE 00001975 "C<quote_char> can not be equal to L<C<sep_char>|/sep_char>."
NSQ_SOURCE_LINE 00001976 ""
NSQ_SOURCE_LINE 00001977 "=head3 quote"
NSQ_SOURCE_LINE 00001978 "X<quote>"
NSQ_SOURCE_LINE 00001979 ""
NSQ_SOURCE_LINE 00001980 " my $csv = Text::CSV_XS->new ({ quote => \"\\N{FULLWIDTH QUOTATION MARK}\" });"
NSQ_SOURCE_LINE 00001981 "             $csv->quote (\"'\");"
NSQ_SOURCE_LINE 00001982 " my $quote = $csv->quote;"
NSQ_SOURCE_LINE 00001983 ""
NSQ_SOURCE_LINE 00001984 "The chars used to quote fields, by default undefined. Limited to 8 bytes."
NSQ_SOURCE_LINE 00001985 ""
NSQ_SOURCE_LINE 00001986 "When set, overrules L<C<quote_char>|/quote_char>. If its length is one byte"
NSQ_SOURCE_LINE 00001987 "it acts as an alias to L<C<quote_char>|/quote_char>."
NSQ_SOURCE_LINE 00001988 ""
NSQ_SOURCE_LINE 00001989 "This method does not support C<undef>.  Use L<C<quote_char>|/quote_char> to"
NSQ_SOURCE_LINE 00001990 "disable quotation."
NSQ_SOURCE_LINE 00001991 ""
NSQ_SOURCE_LINE 00001992 "See also L</CAVEATS>"
NSQ_SOURCE_LINE 00001993 ""
NSQ_SOURCE_LINE 00001994 "=head3 escape_char"
NSQ_SOURCE_LINE 00001995 "X<escape_char>"
NSQ_SOURCE_LINE 00001996 ""
NSQ_SOURCE_LINE 00001997 " my $csv = Text::CSV_XS->new ({ escape_char => \"\\\\\" });"
NSQ_SOURCE_LINE 00001998 "         $csv->escape_char (\":\");"
NSQ_SOURCE_LINE 00001999 " my $c = $csv->escape_char;"
NSQ_SOURCE_LINE 00002000 ""
NSQ_SOURCE_LINE 00002001 "The character to  escape  certain characters inside quoted fields.  This is"
NSQ_SOURCE_LINE 00002002 "limited to a  single-byte  character,  usually  in the  range from  C<0x20>"
NSQ_SOURCE_LINE 00002003 "(space) to C<0x7E> (tilde)."
NSQ_SOURCE_LINE 00002004 ""
NSQ_SOURCE_LINE 00002005 "The C<escape_char> defaults to being the double-quote mark (C<\">). In other"
NSQ_SOURCE_LINE 00002006 "words the same as the default L<C<quote_char>|/quote_char>. This means that"
NSQ_SOURCE_LINE 00002007 "doubling the quote mark in a field escapes it:"
NSQ_SOURCE_LINE 00002008 ""
NSQ_SOURCE_LINE 00002009 " \"foo\",\"bar\",\"Escape \"\"quote mark\"\" with two \"\"quote marks\"\"\",\"baz\""
NSQ_SOURCE_LINE 00002010 ""
NSQ_SOURCE_LINE 00002011 "If  you  change  the   L<C<quote_char>|/quote_char>  without  changing  the"
NSQ_SOURCE_LINE 00002012 "C<escape_char>,  the  C<escape_char> will still be the double-quote (C<\">)."
NSQ_SOURCE_LINE 00002013 "If instead you want to escape the  L<C<quote_char>|/quote_char> by doubling"
NSQ_SOURCE_LINE 00002014 "it you will need to also change the  C<escape_char>  to be the same as what"
NSQ_SOURCE_LINE 00002015 "you have changed the L<C<quote_char>|/quote_char> to."
NSQ_SOURCE_LINE 00002016 ""
NSQ_SOURCE_LINE 00002017 "Setting C<escape_char> to C<undef> or C<\"\"> will completely disable escapes"
NSQ_SOURCE_LINE 00002018 "and is greatly discouraged. This will also disable C<escape_null>."
NSQ_SOURCE_LINE 00002019 ""
NSQ_SOURCE_LINE 00002020 "The escape character can not be equal to the separation character."
NSQ_SOURCE_LINE 00002021 ""
NSQ_SOURCE_LINE 00002022 "=head3 binary"
NSQ_SOURCE_LINE 00002023 "X<binary>"
NSQ_SOURCE_LINE 00002024 ""
NSQ_SOURCE_LINE 00002025 " my $csv = Text::CSV_XS->new ({ binary => 1 });"
NSQ_SOURCE_LINE 00002026 "         $csv->binary (0);"
NSQ_SOURCE_LINE 00002027 " my $f = $csv->binary;"
NSQ_SOURCE_LINE 00002028 ""
NSQ_SOURCE_LINE 00002029 "If this attribute is C<1>,  you may use binary characters in quoted fields,"
NSQ_SOURCE_LINE 00002030 "including line feeds, carriage returns and C<NULL> bytes. (The latter could"
NSQ_SOURCE_LINE 00002031 "be escaped as C<\"0>.) By default this feature is off."
NSQ_SOURCE_LINE 00002032 ""
NSQ_SOURCE_LINE 00002033 "If a string is marked UTF8,  C<binary> will be turned on automatically when"
NSQ_SOURCE_LINE 00002034 "binary characters other than C<CR> and C<NL> are encountered.   Note that a"
NSQ_SOURCE_LINE 00002035 "simple string like C<\"\\x{00a0}\"> might still be binary, but not marked UTF8,"
NSQ_SOURCE_LINE 00002036 "so setting C<< { binary => 1 } >> is still a wise option."
NSQ_SOURCE_LINE 00002037 ""
NSQ_SOURCE_LINE 00002038 "=head3 strict"
NSQ_SOURCE_LINE 00002039 "X<strict>"
NSQ_SOURCE_LINE 00002040 ""
NSQ_SOURCE_LINE 00002041 " my $csv = Text::CSV_XS->new ({ strict => 1 });"
NSQ_SOURCE_LINE 00002042 "         $csv->strict (0);"
NSQ_SOURCE_LINE 00002043 " my $f = $csv->strict;"
NSQ_SOURCE_LINE 00002044 ""
NSQ_SOURCE_LINE 00002045 "If this attribute is set to C<1>, any row that parses to a different number"
NSQ_SOURCE_LINE 00002046 "of fields than the previous row will cause the parser to throw error 2014."
NSQ_SOURCE_LINE 00002047 ""
NSQ_SOURCE_LINE 00002048 "Empty rows or rows that result in no fields (like comment lines) are exempt"
NSQ_SOURCE_LINE 00002049 "from these checks."
NSQ_SOURCE_LINE 00002050 ""
NSQ_SOURCE_LINE 00002051 "=head3 strict_eol"
NSQ_SOURCE_LINE 00002052 "X<strict_eol>"
NSQ_SOURCE_LINE 00002053 ""
NSQ_SOURCE_LINE 00002054 " my $csv = Text::CSV_XS->new ({ strict_eol => 1 });"
NSQ_SOURCE_LINE 00002055 "         $csv->strict_eol (0);"
NSQ_SOURCE_LINE 00002056 " my $f = $csv->strict_eol;"
NSQ_SOURCE_LINE 00002057 ""
NSQ_SOURCE_LINE 00002058 "If this attribute is set to C<0>, no EOL consistency checks are done."
NSQ_SOURCE_LINE 00002059 ""
NSQ_SOURCE_LINE 00002060 "If this attribute is set to C<1>, any row that parses with a EOL other than"
NSQ_SOURCE_LINE 00002061 "the EOL from the first row will cause a warning.  The error will be ignored"
NSQ_SOURCE_LINE 00002062 "and parsing continues. This warning is only thrown once.  Note that in data"
NSQ_SOURCE_LINE 00002063 "with various different line endings, C<\\r\\r> will still throw an error that"
NSQ_SOURCE_LINE 00002064 "cannot be ignored."
NSQ_SOURCE_LINE 00002065 ""
NSQ_SOURCE_LINE 00002066 "If this attribute is set to C<2> or higher,  any row that parses with a EOL"
NSQ_SOURCE_LINE 00002067 "other than the EOL from the first row will cause error C<2016> to be thrown."
NSQ_SOURCE_LINE 00002068 "The line being parsed to this error might not be stored in the result."
NSQ_SOURCE_LINE 00002069 ""
NSQ_SOURCE_LINE 00002070 "=head3 skip_empty_rows"
NSQ_SOURCE_LINE 00002071 "X<skip_empty_rows>"
NSQ_SOURCE_LINE 00002072 ""
NSQ_SOURCE_LINE 00002073 " my $csv = Text::CSV_XS->new ({ skip_empty_rows => 1 });"
NSQ_SOURCE_LINE 00002074 "         $csv->skip_empty_rows (\"eof\");"
NSQ_SOURCE_LINE 00002075 " my $f = $csv->skip_empty_rows;"
NSQ_SOURCE_LINE 00002076 ""
NSQ_SOURCE_LINE 00002077 "This attribute defines the behavior for empty rows:  an L</eol> immediately"
NSQ_SOURCE_LINE 00002078 "following the start of line. Default behavior is to return one single empty"
NSQ_SOURCE_LINE 00002079 "field."
NSQ_SOURCE_LINE 00002080 ""
NSQ_SOURCE_LINE 00002081 "This attribute is only used in parsing.  This attribute is ineffective when"
NSQ_SOURCE_LINE 00002082 "using L</parse> and L</fields>."
NSQ_SOURCE_LINE 00002083 ""
NSQ_SOURCE_LINE 00002084 "Possible values for this attribute are"
NSQ_SOURCE_LINE 00002085 ""
NSQ_SOURCE_LINE 00002086 "=over 2"
NSQ_SOURCE_LINE 00002087 ""
NSQ_SOURCE_LINE 00002088 "=item 0 | undef"
NSQ_SOURCE_LINE 00002089 ""
NSQ_SOURCE_LINE 00002090 " my $csv = Text::CSV_XS->new ({ skip_empty_rows => 0 });"
NSQ_SOURCE_LINE 00002091 " $csv->skip_empty_rows (undef);"
NSQ_SOURCE_LINE 00002092 ""
NSQ_SOURCE_LINE 00002093 "No special action is taken. The result will be one single empty field."
NSQ_SOURCE_LINE 00002094 ""
NSQ_SOURCE_LINE 00002095 "=item 1 | \"skip\""
NSQ_SOURCE_LINE 00002096 ""
NSQ_SOURCE_LINE 00002097 " my $csv = Text::CSV_XS->new ({ skip_empty_rows => 1 });"
NSQ_SOURCE_LINE 00002098 " $csv->skip_empty_rows (\"skip\");"
NSQ_SOURCE_LINE 00002099 ""
NSQ_SOURCE_LINE 00002100 "The row will be skipped."
NSQ_SOURCE_LINE 00002101 ""
NSQ_SOURCE_LINE 00002102 "=item 2 | \"eof\" | \"stop\""
NSQ_SOURCE_LINE 00002103 ""
NSQ_SOURCE_LINE 00002104 " my $csv = Text::CSV_XS->new ({ skip_empty_rows => 2 });"
NSQ_SOURCE_LINE 00002105 " $csv->skip_empty_rows (\"eof\");"
NSQ_SOURCE_LINE 00002106 ""
NSQ_SOURCE_LINE 00002107 "The parsing will stop as if an L</eof> was detected."
NSQ_SOURCE_LINE 00002108 ""
NSQ_SOURCE_LINE 00002109 "=item 3 | \"die\""
NSQ_SOURCE_LINE 00002110 ""
NSQ_SOURCE_LINE 00002111 " my $csv = Text::CSV_XS->new ({ skip_empty_rows => 3 });"
NSQ_SOURCE_LINE 00002112 " $csv->skip_empty_rows (\"die\");"
NSQ_SOURCE_LINE 00002113 ""
NSQ_SOURCE_LINE 00002114 "The parsing will stop.  The internal error code will be set to 2015 and the"
NSQ_SOURCE_LINE 00002115 "parser will C<die>."
NSQ_SOURCE_LINE 00002116 ""
NSQ_SOURCE_LINE 00002117 "=item 4 | \"croak\""
NSQ_SOURCE_LINE 00002118 ""
NSQ_SOURCE_LINE 00002119 " my $csv = Text::CSV_XS->new ({ skip_empty_rows => 4 });"
NSQ_SOURCE_LINE 00002120 " $csv->skip_empty_rows (\"croak\");"
NSQ_SOURCE_LINE 00002121 ""
NSQ_SOURCE_LINE 00002122 "The parsing will stop.  The internal error code will be set to 2015 and the"
NSQ_SOURCE_LINE 00002123 "parser will C<croak>."
NSQ_SOURCE_LINE 00002124 ""
NSQ_SOURCE_LINE 00002125 "=item 5 | \"error\""
NSQ_SOURCE_LINE 00002126 ""
NSQ_SOURCE_LINE 00002127 " my $csv = Text::CSV_XS->new ({ skip_empty_rows => 5 });"
NSQ_SOURCE_LINE 00002128 " $csv->skip_empty_rows (\"error\");"
NSQ_SOURCE_LINE 00002129 ""
NSQ_SOURCE_LINE 00002130 "The parsing will fail.  The internal error code will be set to 2015."
NSQ_SOURCE_LINE 00002131 ""
NSQ_SOURCE_LINE 00002132 "=item callback"
NSQ_SOURCE_LINE 00002133 ""
NSQ_SOURCE_LINE 00002134 " my $csv = Text::CSV_XS->new ({ skip_empty_rows => sub { [] } });"
NSQ_SOURCE_LINE 00002135 " $csv->skip_empty_rows (sub { [ 42, $., undef, \"empty\" ] });"
NSQ_SOURCE_LINE 00002136 ""
NSQ_SOURCE_LINE 00002137 "The callback is invoked and its result used instead.  If you want the parse"
NSQ_SOURCE_LINE 00002138 "to stop after the callback, make sure to return a false value."
NSQ_SOURCE_LINE 00002139 ""
NSQ_SOURCE_LINE 00002140 "The returned value from the callback should be an array-ref. Any other type"
NSQ_SOURCE_LINE 00002141 "will cause the parse to stop, so these are equivalent in behavior:"
NSQ_SOURCE_LINE 00002142 ""
NSQ_SOURCE_LINE 00002143 " csv (in => $fh, skip_empty_rows => \"stop\");"
NSQ_SOURCE_LINE 00002144 " csv (in => $fh. skip_empty_rows => sub { 0; });"
NSQ_SOURCE_LINE 00002145 ""
NSQ_SOURCE_LINE 00002146 "=back"
NSQ_SOURCE_LINE 00002147 ""
NSQ_SOURCE_LINE 00002148 "Without arguments, the current value is returned: C<0>, C<1>, C<eof>, C<die>,"
NSQ_SOURCE_LINE 00002149 "C<croak> or the callback."
NSQ_SOURCE_LINE 00002150 ""
NSQ_SOURCE_LINE 00002151 "=head3 formula_handling"
NSQ_SOURCE_LINE 00002152 "X<formula_handling>"
NSQ_SOURCE_LINE 00002153 ""
NSQ_SOURCE_LINE 00002154 "Alias for L</formula>"
NSQ_SOURCE_LINE 00002155 ""
NSQ_SOURCE_LINE 00002156 "=head3 formula"
NSQ_SOURCE_LINE 00002157 "X<formula>"
NSQ_SOURCE_LINE 00002158 ""
NSQ_SOURCE_LINE 00002159 " my $csv = Text::CSV_XS->new ({ formula => \"none\" });"
NSQ_SOURCE_LINE 00002160 "         $csv->formula (\"none\");"
NSQ_SOURCE_LINE 00002161 " my $f = $csv->formula;"
NSQ_SOURCE_LINE 00002162 ""
NSQ_SOURCE_LINE 00002163 "This defines the behavior of fields containing I<formulas>. As formulas are"
NSQ_SOURCE_LINE 00002164 "considered dangerous in spreadsheets, this attribute can define an optional"
NSQ_SOURCE_LINE 00002165 "action to be taken if a field starts with an equal sign (C<=>)."
NSQ_SOURCE_LINE 00002166 ""
NSQ_SOURCE_LINE 00002167 "For purpose of code-readability, this can also be written as"
NSQ_SOURCE_LINE 00002168 ""
NSQ_SOURCE_LINE 00002169 " my $csv = Text::CSV_XS->new ({ formula_handling => \"none\" });"
NSQ_SOURCE_LINE 00002170 "         $csv->formula_handling (\"none\");"
NSQ_SOURCE_LINE 00002171 " my $f = $csv->formula_handling;"
NSQ_SOURCE_LINE 00002172 ""
NSQ_SOURCE_LINE 00002173 "Possible values for this attribute are"
NSQ_SOURCE_LINE 00002174 ""
NSQ_SOURCE_LINE 00002175 "=over 2"
NSQ_SOURCE_LINE 00002176 ""
NSQ_SOURCE_LINE 00002177 "=item none"
NSQ_SOURCE_LINE 00002178 ""
NSQ_SOURCE_LINE 00002179 "Take no specific action. This is the default."
NSQ_SOURCE_LINE 00002180 ""
NSQ_SOURCE_LINE 00002181 " $csv->formula (\"none\");"
NSQ_SOURCE_LINE 00002182 ""
NSQ_SOURCE_LINE 00002183 "=item die"
NSQ_SOURCE_LINE 00002184 ""
NSQ_SOURCE_LINE 00002185 "Cause the process to C<die> whenever a leading C<=> is encountered."
NSQ_SOURCE_LINE 00002186 ""
NSQ_SOURCE_LINE 00002187 " $csv->formula (\"die\");"
NSQ_SOURCE_LINE 00002188 ""
NSQ_SOURCE_LINE 00002189 "=item croak"
NSQ_SOURCE_LINE 00002190 ""
NSQ_SOURCE_LINE 00002191 "Cause the process to C<croak> whenever a leading C<=> is encountered.  (See"
NSQ_SOURCE_LINE 00002192 "L<Carp>)"
NSQ_SOURCE_LINE 00002193 ""
NSQ_SOURCE_LINE 00002194 " $csv->formula (\"croak\");"
NSQ_SOURCE_LINE 00002195 ""
NSQ_SOURCE_LINE 00002196 "=item diag"
NSQ_SOURCE_LINE 00002197 ""
NSQ_SOURCE_LINE 00002198 "Report position and content of the field whenever a leading  C<=> is found."
NSQ_SOURCE_LINE 00002199 "The value of the field is unchanged."
NSQ_SOURCE_LINE 00002200 ""
NSQ_SOURCE_LINE 00002201 " $csv->formula (\"diag\");"
NSQ_SOURCE_LINE 00002202 ""
NSQ_SOURCE_LINE 00002203 "=item empty"
NSQ_SOURCE_LINE 00002204 ""
NSQ_SOURCE_LINE 00002205 "Replace the content of fields that start with a C<=> with the empty string."
NSQ_SOURCE_LINE 00002206 ""
NSQ_SOURCE_LINE 00002207 " $csv->formula (\"empty\");"
NSQ_SOURCE_LINE 00002208 " $csv->formula (\"\");"
NSQ_SOURCE_LINE 00002209 ""
NSQ_SOURCE_LINE 00002210 "=item undef"
NSQ_SOURCE_LINE 00002211 ""
NSQ_SOURCE_LINE 00002212 "Replace the content of fields that start with a C<=> with C<undef>."
NSQ_SOURCE_LINE 00002213 ""
NSQ_SOURCE_LINE 00002214 " $csv->formula (\"undef\");"
NSQ_SOURCE_LINE 00002215 " $csv->formula (undef);"
NSQ_SOURCE_LINE 00002216 ""
NSQ_SOURCE_LINE 00002217 "=item a callback"
NSQ_SOURCE_LINE 00002218 ""
NSQ_SOURCE_LINE 00002219 "Modify the content of fields that start with a  C<=>  with the return-value"
NSQ_SOURCE_LINE 00002220 "of the callback.  The original content of the field is available inside the"
NSQ_SOURCE_LINE 00002221 "callback as C<$_>;"
NSQ_SOURCE_LINE 00002222 ""
NSQ_SOURCE_LINE 00002223 " # Replace all formula's with 42"
NSQ_SOURCE_LINE 00002224 " $csv->formula (sub { 42; });"
NSQ_SOURCE_LINE 00002225 ""
NSQ_SOURCE_LINE 00002226 " # same as $csv->formula (\"empty\") but slower"
NSQ_SOURCE_LINE 00002227 " $csv->formula (sub { \"\" });"
NSQ_SOURCE_LINE 00002228 ""
NSQ_SOURCE_LINE 00002229 " # Allow =4+12"
NSQ_SOURCE_LINE 00002230 " $csv->formula (sub { s/^=(\\d+\\+\\d+)$/$1/eer });"
NSQ_SOURCE_LINE 00002231 ""
NSQ_SOURCE_LINE 00002232 " # Allow more complex calculations"
NSQ_SOURCE_LINE 00002233 " $csv->formula (sub { eval { s{^=([-+*/0-9()]+)$}{$1}ee }; $_ });"
NSQ_SOURCE_LINE 00002234 ""
NSQ_SOURCE_LINE 00002235 "=back"
NSQ_SOURCE_LINE 00002236 ""
NSQ_SOURCE_LINE 00002237 "All other values will give a warning and then fallback to C<diag>."
NSQ_SOURCE_LINE 00002238 ""
NSQ_SOURCE_LINE 00002239 "=head3 decode_utf8"
NSQ_SOURCE_LINE 00002240 "X<decode_utf8>"
NSQ_SOURCE_LINE 00002241 ""
NSQ_SOURCE_LINE 00002242 " my $csv = Text::CSV_XS->new ({ decode_utf8 => 1 });"
NSQ_SOURCE_LINE 00002243 "         $csv->decode_utf8 (0);"
NSQ_SOURCE_LINE 00002244 " my $f = $csv->decode_utf8;"
NSQ_SOURCE_LINE 00002245 ""
NSQ_SOURCE_LINE 00002246 "This attributes defaults to TRUE."
NSQ_SOURCE_LINE 00002247 ""
NSQ_SOURCE_LINE 00002248 "While I<parsing>,  fields that are valid UTF-8, are automatically set to be"
NSQ_SOURCE_LINE 00002249 "UTF-8, so that"
NSQ_SOURCE_LINE 00002250 ""
NSQ_SOURCE_LINE 00002251 "  $csv->parse (\"\\xC4\\xA8\\n\");"
NSQ_SOURCE_LINE 00002252 ""
NSQ_SOURCE_LINE 00002253 "results in"
NSQ_SOURCE_LINE 00002254 ""
NSQ_SOURCE_LINE 00002255 "  PV(\"\\304\\250\"\\0) [UTF8 \"\\x{128}\"]"
NSQ_SOURCE_LINE 00002256 ""
NSQ_SOURCE_LINE 00002257 "Sometimes it might not be a desired action.  To prevent those upgrades, set"
NSQ_SOURCE_LINE 00002258 "this attribute to false, and the result will be"
NSQ_SOURCE_LINE 00002259 ""
NSQ_SOURCE_LINE 00002260 "  PV(\"\\304\\250\"\\0)"
NSQ_SOURCE_LINE 00002261 ""
NSQ_SOURCE_LINE 00002262 "=head3 auto_diag"
NSQ_SOURCE_LINE 00002263 "X<auto_diag>"
NSQ_SOURCE_LINE 00002264 ""
NSQ_SOURCE_LINE 00002265 " my $csv = Text::CSV_XS->new ({ auto_diag => 1 });"
NSQ_SOURCE_LINE 00002266 "         $csv->auto_diag (2);"
NSQ_SOURCE_LINE 00002267 " my $l = $csv->auto_diag;"
NSQ_SOURCE_LINE 00002268 ""
NSQ_SOURCE_LINE 00002269 "Set this attribute to a number between C<1> and C<9> causes  L</error_diag>"
NSQ_SOURCE_LINE 00002270 "to be automatically called in void context upon errors."
NSQ_SOURCE_LINE 00002271 ""
NSQ_SOURCE_LINE 00002272 "In case of error C<2012 - EOF>, this call will be void."
NSQ_SOURCE_LINE 00002273 ""
NSQ_SOURCE_LINE 00002274 "If C<auto_diag> is set to a numeric value greater than C<1>, it will C<die>"
NSQ_SOURCE_LINE 00002275 "on errors instead of C<warn>.  If set to anything unrecognized,  it will be"
NSQ_SOURCE_LINE 00002276 "silently ignored."
NSQ_SOURCE_LINE 00002277 ""
NSQ_SOURCE_LINE 00002278 "Future extensions to this feature will include more reliable auto-detection"
NSQ_SOURCE_LINE 00002279 "of  C<autodie>  being active in the scope of which the error occurred which"
NSQ_SOURCE_LINE 00002280 "will increment the value of C<auto_diag> with  C<1> the moment the error is"
NSQ_SOURCE_LINE 00002281 "detected."
NSQ_SOURCE_LINE 00002282 ""
NSQ_SOURCE_LINE 00002283 "=head3 diag_verbose"
NSQ_SOURCE_LINE 00002284 "X<diag_verbose>"
NSQ_SOURCE_LINE 00002285 ""
NSQ_SOURCE_LINE 00002286 " my $csv = Text::CSV_XS->new ({ diag_verbose => 1 });"
NSQ_SOURCE_LINE 00002287 "         $csv->diag_verbose (2);"
NSQ_SOURCE_LINE 00002288 " my $l = $csv->diag_verbose;"
NSQ_SOURCE_LINE 00002289 ""
NSQ_SOURCE_LINE 00002290 "Set the verbosity of the output triggered by C<auto_diag>.   Currently only"
NSQ_SOURCE_LINE 00002291 "adds the current  input-record-number  (if known)  to the diagnostic output"
NSQ_SOURCE_LINE 00002292 "with an indication of the position of the error."
NSQ_SOURCE_LINE 00002293 ""
NSQ_SOURCE_LINE 00002294 "=head3 blank_is_undef"
NSQ_SOURCE_LINE 00002295 "X<blank_is_undef>"
NSQ_SOURCE_LINE 00002296 ""
NSQ_SOURCE_LINE 00002297 " my $csv = Text::CSV_XS->new ({ blank_is_undef => 1 });"
NSQ_SOURCE_LINE 00002298 "         $csv->blank_is_undef (0);"
NSQ_SOURCE_LINE 00002299 " my $f = $csv->blank_is_undef;"
NSQ_SOURCE_LINE 00002300 ""
NSQ_SOURCE_LINE 00002301 "Under normal circumstances, C<CSV> data makes no distinction between quoted-"
NSQ_SOURCE_LINE 00002302 "and unquoted empty fields.  These both end up in an empty string field once"
NSQ_SOURCE_LINE 00002303 "read, thus"
NSQ_SOURCE_LINE 00002304 ""
NSQ_SOURCE_LINE 00002305 " 1,\"\",,\" \",2"
NSQ_SOURCE_LINE 00002306 ""
NSQ_SOURCE_LINE 00002307 "is read as"
NSQ_SOURCE_LINE 00002308 ""
NSQ_SOURCE_LINE 00002309 " (\"1\", \"\", \"\", \" \", \"2\")"
NSQ_SOURCE_LINE 00002310 ""
NSQ_SOURCE_LINE 00002311 "When I<writing>  C<CSV> files with either  L<C<always_quote>|/always_quote>"
NSQ_SOURCE_LINE 00002312 "or  L<C<quote_empty>|/quote_empty> set, the unquoted  I<empty> field is the"
NSQ_SOURCE_LINE 00002313 "result of an undefined value.   To enable this distinction when  I<reading>"
NSQ_SOURCE_LINE 00002314 "C<CSV>  data,  the  C<blank_is_undef>  attribute will cause  unquoted empty"
NSQ_SOURCE_LINE 00002315 "fields to be set to C<undef>, causing the above to be parsed as"
NSQ_SOURCE_LINE 00002316 ""
NSQ_SOURCE_LINE 00002317 " (\"1\", \"\", undef, \" \", \"2\")"
NSQ_SOURCE_LINE 00002318 ""
NSQ_SOURCE_LINE 00002319 "Note that this is specifically important when loading  C<CSV> fields into a"
NSQ_SOURCE_LINE 00002320 "database that allows C<NULL> values,  as the perl equivalent for C<NULL> is"
NSQ_SOURCE_LINE 00002321 "C<undef> in L<DBI> land."
NSQ_SOURCE_LINE 00002322 ""
NSQ_SOURCE_LINE 00002323 "=head3 empty_is_undef"
NSQ_SOURCE_LINE 00002324 "X<empty_is_undef>"
NSQ_SOURCE_LINE 00002325 ""
NSQ_SOURCE_LINE 00002326 " my $csv = Text::CSV_XS->new ({ empty_is_undef => 1 });"
NSQ_SOURCE_LINE 00002327 "         $csv->empty_is_undef (0);"
NSQ_SOURCE_LINE 00002328 " my $f = $csv->empty_is_undef;"
NSQ_SOURCE_LINE 00002329 ""
NSQ_SOURCE_LINE 00002330 "Going one  step  further  than  L<C<blank_is_undef>|/blank_is_undef>,  this"
NSQ_SOURCE_LINE 00002331 "attribute converts all empty fields to C<undef>, so"
NSQ_SOURCE_LINE 00002332 ""
NSQ_SOURCE_LINE 00002333 " 1,\"\",,\" \",2"
NSQ_SOURCE_LINE 00002334 ""
NSQ_SOURCE_LINE 00002335 "is read as"
NSQ_SOURCE_LINE 00002336 ""
NSQ_SOURCE_LINE 00002337 " (1, undef, undef, \" \", 2)"
NSQ_SOURCE_LINE 00002338 ""
NSQ_SOURCE_LINE 00002339 "Note that this affects only fields that are  originally  empty,  not fields"
NSQ_SOURCE_LINE 00002340 "that are empty after stripping allowed whitespace. YMMV."
NSQ_SOURCE_LINE 00002341 ""
NSQ_SOURCE_LINE 00002342 "=head3 allow_whitespace"
NSQ_SOURCE_LINE 00002343 "X<allow_whitespace>"
NSQ_SOURCE_LINE 00002344 ""
NSQ_SOURCE_LINE 00002345 " my $csv = Text::CSV_XS->new ({ allow_whitespace => 1 });"
NSQ_SOURCE_LINE 00002346 "         $csv->allow_whitespace (0);"
NSQ_SOURCE_LINE 00002347 " my $f = $csv->allow_whitespace;"
NSQ_SOURCE_LINE 00002348 ""
NSQ_SOURCE_LINE 00002349 "When this option is set to true,  the whitespace  (C<TAB>'s and C<SPACE>'s)"
NSQ_SOURCE_LINE 00002350 "surrounding  the  separation character  is removed when parsing.  If either"
NSQ_SOURCE_LINE 00002351 "C<TAB> or C<SPACE> is one of the three characters L<C<sep_char>|/sep_char>,"
NSQ_SOURCE_LINE 00002352 "L<C<quote_char>|/quote_char>, or L<C<escape_char>|/escape_char> it will not"
NSQ_SOURCE_LINE 00002353 "be considered whitespace."
NSQ_SOURCE_LINE 00002354 ""
NSQ_SOURCE_LINE 00002355 "Now lines like:"
NSQ_SOURCE_LINE 00002356 ""
NSQ_SOURCE_LINE 00002357 " 1 , \"foo\" , bar , 3 , zapp"
NSQ_SOURCE_LINE 00002358 ""
NSQ_SOURCE_LINE 00002359 "are parsed as valid C<CSV>, even though it violates the C<CSV> specs."
NSQ_SOURCE_LINE 00002360 ""
NSQ_SOURCE_LINE 00002361 "Note that  B<all>  whitespace is stripped from both  start and  end of each"
NSQ_SOURCE_LINE 00002362 "field.  That would make it  I<more> than a I<feature> to enable parsing bad"
NSQ_SOURCE_LINE 00002363 "C<CSV> lines, as"
NSQ_SOURCE_LINE 00002364 ""
NSQ_SOURCE_LINE 00002365 " 1,   2.0,  3,   ape  , monkey"
NSQ_SOURCE_LINE 00002366 ""
NSQ_SOURCE_LINE 00002367 "will now be parsed as"
NSQ_SOURCE_LINE 00002368 ""
NSQ_SOURCE_LINE 00002369 " (\"1\", \"2.0\", \"3\", \"ape\", \"monkey\")"
NSQ_SOURCE_LINE 00002370 ""
NSQ_SOURCE_LINE 00002371 "even if the original line was perfectly acceptable C<CSV>."
NSQ_SOURCE_LINE 00002372 ""
NSQ_SOURCE_LINE 00002373 "=head3 allow_loose_quotes"
NSQ_SOURCE_LINE 00002374 "X<allow_loose_quotes>"
NSQ_SOURCE_LINE 00002375 ""
NSQ_SOURCE_LINE 00002376 " my $csv = Text::CSV_XS->new ({ allow_loose_quotes => 1 });"
NSQ_SOURCE_LINE 00002377 "         $csv->allow_loose_quotes (0);"
NSQ_SOURCE_LINE 00002378 " my $f = $csv->allow_loose_quotes;"
NSQ_SOURCE_LINE 00002379 ""
NSQ_SOURCE_LINE 00002380 "By default, parsing unquoted fields containing L<C<quote_char>|/quote_char>"
NSQ_SOURCE_LINE 00002381 "characters like"
NSQ_SOURCE_LINE 00002382 ""
NSQ_SOURCE_LINE 00002383 " 1,foo \"bar\" baz,42"
NSQ_SOURCE_LINE 00002384 ""
NSQ_SOURCE_LINE 00002385 "would result in parse error 2034.  Though it is still bad practice to allow"
NSQ_SOURCE_LINE 00002386 "this format,  we  cannot  help  the  fact  that  some  vendors  make  their"
NSQ_SOURCE_LINE 00002387 "applications spit out lines styled this way."
NSQ_SOURCE_LINE 00002388 ""
NSQ_SOURCE_LINE 00002389 "If there is B<really> bad C<CSV> data, like"
NSQ_SOURCE_LINE 00002390 ""
NSQ_SOURCE_LINE 00002391 " 1,\"foo \"bar\" baz\",42"
NSQ_SOURCE_LINE 00002392 ""
NSQ_SOURCE_LINE 00002393 "or"
NSQ_SOURCE_LINE 00002394 ""
NSQ_SOURCE_LINE 00002395 " 1,\"\"foo bar baz\"\",42"
NSQ_SOURCE_LINE 00002396 ""
NSQ_SOURCE_LINE 00002397 "there is a way to get this data-line parsed and leave the quotes inside the"
NSQ_SOURCE_LINE 00002398 "quoted field as-is.  This can be achieved by setting  C<allow_loose_quotes>"
NSQ_SOURCE_LINE 00002399 "B<AND> making sure that the L<C<escape_char>|/escape_char> is  I<not> equal"
NSQ_SOURCE_LINE 00002400 "to L<C<quote_char>|/quote_char>."
NSQ_SOURCE_LINE 00002401 ""
NSQ_SOURCE_LINE 00002402 "=head3 allow_loose_escapes"
NSQ_SOURCE_LINE 00002403 "X<allow_loose_escapes>"
NSQ_SOURCE_LINE 00002404 ""
NSQ_SOURCE_LINE 00002405 " my $csv = Text::CSV_XS->new ({ allow_loose_escapes => 1 });"
NSQ_SOURCE_LINE 00002406 "         $csv->allow_loose_escapes (0);"
NSQ_SOURCE_LINE 00002407 " my $f = $csv->allow_loose_escapes;"
NSQ_SOURCE_LINE 00002408 ""
NSQ_SOURCE_LINE 00002409 "Parsing fields  that  have  L<C<escape_char>|/escape_char>  characters that"
NSQ_SOURCE_LINE 00002410 "escape characters that do not need to be escaped, like:"
NSQ_SOURCE_LINE 00002411 ""
NSQ_SOURCE_LINE 00002412 " my $csv = Text::CSV_XS->new ({ escape_char => \"\\\\\" });"
NSQ_SOURCE_LINE 00002413 " $csv->parse (qq{1,\"my bar\\'s\",baz,42});"
NSQ_SOURCE_LINE 00002414 ""
NSQ_SOURCE_LINE 00002415 "would result in parse error 2025.   Though it is bad practice to allow this"
NSQ_SOURCE_LINE 00002416 "format,  this attribute enables you to treat all escape character sequences"
NSQ_SOURCE_LINE 00002417 "equal."
NSQ_SOURCE_LINE 00002418 ""
NSQ_SOURCE_LINE 00002419 "=head3 allow_unquoted_escape"
NSQ_SOURCE_LINE 00002420 "X<allow_unquoted_escape>"
NSQ_SOURCE_LINE 00002421 ""
NSQ_SOURCE_LINE 00002422 " my $csv = Text::CSV_XS->new ({ allow_unquoted_escape => 1 });"
NSQ_SOURCE_LINE 00002423 "         $csv->allow_unquoted_escape (0);"
NSQ_SOURCE_LINE 00002424 " my $f = $csv->allow_unquoted_escape;"
NSQ_SOURCE_LINE 00002425 ""
NSQ_SOURCE_LINE 00002426 "A backward compatibility issue where L<C<escape_char>|/escape_char> differs"
NSQ_SOURCE_LINE 00002427 "from L<C<quote_char>|/quote_char>  prevents  L<C<escape_char>|/escape_char>"
NSQ_SOURCE_LINE 00002428 "to be in the first position of a field.  If L<C<quote_char>|/quote_char> is"
NSQ_SOURCE_LINE 00002429 "equal to the default C<\"> and L<C<escape_char>|/escape_char> is set to C<\\>,"
NSQ_SOURCE_LINE 00002430 "this would be illegal:"
NSQ_SOURCE_LINE 00002431 ""
NSQ_SOURCE_LINE 00002432 " 1,\\0,2"
NSQ_SOURCE_LINE 00002433 ""
NSQ_SOURCE_LINE 00002434 "Setting this attribute to C<1>  might help to overcome issues with backward"
NSQ_SOURCE_LINE 00002435 "compatibility and allow this style."
NSQ_SOURCE_LINE 00002436 ""
NSQ_SOURCE_LINE 00002437 "=head3 always_quote"
NSQ_SOURCE_LINE 00002438 "X<always_quote>"
NSQ_SOURCE_LINE 00002439 ""
NSQ_SOURCE_LINE 00002440 " my $csv = Text::CSV_XS->new ({ always_quote => 1 });"
NSQ_SOURCE_LINE 00002441 "         $csv->always_quote (0);"
NSQ_SOURCE_LINE 00002442 " my $f = $csv->always_quote;"
NSQ_SOURCE_LINE 00002443 ""
NSQ_SOURCE_LINE 00002444 "By default the generated fields are quoted only if they I<need> to be.  For"
NSQ_SOURCE_LINE 00002445 "example, if they contain the separator character. If you set this attribute"
NSQ_SOURCE_LINE 00002446 "to C<1> then I<all> defined fields will be quoted. (C<undef> fields are not"
NSQ_SOURCE_LINE 00002447 "quoted, see L</blank_is_undef>). This makes it quite often easier to handle"
NSQ_SOURCE_LINE 00002448 "exported data in external applications.   (Poor creatures who are better to"
NSQ_SOURCE_LINE 00002449 "use Text::CSV_XS. :)"
NSQ_SOURCE_LINE 00002450 ""
NSQ_SOURCE_LINE 00002451 "=head3 quote_space"
NSQ_SOURCE_LINE 00002452 "X<quote_space>"
NSQ_SOURCE_LINE 00002453 ""
NSQ_SOURCE_LINE 00002454 " my $csv = Text::CSV_XS->new ({ quote_space => 1 });"
NSQ_SOURCE_LINE 00002455 "         $csv->quote_space (0);"
NSQ_SOURCE_LINE 00002456 " my $f = $csv->quote_space;"
NSQ_SOURCE_LINE 00002457 ""
NSQ_SOURCE_LINE 00002458 "By default,  a space in a field would trigger quotation.  As no rule exists"
NSQ_SOURCE_LINE 00002459 "this to be forced in C<CSV>,  nor any for the opposite, the default is true"
NSQ_SOURCE_LINE 00002460 "for safety.   You can exclude the space  from this trigger  by setting this"
NSQ_SOURCE_LINE 00002461 "attribute to 0."
NSQ_SOURCE_LINE 00002462 ""
NSQ_SOURCE_LINE 00002463 "=head3 quote_empty"
NSQ_SOURCE_LINE 00002464 "X<quote_empty>"
NSQ_SOURCE_LINE 00002465 ""
NSQ_SOURCE_LINE 00002466 " my $csv = Text::CSV_XS->new ({ quote_empty => 1 });"
NSQ_SOURCE_LINE 00002467 "         $csv->quote_empty (0);"
NSQ_SOURCE_LINE 00002468 " my $f = $csv->quote_empty;"
NSQ_SOURCE_LINE 00002469 ""
NSQ_SOURCE_LINE 00002470 "By default the generated fields are quoted only if they I<need> to be.   An"
NSQ_SOURCE_LINE 00002471 "empty (defined) field does not need quotation. If you set this attribute to"
NSQ_SOURCE_LINE 00002472 "C<1> then I<empty> defined fields will be quoted.  (C<undef> fields are not"
NSQ_SOURCE_LINE 00002473 "quoted, see L</blank_is_undef>). See also L<C<always_quote>|/always_quote>."
NSQ_SOURCE_LINE 00002474 ""
NSQ_SOURCE_LINE 00002475 "=head3 quote_binary"
NSQ_SOURCE_LINE 00002476 "X<quote_binary>"
NSQ_SOURCE_LINE 00002477 ""
NSQ_SOURCE_LINE 00002478 " my $csv = Text::CSV_XS->new ({ quote_binary => 1 });"
NSQ_SOURCE_LINE 00002479 "         $csv->quote_binary (0);"
NSQ_SOURCE_LINE 00002480 " my $f = $csv->quote_binary;"
NSQ_SOURCE_LINE 00002481 ""
NSQ_SOURCE_LINE 00002482 "By default,  all \"unsafe\" bytes inside a string cause the combined field to"
NSQ_SOURCE_LINE 00002483 "be quoted.  By setting this attribute to C<0>, you can disable that trigger"
NSQ_SOURCE_LINE 00002484 "for bytes C<< >= 0x7F >>."
NSQ_SOURCE_LINE 00002485 ""
NSQ_SOURCE_LINE 00002486 "=head3 escape_null"
NSQ_SOURCE_LINE 00002487 "X<escape_null>"
NSQ_SOURCE_LINE 00002488 "X<quote_null>"
NSQ_SOURCE_LINE 00002489 ""
NSQ_SOURCE_LINE 00002490 " my $csv = Text::CSV_XS->new ({ escape_null => 1 });"
NSQ_SOURCE_LINE 00002491 "         $csv->escape_null (0);"
NSQ_SOURCE_LINE 00002492 " my $f = $csv->escape_null;"
NSQ_SOURCE_LINE 00002493 ""
NSQ_SOURCE_LINE 00002494 "By default, a C<NULL> byte in a field would be escaped. This option enables"
NSQ_SOURCE_LINE 00002495 "you to treat the  C<NULL>  byte as a simple binary character in binary mode"
NSQ_SOURCE_LINE 00002496 "(the C<< { binary => 1 } >> is set).  The default is true.  You can prevent"
NSQ_SOURCE_LINE 00002497 "C<NULL> escapes by setting this attribute to C<0>."
NSQ_SOURCE_LINE 00002498 ""
NSQ_SOURCE_LINE 00002499 "When the C<escape_char> attribute is set to undefined,  this attribute will"
NSQ_SOURCE_LINE 00002500 "be set to false."
NSQ_SOURCE_LINE 00002501 ""
NSQ_SOURCE_LINE 00002502 "The default setting will encode \"=\\x00=\" as"
NSQ_SOURCE_LINE 00002503 ""
NSQ_SOURCE_LINE 00002504 " \"=\"0=\""
NSQ_SOURCE_LINE 00002505 ""
NSQ_SOURCE_LINE 00002506 "With C<escape_null> set, this will result in"
NSQ_SOURCE_LINE 00002507 ""
NSQ_SOURCE_LINE 00002508 " \"=\\x00=\""
NSQ_SOURCE_LINE 00002509 ""
NSQ_SOURCE_LINE 00002510 "The default when using the C<csv> function is C<false>."
NSQ_SOURCE_LINE 00002511 ""
NSQ_SOURCE_LINE 00002512 "For backward compatibility reasons,  the deprecated old name  C<quote_null>"
NSQ_SOURCE_LINE 00002513 "is still recognized."
NSQ_SOURCE_LINE 00002514 ""
NSQ_SOURCE_LINE 00002515 "=head3 keep_meta_info"
NSQ_SOURCE_LINE 00002516 "X<keep_meta_info>"
NSQ_SOURCE_LINE 00002517 ""
NSQ_SOURCE_LINE 00002518 " my $csv = Text::CSV_XS->new ({ keep_meta_info => 1 });"
NSQ_SOURCE_LINE 00002519 "         $csv->keep_meta_info (0);"
NSQ_SOURCE_LINE 00002520 " my $f = $csv->keep_meta_info;"
NSQ_SOURCE_LINE 00002521 ""
NSQ_SOURCE_LINE 00002522 "By default, the parsing of input records is as simple and fast as possible."
NSQ_SOURCE_LINE 00002523 "However,  some parsing information - like quotation of the original field -"
NSQ_SOURCE_LINE 00002524 "is lost in that process.  Setting this flag to true enables retrieving that"
NSQ_SOURCE_LINE 00002525 "information after parsing with  the methods  L</meta_info>,  L</is_quoted>,"
NSQ_SOURCE_LINE 00002526 "and L</is_binary> described below.  Default is false for performance."
NSQ_SOURCE_LINE 00002527 ""
NSQ_SOURCE_LINE 00002528 "If you set this attribute to a value greater than 9,   then you can control"
NSQ_SOURCE_LINE 00002529 "output quotation style like it was used in the input of the the last parsed"
NSQ_SOURCE_LINE 00002530 "record (unless quotation was added because of other reasons)."
NSQ_SOURCE_LINE 00002531 ""
NSQ_SOURCE_LINE 00002532 " my $csv = Text::CSV_XS->new ({"
NSQ_SOURCE_LINE 00002533 "    binary         => 1,"
NSQ_SOURCE_LINE 00002534 "    keep_meta_info => 1,"
NSQ_SOURCE_LINE 00002535 "    quote_space    => 0,"
NSQ_SOURCE_LINE 00002536 "    });"
NSQ_SOURCE_LINE 00002537 ""
NSQ_SOURCE_LINE 00002538 " my $row = $csv->parse (q{1,,\"\", ,\" \",f,\"g\",\"h\"\"h\",help,\"help\"});"
NSQ_SOURCE_LINE 00002539 ""
NSQ_SOURCE_LINE 00002540 " $csv->print (*STDOUT, \\@row);"
NSQ_SOURCE_LINE 00002541 " # 1,,, , ,f,g,\"h\"\"h\",help,help"
NSQ_SOURCE_LINE 00002542 " $csv->keep_meta_info (11);"
NSQ_SOURCE_LINE 00002543 " $csv->print (*STDOUT, \\@row);"
NSQ_SOURCE_LINE 00002544 " # 1,,\"\", ,\" \",f,\"g\",\"h\"\"h\",help,\"help\""
NSQ_SOURCE_LINE 00002545 ""
NSQ_SOURCE_LINE 00002546 "=head3 undef_str"
NSQ_SOURCE_LINE 00002547 "X<undef_str>"
NSQ_SOURCE_LINE 00002548 ""
NSQ_SOURCE_LINE 00002549 " my $csv = Text::CSV_XS->new ({ undef_str => \"\\\\N\" });"
NSQ_SOURCE_LINE 00002550 "         $csv->undef_str (undef);"
NSQ_SOURCE_LINE 00002551 " my $s = $csv->undef_str;"
NSQ_SOURCE_LINE 00002552 ""
NSQ_SOURCE_LINE 00002553 "This attribute optionally defines the output of undefined fields. The value"
NSQ_SOURCE_LINE 00002554 "passed is not changed at all, so if it needs quotation, the quotation needs"
NSQ_SOURCE_LINE 00002555 "to be included in the value of the attribute.  Use with caution, as passing"
NSQ_SOURCE_LINE 00002556 "a value like  C<\",\",,,,\"\"\">  will for sure mess up your output. The default"
NSQ_SOURCE_LINE 00002557 "for this attribute is C<undef>, meaning no special treatment."
NSQ_SOURCE_LINE 00002558 ""
NSQ_SOURCE_LINE 00002559 "This attribute is useful when exporting  CSV data  to be imported in custom"
NSQ_SOURCE_LINE 00002560 "loaders, like for MySQL, that recognize special sequences for C<NULL> data."
NSQ_SOURCE_LINE 00002561 ""
NSQ_SOURCE_LINE 00002562 "This attribute has no meaning when parsing CSV data."
NSQ_SOURCE_LINE 00002563 ""
NSQ_SOURCE_LINE 00002564 "=head3 comment_str"
NSQ_SOURCE_LINE 00002565 "X<comment_str>"
NSQ_SOURCE_LINE 00002566 ""
NSQ_SOURCE_LINE 00002567 " my $csv = Text::CSV_XS->new ({ comment_str => \"#\" });"
NSQ_SOURCE_LINE 00002568 "         $csv->comment_str (undef);"
NSQ_SOURCE_LINE 00002569 " my $s = $csv->comment_str;"
NSQ_SOURCE_LINE 00002570 ""
NSQ_SOURCE_LINE 00002571 "This attribute optionally defines a string to be recognized as comment.  If"
NSQ_SOURCE_LINE 00002572 "this attribute is defined,   all lines starting with this sequence will not"
NSQ_SOURCE_LINE 00002573 "be parsed as CSV but skipped as comment."
NSQ_SOURCE_LINE 00002574 ""
NSQ_SOURCE_LINE 00002575 "This attribute has no meaning when generating CSV."
NSQ_SOURCE_LINE 00002576 ""
NSQ_SOURCE_LINE 00002577 "Comment strings that start with any of the special characters/sequences are"
NSQ_SOURCE_LINE 00002578 "not supported (so it cannot start with any of L</sep_char>, L</quote_char>,"
NSQ_SOURCE_LINE 00002579 "L</escape_char>, L</sep>, L</quote>, or L</eol>)."
NSQ_SOURCE_LINE 00002580 ""
NSQ_SOURCE_LINE 00002581 "For convenience, C<comment> is an alias for C<comment_str>."
NSQ_SOURCE_LINE 00002582 ""
NSQ_SOURCE_LINE 00002583 "=head3 verbatim"
NSQ_SOURCE_LINE 00002584 "X<verbatim>"
NSQ_SOURCE_LINE 00002585 ""
NSQ_SOURCE_LINE 00002586 " my $csv = Text::CSV_XS->new ({ verbatim => 1 });"
NSQ_SOURCE_LINE 00002587 "         $csv->verbatim (0);"
NSQ_SOURCE_LINE 00002588 " my $f = $csv->verbatim;"
NSQ_SOURCE_LINE 00002589 ""
NSQ_SOURCE_LINE 00002590 "This is a quite controversial attribute to set,  but makes some hard things"
NSQ_SOURCE_LINE 00002591 "possible."
NSQ_SOURCE_LINE 00002592 ""
NSQ_SOURCE_LINE 00002593 "The rationale behind this attribute is to tell the parser that the normally"
NSQ_SOURCE_LINE 00002594 "special characters newline (C<NL>) and Carriage Return (C<CR>)  will not be"
NSQ_SOURCE_LINE 00002595 "special when this flag is set,  and be dealt with  as being ordinary binary"
NSQ_SOURCE_LINE 00002596 "characters. This will ease working with data with embedded newlines."
NSQ_SOURCE_LINE 00002597 ""
NSQ_SOURCE_LINE 00002598 "When  C<verbatim>  is used with  L</getline>,  L</getline>  auto-C<chomp>'s"
NSQ_SOURCE_LINE 00002599 "every line."
NSQ_SOURCE_LINE 00002600 ""
NSQ_SOURCE_LINE 00002601 "Imagine a file format like"
NSQ_SOURCE_LINE 00002602 ""
NSQ_SOURCE_LINE 00002603 " M^^Hans^Janssen^Klas 2\\n2A^Ja^11-06-2007#\\r\\n"
NSQ_SOURCE_LINE 00002604 ""
NSQ_SOURCE_LINE 00002605 "where, the line ending is a very specific C<\"#\\r\\n\">, and the sep_char is a"
NSQ_SOURCE_LINE 00002606 "C<^> (caret).   None of the fields is quoted,   but embedded binary data is"
NSQ_SOURCE_LINE 00002607 "likely to be present. With the specific line ending, this should not be too"
NSQ_SOURCE_LINE 00002608 "hard to detect."
NSQ_SOURCE_LINE 00002609 ""
NSQ_SOURCE_LINE 00002610 "By default,  Text::CSV_XS'  parse function is instructed to only know about"
NSQ_SOURCE_LINE 00002611 "C<\"\\n\"> and C<\"\\r\">  to be legal line endings,  and so has to deal with the"
NSQ_SOURCE_LINE 00002612 "embedded newline as a real C<end-of-line>,  so it can scan the next line if"
NSQ_SOURCE_LINE 00002613 "binary is true, and the newline is inside a quoted field. With this option,"
NSQ_SOURCE_LINE 00002614 "we tell L</parse> to parse the line as if C<\"\\n\"> is just nothing more than"
NSQ_SOURCE_LINE 00002615 "a binary character."
NSQ_SOURCE_LINE 00002616 ""
NSQ_SOURCE_LINE 00002617 "For L</parse> this means that the parser has no more idea about line ending"
NSQ_SOURCE_LINE 00002618 "and L</getline> C<chomp>s line endings on reading."
NSQ_SOURCE_LINE 00002619 ""
NSQ_SOURCE_LINE 00002620 "=head3 types"
NSQ_SOURCE_LINE 00002621 ""
NSQ_SOURCE_LINE 00002622 "A set of column types; the attribute is immediately passed to the L</types>"
NSQ_SOURCE_LINE 00002623 "method."
NSQ_SOURCE_LINE 00002624 ""
NSQ_SOURCE_LINE 00002625 "=head3 callbacks"
NSQ_SOURCE_LINE 00002626 "X<callbacks>"
NSQ_SOURCE_LINE 00002627 ""
NSQ_SOURCE_LINE 00002628 "See the L</Callbacks> section below."
NSQ_SOURCE_LINE 00002629 ""
NSQ_SOURCE_LINE 00002630 "=head3 accessors"
NSQ_SOURCE_LINE 00002631 ""
NSQ_SOURCE_LINE 00002632 "To sum it up,"
NSQ_SOURCE_LINE 00002633 ""
NSQ_SOURCE_LINE 00002634 " $csv = Text::CSV_XS->new ();"
NSQ_SOURCE_LINE 00002635 ""
NSQ_SOURCE_LINE 00002636 "is equivalent to"
NSQ_SOURCE_LINE 00002637 ""
NSQ_SOURCE_LINE 00002638 " $csv = Text::CSV_XS->new ({"
NSQ_SOURCE_LINE 00002639 "     eol                   => undef, # \\r, \\n, or \\r\\n"
NSQ_SOURCE_LINE 00002640 "     sep_char              => ',',"
NSQ_SOURCE_LINE 00002641 "     sep                   => undef,"
NSQ_SOURCE_LINE 00002642 "     quote_char            => '\"',"
NSQ_SOURCE_LINE 00002643 "     quote                 => undef,"
NSQ_SOURCE_LINE 00002644 "     escape_char           => '\"',"
NSQ_SOURCE_LINE 00002645 "     binary                => 0,"
NSQ_SOURCE_LINE 00002646 "     decode_utf8           => 1,"
NSQ_SOURCE_LINE 00002647 "     auto_diag             => 0,"
NSQ_SOURCE_LINE 00002648 "     diag_verbose          => 0,"
NSQ_SOURCE_LINE 00002649 "     blank_is_undef        => 0,"
NSQ_SOURCE_LINE 00002650 "     empty_is_undef        => 0,"
NSQ_SOURCE_LINE 00002651 "     allow_whitespace      => 0,"
NSQ_SOURCE_LINE 00002652 "     allow_loose_quotes    => 0,"
NSQ_SOURCE_LINE 00002653 "     allow_loose_escapes   => 0,"
NSQ_SOURCE_LINE 00002654 "     allow_unquoted_escape => 0,"
NSQ_SOURCE_LINE 00002655 "     always_quote          => 0,"
NSQ_SOURCE_LINE 00002656 "     quote_empty           => 0,"
NSQ_SOURCE_LINE 00002657 "     quote_space           => 1,"
NSQ_SOURCE_LINE 00002658 "     escape_null           => 1,"
NSQ_SOURCE_LINE 00002659 "     quote_binary          => 1,"
NSQ_SOURCE_LINE 00002660 "     keep_meta_info        => 0,"
NSQ_SOURCE_LINE 00002661 "     strict                => 0,"
NSQ_SOURCE_LINE 00002662 "     skip_empty_rows       => 0,"
NSQ_SOURCE_LINE 00002663 "     formula               => 0,"
NSQ_SOURCE_LINE 00002664 "     verbatim              => 0,"
NSQ_SOURCE_LINE 00002665 "     undef_str             => undef,"
NSQ_SOURCE_LINE 00002666 "     comment_str           => undef,"
NSQ_SOURCE_LINE 00002667 "     types                 => undef,"
NSQ_SOURCE_LINE 00002668 "     callbacks             => undef,"
NSQ_SOURCE_LINE 00002669 "     });"
NSQ_SOURCE_LINE 00002670 ""
NSQ_SOURCE_LINE 00002671 "For all of the above mentioned flags, an accessor method is available where"
NSQ_SOURCE_LINE 00002672 "you can inquire the current value, or change the value"
NSQ_SOURCE_LINE 00002673 ""
NSQ_SOURCE_LINE 00002674 " my $quote = $csv->quote_char;"
NSQ_SOURCE_LINE 00002675 " $csv->binary (1);"
NSQ_SOURCE_LINE 00002676 ""
NSQ_SOURCE_LINE 00002677 "It is not wise to change these settings halfway through writing C<CSV> data"
NSQ_SOURCE_LINE 00002678 "to a stream. If however you want to create a new stream using the available"
NSQ_SOURCE_LINE 00002679 "C<CSV> object, there is no harm in changing them."
NSQ_SOURCE_LINE 00002680 ""
NSQ_SOURCE_LINE 00002681 "If the L</new> constructor call fails,  it returns C<undef>,  and makes the"
NSQ_SOURCE_LINE 00002682 "fail reason available through the L</error_diag> method."
NSQ_SOURCE_LINE 00002683 ""
NSQ_SOURCE_LINE 00002684 " $csv = Text::CSV_XS->new ({ ecs_char => 1 }) or"
NSQ_SOURCE_LINE 00002685 "     die \"\".Text::CSV_XS->error_diag ();"
NSQ_SOURCE_LINE 00002686 ""
NSQ_SOURCE_LINE 00002687 "L</error_diag> will return a string like"
NSQ_SOURCE_LINE 00002688 ""
NSQ_SOURCE_LINE 00002689 " \"INI - Unknown attribute 'ecs_char'\""
NSQ_SOURCE_LINE 00002690 ""
NSQ_SOURCE_LINE 00002691 "=head2 known_attributes"
NSQ_SOURCE_LINE 00002692 "X<known_attributes>"
NSQ_SOURCE_LINE 00002693 ""
NSQ_SOURCE_LINE 00002694 " @attr = Text::CSV_XS->known_attributes;"
NSQ_SOURCE_LINE 00002695 " @attr = Text::CSV_XS::known_attributes;"
NSQ_SOURCE_LINE 00002696 " @attr = $csv->known_attributes;"
NSQ_SOURCE_LINE 00002697 ""
NSQ_SOURCE_LINE 00002698 "This method will return an ordered list of all the supported  attributes as"
NSQ_SOURCE_LINE 00002699 "described above.   This can be useful for knowing what attributes are valid"
NSQ_SOURCE_LINE 00002700 "in classes that use or extend Text::CSV_XS."
NSQ_SOURCE_LINE 00002701 ""
NSQ_SOURCE_LINE 00002702 "=head2 print"
NSQ_SOURCE_LINE 00002703 "X<print>"
NSQ_SOURCE_LINE 00002704 ""
NSQ_SOURCE_LINE 00002705 " $status = $csv->print ($fh, $colref);"
NSQ_SOURCE_LINE 00002706 ""
NSQ_SOURCE_LINE 00002707 "Similar to  L</combine> + L</string> + L</print>,  but much more efficient."
NSQ_SOURCE_LINE 00002708 "It expects an array ref as input  (not an array!)  and the resulting string"
NSQ_SOURCE_LINE 00002709 "is not really  created,  but  immediately  written  to the  C<$fh>  object,"
NSQ_SOURCE_LINE 00002710 "typically an IO handle or any other object that offers a L</print> method."
NSQ_SOURCE_LINE 00002711 ""
NSQ_SOURCE_LINE 00002712 "For performance reasons  C<print>  does not create a result string,  so all"
NSQ_SOURCE_LINE 00002713 "L</string>, L</status>, L</fields>, and L</error_input> methods will return"
NSQ_SOURCE_LINE 00002714 "undefined information after executing this method."
NSQ_SOURCE_LINE 00002715 ""
NSQ_SOURCE_LINE 00002716 "If C<$colref> is C<undef>  (explicit,  not through a variable argument) and"
NSQ_SOURCE_LINE 00002717 "L</bind_columns>  was used to specify fields to be printed,  it is possible"
NSQ_SOURCE_LINE 00002718 "to make performance improvements, as otherwise data would have to be copied"
NSQ_SOURCE_LINE 00002719 "as arguments to the method call:"
NSQ_SOURCE_LINE 00002720 ""
NSQ_SOURCE_LINE 00002721 " $csv->bind_columns (\\($foo, $bar));"
NSQ_SOURCE_LINE 00002722 " $status = $csv->print ($fh, undef);"
NSQ_SOURCE_LINE 00002723 ""
NSQ_SOURCE_LINE 00002724 "A short benchmark"
NSQ_SOURCE_LINE 00002725 ""
NSQ_SOURCE_LINE 00002726 " my @data = (\"aa\" .. \"zz\");"
NSQ_SOURCE_LINE 00002727 " $csv->bind_columns (\\(@data));"
NSQ_SOURCE_LINE 00002728 ""
NSQ_SOURCE_LINE 00002729 " $csv->print ($fh, [ @data ]);   # 11800 recs/sec"
NSQ_SOURCE_LINE 00002730 " $csv->print ($fh,  \\@data  );   # 57600 recs/sec"
NSQ_SOURCE_LINE 00002731 " $csv->print ($fh,   undef  );   # 48500 recs/sec"
NSQ_SOURCE_LINE 00002732 ""
NSQ_SOURCE_LINE 00002733 "=head2 say"
NSQ_SOURCE_LINE 00002734 "X<say>"
NSQ_SOURCE_LINE 00002735 ""
NSQ_SOURCE_LINE 00002736 " $status = $csv->say ($fh, $colref);"
NSQ_SOURCE_LINE 00002737 ""
NSQ_SOURCE_LINE 00002738 "Like L<C<print>|/print>, but L<C<eol>|/eol> defaults to C<$\\>."
NSQ_SOURCE_LINE 00002739 ""
NSQ_SOURCE_LINE 00002740 "=head2 print_hr"
NSQ_SOURCE_LINE 00002741 "X<print_hr>"
NSQ_SOURCE_LINE 00002742 ""
NSQ_SOURCE_LINE 00002743 " $csv->print_hr ($fh, $ref);"
NSQ_SOURCE_LINE 00002744 ""
NSQ_SOURCE_LINE 00002745 "Provides an easy way  to print a  C<$ref>  (as fetched with L</getline_hr>)"
NSQ_SOURCE_LINE 00002746 "provided the column names are set with L</column_names>."
NSQ_SOURCE_LINE 00002747 ""
NSQ_SOURCE_LINE 00002748 "It is just a wrapper method with basic parameter checks over"
NSQ_SOURCE_LINE 00002749 ""
NSQ_SOURCE_LINE 00002750 " $csv->print ($fh, [ map { $ref->{$_} } $csv->column_names ]);"
NSQ_SOURCE_LINE 00002751 ""
NSQ_SOURCE_LINE 00002752 "=head2 combine"
NSQ_SOURCE_LINE 00002753 "X<combine>"
NSQ_SOURCE_LINE 00002754 ""
NSQ_SOURCE_LINE 00002755 " $status = $csv->combine (@fields);"
NSQ_SOURCE_LINE 00002756 ""
NSQ_SOURCE_LINE 00002757 "This method constructs a C<CSV> record from  C<@fields>,  returning success"
NSQ_SOURCE_LINE 00002758 "or failure.   Failure can result from lack of arguments or an argument that"
NSQ_SOURCE_LINE 00002759 "contains an invalid character.   Upon success,  L</string> can be called to"
NSQ_SOURCE_LINE 00002760 "retrieve the resultant C<CSV> string.  Upon failure,  the value returned by"
NSQ_SOURCE_LINE 00002761 "L</string> is undefined and L</error_input> could be called to retrieve the"
NSQ_SOURCE_LINE 00002762 "invalid argument."
NSQ_SOURCE_LINE 00002763 ""
NSQ_SOURCE_LINE 00002764 "=head2 string"
NSQ_SOURCE_LINE 00002765 "X<string>"
NSQ_SOURCE_LINE 00002766 ""
NSQ_SOURCE_LINE 00002767 " $line = $csv->string ();"
NSQ_SOURCE_LINE 00002768 ""
NSQ_SOURCE_LINE 00002769 "This method returns the input to  L</parse>  or the resultant C<CSV> string"
NSQ_SOURCE_LINE 00002770 "of L</combine>, whichever was called more recently."
NSQ_SOURCE_LINE 00002771 ""
NSQ_SOURCE_LINE 00002772 "=head2 getline"
NSQ_SOURCE_LINE 00002773 "X<getline>"
NSQ_SOURCE_LINE 00002774 ""
NSQ_SOURCE_LINE 00002775 " $colref = $csv->getline ($fh);"
NSQ_SOURCE_LINE 00002776 ""
NSQ_SOURCE_LINE 00002777 "This is the counterpart to  L</print>,  as L</parse>  is the counterpart to"
NSQ_SOURCE_LINE 00002778 "L</combine>:  it parses a row from the C<$fh>  handle using the L</getline>"
NSQ_SOURCE_LINE 00002779 "method associated with C<$fh>  and parses this row into an array ref.  This"
NSQ_SOURCE_LINE 00002780 "array ref is returned by the function or C<undef> for failure.  When C<$fh>"
NSQ_SOURCE_LINE 00002781 "does not support C<getline>, you are likely to hit errors."
NSQ_SOURCE_LINE 00002782 ""
NSQ_SOURCE_LINE 00002783 "When fields are bound with L</bind_columns> the return value is a reference"
NSQ_SOURCE_LINE 00002784 "to an empty list."
NSQ_SOURCE_LINE 00002785 ""
NSQ_SOURCE_LINE 00002786 "The L</string>, L</fields>, and L</status> methods are meaningless again."
NSQ_SOURCE_LINE 00002787 ""
NSQ_SOURCE_LINE 00002788 "=head2 getline_all"
NSQ_SOURCE_LINE 00002789 "X<getline_all>"
NSQ_SOURCE_LINE 00002790 ""
NSQ_SOURCE_LINE 00002791 " $arrayref = $csv->getline_all ($fh);"
NSQ_SOURCE_LINE 00002792 " $arrayref = $csv->getline_all ($fh, $offset);"
NSQ_SOURCE_LINE 00002793 " $arrayref = $csv->getline_all ($fh, $offset, $length);"
NSQ_SOURCE_LINE 00002794 ""
NSQ_SOURCE_LINE 00002795 "This will return a reference to a list of L<getline ($fh)|/getline> results."
NSQ_SOURCE_LINE 00002796 "In this call, C<keep_meta_info> is disabled.  If C<$offset> is negative, as"
NSQ_SOURCE_LINE 00002797 "with C<splice>, only the last  C<abs ($offset)> records of C<$fh> are taken"
NSQ_SOURCE_LINE 00002798 "into consideration. Parameters C<$offset> and C<$length> are expected to be"
NSQ_SOURCE_LINE 00002799 "integers. Non-integer values are interpreted as integer without check."
NSQ_SOURCE_LINE 00002800 ""
NSQ_SOURCE_LINE 00002801 "Given a CSV file with 10 lines:"
NSQ_SOURCE_LINE 00002802 ""
NSQ_SOURCE_LINE 00002803 " lines call"
NSQ_SOURCE_LINE 00002804 " ----- ---------------------------------------------------------"
NSQ_SOURCE_LINE 00002805 " 0..9  $csv->getline_all ($fh)         # all"
NSQ_SOURCE_LINE 00002806 " 0..9  $csv->getline_all ($fh,  0)     # all"
NSQ_SOURCE_LINE 00002807 " 8..9  $csv->getline_all ($fh,  8)     # start at 8"
NSQ_SOURCE_LINE 00002808 " -     $csv->getline_all ($fh,  0,  0) # start at 0 first 0 rows"
NSQ_SOURCE_LINE 00002809 " 0..4  $csv->getline_all ($fh,  0,  5) # start at 0 first 5 rows"
NSQ_SOURCE_LINE 00002810 " 4..5  $csv->getline_all ($fh,  4,  2) # start at 4 first 2 rows"
NSQ_SOURCE_LINE 00002811 " 8..9  $csv->getline_all ($fh, -2)     # last 2 rows"
NSQ_SOURCE_LINE 00002812 " 6..7  $csv->getline_all ($fh, -4,  2) # first 2 of last  4 rows"
NSQ_SOURCE_LINE 00002813 ""
NSQ_SOURCE_LINE 00002814 "=head2 getline_hr"
NSQ_SOURCE_LINE 00002815 "X<getline_hr>"
NSQ_SOURCE_LINE 00002816 ""
NSQ_SOURCE_LINE 00002817 "The L</getline_hr> and L</column_names> methods work together  to allow you"
NSQ_SOURCE_LINE 00002818 "to have rows returned as hashrefs.  You must call L</column_names> first to"
NSQ_SOURCE_LINE 00002819 "declare your column names."
NSQ_SOURCE_LINE 00002820 ""
NSQ_SOURCE_LINE 00002821 " $csv->column_names (qw( code name price description ));"
NSQ_SOURCE_LINE 00002822 " $hr = $csv->getline_hr ($fh);"
NSQ_SOURCE_LINE 00002823 " print \"Price for $hr->{name} is $hr->{price} EUR\\n\";"
NSQ_SOURCE_LINE 00002824 ""
NSQ_SOURCE_LINE 00002825 "L</getline_hr> will croak if called before L</column_names>."
NSQ_SOURCE_LINE 00002826 ""
NSQ_SOURCE_LINE 00002827 "Note that  L</getline_hr>  creates a hashref for every row and will be much"
NSQ_SOURCE_LINE 00002828 "slower than the combined use of L</bind_columns>  and L</getline> but still"
NSQ_SOURCE_LINE 00002829 "offering the same easy to use hashref inside the loop:"
NSQ_SOURCE_LINE 00002830 ""
NSQ_SOURCE_LINE 00002831 " my @cols = @{$csv->getline ($fh)};"
NSQ_SOURCE_LINE 00002832 " $csv->column_names (@cols);"
NSQ_SOURCE_LINE 00002833 " while (my $row = $csv->getline_hr ($fh)) {"
NSQ_SOURCE_LINE 00002834 "     print $row->{price};"
NSQ_SOURCE_LINE 00002835 "     }"
NSQ_SOURCE_LINE 00002836 ""
NSQ_SOURCE_LINE 00002837 "Could easily be rewritten to the much faster:"
NSQ_SOURCE_LINE 00002838 ""
NSQ_SOURCE_LINE 00002839 " my @cols = @{$csv->getline ($fh)};"
NSQ_SOURCE_LINE 00002840 " my $row = {};"
NSQ_SOURCE_LINE 00002841 " $csv->bind_columns (\\@{$row}{@cols});"
NSQ_SOURCE_LINE 00002842 " while ($csv->getline ($fh)) {"
NSQ_SOURCE_LINE 00002843 "     print $row->{price};"
NSQ_SOURCE_LINE 00002844 "     }"
NSQ_SOURCE_LINE 00002845 ""
NSQ_SOURCE_LINE 00002846 "Your mileage may vary for the size of the data and the number of rows. With"
NSQ_SOURCE_LINE 00002847 "perl-5.14.2 the comparison for a 100_000 line file with 14 columns:"
NSQ_SOURCE_LINE 00002848 ""
NSQ_SOURCE_LINE 00002849 "            Rate hashrefs getlines"
NSQ_SOURCE_LINE 00002850 " hashrefs 1.00/s       --     -76%"
NSQ_SOURCE_LINE 00002851 " getlines 4.15/s     313%       --"
NSQ_SOURCE_LINE 00002852 ""
NSQ_SOURCE_LINE 00002853 "=head2 getline_hr_all"
NSQ_SOURCE_LINE 00002854 "X<getline_hr_all>"
NSQ_SOURCE_LINE 00002855 ""
NSQ_SOURCE_LINE 00002856 " $arrayref = $csv->getline_hr_all ($fh);"
NSQ_SOURCE_LINE 00002857 " $arrayref = $csv->getline_hr_all ($fh, $offset);"
NSQ_SOURCE_LINE 00002858 " $arrayref = $csv->getline_hr_all ($fh, $offset, $length);"
NSQ_SOURCE_LINE 00002859 ""
NSQ_SOURCE_LINE 00002860 "This will return a reference to a list of   L<getline_hr ($fh)|/getline_hr>"
NSQ_SOURCE_LINE 00002861 "results.  In this call, L<C<keep_meta_info>|/keep_meta_info> is disabled."
NSQ_SOURCE_LINE 00002862 ""
NSQ_SOURCE_LINE 00002863 "=head2 parse"
NSQ_SOURCE_LINE 00002864 "X<parse>"
NSQ_SOURCE_LINE 00002865 ""
NSQ_SOURCE_LINE 00002866 " $status = $csv->parse ($line);"
NSQ_SOURCE_LINE 00002867 ""
NSQ_SOURCE_LINE 00002868 "This method decomposes a  C<CSV>  string into fields,  returning success or"
NSQ_SOURCE_LINE 00002869 "failure.   Failure can result from a lack of argument  or the given  C<CSV>"
NSQ_SOURCE_LINE 00002870 "string is improperly formatted.   Upon success, L</fields> can be called to"
NSQ_SOURCE_LINE 00002871 "retrieve the decomposed fields. Upon failure calling L</fields> will return"
NSQ_SOURCE_LINE 00002872 "undefined data and  L</error_input>  can be called to retrieve  the invalid"
NSQ_SOURCE_LINE 00002873 "argument."
NSQ_SOURCE_LINE 00002874 ""
NSQ_SOURCE_LINE 00002875 "You may use the L</types>  method for setting column types.  See L</types>'"
NSQ_SOURCE_LINE 00002876 "description below."
NSQ_SOURCE_LINE 00002877 ""
NSQ_SOURCE_LINE 00002878 "The C<$line> argument is supposed to be a simple scalar. Everything else is"
NSQ_SOURCE_LINE 00002879 "supposed to croak and set error 1500."
NSQ_SOURCE_LINE 00002880 ""
NSQ_SOURCE_LINE 00002881 "=head2 fragment"
NSQ_SOURCE_LINE 00002882 "X<fragment>"
NSQ_SOURCE_LINE 00002883 ""
NSQ_SOURCE_LINE 00002884 "This function tries to implement RFC7111  (URI Fragment Identifiers for the"
NSQ_SOURCE_LINE 00002885 "text/csv Media Type) - https://datatracker.ietf.org/doc/html/rfc7111"
NSQ_SOURCE_LINE 00002886 ""
NSQ_SOURCE_LINE 00002887 " my $AoA = $csv->fragment ($fh, $spec);"
NSQ_SOURCE_LINE 00002888 ""
NSQ_SOURCE_LINE 00002889 "In specifications,  C<*> is used to specify the I<last> item, a dash (C<->)"
NSQ_SOURCE_LINE 00002890 "to indicate a range.   All indices are C<1>-based:  the first row or column"
NSQ_SOURCE_LINE 00002891 "has index C<1>. Selections can be combined with the semi-colon (C<;>)."
NSQ_SOURCE_LINE 00002892 ""
NSQ_SOURCE_LINE 00002893 "When using this method in combination with  L</column_names>,  the returned"
NSQ_SOURCE_LINE 00002894 "reference  will point to a  list of hashes  instead of a  list of lists.  A"
NSQ_SOURCE_LINE 00002895 "disjointed  cell-based combined selection  might return rows with different"
NSQ_SOURCE_LINE 00002896 "number of columns making the use of hashes unpredictable."
NSQ_SOURCE_LINE 00002897 ""
NSQ_SOURCE_LINE 00002898 " $csv->column_names (\"Name\", \"Age\");"
NSQ_SOURCE_LINE 00002899 " my $AoH = $csv->fragment ($fh, \"col=3;8\");"
NSQ_SOURCE_LINE 00002900 ""
NSQ_SOURCE_LINE 00002901 "If the L</after_parse> callback is active,  it is also called on every line"
NSQ_SOURCE_LINE 00002902 "parsed and skipped before the fragment."
NSQ_SOURCE_LINE 00002903 ""
NSQ_SOURCE_LINE 00002904 "=over 2"
NSQ_SOURCE_LINE 00002905 ""
NSQ_SOURCE_LINE 00002906 "=item row"
NSQ_SOURCE_LINE 00002907 ""
NSQ_SOURCE_LINE 00002908 " row=4"
NSQ_SOURCE_LINE 00002909 " row=5-7"
NSQ_SOURCE_LINE 00002910 " row=6-*"
NSQ_SOURCE_LINE 00002911 " row=1-2;4;6-*"
NSQ_SOURCE_LINE 00002912 ""
NSQ_SOURCE_LINE 00002913 "=item col"
NSQ_SOURCE_LINE 00002914 ""
NSQ_SOURCE_LINE 00002915 " col=2"
NSQ_SOURCE_LINE 00002916 " col=1-3"
NSQ_SOURCE_LINE 00002917 " col=4-*"
NSQ_SOURCE_LINE 00002918 " col=1-2;4;7-*"
NSQ_SOURCE_LINE 00002919 ""
NSQ_SOURCE_LINE 00002920 "=item cell"
NSQ_SOURCE_LINE 00002921 ""
NSQ_SOURCE_LINE 00002922 "In cell-based selection, the comma (C<,>) is used to pair row and column"
NSQ_SOURCE_LINE 00002923 ""
NSQ_SOURCE_LINE 00002924 " cell=4,1"
NSQ_SOURCE_LINE 00002925 ""
NSQ_SOURCE_LINE 00002926 "The range operator (C<->) using C<cell>s can be used to define top-left and"
NSQ_SOURCE_LINE 00002927 "bottom-right C<cell> location"
NSQ_SOURCE_LINE 00002928 ""
NSQ_SOURCE_LINE 00002929 " cell=3,1-4,6"
NSQ_SOURCE_LINE 00002930 ""
NSQ_SOURCE_LINE 00002931 "The C<*> is only allowed in the second part of a pair"
NSQ_SOURCE_LINE 00002932 ""
NSQ_SOURCE_LINE 00002933 " cell=3,2-*,2    # row 3 till end, only column 2"
NSQ_SOURCE_LINE 00002934 " cell=3,2-3,*    # column 2 till end, only row 3"
NSQ_SOURCE_LINE 00002935 " cell=3,2-*,*    # strip row 1 and 2, and column 1"
NSQ_SOURCE_LINE 00002936 ""
NSQ_SOURCE_LINE 00002937 "Cells and cell ranges may be combined with C<;>, possibly resulting in rows"
NSQ_SOURCE_LINE 00002938 "with different numbers of columns"
NSQ_SOURCE_LINE 00002939 ""
NSQ_SOURCE_LINE 00002940 " cell=1,1-2,2;3,3-4,4;1,4;4,1"
NSQ_SOURCE_LINE 00002941 ""
NSQ_SOURCE_LINE 00002942 "Disjointed selections will only return selected cells.   The cells that are"
NSQ_SOURCE_LINE 00002943 "not  specified  will  not  be  included  in the  returned set,  not even as"
NSQ_SOURCE_LINE 00002944 "C<undef>.  As an example given a C<CSV> like"
NSQ_SOURCE_LINE 00002945 ""
NSQ_SOURCE_LINE 00002946 " 11,12,13,...19"
NSQ_SOURCE_LINE 00002947 " 21,22,...28,29"
NSQ_SOURCE_LINE 00002948 " :            :"
NSQ_SOURCE_LINE 00002949 " 91,...97,98,99"
NSQ_SOURCE_LINE 00002950 ""
NSQ_SOURCE_LINE 00002951 "with C<cell=1,1-2,2;3,3-4,4;1,4;4,1> will return:"
NSQ_SOURCE_LINE 00002952 ""
NSQ_SOURCE_LINE 00002953 " 11,12,14"
NSQ_SOURCE_LINE 00002954 " 21,22"
NSQ_SOURCE_LINE 00002955 " 33,34"
NSQ_SOURCE_LINE 00002956 " 41,43,44"
NSQ_SOURCE_LINE 00002957 ""
NSQ_SOURCE_LINE 00002958 "Overlapping cell-specs will return those cells only once, So"
NSQ_SOURCE_LINE 00002959 "C<cell=1,1-3,3;2,2-4,4;2,3;4,2> will return:"
NSQ_SOURCE_LINE 00002960 ""
NSQ_SOURCE_LINE 00002961 " 11,12,13"
NSQ_SOURCE_LINE 00002962 " 21,22,23,24"
NSQ_SOURCE_LINE 00002963 " 31,32,33,34"
NSQ_SOURCE_LINE 00002964 " 42,43,44"
NSQ_SOURCE_LINE 00002965 ""
NSQ_SOURCE_LINE 00002966 "=back"
NSQ_SOURCE_LINE 00002967 ""
NSQ_SOURCE_LINE 00002968 "L<RFC7111|https://datatracker.ietf.org/doc/html/rfc7111> does  B<not>  allow different"
NSQ_SOURCE_LINE 00002969 "types of specs to be combined   (either C<row> I<or> C<col> I<or> C<cell>)."
NSQ_SOURCE_LINE 00002970 "Passing an invalid fragment specification will croak and set error 2013."
NSQ_SOURCE_LINE 00002971 ""
NSQ_SOURCE_LINE 00002972 "=head2 column_names"
NSQ_SOURCE_LINE 00002973 "X<column_names>"
NSQ_SOURCE_LINE 00002974 ""
NSQ_SOURCE_LINE 00002975 "Set the \"keys\" that will be used in the  L</getline_hr>  calls.  If no keys"
NSQ_SOURCE_LINE 00002976 "(column names) are passed, it will return the current setting as a list."
NSQ_SOURCE_LINE 00002977 ""
NSQ_SOURCE_LINE 00002978 "L</column_names> accepts a list of scalars  (the column names)  or a single"
NSQ_SOURCE_LINE 00002979 "array_ref, so you can pass the return value from L</getline> too:"
NSQ_SOURCE_LINE 00002980 ""
NSQ_SOURCE_LINE 00002981 " $csv->column_names ($csv->getline ($fh));"
NSQ_SOURCE_LINE 00002982 ""
NSQ_SOURCE_LINE 00002983 "L</column_names> does B<no> checking on duplicates at all, which might lead"
NSQ_SOURCE_LINE 00002984 "to unexpected results.   Undefined entries will be replaced with the string"
NSQ_SOURCE_LINE 00002985 "C<\"\\cAUNDEF\\cA\">, so"
NSQ_SOURCE_LINE 00002986 ""
NSQ_SOURCE_LINE 00002987 " $csv->column_names (undef, \"\", \"name\", \"name\");"
NSQ_SOURCE_LINE 00002988 " $hr = $csv->getline_hr ($fh);"
NSQ_SOURCE_LINE 00002989 ""
NSQ_SOURCE_LINE 00002990 "will set C<< $hr->{\"\\cAUNDEF\\cA\"} >> to the 1st field,  C<< $hr->{\"\"} >> to"
NSQ_SOURCE_LINE 00002991 "the 2nd field, and C<< $hr->{name} >> to the 4th field,  discarding the 3rd"
NSQ_SOURCE_LINE 00002992 "field."
NSQ_SOURCE_LINE 00002993 ""
NSQ_SOURCE_LINE 00002994 "L</column_names> croaks on invalid arguments."
NSQ_SOURCE_LINE 00002995 ""
NSQ_SOURCE_LINE 00002996 "=head2 header"
NSQ_SOURCE_LINE 00002997 ""
NSQ_SOURCE_LINE 00002998 "This method does NOT work in perl-5.6.x"
NSQ_SOURCE_LINE 00002999 ""
NSQ_SOURCE_LINE 00003000 "Parse the CSV header and set L<C<sep>|/sep>, column_names and encoding."
NSQ_SOURCE_LINE 00003001 ""
NSQ_SOURCE_LINE 00003002 " my @hdr = $csv->header ($fh);"
NSQ_SOURCE_LINE 00003003 " $csv->header ($fh, { sep_set => [ \";\", \",\", \"|\", \"\\t\" ] });"
NSQ_SOURCE_LINE 00003004 " $csv->header ($fh, { detect_bom => 1, munge_column_names => \"lc\" });"
NSQ_SOURCE_LINE 00003005 ""
NSQ_SOURCE_LINE 00003006 "The first argument should be a file handle."
NSQ_SOURCE_LINE 00003007 ""
NSQ_SOURCE_LINE 00003008 "This method resets some object properties,  as it is supposed to be invoked"
NSQ_SOURCE_LINE 00003009 "only once per file or stream.  It will leave attributes C<column_names> and"
NSQ_SOURCE_LINE 00003010 "C<bound_columns> alone if setting column names is disabled. Reading headers"
NSQ_SOURCE_LINE 00003011 "on previously process objects might fail on perl-5.8.0 and older."
NSQ_SOURCE_LINE 00003012 ""
NSQ_SOURCE_LINE 00003013 "Assuming that the file opened for parsing has a header, and the header does"
NSQ_SOURCE_LINE 00003014 "not contain problematic characters like embedded newlines,   read the first"
NSQ_SOURCE_LINE 00003015 "line from the open handle then auto-detect whether the header separates the"
NSQ_SOURCE_LINE 00003016 "column names with a character from the allowed separator list."
NSQ_SOURCE_LINE 00003017 ""
NSQ_SOURCE_LINE 00003018 "If any of the allowed separators matches,  and none of the I<other> allowed"
NSQ_SOURCE_LINE 00003019 "separators match,  set  L<C<sep>|/sep>  to that  separator  for the current"
NSQ_SOURCE_LINE 00003020 "CSV_XS instance and use it to parse the first line, map those to lowercase,"
NSQ_SOURCE_LINE 00003021 "and use that to set the instance L</column_names>:"
NSQ_SOURCE_LINE 00003022 ""
NSQ_SOURCE_LINE 00003023 " my $csv = Text::CSV_XS->new ({ binary => 1, auto_diag => 1 });"
NSQ_SOURCE_LINE 00003024 " open my $fh, \"<\", \"file.csv\";"
NSQ_SOURCE_LINE 00003025 " binmode $fh; # for Windows"
NSQ_SOURCE_LINE 00003026 " $csv->header ($fh);"
NSQ_SOURCE_LINE 00003027 " while (my $row = $csv->getline_hr ($fh)) {"
NSQ_SOURCE_LINE 00003028 "     ..."
NSQ_SOURCE_LINE 00003029 "     }"
NSQ_SOURCE_LINE 00003030 ""
NSQ_SOURCE_LINE 00003031 "If the header is empty,  contains more than one unique separator out of the"
NSQ_SOURCE_LINE 00003032 "allowed set,  contains empty fields,   or contains identical fields  (after"
NSQ_SOURCE_LINE 00003033 "folding), it will croak with error 1010, 1011, 1012, or 1013 respectively."
NSQ_SOURCE_LINE 00003034 ""
NSQ_SOURCE_LINE 00003035 "If the header contains embedded newlines or is not valid  CSV  in any other"
NSQ_SOURCE_LINE 00003036 "way, this method will croak and leave the parse error untouched."
NSQ_SOURCE_LINE 00003037 ""
NSQ_SOURCE_LINE 00003038 "A successful call to C<header>  will always set the  L<C<sep>|/sep>  of the"
NSQ_SOURCE_LINE 00003039 "C<$csv> object. This behavior can not be disabled."
NSQ_SOURCE_LINE 00003040 ""
NSQ_SOURCE_LINE 00003041 "=head3 return value"
NSQ_SOURCE_LINE 00003042 ""
NSQ_SOURCE_LINE 00003043 "On error this method will croak."
NSQ_SOURCE_LINE 00003044 ""
NSQ_SOURCE_LINE 00003045 "In list context,  the headers will be returned whether they are used to set"
NSQ_SOURCE_LINE 00003046 "L</column_names> or not."
NSQ_SOURCE_LINE 00003047 ""
NSQ_SOURCE_LINE 00003048 "In scalar context, the instance itself is returned.  B<Note>: the values as"
NSQ_SOURCE_LINE 00003049 "found in the header will effectively be  B<lost> if  C<set_column_names> is"
NSQ_SOURCE_LINE 00003050 "false."
NSQ_SOURCE_LINE 00003051 ""
NSQ_SOURCE_LINE 00003052 "=head3 Options"
NSQ_SOURCE_LINE 00003053 ""
NSQ_SOURCE_LINE 00003054 "=over 2"
NSQ_SOURCE_LINE 00003055 ""
NSQ_SOURCE_LINE 00003056 "=item sep_set"
NSQ_SOURCE_LINE 00003057 "X<sep_set>"
NSQ_SOURCE_LINE 00003058 ""
NSQ_SOURCE_LINE 00003059 " $csv->header ($fh, { sep_set => [ \";\", \",\", \"|\", \"\\t\" ] });"
NSQ_SOURCE_LINE 00003060 ""
NSQ_SOURCE_LINE 00003061 "The list of legal separators defaults to C<[ \";\", \",\" ]> and can be changed"
NSQ_SOURCE_LINE 00003062 "by this option.  As this is probably the most often used option,  it can be"
NSQ_SOURCE_LINE 00003063 "passed on its own as an unnamed argument:"
NSQ_SOURCE_LINE 00003064 ""
NSQ_SOURCE_LINE 00003065 " $csv->header ($fh, [ \";\", \",\", \"|\", \"\\t\", \"::\", \"\\x{2063}\" ]);"
NSQ_SOURCE_LINE 00003066 ""
NSQ_SOURCE_LINE 00003067 "Multi-byte  sequences are allowed,  both multi-character and  Unicode.  See"
NSQ_SOURCE_LINE 00003068 "L<C<sep>|/sep>."
NSQ_SOURCE_LINE 00003069 ""
NSQ_SOURCE_LINE 00003070 "=item detect_bom"
NSQ_SOURCE_LINE 00003071 "X<detect_bom>"
NSQ_SOURCE_LINE 00003072 ""
NSQ_SOURCE_LINE 00003073 " $csv->header ($fh, { detect_bom => 1 });"
NSQ_SOURCE_LINE 00003074 ""
NSQ_SOURCE_LINE 00003075 "The default behavior is to detect if the header line starts with a BOM.  If"
NSQ_SOURCE_LINE 00003076 "the header has a BOM, use that to set the encoding of C<$fh>.  This default"
NSQ_SOURCE_LINE 00003077 "behavior can be disabled by passing a false value to C<detect_bom>."
NSQ_SOURCE_LINE 00003078 ""
NSQ_SOURCE_LINE 00003079 "Supported encodings from BOM are: UTF-8, UTF-16BE, UTF-16LE, UTF-32BE,  and"
NSQ_SOURCE_LINE 00003080 "UTF-32LE. BOM also supports UTF-1, UTF-EBCDIC, SCSU, BOCU-1,  and GB-18030"
NSQ_SOURCE_LINE 00003081 "but L<Encode> does not (yet). UTF-7 is not supported."
NSQ_SOURCE_LINE 00003082 ""
NSQ_SOURCE_LINE 00003083 "If a supported BOM was detected as start of the stream, it is stored in the"
NSQ_SOURCE_LINE 00003084 "object attribute C<ENCODING>."
NSQ_SOURCE_LINE 00003085 ""
NSQ_SOURCE_LINE 00003086 " my $enc = $csv->{ENCODING};"
NSQ_SOURCE_LINE 00003087 ""
NSQ_SOURCE_LINE 00003088 "The encoding is used with C<binmode> on C<$fh>."
NSQ_SOURCE_LINE 00003089 ""
NSQ_SOURCE_LINE 00003090 "If the handle was opened in a (correct) encoding,  this method will  B<not>"
NSQ_SOURCE_LINE 00003091 "alter the encoding, as it checks the leading B<bytes> of the first line. In"
NSQ_SOURCE_LINE 00003092 "case the stream starts with a decoded BOM (C<U+FEFF>), C<{ENCODING}> will be"
NSQ_SOURCE_LINE 00003093 "C<\"\"> (empty) instead of the default C<undef>."
NSQ_SOURCE_LINE 00003094 ""
NSQ_SOURCE_LINE 00003095 "=item munge_column_names"
NSQ_SOURCE_LINE 00003096 "X<munge_column_names>"
NSQ_SOURCE_LINE 00003097 ""
NSQ_SOURCE_LINE 00003098 "This option offers the means to modify the column names into something that"
NSQ_SOURCE_LINE 00003099 "is most useful to the application.   The default is to map all column names"
NSQ_SOURCE_LINE 00003100 "to lower case."
NSQ_SOURCE_LINE 00003101 ""
NSQ_SOURCE_LINE 00003102 " $csv->header ($fh, { munge_column_names => \"lc\" });"
NSQ_SOURCE_LINE 00003103 ""
NSQ_SOURCE_LINE 00003104 "The following values are available:"
NSQ_SOURCE_LINE 00003105 ""
NSQ_SOURCE_LINE 00003106 "  lc     - lower case"
NSQ_SOURCE_LINE 00003107 "  uc     - upper case"
NSQ_SOURCE_LINE 00003108 "  db     - valid DB field names"
NSQ_SOURCE_LINE 00003109 "  none   - do not change"
NSQ_SOURCE_LINE 00003110 "  \\%hash - supply a mapping"
NSQ_SOURCE_LINE 00003111 "  \\&cb   - supply a callback"
NSQ_SOURCE_LINE 00003112 ""
NSQ_SOURCE_LINE 00003113 "=over 2"
NSQ_SOURCE_LINE 00003114 ""
NSQ_SOURCE_LINE 00003115 "=item Lower case"
NSQ_SOURCE_LINE 00003116 ""
NSQ_SOURCE_LINE 00003117 " $csv->header ($fh, { munge_column_names => \"lc\" });"
NSQ_SOURCE_LINE 00003118 ""
NSQ_SOURCE_LINE 00003119 "The header is changed to all lower-case"
NSQ_SOURCE_LINE 00003120 ""
NSQ_SOURCE_LINE 00003121 " $_ = lc;"
NSQ_SOURCE_LINE 00003122 ""
NSQ_SOURCE_LINE 00003123 "=item Upper case"
NSQ_SOURCE_LINE 00003124 ""
NSQ_SOURCE_LINE 00003125 " $csv->header ($fh, { munge_column_names => \"uc\" });"
NSQ_SOURCE_LINE 00003126 ""
NSQ_SOURCE_LINE 00003127 "The header is changed to all upper-case"
NSQ_SOURCE_LINE 00003128 ""
NSQ_SOURCE_LINE 00003129 " $_ = uc;"
NSQ_SOURCE_LINE 00003130 ""
NSQ_SOURCE_LINE 00003131 "=item Literal"
NSQ_SOURCE_LINE 00003132 ""
NSQ_SOURCE_LINE 00003133 " $csv->header ($fh, { munge_column_names => \"none\" });"
NSQ_SOURCE_LINE 00003134 ""
NSQ_SOURCE_LINE 00003135 "=item Hash"
NSQ_SOURCE_LINE 00003136 ""
NSQ_SOURCE_LINE 00003137 " $csv->header ($fh, { munge_column_names => { foo => \"sombrero\" });"
NSQ_SOURCE_LINE 00003138 ""
NSQ_SOURCE_LINE 00003139 "if a value does not exist, the original value is used unchanged"
NSQ_SOURCE_LINE 00003140 ""
NSQ_SOURCE_LINE 00003141 "=item Database"
NSQ_SOURCE_LINE 00003142 ""
NSQ_SOURCE_LINE 00003143 " $csv->header ($fh, { munge_column_names => \"db\" });"
NSQ_SOURCE_LINE 00003144 ""
NSQ_SOURCE_LINE 00003145 "=over 2"
NSQ_SOURCE_LINE 00003146 ""
NSQ_SOURCE_LINE 00003147 "=item -"
NSQ_SOURCE_LINE 00003148 ""
NSQ_SOURCE_LINE 00003149 "lower-case"
NSQ_SOURCE_LINE 00003150 ""
NSQ_SOURCE_LINE 00003151 "=item -"
NSQ_SOURCE_LINE 00003152 ""
NSQ_SOURCE_LINE 00003153 "all sequences of non-word characters are replaced with an underscore"
NSQ_SOURCE_LINE 00003154 ""
NSQ_SOURCE_LINE 00003155 "=item -"
NSQ_SOURCE_LINE 00003156 ""
NSQ_SOURCE_LINE 00003157 "all leading underscores are removed"
NSQ_SOURCE_LINE 00003158 ""
NSQ_SOURCE_LINE 00003159 "=back"
NSQ_SOURCE_LINE 00003160 ""
NSQ_SOURCE_LINE 00003161 " $_ = lc (s/\\W+/_/gr =~ s/^_+//r);"
NSQ_SOURCE_LINE 00003162 ""
NSQ_SOURCE_LINE 00003163 "=item Callback"
NSQ_SOURCE_LINE 00003164 ""
NSQ_SOURCE_LINE 00003165 " $csv->header ($fh, { munge_column_names => sub { fc } });"
NSQ_SOURCE_LINE 00003166 " $csv->header ($fh, { munge_column_names => sub { \"column_\".$col++ } });"
NSQ_SOURCE_LINE 00003167 " $csv->header ($fh, { munge_column_names => sub { lc (s/\\W+/_/gr) } });"
NSQ_SOURCE_LINE 00003168 ""
NSQ_SOURCE_LINE 00003169 "As this callback is called in a C<map>, you can use C<$_> directly."
NSQ_SOURCE_LINE 00003170 ""
NSQ_SOURCE_LINE 00003171 "=back"
NSQ_SOURCE_LINE 00003172 ""
NSQ_SOURCE_LINE 00003173 "=item set_column_names"
NSQ_SOURCE_LINE 00003174 "X<set_column_names>"
NSQ_SOURCE_LINE 00003175 ""
NSQ_SOURCE_LINE 00003176 " $csv->header ($fh, { set_column_names => 1 });"
NSQ_SOURCE_LINE 00003177 ""
NSQ_SOURCE_LINE 00003178 "The default is to set the instances column names using  L</column_names> if"
NSQ_SOURCE_LINE 00003179 "the method is successful,  so subsequent calls to L</getline_hr> can return"
NSQ_SOURCE_LINE 00003180 "a hash. Disable setting the header can be forced by using a false value for"
NSQ_SOURCE_LINE 00003181 "this option."
NSQ_SOURCE_LINE 00003182 ""
NSQ_SOURCE_LINE 00003183 "As described in L</return value> above, content is lost in scalar context."
NSQ_SOURCE_LINE 00003184 ""
NSQ_SOURCE_LINE 00003185 "=back"
NSQ_SOURCE_LINE 00003186 ""
NSQ_SOURCE_LINE 00003187 "=head3 Validation"
NSQ_SOURCE_LINE 00003188 ""
NSQ_SOURCE_LINE 00003189 "When receiving CSV files from external sources,  this method can be used to"
NSQ_SOURCE_LINE 00003190 "protect against changes in the layout by restricting to known headers  (and"
NSQ_SOURCE_LINE 00003191 "typos in the header fields)."
NSQ_SOURCE_LINE 00003192 ""
NSQ_SOURCE_LINE 00003193 " my %known = ("
NSQ_SOURCE_LINE 00003194 "     \"record key\" => \"c_rec\","
NSQ_SOURCE_LINE 00003195 "     \"rec id\"     => \"c_rec\","
NSQ_SOURCE_LINE 00003196 "     \"id_rec\"     => \"c_rec\","
NSQ_SOURCE_LINE 00003197 "     \"kode\"       => \"code\","
NSQ_SOURCE_LINE 00003198 "     \"code\"       => \"code\","
NSQ_SOURCE_LINE 00003199 "     \"vaule\"      => \"value\","
NSQ_SOURCE_LINE 00003200 "     \"value\"      => \"value\","
NSQ_SOURCE_LINE 00003201 "     );"
NSQ_SOURCE_LINE 00003202 " my $csv = Text::CSV_XS->new ({ binary => 1, auto_diag => 1 });"
NSQ_SOURCE_LINE 00003203 " open my $fh, \"<\", $source or die \"$source: $!\";"
NSQ_SOURCE_LINE 00003204 " $csv->header ($fh, { munge_column_names => sub {"
NSQ_SOURCE_LINE 00003205 "     s/\\s+$//;"
NSQ_SOURCE_LINE 00003206 "     s/^\\s+//;"
NSQ_SOURCE_LINE 00003207 "     $known{lc $_} or die \"Unknown column '$_' in $source\";"
NSQ_SOURCE_LINE 00003208 "     }});"
NSQ_SOURCE_LINE 00003209 " while (my $row = $csv->getline_hr ($fh)) {"
NSQ_SOURCE_LINE 00003210 "     say join \"\\t\", $row->{c_rec}, $row->{code}, $row->{value};"
NSQ_SOURCE_LINE 00003211 "     }"
NSQ_SOURCE_LINE 00003212 ""
NSQ_SOURCE_LINE 00003213 "=head2 bind_columns"
NSQ_SOURCE_LINE 00003214 "X<bind_columns>"
NSQ_SOURCE_LINE 00003215 ""
NSQ_SOURCE_LINE 00003216 "Takes a list of scalar references to be used for output with  L</print>  or"
NSQ_SOURCE_LINE 00003217 "to store in the fields fetched by L</getline>.  When you do not pass enough"
NSQ_SOURCE_LINE 00003218 "references to store the fetched fields in, L</getline> will fail with error"
NSQ_SOURCE_LINE 00003219 "C<3006>.  If you pass more than there are fields to return,  the content of"
NSQ_SOURCE_LINE 00003220 "the remaining references is left untouched.  Under C<strict> the two should"
NSQ_SOURCE_LINE 00003221 "match, otherwise L</getline> will fail with error C<2014>."
NSQ_SOURCE_LINE 00003222 ""
NSQ_SOURCE_LINE 00003223 " $csv->bind_columns (\\$code, \\$name, \\$price, \\$description);"
NSQ_SOURCE_LINE 00003224 " while ($csv->getline ($fh)) {"
NSQ_SOURCE_LINE 00003225 "     print \"The price of a $name is \\x{20ac} $price\\n\";"
NSQ_SOURCE_LINE 00003226 "     }"
NSQ_SOURCE_LINE 00003227 ""
NSQ_SOURCE_LINE 00003228 "To reset or clear all column binding, call L</bind_columns> with the single"
NSQ_SOURCE_LINE 00003229 "argument C<undef>. This will also clear column names."
NSQ_SOURCE_LINE 00003230 ""
NSQ_SOURCE_LINE 00003231 " $csv->bind_columns (undef);"
NSQ_SOURCE_LINE 00003232 ""
NSQ_SOURCE_LINE 00003233 "If no arguments are passed at all, L</bind_columns> will return the list of"
NSQ_SOURCE_LINE 00003234 "current bindings or C<undef> if no binds are active."
NSQ_SOURCE_LINE 00003235 ""
NSQ_SOURCE_LINE 00003236 "Note that in parsing with  C<bind_columns>,  the fields are set on the fly."
NSQ_SOURCE_LINE 00003237 "That implies that if the third field of a row causes an error  (or this row"
NSQ_SOURCE_LINE 00003238 "has just two fields where the previous row had more),  the first two fields"
NSQ_SOURCE_LINE 00003239 "already have been assigned the values of the current row, while the rest of"
NSQ_SOURCE_LINE 00003240 "the fields will still hold the values of the previous row.  If you want the"
NSQ_SOURCE_LINE 00003241 "parser to fail in these cases, use the L<C<strict>|/strict> attribute."
NSQ_SOURCE_LINE 00003242 ""
NSQ_SOURCE_LINE 00003243 "=head2 eof"
NSQ_SOURCE_LINE 00003244 "X<eof>"
NSQ_SOURCE_LINE 00003245 ""
NSQ_SOURCE_LINE 00003246 " $eof = $csv->eof ();"
NSQ_SOURCE_LINE 00003247 ""
NSQ_SOURCE_LINE 00003248 "If L</parse> or  L</getline>  was used with an IO stream,  this method will"
NSQ_SOURCE_LINE 00003249 "return true (1) if the last call hit end of file,  otherwise it will return"
NSQ_SOURCE_LINE 00003250 "false ('').  This is useful to see the difference between a failure and end"
NSQ_SOURCE_LINE 00003251 "of file."
NSQ_SOURCE_LINE 00003252 ""
NSQ_SOURCE_LINE 00003253 "Note that if the parsing of the last line caused an error,  C<eof> is still"
NSQ_SOURCE_LINE 00003254 "true.  That means that if you are I<not> using L</auto_diag>, an idiom like"
NSQ_SOURCE_LINE 00003255 ""
NSQ_SOURCE_LINE 00003256 " while (my $row = $csv->getline ($fh)) {"
NSQ_SOURCE_LINE 00003257 "     # ..."
NSQ_SOURCE_LINE 00003258 "     }"
NSQ_SOURCE_LINE 00003259 " $csv->eof or $csv->error_diag;"
NSQ_SOURCE_LINE 00003260 ""
NSQ_SOURCE_LINE 00003261 "will I<not> report the error. You would have to change that to"
NSQ_SOURCE_LINE 00003262 ""
NSQ_SOURCE_LINE 00003263 " while (my $row = $csv->getline ($fh)) {"
NSQ_SOURCE_LINE 00003264 "     # ..."
NSQ_SOURCE_LINE 00003265 "     }"
NSQ_SOURCE_LINE 00003266 " +$csv->error_diag and $csv->error_diag;"
NSQ_SOURCE_LINE 00003267 ""
NSQ_SOURCE_LINE 00003268 "=head2 types"
NSQ_SOURCE_LINE 00003269 "X<types>"
NSQ_SOURCE_LINE 00003270 ""
NSQ_SOURCE_LINE 00003271 " $csv->types (\\@tref);"
NSQ_SOURCE_LINE 00003272 ""
NSQ_SOURCE_LINE 00003273 "This method is used to force that  (all)  columns are of a given type.  For"
NSQ_SOURCE_LINE 00003274 "example, if you have an integer column,  two  columns  with  doubles  and a"
NSQ_SOURCE_LINE 00003275 "string column, then you might do a"
NSQ_SOURCE_LINE 00003276 ""
NSQ_SOURCE_LINE 00003277 " $csv->types ([Text::CSV_XS::IV (),"
NSQ_SOURCE_LINE 00003278 "               Text::CSV_XS::NV (),"
NSQ_SOURCE_LINE 00003279 "               Text::CSV_XS::NV (),"
NSQ_SOURCE_LINE 00003280 "               Text::CSV_XS::PV ()]);"
NSQ_SOURCE_LINE 00003281 ""
NSQ_SOURCE_LINE 00003282 "Column types are used only for I<decoding> columns while parsing,  in other"
NSQ_SOURCE_LINE 00003283 "words by the L</parse> and L</getline> methods."
NSQ_SOURCE_LINE 00003284 ""
NSQ_SOURCE_LINE 00003285 "You can unset column types by doing a"
NSQ_SOURCE_LINE 00003286 ""
NSQ_SOURCE_LINE 00003287 " $csv->types (undef);"
NSQ_SOURCE_LINE 00003288 ""
NSQ_SOURCE_LINE 00003289 "or fetch the current type settings with"
NSQ_SOURCE_LINE 00003290 ""
NSQ_SOURCE_LINE 00003291 " $types = $csv->types ();"
NSQ_SOURCE_LINE 00003292 ""
NSQ_SOURCE_LINE 00003293 "=over 4"
NSQ_SOURCE_LINE 00003294 ""
NSQ_SOURCE_LINE 00003295 "=item IV"
NSQ_SOURCE_LINE 00003296 "X<IV>"
NSQ_SOURCE_LINE 00003297 ""
NSQ_SOURCE_LINE 00003298 "=item CSV_TYPE_IV"
NSQ_SOURCE_LINE 00003299 "X<CSV_TYPE_IV>"
NSQ_SOURCE_LINE 00003300 ""
NSQ_SOURCE_LINE 00003301 "Set field type to integer."
NSQ_SOURCE_LINE 00003302 ""
NSQ_SOURCE_LINE 00003303 "=item NV"
NSQ_SOURCE_LINE 00003304 "X<NV>"
NSQ_SOURCE_LINE 00003305 ""
NSQ_SOURCE_LINE 00003306 "=item CSV_TYPE_NV"
NSQ_SOURCE_LINE 00003307 "X<CSV_TYPE_NV>"
NSQ_SOURCE_LINE 00003308 ""
NSQ_SOURCE_LINE 00003309 "Set field type to numeric/float."
NSQ_SOURCE_LINE 00003310 ""
NSQ_SOURCE_LINE 00003311 "=item PV"
NSQ_SOURCE_LINE 00003312 "X<PV>"
NSQ_SOURCE_LINE 00003313 ""
NSQ_SOURCE_LINE 00003314 "=item CSV_TYPE_PV"
NSQ_SOURCE_LINE 00003315 "X<CSV_TYPE_PV>"
NSQ_SOURCE_LINE 00003316 ""
NSQ_SOURCE_LINE 00003317 "Set field type to string."
NSQ_SOURCE_LINE 00003318 ""
NSQ_SOURCE_LINE 00003319 "=back"
NSQ_SOURCE_LINE 00003320 ""
NSQ_SOURCE_LINE 00003321 "=head2 fields"
NSQ_SOURCE_LINE 00003322 "X<fields>"
NSQ_SOURCE_LINE 00003323 ""
NSQ_SOURCE_LINE 00003324 " @columns = $csv->fields ();"
NSQ_SOURCE_LINE 00003325 ""
NSQ_SOURCE_LINE 00003326 "This method returns the input to   L</combine>  or the resultant decomposed"
NSQ_SOURCE_LINE 00003327 "fields of a successful L</parse>, whichever was called more recently."
NSQ_SOURCE_LINE 00003328 ""
NSQ_SOURCE_LINE 00003329 "Note that the return value is undefined after using L</getline>, which does"
NSQ_SOURCE_LINE 00003330 "not fill the data structures returned by L</parse>."
NSQ_SOURCE_LINE 00003331 ""
NSQ_SOURCE_LINE 00003332 "=head2 meta_info"
NSQ_SOURCE_LINE 00003333 "X<meta_info>"
NSQ_SOURCE_LINE 00003334 ""
NSQ_SOURCE_LINE 00003335 " @flags = $csv->meta_info ();"
NSQ_SOURCE_LINE 00003336 ""
NSQ_SOURCE_LINE 00003337 "This method returns the \"flags\" of the input to L</combine> or the flags of"
NSQ_SOURCE_LINE 00003338 "the resultant  decomposed fields of  L</parse>,   whichever was called more"
NSQ_SOURCE_LINE 00003339 "recently."
NSQ_SOURCE_LINE 00003340 ""
NSQ_SOURCE_LINE 00003341 "For each field,  a meta_info field will hold  flags that  inform  something"
NSQ_SOURCE_LINE 00003342 "about  the  field  returned  by  the  L</fields>  method or  passed to  the"
NSQ_SOURCE_LINE 00003343 "L</combine> method. The flags are bit-wise-C<or>'d like:"
NSQ_SOURCE_LINE 00003344 ""
NSQ_SOURCE_LINE 00003345 "=over 2"
NSQ_SOURCE_LINE 00003346 ""
NSQ_SOURCE_LINE 00003347 "=item C<0x0001>"
NSQ_SOURCE_LINE 00003348 ""
NSQ_SOURCE_LINE 00003349 "=item C<CSV_FLAGS_IS_QUOTED>"
NSQ_SOURCE_LINE 00003350 "X<CSV_FLAGS_IS_QUOTED>"
NSQ_SOURCE_LINE 00003351 ""
NSQ_SOURCE_LINE 00003352 "The field was quoted."
NSQ_SOURCE_LINE 00003353 ""
NSQ_SOURCE_LINE 00003354 "=item C<0x0002>"
NSQ_SOURCE_LINE 00003355 ""
NSQ_SOURCE_LINE 00003356 "=item C<CSV_FLAGS_IS_BINARY>"
NSQ_SOURCE_LINE 00003357 "X<CSV_FLAGS_IS_BINARY>"
NSQ_SOURCE_LINE 00003358 ""
NSQ_SOURCE_LINE 00003359 "The field was binary."
NSQ_SOURCE_LINE 00003360 ""
NSQ_SOURCE_LINE 00003361 "=item C<0x0004>"
NSQ_SOURCE_LINE 00003362 ""
NSQ_SOURCE_LINE 00003363 "=item C<CSV_FLAGS_ERROR_IN_FIELD>"
NSQ_SOURCE_LINE 00003364 "X<CSV_FLAGS_ERROR_IN_FIELD>"
NSQ_SOURCE_LINE 00003365 ""
NSQ_SOURCE_LINE 00003366 "The field was invalid."
NSQ_SOURCE_LINE 00003367 ""
NSQ_SOURCE_LINE 00003368 "Currently only used when C<allow_loose_quotes> is active."
NSQ_SOURCE_LINE 00003369 ""
NSQ_SOURCE_LINE 00003370 "=item C<0x0010>"
NSQ_SOURCE_LINE 00003371 ""
NSQ_SOURCE_LINE 00003372 "=item C<CSV_FLAGS_IS_MISSING>"
NSQ_SOURCE_LINE 00003373 "X<CSV_FLAGS_IS_MISSING>"
NSQ_SOURCE_LINE 00003374 ""
NSQ_SOURCE_LINE 00003375 "The field was missing."
NSQ_SOURCE_LINE 00003376 ""
NSQ_SOURCE_LINE 00003377 "=back"
NSQ_SOURCE_LINE 00003378 ""
NSQ_SOURCE_LINE 00003379 "See the C<is_***> methods below."
NSQ_SOURCE_LINE 00003380 ""
NSQ_SOURCE_LINE 00003381 "=head2 is_quoted"
NSQ_SOURCE_LINE 00003382 "X<is_quoted>"
NSQ_SOURCE_LINE 00003383 ""
NSQ_SOURCE_LINE 00003384 " my $quoted = $csv->is_quoted ($column_idx);"
NSQ_SOURCE_LINE 00003385 ""
NSQ_SOURCE_LINE 00003386 "where  C<$column_idx> is the  (zero-based)  index of the column in the last"
NSQ_SOURCE_LINE 00003387 "result of L</parse>."
NSQ_SOURCE_LINE 00003388 ""
NSQ_SOURCE_LINE 00003389 "This returns a true value  if the data in the indicated column was enclosed"
NSQ_SOURCE_LINE 00003390 "in L<C<quote_char>|/quote_char> quotes.  This might be important for fields"
NSQ_SOURCE_LINE 00003391 "where content C<,20070108,> is to be treated as a numeric value,  and where"
NSQ_SOURCE_LINE 00003392 "C<,\"20070108\",> is explicitly marked as character string data."
NSQ_SOURCE_LINE 00003393 ""
NSQ_SOURCE_LINE 00003394 "This method is only valid when L</keep_meta_info> is set to a true value."
NSQ_SOURCE_LINE 00003395 ""
NSQ_SOURCE_LINE 00003396 "=head2 is_binary"
NSQ_SOURCE_LINE 00003397 "X<is_binary>"
NSQ_SOURCE_LINE 00003398 ""
NSQ_SOURCE_LINE 00003399 " my $binary = $csv->is_binary ($column_idx);"
NSQ_SOURCE_LINE 00003400 ""
NSQ_SOURCE_LINE 00003401 "where  C<$column_idx> is the  (zero-based)  index of the column in the last"
NSQ_SOURCE_LINE 00003402 "result of L</parse>."
NSQ_SOURCE_LINE 00003403 ""
NSQ_SOURCE_LINE 00003404 "This returns a true value if the data in the indicated column contained any"
NSQ_SOURCE_LINE 00003405 "byte in the range C<[\\x00-\\x08,\\x10-\\x1F,\\x7F-\\xFF]>."
NSQ_SOURCE_LINE 00003406 ""
NSQ_SOURCE_LINE 00003407 "This method is only valid when L</keep_meta_info> is set to a true value."
NSQ_SOURCE_LINE 00003408 ""
NSQ_SOURCE_LINE 00003409 "=head2 is_missing"
NSQ_SOURCE_LINE 00003410 "X<is_missing>"
NSQ_SOURCE_LINE 00003411 ""
NSQ_SOURCE_LINE 00003412 " my $missing = $csv->is_missing ($column_idx);"
NSQ_SOURCE_LINE 00003413 ""
NSQ_SOURCE_LINE 00003414 "where  C<$column_idx> is the  (zero-based)  index of the column in the last"
NSQ_SOURCE_LINE 00003415 "result of L</getline_hr>."
NSQ_SOURCE_LINE 00003416 ""
NSQ_SOURCE_LINE 00003417 " $csv->keep_meta_info (1);"
NSQ_SOURCE_LINE 00003418 " while (my $hr = $csv->getline_hr ($fh)) {"
NSQ_SOURCE_LINE 00003419 "     $csv->is_missing (0) and next; # This was an empty line"
NSQ_SOURCE_LINE 00003420 "     }"
NSQ_SOURCE_LINE 00003421 ""
NSQ_SOURCE_LINE 00003422 "When using  L</getline_hr>,  it is impossible to tell if the  parsed fields"
NSQ_SOURCE_LINE 00003423 "are C<undef> because they where not filled in the C<CSV> stream  or because"
NSQ_SOURCE_LINE 00003424 "they were not read at all, as B<all> the fields defined by L</column_names>"
NSQ_SOURCE_LINE 00003425 "are set in the hash-ref.    If you still need to know if all fields in each"
NSQ_SOURCE_LINE 00003426 "row are provided, you should enable L<C<keep_meta_info>|/keep_meta_info> so"
NSQ_SOURCE_LINE 00003427 "you can check the flags."
NSQ_SOURCE_LINE 00003428 ""
NSQ_SOURCE_LINE 00003429 "If  L<C<keep_meta_info>|/keep_meta_info>  is C<false>,  C<is_missing>  will"
NSQ_SOURCE_LINE 00003430 "always return C<undef>, regardless of C<$column_idx> being valid or not. If"
NSQ_SOURCE_LINE 00003431 "this attribute is C<true> it will return either C<0> (the field is present)"
NSQ_SOURCE_LINE 00003432 "or C<1> (the field is missing)."
NSQ_SOURCE_LINE 00003433 ""
NSQ_SOURCE_LINE 00003434 "A special case is the empty line.  If the line is completely empty -  after"
NSQ_SOURCE_LINE 00003435 "dealing with the flags - this is still a valid CSV line:  it is a record of"
NSQ_SOURCE_LINE 00003436 "just one single empty field. However, if C<keep_meta_info> is set, invoking"
NSQ_SOURCE_LINE 00003437 "C<is_missing> with index C<0> will now return true."
NSQ_SOURCE_LINE 00003438 ""
NSQ_SOURCE_LINE 00003439 "=head2 status"
NSQ_SOURCE_LINE 00003440 "X<status>"
NSQ_SOURCE_LINE 00003441 ""
NSQ_SOURCE_LINE 00003442 " $status = $csv->status ();"
NSQ_SOURCE_LINE 00003443 ""
NSQ_SOURCE_LINE 00003444 "This method returns the status of the last invoked L</combine> or L</parse>"
NSQ_SOURCE_LINE 00003445 "call. Status is success (true: C<1>) or failure (false: C<undef> or C<0>)."
NSQ_SOURCE_LINE 00003446 ""
NSQ_SOURCE_LINE 00003447 "Note that as this only keeps track of the status of above mentioned methods,"
NSQ_SOURCE_LINE 00003448 "you are probably looking for L<C<error_diag>|/error_diag> instead."
NSQ_SOURCE_LINE 00003449 ""
NSQ_SOURCE_LINE 00003450 "=head2 error_input"
NSQ_SOURCE_LINE 00003451 "X<error_input>"
NSQ_SOURCE_LINE 00003452 ""
NSQ_SOURCE_LINE 00003453 " $bad_argument = $csv->error_input ();"
NSQ_SOURCE_LINE 00003454 ""
NSQ_SOURCE_LINE 00003455 "This method returns the erroneous argument (if it exists) of L</combine> or"
NSQ_SOURCE_LINE 00003456 "L</parse>,  whichever was called more recently.  If the last invocation was"
NSQ_SOURCE_LINE 00003457 "successful, C<error_input> will return C<undef>."
NSQ_SOURCE_LINE 00003458 ""
NSQ_SOURCE_LINE 00003459 "Depending on the type of error, it I<might> also hold the data for the last"
NSQ_SOURCE_LINE 00003460 "error-input of L</getline>."
NSQ_SOURCE_LINE 00003461 ""
NSQ_SOURCE_LINE 00003462 "=head2 error_diag"
NSQ_SOURCE_LINE 00003463 "X<error_diag>"
NSQ_SOURCE_LINE 00003464 ""
NSQ_SOURCE_LINE 00003465 " Text::CSV_XS->error_diag ();"
NSQ_SOURCE_LINE 00003466 " $csv->error_diag ();"
NSQ_SOURCE_LINE 00003467 " $error_code               = 0  + $csv->error_diag ();"
NSQ_SOURCE_LINE 00003468 " $error_str                = \"\" . $csv->error_diag ();"
NSQ_SOURCE_LINE 00003469 " ($cde, $str, $pos, $rec, $fld, $xs) = $csv->error_diag ();"
NSQ_SOURCE_LINE 00003470 ""
NSQ_SOURCE_LINE 00003471 "If (and only if) an error occurred,  this function returns  the diagnostics"
NSQ_SOURCE_LINE 00003472 "of that error."
NSQ_SOURCE_LINE 00003473 ""
NSQ_SOURCE_LINE 00003474 "If called in void context,  this will print the internal error code and the"
NSQ_SOURCE_LINE 00003475 "associated error message to STDERR."
NSQ_SOURCE_LINE 00003476 ""
NSQ_SOURCE_LINE 00003477 "If called in list context,  this will return  the error code  and the error"
NSQ_SOURCE_LINE 00003478 "message in that order.  If the last error was from parsing, the rest of the"
NSQ_SOURCE_LINE 00003479 "values returned are a best guess at the location  within the line  that was"
NSQ_SOURCE_LINE 00003480 "being parsed. Their values are 1-based.  The position currently is index of"
NSQ_SOURCE_LINE 00003481 "the byte at which the parsing failed in the current record. It might change"
NSQ_SOURCE_LINE 00003482 "to be the index of the current character in a later release. The records is"
NSQ_SOURCE_LINE 00003483 "the index of the record parsed by the csv instance. The field number is the"
NSQ_SOURCE_LINE 00003484 "index of the field the parser thinks it is currently  trying to  parse. See"
NSQ_SOURCE_LINE 00003485 "F<examples/csv-check> for how this can be used. If C<$xs> is set, it is the"
NSQ_SOURCE_LINE 00003486 "line number in XS where the error was triggered (for debugging). C<XS> will"
NSQ_SOURCE_LINE 00003487 "show in void context only when L</diag_verbose> is set."
NSQ_SOURCE_LINE 00003488 ""
NSQ_SOURCE_LINE 00003489 "If called in  scalar context,  it will return  the diagnostics  in a single"
NSQ_SOURCE_LINE 00003490 "scalar, a-la C<$!>.  It will contain the error code in numeric context, and"
NSQ_SOURCE_LINE 00003491 "the diagnostics message in string context."
NSQ_SOURCE_LINE 00003492 ""
NSQ_SOURCE_LINE 00003493 "When called as a class method or a  direct function call,  the  diagnostics"
NSQ_SOURCE_LINE 00003494 "are that of the last L</new> call."
NSQ_SOURCE_LINE 00003495 ""
NSQ_SOURCE_LINE 00003496 "=head3 _cache_diag"
NSQ_SOURCE_LINE 00003497 ""
NSQ_SOURCE_LINE 00003498 "Note: This is an internal function only,  and output cannot be relied upon."
NSQ_SOURCE_LINE 00003499 "Use at own risk."
NSQ_SOURCE_LINE 00003500 ""
NSQ_SOURCE_LINE 00003501 "If debugging beyond what L</error_diag> is able to show, the internal cache"
NSQ_SOURCE_LINE 00003502 "can be shown with this function."
NSQ_SOURCE_LINE 00003503 ""
NSQ_SOURCE_LINE 00003504 " # Something failed .."
NSQ_SOURCE_LINE 00003505 " $csv->error_diag;"
NSQ_SOURCE_LINE 00003506 " $csv->_cache_diag ();"
NSQ_SOURCE_LINE 00003507 ""
NSQ_SOURCE_LINE 00003508 "=head2 record_number"
NSQ_SOURCE_LINE 00003509 "X<record_number>"
NSQ_SOURCE_LINE 00003510 ""
NSQ_SOURCE_LINE 00003511 " $recno = $csv->record_number ();"
NSQ_SOURCE_LINE 00003512 ""
NSQ_SOURCE_LINE 00003513 "Returns the records parsed by this csv instance.  This value should be more"
NSQ_SOURCE_LINE 00003514 "accurate than C<$.> when embedded newlines come in play. Records written by"
NSQ_SOURCE_LINE 00003515 "this instance are not counted."
NSQ_SOURCE_LINE 00003516 ""
NSQ_SOURCE_LINE 00003517 "=head2 SetDiag"
NSQ_SOURCE_LINE 00003518 "X<SetDiag>"
NSQ_SOURCE_LINE 00003519 ""
NSQ_SOURCE_LINE 00003520 " $csv->SetDiag (0);"
NSQ_SOURCE_LINE 00003521 ""
NSQ_SOURCE_LINE 00003522 "Use to reset the diagnostics if you are dealing with errors."
NSQ_SOURCE_LINE 00003523 ""
NSQ_SOURCE_LINE 00003524 "=head1 IMPORTS/EXPORTS"
NSQ_SOURCE_LINE 00003525 ""
NSQ_SOURCE_LINE 00003526 "By default none of these are exported."
NSQ_SOURCE_LINE 00003527 ""
NSQ_SOURCE_LINE 00003528 "=over 2"
NSQ_SOURCE_LINE 00003529 ""
NSQ_SOURCE_LINE 00003530 "=item csv"
NSQ_SOURCE_LINE 00003531 ""
NSQ_SOURCE_LINE 00003532 " use Text::CSV_XS qw( csv );"
NSQ_SOURCE_LINE 00003533 ""
NSQ_SOURCE_LINE 00003534 "Import the function L</csv> function. See below."
NSQ_SOURCE_LINE 00003535 ""
NSQ_SOURCE_LINE 00003536 "=item :CONSTANTS"
NSQ_SOURCE_LINE 00003537 ""
NSQ_SOURCE_LINE 00003538 " use Text::CSV_XS qw( :CONSTANTS );"
NSQ_SOURCE_LINE 00003539 ""
NSQ_SOURCE_LINE 00003540 "Import module constants  L</CSV_FLAGS_IS_QUOTED>,  L</CSV_FLAGS_IS_BINARY>,"
NSQ_SOURCE_LINE 00003541 "L</CSV_FLAGS_ERROR_IN_FIELD>,  L</CSV_FLAGS_IS_MISSING>,   L</CSV_TYPE_PV>,"
NSQ_SOURCE_LINE 00003542 "L</CSV_TYPE_IV>, and L</CSV_TYPE_NV>. Each can be imported alone"
NSQ_SOURCE_LINE 00003543 ""
NSQ_SOURCE_LINE 00003544 " use Text::CSV_XS qw( CSV_FLAS_IS_BINARY CSV_TYPE_NV );"
NSQ_SOURCE_LINE 00003545 ""
NSQ_SOURCE_LINE 00003546 "=back"
NSQ_SOURCE_LINE 00003547 ""
NSQ_SOURCE_LINE 00003548 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00003549 ""
NSQ_SOURCE_LINE 00003550 "=head2 csv"
NSQ_SOURCE_LINE 00003551 "X<csv>"
NSQ_SOURCE_LINE 00003552 ""
NSQ_SOURCE_LINE 00003553 "This function is not exported by default and should be explicitly requested:"
NSQ_SOURCE_LINE 00003554 ""
NSQ_SOURCE_LINE 00003555 " use Text::CSV_XS qw( csv );"
NSQ_SOURCE_LINE 00003556 ""
NSQ_SOURCE_LINE 00003557 "This is a high-level function that aims at simple (user) interfaces.   This"
NSQ_SOURCE_LINE 00003558 "can be used to read/parse a C<CSV> file or stream (the default behavior) or"
NSQ_SOURCE_LINE 00003559 "to produce a file or write to a stream (define the  C<out>  attribute).  It"
NSQ_SOURCE_LINE 00003560 "returns an array- or hash-reference on parsing (or C<undef> on fail) or the"
NSQ_SOURCE_LINE 00003561 "numeric value of  L</error_diag>  on writing.  When this function fails you"
NSQ_SOURCE_LINE 00003562 "can get to the error using the class call to L</error_diag>"
NSQ_SOURCE_LINE 00003563 ""
NSQ_SOURCE_LINE 00003564 " my $aoa = csv (in => \"test.csv\") or"
NSQ_SOURCE_LINE 00003565 "     die Text::CSV_XS->error_diag;"
NSQ_SOURCE_LINE 00003566 ""
NSQ_SOURCE_LINE 00003567 "Note that failure here is the inability to start the parser,  like when the"
NSQ_SOURCE_LINE 00003568 "input does not exist or the arguments are unknown or conflicting.  Run-time"
NSQ_SOURCE_LINE 00003569 "parsing errors will return a valid reference, which can be empty, but still"
NSQ_SOURCE_LINE 00003570 "contains all results up till the error. See L</on_error>."
NSQ_SOURCE_LINE 00003571 ""
NSQ_SOURCE_LINE 00003572 "This function takes the arguments as key-value pairs. This can be passed as"
NSQ_SOURCE_LINE 00003573 "a list or as an anonymous hash:"
NSQ_SOURCE_LINE 00003574 ""
NSQ_SOURCE_LINE 00003575 " my $aoa = csv (  in => \"test.csv\", sep_char => \";\");"
NSQ_SOURCE_LINE 00003576 " my $aoh = csv ({ in => $fh, headers => \"auto\" });"
NSQ_SOURCE_LINE 00003577 ""
NSQ_SOURCE_LINE 00003578 "The arguments passed consist of two parts:  the arguments to L</csv> itself"
NSQ_SOURCE_LINE 00003579 "and the optional attributes to the  C<CSV>  object used inside the function"
NSQ_SOURCE_LINE 00003580 "as enumerated and explained in L</new>."
NSQ_SOURCE_LINE 00003581 ""
NSQ_SOURCE_LINE 00003582 "If not overridden, the default option used for CSV is"
NSQ_SOURCE_LINE 00003583 ""
NSQ_SOURCE_LINE 00003584 " auto_diag   => 1"
NSQ_SOURCE_LINE 00003585 " escape_null => 0"
NSQ_SOURCE_LINE 00003586 " strict_eol  => 1"
NSQ_SOURCE_LINE 00003587 ""
NSQ_SOURCE_LINE 00003588 "The option that is always set and cannot be altered is"
NSQ_SOURCE_LINE 00003589 ""
NSQ_SOURCE_LINE 00003590 " binary      => 1"
NSQ_SOURCE_LINE 00003591 ""
NSQ_SOURCE_LINE 00003592 "As this function will likely be used in one-liners,  it allows  C<quote> to"
NSQ_SOURCE_LINE 00003593 "be abbreviated as C<quo>,  and  C<escape_char> to be abbreviated as  C<esc>"
NSQ_SOURCE_LINE 00003594 "or C<escape>."
NSQ_SOURCE_LINE 00003595 ""
NSQ_SOURCE_LINE 00003596 "Alternative invocations:"
NSQ_SOURCE_LINE 00003597 ""
NSQ_SOURCE_LINE 00003598 " my $aoa = Text::CSV_XS::csv (in => \"file.csv\");"
NSQ_SOURCE_LINE 00003599 ""
NSQ_SOURCE_LINE 00003600 " my $csv = Text::CSV_XS->new ();"
NSQ_SOURCE_LINE 00003601 " my $aoa = $csv->csv (in => \"file.csv\");"
NSQ_SOURCE_LINE 00003602 ""
NSQ_SOURCE_LINE 00003603 "In the latter case, the object attributes are used from the existing object"
NSQ_SOURCE_LINE 00003604 "and the attribute arguments in the function call are ignored:"
NSQ_SOURCE_LINE 00003605 ""
NSQ_SOURCE_LINE 00003606 " my $csv = Text::CSV_XS->new ({ sep_char => \";\" });"
NSQ_SOURCE_LINE 00003607 " my $aoh = $csv->csv (in => \"file.csv\", bom => 1);"
NSQ_SOURCE_LINE 00003608 ""
NSQ_SOURCE_LINE 00003609 "will parse using C<;> as C<sep_char>, not C<,>."
NSQ_SOURCE_LINE 00003610 ""
NSQ_SOURCE_LINE 00003611 "=head3 in"
NSQ_SOURCE_LINE 00003612 "X<in>"
NSQ_SOURCE_LINE 00003613 ""
NSQ_SOURCE_LINE 00003614 "Used to specify the source.  C<in> can be a file name (e.g. C<\"file.csv\">),"
NSQ_SOURCE_LINE 00003615 "which will be  opened for reading  and closed when finished,  a file handle"
NSQ_SOURCE_LINE 00003616 "(e.g.  C<$fh> or C<FH>),  a reference to a glob (e.g. C<\\*ARGV>),  the glob"
NSQ_SOURCE_LINE 00003617 "itself (e.g. C<*STDIN>), or a reference to a scalar (e.g. C<\\q{1,2,\"csv\"}>)."
NSQ_SOURCE_LINE 00003618 ""
NSQ_SOURCE_LINE 00003619 "When used with L</out>, C<in> should be a reference to a CSV structure (AoA"
NSQ_SOURCE_LINE 00003620 "or AoH)  or a CODE-ref that returns an array-reference or a hash-reference."
NSQ_SOURCE_LINE 00003621 "The code-ref will be invoked with no arguments."
NSQ_SOURCE_LINE 00003622 ""
NSQ_SOURCE_LINE 00003623 " my $aoa = csv (in => \"file.csv\");"
NSQ_SOURCE_LINE 00003624 ""
NSQ_SOURCE_LINE 00003625 " open my $fh, \"<\", \"file.csv\";"
NSQ_SOURCE_LINE 00003626 " my $aoa = csv (in => $fh);"
NSQ_SOURCE_LINE 00003627 ""
NSQ_SOURCE_LINE 00003628 " my $csv = [ [qw( Foo Bar )], [ 1, 2 ], [ 2, 3 ]];"
NSQ_SOURCE_LINE 00003629 " my $err = csv (in => $csv, out => \"file.csv\");"
NSQ_SOURCE_LINE 00003630 ""
NSQ_SOURCE_LINE 00003631 "If called in void context without the L</out> attribute, the resulting ref"
NSQ_SOURCE_LINE 00003632 "will be used as input to a subsequent call to csv:"
NSQ_SOURCE_LINE 00003633 ""
NSQ_SOURCE_LINE 00003634 " csv (in => \"file.csv\", filter => { 2 => sub { length > 2 }})"
NSQ_SOURCE_LINE 00003635 ""
NSQ_SOURCE_LINE 00003636 "will be a shortcut to"
NSQ_SOURCE_LINE 00003637 ""
NSQ_SOURCE_LINE 00003638 " csv (in => csv (in => \"file.csv\", filter => { 2 => sub { length > 2 }}))"
NSQ_SOURCE_LINE 00003639 ""
NSQ_SOURCE_LINE 00003640 "where, in the absence of the C<out> attribute, this is a shortcut to"
NSQ_SOURCE_LINE 00003641 ""
NSQ_SOURCE_LINE 00003642 " csv (in  => csv (in => \"file.csv\", filter => { 2 => sub { length > 2 }}),"
NSQ_SOURCE_LINE 00003643 "      out => *STDOUT)"
NSQ_SOURCE_LINE 00003644 ""
NSQ_SOURCE_LINE 00003645 "=head3 out"
NSQ_SOURCE_LINE 00003646 "X<out>"
NSQ_SOURCE_LINE 00003647 ""
NSQ_SOURCE_LINE 00003648 " csv (in => $aoa,  out => \"file.csv\");"
NSQ_SOURCE_LINE 00003649 " csv (in => $aoa,  out => $fh);"
NSQ_SOURCE_LINE 00003650 " csv (in => $aoa,  out =>   STDOUT);"
NSQ_SOURCE_LINE 00003651 " csv (in => $aoa,  out =>  *STDOUT);"
NSQ_SOURCE_LINE 00003652 " csv (in => $aoa,  out => \\*STDOUT);"
NSQ_SOURCE_LINE 00003653 " csv (in => $aoa,  out => \\my $data);"
NSQ_SOURCE_LINE 00003654 " csv (in => $aoa,  out =>  undef);"
NSQ_SOURCE_LINE 00003655 " csv (in => $aoa,  out => \\\"skip\");"
NSQ_SOURCE_LINE 00003656 ""
NSQ_SOURCE_LINE 00003657 " csv (in => $fh,   out => \\@aoa);"
NSQ_SOURCE_LINE 00003658 " csv (in => $fh,   out => \\@aoh, bom => 1);"
NSQ_SOURCE_LINE 00003659 " csv (in => $fh,   out => \\%hsh, key => \"key\");"
NSQ_SOURCE_LINE 00003660 ""
NSQ_SOURCE_LINE 00003661 " csv (in => $file, out => $file);"
NSQ_SOURCE_LINE 00003662 " csv (in => $file, out => $fh);"
NSQ_SOURCE_LINE 00003663 " csv (in => $fh,   out => $file);"
NSQ_SOURCE_LINE 00003664 " csv (in => $fh,   out => $fh);"
NSQ_SOURCE_LINE 00003665 ""
NSQ_SOURCE_LINE 00003666 "In output mode, the default CSV options when producing CSV are"
NSQ_SOURCE_LINE 00003667 ""
NSQ_SOURCE_LINE 00003668 " eol       => \"\\r\\n\""
NSQ_SOURCE_LINE 00003669 ""
NSQ_SOURCE_LINE 00003670 "The L</fragment> attribute is ignored in output mode."
NSQ_SOURCE_LINE 00003671 ""
NSQ_SOURCE_LINE 00003672 "C<out> can be a file name  (e.g.  C<\"file.csv\">),  which will be opened for"
NSQ_SOURCE_LINE 00003673 "writing and closed when finished,  a file handle (e.g. C<$fh> or C<FH>),  a"
NSQ_SOURCE_LINE 00003674 "reference to a glob (e.g. C<\\*STDOUT>),  the glob itself (e.g. C<*STDOUT>),"
NSQ_SOURCE_LINE 00003675 "or a reference to a scalar (e.g. C<\\my $data>)."
NSQ_SOURCE_LINE 00003676 ""
NSQ_SOURCE_LINE 00003677 " csv (in => sub { $sth->fetch },            out => \"dump.csv\");"
NSQ_SOURCE_LINE 00003678 " csv (in => sub { $sth->fetchrow_hashref }, out => \"dump.csv\","
NSQ_SOURCE_LINE 00003679 "      headers => $sth->{NAME_lc});"
NSQ_SOURCE_LINE 00003680 ""
NSQ_SOURCE_LINE 00003681 "When a code-ref is used for C<in>, the output is generated  per invocation,"
NSQ_SOURCE_LINE 00003682 "so no buffering is involved. This implies that there is no size restriction"
NSQ_SOURCE_LINE 00003683 "on the number of records. The C<csv> function ends when the coderef returns"
NSQ_SOURCE_LINE 00003684 "a false value."
NSQ_SOURCE_LINE 00003685 ""
NSQ_SOURCE_LINE 00003686 "If C<out> is set to a reference of the literal string C<\"skip\">, the output"
NSQ_SOURCE_LINE 00003687 "will be suppressed completely,  which might be useful in combination with a"
NSQ_SOURCE_LINE 00003688 "filter for side effects only."
NSQ_SOURCE_LINE 00003689 ""
NSQ_SOURCE_LINE 00003690 " my %cache;"
NSQ_SOURCE_LINE 00003691 " csv (in    => \"dump.csv\","
NSQ_SOURCE_LINE 00003692 "      out   => \\\"skip\","
NSQ_SOURCE_LINE 00003693 "      on_in => sub { $cache{$_[1][1]}++ });"
NSQ_SOURCE_LINE 00003694 ""
NSQ_SOURCE_LINE 00003695 "Currently,  setting C<out> to any false value  (C<undef>, C<\"\">, 0) will be"
NSQ_SOURCE_LINE 00003696 "equivalent to C<\\\"skip\">."
NSQ_SOURCE_LINE 00003697 ""
NSQ_SOURCE_LINE 00003698 "If the C<in> argument point to something to parse, and the C<out> is set to"
NSQ_SOURCE_LINE 00003699 "a reference to an C<ARRAY> or a C<HASH>, the output is appended to the data"
NSQ_SOURCE_LINE 00003700 "in the existing reference. The result of the parse should match what exists"
NSQ_SOURCE_LINE 00003701 "in the reference passed. This might come handy when you have to parse a set"
NSQ_SOURCE_LINE 00003702 "of files with similar content (like data stored per period) and you want to"
NSQ_SOURCE_LINE 00003703 "collect that into a single data structure:"
NSQ_SOURCE_LINE 00003704 ""
NSQ_SOURCE_LINE 00003705 " my %hash;"
NSQ_SOURCE_LINE 00003706 " csv (in => $_, out => \\%hash, key => \"id\") for sort glob \"foo-[0-9]*.csv\";"
NSQ_SOURCE_LINE 00003707 ""
NSQ_SOURCE_LINE 00003708 " my @list; # List of arrays"
NSQ_SOURCE_LINE 00003709 " csv (in => $_, out => \\@list)              for sort glob \"foo-[0-9]*.csv\";"
NSQ_SOURCE_LINE 00003710 ""
NSQ_SOURCE_LINE 00003711 " my @list; # List of hashes"
NSQ_SOURCE_LINE 00003712 " csv (in => $_, out => \\@list, bom => 1)    for sort glob \"foo-[0-9]*.csv\";"
NSQ_SOURCE_LINE 00003713 ""
NSQ_SOURCE_LINE 00003714 "=head4 Streaming"
NSQ_SOURCE_LINE 00003715 "X<streaming>"
NSQ_SOURCE_LINE 00003716 ""
NSQ_SOURCE_LINE 00003717 "If B<both> C<in> and C<out> are files, file handles or globs,  streaming is"
NSQ_SOURCE_LINE 00003718 "enforced by injecting an C<after_parse> callback  that immediately uses the"
NSQ_SOURCE_LINE 00003719 "L<C<say ()>|/say> method of the same instance to output the result and then"
NSQ_SOURCE_LINE 00003720 "rejects the record."
NSQ_SOURCE_LINE 00003721 ""
NSQ_SOURCE_LINE 00003722 "If a C<after_parse> was already passed as attribute,  that will be included"
NSQ_SOURCE_LINE 00003723 "in the injected call. If C<on_in> was passed and C<after_parse> was not, it"
NSQ_SOURCE_LINE 00003724 "will be used instead. If both were passed, C<on_in> is ignored."
NSQ_SOURCE_LINE 00003725 ""
NSQ_SOURCE_LINE 00003726 "The EOL of the first record of the C<in> source is consistently used as EOL"
NSQ_SOURCE_LINE 00003727 "for all records in the C<out> destination."
NSQ_SOURCE_LINE 00003728 ""
NSQ_SOURCE_LINE 00003729 "The C<filter> attribute is not available."
NSQ_SOURCE_LINE 00003730 ""
NSQ_SOURCE_LINE 00003731 "All other attributes are shared for C<in> and C<out>,  so you cannot define"
NSQ_SOURCE_LINE 00003732 "different encodings for C<in> and C<out>.  You need to pass a C<$fh>, where"
NSQ_SOURCE_LINE 00003733 "C<binmode> was used to apply the encoding layers."
NSQ_SOURCE_LINE 00003734 ""
NSQ_SOURCE_LINE 00003735 "Note that this is work in progress and things might change."
NSQ_SOURCE_LINE 00003736 ""
NSQ_SOURCE_LINE 00003737 "=head3 encoding"
NSQ_SOURCE_LINE 00003738 "X<encoding>"
NSQ_SOURCE_LINE 00003739 ""
NSQ_SOURCE_LINE 00003740 "If passed,  it should be an encoding accepted by the  C<:encoding()> option"
NSQ_SOURCE_LINE 00003741 "to C<open>. There is no default value. This attribute does not work in perl"
NSQ_SOURCE_LINE 00003742 "5.6.x.  C<encoding> can be abbreviated to C<enc> for ease of use in command"
NSQ_SOURCE_LINE 00003743 "line invocations."
NSQ_SOURCE_LINE 00003744 ""
NSQ_SOURCE_LINE 00003745 "If C<encoding> is set to the literal value C<\"auto\">, the method L</header>"
NSQ_SOURCE_LINE 00003746 "will be invoked on the opened stream to check if there is a BOM and set the"
NSQ_SOURCE_LINE 00003747 "encoding accordingly.   This is equal to passing a true value in the option"
NSQ_SOURCE_LINE 00003748 "L<C<detect_bom>|/detect_bom>."
NSQ_SOURCE_LINE 00003749 ""
NSQ_SOURCE_LINE 00003750 "Encodings can be stacked, as supported by C<binmode>:"
NSQ_SOURCE_LINE 00003751 ""
NSQ_SOURCE_LINE 00003752 " # Using PerlIO::via::gzip"
NSQ_SOURCE_LINE 00003753 " csv (in       => \\@csv,"
NSQ_SOURCE_LINE 00003754 "      out      => \"test.csv:via.gz\","
NSQ_SOURCE_LINE 00003755 "      encoding => \":via(gzip):encoding(utf-8)\","
NSQ_SOURCE_LINE 00003756 "      );"
NSQ_SOURCE_LINE 00003757 " $aoa = csv (in => \"test.csv:via.gz\",  encoding => \":via(gzip)\");"
NSQ_SOURCE_LINE 00003758 ""
NSQ_SOURCE_LINE 00003759 " # Using PerlIO::gzip"
NSQ_SOURCE_LINE 00003760 " csv (in       => \\@csv,"
NSQ_SOURCE_LINE 00003761 "      out      => \"test.csv:via.gz\","
NSQ_SOURCE_LINE 00003762 "      encoding => \":gzip:encoding(utf-8)\","
NSQ_SOURCE_LINE 00003763 "      );"
NSQ_SOURCE_LINE 00003764 " $aoa = csv (in => \"test.csv:gzip.gz\", encoding => \":gzip\");"
NSQ_SOURCE_LINE 00003765 ""
NSQ_SOURCE_LINE 00003766 "=head3 detect_bom"
NSQ_SOURCE_LINE 00003767 "X<detect_bom>"
NSQ_SOURCE_LINE 00003768 ""
NSQ_SOURCE_LINE 00003769 "If  C<detect_bom>  is given, the method  L</header>  will be invoked on the"
NSQ_SOURCE_LINE 00003770 "opened stream to check if there is a  BOM and set the encoding accordingly."
NSQ_SOURCE_LINE 00003771 "Note that the attribute L<C<headers>|/headers>  can be used to overrule the"
NSQ_SOURCE_LINE 00003772 "default behavior of how that method automatically sets the attribute."
NSQ_SOURCE_LINE 00003773 ""
NSQ_SOURCE_LINE 00003774 "C<detect_bom> can be abbreviated to C<bom>."
NSQ_SOURCE_LINE 00003775 ""
NSQ_SOURCE_LINE 00003776 "This is the same as setting L<C<encoding>|/encoding> to C<\"auto\">."
NSQ_SOURCE_LINE 00003777 ""
NSQ_SOURCE_LINE 00003778 "=head3 headers"
NSQ_SOURCE_LINE 00003779 "X<headers>"
NSQ_SOURCE_LINE 00003780 ""
NSQ_SOURCE_LINE 00003781 "If this attribute is not given, the default behavior is to produce an array"
NSQ_SOURCE_LINE 00003782 "of arrays."
NSQ_SOURCE_LINE 00003783 ""
NSQ_SOURCE_LINE 00003784 "If C<headers> is supplied,  it should be an anonymous list of column names,"
NSQ_SOURCE_LINE 00003785 "an anonymous hashref, a coderef, or a literal flag:  C<auto>, C<lc>, C<uc>,"
NSQ_SOURCE_LINE 00003786 "or C<skip>."
NSQ_SOURCE_LINE 00003787 ""
NSQ_SOURCE_LINE 00003788 "=over 2"
NSQ_SOURCE_LINE 00003789 ""
NSQ_SOURCE_LINE 00003790 "=item skip"
NSQ_SOURCE_LINE 00003791 "X<skip>"
NSQ_SOURCE_LINE 00003792 ""
NSQ_SOURCE_LINE 00003793 "When C<skip> is used, the header will not be included in the output."
NSQ_SOURCE_LINE 00003794 ""
NSQ_SOURCE_LINE 00003795 " my $aoa = csv (in => $fh, headers => \"skip\");"
NSQ_SOURCE_LINE 00003796 ""
NSQ_SOURCE_LINE 00003797 "C<skip> is invalid/ignored in combinations with L<C<detect_bom>|/detect_bom>."
NSQ_SOURCE_LINE 00003798 ""
NSQ_SOURCE_LINE 00003799 "=item auto"
NSQ_SOURCE_LINE 00003800 "X<auto>"
NSQ_SOURCE_LINE 00003801 ""
NSQ_SOURCE_LINE 00003802 "If C<auto> is used, the first line of the C<CSV> source will be read as the"
NSQ_SOURCE_LINE 00003803 "list of field headers and used to produce an array of hashes."
NSQ_SOURCE_LINE 00003804 ""
NSQ_SOURCE_LINE 00003805 " my $aoh = csv (in => $fh, headers => \"auto\");"
NSQ_SOURCE_LINE 00003806 ""
NSQ_SOURCE_LINE 00003807 "=item lc"
NSQ_SOURCE_LINE 00003808 "X<lc>"
NSQ_SOURCE_LINE 00003809 ""
NSQ_SOURCE_LINE 00003810 "If C<lc> is used,  the first line of the  C<CSV> source will be read as the"
NSQ_SOURCE_LINE 00003811 "list of field headers mapped to  lower case and used to produce an array of"
NSQ_SOURCE_LINE 00003812 "hashes. This is a variation of C<auto>."
NSQ_SOURCE_LINE 00003813 ""
NSQ_SOURCE_LINE 00003814 " my $aoh = csv (in => $fh, headers => \"lc\");"
NSQ_SOURCE_LINE 00003815 ""
NSQ_SOURCE_LINE 00003816 "=item uc"
NSQ_SOURCE_LINE 00003817 "X<uc>"
NSQ_SOURCE_LINE 00003818 ""
NSQ_SOURCE_LINE 00003819 "If C<uc> is used,  the first line of the  C<CSV> source will be read as the"
NSQ_SOURCE_LINE 00003820 "list of field headers mapped to  upper case and used to produce an array of"
NSQ_SOURCE_LINE 00003821 "hashes. This is a variation of C<auto>."
NSQ_SOURCE_LINE 00003822 ""
NSQ_SOURCE_LINE 00003823 " my $aoh = csv (in => $fh, headers => \"uc\");"
NSQ_SOURCE_LINE 00003824 ""
NSQ_SOURCE_LINE 00003825 "=item CODE"
NSQ_SOURCE_LINE 00003826 "X<CODE>"
NSQ_SOURCE_LINE 00003827 ""
NSQ_SOURCE_LINE 00003828 "If a coderef is used,  the first line of the  C<CSV> source will be read as"
NSQ_SOURCE_LINE 00003829 "the list of mangled field headers in which each field is passed as the only"
NSQ_SOURCE_LINE 00003830 "argument to the coderef. This list is used to produce an array of hashes."
NSQ_SOURCE_LINE 00003831 ""
NSQ_SOURCE_LINE 00003832 " my $aoh = csv (in      => $fh,"
NSQ_SOURCE_LINE 00003833 "                headers => sub { lc ($_[0]) =~ s/kode/code/gr });"
NSQ_SOURCE_LINE 00003834 ""
NSQ_SOURCE_LINE 00003835 "this example is a variation of using C<lc> where all occurrences of C<kode>"
NSQ_SOURCE_LINE 00003836 "are replaced with C<code>."
NSQ_SOURCE_LINE 00003837 ""
NSQ_SOURCE_LINE 00003838 "=item ARRAY"
NSQ_SOURCE_LINE 00003839 "X<ARRAY>"
NSQ_SOURCE_LINE 00003840 ""
NSQ_SOURCE_LINE 00003841 "If  C<headers>  is an anonymous list,  the entries in the list will be used"
NSQ_SOURCE_LINE 00003842 "as field names. The first line is considered data instead of headers."
NSQ_SOURCE_LINE 00003843 ""
NSQ_SOURCE_LINE 00003844 " my $aoh = csv (in => $fh, headers => [qw( Foo Bar )]);"
NSQ_SOURCE_LINE 00003845 " csv (in => $aoa, out => $fh, headers => [qw( code description price )]);"
NSQ_SOURCE_LINE 00003846 ""
NSQ_SOURCE_LINE 00003847 "=item HASH"
NSQ_SOURCE_LINE 00003848 "X<HASH>"
NSQ_SOURCE_LINE 00003849 ""
NSQ_SOURCE_LINE 00003850 "If C<headers> is a hash reference, this implies C<auto>, but header fields"
NSQ_SOURCE_LINE 00003851 "that exist as key in the hashref will be replaced by the value for that"
NSQ_SOURCE_LINE 00003852 "key. Given a CSV file like"
NSQ_SOURCE_LINE 00003853 ""
NSQ_SOURCE_LINE 00003854 " post-kode,city,name,id number,fubble"
NSQ_SOURCE_LINE 00003855 " 1234AA,Duckstad,Donald,13,\"X313DF\""
NSQ_SOURCE_LINE 00003856 ""
NSQ_SOURCE_LINE 00003857 "using"
NSQ_SOURCE_LINE 00003858 ""
NSQ_SOURCE_LINE 00003859 " csv (headers => { \"post-kode\" => \"pc\", \"id number\" => \"ID\" }, ..."
NSQ_SOURCE_LINE 00003860 ""
NSQ_SOURCE_LINE 00003861 "will return an entry like"
NSQ_SOURCE_LINE 00003862 ""
NSQ_SOURCE_LINE 00003863 " { pc     => \"1234AA\","
NSQ_SOURCE_LINE 00003864 "   city   => \"Duckstad\","
NSQ_SOURCE_LINE 00003865 "   name   => \"Donald\","
NSQ_SOURCE_LINE 00003866 "   ID     => \"13\","
NSQ_SOURCE_LINE 00003867 "   fubble => \"X313DF\","
NSQ_SOURCE_LINE 00003868 "   }"
NSQ_SOURCE_LINE 00003869 ""
NSQ_SOURCE_LINE 00003870 "=back"
NSQ_SOURCE_LINE 00003871 ""
NSQ_SOURCE_LINE 00003872 "See also L<C<munge_column_names>|/munge_column_names> and"
NSQ_SOURCE_LINE 00003873 "L<C<set_column_names>|/set_column_names>."
NSQ_SOURCE_LINE 00003874 ""
NSQ_SOURCE_LINE 00003875 "=head3 munge_column_names"
NSQ_SOURCE_LINE 00003876 "X<munge_column_names>"
NSQ_SOURCE_LINE 00003877 ""
NSQ_SOURCE_LINE 00003878 "If C<munge_column_names> is set,  the method  L</header>  is invoked on the"
NSQ_SOURCE_LINE 00003879 "opened stream with all matching arguments to detect and set the headers."
NSQ_SOURCE_LINE 00003880 ""
NSQ_SOURCE_LINE 00003881 "C<munge_column_names> can be abbreviated to C<munge>."
NSQ_SOURCE_LINE 00003882 ""
NSQ_SOURCE_LINE 00003883 "=head3 key"
NSQ_SOURCE_LINE 00003884 "X<key>"
NSQ_SOURCE_LINE 00003885 ""
NSQ_SOURCE_LINE 00003886 "If passed,  will default  L<C<headers>|/headers>  to C<\"auto\"> and return a"
NSQ_SOURCE_LINE 00003887 "hashref instead of an array of hashes. Allowed values are simple scalars or"
NSQ_SOURCE_LINE 00003888 "array-references where the first element is the joiner and the rest are the"
NSQ_SOURCE_LINE 00003889 "fields to join to combine the key."
NSQ_SOURCE_LINE 00003890 ""
NSQ_SOURCE_LINE 00003891 " my $ref = csv (in => \"test.csv\", key => \"code\");"
NSQ_SOURCE_LINE 00003892 " my $ref = csv (in => \"test.csv\", key => [ \":\" => \"code\", \"color\" ]);"
NSQ_SOURCE_LINE 00003893 ""
NSQ_SOURCE_LINE 00003894 "with test.csv like"
NSQ_SOURCE_LINE 00003895 ""
NSQ_SOURCE_LINE 00003896 " code,product,price,color"
NSQ_SOURCE_LINE 00003897 " 1,pc,850,gray"
NSQ_SOURCE_LINE 00003898 " 2,keyboard,12,white"
NSQ_SOURCE_LINE 00003899 " 3,mouse,5,black"
NSQ_SOURCE_LINE 00003900 ""
NSQ_SOURCE_LINE 00003901 "the first example will return"
NSQ_SOURCE_LINE 00003902 ""
NSQ_SOURCE_LINE 00003903 "  { 1   => {"
NSQ_SOURCE_LINE 00003904 "        code    => 1,"
NSQ_SOURCE_LINE 00003905 "        color   => 'gray',"
NSQ_SOURCE_LINE 00003906 "        price   => 850,"
NSQ_SOURCE_LINE 00003907 "        product => 'pc'"
NSQ_SOURCE_LINE 00003908 "        },"
NSQ_SOURCE_LINE 00003909 "    2   => {"
NSQ_SOURCE_LINE 00003910 "        code    => 2,"
NSQ_SOURCE_LINE 00003911 "        color   => 'white',"
NSQ_SOURCE_LINE 00003912 "        price   => 12,"
NSQ_SOURCE_LINE 00003913 "        product => 'keyboard'"
NSQ_SOURCE_LINE 00003914 "        },"
NSQ_SOURCE_LINE 00003915 "    3   => {"
NSQ_SOURCE_LINE 00003916 "        code    => 3,"
NSQ_SOURCE_LINE 00003917 "        color   => 'black',"
NSQ_SOURCE_LINE 00003918 "        price   => 5,"
NSQ_SOURCE_LINE 00003919 "        product => 'mouse'"
NSQ_SOURCE_LINE 00003920 "        }"
NSQ_SOURCE_LINE 00003921 "    }"
NSQ_SOURCE_LINE 00003922 ""
NSQ_SOURCE_LINE 00003923 "the second example will return"
NSQ_SOURCE_LINE 00003924 ""
NSQ_SOURCE_LINE 00003925 "  { \"1:gray\"    => {"
NSQ_SOURCE_LINE 00003926 "        code    => 1,"
NSQ_SOURCE_LINE 00003927 "        color   => 'gray',"
NSQ_SOURCE_LINE 00003928 "        price   => 850,"
NSQ_SOURCE_LINE 00003929 "        product => 'pc'"
NSQ_SOURCE_LINE 00003930 "        },"
NSQ_SOURCE_LINE 00003931 "    \"2:white\"   => {"
NSQ_SOURCE_LINE 00003932 "        code    => 2,"
NSQ_SOURCE_LINE 00003933 "        color   => 'white',"
NSQ_SOURCE_LINE 00003934 "        price   => 12,"
NSQ_SOURCE_LINE 00003935 "        product => 'keyboard'"
NSQ_SOURCE_LINE 00003936 "        },"
NSQ_SOURCE_LINE 00003937 "    \"3:black\"   => {"
NSQ_SOURCE_LINE 00003938 "        code    => 3,"
NSQ_SOURCE_LINE 00003939 "        color   => 'black',"
NSQ_SOURCE_LINE 00003940 "        price   => 5,"
NSQ_SOURCE_LINE 00003941 "        product => 'mouse'"
NSQ_SOURCE_LINE 00003942 "        }"
NSQ_SOURCE_LINE 00003943 "    }"
NSQ_SOURCE_LINE 00003944 ""
NSQ_SOURCE_LINE 00003945 "The C<key> attribute can be combined with L<C<headers>|/headers> for C<CSV>"
NSQ_SOURCE_LINE 00003946 "date that has no header line, like"
NSQ_SOURCE_LINE 00003947 ""
NSQ_SOURCE_LINE 00003948 " my $ref = csv ("
NSQ_SOURCE_LINE 00003949 "     in      => \"foo.csv\","
NSQ_SOURCE_LINE 00003950 "     headers => [qw( c_foo foo bar description stock )],"
NSQ_SOURCE_LINE 00003951 "     key     =>     \"c_foo\","
NSQ_SOURCE_LINE 00003952 "     );"
NSQ_SOURCE_LINE 00003953 ""
NSQ_SOURCE_LINE 00003954 "=head3 value"
NSQ_SOURCE_LINE 00003955 "X<value>"
NSQ_SOURCE_LINE 00003956 ""
NSQ_SOURCE_LINE 00003957 "Used to create key-value hashes."
NSQ_SOURCE_LINE 00003958 ""
NSQ_SOURCE_LINE 00003959 "Only allowed when C<key> is valid. A C<value> can be either a single column"
NSQ_SOURCE_LINE 00003960 "label or an anonymous list of column labels.  In the first case,  the value"
NSQ_SOURCE_LINE 00003961 "will be a simple scalar value, in the latter case, it will be a hashref."
NSQ_SOURCE_LINE 00003962 ""
NSQ_SOURCE_LINE 00003963 " my $ref = csv (in => \"test.csv\", key   => \"code\","
NSQ_SOURCE_LINE 00003964 "                                  value => \"price\");"
NSQ_SOURCE_LINE 00003965 " my $ref = csv (in => \"test.csv\", key   => \"code\","
NSQ_SOURCE_LINE 00003966 "                                  value => [ \"product\", \"price\" ]);"
NSQ_SOURCE_LINE 00003967 " my $ref = csv (in => \"test.csv\", key   => [ \":\" => \"code\", \"color\" ],"
NSQ_SOURCE_LINE 00003968 "                                  value => \"price\");"
NSQ_SOURCE_LINE 00003969 " my $ref = csv (in => \"test.csv\", key   => [ \":\" => \"code\", \"color\" ],"
NSQ_SOURCE_LINE 00003970 "                                  value => [ \"product\", \"price\" ]);"
NSQ_SOURCE_LINE 00003971 ""
NSQ_SOURCE_LINE 00003972 "with test.csv like"
NSQ_SOURCE_LINE 00003973 ""
NSQ_SOURCE_LINE 00003974 " code,product,price,color"
NSQ_SOURCE_LINE 00003975 " 1,pc,850,gray"
NSQ_SOURCE_LINE 00003976 " 2,keyboard,12,white"
NSQ_SOURCE_LINE 00003977 " 3,mouse,5,black"
NSQ_SOURCE_LINE 00003978 ""
NSQ_SOURCE_LINE 00003979 "the first example will return"
NSQ_SOURCE_LINE 00003980 ""
NSQ_SOURCE_LINE 00003981 "  { 1 => 850,"
NSQ_SOURCE_LINE 00003982 "    2 =>  12,"
NSQ_SOURCE_LINE 00003983 "    3 =>   5,"
NSQ_SOURCE_LINE 00003984 "    }"
NSQ_SOURCE_LINE 00003985 ""
NSQ_SOURCE_LINE 00003986 "the second example will return"
NSQ_SOURCE_LINE 00003987 ""
NSQ_SOURCE_LINE 00003988 "  { 1   => {"
NSQ_SOURCE_LINE 00003989 "        price   => 850,"
NSQ_SOURCE_LINE 00003990 "        product => 'pc'"
NSQ_SOURCE_LINE 00003991 "        },"
NSQ_SOURCE_LINE 00003992 "    2   => {"
NSQ_SOURCE_LINE 00003993 "        price   => 12,"
NSQ_SOURCE_LINE 00003994 "        product => 'keyboard'"
NSQ_SOURCE_LINE 00003995 "        },"
NSQ_SOURCE_LINE 00003996 "    3   => {"
NSQ_SOURCE_LINE 00003997 "        price   => 5,"
NSQ_SOURCE_LINE 00003998 "        product => 'mouse'"
NSQ_SOURCE_LINE 00003999 "        }"
NSQ_SOURCE_LINE 00004000 "    }"
NSQ_SOURCE_LINE 00004001 ""
NSQ_SOURCE_LINE 00004002 "the third example will return"
NSQ_SOURCE_LINE 00004003 ""
NSQ_SOURCE_LINE 00004004 "  { \"1:gray\"    => 850,"
NSQ_SOURCE_LINE 00004005 "    \"2:white\"   =>  12,"
NSQ_SOURCE_LINE 00004006 "    \"3:black\"   =>   5,"
NSQ_SOURCE_LINE 00004007 "    }"
NSQ_SOURCE_LINE 00004008 ""
NSQ_SOURCE_LINE 00004009 "the fourth example will return"
NSQ_SOURCE_LINE 00004010 ""
NSQ_SOURCE_LINE 00004011 "  { \"1:gray\"    => {"
NSQ_SOURCE_LINE 00004012 "        price   => 850,"
NSQ_SOURCE_LINE 00004013 "        product => 'pc'"
NSQ_SOURCE_LINE 00004014 "        },"
NSQ_SOURCE_LINE 00004015 "    \"2:white\"   => {"
NSQ_SOURCE_LINE 00004016 "        price   => 12,"
NSQ_SOURCE_LINE 00004017 "        product => 'keyboard'"
NSQ_SOURCE_LINE 00004018 "        },"
NSQ_SOURCE_LINE 00004019 "    \"3:black\"   => {"
NSQ_SOURCE_LINE 00004020 "        price   => 5,"
NSQ_SOURCE_LINE 00004021 "        product => 'mouse'"
NSQ_SOURCE_LINE 00004022 "        }"
NSQ_SOURCE_LINE 00004023 "    }"
NSQ_SOURCE_LINE 00004024 ""
NSQ_SOURCE_LINE 00004025 "=head3 keep_headers"
NSQ_SOURCE_LINE 00004026 "X<keep_headers>"
NSQ_SOURCE_LINE 00004027 "X<keep_column_names>"
NSQ_SOURCE_LINE 00004028 "X<kh>"
NSQ_SOURCE_LINE 00004029 ""
NSQ_SOURCE_LINE 00004030 "When using hashes,  keep the column names into the arrayref passed,  so all"
NSQ_SOURCE_LINE 00004031 "headers are available after the call in the original order."
NSQ_SOURCE_LINE 00004032 ""
NSQ_SOURCE_LINE 00004033 " my $aoh = csv (in => \"file.csv\", keep_headers => \\my @hdr);"
NSQ_SOURCE_LINE 00004034 ""
NSQ_SOURCE_LINE 00004035 "This attribute can be abbreviated to C<kh> or passed as C<keep_column_names>."
NSQ_SOURCE_LINE 00004036 ""
NSQ_SOURCE_LINE 00004037 "This attribute implies a default of C<auto> for the C<headers> attribute."
NSQ_SOURCE_LINE 00004038 ""
NSQ_SOURCE_LINE 00004039 "X<stable header order>"
NSQ_SOURCE_LINE 00004040 "X<internal headers>"
NSQ_SOURCE_LINE 00004041 "The headers can also be kept internally to keep stable header order:"
NSQ_SOURCE_LINE 00004042 ""
NSQ_SOURCE_LINE 00004043 " csv (in      => csv (in => \"file.csv\", kh => \"internal\"),"
NSQ_SOURCE_LINE 00004044 "      out     => \"new.csv\","
NSQ_SOURCE_LINE 00004045 "      kh      => \"internal\");"
NSQ_SOURCE_LINE 00004046 ""
NSQ_SOURCE_LINE 00004047 "where C<internal> can also be C<1>, C<yes>, or C<true>. This is similar to"
NSQ_SOURCE_LINE 00004048 ""
NSQ_SOURCE_LINE 00004049 " my @h;"
NSQ_SOURCE_LINE 00004050 " csv (in      => csv (in => \"file.csv\", kh => \\@h),"
NSQ_SOURCE_LINE 00004051 "      out     => \"new.csv\","
NSQ_SOURCE_LINE 00004052 "      headers => \\@h);"
NSQ_SOURCE_LINE 00004053 ""
NSQ_SOURCE_LINE 00004054 "=head3 fragment"
NSQ_SOURCE_LINE 00004055 "X<fragment>"
NSQ_SOURCE_LINE 00004056 ""
NSQ_SOURCE_LINE 00004057 "Only output the fragment as defined in the L</fragment> method. This option"
NSQ_SOURCE_LINE 00004058 "is ignored when I<generating> C<CSV>. See L</out>."
NSQ_SOURCE_LINE 00004059 ""
NSQ_SOURCE_LINE 00004060 "Combining all of them could give something like"
NSQ_SOURCE_LINE 00004061 ""
NSQ_SOURCE_LINE 00004062 " use Text::CSV_XS qw( csv );"
NSQ_SOURCE_LINE 00004063 " my $aoh = csv ("
NSQ_SOURCE_LINE 00004064 "     in       => \"test.txt\","
NSQ_SOURCE_LINE 00004065 "     encoding => \"utf-8\","
NSQ_SOURCE_LINE 00004066 "     headers  => \"auto\","
NSQ_SOURCE_LINE 00004067 "     sep_char => \"|\","
NSQ_SOURCE_LINE 00004068 "     fragment => \"row=3;6-9;15-*\","
NSQ_SOURCE_LINE 00004069 "     );"
NSQ_SOURCE_LINE 00004070 " say $aoh->[15]{Foo};"
NSQ_SOURCE_LINE 00004071 ""
NSQ_SOURCE_LINE 00004072 "=head3 sep_set"
NSQ_SOURCE_LINE 00004073 "X<sep_set>"
NSQ_SOURCE_LINE 00004074 "X<seps>"
NSQ_SOURCE_LINE 00004075 ""
NSQ_SOURCE_LINE 00004076 "If C<sep_set> is set, the method L</header> is invoked on the opened stream"
NSQ_SOURCE_LINE 00004077 "to detect and set L<C<sep_char>|/sep_char> with the given set."
NSQ_SOURCE_LINE 00004078 ""
NSQ_SOURCE_LINE 00004079 "C<sep_set> can be abbreviated to C<seps>. If neither C<sep_set> not C<seps>"
NSQ_SOURCE_LINE 00004080 "is given, but C<sep> is defined, C<sep_set> defaults to C<[ sep ]>. This is"
NSQ_SOURCE_LINE 00004081 "only supported for perl version 5.10 and up."
NSQ_SOURCE_LINE 00004082 ""
NSQ_SOURCE_LINE 00004083 "Note that as the  L</header> method is invoked,  its default is to also set"
NSQ_SOURCE_LINE 00004084 "the headers."
NSQ_SOURCE_LINE 00004085 ""
NSQ_SOURCE_LINE 00004086 "=head3 set_column_names"
NSQ_SOURCE_LINE 00004087 "X<set_column_names>"
NSQ_SOURCE_LINE 00004088 ""
NSQ_SOURCE_LINE 00004089 "If  C<set_column_names> is passed,  the method L</header> is invoked on the"
NSQ_SOURCE_LINE 00004090 "opened stream with all arguments meant for L</header>."
NSQ_SOURCE_LINE 00004091 ""
NSQ_SOURCE_LINE 00004092 "If C<set_column_names> is passed as a false value, the content of the first"
NSQ_SOURCE_LINE 00004093 "row is only preserved if the output is AoA:"
NSQ_SOURCE_LINE 00004094 ""
NSQ_SOURCE_LINE 00004095 "With an input-file like"
NSQ_SOURCE_LINE 00004096 ""
NSQ_SOURCE_LINE 00004097 " bAr,foo"
NSQ_SOURCE_LINE 00004098 " 1,2"
NSQ_SOURCE_LINE 00004099 " 3,4,5"
NSQ_SOURCE_LINE 00004100 ""
NSQ_SOURCE_LINE 00004101 "This call"
NSQ_SOURCE_LINE 00004102 ""
NSQ_SOURCE_LINE 00004103 " my $aoa = csv (in => $file, set_column_names => 0);"
NSQ_SOURCE_LINE 00004104 ""
NSQ_SOURCE_LINE 00004105 "will result in"
NSQ_SOURCE_LINE 00004106 ""
NSQ_SOURCE_LINE 00004107 " [[ \"bar\", \"foo\"     ],"
NSQ_SOURCE_LINE 00004108 "  [ \"1\",   \"2\"       ],"
NSQ_SOURCE_LINE 00004109 "  [ \"3\",   \"4\",  \"5\" ]]"
NSQ_SOURCE_LINE 00004110 ""
NSQ_SOURCE_LINE 00004111 "and"
NSQ_SOURCE_LINE 00004112 ""
NSQ_SOURCE_LINE 00004113 " my $aoa = csv (in => $file, set_column_names => 0, munge => \"none\");"
NSQ_SOURCE_LINE 00004114 ""
NSQ_SOURCE_LINE 00004115 "will result in"
NSQ_SOURCE_LINE 00004116 ""
NSQ_SOURCE_LINE 00004117 " [[ \"bAr\", \"foo\"     ],"
NSQ_SOURCE_LINE 00004118 "  [ \"1\",   \"2\"       ],"
NSQ_SOURCE_LINE 00004119 "  [ \"3\",   \"4\",  \"5\" ]]"
NSQ_SOURCE_LINE 00004120 ""
NSQ_SOURCE_LINE 00004121 "=head3 csv"
NSQ_SOURCE_LINE 00004122 "X<csv>"
NSQ_SOURCE_LINE 00004123 ""
NSQ_SOURCE_LINE 00004124 "The I<function>  L</csv> can also be called as a method or with an existing"
NSQ_SOURCE_LINE 00004125 "Text::CSV_XS object. This could help if the function is to be invoked a lot"
NSQ_SOURCE_LINE 00004126 "of times and the overhead of creating the object internally over  and  over"
NSQ_SOURCE_LINE 00004127 "again would be prevented by passing an existing instance."
NSQ_SOURCE_LINE 00004128 ""
NSQ_SOURCE_LINE 00004129 " my $csv = Text::CSV_XS->new ({ binary => 1, auto_diag => 1 });"
NSQ_SOURCE_LINE 00004130 ""
NSQ_SOURCE_LINE 00004131 " my $aoa = $csv->csv (in => $fh);"
NSQ_SOURCE_LINE 00004132 " my $aoa = csv (in => $fh, csv => $csv);"
NSQ_SOURCE_LINE 00004133 ""
NSQ_SOURCE_LINE 00004134 "both act the same. Running this 20000 times on a 20 lines CSV file,  showed"
NSQ_SOURCE_LINE 00004135 "a 53% speedup."
NSQ_SOURCE_LINE 00004136 ""
NSQ_SOURCE_LINE 00004137 "=head2 Callbacks"
NSQ_SOURCE_LINE 00004138 "X<Callbacks>"
NSQ_SOURCE_LINE 00004139 ""
NSQ_SOURCE_LINE 00004140 "Callbacks enable actions triggered from the I<inside> of Text::CSV_XS."
NSQ_SOURCE_LINE 00004141 ""
NSQ_SOURCE_LINE 00004142 "While most of what this enables  can easily be done in an  unrolled loop as"
NSQ_SOURCE_LINE 00004143 "described in the L</SYNOPSIS> callbacks can be used to meet special demands"
NSQ_SOURCE_LINE 00004144 "or enhance the L</csv> function."
NSQ_SOURCE_LINE 00004145 ""
NSQ_SOURCE_LINE 00004146 "=over 2"
NSQ_SOURCE_LINE 00004147 ""
NSQ_SOURCE_LINE 00004148 "=item error"
NSQ_SOURCE_LINE 00004149 "X<error>"
NSQ_SOURCE_LINE 00004150 ""
NSQ_SOURCE_LINE 00004151 " $csv->callbacks (error => sub { $csv->SetDiag (0) });"
NSQ_SOURCE_LINE 00004152 ""
NSQ_SOURCE_LINE 00004153 "the C<error>  callback is invoked when an error occurs,  but  I<only>  when"
NSQ_SOURCE_LINE 00004154 "L</auto_diag> is set to a true value. A callback is invoked with the values"
NSQ_SOURCE_LINE 00004155 "returned by L</error_diag>:"
NSQ_SOURCE_LINE 00004156 ""
NSQ_SOURCE_LINE 00004157 " my ($c, $s);"
NSQ_SOURCE_LINE 00004158 ""
NSQ_SOURCE_LINE 00004159 " sub ignore3006 {"
NSQ_SOURCE_LINE 00004160 "     my ($err, $msg, $pos, $recno, $fldno) = @_;"
NSQ_SOURCE_LINE 00004161 "     if ($err == 3006) {"
NSQ_SOURCE_LINE 00004162 "         # ignore this error"
NSQ_SOURCE_LINE 00004163 "         ($c, $s) = (undef, undef);"
NSQ_SOURCE_LINE 00004164 "         Text::CSV_XS->SetDiag (0);"
NSQ_SOURCE_LINE 00004165 "         }"
NSQ_SOURCE_LINE 00004166 "     # Any other error"
NSQ_SOURCE_LINE 00004167 "     return;"
NSQ_SOURCE_LINE 00004168 "     } # ignore3006"
NSQ_SOURCE_LINE 00004169 ""
NSQ_SOURCE_LINE 00004170 " $csv->callbacks (error => \\&ignore3006);"
NSQ_SOURCE_LINE 00004171 " $csv->bind_columns (\\$c, \\$s);"
NSQ_SOURCE_LINE 00004172 " while ($csv->getline ($fh)) {"
NSQ_SOURCE_LINE 00004173 "     # Error 3006 will not stop the loop"
NSQ_SOURCE_LINE 00004174 "     }"
NSQ_SOURCE_LINE 00004175 ""
NSQ_SOURCE_LINE 00004176 "=item after_parse"
NSQ_SOURCE_LINE 00004177 "X<after_parse>"
NSQ_SOURCE_LINE 00004178 ""
NSQ_SOURCE_LINE 00004179 " $csv->callbacks (after_parse => sub { push @{$_[1]}, \"NEW\" });"
NSQ_SOURCE_LINE 00004180 " while (my $row = $csv->getline ($fh)) {"
NSQ_SOURCE_LINE 00004181 "     $row->[-1] eq \"NEW\";"
NSQ_SOURCE_LINE 00004182 "     }"
NSQ_SOURCE_LINE 00004183 ""
NSQ_SOURCE_LINE 00004184 "This callback is invoked after parsing with  L</getline>  only if no  error"
NSQ_SOURCE_LINE 00004185 "occurred.  The callback is invoked with two arguments:   the current C<CSV>"
NSQ_SOURCE_LINE 00004186 "parser object and an array reference to the fields parsed."
NSQ_SOURCE_LINE 00004187 ""
NSQ_SOURCE_LINE 00004188 "The return code of the callback is ignored  unless it is a reference to the"
NSQ_SOURCE_LINE 00004189 "string \"skip\", in which case the record will be skipped in L</getline_all>."
NSQ_SOURCE_LINE 00004190 ""
NSQ_SOURCE_LINE 00004191 " sub add_from_db {"
NSQ_SOURCE_LINE 00004192 "     my ($csv, $row) = @_;"
NSQ_SOURCE_LINE 00004193 "     $sth->execute ($row->[4]);"
NSQ_SOURCE_LINE 00004194 "     push @$row, $sth->fetchrow_array;"
NSQ_SOURCE_LINE 00004195 "     } # add_from_db"
NSQ_SOURCE_LINE 00004196 ""
NSQ_SOURCE_LINE 00004197 " my $aoa = csv (in => \"file.csv\", callbacks => {"
NSQ_SOURCE_LINE 00004198 "     after_parse => \\&add_from_db });"
NSQ_SOURCE_LINE 00004199 ""
NSQ_SOURCE_LINE 00004200 "This hook can be used for validation:"
NSQ_SOURCE_LINE 00004201 "X<data_validation>"
NSQ_SOURCE_LINE 00004202 ""
NSQ_SOURCE_LINE 00004203 "=over 2"
NSQ_SOURCE_LINE 00004204 ""
NSQ_SOURCE_LINE 00004205 "=item FAIL"
NSQ_SOURCE_LINE 00004206 ""
NSQ_SOURCE_LINE 00004207 "Die if any of the records does not validate a rule:"
NSQ_SOURCE_LINE 00004208 ""
NSQ_SOURCE_LINE 00004209 " after_parse => sub {"
NSQ_SOURCE_LINE 00004210 "     $_[1][4] =~ m/^[0-9]{4}\\s?[A-Z]{2}$/ or"
NSQ_SOURCE_LINE 00004211 "         die \"5th field does not have a valid Dutch zipcode\";"
NSQ_SOURCE_LINE 00004212 "     }"
NSQ_SOURCE_LINE 00004213 ""
NSQ_SOURCE_LINE 00004214 "=item DEFAULT"
NSQ_SOURCE_LINE 00004215 ""
NSQ_SOURCE_LINE 00004216 "Replace invalid fields with a default value:"
NSQ_SOURCE_LINE 00004217 ""
NSQ_SOURCE_LINE 00004218 " after_parse => sub { $_[1][2] =~ m/^\\d+$/ or $_[1][2] = 0 }"
NSQ_SOURCE_LINE 00004219 ""
NSQ_SOURCE_LINE 00004220 "=item SKIP"
NSQ_SOURCE_LINE 00004221 ""
NSQ_SOURCE_LINE 00004222 "Skip records that have invalid fields (only applies to L</getline_all>):"
NSQ_SOURCE_LINE 00004223 ""
NSQ_SOURCE_LINE 00004224 " after_parse => sub { $_[1][0] =~ m/^\\d+$/ or return \\\"skip\"; }"
NSQ_SOURCE_LINE 00004225 ""
NSQ_SOURCE_LINE 00004226 "=back"
NSQ_SOURCE_LINE 00004227 ""
NSQ_SOURCE_LINE 00004228 "=item before_print"
NSQ_SOURCE_LINE 00004229 "X<before_print>"
NSQ_SOURCE_LINE 00004230 ""
NSQ_SOURCE_LINE 00004231 " my $idx = 1;"
NSQ_SOURCE_LINE 00004232 " $csv->callbacks (before_print => sub { $_[1][0] = $idx++ });"
NSQ_SOURCE_LINE 00004233 " $csv->print (*STDOUT, [ 0, $_ ]) for @members;"
NSQ_SOURCE_LINE 00004234 ""
NSQ_SOURCE_LINE 00004235 "This callback is invoked  before printing with  L</print>  only if no error"
NSQ_SOURCE_LINE 00004236 "occurred.  The callback is invoked with two arguments:  the current  C<CSV>"
NSQ_SOURCE_LINE 00004237 "parser object and an array reference to the fields passed."
NSQ_SOURCE_LINE 00004238 ""
NSQ_SOURCE_LINE 00004239 "The return code of the callback is ignored."
NSQ_SOURCE_LINE 00004240 ""
NSQ_SOURCE_LINE 00004241 " sub max_4_fields {"
NSQ_SOURCE_LINE 00004242 "     my ($csv, $row) = @_;"
NSQ_SOURCE_LINE 00004243 "     @$row > 4 and splice @$row, 4;"
NSQ_SOURCE_LINE 00004244 "     } # max_4_fields"
NSQ_SOURCE_LINE 00004245 ""
NSQ_SOURCE_LINE 00004246 " csv (in => csv (in => \"file.csv\"), out => *STDOUT,"
NSQ_SOURCE_LINE 00004247 "     callbacks => { before_print => \\&max_4_fields });"
NSQ_SOURCE_LINE 00004248 ""
NSQ_SOURCE_LINE 00004249 "This callback is not active for L</combine>."
NSQ_SOURCE_LINE 00004250 ""
NSQ_SOURCE_LINE 00004251 "=back"
NSQ_SOURCE_LINE 00004252 ""
NSQ_SOURCE_LINE 00004253 "=head3 Callbacks for csv ()"
NSQ_SOURCE_LINE 00004254 ""
NSQ_SOURCE_LINE 00004255 "The L</csv> allows for some callbacks that do not integrate in XS internals"
NSQ_SOURCE_LINE 00004256 "but only feature the L</csv> function."
NSQ_SOURCE_LINE 00004257 ""
NSQ_SOURCE_LINE 00004258 "  csv (in        => \"file.csv\","
NSQ_SOURCE_LINE 00004259 "       callbacks => {"
NSQ_SOURCE_LINE 00004260 "           filter       => { 6 => sub { $_ > 15 } },    # first"
NSQ_SOURCE_LINE 00004261 "           after_parse  => sub { say \"AFTER PARSE\";  }, # first"
NSQ_SOURCE_LINE 00004262 "           after_in     => sub { say \"AFTER IN\";     }, # second"
NSQ_SOURCE_LINE 00004263 "           on_in        => sub { say \"ON IN\";        }, # third"
NSQ_SOURCE_LINE 00004264 "           },"
NSQ_SOURCE_LINE 00004265 "       );"
NSQ_SOURCE_LINE 00004266 ""
NSQ_SOURCE_LINE 00004267 "  csv (in        => $aoh,"
NSQ_SOURCE_LINE 00004268 "       out       => \"file.csv\","
NSQ_SOURCE_LINE 00004269 "       callbacks => {"
NSQ_SOURCE_LINE 00004270 "           on_in        => sub { say \"ON IN\";        }, # first"
NSQ_SOURCE_LINE 00004271 "           before_out   => sub { say \"BEFORE OUT\";   }, # second"
NSQ_SOURCE_LINE 00004272 "           before_print => sub { say \"BEFORE PRINT\"; }, # third"
NSQ_SOURCE_LINE 00004273 "           },"
NSQ_SOURCE_LINE 00004274 "       );"
NSQ_SOURCE_LINE 00004275 ""
NSQ_SOURCE_LINE 00004276 "=over 2"
NSQ_SOURCE_LINE 00004277 ""
NSQ_SOURCE_LINE 00004278 "=item filter"
NSQ_SOURCE_LINE 00004279 "X<filter>"
NSQ_SOURCE_LINE 00004280 ""
NSQ_SOURCE_LINE 00004281 "This callback can be used to filter records.  It is called just after a new"
NSQ_SOURCE_LINE 00004282 "record has been scanned.  The callback accepts a:"
NSQ_SOURCE_LINE 00004283 ""
NSQ_SOURCE_LINE 00004284 "=over 2"
NSQ_SOURCE_LINE 00004285 ""
NSQ_SOURCE_LINE 00004286 "=item hashref"
NSQ_SOURCE_LINE 00004287 ""
NSQ_SOURCE_LINE 00004288 "The keys are the index to the row (the field name or field number, 1-based)"
NSQ_SOURCE_LINE 00004289 "and the values are subs to return a true or false value."
NSQ_SOURCE_LINE 00004290 ""
NSQ_SOURCE_LINE 00004291 " csv (in => \"file.csv\", filter => {"
NSQ_SOURCE_LINE 00004292 "            3 => sub { m/a/ },       # third field should contain an \"a\""
NSQ_SOURCE_LINE 00004293 "            5 => sub { length > 4 }, # length of the 5th field minimal 5"
NSQ_SOURCE_LINE 00004294 "            });"
NSQ_SOURCE_LINE 00004295 ""
NSQ_SOURCE_LINE 00004296 " csv (in => \"file.csv\", filter => { foo => sub { $_ > 4 }});"
NSQ_SOURCE_LINE 00004297 ""
NSQ_SOURCE_LINE 00004298 "If the keys to the filter hash contain any character that is not a digit it"
NSQ_SOURCE_LINE 00004299 "will also implicitly set L</headers> to C<\"auto\">  unless  L</headers>  was"
NSQ_SOURCE_LINE 00004300 "already passed as argument.  When headers are active, returning an array of"
NSQ_SOURCE_LINE 00004301 "hashes, the filter is not applicable to the header itself."
NSQ_SOURCE_LINE 00004302 ""
NSQ_SOURCE_LINE 00004303 "All sub results should match, as in AND."
NSQ_SOURCE_LINE 00004304 ""
NSQ_SOURCE_LINE 00004305 "The context of the callback sets  C<$_> localized to the field indicated by"
NSQ_SOURCE_LINE 00004306 "the filter. The two arguments are as with all other callbacks, so the other"
NSQ_SOURCE_LINE 00004307 "fields in the current row can be seen:"
NSQ_SOURCE_LINE 00004308 ""
NSQ_SOURCE_LINE 00004309 " filter => { 3 => sub { $_ > 100 ? $_[1][1] =~ m/A/ : $_[1][6] =~ m/B/ }}"
NSQ_SOURCE_LINE 00004310 ""
NSQ_SOURCE_LINE 00004311 "If the context is set to return a list of hashes  (L</headers> is defined),"
NSQ_SOURCE_LINE 00004312 "the current record will also be available in the localized C<%_>:"
NSQ_SOURCE_LINE 00004313 ""
NSQ_SOURCE_LINE 00004314 " filter => { 3 => sub { $_ > 100 && $_{foo} =~ m/A/ && $_{bar} < 1000  }}"
NSQ_SOURCE_LINE 00004315 ""
NSQ_SOURCE_LINE 00004316 "If the filter is used to I<alter> the content by changing C<$_>,  make sure"
NSQ_SOURCE_LINE 00004317 "that the sub returns true in order not to have that record skipped:"
NSQ_SOURCE_LINE 00004318 ""
NSQ_SOURCE_LINE 00004319 " filter => { 2 => sub { $_ = uc }}"
NSQ_SOURCE_LINE 00004320 ""
NSQ_SOURCE_LINE 00004321 "will upper-case the second field, and then skip it if the resulting content"
NSQ_SOURCE_LINE 00004322 "evaluates to false. To always accept, end with truth:"
NSQ_SOURCE_LINE 00004323 ""
NSQ_SOURCE_LINE 00004324 " filter => { 2 => sub { $_ = uc; 1 }}"
NSQ_SOURCE_LINE 00004325 ""
NSQ_SOURCE_LINE 00004326 "=item coderef"
NSQ_SOURCE_LINE 00004327 ""
NSQ_SOURCE_LINE 00004328 " csv (in => \"file.csv\", filter => sub { $n++; 0; });"
NSQ_SOURCE_LINE 00004329 ""
NSQ_SOURCE_LINE 00004330 "If the argument to C<filter> is a coderef,  it is an alias or shortcut to a"
NSQ_SOURCE_LINE 00004331 "filter on column 0:"
NSQ_SOURCE_LINE 00004332 ""
NSQ_SOURCE_LINE 00004333 " csv (filter => sub { $n++; 0 });"
NSQ_SOURCE_LINE 00004334 ""
NSQ_SOURCE_LINE 00004335 "is equal to"
NSQ_SOURCE_LINE 00004336 ""
NSQ_SOURCE_LINE 00004337 " csv (filter => { 0 => sub { $n++; 0 });"
NSQ_SOURCE_LINE 00004338 ""
NSQ_SOURCE_LINE 00004339 "=item filter-name"
NSQ_SOURCE_LINE 00004340 ""
NSQ_SOURCE_LINE 00004341 " csv (in => \"file.csv\", filter => \"not_blank\");"
NSQ_SOURCE_LINE 00004342 " csv (in => \"file.csv\", filter => \"not_empty\");"
NSQ_SOURCE_LINE 00004343 " csv (in => \"file.csv\", filter => \"filled\");"
NSQ_SOURCE_LINE 00004344 ""
NSQ_SOURCE_LINE 00004345 "These are predefined filters"
NSQ_SOURCE_LINE 00004346 ""
NSQ_SOURCE_LINE 00004347 "Given a file like (line numbers prefixed for doc purpose only):"
NSQ_SOURCE_LINE 00004348 ""
NSQ_SOURCE_LINE 00004349 " 1:1,2,3"
NSQ_SOURCE_LINE 00004350 " 2:"
NSQ_SOURCE_LINE 00004351 " 3:,"
NSQ_SOURCE_LINE 00004352 " 4:\"\""
NSQ_SOURCE_LINE 00004353 " 5:,,"
NSQ_SOURCE_LINE 00004354 " 6:, ,"
NSQ_SOURCE_LINE 00004355 " 7:\"\","
NSQ_SOURCE_LINE 00004356 " 8:\" \""
NSQ_SOURCE_LINE 00004357 " 9:4,5,6"
NSQ_SOURCE_LINE 00004358 ""
NSQ_SOURCE_LINE 00004359 "=over 2"
NSQ_SOURCE_LINE 00004360 ""
NSQ_SOURCE_LINE 00004361 "=item not_blank"
NSQ_SOURCE_LINE 00004362 ""
NSQ_SOURCE_LINE 00004363 "Filter out the blank lines"
NSQ_SOURCE_LINE 00004364 ""
NSQ_SOURCE_LINE 00004365 "This filter is a shortcut for"
NSQ_SOURCE_LINE 00004366 ""
NSQ_SOURCE_LINE 00004367 " filter => { 0 => sub { @{$_[1]} > 1 or"
NSQ_SOURCE_LINE 00004368 "             defined $_[1][0] && $_[1][0] ne \"\" } }"
NSQ_SOURCE_LINE 00004369 ""
NSQ_SOURCE_LINE 00004370 "Due to the implementation,  it is currently impossible to also filter lines"
NSQ_SOURCE_LINE 00004371 "that consists only of a quoted empty field. These lines are also considered"
NSQ_SOURCE_LINE 00004372 "blank lines."
NSQ_SOURCE_LINE 00004373 ""
NSQ_SOURCE_LINE 00004374 "With the given example, lines 2 and 4 will be skipped."
NSQ_SOURCE_LINE 00004375 ""
NSQ_SOURCE_LINE 00004376 "=item not_empty"
NSQ_SOURCE_LINE 00004377 ""
NSQ_SOURCE_LINE 00004378 "Filter out lines where all the fields are empty."
NSQ_SOURCE_LINE 00004379 ""
NSQ_SOURCE_LINE 00004380 "This filter is a shortcut for"
NSQ_SOURCE_LINE 00004381 ""
NSQ_SOURCE_LINE 00004382 " filter => { 0 => sub { grep { defined && $_ ne \"\" } @{$_[1]} } }"
NSQ_SOURCE_LINE 00004383 ""
NSQ_SOURCE_LINE 00004384 "A space is not regarded being empty, so given the example data, lines 2, 3,"
NSQ_SOURCE_LINE 00004385 "4, 5, and 7 are skipped."
NSQ_SOURCE_LINE 00004386 ""
NSQ_SOURCE_LINE 00004387 "=item filled"
NSQ_SOURCE_LINE 00004388 ""
NSQ_SOURCE_LINE 00004389 "Filter out lines that have no visible data"
NSQ_SOURCE_LINE 00004390 ""
NSQ_SOURCE_LINE 00004391 "This filter is a shortcut for"
NSQ_SOURCE_LINE 00004392 ""
NSQ_SOURCE_LINE 00004393 " filter => { 0 => sub { grep { defined && m/\\S/ } @{$_[1]} } }"
NSQ_SOURCE_LINE 00004394 ""
NSQ_SOURCE_LINE 00004395 "This filter rejects all lines that I<not> have at least one field that does"
NSQ_SOURCE_LINE 00004396 "not evaluate to the empty string."
NSQ_SOURCE_LINE 00004397 ""
NSQ_SOURCE_LINE 00004398 "With the given example data, this filter would skip lines 2 through 8."
NSQ_SOURCE_LINE 00004399 ""
NSQ_SOURCE_LINE 00004400 "=back"
NSQ_SOURCE_LINE 00004401 ""
NSQ_SOURCE_LINE 00004402 "=back"
NSQ_SOURCE_LINE 00004403 ""
NSQ_SOURCE_LINE 00004404 "One could also use modules like L<Types::Standard>:"
NSQ_SOURCE_LINE 00004405 ""
NSQ_SOURCE_LINE 00004406 " use Types::Standard -types;"
NSQ_SOURCE_LINE 00004407 ""
NSQ_SOURCE_LINE 00004408 " my $type   = Tuple[Str, Str, Int, Bool, Optional[Num]];"
NSQ_SOURCE_LINE 00004409 " my $check  = $type->compiled_check;"
NSQ_SOURCE_LINE 00004410 ""
NSQ_SOURCE_LINE 00004411 " # filter with compiled check and warnings"
NSQ_SOURCE_LINE 00004412 " my $aoa = csv ("
NSQ_SOURCE_LINE 00004413 "    in     => \\$data,"
NSQ_SOURCE_LINE 00004414 "    filter => {"
NSQ_SOURCE_LINE 00004415 "        0 => sub {"
NSQ_SOURCE_LINE 00004416 "            my $ok = $check->($_[1]) or"
NSQ_SOURCE_LINE 00004417 "                warn $type->get_message ($_[1]), \"\\n\";"
NSQ_SOURCE_LINE 00004418 "            return $ok;"
NSQ_SOURCE_LINE 00004419 "            },"
NSQ_SOURCE_LINE 00004420 "        },"
NSQ_SOURCE_LINE 00004421 "    );"
NSQ_SOURCE_LINE 00004422 ""
NSQ_SOURCE_LINE 00004423 "=item after_in"
NSQ_SOURCE_LINE 00004424 "X<after_in>"
NSQ_SOURCE_LINE 00004425 ""
NSQ_SOURCE_LINE 00004426 "This callback is invoked for each record after all records have been parsed"
NSQ_SOURCE_LINE 00004427 "but before returning the reference to the caller.  The hook is invoked with"
NSQ_SOURCE_LINE 00004428 "two arguments:  the current  C<CSV>  parser object  and a  reference to the"
NSQ_SOURCE_LINE 00004429 "record.   The reference can be a reference to a  HASH  or a reference to an"
NSQ_SOURCE_LINE 00004430 "ARRAY as determined by the arguments."
NSQ_SOURCE_LINE 00004431 ""
NSQ_SOURCE_LINE 00004432 "This callback can also be passed as  an attribute without the  C<callbacks>"
NSQ_SOURCE_LINE 00004433 "wrapper."
NSQ_SOURCE_LINE 00004434 ""
NSQ_SOURCE_LINE 00004435 "=item before_out"
NSQ_SOURCE_LINE 00004436 "X<before_out>"
NSQ_SOURCE_LINE 00004437 ""
NSQ_SOURCE_LINE 00004438 "This callback is invoked for each record before the record is printed.  The"
NSQ_SOURCE_LINE 00004439 "hook is invoked with two arguments:  the current C<CSV> parser object and a"
NSQ_SOURCE_LINE 00004440 "reference to the record.   The reference can be a reference to a  HASH or a"
NSQ_SOURCE_LINE 00004441 "reference to an ARRAY as determined by the arguments."
NSQ_SOURCE_LINE 00004442 ""
NSQ_SOURCE_LINE 00004443 "This callback can also be passed as an attribute  without the  C<callbacks>"
NSQ_SOURCE_LINE 00004444 "wrapper."
NSQ_SOURCE_LINE 00004445 ""
NSQ_SOURCE_LINE 00004446 "This callback makes the row available in C<%_> if the row is a hashref.  In"
NSQ_SOURCE_LINE 00004447 "this case C<%_> is writable and will change the original row."
NSQ_SOURCE_LINE 00004448 ""
NSQ_SOURCE_LINE 00004449 "=item on_in"
NSQ_SOURCE_LINE 00004450 "X<on_in>"
NSQ_SOURCE_LINE 00004451 ""
NSQ_SOURCE_LINE 00004452 "This callback acts exactly as the L</after_in> or the L</before_out> hooks."
NSQ_SOURCE_LINE 00004453 ""
NSQ_SOURCE_LINE 00004454 "This callback can also be passed as an attribute  without the  C<callbacks>"
NSQ_SOURCE_LINE 00004455 "wrapper."
NSQ_SOURCE_LINE 00004456 ""
NSQ_SOURCE_LINE 00004457 "This callback makes the row available in C<%_> if the row is a hashref.  In"
NSQ_SOURCE_LINE 00004458 "this case C<%_> is writable and will change the original row. So e.g. with"
NSQ_SOURCE_LINE 00004459 ""
NSQ_SOURCE_LINE 00004460 "  my $aoh = csv ("
NSQ_SOURCE_LINE 00004461 "      in      => \\\"foo\\n1\\n2\\n\","
NSQ_SOURCE_LINE 00004462 "      headers => \"auto\","
NSQ_SOURCE_LINE 00004463 "      on_in   => sub { $_{bar} = 2; },"
NSQ_SOURCE_LINE 00004464 "      );"
NSQ_SOURCE_LINE 00004465 ""
NSQ_SOURCE_LINE 00004466 "C<$aoh> will be:"
NSQ_SOURCE_LINE 00004467 ""
NSQ_SOURCE_LINE 00004468 "  [ { foo => 1,"
NSQ_SOURCE_LINE 00004469 "      bar => 2,"
NSQ_SOURCE_LINE 00004470 "      }"
NSQ_SOURCE_LINE 00004471 "    { foo => 2,"
NSQ_SOURCE_LINE 00004472 "      bar => 2,"
NSQ_SOURCE_LINE 00004473 "      }"
NSQ_SOURCE_LINE 00004474 "    ]"
NSQ_SOURCE_LINE 00004475 ""
NSQ_SOURCE_LINE 00004476 "=item on_error"
NSQ_SOURCE_LINE 00004477 "X<on_error>"
NSQ_SOURCE_LINE 00004478 ""
NSQ_SOURCE_LINE 00004479 "This callback acts exactly as the L</error> hook."
NSQ_SOURCE_LINE 00004480 ""
NSQ_SOURCE_LINE 00004481 "  my @err;"
NSQ_SOURCE_LINE 00004482 "  my $aoa = csv (in => $fh, on_error => sub { @err = @_ });"
NSQ_SOURCE_LINE 00004483 ""
NSQ_SOURCE_LINE 00004484 "is identical to"
NSQ_SOURCE_LINE 00004485 ""
NSQ_SOURCE_LINE 00004486 "  my $aoa = csv (in => $fh, callbacks => {"
NSQ_SOURCE_LINE 00004487 "      error => sub { @err = @_ },"
NSQ_SOURCE_LINE 00004488 "      });"
NSQ_SOURCE_LINE 00004489 ""
NSQ_SOURCE_LINE 00004490 "It can be used for ignoring errors as well as for just keeping the error in"
NSQ_SOURCE_LINE 00004491 "case of analysis after the C<csv ()> function has returned."
NSQ_SOURCE_LINE 00004492 ""
NSQ_SOURCE_LINE 00004493 " my @err;"
NSQ_SOURCE_LINE 00004494 " my $aoa = csv (in => \"bad.csv, on_error => sub { @err = @_ });"
NSQ_SOURCE_LINE 00004495 " die Text::CSV_XS->error_diag if @err or !$aoa;"
NSQ_SOURCE_LINE 00004496 ""
NSQ_SOURCE_LINE 00004497 "=back"
NSQ_SOURCE_LINE 00004498 ""
NSQ_SOURCE_LINE 00004499 "=head1 INTERNALS"
NSQ_SOURCE_LINE 00004500 ""
NSQ_SOURCE_LINE 00004501 "=over 4"
NSQ_SOURCE_LINE 00004502 ""
NSQ_SOURCE_LINE 00004503 "=item Combine (...)"
NSQ_SOURCE_LINE 00004504 ""
NSQ_SOURCE_LINE 00004505 "=item Parse (...)"
NSQ_SOURCE_LINE 00004506 ""
NSQ_SOURCE_LINE 00004507 "=back"
NSQ_SOURCE_LINE 00004508 ""
NSQ_SOURCE_LINE 00004509 "The arguments to these internal functions are deliberately not described or"
NSQ_SOURCE_LINE 00004510 "documented in order to enable the  module authors make changes it when they"
NSQ_SOURCE_LINE 00004511 "feel the need for it.  Using them is  highly  discouraged  as  the  API may"
NSQ_SOURCE_LINE 00004512 "change in future releases."
NSQ_SOURCE_LINE 00004513 ""
NSQ_SOURCE_LINE 00004514 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00004515 ""
NSQ_SOURCE_LINE 00004516 "=head2 Reading a CSV file line by line:"
NSQ_SOURCE_LINE 00004517 ""
NSQ_SOURCE_LINE 00004518 " my $csv = Text::CSV_XS->new ({ binary => 1, auto_diag => 1 });"
NSQ_SOURCE_LINE 00004519 " open my $fh, \"<\", \"file.csv\" or die \"file.csv: $!\";"
NSQ_SOURCE_LINE 00004520 " while (my $row = $csv->getline ($fh)) {"
NSQ_SOURCE_LINE 00004521 "     # do something with @$row"
NSQ_SOURCE_LINE 00004522 "     }"
NSQ_SOURCE_LINE 00004523 " close $fh or die \"file.csv: $!\";"
NSQ_SOURCE_LINE 00004524 ""
NSQ_SOURCE_LINE 00004525 "or"
NSQ_SOURCE_LINE 00004526 ""
NSQ_SOURCE_LINE 00004527 " my $aoa = csv (in => \"file.csv\", on_in => sub {"
NSQ_SOURCE_LINE 00004528 "     # do something with %_"
NSQ_SOURCE_LINE 00004529 "     });"
NSQ_SOURCE_LINE 00004530 ""
NSQ_SOURCE_LINE 00004531 "=head3 Reading only a single column"
NSQ_SOURCE_LINE 00004532 ""
NSQ_SOURCE_LINE 00004533 " my $csv = Text::CSV_XS->new ({ binary => 1, auto_diag => 1 });"
NSQ_SOURCE_LINE 00004534 " open my $fh, \"<\", \"file.csv\" or die \"file.csv: $!\";"
NSQ_SOURCE_LINE 00004535 " # get only the 4th column"
NSQ_SOURCE_LINE 00004536 " my @column = map { $_->[3] } @{$csv->getline_all ($fh)};"
NSQ_SOURCE_LINE 00004537 " close $fh or die \"file.csv: $!\";"
NSQ_SOURCE_LINE 00004538 ""
NSQ_SOURCE_LINE 00004539 "with L</csv>, you could do"
NSQ_SOURCE_LINE 00004540 ""
NSQ_SOURCE_LINE 00004541 " my @column = map { $_->[0] }"
NSQ_SOURCE_LINE 00004542 "     @{csv (in => \"file.csv\", fragment => \"col=4\")};"
NSQ_SOURCE_LINE 00004543 ""
NSQ_SOURCE_LINE 00004544 "=head2 Parsing CSV strings:"
NSQ_SOURCE_LINE 00004545 ""
NSQ_SOURCE_LINE 00004546 " my $csv = Text::CSV_XS->new ({ keep_meta_info => 1, binary => 1 });"
NSQ_SOURCE_LINE 00004547 ""
NSQ_SOURCE_LINE 00004548 " my $sample_input_string ="
NSQ_SOURCE_LINE 00004549 "     qq{\"I said, \"\"Hi!\"\"\",Yes,\"\",2.34,,\"1.09\",\"\\x{20ac}\",};"
NSQ_SOURCE_LINE 00004550 " if ($csv->parse ($sample_input_string)) {"
NSQ_SOURCE_LINE 00004551 "     my @field = $csv->fields;"
NSQ_SOURCE_LINE 00004552 "     foreach my $col (0 .. $#field) {"
NSQ_SOURCE_LINE 00004553 "         my $quo = $csv->is_quoted ($col) ? $csv->{quote_char} : \"\";"
NSQ_SOURCE_LINE 00004554 "         printf \"%2d: %s%s%s\\n\", $col, $quo, $field[$col], $quo;"
NSQ_SOURCE_LINE 00004555 "         }"
NSQ_SOURCE_LINE 00004556 "     }"
NSQ_SOURCE_LINE 00004557 " else {"
NSQ_SOURCE_LINE 00004558 "     print STDERR \"parse () failed on argument: \","
NSQ_SOURCE_LINE 00004559 "         $csv->error_input, \"\\n\";"
NSQ_SOURCE_LINE 00004560 "     $csv->error_diag ();"
NSQ_SOURCE_LINE 00004561 "     }"
NSQ_SOURCE_LINE 00004562 ""
NSQ_SOURCE_LINE 00004563 "=head3 Parsing CSV from memory"
NSQ_SOURCE_LINE 00004564 ""
NSQ_SOURCE_LINE 00004565 "Given a complete CSV data-set in scalar C<$data>,  generate a list of lists"
NSQ_SOURCE_LINE 00004566 "to represent the rows and fields"
NSQ_SOURCE_LINE 00004567 ""
NSQ_SOURCE_LINE 00004568 " # The data"
NSQ_SOURCE_LINE 00004569 " my $data = join \"\\r\\n\" => map { join \",\" => 0 .. 5 } 0 .. 5;"
NSQ_SOURCE_LINE 00004570 ""
NSQ_SOURCE_LINE 00004571 " # in a loop"
NSQ_SOURCE_LINE 00004572 " my $csv = Text::CSV_XS->new ({ binary => 1, auto_diag => 1 });"
NSQ_SOURCE_LINE 00004573 " open my $fh, \"<\", \\$data;"
NSQ_SOURCE_LINE 00004574 " my @foo;"
NSQ_SOURCE_LINE 00004575 " while (my $row = $csv->getline ($fh)) {"
NSQ_SOURCE_LINE 00004576 "     push @foo, $row;"
NSQ_SOURCE_LINE 00004577 "     }"
NSQ_SOURCE_LINE 00004578 " close $fh;"
NSQ_SOURCE_LINE 00004579 ""
NSQ_SOURCE_LINE 00004580 " # a single call"
NSQ_SOURCE_LINE 00004581 " my $foo = csv (in => \\$data);"
NSQ_SOURCE_LINE 00004582 ""
NSQ_SOURCE_LINE 00004583 "=head2 Printing CSV data"
NSQ_SOURCE_LINE 00004584 ""
NSQ_SOURCE_LINE 00004585 "=head3 The fast way: using L</print>"
NSQ_SOURCE_LINE 00004586 ""
NSQ_SOURCE_LINE 00004587 "An example for creating C<CSV> files using the L</print> method:"
NSQ_SOURCE_LINE 00004588 ""
NSQ_SOURCE_LINE 00004589 " my $csv = Text::CSV_XS->new ({ binary => 1, eol => $/ });"
NSQ_SOURCE_LINE 00004590 " open my $fh, \">\", \"foo.csv\" or die \"foo.csv: $!\";"
NSQ_SOURCE_LINE 00004591 " for (1 .. 10) {"
NSQ_SOURCE_LINE 00004592 "     $csv->print ($fh, [ $_, \"$_\" ]) or $csv->error_diag;"
NSQ_SOURCE_LINE 00004593 "     }"
NSQ_SOURCE_LINE 00004594 " close $fh or die \"$tbl.csv: $!\";"
NSQ_SOURCE_LINE 00004595 ""
NSQ_SOURCE_LINE 00004596 "=head3 The slow way: using L</combine> and L</string>"
NSQ_SOURCE_LINE 00004597 ""
NSQ_SOURCE_LINE 00004598 "or using the slower L</combine> and L</string> methods:"
NSQ_SOURCE_LINE 00004599 ""
NSQ_SOURCE_LINE 00004600 " my $csv = Text::CSV_XS->new;"
NSQ_SOURCE_LINE 00004601 ""
NSQ_SOURCE_LINE 00004602 " open my $csv_fh, \">\", \"hello.csv\" or die \"hello.csv: $!\";"
NSQ_SOURCE_LINE 00004603 ""
NSQ_SOURCE_LINE 00004604 " my @sample_input_fields = ("
NSQ_SOURCE_LINE 00004605 "     'You said, \"Hello!\"',   5.67,"
NSQ_SOURCE_LINE 00004606 "     '\"Surely\"',   '',   '3.14159');"
NSQ_SOURCE_LINE 00004607 " if ($csv->combine (@sample_input_fields)) {"
NSQ_SOURCE_LINE 00004608 "     print $csv_fh $csv->string, \"\\n\";"
NSQ_SOURCE_LINE 00004609 "     }"
NSQ_SOURCE_LINE 00004610 " else {"
NSQ_SOURCE_LINE 00004611 "     print \"combine () failed on argument: \","
NSQ_SOURCE_LINE 00004612 "         $csv->error_input, \"\\n\";"
NSQ_SOURCE_LINE 00004613 "     }"
NSQ_SOURCE_LINE 00004614 " close $csv_fh or die \"hello.csv: $!\";"
NSQ_SOURCE_LINE 00004615 ""
NSQ_SOURCE_LINE 00004616 "=head3 Generating CSV into memory"
NSQ_SOURCE_LINE 00004617 ""
NSQ_SOURCE_LINE 00004618 "Format a data-set (C<@foo>) into a scalar value in memory (C<$data>):"
NSQ_SOURCE_LINE 00004619 ""
NSQ_SOURCE_LINE 00004620 " # The data"
NSQ_SOURCE_LINE 00004621 " my @foo = map { [ 0 .. 5 ] } 0 .. 3;"
NSQ_SOURCE_LINE 00004622 ""
NSQ_SOURCE_LINE 00004623 " # in a loop"
NSQ_SOURCE_LINE 00004624 " my $csv = Text::CSV_XS->new ({ binary => 1, auto_diag => 1, eol => \"\\r\\n\" });"
NSQ_SOURCE_LINE 00004625 " open my $fh, \">\", \\my $data;"
NSQ_SOURCE_LINE 00004626 " $csv->print ($fh, $_) for @foo;"
NSQ_SOURCE_LINE 00004627 " close $fh;"
NSQ_SOURCE_LINE 00004628 ""
NSQ_SOURCE_LINE 00004629 " # a single call"
NSQ_SOURCE_LINE 00004630 " csv (in => \\@foo, out => \\my $data);"
NSQ_SOURCE_LINE 00004631 ""
NSQ_SOURCE_LINE 00004632 "=head2 Rewriting CSV"
NSQ_SOURCE_LINE 00004633 ""
NSQ_SOURCE_LINE 00004634 "=head3 Changing separator"
NSQ_SOURCE_LINE 00004635 ""
NSQ_SOURCE_LINE 00004636 "Rewrite C<CSV> files with C<;> as separator character to well-formed C<CSV>:"
NSQ_SOURCE_LINE 00004637 ""
NSQ_SOURCE_LINE 00004638 " use Text::CSV_XS qw( csv );"
NSQ_SOURCE_LINE 00004639 " csv (in => csv (in => \"bad.csv\", sep_char => \";\"), out => *STDOUT);"
NSQ_SOURCE_LINE 00004640 ""
NSQ_SOURCE_LINE 00004641 "As C<STDOUT> is now default in L</csv>, a one-liner converting a UTF-16 CSV"
NSQ_SOURCE_LINE 00004642 "file with BOM and TAB-separation to valid UTF-8 CSV could be:"
NSQ_SOURCE_LINE 00004643 ""
NSQ_SOURCE_LINE 00004644 " $ perl -C3 -MText::CSV_XS=csv -we\\"
NSQ_SOURCE_LINE 00004645 "    'csv(in=>\"utf16tab.csv\",encoding=>\"utf16\",sep=>\"\\t\")' >utf8.csv"
NSQ_SOURCE_LINE 00004646 ""
NSQ_SOURCE_LINE 00004647 "=head3 Unifying EOL"
NSQ_SOURCE_LINE 00004648 ""
NSQ_SOURCE_LINE 00004649 "Rewrite a CSV file with mixed EOL  and/or inconsistent quotation into a new"
NSQ_SOURCE_LINE 00004650 "CSV file with consistent EOL and quotation. Attributes apply."
NSQ_SOURCE_LINE 00004651 ""
NSQ_SOURCE_LINE 00004652 " use Text::CSV_XS qw( csv );"
NSQ_SOURCE_LINE 00004653 " csv (in => \"file.csv\", out => \"newfile.csv\", quote_space => 1);"
NSQ_SOURCE_LINE 00004654 ""
NSQ_SOURCE_LINE 00004655 "=head2 Dumping database tables to CSV"
NSQ_SOURCE_LINE 00004656 ""
NSQ_SOURCE_LINE 00004657 "Dumping a database table can be simple as this (TIMTOWTDI):"
NSQ_SOURCE_LINE 00004658 ""
NSQ_SOURCE_LINE 00004659 " my $dbh = DBI->connect (...);"
NSQ_SOURCE_LINE 00004660 " my $sql = \"select * from foo\";"
NSQ_SOURCE_LINE 00004661 ""
NSQ_SOURCE_LINE 00004662 " # using your own loop"
NSQ_SOURCE_LINE 00004663 " open my $fh, \">\", \"foo.csv\" or die \"foo.csv: $!\\n\";"
NSQ_SOURCE_LINE 00004664 " my $csv = Text::CSV_XS->new ({ binary => 1, eol => \"\\r\\n\" });"
NSQ_SOURCE_LINE 00004665 " my $sth = $dbh->prepare ($sql); $sth->execute;"
NSQ_SOURCE_LINE 00004666 " $csv->print ($fh, $sth->{NAME_lc});"
NSQ_SOURCE_LINE 00004667 " while (my $row = $sth->fetch) {"
NSQ_SOURCE_LINE 00004668 "     $csv->print ($fh, $row);"
NSQ_SOURCE_LINE 00004669 "     }"
NSQ_SOURCE_LINE 00004670 ""
NSQ_SOURCE_LINE 00004671 " # using the csv function, all in memory"
NSQ_SOURCE_LINE 00004672 " csv (out => \"foo.csv\", in => $dbh->selectall_arrayref ($sql));"
NSQ_SOURCE_LINE 00004673 ""
NSQ_SOURCE_LINE 00004674 " # using the csv function, streaming with callbacks"
NSQ_SOURCE_LINE 00004675 " my $sth = $dbh->prepare ($sql); $sth->execute;"
NSQ_SOURCE_LINE 00004676 " csv (out => \"foo.csv\", in => sub { $sth->fetch            });"
NSQ_SOURCE_LINE 00004677 " csv (out => \"foo.csv\", in => sub { $sth->fetchrow_hashref });"
NSQ_SOURCE_LINE 00004678 ""
NSQ_SOURCE_LINE 00004679 "Note that this does not discriminate between \"empty\" values and NULL-values"
NSQ_SOURCE_LINE 00004680 "from the database,  as both will be the same empty field in CSV.  To enable"
NSQ_SOURCE_LINE 00004681 "distinction between the two, use L<C<quote_empty>|/quote_empty>."
NSQ_SOURCE_LINE 00004682 ""
NSQ_SOURCE_LINE 00004683 " csv (out => \"foo.csv\", in => sub { $sth->fetch }, quote_empty => 1);"
NSQ_SOURCE_LINE 00004684 ""
NSQ_SOURCE_LINE 00004685 "If the database import utility supports special sequences to insert C<NULL>"
NSQ_SOURCE_LINE 00004686 "values into the database,  like MySQL/MariaDB supports C<\\N>,  use a filter"
NSQ_SOURCE_LINE 00004687 "or a map"
NSQ_SOURCE_LINE 00004688 ""
NSQ_SOURCE_LINE 00004689 " csv (out => \"foo.csv\", in => sub { $sth->fetch },"
NSQ_SOURCE_LINE 00004690 "                     on_in => sub { $_ //= \"\\\\N\" for @{$_[1]} });"
NSQ_SOURCE_LINE 00004691 ""
NSQ_SOURCE_LINE 00004692 " while (my $row = $sth->fetch) {"
NSQ_SOURCE_LINE 00004693 "     $csv->print ($fh, [ map { $_ // \"\\\\N\" } @$row ]);"
NSQ_SOURCE_LINE 00004694 "     }"
NSQ_SOURCE_LINE 00004695 ""
NSQ_SOURCE_LINE 00004696 "Note that this will not work as expected when choosing the backslash (C<\\>)"
NSQ_SOURCE_LINE 00004697 "as C<escape_char>, as that will cause the C<\\> to need to be escaped by yet"
NSQ_SOURCE_LINE 00004698 "another C<\\>,  which will cause the field to need quotation and thus ending"
NSQ_SOURCE_LINE 00004699 "up as C<\"\\\\N\"> instead of C<\\N>. See also L<C<undef_str>|/undef_str>."
NSQ_SOURCE_LINE 00004700 ""
NSQ_SOURCE_LINE 00004701 " csv (out => \"foo.csv\", in => sub { $sth->fetch }, undef_str => \"\\\\N\");"
NSQ_SOURCE_LINE 00004702 ""
NSQ_SOURCE_LINE 00004703 "These special sequences are not recognized by  Text::CSV_XS  on parsing the"
NSQ_SOURCE_LINE 00004704 "CSV generated like this, but map and filter are your friends again"
NSQ_SOURCE_LINE 00004705 ""
NSQ_SOURCE_LINE 00004706 " while (my $row = $csv->getline ($fh)) {"
NSQ_SOURCE_LINE 00004707 "     $sth->execute (map { $_ eq \"\\\\N\" ? undef : $_ } @$row);"
NSQ_SOURCE_LINE 00004708 "     }"
NSQ_SOURCE_LINE 00004709 ""
NSQ_SOURCE_LINE 00004710 " csv (in => \"foo.csv\", filter => { 1 => sub {"
NSQ_SOURCE_LINE 00004711 "     $sth->execute (map { $_ eq \"\\\\N\" ? undef : $_ } @{$_[1]}); 0; }});"
NSQ_SOURCE_LINE 00004712 ""
NSQ_SOURCE_LINE 00004713 "=head2 Converting CSV to JSON"
NSQ_SOURCE_LINE 00004714 ""
NSQ_SOURCE_LINE 00004715 " use Text::CSV_XS qw( csv );"
NSQ_SOURCE_LINE 00004716 " use JSON; # or Cpanel::JSON::XS for better performance"
NSQ_SOURCE_LINE 00004717 ""
NSQ_SOURCE_LINE 00004718 " # AoA (no header interpretation)"
NSQ_SOURCE_LINE 00004719 " say encode_json (csv (in => \"file.csv\"));"
NSQ_SOURCE_LINE 00004720 ""
NSQ_SOURCE_LINE 00004721 " # AoH (convert to structures)"
NSQ_SOURCE_LINE 00004722 " say encode_json (csv (in => \"file.csv\", bom => 1));"
NSQ_SOURCE_LINE 00004723 ""
NSQ_SOURCE_LINE 00004724 "Yes, it is that simple."
NSQ_SOURCE_LINE 00004725 ""
NSQ_SOURCE_LINE 00004726 "=head2 The examples folder"
NSQ_SOURCE_LINE 00004727 ""
NSQ_SOURCE_LINE 00004728 "For more extended examples, see the F<examples/> C<1>. sub-directory in the"
NSQ_SOURCE_LINE 00004729 "original distribution or the git repository C<2>."
NSQ_SOURCE_LINE 00004730 ""
NSQ_SOURCE_LINE 00004731 " 1. https://github.com/Tux/Text-CSV_XS/tree/master/examples"
NSQ_SOURCE_LINE 00004732 " 2. https://github.com/Tux/Text-CSV_XS"
NSQ_SOURCE_LINE 00004733 ""
NSQ_SOURCE_LINE 00004734 "The following files can be found there:"
NSQ_SOURCE_LINE 00004735 ""
NSQ_SOURCE_LINE 00004736 "=over 2"
NSQ_SOURCE_LINE 00004737 ""
NSQ_SOURCE_LINE 00004738 "=item parser-xs.pl"
NSQ_SOURCE_LINE 00004739 "X<parser-xs.pl>"
NSQ_SOURCE_LINE 00004740 ""
NSQ_SOURCE_LINE 00004741 "This can be used as a boilerplate to parse invalid C<CSV>  and parse beyond"
NSQ_SOURCE_LINE 00004742 "(expected) errors alternative to using the L</error> callback."
NSQ_SOURCE_LINE 00004743 ""
NSQ_SOURCE_LINE 00004744 " $ perl examples/parser-xs.pl bad.csv >good.csv"
NSQ_SOURCE_LINE 00004745 ""
NSQ_SOURCE_LINE 00004746 "=item csv-check"
NSQ_SOURCE_LINE 00004747 "X<csv-check>"
NSQ_SOURCE_LINE 00004748 ""
NSQ_SOURCE_LINE 00004749 "This is a command-line tool that uses parser-xs.pl  techniques to check the"
NSQ_SOURCE_LINE 00004750 "C<CSV> file and report on its content."
NSQ_SOURCE_LINE 00004751 ""
NSQ_SOURCE_LINE 00004752 " $ csv-check files/utf8.csv"
NSQ_SOURCE_LINE 00004753 " Checked files/utf8.csv  with csv-check 1.9"
NSQ_SOURCE_LINE 00004754 " using Text::CSV_XS 1.32 with perl 5.26.0 and Unicode 9.0.0"
NSQ_SOURCE_LINE 00004755 " OK: rows: 1, columns: 2"
NSQ_SOURCE_LINE 00004756 "     sep = <,>, quo = <\">, bin = <1>, eol = <\"\\n\">"
NSQ_SOURCE_LINE 00004757 ""
NSQ_SOURCE_LINE 00004758 "=item csv-split"
NSQ_SOURCE_LINE 00004759 "X<csv-split>"
NSQ_SOURCE_LINE 00004760 ""
NSQ_SOURCE_LINE 00004761 "This command splits C<CSV> files into smaller files,  keeping (part of) the"
NSQ_SOURCE_LINE 00004762 "header.  Options include maximum number of (data) rows per file and maximum"
NSQ_SOURCE_LINE 00004763 "number of columns per file or a combination of the two."
NSQ_SOURCE_LINE 00004764 ""
NSQ_SOURCE_LINE 00004765 "=item csv2xls"
NSQ_SOURCE_LINE 00004766 "X<csv2xls>"
NSQ_SOURCE_LINE 00004767 ""
NSQ_SOURCE_LINE 00004768 "A script to convert C<CSV> to Microsoft Excel (C<XLS>). This requires extra"
NSQ_SOURCE_LINE 00004769 "modules L<Date::Calc> and L<Spreadsheet::WriteExcel>. The converter accepts"
NSQ_SOURCE_LINE 00004770 "various options and can produce UTF-8 compliant Excel files."
NSQ_SOURCE_LINE 00004771 ""
NSQ_SOURCE_LINE 00004772 "=item csv2xlsx"
NSQ_SOURCE_LINE 00004773 "X<csv2xlsx>"
NSQ_SOURCE_LINE 00004774 ""
NSQ_SOURCE_LINE 00004775 "A script to convert C<CSV> to Microsoft Excel (C<XLSX>).  This requires the"
NSQ_SOURCE_LINE 00004776 "modules L<Date::Calc> and L<Spreadsheet::Writer::XLSX>.  The converter does"
NSQ_SOURCE_LINE 00004777 "accept various options including merging several C<CSV> files into a single"
NSQ_SOURCE_LINE 00004778 "Excel file."
NSQ_SOURCE_LINE 00004779 ""
NSQ_SOURCE_LINE 00004780 "=item csvdiff"
NSQ_SOURCE_LINE 00004781 "X<csvdiff>"
NSQ_SOURCE_LINE 00004782 ""
NSQ_SOURCE_LINE 00004783 "A script that provides colorized diff on sorted CSV files,  assuming  first"
NSQ_SOURCE_LINE 00004784 "line is header and first field is the key. Output options include colorized"
NSQ_SOURCE_LINE 00004785 "ANSI escape codes or HTML."
NSQ_SOURCE_LINE 00004786 ""
NSQ_SOURCE_LINE 00004787 " $ csvdiff --html --output=diff.html file1.csv file2.csv"
NSQ_SOURCE_LINE 00004788 ""
NSQ_SOURCE_LINE 00004789 "=item rewrite.pl"
NSQ_SOURCE_LINE 00004790 "X<rewrite.pl>"
NSQ_SOURCE_LINE 00004791 ""
NSQ_SOURCE_LINE 00004792 "A script to rewrite (in)valid CSV into valid CSV files.  Script has options"
NSQ_SOURCE_LINE 00004793 "to generate confusing CSV files or CSV files that conform to Dutch MS-Excel"
NSQ_SOURCE_LINE 00004794 "exports (using C<;> as separation)."
NSQ_SOURCE_LINE 00004795 ""
NSQ_SOURCE_LINE 00004796 "Script - by default - honors BOM  and auto-detects separation converting it"
NSQ_SOURCE_LINE 00004797 "to default standard CSV with C<,> as separator."
NSQ_SOURCE_LINE 00004798 ""
NSQ_SOURCE_LINE 00004799 "=back"
NSQ_SOURCE_LINE 00004800 ""
NSQ_SOURCE_LINE 00004801 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00004802 ""
NSQ_SOURCE_LINE 00004803 "Text::CSV_XS  is I<not> designed to detect the characters used to quote and"
NSQ_SOURCE_LINE 00004804 "separate fields.  The parsing is done using predefined  (default) settings."
NSQ_SOURCE_LINE 00004805 "In the examples  sub-directory,  you can find scripts  that demonstrate how"
NSQ_SOURCE_LINE 00004806 "you could try to detect these characters yourself."
NSQ_SOURCE_LINE 00004807 ""
NSQ_SOURCE_LINE 00004808 "=head2 Microsoft Excel"
NSQ_SOURCE_LINE 00004809 ""
NSQ_SOURCE_LINE 00004810 "The import/export from Microsoft Excel is a I<risky task>, according to the"
NSQ_SOURCE_LINE 00004811 "documentation in C<Text::CSV::Separator>.  Microsoft uses the system's list"
NSQ_SOURCE_LINE 00004812 "separator defined in the regional settings, which happens to be a semicolon"
NSQ_SOURCE_LINE 00004813 "for Dutch, German and Spanish (and probably some others as well).   For the"
NSQ_SOURCE_LINE 00004814 "English locale,  the default is a comma.   In Windows however,  the user is"
NSQ_SOURCE_LINE 00004815 "free to choose a  predefined locale,  and then change  I<every>  individual"
NSQ_SOURCE_LINE 00004816 "setting in it, so checking the locale is no solution."
NSQ_SOURCE_LINE 00004817 ""
NSQ_SOURCE_LINE 00004818 "As of version 1.17, a lone first line with just"
NSQ_SOURCE_LINE 00004819 ""
NSQ_SOURCE_LINE 00004820 "  sep=;"
NSQ_SOURCE_LINE 00004821 ""
NSQ_SOURCE_LINE 00004822 "will be recognized and honored when parsing with L</getline>."
NSQ_SOURCE_LINE 00004823 ""
NSQ_SOURCE_LINE 00004824 "=head1 TODO"
NSQ_SOURCE_LINE 00004825 ""
NSQ_SOURCE_LINE 00004826 "=over 2"
NSQ_SOURCE_LINE 00004827 ""
NSQ_SOURCE_LINE 00004828 "=item More Errors & Warnings"
NSQ_SOURCE_LINE 00004829 ""
NSQ_SOURCE_LINE 00004830 "New extensions ought to be  clear and concise  in reporting what  error has"
NSQ_SOURCE_LINE 00004831 "occurred where and why, and maybe also offer a remedy to the problem."
NSQ_SOURCE_LINE 00004832 ""
NSQ_SOURCE_LINE 00004833 "L</error_diag> is a (very) good start, but there is more work to be done in"
NSQ_SOURCE_LINE 00004834 "this area."
NSQ_SOURCE_LINE 00004835 ""
NSQ_SOURCE_LINE 00004836 "Basic calls  should croak or warn on  illegal parameters.  Errors should be"
NSQ_SOURCE_LINE 00004837 "documented."
NSQ_SOURCE_LINE 00004838 ""
NSQ_SOURCE_LINE 00004839 "=item setting meta info"
NSQ_SOURCE_LINE 00004840 ""
NSQ_SOURCE_LINE 00004841 "Future extensions might include extending the L</meta_info>, L</is_quoted>,"
NSQ_SOURCE_LINE 00004842 "and  L</is_binary>  to accept setting these  flags for  fields,  so you can"
NSQ_SOURCE_LINE 00004843 "specify which fields are quoted in the L</combine>/L</string> combination."
NSQ_SOURCE_LINE 00004844 ""
NSQ_SOURCE_LINE 00004845 " $csv->meta_info (0, 1, 1, 3, 0, 0);"
NSQ_SOURCE_LINE 00004846 " $csv->is_quoted (3, 1);"
NSQ_SOURCE_LINE 00004847 ""
NSQ_SOURCE_LINE 00004848 "L<Metadata Vocabulary for Tabular Data|http://w3c.github.io/csvw/metadata/>"
NSQ_SOURCE_LINE 00004849 "(a W3C editor's draft) could be an example for supporting more metadata."
NSQ_SOURCE_LINE 00004850 ""
NSQ_SOURCE_LINE 00004851 "=item Parse the whole file at once"
NSQ_SOURCE_LINE 00004852 ""
NSQ_SOURCE_LINE 00004853 "Implement new methods or functions  that enable parsing of a  complete file"
NSQ_SOURCE_LINE 00004854 "at once, returning a list of hashes. Possible extension to this could be to"
NSQ_SOURCE_LINE 00004855 "enable a column selection on the call:"
NSQ_SOURCE_LINE 00004856 ""
NSQ_SOURCE_LINE 00004857 " my @AoH = $csv->parse_file ($filename, { cols => [ 1, 4..8, 12 ]});"
NSQ_SOURCE_LINE 00004858 ""
NSQ_SOURCE_LINE 00004859 "returning something like"
NSQ_SOURCE_LINE 00004860 ""
NSQ_SOURCE_LINE 00004861 " [ { fields => [ 1, 2, \"foo\", 4.5, undef, \"\", 8 ],"
NSQ_SOURCE_LINE 00004862 "     flags  => [ ... ],"
NSQ_SOURCE_LINE 00004863 "     },"
NSQ_SOURCE_LINE 00004864 "   { fields => [ ... ],"
NSQ_SOURCE_LINE 00004865 "     ."
NSQ_SOURCE_LINE 00004866 "     },"
NSQ_SOURCE_LINE 00004867 "   ]"
NSQ_SOURCE_LINE 00004868 ""
NSQ_SOURCE_LINE 00004869 "Note that the L</csv> function already supports most of this,  but does not"
NSQ_SOURCE_LINE 00004870 "return flags. L</getline_all> returns all rows for an open stream, but this"
NSQ_SOURCE_LINE 00004871 "will not return flags either.  L</fragment>  can reduce the  required  rows"
NSQ_SOURCE_LINE 00004872 "I<or> columns, but cannot combine them."
NSQ_SOURCE_LINE 00004873 ""
NSQ_SOURCE_LINE 00004874 "=item provider"
NSQ_SOURCE_LINE 00004875 ""
NSQ_SOURCE_LINE 00004876 " csv (in => $fh) vs csv (provider => sub { get_line });"
NSQ_SOURCE_LINE 00004877 ""
NSQ_SOURCE_LINE 00004878 "Whatever the attribute name might end up to be,  this should make it easier"
NSQ_SOURCE_LINE 00004879 "to add input providers for parsing.   Currently most special variations for"
NSQ_SOURCE_LINE 00004880 "the C<in> attribute are aimed at CSV generation: e.g. a callback is defined"
NSQ_SOURCE_LINE 00004881 "to return a reference to a record. This new attribute should enable passing"
NSQ_SOURCE_LINE 00004882 "data to parse, like getline."
NSQ_SOURCE_LINE 00004883 ""
NSQ_SOURCE_LINE 00004884 "Suggested by Johan Vromans."
NSQ_SOURCE_LINE 00004885 ""
NSQ_SOURCE_LINE 00004886 "=item Cookbook"
NSQ_SOURCE_LINE 00004887 ""
NSQ_SOURCE_LINE 00004888 "Write a document that has recipes for  most known  non-standard  (and maybe"
NSQ_SOURCE_LINE 00004889 "some standard)  C<CSV> formats,  including formats that use  C<TAB>,  C<;>,"
NSQ_SOURCE_LINE 00004890 "C<|>, or other non-comma separators."
NSQ_SOURCE_LINE 00004891 ""
NSQ_SOURCE_LINE 00004892 "Examples could be taken from W3C's L<CSV on the Web: Use Cases and"
NSQ_SOURCE_LINE 00004893 "Requirements|http://w3c.github.io/csvw/use-cases-and-requirements/index.html>"
NSQ_SOURCE_LINE 00004894 ""
NSQ_SOURCE_LINE 00004895 "=item Steal"
NSQ_SOURCE_LINE 00004896 ""
NSQ_SOURCE_LINE 00004897 "Steal good new ideas and features from L<PapaParse|http://papaparse.com> or"
NSQ_SOURCE_LINE 00004898 "L<csvkit|http://csvkit.readthedocs.org>."
NSQ_SOURCE_LINE 00004899 ""
NSQ_SOURCE_LINE 00004900 "=item Raku support"
NSQ_SOURCE_LINE 00004901 ""
NSQ_SOURCE_LINE 00004902 "Raku support can be found L<here|https://github.com/Tux/CSV>. The interface"
NSQ_SOURCE_LINE 00004903 "is richer in support than the Perl5 API, as Raku supports more types."
NSQ_SOURCE_LINE 00004904 ""
NSQ_SOURCE_LINE 00004905 "The Raku version does not (yet) support pure binary CSV datasets."
NSQ_SOURCE_LINE 00004906 ""
NSQ_SOURCE_LINE 00004907 "=back"
NSQ_SOURCE_LINE 00004908 ""
NSQ_SOURCE_LINE 00004909 "=head2 NOT TODO"
NSQ_SOURCE_LINE 00004910 ""
NSQ_SOURCE_LINE 00004911 "=over 2"
NSQ_SOURCE_LINE 00004912 ""
NSQ_SOURCE_LINE 00004913 "=item combined methods"
NSQ_SOURCE_LINE 00004914 ""
NSQ_SOURCE_LINE 00004915 "Requests for adding means (methods) that combine L</combine> and L</string>"
NSQ_SOURCE_LINE 00004916 "in a single call will B<not> be honored (use L</print> instead).   Likewise"
NSQ_SOURCE_LINE 00004917 "for L</parse> and L</fields>  (use L</getline> instead), given the problems"
NSQ_SOURCE_LINE 00004918 "with embedded newlines."
NSQ_SOURCE_LINE 00004919 ""
NSQ_SOURCE_LINE 00004920 "=back"
NSQ_SOURCE_LINE 00004921 ""
NSQ_SOURCE_LINE 00004922 "=head2 Release plan"
NSQ_SOURCE_LINE 00004923 ""
NSQ_SOURCE_LINE 00004924 "No guarantees, but this is what I had in mind some time ago:"
NSQ_SOURCE_LINE 00004925 ""
NSQ_SOURCE_LINE 00004926 "=over 2"
NSQ_SOURCE_LINE 00004927 ""
NSQ_SOURCE_LINE 00004928 "=item *"
NSQ_SOURCE_LINE 00004929 ""
NSQ_SOURCE_LINE 00004930 "DIAGNOSTICS section in pod to *describe* the errors (see below)"
NSQ_SOURCE_LINE 00004931 ""
NSQ_SOURCE_LINE 00004932 "=back"
NSQ_SOURCE_LINE 00004933 ""
NSQ_SOURCE_LINE 00004934 "=head1 EBCDIC"
NSQ_SOURCE_LINE 00004935 ""
NSQ_SOURCE_LINE 00004936 "Everything should now work on native EBCDIC systems.   As the test does not"
NSQ_SOURCE_LINE 00004937 "cover all possible codepoints and L<Encode> does not support C<utf-ebcdic>,"
NSQ_SOURCE_LINE 00004938 "there is no guarantee that all handling of Unicode is done correct."
NSQ_SOURCE_LINE 00004939 ""
NSQ_SOURCE_LINE 00004940 "Opening C<EBCDIC> encoded files on  C<ASCII>+  systems is likely to succeed"
NSQ_SOURCE_LINE 00004941 "using Encode's C<cp37>, C<cp1047>, or C<posix-bc>:"
NSQ_SOURCE_LINE 00004942 ""
NSQ_SOURCE_LINE 00004943 " open my $fh, \"<:encoding(cp1047)\", \"ebcdic_file.csv\" or die \"...\";"
NSQ_SOURCE_LINE 00004944 ""
NSQ_SOURCE_LINE 00004945 "=head1 DIAGNOSTICS"
NSQ_SOURCE_LINE 00004946 ""
NSQ_SOURCE_LINE 00004947 "Still under construction ..."
NSQ_SOURCE_LINE 00004948 ""
NSQ_SOURCE_LINE 00004949 "If an error occurs,  C<< $csv->error_diag >> can be used to get information"
NSQ_SOURCE_LINE 00004950 "on the cause of the failure. Note that for speed reasons the internal value"
NSQ_SOURCE_LINE 00004951 "is never cleared on success,  so using the value returned by L</error_diag>"
NSQ_SOURCE_LINE 00004952 "in normal cases - when no error occurred - may cause unexpected results."
NSQ_SOURCE_LINE 00004953 ""
NSQ_SOURCE_LINE 00004954 "If the constructor failed, the cause can be found using L</error_diag> as a"
NSQ_SOURCE_LINE 00004955 "class method, like C<< Text::CSV_XS->error_diag >>."
NSQ_SOURCE_LINE 00004956 ""
NSQ_SOURCE_LINE 00004957 "The C<< $csv->error_diag >> method is automatically invoked upon error when"
NSQ_SOURCE_LINE 00004958 "the contractor was called with  L<C<auto_diag>|/auto_diag>  set to  C<1> or"
NSQ_SOURCE_LINE 00004959 "C<2>, or when L<autodie> is in effect.  When set to C<1>, this will cause a"
NSQ_SOURCE_LINE 00004960 "C<warn> with the error message,  when set to C<2>, it will C<die>. C<2012 -"
NSQ_SOURCE_LINE 00004961 "EOF> is excluded from L<C<auto_diag>|/auto_diag> reports."
NSQ_SOURCE_LINE 00004962 ""
NSQ_SOURCE_LINE 00004963 "Errors can be (individually) caught using the L</error> callback."
NSQ_SOURCE_LINE 00004964 ""
NSQ_SOURCE_LINE 00004965 "The errors as described below are available. I have tried to make the error"
NSQ_SOURCE_LINE 00004966 "itself explanatory enough, but more descriptions will be added. For most of"
NSQ_SOURCE_LINE 00004967 "these errors, the first three capitals describe the error category:"
NSQ_SOURCE_LINE 00004968 ""
NSQ_SOURCE_LINE 00004969 "=over 2"
NSQ_SOURCE_LINE 00004970 ""
NSQ_SOURCE_LINE 00004971 "=item *"
NSQ_SOURCE_LINE 00004972 "INI"
NSQ_SOURCE_LINE 00004973 ""
NSQ_SOURCE_LINE 00004974 "Initialization error or option conflict."
NSQ_SOURCE_LINE 00004975 ""
NSQ_SOURCE_LINE 00004976 "=item *"
NSQ_SOURCE_LINE 00004977 "ECR"
NSQ_SOURCE_LINE 00004978 ""
NSQ_SOURCE_LINE 00004979 "Carriage-Return related parse error."
NSQ_SOURCE_LINE 00004980 ""
NSQ_SOURCE_LINE 00004981 "=item *"
NSQ_SOURCE_LINE 00004982 "EOF"
NSQ_SOURCE_LINE 00004983 ""
NSQ_SOURCE_LINE 00004984 "End-Of-File related parse error."
NSQ_SOURCE_LINE 00004985 ""
NSQ_SOURCE_LINE 00004986 "=item *"
NSQ_SOURCE_LINE 00004987 "EIQ"
NSQ_SOURCE_LINE 00004988 ""
NSQ_SOURCE_LINE 00004989 "Parse error inside quotation."
NSQ_SOURCE_LINE 00004990 ""
NSQ_SOURCE_LINE 00004991 "=item *"
NSQ_SOURCE_LINE 00004992 "EIF"
NSQ_SOURCE_LINE 00004993 ""
NSQ_SOURCE_LINE 00004994 "Parse error inside field."
NSQ_SOURCE_LINE 00004995 ""
NSQ_SOURCE_LINE 00004996 "=item *"
NSQ_SOURCE_LINE 00004997 "ECB"
NSQ_SOURCE_LINE 00004998 ""
NSQ_SOURCE_LINE 00004999 "Combine error."
NSQ_SOURCE_LINE 00005000 ""
NSQ_SOURCE_LINE 00005001 "=item *"
NSQ_SOURCE_LINE 00005002 "EHR"
NSQ_SOURCE_LINE 00005003 ""
NSQ_SOURCE_LINE 00005004 "HashRef parse related error."
NSQ_SOURCE_LINE 00005005 ""
NSQ_SOURCE_LINE 00005006 "=back"
NSQ_SOURCE_LINE 00005007 ""
NSQ_SOURCE_LINE 00005008 "And below should be the complete list of error codes that can be returned:"
NSQ_SOURCE_LINE 00005009 ""
NSQ_SOURCE_LINE 00005010 "=over 2"
NSQ_SOURCE_LINE 00005011 ""
NSQ_SOURCE_LINE 00005012 "=item *"
NSQ_SOURCE_LINE 00005013 "1001 \"INI - sep_char is equal to quote_char or escape_char\""
NSQ_SOURCE_LINE 00005014 "X<1001>"
NSQ_SOURCE_LINE 00005015 ""
NSQ_SOURCE_LINE 00005016 "The  L<separation character|/sep_char>  cannot be equal to  L<the quotation"
NSQ_SOURCE_LINE 00005017 "character|/quote_char> or to L<the escape character|/escape_char>,  as this"
NSQ_SOURCE_LINE 00005018 "would invalidate all parsing rules."
NSQ_SOURCE_LINE 00005019 ""
NSQ_SOURCE_LINE 00005020 "=item *"
NSQ_SOURCE_LINE 00005021 "1002 \"INI - allow_whitespace with escape_char or quote_char SP or TAB\""
NSQ_SOURCE_LINE 00005022 "X<1002>"
NSQ_SOURCE_LINE 00005023 ""
NSQ_SOURCE_LINE 00005024 "Using the  L<C<allow_whitespace>|/allow_whitespace>  attribute  when either"
NSQ_SOURCE_LINE 00005025 "L<C<quote_char>|/quote_char> or L<C<escape_char>|/escape_char>  is equal to"
NSQ_SOURCE_LINE 00005026 "C<SPACE> or C<TAB> is too ambiguous to allow."
NSQ_SOURCE_LINE 00005027 ""
NSQ_SOURCE_LINE 00005028 "=item *"
NSQ_SOURCE_LINE 00005029 "1003 \"INI - \\r or \\n in main attr not allowed\""
NSQ_SOURCE_LINE 00005030 "X<1003>"
NSQ_SOURCE_LINE 00005031 ""
NSQ_SOURCE_LINE 00005032 "Using default L<C<eol>|/eol> characters in either L<C<sep_char>|/sep_char>,"
NSQ_SOURCE_LINE 00005033 "L<C<quote_char>|/quote_char>,   or  L<C<escape_char>|/escape_char>  is  not"
NSQ_SOURCE_LINE 00005034 "allowed."
NSQ_SOURCE_LINE 00005035 ""
NSQ_SOURCE_LINE 00005036 "=item *"
NSQ_SOURCE_LINE 00005037 "1004 \"INI - callbacks should be undef or a hashref\""
NSQ_SOURCE_LINE 00005038 "X<1004>"
NSQ_SOURCE_LINE 00005039 ""
NSQ_SOURCE_LINE 00005040 "The L<C<callbacks>|/Callbacks>  attribute only allows one to be C<undef> or"
NSQ_SOURCE_LINE 00005041 "a hash reference."
NSQ_SOURCE_LINE 00005042 ""
NSQ_SOURCE_LINE 00005043 "=item *"
NSQ_SOURCE_LINE 00005044 "1005 \"INI - EOL too long\""
NSQ_SOURCE_LINE 00005045 "X<1005>"
NSQ_SOURCE_LINE 00005046 ""
NSQ_SOURCE_LINE 00005047 "The value passed for EOL is exceeding its maximum length (16)."
NSQ_SOURCE_LINE 00005048 ""
NSQ_SOURCE_LINE 00005049 "=item *"
NSQ_SOURCE_LINE 00005050 "1006 \"INI - SEP too long\""
NSQ_SOURCE_LINE 00005051 "X<1006>"
NSQ_SOURCE_LINE 00005052 ""
NSQ_SOURCE_LINE 00005053 "The value passed for SEP is exceeding its maximum length (16)."
NSQ_SOURCE_LINE 00005054 ""
NSQ_SOURCE_LINE 00005055 "=item *"
NSQ_SOURCE_LINE 00005056 "1007 \"INI - QUOTE too long\""
NSQ_SOURCE_LINE 00005057 "X<1007>"
NSQ_SOURCE_LINE 00005058 ""
NSQ_SOURCE_LINE 00005059 "The value passed for QUOTE is exceeding its maximum length (16)."
NSQ_SOURCE_LINE 00005060 ""
NSQ_SOURCE_LINE 00005061 "=item *"
NSQ_SOURCE_LINE 00005062 "1008 \"INI - SEP undefined\""
NSQ_SOURCE_LINE 00005063 "X<1008>"
NSQ_SOURCE_LINE 00005064 ""
NSQ_SOURCE_LINE 00005065 "The value passed for SEP should be defined and not empty."
NSQ_SOURCE_LINE 00005066 ""
NSQ_SOURCE_LINE 00005067 "=item *"
NSQ_SOURCE_LINE 00005068 "1010 \"INI - the header is empty\""
NSQ_SOURCE_LINE 00005069 "X<1010>"
NSQ_SOURCE_LINE 00005070 ""
NSQ_SOURCE_LINE 00005071 "The header line parsed in the L</header> is empty."
NSQ_SOURCE_LINE 00005072 ""
NSQ_SOURCE_LINE 00005073 "=item *"
NSQ_SOURCE_LINE 00005074 "1011 \"INI - the header contains more than one valid separator\""
NSQ_SOURCE_LINE 00005075 "X<1011>"
NSQ_SOURCE_LINE 00005076 ""
NSQ_SOURCE_LINE 00005077 "The header line parsed in the  L</header>  contains more than one  (unique)"
NSQ_SOURCE_LINE 00005078 "separator character out of the allowed set of separators."
NSQ_SOURCE_LINE 00005079 ""
NSQ_SOURCE_LINE 00005080 "=item *"
NSQ_SOURCE_LINE 00005081 "1012 \"INI - the header contains an empty field\""
NSQ_SOURCE_LINE 00005082 "X<1012>"
NSQ_SOURCE_LINE 00005083 ""
NSQ_SOURCE_LINE 00005084 "The header line parsed in the L</header> contains an empty field."
NSQ_SOURCE_LINE 00005085 ""
NSQ_SOURCE_LINE 00005086 "=item *"
NSQ_SOURCE_LINE 00005087 "1013 \"INI - the header contains non-unique fields\""
NSQ_SOURCE_LINE 00005088 "X<1013>"
NSQ_SOURCE_LINE 00005089 ""
NSQ_SOURCE_LINE 00005090 "The header line parsed in the  L</header>  contains at least  two identical"
NSQ_SOURCE_LINE 00005091 "fields."
NSQ_SOURCE_LINE 00005092 ""
NSQ_SOURCE_LINE 00005093 "=item *"
NSQ_SOURCE_LINE 00005094 "1014 \"INI - header called on undefined stream\""
NSQ_SOURCE_LINE 00005095 "X<1014>"
NSQ_SOURCE_LINE 00005096 ""
NSQ_SOURCE_LINE 00005097 "The header line cannot be parsed from an undefined source."
NSQ_SOURCE_LINE 00005098 ""
NSQ_SOURCE_LINE 00005099 "=item *"
NSQ_SOURCE_LINE 00005100 "1500 \"PRM - Invalid/unsupported argument(s)\""
NSQ_SOURCE_LINE 00005101 "X<1500>"
NSQ_SOURCE_LINE 00005102 ""
NSQ_SOURCE_LINE 00005103 "Function or method called with invalid argument(s) or parameter(s)."
NSQ_SOURCE_LINE 00005104 ""
NSQ_SOURCE_LINE 00005105 "=item *"
NSQ_SOURCE_LINE 00005106 "1501 \"PRM - The key attribute is passed as an unsupported type\""
NSQ_SOURCE_LINE 00005107 "X<1501>"
NSQ_SOURCE_LINE 00005108 ""
NSQ_SOURCE_LINE 00005109 "The C<key> attribute is of an unsupported type."
NSQ_SOURCE_LINE 00005110 ""
NSQ_SOURCE_LINE 00005111 "=item *"
NSQ_SOURCE_LINE 00005112 "1502 \"PRM - The value attribute is passed without the key attribute\""
NSQ_SOURCE_LINE 00005113 "X<1502>"
NSQ_SOURCE_LINE 00005114 ""
NSQ_SOURCE_LINE 00005115 "The C<value> attribute is only allowed when a valid key is given."
NSQ_SOURCE_LINE 00005116 ""
NSQ_SOURCE_LINE 00005117 "=item *"
NSQ_SOURCE_LINE 00005118 "1503 \"PRM - The value attribute is passed as an unsupported type\""
NSQ_SOURCE_LINE 00005119 "X<1503>"
NSQ_SOURCE_LINE 00005120 ""
NSQ_SOURCE_LINE 00005121 "The C<value> attribute is of an unsupported type."
NSQ_SOURCE_LINE 00005122 ""
NSQ_SOURCE_LINE 00005123 "=item *"
NSQ_SOURCE_LINE 00005124 "2010 \"ECR - QUO char inside quotes followed by CR not part of EOL\""
NSQ_SOURCE_LINE 00005125 "X<2010>"
NSQ_SOURCE_LINE 00005126 ""
NSQ_SOURCE_LINE 00005127 "When  L<C<eol>|/eol>  has  been  set  to  anything  but the  default,  like"
NSQ_SOURCE_LINE 00005128 "C<\"\\r\\t\\n\">,  and  the  C<\"\\r\">  is  following  the   B<second>   (closing)"
NSQ_SOURCE_LINE 00005129 "L<C<quote_char>|/quote_char>, where the characters following the C<\"\\r\"> do"
NSQ_SOURCE_LINE 00005130 "not make up the L<C<eol>|/eol> sequence, this is an error."
NSQ_SOURCE_LINE 00005131 ""
NSQ_SOURCE_LINE 00005132 "=item *"
NSQ_SOURCE_LINE 00005133 "2011 \"ECR - Characters after end of quoted field\""
NSQ_SOURCE_LINE 00005134 "X<2011>"
NSQ_SOURCE_LINE 00005135 ""
NSQ_SOURCE_LINE 00005136 "Sequences like C<1,foo,\"bar\"baz,22,1> are not allowed. C<\"bar\"> is a quoted"
NSQ_SOURCE_LINE 00005137 "field and after the closing double-quote, there should be either a new-line"
NSQ_SOURCE_LINE 00005138 "sequence or a separation character."
NSQ_SOURCE_LINE 00005139 ""
NSQ_SOURCE_LINE 00005140 "=item *"
NSQ_SOURCE_LINE 00005141 "2012 \"EOF - End of data in parsing input stream\""
NSQ_SOURCE_LINE 00005142 "X<2012>"
NSQ_SOURCE_LINE 00005143 ""
NSQ_SOURCE_LINE 00005144 "Self-explaining. End-of-file while inside parsing a stream. Can happen only"
NSQ_SOURCE_LINE 00005145 "when reading from streams with L</getline>,  as using  L</parse> is done on"
NSQ_SOURCE_LINE 00005146 "strings that are not required to have a trailing L<C<eol>|/eol>."
NSQ_SOURCE_LINE 00005147 ""
NSQ_SOURCE_LINE 00005148 "=item *"
NSQ_SOURCE_LINE 00005149 "2013 \"INI - Specification error for fragments RFC7111\""
NSQ_SOURCE_LINE 00005150 "X<2013>"
NSQ_SOURCE_LINE 00005151 ""
NSQ_SOURCE_LINE 00005152 "Invalid specification for URI L</fragment> specification."
NSQ_SOURCE_LINE 00005153 ""
NSQ_SOURCE_LINE 00005154 "=item *"
NSQ_SOURCE_LINE 00005155 "2014 \"ENF - Inconsistent number of fields\""
NSQ_SOURCE_LINE 00005156 "X<2014>"
NSQ_SOURCE_LINE 00005157 ""
NSQ_SOURCE_LINE 00005158 "Inconsistent number of fields under strict parsing."
NSQ_SOURCE_LINE 00005159 ""
NSQ_SOURCE_LINE 00005160 "=item *"
NSQ_SOURCE_LINE 00005161 "2015 \"ERW - Empty row\""
NSQ_SOURCE_LINE 00005162 "X<2015>"
NSQ_SOURCE_LINE 00005163 ""
NSQ_SOURCE_LINE 00005164 "An empty row was not allowed."
NSQ_SOURCE_LINE 00005165 ""
NSQ_SOURCE_LINE 00005166 "=item *"
NSQ_SOURCE_LINE 00005167 "2016 \"EOL - Inconsistent EOL\""
NSQ_SOURCE_LINE 00005168 "X<2016>"
NSQ_SOURCE_LINE 00005169 ""
NSQ_SOURCE_LINE 00005170 "Inconsistent End-Of-Line detected under strict_eol parsing."
NSQ_SOURCE_LINE 00005171 ""
NSQ_SOURCE_LINE 00005172 "=item *"
NSQ_SOURCE_LINE 00005173 "2021 \"EIQ - NL char inside quotes, binary off\""
NSQ_SOURCE_LINE 00005174 "X<2021>"
NSQ_SOURCE_LINE 00005175 ""
NSQ_SOURCE_LINE 00005176 "Sequences like C<1,\"foo\\nbar\",22,1> are allowed only when the binary option"
NSQ_SOURCE_LINE 00005177 "has been selected with the constructor."
NSQ_SOURCE_LINE 00005178 ""
NSQ_SOURCE_LINE 00005179 "=item *"
NSQ_SOURCE_LINE 00005180 "2022 \"EIQ - CR char inside quotes, binary off\""
NSQ_SOURCE_LINE 00005181 "X<2022>"
NSQ_SOURCE_LINE 00005182 ""
NSQ_SOURCE_LINE 00005183 "Sequences like C<1,\"foo\\rbar\",22,1> are allowed only when the binary option"
NSQ_SOURCE_LINE 00005184 "has been selected with the constructor."
NSQ_SOURCE_LINE 00005185 ""
NSQ_SOURCE_LINE 00005186 "=item *"
NSQ_SOURCE_LINE 00005187 "2023 \"EIQ - QUO character not allowed\""
NSQ_SOURCE_LINE 00005188 "X<2023>"
NSQ_SOURCE_LINE 00005189 ""
NSQ_SOURCE_LINE 00005190 "Sequences like C<\"foo \"bar\" baz\",qu> and C<2023,\",2008-04-05,\"Foo, Bar\",\\n>"
NSQ_SOURCE_LINE 00005191 "will cause this error."
NSQ_SOURCE_LINE 00005192 ""
NSQ_SOURCE_LINE 00005193 "=item *"
NSQ_SOURCE_LINE 00005194 "2024 \"EIQ - EOF cannot be escaped, not even inside quotes\""
NSQ_SOURCE_LINE 00005195 "X<2024>"
NSQ_SOURCE_LINE 00005196 ""
NSQ_SOURCE_LINE 00005197 "The escape character is not allowed as last character in an input stream."
NSQ_SOURCE_LINE 00005198 ""
NSQ_SOURCE_LINE 00005199 "=item *"
NSQ_SOURCE_LINE 00005200 "2025 \"EIQ - Loose unescaped escape\""
NSQ_SOURCE_LINE 00005201 "X<2025>"
NSQ_SOURCE_LINE 00005202 ""
NSQ_SOURCE_LINE 00005203 "An escape character should escape only characters that need escaping."
NSQ_SOURCE_LINE 00005204 ""
NSQ_SOURCE_LINE 00005205 "Allowing  the escape  for other characters  is possible  with the attribute"
NSQ_SOURCE_LINE 00005206 "L</allow_loose_escapes>."
NSQ_SOURCE_LINE 00005207 ""
NSQ_SOURCE_LINE 00005208 "=item *"
NSQ_SOURCE_LINE 00005209 "2026 \"EIQ - Binary character inside quoted field, binary off\""
NSQ_SOURCE_LINE 00005210 "X<2026>"
NSQ_SOURCE_LINE 00005211 ""
NSQ_SOURCE_LINE 00005212 "Binary characters are not allowed by default.    Exceptions are fields that"
NSQ_SOURCE_LINE 00005213 "contain valid UTF-8,  that will automatically be upgraded if the content is"
NSQ_SOURCE_LINE 00005214 "valid UTF-8. Set L<C<binary>|/binary> to C<1> to accept binary data."
NSQ_SOURCE_LINE 00005215 ""
NSQ_SOURCE_LINE 00005216 "=item *"
NSQ_SOURCE_LINE 00005217 "2027 \"EIQ - Quoted field not terminated\""
NSQ_SOURCE_LINE 00005218 "X<2027>"
NSQ_SOURCE_LINE 00005219 ""
NSQ_SOURCE_LINE 00005220 "When parsing a field that started with a quotation character,  the field is"
NSQ_SOURCE_LINE 00005221 "expected to be closed with a quotation character.   When the parsed line is"
NSQ_SOURCE_LINE 00005222 "exhausted before the quote is found, that field is not terminated."
NSQ_SOURCE_LINE 00005223 ""
NSQ_SOURCE_LINE 00005224 "=item *"
NSQ_SOURCE_LINE 00005225 "2030 \"EIF - NL char inside unquoted verbatim, binary off\""
NSQ_SOURCE_LINE 00005226 "X<2030>"
NSQ_SOURCE_LINE 00005227 ""
NSQ_SOURCE_LINE 00005228 "=item *"
NSQ_SOURCE_LINE 00005229 "2031 \"EIF - CR char is first char of field, not part of EOL\""
NSQ_SOURCE_LINE 00005230 "X<2031>"
NSQ_SOURCE_LINE 00005231 ""
NSQ_SOURCE_LINE 00005232 "=item *"
NSQ_SOURCE_LINE 00005233 "2032 \"EIF - CR char inside unquoted, not part of EOL\""
NSQ_SOURCE_LINE 00005234 "X<2032>"
NSQ_SOURCE_LINE 00005235 ""
NSQ_SOURCE_LINE 00005236 "=item *"
NSQ_SOURCE_LINE 00005237 "2034 \"EIF - Loose unescaped quote\""
NSQ_SOURCE_LINE 00005238 "X<2034>"
NSQ_SOURCE_LINE 00005239 ""
NSQ_SOURCE_LINE 00005240 "=item *"
NSQ_SOURCE_LINE 00005241 "2035 \"EIF - Escaped EOF in unquoted field\""
NSQ_SOURCE_LINE 00005242 "X<2035>"
NSQ_SOURCE_LINE 00005243 ""
NSQ_SOURCE_LINE 00005244 "=item *"
NSQ_SOURCE_LINE 00005245 "2036 \"EIF - ESC error\""
NSQ_SOURCE_LINE 00005246 "X<2036>"
NSQ_SOURCE_LINE 00005247 ""
NSQ_SOURCE_LINE 00005248 "=item *"
NSQ_SOURCE_LINE 00005249 "2037 \"EIF - Binary character in unquoted field, binary off\""
NSQ_SOURCE_LINE 00005250 "X<2037>"
NSQ_SOURCE_LINE 00005251 ""
NSQ_SOURCE_LINE 00005252 "=item *"
NSQ_SOURCE_LINE 00005253 "2110 \"ECB - Binary character in Combine, binary off\""
NSQ_SOURCE_LINE 00005254 "X<2110>"
NSQ_SOURCE_LINE 00005255 ""
NSQ_SOURCE_LINE 00005256 "=item *"
NSQ_SOURCE_LINE 00005257 "2200 \"EIO - print to IO failed. See errno\""
NSQ_SOURCE_LINE 00005258 "X<2200>"
NSQ_SOURCE_LINE 00005259 ""
NSQ_SOURCE_LINE 00005260 "=item *"
NSQ_SOURCE_LINE 00005261 "3001 \"EHR - Unsupported syntax for column_names ()\""
NSQ_SOURCE_LINE 00005262 "X<3001>"
NSQ_SOURCE_LINE 00005263 ""
NSQ_SOURCE_LINE 00005264 "=item *"
NSQ_SOURCE_LINE 00005265 "3002 \"EHR - getline_hr () called before column_names ()\""
NSQ_SOURCE_LINE 00005266 "X<3002>"
NSQ_SOURCE_LINE 00005267 ""
NSQ_SOURCE_LINE 00005268 "=item *"
NSQ_SOURCE_LINE 00005269 "3003 \"EHR - bind_columns () and column_names () fields count mismatch\""
NSQ_SOURCE_LINE 00005270 "X<3003>"
NSQ_SOURCE_LINE 00005271 ""
NSQ_SOURCE_LINE 00005272 "=item *"
NSQ_SOURCE_LINE 00005273 "3004 \"EHR - bind_columns () only accepts refs to scalars\""
NSQ_SOURCE_LINE 00005274 "X<3004>"
NSQ_SOURCE_LINE 00005275 ""
NSQ_SOURCE_LINE 00005276 "=item *"
NSQ_SOURCE_LINE 00005277 "3006 \"EHR - bind_columns () did not pass enough refs for parsed fields\""
NSQ_SOURCE_LINE 00005278 "X<3006>"
NSQ_SOURCE_LINE 00005279 ""
NSQ_SOURCE_LINE 00005280 "=item *"
NSQ_SOURCE_LINE 00005281 "3007 \"EHR - bind_columns needs refs to writable scalars\""
NSQ_SOURCE_LINE 00005282 "X<3007>"
NSQ_SOURCE_LINE 00005283 ""
NSQ_SOURCE_LINE 00005284 "=item *"
NSQ_SOURCE_LINE 00005285 "3008 \"EHR - unexpected error in bound fields\""
NSQ_SOURCE_LINE 00005286 "X<3008>"
NSQ_SOURCE_LINE 00005287 ""
NSQ_SOURCE_LINE 00005288 "=item *"
NSQ_SOURCE_LINE 00005289 "3009 \"EHR - print_hr () called before column_names ()\""
NSQ_SOURCE_LINE 00005290 "X<3009>"
NSQ_SOURCE_LINE 00005291 ""
NSQ_SOURCE_LINE 00005292 "=item *"
NSQ_SOURCE_LINE 00005293 "3010 \"EHR - print_hr () called with invalid arguments\""
NSQ_SOURCE_LINE 00005294 "X<3010>"
NSQ_SOURCE_LINE 00005295 ""
NSQ_SOURCE_LINE 00005296 "=back"
NSQ_SOURCE_LINE 00005297 ""
NSQ_SOURCE_LINE 00005298 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00005299 ""
NSQ_SOURCE_LINE 00005300 "L<IO::File>,  L<IO::Handle>,  L<IO::Wrap>,  L<Text::CSV>,  L<Text::CSV_PP>,"
NSQ_SOURCE_LINE 00005301 "L<Text::CSV::Encoded>,     L<Text::CSV::Separator>,    L<Text::CSV::Slurp>,"
NSQ_SOURCE_LINE 00005302 "L<Spreadsheet::CSV> and L<Spreadsheet::Read>, and of course L<perl>."
NSQ_SOURCE_LINE 00005303 ""
NSQ_SOURCE_LINE 00005304 "If you are using Raku,  have a look at C<Text::CSV> in the  Raku ecosystem,"
NSQ_SOURCE_LINE 00005305 "offering the same features."
NSQ_SOURCE_LINE 00005306 ""
NSQ_SOURCE_LINE 00005307 "A beautiful L<Love Letter|https://github.com/medialab/xan/blob/master/docs/LOVE_LETTER.md>"
NSQ_SOURCE_LINE 00005308 "to C<CSV> by the developers of L<xan|https://github.com/medialab/xan#readme>."
NSQ_SOURCE_LINE 00005309 ""
NSQ_SOURCE_LINE 00005310 "=head3 non-perl"
NSQ_SOURCE_LINE 00005311 ""
NSQ_SOURCE_LINE 00005312 "A CSV parser in JavaScript,  also used by L<W3C|http://www.w3.org>,  is the"
NSQ_SOURCE_LINE 00005313 "multi-threaded in-browser L<PapaParse|http://papaparse.com/>."
NSQ_SOURCE_LINE 00005314 ""
NSQ_SOURCE_LINE 00005315 "L<csvkit|http://csvkit.readthedocs.org> is a python CSV parsing toolkit."
NSQ_SOURCE_LINE 00005316 ""
NSQ_SOURCE_LINE 00005317 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00005318 ""
NSQ_SOURCE_LINE 00005319 "Alan Citterman F<E<lt>alan@mfgrtl.comE<gt>> wrote the original Perl module."
NSQ_SOURCE_LINE 00005320 "Please don't send mail concerning Text::CSV_XS to Alan, who is not involved"
NSQ_SOURCE_LINE 00005321 "in the C/XS part that is now the main part of the module."
NSQ_SOURCE_LINE 00005322 ""
NSQ_SOURCE_LINE 00005323 "Jochen Wiedmann F<E<lt>joe@ispsoft.deE<gt>> rewrote the en- and decoding in"
NSQ_SOURCE_LINE 00005324 "C by implementing a simple finite-state machine.   He added variable quote,"
NSQ_SOURCE_LINE 00005325 "escape and separator characters, the binary mode and the print and getline"
NSQ_SOURCE_LINE 00005326 "methods. See F<ChangeLog> releases 0.10 through 0.23."
NSQ_SOURCE_LINE 00005327 ""
NSQ_SOURCE_LINE 00005328 "H.Merijn Brand F<E<lt>hmbrand@cpan.orgE<gt>> cleaned up the code,  added"
NSQ_SOURCE_LINE 00005329 "the field flags methods,  wrote the major part of the test suite, completed"
NSQ_SOURCE_LINE 00005330 "the documentation,   fixed most RT bugs,  added all the allow flags and the"
NSQ_SOURCE_LINE 00005331 "L</csv> function. See ChangeLog releases 0.25 and on."
NSQ_SOURCE_LINE 00005332 ""
