BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "use 5.008001;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "package Test::FailWarnings;"
NSQ_SOURCE_LINE 00000006 "# ABSTRACT: Add test failures if warnings are caught"
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.008'; # VERSION"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Test::More 0.86;"
NSQ_SOURCE_LINE 00000010 "use Cwd qw/getcwd/;"
NSQ_SOURCE_LINE 00000011 "use File::Spec;"
NSQ_SOURCE_LINE 00000012 "use Carp;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our $ALLOW_DEPS = 0;"
NSQ_SOURCE_LINE 00000015 "our @ALLOW_FROM = ();"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "my $ORIG_DIR = getcwd(); # cache in case handler runs after a chdir"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "sub import {"
NSQ_SOURCE_LINE 00000020 "    my ( $class, @args ) = @_;"
NSQ_SOURCE_LINE 00000021 "    croak(\"import arguments must be key/value pairs\")"
NSQ_SOURCE_LINE 00000022 "      unless @args % 2 == 0;"
NSQ_SOURCE_LINE 00000023 "    my %opts = @args;"
NSQ_SOURCE_LINE 00000024 "    $ALLOW_DEPS = $opts{'-allow_deps'};"
NSQ_SOURCE_LINE 00000025 "    if ( $opts{'-allow_from'} ) {"
NSQ_SOURCE_LINE 00000026 "        @ALLOW_FROM ="
NSQ_SOURCE_LINE 00000027 "          ref $opts{'-allow_from'} ? @{ $opts{'-allow_from'} } : $opts{'-allow_from'};"
NSQ_SOURCE_LINE 00000028 "    }"
NSQ_SOURCE_LINE 00000029 "    $SIG{__WARN__} = \\&handler;"
NSQ_SOURCE_LINE 00000030 "}"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub handler {"
NSQ_SOURCE_LINE 00000033 "    my $msg = shift;"
NSQ_SOURCE_LINE 00000034 "    $msg = '' unless defined $msg;"
NSQ_SOURCE_LINE 00000035 "    chomp $msg;"
NSQ_SOURCE_LINE 00000036 "    my ( $package, $filename, $line ) = _find_source();"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    # shortcut if ignoring dependencies and warning did not"
NSQ_SOURCE_LINE 00000039 "    # come from something local"
NSQ_SOURCE_LINE 00000040 "    if ($ALLOW_DEPS) {"
NSQ_SOURCE_LINE 00000041 "        $filename = File::Spec->abs2rel( $filename, $ORIG_DIR )"
NSQ_SOURCE_LINE 00000042 "          if File::Spec->file_name_is_absolute($filename);"
NSQ_SOURCE_LINE 00000043 "        return if $filename !~ /^(?:t|xt|lib|blib)/;"
NSQ_SOURCE_LINE 00000044 "    }"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    return if grep { $package eq $_ } @ALLOW_FROM;"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "    if ( $msg !~ m/at .*? line \\d/ ) {"
NSQ_SOURCE_LINE 00000049 "        chomp $msg;"
NSQ_SOURCE_LINE 00000050 "        $msg = \"'$msg' at $filename line $line.\";"
NSQ_SOURCE_LINE 00000051 "    }"
NSQ_SOURCE_LINE 00000052 "    else {"
NSQ_SOURCE_LINE 00000053 "        $msg = \"'$msg'\";"
NSQ_SOURCE_LINE 00000054 "    }"
NSQ_SOURCE_LINE 00000055 "    my $builder = Test::More->builder;"
NSQ_SOURCE_LINE 00000056 "    $builder->ok( 0, \"Test::FailWarnings should catch no warnings\" )"
NSQ_SOURCE_LINE 00000057 "      or $builder->diag(\"Warning was $msg\");"
NSQ_SOURCE_LINE 00000058 "}"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub _find_source {"
NSQ_SOURCE_LINE 00000061 "    my $i = 1;"
NSQ_SOURCE_LINE 00000062 "    while (1) {"
NSQ_SOURCE_LINE 00000063 "        my ( $pkg, $filename, $line ) = caller( $i++ );"
NSQ_SOURCE_LINE 00000064 "        return caller( $i - 2 ) unless defined $pkg;"
NSQ_SOURCE_LINE 00000065 "        next if $pkg =~ /^(?:Carp|warnings)/;"
NSQ_SOURCE_LINE 00000066 "        return ( $pkg, $filename, $line );"
NSQ_SOURCE_LINE 00000067 "    }"
NSQ_SOURCE_LINE 00000068 "}"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "1;"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "# vim: ts=4 sts=4 sw=4 et:"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "__END__"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "=pod"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=encoding utf-8"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "=head1 NAME"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "Test::FailWarnings - Add test failures if warnings are caught"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "=head1 VERSION"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "version 0.008"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "Test file:"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    use strict;"
NSQ_SOURCE_LINE 00000094 "    use warnings;"
NSQ_SOURCE_LINE 00000095 "    use Test::More;"
NSQ_SOURCE_LINE 00000096 "    use Test::FailWarnings;"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    ok( 1, \"first test\" );"
NSQ_SOURCE_LINE 00000099 "    ok( 1 + \"lkadjaks\", \"add non-numeric\" );"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    done_testing;"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "Output:"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    ok 1 - first test"
NSQ_SOURCE_LINE 00000106 "    not ok 2 - Test::FailWarnings should catch no warnings"
NSQ_SOURCE_LINE 00000107 "    #   Failed test 'Test::FailWarnings should catch no warnings'"
NSQ_SOURCE_LINE 00000108 "    #   at t/bin/main-warn.pl line 7."
NSQ_SOURCE_LINE 00000109 "    # Warning was 'Argument \"lkadjaks\" isn't numeric in addition (+) at t/bin/main-warn.pl line 7.'"
NSQ_SOURCE_LINE 00000110 "    ok 3 - add non-numeric"
NSQ_SOURCE_LINE 00000111 "    1..3"
NSQ_SOURCE_LINE 00000112 "    # Looks like you failed 1 test of 3."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "This module hooks C<$SIG{__WARN__}> and converts warnings to L<Test::More>"
NSQ_SOURCE_LINE 00000117 "C<fail()> calls.  It is designed to be used with C<done_testing>, when you"
NSQ_SOURCE_LINE 00000118 "don't need to know the test count in advance."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "Just as with L<Test::NoWarnings>, this does not catch warnings if other things"
NSQ_SOURCE_LINE 00000121 "localize C<$SIG{__WARN__}>, as this is designed to catch I<unhandled> warnings."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=for Pod::Coverage handler"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 USAGE"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "=head2 Overriding C<$SIG{__WARN__}>"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "On C<import>, C<$SIG{__WARN__}> is replaced with"
NSQ_SOURCE_LINE 00000130 "C<Test::FailWarnings::handler>."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    use Test::FailWarnings;  # global"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "If you don't want global replacement, require the module instead and localize"
NSQ_SOURCE_LINE 00000135 "in whatever scope you want."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "    require Test::FailWarnings;"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    {"
NSQ_SOURCE_LINE 00000140 "        local $SIG{__WARN__} = \\&Test::FailWarnings::handler;"
NSQ_SOURCE_LINE 00000141 "        # ... warnings will issue fail() here"
NSQ_SOURCE_LINE 00000142 "    }"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "When the handler reports on the source of the warning, it will look past"
NSQ_SOURCE_LINE 00000145 "any calling packages starting with C<Carp> or C<warnings> to try to detect"
NSQ_SOURCE_LINE 00000146 "the real origin of the warning."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "=head2 Allowing warnings from dependencies"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "If you want to ignore failures from outside your own code, you can set"
NSQ_SOURCE_LINE 00000151 "C<$Test::FailWarnings::ALLOW_DEPS> to a true value.  You can"
NSQ_SOURCE_LINE 00000152 "do that on the C<use> line with C<< -allow_deps >>."
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    use Test::FailWarnings -allow_deps => 1;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "When true, warnings will only be thrown if they appear to originate from a filename"
NSQ_SOURCE_LINE 00000157 "matching C<< qr/^(?:t|xt|lib|blib)/ >>"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=head2 Allowing warnings from specific modules"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "If you want to white-list specific modules only, you can add their package"
NSQ_SOURCE_LINE 00000162 "names to C<@Test::NoWarnings::ALLOW_FROM>.  You can do that on the C<use> line"
NSQ_SOURCE_LINE 00000163 "with C<< -allow_from >>."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "    use Test::FailWarnings -allow_from => [ qw/Annoying::Module/ ];"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=over 4"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "=item *"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "L<Test::NoWarnings> -- catches warnings and reports in an C<END> block.  Not (yet) friendly with C<done_testing>."
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=item *"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "L<Test::Warnings> -- a replacement for Test::NoWarnings that works with done_testing"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=item *"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "L<Test::Warn> -- test for warnings without triggering failures from this modules"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=back"
NSQ_SOURCE_LINE 00000184 ""
