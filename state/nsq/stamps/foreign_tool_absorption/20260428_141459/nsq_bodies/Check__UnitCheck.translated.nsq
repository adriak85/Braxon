NSQ_SOURCE_LINE 00000001 "package Check::UnitCheck;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "require DynaLoader;"
NSQ_SOURCE_LINE 00000007 "use AutoLoader;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our @ISA = qw(DynaLoader);"
NSQ_SOURCE_LINE 00000010 "our $VERSION = '0.13';"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "bootstrap Check::UnitCheck $VERSION;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub import {"
NSQ_SOURCE_LINE 00000015 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000016 "    foreach my $sr (@_) {"
NSQ_SOURCE_LINE 00000017 "\t_explode(\"$pkg: need a subref\")"
NSQ_SOURCE_LINE 00000018 "\t    if ref($sr) ne 'CODE';"
NSQ_SOURCE_LINE 00000019 "    }"
NSQ_SOURCE_LINE 00000020 "    foreach my $sr (@_) {"
NSQ_SOURCE_LINE 00000021 "\tunitcheckify($sr);"
NSQ_SOURCE_LINE 00000022 "    }"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub _explode {"
NSQ_SOURCE_LINE 00000026 "    require Carp;"
NSQ_SOURCE_LINE 00000027 "    Carp::croak(shift);"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 "1;"
NSQ_SOURCE_LINE 00000030 "__END__"
NSQ_SOURCE_LINE 00000031 "# Below is stub documentation for your module. You better edit it!"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=head1 NAME"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "Check::UnitCheck - Use best of CHECK or UNITCHECK"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "  use Check::UnitCheck sub { ... };"
NSQ_SOURCE_LINE 00000040 "  # runs sub at best of UNITCHECK or global CHECK, depending"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "Perl 5.10.0 will include the UNITCHECK block.  This block runs the"
NSQ_SOURCE_LINE 00000045 "moment the compilation unit in which it was defined has finished"
NSQ_SOURCE_LINE 00000046 "compiling.  Perl versions before that had only the CHECK block, which"
NSQ_SOURCE_LINE 00000047 "runs once global compilation has completed, which might or might not"
NSQ_SOURCE_LINE 00000048 "be at the same time that the compilation unit which defines it has"
NSQ_SOURCE_LINE 00000049 "finished."
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "This module allows you to define a block which will run as a UNITCHECK"
NSQ_SOURCE_LINE 00000052 "block in Perls that allow that, or as a CHECK block in Perls that do"
NSQ_SOURCE_LINE 00000053 "not.  This should allow you to use UNITCHECK semantics in a CPAN"
NSQ_SOURCE_LINE 00000054 "module, while having a moderately graceful fallback for versions of"
NSQ_SOURCE_LINE 00000055 "perl that cannot support that."
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "Instead of writing:"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 " CHECK {"
NSQ_SOURCE_LINE 00000060 "   ... code ..."
NSQ_SOURCE_LINE 00000061 " }"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "or"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 " UNITCHECK {"
NSQ_SOURCE_LINE 00000066 "   ... code ..."
NSQ_SOURCE_LINE 00000067 " }"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "You instead say:"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 " use Check::UnitCheck sub {"
NSQ_SOURCE_LINE 00000072 "   ... code ..."
NSQ_SOURCE_LINE 00000073 " };"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "At the moment you can only do one sub at once (you can C<use> the"
NSQ_SOURCE_LINE 00000076 "module more than once, though).  In the future extra options might be"
NSQ_SOURCE_LINE 00000077 "provided to allow you to inject these blocks into other modules."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "If you want to push a UNITCHECK block into the queue of a compilation"
NSQ_SOURCE_LINE 00000080 "unit that has imported you, then you can do so by calling:"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 " Check::UnitCheck::unitcheckify(sub {...});"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "directly."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "As code passed into the UNITCHECK or CHECK queue is marked as CvSPECIAL"
NSQ_SOURCE_LINE 00000087 "it is probably unwise to use references to named subroutines."
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=head2 EXPORT"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "None."
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=head1 BUGS"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "perl 5.10 isn't actually available yet, and might not contain"
NSQ_SOURCE_LINE 00000096 "UNITCHECK blocks.  I'll release a version 0.20 of this module once"
NSQ_SOURCE_LINE 00000097 "5.10 exists and this works with it.  Until then, you can use this as a"
NSQ_SOURCE_LINE 00000098 "very complicated way of writing CHECK blocks."
NSQ_SOURCE_LINE 00000099 ""
