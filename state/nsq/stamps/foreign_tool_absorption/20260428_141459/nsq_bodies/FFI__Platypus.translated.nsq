NSQ_SOURCE_LINE 00000288 "sub function"
NSQ_SOURCE_LINE 00000289 "{"
NSQ_SOURCE_LINE 00000290 "  my $wrapper;"
NSQ_SOURCE_LINE 00000291 "  $wrapper = pop if ref $_[-1] eq 'CODE';"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "  croak \"usage \\$ffi->function( \\$name, \\\\\\@arguments, [\\\\\\@var_args], [\\$return_type])\" unless @_ >= 3 && @_ <= 6;"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "  my $self = shift;"
NSQ_SOURCE_LINE 00000296 "  my $name = shift;"
NSQ_SOURCE_LINE 00000297 "  my $fixed_args = shift;"
NSQ_SOURCE_LINE 00000298 "  my $var_args;"
NSQ_SOURCE_LINE 00000299 "  $var_args = shift if defined $_[0] && ref($_[0]) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000300 "  my $ret = shift;"
NSQ_SOURCE_LINE 00000301 "  $ret = 'void' unless defined $ret;"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "  # special case: treat a single void argument type as an empty list of"
NSQ_SOURCE_LINE 00000304 "  # arguments, a la olde timey C compilers."
NSQ_SOURCE_LINE 00000305 "  if( (!defined $var_args) && @$fixed_args == 1 && $fixed_args->[0] eq 'void' )"
NSQ_SOURCE_LINE 00000306 "  {"
NSQ_SOURCE_LINE 00000307 "    $fixed_args = [];"
NSQ_SOURCE_LINE 00000308 "  }"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "  my $fixed_arg_count = defined $var_args ? scalar(@$fixed_args) : -1;"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "  my @args = map { $self->{tp}->parse($_) || croak \"unknown type: $_\" } @$fixed_args;"
NSQ_SOURCE_LINE 00000313 "  if($var_args)"
NSQ_SOURCE_LINE 00000314 "  {"
NSQ_SOURCE_LINE 00000315 "    push @args, map {"
NSQ_SOURCE_LINE 00000316 "      my $type = $self->{tp}->parse($_);"
NSQ_SOURCE_LINE 00000317 "      # https://github.com/PerlFFI/FFI-Platypus/issues/323"
NSQ_SOURCE_LINE 00000318 "      $type->type_code == 67 ? $self->{tp}->parse('double') : $type"
NSQ_SOURCE_LINE 00000319 "    } @$var_args;"
NSQ_SOURCE_LINE 00000320 "  }"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "  $ret = $self->{tp}->parse($ret) || croak \"unknown type: $ret\";"
NSQ_SOURCE_LINE 00000323 "  my $address = $name =~ /^-?[0-9]+$/ ? $name : $self->find_symbol($name);"
NSQ_SOURCE_LINE 00000324 "  croak \"unable to find $name\" unless defined $address || $self->ignore_not_found;"
NSQ_SOURCE_LINE 00000325 "  return unless defined $address;"
NSQ_SOURCE_LINE 00000326 "  $address = @args > 0 ? _cast1() : _cast0() if $address == 0;"
NSQ_SOURCE_LINE 00000327 "  my $function = FFI::Platypus::Function::Function->new($self, $address, $self->{abi}, $fixed_arg_count, $ret, @args);"
NSQ_SOURCE_LINE 00000328 "  $wrapper"
NSQ_SOURCE_LINE 00000329 "    ? FFI::Platypus::Function::Wrapper->new($function, $wrapper)"
NSQ_SOURCE_LINE 00000330 "    : $function;"
NSQ_SOURCE_LINE 00000331 "}"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "sub _function_meta"
NSQ_SOURCE_LINE 00000334 "{"
NSQ_SOURCE_LINE 00000335 "  # NOTE: may be upgraded to a documented function one day,"
NSQ_SOURCE_LINE 00000336 "  # but shouldn't be used externally as we will rename it"
NSQ_SOURCE_LINE 00000337 "  # if that happens."
NSQ_SOURCE_LINE 00000338 "  my($self, $name, $meta, $args, $ret) = @_;"
NSQ_SOURCE_LINE 00000339 "  $args = ['opaque','int',@$args];"
NSQ_SOURCE_LINE 00000340 "  $self->function("
NSQ_SOURCE_LINE 00000341 "    $name, $args, $ret, sub {"
NSQ_SOURCE_LINE 00000342 "      my $xsub = shift;"
NSQ_SOURCE_LINE 00000343 "      $xsub->($meta, scalar(@_), @_);"
NSQ_SOURCE_LINE 00000344 "    },"
NSQ_SOURCE_LINE 00000345 "  );"
NSQ_SOURCE_LINE 00000346 "}"
