NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "# ABSTRACT: Write Perl bindings to non-Perl libraries with FFI. No XS required."
NSQ_SOURCE_LINE 00000011 "our $VERSION = '2.11'; # VERSION"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "# Platypus-Man,"
NSQ_SOURCE_LINE 00000014 "# Platypus-Man,"
NSQ_SOURCE_LINE 00000015 "# Does Whatever A Platypus Can"
NSQ_SOURCE_LINE 00000016 "# Is Mildly Venomous"
NSQ_SOURCE_LINE 00000017 "# Hangs Out In Rivers By Caves"
NSQ_SOURCE_LINE 00000018 "# Look Out!"
NSQ_SOURCE_LINE 00000019 "# Here Comes The Platypus-Man"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "# From the original FFI::Platypus prototype:"
NSQ_SOURCE_LINE 00000022 "#  Kinda like gluing a duckbill to an adorable mammal"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "our @CARP_NOT = qw( FFI::Platypus::Declare FFI::Platypus::Record );"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "require XSLoader;"
NSQ_SOURCE_LINE 00000028 "XSLoader::load("
NSQ_SOURCE_LINE 00000029 "  'FFI::Platypus', $FFI::Platypus::VERSION || 0"
NSQ_SOURCE_LINE 00000030 ");"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "sub new"
NSQ_SOURCE_LINE 00000034 "{"
NSQ_SOURCE_LINE 00000035 "  my($class, %args) = @_;"
NSQ_SOURCE_LINE 00000036 "  my @lib;"
NSQ_SOURCE_LINE 00000037 "  if(exists $args{lib})"
NSQ_SOURCE_LINE 00000038 "  {"
NSQ_SOURCE_LINE 00000039 "    if(!ref($args{lib}))"
NSQ_SOURCE_LINE 00000040 "    {"
NSQ_SOURCE_LINE 00000041 "      push @lib, $args{lib};"
NSQ_SOURCE_LINE 00000042 "    }"
NSQ_SOURCE_LINE 00000043 "    elsif(ref($args{lib}) eq 'ARRAY')"
NSQ_SOURCE_LINE 00000044 "    {"
NSQ_SOURCE_LINE 00000045 "      push @lib, @{$args{lib}};"
NSQ_SOURCE_LINE 00000046 "    }"
NSQ_SOURCE_LINE 00000047 "    else"
NSQ_SOURCE_LINE 00000048 "    {"
NSQ_SOURCE_LINE 00000049 "      croak \"lib argument must be a scalar or array reference\";"
NSQ_SOURCE_LINE 00000050 "    }"
NSQ_SOURCE_LINE 00000051 "  }"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "  my $api          = $args{api} || 0;"
NSQ_SOURCE_LINE 00000054 "  my $experimental = $args{experimental} || 0;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "  if($experimental == 1)"
NSQ_SOURCE_LINE 00000057 "  {"
NSQ_SOURCE_LINE 00000058 "    Carp::croak(\"Please do not use the experimental version of api = 1, instead require FFI::Platypus 1.00 or better\");"
NSQ_SOURCE_LINE 00000059 "  }"
NSQ_SOURCE_LINE 00000060 "  elsif($experimental == 2)"
NSQ_SOURCE_LINE 00000061 "  {"
NSQ_SOURCE_LINE 00000062 "    Carp::croak(\"Please do not use the experimental version of api = 2, instead require FFI::Platypus 2.00 or better\");"
NSQ_SOURCE_LINE 00000063 "  }"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "  if(defined $api && $api > 2 && $experimental != $api)"
NSQ_SOURCE_LINE 00000066 "  {"
NSQ_SOURCE_LINE 00000067 "    Carp::cluck(\"Enabling development API version $api prior to FFI::Platypus $api.00\");"
NSQ_SOURCE_LINE 00000068 "  }"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "  my $tp;"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "  if($api == 0)"
NSQ_SOURCE_LINE 00000073 "  {"
NSQ_SOURCE_LINE 00000074 "    $tp = 'Version0';"
NSQ_SOURCE_LINE 00000075 "  }"
NSQ_SOURCE_LINE 00000076 "  elsif($api == 1)"
NSQ_SOURCE_LINE 00000077 "  {"
NSQ_SOURCE_LINE 00000078 "    $tp = 'Version1';"
NSQ_SOURCE_LINE 00000079 "  }"
NSQ_SOURCE_LINE 00000080 "  elsif($api == 2)"
NSQ_SOURCE_LINE 00000081 "  {"
NSQ_SOURCE_LINE 00000082 "    $tp = 'Version2';"
NSQ_SOURCE_LINE 00000083 "  }"
NSQ_SOURCE_LINE 00000084 "  else"
NSQ_SOURCE_LINE 00000085 "  {"
NSQ_SOURCE_LINE 00000086 "    Carp::croak(\"API version $api not (yet) implemented\");"
NSQ_SOURCE_LINE 00000087 "  }"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "  require \"FFI/Platypus/TypeParser/$tp.pm\";"
NSQ_SOURCE_LINE 00000090 "  $tp = \"FFI::Platypus::TypeParser::$tp\";"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "  my $self = bless {"
NSQ_SOURCE_LINE 00000093 "    lib              => \\@lib,"
NSQ_SOURCE_LINE 00000094 "    lang             => '',"
NSQ_SOURCE_LINE 00000095 "    handles          => {},"
NSQ_SOURCE_LINE 00000096 "    abi              => -1,"
NSQ_SOURCE_LINE 00000097 "    api              => $api,"
NSQ_SOURCE_LINE 00000098 "    tp               => $tp->new,"
NSQ_SOURCE_LINE 00000099 "    fini             => [],"
NSQ_SOURCE_LINE 00000100 "    ignore_not_found => defined $args{ignore_not_found} ? $args{ignore_not_found} : 0,"
NSQ_SOURCE_LINE 00000101 "  }, $class;"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "  $self->lang($args{lang} || 'C');"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "  $self;"
NSQ_SOURCE_LINE 00000106 "}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "sub _lang_class ($)"
NSQ_SOURCE_LINE 00000109 "{"
NSQ_SOURCE_LINE 00000110 "  my($lang) = @_;"
NSQ_SOURCE_LINE 00000111 "  my $class = $lang =~ m/^=(.*)$/ ? $1 : \"FFI::Platypus::Lang::$lang\";"
NSQ_SOURCE_LINE 00000112 "  unless($class->can('native_type_map'))"
NSQ_SOURCE_LINE 00000113 "  {"
NSQ_SOURCE_LINE 00000114 "    my $pm = \"$class.pm\";"
NSQ_SOURCE_LINE 00000115 "    $pm =~ s/::/\\//g;"
NSQ_SOURCE_LINE 00000116 "    require $pm;"
NSQ_SOURCE_LINE 00000117 "  }"
NSQ_SOURCE_LINE 00000118 "  croak \"$class does not provide native_type_map method\""
NSQ_SOURCE_LINE 00000119 "    unless $class->can(\"native_type_map\");"
NSQ_SOURCE_LINE 00000120 "  $class;"
NSQ_SOURCE_LINE 00000121 "}"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "sub lib"
NSQ_SOURCE_LINE 00000125 "{"
NSQ_SOURCE_LINE 00000126 "  my($self, @new) = @_;"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "  if(@new)"
NSQ_SOURCE_LINE 00000129 "  {"
NSQ_SOURCE_LINE 00000130 "    push @{ $self->{lib} }, map { ref $_ eq 'CODE' ? $_->() : $_ } @new;"
NSQ_SOURCE_LINE 00000131 "    delete $self->{mangler};"
NSQ_SOURCE_LINE 00000132 "  }"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "  @{ $self->{lib} };"
NSQ_SOURCE_LINE 00000135 "}"
