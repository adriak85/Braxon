NSQ_SOURCE_LINE 00000138 "sub ignore_not_found"
NSQ_SOURCE_LINE 00000139 "{"
NSQ_SOURCE_LINE 00000140 "  my($self, $value) = @_;"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "  if(defined $value)"
NSQ_SOURCE_LINE 00000143 "  {"
NSQ_SOURCE_LINE 00000144 "    $self->{ignore_not_found} = $value;"
NSQ_SOURCE_LINE 00000145 "  }"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "  $self->{ignore_not_found};"
NSQ_SOURCE_LINE 00000148 "}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "sub lang"
NSQ_SOURCE_LINE 00000152 "{"
NSQ_SOURCE_LINE 00000153 "  my($self, $value) = @_;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "  if(defined $value && $value ne $self->{lang})"
NSQ_SOURCE_LINE 00000156 "  {"
NSQ_SOURCE_LINE 00000157 "    $self->{lang} = $value;"
NSQ_SOURCE_LINE 00000158 "    my $class = _lang_class($self->{lang});"
NSQ_SOURCE_LINE 00000159 "    $self->abi($class->abi) if $class->can('abi');"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    {"
NSQ_SOURCE_LINE 00000162 "      my %type_map;"
NSQ_SOURCE_LINE 00000163 "      my $map = $class->native_type_map("
NSQ_SOURCE_LINE 00000164 "        $self->{api} > 0"
NSQ_SOURCE_LINE 00000165 "          ? (api => $self->{api})"
NSQ_SOURCE_LINE 00000166 "          : ()"
NSQ_SOURCE_LINE 00000167 "      );"
NSQ_SOURCE_LINE 00000168 "      foreach my $key (keys %$map)"
NSQ_SOURCE_LINE 00000169 "      {"
NSQ_SOURCE_LINE 00000170 "        my $value = $map->{$key};"
NSQ_SOURCE_LINE 00000171 "        next unless $self->{tp}->have_type($value);"
NSQ_SOURCE_LINE 00000172 "        $type_map{$key} = $value;"
NSQ_SOURCE_LINE 00000173 "      }"
NSQ_SOURCE_LINE 00000174 "      $type_map{$_} = $_ for grep { $self->{tp}->have_type($_) }"
NSQ_SOURCE_LINE 00000175 "        qw( void sint8 uint8 sint16 uint16 sint32 uint32 sint64 uint64 float double string opaque"
NSQ_SOURCE_LINE 00000176 "            longdouble complex_float complex_double );"
NSQ_SOURCE_LINE 00000177 "      $type_map{pointer} = 'opaque' if $self->{tp}->isa('FFI::Platypus::TypeParser::Version0');"
NSQ_SOURCE_LINE 00000178 "      $self->{tp}->type_map(\\%type_map);"
NSQ_SOURCE_LINE 00000179 "    }"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "    $class->load_custom_types($self) if $class->can('load_custom_types');"
NSQ_SOURCE_LINE 00000182 "  }"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "  $self->{lang};"
NSQ_SOURCE_LINE 00000185 "}"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "sub api { shift->{api} }"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "sub type"
NSQ_SOURCE_LINE 00000192 "{"
NSQ_SOURCE_LINE 00000193 "  my($self, $name, $alias) = @_;"
NSQ_SOURCE_LINE 00000194 "  croak \"usage: \\$ffi->type(name => alias) (alias is optional)\" unless defined $self && defined $name;"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "  $self->{tp}->check_alias($alias) if defined $alias;"
NSQ_SOURCE_LINE 00000197 "  my $type = $self->{tp}->parse($name);"
NSQ_SOURCE_LINE 00000198 "  $self->{tp}->set_alias($alias, $type) if defined $alias;"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "  $self;"
NSQ_SOURCE_LINE 00000201 "}"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "sub custom_type"
NSQ_SOURCE_LINE 00000205 "{"
NSQ_SOURCE_LINE 00000206 "  my($self, $alias, $cb) = @_;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "  my $argument_count = $cb->{argument_count} || 1;"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "  croak \"argument_count must be >= 1\""
NSQ_SOURCE_LINE 00000211 "    unless $argument_count >= 1;"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "  croak \"Usage: \\$ffi->custom_type(\\$alias, { ... })\""
NSQ_SOURCE_LINE 00000214 "    unless defined $alias && ref($cb) eq 'HASH';"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "  croak \"must define at least one of native_to_perl, perl_to_native, or perl_to_native_post\""
NSQ_SOURCE_LINE 00000217 "    unless defined $cb->{native_to_perl} || defined $cb->{perl_to_native} || defined $cb->{perl_to_native_post};"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "  $self->{tp}->check_alias($alias);"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "  my $type = $self->{tp}->create_type_custom("
NSQ_SOURCE_LINE 00000222 "    $cb->{native_type},"
NSQ_SOURCE_LINE 00000223 "    $cb->{perl_to_native},"
NSQ_SOURCE_LINE 00000224 "    $cb->{native_to_perl},"
NSQ_SOURCE_LINE 00000225 "    $cb->{perl_to_native_post},"
NSQ_SOURCE_LINE 00000226 "    $argument_count,"
NSQ_SOURCE_LINE 00000227 "  );"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "  $self->{tp}->set_alias($alias, $type);"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "  $self;"
NSQ_SOURCE_LINE 00000232 "}"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "sub load_custom_type"
NSQ_SOURCE_LINE 00000236 "{"
NSQ_SOURCE_LINE 00000237 "  my($self, $name, $alias, @type_args) = @_;"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "  croak \"usage: \\$ffi->load_custom_type(\\$name, \\$alias, ...)\""
NSQ_SOURCE_LINE 00000240 "    unless defined $name && defined $alias;"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "  $name = \"FFI::Platypus::Type$name\" if $name =~ /^::/;"
NSQ_SOURCE_LINE 00000243 "  $name = \"FFI::Platypus::Type::$name\" unless $name =~ /::/;"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "  unless($name->can(\"ffi_custom_type_api_1\"))"
NSQ_SOURCE_LINE 00000246 "  {"
NSQ_SOURCE_LINE 00000247 "    my $pm = \"$name.pm\";"
NSQ_SOURCE_LINE 00000248 "    $pm =~ s/::/\\//g;"
NSQ_SOURCE_LINE 00000249 "    eval { require $pm };"
NSQ_SOURCE_LINE 00000250 "    warn $@ if $@;"
NSQ_SOURCE_LINE 00000251 "  }"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "  unless($name->can(\"ffi_custom_type_api_1\"))"
NSQ_SOURCE_LINE 00000254 "  {"
NSQ_SOURCE_LINE 00000255 "    croak \"$name does not appear to conform to the custom type API\";"
NSQ_SOURCE_LINE 00000256 "  }"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "  my $cb = $name->ffi_custom_type_api_1($self, @type_args);"
NSQ_SOURCE_LINE 00000259 "  $self->custom_type($alias => $cb);"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "  $self;"
NSQ_SOURCE_LINE 00000262 "}"
NSQ_SOURCE_LINE 00000263 ""
