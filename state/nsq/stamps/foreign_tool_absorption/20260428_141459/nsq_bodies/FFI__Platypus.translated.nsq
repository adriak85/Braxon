NSQ_SOURCE_LINE 00000382 "sub closure"
NSQ_SOURCE_LINE 00000383 "{"
NSQ_SOURCE_LINE 00000384 "  my($self, $coderef) = @_;"
NSQ_SOURCE_LINE 00000385 "  return undef unless defined $coderef;"
NSQ_SOURCE_LINE 00000386 "  croak \"not a coderef\" unless ref $coderef eq 'CODE';"
