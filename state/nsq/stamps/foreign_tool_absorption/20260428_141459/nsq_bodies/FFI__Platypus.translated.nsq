NSQ_SOURCE_LINE 00000349 "sub attach"
NSQ_SOURCE_LINE 00000350 "{"
NSQ_SOURCE_LINE 00000351 "  my $wrapper;"
NSQ_SOURCE_LINE 00000352 "  $wrapper = pop if ref $_[-1] eq 'CODE';"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "  my $self = shift;"
NSQ_SOURCE_LINE 00000355 "  my $name = shift;"
NSQ_SOURCE_LINE 00000356 "  my $args = shift;"
NSQ_SOURCE_LINE 00000357 "  my $varargs;"
NSQ_SOURCE_LINE 00000358 "  $varargs = shift if defined $_[0] && ref($_[0]) eq 'ARRAY';"
NSQ_SOURCE_LINE 00000359 "  my $ret = shift;"
NSQ_SOURCE_LINE 00000360 "  my $proto = shift;"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "  $ret = 'void' unless defined $ret;"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "  my($c_name, $perl_name) = ref($name) ? @$name : ($name, $name);"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "  croak \"you tried to provide a perl name that looks like an address\""
NSQ_SOURCE_LINE 00000367 "    if $perl_name =~ /^-?[0-9]+$/;"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "  my $function = $varargs"
NSQ_SOURCE_LINE 00000370 "    ? $self->function($c_name, $args, $varargs, $ret, $wrapper)"
NSQ_SOURCE_LINE 00000371 "    : $self->function($c_name, $args, $ret, $wrapper);"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "  if(defined $function)"
NSQ_SOURCE_LINE 00000374 "  {"
NSQ_SOURCE_LINE 00000375 "    $function->attach($perl_name, $proto);"
NSQ_SOURCE_LINE 00000376 "  }"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "  $self;"
