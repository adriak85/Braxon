NSQ_SOURCE_LINE 00000359 "sub newitem {"
NSQ_SOURCE_LINE 00000360 "\tmy $self = shift ;"
NSQ_SOURCE_LINE 00000361 "\tmy $attribs = shift ;"
NSQ_SOURCE_LINE 00000362 "\tmy $value = shift ;"
NSQ_SOURCE_LINE 00000363 "\tmy $indent = shift ;"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "\t$attribs->{defined} = 'false' unless defined $value ;"
NSQ_SOURCE_LINE 00000366 "\tmy $out = $self->newelement( %$attribs ) ;"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "\tif ( ref $value ) {"
NSQ_SOURCE_LINE 00000369 "\t\t$out->addelement( \"\\n\" . \" \" x$indent ) ;"
NSQ_SOURCE_LINE 00000370 "\t\t$out->addelement( nextpl2xml( $self, $value, $indent +1 ) ) ;"
NSQ_SOURCE_LINE 00000371 "\t\t$out->addelement( \"\\n\" . \" \" x( $indent -1 ) ) ;"
NSQ_SOURCE_LINE 00000372 "\t\t}"
NSQ_SOURCE_LINE 00000373 "\telse {"
NSQ_SOURCE_LINE 00000374 "\t\t$out->addelement( $value ) ;"
NSQ_SOURCE_LINE 00000375 "\t\t}"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "\treturn ( item => $out ) ;"
NSQ_SOURCE_LINE 00000378 "\t}"
