NSQ_SOURCE_LINE 00000380 "sub newelement {"
NSQ_SOURCE_LINE 00000381 "\tmy $self = shift if @_ && ( ref $_[0] || $_[0] eq __PACKAGE__ ) ;"
NSQ_SOURCE_LINE 00000382 "\t$self = ! $self? __PACKAGE__: ref $self? ref $self: $self ;"
NSQ_SOURCE_LINE 00000383 "\t"
NSQ_SOURCE_LINE 00000384 "\treturn bless [ { @_ } ], $self ;"
NSQ_SOURCE_LINE 00000385 "\t}"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "sub addelement {"
NSQ_SOURCE_LINE 00000388 "\tmy $self = shift ;"
NSQ_SOURCE_LINE 00000389 "\tmy $scalar = pop ;"
NSQ_SOURCE_LINE 00000390 "\tmy $key = @_? shift @_: 0 ;"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "\tpush @$self, $key, $scalar ;"
NSQ_SOURCE_LINE 00000393 "\t}"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "sub nvpdump {"
NSQ_SOURCE_LINE 00000396 "\tmy $key = @_ > 3? pop( @_ ): '' ;"
NSQ_SOURCE_LINE 00000397 "\tmy $space = @_ > 2? pop( @_ ): -1 ;"
NSQ_SOURCE_LINE 00000398 "\tmy $self = pop @_ ;"
NSQ_SOURCE_LINE 00000399 "\tmy @kids = $self->childnodes ;"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "\tif ( @_ == 0 ) {"
NSQ_SOURCE_LINE 00000402 "\t\t@kids = $self->childnode('perldata')->childnodes ;"
NSQ_SOURCE_LINE 00000403 "\t\tcarp( \"Data source not from pl2xml\" ) && return \"\""
NSQ_SOURCE_LINE 00000404 "\t\t\t\tunless @kids == 1 ;"
NSQ_SOURCE_LINE 00000405 "\t\treturn nvpdump( @{ $kids[0] } ) ;"
NSQ_SOURCE_LINE 00000406 "\t\t}"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "\tmy $name = shift ;"
NSQ_SOURCE_LINE 00000409 "\tmy $pad = ' 'x$space ;"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "\treturn join \"\\n\", map { nvpdump( @$_, $space +1 ) } @kids "
NSQ_SOURCE_LINE 00000412 "\t\t\tif $name eq 'hashref' ;"
NSQ_SOURCE_LINE 00000413 "\treturn join \"\\n\", map { nvpdump( @$_, $space, $key ) } @kids "
NSQ_SOURCE_LINE 00000414 "\t\t\tif $name eq 'arrayref' ;"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "\t$key = $key && @kids? $key: $self->getattributes->{key} ;"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "\tmy $value = join \"\\n$pad\", "
NSQ_SOURCE_LINE 00000419 "\t\t\tmap { nvpdump( @$_, $space, $key ) } @kids ;"
NSQ_SOURCE_LINE 00000420 "\treturn $value if @kids && $kids[0][0] eq 'arrayref' ;"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "\t$value = join \"\\n\", '', $value, $pad if $value ;"
NSQ_SOURCE_LINE 00000423 "\t$value ||= $self->gettext() ;"
NSQ_SOURCE_LINE 00000424 "\treturn sprintf \"$pad<$key>%s</$key>\", $value ;"
NSQ_SOURCE_LINE 00000425 "\t}"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "1 ;"
NSQ_SOURCE_LINE 00000428 "__END__"
NSQ_SOURCE_LINE 00000429 "# Below is stub documentation for your module. You'd better edit it!"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "=head1 NAME"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "XML::Parser::Nodes - Extends XML::Parser"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "  use XML::Parser::Nodes ;"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "=head2 Constructors"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "  $node = XML::Parser->new( Style => 'Nodes' )->parsefile( $xmlFileName ) ;"
NSQ_SOURCE_LINE 00000442 "  $node = XML::Parser::Nodes->parsefile( $xmlFileName ) ;"
NSQ_SOURCE_LINE 00000443 "  $node = new XML::Parser::Nodes $xmlFileName ;"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "  or"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "  $node = XML::Parser->new( Style => 'Nodes' )->parse( $xmlBufferedScalar ) ;"
NSQ_SOURCE_LINE 00000448 "  $node = XML::Parser::Nodes->parse( $xmlBufferedScalar ) ;"
NSQ_SOURCE_LINE 00000449 "  $node = new XML::Parser::Nodes $xmlBufferedScalar ;"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "  or"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "  $node = XML::Parser::Nodes->pl2xml( $ComplexPerlObject ) ;"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=head2 Access Node Components"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "  @nodenames = $node->childlist() ;"
NSQ_SOURCE_LINE 00000458 "  @elements = $node->childnodes() ;"
NSQ_SOURCE_LINE 00000459 "  $nodevalue = $node->gettext() ;"
NSQ_SOURCE_LINE 00000460 "  %nodeproperties = %{ $node->getattributes() } ;"
NSQ_SOURCE_LINE 00000461 "  @values = @{ $node->cells( @keylist ) } ;"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "=head2 Survey the Document"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "  @nodekeys = $node->tree() ;"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "=head2 Retrieve a Node"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "  $childnode = $parentnode->childnode('nodename') ;"
NSQ_SOURCE_LINE 00000470 "  @childnodes = $parentnode->childnode('nodename') ;"
NSQ_SOURCE_LINE 00000471 "  $descendantnode = $parentnode->nodebykey( $nodekey ) ;"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "=head2 XML Output"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "  $xmldoc = $node->dump() ;"
NSQ_SOURCE_LINE 00000476 "  $xmldoc = $node->nvpdump() ;"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "=head2 Create a Node Wrapper"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "  $parentnode = $node->wrapper( $parentname ) ;"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "When XML::Parser::parse is used without callback functions, the returned object "
NSQ_SOURCE_LINE 00000486 "can get pretty hairy for complex objects.  XML::Parser::Nodes provides methods"
NSQ_SOURCE_LINE 00000487 "to access that object's internals as a sequence of nodes."
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "XML::Parser::Nodes also has a constructor to create an object directly from a "
NSQ_SOURCE_LINE 00000490 "complex Perl object, similar to XML::Dumper->pl2xml().  The following two "
NSQ_SOURCE_LINE 00000491 "statements are equivalent:"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "  $xmlnode = XML::Parser::Nodes->pl2xml( $ComplexPerlObject ) ;"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "  $xmlnode = XML::Parser::Nodes->parse( "
NSQ_SOURCE_LINE 00000496 "\t\tXML::Dumper->pl2xml( $ComplexPerlObject )"
NSQ_SOURCE_LINE 00000497 "\t\t) ;"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "As a basic background, an XML document can be thought of as nested name-value-"
NSQ_SOURCE_LINE 00000500 "pairs.  Basically, a node value is either a string or a set of child nodes.  "
NSQ_SOURCE_LINE 00000501 "It's easy to imagine an XML object as a complex Perl object with a hierarchy"
NSQ_SOURCE_LINE 00000502 "of HASH references, whose bottom element is a scalar:"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "  print $company->{$division}->{$location}->{$department}->{Director}->{FirstName} ;"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "Might refer to a string \"Jim\". "
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "In an XML document represented by an XML::Parser::Nodes object, that value"
NSQ_SOURCE_LINE 00000509 "would be accessed as:"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "  print $xmlnode->childnode( $company"
NSQ_SOURCE_LINE 00000512 "\t\t)->childnode( $division"
NSQ_SOURCE_LINE 00000513 "\t\t)->childnode( $location"
NSQ_SOURCE_LINE 00000514 "\t\t)->childnode( $department"
NSQ_SOURCE_LINE 00000515 "\t\t)->childnode('Director'"
NSQ_SOURCE_LINE 00000516 "\t\t)->childnode('FirstName')->gettext() ;"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "Alternatively,"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "  $nodekey = join '/', $division, $location, $department, 'Director', 'FirstName' ;"
NSQ_SOURCE_LINE 00000521 "  print $xmlnode->nodebykey( $nodekey )->gettext ;"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "Some XML documents are more complex and contain sets of values.  "
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "  print $company->{$division}->{$location}->{$department}->{Staff}->[0]->{FirstName} ;"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "Represents a complex object where department staff consists of a set of individuals, one of whom has the first name, \"Jim\"."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "One of the features of XML::Parser::Nodes is the ability to survey the contents "
NSQ_SOURCE_LINE 00000530 "of a node.  The most basic is C<childlist()> which returns an ordered list of "
NSQ_SOURCE_LINE 00000531 "element names.  If the node consists of 5 children with the same name, that "
NSQ_SOURCE_LINE 00000532 "name will be returned 5 times."
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "The C<tree()> function is similar, except it recurses into each child.  The "
NSQ_SOURCE_LINE 00000535 "returned values are similar to file pathnames where a slash represents"
NSQ_SOURCE_LINE 00000536 "a parent->child relationship."
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "There are analogous methods to retrieve a node:  C<childnode()> takes an "
NSQ_SOURCE_LINE 00000539 "element name as an argument; C<nodebykey()> takes the path representation"
NSQ_SOURCE_LINE 00000540 "as its argument.  When the key refers to a direct child, these two methods "
NSQ_SOURCE_LINE 00000541 "are interchangeable.  These methods each return an array, but can be called "
NSQ_SOURCE_LINE 00000542 "in a scalar context, which returns the first matching node.  In order to use "
NSQ_SOURCE_LINE 00000543 "the recursive methods and techniques, the caller should be confident that the "
NSQ_SOURCE_LINE 00000544 "target is a unique location."
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "C<cells()> could be applied to each child of the division staff node in the"
NSQ_SOURCE_LINE 00000547 "example above and the results used in a spreadsheet application or database "
NSQ_SOURCE_LINE 00000548 "table."
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "This module is primarily designed to retrieve data from a complex XML "
NSQ_SOURCE_LINE 00000551 "document.  The C<dump()> method restores the XML document.  This method is "
NSQ_SOURCE_LINE 00000552 "useful for converting a branch of an large XML object into a smaller document.  "
NSQ_SOURCE_LINE 00000553 "The C<wrapper()> method creates a wrapper node for this purpose."
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "C<childnodes()> returns the child nodes as elements.  An element is an array "
NSQ_SOURCE_LINE 00000556 "pair consisting of the element name and node value.  Custom functions will"
NSQ_SOURCE_LINE 00000557 "most likely accept these elements as arguments.  C<dump()> is a wrapper for"
NSQ_SOURCE_LINE 00000558 "the method C<xmlout()>, which takes this element pair as its arguments.  With"
NSQ_SOURCE_LINE 00000559 "no arguments, C<childnode()> functions identically."
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "XML::Parser::Nodes can be used to create custom XML output.  "
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "=head2 Example"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "C<dump()> can be used as a template to override, or otherwise, alter the "
NSQ_SOURCE_LINE 00000566 "document output.  The C<nvpdump()> method is a useful example that generates"
NSQ_SOURCE_LINE 00000567 "output that may be specified as follows:"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "    <QBMSXML>"
NSQ_SOURCE_LINE 00000570 "     <Signon>"
NSQ_SOURCE_LINE 00000571 "      <Desktop>"
NSQ_SOURCE_LINE 00000572 "       <DateTime>2012-02-29T12:40:09</DateTime>"
NSQ_SOURCE_LINE 00000573 "       <Ticket>gas8p9ee-re2s9old-ref2i6t</Ticket>"
NSQ_SOURCE_LINE 00000574 "       <Login>tqis.com</Login>"
NSQ_SOURCE_LINE 00000575 "      </Desktop>"
NSQ_SOURCE_LINE 00000576 "     </Signon>"
NSQ_SOURCE_LINE 00000577 "     <MsgsRq>"
NSQ_SOURCE_LINE 00000578 "      <CreditCard>"
NSQ_SOURCE_LINE 00000579 "       <RequestID>546696356386</RequestID>"
NSQ_SOURCE_LINE 00000580 "       <Number>4111111111111111</Number>"
NSQ_SOURCE_LINE 00000581 "       <Year>2012</Year>"
NSQ_SOURCE_LINE 00000582 "       <Amount>10.00</Amount>"
NSQ_SOURCE_LINE 00000583 "       <Month>12</Month>"
NSQ_SOURCE_LINE 00000584 "       <CardPresent>false</CardPresent>"
NSQ_SOURCE_LINE 00000585 "      </CreditCard>"
NSQ_SOURCE_LINE 00000586 "     </MsgsRq>"
NSQ_SOURCE_LINE 00000587 "     <MsgsRq>"
NSQ_SOURCE_LINE 00000588 "      <CreditCard>"
NSQ_SOURCE_LINE 00000589 "       <RequestID>546696356387</RequestID>"
NSQ_SOURCE_LINE 00000590 "       <Number>4123111111111111</Number>"
NSQ_SOURCE_LINE 00000591 "       <Year>2014</Year>"
NSQ_SOURCE_LINE 00000592 "       <Amount>20.00</Amount>"
NSQ_SOURCE_LINE 00000593 "       <Month>8</Month>"
NSQ_SOURCE_LINE 00000594 "       <CardPresent>false</CardPresent>"
NSQ_SOURCE_LINE 00000595 "      </CreditCard>"
NSQ_SOURCE_LINE 00000596 "     </MsgsRq>"
NSQ_SOURCE_LINE 00000597 "    </QBMSXML>"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "Start by defining the data as a complex Perl object:"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "    $request = {"
NSQ_SOURCE_LINE 00000602 "        'QBMSXML' => {"
NSQ_SOURCE_LINE 00000603 "            'MsgsRq' => [ "
NSQ_SOURCE_LINE 00000604 "                {"
NSQ_SOURCE_LINE 00000605 "                    'CreditCard' => {"
NSQ_SOURCE_LINE 00000606 "                        'Amount' => '10.00',"
NSQ_SOURCE_LINE 00000607 "                        'Year' => '2012',"
NSQ_SOURCE_LINE 00000608 "                        'Number' => '4111111111111111',"
NSQ_SOURCE_LINE 00000609 "                        'RequestID' => '546696356386',"
NSQ_SOURCE_LINE 00000610 "                        'Month' => '12',"
NSQ_SOURCE_LINE 00000611 "                        'CardPresent' => 'false'"
NSQ_SOURCE_LINE 00000612 "                        }"
NSQ_SOURCE_LINE 00000613 "                    },"
NSQ_SOURCE_LINE 00000614 "                {"
NSQ_SOURCE_LINE 00000615 "                    'CreditCard' => {"
NSQ_SOURCE_LINE 00000616 "                        'Amount' => '20.00',"
NSQ_SOURCE_LINE 00000617 "                        'Year' => '2014',"
NSQ_SOURCE_LINE 00000618 "                        'Number' => '4123111111111111',"
NSQ_SOURCE_LINE 00000619 "                        'RequestID' => '546696356387',"
NSQ_SOURCE_LINE 00000620 "                        'Month' => '8',"
NSQ_SOURCE_LINE 00000621 "                        'CardPresent' => 'false'"
NSQ_SOURCE_LINE 00000622 "                        }"
NSQ_SOURCE_LINE 00000623 "                    }"
NSQ_SOURCE_LINE 00000624 "                ],"
NSQ_SOURCE_LINE 00000625 "            'Signon' => {"
NSQ_SOURCE_LINE 00000626 "                'Desktop' => {"
NSQ_SOURCE_LINE 00000627 "                    'DateTime' => '2012-02-29T12:40:09',"
NSQ_SOURCE_LINE 00000628 "                    'Ticket' => 'gas8p9ee-re2s9old-ref2i6t',"
NSQ_SOURCE_LINE 00000629 "                    'Login' => 'tqis.com'"
NSQ_SOURCE_LINE 00000630 "                    }"
NSQ_SOURCE_LINE 00000631 "                }"
NSQ_SOURCE_LINE 00000632 "            }"
NSQ_SOURCE_LINE 00000633 "        } ;"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "The XML::Parser::Nodes module includes the C<nvpdump()> method to perform this "
NSQ_SOURCE_LINE 00000636 "transformation:"
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "  print XML::Parser::Nodes->pl2xml( $request )->nvpdump() ;"
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "C<nvpdump()> is called recursively on each node. The disposition of each"
NSQ_SOURCE_LINE 00000641 "node is determined by its name and constituent elements.  If the node has"
NSQ_SOURCE_LINE 00000642 "no elements, display the string data (the NVP value).  Otherwise, the"
NSQ_SOURCE_LINE 00000643 "method handles the key (the NVP name) based on the node name:"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "  Set the key if node name == \"item\""
NSQ_SOURCE_LINE 00000646 "  Reset the key if node name == \"hashref\""
NSQ_SOURCE_LINE 00000647 "  Preserve the key if node name == \"arrayref\""
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "=head2 EXPORT"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "None by default."
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "=head1 DEPENDENCIES"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "Requires XML::Parser.  "
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "The pl2xml function requires XML::Dumper."
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000661 ""
