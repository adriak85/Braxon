NSQ_SOURCE_LINE 00000290 "sub nextpl2xml {"
NSQ_SOURCE_LINE 00000291 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000292 "\tmy $ref = shift;"
NSQ_SOURCE_LINE 00000293 "\tmy $indent = shift;"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "\tmy $out = $self->newelement() ;"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "\tif ( ref $ref ) {"
NSQ_SOURCE_LINE 00000298 "\t\tlocal $_ = ref $ref ;"
NSQ_SOURCE_LINE 00000299 "\t\tmy $class = '' ;"
NSQ_SOURCE_LINE 00000300 "\t\tmy $address = '' ;"
NSQ_SOURCE_LINE 00000301 "\t"
NSQ_SOURCE_LINE 00000302 "\t\tif ( /^(?:SCALAR|HASH|ARRAY)$/ ) {"
NSQ_SOURCE_LINE 00000303 "\t\t\t( $_, $address) = overload::StrVal( $ref ) "
NSQ_SOURCE_LINE 00000304 "\t\t\t\t\t=~ /([^(]+)\\(([x0-9A-Fa-f]+)\\)/ ;"
NSQ_SOURCE_LINE 00000305 "\t\t\t}"
NSQ_SOURCE_LINE 00000306 "\t\telse {"
NSQ_SOURCE_LINE 00000307 "\t\t\t$class = XML::Dumper::xml_escape( ref $ref );"
NSQ_SOURCE_LINE 00000308 "\t\t\t( $_, $address ) = overload::StrVal( $ref ) "
NSQ_SOURCE_LINE 00000309 "\t\t\t\t\t=~ /$class=([^(]+)\\(([x0-9A-Fa-f]+)\\)/ ;"
NSQ_SOURCE_LINE 00000310 "\t\t\t}"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "\t\tmy $reused = $address && $self->{xml}{ $address }++ ;"
NSQ_SOURCE_LINE 00000313 "\t\tmy $indentstr = \"\\n\" . \" \" x$indent ;"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "\t\t$out->[0]->{blessed_package} = $class if $class ;"
NSQ_SOURCE_LINE 00000316 "\t\t$out->[0]->{memory_address} = $address if $address ;"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "\t\tif ( /^SCALAR$/ && ! $reused ) {"
NSQ_SOURCE_LINE 00000319 "\t\t\t$out->[0]->{defined} = 'false' unless defined $$ref ;"
NSQ_SOURCE_LINE 00000320 "\t\t\t$out->addelement( 0 => $$ref ) ;"
NSQ_SOURCE_LINE 00000321 "\t\t\t}"
NSQ_SOURCE_LINE 00000322 "\t\telsif ( /^HASH$/ && ! $reused ) {"
NSQ_SOURCE_LINE 00000323 "\t\t\tforeach my $k ( keys %$ref ) {"
NSQ_SOURCE_LINE 00000324 "\t\t\t\t$out->addelement( $indentstr ) ;"
NSQ_SOURCE_LINE 00000325 "\t\t\t\t$out->addelement( newitem( $self,"
NSQ_SOURCE_LINE 00000326 "\t\t\t\t\t\t{ key => $k }, "
NSQ_SOURCE_LINE 00000327 "\t\t\t\t\t\t$ref->{ $k }, "
NSQ_SOURCE_LINE 00000328 "\t\t\t\t\t\t$indent +1 ) ) ;"
NSQ_SOURCE_LINE 00000329 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "\t\t\t$out->addelement( \"\\n\" . \" \" x( $indent -1 ) ) ;"
NSQ_SOURCE_LINE 00000332 "\t\t\t}"
NSQ_SOURCE_LINE 00000333 "\t\telsif ( /^ARRAY$/ && ! $reused ) {"
NSQ_SOURCE_LINE 00000334 "\t\t\tfor ( my $ct = 0 ; $ct < @$ref ; $ct++ ) {"
NSQ_SOURCE_LINE 00000335 "\t\t\t\t$out->addelement( $indentstr ) ;"
NSQ_SOURCE_LINE 00000336 "\t\t\t\t$out->addelement( newitem( $self,"
NSQ_SOURCE_LINE 00000337 "\t\t\t\t\t\t{ key => $ct }, "
NSQ_SOURCE_LINE 00000338 "\t\t\t\t\t\t$ref->[ $ct ], "
NSQ_SOURCE_LINE 00000339 "\t\t\t\t\t\t$indent +1 ) ) ;"
NSQ_SOURCE_LINE 00000340 "\t\t\t\t}"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "\t\t\t$out->addelement( \"\\n\" . \" \" x( $indent -1 ) ) ;"
NSQ_SOURCE_LINE 00000343 "\t\t\t}"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "\t\tmy $key = /^SCALAR$/? 'scalarref':"
NSQ_SOURCE_LINE 00000346 "\t\t\t\t/^HASH$/? 'hashref':"
NSQ_SOURCE_LINE 00000347 "\t\t\t\t/^ARRAY$/? 'arrayref': '' ;"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "\t\treturn $key => $out ;"
NSQ_SOURCE_LINE 00000350 "\t\t}"
NSQ_SOURCE_LINE 00000351 "\telse {"
NSQ_SOURCE_LINE 00000352 "\t\t$out->[0]->{defined} = 'false' unless defined $ref ;"
NSQ_SOURCE_LINE 00000353 "\t\t$out->addelement( 0 => $ref ) ;"
NSQ_SOURCE_LINE 00000354 "\t\treturn ( scalar => $out ) ;"
NSQ_SOURCE_LINE 00000355 "\t\t}"
NSQ_SOURCE_LINE 00000356 "\t}"
NSQ_SOURCE_LINE 00000357 ""
