NSQ_SOURCE_LINE 00000279 "\t$top->addelement( \"\\n \" ) ;"
NSQ_SOURCE_LINE 00000280 "\t$top->addelement( nextpl2xml( bless( {}, $self ), $o, 2 ) ) ;"
NSQ_SOURCE_LINE 00000281 "\t$top->addelement( \"\\n\" ) ;"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "\tmy $out = $self->newelement() ;"
NSQ_SOURCE_LINE 00000284 "\t$out->addelement( $toplabel => $top ) ;"
NSQ_SOURCE_LINE 00000285 "\treturn $out ;"
