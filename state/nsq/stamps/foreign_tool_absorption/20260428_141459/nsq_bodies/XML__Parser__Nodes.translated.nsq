NSQ_SOURCE_LINE 00000271 "sub pl2xml {"
NSQ_SOURCE_LINE 00000272 "\tmy $o = pop ;"
NSQ_SOURCE_LINE 00000273 "\tmy $self = shift if @_ && ( ref $_[0] || $_[0] eq __PACKAGE__ ) ;"
NSQ_SOURCE_LINE 00000274 "\t$self = ! $self? __PACKAGE__: ref $self? ref $self: $self ;"
