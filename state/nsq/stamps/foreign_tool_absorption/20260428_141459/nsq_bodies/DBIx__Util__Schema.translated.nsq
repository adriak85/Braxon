NSQ_SOURCE_LINE 00000747 "=head2 list_indexes"
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "Usage:"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 " list_indexes($dbh, $table) -> any"
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "List indexes for a table in a database."
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "SQLite notes: information is retrieved from DBI's table_info(). Autoindex for"
NSQ_SOURCE_LINE 00000756 "primary key is not listed using table_info(), but this function adds it by"
NSQ_SOURCE_LINE 00000757 "looking at C<sqlite_master> table."
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "MySQL notes: information is retrieved from statistics_info(). Note that a"
NSQ_SOURCE_LINE 00000760 "multi-column index is reported as separate rows by statistics_info(), one for"
NSQ_SOURCE_LINE 00000761 "each indexed column. But this function merges them and returns the list of"
NSQ_SOURCE_LINE 00000762 "columns in C<columns>."
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "=over 4"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "=item * B<$dbh>* => I<obj>"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "DBI database handle."
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "=item * B<$table>* => I<str>"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "Table name."
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "=back"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "Return value:  (any)"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 ""
