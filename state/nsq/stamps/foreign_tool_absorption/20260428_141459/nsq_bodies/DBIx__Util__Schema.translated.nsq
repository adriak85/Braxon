NSQ_SOURCE_LINE 00000099 "$SPEC{has_table} = {"
NSQ_SOURCE_LINE 00000100 "    v => 1.1,"
NSQ_SOURCE_LINE 00000101 "    summary => 'Check whether database has a certain table',"
NSQ_SOURCE_LINE 00000102 "    args => {"
NSQ_SOURCE_LINE 00000103 "        %arg0_dbh,"
NSQ_SOURCE_LINE 00000104 "        %arg1_table,"
NSQ_SOURCE_LINE 00000105 "    },"
NSQ_SOURCE_LINE 00000106 "    args_as => \"array\","
NSQ_SOURCE_LINE 00000107 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000108 "};"
NSQ_SOURCE_LINE 00000109 "sub has_table {"
NSQ_SOURCE_LINE 00000110 "    my ($dbh, $table) = @_;"
NSQ_SOURCE_LINE 00000111 "    my $sth;"
NSQ_SOURCE_LINE 00000112 "    if ($table =~ /(.+)\\.(.+)/) {"
NSQ_SOURCE_LINE 00000113 "        $sth = $dbh->table_info(undef, $1, $2, undef);"
NSQ_SOURCE_LINE 00000114 "    } else {"
NSQ_SOURCE_LINE 00000115 "        $sth = $dbh->table_info(undef, undef, $table, undef);"
NSQ_SOURCE_LINE 00000116 "    }"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "    $sth->fetchrow_hashref ? 1:0;"
NSQ_SOURCE_LINE 00000119 "}"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "# alias for has_table"
NSQ_SOURCE_LINE 00000122 "$SPEC{table_exists} = { %{$SPEC{has_table}}, summary=>'Alias for has_table()' };"
NSQ_SOURCE_LINE 00000123 "*table_exists = \\&has_table;"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "$SPEC{has_all_tables} = {"
NSQ_SOURCE_LINE 00000126 "    v => 1.1,"
NSQ_SOURCE_LINE 00000127 "    summary => 'Check whether database has all specified tables',"
NSQ_SOURCE_LINE 00000128 "    args => {"
NSQ_SOURCE_LINE 00000129 "        %arg0_dbh,"
NSQ_SOURCE_LINE 00000130 "        %arg1rest_tables,"
NSQ_SOURCE_LINE 00000131 "    },"
NSQ_SOURCE_LINE 00000132 "    args_as => \"array\","
NSQ_SOURCE_LINE 00000133 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000134 "};"
NSQ_SOURCE_LINE 00000135 "sub has_all_tables {"
NSQ_SOURCE_LINE 00000136 "    my ($dbh, @tables) = @_;"
NSQ_SOURCE_LINE 00000137 "    my $sth;"
NSQ_SOURCE_LINE 00000138 "    for my $table (@tables) {"
NSQ_SOURCE_LINE 00000139 "        if ($table =~ /(.+)\\.(.+)/) {"
NSQ_SOURCE_LINE 00000140 "            $sth = $dbh->table_info(undef, $1, $2, undef);"
NSQ_SOURCE_LINE 00000141 "        } else {"
NSQ_SOURCE_LINE 00000142 "            $sth = $dbh->table_info(undef, undef, $table, undef);"
NSQ_SOURCE_LINE 00000143 "        }"
NSQ_SOURCE_LINE 00000144 "        return 0 unless $sth->fetchrow_hashref;"
NSQ_SOURCE_LINE 00000145 "    }"
NSQ_SOURCE_LINE 00000146 "    1;"
NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "$SPEC{has_any_table} = {"
NSQ_SOURCE_LINE 00000150 "    v => 1.1,"
NSQ_SOURCE_LINE 00000151 "    summary => 'Check whether database has at least one of specified tables',"
NSQ_SOURCE_LINE 00000152 "    args => {"
NSQ_SOURCE_LINE 00000153 "        %arg0_dbh,"
NSQ_SOURCE_LINE 00000154 "        %arg1rest_tables,"
NSQ_SOURCE_LINE 00000155 "    },"
NSQ_SOURCE_LINE 00000156 "    args_as => \"array\","
NSQ_SOURCE_LINE 00000157 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000158 "};"
NSQ_SOURCE_LINE 00000159 "sub has_any_table {"
NSQ_SOURCE_LINE 00000160 "    my ($dbh, @tables) = @_;"
NSQ_SOURCE_LINE 00000161 "    my $sth;"
NSQ_SOURCE_LINE 00000162 "    for my $table (@tables) {"
NSQ_SOURCE_LINE 00000163 "        if ($table =~ /(.+)\\.(.+)/) {"
NSQ_SOURCE_LINE 00000164 "            $sth = $dbh->table_info(undef, $1, $2, undef);"
NSQ_SOURCE_LINE 00000165 "        } else {"
NSQ_SOURCE_LINE 00000166 "            $sth = $dbh->table_info(undef, undef, $table, undef);"
NSQ_SOURCE_LINE 00000167 "        }"
NSQ_SOURCE_LINE 00000168 "        return 1 if $sth->fetchrow_hashref;"
NSQ_SOURCE_LINE 00000169 "    }"
NSQ_SOURCE_LINE 00000170 "    @tables ? 0 : 1;"
NSQ_SOURCE_LINE 00000171 "}"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "$SPEC{has_column} = {"
NSQ_SOURCE_LINE 00000174 "    v => 1.1,"
NSQ_SOURCE_LINE 00000175 "    summary => 'Check whether a table has a specified column',"
NSQ_SOURCE_LINE 00000176 "    args => {"
NSQ_SOURCE_LINE 00000177 "        %arg0_dbh,"
NSQ_SOURCE_LINE 00000178 "        %arg1_table,"
NSQ_SOURCE_LINE 00000179 "        %arg2_column,"
NSQ_SOURCE_LINE 00000180 "    },"
NSQ_SOURCE_LINE 00000181 "    args_as => \"array\","
NSQ_SOURCE_LINE 00000182 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000183 "};"
NSQ_SOURCE_LINE 00000184 "sub has_column {"
NSQ_SOURCE_LINE 00000185 "    my ($dbh, $table, $column) = @_;"
NSQ_SOURCE_LINE 00000186 "    return 0 unless has_table($dbh, $table);"
NSQ_SOURCE_LINE 00000187 "    my @columns = list_columns($dbh, $table);"
NSQ_SOURCE_LINE 00000188 "    (grep {$_->{COLUMN_NAME} eq $column} @columns) ? 1:0;"
NSQ_SOURCE_LINE 00000189 "}"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "# alias for has_column"
NSQ_SOURCE_LINE 00000192 "$SPEC{column_exists} = { %{$SPEC{has_column}}, summary=>'Alias for has_column()' };"
NSQ_SOURCE_LINE 00000193 "*column_exists = \\&has_column;"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "$SPEC{has_all_columns} = {"
NSQ_SOURCE_LINE 00000196 "    v => 1.1,"
NSQ_SOURCE_LINE 00000197 "    summary => 'Check whether a table has all specified columns',"
NSQ_SOURCE_LINE 00000198 "    args => {"
NSQ_SOURCE_LINE 00000199 "        %arg0_dbh,"
NSQ_SOURCE_LINE 00000200 "        %arg1_table,"
NSQ_SOURCE_LINE 00000201 "        %arg2rest_columns,"
NSQ_SOURCE_LINE 00000202 "    },"
NSQ_SOURCE_LINE 00000203 "    args_as => \"array\","
NSQ_SOURCE_LINE 00000204 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000205 "};"
NSQ_SOURCE_LINE 00000206 "sub has_all_columns {"
NSQ_SOURCE_LINE 00000207 "    my ($dbh, $table, @columns) = @_;"
NSQ_SOURCE_LINE 00000208 "    return 0 unless has_table($dbh, $table);"
NSQ_SOURCE_LINE 00000209 "    my @all_columns = list_columns($dbh, $table);"
NSQ_SOURCE_LINE 00000210 "    for my $column (@columns) {"
NSQ_SOURCE_LINE 00000211 "        unless (grep {$_->{COLUMN_NAME} eq $column} @all_columns) { return 0 }"
NSQ_SOURCE_LINE 00000212 "    }"
NSQ_SOURCE_LINE 00000213 "    1;"
NSQ_SOURCE_LINE 00000214 "}"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "$SPEC{has_any_column} = {"
NSQ_SOURCE_LINE 00000217 "    v => 1.1,"
NSQ_SOURCE_LINE 00000218 "    summary => 'Check whether a table has at least one of specified columns',"
NSQ_SOURCE_LINE 00000219 "    args => {"
NSQ_SOURCE_LINE 00000220 "        %arg0_dbh,"
NSQ_SOURCE_LINE 00000221 "        %arg1_table,"
NSQ_SOURCE_LINE 00000222 "        %arg2rest_columns,"
NSQ_SOURCE_LINE 00000223 "    },"
NSQ_SOURCE_LINE 00000224 "    args_as => \"array\","
NSQ_SOURCE_LINE 00000225 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000226 "};"
NSQ_SOURCE_LINE 00000227 "sub has_any_column {"
NSQ_SOURCE_LINE 00000228 "    my ($dbh, $table, @columns) = @_;"
NSQ_SOURCE_LINE 00000229 "    return 0 unless has_table($dbh, $table);"
NSQ_SOURCE_LINE 00000230 "    my @all_columns = list_columns($dbh, $table);"
NSQ_SOURCE_LINE 00000231 "    for my $column (@columns) {"
NSQ_SOURCE_LINE 00000232 "        if (grep {$_->{COLUMN_NAME} eq $column} @all_columns) { return 1 }"
NSQ_SOURCE_LINE 00000233 "    }"
NSQ_SOURCE_LINE 00000234 "    @columns ? 0:1;"
NSQ_SOURCE_LINE 00000235 "}"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "$SPEC{list_tables} = {"
NSQ_SOURCE_LINE 00000238 "    v => 1.1,"
NSQ_SOURCE_LINE 00000239 "    summary => 'List table names in a database',"
NSQ_SOURCE_LINE 00000240 "    args => {"
NSQ_SOURCE_LINE 00000241 "        %arg0_dbh,"
NSQ_SOURCE_LINE 00000242 "    },"
NSQ_SOURCE_LINE 00000243 "    args_as => \"array\","
NSQ_SOURCE_LINE 00000244 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000245 "};"
NSQ_SOURCE_LINE 00000246 "sub list_tables {"
NSQ_SOURCE_LINE 00000247 "    my ($dbh) = @_;"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "    my $driver = $dbh->{Driver}{Name};"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "    my @res;"
NSQ_SOURCE_LINE 00000252 "    my $sth = $dbh->table_info(undef, undef, undef, undef);"
NSQ_SOURCE_LINE 00000253 "    while (my $row = $sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000254 "        my $name  = $row->{TABLE_NAME};"
NSQ_SOURCE_LINE 00000255 "        my $schem = $row->{TABLE_SCHEM};"
NSQ_SOURCE_LINE 00000256 "        my $type  = $row->{TABLE_TYPE};"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "        if ($driver eq 'mysql') {"
NSQ_SOURCE_LINE 00000259 "            # mysql driver returns database name as schema, so that's useless"
NSQ_SOURCE_LINE 00000260 "            $schem = '';"
NSQ_SOURCE_LINE 00000261 "        }"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "        next if $type eq 'VIEW';"
NSQ_SOURCE_LINE 00000264 "        next if $type eq 'INDEX';"
NSQ_SOURCE_LINE 00000265 "        next if $schem =~ /^(information_schema)$/;"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "        if ($driver eq 'Pg') {"
NSQ_SOURCE_LINE 00000268 "            next if $schem =~ /^(pg_catalog)$/;"
NSQ_SOURCE_LINE 00000269 "        } elsif ($driver eq 'SQLite') {"
NSQ_SOURCE_LINE 00000270 "            next if $schem =~ /^(temp)$/;"
NSQ_SOURCE_LINE 00000271 "            next if $name =~ /^(sqlite_master|sqlite_temp_master)$/;"
NSQ_SOURCE_LINE 00000272 "        }"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "        push @res, join("
NSQ_SOURCE_LINE 00000275 "            \"\","
NSQ_SOURCE_LINE 00000276 "            $schem,"
NSQ_SOURCE_LINE 00000277 "            length($schem) ? \".\" : \"\","
NSQ_SOURCE_LINE 00000278 "            $name,"
NSQ_SOURCE_LINE 00000279 "        );"
NSQ_SOURCE_LINE 00000280 "    }"
NSQ_SOURCE_LINE 00000281 "    sort @res;"
NSQ_SOURCE_LINE 00000282 "}"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "$SPEC{list_indexes} = {"
NSQ_SOURCE_LINE 00000285 "    v => 1.1,"
NSQ_SOURCE_LINE 00000286 "    summary => 'List indexes for a table in a database',"
NSQ_SOURCE_LINE 00000287 "    description => <<'_',"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "SQLite notes: information is retrieved from DBI's table_info(). Autoindex for"
NSQ_SOURCE_LINE 00000290 "primary key is not listed using table_info(), but this function adds it by"
NSQ_SOURCE_LINE 00000291 "looking at `sqlite_master` table."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "MySQL notes: information is retrieved from statistics_info(). Note that a"
NSQ_SOURCE_LINE 00000294 "multi-column index is reported as separate rows by statistics_info(), one for"
NSQ_SOURCE_LINE 00000295 "each indexed column. But this function merges them and returns the list of"
NSQ_SOURCE_LINE 00000296 "columns in `columns`."
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "_"
NSQ_SOURCE_LINE 00000299 "    args => {"
NSQ_SOURCE_LINE 00000300 "        %arg0_dbh,"
NSQ_SOURCE_LINE 00000301 "        %arg1_table,"
NSQ_SOURCE_LINE 00000302 "    },"
NSQ_SOURCE_LINE 00000303 "    args_as => \"array\","
NSQ_SOURCE_LINE 00000304 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000305 "};"
NSQ_SOURCE_LINE 00000306 "sub list_indexes {"
NSQ_SOURCE_LINE 00000307 "    my ($dbh, $wanted_table) = @_;"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "    my $driver = $dbh->{Driver}{Name};"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "    my @res;"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "    if ($driver eq 'SQLite') {"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "        my @wanted_tables;"
NSQ_SOURCE_LINE 00000316 "        if (defined $wanted_table) {"
NSQ_SOURCE_LINE 00000317 "            @wanted_tables = ($wanted_table);"
NSQ_SOURCE_LINE 00000318 "        } else {"
NSQ_SOURCE_LINE 00000319 "            @wanted_tables = list_tables($dbh);"
NSQ_SOURCE_LINE 00000320 "        }"
NSQ_SOURCE_LINE 00000321 "        for (@wanted_tables) { $_ = $1 if /.+\\.(.+)/ }"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "        my $sth = $dbh->prepare(\"SELECT * FROM sqlite_master\");"
NSQ_SOURCE_LINE 00000324 "        $sth->execute;"
NSQ_SOURCE_LINE 00000325 "        while (my $row = $sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000326 "            next unless $row->{type} eq 'index';"
NSQ_SOURCE_LINE 00000327 "            next unless grep { $_ eq $row->{tbl_name} } @wanted_tables;"
NSQ_SOURCE_LINE 00000328 "            next unless $row->{name} =~ /\\Asqlite_autoindex_.+_(\\d+)\\z/;"
NSQ_SOURCE_LINE 00000329 "            my $col_num = $1;"
NSQ_SOURCE_LINE 00000330 "            my @cols = list_columns($dbh, $row->{tbl_name});"
NSQ_SOURCE_LINE 00000331 "            push @res, {"
NSQ_SOURCE_LINE 00000332 "                name      => \"PRIMARY\","
NSQ_SOURCE_LINE 00000333 "                table     => $row->{tbl_name},"
NSQ_SOURCE_LINE 00000334 "                columns   => [$cols[$col_num-1]{COLUMN_NAME}],"
NSQ_SOURCE_LINE 00000335 "                is_unique => 1,"
NSQ_SOURCE_LINE 00000336 "                is_pk     => 1,"
NSQ_SOURCE_LINE 00000337 "            };"
NSQ_SOURCE_LINE 00000338 "        }"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "        $sth = $dbh->table_info(undef, undef, undef, undef);"
NSQ_SOURCE_LINE 00000341 "      ROW:"
NSQ_SOURCE_LINE 00000342 "        while (my $row = $sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000343 "            next unless $row->{TABLE_TYPE} eq 'INDEX';"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "            my $table = $row->{TABLE_NAME};"
NSQ_SOURCE_LINE 00000346 "            my $schem = $row->{TABLE_SCHEM};"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "            # match table name"
NSQ_SOURCE_LINE 00000349 "            if (defined $wanted_table) {"
NSQ_SOURCE_LINE 00000350 "                if ($wanted_table =~ /(.+)\\.(.+)/) {"
NSQ_SOURCE_LINE 00000351 "                    next unless $schem eq $1 && $table eq $2;"
NSQ_SOURCE_LINE 00000352 "                } else {"
NSQ_SOURCE_LINE 00000353 "                    next unless $table eq $wanted_table;"
NSQ_SOURCE_LINE 00000354 "                }"
NSQ_SOURCE_LINE 00000355 "            }"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "            next unless my $sql = $row->{sqlite_sql};"
NSQ_SOURCE_LINE 00000358 "            #use DD; dd $row;"
NSQ_SOURCE_LINE 00000359 "            $sql =~ s/\\A\\s*CREATE\\s+(UNIQUE\\s+)?INDEX\\s+//is or do {"
NSQ_SOURCE_LINE 00000360 "                log_trace \"Not a CREATE INDEX statement, skipped: $row->{sqlite_sql}\";"
NSQ_SOURCE_LINE 00000361 "                next ROW;"
NSQ_SOURCE_LINE 00000362 "            };"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "            $row->{is_unique} = $1 ? 1:0; # not-standard, backward compat"
NSQ_SOURCE_LINE 00000365 "            $row->{NON_UNIQUE} = $1 ? 0:1;"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "            $sql =~ s/\\A(\\S+)\\s+//s"
NSQ_SOURCE_LINE 00000368 "                or die \"Can't extract index name from sqlite_sql: $sql\";"
NSQ_SOURCE_LINE 00000369 "            $row->{name} = $1; # non-standard, backward compat"
NSQ_SOURCE_LINE 00000370 "            $row->{INDEX_NAME} = $1;"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "            $sql =~ s/\\AON\\s*(\\S+)\\s*\\(\\s*(.+)\\s*\\)//s"
NSQ_SOURCE_LINE 00000373 "                or die \"Can't extract indexed table+columns from sqlite_sql: $sql\";"
NSQ_SOURCE_LINE 00000374 "            $row->{table} = $table // $1; # non-standard, backward-compat"
NSQ_SOURCE_LINE 00000375 "            $row->{columns} = [split /\\s*,\\s*/, $2]; # non-standard"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "            push @res, $row;"
NSQ_SOURCE_LINE 00000378 "        } # while row"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    } elsif ($driver eq 'mysql') {"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "        my $sth = $dbh->statistics_info(undef, undef, undef, undef, undef);"
NSQ_SOURCE_LINE 00000383 "        $sth->execute;"
NSQ_SOURCE_LINE 00000384 "        my @res0;"
NSQ_SOURCE_LINE 00000385 "        while (my $row = $sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000386 "            if (defined $wanted_table) {"
NSQ_SOURCE_LINE 00000387 "                if ($wanted_table =~ /(.+)\\.(.+)/) {"
NSQ_SOURCE_LINE 00000388 "                    next unless $row->{TABLE_SCHEM} eq $1 && $row->{TABLE_NAME} eq $2;"
NSQ_SOURCE_LINE 00000389 "                } else {"
NSQ_SOURCE_LINE 00000390 "                    next unless $row->{TABLE_NAME} eq $wanted_table;"
NSQ_SOURCE_LINE 00000391 "                }"
NSQ_SOURCE_LINE 00000392 "            }"
NSQ_SOURCE_LINE 00000393 "            $row->{table} = $row->{TABLE_NAME}; # non-standard, backward-compat"
NSQ_SOURCE_LINE 00000394 "            $row->{name} = $row->{INDEX_NAME}; # non-standard, backward-compat"
NSQ_SOURCE_LINE 00000395 "            $row->{is_unique} = $row->{NON_UNIQUE} ? 0:1; # non-standard, backward-compat"
NSQ_SOURCE_LINE 00000396 "            $row->{is_pk} = $row->{INDEX_NAME} eq 'PRIMARY' ? 1:0; # non-standard, backward-compat"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "            push @res0, $row;"
NSQ_SOURCE_LINE 00000399 "        }"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "        # merge separated per-indexed-column result into a single all-columns"
NSQ_SOURCE_LINE 00000402 "        # result"
NSQ_SOURCE_LINE 00000403 "        my @index_names;"
NSQ_SOURCE_LINE 00000404 "        for my $row (@res0) { push @index_names, $row->{INDEX_NAME} unless grep { $row->{INDEX_NAME} eq $_ } @index_names }"
NSQ_SOURCE_LINE 00000405 "        for my $index_name (@index_names) {"
NSQ_SOURCE_LINE 00000406 "            my @hashes = grep { $_->{INDEX_NAME} eq $index_name } @res0;"
NSQ_SOURCE_LINE 00000407 "            if (@hashes == 1) {"
NSQ_SOURCE_LINE 00000408 "                push @res, $hashes[0];"
NSQ_SOURCE_LINE 00000409 "            } else {"
NSQ_SOURCE_LINE 00000410 "                my %merged_hash;"
NSQ_SOURCE_LINE 00000411 "                $merged_hash{columns} = [];"
NSQ_SOURCE_LINE 00000412 "                for my $hash (@hashes) {"
NSQ_SOURCE_LINE 00000413 "                    $merged_hash{columns}[ $hash->{ORDINAL_POSITION}-1 ] = $hash->{COLUMN_NAME};"
NSQ_SOURCE_LINE 00000414 "                    for (keys %$hash) { $merged_hash{$_} = $hash->{$_} }"
NSQ_SOURCE_LINE 00000415 "                }"
NSQ_SOURCE_LINE 00000416 "                delete $merged_hash{ORDINAL_POSITION};"
NSQ_SOURCE_LINE 00000417 "                push @res, \\%merged_hash;"
NSQ_SOURCE_LINE 00000418 "            }"
NSQ_SOURCE_LINE 00000419 "        }"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "    } else {"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "        die \"Driver $driver is not yet supported for list_indexes\";"
NSQ_SOURCE_LINE 00000424 "    }"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "    @res;"
NSQ_SOURCE_LINE 00000427 "}"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "$SPEC{list_columns} = {"
NSQ_SOURCE_LINE 00000430 "    v => 1.1,"
NSQ_SOURCE_LINE 00000431 "    summary => 'List columns of a table',"
NSQ_SOURCE_LINE 00000432 "    args => {"
NSQ_SOURCE_LINE 00000433 "        %arg0_dbh,"
NSQ_SOURCE_LINE 00000434 "        %arg1_table,"
NSQ_SOURCE_LINE 00000435 "    },"
NSQ_SOURCE_LINE 00000436 "    args_as => \"array\","
NSQ_SOURCE_LINE 00000437 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000438 "};"
NSQ_SOURCE_LINE 00000439 "sub list_columns {"
NSQ_SOURCE_LINE 00000440 "    my ($dbh, $table) = @_;"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "    my @res;"
NSQ_SOURCE_LINE 00000443 "    my ($schema, $utable);"
NSQ_SOURCE_LINE 00000444 "    if ($table =~ /\\./) {"
NSQ_SOURCE_LINE 00000445 "        ($schema, $utable) = split /\\./, $table;"
NSQ_SOURCE_LINE 00000446 "    } else {"
NSQ_SOURCE_LINE 00000447 "        $schema = undef;"
NSQ_SOURCE_LINE 00000448 "        $utable = $table;"
NSQ_SOURCE_LINE 00000449 "    }"
NSQ_SOURCE_LINE 00000450 "    my $sth = $dbh->column_info(undef, $schema, $utable, undef);"
NSQ_SOURCE_LINE 00000451 "    while (my $row = $sth->fetchrow_hashref) {"
NSQ_SOURCE_LINE 00000452 "        push @res, $row;"
NSQ_SOURCE_LINE 00000453 "    }"
NSQ_SOURCE_LINE 00000454 "    sort @res;"
NSQ_SOURCE_LINE 00000455 "}"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "1;"
NSQ_SOURCE_LINE 00000458 "# ABSTRACT: Utility routines related to database schema"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "__END__"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "=pod"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "=head1 NAME"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "DBIx::Util::Schema - Utility routines related to database schema"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "=head1 VERSION"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "This document describes version 0.002 of DBIx::Util::Schema (from Perl distribution DBIx-Util-Schema), released on 2020-05-06."
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 " use DBIx::Util::Schema qw("
NSQ_SOURCE_LINE 00000477 "     table_exists"
NSQ_SOURCE_LINE 00000478 "     column_exists"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "     list_tables"
NSQ_SOURCE_LINE 00000481 "     list_columns"
NSQ_SOURCE_LINE 00000482 "     list_indexes"
NSQ_SOURCE_LINE 00000483 " );"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 " say \"Database has table named 'foo'\" if table_exists($dbh, \"foo\");"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "L<DBI> already provides methods to query schema information, e.g."
NSQ_SOURCE_LINE 00000490 "C<table_info()>, C<column_info()>, C<statistics_info()>, but simple things like"
NSQ_SOURCE_LINE 00000491 "checking whether a table or a column exists is not straightforward or easy"
NSQ_SOURCE_LINE 00000492 "enough. This module provides convenience routines for those tasks."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "Currently only tested on SQLite, MySQL, and Postgres."
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 ""
