NSQ_SOURCE_LINE 00000302 "package YAML::PP::Preserve::Array;"
NSQ_SOURCE_LINE 00000303 "# experimental"
NSQ_SOURCE_LINE 00000304 "use Tie::Array;"
NSQ_SOURCE_LINE 00000305 "use base qw/ Tie::StdArray /;"
NSQ_SOURCE_LINE 00000306 "use Scalar::Util qw/ reftype blessed /;"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "sub TIEARRAY {"
NSQ_SOURCE_LINE 00000309 "    my ($class, @items) = @_;"
NSQ_SOURCE_LINE 00000310 "    my $self = bless {"
NSQ_SOURCE_LINE 00000311 "        data => [@items],"
