NSQ_SOURCE_LINE 00000314 "}"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "sub FETCH {"
NSQ_SOURCE_LINE 00000317 "    my ($self, $i) = @_;"
NSQ_SOURCE_LINE 00000318 "    return $self->{data}->[ $i ];"
NSQ_SOURCE_LINE 00000319 "}"
NSQ_SOURCE_LINE 00000320 "sub FETCHSIZE {"
NSQ_SOURCE_LINE 00000321 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000322 "    return $#{ $self->{data} } + 1;"
