NSQ_SOURCE_LINE 00000228 "package YAML::PP::Preserve::Hash;"
NSQ_SOURCE_LINE 00000229 "# experimental"
NSQ_SOURCE_LINE 00000230 "use Tie::Hash;"
NSQ_SOURCE_LINE 00000231 "use base qw/ Tie::StdHash /;"
NSQ_SOURCE_LINE 00000232 "use Scalar::Util qw/ reftype blessed /;"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "sub TIEHASH {"
NSQ_SOURCE_LINE 00000235 "    my ($class, %args) = @_;"
NSQ_SOURCE_LINE 00000236 "    my $self = bless {"
NSQ_SOURCE_LINE 00000237 "        keys => [keys %args],"
NSQ_SOURCE_LINE 00000238 "        data => { %args },"
NSQ_SOURCE_LINE 00000239 "    }, $class;"
NSQ_SOURCE_LINE 00000240 "}"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "sub STORE {"
NSQ_SOURCE_LINE 00000243 "    my ($self, $key, $val) = @_;"
NSQ_SOURCE_LINE 00000244 "    my $keys = $self->{keys};"
NSQ_SOURCE_LINE 00000245 "    unless (exists $self->{data}->{ $key }) {"
NSQ_SOURCE_LINE 00000246 "        push @$keys, $key;"
NSQ_SOURCE_LINE 00000247 "    }"
NSQ_SOURCE_LINE 00000248 "    if (ref $val and not blessed($val)) {"
NSQ_SOURCE_LINE 00000249 "        if (reftype($val) eq 'HASH' and not tied %$val) {"
NSQ_SOURCE_LINE 00000250 "            tie %$val, 'YAML::PP::Preserve::Hash', %$val;"
NSQ_SOURCE_LINE 00000251 "        }"
NSQ_SOURCE_LINE 00000252 "        elsif (reftype($val) eq 'ARRAY' and not tied @$val) {"
NSQ_SOURCE_LINE 00000253 "            tie @$val, 'YAML::PP::Preserve::Array', @$val;"
NSQ_SOURCE_LINE 00000254 "        }"
NSQ_SOURCE_LINE 00000255 "    }"
NSQ_SOURCE_LINE 00000256 "    $self->{data}->{ $key } = $val;"
NSQ_SOURCE_LINE 00000257 "}"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "sub FIRSTKEY {"
NSQ_SOURCE_LINE 00000260 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000261 "    return $self->{keys}->[0];"
NSQ_SOURCE_LINE 00000262 "}"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "sub NEXTKEY {"
NSQ_SOURCE_LINE 00000265 "    my ($self, $last) = @_;"
NSQ_SOURCE_LINE 00000266 "    my $keys = $self->{keys};"
NSQ_SOURCE_LINE 00000267 "    for my $i (0 .. $#$keys) {"
NSQ_SOURCE_LINE 00000268 "        if (\"$keys->[ $i ]\" eq \"$last\") {"
NSQ_SOURCE_LINE 00000269 "            return $keys->[ $i + 1 ];"
NSQ_SOURCE_LINE 00000270 "        }"
NSQ_SOURCE_LINE 00000271 "    }"
NSQ_SOURCE_LINE 00000272 "    return;"
NSQ_SOURCE_LINE 00000273 "}"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "sub FETCH {"
NSQ_SOURCE_LINE 00000276 "    my ($self, $key) = @_;"
NSQ_SOURCE_LINE 00000277 "    my $val = $self->{data}->{ $key };"
NSQ_SOURCE_LINE 00000278 "}"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "sub DELETE {"
NSQ_SOURCE_LINE 00000281 "    my ($self, $key) = @_;"
NSQ_SOURCE_LINE 00000282 "    @{ $self->{keys} } = grep { \"$_\" ne \"$key\" } @{ $self->{keys} };"
NSQ_SOURCE_LINE 00000283 "    delete $self->{data}->{ $key };"
NSQ_SOURCE_LINE 00000284 "}"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "sub EXISTS {"
NSQ_SOURCE_LINE 00000287 "    my ($self, $key) = @_;"
NSQ_SOURCE_LINE 00000288 "    return exists $self->{data}->{ $key };"
NSQ_SOURCE_LINE 00000289 "}"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "sub CLEAR {"
NSQ_SOURCE_LINE 00000292 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000293 "    $self->{keys} = [];"
NSQ_SOURCE_LINE 00000294 "    $self->{data} = {};"
NSQ_SOURCE_LINE 00000295 "}"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "sub SCALAR {"
NSQ_SOURCE_LINE 00000298 "    my ($self) = @_;"
