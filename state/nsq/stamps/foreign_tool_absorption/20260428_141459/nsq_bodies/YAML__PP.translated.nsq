NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw/ Load LoadFile Dump DumpFile /;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "my %YAML_VERSIONS = ('1.1' => 1, '1.2' => 1);"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub new {"
NSQ_SOURCE_LINE 00000022 "    my ($class, %args) = @_;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    my $bool = delete $args{boolean};"
NSQ_SOURCE_LINE 00000025 "    $bool = 'perl' unless defined $bool;"
NSQ_SOURCE_LINE 00000026 "    my $schemas = delete $args{schema} || ['+'];"
NSQ_SOURCE_LINE 00000027 "    my $cyclic_refs = delete $args{cyclic_refs} || 'fatal';"
NSQ_SOURCE_LINE 00000028 "    my $indent = delete $args{indent};"
NSQ_SOURCE_LINE 00000029 "    my $width = delete $args{width};"
NSQ_SOURCE_LINE 00000030 "    my $writer = delete $args{writer};"
NSQ_SOURCE_LINE 00000031 "    my $header = delete $args{header};"
NSQ_SOURCE_LINE 00000032 "    my $footer = delete $args{footer};"
NSQ_SOURCE_LINE 00000033 "    my $require_footer = delete $args{require_footer};"
NSQ_SOURCE_LINE 00000034 "    my $duplicate_keys = delete $args{duplicate_keys};"
NSQ_SOURCE_LINE 00000035 "    my $max_depth = delete $args{max_depth};"
NSQ_SOURCE_LINE 00000036 "    my $yaml_version = $class->_arg_yaml_version(delete $args{yaml_version});"
NSQ_SOURCE_LINE 00000037 "    my $default_yaml_version = $yaml_version->[0];"
NSQ_SOURCE_LINE 00000038 "    my $version_directive = delete $args{version_directive};"
NSQ_SOURCE_LINE 00000039 "    my $preserve = delete $args{preserve};"
NSQ_SOURCE_LINE 00000040 "    my $parser = delete $args{parser};"
NSQ_SOURCE_LINE 00000041 "    my $emitter = delete $args{emitter} || {"
NSQ_SOURCE_LINE 00000042 "        indent => $indent,"
NSQ_SOURCE_LINE 00000043 "        width => $width,"
NSQ_SOURCE_LINE 00000044 "        writer => $writer,"
NSQ_SOURCE_LINE 00000045 "    };"
NSQ_SOURCE_LINE 00000046 "    if (keys %args) {"
NSQ_SOURCE_LINE 00000047 "        die \"Unexpected arguments: \" . join ', ', sort keys %args;"
NSQ_SOURCE_LINE 00000048 "    }"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    my %schemas;"
NSQ_SOURCE_LINE 00000051 "    for my $v (@$yaml_version) {"
NSQ_SOURCE_LINE 00000052 "        my $schema;"
NSQ_SOURCE_LINE 00000053 "        if (blessed($schemas) and $schemas->isa('YAML::PP::Schema')) {"
NSQ_SOURCE_LINE 00000054 "            $schema = $schemas;"
NSQ_SOURCE_LINE 00000055 "        }"
NSQ_SOURCE_LINE 00000056 "        else {"
NSQ_SOURCE_LINE 00000057 "            $schema = YAML::PP::Schema->new("
NSQ_SOURCE_LINE 00000058 "                boolean => $bool,"
NSQ_SOURCE_LINE 00000059 "                yaml_version => $v,"
NSQ_SOURCE_LINE 00000060 "            );"
NSQ_SOURCE_LINE 00000061 "            $schema->load_subschemas(@$schemas);"
NSQ_SOURCE_LINE 00000062 "        }"
NSQ_SOURCE_LINE 00000063 "        $schemas{ $v } = $schema;"
NSQ_SOURCE_LINE 00000064 "    }"
NSQ_SOURCE_LINE 00000065 "    my $default_schema = $schemas{ $default_yaml_version };"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "    my $loader = YAML::PP::Loader->new("
NSQ_SOURCE_LINE 00000068 "        schemas => \\%schemas,"
NSQ_SOURCE_LINE 00000069 "        cyclic_refs => $cyclic_refs,"
NSQ_SOURCE_LINE 00000070 "        parser => $parser,"
NSQ_SOURCE_LINE 00000071 "        default_yaml_version => $default_yaml_version,"
NSQ_SOURCE_LINE 00000072 "        preserve => $preserve,"
NSQ_SOURCE_LINE 00000073 "        duplicate_keys => $duplicate_keys,"
NSQ_SOURCE_LINE 00000074 "        require_footer => $require_footer,"
NSQ_SOURCE_LINE 00000075 "        max_depth => $max_depth,"
NSQ_SOURCE_LINE 00000076 "    );"
NSQ_SOURCE_LINE 00000077 "    my $dumper = YAML::PP::Dumper->new("
NSQ_SOURCE_LINE 00000078 "        schema => $default_schema,"
NSQ_SOURCE_LINE 00000079 "        emitter => $emitter,"
NSQ_SOURCE_LINE 00000080 "        header => $header,"
NSQ_SOURCE_LINE 00000081 "        footer => $footer,"
NSQ_SOURCE_LINE 00000082 "        version_directive => $version_directive,"
NSQ_SOURCE_LINE 00000083 "        preserve => $preserve,"
NSQ_SOURCE_LINE 00000084 "    );"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    my $self = bless {"
NSQ_SOURCE_LINE 00000087 "        schema => \\%schemas,"
NSQ_SOURCE_LINE 00000088 "        loader => $loader,"
NSQ_SOURCE_LINE 00000089 "        dumper => $dumper,"
NSQ_SOURCE_LINE 00000090 "    }, $class;"
NSQ_SOURCE_LINE 00000091 "    return $self;"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "sub clone {"
NSQ_SOURCE_LINE 00000095 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000096 "    my $clone = {"
NSQ_SOURCE_LINE 00000097 "        schema => $self->schema,"
NSQ_SOURCE_LINE 00000098 "        loader => $self->loader->clone,"
NSQ_SOURCE_LINE 00000099 "        dumper => $self->dumper->clone,"
NSQ_SOURCE_LINE 00000100 "    };"
NSQ_SOURCE_LINE 00000101 "    return bless $clone, ref $self;"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub _arg_yaml_version {"
NSQ_SOURCE_LINE 00000105 "    my ($class, $version) = @_;"
NSQ_SOURCE_LINE 00000106 "    my @versions = ('1.2');"
NSQ_SOURCE_LINE 00000107 "    if (defined $version) {"
NSQ_SOURCE_LINE 00000108 "        @versions = ();"
NSQ_SOURCE_LINE 00000109 "        if (not ref $version) {"
NSQ_SOURCE_LINE 00000110 "            $version = [$version];"
NSQ_SOURCE_LINE 00000111 "        }"
NSQ_SOURCE_LINE 00000112 "        for my $v (@$version) {"
NSQ_SOURCE_LINE 00000113 "            unless ($YAML_VERSIONS{ $v }) {"
NSQ_SOURCE_LINE 00000114 "                croak \"YAML Version '$v' not supported\";"
NSQ_SOURCE_LINE 00000115 "            }"
NSQ_SOURCE_LINE 00000116 "            push @versions, $v;"
NSQ_SOURCE_LINE 00000117 "        }"
NSQ_SOURCE_LINE 00000118 "    }"
NSQ_SOURCE_LINE 00000119 "    return \\@versions;"
NSQ_SOURCE_LINE 00000120 "}"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 ""
