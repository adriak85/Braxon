NSQ_SOURCE_LINE 00000124 "    if (@_ > 1) {"
NSQ_SOURCE_LINE 00000125 "        $_[0]->{loader} = $_[1]"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 "    return $_[0]->{loader};"
NSQ_SOURCE_LINE 00000128 "}"
NSQ_SOURCE_LINE 00000129 ""
