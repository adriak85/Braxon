NSQ_SOURCE_LINE 00000206 "sub preserved_mapping {"
NSQ_SOURCE_LINE 00000207 "    my ($self, $hash, %args) = @_;"
NSQ_SOURCE_LINE 00000208 "    my $data = {};"
NSQ_SOURCE_LINE 00000209 "    tie %$data, 'YAML::PP::Preserve::Hash';"
NSQ_SOURCE_LINE 00000210 "    %$data = %$hash;"
NSQ_SOURCE_LINE 00000211 "    my $t = tied %$data;"
NSQ_SOURCE_LINE 00000212 "    $t->{style} = $args{style};"
NSQ_SOURCE_LINE 00000213 "    $t->{alias} = $args{alias};"
NSQ_SOURCE_LINE 00000214 "    return $data;"
NSQ_SOURCE_LINE 00000215 "}"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "sub preserved_sequence {"
NSQ_SOURCE_LINE 00000218 "    my ($self, $array, %args) = @_;"
NSQ_SOURCE_LINE 00000219 "    my $data = [];"
NSQ_SOURCE_LINE 00000220 "    tie @$data, 'YAML::PP::Preserve::Array';"
NSQ_SOURCE_LINE 00000221 "    push @$data, @$array;"
NSQ_SOURCE_LINE 00000222 "    my $t = tied @$data;"
NSQ_SOURCE_LINE 00000223 "    $t->{style} = $args{style};"
NSQ_SOURCE_LINE 00000224 "    $t->{alias} = $args{alias};"
