NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "sub _preserve {"
NSQ_SOURCE_LINE 00000326 "    my ($val) = @_;"
NSQ_SOURCE_LINE 00000327 "    if (ref $val and not blessed($val)) {"
NSQ_SOURCE_LINE 00000328 "        if (reftype($val) eq 'HASH' and not tied %$val) {"
NSQ_SOURCE_LINE 00000329 "            tie %$val, 'YAML::PP::Preserve::Hash', %$val;"
NSQ_SOURCE_LINE 00000330 "        }"
NSQ_SOURCE_LINE 00000331 "        elsif (reftype($val) eq 'ARRAY' and not tied @$val) {"
NSQ_SOURCE_LINE 00000332 "            tie @$val, 'YAML::PP::Preserve::Array', @$val;"
NSQ_SOURCE_LINE 00000333 "        }"
NSQ_SOURCE_LINE 00000334 "    }"
NSQ_SOURCE_LINE 00000335 "    return $val;"
NSQ_SOURCE_LINE 00000336 "}"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "sub STORE {"
NSQ_SOURCE_LINE 00000339 "    my ($self, $i, $val) = @_;"
NSQ_SOURCE_LINE 00000340 "    _preserve($val);"
NSQ_SOURCE_LINE 00000341 "    $self->{data}->[ $i ] = $val;"
NSQ_SOURCE_LINE 00000342 "}"
NSQ_SOURCE_LINE 00000343 "sub PUSH {"
NSQ_SOURCE_LINE 00000344 "    my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00000345 "    push @{ $self->{data} }, map { _preserve $_ } @args;"
NSQ_SOURCE_LINE 00000346 "}"
NSQ_SOURCE_LINE 00000347 "sub STORESIZE {"
NSQ_SOURCE_LINE 00000348 "    my ($self, $i) = @_;"
NSQ_SOURCE_LINE 00000349 "    $#{ $self->{data} } = $i - 1;"
NSQ_SOURCE_LINE 00000350 "}"
NSQ_SOURCE_LINE 00000351 "sub DELETE {"
NSQ_SOURCE_LINE 00000352 "    my ($self, $i) = @_;"
NSQ_SOURCE_LINE 00000353 "    delete $self->{data}->[ $i ];"
NSQ_SOURCE_LINE 00000354 "}"
NSQ_SOURCE_LINE 00000355 "sub EXISTS {"
NSQ_SOURCE_LINE 00000356 "    my ($self, $i) = @_;"
NSQ_SOURCE_LINE 00000357 "    return exists $self->{data}->[ $i ];"
NSQ_SOURCE_LINE 00000358 "}"
NSQ_SOURCE_LINE 00000359 "sub CLEAR {"
NSQ_SOURCE_LINE 00000360 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000361 "    $self->{data} = [];"
NSQ_SOURCE_LINE 00000362 "}"
NSQ_SOURCE_LINE 00000363 "sub SHIFT {"
NSQ_SOURCE_LINE 00000364 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000365 "    shift @{ $self->{data} };"
NSQ_SOURCE_LINE 00000366 "}"
NSQ_SOURCE_LINE 00000367 "sub UNSHIFT {"
NSQ_SOURCE_LINE 00000368 "    my ($self, @args) = @_;"
NSQ_SOURCE_LINE 00000369 "    unshift @{ $self->{data} }, map { _preserve $_ } @args;"
NSQ_SOURCE_LINE 00000370 "}"
NSQ_SOURCE_LINE 00000371 "sub SPLICE {"
NSQ_SOURCE_LINE 00000372 "    my ($self, $offset, $length, @args) = @_;"
NSQ_SOURCE_LINE 00000373 "    splice @{ $self->{data} }, $offset, $length, map { _preserve $_ } @args;"
NSQ_SOURCE_LINE 00000374 "}"
NSQ_SOURCE_LINE 00000375 "sub EXTEND {}"
