NSQ_SOURCE_LINE 00000003 "package Text::SimpleTable;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '2.07';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our %ASCII_BOX = ("
NSQ_SOURCE_LINE 00000011 "\t# Top"
NSQ_SOURCE_LINE 00000012 "\tTOP_LEFT      => '.-',"
NSQ_SOURCE_LINE 00000013 "\tTOP_BORDER    => '-',"
NSQ_SOURCE_LINE 00000014 "\tTOP_SEPARATOR => '-+-',"
NSQ_SOURCE_LINE 00000015 "\tTOP_RIGHT     => '-.',"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "\t# Middle"
NSQ_SOURCE_LINE 00000018 "\tMIDDLE_LEFT      => '+-',"
NSQ_SOURCE_LINE 00000019 "\tMIDDLE_BORDER    => '-',"
NSQ_SOURCE_LINE 00000020 "\tMIDDLE_SEPARATOR => '-+-',"
NSQ_SOURCE_LINE 00000021 "\tMIDDLE_RIGHT     => '-+',"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "\t# Left"
NSQ_SOURCE_LINE 00000024 "\tLEFT_BORDER  => '| ',"
NSQ_SOURCE_LINE 00000025 "\tSEPARATOR    => ' | ',"
NSQ_SOURCE_LINE 00000026 "\tRIGHT_BORDER => ' |',"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "\t# Bottom"
NSQ_SOURCE_LINE 00000029 "\tBOTTOM_LEFT      => \"'-\","
NSQ_SOURCE_LINE 00000030 "\tBOTTOM_SEPARATOR => \"-+-\","
NSQ_SOURCE_LINE 00000031 "\tBOTTOM_BORDER    => '-',"
NSQ_SOURCE_LINE 00000032 "\tBOTTOM_RIGHT     => \"-'\","
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "\t# Wrapper"
NSQ_SOURCE_LINE 00000035 "\tWRAP => '-',"
NSQ_SOURCE_LINE 00000036 ");"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "our %UTF_BOX = ("
NSQ_SOURCE_LINE 00000039 "\t# Top"
NSQ_SOURCE_LINE 00000040 "\tTOP_LEFT      => \"\\x{250c}\\x{2500}\","
NSQ_SOURCE_LINE 00000041 "\tTOP_BORDER    => \"\\x{2500}\","
NSQ_SOURCE_LINE 00000042 "\tTOP_SEPARATOR => \"\\x{2500}\\x{252c}\\x{2500}\","
NSQ_SOURCE_LINE 00000043 "\tTOP_RIGHT     => \"\\x{2500}\\x{2510}\","
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "\t# Middle"
NSQ_SOURCE_LINE 00000046 "\tMIDDLE_LEFT      => \"\\x{251c}\\x{2500}\","
NSQ_SOURCE_LINE 00000047 "\tMIDDLE_BORDER    => \"\\x{2500}\","
NSQ_SOURCE_LINE 00000048 "\tMIDDLE_SEPARATOR => \"\\x{2500}\\x{253c}\\x{2500}\","
NSQ_SOURCE_LINE 00000049 "\tMIDDLE_RIGHT     => \"\\x{2500}\\x{2524}\","
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "\t# Left"
NSQ_SOURCE_LINE 00000052 "\tLEFT_BORDER  => \"\\x{2502} \","
NSQ_SOURCE_LINE 00000053 "\tSEPARATOR    => \" \\x{2502} \","
NSQ_SOURCE_LINE 00000054 "\tRIGHT_BORDER => \" \\x{2502}\","
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "\t# Bottom"
NSQ_SOURCE_LINE 00000057 "\tBOTTOM_LEFT      => \"\\x{2514}\\x{2500}\","
NSQ_SOURCE_LINE 00000058 "\tBOTTOM_SEPARATOR => \"\\x{2500}\\x{2534}\\x{2500}\","
NSQ_SOURCE_LINE 00000059 "\tBOTTOM_BORDER    => \"\\x{2500}\","
NSQ_SOURCE_LINE 00000060 "\tBOTTOM_RIGHT     => \"\\x{2500}\\x{2518}\","
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "\t# Wrapper"
NSQ_SOURCE_LINE 00000063 "\tWRAP => '-',"
NSQ_SOURCE_LINE 00000064 ");"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "sub new {"
NSQ_SOURCE_LINE 00000067 "    my ($class, @args) = @_;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    # Instantiate"
NSQ_SOURCE_LINE 00000070 "    $class = ref $class || $class;"
NSQ_SOURCE_LINE 00000071 "    my $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "    $self->{chs} = \\%ASCII_BOX;"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    # Columns and titles"
NSQ_SOURCE_LINE 00000076 "    my $cache = [];"
NSQ_SOURCE_LINE 00000077 "    my $max   = 0;"
NSQ_SOURCE_LINE 00000078 "    for my $arg (@args) {"
NSQ_SOURCE_LINE 00000079 "        my $width;"
NSQ_SOURCE_LINE 00000080 "        my $name;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "        if (ref $arg) {"
NSQ_SOURCE_LINE 00000083 "            $width = $arg->[0];"
NSQ_SOURCE_LINE 00000084 "            $name  = $arg->[1];"
NSQ_SOURCE_LINE 00000085 "        }"
NSQ_SOURCE_LINE 00000086 "        else { $width = $arg }"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "        # Fix size"
NSQ_SOURCE_LINE 00000089 "        $width = 2 if $width < 2;"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "        # Wrap"
NSQ_SOURCE_LINE 00000092 "        my $title = $name ? $self->_wrap($name, $width) : [];"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "        # Column"
NSQ_SOURCE_LINE 00000095 "        my $col = [$width, [], $title];"
NSQ_SOURCE_LINE 00000096 "        $max = @{$col->[2]} if $max < @{$col->[2]};"
NSQ_SOURCE_LINE 00000097 "        push @$cache, $col;"
NSQ_SOURCE_LINE 00000098 "    }"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    # Padding"
NSQ_SOURCE_LINE 00000101 "    for my $col (@$cache) {"
NSQ_SOURCE_LINE 00000102 "        push @{$col->[2]}, '' while @{$col->[2]} < $max;"
NSQ_SOURCE_LINE 00000103 "    }"
NSQ_SOURCE_LINE 00000104 "    $self->{columns} = $cache;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    return $self;"
NSQ_SOURCE_LINE 00000107 "}"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "# The implementation is not very elegant, but gets the job done very well"
NSQ_SOURCE_LINE 00000110 "sub draw {"
NSQ_SOURCE_LINE 00000111 "    my $self = shift;"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "    # Shortcut"
NSQ_SOURCE_LINE 00000114 "    return unless $self->{columns};"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    my $rows    = @{$self->{columns}->[0]->[1]} - 1;"
NSQ_SOURCE_LINE 00000117 "    my $columns = @{$self->{columns}} - 1;"
NSQ_SOURCE_LINE 00000118 "    my $output  = '';"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "    # Top border"
NSQ_SOURCE_LINE 00000121 "    for my $j (0 .. $columns) {"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "        my $column = $self->{columns}->[$j];"
NSQ_SOURCE_LINE 00000124 "        my $width  = $column->[0];"
NSQ_SOURCE_LINE 00000125 "        my $text   = $self->{chs}->{TOP_BORDER} x $width;"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "        if (($j == 0) && ($columns == 0)) {"
NSQ_SOURCE_LINE 00000128 "            $text = \"$self->{chs}->{TOP_LEFT}$text$self->{chs}->{TOP_RIGHT}\";"
NSQ_SOURCE_LINE 00000129 "        }"
NSQ_SOURCE_LINE 00000130 "        elsif ($j == 0)        { $text = \"$self->{chs}->{TOP_LEFT}$text$self->{chs}->{TOP_SEPARATOR}\" }"
NSQ_SOURCE_LINE 00000131 "        elsif ($j == $columns) { $text = \"$text$self->{chs}->{TOP_RIGHT}\" }"
NSQ_SOURCE_LINE 00000132 "        else                   { $text = \"$text$self->{chs}->{TOP_SEPARATOR}\" }"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "        $output .= $text;"
NSQ_SOURCE_LINE 00000135 "    }"
NSQ_SOURCE_LINE 00000136 "    $output .= \"\\n\";"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "    my $title = 0;"
NSQ_SOURCE_LINE 00000139 "    for my $column (@{$self->{columns}}) {"
NSQ_SOURCE_LINE 00000140 "        $title = @{$column->[2]} if $title < @{$column->[2]};"
NSQ_SOURCE_LINE 00000141 "    }"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    if ($title) {"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "        # Titles"
NSQ_SOURCE_LINE 00000146 "        for my $i (0 .. $title - 1) {"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "            for my $j (0 .. $columns) {"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "                my $column = $self->{columns}->[$j];"
NSQ_SOURCE_LINE 00000151 "                my $width  = $column->[0];"
NSQ_SOURCE_LINE 00000152 "                my $text   = $column->[2]->[$i] || '';"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "                $text .= \" \" x ($width - _length($text));"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "                if (($j == 0) && ($columns == 0)) {"
NSQ_SOURCE_LINE 00000157 "                    $text = \"$self->{chs}->{LEFT_BORDER}$text$self->{chs}->{RIGHT_BORDER}\";"
NSQ_SOURCE_LINE 00000158 "                }"
NSQ_SOURCE_LINE 00000159 "                elsif ($j == 0) { $text = \"$self->{chs}->{LEFT_BORDER}$text$self->{chs}->{SEPARATOR}\" }"
NSQ_SOURCE_LINE 00000160 "                elsif ($j == $columns) { $text = \"$text$self->{chs}->{RIGHT_BORDER}\" }"
NSQ_SOURCE_LINE 00000161 "                else                   { $text = \"$text$self->{chs}->{SEPARATOR}\" }"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "                $output .= $text;"
NSQ_SOURCE_LINE 00000164 "            }"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "            $output .= \"\\n\";"
NSQ_SOURCE_LINE 00000167 "        }"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "        # Title separator"
NSQ_SOURCE_LINE 00000170 "        $output .= $self->_draw_hr;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    }"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "    # Rows"
NSQ_SOURCE_LINE 00000175 "    for my $i (0 .. $rows) {"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "        # Check for hr"
NSQ_SOURCE_LINE 00000178 "        if (!grep { defined $self->{columns}->[$_]->[1]->[$i] } 0 .. $columns)"
NSQ_SOURCE_LINE 00000179 "        {"
NSQ_SOURCE_LINE 00000180 "            $output .= $self->_draw_hr;"
NSQ_SOURCE_LINE 00000181 "            next;"
NSQ_SOURCE_LINE 00000182 "        }"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "        for my $j (0 .. $columns) {"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "            my $column = $self->{columns}->[$j];"
NSQ_SOURCE_LINE 00000187 "            my $width  = $column->[0];"
NSQ_SOURCE_LINE 00000188 "            my $text = (defined $column->[1]->[$i]) ? $column->[1]->[$i] : '';"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "            $text .= \" \" x ($width - _length($text));"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "            if (($j == 0) && ($columns == 0)) {"
NSQ_SOURCE_LINE 00000193 "                $text = \"$self->{chs}->{LEFT_BORDER}$text$self->{chs}->{RIGHT_BORDER}\";"
NSQ_SOURCE_LINE 00000194 "            }"
NSQ_SOURCE_LINE 00000195 "            elsif ($j == 0)        { $text = \"$self->{chs}->{LEFT_BORDER}$text$self->{chs}->{SEPARATOR}\" }"
NSQ_SOURCE_LINE 00000196 "            elsif ($j == $columns) { $text = \"$text$self->{chs}->{RIGHT_BORDER}\" }"
NSQ_SOURCE_LINE 00000197 "            else                   { $text = \"$text$self->{chs}->{SEPARATOR}\" }"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "            $output .= $text;"
NSQ_SOURCE_LINE 00000200 "        }"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "        $output .= \"\\n\";"
NSQ_SOURCE_LINE 00000203 "    }"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "    # Bottom border"
NSQ_SOURCE_LINE 00000206 "    for my $j (0 .. $columns) {"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "        my $column = $self->{columns}->[$j];"
NSQ_SOURCE_LINE 00000209 "        my $width  = $column->[0];"
NSQ_SOURCE_LINE 00000210 "        my $text   = $self->{chs}->{BOTTOM_BORDER} x $width;"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "        if (($j == 0) && ($columns == 0)) {"
NSQ_SOURCE_LINE 00000213 "            $text = \"$self->{chs}->{BOTTOM_LEFT}$text$self->{chs}->{BOTTOM_RIGHT}\";"
NSQ_SOURCE_LINE 00000214 "        }"
NSQ_SOURCE_LINE 00000215 "        elsif ($j == 0) { $text = \"$self->{chs}->{BOTTOM_LEFT}$text$self->{chs}->{BOTTOM_SEPARATOR}\" }"
NSQ_SOURCE_LINE 00000216 "        elsif ($j == $columns) { $text = \"$text$self->{chs}->{BOTTOM_RIGHT}\" }"
NSQ_SOURCE_LINE 00000217 "        else                   { $text = \"$text$self->{chs}->{BOTTOM_SEPARATOR}\" }"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "        $output .= $text;"
NSQ_SOURCE_LINE 00000220 "    }"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "    $output .= \"\\n\";"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "    return $output;"
NSQ_SOURCE_LINE 00000225 "}"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "sub boxes {"
NSQ_SOURCE_LINE 00000228 "    my $self = shift;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "    $self->{chs} = \\%UTF_BOX;"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    return $self;"
NSQ_SOURCE_LINE 00000233 "}"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "sub hr {"
NSQ_SOURCE_LINE 00000236 "    my $self = shift;"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "    for (0 .. @{$self->{columns}} - 1) {"
NSQ_SOURCE_LINE 00000239 "        push @{$self->{columns}->[$_]->[1]}, undef;"
NSQ_SOURCE_LINE 00000240 "    }"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "    return $self;"
NSQ_SOURCE_LINE 00000243 "}"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "sub row {"
NSQ_SOURCE_LINE 00000246 "    my ($self, @texts) = @_;"
NSQ_SOURCE_LINE 00000247 "    my $size = @{$self->{columns}} - 1;"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "    # Shortcut"
NSQ_SOURCE_LINE 00000250 "    return $self if $size < 0;"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "    for (1 .. $size) {"
NSQ_SOURCE_LINE 00000253 "        last if $size <= @texts;"
NSQ_SOURCE_LINE 00000254 "        push @texts, '';"
NSQ_SOURCE_LINE 00000255 "    }"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    my $cache = [];"
NSQ_SOURCE_LINE 00000258 "    my $max   = 0;"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "    for my $i (0 .. $size) {"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "        my $text   = shift @texts;"
NSQ_SOURCE_LINE 00000263 "        my $column = $self->{columns}->[$i];"
NSQ_SOURCE_LINE 00000264 "        my $width  = $column->[0];"
NSQ_SOURCE_LINE 00000265 "        my $pieces = $self->_wrap($text, $width);"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "        push @{$cache->[$i]}, @$pieces;"
NSQ_SOURCE_LINE 00000268 "        $max = @$pieces if @$pieces > $max;"
NSQ_SOURCE_LINE 00000269 "    }"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "    for my $col (@{$cache}) { push @{$col}, '' while @{$col} < $max }"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "    for my $i (0 .. $size) {"
NSQ_SOURCE_LINE 00000274 "        my $column = $self->{columns}->[$i];"
NSQ_SOURCE_LINE 00000275 "        my $store  = $column->[1];"
NSQ_SOURCE_LINE 00000276 "        push @{$store}, @{$cache->[$i]};"
NSQ_SOURCE_LINE 00000277 "    }"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "    return $self;"
NSQ_SOURCE_LINE 00000280 "}"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "sub _draw_hr {"
NSQ_SOURCE_LINE 00000283 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000284 "    my $columns = @{$self->{columns}} - 1;"
NSQ_SOURCE_LINE 00000285 "    my $output  = '';"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    for my $j (0 .. $columns) {"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "        my $column = $self->{columns}->[$j];"
NSQ_SOURCE_LINE 00000290 "        my $width  = $column->[0];"
NSQ_SOURCE_LINE 00000291 "        my $text   = $self->{chs}->{MIDDLE_BORDER} x $width;"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "        if (($j == 0) && ($columns == 0)) {"
NSQ_SOURCE_LINE 00000294 "            $text = \"$self->{chs}->{MIDDLE_LEFT}$text$self->{chs}->{MIDDLE_RIGHT}\";"
NSQ_SOURCE_LINE 00000295 "        }"
NSQ_SOURCE_LINE 00000296 "        elsif ($j == 0) { $text = \"$self->{chs}->{MIDDLE_LEFT}$text$self->{chs}->{MIDDLE_SEPARATOR}\" }"
NSQ_SOURCE_LINE 00000297 "        elsif ($j == $columns) { $text = \"$text$self->{chs}->{MIDDLE_RIGHT}\" }"
NSQ_SOURCE_LINE 00000298 "        else                   { $text = \"$text$self->{chs}->{MIDDLE_SEPARATOR}\" }"
NSQ_SOURCE_LINE 00000299 "        $output .= $text;"
NSQ_SOURCE_LINE 00000300 "    }"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "    $output .= \"\\n\";"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "    return $output;"
NSQ_SOURCE_LINE 00000305 "}"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "# Calc display width of utf8 on/off strings"
NSQ_SOURCE_LINE 00000308 "sub _length {"
NSQ_SOURCE_LINE 00000309 "    if (utf8::is_utf8($_[0])) {"
NSQ_SOURCE_LINE 00000310 "        my $code = do {"
NSQ_SOURCE_LINE 00000311 "            local @_;"
NSQ_SOURCE_LINE 00000312 "            if ($Unicode::GCString::VERSION or eval \"require Unicode::GCString; 1\") {"
NSQ_SOURCE_LINE 00000313 "                sub { utf8::is_utf8($_[0]) ? Unicode::GCString->new($_[0])->columns : length $_[0] };"
NSQ_SOURCE_LINE 00000314 "            }"
NSQ_SOURCE_LINE 00000315 "            elsif ($Text::VisualWidth::VERSION or eval \"require Text::VisualWidth::UTF8; 1\") {"
NSQ_SOURCE_LINE 00000316 "                sub { utf8::is_utf8($_[0]) ? Text::VisualWidth::UTF8::width($_[0]) : length $_[0] };"
NSQ_SOURCE_LINE 00000317 "            }"
NSQ_SOURCE_LINE 00000318 "            elsif ($Text::VisualWidth::PP::VERSION or eval \"require Text::VisualWidth::PP; 1\") {"
NSQ_SOURCE_LINE 00000319 "                sub { utf8::is_utf8($_[0]) ? Text::VisualWidth::PP::width($_[0]) : length $_[0] };"
NSQ_SOURCE_LINE 00000320 "            }"
NSQ_SOURCE_LINE 00000321 "            else {"
NSQ_SOURCE_LINE 00000322 "                sub { length $_[0] };"
NSQ_SOURCE_LINE 00000323 "            }"
NSQ_SOURCE_LINE 00000324 "        };"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000327 "        no warnings 'redefine';"
NSQ_SOURCE_LINE 00000328 "        *{\"Text::SimpleTable::_length\"} = $code;"
NSQ_SOURCE_LINE 00000329 "        goto $code;"
NSQ_SOURCE_LINE 00000330 "    }"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "    return length $_[0];"
NSQ_SOURCE_LINE 00000333 "}"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "# Wrap text"
NSQ_SOURCE_LINE 00000336 "sub _wrap {"
NSQ_SOURCE_LINE 00000337 "    my ($self, $text, $width) = @_;"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "    my @cache;"
NSQ_SOURCE_LINE 00000340 "    my @parts = split \"\\n\", $text;"
NSQ_SOURCE_LINE 00000341 "    my $chs_width = _length($self->{chs}->{WRAP});"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "    for my $part (@parts) {"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "        while (_length($part) > $width) {"
NSQ_SOURCE_LINE 00000346 "            my $subtext;"
NSQ_SOURCE_LINE 00000347 "            unless (utf8::is_utf8($part)) {"
NSQ_SOURCE_LINE 00000348 "                $subtext = substr $part, 0, $width - $chs_width, '';"
NSQ_SOURCE_LINE 00000349 "            }"
NSQ_SOURCE_LINE 00000350 "            else {"
NSQ_SOURCE_LINE 00000351 "                my $subtext_width = $width - $chs_width;"
NSQ_SOURCE_LINE 00000352 "                my $substr_len;"
NSQ_SOURCE_LINE 00000353 "                while (($substr_len = _length(substr $part, 0, $subtext_width)) > $width - $chs_width) {"
NSQ_SOURCE_LINE 00000354 "                    --$subtext_width;"
NSQ_SOURCE_LINE 00000355 "                }"
NSQ_SOURCE_LINE 00000356 "                $subtext = substr $part, 0, $subtext_width, '';"
NSQ_SOURCE_LINE 00000357 "            }"
NSQ_SOURCE_LINE 00000358 "            push @cache, \"$subtext$self->{chs}->{WRAP}\";"
NSQ_SOURCE_LINE 00000359 "        }"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "        push @cache, $part if defined $part;"
NSQ_SOURCE_LINE 00000362 "    }"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "    return \\@cache;"
NSQ_SOURCE_LINE 00000365 "}"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "1;"
NSQ_SOURCE_LINE 00000368 "__END__"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=encoding utf8"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=head1 NAME"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "Text::SimpleTable - Simple Eyecandy ASCII Tables"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "    use Text::SimpleTable;"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    my $t1 = Text::SimpleTable->new(5, 10);"
NSQ_SOURCE_LINE 00000381 "    $t1->row('foobarbaz', 'yadayadayada');"
NSQ_SOURCE_LINE 00000382 "    print $t1->draw;"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "    .-------+------------."
NSQ_SOURCE_LINE 00000385 "    | foob- | yadayaday- |"
NSQ_SOURCE_LINE 00000386 "    | arbaz | ada        |"
NSQ_SOURCE_LINE 00000387 "    '-------+------------'"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "    my $t2 = Text::SimpleTable->new([5, 'Foo'], [10, 'Bar']);"
NSQ_SOURCE_LINE 00000390 "    $t2->row('foobarbaz', 'yadayadayada');"
NSQ_SOURCE_LINE 00000391 "    $t2->row('barbarbarbarbar', 'yada');"
NSQ_SOURCE_LINE 00000392 "    print $t2->draw;"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "    .-------+------------."
NSQ_SOURCE_LINE 00000395 "    | Foo   | Bar        |"
NSQ_SOURCE_LINE 00000396 "    +-------+------------+"
NSQ_SOURCE_LINE 00000397 "    | foob- | yadayaday- |"
NSQ_SOURCE_LINE 00000398 "    | arbaz | ada        |"
NSQ_SOURCE_LINE 00000399 "    | barb- | yada       |"
NSQ_SOURCE_LINE 00000400 "    | arba- |            |"
NSQ_SOURCE_LINE 00000401 "    | rbar- |            |"
NSQ_SOURCE_LINE 00000402 "    | bar   |            |"
NSQ_SOURCE_LINE 00000403 "    '-------+------------'"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "    my $t3 = Text::SimpleTable->new([5, 'Foo'], [10, 'Bar']);"
NSQ_SOURCE_LINE 00000406 "    $t3->row('foobarbaz', 'yadayadayada');"
NSQ_SOURCE_LINE 00000407 "    $t3->hr;"
NSQ_SOURCE_LINE 00000408 "    $t3->row('barbarbarbarbar', 'yada');"
NSQ_SOURCE_LINE 00000409 "    print $t3->draw;"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "    .-------+------------."
NSQ_SOURCE_LINE 00000412 "    | Foo   | Bar        |"
NSQ_SOURCE_LINE 00000413 "    +-------+------------+"
NSQ_SOURCE_LINE 00000414 "    | foob- | yadayaday- |"
NSQ_SOURCE_LINE 00000415 "    | arbaz | ada        |"
NSQ_SOURCE_LINE 00000416 "    +-------+------------+"
NSQ_SOURCE_LINE 00000417 "    | barb- | yada       |"
NSQ_SOURCE_LINE 00000418 "    | arba- |            |"
NSQ_SOURCE_LINE 00000419 "    | rbar- |            |"
NSQ_SOURCE_LINE 00000420 "    | bar   |            |"
NSQ_SOURCE_LINE 00000421 "    '-------+------------'"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "    print $t3->boxes->draw;"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "    ┌───────┬────────────┐"
NSQ_SOURCE_LINE 00000426 "    │ Foo   │ Bar        │"
NSQ_SOURCE_LINE 00000427 "    ├───────┼────────────┤"
NSQ_SOURCE_LINE 00000428 "    │ foob- │ yadayaday- │"
NSQ_SOURCE_LINE 00000429 "    │ arbaz │ ada        │"
NSQ_SOURCE_LINE 00000430 "    ├───────┼────────────┤"
NSQ_SOURCE_LINE 00000431 "    │ barb- │ yada       │"
NSQ_SOURCE_LINE 00000432 "    │ arba- │            │"
NSQ_SOURCE_LINE 00000433 "    │ rbar- │            │"
NSQ_SOURCE_LINE 00000434 "    │ bar   │            │"
NSQ_SOURCE_LINE 00000435 "    └───────┴────────────┘"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "Simple eyecandy ASCII tables."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=head1 METHODS"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "L<Text::SimpleTable> implements the following methods."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=head2 C<new>"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "    my $t = Text::SimpleTable->new(5, 10);"
NSQ_SOURCE_LINE 00000448 "    my $t = Text::SimpleTable->new([5, 'Col1', 10, 'Col2']);"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "=head2 C<draw>"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "    my $ascii = $t->draw;"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "=head2 C<hr>"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "    $t = $t->hr;"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "=head2 C<row>"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "    $t = $t->row('col1 data', 'col2 data');"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "=head2 C<boxes>"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "    $t = $t->boxes;"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "C<boxes> switches the output generated by C<draw> to use the unicode box drawing characters. The last "
NSQ_SOURCE_LINE 00000467 "example above may not render nicely on some devices. "
NSQ_SOURCE_LINE 00000468 ""
