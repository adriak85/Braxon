NSQ_SOURCE_LINE 00000025 "=head1 NAME"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "Scalar::Util::Numeric - numeric tests for perl scalars"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    use Scalar::Util::Numeric qw(isnum isint isfloat);"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    foo($bar / 2) if (isnum $bar);"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    if (isint $baz) {"
NSQ_SOURCE_LINE 00000036 "        # ..."
NSQ_SOURCE_LINE 00000037 "    } elsif (isfloat $baz) {"
NSQ_SOURCE_LINE 00000038 "        # ..."
NSQ_SOURCE_LINE 00000039 "    }"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "This module exports a number of wrappers around perl's builtin C<grok_number> function, which"
NSQ_SOURCE_LINE 00000044 "returns the numeric type of its argument, or 0 if it isn't numeric."
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=head1 TAGS"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "All of the functions exported by Scalar::Util::Numeric can be imported by using the C<:all> tag:"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    use Scalar::Util::Numeric qw(:all);"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "=head2 isnum"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    isnum ($val)"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "Returns a nonzero value (indicating the numeric type) if $val is a number."
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "The numeric type is a conjunction of the following flags:"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    0x01  IS_NUMBER_IN_UV               (number within UV range - not necessarily an integer)"
NSQ_SOURCE_LINE 00000063 "    0x02  IS_NUMBER_GREATER_THAN_UV_MAX (number is greater than UV_MAX)"
NSQ_SOURCE_LINE 00000064 "    0x04  IS_NUMBER_NOT_INT             (saw . or E notation)"
NSQ_SOURCE_LINE 00000065 "    0x08  IS_NUMBER_NEG                 (leading minus sign)"
NSQ_SOURCE_LINE 00000066 "    0x10  IS_NUMBER_INFINITY            (Infinity)"
NSQ_SOURCE_LINE 00000067 "    0x20  IS_NUMBER_NAN                 (NaN - not a number)"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "=head2 isint"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head2 isuv"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "=head2 isbig"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=head2 isfloat"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "=head2 isneg"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=head2 isinf"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "=head2 isnan"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "The following flavours of C<isnum> (corresponding to the flags above) are also available:"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    isint"
NSQ_SOURCE_LINE 00000086 "    isuv"
NSQ_SOURCE_LINE 00000087 "    isbig"
NSQ_SOURCE_LINE 00000088 "    isfloat"
NSQ_SOURCE_LINE 00000089 "    isneg"
NSQ_SOURCE_LINE 00000090 "    isinf"
NSQ_SOURCE_LINE 00000091 "    isnan"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "C<isint> returns -1 if its operand is a negative integer, 1 if"
NSQ_SOURCE_LINE 00000094 "it's 0 or a positive integer, and 0 otherwise."
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "The others always return 1 or 0."
NSQ_SOURCE_LINE 00000097 ""
