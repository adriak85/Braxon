BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Clone::Choose;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use Carp ();"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = \"0.010\";"
NSQ_SOURCE_LINE 00000008 "$VERSION = eval $VERSION;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our @BACKENDS = ("
NSQ_SOURCE_LINE 00000011 "    Clone       => [0.10, \"clone\"],"
NSQ_SOURCE_LINE 00000012 "    Storable    => \"dclone\","
NSQ_SOURCE_LINE 00000013 "    \"Clone::PP\" => \"clone\","
NSQ_SOURCE_LINE 00000014 ");"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "my $use_m;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "BEGIN"
NSQ_SOURCE_LINE 00000019 "{"
NSQ_SOURCE_LINE 00000020 "    unless ($use_m)"
NSQ_SOURCE_LINE 00000021 "    {"
NSQ_SOURCE_LINE 00000022 "        eval \"use Module::Runtime (); 1;\""
NSQ_SOURCE_LINE 00000023 "          and $use_m = Module::Runtime->can(\"use_module\")"
NSQ_SOURCE_LINE 00000024 "          unless $ENV{CLONE_CHOOSE_NO_MODULE_RUNTIME};"
NSQ_SOURCE_LINE 00000025 "        $use_m ||= sub {"
NSQ_SOURCE_LINE 00000026 "            my ($pkg, @imports) = @_;"
NSQ_SOURCE_LINE 00000027 "            my $use_stmt = \"use $pkg\";"
NSQ_SOURCE_LINE 00000028 "            @imports and $use_stmt = join(\" \", $use_stmt, @imports);"
NSQ_SOURCE_LINE 00000029 "            eval $use_stmt;"
NSQ_SOURCE_LINE 00000030 "            $@ and die $@;"
NSQ_SOURCE_LINE 00000031 "            1;"
NSQ_SOURCE_LINE 00000032 "        };"
NSQ_SOURCE_LINE 00000033 "    }"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub backend"
NSQ_SOURCE_LINE 00000037 "{"
NSQ_SOURCE_LINE 00000038 "    my $self     = shift;"
NSQ_SOURCE_LINE 00000039 "    my @backends = @BACKENDS;"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    if ($ENV{CLONE_CHOOSE_PREFERRED_BACKEND})"
NSQ_SOURCE_LINE 00000042 "    {"
NSQ_SOURCE_LINE 00000043 "        my $favourite = $ENV{CLONE_CHOOSE_PREFERRED_BACKEND};"
NSQ_SOURCE_LINE 00000044 "        my %b         = @backends;"
NSQ_SOURCE_LINE 00000045 "        Carp::croak \"$favourite not found\" unless $b{$favourite};"
NSQ_SOURCE_LINE 00000046 "        @backends = ($favourite => $b{$favourite});"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    while (my ($pkg, $rout) = splice @backends, 0, 2)"
NSQ_SOURCE_LINE 00000050 "    {"
NSQ_SOURCE_LINE 00000051 "        eval { $use_m->($pkg, ref $rout ? ($rout->[0]) : ()); 1; } or next;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "        my $fn = $pkg->can(ref $rout ? $rout->[1] : $rout);"
NSQ_SOURCE_LINE 00000054 "        $fn or next;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "        return $pkg;"
NSQ_SOURCE_LINE 00000057 "    }"
NSQ_SOURCE_LINE 00000058 "}"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "sub can"
NSQ_SOURCE_LINE 00000061 "{"
NSQ_SOURCE_LINE 00000062 "    my $self     = shift;"
NSQ_SOURCE_LINE 00000063 "    my $name     = shift;"
NSQ_SOURCE_LINE 00000064 "    my @backends = @BACKENDS;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    return __PACKAGE__->SUPER::can($name) unless $name eq \"clone\";"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    if ($ENV{CLONE_CHOOSE_PREFERRED_BACKEND})"
NSQ_SOURCE_LINE 00000069 "    {"
NSQ_SOURCE_LINE 00000070 "        my $favourite = $ENV{CLONE_CHOOSE_PREFERRED_BACKEND};"
NSQ_SOURCE_LINE 00000071 "        my %b         = @backends;"
NSQ_SOURCE_LINE 00000072 "        Carp::croak \"$favourite not found\" unless $b{$favourite};"
NSQ_SOURCE_LINE 00000073 "        @backends = ($favourite => $b{$favourite});"
NSQ_SOURCE_LINE 00000074 "    }"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "    my $fn;"
NSQ_SOURCE_LINE 00000077 "    while (my ($pkg, $rout) = splice @backends, 0, 2)"
NSQ_SOURCE_LINE 00000078 "    {"
NSQ_SOURCE_LINE 00000079 "        eval { $use_m->($pkg, ref $rout ? ($rout->[0]) : ()); 1; } or next;"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "        $fn = $pkg->can(ref $rout ? $rout->[1] : $rout);"
NSQ_SOURCE_LINE 00000082 "        $fn or next;"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "        last;"
NSQ_SOURCE_LINE 00000085 "    }"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    return $fn;"
NSQ_SOURCE_LINE 00000088 "}"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "sub import"
NSQ_SOURCE_LINE 00000091 "{"
NSQ_SOURCE_LINE 00000092 "    my ($me, @params) = @_;"
NSQ_SOURCE_LINE 00000093 "    my $tgt = caller(0);"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    my @B = @BACKENDS;"
NSQ_SOURCE_LINE 00000096 "    local @BACKENDS = @B;"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    push @params, \"clone\" unless grep { /^clone$/ } @params;"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "    while (my $param = shift @params)"
NSQ_SOURCE_LINE 00000101 "    {"
NSQ_SOURCE_LINE 00000102 "        if ($param =~ m/^:(.*)$/)"
NSQ_SOURCE_LINE 00000103 "        {"
NSQ_SOURCE_LINE 00000104 "            my $favourite = $1;"
NSQ_SOURCE_LINE 00000105 "            $ENV{CLONE_CHOOSE_PREFERRED_BACKEND}"
NSQ_SOURCE_LINE 00000106 "              and $ENV{CLONE_CHOOSE_PREFERRED_BACKEND} ne $favourite"
NSQ_SOURCE_LINE 00000107 "              and Carp::croak"
NSQ_SOURCE_LINE 00000108 "              \"Environment CLONE_CHOOSE_PREFERRED_BACKEND($ENV{CLONE_CHOOSE_PREFERRED_BACKEND}) not equal to imported ($favourite)\";"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "            my %b = @BACKENDS;"
NSQ_SOURCE_LINE 00000111 "            Carp::croak \"$favourite not found\" unless $b{$favourite};"
NSQ_SOURCE_LINE 00000112 "            @BACKENDS = ($favourite => $b{$favourite});"
NSQ_SOURCE_LINE 00000113 "        }"
NSQ_SOURCE_LINE 00000114 "        elsif ($param eq \"clone\")"
NSQ_SOURCE_LINE 00000115 "        {"
NSQ_SOURCE_LINE 00000116 "            my $fn = __PACKAGE__->can(\"clone\");"
NSQ_SOURCE_LINE 00000117 "            $fn or Carp::croak \"Cannot find an apropriate clone().\";"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "            no strict \"refs\";"
NSQ_SOURCE_LINE 00000120 "            *{\"${tgt}::clone\"} = $fn;"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "            @params"
NSQ_SOURCE_LINE 00000123 "              and Carp::croak \"Parameters left after clone. Please see description.\";"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "            return;"
NSQ_SOURCE_LINE 00000126 "        }"
NSQ_SOURCE_LINE 00000127 "        else"
NSQ_SOURCE_LINE 00000128 "        {"
NSQ_SOURCE_LINE 00000129 "            Carp::croak \"$param is not exportable by \" . __PACKAGE__;"
NSQ_SOURCE_LINE 00000130 "        }"
NSQ_SOURCE_LINE 00000131 "    }"
NSQ_SOURCE_LINE 00000132 "}"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "sub get_backends"
NSQ_SOURCE_LINE 00000135 "{"
NSQ_SOURCE_LINE 00000136 "    my $self     = shift;"
NSQ_SOURCE_LINE 00000137 "    my %backends = @BACKENDS;"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    if ($ENV{CLONE_CHOOSE_PREFERRED_BACKEND})"
NSQ_SOURCE_LINE 00000140 "    {"
NSQ_SOURCE_LINE 00000141 "        my $favourite = $ENV{CLONE_CHOOSE_PREFERRED_BACKEND};"
NSQ_SOURCE_LINE 00000142 "        Carp::croak \"$favourite not found\" unless $backends{$favourite};"
NSQ_SOURCE_LINE 00000143 "        %backends = ($favourite => $backends{$favourite});"
NSQ_SOURCE_LINE 00000144 "    }"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    return keys %backends;"
NSQ_SOURCE_LINE 00000147 "}"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "1;"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "__END__"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=head1 NAME"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "Clone::Choose - Choose appropriate clone utility"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=begin html"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "<a href=\"https://travis-ci.org/perl5-utils/Clone-Choose\"><img src=\"https://travis-ci.org/perl5-utils/Clone-Choose.svg?branch=master\" alt=\"Travis CI\"/></a>"
NSQ_SOURCE_LINE 00000160 "<a href='https://coveralls.io/github/perl5-utils/Clone-Choose?branch=master'><img src='https://coveralls.io/repos/github/perl5-utils/Clone-Choose/badge.svg?branch=master' alt='Coverage Status'/></a>"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=end html"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "  use Clone::Choose;"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "  my $data = {"
NSQ_SOURCE_LINE 00000169 "      value => 42,"
NSQ_SOURCE_LINE 00000170 "      href  => {"
NSQ_SOURCE_LINE 00000171 "          set   => [ 'foo', 'bar' ],"
NSQ_SOURCE_LINE 00000172 "          value => 'baz',"
NSQ_SOURCE_LINE 00000173 "      },"
NSQ_SOURCE_LINE 00000174 "  };"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "  my $cloned_data = clone $data;"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "  # it's also possible to use Clone::Choose and pass a clone preference"
NSQ_SOURCE_LINE 00000179 "  use Clone::Choose qw(:Storable);"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "C<Clone::Choose> checks several different modules which provides a"
NSQ_SOURCE_LINE 00000184 "C<clone()> function and selects an appropriate one. The default preference"
NSQ_SOURCE_LINE 00000185 "is"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "  Clone"
NSQ_SOURCE_LINE 00000188 "  Storable"
NSQ_SOURCE_LINE 00000189 "  Clone::PP"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "This list might evolve in future. Please see L</EXPORTS> how to pick a"
NSQ_SOURCE_LINE 00000192 "particular one."
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "C<Clone::Choose> exports C<clone()> by default."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "One can explicitly import C<clone> by using"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "  use Clone::Choose qw(clone);"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "or pick a particular C<clone> implementation"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "  use Clone::Choose qw(:Storable clone);"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "The exported implementation is resolved dynamically, which means that any"
NSQ_SOURCE_LINE 00000207 "using module can either rely on the default backend preference or choose"
NSQ_SOURCE_LINE 00000208 "a particular one."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "It is also possible to select a particular C<clone> backend by setting the"
NSQ_SOURCE_LINE 00000211 "environment variable CLONE_CHOOSE_PREFERRED_BACKEND to your preferred backend."
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "This also means, an already chosen import can't be modified like"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "  use Clone::Choose qw(clone :Storable);"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "When one seriously needs different clone implementations, our I<recommended>"
NSQ_SOURCE_LINE 00000218 "way to use them would be:"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "  use Clone::Choose (); # do not import"
NSQ_SOURCE_LINE 00000221 "  my ($xs_clone, $st_clone);"
NSQ_SOURCE_LINE 00000222 "  { local @Clone::Choose::BACKENDS = (Clone => \"clone\"); $xs_clone = Clone::Choose->can(\"clone\"); }"
NSQ_SOURCE_LINE 00000223 "  { local @Clone::Choose::BACKENDS = (Storable => \"dclone\"); $st_clone = Clone::Choose->can(\"clone\"); }"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "Don't misinterpret I<recommended> - modifying C<@Clone::Choose::BACKENDS>"
NSQ_SOURCE_LINE 00000226 "has a lot of pitfalls and is unreliable beside such small examples. Do"
NSQ_SOURCE_LINE 00000227 "not hesitate open a request with an appropriate proposal for choosing"
NSQ_SOURCE_LINE 00000228 "implementations dynamically."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "The use of C<@Clone::Choose::BACKENDS> is discouraged and will be deprecated"
NSQ_SOURCE_LINE 00000231 "as soon as anyone provides a better idea."
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=head1 PACKAGE METHODS"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=head2 backend"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "C<backend> tells the caller about the dynamic chosen backend:"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "  use Clone::Choose;"
NSQ_SOURCE_LINE 00000240 "  say Clone::Choose->backend; # Clone"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "This method currently exists for debug purposes only."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head2 get_backends"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "C<get_backends> returns a list of the currently supported backends."
NSQ_SOURCE_LINE 00000247 ""
