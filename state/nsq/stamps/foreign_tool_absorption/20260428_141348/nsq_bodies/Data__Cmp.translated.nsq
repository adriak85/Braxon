BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Data::Cmp;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2021-04-12'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Data-Cmp'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.010'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Scalar::Util qw(blessed reftype refaddr);"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "require Exporter;"
NSQ_SOURCE_LINE 00000015 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw(cmp_data);"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "# for when dealing with circular refs"
NSQ_SOURCE_LINE 00000019 "my %_seen_refaddrs;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub _cmp_data {"
NSQ_SOURCE_LINE 00000022 "    my $d1 = shift;"
NSQ_SOURCE_LINE 00000023 "    my $d2 = shift;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    my $def1 = defined $d1;"
NSQ_SOURCE_LINE 00000026 "    my $def2 = defined $d2;"
NSQ_SOURCE_LINE 00000027 "    if ($def1) {"
NSQ_SOURCE_LINE 00000028 "        return 1 if !$def2;"
NSQ_SOURCE_LINE 00000029 "    } else {"
NSQ_SOURCE_LINE 00000030 "        return $def2 ? -1 : 0;"
NSQ_SOURCE_LINE 00000031 "    }"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    # so both are defined ..."
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    my $reftype1 = reftype($d1);"
NSQ_SOURCE_LINE 00000036 "    my $reftype2 = reftype($d2);"
NSQ_SOURCE_LINE 00000037 "    if (!$reftype1 && !$reftype2) {"
NSQ_SOURCE_LINE 00000038 "        return $d1 cmp $d2;"
NSQ_SOURCE_LINE 00000039 "    } elsif ( $reftype1 xor $reftype2) { return 2 }"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    # so both are refs ..."
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    return 2 if $reftype1 ne $reftype2;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    # so both are refs of the same type ..."
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    my $pkg1 = blessed($d1);"
NSQ_SOURCE_LINE 00000048 "    my $pkg2 = blessed($d2);"
NSQ_SOURCE_LINE 00000049 "    if (defined $pkg1) {"
NSQ_SOURCE_LINE 00000050 "        return 2 unless defined $pkg2 && $pkg1 eq $pkg2;"
NSQ_SOURCE_LINE 00000051 "    } else {"
NSQ_SOURCE_LINE 00000052 "        return 2 if defined $pkg2;"
NSQ_SOURCE_LINE 00000053 "    }"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    # so both are non-objects or objects of the same class ..."
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    my $refaddr1 = refaddr($d1);"
NSQ_SOURCE_LINE 00000058 "    my $refaddr2 = refaddr($d2);"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "    if ($reftype1 eq 'ARRAY' && !$_seen_refaddrs{$refaddr1} && !$_seen_refaddrs{$refaddr2}) {"
NSQ_SOURCE_LINE 00000061 "        $_seen_refaddrs{$refaddr1}++;"
NSQ_SOURCE_LINE 00000062 "        $_seen_refaddrs{$refaddr2}++;"
NSQ_SOURCE_LINE 00000063 "      ELEM:"
NSQ_SOURCE_LINE 00000064 "        for my $i (0..($#{$d1} < $#{$d2} ? $#{$d1} : $#{$d2})) {"
NSQ_SOURCE_LINE 00000065 "            my $cmpres = _cmp_data($d1->[$i], $d2->[$i]);"
NSQ_SOURCE_LINE 00000066 "            return $cmpres if $cmpres;"
NSQ_SOURCE_LINE 00000067 "        }"
NSQ_SOURCE_LINE 00000068 "        return $#{$d1} <=> $#{$d2};"
NSQ_SOURCE_LINE 00000069 "    } elsif ($reftype1 eq 'HASH' && !$_seen_refaddrs{$refaddr1} && !$_seen_refaddrs{$refaddr2}) {"
NSQ_SOURCE_LINE 00000070 "        $_seen_refaddrs{$refaddr1}++;"
NSQ_SOURCE_LINE 00000071 "        $_seen_refaddrs{$refaddr2}++;"
NSQ_SOURCE_LINE 00000072 "        my $nkeys1 = keys %$d1;"
NSQ_SOURCE_LINE 00000073 "        my $nkeys2 = keys %$d2;"
NSQ_SOURCE_LINE 00000074 "      KEY:"
NSQ_SOURCE_LINE 00000075 "        for my $k (sort keys %$d1) {"
NSQ_SOURCE_LINE 00000076 "            unless (exists $d2->{$k}) { return $nkeys1 <=> $nkeys2 || 2 }"
NSQ_SOURCE_LINE 00000077 "            my $cmpres = _cmp_data($d1->{$k}, $d2->{$k});"
NSQ_SOURCE_LINE 00000078 "            return $cmpres if $cmpres;"
NSQ_SOURCE_LINE 00000079 "        }"
NSQ_SOURCE_LINE 00000080 "        return $nkeys1 <=> $nkeys2;"
NSQ_SOURCE_LINE 00000081 "    } else {"
NSQ_SOURCE_LINE 00000082 "        return $refaddr1 == $refaddr2 ? 0 : 2;"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub cmp_data {"
NSQ_SOURCE_LINE 00000087 "    my $d1 = shift;"
NSQ_SOURCE_LINE 00000088 "    my $d2 = shift;"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    %_seen_refaddrs = ();"
NSQ_SOURCE_LINE 00000091 "    _cmp_data($d1, $d2);"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "1;"
NSQ_SOURCE_LINE 00000095 "# ABSTRACT: Compare two data structures, return -1/0/1 like cmp"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "__END__"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=pod"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "=head1 NAME"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "Data::Cmp - Compare two data structures, return -1/0/1 like cmp"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=head1 VERSION"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "This document describes version 0.010 of Data::Cmp (from Perl distribution Data-Cmp), released on 2021-04-12."
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 " use Data::Cmp qw(cmp_data);"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 " cmp_data([\"one\", \"two\", \"three\"],"
NSQ_SOURCE_LINE 00000116 "          [\"one\", \"two\", \"three\"]); # => 0"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 " cmp_data([\"one\", \"two\" , \"three\"],"
NSQ_SOURCE_LINE 00000119 "          [\"one\", \"two2\", \"three\"]); # => -1"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 " cmp_data([\"one\", \"two\", \"three\"],"
NSQ_SOURCE_LINE 00000122 "          [\"one\", \"TWO\", \"three\"]); # => 1"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 " # hash/array is not \"comparable\" with scalar"
NSQ_SOURCE_LINE 00000125 " cmp_data([\"one\", \"two\", {}],"
NSQ_SOURCE_LINE 00000126 "          [\"one\", \"two\", \"three\"]); # => 2"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "Sort data structures (of similar structures):"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 " my @arrays = ([\"c\"], [\"b\"], [\"a\", \"b\"], [\"a\"], [\"a\",\"c\"]);"
NSQ_SOURCE_LINE 00000131 " my @sorted = sort { cmp_data($a, $b) } @arrays; # => ([\"a\"], [\"a\",\"b\"], [\"a\",\"c\"], [\"b\"], [\"c\"])"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "This relatively lightweight (no non-core dependencies, under 100 lines of code)"
NSQ_SOURCE_LINE 00000136 "module offers the C<cmp_data> function that, like Perl's C<cmp>, returns -1/0/1"
NSQ_SOURCE_LINE 00000137 "value. C<cmp_data> differs from C<cmp> in that it can compare two data of"
NSQ_SOURCE_LINE 00000138 "different types and compare data items recursively, with pretty sensible"
NSQ_SOURCE_LINE 00000139 "semantics. In addition to returning -1/0/1, C<cmp_data> can also return 2 if two"
NSQ_SOURCE_LINE 00000140 "data differ but not comparable: there is no sensible notion of which one is"
NSQ_SOURCE_LINE 00000141 "\"greater than\" the other. An example is empty hash C<{}> vs empty array C<[]>)."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "This module can handle circular structure."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "The following are the rules of comparison used by C<cmp_data()>:"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=over"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "=item * Two undefs are the same"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 " cmp_data(undef, undef); # 0"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=item * A defined value is greater than undef"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 " cmp_data(undef, 0); # -1"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=item * Two non-reference scalars are compared string-wise using Perl's cmp"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 " cmp_data(\"a\", \"A\"); # 1"
NSQ_SOURCE_LINE 00000160 " cmp_data(10, 9);    # -1"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=item * A reference and non-reference are different and not comparable"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 " cmp_data([], 0); # 2"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=item * Two references that are of different types are different and not comparable"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 " cmp_data([], {}); # 2"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "=item * Blessed references that are blessed into different packages are different and not comparable"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 " cmp_data(bless([], \"foo\"), bless([], \"bar\")); # 2"
NSQ_SOURCE_LINE 00000173 " cmp_data(bless([], \"foo\"), bless([], \"foo\")); # 0"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=item * Two array references are compared element by element (unless at least one of the arrayref has been seen, in which case see last rule)"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 " cmp_data([\"a\",\"b\",\"c\"], [\"a\",\"b\",\"c\"]); #  0"
NSQ_SOURCE_LINE 00000178 " cmp_data([\"a\",\"b\",\"c\"], [\"a\",\"b\",\"d\"]); # -1"
NSQ_SOURCE_LINE 00000179 " cmp_data([\"a\",\"d\",\"c\"], [\"a\",\"b\",\"e\"]); #  1"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "=item * A longer arrayref is greater than its shorter subset"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 " cmp_data([\"a\",\"b\"], [\"a\"]); # 1"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=item * Two hash references are compared key by key (unless at least one of the hashref has been seen, in which case see last rule)"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 " cmp_data({k1=>\"a\", k2=>\"b\", k3=>\"c\"}, {k1=>\"a\", k2=>\"b\", k3=>\"c\"}); # 0"
NSQ_SOURCE_LINE 00000188 " cmp_data({k1=>\"a\", k2=>\"b\", k3=>\"c\"}, {k1=>\"a\", k2=>\"b\", k3=>\"d\"}); # 1"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=item * When two hash references share a common subset of pairs but have non-common pairs, the greater hashref is the one that has more non-common pairs"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "If the number of non-common pairs are the same, they are just different and not"
NSQ_SOURCE_LINE 00000193 "comparable:"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 " cmp_data({k1=>\"\", k2=>\"\", k3=>\"\"}, {k1=>\"\", k5=>\"\"});                #  1 (hash1 has 2 non-common keys: k2 & k3; hash2 only has 1: k5)"
NSQ_SOURCE_LINE 00000196 " cmp_data({k1=>\"\", k2=>\"\", k3=>\"\"}, {k1=>\"\", k5=>\"\", k6=>\", k7=>\"\"}); # -1 (hash1 has 2 non-common keys: k2 & k3; hash2 has 3 non-common pairs: k5, k6, k7)"
NSQ_SOURCE_LINE 00000197 " cmp_data({k1=>\"\", k2=>\"\", k3=>\"\"}, {k1=>\"\", k5=>\"\", k6=>\"});         #  2 (both hashes have 2 non-common pairs)"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "=item * All other types of references (i.e. non-hash, non-array) are the same only if their address is the same; otherwise they are different and not comparable"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 " cmp_data(\\1, \\1); # 2"
NSQ_SOURCE_LINE 00000202 " my $ref = \\1; cmp_data($ref, $ref); # 0"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=item * A seen (hash or array) reference is no longer recursed, it's compared by address (see previous rule)"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 " my $ary1 = [1]; push @$ary1, $ary1;"
NSQ_SOURCE_LINE 00000207 " my $ary2 = [1]; push @$ary2, $ary2;"
NSQ_SOURCE_LINE 00000208 " my $ary3 = [1]; push @$ary3, $ary1;"
NSQ_SOURCE_LINE 00000209 " cmp_data($ary1, $ary2); # 2"
NSQ_SOURCE_LINE 00000210 " cmp_data($ary1, $ary3); # 0"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=back"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "=head2 cmp_data"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "Usage:"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 " cmp_data($d1, $d2) => -1/0/1/2"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "Please visit the project's homepage at L<https://metacpan.org/release/Data-Cmp>."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "Source repository is at L<https://github.com/perlancar/perl-Data-Cmp>."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=head1 BUGS"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "Please report any bugs or feature requests on the bugtracker website L<https://github.com/perlancar/perl-Data-Cmp/issues>"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000235 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000236 "feature."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=head2 Data comparison"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "Other variants of Data::Cmp: L<Data::Cmp::Numeric>, L<Data::Cmp::StrOrNumeric>,"
NSQ_SOURCE_LINE 00000243 "L<Data::Cmp::Custom> (allows custom actions and comparison routines),"
NSQ_SOURCE_LINE 00000244 "L<Data::Cmp::Diff> (generates diff structure instead of just returning"
NSQ_SOURCE_LINE 00000245 "-1/0/1/2), L<Data::Cmp::Diff::Perl> (generates diff in the form of Perl code)."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "Modules that just return boolean result (\"same or different\"): L<Data::Compare>,"
NSQ_SOURCE_LINE 00000248 "L<Test::Deep::NoTest> (offers flexibility or approximate or custom comparison)."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "Modules that return some kind of \"diff\" data: L<Data::Comparator>,"
NSQ_SOURCE_LINE 00000251 "L<Data::Diff>."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "Of course, to check whether two structures are the same you can also serialize"
NSQ_SOURCE_LINE 00000254 "each one then compare the serialized strings/bytes. There are many modules for"
NSQ_SOURCE_LINE 00000255 "serialization: L<JSON>, L<YAML>, L<Sereal>, L<Data::Dumper>, L<Storable>,"
NSQ_SOURCE_LINE 00000256 "L<Data::Dmp>, just to name a few."
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "Test modules that do data structure comparison: L<Test::DataCmp> (test module"
NSQ_SOURCE_LINE 00000259 "based on Data::Cmp::Custom), L<Test::More> (C<is_deeply()>), L<Test::Deep>,"
NSQ_SOURCE_LINE 00000260 "L<Test2::Tools::Compare>."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=head2 Others"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "L<Scalar::Cmp> which employs roughly the same rules as Data::Cmp but does not"
NSQ_SOURCE_LINE 00000265 "recurse into arrays/hashes and is meant to compare two scalar values."
NSQ_SOURCE_LINE 00000266 ""
