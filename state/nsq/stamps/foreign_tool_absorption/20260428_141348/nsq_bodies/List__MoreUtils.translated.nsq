NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 "=item * CPAN Ratings"
NSQ_SOURCE_LINE 00001113 ""
NSQ_SOURCE_LINE 00001114 "L<http://cpanratings.perl.org/dist/List-MoreUtils>"
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "=item * MetaCPAN"
