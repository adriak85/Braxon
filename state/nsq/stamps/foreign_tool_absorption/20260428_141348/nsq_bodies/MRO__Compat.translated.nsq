BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package MRO::Compat;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "require 5.006_000;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "# Keep this < 1.00, so people can tell the fake"
NSQ_SOURCE_LINE 00000007 "#  mro.pm from the real one"
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.15';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "BEGIN {"
NSQ_SOURCE_LINE 00000011 "    # Alias our private functions over to"
NSQ_SOURCE_LINE 00000012 "    # the mro:: namespace and load"
NSQ_SOURCE_LINE 00000013 "    # Class::C3 if Perl < 5.9.5"
NSQ_SOURCE_LINE 00000014 "    if($] < 5.009_005) {"
NSQ_SOURCE_LINE 00000015 "        $mro::VERSION # to fool Module::Install when generating META.yml"
NSQ_SOURCE_LINE 00000016 "            = $VERSION;"
NSQ_SOURCE_LINE 00000017 "        $INC{'mro.pm'} = __FILE__;"
NSQ_SOURCE_LINE 00000018 "        *mro::import            = \\&__import;"
NSQ_SOURCE_LINE 00000019 "        *mro::get_linear_isa    = \\&__get_linear_isa;"
NSQ_SOURCE_LINE 00000020 "        *mro::set_mro           = \\&__set_mro;"
NSQ_SOURCE_LINE 00000021 "        *mro::get_mro           = \\&__get_mro;"
NSQ_SOURCE_LINE 00000022 "        *mro::get_isarev        = \\&__get_isarev;"
NSQ_SOURCE_LINE 00000023 "        *mro::is_universal      = \\&__is_universal;"
NSQ_SOURCE_LINE 00000024 "        *mro::method_changed_in = \\&__method_changed_in;"
NSQ_SOURCE_LINE 00000025 "        *mro::invalidate_all_method_caches"
NSQ_SOURCE_LINE 00000026 "                                = \\&__invalidate_all_method_caches;"
NSQ_SOURCE_LINE 00000027 "        require Class::C3;"
NSQ_SOURCE_LINE 00000028 "        if($Class::C3::XS::VERSION && $Class::C3::XS::VERSION > 0.03) {"
NSQ_SOURCE_LINE 00000029 "            *mro::get_pkg_gen   = \\&__get_pkg_gen_c3xs;"
NSQ_SOURCE_LINE 00000030 "        }"
NSQ_SOURCE_LINE 00000031 "        else {"
NSQ_SOURCE_LINE 00000032 "            *mro::get_pkg_gen   = \\&__get_pkg_gen_pp;"
NSQ_SOURCE_LINE 00000033 "        }"
NSQ_SOURCE_LINE 00000034 "    }"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    # Load mro.pm and provide no-op Class::C3::.*initialize() funcs for 5.9.5+"
NSQ_SOURCE_LINE 00000037 "    else {"
NSQ_SOURCE_LINE 00000038 "        require mro;"
NSQ_SOURCE_LINE 00000039 "        no warnings 'redefine';"
NSQ_SOURCE_LINE 00000040 "        *Class::C3::initialize = sub { 1 };"
NSQ_SOURCE_LINE 00000041 "        *Class::C3::reinitialize = sub { 1 };"
NSQ_SOURCE_LINE 00000042 "        *Class::C3::uninitialize = sub { 1 };"
NSQ_SOURCE_LINE 00000043 "    }"
NSQ_SOURCE_LINE 00000044 "}"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=head1 NAME"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "MRO::Compat - mro::* interface compatibility for Perls < 5.9.5"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "   package PPP;      use base qw/Exporter/;"
NSQ_SOURCE_LINE 00000053 "   package X;        use base qw/PPP/;"
NSQ_SOURCE_LINE 00000054 "   package Y;        use base qw/PPP/;"
NSQ_SOURCE_LINE 00000055 "   package Z;        use base qw/PPP/;"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "   package FooClass; use base qw/X Y Z/;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "   package main;"
NSQ_SOURCE_LINE 00000060 "   use MRO::Compat;"
NSQ_SOURCE_LINE 00000061 "   my $linear = mro::get_linear_isa('FooClass');"
NSQ_SOURCE_LINE 00000062 "   print join(q{, }, @$linear);"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "   # Prints: FooClass, X, PPP, Exporter, Y, Z"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "The \"mro\" namespace provides several utilities for dealing"
NSQ_SOURCE_LINE 00000069 "with method resolution order and method caching in general"
NSQ_SOURCE_LINE 00000070 "in Perl 5.9.5 and higher."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "This module provides those interfaces for"
NSQ_SOURCE_LINE 00000073 "earlier versions of Perl (back to 5.6.0 anyways)."
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "It is a harmless no-op to use this module on 5.9.5+.  That"
NSQ_SOURCE_LINE 00000076 "is to say, code which properly uses L<MRO::Compat> will work"
NSQ_SOURCE_LINE 00000077 "unmodified on both older Perls and 5.9.5+."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "If you're writing a piece of software that would like to use"
NSQ_SOURCE_LINE 00000080 "the parts of 5.9.5+'s mro:: interfaces that are supported"
NSQ_SOURCE_LINE 00000081 "here, and you want compatibility with older Perls, this"
NSQ_SOURCE_LINE 00000082 "is the module for you."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "Some parts of this code will work better and/or faster with"
NSQ_SOURCE_LINE 00000085 "L<Class::C3::XS> installed (which is an optional prereq"
NSQ_SOURCE_LINE 00000086 "of L<Class::C3>, which is in turn a prereq of this"
NSQ_SOURCE_LINE 00000087 "package), but it's not a requirement."
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "This module never exports any functions.  All calls must"
NSQ_SOURCE_LINE 00000090 "be fully qualified with the C<mro::> prefix."
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "The interface documentation here serves only as a quick"
NSQ_SOURCE_LINE 00000093 "reference of what the function basically does, and what"
NSQ_SOURCE_LINE 00000094 "differences between L<MRO::Compat> and 5.9.5+ one should"
NSQ_SOURCE_LINE 00000095 "look out for.  The main docs in 5.9.5's L<mro> are the real"
NSQ_SOURCE_LINE 00000096 "interface docs, and contain a lot of other useful information."
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "=head1 Functions"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=head2 mro::get_linear_isa($classname[, $type])"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "Returns an arrayref which is the linearized \"ISA\" of the given class."
NSQ_SOURCE_LINE 00000103 "Uses whichever MRO is currently in effect for that class by default,"
NSQ_SOURCE_LINE 00000104 "or the given MRO (either C<c3> or C<dfs> if specified as C<$type>)."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "The linearized ISA of a class is a single ordered list of all of the"
NSQ_SOURCE_LINE 00000107 "classes that would be visited in the process of resolving a method"
NSQ_SOURCE_LINE 00000108 "on the given class, starting with itself.  It does not include any"
NSQ_SOURCE_LINE 00000109 "duplicate entries."
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "Note that C<UNIVERSAL> (and any members of C<UNIVERSAL>'s MRO) are not"
NSQ_SOURCE_LINE 00000112 "part of the MRO of a class, even though all classes implicitly inherit"
NSQ_SOURCE_LINE 00000113 "methods from C<UNIVERSAL> and its parents."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=cut"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "sub __get_linear_isa_dfs {"
NSQ_SOURCE_LINE 00000118 "    my @check = shift;"
NSQ_SOURCE_LINE 00000119 "    my @lin;"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "    my %found;"
NSQ_SOURCE_LINE 00000122 "    while (defined(my $check = shift @check)) {"
NSQ_SOURCE_LINE 00000123 "        push @lin, $check;"
NSQ_SOURCE_LINE 00000124 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000125 "        unshift @check, grep !$found{$_}++, @{\"$check\\::ISA\"};"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "    return \\@lin;"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "sub __get_linear_isa ($;$) {"
NSQ_SOURCE_LINE 00000132 "    my ($classname, $type) = @_;"
NSQ_SOURCE_LINE 00000133 "    die \"mro::get_mro requires a classname\" if !defined $classname;"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "    $type ||= __get_mro($classname);"
NSQ_SOURCE_LINE 00000136 "    if($type eq 'dfs') {"
NSQ_SOURCE_LINE 00000137 "        return __get_linear_isa_dfs($classname);"
NSQ_SOURCE_LINE 00000138 "    }"
NSQ_SOURCE_LINE 00000139 "    elsif($type eq 'c3') {"
NSQ_SOURCE_LINE 00000140 "        return [Class::C3::calculateMRO($classname)];"
NSQ_SOURCE_LINE 00000141 "    }"
NSQ_SOURCE_LINE 00000142 "    die \"type argument must be 'dfs' or 'c3'\";"
NSQ_SOURCE_LINE 00000143 "}"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=head2 mro::import"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "This allows the C<use mro 'dfs'> and"
NSQ_SOURCE_LINE 00000148 "C<use mro 'c3'> syntaxes, providing you"
NSQ_SOURCE_LINE 00000149 "C<use MRO::Compat> first.  Please see the"
NSQ_SOURCE_LINE 00000150 "L</USING C3> section for additional details."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=cut"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "sub __import {"
NSQ_SOURCE_LINE 00000155 "    if($_[1]) {"
NSQ_SOURCE_LINE 00000156 "        goto &Class::C3::import if $_[1] eq 'c3';"
NSQ_SOURCE_LINE 00000157 "        __set_mro(scalar(caller), $_[1]);"
NSQ_SOURCE_LINE 00000158 "    }"
NSQ_SOURCE_LINE 00000159 "}"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head2 mro::set_mro($classname, $type)"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "Sets the mro of C<$classname> to one of the types"
NSQ_SOURCE_LINE 00000164 "C<dfs> or C<c3>.  Please see the L</USING C3>"
NSQ_SOURCE_LINE 00000165 "section for additional details."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=cut"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "sub __set_mro ($$) {"
NSQ_SOURCE_LINE 00000170 "    my ($classname, $type) = @_;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    if(!defined $classname || !$type) {"
NSQ_SOURCE_LINE 00000173 "        die q{Usage: mro::set_mro($classname, $type)};"
NSQ_SOURCE_LINE 00000174 "    }"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    if($type eq 'c3') {"
NSQ_SOURCE_LINE 00000177 "        eval \"package $classname; use Class::C3\";"
NSQ_SOURCE_LINE 00000178 "        die $@ if $@;"
NSQ_SOURCE_LINE 00000179 "    }"
NSQ_SOURCE_LINE 00000180 "    elsif($type eq 'dfs') {"
NSQ_SOURCE_LINE 00000181 "        # In the dfs case, check whether we need to undo C3"
NSQ_SOURCE_LINE 00000182 "        if(defined $Class::C3::MRO{$classname}) {"
NSQ_SOURCE_LINE 00000183 "            Class::C3::_remove_method_dispatch_table($classname);"
NSQ_SOURCE_LINE 00000184 "        }"
NSQ_SOURCE_LINE 00000185 "        delete $Class::C3::MRO{$classname};"
NSQ_SOURCE_LINE 00000186 "    }"
NSQ_SOURCE_LINE 00000187 "    else {"
NSQ_SOURCE_LINE 00000188 "        die qq{Invalid mro type \"$type\"};"
NSQ_SOURCE_LINE 00000189 "    }"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "    return;"
NSQ_SOURCE_LINE 00000192 "}"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=head2 mro::get_mro($classname)"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "Returns the MRO of the given class (either C<c3> or C<dfs>)."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "It considers any Class::C3-using class to have C3 MRO"
NSQ_SOURCE_LINE 00000199 "even before L<Class::C3::initialize()> is called."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=cut"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "sub __get_mro ($) {"
NSQ_SOURCE_LINE 00000204 "    my $classname = shift;"
NSQ_SOURCE_LINE 00000205 "    die \"mro::get_mro requires a classname\" if !defined $classname;"
NSQ_SOURCE_LINE 00000206 "    return 'c3' if exists $Class::C3::MRO{$classname};"
NSQ_SOURCE_LINE 00000207 "    return 'dfs';"
NSQ_SOURCE_LINE 00000208 "}"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head2 mro::get_isarev($classname)"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "Returns an arrayref of classes who are subclasses of the"
NSQ_SOURCE_LINE 00000213 "given classname.  In other words, classes in whose @ISA"
NSQ_SOURCE_LINE 00000214 "hierarchy we appear, no matter how indirectly."
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "This is much slower on pre-5.9.5 Perls with MRO::Compat"
NSQ_SOURCE_LINE 00000217 "than it is on 5.9.5+, as it has to search the entire"
NSQ_SOURCE_LINE 00000218 "package namespace."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=cut"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "sub __get_all_pkgs_with_isas {"
NSQ_SOURCE_LINE 00000223 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000224 "    no warnings 'recursion';"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "    my @retval;"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "    my $search = shift;"
NSQ_SOURCE_LINE 00000229 "    my $pfx;"
NSQ_SOURCE_LINE 00000230 "    my $isa;"
NSQ_SOURCE_LINE 00000231 "    if(defined $search) {"
NSQ_SOURCE_LINE 00000232 "        $isa = \\@{\"$search\\::ISA\"};"
NSQ_SOURCE_LINE 00000233 "        $pfx = \"$search\\::\";"
NSQ_SOURCE_LINE 00000234 "    }"
NSQ_SOURCE_LINE 00000235 "    else {"
NSQ_SOURCE_LINE 00000236 "        $search = 'main';"
NSQ_SOURCE_LINE 00000237 "        $isa = \\@main::ISA;"
NSQ_SOURCE_LINE 00000238 "        $pfx = '';"
NSQ_SOURCE_LINE 00000239 "    }"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    push(@retval, $search) if scalar(@$isa);"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "    foreach my $cand (keys %{\"$search\\::\"}) {"
NSQ_SOURCE_LINE 00000244 "        if($cand =~ s/::$//) {"
NSQ_SOURCE_LINE 00000245 "            next if $cand eq $search; # skip self-reference (main?)"
NSQ_SOURCE_LINE 00000246 "            push(@retval, @{__get_all_pkgs_with_isas($pfx . $cand)});"
NSQ_SOURCE_LINE 00000247 "        }"
NSQ_SOURCE_LINE 00000248 "    }"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "    return \\@retval;"
NSQ_SOURCE_LINE 00000251 "}"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "sub __get_isarev_recurse {"
NSQ_SOURCE_LINE 00000254 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "    my ($class, $all_isas, $level) = @_;"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "    die \"Recursive inheritance detected\" if $level > 100;"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "    my %retval;"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "    foreach my $cand (@$all_isas) {"
NSQ_SOURCE_LINE 00000263 "        my $found_me;"
NSQ_SOURCE_LINE 00000264 "        foreach (@{\"$cand\\::ISA\"}) {"
NSQ_SOURCE_LINE 00000265 "            if($_ eq $class) {"
NSQ_SOURCE_LINE 00000266 "                $found_me = 1;"
NSQ_SOURCE_LINE 00000267 "                last;"
NSQ_SOURCE_LINE 00000268 "            }"
NSQ_SOURCE_LINE 00000269 "        }"
NSQ_SOURCE_LINE 00000270 "        if($found_me) {"
NSQ_SOURCE_LINE 00000271 "            $retval{$cand} = 1;"
NSQ_SOURCE_LINE 00000272 "            map { $retval{$_} = 1 }"
NSQ_SOURCE_LINE 00000273 "                @{__get_isarev_recurse($cand, $all_isas, $level+1)};"
NSQ_SOURCE_LINE 00000274 "        }"
NSQ_SOURCE_LINE 00000275 "    }"
NSQ_SOURCE_LINE 00000276 "    return [keys %retval];"
NSQ_SOURCE_LINE 00000277 "}"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "sub __get_isarev ($) {"
NSQ_SOURCE_LINE 00000280 "    my $classname = shift;"
NSQ_SOURCE_LINE 00000281 "    die \"mro::get_isarev requires a classname\" if !defined $classname;"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "    __get_isarev_recurse($classname, __get_all_pkgs_with_isas(), 0);"
NSQ_SOURCE_LINE 00000284 "}"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=head2 mro::is_universal($classname)"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "Returns a boolean status indicating whether or not"
NSQ_SOURCE_LINE 00000289 "the given classname is either C<UNIVERSAL> itself,"
NSQ_SOURCE_LINE 00000290 "or one of C<UNIVERSAL>'s parents by C<@ISA> inheritance."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "Any class for which this function returns true is"
NSQ_SOURCE_LINE 00000293 "\"universal\" in the sense that all classes potentially"
NSQ_SOURCE_LINE 00000294 "inherit methods from it."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=cut"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "sub __is_universal ($) {"
NSQ_SOURCE_LINE 00000299 "    my $classname = shift;"
NSQ_SOURCE_LINE 00000300 "    die \"mro::is_universal requires a classname\" if !defined $classname;"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "    my $lin = __get_linear_isa('UNIVERSAL');"
NSQ_SOURCE_LINE 00000303 "    foreach (@$lin) {"
NSQ_SOURCE_LINE 00000304 "        return 1 if $classname eq $_;"
NSQ_SOURCE_LINE 00000305 "    }"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "    return 0;"
NSQ_SOURCE_LINE 00000308 "}"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "=head2 mro::invalidate_all_method_caches"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "Increments C<PL_sub_generation>, which invalidates method"
NSQ_SOURCE_LINE 00000313 "caching in all packages."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "Please note that this is rarely necessary, unless you are"
NSQ_SOURCE_LINE 00000316 "dealing with a situation which is known to confuse Perl's"
NSQ_SOURCE_LINE 00000317 "method caching."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=cut"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "sub __invalidate_all_method_caches () {"
NSQ_SOURCE_LINE 00000322 "    # Super secret mystery code :)"
NSQ_SOURCE_LINE 00000323 "    @f845a9c1ac41be33::ISA = @f845a9c1ac41be33::ISA;"
NSQ_SOURCE_LINE 00000324 "    return;"
NSQ_SOURCE_LINE 00000325 "}"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "=head2 mro::method_changed_in($classname)"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "Invalidates the method cache of any classes dependent on the"
NSQ_SOURCE_LINE 00000330 "given class.  In L<MRO::Compat> on pre-5.9.5 Perls, this is"
NSQ_SOURCE_LINE 00000331 "an alias for C<mro::invalidate_all_method_caches> above, as"
NSQ_SOURCE_LINE 00000332 "pre-5.9.5 Perls have no other way to do this.  It will still"
NSQ_SOURCE_LINE 00000333 "enforce the requirement that you pass it a classname, for"
NSQ_SOURCE_LINE 00000334 "compatibility."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "Please note that this is rarely necessary, unless you are"
NSQ_SOURCE_LINE 00000337 "dealing with a situation which is known to confuse Perl's"
NSQ_SOURCE_LINE 00000338 "method caching."
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "=cut"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "sub __method_changed_in ($) {"
NSQ_SOURCE_LINE 00000343 "    my $classname = shift;"
NSQ_SOURCE_LINE 00000344 "    die \"mro::method_changed_in requires a classname\" if !defined $classname;"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "    __invalidate_all_method_caches();"
NSQ_SOURCE_LINE 00000347 "}"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "=head2 mro::get_pkg_gen($classname)"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "Returns an integer which is incremented every time a local"
NSQ_SOURCE_LINE 00000352 "method of or the C<@ISA> of the given package changes on"
NSQ_SOURCE_LINE 00000353 "Perl 5.9.5+.  On earlier Perls with this L<MRO::Compat> module,"
NSQ_SOURCE_LINE 00000354 "it will probably increment a lot more often than necessary."
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "=cut"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "{"
NSQ_SOURCE_LINE 00000359 "    my $__pkg_gen = 2;"
NSQ_SOURCE_LINE 00000360 "    sub __get_pkg_gen_pp ($) {"
NSQ_SOURCE_LINE 00000361 "        my $classname = shift;"
NSQ_SOURCE_LINE 00000362 "        die \"mro::get_pkg_gen requires a classname\" if !defined $classname;"
NSQ_SOURCE_LINE 00000363 "        return $__pkg_gen++;"
NSQ_SOURCE_LINE 00000364 "    }"
NSQ_SOURCE_LINE 00000365 "}"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "sub __get_pkg_gen_c3xs ($) {"
NSQ_SOURCE_LINE 00000368 "    my $classname = shift;"
NSQ_SOURCE_LINE 00000369 "    die \"mro::get_pkg_gen requires a classname\" if !defined $classname;"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "    return Class::C3::XS::_plsubgen();"
NSQ_SOURCE_LINE 00000372 "}"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=head1 USING C3"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "While this module makes the 5.9.5+ syntaxes"
NSQ_SOURCE_LINE 00000377 "C<use mro 'c3'> and C<mro::set_mro(\"Foo\", 'c3')> available"
NSQ_SOURCE_LINE 00000378 "on older Perls, it does so merely by passing off the work"
NSQ_SOURCE_LINE 00000379 "to L<Class::C3>."
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "It does not remove the need for you to call"
NSQ_SOURCE_LINE 00000382 "C<Class::C3::initialize()>, C<Class::C3::reinitialize()>, and/or"
NSQ_SOURCE_LINE 00000383 "C<Class::C3::uninitialize()> at the appropriate times"
NSQ_SOURCE_LINE 00000384 "as documented in the L<Class::C3> docs.  These three functions"
NSQ_SOURCE_LINE 00000385 "are always provided by L<MRO::Compat>, either via L<Class::C3>"
NSQ_SOURCE_LINE 00000386 "itself on older Perls, or directly as no-ops on 5.9.5+."
NSQ_SOURCE_LINE 00000387 ""
