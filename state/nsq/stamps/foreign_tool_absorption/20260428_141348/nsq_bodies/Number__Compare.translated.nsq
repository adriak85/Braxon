BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Number::Compare;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use Carp qw(croak);"
NSQ_SOURCE_LINE 00000004 "use vars qw/$VERSION/;"
NSQ_SOURCE_LINE 00000005 "$VERSION = '0.03';"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "sub new  {"
NSQ_SOURCE_LINE 00000008 "    my $referent = shift;"
NSQ_SOURCE_LINE 00000009 "    my $class = ref $referent || $referent;"
NSQ_SOURCE_LINE 00000010 "    my $expr = $class->parse_to_perl( shift );"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "    bless eval \"sub { \\$_[0] $expr }\", $class;"
NSQ_SOURCE_LINE 00000013 "}"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub parse_to_perl {"
NSQ_SOURCE_LINE 00000016 "    shift;"
NSQ_SOURCE_LINE 00000017 "    my $test = shift;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    $test =~ m{^"
NSQ_SOURCE_LINE 00000020 "               ([<>]=?)?   # comparison"
NSQ_SOURCE_LINE 00000021 "               (.*?)       # value"
NSQ_SOURCE_LINE 00000022 "               ([kmg]i?)?  # magnitude"
NSQ_SOURCE_LINE 00000023 "              $}ix"
NSQ_SOURCE_LINE 00000024 "       or croak \"don't understand '$test' as a test\";"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    my $comparison = $1 || '==';"
NSQ_SOURCE_LINE 00000027 "    my $target     = $2;"
NSQ_SOURCE_LINE 00000028 "    my $magnitude  = $3 || '';"
NSQ_SOURCE_LINE 00000029 "    $target *=           1000 if lc $magnitude eq 'k';"
NSQ_SOURCE_LINE 00000030 "    $target *=           1024 if lc $magnitude eq 'ki';"
NSQ_SOURCE_LINE 00000031 "    $target *=        1000000 if lc $magnitude eq 'm';"
NSQ_SOURCE_LINE 00000032 "    $target *=      1024*1024 if lc $magnitude eq 'mi';"
NSQ_SOURCE_LINE 00000033 "    $target *=     1000000000 if lc $magnitude eq 'g';"
NSQ_SOURCE_LINE 00000034 "    $target *= 1024*1024*1024 if lc $magnitude eq 'gi';"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    return \"$comparison $target\";"
NSQ_SOURCE_LINE 00000037 "}"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "sub test { $_[0]->( $_[1] ) }"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "1;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "__END__"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=head1 NAME"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "Number::Compare - numeric comparisons"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 " Number::Compare->new(\">1Ki\")->test(1025); # is 1025 > 1024"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 " my $c = Number::Compare->new(\">1M\");"
NSQ_SOURCE_LINE 00000054 " $c->(1_200_000);                          # slightly terser invocation"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "Number::Compare compiles a simple comparison to an anonymous"
NSQ_SOURCE_LINE 00000059 "subroutine, which you can call with a value to be tested again."
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "Now this would be very pointless, if Number::Compare didn't understand"
NSQ_SOURCE_LINE 00000062 "magnitudes."
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "The target value may use magnitudes of kilobytes (C<k>, C<ki>),"
NSQ_SOURCE_LINE 00000065 "megabytes (C<m>, C<mi>), or gigabytes (C<g>, C<gi>).  Those suffixed"
NSQ_SOURCE_LINE 00000066 "with an C<i> use the appropriate 2**n version in accordance with the"
NSQ_SOURCE_LINE 00000067 "IEC standard: http://physics.nist.gov/cuu/Units/binary.html"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "=head1 METHODS"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head2 ->new( $test )"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "Returns a new object that compares the specified test."
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=head2 ->test( $value )"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "A longhanded version of $compare->( $value ).  Predates blessed"
NSQ_SOURCE_LINE 00000078 "subroutine reference implementation."
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head2 ->parse_to_perl( $test )"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "Returns a perl code fragment equivalent to the test."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "Richard Clamp <richardc@unixbeard.net>"
