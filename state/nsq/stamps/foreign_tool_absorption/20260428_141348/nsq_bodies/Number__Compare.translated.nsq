NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "http://physics.nist.gov/cuu/Units/binary.html"
NSQ_SOURCE_LINE 00000098 ""
