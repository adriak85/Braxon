BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package LWP::MediaTypes;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "require Exporter;"
NSQ_SOURCE_LINE 00000004 "@ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000005 "@EXPORT = qw(guess_media_type media_suffix);"
NSQ_SOURCE_LINE 00000006 "@EXPORT_OK = qw(add_type add_encoding read_media_types);"
NSQ_SOURCE_LINE 00000007 "our $VERSION = '6.04';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use Scalar::Util qw(blessed);"
NSQ_SOURCE_LINE 00000011 "use Carp qw(croak);"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "# note: These hashes will also be filled with the entries found in"
NSQ_SOURCE_LINE 00000014 "# the 'media.types' file."
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "my %suffixType = ("
NSQ_SOURCE_LINE 00000017 "    'txt'   => 'text/plain',"
NSQ_SOURCE_LINE 00000018 "    'html'  => 'text/html',"
NSQ_SOURCE_LINE 00000019 "    'gif'   => 'image/gif',"
NSQ_SOURCE_LINE 00000020 "    'jpg'   => 'image/jpeg',"
NSQ_SOURCE_LINE 00000021 "    'xml'   => 'text/xml',"
NSQ_SOURCE_LINE 00000022 ");"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "my %suffixExt = ("
NSQ_SOURCE_LINE 00000025 "    'text/plain' => 'txt',"
NSQ_SOURCE_LINE 00000026 "    'text/html'  => 'html',"
NSQ_SOURCE_LINE 00000027 "    'image/gif'  => 'gif',"
NSQ_SOURCE_LINE 00000028 "    'image/jpeg' => 'jpg',"
NSQ_SOURCE_LINE 00000029 "    'text/xml'   => 'xml',"
NSQ_SOURCE_LINE 00000030 ");"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "#XXX: there should be some way to define this in the media.types files."
NSQ_SOURCE_LINE 00000033 "my %suffixEncoding = ("
NSQ_SOURCE_LINE 00000034 "    'Z'   => 'compress',"
NSQ_SOURCE_LINE 00000035 "    'gz'  => 'gzip',"
NSQ_SOURCE_LINE 00000036 "    'hqx' => 'x-hqx',"
NSQ_SOURCE_LINE 00000037 "    'uu'  => 'x-uuencode',"
NSQ_SOURCE_LINE 00000038 "    'z'   => 'x-pack',"
NSQ_SOURCE_LINE 00000039 "    'bz2' => 'x-bzip2',"
NSQ_SOURCE_LINE 00000040 ");"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "read_media_types();"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "sub guess_media_type"
NSQ_SOURCE_LINE 00000047 "{"
NSQ_SOURCE_LINE 00000048 "    my($file, $header) = @_;"
NSQ_SOURCE_LINE 00000049 "    return undef unless defined $file;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    my $fullname;"
NSQ_SOURCE_LINE 00000052 "    if (ref $file) {"
NSQ_SOURCE_LINE 00000053 "        croak(\"Unable to determine filetype on unblessed refs\") unless blessed($file);"
NSQ_SOURCE_LINE 00000054 "        if ($file->can('path')) {"
NSQ_SOURCE_LINE 00000055 "            $file = $file->path;"
NSQ_SOURCE_LINE 00000056 "        }"
NSQ_SOURCE_LINE 00000057 "        elsif ($file->can('filename')) {"
NSQ_SOURCE_LINE 00000058 "            $fullname = $file->filename;"
NSQ_SOURCE_LINE 00000059 "        }"
NSQ_SOURCE_LINE 00000060 "        else {"
NSQ_SOURCE_LINE 00000061 "            $fullname = \"\" . $file;"
NSQ_SOURCE_LINE 00000062 "        }"
NSQ_SOURCE_LINE 00000063 "    }"
NSQ_SOURCE_LINE 00000064 "    else {"
NSQ_SOURCE_LINE 00000065 "\t$fullname = $file;  # enable peek at actual file"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "    my @encoding = ();"
NSQ_SOURCE_LINE 00000069 "    my $ct = undef;"
NSQ_SOURCE_LINE 00000070 "    for (file_exts($file)) {"
NSQ_SOURCE_LINE 00000071 "\t# first check this dot part as encoding spec"
NSQ_SOURCE_LINE 00000072 "\tif (exists $suffixEncoding{$_}) {"
NSQ_SOURCE_LINE 00000073 "\t    unshift(@encoding, $suffixEncoding{$_});"
NSQ_SOURCE_LINE 00000074 "\t    next;"
NSQ_SOURCE_LINE 00000075 "\t}"
NSQ_SOURCE_LINE 00000076 "\tif (exists $suffixEncoding{lc $_}) {"
NSQ_SOURCE_LINE 00000077 "\t    unshift(@encoding, $suffixEncoding{lc $_});"
NSQ_SOURCE_LINE 00000078 "\t    next;"
NSQ_SOURCE_LINE 00000079 "\t}"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "\t# check content-type"
NSQ_SOURCE_LINE 00000082 "\tif (exists $suffixType{$_}) {"
NSQ_SOURCE_LINE 00000083 "\t    $ct = $suffixType{$_};"
NSQ_SOURCE_LINE 00000084 "\t    last;"
NSQ_SOURCE_LINE 00000085 "\t}"
NSQ_SOURCE_LINE 00000086 "\tif (exists $suffixType{lc $_}) {"
NSQ_SOURCE_LINE 00000087 "\t    $ct = $suffixType{lc $_};"
NSQ_SOURCE_LINE 00000088 "\t    last;"
NSQ_SOURCE_LINE 00000089 "\t}"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "\t# don't know nothing about this dot part, bail out"
NSQ_SOURCE_LINE 00000092 "\tlast;"
NSQ_SOURCE_LINE 00000093 "    }"
NSQ_SOURCE_LINE 00000094 "    unless (defined $ct) {"
NSQ_SOURCE_LINE 00000095 "\t# Take a look at the file"
NSQ_SOURCE_LINE 00000096 "\tif (defined $fullname) {"
NSQ_SOURCE_LINE 00000097 "\t    $ct = (-T $fullname) ? \"text/plain\" : \"application/octet-stream\";"
NSQ_SOURCE_LINE 00000098 "\t}"
NSQ_SOURCE_LINE 00000099 "\telse {"
NSQ_SOURCE_LINE 00000100 "\t    $ct = \"application/octet-stream\";"
NSQ_SOURCE_LINE 00000101 "\t}"
NSQ_SOURCE_LINE 00000102 "    }"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    if ($header) {"
NSQ_SOURCE_LINE 00000105 "\t$header->header('Content-Type' => $ct);"
NSQ_SOURCE_LINE 00000106 "\t$header->header('Content-Encoding' => \\@encoding) if @encoding;"
NSQ_SOURCE_LINE 00000107 "    }"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    wantarray ? ($ct, @encoding) : $ct;"
NSQ_SOURCE_LINE 00000110 "}"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "sub media_suffix {"
NSQ_SOURCE_LINE 00000114 "    if (!wantarray && @_ == 1 && $_[0] !~ /\\*/) {"
NSQ_SOURCE_LINE 00000115 "\treturn $suffixExt{lc $_[0]};"
NSQ_SOURCE_LINE 00000116 "    }"
NSQ_SOURCE_LINE 00000117 "    my(@type) = @_;"
NSQ_SOURCE_LINE 00000118 "    my(@suffix, $ext, $type);"
NSQ_SOURCE_LINE 00000119 "    foreach (@type) {"
NSQ_SOURCE_LINE 00000120 "\tif (s/\\*/.*/) {"
NSQ_SOURCE_LINE 00000121 "\t    while(($ext,$type) = each(%suffixType)) {"
NSQ_SOURCE_LINE 00000122 "\t\tpush(@suffix, $ext) if $type =~ /^$_$/i;"
NSQ_SOURCE_LINE 00000123 "\t    }"
NSQ_SOURCE_LINE 00000124 "\t}"
NSQ_SOURCE_LINE 00000125 "\telse {"
NSQ_SOURCE_LINE 00000126 "\t    my $ltype = lc $_;"
NSQ_SOURCE_LINE 00000127 "\t    while(($ext,$type) = each(%suffixType)) {"
NSQ_SOURCE_LINE 00000128 "\t\tpush(@suffix, $ext) if lc $type eq $ltype;"
NSQ_SOURCE_LINE 00000129 "\t    }"
NSQ_SOURCE_LINE 00000130 "\t}"
NSQ_SOURCE_LINE 00000131 "    }"
NSQ_SOURCE_LINE 00000132 "    wantarray ? @suffix : $suffix[0];"
NSQ_SOURCE_LINE 00000133 "}"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "sub file_exts"
NSQ_SOURCE_LINE 00000137 "{"
NSQ_SOURCE_LINE 00000138 "    require File::Basename;"
NSQ_SOURCE_LINE 00000139 "    my @parts = reverse split(/\\./, File::Basename::basename($_[0]));"
NSQ_SOURCE_LINE 00000140 "    pop(@parts);        # never consider first part"
NSQ_SOURCE_LINE 00000141 "    @parts;"
NSQ_SOURCE_LINE 00000142 "}"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "sub add_type"
NSQ_SOURCE_LINE 00000146 "{"
NSQ_SOURCE_LINE 00000147 "    my($type, @exts) = @_;"
NSQ_SOURCE_LINE 00000148 "    for my $ext (@exts) {"
NSQ_SOURCE_LINE 00000149 "\t$ext =~ s/^\\.//;"
NSQ_SOURCE_LINE 00000150 "\t$suffixType{$ext} = $type;"
NSQ_SOURCE_LINE 00000151 "    }"
NSQ_SOURCE_LINE 00000152 "    $suffixExt{lc $type} = $exts[0] if @exts;"
NSQ_SOURCE_LINE 00000153 "}"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "sub add_encoding"
NSQ_SOURCE_LINE 00000157 "{"
NSQ_SOURCE_LINE 00000158 "    my($type, @exts) = @_;"
NSQ_SOURCE_LINE 00000159 "    for my $ext (@exts) {"
NSQ_SOURCE_LINE 00000160 "\t$ext =~ s/^\\.//;"
NSQ_SOURCE_LINE 00000161 "\t$suffixEncoding{$ext} = $type;"
NSQ_SOURCE_LINE 00000162 "    }"
NSQ_SOURCE_LINE 00000163 "}"
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "sub read_media_types"
NSQ_SOURCE_LINE 00000167 "{"
NSQ_SOURCE_LINE 00000168 "    my(@files) = @_;"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    local($/, $_) = (\"\\n\", undef);  # ensure correct $INPUT_RECORD_SEPARATOR"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    my @priv_files = ();"
NSQ_SOURCE_LINE 00000173 "    push(@priv_files, \"$ENV{HOME}/.media.types\", \"$ENV{HOME}/.mime.types\")"
NSQ_SOURCE_LINE 00000174 "\tif defined $ENV{HOME};  # Some doesn't have a home (for instance Win32)"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    # Try to locate \"media.types\" file, and initialize %suffixType from it"
NSQ_SOURCE_LINE 00000177 "    my $typefile;"
NSQ_SOURCE_LINE 00000178 "    unless (@files) {"
NSQ_SOURCE_LINE 00000179 "\t@files = map {\"$_/LWP/media.types\"} @INC;"
NSQ_SOURCE_LINE 00000180 "\tpush @files, @priv_files;"
NSQ_SOURCE_LINE 00000181 "    }"
NSQ_SOURCE_LINE 00000182 "    for $typefile (@files) {"
NSQ_SOURCE_LINE 00000183 "\tlocal(*TYPE);"
NSQ_SOURCE_LINE 00000184 "\topen(TYPE, $typefile) || next;"
NSQ_SOURCE_LINE 00000185 "\twhile (<TYPE>) {"
NSQ_SOURCE_LINE 00000186 "\t    next if /^\\s*#/; # comment line"
NSQ_SOURCE_LINE 00000187 "\t    next if /^\\s*$/; # blank line"
NSQ_SOURCE_LINE 00000188 "\t    s/#.*//;         # remove end-of-line comments"
NSQ_SOURCE_LINE 00000189 "\t    my($type, @exts) = split(' ', $_);"
NSQ_SOURCE_LINE 00000190 "\t    add_type($type, @exts);"
NSQ_SOURCE_LINE 00000191 "\t}"
NSQ_SOURCE_LINE 00000192 "\tclose(TYPE);"
NSQ_SOURCE_LINE 00000193 "    }"
NSQ_SOURCE_LINE 00000194 "}"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "1;"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "__END__"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "=head1 NAME"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "LWP::MediaTypes - guess media type for a file or a URL"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 " use LWP::MediaTypes qw(guess_media_type);"
NSQ_SOURCE_LINE 00000208 " $type = guess_media_type(\"/tmp/foo.gif\");"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "This module provides functions for handling media (also known as"
NSQ_SOURCE_LINE 00000213 "MIME) types and encodings.  The mapping from file extensions to media"
NSQ_SOURCE_LINE 00000214 "types is defined by the F<media.types> file.  If the F<~/.media.types>"
NSQ_SOURCE_LINE 00000215 "file exists it is used instead."
NSQ_SOURCE_LINE 00000216 "For backwards compatibility we will also look for F<~/.mime.types>."
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "The following functions are exported by default:"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=over 4"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=item guess_media_type( $filename )"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "=item guess_media_type( $uri )"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=item guess_media_type( $filename_or_object, $header_to_modify )"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "This function tries to guess media type and encoding for a file or objects that"
NSQ_SOURCE_LINE 00000229 "support the a C<path> or C<filename> method, eg, L<URI> or L<File::Temp> objects."
NSQ_SOURCE_LINE 00000230 "When an object does not support either method, it will be stringified to"
NSQ_SOURCE_LINE 00000231 "determine the filename."
NSQ_SOURCE_LINE 00000232 "It returns the content type, which is a string like C<\"text/html\">."
NSQ_SOURCE_LINE 00000233 "In array context it also returns any content encodings applied (in the"
NSQ_SOURCE_LINE 00000234 "order used to encode the file).  You can pass a URI object"
NSQ_SOURCE_LINE 00000235 "reference, instead of the file name."
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "If the type can not be deduced from looking at the file name,"
NSQ_SOURCE_LINE 00000238 "then guess_media_type() will let the C<-T> Perl operator take a look."
NSQ_SOURCE_LINE 00000239 "If this works (and C<-T> returns a TRUE value) then we return"
NSQ_SOURCE_LINE 00000240 "I<text/plain> as the type, otherwise we return"
NSQ_SOURCE_LINE 00000241 "I<application/octet-stream> as the type."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "The optional second argument should be a reference to a HTTP::Headers"
NSQ_SOURCE_LINE 00000244 "object or any object that implements the $obj->header method in a"
NSQ_SOURCE_LINE 00000245 "similar way.  When it is present the values of the"
NSQ_SOURCE_LINE 00000246 "'Content-Type' and 'Content-Encoding' will be set for this header."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=item media_suffix( $type, ... )"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "This function will return all suffixes that can be used to denote the"
NSQ_SOURCE_LINE 00000251 "specified media type(s).  Wildcard types can be used.  In a scalar"
NSQ_SOURCE_LINE 00000252 "context it will return the first suffix found. Examples:"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "  @suffixes = media_suffix('image/*', 'audio/basic');"
NSQ_SOURCE_LINE 00000255 "  $suffix = media_suffix('text/html');"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=back"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "The following functions are only exported by explicit request:"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=over 4"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=item add_type( $type, @exts )"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "Associate a list of file extensions with the given media type."
NSQ_SOURCE_LINE 00000266 "Example:"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "    add_type(\"x-world/x-vrml\" => qw(wrl vrml));"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "=item add_encoding( $type, @ext )"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "Associate a list of file extensions with an encoding type."
NSQ_SOURCE_LINE 00000273 "Example:"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 " add_encoding(\"x-gzip\" => \"gz\");"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=item read_media_types( @files )"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "Parse media types files and add the type mappings found there."
NSQ_SOURCE_LINE 00000280 "Example:"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "    read_media_types(\"conf/mime.types\");"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=back"
NSQ_SOURCE_LINE 00000285 ""
