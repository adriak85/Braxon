NSQ_SOURCE_LINE 00000001 "package Package::DeprecationManager;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.18';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Carp qw( croak );"
NSQ_SOURCE_LINE 00000009 "use List::Util 1.33 qw( any );"
NSQ_SOURCE_LINE 00000010 "use Package::Stash;"
NSQ_SOURCE_LINE 00000011 "use Params::Util qw( _HASH0 );"
NSQ_SOURCE_LINE 00000012 "use Sub::Install;"
NSQ_SOURCE_LINE 00000013 "use Sub::Util qw( set_subname );"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "sub import {"
NSQ_SOURCE_LINE 00000016 "    shift;"
NSQ_SOURCE_LINE 00000017 "    my %args = @_;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    croak"
NSQ_SOURCE_LINE 00000020 "        'You must provide a hash reference -deprecations parameter when importing Package::DeprecationManager'"
NSQ_SOURCE_LINE 00000021 "        unless $args{-deprecations} && _HASH0( $args{-deprecations} );"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    my %registry;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    my $caller = caller();"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "    my $orig_import = $caller->can('import');"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    my $import = _build_import( \\%registry, $orig_import );"
NSQ_SOURCE_LINE 00000030 "    my $warn"
NSQ_SOURCE_LINE 00000031 "        = _build_warn( \\%registry, $args{-deprecations}, $args{-ignore} );"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    # We need to remove this to prevent a 'subroutine redefined' warning."
NSQ_SOURCE_LINE 00000034 "    if ($orig_import) {"
NSQ_SOURCE_LINE 00000035 "        Package::Stash->new($caller)->remove_symbol('&import');"
NSQ_SOURCE_LINE 00000036 "    }"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    Sub::Install::install_sub("
NSQ_SOURCE_LINE 00000039 "        {"
NSQ_SOURCE_LINE 00000040 "            code => set_subname( $caller . '::import', $import ),"
NSQ_SOURCE_LINE 00000041 "            into => $caller,"
NSQ_SOURCE_LINE 00000042 "            as   => 'import',"
NSQ_SOURCE_LINE 00000043 "        }"
NSQ_SOURCE_LINE 00000044 "    );"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    Sub::Install::install_sub("
NSQ_SOURCE_LINE 00000047 "        {"
NSQ_SOURCE_LINE 00000048 "            code => set_subname( $caller . '::deprecated', $warn ),"
NSQ_SOURCE_LINE 00000049 "            into => $caller,"
NSQ_SOURCE_LINE 00000050 "            as   => 'deprecated',"
NSQ_SOURCE_LINE 00000051 "        }"
NSQ_SOURCE_LINE 00000052 "    );"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    return;"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub _build_import {"
NSQ_SOURCE_LINE 00000058 "    my $registry    = shift;"
NSQ_SOURCE_LINE 00000059 "    my $orig_import = shift;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    return sub {"
NSQ_SOURCE_LINE 00000062 "        my $class = shift;"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "        my @args;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "        my $api_version;"
NSQ_SOURCE_LINE 00000067 "        ## no critic (ControlStructures::ProhibitCStyleForLoops)"
NSQ_SOURCE_LINE 00000068 "        for ( my $i = 0; $i < @_; $i++ ) {"
NSQ_SOURCE_LINE 00000069 "            if ( $_[$i] eq '-api_version' || $_[$i] eq '-compatible' ) {"
NSQ_SOURCE_LINE 00000070 "                $api_version = $_[ ++$i ];"
NSQ_SOURCE_LINE 00000071 "            }"
NSQ_SOURCE_LINE 00000072 "            else {"
NSQ_SOURCE_LINE 00000073 "                push @args, $_[$i];"
NSQ_SOURCE_LINE 00000074 "            }"
NSQ_SOURCE_LINE 00000075 "        }"
NSQ_SOURCE_LINE 00000076 "        ## use critic"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "        my $caller = caller();"
NSQ_SOURCE_LINE 00000079 "        $registry->{$caller} = $api_version"
NSQ_SOURCE_LINE 00000080 "            if defined $api_version;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "        if ($orig_import) {"
NSQ_SOURCE_LINE 00000083 "            @_ = ( $class, @args );"
NSQ_SOURCE_LINE 00000084 "            goto &{$orig_import};"
NSQ_SOURCE_LINE 00000085 "        }"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "        return;"
NSQ_SOURCE_LINE 00000088 "    };"
NSQ_SOURCE_LINE 00000089 "}"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "sub _build_warn {"
NSQ_SOURCE_LINE 00000092 "    my $registry      = shift;"
NSQ_SOURCE_LINE 00000093 "    my $deprecated_at = shift;"
NSQ_SOURCE_LINE 00000094 "    my $ignore        = shift;"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "    my %ignore     = map  { $_ => 1 } grep { !ref } @{ $ignore || [] };"
NSQ_SOURCE_LINE 00000097 "    my @ignore_res = grep {ref} @{ $ignore || [] };"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    my %warned;"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    return sub {"
NSQ_SOURCE_LINE 00000102 "        my %args = @_ < 2 ? ( message => shift ) : @_;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "        my ( $package, undef, undef, $sub ) = caller(1);"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "        my $skipped = 1;"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "        if ( @ignore_res || keys %ignore ) {"
NSQ_SOURCE_LINE 00000109 "            while ("
NSQ_SOURCE_LINE 00000110 "                defined $package"
NSQ_SOURCE_LINE 00000111 "                && ( $ignore{$package} || any { $package =~ $_ } @ignore_res )"
NSQ_SOURCE_LINE 00000112 "            ) {"
NSQ_SOURCE_LINE 00000113 "                $package = caller( $skipped++ );"
NSQ_SOURCE_LINE 00000114 "            }"
NSQ_SOURCE_LINE 00000115 "        }"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "        $package = 'unknown package' unless defined $package;"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "        unless ( defined $args{feature} ) {"
NSQ_SOURCE_LINE 00000120 "            $args{feature} = $sub;"
NSQ_SOURCE_LINE 00000121 "        }"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "        my $compat_version = $registry->{$package};"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "        my $at = $deprecated_at->{ $args{feature} };"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "        return"
NSQ_SOURCE_LINE 00000128 "               if defined $compat_version"
NSQ_SOURCE_LINE 00000129 "            && defined $deprecated_at"
NSQ_SOURCE_LINE 00000130 "            && $compat_version lt $at;"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "        my $msg;"
NSQ_SOURCE_LINE 00000133 "        if ( defined $args{message} ) {"
NSQ_SOURCE_LINE 00000134 "            $msg = $args{message};"
NSQ_SOURCE_LINE 00000135 "        }"
NSQ_SOURCE_LINE 00000136 "        else {"
NSQ_SOURCE_LINE 00000137 "            $msg = \"$args{feature} has been deprecated\";"
NSQ_SOURCE_LINE 00000138 "            $msg .= \" since version $at\""
NSQ_SOURCE_LINE 00000139 "                if defined $at;"
NSQ_SOURCE_LINE 00000140 "        }"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "        return if $warned{$package}{ $args{feature} }{$msg};"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "        $warned{$package}{ $args{feature} }{$msg} = 1;"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "        # We skip at least two levels. One for this anon sub, and one for the"
NSQ_SOURCE_LINE 00000147 "        # sub calling it."
NSQ_SOURCE_LINE 00000148 "        local $Carp::CarpLevel = $Carp::CarpLevel + $skipped;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "        Carp::cluck($msg);"
NSQ_SOURCE_LINE 00000151 "    };"
NSQ_SOURCE_LINE 00000152 "}"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "1;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "# ABSTRACT: Manage deprecation warnings for your distribution"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "__END__"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=pod"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=head1 NAME"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "Package::DeprecationManager - Manage deprecation warnings for your distribution"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=head1 VERSION"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "version 0.18"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "  package My::Class;"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "  use Package::DeprecationManager -deprecations => {"
NSQ_SOURCE_LINE 00000177 "      'My::Class::foo' => '0.02',"
NSQ_SOURCE_LINE 00000178 "      'My::Class::bar' => '0.05',"
NSQ_SOURCE_LINE 00000179 "      'feature-X'      => '0.07',"
NSQ_SOURCE_LINE 00000180 "  };"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "  sub foo {"
NSQ_SOURCE_LINE 00000183 "      deprecated( 'Do not call foo!' );"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "      ..."
NSQ_SOURCE_LINE 00000186 "  }"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "  sub bar {"
NSQ_SOURCE_LINE 00000189 "      deprecated();"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "      ..."
NSQ_SOURCE_LINE 00000192 "  }"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "  sub baz {"
NSQ_SOURCE_LINE 00000195 "      my %args = @_;"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "      if ( $args{foo} ) {"
NSQ_SOURCE_LINE 00000198 "          deprecated("
NSQ_SOURCE_LINE 00000199 "              message => ...,"
NSQ_SOURCE_LINE 00000200 "              feature => 'feature-X',"
NSQ_SOURCE_LINE 00000201 "          );"
NSQ_SOURCE_LINE 00000202 "      }"
NSQ_SOURCE_LINE 00000203 "  }"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "  package Other::Class;"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "  use My::Class -api_version => '0.04';"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "  My::Class->new()->foo(); # warns"
NSQ_SOURCE_LINE 00000210 "  My::Class->new()->bar(); # does not warn"
NSQ_SOURCE_LINE 00000211 "  My::Class->new()->bar(); # does not warn again"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "This module allows you to manage a set of deprecations for one or more modules."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "When you import C<Package::DeprecationManager>, you must provide a set of"
NSQ_SOURCE_LINE 00000218 "C<-deprecations> as a hash ref. The keys are \"feature\" names, and the values"
NSQ_SOURCE_LINE 00000219 "are the version when that feature was deprecated."
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "In many cases, you can simply use the fully qualified name of a subroutine or"
NSQ_SOURCE_LINE 00000222 "method as the feature name. This works for cases where the whole subroutine is"
NSQ_SOURCE_LINE 00000223 "deprecated. However, the feature names can be any string. This is useful if you"
NSQ_SOURCE_LINE 00000224 "don't want to deprecate an entire subroutine, just a certain usage."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "You can also provide an optional array reference in the C<-ignore> parameter."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "The values to be ignored can be package names or regular expressions (made with"
NSQ_SOURCE_LINE 00000229 "C<qr//>).  Use this to ignore packages in your distribution that can appear on"
NSQ_SOURCE_LINE 00000230 "the call stack when a deprecated feature is used."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "As part of the import process, C<Package::DeprecationManager> will export two"
NSQ_SOURCE_LINE 00000233 "subroutines into its caller. It provides an C<import()> sub for the caller and"
NSQ_SOURCE_LINE 00000234 "a C<deprecated()> sub."
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "The C<import()> sub allows callers of I<your> class to specify an"
NSQ_SOURCE_LINE 00000237 "C<-api_version> parameter. If this is supplied, then deprecation warnings are"
NSQ_SOURCE_LINE 00000238 "only issued for deprecations with API versions earlier than the one specified."
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "You must call the C<deprecated()> sub in each deprecated subroutine. When"
NSQ_SOURCE_LINE 00000241 "called, it will issue a warning using C<Carp::cluck()>."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "The C<deprecated()> sub can be called in several ways. If you do not pass any"
NSQ_SOURCE_LINE 00000244 "arguments, it will generate an appropriate warning message. If you pass a"
NSQ_SOURCE_LINE 00000245 "single argument, this is used as the warning message."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "Finally, you can call it with named arguments. Currently, the only allowed"
NSQ_SOURCE_LINE 00000248 "names are C<message> and C<feature>. The C<feature> argument should correspond"
NSQ_SOURCE_LINE 00000249 "to the feature name passed in the C<-deprecations> hash."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "If you don't explicitly specify a feature, the C<deprecated()> sub uses"
NSQ_SOURCE_LINE 00000252 "C<caller()> to identify its caller, using its fully qualified subroutine name."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "A given deprecation warning is only issued once for a given package. This"
NSQ_SOURCE_LINE 00000255 "module tracks this based on both the feature name I<and> the error message"
NSQ_SOURCE_LINE 00000256 "itself. This means that if you provide several different error messages for the"
NSQ_SOURCE_LINE 00000257 "same feature, all of those errors will appear."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=head2 Other import() subs"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "This module works by installing an C<import> sub in any package that uses it."
NSQ_SOURCE_LINE 00000262 "If that package I<already> has an C<import> sub, then that C<import> will be"
NSQ_SOURCE_LINE 00000263 "called after any arguments passed for C<Package::DeprecationManager> are"
NSQ_SOURCE_LINE 00000264 "stripped out. You need to define your C<import> sub before you C<use"
NSQ_SOURCE_LINE 00000265 "Package::DeprecationManager> to make this work:"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "  package HasExporter;"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "  use Exporter qw( import );"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "  use Package::DeprecationManager -deprecations => {"
NSQ_SOURCE_LINE 00000272 "      'HasExporter::foo' => '0.02',"
NSQ_SOURCE_LINE 00000273 "  };"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "  our @EXPORT_OK = qw( some_sub another_sub );"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=head1 DONATIONS"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "If you'd like to thank me for the work I've done on this module, please"
NSQ_SOURCE_LINE 00000280 "consider making a \"donation\" to me via PayPal. I spend a lot of free time"
NSQ_SOURCE_LINE 00000281 "creating free software, and would appreciate any support you'd care to offer."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "Please note that B<I am not suggesting that you must do this> in order for me"
NSQ_SOURCE_LINE 00000284 "to continue working on this particular software. I will continue to do so,"
NSQ_SOURCE_LINE 00000285 "inasmuch as I have in the past, for as long as it interests me."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "Similarly, a donation made in this way will probably not make me work on this"
NSQ_SOURCE_LINE 00000288 "software much more, unless I get so many donations that I can consider working"
NSQ_SOURCE_LINE 00000289 "on free software full time, which seems unlikely at best."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "To donate, log into PayPal and send money to autarch@urth.org or use the button"
NSQ_SOURCE_LINE 00000292 "on this page: L<http://www.urth.org/~autarch/fs-donation.html>"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=head1 CREDITS"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "The idea for this functionality and some of its implementation was originally"
NSQ_SOURCE_LINE 00000297 "created as L<Class::MOP::Deprecated> by Goro Fuji."
NSQ_SOURCE_LINE 00000298 ""
