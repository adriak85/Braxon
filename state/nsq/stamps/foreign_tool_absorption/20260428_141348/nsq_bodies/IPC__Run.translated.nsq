BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package IPC::Run;"
NSQ_SOURCE_LINE 00000002 "use bytes;"
NSQ_SOURCE_LINE 00000003 ""
NSQ_SOURCE_LINE 00000004 "=pod"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "=for markdown [![testsuite](https://github.com/cpan-authors/IPC-Run/actions/workflows/testsuite.yml/badge.svg)](https://github.com/cpan-authors/IPC-Run/actions/workflows/testsuite.yml)"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "=head1 NAME"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "IPC::Run - system() and background procs w/ piping, redirs, ptys (Unix, Win32)"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "   ## First,a command to run:"
NSQ_SOURCE_LINE 00000015 "      my @cat = qw( cat );"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "   ## Using run() instead of system():"
NSQ_SOURCE_LINE 00000018 "      use IPC::Run qw( run timeout );"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "      run \\@cat, \\$in, \\$out, \\$err, timeout( 10 ) or die \"cat: $?\";"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "      # Can do I/O to sub refs and filenames, too:"
NSQ_SOURCE_LINE 00000023 "      run \\@cat, '<', \"in.txt\", \\&out, \\&err or die \"cat: $?\";"
NSQ_SOURCE_LINE 00000024 "      run \\@cat, '<', \"in.txt\", '>>', \"out.txt\", '2>>', \"err.txt\";"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "      # Redirecting using pseudo-terminals instead of pipes."
NSQ_SOURCE_LINE 00000028 "      run \\@cat, '<pty<', \\$in,  '>pty>', \\$out_and_err;"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "   ## Scripting subprocesses (like Expect):"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "      use IPC::Run qw( start pump finish timeout );"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "      # Incrementally read from / write to scalars. "
NSQ_SOURCE_LINE 00000035 "      # $in is drained as it is fed to cat's stdin,"
NSQ_SOURCE_LINE 00000036 "      # $out accumulates cat's stdout"
NSQ_SOURCE_LINE 00000037 "      # $err accumulates cat's stderr"
NSQ_SOURCE_LINE 00000038 "      # $h is for \"harness\"."
NSQ_SOURCE_LINE 00000039 "      my $h = start \\@cat, \\$in, \\$out, \\$err, timeout( 10 );"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "      $in .= \"some input\\n\";"
NSQ_SOURCE_LINE 00000042 "      pump $h until $out =~ /input\\n/g;"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "      $in .= \"some more input\\n\";"
NSQ_SOURCE_LINE 00000045 "      pump $h until $out =~ /\\G.*more input\\n/;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "      $in .= \"some final input\\n\";"
NSQ_SOURCE_LINE 00000048 "      finish $h or die \"cat returned $?\";"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "      warn $err if $err; "
NSQ_SOURCE_LINE 00000051 "      print $out;         ## All of cat's output"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "   # Piping between children"
NSQ_SOURCE_LINE 00000054 "      run \\@cat, '|', \\@gzip;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "   # Multiple children simultaneously (run() blocks until all"
NSQ_SOURCE_LINE 00000057 "   # children exit, use start() for background execution):"
NSQ_SOURCE_LINE 00000058 "      run \\@foo1, '&', \\@foo2;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "   # Calling \\&set_up_child in the child before it executes the"
NSQ_SOURCE_LINE 00000061 "   # command (only works on systems with true fork() & exec())"
NSQ_SOURCE_LINE 00000062 "   # exceptions thrown in set_up_child() will be propagated back"
NSQ_SOURCE_LINE 00000063 "   # to the parent and thrown from run()."
NSQ_SOURCE_LINE 00000064 "      run \\@cat, \\$in, \\$out,"
NSQ_SOURCE_LINE 00000065 "         init => \\&set_up_child;"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "   # Read from / write to file handles you open and close"
NSQ_SOURCE_LINE 00000068 "      open IN,  '<in.txt'  or die $!;"
NSQ_SOURCE_LINE 00000069 "      open OUT, '>out.txt' or die $!;"
NSQ_SOURCE_LINE 00000070 "      print OUT \"preamble\\n\";"
NSQ_SOURCE_LINE 00000071 "      run \\@cat, \\*IN, \\*OUT or die \"cat returned $?\";"
NSQ_SOURCE_LINE 00000072 "      print OUT \"postamble\\n\";"
NSQ_SOURCE_LINE 00000073 "      close IN;"
NSQ_SOURCE_LINE 00000074 "      close OUT;"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "   # Create pipes for you to read / write (like IPC::Open2 & 3)."
NSQ_SOURCE_LINE 00000077 "      $h = start"
NSQ_SOURCE_LINE 00000078 "         \\@cat,"
NSQ_SOURCE_LINE 00000079 "            '<pipe', \\*IN, # may also be a lexical filehandle e.g. \\my $infh"
NSQ_SOURCE_LINE 00000080 "            '>pipe', \\*OUT,"
NSQ_SOURCE_LINE 00000081 "            '2>pipe', \\*ERR "
NSQ_SOURCE_LINE 00000082 "         or die \"cat returned $?\";"
NSQ_SOURCE_LINE 00000083 "      print IN \"some input\\n\";"
NSQ_SOURCE_LINE 00000084 "      close IN;"
NSQ_SOURCE_LINE 00000085 "      print <OUT>, <ERR>;"
NSQ_SOURCE_LINE 00000086 "      finish $h;"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "   # Mixing input and output modes"
NSQ_SOURCE_LINE 00000089 "      run \\@cat, 'in.txt', \\&catch_some_out, \\*ERR_LOG;"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "   # Other redirection constructs"
NSQ_SOURCE_LINE 00000092 "      run \\@cat, '>&', \\$out_and_err;"
NSQ_SOURCE_LINE 00000093 "      run \\@cat, '2>&1';"
NSQ_SOURCE_LINE 00000094 "      run \\@cat, '0<&3';"
NSQ_SOURCE_LINE 00000095 "      run \\@cat, '<&-';"
NSQ_SOURCE_LINE 00000096 "      run \\@cat, '3<', \\$in3;"
NSQ_SOURCE_LINE 00000097 "      run \\@cat, '4>', \\$out4;"
NSQ_SOURCE_LINE 00000098 "      # etc."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "   # Passing options:"
NSQ_SOURCE_LINE 00000101 "      run \\@cat, 'in.txt', debug => 1;"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "   # Call this system's shell, returns TRUE on 0 exit code"
NSQ_SOURCE_LINE 00000104 "   # THIS IS THE OPPOSITE SENSE OF system()'s RETURN VALUE"
NSQ_SOURCE_LINE 00000105 "      run \"cat a b c\" or die \"cat returned $?\";"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "   # Launch a sub process directly, no shell.  Can't do redirection"
NSQ_SOURCE_LINE 00000108 "   # with this form, it's here to behave like system() with an"
NSQ_SOURCE_LINE 00000109 "   # inverted result."
NSQ_SOURCE_LINE 00000110 "      $r = run \"cat a b c\";"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "   # Read from a file in to a scalar"
NSQ_SOURCE_LINE 00000113 "      run io( \"filename\", 'r', \\$recv );"
NSQ_SOURCE_LINE 00000114 "      run io( \\*HANDLE,   'r', \\$recv );"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "IPC::Run allows you to run and interact with child processes using files, pipes,"
NSQ_SOURCE_LINE 00000119 "and pseudo-ttys.  Both system()-style and scripted usages are supported and"
NSQ_SOURCE_LINE 00000120 "may be mixed.  Likewise, functional and OO API styles are both supported and"
NSQ_SOURCE_LINE 00000121 "may be mixed."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "Various redirection operators reminiscent of those seen on common Unix and DOS"
NSQ_SOURCE_LINE 00000124 "command lines are provided."
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=head1 SIMPLE QUICKSTART"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "Here's a quick guide to basic usage of using IPC::Run's C<run()> function."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=head2 Capturing output and errors from an external command"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "Say you want to run a command in your shell. We'll use C<ls> for"
NSQ_SOURCE_LINE 00000133 "simplicity, although there are far better ways to get a list of files, such"
NSQ_SOURCE_LINE 00000134 "as the C<glob()> function or the L<File::Find> module."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "The basic form of C<run()> has the command and its arguments passed as an"
NSQ_SOURCE_LINE 00000137 "arrayref in the first argument. The command cannot be a single string."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    @cmd = [ 'ls', '-a', '-l', '-r', '-t' ];    # Yes"
NSQ_SOURCE_LINE 00000140 "    @cmd = ( 'ls -a -l -r -t' );                # No"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "After the command, pass a scalar reference C<\\$in> for the input to pass"
NSQ_SOURCE_LINE 00000143 "in, and scalar references C<\\$out> and C<\\$err> to receive the content of"
NSQ_SOURCE_LINE 00000144 "stdout and stderr."
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    use IPC::Run qw( run );"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "    @cmd = qw( ls -l -a -r -t );"
NSQ_SOURCE_LINE 00000149 "    run( \\@cmd, \\$in, \\$out, \\$err ) or die $?;"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    print(\"\\$err is \", length($err), \" bytes long\\n\");"
NSQ_SOURCE_LINE 00000152 "    print($err, \"\\n\");"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    print(\"\\$out is \", length($out), \" bytes long\\n\");"
NSQ_SOURCE_LINE 00000155 "    print($out, \"\\n\");"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Running this will show something like:"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "    $err is 0 bytes long"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    $out is 1410 bytes long"
NSQ_SOURCE_LINE 00000162 "    total 392"
NSQ_SOURCE_LINE 00000163 "    drwxr-xr-x    3 andy  staff     96 Mar 17 11:53 .github"
NSQ_SOURCE_LINE 00000164 "    -rw-r--r--    1 andy  staff    158 Mar 17 11:53 .gitignore"
NSQ_SOURCE_LINE 00000165 "    ... etc ..."
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "Note that C<$out> and C<$err> are always defined after a call to C<run()>,"
NSQ_SOURCE_LINE 00000168 "even if they receive no data."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "=head2 Passing input to the external program"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "If you have input to pass in, put it in the C<$in> variables.  For example,"
NSQ_SOURCE_LINE 00000173 "to use the C<wc> command to count lines, words and characters in a block of"
NSQ_SOURCE_LINE 00000174 "text:"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    $in = <<'CARROLL';"
NSQ_SOURCE_LINE 00000177 "    'Twas brillig, and the slithy toves"
NSQ_SOURCE_LINE 00000178 "        Did gyre and gimble in the wabe:"
NSQ_SOURCE_LINE 00000179 "    All mimsy were the borogoves,"
NSQ_SOURCE_LINE 00000180 "        And the mome raths outgrabe."
NSQ_SOURCE_LINE 00000181 "    CARROLL"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    @cmd = qw( wc );"
NSQ_SOURCE_LINE 00000184 "    run( \\@cmd, \\$in, \\$out, \\$err ) or die $?;"
NSQ_SOURCE_LINE 00000185 "    print \"$out\";"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "This gives the output:"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "           4      23     140"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=head2 Handling errors"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "It's important to check the return code of C<run()> to see if the command"
NSQ_SOURCE_LINE 00000194 "ran successfully. C<run()> returns a boolean true on success, and false on"
NSQ_SOURCE_LINE 00000195 "failure. Note that this is the opposite of Perl's C<system()>, which"
NSQ_SOURCE_LINE 00000196 "returns 0 on success and a non-zero value on failures."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "For the specific subprocess error code, check C<$?> directly."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    @cmd = qw( tar xzvf nonexistent.tar );"
NSQ_SOURCE_LINE 00000201 "    if ( !run( \\@cmd, \\$in, \\$out, \\$err ) ) {"
NSQ_SOURCE_LINE 00000202 "        print \"\\$? = $?\\n\";"
NSQ_SOURCE_LINE 00000203 "        print \"err = $err\\n\";"
NSQ_SOURCE_LINE 00000204 "    }"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "Running this gives:"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "    $? = 256"
NSQ_SOURCE_LINE 00000209 "    err = tar: Error opening archive: Failed to open 'nonexistent.tar'"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "If the program does not exist, then C<run()> will C<die> and won't return"
NSQ_SOURCE_LINE 00000212 "at all.  For example:"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "    @cmd = qw( bogus-command );"
NSQ_SOURCE_LINE 00000215 "    my $rc = run( \\@cmd, \\$in, \\$out, \\$err );"
NSQ_SOURCE_LINE 00000216 "    print \"run returned \", ($rc ? \"true\" : \"false\"), \"\\n\";"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "Running this doesn't make it to the C<print> statement."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "    Command 'bogus-command' not found in [ list of paths ] at program.pl line N."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "To handle the possibility of a non-existent program, call C<run()> inside"
NSQ_SOURCE_LINE 00000223 "an C<eval>."
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "    my $rc;"
NSQ_SOURCE_LINE 00000226 "    eval { $rc = run( \\@cmd, \\$in, \\$out, \\$out ); 1; };"
NSQ_SOURCE_LINE 00000227 "    if ( !defined($rc) ) {"
NSQ_SOURCE_LINE 00000228 "        print \"run died: $@\\n\";"
NSQ_SOURCE_LINE 00000229 "    }"
NSQ_SOURCE_LINE 00000230 "    else {"
NSQ_SOURCE_LINE 00000231 "        if ( $rc ) {"
NSQ_SOURCE_LINE 00000232 "            print \"run returned true\\n\";"
NSQ_SOURCE_LINE 00000233 "        }"
NSQ_SOURCE_LINE 00000234 "        else {"
NSQ_SOURCE_LINE 00000235 "            print \"run returned false\\n\";"
NSQ_SOURCE_LINE 00000236 "            print \"\\$? = $?\\n\";"
NSQ_SOURCE_LINE 00000237 "        }"
NSQ_SOURCE_LINE 00000238 "    }"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "=head2 And beyond"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "That's the basics of using C<run()> as a replacement for C<system()>. If you'd"
NSQ_SOURCE_LINE 00000243 "like to do more, such as having subprocesses communicate with each other,"
NSQ_SOURCE_LINE 00000244 "setting timeouts on long-running processes, kill running subprocesses,"
NSQ_SOURCE_LINE 00000245 "redirecting output, closing file descriptors and much much MUCH more, read on."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "=head1 THE DETAILS"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "Before digging in to the details a few LIMITATIONS are important enough"
NSQ_SOURCE_LINE 00000250 "to be mentioned right up front:"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "=over"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=item Win32 Support"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "Win32 support is working but B<EXPERIMENTAL>, but does pass all relevant tests"
NSQ_SOURCE_LINE 00000257 "on NT 4.0.  See L</Win32 LIMITATIONS>."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=item pty Support"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "If you need pty support, IPC::Run should work well enough most of the"
NSQ_SOURCE_LINE 00000262 "time, but IO::Pty is being improved, and IPC::Run will be improved to"
NSQ_SOURCE_LINE 00000263 "use IO::Pty's new features when it is released."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "The basic problem is that the pty needs to initialize itself before the"
NSQ_SOURCE_LINE 00000266 "parent writes to the master pty, or the data written gets lost.  So"
NSQ_SOURCE_LINE 00000267 "IPC::Run does a sleep(1) in the parent after forking to (hopefully) give"
NSQ_SOURCE_LINE 00000268 "the child a chance to run.  This is a kludge that works well on non"
NSQ_SOURCE_LINE 00000269 "heavily loaded systems :(."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "ptys are not supported yet under Win32, but will be emulated..."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=item Debugging Tip"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "You may use the environment variable C<IPCRUNDEBUG> to see what's going on"
NSQ_SOURCE_LINE 00000276 "under the hood:"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "   $ IPCRUNDEBUG=basic   myscript     # prints minimal debugging"
NSQ_SOURCE_LINE 00000279 "   $ IPCRUNDEBUG=data    myscript     # prints all data reads/writes"
NSQ_SOURCE_LINE 00000280 "   $ IPCRUNDEBUG=details myscript     # prints lots of low-level details"
NSQ_SOURCE_LINE 00000281 "   $ IPCRUNDEBUG=gory    myscript     # (Win32 only) prints data moving through"
NSQ_SOURCE_LINE 00000282 "                                      # the helper processes."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=back"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=head2 Harnesses"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "Child processes and I/O handles are gathered in to a harness, then"
NSQ_SOURCE_LINE 00000289 "started and run until the processing is finished or aborted."
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=head2 run() vs. start(); pump(); finish();"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "There are two modes you can run harnesses in: run() functions as an"
NSQ_SOURCE_LINE 00000294 "enhanced system(), and start()/pump()/finish() allow for background"
NSQ_SOURCE_LINE 00000295 "processes and scripted interactions with them."
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "When using run(), all data to be sent to the harness is set up in"
NSQ_SOURCE_LINE 00000298 "advance (though one can feed subprocesses input from subroutine refs to"
NSQ_SOURCE_LINE 00000299 "get around this limitation). The harness is run and all output is"
NSQ_SOURCE_LINE 00000300 "collected from it, then any child processes are waited for:"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "   run \\@cmd, \\<<IN, \\$out;"
NSQ_SOURCE_LINE 00000303 "   blah"
NSQ_SOURCE_LINE 00000304 "   IN"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "   ## To precompile harnesses and run them later:"
NSQ_SOURCE_LINE 00000307 "   my $h = harness \\@cmd, \\<<IN, \\$out;"
NSQ_SOURCE_LINE 00000308 "   blah"
NSQ_SOURCE_LINE 00000309 "   IN"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "   run $h;"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "The background and scripting API is provided by start(), pump(), and"
NSQ_SOURCE_LINE 00000314 "finish(): start() creates a harness if need be (by calling harness())"
NSQ_SOURCE_LINE 00000315 "and launches any subprocesses, pump() allows you to poll them for"
NSQ_SOURCE_LINE 00000316 "activity, and finish() then monitors the harnessed activities until they"
NSQ_SOURCE_LINE 00000317 "complete."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "   ## Build the harness, open all pipes, and launch the subprocesses"
NSQ_SOURCE_LINE 00000320 "   my $h = start \\@cat, \\$in, \\$out;"
NSQ_SOURCE_LINE 00000321 "   $in = \"first input\\n\";"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "   ## Now do I/O.  start() does no I/O."
NSQ_SOURCE_LINE 00000324 "   pump $h while length $in;  ## Wait for all input to go"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "   ## Now do some more I/O."
NSQ_SOURCE_LINE 00000327 "   $in = \"second input\\n\";"
NSQ_SOURCE_LINE 00000328 "   pump $h until $out =~ /second input/;"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "   ## Clean up"
NSQ_SOURCE_LINE 00000331 "   finish $h or die \"cat returned $?\";"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "You can optionally compile the harness with harness() prior to"
NSQ_SOURCE_LINE 00000334 "start()ing or run()ing, and you may omit start() between harness() and"
NSQ_SOURCE_LINE 00000335 "pump().  You might want to do these things if you compile your harnesses"
NSQ_SOURCE_LINE 00000336 "ahead of time."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=head2 Using regexps to match output"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "As shown in most of the scripting examples, the read-to-scalar facility"
NSQ_SOURCE_LINE 00000341 "for gathering subcommand's output is often used with regular expressions"
NSQ_SOURCE_LINE 00000342 "to detect stopping points.  This is because subcommand output often"
NSQ_SOURCE_LINE 00000343 "arrives in dribbles and drabs, often only a character or line at a time."
NSQ_SOURCE_LINE 00000344 "This output is input for the main program and piles up in variables like"
NSQ_SOURCE_LINE 00000345 "the C<$out> and C<$err> in our examples."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "Regular expressions can be used to wait for appropriate output in"
NSQ_SOURCE_LINE 00000348 "several ways.  The C<cat> example in the previous section demonstrates"
NSQ_SOURCE_LINE 00000349 "how to pump() until some string appears in the output.  Here's an"
NSQ_SOURCE_LINE 00000350 "example that uses C<smb> to fetch files from a remote server:"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "   $h = harness \\@smbclient, \\$in, \\$out;"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "   $in = \"cd /src\\n\";"
NSQ_SOURCE_LINE 00000355 "   $h->pump until $out =~ /^smb.*> \\Z/m;"
NSQ_SOURCE_LINE 00000356 "   die \"error cding to /src:\\n$out\" if $out =~ \"ERR\";"
NSQ_SOURCE_LINE 00000357 "   $out = '';"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "   $in = \"mget *\\n\";"
NSQ_SOURCE_LINE 00000360 "   $h->pump until $out =~ /^smb.*> \\Z/m;"
NSQ_SOURCE_LINE 00000361 "   die \"error retrieving files:\\n$out\" if $out =~ \"ERR\";"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "   $in = \"quit\\n\";"
NSQ_SOURCE_LINE 00000364 "   $h->finish;"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "Notice that we carefully clear $out after the first command/response"
NSQ_SOURCE_LINE 00000367 "cycle? That's because IPC::Run does not delete $out when we continue,"
NSQ_SOURCE_LINE 00000368 "and we don't want to trip over the old output in the second"
NSQ_SOURCE_LINE 00000369 "command/response cycle."
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "Say you want to accumulate all the output in $out and analyze it"
NSQ_SOURCE_LINE 00000372 "afterwards.  Perl offers incremental regular expression matching using"
NSQ_SOURCE_LINE 00000373 "the C<m//gc> and pattern matching idiom and the C<\\G> assertion."
NSQ_SOURCE_LINE 00000374 "IPC::Run is careful not to disturb the current C<pos()> value for"
NSQ_SOURCE_LINE 00000375 "scalars it appends data to, so we could modify the above so as not to"
NSQ_SOURCE_LINE 00000376 "destroy $out by adding a couple of C</gc> modifiers.  The C</g> keeps us"
NSQ_SOURCE_LINE 00000377 "from tripping over the previous prompt and the C</c> keeps us from"
NSQ_SOURCE_LINE 00000378 "resetting the prior match position if the expected prompt doesn't"
NSQ_SOURCE_LINE 00000379 "materialize immediately:"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "   $h = harness \\@smbclient, \\$in, \\$out;"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "   $in = \"cd /src\\n\";"
NSQ_SOURCE_LINE 00000384 "   $h->pump until $out =~ /^smb.*> \\Z/mgc;"
NSQ_SOURCE_LINE 00000385 "   die \"error cding to /src:\\n$out\" if $out =~ \"ERR\";"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "   $in = \"mget *\\n\";"
NSQ_SOURCE_LINE 00000388 "   $h->pump until $out =~ /^smb.*> \\Z/mgc;"
NSQ_SOURCE_LINE 00000389 "   die \"error retrieving files:\\n$out\" if $out =~ \"ERR\";"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "   $in = \"quit\\n\";"
NSQ_SOURCE_LINE 00000392 "   $h->finish;"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "   analyze( $out );"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "When using this technique, you may want to preallocate $out to have"
NSQ_SOURCE_LINE 00000397 "plenty of memory or you may find that the act of growing $out each time"
NSQ_SOURCE_LINE 00000398 "new input arrives causes an C<O(length($out)^2)> slowdown as $out grows."
NSQ_SOURCE_LINE 00000399 "Say we expect no more than 10,000 characters of input at the most.  To"
NSQ_SOURCE_LINE 00000400 "preallocate memory to $out, do something like:"
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "   my $out = \"x\" x 10_000;"
NSQ_SOURCE_LINE 00000403 "   $out = \"\";"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "C<perl> will allocate at least 10,000 characters' worth of space, then"
NSQ_SOURCE_LINE 00000406 "mark the $out as having 0 length without freeing all that yummy RAM."
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "=head2 Timeouts and Timers"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "More than likely, you don't want your subprocesses to run forever, and"
NSQ_SOURCE_LINE 00000411 "sometimes it's nice to know that they're going a little slowly."
NSQ_SOURCE_LINE 00000412 "Timeouts throw exceptions after a some time has elapsed, timers merely"
NSQ_SOURCE_LINE 00000413 "cause pump() to return after some time has elapsed.  Neither is"
NSQ_SOURCE_LINE 00000414 "reset/restarted automatically."
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "Timeout objects are created by calling timeout( $interval ) and passing"
NSQ_SOURCE_LINE 00000417 "the result to run(), start() or harness().  The timeout period starts"
NSQ_SOURCE_LINE 00000418 "ticking just after all the child processes have been fork()ed or"
NSQ_SOURCE_LINE 00000419 "spawn()ed, and are polled for expiration in run(), pump() and finish()."
NSQ_SOURCE_LINE 00000420 "If/when they expire, an exception is thrown.  This is typically useful"
NSQ_SOURCE_LINE 00000421 "to keep a subprocess from taking too long."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "If a timeout occurs in run(), all child processes will be terminated and"
NSQ_SOURCE_LINE 00000424 "all file/pipe/ptty descriptors opened by run() will be closed.  File"
NSQ_SOURCE_LINE 00000425 "descriptors opened by the parent process and passed in to run() are not"
NSQ_SOURCE_LINE 00000426 "closed in this event."
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "If a timeout occurs in pump(), pump_nb(), or finish(), it's up to you to"
NSQ_SOURCE_LINE 00000429 "decide whether to kill_kill() all the children or to implement some more"
NSQ_SOURCE_LINE 00000430 "graceful fallback.  No I/O will be closed in pump(), pump_nb() or"
NSQ_SOURCE_LINE 00000431 "finish() by such an exception (though I/O is often closed down in those"
NSQ_SOURCE_LINE 00000432 "routines during the natural course of events)."
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "Often an exception is too harsh.  timer( $interval ) creates timer"
NSQ_SOURCE_LINE 00000435 "objects that merely prevent pump() from blocking forever.  This can be"
NSQ_SOURCE_LINE 00000436 "useful for detecting stalled I/O or printing a soothing message or \".\""
NSQ_SOURCE_LINE 00000437 "to pacify an anxious user."
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "Timeouts and timers can both be restarted at any time using the timer's"
NSQ_SOURCE_LINE 00000440 "start() method (this is not the start() that launches subprocesses).  To"
NSQ_SOURCE_LINE 00000441 "restart a timer, you need to keep a reference to the timer:"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "   ## Start with a nice long timeout to let smbclient connect.  If"
NSQ_SOURCE_LINE 00000444 "   ## pump or finish take too long, an exception will be thrown."
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 " my $h;"
NSQ_SOURCE_LINE 00000447 " eval {"
NSQ_SOURCE_LINE 00000448 "   $h = harness \\@smbclient, \\$in, \\$out, \\$err, ( my $t = timeout 30 );"
NSQ_SOURCE_LINE 00000449 "   sleep 11;  # No effect: timer not running yet"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "   start $h;"
NSQ_SOURCE_LINE 00000452 "   $in = \"cd /src\\n\";"
NSQ_SOURCE_LINE 00000453 "   pump $h until ! length $in;"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "   $in = \"ls\\n\";"
NSQ_SOURCE_LINE 00000456 "   ## Now use a short timeout, since this should be faster"
NSQ_SOURCE_LINE 00000457 "   $t->start( 5 );"
NSQ_SOURCE_LINE 00000458 "   pump $h until ! length $in;"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "   $t->start( 10 );  ## Give smbclient a little while to shut down."
NSQ_SOURCE_LINE 00000461 "   $h->finish;"
NSQ_SOURCE_LINE 00000462 " };"
NSQ_SOURCE_LINE 00000463 " if ( $@ ) {"
NSQ_SOURCE_LINE 00000464 "   my $x = $@;    ## Preserve $@ in case another exception occurs"
NSQ_SOURCE_LINE 00000465 "   $h->kill_kill; ## kill it gently, then brutally if need be, or just"
NSQ_SOURCE_LINE 00000466 "                   ## brutally on Win32."
NSQ_SOURCE_LINE 00000467 "   die $x;"
NSQ_SOURCE_LINE 00000468 " }"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "Timeouts and timers are I<not> checked once the subprocesses are shut"
NSQ_SOURCE_LINE 00000471 "down; they will not expire in the interval between the last valid"
NSQ_SOURCE_LINE 00000472 "process and when IPC::Run scoops up the processes' result codes, for"
NSQ_SOURCE_LINE 00000473 "instance."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "=head2 Spawning synchronization, child exception propagation"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "start() pauses the parent until the child executes the command or CODE"
NSQ_SOURCE_LINE 00000478 "reference and propagates any exceptions thrown (including exec()"
NSQ_SOURCE_LINE 00000479 "failure) back to the parent.  This has several pleasant effects: any"
NSQ_SOURCE_LINE 00000480 "exceptions thrown in the child, including exec() failure, come flying"
NSQ_SOURCE_LINE 00000481 "out of start() or run() as though they had occurred in the parent."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "This includes exceptions your code thrown from init subs.  In this"
NSQ_SOURCE_LINE 00000484 "example:"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "   eval {"
NSQ_SOURCE_LINE 00000487 "      run \\@cmd, init => sub { die \"blast it! foiled again!\" };"
NSQ_SOURCE_LINE 00000488 "   };"
NSQ_SOURCE_LINE 00000489 "   print $@;"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "the exception \"blast it! foiled again\" will be thrown from the child"
NSQ_SOURCE_LINE 00000492 "process (preventing the exec()) and printed by the parent."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "In situations like"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "   run \\@cmd1, \"|\", \\@cmd2, \"|\", \\@cmd3;"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "@cmd1 will be initted and exec()ed before @cmd2, and @cmd2 before @cmd3."
NSQ_SOURCE_LINE 00000499 "This can save time and prevent oddball errors emitted by later commands"
NSQ_SOURCE_LINE 00000500 "when earlier commands fail to execute.  Note that IPC::Run doesn't start"
NSQ_SOURCE_LINE 00000501 "any commands unless it can find the executables referenced by all"
NSQ_SOURCE_LINE 00000502 "commands.  These executables must pass both the C<-f> and C<-x> tests"
NSQ_SOURCE_LINE 00000503 "described in L<perlfunc>."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "Another nice effect is that init() subs can take their time doing things"
NSQ_SOURCE_LINE 00000506 "and there will be no problems caused by a parent continuing to execute"
NSQ_SOURCE_LINE 00000507 "before a child's init() routine is complete.  Say the init() routine"
NSQ_SOURCE_LINE 00000508 "needs to open a socket or a temp file that the parent wants to connect"
NSQ_SOURCE_LINE 00000509 "to; without this synchronization, the parent will need to implement a"
NSQ_SOURCE_LINE 00000510 "retry loop to wait for the child to run, since often, the parent gets a"
NSQ_SOURCE_LINE 00000511 "lot of things done before the child's first timeslice is allocated."
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "This is also quite necessary for pseudo-tty initialization, which needs"
NSQ_SOURCE_LINE 00000514 "to take place before the parent writes to the child via pty.  Writes"
NSQ_SOURCE_LINE 00000515 "that occur before the pty is set up can get lost."
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "A final, minor, nicety is that debugging output from the child will be"
NSQ_SOURCE_LINE 00000518 "emitted before the parent continues on, making for much clearer debugging"
NSQ_SOURCE_LINE 00000519 "output in complex situations."
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "The only drawback I can conceive of is that the parent can't continue to"
NSQ_SOURCE_LINE 00000522 "operate while the child is being initted.  If this ever becomes a"
NSQ_SOURCE_LINE 00000523 "problem in the field, we can implement an option to avoid this behavior,"
NSQ_SOURCE_LINE 00000524 "but I don't expect it to."
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "B<Win32>: executing CODE references isn't supported on Win32, see"
NSQ_SOURCE_LINE 00000527 "L</Win32 LIMITATIONS> for details."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=head2 Syntax"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "run(), start(), and harness() can all take a harness specification"
NSQ_SOURCE_LINE 00000532 "as input.  A harness specification is either a single string to be passed"
NSQ_SOURCE_LINE 00000533 "to the systems' shell:"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "   run \"echo 'hi there'\";"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "or a list of commands, io operations, and/or timers/timeouts to execute."
NSQ_SOURCE_LINE 00000538 "Consecutive commands must be separated by a pipe operator '|' or an '&'."
NSQ_SOURCE_LINE 00000539 "External commands are passed in as array references or L<IPC::Run::Win32Process>"
NSQ_SOURCE_LINE 00000540 "objects.  On systems supporting fork(), Perl code may be passed in as subs:"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "   run \\@cmd;"
NSQ_SOURCE_LINE 00000543 "   run \\@cmd1, '|', \\@cmd2;"
NSQ_SOURCE_LINE 00000544 "   run \\@cmd1, '&', \\@cmd2;"
NSQ_SOURCE_LINE 00000545 "   run \\&sub1;"
NSQ_SOURCE_LINE 00000546 "   run \\&sub1, '|', \\&sub2;"
NSQ_SOURCE_LINE 00000547 "   run \\&sub1, '&', \\&sub2;"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "'|' pipes the stdout of \\@cmd1 the stdin of \\@cmd2, just like a"
NSQ_SOURCE_LINE 00000550 "shell pipe.  '&' does not.  Child processes to the right of a '&'"
NSQ_SOURCE_LINE 00000551 "will have their stdin closed unless it's redirected-to."
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "L<IPC::Run::IO> objects may be passed in as well, whether or not"
NSQ_SOURCE_LINE 00000554 "child processes are also specified:"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "   run io( \"infile\", \">\", \\$in ), io( \"outfile\", \"<\", \\$in );"
NSQ_SOURCE_LINE 00000557 "      "
NSQ_SOURCE_LINE 00000558 "as can L<IPC::Run::Timer> objects:"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "   run \\@cmd, io( \"outfile\", \"<\", \\$in ), timeout( 10 );"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "Commands may be followed by scalar, sub, or i/o handle references for"
NSQ_SOURCE_LINE 00000563 "redirecting"
NSQ_SOURCE_LINE 00000564 "child process input & output:"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "   run \\@cmd,  \\undef,            \\$out;"
NSQ_SOURCE_LINE 00000567 "   run \\@cmd,  \\$in,              \\$out;"
NSQ_SOURCE_LINE 00000568 "   run \\@cmd1, \\&in, '|', \\@cmd2, \\*OUT;"
NSQ_SOURCE_LINE 00000569 "   run \\@cmd1, \\*IN, '|', \\@cmd2, \\&out;"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "This is known as succinct redirection syntax, since run(), start()"
NSQ_SOURCE_LINE 00000572 "and harness(), figure out which file descriptor to redirect and how."
NSQ_SOURCE_LINE 00000573 "File descriptor 0 is presumed to be an input for"
NSQ_SOURCE_LINE 00000574 "the child process, all others are outputs.  The assumed file"
NSQ_SOURCE_LINE 00000575 "descriptor always starts at 0, unless the command is being piped to,"
NSQ_SOURCE_LINE 00000576 "in which case it starts at 1."
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "To be explicit about your redirects, or if you need to do more complex"
NSQ_SOURCE_LINE 00000579 "things, there's also a redirection operator syntax:"
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "   run \\@cmd, '<', \\undef, '>',  \\$out;"
NSQ_SOURCE_LINE 00000582 "   run \\@cmd, '<', \\undef, '>&', \\$out_and_err;"
NSQ_SOURCE_LINE 00000583 "   run("
NSQ_SOURCE_LINE 00000584 "      \\@cmd1,"
NSQ_SOURCE_LINE 00000585 "         '<', \\$in,"
NSQ_SOURCE_LINE 00000586 "      '|', \\@cmd2,"
NSQ_SOURCE_LINE 00000587 "         \\$out"
NSQ_SOURCE_LINE 00000588 "   );"
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "Operator syntax is required if you need to do something other than simple"
NSQ_SOURCE_LINE 00000591 "redirection to/from scalars or subs, like duping or closing file descriptors"
NSQ_SOURCE_LINE 00000592 "or redirecting to/from a named file.  The operators are covered in detail"
NSQ_SOURCE_LINE 00000593 "below."
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "After each \\@cmd (or \\&foo), parsing begins in succinct mode and toggles to"
NSQ_SOURCE_LINE 00000596 "operator syntax mode when an operator (ie plain scalar, not a ref) is seen."
NSQ_SOURCE_LINE 00000597 "Once in"
NSQ_SOURCE_LINE 00000598 "operator syntax mode, parsing only reverts to succinct mode when a '|' or"
NSQ_SOURCE_LINE 00000599 "'&' is seen."
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "In succinct mode, each parameter after the \\@cmd specifies what to"
NSQ_SOURCE_LINE 00000602 "do with the next highest file descriptor. These File descriptor start"
NSQ_SOURCE_LINE 00000603 "with 0 (stdin) unless stdin is being piped to (C<'|', \\@cmd>), in which"
NSQ_SOURCE_LINE 00000604 "case they start with 1 (stdout).  Currently, being on the left of"
NSQ_SOURCE_LINE 00000605 "a pipe (C<\\@cmd, \\$out, \\$err, '|'>) does I<not> cause stdout to be"
NSQ_SOURCE_LINE 00000606 "skipped, though this may change since it's not as DWIMerly as it"
NSQ_SOURCE_LINE 00000607 "could be.  Only stdin is assumed to be an"
NSQ_SOURCE_LINE 00000608 "input in succinct mode, all others are assumed to be outputs."
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 "If no piping or redirection is specified for a child, it will inherit"
NSQ_SOURCE_LINE 00000611 "the parent's open file handles as dictated by your system's"
NSQ_SOURCE_LINE 00000612 "close-on-exec behavior and the $^F flag, except that processes after a"
NSQ_SOURCE_LINE 00000613 "'&' will not inherit the parent's stdin. Also note that $^F does not"
NSQ_SOURCE_LINE 00000614 "affect file descriptors obtained via POSIX, since it only applies to"
NSQ_SOURCE_LINE 00000615 "full-fledged Perl file handles.  Such processes will have their stdin"
NSQ_SOURCE_LINE 00000616 "closed unless it has been redirected-to."
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "If you want to close a child processes stdin, you may do any of:"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "   run \\@cmd, \\undef;"
NSQ_SOURCE_LINE 00000621 "   run \\@cmd, \\\"\";"
NSQ_SOURCE_LINE 00000622 "   run \\@cmd, '<&-';"
NSQ_SOURCE_LINE 00000623 "   run \\@cmd, '0<&-';"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "Redirection is done by placing redirection specifications immediately "
NSQ_SOURCE_LINE 00000626 "after a command or child subroutine:"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "   run \\@cmd1,      \\$in, '|', \\@cmd2,      \\$out;"
NSQ_SOURCE_LINE 00000629 "   run \\@cmd1, '<', \\$in, '|', \\@cmd2, '>', \\$out;"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "If you omit the redirection operators, descriptors are counted"
NSQ_SOURCE_LINE 00000632 "starting at 0.  Descriptor 0 is assumed to be input, all others"
NSQ_SOURCE_LINE 00000633 "are outputs.  A leading '|' consumes descriptor 0, so this"
NSQ_SOURCE_LINE 00000634 "works as expected."
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "   run \\@cmd1, \\$in, '|', \\@cmd2, \\$out;"
NSQ_SOURCE_LINE 00000637 "   "
NSQ_SOURCE_LINE 00000638 "The parameter following a redirection operator can be a scalar ref,"
NSQ_SOURCE_LINE 00000639 "a subroutine ref, a file name, an open filehandle, or a closed"
NSQ_SOURCE_LINE 00000640 "filehandle."
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "If it's a scalar ref, the child reads input from or sends output to"
NSQ_SOURCE_LINE 00000643 "that variable:"
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "   $in = \"Hello World.\\n\";"
NSQ_SOURCE_LINE 00000646 "   run \\@cat, \\$in, \\$out;"
NSQ_SOURCE_LINE 00000647 "   print $out;"
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "Scalars used in incremental (start()/pump()/finish()) applications are treated"
NSQ_SOURCE_LINE 00000650 "as queues: input is removed from input scalars, resulting in them dwindling"
NSQ_SOURCE_LINE 00000651 "to '', and output is appended to output scalars.  This is not true of "
NSQ_SOURCE_LINE 00000652 "harnesses run() in batch mode."
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "It's usually wise to append new input to be sent to the child to the input"
NSQ_SOURCE_LINE 00000655 "queue, and you'll often want to zap output queues to '' before pumping."
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "   $h = start \\@cat, \\$in;"
NSQ_SOURCE_LINE 00000658 "   $in = \"line 1\\n\";"
NSQ_SOURCE_LINE 00000659 "   pump $h;"
NSQ_SOURCE_LINE 00000660 "   $in .= \"line 2\\n\";"
NSQ_SOURCE_LINE 00000661 "   pump $h;"
NSQ_SOURCE_LINE 00000662 "   $in .= \"line 3\\n\";"
NSQ_SOURCE_LINE 00000663 "   finish $h;"
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "The final call to finish() must be there: it allows the child process(es)"
NSQ_SOURCE_LINE 00000666 "to run to completion and waits for their exit values."
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "=head1 OBSTINATE CHILDREN"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "Interactive applications are usually optimized for human use.  This"
NSQ_SOURCE_LINE 00000671 "can help or hinder trying to interact with them through modules like"
NSQ_SOURCE_LINE 00000672 "IPC::Run.  Frequently, programs alter their behavior when they detect"
NSQ_SOURCE_LINE 00000673 "that stdin, stdout, or stderr are not connected to a tty, assuming that"
NSQ_SOURCE_LINE 00000674 "they are being run in batch mode.  Whether this helps or hurts depends"
NSQ_SOURCE_LINE 00000675 "on which optimizations change.  And there's often no way of telling"
NSQ_SOURCE_LINE 00000676 "what a program does in these areas other than trial and error and"
NSQ_SOURCE_LINE 00000677 "occasionally, reading the source.  This includes different versions"
NSQ_SOURCE_LINE 00000678 "and implementations of the same program."
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "All hope is not lost, however.  Most programs behave in reasonably"
NSQ_SOURCE_LINE 00000681 "tractable manners, once you figure out what it's trying to do."
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "Here are some of the issues you might need to be aware of."
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "=over"
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "=item *"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "fflush()ing stdout and stderr"
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "This lets the user see stdout and stderr immediately.  Many programs"
NSQ_SOURCE_LINE 00000692 "undo this optimization if stdout is not a tty, making them harder to"
NSQ_SOURCE_LINE 00000693 "manage by things like IPC::Run."
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "Many programs decline to fflush stdout or stderr if they do not"
NSQ_SOURCE_LINE 00000696 "detect a tty there.  Some ftp commands do this, for instance."
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "If this happens to you, look for a way to force interactive behavior,"
NSQ_SOURCE_LINE 00000699 "like a command line switch or command.  If you can't, you will"
NSQ_SOURCE_LINE 00000700 "need to use a pseudo terminal ('<pty<' and '>pty>')."
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "=item *"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "false prompts"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "Interactive programs generally do not guarantee that output from user"
NSQ_SOURCE_LINE 00000707 "commands won't contain a prompt string.  For example, your shell prompt"
NSQ_SOURCE_LINE 00000708 "might be a '$', and a file named '$' might be the only file in a directory"
NSQ_SOURCE_LINE 00000709 "listing."
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "This can make it hard to guarantee that your output parser won't be fooled"
NSQ_SOURCE_LINE 00000712 "into early termination of results."
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "To help work around this, you can see if the program can alter its"
NSQ_SOURCE_LINE 00000715 "prompt, and use something you feel is never going to occur in actual"
NSQ_SOURCE_LINE 00000716 "practice."
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "You should also look for your prompt to be the only thing on a line:"
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "   pump $h until $out =~ /^<SILLYPROMPT>\\s?\\z/m;"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "(use C<(?!\\n)\\Z> in place of C<\\z> on older perls)."
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "You can also take the approach that IPC::ChildSafe takes and emit a"
NSQ_SOURCE_LINE 00000725 "command with known output after each 'real' command you issue, then"
NSQ_SOURCE_LINE 00000726 "look for this known output.  See new_appender() and new_chunker() for"
NSQ_SOURCE_LINE 00000727 "filters that can help with this task."
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "If it's not convenient or possibly to alter a prompt or use a known"
NSQ_SOURCE_LINE 00000730 "command/response pair, you might need to autodetect the prompt in case"
NSQ_SOURCE_LINE 00000731 "the local version of the child program is different then the one"
NSQ_SOURCE_LINE 00000732 "you tested with, or if the user has control over the look & feel of"
NSQ_SOURCE_LINE 00000733 "the prompt."
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "=item *"
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "Refusing to accept input unless stdin is a tty."
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "Some programs, for security reasons, will only accept certain types"
NSQ_SOURCE_LINE 00000740 "of input from a tty.  su, notable, will not prompt for a password unless"
NSQ_SOURCE_LINE 00000741 "it's connected to a tty."
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "If this is your situation, use a pseudo terminal ('<pty<' and '>pty>')."
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "=item *"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "Not prompting unless connected to a tty."
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "Some programs don't prompt unless stdin or stdout is a tty.  See if you can"
NSQ_SOURCE_LINE 00000750 "turn prompting back on.  If not, see if you can come up with a command that"
NSQ_SOURCE_LINE 00000751 "you can issue after every real command and look for its output, as"
NSQ_SOURCE_LINE 00000752 "IPC::ChildSafe does.   There are two filters included with IPC::Run that"
NSQ_SOURCE_LINE 00000753 "can help with doing this: appender and chunker (see new_appender() and"
NSQ_SOURCE_LINE 00000754 "new_chunker())."
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "=item *"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "Different output format when not connected to a tty."
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "Some commands alter their formats to ease machine parsability when they"
NSQ_SOURCE_LINE 00000761 "aren't connected to a pipe.  This is actually good, but can be surprising."
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "=back"
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "=head1 PSEUDO TERMINALS"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "On systems providing pseudo terminals under /dev, IPC::Run can use IO::Pty"
NSQ_SOURCE_LINE 00000768 "(available on CPAN) to provide a terminal environment to subprocesses."
NSQ_SOURCE_LINE 00000769 "This is necessary when the subprocess really wants to think it's connected"
NSQ_SOURCE_LINE 00000770 "to a real terminal."
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "=head2 CAVEATS"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "Pseudo-terminals are not pipes, though they are similar.  Here are some"
NSQ_SOURCE_LINE 00000775 "differences to watch out for."
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "=over"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "=item Echoing"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "Sending to stdin will cause an echo on stdout, which occurs before each"
NSQ_SOURCE_LINE 00000782 "line is passed to the child program.  There is currently no way to"
NSQ_SOURCE_LINE 00000783 "disable this, although the child process can and should disable it for"
NSQ_SOURCE_LINE 00000784 "things like passwords."
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "=item Shutdown"
NSQ_SOURCE_LINE 00000787 ""
NSQ_SOURCE_LINE 00000788 "IPC::Run cannot close a pty until all output has been collected.  This"
NSQ_SOURCE_LINE 00000789 "means that it is not possible to send an EOF to stdin by half-closing"
NSQ_SOURCE_LINE 00000790 "the pty, as we can when using a pipe to stdin."
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "This means that you need to send the child process an exit command or"
NSQ_SOURCE_LINE 00000793 "signal, or run() / finish() will time out.  Be careful not to expect a"
NSQ_SOURCE_LINE 00000794 "prompt after sending the exit command."
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "=item Command line editing"
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 "Some subprocesses, notable shells that depend on the user's prompt"
NSQ_SOURCE_LINE 00000799 "settings, will reissue the prompt plus the command line input so far"
NSQ_SOURCE_LINE 00000800 "once for each character."
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "=item '>pty>' means '&>pty>', not '1>pty>'"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "The pseudo terminal redirects both stdout and stderr unless you specify"
NSQ_SOURCE_LINE 00000805 "a file descriptor.  If you want to grab stderr separately, do this:"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "   start \\@cmd, '<pty<', \\$in, '>pty>', \\$out, '2>', \\$err;"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "=item stdin, stdout, and stderr not inherited"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "Child processes harnessed to a pseudo terminal have their stdin, stdout,"
NSQ_SOURCE_LINE 00000812 "and stderr completely closed before any redirection operators take"
NSQ_SOURCE_LINE 00000813 "effect.  This casts off the bonds of the controlling terminal.  This is"
NSQ_SOURCE_LINE 00000814 "not done when using pipes."
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 "Right now, this affects all children in a harness that has a pty in use,"
NSQ_SOURCE_LINE 00000817 "even if that pty would not affect a particular child.  That's a bug and"
NSQ_SOURCE_LINE 00000818 "will be fixed.  Until it is, it's best not to mix-and-match children."
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "=back"
NSQ_SOURCE_LINE 00000821 ""
NSQ_SOURCE_LINE 00000822 "=head2 Redirection Operators"
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "   Operator       SHNP   Description"
NSQ_SOURCE_LINE 00000825 "   ========       ====   ==========="
NSQ_SOURCE_LINE 00000826 "   <, N<          SHN    Redirects input to a child's fd N (0 assumed)"
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "   >, N>          SHN    Redirects output from a child's fd N (1 assumed)"
NSQ_SOURCE_LINE 00000829 "   >>, N>>        SHN    Like '>', but appends to scalars or named files"
NSQ_SOURCE_LINE 00000830 "   >&, &>         SHN    Redirects stdout & stderr from a child process"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "   <pty, N<pty    S      Like '<', but uses a pseudo-tty instead of a pipe"
NSQ_SOURCE_LINE 00000833 "   >pty, N>pty    S      Like '>', but uses a pseudo-tty instead of a pipe"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "   N<&M                  Dups input fd N to input fd M"
NSQ_SOURCE_LINE 00000836 "   M>&N                  Dups output fd N to input fd M"
NSQ_SOURCE_LINE 00000837 "   N<&-                  Closes fd N"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "   <pipe, N<pipe     P   Pipe opens H for caller to read, write, close (non-blocking write)."
NSQ_SOURCE_LINE 00000840 "   <blocking_pipe,             P   Like '<pipe', but the write end is blocking."
NSQ_SOURCE_LINE 00000841 "   N<blocking_pipe"
NSQ_SOURCE_LINE 00000842 "   >pipe, N>pipe     P   Pipe opens H for caller to read, write, close."
NSQ_SOURCE_LINE 00000843 "                      "
NSQ_SOURCE_LINE 00000844 "'N' and 'M' are placeholders for integer file descriptor numbers.  The"
NSQ_SOURCE_LINE 00000845 "terms 'input' and 'output' are from the child process's perspective."
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "The SHNP field indicates what parameters an operator can take:"
NSQ_SOURCE_LINE 00000848 ""
NSQ_SOURCE_LINE 00000849 "   S: \\$scalar or \\&function references.  Filters may be used with"
NSQ_SOURCE_LINE 00000850 "      these operators (and only these)."
NSQ_SOURCE_LINE 00000851 "   H: \\*HANDLE or IO::Handle for caller to open, and close"
NSQ_SOURCE_LINE 00000852 "   N: \"file name\"."
NSQ_SOURCE_LINE 00000853 "   P: \\*HANDLE or lexical filehandle opened by IPC::Run as the parent end of a pipe, but read"
NSQ_SOURCE_LINE 00000854 "      and written to and closed by the caller (like IPC::Open3)."
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "=over"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "=item Redirecting input: [n]<, [n]<pipe, [n]<blocking_pipe"
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 "You can input the child reads on file descriptor number n to come from a"
NSQ_SOURCE_LINE 00000861 "scalar variable, subroutine, file handle, or a named file.  If stdin"
NSQ_SOURCE_LINE 00000862 "is not redirected, the parent's stdin is inherited."
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "   run \\@cat, \\undef          ## Closes child's stdin immediately"
NSQ_SOURCE_LINE 00000865 "      or die \"cat returned $?\"; "
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 "   run \\@cat, \\$in;"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "   run \\@cat, \\<<TOHERE;"
NSQ_SOURCE_LINE 00000870 "   blah"
NSQ_SOURCE_LINE 00000871 "   TOHERE"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "   run \\@cat, \\&input;       ## Calls &input, feeding data returned"
NSQ_SOURCE_LINE 00000874 "                              ## to child's.  Closes child's stdin"
NSQ_SOURCE_LINE 00000875 "                              ## when undef is returned."
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "Redirecting from named files requires you to use the input"
NSQ_SOURCE_LINE 00000878 "redirection operator:"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "   run \\@cat, '<.profile';"
NSQ_SOURCE_LINE 00000881 "   run \\@cat, '<', '.profile';"
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 "   open IN, \"<foo\";"
NSQ_SOURCE_LINE 00000884 "   run \\@cat, \\*IN;"
NSQ_SOURCE_LINE 00000885 "   run \\@cat, *IN{IO};"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "The form used second example here is the safest,"
NSQ_SOURCE_LINE 00000888 "since filenames like \"0\" and \"&more\\n\" won't confuse &run:"
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "You can't do either of"
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "   run \\@a, *IN;      ## INVALID"
NSQ_SOURCE_LINE 00000893 "   run \\@a, '<', *IN; ## BUGGY: Reads file named like \"*main::A\""
NSQ_SOURCE_LINE 00000894 "   "
NSQ_SOURCE_LINE 00000895 "because perl passes a scalar containing a string that"
NSQ_SOURCE_LINE 00000896 "looks like \"*main::A\" to &run, and &run can't tell the difference"
NSQ_SOURCE_LINE 00000897 "between that and a redirection operator or a file name.  &run guarantees"
NSQ_SOURCE_LINE 00000898 "that any scalar you pass after a redirection operator is a file name."
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "If your child process will take input from file descriptors other"
NSQ_SOURCE_LINE 00000901 "than 0 (stdin), you can use a redirection operator with any of the"
NSQ_SOURCE_LINE 00000902 "valid input forms (scalar ref, sub ref, etc.):"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "   run \\@cat, '3<', \\$in3;"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "When redirecting input from a scalar ref, the scalar ref is"
NSQ_SOURCE_LINE 00000907 "used as a queue.  This allows you to use &harness and pump() to"
NSQ_SOURCE_LINE 00000908 "feed incremental bits of input to a coprocess.  See L</harness> and"
NSQ_SOURCE_LINE 00000909 "L</pump> for more information."
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "The <pipe operator opens the write half of a pipe on the filehandle"
NSQ_SOURCE_LINE 00000912 "glob reference it takes as an argument:"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "   $h = start \\@cat, '<pipe', \\*IN;"
NSQ_SOURCE_LINE 00000915 "   print IN \"hello world\\n\";"
NSQ_SOURCE_LINE 00000916 "   close IN;"
NSQ_SOURCE_LINE 00000917 "   pump $h;"
NSQ_SOURCE_LINE 00000918 "   finish $h;"
NSQ_SOURCE_LINE 00000919 ""
NSQ_SOURCE_LINE 00000920 "B<Note>: The pipe must be closed before calling pump() for commands"
NSQ_SOURCE_LINE 00000921 "that buffer their output until stdin is closed (e.g. C<cat>).  For"
NSQ_SOURCE_LINE 00000922 "interactive commands that produce output in response to each line of"
NSQ_SOURCE_LINE 00000923 "input, you may interleave writes and pump() calls without closing"
NSQ_SOURCE_LINE 00000924 "first."
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "Unlike the other '<' operators, IPC::Run does nothing further with"
NSQ_SOURCE_LINE 00000927 "it: you are responsible for it.  The previous example is functionally"
NSQ_SOURCE_LINE 00000928 "equivalent to:"
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "   pipe( \\*R, \\*IN ) or die $!;"
NSQ_SOURCE_LINE 00000931 "   $h = start \\@cat, '<', \\*R;"
NSQ_SOURCE_LINE 00000932 "   print IN \"hello world\\n\";"
NSQ_SOURCE_LINE 00000933 "   close IN;"
NSQ_SOURCE_LINE 00000934 "   pump $h;"
NSQ_SOURCE_LINE 00000935 "   finish $h;"
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 "This is like the behavior of IPC::Open2 and IPC::Open3."
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "B<Note>: The write end of the pipe opened by C<< <pipe >> is set to"
NSQ_SOURCE_LINE 00000940 "B<non-blocking> mode.  This allows IPC::Run to fill the pipe buffer and"
NSQ_SOURCE_LINE 00000941 "continue to its select() loop without stalling.  However, if you write a"
NSQ_SOURCE_LINE 00000942 "large amount of data faster than the child process reads it, you may receive"
NSQ_SOURCE_LINE 00000943 "C<EAGAIN> / C<EWOULDBLOCK> errors from print().  If you need blocking writes"
NSQ_SOURCE_LINE 00000944 "(for example, when acting as the start of a pipeline where you want to write"
NSQ_SOURCE_LINE 00000945 "at the child's pace), use C<< <blocking_pipe >> instead:"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "   $h = start \\@wc, '<blocking_pipe', \\*IN;"
NSQ_SOURCE_LINE 00000948 "   print IN \"lots of data\\n\" x 32768;   ## won't get EAGAIN"
NSQ_SOURCE_LINE 00000949 "   close IN;"
NSQ_SOURCE_LINE 00000950 "   $h->finish;"
NSQ_SOURCE_LINE 00000951 ""
NSQ_SOURCE_LINE 00000952 "C<< <blocking_pipe >> behaves identically to C<< <pipe >>, but does not set"
NSQ_SOURCE_LINE 00000953 "the write end to non-blocking mode."
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 "B<Win32>: The handle returned is actually a socket handle, so you can"
NSQ_SOURCE_LINE 00000956 "use select() on it."
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "=item Redirecting output: [n]>, [n]>>, [n]>&[m], [n]>pipe"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "You can redirect any output the child emits"
NSQ_SOURCE_LINE 00000961 "to a scalar variable, subroutine, file handle, or file name.  You"
NSQ_SOURCE_LINE 00000962 "can have &run truncate or append to named files or scalars.  If"
NSQ_SOURCE_LINE 00000963 "you are redirecting stdin as well, or if the command is on the"
NSQ_SOURCE_LINE 00000964 "receiving end of a pipeline ('|'), you can omit the redirection"
NSQ_SOURCE_LINE 00000965 "operator:"
NSQ_SOURCE_LINE 00000966 ""
NSQ_SOURCE_LINE 00000967 "   @ls = ( 'ls' );"
NSQ_SOURCE_LINE 00000968 "   run \\@ls, \\undef, \\$out"
NSQ_SOURCE_LINE 00000969 "      or die \"ls returned $?\"; "
NSQ_SOURCE_LINE 00000970 ""
NSQ_SOURCE_LINE 00000971 "   run \\@ls, \\undef, \\&out;  ## Calls &out each time some output"
NSQ_SOURCE_LINE 00000972 "                              ## is received from the child's "
NSQ_SOURCE_LINE 00000973 "                              ## when undef is returned."
NSQ_SOURCE_LINE 00000974 ""
NSQ_SOURCE_LINE 00000975 "   run \\@ls, \\undef, '2>ls.err';"
NSQ_SOURCE_LINE 00000976 "   run \\@ls, '2>', 'ls.err';"
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 "The two parameter form guarantees that the filename"
NSQ_SOURCE_LINE 00000979 "will not be interpreted as a redirection operator:"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "   run \\@ls, '>', \"&more\";"
NSQ_SOURCE_LINE 00000982 "   run \\@ls, '2>', \">foo\\n\";"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "You can pass file handles you've opened for writing:"
NSQ_SOURCE_LINE 00000985 ""
NSQ_SOURCE_LINE 00000986 "   open( *OUT, \">out.txt\" );"
NSQ_SOURCE_LINE 00000987 "   open( *ERR, \">err.txt\" );"
NSQ_SOURCE_LINE 00000988 "   run \\@cat, \\*OUT, \\*ERR;"
NSQ_SOURCE_LINE 00000989 ""
NSQ_SOURCE_LINE 00000990 "Passing a scalar reference and a code reference requires a little"
NSQ_SOURCE_LINE 00000991 "more work, but allows you to capture all of the output in a scalar"
NSQ_SOURCE_LINE 00000992 "or each piece of output by a callback:"
NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "These two do the same things:"
NSQ_SOURCE_LINE 00000995 ""
NSQ_SOURCE_LINE 00000996 "   run( [ 'ls' ], '2>', sub { $err_out .= $_[0] } );"
NSQ_SOURCE_LINE 00000997 ""
NSQ_SOURCE_LINE 00000998 "does the same basic thing as:"
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "   run( [ 'ls' ], '2>', \\$err_out );"
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "The subroutine will be called each time some data is read from the child."
NSQ_SOURCE_LINE 00001003 ""
NSQ_SOURCE_LINE 00001004 "The >pipe operator is different in concept than the other '>' operators,"
NSQ_SOURCE_LINE 00001005 "although its syntax is similar:"
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "   $h = start \\@cat, $in, '>pipe', \\*OUT, '2>pipe', \\*ERR;"
NSQ_SOURCE_LINE 00001008 "   $in = \"hello world\\n\";"
NSQ_SOURCE_LINE 00001009 "   finish $h;"
NSQ_SOURCE_LINE 00001010 "   print <OUT>;"
NSQ_SOURCE_LINE 00001011 "   print <ERR>;"
NSQ_SOURCE_LINE 00001012 "   close OUT;"
NSQ_SOURCE_LINE 00001013 "   close ERR;"
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "causes two pipe to be created, with one end attached to cat's stdout"
NSQ_SOURCE_LINE 00001016 "and stderr, respectively, and the other left open on OUT and ERR, so"
NSQ_SOURCE_LINE 00001017 "that the script can manually"
NSQ_SOURCE_LINE 00001018 "read(), select(), etc. on them.  This is like"
NSQ_SOURCE_LINE 00001019 "the behavior of IPC::Open2 and IPC::Open3."
NSQ_SOURCE_LINE 00001020 ""
NSQ_SOURCE_LINE 00001021 "B<Win32>: The handle returned is actually a socket handle, so you can"
NSQ_SOURCE_LINE 00001022 "use select() on it."
NSQ_SOURCE_LINE 00001023 ""
NSQ_SOURCE_LINE 00001024 "=item Duplicating output descriptors: >&m, n>&m"
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "This duplicates output descriptor number n (default is 1 if n is omitted)"
NSQ_SOURCE_LINE 00001027 "from descriptor number m."
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "=item Duplicating input descriptors: <&m, n<&m"
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "This duplicates input descriptor number n (default is 0 if n is omitted)"
NSQ_SOURCE_LINE 00001032 "from descriptor number m"
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "=item Closing descriptors: <&-, 3<&-"
NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "This closes descriptor number n (default is 0 if n is omitted).  The"
NSQ_SOURCE_LINE 00001037 "following commands are equivalent:"
NSQ_SOURCE_LINE 00001038 ""
NSQ_SOURCE_LINE 00001039 "   run \\@cmd, \\undef;"
NSQ_SOURCE_LINE 00001040 "   run \\@cmd, '<&-';"
NSQ_SOURCE_LINE 00001041 "   run \\@cmd, '<in.txt', '<&-';"
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "Doing"
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "   run \\@cmd, \\$in, '<&-';    ## SIGPIPE recipe."
NSQ_SOURCE_LINE 00001046 ""
NSQ_SOURCE_LINE 00001047 "is dangerous: the parent will get a SIGPIPE if $in is not empty."
NSQ_SOURCE_LINE 00001048 ""
NSQ_SOURCE_LINE 00001049 "=item Redirecting both stdout and stderr: &>, >&, &>pipe, >pipe&"
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 "The following pairs of commands are equivalent:"
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "   run \\@cmd, '>&', \\$out;       run \\@cmd, '>', \\$out,     '2>&1';"
NSQ_SOURCE_LINE 00001054 "   run \\@cmd, '>&', 'out.txt';   run \\@cmd, '>', 'out.txt', '2>&1';"
NSQ_SOURCE_LINE 00001055 ""
NSQ_SOURCE_LINE 00001056 "etc."
NSQ_SOURCE_LINE 00001057 ""
NSQ_SOURCE_LINE 00001058 "File descriptor numbers are not permitted to the left or the right of"
NSQ_SOURCE_LINE 00001059 "these operators, and the '&' may occur on either end of the operator."
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "The '&>pipe' and '>pipe&' variants behave like the '>pipe' operator, except"
NSQ_SOURCE_LINE 00001062 "that both stdout and stderr write to the created pipe."
NSQ_SOURCE_LINE 00001063 ""
NSQ_SOURCE_LINE 00001064 "=item Redirection Filters"
NSQ_SOURCE_LINE 00001065 ""
NSQ_SOURCE_LINE 00001066 "Both input redirections and output redirections that use scalars or"
NSQ_SOURCE_LINE 00001067 "subs as endpoints may have an arbitrary number of filter subs placed"
NSQ_SOURCE_LINE 00001068 "between them and the child process.  This is useful if you want to"
NSQ_SOURCE_LINE 00001069 "receive output in chunks, or if you want to massage each chunk of"
NSQ_SOURCE_LINE 00001070 "data sent to the child.  To use this feature, you must use operator"
NSQ_SOURCE_LINE 00001071 "syntax:"
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "   run("
NSQ_SOURCE_LINE 00001074 "      \\@cmd"
NSQ_SOURCE_LINE 00001075 "         '<', \\&in_filter_2, \\&in_filter_1, $in,"
NSQ_SOURCE_LINE 00001076 "         '>', \\&out_filter_1, \\&in_filter_2, $out,"
NSQ_SOURCE_LINE 00001077 "   );"
NSQ_SOURCE_LINE 00001078 ""
NSQ_SOURCE_LINE 00001079 "This capability is not provided for IO handles or named files."
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "Two filters are provided by IPC::Run: appender and chunker.  Because"
NSQ_SOURCE_LINE 00001082 "these may take an argument, you need to use the constructor functions"
NSQ_SOURCE_LINE 00001083 "new_appender() and new_chunker() rather than using \\& syntax:"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "   run("
NSQ_SOURCE_LINE 00001086 "      \\@cmd"
NSQ_SOURCE_LINE 00001087 "         '<', new_appender( \"\\n\" ), $in,"
NSQ_SOURCE_LINE 00001088 "         '>', new_chunker, $out,"
NSQ_SOURCE_LINE 00001089 "   );"
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 "=back"
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "=head2 Just doing I/O"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "If you just want to do I/O to a handle or file you open yourself, you"
NSQ_SOURCE_LINE 00001096 "may specify a filehandle or filename instead of a command in the harness"
NSQ_SOURCE_LINE 00001097 "specification:"
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "   run io( \"filename\", '>', \\$recv );"
NSQ_SOURCE_LINE 00001100 ""
NSQ_SOURCE_LINE 00001101 "   $h = start io( $io, '>', \\$recv );"
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 "   $h = harness \\@cmd, '&', io( \"file\", '<', \\$send );"
NSQ_SOURCE_LINE 00001104 ""
NSQ_SOURCE_LINE 00001105 "=head2 Options"
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 "Options are passed in as name/value pairs:"
NSQ_SOURCE_LINE 00001108 ""
NSQ_SOURCE_LINE 00001109 "   run \\@cat, \\$in, debug => 1;"
NSQ_SOURCE_LINE 00001110 ""
NSQ_SOURCE_LINE 00001111 "If you pass the debug option, you may want to pass it in first, so you"
NSQ_SOURCE_LINE 00001112 "can see what parsing is going on:"
NSQ_SOURCE_LINE 00001113 ""
NSQ_SOURCE_LINE 00001114 "   run debug => 1, \\@cat, \\$in;"
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "=over"
NSQ_SOURCE_LINE 00001117 ""
NSQ_SOURCE_LINE 00001118 "=item debug"
NSQ_SOURCE_LINE 00001119 ""
NSQ_SOURCE_LINE 00001120 "Enables debugging output in parent and child.  Debugging info is emitted"
NSQ_SOURCE_LINE 00001121 "to the STDERR that was present when IPC::Run was first C<use()>ed (it's"
NSQ_SOURCE_LINE 00001122 "C<dup()>ed out of the way so that it can be redirected in children without"
NSQ_SOURCE_LINE 00001123 "having debugging output emitted on it)."
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "=back"
NSQ_SOURCE_LINE 00001126 ""
NSQ_SOURCE_LINE 00001127 "=head1 RETURN VALUES"
NSQ_SOURCE_LINE 00001128 ""
NSQ_SOURCE_LINE 00001129 "harness() and start() return a reference to an IPC::Run harness.  This is"
NSQ_SOURCE_LINE 00001130 "blessed in to the IPC::Run package, so you may make later calls to"
NSQ_SOURCE_LINE 00001131 "functions as members if you like:"
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "   $h = harness( ... );"
NSQ_SOURCE_LINE 00001134 "   $h->start;"
NSQ_SOURCE_LINE 00001135 "   $h->pump;"
NSQ_SOURCE_LINE 00001136 "   $h->finish;"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "   $h = start( .... );"
NSQ_SOURCE_LINE 00001139 "   $h->pump;"
NSQ_SOURCE_LINE 00001140 "   ..."
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "Of course, using method call syntax lets you deal with any IPC::Run"
NSQ_SOURCE_LINE 00001143 "subclasses that might crop up, but don't hold your breath waiting for"
NSQ_SOURCE_LINE 00001144 "any."
NSQ_SOURCE_LINE 00001145 ""
NSQ_SOURCE_LINE 00001146 "run() and finish() return TRUE when all subcommands exit with a 0 result"
NSQ_SOURCE_LINE 00001147 "code.  B<This is the opposite of perl's system() command>."
NSQ_SOURCE_LINE 00001148 ""
NSQ_SOURCE_LINE 00001149 "All routines raise exceptions (via die()) when error conditions are"
NSQ_SOURCE_LINE 00001150 "recognized.  A non-zero command result is not treated as an error"
NSQ_SOURCE_LINE 00001151 "condition, since some commands are tests whose results are reported "
NSQ_SOURCE_LINE 00001152 "in their exit codes."
NSQ_SOURCE_LINE 00001153 ""
NSQ_SOURCE_LINE 00001154 "=head1 ROUTINES"
NSQ_SOURCE_LINE 00001155 ""
NSQ_SOURCE_LINE 00001156 "=over"
NSQ_SOURCE_LINE 00001157 ""
NSQ_SOURCE_LINE 00001158 "=cut"
NSQ_SOURCE_LINE 00001159 ""
NSQ_SOURCE_LINE 00001160 "use strict;"
NSQ_SOURCE_LINE 00001161 "use warnings;"
NSQ_SOURCE_LINE 00001162 "use Exporter ();"
NSQ_SOURCE_LINE 00001163 "use vars qw{$VERSION @ISA @FILTER_IMP @FILTERS @API @EXPORT_OK %EXPORT_TAGS};"
NSQ_SOURCE_LINE 00001164 ""
NSQ_SOURCE_LINE 00001165 "BEGIN {"
NSQ_SOURCE_LINE 00001166 "    $VERSION = '20260402.0';"
NSQ_SOURCE_LINE 00001167 "    @ISA     = qw{ Exporter };"
NSQ_SOURCE_LINE 00001168 ""
NSQ_SOURCE_LINE 00001169 "    ## We use @EXPORT for the end user's convenience: there's only one function"
NSQ_SOURCE_LINE 00001170 "    ## exported, it's homonymous with the module, it's an unusual name, and"
NSQ_SOURCE_LINE 00001171 "    ## it can be suppressed by \"use IPC::Run ();\"."
NSQ_SOURCE_LINE 00001172 "    @FILTER_IMP = qw( input_avail get_more_input );"
NSQ_SOURCE_LINE 00001173 "    @FILTERS    = qw("
NSQ_SOURCE_LINE 00001174 "      new_appender"
NSQ_SOURCE_LINE 00001175 "      new_chunker"
NSQ_SOURCE_LINE 00001176 "      new_string_source"
NSQ_SOURCE_LINE 00001177 "      new_string_sink"
NSQ_SOURCE_LINE 00001178 "    );"
NSQ_SOURCE_LINE 00001179 "    @API = qw("
NSQ_SOURCE_LINE 00001180 "      run"
NSQ_SOURCE_LINE 00001181 "      harness start pump pumpable finish"
NSQ_SOURCE_LINE 00001182 "      signal kill_kill reap_nb"
NSQ_SOURCE_LINE 00001183 "      io timer timeout"
NSQ_SOURCE_LINE 00001184 "      close_terminal"
NSQ_SOURCE_LINE 00001185 "      binary"
NSQ_SOURCE_LINE 00001186 "      clearcache"
NSQ_SOURCE_LINE 00001187 "    );"
NSQ_SOURCE_LINE 00001188 "    @EXPORT_OK = ( @API, @FILTER_IMP, @FILTERS, qw( Win32_MODE ) );"
NSQ_SOURCE_LINE 00001189 "    %EXPORT_TAGS = ("
NSQ_SOURCE_LINE 00001190 "        'filter_imp' => \\@FILTER_IMP,"
NSQ_SOURCE_LINE 00001191 "        'all'        => \\@EXPORT_OK,"
NSQ_SOURCE_LINE 00001192 "        'filters'    => \\@FILTERS,"
NSQ_SOURCE_LINE 00001193 "        'api'        => \\@API,"
NSQ_SOURCE_LINE 00001194 "    );"
NSQ_SOURCE_LINE 00001195 ""
NSQ_SOURCE_LINE 00001196 "}"
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "use strict;"
NSQ_SOURCE_LINE 00001199 "use warnings;"
NSQ_SOURCE_LINE 00001200 "use IPC::Run::Debug;"
NSQ_SOURCE_LINE 00001201 "use Exporter;"
NSQ_SOURCE_LINE 00001202 "use Fcntl;"
NSQ_SOURCE_LINE 00001203 "use POSIX ();"
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "BEGIN {"
NSQ_SOURCE_LINE 00001206 "    if ( $] < 5.008 ) { require Symbol; }"
NSQ_SOURCE_LINE 00001207 "}"
NSQ_SOURCE_LINE 00001208 "use Carp;"
NSQ_SOURCE_LINE 00001209 "use File::Spec ();"
NSQ_SOURCE_LINE 00001210 "use IO::Handle;"
NSQ_SOURCE_LINE 00001211 "require IPC::Run::IO;"
NSQ_SOURCE_LINE 00001212 "require IPC::Run::Timer;"
NSQ_SOURCE_LINE 00001213 ""
NSQ_SOURCE_LINE 00001214 "use constant Win32_MODE => $^O =~ /os2|Win32/i;"
NSQ_SOURCE_LINE 00001215 ""
NSQ_SOURCE_LINE 00001216 "BEGIN {"
NSQ_SOURCE_LINE 00001217 "    if (Win32_MODE) {"
NSQ_SOURCE_LINE 00001218 "        eval \"use IPC::Run::Win32Helper; 1;\""
NSQ_SOURCE_LINE 00001219 "          or ( $@ && die )"
NSQ_SOURCE_LINE 00001220 "          or die \"$!\";"
NSQ_SOURCE_LINE 00001221 "    }"
NSQ_SOURCE_LINE 00001222 "    else {"
NSQ_SOURCE_LINE 00001223 "        eval \"use File::Basename; 1;\" or die $!;"
NSQ_SOURCE_LINE 00001224 "    }"
NSQ_SOURCE_LINE 00001225 "}"
NSQ_SOURCE_LINE 00001226 ""
NSQ_SOURCE_LINE 00001227 "sub input_avail();"
NSQ_SOURCE_LINE 00001228 "sub get_more_input();"
NSQ_SOURCE_LINE 00001229 ""
NSQ_SOURCE_LINE 00001230 "###############################################################################"
NSQ_SOURCE_LINE 00001231 ""
NSQ_SOURCE_LINE 00001232 "##"
NSQ_SOURCE_LINE 00001233 "## Error constants, not too locale-dependent"
NSQ_SOURCE_LINE 00001234 "use vars qw( $_EIO $_EAGAIN );"
NSQ_SOURCE_LINE 00001235 "use Errno qw( EIO EAGAIN EPIPE );"
NSQ_SOURCE_LINE 00001236 ""
NSQ_SOURCE_LINE 00001237 "BEGIN {"
NSQ_SOURCE_LINE 00001238 "    local $!;"
NSQ_SOURCE_LINE 00001239 "    $!       = EIO;"
NSQ_SOURCE_LINE 00001240 "    $_EIO    = qr/^$!/;"
NSQ_SOURCE_LINE 00001241 "    $!       = EAGAIN;"
NSQ_SOURCE_LINE 00001242 "    $_EAGAIN = qr/^$!/;"
NSQ_SOURCE_LINE 00001243 "}"
NSQ_SOURCE_LINE 00001244 ""
NSQ_SOURCE_LINE 00001245 "##"
NSQ_SOURCE_LINE 00001246 "## State machine states, set in $self->{STATE}"
NSQ_SOURCE_LINE 00001247 "##"
NSQ_SOURCE_LINE 00001248 "## These must be in ascending order numerically"
NSQ_SOURCE_LINE 00001249 "##"
NSQ_SOURCE_LINE 00001250 "sub _newed()     { 0 }"
NSQ_SOURCE_LINE 00001251 "sub _harnessed() { 1 }"
NSQ_SOURCE_LINE 00001252 "sub _finished()  { 2 }    ## _finished behave almost exactly like _harnessed"
NSQ_SOURCE_LINE 00001253 "sub _started()   { 3 }"
NSQ_SOURCE_LINE 00001254 ""
NSQ_SOURCE_LINE 00001255 "##"
NSQ_SOURCE_LINE 00001256 "## Which fds have been opened in the parent.  This may have extra fds, since"
NSQ_SOURCE_LINE 00001257 "## we aren't all that rigorous about closing these off, but that's ok.  This"
NSQ_SOURCE_LINE 00001258 "## is used on Unixish OSs to close all fds in the child that aren't needed"
NSQ_SOURCE_LINE 00001259 "## by that particular child."
NSQ_SOURCE_LINE 00001260 "my %fds;"
NSQ_SOURCE_LINE 00001261 ""
NSQ_SOURCE_LINE 00001262 "## There's a bit of hackery going on here."
NSQ_SOURCE_LINE 00001263 "##"
NSQ_SOURCE_LINE 00001264 "## We want to have any code anywhere be able to emit"
NSQ_SOURCE_LINE 00001265 "## debugging statements without knowing what harness the code is"
NSQ_SOURCE_LINE 00001266 "## being called in/from, since we'd need to pass a harness around to"
NSQ_SOURCE_LINE 00001267 "## everything."
NSQ_SOURCE_LINE 00001268 "##"
NSQ_SOURCE_LINE 00001269 "## Thus, $cur_self was born."
NSQ_SOURCE_LINE 00001270 ""
NSQ_SOURCE_LINE 00001271 "use vars qw( $cur_self );"
NSQ_SOURCE_LINE 00001272 ""
NSQ_SOURCE_LINE 00001273 "sub _debug_fd {"
NSQ_SOURCE_LINE 00001274 "    ## STDERR may be tied to a handle that doesn't implement FILENO (e.g. a"
NSQ_SOURCE_LINE 00001275 "    ## tied filehandle without a real underlying fd).  Wrap fileno() in eval"
NSQ_SOURCE_LINE 00001276 "    ## so we degrade gracefully instead of dying with \"Can't locate object"
NSQ_SOURCE_LINE 00001277 "    ## method FILENO\".  Returns undef when no real fd is available, which is"
NSQ_SOURCE_LINE 00001278 "    ## safe: callers that receive undef simply skip debug-fd setup."
NSQ_SOURCE_LINE 00001279 "    my $stderr_fd = eval { fileno STDERR };"
NSQ_SOURCE_LINE 00001280 ""
NSQ_SOURCE_LINE 00001281 "    return $stderr_fd unless defined $cur_self;"
NSQ_SOURCE_LINE 00001282 ""
NSQ_SOURCE_LINE 00001283 "    if ( _debugging && !defined $cur_self->{DEBUG_FD} ) {"
NSQ_SOURCE_LINE 00001284 "        if ( defined $stderr_fd ) {"
NSQ_SOURCE_LINE 00001285 "            my $fd = select STDERR;"
NSQ_SOURCE_LINE 00001286 "            $| = 1;"
NSQ_SOURCE_LINE 00001287 "            select $fd;"
NSQ_SOURCE_LINE 00001288 "            $cur_self->{DEBUG_FD} = POSIX::dup $stderr_fd;"
NSQ_SOURCE_LINE 00001289 "            _debug(\"debugging fd is $cur_self->{DEBUG_FD}\\n\")"
NSQ_SOURCE_LINE 00001290 "              if _debugging_details;"
NSQ_SOURCE_LINE 00001291 "        }"
NSQ_SOURCE_LINE 00001292 "    }"
NSQ_SOURCE_LINE 00001293 ""
NSQ_SOURCE_LINE 00001294 "    return $stderr_fd unless defined $cur_self->{DEBUG_FD};"
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 "    return $cur_self->{DEBUG_FD};"
NSQ_SOURCE_LINE 00001297 "}"
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "sub DESTROY {"
NSQ_SOURCE_LINE 00001300 "    ## We absolutely do not want to do anything else here.  We are likely"
NSQ_SOURCE_LINE 00001301 "    ## to be in a child process and we don't want to do things like kill_kill"
NSQ_SOURCE_LINE 00001302 "    ## ourself or cause other destruction."
NSQ_SOURCE_LINE 00001303 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00001304 "    POSIX::close $self->{DEBUG_FD} if defined $self->{DEBUG_FD};"
NSQ_SOURCE_LINE 00001305 "    $self->{DEBUG_FD} = undef;"
NSQ_SOURCE_LINE 00001306 ""
NSQ_SOURCE_LINE 00001307 "    for my $kid ( @{$self->{KIDS}} ) {"
NSQ_SOURCE_LINE 00001308 "        for my $op ( @{$kid->{OPS}} ) {"
NSQ_SOURCE_LINE 00001309 "            delete $op->{FILTERS};"
NSQ_SOURCE_LINE 00001310 "        }"
NSQ_SOURCE_LINE 00001311 "    }"
NSQ_SOURCE_LINE 00001312 "}"
NSQ_SOURCE_LINE 00001313 ""
NSQ_SOURCE_LINE 00001314 "##"
NSQ_SOURCE_LINE 00001315 "## Support routines (NOT METHODS)"
NSQ_SOURCE_LINE 00001316 "##"
NSQ_SOURCE_LINE 00001317 "my %cmd_cache;"
NSQ_SOURCE_LINE 00001318 "my $_cmd_cache_path = '';    # value of $ENV{PATH} when %cmd_cache was last populated"
NSQ_SOURCE_LINE 00001319 ""
NSQ_SOURCE_LINE 00001320 "=item clearcache()"
NSQ_SOURCE_LINE 00001321 ""
NSQ_SOURCE_LINE 00001322 "Clears the cache of executable paths that IPC::Run maintains internally."
NSQ_SOURCE_LINE 00001323 "IPC::Run caches the full path of each command it resolves via C<$PATH> to"
NSQ_SOURCE_LINE 00001324 "avoid repeated filesystem searches.  If you change C<$PATH> at runtime (or"
NSQ_SOURCE_LINE 00001325 "install a new executable into a directory that is already on C<$PATH>), call"
NSQ_SOURCE_LINE 00001326 "C<clearcache()> to force IPC::Run to search C<$PATH> again on the next run."
NSQ_SOURCE_LINE 00001327 ""
NSQ_SOURCE_LINE 00001328 "    local $ENV{PATH} = \"/new/bin:$ENV{PATH}\";"
NSQ_SOURCE_LINE 00001329 "    IPC::Run::clearcache();"
NSQ_SOURCE_LINE 00001330 "    run ['mycommand'], ...;"
NSQ_SOURCE_LINE 00001331 ""
NSQ_SOURCE_LINE 00001332 "The cache is also invalidated automatically whenever C<$ENV{PATH}> changes"
NSQ_SOURCE_LINE 00001333 "between calls."
NSQ_SOURCE_LINE 00001334 ""
NSQ_SOURCE_LINE 00001335 "=cut"
NSQ_SOURCE_LINE 00001336 ""
NSQ_SOURCE_LINE 00001337 "sub clearcache {"
NSQ_SOURCE_LINE 00001338 "    %cmd_cache        = ();"
NSQ_SOURCE_LINE 00001339 "    $_cmd_cache_path  = '';"
NSQ_SOURCE_LINE 00001340 "    return;"
NSQ_SOURCE_LINE 00001341 "}"
NSQ_SOURCE_LINE 00001342 ""
NSQ_SOURCE_LINE 00001343 "sub _search_path {"
NSQ_SOURCE_LINE 00001344 "    my ($cmd_name) = @_;"
NSQ_SOURCE_LINE 00001345 "    croak \"command name is undefined or empty\""
NSQ_SOURCE_LINE 00001346 "      unless defined $cmd_name && length $cmd_name;"
NSQ_SOURCE_LINE 00001347 "    if ( File::Spec->file_name_is_absolute($cmd_name) && -x $cmd_name ) {"
NSQ_SOURCE_LINE 00001348 "        _debug \"'\", $cmd_name, \"' is absolute\""
NSQ_SOURCE_LINE 00001349 "          if _debugging_details;"
NSQ_SOURCE_LINE 00001350 "        return $cmd_name;"
NSQ_SOURCE_LINE 00001351 "    }"
NSQ_SOURCE_LINE 00001352 ""
NSQ_SOURCE_LINE 00001353 "    my $dirsep = ("
NSQ_SOURCE_LINE 00001354 "          Win32_MODE     ? '[/\\\\\\\\]'"
NSQ_SOURCE_LINE 00001355 "        : $^O =~ /MacOS/ ? ':'"
NSQ_SOURCE_LINE 00001356 "        : $^O =~ /VMS/   ? '[\\[\\]]'"
NSQ_SOURCE_LINE 00001357 "        :                  '/'"
NSQ_SOURCE_LINE 00001358 "    );"
NSQ_SOURCE_LINE 00001359 ""
NSQ_SOURCE_LINE 00001360 "    if (   Win32_MODE"
NSQ_SOURCE_LINE 00001361 "        && ( $cmd_name =~ /$dirsep/ )"
NSQ_SOURCE_LINE 00001362 "        && ( $cmd_name !~ m!\\.[^\\\\/\\.]+$! ) ) {"
NSQ_SOURCE_LINE 00001363 ""
NSQ_SOURCE_LINE 00001364 "        _debug \"no extension(.exe), checking ENV{PATHEXT}\" if _debugging;"
NSQ_SOURCE_LINE 00001365 "        for ( split /;/, $ENV{PATHEXT} || \".COM;.BAT;.EXE\" ) {"
NSQ_SOURCE_LINE 00001366 "            my $name = \"$cmd_name$_\";"
NSQ_SOURCE_LINE 00001367 "            $cmd_name = $name, last if -f $name && -x _;"
NSQ_SOURCE_LINE 00001368 "        }"
NSQ_SOURCE_LINE 00001369 "        _debug \"cmd_name is now '$cmd_name'\" if _debugging;"
NSQ_SOURCE_LINE 00001370 "    }"
NSQ_SOURCE_LINE 00001371 ""
NSQ_SOURCE_LINE 00001372 "    if ( $cmd_name =~ /($dirsep)/ ) {"
NSQ_SOURCE_LINE 00001373 "        _debug \"'$cmd_name' contains '$1'\" if _debugging;"
NSQ_SOURCE_LINE 00001374 "        croak \"file not found: $cmd_name\"    unless -e $cmd_name;"
NSQ_SOURCE_LINE 00001375 "        croak \"not a file: $cmd_name\"        unless -f $cmd_name;"
NSQ_SOURCE_LINE 00001376 "        croak \"permission denied: $cmd_name\" unless -x $cmd_name;"
NSQ_SOURCE_LINE 00001377 "        return $cmd_name;"
NSQ_SOURCE_LINE 00001378 "    }"
NSQ_SOURCE_LINE 00001379 ""
NSQ_SOURCE_LINE 00001380 "    # Invalidate the entire cache when $PATH has changed so that commands are"
NSQ_SOURCE_LINE 00001381 "    # re-resolved against the new search path (analogous to the shell \"rehash\")."
NSQ_SOURCE_LINE 00001382 "    my $current_path = defined $ENV{PATH} ? $ENV{PATH} : '';"
NSQ_SOURCE_LINE 00001383 "    if ( $current_path ne $_cmd_cache_path ) {"
NSQ_SOURCE_LINE 00001384 "        _debug \"PATH changed, clearing cmd_cache\" if _debugging;"
NSQ_SOURCE_LINE 00001385 "        %cmd_cache       = ();"
NSQ_SOURCE_LINE 00001386 "        $_cmd_cache_path = $current_path;"
NSQ_SOURCE_LINE 00001387 "    }"
NSQ_SOURCE_LINE 00001388 ""
NSQ_SOURCE_LINE 00001389 "    if ( exists $cmd_cache{$cmd_name} ) {"
NSQ_SOURCE_LINE 00001390 "        _debug \"'$cmd_name' found in cache: '$cmd_cache{$cmd_name}'\""
NSQ_SOURCE_LINE 00001391 "          if _debugging;"
NSQ_SOURCE_LINE 00001392 "        return $cmd_cache{$cmd_name} if -x $cmd_cache{$cmd_name};"
NSQ_SOURCE_LINE 00001393 "        _debug \"'$cmd_cache{$cmd_name}' no longer executable, searching...\""
NSQ_SOURCE_LINE 00001394 "          if _debugging;"
NSQ_SOURCE_LINE 00001395 "        delete $cmd_cache{$cmd_name};"
NSQ_SOURCE_LINE 00001396 "    }"
NSQ_SOURCE_LINE 00001397 ""
NSQ_SOURCE_LINE 00001398 "    my @searched_in;"
NSQ_SOURCE_LINE 00001399 ""
NSQ_SOURCE_LINE 00001400 "    ## This next bit is Unix/Win32 specific, unfortunately."
NSQ_SOURCE_LINE 00001401 "    ## There's been some conversation about extending File::Spec to provide"
NSQ_SOURCE_LINE 00001402 "    ## a universal interface to PATH, but I haven't seen it yet."
NSQ_SOURCE_LINE 00001403 "    my $re = Win32_MODE ? qr/;/ : qr/:/;"
NSQ_SOURCE_LINE 00001404 ""
NSQ_SOURCE_LINE 00001405 "  LOOP:"
NSQ_SOURCE_LINE 00001406 "    for ( split( $re, $ENV{PATH} || '', -1 ) ) {"
NSQ_SOURCE_LINE 00001407 "        $_ = \".\" unless length $_;"
NSQ_SOURCE_LINE 00001408 "        push @searched_in, $_;"
NSQ_SOURCE_LINE 00001409 ""
NSQ_SOURCE_LINE 00001410 "        my $prospect = File::Spec->catfile( $_, $cmd_name );"
NSQ_SOURCE_LINE 00001411 "        my @prospects;"
NSQ_SOURCE_LINE 00001412 ""
NSQ_SOURCE_LINE 00001413 "        @prospects ="
NSQ_SOURCE_LINE 00001414 "          ( Win32_MODE && !( -f $prospect && -x _ ) )"
NSQ_SOURCE_LINE 00001415 "          ? map \"$prospect$_\", split /;/, $ENV{PATHEXT} || \".COM;.BAT;.EXE\""
NSQ_SOURCE_LINE 00001416 "          : ($prospect);"
NSQ_SOURCE_LINE 00001417 ""
NSQ_SOURCE_LINE 00001418 "        for my $found (@prospects) {"
NSQ_SOURCE_LINE 00001419 "            if ( -f $found && -x _ ) {"
NSQ_SOURCE_LINE 00001420 "                $cmd_cache{$cmd_name} = $found;"
NSQ_SOURCE_LINE 00001421 "                last LOOP;"
NSQ_SOURCE_LINE 00001422 "            }"
NSQ_SOURCE_LINE 00001423 "        }"
NSQ_SOURCE_LINE 00001424 "    }"
NSQ_SOURCE_LINE 00001425 ""
NSQ_SOURCE_LINE 00001426 "    if ( exists $cmd_cache{$cmd_name} ) {"
NSQ_SOURCE_LINE 00001427 "        _debug \"'\", $cmd_name, \"' added to cache: '\", $cmd_cache{$cmd_name}, \"'\""
NSQ_SOURCE_LINE 00001428 "          if _debugging_details;"
NSQ_SOURCE_LINE 00001429 "        return $cmd_cache{$cmd_name};"
NSQ_SOURCE_LINE 00001430 "    }"
NSQ_SOURCE_LINE 00001431 ""
NSQ_SOURCE_LINE 00001432 "    croak \"Command '$cmd_name' not found in \" . join( \", \", @searched_in );"
NSQ_SOURCE_LINE 00001433 "}"
NSQ_SOURCE_LINE 00001434 ""
NSQ_SOURCE_LINE 00001435 "# Translate a command or CODE reference (a $kid->{VAL}) to a list of strings"
NSQ_SOURCE_LINE 00001436 "# suitable for passing to _debug()."
NSQ_SOURCE_LINE 00001437 "sub _debugstrings {"
NSQ_SOURCE_LINE 00001438 "    my $operand = shift;"
NSQ_SOURCE_LINE 00001439 "    if ( !defined $operand ) {"
NSQ_SOURCE_LINE 00001440 "        return '<undef>';"
NSQ_SOURCE_LINE 00001441 "    }"
NSQ_SOURCE_LINE 00001442 ""
NSQ_SOURCE_LINE 00001443 "    my $ref = ref $operand;"
NSQ_SOURCE_LINE 00001444 "    if ( !$ref ) {"
NSQ_SOURCE_LINE 00001445 "        return length $operand < 50"
NSQ_SOURCE_LINE 00001446 "          ? \"'$operand'\""
NSQ_SOURCE_LINE 00001447 "          : join( '', \"'\", substr( $operand, 0, 10 ), \"...'\" );"
NSQ_SOURCE_LINE 00001448 "    }"
NSQ_SOURCE_LINE 00001449 "    elsif ( $ref eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00001450 "        return ("
NSQ_SOURCE_LINE 00001451 "            '[ ',"
NSQ_SOURCE_LINE 00001452 "            join( \" \", map /[^\\w.-]/ ? \"'$_'\" : $_, @$operand ),"
NSQ_SOURCE_LINE 00001453 "            ' ]'"
NSQ_SOURCE_LINE 00001454 "        );"
NSQ_SOURCE_LINE 00001455 "    }"
NSQ_SOURCE_LINE 00001456 "    elsif ( UNIVERSAL::isa( $operand, 'IPC::Run::Win32Process' ) ) {"
NSQ_SOURCE_LINE 00001457 "        return \"$operand\";"
NSQ_SOURCE_LINE 00001458 "    }"
NSQ_SOURCE_LINE 00001459 "    return $ref;"
NSQ_SOURCE_LINE 00001460 "}"
NSQ_SOURCE_LINE 00001461 ""
NSQ_SOURCE_LINE 00001462 "sub _empty($) { !( defined $_[0] && length $_[0] ) }"
NSQ_SOURCE_LINE 00001463 ""
NSQ_SOURCE_LINE 00001464 "## 'safe' versions of otherwise fun things to do. See also IPC::Run::Win32Helper."
NSQ_SOURCE_LINE 00001465 "sub _close {"
NSQ_SOURCE_LINE 00001466 "    confess 'undef' unless defined $_[0];"
NSQ_SOURCE_LINE 00001467 "    my $fd = $_[0] =~ /^\\d+$/ ? $_[0] : fileno $_[0];"
NSQ_SOURCE_LINE 00001468 "    if (Win32_MODE) {"
NSQ_SOURCE_LINE 00001469 ""
NSQ_SOURCE_LINE 00001470 "        # Perl close() or POSIX::close() on the read end of a pipe hangs if"
NSQ_SOURCE_LINE 00001471 "        # another process is in a read attempt on the same pipe"
NSQ_SOURCE_LINE 00001472 "        # (https://github.com/Perl/perl5/issues/19963).  Since IPC::Run creates"
NSQ_SOURCE_LINE 00001473 "        # pipes and shares them with user-defined kids, it's affected.  Work"
NSQ_SOURCE_LINE 00001474 "        # around that by first using dup2() to replace the FD with a non-pipe."
NSQ_SOURCE_LINE 00001475 "        # Unfortunately, for socket FDs, dup2() closes the SOCKET with"
NSQ_SOURCE_LINE 00001476 "        # CloseHandle().  CloseHandle() documentation leaves its behavior"
NSQ_SOURCE_LINE 00001477 "        # undefined for sockets.  However, tests on Windows Server 2022 did not"
NSQ_SOURCE_LINE 00001478 "        # leak memory, leak ports, or reveal any other obvious trouble."
NSQ_SOURCE_LINE 00001479 "        #"
NSQ_SOURCE_LINE 00001480 "        # No failure here is fatal.  (_close() has worked that way, either due"
NSQ_SOURCE_LINE 00001481 "        # to a principle or just due to a history of callers passing closed"
NSQ_SOURCE_LINE 00001482 "        # FDs.)  croak() on EMFILE would be a bad user experience.  Better to"
NSQ_SOURCE_LINE 00001483 "        # proceed and hope that $fd is not a being-read pipe."
NSQ_SOURCE_LINE 00001484 "        #"
NSQ_SOURCE_LINE 00001485 "        # Since start() and other user-facing methods _close() many FDs, we"
NSQ_SOURCE_LINE 00001486 "        # could optimize this by opening and closing the non-pipe FD just once"
NSQ_SOURCE_LINE 00001487 "        # per method call.  The overhead of this simple approach was in the"
NSQ_SOURCE_LINE 00001488 "        # noise, however."
NSQ_SOURCE_LINE 00001489 "        my $nul_fd = POSIX::open 'NUL';"
NSQ_SOURCE_LINE 00001490 "        if ( !defined $nul_fd ) {"
NSQ_SOURCE_LINE 00001491 "            _debug \"open( NUL ) = ERROR $!\" if _debugging_details;"
NSQ_SOURCE_LINE 00001492 "        }"
NSQ_SOURCE_LINE 00001493 "        else {"
NSQ_SOURCE_LINE 00001494 "            my $r = POSIX::dup2( $nul_fd, $fd );"
NSQ_SOURCE_LINE 00001495 "            _debug \"dup2( $nul_fd, $fd ) = ERROR $!\""
NSQ_SOURCE_LINE 00001496 "              if _debugging_details && !defined $r;"
NSQ_SOURCE_LINE 00001497 "            $r = POSIX::close $nul_fd;"
NSQ_SOURCE_LINE 00001498 "            _debug \"close( $nul_fd (NUL) ) = ERROR $!\""
NSQ_SOURCE_LINE 00001499 "              if _debugging_details && !defined $r;"
NSQ_SOURCE_LINE 00001500 "        }"
NSQ_SOURCE_LINE 00001501 "    }"
NSQ_SOURCE_LINE 00001502 "    my $r = POSIX::close $fd;"
NSQ_SOURCE_LINE 00001503 "    $r = $r ? '' : \" ERROR $!\";"
NSQ_SOURCE_LINE 00001504 "    delete $fds{$fd};"
NSQ_SOURCE_LINE 00001505 "    _debug \"close( $fd ) = \" . ( $r || 0 ) if _debugging_details;"
NSQ_SOURCE_LINE 00001506 "}"
NSQ_SOURCE_LINE 00001507 ""
NSQ_SOURCE_LINE 00001508 "sub _dup {"
NSQ_SOURCE_LINE 00001509 "    confess 'undef' unless defined $_[0];"
NSQ_SOURCE_LINE 00001510 "    my $r = POSIX::dup( $_[0] );"
NSQ_SOURCE_LINE 00001511 "    croak \"$!: dup( $_[0] )\" unless defined $r;"
NSQ_SOURCE_LINE 00001512 "    $r = 0 if $r eq '0 but true';"
NSQ_SOURCE_LINE 00001513 "    _debug \"dup( $_[0] ) = $r\" if _debugging_details;"
NSQ_SOURCE_LINE 00001514 "    $fds{$r} = {};"
NSQ_SOURCE_LINE 00001515 "    return $r;"
NSQ_SOURCE_LINE 00001516 "}"
NSQ_SOURCE_LINE 00001517 ""
NSQ_SOURCE_LINE 00001518 "sub _dup2_rudely {"
NSQ_SOURCE_LINE 00001519 "    confess 'undef' unless defined $_[0] && defined $_[1];"
NSQ_SOURCE_LINE 00001520 "    my $r = POSIX::dup2( $_[0], $_[1] );"
NSQ_SOURCE_LINE 00001521 "    croak \"$!: dup2( $_[0], $_[1] )\" unless defined $r;"
NSQ_SOURCE_LINE 00001522 "    $r = 0 if $r eq '0 but true';"
NSQ_SOURCE_LINE 00001523 "    _debug \"dup2( $_[0], $_[1] ) = $r\" if _debugging_details;"
NSQ_SOURCE_LINE 00001524 "    $fds{$r} = {};"
NSQ_SOURCE_LINE 00001525 "    return $r;"
NSQ_SOURCE_LINE 00001526 "}"
NSQ_SOURCE_LINE 00001527 ""
NSQ_SOURCE_LINE 00001528 "sub _exec {"
NSQ_SOURCE_LINE 00001529 "    confess 'undef passed' if grep !defined, @_;"
NSQ_SOURCE_LINE 00001530 ""
NSQ_SOURCE_LINE 00001531 "    #   exec @_ or croak \"$!: exec( \" . join( ', ', @_ ) . \" )\";"
NSQ_SOURCE_LINE 00001532 "    _debug 'exec()ing ', join \" \", map \"'$_'\", @_ if _debugging_details;"
NSQ_SOURCE_LINE 00001533 ""
NSQ_SOURCE_LINE 00001534 "    #   {"
NSQ_SOURCE_LINE 00001535 "## Commented out since we don't call this on Win32."
NSQ_SOURCE_LINE 00001536 "    #      # This works around the bug where 5.6.1 complains"
NSQ_SOURCE_LINE 00001537 "    #      # \"Can't exec ...: No error\" after an exec on NT, where"
NSQ_SOURCE_LINE 00001538 "    #      # exec() is simulated and actually returns in Perl's C"
NSQ_SOURCE_LINE 00001539 "    #      # code, though Perl's &exec does not..."
NSQ_SOURCE_LINE 00001540 "    #      no warnings \"exec\";"
NSQ_SOURCE_LINE 00001541 "    #"
NSQ_SOURCE_LINE 00001542 "    #      # Just in case the no warnings workaround"
NSQ_SOURCE_LINE 00001543 "    #      # stops being a workaround, we don't want"
NSQ_SOURCE_LINE 00001544 "    #      # old values of $! causing spurious strerr()"
NSQ_SOURCE_LINE 00001545 "    #      # messages to appear in the \"Can't exec\" message"
NSQ_SOURCE_LINE 00001546 "    #      undef $!;"
NSQ_SOURCE_LINE 00001547 "    exec { $_[0] } @_;"
NSQ_SOURCE_LINE 00001548 ""
NSQ_SOURCE_LINE 00001549 "    #   }"
NSQ_SOURCE_LINE 00001550 "    #   croak \"$!: exec( \" . join( ', ', map \"'$_'\", @_ ) . \" )\";"
NSQ_SOURCE_LINE 00001551 "    ## Fall through so $! can be reported to parent."
NSQ_SOURCE_LINE 00001552 "}"
NSQ_SOURCE_LINE 00001553 ""
NSQ_SOURCE_LINE 00001554 "sub _sysopen {"
NSQ_SOURCE_LINE 00001555 "    confess 'undef' unless defined $_[0] && defined $_[1];"
NSQ_SOURCE_LINE 00001556 "    _debug sprintf( \"O_RDONLY=0x%02x \", O_RDONLY ),"
NSQ_SOURCE_LINE 00001557 "      sprintf( \"O_WRONLY=0x%02x \", O_WRONLY ),"
NSQ_SOURCE_LINE 00001558 "      sprintf( \"O_RDWR=0x%02x \",   O_RDWR ),"
NSQ_SOURCE_LINE 00001559 "      sprintf( \"O_TRUNC=0x%02x \",  O_TRUNC ),"
NSQ_SOURCE_LINE 00001560 "      sprintf( \"O_CREAT=0x%02x \",  O_CREAT ),"
NSQ_SOURCE_LINE 00001561 "      sprintf( \"O_APPEND=0x%02x \", O_APPEND ),"
NSQ_SOURCE_LINE 00001562 "      if _debugging_details;"
NSQ_SOURCE_LINE 00001563 "    my $r = POSIX::open( $_[0], $_[1], 0666 );"
NSQ_SOURCE_LINE 00001564 "    croak \"$!: open( $_[0], \", sprintf( \"0x%03x\", $_[1] ), \" )\" unless defined $r;"
NSQ_SOURCE_LINE 00001565 "    _debug \"open( $_[0], \", sprintf( \"0x%03x\", $_[1] ), \" ) = $r\""
NSQ_SOURCE_LINE 00001566 "      if _debugging_data;"
NSQ_SOURCE_LINE 00001567 "    $fds{$r} = {};"
NSQ_SOURCE_LINE 00001568 "    return $r;"
NSQ_SOURCE_LINE 00001569 "}"
NSQ_SOURCE_LINE 00001570 ""
NSQ_SOURCE_LINE 00001571 "sub _pipe {"
NSQ_SOURCE_LINE 00001572 "    ## Normal, blocking write for pipes that we read and the child writes,"
NSQ_SOURCE_LINE 00001573 "    ## since most children expect writes to stdout to block rather than"
NSQ_SOURCE_LINE 00001574 "    ## do a partial write."
NSQ_SOURCE_LINE 00001575 "    my ( $r, $w ) = POSIX::pipe;"
NSQ_SOURCE_LINE 00001576 "    croak \"$!: pipe()\" unless defined $r;"
NSQ_SOURCE_LINE 00001577 "    _debug \"pipe() = ( $r, $w ) \" if _debugging_details;"
NSQ_SOURCE_LINE 00001578 "    @fds{$r, $w} = ( {}, {} );"
NSQ_SOURCE_LINE 00001579 "    return ( $r, $w );"
NSQ_SOURCE_LINE 00001580 "}"
NSQ_SOURCE_LINE 00001581 ""
NSQ_SOURCE_LINE 00001582 "sub _pipe_nb {"
NSQ_SOURCE_LINE 00001583 "    ## For pipes that we write, unblock the write side, so we can fill a buffer"
NSQ_SOURCE_LINE 00001584 "    ## and continue to select()."
NSQ_SOURCE_LINE 00001585 "    ## Contributed by Borislav Deianov <borislav@ensim.com>, with minor"
NSQ_SOURCE_LINE 00001586 "    ## bugfix on fcntl result by me."
NSQ_SOURCE_LINE 00001587 "    local ( *R, *W );"
NSQ_SOURCE_LINE 00001588 "    my $f = pipe( R, W );"
NSQ_SOURCE_LINE 00001589 "    croak \"$!: pipe()\" unless defined $f;"
NSQ_SOURCE_LINE 00001590 "    my ( $r, $w ) = ( fileno R, fileno W );"
NSQ_SOURCE_LINE 00001591 "    _debug \"pipe_nb pipe() = ( $r, $w )\" if _debugging_details;"
NSQ_SOURCE_LINE 00001592 "    unless (Win32_MODE) {"
NSQ_SOURCE_LINE 00001593 "        ## POSIX::fcntl doesn't take fd numbers, so gotta use Perl's and"
NSQ_SOURCE_LINE 00001594 "        ## then _dup the originals (which get closed on leaving this block)"
NSQ_SOURCE_LINE 00001595 "        my $fres = fcntl( W, &F_SETFL, O_WRONLY | O_NONBLOCK );"
NSQ_SOURCE_LINE 00001596 "        croak \"$!: fcntl( $w, F_SETFL, O_NONBLOCK )\" unless $fres;"
NSQ_SOURCE_LINE 00001597 "        _debug \"fcntl( $w, F_SETFL, O_NONBLOCK )\" if _debugging_details;"
NSQ_SOURCE_LINE 00001598 "    }"
NSQ_SOURCE_LINE 00001599 "    ( $r, $w ) = ( _dup($r), _dup($w) );"
NSQ_SOURCE_LINE 00001600 "    _debug \"pipe_nb() = ( $r, $w )\" if _debugging_details;"
NSQ_SOURCE_LINE 00001601 "    return ( $r, $w );"
NSQ_SOURCE_LINE 00001602 "}"
NSQ_SOURCE_LINE 00001603 ""
NSQ_SOURCE_LINE 00001604 "sub _pty {"
NSQ_SOURCE_LINE 00001605 "    require IO::Pty;"
NSQ_SOURCE_LINE 00001606 "    my $pty = IO::Pty->new();"
NSQ_SOURCE_LINE 00001607 "    croak \"$!: pty ()\" unless $pty;"
NSQ_SOURCE_LINE 00001608 "    $pty->autoflush();"
NSQ_SOURCE_LINE 00001609 "    $pty->blocking(0) or croak \"$!: pty->blocking ( 0 )\";"
NSQ_SOURCE_LINE 00001610 "    _debug \"pty() = ( \", $pty->fileno, \", \", $pty->slave->fileno, \" )\""
NSQ_SOURCE_LINE 00001611 "      if _debugging_details;"
NSQ_SOURCE_LINE 00001612 "    @fds{ $pty->fileno, $pty->slave->fileno } = ( {}, {} );"
NSQ_SOURCE_LINE 00001613 "    return $pty;"
NSQ_SOURCE_LINE 00001614 "}"
NSQ_SOURCE_LINE 00001615 ""
NSQ_SOURCE_LINE 00001616 "sub _read {"
NSQ_SOURCE_LINE 00001617 "    confess 'undef' unless defined $_[0];"
NSQ_SOURCE_LINE 00001618 "    my $s = '';"
NSQ_SOURCE_LINE 00001619 "    my $r;"
NSQ_SOURCE_LINE 00001620 "    do {"
NSQ_SOURCE_LINE 00001621 "        $r = POSIX::read( $_[0], $s, 10_000 );"
NSQ_SOURCE_LINE 00001622 "    } while ( !defined($r) && $!{EINTR} );"
NSQ_SOURCE_LINE 00001623 "    croak \"$!: read( $_[0] )\" unless defined($r);"
NSQ_SOURCE_LINE 00001624 "    $r ||= 0;"
NSQ_SOURCE_LINE 00001625 "    _debug \"read( $_[0] ) = $r chars '$s'\" if _debugging_data;"
NSQ_SOURCE_LINE 00001626 "    return $s;"
NSQ_SOURCE_LINE 00001627 "}"
NSQ_SOURCE_LINE 00001628 ""
NSQ_SOURCE_LINE 00001629 "## A METHOD, not a function."
NSQ_SOURCE_LINE 00001630 "sub _spawn {"
NSQ_SOURCE_LINE 00001631 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00001632 "    my ($kid) = @_;"
NSQ_SOURCE_LINE 00001633 ""
NSQ_SOURCE_LINE 00001634 "    croak \"Can't spawn IPC::Run::Win32Process except on Win32\""
NSQ_SOURCE_LINE 00001635 "      if UNIVERSAL::isa( $kid->{VAL}, 'IPC::Run::Win32Process' );"
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 "    _debug \"opening sync pipe \", $kid->{PID} if _debugging_details;"
NSQ_SOURCE_LINE 00001638 "    my $sync_reader_fd;"
NSQ_SOURCE_LINE 00001639 "    ( $sync_reader_fd, $self->{SYNC_WRITER_FD} ) = _pipe;"
NSQ_SOURCE_LINE 00001640 ""
NSQ_SOURCE_LINE 00001641 "    ## GH#122: For CODE ref children, create a separate pipe to propagate"
NSQ_SOURCE_LINE 00001642 "    ## exceptions back to the parent.  We can't reuse the sync pipe because"
NSQ_SOURCE_LINE 00001643 "    ## it must be closed before the CODE ref runs (to unblock the parent),"
NSQ_SOURCE_LINE 00001644 "    ## but we still need a channel for the child to report die() messages."
NSQ_SOURCE_LINE 00001645 "    my $coderef_err_reader_fd;"
NSQ_SOURCE_LINE 00001646 "    if ( ref $kid->{VAL} eq 'CODE' ) {"
NSQ_SOURCE_LINE 00001647 "        ( $coderef_err_reader_fd, $self->{CODEREF_ERR_FD} ) = _pipe;"
NSQ_SOURCE_LINE 00001648 "    }"
NSQ_SOURCE_LINE 00001649 ""
NSQ_SOURCE_LINE 00001650 "    $kid->{PID} = fork();"
NSQ_SOURCE_LINE 00001651 "    croak \"$! during fork\" unless defined $kid->{PID};"
NSQ_SOURCE_LINE 00001652 ""
NSQ_SOURCE_LINE 00001653 "    unless ( $kid->{PID} ) {"
NSQ_SOURCE_LINE 00001654 "        if ( $self->{_sigusr1_after_fork} ) {"
NSQ_SOURCE_LINE 00001655 ""
NSQ_SOURCE_LINE 00001656 "            # sleep 10ms to improve chance of parent starting read() before it"
NSQ_SOURCE_LINE 00001657 "            # handles the signal we're about to send."
NSQ_SOURCE_LINE 00001658 "            select undef, undef, undef, 0.01;"
NSQ_SOURCE_LINE 00001659 "            kill 'USR1', getppid;"
NSQ_SOURCE_LINE 00001660 "        }"
NSQ_SOURCE_LINE 00001661 "        ## Close the parent's reader end of the error pipe in the child."
NSQ_SOURCE_LINE 00001662 "        POSIX::close $coderef_err_reader_fd if defined $coderef_err_reader_fd;"
NSQ_SOURCE_LINE 00001663 "        ## _do_kid_and_exit closes sync_reader_fd since it closes all unwanted and"
NSQ_SOURCE_LINE 00001664 "        ## unloved fds."
NSQ_SOURCE_LINE 00001665 "        $self->_do_kid_and_exit($kid);"
NSQ_SOURCE_LINE 00001666 "    }"
NSQ_SOURCE_LINE 00001667 "    _debug \"fork() = \", $kid->{PID} if _debugging_details;"
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 "    ## Close the child's writer end of the error pipe in the parent."
NSQ_SOURCE_LINE 00001670 "    if ( defined $self->{CODEREF_ERR_FD} ) {"
NSQ_SOURCE_LINE 00001671 "        POSIX::close $self->{CODEREF_ERR_FD};"
NSQ_SOURCE_LINE 00001672 "        $kid->{CODEREF_ERR_FD} = $coderef_err_reader_fd;"
NSQ_SOURCE_LINE 00001673 "    }"
NSQ_SOURCE_LINE 00001674 ""
NSQ_SOURCE_LINE 00001675 "    ## Wait for kid to get to its exec() and see if it fails."
NSQ_SOURCE_LINE 00001676 "    _close $self->{SYNC_WRITER_FD};"
NSQ_SOURCE_LINE 00001677 "    my $sync_pulse = _read $sync_reader_fd;"
NSQ_SOURCE_LINE 00001678 "    _close $sync_reader_fd;"
NSQ_SOURCE_LINE 00001679 ""
NSQ_SOURCE_LINE 00001680 "    if ( !defined $sync_pulse || length $sync_pulse ) {"
NSQ_SOURCE_LINE 00001681 "        if ( waitpid( $kid->{PID}, 0 ) >= 0 ) {"
NSQ_SOURCE_LINE 00001682 "            $kid->{RESULT} = $?;"
NSQ_SOURCE_LINE 00001683 "        }"
NSQ_SOURCE_LINE 00001684 "        else {"
NSQ_SOURCE_LINE 00001685 "            $kid->{RESULT} = -1;"
NSQ_SOURCE_LINE 00001686 "        }"
NSQ_SOURCE_LINE 00001687 "        $sync_pulse = \"error reading synchronization pipe for $kid->{NUM}, pid $kid->{PID}\""
NSQ_SOURCE_LINE 00001688 "          unless length $sync_pulse;"
NSQ_SOURCE_LINE 00001689 "        croak $sync_pulse;"
NSQ_SOURCE_LINE 00001690 "    }"
NSQ_SOURCE_LINE 00001691 "    return $kid->{PID};"
NSQ_SOURCE_LINE 00001692 "}"
NSQ_SOURCE_LINE 00001693 ""
NSQ_SOURCE_LINE 00001694 "sub _write {"
NSQ_SOURCE_LINE 00001695 "    confess 'undef' unless defined $_[0] && defined $_[1];"
NSQ_SOURCE_LINE 00001696 "    my $r = POSIX::write( $_[0], $_[1], length $_[1] );"
NSQ_SOURCE_LINE 00001697 "    unless ( defined $r ) {"
NSQ_SOURCE_LINE 00001698 "        return undef if $! == EPIPE;    ## caller handles broken pipe"
NSQ_SOURCE_LINE 00001699 "        return 0    if $! == EAGAIN;    ## non-blocking pipe buffer full, retry later"
NSQ_SOURCE_LINE 00001700 "        croak \"$!: write( $_[0], '$_[1]' )\";"
NSQ_SOURCE_LINE 00001701 "    }"
NSQ_SOURCE_LINE 00001702 "    _debug \"write( $_[0], '$_[1]' ) = $r\" if _debugging_data;"
NSQ_SOURCE_LINE 00001703 "    return $r;"
NSQ_SOURCE_LINE 00001704 "}"
NSQ_SOURCE_LINE 00001705 ""
NSQ_SOURCE_LINE 00001706 "=pod"
NSQ_SOURCE_LINE 00001707 ""
NSQ_SOURCE_LINE 00001708 "=over"
NSQ_SOURCE_LINE 00001709 ""
NSQ_SOURCE_LINE 00001710 "=item run"
NSQ_SOURCE_LINE 00001711 ""
NSQ_SOURCE_LINE 00001712 "Run takes a harness or harness specification and runs it, pumping"
NSQ_SOURCE_LINE 00001713 "all input to the child(ren), closing the input pipes when no more"
NSQ_SOURCE_LINE 00001714 "input is available, collecting all output that arrives, until the"
NSQ_SOURCE_LINE 00001715 "pipes delivering output are closed, then waiting for the children to"
NSQ_SOURCE_LINE 00001716 "exit and reaping their result codes."
NSQ_SOURCE_LINE 00001717 ""
NSQ_SOURCE_LINE 00001718 "You may think of C<run( ... )> as being like "
NSQ_SOURCE_LINE 00001719 ""
NSQ_SOURCE_LINE 00001720 "   start( ... )->finish();"
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 ", though there is one subtle difference: run() does not"
NSQ_SOURCE_LINE 00001723 "set \\$input_scalars to '' like finish() does.  If an exception is thrown"
NSQ_SOURCE_LINE 00001724 "from run(), all children will be killed off \"gently\", and then \"annihilated\""
NSQ_SOURCE_LINE 00001725 "if they do not go gently (in to that dark night. sorry)."
NSQ_SOURCE_LINE 00001726 ""
NSQ_SOURCE_LINE 00001727 "If any exceptions are thrown, this does a L</kill_kill> before propagating"
NSQ_SOURCE_LINE 00001728 "them."
NSQ_SOURCE_LINE 00001729 ""
NSQ_SOURCE_LINE 00001730 "=cut"
NSQ_SOURCE_LINE 00001731 ""
NSQ_SOURCE_LINE 00001732 "use vars qw( $in_run );    ## No, not Enron;)"
NSQ_SOURCE_LINE 00001733 ""
NSQ_SOURCE_LINE 00001734 "sub run {"
NSQ_SOURCE_LINE 00001735 "    local $in_run = 1;     ## Allow run()-only optimizations."
NSQ_SOURCE_LINE 00001736 "    my IPC::Run $self = start(@_);"
NSQ_SOURCE_LINE 00001737 "    my $r = eval {"
NSQ_SOURCE_LINE 00001738 "        $self->{clear_ins} = 0;"
NSQ_SOURCE_LINE 00001739 "        $self->finish;"
NSQ_SOURCE_LINE 00001740 "    };"
NSQ_SOURCE_LINE 00001741 "    if ($@) {"
NSQ_SOURCE_LINE 00001742 "        my $x = $@;"
NSQ_SOURCE_LINE 00001743 "        $self->kill_kill;"
NSQ_SOURCE_LINE 00001744 "        die $x;"
NSQ_SOURCE_LINE 00001745 "    }"
NSQ_SOURCE_LINE 00001746 "    return $r;"
NSQ_SOURCE_LINE 00001747 "}"
NSQ_SOURCE_LINE 00001748 ""
NSQ_SOURCE_LINE 00001749 "=pod"
NSQ_SOURCE_LINE 00001750 ""
NSQ_SOURCE_LINE 00001751 "=item signal"
NSQ_SOURCE_LINE 00001752 ""
NSQ_SOURCE_LINE 00001753 "   ## To send it a specific signal by name (\"USR1\"):"
NSQ_SOURCE_LINE 00001754 "   signal $h, \"USR1\";"
NSQ_SOURCE_LINE 00001755 "   $h->signal ( \"USR1\" );"
NSQ_SOURCE_LINE 00001756 ""
NSQ_SOURCE_LINE 00001757 "If $signal is provided and defined, sends a signal to all child processes.  Try"
NSQ_SOURCE_LINE 00001758 "not to send numeric signals, use C<\"KILL\"> instead of C<9>, for instance."
NSQ_SOURCE_LINE 00001759 "Numeric signals aren't portable."
NSQ_SOURCE_LINE 00001760 ""
NSQ_SOURCE_LINE 00001761 "Throws an exception if $signal is undef."
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 "This will I<not> clean up the harness, C<finish> it if you kill it."
NSQ_SOURCE_LINE 00001764 ""
NSQ_SOURCE_LINE 00001765 "Normally TERM kills a process gracefully (this is what the command line utility"
NSQ_SOURCE_LINE 00001766 "C<kill> does by default), INT is sent by one of the keys C<^C>, C<Backspace> or"
NSQ_SOURCE_LINE 00001767 "C<E<lt>DelE<gt>>, and C<QUIT> is used to kill a process and make it coredump."
NSQ_SOURCE_LINE 00001768 ""
NSQ_SOURCE_LINE 00001769 "The C<HUP> signal is often used to get a process to \"restart\", rereading "
NSQ_SOURCE_LINE 00001770 "config files, and C<USR1> and C<USR2> for really application-specific things."
NSQ_SOURCE_LINE 00001771 ""
NSQ_SOURCE_LINE 00001772 "Often, running C<kill -l> (that's a lower case \"L\") on the command line will"
NSQ_SOURCE_LINE 00001773 "list the signals present on your operating system."
NSQ_SOURCE_LINE 00001774 ""
NSQ_SOURCE_LINE 00001775 "B<WARNING>: The signal subsystem is not at all portable.  We *may* offer"
NSQ_SOURCE_LINE 00001776 "to simulate C<TERM> and C<KILL> on some operating systems, submit code"
NSQ_SOURCE_LINE 00001777 "to me if you want this."
NSQ_SOURCE_LINE 00001778 ""
NSQ_SOURCE_LINE 00001779 "B<WARNING 2>: Up to and including perl v5.6.1, doing almost anything in a"
NSQ_SOURCE_LINE 00001780 "signal handler could be dangerous.  The most safe code avoids all"
NSQ_SOURCE_LINE 00001781 "mallocs and system calls, usually by preallocating a flag before"
NSQ_SOURCE_LINE 00001782 "entering the signal handler, altering the flag's value in the"
NSQ_SOURCE_LINE 00001783 "handler, and responding to the changed value in the main system:"
NSQ_SOURCE_LINE 00001784 ""
NSQ_SOURCE_LINE 00001785 "   my $got_usr1 = 0;"
NSQ_SOURCE_LINE 00001786 "   sub usr1_handler { ++$got_signal }"
NSQ_SOURCE_LINE 00001787 ""
NSQ_SOURCE_LINE 00001788 "   $SIG{USR1} = \\&usr1_handler;"
NSQ_SOURCE_LINE 00001789 "   while () { sleep 1; print \"GOT IT\" while $got_usr1--; }"
NSQ_SOURCE_LINE 00001790 ""
NSQ_SOURCE_LINE 00001791 "Even this approach is perilous if ++ and -- aren't atomic on your system"
NSQ_SOURCE_LINE 00001792 "(I've never heard of this on any modern CPU large enough to run perl)."
NSQ_SOURCE_LINE 00001793 ""
NSQ_SOURCE_LINE 00001794 "=cut"
NSQ_SOURCE_LINE 00001795 ""
NSQ_SOURCE_LINE 00001796 "sub signal {"
NSQ_SOURCE_LINE 00001797 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00001798 ""
NSQ_SOURCE_LINE 00001799 "    local $cur_self = $self;"
NSQ_SOURCE_LINE 00001800 ""
NSQ_SOURCE_LINE 00001801 "    $self->_kill_kill_kill_pussycat_kill unless @_;"
NSQ_SOURCE_LINE 00001802 ""
NSQ_SOURCE_LINE 00001803 "    Carp::cluck \"Ignoring extra parameters passed to kill()\" if @_ > 1;"
NSQ_SOURCE_LINE 00001804 ""
NSQ_SOURCE_LINE 00001805 "    my ($signal) = @_;"
NSQ_SOURCE_LINE 00001806 "    croak \"Undefined signal passed to signal\" unless defined $signal;"
NSQ_SOURCE_LINE 00001807 "    for ( grep $_->{PID} && !defined $_->{RESULT}, @{ $self->{KIDS} } ) {"
NSQ_SOURCE_LINE 00001808 "        _debug \"sending $signal to $_->{PID}\""
NSQ_SOURCE_LINE 00001809 "          if _debugging;"
NSQ_SOURCE_LINE 00001810 "        kill $signal, $_->{PID}"
NSQ_SOURCE_LINE 00001811 "          or _debugging && _debug \"$! sending $signal to $_->{PID}\";"
NSQ_SOURCE_LINE 00001812 "    }"
NSQ_SOURCE_LINE 00001813 ""
NSQ_SOURCE_LINE 00001814 "    return;"
NSQ_SOURCE_LINE 00001815 "}"
NSQ_SOURCE_LINE 00001816 ""
NSQ_SOURCE_LINE 00001817 "=pod"
NSQ_SOURCE_LINE 00001818 ""
NSQ_SOURCE_LINE 00001819 "=item kill_kill"
NSQ_SOURCE_LINE 00001820 ""
NSQ_SOURCE_LINE 00001821 "   ## To kill off a process:"
NSQ_SOURCE_LINE 00001822 "   $h->kill_kill;"
NSQ_SOURCE_LINE 00001823 "   kill_kill $h;"
NSQ_SOURCE_LINE 00001824 ""
NSQ_SOURCE_LINE 00001825 "   ## To specify the grace period other than 30 seconds:"
NSQ_SOURCE_LINE 00001826 "   kill_kill $h, grace => 5;"
NSQ_SOURCE_LINE 00001827 ""
NSQ_SOURCE_LINE 00001828 "   ## To send QUIT instead of KILL if a process refuses to die:"
NSQ_SOURCE_LINE 00001829 "   kill_kill $h, coup_d_grace => \"QUIT\";"
NSQ_SOURCE_LINE 00001830 ""
NSQ_SOURCE_LINE 00001831 "Sends a C<TERM>, waits for all children to exit for up to 30 seconds, then"
NSQ_SOURCE_LINE 00001832 "sends a C<KILL> to any that survived the C<TERM>."
NSQ_SOURCE_LINE 00001833 ""
NSQ_SOURCE_LINE 00001834 "Will wait for up to 30 more seconds for the OS to successfully C<KILL> the"
NSQ_SOURCE_LINE 00001835 "processes."
NSQ_SOURCE_LINE 00001836 ""
NSQ_SOURCE_LINE 00001837 "The 30 seconds may be overridden by setting the C<grace> option, this"
NSQ_SOURCE_LINE 00001838 "overrides both timers."
NSQ_SOURCE_LINE 00001839 ""
NSQ_SOURCE_LINE 00001840 "The harness is then cleaned up."
NSQ_SOURCE_LINE 00001841 ""
NSQ_SOURCE_LINE 00001842 "The doubled name indicates that this function may kill again and avoids"
NSQ_SOURCE_LINE 00001843 "colliding with the core Perl C<kill> function."
NSQ_SOURCE_LINE 00001844 ""
NSQ_SOURCE_LINE 00001845 "Returns undef if the C<TERM> was sufficient, or a 1 if C<KILL> was "
NSQ_SOURCE_LINE 00001846 "required.  Throws an exception if C<KILL> did not permit the children"
NSQ_SOURCE_LINE 00001847 "to be reaped."
NSQ_SOURCE_LINE 00001848 ""
NSQ_SOURCE_LINE 00001849 "B<NOTE>: The grace period is actually up to 1 second longer than that"
NSQ_SOURCE_LINE 00001850 "given.  This is because the granularity of C<time> is 1 second.  Let me"
NSQ_SOURCE_LINE 00001851 "know if you need finer granularity, we can leverage Time::HiRes here."
NSQ_SOURCE_LINE 00001852 ""
NSQ_SOURCE_LINE 00001853 "B<Win32>: Win32 does not support signals, so C<KILL> is sent immediately"
NSQ_SOURCE_LINE 00001854 "instead of C<TERM>.  The return value is C<undef> when the process exits"
NSQ_SOURCE_LINE 00001855 "after the initial C<KILL>, or C<1> if a second C<KILL> was needed.  Grace"
NSQ_SOURCE_LINE 00001856 "periods have no meaning on Win32."
NSQ_SOURCE_LINE 00001857 ""
NSQ_SOURCE_LINE 00001858 "=cut"
NSQ_SOURCE_LINE 00001859 ""
NSQ_SOURCE_LINE 00001860 "sub kill_kill {"
NSQ_SOURCE_LINE 00001861 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00001862 ""
NSQ_SOURCE_LINE 00001863 "    my %options = @_;"
NSQ_SOURCE_LINE 00001864 "    my $grace   = $options{grace};"
NSQ_SOURCE_LINE 00001865 "    $grace = 30 unless defined $grace;"
NSQ_SOURCE_LINE 00001866 "    ++$grace;    ## Make grace time a _minimum_"
NSQ_SOURCE_LINE 00001867 ""
NSQ_SOURCE_LINE 00001868 "    my $coup_d_grace = $options{coup_d_grace};"
NSQ_SOURCE_LINE 00001869 "    $coup_d_grace = \"KILL\" unless defined $coup_d_grace;"
NSQ_SOURCE_LINE 00001870 ""
NSQ_SOURCE_LINE 00001871 "    delete $options{$_} for qw( grace coup_d_grace );"
NSQ_SOURCE_LINE 00001872 "    Carp::cluck \"Ignoring unknown options for kill_kill: \","
NSQ_SOURCE_LINE 00001873 "      join \" \", keys %options"
NSQ_SOURCE_LINE 00001874 "      if keys %options;"
NSQ_SOURCE_LINE 00001875 ""
NSQ_SOURCE_LINE 00001876 "    if (Win32_MODE) {"
NSQ_SOURCE_LINE 00001877 "\t# immediate brutal death for Win32"
NSQ_SOURCE_LINE 00001878 "\t# TERM has unfortunate side-effects"
NSQ_SOURCE_LINE 00001879 "\t$self->signal(\"KILL\")"
NSQ_SOURCE_LINE 00001880 "    }"
NSQ_SOURCE_LINE 00001881 "    else {"
NSQ_SOURCE_LINE 00001882 "\t$self->signal(\"TERM\");"
NSQ_SOURCE_LINE 00001883 "    }"
NSQ_SOURCE_LINE 00001884 ""
NSQ_SOURCE_LINE 00001885 "    my $quitting_time = time + $grace;"
NSQ_SOURCE_LINE 00001886 "    my $delay         = 0.01;"
NSQ_SOURCE_LINE 00001887 "    my $accum_delay;"
NSQ_SOURCE_LINE 00001888 ""
NSQ_SOURCE_LINE 00001889 "    my $have_killed_before;"
NSQ_SOURCE_LINE 00001890 ""
NSQ_SOURCE_LINE 00001891 "    while () {"
NSQ_SOURCE_LINE 00001892 "        ## delay first to yield to other processes"
NSQ_SOURCE_LINE 00001893 "        select undef, undef, undef, $delay;"
NSQ_SOURCE_LINE 00001894 "        $accum_delay += $delay;"
NSQ_SOURCE_LINE 00001895 ""
NSQ_SOURCE_LINE 00001896 "        $self->reap_nb;"
NSQ_SOURCE_LINE 00001897 "        last unless $self->_running_kids;"
NSQ_SOURCE_LINE 00001898 ""
NSQ_SOURCE_LINE 00001899 "        if ( $accum_delay >= $grace * 0.8 ) {"
NSQ_SOURCE_LINE 00001900 "            ## No point in checking until delay has grown some."
NSQ_SOURCE_LINE 00001901 "            if ( time >= $quitting_time ) {"
NSQ_SOURCE_LINE 00001902 "                if ( !$have_killed_before ) {"
NSQ_SOURCE_LINE 00001903 "                    $self->signal($coup_d_grace);"
NSQ_SOURCE_LINE 00001904 "                    $have_killed_before = 1;"
NSQ_SOURCE_LINE 00001905 "                    $quitting_time += $grace;"
NSQ_SOURCE_LINE 00001906 "                    $delay       = 0.01;"
NSQ_SOURCE_LINE 00001907 "                    $accum_delay = 0;"
NSQ_SOURCE_LINE 00001908 "                    next;"
NSQ_SOURCE_LINE 00001909 "                }"
NSQ_SOURCE_LINE 00001910 "                croak \"Unable to reap all children, even after KILLing them\";"
NSQ_SOURCE_LINE 00001911 "            }"
NSQ_SOURCE_LINE 00001912 "        }"
NSQ_SOURCE_LINE 00001913 ""
NSQ_SOURCE_LINE 00001914 "        $delay *= 2;"
NSQ_SOURCE_LINE 00001915 "        $delay = 0.5 if $delay >= 0.5;"
NSQ_SOURCE_LINE 00001916 "    }"
NSQ_SOURCE_LINE 00001917 ""
NSQ_SOURCE_LINE 00001918 "    $self->_cleanup;"
NSQ_SOURCE_LINE 00001919 "    return $have_killed_before;"
NSQ_SOURCE_LINE 00001920 "}"
NSQ_SOURCE_LINE 00001921 ""
NSQ_SOURCE_LINE 00001922 "=pod"
NSQ_SOURCE_LINE 00001923 ""
NSQ_SOURCE_LINE 00001924 "=item harness"
NSQ_SOURCE_LINE 00001925 ""
NSQ_SOURCE_LINE 00001926 "Takes a harness specification and returns a harness.  This harness is"
NSQ_SOURCE_LINE 00001927 "blessed in to IPC::Run, allowing you to use method call syntax for"
NSQ_SOURCE_LINE 00001928 "run(), start(), et al if you like."
NSQ_SOURCE_LINE 00001929 ""
NSQ_SOURCE_LINE 00001930 "harness() is provided so that you can pre-build harnesses if you"
NSQ_SOURCE_LINE 00001931 "would like to, but it's not required.."
NSQ_SOURCE_LINE 00001932 ""
NSQ_SOURCE_LINE 00001933 "You may proceed to run(), start() or pump() after calling harness() (pump()"
NSQ_SOURCE_LINE 00001934 "calls start() if need be).  Alternatively, you may pass your"
NSQ_SOURCE_LINE 00001935 "harness specification to run() or start() and let them harness() for"
NSQ_SOURCE_LINE 00001936 "you.  You can't pass harness specifications to pump(), though."
NSQ_SOURCE_LINE 00001937 ""
NSQ_SOURCE_LINE 00001938 "=cut"
NSQ_SOURCE_LINE 00001939 ""
NSQ_SOURCE_LINE 00001940 "##"
NSQ_SOURCE_LINE 00001941 "## Notes: I've avoided handling a scalar that doesn't look like an"
NSQ_SOURCE_LINE 00001942 "## opcode as a here document or as a filename, though I could DWIM"
NSQ_SOURCE_LINE 00001943 "## those.  I'm not sure that the advantages outweigh the danger when"
NSQ_SOURCE_LINE 00001944 "## the DWIMer guesses wrong."
NSQ_SOURCE_LINE 00001945 "##"
NSQ_SOURCE_LINE 00001946 "## TODO: allow user to spec default shell. Hmm, globally, in the"
NSQ_SOURCE_LINE 00001947 "## lexical scope hash, or per instance?  'Course they can do that"
NSQ_SOURCE_LINE 00001948 "## now by using a [...] to hold the command."
NSQ_SOURCE_LINE 00001949 "##"
NSQ_SOURCE_LINE 00001950 "my $harness_id = 0;"
NSQ_SOURCE_LINE 00001951 ""
NSQ_SOURCE_LINE 00001952 "sub harness {"
NSQ_SOURCE_LINE 00001953 "    my $options;"
NSQ_SOURCE_LINE 00001954 "    if ( @_ && ref $_[-1] eq 'HASH' ) {"
NSQ_SOURCE_LINE 00001955 "        $options = pop;"
NSQ_SOURCE_LINE 00001956 "        require Data::Dumper;"
NSQ_SOURCE_LINE 00001957 "        carp \"Passing in options as a hash is deprecated:\\n\", Data::Dumper::Dumper($options);"
NSQ_SOURCE_LINE 00001958 "    }"
NSQ_SOURCE_LINE 00001959 ""
NSQ_SOURCE_LINE 00001960 "    #   local $IPC::Run::debug = $options->{debug}"
NSQ_SOURCE_LINE 00001961 "    #      if $options && defined $options->{debug};"
NSQ_SOURCE_LINE 00001962 ""
NSQ_SOURCE_LINE 00001963 "    my @args;"
NSQ_SOURCE_LINE 00001964 "    if ( @_ == 1 && !ref $_[0] ) {"
NSQ_SOURCE_LINE 00001965 "        if (Win32_MODE) {"
NSQ_SOURCE_LINE 00001966 "            my $command = $ENV{ComSpec} || 'cmd';"
NSQ_SOURCE_LINE 00001967 "            @args = ( [ $command, '/c', win32_parse_cmd_line $_[0] ] );"
NSQ_SOURCE_LINE 00001968 "        }"
NSQ_SOURCE_LINE 00001969 "        else {"
NSQ_SOURCE_LINE 00001970 "            @args = ( [ qw( sh -c ), @_ ] );"
NSQ_SOURCE_LINE 00001971 "        }"
NSQ_SOURCE_LINE 00001972 "    }"
NSQ_SOURCE_LINE 00001973 "    elsif ( @_ > 1 && !grep ref $_, @_ ) {"
NSQ_SOURCE_LINE 00001974 "        @args = ( [@_] );"
NSQ_SOURCE_LINE 00001975 "    }"
NSQ_SOURCE_LINE 00001976 "    else {"
NSQ_SOURCE_LINE 00001977 "        @args = map {"
NSQ_SOURCE_LINE 00001978 "            if ( !defined $_ ) {"
NSQ_SOURCE_LINE 00001979 "                if ( Internals::SvREADONLY($_) ) {"
NSQ_SOURCE_LINE 00001980 "                    my $undef;"
NSQ_SOURCE_LINE 00001981 "                    bless \\$undef, 'IPC::Run::Undef';"
NSQ_SOURCE_LINE 00001982 "                }"
NSQ_SOURCE_LINE 00001983 "                else {"
NSQ_SOURCE_LINE 00001984 "                    bless \\$_, 'IPC::Run::Undef';"
NSQ_SOURCE_LINE 00001985 "                }"
NSQ_SOURCE_LINE 00001986 "            }"
NSQ_SOURCE_LINE 00001987 "            else {"
NSQ_SOURCE_LINE 00001988 "                $_;"
NSQ_SOURCE_LINE 00001989 "            }"
NSQ_SOURCE_LINE 00001990 "        } @_;"
NSQ_SOURCE_LINE 00001991 "    }"
NSQ_SOURCE_LINE 00001992 ""
NSQ_SOURCE_LINE 00001993 "    my @errs;    # Accum errors, emit them when done."
NSQ_SOURCE_LINE 00001994 ""
NSQ_SOURCE_LINE 00001995 "    my $succinct;    # set if no redir ops are required yet.  Cleared"
NSQ_SOURCE_LINE 00001996 "                     # if an op is seen."
NSQ_SOURCE_LINE 00001997 ""
NSQ_SOURCE_LINE 00001998 "    my $cur_kid;     # references kid or handle being parsed"
NSQ_SOURCE_LINE 00001999 "    my $next_kid_close_stdin = 0;"
NSQ_SOURCE_LINE 00002000 ""
NSQ_SOURCE_LINE 00002001 "    my $assumed_fd = 0;    # fd to assume in succinct mode (no redir ops)"
NSQ_SOURCE_LINE 00002002 "    my $handle_num = 0;    # 1... is which handle we're parsing"
NSQ_SOURCE_LINE 00002003 ""
NSQ_SOURCE_LINE 00002004 "    my IPC::Run $self = bless {}, __PACKAGE__;"
NSQ_SOURCE_LINE 00002005 ""
NSQ_SOURCE_LINE 00002006 "    local $cur_self = $self;"
NSQ_SOURCE_LINE 00002007 ""
NSQ_SOURCE_LINE 00002008 "    $self->{ID}    = ++$harness_id;"
NSQ_SOURCE_LINE 00002009 "    $self->{IOS}   = [];"
NSQ_SOURCE_LINE 00002010 "    $self->{KIDS}  = [];"
NSQ_SOURCE_LINE 00002011 "    $self->{PIPES} = [];"
NSQ_SOURCE_LINE 00002012 "    $self->{PTYS}   = {};"
NSQ_SOURCE_LINE 00002013 "    $self->{TIMERS} = [];"
NSQ_SOURCE_LINE 00002014 "    $self->{STATE}  = _newed;"
NSQ_SOURCE_LINE 00002015 ""
NSQ_SOURCE_LINE 00002016 "    if ($options) {"
NSQ_SOURCE_LINE 00002017 "        $self->{$_} = $options->{$_} for keys %$options;"
NSQ_SOURCE_LINE 00002018 "    }"
NSQ_SOURCE_LINE 00002019 ""
NSQ_SOURCE_LINE 00002020 "    _debug \"****** harnessing *****\" if _debugging;"
NSQ_SOURCE_LINE 00002021 ""
NSQ_SOURCE_LINE 00002022 "    my $first_parse;"
NSQ_SOURCE_LINE 00002023 "    local $_;"
NSQ_SOURCE_LINE 00002024 "    my $arg_count = @args;"
NSQ_SOURCE_LINE 00002025 "    while (@args) {"
NSQ_SOURCE_LINE 00002026 "        for ( shift @args ) {"
NSQ_SOURCE_LINE 00002027 "            eval {"
NSQ_SOURCE_LINE 00002028 "                $first_parse = 1;"
NSQ_SOURCE_LINE 00002029 "                _debug( \"parsing \", _debugstrings($_) ) if _debugging;"
NSQ_SOURCE_LINE 00002030 ""
NSQ_SOURCE_LINE 00002031 "              REPARSE:"
NSQ_SOURCE_LINE 00002032 "                if (   ref eq 'ARRAY'"
NSQ_SOURCE_LINE 00002033 "                    || UNIVERSAL::isa( $_, 'IPC::Run::Win32Process' )"
NSQ_SOURCE_LINE 00002034 "                    || ( !$cur_kid && ref eq 'CODE' ) ) {"
NSQ_SOURCE_LINE 00002035 "                    croak \"Process control symbol ('|', '&') missing\" if $cur_kid;"
NSQ_SOURCE_LINE 00002036 "                    croak \"Can't spawn a subroutine on Win32\""
NSQ_SOURCE_LINE 00002037 "                      if Win32_MODE && ref eq \"CODE\";"
NSQ_SOURCE_LINE 00002038 "                    croak \"Can't run undefined command. Did you pass a reference to an undefined array?\""
NSQ_SOURCE_LINE 00002039 "                      if ref eq 'ARRAY' && @$_ && !defined( $_->[0] );"
NSQ_SOURCE_LINE 00002040 "                    $cur_kid = {"
NSQ_SOURCE_LINE 00002041 "                        TYPE   => 'cmd',"
NSQ_SOURCE_LINE 00002042 "                        VAL    => $_,"
NSQ_SOURCE_LINE 00002043 "                        NUM    => @{ $self->{KIDS} } + 1,"
NSQ_SOURCE_LINE 00002044 "                        OPS    => [],"
NSQ_SOURCE_LINE 00002045 "                        PID    => '',"
NSQ_SOURCE_LINE 00002046 "                        RESULT => undef,"
NSQ_SOURCE_LINE 00002047 "                    };"
NSQ_SOURCE_LINE 00002048 ""
NSQ_SOURCE_LINE 00002049 "                    unshift @{ $cur_kid->{OPS} }, {"
NSQ_SOURCE_LINE 00002050 "                        TYPE => 'close',"
NSQ_SOURCE_LINE 00002051 "                        KFD  => 0,"
NSQ_SOURCE_LINE 00002052 "                    } if $next_kid_close_stdin;"
NSQ_SOURCE_LINE 00002053 "                    $next_kid_close_stdin = 0;"
NSQ_SOURCE_LINE 00002054 ""
NSQ_SOURCE_LINE 00002055 "                    push @{ $self->{KIDS} }, $cur_kid;"
NSQ_SOURCE_LINE 00002056 "                    $succinct = 1;"
NSQ_SOURCE_LINE 00002057 "                }"
NSQ_SOURCE_LINE 00002058 ""
NSQ_SOURCE_LINE 00002059 "                elsif ( UNIVERSAL::isa( $_, 'IPC::Run::IO' ) ) {"
NSQ_SOURCE_LINE 00002060 "                    push @{ $self->{IOS} }, $_;"
NSQ_SOURCE_LINE 00002061 "                    $cur_kid  = undef;"
NSQ_SOURCE_LINE 00002062 "                    $succinct = 1;"
NSQ_SOURCE_LINE 00002063 "                }"
NSQ_SOURCE_LINE 00002064 ""
NSQ_SOURCE_LINE 00002065 "                elsif ( UNIVERSAL::isa( $_, 'IPC::Run::Timer' ) ) {"
NSQ_SOURCE_LINE 00002066 "                    push @{ $self->{TIMERS} }, $_;"
NSQ_SOURCE_LINE 00002067 "                    $succinct = 1;"
NSQ_SOURCE_LINE 00002068 "                }"
NSQ_SOURCE_LINE 00002069 ""
NSQ_SOURCE_LINE 00002070 "                elsif ( ref $_ eq 'IPC::Run::Undef' ) {"
NSQ_SOURCE_LINE 00002071 "                    ## Silently ignore undef values passed where a timer or"
NSQ_SOURCE_LINE 00002072 "                    ## other optional argument would go (e.g. undef timeout)."
NSQ_SOURCE_LINE 00002073 "                    ## See https://github.com/cpan-authors/IPC-Run/issues/128"
NSQ_SOURCE_LINE 00002074 "                }"
NSQ_SOURCE_LINE 00002075 ""
NSQ_SOURCE_LINE 00002076 "                elsif (/^(\\d*)>&(\\d+)$/) {"
NSQ_SOURCE_LINE 00002077 "                    croak \"No command before '$_'\" unless $cur_kid;"
NSQ_SOURCE_LINE 00002078 "                    push @{ $cur_kid->{OPS} }, {"
NSQ_SOURCE_LINE 00002079 "                        TYPE => 'dup',"
NSQ_SOURCE_LINE 00002080 "                        KFD1 => $2,"
NSQ_SOURCE_LINE 00002081 "                        KFD2 => length $1 ? $1 : 1,"
NSQ_SOURCE_LINE 00002082 "                    };"
NSQ_SOURCE_LINE 00002083 "                    _debug \"redirect operators now required\" if _debugging_details;"
NSQ_SOURCE_LINE 00002084 "                    $succinct = !$first_parse;"
NSQ_SOURCE_LINE 00002085 "                }"
NSQ_SOURCE_LINE 00002086 ""
NSQ_SOURCE_LINE 00002087 "                elsif (/^(\\d*)<&(\\d+)$/) {"
NSQ_SOURCE_LINE 00002088 "                    croak \"No command before '$_'\" unless $cur_kid;"
NSQ_SOURCE_LINE 00002089 "                    push @{ $cur_kid->{OPS} }, {"
NSQ_SOURCE_LINE 00002090 "                        TYPE => 'dup',"
NSQ_SOURCE_LINE 00002091 "                        KFD1 => $2,"
NSQ_SOURCE_LINE 00002092 "                        KFD2 => length $1 ? $1 : 0,"
NSQ_SOURCE_LINE 00002093 "                    };"
NSQ_SOURCE_LINE 00002094 "                    $succinct = !$first_parse;"
NSQ_SOURCE_LINE 00002095 "                }"
NSQ_SOURCE_LINE 00002096 ""
NSQ_SOURCE_LINE 00002097 "                elsif (/^(\\d*)<&-$/) {"
NSQ_SOURCE_LINE 00002098 "                    croak \"No command before '$_'\" unless $cur_kid;"
NSQ_SOURCE_LINE 00002099 "                    push @{ $cur_kid->{OPS} }, {"
NSQ_SOURCE_LINE 00002100 "                        TYPE => 'close',"
NSQ_SOURCE_LINE 00002101 "                        KFD  => length $1 ? $1 : 0,"
NSQ_SOURCE_LINE 00002102 "                    };"
NSQ_SOURCE_LINE 00002103 "                    $succinct = !$first_parse;"
NSQ_SOURCE_LINE 00002104 "                }"
NSQ_SOURCE_LINE 00002105 ""
NSQ_SOURCE_LINE 00002106 "                elsif (/^(\\d*) (<blocking_pipe)()  ()  ()  $/x"
NSQ_SOURCE_LINE 00002107 "                    || /^(\\d*) (<pipe)()            ()  ()  $/x"
NSQ_SOURCE_LINE 00002108 "                    || /^(\\d*) (<pty) ((?:\\s+\\S+)?) (<) ()  $/x"
NSQ_SOURCE_LINE 00002109 "                    || /^(\\d*) (<)    ()            ()  (.*)$/x ) {"
NSQ_SOURCE_LINE 00002110 "                    croak \"No command before '$_'\" unless $cur_kid;"
NSQ_SOURCE_LINE 00002111 ""
NSQ_SOURCE_LINE 00002112 "                    $succinct = !$first_parse;"
NSQ_SOURCE_LINE 00002113 ""
NSQ_SOURCE_LINE 00002114 "                    my $type = $2 . $4;"
NSQ_SOURCE_LINE 00002115 ""
NSQ_SOURCE_LINE 00002116 "                    my $kfd = length $1 ? $1 : 0;"
NSQ_SOURCE_LINE 00002117 ""
NSQ_SOURCE_LINE 00002118 "                    my $pty_id;"
NSQ_SOURCE_LINE 00002119 "                    if ( $type eq '<pty<' ) {"
NSQ_SOURCE_LINE 00002120 "                        $pty_id = length $3 ? $3 : '0';"
NSQ_SOURCE_LINE 00002121 "                        ## do the require here to cause early error reporting"
NSQ_SOURCE_LINE 00002122 "                        require IO::Pty;"
NSQ_SOURCE_LINE 00002123 "                        ## Just flag the pyt's existence for now.  It'll be"
NSQ_SOURCE_LINE 00002124 "                        ## converted to a real IO::Pty by _open_pipes."
NSQ_SOURCE_LINE 00002125 "                        $self->{PTYS}->{$pty_id} = undef;"
NSQ_SOURCE_LINE 00002126 "                    }"
NSQ_SOURCE_LINE 00002127 ""
NSQ_SOURCE_LINE 00002128 "                    my $source = $5;"
NSQ_SOURCE_LINE 00002129 ""
NSQ_SOURCE_LINE 00002130 "                    my @filters;"
NSQ_SOURCE_LINE 00002131 "                    my $binmode = 1;"
NSQ_SOURCE_LINE 00002132 ""
NSQ_SOURCE_LINE 00002133 "                    unless ( length $source ) {"
NSQ_SOURCE_LINE 00002134 "                        if ( !$succinct ) {"
NSQ_SOURCE_LINE 00002135 "                            while ( @args > 1"
NSQ_SOURCE_LINE 00002136 "                                && ( ( ref $args[1] && !UNIVERSAL::isa( $args[1], \"IPC::Run::Timer\" ) && ref $args[1] ne 'IPC::Run::Undef' ) || UNIVERSAL::isa $args[0], \"IPC::Run::binmode_pseudo_filter\" ) ) {"
NSQ_SOURCE_LINE 00002137 "                                if ( UNIVERSAL::isa $args[0], \"IPC::Run::binmode_pseudo_filter\" ) {"
NSQ_SOURCE_LINE 00002138 "                                    $binmode = shift(@args)->();"
NSQ_SOURCE_LINE 00002139 "                                }"
NSQ_SOURCE_LINE 00002140 "                                else {"
NSQ_SOURCE_LINE 00002141 "                                    push @filters, shift @args;"
NSQ_SOURCE_LINE 00002142 "                                }"
NSQ_SOURCE_LINE 00002143 "                            }"
NSQ_SOURCE_LINE 00002144 "                        }"
NSQ_SOURCE_LINE 00002145 "                        $source = shift @args;"
NSQ_SOURCE_LINE 00002146 "                        croak \"'$_' missing a source\" if _empty $source;"
NSQ_SOURCE_LINE 00002147 ""
NSQ_SOURCE_LINE 00002148 "                        _debug("
NSQ_SOURCE_LINE 00002149 "                            'Kid ',  $cur_kid->{NUM},  \"'s input fd \", $kfd,"
NSQ_SOURCE_LINE 00002150 "                            ' has ', scalar(@filters), ' filters.'"
NSQ_SOURCE_LINE 00002151 "                        ) if _debugging_details && @filters;"
NSQ_SOURCE_LINE 00002152 "                    }"
NSQ_SOURCE_LINE 00002153 ""
NSQ_SOURCE_LINE 00002154 "                    my IPC::Run::IO $pipe = IPC::Run::IO->_new_internal( $type, $kfd, $pty_id, $source, $binmode, @filters );"
NSQ_SOURCE_LINE 00002155 ""
NSQ_SOURCE_LINE 00002156 "                    if ( ( ref $source eq 'GLOB' || UNIVERSAL::isa $source, 'IO::Handle' )"
NSQ_SOURCE_LINE 00002157 "                        && $type !~ /^<p(ty<|ipe)$/ && $type ne '<blocking_pipe' ) {"
NSQ_SOURCE_LINE 00002158 "                        ## GH#57: For plain input redirects (<) on non-standard"
NSQ_SOURCE_LINE 00002159 "                        ## fds, do NOT set DONT_CLOSE.  After fork the parent no"
NSQ_SOURCE_LINE 00002160 "                        ## longer needs the input handle — the child has its own"
NSQ_SOURCE_LINE 00002161 "                        ## copy via dup2.  Keeping it open prevents EPIPE/SIGPIPE"
NSQ_SOURCE_LINE 00002162 "                        ## when the child exits early, which can hang the writer."
NSQ_SOURCE_LINE 00002163 "                        ## Protect stdin/stdout/stderr (fd 0-2) since closing"
NSQ_SOURCE_LINE 00002164 "                        ## those in the parent would be destructive."
NSQ_SOURCE_LINE 00002165 "                        my $fno = fileno $source;"
NSQ_SOURCE_LINE 00002166 "                        if ( defined $fno && $fno <= 2 ) {"
NSQ_SOURCE_LINE 00002167 "                            _debug \"setting DONT_CLOSE for std fd\" if _debugging_details;"
NSQ_SOURCE_LINE 00002168 "                            $pipe->{DONT_CLOSE} = 1;"
NSQ_SOURCE_LINE 00002169 "                        }"
NSQ_SOURCE_LINE 00002170 "                        _dont_inherit($source) if Win32_MODE;"
NSQ_SOURCE_LINE 00002171 "                    }"
NSQ_SOURCE_LINE 00002172 ""
NSQ_SOURCE_LINE 00002173 "                    push @{ $cur_kid->{OPS} }, $pipe;"
NSQ_SOURCE_LINE 00002174 "                }"
NSQ_SOURCE_LINE 00002175 ""
NSQ_SOURCE_LINE 00002176 "                elsif ("
NSQ_SOURCE_LINE 00002177 "                       /^()   (>>?)  (&)     ()      (.*)$/x"
NSQ_SOURCE_LINE 00002178 "                    || /^()   (&)    (>pipe) ()      ()  $/x"
NSQ_SOURCE_LINE 00002179 "                    || /^()   (>pipe)(&)     ()      ()  $/x"
NSQ_SOURCE_LINE 00002180 "                    || /^(\\d*)()     (>pipe) ()      ()  $/x"
NSQ_SOURCE_LINE 00002181 "                    || /^()   (&)    (>pty)  ( \\w*)> ()  $/x"
NSQ_SOURCE_LINE 00002182 "## TODO:    ||   /^()   (>pty) (\\d*)> (&) ()  $/x"
NSQ_SOURCE_LINE 00002183 "                    || /^(\\d*)()     (>pty)  ( \\w*)> ()  $/x"
NSQ_SOURCE_LINE 00002184 "                    || /^()   (&)    (>>?)   ()      (.*)$/x || /^(\\d*)()     (>>?)   ()      (.*)$/x"
NSQ_SOURCE_LINE 00002185 "                  ) {"
NSQ_SOURCE_LINE 00002186 "                    croak \"No command before '$_'\" unless $cur_kid;"
NSQ_SOURCE_LINE 00002187 ""
NSQ_SOURCE_LINE 00002188 "                    $succinct = !$first_parse;"
NSQ_SOURCE_LINE 00002189 ""
NSQ_SOURCE_LINE 00002190 "                    my $type = ("
NSQ_SOURCE_LINE 00002191 "                          $2 eq '>pipe' || $3 eq '>pipe' ? '>pipe'"
NSQ_SOURCE_LINE 00002192 "                        : $2 eq '>pty'  || $3 eq '>pty'  ? '>pty>'"
NSQ_SOURCE_LINE 00002193 "                        :                                  '>'"
NSQ_SOURCE_LINE 00002194 "                    );"
NSQ_SOURCE_LINE 00002195 "                    my $kfd = length $1 ? $1 : 1;"
NSQ_SOURCE_LINE 00002196 "                    my $trunc = !( $2 eq '>>' || $3 eq '>>' );"
NSQ_SOURCE_LINE 00002197 "                    my $pty_id = ("
NSQ_SOURCE_LINE 00002198 "                          $2 eq '>pty' || $3 eq '>pty'"
NSQ_SOURCE_LINE 00002199 "                        ? length $4"
NSQ_SOURCE_LINE 00002200 "                              ? $4"
NSQ_SOURCE_LINE 00002201 "                              : 0"
NSQ_SOURCE_LINE 00002202 "                        : undef"
NSQ_SOURCE_LINE 00002203 "                    );"
NSQ_SOURCE_LINE 00002204 ""
NSQ_SOURCE_LINE 00002205 "                    my $stderr_too ="
NSQ_SOURCE_LINE 00002206 "                         $2 eq '&'"
NSQ_SOURCE_LINE 00002207 "                      || $3 eq '&'"
NSQ_SOURCE_LINE 00002208 "                      || ( !length $1 && substr( $type, 0, 4 ) eq '>pty' );"
NSQ_SOURCE_LINE 00002209 ""
NSQ_SOURCE_LINE 00002210 "                    my $dest = $5;"
NSQ_SOURCE_LINE 00002211 "                    my @filters;"
NSQ_SOURCE_LINE 00002212 "                    my $binmode = 1;"
NSQ_SOURCE_LINE 00002213 "                    unless ( length $dest ) {"
NSQ_SOURCE_LINE 00002214 "                        if ( !$succinct ) {"
NSQ_SOURCE_LINE 00002215 "                            ## unshift...shift: '>' filters source...sink left...right"
NSQ_SOURCE_LINE 00002216 "                            while ( @args > 1"
NSQ_SOURCE_LINE 00002217 "                                && ( ( ref $args[1] && !UNIVERSAL::isa( $args[1], \"IPC::Run::Timer\" ) && ref $args[1] ne 'IPC::Run::Undef' ) || UNIVERSAL::isa $args[0], \"IPC::Run::binmode_pseudo_filter\" ) ) {"
NSQ_SOURCE_LINE 00002218 "                                if ( UNIVERSAL::isa $args[0], \"IPC::Run::binmode_pseudo_filter\" ) {"
NSQ_SOURCE_LINE 00002219 "                                    $binmode = shift(@args)->();"
NSQ_SOURCE_LINE 00002220 "                                }"
NSQ_SOURCE_LINE 00002221 "                                else {"
NSQ_SOURCE_LINE 00002222 "                                    unshift @filters, shift @args;"
NSQ_SOURCE_LINE 00002223 "                                }"
NSQ_SOURCE_LINE 00002224 "                            }"
NSQ_SOURCE_LINE 00002225 "                        }"
NSQ_SOURCE_LINE 00002226 ""
NSQ_SOURCE_LINE 00002227 "\t\t\tif ( @args && ref $args[0] eq 'IPC::Run::Undef' ) {"
NSQ_SOURCE_LINE 00002228 "\t\t\t    require Symbol;"
NSQ_SOURCE_LINE 00002229 "\t\t\t    ${ $args[0] } = $dest = Symbol::gensym();"
NSQ_SOURCE_LINE 00002230 "\t\t\t    shift @args;"
NSQ_SOURCE_LINE 00002231 "\t\t\t}"
NSQ_SOURCE_LINE 00002232 "\t\t\telse {"
NSQ_SOURCE_LINE 00002233 "\t\t\t    $dest = shift @args;"
NSQ_SOURCE_LINE 00002234 "\t\t\t}"
NSQ_SOURCE_LINE 00002235 ""
NSQ_SOURCE_LINE 00002236 "                        _debug("
NSQ_SOURCE_LINE 00002237 "                            'Kid ',  $cur_kid->{NUM},  \"'s output fd \", $kfd,"
NSQ_SOURCE_LINE 00002238 "                            ' has ', scalar(@filters), ' filters.'"
NSQ_SOURCE_LINE 00002239 "                        ) if _debugging_details && @filters;"
NSQ_SOURCE_LINE 00002240 ""
NSQ_SOURCE_LINE 00002241 "                        if ( $type eq '>pty>' ) {"
NSQ_SOURCE_LINE 00002242 "                            ## do the require here to cause early error reporting"
NSQ_SOURCE_LINE 00002243 "                            require IO::Pty;"
NSQ_SOURCE_LINE 00002244 "                            ## Just flag the pyt's existence for now.  _open_pipes()"
NSQ_SOURCE_LINE 00002245 "                            ## will new an IO::Pty for each key."
NSQ_SOURCE_LINE 00002246 "                            $self->{PTYS}->{$pty_id} = undef;"
NSQ_SOURCE_LINE 00002247 "                        }"
NSQ_SOURCE_LINE 00002248 "                    }"
NSQ_SOURCE_LINE 00002249 ""
NSQ_SOURCE_LINE 00002250 "                    croak \"'$_' missing a destination\" if _empty $dest;"
NSQ_SOURCE_LINE 00002251 "                    my $pipe = IPC::Run::IO->_new_internal( $type, $kfd, $pty_id, $dest, $binmode, @filters );"
NSQ_SOURCE_LINE 00002252 "                    $pipe->{TRUNC} = $trunc;"
NSQ_SOURCE_LINE 00002253 ""
NSQ_SOURCE_LINE 00002254 "                    if ( ( UNIVERSAL::isa( $dest, 'GLOB' ) || UNIVERSAL::isa( $dest, 'IO::Handle' ) )"
NSQ_SOURCE_LINE 00002255 "                        && $type !~ /^>(pty>|pipe)$/ ) {"
NSQ_SOURCE_LINE 00002256 "                        _debug \"setting DONT_CLOSE\" if _debugging_details;"
NSQ_SOURCE_LINE 00002257 "                        $pipe->{DONT_CLOSE} = 1;    ## this FD is not closed by us."
NSQ_SOURCE_LINE 00002258 "                    }"
NSQ_SOURCE_LINE 00002259 "                    push @{ $cur_kid->{OPS} }, $pipe;"
NSQ_SOURCE_LINE 00002260 "                    push @{ $cur_kid->{OPS} }, {"
NSQ_SOURCE_LINE 00002261 "                        TYPE => 'dup',"
NSQ_SOURCE_LINE 00002262 "                        KFD1 => 1,"
NSQ_SOURCE_LINE 00002263 "                        KFD2 => 2,"
NSQ_SOURCE_LINE 00002264 "                    } if $stderr_too;"
NSQ_SOURCE_LINE 00002265 "                }"
NSQ_SOURCE_LINE 00002266 ""
NSQ_SOURCE_LINE 00002267 "                elsif ( $_ eq \"|\" ) {"
NSQ_SOURCE_LINE 00002268 "                    croak \"No command before '$_'\" unless $cur_kid;"
NSQ_SOURCE_LINE 00002269 "                    unshift @{ $cur_kid->{OPS} }, {"
NSQ_SOURCE_LINE 00002270 "                        TYPE => '|',"
NSQ_SOURCE_LINE 00002271 "                        KFD  => 1,"
NSQ_SOURCE_LINE 00002272 "                    };"
NSQ_SOURCE_LINE 00002273 "                    $succinct   = 1;"
NSQ_SOURCE_LINE 00002274 "                    $assumed_fd = 1;"
NSQ_SOURCE_LINE 00002275 "                    $cur_kid    = undef;"
NSQ_SOURCE_LINE 00002276 "                }"
NSQ_SOURCE_LINE 00002277 ""
NSQ_SOURCE_LINE 00002278 "                elsif ( $_ eq \"&\" ) {"
NSQ_SOURCE_LINE 00002279 "                    croak \"No command before '$_'\" unless $cur_kid;"
NSQ_SOURCE_LINE 00002280 "                    $next_kid_close_stdin = 1;"
NSQ_SOURCE_LINE 00002281 "                    $succinct             = 1;"
NSQ_SOURCE_LINE 00002282 "                    $assumed_fd           = 0;"
NSQ_SOURCE_LINE 00002283 "                    $cur_kid              = undef;"
NSQ_SOURCE_LINE 00002284 "                }"
NSQ_SOURCE_LINE 00002285 ""
NSQ_SOURCE_LINE 00002286 "                elsif ( $_ eq 'init' ) {"
NSQ_SOURCE_LINE 00002287 "                    croak \"No command before '$_'\" unless $cur_kid;"
NSQ_SOURCE_LINE 00002288 "                    push @{ $cur_kid->{OPS} }, {"
NSQ_SOURCE_LINE 00002289 "                        TYPE => 'init',"
NSQ_SOURCE_LINE 00002290 "                        SUB  => shift @args,"
NSQ_SOURCE_LINE 00002291 "                    };"
NSQ_SOURCE_LINE 00002292 "                }"
NSQ_SOURCE_LINE 00002293 ""
NSQ_SOURCE_LINE 00002294 "                elsif ( $_ eq 'env' ) {"
NSQ_SOURCE_LINE 00002295 "                    croak \"No command before '$_'\" unless $cur_kid;"
NSQ_SOURCE_LINE 00002296 "                    my $env = shift @args;"
NSQ_SOURCE_LINE 00002297 "                    croak \"'env' option requires a hash reference\" unless ref $env eq 'HASH';"
NSQ_SOURCE_LINE 00002298 "                    $cur_kid->{ENV} = $env;"
NSQ_SOURCE_LINE 00002299 "                }"
NSQ_SOURCE_LINE 00002300 ""
NSQ_SOURCE_LINE 00002301 "                elsif ( !ref $_ ) {"
NSQ_SOURCE_LINE 00002302 "                    $self->{$_} = shift @args;"
NSQ_SOURCE_LINE 00002303 "                }"
NSQ_SOURCE_LINE 00002304 ""
NSQ_SOURCE_LINE 00002305 "                elsif ( ref $_ eq 'IPC::Run::Undef' ) {"
NSQ_SOURCE_LINE 00002306 "                    ## bare undef argument - silently ignore to preserve"
NSQ_SOURCE_LINE 00002307 "                    ## pre-20180523.0 behavior where undef matched !ref $_ and"
NSQ_SOURCE_LINE 00002308 "                    ## was absorbed as a no-op.  See GH#124."
NSQ_SOURCE_LINE 00002309 "                }"
NSQ_SOURCE_LINE 00002310 ""
NSQ_SOURCE_LINE 00002311 "                elsif ( $_ eq 'init' ) {"
NSQ_SOURCE_LINE 00002312 "                    croak \"No command before '$_'\" unless $cur_kid;"
NSQ_SOURCE_LINE 00002313 "                    push @{ $cur_kid->{OPS} }, {"
NSQ_SOURCE_LINE 00002314 "                        TYPE => 'init',"
NSQ_SOURCE_LINE 00002315 "                        SUB  => shift @args,"
NSQ_SOURCE_LINE 00002316 "                    };"
NSQ_SOURCE_LINE 00002317 "                }"
NSQ_SOURCE_LINE 00002318 ""
NSQ_SOURCE_LINE 00002319 "                elsif ( $succinct && $first_parse ) {"
NSQ_SOURCE_LINE 00002320 "                    ## It's not an opcode, and no explicit opcodes have been"
NSQ_SOURCE_LINE 00002321 "                    ## seen yet, so assume it's a file name."
NSQ_SOURCE_LINE 00002322 "                    unshift @args, $_;"
NSQ_SOURCE_LINE 00002323 "                    if ( !$assumed_fd ) {"
NSQ_SOURCE_LINE 00002324 "                        $_ = \"$assumed_fd<\","
NSQ_SOURCE_LINE 00002325 "                    }"
NSQ_SOURCE_LINE 00002326 "                    else {"
NSQ_SOURCE_LINE 00002327 "                        $_ = \"$assumed_fd>\","
NSQ_SOURCE_LINE 00002328 "                    }"
NSQ_SOURCE_LINE 00002329 "                    _debug \"assuming '\", $_, \"'\" if _debugging_details;"
NSQ_SOURCE_LINE 00002330 "                    ++$assumed_fd;"
NSQ_SOURCE_LINE 00002331 "                    $first_parse = 0;"
NSQ_SOURCE_LINE 00002332 "                    goto REPARSE;"
NSQ_SOURCE_LINE 00002333 "                }"
NSQ_SOURCE_LINE 00002334 ""
NSQ_SOURCE_LINE 00002335 "                else {"
NSQ_SOURCE_LINE 00002336 "                    croak join("
NSQ_SOURCE_LINE 00002337 "                        '',"
NSQ_SOURCE_LINE 00002338 "                        'Unexpected ',"
NSQ_SOURCE_LINE 00002339 "                        ( ref() ? $_ : 'scalar' ),"
NSQ_SOURCE_LINE 00002340 "                        ' in harness() parameter ',"
NSQ_SOURCE_LINE 00002341 "                        $arg_count - @args"
NSQ_SOURCE_LINE 00002342 "                    );"
NSQ_SOURCE_LINE 00002343 "                }"
NSQ_SOURCE_LINE 00002344 "            };"
NSQ_SOURCE_LINE 00002345 "            if ($@) {"
NSQ_SOURCE_LINE 00002346 "                push @errs, $@;"
NSQ_SOURCE_LINE 00002347 "                _debug 'caught ', $@ if _debugging;"
NSQ_SOURCE_LINE 00002348 "            }"
NSQ_SOURCE_LINE 00002349 "        }"
NSQ_SOURCE_LINE 00002350 "    }"
NSQ_SOURCE_LINE 00002351 ""
NSQ_SOURCE_LINE 00002352 "    die join( '', @errs ) if @errs;"
NSQ_SOURCE_LINE 00002353 ""
NSQ_SOURCE_LINE 00002354 "    $self->{STATE} = _harnessed;"
NSQ_SOURCE_LINE 00002355 ""
NSQ_SOURCE_LINE 00002356 "    #   $self->timeout( $options->{timeout} ) if exists $options->{timeout};"
NSQ_SOURCE_LINE 00002357 "    return $self;"
NSQ_SOURCE_LINE 00002358 "}"
NSQ_SOURCE_LINE 00002359 ""
NSQ_SOURCE_LINE 00002360 "sub _open_pipes {"
NSQ_SOURCE_LINE 00002361 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00002362 ""
NSQ_SOURCE_LINE 00002363 "    my @errs;"
NSQ_SOURCE_LINE 00002364 ""
NSQ_SOURCE_LINE 00002365 "    my @close_on_fail;"
NSQ_SOURCE_LINE 00002366 ""
NSQ_SOURCE_LINE 00002367 "    ## When a pipe character is seen, a pipe is created.  $pipe_read_fd holds"
NSQ_SOURCE_LINE 00002368 "    ## the dangling read end of the pipe until we get to the next process."
NSQ_SOURCE_LINE 00002369 "    my $pipe_read_fd;"
NSQ_SOURCE_LINE 00002370 ""
NSQ_SOURCE_LINE 00002371 "    ## Output descriptors for the last command are shared by all children."
NSQ_SOURCE_LINE 00002372 "    ## @output_fds_accum accumulates the current set of output fds."
NSQ_SOURCE_LINE 00002373 "    my @output_fds_accum;"
NSQ_SOURCE_LINE 00002374 ""
NSQ_SOURCE_LINE 00002375 "    for ( sort keys %{ $self->{PTYS} } ) {"
NSQ_SOURCE_LINE 00002376 "        _debug \"opening pty '\", $_, \"'\" if _debugging_details;"
NSQ_SOURCE_LINE 00002377 "        eval {"
NSQ_SOURCE_LINE 00002378 "            my $pty = _pty;"
NSQ_SOURCE_LINE 00002379 "            $self->{PTYS}->{$_} = $pty;"
NSQ_SOURCE_LINE 00002380 "        };"
NSQ_SOURCE_LINE 00002381 "        if ($@) {"
NSQ_SOURCE_LINE 00002382 "            push @errs, $@;"
NSQ_SOURCE_LINE 00002383 "            _debug 'caught ', $@ if _debugging;"
NSQ_SOURCE_LINE 00002384 "        }"
NSQ_SOURCE_LINE 00002385 "    }"
NSQ_SOURCE_LINE 00002386 ""
NSQ_SOURCE_LINE 00002387 "    for ( @{ $self->{IOS} } ) {"
NSQ_SOURCE_LINE 00002388 "        eval { $_->init; };"
NSQ_SOURCE_LINE 00002389 "        if ($@) {"
NSQ_SOURCE_LINE 00002390 "            push @errs, $@;"
NSQ_SOURCE_LINE 00002391 "            _debug 'caught ', $@ if _debugging;"
NSQ_SOURCE_LINE 00002392 "        }"
NSQ_SOURCE_LINE 00002393 "        else {"
NSQ_SOURCE_LINE 00002394 "            push @close_on_fail, $_;"
NSQ_SOURCE_LINE 00002395 "        }"
NSQ_SOURCE_LINE 00002396 "    }"
NSQ_SOURCE_LINE 00002397 ""
NSQ_SOURCE_LINE 00002398 "    ## Loop through the kids and their OPS, interpreting any that require"
NSQ_SOURCE_LINE 00002399 "    ## parent-side actions."
NSQ_SOURCE_LINE 00002400 "    for my $kid ( @{ $self->{KIDS} } ) {"
NSQ_SOURCE_LINE 00002401 "        if ( ref $kid->{VAL} eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00002402 "            $kid->{PATH} = _search_path $kid->{VAL}->[0];"
NSQ_SOURCE_LINE 00002403 "        }"
NSQ_SOURCE_LINE 00002404 "        if ( defined $pipe_read_fd ) {"
NSQ_SOURCE_LINE 00002405 "            _debug \"placing write end of pipe on kid $kid->{NUM}'s stdin\""
NSQ_SOURCE_LINE 00002406 "              if _debugging_details;"
NSQ_SOURCE_LINE 00002407 "            unshift @{ $kid->{OPS} }, {"
NSQ_SOURCE_LINE 00002408 "                TYPE => 'PIPE',          ## Prevent next loop from triggering on this"
NSQ_SOURCE_LINE 00002409 "                KFD  => 0,"
NSQ_SOURCE_LINE 00002410 "                TFD  => $pipe_read_fd,"
NSQ_SOURCE_LINE 00002411 "            };"
NSQ_SOURCE_LINE 00002412 "            $pipe_read_fd = undef;"
NSQ_SOURCE_LINE 00002413 "        }"
NSQ_SOURCE_LINE 00002414 "        @output_fds_accum = ();"
NSQ_SOURCE_LINE 00002415 "        for my $op ( @{ $kid->{OPS} } ) {"
NSQ_SOURCE_LINE 00002416 ""
NSQ_SOURCE_LINE 00002417 "            #         next if $op->{IS_DEBUG};"
NSQ_SOURCE_LINE 00002418 "            my $ok = eval {"
NSQ_SOURCE_LINE 00002419 "                if ( $op->{TYPE} eq '<' ) {"
NSQ_SOURCE_LINE 00002420 "                    my $source = $op->{SOURCE};"
NSQ_SOURCE_LINE 00002421 "                    if ( !ref $source ) {"
NSQ_SOURCE_LINE 00002422 "                        _debug("
NSQ_SOURCE_LINE 00002423 "                            \"kid \",              $kid->{NUM}, \" to read \", $op->{KFD},"
NSQ_SOURCE_LINE 00002424 "                            \" from '\" . $source, \"' (read only)\""
NSQ_SOURCE_LINE 00002425 "                        ) if _debugging_details;"
NSQ_SOURCE_LINE 00002426 "                        croak \"simulated open failure\""
NSQ_SOURCE_LINE 00002427 "                          if $self->{_simulate_open_failure};"
NSQ_SOURCE_LINE 00002428 "                        $op->{TFD} = _sysopen( $source, O_RDONLY );"
NSQ_SOURCE_LINE 00002429 "                        push @close_on_fail, $op->{TFD};"
NSQ_SOURCE_LINE 00002430 "                    }"
NSQ_SOURCE_LINE 00002431 "                    elsif (UNIVERSAL::isa( $source, 'GLOB' )"
NSQ_SOURCE_LINE 00002432 "                        || UNIVERSAL::isa( $source, 'IO::Handle' ) ) {"
NSQ_SOURCE_LINE 00002433 "                        croak \"Unopened filehandle in input redirect for $op->{KFD}\""
NSQ_SOURCE_LINE 00002434 "                          unless defined fileno $source;"
NSQ_SOURCE_LINE 00002435 "                        $op->{TFD} = fileno $source;"
NSQ_SOURCE_LINE 00002436 "                        _debug("
NSQ_SOURCE_LINE 00002437 "                            \"kid \",      $kid->{NUM}, \" to read \", $op->{KFD},"
NSQ_SOURCE_LINE 00002438 "                            \" from fd \", $op->{TFD}"
NSQ_SOURCE_LINE 00002439 "                        ) if _debugging_details;"
NSQ_SOURCE_LINE 00002440 "                    }"
NSQ_SOURCE_LINE 00002441 "                    elsif ( UNIVERSAL::isa( $source, 'SCALAR' ) ) {"
NSQ_SOURCE_LINE 00002442 "                        _debug("
NSQ_SOURCE_LINE 00002443 "                            \"kid \", $kid->{NUM}, \" to read \", $op->{KFD},"
NSQ_SOURCE_LINE 00002444 "                            \" from SCALAR\""
NSQ_SOURCE_LINE 00002445 "                        ) if _debugging_details;"
NSQ_SOURCE_LINE 00002446 ""
NSQ_SOURCE_LINE 00002447 "                        $op->open_pipe( $self->_debug_fd );"
NSQ_SOURCE_LINE 00002448 "                        push @close_on_fail, $op->{KFD}, $op->{FD};"
NSQ_SOURCE_LINE 00002449 ""
NSQ_SOURCE_LINE 00002450 "                        my $s = '';"
NSQ_SOURCE_LINE 00002451 "                        $op->{KIN_REF} = \\$s;"
NSQ_SOURCE_LINE 00002452 "                    }"
NSQ_SOURCE_LINE 00002453 "                    elsif ( UNIVERSAL::isa( $source, 'CODE' ) ) {"
NSQ_SOURCE_LINE 00002454 "                        _debug( 'kid ', $kid->{NUM}, ' to read ', $op->{KFD}, ' from CODE' ) if _debugging_details;"
NSQ_SOURCE_LINE 00002455 ""
NSQ_SOURCE_LINE 00002456 "                        $op->open_pipe( $self->_debug_fd );"
NSQ_SOURCE_LINE 00002457 "                        push @close_on_fail, $op->{KFD}, $op->{FD};"
NSQ_SOURCE_LINE 00002458 ""
NSQ_SOURCE_LINE 00002459 "                        my $s = '';"
NSQ_SOURCE_LINE 00002460 "                        $op->{KIN_REF} = \\$s;"
NSQ_SOURCE_LINE 00002461 "                    }"
NSQ_SOURCE_LINE 00002462 "                    else {"
NSQ_SOURCE_LINE 00002463 "                        croak( \"'\" . ref($source) . \"' not allowed as a source for input redirection\" );"
NSQ_SOURCE_LINE 00002464 "                    }"
NSQ_SOURCE_LINE 00002465 "                    $op->_init_filters;"
NSQ_SOURCE_LINE 00002466 "                }"
NSQ_SOURCE_LINE 00002467 "                elsif ( $op->{TYPE} eq '<pipe' || $op->{TYPE} eq '<blocking_pipe' ) {"
NSQ_SOURCE_LINE 00002468 "                    _debug("
NSQ_SOURCE_LINE 00002469 "                        'kid to read ', $op->{KFD},"
NSQ_SOURCE_LINE 00002470 "                        ' from a pipe IPC::Run opens and returns',"
NSQ_SOURCE_LINE 00002471 "                    ) if _debugging_details;"
NSQ_SOURCE_LINE 00002472 ""
NSQ_SOURCE_LINE 00002473 "                    my ( $r, $w ) = $op->open_pipe( $self->_debug_fd, $op->{SOURCE} );"
NSQ_SOURCE_LINE 00002474 "                    _debug \"caller will write to \", fileno( ref $op->{SOURCE} eq 'SCALAR' ? ${ $op->{SOURCE} } : $op->{SOURCE} )"
NSQ_SOURCE_LINE 00002475 "                      if _debugging_details;"
NSQ_SOURCE_LINE 00002476 ""
NSQ_SOURCE_LINE 00002477 "                    $op->{TFD} = $r;"
NSQ_SOURCE_LINE 00002478 "                    $op->{FD}  = undef;    # we don't manage this fd"
NSQ_SOURCE_LINE 00002479 "                    $op->_init_filters;"
NSQ_SOURCE_LINE 00002480 "                }"
NSQ_SOURCE_LINE 00002481 "                elsif ( $op->{TYPE} eq '<pty<' ) {"
NSQ_SOURCE_LINE 00002482 "                    _debug("
NSQ_SOURCE_LINE 00002483 "                        'kid to read ', $op->{KFD}, \" from pty '\", $op->{PTY_ID}, \"'\","
NSQ_SOURCE_LINE 00002484 "                    ) if _debugging_details;"
NSQ_SOURCE_LINE 00002485 ""
NSQ_SOURCE_LINE 00002486 "                    for my $source ( $op->{SOURCE} ) {"
NSQ_SOURCE_LINE 00002487 "                        if ( UNIVERSAL::isa( $source, 'SCALAR' ) ) {"
NSQ_SOURCE_LINE 00002488 "                            _debug("
NSQ_SOURCE_LINE 00002489 "                                \"kid \",                   $kid->{NUM},   \" to read \", $op->{KFD},"
NSQ_SOURCE_LINE 00002490 "                                \" from SCALAR via pty '\", $op->{PTY_ID}, \"'\""
NSQ_SOURCE_LINE 00002491 "                            ) if _debugging_details;"
NSQ_SOURCE_LINE 00002492 ""
NSQ_SOURCE_LINE 00002493 "                            my $s = '';"
NSQ_SOURCE_LINE 00002494 "                            $op->{KIN_REF} = \\$s;"
NSQ_SOURCE_LINE 00002495 "                        }"
NSQ_SOURCE_LINE 00002496 "                        elsif ( UNIVERSAL::isa( $source, 'CODE' ) ) {"
NSQ_SOURCE_LINE 00002497 "                            _debug("
NSQ_SOURCE_LINE 00002498 "                                \"kid \",                 $kid->{NUM},   \" to read \", $op->{KFD},"
NSQ_SOURCE_LINE 00002499 "                                \" from CODE via pty '\", $op->{PTY_ID}, \"'\""
NSQ_SOURCE_LINE 00002500 "                            ) if _debugging_details;"
NSQ_SOURCE_LINE 00002501 "                            my $s = '';"
NSQ_SOURCE_LINE 00002502 "                            $op->{KIN_REF} = \\$s;"
NSQ_SOURCE_LINE 00002503 "                        }"
NSQ_SOURCE_LINE 00002504 "                        else {"
NSQ_SOURCE_LINE 00002505 "                            croak( \"'\" . ref($source) . \"' not allowed as a source for '<pty<' redirection\" );"
NSQ_SOURCE_LINE 00002506 "                        }"
NSQ_SOURCE_LINE 00002507 "                    }"
NSQ_SOURCE_LINE 00002508 "                    $op->{FD}  = $self->{PTYS}->{ $op->{PTY_ID} }->fileno;"
NSQ_SOURCE_LINE 00002509 "                    $op->{TFD} = undef;                                      # The fd isn't known until after fork()."
NSQ_SOURCE_LINE 00002510 "                    $op->_init_filters;"
NSQ_SOURCE_LINE 00002511 "                }"
NSQ_SOURCE_LINE 00002512 "                elsif ( $op->{TYPE} eq '>' ) {"
NSQ_SOURCE_LINE 00002513 "                    ## N> output redirection."
NSQ_SOURCE_LINE 00002514 "                    my $dest = $op->{DEST};"
NSQ_SOURCE_LINE 00002515 "                    if ( !ref $dest ) {"
NSQ_SOURCE_LINE 00002516 "                        _debug("
NSQ_SOURCE_LINE 00002517 "                            \"kid \",  $kid->{NUM}, \" to write \", $op->{KFD},"
NSQ_SOURCE_LINE 00002518 "                            \" to '\", $dest,       \"' (write only, create, \","
NSQ_SOURCE_LINE 00002519 "                            ( $op->{TRUNC} ? 'truncate' : 'append' ),"
NSQ_SOURCE_LINE 00002520 "                            \")\""
NSQ_SOURCE_LINE 00002521 "                        ) if _debugging_details;"
NSQ_SOURCE_LINE 00002522 "                        croak \"simulated open failure\""
NSQ_SOURCE_LINE 00002523 "                          if $self->{_simulate_open_failure};"
NSQ_SOURCE_LINE 00002524 "                        $op->{TFD} = _sysopen("
NSQ_SOURCE_LINE 00002525 "                            $dest,"
NSQ_SOURCE_LINE 00002526 "                            ( O_WRONLY | O_CREAT | ( $op->{TRUNC} ? O_TRUNC : O_APPEND ) )"
NSQ_SOURCE_LINE 00002527 "                        );"
NSQ_SOURCE_LINE 00002528 "                        if (Win32_MODE) {"
NSQ_SOURCE_LINE 00002529 "                            ## I have no idea why this is needed to make the current"
NSQ_SOURCE_LINE 00002530 "                            ## file position survive the gyrations TFD must go"
NSQ_SOURCE_LINE 00002531 "                            ## through..."
NSQ_SOURCE_LINE 00002532 "                            POSIX::lseek( $op->{TFD}, 0, POSIX::SEEK_END() );"
NSQ_SOURCE_LINE 00002533 "                        }"
NSQ_SOURCE_LINE 00002534 "                        push @close_on_fail, $op->{TFD};"
NSQ_SOURCE_LINE 00002535 "                    }"
NSQ_SOURCE_LINE 00002536 "                    elsif ( UNIVERSAL::isa( $dest, 'GLOB' ) ) {"
NSQ_SOURCE_LINE 00002537 "                        croak(\"Unopened filehandle in output redirect, command $kid->{NUM}\") unless defined fileno $dest;"
NSQ_SOURCE_LINE 00002538 "                        ## Turn on autoflush, mostly just to flush out"
NSQ_SOURCE_LINE 00002539 "                        ## existing output."
NSQ_SOURCE_LINE 00002540 "                        my $old_fh = select($dest);"
NSQ_SOURCE_LINE 00002541 "                        $| = 1;"
NSQ_SOURCE_LINE 00002542 "                        select($old_fh);"
NSQ_SOURCE_LINE 00002543 "                        $op->{TFD} = fileno $dest;"
NSQ_SOURCE_LINE 00002544 "                        _debug( 'kid to write ', $op->{KFD}, ' to handle ', $op->{TFD} ) if _debugging_details;"
NSQ_SOURCE_LINE 00002545 "                    }"
NSQ_SOURCE_LINE 00002546 "                    elsif ( UNIVERSAL::isa( $dest, 'SCALAR' ) ) {"
NSQ_SOURCE_LINE 00002547 "                        _debug( \"kid \", $kid->{NUM}, \" to write $op->{KFD} to SCALAR\" ) if _debugging_details;"
NSQ_SOURCE_LINE 00002548 ""
NSQ_SOURCE_LINE 00002549 "                        $op->open_pipe( $self->_debug_fd );"
NSQ_SOURCE_LINE 00002550 "                        push @close_on_fail, $op->{FD}, $op->{TFD};"
NSQ_SOURCE_LINE 00002551 "                        $$dest = '' if $op->{TRUNC};"
NSQ_SOURCE_LINE 00002552 "                    }"
NSQ_SOURCE_LINE 00002553 "                    elsif ( UNIVERSAL::isa( $dest, 'CODE' ) ) {"
NSQ_SOURCE_LINE 00002554 "                        _debug(\"kid $kid->{NUM} to write $op->{KFD} to CODE\") if _debugging_details;"
NSQ_SOURCE_LINE 00002555 ""
NSQ_SOURCE_LINE 00002556 "                        $op->open_pipe( $self->_debug_fd );"
NSQ_SOURCE_LINE 00002557 "                        push @close_on_fail, $op->{FD}, $op->{TFD};"
NSQ_SOURCE_LINE 00002558 "                    }"
NSQ_SOURCE_LINE 00002559 "                    else {"
NSQ_SOURCE_LINE 00002560 "                        croak( \"'\" . ref($dest) . \"' not allowed as a sink for output redirection\" );"
NSQ_SOURCE_LINE 00002561 "                    }"
NSQ_SOURCE_LINE 00002562 "                    $output_fds_accum[ $op->{KFD} ] = $op;"
NSQ_SOURCE_LINE 00002563 "                    $op->_init_filters;"
NSQ_SOURCE_LINE 00002564 "                }"
NSQ_SOURCE_LINE 00002565 ""
NSQ_SOURCE_LINE 00002566 "                elsif ( $op->{TYPE} eq '>pipe' ) {"
NSQ_SOURCE_LINE 00002567 "                    ## N> output redirection to a pipe we open, but don't select()"
NSQ_SOURCE_LINE 00002568 "                    ## on."
NSQ_SOURCE_LINE 00002569 "                    _debug("
NSQ_SOURCE_LINE 00002570 "                        \"kid \", $kid->{NUM}, \" to write \", $op->{KFD},"
NSQ_SOURCE_LINE 00002571 "                        ' to a pipe IPC::Run opens and returns'"
NSQ_SOURCE_LINE 00002572 "                    ) if _debugging_details;"
NSQ_SOURCE_LINE 00002573 ""
NSQ_SOURCE_LINE 00002574 "                    my ( $r, $w ) = $op->open_pipe( $self->_debug_fd, $op->{DEST} );"
NSQ_SOURCE_LINE 00002575 "                    _debug \"caller will read from \", fileno( ref $op->{DEST} eq 'SCALAR' ? ${ $op->{DEST} } : $op->{DEST} )"
NSQ_SOURCE_LINE 00002576 "                      if _debugging_details;"
NSQ_SOURCE_LINE 00002577 ""
NSQ_SOURCE_LINE 00002578 "                    $op->{TFD} = $w;"
NSQ_SOURCE_LINE 00002579 "                    $op->{FD}  = undef;    # we don't manage this fd"
NSQ_SOURCE_LINE 00002580 "                    $op->_init_filters;"
NSQ_SOURCE_LINE 00002581 ""
NSQ_SOURCE_LINE 00002582 "                    $output_fds_accum[ $op->{KFD} ] = $op;"
NSQ_SOURCE_LINE 00002583 "                }"
NSQ_SOURCE_LINE 00002584 "                elsif ( $op->{TYPE} eq '>pty>' ) {"
NSQ_SOURCE_LINE 00002585 "                    my $dest = $op->{DEST};"
NSQ_SOURCE_LINE 00002586 "                    if ( UNIVERSAL::isa( $dest, 'SCALAR' ) ) {"
NSQ_SOURCE_LINE 00002587 "                        _debug("
NSQ_SOURCE_LINE 00002588 "                            \"kid \",                 $kid->{NUM},   \" to write \", $op->{KFD},"
NSQ_SOURCE_LINE 00002589 "                            \" to SCALAR via pty '\", $op->{PTY_ID}, \"'\""
NSQ_SOURCE_LINE 00002590 "                        ) if _debugging_details;"
NSQ_SOURCE_LINE 00002591 ""
NSQ_SOURCE_LINE 00002592 "                        $$dest = '' if $op->{TRUNC};"
NSQ_SOURCE_LINE 00002593 "                    }"
NSQ_SOURCE_LINE 00002594 "                    elsif ( UNIVERSAL::isa( $dest, 'CODE' ) ) {"
NSQ_SOURCE_LINE 00002595 "                        _debug("
NSQ_SOURCE_LINE 00002596 "                            \"kid \",               $kid->{NUM},   \" to write \", $op->{KFD},"
NSQ_SOURCE_LINE 00002597 "                            \" to CODE via pty '\", $op->{PTY_ID}, \"'\""
NSQ_SOURCE_LINE 00002598 "                        ) if _debugging_details;"
NSQ_SOURCE_LINE 00002599 "                    }"
NSQ_SOURCE_LINE 00002600 "                    else {"
NSQ_SOURCE_LINE 00002601 "                        croak( \"'\" . ref($dest) . \"' not allowed as a sink for output redirection\" );"
NSQ_SOURCE_LINE 00002602 "                    }"
NSQ_SOURCE_LINE 00002603 ""
NSQ_SOURCE_LINE 00002604 "                    $op->{FD}                       = $self->{PTYS}->{ $op->{PTY_ID} }->fileno;"
NSQ_SOURCE_LINE 00002605 "                    $op->{TFD}                      = undef;                                      # The fd isn't known until after fork()."
NSQ_SOURCE_LINE 00002606 "                    $output_fds_accum[ $op->{KFD} ] = $op;"
NSQ_SOURCE_LINE 00002607 "                    $op->_init_filters;"
NSQ_SOURCE_LINE 00002608 "                }"
NSQ_SOURCE_LINE 00002609 "                elsif ( $op->{TYPE} eq '|' ) {"
NSQ_SOURCE_LINE 00002610 "                    _debug( \"pipelining $kid->{NUM} and \" . ( $kid->{NUM} + 1 ) ) if _debugging_details;"
NSQ_SOURCE_LINE 00002611 "                    ( $pipe_read_fd, $op->{TFD} ) = _pipe;"
NSQ_SOURCE_LINE 00002612 "                    if (Win32_MODE) {"
NSQ_SOURCE_LINE 00002613 "                        _dont_inherit($pipe_read_fd);"
NSQ_SOURCE_LINE 00002614 "                        _dont_inherit( $op->{TFD} );"
NSQ_SOURCE_LINE 00002615 "                    }"
NSQ_SOURCE_LINE 00002616 "                    @output_fds_accum = ();"
NSQ_SOURCE_LINE 00002617 "                }"
NSQ_SOURCE_LINE 00002618 "                elsif ( $op->{TYPE} eq '&' ) {"
NSQ_SOURCE_LINE 00002619 "                    @output_fds_accum = ();"
NSQ_SOURCE_LINE 00002620 "                }    # end if $op->{TYPE} tree"
NSQ_SOURCE_LINE 00002621 "                1;"
NSQ_SOURCE_LINE 00002622 "            };    # end eval"
NSQ_SOURCE_LINE 00002623 "            unless ($ok) {"
NSQ_SOURCE_LINE 00002624 "                push @errs, $@;"
NSQ_SOURCE_LINE 00002625 "                _debug 'caught ', $@ if _debugging;"
NSQ_SOURCE_LINE 00002626 "            }"
NSQ_SOURCE_LINE 00002627 "        }    # end for ( OPS }"
NSQ_SOURCE_LINE 00002628 "    }"
NSQ_SOURCE_LINE 00002629 ""
NSQ_SOURCE_LINE 00002630 "    if (@errs) {"
NSQ_SOURCE_LINE 00002631 "        for (@close_on_fail) {"
NSQ_SOURCE_LINE 00002632 "            _close($_);"
NSQ_SOURCE_LINE 00002633 "            $_ = undef;"
NSQ_SOURCE_LINE 00002634 "        }"
NSQ_SOURCE_LINE 00002635 "        for ( keys %{ $self->{PTYS} } ) {"
NSQ_SOURCE_LINE 00002636 "            next unless $self->{PTYS}->{$_};"
NSQ_SOURCE_LINE 00002637 "            close $self->{PTYS}->{$_};"
NSQ_SOURCE_LINE 00002638 "            $self->{PTYS}->{$_} = undef;"
NSQ_SOURCE_LINE 00002639 "        }"
NSQ_SOURCE_LINE 00002640 "        die join( '', @errs );"
NSQ_SOURCE_LINE 00002641 "    }"
NSQ_SOURCE_LINE 00002642 ""
NSQ_SOURCE_LINE 00002643 "    ## give all but the last child all of the output file descriptors"
NSQ_SOURCE_LINE 00002644 "    ## These will be reopened (and thus rendered useless) if the child"
NSQ_SOURCE_LINE 00002645 "    ## dup2s on to these descriptors, since we unshift these.  This way"
NSQ_SOURCE_LINE 00002646 "    ## each process emits output to the same file descriptors that the"
NSQ_SOURCE_LINE 00002647 "    ## last child will write to.  This is probably not quite correct,"
NSQ_SOURCE_LINE 00002648 "    ## since each child should write to the file descriptors inherited"
NSQ_SOURCE_LINE 00002649 "    ## from the parent."
NSQ_SOURCE_LINE 00002650 "    ## TODO: fix the inheritance of output file descriptors."
NSQ_SOURCE_LINE 00002651 "    ## NOTE: This sharing of OPS among kids means that we can't easily put"
NSQ_SOURCE_LINE 00002652 "    ## a kid number in each OPS structure to ping the kid when all ops"
NSQ_SOURCE_LINE 00002653 "    ## have closed (when $self->{PIPES} has emptied).  This means that we"
NSQ_SOURCE_LINE 00002654 "    ## need to scan the KIDS whenever @{$self->{PIPES}} is empty to see"
NSQ_SOURCE_LINE 00002655 "    ## if there any of them are still alive."
NSQ_SOURCE_LINE 00002656 "    for ( my $num = 0; $num < $#{ $self->{KIDS} }; ++$num ) {"
NSQ_SOURCE_LINE 00002657 "        for ( reverse @output_fds_accum ) {"
NSQ_SOURCE_LINE 00002658 "            next unless defined $_;"
NSQ_SOURCE_LINE 00002659 "            _debug("
NSQ_SOURCE_LINE 00002660 "                'kid ', $self->{KIDS}->[$num]->{NUM}, ' also to write ', $_->{KFD},"
NSQ_SOURCE_LINE 00002661 "                ' to ', ref $_->{DEST}"
NSQ_SOURCE_LINE 00002662 "            ) if _debugging_details;"
NSQ_SOURCE_LINE 00002663 "            unshift @{ $self->{KIDS}->[$num]->{OPS} }, $_;"
NSQ_SOURCE_LINE 00002664 "        }"
NSQ_SOURCE_LINE 00002665 "    }"
NSQ_SOURCE_LINE 00002666 ""
NSQ_SOURCE_LINE 00002667 "    ## Open the debug pipe if we need it"
NSQ_SOURCE_LINE 00002668 "    ## Create the list of PIPES we need to scan and the bit vectors needed by"
NSQ_SOURCE_LINE 00002669 "    ## select().  Do this first so that _cleanup can _clobber() them if an"
NSQ_SOURCE_LINE 00002670 "    ## exception occurs."
NSQ_SOURCE_LINE 00002671 "    @{ $self->{PIPES} } = ();"
NSQ_SOURCE_LINE 00002672 "    $self->{RIN} = '';"
NSQ_SOURCE_LINE 00002673 "    $self->{WIN} = '';"
NSQ_SOURCE_LINE 00002674 "    $self->{EIN} = '';"
NSQ_SOURCE_LINE 00002675 "    ## PIN is a vec()tor that indicates who's paused."
NSQ_SOURCE_LINE 00002676 "    $self->{PIN} = '';"
NSQ_SOURCE_LINE 00002677 "    for my $kid ( @{ $self->{KIDS} } ) {"
NSQ_SOURCE_LINE 00002678 "        for ( @{ $kid->{OPS} } ) {"
NSQ_SOURCE_LINE 00002679 "            if ( defined $_->{FD} ) {"
NSQ_SOURCE_LINE 00002680 "                _debug("
NSQ_SOURCE_LINE 00002681 "                    'kid ',    $kid->{NUM}, '[', $kid->{PID}, \"]'s \", $_->{KFD},"
NSQ_SOURCE_LINE 00002682 "                    ' is my ', $_->{FD}"
NSQ_SOURCE_LINE 00002683 "                ) if _debugging_details;"
NSQ_SOURCE_LINE 00002684 "                vec( $self->{ $_->{TYPE} =~ /^</ ? 'WIN' : 'RIN' }, $_->{FD}, 1 ) = 1;"
NSQ_SOURCE_LINE 00002685 ""
NSQ_SOURCE_LINE 00002686 "                #\t    vec( $self->{EIN}, $_->{FD}, 1 ) = 1;"
NSQ_SOURCE_LINE 00002687 "                push @{ $self->{PIPES} }, $_;"
NSQ_SOURCE_LINE 00002688 "            }"
NSQ_SOURCE_LINE 00002689 "        }"
NSQ_SOURCE_LINE 00002690 "    }"
NSQ_SOURCE_LINE 00002691 ""
NSQ_SOURCE_LINE 00002692 "    for my $io ( @{ $self->{IOS} } ) {"
NSQ_SOURCE_LINE 00002693 "        my $fd = $io->fileno;"
NSQ_SOURCE_LINE 00002694 "        vec( $self->{RIN}, $fd, 1 ) = 1 if $io->mode =~ /r/;"
NSQ_SOURCE_LINE 00002695 "        vec( $self->{WIN}, $fd, 1 ) = 1 if $io->mode =~ /w/;"
NSQ_SOURCE_LINE 00002696 ""
NSQ_SOURCE_LINE 00002697 "        #      vec( $self->{EIN}, $fd, 1 ) = 1;"
NSQ_SOURCE_LINE 00002698 "        push @{ $self->{PIPES} }, $io;"
NSQ_SOURCE_LINE 00002699 "    }"
NSQ_SOURCE_LINE 00002700 ""
NSQ_SOURCE_LINE 00002701 "    ## Put filters on the end of the filter chains to read & write the pipes."
NSQ_SOURCE_LINE 00002702 "    ## Clear pipe states"
NSQ_SOURCE_LINE 00002703 "    for my $pipe ( @{ $self->{PIPES} } ) {"
NSQ_SOURCE_LINE 00002704 "        $pipe->{SOURCE_EMPTY} = 0;"
NSQ_SOURCE_LINE 00002705 "        $pipe->{PAUSED}       = 0;"
NSQ_SOURCE_LINE 00002706 "        if ( $pipe->{TYPE} =~ /^>/ ) {"
NSQ_SOURCE_LINE 00002707 "            my $pipe_reader = sub {"
NSQ_SOURCE_LINE 00002708 "                my ( undef, $out_ref ) = @_;"
NSQ_SOURCE_LINE 00002709 ""
NSQ_SOURCE_LINE 00002710 "                return undef unless defined $pipe->{FD};"
NSQ_SOURCE_LINE 00002711 "                return 0 unless vec( $self->{ROUT}, $pipe->{FD}, 1 );"
NSQ_SOURCE_LINE 00002712 ""
NSQ_SOURCE_LINE 00002713 "                vec( $self->{ROUT}, $pipe->{FD}, 1 ) = 0;"
NSQ_SOURCE_LINE 00002714 ""
NSQ_SOURCE_LINE 00002715 "                _debug_desc_fd( 'reading from', $pipe ) if _debugging_details;"
NSQ_SOURCE_LINE 00002716 "                my $in = eval { _read( $pipe->{FD} ) };"
NSQ_SOURCE_LINE 00002717 "                if ($@) {"
NSQ_SOURCE_LINE 00002718 "                    $in = '';"
NSQ_SOURCE_LINE 00002719 "                    ## IO::Pty throws the Input/output error if the kid dies."
NSQ_SOURCE_LINE 00002720 "                    ## read() throws the bad file descriptor message if the"
NSQ_SOURCE_LINE 00002721 "                    ## kid dies on Win32."
NSQ_SOURCE_LINE 00002722 "                    die $@"
NSQ_SOURCE_LINE 00002723 "                      unless $@ =~ $_EIO"
NSQ_SOURCE_LINE 00002724 "                      || ( $@ =~ /input or output/ && $^O =~ /aix/ )"
NSQ_SOURCE_LINE 00002725 "                      || ( Win32_MODE && $@ =~ /Bad file descriptor/ );"
NSQ_SOURCE_LINE 00002726 "                }"
NSQ_SOURCE_LINE 00002727 ""
NSQ_SOURCE_LINE 00002728 "                unless ( length $in ) {"
NSQ_SOURCE_LINE 00002729 "                    $self->_clobber($pipe);"
NSQ_SOURCE_LINE 00002730 "                    return undef;"
NSQ_SOURCE_LINE 00002731 "                }"
NSQ_SOURCE_LINE 00002732 ""
NSQ_SOURCE_LINE 00002733 "                ## Protect the position so /.../g matches may be used."
NSQ_SOURCE_LINE 00002734 "                my $pos = pos $$out_ref;"
NSQ_SOURCE_LINE 00002735 "                $$out_ref .= $in;"
NSQ_SOURCE_LINE 00002736 "                pos($$out_ref) = $pos;"
NSQ_SOURCE_LINE 00002737 "                return 1;"
NSQ_SOURCE_LINE 00002738 "            };"
NSQ_SOURCE_LINE 00002739 "            ## Input filters are the last filters"
NSQ_SOURCE_LINE 00002740 "            push @{ $pipe->{FILTERS} },      $pipe_reader;"
NSQ_SOURCE_LINE 00002741 "            push @{ $self->{TEMP_FILTERS} }, $pipe_reader;"
NSQ_SOURCE_LINE 00002742 "        }"
NSQ_SOURCE_LINE 00002743 "        else {"
NSQ_SOURCE_LINE 00002744 "            my $pipe_writer = sub {"
NSQ_SOURCE_LINE 00002745 "                my ( $in_ref, $out_ref ) = @_;"
NSQ_SOURCE_LINE 00002746 "                return undef unless defined $pipe->{FD};"
NSQ_SOURCE_LINE 00002747 "                return 0"
NSQ_SOURCE_LINE 00002748 "                  unless vec( $self->{WOUT}, $pipe->{FD}, 1 )"
NSQ_SOURCE_LINE 00002749 "                  || $pipe->{PAUSED};"
NSQ_SOURCE_LINE 00002750 ""
NSQ_SOURCE_LINE 00002751 "                vec( $self->{WOUT}, $pipe->{FD}, 1 ) = 0;"
NSQ_SOURCE_LINE 00002752 ""
NSQ_SOURCE_LINE 00002753 "                if ( !length $$in_ref ) {"
NSQ_SOURCE_LINE 00002754 "                    if ( !defined get_more_input ) {"
NSQ_SOURCE_LINE 00002755 "                        $self->_clobber($pipe);"
NSQ_SOURCE_LINE 00002756 "                        return undef;"
NSQ_SOURCE_LINE 00002757 "                    }"
NSQ_SOURCE_LINE 00002758 "                }"
NSQ_SOURCE_LINE 00002759 ""
NSQ_SOURCE_LINE 00002760 "                unless ( length $$in_ref ) {"
NSQ_SOURCE_LINE 00002761 "                    unless ( $pipe->{PAUSED} ) {"
NSQ_SOURCE_LINE 00002762 "                        _debug_desc_fd( 'pausing', $pipe ) if _debugging_details;"
NSQ_SOURCE_LINE 00002763 "                        vec( $self->{WIN}, $pipe->{FD}, 1 ) = 0;"
NSQ_SOURCE_LINE 00002764 ""
NSQ_SOURCE_LINE 00002765 "                        #\t\t  vec( $self->{EIN}, $pipe->{FD}, 1 ) = 0;"
NSQ_SOURCE_LINE 00002766 "                        vec( $self->{PIN}, $pipe->{FD}, 1 ) = 1;"
NSQ_SOURCE_LINE 00002767 "                        $pipe->{PAUSED} = 1;"
NSQ_SOURCE_LINE 00002768 "                    }"
NSQ_SOURCE_LINE 00002769 "                    return 0;"
NSQ_SOURCE_LINE 00002770 "                }"
NSQ_SOURCE_LINE 00002771 "                _debug_desc_fd( 'writing to', $pipe ) if _debugging_details;"
NSQ_SOURCE_LINE 00002772 ""
NSQ_SOURCE_LINE 00002773 "                if ( length $$in_ref ) {"
NSQ_SOURCE_LINE 00002774 "                    my $c = _write( $pipe->{FD}, $$in_ref );"
NSQ_SOURCE_LINE 00002775 "                    unless ( defined $c ) {"
NSQ_SOURCE_LINE 00002776 "                        ## EPIPE: child closed stdin before reading all input."
NSQ_SOURCE_LINE 00002777 "                        ## Treat this exactly like EOF on the pipe."
NSQ_SOURCE_LINE 00002778 "                        _debug_desc_fd( 'broken pipe writing to', $pipe )"
NSQ_SOURCE_LINE 00002779 "                          if _debugging_details;"
NSQ_SOURCE_LINE 00002780 "                        $self->_clobber($pipe);"
NSQ_SOURCE_LINE 00002781 "                        return undef;"
NSQ_SOURCE_LINE 00002782 "                    }"
NSQ_SOURCE_LINE 00002783 "                    substr( $$in_ref, 0, $c, '' );"
NSQ_SOURCE_LINE 00002784 "                }"
NSQ_SOURCE_LINE 00002785 "                else {"
NSQ_SOURCE_LINE 00002786 "                    $self->_clobber($pipe);"
NSQ_SOURCE_LINE 00002787 "                    return undef;"
NSQ_SOURCE_LINE 00002788 "                }"
NSQ_SOURCE_LINE 00002789 ""
NSQ_SOURCE_LINE 00002790 "                return 1;"
NSQ_SOURCE_LINE 00002791 "            };"
NSQ_SOURCE_LINE 00002792 "            ## Output filters are the first filters"
NSQ_SOURCE_LINE 00002793 "            unshift @{ $pipe->{FILTERS} }, $pipe_writer;"
NSQ_SOURCE_LINE 00002794 "            push @{ $self->{TEMP_FILTERS} }, $pipe_writer;"
NSQ_SOURCE_LINE 00002795 "        }"
NSQ_SOURCE_LINE 00002796 "    }"
NSQ_SOURCE_LINE 00002797 "}"
NSQ_SOURCE_LINE 00002798 ""
NSQ_SOURCE_LINE 00002799 "sub _dup2_gently {"
NSQ_SOURCE_LINE 00002800 "    ## A METHOD, NOT A FUNCTION, NEEDS $self!"
NSQ_SOURCE_LINE 00002801 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00002802 "    my ( $files, $fd1, $fd2 ) = @_;"
NSQ_SOURCE_LINE 00002803 "    ## Moves TFDs that are using the destination fd out of the"
NSQ_SOURCE_LINE 00002804 "    ## way before calling _dup2"
NSQ_SOURCE_LINE 00002805 "    for (@$files) {"
NSQ_SOURCE_LINE 00002806 "        next unless defined $_->{TFD};"
NSQ_SOURCE_LINE 00002807 "        $_->{TFD} = _dup( $_->{TFD} ) if $_->{TFD} == $fd2;"
NSQ_SOURCE_LINE 00002808 "    }"
NSQ_SOURCE_LINE 00002809 "    if ( defined $self->{DEBUG_FD} && $self->{DEBUG_FD} == $fd2 ) {"
NSQ_SOURCE_LINE 00002810 "        $self->{DEBUG_FD} = _dup $self->{DEBUG_FD};"
NSQ_SOURCE_LINE 00002811 "        $fds{$self->{DEBUG_FD}}{needed} = 1;"
NSQ_SOURCE_LINE 00002812 "    }"
NSQ_SOURCE_LINE 00002813 "    _dup2_rudely( $fd1, $fd2 );"
NSQ_SOURCE_LINE 00002814 "}"
NSQ_SOURCE_LINE 00002815 ""
NSQ_SOURCE_LINE 00002816 "=pod"
NSQ_SOURCE_LINE 00002817 ""
NSQ_SOURCE_LINE 00002818 "=item close_terminal"
NSQ_SOURCE_LINE 00002819 ""
NSQ_SOURCE_LINE 00002820 "This is used as (or in) an init sub to cast off the bonds of a controlling"
NSQ_SOURCE_LINE 00002821 "terminal.  It must precede all other redirection ops that affect"
NSQ_SOURCE_LINE 00002822 "STDIN, STDOUT, or STDERR to be guaranteed effective."
NSQ_SOURCE_LINE 00002823 ""
NSQ_SOURCE_LINE 00002824 "=cut"
NSQ_SOURCE_LINE 00002825 ""
NSQ_SOURCE_LINE 00002826 "sub close_terminal {"
NSQ_SOURCE_LINE 00002827 "    ## Cast of the bonds of a controlling terminal"
NSQ_SOURCE_LINE 00002828 ""
NSQ_SOURCE_LINE 00002829 "    # Just in case the parent (I'm talking to you FCGI) had these tied."
NSQ_SOURCE_LINE 00002830 "    untie *STDIN;"
NSQ_SOURCE_LINE 00002831 "    untie *STDOUT;"
NSQ_SOURCE_LINE 00002832 "    untie *STDERR;"
NSQ_SOURCE_LINE 00002833 ""
NSQ_SOURCE_LINE 00002834 "    POSIX::setsid() || croak \"POSIX::setsid() failed\";"
NSQ_SOURCE_LINE 00002835 "    _debug \"closing stdin, out, err\""
NSQ_SOURCE_LINE 00002836 "      if _debugging_details;"
NSQ_SOURCE_LINE 00002837 "    close STDIN;"
NSQ_SOURCE_LINE 00002838 "    close STDERR;"
NSQ_SOURCE_LINE 00002839 "    close STDOUT;"
NSQ_SOURCE_LINE 00002840 "}"
NSQ_SOURCE_LINE 00002841 ""
NSQ_SOURCE_LINE 00002842 "sub _do_kid_and_exit {"
NSQ_SOURCE_LINE 00002843 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00002844 "    my ($kid) = @_;"
NSQ_SOURCE_LINE 00002845 ""
NSQ_SOURCE_LINE 00002846 "    my ( $s1, $s2 );"
NSQ_SOURCE_LINE 00002847 "    if ( $] < 5.008 ) {"
NSQ_SOURCE_LINE 00002848 "        ## For unknown reasons, placing these two statements in the eval{}"
NSQ_SOURCE_LINE 00002849 "        ## causes the eval {} to not catch errors after they are executed in"
NSQ_SOURCE_LINE 00002850 "        ## perl 5.6.0, godforsaken version that it is...not sure about 5.6.1."
NSQ_SOURCE_LINE 00002851 "        ## Part of this could be that these symbols get destructed when"
NSQ_SOURCE_LINE 00002852 "        ## exiting the eval, and that destruction might be what's (wrongly)"
NSQ_SOURCE_LINE 00002853 "        ## confusing the eval{}, allowing the exception to propagate."
NSQ_SOURCE_LINE 00002854 "        $s1 = Symbol::gensym();"
NSQ_SOURCE_LINE 00002855 "        $s2 = Symbol::gensym();"
NSQ_SOURCE_LINE 00002856 "    }"
NSQ_SOURCE_LINE 00002857 ""
NSQ_SOURCE_LINE 00002858 "    eval {"
NSQ_SOURCE_LINE 00002859 "        local $cur_self = $self;"
NSQ_SOURCE_LINE 00002860 ""
NSQ_SOURCE_LINE 00002861 "        ## Suppress \"Filehandle STDIN reopened as ... only for output\" warnings."
NSQ_SOURCE_LINE 00002862 "        ## In the child process, we intentionally reuse fd 0/1/2 after"
NSQ_SOURCE_LINE 00002863 "        ## close_terminal() frees them. This is expected during pty setup"
NSQ_SOURCE_LINE 00002864 "        ## and should not warn even when the parent has $^W=1."
NSQ_SOURCE_LINE 00002865 "        local $^W = 0;"
NSQ_SOURCE_LINE 00002866 ""
NSQ_SOURCE_LINE 00002867 "        if (_debugging) {"
NSQ_SOURCE_LINE 00002868 "            _set_child_debug_name("
NSQ_SOURCE_LINE 00002869 "                ref $kid->{VAL} eq \"CODE\""
NSQ_SOURCE_LINE 00002870 "                ? \"CODE\""
NSQ_SOURCE_LINE 00002871 "                : basename( $kid->{VAL}->[0] )"
NSQ_SOURCE_LINE 00002872 "            );"
NSQ_SOURCE_LINE 00002873 "        }"
NSQ_SOURCE_LINE 00002874 ""
NSQ_SOURCE_LINE 00002875 "        ## close parent FD's first so they're out of the way."
NSQ_SOURCE_LINE 00002876 "        ## Don't close STDIN, STDOUT, STDERR: they should be inherited or"
NSQ_SOURCE_LINE 00002877 "        ## overwritten below."
NSQ_SOURCE_LINE 00002878 "        do { $_->{needed} = 1 for @fds{0..2} }"
NSQ_SOURCE_LINE 00002879 "           unless $self->{noinherit};"
NSQ_SOURCE_LINE 00002880 ""
NSQ_SOURCE_LINE 00002881 "        $fds{$self->{SYNC_WRITER_FD}}{needed} = 1;"
NSQ_SOURCE_LINE 00002882 "        $fds{$self->{CODEREF_ERR_FD}}{needed} = 1 if defined $self->{CODEREF_ERR_FD};"
NSQ_SOURCE_LINE 00002883 "        $fds{$self->{DEBUG_FD}}{needed} = 1 if defined $self->{DEBUG_FD};"
NSQ_SOURCE_LINE 00002884 ""
NSQ_SOURCE_LINE 00002885 "        $fds{$_->{TFD}}{needed} = 1"
NSQ_SOURCE_LINE 00002886 "           foreach grep { defined $_->{TFD} } @{$kid->{OPS} };"
NSQ_SOURCE_LINE 00002887 ""
NSQ_SOURCE_LINE 00002888 ""
NSQ_SOURCE_LINE 00002889 "        ## TODO: use the forthcoming IO::Pty to close the terminal and"
NSQ_SOURCE_LINE 00002890 "        ## make the first pty for this child the controlling terminal."
NSQ_SOURCE_LINE 00002891 "        ## This will also make it so that pty-laden kids don't cause"
NSQ_SOURCE_LINE 00002892 "        ## other kids to lose stdin/stdout/stderr."
NSQ_SOURCE_LINE 00002893 ""
NSQ_SOURCE_LINE 00002894 "        if ( %{ $self->{PTYS} } ) {"
NSQ_SOURCE_LINE 00002895 "            ## Clean up the parent's fds."
NSQ_SOURCE_LINE 00002896 "            for ( keys %{ $self->{PTYS} } ) {"
NSQ_SOURCE_LINE 00002897 "                _debug \"Cleaning up parent's ptty '$_'\" if _debugging_details;"
NSQ_SOURCE_LINE 00002898 "                $self->{PTYS}->{$_}->make_slave_controlling_terminal;"
NSQ_SOURCE_LINE 00002899 "                my $slave = $self->{PTYS}->{$_}->slave;"
NSQ_SOURCE_LINE 00002900 " \t        delete $fds{$self->{PTYS}->{$_}->fileno};"
NSQ_SOURCE_LINE 00002901 "                close $self->{PTYS}->{$_};"
NSQ_SOURCE_LINE 00002902 "                $self->{PTYS}->{$_} = $slave;"
NSQ_SOURCE_LINE 00002903 "            }"
NSQ_SOURCE_LINE 00002904 ""
NSQ_SOURCE_LINE 00002905 "            close_terminal;"
NSQ_SOURCE_LINE 00002906 "            delete @fds{0..2};"
NSQ_SOURCE_LINE 00002907 "        }"
NSQ_SOURCE_LINE 00002908 ""
NSQ_SOURCE_LINE 00002909 "        for my $sibling ( @{ $self->{KIDS} } ) {"
NSQ_SOURCE_LINE 00002910 "            for ( @{ $sibling->{OPS} } ) {"
NSQ_SOURCE_LINE 00002911 "                if ( $_->{TYPE} =~ /^.pty.$/ ) {"
NSQ_SOURCE_LINE 00002912 "                    $_->{TFD} = $self->{PTYS}->{ $_->{PTY_ID} }->fileno;"
NSQ_SOURCE_LINE 00002913 "                    $fds{$_->{TFD}}{needed} = 1;"
NSQ_SOURCE_LINE 00002914 "                }"
NSQ_SOURCE_LINE 00002915 ""
NSQ_SOURCE_LINE 00002916 "            }"
NSQ_SOURCE_LINE 00002917 "        }"
NSQ_SOURCE_LINE 00002918 ""
NSQ_SOURCE_LINE 00002919 "        ## This is crude: we have no way of keeping track of browsing all open"
NSQ_SOURCE_LINE 00002920 "        ## fds, so we scan to a fairly high fd."
NSQ_SOURCE_LINE 00002921 "        _debug \"open fds: \", join \" \", keys %fds if _debugging_details;"
NSQ_SOURCE_LINE 00002922 ""
NSQ_SOURCE_LINE 00002923 "        _close( $_ ) foreach grep { ! $fds{$_}{needed} } keys %fds;"
NSQ_SOURCE_LINE 00002924 ""
NSQ_SOURCE_LINE 00002925 "        if ( $kid->{ENV} ) {"
NSQ_SOURCE_LINE 00002926 "            foreach my $k ( keys %{ $kid->{ENV} } ) {"
NSQ_SOURCE_LINE 00002927 "                $ENV{$k} = $kid->{ENV}{$k};"
NSQ_SOURCE_LINE 00002928 "            }"
NSQ_SOURCE_LINE 00002929 "        }"
NSQ_SOURCE_LINE 00002930 ""
NSQ_SOURCE_LINE 00002931 "        for ( @{ $kid->{OPS} } ) {"
NSQ_SOURCE_LINE 00002932 "            if ( defined $_->{TFD} ) {"
NSQ_SOURCE_LINE 00002933 ""
NSQ_SOURCE_LINE 00002934 "                # we're always creating KFD"
NSQ_SOURCE_LINE 00002935 "                $fds{$_->{KFD}}{needed} = 1;"
NSQ_SOURCE_LINE 00002936 ""
NSQ_SOURCE_LINE 00002937 "                unless ( $_->{TFD} == $_->{KFD} ) {"
NSQ_SOURCE_LINE 00002938 "                    $self->_dup2_gently( $kid->{OPS}, $_->{TFD}, $_->{KFD} );"
NSQ_SOURCE_LINE 00002939 "                    $fds{$_->{TFD}}{lazy_close} = 1;"
NSQ_SOURCE_LINE 00002940 "                } else {"
NSQ_SOURCE_LINE 00002941 "                    my $fd = _dup($_->{TFD});"
NSQ_SOURCE_LINE 00002942 "                    $_->{TFD} = $fd;"
NSQ_SOURCE_LINE 00002943 "                    $self->_dup2_gently( $kid->{OPS}, $fd, $_->{KFD} );"
NSQ_SOURCE_LINE 00002944 "                    _close($fd);"
NSQ_SOURCE_LINE 00002945 "                }"
NSQ_SOURCE_LINE 00002946 "            }"
NSQ_SOURCE_LINE 00002947 "            elsif ( $_->{TYPE} eq 'dup' ) {"
NSQ_SOURCE_LINE 00002948 "                $self->_dup2_gently( $kid->{OPS}, $_->{KFD1}, $_->{KFD2} )"
NSQ_SOURCE_LINE 00002949 "                  unless $_->{KFD1} == $_->{KFD2};"
NSQ_SOURCE_LINE 00002950 "                $fds{$_->{KFD2}}{needed} = 1;"
NSQ_SOURCE_LINE 00002951 "            }"
NSQ_SOURCE_LINE 00002952 "            elsif ( $_->{TYPE} eq 'close' ) {"
NSQ_SOURCE_LINE 00002953 "                for ( $_->{KFD} ) {"
NSQ_SOURCE_LINE 00002954 "                    if ( $fds{$_} ) {"
NSQ_SOURCE_LINE 00002955 "                        _close($_);"
NSQ_SOURCE_LINE 00002956 "                        $_ = undef;"
NSQ_SOURCE_LINE 00002957 "                    }"
NSQ_SOURCE_LINE 00002958 "                }"
NSQ_SOURCE_LINE 00002959 "            }"
NSQ_SOURCE_LINE 00002960 "            elsif ( $_->{TYPE} eq 'init' ) {"
NSQ_SOURCE_LINE 00002961 "                $_->{SUB}->();"
NSQ_SOURCE_LINE 00002962 "            }"
NSQ_SOURCE_LINE 00002963 "        }"
NSQ_SOURCE_LINE 00002964 ""
NSQ_SOURCE_LINE 00002965 "        _close( $_ ) foreach grep { $fds{$_}{lazy_close} } keys %fds;"
NSQ_SOURCE_LINE 00002966 ""
NSQ_SOURCE_LINE 00002967 "        if ( ref $kid->{VAL} ne 'CODE' ) {"
NSQ_SOURCE_LINE 00002968 "            open $s1, \">&=$self->{SYNC_WRITER_FD}\""
NSQ_SOURCE_LINE 00002969 "              or croak \"$! setting filehandle to fd SYNC_WRITER_FD\";"
NSQ_SOURCE_LINE 00002970 "            fcntl $s1, F_SETFD, 1;"
NSQ_SOURCE_LINE 00002971 ""
NSQ_SOURCE_LINE 00002972 "            if ( defined $self->{DEBUG_FD} ) {"
NSQ_SOURCE_LINE 00002973 "                open $s2, \">&=$self->{DEBUG_FD}\""
NSQ_SOURCE_LINE 00002974 "                  or croak \"$! setting filehandle to fd DEBUG_FD\";"
NSQ_SOURCE_LINE 00002975 "                fcntl $s2, F_SETFD, 1;"
NSQ_SOURCE_LINE 00002976 "            }"
NSQ_SOURCE_LINE 00002977 ""
NSQ_SOURCE_LINE 00002978 "            if (_debugging) {"
NSQ_SOURCE_LINE 00002979 "                my @cmd = ( $kid->{PATH}, @{ $kid->{VAL} }[ 1 .. $#{ $kid->{VAL} } ] );"
NSQ_SOURCE_LINE 00002980 "                _debug 'execing ', join \" \", map { /[\\s\\\"]/ ? \"'$_'\" : $_ } @cmd;"
NSQ_SOURCE_LINE 00002981 "            }"
NSQ_SOURCE_LINE 00002982 ""
NSQ_SOURCE_LINE 00002983 "            die \"exec failed: simulating exec() failure\""
NSQ_SOURCE_LINE 00002984 "              if $self->{_simulate_exec_failure};"
NSQ_SOURCE_LINE 00002985 ""
NSQ_SOURCE_LINE 00002986 "            _exec $kid->{PATH}, @{ $kid->{VAL} }[ 1 .. $#{ $kid->{VAL} } ];"
NSQ_SOURCE_LINE 00002987 ""
NSQ_SOURCE_LINE 00002988 "            croak \"exec failed: $!\";"
NSQ_SOURCE_LINE 00002989 "        }"
NSQ_SOURCE_LINE 00002990 "    };"
NSQ_SOURCE_LINE 00002991 "    if ($@) {"
NSQ_SOURCE_LINE 00002992 "        _write $self->{SYNC_WRITER_FD}, $@;"
NSQ_SOURCE_LINE 00002993 "        ## Avoid DESTROY."
NSQ_SOURCE_LINE 00002994 "        POSIX::_exit(1);"
NSQ_SOURCE_LINE 00002995 "    }"
NSQ_SOURCE_LINE 00002996 ""
NSQ_SOURCE_LINE 00002997 "    ## We must be executing code in the child, otherwise exec() would have"
NSQ_SOURCE_LINE 00002998 "    ## prevented us from being here."
NSQ_SOURCE_LINE 00002999 "    _close $self->{SYNC_WRITER_FD};"
NSQ_SOURCE_LINE 00003000 "    _debug 'calling fork()ed CODE ref' if _debugging;"
NSQ_SOURCE_LINE 00003001 "    POSIX::close $self->{DEBUG_FD} if defined $self->{DEBUG_FD};"
NSQ_SOURCE_LINE 00003002 "    ## TODO: Overload CORE::GLOBAL::exit..."
NSQ_SOURCE_LINE 00003003 "    ## Wrap the coderef in eval so that a die() inside it does not propagate"
NSQ_SOURCE_LINE 00003004 "    ## out of _do_kid_and_exit and escape into the parent process's call stack."
NSQ_SOURCE_LINE 00003005 "    ## Without this, the exception would unwind past the fork() point and cause"
NSQ_SOURCE_LINE 00003006 "    ## the child to continue executing parent code (GH#97)."
NSQ_SOURCE_LINE 00003007 "    eval { $kid->{VAL}->() };"
NSQ_SOURCE_LINE 00003008 "    my $kid_err = $@;"
NSQ_SOURCE_LINE 00003009 ""
NSQ_SOURCE_LINE 00003010 "    ## There are bugs in perl closures up to and including 5.6.1"
NSQ_SOURCE_LINE 00003011 "    ## that may keep this next line from having any effect, and it"
NSQ_SOURCE_LINE 00003012 "    ## won't have any effect if our caller has kept a copy of it, but"
NSQ_SOURCE_LINE 00003013 "    ## this may cause the closure to be cleaned up.  Maybe."
NSQ_SOURCE_LINE 00003014 "    $kid->{VAL} = undef;"
NSQ_SOURCE_LINE 00003015 ""
NSQ_SOURCE_LINE 00003016 "    ## GH#122: Propagate the exception back to the parent via a dedicated"
NSQ_SOURCE_LINE 00003017 "    ## error pipe.  We can't use the sync pipe because it must be closed"
NSQ_SOURCE_LINE 00003018 "    ## before running the CODE ref to avoid deadlocks (the parent blocks"
NSQ_SOURCE_LINE 00003019 "    ## on the sync pipe, so the child can't do I/O with the parent until"
NSQ_SOURCE_LINE 00003020 "    ## the sync pipe is closed)."
NSQ_SOURCE_LINE 00003021 "    if ($kid_err) {"
NSQ_SOURCE_LINE 00003022 "        if ( defined $self->{CODEREF_ERR_FD} ) {"
NSQ_SOURCE_LINE 00003023 "            _write $self->{CODEREF_ERR_FD}, $kid_err;"
NSQ_SOURCE_LINE 00003024 "            POSIX::close $self->{CODEREF_ERR_FD};"
NSQ_SOURCE_LINE 00003025 "        }"
NSQ_SOURCE_LINE 00003026 "        POSIX::_exit(1);"
NSQ_SOURCE_LINE 00003027 "    }"
NSQ_SOURCE_LINE 00003028 ""
NSQ_SOURCE_LINE 00003029 "    POSIX::close $self->{CODEREF_ERR_FD}"
NSQ_SOURCE_LINE 00003030 "      if defined $self->{CODEREF_ERR_FD};"
NSQ_SOURCE_LINE 00003031 ""
NSQ_SOURCE_LINE 00003032 "    ## Use POSIX::_exit to avoid global destruction, since this might"
NSQ_SOURCE_LINE 00003033 "    ## cause DESTROY() to be called on objects created in the parent"
NSQ_SOURCE_LINE 00003034 "    ## and thus cause double cleanup.  For instance, if DESTROY() unlinks"
NSQ_SOURCE_LINE 00003035 "    ## a file in the child, we don't want the parent to suddenly miss"
NSQ_SOURCE_LINE 00003036 "    ## it."
NSQ_SOURCE_LINE 00003037 "    POSIX::_exit(0);"
NSQ_SOURCE_LINE 00003038 "}"
NSQ_SOURCE_LINE 00003039 ""
NSQ_SOURCE_LINE 00003040 "=pod"
NSQ_SOURCE_LINE 00003041 ""
NSQ_SOURCE_LINE 00003042 "=item start"
NSQ_SOURCE_LINE 00003043 ""
NSQ_SOURCE_LINE 00003044 "   $h = start("
NSQ_SOURCE_LINE 00003045 "      \\@cmd, \\$in, \\$out, ...,"
NSQ_SOURCE_LINE 00003046 "      timeout( 30, name => \"process timeout\" ),"
NSQ_SOURCE_LINE 00003047 "      $stall_timeout = timeout( 10, name => \"stall timeout\"   ),"
NSQ_SOURCE_LINE 00003048 "   );"
NSQ_SOURCE_LINE 00003049 ""
NSQ_SOURCE_LINE 00003050 "   $h = start \\@cmd, '<', \\$in, '|', \\@cmd2, ...;"
NSQ_SOURCE_LINE 00003051 ""
NSQ_SOURCE_LINE 00003052 "start() accepts a harness or harness specification and returns a harness"
NSQ_SOURCE_LINE 00003053 "after building all of the pipes and launching (via fork()/exec(), or, maybe"
NSQ_SOURCE_LINE 00003054 "someday, spawn()) all the child processes.  It does not send or receive any"
NSQ_SOURCE_LINE 00003055 "data on the pipes, see pump() and finish() for that."
NSQ_SOURCE_LINE 00003056 ""
NSQ_SOURCE_LINE 00003057 "You may call harness() and then pass its result to start() if you like,"
NSQ_SOURCE_LINE 00003058 "but you only need to if it helps you structure or tune your application."
NSQ_SOURCE_LINE 00003059 "If you do call harness(), you may skip start() and proceed directly to"
NSQ_SOURCE_LINE 00003060 "pump."
NSQ_SOURCE_LINE 00003061 ""
NSQ_SOURCE_LINE 00003062 "start() also starts all timers in the harness.  See L<IPC::Run::Timer>"
NSQ_SOURCE_LINE 00003063 "for more information."
NSQ_SOURCE_LINE 00003064 ""
NSQ_SOURCE_LINE 00003065 "start() flushes STDOUT and STDERR to help you avoid duplicate output."
NSQ_SOURCE_LINE 00003066 "It has no way of asking Perl to flush all your open filehandles, so"
NSQ_SOURCE_LINE 00003067 "you are going to need to flush any others you have open.  Sorry."
NSQ_SOURCE_LINE 00003068 ""
NSQ_SOURCE_LINE 00003069 "Here's how if you don't want to alter the state of $| for your"
NSQ_SOURCE_LINE 00003070 "filehandle:"
NSQ_SOURCE_LINE 00003071 ""
NSQ_SOURCE_LINE 00003072 "   $ofh = select HANDLE; $of = $|; $| = 1; $| = $of; select $ofh;"
NSQ_SOURCE_LINE 00003073 ""
NSQ_SOURCE_LINE 00003074 "If you don't mind leaving output unbuffered on HANDLE, you can do"
NSQ_SOURCE_LINE 00003075 "the slightly shorter"
NSQ_SOURCE_LINE 00003076 ""
NSQ_SOURCE_LINE 00003077 "   $ofh = select HANDLE; $| = 1; select $ofh;"
NSQ_SOURCE_LINE 00003078 ""
NSQ_SOURCE_LINE 00003079 "Or, you can use IO::Handle's flush() method:"
NSQ_SOURCE_LINE 00003080 ""
NSQ_SOURCE_LINE 00003081 "   use IO::Handle;"
NSQ_SOURCE_LINE 00003082 "   flush HANDLE;"
NSQ_SOURCE_LINE 00003083 ""
NSQ_SOURCE_LINE 00003084 "Perl needs the equivalent of C's fflush( (FILE *)NULL )."
NSQ_SOURCE_LINE 00003085 ""
NSQ_SOURCE_LINE 00003086 "=cut"
NSQ_SOURCE_LINE 00003087 ""
NSQ_SOURCE_LINE 00003088 "sub start {"
NSQ_SOURCE_LINE 00003089 ""
NSQ_SOURCE_LINE 00003090 "    # $SIG{__DIE__} = sub { my $s = shift; Carp::cluck $s; die $s };"
NSQ_SOURCE_LINE 00003091 "    my $options;"
NSQ_SOURCE_LINE 00003092 "    if ( @_ && ref $_[-1] eq 'HASH' ) {"
NSQ_SOURCE_LINE 00003093 "        $options = pop;"
NSQ_SOURCE_LINE 00003094 "        require Data::Dumper;"
NSQ_SOURCE_LINE 00003095 "        carp \"Passing in options as a hash is deprecated:\\n\", Data::Dumper::Dumper($options);"
NSQ_SOURCE_LINE 00003096 "    }"
NSQ_SOURCE_LINE 00003097 ""
NSQ_SOURCE_LINE 00003098 "    my IPC::Run $self;"
NSQ_SOURCE_LINE 00003099 "    if ( @_ == 1 && UNIVERSAL::isa( $_[0], __PACKAGE__ ) ) {"
NSQ_SOURCE_LINE 00003100 "        $self = shift;"
NSQ_SOURCE_LINE 00003101 "        $self->{$_} = $options->{$_} for keys %$options;"
NSQ_SOURCE_LINE 00003102 "    }"
NSQ_SOURCE_LINE 00003103 "    else {"
NSQ_SOURCE_LINE 00003104 "        $self = harness( @_, $options ? $options : () );"
NSQ_SOURCE_LINE 00003105 "    }"
NSQ_SOURCE_LINE 00003106 ""
NSQ_SOURCE_LINE 00003107 "    local $cur_self = $self;"
NSQ_SOURCE_LINE 00003108 ""
NSQ_SOURCE_LINE 00003109 "    $self->kill_kill if $self->{STATE} == _started;"
NSQ_SOURCE_LINE 00003110 ""
NSQ_SOURCE_LINE 00003111 "    _debug \"** starting\" if _debugging;"
NSQ_SOURCE_LINE 00003112 ""
NSQ_SOURCE_LINE 00003113 "    $_->{RESULT} = undef for @{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00003114 ""
NSQ_SOURCE_LINE 00003115 "    ## Assume we're not being called from &run.  It will correct our"
NSQ_SOURCE_LINE 00003116 "    ## assumption if need be.  This affects whether &_select_loop clears"
NSQ_SOURCE_LINE 00003117 "    ## input queues to '' when they're empty."
NSQ_SOURCE_LINE 00003118 "    $self->{clear_ins} = 1;"
NSQ_SOURCE_LINE 00003119 ""
NSQ_SOURCE_LINE 00003120 "    IPC::Run::Win32Helper::optimize $self"
NSQ_SOURCE_LINE 00003121 "      if Win32_MODE && $in_run;"
NSQ_SOURCE_LINE 00003122 ""
NSQ_SOURCE_LINE 00003123 "    my @errs;"
NSQ_SOURCE_LINE 00003124 ""
NSQ_SOURCE_LINE 00003125 "    for ( @{ $self->{TIMERS} } ) {"
NSQ_SOURCE_LINE 00003126 "        eval { $_->start };"
NSQ_SOURCE_LINE 00003127 "        if ($@) {"
NSQ_SOURCE_LINE 00003128 "            push @errs, $@;"
NSQ_SOURCE_LINE 00003129 "            _debug 'caught ', $@ if _debugging;"
NSQ_SOURCE_LINE 00003130 "        }"
NSQ_SOURCE_LINE 00003131 "    }"
NSQ_SOURCE_LINE 00003132 ""
NSQ_SOURCE_LINE 00003133 "    eval { $self->_open_pipes };"
NSQ_SOURCE_LINE 00003134 "    if ($@) {"
NSQ_SOURCE_LINE 00003135 "        push @errs, $@;"
NSQ_SOURCE_LINE 00003136 "        _debug 'caught ', $@ if _debugging;"
NSQ_SOURCE_LINE 00003137 "    }"
NSQ_SOURCE_LINE 00003138 ""
NSQ_SOURCE_LINE 00003139 "    if ( !@errs ) {"
NSQ_SOURCE_LINE 00003140 "        ## This is a bit of a hack, we should do it for all open filehandles."
NSQ_SOURCE_LINE 00003141 "        ## Since there's no way I know of to enumerate open filehandles, we"
NSQ_SOURCE_LINE 00003142 "        ## autoflush STDOUT and STDERR.  This is done so that the children don't"
NSQ_SOURCE_LINE 00003143 "        ## inherit output buffers chock full o' redundant data.  It's really"
NSQ_SOURCE_LINE 00003144 "        ## confusing to track that down."
NSQ_SOURCE_LINE 00003145 "        { my $ofh = select STDOUT; my $of = $|; $| = 1; $| = $of; select $ofh; }"
NSQ_SOURCE_LINE 00003146 "        { my $ofh = select STDERR; my $of = $|; $| = 1; $| = $of; select $ofh; }"
NSQ_SOURCE_LINE 00003147 "        for my $kid ( @{ $self->{KIDS} } ) {"
NSQ_SOURCE_LINE 00003148 "            $kid->{RESULT} = undef;"
NSQ_SOURCE_LINE 00003149 "            _debug \"child: \", _debugstrings( $kid->{VAL} )"
NSQ_SOURCE_LINE 00003150 "              if _debugging_details;"
NSQ_SOURCE_LINE 00003151 "            eval {"
NSQ_SOURCE_LINE 00003152 "                if ( $self->{_simulate_fork_failure} ) {"
NSQ_SOURCE_LINE 00003153 "                    $kid->{PID} = undef;    # simulate fork() returning undef"
NSQ_SOURCE_LINE 00003154 "                    croak \"Cannot allocate memory during fork\";"
NSQ_SOURCE_LINE 00003155 "                }"
NSQ_SOURCE_LINE 00003156 "                unless (Win32_MODE) {"
NSQ_SOURCE_LINE 00003157 "                    $self->_spawn($kid);"
NSQ_SOURCE_LINE 00003158 "                }"
NSQ_SOURCE_LINE 00003159 "                else {"
NSQ_SOURCE_LINE 00003160 "## TODO: Test and debug spawning code.  Someday."
NSQ_SOURCE_LINE 00003161 "                    _debug("
NSQ_SOURCE_LINE 00003162 "                        'spawning ',"
NSQ_SOURCE_LINE 00003163 "                        _debugstrings("
NSQ_SOURCE_LINE 00003164 "                            ["
NSQ_SOURCE_LINE 00003165 "                                $kid->{PATH},"
NSQ_SOURCE_LINE 00003166 "                                @{ $kid->{VAL} }[ 1 .. $#{ $kid->{VAL} } ]"
NSQ_SOURCE_LINE 00003167 "                            ]"
NSQ_SOURCE_LINE 00003168 "                        )"
NSQ_SOURCE_LINE 00003169 "                    ) if $kid->{PATH} && _debugging;"
NSQ_SOURCE_LINE 00003170 "                    ## The external kid wouldn't know what to do with it anyway."
NSQ_SOURCE_LINE 00003171 "                    ## This is only used by the \"helper\" pump processes on Win32."
NSQ_SOURCE_LINE 00003172 "                    _dont_inherit( $self->{DEBUG_FD} );"
NSQ_SOURCE_LINE 00003173 "                    ( $kid->{PID}, $kid->{PROCESS} ) = IPC::Run::Win32Helper::win32_spawn("
NSQ_SOURCE_LINE 00003174 "                        ref( $kid->{VAL} ) eq \"ARRAY\""
NSQ_SOURCE_LINE 00003175 "                        ? [ $kid->{PATH}, @{ $kid->{VAL} }[ 1 .. $#{ $kid->{VAL} } ] ]"
NSQ_SOURCE_LINE 00003176 "                        : $kid->{VAL},"
NSQ_SOURCE_LINE 00003177 "                        $kid->{OPS},"
NSQ_SOURCE_LINE 00003178 "                    );"
NSQ_SOURCE_LINE 00003179 "                    _debug \"spawn() = \", $kid->{PID} if _debugging;"
NSQ_SOURCE_LINE 00003180 "                    if ($self->{_sleep_after_win32_spawn}) {"
NSQ_SOURCE_LINE 00003181 "                      sleep $self->{_sleep_after_win32_spawn};"
NSQ_SOURCE_LINE 00003182 "                      _debug \"after sleep $self->{_sleep_after_win32_spawn}\""
NSQ_SOURCE_LINE 00003183 "                          if _debugging;"
NSQ_SOURCE_LINE 00003184 "                    }"
NSQ_SOURCE_LINE 00003185 "                }"
NSQ_SOURCE_LINE 00003186 "            };"
NSQ_SOURCE_LINE 00003187 "            if ($@) {"
NSQ_SOURCE_LINE 00003188 "                push @errs, $@;"
NSQ_SOURCE_LINE 00003189 "                _debug 'caught ', $@ if _debugging;"
NSQ_SOURCE_LINE 00003190 "            }"
NSQ_SOURCE_LINE 00003191 "        }"
NSQ_SOURCE_LINE 00003192 "    }"
NSQ_SOURCE_LINE 00003193 ""
NSQ_SOURCE_LINE 00003194 "    ## Close all those temporary filehandles that the kids needed."
NSQ_SOURCE_LINE 00003195 "    for my $pty ( values %{ $self->{PTYS} } ) {"
NSQ_SOURCE_LINE 00003196 "        next unless $pty;"
NSQ_SOURCE_LINE 00003197 "        close $pty->slave;"
NSQ_SOURCE_LINE 00003198 "    }"
NSQ_SOURCE_LINE 00003199 ""
NSQ_SOURCE_LINE 00003200 "    my @closed;"
NSQ_SOURCE_LINE 00003201 "    for my $kid ( @{ $self->{KIDS} } ) {"
NSQ_SOURCE_LINE 00003202 "        for ( @{ $kid->{OPS} } ) {"
NSQ_SOURCE_LINE 00003203 "            my $close_it = eval {"
NSQ_SOURCE_LINE 00003204 "                     defined $_->{TFD}"
NSQ_SOURCE_LINE 00003205 "                  && !$_->{DONT_CLOSE}"
NSQ_SOURCE_LINE 00003206 "                  && !$closed[ $_->{TFD} ]"
NSQ_SOURCE_LINE 00003207 "                  && ( !Win32_MODE || !$_->{RECV_THROUGH_TEMP_FILE} )    ## Win32 hack"
NSQ_SOURCE_LINE 00003208 "            };"
NSQ_SOURCE_LINE 00003209 "            if ($@) {"
NSQ_SOURCE_LINE 00003210 "                push @errs, $@;"
NSQ_SOURCE_LINE 00003211 "                _debug 'caught ', $@ if _debugging;"
NSQ_SOURCE_LINE 00003212 "            }"
NSQ_SOURCE_LINE 00003213 "            if ( $close_it || $@ ) {"
NSQ_SOURCE_LINE 00003214 "                eval {"
NSQ_SOURCE_LINE 00003215 "                    ## GH#57: For plain '<' redirects with external Perl"
NSQ_SOURCE_LINE 00003216 "                    ## handles, use close() on the handle so it is properly"
NSQ_SOURCE_LINE 00003217 "                    ## invalidated (avoids stale-fd / double-close warnings)."
NSQ_SOURCE_LINE 00003218 "                    ## Only for TYPE '<' — for '<pipe'/'<blocking_pipe', SOURCE"
NSQ_SOURCE_LINE 00003219 "                    ## is the *write* end that the caller uses; TFD is the"
NSQ_SOURCE_LINE 00003220 "                    ## internal read end and must be closed via _close()."
NSQ_SOURCE_LINE 00003221 "                    if (   defined $_->{TYPE}"
NSQ_SOURCE_LINE 00003222 "                        && $_->{TYPE} eq '<'"
NSQ_SOURCE_LINE 00003223 "                        && ref $_->{SOURCE}"
NSQ_SOURCE_LINE 00003224 "                        && ( UNIVERSAL::isa( $_->{SOURCE}, 'GLOB' )"
NSQ_SOURCE_LINE 00003225 "                            || UNIVERSAL::isa( $_->{SOURCE}, 'IO::Handle' ) ) )"
NSQ_SOURCE_LINE 00003226 "                    {"
NSQ_SOURCE_LINE 00003227 "                        close $_->{SOURCE};"
NSQ_SOURCE_LINE 00003228 "                    }"
NSQ_SOURCE_LINE 00003229 "                    else {"
NSQ_SOURCE_LINE 00003230 "                        _close( $_->{TFD} );"
NSQ_SOURCE_LINE 00003231 "                    }"
NSQ_SOURCE_LINE 00003232 "                    $closed[ $_->{TFD} ] = 1;"
NSQ_SOURCE_LINE 00003233 "                    $_->{TFD} = undef;"
NSQ_SOURCE_LINE 00003234 "                };"
NSQ_SOURCE_LINE 00003235 "                if ($@) {"
NSQ_SOURCE_LINE 00003236 "                    push @errs, $@;"
NSQ_SOURCE_LINE 00003237 "                    _debug 'caught ', $@ if _debugging;"
NSQ_SOURCE_LINE 00003238 "                }"
NSQ_SOURCE_LINE 00003239 "            }"
NSQ_SOURCE_LINE 00003240 "        }"
NSQ_SOURCE_LINE 00003241 "    }"
NSQ_SOURCE_LINE 00003242 "    confess \"gak!\" unless defined $self->{PIPES};"
NSQ_SOURCE_LINE 00003243 ""
NSQ_SOURCE_LINE 00003244 "    if (@errs) {"
NSQ_SOURCE_LINE 00003245 "        eval { $self->_cleanup };"
NSQ_SOURCE_LINE 00003246 "        warn $@ if $@;"
NSQ_SOURCE_LINE 00003247 "        die join( '', @errs );"
NSQ_SOURCE_LINE 00003248 "    }"
NSQ_SOURCE_LINE 00003249 ""
NSQ_SOURCE_LINE 00003250 "    $self->{STATE} = _started;"
NSQ_SOURCE_LINE 00003251 "    return $self;"
NSQ_SOURCE_LINE 00003252 "}"
NSQ_SOURCE_LINE 00003253 ""
NSQ_SOURCE_LINE 00003254 "=item adopt"
NSQ_SOURCE_LINE 00003255 ""
NSQ_SOURCE_LINE 00003256 "Experimental feature. NOT FUNCTIONAL YET, NEED TO CLOSE FDS BETTER IN CHILDREN.  SEE t/adopt.t for a test suite."
NSQ_SOURCE_LINE 00003257 ""
NSQ_SOURCE_LINE 00003258 "=cut"
NSQ_SOURCE_LINE 00003259 ""
NSQ_SOURCE_LINE 00003260 "sub adopt {"
NSQ_SOURCE_LINE 00003261 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00003262 ""
NSQ_SOURCE_LINE 00003263 "    for my $adoptee (@_) {"
NSQ_SOURCE_LINE 00003264 "        push @{ $self->{IOS} }, @{ $adoptee->{IOS} };"
NSQ_SOURCE_LINE 00003265 "        ## NEED TO RENUMBER THE KIDS!!"
NSQ_SOURCE_LINE 00003266 "        push @{ $self->{KIDS} },  @{ $adoptee->{KIDS} };"
NSQ_SOURCE_LINE 00003267 "        push @{ $self->{PIPES} }, @{ $adoptee->{PIPES} };"
NSQ_SOURCE_LINE 00003268 "        $self->{PTYS}->{$_} = $adoptee->{PTYS}->{$_} for keys %{ $adoptee->{PTYS} };"
NSQ_SOURCE_LINE 00003269 "        push @{ $self->{TIMERS} }, @{ $adoptee->{TIMERS} };"
NSQ_SOURCE_LINE 00003270 "        $adoptee->{STATE} = _finished;"
NSQ_SOURCE_LINE 00003271 "    }"
NSQ_SOURCE_LINE 00003272 "}"
NSQ_SOURCE_LINE 00003273 ""
NSQ_SOURCE_LINE 00003274 "sub _clobber {"
NSQ_SOURCE_LINE 00003275 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00003276 "    my ($file) = @_;"
NSQ_SOURCE_LINE 00003277 "    _debug_desc_fd( \"closing\", $file ) if _debugging_details;"
NSQ_SOURCE_LINE 00003278 "    my $doomed = $file->{FD};"
NSQ_SOURCE_LINE 00003279 "    my $dir = $file->{TYPE} =~ /^</ ? 'WIN' : 'RIN';"
NSQ_SOURCE_LINE 00003280 "    vec( $self->{$dir}, $doomed, 1 ) = 0;"
NSQ_SOURCE_LINE 00003281 ""
NSQ_SOURCE_LINE 00003282 "    #   vec( $self->{EIN},  $doomed, 1 ) = 0;"
NSQ_SOURCE_LINE 00003283 "    vec( $self->{PIN}, $doomed, 1 ) = 0;"
NSQ_SOURCE_LINE 00003284 "    if ( $file->{TYPE} =~ /^(.)pty.$/ ) {"
NSQ_SOURCE_LINE 00003285 "        if ( $1 eq '>' ) {"
NSQ_SOURCE_LINE 00003286 "            ## Only close output ptys.  This is so that ptys as inputs are"
NSQ_SOURCE_LINE 00003287 "            ## never autoclosed, which would risk losing data that was"
NSQ_SOURCE_LINE 00003288 "            ## in the slave->parent queue."
NSQ_SOURCE_LINE 00003289 "            _debug_desc_fd \"closing pty\", $file if _debugging_details;"
NSQ_SOURCE_LINE 00003290 "            close $self->{PTYS}->{ $file->{PTY_ID} }"
NSQ_SOURCE_LINE 00003291 "              if defined $self->{PTYS}->{ $file->{PTY_ID} };"
NSQ_SOURCE_LINE 00003292 "            $self->{PTYS}->{ $file->{PTY_ID} } = undef;"
NSQ_SOURCE_LINE 00003293 "        }"
NSQ_SOURCE_LINE 00003294 "    }"
NSQ_SOURCE_LINE 00003295 "    elsif ( UNIVERSAL::isa( $file, 'IPC::Run::IO' ) ) {"
NSQ_SOURCE_LINE 00003296 "        $file->close unless $file->{DONT_CLOSE};"
NSQ_SOURCE_LINE 00003297 "    }"
NSQ_SOURCE_LINE 00003298 "    else {"
NSQ_SOURCE_LINE 00003299 "        _close($doomed);"
NSQ_SOURCE_LINE 00003300 "    }"
NSQ_SOURCE_LINE 00003301 ""
NSQ_SOURCE_LINE 00003302 "    @{ $self->{PIPES} } = grep"
NSQ_SOURCE_LINE 00003303 "      defined $_->{FD} && ( $_->{TYPE} ne $file->{TYPE} || $_->{FD} ne $doomed ),"
NSQ_SOURCE_LINE 00003304 "      @{ $self->{PIPES} };"
NSQ_SOURCE_LINE 00003305 ""
NSQ_SOURCE_LINE 00003306 "    $file->{FD} = undef;"
NSQ_SOURCE_LINE 00003307 "}"
NSQ_SOURCE_LINE 00003308 ""
NSQ_SOURCE_LINE 00003309 "sub _select_loop {"
NSQ_SOURCE_LINE 00003310 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00003311 ""
NSQ_SOURCE_LINE 00003312 "    # With !defined $SIG{CHLD} (the default), Perl restarts any select() that"
NSQ_SOURCE_LINE 00003313 "    # SIGCHLD interrupts.  Install a no-op handler, to make select() terminate"
NSQ_SOURCE_LINE 00003314 "    # with EINTR, accelerating our reaction.  This doesn't help if SIGCHLD"
NSQ_SOURCE_LINE 00003315 "    # arrives just before the select() call; https://cr.yp.to/docs/selfpipe.html"
NSQ_SOURCE_LINE 00003316 "    # is a way to close that race condition.  It doesn't help on Windows, where"
NSQ_SOURCE_LINE 00003317 "    # we substitute a low timeout in zero-FD (timeout-only) select().  That"
NSQ_SOURCE_LINE 00003318 "    # spends CPU to achieve responsiveness.  We could do better there with a"
NSQ_SOURCE_LINE 00003319 "    # C-language module that calls OpenProcess(), WSAEventSelect(), and"
NSQ_SOURCE_LINE 00003320 "    # WaitForMultipleObjects()."
NSQ_SOURCE_LINE 00003321 "    #"
NSQ_SOURCE_LINE 00003322 "    # If non-IPC::Run code has installed a handler, via $SIG{CHLD} assignment or"
NSQ_SOURCE_LINE 00003323 "    # via POSIX::sigaction(), this statement takes no action, and the existing"
NSQ_SOURCE_LINE 00003324 "    # handler helps just like this one would.  The cap on $not_forever helps"
NSQ_SOURCE_LINE 00003325 "    # when non-IPC::Run code has blocked SIGCHLD, e.g. via POSIX::sigprocmask()."
NSQ_SOURCE_LINE 00003326 "    # Override undef, '' and 'DEFAULT' — all of which leave the default"
NSQ_SOURCE_LINE 00003327 "    # disposition in effect and would cause Perl to restart select()."
NSQ_SOURCE_LINE 00003328 "    local $SIG{CHLD} = sub { }"
NSQ_SOURCE_LINE 00003329 "      unless $SIG{CHLD} && $SIG{CHLD} ne 'DEFAULT';"
NSQ_SOURCE_LINE 00003330 ""
NSQ_SOURCE_LINE 00003331 "    # When a child exits before consuming all of its stdin, any subsequent"
NSQ_SOURCE_LINE 00003332 "    # write to the pipe raises SIGPIPE.  With the default disposition that"
NSQ_SOURCE_LINE 00003333 "    # kills the parent.  Ignore SIGPIPE here so that POSIX::write() instead"
NSQ_SOURCE_LINE 00003334 "    # returns -1 with errno EPIPE, which pipe_writer catches and handles by"
NSQ_SOURCE_LINE 00003335 "    # closing the pipe gracefully.  Honour an existing *custom* handler"
NSQ_SOURCE_LINE 00003336 "    # installed by the caller, but override undef, '' and 'DEFAULT' — all"
NSQ_SOURCE_LINE 00003337 "    # of which leave the default (fatal) disposition in effect."
NSQ_SOURCE_LINE 00003338 "    local $SIG{PIPE} = 'IGNORE'"
NSQ_SOURCE_LINE 00003339 "      unless $SIG{PIPE} && $SIG{PIPE} ne 'DEFAULT';"
NSQ_SOURCE_LINE 00003340 ""
NSQ_SOURCE_LINE 00003341 "    my $io_occurred;"
NSQ_SOURCE_LINE 00003342 ""
NSQ_SOURCE_LINE 00003343 "    my $min_select_timeout = 0.01;"
NSQ_SOURCE_LINE 00003344 "    my $not_forever        = $min_select_timeout;"
NSQ_SOURCE_LINE 00003345 ""
NSQ_SOURCE_LINE 00003346 "  SELECT:"
NSQ_SOURCE_LINE 00003347 "    while ( $self->pumpable ) {"
NSQ_SOURCE_LINE 00003348 "        if ( $io_occurred && $self->{break_on_io} ) {"
NSQ_SOURCE_LINE 00003349 "            _debug \"exiting _select(): io occurred and break_on_io set\""
NSQ_SOURCE_LINE 00003350 "              if _debugging_details;"
NSQ_SOURCE_LINE 00003351 "            last;"
NSQ_SOURCE_LINE 00003352 "        }"
NSQ_SOURCE_LINE 00003353 ""
NSQ_SOURCE_LINE 00003354 "        my $timeout = $self->{non_blocking} ? 0 : undef;"
NSQ_SOURCE_LINE 00003355 ""
NSQ_SOURCE_LINE 00003356 "        if ( @{ $self->{TIMERS} } ) {"
NSQ_SOURCE_LINE 00003357 "            my $now = time;"
NSQ_SOURCE_LINE 00003358 "            my $time_left;"
NSQ_SOURCE_LINE 00003359 "            for ( @{ $self->{TIMERS} } ) {"
NSQ_SOURCE_LINE 00003360 "                next unless $_->is_running;"
NSQ_SOURCE_LINE 00003361 "                $time_left = $_->check($now);"
NSQ_SOURCE_LINE 00003362 "                ## Return when a timer expires"
NSQ_SOURCE_LINE 00003363 "                return if defined $time_left && !$time_left;"
NSQ_SOURCE_LINE 00003364 "                $timeout = $time_left"
NSQ_SOURCE_LINE 00003365 "                  if !defined $timeout || $time_left < $timeout;"
NSQ_SOURCE_LINE 00003366 "            }"
NSQ_SOURCE_LINE 00003367 "        }"
NSQ_SOURCE_LINE 00003368 ""
NSQ_SOURCE_LINE 00003369 "        ##"
NSQ_SOURCE_LINE 00003370 "        ## See if we can unpause any input channels"
NSQ_SOURCE_LINE 00003371 "        ##"
NSQ_SOURCE_LINE 00003372 "        my $paused = 0;"
NSQ_SOURCE_LINE 00003373 ""
NSQ_SOURCE_LINE 00003374 "        for my $file ( @{ $self->{PIPES} } ) {"
NSQ_SOURCE_LINE 00003375 "            next unless $file->{PAUSED} && $file->{TYPE} =~ /^</;"
NSQ_SOURCE_LINE 00003376 ""
NSQ_SOURCE_LINE 00003377 "            _debug_desc_fd( \"checking for more input\", $file ) if _debugging_details;"
NSQ_SOURCE_LINE 00003378 "            my $did;"
NSQ_SOURCE_LINE 00003379 "            1 while $did = $file->_do_filters($self);"
NSQ_SOURCE_LINE 00003380 "            if ( defined $file->{FD} && !defined($did) || $did ) {"
NSQ_SOURCE_LINE 00003381 "                _debug_desc_fd( \"unpausing\", $file ) if _debugging_details;"
NSQ_SOURCE_LINE 00003382 "                $file->{PAUSED} = 0;"
NSQ_SOURCE_LINE 00003383 "                vec( $self->{WIN}, $file->{FD}, 1 ) = 1;"
NSQ_SOURCE_LINE 00003384 ""
NSQ_SOURCE_LINE 00003385 "                #\t    vec( $self->{EIN}, $file->{FD}, 1 ) = 1;"
NSQ_SOURCE_LINE 00003386 "                vec( $self->{PIN}, $file->{FD}, 1 ) = 0;"
NSQ_SOURCE_LINE 00003387 "            }"
NSQ_SOURCE_LINE 00003388 "            else {"
NSQ_SOURCE_LINE 00003389 "                ## This gets incremented occasionally when the IO channel"
NSQ_SOURCE_LINE 00003390 "                ## was actually closed.  That's a bug, but it seems mostly"
NSQ_SOURCE_LINE 00003391 "                ## harmless: it causes us to exit if break_on_io, or to set"
NSQ_SOURCE_LINE 00003392 "                ## the timeout to not be forever.  I need to fix it, though."
NSQ_SOURCE_LINE 00003393 "                ++$paused;"
NSQ_SOURCE_LINE 00003394 "            }"
NSQ_SOURCE_LINE 00003395 "        }"
NSQ_SOURCE_LINE 00003396 ""
NSQ_SOURCE_LINE 00003397 "        if (_debugging_details) {"
NSQ_SOURCE_LINE 00003398 "            my $map = join("
NSQ_SOURCE_LINE 00003399 "                '',"
NSQ_SOURCE_LINE 00003400 "                map {"
NSQ_SOURCE_LINE 00003401 "                    my $out;"
NSQ_SOURCE_LINE 00003402 "                    $out = 'r' if vec( $self->{RIN}, $_, 1 );"
NSQ_SOURCE_LINE 00003403 "                    $out = $out ? 'b' : 'w' if vec( $self->{WIN}, $_, 1 );"
NSQ_SOURCE_LINE 00003404 "                    $out = 'p' if !$out && vec( $self->{PIN}, $_, 1 );"
NSQ_SOURCE_LINE 00003405 "                    $out = $out ? uc($out) : 'x' if vec( $self->{EIN}, $_, 1 );"
NSQ_SOURCE_LINE 00003406 "                    $out = '-' unless $out;"
NSQ_SOURCE_LINE 00003407 "                    $out;"
NSQ_SOURCE_LINE 00003408 "                } ( 0 .. 1024 )"
NSQ_SOURCE_LINE 00003409 "            );"
NSQ_SOURCE_LINE 00003410 "            $map =~ s/((?:[a-zA-Z-]|\\([^\\)]*\\)){12,}?)-*$/$1/;"
NSQ_SOURCE_LINE 00003411 "            _debug 'fds for select: ', $map if _debugging_details;"
NSQ_SOURCE_LINE 00003412 "        }"
NSQ_SOURCE_LINE 00003413 ""
NSQ_SOURCE_LINE 00003414 "        ## _do_filters may have closed our last fd, and we need to see if"
NSQ_SOURCE_LINE 00003415 "        ## we have I/O, or are just waiting for children to exit."
NSQ_SOURCE_LINE 00003416 "        my $p = $self->pumpable;"
NSQ_SOURCE_LINE 00003417 "        last unless $p;"
NSQ_SOURCE_LINE 00003418 "        if ( $p != 0 && ( !defined $timeout || $timeout > 0.1 ) ) {"
NSQ_SOURCE_LINE 00003419 "            ## No I/O will wake the select loop up, but we have children"
NSQ_SOURCE_LINE 00003420 "            ## lingering, so we need to poll them with a short timeout."
NSQ_SOURCE_LINE 00003421 "            ## Otherwise, assume more input will be coming."
NSQ_SOURCE_LINE 00003422 ""
NSQ_SOURCE_LINE 00003423 "            if ( !Win32_MODE || $self->{RIN} || $self->{WIN} || $self->{EIN} ) {"
NSQ_SOURCE_LINE 00003424 "                $timeout = $not_forever;"
NSQ_SOURCE_LINE 00003425 "                $not_forever *= 2;"
NSQ_SOURCE_LINE 00003426 "                $not_forever = 0.5 if $not_forever >= 0.5;"
NSQ_SOURCE_LINE 00003427 "            }"
NSQ_SOURCE_LINE 00003428 "            else {"
NSQ_SOURCE_LINE 00003429 "                # see above rationale for Windows-specific behavior"
NSQ_SOURCE_LINE 00003430 "                $timeout = $min_select_timeout;"
NSQ_SOURCE_LINE 00003431 "            }"
NSQ_SOURCE_LINE 00003432 "        }"
NSQ_SOURCE_LINE 00003433 ""
NSQ_SOURCE_LINE 00003434 "        ## Make sure we don't block forever in select() because inputs are"
NSQ_SOURCE_LINE 00003435 "        ## paused."
NSQ_SOURCE_LINE 00003436 "        if ( !defined $timeout && !( @{ $self->{PIPES} } - $paused ) ) {"
NSQ_SOURCE_LINE 00003437 "            ## Need to return if we're in pump and all input is paused, or"
NSQ_SOURCE_LINE 00003438 "            ## we'll loop until all inputs are unpaused, which is darn near"
NSQ_SOURCE_LINE 00003439 "            ## forever.  And a day."
NSQ_SOURCE_LINE 00003440 "            if ( $self->{break_on_io} ) {"
NSQ_SOURCE_LINE 00003441 "                _debug \"exiting _select(): no I/O to do and timeout=forever\""
NSQ_SOURCE_LINE 00003442 "                  if _debugging;"
NSQ_SOURCE_LINE 00003443 "                last;"
NSQ_SOURCE_LINE 00003444 "            }"
NSQ_SOURCE_LINE 00003445 ""
NSQ_SOURCE_LINE 00003446 "            ## Otherwise, assume more input will be coming."
NSQ_SOURCE_LINE 00003447 "            if ( !Win32_MODE || $self->{RIN} || $self->{WIN} || $self->{EIN} ) {"
NSQ_SOURCE_LINE 00003448 "                $timeout = $not_forever;"
NSQ_SOURCE_LINE 00003449 "                $not_forever *= 2;"
NSQ_SOURCE_LINE 00003450 "                $not_forever = 0.5 if $not_forever >= 0.5;"
NSQ_SOURCE_LINE 00003451 "            }"
NSQ_SOURCE_LINE 00003452 "            else {"
NSQ_SOURCE_LINE 00003453 "                $timeout = $min_select_timeout;"
NSQ_SOURCE_LINE 00003454 "            }"
NSQ_SOURCE_LINE 00003455 "        }"
NSQ_SOURCE_LINE 00003456 ""
NSQ_SOURCE_LINE 00003457 "        _debug 'timeout=', defined $timeout ? $timeout : 'forever'"
NSQ_SOURCE_LINE 00003458 "          if _debugging_details;"
NSQ_SOURCE_LINE 00003459 ""
NSQ_SOURCE_LINE 00003460 "        my $nfound;"
NSQ_SOURCE_LINE 00003461 "        unless (Win32_MODE) {"
NSQ_SOURCE_LINE 00003462 "            $nfound = select("
NSQ_SOURCE_LINE 00003463 "                $self->{ROUT} = $self->{RIN},"
NSQ_SOURCE_LINE 00003464 "                $self->{WOUT} = $self->{WIN},"
NSQ_SOURCE_LINE 00003465 "                $self->{EOUT} = $self->{EIN},"
NSQ_SOURCE_LINE 00003466 "                $timeout"
NSQ_SOURCE_LINE 00003467 "            );"
NSQ_SOURCE_LINE 00003468 "        }"
NSQ_SOURCE_LINE 00003469 "        else {"
NSQ_SOURCE_LINE 00003470 "            my @in = map $self->{$_}, qw( RIN WIN EIN );"
NSQ_SOURCE_LINE 00003471 "            ## Win32's select() on Win32 seems to die if passed vectors of"
NSQ_SOURCE_LINE 00003472 "            ## all 0's.  Need to report this when I get back online."
NSQ_SOURCE_LINE 00003473 "            for (@in) {"
NSQ_SOURCE_LINE 00003474 "                $_ = undef unless index( ( unpack \"b*\", $_ ), 1 ) >= 0;"
NSQ_SOURCE_LINE 00003475 "            }"
NSQ_SOURCE_LINE 00003476 ""
NSQ_SOURCE_LINE 00003477 "            $nfound = select("
NSQ_SOURCE_LINE 00003478 "                $self->{ROUT} = $in[0],"
NSQ_SOURCE_LINE 00003479 "                $self->{WOUT} = $in[1],"
NSQ_SOURCE_LINE 00003480 "                $self->{EOUT} = $in[2],"
NSQ_SOURCE_LINE 00003481 "                $timeout"
NSQ_SOURCE_LINE 00003482 "            );"
NSQ_SOURCE_LINE 00003483 ""
NSQ_SOURCE_LINE 00003484 "            for ( $self->{ROUT}, $self->{WOUT}, $self->{EOUT} ) {"
NSQ_SOURCE_LINE 00003485 "                $_ = \"\" unless defined $_;"
NSQ_SOURCE_LINE 00003486 "            }"
NSQ_SOURCE_LINE 00003487 "        }"
NSQ_SOURCE_LINE 00003488 "        last if !$nfound && $self->{non_blocking};"
NSQ_SOURCE_LINE 00003489 ""
NSQ_SOURCE_LINE 00003490 "        if ( $nfound < 0 ) {"
NSQ_SOURCE_LINE 00003491 "            if ( $!{EINTR} ) {"
NSQ_SOURCE_LINE 00003492 ""
NSQ_SOURCE_LINE 00003493 "                # Caught a signal before any FD went ready.  Ensure that"
NSQ_SOURCE_LINE 00003494 "                # the bit fields reflect \"no FDs ready\"."
NSQ_SOURCE_LINE 00003495 "                $self->{ROUT} = $self->{WOUT} = $self->{EOUT} = '';"
NSQ_SOURCE_LINE 00003496 "                $nfound = 0;"
NSQ_SOURCE_LINE 00003497 "            }"
NSQ_SOURCE_LINE 00003498 "            else {"
NSQ_SOURCE_LINE 00003499 "                croak \"$! in select\";"
NSQ_SOURCE_LINE 00003500 "            }"
NSQ_SOURCE_LINE 00003501 "        }"
NSQ_SOURCE_LINE 00003502 "        ## TODO: Analyze the EINTR failure mode and see if this patch"
NSQ_SOURCE_LINE 00003503 "        ## is adequate and optimal."
NSQ_SOURCE_LINE 00003504 "        ## TODO: Add an EINTR test to the test suite."
NSQ_SOURCE_LINE 00003505 ""
NSQ_SOURCE_LINE 00003506 "        if (_debugging_details) {"
NSQ_SOURCE_LINE 00003507 "            my $map = join("
NSQ_SOURCE_LINE 00003508 "                '',"
NSQ_SOURCE_LINE 00003509 "                map {"
NSQ_SOURCE_LINE 00003510 "                    my $out;"
NSQ_SOURCE_LINE 00003511 "                    $out = 'r' if vec( $self->{ROUT}, $_, 1 );"
NSQ_SOURCE_LINE 00003512 "                    $out = $out ? 'b'      : 'w' if vec( $self->{WOUT}, $_, 1 );"
NSQ_SOURCE_LINE 00003513 "                    $out = $out ? uc($out) : 'x' if vec( $self->{EOUT}, $_, 1 );"
NSQ_SOURCE_LINE 00003514 "                    $out = '-' unless $out;"
NSQ_SOURCE_LINE 00003515 "                    $out;"
NSQ_SOURCE_LINE 00003516 "                } ( 0 .. 128 )"
NSQ_SOURCE_LINE 00003517 "            );"
NSQ_SOURCE_LINE 00003518 "            $map =~ s/((?:[a-zA-Z-]|\\([^\\)]*\\)){12,}?)-*$/$1/;"
NSQ_SOURCE_LINE 00003519 "            _debug \"selected  \", $map;"
NSQ_SOURCE_LINE 00003520 "        }"
NSQ_SOURCE_LINE 00003521 ""
NSQ_SOURCE_LINE 00003522 "        ## Need to copy since _clobber alters @{$self->{PIPES}}."
NSQ_SOURCE_LINE 00003523 "        ## TODO: Rethink _clobber().  Rethink $file->{PAUSED}, too."
NSQ_SOURCE_LINE 00003524 "        my @pipes = @{ $self->{PIPES} };"
NSQ_SOURCE_LINE 00003525 "        $io_occurred = $_->poll($self) ? 1 : $io_occurred for @pipes;"
NSQ_SOURCE_LINE 00003526 ""
NSQ_SOURCE_LINE 00003527 "    }"
NSQ_SOURCE_LINE 00003528 ""
NSQ_SOURCE_LINE 00003529 "    return;"
NSQ_SOURCE_LINE 00003530 "}"
NSQ_SOURCE_LINE 00003531 ""
NSQ_SOURCE_LINE 00003532 "sub _cleanup {"
NSQ_SOURCE_LINE 00003533 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00003534 "    _debug \"cleaning up\" if _debugging_details;"
NSQ_SOURCE_LINE 00003535 ""
NSQ_SOURCE_LINE 00003536 "    for ( values %{ $self->{PTYS} } ) {"
NSQ_SOURCE_LINE 00003537 "        next unless ref $_;"
NSQ_SOURCE_LINE 00003538 "        eval {"
NSQ_SOURCE_LINE 00003539 "            _debug \"closing slave fd \", fileno $_->slave if _debugging_data;"
NSQ_SOURCE_LINE 00003540 "            close $_->slave;"
NSQ_SOURCE_LINE 00003541 "        };"
NSQ_SOURCE_LINE 00003542 "        carp $@ . \" while closing ptys\" if $@;"
NSQ_SOURCE_LINE 00003543 "        eval {"
NSQ_SOURCE_LINE 00003544 "            _debug \"closing master fd \", fileno $_ if _debugging_data;"
NSQ_SOURCE_LINE 00003545 "            close $_;"
NSQ_SOURCE_LINE 00003546 "        };"
NSQ_SOURCE_LINE 00003547 "        carp $@ . \" closing ptys\" if $@;"
NSQ_SOURCE_LINE 00003548 "    }"
NSQ_SOURCE_LINE 00003549 ""
NSQ_SOURCE_LINE 00003550 "    _debug \"cleaning up pipes\" if _debugging_details;"
NSQ_SOURCE_LINE 00003551 "    ## _clobber modifies PIPES"
NSQ_SOURCE_LINE 00003552 "    $self->_clobber( $self->{PIPES}->[0] ) while @{ $self->{PIPES} };"
NSQ_SOURCE_LINE 00003553 ""
NSQ_SOURCE_LINE 00003554 "    # reap kids"
NSQ_SOURCE_LINE 00003555 "    my @coderef_exceptions;"
NSQ_SOURCE_LINE 00003556 "    for my $kid ( @{ $self->{KIDS} } ) {"
NSQ_SOURCE_LINE 00003557 "        if ( !defined $kid->{PID} || !length $kid->{PID} ) {"
NSQ_SOURCE_LINE 00003558 "            _debug 'never ran child ', $kid->{NUM}, \", can't reap\""
NSQ_SOURCE_LINE 00003559 "              if _debugging;"
NSQ_SOURCE_LINE 00003560 "            for my $op ( @{ $kid->{OPS} } ) {"
NSQ_SOURCE_LINE 00003561 "                _close( $op->{TFD} )"
NSQ_SOURCE_LINE 00003562 "                  if defined $op->{TFD} && !defined $op->{TEMP_FILE_HANDLE};"
NSQ_SOURCE_LINE 00003563 "            }"
NSQ_SOURCE_LINE 00003564 "        }"
NSQ_SOURCE_LINE 00003565 "        else {"
NSQ_SOURCE_LINE 00003566 "            _waitpid( $kid, 0 );"
NSQ_SOURCE_LINE 00003567 "        }"
NSQ_SOURCE_LINE 00003568 ""
NSQ_SOURCE_LINE 00003569 "        ## GH#122: Read exception from CODE ref error pipe after the child"
NSQ_SOURCE_LINE 00003570 "        ## has exited.  The pipe is guaranteed to have been closed by the"
NSQ_SOURCE_LINE 00003571 "        ## child's POSIX::_exit(), so _read() will not block."
NSQ_SOURCE_LINE 00003572 "        if ( defined $kid->{CODEREF_ERR_FD} ) {"
NSQ_SOURCE_LINE 00003573 "            my $err = _read $kid->{CODEREF_ERR_FD};"
NSQ_SOURCE_LINE 00003574 "            POSIX::close $kid->{CODEREF_ERR_FD};"
NSQ_SOURCE_LINE 00003575 "            delete $kid->{CODEREF_ERR_FD};"
NSQ_SOURCE_LINE 00003576 "            push @coderef_exceptions, $err if defined $err && length $err;"
NSQ_SOURCE_LINE 00003577 "        }"
NSQ_SOURCE_LINE 00003578 "    }"
NSQ_SOURCE_LINE 00003579 "    $self->{CODEREF_EXCEPTIONS} = \\@coderef_exceptions if @coderef_exceptions;"
NSQ_SOURCE_LINE 00003580 ""
NSQ_SOURCE_LINE 00003581 "    # OPS cleanup.  Kids may share an OPS object; search for \"also to write\"."
NSQ_SOURCE_LINE 00003582 "    # Example harness: run(['echo',1], '&', ['echo',2], '>', \\$out).  Hence,"
NSQ_SOURCE_LINE 00003583 "    # this starts after the last reap."
NSQ_SOURCE_LINE 00003584 "    for my $kid ( @{ $self->{KIDS} } ) {"
NSQ_SOURCE_LINE 00003585 ""
NSQ_SOURCE_LINE 00003586 "        _debug \"cleaning up filters at kid \", $kid->{NUM} if _debugging_details;"
NSQ_SOURCE_LINE 00003587 "        for my $op ( @{ $kid->{OPS} } ) {"
NSQ_SOURCE_LINE 00003588 "            @{ $op->{FILTERS} } = grep {"
NSQ_SOURCE_LINE 00003589 "                my $filter = $_;"
NSQ_SOURCE_LINE 00003590 "                !grep $filter == $_, @{ $self->{TEMP_FILTERS} };"
NSQ_SOURCE_LINE 00003591 "            } @{ $op->{FILTERS} };"
NSQ_SOURCE_LINE 00003592 "        }"
NSQ_SOURCE_LINE 00003593 ""
NSQ_SOURCE_LINE 00003594 "        for my $op ( @{ $kid->{OPS} } ) {"
NSQ_SOURCE_LINE 00003595 "            $op->_cleanup($self) if UNIVERSAL::isa( $op, \"IPC::Run::IO\" );"
NSQ_SOURCE_LINE 00003596 "        }"
NSQ_SOURCE_LINE 00003597 "    }"
NSQ_SOURCE_LINE 00003598 "    $self->{STATE} = _finished;"
NSQ_SOURCE_LINE 00003599 "    @{ $self->{TEMP_FILTERS} } = ();"
NSQ_SOURCE_LINE 00003600 "    _debug \"done cleaning up\" if _debugging_details;"
NSQ_SOURCE_LINE 00003601 ""
NSQ_SOURCE_LINE 00003602 "    POSIX::close $self->{DEBUG_FD} if defined $self->{DEBUG_FD};"
NSQ_SOURCE_LINE 00003603 "    $self->{DEBUG_FD} = undef;"
NSQ_SOURCE_LINE 00003604 "}"
NSQ_SOURCE_LINE 00003605 ""
NSQ_SOURCE_LINE 00003606 "=pod"
NSQ_SOURCE_LINE 00003607 ""
NSQ_SOURCE_LINE 00003608 "=item pump"
NSQ_SOURCE_LINE 00003609 ""
NSQ_SOURCE_LINE 00003610 "   pump $h;"
NSQ_SOURCE_LINE 00003611 "   $h->pump;"
NSQ_SOURCE_LINE 00003612 ""
NSQ_SOURCE_LINE 00003613 "Pump accepts a single parameter harness.  It blocks until it delivers some"
NSQ_SOURCE_LINE 00003614 "input or receives some output.  It returns TRUE if there is still input or"
NSQ_SOURCE_LINE 00003615 "output to be done, FALSE otherwise."
NSQ_SOURCE_LINE 00003616 ""
NSQ_SOURCE_LINE 00003617 "pump() will automatically call start() if need be, so you may call harness()"
NSQ_SOURCE_LINE 00003618 "then proceed to pump() if that helps you structure your application."
NSQ_SOURCE_LINE 00003619 ""
NSQ_SOURCE_LINE 00003620 "If pump() is called after all harnessed activities have completed, a \"process"
NSQ_SOURCE_LINE 00003621 "ended prematurely\" exception to be thrown.  This allows for simple scripting"
NSQ_SOURCE_LINE 00003622 "of external applications without having to add lots of error handling code at"
NSQ_SOURCE_LINE 00003623 "each step of the script:"
NSQ_SOURCE_LINE 00003624 ""
NSQ_SOURCE_LINE 00003625 "   $h = harness \\@smbclient, \\$in, \\$out, $err;"
NSQ_SOURCE_LINE 00003626 ""
NSQ_SOURCE_LINE 00003627 "   $in = \"cd /foo\\n\";"
NSQ_SOURCE_LINE 00003628 "   $h->pump until $out =~ /^smb.*> \\Z/m;"
NSQ_SOURCE_LINE 00003629 "   die \"error cding to /foo:\\n$out\" if $out =~ \"ERR\";"
NSQ_SOURCE_LINE 00003630 "   $out = '';"
NSQ_SOURCE_LINE 00003631 ""
NSQ_SOURCE_LINE 00003632 "   $in = \"mget *\\n\";"
NSQ_SOURCE_LINE 00003633 "   $h->pump until $out =~ /^smb.*> \\Z/m;"
NSQ_SOURCE_LINE 00003634 "   die \"error retrieving files:\\n$out\" if $out =~ \"ERR\";"
NSQ_SOURCE_LINE 00003635 ""
NSQ_SOURCE_LINE 00003636 "   $h->finish;"
NSQ_SOURCE_LINE 00003637 ""
NSQ_SOURCE_LINE 00003638 "   warn $err if $err;"
NSQ_SOURCE_LINE 00003639 ""
NSQ_SOURCE_LINE 00003640 "=cut"
NSQ_SOURCE_LINE 00003641 ""
NSQ_SOURCE_LINE 00003642 "sub pump {"
NSQ_SOURCE_LINE 00003643 "    die \"pump() takes only a single harness as a parameter\""
NSQ_SOURCE_LINE 00003644 "      unless @_ == 1 && UNIVERSAL::isa( $_[0], __PACKAGE__ );"
NSQ_SOURCE_LINE 00003645 ""
NSQ_SOURCE_LINE 00003646 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00003647 ""
NSQ_SOURCE_LINE 00003648 "    local $cur_self = $self;"
NSQ_SOURCE_LINE 00003649 ""
NSQ_SOURCE_LINE 00003650 "    _debug \"** pumping\""
NSQ_SOURCE_LINE 00003651 "      if _debugging;"
NSQ_SOURCE_LINE 00003652 ""
NSQ_SOURCE_LINE 00003653 "    $self->start if $self->{STATE} < _started;"
NSQ_SOURCE_LINE 00003654 "    croak \"process ended prematurely\" unless $self->pumpable;"
NSQ_SOURCE_LINE 00003655 ""
NSQ_SOURCE_LINE 00003656 "    $self->{auto_close_ins} = 0;"
NSQ_SOURCE_LINE 00003657 "    $self->{break_on_io}    = 1;"
NSQ_SOURCE_LINE 00003658 "    $self->_select_loop;"
NSQ_SOURCE_LINE 00003659 "    return $self->pumpable;"
NSQ_SOURCE_LINE 00003660 "}"
NSQ_SOURCE_LINE 00003661 ""
NSQ_SOURCE_LINE 00003662 "=pod"
NSQ_SOURCE_LINE 00003663 ""
NSQ_SOURCE_LINE 00003664 "=item pump_nb"
NSQ_SOURCE_LINE 00003665 ""
NSQ_SOURCE_LINE 00003666 "   pump_nb $h;"
NSQ_SOURCE_LINE 00003667 "   $h->pump_nb;"
NSQ_SOURCE_LINE 00003668 ""
NSQ_SOURCE_LINE 00003669 "\"pump() non-blocking\", pumps if anything's ready to be pumped, returns"
NSQ_SOURCE_LINE 00003670 "immediately otherwise.  This is useful if you're doing some long-running"
NSQ_SOURCE_LINE 00003671 "task in the foreground, but don't want to starve any child processes."
NSQ_SOURCE_LINE 00003672 ""
NSQ_SOURCE_LINE 00003673 "=cut"
NSQ_SOURCE_LINE 00003674 ""
NSQ_SOURCE_LINE 00003675 "sub pump_nb {"
NSQ_SOURCE_LINE 00003676 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00003677 ""
NSQ_SOURCE_LINE 00003678 "    $self->{non_blocking} = 1;"
NSQ_SOURCE_LINE 00003679 "    my $r = eval { $self->pump };"
NSQ_SOURCE_LINE 00003680 "    $self->{non_blocking} = 0;"
NSQ_SOURCE_LINE 00003681 "    die $@ if $@;"
NSQ_SOURCE_LINE 00003682 "    return $r;"
NSQ_SOURCE_LINE 00003683 "}"
NSQ_SOURCE_LINE 00003684 ""
NSQ_SOURCE_LINE 00003685 "=pod"
NSQ_SOURCE_LINE 00003686 ""
NSQ_SOURCE_LINE 00003687 "=item close_stdin"
NSQ_SOURCE_LINE 00003688 ""
NSQ_SOURCE_LINE 00003689 "   $h->close_stdin;"
NSQ_SOURCE_LINE 00003690 ""
NSQ_SOURCE_LINE 00003691 "Closes the input pipe(s) to the child process(es), signaling EOF on"
NSQ_SOURCE_LINE 00003692 "the child's STDIN.  Does B<not> wait for the child to finish or drain"
NSQ_SOURCE_LINE 00003693 "remaining output.  After calling this, the caller can continue to"
NSQ_SOURCE_LINE 00003694 "C<pump()> to retrieve output incrementally."
NSQ_SOURCE_LINE 00003695 ""
NSQ_SOURCE_LINE 00003696 "This is useful when streaming large amounts of data through a child"
NSQ_SOURCE_LINE 00003697 "process (e.g., decompression) where you want to signal end-of-input"
NSQ_SOURCE_LINE 00003698 "but continue draining output without buffering it all in memory:"
NSQ_SOURCE_LINE 00003699 ""
NSQ_SOURCE_LINE 00003700 "   my ( $in, $out ) = ( '', '' );"
NSQ_SOURCE_LINE 00003701 "   my $h = start \\@cmd, \\$in, \\$out, timeout( 30 );"
NSQ_SOURCE_LINE 00003702 ""
NSQ_SOURCE_LINE 00003703 "   while ( read_more_input_into( $in ) ) {"
NSQ_SOURCE_LINE 00003704 "       $h->pump;"
NSQ_SOURCE_LINE 00003705 "       process_output( $out ) if length $out;"
NSQ_SOURCE_LINE 00003706 "       $out = '';"
NSQ_SOURCE_LINE 00003707 "   }"
NSQ_SOURCE_LINE 00003708 ""
NSQ_SOURCE_LINE 00003709 "   $h->close_stdin;"
NSQ_SOURCE_LINE 00003710 ""
NSQ_SOURCE_LINE 00003711 "   while ( $h->pumpable ) {"
NSQ_SOURCE_LINE 00003712 "       $h->pump;"
NSQ_SOURCE_LINE 00003713 "       process_output( $out ) if length $out;"
NSQ_SOURCE_LINE 00003714 "       $out = '';"
NSQ_SOURCE_LINE 00003715 "   }"
NSQ_SOURCE_LINE 00003716 ""
NSQ_SOURCE_LINE 00003717 "   $h->finish;"
NSQ_SOURCE_LINE 00003718 ""
NSQ_SOURCE_LINE 00003719 "B<Note:> Always use a C<timeout()> with this pattern.  Without one, the"
NSQ_SOURCE_LINE 00003720 "C<pump()> calls can deadlock if the child blocks on writing output while"
NSQ_SOURCE_LINE 00003721 "you are blocked trying to write input (or vice versa)."
NSQ_SOURCE_LINE 00003722 ""
NSQ_SOURCE_LINE 00003723 "Without C<close_stdin()>, calling C<finish()> would accumulate all"
NSQ_SOURCE_LINE 00003724 "remaining output in C<$out> before returning, potentially exhausting"
NSQ_SOURCE_LINE 00003725 "memory for children that produce large output (like decompressors)."
NSQ_SOURCE_LINE 00003726 ""
NSQ_SOURCE_LINE 00003727 "Returns the harness object for chaining."
NSQ_SOURCE_LINE 00003728 ""
NSQ_SOURCE_LINE 00003729 "=cut"
NSQ_SOURCE_LINE 00003730 ""
NSQ_SOURCE_LINE 00003731 "sub close_stdin {"
NSQ_SOURCE_LINE 00003732 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00003733 ""
NSQ_SOURCE_LINE 00003734 "    local $cur_self = $self;"
NSQ_SOURCE_LINE 00003735 ""
NSQ_SOURCE_LINE 00003736 "    croak \"harness has not been started\" unless $self->{STATE} >= _started;"
NSQ_SOURCE_LINE 00003737 ""
NSQ_SOURCE_LINE 00003738 "    _debug \"** closing stdin\" if _debugging;"
NSQ_SOURCE_LINE 00003739 ""
NSQ_SOURCE_LINE 00003740 "    # Match all input pipe types: '<' (plain), '<pipe', '<pty<', etc."
NSQ_SOURCE_LINE 00003741 "    # _clobber() handles each type appropriately: for regular pipes it"
NSQ_SOURCE_LINE 00003742 "    # closes the fd (signaling EOF to the child); for input ptys it"
NSQ_SOURCE_LINE 00003743 "    # removes them from the select vectors without closing the pty"
NSQ_SOURCE_LINE 00003744 "    # master (consistent with _clobber's existing pty safety logic)."
NSQ_SOURCE_LINE 00003745 "    for my $pipe ( @{ $self->{PIPES} } ) {"
NSQ_SOURCE_LINE 00003746 "        next unless $pipe->{TYPE} =~ /^</;"
NSQ_SOURCE_LINE 00003747 "        $self->_clobber($pipe);"
NSQ_SOURCE_LINE 00003748 "    }"
NSQ_SOURCE_LINE 00003749 ""
NSQ_SOURCE_LINE 00003750 "    return $self;"
NSQ_SOURCE_LINE 00003751 "}"
NSQ_SOURCE_LINE 00003752 ""
NSQ_SOURCE_LINE 00003753 "=pod"
NSQ_SOURCE_LINE 00003754 ""
NSQ_SOURCE_LINE 00003755 "=item started"
NSQ_SOURCE_LINE 00003756 ""
NSQ_SOURCE_LINE 00003757 "Returns TRUE if the harness has been started and has not yet finished."
NSQ_SOURCE_LINE 00003758 "This is useful when a harness may or may not have been started by the"
NSQ_SOURCE_LINE 00003759 "caller, and you want to conditionally start it:"
NSQ_SOURCE_LINE 00003760 ""
NSQ_SOURCE_LINE 00003761 "    $h->start unless $h->started;"
NSQ_SOURCE_LINE 00003762 ""
NSQ_SOURCE_LINE 00003763 "=cut"
NSQ_SOURCE_LINE 00003764 ""
NSQ_SOURCE_LINE 00003765 "sub started {"
NSQ_SOURCE_LINE 00003766 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00003767 "    return $self->{STATE} >= _started;"
NSQ_SOURCE_LINE 00003768 "}"
NSQ_SOURCE_LINE 00003769 ""
NSQ_SOURCE_LINE 00003770 "=item pumpable"
NSQ_SOURCE_LINE 00003771 ""
NSQ_SOURCE_LINE 00003772 "Returns TRUE if calling pump() won't throw an immediate \"process ended"
NSQ_SOURCE_LINE 00003773 "prematurely\" exception.  This means that there are open I/O channels or"
NSQ_SOURCE_LINE 00003774 "active processes. May yield the parent processes' time slice for 0.01"
NSQ_SOURCE_LINE 00003775 "second if all pipes are to the child and all are paused.  In this case"
NSQ_SOURCE_LINE 00003776 "we can't tell if the child is dead, so we yield the processor and"
NSQ_SOURCE_LINE 00003777 "then attempt to reap the child in a nonblocking way."
NSQ_SOURCE_LINE 00003778 ""
NSQ_SOURCE_LINE 00003779 "To wait for child processes to exit during an event loop, poll"
NSQ_SOURCE_LINE 00003780 "C<$h->pumpable> until it returns false, then call C<finish>."
NSQ_SOURCE_LINE 00003781 "See also L</finished> to test whether the harness has already been"
NSQ_SOURCE_LINE 00003782 "finished."
NSQ_SOURCE_LINE 00003783 ""
NSQ_SOURCE_LINE 00003784 "=cut"
NSQ_SOURCE_LINE 00003785 ""
NSQ_SOURCE_LINE 00003786 "## Undocumented feature (don't depend on it outside this module):"
NSQ_SOURCE_LINE 00003787 "## returns -1 if we have I/O channels open, or >0 if no I/O channels"
NSQ_SOURCE_LINE 00003788 "## open, but we have kids running.  This allows the select loop"
NSQ_SOURCE_LINE 00003789 "## to poll for child exit."
NSQ_SOURCE_LINE 00003790 "sub pumpable {"
NSQ_SOURCE_LINE 00003791 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00003792 ""
NSQ_SOURCE_LINE 00003793 "    ## There's a catch-22 we can get in to if there is only one pipe left"
NSQ_SOURCE_LINE 00003794 "    ## open to the child and it's paused (ie the SCALAR it's tied to"
NSQ_SOURCE_LINE 00003795 "    ## is '').  It's paused, so we're not select()ing on it, so we don't"
NSQ_SOURCE_LINE 00003796 "    ## check it to see if the child attached to it is alive and it stays"
NSQ_SOURCE_LINE 00003797 "    ## in @{$self->{PIPES}} forever.  So, if all pipes are paused, see if"
NSQ_SOURCE_LINE 00003798 "    ## we can reap the child."
NSQ_SOURCE_LINE 00003799 "    return -1 if grep !$_->{PAUSED}, @{ $self->{PIPES} };"
NSQ_SOURCE_LINE 00003800 ""
NSQ_SOURCE_LINE 00003801 "    ## See if the child is dead."
NSQ_SOURCE_LINE 00003802 "    $self->reap_nb;"
NSQ_SOURCE_LINE 00003803 "    return 0 unless $self->_running_kids;"
NSQ_SOURCE_LINE 00003804 ""
NSQ_SOURCE_LINE 00003805 "    ## If we reap_nb and it's not dead yet, yield to it to see if it"
NSQ_SOURCE_LINE 00003806 "    ## exits."
NSQ_SOURCE_LINE 00003807 "    ##"
NSQ_SOURCE_LINE 00003808 "    ## A better solution would be to unpause all the pipes, but I tried that"
NSQ_SOURCE_LINE 00003809 "    ## and it never errored on linux.  Sigh."
NSQ_SOURCE_LINE 00003810 "    select undef, undef, undef, 0.0001;"
NSQ_SOURCE_LINE 00003811 ""
NSQ_SOURCE_LINE 00003812 "    ## try again"
NSQ_SOURCE_LINE 00003813 "    $self->reap_nb;"
NSQ_SOURCE_LINE 00003814 "    return 0 unless $self->_running_kids;"
NSQ_SOURCE_LINE 00003815 ""
NSQ_SOURCE_LINE 00003816 "    return -1;    ## There are pipes waiting"
NSQ_SOURCE_LINE 00003817 "}"
NSQ_SOURCE_LINE 00003818 ""
NSQ_SOURCE_LINE 00003819 "sub _running_kids {"
NSQ_SOURCE_LINE 00003820 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00003821 "    return grep"
NSQ_SOURCE_LINE 00003822 "      defined $_->{PID} && !defined $_->{RESULT},"
NSQ_SOURCE_LINE 00003823 "      @{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00003824 "}"
NSQ_SOURCE_LINE 00003825 ""
NSQ_SOURCE_LINE 00003826 "=pod"
NSQ_SOURCE_LINE 00003827 ""
NSQ_SOURCE_LINE 00003828 "=item reap_nb"
NSQ_SOURCE_LINE 00003829 ""
NSQ_SOURCE_LINE 00003830 "Attempts to reap child processes, but does not block."
NSQ_SOURCE_LINE 00003831 ""
NSQ_SOURCE_LINE 00003832 "Does not currently take any parameters, one day it will allow specific"
NSQ_SOURCE_LINE 00003833 "children to be reaped."
NSQ_SOURCE_LINE 00003834 ""
NSQ_SOURCE_LINE 00003835 "Only call this from a signal handler if your C<perl> is recent enough"
NSQ_SOURCE_LINE 00003836 "to have safe signal handling (5.6.1 did not, IIRC, but it was being discussed"
NSQ_SOURCE_LINE 00003837 "on perl5-porters).  Calling this (or doing any significant work) in a signal"
NSQ_SOURCE_LINE 00003838 "handler on older C<perl>s is asking for seg faults."
NSQ_SOURCE_LINE 00003839 ""
NSQ_SOURCE_LINE 00003840 "=cut"
NSQ_SOURCE_LINE 00003841 ""
NSQ_SOURCE_LINE 00003842 "my $still_runnings;"
NSQ_SOURCE_LINE 00003843 ""
NSQ_SOURCE_LINE 00003844 "sub reap_nb {"
NSQ_SOURCE_LINE 00003845 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00003846 ""
NSQ_SOURCE_LINE 00003847 "    local $cur_self = $self;"
NSQ_SOURCE_LINE 00003848 ""
NSQ_SOURCE_LINE 00003849 "    ## No more pipes, look to see if all the kids yet live, reaping those"
NSQ_SOURCE_LINE 00003850 "    ## that haven't.  I'd use $SIG{CHLD}/$SIG{CLD}, but that's broken"
NSQ_SOURCE_LINE 00003851 "    ## on older (SYSV) platforms and perhaps less portable than waitpid()."
NSQ_SOURCE_LINE 00003852 "    ## This could be slow with a lot of kids, but that's rare and, well,"
NSQ_SOURCE_LINE 00003853 "    ## a lot of kids is slow in the first place."
NSQ_SOURCE_LINE 00003854 "    ## Oh, and this keeps us from reaping other children the process"
NSQ_SOURCE_LINE 00003855 "    ## may have spawned."
NSQ_SOURCE_LINE 00003856 "    for my $kid ( @{ $self->{KIDS} } ) {"
NSQ_SOURCE_LINE 00003857 "        _waitpid( $kid, 1 );"
NSQ_SOURCE_LINE 00003858 "    }"
NSQ_SOURCE_LINE 00003859 "}"
NSQ_SOURCE_LINE 00003860 ""
NSQ_SOURCE_LINE 00003861 "# Support routine (non-method) for waitpid() or platform's equivalent.  Sets $?"
NSQ_SOURCE_LINE 00003862 "# and $_[0]->{RESULT} iff the kid exited."
NSQ_SOURCE_LINE 00003863 "sub _waitpid {"
NSQ_SOURCE_LINE 00003864 "    my ( $kid, $nohang ) = @_;"
NSQ_SOURCE_LINE 00003865 ""
NSQ_SOURCE_LINE 00003866 "    if (Win32_MODE) {"
NSQ_SOURCE_LINE 00003867 "        require Win32::Process;"
NSQ_SOURCE_LINE 00003868 ""
NSQ_SOURCE_LINE 00003869 "        return if !defined $kid->{PROCESS} || defined $kid->{RESULT};"
NSQ_SOURCE_LINE 00003870 "        my $wait_timeout = $nohang ? 0 : Win32::Process::INFINITE();"
NSQ_SOURCE_LINE 00003871 "        unless ( $kid->{PROCESS}->Wait($wait_timeout) ) {"
NSQ_SOURCE_LINE 00003872 "            confess \"kid $kid->{PID} still running after indefinite wait\""
NSQ_SOURCE_LINE 00003873 "              unless $nohang;"
NSQ_SOURCE_LINE 00003874 "            _debug \"kid $kid->{NUM} ($kid->{PID}) still running\""
NSQ_SOURCE_LINE 00003875 "              if _debugging_details;"
NSQ_SOURCE_LINE 00003876 "            return;"
NSQ_SOURCE_LINE 00003877 "        }"
NSQ_SOURCE_LINE 00003878 ""
NSQ_SOURCE_LINE 00003879 "        _debug \"kid $kid->{NUM} ($kid->{PID}) exited\""
NSQ_SOURCE_LINE 00003880 "          if _debugging;"
NSQ_SOURCE_LINE 00003881 ""
NSQ_SOURCE_LINE 00003882 "        my $native_result;"
NSQ_SOURCE_LINE 00003883 "        $kid->{PROCESS}->GetExitCode($native_result)"
NSQ_SOURCE_LINE 00003884 "          or croak \"$! while GetExitCode()ing for Win32 process\";"
NSQ_SOURCE_LINE 00003885 ""
NSQ_SOURCE_LINE 00003886 "        unless ( defined $native_result ) {"
NSQ_SOURCE_LINE 00003887 "            $kid->{RESULT} = \"0 but true\";"
NSQ_SOURCE_LINE 00003888 "            $? = $kid->{RESULT} = 0x0F;"
NSQ_SOURCE_LINE 00003889 "        }"
NSQ_SOURCE_LINE 00003890 "        else {"
NSQ_SOURCE_LINE 00003891 "            my $win32_full_result = $native_result << 8;"
NSQ_SOURCE_LINE 00003892 "            if ( $win32_full_result >> 8 != $native_result ) {"
NSQ_SOURCE_LINE 00003893 ""
NSQ_SOURCE_LINE 00003894 "                # !USE_64_BIT_INT build and exit code > 0xFFFFFF"
NSQ_SOURCE_LINE 00003895 "                require Math::BigInt;"
NSQ_SOURCE_LINE 00003896 "                $win32_full_result = Math::BigInt->new($native_result);"
NSQ_SOURCE_LINE 00003897 "                $win32_full_result->blsft(8);"
NSQ_SOURCE_LINE 00003898 "            }"
NSQ_SOURCE_LINE 00003899 "            $? = $kid->{RESULT} = $win32_full_result;"
NSQ_SOURCE_LINE 00003900 "        }"
NSQ_SOURCE_LINE 00003901 "    }"
NSQ_SOURCE_LINE 00003902 "    else {"
NSQ_SOURCE_LINE 00003903 "        return if !defined $kid->{PID} || defined $kid->{RESULT};"
NSQ_SOURCE_LINE 00003904 "        my $pid = waitpid $kid->{PID}, $nohang ? POSIX::WNOHANG() : 0;"
NSQ_SOURCE_LINE 00003905 "        unless ($pid) {"
NSQ_SOURCE_LINE 00003906 "            confess \"kid $kid->{PID} still running after indefinite wait\""
NSQ_SOURCE_LINE 00003907 "              unless $nohang;"
NSQ_SOURCE_LINE 00003908 "            _debug \"$kid->{NUM} ($kid->{PID}) still running\""
NSQ_SOURCE_LINE 00003909 "              if _debugging_details;"
NSQ_SOURCE_LINE 00003910 "            return;"
NSQ_SOURCE_LINE 00003911 "        }"
NSQ_SOURCE_LINE 00003912 ""
NSQ_SOURCE_LINE 00003913 "        if ( $pid < 0 ) {"
NSQ_SOURCE_LINE 00003914 "            _debug \"No such process: $kid->{PID}\\n\" if _debugging;"
NSQ_SOURCE_LINE 00003915 "            $kid->{RESULT} = \"unknown result, unknown PID\";"
NSQ_SOURCE_LINE 00003916 "        }"
NSQ_SOURCE_LINE 00003917 "        else {"
NSQ_SOURCE_LINE 00003918 "            _debug \"kid $kid->{NUM} ($kid->{PID}) exited\""
NSQ_SOURCE_LINE 00003919 "              if _debugging;"
NSQ_SOURCE_LINE 00003920 ""
NSQ_SOURCE_LINE 00003921 "            confess \"waitpid returned the wrong PID: $pid instead of $kid->{PID}\""
NSQ_SOURCE_LINE 00003922 "              unless $pid == $kid->{PID};"
NSQ_SOURCE_LINE 00003923 "            _debug \"$kid->{PID} returned $?\\n\" if _debugging;"
NSQ_SOURCE_LINE 00003924 "            $kid->{RESULT} = $?;"
NSQ_SOURCE_LINE 00003925 "        }"
NSQ_SOURCE_LINE 00003926 "    }"
NSQ_SOURCE_LINE 00003927 "}"
NSQ_SOURCE_LINE 00003928 ""
NSQ_SOURCE_LINE 00003929 "=pod"
NSQ_SOURCE_LINE 00003930 ""
NSQ_SOURCE_LINE 00003931 "=item finish"
NSQ_SOURCE_LINE 00003932 ""
NSQ_SOURCE_LINE 00003933 "This must be called after the last start() or pump() call for a harness,"
NSQ_SOURCE_LINE 00003934 "or your system will accumulate defunct processes and you may \"leak\""
NSQ_SOURCE_LINE 00003935 "file descriptors."
NSQ_SOURCE_LINE 00003936 ""
NSQ_SOURCE_LINE 00003937 "finish() returns TRUE if all children returned 0 (and were not signaled and did"
NSQ_SOURCE_LINE 00003938 "not coredump, ie ! $?), and FALSE otherwise (this is like run(), and the"
NSQ_SOURCE_LINE 00003939 "opposite of system())."
NSQ_SOURCE_LINE 00003940 ""
NSQ_SOURCE_LINE 00003941 "Once a harness has been finished, it may be run() or start()ed again,"
NSQ_SOURCE_LINE 00003942 "including by pump()s auto-start."
NSQ_SOURCE_LINE 00003943 ""
NSQ_SOURCE_LINE 00003944 "If this throws an exception rather than a normal exit, the harness may"
NSQ_SOURCE_LINE 00003945 "be left in an unstable state, it's best to kill the harness to get rid"
NSQ_SOURCE_LINE 00003946 "of all the child processes, etc."
NSQ_SOURCE_LINE 00003947 ""
NSQ_SOURCE_LINE 00003948 "Specifically, if a timeout expires in finish(), finish() will not"
NSQ_SOURCE_LINE 00003949 "kill all the children.  Call C<< $h->kill_kill >> in this case if you care."
NSQ_SOURCE_LINE 00003950 "This differs from the behavior of L</run>."
NSQ_SOURCE_LINE 00003951 ""
NSQ_SOURCE_LINE 00003952 "=cut"
NSQ_SOURCE_LINE 00003953 ""
NSQ_SOURCE_LINE 00003954 "sub finish {"
NSQ_SOURCE_LINE 00003955 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00003956 "    my $options = @_ && ref $_[-1] eq 'HASH' ? pop : {};"
NSQ_SOURCE_LINE 00003957 ""
NSQ_SOURCE_LINE 00003958 "    local $cur_self = $self;"
NSQ_SOURCE_LINE 00003959 ""
NSQ_SOURCE_LINE 00003960 "    _debug \"** finishing\" if _debugging;"
NSQ_SOURCE_LINE 00003961 ""
NSQ_SOURCE_LINE 00003962 "    $self->{non_blocking}   = 0;"
NSQ_SOURCE_LINE 00003963 "    $self->{auto_close_ins} = 1;"
NSQ_SOURCE_LINE 00003964 "    $self->{break_on_io}    = 0;"
NSQ_SOURCE_LINE 00003965 ""
NSQ_SOURCE_LINE 00003966 "    # We don't alter $self->{clear_ins}, start() and run() control it."
NSQ_SOURCE_LINE 00003967 ""
NSQ_SOURCE_LINE 00003968 "    if ( %{ $self->{PTYS} } || @{ $self->{PIPES} } || @{ $self->{TIMERS} } ) {"
NSQ_SOURCE_LINE 00003969 "        while ( $self->pumpable ) {"
NSQ_SOURCE_LINE 00003970 "            $self->_select_loop($options);"
NSQ_SOURCE_LINE 00003971 "        }"
NSQ_SOURCE_LINE 00003972 "    }"
NSQ_SOURCE_LINE 00003973 "    $self->_cleanup;"
NSQ_SOURCE_LINE 00003974 ""
NSQ_SOURCE_LINE 00003975 "    ## GH#122: Propagate CODE ref exceptions to the caller."
NSQ_SOURCE_LINE 00003976 "    if ( $self->{CODEREF_EXCEPTIONS} && @{ $self->{CODEREF_EXCEPTIONS} } ) {"
NSQ_SOURCE_LINE 00003977 "        croak $self->{CODEREF_EXCEPTIONS}->[0];"
NSQ_SOURCE_LINE 00003978 "    }"
NSQ_SOURCE_LINE 00003979 ""
NSQ_SOURCE_LINE 00003980 "    return !$self->full_result;"
NSQ_SOURCE_LINE 00003981 "}"
NSQ_SOURCE_LINE 00003982 ""
NSQ_SOURCE_LINE 00003983 "=pod"
NSQ_SOURCE_LINE 00003984 ""
NSQ_SOURCE_LINE 00003985 "=item result"
NSQ_SOURCE_LINE 00003986 ""
NSQ_SOURCE_LINE 00003987 "   $h->result;"
NSQ_SOURCE_LINE 00003988 ""
NSQ_SOURCE_LINE 00003989 "Returns the first non-zero result code (ie $? >> 8).  See L</full_result> to"
NSQ_SOURCE_LINE 00003990 "get the $? value for a child process."
NSQ_SOURCE_LINE 00003991 ""
NSQ_SOURCE_LINE 00003992 "To get the result of a particular child, do:"
NSQ_SOURCE_LINE 00003993 ""
NSQ_SOURCE_LINE 00003994 "   $h->result( 0 );  # first child's $? >> 8"
NSQ_SOURCE_LINE 00003995 "   $h->result( 1 );  # second child"
NSQ_SOURCE_LINE 00003996 ""
NSQ_SOURCE_LINE 00003997 "or"
NSQ_SOURCE_LINE 00003998 ""
NSQ_SOURCE_LINE 00003999 "   ($h->results)[0]"
NSQ_SOURCE_LINE 00004000 "   ($h->results)[1]"
NSQ_SOURCE_LINE 00004001 ""
NSQ_SOURCE_LINE 00004002 "Returns undef if no child processes were spawned and no child number was"
NSQ_SOURCE_LINE 00004003 "specified.  Throws an exception if an out-of-range child number is passed."
NSQ_SOURCE_LINE 00004004 ""
NSQ_SOURCE_LINE 00004005 "Note that C<result> returns C<undef> both when no children have exited and"
NSQ_SOURCE_LINE 00004006 "when all children exited with a zero exit code.  Use L</finished> to"
NSQ_SOURCE_LINE 00004007 "determine whether the harness has actually completed, or use L</results> to"
NSQ_SOURCE_LINE 00004008 "get the exit codes of all children (including zeros)."
NSQ_SOURCE_LINE 00004009 ""
NSQ_SOURCE_LINE 00004010 "=cut"
NSQ_SOURCE_LINE 00004011 ""
NSQ_SOURCE_LINE 00004012 "sub _assert_finished {"
NSQ_SOURCE_LINE 00004013 "    my IPC::Run $self = $_[0];"
NSQ_SOURCE_LINE 00004014 ""
NSQ_SOURCE_LINE 00004015 "    croak \"Harness not run\" unless $self->{STATE} >= _finished;"
NSQ_SOURCE_LINE 00004016 "    croak \"Harness not finished running\" unless $self->{STATE} == _finished;"
NSQ_SOURCE_LINE 00004017 "}"
NSQ_SOURCE_LINE 00004018 ""
NSQ_SOURCE_LINE 00004019 "sub _child_result {"
NSQ_SOURCE_LINE 00004020 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00004021 ""
NSQ_SOURCE_LINE 00004022 "    my ($which) = @_;"
NSQ_SOURCE_LINE 00004023 "    croak("
NSQ_SOURCE_LINE 00004024 "        \"Only \","
NSQ_SOURCE_LINE 00004025 "        scalar( @{ $self->{KIDS} } ),"
NSQ_SOURCE_LINE 00004026 "        \" child processes, no process $which\""
NSQ_SOURCE_LINE 00004027 "    ) unless $which >= 0 && $which <= $#{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00004028 "    return $self->{KIDS}->[$which]->{RESULT};"
NSQ_SOURCE_LINE 00004029 "}"
NSQ_SOURCE_LINE 00004030 ""
NSQ_SOURCE_LINE 00004031 "# When $SIG{CHLD} is 'IGNORE', waitpid returns -1 and RESULT is set to"
NSQ_SOURCE_LINE 00004032 "# the string \"unknown result, unknown PID\".  Using that string in numeric"
NSQ_SOURCE_LINE 00004033 "# context (>> 8, 0+, boolean) triggers a warning.  This helper silences it."
NSQ_SOURCE_LINE 00004034 "sub _numeric_result {"
NSQ_SOURCE_LINE 00004035 "    no warnings 'numeric';"
NSQ_SOURCE_LINE 00004036 "    return 0 + $_[0];"
NSQ_SOURCE_LINE 00004037 "}"
NSQ_SOURCE_LINE 00004038 ""
NSQ_SOURCE_LINE 00004039 "sub result {"
NSQ_SOURCE_LINE 00004040 "    &_assert_finished;"
NSQ_SOURCE_LINE 00004041 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00004042 ""
NSQ_SOURCE_LINE 00004043 "    if (@_) {"
NSQ_SOURCE_LINE 00004044 "        my ($which) = @_;"
NSQ_SOURCE_LINE 00004045 "        return _numeric_result( $self->_child_result($which) ) >> 8;"
NSQ_SOURCE_LINE 00004046 "    }"
NSQ_SOURCE_LINE 00004047 "    else {"
NSQ_SOURCE_LINE 00004048 "        return undef unless @{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00004049 "        for ( @{ $self->{KIDS} } ) {"
NSQ_SOURCE_LINE 00004050 "            my $candidate = _numeric_result( $_->{RESULT} ) >> 8;"
NSQ_SOURCE_LINE 00004051 "            return $candidate if $candidate;"
NSQ_SOURCE_LINE 00004052 "        }"
NSQ_SOURCE_LINE 00004053 "    }"
NSQ_SOURCE_LINE 00004054 "}"
NSQ_SOURCE_LINE 00004055 ""
NSQ_SOURCE_LINE 00004056 "=pod"
NSQ_SOURCE_LINE 00004057 ""
NSQ_SOURCE_LINE 00004058 "=item results"
NSQ_SOURCE_LINE 00004059 ""
NSQ_SOURCE_LINE 00004060 "Returns a list of child exit values.  See L</full_results> if you want to"
NSQ_SOURCE_LINE 00004061 "know if a signal killed the child."
NSQ_SOURCE_LINE 00004062 ""
NSQ_SOURCE_LINE 00004063 "Throws an exception if the harness is not in a finished state."
NSQ_SOURCE_LINE 00004064 " "
NSQ_SOURCE_LINE 00004065 "=cut"
NSQ_SOURCE_LINE 00004066 ""
NSQ_SOURCE_LINE 00004067 "sub results {"
NSQ_SOURCE_LINE 00004068 "    &_assert_finished;"
NSQ_SOURCE_LINE 00004069 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00004070 ""
NSQ_SOURCE_LINE 00004071 "    return map { _numeric_result( $_->{RESULT} ) >> 8 } @{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00004072 "}"
NSQ_SOURCE_LINE 00004073 ""
NSQ_SOURCE_LINE 00004074 "=pod"
NSQ_SOURCE_LINE 00004075 ""
NSQ_SOURCE_LINE 00004076 "=item full_result"
NSQ_SOURCE_LINE 00004077 ""
NSQ_SOURCE_LINE 00004078 "   $h->full_result;"
NSQ_SOURCE_LINE 00004079 ""
NSQ_SOURCE_LINE 00004080 "Returns the first non-zero $?.  See L</result> to get the first $? >> 8 "
NSQ_SOURCE_LINE 00004081 "value for a child process."
NSQ_SOURCE_LINE 00004082 ""
NSQ_SOURCE_LINE 00004083 "To get the result of a particular child, do:"
NSQ_SOURCE_LINE 00004084 ""
NSQ_SOURCE_LINE 00004085 "   $h->full_result( 0 );  # first child's $?"
NSQ_SOURCE_LINE 00004086 "   $h->full_result( 1 );  # second child"
NSQ_SOURCE_LINE 00004087 ""
NSQ_SOURCE_LINE 00004088 "or"
NSQ_SOURCE_LINE 00004089 ""
NSQ_SOURCE_LINE 00004090 "   ($h->full_results)[0]"
NSQ_SOURCE_LINE 00004091 "   ($h->full_results)[1]"
NSQ_SOURCE_LINE 00004092 ""
NSQ_SOURCE_LINE 00004093 "Returns undef if no child processes were spawned and no child number was"
NSQ_SOURCE_LINE 00004094 "specified.  Throws an exception if an out-of-range child number is passed."
NSQ_SOURCE_LINE 00004095 ""
NSQ_SOURCE_LINE 00004096 "=cut"
NSQ_SOURCE_LINE 00004097 ""
NSQ_SOURCE_LINE 00004098 "sub full_result {"
NSQ_SOURCE_LINE 00004099 "    &_assert_finished;"
NSQ_SOURCE_LINE 00004100 ""
NSQ_SOURCE_LINE 00004101 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00004102 ""
NSQ_SOURCE_LINE 00004103 "    if (@_) {"
NSQ_SOURCE_LINE 00004104 "        my ($which) = @_;"
NSQ_SOURCE_LINE 00004105 "        return $self->_child_result($which);"
NSQ_SOURCE_LINE 00004106 "    }"
NSQ_SOURCE_LINE 00004107 "    else {"
NSQ_SOURCE_LINE 00004108 "        return undef unless @{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00004109 "        for ( @{ $self->{KIDS} } ) {"
NSQ_SOURCE_LINE 00004110 "            return $_->{RESULT} if _numeric_result( $_->{RESULT} );"
NSQ_SOURCE_LINE 00004111 "        }"
NSQ_SOURCE_LINE 00004112 "    }"
NSQ_SOURCE_LINE 00004113 "}"
NSQ_SOURCE_LINE 00004114 ""
NSQ_SOURCE_LINE 00004115 "=pod"
NSQ_SOURCE_LINE 00004116 ""
NSQ_SOURCE_LINE 00004117 "=item full_results"
NSQ_SOURCE_LINE 00004118 ""
NSQ_SOURCE_LINE 00004119 "Returns a list of child exit values as returned by C<wait>.  See L</results>"
NSQ_SOURCE_LINE 00004120 "if you don't care about coredumps or signals."
NSQ_SOURCE_LINE 00004121 ""
NSQ_SOURCE_LINE 00004122 "Throws an exception if the harness is not in a finished state."
NSQ_SOURCE_LINE 00004123 " "
NSQ_SOURCE_LINE 00004124 "=cut"
NSQ_SOURCE_LINE 00004125 ""
NSQ_SOURCE_LINE 00004126 "sub full_results {"
NSQ_SOURCE_LINE 00004127 "    &_assert_finished;"
NSQ_SOURCE_LINE 00004128 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00004129 ""
NSQ_SOURCE_LINE 00004130 "    croak \"Harness not run\" unless $self->{STATE} >= _finished;"
NSQ_SOURCE_LINE 00004131 "    croak \"Harness not finished running\" unless $self->{STATE} == _finished;"
NSQ_SOURCE_LINE 00004132 ""
NSQ_SOURCE_LINE 00004133 "    return map $_->{RESULT}, @{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00004134 "}"
NSQ_SOURCE_LINE 00004135 ""
NSQ_SOURCE_LINE 00004136 "=pod"
NSQ_SOURCE_LINE 00004137 ""
NSQ_SOURCE_LINE 00004138 "=item pid"
NSQ_SOURCE_LINE 00004139 ""
NSQ_SOURCE_LINE 00004140 "   $h->pid;"
NSQ_SOURCE_LINE 00004141 ""
NSQ_SOURCE_LINE 00004142 "Returns the process ID of the first child process, or undef if no child"
NSQ_SOURCE_LINE 00004143 "processes have been spawned yet."
NSQ_SOURCE_LINE 00004144 ""
NSQ_SOURCE_LINE 00004145 "To get the PID of a particular child, do:"
NSQ_SOURCE_LINE 00004146 ""
NSQ_SOURCE_LINE 00004147 "   $h->pid( 0 );  # first child's PID"
NSQ_SOURCE_LINE 00004148 "   $h->pid( 1 );  # second child's PID"
NSQ_SOURCE_LINE 00004149 ""
NSQ_SOURCE_LINE 00004150 "or"
NSQ_SOURCE_LINE 00004151 ""
NSQ_SOURCE_LINE 00004152 "   ($h->pids)[0]"
NSQ_SOURCE_LINE 00004153 "   ($h->pids)[1]"
NSQ_SOURCE_LINE 00004154 ""
NSQ_SOURCE_LINE 00004155 "PIDs are available as soon as the harness has been started with L</start>."
NSQ_SOURCE_LINE 00004156 ""
NSQ_SOURCE_LINE 00004157 "=cut"
NSQ_SOURCE_LINE 00004158 ""
NSQ_SOURCE_LINE 00004159 "sub pid {"
NSQ_SOURCE_LINE 00004160 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00004161 ""
NSQ_SOURCE_LINE 00004162 "    if (@_) {"
NSQ_SOURCE_LINE 00004163 "        my ($which) = @_;"
NSQ_SOURCE_LINE 00004164 "        croak("
NSQ_SOURCE_LINE 00004165 "            \"Only \","
NSQ_SOURCE_LINE 00004166 "            scalar( @{ $self->{KIDS} } ),"
NSQ_SOURCE_LINE 00004167 "            \" child processes, no process $which\""
NSQ_SOURCE_LINE 00004168 "        ) unless $which >= 0 && $which <= $#{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00004169 "        return $self->{KIDS}->[$which]->{PID} || undef;"
NSQ_SOURCE_LINE 00004170 "    }"
NSQ_SOURCE_LINE 00004171 "    else {"
NSQ_SOURCE_LINE 00004172 "        return undef unless @{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00004173 "        return $self->{KIDS}->[0]->{PID} || undef;"
NSQ_SOURCE_LINE 00004174 "    }"
NSQ_SOURCE_LINE 00004175 "}"
NSQ_SOURCE_LINE 00004176 ""
NSQ_SOURCE_LINE 00004177 "=pod"
NSQ_SOURCE_LINE 00004178 ""
NSQ_SOURCE_LINE 00004179 "=item pids"
NSQ_SOURCE_LINE 00004180 ""
NSQ_SOURCE_LINE 00004181 "Returns a list of child process IDs.  See L</pid> to get the PID of a"
NSQ_SOURCE_LINE 00004182 "specific child process."
NSQ_SOURCE_LINE 00004183 ""
NSQ_SOURCE_LINE 00004184 "PIDs are available as soon as the harness has been started with L</start>."
NSQ_SOURCE_LINE 00004185 ""
NSQ_SOURCE_LINE 00004186 "=cut"
NSQ_SOURCE_LINE 00004187 ""
NSQ_SOURCE_LINE 00004188 "sub pids {"
NSQ_SOURCE_LINE 00004189 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00004190 ""
NSQ_SOURCE_LINE 00004191 "    return map { $_->{PID} || undef } @{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00004192 "}"
NSQ_SOURCE_LINE 00004193 ""
NSQ_SOURCE_LINE 00004194 "=pod"
NSQ_SOURCE_LINE 00004195 ""
NSQ_SOURCE_LINE 00004196 "=item is_running"
NSQ_SOURCE_LINE 00004197 ""
NSQ_SOURCE_LINE 00004198 "   $h->is_running;"
NSQ_SOURCE_LINE 00004199 ""
NSQ_SOURCE_LINE 00004200 "Returns true if the harness is currently running (i.e. after L</start> and"
NSQ_SOURCE_LINE 00004201 "before L</finish>), false otherwise."
NSQ_SOURCE_LINE 00004202 ""
NSQ_SOURCE_LINE 00004203 "=cut"
NSQ_SOURCE_LINE 00004204 ""
NSQ_SOURCE_LINE 00004205 "sub is_running {"
NSQ_SOURCE_LINE 00004206 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00004207 ""
NSQ_SOURCE_LINE 00004208 "    return $self->{STATE} == _started;"
NSQ_SOURCE_LINE 00004209 "}"
NSQ_SOURCE_LINE 00004210 ""
NSQ_SOURCE_LINE 00004211 "=pod"
NSQ_SOURCE_LINE 00004212 ""
NSQ_SOURCE_LINE 00004213 "=item full_path"
NSQ_SOURCE_LINE 00004214 ""
NSQ_SOURCE_LINE 00004215 "   $h->full_path;"
NSQ_SOURCE_LINE 00004216 ""
NSQ_SOURCE_LINE 00004217 "Returns the full path to the executable of the first child process, as"
NSQ_SOURCE_LINE 00004218 "resolved by searching C<PATH> when the harness is started with L</start>."
NSQ_SOURCE_LINE 00004219 "Returns undef if the first child is a code reference (not an external"
NSQ_SOURCE_LINE 00004220 "command), or if the harness has not been started yet."
NSQ_SOURCE_LINE 00004221 ""
NSQ_SOURCE_LINE 00004222 "To get the full path of a particular child, do:"
NSQ_SOURCE_LINE 00004223 ""
NSQ_SOURCE_LINE 00004224 "   $h->full_path( 0 );  # first child's executable path"
NSQ_SOURCE_LINE 00004225 "   $h->full_path( 1 );  # second child's executable path"
NSQ_SOURCE_LINE 00004226 ""
NSQ_SOURCE_LINE 00004227 "or"
NSQ_SOURCE_LINE 00004228 ""
NSQ_SOURCE_LINE 00004229 "   ($h->full_paths)[0]"
NSQ_SOURCE_LINE 00004230 "   ($h->full_paths)[1]"
NSQ_SOURCE_LINE 00004231 ""
NSQ_SOURCE_LINE 00004232 "=cut"
NSQ_SOURCE_LINE 00004233 ""
NSQ_SOURCE_LINE 00004234 "sub full_path {"
NSQ_SOURCE_LINE 00004235 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00004236 ""
NSQ_SOURCE_LINE 00004237 "    if (@_) {"
NSQ_SOURCE_LINE 00004238 "        my ($which) = @_;"
NSQ_SOURCE_LINE 00004239 "        croak("
NSQ_SOURCE_LINE 00004240 "            \"Only \","
NSQ_SOURCE_LINE 00004241 "            scalar( @{ $self->{KIDS} } ),"
NSQ_SOURCE_LINE 00004242 "            \" child processes, no process $which\""
NSQ_SOURCE_LINE 00004243 "        ) unless $which >= 0 && $which <= $#{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00004244 "        return $self->{KIDS}->[$which]->{PATH};"
NSQ_SOURCE_LINE 00004245 "    }"
NSQ_SOURCE_LINE 00004246 "    else {"
NSQ_SOURCE_LINE 00004247 "        return undef unless @{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00004248 "        return $self->{KIDS}->[0]->{PATH};"
NSQ_SOURCE_LINE 00004249 "    }"
NSQ_SOURCE_LINE 00004250 "}"
NSQ_SOURCE_LINE 00004251 ""
NSQ_SOURCE_LINE 00004252 "=pod"
NSQ_SOURCE_LINE 00004253 ""
NSQ_SOURCE_LINE 00004254 "=item full_paths"
NSQ_SOURCE_LINE 00004255 ""
NSQ_SOURCE_LINE 00004256 "Returns a list of full paths to the executables of all child processes."
NSQ_SOURCE_LINE 00004257 "Children that are code references (not external commands) will have C<undef>"
NSQ_SOURCE_LINE 00004258 "in the corresponding position."
NSQ_SOURCE_LINE 00004259 ""
NSQ_SOURCE_LINE 00004260 "=cut"
NSQ_SOURCE_LINE 00004261 ""
NSQ_SOURCE_LINE 00004262 "sub full_paths {"
NSQ_SOURCE_LINE 00004263 "    my IPC::Run $self = shift;"
NSQ_SOURCE_LINE 00004264 ""
NSQ_SOURCE_LINE 00004265 "    return map { $_->{PATH} } @{ $self->{KIDS} };"
NSQ_SOURCE_LINE 00004266 "}"
NSQ_SOURCE_LINE 00004267 ""
NSQ_SOURCE_LINE 00004268 "=pod"
NSQ_SOURCE_LINE 00004269 ""
NSQ_SOURCE_LINE 00004270 "=item finished"
NSQ_SOURCE_LINE 00004271 ""
NSQ_SOURCE_LINE 00004272 "   $h->finished;"
NSQ_SOURCE_LINE 00004273 ""
NSQ_SOURCE_LINE 00004274 "Returns true if the harness has been started and all child processes have"
NSQ_SOURCE_LINE 00004275 "finished (i.e. C<finish> has been called or the harness has run to"
NSQ_SOURCE_LINE 00004276 "completion).  Returns false otherwise, including when the harness has not"
NSQ_SOURCE_LINE 00004277 "yet been started."
NSQ_SOURCE_LINE 00004278 ""
NSQ_SOURCE_LINE 00004279 "Unlike L</result> and L</full_result>, C<finished> does not throw an"
NSQ_SOURCE_LINE 00004280 "exception when the harness has not yet run -- it simply returns false."
NSQ_SOURCE_LINE 00004281 "This makes it safe to call at any point to test completion status."
NSQ_SOURCE_LINE 00004282 ""
NSQ_SOURCE_LINE 00004283 "   my $h = harness(\\@cmd);"
NSQ_SOURCE_LINE 00004284 "   $h->start;"
NSQ_SOURCE_LINE 00004285 "   # ... do other work, pump $h as needed ..."
NSQ_SOURCE_LINE 00004286 "   if ( $h->finished ) {"
NSQ_SOURCE_LINE 00004287 "       print \"Exit code: \", $h->result(0), \"\\n\";"
NSQ_SOURCE_LINE 00004288 "   }"
NSQ_SOURCE_LINE 00004289 ""
NSQ_SOURCE_LINE 00004290 "=cut"
NSQ_SOURCE_LINE 00004291 ""
NSQ_SOURCE_LINE 00004292 "sub finished {"
NSQ_SOURCE_LINE 00004293 "    my IPC::Run $self = $_[0];"
NSQ_SOURCE_LINE 00004294 "    return $self->{STATE} == _finished;"
NSQ_SOURCE_LINE 00004295 "}"
NSQ_SOURCE_LINE 00004296 ""
NSQ_SOURCE_LINE 00004297 "##"
NSQ_SOURCE_LINE 00004298 "## Filter Scaffolding"
NSQ_SOURCE_LINE 00004299 "##"
NSQ_SOURCE_LINE 00004300 "use vars ("
NSQ_SOURCE_LINE 00004301 "    '$filter_op',     ## The op running a filter chain right now"
NSQ_SOURCE_LINE 00004302 "    '$filter_num',    ## Which filter is being run right now."
NSQ_SOURCE_LINE 00004303 ");"
NSQ_SOURCE_LINE 00004304 ""
NSQ_SOURCE_LINE 00004305 "##"
NSQ_SOURCE_LINE 00004306 "## A few filters and filter constructors"
NSQ_SOURCE_LINE 00004307 "##"
NSQ_SOURCE_LINE 00004308 ""
NSQ_SOURCE_LINE 00004309 "=pod"
NSQ_SOURCE_LINE 00004310 ""
NSQ_SOURCE_LINE 00004311 "=back"
NSQ_SOURCE_LINE 00004312 ""
NSQ_SOURCE_LINE 00004313 "=back"
NSQ_SOURCE_LINE 00004314 ""
NSQ_SOURCE_LINE 00004315 "=head1 FILTERS"
NSQ_SOURCE_LINE 00004316 ""
NSQ_SOURCE_LINE 00004317 "These filters are used to modify input our output between a child"
NSQ_SOURCE_LINE 00004318 "process and a scalar or subroutine endpoint."
NSQ_SOURCE_LINE 00004319 ""
NSQ_SOURCE_LINE 00004320 "=over"
NSQ_SOURCE_LINE 00004321 ""
NSQ_SOURCE_LINE 00004322 "=item binary"
NSQ_SOURCE_LINE 00004323 ""
NSQ_SOURCE_LINE 00004324 "   run \\@cmd, \">\", binary, \\$out;"
NSQ_SOURCE_LINE 00004325 "   run \\@cmd, \">\", binary, \\$out;  ## Any TRUE value to enable"
NSQ_SOURCE_LINE 00004326 "   run \\@cmd, \">\", binary 0, \\$out;  ## Any FALSE value to disable"
NSQ_SOURCE_LINE 00004327 ""
NSQ_SOURCE_LINE 00004328 "This is a constructor for a \"binmode\" \"filter\" that tells IPC::Run to keep"
NSQ_SOURCE_LINE 00004329 "the carriage returns that would ordinarily be edited out for you (binmode"
NSQ_SOURCE_LINE 00004330 "is usually off).  This is not a real filter, but an option masquerading as"
NSQ_SOURCE_LINE 00004331 "a filter."
NSQ_SOURCE_LINE 00004332 ""
NSQ_SOURCE_LINE 00004333 "It's not named \"binmode\" because you're likely to want to call Perl's binmode"
NSQ_SOURCE_LINE 00004334 "in programs that are piping binary data around."
NSQ_SOURCE_LINE 00004335 ""
NSQ_SOURCE_LINE 00004336 "=cut"
NSQ_SOURCE_LINE 00004337 ""
NSQ_SOURCE_LINE 00004338 "sub binary(;$) {"
NSQ_SOURCE_LINE 00004339 "    my $enable = @_ ? shift : 1;"
NSQ_SOURCE_LINE 00004340 "    return bless sub { $enable }, \"IPC::Run::binmode_pseudo_filter\";"
NSQ_SOURCE_LINE 00004341 "}"
NSQ_SOURCE_LINE 00004342 ""
NSQ_SOURCE_LINE 00004343 "=pod"
NSQ_SOURCE_LINE 00004344 ""
NSQ_SOURCE_LINE 00004345 "=item new_chunker"
NSQ_SOURCE_LINE 00004346 ""
NSQ_SOURCE_LINE 00004347 "This breaks a stream of data in to chunks, based on an optional"
NSQ_SOURCE_LINE 00004348 "scalar or regular expression parameter.  The default is the Perl"
NSQ_SOURCE_LINE 00004349 "input record separator in $/, which is a newline be default."
NSQ_SOURCE_LINE 00004350 ""
NSQ_SOURCE_LINE 00004351 "   run \\@cmd, '>', new_chunker, \\&lines_handler;"
NSQ_SOURCE_LINE 00004352 "   run \\@cmd, '>', new_chunker( \"\\r\\n\" ), \\&lines_handler;"
NSQ_SOURCE_LINE 00004353 ""
NSQ_SOURCE_LINE 00004354 "Because this uses $/ by default, you should always pass in a parameter"
NSQ_SOURCE_LINE 00004355 "if you are worried about other code (modules, etc) modifying $/."
NSQ_SOURCE_LINE 00004356 ""
NSQ_SOURCE_LINE 00004357 "If this filter is last in a filter chain that dumps in to a scalar,"
NSQ_SOURCE_LINE 00004358 "the scalar must be set to '' before a new chunk will be written to it."
NSQ_SOURCE_LINE 00004359 ""
NSQ_SOURCE_LINE 00004360 "As an example of how a filter like this can be written, here's a"
NSQ_SOURCE_LINE 00004361 "chunker that splits on newlines:"
NSQ_SOURCE_LINE 00004362 ""
NSQ_SOURCE_LINE 00004363 "   sub line_splitter {"
NSQ_SOURCE_LINE 00004364 "      my ( $in_ref, $out_ref ) = @_;"
NSQ_SOURCE_LINE 00004365 ""
NSQ_SOURCE_LINE 00004366 "      return 0 if length $$out_ref;"
NSQ_SOURCE_LINE 00004367 ""
NSQ_SOURCE_LINE 00004368 "      return input_avail && do {"
NSQ_SOURCE_LINE 00004369 "         while (1) {"
NSQ_SOURCE_LINE 00004370 "            if ( $$in_ref =~ s/\\A(.*?\\n)// ) {"
NSQ_SOURCE_LINE 00004371 "               $$out_ref .= $1;"
NSQ_SOURCE_LINE 00004372 "               return 1;"
NSQ_SOURCE_LINE 00004373 "            }"
NSQ_SOURCE_LINE 00004374 "            my $hmm = get_more_input;"
NSQ_SOURCE_LINE 00004375 "            unless ( defined $hmm ) {"
NSQ_SOURCE_LINE 00004376 "               $$out_ref = $$in_ref;"
NSQ_SOURCE_LINE 00004377 "               $$in_ref = '';"
NSQ_SOURCE_LINE 00004378 "               return length $$out_ref ? 1 : 0;"
NSQ_SOURCE_LINE 00004379 "            }"
NSQ_SOURCE_LINE 00004380 "            return 0 if $hmm eq 0;"
NSQ_SOURCE_LINE 00004381 "         }"
NSQ_SOURCE_LINE 00004382 "      }"
NSQ_SOURCE_LINE 00004383 "   };"
NSQ_SOURCE_LINE 00004384 ""
NSQ_SOURCE_LINE 00004385 "=cut"
NSQ_SOURCE_LINE 00004386 ""
NSQ_SOURCE_LINE 00004387 "sub new_chunker(;$) {"
NSQ_SOURCE_LINE 00004388 "    my ($re) = @_;"
NSQ_SOURCE_LINE 00004389 "    $re = $/ if _empty $re;"
NSQ_SOURCE_LINE 00004390 "    $re = quotemeta($re) unless ref $re eq 'Regexp';"
NSQ_SOURCE_LINE 00004391 "    $re = qr/\\A(.*?$re)/s;"
NSQ_SOURCE_LINE 00004392 ""
NSQ_SOURCE_LINE 00004393 "    return sub {"
NSQ_SOURCE_LINE 00004394 "        my ( $in_ref, $out_ref ) = @_;"
NSQ_SOURCE_LINE 00004395 ""
NSQ_SOURCE_LINE 00004396 "        return 0 if length $$out_ref;"
NSQ_SOURCE_LINE 00004397 ""
NSQ_SOURCE_LINE 00004398 "        return input_avail && do {"
NSQ_SOURCE_LINE 00004399 "            while (1) {"
NSQ_SOURCE_LINE 00004400 "                if ( $$in_ref =~ s/$re// ) {"
NSQ_SOURCE_LINE 00004401 "                    $$out_ref .= $1;"
NSQ_SOURCE_LINE 00004402 "                    return 1;"
NSQ_SOURCE_LINE 00004403 "                }"
NSQ_SOURCE_LINE 00004404 "                my $hmm = get_more_input;"
NSQ_SOURCE_LINE 00004405 "                unless ( defined $hmm ) {"
NSQ_SOURCE_LINE 00004406 "                    $$out_ref = $$in_ref;"
NSQ_SOURCE_LINE 00004407 "                    $$in_ref  = '';"
NSQ_SOURCE_LINE 00004408 "                    return length $$out_ref ? 1 : 0;"
NSQ_SOURCE_LINE 00004409 "                }"
NSQ_SOURCE_LINE 00004410 "                return 0 if $hmm eq 0;"
NSQ_SOURCE_LINE 00004411 "            }"
NSQ_SOURCE_LINE 00004412 "          }"
NSQ_SOURCE_LINE 00004413 "    };"
NSQ_SOURCE_LINE 00004414 "}"
NSQ_SOURCE_LINE 00004415 ""
NSQ_SOURCE_LINE 00004416 "=pod"
NSQ_SOURCE_LINE 00004417 ""
NSQ_SOURCE_LINE 00004418 "=item new_appender"
NSQ_SOURCE_LINE 00004419 ""
NSQ_SOURCE_LINE 00004420 "This appends a fixed string to each chunk of data read from the source"
NSQ_SOURCE_LINE 00004421 "scalar or sub.  This might be useful if you're writing commands to a"
NSQ_SOURCE_LINE 00004422 "child process that always must end in a fixed string, like \"\\n\":"
NSQ_SOURCE_LINE 00004423 ""
NSQ_SOURCE_LINE 00004424 "   run( \\@cmd,"
NSQ_SOURCE_LINE 00004425 "      '<', new_appender( \"\\n\" ), \\&commands,"
NSQ_SOURCE_LINE 00004426 "   );"
NSQ_SOURCE_LINE 00004427 ""
NSQ_SOURCE_LINE 00004428 "Here's a typical filter sub that might be created by new_appender():"
NSQ_SOURCE_LINE 00004429 ""
NSQ_SOURCE_LINE 00004430 "   sub newline_appender {"
NSQ_SOURCE_LINE 00004431 "      my ( $in_ref, $out_ref ) = @_;"
NSQ_SOURCE_LINE 00004432 ""
NSQ_SOURCE_LINE 00004433 "      return input_avail && do {"
NSQ_SOURCE_LINE 00004434 "         $$out_ref = join( '', $$out_ref, $$in_ref, \"\\n\" );"
NSQ_SOURCE_LINE 00004435 "         $$in_ref = '';"
NSQ_SOURCE_LINE 00004436 "         1;"
NSQ_SOURCE_LINE 00004437 "      }"
NSQ_SOURCE_LINE 00004438 "   };"
NSQ_SOURCE_LINE 00004439 ""
NSQ_SOURCE_LINE 00004440 "=cut"
NSQ_SOURCE_LINE 00004441 ""
NSQ_SOURCE_LINE 00004442 "sub new_appender($) {"
NSQ_SOURCE_LINE 00004443 "    my ($suffix) = @_;"
NSQ_SOURCE_LINE 00004444 "    croak \"\\$suffix undefined\" unless defined $suffix;"
NSQ_SOURCE_LINE 00004445 ""
NSQ_SOURCE_LINE 00004446 "    return sub {"
NSQ_SOURCE_LINE 00004447 "        my ( $in_ref, $out_ref ) = @_;"
NSQ_SOURCE_LINE 00004448 ""
NSQ_SOURCE_LINE 00004449 "        return input_avail && do {"
NSQ_SOURCE_LINE 00004450 "            $$out_ref = join( '', $$out_ref, $$in_ref, $suffix );"
NSQ_SOURCE_LINE 00004451 "            $$in_ref = '';"
NSQ_SOURCE_LINE 00004452 "            1;"
NSQ_SOURCE_LINE 00004453 "          }"
NSQ_SOURCE_LINE 00004454 "    };"
NSQ_SOURCE_LINE 00004455 "}"
NSQ_SOURCE_LINE 00004456 ""
NSQ_SOURCE_LINE 00004457 "=item new_string_source"
NSQ_SOURCE_LINE 00004458 ""
NSQ_SOURCE_LINE 00004459 "TODO: Needs confirmation. Was previously undocumented. in this module."
NSQ_SOURCE_LINE 00004460 ""
NSQ_SOURCE_LINE 00004461 "This is a filter which is exportable. Returns a sub which appends the data passed in to the output buffer and returns 1 if data was appended. 0 if it was an empty string and undef if no data was passed. "
NSQ_SOURCE_LINE 00004462 ""
NSQ_SOURCE_LINE 00004463 "NOTE: Any additional variables passed to new_string_source will be passed to the sub every time it's called and appended to the output. "
NSQ_SOURCE_LINE 00004464 ""
NSQ_SOURCE_LINE 00004465 "=cut"
NSQ_SOURCE_LINE 00004466 ""
NSQ_SOURCE_LINE 00004467 "sub new_string_source {"
NSQ_SOURCE_LINE 00004468 "    my $ref;"
NSQ_SOURCE_LINE 00004469 "    if ( @_ > 1 ) {"
NSQ_SOURCE_LINE 00004470 "        $ref = [@_],"
NSQ_SOURCE_LINE 00004471 "    }"
NSQ_SOURCE_LINE 00004472 "    else {"
NSQ_SOURCE_LINE 00004473 "        $ref = shift;"
NSQ_SOURCE_LINE 00004474 "    }"
NSQ_SOURCE_LINE 00004475 ""
NSQ_SOURCE_LINE 00004476 "    return ref $ref eq 'SCALAR'"
NSQ_SOURCE_LINE 00004477 "      ? sub {"
NSQ_SOURCE_LINE 00004478 "        my ( $in_ref, $out_ref ) = @_;"
NSQ_SOURCE_LINE 00004479 ""
NSQ_SOURCE_LINE 00004480 "        return defined $$ref"
NSQ_SOURCE_LINE 00004481 "          ? do {"
NSQ_SOURCE_LINE 00004482 "            $$out_ref .= $$ref;"
NSQ_SOURCE_LINE 00004483 "            my $r = length $$ref ? 1 : 0;"
NSQ_SOURCE_LINE 00004484 "            $$ref = undef;"
NSQ_SOURCE_LINE 00004485 "            $r;"
NSQ_SOURCE_LINE 00004486 "          }"
NSQ_SOURCE_LINE 00004487 "          : undef;"
NSQ_SOURCE_LINE 00004488 "      }"
NSQ_SOURCE_LINE 00004489 "      : sub {"
NSQ_SOURCE_LINE 00004490 "        my ( $in_ref, $out_ref ) = @_;"
NSQ_SOURCE_LINE 00004491 ""
NSQ_SOURCE_LINE 00004492 "        return @$ref"
NSQ_SOURCE_LINE 00004493 "          ? do {"
NSQ_SOURCE_LINE 00004494 "            my $s = shift @$ref;"
NSQ_SOURCE_LINE 00004495 "            $$out_ref .= $s;"
NSQ_SOURCE_LINE 00004496 "            length $s ? 1 : 0;"
NSQ_SOURCE_LINE 00004497 "          }"
NSQ_SOURCE_LINE 00004498 "          : undef;"
NSQ_SOURCE_LINE 00004499 "      }"
NSQ_SOURCE_LINE 00004500 "}"
NSQ_SOURCE_LINE 00004501 ""
NSQ_SOURCE_LINE 00004502 "=item new_string_sink"
NSQ_SOURCE_LINE 00004503 ""
NSQ_SOURCE_LINE 00004504 "TODO: Needs confirmation. Was previously undocumented."
NSQ_SOURCE_LINE 00004505 ""
NSQ_SOURCE_LINE 00004506 "This is a filter which is exportable. Returns a sub which pops the data out of the input stream and pushes it onto the string."
NSQ_SOURCE_LINE 00004507 ""
NSQ_SOURCE_LINE 00004508 "=cut"
NSQ_SOURCE_LINE 00004509 ""
NSQ_SOURCE_LINE 00004510 "sub new_string_sink {"
NSQ_SOURCE_LINE 00004511 "    my ($string_ref) = @_;"
NSQ_SOURCE_LINE 00004512 ""
NSQ_SOURCE_LINE 00004513 "    return sub {"
NSQ_SOURCE_LINE 00004514 "        my ( $in_ref, $out_ref ) = @_;"
NSQ_SOURCE_LINE 00004515 ""
NSQ_SOURCE_LINE 00004516 "        return input_avail && do {"
NSQ_SOURCE_LINE 00004517 "            $$string_ref .= $$in_ref;"
NSQ_SOURCE_LINE 00004518 "            $$in_ref = '';"
NSQ_SOURCE_LINE 00004519 "            1;"
NSQ_SOURCE_LINE 00004520 "          }"
NSQ_SOURCE_LINE 00004521 "    };"
NSQ_SOURCE_LINE 00004522 "}"
NSQ_SOURCE_LINE 00004523 ""
NSQ_SOURCE_LINE 00004524 "=pod"
NSQ_SOURCE_LINE 00004525 ""
NSQ_SOURCE_LINE 00004526 "=item io"
NSQ_SOURCE_LINE 00004527 ""
NSQ_SOURCE_LINE 00004528 "Takes a filename or filehandle, a redirection operator, optional filters,"
NSQ_SOURCE_LINE 00004529 "and a source or destination (depends on the redirection operator).  Returns"
NSQ_SOURCE_LINE 00004530 "an IPC::Run::IO object suitable for harness()ing (including via start()"
NSQ_SOURCE_LINE 00004531 "or run())."
NSQ_SOURCE_LINE 00004532 ""
NSQ_SOURCE_LINE 00004533 "This is shorthand for "
NSQ_SOURCE_LINE 00004534 ""
NSQ_SOURCE_LINE 00004535 ""
NSQ_SOURCE_LINE 00004536 "   require IPC::Run::IO;"
NSQ_SOURCE_LINE 00004537 ""
NSQ_SOURCE_LINE 00004538 "      ... IPC::Run::IO->new(...) ..."
NSQ_SOURCE_LINE 00004539 ""
NSQ_SOURCE_LINE 00004540 "=cut"
NSQ_SOURCE_LINE 00004541 ""
NSQ_SOURCE_LINE 00004542 "sub io {"
NSQ_SOURCE_LINE 00004543 "    require IPC::Run::IO;"
NSQ_SOURCE_LINE 00004544 "    IPC::Run::IO->new(@_);"
NSQ_SOURCE_LINE 00004545 "}"
NSQ_SOURCE_LINE 00004546 ""
NSQ_SOURCE_LINE 00004547 "=pod"
NSQ_SOURCE_LINE 00004548 ""
NSQ_SOURCE_LINE 00004549 "=item timer"
NSQ_SOURCE_LINE 00004550 ""
NSQ_SOURCE_LINE 00004551 "   $h = start( \\@cmd, \\$in, \\$out, $t = timer( 5 ) );"
NSQ_SOURCE_LINE 00004552 ""
NSQ_SOURCE_LINE 00004553 "   pump $h until $out =~ /expected stuff/ || $t->is_expired;"
NSQ_SOURCE_LINE 00004554 ""
NSQ_SOURCE_LINE 00004555 "Instantiates a non-fatal timer.  pump() returns once each time a timer"
NSQ_SOURCE_LINE 00004556 "expires.  Has no direct effect on run(), but you can pass a subroutine"
NSQ_SOURCE_LINE 00004557 "to fire when the timer expires. "
NSQ_SOURCE_LINE 00004558 ""
NSQ_SOURCE_LINE 00004559 "See L</timeout> for building timers that throw exceptions on"
NSQ_SOURCE_LINE 00004560 "expiration."
NSQ_SOURCE_LINE 00004561 ""
NSQ_SOURCE_LINE 00004562 "See L<IPC::Run::Timer/timer> for details."
NSQ_SOURCE_LINE 00004563 ""
NSQ_SOURCE_LINE 00004564 "=cut"
NSQ_SOURCE_LINE 00004565 ""
NSQ_SOURCE_LINE 00004566 "# Doing the prototype suppresses 'only used once' on older perls."
NSQ_SOURCE_LINE 00004567 "sub timer;"
NSQ_SOURCE_LINE 00004568 "*timer = \\&IPC::Run::Timer::timer;"
NSQ_SOURCE_LINE 00004569 ""
NSQ_SOURCE_LINE 00004570 "=pod"
NSQ_SOURCE_LINE 00004571 ""
NSQ_SOURCE_LINE 00004572 "=item timeout"
NSQ_SOURCE_LINE 00004573 ""
NSQ_SOURCE_LINE 00004574 "   $h = start( \\@cmd, \\$in, \\$out, $t = timeout( 5 ) );"
NSQ_SOURCE_LINE 00004575 ""
NSQ_SOURCE_LINE 00004576 "   pump $h until $out =~ /expected stuff/;"
NSQ_SOURCE_LINE 00004577 ""
NSQ_SOURCE_LINE 00004578 "Instantiates a timer that throws an exception when it expires."
NSQ_SOURCE_LINE 00004579 "If you don't provide an exception, a default exception that matches"
NSQ_SOURCE_LINE 00004580 "/^IPC::Run: .*timed out/ is thrown by default.  You can pass in your own"
NSQ_SOURCE_LINE 00004581 "exception scalar or reference:"
NSQ_SOURCE_LINE 00004582 ""
NSQ_SOURCE_LINE 00004583 "   $h = start("
NSQ_SOURCE_LINE 00004584 "      \\@cmd, \\$in, \\$out,"
NSQ_SOURCE_LINE 00004585 "      $t = timeout( 5, exception => 'slowpoke' ),"
NSQ_SOURCE_LINE 00004586 "   );"
NSQ_SOURCE_LINE 00004587 ""
NSQ_SOURCE_LINE 00004588 "or set the name used in debugging message and in the default exception"
NSQ_SOURCE_LINE 00004589 "string:"
NSQ_SOURCE_LINE 00004590 ""
NSQ_SOURCE_LINE 00004591 "   $h = start("
NSQ_SOURCE_LINE 00004592 "      \\@cmd, \\$in, \\$out,"
NSQ_SOURCE_LINE 00004593 "      timeout( 50, name => 'process timer' ),"
NSQ_SOURCE_LINE 00004594 "      $stall_timer = timeout( 5, name => 'stall timer' ),"
NSQ_SOURCE_LINE 00004595 "   );"
NSQ_SOURCE_LINE 00004596 ""
NSQ_SOURCE_LINE 00004597 "   pump $h until $out =~ /started/;"
NSQ_SOURCE_LINE 00004598 ""
NSQ_SOURCE_LINE 00004599 "   $in = 'command 1';"
NSQ_SOURCE_LINE 00004600 "   $stall_timer->start;"
NSQ_SOURCE_LINE 00004601 "   pump $h until $out =~ /command 1 finished/;"
NSQ_SOURCE_LINE 00004602 ""
NSQ_SOURCE_LINE 00004603 "   $in = 'command 2';"
NSQ_SOURCE_LINE 00004604 "   $stall_timer->start;"
NSQ_SOURCE_LINE 00004605 "   pump $h until $out =~ /command 2 finished/;"
NSQ_SOURCE_LINE 00004606 ""
NSQ_SOURCE_LINE 00004607 "   $in = 'very slow command 3';"
NSQ_SOURCE_LINE 00004608 "   $stall_timer->start( 10 );"
NSQ_SOURCE_LINE 00004609 "   pump $h until $out =~ /command 3 finished/;"
NSQ_SOURCE_LINE 00004610 ""
NSQ_SOURCE_LINE 00004611 "   $stall_timer->start( 5 );"
NSQ_SOURCE_LINE 00004612 "   $in = 'command 4';"
NSQ_SOURCE_LINE 00004613 "   pump $h until $out =~ /command 4 finished/;"
NSQ_SOURCE_LINE 00004614 ""
NSQ_SOURCE_LINE 00004615 "   $stall_timer->reset; # Prevent restarting or expirng"
NSQ_SOURCE_LINE 00004616 "   finish $h;"
NSQ_SOURCE_LINE 00004617 ""
NSQ_SOURCE_LINE 00004618 "See L</timer> for building non-fatal timers."
NSQ_SOURCE_LINE 00004619 ""
NSQ_SOURCE_LINE 00004620 "See L<IPC::Run::Timer/timer> for details."
NSQ_SOURCE_LINE 00004621 ""
NSQ_SOURCE_LINE 00004622 "=cut"
NSQ_SOURCE_LINE 00004623 ""
NSQ_SOURCE_LINE 00004624 "# Doing the prototype suppresses 'only used once' on older perls."
NSQ_SOURCE_LINE 00004625 "sub timeout;"
NSQ_SOURCE_LINE 00004626 "*timeout = \\&IPC::Run::Timer::timeout;"
NSQ_SOURCE_LINE 00004627 ""
NSQ_SOURCE_LINE 00004628 "=pod"
NSQ_SOURCE_LINE 00004629 ""
NSQ_SOURCE_LINE 00004630 "=back"
NSQ_SOURCE_LINE 00004631 ""
NSQ_SOURCE_LINE 00004632 "=head1 FILTER IMPLEMENTATION FUNCTIONS"
NSQ_SOURCE_LINE 00004633 ""
NSQ_SOURCE_LINE 00004634 "These functions are for use from within filters."
NSQ_SOURCE_LINE 00004635 ""
NSQ_SOURCE_LINE 00004636 "=over"
NSQ_SOURCE_LINE 00004637 ""
NSQ_SOURCE_LINE 00004638 "=item input_avail"
NSQ_SOURCE_LINE 00004639 ""
NSQ_SOURCE_LINE 00004640 "Returns TRUE if input is available.  If none is available, then "
NSQ_SOURCE_LINE 00004641 "&get_more_input is called and its result is returned."
NSQ_SOURCE_LINE 00004642 ""
NSQ_SOURCE_LINE 00004643 "This is usually used in preference to &get_more_input so that the"
NSQ_SOURCE_LINE 00004644 "calling filter removes all data from the $in_ref before more data"
NSQ_SOURCE_LINE 00004645 "gets read in to $in_ref."
NSQ_SOURCE_LINE 00004646 ""
NSQ_SOURCE_LINE 00004647 "C<input_avail> is usually used as part of a return expression:"
NSQ_SOURCE_LINE 00004648 ""
NSQ_SOURCE_LINE 00004649 "   return input_avail && do {"
NSQ_SOURCE_LINE 00004650 "      ## process the input just gotten"
NSQ_SOURCE_LINE 00004651 "      1;"
NSQ_SOURCE_LINE 00004652 "   };"
NSQ_SOURCE_LINE 00004653 ""
NSQ_SOURCE_LINE 00004654 "This technique allows input_avail to return the undef or 0 that a"
NSQ_SOURCE_LINE 00004655 "filter normally returns when there's no input to process.  If a filter"
NSQ_SOURCE_LINE 00004656 "stores intermediate values, however, it will need to react to an"
NSQ_SOURCE_LINE 00004657 "undef:"
NSQ_SOURCE_LINE 00004658 ""
NSQ_SOURCE_LINE 00004659 "   my $got = input_avail;"
NSQ_SOURCE_LINE 00004660 "   if ( ! defined $got ) {"
NSQ_SOURCE_LINE 00004661 "      ## No more input ever, flush internal buffers to $out_ref"
NSQ_SOURCE_LINE 00004662 "   }"
NSQ_SOURCE_LINE 00004663 "   return $got unless $got;"
NSQ_SOURCE_LINE 00004664 "   ## Got some input, move as much as need be"
NSQ_SOURCE_LINE 00004665 "   return 1 if $added_to_out_ref;"
NSQ_SOURCE_LINE 00004666 ""
NSQ_SOURCE_LINE 00004667 "=cut"
NSQ_SOURCE_LINE 00004668 ""
NSQ_SOURCE_LINE 00004669 "sub input_avail() {"
NSQ_SOURCE_LINE 00004670 "    confess \"Undefined FBUF ref for $filter_num+1\""
NSQ_SOURCE_LINE 00004671 "      unless defined $filter_op->{FBUFS}->[ $filter_num + 1 ];"
NSQ_SOURCE_LINE 00004672 "    length ${ $filter_op->{FBUFS}->[ $filter_num + 1 ] } || get_more_input;"
NSQ_SOURCE_LINE 00004673 "}"
NSQ_SOURCE_LINE 00004674 ""
NSQ_SOURCE_LINE 00004675 "=pod"
NSQ_SOURCE_LINE 00004676 ""
NSQ_SOURCE_LINE 00004677 "=item get_more_input"
NSQ_SOURCE_LINE 00004678 ""
NSQ_SOURCE_LINE 00004679 "This is used to fetch more input in to the input variable.  It returns"
NSQ_SOURCE_LINE 00004680 "undef if there will never be any more input, 0 if there is none now,"
NSQ_SOURCE_LINE 00004681 "but there might be in the future, and TRUE if more input was gotten."
NSQ_SOURCE_LINE 00004682 ""
NSQ_SOURCE_LINE 00004683 "C<get_more_input> is usually used as part of a return expression,"
NSQ_SOURCE_LINE 00004684 "see L</input_avail> for more information."
NSQ_SOURCE_LINE 00004685 ""
NSQ_SOURCE_LINE 00004686 "=cut"
NSQ_SOURCE_LINE 00004687 ""
NSQ_SOURCE_LINE 00004688 "##"
NSQ_SOURCE_LINE 00004689 "## Filter implementation interface"
NSQ_SOURCE_LINE 00004690 "##"
NSQ_SOURCE_LINE 00004691 "sub get_more_input() {"
NSQ_SOURCE_LINE 00004692 "    ++$filter_num;"
NSQ_SOURCE_LINE 00004693 "    my $r = eval {"
NSQ_SOURCE_LINE 00004694 "        confess \"get_more_input() called and no more filters in chain\""
NSQ_SOURCE_LINE 00004695 "          unless defined $filter_op->{FILTERS}->[$filter_num];"
NSQ_SOURCE_LINE 00004696 "        $filter_op->{FILTERS}->[$filter_num]->("
NSQ_SOURCE_LINE 00004697 "            $filter_op->{FBUFS}->[ $filter_num + 1 ],"
NSQ_SOURCE_LINE 00004698 "            $filter_op->{FBUFS}->[$filter_num],"
NSQ_SOURCE_LINE 00004699 "        );    # if defined ${$filter_op->{FBUFS}->[$filter_num+1]};"
NSQ_SOURCE_LINE 00004700 "    };"
NSQ_SOURCE_LINE 00004701 "    --$filter_num;"
NSQ_SOURCE_LINE 00004702 "    die $@ if $@;"
NSQ_SOURCE_LINE 00004703 "    return $r;"
NSQ_SOURCE_LINE 00004704 "}"
NSQ_SOURCE_LINE 00004705 ""
NSQ_SOURCE_LINE 00004706 "1;"
NSQ_SOURCE_LINE 00004707 ""
NSQ_SOURCE_LINE 00004708 "=pod"
NSQ_SOURCE_LINE 00004709 ""
NSQ_SOURCE_LINE 00004710 "=back"
NSQ_SOURCE_LINE 00004711 ""
NSQ_SOURCE_LINE 00004712 "=head1 TODO"
NSQ_SOURCE_LINE 00004713 ""
NSQ_SOURCE_LINE 00004714 "These will be addressed as needed and as time allows."
NSQ_SOURCE_LINE 00004715 ""
NSQ_SOURCE_LINE 00004716 "Stall timeout."
NSQ_SOURCE_LINE 00004717 ""
NSQ_SOURCE_LINE 00004718 "Expose a list of child process objects.  When I do this,"
NSQ_SOURCE_LINE 00004719 "each child process is likely to be blessed into IPC::Run::Proc."
NSQ_SOURCE_LINE 00004720 ""
NSQ_SOURCE_LINE 00004721 "$kid->abort(), $kid->kill(), $kid->signal( $num_or_name )."
NSQ_SOURCE_LINE 00004722 ""
NSQ_SOURCE_LINE 00004723 "Write tests for /(full_)?results?/ subs."
NSQ_SOURCE_LINE 00004724 ""
NSQ_SOURCE_LINE 00004725 "Currently, pump() and run() only work on systems where select() works on the"
NSQ_SOURCE_LINE 00004726 "filehandles returned by pipe().  This does *not* include ActiveState on Win32,"
NSQ_SOURCE_LINE 00004727 "although it does work on cygwin under Win32 (thought the tests whine a bit)."
NSQ_SOURCE_LINE 00004728 "I'd like to rectify that, suggestions and patches welcome."
NSQ_SOURCE_LINE 00004729 ""
NSQ_SOURCE_LINE 00004730 "Likewise start() only fully works on fork()/exec() machines (well, just"
NSQ_SOURCE_LINE 00004731 "fork() if you only ever pass perl subs as subprocesses).  There's"
NSQ_SOURCE_LINE 00004732 "some scaffolding for calling Open3::spawn_with_handles(), but that's"
NSQ_SOURCE_LINE 00004733 "untested, and not that useful with limited select()."
NSQ_SOURCE_LINE 00004734 ""
NSQ_SOURCE_LINE 00004735 "Support for C<\\@sub_cmd> as an argument to a command which"
NSQ_SOURCE_LINE 00004736 "gets replaced with /dev/fd or the name of a temporary file containing foo's"
NSQ_SOURCE_LINE 00004737 "output.  This is like <(sub_cmd ...) found in bash and csh (IIRC)."
NSQ_SOURCE_LINE 00004738 ""
NSQ_SOURCE_LINE 00004739 "Allow multiple harnesses to be combined as independent sets of processes"
NSQ_SOURCE_LINE 00004740 "in to one 'meta-harness'."
NSQ_SOURCE_LINE 00004741 ""
NSQ_SOURCE_LINE 00004742 "Allow a harness to be passed in place of an \\@cmd.  This would allow"
NSQ_SOURCE_LINE 00004743 "multiple harnesses to be aggregated."
NSQ_SOURCE_LINE 00004744 ""
NSQ_SOURCE_LINE 00004745 "Ability to add external file descriptors w/ filter chains and endpoints."
NSQ_SOURCE_LINE 00004746 ""
NSQ_SOURCE_LINE 00004747 "Ability to add timeouts and timing generators (i.e. repeating timeouts)."
NSQ_SOURCE_LINE 00004748 ""
NSQ_SOURCE_LINE 00004749 "High resolution timeouts."
NSQ_SOURCE_LINE 00004750 ""
NSQ_SOURCE_LINE 00004751 "=head1 Win32 LIMITATIONS"
NSQ_SOURCE_LINE 00004752 ""
NSQ_SOURCE_LINE 00004753 "=over"
NSQ_SOURCE_LINE 00004754 ""
NSQ_SOURCE_LINE 00004755 "=item argument-passing rules are program-specific"
NSQ_SOURCE_LINE 00004756 ""
NSQ_SOURCE_LINE 00004757 "Win32 programs receive all arguments in a single \"command line\" string."
NSQ_SOURCE_LINE 00004758 "IPC::Run assembles this string so programs using L<standard command line parsing"
NSQ_SOURCE_LINE 00004759 "rules|https://docs.microsoft.com/en-us/cpp/cpp/main-function-command-line-args#parsing-c-command-line-arguments>"
NSQ_SOURCE_LINE 00004760 "will see an C<argv> that matches the array reference specifying the command."
NSQ_SOURCE_LINE 00004761 "Some programs use different rules to parse their command line.  Notable examples"
NSQ_SOURCE_LINE 00004762 "include F<cmd.exe>, F<cscript.exe>, and Cygwin programs called from non-Cygwin"
NSQ_SOURCE_LINE 00004763 "programs.  Use L<IPC::Run::Win32Process> to call these and other nonstandard"
NSQ_SOURCE_LINE 00004764 "programs."
NSQ_SOURCE_LINE 00004765 ""
NSQ_SOURCE_LINE 00004766 "=item batch files"
NSQ_SOURCE_LINE 00004767 ""
NSQ_SOURCE_LINE 00004768 "Properly escaping a batch file argument depends on how the script will use that"
NSQ_SOURCE_LINE 00004769 "argument, because some uses experience multiple levels of caret (escape"
NSQ_SOURCE_LINE 00004770 "character) removal.  Avoid calling batch files with arguments, particularly when"
NSQ_SOURCE_LINE 00004771 "the argument values originate outside your program or contain non-alphanumeric"
NSQ_SOURCE_LINE 00004772 "characters.  Perl scripts and PowerShell scripts are sound alternatives.  If you"
NSQ_SOURCE_LINE 00004773 "do use batch file arguments, IPC::Run escapes them so the batch file can pass"
NSQ_SOURCE_LINE 00004774 "them, unquoted, to a program having standard command line parsing rules.  If the"
NSQ_SOURCE_LINE 00004775 "batch file enables delayed environment variable expansion, it must disable that"
NSQ_SOURCE_LINE 00004776 "feature before expanding its arguments.  For example, if F<foo.cmd> contains"
NSQ_SOURCE_LINE 00004777 "C<perl %*>, C<run ['foo.cmd', @list]> will create a Perl process in which"
NSQ_SOURCE_LINE 00004778 "C<@ARGV> matches C<@list>.  Prepending a C<setlocal enabledelayedexpansion> line"
NSQ_SOURCE_LINE 00004779 "would make the batch file malfunction, silently.  Another silent-malfunction"
NSQ_SOURCE_LINE 00004780 "example is C<run ['outer.bat', @list]> for F<outer.bat> containing C<foo.cmd"
NSQ_SOURCE_LINE 00004781 "%*>."
NSQ_SOURCE_LINE 00004782 ""
NSQ_SOURCE_LINE 00004783 "=item Fails on Win9X"
NSQ_SOURCE_LINE 00004784 ""
NSQ_SOURCE_LINE 00004785 "If you want Win9X support, you'll have to debug it or fund me because I"
NSQ_SOURCE_LINE 00004786 "don't use that system any more.  The Win32 subsysem has been extended to"
NSQ_SOURCE_LINE 00004787 "use temporary files in simple run() invocations and these may actually"
NSQ_SOURCE_LINE 00004788 "work on Win9X too, but I don't have time to work on it."
NSQ_SOURCE_LINE 00004789 ""
NSQ_SOURCE_LINE 00004790 "=item May deadlock on Win2K (but not WinNT4 or WinXPPro)"
NSQ_SOURCE_LINE 00004791 ""
NSQ_SOURCE_LINE 00004792 "Spawning more than one subprocess on Win2K causes a deadlock I haven't"
NSQ_SOURCE_LINE 00004793 "figured out yet, but simple uses of run() often work.  Passes all tests"
NSQ_SOURCE_LINE 00004794 "on WinXPPro and WinNT."
NSQ_SOURCE_LINE 00004795 ""
NSQ_SOURCE_LINE 00004796 "=item no support yet for <pty< and >pty>"
NSQ_SOURCE_LINE 00004797 ""
NSQ_SOURCE_LINE 00004798 "These are likely to be implemented as \"<\" and \">\" with binmode on, not"
NSQ_SOURCE_LINE 00004799 "sure."
NSQ_SOURCE_LINE 00004800 ""
NSQ_SOURCE_LINE 00004801 "=item no support for file descriptors higher than 2 (stderr)"
NSQ_SOURCE_LINE 00004802 ""
NSQ_SOURCE_LINE 00004803 "Win32 only allows passing explicit fds 0, 1, and 2.  If you really, really need to pass file handles, us Win32API:: GetOsFHandle() or ::FdGetOsFHandle() to"
NSQ_SOURCE_LINE 00004804 "get the integer handle and pass it to the child process using the command"
NSQ_SOURCE_LINE 00004805 "line, environment, stdin, intermediary file, or other IPC mechanism.  Then"
NSQ_SOURCE_LINE 00004806 "use that handle in the child (Win32API.pm provides ways to reconstitute"
NSQ_SOURCE_LINE 00004807 "Perl file handles from Win32 file handles)."
NSQ_SOURCE_LINE 00004808 ""
NSQ_SOURCE_LINE 00004809 "=item no support for subroutine subprocesses (CODE refs)"
NSQ_SOURCE_LINE 00004810 ""
NSQ_SOURCE_LINE 00004811 "Can't fork(), so the subroutines would have no context, and closures certainly"
NSQ_SOURCE_LINE 00004812 "have no meaning"
NSQ_SOURCE_LINE 00004813 ""
NSQ_SOURCE_LINE 00004814 "Perhaps with Win32 fork() emulation, this can be supported in a limited"
NSQ_SOURCE_LINE 00004815 "fashion, but there are other very serious problems with that: all parent"
NSQ_SOURCE_LINE 00004816 "fds get dup()ed in to the thread emulating the forked process, and that"
NSQ_SOURCE_LINE 00004817 "keeps the parent from being able to close all of the appropriate fds."
NSQ_SOURCE_LINE 00004818 ""
NSQ_SOURCE_LINE 00004819 "=item no support for init => sub {} routines."
NSQ_SOURCE_LINE 00004820 ""
NSQ_SOURCE_LINE 00004821 "Win32 processes are created from scratch, there is no way to do an init"
NSQ_SOURCE_LINE 00004822 "routine that will affect the running child.  Some limited support might"
NSQ_SOURCE_LINE 00004823 "be implemented one day, do chdir() and %ENV changes can be made."
NSQ_SOURCE_LINE 00004824 ""
NSQ_SOURCE_LINE 00004825 "=item signals"
NSQ_SOURCE_LINE 00004826 ""
NSQ_SOURCE_LINE 00004827 "Win32 does not fully support signals.  signal() is likely to cause errors"
NSQ_SOURCE_LINE 00004828 "unless sending a signal that Perl emulates, and C<kill_kill()> is immediately"
NSQ_SOURCE_LINE 00004829 "fatal (there is no grace period)."
NSQ_SOURCE_LINE 00004830 ""
NSQ_SOURCE_LINE 00004831 "=item C<$?> cannot represent all Win32 exit codes"
NSQ_SOURCE_LINE 00004832 ""
NSQ_SOURCE_LINE 00004833 "Prefer C<full_result( ... )>, C<result( ... )>, or other IPC::Run methods."
NSQ_SOURCE_LINE 00004834 ""
NSQ_SOURCE_LINE 00004835 "=item helper processes"
NSQ_SOURCE_LINE 00004836 ""
NSQ_SOURCE_LINE 00004837 "IPC::Run uses helper processes, one per redirected file, to adapt between the"
NSQ_SOURCE_LINE 00004838 "anonymous pipe connected to the child and the TCP socket connected to the"
NSQ_SOURCE_LINE 00004839 "parent.  This is a waste of resources and will change in the future to either"
NSQ_SOURCE_LINE 00004840 "use threads (instead of helper processes) or a WaitForMultipleObjects call"
NSQ_SOURCE_LINE 00004841 "(instead of select).  Please contact me if you can help with the"
NSQ_SOURCE_LINE 00004842 "WaitForMultipleObjects() approach; I haven't figured out how to get at it"
NSQ_SOURCE_LINE 00004843 "without C code."
NSQ_SOURCE_LINE 00004844 ""
NSQ_SOURCE_LINE 00004845 "=item shutdown pause"
NSQ_SOURCE_LINE 00004846 ""
NSQ_SOURCE_LINE 00004847 "There seems to be a pause of up to 1 second between when a child program exits"
NSQ_SOURCE_LINE 00004848 "and the corresponding sockets indicate that they are closed in the parent."
NSQ_SOURCE_LINE 00004849 "Not sure why."
NSQ_SOURCE_LINE 00004850 ""
NSQ_SOURCE_LINE 00004851 "=item binmode"
NSQ_SOURCE_LINE 00004852 ""
NSQ_SOURCE_LINE 00004853 "binmode is not supported yet.  The underpinnings are implemented, just ask"
NSQ_SOURCE_LINE 00004854 "if you need it."
NSQ_SOURCE_LINE 00004855 ""
NSQ_SOURCE_LINE 00004856 "=item IPC::Run::IO"
NSQ_SOURCE_LINE 00004857 ""
NSQ_SOURCE_LINE 00004858 "IPC::Run::IO objects can be used on Unix to read or write arbitrary files.  On"
NSQ_SOURCE_LINE 00004859 "Win32, they will need to use the same helper processes to adapt from"
NSQ_SOURCE_LINE 00004860 "non-select()able filehandles to select()able ones (or perhaps"
NSQ_SOURCE_LINE 00004861 "WaitForMultipleObjects() will work with them, not sure)."
NSQ_SOURCE_LINE 00004862 ""
NSQ_SOURCE_LINE 00004863 "=item startup race conditions"
NSQ_SOURCE_LINE 00004864 ""
NSQ_SOURCE_LINE 00004865 "There seems to be an occasional race condition between child process startup"
NSQ_SOURCE_LINE 00004866 "and pipe closings.  It seems like if the child is not fully created by the time"
NSQ_SOURCE_LINE 00004867 "CreateProcess returns and we close the TCP socket being handed to it, the"
NSQ_SOURCE_LINE 00004868 "parent socket can also get closed.  This is seen with the Win32 pumper"
NSQ_SOURCE_LINE 00004869 "applications, not the \"real\" child process being spawned."
NSQ_SOURCE_LINE 00004870 ""
NSQ_SOURCE_LINE 00004871 "I assume this is because the kernel hasn't gotten around to incrementing the"
NSQ_SOURCE_LINE 00004872 "reference count on the child's end (since the child was slow in starting), so"
NSQ_SOURCE_LINE 00004873 "the parent's closing of the child end causes the socket to be closed, thus"
NSQ_SOURCE_LINE 00004874 "closing the parent socket."
NSQ_SOURCE_LINE 00004875 ""
NSQ_SOURCE_LINE 00004876 "Being a race condition, it's hard to reproduce, but I encountered it while"
NSQ_SOURCE_LINE 00004877 "testing this code on a drive share to a samba box.  In this case, it takes"
NSQ_SOURCE_LINE 00004878 "t/run.t a long time to spawn its child processes (the parent hangs in the"
NSQ_SOURCE_LINE 00004879 "first select for several seconds until the child emits any debugging output)."
NSQ_SOURCE_LINE 00004880 ""
NSQ_SOURCE_LINE 00004881 "I have not seen it on local drives, and can't reproduce it at will,"
NSQ_SOURCE_LINE 00004882 "unfortunately.  The symptom is a \"bad file descriptor in select()\" error, and,"
NSQ_SOURCE_LINE 00004883 "by turning on debugging, it's possible to see that select() is being called on"
NSQ_SOURCE_LINE 00004884 "a no longer open file descriptor that was returned from the _socket() routine"
NSQ_SOURCE_LINE 00004885 "in Win32Helper.  There's a new confess() that checks for this (\"PARENT_HANDLE"
NSQ_SOURCE_LINE 00004886 "no longer open\"), but I haven't been able to reproduce it (typically)."
NSQ_SOURCE_LINE 00004887 ""
NSQ_SOURCE_LINE 00004888 "=back"
NSQ_SOURCE_LINE 00004889 ""
NSQ_SOURCE_LINE 00004890 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00004891 ""
NSQ_SOURCE_LINE 00004892 "On Unix, requires a system that supports C<waitpid( $pid, WNOHANG )> so"
NSQ_SOURCE_LINE 00004893 "it can tell if a child process is still running."
NSQ_SOURCE_LINE 00004894 ""
NSQ_SOURCE_LINE 00004895 "PTYs don't seem to be non-blocking on some versions of Solaris. Here's a"
NSQ_SOURCE_LINE 00004896 "test script contributed by Borislav Deianov <borislav@ensim.com> to see"
NSQ_SOURCE_LINE 00004897 "if you have the problem.  If it dies, you have the problem."
NSQ_SOURCE_LINE 00004898 ""
NSQ_SOURCE_LINE 00004899 "   #!/usr/bin/perl"
NSQ_SOURCE_LINE 00004900 ""
NSQ_SOURCE_LINE 00004901 "   use IPC::Run qw(run);"
NSQ_SOURCE_LINE 00004902 "   use Fcntl;"
NSQ_SOURCE_LINE 00004903 "   use IO::Pty;"
NSQ_SOURCE_LINE 00004904 ""
NSQ_SOURCE_LINE 00004905 "   sub makecmd {"
NSQ_SOURCE_LINE 00004906 "       return ['perl', '-e', "
NSQ_SOURCE_LINE 00004907 "               '<STDIN>, print \"\\n\" x '.$_[0].'; while(<STDIN>){last if /end/}'];"
NSQ_SOURCE_LINE 00004908 "   }"
NSQ_SOURCE_LINE 00004909 ""
NSQ_SOURCE_LINE 00004910 "   #pipe R, W;"
NSQ_SOURCE_LINE 00004911 "   #fcntl(W, F_SETFL, O_NONBLOCK);"
NSQ_SOURCE_LINE 00004912 "   #while (syswrite(W, \"\\n\", 1)) { $pipebuf++ };"
NSQ_SOURCE_LINE 00004913 "   #print \"pipe buffer size is $pipebuf\\n\";"
NSQ_SOURCE_LINE 00004914 "   my $pipebuf=4096;"
NSQ_SOURCE_LINE 00004915 "   my $in = \"\\n\" x ($pipebuf * 2) . \"end\\n\";"
NSQ_SOURCE_LINE 00004916 "   my $out;"
NSQ_SOURCE_LINE 00004917 ""
NSQ_SOURCE_LINE 00004918 "   $SIG{ALRM} = sub { die \"Never completed!\\n\" };"
NSQ_SOURCE_LINE 00004919 ""
NSQ_SOURCE_LINE 00004920 "   print \"reading from scalar via pipe...\";"
NSQ_SOURCE_LINE 00004921 "   alarm( 2 );"
NSQ_SOURCE_LINE 00004922 "   run(makecmd($pipebuf * 2), '<', \\$in, '>', \\$out);"
NSQ_SOURCE_LINE 00004923 "   alarm( 0 );"
NSQ_SOURCE_LINE 00004924 "   print \"done\\n\";"
NSQ_SOURCE_LINE 00004925 ""
NSQ_SOURCE_LINE 00004926 "   print \"reading from code via pipe... \";"
NSQ_SOURCE_LINE 00004927 "   alarm( 2 );"
NSQ_SOURCE_LINE 00004928 "   run(makecmd($pipebuf * 3), '<', sub { $t = $in; undef $in; $t}, '>', \\$out);"
NSQ_SOURCE_LINE 00004929 "   alarm( 0 );"
NSQ_SOURCE_LINE 00004930 "   print \"done\\n\";"
NSQ_SOURCE_LINE 00004931 ""
NSQ_SOURCE_LINE 00004932 "   $pty = IO::Pty->new();"
NSQ_SOURCE_LINE 00004933 "   $pty->blocking(0);"
NSQ_SOURCE_LINE 00004934 "   $slave = $pty->slave();"
NSQ_SOURCE_LINE 00004935 "   while ($pty->syswrite(\"\\n\", 1)) { $ptybuf++ };"
NSQ_SOURCE_LINE 00004936 "   print \"pty buffer size is $ptybuf\\n\";"
NSQ_SOURCE_LINE 00004937 "   $in = \"\\n\" x ($ptybuf * 3) . \"end\\n\";"
NSQ_SOURCE_LINE 00004938 ""
NSQ_SOURCE_LINE 00004939 "   print \"reading via pty... \";"
NSQ_SOURCE_LINE 00004940 "   alarm( 2 );"
NSQ_SOURCE_LINE 00004941 "   run(makecmd($ptybuf * 3), '<pty<', \\$in, '>', \\$out);"
NSQ_SOURCE_LINE 00004942 "   alarm(0);"
NSQ_SOURCE_LINE 00004943 "   print \"done\\n\";"
NSQ_SOURCE_LINE 00004944 ""
NSQ_SOURCE_LINE 00004945 "IO::Pty version 1.21 and later added a C<DESTROY> method that automatically"
NSQ_SOURCE_LINE 00004946 "closes the cached slave pty handle when the master is destroyed.  IPC::Run"
NSQ_SOURCE_LINE 00004947 "works around this by detaching the slave before closing the master in the"
NSQ_SOURCE_LINE 00004948 "child process; no user action is required."
NSQ_SOURCE_LINE 00004949 ""
NSQ_SOURCE_LINE 00004950 "No support for ';', '&&', '||', '{ ... }', etc: use perl's, since run()"
NSQ_SOURCE_LINE 00004951 "returns TRUE when the command exits with a 0 result code."
NSQ_SOURCE_LINE 00004952 ""
NSQ_SOURCE_LINE 00004953 "Does not provide shell-like string interpolation."
NSQ_SOURCE_LINE 00004954 ""
NSQ_SOURCE_LINE 00004955 "No support for C<cd> or C<export>: do C<cd> in an init() sub."
NSQ_SOURCE_LINE 00004956 ""
NSQ_SOURCE_LINE 00004957 "For setting environment variables in the child process without affecting the"
NSQ_SOURCE_LINE 00004958 "parent, use the C<env> option (a hash reference of key/value pairs):"
NSQ_SOURCE_LINE 00004959 ""
NSQ_SOURCE_LINE 00004960 "   run("
NSQ_SOURCE_LINE 00004961 "      \\cmd,"
NSQ_SOURCE_LINE 00004962 "         ..."
NSQ_SOURCE_LINE 00004963 "         env => { FOO => 'BAR', BAZ => 'QUX' }"
NSQ_SOURCE_LINE 00004964 "   );"
NSQ_SOURCE_LINE 00004965 ""
NSQ_SOURCE_LINE 00004966 "The C<env> variables are applied in the child process before any C<init> subs"
NSQ_SOURCE_LINE 00004967 "run, so C<init> can still override individual variables if needed.  The parent"
NSQ_SOURCE_LINE 00004968 "process C<%ENV> is not modified."
NSQ_SOURCE_LINE 00004969 ""
NSQ_SOURCE_LINE 00004970 "Alternatively, use an C<init> sub for more complex setup:"
NSQ_SOURCE_LINE 00004971 ""
NSQ_SOURCE_LINE 00004972 "   run("
NSQ_SOURCE_LINE 00004973 "      \\cmd,"
NSQ_SOURCE_LINE 00004974 "         ..."
NSQ_SOURCE_LINE 00004975 "         init => sub {"
NSQ_SOURCE_LINE 00004976 "            chdir $dir or die $!;"
NSQ_SOURCE_LINE 00004977 "            $ENV{FOO}='BAR'"
NSQ_SOURCE_LINE 00004978 "         }"
NSQ_SOURCE_LINE 00004979 "   );"
NSQ_SOURCE_LINE 00004980 ""
NSQ_SOURCE_LINE 00004981 "Timeout calculation does not allow absolute times, or specification of"
NSQ_SOURCE_LINE 00004982 "days, months, etc."
NSQ_SOURCE_LINE 00004983 ""
NSQ_SOURCE_LINE 00004984 "B<WARNING:> Function coprocesses (C<run \\&foo, ...>) suffer from two"
NSQ_SOURCE_LINE 00004985 "limitations.  The first is that it is difficult to close all filehandles the"
NSQ_SOURCE_LINE 00004986 "child inherits from the parent, since there is no way to scan all open"
NSQ_SOURCE_LINE 00004987 "FILEHANDLEs in Perl and it is both painful and a bit dangerous to close all open"
NSQ_SOURCE_LINE 00004988 "file descriptors with C<POSIX::close()>. Painful because we can't tell which"
NSQ_SOURCE_LINE 00004989 "fds are open at the POSIX level, either, so we'd have to scan all possible fds"
NSQ_SOURCE_LINE 00004990 "and close any that we don't want open (normally C<exec()> closes any"
NSQ_SOURCE_LINE 00004991 "non-inheritable but we don't C<exec()> for &sub processes)."
NSQ_SOURCE_LINE 00004992 ""
NSQ_SOURCE_LINE 00004993 "The second problem is that Perl's DESTROY subs and other on-exit cleanup gets"
NSQ_SOURCE_LINE 00004994 "run in the child process.  If objects are instantiated in the parent before the"
NSQ_SOURCE_LINE 00004995 "child is forked, the DESTROY will get run once in the parent and once in"
NSQ_SOURCE_LINE 00004996 "the child.  When coprocess subs exit, POSIX::_exit is called to work around this,"
NSQ_SOURCE_LINE 00004997 "but it means that objects that are still referred to at that time are not"
NSQ_SOURCE_LINE 00004998 "cleaned up.  So setting package vars or closure vars to point to objects that"
NSQ_SOURCE_LINE 00004999 "rely on DESTROY to affect things outside the process (files, etc), will"
NSQ_SOURCE_LINE 00005000 "lead to bugs."
NSQ_SOURCE_LINE 00005001 ""
NSQ_SOURCE_LINE 00005002 "I goofed on the syntax: \"<pipe\" vs. \"<pty<\" and \">filename\" are both"
NSQ_SOURCE_LINE 00005003 "oddities."
NSQ_SOURCE_LINE 00005004 ""
NSQ_SOURCE_LINE 00005005 "=head1 TODO"
NSQ_SOURCE_LINE 00005006 ""
NSQ_SOURCE_LINE 00005007 "=over"
NSQ_SOURCE_LINE 00005008 ""
NSQ_SOURCE_LINE 00005009 "=item Allow one harness to \"adopt\" another:"
NSQ_SOURCE_LINE 00005010 ""
NSQ_SOURCE_LINE 00005011 "   $new_h = harness \\@cmd2;"
NSQ_SOURCE_LINE 00005012 "   $h->adopt( $new_h );"
NSQ_SOURCE_LINE 00005013 ""
NSQ_SOURCE_LINE 00005014 "=item Close all filehandles not explicitly marked to stay open."
NSQ_SOURCE_LINE 00005015 ""
NSQ_SOURCE_LINE 00005016 "The problem with this one is that there's no good way to scan all open"
NSQ_SOURCE_LINE 00005017 "FILEHANDLEs in Perl, yet you don't want child processes inheriting handles"
NSQ_SOURCE_LINE 00005018 "willy-nilly."
NSQ_SOURCE_LINE 00005019 ""
NSQ_SOURCE_LINE 00005020 "=back"
NSQ_SOURCE_LINE 00005021 ""
NSQ_SOURCE_LINE 00005022 "=head1 INSPIRATION"
NSQ_SOURCE_LINE 00005023 ""
NSQ_SOURCE_LINE 00005024 "Well, select() and waitpid() badly needed wrapping, and open3() isn't"
NSQ_SOURCE_LINE 00005025 "open-minded enough for me."
NSQ_SOURCE_LINE 00005026 ""
NSQ_SOURCE_LINE 00005027 "The shell-like API inspired by a message Russ Allbery sent to perl5-porters,"
NSQ_SOURCE_LINE 00005028 "which included:"
NSQ_SOURCE_LINE 00005029 ""
NSQ_SOURCE_LINE 00005030 "   I've thought for some time that it would be"
NSQ_SOURCE_LINE 00005031 "   nice to have a module that could handle full Bourne shell pipe syntax"
NSQ_SOURCE_LINE 00005032 "   internally, with fork and exec, without ever invoking a shell.  Something"
NSQ_SOURCE_LINE 00005033 "   that you could give things like:"
NSQ_SOURCE_LINE 00005034 ""
NSQ_SOURCE_LINE 00005035 "   pipeopen (PIPE, [ qw/cat file/ ], '|', [ 'analyze', @args ], '>&3');"
NSQ_SOURCE_LINE 00005036 ""
NSQ_SOURCE_LINE 00005037 "Message ylln51p2b6.fsf@windlord.stanford.edu, on 2000/02/04."
NSQ_SOURCE_LINE 00005038 ""
NSQ_SOURCE_LINE 00005039 "=head1 SUPPORT"
