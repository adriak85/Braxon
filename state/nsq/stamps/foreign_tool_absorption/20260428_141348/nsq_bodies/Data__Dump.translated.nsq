NSQ_SOURCE_LINE 00000098 "sub _dump"
NSQ_SOURCE_LINE 00000099 "{"
NSQ_SOURCE_LINE 00000100 "    my $ref  = ref $_[0];"
NSQ_SOURCE_LINE 00000101 "    my $rval = $ref ? $_[0] : \\$_[0];"
NSQ_SOURCE_LINE 00000102 "    shift;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    my($name, $idx, $dont_remember, $pclass, $pidx) = @_;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    my($class, $type, $id);"
NSQ_SOURCE_LINE 00000107 "    my $strval = overload::StrVal($rval);"
NSQ_SOURCE_LINE 00000108 "    # Parse $strval without using regexps, in order not to clobber $1, $2,..."
NSQ_SOURCE_LINE 00000109 "    if ((my $i = rindex($strval, \"=\")) >= 0) {"
NSQ_SOURCE_LINE 00000110 "\t$class = substr($strval, 0, $i);"
NSQ_SOURCE_LINE 00000111 "\t$strval = substr($strval, $i+1);"
NSQ_SOURCE_LINE 00000112 "    }"
NSQ_SOURCE_LINE 00000113 "    if ((my $i = index($strval, \"(0x\")) >= 0) {"
NSQ_SOURCE_LINE 00000114 "\t$type = substr($strval, 0, $i);"
NSQ_SOURCE_LINE 00000115 "\t$id = substr($strval, $i + 2, -1);"
NSQ_SOURCE_LINE 00000116 "    }"
NSQ_SOURCE_LINE 00000117 "    else {"
NSQ_SOURCE_LINE 00000118 "\tdie \"Can't parse \" . overload::StrVal($rval);"
NSQ_SOURCE_LINE 00000119 "    }"
NSQ_SOURCE_LINE 00000120 "    if ($] < 5.008 && $type eq \"SCALAR\") {"
NSQ_SOURCE_LINE 00000121 "\t$type = \"REF\" if $ref eq \"REF\";"
NSQ_SOURCE_LINE 00000122 "    }"
NSQ_SOURCE_LINE 00000123 "    warn \"\\$$name(@$idx) $class $type $id ($ref)\" if $DEBUG;"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "    my $out;"
NSQ_SOURCE_LINE 00000126 "    my $comment;"
NSQ_SOURCE_LINE 00000127 "    my $hide_keys;"
NSQ_SOURCE_LINE 00000128 "    if (@FILTERS) {"
NSQ_SOURCE_LINE 00000129 "\tmy $pself = \"\";"
NSQ_SOURCE_LINE 00000130 "\t$pself = fullname(\"self\", [@$idx[$pidx..(@$idx - 1)]]) if $pclass;"
NSQ_SOURCE_LINE 00000131 "\tmy $ctx = Data::Dump::FilterContext->new($rval, $class, $type, $ref, $pclass, $pidx, $idx);"
NSQ_SOURCE_LINE 00000132 "\tmy @bless;"
NSQ_SOURCE_LINE 00000133 "\tfor my $filter (@FILTERS) {"
NSQ_SOURCE_LINE 00000134 "\t    if (my $f = $filter->($ctx, $rval)) {"
NSQ_SOURCE_LINE 00000135 "\t\tif (my $v = $f->{object}) {"
NSQ_SOURCE_LINE 00000136 "\t\t    local @FILTERS;"
NSQ_SOURCE_LINE 00000137 "\t\t    $out = _dump($v, $name, $idx, 1);"
NSQ_SOURCE_LINE 00000138 "\t\t    $dont_remember++;"
NSQ_SOURCE_LINE 00000139 "\t\t}"
NSQ_SOURCE_LINE 00000140 "\t\tif (defined(my $c = $f->{bless})) {"
NSQ_SOURCE_LINE 00000141 "\t\t    push(@bless, $c);"
NSQ_SOURCE_LINE 00000142 "\t\t}"
NSQ_SOURCE_LINE 00000143 "\t\tif (my $c = $f->{comment}) {"
NSQ_SOURCE_LINE 00000144 "\t\t    $comment = $c;"
NSQ_SOURCE_LINE 00000145 "\t\t}"
NSQ_SOURCE_LINE 00000146 "\t\tif (defined(my $c = $f->{dump})) {"
NSQ_SOURCE_LINE 00000147 "\t\t    $out = $c;"
NSQ_SOURCE_LINE 00000148 "\t\t    $dont_remember++;"
NSQ_SOURCE_LINE 00000149 "\t\t}"
NSQ_SOURCE_LINE 00000150 "\t\tif (my $h = $f->{hide_keys}) {"
NSQ_SOURCE_LINE 00000151 "\t\t    if (ref($h) eq \"ARRAY\") {"
NSQ_SOURCE_LINE 00000152 "\t\t\t$hide_keys = sub {"
NSQ_SOURCE_LINE 00000153 "\t\t\t    for my $k (@$h) {"
NSQ_SOURCE_LINE 00000154 "\t\t\t\treturn 1 if $k eq $_[0];"
NSQ_SOURCE_LINE 00000155 "\t\t\t    }"
NSQ_SOURCE_LINE 00000156 "\t\t\t    return 0;"
NSQ_SOURCE_LINE 00000157 "\t\t\t};"
NSQ_SOURCE_LINE 00000158 "\t\t    }"
NSQ_SOURCE_LINE 00000159 "\t\t}"
NSQ_SOURCE_LINE 00000160 "\t    }"
NSQ_SOURCE_LINE 00000161 "\t}"
NSQ_SOURCE_LINE 00000162 "\tpush(@bless, \"\") if defined($out) && !@bless;"
NSQ_SOURCE_LINE 00000163 "\tif (@bless) {"
NSQ_SOURCE_LINE 00000164 "\t    $class = shift(@bless);"
NSQ_SOURCE_LINE 00000165 "\t    warn \"More than one filter callback tried to bless object\" if @bless;"
NSQ_SOURCE_LINE 00000166 "\t}"
NSQ_SOURCE_LINE 00000167 "    }"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    unless ($dont_remember) {"
NSQ_SOURCE_LINE 00000170 "\tif (my $s = $seen{$id}) {"
NSQ_SOURCE_LINE 00000171 "\t    my($sname, $sidx) = @$s;"
NSQ_SOURCE_LINE 00000172 "\t    $refcnt{$sname}++;"
NSQ_SOURCE_LINE 00000173 "\t    my $sref = fullname($sname, $sidx,"
NSQ_SOURCE_LINE 00000174 "\t\t\t\t($ref && $type eq \"SCALAR\"));"
NSQ_SOURCE_LINE 00000175 "\t    warn \"SEEN: [\\$$name(@$idx)] => [\\$$sname(@$sidx)] ($ref,$sref)\" if $DEBUG;"
NSQ_SOURCE_LINE 00000176 "\t    return $sref unless $sname eq $name;"
NSQ_SOURCE_LINE 00000177 "\t    $refcnt{$name}++;"
NSQ_SOURCE_LINE 00000178 "\t    push(@fixup, fullname($name,$idx).\" = $sref\");"
NSQ_SOURCE_LINE 00000179 "\t    return \"do{my \\$fix}\" if @$idx && $idx->[-1] eq '$';"
NSQ_SOURCE_LINE 00000180 "\t    return \"'fix'\";"
NSQ_SOURCE_LINE 00000181 "\t}"
NSQ_SOURCE_LINE 00000182 "\t$seen{$id} = [$name, $idx];"
NSQ_SOURCE_LINE 00000183 "    }"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "    if ($class) {"
NSQ_SOURCE_LINE 00000186 "\t$pclass = $class;"
NSQ_SOURCE_LINE 00000187 "\t$pidx = @$idx;"
NSQ_SOURCE_LINE 00000188 "    }"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    if (defined $out) {"
NSQ_SOURCE_LINE 00000191 "\t# keep it"
NSQ_SOURCE_LINE 00000192 "    }"
NSQ_SOURCE_LINE 00000193 "    elsif ($type eq \"SCALAR\" || $type eq \"REF\" || $type eq \"REGEXP\") {"
NSQ_SOURCE_LINE 00000194 "\tif ($ref) {"
NSQ_SOURCE_LINE 00000195 "\t    if ($class && $class eq \"Regexp\") {"
NSQ_SOURCE_LINE 00000196 "\t\tmy $v = \"$rval\";"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "\t\tmy $mod = \"\";"
NSQ_SOURCE_LINE 00000199 "\t\tif ($v =~ /^\\(\\?\\^?([msix-]*):([\\x00-\\xFF]*)\\)\\z/) {"
NSQ_SOURCE_LINE 00000200 "\t\t    $mod = $1;"
NSQ_SOURCE_LINE 00000201 "\t\t    $v = $2;"
NSQ_SOURCE_LINE 00000202 "\t\t    $mod =~ s/-.*//;"
NSQ_SOURCE_LINE 00000203 "\t\t}"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "\t\tmy $sep = '/';"
NSQ_SOURCE_LINE 00000206 "\t\tmy $sep_count = ($v =~ tr/\\///);"
NSQ_SOURCE_LINE 00000207 "\t\tif ($sep_count) {"
NSQ_SOURCE_LINE 00000208 "\t\t    # see if we can find a better one"
NSQ_SOURCE_LINE 00000209 "\t\t    for ('|', ',', ':', '#') {"
NSQ_SOURCE_LINE 00000210 "\t\t\tmy $c = eval \"\\$v =~ tr/\\Q$_\\E//\";"
NSQ_SOURCE_LINE 00000211 "\t\t\t#print \"SEP $_ $c $sep_count\\n\";"
NSQ_SOURCE_LINE 00000212 "\t\t\tif ($c < $sep_count) {"
NSQ_SOURCE_LINE 00000213 "\t\t\t    $sep = $_;"
NSQ_SOURCE_LINE 00000214 "\t\t\t    $sep_count = $c;"
NSQ_SOURCE_LINE 00000215 "\t\t\t    last if $sep_count == 0;"
NSQ_SOURCE_LINE 00000216 "\t\t\t}"
NSQ_SOURCE_LINE 00000217 "\t\t    }"
NSQ_SOURCE_LINE 00000218 "\t\t}"
NSQ_SOURCE_LINE 00000219 "\t\t$v =~ s/\\Q$sep\\E/\\\\$sep/g;"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "\t\t$out = \"qr$sep$v$sep$mod\";"
NSQ_SOURCE_LINE 00000222 "\t\tundef($class);"
NSQ_SOURCE_LINE 00000223 "\t    }"
NSQ_SOURCE_LINE 00000224 "\t    else {"
NSQ_SOURCE_LINE 00000225 "\t\tdelete $seen{$id} if $type eq \"SCALAR\";  # will be seen again shortly"
NSQ_SOURCE_LINE 00000226 "\t\tmy $val = _dump($$rval, $name, [@$idx, \"\\$\"], 0, $pclass, $pidx);"
NSQ_SOURCE_LINE 00000227 "\t\t$out = $class ? \"do{\\\\(my \\$o = $val)}\" : \"\\\\$val\";"
NSQ_SOURCE_LINE 00000228 "\t    }"
NSQ_SOURCE_LINE 00000229 "\t} else {"
NSQ_SOURCE_LINE 00000230 "\t    if (!defined $$rval) {"
NSQ_SOURCE_LINE 00000231 "\t\t$out = \"undef\";"
NSQ_SOURCE_LINE 00000232 "\t    }"
NSQ_SOURCE_LINE 00000233 "\t    elsif ($$rval =~ /^-?(?:nan|inf)/i) {"
NSQ_SOURCE_LINE 00000234 "\t\t$out = str($$rval);"
NSQ_SOURCE_LINE 00000235 "\t    }"
NSQ_SOURCE_LINE 00000236 "\t    elsif (do {no warnings 'numeric'; $$rval + 0 eq $$rval}) {"
NSQ_SOURCE_LINE 00000237 "\t\t$out = $$rval;"
NSQ_SOURCE_LINE 00000238 "\t    }"
NSQ_SOURCE_LINE 00000239 "\t    else {"
NSQ_SOURCE_LINE 00000240 "\t\t$out = str($$rval);"
NSQ_SOURCE_LINE 00000241 "\t    }"
NSQ_SOURCE_LINE 00000242 "\t    if ($class && !@$idx) {"
NSQ_SOURCE_LINE 00000243 "\t\t# Top is an object, not a reference to one as perl needs"
NSQ_SOURCE_LINE 00000244 "\t\t$refcnt{$name}++;"
NSQ_SOURCE_LINE 00000245 "\t\tmy $obj = fullname($name, $idx);"
NSQ_SOURCE_LINE 00000246 "\t\tmy $cl  = quote($class);"
NSQ_SOURCE_LINE 00000247 "\t\tpush(@fixup, \"bless \\\\$obj, $cl\");"
NSQ_SOURCE_LINE 00000248 "\t    }"
NSQ_SOURCE_LINE 00000249 "\t}"
NSQ_SOURCE_LINE 00000250 "    }"
NSQ_SOURCE_LINE 00000251 "    elsif ($type eq \"GLOB\") {"
NSQ_SOURCE_LINE 00000252 "\tif ($ref) {"
NSQ_SOURCE_LINE 00000253 "\t    delete $seen{$id};"
NSQ_SOURCE_LINE 00000254 "\t    my $val = _dump($$rval, $name, [@$idx, \"*\"], 0, $pclass, $pidx);"
NSQ_SOURCE_LINE 00000255 "\t    $out = \"\\\\$val\";"
NSQ_SOURCE_LINE 00000256 "\t    if ($out =~ /^\\\\\\*Symbol::/) {"
NSQ_SOURCE_LINE 00000257 "\t\t$require{Symbol}++;"
NSQ_SOURCE_LINE 00000258 "\t\t$out = \"Symbol::gensym()\";"
NSQ_SOURCE_LINE 00000259 "\t    }"
NSQ_SOURCE_LINE 00000260 "\t} else {"
NSQ_SOURCE_LINE 00000261 "\t    my $val = \"$$rval\";"
NSQ_SOURCE_LINE 00000262 "\t    $out = \"$$rval\";"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "\t    for my $k (qw(SCALAR ARRAY HASH)) {"
NSQ_SOURCE_LINE 00000265 "\t\tmy $gval = *$$rval{$k};"
NSQ_SOURCE_LINE 00000266 "\t\tnext unless defined $gval;"
NSQ_SOURCE_LINE 00000267 "\t\tnext if $k eq \"SCALAR\" && ! defined $$gval;  # always there"
NSQ_SOURCE_LINE 00000268 "\t\tmy $f = scalar @fixup;"
NSQ_SOURCE_LINE 00000269 "\t\tpush(@fixup, \"RESERVED\");  # overwritten after _dump() below"
NSQ_SOURCE_LINE 00000270 "\t\t$gval = _dump($gval, $name, [@$idx, \"*{$k}\"], 0, $pclass, $pidx);"
NSQ_SOURCE_LINE 00000271 "\t\t$refcnt{$name}++;"
NSQ_SOURCE_LINE 00000272 "\t\tmy $gname = fullname($name, $idx);"
NSQ_SOURCE_LINE 00000273 "\t\t$fixup[$f] = \"$gname = $gval\";  #XXX indent $gval"
NSQ_SOURCE_LINE 00000274 "\t    }"
NSQ_SOURCE_LINE 00000275 "\t}"
NSQ_SOURCE_LINE 00000276 "    }"
NSQ_SOURCE_LINE 00000277 "    elsif ($type eq \"ARRAY\") {"
NSQ_SOURCE_LINE 00000278 "\tmy @vals;"
NSQ_SOURCE_LINE 00000279 "\tmy $tied = tied_str(tied(@$rval));"
NSQ_SOURCE_LINE 00000280 "\tmy $i = 0;"
NSQ_SOURCE_LINE 00000281 "\tfor my $v (@$rval) {"
NSQ_SOURCE_LINE 00000282 "\t    push(@vals, _dump($v, $name, [@$idx, \"[$i]\"], $tied, $pclass, $pidx));"
NSQ_SOURCE_LINE 00000283 "\t    $i++;"
NSQ_SOURCE_LINE 00000284 "\t}"
NSQ_SOURCE_LINE 00000285 "\t$out = \"[\" . format_list(1, $tied, @vals) . \"]\";"
NSQ_SOURCE_LINE 00000286 "    }"
NSQ_SOURCE_LINE 00000287 "    elsif ($type eq \"HASH\") {"
NSQ_SOURCE_LINE 00000288 "\tmy(@keys, @vals);"
NSQ_SOURCE_LINE 00000289 "\tmy $tied = tied_str(tied(%$rval));"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "\t# statistics to determine variation in key lengths"
NSQ_SOURCE_LINE 00000292 "\tmy $kstat_max = 0;"
NSQ_SOURCE_LINE 00000293 "\tmy $kstat_sum = 0;"
NSQ_SOURCE_LINE 00000294 "\tmy $kstat_sum2 = 0;"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "\tmy @orig_keys = keys %$rval;"
NSQ_SOURCE_LINE 00000297 "\tif ($hide_keys) {"
NSQ_SOURCE_LINE 00000298 "\t    @orig_keys = grep !$hide_keys->($_), @orig_keys;"
NSQ_SOURCE_LINE 00000299 "\t}"
NSQ_SOURCE_LINE 00000300 "\tmy $text_keys = 0;"
NSQ_SOURCE_LINE 00000301 "\tfor (@orig_keys) {"
NSQ_SOURCE_LINE 00000302 "\t    $text_keys++, last unless /^[-+]?(?:0|[1-9]\\d*)(?:\\.\\d+)?\\z/;"
NSQ_SOURCE_LINE 00000303 "\t}"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "\tif ($text_keys) {"
NSQ_SOURCE_LINE 00000306 "\t    @orig_keys = sort { lc($a) cmp lc($b) } @orig_keys;"
NSQ_SOURCE_LINE 00000307 "\t}"
NSQ_SOURCE_LINE 00000308 "\telse {"
NSQ_SOURCE_LINE 00000309 "\t    @orig_keys = sort { $a <=> $b } @orig_keys;"
NSQ_SOURCE_LINE 00000310 "\t}"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "\tmy $quote;"
NSQ_SOURCE_LINE 00000313 "\tfor my $key (@orig_keys) {"
NSQ_SOURCE_LINE 00000314 "\t    next if $key =~ /^-?[a-zA-Z_]\\w*\\z/;"
NSQ_SOURCE_LINE 00000315 "\t    next if $key =~ /^-?[1-9]\\d{0,8}\\z/;"
NSQ_SOURCE_LINE 00000316 "\t    $quote++;"
NSQ_SOURCE_LINE 00000317 "\t    last;"
NSQ_SOURCE_LINE 00000318 "\t}"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "\tfor my $key (@orig_keys) {"
NSQ_SOURCE_LINE 00000321 "\t    my $val = \\$rval->{$key};  # capture value before we modify $key"
NSQ_SOURCE_LINE 00000322 "\t    $key = quote($key) if $quote;"
NSQ_SOURCE_LINE 00000323 "\t    $kstat_max = length($key) if length($key) > $kstat_max;"
NSQ_SOURCE_LINE 00000324 "\t    $kstat_sum += length($key);"
NSQ_SOURCE_LINE 00000325 "\t    $kstat_sum2 += length($key)*length($key);"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "\t    push(@keys, $key);"
NSQ_SOURCE_LINE 00000328 "\t    push(@vals, _dump($$val, $name, [@$idx, \"{$key}\"], $tied, $pclass, $pidx));"
NSQ_SOURCE_LINE 00000329 "\t}"
NSQ_SOURCE_LINE 00000330 "\tmy $nl = \"\";"
NSQ_SOURCE_LINE 00000331 "\tmy $klen_pad = 0;"
NSQ_SOURCE_LINE 00000332 "\tmy $tmp = \"@keys @vals\";"
NSQ_SOURCE_LINE 00000333 "\tif (length($tmp) > $LINEWIDTH || $tmp =~ /\\n/ || $tied) {"
NSQ_SOURCE_LINE 00000334 "\t    $nl = \"\\n\";"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "\t    # Determine what padding to add"
NSQ_SOURCE_LINE 00000337 "\t    if ($kstat_max < 4) {"
NSQ_SOURCE_LINE 00000338 "\t\t$klen_pad = $kstat_max;"
NSQ_SOURCE_LINE 00000339 "\t    }"
NSQ_SOURCE_LINE 00000340 "\t    elsif (@keys >= 2) {"
NSQ_SOURCE_LINE 00000341 "\t\tmy $n = @keys;"
NSQ_SOURCE_LINE 00000342 "\t\tmy $avg = $kstat_sum/$n;"
NSQ_SOURCE_LINE 00000343 "\t\tmy $stddev = sqrt(($kstat_sum2 - $n * $avg * $avg) / ($n - 1));"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "\t\t# I am not actually very happy with this heuristics"
NSQ_SOURCE_LINE 00000346 "\t\tif ($stddev / $kstat_max < 0.25) {"
NSQ_SOURCE_LINE 00000347 "\t\t    $klen_pad = $kstat_max;"
NSQ_SOURCE_LINE 00000348 "\t\t}"
NSQ_SOURCE_LINE 00000349 "\t\tif ($DEBUG) {"
NSQ_SOURCE_LINE 00000350 "\t\t    push(@keys, \"__S\");"
NSQ_SOURCE_LINE 00000351 "\t\t    push(@vals, sprintf(\"%.2f (%d/%.1f/%.1f)\","
NSQ_SOURCE_LINE 00000352 "\t\t\t\t\t$stddev / $kstat_max,"
NSQ_SOURCE_LINE 00000353 "\t\t\t\t\t$kstat_max, $avg, $stddev));"
NSQ_SOURCE_LINE 00000354 "\t\t}"
NSQ_SOURCE_LINE 00000355 "\t    }"
NSQ_SOURCE_LINE 00000356 "\t}"
NSQ_SOURCE_LINE 00000357 "\t$out = \"{$nl\";"
NSQ_SOURCE_LINE 00000358 "\t$out .= \"$INDENT# $tied$nl\" if $tied;"
NSQ_SOURCE_LINE 00000359 "\twhile (@keys) {"
NSQ_SOURCE_LINE 00000360 "\t    my $key = shift @keys;"
NSQ_SOURCE_LINE 00000361 "\t    my $val = shift @vals;"
NSQ_SOURCE_LINE 00000362 "\t    my $vpad = $INDENT . (\" \" x ($klen_pad ? $klen_pad + 4 : 0));"
NSQ_SOURCE_LINE 00000363 "\t    $val =~ s/\\n/\\n$vpad/gm;"
NSQ_SOURCE_LINE 00000364 "\t    my $kpad = $nl ? $INDENT : \" \";"
NSQ_SOURCE_LINE 00000365 "\t    $key .= \" \" x ($klen_pad - length($key)) if $nl && $klen_pad > length($key);"
NSQ_SOURCE_LINE 00000366 "\t    $out .= \"$kpad$key => $val,$nl\";"
NSQ_SOURCE_LINE 00000367 "\t}"
NSQ_SOURCE_LINE 00000368 "\t$out =~ s/,$/ / unless $nl;"
NSQ_SOURCE_LINE 00000369 "\t$out .= \"}\";"
NSQ_SOURCE_LINE 00000370 "    }"
NSQ_SOURCE_LINE 00000371 "    elsif ($type eq \"CODE\") {"
NSQ_SOURCE_LINE 00000372 "\t$out = 'sub { ... }';"
NSQ_SOURCE_LINE 00000373 "    }"
NSQ_SOURCE_LINE 00000374 "    elsif ($type eq \"VSTRING\") {"
NSQ_SOURCE_LINE 00000375 "        $out = sprintf +($ref ? '\\v%vd' : 'v%vd'), $$rval;"
NSQ_SOURCE_LINE 00000376 "    }"
NSQ_SOURCE_LINE 00000377 "    else {"
NSQ_SOURCE_LINE 00000378 "\twarn \"Can't handle $type data\";"
NSQ_SOURCE_LINE 00000379 "\t$out = \"'#$type#'\";"
NSQ_SOURCE_LINE 00000380 "    }"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "    if ($class && $ref) {"
NSQ_SOURCE_LINE 00000383 "\t$out = \"bless($out, \" . quote($class) . \")\";"
NSQ_SOURCE_LINE 00000384 "    }"
NSQ_SOURCE_LINE 00000385 "    if ($comment) {"
NSQ_SOURCE_LINE 00000386 "\t$comment =~ s/^/# /gm;"
NSQ_SOURCE_LINE 00000387 "\t$comment .= \"\\n\" unless $comment =~ /\\n\\z/;"
NSQ_SOURCE_LINE 00000388 "\t$comment =~ s/^#[ \\t]+\\n/\\n/;"
NSQ_SOURCE_LINE 00000389 "\t$out = \"$comment$out\";"
NSQ_SOURCE_LINE 00000390 "    }"
NSQ_SOURCE_LINE 00000391 "    return $out;"
NSQ_SOURCE_LINE 00000392 "}"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "sub tied_str {"
NSQ_SOURCE_LINE 00000395 "    my $tied = shift;"
NSQ_SOURCE_LINE 00000396 "    if ($tied) {"
NSQ_SOURCE_LINE 00000397 "\tif (my $tied_ref = ref($tied)) {"
NSQ_SOURCE_LINE 00000398 "\t    $tied = \"tied $tied_ref\";"
NSQ_SOURCE_LINE 00000399 "\t}"
NSQ_SOURCE_LINE 00000400 "\telse {"
NSQ_SOURCE_LINE 00000401 "\t    $tied = \"tied\";"
NSQ_SOURCE_LINE 00000402 "\t}"
NSQ_SOURCE_LINE 00000403 "    }"
NSQ_SOURCE_LINE 00000404 "    return $tied;"
NSQ_SOURCE_LINE 00000405 "}"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "sub fullname"
NSQ_SOURCE_LINE 00000408 "{"
NSQ_SOURCE_LINE 00000409 "    my($name, $idx, $ref) = @_;"
NSQ_SOURCE_LINE 00000410 "    substr($name, 0, 0) = \"\\$\";"
NSQ_SOURCE_LINE 00000411 ""
NSQ_SOURCE_LINE 00000412 "    my @i = @$idx;  # need copy in order to not modify @$idx"
NSQ_SOURCE_LINE 00000413 "    if ($ref && @i && $i[0] eq \"\\$\") {"
NSQ_SOURCE_LINE 00000414 "\tshift(@i);  # remove one deref"
NSQ_SOURCE_LINE 00000415 "\t$ref = 0;"
NSQ_SOURCE_LINE 00000416 "    }"
NSQ_SOURCE_LINE 00000417 "    while (@i && $i[0] eq \"\\$\") {"
NSQ_SOURCE_LINE 00000418 "\tshift @i;"
NSQ_SOURCE_LINE 00000419 "\t$name = \"\\$$name\";"
NSQ_SOURCE_LINE 00000420 "    }"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "    my $last_was_index;"
NSQ_SOURCE_LINE 00000423 "    for my $i (@i) {"
NSQ_SOURCE_LINE 00000424 "\tif ($i eq \"*\" || $i eq \"\\$\") {"
NSQ_SOURCE_LINE 00000425 "\t    $last_was_index = 0;"
NSQ_SOURCE_LINE 00000426 "\t    $name = \"$i\\{$name}\";"
NSQ_SOURCE_LINE 00000427 "\t} elsif ($i =~ s/^\\*//) {"
NSQ_SOURCE_LINE 00000428 "\t    $name .= $i;"
NSQ_SOURCE_LINE 00000429 "\t    $last_was_index++;"
NSQ_SOURCE_LINE 00000430 "\t} else {"
NSQ_SOURCE_LINE 00000431 "\t    $name .= \"->\" unless $last_was_index++;"
NSQ_SOURCE_LINE 00000432 "\t    $name .= $i;"
NSQ_SOURCE_LINE 00000433 "\t}"
NSQ_SOURCE_LINE 00000434 "    }"
NSQ_SOURCE_LINE 00000435 "    $name = \"\\\\$name\" if $ref;"
NSQ_SOURCE_LINE 00000436 "    $name;"
NSQ_SOURCE_LINE 00000437 "}"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "sub format_list"
NSQ_SOURCE_LINE 00000440 "{"
NSQ_SOURCE_LINE 00000441 "    my $paren = shift;"
NSQ_SOURCE_LINE 00000442 "    my $comment = shift;"
NSQ_SOURCE_LINE 00000443 "    my $indent_lim = $paren ? 0 : 1;"
NSQ_SOURCE_LINE 00000444 "    if (@_ > 3) {"
NSQ_SOURCE_LINE 00000445 "\t# can we use range operator to shorten the list?"
NSQ_SOURCE_LINE 00000446 "\tmy $i = 0;"
NSQ_SOURCE_LINE 00000447 "\twhile ($i < @_) {"
NSQ_SOURCE_LINE 00000448 "\t    my $j = $i + 1;"
NSQ_SOURCE_LINE 00000449 "\t    my $v = $_[$i];"
NSQ_SOURCE_LINE 00000450 "\t    while ($j < @_) {"
NSQ_SOURCE_LINE 00000451 "\t\t# XXX allow string increment too?"
NSQ_SOURCE_LINE 00000452 "\t\tif ($v eq \"0\" || $v =~ /^-?[1-9]\\d{0,9}\\z/) {"
NSQ_SOURCE_LINE 00000453 "\t\t    $v++;"
NSQ_SOURCE_LINE 00000454 "\t\t}"
NSQ_SOURCE_LINE 00000455 "\t\telsif ($v =~ /^\"([A-Za-z]{1,3}\\d*)\"\\z/) {"
NSQ_SOURCE_LINE 00000456 "\t\t    $v = $1;"
NSQ_SOURCE_LINE 00000457 "\t\t    $v++;"
NSQ_SOURCE_LINE 00000458 "\t\t    $v = qq(\"$v\");"
NSQ_SOURCE_LINE 00000459 "\t\t}"
NSQ_SOURCE_LINE 00000460 "\t\telse {"
NSQ_SOURCE_LINE 00000461 "\t\t    last;"
NSQ_SOURCE_LINE 00000462 "\t\t}"
NSQ_SOURCE_LINE 00000463 "\t\tlast if $_[$j] ne $v;"
NSQ_SOURCE_LINE 00000464 "\t\t$j++;"
NSQ_SOURCE_LINE 00000465 "\t    }"
NSQ_SOURCE_LINE 00000466 "\t    if ($j - $i > 3) {"
NSQ_SOURCE_LINE 00000467 "\t\tsplice(@_, $i, $j - $i, \"$_[$i] .. $_[$j-1]\");"
NSQ_SOURCE_LINE 00000468 "\t    }"
NSQ_SOURCE_LINE 00000469 "\t    $i++;"
NSQ_SOURCE_LINE 00000470 "\t}"
NSQ_SOURCE_LINE 00000471 "    }"
NSQ_SOURCE_LINE 00000472 "    my $tmp = \"@_\";"
NSQ_SOURCE_LINE 00000473 "    if ($comment || (@_ > $indent_lim && (length($tmp) > $LINEWIDTH || $tmp =~ /\\n/))) {"
NSQ_SOURCE_LINE 00000474 "\tmy @elem = @_;"
NSQ_SOURCE_LINE 00000475 "\tfor (@elem) { s/^/$INDENT/gm; }"
NSQ_SOURCE_LINE 00000476 "\treturn \"\\n\" . ($comment ? \"$INDENT# $comment\\n\" : \"\") ."
NSQ_SOURCE_LINE 00000477 "               join(\",\\n\", @elem, \"\");"
NSQ_SOURCE_LINE 00000478 "    } else {"
NSQ_SOURCE_LINE 00000479 "\treturn join(\", \", @_);"
NSQ_SOURCE_LINE 00000480 "    }"
NSQ_SOURCE_LINE 00000481 "}"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "sub str {"
NSQ_SOURCE_LINE 00000484 "  if (length($_[0]) > 20) {"
NSQ_SOURCE_LINE 00000485 "      for ($_[0]) {"
NSQ_SOURCE_LINE 00000486 "      # Check for repeated string"
NSQ_SOURCE_LINE 00000487 "      if (/^(.)\\1\\1\\1/s) {"
NSQ_SOURCE_LINE 00000488 "          # seems to be a repeating sequence, let's check if it really is"
NSQ_SOURCE_LINE 00000489 "          # without backtracking"
NSQ_SOURCE_LINE 00000490 "          unless (/[^\\Q$1\\E]/) {"
NSQ_SOURCE_LINE 00000491 "              my $base = quote($1);"
NSQ_SOURCE_LINE 00000492 "              my $repeat = length;"
NSQ_SOURCE_LINE 00000493 "              return \"($base x $repeat)\""
NSQ_SOURCE_LINE 00000494 "          }"
NSQ_SOURCE_LINE 00000495 "      }"
NSQ_SOURCE_LINE 00000496 "      # Length protection because the RE engine will blow the stack [RT#33520]"
NSQ_SOURCE_LINE 00000497 "      if (length($_) < 16 * 1024 && /^(.{2,5}?)\\1*\\z/s) {"
NSQ_SOURCE_LINE 00000498 "\t  my $base   = quote($1);"
NSQ_SOURCE_LINE 00000499 "\t  my $repeat = length($_)/length($1);"
NSQ_SOURCE_LINE 00000500 "\t  return \"($base x $repeat)\";"
NSQ_SOURCE_LINE 00000501 "      }"
NSQ_SOURCE_LINE 00000502 "      }"
NSQ_SOURCE_LINE 00000503 "  }"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "  local $_ = &quote;"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "  if (length($_) > 40  && !/\\\\x\\{/ && length($_) > (length($_[0]) * 2)) {"
NSQ_SOURCE_LINE 00000508 "      # too much binary data, better to represent as a hex/base64 string"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "      # Base64 is more compact than hex when string is longer than"
NSQ_SOURCE_LINE 00000511 "      # 17 bytes (not counting any require statement needed)."
NSQ_SOURCE_LINE 00000512 "      # But on the other hand, hex is much more readable."
NSQ_SOURCE_LINE 00000513 "      if ($TRY_BASE64 && length($_[0]) > $TRY_BASE64 &&"
NSQ_SOURCE_LINE 00000514 "\t  (defined &utf8::is_utf8 && !utf8::is_utf8($_[0])) &&"
NSQ_SOURCE_LINE 00000515 "\t  eval { require MIME::Base64 })"
NSQ_SOURCE_LINE 00000516 "      {"
NSQ_SOURCE_LINE 00000517 "\t  $require{\"MIME::Base64\"}++;"
NSQ_SOURCE_LINE 00000518 "\t  return \"MIME::Base64::decode(\\\"\" ."
NSQ_SOURCE_LINE 00000519 "\t             MIME::Base64::encode($_[0],\"\") ."
NSQ_SOURCE_LINE 00000520 "\t\t \"\\\")\";"
NSQ_SOURCE_LINE 00000521 "      }"
NSQ_SOURCE_LINE 00000522 "      return \"pack(\\\"H*\\\",\\\"\" . unpack(\"H*\", $_[0]) . \"\\\")\";"
NSQ_SOURCE_LINE 00000523 "  }"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "  return $_;"
NSQ_SOURCE_LINE 00000526 "}"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "my %esc = ("
NSQ_SOURCE_LINE 00000529 "    \"\\a\" => \"\\\\a\","
NSQ_SOURCE_LINE 00000530 "    \"\\b\" => \"\\\\b\","
NSQ_SOURCE_LINE 00000531 "    \"\\t\" => \"\\\\t\","
NSQ_SOURCE_LINE 00000532 "    \"\\n\" => \"\\\\n\","
NSQ_SOURCE_LINE 00000533 "    \"\\f\" => \"\\\\f\","
NSQ_SOURCE_LINE 00000534 "    \"\\r\" => \"\\\\r\","
NSQ_SOURCE_LINE 00000535 "    \"\\e\" => \"\\\\e\","
NSQ_SOURCE_LINE 00000536 ");"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "# put a string value in double quotes"
NSQ_SOURCE_LINE 00000539 "sub quote {"
NSQ_SOURCE_LINE 00000540 "  local($_) = $_[0];"
NSQ_SOURCE_LINE 00000541 "  # If there are many '\"' we might want to use qq() instead"
NSQ_SOURCE_LINE 00000542 "  s/([\\\\\\\"\\@\\$])/\\\\$1/g;"
NSQ_SOURCE_LINE 00000543 "  return qq(\"$_\") unless /[^\\040-\\176]/;  # fast exit"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "  s/([\\a\\b\\t\\n\\f\\r\\e])/$esc{$1}/g;"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "  # no need for 3 digits in escape for these"
NSQ_SOURCE_LINE 00000548 "  s/([\\0-\\037])(?!\\d)/sprintf('\\\\%o',ord($1))/eg;"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "  s/([\\0-\\037\\177-\\377])/sprintf('\\\\x%02X',ord($1))/eg;"
NSQ_SOURCE_LINE 00000551 "  s/([^\\040-\\176])/sprintf('\\\\x{%X}',ord($1))/eg;"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "  return qq(\"$_\");"
NSQ_SOURCE_LINE 00000554 "}"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "1;"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "__END__"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "=head1 NAME"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "Data::Dump - Pretty printing of data structures"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 " use Data::Dump qw(dump);"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 " $str = dump(@list);"
NSQ_SOURCE_LINE 00000569 " @copy_of_list = eval $str;"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 " # or use it for easy debug printout"
NSQ_SOURCE_LINE 00000572 " use Data::Dump; dd localtime;"
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "This module provides a few functions that traverse their"
NSQ_SOURCE_LINE 00000577 "argument list and return a string containing Perl code that,"
NSQ_SOURCE_LINE 00000578 "when C<eval>ed, produces a deep copy of the original arguments."
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "The main feature of the module is that it strives to produce output"
NSQ_SOURCE_LINE 00000581 "that is easy to read.  Example:"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "    @a = (1, [2, 3], {4 => 5});"
NSQ_SOURCE_LINE 00000584 "    dump(@a);"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "Produces:"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "    \"(1, [2, 3], { 4 => 5 })\""
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "If you dump just a little data, it is output on a single line. If"
NSQ_SOURCE_LINE 00000591 "you dump data that is more complex or there is a lot of it, line breaks"
NSQ_SOURCE_LINE 00000592 "are automatically added to keep it easy to read."
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "The following functions are provided (only the dd* functions are exported by default):"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "=over"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "=item dump( ... )"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "=item pp( ... )"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "Returns a string containing a Perl expression.  If you pass this"
NSQ_SOURCE_LINE 00000603 "string to Perl's built-in eval() function it should return a copy of"
NSQ_SOURCE_LINE 00000604 "the arguments you passed to dump()."
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "If you call the function with multiple arguments then the output will"
NSQ_SOURCE_LINE 00000607 "be wrapped in parenthesis \"( ..., ... )\".  If you call the function with a"
NSQ_SOURCE_LINE 00000608 "single argument the output will not have the wrapping.  If you call the function with"
NSQ_SOURCE_LINE 00000609 "a single scalar (non-reference) argument it will just return the"
NSQ_SOURCE_LINE 00000610 "scalar quoted if needed, but never break it into multiple lines.  If you"
NSQ_SOURCE_LINE 00000611 "pass multiple arguments or references to arrays of hashes then the"
NSQ_SOURCE_LINE 00000612 "return value might contain line breaks to format it for easier"
NSQ_SOURCE_LINE 00000613 "reading.  The returned string will never be \"\\n\" terminated, even if"
NSQ_SOURCE_LINE 00000614 "contains multiple lines.  This allows code like this to place the"
NSQ_SOURCE_LINE 00000615 "semicolon in the expected place:"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "   print '$obj = ', dump($obj), \";\\n\";"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "If dump() is called in void context, then the dump is printed on"
NSQ_SOURCE_LINE 00000620 "STDERR and then \"\\n\" terminated.  You might find this useful for quick"
NSQ_SOURCE_LINE 00000621 "debug printouts, but the dd*() functions might be better alternatives"
NSQ_SOURCE_LINE 00000622 "for this."
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "There is no difference between dump() and pp(), except that dump()"
NSQ_SOURCE_LINE 00000625 "shares its name with a not-so-useful perl builtin.  Because of this"
NSQ_SOURCE_LINE 00000626 "some might want to avoid using that name."
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "=item quote( $string )"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "Returns a quoted version of the provided string."
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "It differs from C<dump($string)> in that it will quote even numbers and"
NSQ_SOURCE_LINE 00000633 "not try to come up with clever expressions that might shorten the"
NSQ_SOURCE_LINE 00000634 "output.  If a non-scalar argument is provided then it's just stringified"
NSQ_SOURCE_LINE 00000635 "instead of traversed."
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "=item dd( ... )"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "=item ddx( ... )"
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "These functions will call dump() on their argument and print the"
NSQ_SOURCE_LINE 00000642 "result to STDOUT (actually, it's the currently selected output handle, but"
NSQ_SOURCE_LINE 00000643 "STDOUT is the default for that)."
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "The difference between them is only that ddx() will prefix the lines"
NSQ_SOURCE_LINE 00000646 "it prints with \"# \" and mark the first line with the file and line"
NSQ_SOURCE_LINE 00000647 "number where it was called.  This is meant to be useful for debug"
NSQ_SOURCE_LINE 00000648 "printouts of state within programs."
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "=item dumpf( ..., \\&filter )"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "Short hand for calling the dump_filtered() function of L<Data::Dump::Filtered>."
NSQ_SOURCE_LINE 00000653 "This works like dump(), but the last argument should be a filter callback"
NSQ_SOURCE_LINE 00000654 "function.  As objects are visited the filter callback is invoked and it"
NSQ_SOURCE_LINE 00000655 "can modify how the objects are dumped."
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "=back"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 "=head1 CONFIGURATION"
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "There are a few global variables that can be set to modify the output"
NSQ_SOURCE_LINE 00000662 "generated by the dump functions.  It's wise to localize the setting of"
NSQ_SOURCE_LINE 00000663 "these."
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "=over"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "=item $Data::Dump::INDENT"
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "This holds the string that's used for indenting multiline data structures."
NSQ_SOURCE_LINE 00000670 "It's default value is \"  \" (two spaces).  Set it to \"\" to suppress indentation."
NSQ_SOURCE_LINE 00000671 "Setting it to \"| \" makes for nice visuals even if the dump output then fails to"
NSQ_SOURCE_LINE 00000672 "be valid Perl."
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "=item $Data::Dump::TRY_BASE64"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "How long must a binary string be before we try to use the base64 encoding"
NSQ_SOURCE_LINE 00000677 "for the dump output.  The default is 50.  Set it to 0 to disable base64 dumps."
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "=item $Data::Dump::LINEWIDTH"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "This controls how wide the string should before we add a line break.  The"
NSQ_SOURCE_LINE 00000682 "default is 60."
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "=back"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000688 ""
NSQ_SOURCE_LINE 00000689 "Code references will be dumped as C<< sub { ... } >>. Thus, C<eval>ing them will"
NSQ_SOURCE_LINE 00000690 "not reproduce the original routine.  The C<...>-operator used will also require"
NSQ_SOURCE_LINE 00000691 "perl-5.12 or better to be evaled."
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "If you forget to explicitly import the C<dump> function, your code will"
NSQ_SOURCE_LINE 00000694 "core dump. That's because you just called the builtin C<dump> function"
NSQ_SOURCE_LINE 00000695 "by accident, which intentionally dumps core.  Because of this you can"
NSQ_SOURCE_LINE 00000696 "also import the same function as C<pp>, mnemonic for \"pretty-print\"."
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "=head1 HISTORY"
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "The C<Data::Dump> module grew out of frustration with Sarathy's"
NSQ_SOURCE_LINE 00000701 "in-most-cases-excellent C<Data::Dumper>.  Basic ideas and some code"
NSQ_SOURCE_LINE 00000702 "are shared with Sarathy's module."
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "The C<Data::Dump> module provides a much simpler interface than"
NSQ_SOURCE_LINE 00000705 "C<Data::Dumper>.  No OO interface is available and there are fewer"
NSQ_SOURCE_LINE 00000706 "configuration options to worry about.  The other benefit is"
NSQ_SOURCE_LINE 00000707 "that the dump produced does not try to set any variables.  It only"
NSQ_SOURCE_LINE 00000708 "returns what is needed to produce a copy of the arguments.  This means"
NSQ_SOURCE_LINE 00000709 "that C<dump(\"foo\")> simply returns C<'\"foo\"'>, and C<dump(1..3)> simply"
NSQ_SOURCE_LINE 00000710 "returns C<'(1, 2, 3)'>."
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "L<Data::Dump::Filtered>, L<Data::Dump::Trace>, L<Data::Dumper>, L<JSON>,"
NSQ_SOURCE_LINE 00000715 "L<Storable>"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "=head1 AUTHORS"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "The C<Data::Dump> module is written by Gisle Aas <gisle@aas.no>, based"
NSQ_SOURCE_LINE 00000720 "on C<Data::Dumper> by Gurusamy Sarathy <gsar@umich.edu>."
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 " Copyright 1998-2010 Gisle Aas."
NSQ_SOURCE_LINE 00000723 " Copyright 1996-1998 Gurusamy Sarathy."
NSQ_SOURCE_LINE 00000724 ""
