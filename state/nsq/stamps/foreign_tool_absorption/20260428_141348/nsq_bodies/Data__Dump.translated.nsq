NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub dump"
NSQ_SOURCE_LINE 00000023 "{"
NSQ_SOURCE_LINE 00000024 "    local %seen;"
NSQ_SOURCE_LINE 00000025 "    local %refcnt;"
NSQ_SOURCE_LINE 00000026 "    local %require;"
NSQ_SOURCE_LINE 00000027 "    local @fixup;"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "    require Data::Dump::FilterContext if @FILTERS;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    my $name = \"a\";"
NSQ_SOURCE_LINE 00000032 "    my @dump;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    for my $v (@_) {"
NSQ_SOURCE_LINE 00000035 "\tmy $val = _dump($v, $name, [], tied($v));"
NSQ_SOURCE_LINE 00000036 "\tpush(@dump, [$name, $val]);"
NSQ_SOURCE_LINE 00000037 "    } continue {"
NSQ_SOURCE_LINE 00000038 "\t$name++;"
NSQ_SOURCE_LINE 00000039 "    }"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    my $out = \"\";"
NSQ_SOURCE_LINE 00000042 "    if (%require) {"
NSQ_SOURCE_LINE 00000043 "\tfor (sort keys %require) {"
NSQ_SOURCE_LINE 00000044 "\t    $out .= \"require $_;\\n\";"
NSQ_SOURCE_LINE 00000045 "\t}"
NSQ_SOURCE_LINE 00000046 "    }"
NSQ_SOURCE_LINE 00000047 "    if (%refcnt) {"
NSQ_SOURCE_LINE 00000048 "\t# output all those with refcounts first"
NSQ_SOURCE_LINE 00000049 "\tfor (@dump) {"
NSQ_SOURCE_LINE 00000050 "\t    my $name = $_->[0];"
NSQ_SOURCE_LINE 00000051 "\t    if ($refcnt{$name}) {"
