NSQ_SOURCE_LINE 00000053 "\t\tundef $_->[1];"
NSQ_SOURCE_LINE 00000054 "\t    }"
NSQ_SOURCE_LINE 00000055 "\t}"
NSQ_SOURCE_LINE 00000056 "\tfor (@fixup) {"
NSQ_SOURCE_LINE 00000057 "\t    $out .= \"$_;\\n\";"
NSQ_SOURCE_LINE 00000058 "\t}"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    my $paren = (@dump != 1);"
NSQ_SOURCE_LINE 00000062 "    $out .= \"(\" if $paren;"
NSQ_SOURCE_LINE 00000063 "    $out .= format_list($paren, undef,"
NSQ_SOURCE_LINE 00000064 "\t\t\tmap {defined($_->[1]) ? $_->[1] : \"\\$\".$_->[0]}"
NSQ_SOURCE_LINE 00000065 "\t\t\t    @dump"
NSQ_SOURCE_LINE 00000066 "\t\t       );"
NSQ_SOURCE_LINE 00000067 "    $out .= \")\" if $paren;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    if (%refcnt || %require) {"
NSQ_SOURCE_LINE 00000070 "\t$out .= \";\\n\";"
NSQ_SOURCE_LINE 00000071 "\t$out =~ s/^/$INDENT/gm;"
NSQ_SOURCE_LINE 00000072 "\t$out = \"do {\\n$out}\";"
NSQ_SOURCE_LINE 00000073 "    }"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    print STDERR \"$out\\n\" unless defined wantarray;"
NSQ_SOURCE_LINE 00000076 "    $out;"
NSQ_SOURCE_LINE 00000077 "}"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "*pp = \\&dump;"
NSQ_SOURCE_LINE 00000080 ""
