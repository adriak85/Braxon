NSQ_SOURCE_LINE 00000085 "sub ddx {"
NSQ_SOURCE_LINE 00000086 "    my(undef, $file, $line) = caller;"
NSQ_SOURCE_LINE 00000087 "    $file =~ s,.*[\\\\/],,;"
NSQ_SOURCE_LINE 00000088 "    my $out = \"$file:$line: \" . dump(@_) . \"\\n\";"
NSQ_SOURCE_LINE 00000089 "    $out =~ s/^/# /gm;"
NSQ_SOURCE_LINE 00000090 "    print $out;"
NSQ_SOURCE_LINE 00000091 "}"
