NSQ_SOURCE_LINE 00000031 "=head1 VERSION"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "This document describes version 0.080 of Data::Dump::OneLine (from Perl distribution Data-Dump-OneLine), released on 2021-06-27."
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 " use Data::Dump::OneLine; # exports dd and dmp"
NSQ_SOURCE_LINE 00000038 " $str = dd(@list);"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "It now uses L<Data::Dmp>. You should use Data::Dmp directly."
