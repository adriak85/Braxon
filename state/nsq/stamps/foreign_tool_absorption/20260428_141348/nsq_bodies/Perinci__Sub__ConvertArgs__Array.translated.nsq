NSQ_SOURCE_LINE 00000001 "package Perinci::Sub::ConvertArgs::Array;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2019-04-15'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.090'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter;"
NSQ_SOURCE_LINE 00000011 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw(convert_args_to_array);"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our %SPEC;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "$SPEC{convert_args_to_array} = {"
NSQ_SOURCE_LINE 00000017 "    v => 1.1,"
NSQ_SOURCE_LINE 00000018 "    summary => 'Convert hash arguments to array',"
NSQ_SOURCE_LINE 00000019 "    description => <<'_',"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "Using information in 'args' property (particularly the 'pos' and 'slurpy' of"
NSQ_SOURCE_LINE 00000022 "each argument spec), convert hash arguments to array."
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "Example:"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    my $meta = {"
NSQ_SOURCE_LINE 00000027 "        v => 1.1,"
NSQ_SOURCE_LINE 00000028 "        summary => 'Multiply 2 numbers (a & b)',"
NSQ_SOURCE_LINE 00000029 "        args => {"
NSQ_SOURCE_LINE 00000030 "            a => ['num*' => {arg_pos=>0}],"
NSQ_SOURCE_LINE 00000031 "            b => ['num*' => {arg_pos=>1}],"
NSQ_SOURCE_LINE 00000032 "        }"
NSQ_SOURCE_LINE 00000033 "    }"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "then 'convert_args_to_array(args=>{a=>2, b=>3}, meta=>$meta)' will produce:"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    [200, \"OK\", [2, 3]]"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "_"
NSQ_SOURCE_LINE 00000040 "    args => {"
NSQ_SOURCE_LINE 00000041 "        args => {req=>1, schema=>'hash*', pos=>0},"
NSQ_SOURCE_LINE 00000042 "        meta => {req=>1, schema=>'hash*', pos=>1},"
NSQ_SOURCE_LINE 00000043 "    },"
NSQ_SOURCE_LINE 00000044 "};"
NSQ_SOURCE_LINE 00000045 "sub convert_args_to_array {"
NSQ_SOURCE_LINE 00000046 "    my %input_args   = @_;"
NSQ_SOURCE_LINE 00000047 "    my $args         = $input_args{args} or return [400, \"Please specify args\"];"
NSQ_SOURCE_LINE 00000048 "    my $meta         = $input_args{meta} or return [400, \"Please specify meta\"];"
NSQ_SOURCE_LINE 00000049 "    my $args_prop    = $meta->{args} // {};"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    my $v = $meta->{v} // 1.0;"
NSQ_SOURCE_LINE 00000052 "    return [412, \"Sorry, only metadata version 1.1 is supported (yours: $v)\"]"
NSQ_SOURCE_LINE 00000053 "        unless $v == 1.1;"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    #$log->tracef(\"-> convert_args_to_array(), args=%s\", $args);"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    my @array;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    while (my ($k, $v) = each %$args) {"
NSQ_SOURCE_LINE 00000060 "        next if $k =~ /\\A-/; # skip special arguments"
NSQ_SOURCE_LINE 00000061 "        my $as = $args_prop->{$k};"
NSQ_SOURCE_LINE 00000062 "        return [412, \"Argument $k: Not specified in args property\"] unless $as;"
NSQ_SOURCE_LINE 00000063 "        my $pos = $as->{pos};"
NSQ_SOURCE_LINE 00000064 "        return [412, \"Argument $k: No pos specified in arg spec\"]"
NSQ_SOURCE_LINE 00000065 "            unless defined $pos;"
NSQ_SOURCE_LINE 00000066 "        if ($as->{slurpy} // $as->{greedy}) {"
NSQ_SOURCE_LINE 00000067 "            $v = [$v] if ref($v) ne 'ARRAY';"
NSQ_SOURCE_LINE 00000068 "            # splice can't work if $pos is beyond array's length"
NSQ_SOURCE_LINE 00000069 "            for (@array .. $pos-1) {"
NSQ_SOURCE_LINE 00000070 "                $array[$_] = undef;"
NSQ_SOURCE_LINE 00000071 "            }"
NSQ_SOURCE_LINE 00000072 "            splice @array, $pos, 0, @$v;"
NSQ_SOURCE_LINE 00000073 "        } else {"
NSQ_SOURCE_LINE 00000074 "            $array[$pos] = $v;"
NSQ_SOURCE_LINE 00000075 "        }"
NSQ_SOURCE_LINE 00000076 "    }"
NSQ_SOURCE_LINE 00000077 "    [200, \"OK\", \\@array];"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "1;"
NSQ_SOURCE_LINE 00000081 "# ABSTRACT: Convert hash arguments to array"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "__END__"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "=pod"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=head1 NAME"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "Perinci::Sub::ConvertArgs::Array - Convert hash arguments to array"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=head1 VERSION"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "This document describes version 0.090 of Perinci::Sub::ConvertArgs::Array (from Perl distribution Perinci-Sub-ConvertArgs-Array), released on 2019-04-15."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 " use Perinci::Sub::ConvertArgs::Array qw(convert_args_to_array);"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 " my $res = convert_args_to_array(args=>\\%args, meta=>$meta, ...);"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "This module provides convert_args_to_array() (and"
NSQ_SOURCE_LINE 00000106 "gencode_convert_args_to_array(), upcoming). This module is used by, among"
NSQ_SOURCE_LINE 00000107 "others, L<Perinci::Sub::Wrapper>."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=head2 convert_args_to_array"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "Usage:"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 " convert_args_to_array(%args) -> [status, msg, payload, meta]"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "Convert hash arguments to array."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "Using information in 'args' property (particularly the 'pos' and 'slurpy' of"
NSQ_SOURCE_LINE 00000121 "each argument spec), convert hash arguments to array."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "Example:"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 " my $meta = {"
NSQ_SOURCE_LINE 00000126 "     v => 1.1,"
NSQ_SOURCE_LINE 00000127 "     summary => 'Multiply 2 numbers (a & b)',"
NSQ_SOURCE_LINE 00000128 "     args => {"
NSQ_SOURCE_LINE 00000129 "         a => ['num*' => {arg_pos=>0}],"
NSQ_SOURCE_LINE 00000130 "         b => ['num*' => {arg_pos=>1}],"
NSQ_SOURCE_LINE 00000131 "     }"
NSQ_SOURCE_LINE 00000132 " }"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "then 'convert_args_to_array(args=>{a=>2, b=>3}, meta=>$meta)' will produce:"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 " [200, \"OK\", [2, 3]]"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=over 4"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=item * B<args>* => I<hash>"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=item * B<meta>* => I<hash>"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "=back"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "First element (status) is an integer containing HTTP status code"
NSQ_SOURCE_LINE 00000153 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000154 "(msg) is a string containing error message, or 'OK' if status is"
NSQ_SOURCE_LINE 00000155 "200. Third element (payload) is optional, the actual result. Fourth"
NSQ_SOURCE_LINE 00000156 "element (meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000157 "that contains extra information."
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "Return value:  (any)"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "Please visit the project's homepage at L<https://metacpan.org/release/Perinci-Sub-ConvertArgs-Array>."
NSQ_SOURCE_LINE 00000164 ""
