NSQ_SOURCE_LINE 00000001 "package Class::Data::Inheritable;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict qw(vars subs);"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.10';"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "sub mk_classdata {"
NSQ_SOURCE_LINE 00000007 "    my ($declaredclass, $attribute, $data) = @_;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "    if( ref $declaredclass ) {"
NSQ_SOURCE_LINE 00000010 "        require Carp;"
NSQ_SOURCE_LINE 00000011 "        Carp::croak(\"mk_classdata() is a class method, not an object method\");"
NSQ_SOURCE_LINE 00000012 "    }"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "    my $accessor = sub {"
NSQ_SOURCE_LINE 00000015 "        my $wantclass = ref($_[0]) || $_[0];"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "        return $wantclass->mk_classdata($attribute)->(@_)"
NSQ_SOURCE_LINE 00000018 "          if @_>1 && $wantclass ne $declaredclass;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "        $data = $_[1] if @_>1;"
NSQ_SOURCE_LINE 00000021 "        return $data;"
NSQ_SOURCE_LINE 00000022 "    };"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    my $alias = \"_${attribute}_accessor\";"
NSQ_SOURCE_LINE 00000025 "    *{$declaredclass.'::'.$attribute} = $accessor;"
NSQ_SOURCE_LINE 00000026 "    *{$declaredclass.'::'.$alias}     = $accessor;"
NSQ_SOURCE_LINE 00000027 "}"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "1;"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "__END__"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=head1 NAME"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "Class::Data::Inheritable - Inheritable, overridable class data"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "  package Stuff;"
NSQ_SOURCE_LINE 00000040 "  use base qw(Class::Data::Inheritable);"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "  # Set up DataFile as inheritable class data."
NSQ_SOURCE_LINE 00000043 "  Stuff->mk_classdata('DataFile');"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "  # Declare the location of the data file for this class."
NSQ_SOURCE_LINE 00000046 "  Stuff->DataFile('/etc/stuff/data');"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "  # Or, all in one shot:"
NSQ_SOURCE_LINE 00000049 "  Stuff->mk_classdata(DataFile => '/etc/stuff/data');"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "Class::Data::Inheritable is for creating accessor/mutators to class"
NSQ_SOURCE_LINE 00000054 "data.  That is, if you want to store something about your class as a"
NSQ_SOURCE_LINE 00000055 "whole (instead of about a single object).  This data is then inherited"
NSQ_SOURCE_LINE 00000056 "by your subclasses and can be overridden."
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "For example:"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "  Pere::Ubu->mk_classdata('Suitcase');"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "will generate the method Suitcase() in the class Pere::Ubu."
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "This new method can be used to get and set a piece of class data."
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "  Pere::Ubu->Suitcase('Red');"
NSQ_SOURCE_LINE 00000067 "  $suitcase = Pere::Ubu->Suitcase;"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "The interesting part happens when a class inherits from Pere::Ubu:"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "  package Raygun;"
NSQ_SOURCE_LINE 00000072 "  use base qw(Pere::Ubu);"
NSQ_SOURCE_LINE 00000073 "  "
NSQ_SOURCE_LINE 00000074 "  # Raygun's suitcase is Red."
NSQ_SOURCE_LINE 00000075 "  $suitcase = Raygun->Suitcase;"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "Raygun inherits its Suitcase class data from Pere::Ubu."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "Inheritance of class data works analogous to method inheritance.  As"
NSQ_SOURCE_LINE 00000080 "long as Raygun does not \"override\" its inherited class data (by using"
NSQ_SOURCE_LINE 00000081 "Suitcase() to set a new value) it will continue to use whatever is set"
NSQ_SOURCE_LINE 00000082 "in Pere::Ubu and inherit further changes:"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "  # Both Raygun's and Pere::Ubu's suitcases are now Blue"
NSQ_SOURCE_LINE 00000085 "  Pere::Ubu->Suitcase('Blue');"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "However, should Raygun decide to set its own Suitcase() it has now"
NSQ_SOURCE_LINE 00000088 "\"overridden\" Pere::Ubu and is on its own, just like if it had"
NSQ_SOURCE_LINE 00000089 "overridden a method:"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "  # Raygun has an orange suitcase, Pere::Ubu's is still Blue."
NSQ_SOURCE_LINE 00000092 "  Raygun->Suitcase('Orange');"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "Now that Raygun has overridden Pere::Ubu further changes by Pere::Ubu"
NSQ_SOURCE_LINE 00000095 "no longer effect Raygun."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "  # Raygun still has an orange suitcase, but Pere::Ubu is using Samsonite."
NSQ_SOURCE_LINE 00000098 "  Pere::Ubu->Suitcase('Samsonite');"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=head1 Methods"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head2 mk_classdata"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "  Class->mk_classdata($data_accessor_name);"
NSQ_SOURCE_LINE 00000105 "  Class->mk_classdata($data_accessor_name => $value);"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "This is a class method used to declare new class data accessors."
NSQ_SOURCE_LINE 00000108 "A new accessor will be created in the Class using the name from"
NSQ_SOURCE_LINE 00000109 "$data_accessor_name, and optionally initially setting it to the given"
NSQ_SOURCE_LINE 00000110 "value."
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "To facilitate overriding, mk_classdata creates an alias to the"
NSQ_SOURCE_LINE 00000113 "accessor, _field_accessor().  So Suitcase() would have an alias"
NSQ_SOURCE_LINE 00000114 "_Suitcase_accessor() that does the exact same thing as Suitcase()."
NSQ_SOURCE_LINE 00000115 "This is useful if you want to alter the behavior of a single accessor"
NSQ_SOURCE_LINE 00000116 "yet still get the benefits of inheritable class data.  For example."
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "  sub Suitcase {"
NSQ_SOURCE_LINE 00000119 "      my($self) = shift;"
NSQ_SOURCE_LINE 00000120 "      warn \"Fashion tragedy\" if @_ and $_[0] eq 'Plaid';"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "      $self->_Suitcase_accessor(@_);"
NSQ_SOURCE_LINE 00000123 "  }"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000126 ""
