NSQ_SOURCE_LINE 00000001 "## no critic (Modules::ProhibitAutomaticExportation)"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "package Getopt::Long::Complete;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "require Exporter;"
NSQ_SOURCE_LINE 00000009 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000010 "our @EXPORT = qw("
NSQ_SOURCE_LINE 00000011 "                    GetOptions"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "                    $REQUIRE_ORDER $PERMUTE $RETURN_IN_ORDER"
NSQ_SOURCE_LINE 00000014 "               );"
NSQ_SOURCE_LINE 00000015 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000016 "                    GetOptionsWithCompletion"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "                    GetOptionsFromArray"
NSQ_SOURCE_LINE 00000019 "                    GetOptionsFromString"
NSQ_SOURCE_LINE 00000020 "                    Configure"
NSQ_SOURCE_LINE 00000021 "                    HelpMessage"
NSQ_SOURCE_LINE 00000022 "                    VersionMessage"
NSQ_SOURCE_LINE 00000023 "               );"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000026 "our $DATE = '2025-02-21'; # DATE"
NSQ_SOURCE_LINE 00000027 "our $DIST = 'Getopt-Long-Complete'; # DIST"
NSQ_SOURCE_LINE 00000028 "our $VERSION = '0.318'; # VERSION"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "# we don't want to always load Getopt::Long to avoid startup overhead."
NSQ_SOURCE_LINE 00000031 "our ($REQUIRE_ORDER, $PERMUTE, $RETURN_IN_ORDER) = (0..2); # copied from Getopt::Long"
NSQ_SOURCE_LINE 00000032 "sub GetOptionsFromArray  { require Getopt::Long; goto &Getopt::Long::GetOptionsFromArray }"
NSQ_SOURCE_LINE 00000033 "sub GetOptionsFromString { require Getopt::Long; goto &Getopt::Long::GetOptionsFromString }"
NSQ_SOURCE_LINE 00000034 "sub Configure            { require Getopt::Long; goto &Getopt::Long::Configure }"
NSQ_SOURCE_LINE 00000035 "sub HelpMessage          { require Getopt::Long; goto &Getopt::Long::HelpMessage }"
NSQ_SOURCE_LINE 00000036 "sub VersionMessage       { require Getopt::Long; goto &Getopt::Long::VersionMessage }"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "# default follows Getopt::Long"
NSQ_SOURCE_LINE 00000039 "our $opt_permute = $ENV{POSIXLY_CORRECT} ? 0 : 1;"
NSQ_SOURCE_LINE 00000040 "our $opt_pass_through = 0;"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "our $opt_bundling = 1; # in Getopt::Long the default is off"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "sub GetOptionsWithCompletion {"
NSQ_SOURCE_LINE 00000045 "    my $comp = shift;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    my $hash;"
NSQ_SOURCE_LINE 00000048 "    my $ospec;"
NSQ_SOURCE_LINE 00000049 "    if (ref($_[0]) eq 'HASH') {"
NSQ_SOURCE_LINE 00000050 "        $hash = shift;"
NSQ_SOURCE_LINE 00000051 "        for (my $i = 0; $i < @_; $i++) {"
NSQ_SOURCE_LINE 00000052 "            if (($i+1 < @_) && (ref $_[$i+1])) {"
NSQ_SOURCE_LINE 00000053 "                $ospec->{$_[$i]} = $_[$i+1];"
NSQ_SOURCE_LINE 00000054 "                $i++;"
NSQ_SOURCE_LINE 00000055 "            } else {"
NSQ_SOURCE_LINE 00000056 "                $ospec->{$_[$i]} = sub {};"
NSQ_SOURCE_LINE 00000057 "            }"
NSQ_SOURCE_LINE 00000058 "        }"
NSQ_SOURCE_LINE 00000059 "    } else {"
NSQ_SOURCE_LINE 00000060 "        $ospec = \\@_;"
NSQ_SOURCE_LINE 00000061 "    }"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    my $shell;"
NSQ_SOURCE_LINE 00000064 "    if ($ENV{COMP_SHELL}) {"
NSQ_SOURCE_LINE 00000065 "        ($shell = $ENV{COMP_SHELL}) =~ s!.+/!!;"
NSQ_SOURCE_LINE 00000066 "    } elsif ($ENV{COMMAND_LINE}) {"
NSQ_SOURCE_LINE 00000067 "        $shell = 'tcsh';"
NSQ_SOURCE_LINE 00000068 "    } else {"
NSQ_SOURCE_LINE 00000069 "        $shell = 'bash';"
NSQ_SOURCE_LINE 00000070 "    }"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "    if ($ENV{COMP_LINE} || $ENV{COMMAND_LINE}) {"
NSQ_SOURCE_LINE 00000073 "        my ($words, $cword);"
NSQ_SOURCE_LINE 00000074 "        if ($ENV{COMP_LINE}) {"
NSQ_SOURCE_LINE 00000075 "            require Complete::Bash;"
NSQ_SOURCE_LINE 00000076 "            ($words,$cword) = @{ Complete::Bash::parse_cmdline(undef, undef, {truncate_current_word=>1}) };"
NSQ_SOURCE_LINE 00000077 "            ($words,$cword) = @{ Complete::Bash::join_wordbreak_words($words, $cword) };"
NSQ_SOURCE_LINE 00000078 "        } elsif ($ENV{COMMAND_LINE}) {"
NSQ_SOURCE_LINE 00000079 "            require Complete::Tcsh;"
NSQ_SOURCE_LINE 00000080 "            $shell ||= 'tcsh';"
NSQ_SOURCE_LINE 00000081 "            ($words, $cword) = @{ Complete::Tcsh::parse_cmdline() };"
NSQ_SOURCE_LINE 00000082 "        }"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "        require Complete::Getopt::Long;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "        shift @$words; $cword--; # strip program name"
NSQ_SOURCE_LINE 00000087 "        my $compres = Complete::Getopt::Long::complete_cli_arg("
NSQ_SOURCE_LINE 00000088 "            words => $words, cword => $cword, getopt_spec => $ospec,"
NSQ_SOURCE_LINE 00000089 "            completion => $comp,"
NSQ_SOURCE_LINE 00000090 "            bundling => $opt_bundling,"
NSQ_SOURCE_LINE 00000091 "        );"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "        if ($shell eq 'bash') {"
NSQ_SOURCE_LINE 00000094 "            require Complete::Bash;"
NSQ_SOURCE_LINE 00000095 "            print Complete::Bash::format_completion("
NSQ_SOURCE_LINE 00000096 "                $compres, {word=>$words->[$cword]});"
NSQ_SOURCE_LINE 00000097 "        } elsif ($shell eq 'fish') {"
NSQ_SOURCE_LINE 00000098 "            require Complete::Fish;"
NSQ_SOURCE_LINE 00000099 "            print Complete::Bash::format_completion("
NSQ_SOURCE_LINE 00000100 "                $compres, {word=>$words->[$cword]});"
NSQ_SOURCE_LINE 00000101 "        } elsif ($shell eq 'tcsh') {"
NSQ_SOURCE_LINE 00000102 "            require Complete::Tcsh;"
NSQ_SOURCE_LINE 00000103 "            print Complete::Tcsh::format_completion($compres);"
NSQ_SOURCE_LINE 00000104 "        } elsif ($shell eq 'zsh') {"
NSQ_SOURCE_LINE 00000105 "            require Complete::Zsh;"
NSQ_SOURCE_LINE 00000106 "            print Complete::Zsh::format_completion($compres);"
NSQ_SOURCE_LINE 00000107 "        } else {"
NSQ_SOURCE_LINE 00000108 "            die \"Unknown shell '$shell'\";"
NSQ_SOURCE_LINE 00000109 "        }"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "        exit 0;"
NSQ_SOURCE_LINE 00000112 "    }"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "    require Getopt::Long;"
NSQ_SOURCE_LINE 00000115 "    my $old_conf = Getopt::Long::Configure("
NSQ_SOURCE_LINE 00000116 "        'no_ignore_case',"
NSQ_SOURCE_LINE 00000117 "        'no_getopt_compat',"
NSQ_SOURCE_LINE 00000118 "        'gnu_compat',"
NSQ_SOURCE_LINE 00000119 "        $opt_bundling ? 'bundling' : 'no_bundling',"
NSQ_SOURCE_LINE 00000120 "        $opt_permute ? 'permute' : 'no_permute',"
NSQ_SOURCE_LINE 00000121 "        $opt_pass_through ? 'pass_through' : 'no_pass_through',"
NSQ_SOURCE_LINE 00000122 "    );"
NSQ_SOURCE_LINE 00000123 "    my $res;"
NSQ_SOURCE_LINE 00000124 "    if ($hash) {"
NSQ_SOURCE_LINE 00000125 "        $res = Getopt::Long::GetOptions($hash, @_);"
NSQ_SOURCE_LINE 00000126 "    } else {"
NSQ_SOURCE_LINE 00000127 "        $res = Getopt::Long::GetOptions(@_);"
NSQ_SOURCE_LINE 00000128 "    }"
NSQ_SOURCE_LINE 00000129 "    Getopt::Long::Configure($old_conf);"
NSQ_SOURCE_LINE 00000130 "    $res;"
NSQ_SOURCE_LINE 00000131 "}"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "sub GetOptions {"
NSQ_SOURCE_LINE 00000134 "    GetOptionsWithCompletion(undef, @_);"
NSQ_SOURCE_LINE 00000135 "}"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "1;"
NSQ_SOURCE_LINE 00000138 "# ABSTRACT: A drop-in replacement for Getopt::Long, with shell tab completion"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "__END__"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=pod"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "=head1 NAME"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "Getopt::Long::Complete - A drop-in replacement for Getopt::Long, with shell tab completion"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=head1 VERSION"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "This document describes version 0.318 of Getopt::Long::Complete (from Perl distribution Getopt-Long-Complete), released on 2025-02-21."
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=head2 First example (simple)"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "You just replace C<use Getopt::Long> with C<use Getopt::Long::Complete> and your"
NSQ_SOURCE_LINE 00000159 "program suddenly supports tab completion. This works for most/many programs (see"
NSQ_SOURCE_LINE 00000160 "L</\"INCOMPATIBILITIES\">. For example, below is source code for C<delete-user>."
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 " use Getopt::Long::Complete;"
NSQ_SOURCE_LINE 00000163 " my %opts;"
NSQ_SOURCE_LINE 00000164 " GetOptions("
NSQ_SOURCE_LINE 00000165 "     'help|h'     => sub { ... },"
NSQ_SOURCE_LINE 00000166 "     'on-fail=s'  => \\$opts{on_fail},"
NSQ_SOURCE_LINE 00000167 "     'user|U=s'   => \\$opts{name},"
NSQ_SOURCE_LINE 00000168 "     'force'      => \\$opts{force},"
NSQ_SOURCE_LINE 00000169 "     'verbose!'   => \\$opts{verbose},"
NSQ_SOURCE_LINE 00000170 " );"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "Several shells are supported. To activate completion, see L</\"DESCRIPTION\">."
NSQ_SOURCE_LINE 00000173 "After activation, tab completion works:"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 " % delete-user <tab>"
NSQ_SOURCE_LINE 00000176 " --force --help --noverbose --no-verbose --on-fail --user --verbose -h"
NSQ_SOURCE_LINE 00000177 " % delete-user --h<tab>"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "=head2 Second example (additional completion)"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "The previous example only provides completion for option names. To provide"
NSQ_SOURCE_LINE 00000182 "completion for option values as well as arguments, you need to provide more"
NSQ_SOURCE_LINE 00000183 "hints. Instead of C<GetOptions>, use C<GetOptionsWithCompletion>. It's basically"
NSQ_SOURCE_LINE 00000184 "the same as C<GetOptions> but accepts an extra coderef in the first argument."
NSQ_SOURCE_LINE 00000185 "The code will be invoked when completion to option value or argument is needed."
NSQ_SOURCE_LINE 00000186 "Example:"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 " use Getopt::Long::Complete qw(GetOptionsWithCompletion);"
NSQ_SOURCE_LINE 00000189 " use Complete::Unix qw(complete_user);"
NSQ_SOURCE_LINE 00000190 " use Complete::Util qw(complete_array_elem);"
NSQ_SOURCE_LINE 00000191 " my %opts;"
NSQ_SOURCE_LINE 00000192 " GetOptionsWithCompletion("
NSQ_SOURCE_LINE 00000193 "     sub {"
NSQ_SOURCE_LINE 00000194 "         my %args  = @_; # see Complete::Getopt::Long for details on what arguments are provided"
NSQ_SOURCE_LINE 00000195 "         my $word  = $args{word}; # the word to be completed"
NSQ_SOURCE_LINE 00000196 "         my $type  = $args{type}; # 'optname', 'optval', or 'arg'"
NSQ_SOURCE_LINE 00000197 "         my $opt   = $args{opt}; # can be an array of options if ambiguous, e.g. ['--on-fail', '--on-full']"
NSQ_SOURCE_LINE 00000198 "         if ($type eq 'optval' && $opt eq '--on-fail') {"
NSQ_SOURCE_LINE 00000199 "             return complete_array_elem(array=>[qw/die warn ignore/], word=>$word);"
NSQ_SOURCE_LINE 00000200 "         } elsif ($type eq 'optval' && ($opt eq '--user' || $opt eq '-U')) {"
NSQ_SOURCE_LINE 00000201 "             return complete_user(word=>$word);"
NSQ_SOURCE_LINE 00000202 "         } elsif ($type eq 'arg') {"
NSQ_SOURCE_LINE 00000203 "             return complete_user(word=>$word);"
NSQ_SOURCE_LINE 00000204 "         }"
NSQ_SOURCE_LINE 00000205 "         [];"
NSQ_SOURCE_LINE 00000206 "     },"
NSQ_SOURCE_LINE 00000207 "     'help|h'     => sub { ... },"
NSQ_SOURCE_LINE 00000208 "     'on-fail=s'  => \\$opts{on_fail},"
NSQ_SOURCE_LINE 00000209 "     'user=s'     => \\$opts{name},"
NSQ_SOURCE_LINE 00000210 "     'force'      => \\$opts{force},"
NSQ_SOURCE_LINE 00000211 "     'verbose!'   => \\$opts{verbose},"
NSQ_SOURCE_LINE 00000212 " );"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "This module provides a quick and easy way to add shell tab completion feature to"
NSQ_SOURCE_LINE 00000217 "your scripts, including scripts already written using the venerable"
NSQ_SOURCE_LINE 00000218 "L<Getopt::Long> module. Currently bash and tcsh are directly supported; fish and"
NSQ_SOURCE_LINE 00000219 "zsh are also supported via L<shcompgen>."
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "This module is basically just a thin wrapper for Getopt::Long. Its C<GetOptions>"
NSQ_SOURCE_LINE 00000222 "function just checks for COMP_LINE/COMP_POINT environment variable (in the case"
NSQ_SOURCE_LINE 00000223 "of bash) or COMMAND_LINE (in the case of tcsh) before passing its arguments to"
NSQ_SOURCE_LINE 00000224 "C<Getopt::Long>'s C<GetOptions>. If those environment variable(s) are defined,"
NSQ_SOURCE_LINE 00000225 "completion reply will be printed to STDOUT and then the program will exit."
NSQ_SOURCE_LINE 00000226 "Otherwise, Getopt::Long's GetOptions is called."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "To keep completion quick, you should do C<GetOptions()> or"
NSQ_SOURCE_LINE 00000229 "C<GetOptionsWithCompletion()> as early as possible in your script. Preferably"
NSQ_SOURCE_LINE 00000230 "before loading lots of other Perl modules."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "To activate tab completion in bash, put your script somewhere in C<PATH> and"
NSQ_SOURCE_LINE 00000233 "execute this in the shell or put it into your bash startup file (e.g."
NSQ_SOURCE_LINE 00000234 "C</etc/bash.bashrc> or C<~/.bashrc>). Replace C<delete-user> with the actual"
NSQ_SOURCE_LINE 00000235 "script name:"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 " complete -C delete-user delete-user"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "For tcsh:"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 " complete delete-user 'p/*/`delete-user`/'"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "For other shells (but actually for bash too) you can use L<shcompgen>."
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "=head1 VARIABLES"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "Because we are \"bound\" by providing a Getopt::Long-compatible function"
NSQ_SOURCE_LINE 00000248 "interface, these variables exist to allow configuring Getopt::Long::GetOptions."
NSQ_SOURCE_LINE 00000249 "You can use Perl's C<local> to localize the effect."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "=head2 $opt_permute"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "Bool. Default: 1 (or 0 if POSIXLY_CORRECT). Not exported."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=head2 $opt_pass_through"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "Bool. Default: 0. Not exported."
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=head2 $opt_bundling"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "Bool. Default: 1. Not exported."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=head2 $REQUIRE_ORDER"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "Integer. Constant. Value is 0. Exported by default, to be compatible with"
NSQ_SOURCE_LINE 00000266 "Getopt::Long."
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=head2 $PERMUTE"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "Integer. Constant. Value is 1. Exported by default, to be compatible with"
NSQ_SOURCE_LINE 00000271 "Getopt::Long."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=head2 $RETURN_IN_ORDER"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Integer. Constant. Value is 2. Exported by default, to be compatible with"
NSQ_SOURCE_LINE 00000276 "Getopt::Long."
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head1 INCOMPATIBILITIES"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "Getopt::Long::Complete (GLC) provides all the same exports as Getopt::Long (GL),"
NSQ_SOURCE_LINE 00000281 "for example L</GetOptions> (exported by default), L</GetOptionsFromArray>,"
NSQ_SOURCE_LINE 00000282 "L</Configure>, etc."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "Aside from L<GetOptions> which has an extra behavior to support completion, all"
NSQ_SOURCE_LINE 00000285 "the other routines of GLC behave exactly the same as GL."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "However, there are some incompatibilities or unsupported features:"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=over"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=item * GLC does not allow passing configure options during import"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=item * GLC's GetOptions only supports running under a specific set of modes: C<bundling>, C<no_ignore_case>."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "Other non-default settings have not been tested and probably not supported."
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=back"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "=head2 GetOptions"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "Usage:"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 " GetOptions([ \\%hash, ] @spec)"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "Exported by default. Will call Getopt::Long's GetOptions, except when COMP_LINE"
NSQ_SOURCE_LINE 00000308 "environment variable is defined, in which case will print completion reply to"
NSQ_SOURCE_LINE 00000309 "STDOUT and exit."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "B<Note: Will temporarily set Getopt::Long configuration as follow: bundling,"
NSQ_SOURCE_LINE 00000312 "no_ignore_case, gnu_compat, no_getopt_compat, permute (if POSIXLY_CORRECT"
NSQ_SOURCE_LINE 00000313 "environment is false). I believe this a sane default.> You can turn off bundling"
NSQ_SOURCE_LINE 00000314 "via C<$opt_bundling>. You can turn on/off permute explicitly by via"
NSQ_SOURCE_LINE 00000315 "C<$opt_permute>. You can turn on pass_through via C<$opt_pass_through>."
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=head2 GetOptionsWithCompletion"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "Usage:"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 " GetOptionsWithCompletion(\\&completion, [ \\%hash, ] @spec)"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "Exported on demand. Just like C<GetOptions>, except that it accepts an extra"
NSQ_SOURCE_LINE 00000324 "first argument C<\\&completion> containing completion routine for completing"
NSQ_SOURCE_LINE 00000325 "option I<values> and arguments. This will be passed as C<completion> argument to"
NSQ_SOURCE_LINE 00000326 "L<Complete::Getopt::Long>'s C<complete_cli_arg>. See that module's documentation"
NSQ_SOURCE_LINE 00000327 "on details of what is passed to the routine and what return value is expected"
NSQ_SOURCE_LINE 00000328 "from it."
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=head2 GetOptionsFromArray"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "Exported on demand. Will just call Getopt::Long's version."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "=head2 GetOptionsFromString"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "Exported on demand. Will just call Getopt::Long's version."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "=head2 Configure"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "Exported on demand. Will just call Getopt::Long's version."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "=head2 HelpMessage"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "Exported on demand. Will just call Getopt::Long's version."
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "=head2 VersionMessage"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "Exported on demand. Will just call Getopt::Long's version."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "Please visit the project's homepage at L<https://metacpan.org/release/Getopt-Long-Complete>."
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "Source repository is at L<https://github.com/perlancar/perl-Getopt-Long-Complete>."
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "L<Getopt::Long::More>, another drop-in replacement for Getopt::Long with tab"
NSQ_SOURCE_LINE 00000361 "completion support and more stuffs: default value, required value, summary in"
NSQ_SOURCE_LINE 00000362 "auto_help."
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "L<Complete::Getopt::Long> (the backend for this module), L<Complete::Bash>,"
NSQ_SOURCE_LINE 00000365 "L<Complete::Tcsh>."
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "L<Getopt::Long::Subcommand> also supports tab completion, in addition to"
NSQ_SOURCE_LINE 00000368 "subcommands."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "Other option-processing modules featuring shell tab completion:"
NSQ_SOURCE_LINE 00000371 "L<Getopt::Complete>."
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "L<Perinci::CmdLine> - an alternative way to easily create command-line"
NSQ_SOURCE_LINE 00000374 "applications with completion feature."
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "L<shcompgen>"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "L<Pod::Weaver::Section::Completion::GetoptLongComplete>"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "perlancar <perlancar@cpan.org>"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "=head1 CONTRIBUTOR"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "=for stopwords Steven Haryanto"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "Steven Haryanto <stevenharyanto@gmail.com>"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "=head1 CONTRIBUTING"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "To contribute, you can send patches by email/via RT, or send pull requests on"
NSQ_SOURCE_LINE 00000394 "GitHub."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "Most of the time, you don't need to build the distribution yourself. You can"
NSQ_SOURCE_LINE 00000397 "simply modify the code, then test via:"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 " % prove -l"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "If you want to build the distribution (e.g. to try to install it locally on your"
NSQ_SOURCE_LINE 00000402 "system), you can install L<Dist::Zilla>,"
NSQ_SOURCE_LINE 00000403 "L<Dist::Zilla::PluginBundle::Author::PERLANCAR>,"
NSQ_SOURCE_LINE 00000404 "L<Pod::Weaver::PluginBundle::Author::PERLANCAR>, and sometimes one or two other"
NSQ_SOURCE_LINE 00000405 "Dist::Zilla- and/or Pod::Weaver plugins. Any additional steps required beyond"
NSQ_SOURCE_LINE 00000406 "that are considered a bug and can be reported to me."
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "=head1 COPYRIGHT AND LICENSE"
NSQ_SOURCE_LINE 00000409 ""
