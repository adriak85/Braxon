NSQ_SOURCE_LINE 00000001 "use 5.006;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "package CPAN::Mini 1.111017;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "# ABSTRACT: create a minimal mirror of CPAN"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "## no critic RequireCarping"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "#pod =head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000012 "#pod"
NSQ_SOURCE_LINE 00000013 "#pod (If you're not going to do something weird, you probably want to look at the"
NSQ_SOURCE_LINE 00000014 "#pod L<minicpan> command, instead.)"
NSQ_SOURCE_LINE 00000015 "#pod"
NSQ_SOURCE_LINE 00000016 "#pod   use CPAN::Mini;"
NSQ_SOURCE_LINE 00000017 "#pod"
NSQ_SOURCE_LINE 00000018 "#pod   CPAN::Mini->update_mirror("
NSQ_SOURCE_LINE 00000019 "#pod     remote => \"http://cpan.mirrors.comintern.su\","
NSQ_SOURCE_LINE 00000020 "#pod     local  => \"/usr/share/mirrors/cpan\","
NSQ_SOURCE_LINE 00000021 "#pod     log_level => 'debug',"
NSQ_SOURCE_LINE 00000022 "#pod   );"
NSQ_SOURCE_LINE 00000023 "#pod"
NSQ_SOURCE_LINE 00000024 "#pod =head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000025 "#pod"
NSQ_SOURCE_LINE 00000026 "#pod CPAN::Mini provides a simple mechanism to build and update a minimal mirror of"
NSQ_SOURCE_LINE 00000027 "#pod the CPAN on your local disk.  It contains only those files needed to install"
NSQ_SOURCE_LINE 00000028 "#pod the newest version of every distribution.  Those files are:"
NSQ_SOURCE_LINE 00000029 "#pod"
NSQ_SOURCE_LINE 00000030 "#pod =for :list"
NSQ_SOURCE_LINE 00000031 "#pod * 01mailrc.txt.gz"
NSQ_SOURCE_LINE 00000032 "#pod * 02packages.details.txt.gz"
NSQ_SOURCE_LINE 00000033 "#pod * 03modlist.data.gz"
NSQ_SOURCE_LINE 00000034 "#pod * the last non-developer release of every dist for every author"
NSQ_SOURCE_LINE 00000035 "#pod"
NSQ_SOURCE_LINE 00000036 "#pod =cut"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "use Carp ();"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "use File::Basename ();"
NSQ_SOURCE_LINE 00000041 "use File::Copy     ();"
NSQ_SOURCE_LINE 00000042 "use File::HomeDir 0.57 ();  # Win32 support"
NSQ_SOURCE_LINE 00000043 "use File::Find ();"
NSQ_SOURCE_LINE 00000044 "use File::Path 2.04 ();     # new API, bugfixes"
NSQ_SOURCE_LINE 00000045 "use File::Spec ();"
NSQ_SOURCE_LINE 00000046 "use File::Temp ();"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "use URI 1            ();"
NSQ_SOURCE_LINE 00000049 "use LWP::UserAgent 5 ();"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "use Compress::Zlib 1.20 ();"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "#pod =method update_mirror"
NSQ_SOURCE_LINE 00000054 "#pod"
NSQ_SOURCE_LINE 00000055 "#pod   CPAN::Mini->update_mirror("
NSQ_SOURCE_LINE 00000056 "#pod     remote => \"http://cpan.mirrors.comintern.su\","
NSQ_SOURCE_LINE 00000057 "#pod     local  => \"/usr/share/mirrors/cpan\","
NSQ_SOURCE_LINE 00000058 "#pod     force  => 0,"
NSQ_SOURCE_LINE 00000059 "#pod     log_level => 'debug',"
NSQ_SOURCE_LINE 00000060 "#pod   );"
NSQ_SOURCE_LINE 00000061 "#pod"
NSQ_SOURCE_LINE 00000062 "#pod This is the only method that need be called from outside this module.  It will"
NSQ_SOURCE_LINE 00000063 "#pod update the local mirror with the files from the remote mirror."
NSQ_SOURCE_LINE 00000064 "#pod"
NSQ_SOURCE_LINE 00000065 "#pod If called as a class method, C<update_mirror> creates an ephemeral CPAN::Mini"
NSQ_SOURCE_LINE 00000066 "#pod object on which other methods are called.  That object is used to store mirror"
NSQ_SOURCE_LINE 00000067 "#pod location and state."
NSQ_SOURCE_LINE 00000068 "#pod"
NSQ_SOURCE_LINE 00000069 "#pod This method returns the number of files updated."
NSQ_SOURCE_LINE 00000070 "#pod"
NSQ_SOURCE_LINE 00000071 "#pod The following options are recognized:"
NSQ_SOURCE_LINE 00000072 "#pod"
NSQ_SOURCE_LINE 00000073 "#pod =begin :list"
NSQ_SOURCE_LINE 00000074 "#pod"
NSQ_SOURCE_LINE 00000075 "#pod * C<local>"
NSQ_SOURCE_LINE 00000076 "#pod"
NSQ_SOURCE_LINE 00000077 "#pod This is the local file path where the mirror will be written or updated."
NSQ_SOURCE_LINE 00000078 "#pod"
NSQ_SOURCE_LINE 00000079 "#pod * C<remote>"
NSQ_SOURCE_LINE 00000080 "#pod"
NSQ_SOURCE_LINE 00000081 "#pod This is the URL of the CPAN mirror from which to work.  A reasonable default"
NSQ_SOURCE_LINE 00000082 "#pod will be picked by default.  A list of CPAN mirrors can be found at"
NSQ_SOURCE_LINE 00000083 "#pod L<http://www.cpan.org/SITES.html>"
NSQ_SOURCE_LINE 00000084 "#pod"
NSQ_SOURCE_LINE 00000085 "#pod * C<dirmode>"
NSQ_SOURCE_LINE 00000086 "#pod"
NSQ_SOURCE_LINE 00000087 "#pod Generally an octal number, this option sets the permissions of created"
NSQ_SOURCE_LINE 00000088 "#pod directories.  It defaults to 0711."
NSQ_SOURCE_LINE 00000089 "#pod"
NSQ_SOURCE_LINE 00000090 "#pod * C<exact_mirror>"
NSQ_SOURCE_LINE 00000091 "#pod"
NSQ_SOURCE_LINE 00000092 "#pod If true, the C<file_allowed> method will allow all extra files to be mirrored."
NSQ_SOURCE_LINE 00000093 "#pod"
NSQ_SOURCE_LINE 00000094 "#pod * C<ignore_source_control>"
NSQ_SOURCE_LINE 00000095 "#pod"
NSQ_SOURCE_LINE 00000096 "#pod If true, CPAN::Mini will not try to remove source control files during"
NSQ_SOURCE_LINE 00000097 "#pod cleanup. See C<clean_unmirrored> for details."
NSQ_SOURCE_LINE 00000098 "#pod"
NSQ_SOURCE_LINE 00000099 "#pod * C<force>"
NSQ_SOURCE_LINE 00000100 "#pod"
NSQ_SOURCE_LINE 00000101 "#pod If true, this option will cause CPAN::Mini to read the entire module list and"
NSQ_SOURCE_LINE 00000102 "#pod update anything out of date, even if the module list itself wasn't out of date"
NSQ_SOURCE_LINE 00000103 "#pod on this run."
NSQ_SOURCE_LINE 00000104 "#pod"
NSQ_SOURCE_LINE 00000105 "#pod * C<skip_perl>"
NSQ_SOURCE_LINE 00000106 "#pod"
NSQ_SOURCE_LINE 00000107 "#pod If true, CPAN::Mini will skip the major language distributions: perl, parrot,"
NSQ_SOURCE_LINE 00000108 "#pod and ponie.  It will also skip embperl, sybperl, bioperl, and kurila."
NSQ_SOURCE_LINE 00000109 "#pod"
NSQ_SOURCE_LINE 00000110 "#pod * C<log_level>"
NSQ_SOURCE_LINE 00000111 "#pod"
NSQ_SOURCE_LINE 00000112 "#pod This defines the minimum level of message to log: debug, info, warn, or fatal"
NSQ_SOURCE_LINE 00000113 "#pod"
NSQ_SOURCE_LINE 00000114 "#pod * C<errors>"
NSQ_SOURCE_LINE 00000115 "#pod"
NSQ_SOURCE_LINE 00000116 "#pod If true, CPAN::Mini will warn with status messages on errors.  (default: true)"
NSQ_SOURCE_LINE 00000117 "#pod"
NSQ_SOURCE_LINE 00000118 "#pod * C<path_filters>"
NSQ_SOURCE_LINE 00000119 "#pod"
NSQ_SOURCE_LINE 00000120 "#pod This options provides a set of rules for filtering paths.  If a distribution"
NSQ_SOURCE_LINE 00000121 "#pod matches one of the rules in C<path_filters>, it will not be mirrored.  A regex"
NSQ_SOURCE_LINE 00000122 "#pod rule is matched if the path matches the regex; a code rule is matched if the"
NSQ_SOURCE_LINE 00000123 "#pod code returns 1 when the path is passed to it.  For example, the following"
NSQ_SOURCE_LINE 00000124 "#pod setting would skip all distributions from RJBS and SUNGO:"
NSQ_SOURCE_LINE 00000125 "#pod"
NSQ_SOURCE_LINE 00000126 "#pod  path_filters => ["
NSQ_SOURCE_LINE 00000127 "#pod    qr/RJBS/,"
NSQ_SOURCE_LINE 00000128 "#pod    sub { $_[0] =~ /SUNGO/ }"
NSQ_SOURCE_LINE 00000129 "#pod  ]"
NSQ_SOURCE_LINE 00000130 "#pod"
NSQ_SOURCE_LINE 00000131 "#pod * C<module_filters>"
NSQ_SOURCE_LINE 00000132 "#pod"
NSQ_SOURCE_LINE 00000133 "#pod This option provides a set of rules for filtering modules.  It behaves like"
NSQ_SOURCE_LINE 00000134 "#pod path_filters, but acts only on module names.  (Since most modules are in"
NSQ_SOURCE_LINE 00000135 "#pod distributions with more than one module, this setting will probably be less"
NSQ_SOURCE_LINE 00000136 "#pod useful than C<path_filters>.)  For example, this setting will skip any"
NSQ_SOURCE_LINE 00000137 "#pod distribution containing only modules with the word \"Acme\" in them:"
NSQ_SOURCE_LINE 00000138 "#pod"
NSQ_SOURCE_LINE 00000139 "#pod  module_filters => [ qr/Acme/i ]"
NSQ_SOURCE_LINE 00000140 "#pod"
NSQ_SOURCE_LINE 00000141 "#pod * C<also_mirror>"
NSQ_SOURCE_LINE 00000142 "#pod"
NSQ_SOURCE_LINE 00000143 "#pod This option should be an arrayref of extra files in the remote CPAN to mirror"
NSQ_SOURCE_LINE 00000144 "#pod locally."
NSQ_SOURCE_LINE 00000145 "#pod"
NSQ_SOURCE_LINE 00000146 "#pod * C<skip_cleanup>"
NSQ_SOURCE_LINE 00000147 "#pod"
NSQ_SOURCE_LINE 00000148 "#pod If this option is true, CPAN::Mini will not try delete unmirrored files when it"
NSQ_SOURCE_LINE 00000149 "#pod has finished mirroring"
NSQ_SOURCE_LINE 00000150 "#pod"
NSQ_SOURCE_LINE 00000151 "#pod * C<offline>"
NSQ_SOURCE_LINE 00000152 "#pod"
NSQ_SOURCE_LINE 00000153 "#pod If offline, CPAN::Mini will not attempt to contact remote resources."
NSQ_SOURCE_LINE 00000154 "#pod"
NSQ_SOURCE_LINE 00000155 "#pod * C<no_conn_cache>"
NSQ_SOURCE_LINE 00000156 "#pod"
NSQ_SOURCE_LINE 00000157 "#pod If true, no connection cache will be established.  This is mostly useful as a"
NSQ_SOURCE_LINE 00000158 "#pod workaround for connection cache failures."
NSQ_SOURCE_LINE 00000159 "#pod"
NSQ_SOURCE_LINE 00000160 "#pod =end :list"
NSQ_SOURCE_LINE 00000161 "#pod"
NSQ_SOURCE_LINE 00000162 "#pod =cut"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "sub update_mirror {"
NSQ_SOURCE_LINE 00000165 "  my $self = shift;"
NSQ_SOURCE_LINE 00000166 "  $self = $self->new(@_) unless ref $self;"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "  unless ($self->{offline}) {"
NSQ_SOURCE_LINE 00000169 "    my $local = $self->{local};"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    $self->log(\"Updating $local\");"
NSQ_SOURCE_LINE 00000172 "    $self->log(\"Mirroring from $self->{remote}\");"
NSQ_SOURCE_LINE 00000173 "    $self->log(\"=\" x 63);"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    die \"local mirror target $local is not writable\" unless -w $local;"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    # mirrored tracks the already done, keyed by filename"
NSQ_SOURCE_LINE 00000178 "    # 1 = local-checked, 2 = remote-mirrored"
NSQ_SOURCE_LINE 00000179 "    $self->mirror_indices;"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "    return unless $self->{force} or $self->{changes_made};"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    # mirror all the files"
NSQ_SOURCE_LINE 00000184 "    $self->_mirror_extras;"
NSQ_SOURCE_LINE 00000185 "    $self->mirror_file($_, 1) for @{ $self->_get_mirror_list };"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "    # install indices after files are mirrored in case we're interrupted"
NSQ_SOURCE_LINE 00000188 "    # so indices will seem new again when continuing"
NSQ_SOURCE_LINE 00000189 "    $self->_install_indices;"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "    $self->_write_out_recent;"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    # eliminate files we don't need"
NSQ_SOURCE_LINE 00000194 "    $self->clean_unmirrored unless $self->{skip_cleanup};"
NSQ_SOURCE_LINE 00000195 "  }"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "  return $self->{changes_made};"
NSQ_SOURCE_LINE 00000198 "}"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "sub _recent { $_[0]->{recent}{ $_[1] } = 1 }"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "sub _write_out_recent {"
NSQ_SOURCE_LINE 00000203 "  my ($self) = @_;"
NSQ_SOURCE_LINE 00000204 "  return unless my @keys = keys %{ $self->{recent} };"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "  my $recent = File::Spec->catfile($self->{local}, 'RECENT');"
NSQ_SOURCE_LINE 00000207 "  open my $recent_fh, '>', $recent or die \"can't open $recent for writing: $!\";"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "  for my $file (sort keys %{ $self->{recent} }) {"
NSQ_SOURCE_LINE 00000210 "    print {$recent_fh} \"$file\\n\" or die \"can't write to $recent: $!\";"
NSQ_SOURCE_LINE 00000211 "  }"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "  die \"error closing $recent: $!\" unless close $recent_fh;"
NSQ_SOURCE_LINE 00000214 "  return;"
NSQ_SOURCE_LINE 00000215 "}"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "sub _get_mirror_list {"
NSQ_SOURCE_LINE 00000218 "  my $self = shift;"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "  my %mirror_list;"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "  # now walk the packages list"
NSQ_SOURCE_LINE 00000223 "  my $details = File::Spec->catfile("
NSQ_SOURCE_LINE 00000224 "    $self->_scratch_dir,"
NSQ_SOURCE_LINE 00000225 "    qw(modules 02packages.details.txt.gz)"
NSQ_SOURCE_LINE 00000226 "  );"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "  my $gz = Compress::Zlib::gzopen($details, \"rb\")"
NSQ_SOURCE_LINE 00000229 "    or die \"Cannot open details: $Compress::Zlib::gzerrno\";"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "  my $inheader = 1;"
NSQ_SOURCE_LINE 00000232 "  my $file_ok  = 0;"
NSQ_SOURCE_LINE 00000233 "  while ($gz->gzreadline($_) > 0) {"
NSQ_SOURCE_LINE 00000234 "    if ($inheader) {"
NSQ_SOURCE_LINE 00000235 "      if (/\\S/) {"
NSQ_SOURCE_LINE 00000236 "        my ($header, $value) = split /:\\s*/, $_, 2;"
NSQ_SOURCE_LINE 00000237 "        chomp $value;"
NSQ_SOURCE_LINE 00000238 "        if ($header eq 'File'"
NSQ_SOURCE_LINE 00000239 "            and ($value eq '02packages.details.txt'"
NSQ_SOURCE_LINE 00000240 "                 or $value eq '02packages.details.txt.gz')) {"
NSQ_SOURCE_LINE 00000241 "          $file_ok = 1;"
NSQ_SOURCE_LINE 00000242 "        }"
NSQ_SOURCE_LINE 00000243 "      } else {"
NSQ_SOURCE_LINE 00000244 "        $inheader = 0;"
NSQ_SOURCE_LINE 00000245 "      }"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "      next;"
NSQ_SOURCE_LINE 00000248 "    }"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "    die \"02packages.details.txt file is not a valid index\\n\""
NSQ_SOURCE_LINE 00000251 "      unless $file_ok;"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "    my ($module, $version, $path) = split;"
NSQ_SOURCE_LINE 00000254 "    next if $self->_filter_module({"
NSQ_SOURCE_LINE 00000255 "      module  => $module,"
NSQ_SOURCE_LINE 00000256 "      version => $version,"
NSQ_SOURCE_LINE 00000257 "      path    => $path,"
NSQ_SOURCE_LINE 00000258 "    });"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "    $mirror_list{\"authors/id/$path\"}++;"
NSQ_SOURCE_LINE 00000261 "  }"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "  return [ sort keys %mirror_list ];"
NSQ_SOURCE_LINE 00000264 "}"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "#pod =method new"
NSQ_SOURCE_LINE 00000267 "#pod"
NSQ_SOURCE_LINE 00000268 "#pod   my $minicpan = CPAN::Mini->new;"
NSQ_SOURCE_LINE 00000269 "#pod"
NSQ_SOURCE_LINE 00000270 "#pod This method constructs a new CPAN::Mini object.  Its parameters are described"
NSQ_SOURCE_LINE 00000271 "#pod above, under C<update_mirror>."
NSQ_SOURCE_LINE 00000272 "#pod"
NSQ_SOURCE_LINE 00000273 "#pod =cut"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "sub new {"
NSQ_SOURCE_LINE 00000276 "  my $class    = shift;"
NSQ_SOURCE_LINE 00000277 "  my %defaults = ("
NSQ_SOURCE_LINE 00000278 "    changes_made => 0,"
NSQ_SOURCE_LINE 00000279 "    dirmode      => 0711,  ## no critic Zero"
NSQ_SOURCE_LINE 00000280 "    errors       => 1,"
NSQ_SOURCE_LINE 00000281 "    mirrored     => {},"
NSQ_SOURCE_LINE 00000282 "    log_level    => 'info',"
NSQ_SOURCE_LINE 00000283 "  );"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "  my $self = bless { %defaults, @_ } => $class;"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "  $self->{dirmode} = $defaults{dirmode} unless defined $self->{dirmode};"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "  $self->{recent} = {};"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "  Carp::croak \"no local mirror supplied\" unless $self->{local};"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "  substr($self->{local}, 0, 1, $class->__homedir)"
NSQ_SOURCE_LINE 00000294 "    if substr($self->{local}, 0, 1) eq q{~};"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "  $self->{local} = File::Spec->rel2abs($self->{local});"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "  Carp::croak \"local mirror path exists but is not a directory\""
NSQ_SOURCE_LINE 00000299 "    if (-e $self->{local})"
NSQ_SOURCE_LINE 00000300 "    and not(-d $self->{local});"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "  unless (-e $self->{local}) {"
NSQ_SOURCE_LINE 00000303 "    File::Path::mkpath("
NSQ_SOURCE_LINE 00000304 "      $self->{local},"
NSQ_SOURCE_LINE 00000305 "      {"
NSQ_SOURCE_LINE 00000306 "        verbose => $self->{log_level} eq 'debug',"
NSQ_SOURCE_LINE 00000307 "        mode    => $self->{dirmode},"
NSQ_SOURCE_LINE 00000308 "      },"
NSQ_SOURCE_LINE 00000309 "    );"
NSQ_SOURCE_LINE 00000310 "  }"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "  Carp::croak \"no write permission to local mirror\" unless -w $self->{local};"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "  Carp::croak \"no remote mirror supplied\" unless $self->{remote};"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "  $self->{remote} = \"$self->{remote}/\" if substr($self->{remote}, -1) ne '/';"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "  my $version = $class->VERSION;"
NSQ_SOURCE_LINE 00000319 "  $version = 'v?' unless defined $version;"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "  $self->{__lwp} = LWP::UserAgent->new("
NSQ_SOURCE_LINE 00000322 "    agent     => \"$class/$version\","
NSQ_SOURCE_LINE 00000323 "    env_proxy => 1,"
NSQ_SOURCE_LINE 00000324 "    ($self->{no_conn_cache} ? () : (keep_alive => 5)),"
NSQ_SOURCE_LINE 00000325 "    ($self->{timeout} ? (timeout => $self->{timeout}) : ()),"
NSQ_SOURCE_LINE 00000326 "  );"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "  unless ($self->{offline}) {"
NSQ_SOURCE_LINE 00000329 "    my $test_uri = URI->new_abs("
NSQ_SOURCE_LINE 00000330 "      'modules/02packages.details.txt.gz',"
NSQ_SOURCE_LINE 00000331 "      $self->{remote},"
NSQ_SOURCE_LINE 00000332 "    )->as_string;"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "    Carp::croak \"unable to contact the remote mirror\""
NSQ_SOURCE_LINE 00000335 "      unless eval { $self->__lwp->head($test_uri)->is_success };"
NSQ_SOURCE_LINE 00000336 "  }"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "  return $self;"
NSQ_SOURCE_LINE 00000339 "}"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "sub __lwp { $_[0]->{__lwp} }"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "#pod =method mirror_indices"
NSQ_SOURCE_LINE 00000344 "#pod"
NSQ_SOURCE_LINE 00000345 "#pod   $minicpan->mirror_indices;"
NSQ_SOURCE_LINE 00000346 "#pod"
NSQ_SOURCE_LINE 00000347 "#pod This method updates the index files from the CPAN."
NSQ_SOURCE_LINE 00000348 "#pod"
NSQ_SOURCE_LINE 00000349 "#pod =cut"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "sub _fixed_mirrors {"
NSQ_SOURCE_LINE 00000352 "  qw("
NSQ_SOURCE_LINE 00000353 "    authors/01mailrc.txt.gz"
NSQ_SOURCE_LINE 00000354 "    modules/02packages.details.txt.gz"
NSQ_SOURCE_LINE 00000355 "    modules/03modlist.data.gz"
NSQ_SOURCE_LINE 00000356 "  );"
NSQ_SOURCE_LINE 00000357 "}"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "sub _scratch_dir {"
NSQ_SOURCE_LINE 00000360 "  my ($self) = @_;"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "  $self->{scratch} ||= File::Temp::tempdir(CLEANUP => 1);"
NSQ_SOURCE_LINE 00000363 "  return $self->{scratch};"
NSQ_SOURCE_LINE 00000364 "}"
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "sub mirror_indices {"
NSQ_SOURCE_LINE 00000367 "  my $self = shift;"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "  $self->_make_index_dirs($self->_scratch_dir);"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "  for my $path ($self->_fixed_mirrors) {"
NSQ_SOURCE_LINE 00000372 "    my $local_file   = File::Spec->catfile($self->{local},   split m{/}, $path);"
NSQ_SOURCE_LINE 00000373 "    my $scratch_file = File::Spec->catfile("
NSQ_SOURCE_LINE 00000374 "      $self->_scratch_dir,"
NSQ_SOURCE_LINE 00000375 "      split(m{/}, $path),"
NSQ_SOURCE_LINE 00000376 "    );"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "    File::Copy::copy($local_file, $scratch_file);"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "    utime((stat $local_file)[ 8, 9 ], $scratch_file);"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "    $self->mirror_file($path, undef, { to_scratch => 1 });"
NSQ_SOURCE_LINE 00000383 "  }"
NSQ_SOURCE_LINE 00000384 "}"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "sub _mirror_extras {"
NSQ_SOURCE_LINE 00000387 "  my $self = shift;"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "  for my $path (@{ $self->{also_mirror} }) {"
NSQ_SOURCE_LINE 00000390 "    $self->mirror_file($path, undef);"
NSQ_SOURCE_LINE 00000391 "  }"
NSQ_SOURCE_LINE 00000392 "}"
NSQ_SOURCE_LINE 00000393 ""
NSQ_SOURCE_LINE 00000394 "sub _make_index_dirs {"
NSQ_SOURCE_LINE 00000395 "  my ($self, $base_dir, $dir_mode, $trace) = @_;"
NSQ_SOURCE_LINE 00000396 "  $base_dir ||= $self->_scratch_dir;"
NSQ_SOURCE_LINE 00000397 "  $dir_mode = 0711 if !defined $dir_mode;  ## no critic Zero"
NSQ_SOURCE_LINE 00000398 "  $trace    = 0    if !defined $trace;"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "  for my $index ($self->_fixed_mirrors) {"
NSQ_SOURCE_LINE 00000401 "    my $dir = File::Basename::dirname($index);"
NSQ_SOURCE_LINE 00000402 "    my $needed = File::Spec->catdir($base_dir, $dir);"
NSQ_SOURCE_LINE 00000403 "    File::Path::mkpath($needed, { verbose => $trace, mode => $dir_mode });"
NSQ_SOURCE_LINE 00000404 "    die \"couldn't create $needed: $!\" unless -d $needed;"
NSQ_SOURCE_LINE 00000405 "  }"
NSQ_SOURCE_LINE 00000406 "}"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "sub _install_indices {"
NSQ_SOURCE_LINE 00000409 "  my $self = shift;"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "  $self->_make_index_dirs("
NSQ_SOURCE_LINE 00000412 "    $self->{local},"
NSQ_SOURCE_LINE 00000413 "    $self->{dirmode},"
NSQ_SOURCE_LINE 00000414 "    $self->{log_level} eq 'debug',"
NSQ_SOURCE_LINE 00000415 "  );"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "  for my $file ($self->_fixed_mirrors) {"
NSQ_SOURCE_LINE 00000418 "    my $local_file = File::Spec->catfile($self->{local}, split m{/}, $file);"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "    unlink $local_file;"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "    File::Copy::copy("
NSQ_SOURCE_LINE 00000423 "      File::Spec->catfile($self->_scratch_dir, split m{/}, $file),"
NSQ_SOURCE_LINE 00000424 "      $local_file,"
NSQ_SOURCE_LINE 00000425 "    );"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "    $self->{mirrored}{$local_file} = 1;"
NSQ_SOURCE_LINE 00000428 "  }"
NSQ_SOURCE_LINE 00000429 "}"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "#pod =method mirror_file"
NSQ_SOURCE_LINE 00000432 "#pod"
NSQ_SOURCE_LINE 00000433 "#pod   $minicpan->mirror_file($path, $skip_if_present)"
NSQ_SOURCE_LINE 00000434 "#pod"
NSQ_SOURCE_LINE 00000435 "#pod This method will mirror the given file from the remote to the local mirror,"
NSQ_SOURCE_LINE 00000436 "#pod overwriting any existing file unless C<$skip_if_present> is true."
NSQ_SOURCE_LINE 00000437 "#pod"
NSQ_SOURCE_LINE 00000438 "#pod =cut"
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "sub mirror_file {"
NSQ_SOURCE_LINE 00000441 "  my ($self, $path, $skip_if_present, $arg) = @_;"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "  $arg ||= {};"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "  # full URL"
NSQ_SOURCE_LINE 00000446 "  my $remote_uri = eval { $path->isa('URI') }"
NSQ_SOURCE_LINE 00000447 "                 ? $path"
NSQ_SOURCE_LINE 00000448 "                 : URI->new_abs($path, $self->{remote})->as_string;"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "  # native absolute file"
NSQ_SOURCE_LINE 00000451 "  my $local_file = File::Spec->catfile("
NSQ_SOURCE_LINE 00000452 "    $arg->{to_scratch} ? $self->_scratch_dir : $self->{local},"
NSQ_SOURCE_LINE 00000453 "    split m{/}, $path"
NSQ_SOURCE_LINE 00000454 "  );"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "  my $checksum_might_be_up_to_date = 1;"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "  if ($skip_if_present and -f $local_file) {"
NSQ_SOURCE_LINE 00000459 "    ## upgrade to checked if not already"
NSQ_SOURCE_LINE 00000460 "    $self->{mirrored}{$local_file} ||= 1;"
NSQ_SOURCE_LINE 00000461 "  } elsif (($self->{mirrored}{$local_file} || 0) < 2) {"
NSQ_SOURCE_LINE 00000462 "    ## upgrade to full mirror"
NSQ_SOURCE_LINE 00000463 "    $self->{mirrored}{$local_file} = 2;"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "    File::Path::mkpath("
NSQ_SOURCE_LINE 00000466 "      File::Basename::dirname($local_file),"
NSQ_SOURCE_LINE 00000467 "      {"
NSQ_SOURCE_LINE 00000468 "        verbose => $self->{log_level} eq 'debug',"
NSQ_SOURCE_LINE 00000469 "        mode    => $self->{dirmode},"
NSQ_SOURCE_LINE 00000470 "      },"
NSQ_SOURCE_LINE 00000471 "    );"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "    $self->log($path, { no_nl => 1 });"
NSQ_SOURCE_LINE 00000474 "    my $res = eval { $self->{__lwp}->mirror($remote_uri, $local_file) };"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "    if (! $res) {"
NSQ_SOURCE_LINE 00000477 "      my $error = $@ || \"(unknown error)\";"
NSQ_SOURCE_LINE 00000478 "      $self->log(\" ... resulted in an HTTP client error\");"
NSQ_SOURCE_LINE 00000479 "      $self->log_warn(\"$remote_uri: $error\");"
NSQ_SOURCE_LINE 00000480 "      return;"
NSQ_SOURCE_LINE 00000481 "    } elsif ($res->is_success) {"
NSQ_SOURCE_LINE 00000482 "      utime undef, undef, $local_file if $arg->{update_times};"
NSQ_SOURCE_LINE 00000483 "      $checksum_might_be_up_to_date = 0;"
NSQ_SOURCE_LINE 00000484 "      $self->_recent($path);"
NSQ_SOURCE_LINE 00000485 "      $self->log(\" ... updated\");"
NSQ_SOURCE_LINE 00000486 "      $self->{changes_made}++;"
NSQ_SOURCE_LINE 00000487 "    } elsif ($res->code != 304) {  # not modified"
NSQ_SOURCE_LINE 00000488 "      $self->log(\" ... resulted in an HTTP error with status \" . $res->code);"
NSQ_SOURCE_LINE 00000489 "      $self->log_warn(\"$remote_uri: \" . $res->status_line);"
NSQ_SOURCE_LINE 00000490 "      return;"
NSQ_SOURCE_LINE 00000491 "    } else {"
NSQ_SOURCE_LINE 00000492 "      $self->log(\" ... up to date\");"
NSQ_SOURCE_LINE 00000493 "    }"
NSQ_SOURCE_LINE 00000494 "  }"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "  if ($path =~ m{^authors/id}) {   # maybe fetch CHECKSUMS"
NSQ_SOURCE_LINE 00000497 "    my $checksum_path"
NSQ_SOURCE_LINE 00000498 "      = URI->new_abs(\"CHECKSUMS\", $remote_uri)->rel($self->{remote})->as_string;"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "    if ($path ne $checksum_path) {"
NSQ_SOURCE_LINE 00000501 "      $self->mirror_file($checksum_path, $checksum_might_be_up_to_date);"
NSQ_SOURCE_LINE 00000502 "    }"
NSQ_SOURCE_LINE 00000503 "  }"
NSQ_SOURCE_LINE 00000504 "}"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "#pod =begin devel"
NSQ_SOURCE_LINE 00000507 "#pod"
NSQ_SOURCE_LINE 00000508 "#pod =method _filter_module"
NSQ_SOURCE_LINE 00000509 "#pod"
NSQ_SOURCE_LINE 00000510 "#pod  next"
NSQ_SOURCE_LINE 00000511 "#pod    if $self->_filter_module({ module => $foo, version => $foo, path => $foo });"
NSQ_SOURCE_LINE 00000512 "#pod"
NSQ_SOURCE_LINE 00000513 "#pod This method holds the filter chain logic. C<update_mirror> takes an optional"
NSQ_SOURCE_LINE 00000514 "#pod set of filter parameters.  As C<update_mirror> encounters a distribution, it"
NSQ_SOURCE_LINE 00000515 "#pod calls this method to figure out whether or not it should be downloaded. The"
NSQ_SOURCE_LINE 00000516 "#pod user provided filters are taken into account. Returns 1 if the distribution is"
NSQ_SOURCE_LINE 00000517 "#pod filtered (to be skipped).  Returns 0 if the distribution is to not filtered"
NSQ_SOURCE_LINE 00000518 "#pod (not to be skipped)."
NSQ_SOURCE_LINE 00000519 "#pod"
NSQ_SOURCE_LINE 00000520 "#pod =end devel"
NSQ_SOURCE_LINE 00000521 "#pod"
NSQ_SOURCE_LINE 00000522 "#pod =cut"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "sub __do_filter {"
NSQ_SOURCE_LINE 00000525 "  my ($self, $what, $filter, $file) = @_;"
NSQ_SOURCE_LINE 00000526 "  return unless $filter;"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "  if (ref($filter) eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000529 "    for (@$filter) {"
NSQ_SOURCE_LINE 00000530 "      return 1 if $self->__do_filter($what, $_, $file);"
NSQ_SOURCE_LINE 00000531 "    }"
NSQ_SOURCE_LINE 00000532 "    return;"
NSQ_SOURCE_LINE 00000533 "  }"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "  my $match;"
NSQ_SOURCE_LINE 00000536 "  if (ref($filter) eq 'CODE') {"
NSQ_SOURCE_LINE 00000537 "    $match = $filter->($file);"
NSQ_SOURCE_LINE 00000538 "  } else {"
NSQ_SOURCE_LINE 00000539 "    $match = $file =~ $filter;"
NSQ_SOURCE_LINE 00000540 "  }"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "  $self->log_debug(\"skipping $file because $what matches $filter\") if $match;"
NSQ_SOURCE_LINE 00000543 "  return 1 if $match;"
NSQ_SOURCE_LINE 00000544 "  return;"
NSQ_SOURCE_LINE 00000545 "}"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "sub _filter_module {"
NSQ_SOURCE_LINE 00000548 "  my $self = shift;"
NSQ_SOURCE_LINE 00000549 "  my $args = shift;"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "  if ($self->{skip_perl}) {"
NSQ_SOURCE_LINE 00000552 "    return 1 if $args->{path} =~ m{/(?:emb|syb|bio)?perl-\\d}i;"
NSQ_SOURCE_LINE 00000553 "    return 1 if $args->{path} =~ m{/(?:parrot|ponie)-\\d}i;"
NSQ_SOURCE_LINE 00000554 "    return 1 if $args->{path} =~ m{/(?:kurila)-\\d}i;"
NSQ_SOURCE_LINE 00000555 "    return 1 if $args->{path} =~ m{/\\bperl-?5\\.004}i;"
NSQ_SOURCE_LINE 00000556 "    return 1 if $args->{path} =~ m{/\\bperl_mlb\\.zip}i;"
NSQ_SOURCE_LINE 00000557 "  }"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "  return 1 if $self->__do_filter(path   => $self->{path_filters}, $args->{path});"
NSQ_SOURCE_LINE 00000560 "  return 1 if $self->__do_filter(module => $self->{module_filters}, $args->{module});"
NSQ_SOURCE_LINE 00000561 "  return 0;"
NSQ_SOURCE_LINE 00000562 "}"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "#pod =method file_allowed"
NSQ_SOURCE_LINE 00000565 "#pod"
NSQ_SOURCE_LINE 00000566 "#pod   next unless $minicpan->file_allowed($filename);"
NSQ_SOURCE_LINE 00000567 "#pod"
NSQ_SOURCE_LINE 00000568 "#pod This method returns true if the given file is allowed to exist in the local"
NSQ_SOURCE_LINE 00000569 "#pod mirror, even if it isn't one of the required mirror files."
NSQ_SOURCE_LINE 00000570 "#pod"
NSQ_SOURCE_LINE 00000571 "#pod By default, only dot-files are allowed.  If the C<exact_mirror> option is true,"
NSQ_SOURCE_LINE 00000572 "#pod all files are allowed."
NSQ_SOURCE_LINE 00000573 "#pod"
NSQ_SOURCE_LINE 00000574 "#pod =cut"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "sub file_allowed {"
NSQ_SOURCE_LINE 00000577 "  my ($self, $file) = @_;"
NSQ_SOURCE_LINE 00000578 "  return 1 if $self->{exact_mirror};"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "  # It's a cheap hack, but it gets the job done."
NSQ_SOURCE_LINE 00000581 "  return 1 if $file eq File::Spec->catfile($self->{local}, 'RECENT');"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "  return (substr(File::Basename::basename($file), 0, 1) eq q{.}) ? 1 : 0;"
NSQ_SOURCE_LINE 00000584 "}"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "#pod =method clean_unmirrored"
NSQ_SOURCE_LINE 00000587 "#pod"
NSQ_SOURCE_LINE 00000588 "#pod   $minicpan->clean_unmirrored;"
NSQ_SOURCE_LINE 00000589 "#pod"
NSQ_SOURCE_LINE 00000590 "#pod This method looks through the local mirror's files.  If it finds a file that"
NSQ_SOURCE_LINE 00000591 "#pod neither belongs in the mirror nor is allowed (see the C<file_allowed> method),"
NSQ_SOURCE_LINE 00000592 "#pod C<clean_file> is called on the file."
NSQ_SOURCE_LINE 00000593 "#pod"
NSQ_SOURCE_LINE 00000594 "#pod If you set C<ignore_source_control> to a true value, then this doesn't clean"
NSQ_SOURCE_LINE 00000595 "#pod up files that belong to source control systems. Currently this ignores:"
NSQ_SOURCE_LINE 00000596 "#pod"
NSQ_SOURCE_LINE 00000597 "#pod \t.cvs .cvsignore"
NSQ_SOURCE_LINE 00000598 "#pod \t.svn .svnignore"
NSQ_SOURCE_LINE 00000599 "#pod \t.git .gitignore"
NSQ_SOURCE_LINE 00000600 "#pod"
NSQ_SOURCE_LINE 00000601 "#pod Send patches for other source control files that you would like to have added."
NSQ_SOURCE_LINE 00000602 "#pod"
NSQ_SOURCE_LINE 00000603 "#pod =cut"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "my %Source_control_files;"
NSQ_SOURCE_LINE 00000606 "BEGIN {"
NSQ_SOURCE_LINE 00000607 "  %Source_control_files = map { $_ => 1 }"
NSQ_SOURCE_LINE 00000608 "    qw(.cvs .svn .git .cvsignore .svnignore .gitignore);"
NSQ_SOURCE_LINE 00000609 "}"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "sub clean_unmirrored {"
NSQ_SOURCE_LINE 00000612 "  my $self = shift;"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "  File::Find::find sub {"
NSQ_SOURCE_LINE 00000615 "    my $file = File::Spec->canonpath($File::Find::name);  ## no critic Package"
NSQ_SOURCE_LINE 00000616 "    my $basename = File::Basename::basename( $file );"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "    if ("
NSQ_SOURCE_LINE 00000619 "      $self->{ignore_source_control}"
NSQ_SOURCE_LINE 00000620 "      and exists $Source_control_files{$basename}"
NSQ_SOURCE_LINE 00000621 "    ) {"
NSQ_SOURCE_LINE 00000622 "      $File::Find::prune = 1;"
NSQ_SOURCE_LINE 00000623 "      return;"
NSQ_SOURCE_LINE 00000624 "    }"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "    return unless (-f $file and not $self->{mirrored}{$file});"
NSQ_SOURCE_LINE 00000627 "    return if $self->file_allowed($file);"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "    $self->clean_file($file);"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "  }, $self->{local};"
NSQ_SOURCE_LINE 00000632 "}"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "#pod =method clean_file"
