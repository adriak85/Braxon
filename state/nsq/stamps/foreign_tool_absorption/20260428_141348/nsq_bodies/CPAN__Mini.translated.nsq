NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "sub read_config {"
NSQ_SOURCE_LINE 00000739 "  my ($class, $options) = @_;"
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "  my $config_file = $class->config_file($options);"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "  return unless defined $config_file;"
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "  # This is ugly, but lets us respect -qq for now even before we have an"
NSQ_SOURCE_LINE 00000746 "  # object.  I think a better fix is warranted. -- rjbs, 2010-03-04"
NSQ_SOURCE_LINE 00000747 "  $class->log(\"Using config from $config_file\")"
NSQ_SOURCE_LINE 00000748 "    if ($options->{log_level}||'info') =~ /\\A(?:warn|fatal)\\z/;"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "  substr($config_file, 0, 1, $class->__homedir)"
NSQ_SOURCE_LINE 00000751 "    if substr($config_file, 0, 1) eq q{~};"
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "  return unless -e $config_file;"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "  open my $config_fh, '<', $config_file"
NSQ_SOURCE_LINE 00000756 "    or die \"couldn't open config file $config_file: $!\";"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "  my %config;"
NSQ_SOURCE_LINE 00000759 "  my %is_multivalue = map {; $_ => 1 }"
NSQ_SOURCE_LINE 00000760 "                      qw(also_mirror module_filters path_filters);"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "  $config{$_} = [] for keys %is_multivalue;"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "  while (<$config_fh>) {"
NSQ_SOURCE_LINE 00000765 "    chomp;"
NSQ_SOURCE_LINE 00000766 "    next if /\\A\\s*\\Z/sm;"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "    if (/\\A(\\w+):\\s*(\\S.*?)\\s*\\Z/sm) {"
NSQ_SOURCE_LINE 00000769 "      my ($key, $value) = ($1, $2);"
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "      if ($is_multivalue{ $key }) {"
NSQ_SOURCE_LINE 00000772 "        push @{ $config{$key} }, split /\\s+/, $value;"
NSQ_SOURCE_LINE 00000773 "      } else {"
NSQ_SOURCE_LINE 00000774 "        $config{ $key } = $value;"
NSQ_SOURCE_LINE 00000775 "      }"
NSQ_SOURCE_LINE 00000776 "    }"
NSQ_SOURCE_LINE 00000777 "  }"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "  for (qw(also_mirror)) {"
NSQ_SOURCE_LINE 00000780 "    $config{$_} = [ grep { length } @{ $config{$_} } ];"
NSQ_SOURCE_LINE 00000781 "  }"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "  for (qw(module_filters path_filters)) {"
NSQ_SOURCE_LINE 00000784 "    $config{$_} = [ map { qr/$_/ } @{ $config{$_} } ];"
NSQ_SOURCE_LINE 00000785 "  }"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "  for (keys %is_multivalue) {"
NSQ_SOURCE_LINE 00000788 "    delete $config{$_} unless @{ $config{$_} };"
NSQ_SOURCE_LINE 00000789 "  }"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "  return %config;"
NSQ_SOURCE_LINE 00000792 "}"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "#pod =method config_file"
NSQ_SOURCE_LINE 00000795 "#pod"
NSQ_SOURCE_LINE 00000796 "#pod   my $config_file = CPAN::Mini->config_file( { options } );"
NSQ_SOURCE_LINE 00000797 "#pod"
NSQ_SOURCE_LINE 00000798 "#pod This routine returns the config file name. It first looks at for the"
NSQ_SOURCE_LINE 00000799 "#pod C<config_file> setting, then the C<CPAN_MINI_CONFIG> environment"
NSQ_SOURCE_LINE 00000800 "#pod variable, then the default F<~/.minicpanrc>, and finally the"
NSQ_SOURCE_LINE 00000801 "#pod F<CPAN/Mini/minicpan.conf>. It uses the first defined value it finds."
NSQ_SOURCE_LINE 00000802 "#pod If the filename it selects does not exist, it returns false."
NSQ_SOURCE_LINE 00000803 "#pod"
NSQ_SOURCE_LINE 00000804 "#pod OPTIONS is an optional hash reference of the C<CPAN::Mini> config hash."
NSQ_SOURCE_LINE 00000805 "#pod"
NSQ_SOURCE_LINE 00000806 "#pod =cut"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "sub config_file {"
NSQ_SOURCE_LINE 00000809 "  my ($class, $options) = @_;"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "  my $config_file = do {"
NSQ_SOURCE_LINE 00000812 "    if (defined eval { $options->{config_file} }) {"
NSQ_SOURCE_LINE 00000813 "      $options->{config_file};"
NSQ_SOURCE_LINE 00000814 "    } elsif (defined $ENV{CPAN_MINI_CONFIG}) {"
NSQ_SOURCE_LINE 00000815 "      $ENV{CPAN_MINI_CONFIG};"
NSQ_SOURCE_LINE 00000816 "    } elsif (defined $class->__homedir_configfile) {"
NSQ_SOURCE_LINE 00000817 "      $class->__homedir_configfile;"
NSQ_SOURCE_LINE 00000818 "    } elsif (defined $class->__default_configfile) {"
NSQ_SOURCE_LINE 00000819 "      $class->__default_configfile;"
NSQ_SOURCE_LINE 00000820 "    } else {"
NSQ_SOURCE_LINE 00000821 "      ();"
NSQ_SOURCE_LINE 00000822 "    }"
NSQ_SOURCE_LINE 00000823 "  };"
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "  return ("
NSQ_SOURCE_LINE 00000826 "    (defined $config_file && -e $config_file)"
NSQ_SOURCE_LINE 00000827 "    ? $config_file"
NSQ_SOURCE_LINE 00000828 "    : ()"
NSQ_SOURCE_LINE 00000829 "  );"
NSQ_SOURCE_LINE 00000830 "}"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "#pod =head2 remote_from"
NSQ_SOURCE_LINE 00000833 "#pod"
NSQ_SOURCE_LINE 00000834 "#pod   my $remote = CPAN::Mini->remote_from( $remote_from, $orig_remote, $quiet );"
NSQ_SOURCE_LINE 00000835 "#pod"
NSQ_SOURCE_LINE 00000836 "#pod This routine take an string argument and turn it into a method"
NSQ_SOURCE_LINE 00000837 "#pod call to handle to retrieve the a cpan mirror url from a source."
NSQ_SOURCE_LINE 00000838 "#pod Currently supported methods:"
NSQ_SOURCE_LINE 00000839 "#pod"
NSQ_SOURCE_LINE 00000840 "#pod     cpan     - fetch the first mirror from your CPAN.pm config"
NSQ_SOURCE_LINE 00000841 "#pod     cpanplus - fetch the first mirror from your CPANPLUS.pm config"
NSQ_SOURCE_LINE 00000842 "#pod"
NSQ_SOURCE_LINE 00000843 "#pod =cut"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "sub remote_from {"
NSQ_SOURCE_LINE 00000846 "  my ( $class, $remote_from, $orig_remote, $quiet ) = @_;"
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "  my $method = lc \"remote_from_\" . $remote_from;"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "  Carp::croak \"unknown remote_from value: $remote_from\""
NSQ_SOURCE_LINE 00000851 "    unless $class->can($method);"
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "  my $new_remote = $class->$method;"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "  warn \"overriding '$orig_remote' with '$new_remote' via $method\\n\""
NSQ_SOURCE_LINE 00000856 "    if !$quiet && $orig_remote;"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "  return $new_remote;"
NSQ_SOURCE_LINE 00000859 "}"
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "#pod =head2 remote_from_cpan"
NSQ_SOURCE_LINE 00000862 "#pod"
NSQ_SOURCE_LINE 00000863 "#pod   my $remote = CPAN::Mini->remote_from_cpan;"
NSQ_SOURCE_LINE 00000864 "#pod"
NSQ_SOURCE_LINE 00000865 "#pod This routine loads your CPAN.pm config and returns the first mirror in mirror"
NSQ_SOURCE_LINE 00000866 "#pod list.  You can set this as your default by setting remote_from:cpan in your"
NSQ_SOURCE_LINE 00000867 "#pod F<.minicpanrc> file."
NSQ_SOURCE_LINE 00000868 "#pod"
NSQ_SOURCE_LINE 00000869 "#pod =cut"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "sub remote_from_cpan {"
NSQ_SOURCE_LINE 00000872 "  my ($self) = @_;"
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "  Carp::croak \"unable find a CPAN, maybe you need to install it\""
NSQ_SOURCE_LINE 00000875 "    unless eval { require CPAN; 1 };"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "  CPAN::HandleConfig::require_myconfig_or_config();"
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 "  Carp::croak \"unable to find mirror list in your CPAN config\""
NSQ_SOURCE_LINE 00000880 "    unless exists $CPAN::Config->{urllist};"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "  Carp::croak \"unable to find first mirror url in your CPAN config\""
NSQ_SOURCE_LINE 00000883 "    unless ref( $CPAN::Config->{urllist} ) eq 'ARRAY' && $CPAN::Config->{urllist}[0];"
NSQ_SOURCE_LINE 00000884 ""
NSQ_SOURCE_LINE 00000885 "  return $CPAN::Config->{urllist}[0];"
NSQ_SOURCE_LINE 00000886 "}"
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "#pod =head2 remote_from_cpanplus"
NSQ_SOURCE_LINE 00000889 "#pod"
NSQ_SOURCE_LINE 00000890 "#pod   my $remote = CPAN::Mini->remote_from_cpanplus;"
NSQ_SOURCE_LINE 00000891 "#pod"
NSQ_SOURCE_LINE 00000892 "#pod This routine loads your CPANPLUS.pm config and returns the first mirror in"
NSQ_SOURCE_LINE 00000893 "#pod mirror list.  You can set this as your default by setting remote_from:cpanplus"
NSQ_SOURCE_LINE 00000894 "#pod in your F<.minicpanrc> file."
NSQ_SOURCE_LINE 00000895 "#pod"
NSQ_SOURCE_LINE 00000896 "#pod =cut"
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "sub remote_from_cpanplus {"
NSQ_SOURCE_LINE 00000899 "  my ($self) = @_;"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "  Carp::croak \"unable find a CPANPLUS, maybe you need to install it\""
NSQ_SOURCE_LINE 00000902 "    unless eval { require CPANPLUS::Backend };"
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "  my $cb = CPANPLUS::Backend->new;"
NSQ_SOURCE_LINE 00000905 "  my $hosts = $cb->configure_object->get_conf('hosts');"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "  Carp::croak \"unable to find mirror list in your CPANPLUS config\""
NSQ_SOURCE_LINE 00000908 "    unless $hosts;"
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "  Carp::croak \"unable to find first mirror in your CPANPLUS config\""
NSQ_SOURCE_LINE 00000911 "    unless ref($hosts) eq 'ARRAY' && $hosts->[0];"
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "  my $url_parts = $hosts->[0];"
NSQ_SOURCE_LINE 00000914 "  return $url_parts->{scheme} . \"://\" . $url_parts->{host} . ( $url_parts->{path} || '' );"
NSQ_SOURCE_LINE 00000915 "}"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "#pod =head1 SEE ALSO"
NSQ_SOURCE_LINE 00000918 "#pod"
NSQ_SOURCE_LINE 00000919 "#pod Randal Schwartz's original article on minicpan, here:"
NSQ_SOURCE_LINE 00000920 "#pod"
NSQ_SOURCE_LINE 00000921 "#pod \thttp://www.stonehenge.com/merlyn/LinuxMag/col42.html"
NSQ_SOURCE_LINE 00000922 "#pod"
NSQ_SOURCE_LINE 00000923 "#pod L<CPANPLUS::Backend>, which provides the C<local_mirror> method, which performs"
NSQ_SOURCE_LINE 00000924 "#pod the same task as this module."
NSQ_SOURCE_LINE 00000925 "#pod"
NSQ_SOURCE_LINE 00000926 "#pod =head1 THANKS"
NSQ_SOURCE_LINE 00000927 "#pod"
NSQ_SOURCE_LINE 00000928 "#pod Thanks to David Dyck for letting me know about my stupid documentation errors."
NSQ_SOURCE_LINE 00000929 "#pod"
NSQ_SOURCE_LINE 00000930 "#pod Thanks to Roy Fulbright for finding an obnoxious bug on Win32."
NSQ_SOURCE_LINE 00000931 "#pod"
NSQ_SOURCE_LINE 00000932 "#pod Thanks to Shawn Sorichetti for fixing a stupid octal-number-as-string bug."
NSQ_SOURCE_LINE 00000933 "#pod"
NSQ_SOURCE_LINE 00000934 "#pod Thanks to sungo for implementing the filters, so I can finally stop mirroring"
NSQ_SOURCE_LINE 00000935 "#pod bioperl, and Robert Rothenberg for suggesting adding coderef rules."
NSQ_SOURCE_LINE 00000936 "#pod"
NSQ_SOURCE_LINE 00000937 "#pod Thanks to Adam Kennedy for noticing and complaining about a lot of stupid"
NSQ_SOURCE_LINE 00000938 "#pod little design decisions."
NSQ_SOURCE_LINE 00000939 "#pod"
NSQ_SOURCE_LINE 00000940 "#pod Thanks to Michael Schwern and Jason Kohles, for pointing out missing"
NSQ_SOURCE_LINE 00000941 "#pod documentation."
NSQ_SOURCE_LINE 00000942 "#pod"
NSQ_SOURCE_LINE 00000943 "#pod Thanks to David Golden for some important bugfixes and refactoring."
NSQ_SOURCE_LINE 00000944 "#pod"
NSQ_SOURCE_LINE 00000945 "#pod =cut"
NSQ_SOURCE_LINE 00000946 ""
NSQ_SOURCE_LINE 00000947 "1;"
NSQ_SOURCE_LINE 00000948 ""
NSQ_SOURCE_LINE 00000949 "__END__"
NSQ_SOURCE_LINE 00000950 ""
NSQ_SOURCE_LINE 00000951 "=pod"
NSQ_SOURCE_LINE 00000952 ""
NSQ_SOURCE_LINE 00000953 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 "=head1 NAME"
NSQ_SOURCE_LINE 00000956 ""
NSQ_SOURCE_LINE 00000957 "CPAN::Mini - create a minimal mirror of CPAN"
NSQ_SOURCE_LINE 00000958 ""
NSQ_SOURCE_LINE 00000959 "=head1 VERSION"
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "version 1.111017"
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 "(If you're not going to do something weird, you probably want to look at the"
NSQ_SOURCE_LINE 00000966 "L<minicpan> command, instead.)"
NSQ_SOURCE_LINE 00000967 ""
NSQ_SOURCE_LINE 00000968 "  use CPAN::Mini;"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "  CPAN::Mini->update_mirror("
NSQ_SOURCE_LINE 00000971 "    remote => \"http://cpan.mirrors.comintern.su\","
NSQ_SOURCE_LINE 00000972 "    local  => \"/usr/share/mirrors/cpan\","
NSQ_SOURCE_LINE 00000973 "    log_level => 'debug',"
NSQ_SOURCE_LINE 00000974 "  );"
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 "CPAN::Mini provides a simple mechanism to build and update a minimal mirror of"
NSQ_SOURCE_LINE 00000979 "the CPAN on your local disk.  It contains only those files needed to install"
NSQ_SOURCE_LINE 00000980 "the newest version of every distribution.  Those files are:"
NSQ_SOURCE_LINE 00000981 ""
NSQ_SOURCE_LINE 00000982 "=over 4"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "=item *"
NSQ_SOURCE_LINE 00000985 ""
NSQ_SOURCE_LINE 00000986 "01mailrc.txt.gz"
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 "=item *"
NSQ_SOURCE_LINE 00000989 ""
NSQ_SOURCE_LINE 00000990 "02packages.details.txt.gz"
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "=item *"
NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "03modlist.data.gz"
NSQ_SOURCE_LINE 00000995 ""
NSQ_SOURCE_LINE 00000996 "=item *"
NSQ_SOURCE_LINE 00000997 ""
NSQ_SOURCE_LINE 00000998 "the last non-developer release of every dist for every author"
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "=back"
NSQ_SOURCE_LINE 00001001 ""
NSQ_SOURCE_LINE 00001002 "=head1 PERL VERSION"
NSQ_SOURCE_LINE 00001003 ""
NSQ_SOURCE_LINE 00001004 "This library should run on perls released even a long time ago.  It should"
NSQ_SOURCE_LINE 00001005 "work on any version of perl released in the last five years."
NSQ_SOURCE_LINE 00001006 ""
NSQ_SOURCE_LINE 00001007 "Although it may work on older versions of perl, no guarantee is made that the"
NSQ_SOURCE_LINE 00001008 "minimum required version will not be increased.  The version may be increased"
NSQ_SOURCE_LINE 00001009 "for any reason, and there is no promise that patches will be accepted to"
NSQ_SOURCE_LINE 00001010 "lower the minimum required perl."
NSQ_SOURCE_LINE 00001011 ""
NSQ_SOURCE_LINE 00001012 "=head1 METHODS"
NSQ_SOURCE_LINE 00001013 ""
NSQ_SOURCE_LINE 00001014 "=head2 update_mirror"
NSQ_SOURCE_LINE 00001015 ""
NSQ_SOURCE_LINE 00001016 "  CPAN::Mini->update_mirror("
NSQ_SOURCE_LINE 00001017 "    remote => \"http://cpan.mirrors.comintern.su\","
NSQ_SOURCE_LINE 00001018 "    local  => \"/usr/share/mirrors/cpan\","
NSQ_SOURCE_LINE 00001019 "    force  => 0,"
NSQ_SOURCE_LINE 00001020 "    log_level => 'debug',"
NSQ_SOURCE_LINE 00001021 "  );"
NSQ_SOURCE_LINE 00001022 ""
NSQ_SOURCE_LINE 00001023 "This is the only method that need be called from outside this module.  It will"
NSQ_SOURCE_LINE 00001024 "update the local mirror with the files from the remote mirror."
NSQ_SOURCE_LINE 00001025 ""
NSQ_SOURCE_LINE 00001026 "If called as a class method, C<update_mirror> creates an ephemeral CPAN::Mini"
NSQ_SOURCE_LINE 00001027 "object on which other methods are called.  That object is used to store mirror"
NSQ_SOURCE_LINE 00001028 "location and state."
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "This method returns the number of files updated."
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "The following options are recognized:"
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "=over 4"
NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "=item *"
NSQ_SOURCE_LINE 00001037 ""
NSQ_SOURCE_LINE 00001038 "C<local>"
NSQ_SOURCE_LINE 00001039 ""
NSQ_SOURCE_LINE 00001040 "This is the local file path where the mirror will be written or updated."
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "=item *"
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 "C<remote>"
NSQ_SOURCE_LINE 00001045 ""
NSQ_SOURCE_LINE 00001046 "This is the URL of the CPAN mirror from which to work.  A reasonable default"
NSQ_SOURCE_LINE 00001047 "will be picked by default.  A list of CPAN mirrors can be found at"
NSQ_SOURCE_LINE 00001048 "L<http://www.cpan.org/SITES.html>"
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "=item *"
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "C<dirmode>"
NSQ_SOURCE_LINE 00001053 ""
NSQ_SOURCE_LINE 00001054 "Generally an octal number, this option sets the permissions of created"
NSQ_SOURCE_LINE 00001055 "directories.  It defaults to 0711."
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "=item *"
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "C<exact_mirror>"
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "If true, the C<file_allowed> method will allow all extra files to be mirrored."
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "=item *"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "C<ignore_source_control>"
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "If true, CPAN::Mini will not try to remove source control files during"
NSQ_SOURCE_LINE 00001068 "cleanup. See C<clean_unmirrored> for details."
NSQ_SOURCE_LINE 00001069 ""
NSQ_SOURCE_LINE 00001070 "=item *"
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "C<force>"
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 "If true, this option will cause CPAN::Mini to read the entire module list and"
NSQ_SOURCE_LINE 00001075 "update anything out of date, even if the module list itself wasn't out of date"
NSQ_SOURCE_LINE 00001076 "on this run."
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 "=item *"
NSQ_SOURCE_LINE 00001079 ""
NSQ_SOURCE_LINE 00001080 "C<skip_perl>"
NSQ_SOURCE_LINE 00001081 ""
NSQ_SOURCE_LINE 00001082 "If true, CPAN::Mini will skip the major language distributions: perl, parrot,"
NSQ_SOURCE_LINE 00001083 "and ponie.  It will also skip embperl, sybperl, bioperl, and kurila."
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "=item *"
NSQ_SOURCE_LINE 00001086 ""
NSQ_SOURCE_LINE 00001087 "C<log_level>"
NSQ_SOURCE_LINE 00001088 ""
NSQ_SOURCE_LINE 00001089 "This defines the minimum level of message to log: debug, info, warn, or fatal"
NSQ_SOURCE_LINE 00001090 ""
NSQ_SOURCE_LINE 00001091 "=item *"
NSQ_SOURCE_LINE 00001092 ""
NSQ_SOURCE_LINE 00001093 "C<errors>"
NSQ_SOURCE_LINE 00001094 ""
NSQ_SOURCE_LINE 00001095 "If true, CPAN::Mini will warn with status messages on errors.  (default: true)"
NSQ_SOURCE_LINE 00001096 ""
NSQ_SOURCE_LINE 00001097 "=item *"
NSQ_SOURCE_LINE 00001098 ""
NSQ_SOURCE_LINE 00001099 "C<path_filters>"
NSQ_SOURCE_LINE 00001100 ""
NSQ_SOURCE_LINE 00001101 "This options provides a set of rules for filtering paths.  If a distribution"
NSQ_SOURCE_LINE 00001102 "matches one of the rules in C<path_filters>, it will not be mirrored.  A regex"
NSQ_SOURCE_LINE 00001103 "rule is matched if the path matches the regex; a code rule is matched if the"
NSQ_SOURCE_LINE 00001104 "code returns 1 when the path is passed to it.  For example, the following"
NSQ_SOURCE_LINE 00001105 "setting would skip all distributions from RJBS and SUNGO:"
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 " path_filters => ["
NSQ_SOURCE_LINE 00001108 "   qr/RJBS/,"
NSQ_SOURCE_LINE 00001109 "   sub { $_[0] =~ /SUNGO/ }"
NSQ_SOURCE_LINE 00001110 " ]"
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 "=item *"
NSQ_SOURCE_LINE 00001113 ""
NSQ_SOURCE_LINE 00001114 "C<module_filters>"
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "This option provides a set of rules for filtering modules.  It behaves like"
NSQ_SOURCE_LINE 00001117 "path_filters, but acts only on module names.  (Since most modules are in"
NSQ_SOURCE_LINE 00001118 "distributions with more than one module, this setting will probably be less"
NSQ_SOURCE_LINE 00001119 "useful than C<path_filters>.)  For example, this setting will skip any"
NSQ_SOURCE_LINE 00001120 "distribution containing only modules with the word \"Acme\" in them:"
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 " module_filters => [ qr/Acme/i ]"
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 "=item *"
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "C<also_mirror>"
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "This option should be an arrayref of extra files in the remote CPAN to mirror"
NSQ_SOURCE_LINE 00001129 "locally."
NSQ_SOURCE_LINE 00001130 ""
NSQ_SOURCE_LINE 00001131 "=item *"
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "C<skip_cleanup>"
NSQ_SOURCE_LINE 00001134 ""
NSQ_SOURCE_LINE 00001135 "If this option is true, CPAN::Mini will not try delete unmirrored files when it"
NSQ_SOURCE_LINE 00001136 "has finished mirroring"
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "=item *"
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "C<offline>"
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "If offline, CPAN::Mini will not attempt to contact remote resources."
NSQ_SOURCE_LINE 00001143 ""
NSQ_SOURCE_LINE 00001144 "=item *"
NSQ_SOURCE_LINE 00001145 ""
NSQ_SOURCE_LINE 00001146 "C<no_conn_cache>"
NSQ_SOURCE_LINE 00001147 ""
NSQ_SOURCE_LINE 00001148 "If true, no connection cache will be established.  This is mostly useful as a"
NSQ_SOURCE_LINE 00001149 "workaround for connection cache failures."
NSQ_SOURCE_LINE 00001150 ""
NSQ_SOURCE_LINE 00001151 "=back"
NSQ_SOURCE_LINE 00001152 ""
NSQ_SOURCE_LINE 00001153 "=head2 new"
NSQ_SOURCE_LINE 00001154 ""
NSQ_SOURCE_LINE 00001155 "  my $minicpan = CPAN::Mini->new;"
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 "This method constructs a new CPAN::Mini object.  Its parameters are described"
NSQ_SOURCE_LINE 00001158 "above, under C<update_mirror>."
NSQ_SOURCE_LINE 00001159 ""
NSQ_SOURCE_LINE 00001160 "=head2 mirror_indices"
NSQ_SOURCE_LINE 00001161 ""
NSQ_SOURCE_LINE 00001162 "  $minicpan->mirror_indices;"
NSQ_SOURCE_LINE 00001163 ""
NSQ_SOURCE_LINE 00001164 "This method updates the index files from the CPAN."
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 "=head2 mirror_file"
NSQ_SOURCE_LINE 00001167 ""
NSQ_SOURCE_LINE 00001168 "  $minicpan->mirror_file($path, $skip_if_present)"
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 "This method will mirror the given file from the remote to the local mirror,"
NSQ_SOURCE_LINE 00001171 "overwriting any existing file unless C<$skip_if_present> is true."
NSQ_SOURCE_LINE 00001172 ""
NSQ_SOURCE_LINE 00001173 "=head2 file_allowed"
NSQ_SOURCE_LINE 00001174 ""
NSQ_SOURCE_LINE 00001175 "  next unless $minicpan->file_allowed($filename);"
NSQ_SOURCE_LINE 00001176 ""
NSQ_SOURCE_LINE 00001177 "This method returns true if the given file is allowed to exist in the local"
NSQ_SOURCE_LINE 00001178 "mirror, even if it isn't one of the required mirror files."
NSQ_SOURCE_LINE 00001179 ""
NSQ_SOURCE_LINE 00001180 "By default, only dot-files are allowed.  If the C<exact_mirror> option is true,"
NSQ_SOURCE_LINE 00001181 "all files are allowed."
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "=head2 clean_unmirrored"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "  $minicpan->clean_unmirrored;"
NSQ_SOURCE_LINE 00001186 ""
NSQ_SOURCE_LINE 00001187 "This method looks through the local mirror's files.  If it finds a file that"
NSQ_SOURCE_LINE 00001188 "neither belongs in the mirror nor is allowed (see the C<file_allowed> method),"
NSQ_SOURCE_LINE 00001189 "C<clean_file> is called on the file."
NSQ_SOURCE_LINE 00001190 ""
NSQ_SOURCE_LINE 00001191 "If you set C<ignore_source_control> to a true value, then this doesn't clean"
NSQ_SOURCE_LINE 00001192 "up files that belong to source control systems. Currently this ignores:"
NSQ_SOURCE_LINE 00001193 ""
NSQ_SOURCE_LINE 00001194 "\t.cvs .cvsignore"
NSQ_SOURCE_LINE 00001195 "\t.svn .svnignore"
NSQ_SOURCE_LINE 00001196 "\t.git .gitignore"
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "Send patches for other source control files that you would like to have added."
NSQ_SOURCE_LINE 00001199 ""
NSQ_SOURCE_LINE 00001200 "=head2 clean_file"
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "  $minicpan->clean_file($filename);"
NSQ_SOURCE_LINE 00001203 ""
NSQ_SOURCE_LINE 00001204 "This method, called by C<clean_unmirrored>, deletes the named file.  It returns"
NSQ_SOURCE_LINE 00001205 "true if the file is successfully unlinked.  Otherwise, it returns false."
NSQ_SOURCE_LINE 00001206 ""
NSQ_SOURCE_LINE 00001207 "=head2 log_warn"
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 "=head2 log"
NSQ_SOURCE_LINE 00001210 ""
NSQ_SOURCE_LINE 00001211 "=head2 log_debug"
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 "  $minicpan->log($message);"
NSQ_SOURCE_LINE 00001214 ""
NSQ_SOURCE_LINE 00001215 "This will log (print) the given message unless the log level is too low."
NSQ_SOURCE_LINE 00001216 ""
NSQ_SOURCE_LINE 00001217 "C<log>, which logs at the I<info> level, may also be called as C<trace> for"
NSQ_SOURCE_LINE 00001218 "backward compatibility reasons."
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "=head2 read_config"
NSQ_SOURCE_LINE 00001221 ""
NSQ_SOURCE_LINE 00001222 "  my %config = CPAN::Mini->read_config(\\%options);"
NSQ_SOURCE_LINE 00001223 ""
NSQ_SOURCE_LINE 00001224 "This routine returns a set of arguments that can be passed to CPAN::Mini's"
NSQ_SOURCE_LINE 00001225 "C<new> or C<update_mirror> methods.  It will look for a file called"
NSQ_SOURCE_LINE 00001226 "F<.minicpanrc> in the user's home directory as determined by"
NSQ_SOURCE_LINE 00001227 "L<File::HomeDir|File::HomeDir>."
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 "=head2 config_file"
NSQ_SOURCE_LINE 00001230 ""
NSQ_SOURCE_LINE 00001231 "  my $config_file = CPAN::Mini->config_file( { options } );"
NSQ_SOURCE_LINE 00001232 ""
NSQ_SOURCE_LINE 00001233 "This routine returns the config file name. It first looks at for the"
NSQ_SOURCE_LINE 00001234 "C<config_file> setting, then the C<CPAN_MINI_CONFIG> environment"
NSQ_SOURCE_LINE 00001235 "variable, then the default F<~/.minicpanrc>, and finally the"
NSQ_SOURCE_LINE 00001236 "F<CPAN/Mini/minicpan.conf>. It uses the first defined value it finds."
NSQ_SOURCE_LINE 00001237 "If the filename it selects does not exist, it returns false."
NSQ_SOURCE_LINE 00001238 ""
NSQ_SOURCE_LINE 00001239 "OPTIONS is an optional hash reference of the C<CPAN::Mini> config hash."
NSQ_SOURCE_LINE 00001240 ""
NSQ_SOURCE_LINE 00001241 "=begin devel"
NSQ_SOURCE_LINE 00001242 ""
NSQ_SOURCE_LINE 00001243 "=method _filter_module"
NSQ_SOURCE_LINE 00001244 ""
NSQ_SOURCE_LINE 00001245 " next"
NSQ_SOURCE_LINE 00001246 "   if $self->_filter_module({ module => $foo, version => $foo, path => $foo });"
NSQ_SOURCE_LINE 00001247 ""
NSQ_SOURCE_LINE 00001248 "This method holds the filter chain logic. C<update_mirror> takes an optional"
NSQ_SOURCE_LINE 00001249 "set of filter parameters.  As C<update_mirror> encounters a distribution, it"
NSQ_SOURCE_LINE 00001250 "calls this method to figure out whether or not it should be downloaded. The"
NSQ_SOURCE_LINE 00001251 "user provided filters are taken into account. Returns 1 if the distribution is"
NSQ_SOURCE_LINE 00001252 "filtered (to be skipped).  Returns 0 if the distribution is to not filtered"
NSQ_SOURCE_LINE 00001253 "(not to be skipped)."
NSQ_SOURCE_LINE 00001254 ""
NSQ_SOURCE_LINE 00001255 "=end devel"
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "=head2 remote_from"
NSQ_SOURCE_LINE 00001258 ""
NSQ_SOURCE_LINE 00001259 "  my $remote = CPAN::Mini->remote_from( $remote_from, $orig_remote, $quiet );"
NSQ_SOURCE_LINE 00001260 ""
NSQ_SOURCE_LINE 00001261 "This routine take an string argument and turn it into a method"
NSQ_SOURCE_LINE 00001262 "call to handle to retrieve the a cpan mirror url from a source."
NSQ_SOURCE_LINE 00001263 "Currently supported methods:"
NSQ_SOURCE_LINE 00001264 ""
NSQ_SOURCE_LINE 00001265 "    cpan     - fetch the first mirror from your CPAN.pm config"
NSQ_SOURCE_LINE 00001266 "    cpanplus - fetch the first mirror from your CPANPLUS.pm config"
NSQ_SOURCE_LINE 00001267 ""
NSQ_SOURCE_LINE 00001268 "=head2 remote_from_cpan"
NSQ_SOURCE_LINE 00001269 ""
NSQ_SOURCE_LINE 00001270 "  my $remote = CPAN::Mini->remote_from_cpan;"
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 "This routine loads your CPAN.pm config and returns the first mirror in mirror"
NSQ_SOURCE_LINE 00001273 "list.  You can set this as your default by setting remote_from:cpan in your"
NSQ_SOURCE_LINE 00001274 "F<.minicpanrc> file."
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "=head2 remote_from_cpanplus"
NSQ_SOURCE_LINE 00001277 ""
NSQ_SOURCE_LINE 00001278 "  my $remote = CPAN::Mini->remote_from_cpanplus;"
NSQ_SOURCE_LINE 00001279 ""
NSQ_SOURCE_LINE 00001280 "This routine loads your CPANPLUS.pm config and returns the first mirror in"
NSQ_SOURCE_LINE 00001281 "mirror list.  You can set this as your default by setting remote_from:cpanplus"
NSQ_SOURCE_LINE 00001282 "in your F<.minicpanrc> file."
NSQ_SOURCE_LINE 00001283 ""
NSQ_SOURCE_LINE 00001284 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001285 ""
NSQ_SOURCE_LINE 00001286 "Randal Schwartz's original article on minicpan, here:"
NSQ_SOURCE_LINE 00001287 ""
NSQ_SOURCE_LINE 00001288 "\thttp://www.stonehenge.com/merlyn/LinuxMag/col42.html"
NSQ_SOURCE_LINE 00001289 ""
NSQ_SOURCE_LINE 00001290 "L<CPANPLUS::Backend>, which provides the C<local_mirror> method, which performs"
NSQ_SOURCE_LINE 00001291 "the same task as this module."
NSQ_SOURCE_LINE 00001292 ""
