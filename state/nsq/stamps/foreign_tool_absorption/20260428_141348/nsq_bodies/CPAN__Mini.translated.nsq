NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "  $self->log(\"$file removed\");"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "  return 1;"
NSQ_SOURCE_LINE 00000654 "}"
