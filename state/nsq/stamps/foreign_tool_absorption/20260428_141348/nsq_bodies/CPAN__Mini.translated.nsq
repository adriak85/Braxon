NSQ_SOURCE_LINE 00000731 "sub __default_configfile {"
NSQ_SOURCE_LINE 00000732 "  my ($self) = @_;"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "  (my $pm_loc = $INC{'CPAN/Mini.pm'}) =~ s/Mini\\.pm\\z//;"
