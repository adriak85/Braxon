NSQ_SOURCE_LINE 00000673 "  return 'info';"
NSQ_SOURCE_LINE 00000674 "}"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "sub log_unconditionally {"
NSQ_SOURCE_LINE 00000677 "  my ($self, $message, $arg) = @_;"
NSQ_SOURCE_LINE 00000678 "  $arg ||= {};"
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 "  print($message, $arg->{no_nl} ? () : \"\\n\");"
