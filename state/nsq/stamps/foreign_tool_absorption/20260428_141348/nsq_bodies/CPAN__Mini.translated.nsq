NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "sub log_warn {"
NSQ_SOURCE_LINE 00000684 "  return if $_[0]->log_level eq 'fatal';"
NSQ_SOURCE_LINE 00000685 "  $_[0]->log_unconditionally($_[1], $_[2]);"
