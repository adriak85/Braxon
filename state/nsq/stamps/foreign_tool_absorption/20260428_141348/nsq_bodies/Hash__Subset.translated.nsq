NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "sub _routine {"
NSQ_SOURCE_LINE 00000028 "    my ($which, $hash, @keys_srcs) = @_;"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    my $reverse = $which =~ /_without\\z/;"
NSQ_SOURCE_LINE 00000031 "    my $return_ref = $which =~ /\\Ahashref_/;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    my %subset;"
NSQ_SOURCE_LINE 00000034 "    %subset = %$hash if $reverse;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    for my $keys_src (@keys_srcs) {"
NSQ_SOURCE_LINE 00000037 "        my $ref = ref $keys_src;"
NSQ_SOURCE_LINE 00000038 "        if ($ref eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000039 "            if ($reverse) {"
NSQ_SOURCE_LINE 00000040 "                for (@$keys_src) {"
NSQ_SOURCE_LINE 00000041 "                    delete $subset{$_};"
NSQ_SOURCE_LINE 00000042 "                }"
NSQ_SOURCE_LINE 00000043 "            } else {"
NSQ_SOURCE_LINE 00000044 "                for (@$keys_src) {"
NSQ_SOURCE_LINE 00000045 "                    $subset{$_} = $hash->{$_} if exists $hash->{$_};"
NSQ_SOURCE_LINE 00000046 "                }"
NSQ_SOURCE_LINE 00000047 "            }"
NSQ_SOURCE_LINE 00000048 "        } elsif ($ref eq 'HASH') {"
NSQ_SOURCE_LINE 00000049 "            if ($reverse) {"
NSQ_SOURCE_LINE 00000050 "                for (keys %$keys_src) {"
NSQ_SOURCE_LINE 00000051 "                    delete $subset{$_};"
NSQ_SOURCE_LINE 00000052 "                }"
NSQ_SOURCE_LINE 00000053 "            } else {"
NSQ_SOURCE_LINE 00000054 "                for (keys %$keys_src) {"
NSQ_SOURCE_LINE 00000055 "                    $subset{$_} = $hash->{$_} if exists $hash->{$_};"
NSQ_SOURCE_LINE 00000056 "                }"
NSQ_SOURCE_LINE 00000057 "            }"
NSQ_SOURCE_LINE 00000058 "        } elsif ($ref eq 'Regexp') {"
NSQ_SOURCE_LINE 00000059 "            if ($reverse) {"
NSQ_SOURCE_LINE 00000060 "                for (keys %subset) {"
NSQ_SOURCE_LINE 00000061 "                    delete $subset{$_} if $_ =~ $keys_src;"
NSQ_SOURCE_LINE 00000062 "                }"
NSQ_SOURCE_LINE 00000063 "            } else {"
NSQ_SOURCE_LINE 00000064 "                for (keys %$hash) {"
NSQ_SOURCE_LINE 00000065 "                    $subset{$_} = $hash->{$_} if $_ =~ $keys_src;"
NSQ_SOURCE_LINE 00000066 "                }"
NSQ_SOURCE_LINE 00000067 "            }"
NSQ_SOURCE_LINE 00000068 "        } elsif ($ref eq 'CODE') {"
NSQ_SOURCE_LINE 00000069 "            if ($reverse) {"
NSQ_SOURCE_LINE 00000070 "                for (keys %$hash) {"
NSQ_SOURCE_LINE 00000071 "                    delete $subset{$_} if $keys_src->($_, $hash->{$_});"
NSQ_SOURCE_LINE 00000072 "                }"
NSQ_SOURCE_LINE 00000073 "            } else {"
NSQ_SOURCE_LINE 00000074 "                for (keys %$hash) {"
NSQ_SOURCE_LINE 00000075 "                    $subset{$_} = $hash->{$_} if $keys_src->($_, $hash->{$_});"
NSQ_SOURCE_LINE 00000076 "                }"
NSQ_SOURCE_LINE 00000077 "            }"
NSQ_SOURCE_LINE 00000078 "        } else {"
NSQ_SOURCE_LINE 00000079 "            die \"Key source ($keys_src) must be a hashref/arrayref/Regexp/coderef\";"
NSQ_SOURCE_LINE 00000080 "        }"
NSQ_SOURCE_LINE 00000081 "    } # for $keys_src"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "    if ($return_ref) {"
NSQ_SOURCE_LINE 00000084 "        return \\%subset;"
NSQ_SOURCE_LINE 00000085 "    } else {"
NSQ_SOURCE_LINE 00000086 "        return %subset;"
NSQ_SOURCE_LINE 00000087 "    }"
NSQ_SOURCE_LINE 00000088 "}"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "sub hash_subset    { _routine('hash_subset'   , @_) }"
NSQ_SOURCE_LINE 00000091 "sub hashref_subset { _routine('hashref_subset', @_) }"
NSQ_SOURCE_LINE 00000092 "sub hash_subset_without    { _routine('hash_subset_without'   , @_) }"
NSQ_SOURCE_LINE 00000093 "sub hashref_subset_without { _routine('hashref_subset_without', @_) }"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "sub merge_hash_subset {"
NSQ_SOURCE_LINE 00000096 "    my ($h1, $h2, @keys_src) = @_;"
NSQ_SOURCE_LINE 00000097 "    my %subset = hash_subset($h2, @keys_src);"
NSQ_SOURCE_LINE 00000098 "    for my $key (keys %subset) {"
NSQ_SOURCE_LINE 00000099 "        die \"Duplicate key when merging hash subset key '$key'\" if exists $h1->{$key};"
NSQ_SOURCE_LINE 00000100 "        $h1->{$key} = $subset{$key};"
NSQ_SOURCE_LINE 00000101 "    }"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub merge_hash_subset_without {"
NSQ_SOURCE_LINE 00000105 "    my ($h1, $h2, @keys_src) = @_;"
NSQ_SOURCE_LINE 00000106 "    my %subset = hash_subset_without($h2, @keys_src);"
NSQ_SOURCE_LINE 00000107 "    for my $key (keys %subset) {"
NSQ_SOURCE_LINE 00000108 "        die \"Duplicate key when merging hash subset key '$key'\" if exists $h1->{$key};"
NSQ_SOURCE_LINE 00000109 "        $h1->{$key} = $subset{$key};"
NSQ_SOURCE_LINE 00000110 "    }"
NSQ_SOURCE_LINE 00000111 "}"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "sub merge_overwrite_hash_subset {"
NSQ_SOURCE_LINE 00000114 "    my ($h1, $h2, @keys_src) = @_;"
NSQ_SOURCE_LINE 00000115 "    my %subset = hash_subset($h2, @keys_src);"
NSQ_SOURCE_LINE 00000116 "    for my $key (keys %subset) {"
NSQ_SOURCE_LINE 00000117 "        $h1->{$key} = $subset{$key};"
NSQ_SOURCE_LINE 00000118 "    }"
NSQ_SOURCE_LINE 00000119 "}"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "sub merge_overwrite_hash_subset_without {"
NSQ_SOURCE_LINE 00000122 "    my ($h1, $h2, @keys_src) = @_;"
NSQ_SOURCE_LINE 00000123 "    my %subset = hash_subset_without($h2, @keys_src);"
NSQ_SOURCE_LINE 00000124 "    for my $key (keys %subset) {"
NSQ_SOURCE_LINE 00000125 "        $h1->{$key} = $subset{$key};"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 "}"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "sub merge_ignore_hash_subset {"
NSQ_SOURCE_LINE 00000130 "    my ($h1, $h2, @keys_src) = @_;"
NSQ_SOURCE_LINE 00000131 "    my %subset = hash_subset($h2, @keys_src);"
NSQ_SOURCE_LINE 00000132 "    for my $key (keys %subset) {"
NSQ_SOURCE_LINE 00000133 "        next if exists $h1->{$key};"
NSQ_SOURCE_LINE 00000134 "        $h1->{$key} = $subset{$key};"
NSQ_SOURCE_LINE 00000135 "    }"
NSQ_SOURCE_LINE 00000136 "}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "sub merge_ignore_hash_subset_without {"
NSQ_SOURCE_LINE 00000139 "    my ($h1, $h2, @keys_src) = @_;"
NSQ_SOURCE_LINE 00000140 "    my %subset = hash_subset_without($h2, @keys_src);"
NSQ_SOURCE_LINE 00000141 "    for my $key (keys %subset) {"
NSQ_SOURCE_LINE 00000142 "        next if exists $h1->{$key};"
NSQ_SOURCE_LINE 00000143 "        $h1->{$key} = $subset{$key};"
NSQ_SOURCE_LINE 00000144 "    }"
NSQ_SOURCE_LINE 00000145 "}"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "1;"
NSQ_SOURCE_LINE 00000148 "# ABSTRACT: Produce subset of a hash"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "__END__"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=pod"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=head1 NAME"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "Hash::Subset - Produce subset of a hash"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=head1 VERSION"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "This document describes version 0.007 of Hash::Subset (from Perl distribution Hash-Subset), released on 2022-07-27."
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 " use Hash::Subset qw("
NSQ_SOURCE_LINE 00000167 "     hash_subset"
NSQ_SOURCE_LINE 00000168 "     hashref_subset"
NSQ_SOURCE_LINE 00000169 "     hash_subset_without"
NSQ_SOURCE_LINE 00000170 "     hashref_subset_without"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "     merge_hash_subset"
NSQ_SOURCE_LINE 00000173 "     merge_overwrite_hash_subset"
NSQ_SOURCE_LINE 00000174 "     merge_ignore_hash_subset"
NSQ_SOURCE_LINE 00000175 "     merge_hash_subset_without"
NSQ_SOURCE_LINE 00000176 "     merge_overwrite_hash_subset_without"
NSQ_SOURCE_LINE 00000177 "     merge_ignore_hash_subset_without"
NSQ_SOURCE_LINE 00000178 " );"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 " # using keys specified in an array"
NSQ_SOURCE_LINE 00000181 " my %subset = hash_subset   ({a=>1, b=>2, c=>3}, ['b','c','d']); # => (b=>2, c=>3)"
NSQ_SOURCE_LINE 00000182 " my $subset = hashref_subset({a=>1, b=>2, c=>3}, ['b','c','d']); # => {b=>2, c=>3}"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 " # using keys specified in another hash"
NSQ_SOURCE_LINE 00000185 " my %subset = hash_subset   ({a=>1, b=>2, c=>3}, {b=>20, c=>30, d=>40}); # => (b=>2, c=>3)"
NSQ_SOURCE_LINE 00000186 " my $subset = hashref_subset({a=>1, b=>2, c=>3}, {b=>20, c=>30, d=>40}); # => {b=>2, c=>3}"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 " # filtering keys using a coderef"
NSQ_SOURCE_LINE 00000189 " my %subset = hash_subset   ({a=>1, b=>2, c=>3}, sub {$_[0] =~ /[bc]/}); # => (b=>2, c=>3)"
NSQ_SOURCE_LINE 00000190 " my $subset = hashref_subset({a=>1, b=>2, c=>3}, sub {$_[0] =~ /[bc]/}); # => {b=>2, c=>3}"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 " # multiple filters: array, hash, coderef"
NSQ_SOURCE_LINE 00000193 " my %subset = hash_subset   ({a=>1, b=>2, c=>3, d=>4}, {c=>1}, [qw/b/], sub {$_[0] =~ /[bcd]/}); # => (b=>2, c=>3, d=>4)"
NSQ_SOURCE_LINE 00000194 " my $subset = hashref_subset({a=>1, b=>2, c=>3, d=>4}, {c=>1}, [qw/b/], sub {$_[0] =~ /[bcd]/}); # => {b=>2, c=>3, d=>4}"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 " # excluding keys"
NSQ_SOURCE_LINE 00000197 " my %subset = hash_subset_without   ({a=>1, b=>2, c=>3}, ['b','c','d']); # => (a=>1)"
NSQ_SOURCE_LINE 00000198 " my $subset = hashref_subset_without({a=>1, b=>2, c=>3}, ['b','c','d']); # => {a=>1}"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "A use case is when you use hash arguments:"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 " sub func1 {"
NSQ_SOURCE_LINE 00000203 "     my %args = @_; # known arguments: foo, bar, baz"
NSQ_SOURCE_LINE 00000204 "     ..."
NSQ_SOURCE_LINE 00000205 " }"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 " sub func2 {"
NSQ_SOURCE_LINE 00000208 "     my %args = @_; # known arguments: all func1 arguments as well as qux, quux"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "     # call func1 with all arguments passed to us"
NSQ_SOURCE_LINE 00000211 "     my $res = func1(hash_subset(\\%args, [qw/foo bar baz/]));"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "     # postprocess result"
NSQ_SOURCE_LINE 00000214 "     ..."
NSQ_SOURCE_LINE 00000215 " }"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "If you use L<Rinci> metadata in your code, this will come in handy, for example:"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 " my %common_args = ("
NSQ_SOURCE_LINE 00000220 "     foo => {...},"
NSQ_SOURCE_LINE 00000221 "     bar => {...},"
NSQ_SOURCE_LINE 00000222 "     baz => {...},"
NSQ_SOURCE_LINE 00000223 " );"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 " $SPEC{func1} = {"
NSQ_SOURCE_LINE 00000226 "    v => 1.1,"
NSQ_SOURCE_LINE 00000227 "    args => {"
NSQ_SOURCE_LINE 00000228 "        %common_args,"
NSQ_SOURCE_LINE 00000229 "    },"
NSQ_SOURCE_LINE 00000230 " };"
NSQ_SOURCE_LINE 00000231 " sub func1 {"
NSQ_SOURCE_LINE 00000232 "     my %args = @_;"
NSQ_SOURCE_LINE 00000233 "     ..."
NSQ_SOURCE_LINE 00000234 " }"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 " $SPEC{func2} = {"
NSQ_SOURCE_LINE 00000237 "    v => 1.1,"
NSQ_SOURCE_LINE 00000238 "    args => {"
NSQ_SOURCE_LINE 00000239 "        %common_args,"
NSQ_SOURCE_LINE 00000240 "        # func2 supports all func1 arguments plus a couple of others"
NSQ_SOURCE_LINE 00000241 "        qux  => { ... },"
NSQ_SOURCE_LINE 00000242 "        quux => { ... },"
NSQ_SOURCE_LINE 00000243 "    },"
NSQ_SOURCE_LINE 00000244 " };"
NSQ_SOURCE_LINE 00000245 " sub func2 {"
NSQ_SOURCE_LINE 00000246 "     my %args = @_;"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "     # call func1 with all arguments passed to us"
NSQ_SOURCE_LINE 00000249 "     my $res = func1(hash_subset(\\%args, $SPEC{func1}{args}));"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "     # postprocess result"
NSQ_SOURCE_LINE 00000252 "     ..."
NSQ_SOURCE_LINE 00000253 " }"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "Merging subset to another hash:"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 " my %target = (a=>1, b=>2);"
NSQ_SOURCE_LINE 00000258 " merge_hash_subset(\\%target, {foo=>1, bar=>2, baz=>3}, qr/ba/); # %target becomes (a=>1, b=>2, bar=>2, baz=>3)"
NSQ_SOURCE_LINE 00000259 " merge_hash_subset_without(\\%target, {foo=>1, bar=>2, baz=>3}, qr/ba/); # %target becomes (a=>1, b=>2, foo=>1)"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "Keywords: hash arguments, hash picking, hash grep, hash filtering, hash merging"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "None exported by default."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=head2 hash_subset"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "Usage:"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 " my %subset  = hash_subset   (\\%hash, @keys_srcs);"
NSQ_SOURCE_LINE 00000274 " my $subset  = hashref_subset(\\%hash, @keys_srcs);"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "Where each @keys_src element can either be an arrayref, a hashref, a Regexp"
NSQ_SOURCE_LINE 00000277 "object, or a coderef. Coderef will be called with args($key, $value) and return"
NSQ_SOURCE_LINE 00000278 "true when key should be included."
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "Produce subset of C<%hash>, returning the subset hash (or hashref, in the case"
NSQ_SOURCE_LINE 00000281 "of C<hashref_subset> function)."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "Perl lets you produce a hash subset using the hash slice notation:"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 " my %subset = %hash{\"b\",\"c\",\"d\"};"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "The difference with C<hash_subset> is: 1) hash slice is only available since"
NSQ_SOURCE_LINE 00000288 "perl 5.20 (in previous versions, only array slice is available); 2) when the key"
NSQ_SOURCE_LINE 00000289 "does not exist in the array, perl will create it for you with C<undef> as the"
NSQ_SOURCE_LINE 00000290 "value:"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 " my %hash   = (a=>1, b=>2, c=>3);"
NSQ_SOURCE_LINE 00000293 " my %subset = %hash{\"b\",\"c\",\"d\"}; # => (b=>2, c=>3, d=>undef)"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "So basically C<hash_subset> is equivalent to:"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 " my %subset = %hash{grep {exists $hash{$_}} \"b\",\"c\",\"d\"}; # => (b=>2, c=>3)"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "and available for perl earlier than 5.20. In addition to that, hash_subset()"
NSQ_SOURCE_LINE 00000300 "accepts arrayref & Regexp object as well as hashref/coderef, and several of"
NSQ_SOURCE_LINE 00000301 "them."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=head2 hashref_subset"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "See L</hash_subset>."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=head2 hash_subset_without"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "Like L</hash_subset>, but reverses the logic: will create subset that only"
NSQ_SOURCE_LINE 00000310 "includes keys not in the specified arrays/hashes/Regexps/coderefs."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "=head2 hashref_subset_without"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "See L</hash_subset_without>."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=head2 merge_hash_subset"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "Usage:"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "  merge_hash_subset          (\\%h1, \\%h2, @keys_src);"
NSQ_SOURCE_LINE 00000321 "  merge_overwrite_hash_subset(\\%h1, \\%h2, @keys_src);"
NSQ_SOURCE_LINE 00000322 "  merge_ignore_hash_subset   (\\%h1, \\%h2, @keys_src);"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "C<merge_hash_subset> selects a subset of hash C<%h2> (using C<@keys_src>, just"
NSQ_SOURCE_LINE 00000325 "like in L</hash_subset>) and merge the subset to hash C<%h1>. This is basically"
NSQ_SOURCE_LINE 00000326 "a convenience shortcut for:"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 " my %subset = hash_subset(\\%h2, @keys_src);"
NSQ_SOURCE_LINE 00000329 " for my $key (keys %subset) {"
NSQ_SOURCE_LINE 00000330 "     die \"Duplicate key when merging subset: $key\" if exists $h1{$key];"
NSQ_SOURCE_LINE 00000331 "     $h1{$key} = $subset{$key};"
NSQ_SOURCE_LINE 00000332 " }"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "while C<merge_overwrite_hash_subset> does something like this:"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 " my %subset = hash_subset(\\%h2, @keys_src);"
NSQ_SOURCE_LINE 00000337 " for my $key (keys %subset) {"
NSQ_SOURCE_LINE 00000338 "     $h1{$key} = $subset{$key};"
NSQ_SOURCE_LINE 00000339 " }"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "and C<merge_ignore_hash_subset> does something like this:"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 " my %subset = hash_subset(\\%h2, @keys_src);"
NSQ_SOURCE_LINE 00000344 " for my $key (keys %subset) {"
NSQ_SOURCE_LINE 00000345 "     next if exists $h1{$key};"
NSQ_SOURCE_LINE 00000346 "     $h1{$key} = $subset{$key};"
NSQ_SOURCE_LINE 00000347 " }"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "=head2 merge_overwrite_hash_subset"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "See L</merge_hash_subset>."
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "=head2 merge_ignore_hash_subset"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "See L</merge_hash_subset>."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=head2 merge_hash_subset_without"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "Usage:"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "  merge_hash_subset_without          (\\%h1, \\%h2, @keys_src);"
NSQ_SOURCE_LINE 00000362 "  merge_overwrite_hash_subset_without(\\%h1, \\%h2, @keys_src);"
NSQ_SOURCE_LINE 00000363 "  merge_ignore_hash_subset_without   (\\%h1, \\%h2, @keys_src);"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "These are like L</merge_hash_subset>, L</merge_overwrite_hash_subset>, and"
NSQ_SOURCE_LINE 00000366 "L</merge_ignore_hash_subset> except these routines will merge subset from C<%h2>"
NSQ_SOURCE_LINE 00000367 "that do I<not> contain keys specified by C<@keys_src>."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=head2 merge_overwrite_hash_subset_without"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "See L</merge_hash_subset_without>."
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "=head2 merge_ignore_hash_subset_without"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "See L</merge_hash_subset_without>."
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "Please visit the project's homepage at L<https://metacpan.org/release/Hash-Subset>."
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "Source repository is at L<https://github.com/perlancar/perl-Hash-Subset>."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "L<Hash::MoreUtils> provides various ways to create hash subset (\"slice\") through"
NSQ_SOURCE_LINE 00000388 "its C<slice_*> functions. It does not provide way to specify subset keys via the"
NSQ_SOURCE_LINE 00000389 "keys of C<%another_hash>, but that can be done trivially using C<< keys"
NSQ_SOURCE_LINE 00000390 "%another_hash >>. Hash::Subset is currently more lightweight than"
NSQ_SOURCE_LINE 00000391 "Hash::MoreUtils."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "L<Tie::Subset::Hash> to create a tied version of a hash subset (a \"view\" of a"
NSQ_SOURCE_LINE 00000394 "subset of a hash)."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "L<Hash::Util::Pick> also allows you to create a hash subset by specifying the"
NSQ_SOURCE_LINE 00000397 "wanted keys in a list or via filtering using a coderef. This XS module should"
NSQ_SOURCE_LINE 00000398 "perhaps be preferred over Hash::Subset for its performance, but there are some"
NSQ_SOURCE_LINE 00000399 "cases where you cannot use XS modules."
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "See some benchmarks in L<Bencher::Scenarios::HashPicking>."
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "perlancar <perlancar@cpan.org>"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=head1 CONTRIBUTING"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "To contribute, you can send patches by email/via RT, or send pull requests on"
NSQ_SOURCE_LINE 00000411 "GitHub."
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "Most of the time, you don't need to build the distribution yourself. You can"
NSQ_SOURCE_LINE 00000414 "simply modify the code, then test via:"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 " % prove -l"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "If you want to build the distribution (e.g. to try to install it locally on your"
NSQ_SOURCE_LINE 00000419 "system), you can install L<Dist::Zilla>,"
NSQ_SOURCE_LINE 00000420 "L<Dist::Zilla::PluginBundle::Author::PERLANCAR>, and sometimes one or two other"
NSQ_SOURCE_LINE 00000421 "Dist::Zilla plugin and/or Pod::Weaver::Plugin. Any additional steps required"
NSQ_SOURCE_LINE 00000422 "beyond that are considered a bug and can be reported to me."
NSQ_SOURCE_LINE 00000423 ""
