NSQ_SOURCE_LINE 00000001 "use strict;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "package Config::INI::Reader::Ordered 0.022;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "# ABSTRACT: .ini-file parser that returns sections in order"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Config::INI::Reader;"
NSQ_SOURCE_LINE 00000008 "use vars qw(@ISA $VERSION);"
NSQ_SOURCE_LINE 00000009 "BEGIN { @ISA = qw(Config::INI::Reader) }"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "#pod =head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000012 "#pod"
NSQ_SOURCE_LINE 00000013 "#pod If F<family.ini> contains:"
NSQ_SOURCE_LINE 00000014 "#pod"
NSQ_SOURCE_LINE 00000015 "#pod   admin = rjbs"
NSQ_SOURCE_LINE 00000016 "#pod"
NSQ_SOURCE_LINE 00000017 "#pod   [rjbs]"
NSQ_SOURCE_LINE 00000018 "#pod   awesome = yes"
NSQ_SOURCE_LINE 00000019 "#pod   height = 5' 10\""
NSQ_SOURCE_LINE 00000020 "#pod"
NSQ_SOURCE_LINE 00000021 "#pod   [mj]"
NSQ_SOURCE_LINE 00000022 "#pod   awesome = totally"
NSQ_SOURCE_LINE 00000023 "#pod   height = 23\""
NSQ_SOURCE_LINE 00000024 "#pod"
NSQ_SOURCE_LINE 00000025 "#pod Then when your program contains:"
NSQ_SOURCE_LINE 00000026 "#pod"
NSQ_SOURCE_LINE 00000027 "#pod   my $array = Config::INI::Reader->read_file('family.ini');"
NSQ_SOURCE_LINE 00000028 "#pod"
NSQ_SOURCE_LINE 00000029 "#pod C<$array> will contain:"
NSQ_SOURCE_LINE 00000030 "#pod"
NSQ_SOURCE_LINE 00000031 "#pod   ["
NSQ_SOURCE_LINE 00000032 "#pod     [ '_'  => { admin => 'rjbs' } ],"
NSQ_SOURCE_LINE 00000033 "#pod     ["
NSQ_SOURCE_LINE 00000034 "#pod       rjbs => {"
NSQ_SOURCE_LINE 00000035 "#pod         awesome => 'yes',"
NSQ_SOURCE_LINE 00000036 "#pod         height  => q{5' 10\"},"
NSQ_SOURCE_LINE 00000037 "#pod       }"
NSQ_SOURCE_LINE 00000038 "#pod     ],"
NSQ_SOURCE_LINE 00000039 "#pod     [ "
NSQ_SOURCE_LINE 00000040 "#pod       mj   => {"
NSQ_SOURCE_LINE 00000041 "#pod         awesome => 'totally',"
NSQ_SOURCE_LINE 00000042 "#pod         height  => '23\"',"
NSQ_SOURCE_LINE 00000043 "#pod       }"
NSQ_SOURCE_LINE 00000044 "#pod     ],"
NSQ_SOURCE_LINE 00000045 "#pod   ]"
NSQ_SOURCE_LINE 00000046 "#pod"
NSQ_SOURCE_LINE 00000047 "#pod =head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000048 "#pod"
NSQ_SOURCE_LINE 00000049 "#pod Config::INI::Reader::Ordered is a subclass of L<Config::INI::Reader> which"
NSQ_SOURCE_LINE 00000050 "#pod preserves section order.  See L<Config::INI::Reader> for all documentation; the"
NSQ_SOURCE_LINE 00000051 "#pod only difference is as presented in the L</SYNOPSIS>."
NSQ_SOURCE_LINE 00000052 "#pod"
NSQ_SOURCE_LINE 00000053 "#pod =cut"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "sub change_section {"
NSQ_SOURCE_LINE 00000056 "  my ($self, $section) = @_;"
NSQ_SOURCE_LINE 00000057 "  $self->SUPER::change_section($section);"
NSQ_SOURCE_LINE 00000058 "  $self->{order} ||= [];"
NSQ_SOURCE_LINE 00000059 "  push @{ $self->{order} }, $section"
NSQ_SOURCE_LINE 00000060 "    unless grep { $_ eq $section } @{ $self->{order} };"
NSQ_SOURCE_LINE 00000061 "}"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "sub set_value {"
NSQ_SOURCE_LINE 00000064 "  my ($self, $name, $value) = @_;"
NSQ_SOURCE_LINE 00000065 "  $self->SUPER::set_value($name, $value);"
NSQ_SOURCE_LINE 00000066 "  unless ($self->{order}) {"
NSQ_SOURCE_LINE 00000067 "    $self->{order} = [ $self->starting_section ];"
NSQ_SOURCE_LINE 00000068 "  }"
NSQ_SOURCE_LINE 00000069 "}"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "sub finalize {"
NSQ_SOURCE_LINE 00000072 "  my ($self) = @_;"
NSQ_SOURCE_LINE 00000073 "  my $data = [];"
NSQ_SOURCE_LINE 00000074 "  for my $section (@{ $self->{order} || [] }) {"
NSQ_SOURCE_LINE 00000075 "    push @$data, [ $section, $self->{data}{$section} ];"
NSQ_SOURCE_LINE 00000076 "  }"
NSQ_SOURCE_LINE 00000077 "  $self->{data} = $data;"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "1;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "__END__"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=pod"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=head1 NAME"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "Config::INI::Reader::Ordered - .ini-file parser that returns sections in order"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head1 VERSION"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "version 0.022"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "If F<family.ini> contains:"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "  admin = rjbs"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "  [rjbs]"
NSQ_SOURCE_LINE 00000103 "  awesome = yes"
NSQ_SOURCE_LINE 00000104 "  height = 5' 10\""
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "  [mj]"
NSQ_SOURCE_LINE 00000107 "  awesome = totally"
NSQ_SOURCE_LINE 00000108 "  height = 23\""
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "Then when your program contains:"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "  my $array = Config::INI::Reader->read_file('family.ini');"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "C<$array> will contain:"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "  ["
NSQ_SOURCE_LINE 00000117 "    [ '_'  => { admin => 'rjbs' } ],"
NSQ_SOURCE_LINE 00000118 "    ["
NSQ_SOURCE_LINE 00000119 "      rjbs => {"
NSQ_SOURCE_LINE 00000120 "        awesome => 'yes',"
NSQ_SOURCE_LINE 00000121 "        height  => q{5' 10\"},"
NSQ_SOURCE_LINE 00000122 "      }"
NSQ_SOURCE_LINE 00000123 "    ],"
NSQ_SOURCE_LINE 00000124 "    [ "
NSQ_SOURCE_LINE 00000125 "      mj   => {"
NSQ_SOURCE_LINE 00000126 "        awesome => 'totally',"
NSQ_SOURCE_LINE 00000127 "        height  => '23\"',"
NSQ_SOURCE_LINE 00000128 "      }"
NSQ_SOURCE_LINE 00000129 "    ],"
NSQ_SOURCE_LINE 00000130 "  ]"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Config::INI::Reader::Ordered is a subclass of L<Config::INI::Reader> which"
NSQ_SOURCE_LINE 00000135 "preserves section order.  See L<Config::INI::Reader> for all documentation; the"
NSQ_SOURCE_LINE 00000136 "only difference is as presented in the L</SYNOPSIS>."
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=head1 PERL VERSION"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "This library should run on perls released even a long time ago.  It should work"
NSQ_SOURCE_LINE 00000141 "on any version of perl released in the last five years."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "Although it may work on older versions of perl, no guarantee is made that the"
NSQ_SOURCE_LINE 00000144 "minimum required version will not be increased.  The version may be increased"
NSQ_SOURCE_LINE 00000145 "for any reason, and there is no promise that patches will be accepted to lower"
NSQ_SOURCE_LINE 00000146 "the minimum required perl."
NSQ_SOURCE_LINE 00000147 ""
