NSQ_SOURCE_LINE 00000068 "    } else{"
NSQ_SOURCE_LINE 00000069 "      ( $stdout, $stderr, $exit) =  Capture::Tiny::tee { system( $cmd ) };"
NSQ_SOURCE_LINE 00000070 "    }"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "    return ($exit >> 8,$stdout.$stderr);"
NSQ_SOURCE_LINE 00000073 "}"
