NSQ_SOURCE_LINE 00000186 "        $root = $root->{$path};"
NSQ_SOURCE_LINE 00000187 "      }"
NSQ_SOURCE_LINE 00000188 "      $root->{$last_path} = $value;"
NSQ_SOURCE_LINE 00000189 "    }"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "    open CONFIG, '>', story_cache_dir().'/config.json' "
NSQ_SOURCE_LINE 00000192 "      or die \"can't open to write file \".story_cache_dir().\"/config.json : $!\";"
NSQ_SOURCE_LINE 00000193 "    my $json = JSON->new();"
NSQ_SOURCE_LINE 00000194 "    print CONFIG $json->encode($config_res);"
NSQ_SOURCE_LINE 00000195 "    close CONFIG;"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "    note(\"configuration populated and saved to \".story_cache_dir().\"/config.json\") if debug_mod12;"
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "    # populating cli_args from config_data{args}"
NSQ_SOURCE_LINE 00000200 "    unless (get_prop('cli_args')){"
NSQ_SOURCE_LINE 00000201 "      if ($config_res->{'args'} and ref($config_res->{'args'}) eq 'ARRAY'){"
NSQ_SOURCE_LINE 00000202 "        note(\"populating cli args from args in configuration data\") if debug_mod12;"
NSQ_SOURCE_LINE 00000203 "        my @cli_args;"
NSQ_SOURCE_LINE 00000204 "        for my $item (@{$config_res->{'args'}}){"
NSQ_SOURCE_LINE 00000205 "          if (! ref $item){"
NSQ_SOURCE_LINE 00000206 "            push @cli_args, $item;"
NSQ_SOURCE_LINE 00000207 "          } elsif(ref $item eq 'HASH'){"
NSQ_SOURCE_LINE 00000208 "            for my $k ( keys %{$item}){"
NSQ_SOURCE_LINE 00000209 "              my $k1 = $k;"
NSQ_SOURCE_LINE 00000210 "              if ($k1=~s/^~//){"
NSQ_SOURCE_LINE 00000211 "                push @cli_args, '-'.$k1, $item->{$k};"
NSQ_SOURCE_LINE 00000212 "              }else{"
NSQ_SOURCE_LINE 00000213 "                push @cli_args, '--'.$k1, $item->{$k};"
NSQ_SOURCE_LINE 00000214 "              }"
NSQ_SOURCE_LINE 00000215 "            }"
NSQ_SOURCE_LINE 00000216 "          } elsif(ref $item eq 'ARRAY'){"
NSQ_SOURCE_LINE 00000217 "            push @cli_args, map {"
NSQ_SOURCE_LINE 00000218 "              my $v = $_;"
NSQ_SOURCE_LINE 00000219 "              $v=~s/^~// ? '-'.$v : '--'.$v;"
NSQ_SOURCE_LINE 00000220 "            } @{$item};"
NSQ_SOURCE_LINE 00000221 "          };"
NSQ_SOURCE_LINE 00000222 "        }"
NSQ_SOURCE_LINE 00000223 "        note(\"cli args set to: \".(join ' ', @cli_args)) if debug_mod12;"
NSQ_SOURCE_LINE 00000224 "        set_prop('cli_args', join ' ', @cli_args );"
NSQ_SOURCE_LINE 00000225 "      }"
NSQ_SOURCE_LINE 00000226 "   }"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "    open CLI_ARGS, '>', story_cache_dir().'/cli_args' "
NSQ_SOURCE_LINE 00000229 "      or die \"can't open to write file \".story_cache_dir().\"/cli_args : $!\";"
NSQ_SOURCE_LINE 00000230 "    print CLI_ARGS get_prop('cli_args');"
NSQ_SOURCE_LINE 00000231 "    close CLI_ARGS;"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "    note(\"cli args populated and saved to \".story_cache_dir().\"/cli_args\") if debug_mod12;"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "    # it should be done once"
NSQ_SOURCE_LINE 00000236 "    # and it always true"
NSQ_SOURCE_LINE 00000237 "    # as populate_config() reach this lines"
NSQ_SOURCE_LINE 00000238 "    # only once, when config is really populated"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "    if ( get_prop('cwd') ) {"
NSQ_SOURCE_LINE 00000241 "      unless (chdir(get_prop('cwd'))){"
NSQ_SOURCE_LINE 00000242 "        $STATUS = 0;"
NSQ_SOURCE_LINE 00000243 "        die \"can't change working directory to: \".(get_prop('cwd')).\" : $!\";"
