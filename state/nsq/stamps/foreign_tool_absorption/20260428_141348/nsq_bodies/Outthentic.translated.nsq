NSQ_SOURCE_LINE 00000138 "      )->getall or confess \"file $path is not valid config file\";"
NSQ_SOURCE_LINE 00000139 "      $default_config = {%c}; "
NSQ_SOURCE_LINE 00000140 "    }elsif ( -f 'suite.yaml'){"
NSQ_SOURCE_LINE 00000141 "      my $path = 'suite.yaml';"
NSQ_SOURCE_LINE 00000142 "      ($default_config) = LoadFile($path);"
NSQ_SOURCE_LINE 00000143 "    }elsif ( -f 'suite.json'){"
NSQ_SOURCE_LINE 00000144 "      my $path = 'suite.json';"
NSQ_SOURCE_LINE 00000145 "      open DATA, $path or confess \"can't open file $path to read: $!\";"
NSQ_SOURCE_LINE 00000146 "      my $json_str = join \"\", <DATA>;"
NSQ_SOURCE_LINE 00000147 "      close DATA;"
NSQ_SOURCE_LINE 00000148 "      $default_config = from_json($json_str);"
NSQ_SOURCE_LINE 00000149 "    }else{"
NSQ_SOURCE_LINE 00000150 "      $default_config = { };"
NSQ_SOURCE_LINE 00000151 "    }"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    my @runtime_params;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    if (my $args_file = get_prop('args_file') ){"
NSQ_SOURCE_LINE 00000157 "      open ARGS_FILE, $args_file or die \"can't open file $args_file to read: $!\";"
NSQ_SOURCE_LINE 00000158 "      while (my $l = <ARGS_FILE>) {"
NSQ_SOURCE_LINE 00000159 "        chomp $l;"
NSQ_SOURCE_LINE 00000160 "        next unless $l=~/\\S/;"
NSQ_SOURCE_LINE 00000161 "        push @runtime_params, $l;"
NSQ_SOURCE_LINE 00000162 "      }"
NSQ_SOURCE_LINE 00000163 "      close ARGS_FILE;"
NSQ_SOURCE_LINE 00000164 "    } else {"
NSQ_SOURCE_LINE 00000165 "      @runtime_params = split /:::/, get_prop('runtime_params');"
NSQ_SOURCE_LINE 00000166 "    }"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    my $config_res = merge( $default_config, $config_data );"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    PARAM: for my $rp (@runtime_params){"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "      my $value;"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "      if ($rp=~s/=(.*)//){"
NSQ_SOURCE_LINE 00000175 "        $value = $1;"
NSQ_SOURCE_LINE 00000176 "      }else{"
NSQ_SOURCE_LINE 00000177 "        next PARAM;"
NSQ_SOURCE_LINE 00000178 "      }  "
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "      my @pathes = split /\\./, $rp;"
NSQ_SOURCE_LINE 00000181 "      my $last_path = pop @pathes;"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "      my $root = $config_res;"
NSQ_SOURCE_LINE 00000184 "      for my $path (@pathes){"
