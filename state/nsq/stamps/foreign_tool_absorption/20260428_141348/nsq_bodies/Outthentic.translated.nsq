NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "    }"
NSQ_SOURCE_LINE 00000247 "    "
NSQ_SOURCE_LINE 00000248 "    return $config_data = $config_res;"
NSQ_SOURCE_LINE 00000249 "    return $config_data;"
