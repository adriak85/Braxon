NSQ_SOURCE_LINE 00000088 "sub populate_config {"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    unless (config()){"
NSQ_SOURCE_LINE 00000091 "        if (get_prop('ini_file_path') and -f get_prop('ini_file_path') ){"
NSQ_SOURCE_LINE 00000092 "          my $path = get_prop('ini_file_path');"
NSQ_SOURCE_LINE 00000093 "          my %c  = Config::General->new( "
NSQ_SOURCE_LINE 00000094 "            -InterPolateVars => 1 ,"
NSQ_SOURCE_LINE 00000095 "            -InterPolateEnv  => 1 ,"
NSQ_SOURCE_LINE 00000096 "            -ConfigFile => $path "
NSQ_SOURCE_LINE 00000097 "          )->getall or confess \"file $path is not valid config file\";"
NSQ_SOURCE_LINE 00000098 "          $config_data = {%c};"
NSQ_SOURCE_LINE 00000099 "        }elsif(get_prop('yaml_file_path') and -f get_prop('yaml_file_path')){"
NSQ_SOURCE_LINE 00000100 "          my $path = get_prop('yaml_file_path');"
NSQ_SOURCE_LINE 00000101 "          ($config_data) = LoadFile($path);"
NSQ_SOURCE_LINE 00000102 "        }elsif ( get_prop('json_file_path') and -f get_prop('json_file_path') ){"
NSQ_SOURCE_LINE 00000103 "          my $path = get_prop('json_file_path');"
NSQ_SOURCE_LINE 00000104 "          open DATA, $path or confess \"can't open file $path to read: $!\";"
NSQ_SOURCE_LINE 00000105 "          my $json_str = join \"\", <DATA>;"
NSQ_SOURCE_LINE 00000106 "          close DATA;"
NSQ_SOURCE_LINE 00000107 "          $config_data = from_json($json_str);"
NSQ_SOURCE_LINE 00000108 "        }elsif ( -f 'suite.ini' ){"
NSQ_SOURCE_LINE 00000109 "          my $path = 'suite.ini';"
NSQ_SOURCE_LINE 00000110 "          my %c  = Config::General->new( "
NSQ_SOURCE_LINE 00000111 "            -InterPolateVars => 1 ,"
NSQ_SOURCE_LINE 00000112 "            -InterPolateEnv  => 1 ,"
NSQ_SOURCE_LINE 00000113 "            -ConfigFile => $path "
NSQ_SOURCE_LINE 00000114 "          )->getall or confess \"file $path is not valid config file\";"
NSQ_SOURCE_LINE 00000115 "          $config_data = {%c};"
NSQ_SOURCE_LINE 00000116 "        }elsif ( -f 'suite.yaml'){"
NSQ_SOURCE_LINE 00000117 "          my $path = 'suite.yaml';"
NSQ_SOURCE_LINE 00000118 "          ($config_data) = LoadFile($path);"
NSQ_SOURCE_LINE 00000119 "        }elsif ( -f 'suite.json'){"
NSQ_SOURCE_LINE 00000120 "          my $path = 'suite.json';"
NSQ_SOURCE_LINE 00000121 "          open DATA, $path or confess \"can't open file $path to read: $!\";"
NSQ_SOURCE_LINE 00000122 "          my $json_str = join \"\", <DATA>;"
NSQ_SOURCE_LINE 00000123 "          close DATA;"
NSQ_SOURCE_LINE 00000124 "          $config_data = from_json($json_str);"
NSQ_SOURCE_LINE 00000125 "        }else{"
NSQ_SOURCE_LINE 00000126 "          $config_data = { };"
NSQ_SOURCE_LINE 00000127 "        }"
NSQ_SOURCE_LINE 00000128 "    }"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    my $default_config;"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    if ( -f 'suite.ini' ){"
NSQ_SOURCE_LINE 00000133 "      my $path = 'suite.ini';"
NSQ_SOURCE_LINE 00000134 "      my %c  = Config::General->new( "
NSQ_SOURCE_LINE 00000135 "        -InterPolateVars => 1 ,"
