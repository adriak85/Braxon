NSQ_SOURCE_LINE 00002102 "L<Outthentic::DSL|https://github.com/melezhik/outthentic-dsl> - Outthentic::DSL specification."
NSQ_SOURCE_LINE 00002103 ""
NSQ_SOURCE_LINE 00002104 ""
NSQ_SOURCE_LINE 00002105 ""
NSQ_SOURCE_LINE 00002106 "=item *"
NSQ_SOURCE_LINE 00002107 ""
NSQ_SOURCE_LINE 00002108 "L<Swat|https://github.com/melezhik/swat> - Web testing framework."
NSQ_SOURCE_LINE 00002109 ""
