NSQ_SOURCE_LINE 00000366 "          return;"
NSQ_SOURCE_LINE 00000367 "        }"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "        print \"run story: $story_command ...\\n\" if debug_mod12;"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "        my ($ex_code, $out) = execute_cmd2($story_command);"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "        print_story_messages($out) if $format eq 'production';"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "        if ($ex_code == 0) {"
NSQ_SOURCE_LINE 00000376 "            outh_ok(1, \"scenario succeeded\" ) unless $format eq 'production';"
NSQ_SOURCE_LINE 00000377 "            set_prop( scenario_status => 1 );"
NSQ_SOURCE_LINE 00000378 "            Outthentic::Story::Stat->set_scenario_status(1);"
NSQ_SOURCE_LINE 00000379 "            Outthentic::Story::Stat->set_stdout($out);"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "        }elsif(ignore_story_err()){"
NSQ_SOURCE_LINE 00000382 "            outh_ok(1, \"scenario failed, still continue due to `ignore_story_err' is set\");"
NSQ_SOURCE_LINE 00000383 "            set_prop( scenario_status => 2 );"
NSQ_SOURCE_LINE 00000384 "            Outthentic::Story::Stat->set_scenario_status(2);"
NSQ_SOURCE_LINE 00000385 "            Outthentic::Story::Stat->set_stdout($out);"
NSQ_SOURCE_LINE 00000386 "        }else{"
NSQ_SOURCE_LINE 00000387 "            if ( $format eq 'production'){"
NSQ_SOURCE_LINE 00000388 "              print \"$out\";"
NSQ_SOURCE_LINE 00000389 "              outh_ok(0, \"scenario succeeded\", $ex_code);"
NSQ_SOURCE_LINE 00000390 "            } else {"
NSQ_SOURCE_LINE 00000391 "              outh_ok(0, \"scenario succeeded\", $ex_code);"
NSQ_SOURCE_LINE 00000392 "            }"
NSQ_SOURCE_LINE 00000393 "            set_prop( scenario_status => 0 );"
NSQ_SOURCE_LINE 00000394 "            Outthentic::Story::Stat->set_scenario_status(0);"
NSQ_SOURCE_LINE 00000395 "            Outthentic::Story::Stat->set_stdout($out);"
NSQ_SOURCE_LINE 00000396 "            Outthentic::Story::Stat->set_status(0);"
NSQ_SOURCE_LINE 00000397 "        }"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "        set_prop( stdout => $out );"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "    }"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "    return get_prop('stdout');"
NSQ_SOURCE_LINE 00000405 "}"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "sub header {"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "    my $project = project_root_dir();"
NSQ_SOURCE_LINE 00000410 "    my $story = get_prop('story');"
NSQ_SOURCE_LINE 00000411 "    my $story_type = get_prop('story_type');"
NSQ_SOURCE_LINE 00000412 "    my $story_file = get_prop('story_file');"
NSQ_SOURCE_LINE 00000413 "    my $debug = get_prop('debug');"
NSQ_SOURCE_LINE 00000414 "    my $ignore_story_err = ignore_story_err();"
NSQ_SOURCE_LINE 00000415 "    "
NSQ_SOURCE_LINE 00000416 "    note(\"project: $project\");"
NSQ_SOURCE_LINE 00000417 "    note(\"story: $story\");"
NSQ_SOURCE_LINE 00000418 "    note(\"story_type: $story_type\");"
NSQ_SOURCE_LINE 00000419 "    note(\"debug: $debug\");"
NSQ_SOURCE_LINE 00000420 "    note(\"ignore story errors: $ignore_story_err\");"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "}"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "sub run_and_check {"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "    my $story_check_file = shift;"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "    my $format = get_prop('format');"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "    header() if debug_mod2();"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "    dsl()->{debug_mod} = get_prop('debug');"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "    dsl()->{match_l} = get_prop('match_l');"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "    eval { dsl()->{output} = run_story_file() };"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "  "
NSQ_SOURCE_LINE 00000439 "    if ($@) {"
NSQ_SOURCE_LINE 00000440 "      $STATUS = 0;"
NSQ_SOURCE_LINE 00000441 "      die \"story run error: $@\";"
NSQ_SOURCE_LINE 00000442 "    }"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "    return unless get_prop('scenario_status'); # we don't run checks for failed scenarios"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "    return unless $story_check_file;"
NSQ_SOURCE_LINE 00000447 "    return unless -s $story_check_file; # don't run check when check file is empty"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "    eval {"
NSQ_SOURCE_LINE 00000450 "          open my $fh, $story_check_file or confess $!;"
NSQ_SOURCE_LINE 00000451 "          my $check_list = join \"\", <$fh>; close $fh;"
NSQ_SOURCE_LINE 00000452 "          dsl()->validate($check_list)"
NSQ_SOURCE_LINE 00000453 "    };"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "    my $err = $@;"
NSQ_SOURCE_LINE 00000456 "    my $check_fail=0;"
NSQ_SOURCE_LINE 00000457 "    for my $r ( @{dsl()->results}){"
NSQ_SOURCE_LINE 00000458 "        note($r->{message}) if $r->{type} eq 'debug';"
NSQ_SOURCE_LINE 00000459 "        if ($r->{type} eq 'check_expression' ){"
NSQ_SOURCE_LINE 00000460 "          Outthentic::Story::Stat->add_check_stat($r);"
NSQ_SOURCE_LINE 00000461 "          $check_fail=1 unless $r->{status};"
NSQ_SOURCE_LINE 00000462 "          if ($format eq 'production'){"
NSQ_SOURCE_LINE 00000463 "            outh_ok($r->{status}, $r->{message}) unless $r->{status}; "
NSQ_SOURCE_LINE 00000464 "          } else {"
NSQ_SOURCE_LINE 00000465 "            outh_ok($r->{status}, $r->{message}); "
NSQ_SOURCE_LINE 00000466 "          }"
NSQ_SOURCE_LINE 00000467 "          Outthentic::Story::Stat->set_status(0) unless $r->{status};"
NSQ_SOURCE_LINE 00000468 "        };"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "    }"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "    if ($err) {"
NSQ_SOURCE_LINE 00000474 "      $STATUS = 0;"
NSQ_SOURCE_LINE 00000475 "      die \"validator error: $err\";"
NSQ_SOURCE_LINE 00000476 "    }"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "    if ($format eq 'production' and $check_fail) {"
NSQ_SOURCE_LINE 00000479 "      print get_prop(\"stdout\");"
NSQ_SOURCE_LINE 00000480 "    }"
NSQ_SOURCE_LINE 00000481 "}"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "      "
NSQ_SOURCE_LINE 00000484 "sub print_story_messages {"
NSQ_SOURCE_LINE 00000485 "  my $out = shift;"
NSQ_SOURCE_LINE 00000486 "  my @m = ($out=~/outthentic_message:\\s+(.*)/g);"
NSQ_SOURCE_LINE 00000487 "  for my $m (@m) {"
NSQ_SOURCE_LINE 00000488 "    chomp $m;"
NSQ_SOURCE_LINE 00000489 "    print \"[msg] $m\\n\";"
NSQ_SOURCE_LINE 00000490 "  }"
NSQ_SOURCE_LINE 00000491 "}"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "sub outh_ok {"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "    my $status    = shift;"
NSQ_SOURCE_LINE 00000496 "    my $message   = shift;"
NSQ_SOURCE_LINE 00000497 "    my $exit_code = shift;"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "    my $format = get_prop('format');"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "    if ($format ne 'concise'){"
NSQ_SOURCE_LINE 00000502 "      if ($status) {"
NSQ_SOURCE_LINE 00000503 "        print nocolor() ? \"ok\\t$message\\n\" : colored(['green'],\"ok\\t$message\").\"\\n\";"
NSQ_SOURCE_LINE 00000504 "      } else {"
NSQ_SOURCE_LINE 00000505 "        print nocolor() ? \"not ok\\t$message\\n\" : colored(['red'], \"not ok\\t$message\").\"\\n\";"
NSQ_SOURCE_LINE 00000506 "      }"
NSQ_SOURCE_LINE 00000507 "    }"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "    if ($status == 0 and $STATUS != 0 ){"
NSQ_SOURCE_LINE 00000510 "      $STATUS = ($exit_code == 1 ) ? -1 : 0;"
NSQ_SOURCE_LINE 00000511 "    }"
NSQ_SOURCE_LINE 00000512 "}"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "sub note {"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "    my $message = shift;"
NSQ_SOURCE_LINE 00000517 "    my $no_new_line = shift;"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "    binmode(STDOUT, \":utf8\");"
NSQ_SOURCE_LINE 00000520 "    print $message;"
NSQ_SOURCE_LINE 00000521 "    print \"\\n\" unless $no_new_line;"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "}"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "sub print_meta {"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "    open META, get_prop('story_dir').\"/meta.txt\" or die $!;"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "    my $task_name = get_prop('task_name');"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "    #note( ( nocolor() ? short_story_name($task_name) : colored( ['yellow'], short_story_name($task_name) ) ));"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "    while (my $i = <META>){"
NSQ_SOURCE_LINE 00000535 "        chomp $i;"
NSQ_SOURCE_LINE 00000536 "        $i='@ '.$i;"
NSQ_SOURCE_LINE 00000537 "        note( nocolor() ? $i : colored( ['magenta'],  \"$i\" ));"
NSQ_SOURCE_LINE 00000538 "    }"
NSQ_SOURCE_LINE 00000539 "    close META;"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "}"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "sub short_story_name {"
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "    my $task_name = shift;"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "    my $story_dir = get_prop('story_dir');"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "    my $cwd_size = scalar(split /\\//, get_prop('project_root_dir'));"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "    my $short_story_dir;"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "    my $i;"
NSQ_SOURCE_LINE 00000554 ""
NSQ_SOURCE_LINE 00000555 "    for my $l (split /\\//, $story_dir){"
NSQ_SOURCE_LINE 00000556 "      $short_story_dir.=$l. ( ($^O  =~ 'MSWin') ? \"\\\\\" : \"/\" ) unless $i++ < $cwd_size;"
NSQ_SOURCE_LINE 00000557 "    }"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "    my $story_vars = story_vars_pretty();"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "    $short_story_dir ||=  ($^O  =~ 'MSWin') ? \"\\\\\" : \"/\";"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "    my @ret;"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "    push @ret, \"$short_story_dir\" if $short_story_dir;"
NSQ_SOURCE_LINE 00000567 "    push @ret, \"{$story_vars}\" if $story_vars;"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "    join \"\", @ret;"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "}"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "sub timestamp {"
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "    sprintf '%02d-%02d-%02d %02d:%02d:%02d', "
NSQ_SOURCE_LINE 00000576 "    localtime->year()+1900, "
NSQ_SOURCE_LINE 00000577 "    localtime->mon()+1, localtime->mday, "
NSQ_SOURCE_LINE 00000578 "    localtime->hour, localtime->min, localtime->sec;"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "}"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "END {"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "  #print \"STATUS: $STATUS\\n\";"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "  if ($STATUS == 1){"
NSQ_SOURCE_LINE 00000587 "    exit(0);"
NSQ_SOURCE_LINE 00000588 "  } elsif($STATUS == -1){"
NSQ_SOURCE_LINE 00000589 "    exit(1);"
NSQ_SOURCE_LINE 00000590 "  } else{"
NSQ_SOURCE_LINE 00000591 "    exit(2);"
NSQ_SOURCE_LINE 00000592 "  }"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "  "
NSQ_SOURCE_LINE 00000595 "}"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "1;"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "__END__"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "=encoding utf8"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "=head1 Name"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "Outthentic - Multipurpose scenarios framework."
NSQ_SOURCE_LINE 00000609 ""
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "=head1 Synopsis"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "Multipurpose scenarios framework."
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "=head1 Build statuses"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "L<![Build Status](https://travis-ci.org/melezhik/outthentic.svg)|https://travis-ci.org/melezhik/outthentic>"
NSQ_SOURCE_LINE 00000619 ""
NSQ_SOURCE_LINE 00000620 "L<![Build status](https://ci.appveyor.com/api/projects/status/pkn4rerw4g27mqfx?svg=true)|https://ci.appveyor.com/project/melezhik/outthentic>"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "=head1 Install"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "    $ cpanm Outthentic"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "=head1 Introduction"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "This is an outthentic tutorial. "
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 ""
NSQ_SOURCE_LINE 00000633 "=head1 Scenarios"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "Scenario is just a script that you B<run> and that yields something into B<stdout>."
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "Perl scenario example:"
NSQ_SOURCE_LINE 00000638 ""
NSQ_SOURCE_LINE 00000639 "    $ nano story.pl"
NSQ_SOURCE_LINE 00000640 "    "
NSQ_SOURCE_LINE 00000641 "      print \"I am OK\\n\";"
NSQ_SOURCE_LINE 00000642 "      print \"I am outthentic\\n\";"
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "Bash scenario example:"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "    $ nano story.bash"
NSQ_SOURCE_LINE 00000647 "    "
NSQ_SOURCE_LINE 00000648 "      echo I am OK"
NSQ_SOURCE_LINE 00000649 "      echo I am outthentic"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "Python scenario example:"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "    $ nano story.py"
NSQ_SOURCE_LINE 00000654 "    "
NSQ_SOURCE_LINE 00000655 "      print \"I am OK\""
NSQ_SOURCE_LINE 00000656 "      print \"I am outthentic\""
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "Ruby scenario example:"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "    $ nano story.rb"
NSQ_SOURCE_LINE 00000661 "    "
NSQ_SOURCE_LINE 00000662 "      puts \"I am OK\""
NSQ_SOURCE_LINE 00000663 "      puts \"I am outthentic\""
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "Powershell scenario example:"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "    $ nano story.ps1"
NSQ_SOURCE_LINE 00000668 "    "
NSQ_SOURCE_LINE 00000669 "      Write-Host \"I am OK\""
NSQ_SOURCE_LINE 00000670 "      Write-Host \"I am outthentic\""
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "Outthentic scenarios could be written in one of the five languages:"
NSQ_SOURCE_LINE 00000673 ""
NSQ_SOURCE_LINE 00000674 "=over"
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "=item *"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "Perl "
NSQ_SOURCE_LINE 00000679 ""
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "=item *"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "Bash"
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "=item *"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "Python"
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "=item *"
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "Ruby"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 ""
NSQ_SOURCE_LINE 00000696 "=item *"
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "Powershell"
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "=back"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "Choose you favorite language ;) !"
NSQ_SOURCE_LINE 00000704 ""
NSQ_SOURCE_LINE 00000705 "Outthentic relies on file names convention to determine scenario language. "
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "This table describes C<<< file name -> language >>> mapping for scenarios:"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "    +------------+--------------+"
NSQ_SOURCE_LINE 00000710 "    | Language   | File         |"
NSQ_SOURCE_LINE 00000711 "    +------------+--------------+"
NSQ_SOURCE_LINE 00000712 "    | Perl       | story.pl     |"
NSQ_SOURCE_LINE 00000713 "    | Bash       | story.bash   |"
NSQ_SOURCE_LINE 00000714 "    | Python     | story.py     |"
NSQ_SOURCE_LINE 00000715 "    | Ruby       | story.rb     |"
NSQ_SOURCE_LINE 00000716 "    | Powershell | story.ps1    |"
NSQ_SOURCE_LINE 00000717 "    +------------+--------------+"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "=head1 Check files"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "Check files contain rules to B<verify> stdout produced by scenarios. "
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "Here we require that scenario should produce  C<I am OK> and C<I am outthentic> lines in stdout:"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "    $ nano story.check"
NSQ_SOURCE_LINE 00000727 "    "
NSQ_SOURCE_LINE 00000728 "      I am OK"
NSQ_SOURCE_LINE 00000729 "      I am outthentic"
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "NOTE: Check files are optional, if one doesn't need any checks, then don't create check files."
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "In this case it's only ensured that a scenario succeeds ( exit code 0 )."
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "=head1 Stories"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "Outthentic story is an abstraction for scenario and check file. "
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "When outthentic story gets run:"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "=over"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "=item *"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "scenario is executed and the output is saved into a file."
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "=item *"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "the output is verified against check file"
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "=back"
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "See also L<story runner|#story-runner>."
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "=head1 Suites and projects"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "Outthentic suites are a bunch of related stories. You may also call suites (outthentic) projects."
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "Obviously project may contain more than one story. "
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "Stories are mapped into directories inside the project root directory."
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "Here are examples:"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "Perl:"
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "    $ mkdir perl-story"
NSQ_SOURCE_LINE 00000772 "    "
NSQ_SOURCE_LINE 00000773 "    $ nano  perl-story/story.pl"
NSQ_SOURCE_LINE 00000774 "    "
NSQ_SOURCE_LINE 00000775 "      print \"hello from perl\""
NSQ_SOURCE_LINE 00000776 "    "
NSQ_SOURCE_LINE 00000777 "    $ nano perl-story/story.check"
NSQ_SOURCE_LINE 00000778 "    "
NSQ_SOURCE_LINE 00000779 "      hello from perl"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "Bash:"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "    $ mkdir bash-story"
NSQ_SOURCE_LINE 00000784 "    "
NSQ_SOURCE_LINE 00000785 "    $ nano bash-story/story.bash"
NSQ_SOURCE_LINE 00000786 "    "
NSQ_SOURCE_LINE 00000787 "      echo hello from bash "
NSQ_SOURCE_LINE 00000788 "    "
NSQ_SOURCE_LINE 00000789 "    $ nano bash-story/story.check"
NSQ_SOURCE_LINE 00000790 "    "
NSQ_SOURCE_LINE 00000791 "      hello from bash "
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "Python:"
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "    $ mkdir python-story"
NSQ_SOURCE_LINE 00000796 "    "
NSQ_SOURCE_LINE 00000797 "    $ nano python-story/story.py"
NSQ_SOURCE_LINE 00000798 "    "
NSQ_SOURCE_LINE 00000799 "      print \"hello from python\" "
NSQ_SOURCE_LINE 00000800 "    "
NSQ_SOURCE_LINE 00000801 "    $ nano python-story/story.check"
NSQ_SOURCE_LINE 00000802 "    "
NSQ_SOURCE_LINE 00000803 "      hello from python "
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "Ruby:"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "    $ mkdir ruby-story"
NSQ_SOURCE_LINE 00000808 "    "
NSQ_SOURCE_LINE 00000809 "    $ nano ruby-story/story.rb"
NSQ_SOURCE_LINE 00000810 "    "
NSQ_SOURCE_LINE 00000811 "      puts \"hello from ruby\""
NSQ_SOURCE_LINE 00000812 "    "
NSQ_SOURCE_LINE 00000813 "    $ nano ruby-story/story.check"
NSQ_SOURCE_LINE 00000814 "    "
NSQ_SOURCE_LINE 00000815 "      hello from ruby "
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "Powershell:"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "    $ mkdir powershell-story"
NSQ_SOURCE_LINE 00000820 "    "
NSQ_SOURCE_LINE 00000821 "    $ nano ruby-story/story.ps"
NSQ_SOURCE_LINE 00000822 "    "
NSQ_SOURCE_LINE 00000823 "      Write-Host \"hello from powershell\""
NSQ_SOURCE_LINE 00000824 "    "
NSQ_SOURCE_LINE 00000825 "    $ nano ruby-story/story.check"
NSQ_SOURCE_LINE 00000826 "    "
NSQ_SOURCE_LINE 00000827 "      hello from powershell"
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "To execute different stories launch story runner command called L<strun|#story-runner>:"
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "    $ strun --story perl-story"
NSQ_SOURCE_LINE 00000832 "    $ strun --story bash-story "
NSQ_SOURCE_LINE 00000833 "    "
NSQ_SOURCE_LINE 00000834 "    # so on ..."
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "=head1 The project root directory resolution and story paths"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "If C<--root> parameter is not set the project root directory is the current working directory."
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "By default, if C<--story> parameter is not given, strun looks for the file named story.(pl|rb|bash) at the project root directory"
NSQ_SOURCE_LINE 00000842 "and run it."
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "Here is an example:"
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "    $ nano story.bash"
NSQ_SOURCE_LINE 00000847 "    "
NSQ_SOURCE_LINE 00000848 "      echo 'hello world'"
NSQ_SOURCE_LINE 00000849 "    "
NSQ_SOURCE_LINE 00000850 "    $ strun # will run story.bash "
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "It's always possible to pass the project root directory explicitly:"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "    $ strun --root /path/to/project/root/"
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "To run the certain story use C<--story> parameter:"
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "    $ strun --story story1"
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 "C<--story> parameter should point a directory I<relative> to the project root directory."
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "Summary:"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "=over"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "=item *"
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "Stories are just a directories with scenarios and check files inside.      "
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "=item *"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "Strun - a [S]tory [R]unner - a console tool to execute stories."
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 "=item *"
NSQ_SOURCE_LINE 00000880 ""
NSQ_SOURCE_LINE 00000881 "Outthentic suites or projects are bunches of I<related> stories."
NSQ_SOURCE_LINE 00000882 ""
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 ""
NSQ_SOURCE_LINE 00000885 "=back"
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "=head1 Check files"
NSQ_SOURCE_LINE 00000889 ""
NSQ_SOURCE_LINE 00000890 "Checks files contain rules to test scenario's output. "
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "Every scenario B<might be accompanied by> its check file. "
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "Check file should be placed at the same directory as scenario and be named as C<story.check>."
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "Here is an example:"
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "    $ nano story.bash"
NSQ_SOURCE_LINE 00000899 "    "
NSQ_SOURCE_LINE 00000900 "      sudo service nginx status"
NSQ_SOURCE_LINE 00000901 "     "
NSQ_SOURCE_LINE 00000902 "    $ nano story.check"
NSQ_SOURCE_LINE 00000903 "    "
NSQ_SOURCE_LINE 00000904 "      running"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "=head1 Story runner"
NSQ_SOURCE_LINE 00000908 ""
NSQ_SOURCE_LINE 00000909 "Story runner is a console tool to run stories. It is called C<strun>."
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "When executing stories strun consequentially goes through several phases:"
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "=head1 Compilation phase"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "Stories are compiled into Perl files and saved into cache directory."
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "=head1 Execution phase"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "Compiled Perl files are executed and results are dumped out to console. "
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "=head1 Hooks"
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "Story hooks are story runner's extension points. "
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "Hook features:"
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "=over"
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "=item *"
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "Hooks like scenarios are scripts written on different languages (Perl,Bash,Ruby,Python)"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 ""
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "=item *"
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "Hooks always I<binds to some story>, to create a hook you should place hook's script into story directory."
NSQ_SOURCE_LINE 00000941 ""
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "=item *"
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "Hooks are are executed I<before> scenarios"
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 ""
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "=back"
NSQ_SOURCE_LINE 00000951 ""
NSQ_SOURCE_LINE 00000952 "Here is an example of hook:"
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "    $ nano perl/hook.pl"
NSQ_SOURCE_LINE 00000955 "    "
NSQ_SOURCE_LINE 00000956 "      print \"this is a story hook!\";"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "This table describes file name -> language mapping for scenarios:"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "    +------------+--------------+"
NSQ_SOURCE_LINE 00000961 "    | Language   | File         |"
NSQ_SOURCE_LINE 00000962 "    +------------+--------------+"
NSQ_SOURCE_LINE 00000963 "    | Perl       | hook.pl      |"
NSQ_SOURCE_LINE 00000964 "    | Bash       | hook.bash    |"
NSQ_SOURCE_LINE 00000965 "    | Python     | hook.py      |"
NSQ_SOURCE_LINE 00000966 "    | Ruby       | hook.rb      |"
NSQ_SOURCE_LINE 00000967 "    | Powershell | hook.ps1     |"
NSQ_SOURCE_LINE 00000968 "    +------------+--------------+"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "Reasons why you might need hooks:"
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "=over"
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "=item *"
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "Execute some I<initialization code> before running a scenario"
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "=item *"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "Simulate scenario's output"
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "=item *"
NSQ_SOURCE_LINE 00000985 ""
NSQ_SOURCE_LINE 00000986 "Call another stories"
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "=back"
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "=head1 Simulate scenario output"
NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "Sometimes you want to override story output at hook level. "
NSQ_SOURCE_LINE 00000995 ""
NSQ_SOURCE_LINE 00000996 "This is for example might be useful if you want to I<test> the rules in check files without running real script."
NSQ_SOURCE_LINE 00000997 ""
NSQ_SOURCE_LINE 00000998 "In QA methodology it's called Mock objects:"
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "    $ nano hook.bash"
NSQ_SOURCE_LINE 00001001 "    "
NSQ_SOURCE_LINE 00001002 "      set_stdout 'running'"
NSQ_SOURCE_LINE 00001003 "    "
NSQ_SOURCE_LINE 00001004 "    $ nano story.check"
NSQ_SOURCE_LINE 00001005 "    "
NSQ_SOURCE_LINE 00001006 "      running"
NSQ_SOURCE_LINE 00001007 ""
NSQ_SOURCE_LINE 00001008 "It's important to say that if overriding happens story executor never try to run scenario even if it presents:"
NSQ_SOURCE_LINE 00001009 ""
NSQ_SOURCE_LINE 00001010 "    $ nano hook.bash"
NSQ_SOURCE_LINE 00001011 "    "
NSQ_SOURCE_LINE 00001012 "      set_stdout 'running'"
NSQ_SOURCE_LINE 00001013 "    "
NSQ_SOURCE_LINE 00001014 "    $ nano story.bash"
NSQ_SOURCE_LINE 00001015 "    "
NSQ_SOURCE_LINE 00001016 "      sudo service nginx status # this command won't be executed"
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "You may call C<set_stdout> function more then once:"
NSQ_SOURCE_LINE 00001019 ""
NSQ_SOURCE_LINE 00001020 "    $ nano hook.pl"
NSQ_SOURCE_LINE 00001021 "    "
NSQ_SOURCE_LINE 00001022 "      set_stdout(\"HELLO WORLD\");"
NSQ_SOURCE_LINE 00001023 "      set_stdout(\"HELLO WORLD2\");"
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "It will \"produce\" two line of a story output:"
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "    HELLO WORLD"
NSQ_SOURCE_LINE 00001028 "    HELLO WORLD2"
NSQ_SOURCE_LINE 00001029 ""
NSQ_SOURCE_LINE 00001030 "This table describes how C<set_stdout()> function is called in various languages:"
NSQ_SOURCE_LINE 00001031 ""
NSQ_SOURCE_LINE 00001032 "    +-------------+-----------------------+"
NSQ_SOURCE_LINE 00001033 "    | Language    | signature             |"
NSQ_SOURCE_LINE 00001034 "    +-------------+-----------------------+"
NSQ_SOURCE_LINE 00001035 "    | Perl        | set_stdout(SCALAR)    |"
NSQ_SOURCE_LINE 00001036 "    | Bash        | set_stdout(STRING)    |"
NSQ_SOURCE_LINE 00001037 "    | Python(*)   | set_stdout(STRING)    |"
NSQ_SOURCE_LINE 00001038 "    | Ruby        | set_stdout(STRING)    |"
NSQ_SOURCE_LINE 00001039 "    | Powershell  | set_stdout(STRING)    |"
NSQ_SOURCE_LINE 00001040 "    +-------------+-----------------------+"
NSQ_SOURCE_LINE 00001041 ""
NSQ_SOURCE_LINE 00001042 "(*) You need to C<from outthentic import *> in Python to import set_stdout function."
NSQ_SOURCE_LINE 00001043 ""
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "=head1 Run stories from other stories"
NSQ_SOURCE_LINE 00001046 ""
NSQ_SOURCE_LINE 00001047 "Hooks allow you to call one story from other one. "
NSQ_SOURCE_LINE 00001048 ""
NSQ_SOURCE_LINE 00001049 "Here are examples:"
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 "    $ nano modules/knock-the-door/story.rb"
NSQ_SOURCE_LINE 00001052 "    "
NSQ_SOURCE_LINE 00001053 "      # this is a downstream story"
NSQ_SOURCE_LINE 00001054 "      # to make story downstream"
NSQ_SOURCE_LINE 00001055 "      # simply create story files "
NSQ_SOURCE_LINE 00001056 "      # in modules/ directory"
NSQ_SOURCE_LINE 00001057 "    "
NSQ_SOURCE_LINE 00001058 "      puts 'knock-knock!'\" "
NSQ_SOURCE_LINE 00001059 "     "
NSQ_SOURCE_LINE 00001060 "    $ nano modules/knock-the-door/story.check"
NSQ_SOURCE_LINE 00001061 "    "
NSQ_SOURCE_LINE 00001062 "      knock-knock!"
NSQ_SOURCE_LINE 00001063 "    "
NSQ_SOURCE_LINE 00001064 "    $ nano open-the-door/hook.rb"
NSQ_SOURCE_LINE 00001065 "    "
NSQ_SOURCE_LINE 00001066 "      # this is a upstream story"
NSQ_SOURCE_LINE 00001067 "      # to run downstream story"
NSQ_SOURCE_LINE 00001068 "      # call run_story function"
NSQ_SOURCE_LINE 00001069 "      # inside hook"
NSQ_SOURCE_LINE 00001070 "    "
NSQ_SOURCE_LINE 00001071 "      # run_story accepts parameter - story path,"
NSQ_SOURCE_LINE 00001072 "      # notice that you have to omit 'modules/' part"
NSQ_SOURCE_LINE 00001073 "    "
NSQ_SOURCE_LINE 00001074 "      run_story( 'knock-the-door' );"
NSQ_SOURCE_LINE 00001075 "    "
NSQ_SOURCE_LINE 00001076 "    $ nano open-the-door/story.rb"
NSQ_SOURCE_LINE 00001077 "    "
NSQ_SOURCE_LINE 00001078 "      puts 'opening ...' "
NSQ_SOURCE_LINE 00001079 "    "
NSQ_SOURCE_LINE 00001080 "    $ nano open-the-door/story.check"
NSQ_SOURCE_LINE 00001081 "    "
NSQ_SOURCE_LINE 00001082 "      opening"
NSQ_SOURCE_LINE 00001083 "    "
NSQ_SOURCE_LINE 00001084 "    $ strun --story open-the-door/"
NSQ_SOURCE_LINE 00001085 "     "
NSQ_SOURCE_LINE 00001086 "      /modules/knock-the-door/ started"
NSQ_SOURCE_LINE 00001087 "    "
NSQ_SOURCE_LINE 00001088 "      knock-knock!"
NSQ_SOURCE_LINE 00001089 "      OK  scenario succeeded"
NSQ_SOURCE_LINE 00001090 "      OK  output match 'knock-knock!'"
NSQ_SOURCE_LINE 00001091 "    "
NSQ_SOURCE_LINE 00001092 "      /open-the-door/ started"
NSQ_SOURCE_LINE 00001093 "    "
NSQ_SOURCE_LINE 00001094 "      opening ..."
NSQ_SOURCE_LINE 00001095 "      OK  scenario succeeded"
NSQ_SOURCE_LINE 00001096 "      OK  output match 'opening'"
NSQ_SOURCE_LINE 00001097 "      ---"
NSQ_SOURCE_LINE 00001098 "      STATUS  SUCCEED"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "Stories that run other stories are called I<upstream stories>."
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "Stories being called from other ones are I<downstream story>."
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 "Summary:"
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 "=over"
NSQ_SOURCE_LINE 00001107 ""
NSQ_SOURCE_LINE 00001108 "=item *"
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "To create downstream story place a story data in C<modules/> directory inside the project root directory."
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 ""
NSQ_SOURCE_LINE 00001114 "=item *"
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "To run downstream story call C<run_story(story_path)> function inside the upstream story's hook."
NSQ_SOURCE_LINE 00001117 ""
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 ""
NSQ_SOURCE_LINE 00001120 "=item *"
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "Downstream story is always gets executed before upstream story."
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "=item *"
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "You can call as many downstream stories as you wish."
NSQ_SOURCE_LINE 00001129 ""
NSQ_SOURCE_LINE 00001130 ""
NSQ_SOURCE_LINE 00001131 ""
NSQ_SOURCE_LINE 00001132 "=item *"
NSQ_SOURCE_LINE 00001133 ""
NSQ_SOURCE_LINE 00001134 "Downstream stories may call other downstream stories."
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 ""
NSQ_SOURCE_LINE 00001137 ""
NSQ_SOURCE_LINE 00001138 "=back"
NSQ_SOURCE_LINE 00001139 ""
NSQ_SOURCE_LINE 00001140 "Here is more sophisticated examples of downstream stories:"
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "    $ nano modules/up/story.pl "
NSQ_SOURCE_LINE 00001143 "    "
NSQ_SOURCE_LINE 00001144 "      print \"UP!\""
NSQ_SOURCE_LINE 00001145 "    "
NSQ_SOURCE_LINE 00001146 "    $ nano modules/down/story.pl "
NSQ_SOURCE_LINE 00001147 "    "
NSQ_SOURCE_LINE 00001148 "      print \"DOWN!\""
NSQ_SOURCE_LINE 00001149 "    "
NSQ_SOURCE_LINE 00001150 "    $ nano two-jumps/hook.pl"
NSQ_SOURCE_LINE 00001151 "    "
NSQ_SOURCE_LINE 00001152 "      run_story( 'up' );"
NSQ_SOURCE_LINE 00001153 "      run_story( 'down' );"
NSQ_SOURCE_LINE 00001154 "      run_story( 'up' );"
NSQ_SOURCE_LINE 00001155 "      run_story( 'down' );"
NSQ_SOURCE_LINE 00001156 ""
NSQ_SOURCE_LINE 00001157 ""
NSQ_SOURCE_LINE 00001158 "=head1 Story variables "
NSQ_SOURCE_LINE 00001159 ""
NSQ_SOURCE_LINE 00001160 "Variables might be passed to downstream story by the second argument of C<run_story()> function. "
NSQ_SOURCE_LINE 00001161 ""
NSQ_SOURCE_LINE 00001162 "For example, in Perl:"
NSQ_SOURCE_LINE 00001163 ""
NSQ_SOURCE_LINE 00001164 "    $ nano hook.pl"
NSQ_SOURCE_LINE 00001165 "    "
NSQ_SOURCE_LINE 00001166 "      run_story( "
NSQ_SOURCE_LINE 00001167 "        'greeting', {  name => 'Alexey' , message => 'hello' }  "
NSQ_SOURCE_LINE 00001168 "      );"
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 "Or in Ruby:"
NSQ_SOURCE_LINE 00001171 ""
NSQ_SOURCE_LINE 00001172 "    $ nano hook.rb"
NSQ_SOURCE_LINE 00001173 "    "
NSQ_SOURCE_LINE 00001174 "      run_story  'greeting', {  'name' => 'Alexey' , 'message' => 'hello' }"
NSQ_SOURCE_LINE 00001175 ""
NSQ_SOURCE_LINE 00001176 "Or in Python:"
NSQ_SOURCE_LINE 00001177 ""
NSQ_SOURCE_LINE 00001178 "    $ nano hook.rb"
NSQ_SOURCE_LINE 00001179 "    "
NSQ_SOURCE_LINE 00001180 "      from outthentic import *"
NSQ_SOURCE_LINE 00001181 "    "
NSQ_SOURCE_LINE 00001182 "      run_story('greeting', {  'name' : 'Alexey' , 'message' : 'hello' })"
NSQ_SOURCE_LINE 00001183 ""
NSQ_SOURCE_LINE 00001184 "Or in Bash:"
NSQ_SOURCE_LINE 00001185 ""
NSQ_SOURCE_LINE 00001186 "    $ nano hook.bash"
NSQ_SOURCE_LINE 00001187 "    "
NSQ_SOURCE_LINE 00001188 "      run_story  greeting name Alexey message hello "
NSQ_SOURCE_LINE 00001189 ""
NSQ_SOURCE_LINE 00001190 "Or in Powershell:"
NSQ_SOURCE_LINE 00001191 ""
NSQ_SOURCE_LINE 00001192 "    $ nano hook.ps1"
NSQ_SOURCE_LINE 00001193 "    "
NSQ_SOURCE_LINE 00001194 "      $params = @{name=\"Alexey\";message=\"hello\"}  "
NSQ_SOURCE_LINE 00001195 "      run_story 'greeting', -hash $params"
NSQ_SOURCE_LINE 00001196 ""
NSQ_SOURCE_LINE 00001197 "This table describes how C<run_story()> function is called in various languages:"
NSQ_SOURCE_LINE 00001198 ""
NSQ_SOURCE_LINE 00001199 "    +------------+----------------------------------------------+"
NSQ_SOURCE_LINE 00001200 "    | Language   | signature                                    |"
NSQ_SOURCE_LINE 00001201 "    +------------+----------------------------------------------+"
NSQ_SOURCE_LINE 00001202 "    | Perl       | run_story(SCALAR,HASHREF)                    |"
NSQ_SOURCE_LINE 00001203 "    | Bash       | run_story STORY_NAME NAME VAL NAME2 VAL2 ... | "
NSQ_SOURCE_LINE 00001204 "    | Python(*)  | run_story(STRING,DICT)                       | "
NSQ_SOURCE_LINE 00001205 "    | Ruby       | run_story(STRING,HASH)                       | "
NSQ_SOURCE_LINE 00001206 "    | Powershell | run_story(STRING,HASH)                       | "
NSQ_SOURCE_LINE 00001207 "    +------------+----------------------------------------------+"
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 "Story variables are accessible in downstream story by C<story_var()> function, see below."
NSQ_SOURCE_LINE 00001210 ""
NSQ_SOURCE_LINE 00001211 "(*) You need to C<from outthentic import *> in Python to import set_stdout function."
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 "Examples:"
NSQ_SOURCE_LINE 00001214 ""
NSQ_SOURCE_LINE 00001215 "In Perl:"
NSQ_SOURCE_LINE 00001216 ""
NSQ_SOURCE_LINE 00001217 "    $ nano modules/greeting/story.pl"
NSQ_SOURCE_LINE 00001218 "    "
NSQ_SOURCE_LINE 00001219 "      print story_var('name'), 'say ', story_var('message');"
NSQ_SOURCE_LINE 00001220 ""
NSQ_SOURCE_LINE 00001221 "In Python:"
NSQ_SOURCE_LINE 00001222 ""
NSQ_SOURCE_LINE 00001223 "    $ nano modules/greeting/story.py"
NSQ_SOURCE_LINE 00001224 "    "
NSQ_SOURCE_LINE 00001225 "      from outthentic import *"
NSQ_SOURCE_LINE 00001226 "    "
NSQ_SOURCE_LINE 00001227 "      print story_var('name') + 'say ' + story_var('message')"
NSQ_SOURCE_LINE 00001228 ""
NSQ_SOURCE_LINE 00001229 "In Ruby:"
NSQ_SOURCE_LINE 00001230 ""
NSQ_SOURCE_LINE 00001231 "    $ nano modules/greeting/story.rb"
NSQ_SOURCE_LINE 00001232 "    "
NSQ_SOURCE_LINE 00001233 "      puts \"#{story_var('name')} say #{story_var('message')}\""
NSQ_SOURCE_LINE 00001234 ""
NSQ_SOURCE_LINE 00001235 "In Bash:"
NSQ_SOURCE_LINE 00001236 ""
NSQ_SOURCE_LINE 00001237 "    $ nano modules/greeting/story.bash"
NSQ_SOURCE_LINE 00001238 "    "
NSQ_SOURCE_LINE 00001239 "      echo $name say $message"
NSQ_SOURCE_LINE 00001240 ""
NSQ_SOURCE_LINE 00001241 "In Bash (alternative way):"
NSQ_SOURCE_LINE 00001242 ""
NSQ_SOURCE_LINE 00001243 "    $ nano modules/greeting/story.bash"
NSQ_SOURCE_LINE 00001244 "    "
NSQ_SOURCE_LINE 00001245 "      echo $(story_var name) say $(story_var message)"
NSQ_SOURCE_LINE 00001246 ""
NSQ_SOURCE_LINE 00001247 "In Powershell:"
NSQ_SOURCE_LINE 00001248 ""
NSQ_SOURCE_LINE 00001249 "    $ nano modules/greeting/story.ps1"
NSQ_SOURCE_LINE 00001250 "    "
NSQ_SOURCE_LINE 00001251 "      $name     =  story_var 'name'"
NSQ_SOURCE_LINE 00001252 "      $message  =  story_var 'message'"
NSQ_SOURCE_LINE 00001253 "    "
NSQ_SOURCE_LINE 00001254 "      Write-Host \"$name say $message\""
NSQ_SOURCE_LINE 00001255 ""
NSQ_SOURCE_LINE 00001256 "Story variables are accessible inside check files as well."
NSQ_SOURCE_LINE 00001257 ""
NSQ_SOURCE_LINE 00001258 "This table describes how C<story_story()> function is called in various languages:"
NSQ_SOURCE_LINE 00001259 ""
NSQ_SOURCE_LINE 00001260 "    +------------------+---------------------------------------------+"
NSQ_SOURCE_LINE 00001261 "    | Language         | signature                                   |"
NSQ_SOURCE_LINE 00001262 "    +------------------+---------------------------------------------+"
NSQ_SOURCE_LINE 00001263 "    | Perl             | story_var(SCALAR)                           |"
NSQ_SOURCE_LINE 00001264 "    | Python(*)        | story_var(STRING)                           | "
NSQ_SOURCE_LINE 00001265 "    | Ruby             | story_var(STRING)                           | "
NSQ_SOURCE_LINE 00001266 "    | Bash (1-st way)  | $foo $bar ...                               |"
NSQ_SOURCE_LINE 00001267 "    | Bash (2-nd way)  | $(story_var foo.bar)                        |"
NSQ_SOURCE_LINE 00001268 "    | Powershell       | story_var(STRING)                           | "
NSQ_SOURCE_LINE 00001269 "    +------------------+---------------------------------------------+"
NSQ_SOURCE_LINE 00001270 ""
NSQ_SOURCE_LINE 00001271 "(*) You need to C<from outthentic import *> in Python to import story_var() function."
NSQ_SOURCE_LINE 00001272 ""
NSQ_SOURCE_LINE 00001273 ""
NSQ_SOURCE_LINE 00001274 "=head1 Stories without scenarios"
NSQ_SOURCE_LINE 00001275 ""
NSQ_SOURCE_LINE 00001276 "The minimal set of files should be present in outthentic story is either scenario file or hook script,"
NSQ_SOURCE_LINE 00001277 "the last option is story without scenario."
NSQ_SOURCE_LINE 00001278 ""
NSQ_SOURCE_LINE 00001279 "Examples:"
NSQ_SOURCE_LINE 00001280 ""
NSQ_SOURCE_LINE 00001281 "    # Story with scenario only"
NSQ_SOURCE_LINE 00001282 "    "
NSQ_SOURCE_LINE 00001283 "    $ nano story.pl"
NSQ_SOURCE_LINE 00001284 "    "
NSQ_SOURCE_LINE 00001285 "    # Story with hook only"
NSQ_SOURCE_LINE 00001286 "    "
NSQ_SOURCE_LINE 00001287 "    $ nano hook.pl"
NSQ_SOURCE_LINE 00001288 ""
NSQ_SOURCE_LINE 00001289 ""
NSQ_SOURCE_LINE 00001290 "=head1 Story helper functions"
NSQ_SOURCE_LINE 00001291 ""
NSQ_SOURCE_LINE 00001292 "Here is the list of function one can use I<inside hooks>:"
NSQ_SOURCE_LINE 00001293 ""
NSQ_SOURCE_LINE 00001294 "=over"
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 "=item *"
NSQ_SOURCE_LINE 00001297 ""
NSQ_SOURCE_LINE 00001298 "C<project_root_dir()> - the project root directory."
NSQ_SOURCE_LINE 00001299 ""
NSQ_SOURCE_LINE 00001300 ""
NSQ_SOURCE_LINE 00001301 ""
NSQ_SOURCE_LINE 00001302 "=item *"
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 "C<cache_root_dir()> - the cache root directory ( see  L<strun|#story-runner> )."
NSQ_SOURCE_LINE 00001305 ""
NSQ_SOURCE_LINE 00001306 ""
NSQ_SOURCE_LINE 00001307 ""
NSQ_SOURCE_LINE 00001308 "=item *"
NSQ_SOURCE_LINE 00001309 ""
NSQ_SOURCE_LINE 00001310 "C<cache_dir()> - storie's cache directory ( containing story's compiled files )"
NSQ_SOURCE_LINE 00001311 ""
NSQ_SOURCE_LINE 00001312 ""
NSQ_SOURCE_LINE 00001313 ""
NSQ_SOURCE_LINE 00001314 "=item *"
NSQ_SOURCE_LINE 00001315 ""
NSQ_SOURCE_LINE 00001316 "C<story_dir()> - relate path to the directory containing story data, so the full path to the story is C<project_root_dir()/story_dir()>"
NSQ_SOURCE_LINE 00001317 ""
NSQ_SOURCE_LINE 00001318 ""
NSQ_SOURCE_LINE 00001319 ""
NSQ_SOURCE_LINE 00001320 "=item *"
NSQ_SOURCE_LINE 00001321 ""
NSQ_SOURCE_LINE 00001322 "C<config()> - returns suite configuration hash object. See also L<suite configuration|#suite-configuration>."
NSQ_SOURCE_LINE 00001323 ""
NSQ_SOURCE_LINE 00001324 ""
NSQ_SOURCE_LINE 00001325 ""
NSQ_SOURCE_LINE 00001326 "=item *"
NSQ_SOURCE_LINE 00001327 ""
NSQ_SOURCE_LINE 00001328 "C<os()> - return a mnemonic ID of operation system where story is executed."
NSQ_SOURCE_LINE 00001329 ""
NSQ_SOURCE_LINE 00001330 ""
NSQ_SOURCE_LINE 00001331 ""
NSQ_SOURCE_LINE 00001332 "=item -"
NSQ_SOURCE_LINE 00001333 ""
NSQ_SOURCE_LINE 00001334 "You need to C<from outthentic import *> in Python to import os() function."
NSQ_SOURCE_LINE 00001335 ""
NSQ_SOURCE_LINE 00001336 ""
NSQ_SOURCE_LINE 00001337 ""
NSQ_SOURCE_LINE 00001338 "=item -"
NSQ_SOURCE_LINE 00001339 ""
NSQ_SOURCE_LINE 00001340 "in Bash these functions are represented by variables, e.g. $projectI<root>dir, $os, so on."
NSQ_SOURCE_LINE 00001341 ""
NSQ_SOURCE_LINE 00001342 ""
NSQ_SOURCE_LINE 00001343 ""
NSQ_SOURCE_LINE 00001344 "=back"
NSQ_SOURCE_LINE 00001345 ""
NSQ_SOURCE_LINE 00001346 ""
NSQ_SOURCE_LINE 00001347 "=head1 Recognizable OS list"
NSQ_SOURCE_LINE 00001348 ""
NSQ_SOURCE_LINE 00001349 "=over"
NSQ_SOURCE_LINE 00001350 ""
NSQ_SOURCE_LINE 00001351 "=item *"
NSQ_SOURCE_LINE 00001352 ""
NSQ_SOURCE_LINE 00001353 "alpine"
NSQ_SOURCE_LINE 00001354 ""
NSQ_SOURCE_LINE 00001355 ""
NSQ_SOURCE_LINE 00001356 "=item *"
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 "amazon"
NSQ_SOURCE_LINE 00001359 ""
NSQ_SOURCE_LINE 00001360 ""
NSQ_SOURCE_LINE 00001361 "=item *"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "archlinux"
NSQ_SOURCE_LINE 00001364 ""
NSQ_SOURCE_LINE 00001365 ""
NSQ_SOURCE_LINE 00001366 "=item *"
NSQ_SOURCE_LINE 00001367 ""
NSQ_SOURCE_LINE 00001368 "centos5"
NSQ_SOURCE_LINE 00001369 ""
NSQ_SOURCE_LINE 00001370 ""
NSQ_SOURCE_LINE 00001371 "=item *"
NSQ_SOURCE_LINE 00001372 ""
NSQ_SOURCE_LINE 00001373 "centos6"
NSQ_SOURCE_LINE 00001374 ""
NSQ_SOURCE_LINE 00001375 ""
NSQ_SOURCE_LINE 00001376 "=item *"
NSQ_SOURCE_LINE 00001377 ""
NSQ_SOURCE_LINE 00001378 "centos7"
NSQ_SOURCE_LINE 00001379 ""
NSQ_SOURCE_LINE 00001380 ""
NSQ_SOURCE_LINE 00001381 "=item *"
NSQ_SOURCE_LINE 00001382 ""
NSQ_SOURCE_LINE 00001383 "debian"
NSQ_SOURCE_LINE 00001384 ""
NSQ_SOURCE_LINE 00001385 ""
NSQ_SOURCE_LINE 00001386 "=item *"
NSQ_SOURCE_LINE 00001387 ""
NSQ_SOURCE_LINE 00001388 "fedora"
NSQ_SOURCE_LINE 00001389 ""
NSQ_SOURCE_LINE 00001390 ""
NSQ_SOURCE_LINE 00001391 "=item *"
NSQ_SOURCE_LINE 00001392 ""
NSQ_SOURCE_LINE 00001393 "minoca"
NSQ_SOURCE_LINE 00001394 ""
NSQ_SOURCE_LINE 00001395 ""
NSQ_SOURCE_LINE 00001396 "=item *"
NSQ_SOURCE_LINE 00001397 ""
NSQ_SOURCE_LINE 00001398 "ubuntu"
NSQ_SOURCE_LINE 00001399 ""
NSQ_SOURCE_LINE 00001400 ""
NSQ_SOURCE_LINE 00001401 "=item *"
NSQ_SOURCE_LINE 00001402 ""
NSQ_SOURCE_LINE 00001403 "funtoo"
NSQ_SOURCE_LINE 00001404 ""
NSQ_SOURCE_LINE 00001405 ""
NSQ_SOURCE_LINE 00001406 "=item *"
NSQ_SOURCE_LINE 00001407 ""
NSQ_SOURCE_LINE 00001408 "darwin"
NSQ_SOURCE_LINE 00001409 ""
NSQ_SOURCE_LINE 00001410 ""
NSQ_SOURCE_LINE 00001411 "=item *"
NSQ_SOURCE_LINE 00001412 ""
NSQ_SOURCE_LINE 00001413 "windows"
NSQ_SOURCE_LINE 00001414 ""
NSQ_SOURCE_LINE 00001415 ""
NSQ_SOURCE_LINE 00001416 "=back"
NSQ_SOURCE_LINE 00001417 ""
NSQ_SOURCE_LINE 00001418 ""
NSQ_SOURCE_LINE 00001419 "=head1 Story meta headers"
NSQ_SOURCE_LINE 00001420 ""
NSQ_SOURCE_LINE 00001421 "Story meta headers are just plain text files with some useful description."
NSQ_SOURCE_LINE 00001422 ""
NSQ_SOURCE_LINE 00001423 "The content of the meta headers will be shown when story is executed."
NSQ_SOURCE_LINE 00001424 ""
NSQ_SOURCE_LINE 00001425 "Example:"
NSQ_SOURCE_LINE 00001426 ""
NSQ_SOURCE_LINE 00001427 "    $ nano meta.txt"
NSQ_SOURCE_LINE 00001428 "    "
NSQ_SOURCE_LINE 00001429 "      The beginning of the story ..."
NSQ_SOURCE_LINE 00001430 ""
NSQ_SOURCE_LINE 00001431 ""
NSQ_SOURCE_LINE 00001432 "=head1 Ignore scenario failures"
NSQ_SOURCE_LINE 00001433 ""
NSQ_SOURCE_LINE 00001434 "If scenario fails ( the exit code is not equal to zero ), the story executor marks such a story as unsuccessful and this"
NSQ_SOURCE_LINE 00001435 "results in overall failure. To suppress any story errors use C<ignore_story_err()> function."
NSQ_SOURCE_LINE 00001436 ""
NSQ_SOURCE_LINE 00001437 "Examples:"
NSQ_SOURCE_LINE 00001438 ""
NSQ_SOURCE_LINE 00001439 "    # Python"
NSQ_SOURCE_LINE 00001440 "    "
NSQ_SOURCE_LINE 00001441 "    $ nano hook.py"
NSQ_SOURCE_LINE 00001442 "    "
NSQ_SOURCE_LINE 00001443 "      from outthentic import *"
NSQ_SOURCE_LINE 00001444 "    "
NSQ_SOURCE_LINE 00001445 "      ignore_story_err(1)"
NSQ_SOURCE_LINE 00001446 "    "
NSQ_SOURCE_LINE 00001447 "    "
NSQ_SOURCE_LINE 00001448 "    # Ruby"
NSQ_SOURCE_LINE 00001449 "    "
NSQ_SOURCE_LINE 00001450 "    $ nano hook.rb"
NSQ_SOURCE_LINE 00001451 "    "
NSQ_SOURCE_LINE 00001452 "      ignore_story_err 1"
NSQ_SOURCE_LINE 00001453 "    "
NSQ_SOURCE_LINE 00001454 "    # Perl"
NSQ_SOURCE_LINE 00001455 "    "
NSQ_SOURCE_LINE 00001456 "    $ nano hook.pl"
NSQ_SOURCE_LINE 00001457 "    "
NSQ_SOURCE_LINE 00001458 "      ignore_story_err(1)"
NSQ_SOURCE_LINE 00001459 "    "
NSQ_SOURCE_LINE 00001460 "    # Bash"
NSQ_SOURCE_LINE 00001461 "    "
NSQ_SOURCE_LINE 00001462 "    $ nano hook.bash"
NSQ_SOURCE_LINE 00001463 "    "
NSQ_SOURCE_LINE 00001464 "      ignore_story_err 1"
NSQ_SOURCE_LINE 00001465 "    "
NSQ_SOURCE_LINE 00001466 "    # Powershell"
NSQ_SOURCE_LINE 00001467 "    "
NSQ_SOURCE_LINE 00001468 "    $ nano hook.ps1"
NSQ_SOURCE_LINE 00001469 "    "
NSQ_SOURCE_LINE 00001470 "      ignore_story_err(1)"
NSQ_SOURCE_LINE 00001471 ""
NSQ_SOURCE_LINE 00001472 ""
NSQ_SOURCE_LINE 00001473 "=head1 Immediate exit/die"
NSQ_SOURCE_LINE 00001474 ""
NSQ_SOURCE_LINE 00001475 "You can cause strun exits immediate with code 0, using C<quit()> function."
NSQ_SOURCE_LINE 00001476 ""
NSQ_SOURCE_LINE 00001477 "Examples:"
NSQ_SOURCE_LINE 00001478 ""
NSQ_SOURCE_LINE 00001479 "Python:"
NSQ_SOURCE_LINE 00001480 ""
NSQ_SOURCE_LINE 00001481 "    $ nano hook.py"
NSQ_SOURCE_LINE 00001482 "    "
NSQ_SOURCE_LINE 00001483 "      from outthentic import *"
NSQ_SOURCE_LINE 00001484 "    "
NSQ_SOURCE_LINE 00001485 "      quit(\"this script is temporarily disabled\")"
NSQ_SOURCE_LINE 00001486 ""
NSQ_SOURCE_LINE 00001487 "Ruby:"
NSQ_SOURCE_LINE 00001488 ""
NSQ_SOURCE_LINE 00001489 "    $ nano hook.rb"
NSQ_SOURCE_LINE 00001490 "    "
NSQ_SOURCE_LINE 00001491 "      if os != \"windows\""
NSQ_SOURCE_LINE 00001492 "        quit(\"windows system is not supported\")"
NSQ_SOURCE_LINE 00001493 "      end"
NSQ_SOURCE_LINE 00001494 ""
NSQ_SOURCE_LINE 00001495 "Perl:"
NSQ_SOURCE_LINE 00001496 ""
NSQ_SOURCE_LINE 00001497 "    $ nano hook.pl"
NSQ_SOURCE_LINE 00001498 "    "
NSQ_SOURCE_LINE 00001499 "      unless (os() eq \"ubuntu\"){"
NSQ_SOURCE_LINE 00001500 "        quit(\"runs on ubuntu system only\")"
NSQ_SOURCE_LINE 00001501 "      }"
NSQ_SOURCE_LINE 00001502 ""
NSQ_SOURCE_LINE 00001503 "Bash:"
NSQ_SOURCE_LINE 00001504 ""
NSQ_SOURCE_LINE 00001505 "    $ nano hook.bash"
NSQ_SOURCE_LINE 00001506 "    "
NSQ_SOURCE_LINE 00001507 "      which /bin/curl || quit \"curl not found, skip\""
NSQ_SOURCE_LINE 00001508 ""
NSQ_SOURCE_LINE 00001509 "Powershell:"
NSQ_SOURCE_LINE 00001510 ""
NSQ_SOURCE_LINE 00001511 "    $ nano hook.ps1"
NSQ_SOURCE_LINE 00001512 "    "
NSQ_SOURCE_LINE 00001513 "      if ( -NOT  (os() -eq 'windows') ) {"
NSQ_SOURCE_LINE 00001514 "        quit(\"only windows system is supported\")"
NSQ_SOURCE_LINE 00001515 "      }"
NSQ_SOURCE_LINE 00001516 ""
NSQ_SOURCE_LINE 00001517 "Alternately you can ask strun to abort straight away ( with none zero exit code ), using C<outthentic_die()> function."
NSQ_SOURCE_LINE 00001518 ""
NSQ_SOURCE_LINE 00001519 "Examples:"
NSQ_SOURCE_LINE 00001520 ""
NSQ_SOURCE_LINE 00001521 "    $ nano hook.bash"
NSQ_SOURCE_LINE 00001522 "    "
NSQ_SOURCE_LINE 00001523 "    if [ \"$EUID\" -ne 0 ]"
NSQ_SOURCE_LINE 00001524 "        then outthentic_die \"Please run as root\""
NSQ_SOURCE_LINE 00001525 "    fi"
NSQ_SOURCE_LINE 00001526 ""
NSQ_SOURCE_LINE 00001527 ""
NSQ_SOURCE_LINE 00001528 "=head1 Story libraries"
NSQ_SOURCE_LINE 00001529 ""
NSQ_SOURCE_LINE 00001530 "Story libraries are files to make your libraries' code I<automatically required> into the story scenarios, hooks and check files context:"
NSQ_SOURCE_LINE 00001531 ""
NSQ_SOURCE_LINE 00001532 "Here are some examples:"
NSQ_SOURCE_LINE 00001533 ""
NSQ_SOURCE_LINE 00001534 "Bash:"
NSQ_SOURCE_LINE 00001535 ""
NSQ_SOURCE_LINE 00001536 "    $ nano my-story/common.bash"
NSQ_SOURCE_LINE 00001537 "    "
NSQ_SOURCE_LINE 00001538 "      function hello_bash {"
NSQ_SOURCE_LINE 00001539 "        echo 'hello bash'"
NSQ_SOURCE_LINE 00001540 "      } "
NSQ_SOURCE_LINE 00001541 "    "
NSQ_SOURCE_LINE 00001542 "    $ nano my-story/story.bash"
NSQ_SOURCE_LINE 00001543 "    "
NSQ_SOURCE_LINE 00001544 "        echo hello_bash"
NSQ_SOURCE_LINE 00001545 "    "
NSQ_SOURCE_LINE 00001546 "    $ nano my-story/story.check"
NSQ_SOURCE_LINE 00001547 "    "
NSQ_SOURCE_LINE 00001548 "      generator: <<CODE;"
NSQ_SOURCE_LINE 00001549 "      !bash"
NSQ_SOURCE_LINE 00001550 "        echo hello_bash"
NSQ_SOURCE_LINE 00001551 "      CODE"
NSQ_SOURCE_LINE 00001552 ""
NSQ_SOURCE_LINE 00001553 "Ruby:"
NSQ_SOURCE_LINE 00001554 ""
NSQ_SOURCE_LINE 00001555 "    $ nano modules/my-story/common.rb"
NSQ_SOURCE_LINE 00001556 "    "
NSQ_SOURCE_LINE 00001557 "      def hello_ruby"
NSQ_SOURCE_LINE 00001558 "        'hello ruby'"
NSQ_SOURCE_LINE 00001559 "      end"
NSQ_SOURCE_LINE 00001560 "    "
NSQ_SOURCE_LINE 00001561 "    $ nano modules/my-story/hook.rb"
NSQ_SOURCE_LINE 00001562 "    "
NSQ_SOURCE_LINE 00001563 "      set_stdout(hello_ruby())"
NSQ_SOURCE_LINE 00001564 "    "
NSQ_SOURCE_LINE 00001565 "    $ nano modules/my-story/story.check"
NSQ_SOURCE_LINE 00001566 "    "
NSQ_SOURCE_LINE 00001567 "      generator: <<CODE;"
NSQ_SOURCE_LINE 00001568 "      !ruby"
NSQ_SOURCE_LINE 00001569 "        pust hello_ruby()"
NSQ_SOURCE_LINE 00001570 "      CODE"
NSQ_SOURCE_LINE 00001571 ""
NSQ_SOURCE_LINE 00001572 "This table describes C<<< file name -> language >>> mapping for story libraries:"
NSQ_SOURCE_LINE 00001573 ""
NSQ_SOURCE_LINE 00001574 "    +-----------+-----------------+--------------------------------+"
NSQ_SOURCE_LINE 00001575 "    | Language  | file            | locations                      |"
NSQ_SOURCE_LINE 00001576 "    +-----------+-----------------+--------------------------------+"
NSQ_SOURCE_LINE 00001577 "    | Bash      | common.bash     | $project_root_dir/common.bash  |"
NSQ_SOURCE_LINE 00001578 "    |           |                 | $story_dir/common.bash         |"
NSQ_SOURCE_LINE 00001579 "    +-----------+-----------------+--------------------------------+"
NSQ_SOURCE_LINE 00001580 "    | Ruby      | common.rb       | $project_root_dir/common.rb    |"
NSQ_SOURCE_LINE 00001581 "    |           |                 | $story_dir/common.bash         |"
NSQ_SOURCE_LINE 00001582 "    +-----------+-----------------+--------------------------------+"
NSQ_SOURCE_LINE 00001583 ""
NSQ_SOURCE_LINE 00001584 "If you put story library file into project root directory it will be required by I<any> story:"
NSQ_SOURCE_LINE 00001585 ""
NSQ_SOURCE_LINE 00001586 "    $ nano common.bash"
NSQ_SOURCE_LINE 00001587 "    "
NSQ_SOURCE_LINE 00001588 "      function hello_bash {"
NSQ_SOURCE_LINE 00001589 "        echo 'hello bash'"
NSQ_SOURCE_LINE 00001590 "      }"
NSQ_SOURCE_LINE 00001591 ""
NSQ_SOURCE_LINE 00001592 "B<I<NOTE!>>  Story libraries are not supported for Python and Perl"
NSQ_SOURCE_LINE 00001593 ""
NSQ_SOURCE_LINE 00001594 ""
NSQ_SOURCE_LINE 00001595 "=head1 PERL5LIB"
NSQ_SOURCE_LINE 00001596 ""
NSQ_SOURCE_LINE 00001597 "$project_root_directory/lib path is added to $PERL5LIB variable. "
NSQ_SOURCE_LINE 00001598 ""
NSQ_SOURCE_LINE 00001599 "This make it easy to place custom Perl modules under project root directory:"
NSQ_SOURCE_LINE 00001600 ""
NSQ_SOURCE_LINE 00001601 "    $ nano my-app/lib/Foo/Bar/Baz.pm"
NSQ_SOURCE_LINE 00001602 "    "
NSQ_SOURCE_LINE 00001603 "      package Foo::Bar::Baz;"
NSQ_SOURCE_LINE 00001604 "    "
NSQ_SOURCE_LINE 00001605 "      1;"
NSQ_SOURCE_LINE 00001606 "    "
NSQ_SOURCE_LINE 00001607 "    $ nano common.pm"
NSQ_SOURCE_LINE 00001608 "    "
NSQ_SOURCE_LINE 00001609 "      use Foo::Bar::Baz;"
NSQ_SOURCE_LINE 00001610 ""
NSQ_SOURCE_LINE 00001611 ""
NSQ_SOURCE_LINE 00001612 "=head1 Story runner console tool"
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "    $ strun <options>"
NSQ_SOURCE_LINE 00001615 ""
NSQ_SOURCE_LINE 00001616 ""
NSQ_SOURCE_LINE 00001617 "=head1 Options"
NSQ_SOURCE_LINE 00001618 ""
NSQ_SOURCE_LINE 00001619 "=over"
NSQ_SOURCE_LINE 00001620 ""
NSQ_SOURCE_LINE 00001621 "=item *"
NSQ_SOURCE_LINE 00001622 ""
NSQ_SOURCE_LINE 00001623 "C<--root>"
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 ""
NSQ_SOURCE_LINE 00001626 ""
NSQ_SOURCE_LINE 00001627 "=back"
NSQ_SOURCE_LINE 00001628 ""
NSQ_SOURCE_LINE 00001629 "The project root directory. Default value is the current working directory."
NSQ_SOURCE_LINE 00001630 ""
NSQ_SOURCE_LINE 00001631 "=over"
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "=item *"
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "C<--cwd>"
NSQ_SOURCE_LINE 00001636 ""
NSQ_SOURCE_LINE 00001637 ""
NSQ_SOURCE_LINE 00001638 ""
NSQ_SOURCE_LINE 00001639 "=back"
NSQ_SOURCE_LINE 00001640 ""
NSQ_SOURCE_LINE 00001641 "Sets working directory when strun executes stories."
NSQ_SOURCE_LINE 00001642 ""
NSQ_SOURCE_LINE 00001643 "=over"
NSQ_SOURCE_LINE 00001644 ""
NSQ_SOURCE_LINE 00001645 "=item *"
NSQ_SOURCE_LINE 00001646 ""
NSQ_SOURCE_LINE 00001647 "C<--debug> "
NSQ_SOURCE_LINE 00001648 ""
NSQ_SOURCE_LINE 00001649 ""
NSQ_SOURCE_LINE 00001650 "=back"
NSQ_SOURCE_LINE 00001651 ""
NSQ_SOURCE_LINE 00001652 "Enable/disable debug mode:"
NSQ_SOURCE_LINE 00001653 ""
NSQ_SOURCE_LINE 00001654 "    * Increasing debug value results in more low level information appeared at output."
NSQ_SOURCE_LINE 00001655 "    "
NSQ_SOURCE_LINE 00001656 "    * Default value is 0, which means no debugging. "
NSQ_SOURCE_LINE 00001657 "    "
NSQ_SOURCE_LINE 00001658 "    * Possible values: 0,1,2,3."
NSQ_SOURCE_LINE 00001659 ""
NSQ_SOURCE_LINE 00001660 "=over"
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "=item *"
NSQ_SOURCE_LINE 00001663 ""
NSQ_SOURCE_LINE 00001664 "C<--format> "
NSQ_SOURCE_LINE 00001665 ""
NSQ_SOURCE_LINE 00001666 ""
NSQ_SOURCE_LINE 00001667 "=back"
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 "Sets reports format. Available formats are: C<concise|production|default>. Default value is C<default>."
NSQ_SOURCE_LINE 00001670 ""
NSQ_SOURCE_LINE 00001671 "In concise format strun shrinks output to only STDOUT/STDERR comes from scenarios. It's useful when you want to parse stories output by external commands."
NSQ_SOURCE_LINE 00001672 ""
NSQ_SOURCE_LINE 00001673 "Production format omits debug information."
NSQ_SOURCE_LINE 00001674 ""
NSQ_SOURCE_LINE 00001675 "=over"
NSQ_SOURCE_LINE 00001676 ""
NSQ_SOURCE_LINE 00001677 "=item *"
NSQ_SOURCE_LINE 00001678 ""
NSQ_SOURCE_LINE 00001679 "C<--purge-cache>"
NSQ_SOURCE_LINE 00001680 ""
NSQ_SOURCE_LINE 00001681 ""
NSQ_SOURCE_LINE 00001682 "=back"
NSQ_SOURCE_LINE 00001683 ""
NSQ_SOURCE_LINE 00001684 "Purge strun cache directory upon exit. By default C<--purge-cache> is disabled."
NSQ_SOURCE_LINE 00001685 ""
NSQ_SOURCE_LINE 00001686 "=over"
NSQ_SOURCE_LINE 00001687 ""
NSQ_SOURCE_LINE 00001688 "=item *"
NSQ_SOURCE_LINE 00001689 ""
NSQ_SOURCE_LINE 00001690 "C<--match_l> "
NSQ_SOURCE_LINE 00001691 ""
NSQ_SOURCE_LINE 00001692 ""
NSQ_SOURCE_LINE 00001693 "=back"
NSQ_SOURCE_LINE 00001694 ""
NSQ_SOURCE_LINE 00001695 "Truncate matching strings. When matching lines are appeared in a report they are truncated to $match_l bytes. Default value is 200."
NSQ_SOURCE_LINE 00001696 ""
NSQ_SOURCE_LINE 00001697 "=over"
NSQ_SOURCE_LINE 00001698 ""
NSQ_SOURCE_LINE 00001699 "=item *"
NSQ_SOURCE_LINE 00001700 ""
NSQ_SOURCE_LINE 00001701 "C<--story> "
NSQ_SOURCE_LINE 00001702 ""
NSQ_SOURCE_LINE 00001703 ""
NSQ_SOURCE_LINE 00001704 "=back"
NSQ_SOURCE_LINE 00001705 ""
NSQ_SOURCE_LINE 00001706 "Run only a single story. This should be path I<relative> to the project root directory. "
NSQ_SOURCE_LINE 00001707 ""
NSQ_SOURCE_LINE 00001708 "Examples:"
NSQ_SOURCE_LINE 00001709 ""
NSQ_SOURCE_LINE 00001710 "    # Project with 3 stories"
NSQ_SOURCE_LINE 00001711 "    "
NSQ_SOURCE_LINE 00001712 "    foo/story.pl"
NSQ_SOURCE_LINE 00001713 "    foo/bar/story.rb"
NSQ_SOURCE_LINE 00001714 "    bar/story.pl"
NSQ_SOURCE_LINE 00001715 "    "
NSQ_SOURCE_LINE 00001716 "    # Run various stories"
NSQ_SOURCE_LINE 00001717 "    "
NSQ_SOURCE_LINE 00001718 "    --story foo # runs foo/ stories"
NSQ_SOURCE_LINE 00001719 "    --story foo/story # runs foo/story.pl"
NSQ_SOURCE_LINE 00001720 "    --story foo/bar/ # runs foo/bar/ stories"
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "=over"
NSQ_SOURCE_LINE 00001723 ""
NSQ_SOURCE_LINE 00001724 "=item *"
NSQ_SOURCE_LINE 00001725 ""
NSQ_SOURCE_LINE 00001726 "C<--recurse> "
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 ""
NSQ_SOURCE_LINE 00001729 "=back"
NSQ_SOURCE_LINE 00001730 ""
NSQ_SOURCE_LINE 00001731 "Runs all the stories recursively."
NSQ_SOURCE_LINE 00001732 ""
NSQ_SOURCE_LINE 00001733 "=over"
NSQ_SOURCE_LINE 00001734 ""
NSQ_SOURCE_LINE 00001735 "=item *"
NSQ_SOURCE_LINE 00001736 ""
NSQ_SOURCE_LINE 00001737 "C<--ini>"
NSQ_SOURCE_LINE 00001738 ""
NSQ_SOURCE_LINE 00001739 ""
NSQ_SOURCE_LINE 00001740 ""
NSQ_SOURCE_LINE 00001741 "=back"
NSQ_SOURCE_LINE 00001742 ""
NSQ_SOURCE_LINE 00001743 "Configuration file path."
NSQ_SOURCE_LINE 00001744 ""
NSQ_SOURCE_LINE 00001745 "See L<suite configuration|#suite-configuration> section for details."
NSQ_SOURCE_LINE 00001746 ""
NSQ_SOURCE_LINE 00001747 "=over"
NSQ_SOURCE_LINE 00001748 ""
NSQ_SOURCE_LINE 00001749 "=item *"
NSQ_SOURCE_LINE 00001750 ""
NSQ_SOURCE_LINE 00001751 "C<--yaml> "
NSQ_SOURCE_LINE 00001752 ""
NSQ_SOURCE_LINE 00001753 ""
NSQ_SOURCE_LINE 00001754 "=back"
NSQ_SOURCE_LINE 00001755 ""
NSQ_SOURCE_LINE 00001756 "YAML configuration file path. "
NSQ_SOURCE_LINE 00001757 ""
NSQ_SOURCE_LINE 00001758 "See L<suite configuration|#suite-configuration> section for details."
NSQ_SOURCE_LINE 00001759 ""
NSQ_SOURCE_LINE 00001760 "=over"
NSQ_SOURCE_LINE 00001761 ""
NSQ_SOURCE_LINE 00001762 "=item *"
NSQ_SOURCE_LINE 00001763 ""
NSQ_SOURCE_LINE 00001764 "C<--json> "
NSQ_SOURCE_LINE 00001765 ""
NSQ_SOURCE_LINE 00001766 ""
NSQ_SOURCE_LINE 00001767 "=back"
NSQ_SOURCE_LINE 00001768 ""
NSQ_SOURCE_LINE 00001769 "JSON configuration file path. "
NSQ_SOURCE_LINE 00001770 ""
NSQ_SOURCE_LINE 00001771 "See L<suite configuration|#suite-configuration> section for details."
NSQ_SOURCE_LINE 00001772 ""
NSQ_SOURCE_LINE 00001773 "=over"
NSQ_SOURCE_LINE 00001774 ""
NSQ_SOURCE_LINE 00001775 "=item *"
NSQ_SOURCE_LINE 00001776 ""
NSQ_SOURCE_LINE 00001777 "C<--nocolor>"
NSQ_SOURCE_LINE 00001778 ""
NSQ_SOURCE_LINE 00001779 ""
NSQ_SOURCE_LINE 00001780 "=back"
NSQ_SOURCE_LINE 00001781 ""
NSQ_SOURCE_LINE 00001782 "Disable colors in reports. By default reports are color."
NSQ_SOURCE_LINE 00001783 ""
NSQ_SOURCE_LINE 00001784 "=over"
NSQ_SOURCE_LINE 00001785 ""
NSQ_SOURCE_LINE 00001786 "=item *"
NSQ_SOURCE_LINE 00001787 ""
NSQ_SOURCE_LINE 00001788 "C<--dump-config>"
NSQ_SOURCE_LINE 00001789 ""
NSQ_SOURCE_LINE 00001790 ""
NSQ_SOURCE_LINE 00001791 "=back"
NSQ_SOURCE_LINE 00001792 ""
NSQ_SOURCE_LINE 00001793 "Dumps suite configuration and exit. See also suite configuration section."
NSQ_SOURCE_LINE 00001794 ""
NSQ_SOURCE_LINE 00001795 ""
NSQ_SOURCE_LINE 00001796 "=head1 Suite configuration"
NSQ_SOURCE_LINE 00001797 ""
NSQ_SOURCE_LINE 00001798 "Outthentic projects are configurable. Configuration data is passed via configuration files."
NSQ_SOURCE_LINE 00001799 ""
NSQ_SOURCE_LINE 00001800 "There are three type of configuration files are supported:"
NSQ_SOURCE_LINE 00001801 ""
NSQ_SOURCE_LINE 00001802 "=over"
NSQ_SOURCE_LINE 00001803 ""
NSQ_SOURCE_LINE 00001804 "=item *"
NSQ_SOURCE_LINE 00001805 ""
NSQ_SOURCE_LINE 00001806 "Config::General format (aka ini files)"
NSQ_SOURCE_LINE 00001807 ""
NSQ_SOURCE_LINE 00001808 ""
NSQ_SOURCE_LINE 00001809 "=item *"
NSQ_SOURCE_LINE 00001810 ""
NSQ_SOURCE_LINE 00001811 "YAML format"
NSQ_SOURCE_LINE 00001812 ""
NSQ_SOURCE_LINE 00001813 ""
NSQ_SOURCE_LINE 00001814 "=item *"
NSQ_SOURCE_LINE 00001815 ""
NSQ_SOURCE_LINE 00001816 "JSON format"
NSQ_SOURCE_LINE 00001817 ""
NSQ_SOURCE_LINE 00001818 ""
NSQ_SOURCE_LINE 00001819 "=back"
NSQ_SOURCE_LINE 00001820 ""
NSQ_SOURCE_LINE 00001821 "Config::General style configuration files are passed by C<--ini> parameter:"
NSQ_SOURCE_LINE 00001822 ""
NSQ_SOURCE_LINE 00001823 "    $ strun --ini /etc/suites/foo.ini"
NSQ_SOURCE_LINE 00001824 "    "
NSQ_SOURCE_LINE 00001825 "    $ nano /etc/suites/foo.ini"
NSQ_SOURCE_LINE 00001826 "    "
NSQ_SOURCE_LINE 00001827 "    <main>"
NSQ_SOURCE_LINE 00001828 "    "
NSQ_SOURCE_LINE 00001829 "      foo 1"
NSQ_SOURCE_LINE 00001830 "      bar 2"
NSQ_SOURCE_LINE 00001831 "    "
NSQ_SOURCE_LINE 00001832 "    </main>"
NSQ_SOURCE_LINE 00001833 ""
NSQ_SOURCE_LINE 00001834 "There is no special magic behind ini files, except this should be L<Config::General|https://metacpan.org/pod/Config::General> compliant configuration file."
NSQ_SOURCE_LINE 00001835 ""
NSQ_SOURCE_LINE 00001836 "Or you can choose YAML format for suite configuration by using C<--yaml> parameter:"
NSQ_SOURCE_LINE 00001837 ""
NSQ_SOURCE_LINE 00001838 "    $ strun --yaml /etc/suites/foo.yaml"
NSQ_SOURCE_LINE 00001839 "    "
NSQ_SOURCE_LINE 00001840 "    $ nano /etc/suites/foo.yaml"
NSQ_SOURCE_LINE 00001841 "    "
NSQ_SOURCE_LINE 00001842 "    main :"
NSQ_SOURCE_LINE 00001843 "      foo : 1"
NSQ_SOURCE_LINE 00001844 "      bar : 2"
NSQ_SOURCE_LINE 00001845 ""
NSQ_SOURCE_LINE 00001846 "Unless user sets path to the configuration file explicitly either by C<--ini> or C<--yaml> or C<--json>  story runner looks for the "
NSQ_SOURCE_LINE 00001847 "files named suite.ini and I<then> ( if suite.ini is not found ) for suite.yaml, suite.json at the current working directory."
NSQ_SOURCE_LINE 00001848 ""
NSQ_SOURCE_LINE 00001849 "If configuration file is passed and read, the configuration data is accessible in a story hook file via config() function:"
NSQ_SOURCE_LINE 00001850 ""
NSQ_SOURCE_LINE 00001851 "    $ nano hook.pl"
NSQ_SOURCE_LINE 00001852 "    "
NSQ_SOURCE_LINE 00001853 "      my $foo = config()->{main}->{foo};"
NSQ_SOURCE_LINE 00001854 "      my $bar = config()->{main}->{bar};"
NSQ_SOURCE_LINE 00001855 ""
NSQ_SOURCE_LINE 00001856 "Examples for other languages:"
NSQ_SOURCE_LINE 00001857 ""
NSQ_SOURCE_LINE 00001858 "Bash:"
NSQ_SOURCE_LINE 00001859 ""
NSQ_SOURCE_LINE 00001860 "    $ nano hook.bash"
NSQ_SOURCE_LINE 00001861 "    "
NSQ_SOURCE_LINE 00001862 "      foo=$(config main.foo )"
NSQ_SOURCE_LINE 00001863 "      bar=$(config main.bar )"
NSQ_SOURCE_LINE 00001864 ""
NSQ_SOURCE_LINE 00001865 "Python:"
NSQ_SOURCE_LINE 00001866 ""
NSQ_SOURCE_LINE 00001867 "    $ nano hook.py"
NSQ_SOURCE_LINE 00001868 "    "
NSQ_SOURCE_LINE 00001869 "      from outthentic import *"
NSQ_SOURCE_LINE 00001870 "    "
NSQ_SOURCE_LINE 00001871 "      foo = config()['main']['foo']"
NSQ_SOURCE_LINE 00001872 "      bar = config()['main']['bar']"
NSQ_SOURCE_LINE 00001873 ""
NSQ_SOURCE_LINE 00001874 "Ruby:"
NSQ_SOURCE_LINE 00001875 ""
NSQ_SOURCE_LINE 00001876 "    $ nano hook.rb"
NSQ_SOURCE_LINE 00001877 "    "
NSQ_SOURCE_LINE 00001878 "      foo = config['main']['foo']"
NSQ_SOURCE_LINE 00001879 "      bar = config['main']['bar']"
NSQ_SOURCE_LINE 00001880 ""
NSQ_SOURCE_LINE 00001881 "Powershell:"
NSQ_SOURCE_LINE 00001882 ""
NSQ_SOURCE_LINE 00001883 "    $ nano hook.ps1"
NSQ_SOURCE_LINE 00001884 "    "
NSQ_SOURCE_LINE 00001885 "      $config = config 'main'"
NSQ_SOURCE_LINE 00001886 "      $foo = $config.foo"
NSQ_SOURCE_LINE 00001887 "      $bar = $config.bar"
NSQ_SOURCE_LINE 00001888 ""
NSQ_SOURCE_LINE 00001889 ""
NSQ_SOURCE_LINE 00001890 "=head1 Runtime configuration"
NSQ_SOURCE_LINE 00001891 ""
NSQ_SOURCE_LINE 00001892 "Runtime configuration parameters override ones in suite configuration. Consider this example:"
NSQ_SOURCE_LINE 00001893 ""
NSQ_SOURCE_LINE 00001894 "    $ nano suite.yaml"
NSQ_SOURCE_LINE 00001895 "    "
NSQ_SOURCE_LINE 00001896 "    foo:"
NSQ_SOURCE_LINE 00001897 "      bar: 10"
NSQ_SOURCE_LINE 00001898 "      "
NSQ_SOURCE_LINE 00001899 "    $ strun --param foo.bar=20 # will override foo.bar parameter to 20"
NSQ_SOURCE_LINE 00001900 ""
NSQ_SOURCE_LINE 00001901 ""
NSQ_SOURCE_LINE 00001902 "=head1 Free style command line parameters"
NSQ_SOURCE_LINE 00001903 ""
NSQ_SOURCE_LINE 00001904 "Alternative way to pass input parameters into outthentic scripts is a I<free style> command line arguments:"
NSQ_SOURCE_LINE 00001905 ""
NSQ_SOURCE_LINE 00001906 "    $ strun -- <arguments>"
NSQ_SOURCE_LINE 00001907 ""
NSQ_SOURCE_LINE 00001908 "Consider a simple example. We want to create a wrapper for some external script which accepts the following "
NSQ_SOURCE_LINE 00001909 "command line arguments:"
NSQ_SOURCE_LINE 00001910 ""
NSQ_SOURCE_LINE 00001911 "    script {flags} {named parameters} {value} "
NSQ_SOURCE_LINE 00001912 ""
NSQ_SOURCE_LINE 00001913 "Where flags are:"
NSQ_SOURCE_LINE 00001914 ""
NSQ_SOURCE_LINE 00001915 "    --verbose"
NSQ_SOURCE_LINE 00001916 "    --debug"
NSQ_SOURCE_LINE 00001917 ""
NSQ_SOURCE_LINE 00001918 "Named parameters are:"
NSQ_SOURCE_LINE 00001919 ""
NSQ_SOURCE_LINE 00001920 "    --foo foo-value"
NSQ_SOURCE_LINE 00001921 "    --var bar-value"
NSQ_SOURCE_LINE 00001922 ""
NSQ_SOURCE_LINE 00001923 "And value is just a string:"
NSQ_SOURCE_LINE 00001924 ""
NSQ_SOURCE_LINE 00001925 "    foo-value"
NSQ_SOURCE_LINE 00001926 ""
NSQ_SOURCE_LINE 00001927 "It's quite demanding to map external script parameters into Outthentic configuration. More over "
NSQ_SOURCE_LINE 00001928 "some parameters of external scripts are optional. "
NSQ_SOURCE_LINE 00001929 ""
NSQ_SOURCE_LINE 00001930 "Here is free style command line arguments to the rescue:"
NSQ_SOURCE_LINE 00001931 ""
NSQ_SOURCE_LINE 00001932 "    $ nano story.bash"
NSQ_SOURCE_LINE 00001933 "    script $(args_cli)        "
NSQ_SOURCE_LINE 00001934 ""
NSQ_SOURCE_LINE 00001935 "That's all. Now we are safe to run our story-wrapper with command line arguments I<in terms of> external script:"
NSQ_SOURCE_LINE 00001936 ""
NSQ_SOURCE_LINE 00001937 "    $ strun -- --foo foo-value --debug the-value"
NSQ_SOURCE_LINE 00001938 ""
NSQ_SOURCE_LINE 00001939 ""
NSQ_SOURCE_LINE 00001940 "=head1 Auto coercion of configuration data into free style command line parameters"
NSQ_SOURCE_LINE 00001941 ""
NSQ_SOURCE_LINE 00001942 "Moreover it's possible declare external script parameters in suite configuration:"
NSQ_SOURCE_LINE 00001943 ""
NSQ_SOURCE_LINE 00001944 "    $ nano suite.yaml"
NSQ_SOURCE_LINE 00001945 "    "
NSQ_SOURCE_LINE 00001946 "      ---"
NSQ_SOURCE_LINE 00001947 "    "
NSQ_SOURCE_LINE 00001948 "      args:"
NSQ_SOURCE_LINE 00001949 "        - foo: foo-value"
NSQ_SOURCE_LINE 00001950 "        -"
NSQ_SOURCE_LINE 00001951 "          - debug "
NSQ_SOURCE_LINE 00001952 "          - verbose "
NSQ_SOURCE_LINE 00001953 "        - the-value"
NSQ_SOURCE_LINE 00001954 "    "
NSQ_SOURCE_LINE 00001955 "    $ strun"
NSQ_SOURCE_LINE 00001956 ""
NSQ_SOURCE_LINE 00001957 "This is end up in running story with following command line arguments for external script:"
NSQ_SOURCE_LINE 00001958 ""
NSQ_SOURCE_LINE 00001959 "    --foo foo-value --debug --verbose the-value"
NSQ_SOURCE_LINE 00001960 ""
NSQ_SOURCE_LINE 00001961 ""
NSQ_SOURCE_LINE 00001962 "=head1 Auto coercion rules"
NSQ_SOURCE_LINE 00001963 ""
NSQ_SOURCE_LINE 00001964 "=over"
NSQ_SOURCE_LINE 00001965 ""
NSQ_SOURCE_LINE 00001966 "=item *"
NSQ_SOURCE_LINE 00001967 ""
NSQ_SOURCE_LINE 00001968 "Args should be array which elements are processed in order, for every elements rules are applied depending on element's type"
NSQ_SOURCE_LINE 00001969 ""
NSQ_SOURCE_LINE 00001970 ""
NSQ_SOURCE_LINE 00001971 "=item *"
NSQ_SOURCE_LINE 00001972 ""
NSQ_SOURCE_LINE 00001973 "Scalars are turned into scalars: C<<< the-value ---> the-value >>>"
NSQ_SOURCE_LINE 00001974 ""
NSQ_SOURCE_LINE 00001975 ""
NSQ_SOURCE_LINE 00001976 "=item *"
NSQ_SOURCE_LINE 00001977 ""
NSQ_SOURCE_LINE 00001978 "Arrays are turned into scalars with double dashes perpended: C<<< (debug, verbose) ---> --debug --verbose >>>. This is useful for declaring"
NSQ_SOURCE_LINE 00001979 "boolean flags "
NSQ_SOURCE_LINE 00001980 ""
NSQ_SOURCE_LINE 00001981 ""
NSQ_SOURCE_LINE 00001982 "=item *"
NSQ_SOURCE_LINE 00001983 ""
NSQ_SOURCE_LINE 00001984 "Hashes are turned into named parameters: C<<< foo: foo-value ---> --foo foo-value >>>"
NSQ_SOURCE_LINE 00001985 ""
NSQ_SOURCE_LINE 00001986 ""
NSQ_SOURCE_LINE 00001987 "=back"
NSQ_SOURCE_LINE 00001988 ""
NSQ_SOURCE_LINE 00001989 ""
NSQ_SOURCE_LINE 00001990 "=head1 Auto coercion, using single dashes instead of double dashes"
NSQ_SOURCE_LINE 00001991 ""
NSQ_SOURCE_LINE 00001992 "Double dashes are default behavior of how named parameters and flags "
NSQ_SOURCE_LINE 00001993 "converted. If you need single dashes, prepend parameters in configuration file with C<~> :"
NSQ_SOURCE_LINE 00001994 ""
NSQ_SOURCE_LINE 00001995 "    $ nano suite.yaml"
NSQ_SOURCE_LINE 00001996 "    "
NSQ_SOURCE_LINE 00001997 "      ---"
NSQ_SOURCE_LINE 00001998 "    "
NSQ_SOURCE_LINE 00001999 "      args:"
NSQ_SOURCE_LINE 00002000 "        - '~foo': foo-value"
NSQ_SOURCE_LINE 00002001 "        -"
NSQ_SOURCE_LINE 00002002 "          - ~debug "
NSQ_SOURCE_LINE 00002003 "          - ~verbose "
NSQ_SOURCE_LINE 00002004 ""
NSQ_SOURCE_LINE 00002005 ""
NSQ_SOURCE_LINE 00002006 "=head1 Environment variables"
NSQ_SOURCE_LINE 00002007 ""
NSQ_SOURCE_LINE 00002008 "=over"
NSQ_SOURCE_LINE 00002009 ""
NSQ_SOURCE_LINE 00002010 "=item *"
NSQ_SOURCE_LINE 00002011 ""
NSQ_SOURCE_LINE 00002012 "C<OUTTHENTIC_MATCH> - overrides default value for C<--match_l> parameter of story runner."
NSQ_SOURCE_LINE 00002013 ""
NSQ_SOURCE_LINE 00002014 ""
NSQ_SOURCE_LINE 00002015 ""
NSQ_SOURCE_LINE 00002016 "=item *"
NSQ_SOURCE_LINE 00002017 ""
NSQ_SOURCE_LINE 00002018 "C<SPARROW_ROOT> - sets the prefix for the path to the cache directory with compiled story files, see also L<story runner|#story-runner>."
NSQ_SOURCE_LINE 00002019 ""
NSQ_SOURCE_LINE 00002020 ""
NSQ_SOURCE_LINE 00002021 ""
NSQ_SOURCE_LINE 00002022 "=item *"
NSQ_SOURCE_LINE 00002023 ""
NSQ_SOURCE_LINE 00002024 "C<SPARROW_NO_COLOR> - disable color output, see C<--nocolor> option of story runner."
NSQ_SOURCE_LINE 00002025 ""
NSQ_SOURCE_LINE 00002026 ""
NSQ_SOURCE_LINE 00002027 ""
NSQ_SOURCE_LINE 00002028 "=item *"
NSQ_SOURCE_LINE 00002029 ""
NSQ_SOURCE_LINE 00002030 "C<OUTTHENTIC_CWD> - sets working directory for strun, see C<--cwd> parameter of story runner"
NSQ_SOURCE_LINE 00002031 ""
NSQ_SOURCE_LINE 00002032 ""
NSQ_SOURCE_LINE 00002033 ""
NSQ_SOURCE_LINE 00002034 "=item *"
NSQ_SOURCE_LINE 00002035 ""
NSQ_SOURCE_LINE 00002036 "C<OUTTHENTIC_FORMAT> - overrides default value for C<--format> parameter of story runner."
NSQ_SOURCE_LINE 00002037 ""
NSQ_SOURCE_LINE 00002038 ""
NSQ_SOURCE_LINE 00002039 ""
NSQ_SOURCE_LINE 00002040 "=back"
NSQ_SOURCE_LINE 00002041 ""
NSQ_SOURCE_LINE 00002042 "Cache directory resolution:"
NSQ_SOURCE_LINE 00002043 ""
NSQ_SOURCE_LINE 00002044 "    +---------------------+----------------------+"
NSQ_SOURCE_LINE 00002045 "    | The Cache Directory | SPARROW_ROOT Is Set? |"
NSQ_SOURCE_LINE 00002046 "    +---------------------+----------------------+"
NSQ_SOURCE_LINE 00002047 "    | ~/.outthentic/tmp/  | No                   |"
NSQ_SOURCE_LINE 00002048 "    | $SPARROW_ROOT/tmp/  | Yes                  |"
NSQ_SOURCE_LINE 00002049 "    +---------------------+----------------------+"
NSQ_SOURCE_LINE 00002050 ""
NSQ_SOURCE_LINE 00002051 ""
NSQ_SOURCE_LINE 00002052 "=head1 Examples"
NSQ_SOURCE_LINE 00002053 ""
NSQ_SOURCE_LINE 00002054 "An example stories can be found in examples/ directory, to run them:"
NSQ_SOURCE_LINE 00002055 ""
NSQ_SOURCE_LINE 00002056 "    $ strun --root examples/ --story $story-name"
NSQ_SOURCE_LINE 00002057 ""
NSQ_SOURCE_LINE 00002058 "Where C<$story-name> is any top level directory inside examples/."
NSQ_SOURCE_LINE 00002059 ""
NSQ_SOURCE_LINE 00002060 ""
NSQ_SOURCE_LINE 00002061 "=head1 Check files syntax"
NSQ_SOURCE_LINE 00002062 ""
NSQ_SOURCE_LINE 00002063 "=over"
NSQ_SOURCE_LINE 00002064 ""
NSQ_SOURCE_LINE 00002065 "=item *"
NSQ_SOURCE_LINE 00002066 ""
NSQ_SOURCE_LINE 00002067 "Brief introduction of check file syntax could be found here - L<https://github.com/melezhik/outthentic/blob/master/check-files-syntax.md|https://github.com/melezhik/outthentic/blob/master/check-files-syntax.md>"
NSQ_SOURCE_LINE 00002068 ""
NSQ_SOURCE_LINE 00002069 ""
NSQ_SOURCE_LINE 00002070 ""
NSQ_SOURCE_LINE 00002071 "=item *"
NSQ_SOURCE_LINE 00002072 ""
NSQ_SOURCE_LINE 00002073 "For the full detailed explanation follow Outthentic::DSL doc pages at L<https://github.com/melezhik/outthentic-dsl|https://github.com/melezhik/outthentic-dsl>"
NSQ_SOURCE_LINE 00002074 ""
NSQ_SOURCE_LINE 00002075 ""
NSQ_SOURCE_LINE 00002076 ""
NSQ_SOURCE_LINE 00002077 "=back"
NSQ_SOURCE_LINE 00002078 ""
NSQ_SOURCE_LINE 00002079 ""
NSQ_SOURCE_LINE 00002080 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00002081 ""
NSQ_SOURCE_LINE 00002082 "L<Aleksei Melezhik|mailto:melezhik@gmail.com>"
NSQ_SOURCE_LINE 00002083 ""
NSQ_SOURCE_LINE 00002084 ""
