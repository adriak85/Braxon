NSQ_SOURCE_LINE 00002088 ""
NSQ_SOURCE_LINE 00002089 ""
NSQ_SOURCE_LINE 00002090 "=head1 See also"
NSQ_SOURCE_LINE 00002091 ""
NSQ_SOURCE_LINE 00002092 "=over"
NSQ_SOURCE_LINE 00002093 ""
NSQ_SOURCE_LINE 00002094 "=item *"
NSQ_SOURCE_LINE 00002095 ""
NSQ_SOURCE_LINE 00002096 "L<Sparrow|https://github.com/melezhik/sparrow> - Multipurposes scenarios manager."
NSQ_SOURCE_LINE 00002097 ""
