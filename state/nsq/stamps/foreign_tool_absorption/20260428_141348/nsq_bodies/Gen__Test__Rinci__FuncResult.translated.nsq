NSQ_SOURCE_LINE 00000001 "package Gen::Test::Rinci::FuncResult;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2017-07-11'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.06'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 "#use experimental 'smartmatch';"
NSQ_SOURCE_LINE 00000010 "#use Log::Any '$log';"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Carp;"
NSQ_SOURCE_LINE 00000013 "use Data::Dump::OneLine qw(dump1);"
NSQ_SOURCE_LINE 00000014 "use Test::More 0.98;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "require Exporter;"
NSQ_SOURCE_LINE 00000017 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000018 "our @EXPORT_OK = qw(gen_test_func);"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "our %SPEC;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "$SPEC{gen_test_func} = {"
NSQ_SOURCE_LINE 00000023 "    v => 1.1,"
NSQ_SOURCE_LINE 00000024 "    summary => 'Generate a test function for a function',"
NSQ_SOURCE_LINE 00000025 "    description => <<'_',"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "This function (A) will generate a function (B)."
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "A accepts, among others, the name or the reference to the function that you want"
NSQ_SOURCE_LINE 00000030 "to test (T) and the name of the generated function, B."
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "B will run T once with some specified arguments, catch exception, and test its"
NSQ_SOURCE_LINE 00000033 "result. The result is expected to be an enveloped result (see the documentation"
NSQ_SOURCE_LINE 00000034 "of `Rinci::function` for more details about enveloped result)."
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "B will accept the following arguments:"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "* name (str)"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "  Name of the test. Will default to \"T (ARGS...)\" to show the name of the target"
NSQ_SOURCE_LINE 00000041 "  function and the arguments that it is called with."
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "* args (hash or array)"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "  Argument to feed to function T."
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "* dies (bool, default => 0)"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "  Whether function T should die when run. If set to 1, further tests will not be"
NSQ_SOURCE_LINE 00000050 "  done except the test that function dies."
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "* status (int, default => 200)"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "  Will test the result's status code."
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "* result (any)"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "  If specified, will test the actual result of the function."
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "* run (code)"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "  Instead of running function T with `args`, will execute this code instead."
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "* posttest (code)"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "  Run this code for additional tests."
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "Todo:"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "* Handle function with `result_naked` => 1."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "_"
NSQ_SOURCE_LINE 00000073 "    args => {"
NSQ_SOURCE_LINE 00000074 "        name => {"
NSQ_SOURCE_LINE 00000075 "            summary => 'Name of the test function to generate (B)',"
NSQ_SOURCE_LINE 00000076 "            schema  => ['str*'],"
NSQ_SOURCE_LINE 00000077 "            description => <<'_',"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "Can be fully qualified, e.g. `Pkg::SubPkg::funcname` or unqualified `funcname`"
NSQ_SOURCE_LINE 00000080 "(where the package will be taken from the `package` argument). Relevant for when"
NSQ_SOURCE_LINE 00000081 "installing the function."
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "_"
NSQ_SOURCE_LINE 00000084 "            pos => 0,"
NSQ_SOURCE_LINE 00000085 "            req => 1,"
NSQ_SOURCE_LINE 00000086 "        },"
NSQ_SOURCE_LINE 00000087 "        package => {"
NSQ_SOURCE_LINE 00000088 "            summary => 'Perl package to put this function in',"
NSQ_SOURCE_LINE 00000089 "            description => <<'_',"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "Relevant only when installing the function."
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "_"
NSQ_SOURCE_LINE 00000094 "        },"
NSQ_SOURCE_LINE 00000095 "        func => {"
NSQ_SOURCE_LINE 00000096 "            summary => 'Target function to test',"
NSQ_SOURCE_LINE 00000097 "            schema  => ['any*' => {of => ['code*']}],"
NSQ_SOURCE_LINE 00000098 "            req => 1,"
NSQ_SOURCE_LINE 00000099 "        },"
NSQ_SOURCE_LINE 00000100 "        install => {"
NSQ_SOURCE_LINE 00000101 "            schema  => [bool => default => 1],"
NSQ_SOURCE_LINE 00000102 "            summary => 'Whether to install the function',"
NSQ_SOURCE_LINE 00000103 "        },"
NSQ_SOURCE_LINE 00000104 "    },"
NSQ_SOURCE_LINE 00000105 "};"
NSQ_SOURCE_LINE 00000106 "sub gen_test_func {"
NSQ_SOURCE_LINE 00000107 "    my %genargs = @_;"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    my ($uqname, $package);"
NSQ_SOURCE_LINE 00000110 "    my $fqname = $genargs{name}"
NSQ_SOURCE_LINE 00000111 "        or die \"Please specify name (name of generated function)\";"
NSQ_SOURCE_LINE 00000112 "    my $targetf = $genargs{func}"
NSQ_SOURCE_LINE 00000113 "        or die \"Please specify func (arget function to test)\";"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    my @caller = caller(1);"
NSQ_SOURCE_LINE 00000116 "    if ($fqname =~ /(.+)::(.+)/) {"
NSQ_SOURCE_LINE 00000117 "        $package = $1;"
NSQ_SOURCE_LINE 00000118 "        $uqname  = $2;"
NSQ_SOURCE_LINE 00000119 "    } else {"
NSQ_SOURCE_LINE 00000120 "        $package = $genargs{package} // $caller[0] // \"\";"
NSQ_SOURCE_LINE 00000121 "        $uqname  = $fqname;"
NSQ_SOURCE_LINE 00000122 "        $fqname  = \"$package\\::$uqname\";"
NSQ_SOURCE_LINE 00000123 "    }"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "    my $func = sub {"
NSQ_SOURCE_LINE 00000126 "        my %tfargs = @_;"
NSQ_SOURCE_LINE 00000127 "        my $suc = 1; # whether the whole test function succeeds"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "        my $args = $tfargs{args} // {};"
NSQ_SOURCE_LINE 00000130 "        my $name = $tfargs{name} // \"$fqname \".dump1($args);"
NSQ_SOURCE_LINE 00000131 "        subtest $name => sub {"
NSQ_SOURCE_LINE 00000132 "            my $res;"
NSQ_SOURCE_LINE 00000133 "            eval {"
NSQ_SOURCE_LINE 00000134 "                if ($tfargs{run}) {"
NSQ_SOURCE_LINE 00000135 "                    $res = $tfargs{run}->(%tfargs);"
NSQ_SOURCE_LINE 00000136 "                } else {"
NSQ_SOURCE_LINE 00000137 "                    $res = $targetf->("
NSQ_SOURCE_LINE 00000138 "                        ref($args) eq 'HASH' ? %$args :"
NSQ_SOURCE_LINE 00000139 "                            ref($args) eq 'ARRAY' ? @$args : $args);"
NSQ_SOURCE_LINE 00000140 "                }"
NSQ_SOURCE_LINE 00000141 "            };"
NSQ_SOURCE_LINE 00000142 "            my $eval_err = $@;"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "            # test that function does not die"
NSQ_SOURCE_LINE 00000145 "            my $dies = $tfargs{dies} // 0;"
NSQ_SOURCE_LINE 00000146 "            if (!$dies) {"
NSQ_SOURCE_LINE 00000147 "                ok(!$eval_err, \"func doesn't die\")"
NSQ_SOURCE_LINE 00000148 "                    or do { diag \"func died: '$eval_err'\"; $suc=0; goto DONE };"
NSQ_SOURCE_LINE 00000149 "            } else {"
NSQ_SOURCE_LINE 00000150 "                ok($eval_err, \"func dies\") or $suc = 0;"
NSQ_SOURCE_LINE 00000151 "                goto DONE;"
NSQ_SOURCE_LINE 00000152 "            }"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "            # test that result is well-formed"
NSQ_SOURCE_LINE 00000155 "            ok(defined($res), \"result is defined\")"
NSQ_SOURCE_LINE 00000156 "                or do { $suc = 0; goto DONE };"
NSQ_SOURCE_LINE 00000157 "            ok(ref($res) eq 'ARRAY', \"result is an array\")"
NSQ_SOURCE_LINE 00000158 "                or do { $suc = 0; goto DONE };"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "            # test status code"
NSQ_SOURCE_LINE 00000161 "            my $status = $tfargs{status} // 200;"
NSQ_SOURCE_LINE 00000162 "            is($res->[0], $status, \"status is $status\") or $suc = 0;"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "            # test message"
NSQ_SOURCE_LINE 00000165 "            if (defined $tfargs{message}) {"
NSQ_SOURCE_LINE 00000166 "                is($res->[1], $tfargs{message}, \"message\") or $suc = 0;"
NSQ_SOURCE_LINE 00000167 "            }"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "            if (exists $tfargs{result}) {"
NSQ_SOURCE_LINE 00000170 "                is_deeply($res->[2], $tfargs{result}, \"result\")"
NSQ_SOURCE_LINE 00000171 "                    or do { $suc = 0; diag explain \"result is: \", $res->[2] };"
NSQ_SOURCE_LINE 00000172 "            }"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "            if ($tfargs{posttest}) {"
NSQ_SOURCE_LINE 00000175 "                $tfargs{posttest}->($res) or $suc = 0;"
NSQ_SOURCE_LINE 00000176 "            }"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "          DONE:"
NSQ_SOURCE_LINE 00000179 "            return $suc;"
NSQ_SOURCE_LINE 00000180 "        }; # subtest"
NSQ_SOURCE_LINE 00000181 "    };"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    # XXX"
NSQ_SOURCE_LINE 00000184 "    my $meta = {v=>1.1};"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "    if ($genargs{install} // 1) {"
NSQ_SOURCE_LINE 00000187 "        no strict 'refs';"
NSQ_SOURCE_LINE 00000188 "        no warnings;"
NSQ_SOURCE_LINE 00000189 "        #$log->tracef(\"Installing function as %s ...\", $fqname);"
NSQ_SOURCE_LINE 00000190 "        *{ $fqname } = $func;"
NSQ_SOURCE_LINE 00000191 "        #${$package . \"::SPEC\"}{$uqname} = $meta;"
NSQ_SOURCE_LINE 00000192 "    }"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    [200, \"OK\", {code=>$func, meta=>$meta}];"
NSQ_SOURCE_LINE 00000195 "}"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "1;"
NSQ_SOURCE_LINE 00000198 "# ABSTRACT: Generate a test function for a function"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "__END__"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=pod"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=head1 NAME"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "Gen::Test::Rinci::FuncResult - Generate a test function for a function"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "=head1 VERSION"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "This document describes version 0.06 of Gen::Test::Rinci::FuncResult (from Perl distribution Gen-Test-Rinci-FuncResult), released on 2017-07-11."
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 " use Gen::Test::Rinci::FuncResult qw(gen_test_func);"
NSQ_SOURCE_LINE 00000217 " use Test::More;"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 " sub divide {"
NSQ_SOURCE_LINE 00000220 "     my %args = @_;"
NSQ_SOURCE_LINE 00000221 "     my ($a, $b) = ($args{a}, $args{b});"
NSQ_SOURCE_LINE 00000222 "     return [500, \"undefined\"] if $a == 0 && $b == 0;"
NSQ_SOURCE_LINE 00000223 "     [200, \"OK\", $a/$b];"
NSQ_SOURCE_LINE 00000224 " }"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 " gen_test_func(name => 'test_divide', func => \\&divide);"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 " test_divide(args=>{a=>6, b=>3}, result=>2);"
NSQ_SOURCE_LINE 00000229 " test_divide(args=>{a=>6, b=>0}, dies=>1);"
NSQ_SOURCE_LINE 00000230 " test_divide(args=>{a=>0, b=>0}, status=>500);"
NSQ_SOURCE_LINE 00000231 " done_testing;"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head2 gen_test_func"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "Usage:"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 " gen_test_func(%args) -> [status, msg, result, meta]"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Generate a test function for a function."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "This function (A) will generate a function (B)."
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "A accepts, among others, the name or the reference to the function that you want"
NSQ_SOURCE_LINE 00000249 "to test (T) and the name of the generated function, B."
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "B will run T once with some specified arguments, catch exception, and test its"
NSQ_SOURCE_LINE 00000252 "result. The result is expected to be an enveloped result (see the documentation"
NSQ_SOURCE_LINE 00000253 "of C<Rinci::function> for more details about enveloped result)."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "B will accept the following arguments:"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=over"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=item * name (str)"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "Name of the test. Will default to \"T (ARGS...)\" to show the name of the target"
NSQ_SOURCE_LINE 00000262 "function and the arguments that it is called with."
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "=item * args (hash or array)"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "Argument to feed to function T."
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "=item * dies (bool, default => 0)"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "Whether function T should die when run. If set to 1, further tests will not be"
NSQ_SOURCE_LINE 00000271 "done except the test that function dies."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=item * status (int, default => 200)"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Will test the result's status code."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "=item * result (any)"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "If specified, will test the actual result of the function."
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=item * run (code)"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "Instead of running function T with C<args>, will execute this code instead."
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "=item * posttest (code)"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "Run this code for additional tests."
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "=back"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "Todo:"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=over"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=item * Handle function with C<result_naked> => 1."
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=back"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=over 4"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=item * B<func>* => I<code>"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "Target function to test."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=item * B<install> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "Whether to install the function."
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "=item * B<name>* => I<str>"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "Name of the test function to generate (B)."
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "Can be fully qualified, e.g. C<Pkg::SubPkg::funcname> or unqualified C<funcname>"
NSQ_SOURCE_LINE 00000318 "(where the package will be taken from the C<package> argument). Relevant for when"
NSQ_SOURCE_LINE 00000319 "installing the function."
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "=item * B<package> => I<any>"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "Perl package to put this function in."
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "Relevant only when installing the function."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "=back"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "First element (status) is an integer containing HTTP status code"
NSQ_SOURCE_LINE 00000332 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000333 "(msg) is a string containing error message, or 'OK' if status is"
NSQ_SOURCE_LINE 00000334 "200. Third element (result) is optional, the actual result. Fourth"
NSQ_SOURCE_LINE 00000335 "element (meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000336 "that contains extra information."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "Return value:  (any)"
NSQ_SOURCE_LINE 00000339 ""
