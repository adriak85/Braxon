BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Net::Subnet;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use Socket;"
NSQ_SOURCE_LINE 00000005 "BEGIN {"
NSQ_SOURCE_LINE 00000006 "    if (defined &Socket::inet_pton) {"
NSQ_SOURCE_LINE 00000007 "        Socket->import(qw(inet_pton AF_INET6));"
NSQ_SOURCE_LINE 00000008 "    } else {"
NSQ_SOURCE_LINE 00000009 "        require Socket6;"
NSQ_SOURCE_LINE 00000010 "        Socket6->import(qw(inet_pton AF_INET6));"
NSQ_SOURCE_LINE 00000011 "    }"
NSQ_SOURCE_LINE 00000012 "};"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000016 "our @EXPORT = qw(subnet_matcher subnet_classifier sort_subnets);"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "our $VERSION = '1.03';"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "sub cidr2mask_v4 {"
NSQ_SOURCE_LINE 00000021 "    my ($length) = @_;"
NSQ_SOURCE_LINE 00000022 "    return pack \"N\", 0xffffffff << (32 - $length);"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub cidr2mask_v6 {"
NSQ_SOURCE_LINE 00000026 "    my ($length) = @_;"
NSQ_SOURCE_LINE 00000027 "    return pack('B128', '1' x $length);"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "sub subnet_matcher {"
NSQ_SOURCE_LINE 00000031 "    @_ > 1 and goto &multi_matcher;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    my ($net, $mask) = split m[/], shift;"
NSQ_SOURCE_LINE 00000034 "    return $net =~ /:/"
NSQ_SOURCE_LINE 00000035 "        ? ipv6_matcher($net, $mask)"
NSQ_SOURCE_LINE 00000036 "        : ipv4_matcher($net, $mask);"
NSQ_SOURCE_LINE 00000037 "}"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "sub ipv4_matcher {"
NSQ_SOURCE_LINE 00000040 "    my ($net, $mask) = @_;"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "    $net = inet_aton($net);"
NSQ_SOURCE_LINE 00000043 "    $mask = $mask =~ /\\./ ? inet_aton($mask) : cidr2mask_v4($mask);"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "    my $masked_net = $net & $mask;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    return sub { ((inet_aton(shift) // return !1) & $mask) eq $masked_net };"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "sub ipv6_matcher {"
NSQ_SOURCE_LINE 00000051 "    my ($net, $mask) = @_;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    $net = inet_pton(AF_INET6, $net);"
NSQ_SOURCE_LINE 00000054 "    $mask = $mask =~ /:/ ? inet_pton(AF_INET6, $mask) : cidr2mask_v6($mask);"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    my $masked_net = $net & $mask;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    return sub { ((inet_pton(AF_INET6,shift)//return!1) & $mask) eq $masked_net}"
NSQ_SOURCE_LINE 00000059 "}"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "sub multi_matcher {"
NSQ_SOURCE_LINE 00000062 "    my @v4 = map subnet_matcher($_), grep !/:/, @_;"
NSQ_SOURCE_LINE 00000063 "    my @v6 = map subnet_matcher($_), grep  /:/, @_;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    return sub {"
NSQ_SOURCE_LINE 00000066 "        $_->($_[0]) and return 1 for $_[0] =~ /:/ ? @v6 : @v4;"
NSQ_SOURCE_LINE 00000067 "        return !!0;"
NSQ_SOURCE_LINE 00000068 "    }"
NSQ_SOURCE_LINE 00000069 "}"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "use constant MATCHER => 0;"
NSQ_SOURCE_LINE 00000072 "use constant SUBNET  => 1;"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub subnet_classifier {"
NSQ_SOURCE_LINE 00000075 "    #                    MATCHER,     SUBNET"
NSQ_SOURCE_LINE 00000076 "    my @v4 = map [ subnet_matcher($_), $_ ], grep !/:/, @_;"
NSQ_SOURCE_LINE 00000077 "    my @v6 = map [ subnet_matcher($_), $_ ], grep  /:/, @_;"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "    return sub {"
NSQ_SOURCE_LINE 00000080 "        $_->[MATCHER]->($_[0]) and return $_->[SUBNET]"
NSQ_SOURCE_LINE 00000081 "            for $_[0] =~ /:/ ? @v6 : @v4;"
NSQ_SOURCE_LINE 00000082 "        return undef;"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "sub sort_subnets {"
NSQ_SOURCE_LINE 00000087 "    my @unsorted;"
NSQ_SOURCE_LINE 00000088 "    for (@_) {"
NSQ_SOURCE_LINE 00000089 "        my ($net, $mask) = split m[/];"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "        $mask = $net =~ /:/"
NSQ_SOURCE_LINE 00000092 "            ? ($mask =~ /:/ ? inet_pton(AF_INET6, $mask) : cidr2mask_v6($mask))"
NSQ_SOURCE_LINE 00000093 "            : ($mask =~ /\\./ ? inet_aton($mask) : cidr2mask_v4($mask));"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "        $net = $net =~ /:/"
NSQ_SOURCE_LINE 00000096 "            ? inet_pton(AF_INET6, $net)"
NSQ_SOURCE_LINE 00000097 "            : inet_aton($net);"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "        push @unsorted, sprintf \"%-16s%-16s%s\", ($net & $mask), $mask, $_;"
NSQ_SOURCE_LINE 00000100 "    }"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "    return map substr($_, 32), reverse sort @unsorted;"
NSQ_SOURCE_LINE 00000103 "}"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "1;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "__END__"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=head1 NAME"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "Net::Subnet - Fast IP-in-subnet matcher for IPv4 and IPv6, CIDR or mask."
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "    use Net::Subnet;"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "    # CIDR notation"
NSQ_SOURCE_LINE 00000118 "    my $is_rfc1918 = subnet_matcher qw("
NSQ_SOURCE_LINE 00000119 "        10.0.0.0/8"
NSQ_SOURCE_LINE 00000120 "        172.16.0.0/12"
NSQ_SOURCE_LINE 00000121 "        192.168.0.0/16"
NSQ_SOURCE_LINE 00000122 "    );"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "    # Subnet mask notation"
NSQ_SOURCE_LINE 00000125 "    my $is_rfc1918 = subnet_matcher qw("
NSQ_SOURCE_LINE 00000126 "        10.0.0.0/255.0.0.0"
NSQ_SOURCE_LINE 00000127 "        172.16.0.0/255.240.0.0"
NSQ_SOURCE_LINE 00000128 "        192.168.0.0/255.255.0.0"
NSQ_SOURCE_LINE 00000129 "    );"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    print $is_rfc1918->('192.168.1.1') ? 'yes' : 'no';  # prints \"yes\""
NSQ_SOURCE_LINE 00000132 "    print $is_rfc1918->('8.8.8.8')     ? 'yes' : 'no';  # prints \"no\""
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "    # Mixed IPv4 and IPv6"
NSQ_SOURCE_LINE 00000135 "    my $in_office_network = subnet_matcher qw("
NSQ_SOURCE_LINE 00000136 "        192.168.1.0/24"
NSQ_SOURCE_LINE 00000137 "        2001:db8:1337::/48"
NSQ_SOURCE_LINE 00000138 "    );"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "    $x = $in_office_network->('192.168.1.1');            # $x is true"
NSQ_SOURCE_LINE 00000141 "    $x = $in_office_network->('2001:db8:dead:beef::5');  # $x is false"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    my $classifier = subnet_classifier qw("
NSQ_SOURCE_LINE 00000144 "        192.168.1.0/24"
NSQ_SOURCE_LINE 00000145 "        2001:db8:1337::/48"
NSQ_SOURCE_LINE 00000146 "        10.0.0.0/255.0.0.0"
NSQ_SOURCE_LINE 00000147 "    );"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    $x = $classifier->('192.168.1.250');        # $x is '192.168.1.0/24'"
NSQ_SOURCE_LINE 00000150 "    $x = $classifier->('2001:db8:1337::babe');  # $x is '2001:db8:1337::/48'"
NSQ_SOURCE_LINE 00000151 "    $x = $classifier->('10.2.127.1');           # $x is '10.0.0.0/255.0.0.0'"
NSQ_SOURCE_LINE 00000152 "    $x = $classifier->('8.8.8.8');              # $x is undef"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "    # More specific subnets (smaller subnets) must be listed first"
NSQ_SOURCE_LINE 00000155 "    my @subnets = sort_subnets("
NSQ_SOURCE_LINE 00000156 "        '192.168.0.0/24',  # second"
NSQ_SOURCE_LINE 00000157 "        '192.168.0.1/32',  # first"
NSQ_SOURCE_LINE 00000158 "        '192.168.0.0/16',  # third"
NSQ_SOURCE_LINE 00000159 "    );"
NSQ_SOURCE_LINE 00000160 "    my $classifier = subnet_classifier @subnets;"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "This is a simple but fast pure Perl module for determining whether a given IP"
NSQ_SOURCE_LINE 00000165 "address is in a given set of IP subnets. It's iterative, and it doesn't use any"
NSQ_SOURCE_LINE 00000166 "fancy tries, but because it uses simple bitwise operations on strings it's"
NSQ_SOURCE_LINE 00000167 "still very fast."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "All documented functions are exported by default."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "Subnets have to be given in \"address/mask\" or \"address/length\" (CIDR) format."
NSQ_SOURCE_LINE 00000172 "The Socket and Socket6 modules are used to normalise addresses, which means"
NSQ_SOURCE_LINE 00000173 "that any of the address formats supported by inet_aton and inet_pton can be"
NSQ_SOURCE_LINE 00000174 "used with Net::Subnet."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=head2 subnet_matcher(@subnets)"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "Returns a reference to a function that returns true if the given IP address is"
NSQ_SOURCE_LINE 00000181 "in @subnets, false it it's not."
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=head2 subnet_classifier(@subnets)"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "Returns a reference to a function that returns the element from @subnets that"
NSQ_SOURCE_LINE 00000186 "matches the given IP address, or undef if none matched."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=head2 sort_subnets(@subnets)"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "Returns @subnets in reverse order of prefix length and prefix; use this with"
NSQ_SOURCE_LINE 00000191 "subnet_matcher or subnet_classifier if your subnet list has overlapping ranges"
NSQ_SOURCE_LINE 00000192 "and it's not already sorted most-specific-first."
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=head1 TRICKS"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=head2 Generating PTR records for IPv6"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "If you need to classify an IP address, but want some other value than the"
NSQ_SOURCE_LINE 00000199 "original subnet string, just use a hash. You could even use code references;"
NSQ_SOURCE_LINE 00000200 "here's an example of how to generate dynamic reverse DNS records for IPv6"
NSQ_SOURCE_LINE 00000201 "addresses:"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    my %ptr = ("
NSQ_SOURCE_LINE 00000204 "        '2001:db8:1337:d00d::/64' => sub {"
NSQ_SOURCE_LINE 00000205 "            my $hostname = get_machine_name(shift);"
NSQ_SOURCE_LINE 00000206 "            return $hostname =~ /\\.$/ ? $hostname : \"$hostname.example.org.\";"
NSQ_SOURCE_LINE 00000207 "        },"
NSQ_SOURCE_LINE 00000208 "        '2001:db8:1337:babe::/64' => sub {"
NSQ_SOURCE_LINE 00000209 "            my $hostname = get_machine_name(shift);"
NSQ_SOURCE_LINE 00000210 "            return $hostname =~ /\\.$/ ? $hostname : \"$hostname.example.net.\";"
NSQ_SOURCE_LINE 00000211 "        },"
NSQ_SOURCE_LINE 00000212 "        '::/0' => sub {"
NSQ_SOURCE_LINE 00000213 "            (my $ip = shift) =~ s/:/x/g;"
NSQ_SOURCE_LINE 00000214 "            return \"$ip.unknown.example.com.\";"
NSQ_SOURCE_LINE 00000215 "        },"
NSQ_SOURCE_LINE 00000216 "    );"
NSQ_SOURCE_LINE 00000217 "    my $classifier = subnet_classifier sort_subnets keys %ptr;"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "    while (my $ip = readline) {"
NSQ_SOURCE_LINE 00000220 "        # We get IP adresses from STDIN and return the hostnames on STDOUT"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "        print $ptr{ $classifier->($ip) }->($ip), \"\\n\";"
NSQ_SOURCE_LINE 00000223 "    }"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "=head2 Matching ::ffff:192.168.1.200"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "IPv4 subnets only match IPv4 addresses. If you need to match IPv4-mapped IPv6"
NSQ_SOURCE_LINE 00000228 "addresses, i.e. IPv4 addresses with C<::ffff:> stuck in front of them, simply"
NSQ_SOURCE_LINE 00000229 "remove that part before matching:"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "    my $matcher = subnet_matcher qw(192.168.1.0/22);"
NSQ_SOURCE_LINE 00000232 "    $ip =~ s/^::ffff://;"
NSQ_SOURCE_LINE 00000233 "    my $boolean = $matcher->($ip);"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "Alternatively, translate the subnet definition to IPv6 notation: C<1.2.3.0/24>"
NSQ_SOURCE_LINE 00000236 "becomes C<::ffff:1.2.3.0/120>. If you do this, hexadecimal addresses such as"
NSQ_SOURCE_LINE 00000237 "C<::ffff:102:304> will also match, but IPv4 addresses without C<::ffff:> will"
NSQ_SOURCE_LINE 00000238 "no longer match unless you include C<1.2.3.0/24> as well."
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "    my $matcher = subnet_matcher qw(::ffff:192.168.1.0/118 192.168.1.0/22);"
NSQ_SOURCE_LINE 00000241 "    my $boolean = $matcher->($ip);"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "No argument verification is done; garbage in, garbage out. If you give it"
NSQ_SOURCE_LINE 00000246 "hostnames, DNS may be used to resolve them, courtesy of the Socket and Socket6"
NSQ_SOURCE_LINE 00000247 "modules."
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "Juerd Waalboer <juerd#@tnx.nl>"
NSQ_SOURCE_LINE 00000252 ""
