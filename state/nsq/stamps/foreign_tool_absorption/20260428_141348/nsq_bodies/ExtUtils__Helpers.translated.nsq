NSQ_SOURCE_LINE 00000001 "package ExtUtils::Helpers;"
NSQ_SOURCE_LINE 00000002 "$ExtUtils::Helpers::VERSION = '0.028';"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings FATAL => 'all';"
NSQ_SOURCE_LINE 00000005 "use Exporter 5.57 'import';"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "use Config;"
NSQ_SOURCE_LINE 00000008 "use File::Basename qw/basename/;"
NSQ_SOURCE_LINE 00000009 "use File::Spec::Functions qw/splitpath canonpath abs2rel splitdir/;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "our @EXPORT_OK = qw/make_executable split_like_shell man1_pagename man3_pagename detildefy/;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "BEGIN {"
NSQ_SOURCE_LINE 00000014 "\tmy %impl_for = ( MSWin32 => 'Windows', VMS => 'VMS');"
NSQ_SOURCE_LINE 00000015 "\tmy $package = 'ExtUtils::Helpers::' . ($impl_for{$^O} || 'Unix');"
NSQ_SOURCE_LINE 00000016 "\tmy $impl = $impl_for{$^O} || 'Unix';"
NSQ_SOURCE_LINE 00000017 "\trequire \"ExtUtils/Helpers/$impl.pm\";"
NSQ_SOURCE_LINE 00000018 "\t\"ExtUtils::Helpers::$impl\"->import();"
NSQ_SOURCE_LINE 00000019 "}"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "sub man1_pagename {"
NSQ_SOURCE_LINE 00000022 "\tmy ($filename, $ext) = @_;"
NSQ_SOURCE_LINE 00000023 "\t$ext ||= $Config{man1ext};"
NSQ_SOURCE_LINE 00000024 "\treturn basename($filename).\".$ext\";"
NSQ_SOURCE_LINE 00000025 "}"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "my %separator = ("
NSQ_SOURCE_LINE 00000028 "\tMSWin32 => '.',"
NSQ_SOURCE_LINE 00000029 "\tVMS => '__',"
NSQ_SOURCE_LINE 00000030 "\tos2 => '.',"
NSQ_SOURCE_LINE 00000031 "\tcygwin => '.',"
NSQ_SOURCE_LINE 00000032 ");"
NSQ_SOURCE_LINE 00000033 "my $separator = $separator{$^O} || '::';"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "sub man3_pagename {"
NSQ_SOURCE_LINE 00000036 "\tmy ($filename, $base, $ext) = @_;"
NSQ_SOURCE_LINE 00000037 "\t$base ||= 'lib';"
NSQ_SOURCE_LINE 00000038 "\t$ext  ||= $Config{man3ext};"
NSQ_SOURCE_LINE 00000039 "\tmy ($vols, $dirs, $file) = splitpath(canonpath(abs2rel($filename, $base)));"
NSQ_SOURCE_LINE 00000040 "\t$file = basename($file, qw/.pm .pod/);"
NSQ_SOURCE_LINE 00000041 "\tmy @dirs = grep { length } splitdir($dirs);"
NSQ_SOURCE_LINE 00000042 "\treturn join $separator, @dirs, \"$file.$ext\";"
NSQ_SOURCE_LINE 00000043 "}"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "1;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "# ABSTRACT: Various portability utilities for module builders"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "__END__"
