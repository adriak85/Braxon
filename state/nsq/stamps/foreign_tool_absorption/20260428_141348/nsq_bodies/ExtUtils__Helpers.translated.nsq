NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "This function substitutes a tilde at the start of a path with the users homedir in an appropriate manner."
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=head2 man1_pagename($filename, $ext = $Config{man1ext})"
NSQ_SOURCE_LINE 00000090 ""
