NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=head2 man3_pagename($filename, $basedir = 'lib', $ext = $Config{man3ext})"
NSQ_SOURCE_LINE 00000094 ""
