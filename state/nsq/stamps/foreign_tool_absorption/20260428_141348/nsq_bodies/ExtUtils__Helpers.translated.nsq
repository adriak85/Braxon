NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "This module provides various portable helper functions for module building modules."
NSQ_SOURCE_LINE 00000074 ""
