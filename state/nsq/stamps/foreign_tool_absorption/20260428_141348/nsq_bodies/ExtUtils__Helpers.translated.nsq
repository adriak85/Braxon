NSQ_SOURCE_LINE 00000079 "This makes a perl script executable."
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "=head2 split_like_shell($string)"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "This function splits a string the same way as the local platform does."
NSQ_SOURCE_LINE 00000084 ""
