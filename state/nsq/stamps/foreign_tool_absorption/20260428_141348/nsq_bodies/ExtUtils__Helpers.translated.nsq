NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "version 0.028"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 " use ExtUtils::Helpers qw/make_executable split_like_shell/;"
NSQ_SOURCE_LINE 00000066 ""
