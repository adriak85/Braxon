NSQ_SOURCE_LINE 00000001 "package Complete::Env;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2017-12-31'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.400'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict;"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Complete::Common qw(:all);"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "require Exporter;"
NSQ_SOURCE_LINE 00000013 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000015 "                       complete_env"
NSQ_SOURCE_LINE 00000016 "                       complete_env_elem"
NSQ_SOURCE_LINE 00000017 "                       complete_path_env_elem"
NSQ_SOURCE_LINE 00000018 "               );"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "our %SPEC;"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "$SPEC{':package'} = {"
NSQ_SOURCE_LINE 00000023 "    v => 1.1,"
NSQ_SOURCE_LINE 00000024 "    summary => 'Completion routines related to environment variables',"
NSQ_SOURCE_LINE 00000025 "};"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "$SPEC{complete_env} = {"
NSQ_SOURCE_LINE 00000028 "    v => 1.1,"
NSQ_SOURCE_LINE 00000029 "    summary => 'Complete from environment variables',"
NSQ_SOURCE_LINE 00000030 "    description => <<'_',"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "On Windows, environment variable names are all converted to uppercase. You can"
NSQ_SOURCE_LINE 00000033 "use case-insensitive option (`ci`) to match against original casing."
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "_"
NSQ_SOURCE_LINE 00000036 "    args => {"
NSQ_SOURCE_LINE 00000037 "        %arg_word,"
NSQ_SOURCE_LINE 00000038 "    },"
NSQ_SOURCE_LINE 00000039 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000040 "    result => {"
NSQ_SOURCE_LINE 00000041 "        schema => 'array',"
NSQ_SOURCE_LINE 00000042 "    },"
NSQ_SOURCE_LINE 00000043 "};"
NSQ_SOURCE_LINE 00000044 "sub complete_env {"
NSQ_SOURCE_LINE 00000045 "    require Complete::Util;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    my %args  = @_;"
NSQ_SOURCE_LINE 00000048 "    my $word     = $args{word} // \"\";"
NSQ_SOURCE_LINE 00000049 "    if ($word =~ /^\\$/) {"
NSQ_SOURCE_LINE 00000050 "        Complete::Util::complete_array_elem("
NSQ_SOURCE_LINE 00000051 "            word=>$word, array=>[map {\"\\$$_\"} keys %ENV],"
NSQ_SOURCE_LINE 00000052 "        );"
NSQ_SOURCE_LINE 00000053 "    } else {"
NSQ_SOURCE_LINE 00000054 "        Complete::Util::complete_array_elem("
NSQ_SOURCE_LINE 00000055 "            word=>$word, array=>[keys %ENV],"
NSQ_SOURCE_LINE 00000056 "        );"
NSQ_SOURCE_LINE 00000057 "    }"
NSQ_SOURCE_LINE 00000058 "}"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "$SPEC{complete_env_elem} = {"
NSQ_SOURCE_LINE 00000061 "    v => 1.1,"
NSQ_SOURCE_LINE 00000062 "    summary => 'Complete from elements of an environment variable',"
NSQ_SOURCE_LINE 00000063 "    description => <<'_',"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "An environment variable like PATH contains colon- (or, on Windows, semicolon-)"
NSQ_SOURCE_LINE 00000066 "separated elements. This routine complete from the elements of such variable."
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "_"
NSQ_SOURCE_LINE 00000069 "    args => {"
NSQ_SOURCE_LINE 00000070 "        %arg_word,"
NSQ_SOURCE_LINE 00000071 "        env      => {"
NSQ_SOURCE_LINE 00000072 "            summary => 'Name of environment variable to use',"
NSQ_SOURCE_LINE 00000073 "            schema  => 'str*',"
NSQ_SOURCE_LINE 00000074 "            req => 1,"
NSQ_SOURCE_LINE 00000075 "            pos => 1,"
NSQ_SOURCE_LINE 00000076 "        },"
NSQ_SOURCE_LINE 00000077 "    },"
NSQ_SOURCE_LINE 00000078 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000079 "    result => {"
NSQ_SOURCE_LINE 00000080 "        schema => 'array',"
NSQ_SOURCE_LINE 00000081 "    },"
NSQ_SOURCE_LINE 00000082 "};"
NSQ_SOURCE_LINE 00000083 "sub complete_env_elem {"
NSQ_SOURCE_LINE 00000084 "    require Complete::Util;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    my %args  = @_;"
NSQ_SOURCE_LINE 00000087 "    my $word  = $args{word} // \"\";"
NSQ_SOURCE_LINE 00000088 "    my $env   = $args{env};"
NSQ_SOURCE_LINE 00000089 "    my @elems;"
NSQ_SOURCE_LINE 00000090 "    if ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000091 "        @elems = split /;/, ($ENV{$env} // '');"
NSQ_SOURCE_LINE 00000092 "    } else {"
NSQ_SOURCE_LINE 00000093 "        @elems = split /:/, ($ENV{$env} // '');"
NSQ_SOURCE_LINE 00000094 "    }"
NSQ_SOURCE_LINE 00000095 "    Complete::Util::complete_array_elem("
NSQ_SOURCE_LINE 00000096 "        word=>$word, array=>\\@elems,"
NSQ_SOURCE_LINE 00000097 "    );"
NSQ_SOURCE_LINE 00000098 "}"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "$SPEC{complete_path_env_elem} = {"
NSQ_SOURCE_LINE 00000101 "    v => 1.1,"
NSQ_SOURCE_LINE 00000102 "    summary => 'Complete from elements of PATH environment variable',"
NSQ_SOURCE_LINE 00000103 "    description => <<'_',"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "PATH environment variable contains colon- (or, on Windows, semicolon-) separated"
NSQ_SOURCE_LINE 00000106 "elements. This routine complete from those elements."
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "_"
NSQ_SOURCE_LINE 00000109 "    args => {"
NSQ_SOURCE_LINE 00000110 "        %arg_word,"
NSQ_SOURCE_LINE 00000111 "    },"
NSQ_SOURCE_LINE 00000112 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000113 "    result => {"
NSQ_SOURCE_LINE 00000114 "        schema => 'array',"
NSQ_SOURCE_LINE 00000115 "    },"
NSQ_SOURCE_LINE 00000116 "};"
NSQ_SOURCE_LINE 00000117 "sub complete_path_env_elem {"
NSQ_SOURCE_LINE 00000118 "    my %args  = @_;"
NSQ_SOURCE_LINE 00000119 "    complete_env_elem(word => $args{word}, env => 'PATH');"
NSQ_SOURCE_LINE 00000120 "}"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "1;"
NSQ_SOURCE_LINE 00000123 "# ABSTRACT: Completion routines related to environment variables"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "__END__"
