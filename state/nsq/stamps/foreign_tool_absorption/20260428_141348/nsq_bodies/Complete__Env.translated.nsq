NSQ_SOURCE_LINE 00000174 " complete_env_elem(%args) -> array"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "Complete from elements of an environment variable."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "An environment variable like PATH contains colon- (or, on Windows, semicolon-)"
NSQ_SOURCE_LINE 00000179 "separated elements. This routine complete from the elements of such variable."
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "=over 4"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "=item * B<env>* => I<str>"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "Name of environment variable to use."
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "=item * B<word>* => I<str> (default: \"\")"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "Word to complete."
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "=back"
