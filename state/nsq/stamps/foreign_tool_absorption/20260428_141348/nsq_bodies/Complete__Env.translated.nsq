NSQ_SOURCE_LINE 00000144 "=head2 complete_env"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "Usage:"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 " complete_env(%args) -> array"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Complete from environment variables."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "On Windows, environment variable names are all converted to uppercase. You can"
NSQ_SOURCE_LINE 00000153 "use case-insensitive option (C<ci>) to match against original casing."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=over 4"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=item * B<word>* => I<str> (default: \"\")"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "Word to complete."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=back"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "Return value:  (array)"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 ""
