BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Scope::Guard;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Carp qw(confess);"
NSQ_SOURCE_LINE 00000007 "use Exporter ();"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000010 "our @EXPORT_OK = qw(guard scope_guard);"
NSQ_SOURCE_LINE 00000011 "our $VERSION = '0.21';"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "sub new {"
NSQ_SOURCE_LINE 00000014 "    confess \"Can't create a Scope::Guard in void context\" unless (defined wantarray);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "    my $class = shift;"
NSQ_SOURCE_LINE 00000017 "    my $handler = shift() || die 'Scope::Guard::new: no handler supplied';"
NSQ_SOURCE_LINE 00000018 "    my $ref = ref $handler || '';"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    die \"Scope::Guard::new: invalid handler - expected CODE ref, got: '$ref'\""
NSQ_SOURCE_LINE 00000021 "        unless ref($handler) eq 'CODE';"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "    bless [ 0, $handler ], ref $class || $class;"
NSQ_SOURCE_LINE 00000024 "}"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "sub dismiss {"
NSQ_SOURCE_LINE 00000027 "    my $self = shift;"
NSQ_SOURCE_LINE 00000028 "    my $dismiss = @_ ? shift : 1;"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    $self->[0] = $dismiss;"
NSQ_SOURCE_LINE 00000031 "}"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "sub guard(&) { __PACKAGE__->new(shift) }"
NSQ_SOURCE_LINE 00000034 "sub scope_guard($) { __PACKAGE__->new(shift) }"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub DESTROY {"
NSQ_SOURCE_LINE 00000037 "    my $self = shift;"
NSQ_SOURCE_LINE 00000038 "    my ($dismiss, $handler) = @$self;"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    $handler->() unless ($dismiss);"
NSQ_SOURCE_LINE 00000041 "}"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "1;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "__END__"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=pod"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=head1 NAME"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "Scope::Guard - lexically-scoped resource management"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "    my $guard = guard { ... };"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "      # or"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    my $guard = scope_guard \\&handler;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "      # or"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    my $guard = Scope::Guard->new(sub { ... });"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "    $guard->dismiss(); # disable the handler"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "This module provides a convenient way to perform cleanup or other forms of resource"
NSQ_SOURCE_LINE 00000070 "management at the end of a scope. It is particularly useful when dealing with exceptions:"
NSQ_SOURCE_LINE 00000071 "the C<Scope::Guard> constructor takes a reference to a subroutine that is guaranteed to"
NSQ_SOURCE_LINE 00000072 "be called even if the thread of execution is aborted prematurely. This effectively allows"
NSQ_SOURCE_LINE 00000073 "lexically-scoped \"promises\" to be made that are automatically honoured by perl's garbage"
NSQ_SOURCE_LINE 00000074 "collector."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "For more information, see: L<http://www.drdobbs.com/cpp/184403758>"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=head1 METHODS"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=head2 new"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "    my $guard = Scope::Guard->new(sub { ... });"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "      # or"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "    my $guard = Scope::Guard->new(\\&handler);"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "The C<new> method creates a new C<Scope::Guard> object which calls the supplied handler when its C<DESTROY> method is"
NSQ_SOURCE_LINE 00000089 "called, typically at the end of the scope."
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=head2 dismiss"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "    $guard->dismiss();"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "      # or"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    $guard->dismiss(1);"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "C<dismiss> detaches the handler from the C<Scope::Guard> object. This revokes the \"promise\" to call the"
NSQ_SOURCE_LINE 00000100 "handler when the object is destroyed."
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "The handler can be re-enabled by calling:"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    $guard->dismiss(0);"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "=head2 guard"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "C<guard> takes a block and returns a new C<Scope::Guard> object. It can be used"
NSQ_SOURCE_LINE 00000111 "as a shorthand for:"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "    Scope::Guard->new(...)"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "e.g."
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "    my $guard = guard { ... };"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "Note: calling C<guard> anonymously, i.e. in void context, will raise an exception."
NSQ_SOURCE_LINE 00000120 "This is because anonymous guards are destroyed B<immediately>"
NSQ_SOURCE_LINE 00000121 "(rather than at the end of the scope), which is unlikely to be the desired behaviour."
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=head2 scope_guard"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "C<scope_guard> is the same as C<guard>, but it takes a code ref rather than a block."
NSQ_SOURCE_LINE 00000126 "e.g."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "    my $guard = scope_guard \\&handler;"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "or:"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    my $guard = scope_guard sub { ... };"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "or:"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    my $guard = scope_guard $handler;"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "As with C<guard>, calling C<scope_guard> in void context will raise an exception."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=head1 VERSION"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "0.21"
NSQ_SOURCE_LINE 00000143 ""
