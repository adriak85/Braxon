BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "=head1 NAME"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "JSON::XS - JSON serialising/deserialising, done correctly and fast"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "=encoding utf-8"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "JSON::XS - 正しくて高速な JSON シリアライザ/デシリアライザ"
NSQ_SOURCE_LINE 00000008 "           (http://fleur.hio.jp/perldoc/mix/lib/JSON/XS.html)"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 " use JSON::XS;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 " # exported functions, they croak on error"
NSQ_SOURCE_LINE 00000015 " # and expect/generate UTF-8"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 " $utf8_encoded_json_text = encode_json $perl_hash_or_arrayref;"
NSQ_SOURCE_LINE 00000018 " $perl_hash_or_arrayref  = decode_json $utf8_encoded_json_text;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 " # OO-interface"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 " $coder = JSON::XS->new->ascii->pretty->allow_nonref;"
NSQ_SOURCE_LINE 00000023 " $pretty_printed_unencoded = $coder->encode ($perl_scalar);"
NSQ_SOURCE_LINE 00000024 " $perl_scalar = $coder->decode ($unicode_json_text);"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 " # Note that JSON version 2.0 and above will automatically use JSON::XS"
NSQ_SOURCE_LINE 00000027 " # if available, at virtually no speed overhead either, so you should"
NSQ_SOURCE_LINE 00000028 " # be able to just:"
NSQ_SOURCE_LINE 00000029 " "
NSQ_SOURCE_LINE 00000030 " use JSON;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 " # and do the same things, except that you have a pure-perl fallback now."
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "This module converts Perl data structures to JSON and vice versa. Its"
NSQ_SOURCE_LINE 00000037 "primary goal is to be I<correct> and its secondary goal is to be"
NSQ_SOURCE_LINE 00000038 "I<fast>. To reach the latter goal it was written in C."
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "See MAPPING, below, on how JSON::XS maps perl values to JSON values and"
NSQ_SOURCE_LINE 00000041 "vice versa."
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=head2 FEATURES"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=over"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=item * correct Unicode handling"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "This module knows how to handle Unicode, documents how and when it does"
NSQ_SOURCE_LINE 00000050 "so, and even documents what \"correct\" means."
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=item * round-trip integrity"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "When you serialise a perl data structure using only data types supported"
NSQ_SOURCE_LINE 00000055 "by JSON and Perl, the deserialised data structure is identical on the Perl"
NSQ_SOURCE_LINE 00000056 "level. (e.g. the string \"2.0\" doesn't suddenly become \"2\" just because"
NSQ_SOURCE_LINE 00000057 "it looks like a number). There I<are> minor exceptions to this, read the"
NSQ_SOURCE_LINE 00000058 "MAPPING section below to learn about those."
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "=item * strict checking of JSON correctness"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "There is no guessing, no generating of illegal JSON texts by default,"
NSQ_SOURCE_LINE 00000063 "and only JSON is accepted as input by default (the latter is a security"
NSQ_SOURCE_LINE 00000064 "feature)."
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "=item * fast"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "Compared to other JSON modules and other serialisers such as Storable,"
NSQ_SOURCE_LINE 00000069 "this module usually compares favourably in terms of speed, too."
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=item * simple to use"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "This module has both a simple functional interface as well as an object"
NSQ_SOURCE_LINE 00000074 "oriented interface."
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "=item * reasonably versatile output formats"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "You can choose between the most compact guaranteed-single-line format"
NSQ_SOURCE_LINE 00000079 "possible (nice for simple line-based protocols), a pure-ASCII format"
NSQ_SOURCE_LINE 00000080 "(for when your transport is not 8-bit clean, still supports the whole"
NSQ_SOURCE_LINE 00000081 "Unicode range), or a pretty-printed format (for when you want to read that"
NSQ_SOURCE_LINE 00000082 "stuff). Or you can combine those features in whatever way you like."
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=back"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=cut"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "package JSON::XS;"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "use common::sense;"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "our $VERSION = '4.04';"
NSQ_SOURCE_LINE 00000093 "our @ISA = qw(Exporter);"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "our @EXPORT = qw(encode_json decode_json);"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "use Exporter;"
NSQ_SOURCE_LINE 00000098 "use XSLoader;"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "use Types::Serialiser ();"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 FUNCTIONAL INTERFACE"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "The following convenience methods are provided by this module. They are"
NSQ_SOURCE_LINE 00000105 "exported by default:"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=over"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=item $json_text = encode_json $perl_scalar"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "Converts the given Perl data structure to a UTF-8 encoded, binary string"
NSQ_SOURCE_LINE 00000112 "(that is, the string contains octets only). Croaks on error."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "This function call is functionally identical to:"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "   $json_text = JSON::XS->new->utf8->encode ($perl_scalar)"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "Except being faster."
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=item $perl_scalar = decode_json $json_text"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "The opposite of C<encode_json>: expects a UTF-8 (binary) string and tries"
NSQ_SOURCE_LINE 00000123 "to parse that as a UTF-8 encoded JSON text, returning the resulting"
NSQ_SOURCE_LINE 00000124 "reference. Croaks on error."
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "This function call is functionally identical to:"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "   $perl_scalar = JSON::XS->new->utf8->decode ($json_text)"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "Except being faster."
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=back"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=head1 A FEW NOTES ON UNICODE AND PERL"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "Since this often leads to confusion, here are a few very clear words on"
NSQ_SOURCE_LINE 00000138 "how Unicode works in Perl, modulo bugs."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=over"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=item 1. Perl strings can store characters with ordinal values > 255."
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "This enables you to store Unicode characters as single characters in a"
NSQ_SOURCE_LINE 00000145 "Perl string - very natural."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=item 2. Perl does I<not> associate an encoding with your strings."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "... until you force it to, e.g. when matching it against a regex, or"
NSQ_SOURCE_LINE 00000150 "printing the scalar to a file, in which case Perl either interprets your"
NSQ_SOURCE_LINE 00000151 "string as locale-encoded text, octets/binary, or as Unicode, depending"
NSQ_SOURCE_LINE 00000152 "on various settings. In no case is an encoding stored together with your"
NSQ_SOURCE_LINE 00000153 "data, it is I<use> that decides encoding, not any magical meta data."
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=item 3. The internal utf-8 flag has no meaning with regards to the"
NSQ_SOURCE_LINE 00000156 "encoding of your string."
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "Just ignore that flag unless you debug a Perl bug, a module written in"
NSQ_SOURCE_LINE 00000159 "XS or want to dive into the internals of perl. Otherwise it will only"
NSQ_SOURCE_LINE 00000160 "confuse you, as, despite the name, it says nothing about how your string"
NSQ_SOURCE_LINE 00000161 "is encoded. You can have Unicode strings with that flag set, with that"
NSQ_SOURCE_LINE 00000162 "flag clear, and you can have binary data with that flag set and that flag"
NSQ_SOURCE_LINE 00000163 "clear. Other possibilities exist, too."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "If you didn't know about that flag, just the better, pretend it doesn't"
NSQ_SOURCE_LINE 00000166 "exist."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=item 4. A \"Unicode String\" is simply a string where each character can be"
NSQ_SOURCE_LINE 00000169 "validly interpreted as a Unicode code point."
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "If you have UTF-8 encoded data, it is no longer a Unicode string, but a"
NSQ_SOURCE_LINE 00000172 "Unicode string encoded in UTF-8, giving you a binary string."
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "=item 5. A string containing \"high\" (> 255) character values is I<not> a UTF-8 string."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "It's a fact. Learn to live with it."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=back"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "I hope this helps :)"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "=head1 OBJECT-ORIENTED INTERFACE"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "The object oriented interface lets you configure your own encoding or"
NSQ_SOURCE_LINE 00000186 "decoding style, within the limits of supported formats."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=over"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=item $json = new JSON::XS"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "Creates a new JSON::XS object that can be used to de/encode JSON"
NSQ_SOURCE_LINE 00000193 "strings. All boolean flags described below are by default I<disabled>"
NSQ_SOURCE_LINE 00000194 "(with the exception of C<allow_nonref>, which defaults to I<enabled> since"
NSQ_SOURCE_LINE 00000195 "version C<4.0>)."
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "The mutators for flags all return the JSON object again and thus calls can"
NSQ_SOURCE_LINE 00000198 "be chained:"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "   my $json = JSON::XS->new->utf8->space_after->encode ({a => [1,2]})"
NSQ_SOURCE_LINE 00000201 "   => {\"a\": [1, 2]}"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "=item $json = $json->ascii ([$enable])"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=item $enabled = $json->get_ascii"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "If C<$enable> is true (or missing), then the C<encode> method will not"
NSQ_SOURCE_LINE 00000208 "generate characters outside the code range C<0..127> (which is ASCII). Any"
NSQ_SOURCE_LINE 00000209 "Unicode characters outside that range will be escaped using either a"
NSQ_SOURCE_LINE 00000210 "single \\uXXXX (BMP characters) or a double \\uHHHH\\uLLLLL escape sequence,"
NSQ_SOURCE_LINE 00000211 "as per RFC4627. The resulting encoded JSON text can be treated as a native"
NSQ_SOURCE_LINE 00000212 "Unicode string, an ascii-encoded, latin1-encoded or UTF-8 encoded string,"
NSQ_SOURCE_LINE 00000213 "or any other superset of ASCII."
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "If C<$enable> is false, then the C<encode> method will not escape Unicode"
NSQ_SOURCE_LINE 00000216 "characters unless required by the JSON syntax or other flags. This results"
NSQ_SOURCE_LINE 00000217 "in a faster and more compact format."
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "See also the section I<ENCODING/CODESET FLAG NOTES> later in this"
NSQ_SOURCE_LINE 00000220 "document."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "The main use for this flag is to produce JSON texts that can be"
NSQ_SOURCE_LINE 00000223 "transmitted over a 7-bit channel, as the encoded JSON texts will not"
NSQ_SOURCE_LINE 00000224 "contain any 8 bit characters."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "  JSON::XS->new->ascii (1)->encode ([chr 0x10401])"
NSQ_SOURCE_LINE 00000227 "  => [\"\\ud801\\udc01\"]"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "=item $json = $json->latin1 ([$enable])"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "=item $enabled = $json->get_latin1"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "If C<$enable> is true (or missing), then the C<encode> method will encode"
NSQ_SOURCE_LINE 00000234 "the resulting JSON text as latin1 (or iso-8859-1), escaping any characters"
NSQ_SOURCE_LINE 00000235 "outside the code range C<0..255>. The resulting string can be treated as a"
NSQ_SOURCE_LINE 00000236 "latin1-encoded JSON text or a native Unicode string. The C<decode> method"
NSQ_SOURCE_LINE 00000237 "will not be affected in any way by this flag, as C<decode> by default"
NSQ_SOURCE_LINE 00000238 "expects Unicode, which is a strict superset of latin1."
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "If C<$enable> is false, then the C<encode> method will not escape Unicode"
NSQ_SOURCE_LINE 00000241 "characters unless required by the JSON syntax or other flags."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "See also the section I<ENCODING/CODESET FLAG NOTES> later in this"
NSQ_SOURCE_LINE 00000244 "document."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "The main use for this flag is efficiently encoding binary data as JSON"
NSQ_SOURCE_LINE 00000247 "text, as most octets will not be escaped, resulting in a smaller encoded"
NSQ_SOURCE_LINE 00000248 "size. The disadvantage is that the resulting JSON text is encoded"
NSQ_SOURCE_LINE 00000249 "in latin1 (and must correctly be treated as such when storing and"
NSQ_SOURCE_LINE 00000250 "transferring), a rare encoding for JSON. It is therefore most useful when"
NSQ_SOURCE_LINE 00000251 "you want to store data structures known to contain binary data efficiently"
NSQ_SOURCE_LINE 00000252 "in files or databases, not when talking to other JSON encoders/decoders."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "  JSON::XS->new->latin1->encode ([\"\\x{89}\\x{abc}\"]"
NSQ_SOURCE_LINE 00000255 "  => [\"\\x{89}\\\\u0abc\"]    # (perl syntax, U+abc escaped, U+89 not)"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "=item $json = $json->utf8 ([$enable])"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "=item $enabled = $json->get_utf8"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "If C<$enable> is true (or missing), then the C<encode> method will encode"
NSQ_SOURCE_LINE 00000262 "the JSON result into UTF-8, as required by many protocols, while the"
NSQ_SOURCE_LINE 00000263 "C<decode> method expects to be handed a UTF-8-encoded string.  Please"
NSQ_SOURCE_LINE 00000264 "note that UTF-8-encoded strings do not contain any characters outside the"
NSQ_SOURCE_LINE 00000265 "range C<0..255>, they are thus useful for bytewise/binary I/O. In future"
NSQ_SOURCE_LINE 00000266 "versions, enabling this option might enable autodetection of the UTF-16"
NSQ_SOURCE_LINE 00000267 "and UTF-32 encoding families, as described in RFC4627."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "If C<$enable> is false, then the C<encode> method will return the JSON"
NSQ_SOURCE_LINE 00000270 "string as a (non-encoded) Unicode string, while C<decode> expects thus a"
NSQ_SOURCE_LINE 00000271 "Unicode string.  Any decoding or encoding (e.g. to UTF-8 or UTF-16) needs"
NSQ_SOURCE_LINE 00000272 "to be done yourself, e.g. using the Encode module."
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "See also the section I<ENCODING/CODESET FLAG NOTES> later in this"
NSQ_SOURCE_LINE 00000275 "document."
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "Example, output UTF-16BE-encoded JSON:"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "  use Encode;"
NSQ_SOURCE_LINE 00000280 "  $jsontext = encode \"UTF-16BE\", JSON::XS->new->encode ($object);"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "Example, decode UTF-32LE-encoded JSON:"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "  use Encode;"
NSQ_SOURCE_LINE 00000285 "  $object = JSON::XS->new->decode (decode \"UTF-32LE\", $jsontext);"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=item $json = $json->pretty ([$enable])"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "This enables (or disables) all of the C<indent>, C<space_before> and"
NSQ_SOURCE_LINE 00000290 "C<space_after> (and in the future possibly more) flags in one call to"
NSQ_SOURCE_LINE 00000291 "generate the most readable (or most compact) form possible."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "Example, pretty-print some simple structure:"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "   my $json = JSON::XS->new->pretty(1)->encode ({a => [1,2]})"
NSQ_SOURCE_LINE 00000296 "   =>"
NSQ_SOURCE_LINE 00000297 "   {"
NSQ_SOURCE_LINE 00000298 "      \"a\" : ["
NSQ_SOURCE_LINE 00000299 "         1,"
NSQ_SOURCE_LINE 00000300 "         2"
NSQ_SOURCE_LINE 00000301 "      ]"
NSQ_SOURCE_LINE 00000302 "   }"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "=item $json = $json->indent ([$enable])"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "=item $enabled = $json->get_indent"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "If C<$enable> is true (or missing), then the C<encode> method will use a multiline"
NSQ_SOURCE_LINE 00000309 "format as output, putting every array member or object/hash key-value pair"
NSQ_SOURCE_LINE 00000310 "into its own line, indenting them properly."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "If C<$enable> is false, no newlines or indenting will be produced, and the"
NSQ_SOURCE_LINE 00000313 "resulting JSON text is guaranteed not to contain any C<newlines>."
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "This setting has no effect when decoding JSON texts."
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=item $json = $json->space_before ([$enable])"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "=item $enabled = $json->get_space_before"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "If C<$enable> is true (or missing), then the C<encode> method will add an extra"
NSQ_SOURCE_LINE 00000322 "optional space before the C<:> separating keys from values in JSON objects."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "If C<$enable> is false, then the C<encode> method will not add any extra"
NSQ_SOURCE_LINE 00000325 "space at those places."
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "This setting has no effect when decoding JSON texts. You will also"
NSQ_SOURCE_LINE 00000328 "most likely combine this setting with C<space_after>."
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "Example, space_before enabled, space_after and indent disabled:"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "   {\"key\" :\"value\"}"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "=item $json = $json->space_after ([$enable])"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "=item $enabled = $json->get_space_after"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "If C<$enable> is true (or missing), then the C<encode> method will add an extra"
NSQ_SOURCE_LINE 00000339 "optional space after the C<:> separating keys from values in JSON objects"
NSQ_SOURCE_LINE 00000340 "and extra whitespace after the C<,> separating key-value pairs and array"
NSQ_SOURCE_LINE 00000341 "members."
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "If C<$enable> is false, then the C<encode> method will not add any extra"
NSQ_SOURCE_LINE 00000344 "space at those places."
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "This setting has no effect when decoding JSON texts."
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "Example, space_before and indent disabled, space_after enabled:"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "   {\"key\": \"value\"}"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=item $json = $json->relaxed ([$enable])"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=item $enabled = $json->get_relaxed"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "If C<$enable> is true (or missing), then C<decode> will accept some"
NSQ_SOURCE_LINE 00000357 "extensions to normal JSON syntax (see below). C<encode> will not be"
NSQ_SOURCE_LINE 00000358 "affected in any way. I<Be aware that this option makes you accept invalid"
NSQ_SOURCE_LINE 00000359 "JSON texts as if they were valid!>. I suggest only to use this option to"
NSQ_SOURCE_LINE 00000360 "parse application-specific files written by humans (configuration files,"
NSQ_SOURCE_LINE 00000361 "resource files etc.)"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "If C<$enable> is false (the default), then C<decode> will only accept"
NSQ_SOURCE_LINE 00000364 "valid JSON texts."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "Currently accepted extensions are:"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "=over"
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "=item * list items can have an end-comma"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "JSON I<separates> array elements and key-value pairs with commas. This"
NSQ_SOURCE_LINE 00000373 "can be annoying if you write JSON texts manually and want to be able to"
NSQ_SOURCE_LINE 00000374 "quickly append elements, so this extension accepts comma at the end of"
NSQ_SOURCE_LINE 00000375 "such items not just between them:"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "   ["
NSQ_SOURCE_LINE 00000378 "      1,"
NSQ_SOURCE_LINE 00000379 "      2, <- this comma not normally allowed"
NSQ_SOURCE_LINE 00000380 "   ]"
NSQ_SOURCE_LINE 00000381 "   {"
NSQ_SOURCE_LINE 00000382 "      \"k1\": \"v1\","
NSQ_SOURCE_LINE 00000383 "      \"k2\": \"v2\", <- this comma not normally allowed"
NSQ_SOURCE_LINE 00000384 "   }"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "=item * shell-style '#'-comments"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "Whenever JSON allows whitespace, shell-style comments are additionally"
NSQ_SOURCE_LINE 00000389 "allowed. They are terminated by the first carriage-return or line-feed"
NSQ_SOURCE_LINE 00000390 "character, after which more white-space and comments are allowed."
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "  ["
NSQ_SOURCE_LINE 00000393 "     1, # this comment not allowed in JSON"
NSQ_SOURCE_LINE 00000394 "        # neither this one..."
NSQ_SOURCE_LINE 00000395 "  ]"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=item * literal ASCII TAB characters in strings"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "Literal ASCII TAB characters are now allowed in strings (and treated as"
NSQ_SOURCE_LINE 00000400 "C<\\t>)."
NSQ_SOURCE_LINE 00000401 ""
NSQ_SOURCE_LINE 00000402 "  ["
NSQ_SOURCE_LINE 00000403 "     \"Hello\\tWorld\","
NSQ_SOURCE_LINE 00000404 "     \"Hello<TAB>World\", # literal <TAB> would not normally be allowed"
NSQ_SOURCE_LINE 00000405 "  ]"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=back"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "=item $json = $json->canonical ([$enable])"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=item $enabled = $json->get_canonical"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "If C<$enable> is true (or missing), then the C<encode> method will output JSON objects"
NSQ_SOURCE_LINE 00000414 "by sorting their keys. This is adding a comparatively high overhead."
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "If C<$enable> is false, then the C<encode> method will output key-value"
NSQ_SOURCE_LINE 00000417 "pairs in the order Perl stores them (which will likely change between runs"
NSQ_SOURCE_LINE 00000418 "of the same script, and can change even within the same run from 5.18"
NSQ_SOURCE_LINE 00000419 "onwards)."
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "This option is useful if you want the same data structure to be encoded as"
NSQ_SOURCE_LINE 00000422 "the same JSON text (given the same overall settings). If it is disabled,"
NSQ_SOURCE_LINE 00000423 "the same hash might be encoded differently even if contains the same data,"
NSQ_SOURCE_LINE 00000424 "as key-value pairs have no inherent ordering in Perl."
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "This setting has no effect when decoding JSON texts."
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "This setting has currently no effect on tied hashes."
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "=item $json = $json->allow_nonref ([$enable])"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "=item $enabled = $json->get_allow_nonref"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "Unlike other boolean options, this option is enabled by default beginning"
NSQ_SOURCE_LINE 00000435 "with version C<4.0>. See L<SECURITY CONSIDERATIONS> for the gory details."
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "If C<$enable> is true (or missing), then the C<encode> method can convert a"
NSQ_SOURCE_LINE 00000438 "non-reference into its corresponding string, number or null JSON value,"
NSQ_SOURCE_LINE 00000439 "which is an extension to RFC4627. Likewise, C<decode> will accept those JSON"
NSQ_SOURCE_LINE 00000440 "values instead of croaking."
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "If C<$enable> is false, then the C<encode> method will croak if it isn't"
NSQ_SOURCE_LINE 00000443 "passed an arrayref or hashref, as JSON texts must either be an object"
NSQ_SOURCE_LINE 00000444 "or array. Likewise, C<decode> will croak if given something that is not a"
NSQ_SOURCE_LINE 00000445 "JSON object or array."
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "Example, encode a Perl scalar as JSON value without enabled C<allow_nonref>,"
NSQ_SOURCE_LINE 00000448 "resulting in an error:"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "   JSON::XS->new->allow_nonref (0)->encode (\"Hello, World!\")"
NSQ_SOURCE_LINE 00000451 "   => hash- or arrayref expected..."
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "=item $json = $json->allow_unknown ([$enable])"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=item $enabled = $json->get_allow_unknown"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "If C<$enable> is true (or missing), then C<encode> will I<not> throw an"
NSQ_SOURCE_LINE 00000458 "exception when it encounters values it cannot represent in JSON (for"
NSQ_SOURCE_LINE 00000459 "example, filehandles) but instead will encode a JSON C<null> value. Note"
NSQ_SOURCE_LINE 00000460 "that blessed objects are not included here and are handled separately by"
NSQ_SOURCE_LINE 00000461 "c<allow_nonref>."
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "If C<$enable> is false (the default), then C<encode> will throw an"
NSQ_SOURCE_LINE 00000464 "exception when it encounters anything it cannot encode as JSON."
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "This option does not affect C<decode> in any way, and it is recommended to"
NSQ_SOURCE_LINE 00000467 "leave it off unless you know your communications partner."
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=item $json = $json->allow_blessed ([$enable])"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "=item $enabled = $json->get_allow_blessed"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "See L<OBJECT SERIALISATION> for details."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "If C<$enable> is true (or missing), then the C<encode> method will not"
NSQ_SOURCE_LINE 00000476 "barf when it encounters a blessed reference that it cannot convert"
NSQ_SOURCE_LINE 00000477 "otherwise. Instead, a JSON C<null> value is encoded instead of the object."
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "If C<$enable> is false (the default), then C<encode> will throw an"
NSQ_SOURCE_LINE 00000480 "exception when it encounters a blessed object that it cannot convert"
NSQ_SOURCE_LINE 00000481 "otherwise."
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "This setting has no effect on C<decode>."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "=item $json = $json->convert_blessed ([$enable])"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=item $enabled = $json->get_convert_blessed"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "See L<OBJECT SERIALISATION> for details."
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "If C<$enable> is true (or missing), then C<encode>, upon encountering a"
NSQ_SOURCE_LINE 00000492 "blessed object, will check for the availability of the C<TO_JSON> method"
NSQ_SOURCE_LINE 00000493 "on the object's class. If found, it will be called in scalar context and"
NSQ_SOURCE_LINE 00000494 "the resulting scalar will be encoded instead of the object."
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "The C<TO_JSON> method may safely call die if it wants. If C<TO_JSON>"
NSQ_SOURCE_LINE 00000497 "returns other blessed objects, those will be handled in the same"
NSQ_SOURCE_LINE 00000498 "way. C<TO_JSON> must take care of not causing an endless recursion cycle"
NSQ_SOURCE_LINE 00000499 "(== crash) in this case. The name of C<TO_JSON> was chosen because other"
NSQ_SOURCE_LINE 00000500 "methods called by the Perl core (== not by the user of the object) are"
NSQ_SOURCE_LINE 00000501 "usually in upper case letters and to avoid collisions with any C<to_json>"
NSQ_SOURCE_LINE 00000502 "function or method."
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "If C<$enable> is false (the default), then C<encode> will not consider"
NSQ_SOURCE_LINE 00000505 "this type of conversion."
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "This setting has no effect on C<decode>."
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=item $json = $json->allow_tags ([$enable])"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "=item $enabled = $json->get_allow_tags"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "See L<OBJECT SERIALISATION> for details."
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "If C<$enable> is true (or missing), then C<encode>, upon encountering a"
NSQ_SOURCE_LINE 00000516 "blessed object, will check for the availability of the C<FREEZE> method on"
NSQ_SOURCE_LINE 00000517 "the object's class. If found, it will be used to serialise the object into"
NSQ_SOURCE_LINE 00000518 "a nonstandard tagged JSON value (that JSON decoders cannot decode)."
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "It also causes C<decode> to parse such tagged JSON values and deserialise"
NSQ_SOURCE_LINE 00000521 "them via a call to the C<THAW> method."
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "If C<$enable> is false (the default), then C<encode> will not consider"
NSQ_SOURCE_LINE 00000524 "this type of conversion, and tagged JSON values will cause a parse error"
NSQ_SOURCE_LINE 00000525 "in C<decode>, as if tags were not part of the grammar."
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "=item $json->boolean_values ([$false, $true])"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=item ($false,  $true) = $json->get_boolean_values"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "By default, JSON booleans will be decoded as overloaded"
NSQ_SOURCE_LINE 00000532 "C<$Types::Serialiser::false> and C<$Types::Serialiser::true> objects."
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "With this method you can specify your own boolean values for decoding -"
NSQ_SOURCE_LINE 00000535 "on decode, JSON C<false> will be decoded as a copy of C<$false>, and JSON"
NSQ_SOURCE_LINE 00000536 "C<true> will be decoded as C<$true> (\"copy\" here is the same thing as"
NSQ_SOURCE_LINE 00000537 "assigning a value to another variable, i.e. C<$copy = $false>)."
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "Calling this method without any arguments will reset the booleans"
NSQ_SOURCE_LINE 00000540 "to their default values."
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "C<get_boolean_values> will return both C<$false> and C<$true> values, or"
NSQ_SOURCE_LINE 00000543 "the empty list when they are set to the default."
NSQ_SOURCE_LINE 00000544 ""
NSQ_SOURCE_LINE 00000545 "=item $json = $json->filter_json_object ([$coderef->($hashref)])"
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "When C<$coderef> is specified, it will be called from C<decode> each"
NSQ_SOURCE_LINE 00000548 "time it decodes a JSON object. The only argument is a reference to"
NSQ_SOURCE_LINE 00000549 "the newly-created hash. If the code reference returns a single scalar"
NSQ_SOURCE_LINE 00000550 "(which need not be a reference), this value (or rather a copy of it) is"
NSQ_SOURCE_LINE 00000551 "inserted into the deserialised data structure. If it returns an empty"
NSQ_SOURCE_LINE 00000552 "list (NOTE: I<not> C<undef>, which is a valid scalar), the original"
NSQ_SOURCE_LINE 00000553 "deserialised hash will be inserted. This setting can slow down decoding"
NSQ_SOURCE_LINE 00000554 "considerably."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "When C<$coderef> is omitted or undefined, any existing callback will"
NSQ_SOURCE_LINE 00000557 "be removed and C<decode> will not change the deserialised hash in any"
NSQ_SOURCE_LINE 00000558 "way."
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "Example, convert all JSON objects into the integer 5:"
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "   my $js = JSON::XS->new->filter_json_object (sub { 5 });"
NSQ_SOURCE_LINE 00000563 "   # returns [5]"
NSQ_SOURCE_LINE 00000564 "   $js->decode ('[{}]')"
NSQ_SOURCE_LINE 00000565 "   # throw an exception because allow_nonref is not enabled"
NSQ_SOURCE_LINE 00000566 "   # so a lone 5 is not allowed."
NSQ_SOURCE_LINE 00000567 "   $js->decode ('{\"a\":1, \"b\":2}');"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "=item $json = $json->filter_json_single_key_object ($key [=> $coderef->($value)])"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "Works remotely similar to C<filter_json_object>, but is only called for"
NSQ_SOURCE_LINE 00000572 "JSON objects having a single key named C<$key>."
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "This C<$coderef> is called before the one specified via"
NSQ_SOURCE_LINE 00000575 "C<filter_json_object>, if any. It gets passed the single value in the JSON"
NSQ_SOURCE_LINE 00000576 "object. If it returns a single value, it will be inserted into the data"
NSQ_SOURCE_LINE 00000577 "structure. If it returns nothing (not even C<undef> but the empty list),"
NSQ_SOURCE_LINE 00000578 "the callback from C<filter_json_object> will be called next, as if no"
NSQ_SOURCE_LINE 00000579 "single-key callback were specified."
NSQ_SOURCE_LINE 00000580 ""
NSQ_SOURCE_LINE 00000581 "If C<$coderef> is omitted or undefined, the corresponding callback will be"
NSQ_SOURCE_LINE 00000582 "disabled. There can only ever be one callback for a given key."
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "As this callback gets called less often then the C<filter_json_object>"
NSQ_SOURCE_LINE 00000585 "one, decoding speed will not usually suffer as much. Therefore, single-key"
NSQ_SOURCE_LINE 00000586 "objects make excellent targets to serialise Perl objects into, especially"
NSQ_SOURCE_LINE 00000587 "as single-key JSON objects are as close to the type-tagged value concept"
NSQ_SOURCE_LINE 00000588 "as JSON gets (it's basically an ID/VALUE tuple). Of course, JSON does not"
NSQ_SOURCE_LINE 00000589 "support this in any way, so you need to make sure your data never looks"
NSQ_SOURCE_LINE 00000590 "like a serialised Perl hash."
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "Typical names for the single object key are C<__class_whatever__>, or"
NSQ_SOURCE_LINE 00000593 "C<$__dollars_are_rarely_used__$> or C<}ugly_brace_placement>, or even"
NSQ_SOURCE_LINE 00000594 "things like C<__class_md5sum(classname)__>, to reduce the risk of clashing"
NSQ_SOURCE_LINE 00000595 "with real hashes."
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "Example, decode JSON objects of the form C<< { \"__widget__\" => <id> } >>"
NSQ_SOURCE_LINE 00000598 "into the corresponding C<< $WIDGET{<id>} >> object:"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "   # return whatever is in $WIDGET{5}:"
NSQ_SOURCE_LINE 00000601 "   JSON::XS"
NSQ_SOURCE_LINE 00000602 "      ->new"
NSQ_SOURCE_LINE 00000603 "      ->filter_json_single_key_object (__widget__ => sub {"
NSQ_SOURCE_LINE 00000604 "            $WIDGET{ $_[0] }"
NSQ_SOURCE_LINE 00000605 "         })"
NSQ_SOURCE_LINE 00000606 "      ->decode ('{\"__widget__\": 5')"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "   # this can be used with a TO_JSON method in some \"widget\" class"
NSQ_SOURCE_LINE 00000609 "   # for serialisation to json:"
NSQ_SOURCE_LINE 00000610 "   sub WidgetBase::TO_JSON {"
NSQ_SOURCE_LINE 00000611 "      my ($self) = @_;"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "      unless ($self->{id}) {"
NSQ_SOURCE_LINE 00000614 "         $self->{id} = ..get..some..id..;"
NSQ_SOURCE_LINE 00000615 "         $WIDGET{$self->{id}} = $self;"
NSQ_SOURCE_LINE 00000616 "      }"
NSQ_SOURCE_LINE 00000617 ""
NSQ_SOURCE_LINE 00000618 "      { __widget__ => $self->{id} }"
NSQ_SOURCE_LINE 00000619 "   }"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "=item $json = $json->shrink ([$enable])"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "=item $enabled = $json->get_shrink"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "Perl usually over-allocates memory a bit when allocating space for"
NSQ_SOURCE_LINE 00000626 "strings. This flag optionally resizes strings generated by either"
NSQ_SOURCE_LINE 00000627 "C<encode> or C<decode> to their minimum size possible. This can save"
NSQ_SOURCE_LINE 00000628 "memory when your JSON texts are either very very long or you have many"
NSQ_SOURCE_LINE 00000629 "short strings. It will also try to downgrade any strings to octet-form"
NSQ_SOURCE_LINE 00000630 "if possible: perl stores strings internally either in an encoding called"
NSQ_SOURCE_LINE 00000631 "UTF-X or in octet-form. The latter cannot store everything but uses less"
NSQ_SOURCE_LINE 00000632 "space in general (and some buggy Perl or C code might even rely on that"
NSQ_SOURCE_LINE 00000633 "internal representation being used)."
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "The actual definition of what shrink does might change in future versions,"
NSQ_SOURCE_LINE 00000636 "but it will always try to save space at the expense of time."
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "If C<$enable> is true (or missing), the string returned by C<encode> will"
NSQ_SOURCE_LINE 00000639 "be shrunk-to-fit, while all strings generated by C<decode> will also be"
NSQ_SOURCE_LINE 00000640 "shrunk-to-fit."
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "If C<$enable> is false, then the normal perl allocation algorithms are used."
NSQ_SOURCE_LINE 00000643 "If you work with your data, then this is likely to be faster."
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "In the future, this setting might control other things, such as converting"
NSQ_SOURCE_LINE 00000646 "strings that look like integers or floats into integers or floats"
NSQ_SOURCE_LINE 00000647 "internally (there is no difference on the Perl level), saving space."
NSQ_SOURCE_LINE 00000648 ""
NSQ_SOURCE_LINE 00000649 "=item $json = $json->max_depth ([$maximum_nesting_depth])"
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "=item $max_depth = $json->get_max_depth"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "Sets the maximum nesting level (default C<512>) accepted while encoding"
NSQ_SOURCE_LINE 00000654 "or decoding. If a higher nesting level is detected in JSON text or a Perl"
NSQ_SOURCE_LINE 00000655 "data structure, then the encoder and decoder will stop and croak at that"
NSQ_SOURCE_LINE 00000656 "point."
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "Nesting level is defined by number of hash- or arrayrefs that the encoder"
NSQ_SOURCE_LINE 00000659 "needs to traverse to reach a given point or the number of C<{> or C<[>"
NSQ_SOURCE_LINE 00000660 "characters without their matching closing parenthesis crossed to reach a"
NSQ_SOURCE_LINE 00000661 "given character in a string."
NSQ_SOURCE_LINE 00000662 ""
NSQ_SOURCE_LINE 00000663 "Setting the maximum depth to one disallows any nesting, so that ensures"
NSQ_SOURCE_LINE 00000664 "that the object is only a single hash/object or array."
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "If no argument is given, the highest possible setting will be used, which"
NSQ_SOURCE_LINE 00000667 "is rarely useful."
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "Note that nesting is implemented by recursion in C. The default value has"
NSQ_SOURCE_LINE 00000670 "been chosen to be as large as typical operating systems allow without"
NSQ_SOURCE_LINE 00000671 "crashing."
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "See SECURITY CONSIDERATIONS, below, for more info on why this is useful."
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "=item $json = $json->max_size ([$maximum_string_size])"
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "=item $max_size = $json->get_max_size"
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "Set the maximum length a JSON text may have (in bytes) where decoding is"
NSQ_SOURCE_LINE 00000680 "being attempted. The default is C<0>, meaning no limit. When C<decode>"
NSQ_SOURCE_LINE 00000681 "is called on a string that is longer then this many bytes, it will not"
NSQ_SOURCE_LINE 00000682 "attempt to decode the string but throw an exception. This setting has no"
NSQ_SOURCE_LINE 00000683 "effect on C<encode> (yet)."
NSQ_SOURCE_LINE 00000684 ""
NSQ_SOURCE_LINE 00000685 "If no argument is given, the limit check will be deactivated (same as when"
NSQ_SOURCE_LINE 00000686 "C<0> is specified)."
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "See SECURITY CONSIDERATIONS, below, for more info on why this is useful."
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "=item $json_text = $json->encode ($perl_scalar)"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "Converts the given Perl value or data structure to its JSON"
NSQ_SOURCE_LINE 00000693 "representation. Croaks on error."
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "=item $perl_scalar = $json->decode ($json_text)"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "The opposite of C<encode>: expects a JSON text and tries to parse it,"
NSQ_SOURCE_LINE 00000698 "returning the resulting simple scalar or reference. Croaks on error."
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "=item ($perl_scalar, $characters) = $json->decode_prefix ($json_text)"
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "This works like the C<decode> method, but instead of raising an exception"
NSQ_SOURCE_LINE 00000703 "when there is trailing garbage after the first JSON object, it will"
NSQ_SOURCE_LINE 00000704 "silently stop parsing there and return the number of characters consumed"
NSQ_SOURCE_LINE 00000705 "so far."
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "This is useful if your JSON texts are not delimited by an outer protocol"
NSQ_SOURCE_LINE 00000708 "and you need to know where the JSON text ends."
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "   JSON::XS->new->decode_prefix (\"[1] the tail\")"
NSQ_SOURCE_LINE 00000711 "   => ([1], 3)"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 "=back"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "=head1 INCREMENTAL PARSING"
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "In some cases, there is the need for incremental parsing of JSON"
NSQ_SOURCE_LINE 00000719 "texts. While this module always has to keep both JSON text and resulting"
NSQ_SOURCE_LINE 00000720 "Perl data structure in memory at one time, it does allow you to parse a"
NSQ_SOURCE_LINE 00000721 "JSON stream incrementally. It does so by accumulating text until it has"
NSQ_SOURCE_LINE 00000722 "a full JSON object, which it then can decode. This process is similar to"
NSQ_SOURCE_LINE 00000723 "using C<decode_prefix> to see if a full JSON object is available, but"
NSQ_SOURCE_LINE 00000724 "is much more efficient (and can be implemented with a minimum of method"
NSQ_SOURCE_LINE 00000725 "calls)."
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "JSON::XS will only attempt to parse the JSON text once it is sure it"
NSQ_SOURCE_LINE 00000728 "has enough text to get a decisive result, using a very simple but"
NSQ_SOURCE_LINE 00000729 "truly incremental parser. This means that it sometimes won't stop as"
NSQ_SOURCE_LINE 00000730 "early as the full parser, for example, it doesn't detect mismatched"
NSQ_SOURCE_LINE 00000731 "parentheses. The only thing it guarantees is that it starts decoding as"
NSQ_SOURCE_LINE 00000732 "soon as a syntactically valid JSON text has been seen. This means you need"
NSQ_SOURCE_LINE 00000733 "to set resource limits (e.g. C<max_size>) to ensure the parser will stop"
NSQ_SOURCE_LINE 00000734 "parsing in the presence if syntax errors."
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "The following methods implement this incremental parser."
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "=over"
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "=item [void, scalar or list context] = $json->incr_parse ([$string])"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "This is the central parsing function. It can both append new text and"
NSQ_SOURCE_LINE 00000743 "extract objects from the stream accumulated so far (both of these"
NSQ_SOURCE_LINE 00000744 "functions are optional)."
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "If C<$string> is given, then this string is appended to the already"
NSQ_SOURCE_LINE 00000747 "existing JSON fragment stored in the C<$json> object."
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "After that, if the function is called in void context, it will simply"
NSQ_SOURCE_LINE 00000750 "return without doing anything further. This can be used to add more text"
NSQ_SOURCE_LINE 00000751 "in as many chunks as you want."
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "If the method is called in scalar context, then it will try to extract"
NSQ_SOURCE_LINE 00000754 "exactly I<one> JSON object. If that is successful, it will return this"
NSQ_SOURCE_LINE 00000755 "object, otherwise it will return C<undef>. If there is a parse error,"
NSQ_SOURCE_LINE 00000756 "this method will croak just as C<decode> would do (one can then use"
NSQ_SOURCE_LINE 00000757 "C<incr_skip> to skip the erroneous part). This is the most common way of"
NSQ_SOURCE_LINE 00000758 "using the method."
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "And finally, in list context, it will try to extract as many objects"
NSQ_SOURCE_LINE 00000761 "from the stream as it can find and return them, or the empty list"
NSQ_SOURCE_LINE 00000762 "otherwise. For this to work, there must be no separators (other than"
NSQ_SOURCE_LINE 00000763 "whitespace) between the JSON objects or arrays, instead they must be"
NSQ_SOURCE_LINE 00000764 "concatenated back-to-back. If an error occurs, an exception will be"
NSQ_SOURCE_LINE 00000765 "raised as in the scalar context case. Note that in this case, any"
NSQ_SOURCE_LINE 00000766 "previously-parsed JSON texts will be lost."
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "Example: Parse some JSON arrays/objects in a given string and return"
NSQ_SOURCE_LINE 00000769 "them."
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "   my @objs = JSON::XS->new->incr_parse (\"[5][7][1,2]\");"
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "=item $lvalue_string = $json->incr_text"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "This method returns the currently stored JSON fragment as an lvalue, that"
NSQ_SOURCE_LINE 00000776 "is, you can manipulate it. This I<only> works when a preceding call to"
NSQ_SOURCE_LINE 00000777 "C<incr_parse> in I<scalar context> successfully returned an object. Under"
NSQ_SOURCE_LINE 00000778 "all other circumstances you must not call this function (I mean it."
NSQ_SOURCE_LINE 00000779 "although in simple tests it might actually work, it I<will> fail under"
NSQ_SOURCE_LINE 00000780 "real world conditions). As a special exception, you can also call this"
NSQ_SOURCE_LINE 00000781 "method before having parsed anything."
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "That means you can only use this function to look at or manipulate text"
NSQ_SOURCE_LINE 00000784 "before or after complete JSON objects, not while the parser is in the"
NSQ_SOURCE_LINE 00000785 "middle of parsing a JSON object."
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "This function is useful in two cases: a) finding the trailing text after a"
NSQ_SOURCE_LINE 00000788 "JSON object or b) parsing multiple JSON objects separated by non-JSON text"
NSQ_SOURCE_LINE 00000789 "(such as commas)."
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "=item $json->incr_skip"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "This will reset the state of the incremental parser and will remove"
NSQ_SOURCE_LINE 00000794 "the parsed text from the input buffer so far. This is useful after"
NSQ_SOURCE_LINE 00000795 "C<incr_parse> died, in which case the input buffer and incremental parser"
NSQ_SOURCE_LINE 00000796 "state is left unchanged, to skip the text parsed so far and to reset the"
NSQ_SOURCE_LINE 00000797 "parse state."
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "The difference to C<incr_reset> is that only text until the parse error"
NSQ_SOURCE_LINE 00000800 "occurred is removed."
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "=item $json->incr_reset"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "This completely resets the incremental parser, that is, after this call,"
NSQ_SOURCE_LINE 00000805 "it will be as if the parser had never parsed anything."
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "This is useful if you want to repeatedly parse JSON objects and want to"
NSQ_SOURCE_LINE 00000808 "ignore any trailing data, which means you have to reset the parser after"
NSQ_SOURCE_LINE 00000809 "each successful decode."
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "=back"
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "=head2 LIMITATIONS"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "The incremental parser is a non-exact parser: it works by gathering as"
NSQ_SOURCE_LINE 00000816 "much text as possible that I<could> be a valid JSON text, followed by"
NSQ_SOURCE_LINE 00000817 "trying to decode it."
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "That means it sometimes needs to read more data than strictly necessary to"
NSQ_SOURCE_LINE 00000820 "diagnose an invalid JSON text. For example, after parsing the following"
NSQ_SOURCE_LINE 00000821 "fragment, the parser I<could> stop with an error, as this fragment"
NSQ_SOURCE_LINE 00000822 "I<cannot> be the beginning of a valid JSON text:"
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "   [,"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "In reality, however, the parser might continue to read data until a"
NSQ_SOURCE_LINE 00000827 "length limit is exceeded or it finds a closing bracket."
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "=head2 EXAMPLES"
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "Some examples will make all this clearer. First, a simple example that"
NSQ_SOURCE_LINE 00000832 "works similarly to C<decode_prefix>: We want to decode the JSON object at"
NSQ_SOURCE_LINE 00000833 "the start of a string and identify the portion after the JSON object:"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "   my $text = \"[1,2,3] hello\";"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "   my $json = new JSON::XS;"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "   my $obj = $json->incr_parse ($text)"
NSQ_SOURCE_LINE 00000840 "      or die \"expected JSON object or array at beginning of string\";"
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "   my $tail = $json->incr_text;"
NSQ_SOURCE_LINE 00000843 "   # $tail now contains \" hello\""
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "Easy, isn't it?"
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "Now for a more complicated example: Imagine a hypothetical protocol where"
NSQ_SOURCE_LINE 00000848 "you read some requests from a TCP stream, and each request is a JSON"
NSQ_SOURCE_LINE 00000849 "array, without any separation between them (in fact, it is often useful to"
NSQ_SOURCE_LINE 00000850 "use newlines as \"separators\", as these get interpreted as whitespace at"
NSQ_SOURCE_LINE 00000851 "the start of the JSON text, which makes it possible to test said protocol"
NSQ_SOURCE_LINE 00000852 "with C<telnet>...)."
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "Here is how you'd do it (it is trivial to write this in an event-based"
NSQ_SOURCE_LINE 00000855 "manner):"
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "   my $json = new JSON::XS;"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "   # read some data from the socket"
NSQ_SOURCE_LINE 00000860 "   while (sysread $socket, my $buf, 4096) {"
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "      # split and decode as many requests as possible"
NSQ_SOURCE_LINE 00000863 "      for my $request ($json->incr_parse ($buf)) {"
NSQ_SOURCE_LINE 00000864 "         # act on the $request"
NSQ_SOURCE_LINE 00000865 "      }"
NSQ_SOURCE_LINE 00000866 "   }"
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "Another complicated example: Assume you have a string with JSON objects"
NSQ_SOURCE_LINE 00000869 "or arrays, all separated by (optional) comma characters (e.g. C<[1],[2],"
NSQ_SOURCE_LINE 00000870 "[3]>). To parse them, we have to skip the commas between the JSON texts,"
NSQ_SOURCE_LINE 00000871 "and here is where the lvalue-ness of C<incr_text> comes in useful:"
NSQ_SOURCE_LINE 00000872 ""
NSQ_SOURCE_LINE 00000873 "   my $text = \"[1],[2], [3]\";"
NSQ_SOURCE_LINE 00000874 "   my $json = new JSON::XS;"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "   # void context, so no parsing done"
NSQ_SOURCE_LINE 00000877 "   $json->incr_parse ($text);"
NSQ_SOURCE_LINE 00000878 ""
NSQ_SOURCE_LINE 00000879 "   # now extract as many objects as possible. note the"
NSQ_SOURCE_LINE 00000880 "   # use of scalar context so incr_text can be called."
NSQ_SOURCE_LINE 00000881 "   while (my $obj = $json->incr_parse) {"
NSQ_SOURCE_LINE 00000882 "      # do something with $obj"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "      # now skip the optional comma"
NSQ_SOURCE_LINE 00000885 "      $json->incr_text =~ s/^ \\s* , //x;"
NSQ_SOURCE_LINE 00000886 "   }"
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "Now lets go for a very complex example: Assume that you have a gigantic"
NSQ_SOURCE_LINE 00000889 "JSON array-of-objects, many gigabytes in size, and you want to parse it,"
NSQ_SOURCE_LINE 00000890 "but you cannot load it into memory fully (this has actually happened in"
NSQ_SOURCE_LINE 00000891 "the real world :)."
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "Well, you lost, you have to implement your own JSON parser. But JSON::XS"
NSQ_SOURCE_LINE 00000894 "can still help you: You implement a (very simple) array parser and let"
NSQ_SOURCE_LINE 00000895 "JSON decode the array elements, which are all full JSON objects on their"
NSQ_SOURCE_LINE 00000896 "own (this wouldn't work if the array elements could be JSON numbers, for"
NSQ_SOURCE_LINE 00000897 "example):"
NSQ_SOURCE_LINE 00000898 ""
NSQ_SOURCE_LINE 00000899 "   my $json = new JSON::XS;"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "   # open the monster"
NSQ_SOURCE_LINE 00000902 "   open my $fh, \"<bigfile.json\""
NSQ_SOURCE_LINE 00000903 "      or die \"bigfile: $!\";"
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "   # first parse the initial \"[\""
NSQ_SOURCE_LINE 00000906 "   for (;;) {"
NSQ_SOURCE_LINE 00000907 "      sysread $fh, my $buf, 65536"
NSQ_SOURCE_LINE 00000908 "         or die \"read error: $!\";"
NSQ_SOURCE_LINE 00000909 "      $json->incr_parse ($buf); # void context, so no parsing"
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "      # Exit the loop once we found and removed(!) the initial \"[\"."
NSQ_SOURCE_LINE 00000912 "      # In essence, we are (ab-)using the $json object as a simple scalar"
NSQ_SOURCE_LINE 00000913 "      # we append data to."
NSQ_SOURCE_LINE 00000914 "      last if $json->incr_text =~ s/^ \\s* \\[ //x;"
NSQ_SOURCE_LINE 00000915 "   }"
NSQ_SOURCE_LINE 00000916 ""
NSQ_SOURCE_LINE 00000917 "   # now we have the skipped the initial \"[\", so continue"
NSQ_SOURCE_LINE 00000918 "   # parsing all the elements."
NSQ_SOURCE_LINE 00000919 "   for (;;) {"
NSQ_SOURCE_LINE 00000920 "      # in this loop we read data until we got a single JSON object"
NSQ_SOURCE_LINE 00000921 "      for (;;) {"
NSQ_SOURCE_LINE 00000922 "         if (my $obj = $json->incr_parse) {"
NSQ_SOURCE_LINE 00000923 "            # do something with $obj"
NSQ_SOURCE_LINE 00000924 "            last;"
NSQ_SOURCE_LINE 00000925 "         }"
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "         # add more data"
NSQ_SOURCE_LINE 00000928 "         sysread $fh, my $buf, 65536"
NSQ_SOURCE_LINE 00000929 "            or die \"read error: $!\";"
NSQ_SOURCE_LINE 00000930 "         $json->incr_parse ($buf); # void context, so no parsing"
NSQ_SOURCE_LINE 00000931 "      }"
NSQ_SOURCE_LINE 00000932 ""
NSQ_SOURCE_LINE 00000933 "      # in this loop we read data until we either found and parsed the"
NSQ_SOURCE_LINE 00000934 "      # separating \",\" between elements, or the final \"]\""
NSQ_SOURCE_LINE 00000935 "      for (;;) {"
NSQ_SOURCE_LINE 00000936 "         # first skip whitespace"
NSQ_SOURCE_LINE 00000937 "         $json->incr_text =~ s/^\\s*//;"
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "         # if we find \"]\", we are done"
NSQ_SOURCE_LINE 00000940 "         if ($json->incr_text =~ s/^\\]//) {"
NSQ_SOURCE_LINE 00000941 "            print \"finished.\\n\";"
NSQ_SOURCE_LINE 00000942 "            exit;"
NSQ_SOURCE_LINE 00000943 "         }"
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 "         # if we find \",\", we can continue with the next element"
NSQ_SOURCE_LINE 00000946 "         if ($json->incr_text =~ s/^,//) {"
NSQ_SOURCE_LINE 00000947 "            last;"
NSQ_SOURCE_LINE 00000948 "         }"
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "         # if we find anything else, we have a parse error!"
NSQ_SOURCE_LINE 00000951 "         if (length $json->incr_text) {"
NSQ_SOURCE_LINE 00000952 "            die \"parse error near \", $json->incr_text;"
NSQ_SOURCE_LINE 00000953 "         }"
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 "         # else add more data"
NSQ_SOURCE_LINE 00000956 "         sysread $fh, my $buf, 65536"
NSQ_SOURCE_LINE 00000957 "            or die \"read error: $!\";"
NSQ_SOURCE_LINE 00000958 "         $json->incr_parse ($buf); # void context, so no parsing"
NSQ_SOURCE_LINE 00000959 "      }"
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "This is a complex example, but most of the complexity comes from the fact"
NSQ_SOURCE_LINE 00000962 "that we are trying to be correct (bear with me if I am wrong, I never ran"
NSQ_SOURCE_LINE 00000963 "the above example :)."
NSQ_SOURCE_LINE 00000964 ""
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 ""
NSQ_SOURCE_LINE 00000967 "=head1 MAPPING"
NSQ_SOURCE_LINE 00000968 ""
NSQ_SOURCE_LINE 00000969 "This section describes how JSON::XS maps Perl values to JSON values and"
NSQ_SOURCE_LINE 00000970 "vice versa. These mappings are designed to \"do the right thing\" in most"
NSQ_SOURCE_LINE 00000971 "circumstances automatically, preserving round-tripping characteristics"
NSQ_SOURCE_LINE 00000972 "(what you put in comes out as something equivalent)."
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "For the more enlightened: note that in the following descriptions,"
NSQ_SOURCE_LINE 00000975 "lowercase I<perl> refers to the Perl interpreter, while uppercase I<Perl>"
NSQ_SOURCE_LINE 00000976 "refers to the abstract Perl language itself."
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "=head2 JSON -> PERL"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "=over"
NSQ_SOURCE_LINE 00000982 ""
NSQ_SOURCE_LINE 00000983 "=item object"
NSQ_SOURCE_LINE 00000984 ""
NSQ_SOURCE_LINE 00000985 "A JSON object becomes a reference to a hash in Perl. No ordering of object"
NSQ_SOURCE_LINE 00000986 "keys is preserved (JSON does not preserve object key ordering itself)."
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 "=item array"
NSQ_SOURCE_LINE 00000989 ""
NSQ_SOURCE_LINE 00000990 "A JSON array becomes a reference to an array in Perl."
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "=item string"
NSQ_SOURCE_LINE 00000993 ""
NSQ_SOURCE_LINE 00000994 "A JSON string becomes a string scalar in Perl - Unicode codepoints in JSON"
NSQ_SOURCE_LINE 00000995 "are represented by the same codepoints in the Perl string, so no manual"
NSQ_SOURCE_LINE 00000996 "decoding is necessary."
NSQ_SOURCE_LINE 00000997 ""
NSQ_SOURCE_LINE 00000998 "=item number"
NSQ_SOURCE_LINE 00000999 ""
NSQ_SOURCE_LINE 00001000 "A JSON number becomes either an integer, numeric (floating point) or"
NSQ_SOURCE_LINE 00001001 "string scalar in perl, depending on its range and any fractional parts. On"
NSQ_SOURCE_LINE 00001002 "the Perl level, there is no difference between those as Perl handles all"
NSQ_SOURCE_LINE 00001003 "the conversion details, but an integer may take slightly less memory and"
NSQ_SOURCE_LINE 00001004 "might represent more values exactly than floating point numbers."
NSQ_SOURCE_LINE 00001005 ""
NSQ_SOURCE_LINE 00001006 "If the number consists of digits only, JSON::XS will try to represent"
NSQ_SOURCE_LINE 00001007 "it as an integer value. If that fails, it will try to represent it as"
NSQ_SOURCE_LINE 00001008 "a numeric (floating point) value if that is possible without loss of"
NSQ_SOURCE_LINE 00001009 "precision. Otherwise it will preserve the number as a string value (in"
NSQ_SOURCE_LINE 00001010 "which case you lose roundtripping ability, as the JSON number will be"
NSQ_SOURCE_LINE 00001011 "re-encoded to a JSON string)."
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "Numbers containing a fractional or exponential part will always be"
NSQ_SOURCE_LINE 00001014 "represented as numeric (floating point) values, possibly at a loss of"
NSQ_SOURCE_LINE 00001015 "precision (in which case you might lose perfect roundtripping ability, but"
NSQ_SOURCE_LINE 00001016 "the JSON number will still be re-encoded as a JSON number)."
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "Note that precision is not accuracy - binary floating point values cannot"
NSQ_SOURCE_LINE 00001019 "represent most decimal fractions exactly, and when converting from and to"
NSQ_SOURCE_LINE 00001020 "floating point, JSON::XS only guarantees precision up to but not including"
NSQ_SOURCE_LINE 00001021 "the least significant bit."
NSQ_SOURCE_LINE 00001022 ""
NSQ_SOURCE_LINE 00001023 "=item true, false"
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "These JSON atoms become C<Types::Serialiser::true> and"
NSQ_SOURCE_LINE 00001026 "C<Types::Serialiser::false>, respectively. They are overloaded to act"
NSQ_SOURCE_LINE 00001027 "almost exactly like the numbers C<1> and C<0>. You can check whether"
NSQ_SOURCE_LINE 00001028 "a scalar is a JSON boolean by using the C<Types::Serialiser::is_bool>"
NSQ_SOURCE_LINE 00001029 "function (after C<use Types::Serialier>, of course)."
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "=item null"
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 "A JSON null atom becomes C<undef> in Perl."
NSQ_SOURCE_LINE 00001034 ""
NSQ_SOURCE_LINE 00001035 "=item shell-style comments (C<< # I<text> >>)"
NSQ_SOURCE_LINE 00001036 ""
NSQ_SOURCE_LINE 00001037 "As a nonstandard extension to the JSON syntax that is enabled by the"
NSQ_SOURCE_LINE 00001038 "C<relaxed> setting, shell-style comments are allowed. They can start"
NSQ_SOURCE_LINE 00001039 "anywhere outside strings and go till the end of the line."
NSQ_SOURCE_LINE 00001040 ""
NSQ_SOURCE_LINE 00001041 "=item tagged values (C<< (I<tag>)I<value> >>)."
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "Another nonstandard extension to the JSON syntax, enabled with the"
NSQ_SOURCE_LINE 00001044 "C<allow_tags> setting, are tagged values. In this implementation, the"
NSQ_SOURCE_LINE 00001045 "I<tag> must be a perl package/class name encoded as a JSON string, and the"
NSQ_SOURCE_LINE 00001046 "I<value> must be a JSON array encoding optional constructor arguments."
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "See L<OBJECT SERIALISATION>, below, for details."
NSQ_SOURCE_LINE 00001049 ""
NSQ_SOURCE_LINE 00001050 "=back"
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 ""
NSQ_SOURCE_LINE 00001053 "=head2 PERL -> JSON"
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 "The mapping from Perl to JSON is slightly more difficult, as Perl is a"
NSQ_SOURCE_LINE 00001056 "truly typeless language, so we can only guess which JSON type is meant by"
NSQ_SOURCE_LINE 00001057 "a Perl value."
NSQ_SOURCE_LINE 00001058 ""
NSQ_SOURCE_LINE 00001059 "=over"
NSQ_SOURCE_LINE 00001060 ""
NSQ_SOURCE_LINE 00001061 "=item hash references"
NSQ_SOURCE_LINE 00001062 ""
NSQ_SOURCE_LINE 00001063 "Perl hash references become JSON objects. As there is no inherent"
NSQ_SOURCE_LINE 00001064 "ordering in hash keys (or JSON objects), they will usually be encoded"
NSQ_SOURCE_LINE 00001065 "in a pseudo-random order. JSON::XS can optionally sort the hash keys"
NSQ_SOURCE_LINE 00001066 "(determined by the I<canonical> flag), so the same datastructure will"
NSQ_SOURCE_LINE 00001067 "serialise to the same JSON text (given same settings and version of"
NSQ_SOURCE_LINE 00001068 "JSON::XS), but this incurs a runtime overhead and is only rarely useful,"
NSQ_SOURCE_LINE 00001069 "e.g. when you want to compare some JSON text against another for equality."
NSQ_SOURCE_LINE 00001070 ""
NSQ_SOURCE_LINE 00001071 "=item array references"
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "Perl array references become JSON arrays."
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "=item other references"
NSQ_SOURCE_LINE 00001076 ""
NSQ_SOURCE_LINE 00001077 "Other unblessed references are generally not allowed and will cause an"
NSQ_SOURCE_LINE 00001078 "exception to be thrown, except for references to the integers C<0> and"
NSQ_SOURCE_LINE 00001079 "C<1>, which get turned into C<false> and C<true> atoms in JSON."
NSQ_SOURCE_LINE 00001080 ""
NSQ_SOURCE_LINE 00001081 "Since C<JSON::XS> uses the boolean model from L<Types::Serialiser>, you"
NSQ_SOURCE_LINE 00001082 "can also C<use Types::Serialiser> and then use C<Types::Serialiser::false>"
NSQ_SOURCE_LINE 00001083 "and C<Types::Serialiser::true> to improve readability."
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "   use Types::Serialiser;"
NSQ_SOURCE_LINE 00001086 "   encode_json [\\0, Types::Serialiser::true]      # yields [false,true]"
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "=item Types::Serialiser::true, Types::Serialiser::false"
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "These special values from the L<Types::Serialiser> module become JSON true"
NSQ_SOURCE_LINE 00001091 "and JSON false values, respectively. You can also use C<\\1> and C<\\0>"
NSQ_SOURCE_LINE 00001092 "directly if you want."
NSQ_SOURCE_LINE 00001093 ""
NSQ_SOURCE_LINE 00001094 "=item blessed objects"
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 "Blessed objects are not directly representable in JSON, but C<JSON::XS>"
NSQ_SOURCE_LINE 00001097 "allows various ways of handling objects. See L<OBJECT SERIALISATION>,"
NSQ_SOURCE_LINE 00001098 "below, for details."
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "=item simple scalars"
NSQ_SOURCE_LINE 00001101 ""
NSQ_SOURCE_LINE 00001102 "Simple Perl scalars (any scalar that is not a reference) are the most"
NSQ_SOURCE_LINE 00001103 "difficult objects to encode: JSON::XS will encode undefined scalars as"
NSQ_SOURCE_LINE 00001104 "JSON C<null> values, scalars that have last been used in a string context"
NSQ_SOURCE_LINE 00001105 "before encoding as JSON strings, and anything else as number value:"
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 "   # dump as number"
NSQ_SOURCE_LINE 00001108 "   encode_json [2]                      # yields [2]"
NSQ_SOURCE_LINE 00001109 "   encode_json [-3.0e17]                # yields [-3e+17]"
NSQ_SOURCE_LINE 00001110 "   my $value = 5; encode_json [$value]  # yields [5]"
NSQ_SOURCE_LINE 00001111 ""
NSQ_SOURCE_LINE 00001112 "   # used as string, so dump as string"
NSQ_SOURCE_LINE 00001113 "   print $value;"
NSQ_SOURCE_LINE 00001114 "   encode_json [$value]                 # yields [\"5\"]"
NSQ_SOURCE_LINE 00001115 ""
NSQ_SOURCE_LINE 00001116 "   # undef becomes null"
NSQ_SOURCE_LINE 00001117 "   encode_json [undef]                  # yields [null]"
NSQ_SOURCE_LINE 00001118 ""
NSQ_SOURCE_LINE 00001119 "You can force the type to be a JSON string by stringifying it:"
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 "   my $x = 3.1; # some variable containing a number"
NSQ_SOURCE_LINE 00001122 "   \"$x\";        # stringified"
NSQ_SOURCE_LINE 00001123 "   $x .= \"\";    # another, more awkward way to stringify"
NSQ_SOURCE_LINE 00001124 "   print $x;    # perl does it for you, too, quite often"
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "You can force the type to be a JSON number by numifying it:"
NSQ_SOURCE_LINE 00001127 ""
NSQ_SOURCE_LINE 00001128 "   my $x = \"3\"; # some variable containing a string"
NSQ_SOURCE_LINE 00001129 "   $x += 0;     # numify it, ensuring it will be dumped as a number"
NSQ_SOURCE_LINE 00001130 "   $x *= 1;     # same thing, the choice is yours."
NSQ_SOURCE_LINE 00001131 ""
NSQ_SOURCE_LINE 00001132 "You can not currently force the type in other, less obscure, ways. Tell me"
NSQ_SOURCE_LINE 00001133 "if you need this capability (but don't forget to explain why it's needed"
NSQ_SOURCE_LINE 00001134 ":)."
NSQ_SOURCE_LINE 00001135 ""
NSQ_SOURCE_LINE 00001136 "Note that numerical precision has the same meaning as under Perl (so"
NSQ_SOURCE_LINE 00001137 "binary to decimal conversion follows the same rules as in Perl, which"
NSQ_SOURCE_LINE 00001138 "can differ to other languages). Also, your perl interpreter might expose"
NSQ_SOURCE_LINE 00001139 "extensions to the floating point numbers of your platform, such as"
NSQ_SOURCE_LINE 00001140 "infinities or NaN's - these cannot be represented in JSON, and it is an"
NSQ_SOURCE_LINE 00001141 "error to pass those in."
NSQ_SOURCE_LINE 00001142 ""
NSQ_SOURCE_LINE 00001143 "=back"
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "=head2 OBJECT SERIALISATION"
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 "As JSON cannot directly represent Perl objects, you have to choose between"
NSQ_SOURCE_LINE 00001148 "a pure JSON representation (without the ability to deserialise the object"
NSQ_SOURCE_LINE 00001149 "automatically again), and a nonstandard extension to the JSON syntax,"
NSQ_SOURCE_LINE 00001150 "tagged values."
NSQ_SOURCE_LINE 00001151 ""
NSQ_SOURCE_LINE 00001152 "=head3 SERIALISATION"
NSQ_SOURCE_LINE 00001153 ""
NSQ_SOURCE_LINE 00001154 "What happens when C<JSON::XS> encounters a Perl object depends on the"
NSQ_SOURCE_LINE 00001155 "C<allow_blessed>, C<convert_blessed> and C<allow_tags> settings, which are"
NSQ_SOURCE_LINE 00001156 "used in this order:"
NSQ_SOURCE_LINE 00001157 ""
NSQ_SOURCE_LINE 00001158 "=over"
NSQ_SOURCE_LINE 00001159 ""
NSQ_SOURCE_LINE 00001160 "=item 1. C<allow_tags> is enabled and the object has a C<FREEZE> method."
NSQ_SOURCE_LINE 00001161 ""
NSQ_SOURCE_LINE 00001162 "In this case, C<JSON::XS> uses the L<Types::Serialiser> object"
NSQ_SOURCE_LINE 00001163 "serialisation protocol to create a tagged JSON value, using a nonstandard"
NSQ_SOURCE_LINE 00001164 "extension to the JSON syntax."
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 "This works by invoking the C<FREEZE> method on the object, with the first"
NSQ_SOURCE_LINE 00001167 "argument being the object to serialise, and the second argument being the"
NSQ_SOURCE_LINE 00001168 "constant string C<JSON> to distinguish it from other serialisers."
NSQ_SOURCE_LINE 00001169 ""
NSQ_SOURCE_LINE 00001170 "The C<FREEZE> method can return any number of values (i.e. zero or"
NSQ_SOURCE_LINE 00001171 "more). These values and the paclkage/classname of the object will then be"
NSQ_SOURCE_LINE 00001172 "encoded as a tagged JSON value in the following format:"
NSQ_SOURCE_LINE 00001173 ""
NSQ_SOURCE_LINE 00001174 "   (\"classname\")[FREEZE return values...]"
NSQ_SOURCE_LINE 00001175 ""
NSQ_SOURCE_LINE 00001176 "e.g.:"
NSQ_SOURCE_LINE 00001177 ""
NSQ_SOURCE_LINE 00001178 "   (\"URI\")[\"http://www.google.com/\"]"
NSQ_SOURCE_LINE 00001179 "   (\"MyDate\")[2013,10,29]"
NSQ_SOURCE_LINE 00001180 "   (\"ImageData::JPEG\")[\"Z3...VlCg==\"]"
NSQ_SOURCE_LINE 00001181 ""
NSQ_SOURCE_LINE 00001182 "For example, the hypothetical C<My::Object> C<FREEZE> method might use the"
NSQ_SOURCE_LINE 00001183 "objects C<type> and C<id> members to encode the object:"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "   sub My::Object::FREEZE {"
NSQ_SOURCE_LINE 00001186 "      my ($self, $serialiser) = @_;"
NSQ_SOURCE_LINE 00001187 ""
NSQ_SOURCE_LINE 00001188 "      ($self->{type}, $self->{id})"
NSQ_SOURCE_LINE 00001189 "   }"
NSQ_SOURCE_LINE 00001190 ""
NSQ_SOURCE_LINE 00001191 "=item 2. C<convert_blessed> is enabled and the object has a C<TO_JSON> method."
NSQ_SOURCE_LINE 00001192 ""
NSQ_SOURCE_LINE 00001193 "In this case, the C<TO_JSON> method of the object is invoked in scalar"
NSQ_SOURCE_LINE 00001194 "context. It must return a single scalar that can be directly encoded into"
NSQ_SOURCE_LINE 00001195 "JSON. This scalar replaces the object in the JSON text."
NSQ_SOURCE_LINE 00001196 ""
NSQ_SOURCE_LINE 00001197 "For example, the following C<TO_JSON> method will convert all L<URI>"
NSQ_SOURCE_LINE 00001198 "objects to JSON strings when serialised. The fact that these values"
NSQ_SOURCE_LINE 00001199 "originally were L<URI> objects is lost."
NSQ_SOURCE_LINE 00001200 ""
NSQ_SOURCE_LINE 00001201 "   sub URI::TO_JSON {"
NSQ_SOURCE_LINE 00001202 "      my ($uri) = @_;"
NSQ_SOURCE_LINE 00001203 "      $uri->as_string"
NSQ_SOURCE_LINE 00001204 "   }"
NSQ_SOURCE_LINE 00001205 ""
NSQ_SOURCE_LINE 00001206 "=item 3. C<allow_blessed> is enabled."
NSQ_SOURCE_LINE 00001207 ""
NSQ_SOURCE_LINE 00001208 "The object will be serialised as a JSON null value."
NSQ_SOURCE_LINE 00001209 ""
NSQ_SOURCE_LINE 00001210 "=item 4. none of the above"
NSQ_SOURCE_LINE 00001211 ""
NSQ_SOURCE_LINE 00001212 "If none of the settings are enabled or the respective methods are missing,"
NSQ_SOURCE_LINE 00001213 "C<JSON::XS> throws an exception."
NSQ_SOURCE_LINE 00001214 ""
NSQ_SOURCE_LINE 00001215 "=back"
NSQ_SOURCE_LINE 00001216 ""
NSQ_SOURCE_LINE 00001217 "=head3 DESERIALISATION"
NSQ_SOURCE_LINE 00001218 ""
NSQ_SOURCE_LINE 00001219 "For deserialisation there are only two cases to consider: either"
NSQ_SOURCE_LINE 00001220 "nonstandard tagging was used, in which case C<allow_tags> decides,"
NSQ_SOURCE_LINE 00001221 "or objects cannot be automatically be deserialised, in which"
NSQ_SOURCE_LINE 00001222 "case you can use postprocessing or the C<filter_json_object> or"
NSQ_SOURCE_LINE 00001223 "C<filter_json_single_key_object> callbacks to get some real objects our of"
NSQ_SOURCE_LINE 00001224 "your JSON."
NSQ_SOURCE_LINE 00001225 ""
NSQ_SOURCE_LINE 00001226 "This section only considers the tagged value case: I a tagged JSON object"
NSQ_SOURCE_LINE 00001227 "is encountered during decoding and C<allow_tags> is disabled, a parse"
NSQ_SOURCE_LINE 00001228 "error will result (as if tagged values were not part of the grammar)."
NSQ_SOURCE_LINE 00001229 ""
NSQ_SOURCE_LINE 00001230 "If C<allow_tags> is enabled, C<JSON::XS> will look up the C<THAW> method"
NSQ_SOURCE_LINE 00001231 "of the package/classname used during serialisation (it will not attempt"
NSQ_SOURCE_LINE 00001232 "to load the package as a Perl module). If there is no such method, the"
NSQ_SOURCE_LINE 00001233 "decoding will fail with an error."
NSQ_SOURCE_LINE 00001234 ""
NSQ_SOURCE_LINE 00001235 "Otherwise, the C<THAW> method is invoked with the classname as first"
NSQ_SOURCE_LINE 00001236 "argument, the constant string C<JSON> as second argument, and all the"
NSQ_SOURCE_LINE 00001237 "values from the JSON array (the values originally returned by the"
NSQ_SOURCE_LINE 00001238 "C<FREEZE> method) as remaining arguments."
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "The method must then return the object. While technically you can return"
NSQ_SOURCE_LINE 00001241 "any Perl scalar, you might have to enable the C<enable_nonref> setting to"
NSQ_SOURCE_LINE 00001242 "make that work in all cases, so better return an actual blessed reference."
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "As an example, let's implement a C<THAW> function that regenerates the"
NSQ_SOURCE_LINE 00001245 "C<My::Object> from the C<FREEZE> example earlier:"
NSQ_SOURCE_LINE 00001246 ""
NSQ_SOURCE_LINE 00001247 "   sub My::Object::THAW {"
NSQ_SOURCE_LINE 00001248 "      my ($class, $serialiser, $type, $id) = @_;"
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "      $class->new (type => $type, id => $id)"
NSQ_SOURCE_LINE 00001251 "   }"
NSQ_SOURCE_LINE 00001252 ""
NSQ_SOURCE_LINE 00001253 ""
NSQ_SOURCE_LINE 00001254 "=head1 ENCODING/CODESET FLAG NOTES"
NSQ_SOURCE_LINE 00001255 ""
NSQ_SOURCE_LINE 00001256 "The interested reader might have seen a number of flags that signify"
NSQ_SOURCE_LINE 00001257 "encodings or codesets - C<utf8>, C<latin1> and C<ascii>. There seems to be"
NSQ_SOURCE_LINE 00001258 "some confusion on what these do, so here is a short comparison:"
NSQ_SOURCE_LINE 00001259 ""
NSQ_SOURCE_LINE 00001260 "C<utf8> controls whether the JSON text created by C<encode> (and expected"
NSQ_SOURCE_LINE 00001261 "by C<decode>) is UTF-8 encoded or not, while C<latin1> and C<ascii> only"
NSQ_SOURCE_LINE 00001262 "control whether C<encode> escapes character values outside their respective"
NSQ_SOURCE_LINE 00001263 "codeset range. Neither of these flags conflict with each other, although"
NSQ_SOURCE_LINE 00001264 "some combinations make less sense than others."
NSQ_SOURCE_LINE 00001265 ""
NSQ_SOURCE_LINE 00001266 "Care has been taken to make all flags symmetrical with respect to"
NSQ_SOURCE_LINE 00001267 "C<encode> and C<decode>, that is, texts encoded with any combination of"
NSQ_SOURCE_LINE 00001268 "these flag values will be correctly decoded when the same flags are used"
NSQ_SOURCE_LINE 00001269 "- in general, if you use different flag settings while encoding vs. when"
NSQ_SOURCE_LINE 00001270 "decoding you likely have a bug somewhere."
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 "Below comes a verbose discussion of these flags. Note that a \"codeset\" is"
NSQ_SOURCE_LINE 00001273 "simply an abstract set of character-codepoint pairs, while an encoding"
NSQ_SOURCE_LINE 00001274 "takes those codepoint numbers and I<encodes> them, in our case into"
NSQ_SOURCE_LINE 00001275 "octets. Unicode is (among other things) a codeset, UTF-8 is an encoding,"
NSQ_SOURCE_LINE 00001276 "and ISO-8859-1 (= latin 1) and ASCII are both codesets I<and> encodings at"
NSQ_SOURCE_LINE 00001277 "the same time, which can be confusing."
NSQ_SOURCE_LINE 00001278 ""
NSQ_SOURCE_LINE 00001279 "=over"
NSQ_SOURCE_LINE 00001280 ""
NSQ_SOURCE_LINE 00001281 "=item C<utf8> flag disabled"
NSQ_SOURCE_LINE 00001282 ""
NSQ_SOURCE_LINE 00001283 "When C<utf8> is disabled (the default), then C<encode>/C<decode> generate"
NSQ_SOURCE_LINE 00001284 "and expect Unicode strings, that is, characters with high ordinal Unicode"
NSQ_SOURCE_LINE 00001285 "values (> 255) will be encoded as such characters, and likewise such"
NSQ_SOURCE_LINE 00001286 "characters are decoded as-is, no changes to them will be done, except"
NSQ_SOURCE_LINE 00001287 "\"(re-)interpreting\" them as Unicode codepoints or Unicode characters,"
NSQ_SOURCE_LINE 00001288 "respectively (to Perl, these are the same thing in strings unless you do"
NSQ_SOURCE_LINE 00001289 "funny/weird/dumb stuff)."
NSQ_SOURCE_LINE 00001290 ""
NSQ_SOURCE_LINE 00001291 "This is useful when you want to do the encoding yourself (e.g. when you"
NSQ_SOURCE_LINE 00001292 "want to have UTF-16 encoded JSON texts) or when some other layer does"
NSQ_SOURCE_LINE 00001293 "the encoding for you (for example, when printing to a terminal using a"
NSQ_SOURCE_LINE 00001294 "filehandle that transparently encodes to UTF-8 you certainly do NOT want"
NSQ_SOURCE_LINE 00001295 "to UTF-8 encode your data first and have Perl encode it another time)."
NSQ_SOURCE_LINE 00001296 ""
NSQ_SOURCE_LINE 00001297 "=item C<utf8> flag enabled"
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "If the C<utf8>-flag is enabled, C<encode>/C<decode> will encode all"
NSQ_SOURCE_LINE 00001300 "characters using the corresponding UTF-8 multi-byte sequence, and will"
NSQ_SOURCE_LINE 00001301 "expect your input strings to be encoded as UTF-8, that is, no \"character\""
NSQ_SOURCE_LINE 00001302 "of the input string must have any value > 255, as UTF-8 does not allow"
NSQ_SOURCE_LINE 00001303 "that."
NSQ_SOURCE_LINE 00001304 ""
NSQ_SOURCE_LINE 00001305 "The C<utf8> flag therefore switches between two modes: disabled means you"
NSQ_SOURCE_LINE 00001306 "will get a Unicode string in Perl, enabled means you get a UTF-8 encoded"
NSQ_SOURCE_LINE 00001307 "octet/binary string in Perl."
NSQ_SOURCE_LINE 00001308 ""
NSQ_SOURCE_LINE 00001309 "=item C<latin1> or C<ascii> flags enabled"
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 "With C<latin1> (or C<ascii>) enabled, C<encode> will escape characters"
NSQ_SOURCE_LINE 00001312 "with ordinal values > 255 (> 127 with C<ascii>) and encode the remaining"
NSQ_SOURCE_LINE 00001313 "characters as specified by the C<utf8> flag."
NSQ_SOURCE_LINE 00001314 ""
NSQ_SOURCE_LINE 00001315 "If C<utf8> is disabled, then the result is also correctly encoded in those"
NSQ_SOURCE_LINE 00001316 "character sets (as both are proper subsets of Unicode, meaning that a"
NSQ_SOURCE_LINE 00001317 "Unicode string with all character values < 256 is the same thing as a"
NSQ_SOURCE_LINE 00001318 "ISO-8859-1 string, and a Unicode string with all character values < 128 is"
NSQ_SOURCE_LINE 00001319 "the same thing as an ASCII string in Perl)."
NSQ_SOURCE_LINE 00001320 ""
NSQ_SOURCE_LINE 00001321 "If C<utf8> is enabled, you still get a correct UTF-8-encoded string,"
NSQ_SOURCE_LINE 00001322 "regardless of these flags, just some more characters will be escaped using"
NSQ_SOURCE_LINE 00001323 "C<\\uXXXX> then before."
NSQ_SOURCE_LINE 00001324 ""
NSQ_SOURCE_LINE 00001325 "Note that ISO-8859-1-I<encoded> strings are not compatible with UTF-8"
NSQ_SOURCE_LINE 00001326 "encoding, while ASCII-encoded strings are. That is because the ISO-8859-1"
NSQ_SOURCE_LINE 00001327 "encoding is NOT a subset of UTF-8 (despite the ISO-8859-1 I<codeset> being"
NSQ_SOURCE_LINE 00001328 "a subset of Unicode), while ASCII is."
NSQ_SOURCE_LINE 00001329 ""
NSQ_SOURCE_LINE 00001330 "Surprisingly, C<decode> will ignore these flags and so treat all input"
NSQ_SOURCE_LINE 00001331 "values as governed by the C<utf8> flag. If it is disabled, this allows you"
NSQ_SOURCE_LINE 00001332 "to decode ISO-8859-1- and ASCII-encoded strings, as both strict subsets of"
NSQ_SOURCE_LINE 00001333 "Unicode. If it is enabled, you can correctly decode UTF-8 encoded strings."
NSQ_SOURCE_LINE 00001334 ""
NSQ_SOURCE_LINE 00001335 "So neither C<latin1> nor C<ascii> are incompatible with the C<utf8> flag -"
NSQ_SOURCE_LINE 00001336 "they only govern when the JSON output engine escapes a character or not."
NSQ_SOURCE_LINE 00001337 ""
NSQ_SOURCE_LINE 00001338 "The main use for C<latin1> is to relatively efficiently store binary data"
NSQ_SOURCE_LINE 00001339 "as JSON, at the expense of breaking compatibility with most JSON decoders."
NSQ_SOURCE_LINE 00001340 ""
NSQ_SOURCE_LINE 00001341 "The main use for C<ascii> is to force the output to not contain characters"
NSQ_SOURCE_LINE 00001342 "with values > 127, which means you can interpret the resulting string"
NSQ_SOURCE_LINE 00001343 "as UTF-8, ISO-8859-1, ASCII, KOI8-R or most about any character set and"
NSQ_SOURCE_LINE 00001344 "8-bit-encoding, and still get the same data structure back. This is useful"
NSQ_SOURCE_LINE 00001345 "when your channel for JSON transfer is not 8-bit clean or the encoding"
NSQ_SOURCE_LINE 00001346 "might be mangled in between (e.g. in mail), and works because ASCII is a"
NSQ_SOURCE_LINE 00001347 "proper subset of most 8-bit and multibyte encodings in use in the world."
NSQ_SOURCE_LINE 00001348 ""
NSQ_SOURCE_LINE 00001349 "=back"
NSQ_SOURCE_LINE 00001350 ""
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "=head2 JSON and ECMAscript"
NSQ_SOURCE_LINE 00001353 ""
NSQ_SOURCE_LINE 00001354 "JSON syntax is based on how literals are represented in javascript (the"
NSQ_SOURCE_LINE 00001355 "not-standardised predecessor of ECMAscript) which is presumably why it is"
NSQ_SOURCE_LINE 00001356 "called \"JavaScript Object Notation\"."
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 "However, JSON is not a subset (and also not a superset of course) of"
NSQ_SOURCE_LINE 00001359 "ECMAscript (the standard) or javascript (whatever browsers actually"
NSQ_SOURCE_LINE 00001360 "implement)."
NSQ_SOURCE_LINE 00001361 ""
NSQ_SOURCE_LINE 00001362 "If you want to use javascript's C<eval> function to \"parse\" JSON, you"
NSQ_SOURCE_LINE 00001363 "might run into parse errors for valid JSON texts, or the resulting data"
NSQ_SOURCE_LINE 00001364 "structure might not be queryable:"
NSQ_SOURCE_LINE 00001365 ""
NSQ_SOURCE_LINE 00001366 "One of the problems is that U+2028 and U+2029 are valid characters inside"
NSQ_SOURCE_LINE 00001367 "JSON strings, but are not allowed in ECMAscript string literals, so the"
NSQ_SOURCE_LINE 00001368 "following Perl fragment will not output something that can be guaranteed"
NSQ_SOURCE_LINE 00001369 "to be parsable by javascript's C<eval>:"
NSQ_SOURCE_LINE 00001370 ""
NSQ_SOURCE_LINE 00001371 "   use JSON::XS;"
NSQ_SOURCE_LINE 00001372 ""
NSQ_SOURCE_LINE 00001373 "   print encode_json [chr 0x2028];"
NSQ_SOURCE_LINE 00001374 ""
NSQ_SOURCE_LINE 00001375 "The right fix for this is to use a proper JSON parser in your javascript"
NSQ_SOURCE_LINE 00001376 "programs, and not rely on C<eval> (see for example Douglas Crockford's"
NSQ_SOURCE_LINE 00001377 "F<json2.js> parser)."
NSQ_SOURCE_LINE 00001378 ""
NSQ_SOURCE_LINE 00001379 "If this is not an option, you can, as a stop-gap measure, simply encode to"
NSQ_SOURCE_LINE 00001380 "ASCII-only JSON:"
NSQ_SOURCE_LINE 00001381 ""
NSQ_SOURCE_LINE 00001382 "   use JSON::XS;"
NSQ_SOURCE_LINE 00001383 ""
NSQ_SOURCE_LINE 00001384 "   print JSON::XS->new->ascii->encode ([chr 0x2028]);"
NSQ_SOURCE_LINE 00001385 ""
NSQ_SOURCE_LINE 00001386 "Note that this will enlarge the resulting JSON text quite a bit if you"
NSQ_SOURCE_LINE 00001387 "have many non-ASCII characters. You might be tempted to run some regexes"
NSQ_SOURCE_LINE 00001388 "to only escape U+2028 and U+2029, e.g.:"
NSQ_SOURCE_LINE 00001389 ""
NSQ_SOURCE_LINE 00001390 "   # DO NOT USE THIS!"
NSQ_SOURCE_LINE 00001391 "   my $json = JSON::XS->new->utf8->encode ([chr 0x2028]);"
NSQ_SOURCE_LINE 00001392 "   $json =~ s/\\xe2\\x80\\xa8/\\\\u2028/g; # escape U+2028"
NSQ_SOURCE_LINE 00001393 "   $json =~ s/\\xe2\\x80\\xa9/\\\\u2029/g; # escape U+2029"
NSQ_SOURCE_LINE 00001394 "   print $json;"
NSQ_SOURCE_LINE 00001395 ""
NSQ_SOURCE_LINE 00001396 "Note that I<this is a bad idea>: the above only works for U+2028 and"
NSQ_SOURCE_LINE 00001397 "U+2029 and thus only for fully ECMAscript-compliant parsers. Many existing"
NSQ_SOURCE_LINE 00001398 "javascript implementations, however, have issues with other characters as"
NSQ_SOURCE_LINE 00001399 "well - using C<eval> naively simply I<will> cause problems."
NSQ_SOURCE_LINE 00001400 ""
NSQ_SOURCE_LINE 00001401 "Another problem is that some javascript implementations reserve"
NSQ_SOURCE_LINE 00001402 "some property names for their own purposes (which probably makes"
NSQ_SOURCE_LINE 00001403 "them non-ECMAscript-compliant). For example, Iceweasel reserves the"
NSQ_SOURCE_LINE 00001404 "C<__proto__> property name for its own purposes."
NSQ_SOURCE_LINE 00001405 ""
NSQ_SOURCE_LINE 00001406 "If that is a problem, you could parse try to filter the resulting JSON"
NSQ_SOURCE_LINE 00001407 "output for these property strings, e.g.:"
NSQ_SOURCE_LINE 00001408 ""
NSQ_SOURCE_LINE 00001409 "   $json =~ s/\"__proto__\"\\s*:/\"__proto__renamed\":/g;"
NSQ_SOURCE_LINE 00001410 ""
NSQ_SOURCE_LINE 00001411 "This works because C<__proto__> is not valid outside of strings, so every"
NSQ_SOURCE_LINE 00001412 "occurrence of C<\"__proto__\"\\s*:> must be a string used as property name."
NSQ_SOURCE_LINE 00001413 ""
NSQ_SOURCE_LINE 00001414 "If you know of other incompatibilities, please let me know."
NSQ_SOURCE_LINE 00001415 ""
NSQ_SOURCE_LINE 00001416 ""
NSQ_SOURCE_LINE 00001417 "=head2 JSON and YAML"
NSQ_SOURCE_LINE 00001418 ""
NSQ_SOURCE_LINE 00001419 "You often hear that JSON is a subset of YAML. This is, however, a mass"
NSQ_SOURCE_LINE 00001420 "hysteria(*) and very far from the truth (as of the time of this writing),"
NSQ_SOURCE_LINE 00001421 "so let me state it clearly: I<in general, there is no way to configure"
NSQ_SOURCE_LINE 00001422 "JSON::XS to output a data structure as valid YAML> that works in all"
NSQ_SOURCE_LINE 00001423 "cases."
NSQ_SOURCE_LINE 00001424 ""
NSQ_SOURCE_LINE 00001425 "If you really must use JSON::XS to generate YAML, you should use this"
NSQ_SOURCE_LINE 00001426 "algorithm (subject to change in future versions):"
NSQ_SOURCE_LINE 00001427 ""
NSQ_SOURCE_LINE 00001428 "   my $to_yaml = JSON::XS->new->utf8->space_after (1);"
NSQ_SOURCE_LINE 00001429 "   my $yaml = $to_yaml->encode ($ref) . \"\\n\";"
NSQ_SOURCE_LINE 00001430 ""
NSQ_SOURCE_LINE 00001431 "This will I<usually> generate JSON texts that also parse as valid"
NSQ_SOURCE_LINE 00001432 "YAML. Please note that YAML has hardcoded limits on (simple) object key"
NSQ_SOURCE_LINE 00001433 "lengths that JSON doesn't have and also has different and incompatible"
NSQ_SOURCE_LINE 00001434 "unicode character escape syntax, so you should make sure that your hash"
NSQ_SOURCE_LINE 00001435 "keys are noticeably shorter than the 1024 \"stream characters\" YAML allows"
NSQ_SOURCE_LINE 00001436 "and that you do not have characters with codepoint values outside the"
NSQ_SOURCE_LINE 00001437 "Unicode BMP (basic multilingual page). YAML also does not allow C<\\/>"
NSQ_SOURCE_LINE 00001438 "sequences in strings (which JSON::XS does not I<currently> generate, but"
NSQ_SOURCE_LINE 00001439 "other JSON generators might)."
NSQ_SOURCE_LINE 00001440 ""
NSQ_SOURCE_LINE 00001441 "There might be other incompatibilities that I am not aware of (or the YAML"
NSQ_SOURCE_LINE 00001442 "specification has been changed yet again - it does so quite often). In"
NSQ_SOURCE_LINE 00001443 "general you should not try to generate YAML with a JSON generator or vice"
NSQ_SOURCE_LINE 00001444 "versa, or try to parse JSON with a YAML parser or vice versa: chances are"
NSQ_SOURCE_LINE 00001445 "high that you will run into severe interoperability problems when you"
NSQ_SOURCE_LINE 00001446 "least expect it."
NSQ_SOURCE_LINE 00001447 ""
NSQ_SOURCE_LINE 00001448 "=over"
NSQ_SOURCE_LINE 00001449 ""
NSQ_SOURCE_LINE 00001450 "=item (*)"
NSQ_SOURCE_LINE 00001451 ""
NSQ_SOURCE_LINE 00001452 "I have been pressured multiple times by Brian Ingerson (one of the"
NSQ_SOURCE_LINE 00001453 "authors of the YAML specification) to remove this paragraph, despite him"
NSQ_SOURCE_LINE 00001454 "acknowledging that the actual incompatibilities exist. As I was personally"
NSQ_SOURCE_LINE 00001455 "bitten by this \"JSON is YAML\" lie, I refused and said I will continue to"
NSQ_SOURCE_LINE 00001456 "educate people about these issues, so others do not run into the same"
NSQ_SOURCE_LINE 00001457 "problem again and again. After this, Brian called me a (quote)I<complete"
NSQ_SOURCE_LINE 00001458 "and worthless idiot>(unquote)."
NSQ_SOURCE_LINE 00001459 ""
NSQ_SOURCE_LINE 00001460 "In my opinion, instead of pressuring and insulting people who actually"
NSQ_SOURCE_LINE 00001461 "clarify issues with YAML and the wrong statements of some of its"
NSQ_SOURCE_LINE 00001462 "proponents, I would kindly suggest reading the JSON spec (which is not"
NSQ_SOURCE_LINE 00001463 "that difficult or long) and finally make YAML compatible to it, and"
NSQ_SOURCE_LINE 00001464 "educating users about the changes, instead of spreading lies about the"
NSQ_SOURCE_LINE 00001465 "real compatibility for many I<years> and trying to silence people who"
NSQ_SOURCE_LINE 00001466 "point out that it isn't true."
NSQ_SOURCE_LINE 00001467 ""
NSQ_SOURCE_LINE 00001468 "Addendum/2009: the YAML 1.2 spec is still incompatible with JSON, even"
NSQ_SOURCE_LINE 00001469 "though the incompatibilities have been documented (and are known to Brian)"
NSQ_SOURCE_LINE 00001470 "for many years and the spec makes explicit claims that YAML is a superset"
NSQ_SOURCE_LINE 00001471 "of JSON. It would be so easy to fix, but apparently, bullying people and"
NSQ_SOURCE_LINE 00001472 "corrupting userdata is so much easier."
NSQ_SOURCE_LINE 00001473 ""
NSQ_SOURCE_LINE 00001474 "=back"
NSQ_SOURCE_LINE 00001475 ""
NSQ_SOURCE_LINE 00001476 ""
NSQ_SOURCE_LINE 00001477 "=head2 SPEED"
NSQ_SOURCE_LINE 00001478 ""
NSQ_SOURCE_LINE 00001479 "It seems that JSON::XS is surprisingly fast, as shown in the following"
NSQ_SOURCE_LINE 00001480 "tables. They have been generated with the help of the C<eg/bench> program"
NSQ_SOURCE_LINE 00001481 "in the JSON::XS distribution, to make it easy to compare on your own"
NSQ_SOURCE_LINE 00001482 "system."
NSQ_SOURCE_LINE 00001483 ""
NSQ_SOURCE_LINE 00001484 "First comes a comparison between various modules using"
NSQ_SOURCE_LINE 00001485 "a very short single-line JSON string (also available at"
NSQ_SOURCE_LINE 00001486 "L<http://dist.schmorp.de/misc/json/short.json>)."
NSQ_SOURCE_LINE 00001487 ""
NSQ_SOURCE_LINE 00001488 "   {\"method\": \"handleMessage\", \"params\": [\"user1\","
NSQ_SOURCE_LINE 00001489 "   \"we were just talking\"], \"id\": null, \"array\":[1,11,234,-5,1e5,1e7,"
NSQ_SOURCE_LINE 00001490 "   1,  0]}"
NSQ_SOURCE_LINE 00001491 ""
NSQ_SOURCE_LINE 00001492 "It shows the number of encodes/decodes per second (JSON::XS uses"
NSQ_SOURCE_LINE 00001493 "the functional interface, while JSON::XS/2 uses the OO interface"
NSQ_SOURCE_LINE 00001494 "with pretty-printing and hashkey sorting enabled, JSON::XS/3 enables"
NSQ_SOURCE_LINE 00001495 "shrink. JSON::DWIW/DS uses the deserialise function, while JSON::DWIW::FJ"
NSQ_SOURCE_LINE 00001496 "uses the from_json method). Higher is better:"
NSQ_SOURCE_LINE 00001497 ""
NSQ_SOURCE_LINE 00001498 "   module        |     encode |     decode |"
NSQ_SOURCE_LINE 00001499 "   --------------|------------|------------|"
NSQ_SOURCE_LINE 00001500 "   JSON::DWIW/DS |  86302.551 | 102300.098 |"
NSQ_SOURCE_LINE 00001501 "   JSON::DWIW/FJ |  86302.551 |  75983.768 |"
NSQ_SOURCE_LINE 00001502 "   JSON::PP      |  15827.562 |   6638.658 |"
NSQ_SOURCE_LINE 00001503 "   JSON::Syck    |  63358.066 |  47662.545 |"
NSQ_SOURCE_LINE 00001504 "   JSON::XS      | 511500.488 | 511500.488 |"
NSQ_SOURCE_LINE 00001505 "   JSON::XS/2    | 291271.111 | 388361.481 |"
NSQ_SOURCE_LINE 00001506 "   JSON::XS/3    | 361577.931 | 361577.931 |"
NSQ_SOURCE_LINE 00001507 "   Storable      |  66788.280 | 265462.278 |"
NSQ_SOURCE_LINE 00001508 "   --------------+------------+------------+"
NSQ_SOURCE_LINE 00001509 ""
NSQ_SOURCE_LINE 00001510 "That is, JSON::XS is almost six times faster than JSON::DWIW on encoding,"
NSQ_SOURCE_LINE 00001511 "about five times faster on decoding, and over thirty to seventy times"
NSQ_SOURCE_LINE 00001512 "faster than JSON's pure perl implementation. It also compares favourably"
NSQ_SOURCE_LINE 00001513 "to Storable for small amounts of data."
NSQ_SOURCE_LINE 00001514 ""
NSQ_SOURCE_LINE 00001515 "Using a longer test string (roughly 18KB, generated from Yahoo! Locals"
NSQ_SOURCE_LINE 00001516 "search API (L<http://dist.schmorp.de/misc/json/long.json>)."
NSQ_SOURCE_LINE 00001517 ""
NSQ_SOURCE_LINE 00001518 "   module        |     encode |     decode |"
NSQ_SOURCE_LINE 00001519 "   --------------|------------|------------|"
NSQ_SOURCE_LINE 00001520 "   JSON::DWIW/DS |   1647.927 |   2673.916 |"
NSQ_SOURCE_LINE 00001521 "   JSON::DWIW/FJ |   1630.249 |   2596.128 |"
NSQ_SOURCE_LINE 00001522 "   JSON::PP      |    400.640 |     62.311 |"
NSQ_SOURCE_LINE 00001523 "   JSON::Syck    |   1481.040 |   1524.869 |"
NSQ_SOURCE_LINE 00001524 "   JSON::XS      |  20661.596 |   9541.183 |"
NSQ_SOURCE_LINE 00001525 "   JSON::XS/2    |  10683.403 |   9416.938 |"
NSQ_SOURCE_LINE 00001526 "   JSON::XS/3    |  20661.596 |   9400.054 |"
NSQ_SOURCE_LINE 00001527 "   Storable      |  19765.806 |  10000.725 |"
NSQ_SOURCE_LINE 00001528 "   --------------+------------+------------+"
NSQ_SOURCE_LINE 00001529 ""
NSQ_SOURCE_LINE 00001530 "Again, JSON::XS leads by far (except for Storable which non-surprisingly"
NSQ_SOURCE_LINE 00001531 "decodes a bit faster)."
NSQ_SOURCE_LINE 00001532 ""
NSQ_SOURCE_LINE 00001533 "On large strings containing lots of high Unicode characters, some modules"
NSQ_SOURCE_LINE 00001534 "(such as JSON::PC) seem to decode faster than JSON::XS, but the result"
NSQ_SOURCE_LINE 00001535 "will be broken due to missing (or wrong) Unicode handling. Others refuse"
NSQ_SOURCE_LINE 00001536 "to decode or encode properly, so it was impossible to prepare a fair"
NSQ_SOURCE_LINE 00001537 "comparison table for that case."
NSQ_SOURCE_LINE 00001538 ""
NSQ_SOURCE_LINE 00001539 ""
NSQ_SOURCE_LINE 00001540 "=head1 SECURITY CONSIDERATIONS"
NSQ_SOURCE_LINE 00001541 ""
NSQ_SOURCE_LINE 00001542 "When you are using JSON in a protocol, talking to untrusted potentially"
NSQ_SOURCE_LINE 00001543 "hostile creatures requires relatively few measures."
NSQ_SOURCE_LINE 00001544 ""
NSQ_SOURCE_LINE 00001545 "First of all, your JSON decoder should be secure, that is, should not have"
NSQ_SOURCE_LINE 00001546 "any buffer overflows. Obviously, this module should ensure that and I am"
NSQ_SOURCE_LINE 00001547 "trying hard on making that true, but you never know."
NSQ_SOURCE_LINE 00001548 ""
NSQ_SOURCE_LINE 00001549 "Second, you need to avoid resource-starving attacks. That means you should"
NSQ_SOURCE_LINE 00001550 "limit the size of JSON texts you accept, or make sure then when your"
NSQ_SOURCE_LINE 00001551 "resources run out, that's just fine (e.g. by using a separate process that"
NSQ_SOURCE_LINE 00001552 "can crash safely). The size of a JSON text in octets or characters is"
NSQ_SOURCE_LINE 00001553 "usually a good indication of the size of the resources required to decode"
NSQ_SOURCE_LINE 00001554 "it into a Perl structure. While JSON::XS can check the size of the JSON"
NSQ_SOURCE_LINE 00001555 "text, it might be too late when you already have it in memory, so you"
NSQ_SOURCE_LINE 00001556 "might want to check the size before you accept the string."
NSQ_SOURCE_LINE 00001557 ""
NSQ_SOURCE_LINE 00001558 "Third, JSON::XS recurses using the C stack when decoding objects and"
NSQ_SOURCE_LINE 00001559 "arrays. The C stack is a limited resource: for instance, on my amd64"
NSQ_SOURCE_LINE 00001560 "machine with 8MB of stack size I can decode around 180k nested arrays but"
NSQ_SOURCE_LINE 00001561 "only 14k nested JSON objects (due to perl itself recursing deeply on croak"
NSQ_SOURCE_LINE 00001562 "to free the temporary). If that is exceeded, the program crashes. To be"
NSQ_SOURCE_LINE 00001563 "conservative, the default nesting limit is set to 512. If your process"
NSQ_SOURCE_LINE 00001564 "has a smaller stack, you should adjust this setting accordingly with the"
NSQ_SOURCE_LINE 00001565 "C<max_depth> method."
NSQ_SOURCE_LINE 00001566 ""
NSQ_SOURCE_LINE 00001567 "Something else could bomb you, too, that I forgot to think of. In that"
NSQ_SOURCE_LINE 00001568 "case, you get to keep the pieces. I am always open for hints, though..."
NSQ_SOURCE_LINE 00001569 ""
NSQ_SOURCE_LINE 00001570 "Also keep in mind that JSON::XS might leak contents of your Perl data"
NSQ_SOURCE_LINE 00001571 "structures in its error messages, so when you serialise sensitive"
NSQ_SOURCE_LINE 00001572 "information you might want to make sure that exceptions thrown by JSON::XS"
NSQ_SOURCE_LINE 00001573 "will not end up in front of untrusted eyes."
NSQ_SOURCE_LINE 00001574 ""
NSQ_SOURCE_LINE 00001575 "If you are using JSON::XS to return packets to consumption"
NSQ_SOURCE_LINE 00001576 "by JavaScript scripts in a browser you should have a look at"
NSQ_SOURCE_LINE 00001577 "L<http://blog.archive.jpsykes.com/47/practical-csrf-and-json-security/> to"
NSQ_SOURCE_LINE 00001578 "see whether you are vulnerable to some common attack vectors (which really"
NSQ_SOURCE_LINE 00001579 "are browser design bugs, but it is still you who will have to deal with"
NSQ_SOURCE_LINE 00001580 "it, as major browser developers care only for features, not about getting"
NSQ_SOURCE_LINE 00001581 "security right)."
NSQ_SOURCE_LINE 00001582 ""
NSQ_SOURCE_LINE 00001583 ""
NSQ_SOURCE_LINE 00001584 "=head2 \"OLD\" VS. \"NEW\" JSON (RFC4627 VS. RFC7159)"
NSQ_SOURCE_LINE 00001585 ""
NSQ_SOURCE_LINE 00001586 "JSON originally required JSON texts to represent an array or object -"
NSQ_SOURCE_LINE 00001587 "scalar values were explicitly not allowed. This has changed, and versions"
NSQ_SOURCE_LINE 00001588 "of JSON::XS beginning with C<4.0> reflect this by allowing scalar values"
NSQ_SOURCE_LINE 00001589 "by default."
NSQ_SOURCE_LINE 00001590 ""
NSQ_SOURCE_LINE 00001591 "One reason why one might not want this is that this removes a fundamental"
NSQ_SOURCE_LINE 00001592 "property of JSON texts, namely that they are self-delimited and"
NSQ_SOURCE_LINE 00001593 "self-contained, or in other words, you could take any number of \"old\""
NSQ_SOURCE_LINE 00001594 "JSON texts and paste them together, and the result would be unambiguously"
NSQ_SOURCE_LINE 00001595 "parseable:"
NSQ_SOURCE_LINE 00001596 ""
NSQ_SOURCE_LINE 00001597 "   [1,3]{\"k\":5}[][null] # four JSON texts, without doubt"
NSQ_SOURCE_LINE 00001598 ""
NSQ_SOURCE_LINE 00001599 "By allowing scalars, this property is lost: in the following example, is"
NSQ_SOURCE_LINE 00001600 "this one JSON text (the number 12) or two JSON texts (the numbers 1 and"
NSQ_SOURCE_LINE 00001601 "2):"
NSQ_SOURCE_LINE 00001602 ""
NSQ_SOURCE_LINE 00001603 "   12    # could be 12, or 1 and 2"
NSQ_SOURCE_LINE 00001604 ""
NSQ_SOURCE_LINE 00001605 "Another lost property of \"old\" JSON is that no lookahead is required to"
NSQ_SOURCE_LINE 00001606 "know the end of a JSON text, i.e. the JSON text definitely ended at the"
NSQ_SOURCE_LINE 00001607 "last C<]> or C<}> character, there was no need to read extra characters."
NSQ_SOURCE_LINE 00001608 ""
NSQ_SOURCE_LINE 00001609 "For example, a viable network protocol with \"old\" JSON was to simply"
NSQ_SOURCE_LINE 00001610 "exchange JSON texts without delimiter. For \"new\" JSON, you have to use a"
NSQ_SOURCE_LINE 00001611 "suitable delimiter (such as a newline) after every JSON text or ensure you"
NSQ_SOURCE_LINE 00001612 "never encode/decode scalar values."
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "Most protocols do work by only transferring arrays or objects, and the"
NSQ_SOURCE_LINE 00001615 "easiest way to avoid problems with the \"new\" JSON definition is to"
NSQ_SOURCE_LINE 00001616 "explicitly disallow scalar values in your encoder and decoder:"
NSQ_SOURCE_LINE 00001617 ""
NSQ_SOURCE_LINE 00001618 "   $json_coder = JSON::XS->new->allow_nonref (0)"
NSQ_SOURCE_LINE 00001619 ""
NSQ_SOURCE_LINE 00001620 "This is a somewhat unhappy situation, and the blame can fully be put on"
NSQ_SOURCE_LINE 00001621 "JSON's inventor, Douglas Crockford, who unilaterally changed the format"
NSQ_SOURCE_LINE 00001622 "in 2006 without consulting the IETF, forcing the IETF to either fork the"
NSQ_SOURCE_LINE 00001623 "format or go with it (as I was told, the IETF wasn't amused)."
NSQ_SOURCE_LINE 00001624 ""
NSQ_SOURCE_LINE 00001625 ""
NSQ_SOURCE_LINE 00001626 "=head1 RELATIONSHIP WITH I-JSON"
NSQ_SOURCE_LINE 00001627 ""
NSQ_SOURCE_LINE 00001628 "JSON is a somewhat sloppily-defined format - it carries around obvious"
NSQ_SOURCE_LINE 00001629 "Javascript baggage, such as not really defining number range, probably"
NSQ_SOURCE_LINE 00001630 "because Javascript only has one type of numbers: IEEE 64 bit floats"
NSQ_SOURCE_LINE 00001631 "(\"binary64\")."
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "For this reaosn, RFC7493 defines \"Internet JSON\", which is a restricted"
NSQ_SOURCE_LINE 00001634 "subset of JSON that is supposedly more interoperable on the internet."
NSQ_SOURCE_LINE 00001635 ""
NSQ_SOURCE_LINE 00001636 "While C<JSON::XS> does not offer specific support for I-JSON, it of course"
NSQ_SOURCE_LINE 00001637 "accepts valid I-JSON and by default implements some of the limitations"
NSQ_SOURCE_LINE 00001638 "of I-JSON, such as parsing numbers as perl numbers, which are usually a"
NSQ_SOURCE_LINE 00001639 "superset of binary64 numbers."
NSQ_SOURCE_LINE 00001640 ""
NSQ_SOURCE_LINE 00001641 "To generate I-JSON, follow these rules:"
NSQ_SOURCE_LINE 00001642 ""
NSQ_SOURCE_LINE 00001643 "=over"
NSQ_SOURCE_LINE 00001644 ""
NSQ_SOURCE_LINE 00001645 "=item * always generate UTF-8"
NSQ_SOURCE_LINE 00001646 ""
NSQ_SOURCE_LINE 00001647 "I-JSON must be encoded in UTF-8, the default for C<encode_json>."
NSQ_SOURCE_LINE 00001648 ""
NSQ_SOURCE_LINE 00001649 "=item * numbers should be within IEEE 754 binary64 range"
NSQ_SOURCE_LINE 00001650 ""
NSQ_SOURCE_LINE 00001651 "Basically all existing perl installations use binary64 to represent"
NSQ_SOURCE_LINE 00001652 "floating point numbers, so all you need to do is to avoid large integers."
NSQ_SOURCE_LINE 00001653 ""
NSQ_SOURCE_LINE 00001654 "=item * objects must not have duplicate keys"
NSQ_SOURCE_LINE 00001655 ""
NSQ_SOURCE_LINE 00001656 "This is trivially done, as C<JSON::XS> does not allow duplicate keys."
NSQ_SOURCE_LINE 00001657 ""
NSQ_SOURCE_LINE 00001658 "=item * do not generate scalar JSON texts, use C<< ->allow_nonref (0) >>"
NSQ_SOURCE_LINE 00001659 ""
NSQ_SOURCE_LINE 00001660 "I-JSON strongly requests you to only encode arrays and objects into JSON."
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "=item * times should be strings in ISO 8601 format"
NSQ_SOURCE_LINE 00001663 ""
NSQ_SOURCE_LINE 00001664 "There are a myriad of modules on CPAN dealing with ISO 8601 - search for"
NSQ_SOURCE_LINE 00001665 "C<ISO8601> on CPAN and use one."
NSQ_SOURCE_LINE 00001666 ""
NSQ_SOURCE_LINE 00001667 "=item * encode binary data as base64"
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 "While it's tempting to just dump binary data as a string (and let"
NSQ_SOURCE_LINE 00001670 "C<JSON::XS> do the escaping), for I-JSON, it's I<recommended> to encode"
NSQ_SOURCE_LINE 00001671 "binary data as base64."
NSQ_SOURCE_LINE 00001672 ""
NSQ_SOURCE_LINE 00001673 "=back"
NSQ_SOURCE_LINE 00001674 ""
NSQ_SOURCE_LINE 00001675 "There are some other considerations - read RFC7493 for the details if"
NSQ_SOURCE_LINE 00001676 "interested."
NSQ_SOURCE_LINE 00001677 ""
NSQ_SOURCE_LINE 00001678 ""
NSQ_SOURCE_LINE 00001679 "=head1 INTEROPERABILITY WITH OTHER MODULES"
NSQ_SOURCE_LINE 00001680 ""
NSQ_SOURCE_LINE 00001681 "C<JSON::XS> uses the L<Types::Serialiser> module to provide boolean"
NSQ_SOURCE_LINE 00001682 "constants. That means that the JSON true and false values will be"
NSQ_SOURCE_LINE 00001683 "compatible to true and false values of other modules that do the same,"
NSQ_SOURCE_LINE 00001684 "such as L<JSON::PP> and L<CBOR::XS>."
NSQ_SOURCE_LINE 00001685 ""
NSQ_SOURCE_LINE 00001686 ""
NSQ_SOURCE_LINE 00001687 "=head1 INTEROPERABILITY WITH OTHER JSON DECODERS"
NSQ_SOURCE_LINE 00001688 ""
NSQ_SOURCE_LINE 00001689 "As long as you only serialise data that can be directly expressed in JSON,"
NSQ_SOURCE_LINE 00001690 "C<JSON::XS> is incapable of generating invalid JSON output (modulo bugs,"
NSQ_SOURCE_LINE 00001691 "but C<JSON::XS> has found more bugs in the official JSON testsuite (1)"
NSQ_SOURCE_LINE 00001692 "than the official JSON testsuite has found in C<JSON::XS> (0))."
NSQ_SOURCE_LINE 00001693 ""
NSQ_SOURCE_LINE 00001694 "When you have trouble decoding JSON generated by this module using other"
NSQ_SOURCE_LINE 00001695 "decoders, then it is very likely that you have an encoding mismatch or the"
NSQ_SOURCE_LINE 00001696 "other decoder is broken."
NSQ_SOURCE_LINE 00001697 ""
NSQ_SOURCE_LINE 00001698 "When decoding, C<JSON::XS> is strict by default and will likely catch all"
NSQ_SOURCE_LINE 00001699 "errors. There are currently two settings that change this: C<relaxed>"
NSQ_SOURCE_LINE 00001700 "makes C<JSON::XS> accept (but not generate) some non-standard extensions,"
NSQ_SOURCE_LINE 00001701 "and C<allow_tags> will allow you to encode and decode Perl objects, at the"
NSQ_SOURCE_LINE 00001702 "cost of not outputting valid JSON anymore."
NSQ_SOURCE_LINE 00001703 ""
NSQ_SOURCE_LINE 00001704 "=head2 TAGGED VALUE SYNTAX AND STANDARD JSON EN/DECODERS"
NSQ_SOURCE_LINE 00001705 ""
NSQ_SOURCE_LINE 00001706 "When you use C<allow_tags> to use the extended (and also nonstandard and"
NSQ_SOURCE_LINE 00001707 "invalid) JSON syntax for serialised objects, and you still want to decode"
NSQ_SOURCE_LINE 00001708 "the generated text with a standard JSON decoder, you can run a regex to"
NSQ_SOURCE_LINE 00001709 "replace the tagged syntax by standard JSON arrays (it only works for"
NSQ_SOURCE_LINE 00001710 "\"normal\" package names without comma, newlines or single colons). First,"
NSQ_SOURCE_LINE 00001711 "the readable Perl version:"
NSQ_SOURCE_LINE 00001712 ""
NSQ_SOURCE_LINE 00001713 "   # if your FREEZE methods return no values, you need this replace first:"
NSQ_SOURCE_LINE 00001714 "   $json =~ s/\\( \\s* (\" (?: [^\\\\\":,]+|\\\\.|::)* \") \\s* \\) \\s* \\[\\s*\\]/[$1]/gx;"
NSQ_SOURCE_LINE 00001715 ""
NSQ_SOURCE_LINE 00001716 "   # this works for non-empty constructor arg lists:"
NSQ_SOURCE_LINE 00001717 "   $json =~ s/\\( \\s* (\" (?: [^\\\\\":,]+|\\\\.|::)* \") \\s* \\) \\s* \\[/[$1,/gx;"
NSQ_SOURCE_LINE 00001718 ""
NSQ_SOURCE_LINE 00001719 "And here is a less readable version that is easy to adapt to other"
NSQ_SOURCE_LINE 00001720 "languages:"
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "   $json =~ s/\\(\\s*(\"([^\\\\\":,]+|\\\\.|::)*\")\\s*\\)\\s*\\[/[$1,/g;"
NSQ_SOURCE_LINE 00001723 ""
NSQ_SOURCE_LINE 00001724 "Here is an ECMAScript version (same regex):"
NSQ_SOURCE_LINE 00001725 ""
NSQ_SOURCE_LINE 00001726 "   json = json.replace (/\\(\\s*(\"([^\\\\\":,]+|\\\\.|::)*\")\\s*\\)\\s*\\[/g, \"[$1,\");"
NSQ_SOURCE_LINE 00001727 ""
NSQ_SOURCE_LINE 00001728 "Since this syntax converts to standard JSON arrays, it might be hard to"
NSQ_SOURCE_LINE 00001729 "distinguish serialised objects from normal arrays. You can prepend a"
NSQ_SOURCE_LINE 00001730 "\"magic number\" as first array element to reduce chances of a collision:"
NSQ_SOURCE_LINE 00001731 ""
NSQ_SOURCE_LINE 00001732 "   $json =~ s/\\(\\s*(\"([^\\\\\":,]+|\\\\.|::)*\")\\s*\\)\\s*\\[/[\"XU1peReLzT4ggEllLanBYq4G9VzliwKF\",$1,/g;"
NSQ_SOURCE_LINE 00001733 ""
NSQ_SOURCE_LINE 00001734 "And after decoding the JSON text, you could walk the data"
NSQ_SOURCE_LINE 00001735 "structure looking for arrays with a first element of"
NSQ_SOURCE_LINE 00001736 "C<XU1peReLzT4ggEllLanBYq4G9VzliwKF>."
NSQ_SOURCE_LINE 00001737 ""
NSQ_SOURCE_LINE 00001738 "The same approach can be used to create the tagged format with another"
NSQ_SOURCE_LINE 00001739 "encoder. First, you create an array with the magic string as first member,"
NSQ_SOURCE_LINE 00001740 "the classname as second, and constructor arguments last, encode it as part"
NSQ_SOURCE_LINE 00001741 "of your JSON structure, and then:"
NSQ_SOURCE_LINE 00001742 ""
NSQ_SOURCE_LINE 00001743 "   $json =~ s/\\[\\s*\"XU1peReLzT4ggEllLanBYq4G9VzliwKF\"\\s*,\\s*(\"([^\\\\\":,]+|\\\\.|::)*\")\\s*,/($1)[/g;"
NSQ_SOURCE_LINE 00001744 ""
NSQ_SOURCE_LINE 00001745 "Again, this has some limitations - the magic string must not be encoded"
NSQ_SOURCE_LINE 00001746 "with character escapes, and the constructor arguments must be non-empty."
NSQ_SOURCE_LINE 00001747 ""
NSQ_SOURCE_LINE 00001748 ""
NSQ_SOURCE_LINE 00001749 "=head1 (I-)THREADS"
NSQ_SOURCE_LINE 00001750 ""
NSQ_SOURCE_LINE 00001751 "This module is I<not> guaranteed to be ithread (or MULTIPLICITY-) safe"
NSQ_SOURCE_LINE 00001752 "and there are no plans to change this. Note that perl's builtin so-called"
NSQ_SOURCE_LINE 00001753 "threads/ithreads are officially deprecated and should not be used."
NSQ_SOURCE_LINE 00001754 ""
NSQ_SOURCE_LINE 00001755 ""
NSQ_SOURCE_LINE 00001756 "=head1 THE PERILS OF SETLOCALE"
NSQ_SOURCE_LINE 00001757 ""
NSQ_SOURCE_LINE 00001758 "Sometimes people avoid the Perl locale support and directly call the"
NSQ_SOURCE_LINE 00001759 "system's setlocale function with C<LC_ALL>."
NSQ_SOURCE_LINE 00001760 ""
NSQ_SOURCE_LINE 00001761 "This breaks both perl and modules such as JSON::XS, as stringification of"
NSQ_SOURCE_LINE 00001762 "numbers no longer works correctly (e.g. C<$x = 0.1; print \"$x\"+1> might"
NSQ_SOURCE_LINE 00001763 "print C<1>, and JSON::XS might output illegal JSON as JSON::XS relies on"
NSQ_SOURCE_LINE 00001764 "perl to stringify numbers)."
NSQ_SOURCE_LINE 00001765 ""
NSQ_SOURCE_LINE 00001766 "The solution is simple: don't call C<setlocale>, or use it for only those"
NSQ_SOURCE_LINE 00001767 "categories you need, such as C<LC_MESSAGES> or C<LC_CTYPE>."
NSQ_SOURCE_LINE 00001768 ""
NSQ_SOURCE_LINE 00001769 "If you need C<LC_NUMERIC>, you should enable it only around the code that"
NSQ_SOURCE_LINE 00001770 "actually needs it (avoiding stringification of numbers), and restore it"
NSQ_SOURCE_LINE 00001771 "afterwards."
NSQ_SOURCE_LINE 00001772 ""
NSQ_SOURCE_LINE 00001773 ""
NSQ_SOURCE_LINE 00001774 "=head1 SOME HISTORY"
NSQ_SOURCE_LINE 00001775 ""
NSQ_SOURCE_LINE 00001776 "At the time this module was created there already were a number of JSON"
NSQ_SOURCE_LINE 00001777 "modules available on CPAN, so what was the reason to write yet another"
NSQ_SOURCE_LINE 00001778 "JSON module? While it seems there are many JSON modules, none of them"
NSQ_SOURCE_LINE 00001779 "correctly handled all corner cases, and in most cases their maintainers"
NSQ_SOURCE_LINE 00001780 "are unresponsive, gone missing, or not listening to bug reports for other"
NSQ_SOURCE_LINE 00001781 "reasons."
NSQ_SOURCE_LINE 00001782 ""
NSQ_SOURCE_LINE 00001783 "Beginning with version 2.0 of the JSON module, when both JSON and"
NSQ_SOURCE_LINE 00001784 "JSON::XS are installed, then JSON will fall back on JSON::XS (this can be"
NSQ_SOURCE_LINE 00001785 "overridden) with no overhead due to emulation (by inheriting constructor"
NSQ_SOURCE_LINE 00001786 "and methods). If JSON::XS is not available, it will fall back to the"
NSQ_SOURCE_LINE 00001787 "compatible JSON::PP module as backend, so using JSON instead of JSON::XS"
NSQ_SOURCE_LINE 00001788 "gives you a portable JSON API that can be fast when you need it and"
NSQ_SOURCE_LINE 00001789 "doesn't require a C compiler when that is a problem."
NSQ_SOURCE_LINE 00001790 ""
NSQ_SOURCE_LINE 00001791 "Somewhere around version 3, this module was forked into"
NSQ_SOURCE_LINE 00001792 "C<Cpanel::JSON::XS>, because its maintainer had serious trouble"
NSQ_SOURCE_LINE 00001793 "understanding JSON and insisted on a fork with many bugs \"fixed\" that"
NSQ_SOURCE_LINE 00001794 "weren't actually bugs, while spreading FUD about this module without"
NSQ_SOURCE_LINE 00001795 "actually giving any details on his accusations. You be the judge, but"
NSQ_SOURCE_LINE 00001796 "in my personal opinion, if you want quality, you will stay away from"
NSQ_SOURCE_LINE 00001797 "dangerous forks like that."
NSQ_SOURCE_LINE 00001798 ""
NSQ_SOURCE_LINE 00001799 ""
NSQ_SOURCE_LINE 00001800 "=head1 BUGS"
NSQ_SOURCE_LINE 00001801 ""
NSQ_SOURCE_LINE 00001802 "While the goal of this module is to be correct, that unfortunately does"
NSQ_SOURCE_LINE 00001803 "not mean it's bug-free, only that I think its design is bug-free. If you"
NSQ_SOURCE_LINE 00001804 "keep reporting bugs they will be fixed swiftly, though."
NSQ_SOURCE_LINE 00001805 ""
NSQ_SOURCE_LINE 00001806 "Please refrain from using rt.cpan.org or any other bug reporting"
NSQ_SOURCE_LINE 00001807 "service. I put the contact address into my modules for a reason."
NSQ_SOURCE_LINE 00001808 ""
NSQ_SOURCE_LINE 00001809 "=cut"
NSQ_SOURCE_LINE 00001810 ""
NSQ_SOURCE_LINE 00001811 "BEGIN {"
NSQ_SOURCE_LINE 00001812 "   *true    = \\$Types::Serialiser::true;"
NSQ_SOURCE_LINE 00001813 "   *true    = \\&Types::Serialiser::true;"
NSQ_SOURCE_LINE 00001814 "   *false   = \\$Types::Serialiser::false;"
NSQ_SOURCE_LINE 00001815 "   *false   = \\&Types::Serialiser::false;"
NSQ_SOURCE_LINE 00001816 "   *is_bool = \\&Types::Serialiser::is_bool;"
NSQ_SOURCE_LINE 00001817 ""
NSQ_SOURCE_LINE 00001818 "   *JSON::XS::Boolean:: = *Types::Serialiser::Boolean::;"
NSQ_SOURCE_LINE 00001819 "}"
NSQ_SOURCE_LINE 00001820 ""
NSQ_SOURCE_LINE 00001821 "XSLoader::load \"JSON::XS\", $VERSION;"
NSQ_SOURCE_LINE 00001822 ""
NSQ_SOURCE_LINE 00001823 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00001824 ""
NSQ_SOURCE_LINE 00001825 "The F<json_xs> command line utility for quick experiments."
NSQ_SOURCE_LINE 00001826 ""
NSQ_SOURCE_LINE 00001827 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00001828 ""
NSQ_SOURCE_LINE 00001829 " Marc Lehmann <schmorp@schmorp.de>"
NSQ_SOURCE_LINE 00001830 " http://home.schmorp.de/"
NSQ_SOURCE_LINE 00001831 ""
NSQ_SOURCE_LINE 00001832 "=cut"
NSQ_SOURCE_LINE 00001833 ""
NSQ_SOURCE_LINE 00001834 "1"
NSQ_SOURCE_LINE 00001835 ""
BODY_END
