BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Devel::OverloadInfo;"
NSQ_SOURCE_LINE 00000002 "$Devel::OverloadInfo::VERSION = '0.008';"
NSQ_SOURCE_LINE 00000003 "# ABSTRACT: introspect overloaded operators"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "#pod =head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000006 "#pod"
NSQ_SOURCE_LINE 00000007 "#pod Devel::OverloadInfo returns information about L<overloaded|overload>"
NSQ_SOURCE_LINE 00000008 "#pod operators for a given class (or object), including where in the"
NSQ_SOURCE_LINE 00000009 "#pod inheritance hierarchy the overloads are declared and where the code"
NSQ_SOURCE_LINE 00000010 "#pod implementing them is."
NSQ_SOURCE_LINE 00000011 "#pod"
NSQ_SOURCE_LINE 00000012 "#pod =cut"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "use strict;"
NSQ_SOURCE_LINE 00000015 "use warnings;"
NSQ_SOURCE_LINE 00000016 "use overload ();"
NSQ_SOURCE_LINE 00000017 "use Scalar::Util qw(blessed);"
NSQ_SOURCE_LINE 00000018 "use Package::Stash 0.14;"
NSQ_SOURCE_LINE 00000019 "use MRO::Compat;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "BEGIN {"
NSQ_SOURCE_LINE 00000022 "    if (eval { require Sub::Util } && defined &Sub::Util::subname) {"
NSQ_SOURCE_LINE 00000023 "        *subname = \\&Sub::Util::subname;"
NSQ_SOURCE_LINE 00000024 "    }"
NSQ_SOURCE_LINE 00000025 "    else {"
NSQ_SOURCE_LINE 00000026 "        require B;"
NSQ_SOURCE_LINE 00000027 "        *subname = sub {"
NSQ_SOURCE_LINE 00000028 "            my ($coderef) = @_;"
NSQ_SOURCE_LINE 00000029 "            die 'Not a subroutine reference'"
NSQ_SOURCE_LINE 00000030 "                unless ref $coderef;"
NSQ_SOURCE_LINE 00000031 "            my $cv = B::svref_2object($coderef);"
NSQ_SOURCE_LINE 00000032 "            die 'Not a subroutine reference'"
NSQ_SOURCE_LINE 00000033 "                unless $cv->isa('B::CV');"
NSQ_SOURCE_LINE 00000034 "            my $gv = $cv->GV;"
NSQ_SOURCE_LINE 00000035 "            return undef"
NSQ_SOURCE_LINE 00000036 "                if $gv->isa('B::SPECIAL');"
NSQ_SOURCE_LINE 00000037 "            my $stash = $gv->STASH;"
NSQ_SOURCE_LINE 00000038 "            my $package = $stash->isa('B::SPECIAL') ? '__ANON__' : $stash->NAME;"
NSQ_SOURCE_LINE 00000039 "            return $package . '::' . $gv->NAME;"
NSQ_SOURCE_LINE 00000040 "        };"
NSQ_SOURCE_LINE 00000041 "    }"
NSQ_SOURCE_LINE 00000042 "}"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "use Exporter 5.57 qw(import);"
NSQ_SOURCE_LINE 00000046 "our @EXPORT_OK = qw(overload_info overload_op_info is_overloaded);"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "sub stash_with_symbol {"
NSQ_SOURCE_LINE 00000049 "    my ($class, $symbol) = @_;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    for my $package (@{mro::get_linear_isa($class)}) {"
NSQ_SOURCE_LINE 00000052 "        my $stash = Package::Stash->new($package);"
NSQ_SOURCE_LINE 00000053 "        my $value_ref = $stash->get_symbol($symbol);"
NSQ_SOURCE_LINE 00000054 "        return ($stash, $value_ref) if $value_ref;"
NSQ_SOURCE_LINE 00000055 "    }"
NSQ_SOURCE_LINE 00000056 "    return;"
NSQ_SOURCE_LINE 00000057 "}"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "#pod =func is_overloaded"
NSQ_SOURCE_LINE 00000060 "#pod"
NSQ_SOURCE_LINE 00000061 "#pod    if (is_overloaded($class_or_object)) { ... }"
NSQ_SOURCE_LINE 00000062 "#pod"
NSQ_SOURCE_LINE 00000063 "#pod Returns a boolean indicating whether the given class or object has any"
NSQ_SOURCE_LINE 00000064 "#pod overloading declared.  Note that a bare C<use overload;> with no"
NSQ_SOURCE_LINE 00000065 "#pod actual operators counts as being overloaded."
NSQ_SOURCE_LINE 00000066 "#pod"
NSQ_SOURCE_LINE 00000067 "#pod Equivalent to"
NSQ_SOURCE_LINE 00000068 "#pod L<overload::Overloaded()|overload/overload::Overloaded(arg)>, but"
NSQ_SOURCE_LINE 00000069 "#pod doesn't trigger various bugs associated with it in versions of perl"
NSQ_SOURCE_LINE 00000070 "#pod before 5.16."
NSQ_SOURCE_LINE 00000071 "#pod"
NSQ_SOURCE_LINE 00000072 "#pod =cut"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub is_overloaded {"
NSQ_SOURCE_LINE 00000075 "    my $class = blessed($_[0]) || $_[0];"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    # Perl before 5.16 seems to corrupt inherited overload info if"
NSQ_SOURCE_LINE 00000078 "    # there's a lone dereference overload and overload::Overloaded()"
NSQ_SOURCE_LINE 00000079 "    # is called before any object has been blessed into the class."
NSQ_SOURCE_LINE 00000080 "    return !!(\"$]\" >= 5.016"
NSQ_SOURCE_LINE 00000081 "        ? overload::Overloaded($class)"
NSQ_SOURCE_LINE 00000082 "        : stash_with_symbol($class, '&()')"
NSQ_SOURCE_LINE 00000083 "    );"
NSQ_SOURCE_LINE 00000084 "}"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "#pod =func overload_op_info"
NSQ_SOURCE_LINE 00000087 "#pod"
NSQ_SOURCE_LINE 00000088 "#pod     my $info = overload_op_info($class_or_object, $op);"
NSQ_SOURCE_LINE 00000089 "#pod"
NSQ_SOURCE_LINE 00000090 "#pod Returns a hash reference with information about the specified"
NSQ_SOURCE_LINE 00000091 "#pod overloaded operator of the named class or blessed object."
NSQ_SOURCE_LINE 00000092 "#pod"
NSQ_SOURCE_LINE 00000093 "#pod Returns C<undef> if the operator is not overloaded."
NSQ_SOURCE_LINE 00000094 "#pod"
NSQ_SOURCE_LINE 00000095 "#pod See L<overload/Overloadable Operations> for the available operators."
NSQ_SOURCE_LINE 00000096 "#pod"
NSQ_SOURCE_LINE 00000097 "#pod The keys in the returned hash are as follows:"
NSQ_SOURCE_LINE 00000098 "#pod"
NSQ_SOURCE_LINE 00000099 "#pod =over"
NSQ_SOURCE_LINE 00000100 "#pod"
NSQ_SOURCE_LINE 00000101 "#pod =item class"
NSQ_SOURCE_LINE 00000102 "#pod"
NSQ_SOURCE_LINE 00000103 "#pod The name of the class in which the operator overloading was declared."
NSQ_SOURCE_LINE 00000104 "#pod"
NSQ_SOURCE_LINE 00000105 "#pod =item code"
NSQ_SOURCE_LINE 00000106 "#pod"
NSQ_SOURCE_LINE 00000107 "#pod A reference to the function implementing the overloaded operator."
NSQ_SOURCE_LINE 00000108 "#pod"
NSQ_SOURCE_LINE 00000109 "#pod =item code_name"
NSQ_SOURCE_LINE 00000110 "#pod"
NSQ_SOURCE_LINE 00000111 "#pod The fully qualified name of the function implementing the overloaded operator."
NSQ_SOURCE_LINE 00000112 "#pod"
NSQ_SOURCE_LINE 00000113 "#pod =item method_name (optional)"
NSQ_SOURCE_LINE 00000114 "#pod"
NSQ_SOURCE_LINE 00000115 "#pod The name of the method implementing the overloaded operator, if the"
NSQ_SOURCE_LINE 00000116 "#pod overloading was specified as a named method, e.g. C<< use overload $op"
NSQ_SOURCE_LINE 00000117 "#pod => 'method'; >>."
NSQ_SOURCE_LINE 00000118 "#pod"
NSQ_SOURCE_LINE 00000119 "#pod =item code_class (optional)"
NSQ_SOURCE_LINE 00000120 "#pod"
NSQ_SOURCE_LINE 00000121 "#pod The name of the class in which the method specified by C<method_name>"
NSQ_SOURCE_LINE 00000122 "#pod was found."
NSQ_SOURCE_LINE 00000123 "#pod"
NSQ_SOURCE_LINE 00000124 "#pod =item value (optional)"
NSQ_SOURCE_LINE 00000125 "#pod"
NSQ_SOURCE_LINE 00000126 "#pod For the special C<fallback> key, the value it was given in C<class>."
NSQ_SOURCE_LINE 00000127 "#pod"
NSQ_SOURCE_LINE 00000128 "#pod =back"
NSQ_SOURCE_LINE 00000129 "#pod"
NSQ_SOURCE_LINE 00000130 "#pod =cut"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "sub overload_op_info {"
NSQ_SOURCE_LINE 00000133 "    my ($class, $op) = @_;"
NSQ_SOURCE_LINE 00000134 "    $class = blessed($class) || $class;"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "    return undef unless is_overloaded($class);"
NSQ_SOURCE_LINE 00000137 "    my $op_method = $op eq 'fallback' ? \"()\" : \"($op\";"
NSQ_SOURCE_LINE 00000138 "    my ($stash, $func) = stash_with_symbol($class, \"&$op_method\")"
NSQ_SOURCE_LINE 00000139 "        or return undef;"
NSQ_SOURCE_LINE 00000140 "    my $info = {"
NSQ_SOURCE_LINE 00000141 "        class => $stash->name,"
NSQ_SOURCE_LINE 00000142 "    };"
NSQ_SOURCE_LINE 00000143 "    if ($func == \\&overload::nil) {"
NSQ_SOURCE_LINE 00000144 "        # Named method or fallback, stored in the scalar slot"
NSQ_SOURCE_LINE 00000145 "        if (my $value_ref = $stash->get_symbol(\"\\$$op_method\")) {"
NSQ_SOURCE_LINE 00000146 "            my $value = $$value_ref;"
NSQ_SOURCE_LINE 00000147 "            if ($op eq 'fallback') {"
NSQ_SOURCE_LINE 00000148 "                $info->{value} = $value;"
NSQ_SOURCE_LINE 00000149 "            } else {"
NSQ_SOURCE_LINE 00000150 "                $info->{method_name} = $value;"
NSQ_SOURCE_LINE 00000151 "                if (my ($impl_stash, $impl_func) = stash_with_symbol($class, \"&$value\")) {"
NSQ_SOURCE_LINE 00000152 "                    $info->{code_class} = $impl_stash->name;"
NSQ_SOURCE_LINE 00000153 "                    $info->{code} = $impl_func;"
NSQ_SOURCE_LINE 00000154 "                }"
NSQ_SOURCE_LINE 00000155 "            }"
NSQ_SOURCE_LINE 00000156 "        }"
NSQ_SOURCE_LINE 00000157 "    } else {"
NSQ_SOURCE_LINE 00000158 "        $info->{code} = $func;"
NSQ_SOURCE_LINE 00000159 "    }"
NSQ_SOURCE_LINE 00000160 "    $info->{code_name} = subname($info->{code})"
NSQ_SOURCE_LINE 00000161 "        if exists $info->{code};"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    return $info;"
NSQ_SOURCE_LINE 00000164 "}"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "#pod =func overload_info"
NSQ_SOURCE_LINE 00000167 "#pod"
NSQ_SOURCE_LINE 00000168 "#pod     my $info = overload_info($class_or_object);"
NSQ_SOURCE_LINE 00000169 "#pod"
NSQ_SOURCE_LINE 00000170 "#pod Returns a hash reference with information about all the overloaded"
NSQ_SOURCE_LINE 00000171 "#pod operators of specified class name or blessed object.  The keys are the"
NSQ_SOURCE_LINE 00000172 "#pod overloaded operators, as specified in C<%overload::ops> (see"
NSQ_SOURCE_LINE 00000173 "#pod L<overload/Overloadable Operations>), and the values are the hashes"
NSQ_SOURCE_LINE 00000174 "#pod returned by L</overload_op_info>."
NSQ_SOURCE_LINE 00000175 "#pod"
NSQ_SOURCE_LINE 00000176 "#pod =cut"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "sub overload_info {"
NSQ_SOURCE_LINE 00000179 "    my $class = blessed($_[0]) || $_[0];"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "    return {} unless is_overloaded($class);"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    my (%overloaded);"
NSQ_SOURCE_LINE 00000184 "    for my $op (map split(/\\s+/), values %overload::ops) {"
NSQ_SOURCE_LINE 00000185 "        my $info = overload_op_info($class, $op)"
NSQ_SOURCE_LINE 00000186 "            or next;"
NSQ_SOURCE_LINE 00000187 "        $overloaded{$op} = $info"
NSQ_SOURCE_LINE 00000188 "    }"
NSQ_SOURCE_LINE 00000189 "    return \\%overloaded;"
NSQ_SOURCE_LINE 00000190 "}"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "#pod =head1 CAVEATS"
NSQ_SOURCE_LINE 00000193 "#pod"
NSQ_SOURCE_LINE 00000194 "#pod Whether the C<fallback> key exists when it has its default value of"
NSQ_SOURCE_LINE 00000195 "#pod C<undef> varies between perl versions: Before 5.18 it's there, in"
NSQ_SOURCE_LINE 00000196 "#pod later versions it's not."
NSQ_SOURCE_LINE 00000197 "#pod"
NSQ_SOURCE_LINE 00000198 "#pod =cut"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "1;"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "__END__"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "=pod"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=encoding UTF-8"
