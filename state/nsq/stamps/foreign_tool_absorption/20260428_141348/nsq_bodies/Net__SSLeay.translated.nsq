NSQ_SOURCE_LINE 00001880 ""
NSQ_SOURCE_LINE 00001881 "sub httpx_cat {"
NSQ_SOURCE_LINE 00001882 "    my ($usessl, $site, $port, $req, $crt_path, $key_path) = @_;"
NSQ_SOURCE_LINE 00001883 "    warn \"httpx_cat: usessl=$usessl ($site:$port)\" if $trace;"
NSQ_SOURCE_LINE 00001884 "    if ($usessl) {"
NSQ_SOURCE_LINE 00001885 "\treturn https_cat($site, $port, $req, $crt_path, $key_path);"
NSQ_SOURCE_LINE 00001886 "    } else {"
NSQ_SOURCE_LINE 00001887 "\treturn http_cat($site, $port, $req);"
NSQ_SOURCE_LINE 00001888 "    }"
NSQ_SOURCE_LINE 00001889 "}"
NSQ_SOURCE_LINE 00001890 ""
NSQ_SOURCE_LINE 00001891 "###"
NSQ_SOURCE_LINE 00001892 "### Easy set up of private key and certificate"
NSQ_SOURCE_LINE 00001893 "###"
NSQ_SOURCE_LINE 00001894 ""
NSQ_SOURCE_LINE 00001895 "sub set_cert_and_key ($$$) {"
NSQ_SOURCE_LINE 00001896 "    my ($ctx, $cert_path, $key_path) = @_;"
NSQ_SOURCE_LINE 00001897 "    my $errs = '';"
NSQ_SOURCE_LINE 00001898 "    # Following will ask password unless private key is not encrypted"
NSQ_SOURCE_LINE 00001899 "    CTX_use_PrivateKey_file( $ctx, $key_path, &FILETYPE_PEM ) == 1"
NSQ_SOURCE_LINE 00001900 "        or $errs .= print_errs(\"private key `$key_path' ($!)\");"
NSQ_SOURCE_LINE 00001901 "    CTX_use_certificate_file ($ctx, $cert_path, &FILETYPE_PEM) == 1"
NSQ_SOURCE_LINE 00001902 "        or $errs .= print_errs(\"certificate `$cert_path' ($!)\");"
NSQ_SOURCE_LINE 00001903 "    return wantarray ? (undef, $errs) : ($errs eq '');"
NSQ_SOURCE_LINE 00001904 "}"
NSQ_SOURCE_LINE 00001905 ""
NSQ_SOURCE_LINE 00001906 "### Old deprecated API"
NSQ_SOURCE_LINE 00001907 ""
NSQ_SOURCE_LINE 00001908 "sub set_server_cert_and_key ($$$) { &set_cert_and_key }"
NSQ_SOURCE_LINE 00001909 ""
NSQ_SOURCE_LINE 00001910 "### Set up to use web proxy"
NSQ_SOURCE_LINE 00001911 ""
NSQ_SOURCE_LINE 00001912 "sub set_proxy ($$;**) {"
NSQ_SOURCE_LINE 00001913 "    ($proxyhost, $proxyport, $proxyuser, $proxypass) = @_;"
NSQ_SOURCE_LINE 00001914 "    require MIME::Base64 if $proxyuser;"
NSQ_SOURCE_LINE 00001915 "    $proxyauth = $proxyuser"
NSQ_SOURCE_LINE 00001916 "         ? $CRLF . 'Proxy-authorization: Basic '"
NSQ_SOURCE_LINE 00001917 "\t . MIME::Base64::encode(\"$proxyuser:$proxypass\", '')"
NSQ_SOURCE_LINE 00001918 "\t : '';"
NSQ_SOURCE_LINE 00001919 "}"
NSQ_SOURCE_LINE 00001920 ""
NSQ_SOURCE_LINE 00001921 "###"
NSQ_SOURCE_LINE 00001922 "### Easy https manipulation routines"
NSQ_SOURCE_LINE 00001923 "###"
NSQ_SOURCE_LINE 00001924 ""
NSQ_SOURCE_LINE 00001925 "sub make_form {"
NSQ_SOURCE_LINE 00001926 "    my (@fields) = @_;"
NSQ_SOURCE_LINE 00001927 "    my $form;"
NSQ_SOURCE_LINE 00001928 "    while (@fields) {"
NSQ_SOURCE_LINE 00001929 "\tmy ($name, $data) = (shift(@fields), shift(@fields));"
NSQ_SOURCE_LINE 00001930 "\t$data =~ s/([^\\w\\-.\\@\\$ ])/sprintf(\"%%%2.2x\",ord($1))/gse;"
NSQ_SOURCE_LINE 00001931 "    \t$data =~ tr[ ][+];"
NSQ_SOURCE_LINE 00001932 "\t$form .= \"$name=$data&\";"
NSQ_SOURCE_LINE 00001933 "    }"
NSQ_SOURCE_LINE 00001934 "    chop $form;"
NSQ_SOURCE_LINE 00001935 "    return $form;"
NSQ_SOURCE_LINE 00001936 "}"
NSQ_SOURCE_LINE 00001937 ""
NSQ_SOURCE_LINE 00001938 "sub make_headers {"
NSQ_SOURCE_LINE 00001939 "    my (@headers) = @_;"
NSQ_SOURCE_LINE 00001940 "    my $headers;"
NSQ_SOURCE_LINE 00001941 "    while (@headers) {"
NSQ_SOURCE_LINE 00001942 "\tmy $header = shift(@headers);"
NSQ_SOURCE_LINE 00001943 "\tmy $value = shift(@headers);"
NSQ_SOURCE_LINE 00001944 "\t$header =~ s/:$//;"
NSQ_SOURCE_LINE 00001945 "\t$value =~ s/\\x0d?\\x0a$//; # because we add it soon, see below"
NSQ_SOURCE_LINE 00001946 "\t$headers .= \"$header: $value$CRLF\";"
NSQ_SOURCE_LINE 00001947 "    }"
NSQ_SOURCE_LINE 00001948 "    return $headers;"
NSQ_SOURCE_LINE 00001949 "}"
NSQ_SOURCE_LINE 00001950 ""
NSQ_SOURCE_LINE 00001951 "sub do_httpx3 {"
NSQ_SOURCE_LINE 00001952 "    my ($method, $usessl, $site, $port, $path, $headers,"
NSQ_SOURCE_LINE 00001953 "\t$content, $mime_type, $crt_path, $key_path) = @_;"
NSQ_SOURCE_LINE 00001954 "    my ($response, $page, $h,$v);"
NSQ_SOURCE_LINE 00001955 ""
NSQ_SOURCE_LINE 00001956 "    my $len = blength($content);"
NSQ_SOURCE_LINE 00001957 "    if ($len) {"
NSQ_SOURCE_LINE 00001958 "\t$mime_type = \"application/x-www-form-urlencoded\" unless $mime_type;"
NSQ_SOURCE_LINE 00001959 "\t$content = \"Content-Type: $mime_type$CRLF\""
NSQ_SOURCE_LINE 00001960 "\t    . \"Content-Length: $len$CRLF$CRLF$content\";"
NSQ_SOURCE_LINE 00001961 "    } else {"
NSQ_SOURCE_LINE 00001962 "\t$content = \"$CRLF$CRLF\";"
NSQ_SOURCE_LINE 00001963 "    }"
NSQ_SOURCE_LINE 00001964 "    my $req = \"$method $path HTTP/1.0$CRLF\";"
NSQ_SOURCE_LINE 00001965 "    unless (defined $headers && $headers =~ /^Host:/m) {"
NSQ_SOURCE_LINE 00001966 "        $req .= \"Host: $site\";"
NSQ_SOURCE_LINE 00001967 "        unless (($port == 80 && !$usessl) || ($port == 443 && $usessl)) {"
NSQ_SOURCE_LINE 00001968 "            $req .= \":$port\";"
NSQ_SOURCE_LINE 00001969 "        }"
NSQ_SOURCE_LINE 00001970 "        $req .= $CRLF;"
NSQ_SOURCE_LINE 00001971 "\t}"
NSQ_SOURCE_LINE 00001972 "    $req .= (defined $headers ? $headers : '') . \"Accept: */*$CRLF$content\";"
NSQ_SOURCE_LINE 00001973 ""
NSQ_SOURCE_LINE 00001974 "    warn \"do_httpx3($method,$usessl,$site:$port)\" if $trace;"
NSQ_SOURCE_LINE 00001975 "    my ($http, $errs, $server_cert)"
NSQ_SOURCE_LINE 00001976 "\t= httpx_cat($usessl, $site, $port, $req, $crt_path, $key_path);"
NSQ_SOURCE_LINE 00001977 "    return (undef, \"HTTP/1.0 900 NET OR SSL ERROR$CRLF$CRLF$errs\") if $errs;"
NSQ_SOURCE_LINE 00001978 ""
NSQ_SOURCE_LINE 00001979 "    $http = '' if !defined $http;"
NSQ_SOURCE_LINE 00001980 "    ($headers, $page) = split /\\s?\\n\\s?\\n/, $http, 2;"
NSQ_SOURCE_LINE 00001981 "    warn \"headers >$headers< page >>$page<< http >>>$http<<<\" if $trace>1;"
NSQ_SOURCE_LINE 00001982 "    ($response, $headers) = split /\\s?\\n/, $headers, 2;"
NSQ_SOURCE_LINE 00001983 "    return ($page, $response, $headers, $server_cert);"
NSQ_SOURCE_LINE 00001984 "}"
NSQ_SOURCE_LINE 00001985 ""
NSQ_SOURCE_LINE 00001986 "sub do_https3 { splice(@_,1,0) = 1; do_httpx3; }  # Legacy undocumented"
NSQ_SOURCE_LINE 00001987 ""
NSQ_SOURCE_LINE 00001988 "### do_https2() is a legacy version in the sense that it is unable"
NSQ_SOURCE_LINE 00001989 "### to return all instances of duplicate headers."
NSQ_SOURCE_LINE 00001990 ""
NSQ_SOURCE_LINE 00001991 "sub do_httpx2 {"
NSQ_SOURCE_LINE 00001992 "    my ($page, $response, $headers, $server_cert) = &do_httpx3;"
NSQ_SOURCE_LINE 00001993 "    X509_free($server_cert) if defined $server_cert;"
NSQ_SOURCE_LINE 00001994 "    return ($page, $response, defined $headers ?"
NSQ_SOURCE_LINE 00001995 "\t    map( { ($h,$v)=/^(\\S+)\\:\\s*(.*)$/; (uc($h),$v); }"
NSQ_SOURCE_LINE 00001996 "\t\tsplit(/\\s?\\n/, $headers)"
NSQ_SOURCE_LINE 00001997 "\t\t) : ()"
NSQ_SOURCE_LINE 00001998 "\t    );"
NSQ_SOURCE_LINE 00001999 "}"
NSQ_SOURCE_LINE 00002000 ""
NSQ_SOURCE_LINE 00002001 "sub do_https2 { splice(@_,1,0) = 1; do_httpx2; }  # Legacy undocumented"
NSQ_SOURCE_LINE 00002002 ""
NSQ_SOURCE_LINE 00002003 "### Returns headers as a hash where multiple instances of same header"
NSQ_SOURCE_LINE 00002004 "### are handled correctly."
NSQ_SOURCE_LINE 00002005 ""
NSQ_SOURCE_LINE 00002006 "sub do_httpx4 {"
NSQ_SOURCE_LINE 00002007 "    my ($page, $response, $headers, $server_cert) = &do_httpx3;"
NSQ_SOURCE_LINE 00002008 "    my %hr = ();"
NSQ_SOURCE_LINE 00002009 "    for my $hh (split /\\s?\\n/, $headers) {"
NSQ_SOURCE_LINE 00002010 "\tmy ($h,$v) = ($hh =~ /^(\\S+)\\:\\s*(.*)$/);"
NSQ_SOURCE_LINE 00002011 "\tpush @{$hr{uc($h)}}, $v;"
NSQ_SOURCE_LINE 00002012 "    }"
NSQ_SOURCE_LINE 00002013 "    return ($page, $response, \\%hr, $server_cert);"
NSQ_SOURCE_LINE 00002014 "}"
NSQ_SOURCE_LINE 00002015 ""
NSQ_SOURCE_LINE 00002016 "sub do_https4 { splice(@_,1,0) = 1; do_httpx4; }  # Legacy undocumented"
