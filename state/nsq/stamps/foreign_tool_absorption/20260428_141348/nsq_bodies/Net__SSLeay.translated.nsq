NSQ_SOURCE_LINE 00001499 "  #if (ref $_[1]) { $data_ref = $_[1] }"
NSQ_SOURCE_LINE 00001500 "  # else { $data_ref = \\$_[1] }"
NSQ_SOURCE_LINE 00001501 "  #my $message = $$data_ref . $CRLF;"
NSQ_SOURCE_LINE 00001502 "  #return ssl_write_all($_[0], \\$message);"
NSQ_SOURCE_LINE 00001503 "}"
NSQ_SOURCE_LINE 00001504 ""
NSQ_SOURCE_LINE 00001505 "sub tcp_write_CRLF {"
NSQ_SOURCE_LINE 00001506 "  # the next line uses less memory but might use more network packets"
NSQ_SOURCE_LINE 00001507 "  return tcp_write_all($_[0]) + tcp_write_all($CRLF);"
NSQ_SOURCE_LINE 00001508 ""
NSQ_SOURCE_LINE 00001509 "  # the next few lines do the same thing at the expense of memory, with"
NSQ_SOURCE_LINE 00001510 "  # the chance that it will use less packets, since CRLF is in the original"
NSQ_SOURCE_LINE 00001511 "  # message and won't be sent separately."
NSQ_SOURCE_LINE 00001512 ""
