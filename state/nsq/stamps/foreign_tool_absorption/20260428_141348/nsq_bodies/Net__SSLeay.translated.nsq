NSQ_SOURCE_LINE 00001063 "# Perl 5.6.* unicode support causes that length() no longer reliably"
NSQ_SOURCE_LINE 00001064 "# reflects the byte length of a string. This eval is to fix that."
NSQ_SOURCE_LINE 00001065 "# Thanks to Sean Burke for the snippet."
NSQ_SOURCE_LINE 00001066 ""
NSQ_SOURCE_LINE 00001067 "BEGIN{"
NSQ_SOURCE_LINE 00001068 "eval 'use bytes; sub blength ($) { defined $_[0] ? length $_[0] : 0  }';"
NSQ_SOURCE_LINE 00001069 "$@ and eval '    sub blength ($) { defined $_[0] ? length $_[0] : 0 }' ;"
NSQ_SOURCE_LINE 00001070 "}"
NSQ_SOURCE_LINE 00001071 ""
NSQ_SOURCE_LINE 00001072 "# Autoload methods go after __END__, and are processed by the autosplit program."
NSQ_SOURCE_LINE 00001073 ""
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "1;"
NSQ_SOURCE_LINE 00001076 "__END__"
NSQ_SOURCE_LINE 00001077 ""
NSQ_SOURCE_LINE 00001078 "### Some methods that are macros in C"
NSQ_SOURCE_LINE 00001079 ""
NSQ_SOURCE_LINE 00001080 "sub want_nothing { want(shift) == 1 }"
NSQ_SOURCE_LINE 00001081 "sub want_read { want(shift) == 2 }"
NSQ_SOURCE_LINE 00001082 "sub want_write { want(shift) == 3 }"
NSQ_SOURCE_LINE 00001083 "sub want_X509_lookup { want(shift) == 4 }"
NSQ_SOURCE_LINE 00001084 ""
NSQ_SOURCE_LINE 00001085 "###"
NSQ_SOURCE_LINE 00001086 "### Open TCP stream to given host and port, looking up the details"
NSQ_SOURCE_LINE 00001087 "### from system databases or DNS."
NSQ_SOURCE_LINE 00001088 "###"
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "sub open_tcp_connection {"
NSQ_SOURCE_LINE 00001091 "    my ($dest_serv, $port) = @_;"
NSQ_SOURCE_LINE 00001092 "    my ($errs);"
NSQ_SOURCE_LINE 00001093 ""
NSQ_SOURCE_LINE 00001094 "    $port = getservbyname($port, 'tcp') unless $port =~ /^\\d+$/;"
NSQ_SOURCE_LINE 00001095 "    my $dest_serv_ip = gethostbyname($dest_serv);"
NSQ_SOURCE_LINE 00001096 "    unless (defined($dest_serv_ip)) {"
NSQ_SOURCE_LINE 00001097 "\t$errs = \"$0 $$: open_tcp_connection: destination host not found:\""
NSQ_SOURCE_LINE 00001098 "            . \" `$dest_serv' (port $port) ($!)\\n\";"
NSQ_SOURCE_LINE 00001099 "\twarn $errs if $trace;"
NSQ_SOURCE_LINE 00001100 "        return wantarray ? (0, $errs) : 0;"
NSQ_SOURCE_LINE 00001101 "    }"
NSQ_SOURCE_LINE 00001102 "    my $sin = sockaddr_in($port, $dest_serv_ip);"
NSQ_SOURCE_LINE 00001103 ""
NSQ_SOURCE_LINE 00001104 "    warn \"Opening connection to $dest_serv:$port (\" ."
NSQ_SOURCE_LINE 00001105 "\tinet_ntoa($dest_serv_ip) . \")\" if $trace>2;"
NSQ_SOURCE_LINE 00001106 ""
NSQ_SOURCE_LINE 00001107 "    my $proto = &Socket::IPPROTO_TCP; # getprotobyname('tcp') not available on android"
NSQ_SOURCE_LINE 00001108 "    if (socket (SSLCAT_S, &PF_INET(), &SOCK_STREAM(), $proto)) {"
NSQ_SOURCE_LINE 00001109 "        warn \"next connect\" if $trace>3;"
NSQ_SOURCE_LINE 00001110 "        if (CORE::connect (SSLCAT_S, $sin)) {"
NSQ_SOURCE_LINE 00001111 "            my $old_out = select (SSLCAT_S); $| = 1; select ($old_out);"
NSQ_SOURCE_LINE 00001112 "            warn \"connected to $dest_serv, $port\" if $trace>3;"
NSQ_SOURCE_LINE 00001113 "            return wantarray ? (1, undef) : 1; # Success"
NSQ_SOURCE_LINE 00001114 "        }"
NSQ_SOURCE_LINE 00001115 "    }"
NSQ_SOURCE_LINE 00001116 "    $errs = \"$0 $$: open_tcp_connection: failed `$dest_serv', $port ($!)\\n\";"
NSQ_SOURCE_LINE 00001117 "    warn $errs if $trace;"
NSQ_SOURCE_LINE 00001118 "    close SSLCAT_S;"
NSQ_SOURCE_LINE 00001119 "    return wantarray ? (0, $errs) : 0; # Fail"
NSQ_SOURCE_LINE 00001120 "}"
NSQ_SOURCE_LINE 00001121 ""
NSQ_SOURCE_LINE 00001122 "### Open connection via standard web proxy, if one was defined"
NSQ_SOURCE_LINE 00001123 "### using set_proxy()."
NSQ_SOURCE_LINE 00001124 ""
NSQ_SOURCE_LINE 00001125 "sub open_proxy_tcp_connection {"
NSQ_SOURCE_LINE 00001126 "    my ($dest_serv, $port) = @_;"
NSQ_SOURCE_LINE 00001127 "    return open_tcp_connection($dest_serv, $port) if !$proxyhost;"
NSQ_SOURCE_LINE 00001128 ""
NSQ_SOURCE_LINE 00001129 "    warn \"Connect via proxy: $proxyhost:$proxyport\" if $trace>2;"
NSQ_SOURCE_LINE 00001130 "    my ($ret, $errs) = open_tcp_connection($proxyhost, $proxyport);"
NSQ_SOURCE_LINE 00001131 "    return wantarray ? (0, $errs) : 0 if !$ret;  # Connection fail"
NSQ_SOURCE_LINE 00001132 ""
NSQ_SOURCE_LINE 00001133 "    warn \"Asking proxy to connect to $dest_serv:$port\" if $trace>2;"
NSQ_SOURCE_LINE 00001134 "    #print SSLCAT_S \"CONNECT $dest_serv:$port HTTP/1.0$proxyauth$CRLF$CRLF\";"
NSQ_SOURCE_LINE 00001135 "    #my $line = <SSLCAT_S>;   # *** bug? Mixing stdio with syscall read?"
NSQ_SOURCE_LINE 00001136 "    ($ret, $errs) ="
NSQ_SOURCE_LINE 00001137 "\ttcp_write_all(\"CONNECT $dest_serv:$port HTTP/1.0$proxyauth$CRLF$CRLF\");"
NSQ_SOURCE_LINE 00001138 "    return wantarray ? (0,$errs) : 0 if $errs;"
NSQ_SOURCE_LINE 00001139 "    ($line, $errs) = tcp_read_until($CRLF . $CRLF, 1024);"
NSQ_SOURCE_LINE 00001140 "    warn \"Proxy response: $line\" if $trace>2;"
NSQ_SOURCE_LINE 00001141 "    return wantarray ? (0,$errs) : 0 if $errs;"
NSQ_SOURCE_LINE 00001142 "    return wantarray ? (1,'') : 1;  # Success"
NSQ_SOURCE_LINE 00001143 "}"
NSQ_SOURCE_LINE 00001144 ""
NSQ_SOURCE_LINE 00001145 "###"
NSQ_SOURCE_LINE 00001146 "### read and write helpers that block"
NSQ_SOURCE_LINE 00001147 "###"
NSQ_SOURCE_LINE 00001148 ""
NSQ_SOURCE_LINE 00001149 "sub debug_read {"
NSQ_SOURCE_LINE 00001150 "    my ($replyr, $gotr) = @_;"
NSQ_SOURCE_LINE 00001151 "    my $vm = $trace>2 && $linux_debug ?"
NSQ_SOURCE_LINE 00001152 "\t(split ' ', `cat /proc/$$/stat`)[22] : 'vm_unknown';"
NSQ_SOURCE_LINE 00001153 "    warn \"  got \" . blength($$gotr) . ':'"
NSQ_SOURCE_LINE 00001154 "\t. blength($$replyr) . \" bytes (VM=$vm).\\n\" if $trace == 3;"
NSQ_SOURCE_LINE 00001155 "    warn \"  got `$$gotr' (\" . blength($$gotr) . ':'"
NSQ_SOURCE_LINE 00001156 "\t. blength($$replyr) . \" bytes, VM=$vm)\\n\" if $trace>3;"
NSQ_SOURCE_LINE 00001157 "}"
NSQ_SOURCE_LINE 00001158 ""
NSQ_SOURCE_LINE 00001159 "sub ssl_read_all {"
NSQ_SOURCE_LINE 00001160 "    my ($ssl,$how_much) = @_;"
NSQ_SOURCE_LINE 00001161 "    $how_much = 2000000000 unless $how_much;"
NSQ_SOURCE_LINE 00001162 "    my ($got, $rv, $errs);"
NSQ_SOURCE_LINE 00001163 "    my $reply = '';"
NSQ_SOURCE_LINE 00001164 ""
NSQ_SOURCE_LINE 00001165 "    while ($how_much > 0) {"
NSQ_SOURCE_LINE 00001166 "        ($got, $rv) = Net::SSLeay::read($ssl,"
NSQ_SOURCE_LINE 00001167 "                ($how_much > 32768) ? 32768 : $how_much"
NSQ_SOURCE_LINE 00001168 "        );"
NSQ_SOURCE_LINE 00001169 "\tif (! defined $got) {"
NSQ_SOURCE_LINE 00001170 "\t    my $err = Net::SSLeay::get_error($ssl, $rv);"
NSQ_SOURCE_LINE 00001171 "\t    if ($err != Net::SSLeay::ERROR_WANT_READ() and"
NSQ_SOURCE_LINE 00001172 "\t\t$err != Net::SSLeay::ERROR_WANT_WRITE()) {"
NSQ_SOURCE_LINE 00001173 "                $errs = print_errs('SSL_read');"
NSQ_SOURCE_LINE 00001174 "                last;"
NSQ_SOURCE_LINE 00001175 "            }"
NSQ_SOURCE_LINE 00001176 "            next;"
NSQ_SOURCE_LINE 00001177 "        }"
NSQ_SOURCE_LINE 00001178 "        $how_much -= blength($got);"
NSQ_SOURCE_LINE 00001179 "        debug_read(\\$reply, \\$got) if $trace>1;"
NSQ_SOURCE_LINE 00001180 "        last if $got eq '';  # EOF"
NSQ_SOURCE_LINE 00001181 "        $reply .= $got;"
NSQ_SOURCE_LINE 00001182 "    }"
NSQ_SOURCE_LINE 00001183 ""
NSQ_SOURCE_LINE 00001184 "    return wantarray ? ($reply, $errs) : $reply;"
NSQ_SOURCE_LINE 00001185 "}"
NSQ_SOURCE_LINE 00001186 ""
NSQ_SOURCE_LINE 00001187 "sub tcp_read_all {"
NSQ_SOURCE_LINE 00001188 "    my ($how_much) = @_;"
NSQ_SOURCE_LINE 00001189 "    $how_much = 2000000000 unless $how_much;"
NSQ_SOURCE_LINE 00001190 "    my ($n, $got, $errs);"
NSQ_SOURCE_LINE 00001191 "    my $reply = '';"
NSQ_SOURCE_LINE 00001192 ""
NSQ_SOURCE_LINE 00001193 "    my $bsize = 0x10000;"
NSQ_SOURCE_LINE 00001194 "    while ($how_much > 0) {"
NSQ_SOURCE_LINE 00001195 "\t$n = sysread(SSLCAT_S,$got, (($bsize < $how_much) ? $bsize : $how_much));"
NSQ_SOURCE_LINE 00001196 "\twarn \"Read error: $! ($n,$how_much)\" unless defined $n;"
NSQ_SOURCE_LINE 00001197 "\tlast if !$n;  # EOF"
NSQ_SOURCE_LINE 00001198 "\t$how_much -= $n;"
NSQ_SOURCE_LINE 00001199 "\tdebug_read(\\$reply, \\$got) if $trace>1;"
NSQ_SOURCE_LINE 00001200 "\t$reply .= $got;"
NSQ_SOURCE_LINE 00001201 "    }"
NSQ_SOURCE_LINE 00001202 "    return wantarray ? ($reply, $errs) : $reply;"
NSQ_SOURCE_LINE 00001203 "}"
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "sub ssl_write_all {"
NSQ_SOURCE_LINE 00001206 "    my $ssl = $_[0];"
NSQ_SOURCE_LINE 00001207 "    my ($data_ref, $errs);"
NSQ_SOURCE_LINE 00001208 "    if (ref $_[1]) {"
NSQ_SOURCE_LINE 00001209 "\t$data_ref = $_[1];"
NSQ_SOURCE_LINE 00001210 "    } else {"
NSQ_SOURCE_LINE 00001211 "\t$data_ref = \\$_[1];"
NSQ_SOURCE_LINE 00001212 "    }"
NSQ_SOURCE_LINE 00001213 "    my ($wrote, $written, $to_write) = (0,0, blength($$data_ref));"
NSQ_SOURCE_LINE 00001214 "    my $vm = $trace>2 && $linux_debug ?"
NSQ_SOURCE_LINE 00001215 "\t(split ' ', `cat /proc/$$/stat`)[22] : 'vm_unknown';"
NSQ_SOURCE_LINE 00001216 "    warn \"  write_all VM at entry=$vm\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001217 "    while ($to_write) {"
NSQ_SOURCE_LINE 00001218 "\t#sleep 1; # *** DEBUG"
NSQ_SOURCE_LINE 00001219 "\twarn \"partial `$$data_ref'\\n\" if $trace>3;"
NSQ_SOURCE_LINE 00001220 "\t$wrote = write_partial($ssl, $written, $to_write, $$data_ref);"
NSQ_SOURCE_LINE 00001221 "\tif (defined $wrote && ($wrote > 0)) {  # write_partial can return -1"
NSQ_SOURCE_LINE 00001222 "\t    $written += $wrote;"
NSQ_SOURCE_LINE 00001223 "\t    $to_write -= $wrote;"
NSQ_SOURCE_LINE 00001224 "\t} else {"
NSQ_SOURCE_LINE 00001225 "\t  if (defined $wrote) {"
NSQ_SOURCE_LINE 00001226 "\t    # check error conditions via SSL_get_error per man page"
NSQ_SOURCE_LINE 00001227 "\t    if ( my $sslerr = get_error($ssl, $wrote) ) {"
NSQ_SOURCE_LINE 00001228 "\t      my $errstr = ERR_error_string($sslerr);"
NSQ_SOURCE_LINE 00001229 "\t      my $errname = '';"
NSQ_SOURCE_LINE 00001230 "\t      SWITCH: {"
NSQ_SOURCE_LINE 00001231 "\t\t$sslerr == constant(\"ERROR_NONE\") && do {"
NSQ_SOURCE_LINE 00001232 "\t\t  # according to map page SSL_get_error(3ssl):"
NSQ_SOURCE_LINE 00001233 "\t\t  #  The TLS/SSL I/O operation completed."
NSQ_SOURCE_LINE 00001234 "\t\t  #  This result code is returned if and only if ret > 0"
NSQ_SOURCE_LINE 00001235 "                  # so if we received it here complain..."
NSQ_SOURCE_LINE 00001236 "\t\t  warn \"ERROR_NONE unexpected with invalid return value!\""
NSQ_SOURCE_LINE 00001237 "\t\t    if $trace;"
NSQ_SOURCE_LINE 00001238 "\t\t  $errname = \"SSL_ERROR_NONE\";"
NSQ_SOURCE_LINE 00001239 "\t\t};"
NSQ_SOURCE_LINE 00001240 "\t\t$sslerr == constant(\"ERROR_WANT_READ\") && do {"
NSQ_SOURCE_LINE 00001241 "\t\t  # operation did not complete, call again later, so do not"
NSQ_SOURCE_LINE 00001242 "\t\t  # set errname and empty err_que since this is a known"
NSQ_SOURCE_LINE 00001243 "\t\t  # error that is expected but, we should continue to try"
NSQ_SOURCE_LINE 00001244 "\t\t  # writing the rest of our data with same io call and params."
NSQ_SOURCE_LINE 00001245 "\t\t  warn \"ERROR_WANT_READ (TLS/SSL Handshake, will continue)\\n\""
NSQ_SOURCE_LINE 00001246 "\t\t    if $trace;"
NSQ_SOURCE_LINE 00001247 "\t\t  print_errs('SSL_write(want read)');"
NSQ_SOURCE_LINE 00001248 "\t\t  last SWITCH;"
NSQ_SOURCE_LINE 00001249 "\t\t};"
NSQ_SOURCE_LINE 00001250 "\t\t$sslerr == constant(\"ERROR_WANT_WRITE\") && do {"
NSQ_SOURCE_LINE 00001251 "\t\t  # operation did not complete, call again later, so do not"
NSQ_SOURCE_LINE 00001252 "\t\t  # set errname and empty err_que since this is a known"
NSQ_SOURCE_LINE 00001253 "\t\t  # error that is expected but, we should continue to try"
NSQ_SOURCE_LINE 00001254 "\t\t  # writing the rest of our data with same io call and params."
NSQ_SOURCE_LINE 00001255 "\t\t  warn \"ERROR_WANT_WRITE (TLS/SSL Handshake, will continue)\\n\""
NSQ_SOURCE_LINE 00001256 "\t\t    if $trace;"
NSQ_SOURCE_LINE 00001257 "\t\t  print_errs('SSL_write(want write)');"
NSQ_SOURCE_LINE 00001258 "\t\t  last SWITCH;"
NSQ_SOURCE_LINE 00001259 "\t\t};"
NSQ_SOURCE_LINE 00001260 "\t\t$sslerr == constant(\"ERROR_ZERO_RETURN\") && do {"
NSQ_SOURCE_LINE 00001261 "\t\t  # valid protocol closure from other side, no longer able to"
NSQ_SOURCE_LINE 00001262 "\t\t  # write, since there is no longer a session..."
NSQ_SOURCE_LINE 00001263 "\t\t  warn \"ERROR_ZERO_RETURN($wrote): TLS/SSLv3 Closure alert\\n\""
NSQ_SOURCE_LINE 00001264 "\t\t    if $trace;"
NSQ_SOURCE_LINE 00001265 "\t\t  $errname = \"SSL_ERROR_ZERO_RETURN\";"
NSQ_SOURCE_LINE 00001266 "\t\t  last SWITCH;"
NSQ_SOURCE_LINE 00001267 "\t\t};"
NSQ_SOURCE_LINE 00001268 "\t\t$sslerr == constant(\"ERROR_SSL\") && do {"
NSQ_SOURCE_LINE 00001269 "\t\t  # library/protocol error"
NSQ_SOURCE_LINE 00001270 "\t\t  warn \"ERROR_SSL($wrote): Library/Protocol error occured\\n\""
NSQ_SOURCE_LINE 00001271 "\t\t    if $trace;"
NSQ_SOURCE_LINE 00001272 "\t\t  $errname = \"SSL_ERROR_SSL\";"
NSQ_SOURCE_LINE 00001273 "\t\t  last SWITCH;"
NSQ_SOURCE_LINE 00001274 "\t\t};"
NSQ_SOURCE_LINE 00001275 "\t\t$sslerr == constant(\"ERROR_WANT_CONNECT\") && do {"
NSQ_SOURCE_LINE 00001276 "\t\t  # according to man page, should never happen on call to"
NSQ_SOURCE_LINE 00001277 "\t\t  # SSL_write, so complain, but handle as known error type"
NSQ_SOURCE_LINE 00001278 "\t\t  warn \"ERROR_WANT_CONNECT: Unexpected error for SSL_write\\n\""
NSQ_SOURCE_LINE 00001279 "\t\t    if $trace;"
NSQ_SOURCE_LINE 00001280 "\t\t  $errname = \"SSL_ERROR_WANT_CONNECT\";"
NSQ_SOURCE_LINE 00001281 "\t\t  last SWITCH;"
NSQ_SOURCE_LINE 00001282 "\t\t};"
NSQ_SOURCE_LINE 00001283 "\t\t$sslerr == constant(\"ERROR_WANT_ACCEPT\") && do {"
NSQ_SOURCE_LINE 00001284 "\t\t  # according to man page, should never happen on call to"
NSQ_SOURCE_LINE 00001285 "\t\t  # SSL_write, so complain, but handle as known error type"
NSQ_SOURCE_LINE 00001286 "\t\t  warn \"ERROR_WANT_ACCEPT: Unexpected error for SSL_write\\n\""
NSQ_SOURCE_LINE 00001287 "\t\t    if $trace;"
NSQ_SOURCE_LINE 00001288 "\t\t  $errname = \"SSL_ERROR_WANT_ACCEPT\";"
NSQ_SOURCE_LINE 00001289 "\t\t  last SWITCH;"
NSQ_SOURCE_LINE 00001290 "\t\t};"
NSQ_SOURCE_LINE 00001291 "\t\t$sslerr == constant(\"ERROR_WANT_X509_LOOKUP\") && do {"
NSQ_SOURCE_LINE 00001292 "\t\t  # operation did not complete: waiting on call back,"
NSQ_SOURCE_LINE 00001293 "\t\t  # call again later, so do not set errname and empty err_que"
NSQ_SOURCE_LINE 00001294 "\t\t  # since this is a known error that is expected but, we should"
NSQ_SOURCE_LINE 00001295 "\t\t  # continue to try writing the rest of our data with same io"
NSQ_SOURCE_LINE 00001296 "\t\t  # call parameter."
NSQ_SOURCE_LINE 00001297 "\t\t  warn \"ERROR_WANT_X509_LOOKUP: (Cert Callback asked for in \"."
NSQ_SOURCE_LINE 00001298 "\t\t    \"SSL_write will contine)\\n\" if $trace;"
NSQ_SOURCE_LINE 00001299 "\t\t  print_errs('SSL_write(want x509');"
NSQ_SOURCE_LINE 00001300 "\t\t  last SWITCH;"
NSQ_SOURCE_LINE 00001301 "\t\t};"
NSQ_SOURCE_LINE 00001302 "\t\t$sslerr == constant(\"ERROR_SYSCALL\") && do {"
NSQ_SOURCE_LINE 00001303 "\t\t  # some IO error occured. According to man page:"
NSQ_SOURCE_LINE 00001304 "\t\t  # Check retval, ERR, fallback to errno"
NSQ_SOURCE_LINE 00001305 "\t\t  if ($wrote==0) { # EOF"
NSQ_SOURCE_LINE 00001306 "\t\t    warn \"ERROR_SYSCALL($wrote): EOF violates protocol.\\n\""
NSQ_SOURCE_LINE 00001307 "\t\t      if $trace;"
NSQ_SOURCE_LINE 00001308 "\t\t    $errname = \"SSL_ERROR_SYSCALL(EOF)\";"
NSQ_SOURCE_LINE 00001309 "\t\t  } else { # -1 underlying BIO error reported."
NSQ_SOURCE_LINE 00001310 "\t\t    # check error que for details, don't set errname since we"
NSQ_SOURCE_LINE 00001311 "\t\t    # are directly appending to errs"
NSQ_SOURCE_LINE 00001312 "\t\t    my $chkerrs = print_errs('SSL_write (syscall)');"
NSQ_SOURCE_LINE 00001313 "\t\t    if ($chkerrs) {"
NSQ_SOURCE_LINE 00001314 "\t\t      warn \"ERROR_SYSCALL($wrote): Have errors\\n\" if $trace;"
NSQ_SOURCE_LINE 00001315 "\t\t      $errs .= \"ssl_write_all $$: 1 - ERROR_SYSCALL($wrote,\"."
NSQ_SOURCE_LINE 00001316 "\t\t\t\"$sslerr,$errstr,$!)\\n$chkerrs\";"
NSQ_SOURCE_LINE 00001317 "\t\t    } else { # que was empty, use errno"
NSQ_SOURCE_LINE 00001318 "\t\t      warn \"ERROR_SYSCALL($wrote): errno($!)\\n\" if $trace;"
NSQ_SOURCE_LINE 00001319 "\t\t      $errs .= \"ssl_write_all $$: 1 - ERROR_SYSCALL($wrote,\"."
NSQ_SOURCE_LINE 00001320 "\t\t\t\"$sslerr) : $!\\n\";"
NSQ_SOURCE_LINE 00001321 "\t\t    }"
NSQ_SOURCE_LINE 00001322 "\t\t  }"
NSQ_SOURCE_LINE 00001323 "\t\t  last SWITCH;"
NSQ_SOURCE_LINE 00001324 "\t\t};"
NSQ_SOURCE_LINE 00001325 "\t\twarn \"Unhandled val $sslerr from SSL_get_error(SSL,$wrote)\\n\""
NSQ_SOURCE_LINE 00001326 "\t\t  if $trace;"
NSQ_SOURCE_LINE 00001327 "\t\t$errname = \"SSL_ERROR_?($sslerr)\";"
NSQ_SOURCE_LINE 00001328 "\t      } # end of SWITCH block"
NSQ_SOURCE_LINE 00001329 "\t      if ($errname) { # if we had an errname set add the error"
NSQ_SOURCE_LINE 00001330 "\t\t$errs .= \"ssl_write_all $$: 1 - $errname($wrote,$sslerr,\"."
NSQ_SOURCE_LINE 00001331 "\t\t  \"$errstr,$!)\\n\";"
NSQ_SOURCE_LINE 00001332 "\t      }"
NSQ_SOURCE_LINE 00001333 "\t    } # endif on have SSL_get_error val"
NSQ_SOURCE_LINE 00001334 "\t  } # endif on $wrote defined"
NSQ_SOURCE_LINE 00001335 "\t} # endelse on $wrote > 0"
NSQ_SOURCE_LINE 00001336 "\t$vm = $trace>2 && $linux_debug ?"
NSQ_SOURCE_LINE 00001337 "\t    (split ' ', `cat /proc/$$/stat`)[22] : 'vm_unknown';"
NSQ_SOURCE_LINE 00001338 "\twarn \"  written so far $wrote:$written bytes (VM=$vm)\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001339 "\t# append remaining errors in que and report if errs exist"
NSQ_SOURCE_LINE 00001340 "\t$errs .= print_errs('SSL_write');"
NSQ_SOURCE_LINE 00001341 "\treturn (wantarray ? (undef, $errs) : undef) if $errs;"
NSQ_SOURCE_LINE 00001342 "    }"
NSQ_SOURCE_LINE 00001343 "    return wantarray ? ($written, $errs) : $written;"
NSQ_SOURCE_LINE 00001344 "}"
NSQ_SOURCE_LINE 00001345 ""
