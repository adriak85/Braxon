NSQ_SOURCE_LINE 00000994 "@EXPORT_OK = ( @constants, @functions );"
NSQ_SOURCE_LINE 00000995 ""
NSQ_SOURCE_LINE 00000996 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000997 "    # This AUTOLOAD is used to 'autoload' constants from the constant()"
NSQ_SOURCE_LINE 00000998 "    # XS function.  If a constant is not found then control is passed"
NSQ_SOURCE_LINE 00000999 "    # to the AUTOLOAD in AutoLoader."
NSQ_SOURCE_LINE 00001000 ""
NSQ_SOURCE_LINE 00001001 "    my $constname;"
NSQ_SOURCE_LINE 00001002 "    ($constname = $AUTOLOAD) =~ s/.*:://;"
NSQ_SOURCE_LINE 00001003 "    my $val = constant($constname);"
NSQ_SOURCE_LINE 00001004 "    if ($! != 0) {"
NSQ_SOURCE_LINE 00001005 "\tif ($! =~ /((Invalid)|(not valid))/i || $!{EINVAL}) {"
NSQ_SOURCE_LINE 00001006 "\t    $AutoLoader::AUTOLOAD = $AUTOLOAD;"
NSQ_SOURCE_LINE 00001007 "\t    goto &AutoLoader::AUTOLOAD;"
NSQ_SOURCE_LINE 00001008 "\t}"
NSQ_SOURCE_LINE 00001009 "\telse {"
NSQ_SOURCE_LINE 00001010 "\t  croak \"Your vendor has not defined SSLeay macro $constname\";"
NSQ_SOURCE_LINE 00001011 "\t}"
NSQ_SOURCE_LINE 00001012 "    }"
NSQ_SOURCE_LINE 00001013 "    eval \"sub $AUTOLOAD { $val }\";"
NSQ_SOURCE_LINE 00001014 "    goto &$AUTOLOAD;"
NSQ_SOURCE_LINE 00001015 "}"
NSQ_SOURCE_LINE 00001016 ""
NSQ_SOURCE_LINE 00001017 "eval {"
NSQ_SOURCE_LINE 00001018 "\trequire XSLoader;"
NSQ_SOURCE_LINE 00001019 "\tXSLoader::load('Net::SSLeay', $VERSION);"
NSQ_SOURCE_LINE 00001020 "\t1;"
NSQ_SOURCE_LINE 00001021 "} or do {"
NSQ_SOURCE_LINE 00001022 "\trequire DynaLoader;"
NSQ_SOURCE_LINE 00001023 "\tpush @ISA, 'DynaLoader';"
NSQ_SOURCE_LINE 00001024 "\tbootstrap Net::SSLeay $VERSION;"
NSQ_SOURCE_LINE 00001025 "};"
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "# Preloaded methods go here."
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "$CRLF = \"\\x0d\\x0a\";  # because \\r\\n is not fully portable"
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "### Print SSLeay error stack"
NSQ_SOURCE_LINE 00001032 ""
NSQ_SOURCE_LINE 00001033 "sub print_errs {"
NSQ_SOURCE_LINE 00001034 "    my ($msg) = @_;"
NSQ_SOURCE_LINE 00001035 "    my ($count, $err, $errs, $e) = (0,0,'');"
NSQ_SOURCE_LINE 00001036 "    while ($err = ERR_get_error()) {"
NSQ_SOURCE_LINE 00001037 "        $count ++;"
NSQ_SOURCE_LINE 00001038 "\t$e = \"$msg $$: $count - \" . ERR_error_string($err) . \"\\n\";"
NSQ_SOURCE_LINE 00001039 "\t$errs .= $e;"
NSQ_SOURCE_LINE 00001040 "\twarn $e if $Net::SSLeay::trace;"
NSQ_SOURCE_LINE 00001041 "    }"
NSQ_SOURCE_LINE 00001042 "    return $errs;"
NSQ_SOURCE_LINE 00001043 "}"
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "# Death is conditional to SSLeay errors existing, i.e. this function checks"
NSQ_SOURCE_LINE 00001046 "# for errors and only dies in affirmative."
NSQ_SOURCE_LINE 00001047 "# usage: Net::SSLeay::write($ssl, \"foo\") or die_if_ssl_error(\"SSL write ($!)\");"
NSQ_SOURCE_LINE 00001048 ""
NSQ_SOURCE_LINE 00001049 "sub die_if_ssl_error {"
NSQ_SOURCE_LINE 00001050 "    my ($msg) = @_;"
NSQ_SOURCE_LINE 00001051 "    die \"$$: $msg\\n\" if print_errs($msg);"
NSQ_SOURCE_LINE 00001052 "}"
NSQ_SOURCE_LINE 00001053 ""
NSQ_SOURCE_LINE 00001054 "# Unconditional death. Used to print SSLeay errors before dying."
NSQ_SOURCE_LINE 00001055 "# usage: Net::SSLeay::connect($ssl) or die_now(\"Failed SSL connect ($!)\");"
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "sub die_now {"
NSQ_SOURCE_LINE 00001058 "    my ($msg) = @_;"
NSQ_SOURCE_LINE 00001059 "    print_errs($msg);"
