NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "# 0=no warns, 1=only errors, 2=ciphers, 3=progress, 4=dump data"
NSQ_SOURCE_LINE 00000029 "$Net::SSLeay::trace = 0;  # Do not change here, use"
NSQ_SOURCE_LINE 00000030 "                          # $Net::SSLeay::trace = [1-4]  in caller"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "# 2 = insist on v2 SSL protocol"
NSQ_SOURCE_LINE 00000033 "# 3 = insist on v3 SSL"
NSQ_SOURCE_LINE 00000034 "# 10 = insist on TLSv1"
NSQ_SOURCE_LINE 00000035 "# 11 = insist on TLSv1.1"
NSQ_SOURCE_LINE 00000036 "# 12 = insist on TLSv1.2"
NSQ_SOURCE_LINE 00000037 "# 13 = insist on TLSv1.3"
NSQ_SOURCE_LINE 00000038 "# 0 or undef = guess (v23)"
NSQ_SOURCE_LINE 00000039 "#"
NSQ_SOURCE_LINE 00000040 "$Net::SSLeay::ssl_version = 0;  # don't change here, use"
NSQ_SOURCE_LINE 00000041 "                                # Net::SSLeay::version=[2,3,0] in caller"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "#define to enable the \"cat /proc/$$/stat\" stuff"
NSQ_SOURCE_LINE 00000044 "$Net::SSLeay::linux_debug = 0;"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "# Number of seconds to sleep after sending message and before half"
NSQ_SOURCE_LINE 00000047 "# closing connection. Useful with antiquated broken servers."
NSQ_SOURCE_LINE 00000048 "$Net::SSLeay::slowly = 0;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "# RANDOM NUMBER INITIALIZATION"
NSQ_SOURCE_LINE 00000051 "#"
NSQ_SOURCE_LINE 00000052 "# Edit to your taste. Using /dev/random would be more secure, but may"
NSQ_SOURCE_LINE 00000053 "# block if randomness is not available, thus the default is"
NSQ_SOURCE_LINE 00000054 "# /dev/urandom. $how_random determines how many bits of randomness to take"
NSQ_SOURCE_LINE 00000055 "# from the device. You should take enough (read SSLeay/doc/rand), but"
NSQ_SOURCE_LINE 00000056 "# beware that randomness is limited resource so you should not waste"
NSQ_SOURCE_LINE 00000057 "# it either or you may end up with randomness depletion (situation where"
NSQ_SOURCE_LINE 00000058 "# /dev/random would block and /dev/urandom starts to return predictable"
NSQ_SOURCE_LINE 00000059 "# numbers)."
NSQ_SOURCE_LINE 00000060 "#"
NSQ_SOURCE_LINE 00000061 "# N.B. /dev/urandom does not exist on all systems, such as Solaris 2.6. In that"
NSQ_SOURCE_LINE 00000062 "#      case you should get a third party package that emulates /dev/urandom"
NSQ_SOURCE_LINE 00000063 "#      (e.g. via named pipe) or supply a random number file. Some such"
NSQ_SOURCE_LINE 00000064 "#      packages are documented in Caveat section of the POD documentation."
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "$Net::SSLeay::random_device = '/dev/urandom';"
NSQ_SOURCE_LINE 00000067 "$Net::SSLeay::how_random = 512;"
NSQ_SOURCE_LINE 00000068 ""
