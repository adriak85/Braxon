NSQ_SOURCE_LINE 00001520 "### Quickly print out with whom we're talking"
NSQ_SOURCE_LINE 00001521 ""
NSQ_SOURCE_LINE 00001522 "sub dump_peer_certificate ($) {"
NSQ_SOURCE_LINE 00001523 "    my ($ssl) = @_;"
NSQ_SOURCE_LINE 00001524 "    my $cert = get_peer_certificate($ssl);"
NSQ_SOURCE_LINE 00001525 "    return if print_errs('get_peer_certificate');"
NSQ_SOURCE_LINE 00001526 "    print \"no cert defined\\n\" if !defined($cert);"
NSQ_SOURCE_LINE 00001527 "    # Cipher=NONE with empty cert fix"
NSQ_SOURCE_LINE 00001528 "    if (!defined($cert) || ($cert == 0)) {"
NSQ_SOURCE_LINE 00001529 "\twarn \"cert = `$cert'\\n\" if $trace;"
NSQ_SOURCE_LINE 00001530 "\treturn \"Subject Name: undefined\\nIssuer  Name: undefined\\n\";"
NSQ_SOURCE_LINE 00001531 "    } else {"
NSQ_SOURCE_LINE 00001532 "\tmy $x = 'Subject Name: '"
NSQ_SOURCE_LINE 00001533 "\t    . X509_NAME_oneline(X509_get_subject_name($cert)) . \"\\n\""
NSQ_SOURCE_LINE 00001534 "\t\t. 'Issuer  Name: '"
NSQ_SOURCE_LINE 00001535 "\t\t    . X509_NAME_oneline(X509_get_issuer_name($cert))  . \"\\n\";"
NSQ_SOURCE_LINE 00001536 "\tNet::SSLeay::X509_free($cert);"
NSQ_SOURCE_LINE 00001537 "\treturn $x;"
NSQ_SOURCE_LINE 00001538 "    }"
NSQ_SOURCE_LINE 00001539 "}"
NSQ_SOURCE_LINE 00001540 ""
NSQ_SOURCE_LINE 00001541 "### Arrange some randomness for eay PRNG"
NSQ_SOURCE_LINE 00001542 ""
NSQ_SOURCE_LINE 00001543 "sub randomize (;$$$) {"
NSQ_SOURCE_LINE 00001544 "    my ($rn_seed_file, $seed, $egd_path) = @_;"
NSQ_SOURCE_LINE 00001545 "    my $rnsf = defined($rn_seed_file) && -r $rn_seed_file;"
NSQ_SOURCE_LINE 00001546 ""
NSQ_SOURCE_LINE 00001547 "\t$egd_path = '';"
NSQ_SOURCE_LINE 00001548 "    $egd_path = $ENV{'EGD_PATH'} if $ENV{'EGD_PATH'};"
NSQ_SOURCE_LINE 00001549 ""
NSQ_SOURCE_LINE 00001550 "    RAND_seed(rand() + $$);  # Stir it with time and pid"
NSQ_SOURCE_LINE 00001551 ""
NSQ_SOURCE_LINE 00001552 "    unless ($rnsf || -r $Net::SSLeay::random_device || $seed || -S $egd_path) {"
NSQ_SOURCE_LINE 00001553 "\tmy $poll_retval = Net::SSLeay::RAND_poll();"
NSQ_SOURCE_LINE 00001554 "\twarn \"Random number generator not seeded!!!\" if $trace && !$poll_retval;"
NSQ_SOURCE_LINE 00001555 "    }"
NSQ_SOURCE_LINE 00001556 ""
NSQ_SOURCE_LINE 00001557 "    RAND_load_file($rn_seed_file, -s _) if $rnsf;"
NSQ_SOURCE_LINE 00001558 "    RAND_seed($seed) if $seed;"
NSQ_SOURCE_LINE 00001559 "    RAND_seed($ENV{RND_SEED}) if $ENV{RND_SEED};"
NSQ_SOURCE_LINE 00001560 "    RAND_load_file($Net::SSLeay::random_device, $Net::SSLeay::how_random/8)"
NSQ_SOURCE_LINE 00001561 "\tif -r $Net::SSLeay::random_device;"
NSQ_SOURCE_LINE 00001562 "}"
NSQ_SOURCE_LINE 00001563 ""
NSQ_SOURCE_LINE 00001564 "sub new_x_ctx {"
NSQ_SOURCE_LINE 00001565 "    if ( $ssl_version == 2 ) {"
NSQ_SOURCE_LINE 00001566 "        unless ( exists &Net::SSLeay::CTX_v2_new ) {"
NSQ_SOURCE_LINE 00001567 "            warn \"ssl_version has been set to 2, but this version of libssl has been compiled without SSLv2 support\";"
NSQ_SOURCE_LINE 00001568 "            return undef;"
NSQ_SOURCE_LINE 00001569 "        }"
NSQ_SOURCE_LINE 00001570 "        $ctx = CTX_v2_new();"
NSQ_SOURCE_LINE 00001571 "    }"
NSQ_SOURCE_LINE 00001572 "    elsif ( $ssl_version == 3 ) {"
NSQ_SOURCE_LINE 00001573 "        unless ( exists &Net::SSLeay::CTX_v3_new ) {"
NSQ_SOURCE_LINE 00001574 "            warn 'ssl_version has been set to 3, but this version of libssl has been compiled without SSLv3 support';"
NSQ_SOURCE_LINE 00001575 "            return undef;"
NSQ_SOURCE_LINE 00001576 "        }"
NSQ_SOURCE_LINE 00001577 "        $ctx = CTX_v3_new();"
NSQ_SOURCE_LINE 00001578 "    }"
NSQ_SOURCE_LINE 00001579 "    elsif ( $ssl_version == 10 ) {"
NSQ_SOURCE_LINE 00001580 "        unless ( exists &Net::SSLeay::CTX_tlsv1_new ) {"
NSQ_SOURCE_LINE 00001581 "            warn 'ssl_version has been set to 10, but this version of libssl has been compiled without TLSv1 support';"
NSQ_SOURCE_LINE 00001582 "            return undef;"
NSQ_SOURCE_LINE 00001583 "        }"
NSQ_SOURCE_LINE 00001584 "        $ctx = CTX_tlsv1_new();"
NSQ_SOURCE_LINE 00001585 "    }"
NSQ_SOURCE_LINE 00001586 "    elsif ( $ssl_version == 11 ) {"
NSQ_SOURCE_LINE 00001587 "        unless ( exists &Net::SSLeay::CTX_tlsv1_1_new ) {"
NSQ_SOURCE_LINE 00001588 "            warn 'ssl_version has been set to 11, but this version of libssl has been compiled without TLSv1.1 support';"
NSQ_SOURCE_LINE 00001589 "            return undef;"
NSQ_SOURCE_LINE 00001590 "        }"
NSQ_SOURCE_LINE 00001591 "        $ctx = CTX_tlsv1_1_new();"
NSQ_SOURCE_LINE 00001592 "    }"
NSQ_SOURCE_LINE 00001593 "    elsif ( $ssl_version == 12 ) {"
NSQ_SOURCE_LINE 00001594 "        unless ( exists &Net::SSLeay::CTX_tlsv1_2_new ) {"
NSQ_SOURCE_LINE 00001595 "            warn 'ssl_version has been set to 12, but this version of libssl has been compiled without TLSv1.2 support';"
NSQ_SOURCE_LINE 00001596 "            return undef;"
NSQ_SOURCE_LINE 00001597 "        }"
NSQ_SOURCE_LINE 00001598 "        $ctx = CTX_tlsv1_2_new();"
NSQ_SOURCE_LINE 00001599 "    }"
NSQ_SOURCE_LINE 00001600 "    elsif ( $ssl_version == 13 ) {"
NSQ_SOURCE_LINE 00001601 "        unless ( eval { Net::SSLeay::TLS1_3_VERSION() } ) {"
NSQ_SOURCE_LINE 00001602 "            warn 'ssl_version has been set to 13, but this version of libssl has been compiled without TLSv1.3 support';"
NSQ_SOURCE_LINE 00001603 "            return undef;"
NSQ_SOURCE_LINE 00001604 "        }"
NSQ_SOURCE_LINE 00001605 "        $ctx = CTX_new();"
NSQ_SOURCE_LINE 00001606 "        unless ( Net::SSLeay::CTX_set_min_proto_version( $ctx, Net::SSLeay::TLS1_3_VERSION() ) ) {"
NSQ_SOURCE_LINE 00001607 "            warn 'CTX_set_min_proto failed for TLSv1.3';"
NSQ_SOURCE_LINE 00001608 "            return undef;"
NSQ_SOURCE_LINE 00001609 "        }"
NSQ_SOURCE_LINE 00001610 "        unless ( Net::SSLeay::CTX_set_max_proto_version( $ctx, Net::SSLeay::TLS1_3_VERSION() ) ) {"
NSQ_SOURCE_LINE 00001611 "            warn 'CTX_set_max_proto failed for TLSv1.3';"
NSQ_SOURCE_LINE 00001612 "            return undef;"
NSQ_SOURCE_LINE 00001613 "        }"
NSQ_SOURCE_LINE 00001614 "    }"
NSQ_SOURCE_LINE 00001615 "    else {"
NSQ_SOURCE_LINE 00001616 "        $ctx = CTX_new();"
NSQ_SOURCE_LINE 00001617 "    }"
NSQ_SOURCE_LINE 00001618 "    return $ctx;"
NSQ_SOURCE_LINE 00001619 "}"
NSQ_SOURCE_LINE 00001620 ""
NSQ_SOURCE_LINE 00001621 "###"
NSQ_SOURCE_LINE 00001622 "### Standard initialisation. Initialise the ssl library in the usual way"
NSQ_SOURCE_LINE 00001623 "###  at most once. Override this if you need differnet initialisation"
NSQ_SOURCE_LINE 00001624 "###  SSLeay_add_ssl_algorithms is also protected against multiple runs in SSLeay.xs"
NSQ_SOURCE_LINE 00001625 "###  and is also mutex protected in threading perls"
NSQ_SOURCE_LINE 00001626 "###"
NSQ_SOURCE_LINE 00001627 ""
NSQ_SOURCE_LINE 00001628 "my $library_initialised;"
NSQ_SOURCE_LINE 00001629 "sub initialize"
NSQ_SOURCE_LINE 00001630 "{"
NSQ_SOURCE_LINE 00001631 "    if (!$library_initialised)"
NSQ_SOURCE_LINE 00001632 "    {"
NSQ_SOURCE_LINE 00001633 "\tload_error_strings();         # Some bloat, but I'm after ease of use"
NSQ_SOURCE_LINE 00001634 "\tSSLeay_add_ssl_algorithms();  # and debuggability."
NSQ_SOURCE_LINE 00001635 "\trandomize();"
NSQ_SOURCE_LINE 00001636 "\t$library_initialised++;"
NSQ_SOURCE_LINE 00001637 "    }"
NSQ_SOURCE_LINE 00001638 "}"
NSQ_SOURCE_LINE 00001639 ""
NSQ_SOURCE_LINE 00001640 "###"
NSQ_SOURCE_LINE 00001641 "### Basic request - response primitive (don't use for https)"
NSQ_SOURCE_LINE 00001642 "###"
NSQ_SOURCE_LINE 00001643 ""
NSQ_SOURCE_LINE 00001644 "sub sslcat { # address, port, message, $crt, $key --> reply / (reply,errs,cert)"
NSQ_SOURCE_LINE 00001645 "    my ($dest_serv, $port, $out_message, $crt_path, $key_path) = @_;"
NSQ_SOURCE_LINE 00001646 "    my ($ctx, $ssl, $got, $errs, $written);"
NSQ_SOURCE_LINE 00001647 ""
NSQ_SOURCE_LINE 00001648 "    ($got, $errs) = open_proxy_tcp_connection($dest_serv, $port);"
NSQ_SOURCE_LINE 00001649 "    return (wantarray ? (undef, $errs) : undef) unless $got;"
NSQ_SOURCE_LINE 00001650 ""
NSQ_SOURCE_LINE 00001651 "    ### Do SSL negotiation stuff"
NSQ_SOURCE_LINE 00001652 ""
NSQ_SOURCE_LINE 00001653 "    warn \"Creating SSL $ssl_version context...\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001654 "    initialize(); # Will init at most once"
NSQ_SOURCE_LINE 00001655 ""
NSQ_SOURCE_LINE 00001656 "    $ctx = new_x_ctx();"
NSQ_SOURCE_LINE 00001657 "    goto cleanup2 if $errs = print_errs('CTX_new') or !$ctx;"
NSQ_SOURCE_LINE 00001658 ""
NSQ_SOURCE_LINE 00001659 "    CTX_set_options($ctx, &OP_ALL);"
NSQ_SOURCE_LINE 00001660 "    goto cleanup2 if $errs = print_errs('CTX_set_options');"
NSQ_SOURCE_LINE 00001661 ""
NSQ_SOURCE_LINE 00001662 "    warn \"Cert `$crt_path' given without key\" if $crt_path && !$key_path;"
NSQ_SOURCE_LINE 00001663 "    set_cert_and_key($ctx, $crt_path, $key_path) if $crt_path;"
NSQ_SOURCE_LINE 00001664 ""
NSQ_SOURCE_LINE 00001665 "    warn \"Creating SSL connection (context was '$ctx')...\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001666 "    $ssl = new($ctx);"
NSQ_SOURCE_LINE 00001667 "    goto cleanup if $errs = print_errs('SSL_new') or !$ssl;"
NSQ_SOURCE_LINE 00001668 ""
NSQ_SOURCE_LINE 00001669 "    warn \"Setting fd (ctx $ctx, con $ssl)...\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001670 "    set_fd($ssl, fileno(SSLCAT_S));"
NSQ_SOURCE_LINE 00001671 "    goto cleanup if $errs = print_errs('set_fd');"
NSQ_SOURCE_LINE 00001672 ""
NSQ_SOURCE_LINE 00001673 "    warn \"Entering SSL negotiation phase...\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001674 ""
NSQ_SOURCE_LINE 00001675 "    if ($trace>2) {"
NSQ_SOURCE_LINE 00001676 "\tmy $i = 0;"
NSQ_SOURCE_LINE 00001677 "\tmy $p = '';"
NSQ_SOURCE_LINE 00001678 "\tmy $cipher_list = 'Cipher list: ';"
NSQ_SOURCE_LINE 00001679 "\t$p=Net::SSLeay::get_cipher_list($ssl,$i);"
NSQ_SOURCE_LINE 00001680 "\t$cipher_list .= $p if $p;"
NSQ_SOURCE_LINE 00001681 "\tdo {"
NSQ_SOURCE_LINE 00001682 "\t    $i++;"
NSQ_SOURCE_LINE 00001683 "\t    $cipher_list .= ', ' . $p if $p;"
NSQ_SOURCE_LINE 00001684 "\t    $p=Net::SSLeay::get_cipher_list($ssl,$i);"
NSQ_SOURCE_LINE 00001685 "\t} while $p;"
NSQ_SOURCE_LINE 00001686 "\t$cipher_list .= '\\n';"
NSQ_SOURCE_LINE 00001687 "\twarn $cipher_list;"
NSQ_SOURCE_LINE 00001688 "    }"
NSQ_SOURCE_LINE 00001689 ""
NSQ_SOURCE_LINE 00001690 "    $got = Net::SSLeay::connect($ssl);"
NSQ_SOURCE_LINE 00001691 "    warn \"SSLeay connect returned $got\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001692 "    goto cleanup if $errs = print_errs('SSL_connect');"
NSQ_SOURCE_LINE 00001693 ""
NSQ_SOURCE_LINE 00001694 "    my $server_cert = get_peer_certificate($ssl);"
NSQ_SOURCE_LINE 00001695 "    print_errs('get_peer_certificate');"
NSQ_SOURCE_LINE 00001696 "    if ($trace>1) {"
NSQ_SOURCE_LINE 00001697 "\twarn \"Cipher `\" . get_cipher($ssl) . \"'\\n\";"
NSQ_SOURCE_LINE 00001698 "\tprint_errs('get_ciper');"
NSQ_SOURCE_LINE 00001699 "\twarn dump_peer_certificate($ssl);"
NSQ_SOURCE_LINE 00001700 "    }"
NSQ_SOURCE_LINE 00001701 ""
NSQ_SOURCE_LINE 00001702 "    ### Connected. Exchange some data (doing repeated tries if necessary)."
NSQ_SOURCE_LINE 00001703 ""
NSQ_SOURCE_LINE 00001704 "    warn \"sslcat $$: sending \" . blength($out_message) . \" bytes...\\n\""
NSQ_SOURCE_LINE 00001705 "\tif $trace==3;"
NSQ_SOURCE_LINE 00001706 "    warn \"sslcat $$: sending `$out_message' (\" . blength($out_message)"
NSQ_SOURCE_LINE 00001707 "\t. \" bytes)...\\n\" if $trace>3;"
NSQ_SOURCE_LINE 00001708 "    ($written, $errs) = ssl_write_all($ssl, $out_message);"
NSQ_SOURCE_LINE 00001709 "    goto cleanup unless $written;"
NSQ_SOURCE_LINE 00001710 ""
NSQ_SOURCE_LINE 00001711 "    sleep $slowly if $slowly;  # Closing too soon can abort broken servers"
NSQ_SOURCE_LINE 00001712 "    Net::SSLeay::shutdown($ssl); # Useful starting with OpenSSL 1.1.1e"
NSQ_SOURCE_LINE 00001713 "    CORE::shutdown SSLCAT_S, 1;  # Half close --> No more output, send EOF to server"
NSQ_SOURCE_LINE 00001714 ""
NSQ_SOURCE_LINE 00001715 "    warn \"waiting for reply...\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001716 "    ($got, $errs) = ssl_read_all($ssl);"
NSQ_SOURCE_LINE 00001717 "    warn \"Got \" . blength($got) . \" bytes.\\n\" if $trace==3;"
NSQ_SOURCE_LINE 00001718 "    warn \"Got `$got' (\" . blength($got) . \" bytes)\\n\" if $trace>3;"
NSQ_SOURCE_LINE 00001719 ""
NSQ_SOURCE_LINE 00001720 "cleanup:"
NSQ_SOURCE_LINE 00001721 "    free ($ssl);"
NSQ_SOURCE_LINE 00001722 "    $errs .= print_errs('SSL_free');"
NSQ_SOURCE_LINE 00001723 "cleanup2:"
NSQ_SOURCE_LINE 00001724 "    CTX_free ($ctx);"
NSQ_SOURCE_LINE 00001725 "    $errs .= print_errs('CTX_free');"
NSQ_SOURCE_LINE 00001726 "    close SSLCAT_S;"
NSQ_SOURCE_LINE 00001727 "    return wantarray ? ($got, $errs, $server_cert) : $got;"
NSQ_SOURCE_LINE 00001728 "}"
NSQ_SOURCE_LINE 00001729 ""
NSQ_SOURCE_LINE 00001730 "sub tcpcat { # address, port, message, $crt, $key --> reply / (reply,errs,cert)"
NSQ_SOURCE_LINE 00001731 "    my ($dest_serv, $port, $out_message) = @_;"
NSQ_SOURCE_LINE 00001732 "    my ($got, $errs, $written);"
NSQ_SOURCE_LINE 00001733 ""
NSQ_SOURCE_LINE 00001734 "    ($got, $errs) = open_proxy_tcp_connection($dest_serv, $port);"
NSQ_SOURCE_LINE 00001735 "    return (wantarray ? (undef, $errs) : undef) unless $got;"
NSQ_SOURCE_LINE 00001736 ""
NSQ_SOURCE_LINE 00001737 "    ### Connected. Exchange some data (doing repeated tries if necessary)."
NSQ_SOURCE_LINE 00001738 ""
NSQ_SOURCE_LINE 00001739 "    warn \"tcpcat $$: sending \" . blength($out_message) . \" bytes...\\n\""
NSQ_SOURCE_LINE 00001740 "\tif $trace==3;"
NSQ_SOURCE_LINE 00001741 "    warn \"tcpcat $$: sending `$out_message' (\" . blength($out_message)"
NSQ_SOURCE_LINE 00001742 "\t. \" bytes)...\\n\" if $trace>3;"
NSQ_SOURCE_LINE 00001743 "    ($written, $errs) = tcp_write_all($out_message);"
NSQ_SOURCE_LINE 00001744 "    goto cleanup unless $written;"
NSQ_SOURCE_LINE 00001745 ""
NSQ_SOURCE_LINE 00001746 "    sleep $slowly if $slowly;  # Closing too soon can abort broken servers"
NSQ_SOURCE_LINE 00001747 "    CORE::shutdown SSLCAT_S, 1;  # Half close --> No more output, send EOF to server"
NSQ_SOURCE_LINE 00001748 ""
NSQ_SOURCE_LINE 00001749 "    warn \"waiting for reply...\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001750 "    ($got, $errs) = tcp_read_all();"
NSQ_SOURCE_LINE 00001751 "    warn \"Got \" . blength($got) . \" bytes.\\n\" if $trace==3;"
NSQ_SOURCE_LINE 00001752 "    warn \"Got `$got' (\" . blength($got) . \" bytes)\\n\" if $trace>3;"
NSQ_SOURCE_LINE 00001753 ""
NSQ_SOURCE_LINE 00001754 "cleanup:"
NSQ_SOURCE_LINE 00001755 "    close SSLCAT_S;"
NSQ_SOURCE_LINE 00001756 "    return wantarray ? ($got, $errs) : $got;"
NSQ_SOURCE_LINE 00001757 "}"
NSQ_SOURCE_LINE 00001758 ""
NSQ_SOURCE_LINE 00001759 "sub tcpxcat {"
NSQ_SOURCE_LINE 00001760 "    my ($usessl, $site, $port, $req, $crt_path, $key_path) = @_;"
NSQ_SOURCE_LINE 00001761 "    if ($usessl) {"
NSQ_SOURCE_LINE 00001762 "\treturn sslcat($site, $port, $req, $crt_path, $key_path);"
NSQ_SOURCE_LINE 00001763 "    } else {"
NSQ_SOURCE_LINE 00001764 "\treturn tcpcat($site, $port, $req);"
NSQ_SOURCE_LINE 00001765 "    }"
NSQ_SOURCE_LINE 00001766 "}"
NSQ_SOURCE_LINE 00001767 ""
NSQ_SOURCE_LINE 00001768 "###"
NSQ_SOURCE_LINE 00001769 "### Basic request - response primitive, this is different from sslcat"
NSQ_SOURCE_LINE 00001770 "###                 because this does not shutdown the connection."
NSQ_SOURCE_LINE 00001771 "###"
NSQ_SOURCE_LINE 00001772 ""
NSQ_SOURCE_LINE 00001773 "sub https_cat { # address, port, message --> returns reply / (reply,errs,cert)"
NSQ_SOURCE_LINE 00001774 "    my ($dest_serv, $port, $out_message, $crt_path, $key_path) = @_;"
NSQ_SOURCE_LINE 00001775 "    my ($ctx, $ssl, $got, $errs, $written);"
NSQ_SOURCE_LINE 00001776 ""
NSQ_SOURCE_LINE 00001777 "    ($got, $errs) = open_proxy_tcp_connection($dest_serv, $port);"
NSQ_SOURCE_LINE 00001778 "    return (wantarray ? (undef, $errs) : undef) unless $got;"
NSQ_SOURCE_LINE 00001779 ""
NSQ_SOURCE_LINE 00001780 "    ### Do SSL negotiation stuff"
NSQ_SOURCE_LINE 00001781 ""
NSQ_SOURCE_LINE 00001782 "    warn \"Creating SSL $ssl_version context...\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001783 "    initialize();"
NSQ_SOURCE_LINE 00001784 ""
NSQ_SOURCE_LINE 00001785 "    $ctx = new_x_ctx();"
NSQ_SOURCE_LINE 00001786 "    goto cleanup2 if $errs = print_errs('CTX_new') or !$ctx;"
NSQ_SOURCE_LINE 00001787 ""
NSQ_SOURCE_LINE 00001788 "    CTX_set_options($ctx, &OP_ALL);"
NSQ_SOURCE_LINE 00001789 "    goto cleanup2 if $errs = print_errs('CTX_set_options');"
NSQ_SOURCE_LINE 00001790 ""
NSQ_SOURCE_LINE 00001791 "    warn \"Cert `$crt_path' given without key\" if $crt_path && !$key_path;"
NSQ_SOURCE_LINE 00001792 "    set_cert_and_key($ctx, $crt_path, $key_path) if $crt_path;"
NSQ_SOURCE_LINE 00001793 ""
NSQ_SOURCE_LINE 00001794 "    warn \"Creating SSL connection (context was '$ctx')...\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001795 "    $ssl = new($ctx);"
NSQ_SOURCE_LINE 00001796 "    goto cleanup if $errs = print_errs('SSL_new') or !$ssl;"
NSQ_SOURCE_LINE 00001797 ""
NSQ_SOURCE_LINE 00001798 "    warn \"Setting fd (ctx $ctx, con $ssl)...\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001799 "    set_fd($ssl, fileno(SSLCAT_S));"
NSQ_SOURCE_LINE 00001800 "    goto cleanup if $errs = print_errs('set_fd');"
NSQ_SOURCE_LINE 00001801 ""
NSQ_SOURCE_LINE 00001802 "    warn \"Entering SSL negotiation phase...\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001803 ""
NSQ_SOURCE_LINE 00001804 "    if ($trace>2) {"
NSQ_SOURCE_LINE 00001805 "\tmy $i = 0;"
NSQ_SOURCE_LINE 00001806 "\tmy $p = '';"
NSQ_SOURCE_LINE 00001807 "\tmy $cipher_list = 'Cipher list: ';"
NSQ_SOURCE_LINE 00001808 "\t$p=Net::SSLeay::get_cipher_list($ssl,$i);"
NSQ_SOURCE_LINE 00001809 "\t$cipher_list .= $p if $p;"
NSQ_SOURCE_LINE 00001810 "\tdo {"
NSQ_SOURCE_LINE 00001811 "\t    $i++;"
NSQ_SOURCE_LINE 00001812 "\t    $cipher_list .= ', ' . $p if $p;"
NSQ_SOURCE_LINE 00001813 "\t    $p=Net::SSLeay::get_cipher_list($ssl,$i);"
NSQ_SOURCE_LINE 00001814 "\t} while $p;"
NSQ_SOURCE_LINE 00001815 "\t$cipher_list .= '\\n';"
NSQ_SOURCE_LINE 00001816 "\twarn $cipher_list;"
NSQ_SOURCE_LINE 00001817 "    }"
NSQ_SOURCE_LINE 00001818 ""
NSQ_SOURCE_LINE 00001819 "    $got = Net::SSLeay::connect($ssl);"
NSQ_SOURCE_LINE 00001820 "    warn \"SSLeay connect failed\" if $trace>2 && $got==0;"
NSQ_SOURCE_LINE 00001821 "    goto cleanup if $errs = print_errs('SSL_connect');"
NSQ_SOURCE_LINE 00001822 ""
NSQ_SOURCE_LINE 00001823 "    my $server_cert = get_peer_certificate($ssl);"
NSQ_SOURCE_LINE 00001824 "    print_errs('get_peer_certificate');"
NSQ_SOURCE_LINE 00001825 "    if ($trace>1) {"
NSQ_SOURCE_LINE 00001826 "\twarn \"Cipher `\" . get_cipher($ssl) . \"'\\n\";"
NSQ_SOURCE_LINE 00001827 "\tprint_errs('get_ciper');"
NSQ_SOURCE_LINE 00001828 "\twarn dump_peer_certificate($ssl);"
NSQ_SOURCE_LINE 00001829 "    }"
NSQ_SOURCE_LINE 00001830 ""
NSQ_SOURCE_LINE 00001831 "    ### Connected. Exchange some data (doing repeated tries if necessary)."
NSQ_SOURCE_LINE 00001832 ""
NSQ_SOURCE_LINE 00001833 "    warn \"https_cat $$: sending \" . blength($out_message) . \" bytes...\\n\""
NSQ_SOURCE_LINE 00001834 "\tif $trace==3;"
NSQ_SOURCE_LINE 00001835 "    warn \"https_cat $$: sending `$out_message' (\" . blength($out_message)"
NSQ_SOURCE_LINE 00001836 "\t. \" bytes)...\\n\" if $trace>3;"
NSQ_SOURCE_LINE 00001837 "    ($written, $errs) = ssl_write_all($ssl, $out_message);"
NSQ_SOURCE_LINE 00001838 "    goto cleanup unless $written;"
NSQ_SOURCE_LINE 00001839 ""
NSQ_SOURCE_LINE 00001840 "    warn \"waiting for reply...\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001841 "    ($got, $errs) = ssl_read_all($ssl);"
NSQ_SOURCE_LINE 00001842 "    warn \"Got \" . blength($got) . \" bytes.\\n\" if $trace==3;"
NSQ_SOURCE_LINE 00001843 "    warn \"Got `$got' (\" . blength($got) . \" bytes)\\n\" if $trace>3;"
NSQ_SOURCE_LINE 00001844 ""
NSQ_SOURCE_LINE 00001845 "cleanup:"
NSQ_SOURCE_LINE 00001846 "    free ($ssl);"
NSQ_SOURCE_LINE 00001847 "    $errs .= print_errs('SSL_free');"
NSQ_SOURCE_LINE 00001848 "cleanup2:"
NSQ_SOURCE_LINE 00001849 "    CTX_free ($ctx);"
NSQ_SOURCE_LINE 00001850 "    $errs .= print_errs('CTX_free');"
NSQ_SOURCE_LINE 00001851 "    close SSLCAT_S;"
NSQ_SOURCE_LINE 00001852 "    return wantarray ? ($got, $errs, $server_cert) : $got;"
NSQ_SOURCE_LINE 00001853 "}"
NSQ_SOURCE_LINE 00001854 ""
NSQ_SOURCE_LINE 00001855 "sub http_cat { # address, port, message --> returns reply / (reply,errs,cert)"
NSQ_SOURCE_LINE 00001856 "    my ($dest_serv, $port, $out_message) = @_;"
NSQ_SOURCE_LINE 00001857 "    my ($got, $errs, $written);"
NSQ_SOURCE_LINE 00001858 ""
NSQ_SOURCE_LINE 00001859 "    ($got, $errs) = open_proxy_tcp_connection($dest_serv, $port);"
NSQ_SOURCE_LINE 00001860 "    return (wantarray ? (undef, $errs) : undef) unless $got;"
NSQ_SOURCE_LINE 00001861 ""
NSQ_SOURCE_LINE 00001862 "    ### Connected. Exchange some data (doing repeated tries if necessary)."
NSQ_SOURCE_LINE 00001863 ""
NSQ_SOURCE_LINE 00001864 "    warn \"http_cat $$: sending \" . blength($out_message) . \" bytes...\\n\""
NSQ_SOURCE_LINE 00001865 "\tif $trace==3;"
NSQ_SOURCE_LINE 00001866 "    warn \"http_cat $$: sending `$out_message' (\" . blength($out_message)"
NSQ_SOURCE_LINE 00001867 "\t. \" bytes)...\\n\" if $trace>3;"
NSQ_SOURCE_LINE 00001868 "    ($written, $errs) = tcp_write_all($out_message);"
NSQ_SOURCE_LINE 00001869 "    goto cleanup unless $written;"
NSQ_SOURCE_LINE 00001870 ""
NSQ_SOURCE_LINE 00001871 "    warn \"waiting for reply...\\n\" if $trace>2;"
NSQ_SOURCE_LINE 00001872 "    ($got, $errs) = tcp_read_all();"
NSQ_SOURCE_LINE 00001873 "    warn \"Got \" . blength($got) . \" bytes.\\n\" if $trace==3;"
NSQ_SOURCE_LINE 00001874 "    warn \"Got `$got' (\" . blength($got) . \" bytes)\\n\" if $trace>3;"
NSQ_SOURCE_LINE 00001875 ""
NSQ_SOURCE_LINE 00001876 "cleanup:"
NSQ_SOURCE_LINE 00001877 "    close SSLCAT_S;"
NSQ_SOURCE_LINE 00001878 "    return wantarray ? ($got, $errs) : $got;"
