NSQ_SOURCE_LINE 00001374 "### from patch by Clinton Wong <clintdw@netcom.com>"
NSQ_SOURCE_LINE 00001375 ""
NSQ_SOURCE_LINE 00001376 "# ssl_read_until($ssl [, $delimit [, $max_length]])"
NSQ_SOURCE_LINE 00001377 "#  if $delimit missing, use $/ if it exists, otherwise use \\n"
NSQ_SOURCE_LINE 00001378 "#  read until delimiter reached, up to $max_length chars if defined"
NSQ_SOURCE_LINE 00001379 ""
NSQ_SOURCE_LINE 00001380 "sub ssl_read_until ($;$$) {"
NSQ_SOURCE_LINE 00001381 "    my ($ssl,$delim, $max_length) = @_;"
NSQ_SOURCE_LINE 00001382 ""
NSQ_SOURCE_LINE 00001383 "    # guess the delim string if missing"
NSQ_SOURCE_LINE 00001384 "    if ( ! defined $delim ) {"
NSQ_SOURCE_LINE 00001385 "      if ( defined $/ && length $/  ) { $delim = $/ }"
NSQ_SOURCE_LINE 00001386 "      else { $delim = \"\\n\" }      # Note: \\n,$/ value depends on the platform"
NSQ_SOURCE_LINE 00001387 "    }"
NSQ_SOURCE_LINE 00001388 "    my $len_delim = length $delim;"
NSQ_SOURCE_LINE 00001389 ""
NSQ_SOURCE_LINE 00001390 "    my ($got);"
NSQ_SOURCE_LINE 00001391 "    my $reply = '';"
NSQ_SOURCE_LINE 00001392 ""
NSQ_SOURCE_LINE 00001393 "    # If we have OpenSSL 0.9.6a or later, we can use SSL_peek to"
NSQ_SOURCE_LINE 00001394 "    # speed things up."
NSQ_SOURCE_LINE 00001395 "    # N.B. 0.9.6a has security problems, so the support for"
NSQ_SOURCE_LINE 00001396 "    #      anything earlier than 0.9.6e will be dropped soon."
NSQ_SOURCE_LINE 00001397 "    if (&Net::SSLeay::OPENSSL_VERSION_NUMBER >= 0x0090601f) {"
NSQ_SOURCE_LINE 00001398 "\t$max_length = 2000000000 unless (defined $max_length);"
NSQ_SOURCE_LINE 00001399 "\tmy ($pending, $peek_length, $found, $done);"
NSQ_SOURCE_LINE 00001400 "\twhile (blength($reply) < $max_length and !$done) {"
NSQ_SOURCE_LINE 00001401 "\t    #Block if necessary until we get some data"
NSQ_SOURCE_LINE 00001402 "\t    $got = Net::SSLeay::peek($ssl,1);"
NSQ_SOURCE_LINE 00001403 "\t    last if print_errs('SSL_peek');"
NSQ_SOURCE_LINE 00001404 ""
NSQ_SOURCE_LINE 00001405 "\t    $pending = Net::SSLeay::pending($ssl) + blength($reply);"
NSQ_SOURCE_LINE 00001406 "\t    $peek_length = ($pending > $max_length) ? $max_length : $pending;"
NSQ_SOURCE_LINE 00001407 "\t    $peek_length -= blength($reply);"
NSQ_SOURCE_LINE 00001408 "\t    $got = Net::SSLeay::peek($ssl, $peek_length);"
NSQ_SOURCE_LINE 00001409 "\t    last if print_errs('SSL_peek');"
NSQ_SOURCE_LINE 00001410 "\t    $peek_length = blength($got);"
NSQ_SOURCE_LINE 00001411 ""
NSQ_SOURCE_LINE 00001412 "\t    #$found = index($got, $delim);  # Old and broken"
NSQ_SOURCE_LINE 00001413 ""
NSQ_SOURCE_LINE 00001414 "\t    # the delimiter may be split across two gets, so we prepend"
NSQ_SOURCE_LINE 00001415 "\t    # a little from the last get onto this one before we check"
NSQ_SOURCE_LINE 00001416 "\t    # for a match"
NSQ_SOURCE_LINE 00001417 "\t    my $match;"
NSQ_SOURCE_LINE 00001418 "\t    if(blength($reply) >= blength($delim) - 1) {"
NSQ_SOURCE_LINE 00001419 "\t\t#if what we've read so far is greater or equal"
NSQ_SOURCE_LINE 00001420 "\t\t#in length of what we need to prepatch"
NSQ_SOURCE_LINE 00001421 "\t\t$match = substr $reply, blength($reply) - blength($delim) + 1;"
NSQ_SOURCE_LINE 00001422 "\t    } else {"
NSQ_SOURCE_LINE 00001423 "\t\t$match = $reply;"
NSQ_SOURCE_LINE 00001424 "\t    }"
NSQ_SOURCE_LINE 00001425 ""
NSQ_SOURCE_LINE 00001426 "\t    $match .= $got;"
NSQ_SOURCE_LINE 00001427 "\t    $found = index($match, $delim);"
NSQ_SOURCE_LINE 00001428 ""
NSQ_SOURCE_LINE 00001429 "\t    if ($found > -1) {"
NSQ_SOURCE_LINE 00001430 "\t\t#$got = Net::SSLeay::ssl_read_all($ssl, $found+$len_delim);"
NSQ_SOURCE_LINE 00001431 "\t\t#read up to the end of the delimiter"
NSQ_SOURCE_LINE 00001432 "\t\t$got = Net::SSLeay::ssl_read_all($ssl,"
NSQ_SOURCE_LINE 00001433 "\t\t\t\t\t $found + $len_delim"
NSQ_SOURCE_LINE 00001434 "\t\t\t\t\t - ((blength($match)) - (blength($got))));"
NSQ_SOURCE_LINE 00001435 "\t\t$done = 1;"
NSQ_SOURCE_LINE 00001436 "\t    } else {"
NSQ_SOURCE_LINE 00001437 "\t\t$got = Net::SSLeay::ssl_read_all($ssl, $peek_length);"
NSQ_SOURCE_LINE 00001438 "\t\t$done = 1 if ($peek_length == $max_length - blength($reply));"
NSQ_SOURCE_LINE 00001439 "\t    }"
NSQ_SOURCE_LINE 00001440 ""
NSQ_SOURCE_LINE 00001441 "\t    last if print_errs('SSL_read');"
NSQ_SOURCE_LINE 00001442 "\t    debug_read(\\$reply, \\$got) if $trace>1;"
NSQ_SOURCE_LINE 00001443 "\t    last if $got eq '';"
NSQ_SOURCE_LINE 00001444 "\t    $reply .= $got;"
NSQ_SOURCE_LINE 00001445 "\t}"
NSQ_SOURCE_LINE 00001446 "    } else {"
NSQ_SOURCE_LINE 00001447 "\twhile (!defined $max_length || length $reply < $max_length) {"
NSQ_SOURCE_LINE 00001448 "\t    $got = Net::SSLeay::ssl_read_all($ssl,1);  # one by one"
NSQ_SOURCE_LINE 00001449 "\t    last if print_errs('SSL_read');"
NSQ_SOURCE_LINE 00001450 "\t    debug_read(\\$reply, \\$got) if $trace>1;"
NSQ_SOURCE_LINE 00001451 "\t    last if $got eq '';"
NSQ_SOURCE_LINE 00001452 "\t    $reply .= $got;"
NSQ_SOURCE_LINE 00001453 "\t    last if $len_delim"
NSQ_SOURCE_LINE 00001454 "\t\t&& substr($reply, blength($reply)-$len_delim) eq $delim;"
NSQ_SOURCE_LINE 00001455 "\t}"
NSQ_SOURCE_LINE 00001456 "    }"
NSQ_SOURCE_LINE 00001457 "    return $reply;"
NSQ_SOURCE_LINE 00001458 "}"
NSQ_SOURCE_LINE 00001459 ""
NSQ_SOURCE_LINE 00001460 "sub tcp_read_until {"
NSQ_SOURCE_LINE 00001461 "    my ($delim, $max_length) = @_;"
NSQ_SOURCE_LINE 00001462 ""
NSQ_SOURCE_LINE 00001463 "    # guess the delim string if missing"
NSQ_SOURCE_LINE 00001464 "    if ( ! defined $delim ) {"
NSQ_SOURCE_LINE 00001465 "      if ( defined $/ && length $/  ) { $delim = $/ }"
NSQ_SOURCE_LINE 00001466 "      else { $delim = \"\\n\" }      # Note: \\n,$/ value depends on the platform"
NSQ_SOURCE_LINE 00001467 "    }"
NSQ_SOURCE_LINE 00001468 "    my $len_delim = length $delim;"
NSQ_SOURCE_LINE 00001469 ""
NSQ_SOURCE_LINE 00001470 "    my ($n,$got);"
NSQ_SOURCE_LINE 00001471 "    my $reply = '';"
NSQ_SOURCE_LINE 00001472 ""
NSQ_SOURCE_LINE 00001473 "    while (!defined $max_length || length $reply < $max_length) {"
NSQ_SOURCE_LINE 00001474 "\t$n = sysread(SSLCAT_S, $got, 1);  # one by one"
NSQ_SOURCE_LINE 00001475 "\twarn \"tcp_read_until: $!\" if !defined $n;"
NSQ_SOURCE_LINE 00001476 "\tdebug_read(\\$reply, \\$got) if $trace>1;"
NSQ_SOURCE_LINE 00001477 "\tlast if !$n;  # EOF"
NSQ_SOURCE_LINE 00001478 "\t$reply .= $got;"
NSQ_SOURCE_LINE 00001479 "\tlast if $len_delim"
NSQ_SOURCE_LINE 00001480 "\t    && substr($reply, blength($reply)-$len_delim) eq $delim;"
NSQ_SOURCE_LINE 00001481 "    }"
NSQ_SOURCE_LINE 00001482 "    return $reply;"
NSQ_SOURCE_LINE 00001483 "}"
NSQ_SOURCE_LINE 00001484 ""
NSQ_SOURCE_LINE 00001485 "# ssl_read_CRLF($ssl [, $max_length])"
NSQ_SOURCE_LINE 00001486 "sub ssl_read_CRLF ($;$) { ssl_read_until($_[0], $CRLF, $_[1]) }"
NSQ_SOURCE_LINE 00001487 "sub tcp_read_CRLF { tcp_read_until($CRLF, $_[0]) }"
NSQ_SOURCE_LINE 00001488 ""
NSQ_SOURCE_LINE 00001489 "# ssl_write_CRLF($ssl, $message) writes $message and appends CRLF"
NSQ_SOURCE_LINE 00001490 "sub ssl_write_CRLF ($$) {"
NSQ_SOURCE_LINE 00001491 "  # the next line uses less memory but might use more network packets"
NSQ_SOURCE_LINE 00001492 "  return ssl_write_all($_[0], $_[1]) + ssl_write_all($_[0], $CRLF);"
NSQ_SOURCE_LINE 00001493 ""
NSQ_SOURCE_LINE 00001494 "  # the next few lines do the same thing at the expense of memory, with"
NSQ_SOURCE_LINE 00001495 "  # the chance that it will use less packets, since CRLF is in the original"
NSQ_SOURCE_LINE 00001496 "  # message and won't be sent separately."
NSQ_SOURCE_LINE 00001497 ""
