BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Params::Util;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "=pod"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "=head1 NAME"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "Params::Util - Simple, compact and correct param-checking functions"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "  # Import some functions"
NSQ_SOURCE_LINE 00000012 "  use Params::Util qw{_SCALAR _HASH _INSTANCE};"
NSQ_SOURCE_LINE 00000013 "  "
NSQ_SOURCE_LINE 00000014 "  # If you are lazy, or need a lot of them..."
NSQ_SOURCE_LINE 00000015 "  use Params::Util ':ALL';"
NSQ_SOURCE_LINE 00000016 "  "
NSQ_SOURCE_LINE 00000017 "  sub foo {"
NSQ_SOURCE_LINE 00000018 "      my $object  = _INSTANCE(shift, 'Foo') or return undef;"
NSQ_SOURCE_LINE 00000019 "      my $image   = _SCALAR(shift)          or return undef;"
NSQ_SOURCE_LINE 00000020 "      my $options = _HASH(shift)            or return undef;"
NSQ_SOURCE_LINE 00000021 "      # etc..."
NSQ_SOURCE_LINE 00000022 "  }"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "C<Params::Util> provides a basic set of importable functions that makes"
NSQ_SOURCE_LINE 00000027 "checking parameters a hell of a lot easier"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "While they can be (and are) used in other contexts, the main point"
NSQ_SOURCE_LINE 00000030 "behind this module is that the functions B<both> Do What You Mean,"
NSQ_SOURCE_LINE 00000031 "and Do The Right Thing, so they are most useful when you are getting"
NSQ_SOURCE_LINE 00000032 "params passed into your code from someone and/or somewhere else"
NSQ_SOURCE_LINE 00000033 "and you can't really trust the quality."
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "Thus, C<Params::Util> is of most use at the edges of your API, where"
NSQ_SOURCE_LINE 00000036 "params and data are coming in from outside your code."
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "The functions provided by C<Params::Util> check in the most strictly"
NSQ_SOURCE_LINE 00000039 "correct manner known, are documented as thoroughly as possible so their"
NSQ_SOURCE_LINE 00000040 "exact behaviour is clear, and heavily tested so make sure they are not"
NSQ_SOURCE_LINE 00000041 "fooled by weird data and Really Bad Things."
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "To use, simply load the module providing the functions you want to use"
NSQ_SOURCE_LINE 00000044 "as arguments (as shown in the SYNOPSIS)."
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "To aid in maintainability, C<Params::Util> will B<never> export by"
NSQ_SOURCE_LINE 00000047 "default."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "You must explicitly name the functions you want to export, or use the"
NSQ_SOURCE_LINE 00000050 "C<:ALL> param to just have it export everything (although this is not"
NSQ_SOURCE_LINE 00000051 "recommended if you have any _FOO functions yourself with which future"
NSQ_SOURCE_LINE 00000052 "additions to C<Params::Util> may clash)"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=cut"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "use 5.00503;"
NSQ_SOURCE_LINE 00000059 "use strict;"
NSQ_SOURCE_LINE 00000060 "use warnings;"
NSQ_SOURCE_LINE 00000061 "use parent qw{Exporter XSLoader};"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "use Params::Util::PP qw();"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "our $VERSION = '1.102';"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "local $ENV{PERL_DL_NONLAZY} = 0 if $ENV{PERL_DL_NONLAZY};"
NSQ_SOURCE_LINE 00000068 "XSLoader::load(\"Params::Util\", $VERSION) unless $ENV{PERL_PARAMS_UTIL_PP};"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "our @EXPORT_OK = qw{"
NSQ_SOURCE_LINE 00000071 "  _STRING     _IDENTIFIER"
NSQ_SOURCE_LINE 00000072 "  _CLASS      _CLASSISA   _SUBCLASS  _DRIVER  _CLASSDOES"
NSQ_SOURCE_LINE 00000073 "  _NUMBER     _POSINT     _NONNEGINT"
NSQ_SOURCE_LINE 00000074 "  _SCALAR     _SCALAR0"
NSQ_SOURCE_LINE 00000075 "  _ARRAY      _ARRAY0     _ARRAYLIKE"
NSQ_SOURCE_LINE 00000076 "  _HASH       _HASH0      _HASHLIKE"
NSQ_SOURCE_LINE 00000077 "  _CODE       _CODELIKE"
NSQ_SOURCE_LINE 00000078 "  _INVOCANT   _REGEX      _INSTANCE  _INSTANCEDOES"
NSQ_SOURCE_LINE 00000079 "  _SET        _SET0"
NSQ_SOURCE_LINE 00000080 "  _HANDLE"
NSQ_SOURCE_LINE 00000081 "};"
NSQ_SOURCE_LINE 00000082 "our %EXPORT_TAGS = (ALL => \\@EXPORT_OK);"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "## no critic (TestingAndDebugging::ProhibitNoStrict)"
NSQ_SOURCE_LINE 00000085 "no strict \"refs\";"
NSQ_SOURCE_LINE 00000086 "Params::Util->can($_) or *$_ = Params::Util::PP->can($_) for (@EXPORT_OK);"
NSQ_SOURCE_LINE 00000087 "use strict \"refs\";"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "#####################################################################"
NSQ_SOURCE_LINE 00000090 "# Param Checking Functions"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=pod"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=head2 _STRING $string"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "The C<_STRING> function is intended to be imported into your"
NSQ_SOURCE_LINE 00000097 "package, and provides a convenient way to test to see if a value is"
NSQ_SOURCE_LINE 00000098 "a normal non-false string of non-zero length."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "Note that this will NOT do anything magic to deal with the special"
NSQ_SOURCE_LINE 00000101 "C<'0'> false negative case, but will return it."
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "  # '0' not considered valid data"
NSQ_SOURCE_LINE 00000104 "  my $name = _STRING(shift) or die \"Bad name\";"
NSQ_SOURCE_LINE 00000105 "  "
NSQ_SOURCE_LINE 00000106 "  # '0' is considered valid data"
NSQ_SOURCE_LINE 00000107 "  my $string = _STRING($_[0]) ? shift : die \"Bad string\";"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "Please also note that this function expects a normal string. It does"
NSQ_SOURCE_LINE 00000110 "not support overloading or other magic techniques to get a string."
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "Returns the string as a convenience if it is a valid string, or"
NSQ_SOURCE_LINE 00000113 "C<undef> if not."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=head2 _IDENTIFIER $string"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "The C<_IDENTIFIER> function is intended to be imported into your"
NSQ_SOURCE_LINE 00000118 "package, and provides a convenient way to test to see if a value is"
NSQ_SOURCE_LINE 00000119 "a string that is a valid Perl identifier."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "Returns the string as a convenience if it is a valid identifier, or"
NSQ_SOURCE_LINE 00000122 "C<undef> if not."
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "=head2 _CLASS $string"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "The C<_CLASS> function is intended to be imported into your"
NSQ_SOURCE_LINE 00000127 "package, and provides a convenient way to test to see if a value is"
NSQ_SOURCE_LINE 00000128 "a string that is a valid Perl class."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "This function only checks that the format is valid, not that the"
NSQ_SOURCE_LINE 00000131 "class is actually loaded. It also assumes \"normalized\" form, and does"
NSQ_SOURCE_LINE 00000132 "not accept class names such as C<::Foo> or C<D'Oh>."
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Returns the string as a convenience if it is a valid class name, or"
NSQ_SOURCE_LINE 00000135 "C<undef> if not."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=head2 _CLASSISA $string, $class"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "The C<_CLASSISA> function is intended to be imported into your"
NSQ_SOURCE_LINE 00000140 "package, and provides a convenient way to test to see if a value is"
NSQ_SOURCE_LINE 00000141 "a string that is a particularly class, or a subclass of it."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "This function checks that the format is valid and calls the -E<gt>isa"
NSQ_SOURCE_LINE 00000144 "method on the class name. It does not check that the class is actually"
NSQ_SOURCE_LINE 00000145 "loaded."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "It also assumes \"normalized\" form, and does"
NSQ_SOURCE_LINE 00000148 "not accept class names such as C<::Foo> or C<D'Oh>."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Returns the string as a convenience if it is a valid class name, or"
NSQ_SOURCE_LINE 00000151 "C<undef> if not."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=head2 _CLASSDOES $string, $role"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "This routine behaves exactly like C<L</_CLASSISA>>, but checks with C<< ->DOES"
NSQ_SOURCE_LINE 00000156 ">> rather than C<< ->isa >>.  This is probably only a good idea to use on Perl"
NSQ_SOURCE_LINE 00000157 "5.10 or later, when L<UNIVERSAL::DOES|UNIVERSAL::DOES/DOES> has been"
NSQ_SOURCE_LINE 00000158 "implemented."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=head2 _SUBCLASS $string, $class"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "The C<_SUBCLASS> function is intended to be imported into your"
NSQ_SOURCE_LINE 00000163 "package, and provides a convenient way to test to see if a value is"
NSQ_SOURCE_LINE 00000164 "a string that is a subclass of a specified class."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "This function checks that the format is valid and calls the -E<gt>isa"
NSQ_SOURCE_LINE 00000167 "method on the class name. It does not check that the class is actually"
NSQ_SOURCE_LINE 00000168 "loaded."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "It also assumes \"normalized\" form, and does"
NSQ_SOURCE_LINE 00000171 "not accept class names such as C<::Foo> or C<D'Oh>."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "Returns the string as a convenience if it is a valid class name, or"
NSQ_SOURCE_LINE 00000174 "C<undef> if not."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "=head2 _NUMBER $scalar"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "The C<_NUMBER> function is intended to be imported into your"
NSQ_SOURCE_LINE 00000179 "package, and provides a convenient way to test to see if a value is"
NSQ_SOURCE_LINE 00000180 "a number. That is, it is defined and perl thinks it's a number."
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "This function is basically a Params::Util-style wrapper around the"
NSQ_SOURCE_LINE 00000183 "L<Scalar::Util> C<looks_like_number> function."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "Returns the value as a convenience, or C<undef> if the value is not a"
NSQ_SOURCE_LINE 00000186 "number."
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=head2 _POSINT $integer"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "The C<_POSINT> function is intended to be imported into your"
NSQ_SOURCE_LINE 00000191 "package, and provides a convenient way to test to see if a value is"
NSQ_SOURCE_LINE 00000192 "a positive integer (of any length)."
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "Returns the value as a convenience, or C<undef> if the value is not a"
NSQ_SOURCE_LINE 00000195 "positive integer."
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "The name itself is derived from the XML schema constraint of the same"
NSQ_SOURCE_LINE 00000198 "name."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=head2 _NONNEGINT $integer"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "The C<_NONNEGINT> function is intended to be imported into your"
NSQ_SOURCE_LINE 00000203 "package, and provides a convenient way to test to see if a value is"
NSQ_SOURCE_LINE 00000204 "a non-negative integer (of any length). That is, a positive integer,"
NSQ_SOURCE_LINE 00000205 "or zero."
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "Returns the value as a convenience, or C<undef> if the value is not a"
NSQ_SOURCE_LINE 00000208 "non-negative integer."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "As with other tests that may return false values, care should be taken"
NSQ_SOURCE_LINE 00000211 "to test via \"defined\" in boolean validly contexts."
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "  unless ( defined _NONNEGINT($value) ) {"
NSQ_SOURCE_LINE 00000214 "     die \"Invalid value\";"
NSQ_SOURCE_LINE 00000215 "  }"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "The name itself is derived from the XML schema constraint of the same"
NSQ_SOURCE_LINE 00000218 "name."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=head2 _SCALAR \\$scalar"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "The C<_SCALAR> function is intended to be imported into your package,"
NSQ_SOURCE_LINE 00000223 "and provides a convenient way to test for a raw and unblessed"
NSQ_SOURCE_LINE 00000224 "C<SCALAR> reference, with content of non-zero length."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "For a version that allows zero length C<SCALAR> references, see"
NSQ_SOURCE_LINE 00000227 "the C<_SCALAR0> function."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "Returns the C<SCALAR> reference itself as a convenience, or C<undef>"
NSQ_SOURCE_LINE 00000230 "if the value provided is not a C<SCALAR> reference."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "=head2 _SCALAR0 \\$scalar"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "The C<_SCALAR0> function is intended to be imported into your package,"
NSQ_SOURCE_LINE 00000235 "and provides a convenient way to test for a raw and unblessed"
NSQ_SOURCE_LINE 00000236 "C<SCALAR0> reference, allowing content of zero-length."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "For a simpler \"give me some content\" version that requires non-zero"
NSQ_SOURCE_LINE 00000239 "length, C<_SCALAR> function."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "Returns the C<SCALAR> reference itself as a convenience, or C<undef>"
NSQ_SOURCE_LINE 00000242 "if the value provided is not a C<SCALAR> reference."
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head2 _ARRAY $value"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "The C<_ARRAY> function is intended to be imported into your package,"
NSQ_SOURCE_LINE 00000247 "and provides a convenient way to test for a raw and unblessed"
NSQ_SOURCE_LINE 00000248 "C<ARRAY> reference containing B<at least> one element of any kind."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "For a more basic form that allows zero length ARRAY references, see"
NSQ_SOURCE_LINE 00000251 "the C<_ARRAY0> function."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "Returns the C<ARRAY> reference itself as a convenience, or C<undef>"
NSQ_SOURCE_LINE 00000254 "if the value provided is not an C<ARRAY> reference."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=head2 _ARRAY0 $value"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "The C<_ARRAY0> function is intended to be imported into your package,"
NSQ_SOURCE_LINE 00000259 "and provides a convenient way to test for a raw and unblessed"
NSQ_SOURCE_LINE 00000260 "C<ARRAY> reference, allowing C<ARRAY> references that contain no"
NSQ_SOURCE_LINE 00000261 "elements."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "For a more basic \"An array of something\" form that also requires at"
NSQ_SOURCE_LINE 00000264 "least one element, see the C<_ARRAY> function."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "Returns the C<ARRAY> reference itself as a convenience, or C<undef>"
NSQ_SOURCE_LINE 00000267 "if the value provided is not an C<ARRAY> reference."
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=head2 _ARRAYLIKE $value"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "The C<_ARRAYLIKE> function tests whether a given scalar value can respond to"
NSQ_SOURCE_LINE 00000272 "array dereferencing.  If it can, the value is returned.  If it cannot,"
NSQ_SOURCE_LINE 00000273 "C<_ARRAYLIKE> returns C<undef>."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=head2 _HASH $value"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "The C<_HASH> function is intended to be imported into your package,"
NSQ_SOURCE_LINE 00000278 "and provides a convenient way to test for a raw and unblessed"
NSQ_SOURCE_LINE 00000279 "C<HASH> reference with at least one entry."
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "For a version of this function that allows the C<HASH> to be empty,"
NSQ_SOURCE_LINE 00000282 "see the C<_HASH0> function."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "Returns the C<HASH> reference itself as a convenience, or C<undef>"
NSQ_SOURCE_LINE 00000285 "if the value provided is not an C<HASH> reference."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=head2 _HASH0 $value"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "The C<_HASH0> function is intended to be imported into your package,"
NSQ_SOURCE_LINE 00000290 "and provides a convenient way to test for a raw and unblessed"
NSQ_SOURCE_LINE 00000291 "C<HASH> reference, regardless of the C<HASH> content."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "For a simpler \"A hash of something\" version that requires at least one"
NSQ_SOURCE_LINE 00000294 "element, see the C<_HASH> function."
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "Returns the C<HASH> reference itself as a convenience, or C<undef>"
NSQ_SOURCE_LINE 00000297 "if the value provided is not an C<HASH> reference."
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "=head2 _HASHLIKE $value"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "The C<_HASHLIKE> function tests whether a given scalar value can respond to"
NSQ_SOURCE_LINE 00000302 "hash dereferencing.  If it can, the value is returned.  If it cannot,"
NSQ_SOURCE_LINE 00000303 "C<_HASHLIKE> returns C<undef>."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=head2 _CODE $value"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "The C<_CODE> function is intended to be imported into your package,"
NSQ_SOURCE_LINE 00000308 "and provides a convenient way to test for a raw and unblessed"
NSQ_SOURCE_LINE 00000309 "C<CODE> reference."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "Returns the C<CODE> reference itself as a convenience, or C<undef>"
NSQ_SOURCE_LINE 00000312 "if the value provided is not an C<CODE> reference."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=head2 _CODELIKE $value"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "The C<_CODELIKE> is the more generic version of C<_CODE>. Unlike C<_CODE>,"
NSQ_SOURCE_LINE 00000317 "which checks for an explicit C<CODE> reference, the C<_CODELIKE> function"
NSQ_SOURCE_LINE 00000318 "also includes things that act like them, such as blessed objects that"
NSQ_SOURCE_LINE 00000319 "overload C<'&{}'>."
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "Please note that in the case of objects overloaded with '&{}', you will"
NSQ_SOURCE_LINE 00000322 "almost always end up also testing it in 'bool' context at some stage."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "For example:"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "  sub foo {"
NSQ_SOURCE_LINE 00000327 "      my $code1 = _CODELIKE(shift) or die \"No code param provided\";"
NSQ_SOURCE_LINE 00000328 "      my $code2 = _CODELIKE(shift);"
NSQ_SOURCE_LINE 00000329 "      if ( $code2 ) {"
NSQ_SOURCE_LINE 00000330 "           print \"Got optional second code param\";"
NSQ_SOURCE_LINE 00000331 "      }"
NSQ_SOURCE_LINE 00000332 "  }"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "As such, you will most likely always want to make sure your class has"
NSQ_SOURCE_LINE 00000335 "at least the following to allow it to evaluate to true in boolean"
NSQ_SOURCE_LINE 00000336 "context."
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "  # Always evaluate to true in boolean context"
NSQ_SOURCE_LINE 00000339 "  use overload 'bool' => sub () { 1 };"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "Returns the callable value as a convenience, or C<undef> if the"
NSQ_SOURCE_LINE 00000342 "value provided is not callable."
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "Note - This function was formerly known as _CALLABLE but has been renamed"
NSQ_SOURCE_LINE 00000345 "for greater symmetry with the other _XXXXLIKE functions."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "The use of _CALLABLE has been deprecated. It will continue to work, but"
NSQ_SOURCE_LINE 00000348 "with a warning, until end-2006, then will be removed."
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "I apologize for any inconvenience caused."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "=head2 _INVOCANT $value"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "This routine tests whether the given value is a valid method invocant."
NSQ_SOURCE_LINE 00000355 "This can be either an instance of an object, or a class name."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "If so, the value itself is returned.  Otherwise, C<_INVOCANT>"
NSQ_SOURCE_LINE 00000358 "returns C<undef>."
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "=head2 _INSTANCE $object, $class"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "The C<_INSTANCE> function is intended to be imported into your package,"
NSQ_SOURCE_LINE 00000363 "and provides a convenient way to test for an object of a particular class"
NSQ_SOURCE_LINE 00000364 "in a strictly correct manner."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "Returns the object itself as a convenience, or C<undef> if the value"
NSQ_SOURCE_LINE 00000367 "provided is not an object of that type."
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "=head2 _INSTANCEDOES $object, $role"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "This routine behaves exactly like C<L</_INSTANCE>>, but checks with C<< ->DOES"
NSQ_SOURCE_LINE 00000372 ">> rather than C<< ->isa >>.  This is probably only a good idea to use on Perl"
NSQ_SOURCE_LINE 00000373 "5.10 or later, when L<UNIVERSAL::DOES|UNIVERSAL::DOES/DOES> has been"
NSQ_SOURCE_LINE 00000374 "implemented."
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "=head2 _REGEX $value"
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "The C<_REGEX> function is intended to be imported into your package,"
NSQ_SOURCE_LINE 00000379 "and provides a convenient way to test for a regular expression."
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "Returns the value itself as a convenience, or C<undef> if the value"
NSQ_SOURCE_LINE 00000382 "provided is not a regular expression."
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "=head2 _SET \\@array, $class"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "The C<_SET> function is intended to be imported into your package,"
NSQ_SOURCE_LINE 00000387 "and provides a convenient way to test for set of at least one object of"
NSQ_SOURCE_LINE 00000388 "a particular class in a strictly correct manner."
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "The set is provided as a reference to an C<ARRAY> of objects of the"
NSQ_SOURCE_LINE 00000391 "class provided."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "For an alternative function that allows zero-length sets, see the"
NSQ_SOURCE_LINE 00000394 "C<_SET0> function."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "Returns the C<ARRAY> reference itself as a convenience, or C<undef> if"
NSQ_SOURCE_LINE 00000397 "the value provided is not a set of that class."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=head2 _SET0 \\@array, $class"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "The C<_SET0> function is intended to be imported into your package,"
NSQ_SOURCE_LINE 00000402 "and provides a convenient way to test for a set of objects of a"
NSQ_SOURCE_LINE 00000403 "particular class in a strictly correct manner, allowing for zero objects."
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "The set is provided as a reference to an C<ARRAY> of objects of the"
NSQ_SOURCE_LINE 00000406 "class provided."
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "For an alternative function that requires at least one object, see the"
NSQ_SOURCE_LINE 00000409 "C<_SET> function."
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "Returns the C<ARRAY> reference itself as a convenience, or C<undef> if"
NSQ_SOURCE_LINE 00000412 "the value provided is not a set of that class."
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "=head2 _HANDLE"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "The C<_HANDLE> function is intended to be imported into your package,"
NSQ_SOURCE_LINE 00000417 "and provides a convenient way to test whether or not a single scalar"
NSQ_SOURCE_LINE 00000418 "value is a file handle."
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "Unfortunately, in Perl the definition of a file handle can be a little"
NSQ_SOURCE_LINE 00000421 "bit fuzzy, so this function is likely to be somewhat imperfect (at first"
NSQ_SOURCE_LINE 00000422 "anyway)."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "That said, it is implement as well or better than the other file handle"
NSQ_SOURCE_LINE 00000425 "detectors in existence (and we stole from the best of them)."
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "=head2 _DRIVER $string"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "  sub foo {"
NSQ_SOURCE_LINE 00000430 "    my $class = _DRIVER(shift, 'My::Driver::Base') or die \"Bad driver\";"
NSQ_SOURCE_LINE 00000431 "    ..."
NSQ_SOURCE_LINE 00000432 "  }"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "The C<_DRIVER> function is intended to be imported into your"
NSQ_SOURCE_LINE 00000435 "package, and provides a convenient way to load and validate"
NSQ_SOURCE_LINE 00000436 "a driver class."
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "The most common pattern when taking a driver class as a parameter"
NSQ_SOURCE_LINE 00000439 "is to check that the name is a class (i.e. check against _CLASS)"
NSQ_SOURCE_LINE 00000440 "and then to load the class (if it exists) and then ensure that"
NSQ_SOURCE_LINE 00000441 "the class returns true for the isa method on some base driver name."
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "Return the value as a convenience, or C<undef> if the value is not"
NSQ_SOURCE_LINE 00000444 "a class name, the module does not exist, the module does not load,"
NSQ_SOURCE_LINE 00000445 "or the class fails the isa test."
NSQ_SOURCE_LINE 00000446 ""
