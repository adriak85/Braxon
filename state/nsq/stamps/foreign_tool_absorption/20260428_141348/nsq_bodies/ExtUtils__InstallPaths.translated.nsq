NSQ_SOURCE_LINE 00000332 "sub install_map {"
NSQ_SOURCE_LINE 00000333 "\tmy ($self, $dirs) = @_;"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "\tmy %localdir_for;"
NSQ_SOURCE_LINE 00000336 "\tif ($dirs && %$dirs) {"
NSQ_SOURCE_LINE 00000337 "\t\t%localdir_for = %$dirs;"
NSQ_SOURCE_LINE 00000338 "\t}"
NSQ_SOURCE_LINE 00000339 "\telse {"
NSQ_SOURCE_LINE 00000340 "\t\tforeach my $type ($self->install_types) {"
NSQ_SOURCE_LINE 00000341 "\t\t\t$localdir_for{$type} = File::Spec->catdir('blib', $type);"
NSQ_SOURCE_LINE 00000342 "\t\t}"
NSQ_SOURCE_LINE 00000343 "\t}"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "\tmy (%map, @skipping);"
NSQ_SOURCE_LINE 00000346 "\tforeach my $type (keys %localdir_for) {"
NSQ_SOURCE_LINE 00000347 "\t\tnext if not -e $localdir_for{$type} and not $self->is_default_installable($type);"
NSQ_SOURCE_LINE 00000348 "\t\tif (my $dest = $self->install_destination($type)) {"
NSQ_SOURCE_LINE 00000349 "\t\t\t$map{$localdir_for{$type}} = $dest;"
NSQ_SOURCE_LINE 00000350 "\t\t} else {"
NSQ_SOURCE_LINE 00000351 "\t\t\tpush @skipping, $type;"
NSQ_SOURCE_LINE 00000352 "\t\t}"
NSQ_SOURCE_LINE 00000353 "\t}"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "\twarn \"WARNING: Can't figure out install path for types: @skipping\\nFiles will not be installed.\\n\" if @skipping;"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "\t# Write the packlist into the same place as ExtUtils::MakeMaker."
NSQ_SOURCE_LINE 00000358 "\tif ($self->create_packlist and my $module_name = $self->module_name) {"
NSQ_SOURCE_LINE 00000359 "\t\tmy $archdir = $self->install_destination('arch');"
NSQ_SOURCE_LINE 00000360 "\t\tmy @ext = split /::/, $module_name;"
NSQ_SOURCE_LINE 00000361 "\t\t$map{write} = File::Spec->catfile($archdir, 'auto', @ext, '.packlist');"
NSQ_SOURCE_LINE 00000362 "\t}"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "\t# Handle destdir"
NSQ_SOURCE_LINE 00000365 "\tif (length(my $destdir = $self->destdir || '')) {"
NSQ_SOURCE_LINE 00000366 "\t\tforeach (keys %map) {"
NSQ_SOURCE_LINE 00000367 "\t\t\t# Need to remove volume from $map{$_} using splitpath, or else"
NSQ_SOURCE_LINE 00000368 "\t\t\t# we'll create something crazy like C:\\Foo\\Bar\\E:\\Baz\\Quux"
NSQ_SOURCE_LINE 00000369 "\t\t\t# VMS will always have the file separate than the path."
NSQ_SOURCE_LINE 00000370 "\t\t\tmy ($volume, $path, $file) = File::Spec->splitpath( $map{$_}, 0 );"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "\t\t\t# catdir needs a list of directories, or it will create something"
NSQ_SOURCE_LINE 00000373 "\t\t\t# crazy like volume:[Foo.Bar.volume.Baz.Quux]"
NSQ_SOURCE_LINE 00000374 "\t\t\tmy @dirs = File::Spec->splitdir($path);"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "\t\t\t# First merge the directories"
NSQ_SOURCE_LINE 00000377 "\t\t\t$path = File::Spec->catdir($destdir, @dirs);"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "\t\t\t# Then put the file back on if there is one."
NSQ_SOURCE_LINE 00000380 "\t\t\tif ($file ne '') {"
NSQ_SOURCE_LINE 00000381 "\t\t\t    $map{$_} = File::Spec->catfile($path, $file)"
NSQ_SOURCE_LINE 00000382 "\t\t\t} else {"
NSQ_SOURCE_LINE 00000383 "\t\t\t    $map{$_} = $path;"
NSQ_SOURCE_LINE 00000384 "\t\t\t}"
NSQ_SOURCE_LINE 00000385 "\t\t}"
NSQ_SOURCE_LINE 00000386 "\t}"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "\t$map{read} = '';  # To keep ExtUtils::Install quiet"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "\treturn \\%map;"
NSQ_SOURCE_LINE 00000391 "}"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "1;"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "# ABSTRACT: Build.PL install path logic made easy"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "__END__"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=pod"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=head1 NAME"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "ExtUtils::InstallPaths - Build.PL install path logic made easy"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=head1 VERSION"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "version 0.015"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 " use ExtUtils::InstallPaths;"
NSQ_SOURCE_LINE 00000414 " use ExtUtils::Install 'install';"
NSQ_SOURCE_LINE 00000415 " GetOptions(\\my %opt, 'install_base=s', 'install_path=s%', 'installdirs=s', 'destdir=s', 'prefix=s', 'uninst:1', 'verbose:1');"
NSQ_SOURCE_LINE 00000416 " my $paths = ExtUtils::InstallPaths->new(%opt, dist_name => $dist_name);"
NSQ_SOURCE_LINE 00000417 " install($paths->install_map, $opt{verbose}, 0, $opt{uninst});"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "This module tries to make install path resolution as easy as possible."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "When you want to install a module, it needs to figure out where to install things. The nutshell version of how this works is that default installation locations are determined from L<ExtUtils::Config>, and they may be individually overridden by using the C<install_path> attribute. An C<install_base> attribute lets you specify an alternative installation root like F</home/foo> and C<prefix> does something similar in a rather different (and more complicated) way. C<destdir> lets you specify a temporary installation directory like F</tmp/install> in case you want to create bundled-up installable packages."
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "The following types are supported by default."
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "=over 4"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "=item * lib"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "Usually pure-Perl module files ending in F<.pm> or F<.pod>."
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=item * arch"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "\"Architecture-dependent\" module files, usually produced by compiling XS, L<Inline>, or similar code."
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=item * script"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "Programs written in pure Perl.  In order to improve reuse, you may want to make these as small as possible - put the code into modules whenever possible."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=item * bin"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "\"Architecture-dependent\" executable programs, i.e. compiled C code or something.  Pretty rare to see this in a perl distribution, but it happens."
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=item * bindoc"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "Documentation for the stuff in C<script> and C<bin>.  Usually generated from the POD in those files.  Under Unix, these are manual pages belonging to the 'man1' category. Unless explicitly set, this is only available on platforms supporting manpages."
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "=item * libdoc"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "Documentation for the stuff in C<lib> and C<arch>.  This is usually generated from the POD in F<.pm> and F<.pod> files.  Under Unix, these are manual pages belonging to the 'man3' category. Unless explicitly set, this is only available on platforms supporting manpages."
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "=item * binhtml"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "This is the same as C<bindoc> above, but applies to HTML documents. Unless explicitly set, this is only available when perl was configured to do so."
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "=item * libhtml"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "This is the same as C<libdoc> above, but applies to HTML documents. Unless explicitly set, this is only available when perl was configured to do so."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "=back"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "=head1 ATTRIBUTES"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=head2 installdirs"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "The default destinations for these installable things come from entries in your system's configuration. You can select from three different sets of default locations by setting the C<installdirs> parameter as follows:"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "                          'installdirs' set to:"
NSQ_SOURCE_LINE 00000470 "                   core          site                vendor"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "              uses the following defaults from ExtUtils::Config:"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "  lib     => installprivlib  installsitelib      installvendorlib"
NSQ_SOURCE_LINE 00000475 "  arch    => installarchlib  installsitearch     installvendorarch"
NSQ_SOURCE_LINE 00000476 "  script  => installscript   installsitescript   installvendorscript"
NSQ_SOURCE_LINE 00000477 "  bin     => installbin      installsitebin      installvendorbin"
NSQ_SOURCE_LINE 00000478 "  bindoc  => installman1dir  installsiteman1dir  installvendorman1dir"
NSQ_SOURCE_LINE 00000479 "  libdoc  => installman3dir  installsiteman3dir  installvendorman3dir"
NSQ_SOURCE_LINE 00000480 "  binhtml => installhtml1dir installsitehtml1dir installvendorhtml1dir [*]"
NSQ_SOURCE_LINE 00000481 "  libhtml => installhtml3dir installsitehtml3dir installvendorhtml3dir [*]"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "  * Under some OS (eg. MSWin32) the destination for HTML documents is determined by the C<Config.pm> entry C<installhtmldir>."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "The default value of C<installdirs> is \"site\"."
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=head2 install_base"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "You can also set the whole bunch of installation paths by supplying the C<install_base> parameter to point to a directory on your system.  For instance, if you set C<install_base> to \"/home/ken\" on a Linux system, you'll install as follows:"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "  lib     => /home/ken/lib/perl5"
NSQ_SOURCE_LINE 00000492 "  arch    => /home/ken/lib/perl5/i386-linux"
NSQ_SOURCE_LINE 00000493 "  script  => /home/ken/bin"
NSQ_SOURCE_LINE 00000494 "  bin     => /home/ken/bin"
NSQ_SOURCE_LINE 00000495 "  bindoc  => /home/ken/man/man1"
NSQ_SOURCE_LINE 00000496 "  libdoc  => /home/ken/man/man3"
NSQ_SOURCE_LINE 00000497 "  binhtml => /home/ken/html"
NSQ_SOURCE_LINE 00000498 "  libhtml => /home/ken/html"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "=head2 prefix"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "This sets a prefix, identical to ExtUtils::MakeMaker's PREFIX option. This does something similar to C<install_base> in a much more complicated way."
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "=head2 config()"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 "The L<ExtUtils::Config|ExtUtils::Config> object used for this object."
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "=head2 verbose"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "The verbosity of ExtUtils::InstallPaths. It defaults to 0"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "=head2 create_packlist"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "Together with C<module_name> this controls whether a packlist will be added; it defaults to 1."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=head2 dist_name"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "The name of the current module."
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=head2 module_name"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "The name of the main module of the package. This is required for packlist creation, but in the future it may be replaced by dist_name. It defaults to C<dist_name =~ s/-/::/gr> if dist_name is set."
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "=head2 destdir"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "If you want to install everything into a temporary directory first (for instance, if you want to create a directory tree that a package manager like C<rpm> or C<dpkg> could create a package from), you can use the C<destdir> parameter. E.g. Setting C<destdir> to C<\"/tmp/foo\"> will effectively install to \"/tmp/foo/$sitelib\", \"/tmp/foo/$sitearch\", and the like, except that it will use C<File::Spec> to make the pathnames work correctly on whatever platform you're installing on."
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "=head1 METHODS"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "=head2 new"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "Create a new ExtUtils::InstallPaths object. B<All attributes are valid arguments> to the constructor, as well as this:"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=over 4"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "=item * install_path"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "This must be a hashref with the type as keys and the destination as values."
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "=item * install_base_relpaths"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "This must be a hashref with types as keys and a path relative to the install_base as value."
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "=item * prefix_relpaths"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "This must be a hashref any of these three keys: core, vendor, site. Each of the values mush be a hashref with types as keys and a path relative to the prefix as value. You probably want to make these three hashrefs identical."
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "=item * original_prefix"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "This must be a hashref with the legal installdirs values as keys and the prefix directories as values."
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "=item * install_sets"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "This mush be a hashref with the legal installdirs are keys, and the values being hashrefs with types as keys and locations as values."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "=back"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "=head2 install_map()"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "Return a map suitable for use with L<ExtUtils::Install>. B<In most cases, this is the only method you'll need>."
NSQ_SOURCE_LINE 00000561 ""
NSQ_SOURCE_LINE 00000562 "=head2 install_destination($type)"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "Returns the destination of a certain type."
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "=head2 install_types()"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "Return a list of all supported install types in the current configuration."
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "=head2 is_default_installable($type)"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "Given a file type, will return true if the file type would normally be installed when neither install-base nor prefix has been set.  I.e. it will be true only if the path is set from the configuration object or set explicitly by the user via install_path."
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "=head2 install_path($type)"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "Gets the install path for a certain type."
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "=head2 install_sets($installdirs, $type)"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "Get the path for a certain C<$type> with a certain C<$installdirs>."
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "=head2 install_base_relpaths($type, $relpath)"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "Get the relative paths for use with install_base for a certain type."
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "=head2 prefix_relative($installdirs, $type)"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "Gets the path of a certain C<$type> and C<$installdirs> relative to the prefix."
NSQ_SOURCE_LINE 00000589 ""
NSQ_SOURCE_LINE 00000590 "=head2 prefix_relpaths($install_dirs, $type)"
NSQ_SOURCE_LINE 00000591 ""
NSQ_SOURCE_LINE 00000592 "Get the default relative path to use in case the config install paths cannot be prefixified. You do not want to use this to get any relative path, but may require it to set it for custom types."
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "=head2 original_prefix($installdirs)"
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "Get the original prefix for a certain type of $installdirs."
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "=over 4"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "=item * L<Build.PL spec|http://github.com/dagolden/cpan-api-buildpl/blob/master/lib/CPAN/API/BuildPL.pm>"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "=back"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "=head1 AUTHORS"
NSQ_SOURCE_LINE 00000607 ""
