NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "# Given a file type, will return true if the file type would normally"
NSQ_SOURCE_LINE 00000190 "# be installed when neither install-base nor prefix has been set."
NSQ_SOURCE_LINE 00000191 "# I.e. it will be true only if the path is set from Config.pm or"
NSQ_SOURCE_LINE 00000192 "# set explicitly by the user via install-path."
NSQ_SOURCE_LINE 00000193 "sub is_default_installable {"
NSQ_SOURCE_LINE 00000194 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000195 "\tmy $type = shift;"
NSQ_SOURCE_LINE 00000196 "\tmy $installable = $self->install_destination($type) && ( $self->install_path($type) || $self->install_sets($self->installdirs, $type));"
NSQ_SOURCE_LINE 00000197 "\treturn $installable ? 1 : 0;"
NSQ_SOURCE_LINE 00000198 "}"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "sub _prefixify_default {"
NSQ_SOURCE_LINE 00000201 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000202 "\tmy $type = shift;"
NSQ_SOURCE_LINE 00000203 "\tmy $rprefix = shift;"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "\tmy $default = $self->prefix_relpaths($self->installdirs, $type);"
NSQ_SOURCE_LINE 00000206 "\tif( !$default ) {"
NSQ_SOURCE_LINE 00000207 "\t\t$self->_log_verbose(\"    no default install location for type '$type', using prefix '$rprefix'.\\n\");"
NSQ_SOURCE_LINE 00000208 "\t\treturn $rprefix;"
NSQ_SOURCE_LINE 00000209 "\t} else {"
NSQ_SOURCE_LINE 00000210 "\t\treturn File::Spec->catdir(@{$default});"
NSQ_SOURCE_LINE 00000211 "\t}"
NSQ_SOURCE_LINE 00000212 "}"
