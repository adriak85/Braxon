NSQ_SOURCE_LINE 00000321 "sub install_types {"
NSQ_SOURCE_LINE 00000322 "\tmy $self = shift;"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "\tmy %types = ( %{ $self->{install_path} }, "
NSQ_SOURCE_LINE 00000325 "\t\t  $self->install_base ?  %{ $self->{install_base_relpaths} }"
NSQ_SOURCE_LINE 00000326 "\t\t: $self->prefix ? %{ $self->{prefix_relpaths}{ $self->installdirs } }"
