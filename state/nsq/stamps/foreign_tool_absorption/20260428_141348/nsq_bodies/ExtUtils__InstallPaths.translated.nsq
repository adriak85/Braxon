NSQ_SOURCE_LINE 00000069 "sub new {"
NSQ_SOURCE_LINE 00000070 "\tmy ($class, %args) = @_;"
NSQ_SOURCE_LINE 00000071 "\tmy $config = $args{config} || ExtUtils::Config->new;"
NSQ_SOURCE_LINE 00000072 "\tif ($config->get('installsitescript') eq '') {"
NSQ_SOURCE_LINE 00000073 "\t\t$config = $config->but({ installsitescript => $config->get('installsitebin') });"
NSQ_SOURCE_LINE 00000074 "\t}"
NSQ_SOURCE_LINE 00000075 "\tmy %self = ("
NSQ_SOURCE_LINE 00000076 "\t\tconfig => $config,"
NSQ_SOURCE_LINE 00000077 "\t\tmap { $_ => exists $args{$_} ? $filter{$_} ? $filter{$_}->($args{$_}, $config) : $args{$_} : ref $defaults{$_} ? $defaults{$_}->($config) : $defaults{$_} } keys %defaults,"
NSQ_SOURCE_LINE 00000078 "\t);"
NSQ_SOURCE_LINE 00000079 "\t$self{module_name} ||= do { my $module_name = $self{dist_name}; $module_name =~ s/-/::/g; $module_name } if defined $self{dist_name};"
NSQ_SOURCE_LINE 00000080 "\treturn bless \\%self, $class;"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "for my $attribute (keys %defaults) {"
NSQ_SOURCE_LINE 00000084 "\tno strict qw/refs/;"
NSQ_SOURCE_LINE 00000085 "\t*{$attribute} = $hash_accessors{$attribute} ? "
NSQ_SOURCE_LINE 00000086 "\tsub {"
NSQ_SOURCE_LINE 00000087 "\t\tmy ($self, $key) = @_;"
NSQ_SOURCE_LINE 00000088 "\t\tCarp::confess(\"$attribute needs key\") if not defined $key;"
NSQ_SOURCE_LINE 00000089 "\t\treturn $self->{$attribute}{$key};"
NSQ_SOURCE_LINE 00000090 "\t} :"
NSQ_SOURCE_LINE 00000091 "\t$complex_accessors{$attribute} ?"
NSQ_SOURCE_LINE 00000092 "\tsub {"
NSQ_SOURCE_LINE 00000093 "\t\tmy ($self, $installdirs, $key) = @_;"
NSQ_SOURCE_LINE 00000094 "\t\tCarp::confess(\"$attribute needs installdir\") if not defined $installdirs;"
NSQ_SOURCE_LINE 00000095 "\t\tCarp::confess(\"$attribute needs key\") if not defined $key;"
NSQ_SOURCE_LINE 00000096 "\t\treturn $self->{$attribute}{$installdirs}{$key};"
NSQ_SOURCE_LINE 00000097 "\t} :"
NSQ_SOURCE_LINE 00000098 "\tsub {"
NSQ_SOURCE_LINE 00000099 "\t\tmy $self = shift;"
NSQ_SOURCE_LINE 00000100 "\t\treturn $self->{$attribute};"
NSQ_SOURCE_LINE 00000101 "\t};"
