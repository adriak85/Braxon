NSQ_SOURCE_LINE 00000146 "\tmy $c = shift;"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "\tmy @libstyle = $c->get('installstyle') ?  File::Spec->splitdir($c->get('installstyle')) : qw(lib perl5);"
