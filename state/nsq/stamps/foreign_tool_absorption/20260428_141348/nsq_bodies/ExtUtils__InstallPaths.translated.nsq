NSQ_SOURCE_LINE 00000030 "sub _merge_shallow {"
NSQ_SOURCE_LINE 00000031 "\tmy ($name, $filter) = @_;"
NSQ_SOURCE_LINE 00000032 "\treturn sub {"
NSQ_SOURCE_LINE 00000033 "\t\tmy ($override, $config) = @_;"
NSQ_SOURCE_LINE 00000034 "\t\tmy $defaults = $defaults{$name}->($config);"
NSQ_SOURCE_LINE 00000035 "\t\t$filter->($_) for grep $filter, values %$override;"
NSQ_SOURCE_LINE 00000036 "\t\treturn { %$defaults, %$override };"
NSQ_SOURCE_LINE 00000037 "\t}"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "sub _merge_deep {"
NSQ_SOURCE_LINE 00000041 "\tmy ($name, $filter) = @_;"
NSQ_SOURCE_LINE 00000042 "\treturn sub {"
NSQ_SOURCE_LINE 00000043 "\t\tmy ($override, $config) = @_;"
NSQ_SOURCE_LINE 00000044 "\t\tmy $defaults = $defaults{$name}->($config);"
NSQ_SOURCE_LINE 00000045 "\t\tmy $pair_for = sub {"
NSQ_SOURCE_LINE 00000046 "\t\t\tmy $key = shift;"
NSQ_SOURCE_LINE 00000047 "\t\t\tmy %override = %{ $override->{$key} || {} };"
NSQ_SOURCE_LINE 00000048 "\t\t\t$filter && $filter->($_) for values %override;"
NSQ_SOURCE_LINE 00000049 "\t\t\treturn $key => { %{ $defaults->{$key} }, %override };"
NSQ_SOURCE_LINE 00000050 "\t\t};"
NSQ_SOURCE_LINE 00000051 "\t\treturn { map { $pair_for->($_) } keys %$defaults };"
NSQ_SOURCE_LINE 00000052 "\t}"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "my %allowed_installdir = map { $_ => 1 } qw/core site vendor/;"
NSQ_SOURCE_LINE 00000056 "my $must_be_relative = sub { Carp::croak('Value must be a relative path') if File::Spec->file_name_is_absolute($_[0]) };"
NSQ_SOURCE_LINE 00000057 "my %deep_filter = map { $_ => $must_be_relative } qw/install_base_relpaths prefix_relpaths/;"
NSQ_SOURCE_LINE 00000058 "my %filter = ("
NSQ_SOURCE_LINE 00000059 "\tinstalldirs => sub {"
NSQ_SOURCE_LINE 00000060 "\t\tmy $value = shift;"
NSQ_SOURCE_LINE 00000061 "\t\t$value = 'core', Carp::carp('Perhaps you meant installdirs to be \"core\" rather than \"perl\"?') if $value eq 'perl';"
NSQ_SOURCE_LINE 00000062 "\t\tCarp::croak('installdirs must be one of \"core\", \"site\", or \"vendor\"') if not $allowed_installdir{$value};"
NSQ_SOURCE_LINE 00000063 "\t\treturn $value;"
NSQ_SOURCE_LINE 00000064 "\t},"
NSQ_SOURCE_LINE 00000065 "\t(map { $_ => _merge_shallow($_, $deep_filter{$_}) } qw/original_prefix install_base_relpaths/),"
NSQ_SOURCE_LINE 00000066 "\t(map { $_ => _merge_deep($_, $deep_filter{$_}) } qw/install_sets prefix_relpaths/),"
NSQ_SOURCE_LINE 00000067 ");"
