NSQ_SOURCE_LINE 00000214 "# Translated from ExtUtils::MM_Unix::prefixify()"
NSQ_SOURCE_LINE 00000215 "sub _prefixify_novms {"
NSQ_SOURCE_LINE 00000216 "\tmy($self, $path, $sprefix, $type) = @_;"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "\tmy $rprefix = $self->prefix;"
NSQ_SOURCE_LINE 00000219 "\t$rprefix .= '/' if $sprefix =~ m{/$};"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "\t$self->_log_verbose(\"  prefixify $path from $sprefix to $rprefix\\n\") if defined $path && length $path;"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "\tif (not defined $path or length $path == 0 ) {"
NSQ_SOURCE_LINE 00000224 "\t\t$self->_log_verbose(\"  no path to prefixify, falling back to default.\\n\");"
NSQ_SOURCE_LINE 00000225 "\t\treturn $self->_prefixify_default( $type, $rprefix );"
NSQ_SOURCE_LINE 00000226 "\t} elsif( !File::Spec->file_name_is_absolute($path) ) {"
NSQ_SOURCE_LINE 00000227 "\t\t$self->_log_verbose(\"    path is relative, not prefixifying.\\n\");"
NSQ_SOURCE_LINE 00000228 "\t} elsif( $path !~ s{^\\Q$sprefix\\E\\b}{}s ) {"
NSQ_SOURCE_LINE 00000229 "\t\t$self->_log_verbose(\"    cannot prefixify, falling back to default.\\n\");"
NSQ_SOURCE_LINE 00000230 "\t\treturn $self->_prefixify_default( $type, $rprefix );"
NSQ_SOURCE_LINE 00000231 "\t}"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "\t$self->_log_verbose(\"    now $path in $rprefix\\n\");"
NSQ_SOURCE_LINE 00000234 ""
NSQ_SOURCE_LINE 00000235 "\treturn $path;"
NSQ_SOURCE_LINE 00000236 "}"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "sub _catprefix_vms {"
NSQ_SOURCE_LINE 00000239 "\tmy ($self, $rprefix, $default) = @_;"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "\tmy ($rvol, $rdirs) = File::Spec->splitpath($rprefix);"
NSQ_SOURCE_LINE 00000242 "\tif ($rvol) {"
NSQ_SOURCE_LINE 00000243 "\t\treturn File::Spec->catpath($rvol, File::Spec->catdir($rdirs, $default), '');"
NSQ_SOURCE_LINE 00000244 "\t}"
NSQ_SOURCE_LINE 00000245 "\telse {"
NSQ_SOURCE_LINE 00000246 "\t\treturn File::Spec->catdir($rdirs, $default);"
NSQ_SOURCE_LINE 00000247 "\t}"
NSQ_SOURCE_LINE 00000248 "}"
NSQ_SOURCE_LINE 00000249 "sub _prefixify_vms {"
NSQ_SOURCE_LINE 00000250 "\tmy($self, $path, $sprefix, $type) = @_;"
NSQ_SOURCE_LINE 00000251 "\tmy $rprefix = $self->prefix;"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "\treturn '' unless defined $path;"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "\t$self->_log_verbose(\"  prefixify $path from $sprefix to $rprefix\\n\");"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "\trequire VMS::Filespec;"
NSQ_SOURCE_LINE 00000258 "\t# Translate $(PERLPREFIX) to a real path."
NSQ_SOURCE_LINE 00000259 "\t$rprefix = VMS::Filespec::vmspath($rprefix) if $rprefix;"
NSQ_SOURCE_LINE 00000260 "\t$sprefix = VMS::Filespec::vmspath($sprefix) if $sprefix;"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "\t$self->_log_verbose(\"  rprefix translated to $rprefix\\n  sprefix translated to $sprefix\\n\");"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "\tif (length($path) == 0 ) {"
NSQ_SOURCE_LINE 00000265 "\t\t$self->_log_verbose(\"  no path to prefixify.\\n\")"
NSQ_SOURCE_LINE 00000266 "\t}"
NSQ_SOURCE_LINE 00000267 "\telsif (!File::Spec->file_name_is_absolute($path)) {"
NSQ_SOURCE_LINE 00000268 "\t\t$self->_log_verbose(\"\tpath is relative, not prefixifying.\\n\");"
NSQ_SOURCE_LINE 00000269 "\t}"
NSQ_SOURCE_LINE 00000270 "\telsif ($sprefix eq $rprefix) {"
NSQ_SOURCE_LINE 00000271 "\t\t$self->_log_verbose(\"  no new prefix.\\n\");"
NSQ_SOURCE_LINE 00000272 "\t}"
NSQ_SOURCE_LINE 00000273 "\telse {"
NSQ_SOURCE_LINE 00000274 "\t\tmy ($path_vol, $path_dirs) = File::Spec->splitpath( $path );"
NSQ_SOURCE_LINE 00000275 "\t\tmy $vms_prefix = $self->config->get('vms_prefix');"
NSQ_SOURCE_LINE 00000276 "\t\tif ($path_vol eq $vms_prefix.':') {"
NSQ_SOURCE_LINE 00000277 "\t\t\t$self->_log_verbose(\"  $vms_prefix: seen\\n\");"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "\t\t\t$path_dirs =~ s{^\\[}{\\[.} unless $path_dirs =~ m{^\\[\\.};"
NSQ_SOURCE_LINE 00000280 "\t\t\t$path = $self->_catprefix_vms($rprefix, $path_dirs);"
NSQ_SOURCE_LINE 00000281 "\t\t}"
NSQ_SOURCE_LINE 00000282 "\t\telse {"
NSQ_SOURCE_LINE 00000283 "\t\t\t$self->_log_verbose(\"\tcannot prefixify.\\n\");"
NSQ_SOURCE_LINE 00000284 "\t\t\treturn File::Spec->catdir($self->prefix_relpaths($self->installdirs, $type));"
NSQ_SOURCE_LINE 00000285 "\t\t}"
NSQ_SOURCE_LINE 00000286 "\t}"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "\t$self->_log_verbose(\"\tnow $path\\n\");"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "\treturn $path;"
NSQ_SOURCE_LINE 00000291 "}"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "BEGIN { *_prefixify = $^O eq 'VMS' ? \\&_prefixify_vms : \\&_prefixify_novms }"
NSQ_SOURCE_LINE 00000294 ""
