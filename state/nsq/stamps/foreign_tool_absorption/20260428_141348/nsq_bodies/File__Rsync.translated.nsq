NSQ_SOURCE_LINE 00000001 "# -*- perl -*-"
NSQ_SOURCE_LINE 00000002 "# vim:ft=perl foldlevel=1"
NSQ_SOURCE_LINE 00000003 "#      __"
NSQ_SOURCE_LINE 00000004 "#     /\\ \\ From the mind of"
NSQ_SOURCE_LINE 00000005 "#    /  \\ \\"
NSQ_SOURCE_LINE 00000006 "#   / /\\ \\ \\_____ Lee Eakin  ( Leakin at dfw dot Nostrum dot com )"
NSQ_SOURCE_LINE 00000007 "#  /  \\ \\ \\______\\       or  ( Leakin at cpan dot org )"
NSQ_SOURCE_LINE 00000008 "# / /\\ \\ \\/____  /       or  ( Leakin at japh dot net )"
NSQ_SOURCE_LINE 00000009 "# \\ \\ \\ \\____\\/ /        or  ( Lee at Eakin dot Org )"
NSQ_SOURCE_LINE 00000010 "#  \\ \\ \\/____  /  Wrapper module for the rsync program"
NSQ_SOURCE_LINE 00000011 "#   \\ \\____\\/ /   rsync can be found at http://rsync.samba.org/rsync/"
NSQ_SOURCE_LINE 00000012 "#    \\/______/"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "package File::Rsync;"
NSQ_SOURCE_LINE 00000015 "require 5.008;    # it might work with older versions of 5 but not tested"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "use FileHandle;"
NSQ_SOURCE_LINE 00000018 "use IPC::Run3 'run3';"
NSQ_SOURCE_LINE 00000019 "use Carp 'carp';"
NSQ_SOURCE_LINE 00000020 "use Scalar::Util qw(blessed);"
NSQ_SOURCE_LINE 00000021 "use Data::Dumper;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "use strict;"
NSQ_SOURCE_LINE 00000024 "use vars qw($VERSION);"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "$VERSION = '0.49';"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "=head1 NAME"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "File::Rsync - perl module interface to rsync(1) F<http://rsync.samba.org/rsync/>"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    use File::Rsync;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    $obj = File::Rsync->new("
NSQ_SOURCE_LINE 00000037 "        archive      => 1,"
NSQ_SOURCE_LINE 00000038 "        compress     => 1,"
NSQ_SOURCE_LINE 00000039 "        rsh          => '/usr/local/bin/ssh',"
NSQ_SOURCE_LINE 00000040 "        'rsync-path' => '/usr/local/bin/rsync'"
NSQ_SOURCE_LINE 00000041 "    );"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    $obj->exec( src => 'localdir', dest => 'rhost:remotedir' )"
NSQ_SOURCE_LINE 00000044 "        or warn \"rsync failed\\n\";"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "Perl Convenience wrapper for the rsync(1) program.  Written for I<rsync-2.3.2>"
NSQ_SOURCE_LINE 00000049 "and updated for I<rsync-3.1.1> but should perform properly with most recent"
NSQ_SOURCE_LINE 00000050 "versions."
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=head2 File::Rsync::new"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    $obj = new File::Rsync;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "        or"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    $obj = File::Rsync->new;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "        or"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    $obj = File::Rsync->new(@options);"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "Create a I<File::Rsync> object."
NSQ_SOURCE_LINE 00000065 "Any options passed at creation are stored in the object as defaults for all"
NSQ_SOURCE_LINE 00000066 "future I<exec> calls on that object."
NSQ_SOURCE_LINE 00000067 "Options may be passed in the style of a hash (key/value pairs) and are the"
NSQ_SOURCE_LINE 00000068 "same as the long options in I<rsync(1)> without the leading double-hyphen."
NSQ_SOURCE_LINE 00000069 "Any leading single or double-hyphens are removed, and you may use underscore"
NSQ_SOURCE_LINE 00000070 "in place of hyphens in option names to simplify quoting and avoid possible"
NSQ_SOURCE_LINE 00000071 "equation parsing (subtraction)."
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "Although options are key/value pairs, as of version 0.46 the order is now"
NSQ_SOURCE_LINE 00000074 "preserved.  Passing a hash reference is still supported for backwards"
NSQ_SOURCE_LINE 00000075 "compatibility, but is deprecated as order cannot be preserved for this case."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "An additional option of B<path-to-rsync> also exists which can be used to"
NSQ_SOURCE_LINE 00000078 "override the using PATH environemt variable to find the rsync command binary,"
NSQ_SOURCE_LINE 00000079 "and B<moddebug> which causes the module methods to print some debugging"
NSQ_SOURCE_LINE 00000080 "information to STDERR."
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "There are also 2 options to wrap the source and/or destination paths in"
NSQ_SOURCE_LINE 00000083 "double-quotes: these are B<quote-src> and B<quote-dst>, which may be useful"
NSQ_SOURCE_LINE 00000084 "in protecting the paths from shell expansion (particularly useful for paths"
NSQ_SOURCE_LINE 00000085 "containing spaces).  This wraps all source and/or destination paths in"
NSQ_SOURCE_LINE 00000086 "double-quotes to limit remote shell expansion.  It is similar but not"
NSQ_SOURCE_LINE 00000087 "necessarily the same result as the B<protect-args> option in rsync itself."
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "The B<outfun> and B<errfun> options take a function reference, called once"
NSQ_SOURCE_LINE 00000090 "for each line of output from the I<rsync> program with the output line passed"
NSQ_SOURCE_LINE 00000091 "in as the first argument, the second arg is either 'out' or 'err' depending"
NSQ_SOURCE_LINE 00000092 "on the source."
NSQ_SOURCE_LINE 00000093 "This makes it possible to use the same function for both and still determine"
NSQ_SOURCE_LINE 00000094 "where the output came from."
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "If options are passed as a hash reference (deprecated), the B<exclude>"
NSQ_SOURCE_LINE 00000097 "needs an array reference as it's value since there cannot be duplicate keys"
NSQ_SOURCE_LINE 00000098 "in a hash.  Since order cannot be preserved in a hash, this module currently"
NSQ_SOURCE_LINE 00000099 "limits the use of B<exclude> or B<include> together."
NSQ_SOURCE_LINE 00000100 "They can be mixed together if options are in the form of a list or array ref."
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "Use the '+ ' or '- ' prefix trick to put includes in an B<exclude> array, or"
NSQ_SOURCE_LINE 00000103 "to put excludes in an B<include> array (see I<rsync(1)> for details)."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "Include/exclude options form an ordered list."
NSQ_SOURCE_LINE 00000106 "The order must be retained for proper execution."
NSQ_SOURCE_LINE 00000107 "There are also B<source> and B<dest> keys."
NSQ_SOURCE_LINE 00000108 "The key B<src> is also accepted as an equivalent to B<source>, and B<dst> or"
NSQ_SOURCE_LINE 00000109 "B<destination> may be used as equivalents to B<dest>."
NSQ_SOURCE_LINE 00000110 "The B<source> option may take a scalar or an array reference."
NSQ_SOURCE_LINE 00000111 "If the source is the local system then multiple B<source> paths are allowed."
NSQ_SOURCE_LINE 00000112 "In this case an array reference should be used."
NSQ_SOURCE_LINE 00000113 "There is also a method for passing multiple source paths to a remote system."
NSQ_SOURCE_LINE 00000114 "This method may be triggered in this module by passing the remote hostname to"
NSQ_SOURCE_LINE 00000115 "the B<srchost> key and passing an array reference to the B<source> key."
NSQ_SOURCE_LINE 00000116 "If the source host is being accessed via an Rsync server, the remote hostname"
NSQ_SOURCE_LINE 00000117 "should have a single trailing colon on the name."
NSQ_SOURCE_LINE 00000118 "When rsync is called, the B<srchost> value and the values in the B<source>"
NSQ_SOURCE_LINE 00000119 "array will be joined with a colon resulting in the double-colon required for"
NSQ_SOURCE_LINE 00000120 "server access."
NSQ_SOURCE_LINE 00000121 "The B<dest> key only takes a scalar since I<rsync> only accepts a single"
NSQ_SOURCE_LINE 00000122 "destination path."
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "Version 2.6.0 of I<rsync(1)> provides a new B<files-from> option along with"
NSQ_SOURCE_LINE 00000125 "a few other supporting options (B<from0>, B<no-relative>, and"
NSQ_SOURCE_LINE 00000126 "B<no-implied-dirs>)."
NSQ_SOURCE_LINE 00000127 "To support this wonderful new option at the level it deserves, this module"
NSQ_SOURCE_LINE 00000128 "now has an additional parameter."
NSQ_SOURCE_LINE 00000129 "As of version 0.46 the value of B<files-from> may be an array reference."
NSQ_SOURCE_LINE 00000130 "The contents of the array are passed to B<files-from> the same as the"
NSQ_SOURCE_LINE 00000131 "below method using B<infun> but implemented inside the module."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "If B<files-from> is set to '-' (meaning read from stdin) you can define"
NSQ_SOURCE_LINE 00000134 "B<infun> to be a reference to a function that prints your file list to the"
NSQ_SOURCE_LINE 00000135 "default file handle."
NSQ_SOURCE_LINE 00000136 "The output from the function is attached to stdin of the rsync call during"
NSQ_SOURCE_LINE 00000137 "exec."
NSQ_SOURCE_LINE 00000138 "If B<infun> is defined it will be called regardless of the value of"
NSQ_SOURCE_LINE 00000139 "B<files-from>, so it can provide any data expected on stdin, but keep in mind"
NSQ_SOURCE_LINE 00000140 "that stdin will not be attached to a tty so it is not very useful for sending"
NSQ_SOURCE_LINE 00000141 "passwords (see the I<rsync(1)> and I<ssh(1)> man pages for ways to handle"
NSQ_SOURCE_LINE 00000142 "authentication)."
NSQ_SOURCE_LINE 00000143 "The I<rsync(1)> man page has a more complete description of B<files-from>."
NSQ_SOURCE_LINE 00000144 "Also see L<File::Find> for ideas to use with B<files-from> and B<infun>."
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "The B<infun> option may also be used with the B<include-from> or"
NSQ_SOURCE_LINE 00000147 "B<exclude-from> options, but this is generally more clumsy than using the"
NSQ_SOURCE_LINE 00000148 "B<include> or B<exclude> arrays."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Version 2.6.3 of I<rsync(1)> provides new options B<partial-dir>,"
NSQ_SOURCE_LINE 00000151 "B<checksum-seed>, B<keep-dirlinks>, B<inplace>, B<ipv4>, and B<ipv6>."
NSQ_SOURCE_LINE 00000152 "Version 2.6.4 of I<rsync(1)> provides new options B<del>, B<delete-before>"
NSQ_SOURCE_LINE 00000153 "B<delete-during>, B<delay-updates>, B<dirs>, B<filter>, B<fuzzy>,"
NSQ_SOURCE_LINE 00000154 "B<itemize-changes>, B<list-only>, B<omit-dir-times>, B<remove-sent-files>,"
NSQ_SOURCE_LINE 00000155 "B<max-size>, and B<protocol>."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Version 0.38 of this module also added support for the B<acls> option that"
NSQ_SOURCE_LINE 00000158 "is not part of I<rsync(1)> unless the patch has been applied, but people do"
NSQ_SOURCE_LINE 00000159 "use it."
NSQ_SOURCE_LINE 00000160 "It also includes a new B<literal> option that takes an array reference"
NSQ_SOURCE_LINE 00000161 "similar to B<include>, B<exclude>, and B<filter>."
NSQ_SOURCE_LINE 00000162 "Any arguments in the array are passed as literal arguments to rsync, and are"
NSQ_SOURCE_LINE 00000163 "passed first."
NSQ_SOURCE_LINE 00000164 "They should have the proper single or double hyphen prefixes and the elements"
NSQ_SOURCE_LINE 00000165 "should be split up the way you want them passed to exec."
NSQ_SOURCE_LINE 00000166 "The purpose of this option is to allow the use of arbitrary options added by"
NSQ_SOURCE_LINE 00000167 "patches, and/or to allow the use of new options in rsync without needing an"
NSQ_SOURCE_LINE 00000168 "imediate update to the module in addtition to I<rsync(1)> itself."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "=cut"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "sub new {"
NSQ_SOURCE_LINE 00000173 "   my $class = shift;"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "   # seed the options hash, booleans, scalars, excludes, source, dest, data,"
NSQ_SOURCE_LINE 00000176 "   # status, stderr/stdout storage for last exec"
NSQ_SOURCE_LINE 00000177 "   my $self = {"
NSQ_SOURCE_LINE 00000178 "      # these are the boolean flags to rsync, all default off, including them"
NSQ_SOURCE_LINE 00000179 "      # in the args list turns them on"
NSQ_SOURCE_LINE 00000180 "      flag => {"
NSQ_SOURCE_LINE 00000181 "         map { $_ => 0 }"
NSQ_SOURCE_LINE 00000182 "            qw(8-bit-output acls append append-verify archive backup"
NSQ_SOURCE_LINE 00000183 "            blocking-io checksum compress copy-dirlinks copy-links"
NSQ_SOURCE_LINE 00000184 "            copy-unsafe-links crtimes cvs-exclude daemon del delay-updates"
NSQ_SOURCE_LINE 00000185 "            delete delete-after delete-before delete-delay delete-during"
NSQ_SOURCE_LINE 00000186 "            delete-excluded delete-missing-args devices dirs dry-run"
NSQ_SOURCE_LINE 00000187 "            executability existing fake-super fileflags force force-change"
NSQ_SOURCE_LINE 00000188 "            force-delete force-schange force-uchange from0 fuzzy group groups"
NSQ_SOURCE_LINE 00000189 "            hard-links help hfs-compression ignore-errors ignore-existing"
NSQ_SOURCE_LINE 00000190 "            ignore-missing-args ignore-non-existing ignore-times inc-recursive"
NSQ_SOURCE_LINE 00000191 "            inplace ipv4 ipv6 keep-dirlinks links list-only msgs2stderr"
NSQ_SOURCE_LINE 00000192 "            munge-links new-compress no-blocking-io no-detach no-devices"
NSQ_SOURCE_LINE 00000193 "            no-dirs no-groups no-iconv no-implied-dirs no-inc-recursive"
NSQ_SOURCE_LINE 00000194 "            no-links no-motd no-owner no-partial no-perms no-progress"
NSQ_SOURCE_LINE 00000195 "            no-protect-args no-recursive no-relative no-specials no-super"
NSQ_SOURCE_LINE 00000196 "            no-times no-whole-file numeric-ids old-compress old-dirs"
NSQ_SOURCE_LINE 00000197 "            omit-dir-times omit-link-times owner partial perms preallocate"
NSQ_SOURCE_LINE 00000198 "            progress protect-args protect-decmpfs prune-empty-dirs recursive"
NSQ_SOURCE_LINE 00000199 "            relative remove-source-files safe-links size-only sparse specials"
NSQ_SOURCE_LINE 00000200 "            stats super times update version whole-file xattrs)"
NSQ_SOURCE_LINE 00000201 "      },"
NSQ_SOURCE_LINE 00000202 "      # these have simple scalar args we cannot easily check"
NSQ_SOURCE_LINE 00000203 "      # use 'string' so I don't forget and leave keyword scalar unqouted"
NSQ_SOURCE_LINE 00000204 "      string => {"
NSQ_SOURCE_LINE 00000205 "         map { $_ => '' }"
NSQ_SOURCE_LINE 00000206 "            qw(address backup-dir block-size bwlimit checksum-seed chown"
NSQ_SOURCE_LINE 00000207 "            compress-level config contimeout csum-length debug files-from"
NSQ_SOURCE_LINE 00000208 "            groupmap iconv info log-file log-file-format log-format max-delete"
NSQ_SOURCE_LINE 00000209 "            max-size min-size modify-window only-write-batch out-format outbuf"
NSQ_SOURCE_LINE 00000210 "            partial-dir password-file port protocol read-batch rsh rsync-path"
NSQ_SOURCE_LINE 00000211 "            skip-compress sockopts suffix temp-dir timeout usermap"
NSQ_SOURCE_LINE 00000212 "            write-batch)"
NSQ_SOURCE_LINE 00000213 "      },"
NSQ_SOURCE_LINE 00000214 "      # these are not flags but counters, each time they appear it raises the"
NSQ_SOURCE_LINE 00000215 "      # count, so we keep track and pass them the same number of times"
NSQ_SOURCE_LINE 00000216 "      counter => {"
NSQ_SOURCE_LINE 00000217 "         map { $_ => 0 }"
NSQ_SOURCE_LINE 00000218 "            qw(human-readable itemize-changes one-file-system quiet verbose)"
NSQ_SOURCE_LINE 00000219 "      },"
NSQ_SOURCE_LINE 00000220 "      # these can be specified multiple times and are additive, the doc also"
NSQ_SOURCE_LINE 00000221 "      # specifies that it is an ordered list so we must preserve that order"
NSQ_SOURCE_LINE 00000222 "      list => {"
NSQ_SOURCE_LINE 00000223 "         'chmod'         => [],"
NSQ_SOURCE_LINE 00000224 "         'compare-dest'  => [],"
NSQ_SOURCE_LINE 00000225 "         'copy-dest'     => [],"
NSQ_SOURCE_LINE 00000226 "         'dparam'        => [],"
NSQ_SOURCE_LINE 00000227 "         'exclude'       => [],"
NSQ_SOURCE_LINE 00000228 "         'exclude-from'  => [],"
NSQ_SOURCE_LINE 00000229 "         'filter'        => [],"
NSQ_SOURCE_LINE 00000230 "         'include'       => [],"
NSQ_SOURCE_LINE 00000231 "         'include-from'  => [],"
NSQ_SOURCE_LINE 00000232 "         'link-dest'     => [],"
NSQ_SOURCE_LINE 00000233 "         'literal'       => [],"
NSQ_SOURCE_LINE 00000234 "         'remote-option' => [],"
NSQ_SOURCE_LINE 00000235 "      },"
NSQ_SOURCE_LINE 00000236 "      code => {    # input/output user functions"
NSQ_SOURCE_LINE 00000237 "         'errfun' => undef,"
NSQ_SOURCE_LINE 00000238 "         'outfun' => undef,"
NSQ_SOURCE_LINE 00000239 "         # function to prvide --*-from=- data via pipe"
NSQ_SOURCE_LINE 00000240 "         'infun' => undef,"
NSQ_SOURCE_LINE 00000241 "      },"
NSQ_SOURCE_LINE 00000242 "      _perlopts => {"
NSQ_SOURCE_LINE 00000243 "         # the path name to the rsync binary (default is to use $PATH)"
NSQ_SOURCE_LINE 00000244 "         'path-to-rsync' => 'rsync',"
NSQ_SOURCE_LINE 00000245 "         # hostname of source, used if 'source' is an array reference"
NSQ_SOURCE_LINE 00000246 "         'srchost' => '',"
NSQ_SOURCE_LINE 00000247 "         # double-quote source and/or destination paths"
NSQ_SOURCE_LINE 00000248 "         'quote-src' => 0,"
NSQ_SOURCE_LINE 00000249 "         'quote-dst' => 0,"
NSQ_SOURCE_LINE 00000250 "         # whether or not to print debug statements"
NSQ_SOURCE_LINE 00000251 "         'moddebug' => 0,"
NSQ_SOURCE_LINE 00000252 "      },"
NSQ_SOURCE_LINE 00000253 "      # source host and/or path names"
NSQ_SOURCE_LINE 00000254 "      'source' => '',"
NSQ_SOURCE_LINE 00000255 "      # destination host and/or path"
NSQ_SOURCE_LINE 00000256 "      'dest' => '',"
NSQ_SOURCE_LINE 00000257 "      # return status from last exec"
NSQ_SOURCE_LINE 00000258 "      '_status'     => 0,"
NSQ_SOURCE_LINE 00000259 "      '_realstatus' => 0,"
NSQ_SOURCE_LINE 00000260 "      # last rsync command-line executed"
NSQ_SOURCE_LINE 00000261 "      '_lastcmd' => undef,"
NSQ_SOURCE_LINE 00000262 "     # stderr from last exec in array format (messages from remote rsync proc)"
NSQ_SOURCE_LINE 00000263 "      '_err' => 0,"
NSQ_SOURCE_LINE 00000264 "      # stdout from last exec in array format (messages from local rsync proc)"
NSQ_SOURCE_LINE 00000265 "      '_out' => 0,"
NSQ_SOURCE_LINE 00000266 "      # this flag changes error checking in 'exec' when called by 'list'"
NSQ_SOURCE_LINE 00000267 "      '_list_mode' => 0,"
NSQ_SOURCE_LINE 00000268 "      # this array used to preserve arg order"
NSQ_SOURCE_LINE 00000269 "      '_args' => [],"
NSQ_SOURCE_LINE 00000270 "   };"
NSQ_SOURCE_LINE 00000271 "   bless $self, $class;    # bless it first so defopts can find out the class"
NSQ_SOURCE_LINE 00000272 "   if (@_) {"
NSQ_SOURCE_LINE 00000273 "      &defopts($self, @_) or return;"
NSQ_SOURCE_LINE 00000274 "   }"
NSQ_SOURCE_LINE 00000275 "   return $self;"
NSQ_SOURCE_LINE 00000276 "}"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head2 File::Rsync::defopts"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "    $obj->defopts(@options);"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "        or"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "    $obj->defopts(\\@options);"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "Set default options for future exec calls for the object."
NSQ_SOURCE_LINE 00000287 "See I<rsync(1)> for a complete list of valid options."
NSQ_SOURCE_LINE 00000288 "This is really the internal method that I<new> calls but you can use it too."
NSQ_SOURCE_LINE 00000289 "The B<verbose> and B<quiet> options to rsync are actually counters."
NSQ_SOURCE_LINE 00000290 "When assigning the perl hash-style options you may specify the counter value"
NSQ_SOURCE_LINE 00000291 "directly and the module will pass the proper number of options to rsync."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=cut"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "sub defopts {"
NSQ_SOURCE_LINE 00000296 "   # this method has now been split into 2 sub methods (parse and save)"
NSQ_SOURCE_LINE 00000297 "   # _saveopts and _parseopts should only be used via defopts or exec"
NSQ_SOURCE_LINE 00000298 "   my $self = shift;"
NSQ_SOURCE_LINE 00000299 "   &_saveopts($self, &_parseopts($self, @_));"
NSQ_SOURCE_LINE 00000300 "}"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "sub _parseopts {"
NSQ_SOURCE_LINE 00000303 "   # this method checks and converts it's args into a reference to a hash"
NSQ_SOURCE_LINE 00000304 "   # of valid options and returns it to the caller"
NSQ_SOURCE_LINE 00000305 "   my $self    = shift;"
NSQ_SOURCE_LINE 00000306 "   my $pkgname = ref $self;"
NSQ_SOURCE_LINE 00000307 "   my $href;"
NSQ_SOURCE_LINE 00000308 "   my %OPT = ();    # this is the hash we will return a ref to"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "   # make sure we are passed the proper number of args"
NSQ_SOURCE_LINE 00000311 "   if (@_ == 1) {"
NSQ_SOURCE_LINE 00000312 "      if (my $reftype = ref $_[0]) {"
NSQ_SOURCE_LINE 00000313 "         if ($reftype eq 'HASH') {"
NSQ_SOURCE_LINE 00000314 "            carp \"$pkgname: hash reference is deprecated, use array or list.\""
NSQ_SOURCE_LINE 00000315 "               if $^W;"
NSQ_SOURCE_LINE 00000316 "            @_ = %{$_[0]};"
NSQ_SOURCE_LINE 00000317 "            $href++;"
NSQ_SOURCE_LINE 00000318 "         } elsif ($reftype eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000319 "            @_ = @{$_[0]};"
NSQ_SOURCE_LINE 00000320 "         } else {"
NSQ_SOURCE_LINE 00000321 "            carp \"$pkgname: invalid reference type ($reftype) option.\";"
NSQ_SOURCE_LINE 00000322 "            return;"
NSQ_SOURCE_LINE 00000323 "         }"
NSQ_SOURCE_LINE 00000324 "      } else {"
NSQ_SOURCE_LINE 00000325 "         carp \"$pkgname: invalid option ($_[0]).\";"
NSQ_SOURCE_LINE 00000326 "         return;"
NSQ_SOURCE_LINE 00000327 "      }"
NSQ_SOURCE_LINE 00000328 "   }"
NSQ_SOURCE_LINE 00000329 "   if (@_ % 2) {"
NSQ_SOURCE_LINE 00000330 "      carp"
NSQ_SOURCE_LINE 00000331 "         \"$pkgname: invalid number of options passed (must be key/value pairs).\";"
NSQ_SOURCE_LINE 00000332 "      return;"
NSQ_SOURCE_LINE 00000333 "   }"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "   # now process the options given, we handle debug first"
NSQ_SOURCE_LINE 00000336 "   for (my $i = 0; $i < @_; $i += 2) {"
NSQ_SOURCE_LINE 00000337 "      if ($_[$i] eq 'moddebug') {"
NSQ_SOURCE_LINE 00000338 "         $OPT{moddebug} = $_[ $i + 1 ];"
NSQ_SOURCE_LINE 00000339 "         warn \"setting debug flag\\n\" if $OPT{moddebug};"
NSQ_SOURCE_LINE 00000340 "         last;"
NSQ_SOURCE_LINE 00000341 "      }"
NSQ_SOURCE_LINE 00000342 "   }"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "   my @order;"
NSQ_SOURCE_LINE 00000345 "   while (my ($inkey, $val) = splice @_, 0, 2) {"
NSQ_SOURCE_LINE 00000346 "      (my $key = $inkey) =~ tr/_/-/;"
NSQ_SOURCE_LINE 00000347 "      $key =~ s/^--?//;    # remove any leading hyphens if found"
NSQ_SOURCE_LINE 00000348 "      $key = 'source' if $key eq 'src';"
NSQ_SOURCE_LINE 00000349 "      $key = 'dest' if $key eq 'dst' or $key eq 'destination';"
NSQ_SOURCE_LINE 00000350 "      next if $key eq 'moddebug';    # we did this one already"
NSQ_SOURCE_LINE 00000351 "      warn \"processing option: $inkey\\n\""
NSQ_SOURCE_LINE 00000352 "         if $OPT{moddebug}"
NSQ_SOURCE_LINE 00000353 "         or $self->{_perlopts}{moddebug};"
NSQ_SOURCE_LINE 00000354 "      if (  exists $self->{flag}{$key}"
NSQ_SOURCE_LINE 00000355 "         or exists $self->{string}{$key}"
NSQ_SOURCE_LINE 00000356 "         or exists $self->{counter}{$key}"
NSQ_SOURCE_LINE 00000357 "         or exists $self->{_perlopts}{$key})"
NSQ_SOURCE_LINE 00000358 "      {"
NSQ_SOURCE_LINE 00000359 "         if ($key eq 'files-from' and ref $val eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000360 "            push @order, $key, '-', 'infun', $val;    # --files-from=- <\\@"
NSQ_SOURCE_LINE 00000361 "            $OPT{$key} = '-';"
NSQ_SOURCE_LINE 00000362 "            $OPT{infun} = $val;"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "         } else {"
NSQ_SOURCE_LINE 00000365 "            push @order, $key, $val;"
NSQ_SOURCE_LINE 00000366 "            $OPT{$key} = $val;"
NSQ_SOURCE_LINE 00000367 "         }"
NSQ_SOURCE_LINE 00000368 "         next;"
NSQ_SOURCE_LINE 00000369 "      }"
NSQ_SOURCE_LINE 00000370 "      if (exists $self->{list}{$key} or $key eq 'source') {"
NSQ_SOURCE_LINE 00000371 "         if (my $reftype = ref $val) {"
NSQ_SOURCE_LINE 00000372 "            if ($reftype eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000373 "               push @order, $key, $val;"
NSQ_SOURCE_LINE 00000374 "               $OPT{$key} = $val;"
NSQ_SOURCE_LINE 00000375 "               next;"
NSQ_SOURCE_LINE 00000376 "            } elsif ($key eq 'source' && blessed $val) {"
NSQ_SOURCE_LINE 00000377 "               # if it's blessed, assume it returns a string"
NSQ_SOURCE_LINE 00000378 "               $val = [$val];"
NSQ_SOURCE_LINE 00000379 "               push @order, $key, $val;"
NSQ_SOURCE_LINE 00000380 "               $OPT{$key} = $val;"
NSQ_SOURCE_LINE 00000381 "               next;"
NSQ_SOURCE_LINE 00000382 "            } else {"
NSQ_SOURCE_LINE 00000383 "               carp \"$pkgname: invalid reference type for $inkey option.\";"
NSQ_SOURCE_LINE 00000384 "               return;"
NSQ_SOURCE_LINE 00000385 "            }"
NSQ_SOURCE_LINE 00000386 "         } elsif ($key eq 'source') {"
NSQ_SOURCE_LINE 00000387 "            $val = [$val];"
NSQ_SOURCE_LINE 00000388 "            push @order, $key, $val;"
NSQ_SOURCE_LINE 00000389 "            $OPT{$key} = $val;"
NSQ_SOURCE_LINE 00000390 "            next;"
NSQ_SOURCE_LINE 00000391 "         } else {"
NSQ_SOURCE_LINE 00000392 "            carp \"$pkgname: $inkey value is not a reference.\";"
NSQ_SOURCE_LINE 00000393 "            return;"
NSQ_SOURCE_LINE 00000394 "         }"
NSQ_SOURCE_LINE 00000395 "      }"
NSQ_SOURCE_LINE 00000396 "      if ($key eq 'dest') {"
NSQ_SOURCE_LINE 00000397 "         push @order, $key, $val;"
NSQ_SOURCE_LINE 00000398 "         $OPT{$key} = $val;"
NSQ_SOURCE_LINE 00000399 "         next;"
NSQ_SOURCE_LINE 00000400 "      }"
NSQ_SOURCE_LINE 00000401 "      if (exists $self->{code}{$key}) {"
NSQ_SOURCE_LINE 00000402 "         if (ref $val eq 'CODE') {"
NSQ_SOURCE_LINE 00000403 "            push @order, $key, $val;"
NSQ_SOURCE_LINE 00000404 "            $OPT{$key} = $val;"
NSQ_SOURCE_LINE 00000405 "            next;"
NSQ_SOURCE_LINE 00000406 "         } elsif ($key eq 'infun' and ref $val eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000407 "            # IPC::Run3 lets us pass an array ref as stdin :)"
NSQ_SOURCE_LINE 00000408 "            push @order, $key, $val;"
NSQ_SOURCE_LINE 00000409 "            $OPT{$key} = $val;"
NSQ_SOURCE_LINE 00000410 "            next;"
NSQ_SOURCE_LINE 00000411 "         } else {"
NSQ_SOURCE_LINE 00000412 "            carp \"$pkgname: $inkey option is not a function reference.\";"
NSQ_SOURCE_LINE 00000413 "            return;"
NSQ_SOURCE_LINE 00000414 "         }"
NSQ_SOURCE_LINE 00000415 "      }"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "      carp \"$pkgname: $inkey - unknown option.\";"
NSQ_SOURCE_LINE 00000418 "      return;"
NSQ_SOURCE_LINE 00000419 "   }"
NSQ_SOURCE_LINE 00000420 "   $OPT{_args} = \\@order unless $href;"
NSQ_SOURCE_LINE 00000421 "   return \\%OPT;"
NSQ_SOURCE_LINE 00000422 "}"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "sub _saveopts {"
NSQ_SOURCE_LINE 00000425 "   # save the data from the hash passed in the object"
NSQ_SOURCE_LINE 00000426 "   my $self    = shift;"
NSQ_SOURCE_LINE 00000427 "   my $pkgname = ref $self;"
NSQ_SOURCE_LINE 00000428 "   my $opts    = shift;"
NSQ_SOURCE_LINE 00000429 "   return unless ref $opts eq 'HASH';"
NSQ_SOURCE_LINE 00000430 "SO: for my $opt (keys %$opts) {"
NSQ_SOURCE_LINE 00000431 "      for my $type (qw(flag string counter list code _perlopts)) {"
NSQ_SOURCE_LINE 00000432 "         if (exists $self->{$type}{$opt}) {"
NSQ_SOURCE_LINE 00000433 "            $self->{$type}{$opt} = $opts->{$opt};"
NSQ_SOURCE_LINE 00000434 "            next SO;"
NSQ_SOURCE_LINE 00000435 "         }"
NSQ_SOURCE_LINE 00000436 "      }"
NSQ_SOURCE_LINE 00000437 "      if (  $opt eq 'source'"
NSQ_SOURCE_LINE 00000438 "         or $opt eq 'dest'"
NSQ_SOURCE_LINE 00000439 "         or $opt eq '_args')"
NSQ_SOURCE_LINE 00000440 "      {"
NSQ_SOURCE_LINE 00000441 "         $self->{$opt} = $opts->{$opt};"
NSQ_SOURCE_LINE 00000442 "      } else {"
NSQ_SOURCE_LINE 00000443 "         carp \"$pkgname: unknown option: $opt.\";"
NSQ_SOURCE_LINE 00000444 "         return;"
NSQ_SOURCE_LINE 00000445 "      }"
NSQ_SOURCE_LINE 00000446 "   }    # end SO"
NSQ_SOURCE_LINE 00000447 "   return 1;"
NSQ_SOURCE_LINE 00000448 "}"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "=head2 File::Rsync::getcmd"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "    my $cmd = $obj->getcmd(@options);"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "        or"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "    my $cmd = $obj->getcmd(\\@options);"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "        or"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "    my ($cmd, $infun, $outfun, $errfun, $debug) = $obj->getcmd(\\@options);"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "I<getcmd> returns a reference to an array containing the real rsync command"
NSQ_SOURCE_LINE 00000463 "that would be called if the exec function were called."
NSQ_SOURCE_LINE 00000464 "The last example above includes a reference to the optional stdin function,"
NSQ_SOURCE_LINE 00000465 "stdout function, stderr function, and the debug setting."
NSQ_SOURCE_LINE 00000466 "This is the form used by the I<exec> method to get the extra parameters it"
NSQ_SOURCE_LINE 00000467 "needs to do its job."
NSQ_SOURCE_LINE 00000468 "The function is exposed to allow a user-defined exec function to be used, or"
NSQ_SOURCE_LINE 00000469 "for debugging purposes."
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "=cut"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "sub getcmd {"
NSQ_SOURCE_LINE 00000474 "   my $self    = shift;"
NSQ_SOURCE_LINE 00000475 "   my $pkgname = ref $self;"
NSQ_SOURCE_LINE 00000476 "   my $merged  = $self;"
NSQ_SOURCE_LINE 00000477 "   my $list    = $self->{_list_mode};"
NSQ_SOURCE_LINE 00000478 "   $self->{_list_mode} = 0;"
NSQ_SOURCE_LINE 00000479 "   if (@_) {"
NSQ_SOURCE_LINE 00000480 "      # If args are passed to exec then we have to merge the saved"
NSQ_SOURCE_LINE 00000481 "      # (default) options with those passed, for any conflicts those passed"
NSQ_SOURCE_LINE 00000482 "      # directly to exec take precidence"
NSQ_SOURCE_LINE 00000483 "      my $execopts = &_parseopts($self, @_);"
NSQ_SOURCE_LINE 00000484 "      return unless ref $execopts eq 'HASH';"
NSQ_SOURCE_LINE 00000485 "      my %runopts = ();"
NSQ_SOURCE_LINE 00000486 "      # first copy the default info from $self"
NSQ_SOURCE_LINE 00000487 "      for my $type (qw(flag string counter list code _perlopts)) {"
NSQ_SOURCE_LINE 00000488 "         for my $opt (keys %{$self->{$type}}) {"
NSQ_SOURCE_LINE 00000489 "            $runopts{$type}{$opt} = $self->{$type}{$opt};"
NSQ_SOURCE_LINE 00000490 "         }"
NSQ_SOURCE_LINE 00000491 "      }"
NSQ_SOURCE_LINE 00000492 "      for my $opt (qw(source dest)) {"
NSQ_SOURCE_LINE 00000493 "         $runopts{$opt} = $self->{$opt};"
NSQ_SOURCE_LINE 00000494 "      }"
NSQ_SOURCE_LINE 00000495 "      @{$runopts{_args}} = @{$self->{_args}};"
NSQ_SOURCE_LINE 00000496 "      # now allow any args passed directly to exec to override"
NSQ_SOURCE_LINE 00000497 "   OPT: for my $opt (keys %$execopts) {"
NSQ_SOURCE_LINE 00000498 "         for my $type (qw(flag string counter list code _perlopts)) {"
NSQ_SOURCE_LINE 00000499 "            if (exists $runopts{$type}{$opt}) {"
NSQ_SOURCE_LINE 00000500 "               $runopts{$type}{$opt} = $execopts->{$opt};"
NSQ_SOURCE_LINE 00000501 "               next OPT;"
NSQ_SOURCE_LINE 00000502 "            }"
NSQ_SOURCE_LINE 00000503 "         }"
NSQ_SOURCE_LINE 00000504 "         if ($opt eq '_args') {"
NSQ_SOURCE_LINE 00000505 "            # only preserve order if we already have order"
NSQ_SOURCE_LINE 00000506 "            push @{$runopts{$opt}}, @{$execopts->{$opt}}"
NSQ_SOURCE_LINE 00000507 "               if @{$runopts{$opt}};"
NSQ_SOURCE_LINE 00000508 "         } elsif ($opt eq 'source' or $opt eq 'dest') {"
NSQ_SOURCE_LINE 00000509 "            $runopts{$opt} = $execopts->{$opt};"
NSQ_SOURCE_LINE 00000510 "         } else {"
NSQ_SOURCE_LINE 00000511 "            carp \"$pkgname: unknown option: $opt.\";"
NSQ_SOURCE_LINE 00000512 "            return;"
NSQ_SOURCE_LINE 00000513 "         }"
NSQ_SOURCE_LINE 00000514 "      }"
NSQ_SOURCE_LINE 00000515 "      $merged = \\%runopts;"
NSQ_SOURCE_LINE 00000516 "   }"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "   if ("
NSQ_SOURCE_LINE 00000519 "      !@{$merged->{_args}}    # include and exclude allowed if ordered args"
NSQ_SOURCE_LINE 00000520 "      && ( (@{$merged->{list}{exclude}} != 0)"
NSQ_SOURCE_LINE 00000521 "         + (@{$merged->{list}{include}} != 0)"
NSQ_SOURCE_LINE 00000522 "         + (@{$merged->{list}{filter}} != 0) > 1)"
NSQ_SOURCE_LINE 00000523 "      )"
NSQ_SOURCE_LINE 00000524 "   {"
NSQ_SOURCE_LINE 00000525 "      carp \"$pkgname: 'exclude' and/or 'include' and/or 'filter' \""
NSQ_SOURCE_LINE 00000526 "         . \"options specified, only one allowed.\";"
NSQ_SOURCE_LINE 00000527 "      return;"
NSQ_SOURCE_LINE 00000528 "   }"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "   my $srchost = $merged->{srchost};"
NSQ_SOURCE_LINE 00000531 "   $srchost .= ':' if $srchost and substr($srchost, 0, 8) ne 'rsync://';"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "   # build the real command"
NSQ_SOURCE_LINE 00000534 "   my @cmd = ($merged->{_perlopts}{'path-to-rsync'});"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "   if (@{$merged->{_args}}) {    # prefer ordered args if we have them"
NSQ_SOURCE_LINE 00000537 "      my $gotsrc;"
NSQ_SOURCE_LINE 00000538 "      for (my $e = 0; $e < @{$merged->{_args}}; $e += 2) {"
NSQ_SOURCE_LINE 00000539 "         my $key = $merged->{_args}[$e];"
NSQ_SOURCE_LINE 00000540 "         my $val = $merged->{_args}[ $e + 1 ];"
NSQ_SOURCE_LINE 00000541 "         if ($key eq 'literal') {"
NSQ_SOURCE_LINE 00000542 "            push @cmd, ref $val eq 'ARRAY' ? @$val : $val;"
NSQ_SOURCE_LINE 00000543 "         } elsif (exists $merged->{flag}{$key}) {"
NSQ_SOURCE_LINE 00000544 "            push @cmd, \"--$key\" if $val;"
NSQ_SOURCE_LINE 00000545 "         } elsif (exists $merged->{string}{$key}) {"
NSQ_SOURCE_LINE 00000546 "            push @cmd, \"--$key=$val\" if $val;"
NSQ_SOURCE_LINE 00000547 "         } elsif (exists $merged->{counter}{$key}) {"
NSQ_SOURCE_LINE 00000548 "            for (my $i = 0; $i < $val; $i++) {"
NSQ_SOURCE_LINE 00000549 "               push @cmd, \"--$key\";"
NSQ_SOURCE_LINE 00000550 "            }"
NSQ_SOURCE_LINE 00000551 "         } elsif (exists $merged->{list}{$key}) {"
NSQ_SOURCE_LINE 00000552 "            push @cmd, ref $val eq 'ARRAY'"
NSQ_SOURCE_LINE 00000553 "               ? map \"--$key=$_\", @$val"
NSQ_SOURCE_LINE 00000554 "               : \"--$key=$val\";"
NSQ_SOURCE_LINE 00000555 "         } elsif ($key eq 'source') {"
NSQ_SOURCE_LINE 00000556 "            if ($merged->{srchost}) {"
NSQ_SOURCE_LINE 00000557 "               push @cmd, $srchost . join ' ',"
NSQ_SOURCE_LINE 00000558 "                  $merged->{'quote-src'}"
NSQ_SOURCE_LINE 00000559 "                  ? map (\"\\\"$_\\\"\", ref $val eq 'ARRAY' ? @$val : $val)"
NSQ_SOURCE_LINE 00000560 "                  : ref $val eq 'ARRAY' ? @$val"
NSQ_SOURCE_LINE 00000561 "                  :                       $val;"
NSQ_SOURCE_LINE 00000562 "            } else {"
NSQ_SOURCE_LINE 00000563 "               push @cmd,"
NSQ_SOURCE_LINE 00000564 "                  $merged->{'quote-src'}"
NSQ_SOURCE_LINE 00000565 "                  ? map (\"\\\"$_\\\"\", ref $val eq 'ARRAY' ? @$val : $val)"
NSQ_SOURCE_LINE 00000566 "                  : ref $val eq 'ARRAY' ? @$val"
NSQ_SOURCE_LINE 00000567 "                  :                       $val;"
NSQ_SOURCE_LINE 00000568 "            }"
NSQ_SOURCE_LINE 00000569 "            $gotsrc++;"
NSQ_SOURCE_LINE 00000570 "         } elsif ($key eq 'dest') {"
NSQ_SOURCE_LINE 00000571 "            if ($list) {"
NSQ_SOURCE_LINE 00000572 "               if (not $gotsrc) {"
NSQ_SOURCE_LINE 00000573 "                  if ($merged->{srchost}) {"
NSQ_SOURCE_LINE 00000574 "                     push @cmd, $srchost;"
NSQ_SOURCE_LINE 00000575 "                  } else {"
NSQ_SOURCE_LINE 00000576 "                     carp \"$pkgname: no 'source' specified.\";"
NSQ_SOURCE_LINE 00000577 "                     return;"
NSQ_SOURCE_LINE 00000578 "                  }"
NSQ_SOURCE_LINE 00000579 "               }"
NSQ_SOURCE_LINE 00000580 "            } elsif (not $gotsrc) {"
NSQ_SOURCE_LINE 00000581 "               carp"
NSQ_SOURCE_LINE 00000582 "                  \"$pkgname: option 'dest' specified without 'source' option.\";"
NSQ_SOURCE_LINE 00000583 "               return;"
NSQ_SOURCE_LINE 00000584 "            } else {"
NSQ_SOURCE_LINE 00000585 "               push @cmd, $merged->{'quote-dst'} ? \"\\\"$val\\\"\" : $val;"
NSQ_SOURCE_LINE 00000586 "            }"
NSQ_SOURCE_LINE 00000587 "         }"
NSQ_SOURCE_LINE 00000588 "      }"
NSQ_SOURCE_LINE 00000589 "   } else {"
NSQ_SOURCE_LINE 00000590 "      # we do a bunch of extra work here to support hash refs,"
NSQ_SOURCE_LINE 00000591 "      # they don't work well here, no order, we do what we can"
NSQ_SOURCE_LINE 00000592 "      # put any literal options first"
NSQ_SOURCE_LINE 00000593 "      push @cmd, @{$merged->{list}{literal}} if @{$merged->{list}{literal}};"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "      for my $opt (sort keys %{$merged->{flag}}) {"
NSQ_SOURCE_LINE 00000596 "         push @cmd, \"--$opt\" if $merged->{flag}{$opt};"
NSQ_SOURCE_LINE 00000597 "      }"
NSQ_SOURCE_LINE 00000598 "      for my $opt (sort keys %{$merged->{string}}) {"
NSQ_SOURCE_LINE 00000599 "         push @cmd, \"--$opt=$merged->{string}{$opt}\""
NSQ_SOURCE_LINE 00000600 "            if $merged->{string}{$opt};"
NSQ_SOURCE_LINE 00000601 "      }"
NSQ_SOURCE_LINE 00000602 "      for my $opt (sort keys %{$merged->{counter}}) {"
NSQ_SOURCE_LINE 00000603 "         for (my $i = 0; $i < $merged->{counter}{$opt}; $i++) {"
NSQ_SOURCE_LINE 00000604 "            push @cmd, \"--$opt\";"
NSQ_SOURCE_LINE 00000605 "         }"
NSQ_SOURCE_LINE 00000606 "      }"
NSQ_SOURCE_LINE 00000607 "      for my $opt (sort keys %{$merged->{list}}) {"
NSQ_SOURCE_LINE 00000608 "         next if $opt eq 'literal';"
NSQ_SOURCE_LINE 00000609 "         for my $val (@{$merged->{list}{$opt}}) {"
NSQ_SOURCE_LINE 00000610 "            push @cmd, \"--$opt=$val\";"
NSQ_SOURCE_LINE 00000611 "         }"
NSQ_SOURCE_LINE 00000612 "      }"
NSQ_SOURCE_LINE 00000613 ""
NSQ_SOURCE_LINE 00000614 "      if ($merged->{source}) {"
NSQ_SOURCE_LINE 00000615 "         if ($merged->{srchost}) {"
NSQ_SOURCE_LINE 00000616 "            push @cmd, $srchost . join ' ',"
NSQ_SOURCE_LINE 00000617 "               $merged->{'quote-src'}"
NSQ_SOURCE_LINE 00000618 "               ? map { \"\\\"$_\\\"\" } @{$merged->{source}}"
NSQ_SOURCE_LINE 00000619 "               : @{$merged->{source}};"
NSQ_SOURCE_LINE 00000620 "         } else {"
NSQ_SOURCE_LINE 00000621 "            push @cmd,"
NSQ_SOURCE_LINE 00000622 "               $merged->{'quote-src'}"
NSQ_SOURCE_LINE 00000623 "               ? map { \"\\\"$_\\\"\" } @{$merged->{source}}"
NSQ_SOURCE_LINE 00000624 "               : @{$merged->{source}};"
NSQ_SOURCE_LINE 00000625 "         }"
NSQ_SOURCE_LINE 00000626 "      } elsif ($merged->{srchost} and $list) {"
NSQ_SOURCE_LINE 00000627 "         push @cmd, $srchost;"
NSQ_SOURCE_LINE 00000628 "      } else {"
NSQ_SOURCE_LINE 00000629 "         if ($list) {"
NSQ_SOURCE_LINE 00000630 "            carp \"$pkgname: no 'source' specified.\";"
NSQ_SOURCE_LINE 00000631 "            return;"
NSQ_SOURCE_LINE 00000632 "         } elsif ($merged->{dest}) {"
NSQ_SOURCE_LINE 00000633 "            carp \"$pkgname: option 'dest' specified without 'source' option.\";"
NSQ_SOURCE_LINE 00000634 "            return;"
NSQ_SOURCE_LINE 00000635 "         } else {"
NSQ_SOURCE_LINE 00000636 "            carp \"$pkgname: no source or destination specified.\";"
NSQ_SOURCE_LINE 00000637 "            return;"
NSQ_SOURCE_LINE 00000638 "         }"
NSQ_SOURCE_LINE 00000639 "      }"
NSQ_SOURCE_LINE 00000640 "      unless ($list) {"
NSQ_SOURCE_LINE 00000641 "         if ($merged->{dest}) {"
NSQ_SOURCE_LINE 00000642 "            push @cmd, $merged->{'quote-dst'}"
NSQ_SOURCE_LINE 00000643 "               ? \"\\\"$merged->{dest}\\\"\""
NSQ_SOURCE_LINE 00000644 "               : $merged->{dest};"
NSQ_SOURCE_LINE 00000645 "         } else {"
NSQ_SOURCE_LINE 00000646 "            carp \"$pkgname: option 'source' specified without 'dest' option.\";"
NSQ_SOURCE_LINE 00000647 "            return;"
NSQ_SOURCE_LINE 00000648 "         }"
NSQ_SOURCE_LINE 00000649 "      }"
NSQ_SOURCE_LINE 00000650 "   }"
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "   return ("
NSQ_SOURCE_LINE 00000653 "      wantarray"
NSQ_SOURCE_LINE 00000654 "      ? (\\@cmd,                   $merged->{code}{infun},"
NSQ_SOURCE_LINE 00000655 "         $merged->{code}{outfun}, $merged->{code}{errfun},"
NSQ_SOURCE_LINE 00000656 "         $merged->{_perlopts}{moddebug}"
NSQ_SOURCE_LINE 00000657 "         )"
NSQ_SOURCE_LINE 00000658 "      : \\@cmd"
NSQ_SOURCE_LINE 00000659 "   );"
NSQ_SOURCE_LINE 00000660 "}"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "=head2 File::Rsync::exec"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "    $obj->exec(@options) or warn \"rsync failed\\n\";"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "        or"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "    $obj->exec(\\@options) or warn \"rsync failed\\n\";"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "This is the method that does the real work."
NSQ_SOURCE_LINE 00000671 "Any options passed to this routine are appended to any pre-set options and"
NSQ_SOURCE_LINE 00000672 "are not saved."
NSQ_SOURCE_LINE 00000673 "They effect the current execution of I<rsync> only."
NSQ_SOURCE_LINE 00000674 "In the case of conflicts, the options passed directly to I<exec> take"
NSQ_SOURCE_LINE 00000675 "precedence."
NSQ_SOURCE_LINE 00000676 "It returns B<1> if the return status was zero (or true), if the I<rsync>"
NSQ_SOURCE_LINE 00000677 "return status was non-zero it returns B<0> and stores the return status."
NSQ_SOURCE_LINE 00000678 "You can examine the return status from I<rsync> and any output to stdout and"
NSQ_SOURCE_LINE 00000679 "stderr with the methods listed below."
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "=cut"
NSQ_SOURCE_LINE 00000682 ""
NSQ_SOURCE_LINE 00000683 "sub exec {"
NSQ_SOURCE_LINE 00000684 "   my $self = shift;"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "   my ($cmd, $infun, $outfun, $errfun, $debug) = $self->getcmd(@_);"
NSQ_SOURCE_LINE 00000687 "   return unless $cmd;"
NSQ_SOURCE_LINE 00000688 "   warn \"exec: @$cmd\\n\" if $debug;"
NSQ_SOURCE_LINE 00000689 "   my $input;"
NSQ_SOURCE_LINE 00000690 "   if (ref $infun eq 'CODE') {"
NSQ_SOURCE_LINE 00000691 "      my $pid = open my $fh, '-|';"
NSQ_SOURCE_LINE 00000692 "      if ($pid) {    # parent grabs output"
NSQ_SOURCE_LINE 00000693 "         my @in = <$fh>;"
NSQ_SOURCE_LINE 00000694 "         close $fh;"
NSQ_SOURCE_LINE 00000695 "         chomp @in;"
NSQ_SOURCE_LINE 00000696 "         $input = \\@in;"
NSQ_SOURCE_LINE 00000697 "      } else {    # child runs infun"
NSQ_SOURCE_LINE 00000698 "         &{$infun};"
NSQ_SOURCE_LINE 00000699 "         exit;"
NSQ_SOURCE_LINE 00000700 "      }"
NSQ_SOURCE_LINE 00000701 "   } else {"
NSQ_SOURCE_LINE 00000702 "      $input = $infun;"
NSQ_SOURCE_LINE 00000703 "   }"
NSQ_SOURCE_LINE 00000704 "   run3($cmd, $input, \\my $stdout, \\my $stderr);"
NSQ_SOURCE_LINE 00000705 "   $self->{_lastcmd}    = $cmd;"
NSQ_SOURCE_LINE 00000706 "   $self->{_realstatus} = $?;"
NSQ_SOURCE_LINE 00000707 "   $self->{_status}     = $? & 127 ? $? & 127 : $? >> 8;"
NSQ_SOURCE_LINE 00000708 "   $self->{_out}        = $stdout ? [ split /^/m, $stdout ] : '';"
NSQ_SOURCE_LINE 00000709 "   $self->{_err}        = $stderr ? [ split /^/m, $stderr ] : '';"
NSQ_SOURCE_LINE 00000710 "   if ($outfun and $self->{_out}) {"
NSQ_SOURCE_LINE 00000711 "      for (@{$self->{_out}}) { $outfun->($_, 'out') }"
NSQ_SOURCE_LINE 00000712 "   }"
NSQ_SOURCE_LINE 00000713 "   if ($errfun and $self->{_err}) {"
NSQ_SOURCE_LINE 00000714 "      for (@{$self->{_err}}) { $errfun->($_, 'err') }"
NSQ_SOURCE_LINE 00000715 "   }"
NSQ_SOURCE_LINE 00000716 "   return ($self->{_status} ? 0 : 1);"
NSQ_SOURCE_LINE 00000717 "}"
NSQ_SOURCE_LINE 00000718 ""
NSQ_SOURCE_LINE 00000719 "=head2 File::Rsync::list"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "    $out = $obj->list(@options);"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "        or"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "    $out = $obj->list(\\@options);"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "        or"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "    @out = $obj->list(\\@options);"
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "This is a wrapper for I<exec> called without a destination to get a listing."
NSQ_SOURCE_LINE 00000732 "It returns the output of stdout like the I<out> function below."
NSQ_SOURCE_LINE 00000733 "When no destination is given rsync returns the equivalent of 'ls -l' or"
NSQ_SOURCE_LINE 00000734 "'ls -lr' modified by any include/exclude/filter parameters you specify."
NSQ_SOURCE_LINE 00000735 "This is useful for manual comparison without actual changes to the"
NSQ_SOURCE_LINE 00000736 "destination or for comparing against another listing taken at a different"
NSQ_SOURCE_LINE 00000737 "point in time."
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "(As of rsync version 2.6.4-pre1 this can also be accomplished with the"
NSQ_SOURCE_LINE 00000740 "'list-only' option regardless of whether a destination is given.)"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "=cut"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "sub list {"
NSQ_SOURCE_LINE 00000745 "   my $self = shift;"
NSQ_SOURCE_LINE 00000746 "   $self->{_list_mode}++;"
NSQ_SOURCE_LINE 00000747 "   $self->exec(@_);"
NSQ_SOURCE_LINE 00000748 "   if ($self->{_out}) {"
NSQ_SOURCE_LINE 00000749 "      return (wantarray ? @{$self->{_out}} : $self->{_out});"
NSQ_SOURCE_LINE 00000750 "   } else {"
NSQ_SOURCE_LINE 00000751 "      return;"
NSQ_SOURCE_LINE 00000752 "   }"
NSQ_SOURCE_LINE 00000753 "}"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "=head2 File::Rsync::status"
NSQ_SOURCE_LINE 00000756 ""
NSQ_SOURCE_LINE 00000757 "    $rval = $obj->status;"
NSQ_SOURCE_LINE 00000758 ""
NSQ_SOURCE_LINE 00000759 "Returns the status from last I<exec> call right shifted 8 bits."
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "=cut"
NSQ_SOURCE_LINE 00000762 ""
NSQ_SOURCE_LINE 00000763 "sub status {"
NSQ_SOURCE_LINE 00000764 "   my $self = shift;"
NSQ_SOURCE_LINE 00000765 "   return $self->{_status};"
NSQ_SOURCE_LINE 00000766 "}"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "=head2 File::Rsync::realstatus"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "    $rval = $obj->realstatus;"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "Returns the real status from last I<exec> call (not right shifted)."
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "=cut"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "sub realstatus {"
NSQ_SOURCE_LINE 00000777 "   my $self = shift;"
NSQ_SOURCE_LINE 00000778 "   return $self->{_realstatus};"
NSQ_SOURCE_LINE 00000779 "}"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "=head2 File::Rsync::err"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "    $aref = $obj->err;"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "In scalar context this method will return a reference to an array containing"
NSQ_SOURCE_LINE 00000786 "all output to stderr from the last I<exec> call, or zero (false) if there"
NSQ_SOURCE_LINE 00000787 "was no output."
NSQ_SOURCE_LINE 00000788 "In an array context it will return an array of all output to stderr or an"
NSQ_SOURCE_LINE 00000789 "empty list."
NSQ_SOURCE_LINE 00000790 "The scalar context can be used to efficiently test for the existance of output."
NSQ_SOURCE_LINE 00000791 "I<rsync> sends all messages from the remote I<rsync> process and any error"
NSQ_SOURCE_LINE 00000792 "messages to stderr."
NSQ_SOURCE_LINE 00000793 "This method's purpose is to make it easier for you to parse that output for"
NSQ_SOURCE_LINE 00000794 "appropriate information."
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "=cut"
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 "sub err {"
NSQ_SOURCE_LINE 00000799 "   my $self = shift;"
NSQ_SOURCE_LINE 00000800 "   if ($self->{_err}) {"
NSQ_SOURCE_LINE 00000801 "      return (wantarray ? @{$self->{_err}} : $self->{_err});"
NSQ_SOURCE_LINE 00000802 "   } else {"
NSQ_SOURCE_LINE 00000803 "      return;"
NSQ_SOURCE_LINE 00000804 "   }"
NSQ_SOURCE_LINE 00000805 "}"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "=head2 File::Rsync::out"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "    $aref = $obj->out;"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "Similar to the I<err> method, in a scalar context it returns a reference to an"
NSQ_SOURCE_LINE 00000812 "array containing all output to stdout from the last I<exec> call, or zero"
NSQ_SOURCE_LINE 00000813 "(false) if there was no output."
NSQ_SOURCE_LINE 00000814 "In an array context it returns an array of all output to stdout or an empty"
NSQ_SOURCE_LINE 00000815 "list."
NSQ_SOURCE_LINE 00000816 "I<rsync> sends all informational messages (B<verbose> option) from the local"
NSQ_SOURCE_LINE 00000817 "I<rsync> process to stdout."
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "=cut"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "sub out {"
NSQ_SOURCE_LINE 00000822 "   my $self = shift;"
NSQ_SOURCE_LINE 00000823 "   if ($self->{_out}) {"
NSQ_SOURCE_LINE 00000824 "      return (wantarray ? @{$self->{_out}} : $self->{_out});"
NSQ_SOURCE_LINE 00000825 "   } else {"
NSQ_SOURCE_LINE 00000826 "      return;"
NSQ_SOURCE_LINE 00000827 "   }"
NSQ_SOURCE_LINE 00000828 "}"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "=head2 File::Rsync::lastcmd"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "    $aref = $obj->lastcmd;"
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "Returns the actual system command used by the last I<exec> call, or '' before"
NSQ_SOURCE_LINE 00000835 "any calls to I<exec> for the object."
NSQ_SOURCE_LINE 00000836 "This can be useful in the case of an error condition to give a more"
NSQ_SOURCE_LINE 00000837 "informative message or for debugging purposes."
NSQ_SOURCE_LINE 00000838 "In an array context it return an array of args as passed to the system, in"
NSQ_SOURCE_LINE 00000839 "a scalar context it returns a space-seperated string."
NSQ_SOURCE_LINE 00000840 "See I<getcmd> for access to the command before execution."
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "=cut"
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "sub lastcmd {"
NSQ_SOURCE_LINE 00000845 "   my $self = shift;"
NSQ_SOURCE_LINE 00000846 "   if ($self->{_lastcmd}) {"
NSQ_SOURCE_LINE 00000847 "      return wantarray ? @{$self->{_lastcmd}} : join ' ',"
NSQ_SOURCE_LINE 00000848 "         @{$self->{_lastcmd}};"
NSQ_SOURCE_LINE 00000849 "   } else {"
NSQ_SOURCE_LINE 00000850 "      return;"
NSQ_SOURCE_LINE 00000851 "   }"
NSQ_SOURCE_LINE 00000852 "}"
NSQ_SOURCE_LINE 00000853 ""
