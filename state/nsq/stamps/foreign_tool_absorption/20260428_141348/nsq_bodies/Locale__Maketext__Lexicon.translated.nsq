NSQ_SOURCE_LINE 00000001 "package Locale::Maketext::Lexicon;"
NSQ_SOURCE_LINE 00000002 "$Locale::Maketext::Lexicon::VERSION = '1.00';"
NSQ_SOURCE_LINE 00000003 "use 5.004;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "# ABSTRACT: Use other catalog formats in Maketext"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our %Opts;"
NSQ_SOURCE_LINE 00000010 "sub option { shift if ref( $_[0] ); $Opts{ lc $_[0] } }"
NSQ_SOURCE_LINE 00000011 "sub set_option { shift if ref( $_[0] ); $Opts{ lc $_[0] } = $_[1] }"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "sub encoding {"
NSQ_SOURCE_LINE 00000014 "    my $encoding = option( @_, 'encoding' ) or return;"
NSQ_SOURCE_LINE 00000015 "    return $encoding unless lc($encoding) eq 'locale';"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "    local $^W;    # no warnings 'uninitialized', really."
NSQ_SOURCE_LINE 00000018 "    my ( $country_language, $locale_encoding );"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    local $@;"
NSQ_SOURCE_LINE 00000021 "    eval {"
NSQ_SOURCE_LINE 00000022 "        require I18N::Langinfo;"
NSQ_SOURCE_LINE 00000023 "        $locale_encoding"
NSQ_SOURCE_LINE 00000024 "            = I18N::Langinfo::langinfo( I18N::Langinfo::CODESET() );"
NSQ_SOURCE_LINE 00000025 "    } or eval {"
NSQ_SOURCE_LINE 00000026 "        require Win32::Console;"
NSQ_SOURCE_LINE 00000027 "        $locale_encoding = 'cp' . Win32::Console::OutputCP();"
NSQ_SOURCE_LINE 00000028 "    };"
NSQ_SOURCE_LINE 00000029 "    if ( !$locale_encoding ) {"
NSQ_SOURCE_LINE 00000030 "        foreach my $key (qw( LANGUAGE LC_ALL LC_MESSAGES LANG )) {"
NSQ_SOURCE_LINE 00000031 "            $ENV{$key} =~ /^([^.]+)\\.([^.:]+)/ or next;"
NSQ_SOURCE_LINE 00000032 "            ( $country_language, $locale_encoding ) = ( $1, $2 );"
NSQ_SOURCE_LINE 00000033 "            last;"
NSQ_SOURCE_LINE 00000034 "        }"
NSQ_SOURCE_LINE 00000035 "    }"
NSQ_SOURCE_LINE 00000036 "    if (   defined $locale_encoding"
NSQ_SOURCE_LINE 00000037 "        && lc($locale_encoding) eq 'euc'"
NSQ_SOURCE_LINE 00000038 "        && defined $country_language )"
NSQ_SOURCE_LINE 00000039 "    {"
NSQ_SOURCE_LINE 00000040 "        if ( $country_language =~ /^ja_JP|japan(?:ese)?$/i ) {"
NSQ_SOURCE_LINE 00000041 "            $locale_encoding = 'euc-jp';"
NSQ_SOURCE_LINE 00000042 "        }"
NSQ_SOURCE_LINE 00000043 "        elsif ( $country_language =~ /^ko_KR|korean?$/i ) {"
NSQ_SOURCE_LINE 00000044 "            $locale_encoding = 'euc-kr';"
NSQ_SOURCE_LINE 00000045 "        }"
NSQ_SOURCE_LINE 00000046 "        elsif ( $country_language =~ /^zh_CN|chin(?:a|ese)?$/i ) {"
NSQ_SOURCE_LINE 00000047 "            $locale_encoding = 'euc-cn';"
NSQ_SOURCE_LINE 00000048 "        }"
NSQ_SOURCE_LINE 00000049 "        elsif ( $country_language =~ /^zh_TW|taiwan(?:ese)?$/i ) {"
NSQ_SOURCE_LINE 00000050 "            $locale_encoding = 'euc-tw';"
NSQ_SOURCE_LINE 00000051 "        }"
NSQ_SOURCE_LINE 00000052 "    }"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    return $locale_encoding;"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "sub import {"
NSQ_SOURCE_LINE 00000058 "    my $class = shift;"
NSQ_SOURCE_LINE 00000059 "    return unless @_;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "    my %entries;"
NSQ_SOURCE_LINE 00000062 "    if ( UNIVERSAL::isa( $_[0], 'HASH' ) ) {"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "        # a hashref with $lang as keys, [$format, $src ...] as values"
NSQ_SOURCE_LINE 00000065 "        %entries = %{ $_[0] };"
NSQ_SOURCE_LINE 00000066 "    }"
NSQ_SOURCE_LINE 00000067 "    elsif ( @_ % 2 == 0 ) {"
NSQ_SOURCE_LINE 00000068 "        %entries = ( '' => [ splice @_, 0, 2 ], @_ );"
NSQ_SOURCE_LINE 00000069 "    }"
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "    # expand the wildcard entry"
NSQ_SOURCE_LINE 00000072 "    if ( my $wild_entry = delete $entries{'*'} ) {"
NSQ_SOURCE_LINE 00000073 "        while ( my ( $format, $src ) = splice( @$wild_entry, 0, 2 ) ) {"
NSQ_SOURCE_LINE 00000074 "            next if ref($src); # XXX: implement globbing for the 'Tie' backend"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "            my $pattern = quotemeta($src);"
NSQ_SOURCE_LINE 00000077 "            $pattern =~ s/\\\\\\*(?=[^*]+$)/\\([-\\\\w]+\\)/g or next;"
NSQ_SOURCE_LINE 00000078 "            $pattern =~ s/\\\\\\*/.*?/g;"
NSQ_SOURCE_LINE 00000079 "            $pattern =~ s/\\\\\\?/./g;"
NSQ_SOURCE_LINE 00000080 "            $pattern =~ s/\\\\\\[/[/g;"
NSQ_SOURCE_LINE 00000081 "            $pattern =~ s/\\\\\\]/]/g;"
NSQ_SOURCE_LINE 00000082 "            $pattern =~ s[\\\\\\{(.*?)\\\\\\\\}]["
NSQ_SOURCE_LINE 00000083 "                '(?:'.join('|', split(/,/, $1)).')'"
NSQ_SOURCE_LINE 00000084 "            ]eg;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "            require File::Glob;"
NSQ_SOURCE_LINE 00000087 "            foreach my $file ( File::Glob::bsd_glob($src) ) {"
NSQ_SOURCE_LINE 00000088 "                $file =~ /$pattern/ or next;"
NSQ_SOURCE_LINE 00000089 "                push @{ $entries{$1} }, ( $format => $file ) if $1;"
NSQ_SOURCE_LINE 00000090 "            }"
NSQ_SOURCE_LINE 00000091 "            delete $entries{$1}"
NSQ_SOURCE_LINE 00000092 "                unless !defined($1)"
NSQ_SOURCE_LINE 00000093 "                or exists $entries{$1} and @{ $entries{$1} };"
NSQ_SOURCE_LINE 00000094 "        }"
NSQ_SOURCE_LINE 00000095 "    }"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    %Opts = ();"
NSQ_SOURCE_LINE 00000098 "    foreach my $key ( grep /^_/, keys %entries ) {"
NSQ_SOURCE_LINE 00000099 "        set_option( lc( substr( $key, 1 ) ) => delete( $entries{$key} ) );"
NSQ_SOURCE_LINE 00000100 "    }"
NSQ_SOURCE_LINE 00000101 "    my $OptsRef = {%Opts};"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "    while ( my ( $lang, $entry ) = each %entries ) {"
NSQ_SOURCE_LINE 00000104 "        my $export = caller;"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "        if ( length $lang ) {"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "            # normalize language tag to Maketext's subclass convention"
NSQ_SOURCE_LINE 00000109 "            $lang = lc($lang);"
NSQ_SOURCE_LINE 00000110 "            $lang =~ s/-/_/g;"
NSQ_SOURCE_LINE 00000111 "            $export .= \"::$lang\";"
NSQ_SOURCE_LINE 00000112 "        }"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "        my @pairs = @{ $entry || [] } or die \"no format specified\";"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "        while ( my ( $format, $src ) = splice( @pairs, 0, 2 ) ) {"
NSQ_SOURCE_LINE 00000117 "            if ( defined($src) and !ref($src) and $src =~ /\\*/ ) {"
NSQ_SOURCE_LINE 00000118 "                unshift( @pairs, $format => $_ )"
NSQ_SOURCE_LINE 00000119 "                    for File::Glob::bsd_glob($src);"
NSQ_SOURCE_LINE 00000120 "                next;"
NSQ_SOURCE_LINE 00000121 "            }"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "            my @content"
NSQ_SOURCE_LINE 00000124 "                = eval { $class->lexicon_get( $src, scalar caller(1), $lang ); };"
NSQ_SOURCE_LINE 00000125 "            next if $@ and $@ =~ /^next\\b/;"
NSQ_SOURCE_LINE 00000126 "            die $@ if $@;"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000129 "            eval \"use $class\\::$format; 1\" or die $@;"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "            if ( %{\"$export\\::Lexicon\"} ) {"
NSQ_SOURCE_LINE 00000132 "                my $lexicon = \\%{\"$export\\::Lexicon\"};"
NSQ_SOURCE_LINE 00000133 "                if ( my $obj = tied %$lexicon ) {"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "                    # if it's our tied hash then force loading"
NSQ_SOURCE_LINE 00000136 "                    # otherwise late load will rewrite"
NSQ_SOURCE_LINE 00000137 "                    $obj->_force if $obj->isa(__PACKAGE__);"
NSQ_SOURCE_LINE 00000138 "                }"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "                # clear the memoized cache for old entries:"
NSQ_SOURCE_LINE 00000141 "                Locale::Maketext->clear_isa_scan;"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "                my $new = \"$class\\::$format\"->parse(@content);"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "                # avoid hash rebuild, on big sets"
NSQ_SOURCE_LINE 00000146 "                @{$lexicon}{ keys %$new } = values %$new;"
NSQ_SOURCE_LINE 00000147 "            }"
NSQ_SOURCE_LINE 00000148 "            else {"
NSQ_SOURCE_LINE 00000149 "                local $^W if $] >= 5.009;    # no warnings 'once', really."
NSQ_SOURCE_LINE 00000150 "                tie %{\"$export\\::Lexicon\"}, __PACKAGE__,"
NSQ_SOURCE_LINE 00000151 "                    {"
NSQ_SOURCE_LINE 00000152 "                    Opts    => $OptsRef,"
NSQ_SOURCE_LINE 00000153 "                    Export  => \"$export\\::Lexicon\","
NSQ_SOURCE_LINE 00000154 "                    Class   => \"$class\\::$format\","
NSQ_SOURCE_LINE 00000155 "                    Content => \\@content,"
NSQ_SOURCE_LINE 00000156 "                    };"
NSQ_SOURCE_LINE 00000157 "                tied( %{\"$export\\::Lexicon\"} )->_force"
NSQ_SOURCE_LINE 00000158 "                    if $OptsRef->{'preload'};"
NSQ_SOURCE_LINE 00000159 "            }"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "            length $lang or next;"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "            # Avoid re-entry"
NSQ_SOURCE_LINE 00000164 "            my $caller = caller();"
NSQ_SOURCE_LINE 00000165 "            next if $export->isa($caller);"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "            push( @{\"$export\\::ISA\"}, scalar caller );"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "            if ( my $style = option('style') ) {"
NSQ_SOURCE_LINE 00000170 "                my $cref"
NSQ_SOURCE_LINE 00000171 "                    = $class->can( lc(\"_style_$style\") )"
NSQ_SOURCE_LINE 00000172 "                    ->( $class, $export->can('maketext') )"
NSQ_SOURCE_LINE 00000173 "                    or die \"Unknown style: $style\";"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "                # Avoid redefinition warnings"
NSQ_SOURCE_LINE 00000176 "                local $SIG{__WARN__} = sub {1};"
NSQ_SOURCE_LINE 00000177 "                *{\"$export\\::maketext\"} = $cref;"
NSQ_SOURCE_LINE 00000178 "            }"
NSQ_SOURCE_LINE 00000179 "        }"
NSQ_SOURCE_LINE 00000180 "    }"
NSQ_SOURCE_LINE 00000181 "}"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "sub _style_gettext {"
NSQ_SOURCE_LINE 00000184 "    my ( $self, $orig ) = @_;"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "    require Locale::Maketext::Lexicon::Gettext;"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "    sub {"
NSQ_SOURCE_LINE 00000189 "        my $lh  = shift;"
NSQ_SOURCE_LINE 00000190 "        my $str = shift;"
NSQ_SOURCE_LINE 00000191 "        return $orig->("
NSQ_SOURCE_LINE 00000192 "            $lh,"
NSQ_SOURCE_LINE 00000193 "            Locale::Maketext::Lexicon::Gettext::_gettext_to_maketext($str), @_"
NSQ_SOURCE_LINE 00000194 "        );"
NSQ_SOURCE_LINE 00000195 "        }"
NSQ_SOURCE_LINE 00000196 "}"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "sub TIEHASH {"
NSQ_SOURCE_LINE 00000199 "    my ( $class, $args ) = @_;"
NSQ_SOURCE_LINE 00000200 "    return bless( $args, $class );"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "}"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "{"
NSQ_SOURCE_LINE 00000205 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "    sub _force {"
NSQ_SOURCE_LINE 00000208 "        my $args = shift;"
NSQ_SOURCE_LINE 00000209 "        unless ( $args->{'Done'} ) {"
NSQ_SOURCE_LINE 00000210 "            $args->{'Done'} = 1;"
NSQ_SOURCE_LINE 00000211 "            local *Opts = $args->{Opts};"
NSQ_SOURCE_LINE 00000212 "            *{ $args->{Export} }"
NSQ_SOURCE_LINE 00000213 "                = $args->{Class}->parse( @{ $args->{Content} } );"
NSQ_SOURCE_LINE 00000214 "            $args->{'Export'}{'_AUTO'} = 1"
NSQ_SOURCE_LINE 00000215 "                if option('auto');"
NSQ_SOURCE_LINE 00000216 "        }"
NSQ_SOURCE_LINE 00000217 "        return $args->{'Export'};"
NSQ_SOURCE_LINE 00000218 "    }"
NSQ_SOURCE_LINE 00000219 "    sub FETCH   { _force( $_[0] )->{ $_[1] } }"
NSQ_SOURCE_LINE 00000220 "    sub EXISTS  { _force( $_[0] )->{ $_[1] } }"
NSQ_SOURCE_LINE 00000221 "    sub DELETE  { delete _force( $_[0] )->{ $_[1] } }"
NSQ_SOURCE_LINE 00000222 "    sub SCALAR  { scalar %{ _force( $_[0] ) } }"
NSQ_SOURCE_LINE 00000223 "    sub STORE   { _force( $_[0] )->{ $_[1] } = $_[2] }"
NSQ_SOURCE_LINE 00000224 "    sub CLEAR   { %{ _force( $_[0] )->{ $_[1] } } = () }"
NSQ_SOURCE_LINE 00000225 "    sub NEXTKEY { each %{ _force( $_[0] ) } }"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    sub FIRSTKEY {"
NSQ_SOURCE_LINE 00000228 "        my $hash = _force( $_[0] );"
NSQ_SOURCE_LINE 00000229 "        my $a    = scalar keys %$hash;"
NSQ_SOURCE_LINE 00000230 "        each %$hash;"
NSQ_SOURCE_LINE 00000231 "    }"
NSQ_SOURCE_LINE 00000232 "}"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "sub lexicon_get {"
NSQ_SOURCE_LINE 00000235 "    my ( $class, $src, $caller, $lang ) = @_;"
NSQ_SOURCE_LINE 00000236 "    return unless defined $src;"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "    foreach my $type ( qw(ARRAY HASH SCALAR GLOB), ref($src) ) {"
NSQ_SOURCE_LINE 00000239 "        next unless UNIVERSAL::isa( $src, $type );"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "        my $method = 'lexicon_get_' . lc($type);"
NSQ_SOURCE_LINE 00000242 "        die \"cannot handle source $type for $src: no $method defined\""
NSQ_SOURCE_LINE 00000243 "            unless $class->can($method);"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "        return $class->$method( $src, $caller, $lang );"
NSQ_SOURCE_LINE 00000246 "    }"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "    # default handler"
NSQ_SOURCE_LINE 00000249 "    return $class->lexicon_get_( $src, $caller, $lang );"
NSQ_SOURCE_LINE 00000250 "}"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "# for scalarrefs and arrayrefs we just dereference the $src"
NSQ_SOURCE_LINE 00000253 "sub lexicon_get_scalar { ${ $_[1] } }"
NSQ_SOURCE_LINE 00000254 "sub lexicon_get_array  { @{ $_[1] } }"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "sub lexicon_get_hash {"
NSQ_SOURCE_LINE 00000257 "    my ( $class, $src, $caller, $lang ) = @_;"
NSQ_SOURCE_LINE 00000258 "    return map { $_ => $src->{$_} } sort keys %$src;"
NSQ_SOURCE_LINE 00000259 "}"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "sub lexicon_get_glob {"
NSQ_SOURCE_LINE 00000262 "    my ( $class, $src, $caller, $lang ) = @_;"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000265 "    local $^W if $] >= 5.009;    # no warnings 'once', really."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "    # be extra magical and check for DATA section"
NSQ_SOURCE_LINE 00000268 "    if ( eof($src) and $src eq \\*{\"$caller\\::DATA\"}"
NSQ_SOURCE_LINE 00000269 "        or $src eq \\*{\"main\\::DATA\"} )"
NSQ_SOURCE_LINE 00000270 "    {"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "        # okay, the *DATA isn't initiated yet. let's read."
NSQ_SOURCE_LINE 00000273 "        #"
NSQ_SOURCE_LINE 00000274 "        require FileHandle;"
NSQ_SOURCE_LINE 00000275 "        my $fh = FileHandle->new;"
NSQ_SOURCE_LINE 00000276 "        my $package = ( ( $src eq \\*{\"main\\::DATA\"} ) ? 'main' : $caller );"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "        if ( $package eq 'main' and -e $0 ) {"
NSQ_SOURCE_LINE 00000279 "            $fh->open($0) or die \"Can't open $0: $!\";"
NSQ_SOURCE_LINE 00000280 "        }"
NSQ_SOURCE_LINE 00000281 "        else {"
NSQ_SOURCE_LINE 00000282 "            my $level = 1;"
NSQ_SOURCE_LINE 00000283 "            while ( my ( $pkg, $filename ) = caller( $level++ ) ) {"
NSQ_SOURCE_LINE 00000284 "                next unless $pkg eq $package;"
NSQ_SOURCE_LINE 00000285 "                next unless -e $filename;"
NSQ_SOURCE_LINE 00000286 "                next;"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "                $fh->open($filename) or die \"Can't open $filename: $!\";"
NSQ_SOURCE_LINE 00000289 "                last;"
NSQ_SOURCE_LINE 00000290 "            }"
NSQ_SOURCE_LINE 00000291 "        }"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "        while (<$fh>) {"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "            # okay, this isn't foolproof, but good enough"
NSQ_SOURCE_LINE 00000296 "            last if /^__DATA__$/;"
NSQ_SOURCE_LINE 00000297 "        }"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "        return <$fh>;"
NSQ_SOURCE_LINE 00000300 "    }"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "    # fh containing the lines"
NSQ_SOURCE_LINE 00000303 "    my $pos   = tell($src);"
NSQ_SOURCE_LINE 00000304 "    my @lines = <$src>;"
NSQ_SOURCE_LINE 00000305 "    seek( $src, $pos, 0 );"
NSQ_SOURCE_LINE 00000306 "    return @lines;"
NSQ_SOURCE_LINE 00000307 "}"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "# assume filename - search path, open and return its contents"
NSQ_SOURCE_LINE 00000310 "sub lexicon_get_ {"
NSQ_SOURCE_LINE 00000311 "    my ( $class, $src, $caller, $lang ) = @_;"
NSQ_SOURCE_LINE 00000312 "    $src = $class->lexicon_find( $src, $caller, $lang );"
NSQ_SOURCE_LINE 00000313 "    defined $src or die 'next';"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "    require FileHandle;"
NSQ_SOURCE_LINE 00000316 "    my $fh = FileHandle->new;"
NSQ_SOURCE_LINE 00000317 "    $fh->open($src) or die \"Cannot read $src (called by $caller): $!\";"
NSQ_SOURCE_LINE 00000318 "    binmode($fh);"
NSQ_SOURCE_LINE 00000319 "    return <$fh>;"
NSQ_SOURCE_LINE 00000320 "}"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "sub lexicon_find {"
NSQ_SOURCE_LINE 00000323 "    my ( $class, $src, $caller, $lang ) = @_;"
NSQ_SOURCE_LINE 00000324 "    return $src if -e $src;"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "    require File::Spec;"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "    my @path = split '::', $caller;"
NSQ_SOURCE_LINE 00000329 "    push @path, $lang if length $lang;"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "    while (@path) {"
NSQ_SOURCE_LINE 00000332 "        foreach (@INC) {"
NSQ_SOURCE_LINE 00000333 "            my $file = File::Spec->catfile( $_, @path, $src );"
NSQ_SOURCE_LINE 00000334 "            return $file if -e $file;"
NSQ_SOURCE_LINE 00000335 "        }"
NSQ_SOURCE_LINE 00000336 "        pop @path;"
NSQ_SOURCE_LINE 00000337 "    }"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "    return undef;"
NSQ_SOURCE_LINE 00000340 "}"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "1;"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "__END__"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "=pod"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "=head1 NAME"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "Locale::Maketext::Lexicon - Use other catalog formats in Maketext"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=head1 VERSION"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "version 1.00"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "As part of a localization class, automatically glob for available"
NSQ_SOURCE_LINE 00000361 "lexicons:"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "    package Hello::I18N;"
NSQ_SOURCE_LINE 00000364 "    use base 'Locale::Maketext';"
NSQ_SOURCE_LINE 00000365 "    use Locale::Maketext::Lexicon {"
NSQ_SOURCE_LINE 00000366 "        '*' => [Gettext => '/usr/local/share/locale/*/LC_MESSAGES/hello.mo'],"
NSQ_SOURCE_LINE 00000367 "        ### Uncomment to fallback when a key is missing from lexicons"
NSQ_SOURCE_LINE 00000368 "        # _auto   => 1,"
NSQ_SOURCE_LINE 00000369 "        ### Uncomment to decode lexicon entries into Unicode strings"
NSQ_SOURCE_LINE 00000370 "        # _decode => 1,"
NSQ_SOURCE_LINE 00000371 "        ### Uncomment to load and parse everything right away"
NSQ_SOURCE_LINE 00000372 "        # _preload => 1,"
NSQ_SOURCE_LINE 00000373 "        ### Uncomment to use %1 / %quant(%1) instead of [_1] / [quant, _1]"
NSQ_SOURCE_LINE 00000374 "        # _style  => 'gettext',"
NSQ_SOURCE_LINE 00000375 "    };"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "Explicitly specify languages, during compile- or run-time:"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "    package Hello::I18N;"
NSQ_SOURCE_LINE 00000380 "    use base 'Locale::Maketext';"
NSQ_SOURCE_LINE 00000381 "    use Locale::Maketext::Lexicon {"
NSQ_SOURCE_LINE 00000382 "        de => [Gettext => 'hello_de.po'],"
NSQ_SOURCE_LINE 00000383 "        fr => ["
NSQ_SOURCE_LINE 00000384 "            Gettext => 'hello_fr.po',"
NSQ_SOURCE_LINE 00000385 "            Gettext => 'local/hello/fr.po',"
NSQ_SOURCE_LINE 00000386 "        ],"
NSQ_SOURCE_LINE 00000387 "    };"
NSQ_SOURCE_LINE 00000388 "    # ... incrementally add new lexicons"
NSQ_SOURCE_LINE 00000389 "    Locale::Maketext::Lexicon->import({"
NSQ_SOURCE_LINE 00000390 "        de => [Gettext => 'local/hello/de.po'],"
NSQ_SOURCE_LINE 00000391 "    })"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "Alternatively, as part of a localization subclass:"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "    package Hello::I18N::de;"
NSQ_SOURCE_LINE 00000396 "    use base 'Hello::I18N';"
NSQ_SOURCE_LINE 00000397 "    use Locale::Maketext::Lexicon (Gettext => \\*DATA);"
NSQ_SOURCE_LINE 00000398 "    __DATA__"
NSQ_SOURCE_LINE 00000399 "    # Some sample data"
NSQ_SOURCE_LINE 00000400 "    msgid \"\""
NSQ_SOURCE_LINE 00000401 "    msgstr \"\""
NSQ_SOURCE_LINE 00000402 "    \"Project-Id-Version: Hello 1.3.22.1\\n\""
NSQ_SOURCE_LINE 00000403 "    \"MIME-Version: 1.0\\n\""
NSQ_SOURCE_LINE 00000404 "    \"Content-Type: text/plain; charset=iso8859-1\\n\""
NSQ_SOURCE_LINE 00000405 "    \"Content-Transfer-Encoding: 8bit\\n\""
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "    #: Hello.pm:10"
NSQ_SOURCE_LINE 00000408 "    msgid \"Hello, World!\""
NSQ_SOURCE_LINE 00000409 "    msgstr \"Hallo, Welt!\""
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "    #: Hello.pm:11"
NSQ_SOURCE_LINE 00000412 "    msgid \"You have %quant(%1,piece) of mail.\""
NSQ_SOURCE_LINE 00000413 "    msgstr \"Sie haben %quant(%1,Poststueck,Poststuecken).\""
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "This module provides lexicon-handling modules to read from other"
NSQ_SOURCE_LINE 00000418 "localization formats, such as I<Gettext>, I<Msgcat>, and so on."
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "If you are unfamiliar with the concept of lexicon modules, please"
NSQ_SOURCE_LINE 00000421 "consult L<Locale::Maketext> and the C<webl10n> HTML files in the C<docs/>"
NSQ_SOURCE_LINE 00000422 "directory of this module."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "A command-line utility L<xgettext.pl> is also installed with this"
NSQ_SOURCE_LINE 00000425 "module, for extracting translatable strings from source files."
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "=head2 The C<import> function"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "The C<import()> function accepts two forms of arguments:"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "=over 4"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=item (I<format> => I<source> ... )"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "This form takes any number of argument pairs (usually one);"
NSQ_SOURCE_LINE 00000436 "I<source> may be a file name, a filehandle, or an array reference."
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "For each such pair, it pass the contents specified by the second"
NSQ_SOURCE_LINE 00000439 "argument to B<Locale::Maketext::Lexicon::I<format>>->parse as a"
NSQ_SOURCE_LINE 00000440 "plain list, and export its return value as the C<%Lexicon> hash"
NSQ_SOURCE_LINE 00000441 "in the calling package."
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "In the case that there are multiple such pairs, the lexicon"
NSQ_SOURCE_LINE 00000444 "defined by latter ones overrides earlier ones."
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "=item { I<language> => [ I<format>, I<source> ... ] ... }"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "This form accepts a hash reference.  It will export a C<%Lexicon>"
NSQ_SOURCE_LINE 00000449 "into the subclasses specified by each I<language>, using the process"
NSQ_SOURCE_LINE 00000450 "described above.  It is designed to alleviate the need to set up a"
NSQ_SOURCE_LINE 00000451 "separate subclass for each localized language, and just use the catalog"
NSQ_SOURCE_LINE 00000452 "files."
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "This module will convert the I<language> arguments into lowercase,"
NSQ_SOURCE_LINE 00000455 "and replace all C<-> with C<_>, so C<zh_TW> and C<zh-tw> will both"
NSQ_SOURCE_LINE 00000456 "map to the C<zh_tw> subclass."
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "If I<language> begins with C<_>, it is taken as an option that"
NSQ_SOURCE_LINE 00000459 "controls how lexicons are parsed.  See L</Options> for a list"
NSQ_SOURCE_LINE 00000460 "of available options."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "The C<*> is a special I<language>; it must be used in conjunction"
NSQ_SOURCE_LINE 00000463 "with a filename that also contains C<*>; all matched files with"
NSQ_SOURCE_LINE 00000464 "a valid language code in the place of C<*> will be automatically"
NSQ_SOURCE_LINE 00000465 "prepared as a lexicon subclass.  If there is multiple C<*> in"
NSQ_SOURCE_LINE 00000466 "the filename, the last one is used as the language name."
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "=back"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "=head2 Options"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=over 4"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=item C<_auto>"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "If set to a true value, missing lookups on lexicons are handled"
NSQ_SOURCE_LINE 00000477 "silently, as if an C<Auto> lexicon has been appended on all"
NSQ_SOURCE_LINE 00000478 "language lexicons."
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "=item C<_decode>"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "If set to a true value, source entries will be converted into"
NSQ_SOURCE_LINE 00000483 "utf8-strings (available in Perl 5.6.1 or later).  This feature"
NSQ_SOURCE_LINE 00000484 "needs the B<Encode> or B<Encode::compat> module."
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "Currently, only the C<Gettext> backend supports this option."
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "=item C<_encoding>"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "This option only has effect when C<_decode> is set to true."
NSQ_SOURCE_LINE 00000491 "It specifies an encoding to store lexicon entries, instead of"
NSQ_SOURCE_LINE 00000492 "utf8-strings."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "If C<_encoding> is set to C<locale>, the encoding from the"
NSQ_SOURCE_LINE 00000495 "current locale setting is used."
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "=item C<_preload>"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "By default parsing is delayed until first use of the lexicon,"
NSQ_SOURCE_LINE 00000500 "set this option to true value to parse it asap. Increment"
NSQ_SOURCE_LINE 00000501 "adding lexicons forces parsing."
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "=back"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=head2 Subclassing format handlers"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "If you wish to override how sources specified in different data types"
NSQ_SOURCE_LINE 00000508 "are handled, please use a subclass that overrides C<lexicon_get_I<TYPE>>."
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "XXX: not documented well enough yet.  Patches welcome."
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "=head1 VERSION"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "This document describes version 0.91 of Locale::Maketext::Lexicon."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "=head1 NOTES"
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "When you attempt to localize an entry missing in the lexicon, Maketext"
NSQ_SOURCE_LINE 00000519 "will throw an exception by default.  To inhibit this behaviour, override"
NSQ_SOURCE_LINE 00000520 "the C<_AUTO> key in your language subclasses, for example:"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "    $Hello::I18N::en::Lexicon{_AUTO} = 1; # autocreate missing keys"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "If you want to implement a new C<Lexicon::*> backend module, please note"
NSQ_SOURCE_LINE 00000525 "that C<parse()> takes an array containing the B<source strings> from the"
NSQ_SOURCE_LINE 00000526 "specified filehandle or filename, which are I<not> C<chomp>ed.  Although"
NSQ_SOURCE_LINE 00000527 "if the source is an array reference, its elements will probably not contain"
NSQ_SOURCE_LINE 00000528 "any newline characters anyway."
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "The C<parse()> function should return a hash reference, which will be"
NSQ_SOURCE_LINE 00000531 "assigned to the I<typeglob> (C<*Lexicon>) of the language module.  All"
NSQ_SOURCE_LINE 00000532 "it amounts to is that if the returned reference points to a tied hash,"
NSQ_SOURCE_LINE 00000533 "the C<%Lexicon> will be aliased to the same tied hash if it was not"
NSQ_SOURCE_LINE 00000534 "initialized previously."
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "=head1 ACKNOWLEDGMENTS"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "Thanks to Jesse Vincent for suggesting this module to be written."
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "Thanks also to Sean M. Burke for coming up with B<Locale::Maketext>"
NSQ_SOURCE_LINE 00000541 "in the first place, and encouraging me to experiment with alternative"
NSQ_SOURCE_LINE 00000542 "Lexicon syntaxes."
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "Thanks also to Yi Ma Mao for providing the MO file parsing subroutine,"
NSQ_SOURCE_LINE 00000545 "as well as inspiring me to implement file globbing and transcoding"
NSQ_SOURCE_LINE 00000546 "support."
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "See the F<AUTHORS> file in the distribution for a list of people who"
NSQ_SOURCE_LINE 00000549 "have sent helpful patches, ideas or comments."
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "L<xgettext.pl> for extracting translatable strings from common template"
NSQ_SOURCE_LINE 00000554 "systems and perl source files."
