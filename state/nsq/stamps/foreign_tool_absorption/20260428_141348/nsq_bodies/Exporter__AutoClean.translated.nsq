NSQ_SOURCE_LINE 00000001 "package Exporter::AutoClean;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "use B::Hooks::EndOfScope;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.01';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "sub export {"
NSQ_SOURCE_LINE 00000009 "    my $class   = shift;"
NSQ_SOURCE_LINE 00000010 "    my $pkg     = shift;"
NSQ_SOURCE_LINE 00000011 "    my %exports = @_;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000014 "    while (my ($name, $code) = each %exports) {"
NSQ_SOURCE_LINE 00000015 "        *{\"${pkg}::${name}\"} = $code;"
NSQ_SOURCE_LINE 00000016 "    }"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "    on_scope_end {"
NSQ_SOURCE_LINE 00000019 "        for my $name (keys %exports) {"
NSQ_SOURCE_LINE 00000020 "            delete ${ $pkg . '::' }{ $name };"
NSQ_SOURCE_LINE 00000021 "        }"
NSQ_SOURCE_LINE 00000022 "    };"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "1;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "__END__"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "=head1 NAME"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "Exporter::AutoClean - export instant functions available at compile time only"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "    use Exporter::AutoClean;"
NSQ_SOURCE_LINE 00000036 "    "
NSQ_SOURCE_LINE 00000037 "    sub import {"
NSQ_SOURCE_LINE 00000038 "        my $caller = caller;"
NSQ_SOURCE_LINE 00000039 "        Exporter::AutoClean->export( $caller, sub_name => sub { # code... } );"
NSQ_SOURCE_LINE 00000040 "    }"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "This is a simple wrapper module of L<B::Hooks::EndOfScope>, allows you to export instant functions that is only available at compile time."
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "L<B::Hooks::EndOfScope>, L<namespace::autoclean>."
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "=head1 METHOD"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=head2 Exporter::AutoClean->export( $package, %export_functions );"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    Exporter::AutoClean->export("
NSQ_SOURCE_LINE 00000055 "        $caller,"
NSQ_SOURCE_LINE 00000056 "        function_name1 => sub { # code },"
NSQ_SOURCE_LINE 00000057 "        function_name2 => \\&code,"
NSQ_SOURCE_LINE 00000058 "        :"
NSQ_SOURCE_LINE 00000059 "    );"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "Export instant functions described C<%export_functions> to C<$package>."
NSQ_SOURCE_LINE 00000062 "These functions are automatically removed when compile time is done."
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "Daisuke Murase <typester@cpan.org>"
