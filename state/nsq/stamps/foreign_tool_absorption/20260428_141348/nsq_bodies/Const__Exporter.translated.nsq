BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Const::Exporter;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "# ABSTRACT: Declare constants for export."
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use v5.14;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = 'v1.3.0';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Carp;"
NSQ_SOURCE_LINE 00000011 "use Const::Fast;"
NSQ_SOURCE_LINE 00000012 "use Exporter 5.57 ();"
NSQ_SOURCE_LINE 00000013 "use List::Util 1.56 qw/ pairs mesh /;"
NSQ_SOURCE_LINE 00000014 "use Package::Stash;"
NSQ_SOURCE_LINE 00000015 "use Ref::Util qw/ is_blessed_ref is_arrayref is_coderef is_hashref is_ref /;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "# RECOMMEND PREREQ: List::SomeUtils::XS"
NSQ_SOURCE_LINE 00000018 "# RECOMMEND PREREQ: Package::Stash::XS"
NSQ_SOURCE_LINE 00000019 "# RECOMMEND PREREQ: Ref::Util::XS"
NSQ_SOURCE_LINE 00000020 "# RECOMMEND PREREQ: Storable 3.05"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub import {"
NSQ_SOURCE_LINE 00000023 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    strict->import;"
NSQ_SOURCE_LINE 00000026 "    warnings->import;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    my $caller = caller;"
NSQ_SOURCE_LINE 00000029 "    my $stash  = Package::Stash->new($caller);"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    # Create @EXPORT, @EXPORT_OK, %EXPORT_TAGS and import if they"
NSQ_SOURCE_LINE 00000032 "    # don't yet exist."
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    my $export = $stash->get_or_add_symbol('@EXPORT');"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    my $export_ok = $stash->get_or_add_symbol('@EXPORT_OK');"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    my $export_tags = $stash->get_or_add_symbol('%EXPORT_TAGS');"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "    $stash->add_symbol( '&import', \\&Exporter::import )"
NSQ_SOURCE_LINE 00000041 "      unless ( $stash->has_symbol('&import') );"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    $stash->add_symbol( '&const', \\&Const::Fast::const );"
NSQ_SOURCE_LINE 00000044 "    _export_symbol( $stash, 'const' );"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "    foreach my $set ( pairs @_ ) {"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "        my $tag = $set->key;"
NSQ_SOURCE_LINE 00000049 "        croak \"'${tag}' is reserved\" if $tag eq 'all';"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "        my $defs = $set->value;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "        croak \"An array reference required for tag '${tag}'\""
NSQ_SOURCE_LINE 00000054 "          unless is_arrayref($defs);"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "        while ( my $item = shift @{$defs} ) {"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "            for ($item) {"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "                # Array reference means a list of enumerated symbols"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "                if ( is_arrayref($_) ) {"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "                    my @enums = @{$item};"
NSQ_SOURCE_LINE 00000065 "                    my $start = shift @{$defs};"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "                    my @values = is_arrayref($start) ? @{$start} : ($start);"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "                    my $last = $values[0] // 0;"
NSQ_SOURCE_LINE 00000070 "                    my $fn = sub { $_[0] + 1 };"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "                    if ( is_coderef $values[1] ) {"
NSQ_SOURCE_LINE 00000073 "                        $fn = $values[1];"
NSQ_SOURCE_LINE 00000074 "                        $values[1] = undef;"
NSQ_SOURCE_LINE 00000075 "                    }"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "                    foreach my $pair ( pairs mesh \\@enums, \\@values ) {"
NSQ_SOURCE_LINE 00000078 "                        my $value = $pair->value // $fn->($last);"
NSQ_SOURCE_LINE 00000079 "                        $last = $value;"
NSQ_SOURCE_LINE 00000080 "                        my $symbol = $pair->key // next;"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "                        _add_symbol( $stash, $symbol, $value );"
NSQ_SOURCE_LINE 00000083 "                        _export_symbol( $stash, $symbol, $tag );"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "                    }"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "                    next;"
NSQ_SOURCE_LINE 00000088 "                }"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "                # A scalar is a name of a symbol"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "                if ( !is_ref($_) ) {"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "                    my $symbol = $item;"
NSQ_SOURCE_LINE 00000095 "                    my $sigil  = _get_sigil($symbol);"
NSQ_SOURCE_LINE 00000096 "                    my $norm ="
NSQ_SOURCE_LINE 00000097 "                      ( $sigil eq '&' ) ? ( $sigil . $symbol ) : $symbol;"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "                    # If the symbol is already defined, that we add it"
NSQ_SOURCE_LINE 00000100 "                    # to the exports for that tag and assume no value"
NSQ_SOURCE_LINE 00000101 "                    # is given for it."
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "                    if ( $stash->has_symbol($norm) ) {"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "                        my $ref = $stash->get_symbol($norm);"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "                        # In case symbol is defined as `our`"
NSQ_SOURCE_LINE 00000108 "                        # beforehand, ensure it is readonly."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "                        Const::Fast::_make_readonly( $ref => 1 );"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "                        _export_symbol( $stash, $symbol, $tag );"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "                        next;"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "                    }"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "                    my $value = shift @{$defs};"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "                    _add_symbol( $stash, $symbol, $value );"
NSQ_SOURCE_LINE 00000121 "                    _export_symbol( $stash, $symbol, $tag );"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "                    next;"
NSQ_SOURCE_LINE 00000124 "                }"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "                croak \"$_ is not supported\";"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "            }"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "        }"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    }"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "    # Now ensure @EXPORT, @EXPORT_OK and %EXPORT_TAGS contain unique"
NSQ_SOURCE_LINE 00000135 "    # symbols. This may not matter to Exporter, but we want to ensure"
NSQ_SOURCE_LINE 00000136 "    # the values are 'clean'. It also simplifies testing."
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "    push @{$export}, @{ $export_tags->{default} } if $export_tags->{default};"
NSQ_SOURCE_LINE 00000139 "    _uniq($export);"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    _uniq($export_ok);"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    $export_tags->{all} //= [];"
NSQ_SOURCE_LINE 00000144 "    push @{ $export_tags->{all} }, @{$export_ok};"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    _uniq( $export_tags->{$_} ) for keys %{$export_tags};"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "# Add a symbol to the stash"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "sub _check_sigil_against_value {"
NSQ_SOURCE_LINE 00000153 "    my ($sigil, $value) = @_;"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "    return 1 if $sigil eq '@' && is_arrayref($value);"
NSQ_SOURCE_LINE 00000156 "    return 1 if $sigil eq '%' && is_hashref($value);"
NSQ_SOURCE_LINE 00000157 "    return 1 if $sigil eq '&' && is_coderef($value);"
NSQ_SOURCE_LINE 00000158 "    return 1 if $sigil eq '$';"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "    return 0;"
NSQ_SOURCE_LINE 00000161 "}"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "sub _add_symbol {"
NSQ_SOURCE_LINE 00000164 "    my ( $stash, $symbol, $value ) = @_;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "    my $sigil = _get_sigil($symbol);"
NSQ_SOURCE_LINE 00000167 "    if ( $sigil ne '&' ) {"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "        if ( is_blessed_ref $value) {"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "            $stash->add_symbol( $symbol, \\$value );"
NSQ_SOURCE_LINE 00000172 "            Const::Fast::_make_readonly( $stash->get_symbol($symbol) => 1 );"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "        }"
NSQ_SOURCE_LINE 00000175 "        else {"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "            croak \"Invalid type for $symbol\""
NSQ_SOURCE_LINE 00000178 "                unless _check_sigil_against_value($sigil, $value);"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "            $stash->add_symbol( $symbol, $value );"
NSQ_SOURCE_LINE 00000181 "            Const::Fast::_make_readonly( $stash->get_symbol($symbol) => 1 );"
NSQ_SOURCE_LINE 00000182 "        }"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "    }"
NSQ_SOURCE_LINE 00000185 "    else {"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "        const my $copy => is_coderef($value) ? $value->() : $value;"
NSQ_SOURCE_LINE 00000188 "        $stash->add_symbol( '&' . $symbol, sub() { $copy } );"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    }"
NSQ_SOURCE_LINE 00000191 "}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "# Add a symbol to @EXPORT_OK and %EXPORT_TAGS"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "sub _export_symbol {"
NSQ_SOURCE_LINE 00000196 "    my ( $stash, $symbol, $tag ) = @_;"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "    my $export_ok   = $stash->get_symbol('@EXPORT_OK');"
NSQ_SOURCE_LINE 00000199 "    my $export_tags = $stash->get_symbol('%EXPORT_TAGS');"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "    $tag //= 'all';"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    $export_tags->{$tag} //= [];"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "    push @{ $export_tags->{$tag} }, $symbol;"
NSQ_SOURCE_LINE 00000206 "    push @{$export_ok}, $symbol;"
NSQ_SOURCE_LINE 00000207 "}"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "# Function to get the sigil from a symbol. If no sigil, it assumes"
NSQ_SOURCE_LINE 00000210 "# that it is a function reference."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "sub _get_sigil {"
NSQ_SOURCE_LINE 00000213 "    my ($symbol) = @_;"
NSQ_SOURCE_LINE 00000214 "    my ($sigil) = $symbol =~ /^(\\W)/;"
NSQ_SOURCE_LINE 00000215 "    return $sigil // '&';"
NSQ_SOURCE_LINE 00000216 "}"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "# Function to take a list reference and prune duplicate elements from"
NSQ_SOURCE_LINE 00000219 "# it."
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "sub _uniq {"
NSQ_SOURCE_LINE 00000222 "    my ($listref) = @_;"
NSQ_SOURCE_LINE 00000223 "    my %seen;"
NSQ_SOURCE_LINE 00000224 "    while ( my $item = shift @{$listref} ) {"
NSQ_SOURCE_LINE 00000225 "        $seen{$item} = 1;"
NSQ_SOURCE_LINE 00000226 "    }"
NSQ_SOURCE_LINE 00000227 "    push @{$listref}, keys %seen;"
NSQ_SOURCE_LINE 00000228 "}"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "1;"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "__END__"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=pod"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head1 NAME"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "Const::Exporter - Declare constants for export."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head1 VERSION"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "version v1.3.0"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "Define a constants module:"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "  package MyApp::Constants;"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "  our $zoo => 1234;"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "     tag_a => [                  # use MyApp::Constants /:tag_a/;"
NSQ_SOURCE_LINE 00000257 "        'foo'  => 1,             # exports \"foo\""
NSQ_SOURCE_LINE 00000258 "        '$bar' => 2,             # exports \"$bar\""
NSQ_SOURCE_LINE 00000259 "        '@baz' => [qw/ a b c /], # exports \"@baz\""
NSQ_SOURCE_LINE 00000260 "        '%bo'  => { a => 1 },    # exports \"%bo\""
NSQ_SOURCE_LINE 00000261 "     ],"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "     tag_b => [                  # use MyApp::Constants /:tag_b/;"
NSQ_SOURCE_LINE 00000264 "        'foo',                   # exports \"foo\" (same as from \":tag_a\")"
NSQ_SOURCE_LINE 00000265 "        '$zoo',                  # exports \"$zoo\" (as defined above)"
NSQ_SOURCE_LINE 00000266 "     ];"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "  # `use Const::Exporter` can be specified multiple times"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "     tag_b => [                 # we can add symbols to \":tab_b\""
NSQ_SOURCE_LINE 00000273 "        'moo' => $bar,          # exports \"moo\" (same value as \"$bar\")"
NSQ_SOURCE_LINE 00000274 "     ],"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "     enums => ["
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "       [qw/ goo gab gub /] => 0, # exports enumerated symbols, from 0..2"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "     ],"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "     default => [qw/ foo $bar /]; # exported by default"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "and use that module:"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "  package MyApp;"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "  use MyApp::Constants qw/ $zoo :tag_a /;"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "  ..."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "=head2 Dynamically Creating Constants"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "You may also import a predefined hash of constants for exporting dynamically:"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 " use Const::Exporter;"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 " my %myconstants = ("
NSQ_SOURCE_LINE 00000299 "        'foo'  => 1,"
NSQ_SOURCE_LINE 00000300 "        '$bar' => 2,"
NSQ_SOURCE_LINE 00000301 "        '@baz' => [qw/ a b c /],"
NSQ_SOURCE_LINE 00000302 "        '%bo'  => { a => 1 },"
NSQ_SOURCE_LINE 00000303 " );"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 " # ... do stuff"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 " Const::Exporter->import("
NSQ_SOURCE_LINE 00000308 "      constants => [%myconstants],        # define constants for exporting"
NSQ_SOURCE_LINE 00000309 "      default   => [ keys %myconstants ], # export everything in %myconstants by default"
NSQ_SOURCE_LINE 00000310 " );"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "This module allows you to declare constants that can be exported to"
NSQ_SOURCE_LINE 00000315 "other modules."
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=for readme stop"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "To declare constants, simply group then into export tags:"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "  package MyApp::Constants;"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "    tag_a => ["
NSQ_SOURCE_LINE 00000326 "       'foo' => 1,"
NSQ_SOURCE_LINE 00000327 "       'bar' => 2,"
NSQ_SOURCE_LINE 00000328 "    ],"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "    tag_b => ["
NSQ_SOURCE_LINE 00000331 "       'baz' => 3,"
NSQ_SOURCE_LINE 00000332 "       'bar',"
NSQ_SOURCE_LINE 00000333 "    ],"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "    default => ["
NSQ_SOURCE_LINE 00000336 "       'foo',"
NSQ_SOURCE_LINE 00000337 "    ];"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "Constants in the C<default> tag are exported by default (that is, they"
NSQ_SOURCE_LINE 00000340 "are added to the C<@EXPORTS> array)."
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "When a constant is already defined in a previous tag, then no value is"
NSQ_SOURCE_LINE 00000343 "specified for it. (For example, C<bar> in C<tab_b> above.)  If you do"
NSQ_SOURCE_LINE 00000344 "give a value, L<Const::Exporter> will assume it's another symbol."
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "Your module can include multiple calls to C<use Const::Exporter>, so"
NSQ_SOURCE_LINE 00000347 "that you can reference constants in other expressions, e.g."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "    tag => ["
NSQ_SOURCE_LINE 00000352 "        '$zero' => 0,"
NSQ_SOURCE_LINE 00000353 "    ];"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "    tag => ["
NSQ_SOURCE_LINE 00000358 "        '$one' => 1 + $zero,"
NSQ_SOURCE_LINE 00000359 "    ];"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "or even something more complex:"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "     http_ports => ["
NSQ_SOURCE_LINE 00000366 "        'HTTP'     => 80,"
NSQ_SOURCE_LINE 00000367 "        'HTTP_ALT' => 8080,"
NSQ_SOURCE_LINE 00000368 "        'HTTPS'    => 443,"
NSQ_SOURCE_LINE 00000369 "     ];"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "     http_ports => ["
NSQ_SOURCE_LINE 00000374 "        '@HTTP_PORTS' => [ HTTP, HTTP_ALT, HTTPS ],"
NSQ_SOURCE_LINE 00000375 "     ];"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "Constants can include traditional L<constant> symbols, as well as"
NSQ_SOURCE_LINE 00000378 "scalars, arrays or hashes."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "Constants can include values defined elsewhere in the code, e.g."
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "  our $foo;"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "  BEGIN {"
NSQ_SOURCE_LINE 00000385 "     $foo = calculate_value_for_constant();"
NSQ_SOURCE_LINE 00000386 "  }"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "    tag => [ '$foo' ];"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "Note that this will make the symbol read-only. You don't need to"
NSQ_SOURCE_LINE 00000393 "explicitly declare it as such."
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "Enumerated constants are also supported:"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "    tag => ["
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "      [qw/ foo bar baz /] => 1,"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "    ];"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "will define the symbols C<foo> (1), C<bar> (2) and C<baz> (3)."
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "You can also specify a list of numbers, if you want to skip values:"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "    tag => ["
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "      [qw/ foo bar baz /] => [1, 4],"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "    ];"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "will define the symbols C<foo> (1), C<bar> (4) and C<baz> (5)."
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "You can even specify string values:"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "    tag => ["
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "      [qw/ foo bar baz /] => [qw/ feh meh neh /],"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "    ];"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "however, this is equivalent to"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "    tag => ["
NSQ_SOURCE_LINE 00000434 "      'foo' => 'feh',"
NSQ_SOURCE_LINE 00000435 "      'bar' => 'meh',"
NSQ_SOURCE_LINE 00000436 "      'baz' => 'neh',"
NSQ_SOURCE_LINE 00000437 "    ];"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "Objects are also supported,"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "   use Const::Exporter"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "    tag => ["
NSQ_SOURCE_LINE 00000444 "      '$foo' => Something->new( 123 ),"
NSQ_SOURCE_LINE 00000445 "    ];"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "=head2 Export Tags"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "By default, all symbols are exportable (in C<@EXPORT_OK>.)"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "The C<:default> tag is the same as not specifying any exports."
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "The C<:all> tag exports all symbols."
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=head1 KNOWN ISSUES"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "=head2 Support for older Perl versions"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "This module requires Perl v5.14 or newer."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "Pull requests to support older versions of Perl are welcome. See"
NSQ_SOURCE_LINE 00000462 "L</SOURCE>."
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "=head2 Exporting Functions"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "L<Const::Exporter> is not intended for use with modules that also"
NSQ_SOURCE_LINE 00000467 "export functions."
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "There are workarounds that you can use, such as getting"
NSQ_SOURCE_LINE 00000470 "L<Const::Exporter> to export your functions, or munging C<@EXPORT>"
NSQ_SOURCE_LINE 00000471 "etc. separately, but these are not supported and changes in the"
NSQ_SOURCE_LINE 00000472 "future my break our code."
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=head2 Mixing POD with Tags"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "The following code is a syntax error, at least with some versions of"
NSQ_SOURCE_LINE 00000477 "Perl:"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "  =head2 a"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "  =cut"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "    a => [ foo => 1 ],"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "  =head2 b"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "  =cut"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "    b => [ bar => 2 ];"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "If you want to mix POD with your declarations, use multiple use lines,"
NSQ_SOURCE_LINE 00000494 "e.g."
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "  =head2 a"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "  =cut"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000501 "    a => [ foo => 1 ];"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "  =head2 b"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "  =cut"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "  use Const::Exporter"
NSQ_SOURCE_LINE 00000508 "    b => [ bar => 2 ];"
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "=for readme continue"
NSQ_SOURCE_LINE 00000511 ""
NSQ_SOURCE_LINE 00000512 "=head1 SUPPORT FOR OLDER PERL VERSIONS"
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "This module requires Perl v5.10.1 or later."
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "Future releases may only support Perl versions released in the last ten years."
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "See L<Exporter> for a discussion of export tags."
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "=head2 Similar Modules"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "=over"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "=item L<Exporter::Constants>"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "This module only allows you to declare function symbol constants, akin"
NSQ_SOURCE_LINE 00000529 "to the L<constant> module, without tags."
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "=item L<Constant::Exporter>"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "This module only allows you to declare function symbol constants, akin"
NSQ_SOURCE_LINE 00000534 "to the L<constant> module, although you can specify tags."
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "=item L<Constant::Export::Lazy>"
NSQ_SOURCE_LINE 00000537 ""
NSQ_SOURCE_LINE 00000538 "This module only allows you to declare function symbol constants, akin"
NSQ_SOURCE_LINE 00000539 "to the L<constant> module by defining functions that are only called"
NSQ_SOURCE_LINE 00000540 "as needed.  The interface is rather complex."
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "=item L<Const::Fast::Exporter>"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "This module will export all constants declared in the package's"
NSQ_SOURCE_LINE 00000545 "namespace."
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 "=back"
NSQ_SOURCE_LINE 00000548 ""
NSQ_SOURCE_LINE 00000549 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "The development version is on github at L<https://github.com/robrwo/Const-Exporter>"
NSQ_SOURCE_LINE 00000552 "and may be cloned from L<git://github.com/robrwo/Const-Exporter.git>"
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "=head1 BUGS"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "Please report any bugs or feature requests on the bugtracker website"
