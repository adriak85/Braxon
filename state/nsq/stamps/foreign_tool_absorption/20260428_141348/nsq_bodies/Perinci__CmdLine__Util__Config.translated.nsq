NSQ_SOURCE_LINE 00000001 "package Perinci::CmdLine::Util::Config;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Log::ger;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000011 "our $DATE = '2025-11-15'; # DATE"
NSQ_SOURCE_LINE 00000012 "our $DIST = 'Perinci-CmdLine-Util-Config'; # DIST"
NSQ_SOURCE_LINE 00000013 "our $VERSION = '1.727'; # VERSION"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our @EXPORT_OK = ("
NSQ_SOURCE_LINE 00000016 "    'get_default_config_dirs',"
NSQ_SOURCE_LINE 00000017 "    'read_config',"
NSQ_SOURCE_LINE 00000018 "    'get_args_from_config',"
NSQ_SOURCE_LINE 00000019 ");"
