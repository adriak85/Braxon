NSQ_SOURCE_LINE 00000023 "# from PERLANCAR::File::HomeDir 0.03, with minor modification"
NSQ_SOURCE_LINE 00000024 "sub _get_my_home_dir {"
NSQ_SOURCE_LINE 00000025 "    if ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000026 "        # File::HomeDir always uses exists($ENV{x}) first, does it want to avoid"
NSQ_SOURCE_LINE 00000027 "        # accidentally creating env vars?"
NSQ_SOURCE_LINE 00000028 "        return $ENV{HOME} if $ENV{HOME};"
NSQ_SOURCE_LINE 00000029 "        return $ENV{USERPROFILE} if $ENV{USERPROFILE};"
NSQ_SOURCE_LINE 00000030 "        return join($ENV{HOMEDRIVE}, \"\\\\\", $ENV{HOMEPATH})"
NSQ_SOURCE_LINE 00000031 "            if $ENV{HOMEDRIVE} && $ENV{HOMEPATH};"
NSQ_SOURCE_LINE 00000032 "    } else {"
NSQ_SOURCE_LINE 00000033 "        return $ENV{HOME} if $ENV{HOME};"
NSQ_SOURCE_LINE 00000034 "        my @pw;"
NSQ_SOURCE_LINE 00000035 "        eval { @pw = getpwuid($>) };"
NSQ_SOURCE_LINE 00000036 "        return $pw[7] if @pw;"
NSQ_SOURCE_LINE 00000037 "    }"
NSQ_SOURCE_LINE 00000038 "    die \"Can't get home directory\";"
NSQ_SOURCE_LINE 00000039 "}"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "$SPEC{get_default_config_dirs} = {"
NSQ_SOURCE_LINE 00000042 "    v => 1.1,"
NSQ_SOURCE_LINE 00000043 "    args => {},"
NSQ_SOURCE_LINE 00000044 "};"
NSQ_SOURCE_LINE 00000045 "sub get_default_config_dirs {"
NSQ_SOURCE_LINE 00000046 "    my @dirs;"
NSQ_SOURCE_LINE 00000047 "    #local $PERLANCAR::File::HomeDir::DIE_ON_FAILURE = 1;"
NSQ_SOURCE_LINE 00000048 "    my $home = _get_my_home_dir();"
NSQ_SOURCE_LINE 00000049 "    if ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000050 "        push @dirs, $home;"
NSQ_SOURCE_LINE 00000051 "    } else {"
NSQ_SOURCE_LINE 00000052 "        push @dirs, \"$home/.config\", $home, \"/etc\";"
NSQ_SOURCE_LINE 00000053 "    }"
NSQ_SOURCE_LINE 00000054 "    \\@dirs;"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "$SPEC{read_config} = {"
NSQ_SOURCE_LINE 00000058 "    v => 1.1,"
NSQ_SOURCE_LINE 00000059 "    args => {"
NSQ_SOURCE_LINE 00000060 "        config_paths    => {},"
NSQ_SOURCE_LINE 00000061 "        config_filename => {},"
NSQ_SOURCE_LINE 00000062 "        config_dirs     => {},"
NSQ_SOURCE_LINE 00000063 "        program_name    => {},"
NSQ_SOURCE_LINE 00000064 "        # TODO: hook_file"
NSQ_SOURCE_LINE 00000065 "        hook_section    => {},"
NSQ_SOURCE_LINE 00000066 "        # TODO: hook_param?"
NSQ_SOURCE_LINE 00000067 "    },"
NSQ_SOURCE_LINE 00000068 "};"
NSQ_SOURCE_LINE 00000069 "sub read_config {"
NSQ_SOURCE_LINE 00000070 "    require Config::IOD::Reader;"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "    my %args = @_;"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    my $config_dirs = $args{config_dirs} // get_default_config_dirs();"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "    my $paths;"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "    my @filenames;"
NSQ_SOURCE_LINE 00000079 "    my %section_config_filename_map;"
NSQ_SOURCE_LINE 00000080 "    if (my $names = $args{config_filename}) {"
NSQ_SOURCE_LINE 00000081 "        for my $name (ref($names) eq 'ARRAY' ? @$names : ($names)) {"
NSQ_SOURCE_LINE 00000082 "            if (ref($name) eq 'HASH') {"
NSQ_SOURCE_LINE 00000083 "                $section_config_filename_map{$name->{filename}} = $name->{section};"
NSQ_SOURCE_LINE 00000084 "                push @filenames, $name->{filename};"
NSQ_SOURCE_LINE 00000085 "            } else {"
NSQ_SOURCE_LINE 00000086 "                $section_config_filename_map{$name} = 'GLOBAL';"
NSQ_SOURCE_LINE 00000087 "                push @filenames, $name;"
NSQ_SOURCE_LINE 00000088 "            }"
NSQ_SOURCE_LINE 00000089 "        }"
NSQ_SOURCE_LINE 00000090 "    }"
NSQ_SOURCE_LINE 00000091 "    unless (@filenames) {"
NSQ_SOURCE_LINE 00000092 "        @filenames = (($args{program_name} // \"prog\") . \".conf\");"
NSQ_SOURCE_LINE 00000093 "    }"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    if ($args{config_paths}) {"
NSQ_SOURCE_LINE 00000096 "        $paths = $args{config_paths};"
NSQ_SOURCE_LINE 00000097 "    } else {"
NSQ_SOURCE_LINE 00000098 "        for my $dir (@$config_dirs) {"
NSQ_SOURCE_LINE 00000099 "            for my $name (@filenames) {"
NSQ_SOURCE_LINE 00000100 "                my $path = \"$dir/\" . $name;"
NSQ_SOURCE_LINE 00000101 "                push @$paths, $path if -e $path;"
NSQ_SOURCE_LINE 00000102 "            }"
NSQ_SOURCE_LINE 00000103 "        }"
NSQ_SOURCE_LINE 00000104 "    }"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    my $reader = Config::IOD::Reader->new("
NSQ_SOURCE_LINE 00000107 "        warn_perl => 1,"
NSQ_SOURCE_LINE 00000108 "    );"
NSQ_SOURCE_LINE 00000109 "    my %res;"
NSQ_SOURCE_LINE 00000110 "    my @read;"
NSQ_SOURCE_LINE 00000111 "    my %section_read_order;"
NSQ_SOURCE_LINE 00000112 "  FILE:"
NSQ_SOURCE_LINE 00000113 "    for my $i (0..$#{$paths}) {"
NSQ_SOURCE_LINE 00000114 "        my $path           = $paths->[$i];"
NSQ_SOURCE_LINE 00000115 "        my $filename = $path; $filename =~ s!.*[/\\\\]!!;"
NSQ_SOURCE_LINE 00000116 "        my $wanted_section = $section_config_filename_map{$filename};"
NSQ_SOURCE_LINE 00000117 "        log_trace \"[pericmd] Reading config file '%s' ...\", $path;"
NSQ_SOURCE_LINE 00000118 "        my $j = 0;"
NSQ_SOURCE_LINE 00000119 "        $section_read_order{GLOBAL} = [$i, $j++];"
NSQ_SOURCE_LINE 00000120 "        my @file_sections = (\"GLOBAL\");"
NSQ_SOURCE_LINE 00000121 "        my $hoh = $reader->read_file("
NSQ_SOURCE_LINE 00000122 "            $path,"
NSQ_SOURCE_LINE 00000123 "            sub {"
NSQ_SOURCE_LINE 00000124 "                my %args = @_;"
NSQ_SOURCE_LINE 00000125 "                return unless $args{event} eq 'section';"
NSQ_SOURCE_LINE 00000126 "                my $section = $args{section};"
NSQ_SOURCE_LINE 00000127 "                push @file_sections, $section"
NSQ_SOURCE_LINE 00000128 "                    unless grep {$section eq $_} @file_sections;"
NSQ_SOURCE_LINE 00000129 "                $section_read_order{$section} = [$i, $j++];"
NSQ_SOURCE_LINE 00000130 "            },"
NSQ_SOURCE_LINE 00000131 "        );"
NSQ_SOURCE_LINE 00000132 "        push @read, $path;"
NSQ_SOURCE_LINE 00000133 "      SECTION:"
NSQ_SOURCE_LINE 00000134 "        for my $section (@file_sections) {"
NSQ_SOURCE_LINE 00000135 "            $res{$section} //= {};"
NSQ_SOURCE_LINE 00000136 "            my $hash = $hoh->{$section};"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "            my $s = $section; $s =~ s/\\s*\\S*=.*\\z//; # strip key=value pairs"
NSQ_SOURCE_LINE 00000139 "            $s = 'GLOBAL' if $s eq '';"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "            if ($args{hook_section}) {"
NSQ_SOURCE_LINE 00000142 "                my $res = $args{hook_section}->($section, $hash);"
NSQ_SOURCE_LINE 00000143 "                if ($res->[0] == 204) {"
NSQ_SOURCE_LINE 00000144 "                    log_trace \"[pericmd] Skipped config section '$section' \"."
NSQ_SOURCE_LINE 00000145 "                        \"in file '$path': hook_section returns 204\";"
NSQ_SOURCE_LINE 00000146 "                    next SECTION;"
NSQ_SOURCE_LINE 00000147 "                } elsif ($res->[0] >= 400 && $res->[0] <= 599) {"
NSQ_SOURCE_LINE 00000148 "                    return [$res->[0], \"Error when reading config file '$path'\"."
NSQ_SOURCE_LINE 00000149 "                                \": $res->[1]\"];"
NSQ_SOURCE_LINE 00000150 "                }"
NSQ_SOURCE_LINE 00000151 "            }"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "            # 2025-11-15 - i forgot why i skip filling out config for other"
NSQ_SOURCE_LINE 00000154 "            # sections is it performance? now i fill out all sections for"
NSQ_SOURCE_LINE 00000155 "            # programs that want to read the section contents without having to"
NSQ_SOURCE_LINE 00000156 "            # re-read configuration file all over again by itself."
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "            # next unless !defined($wanted_section) || $s eq $wanted_section;"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "            for (keys %$hash) {"
NSQ_SOURCE_LINE 00000161 "                $res{$section}{$_} = $hash->{$_};"
NSQ_SOURCE_LINE 00000162 "            }"
NSQ_SOURCE_LINE 00000163 "        }"
NSQ_SOURCE_LINE 00000164 "    }"
NSQ_SOURCE_LINE 00000165 "    [200, \"OK\", \\%res, {"
NSQ_SOURCE_LINE 00000166 "        'func.read_files' => \\@read,"
NSQ_SOURCE_LINE 00000167 "        'func.section_read_order' => \\%section_read_order,"
NSQ_SOURCE_LINE 00000168 "    }];"
NSQ_SOURCE_LINE 00000169 "}"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "$SPEC{get_args_from_config} = {"
NSQ_SOURCE_LINE 00000172 "    v => 1.1,"
NSQ_SOURCE_LINE 00000173 "    description => <<'_',"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "`config` is a HoH (hashes of hashrefs) produced by reading an INI (IOD)"
NSQ_SOURCE_LINE 00000176 "configuration file using modules like <pm:Config::IOD::Reader>."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "Hashref argument `args` will be set by parameters in `config`, while `plugins`"
NSQ_SOURCE_LINE 00000179 "will be set by parameters in `[plugin=...]` sections in `config`. For example,"
NSQ_SOURCE_LINE 00000180 "with this configuration:"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    arg1=val1"
NSQ_SOURCE_LINE 00000183 "    arg2=val2"
NSQ_SOURCE_LINE 00000184 "    -special_arg1=val3"
NSQ_SOURCE_LINE 00000185 "    -special_arg2=val4"
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "    [plugin=DumpArgs]"
NSQ_SOURCE_LINE 00000188 "    -event=before_validation"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    [plugin=Foo]"
NSQ_SOURCE_LINE 00000191 "    arg1=val1"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "`args` will become:"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    {"
NSQ_SOURCE_LINE 00000196 "      arg1=>\"val1\","
NSQ_SOURCE_LINE 00000197 "      arg2=>\"val2\","
NSQ_SOURCE_LINE 00000198 "      -special_arg1=>\"val3\","
NSQ_SOURCE_LINE 00000199 "      -special_arg2=>\"val4\","
NSQ_SOURCE_LINE 00000200 "    }"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "and `plugins` will become:"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "    ["
NSQ_SOURCE_LINE 00000205 "      'DumpArgs@before_validation' => {},"
NSQ_SOURCE_LINE 00000206 "      Foo => {arg1=>val},"
NSQ_SOURCE_LINE 00000207 "    ]"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "_"
NSQ_SOURCE_LINE 00000210 "    args => {"
NSQ_SOURCE_LINE 00000211 "        r => {},"
NSQ_SOURCE_LINE 00000212 "        config => {},"
NSQ_SOURCE_LINE 00000213 "        args => {schema=>'hash'},"
NSQ_SOURCE_LINE 00000214 "        plugins => {schema=>'array'},"
NSQ_SOURCE_LINE 00000215 "        subcommand_name => {},"
NSQ_SOURCE_LINE 00000216 "        config_profile => {},"
NSQ_SOURCE_LINE 00000217 "        common_opts => {},"
NSQ_SOURCE_LINE 00000218 "        meta => {},"
NSQ_SOURCE_LINE 00000219 "        meta_is_normalized => {},"
NSQ_SOURCE_LINE 00000220 "    },"
NSQ_SOURCE_LINE 00000221 "};"
NSQ_SOURCE_LINE 00000222 "sub get_args_from_config {"
NSQ_SOURCE_LINE 00000223 "    my %fargs = @_;"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "    my $r       = $fargs{r};"
NSQ_SOURCE_LINE 00000226 "    my $conf    = $fargs{config};"
NSQ_SOURCE_LINE 00000227 "    my $progn   = $fargs{program_name};"
NSQ_SOURCE_LINE 00000228 "    my $scn     = $fargs{subcommand_name} // '';"
NSQ_SOURCE_LINE 00000229 "    my $profile = $fargs{config_profile};"
NSQ_SOURCE_LINE 00000230 "    my $args    = $fargs{args} // {};"
NSQ_SOURCE_LINE 00000231 "    my $plugins = $fargs{plugins} // [];"
NSQ_SOURCE_LINE 00000232 "    my $copts   = $fargs{common_opts};"
NSQ_SOURCE_LINE 00000233 "    my $meta    = $fargs{meta};"
NSQ_SOURCE_LINE 00000234 "    my $found;"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "    unless ($fargs{meta_is_normalized}) {"
NSQ_SOURCE_LINE 00000237 "        require Perinci::Sub::Normalize;"
NSQ_SOURCE_LINE 00000238 "        $meta = Perinci::Sub::Normalize::normalize_function_metadata($meta);"
NSQ_SOURCE_LINE 00000239 "    }"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "    my $csro = $r->{_config_section_read_order} // {};"
NSQ_SOURCE_LINE 00000242 "    my @sections = sort {"
NSQ_SOURCE_LINE 00000243 "        # sort according to the order the section is seen in the file"
NSQ_SOURCE_LINE 00000244 "        my $csro_a = $csro->{$a} // [0,0];"
NSQ_SOURCE_LINE 00000245 "        my $csro_b = $csro->{$b} // [0,0];"
NSQ_SOURCE_LINE 00000246 "        $csro_a->[0] <=> $csro_b->[0] ||"
NSQ_SOURCE_LINE 00000247 "            $csro_a->[1] <=> $csro_b->[1] ||"
NSQ_SOURCE_LINE 00000248 "            $a cmp $b"
NSQ_SOURCE_LINE 00000249 "        } keys %$conf;"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "    my %seen_profiles; # for debugging message"
NSQ_SOURCE_LINE 00000252 "    for my $section0 (@sections) {"
NSQ_SOURCE_LINE 00000253 "        my %keyvals;"
NSQ_SOURCE_LINE 00000254 "        my $sect_name;"
NSQ_SOURCE_LINE 00000255 "        for my $word (split /\\s+/, $section0) {"
NSQ_SOURCE_LINE 00000256 "            if ($word =~ /(.*?)=(.*)/) {"
NSQ_SOURCE_LINE 00000257 "                $keyvals{$1} = $2;"
NSQ_SOURCE_LINE 00000258 "            } else {"
NSQ_SOURCE_LINE 00000259 "                $sect_name //= $word;"
NSQ_SOURCE_LINE 00000260 "            }"
NSQ_SOURCE_LINE 00000261 "        }"
NSQ_SOURCE_LINE 00000262 "        $seen_profiles{$keyvals{profile}}++ if defined $keyvals{profile};"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "        my $sect_scn     = $keyvals{subcommand} // '';"
NSQ_SOURCE_LINE 00000265 "        my $sect_profile = $keyvals{profile};"
NSQ_SOURCE_LINE 00000266 "        my $sect_plugin  = $keyvals{plugin};"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "        # if there is a subcommand name, use section with no subcommand=... or"
NSQ_SOURCE_LINE 00000269 "        # the matching subcommand"
NSQ_SOURCE_LINE 00000270 "        if (length $scn) {"
NSQ_SOURCE_LINE 00000271 "            if (length($sect_scn) && $sect_scn ne $scn) {"
NSQ_SOURCE_LINE 00000272 "                log_trace("
NSQ_SOURCE_LINE 00000273 "                    \"[pericmd] Skipped config section '%s' (%s)\","
NSQ_SOURCE_LINE 00000274 "                    $section0, \"subcommand does not match '$scn'\","
NSQ_SOURCE_LINE 00000275 "                );"
NSQ_SOURCE_LINE 00000276 "                next;"
NSQ_SOURCE_LINE 00000277 "            }"
NSQ_SOURCE_LINE 00000278 "        } else {"
NSQ_SOURCE_LINE 00000279 "            if (length $sect_scn) {"
NSQ_SOURCE_LINE 00000280 "                log_trace("
NSQ_SOURCE_LINE 00000281 "                    \"[pericmd] Skipped config section '%s' (%s)\","
NSQ_SOURCE_LINE 00000282 "                    $section0, \"only for a certain subcommand\","
NSQ_SOURCE_LINE 00000283 "                );"
NSQ_SOURCE_LINE 00000284 "                next;"
NSQ_SOURCE_LINE 00000285 "            }"
NSQ_SOURCE_LINE 00000286 "        }"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "        # if user chooses a profile, only use section with no profile=... or the"
NSQ_SOURCE_LINE 00000289 "        # matching profile"
NSQ_SOURCE_LINE 00000290 "        if (defined $profile) {"
NSQ_SOURCE_LINE 00000291 "            if (defined($sect_profile) && $sect_profile ne $profile) {"
NSQ_SOURCE_LINE 00000292 "                log_trace("
NSQ_SOURCE_LINE 00000293 "                    \"[pericmd] Skipped config section '%s' (%s)\","
NSQ_SOURCE_LINE 00000294 "                    $section0, \"profile does not match '$profile'\","
NSQ_SOURCE_LINE 00000295 "                );"
NSQ_SOURCE_LINE 00000296 "                next;"
NSQ_SOURCE_LINE 00000297 "            }"
NSQ_SOURCE_LINE 00000298 "            $found = 1 if defined($sect_profile) && $sect_profile eq $profile;"
NSQ_SOURCE_LINE 00000299 "        } else {"
NSQ_SOURCE_LINE 00000300 "            if (defined($sect_profile)) {"
NSQ_SOURCE_LINE 00000301 "                log_trace("
NSQ_SOURCE_LINE 00000302 "                    \"[pericmd] Skipped config section '%s' (%s)\","
NSQ_SOURCE_LINE 00000303 "                    $section0, \"only for a certain profile\","
NSQ_SOURCE_LINE 00000304 "                );"
NSQ_SOURCE_LINE 00000305 "                next;"
NSQ_SOURCE_LINE 00000306 "            }"
NSQ_SOURCE_LINE 00000307 "        }"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "        # only use section marked with program=... if the program name matches"
NSQ_SOURCE_LINE 00000310 "        if (defined($progn) && defined($keyvals{program})) {"
NSQ_SOURCE_LINE 00000311 "            if ($progn ne $keyvals{program}) {"
NSQ_SOURCE_LINE 00000312 "                log_trace("
NSQ_SOURCE_LINE 00000313 "                    \"[pericmd] Skipped config section '%s' (%s)\","
NSQ_SOURCE_LINE 00000314 "                    $section0, \"program does not match '$progn'\","
NSQ_SOURCE_LINE 00000315 "                );"
NSQ_SOURCE_LINE 00000316 "                next;"
NSQ_SOURCE_LINE 00000317 "            }"
NSQ_SOURCE_LINE 00000318 "        }"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "        # if user specifies env=... then apply filtering by ENV variable"
NSQ_SOURCE_LINE 00000321 "        if (defined(my $env = $keyvals{env})) {"
NSQ_SOURCE_LINE 00000322 "            my ($var, $val);"
NSQ_SOURCE_LINE 00000323 "            if (($var, $val) = $env =~ /\\A(\\w+)=(.*)\\z/) {"
NSQ_SOURCE_LINE 00000324 "                if (($ENV{$var} // '') ne $val) {"
NSQ_SOURCE_LINE 00000325 "                    log_trace("
NSQ_SOURCE_LINE 00000326 "                        \"[pericmd] Skipped config section '%s' (%s)\","
NSQ_SOURCE_LINE 00000327 "                        $section0, \"env $var has non-matching value '\"."
NSQ_SOURCE_LINE 00000328 "                            ($ENV{$var} // '').\"'\","
NSQ_SOURCE_LINE 00000329 "                    );"
NSQ_SOURCE_LINE 00000330 "                    next;"
NSQ_SOURCE_LINE 00000331 "                }"
NSQ_SOURCE_LINE 00000332 "            } elsif (($var, $val) = $env =~ /\\A(\\w+)!=(.*)\\z/) {"
NSQ_SOURCE_LINE 00000333 "                if (($ENV{$var} // '') eq $val) {"
NSQ_SOURCE_LINE 00000334 "                    log_trace("
NSQ_SOURCE_LINE 00000335 "                        \"[pericmd] Skipped config section '%s' (%s)\","
NSQ_SOURCE_LINE 00000336 "                        $section0, \"env $var has that value\","
NSQ_SOURCE_LINE 00000337 "                    );"
NSQ_SOURCE_LINE 00000338 "                    next;"
NSQ_SOURCE_LINE 00000339 "                }"
NSQ_SOURCE_LINE 00000340 "            } elsif (($var, $val) = $env =~ /\\A(\\w+)\\*=(.*)\\z/) {"
NSQ_SOURCE_LINE 00000341 "                if (index(($ENV{$var} // ''), $val) < 0) {"
NSQ_SOURCE_LINE 00000342 "                    log_trace("
NSQ_SOURCE_LINE 00000343 "                        \"[pericmd] Skipped config section '%s' (%s)\","
NSQ_SOURCE_LINE 00000344 "                        $section0, \"env $var has value '\"."
NSQ_SOURCE_LINE 00000345 "                            ($ENV{$var} // '').\"' which does not contain the \"."
NSQ_SOURCE_LINE 00000346 "                                \"requested string\""
NSQ_SOURCE_LINE 00000347 "                    );"
NSQ_SOURCE_LINE 00000348 "                    next;"
NSQ_SOURCE_LINE 00000349 "                }"
NSQ_SOURCE_LINE 00000350 "            } else {"
NSQ_SOURCE_LINE 00000351 "                if (!$ENV{$env}) {"
NSQ_SOURCE_LINE 00000352 "                    log_trace("
NSQ_SOURCE_LINE 00000353 "                        \"[pericmd] Skipped config section '%s' (%s)\","
NSQ_SOURCE_LINE 00000354 "                        $section0, \"env $env is not set/true\","
NSQ_SOURCE_LINE 00000355 "                    );"
NSQ_SOURCE_LINE 00000356 "                    next;"
NSQ_SOURCE_LINE 00000357 "                }"
NSQ_SOURCE_LINE 00000358 "            }"
NSQ_SOURCE_LINE 00000359 "        }"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "        log_trace(\"[pericmd] Reading config section '%s'\", $section0);"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "        if (defined $sect_plugin) {"
NSQ_SOURCE_LINE 00000364 "            # TODO: check against metadata in plugin"
NSQ_SOURCE_LINE 00000365 "            my $event;"
NSQ_SOURCE_LINE 00000366 "            my $prio;"
NSQ_SOURCE_LINE 00000367 "            my $plugin_args = {};"
NSQ_SOURCE_LINE 00000368 "            for my $k (keys %{ $conf->{$section0} }) {"
NSQ_SOURCE_LINE 00000369 "                my $v = $conf->{$section0}{$k};"
NSQ_SOURCE_LINE 00000370 "                if    ($k eq '-event') { $event = $v }"
NSQ_SOURCE_LINE 00000371 "                elsif ($k eq '-prio')  { $prio  = $v }"
NSQ_SOURCE_LINE 00000372 "                else { $plugin_args->{$k} = $v }"
NSQ_SOURCE_LINE 00000373 "            }"
NSQ_SOURCE_LINE 00000374 "            push @$plugins, $sect_plugin ."
NSQ_SOURCE_LINE 00000375 "                (defined $event || defined $prio ?"
NSQ_SOURCE_LINE 00000376 "                 '@'.($event // '') . (defined $prio ? \"\\@$prio\" : \"\") : '');"
NSQ_SOURCE_LINE 00000377 "            push @$plugins, $plugin_args;"
NSQ_SOURCE_LINE 00000378 "        } else {"
NSQ_SOURCE_LINE 00000379 "            my $as = $meta->{args} // {};"
NSQ_SOURCE_LINE 00000380 "            for my $k (keys %{ $conf->{$section0} }) {"
NSQ_SOURCE_LINE 00000381 "                my $v = $conf->{$section0}{$k};"
NSQ_SOURCE_LINE 00000382 "                if ($copts->{$k} && $copts->{$k}{is_settable_via_config}) {"
NSQ_SOURCE_LINE 00000383 "                    my $sch = $copts->{$k}{schema};"
NSQ_SOURCE_LINE 00000384 "                    if ($sch) {"
NSQ_SOURCE_LINE 00000385 "                        require Data::Sah::Resolve;"
NSQ_SOURCE_LINE 00000386 "                        my $res = Data::Sah::Resolve::resolve_schema($sch);"
NSQ_SOURCE_LINE 00000387 "                        # since IOD might return a scalar or an array (depending on"
NSQ_SOURCE_LINE 00000388 "                        # whether there is a single param=val or multiple param="
NSQ_SOURCE_LINE 00000389 "                        # lines), we need to arrayify the value if the argument is"
NSQ_SOURCE_LINE 00000390 "                        # expected to be an array."
NSQ_SOURCE_LINE 00000391 "                        if (ref($v) ne 'ARRAY' && $res->{type} eq 'array') {"
NSQ_SOURCE_LINE 00000392 "                            $v = [$v];"
NSQ_SOURCE_LINE 00000393 "                        }"
NSQ_SOURCE_LINE 00000394 "                    }"
NSQ_SOURCE_LINE 00000395 "                    $copts->{$k}{handler}->(undef, $v, $r);"
NSQ_SOURCE_LINE 00000396 "                } else {"
NSQ_SOURCE_LINE 00000397 "                    # when common option clashes with function argument name,"
NSQ_SOURCE_LINE 00000398 "                    # user can use NAME.arg to refer to function argument."
NSQ_SOURCE_LINE 00000399 "                    $k =~ s/\\.arg\\z//;"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "                    # since IOD might return a scalar or an array (depending on"
NSQ_SOURCE_LINE 00000402 "                    # whether there is a single param=val or multiple param="
NSQ_SOURCE_LINE 00000403 "                    # lines), we need to arrayify the value if the argument is"
NSQ_SOURCE_LINE 00000404 "                    # expected to be an array."
NSQ_SOURCE_LINE 00000405 "                    if (ref($v) ne 'ARRAY' && $as->{$k} && $as->{$k}{schema}) {"
NSQ_SOURCE_LINE 00000406 "                        require Data::Sah::Resolve;"
NSQ_SOURCE_LINE 00000407 "                        my $res = Data::Sah::Resolve::resolve_schema($as->{$k}{schema});"
NSQ_SOURCE_LINE 00000408 "                        if ($res->{type} eq 'array') {"
NSQ_SOURCE_LINE 00000409 "                            $v = [$v];"
NSQ_SOURCE_LINE 00000410 "                        }"
NSQ_SOURCE_LINE 00000411 "                    }"
NSQ_SOURCE_LINE 00000412 "                    $args->{$k} = $v;"
NSQ_SOURCE_LINE 00000413 "                }"
NSQ_SOURCE_LINE 00000414 "            } # for params in section"
NSQ_SOURCE_LINE 00000415 "        } # if for plugin"
NSQ_SOURCE_LINE 00000416 "    }"
NSQ_SOURCE_LINE 00000417 "    log_trace(\"[pericmd] Seen config profiles: %s\","
NSQ_SOURCE_LINE 00000418 "              [sort keys %seen_profiles]);"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "    [200, \"OK\", $args, {'func.found'=>$found}];"
NSQ_SOURCE_LINE 00000421 "}"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "1;"
NSQ_SOURCE_LINE 00000424 "# ABSTRACT: Utility routines related to config files"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "__END__"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "=pod"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "=head1 NAME"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "Perinci::CmdLine::Util::Config - Utility routines related to config files"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "=head1 VERSION"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "This document describes version 1.727 of Perinci::CmdLine::Util::Config (from Perl distribution Perinci-CmdLine-Util-Config), released on 2025-11-15."
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "=head2 get_args_from_config"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "Usage:"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 " get_args_from_config(%args) -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "C<config> is a HoH (hashes of hashrefs) produced by reading an INI (IOD)"
NSQ_SOURCE_LINE 00000450 "configuration file using modules like L<Config::IOD::Reader>."
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "Hashref argument C<args> will be set by parameters in C<config>, while C<plugins>"
NSQ_SOURCE_LINE 00000453 "will be set by parameters in C<[plugin=...]> sections in C<config>. For example,"
NSQ_SOURCE_LINE 00000454 "with this configuration:"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 " arg1=val1"
NSQ_SOURCE_LINE 00000457 " arg2=val2"
NSQ_SOURCE_LINE 00000458 " -special_arg1=val3"
NSQ_SOURCE_LINE 00000459 " -special_arg2=val4"
NSQ_SOURCE_LINE 00000460 " "
NSQ_SOURCE_LINE 00000461 " [plugin=DumpArgs]"
NSQ_SOURCE_LINE 00000462 " -event=before_validation"
NSQ_SOURCE_LINE 00000463 " "
NSQ_SOURCE_LINE 00000464 " [plugin=Foo]"
NSQ_SOURCE_LINE 00000465 " arg1=val1"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "C<args> will become:"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 " {"
NSQ_SOURCE_LINE 00000470 "   arg1=>\"val1\","
NSQ_SOURCE_LINE 00000471 "   arg2=>\"val2\","
NSQ_SOURCE_LINE 00000472 "   -special_arg1=>\"val3\","
NSQ_SOURCE_LINE 00000473 "   -special_arg2=>\"val4\","
NSQ_SOURCE_LINE 00000474 " }"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "and C<plugins> will become:"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 " ["
NSQ_SOURCE_LINE 00000479 "   'DumpArgs@before_validation' => {},"
NSQ_SOURCE_LINE 00000480 "   Foo => {arg1=>val},"
NSQ_SOURCE_LINE 00000481 " ]"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "=over 4"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "=item * B<args> => I<hash>"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "(No description)"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "=item * B<common_opts> => I<any>"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "(No description)"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "=item * B<config> => I<any>"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "(No description)"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=item * B<config_profile> => I<any>"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "(No description)"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=item * B<meta> => I<any>"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "(No description)"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "=item * B<meta_is_normalized> => I<any>"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "(No description)"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "=item * B<plugins> => I<array>"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "(No description)"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "=item * B<r> => I<any>"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "(No description)"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "=item * B<subcommand_name> => I<any>"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "(No description)"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "=back"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "First element ($status_code) is an integer containing HTTP-like status code"
NSQ_SOURCE_LINE 00000531 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000532 "($reason) is a string containing error message, or something like \"OK\" if status is"
NSQ_SOURCE_LINE 00000533 "200. Third element ($payload) is the actual result, but usually not present when enveloped result is an error response ($status_code is not 2xx). Fourth"
NSQ_SOURCE_LINE 00000534 "element (%result_meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000535 "that contains extra information, much like how HTTP response headers provide additional metadata."
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "Return value:  (any)"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 ""
