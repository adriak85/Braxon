NSQ_SOURCE_LINE 00000011 "=head1 NAME"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "Menlo::Legacy - Legacy internal and client support for Menlo"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "Menlo::Legacy is a package to install L<Menlo::CLI::Compat> which is a"
NSQ_SOURCE_LINE 00000018 "compatibility library that implements the classic version of cpanminus"
NSQ_SOURCE_LINE 00000019 "internals and behavios. This is so that existing users of cpanm and"
NSQ_SOURCE_LINE 00000020 "API clients such as L<Carton>, L<Carmel> and L<App::cpm>) can rely on"
NSQ_SOURCE_LINE 00000021 "the stable features and specific behaviors of cpanm."
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "This way Menlo can evolve and be refactored without the fear of"
NSQ_SOURCE_LINE 00000024 "breaking any downstream clients, including C<cpanm> itself."
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "=head1 AUTHOR"
