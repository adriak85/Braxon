NSQ_SOURCE_LINE 00000001 "package File::Flock::Retry;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2021-08-10'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'File-Flock-Retry'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.632'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use Fcntl ':DEFAULT', ':flock';"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub lock {"
NSQ_SOURCE_LINE 00000015 "    my ($class, $path, $opts) = @_;"
NSQ_SOURCE_LINE 00000016 "    $opts //= {};"
NSQ_SOURCE_LINE 00000017 "    my %h;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    defined($path) or die \"Please specify path\";"
NSQ_SOURCE_LINE 00000020 "    $h{path}    = $path;"
NSQ_SOURCE_LINE 00000021 "    $h{retries} = $opts->{retries} // 60;"
NSQ_SOURCE_LINE 00000022 "    $h{shared}  = $opts->{shared} // 0;"
NSQ_SOURCE_LINE 00000023 "    $h{mode}    = $opts->{mode} // (O_CREAT | O_RDWR);"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    my $self = bless \\%h, $class;"
NSQ_SOURCE_LINE 00000026 "    $self->_lock;"
NSQ_SOURCE_LINE 00000027 "    $self;"
NSQ_SOURCE_LINE 00000028 "}"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "# return 1 if we lock, 0 if already locked. die on failure."
NSQ_SOURCE_LINE 00000031 "sub _lock {"
NSQ_SOURCE_LINE 00000032 "    my $self = shift;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    # already locked"
NSQ_SOURCE_LINE 00000035 "    return 0 if $self->{_fh};"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    my $path = $self->{path};"
NSQ_SOURCE_LINE 00000038 "    my $existed = -f $path;"
NSQ_SOURCE_LINE 00000039 "    my $exists;"
NSQ_SOURCE_LINE 00000040 "    my $tries = 0;"
NSQ_SOURCE_LINE 00000041 "  TRY:"
NSQ_SOURCE_LINE 00000042 "    while (1) {"
NSQ_SOURCE_LINE 00000043 "        $tries++;"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "        # 1"
NSQ_SOURCE_LINE 00000046 "        sysopen $self->{_fh}, $path, $self->{mode}"
NSQ_SOURCE_LINE 00000047 "            or die \"Can't open lock file '$path': $!\";"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "        # 2"
NSQ_SOURCE_LINE 00000050 "        my @st1 = stat($self->{_fh}); # stat before lock"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "        # 3"
NSQ_SOURCE_LINE 00000053 "        if (flock($self->{_fh}, ($self->{shared} ? LOCK_SH : LOCK_EX) | LOCK_NB)) {"
NSQ_SOURCE_LINE 00000054 "            # if file is unlinked by another process between 1 & 2, @st1 will be"
NSQ_SOURCE_LINE 00000055 "            # empty and we check here."
NSQ_SOURCE_LINE 00000056 "            redo TRY unless @st1;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "            # 4"
NSQ_SOURCE_LINE 00000059 "            my @st2 = stat($path); # stat after lock"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "            # if file is unlinked between 3 & 4, @st2 will be empty and we check"
NSQ_SOURCE_LINE 00000062 "            # here."
NSQ_SOURCE_LINE 00000063 "            redo TRY unless @st2;"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "            # if file is recreated between 2 & 4, @st1 and @st2 will differ in"
NSQ_SOURCE_LINE 00000066 "            # dev/inode, we check here."
NSQ_SOURCE_LINE 00000067 "            redo TRY if $st1[0] != $st2[0] || $st1[1] != $st2[1];"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "            # everything seems okay"
NSQ_SOURCE_LINE 00000070 "            last;"
NSQ_SOURCE_LINE 00000071 "        } else {"
NSQ_SOURCE_LINE 00000072 "            $tries <= $self->{retries}"
NSQ_SOURCE_LINE 00000073 "                or die \"Can't acquire lock on '$path' after $tries seconds\";"
NSQ_SOURCE_LINE 00000074 "            sleep 1;"
NSQ_SOURCE_LINE 00000075 "        }"
NSQ_SOURCE_LINE 00000076 "    }"
NSQ_SOURCE_LINE 00000077 "    $self->{_acquired} = 1;"
NSQ_SOURCE_LINE 00000078 "    1;"
NSQ_SOURCE_LINE 00000079 "}"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "# return 1 if we unlock, 0 if already unlocked. die on failure."
NSQ_SOURCE_LINE 00000082 "sub _unlock {"
NSQ_SOURCE_LINE 00000083 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    my $path = $self->{path};"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    # don't unlock if we are not holding the lock"
NSQ_SOURCE_LINE 00000088 "    return 0 unless $self->{_fh};"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "    unlink $self->{path} if $self->{_acquired} && !(-s $self->{path});"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "    {"
NSQ_SOURCE_LINE 00000093 "        # to shut up warning about flock on closed filehandle (XXX but why"
NSQ_SOURCE_LINE 00000094 "        # closed if we are holding the lock?)"
NSQ_SOURCE_LINE 00000095 "        no warnings;"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "        flock $self->{_fh}, LOCK_UN;"
NSQ_SOURCE_LINE 00000098 "    }"
NSQ_SOURCE_LINE 00000099 "    close delete($self->{_fh});"
NSQ_SOURCE_LINE 00000100 "    1;"
NSQ_SOURCE_LINE 00000101 "}"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "sub release {"
NSQ_SOURCE_LINE 00000104 "    my $self = shift;"
NSQ_SOURCE_LINE 00000105 "    $self->_unlock;"
NSQ_SOURCE_LINE 00000106 "}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "sub unlock {"
NSQ_SOURCE_LINE 00000109 "    my $self = shift;"
NSQ_SOURCE_LINE 00000110 "    $self->_unlock;"
NSQ_SOURCE_LINE 00000111 "}"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "sub handle {"
NSQ_SOURCE_LINE 00000114 "    my $self = shift;"
NSQ_SOURCE_LINE 00000115 "    $self->{_fh};"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "sub DESTROY {"
NSQ_SOURCE_LINE 00000119 "    my $self = shift;"
NSQ_SOURCE_LINE 00000120 "    $self->_unlock;"
NSQ_SOURCE_LINE 00000121 "}"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "1;"
NSQ_SOURCE_LINE 00000124 "# ABSTRACT: Yet another flock module"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "__END__"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=pod"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=head1 NAME"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "File::Flock::Retry - Yet another flock module"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head1 VERSION"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "This document describes version 0.632 of File::Flock::Retry (from Perl distribution File-Flock-Retry), released on 2021-08-10."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 " use File::Flock::Retry;"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 " # try to acquire exclusive lock. if fail to acquire lock within 60s, die."
NSQ_SOURCE_LINE 00000145 " my $lock = File::Flock::Retry->lock($file);"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 " # explicitly unlock"
NSQ_SOURCE_LINE 00000148 " $lock->release;"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 " # automatically unlock if object is DESTROY-ed."
NSQ_SOURCE_LINE 00000151 " undef $lock;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "This is yet another flock module. It is a more lightweight alternative to"
NSQ_SOURCE_LINE 00000156 "L<File::Flock> with some other differences:"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "=over 4"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=item * OO interface only"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "=item * Autoretry (by default for 60s) when trying to acquire lock"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "I prefer this approach to blocking/waiting indefinitely or failing immediately."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=back"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=for Pod::Coverage ^(DESTROY)$"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "=head1 METHODS"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=head2 lock"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "Usage:"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 " $lock = File::Flock::Retry->lock($path, \\%opts)"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "Attempt to acquire an exclusive lock on C<$path>. By default, C<$path> will be"
NSQ_SOURCE_LINE 00000179 "created if not already exists (see L</mode>). If C<$path> is already locked by"
NSQ_SOURCE_LINE 00000180 "another process, will retry every second for a number of seconds (by default"
NSQ_SOURCE_LINE 00000181 "60). Will die if failed to acquire lock after all retries."
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "Will automatically unlock if C<$lock> goes out of scope. Upon unlock, will"
NSQ_SOURCE_LINE 00000184 "remove C<$path> if it is still empty (zero-sized)."
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "Available options:"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=over"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=item * mode"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "Integer. Default: O_CREAT | O_RDWR."
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "File open mode, to be passed to Perl's C<sysopen()>. For example, if you want to"
NSQ_SOURCE_LINE 00000195 "avoid race condition between creating and locking the file, you might want to"
NSQ_SOURCE_LINE 00000196 "use C<< O_CREAT | O_EXCL | O_RDWR >> to fail when the file already exists. Note"
NSQ_SOURCE_LINE 00000197 "that the constants are available after you do a C<< use Fcntl ':DEFAULT'; >>."
NSQ_SOURCE_LINE 00000198 ""
NSQ_SOURCE_LINE 00000199 "=item * retries"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "Integer. Default: 60."
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "Number of retries (equals number of seconds, since retry is done every second)."
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "=item * shared"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "Boolean. Default: 0."
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "By default, an exclusive lock (LOCK_EX) is attempted. However, if this option is"
NSQ_SOURCE_LINE 00000210 "set to true, a shared lock (LOCK_SH) is attempted."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=back"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "=head2 unlock"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "Usage:"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 " $lock->unlock"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "Unlock. will remove lock file if it is still empty."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head2 release"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "Usage:"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 " $lock->release"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "Synonym for L</unlock>."
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "=head2 handle"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "Usage:"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 " my $fh = $lock->handle;"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "Return the file handle."
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "Please visit the project's homepage at L<https://metacpan.org/release/File-Flock-Retry>."
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "Source repository is at L<https://github.com/perlancar/perl-File-Flock-Retry>."
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=head1 BUGS"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=File-Flock-Retry>"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000251 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000252 "feature."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "Not yet tested on Windows. Some filesystems do not support inode?"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "L<File::Flock>, a bit too heavy in terms of dependencies and startup overhead,"
NSQ_SOURCE_LINE 00000261 "for my taste. It depends on things like L<File::Slurp> and"
NSQ_SOURCE_LINE 00000262 "L<Data::Structure::Util> (which loads L<Digest::MD5>, L<Storable>, among"
NSQ_SOURCE_LINE 00000263 "others)."
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "L<File::Flock::Tiny> which is also tiny, but does not have the autoremove and"
NSQ_SOURCE_LINE 00000266 "autoretry capability which I want. See also:"
NSQ_SOURCE_LINE 00000267 "L<https://github.com/trinitum/perl-File-Flock-Tiny/issues/1>"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "flock() Perl function."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "An alternative to flock() is just using sysopen() with O_CREAT|O_EXCL mode to"
NSQ_SOURCE_LINE 00000272 "create lock files. This is supported on more filesystems (particularly network"
NSQ_SOURCE_LINE 00000273 "filesystems which lack flock())."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "perlancar <perlancar@cpan.org>"
