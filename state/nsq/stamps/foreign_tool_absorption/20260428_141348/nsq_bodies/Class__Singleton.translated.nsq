BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "#============================================================================"
NSQ_SOURCE_LINE 00000002 "#"
NSQ_SOURCE_LINE 00000003 "# Class::Singleton.pm"
NSQ_SOURCE_LINE 00000004 "#"
NSQ_SOURCE_LINE 00000005 "# Implementation of a \"singleton\" module which ensures that a class has"
NSQ_SOURCE_LINE 00000006 "# only one instance and provides global access to it.  For a description "
NSQ_SOURCE_LINE 00000007 "# of the Singleton class, see \"Design Patterns\", Gamma et al, Addison-"
NSQ_SOURCE_LINE 00000008 "# Wesley, 1995, ISBN 0-201-63361-2"
NSQ_SOURCE_LINE 00000009 "#"
NSQ_SOURCE_LINE 00000010 "# Written by Andy Wardley <abw@wardley.org>"
NSQ_SOURCE_LINE 00000011 "#"
NSQ_SOURCE_LINE 00000012 "# Copyright (C) 1998 Canon Research Centre Europe Ltd."
NSQ_SOURCE_LINE 00000013 "# Copyright (C) 1998-2008 Andy Wardley.  All rights reserved."
NSQ_SOURCE_LINE 00000014 "# Copyright (C) 2014 Steve Hay.  All rights reserved."
NSQ_SOURCE_LINE 00000015 "#"
NSQ_SOURCE_LINE 00000016 "# This module is free software; you can redistribute it and/or modify it under"
NSQ_SOURCE_LINE 00000017 "# the same terms as Perl itself, i.e. under the terms of either the GNU General"
NSQ_SOURCE_LINE 00000018 "# Public License or the Artistic License, as specified in the F<LICENCE> file."
NSQ_SOURCE_LINE 00000019 "#"
NSQ_SOURCE_LINE 00000020 "#============================================================================"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "package Class::Singleton;"
NSQ_SOURCE_LINE 00000023 "use 5.008001;"
NSQ_SOURCE_LINE 00000024 "use strict;"
NSQ_SOURCE_LINE 00000025 "use warnings;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "our $VERSION = 1.6;"
NSQ_SOURCE_LINE 00000028 "my %_INSTANCES = ();"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "#========================================================================"
NSQ_SOURCE_LINE 00000032 "#"
NSQ_SOURCE_LINE 00000033 "# instance()"
NSQ_SOURCE_LINE 00000034 "#"
NSQ_SOURCE_LINE 00000035 "# Module constructor.  Creates an Class::Singleton (or derived) instance "
NSQ_SOURCE_LINE 00000036 "# if one doesn't already exist.  The instance reference is stored in the"
NSQ_SOURCE_LINE 00000037 "# %_INSTANCES hash of the Class::Singleton package.  The impact of this is"
NSQ_SOURCE_LINE 00000038 "# that you can create any number of classes derived from Class::Singleton"
NSQ_SOURCE_LINE 00000039 "# and create a single instance of each one.  If the instance reference"
NSQ_SOURCE_LINE 00000040 "# was stored in a scalar $_INSTANCE variable, you could only instantiate "
NSQ_SOURCE_LINE 00000041 "# *ONE* object of *ANY* class derived from Class::Singleton.  The first"
NSQ_SOURCE_LINE 00000042 "# time the instance is created, the _new_instance() constructor is called "
NSQ_SOURCE_LINE 00000043 "# which simply returns a reference to a blessed hash.  This can be "
NSQ_SOURCE_LINE 00000044 "# overloaded for custom constructors.  Any additional parameters passed to "
NSQ_SOURCE_LINE 00000045 "# instance() are forwarded to _new_instance()."
NSQ_SOURCE_LINE 00000046 "#"
NSQ_SOURCE_LINE 00000047 "# Returns a reference to the existing, or a newly created Class::Singleton"
NSQ_SOURCE_LINE 00000048 "# object.  If the _new_instance() method returns an undefined value"
NSQ_SOURCE_LINE 00000049 "# then the constructer is deemed to have failed."
NSQ_SOURCE_LINE 00000050 "#"
NSQ_SOURCE_LINE 00000051 "#========================================================================"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "sub instance {"
NSQ_SOURCE_LINE 00000054 "    my $class = shift;"
NSQ_SOURCE_LINE 00000055 "    "
NSQ_SOURCE_LINE 00000056 "    # already got an object"
NSQ_SOURCE_LINE 00000057 "    return $class if ref $class;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    # we store the instance against the $class key of %_INSTANCES"
NSQ_SOURCE_LINE 00000060 "    my $instance = $_INSTANCES{$class};"
NSQ_SOURCE_LINE 00000061 "    unless(defined $instance) {"
NSQ_SOURCE_LINE 00000062 "        $_INSTANCES{$class} = $instance = $class->_new_instance(@_);"
NSQ_SOURCE_LINE 00000063 "    }"
NSQ_SOURCE_LINE 00000064 "    return $instance;"
NSQ_SOURCE_LINE 00000065 "}"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "#======================================================================="
NSQ_SOURCE_LINE 00000069 "# has_instance()"
NSQ_SOURCE_LINE 00000070 "#"
NSQ_SOURCE_LINE 00000071 "# Public method to return the current instance if it exists."
NSQ_SOURCE_LINE 00000072 "#======================================================================="
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub has_instance {"
NSQ_SOURCE_LINE 00000075 "    my $class = shift;"
NSQ_SOURCE_LINE 00000076 "    $class = ref $class || $class;"
NSQ_SOURCE_LINE 00000077 "    return $_INSTANCES{$class};"
NSQ_SOURCE_LINE 00000078 "}"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "#========================================================================"
NSQ_SOURCE_LINE 00000082 "# _new_instance(...)"
NSQ_SOURCE_LINE 00000083 "#"
NSQ_SOURCE_LINE 00000084 "# Simple constructor which returns a hash reference blessed into the "
NSQ_SOURCE_LINE 00000085 "# current class.  May be overloaded to create non-hash objects or "
NSQ_SOURCE_LINE 00000086 "# handle any specific initialisation required."
NSQ_SOURCE_LINE 00000087 "#========================================================================"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "sub _new_instance {"
NSQ_SOURCE_LINE 00000090 "    my $class = shift;"
NSQ_SOURCE_LINE 00000091 "    my %args  = @_ && ref $_[0] eq 'HASH' ? %{ $_[0] } : @_;"
NSQ_SOURCE_LINE 00000092 "    bless { %args }, $class;"
NSQ_SOURCE_LINE 00000093 "}"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "#========================================================================"
NSQ_SOURCE_LINE 00000097 "# END()"
NSQ_SOURCE_LINE 00000098 "#"
NSQ_SOURCE_LINE 00000099 "# END block to explicitly destroy all Class::Singleton objects since"
NSQ_SOURCE_LINE 00000100 "# destruction order at program exit is not predictable. See CPAN RT"
NSQ_SOURCE_LINE 00000101 "# bugs #23568 and #68526 for examples of what can go wrong without this."
NSQ_SOURCE_LINE 00000102 "#========================================================================"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "END {"
NSQ_SOURCE_LINE 00000105 "    # dereferences and causes orderly destruction of all instances"
NSQ_SOURCE_LINE 00000106 "    undef(%_INSTANCES);"
NSQ_SOURCE_LINE 00000107 "}"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "1;"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "__END__"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=head1 NAME"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "Class::Singleton - Implementation of a \"Singleton\" class "
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "    use Class::Singleton;"
NSQ_SOURCE_LINE 00000121 "    "
NSQ_SOURCE_LINE 00000122 "    my $one = Class::Singleton->instance();   # returns a new instance"
NSQ_SOURCE_LINE 00000123 "    my $two = Class::Singleton->instance();   # returns same instance"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "This is the C<Class::Singleton> module.  A Singleton describes an object class"
NSQ_SOURCE_LINE 00000128 "that can have only one instance in any system.  An example of a Singleton"
NSQ_SOURCE_LINE 00000129 "might be a print spooler or system registry.  This module implements a"
NSQ_SOURCE_LINE 00000130 "Singleton class from which other classes can be derived.  By itself, the"
NSQ_SOURCE_LINE 00000131 "C<Class::Singleton> module does very little other than manage the instantiation"
NSQ_SOURCE_LINE 00000132 "of a single object.  In deriving a class from C<Class::Singleton>, your module "
NSQ_SOURCE_LINE 00000133 "will inherit the Singleton instantiation method and can implement whatever"
NSQ_SOURCE_LINE 00000134 "specific functionality is required."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "For a description and discussion of the Singleton class, see "
NSQ_SOURCE_LINE 00000137 "\"Design Patterns\", Gamma et al, Addison-Wesley, 1995, ISBN 0-201-63361-2."
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head2 Using the Class::Singleton Module"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "To import and use the C<Class::Singleton> module the following line should "
NSQ_SOURCE_LINE 00000142 "appear in your Perl program:"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    use Class::Singleton;"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "The L<instance()> method is used to create a new C<Class::Singleton> instance,"
NSQ_SOURCE_LINE 00000147 "or return a reference to an existing instance. Using this method, it is only"
NSQ_SOURCE_LINE 00000148 "possible to have a single instance of the class in any system."
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "    my $highlander = Class::Singleton->instance();"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "Assuming that no C<Class::Singleton> object currently exists, this first call"
NSQ_SOURCE_LINE 00000153 "to L<instance()> will create a new C<Class::Singleton> and return a reference"
NSQ_SOURCE_LINE 00000154 "to it. Future invocations of L<instance()> will return the same reference."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "    my $macleod    = Class::Singleton->instance();"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "In the above example, both C<$highlander> and C<$macleod> contain the same"
NSQ_SOURCE_LINE 00000159 "reference to a C<Class::Singleton> instance.  There can be only one."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head2 Deriving Singleton Classes"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "A module class may be derived from C<Class::Singleton> and will inherit the "
NSQ_SOURCE_LINE 00000164 "L<instance()> method that correctly instantiates only one object."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "    package PrintSpooler;"
NSQ_SOURCE_LINE 00000167 "    use base 'Class::Singleton';"
NSQ_SOURCE_LINE 00000168 "    "
NSQ_SOURCE_LINE 00000169 "    # derived class specific code"
NSQ_SOURCE_LINE 00000170 "    sub submit_job {"
NSQ_SOURCE_LINE 00000171 "        ..."
NSQ_SOURCE_LINE 00000172 "    }"
NSQ_SOURCE_LINE 00000173 "    "
NSQ_SOURCE_LINE 00000174 "    sub cancel_job {"
NSQ_SOURCE_LINE 00000175 "        ..."
NSQ_SOURCE_LINE 00000176 "    }"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "The C<PrintSpooler> class defined above could be used as follows:"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    use PrintSpooler;"
NSQ_SOURCE_LINE 00000181 "    "
NSQ_SOURCE_LINE 00000182 "    my $spooler = PrintSpooler->instance();"
NSQ_SOURCE_LINE 00000183 "    "
NSQ_SOURCE_LINE 00000184 "    $spooler->submit_job(...);"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "The L<instance()> method calls the L<_new_instance()> constructor method the"
NSQ_SOURCE_LINE 00000187 "first and only time a new instance is created. All parameters passed to the"
NSQ_SOURCE_LINE 00000188 "L<instance()> method are forwarded to L<_new_instance()>. In the base class"
NSQ_SOURCE_LINE 00000189 "the L<_new_instance()> method returns a blessed reference to a hash array"
NSQ_SOURCE_LINE 00000190 "containing any arguments passed as either a hash reference or list of named "
NSQ_SOURCE_LINE 00000191 "parameters. "
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "    package MyConfig;"
NSQ_SOURCE_LINE 00000194 "    use base 'Class::Singleton';"
NSQ_SOURCE_LINE 00000195 "    "
NSQ_SOURCE_LINE 00000196 "    sub foo {"
NSQ_SOURCE_LINE 00000197 "        shift->{ foo };"
NSQ_SOURCE_LINE 00000198 "    }"
NSQ_SOURCE_LINE 00000199 "    "
NSQ_SOURCE_LINE 00000200 "    sub bar {"
NSQ_SOURCE_LINE 00000201 "        shift->{ bar };"
NSQ_SOURCE_LINE 00000202 "    }"
NSQ_SOURCE_LINE 00000203 "    "
NSQ_SOURCE_LINE 00000204 "    package main;"
NSQ_SOURCE_LINE 00000205 "    "
NSQ_SOURCE_LINE 00000206 "    # either: hash reference of named parameters"
NSQ_SOURCE_LINE 00000207 "    my $config = MyConfig->instance({ foo => 10, bar => 20 });"
NSQ_SOURCE_LINE 00000208 "    "
NSQ_SOURCE_LINE 00000209 "    # or: list of named parameters"
NSQ_SOURCE_LINE 00000210 "    my $config = MyConfig->instance( foo => 10, bar => 20 );"
NSQ_SOURCE_LINE 00000211 "    "
NSQ_SOURCE_LINE 00000212 "    print $config->foo();   # 10"
NSQ_SOURCE_LINE 00000213 "    print $config->bar();   # 20"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "Derived classes may redefine the L<_new_instance()> method to provide more"
NSQ_SOURCE_LINE 00000216 "specific object initialisation or change the underlying object type (to a list"
NSQ_SOURCE_LINE 00000217 "reference, for example)."
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "    package MyApp::Database;"
NSQ_SOURCE_LINE 00000220 "    use base 'Class::Singleton';"
NSQ_SOURCE_LINE 00000221 "    use DBI;"
NSQ_SOURCE_LINE 00000222 "    "
NSQ_SOURCE_LINE 00000223 "    # this only gets called the first time instance() is called"
NSQ_SOURCE_LINE 00000224 "    sub _new_instance {"
NSQ_SOURCE_LINE 00000225 "        my $class = shift;"
NSQ_SOURCE_LINE 00000226 "        my $self  = bless { }, $class;"
NSQ_SOURCE_LINE 00000227 "        my $db    = shift || \"myappdb\";    "
NSQ_SOURCE_LINE 00000228 "        my $host  = shift || \"localhost\";"
NSQ_SOURCE_LINE 00000229 "        "
NSQ_SOURCE_LINE 00000230 "        $self->{ DB } = DBI->connect(\"DBI:mSQL:$db:$host\")"
NSQ_SOURCE_LINE 00000231 "            || die \"Cannot connect to database: $DBI::errstr\";"
NSQ_SOURCE_LINE 00000232 "        "
NSQ_SOURCE_LINE 00000233 "        # any other initialisation..."
NSQ_SOURCE_LINE 00000234 "        "
NSQ_SOURCE_LINE 00000235 "        return $self;"
NSQ_SOURCE_LINE 00000236 "    }"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "The above example might be used as follows:"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "    use MyApp::Database;"
NSQ_SOURCE_LINE 00000241 "    "
NSQ_SOURCE_LINE 00000242 "    # first use - database gets initialised"
NSQ_SOURCE_LINE 00000243 "    my $database = MyApp::Database->instance();"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "Some time later on in a module far, far away..."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    package MyApp::FooBar"
NSQ_SOURCE_LINE 00000248 "    use MyApp::Database;"
NSQ_SOURCE_LINE 00000249 "    "
NSQ_SOURCE_LINE 00000250 "    # this FooBar object needs access to the database; the Singleton"
NSQ_SOURCE_LINE 00000251 "    # approach gives a nice wrapper around global variables."
NSQ_SOURCE_LINE 00000252 "    "
NSQ_SOURCE_LINE 00000253 "    sub new {"
NSQ_SOURCE_LINE 00000254 "        my $class = shift;"
NSQ_SOURCE_LINE 00000255 "        bless {"
NSQ_SOURCE_LINE 00000256 "            database => MyApp::Database->instance(),"
NSQ_SOURCE_LINE 00000257 "        }, $class;"
NSQ_SOURCE_LINE 00000258 "    }"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "The C<Class::Singleton> L<instance()> method uses a private hash to store"
NSQ_SOURCE_LINE 00000261 "a reference to any existing instance of the object, keyed against the derived"
NSQ_SOURCE_LINE 00000262 "class package name."
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "This allows different classes to be derived from C<Class::Singleton> that can"
NSQ_SOURCE_LINE 00000265 "co-exist in the same system, while still allowing only one instance of any one"
NSQ_SOURCE_LINE 00000266 "class to exist. For example, it would be possible to derive both"
NSQ_SOURCE_LINE 00000267 "'C<PrintSpooler>' and 'C<MyApp::Database>' from C<Class::Singleton> and have a"
NSQ_SOURCE_LINE 00000268 "single instance of I<each> in a system, rather than a single instance of"
NSQ_SOURCE_LINE 00000269 "I<either>."
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "You can use the L<has_instance()> method to find out if a particular class "
NSQ_SOURCE_LINE 00000272 "already has an instance defined.  A reference to the instance is returned or"
NSQ_SOURCE_LINE 00000273 "C<undef> if none is currently defined."
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "    my $instance = MyApp::Database->has_instance()"
NSQ_SOURCE_LINE 00000276 "        || warn \"No instance is defined yet\";"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head2 Methods"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "=over 4"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=item instance()"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "This method is called to return a current object instance or create a new"
NSQ_SOURCE_LINE 00000285 "one by calling L<_new_instance()>."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=item has_instance()"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "This method returns a reference to any existing instance or C<undef> if none"
NSQ_SOURCE_LINE 00000290 "is defined."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "    my $testing = MySingleton1->has_instance()"
NSQ_SOURCE_LINE 00000293 "        || warn \"No instance defined for MySingleton1\";"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=item _new_instance()"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "This \"private\" method is called by L<instance()> to create a new object"
NSQ_SOURCE_LINE 00000298 "instance if one doesn't already exist. It is not intended to be called"
NSQ_SOURCE_LINE 00000299 "directly (although there's nothing to stop you from calling it if you're"
NSQ_SOURCE_LINE 00000300 "really determined to do so)."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "It creates a blessed hash reference containing any arguments passed to the"
NSQ_SOURCE_LINE 00000303 "method as either a hash reference or list of named parameters."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "    # either: hash reference of named parameters"
NSQ_SOURCE_LINE 00000306 "    my $example1 = MySingleton1->new({ pi => 3.14, e => 2.718 });"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "    # or: list of named parameters"
NSQ_SOURCE_LINE 00000309 "    my $example2 = MySingleton2->new( pi => 3.14, e => 2.718 );"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "It is important to remember that the L<instance()> method will I<only> call"
NSQ_SOURCE_LINE 00000312 "the I<_new_instance()> method once, so any arguments you pass may be silently"
NSQ_SOURCE_LINE 00000313 "ignored if an instance already exists. You can use the L<has_instance()>"
NSQ_SOURCE_LINE 00000314 "method to determine if an instance is already defined."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=back"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "I<None>."
NSQ_SOURCE_LINE 00000321 ""
