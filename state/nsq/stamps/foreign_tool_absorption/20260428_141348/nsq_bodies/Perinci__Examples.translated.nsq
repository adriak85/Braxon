NSQ_SOURCE_LINE 00002375 "=head2 result_naked"
NSQ_SOURCE_LINE 00002376 ""
NSQ_SOURCE_LINE 00002377 "Usage:"
NSQ_SOURCE_LINE 00002378 ""
NSQ_SOURCE_LINE 00002379 " result_naked(%args) -> any"
NSQ_SOURCE_LINE 00002380 ""
NSQ_SOURCE_LINE 00002381 "This function's metadata sets C<result_naked> to true. This means function"
NSQ_SOURCE_LINE 00002382 "returns just the value (e.g. C<42>) and not with envelope (e.g. C<[200,\"OK\",42]>)."
NSQ_SOURCE_LINE 00002383 "However, when served over network Riap protocol, the function wrapper"
NSQ_SOURCE_LINE 00002384 "L<Perinci::Sub::Wrapper> can generate an envelope for the result, so the"
NSQ_SOURCE_LINE 00002385 "wrapped function wil still return C<[200,\"OK\",42]>."
NSQ_SOURCE_LINE 00002386 ""
NSQ_SOURCE_LINE 00002387 "This function is not exported."
NSQ_SOURCE_LINE 00002388 ""
NSQ_SOURCE_LINE 00002389 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00002390 ""
NSQ_SOURCE_LINE 00002391 "=over 4"
NSQ_SOURCE_LINE 00002392 ""
NSQ_SOURCE_LINE 00002393 "=item * B<a0> => I<str>"
NSQ_SOURCE_LINE 00002394 ""
NSQ_SOURCE_LINE 00002395 "(No description)"
NSQ_SOURCE_LINE 00002396 ""
NSQ_SOURCE_LINE 00002397 "=item * B<a1> => I<str>"
NSQ_SOURCE_LINE 00002398 ""
NSQ_SOURCE_LINE 00002399 "(No description)"
NSQ_SOURCE_LINE 00002400 ""
NSQ_SOURCE_LINE 00002401 ""
NSQ_SOURCE_LINE 00002402 "=back"
NSQ_SOURCE_LINE 00002403 ""
NSQ_SOURCE_LINE 00002404 "Return value:  (any)"
NSQ_SOURCE_LINE 00002405 ""
NSQ_SOURCE_LINE 00002406 ""
