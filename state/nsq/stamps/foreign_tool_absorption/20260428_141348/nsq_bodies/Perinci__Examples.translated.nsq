NSQ_SOURCE_LINE 00000106 "    description => <<'_',"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "Can be used to test exception handling."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "_"
NSQ_SOURCE_LINE 00000111 "    args => {"
NSQ_SOURCE_LINE 00000112 "    },"
NSQ_SOURCE_LINE 00000113 "};"
NSQ_SOURCE_LINE 00000114 "sub dies {"
