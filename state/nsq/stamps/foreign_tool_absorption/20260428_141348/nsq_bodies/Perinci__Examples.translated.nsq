NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000017 "our $DATE = '2024-07-17'; # DATE"
