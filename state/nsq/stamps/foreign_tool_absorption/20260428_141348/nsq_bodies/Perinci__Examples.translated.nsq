NSQ_SOURCE_LINE 00000026 "our %SPEC;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "# package metadata"
NSQ_SOURCE_LINE 00000029 "$SPEC{':package'} = {"
NSQ_SOURCE_LINE 00000030 "    v => 1.1,"
NSQ_SOURCE_LINE 00000031 "    summary => 'Various examples of Rinci metadata',"
NSQ_SOURCE_LINE 00000032 "    \"summary.alt.lang.id_ID\" => 'Berbagai contoh metadata Rinci',"
NSQ_SOURCE_LINE 00000033 "    description => <<'_',"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "A sample description"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "    verbatim"
NSQ_SOURCE_LINE 00000038 "    line2"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "Another paragraph with *bold*, _italic_ text."
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "_"
NSQ_SOURCE_LINE 00000043 "};"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "# variable metadata"
NSQ_SOURCE_LINE 00000046 "$SPEC{'$Var1'} = {"
NSQ_SOURCE_LINE 00000047 "    v => 1.1,"
NSQ_SOURCE_LINE 00000048 "    summary => 'This variable contains the meaning of life',"
NSQ_SOURCE_LINE 00000049 "    description => <<'_',"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "Currently Riap is very function-centric and other code entities like variables"
NSQ_SOURCE_LINE 00000052 "are not that well-supported. The action `get` will get the value for a variable,"
NSQ_SOURCE_LINE 00000053 "but this is not supported by all Riap clients, because someRiap clients only"
NSQ_SOURCE_LINE 00000054 "focus on calling functions."
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "_"
NSQ_SOURCE_LINE 00000057 "};"
NSQ_SOURCE_LINE 00000058 "our $Var1 = 42;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "# as well as testing default_lang and *.alt.lang.XX properties"
NSQ_SOURCE_LINE 00000061 "$SPEC{delay} = {"
NSQ_SOURCE_LINE 00000062 "    v => 1.1,"
NSQ_SOURCE_LINE 00000063 "    default_lang => 'id_ID',"
NSQ_SOURCE_LINE 00000064 "    \"summary.alt.lang.en_US\" => \"Sleep, by default for 10 seconds\","
NSQ_SOURCE_LINE 00000065 "    \"description.alt.lang.en_US\" => <<'_',"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "Can be used to test the *time_limit* property."
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "_"
NSQ_SOURCE_LINE 00000070 "    summary => \"Tidur, defaultnya 10 detik\","
NSQ_SOURCE_LINE 00000071 "    description => <<'_',"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "Dapat dipakai untuk menguji properti *time_limit*."
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "_"
NSQ_SOURCE_LINE 00000076 "    args => {"
NSQ_SOURCE_LINE 00000077 "        n => {"
NSQ_SOURCE_LINE 00000078 "            default_lang => 'en_US',"
NSQ_SOURCE_LINE 00000079 "            summary => 'Number of seconds to sleep',"
NSQ_SOURCE_LINE 00000080 "            \"summary.alt.lang.id_ID\" => 'Jumlah detik',"
NSQ_SOURCE_LINE 00000081 "            schema => ['int', {default=>10, min=>0, max=>7200}],"
NSQ_SOURCE_LINE 00000082 "            pos => 0,"
NSQ_SOURCE_LINE 00000083 "        },"
NSQ_SOURCE_LINE 00000084 "        per_second => {"
NSQ_SOURCE_LINE 00000085 "            \"summary.alt.lang.en_US\" => 'Whether to sleep(1) for n times instead of sleep(n)',"
NSQ_SOURCE_LINE 00000086 "            summary => 'Jika diset ya, lakukan sleep(1) n kali, bukan sleep(n)',"
NSQ_SOURCE_LINE 00000087 "            schema => ['bool', {default=>0}],"
NSQ_SOURCE_LINE 00000088 "        },"
NSQ_SOURCE_LINE 00000089 "    },"
NSQ_SOURCE_LINE 00000090 "};"
NSQ_SOURCE_LINE 00000091 "sub delay {"
NSQ_SOURCE_LINE 00000092 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000093 "    my $n = $args{n} // 10;"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    if ($args{per_second}) {"
NSQ_SOURCE_LINE 00000096 "        sleep 1 for 1..$n;"
NSQ_SOURCE_LINE 00000097 "    } else {"
NSQ_SOURCE_LINE 00000098 "        sleep $n;"
NSQ_SOURCE_LINE 00000099 "    }"
NSQ_SOURCE_LINE 00000100 "    [200, \"OK\", \"Slept for $n sec(s)\"];"
NSQ_SOURCE_LINE 00000101 "}"
NSQ_SOURCE_LINE 00000102 ""
