NSQ_SOURCE_LINE 00000273 "sub gen_hash {"
NSQ_SOURCE_LINE 00000274 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000275 "    my $pairs = int($args{pairs});"
NSQ_SOURCE_LINE 00000276 "    defined($pairs) or return [400, \"Please specify pairs\"];"
NSQ_SOURCE_LINE 00000277 "    $pairs = 1000 if $pairs > 1000;"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "    my $hash = {};"
