NSQ_SOURCE_LINE 00000117 "}"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "$SPEC{err} = {"
NSQ_SOURCE_LINE 00000120 "    v => 1.1,"
NSQ_SOURCE_LINE 00000121 "    summary => \"Return error response\","
NSQ_SOURCE_LINE 00000122 "    description => <<'_',"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "_"
NSQ_SOURCE_LINE 00000126 "    args => {"
NSQ_SOURCE_LINE 00000127 "        code => {"
NSQ_SOURCE_LINE 00000128 "            summary => 'Error code to return',"
NSQ_SOURCE_LINE 00000129 "            schema => ['int' => {default => 500}],"
NSQ_SOURCE_LINE 00000130 "            pos => 0,"
NSQ_SOURCE_LINE 00000131 "        },"
NSQ_SOURCE_LINE 00000132 "    },"
NSQ_SOURCE_LINE 00000133 "};"
NSQ_SOURCE_LINE 00000134 "sub err {"
NSQ_SOURCE_LINE 00000135 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000136 "    my $code = int($args{code}) // 0;"
NSQ_SOURCE_LINE 00000137 "    $code = 500 if $code < 100 || $code > 555;"
NSQ_SOURCE_LINE 00000138 "    [$code, \"Response $code\"];"
NSQ_SOURCE_LINE 00000139 "}"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "my %str_levels = qw(1 fatal 2 error 3 warn 4 info 5 debug 6 trace);"
NSQ_SOURCE_LINE 00000142 "$SPEC{randlog} = {"
NSQ_SOURCE_LINE 00000143 "    v => 1.1,"
NSQ_SOURCE_LINE 00000144 "    summary => \"Produce some random Log::Any log messages\","
NSQ_SOURCE_LINE 00000145 "    description => <<'_',"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "_"
NSQ_SOURCE_LINE 00000148 "    args => {"
NSQ_SOURCE_LINE 00000149 "        n => {"
NSQ_SOURCE_LINE 00000150 "            summary => 'Number of log messages to produce',"
NSQ_SOURCE_LINE 00000151 "            schema => [int => {default => 10, min => 0, max => 1000}],"
NSQ_SOURCE_LINE 00000152 "            pos => 0,"
NSQ_SOURCE_LINE 00000153 "        },"
NSQ_SOURCE_LINE 00000154 "        min_level => {"
NSQ_SOURCE_LINE 00000155 "            summary => 'Minimum level',"
NSQ_SOURCE_LINE 00000156 "            schema => ['int*' => {default=>1, min=>0, max=>6}],"
NSQ_SOURCE_LINE 00000157 "            pos => 1,"
NSQ_SOURCE_LINE 00000158 "        },"
NSQ_SOURCE_LINE 00000159 "        max_level => {"
NSQ_SOURCE_LINE 00000160 "            summary => 'Maximum level',"
NSQ_SOURCE_LINE 00000161 "            schema => ['int*' => {default=>6, min=>0, max=>6}],"
NSQ_SOURCE_LINE 00000162 "            pos => 2,"
NSQ_SOURCE_LINE 00000163 "        },"
NSQ_SOURCE_LINE 00000164 "    },"
NSQ_SOURCE_LINE 00000165 "};"
NSQ_SOURCE_LINE 00000166 "sub randlog {"
NSQ_SOURCE_LINE 00000167 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    my %args      = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000170 "    my $n         = $args{n} // 10;"
NSQ_SOURCE_LINE 00000171 "    $n = 1000 if $n > 1000;"
NSQ_SOURCE_LINE 00000172 "    my $min_level = $args{min_level};"
NSQ_SOURCE_LINE 00000173 "    $min_level = 1 if !defined($min_level) || $min_level < 0;"
NSQ_SOURCE_LINE 00000174 "    my $max_level = $args{max_level};"
NSQ_SOURCE_LINE 00000175 "    $max_level = 6 if !defined($max_level) || $max_level > 6;"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "    for my $i (1..$n) {"
NSQ_SOURCE_LINE 00000178 "        my $num_level = int($min_level + rand()*($max_level-$min_level+1));"
NSQ_SOURCE_LINE 00000179 "        my $str_level = $str_levels{$num_level};"
NSQ_SOURCE_LINE 00000180 "        my $logfunc = \"log_$str_level\";"
NSQ_SOURCE_LINE 00000181 "        &{$logfunc}(\"($i/$n) This is random log message #$i, \"."
NSQ_SOURCE_LINE 00000182 "                        \"level=$num_level ($str_level): \"."
NSQ_SOURCE_LINE 00000183 "                        int(rand()*9000+1000));"
NSQ_SOURCE_LINE 00000184 "    }"
NSQ_SOURCE_LINE 00000185 "    [200, \"OK\", \"$n log message(s) produced\"];"
NSQ_SOURCE_LINE 00000186 "}"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "gen_modified_sub("
NSQ_SOURCE_LINE 00000189 "    output_name  => 'call_randlog',"
NSQ_SOURCE_LINE 00000190 "    base_name    => 'randlog',"
NSQ_SOURCE_LINE 00000191 "    summary      => 'Call randlog()',"
NSQ_SOURCE_LINE 00000192 "    description  => <<'_',"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "This is to test nested call (e.g. Log::Any::For::Package)."
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "_"
NSQ_SOURCE_LINE 00000197 "    output_code => sub {"
NSQ_SOURCE_LINE 00000198 "        # SUB: call_randlog"
NSQ_SOURCE_LINE 00000199 "        # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000200 "        randlog(@_);"
NSQ_SOURCE_LINE 00000201 "    },"
NSQ_SOURCE_LINE 00000202 ");"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "$SPEC{gen_array} = {"
NSQ_SOURCE_LINE 00000205 "    v => 1.1,"
NSQ_SOURCE_LINE 00000206 "    summary => \"Generate an array of specified length\","
NSQ_SOURCE_LINE 00000207 "    description => <<'_',"
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "Also tests result schema."
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "_"
NSQ_SOURCE_LINE 00000212 "    args => {"
NSQ_SOURCE_LINE 00000213 "        len => {"
NSQ_SOURCE_LINE 00000214 "            summary => 'Array length',"
NSQ_SOURCE_LINE 00000215 "            schema => ['int' => {default=>10, min => 0, max => 1000}],"
NSQ_SOURCE_LINE 00000216 "            pos => 0,"
NSQ_SOURCE_LINE 00000217 "            req => 1,"
NSQ_SOURCE_LINE 00000218 "        },"
NSQ_SOURCE_LINE 00000219 "    },"
NSQ_SOURCE_LINE 00000220 "    result => {"
NSQ_SOURCE_LINE 00000221 "        schema => ['array*', of => 'int*'],"
NSQ_SOURCE_LINE 00000222 "    },"
NSQ_SOURCE_LINE 00000223 "};"
NSQ_SOURCE_LINE 00000224 "sub gen_array {"
NSQ_SOURCE_LINE 00000225 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000226 "    my $len = int($args{len});"
NSQ_SOURCE_LINE 00000227 "    defined($len) or return [400, \"Please specify len\"];"
NSQ_SOURCE_LINE 00000228 "    $len = 1000 if $len > 1000;"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "    my $array = [];"
NSQ_SOURCE_LINE 00000231 "    for (1..$len) {"
NSQ_SOURCE_LINE 00000232 "        push @$array, int(rand()*$len)+1;"
NSQ_SOURCE_LINE 00000233 "    }"
NSQ_SOURCE_LINE 00000234 "    [200, \"OK\", $array];"
NSQ_SOURCE_LINE 00000235 "}"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "gen_modified_sub("
NSQ_SOURCE_LINE 00000238 "    output_name  => 'call_gen_array',"
NSQ_SOURCE_LINE 00000239 "    base_name    => 'gen_array',"
NSQ_SOURCE_LINE 00000240 "    summary      => 'Call gen_array()',"
NSQ_SOURCE_LINE 00000241 "    description  => <<'_',"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "This is to test nested call (e.g. Log::Any::For::Package)."
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "_"
NSQ_SOURCE_LINE 00000246 "    output_code  => sub {"
NSQ_SOURCE_LINE 00000247 "        # SUB: call_gen_array"
NSQ_SOURCE_LINE 00000248 "        # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000249 "        gen_array(@_);"
NSQ_SOURCE_LINE 00000250 "    },"
NSQ_SOURCE_LINE 00000251 ");"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "$SPEC{gen_hash} = {"
NSQ_SOURCE_LINE 00000254 "    v => 1.1,"
NSQ_SOURCE_LINE 00000255 "    summary => \"Generate a hash with specified number of pairs\","
NSQ_SOURCE_LINE 00000256 "    description => <<'_',"
