NSQ_SOURCE_LINE 00000282 "    }"
NSQ_SOURCE_LINE 00000283 "    [200, \"OK\", $hash];"
NSQ_SOURCE_LINE 00000284 "}"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "$SPEC{noop} = {"
NSQ_SOURCE_LINE 00000287 "    v => 1.1,"
NSQ_SOURCE_LINE 00000288 "    summary => \"Do nothing, return original argument\","
NSQ_SOURCE_LINE 00000289 "    description => <<'_',"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "Will also return argument passed to it."
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "This function is also marked as `pure`, meaning it will not cause any side"
NSQ_SOURCE_LINE 00000294 "effects. Pure functions are safe to call directly in a transaction (without"
NSQ_SOURCE_LINE 00000295 "going through the transaction manager) or during dry-run mode."
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "_"
NSQ_SOURCE_LINE 00000298 "    args => {"
NSQ_SOURCE_LINE 00000299 "        arg => {"
NSQ_SOURCE_LINE 00000300 "            summary => 'Argument',"
NSQ_SOURCE_LINE 00000301 "            schema => ['any'],"
NSQ_SOURCE_LINE 00000302 "            pos => 0,"
NSQ_SOURCE_LINE 00000303 "        },"
NSQ_SOURCE_LINE 00000304 "    },"
NSQ_SOURCE_LINE 00000305 "    features => {pure => 1},"
NSQ_SOURCE_LINE 00000306 "};"
NSQ_SOURCE_LINE 00000307 "sub noop {"
NSQ_SOURCE_LINE 00000308 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000309 "    [200, \"OK\", $args{arg}];"
NSQ_SOURCE_LINE 00000310 "}"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "$SPEC{noop2} = {"
NSQ_SOURCE_LINE 00000313 "    v => 1.1,"
NSQ_SOURCE_LINE 00000314 "    summary => \"Just like noop, but accepts several arguments\","
NSQ_SOURCE_LINE 00000315 "    description => <<'_',"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "Will return arguments passed to it."
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "This function is also marked as `pure`, meaning it will not cause any side"
NSQ_SOURCE_LINE 00000320 "effects. Pure functions are safe to call directly in a transaction (without"
NSQ_SOURCE_LINE 00000321 "going through the transaction manager) or during dry-run mode."
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "_"
NSQ_SOURCE_LINE 00000324 "    args => {"
NSQ_SOURCE_LINE 00000325 "        a => {"
NSQ_SOURCE_LINE 00000326 "            summary => 'Argument',"
