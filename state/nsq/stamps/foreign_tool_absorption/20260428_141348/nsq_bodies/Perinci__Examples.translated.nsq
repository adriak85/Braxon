NSQ_SOURCE_LINE 00000328 "            pos => 0,"
NSQ_SOURCE_LINE 00000329 "        },"
NSQ_SOURCE_LINE 00000330 "        b => {"
NSQ_SOURCE_LINE 00000331 "            summary => 'Argument',"
NSQ_SOURCE_LINE 00000332 "            schema => ['any'],"
NSQ_SOURCE_LINE 00000333 "            pos => 1,"
NSQ_SOURCE_LINE 00000334 "        },"
NSQ_SOURCE_LINE 00000335 "        c => {"
NSQ_SOURCE_LINE 00000336 "            summary => 'Argument',"
NSQ_SOURCE_LINE 00000337 "            schema => ['any'],"
NSQ_SOURCE_LINE 00000338 "            pos => 2,"
NSQ_SOURCE_LINE 00000339 "        },"
NSQ_SOURCE_LINE 00000340 "        d => {"
NSQ_SOURCE_LINE 00000341 "            summary => 'Argument',"
NSQ_SOURCE_LINE 00000342 "            schema => ['any'],"
NSQ_SOURCE_LINE 00000343 "            pos => 3,"
NSQ_SOURCE_LINE 00000344 "        },"
NSQ_SOURCE_LINE 00000345 "        e => {"
NSQ_SOURCE_LINE 00000346 "            summary => 'Argument',"
NSQ_SOURCE_LINE 00000347 "            schema => ['any'],"
NSQ_SOURCE_LINE 00000348 "            pos => 4,"
NSQ_SOURCE_LINE 00000349 "        },"
NSQ_SOURCE_LINE 00000350 "    },"
NSQ_SOURCE_LINE 00000351 "    features => {pure => 1},"
NSQ_SOURCE_LINE 00000352 "};"
NSQ_SOURCE_LINE 00000353 "sub noop2 {"
NSQ_SOURCE_LINE 00000354 "    no warnings 'uninitialized';"
NSQ_SOURCE_LINE 00000355 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000356 "    [200, \"OK\", \"a=$args{a}\\nb=$args{b}\\nc=$args{c}\\nd=$args{d}\\ne=$args{e}\"];"
