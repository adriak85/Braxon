NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "$SPEC{completion} = {"
NSQ_SOURCE_LINE 00000360 "    v => 1.1,"
NSQ_SOURCE_LINE 00000361 "    summary => \"Do nothing, return args\","
NSQ_SOURCE_LINE 00000362 "    description => <<'_',"
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "This function is used to test argument completion."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "_"
NSQ_SOURCE_LINE 00000367 "    args => {"
NSQ_SOURCE_LINE 00000368 "        arg0 => {"
NSQ_SOURCE_LINE 00000369 "            summary => 'Argument without any schema',"
NSQ_SOURCE_LINE 00000370 "            description => <<'_',"
NSQ_SOURCE_LINE 00000371 "_"
NSQ_SOURCE_LINE 00000372 "        },"
NSQ_SOURCE_LINE 00000373 "        i0 => {"
NSQ_SOURCE_LINE 00000374 "            summary => 'Integer with just \"int\" schema defined',"
NSQ_SOURCE_LINE 00000375 "            schema  => ['int*'],"
NSQ_SOURCE_LINE 00000376 "            description => <<'_',"
NSQ_SOURCE_LINE 00000377 "_"
NSQ_SOURCE_LINE 00000378 "        },"
NSQ_SOURCE_LINE 00000379 "        i1 => {"
NSQ_SOURCE_LINE 00000380 "            summary => 'Integer with min/xmax on the schema',"
NSQ_SOURCE_LINE 00000381 "            schema  => ['int*' => {min=>1, xmax=>100}],"
NSQ_SOURCE_LINE 00000382 "            pos => 0,"
NSQ_SOURCE_LINE 00000383 "            description => <<'_',"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "A completion library (like <pm:Perinci::Sub::Complete>) can generate a list of"
NSQ_SOURCE_LINE 00000386 "completion from the low end to the high end of the range, as long as it is not"
NSQ_SOURCE_LINE 00000387 "too long."
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "_"
NSQ_SOURCE_LINE 00000390 "        },"
NSQ_SOURCE_LINE 00000391 "        i2 => {"
NSQ_SOURCE_LINE 00000392 "            summary => 'Integer with large range min/max on the schema',"
NSQ_SOURCE_LINE 00000393 "            schema  => ['int*' => {min=>1, max=>1000}],"
NSQ_SOURCE_LINE 00000394 "            description => <<'_',"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "Unlike in `i1`, a completion library probably won't generate a number sequence"
NSQ_SOURCE_LINE 00000397 "for this argument because they are considered too long (1000+ items)."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "_"
NSQ_SOURCE_LINE 00000400 "        },"
NSQ_SOURCE_LINE 00000401 "        f0 => {"
NSQ_SOURCE_LINE 00000402 "            summary => 'Float with just \"float\" schema defined',"
NSQ_SOURCE_LINE 00000403 "            schema  => ['float*'],"
NSQ_SOURCE_LINE 00000404 "        },"
NSQ_SOURCE_LINE 00000405 "        f1 => {"
NSQ_SOURCE_LINE 00000406 "            summary => 'Float with xmin/xmax on the schema',"
NSQ_SOURCE_LINE 00000407 "            schema => ['float*' => {xmin=>1, xmax=>10}],"
NSQ_SOURCE_LINE 00000408 "            description => <<'_',"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "A completion library can attempt to provide some possible and incremental"
NSQ_SOURCE_LINE 00000411 "completion (e.g. if word is currently at one decimal digit like 1.2, it can"
NSQ_SOURCE_LINE 00000412 "provide completion of 1.20 .. 1.29)."
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "_"
NSQ_SOURCE_LINE 00000415 "        },"
NSQ_SOURCE_LINE 00000416 "        s1 => {"
NSQ_SOURCE_LINE 00000417 "            summary => 'String with possible values in \"in\" schema clause',"
NSQ_SOURCE_LINE 00000418 "            schema  => [str => {"
NSQ_SOURCE_LINE 00000419 "                in  => [qw/apple apricot banana grape grapefruit/,"
NSQ_SOURCE_LINE 00000420 "                        \"red date\", \"red grape\", \"green grape\","
NSQ_SOURCE_LINE 00000421 "                    ],"
NSQ_SOURCE_LINE 00000422 "            }],"
NSQ_SOURCE_LINE 00000423 "        },"
NSQ_SOURCE_LINE 00000424 "        s1b => {"
NSQ_SOURCE_LINE 00000425 "            summary => 'String with possible values in \"in\" schema clause, contains special characters',"
NSQ_SOURCE_LINE 00000426 "            description => <<'_',"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "This argument is intended to test how special characters are escaped."
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "_"
NSQ_SOURCE_LINE 00000431 "            schema  => [str => {"
NSQ_SOURCE_LINE 00000432 "                in  => ["
NSQ_SOURCE_LINE 00000433 "                    \"space: \","
NSQ_SOURCE_LINE 00000434 "                    \"word containing spaces\","
NSQ_SOURCE_LINE 00000435 "                    \"single-quote: '\","
NSQ_SOURCE_LINE 00000436 "                    'double-quote: \"',"
NSQ_SOURCE_LINE 00000437 "                    'slash/',"
NSQ_SOURCE_LINE 00000438 "                    'back\\\\slash',"
NSQ_SOURCE_LINE 00000439 "                    \"tab\\t\","
NSQ_SOURCE_LINE 00000440 "                    \"word:with:colon\","
NSQ_SOURCE_LINE 00000441 "                    \"dollar \\$sign\","
NSQ_SOURCE_LINE 00000442 "                    \"various parenthesis: [ ] { } ( )\","
NSQ_SOURCE_LINE 00000443 "                    \"tilde ~\","
NSQ_SOURCE_LINE 00000444 "                    'backtick `',"
NSQ_SOURCE_LINE 00000445 "                    'caret^',"
NSQ_SOURCE_LINE 00000446 "                    'at@',"
NSQ_SOURCE_LINE 00000447 "                    'pound#',"
NSQ_SOURCE_LINE 00000448 "                    'percent%',"
NSQ_SOURCE_LINE 00000449 "                    'ampersand&',"
NSQ_SOURCE_LINE 00000450 "                    'question?',"
NSQ_SOURCE_LINE 00000451 "                    'wildcard*',"
NSQ_SOURCE_LINE 00000452 "                    'comma,',"
NSQ_SOURCE_LINE 00000453 "                    'semicolon;',"
NSQ_SOURCE_LINE 00000454 "                    'pipe|',"
NSQ_SOURCE_LINE 00000455 "                    'redirection > <',"
NSQ_SOURCE_LINE 00000456 "                    'plus+',"
NSQ_SOURCE_LINE 00000457 "                ],"
NSQ_SOURCE_LINE 00000458 "            }],"
NSQ_SOURCE_LINE 00000459 "        },"
NSQ_SOURCE_LINE 00000460 "        s1c => {"
NSQ_SOURCE_LINE 00000461 "            summary => 'String with examples in schema',"
NSQ_SOURCE_LINE 00000462 "            schema  => [str => {"
NSQ_SOURCE_LINE 00000463 "                examples => ["
NSQ_SOURCE_LINE 00000464 "                    'bar',"
NSQ_SOURCE_LINE 00000465 "                    {value=>'baz', summary=>'foo'},"
NSQ_SOURCE_LINE 00000466 "                ],"
NSQ_SOURCE_LINE 00000467 "            }],"
NSQ_SOURCE_LINE 00000468 "        },"
NSQ_SOURCE_LINE 00000469 "        s1d => {"
NSQ_SOURCE_LINE 00000470 "            summary => 'String with examples in argument spec',"
NSQ_SOURCE_LINE 00000471 "            schema  => ['str'],"
NSQ_SOURCE_LINE 00000472 "            examples => ["
NSQ_SOURCE_LINE 00000473 "                'bar',"
NSQ_SOURCE_LINE 00000474 "                {value=>'baz', summary=>'foo'},"
NSQ_SOURCE_LINE 00000475 "            ],"
NSQ_SOURCE_LINE 00000476 "        },"
NSQ_SOURCE_LINE 00000477 "        s2 => {"
NSQ_SOURCE_LINE 00000478 "            summary => 'String with completion routine that generate random letter',"
NSQ_SOURCE_LINE 00000479 "            schema  => 'str',"
NSQ_SOURCE_LINE 00000480 "            completion => sub {"
NSQ_SOURCE_LINE 00000481 "                my %args = @_;"
NSQ_SOURCE_LINE 00000482 "                my $word = $args{word} // \"\";"
NSQ_SOURCE_LINE 00000483 "                [ map {$word . $_} \"a\"..\"z\" ],"
NSQ_SOURCE_LINE 00000484 "            },"
NSQ_SOURCE_LINE 00000485 "        },"
NSQ_SOURCE_LINE 00000486 "        s3 => {"
NSQ_SOURCE_LINE 00000487 "            summary => 'String with completion routine that dies',"
NSQ_SOURCE_LINE 00000488 "            schema  => 'str',"
NSQ_SOURCE_LINE 00000489 "            completion => sub { die },"
NSQ_SOURCE_LINE 00000490 "            description => <<'_',"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "Completion should not display error (except perhaps under debugging). It should"
NSQ_SOURCE_LINE 00000493 "just provide no completion."
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "_"
NSQ_SOURCE_LINE 00000496 "        },"
NSQ_SOURCE_LINE 00000497 "        a1 => {"
NSQ_SOURCE_LINE 00000498 "            summary => 'Array of strings, where the string has \"in\" schema clause',"
NSQ_SOURCE_LINE 00000499 "            schema  => [array => of => [str => {"
NSQ_SOURCE_LINE 00000500 "                in=>[qw/apple apricot banana grape grapefruit/,"
NSQ_SOURCE_LINE 00000501 "                     \"red date\", \"red grape\", \"green grape\","
NSQ_SOURCE_LINE 00000502 "                 ],"
NSQ_SOURCE_LINE 00000503 "            }]],"
NSQ_SOURCE_LINE 00000504 "            pos => 1,"
NSQ_SOURCE_LINE 00000505 "            slurpy => 1,"
NSQ_SOURCE_LINE 00000506 "            description => <<'_',"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "Completion library can perhaps complete from the `in` value and remember"
NSQ_SOURCE_LINE 00000509 "completed items when command-line option is repeated, e.g. in:"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "    --a1 <tab>"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "it will complete from any `in` value, but in:"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "    --a1 apple --a1 <tab>"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "it can exclude `apple` from the completion candidate."
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "Currently the completion library <pm:Perinci::Sub::Complete> does not do this"
NSQ_SOURCE_LINE 00000520 "though. Perhaps there can be an option to toggle this behavior."
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "_"
NSQ_SOURCE_LINE 00000523 "        },"
NSQ_SOURCE_LINE 00000524 "        a2 => {"
NSQ_SOURCE_LINE 00000525 "            summary => 'Array with element_completion routine that generate random letter',"
NSQ_SOURCE_LINE 00000526 "            schema  => ['array' => of => 'str'],"
NSQ_SOURCE_LINE 00000527 "            element_completion => sub {"
NSQ_SOURCE_LINE 00000528 "                my %args = @_;"
NSQ_SOURCE_LINE 00000529 "                my $word = $args{word} // \"\";"
NSQ_SOURCE_LINE 00000530 "                my $idx  = $args{index} // 0;"
NSQ_SOURCE_LINE 00000531 "                [ map {$word . $_ . $idx} \"a\"..\"z\" ],"
NSQ_SOURCE_LINE 00000532 "            },"
NSQ_SOURCE_LINE 00000533 "        },"
NSQ_SOURCE_LINE 00000534 "        a3 => {"
NSQ_SOURCE_LINE 00000535 "            summary => 'Array with element_completion routine that dies',"
NSQ_SOURCE_LINE 00000536 "            schema  => ['array' => of => 'str'],"
NSQ_SOURCE_LINE 00000537 "            element_completion => sub { die },"
NSQ_SOURCE_LINE 00000538 "            description => <<'_',"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "See also `s3`."
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "_"
NSQ_SOURCE_LINE 00000543 "        },"
NSQ_SOURCE_LINE 00000544 "        h1 => {"
NSQ_SOURCE_LINE 00000545 "            summary => 'Hash with \"keys\" and \"allowed_keys\" schema clauses and \"element_completion\" property',"
NSQ_SOURCE_LINE 00000546 "            schema  => ['hash', of=>'str', keys=>{k1=>\"str\", k2=>\"str\"}, allowed_keys=>[qw/k1 k2 k3 k4/]],"
NSQ_SOURCE_LINE 00000547 "            element_completion => sub {"
NSQ_SOURCE_LINE 00000548 "                my %args = @_;"
NSQ_SOURCE_LINE 00000549 "                my $word = $args{word} // \"\";"
NSQ_SOURCE_LINE 00000550 "                my $idx  = $args{index} // 0;"
NSQ_SOURCE_LINE 00000551 "                [ map {$word . $_ . $idx} \"a\"..\"e\" ],"
NSQ_SOURCE_LINE 00000552 "            },"
NSQ_SOURCE_LINE 00000553 "        },"
NSQ_SOURCE_LINE 00000554 "        h2 => {"
NSQ_SOURCE_LINE 00000555 "            summary => 'Hash with \"element_completion\" as well as \"index_completion\" properties',"
NSQ_SOURCE_LINE 00000556 "            schema  => ['hash', of=>'str'],"
NSQ_SOURCE_LINE 00000557 "            index_completion => [qw/k1 k2 k3 k4 k5 k6/],"
NSQ_SOURCE_LINE 00000558 "            element_completion => sub {"
NSQ_SOURCE_LINE 00000559 "                my %args = @_;"
NSQ_SOURCE_LINE 00000560 "                my $word = $args{word} // \"\";"
NSQ_SOURCE_LINE 00000561 "                my $idx  = $args{index} // 0;"
NSQ_SOURCE_LINE 00000562 "                [ map {$word . $_ . $idx} \"a\"..\"e\" ],"
NSQ_SOURCE_LINE 00000563 "            },"
NSQ_SOURCE_LINE 00000564 "        },"
NSQ_SOURCE_LINE 00000565 "    },"
NSQ_SOURCE_LINE 00000566 "};"
NSQ_SOURCE_LINE 00000567 "sub completion {"
NSQ_SOURCE_LINE 00000568 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000569 "    [200, \"OK\", \\%args];"
NSQ_SOURCE_LINE 00000570 "}"
NSQ_SOURCE_LINE 00000571 ""
NSQ_SOURCE_LINE 00000572 "$SPEC{sum} = {"
NSQ_SOURCE_LINE 00000573 "    v => 1.1,"
NSQ_SOURCE_LINE 00000574 "    summary => \"Sum numbers in array\","
NSQ_SOURCE_LINE 00000575 "    description => <<'_',"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "This function can be used to test passing nonscalar (array) arguments."
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "_"
NSQ_SOURCE_LINE 00000580 "    args => {"
NSQ_SOURCE_LINE 00000581 "        array => {"
NSQ_SOURCE_LINE 00000582 "            summary => 'Array',"
NSQ_SOURCE_LINE 00000583 "            schema  => ['array*', of => 'float*'],"
NSQ_SOURCE_LINE 00000584 "            req     => 1,"
NSQ_SOURCE_LINE 00000585 "            pos     => 0,"
NSQ_SOURCE_LINE 00000586 "            slurpy  => 1,"
NSQ_SOURCE_LINE 00000587 "            examples => [[1,2,3], []],"
NSQ_SOURCE_LINE 00000588 "        },"
NSQ_SOURCE_LINE 00000589 "        round => {"
NSQ_SOURCE_LINE 00000590 "            summary => 'Whether to round result to integer',"
NSQ_SOURCE_LINE 00000591 "            schema  => [bool => default => 0],"
NSQ_SOURCE_LINE 00000592 "        },"
NSQ_SOURCE_LINE 00000593 "    },"
NSQ_SOURCE_LINE 00000594 "    examples => ["
NSQ_SOURCE_LINE 00000595 "        {"
NSQ_SOURCE_LINE 00000596 "            summary => 'First example',"
NSQ_SOURCE_LINE 00000597 "            args    => {array=>[1, 2, 3]},"
NSQ_SOURCE_LINE 00000598 "            result  => [200, \"OK\", 6],"
NSQ_SOURCE_LINE 00000599 "        },"
NSQ_SOURCE_LINE 00000600 "        {"
NSQ_SOURCE_LINE 00000601 "            summary => 'Second example, using argv',"
NSQ_SOURCE_LINE 00000602 "            argv    => [qw/--round 1.1 2.1 3.1/],"
NSQ_SOURCE_LINE 00000603 "            result  => [200, \"OK\", 6],"
NSQ_SOURCE_LINE 00000604 "        },"
NSQ_SOURCE_LINE 00000605 "        {"
NSQ_SOURCE_LINE 00000606 "            summary => 'Third example, invalid arguments',"
NSQ_SOURCE_LINE 00000607 "            args    => {array=>[qw/a/]},"
NSQ_SOURCE_LINE 00000608 "            status  => 400,"
NSQ_SOURCE_LINE 00000609 "        },"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "        {"
NSQ_SOURCE_LINE 00000612 "            summary   => 'Total numbers found in a file (4th example, bash)',"
NSQ_SOURCE_LINE 00000613 "            src       => q(grep '[0-9]' file.txt | xargs sum),"
NSQ_SOURCE_LINE 00000614 "            src_plang => 'bash',"
NSQ_SOURCE_LINE 00000615 "        },"
NSQ_SOURCE_LINE 00000616 "        {"
NSQ_SOURCE_LINE 00000617 "            summary   => '2-dice roll (5th example, perl)',"
NSQ_SOURCE_LINE 00000618 "            src       => <<'EOT',"
NSQ_SOURCE_LINE 00000619 "my $res = sum(array=>[map {int(rand()*6+1)} 1..2]);"
NSQ_SOURCE_LINE 00000620 "say $res->[2] >= 6 ? \"high\" : \"low\";"
NSQ_SOURCE_LINE 00000621 "EOT"
NSQ_SOURCE_LINE 00000622 "            src_plang => 'perl',"
NSQ_SOURCE_LINE 00000623 "        },"
NSQ_SOURCE_LINE 00000624 "    ],"
NSQ_SOURCE_LINE 00000625 "    features => {},"
NSQ_SOURCE_LINE 00000626 "};"
NSQ_SOURCE_LINE 00000627 "sub sum {"
NSQ_SOURCE_LINE 00000628 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "    my $sum = 0;"
NSQ_SOURCE_LINE 00000631 "    for (@{$args{array}}) {"
NSQ_SOURCE_LINE 00000632 "        $sum += $_ if defined && looks_like_number($_);"
NSQ_SOURCE_LINE 00000633 "    }"
NSQ_SOURCE_LINE 00000634 "    $sum = int($sum) if $args{round};"
NSQ_SOURCE_LINE 00000635 "    [200, \"OK\", $sum];"
NSQ_SOURCE_LINE 00000636 "}"
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "$SPEC{merge_hash} = {"
NSQ_SOURCE_LINE 00000639 "    v => 1.1,"
NSQ_SOURCE_LINE 00000640 "    summary => \"Merge two hashes\","
NSQ_SOURCE_LINE 00000641 "    description => <<'_',"
NSQ_SOURCE_LINE 00000642 ""
NSQ_SOURCE_LINE 00000643 "This function can be used to test passing nonscalar (hash) arguments."
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "This function also tests the `x.perinci.sub.wrapper.disable_validate_args`"
NSQ_SOURCE_LINE 00000646 "attribute so that <pm:Perinci::Sub::Wrapper> does not generate argument"
NSQ_SOURCE_LINE 00000647 "validation code in the wrapper. Note that by adding `# VALIDATE_ARG` in the"
NSQ_SOURCE_LINE 00000648 "source code, the <pm:Dist::Zilla::Plugin::Rinci::Wrap> plugin already generates"
NSQ_SOURCE_LINE 00000649 "and embeds argument validation code in the source code, so duplication is not"
NSQ_SOURCE_LINE 00000650 "desired, thus the attribute."
NSQ_SOURCE_LINE 00000651 ""
NSQ_SOURCE_LINE 00000652 "_"
NSQ_SOURCE_LINE 00000653 "    args => {"
NSQ_SOURCE_LINE 00000654 "        h1 => {"
NSQ_SOURCE_LINE 00000655 "            summary => 'First hash (left-hand side)',"
NSQ_SOURCE_LINE 00000656 "            schema => ['hash*'],"
NSQ_SOURCE_LINE 00000657 "            req => 1,"
NSQ_SOURCE_LINE 00000658 "            pos => 0,"
NSQ_SOURCE_LINE 00000659 "        },"
NSQ_SOURCE_LINE 00000660 "        h2 => {"
NSQ_SOURCE_LINE 00000661 "            summary => 'First hash (right-hand side)',"
NSQ_SOURCE_LINE 00000662 "            schema => ['hash*'],"
NSQ_SOURCE_LINE 00000663 "            req => 1,"
NSQ_SOURCE_LINE 00000664 "            pos => 1,"
NSQ_SOURCE_LINE 00000665 "        },"
NSQ_SOURCE_LINE 00000666 "    },"
NSQ_SOURCE_LINE 00000667 "    result => {"
NSQ_SOURCE_LINE 00000668 "        schema => 'hash*',"
NSQ_SOURCE_LINE 00000669 "    },"
NSQ_SOURCE_LINE 00000670 "    features => {},"
NSQ_SOURCE_LINE 00000671 "    \"x.perinci.sub.wrapper.disable_validate_args\" => 1,"
NSQ_SOURCE_LINE 00000672 "};"
NSQ_SOURCE_LINE 00000673 "sub merge_hash {"
NSQ_SOURCE_LINE 00000674 "    my %args = @_;"
NSQ_SOURCE_LINE 00000675 "    my $h1 = $args{h1}; my $arg_err; { no warnings ('void');((defined($h1)) ? 1 : (($arg_err //= \"Required but not specified\"),0)) && ((ref($h1) eq 'HASH') ? 1 : (($arg_err //= \"Not of type hash\"),0)); if ($arg_err) { return [400, \"Invalid argument value for h1: $arg_err\"] } } # VALIDATE_ARG"
NSQ_SOURCE_LINE 00000676 "    my $h2 = $args{h2}; { no warnings ('void');((defined($h2)) ? 1 : (($arg_err //= \"Required but not specified\"),0)) && ((ref($h2) eq 'HASH') ? 1 : (($arg_err //= \"Not of type hash\"),0)); if ($arg_err) { return [400, \"Invalid argument value for h2: $arg_err\"] } } # VALIDATE_ARG"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "    [200, \"OK\", {%$h1, %$h2}];"
NSQ_SOURCE_LINE 00000679 "}"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "$SPEC{validate_args} = {"
NSQ_SOURCE_LINE 00000682 "    v => 1.1,"
NSQ_SOURCE_LINE 00000683 "    summary => \"Does nothing, only here to test # VALIDATE_ARGS\","
NSQ_SOURCE_LINE 00000684 "    args => {"
NSQ_SOURCE_LINE 00000685 "        a => {"
NSQ_SOURCE_LINE 00000686 "            schema => \"int\","
NSQ_SOURCE_LINE 00000687 "        },"
NSQ_SOURCE_LINE 00000688 "        b => {"
NSQ_SOURCE_LINE 00000689 "            schema => [str => {min_len=>2}],"
NSQ_SOURCE_LINE 00000690 "        },"
NSQ_SOURCE_LINE 00000691 "        h1 => { # same as in merge_hash"
NSQ_SOURCE_LINE 00000692 "            schema => 'hash',"
NSQ_SOURCE_LINE 00000693 "        },"
NSQ_SOURCE_LINE 00000694 "    },"
NSQ_SOURCE_LINE 00000695 "    result => {"
NSQ_SOURCE_LINE 00000696 "        schema => 'str*',"
NSQ_SOURCE_LINE 00000697 "    },"
NSQ_SOURCE_LINE 00000698 "    features => {},"
NSQ_SOURCE_LINE 00000699 "    \"x.perinci.sub.wrapper.disable_validate_args\" => 1,"
NSQ_SOURCE_LINE 00000700 "};"
NSQ_SOURCE_LINE 00000701 "sub validate_args {"
NSQ_SOURCE_LINE 00000702 "    my %args = @_; my $arg_err; { no warnings ('void');require Scalar::Util::Numeric;if (exists($args{'a'})) { (!defined($args{'a'}) ? 1 :  ((Scalar::Util::Numeric::isint($args{'a'})) ? 1 : (($arg_err //= \"Not of type integer\"),0))); if ($arg_err) { return [400, \"Invalid argument value for a: $arg_err\"] } }no warnings ('void');if (exists($args{'b'})) { (!defined($args{'b'}) ? 1 :  ((!ref($args{'b'})) ? 1 : (($arg_err //= \"Not of type text\"),0)) && ((length($args{'b'}) >= 2) ? 1 : (($arg_err //= \"Length must be at least 2\"),0))); if ($arg_err) { return [400, \"Invalid argument value for b: $arg_err\"] } }no warnings ('void');if (exists($args{'h1'})) { (!defined($args{'h1'}) ? 1 :  ((ref($args{'h1'}) eq 'HASH') ? 1 : (($arg_err //= \"Not of type hash\"),0))); if ($arg_err) { return [400, \"Invalid argument value for h1: $arg_err\"] } }} # VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000703 "    [200];"
NSQ_SOURCE_LINE 00000704 "}"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "$SPEC{undescribed_args} = {"
NSQ_SOURCE_LINE 00000707 "    v => 1.1,"
NSQ_SOURCE_LINE 00000708 "    summary => 'This function has several undescribed args',"
NSQ_SOURCE_LINE 00000709 "    description => <<'_',"
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "Originally added to see how peri-func-usage or <pm:Perinci::To::Text> will"
NSQ_SOURCE_LINE 00000712 "display the usage or documentation for this function."
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "_"
NSQ_SOURCE_LINE 00000715 "    args => {"
NSQ_SOURCE_LINE 00000716 "        arg1 => {},"
NSQ_SOURCE_LINE 00000717 "        arg2 => {},"
NSQ_SOURCE_LINE 00000718 "        arg3 => {},"
NSQ_SOURCE_LINE 00000719 "        arg4 => {"
NSQ_SOURCE_LINE 00000720 "            cmdline_aliases => {A=>{}},"
NSQ_SOURCE_LINE 00000721 "        },"
NSQ_SOURCE_LINE 00000722 "    },"
NSQ_SOURCE_LINE 00000723 "};"
NSQ_SOURCE_LINE 00000724 "sub undescribed_args {"
NSQ_SOURCE_LINE 00000725 "    # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000726 "    [200];"
NSQ_SOURCE_LINE 00000727 "}"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "$SPEC{arg_default} = {"
NSQ_SOURCE_LINE 00000730 "    v => 1.1,"
NSQ_SOURCE_LINE 00000731 "    summary => 'Demonstrate argument default value from default and/or schema',"
NSQ_SOURCE_LINE 00000732 "    description => <<'_',"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "Default value can be specified in the `default` property of argument"
NSQ_SOURCE_LINE 00000735 "specification, e.g.:"
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "    args => {"
NSQ_SOURCE_LINE 00000738 "        arg1 => { schema=>'str', default=>'blah' },"
NSQ_SOURCE_LINE 00000739 "    },"
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "or in the `default` clause of the argument's schema, e.g.:"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "    args => {"
NSQ_SOURCE_LINE 00000744 "        arg1 => { schema=>['str', default=>'blah'] },"
NSQ_SOURCE_LINE 00000745 "    },"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "or even both. The `default` property in argument specification takes precedence."
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "_"
NSQ_SOURCE_LINE 00000750 "    args => {"
NSQ_SOURCE_LINE 00000751 "        a => {"
NSQ_SOURCE_LINE 00000752 "            summary => 'No defaults',"
NSQ_SOURCE_LINE 00000753 "            schema  => ['int'],"
NSQ_SOURCE_LINE 00000754 "        },"
NSQ_SOURCE_LINE 00000755 "        b => {"
NSQ_SOURCE_LINE 00000756 "            summary => 'Default from \"default\" property',"
NSQ_SOURCE_LINE 00000757 "            default => 2,"
NSQ_SOURCE_LINE 00000758 "            schema  => ['int'],"
NSQ_SOURCE_LINE 00000759 "        },"
NSQ_SOURCE_LINE 00000760 "        c => {"
NSQ_SOURCE_LINE 00000761 "            summary => 'Default from schema',"
NSQ_SOURCE_LINE 00000762 "            schema  => ['int', default => 3],"
NSQ_SOURCE_LINE 00000763 "        },"
NSQ_SOURCE_LINE 00000764 "        d => {"
NSQ_SOURCE_LINE 00000765 "            summary => 'Default from \"default\" property as well as schema',"
NSQ_SOURCE_LINE 00000766 "            description => <<'_',"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "\"Default\" property overrides default value from schema."
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "_"
NSQ_SOURCE_LINE 00000771 "            default => 4,"
NSQ_SOURCE_LINE 00000772 "            schema  => ['int', default=>-4],"
NSQ_SOURCE_LINE 00000773 "        },"
NSQ_SOURCE_LINE 00000774 "    },"
NSQ_SOURCE_LINE 00000775 "};"
NSQ_SOURCE_LINE 00000776 "sub arg_default {"
NSQ_SOURCE_LINE 00000777 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000778 "    [200, \"OK\", join(\"\\n\", map { \"$_=\" . ($args{$_} // \"\") } (qw/a b c d/))];"
NSQ_SOURCE_LINE 00000779 "}"
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "$SPEC{return_args} = {"
NSQ_SOURCE_LINE 00000782 "    v => 1.1,"
NSQ_SOURCE_LINE 00000783 "    summary => \"Return arguments\","
NSQ_SOURCE_LINE 00000784 "    description => <<'_',"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 "Can be useful to check what arguments the function gets. Aside from normal"
NSQ_SOURCE_LINE 00000787 "arguments, sometimes function will receive special arguments (those prefixed"
NSQ_SOURCE_LINE 00000788 "with dash, `-`)."
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "_"
NSQ_SOURCE_LINE 00000791 "    args => {"
NSQ_SOURCE_LINE 00000792 "        arg => {"
NSQ_SOURCE_LINE 00000793 "            summary => 'Argument',"
NSQ_SOURCE_LINE 00000794 "            schema => ['any'],"
NSQ_SOURCE_LINE 00000795 "            pos => 0,"
NSQ_SOURCE_LINE 00000796 "        },"
NSQ_SOURCE_LINE 00000797 "    },"
NSQ_SOURCE_LINE 00000798 "};"
NSQ_SOURCE_LINE 00000799 "sub return_args {"
NSQ_SOURCE_LINE 00000800 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000801 "    log_trace(\"return_args() is called with arguments: %s\", \\%args);"
NSQ_SOURCE_LINE 00000802 "    [200, \"OK\", \\%args];"
NSQ_SOURCE_LINE 00000803 "}"
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "$SPEC{common_opts} = {"
NSQ_SOURCE_LINE 00000806 "    v => 1.1,"
NSQ_SOURCE_LINE 00000807 "    summary => 'This function has arguments with the same name as Perinci::CmdLine common options',"
NSQ_SOURCE_LINE 00000808 "    args => {"
NSQ_SOURCE_LINE 00000809 "        help    => { schema => 'bool' },"
NSQ_SOURCE_LINE 00000810 "        format  => { schema => 'str'  },"
NSQ_SOURCE_LINE 00000811 "        format_options => { schema => 'str'  },"
NSQ_SOURCE_LINE 00000812 "        action  => { schema => 'str'  },"
NSQ_SOURCE_LINE 00000813 "        version => { schema => 'str'  },"
NSQ_SOURCE_LINE 00000814 "        json    => { schema => 'bool' },"
NSQ_SOURCE_LINE 00000815 "        yaml    => { schema => 'bool' },"
NSQ_SOURCE_LINE 00000816 "        perl    => { schema => 'bool' },"
NSQ_SOURCE_LINE 00000817 "        subcommands => { schema => 'str'  },"
NSQ_SOURCE_LINE 00000818 "        cmd     => { schema => 'str'  },"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "        quiet   => { schema => 'bool' },"
NSQ_SOURCE_LINE 00000821 "        verbose => { schema => 'bool' },"
NSQ_SOURCE_LINE 00000822 "        debug   => { schema => 'bool' },"
NSQ_SOURCE_LINE 00000823 "        trace   => { schema => 'bool' },"
NSQ_SOURCE_LINE 00000824 "        log_level => { schema => 'str' },"
NSQ_SOURCE_LINE 00000825 "    },"
NSQ_SOURCE_LINE 00000826 "};"
NSQ_SOURCE_LINE 00000827 "sub common_opts {"
NSQ_SOURCE_LINE 00000828 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000829 "    [200, \"OK\", \\%args];"
NSQ_SOURCE_LINE 00000830 "}"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "$SPEC{gen_sample_data} = {"
NSQ_SOURCE_LINE 00000833 "    v => 1.1,"
NSQ_SOURCE_LINE 00000834 "    summary => \"Generate sample data of various form\","
NSQ_SOURCE_LINE 00000835 "    description => <<'_',"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "This function is first written to test <pm:Perinci::CmdLine::Lite>'s text"
NSQ_SOURCE_LINE 00000838 "formatting rules."
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "_"
NSQ_SOURCE_LINE 00000841 "    args => {"
NSQ_SOURCE_LINE 00000842 "        form => {"
NSQ_SOURCE_LINE 00000843 "            schema => ['str*' => in => [qw/undef scalar aos aoaos aohos"
NSQ_SOURCE_LINE 00000844 "                                           hos hohos/]],"
NSQ_SOURCE_LINE 00000845 "            description => <<'_',"
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "* aos is array of scalar, e.g. `[1,2,3]`."
NSQ_SOURCE_LINE 00000848 "* aoaos is array of aos, e.g. `[ [1,2,3], [4,5,6] ]`."
NSQ_SOURCE_LINE 00000849 "* hos is hash of scalar (values), e.g. `{a=>1, b=>2}`."
NSQ_SOURCE_LINE 00000850 "* aohos is array of array of hos, e.g. `[{a=>1,b=>2}, {a=>2}]`."
NSQ_SOURCE_LINE 00000851 "* hohos is hash of hos as values, e.g. `{row1=>{a=>1,b=>2}, row2=>{}}`."
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "The `aoaos` and `aohos` forms are commonly used for table data."
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "_"
NSQ_SOURCE_LINE 00000856 "            req => 1,"
NSQ_SOURCE_LINE 00000857 "            pos => 0,"
NSQ_SOURCE_LINE 00000858 "        },"
NSQ_SOURCE_LINE 00000859 "    },"
NSQ_SOURCE_LINE 00000860 "    result => {"
NSQ_SOURCE_LINE 00000861 "    },"
NSQ_SOURCE_LINE 00000862 "};"
NSQ_SOURCE_LINE 00000863 "sub gen_sample_data {"
NSQ_SOURCE_LINE 00000864 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000865 "    my $form = $args{form};"
NSQ_SOURCE_LINE 00000866 ""
NSQ_SOURCE_LINE 00000867 "    my $data;"
NSQ_SOURCE_LINE 00000868 "    if ($form eq 'undef') {"
NSQ_SOURCE_LINE 00000869 "        $data = undef;"
NSQ_SOURCE_LINE 00000870 "    } elsif ($form eq 'scalar') {"
NSQ_SOURCE_LINE 00000871 "        $data = 'Sample data';"
NSQ_SOURCE_LINE 00000872 "    } elsif ($form eq 'aos') {"
NSQ_SOURCE_LINE 00000873 "        $data = [qw/one two three four five/];"
NSQ_SOURCE_LINE 00000874 "    } elsif ($form eq 'aoaos') {"
NSQ_SOURCE_LINE 00000875 "        $data = [[qw/This is the first row/],"
NSQ_SOURCE_LINE 00000876 "                 [qw/This is the second row/],"
NSQ_SOURCE_LINE 00000877 "                 [qw/The third row this is/]];"
NSQ_SOURCE_LINE 00000878 "    } elsif ($form eq 'aohos') {"
NSQ_SOURCE_LINE 00000879 "        $data = ["
NSQ_SOURCE_LINE 00000880 "            {field1=>11, field2=>12},"
NSQ_SOURCE_LINE 00000881 "            {field1=>21, field3=>23},"
NSQ_SOURCE_LINE 00000882 "            {field1=>31, field2=>32, field3=>33},"
NSQ_SOURCE_LINE 00000883 "            {field2=>42},"
NSQ_SOURCE_LINE 00000884 "        ];"
NSQ_SOURCE_LINE 00000885 "    } elsif ($form eq 'hos') {"
NSQ_SOURCE_LINE 00000886 "        $data = {"
NSQ_SOURCE_LINE 00000887 "            key => 1,"
NSQ_SOURCE_LINE 00000888 "            key2 => 2,"
NSQ_SOURCE_LINE 00000889 "            key3 => 3,"
NSQ_SOURCE_LINE 00000890 "            key4 => 4,"
NSQ_SOURCE_LINE 00000891 "            key5 => 5,"
NSQ_SOURCE_LINE 00000892 "        };"
NSQ_SOURCE_LINE 00000893 "    } elsif ($form eq 'hohos') {"
NSQ_SOURCE_LINE 00000894 "        $data = {"
NSQ_SOURCE_LINE 00000895 "            {hashid=>1, key=>1},"
NSQ_SOURCE_LINE 00000896 "            {hashid=>2, key2=>2},"
NSQ_SOURCE_LINE 00000897 "        };"
NSQ_SOURCE_LINE 00000898 "    }"
NSQ_SOURCE_LINE 00000899 "    [200, \"OK\", $data];"
NSQ_SOURCE_LINE 00000900 "}"
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "$SPEC{args_as_array} = {"
NSQ_SOURCE_LINE 00000903 "    v => 1.1,"
NSQ_SOURCE_LINE 00000904 "    args_as => 'array',"
NSQ_SOURCE_LINE 00000905 "    description => <<'_',"
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "This function's metadata sets `args_as` property to `array`. This means it wants"
NSQ_SOURCE_LINE 00000908 "to accept argument as an array, like a regular Perl subroutine accepting"
NSQ_SOURCE_LINE 00000909 "positional arguments in `@_`."
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "_"
NSQ_SOURCE_LINE 00000912 "    args => {"
NSQ_SOURCE_LINE 00000913 "        a0 => { pos=>0, schema=>'str*' },"
NSQ_SOURCE_LINE 00000914 "        a1 => { pos=>1, schema=>'str*' },"
NSQ_SOURCE_LINE 00000915 "        a2 => { pos=>2, schema=>'str*' },"
NSQ_SOURCE_LINE 00000916 "    },"
NSQ_SOURCE_LINE 00000917 "};"
NSQ_SOURCE_LINE 00000918 "sub args_as_array {"
NSQ_SOURCE_LINE 00000919 "    # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000920 "    [200, \"OK\", \\@_];"
NSQ_SOURCE_LINE 00000921 "}"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 "$SPEC{args_as_arrayref} = {"
NSQ_SOURCE_LINE 00000924 "    v => 1.1,"
NSQ_SOURCE_LINE 00000925 "    args_as => 'arrayref',"
NSQ_SOURCE_LINE 00000926 "    description => <<'_',"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "This function's metadata sets `args_as` property to `arrayref`. This is just"
NSQ_SOURCE_LINE 00000929 "like `array`, except the whole argument list is passed in `$_[0]`."
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "_"
NSQ_SOURCE_LINE 00000932 "    args => {"
NSQ_SOURCE_LINE 00000933 "        a0 => { pos=>0, schema=>'str*' },"
NSQ_SOURCE_LINE 00000934 "        a1 => { pos=>1, schema=>'str*' },"
NSQ_SOURCE_LINE 00000935 "        a2 => { pos=>2, schema=>'str*' },"
NSQ_SOURCE_LINE 00000936 "    },"
NSQ_SOURCE_LINE 00000937 "};"
NSQ_SOURCE_LINE 00000938 "sub args_as_arrayref {"
NSQ_SOURCE_LINE 00000939 "     # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000940 "    [200, \"OK\", $_[0]];"
NSQ_SOURCE_LINE 00000941 "}"
NSQ_SOURCE_LINE 00000942 ""
NSQ_SOURCE_LINE 00000943 "$SPEC{args_as_hashref} = {"
NSQ_SOURCE_LINE 00000944 "    v => 1.1,"
NSQ_SOURCE_LINE 00000945 "    args_as => 'hashref',"
NSQ_SOURCE_LINE 00000946 "    description => <<'_',"
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "This function's metadata sets `args_as` property to `hashref`. This is just like"
NSQ_SOURCE_LINE 00000949 "`hash`, except the whole argument hash is passed in `$_[0]`."
NSQ_SOURCE_LINE 00000950 ""
NSQ_SOURCE_LINE 00000951 "_"
NSQ_SOURCE_LINE 00000952 "    args => {"
NSQ_SOURCE_LINE 00000953 "        a0 => { schema=>'str*' },"
NSQ_SOURCE_LINE 00000954 "        a1 => { schema=>'str*' },"
NSQ_SOURCE_LINE 00000955 "    },"
NSQ_SOURCE_LINE 00000956 "};"
NSQ_SOURCE_LINE 00000957 "sub args_as_hashref {"
NSQ_SOURCE_LINE 00000958 "    my $args = shift; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000959 "    [200, \"OK\", $args];"
NSQ_SOURCE_LINE 00000960 "}"
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "$SPEC{result_naked} = {"
NSQ_SOURCE_LINE 00000963 "    v => 1.1,"
NSQ_SOURCE_LINE 00000964 "    description => <<'_',"
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "This function's metadata sets `result_naked` to true. This means function"
NSQ_SOURCE_LINE 00000967 "returns just the value (e.g. `42`) and not with envelope (e.g. `[200,\"OK\",42]`)."
NSQ_SOURCE_LINE 00000968 "However, when served over network Riap protocol, the function wrapper"
NSQ_SOURCE_LINE 00000969 "<pm:Perinci::Sub::Wrapper> can generate an envelope for the result, so the"
NSQ_SOURCE_LINE 00000970 "wrapped function wil still return `[200,\"OK\",42]`."
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "_"
NSQ_SOURCE_LINE 00000973 "    args => {"
NSQ_SOURCE_LINE 00000974 "        a0 => { schema=>'str*' },"
NSQ_SOURCE_LINE 00000975 "        a1 => { schema=>'str*' },"
NSQ_SOURCE_LINE 00000976 "    },"
NSQ_SOURCE_LINE 00000977 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000978 "};"
NSQ_SOURCE_LINE 00000979 "sub result_naked {"
NSQ_SOURCE_LINE 00000980 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00000981 "    \\%args;"
NSQ_SOURCE_LINE 00000982 "}"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "$SPEC{dry_run} = {"
NSQ_SOURCE_LINE 00000985 "    v => 1.1,"
NSQ_SOURCE_LINE 00000986 "    summary => \"Will return 'wet' if not run under dry run mode, or 'dry' if dry run\","
NSQ_SOURCE_LINE 00000987 "    description => <<'_',"
NSQ_SOURCE_LINE 00000988 ""
NSQ_SOURCE_LINE 00000989 "The way you detect whether we are running under dry-run mode is to check the"
NSQ_SOURCE_LINE 00000990 "special argument `$args{-dry_run}`."
NSQ_SOURCE_LINE 00000991 ""
NSQ_SOURCE_LINE 00000992 "_"
NSQ_SOURCE_LINE 00000993 "    args => {"
NSQ_SOURCE_LINE 00000994 "    },"
NSQ_SOURCE_LINE 00000995 "    features => {"
NSQ_SOURCE_LINE 00000996 "        dry_run => 1,"
NSQ_SOURCE_LINE 00000997 "    },"
NSQ_SOURCE_LINE 00000998 "};"
NSQ_SOURCE_LINE 00000999 "sub dry_run {"
NSQ_SOURCE_LINE 00001000 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00001001 "    if ($args{-dry_run}) {"
NSQ_SOURCE_LINE 00001002 "        return [200, \"OK\", \"dry\"];"
NSQ_SOURCE_LINE 00001003 "    } else {"
NSQ_SOURCE_LINE 00001004 "        return [200, \"OK\", \"wet\"];"
NSQ_SOURCE_LINE 00001005 "    }"
NSQ_SOURCE_LINE 00001006 "}"
NSQ_SOURCE_LINE 00001007 ""
NSQ_SOURCE_LINE 00001008 "$SPEC{dry_run_default} = {"
NSQ_SOURCE_LINE 00001009 "    v => 1.1,"
NSQ_SOURCE_LINE 00001010 "    summary => \"Will return 'wet' if not run under dry run mode, or 'dry' if dry run\","
NSQ_SOURCE_LINE 00001011 "    description => <<'_',"
NSQ_SOURCE_LINE 00001012 ""
NSQ_SOURCE_LINE 00001013 "This function is like `dry_run`, except the default mode is dry-run."
NSQ_SOURCE_LINE 00001014 ""
NSQ_SOURCE_LINE 00001015 "The way you detect whether we are running under dry-run mode is to check the"
NSQ_SOURCE_LINE 00001016 "special argument `$args{-dry_run}`."
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "_"
NSQ_SOURCE_LINE 00001019 "    args => {"
NSQ_SOURCE_LINE 00001020 "    },"
NSQ_SOURCE_LINE 00001021 "    features => {"
NSQ_SOURCE_LINE 00001022 "        dry_run => {default=>1},"
NSQ_SOURCE_LINE 00001023 "    },"
NSQ_SOURCE_LINE 00001024 "};"
NSQ_SOURCE_LINE 00001025 "sub dry_run_default {"
NSQ_SOURCE_LINE 00001026 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00001027 "    if ($args{-dry_run}) {"
NSQ_SOURCE_LINE 00001028 "        return [200, \"OK\", \"dry\"];"
NSQ_SOURCE_LINE 00001029 "    } else {"
NSQ_SOURCE_LINE 00001030 "        return [200, \"OK\", \"wet\"];"
NSQ_SOURCE_LINE 00001031 "    }"
NSQ_SOURCE_LINE 00001032 "}"
NSQ_SOURCE_LINE 00001033 ""
NSQ_SOURCE_LINE 00001034 "$SPEC{binary} = {"
NSQ_SOURCE_LINE 00001035 "    v => 1.1,"
NSQ_SOURCE_LINE 00001036 "    summary => \"Accept and send binary data\","
NSQ_SOURCE_LINE 00001037 "    description => <<'_',"
NSQ_SOURCE_LINE 00001038 ""
NSQ_SOURCE_LINE 00001039 "This function sets its argument's schema type as `buf` which indicates the"
NSQ_SOURCE_LINE 00001040 "argument accepts binary data. Likewise it also sets its result's schema type as"
NSQ_SOURCE_LINE 00001041 "`buf` which says that function will return binary data."
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "The function just returns its argument."
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "Note that since the metadata also contains null (\"\\0\") in the `default` property"
NSQ_SOURCE_LINE 00001046 "of the argument specification, the metadata is also not JSON-safe."
NSQ_SOURCE_LINE 00001047 ""
NSQ_SOURCE_LINE 00001048 "To pass binary data over JSON/Riap, you can use Riap version 1.2 and encode the"
NSQ_SOURCE_LINE 00001049 "argument with \":base64\" suffix, e.g.:"
NSQ_SOURCE_LINE 00001050 ""
NSQ_SOURCE_LINE 00001051 "    $res = Perinci::Access->new->request("
NSQ_SOURCE_LINE 00001052 "        call => \"http://example.com/api/Perinci/Examples/binary\","
NSQ_SOURCE_LINE 00001053 "        {v=>1.2, args=>{\"data:base64\"=>\"/wA=\"}}); # send \"\\xff\\0\""
NSQ_SOURCE_LINE 00001054 ""
NSQ_SOURCE_LINE 00001055 "Without `v=>1.2`, encoded argument won't be decoded by the server."
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "To pass binary data on the command-line, you can use `--ARG-base64` if the"
NSQ_SOURCE_LINE 00001058 "command-line library provides it."
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "To receive binary result over JSON/Riap, you can use Riap version 1.2 which will"
NSQ_SOURCE_LINE 00001061 "automatically encode binary data with base64 so it is safe when transformed as"
NSQ_SOURCE_LINE 00001062 "JSON. The client library will also decode the encoded result back to the"
NSQ_SOURCE_LINE 00001063 "original, so the whole process is transparent to you:"
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "    $res = Perinci::Access->new->request("
NSQ_SOURCE_LINE 00001066 "        call => \"http://example.com/api/Perinci/Examples/binary\","
NSQ_SOURCE_LINE 00001067 "        {v=>1.2}); # => [200,\"OK\",\"\\0\\0\\0\",{}]"
NSQ_SOURCE_LINE 00001068 ""
NSQ_SOURCE_LINE 00001069 "_"
NSQ_SOURCE_LINE 00001070 "    args => {"
NSQ_SOURCE_LINE 00001071 "        data => {schema=>\"buf*\", default=>\"\\0\\0\\0\"},"
NSQ_SOURCE_LINE 00001072 "    },"
NSQ_SOURCE_LINE 00001073 "    result => {"
NSQ_SOURCE_LINE 00001074 "        schema => \"buf*\","
NSQ_SOURCE_LINE 00001075 "    },"
NSQ_SOURCE_LINE 00001076 "};"
NSQ_SOURCE_LINE 00001077 "sub binary {"
NSQ_SOURCE_LINE 00001078 "    my %args = @_; # NO_VALIDATE_ARGS"
NSQ_SOURCE_LINE 00001079 "    my $data = $args{data} // \"\\0\\0\\0\";"
NSQ_SOURCE_LINE 00001080 "    return [200, \"OK\", $data];"
NSQ_SOURCE_LINE 00001081 "}"
NSQ_SOURCE_LINE 00001082 ""
NSQ_SOURCE_LINE 00001083 "$SPEC{gen_random_bytes} = {"
NSQ_SOURCE_LINE 00001084 "    v => 1.1,"
NSQ_SOURCE_LINE 00001085 "    summary => \"Generate random bytes of specified length\","
NSQ_SOURCE_LINE 00001086 "    description => <<'_',"
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "This function can also be used to test binary data and Riap 1.2."
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "By default it will generate 1K worth of random garbage."
NSQ_SOURCE_LINE 00001091 ""
NSQ_SOURCE_LINE 00001092 "_"
NSQ_SOURCE_LINE 00001093 "    args => {"
NSQ_SOURCE_LINE 00001094 "        len => {schema=>['int*', min=>0], default=>1024},"
NSQ_SOURCE_LINE 00001095 "    },"
NSQ_SOURCE_LINE 00001096 "    result => {"
NSQ_SOURCE_LINE 00001097 "        schema => 'buf*',"
NSQ_SOURCE_LINE 00001098 "    },"
NSQ_SOURCE_LINE 00001099 "};"
NSQ_SOURCE_LINE 00001100 "sub gen_random_bytes {"
NSQ_SOURCE_LINE 00001101 "    my %args = @_; $args{'len'} //= 1024;my $arg_err; { no warnings ('void');require Scalar::Util::Numeric;if (exists($args{'len'})) { ((defined($args{'len'})) ? 1 : (($arg_err //= \"Required but not specified\"),0)) && ((Scalar::Util::Numeric::isint($args{'len'})) ? 1 : (($arg_err //= \"Not of type integer\"),0)) && (($args{'len'} >= 0) ? 1 : (($arg_err //= \"Must be at least 0\"),0)); if ($arg_err) { return [400, \"Invalid argument value for len: $arg_err\"] } }} # VALIDATE_ARGS"
NSQ_SOURCE_LINE 00001102 "    my $len = $args{len} // 1024;"
NSQ_SOURCE_LINE 00001103 "    [200, \"OK\", join(\"\", map {chr(256*rand())} 1..$len)];"
NSQ_SOURCE_LINE 00001104 "}"
NSQ_SOURCE_LINE 00001105 ""
NSQ_SOURCE_LINE 00001106 "$SPEC{multi_status} = {"
NSQ_SOURCE_LINE 00001107 "    v => 1.1,"
NSQ_SOURCE_LINE 00001108 "    summary => \"Example for result metadata property `results`\","
NSQ_SOURCE_LINE 00001109 "    description => <<'_',"
NSQ_SOURCE_LINE 00001110 ""
NSQ_SOURCE_LINE 00001111 "This function might return 200, 207, or 500, randomly. It will set result"
NSQ_SOURCE_LINE 00001112 "metadata property `results` to contain per-item results. For more details, see"
NSQ_SOURCE_LINE 00001113 "the corresponding specification in `results` property in <pod:Rinci::resmeta>."
NSQ_SOURCE_LINE 00001114 ""
NSQ_SOURCE_LINE 00001115 "_"
NSQ_SOURCE_LINE 00001116 "    args => {"
NSQ_SOURCE_LINE 00001117 "        n => {default=>5},"
NSQ_SOURCE_LINE 00001118 "    },"
NSQ_SOURCE_LINE 00001119 "};"
NSQ_SOURCE_LINE 00001120 "sub multi_status {"
NSQ_SOURCE_LINE 00001121 "    my %args = @_; $args{'n'} //= 5;# VALIDATE_ARGS"
NSQ_SOURCE_LINE 00001122 "    my $res = envresmulti();"
NSQ_SOURCE_LINE 00001123 ""
NSQ_SOURCE_LINE 00001124 "    for (1..$args{n}) {"
NSQ_SOURCE_LINE 00001125 "        my $status  = [200,500]->[2*rand];"
NSQ_SOURCE_LINE 00001126 "        my $message = $status == 200 ? \"OK\" : \"Failed\";"
NSQ_SOURCE_LINE 00001127 "        $res->add_result($status, $message, {item_id=>$_});"
NSQ_SOURCE_LINE 00001128 "    }"
NSQ_SOURCE_LINE 00001129 "    $res->as_struct;"
NSQ_SOURCE_LINE 00001130 "}"
NSQ_SOURCE_LINE 00001131 ""
NSQ_SOURCE_LINE 00001132 "$SPEC{comment_fruit} = {"
NSQ_SOURCE_LINE 00001133 "    v => 1.1,"
NSQ_SOURCE_LINE 00001134 "    summary => 'Comment on a fruit',"
NSQ_SOURCE_LINE 00001135 "    description => <<'_',"
NSQ_SOURCE_LINE 00001136 ""
NSQ_SOURCE_LINE 00001137 "This function demonstrate argument's `examples` property. It can be used to show"
NSQ_SOURCE_LINE 00001138 "choices (e.g. in argument completion) but does not require that value be one of"
NSQ_SOURCE_LINE 00001139 "the examples only."
NSQ_SOURCE_LINE 00001140 ""
NSQ_SOURCE_LINE 00001141 "_"
NSQ_SOURCE_LINE 00001142 "    args => {"
NSQ_SOURCE_LINE 00001143 "        fruit => {"
NSQ_SOURCE_LINE 00001144 "            schema => 'str*',"
NSQ_SOURCE_LINE 00001145 "            examples => ["
NSQ_SOURCE_LINE 00001146 "                'apple',"
NSQ_SOURCE_LINE 00001147 "                'apricot',"
NSQ_SOURCE_LINE 00001148 "                'banana',"
NSQ_SOURCE_LINE 00001149 "                'cherry',"
NSQ_SOURCE_LINE 00001150 "                {value=>'durian', summary=>'Summary for durian'},"
NSQ_SOURCE_LINE 00001151 "            ],"
NSQ_SOURCE_LINE 00001152 "            req => 1,"
NSQ_SOURCE_LINE 00001153 "            pos => 0,"
NSQ_SOURCE_LINE 00001154 "        },"
NSQ_SOURCE_LINE 00001155 "    },"
NSQ_SOURCE_LINE 00001156 "};"
NSQ_SOURCE_LINE 00001157 "sub comment_fruit {"
NSQ_SOURCE_LINE 00001158 "    my %args = @_;"
NSQ_SOURCE_LINE 00001159 "    my $fruit = $args{fruit} // '';"
NSQ_SOURCE_LINE 00001160 "    [200, \"OK\","
NSQ_SOURCE_LINE 00001161 "     $fruit =~ /\\A(banana|pineapple)\\z/i ?"
NSQ_SOURCE_LINE 00001162 "         \"$fruit is probably yellow\" :"
NSQ_SOURCE_LINE 00001163 "         \"I don't know about $fruit\"];"
NSQ_SOURCE_LINE 00001164 "}"
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 "1;"
NSQ_SOURCE_LINE 00001167 "# ABSTRACT: Various examples of Rinci metadata"
NSQ_SOURCE_LINE 00001168 ""
NSQ_SOURCE_LINE 00001169 "__END__"
NSQ_SOURCE_LINE 00001170 ""
NSQ_SOURCE_LINE 00001171 "=pod"
NSQ_SOURCE_LINE 00001172 ""
NSQ_SOURCE_LINE 00001173 "=encoding UTF-8"
NSQ_SOURCE_LINE 00001174 ""
NSQ_SOURCE_LINE 00001175 "=head1 NAME"
NSQ_SOURCE_LINE 00001176 ""
NSQ_SOURCE_LINE 00001177 "Perinci::Examples - Various examples of Rinci metadata"
NSQ_SOURCE_LINE 00001178 ""
NSQ_SOURCE_LINE 00001179 "=head1 VERSION"
NSQ_SOURCE_LINE 00001180 ""
NSQ_SOURCE_LINE 00001181 "This document describes version 0.825 of Perinci::Examples (from Perl distribution Perinci-Examples), released on 2024-07-17."
NSQ_SOURCE_LINE 00001182 ""
NSQ_SOURCE_LINE 00001183 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00001184 ""
NSQ_SOURCE_LINE 00001185 "This distribution contains an odd mix of various functions, variables, and other"
NSQ_SOURCE_LINE 00001186 "code entities, along with their L<Rinci> metadata. Mostly used for testing Rinci"
NSQ_SOURCE_LINE 00001187 "specification and the various L<Perinci> modules."
NSQ_SOURCE_LINE 00001188 ""
NSQ_SOURCE_LINE 00001189 "Example scripts are put in a separate distribution (see"
NSQ_SOURCE_LINE 00001190 "L<Perinci::Examples::Bin>) to make dependencies for this distribution minimal"
NSQ_SOURCE_LINE 00001191 "(e.g. not depending on L<Perinci::CmdLine::Any>) since this example module(s)"
NSQ_SOURCE_LINE 00001192 "are usually used in the tests of other modules."
NSQ_SOURCE_LINE 00001193 ""
NSQ_SOURCE_LINE 00001194 ""
NSQ_SOURCE_LINE 00001195 "A sample description"
NSQ_SOURCE_LINE 00001196 ""
NSQ_SOURCE_LINE 00001197 " verbatim"
NSQ_SOURCE_LINE 00001198 " line2"
NSQ_SOURCE_LINE 00001199 ""
NSQ_SOURCE_LINE 00001200 "Another paragraph with I<bold>, I<italic> text."
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00001203 ""
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "=head2 arg_default"
NSQ_SOURCE_LINE 00001206 ""
NSQ_SOURCE_LINE 00001207 "Usage:"
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 " arg_default(%args) -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00001210 ""
NSQ_SOURCE_LINE 00001211 "Demonstrate argument default value from default andE<sol>or schema."
NSQ_SOURCE_LINE 00001212 ""
NSQ_SOURCE_LINE 00001213 "Default value can be specified in the C<default> property of argument"
NSQ_SOURCE_LINE 00001214 "specification, e.g.:"
NSQ_SOURCE_LINE 00001215 ""
NSQ_SOURCE_LINE 00001216 " args => {"
NSQ_SOURCE_LINE 00001217 "     arg1 => { schema=>'str', default=>'blah' },"
NSQ_SOURCE_LINE 00001218 " },"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "or in the C<default> clause of the argument's schema, e.g.:"
NSQ_SOURCE_LINE 00001221 ""
NSQ_SOURCE_LINE 00001222 " args => {"
NSQ_SOURCE_LINE 00001223 "     arg1 => { schema=>['str', default=>'blah'] },"
NSQ_SOURCE_LINE 00001224 " },"
NSQ_SOURCE_LINE 00001225 ""
NSQ_SOURCE_LINE 00001226 "or even both. The C<default> property in argument specification takes precedence."
NSQ_SOURCE_LINE 00001227 ""
NSQ_SOURCE_LINE 00001228 "This function is not exported."
NSQ_SOURCE_LINE 00001229 ""
NSQ_SOURCE_LINE 00001230 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001231 ""
NSQ_SOURCE_LINE 00001232 "=over 4"
NSQ_SOURCE_LINE 00001233 ""
NSQ_SOURCE_LINE 00001234 "=item * B<a> => I<int>"
NSQ_SOURCE_LINE 00001235 ""
NSQ_SOURCE_LINE 00001236 "No defaults."
NSQ_SOURCE_LINE 00001237 ""
NSQ_SOURCE_LINE 00001238 "=item * B<b> => I<int> (default: 2)"
NSQ_SOURCE_LINE 00001239 ""
NSQ_SOURCE_LINE 00001240 "Default from \"default\" property."
NSQ_SOURCE_LINE 00001241 ""
NSQ_SOURCE_LINE 00001242 "=item * B<c> => I<int> (default: 3)"
NSQ_SOURCE_LINE 00001243 ""
NSQ_SOURCE_LINE 00001244 "Default from schema."
NSQ_SOURCE_LINE 00001245 ""
NSQ_SOURCE_LINE 00001246 "=item * B<d> => I<int> (default: 4)"
NSQ_SOURCE_LINE 00001247 ""
NSQ_SOURCE_LINE 00001248 "Default from \"default\" property as well as schema."
NSQ_SOURCE_LINE 00001249 ""
NSQ_SOURCE_LINE 00001250 "\"Default\" property overrides default value from schema."
NSQ_SOURCE_LINE 00001251 ""
NSQ_SOURCE_LINE 00001252 ""
NSQ_SOURCE_LINE 00001253 "=back"
NSQ_SOURCE_LINE 00001254 ""
NSQ_SOURCE_LINE 00001255 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00001256 ""
NSQ_SOURCE_LINE 00001257 "First element ($status_code) is an integer containing HTTP-like status code"
NSQ_SOURCE_LINE 00001258 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00001259 "($reason) is a string containing error message, or something like \"OK\" if status is"
NSQ_SOURCE_LINE 00001260 "200. Third element ($payload) is the actual result, but usually not present when enveloped result is an error response ($status_code is not 2xx). Fourth"
NSQ_SOURCE_LINE 00001261 "element (%result_meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00001262 "that contains extra information, much like how HTTP response headers provide additional metadata."
NSQ_SOURCE_LINE 00001263 ""
NSQ_SOURCE_LINE 00001264 "Return value:  (any)"
NSQ_SOURCE_LINE 00001265 ""
NSQ_SOURCE_LINE 00001266 ""
NSQ_SOURCE_LINE 00001267 ""
NSQ_SOURCE_LINE 00001268 "=head2 args_as_array"
NSQ_SOURCE_LINE 00001269 ""
NSQ_SOURCE_LINE 00001270 "Usage:"
NSQ_SOURCE_LINE 00001271 ""
NSQ_SOURCE_LINE 00001272 " args_as_array($a0, $a1, $a2) -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00001273 ""
NSQ_SOURCE_LINE 00001274 "This function's metadata sets C<args_as> property to C<array>. This means it wants"
NSQ_SOURCE_LINE 00001275 "to accept argument as an array, like a regular Perl subroutine accepting"
NSQ_SOURCE_LINE 00001276 "positional arguments in C<@_>."
NSQ_SOURCE_LINE 00001277 ""
NSQ_SOURCE_LINE 00001278 "This function is not exported."
NSQ_SOURCE_LINE 00001279 ""
NSQ_SOURCE_LINE 00001280 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00001281 ""
NSQ_SOURCE_LINE 00001282 "=over 4"
NSQ_SOURCE_LINE 00001283 ""
NSQ_SOURCE_LINE 00001284 "=item * B<$a0> => I<str>"
NSQ_SOURCE_LINE 00001285 ""
NSQ_SOURCE_LINE 00001286 "(No description)"
NSQ_SOURCE_LINE 00001287 ""
NSQ_SOURCE_LINE 00001288 "=item * B<$a1> => I<str>"
NSQ_SOURCE_LINE 00001289 ""
NSQ_SOURCE_LINE 00001290 "(No description)"
NSQ_SOURCE_LINE 00001291 ""
NSQ_SOURCE_LINE 00001292 "=item * B<$a2> => I<str>"
NSQ_SOURCE_LINE 00001293 ""
NSQ_SOURCE_LINE 00001294 "(No description)"
NSQ_SOURCE_LINE 00001295 ""
NSQ_SOURCE_LINE 00001296 ""
NSQ_SOURCE_LINE 00001297 "=back"
NSQ_SOURCE_LINE 00001298 ""
NSQ_SOURCE_LINE 00001299 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00001300 ""
NSQ_SOURCE_LINE 00001301 "First element ($status_code) is an integer containing HTTP-like status code"
NSQ_SOURCE_LINE 00001302 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00001303 "($reason) is a string containing error message, or something like \"OK\" if status is"
NSQ_SOURCE_LINE 00001304 "200. Third element ($payload) is the actual result, but usually not present when enveloped result is an error response ($status_code is not 2xx). Fourth"
NSQ_SOURCE_LINE 00001305 "element (%result_meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00001306 "that contains extra information, much like how HTTP response headers provide additional metadata."
NSQ_SOURCE_LINE 00001307 ""
NSQ_SOURCE_LINE 00001308 "Return value:  (any)"
NSQ_SOURCE_LINE 00001309 ""
NSQ_SOURCE_LINE 00001310 ""
NSQ_SOURCE_LINE 00001311 ""
NSQ_SOURCE_LINE 00001312 "=head2 args_as_arrayref"
NSQ_SOURCE_LINE 00001313 ""
NSQ_SOURCE_LINE 00001314 "Usage:"
NSQ_SOURCE_LINE 00001315 ""
NSQ_SOURCE_LINE 00001316 " args_as_arrayref([$a0, $a1, $a2]) -> [$status_code, $reason, $payload, \\%result_meta]"
