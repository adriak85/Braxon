NSQ_SOURCE_LINE 00002435 "First element ($status_code) is an integer containing HTTP-like status code"
NSQ_SOURCE_LINE 00002436 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00002437 "($reason) is a string containing error message, or something like \"OK\" if status is"
NSQ_SOURCE_LINE 00002438 "200. Third element ($payload) is the actual result, but usually not present when enveloped result is an error response ($status_code is not 2xx). Fourth"
NSQ_SOURCE_LINE 00002439 "element (%result_meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00002440 "that contains extra information, much like how HTTP response headers provide additional metadata."
NSQ_SOURCE_LINE 00002441 ""
NSQ_SOURCE_LINE 00002442 "Return value:  (any)"
NSQ_SOURCE_LINE 00002443 ""
NSQ_SOURCE_LINE 00002444 ""
NSQ_SOURCE_LINE 00002445 ""
NSQ_SOURCE_LINE 00002446 "=head2 sum"
NSQ_SOURCE_LINE 00002447 ""
NSQ_SOURCE_LINE 00002448 "Usage:"
NSQ_SOURCE_LINE 00002449 ""
NSQ_SOURCE_LINE 00002450 " sum(%args) -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00002451 ""
NSQ_SOURCE_LINE 00002452 "Sum numbers in array."
NSQ_SOURCE_LINE 00002453 ""
NSQ_SOURCE_LINE 00002454 "Examples:"
NSQ_SOURCE_LINE 00002455 ""
NSQ_SOURCE_LINE 00002456 "=over"
NSQ_SOURCE_LINE 00002457 ""
NSQ_SOURCE_LINE 00002458 "=item * First example:"
NSQ_SOURCE_LINE 00002459 ""
NSQ_SOURCE_LINE 00002460 " sum(array => [1, 2, 3]); # -> [200, \"OK\", 6, {}]"
NSQ_SOURCE_LINE 00002461 ""
NSQ_SOURCE_LINE 00002462 "=item * Second example, using argv:"
NSQ_SOURCE_LINE 00002463 ""
NSQ_SOURCE_LINE 00002464 " sum(array => [1.1, 2.1, 3.1], round => 1); # -> [200, \"OK\", 6, {}]"
NSQ_SOURCE_LINE 00002465 ""
NSQ_SOURCE_LINE 00002466 "=item * Third example, invalid arguments:"
NSQ_SOURCE_LINE 00002467 ""
NSQ_SOURCE_LINE 00002468 " sum(array => [\"a\"]);"
NSQ_SOURCE_LINE 00002469 ""
NSQ_SOURCE_LINE 00002470 "Result:"
NSQ_SOURCE_LINE 00002471 ""
NSQ_SOURCE_LINE 00002472 " ["
NSQ_SOURCE_LINE 00002473 "   400,"
NSQ_SOURCE_LINE 00002474 "   \"Argument 'array' fails validation: \\@[0]: Not of type decimal number\","
NSQ_SOURCE_LINE 00002475 "   undef,"
NSQ_SOURCE_LINE 00002476 "   {},"
NSQ_SOURCE_LINE 00002477 " ]"
NSQ_SOURCE_LINE 00002478 ""
NSQ_SOURCE_LINE 00002479 "=back"
NSQ_SOURCE_LINE 00002480 ""
NSQ_SOURCE_LINE 00002481 "This function can be used to test passing nonscalar (array) arguments."
NSQ_SOURCE_LINE 00002482 ""
NSQ_SOURCE_LINE 00002483 "This function is not exported."
NSQ_SOURCE_LINE 00002484 ""
NSQ_SOURCE_LINE 00002485 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00002486 ""
NSQ_SOURCE_LINE 00002487 "=over 4"
NSQ_SOURCE_LINE 00002488 ""
NSQ_SOURCE_LINE 00002489 "=item * B<array>* => I<array[float]>"
NSQ_SOURCE_LINE 00002490 ""
NSQ_SOURCE_LINE 00002491 "Array."
NSQ_SOURCE_LINE 00002492 ""
NSQ_SOURCE_LINE 00002493 "=item * B<round> => I<bool> (default: 0)"
NSQ_SOURCE_LINE 00002494 ""
NSQ_SOURCE_LINE 00002495 "Whether to round result to integer."
NSQ_SOURCE_LINE 00002496 ""
NSQ_SOURCE_LINE 00002497 ""
NSQ_SOURCE_LINE 00002498 "=back"
NSQ_SOURCE_LINE 00002499 ""
NSQ_SOURCE_LINE 00002500 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00002501 ""
NSQ_SOURCE_LINE 00002502 "First element ($status_code) is an integer containing HTTP-like status code"
NSQ_SOURCE_LINE 00002503 "(200 means OK, 4xx caller error, 5xx function error). Second element"
