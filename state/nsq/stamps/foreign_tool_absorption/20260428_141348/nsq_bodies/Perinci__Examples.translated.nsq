NSQ_SOURCE_LINE 00002095 "=head2 gen_sample_data"
NSQ_SOURCE_LINE 00002096 ""
NSQ_SOURCE_LINE 00002097 "Usage:"
NSQ_SOURCE_LINE 00002098 ""
NSQ_SOURCE_LINE 00002099 " gen_sample_data(%args) -> [$status_code, $reason, $payload, \\%result_meta]"
NSQ_SOURCE_LINE 00002100 ""
NSQ_SOURCE_LINE 00002101 "Generate sample data of various form."
NSQ_SOURCE_LINE 00002102 ""
NSQ_SOURCE_LINE 00002103 "This function is first written to test L<Perinci::CmdLine::Lite>'s text"
NSQ_SOURCE_LINE 00002104 "formatting rules."
NSQ_SOURCE_LINE 00002105 ""
NSQ_SOURCE_LINE 00002106 "This function is not exported."
NSQ_SOURCE_LINE 00002107 ""
NSQ_SOURCE_LINE 00002108 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00002109 ""
NSQ_SOURCE_LINE 00002110 "=over 4"
NSQ_SOURCE_LINE 00002111 ""
NSQ_SOURCE_LINE 00002112 "=item * B<form>* => I<str>"
NSQ_SOURCE_LINE 00002113 ""
NSQ_SOURCE_LINE 00002114 "=over"
NSQ_SOURCE_LINE 00002115 ""
NSQ_SOURCE_LINE 00002116 "=item * aos is array of scalar, e.g. C<[1,2,3]>."
NSQ_SOURCE_LINE 00002117 ""
NSQ_SOURCE_LINE 00002118 "=item * aoaos is array of aos, e.g. C<[ [1,2,3], [4,5,6] ]>."
NSQ_SOURCE_LINE 00002119 ""
NSQ_SOURCE_LINE 00002120 "=item * hos is hash of scalar (values), e.g. C<< {a=E<gt>1, b=E<gt>2} >>."
NSQ_SOURCE_LINE 00002121 ""
NSQ_SOURCE_LINE 00002122 "=item * aohos is array of array of hos, e.g. C<< [{a=E<gt>1,b=E<gt>2}, {a=E<gt>2}] >>."
NSQ_SOURCE_LINE 00002123 ""
NSQ_SOURCE_LINE 00002124 "=item * hohos is hash of hos as values, e.g. C<< {row1=E<gt>{a=E<gt>1,b=E<gt>2}, row2=E<gt>{}} >>."
NSQ_SOURCE_LINE 00002125 ""
NSQ_SOURCE_LINE 00002126 "=back"
NSQ_SOURCE_LINE 00002127 ""
NSQ_SOURCE_LINE 00002128 "The C<aoaos> and C<aohos> forms are commonly used for table data."
NSQ_SOURCE_LINE 00002129 ""
NSQ_SOURCE_LINE 00002130 ""
NSQ_SOURCE_LINE 00002131 "=back"
NSQ_SOURCE_LINE 00002132 ""
