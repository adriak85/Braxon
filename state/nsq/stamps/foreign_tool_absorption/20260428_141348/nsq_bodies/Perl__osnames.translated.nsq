NSQ_SOURCE_LINE 00000001 "package Perl::osnames;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2020-02-13'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Perl-osnames'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.122'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use strict;"
NSQ_SOURCE_LINE 00000009 "use warnings;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw($data is_unix is_posix"
NSQ_SOURCE_LINE 00000013 "                    $RE_OS_IS_KNOWN $RE_OS_IS_POSIX $RE_OS_IS_UNIX);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our $data = [map {"
NSQ_SOURCE_LINE 00000016 "    chomp;"
NSQ_SOURCE_LINE 00000017 "    my @f = split /\\s+/, $_, 3;"
NSQ_SOURCE_LINE 00000018 "    $f[1] = $f[1] eq '-' ? [] : [split /,/, $f[1]];"
NSQ_SOURCE_LINE 00000019 "    \\@f;"
NSQ_SOURCE_LINE 00000020 "} split /^/m, <<'_'];"
NSQ_SOURCE_LINE 00000021 "aix          posix,sysv,unix   IBM AIX."
NSQ_SOURCE_LINE 00000022 "amigaos      -"
NSQ_SOURCE_LINE 00000023 "android      sysv,unix"
NSQ_SOURCE_LINE 00000024 "bsdos        bsd,unix          BSD/OS. Originally called BSD/386, also known as BSDi."
NSQ_SOURCE_LINE 00000025 "beos         posix             See also: haiku."
NSQ_SOURCE_LINE 00000026 "bitrig       bsd,unix          An OpenBSD fork."
NSQ_SOURCE_LINE 00000027 "dgux         sysv,unix         DG/UX."
NSQ_SOURCE_LINE 00000028 "dos          -"
NSQ_SOURCE_LINE 00000029 "dynixptx     sysv,unix         DYNIX/ptx."
NSQ_SOURCE_LINE 00000030 "cygwin       posix,unix        Unix-like emulation layer that runs on Windows."
NSQ_SOURCE_LINE 00000031 "darwin       bsd,posix,unix    Mac OS X. Does not currently (2013) include iOS. See also: iphoneos."
NSQ_SOURCE_LINE 00000032 "dec_osf      -                 DEC Alpha."
NSQ_SOURCE_LINE 00000033 "dragonfly    bsd,posix,unix    DragonFly BSD."
NSQ_SOURCE_LINE 00000034 "freebsd      bsd,posix,unix"
NSQ_SOURCE_LINE 00000035 "gnu          posix,unix        Unix-like operating system which can have one these kernels: Hurd, Linux, FreeBSD."
NSQ_SOURCE_LINE 00000036 "gnukfreebsd  bsd,posix,unix    Debian GNU/kFreeBSD."
NSQ_SOURCE_LINE 00000037 "haiku        posix             See also: beos."
NSQ_SOURCE_LINE 00000038 "hpux         posix,sysv,unix   HP-UX."
NSQ_SOURCE_LINE 00000039 "interix      posix,unix        Optional, POSIX-compliant Unix subsystem for Windows NT. Also known as Microsoft SFU. No longer included in Windows nor supported."
NSQ_SOURCE_LINE 00000040 "iphoneos     posix,unix        Darwin-based OS X which is mostly POSIX compatible."
NSQ_SOURCE_LINE 00000041 "irix         posix,sysv,unix"
NSQ_SOURCE_LINE 00000042 "linux        posix,sysv,unix"
NSQ_SOURCE_LINE 00000043 "MacOS        -                 Mac OS Classic (predates Mac OS X). See also: darwin, iphoneos."
NSQ_SOURCE_LINE 00000044 "machten      bsd,unix          MachTen, an operating system that runs virtually under Mac OS."
NSQ_SOURCE_LINE 00000045 "midnightbsd  bsd,posix,unix"
NSQ_SOURCE_LINE 00000046 "minix        bsd,posix"
NSQ_SOURCE_LINE 00000047 "mirbsd       bsd,posix,unix    MirOS BSD."
NSQ_SOURCE_LINE 00000048 "mpeix        -                 MPEiX."
NSQ_SOURCE_LINE 00000049 "msys         posix,unix        A component of MinGW (minimalist Gnu for Windows) that is POSIX compatible."
NSQ_SOURCE_LINE 00000050 "MSWin32      -                 All Windows platforms including 95/98/ME/NT/2000/XP/CE/.NET. But does not include Cygwin (see \"cygwin\") or Interix (see \"interix\"). To get more details on which Windows you are on, use Win32::GetOSName() or Win32::GetOSVersion(). Ref: perlvar."
NSQ_SOURCE_LINE 00000051 "netbsd       bsd,posix,unix"
NSQ_SOURCE_LINE 00000052 "next         unix              NeXTSTEP OS."
NSQ_SOURCE_LINE 00000053 "nto          unix              ?"
NSQ_SOURCE_LINE 00000054 "openbsd      bsd,posix,unix"
NSQ_SOURCE_LINE 00000055 "os2          -                 OS/2."
NSQ_SOURCE_LINE 00000056 "os390        ebcdic"
NSQ_SOURCE_LINE 00000057 "os400        ebcdic"
NSQ_SOURCE_LINE 00000058 "posix-bc     ebcdic"
NSQ_SOURCE_LINE 00000059 "qnx          unix"
NSQ_SOURCE_LINE 00000060 "riscos       -"
NSQ_SOURCE_LINE 00000061 "sco          posix,sysv,unix   SCO UNIX."
NSQ_SOURCE_LINE 00000062 "sco_sv       posix,sysv,unix   SCO OpenServer/UnixWare."
NSQ_SOURCE_LINE 00000063 "solaris      posix,sysv,unix   This includes the old SunOS."
NSQ_SOURCE_LINE 00000064 "sunos        bsd,posix,unix    SunOS, BSD-based predecessor to the System V Solaris."
NSQ_SOURCE_LINE 00000065 "svr4         posix,sysv,unix   System V Release 4."
NSQ_SOURCE_LINE 00000066 "svr5         posix,sysv,unix   System V Release 5."
NSQ_SOURCE_LINE 00000067 "unicos       posix,sysv,unix   Unix-like operating system for Cray supercomputers."
NSQ_SOURCE_LINE 00000068 "unicosmk     posix,sysv,unix   Unix-like operating system for Cray supercomputers."
NSQ_SOURCE_LINE 00000069 "vmesa        ebcdic"
NSQ_SOURCE_LINE 00000070 "VMS          -"
NSQ_SOURCE_LINE 00000071 "vos          -"
NSQ_SOURCE_LINE 00000072 "_"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "# dump: display data as table"
NSQ_SOURCE_LINE 00000075 "#use Data::Format::Pretty::Text qw(format_pretty);"
NSQ_SOURCE_LINE 00000076 "#say format_pretty($data, {"
NSQ_SOURCE_LINE 00000077 "#    table_column_formats=>[{description=>[[wrap=>{columns=>40}]]}],"
NSQ_SOURCE_LINE 00000078 "#    table_column_orders=>[[qw/code summary description/]],"
NSQ_SOURCE_LINE 00000079 "#});"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "# debug: dump data"
NSQ_SOURCE_LINE 00000082 "#use Data::Dump::Color;"
NSQ_SOURCE_LINE 00000083 "#dd $data;"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "our $RE_OS_IS_KNOWN = do {"
NSQ_SOURCE_LINE 00000086 "    my $re = join \"|\", map { $_->[0] } @$data;"
NSQ_SOURCE_LINE 00000087 "    qr/\\A(?:$re)\\z/;"
NSQ_SOURCE_LINE 00000088 "};"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "our $RE_OS_IS_POSIX = do {"
NSQ_SOURCE_LINE 00000091 "    my @os;"
NSQ_SOURCE_LINE 00000092 "  OS:"
NSQ_SOURCE_LINE 00000093 "    for my $rec (@$data) {"
NSQ_SOURCE_LINE 00000094 "        for (@{$rec->[1]}) {"
NSQ_SOURCE_LINE 00000095 "            do { push @os, $rec->[0]; next OS } if $_ eq 'posix';"
NSQ_SOURCE_LINE 00000096 "        }"
NSQ_SOURCE_LINE 00000097 "    }"
NSQ_SOURCE_LINE 00000098 "    my $re = join(\"|\", @os);"
NSQ_SOURCE_LINE 00000099 "    qr/\\A(?:$re)\\z/;"
NSQ_SOURCE_LINE 00000100 "};"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "our $RE_OS_IS_UNIX = do {"
NSQ_SOURCE_LINE 00000103 "    my @os;"
NSQ_SOURCE_LINE 00000104 "  OS:"
NSQ_SOURCE_LINE 00000105 "    for my $rec (@$data) {"
NSQ_SOURCE_LINE 00000106 "        for (@{$rec->[1]}) {"
NSQ_SOURCE_LINE 00000107 "            do { push @os, $rec->[0]; next OS } if $_ eq 'unix';"
NSQ_SOURCE_LINE 00000108 "        }"
NSQ_SOURCE_LINE 00000109 "    }"
NSQ_SOURCE_LINE 00000110 "    my $re = join(\"|\", @os);"
NSQ_SOURCE_LINE 00000111 "    qr/\\A(?:$re)\\z/;"
NSQ_SOURCE_LINE 00000112 "};"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "sub is_posix {"
NSQ_SOURCE_LINE 00000115 "    my $os = shift || $^O;"
NSQ_SOURCE_LINE 00000116 "    return undef unless $os =~ $RE_OS_IS_KNOWN;"
NSQ_SOURCE_LINE 00000117 "    $os =~ $RE_OS_IS_POSIX ? 1:0;"
NSQ_SOURCE_LINE 00000118 "}"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "sub is_unix {"
NSQ_SOURCE_LINE 00000121 "    my $os = shift || $^O;"
NSQ_SOURCE_LINE 00000122 "    return undef unless $os =~ $RE_OS_IS_KNOWN;"
NSQ_SOURCE_LINE 00000123 "    $os =~ $RE_OS_IS_UNIX ? 1:0;"
NSQ_SOURCE_LINE 00000124 "}"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "1;"
NSQ_SOURCE_LINE 00000127 "# ABSTRACT: List possible $^O ($OSNAME) values, with description"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "__END__"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=pod"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "=head1 NAME"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "Perl::osnames - List possible $^O ($OSNAME) values, with description"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "=head1 VERSION"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "This document describes version 0.122 of Perl::osnames (from Perl distribution Perl-osnames), released on 2020-02-13."
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "This package contains C<$data> which lists possible values of C<$^O> along with"
NSQ_SOURCE_LINE 00000146 "description for each. It also provides some helper functions."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "=head2 Tags"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "=over"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=item * unix"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "Unix-like operating systems. This currently excludes beos/haiku."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=item * bsd"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "BSD-derived Unix operating systems."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=item * sysv"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "SysV-derived Unix operating systems."
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=item * posix"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "For POSIX-compliant OSes, including fully-, mostly-, and largely-compliant ones"
NSQ_SOURCE_LINE 00000167 "(source: L<http://en.wikipedia.org/wiki/POSIX>)."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "From what I can gather, dec_osf is not POSIX compliant, although there is a"
NSQ_SOURCE_LINE 00000170 "posix package for it."
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=back"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "=head1 VARIABLES"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "None are exported by default, but they are exportable."
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "=head2 C<$data>"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "An arrayref of records (arrayrefs), each structured as:"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 " [$name, \\@tags, $description]"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=head2 $RE_OS_IS_KNOWN"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "Current value:"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 " qr/\\A(?:aix|amigaos|android|bsdos|beos|bitrig|dgux|dos|dynixptx|cygwin|darwin|dec_osf|dragonfly|freebsd|gnu|gnukfreebsd|haiku|hpux|interix|iphoneos|irix|linux|MacOS|machten|midnightbsd|minix|mirbsd|mpeix|msys|MSWin32|netbsd|next|nto|openbsd|os2|os390|os400|posix-bc|qnx|riscos|sco|sco_sv|solaris|sunos|svr4|svr5|unicos|unicosmk|vmesa|VMS|vos)\\z/"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=head2 $RE_OS_IS_POSIX"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "Current value:"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 " qr/\\A(?:aix|beos|cygwin|darwin|dragonfly|freebsd|gnu|gnukfreebsd|haiku|hpux|interix|iphoneos|irix|linux|midnightbsd|minix|mirbsd|msys|netbsd|openbsd|sco|sco_sv|solaris|sunos|svr4|svr5|unicos|unicosmk)\\z/"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "=head2 $RE_OS_IS_UNIX"
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "Current value:"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 " qr/\\A(?:aix|android|bsdos|bitrig|dgux|dynixptx|cygwin|darwin|dragonfly|freebsd|gnu|gnukfreebsd|hpux|interix|iphoneos|irix|linux|machten|midnightbsd|mirbsd|msys|netbsd|next|nto|openbsd|qnx|sco|sco_sv|solaris|sunos|svr4|svr5|unicos|unicosmk)\\z/"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "None are exported by default, but they are exportable."
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=head2 is_posix([ $os ]) => bool"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "Check whether C<$os> (defaults to C<$^O> if not specified) is POSIX (checked by"
NSQ_SOURCE_LINE 00000209 "the existence of C<posix> tag on the OS's record in C<$data>). Will return 0, 1,"
NSQ_SOURCE_LINE 00000210 "or undef if C<$os> is unknown."
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "=head2 is_unix([ $os ]) => bool"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "Check whether C<$os> (defaults to C<$^O> if not specified) is Unix (checked by"
NSQ_SOURCE_LINE 00000215 "the existence of C<unix> tag on the OS's record in C<$data>). Will return 0, 1,"
NSQ_SOURCE_LINE 00000216 "or undef if C<$os> is unknown."
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "Please visit the project's homepage at L<https://metacpan.org/release/Perl-osnames>."
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "Source repository is at L<https://github.com/perlancar/perl-Perl-osnames>."
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "=head1 BUGS"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=Perl-osnames>"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000231 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000232 "feature."
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "L<perlvar>"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "L<Config>"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "L<Perl::OSType>, a core module. You should probably use this module instead."
NSQ_SOURCE_LINE 00000241 "Currently the difference between this module and Perl::osnames: 1) Perl::osnames"
NSQ_SOURCE_LINE 00000242 "currently doesn't list beos/haiku as Unix, but POSIX; 2) Perl::osnames provides"
NSQ_SOURCE_LINE 00000243 "more tags (like sysv, bsd, posix) and description."
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "L<Devel::Platform::Info>"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "The output of C<perl -V>"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "L<App::osnames>, the original reason for Perl::osnames. With this CLI tool you"
NSQ_SOURCE_LINE 00000250 "can grep OS names by name, tag, or description, e.g. C<osnames solaris> or"
NSQ_SOURCE_LINE 00000251 "C<osnames posix>."
NSQ_SOURCE_LINE 00000252 ""
