NSQ_SOURCE_LINE 00000300 "            $opts->{capture_stdout} = undef if $capture_stdout_was_false;"
NSQ_SOURCE_LINE 00000301 "        }"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "    } elsif ($which eq 'run' || $which eq 'start') {"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "        if ($opts->{log} || $opts->{dry_run}) {"
NSQ_SOURCE_LINE 00000306 "            if ($opts->{log}) {"
NSQ_SOURCE_LINE 00000307 "                no strict 'refs';"
NSQ_SOURCE_LINE 00000308 "                my $routine;"
NSQ_SOURCE_LINE 00000309 "                my $label = \"\";"
NSQ_SOURCE_LINE 00000310 "                if ($opts->{dry_run}) {"
NSQ_SOURCE_LINE 00000311 "                    $label = \"[DRY RUN] \";"
NSQ_SOURCE_LINE 00000312 "                    $routine = \"log_info\";"
NSQ_SOURCE_LINE 00000313 "                } else {"
NSQ_SOURCE_LINE 00000314 "                    $routine = \"log_trace\";"
NSQ_SOURCE_LINE 00000315 "                }"
NSQ_SOURCE_LINE 00000316 "                $routine->(\"%srun(%s), env=%s\", $label,"
NSQ_SOURCE_LINE 00000317 "                           join(\", \", @args), \\%set_env);"
NSQ_SOURCE_LINE 00000318 "            } else {"
