NSQ_SOURCE_LINE 00000001 "package IPC::System::Options;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Proc::ChildError qw(explain_child_error);"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000009 "our $DATE = '2023-05-24'; # DATE"
NSQ_SOURCE_LINE 00000010 "our $DIST = 'IPC-System-Options'; # DIST"
NSQ_SOURCE_LINE 00000011 "our $VERSION = '0.341'; # VERSION"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "my $log;"
NSQ_SOURCE_LINE 00000014 "our %Global_Opts;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub import {"
NSQ_SOURCE_LINE 00000017 "    my $self = shift;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    my $caller = caller();"
NSQ_SOURCE_LINE 00000020 "    my $i = 0;"
NSQ_SOURCE_LINE 00000021 "    while ($i < @_) {"
NSQ_SOURCE_LINE 00000022 "        # backtick is the older, deprecated name for readpipe"
NSQ_SOURCE_LINE 00000023 "        if ($_[$i] =~ /\\A(system|readpipe|backtick|run|start|import)\\z/) {"
NSQ_SOURCE_LINE 00000024 "            no strict 'refs';"
NSQ_SOURCE_LINE 00000025 "            *{\"$caller\\::$_[$i]\"} = \\&{\"$self\\::\" . $_[$i]};"
NSQ_SOURCE_LINE 00000026 "        } elsif ($_[$i] =~ /\\A-(.+)/) {"
NSQ_SOURCE_LINE 00000027 "            die \"$_[$i] requires an argument\" unless $i < @_-1;"
NSQ_SOURCE_LINE 00000028 "            $Global_Opts{$1} = $_[$i+1];"
NSQ_SOURCE_LINE 00000029 "            $i++;"
NSQ_SOURCE_LINE 00000030 "        } else {"
NSQ_SOURCE_LINE 00000031 "            die \"$_[$i] is not exported by \".__PACKAGE__;"
NSQ_SOURCE_LINE 00000032 "        }"
NSQ_SOURCE_LINE 00000033 "        $i++;"
NSQ_SOURCE_LINE 00000034 "    }"
NSQ_SOURCE_LINE 00000035 "}"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "sub _args2cmd {"
NSQ_SOURCE_LINE 00000038 "    if (@_ == 1) {"
NSQ_SOURCE_LINE 00000039 "        return $_[0];"
NSQ_SOURCE_LINE 00000040 "    }"
NSQ_SOURCE_LINE 00000041 "    if ($^O eq 'MSWin32') {"
NSQ_SOURCE_LINE 00000042 "        require Win32::ShellQuote;"
NSQ_SOURCE_LINE 00000043 "        return Win32::ShellQuote::quote_system_string("
NSQ_SOURCE_LINE 00000044 "            map { ref($_) eq 'SCALAR' ? $$_ : $_ } @_);"
NSQ_SOURCE_LINE 00000045 "    } else {"
NSQ_SOURCE_LINE 00000046 "        require String::ShellQuote;"
NSQ_SOURCE_LINE 00000047 "        return join("
NSQ_SOURCE_LINE 00000048 "            \" \","
NSQ_SOURCE_LINE 00000049 "            map { ref($_) eq 'SCALAR' ? $$_ : String::ShellQuote::shell_quote($_) } @_"
NSQ_SOURCE_LINE 00000050 "        );"
NSQ_SOURCE_LINE 00000051 "    }"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "sub _system_or_readpipe_or_run_or_start {"
NSQ_SOURCE_LINE 00000055 "    my $which = shift;"
NSQ_SOURCE_LINE 00000056 "    my $opts = ref($_[0]) eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000057 "    for (keys %Global_Opts) {"
NSQ_SOURCE_LINE 00000058 "        $opts->{$_} = $Global_Opts{$_} if !defined($opts->{$_});"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 "    my @args = @_;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    # check known options"
NSQ_SOURCE_LINE 00000063 "    for (keys %$opts) {"
NSQ_SOURCE_LINE 00000064 "        die \"Unknown option '$_'\""
NSQ_SOURCE_LINE 00000065 "            unless /\\A("
NSQ_SOURCE_LINE 00000066 "                        capture_stdout|capture_stderr|capture_merged|"
NSQ_SOURCE_LINE 00000067 "                        tee_stdout|tee_stderr|tee_merged|"
NSQ_SOURCE_LINE 00000068 "                        chdir|dies?|dry_run|env|lang|log|max_log_output|shell|"
NSQ_SOURCE_LINE 00000069 "                        exit_code_success_criteria|"
NSQ_SOURCE_LINE 00000070 "                        fail_log_level|"
NSQ_SOURCE_LINE 00000071 "                        stdin # XXX: only for run()"
NSQ_SOURCE_LINE 00000072 "                    )\\z/x;"
NSQ_SOURCE_LINE 00000073 "    }"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "    # defaults"
NSQ_SOURCE_LINE 00000076 "    $opts->{fail_log_level} ||= 'error';"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "    my $opt_die = $opts->{die} || $opts->{dies};"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "    my $child_error;"
NSQ_SOURCE_LINE 00000081 "    my $os_error = \"\";"
NSQ_SOURCE_LINE 00000082 "    my $exit_code_is_success;"
NSQ_SOURCE_LINE 00000083 "    my $extra_error;"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    my $code_exit_code_is_success = sub {"
NSQ_SOURCE_LINE 00000086 "        my $exit_code = shift;"
NSQ_SOURCE_LINE 00000087 "        if (defined $opts->{exit_code_success_criteria}) {"
NSQ_SOURCE_LINE 00000088 "            if    (ref $opts->{exit_code_success_criteria} eq ''      ) { return $exit_code == $opts->{exit_code_success_criteria} }"
NSQ_SOURCE_LINE 00000089 "            elsif (ref $opts->{exit_code_success_criteria} eq 'ARRAY' ) { return (grep { $exit_code==$_ } @{ $opts->{exit_code_success_criteria} }) ? 1:0 }"
NSQ_SOURCE_LINE 00000090 "            elsif (ref $opts->{exit_code_success_criteria} eq 'Regexp') { return $exit_code =~ $opts->{exit_code_success_criteria} }"
NSQ_SOURCE_LINE 00000091 "            elsif (ref $opts->{exit_code_success_criteria} eq 'CODE'  ) { return $opts->{exit_code_success_criteria}->($exit_code) }"
NSQ_SOURCE_LINE 00000092 "            else { die \"exit_code_success_criteria must be a number, array of numbers, Regexp, or coderef\" }"
NSQ_SOURCE_LINE 00000093 "        } else {"
NSQ_SOURCE_LINE 00000094 "            return $exit_code == 0;"
NSQ_SOURCE_LINE 00000095 "        }"
NSQ_SOURCE_LINE 00000096 "    };"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    if ($opts->{log}) {"
NSQ_SOURCE_LINE 00000099 "        require Log::ger::Format::MultilevelLog; # just so scan_prereqs can detect it"
NSQ_SOURCE_LINE 00000100 "        require Log::ger::Format;"
NSQ_SOURCE_LINE 00000101 "        Log::ger::Format->set_for_current_package(MultilevelLog => (sub_name => 'logger'));"
NSQ_SOURCE_LINE 00000102 "        require Log::ger;"
NSQ_SOURCE_LINE 00000103 "        Log::ger->import;"
NSQ_SOURCE_LINE 00000104 "    }"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    my $cwd;"
NSQ_SOURCE_LINE 00000107 "    if ($opts->{chdir}) {"
NSQ_SOURCE_LINE 00000108 "        require Cwd;"
NSQ_SOURCE_LINE 00000109 "        $cwd = Cwd::getcwd();"
NSQ_SOURCE_LINE 00000110 "        if (!defined $cwd) { # checking $! is always true here, why?"
NSQ_SOURCE_LINE 00000111 "            $log->error(\"Can't getcwd: $!\") if $log;"
NSQ_SOURCE_LINE 00000112 "            $child_error = -1;"
NSQ_SOURCE_LINE 00000113 "            $exit_code_is_success = 0;"
NSQ_SOURCE_LINE 00000114 "            $os_error = $!;"
NSQ_SOURCE_LINE 00000115 "            $extra_error = \"Can't getcwd\";"
NSQ_SOURCE_LINE 00000116 "            goto CHECK_RESULT;"
NSQ_SOURCE_LINE 00000117 "        }"
NSQ_SOURCE_LINE 00000118 "        unless (chdir $opts->{chdir}) {"
NSQ_SOURCE_LINE 00000119 "            $log->error(\"Can't chdir to '$opts->{chdir}': $!\") if $log;"
NSQ_SOURCE_LINE 00000120 "            $child_error = -1;"
NSQ_SOURCE_LINE 00000121 "            $exit_code_is_success = 0;"
NSQ_SOURCE_LINE 00000122 "            $os_error = $!;"
NSQ_SOURCE_LINE 00000123 "            $extra_error = \"Can't chdir\";"
NSQ_SOURCE_LINE 00000124 "            goto CHECK_RESULT;"
NSQ_SOURCE_LINE 00000125 "        }"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "    # set ENV"
NSQ_SOURCE_LINE 00000129 "    my %save_env;"
NSQ_SOURCE_LINE 00000130 "    my %set_env;"
NSQ_SOURCE_LINE 00000131 "    if ($opts->{lang}) {"
NSQ_SOURCE_LINE 00000132 "        $set_env{LC_ALL}   = $opts->{lang};"
NSQ_SOURCE_LINE 00000133 "        $set_env{LANGUAGE} = $opts->{lang};"
NSQ_SOURCE_LINE 00000134 "        $set_env{LANG}     = $opts->{lang};"
NSQ_SOURCE_LINE 00000135 "    }"
NSQ_SOURCE_LINE 00000136 "    if ($opts->{env}) {"
NSQ_SOURCE_LINE 00000137 "        $set_env{$_} = $opts->{env}{$_} for keys %{ $opts->{env} };"
NSQ_SOURCE_LINE 00000138 "    }"
NSQ_SOURCE_LINE 00000139 "    if (%set_env) {"
NSQ_SOURCE_LINE 00000140 "        for (keys %set_env) {"
NSQ_SOURCE_LINE 00000141 "            $save_env{$_} = $ENV{$_};"
NSQ_SOURCE_LINE 00000142 "            $ENV{$_} = $set_env{$_};"
NSQ_SOURCE_LINE 00000143 "        }"
NSQ_SOURCE_LINE 00000144 "    }"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    my $wa;"
NSQ_SOURCE_LINE 00000147 "    my $res;"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "    my $capture_stdout_was_false;"
NSQ_SOURCE_LINE 00000150 "    my $emulate_backtick;"
NSQ_SOURCE_LINE 00000151 "    my $tmp_capture_stdout;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    my $code_capture = sub {"
NSQ_SOURCE_LINE 00000154 "        my $doit = shift;"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "        if ($opts->{capture_stdout} && $opts->{capture_stderr}) {"
NSQ_SOURCE_LINE 00000157 "            require Capture::Tiny;"
NSQ_SOURCE_LINE 00000158 "            (${ $opts->{capture_stdout} }, ${ $opts->{capture_stderr} }) ="
NSQ_SOURCE_LINE 00000159 "                &Capture::Tiny::capture($doit);"
NSQ_SOURCE_LINE 00000160 "        } elsif ($opts->{capture_merged}) {"
NSQ_SOURCE_LINE 00000161 "            require Capture::Tiny;"
NSQ_SOURCE_LINE 00000162 "            ${ $opts->{capture_merged} } ="
NSQ_SOURCE_LINE 00000163 "                &Capture::Tiny::capture_merged($doit);"
NSQ_SOURCE_LINE 00000164 "        } elsif ($opts->{capture_stdout}) {"
NSQ_SOURCE_LINE 00000165 "            require Capture::Tiny;"
NSQ_SOURCE_LINE 00000166 "            ${ $opts->{capture_stdout} } ="
NSQ_SOURCE_LINE 00000167 "                &Capture::Tiny::capture_stdout($doit);"
NSQ_SOURCE_LINE 00000168 "        } elsif ($opts->{capture_stderr}) {"
NSQ_SOURCE_LINE 00000169 "            require Capture::Tiny;"
NSQ_SOURCE_LINE 00000170 "            ${ $opts->{capture_stderr} } ="
NSQ_SOURCE_LINE 00000171 "                &Capture::Tiny::capture_stderr($doit);"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "        } elsif ($opts->{tee_stdout} && $opts->{tee_stderr}) {"
NSQ_SOURCE_LINE 00000174 "            require Capture::Tiny;"
NSQ_SOURCE_LINE 00000175 "            (${ $opts->{tee_stdout} }, ${ $opts->{tee_stderr} }) ="
NSQ_SOURCE_LINE 00000176 "                &Capture::Tiny::tee($doit);"
NSQ_SOURCE_LINE 00000177 "        } elsif ($opts->{tee_merged}) {"
NSQ_SOURCE_LINE 00000178 "            require Capture::Tiny;"
NSQ_SOURCE_LINE 00000179 "            ${ $opts->{tee_merged} } ="
NSQ_SOURCE_LINE 00000180 "                &Capture::Tiny::tee_merged($doit);"
NSQ_SOURCE_LINE 00000181 "        } elsif ($opts->{tee_stdout}) {"
NSQ_SOURCE_LINE 00000182 "            require Capture::Tiny;"
NSQ_SOURCE_LINE 00000183 "            ${ $opts->{tee_stdout} } ="
NSQ_SOURCE_LINE 00000184 "                &Capture::Tiny::tee_stdout($doit);"
NSQ_SOURCE_LINE 00000185 "        } elsif ($opts->{tee_stderr}) {"
NSQ_SOURCE_LINE 00000186 "            require Capture::Tiny;"
NSQ_SOURCE_LINE 00000187 "            ${ $opts->{tee_stderr} } ="
NSQ_SOURCE_LINE 00000188 "                &Capture::Tiny::tee_stderr($doit);"
NSQ_SOURCE_LINE 00000189 "        } else {"
NSQ_SOURCE_LINE 00000190 "            $doit->();"
NSQ_SOURCE_LINE 00000191 "        }"
NSQ_SOURCE_LINE 00000192 "    };"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    if ($which eq 'system') {"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "        if ($opts->{log} || $opts->{dry_run}) {"
NSQ_SOURCE_LINE 00000197 "            if ($opts->{log}) {"
NSQ_SOURCE_LINE 00000198 "                no strict 'refs';"
NSQ_SOURCE_LINE 00000199 "                my $routine;"
NSQ_SOURCE_LINE 00000200 "                my $label = \"\";"
NSQ_SOURCE_LINE 00000201 "                if ($opts->{dry_run}) {"
NSQ_SOURCE_LINE 00000202 "                    $label = \"[DRY RUN] \";"
NSQ_SOURCE_LINE 00000203 "                    $routine = \"log_info\";"
NSQ_SOURCE_LINE 00000204 "                } else {"
NSQ_SOURCE_LINE 00000205 "                    $routine = \"log_trace\";"
NSQ_SOURCE_LINE 00000206 "                }"
NSQ_SOURCE_LINE 00000207 "                $routine->(\"%ssystem(%s), env=%s\", $label, \\@args, \\%set_env);"
NSQ_SOURCE_LINE 00000208 "            } else {"
NSQ_SOURCE_LINE 00000209 "                warn \"[DRY RUN] system(\"._args2cmd(@args).\")\\n\";"
NSQ_SOURCE_LINE 00000210 "            }"
NSQ_SOURCE_LINE 00000211 "            if ($opts->{dry_run}) {"
NSQ_SOURCE_LINE 00000212 "                $child_error = 0;"
NSQ_SOURCE_LINE 00000213 "                $exit_code_is_success = 1;"
NSQ_SOURCE_LINE 00000214 "                $res = \"\";"
NSQ_SOURCE_LINE 00000215 "                goto CHECK_RESULT;"
NSQ_SOURCE_LINE 00000216 "            }"
NSQ_SOURCE_LINE 00000217 "        }"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "        my $doit = sub {"
NSQ_SOURCE_LINE 00000220 "            if ($opts->{shell}) {"
NSQ_SOURCE_LINE 00000221 "                # force the use of shell"
NSQ_SOURCE_LINE 00000222 "                $res = system _args2cmd(@args);"
NSQ_SOURCE_LINE 00000223 "            } elsif (defined $opts->{shell}) {"
NSQ_SOURCE_LINE 00000224 "                # forbid shell"
NSQ_SOURCE_LINE 00000225 "                $res = system {$args[0]} @args;"
NSQ_SOURCE_LINE 00000226 "            } else {"
NSQ_SOURCE_LINE 00000227 "                # might or might not use shell (if @args == 1)"
NSQ_SOURCE_LINE 00000228 "                $res = system @args;"
NSQ_SOURCE_LINE 00000229 "            }"
NSQ_SOURCE_LINE 00000230 "            $child_error = $?;"
NSQ_SOURCE_LINE 00000231 "            $exit_code_is_success = $code_exit_code_is_success->($? < 0 ? $? : $? >> 8);"
NSQ_SOURCE_LINE 00000232 "            $os_error = $!;"
NSQ_SOURCE_LINE 00000233 "        };"
NSQ_SOURCE_LINE 00000234 "        $code_capture->($doit);"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "    } elsif ($which eq 'readpipe') {"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "        $wa = wantarray;"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "        if ($opts->{log} || $opts->{dry_run}) {"
NSQ_SOURCE_LINE 00000241 "            if ($opts->{log}) {"
NSQ_SOURCE_LINE 00000242 "                no strict 'refs';"
NSQ_SOURCE_LINE 00000243 "                my $routine;"
NSQ_SOURCE_LINE 00000244 "                my $label = \"\";"
NSQ_SOURCE_LINE 00000245 "                if ($opts->{dry_run}) {"
NSQ_SOURCE_LINE 00000246 "                    $label = \"[DRY RUN] \";"
NSQ_SOURCE_LINE 00000247 "                    $routine = \"log_info\";"
NSQ_SOURCE_LINE 00000248 "                } else {"
NSQ_SOURCE_LINE 00000249 "                    $routine = \"log_trace\";"
NSQ_SOURCE_LINE 00000250 "                }"
NSQ_SOURCE_LINE 00000251 "                $routine->(\"%sreadpipe(%s), env=%s\", $label, _args2cmd(@args), \\%set_env);"
NSQ_SOURCE_LINE 00000252 "            } else {"
NSQ_SOURCE_LINE 00000253 "                warn \"[DRY RUN] readpipe(\"._args2cmd(@args).\")\\n\";"
NSQ_SOURCE_LINE 00000254 "            }"
NSQ_SOURCE_LINE 00000255 "            if ($opts->{dry_run}) {"
NSQ_SOURCE_LINE 00000256 "                $child_error = 0;"
NSQ_SOURCE_LINE 00000257 "                $exit_code_is_success = 1;"
NSQ_SOURCE_LINE 00000258 "               $res = \"\";"
NSQ_SOURCE_LINE 00000259 "                goto CHECK_RESULT;"
NSQ_SOURCE_LINE 00000260 "            }"
NSQ_SOURCE_LINE 00000261 "        }"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "        # we want to avoid the shell, so we don't use the builtin backtick."
NSQ_SOURCE_LINE 00000264 "        # instead, we emulate backtick by system + capturing the output"
NSQ_SOURCE_LINE 00000265 "        if (defined $opts->{shell} && !$opts->{shell}) {"
NSQ_SOURCE_LINE 00000266 "            $emulate_backtick++;"
NSQ_SOURCE_LINE 00000267 "            die \"Currently cannot backtick() with options shell=0 and capture_merged|tee_*\""
NSQ_SOURCE_LINE 00000268 "                if $opts->{capture_merged} || $opts->{tee_stdout} || $opts->{tee_stderr} || $opts->{tee_merged};"
NSQ_SOURCE_LINE 00000269 "            if (!$opts->{capture_stdout}) {"
NSQ_SOURCE_LINE 00000270 "                $capture_stdout_was_false++;"
NSQ_SOURCE_LINE 00000271 "                $opts->{capture_stdout} = \\$tmp_capture_stdout;"
NSQ_SOURCE_LINE 00000272 "            }"
NSQ_SOURCE_LINE 00000273 "        }"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "        my $doit = sub {"
NSQ_SOURCE_LINE 00000276 "            if ($emulate_backtick) {"
NSQ_SOURCE_LINE 00000277 "                # we don't want shell so we have to emulate backtick with system"
NSQ_SOURCE_LINE 00000278 "                # + capture the output ourselves"
NSQ_SOURCE_LINE 00000279 "                system {$args[0]} @args;"
NSQ_SOURCE_LINE 00000280 "            } else {"
NSQ_SOURCE_LINE 00000281 "                my $cmd = _args2cmd(@args);"
NSQ_SOURCE_LINE 00000282 "                #warn \"cmd for backtick: \" . $cmd;"
NSQ_SOURCE_LINE 00000283 "                # use backtick, which uses the shell"
NSQ_SOURCE_LINE 00000284 "                if ($wa) {"
NSQ_SOURCE_LINE 00000285 "                    $res = [`$cmd`];"
NSQ_SOURCE_LINE 00000286 "                } else {"
NSQ_SOURCE_LINE 00000287 "                    $res = `$cmd`;"
NSQ_SOURCE_LINE 00000288 "                }"
NSQ_SOURCE_LINE 00000289 "            }"
NSQ_SOURCE_LINE 00000290 "            $child_error = $? < 0 ? $? : $? >> 8;"
NSQ_SOURCE_LINE 00000291 "            $exit_code_is_success = $code_exit_code_is_success->($? < 0 ? $? : $? >> 8);"
NSQ_SOURCE_LINE 00000292 "            $os_error = $!;"
NSQ_SOURCE_LINE 00000293 "        };"
NSQ_SOURCE_LINE 00000294 "        $code_capture->($doit);"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "        if ($emulate_backtick) {"
