NSQ_SOURCE_LINE 00000362 "            $child_error = 0;"
NSQ_SOURCE_LINE 00000363 "            $exit_code_is_success = 1;"
NSQ_SOURCE_LINE 00000364 "            $os_error = \"\";"
NSQ_SOURCE_LINE 00000365 "        }"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "    } # which"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "    # log output"
NSQ_SOURCE_LINE 00000370 "    if ($opts->{log}) {"
NSQ_SOURCE_LINE 00000371 "        my $res_show;"
NSQ_SOURCE_LINE 00000372 "        if (defined $opts->{max_log_output}) {"
NSQ_SOURCE_LINE 00000373 "            $res_show = '';"
NSQ_SOURCE_LINE 00000374 "            if ($wa) {"
NSQ_SOURCE_LINE 00000375 "                for (@$res) {"
NSQ_SOURCE_LINE 00000376 "                    if (length($res_show) + length($_) >="
NSQ_SOURCE_LINE 00000377 "                        $opts->{max_log_output}) {"
NSQ_SOURCE_LINE 00000378 "                        $res_show .= substr("
NSQ_SOURCE_LINE 00000379 "                            $_,0,$opts->{max_log_output}-length($res_show));"
NSQ_SOURCE_LINE 00000380 "                        last;"
NSQ_SOURCE_LINE 00000381 "                    } else {"
NSQ_SOURCE_LINE 00000382 "                        $res_show .= $_;"
NSQ_SOURCE_LINE 00000383 "                    }"
NSQ_SOURCE_LINE 00000384 "                }"
NSQ_SOURCE_LINE 00000385 "            } else {"
NSQ_SOURCE_LINE 00000386 "                if (length($res) > $opts->{max_log_output}) {"
NSQ_SOURCE_LINE 00000387 "                    $res_show = substr($res, 0, $opts->{max_log_output});"
NSQ_SOURCE_LINE 00000388 "                }"
NSQ_SOURCE_LINE 00000389 "            }"
NSQ_SOURCE_LINE 00000390 "        }"
NSQ_SOURCE_LINE 00000391 "        log_trace(\"result of $which(): %s (%d bytes)\","
NSQ_SOURCE_LINE 00000392 "                  defined($res_show) ? $res_show : $res,"
NSQ_SOURCE_LINE 00000393 "                      defined($res_show) ?"
NSQ_SOURCE_LINE 00000394 "                  $opts->{max_log_output} : length($res))"
NSQ_SOURCE_LINE 00000395 "            if $exit_code_is_success;"
NSQ_SOURCE_LINE 00000396 "    } # end of log output"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "    # restore ENV"
NSQ_SOURCE_LINE 00000399 "    if (%save_env) {"
NSQ_SOURCE_LINE 00000400 "        for (keys %save_env) {"
NSQ_SOURCE_LINE 00000401 "            if (defined $save_env{$_}) {"
NSQ_SOURCE_LINE 00000402 "                $ENV{$_} = $save_env{$_};"
NSQ_SOURCE_LINE 00000403 "            } else {"
NSQ_SOURCE_LINE 00000404 "                undef $ENV{$_};"
NSQ_SOURCE_LINE 00000405 "            }"
NSQ_SOURCE_LINE 00000406 "        }"
NSQ_SOURCE_LINE 00000407 "    }"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "    # restore previous working directory"
NSQ_SOURCE_LINE 00000410 "    if ($cwd) {"
NSQ_SOURCE_LINE 00000411 "        unless (chdir $cwd) {"
NSQ_SOURCE_LINE 00000412 "            $log->error(\"Can't chdir back to '$cwd': $!\") if $log;"
NSQ_SOURCE_LINE 00000413 "            $child_error ||= -1;"
NSQ_SOURCE_LINE 00000414 "            $os_error = $!;"
NSQ_SOURCE_LINE 00000415 "            $extra_error = \"Can't chdir back\";"
NSQ_SOURCE_LINE 00000416 "            goto CHECK_RESULT;"
NSQ_SOURCE_LINE 00000417 "        }"
NSQ_SOURCE_LINE 00000418 "    }"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "  CHECK_RESULT:"
NSQ_SOURCE_LINE 00000421 "    unless ($exit_code_is_success) {"
NSQ_SOURCE_LINE 00000422 "        if ($opts->{log} || $opt_die) {"
NSQ_SOURCE_LINE 00000423 "            my $msg = sprintf("
NSQ_SOURCE_LINE 00000424 "                \"%s(%s) failed: %s (%s)%s%s%s\","
NSQ_SOURCE_LINE 00000425 "                $which,"
NSQ_SOURCE_LINE 00000426 "                join(\" \", @args),"
NSQ_SOURCE_LINE 00000427 "                defined $extra_error ? \"\" : $child_error,"
NSQ_SOURCE_LINE 00000428 "                defined $extra_error ? \"$extra_error: $os_error\" : explain_child_error($child_error, $os_error),"
NSQ_SOURCE_LINE 00000429 "                (ref($opts->{capture_stdout}) ?"
NSQ_SOURCE_LINE 00000430 "                     \", captured stdout: <<\" ."
NSQ_SOURCE_LINE 00000431 "                     (defined ${$opts->{capture_stdout}} ? ${$opts->{capture_stdout}} : ''). \">>\" : \"\"),"
NSQ_SOURCE_LINE 00000432 "                (ref($opts->{capture_stderr}) ?"
NSQ_SOURCE_LINE 00000433 "                     \", captured stderr: <<\" ."
NSQ_SOURCE_LINE 00000434 "                     (defined ${$opts->{capture_stderr}} ? ${$opts->{capture_stderr}} : ''). \">>\" : \"\"),"
NSQ_SOURCE_LINE 00000435 "                (ref($opts->{capture_merged}) ?"
NSQ_SOURCE_LINE 00000436 "                     \", captured merged: <<\" ."
NSQ_SOURCE_LINE 00000437 "                     (defined ${$opts->{capture_merged}} ? ${$opts->{capture_merged}} : ''). \">>\" : \"\"),"
NSQ_SOURCE_LINE 00000438 "            );"
NSQ_SOURCE_LINE 00000439 "            logger($opts->{fail_log_level}, $msg) if $opts->{log};"
NSQ_SOURCE_LINE 00000440 "            die $msg if $opt_die;"
NSQ_SOURCE_LINE 00000441 "        }"
NSQ_SOURCE_LINE 00000442 "    }"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "    if ($which ne 'start') {"
NSQ_SOURCE_LINE 00000445 "        $? = $child_error;"
NSQ_SOURCE_LINE 00000446 "    }"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "    return $wa && $which ne 'run' && $which ne 'start' ? @$res : $res;"
NSQ_SOURCE_LINE 00000449 "}"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "sub system {"
NSQ_SOURCE_LINE 00000452 "    _system_or_readpipe_or_run_or_start('system', @_);"
NSQ_SOURCE_LINE 00000453 "}"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "# backtick is the older, deprecated name for readpipe"
NSQ_SOURCE_LINE 00000456 "sub backtick {"
NSQ_SOURCE_LINE 00000457 "    _system_or_readpipe_or_run_or_start('readpipe', @_);"
NSQ_SOURCE_LINE 00000458 "}"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "sub readpipe {"
NSQ_SOURCE_LINE 00000461 "    _system_or_readpipe_or_run_or_start('readpipe', @_);"
NSQ_SOURCE_LINE 00000462 "}"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "sub run {"
NSQ_SOURCE_LINE 00000465 "    _system_or_readpipe_or_run_or_start('run', @_);"
NSQ_SOURCE_LINE 00000466 "}"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "sub start {"
NSQ_SOURCE_LINE 00000469 "    _system_or_readpipe_or_run_or_start('start', @_);"
NSQ_SOURCE_LINE 00000470 "}"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "1;"
NSQ_SOURCE_LINE 00000473 "# ABSTRACT: Perl's system(), readpipe()/qx, IPC::Run's run(), start() (with more options)"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "__END__"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "=pod"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "=head1 NAME"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "IPC::System::Options - Perl's system(), readpipe()/qx, IPC::Run's run(), start() (with more options)"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "=head1 VERSION"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "This document describes version 0.341 of IPC::System::Options (from Perl distribution IPC-System-Options), released on 2023-05-24."
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 " use IPC::System::Options qw(system readpipe run start);"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 " # use exactly like system()"
NSQ_SOURCE_LINE 00000494 " system(...);"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 " # use exactly like readpipe() (a.k.a. qx a.k.a. `` a.k.a. the backtick"
NSQ_SOURCE_LINE 00000497 " # operator). if you import readpipe, you'll override the backtick operator with"
NSQ_SOURCE_LINE 00000498 " # this module's version (along with your chosen settings)."
NSQ_SOURCE_LINE 00000499 " my $res = readpipe(...);"
NSQ_SOURCE_LINE 00000500 " $res = `...`;"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 " # but these functions accept an optional hash first argument to specify options"
NSQ_SOURCE_LINE 00000503 " system({...}, ...);"
NSQ_SOURCE_LINE 00000504 " $res = readpipe({...}, ...);"
NSQ_SOURCE_LINE 00000505 ""
NSQ_SOURCE_LINE 00000506 " # run without shell, even though there is only one argument"
NSQ_SOURCE_LINE 00000507 " system({shell=>0}, \"ls\");"
NSQ_SOURCE_LINE 00000508 " system({shell=>0}, \"ls -lR\");          # will fail, as there is no 'ls -lR' binary"
NSQ_SOURCE_LINE 00000509 " $res = readpipe({shell=>0}, \"ls -lR\"); # ditto"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 " # force shell, even though there are multiple arguments (arguments will be"
NSQ_SOURCE_LINE 00000512 " # quoted and joined together for you, including proper quoting on Win32)."
NSQ_SOURCE_LINE 00000513 " system({shell=>1}, \"perl\", \"-e\", \"print 123\"); # will print 123"
NSQ_SOURCE_LINE 00000514 " $res = readpipe({shell=>1}, \"perl\", \"-e\", \"print 123\");"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 " # note that to prevent the quoting mechanism from quoting some special"
NSQ_SOURCE_LINE 00000517 " # characters (like \">\") you can use scalar references, e.g.:"
NSQ_SOURCE_LINE 00000518 " system({shell=>1}, \"ls\", \"-laR\",  \">\", \"/root/ls-laR\"); # fails, because the arguments are quoted so the command becomes: ls '-laR' '>' '/root/ls-laR'"
NSQ_SOURCE_LINE 00000519 " system({shell=>1}, \"ls\", \"-laR\", \\\">\", \"/root/ls-laR\"); # works"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 " # set LC_ALL/LANGUAGE/LANG environment variable"
NSQ_SOURCE_LINE 00000522 " $res = readpipe({lang=>\"de_DE.UTF-8\"}, \"df\");"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 " # log using Log::ger, die on failure"
NSQ_SOURCE_LINE 00000525 " system({log=>1, die=>1}, \"blah\", ...);"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 " # chdir first before running program (and chdir back afterwards)"
NSQ_SOURCE_LINE 00000528 " system({chdir => \"/tmp\", die => 1}, \"some-program\");"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "Set default options for all calls (prefix each option with dash):"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 " use IPC::System::Options 'system', 'readpipe', -log=>1, -die=>1;"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "C<run()> is like C<system()> but uses L<IPC::Run>'s C<run()> instead of"
NSQ_SOURCE_LINE 00000535 "C<system()>:"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 " run('ls');"
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 " # also accepts an optional hash first argument. some additional options that"
NSQ_SOURCE_LINE 00000540 " # run() accepts: stdin."
NSQ_SOURCE_LINE 00000541 " run({capture_stdout => \\$stdout, capture_stderr => \\$stderr}, 'ls', '-l');"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "C<start()> is like C<run()> but uses L<IPC::Run>'s C<start()> instead of"
NSQ_SOURCE_LINE 00000544 "C<run()> to run program in the background. The result is a handle (see"
NSQ_SOURCE_LINE 00000545 "L<IPC::Run> for more details) which you can then call C<finish()>, etc on."
NSQ_SOURCE_LINE 00000546 ""
NSQ_SOURCE_LINE 00000547 " my $h = start('ls', '-l');"
NSQ_SOURCE_LINE 00000548 " ..."
NSQ_SOURCE_LINE 00000549 " $h->finish;"
NSQ_SOURCE_LINE 00000550 ""
NSQ_SOURCE_LINE 00000551 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000552 ""
NSQ_SOURCE_LINE 00000553 "This module provides replacement (wrapper) for Perl's C<system()>, C<readpipe()>"
NSQ_SOURCE_LINE 00000554 "(qx//, a.k.a. the backtick operator), as well as L<IPC::Run>'s C<start()> and"
NSQ_SOURCE_LINE 00000555 "C<run()>. The wrappers give you options like forcing/avoiding use of shell (like"
NSQ_SOURCE_LINE 00000556 "what L<IPC::System::Simple> offers you), logging the arguments and/or output"
NSQ_SOURCE_LINE 00000557 "(using L<Log::ger>), temporarily setting environment variables, temporarily"
NSQ_SOURCE_LINE 00000558 "setting working directory, dying on non-zero exit code, capturing (or tee-ing)"
NSQ_SOURCE_LINE 00000559 "output (stdout/stderr) (using L<Capture::Tiny>), and a few others. They are"
NSQ_SOURCE_LINE 00000560 "meant as a convenience so you can just call C<system()> (or the other wrapper"
NSQ_SOURCE_LINE 00000561 "target) instead of doing some additional setup and cleanup yourself."
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "=for Pod::Coverage ^(backtick)$"
NSQ_SOURCE_LINE 00000564 ""
NSQ_SOURCE_LINE 00000565 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "=head2 system"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "Usage:"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 " system([ \\%opts ], @args) => $child_error ($?)"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "Just like perl's C<system()> except that it accepts an optional hash first"
NSQ_SOURCE_LINE 00000574 "argument to specify options. Currently known options:"
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "=over"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "=item * shell => bool"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "Can be set to 0 to always avoid invoking the shell. The default is to use the"
NSQ_SOURCE_LINE 00000581 "shell under certain conditions, like perl's C<system()>. But unlike perl's"
NSQ_SOURCE_LINE 00000582 "C<system()>, you can force shell usage even though you pass multiple arguments"
NSQ_SOURCE_LINE 00000583 "(in which case, the arguments will be quoted for you, including proper quoting"
NSQ_SOURCE_LINE 00000584 "on Win32)."
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "=item * lang => str"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "Temporarily set locale-related environment variables: C<LC_ALL> (this is the"
NSQ_SOURCE_LINE 00000589 "highest precedence, even higher than the other C<LC_*> variables including"
NSQ_SOURCE_LINE 00000590 "C<LC_MESSAGES>), C<LANGUAGE> (this is used in Linux, with precedence higher than"
NSQ_SOURCE_LINE 00000591 "C<LANG> but lower than C<LC_*>), and C<LANG>."
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "Of course you can set the environment variables manually (or use the C<env>"
NSQ_SOURCE_LINE 00000594 "option), this option is just for convenience."
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "=item * env => hashref"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "Temporarily set environment variables."
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "=item * log => bool"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "If set to true, then will log invocation as well as return/result value. Will"
NSQ_SOURCE_LINE 00000603 "log using L<Log::ger> at the C<trace> level."
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "=item * fail_log_level => str"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "When a command fail (and logging is enabled), log the failure message at this"
NSQ_SOURCE_LINE 00000608 "level. The default is C<error> which is a sensible default but sometimes you"
NSQ_SOURCE_LINE 00000609 "want to log the failure at different level."
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "=item * die => bool"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "If set to true, will die on failure."
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "=item * capture_stdout => scalarref"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "Capture stdout using L<Capture::Tiny>."
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "Cannot be used together with C<tee_*> or C<capture_merged>."
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "=item * capture_stderr => scalarref"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "Capture stderr using L<Capture::Tiny>."
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "Cannot be used together with C<tee_*> or C<capture_merged>."
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "=item * capture_merged => scalarref"
NSQ_SOURCE_LINE 00000628 ""
NSQ_SOURCE_LINE 00000629 "Capture stdout and stderr in a single variable using L<Capture::Tiny>'s"
NSQ_SOURCE_LINE 00000630 "C<capture_merged>."
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "Cannot be used together with C<tee_*>, C<capture_stdout>, or C<capture_stderr>."
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "=item * tee_stdout => scalarref"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "Tee stdout using L<Capture::Tiny>."
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "Cannot be used together with C<capture_*> or C<tee_merged>."
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "=item * tee_stderr => scalarref"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "Capture stderr using L<Capture::Tiny>."
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "Cannot be used together with C<capture_*> or C<tee_merged>."
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "=item * tee_merged => scalarref"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "Capture stdout and stderr in a single variable using L<Capture::Tiny>'s"
NSQ_SOURCE_LINE 00000649 "C<capture_merged>."
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "Cannot be used together with C<capture_*>, C<tee_stdout>, or C<tee_stderr>."
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "=item * chdir => str"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "Attempt to change to specified directory first and change back to the original"
NSQ_SOURCE_LINE 00000656 "directory after the command has been run. This is a convenient option so you can"
NSQ_SOURCE_LINE 00000657 "do this kind of task in a single call:"
NSQ_SOURCE_LINE 00000658 ""
NSQ_SOURCE_LINE 00000659 " {"
NSQ_SOURCE_LINE 00000660 "     my $cwd = getcwd();"
NSQ_SOURCE_LINE 00000661 "     chdir $dir or die;"
NSQ_SOURCE_LINE 00000662 "     system(...);"
NSQ_SOURCE_LINE 00000663 "     chdir $cwd or die;"
NSQ_SOURCE_LINE 00000664 " }"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "If the attempt to chdir before command execution fails, will die if C<die>"
NSQ_SOURCE_LINE 00000667 "option is set to true. Otherwise, C<$!> (OS error) will be set to the C<chdir()>"
NSQ_SOURCE_LINE 00000668 "error and to minimize surprise C<$?> (child exit code) will also be set to"
NSQ_SOURCE_LINE 00000669 "non-zero value (-1) even though at this point no child process has been run."
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "If the attempt to chdir back (after command execution) fails, will die if C<die>"
NSQ_SOURCE_LINE 00000672 "option is set to true. Otherwise, C<$!> will be set to the C<chdir()> error and"
NSQ_SOURCE_LINE 00000673 "C<$?> will be set to -1 only if C<$?> is zero. So if the command fails, C<$?>"
NSQ_SOURCE_LINE 00000674 "will contain the exit code of the command."
NSQ_SOURCE_LINE 00000675 ""
NSQ_SOURCE_LINE 00000676 "=item * dry_run => bool"
NSQ_SOURCE_LINE 00000677 ""
NSQ_SOURCE_LINE 00000678 "If set to true, then will only display what would be executed to STDERR (or log"
NSQ_SOURCE_LINE 00000679 "at C<warn> level, if C<log> option is true) instead of actually executing the"
NSQ_SOURCE_LINE 00000680 "command."
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "Will set C<$?> (child exit code) to 0."
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "An example of how this option can be used:"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 " system({ dry_run => $ENV{DRY_RUN} }, ...);"
NSQ_SOURCE_LINE 00000687 ""
NSQ_SOURCE_LINE 00000688 "This will allow you to run script in dry-run mode by setting environment"
NSQ_SOURCE_LINE 00000689 "variable."
NSQ_SOURCE_LINE 00000690 ""
NSQ_SOURCE_LINE 00000691 "=item * exit_code_success_criteria => int|array[int]|Regexp|code"
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "Specify which command exit codes are to be marked as success. For example, exit"
NSQ_SOURCE_LINE 00000694 "code 1 for the B<diff> command does not signify an error; it just means that the"
NSQ_SOURCE_LINE 00000695 "two input files are different. So in this case you can either specify one of:"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 " exit_code_success_criteria => [0,1]"
NSQ_SOURCE_LINE 00000698 " exit_code_success_criteria => qr/\\A(0|1)\\z/"
NSQ_SOURCE_LINE 00000699 " exit_code_success_criteria => sub { $_[0] == 0 || $_[0] == 1 }"
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "By default, if this option is not specified, non-zero exit codes count as"
NSQ_SOURCE_LINE 00000702 "failure."
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "Currently this only affects logging: when exit code is considered non-success, a"
NSQ_SOURCE_LINE 00000705 "warning log is produced and C<readpipe()> does not log the result."
NSQ_SOURCE_LINE 00000706 ""
NSQ_SOURCE_LINE 00000707 "=back"
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "=head2 readpipe"
NSQ_SOURCE_LINE 00000710 ""
NSQ_SOURCE_LINE 00000711 "Usage:"
NSQ_SOURCE_LINE 00000712 ""
NSQ_SOURCE_LINE 00000713 " readpipe([ \\%opts ], @args) => $output"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "Just like perl's C<readpipe()> (a.k.a. C<qx()> a.k.a. C<``> a.k.a. the backtick"
NSQ_SOURCE_LINE 00000716 "operator) except that it accepts an optional hash first argument to specify"
NSQ_SOURCE_LINE 00000717 "options. And it can accept multiple arguments (in which case, the arguments will"
NSQ_SOURCE_LINE 00000718 "be quoted for you, including proper quoting on Win32)."
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "Known options:"
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "=over"
NSQ_SOURCE_LINE 00000723 ""
NSQ_SOURCE_LINE 00000724 "=item * lang => str"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "=item * env => hash"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "=item * log => bool"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000735 ""
NSQ_SOURCE_LINE 00000736 "=item * die => bool"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "=item * capture_stdout => scalarref"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "=item * capture_stderr => scalarref"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "=item * capture_merged => scalarref"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "=item * tee_stdout => scalarref"
NSQ_SOURCE_LINE 00000753 ""
NSQ_SOURCE_LINE 00000754 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "=item * tee_stderr => scalarref"
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "=item * tee_merged => scalarref"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "=item * max_log_output => int"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "If set, will limit result length being logged. It's a good idea to set this"
NSQ_SOURCE_LINE 00000767 "(e.g. to 1024) if you expect some command to return large output."
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "=item * chdir => str"
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "=item * dry_run => bool"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "=item * exit_code_success_criteria => int|array[int]|Regexp|code"
NSQ_SOURCE_LINE 00000778 ""
NSQ_SOURCE_LINE 00000779 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "=back"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "=head2 run"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "Usage:"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 " run([ \\%opts ], @args) => $is_success"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "Like C<system()>, but uses L<IPC::Run>'s C<run()>. Known options:"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "=over"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "=item * lang => str"
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "=item * env => hash"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "=item * log => bool"
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "=item * die => bool"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "=item * capture_stdout => scalarref|coderef"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "=item * capture_stderr => scalarref|coderef"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "=item * stdin => scalar"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "Supply standard input."
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "=item * chdir => str"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "=item * dry_run => bool"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "=item * exit_code_success_criteria => int|array[int]|Regexp|code"
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "See option documentation in C<system()>."
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "=back"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "=head2 start"
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "Usage:"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 " start([ \\%opts ], @args) => $harness"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "Like C<run()>, but uses L<IPC::Run>'s C<start()>. For known options, see"
NSQ_SOURCE_LINE 00000842 "C<run()>."
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "Please visit the project's homepage at L<https://metacpan.org/release/IPC-System-Options>."
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "Source repository is at L<https://github.com/perlancar/perl-IPC-System-Options>."
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "L<IPC::System::Simple> also provides wrapper for C<system()> and C<readpipe()>"
NSQ_SOURCE_LINE 00000855 "with some additional behavior, although its scope is not as extensive as"
NSQ_SOURCE_LINE 00000856 "IPC::System::Options."
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "L<Proc::Govern> similarly provide a run+options function, with a different set"
NSQ_SOURCE_LINE 00000859 "of options, including system load watching, logging output to file, disabling"
NSQ_SOURCE_LINE 00000860 "and screensaver or power management."
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "perlancar <perlancar@cpan.org>"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "=head1 CONTRIBUTING"
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "To contribute, you can send patches by email/via RT, or send pull requests on"
NSQ_SOURCE_LINE 00000870 "GitHub."
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "Most of the time, you don't need to build the distribution yourself. You can"
NSQ_SOURCE_LINE 00000873 "simply modify the code, then test via:"
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 " % prove -l"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "If you want to build the distribution (e.g. to try to install it locally on your"
NSQ_SOURCE_LINE 00000878 "system), you can install L<Dist::Zilla>,"
NSQ_SOURCE_LINE 00000879 "L<Dist::Zilla::PluginBundle::Author::PERLANCAR>,"
NSQ_SOURCE_LINE 00000880 "L<Pod::Weaver::PluginBundle::Author::PERLANCAR>, and sometimes one or two other"
NSQ_SOURCE_LINE 00000881 "Dist::Zilla- and/or Pod::Weaver plugins. Any additional steps required beyond"
NSQ_SOURCE_LINE 00000882 "that are considered a bug and can be reported to me."
NSQ_SOURCE_LINE 00000883 ""
