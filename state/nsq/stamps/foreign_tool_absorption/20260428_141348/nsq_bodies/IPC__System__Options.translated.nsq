NSQ_SOURCE_LINE 00000320 "            }"
NSQ_SOURCE_LINE 00000321 "            if ($opts->{dry_run}) {"
NSQ_SOURCE_LINE 00000322 "                $child_error = 0;"
NSQ_SOURCE_LINE 00000323 "                $exit_code_is_success = 1;"
NSQ_SOURCE_LINE 00000324 "                $res = \"\";"
NSQ_SOURCE_LINE 00000325 "                goto CHECK_RESULT;"
NSQ_SOURCE_LINE 00000326 "            }"
NSQ_SOURCE_LINE 00000327 "        }"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "        require IPC::Run;"
NSQ_SOURCE_LINE 00000330 "        my $func = $which eq 'run' ? \"IPC::Run::run\" : \"IPC::Run::start\";"
NSQ_SOURCE_LINE 00000331 "        $res = &{$func}("
NSQ_SOURCE_LINE 00000332 "            \\@args,"
NSQ_SOURCE_LINE 00000333 "            defined($opts->{stdin}) ? \\$opts->{stdin} : \\*STDIN,"
NSQ_SOURCE_LINE 00000334 "            sub {"
