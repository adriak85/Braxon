BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Module::Pluggable;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use Module::Pluggable::Object;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use if $] > 5.017, 'deprecate';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "# ObQuote:"
NSQ_SOURCE_LINE 00000009 "# Bob Porter: Looks like you've been missing a lot of work lately."
NSQ_SOURCE_LINE 00000010 "# Peter Gibbons: I wouldn't say I've been missing it, Bob!"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our $VERSION = '6.3';"
NSQ_SOURCE_LINE 00000014 "our $FORCE_SEARCH_ALL_PATHS = 0;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub import {"
NSQ_SOURCE_LINE 00000017 "    my $class        = shift;"
NSQ_SOURCE_LINE 00000018 "    my %opts         = @_;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "    my ($pkg, $file) = caller;"
NSQ_SOURCE_LINE 00000021 "    # the default name for the method is 'plugins'"
NSQ_SOURCE_LINE 00000022 "    my $sub          = $opts{'sub_name'}  || 'plugins';"
NSQ_SOURCE_LINE 00000023 "    # get our package"
NSQ_SOURCE_LINE 00000024 "    my ($package)    = $opts{'package'} || $pkg;"
NSQ_SOURCE_LINE 00000025 "    $opts{filename}  = $file;"
NSQ_SOURCE_LINE 00000026 "    $opts{package}   = $package;"
NSQ_SOURCE_LINE 00000027 "    $opts{force_search_all_paths} = $FORCE_SEARCH_ALL_PATHS unless exists $opts{force_search_all_paths};"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    my $finder       = Module::Pluggable::Object->new(%opts);"
NSQ_SOURCE_LINE 00000031 "    my $subroutine   = sub { my $self = shift; return $finder->plugins(@_) };"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    my $search_path_sub = sub {"
NSQ_SOURCE_LINE 00000034 "              my $self = shift;"
NSQ_SOURCE_LINE 00000035 "              my ($action,@paths) = @_;"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "              $finder->{'search_path'} = [\"${package}::Plugin\"] if ($action eq 'add'  and not   $finder->{'search_path'} );"
NSQ_SOURCE_LINE 00000038 "              push @{$finder->{'search_path'}}, @paths      if ($action eq 'add');"
NSQ_SOURCE_LINE 00000039 "              $finder->{'search_path'}       = \\@paths      if ($action eq 'new');"
NSQ_SOURCE_LINE 00000040 "              return $finder->{'search_path'};"
NSQ_SOURCE_LINE 00000041 "    };"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    my $search_dirs_sub = sub {"
NSQ_SOURCE_LINE 00000044 "              my $self = shift;"
NSQ_SOURCE_LINE 00000045 "              my ($action,@paths) = @_;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "              $finder->{'search_dirs'} = [\"${package}::Plugin\"] if ($action eq 'add'  and not   $finder->{'search_dirs'} );"
NSQ_SOURCE_LINE 00000048 "              push @{$finder->{'search_dirs'}}, @paths      if ($action eq 'add');"
NSQ_SOURCE_LINE 00000049 "              $finder->{'search_dirs'}       = \\@paths      if ($action eq 'new');"
NSQ_SOURCE_LINE 00000050 "              return $finder->{'search_dirs'};"
NSQ_SOURCE_LINE 00000051 "    };"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    my $onlysub = sub {"
NSQ_SOURCE_LINE 00000054 "        my ($self, $only) = @_;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "        if (defined $only) {"
NSQ_SOURCE_LINE 00000057 "            $finder->{'only'} = $only;"
NSQ_SOURCE_LINE 00000058 "        };"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "        return $finder->{'only'};"
NSQ_SOURCE_LINE 00000061 "    };"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "    my $exceptsub = sub {"
NSQ_SOURCE_LINE 00000064 "        my ($self, $except) = @_;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "        if (defined $except) {"
NSQ_SOURCE_LINE 00000067 "            $finder->{'except'} = $except;"
NSQ_SOURCE_LINE 00000068 "        };"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "        return $finder->{'except'};"
NSQ_SOURCE_LINE 00000071 "    };"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000075 "    no warnings qw(redefine prototype);"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "    *{\"$package\\::$sub\"}        = $subroutine;"
NSQ_SOURCE_LINE 00000078 "    *{\"$package\\::search_path\"} = $search_path_sub;"
NSQ_SOURCE_LINE 00000079 "    *{\"$package\\::search_dirs\"} = $search_dirs_sub;"
NSQ_SOURCE_LINE 00000080 "    *{\"$package\\::only\"}        = $onlysub;"
NSQ_SOURCE_LINE 00000081 "    *{\"$package\\::except\"}      = $exceptsub;"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "}"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "1;"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "=pod"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "=head1 NAME"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "Module::Pluggable - automatically give your module the ability to have plugins"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "Simple use Module::Pluggable -"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "    package MyClass;"
NSQ_SOURCE_LINE 00000099 "    use Module::Pluggable;"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "and then later ..."
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    use MyClass;"
NSQ_SOURCE_LINE 00000105 "    my $mc = MyClass->new();"
NSQ_SOURCE_LINE 00000106 "    # returns the names of all plugins installed under MyClass::Plugin::*"
NSQ_SOURCE_LINE 00000107 "    my @plugins = $mc->plugins();"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=head1 EXAMPLE"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "Why would you want to do this? Say you have something that wants to pass an"
NSQ_SOURCE_LINE 00000112 "object to a number of different plugins in turn. For example you may"
NSQ_SOURCE_LINE 00000113 "want to extract meta-data from every email you get sent and do something"
NSQ_SOURCE_LINE 00000114 "with it. Plugins make sense here because then you can keep adding new"
NSQ_SOURCE_LINE 00000115 "meta data parsers and all the logic and docs for each one will be"
NSQ_SOURCE_LINE 00000116 "self contained and new handlers are easy to add without changing the"
NSQ_SOURCE_LINE 00000117 "core code. For that, you might do something like ..."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "    package Email::Examiner;"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "    use strict;"
NSQ_SOURCE_LINE 00000122 "    use Email::Simple;"
NSQ_SOURCE_LINE 00000123 "    use Module::Pluggable require => 1;"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "    sub handle_email {"
NSQ_SOURCE_LINE 00000126 "        my $self  = shift;"
NSQ_SOURCE_LINE 00000127 "        my $email = shift;"
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "        foreach my $plugin ($self->plugins) {"
NSQ_SOURCE_LINE 00000130 "            $plugin->examine($email);"
NSQ_SOURCE_LINE 00000131 "        }"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "        return 1;"
NSQ_SOURCE_LINE 00000134 "    }"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 ".. and all the plugins will get a chance in turn to look at it."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "This can be trivially extended so that plugins could save the email"
NSQ_SOURCE_LINE 00000141 "somewhere and then no other plugin should try and do that."
NSQ_SOURCE_LINE 00000142 "Simply have it so that the C<examine> method returns C<1> if"
NSQ_SOURCE_LINE 00000143 "it has saved the email somewhere. You might also want to be paranoid"
NSQ_SOURCE_LINE 00000144 "and check to see if the plugin has an C<examine> method."
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "        foreach my $plugin ($self->plugins) {"
NSQ_SOURCE_LINE 00000147 "            next unless $plugin->can('examine');"
NSQ_SOURCE_LINE 00000148 "            last if     $plugin->examine($email);"
NSQ_SOURCE_LINE 00000149 "        }"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "And so on. The sky's the limit."
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "Provides a simple but, hopefully, extensible way of having 'plugins' for"
NSQ_SOURCE_LINE 00000158 "your module. Obviously this isn't going to be the be all and end all of"
NSQ_SOURCE_LINE 00000159 "solutions but it works for me."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "Essentially all it does is export a method into your namespace that"
NSQ_SOURCE_LINE 00000162 "looks through a search path for .pm files and turn those into class names."
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "Optionally it instantiates those classes for you."
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=head1 ADVANCED USAGE"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "Alternatively, if you don't want to use 'plugins' as the method ..."
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "    package MyClass;"
NSQ_SOURCE_LINE 00000171 "    use Module::Pluggable sub_name => 'foo';"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "and then later ..."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    my @plugins = $mc->foo();"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "Or if you want to look in another namespace"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "    package MyClass;"
NSQ_SOURCE_LINE 00000182 "    use Module::Pluggable search_path => ['Acme::MyClass::Plugin', 'MyClass::Extend'];"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "or directory"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "    use Module::Pluggable search_dirs => ['mylibs/Foo'];"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "Or if you want to instantiate each plugin rather than just return the name"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "    package MyClass;"
NSQ_SOURCE_LINE 00000192 "    use Module::Pluggable instantiate => 'new';"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "and then"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "    # whatever is passed to 'plugins' will be passed"
NSQ_SOURCE_LINE 00000197 "    # to 'new' for each plugin"
NSQ_SOURCE_LINE 00000198 "    my @plugins = $mc->plugins(@options);"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "alternatively you can just require the module without instantiating it"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    package MyClass;"
NSQ_SOURCE_LINE 00000204 "    use Module::Pluggable require => 1;"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "since requiring automatically searches inner packages, which may not be desirable, you can turn this off"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 ""
NSQ_SOURCE_LINE 00000209 "    package MyClass;"
NSQ_SOURCE_LINE 00000210 "    use Module::Pluggable require => 1, inner => 0;"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "You can limit the plugins loaded using the except option, either as a string,"
NSQ_SOURCE_LINE 00000214 "array ref or regex"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "    package MyClass;"
NSQ_SOURCE_LINE 00000217 "    use Module::Pluggable except => 'MyClass::Plugin::Foo';"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "or"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "    package MyClass;"
NSQ_SOURCE_LINE 00000222 "    use Module::Pluggable except => ['MyClass::Plugin::Foo', 'MyClass::Plugin::Bar'];"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "or"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "    package MyClass;"
NSQ_SOURCE_LINE 00000227 "    use Module::Pluggable except => qr/^MyClass::Plugin::(Foo|Bar)$/;"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "and similarly for only which will only load plugins which match."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "Remember you can use the module more than once"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "    package MyClass;"
NSQ_SOURCE_LINE 00000235 "    use Module::Pluggable search_path => 'MyClass::Filters', sub_name => 'filters';"
NSQ_SOURCE_LINE 00000236 "    use Module::Pluggable search_path => 'MyClass::Plugins', sub_name => 'plugins';"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "and then later ..."
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "    my @filters = $self->filters;"
NSQ_SOURCE_LINE 00000241 "    my @plugins = $self->plugins;"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "=head1 PLUGIN SEARCHING"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "Every time you call 'plugins' the whole search path is walked again. This allows"
NSQ_SOURCE_LINE 00000246 "for dynamically loading plugins even at run time. However this can get expensive"
NSQ_SOURCE_LINE 00000247 "and so if you don't expect to want to add new plugins at run time you could do"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "  package Foo;"
NSQ_SOURCE_LINE 00000251 "  use strict;"
NSQ_SOURCE_LINE 00000252 "  use Module::Pluggable sub_name => '_plugins';"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "  our @PLUGINS;"
NSQ_SOURCE_LINE 00000255 "  sub plugins { @PLUGINS ||= shift->_plugins }"
NSQ_SOURCE_LINE 00000256 "  1;"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=head1 INNER PACKAGES"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "If you have, for example, a file B<lib/Something/Plugin/Foo.pm> that"
NSQ_SOURCE_LINE 00000261 "contains package definitions for both C<Something::Plugin::Foo> and"
NSQ_SOURCE_LINE 00000262 "C<Something::Plugin::Bar> then as long as you either have either"
NSQ_SOURCE_LINE 00000263 "the B<require> or B<instantiate> option set then we'll also find"
NSQ_SOURCE_LINE 00000264 "C<Something::Plugin::Bar>. Nifty!"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "=head1 OPTIONS"
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "You can pass a hash of options when importing this module."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "The options can be ..."
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "=head2 sub_name"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "The name of the subroutine to create in your namespace."
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "By default this is 'plugins'"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head2 search_path"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "An array ref of namespaces to look in."
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "=head2 search_dirs"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "An array ref of directories to look in before @INC."
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "=head2 instantiate"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "Call this method on the class. In general this will probably be 'new'"
NSQ_SOURCE_LINE 00000289 "but it can be whatever you want. Whatever arguments are passed to 'plugins'"
NSQ_SOURCE_LINE 00000290 "will be passed to the method."
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "The default is 'undef' i.e just return the class name."
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "=head2 require"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "Just require the class, don't instantiate (overrides 'instantiate');"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "=head2 inner"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "If set to 0 will B<not> search inner packages."
NSQ_SOURCE_LINE 00000301 "If set to 1 will override C<require>."
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=head2 only"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "Takes a string, array ref or regex describing the names of the only plugins to"
NSQ_SOURCE_LINE 00000306 "return. Whilst this may seem perverse ... well, it is. But it also"
NSQ_SOURCE_LINE 00000307 "makes sense. Trust me."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "=head2 except"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "Similar to C<only> it takes a description of plugins to exclude"
NSQ_SOURCE_LINE 00000312 "from returning. This is slightly less perverse."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "=head2 package"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "This is for use by extension modules which build on C<Module::Pluggable>:"
NSQ_SOURCE_LINE 00000317 "passing a C<package> option allows you to place the plugin method in a"
NSQ_SOURCE_LINE 00000318 "different package other than your own."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "=head2 file_regex"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "By default C<Module::Pluggable> only looks for I<.pm> files."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "By supplying a new C<file_regex> then you can change this behaviour e.g"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "    file_regex => qr/\\.plugin$/"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "=head2 include_editor_junk"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "By default C<Module::Pluggable> ignores files that look like they were"
NSQ_SOURCE_LINE 00000331 "left behind by editors. Currently this means files ending in F<~> (~),"
NSQ_SOURCE_LINE 00000332 "the extensions F<.swp> or F<.swo>, or files beginning with F<.#>."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "Setting C<include_editor_junk> changes C<Module::Pluggable> so it does"
NSQ_SOURCE_LINE 00000335 "not ignore any files it finds."
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "=head2 follow_symlinks"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "Whether, when searching directories, to follow symlinks."
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "Defaults to 1 i.e do follow symlinks."
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "=head2 min_depth, max_depth"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "This will allow you to set what 'depth' of plugin will be allowed."
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "So, for example, C<MyClass::Plugin::Foo> will have a depth of 3 and"
NSQ_SOURCE_LINE 00000348 "C<MyClass::Plugin::Foo::Bar> will have a depth of 4 so to only get the former"
NSQ_SOURCE_LINE 00000349 "(i.e C<MyClass::Plugin::Foo>) do"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "        package MyClass;"
NSQ_SOURCE_LINE 00000352 "        use Module::Pluggable max_depth => 3;"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "and to only get the latter (i.e C<MyClass::Plugin::Foo::Bar>)"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "        package MyClass;"
NSQ_SOURCE_LINE 00000357 "        use Module::Pluggable min_depth => 4;"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "=head1 TRIGGERS"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "Various triggers can also be passed in to the options."
NSQ_SOURCE_LINE 00000363 ""
NSQ_SOURCE_LINE 00000364 "If any of these triggers return 0 then the plugin will not be returned."
NSQ_SOURCE_LINE 00000365 ""
NSQ_SOURCE_LINE 00000366 "=head2 before_require <plugin>"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "Gets passed the plugin name."
NSQ_SOURCE_LINE 00000369 ""
NSQ_SOURCE_LINE 00000370 "If 0 is returned then this plugin will not be required either."
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "=head2 on_require_error <plugin> <err>"
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "Gets called when there's an error on requiring the plugin."
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "Gets passed the plugin name and the error."
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "The default on_require_error handler is to C<carp> the error and return 0."
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=head2 after_require <plugin>"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "Gets passed the plugin name."
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "If 0 is returned then this plugin will be required but not instantiated or"
NSQ_SOURCE_LINE 00000385 "returned as a plugin."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "=head2 before_instantiate <plugin>"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "Gets passed the plugin name."
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "If 0 is returned, then instantiation will not occur."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "=head2 on_instantiate_error <plugin> <err>"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "Gets called when there's an error on instantiating the plugin."
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "Gets passed the plugin name and the error."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "The default on_instantiate_error handler is to C<carp> the error and return 0."
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=head2 after_instantiate <plugin> <obj>"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "Gets passed the plugin name and the object that was instentiated."
NSQ_SOURCE_LINE 00000404 "i.e. the return value of C<Plugin->new()>"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "The return value must be <obj> and will be returned AS the plugin."
NSQ_SOURCE_LINE 00000407 "If the return value is not true, then nothing will be returned as a plugin."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "=head1 METHODs"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=head2 search_path"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "The method C<search_path> is exported into you namespace as well."
NSQ_SOURCE_LINE 00000414 "You can call that at any time to change or replace the"
NSQ_SOURCE_LINE 00000415 "search_path."
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "    $self->search_path( add => \"New::Path\" ); # add"
NSQ_SOURCE_LINE 00000418 "    $self->search_path( new => \"New::Path\" ); # replace"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "=head1 BEHAVIOUR UNDER TEST ENVIRONMENT"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "In order to make testing reliable we exclude anything not from blib if blib.pm is"
NSQ_SOURCE_LINE 00000423 "in %INC."
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "However if the module being tested used another module that itself used C<Module::Pluggable>"
NSQ_SOURCE_LINE 00000426 "then the second module would fail. This was fixed by checking to see if the caller"
NSQ_SOURCE_LINE 00000427 "had (^|/)blib/ in their filename."
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "There's an argument that this is the wrong behaviour and that modules should explicitly"
NSQ_SOURCE_LINE 00000430 "trigger this behaviour but that particular code has been around for 7 years now and I'm"
NSQ_SOURCE_LINE 00000431 "reluctant to change the default behaviour."
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "You can now (as of version 4.1) force Module::Pluggable to look outside blib in a test environment by doing either"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "        require Module::Pluggable;"
NSQ_SOURCE_LINE 00000436 "        $Module::Pluggable::FORCE_SEARCH_ALL_PATHS = 1;"
NSQ_SOURCE_LINE 00000437 "        import Module::Pluggable;"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "or"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "        use Module::Pluggable force_search_all_paths => 1;"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "=head1 @INC hooks and App::FatPacker"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "If a module's @INC has a hook and that hook is an object which has a C<files()> method then we will"
NSQ_SOURCE_LINE 00000446 "try and require those files too. See C<t/26inc_hook.t> for an example."
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "This has allowed L<App::FatPacker> (as of version 0.10.0) to provide support for Module::Pluggable."
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "This should also, theoretically, allow someone to modify PAR to do the same thing."
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "=head1 Module::Require recommended"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "Up until version 5.2 L<Module::Pluggable> used a string C<eval> to require plugins."
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "This has now been changed to optionally use L<Module::Runtime> and it's C<require_module> method when"
NSQ_SOURCE_LINE 00000457 "available and fall back to using a path based C<require> when not."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "It's recommended, but not required, that you install Module::Runtime."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "=head1 FUTURE PLANS"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "This does everything I need and I can't really think of any other"
NSQ_SOURCE_LINE 00000464 "features I want to add. Famous last words of course (not least"
NSQ_SOURCE_LINE 00000465 "because we're up to version 5.0 at the time of writing)."
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "However suggestions (and patches) are always welcome."
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=head1 DEVELOPMENT"
