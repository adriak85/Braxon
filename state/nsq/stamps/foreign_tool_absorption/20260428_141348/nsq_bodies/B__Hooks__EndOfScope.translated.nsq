NSQ_SOURCE_LINE 00000001 "package B::Hooks::EndOfScope; # git description: 0.27-8-gbe15c53"
NSQ_SOURCE_LINE 00000002 "# ABSTRACT: Execute code after a scope finished compilation"
NSQ_SOURCE_LINE 00000003 "# KEYWORDS: code hooks execution scope"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "our $VERSION = '0.28';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use 5.006001;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "BEGIN {"
NSQ_SOURCE_LINE 00000013 "  use Module::Implementation 0.05;"
NSQ_SOURCE_LINE 00000014 "  Module::Implementation::build_loader_sub("
NSQ_SOURCE_LINE 00000015 "    implementations => [ 'XS', 'PP' ],"
NSQ_SOURCE_LINE 00000016 "    symbols => [ 'on_scope_end' ],"
NSQ_SOURCE_LINE 00000017 "  )->();"
NSQ_SOURCE_LINE 00000018 "}"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "use Sub::Exporter::Progressive 0.001006 -setup => {"
NSQ_SOURCE_LINE 00000021 "  exports => [ 'on_scope_end' ],"
NSQ_SOURCE_LINE 00000022 "  groups  => { default => ['on_scope_end'] },"
NSQ_SOURCE_LINE 00000023 "};"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "1;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "__END__"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "=pod"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=head1 NAME"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "B::Hooks::EndOfScope - Execute code after a scope finished compilation"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=head1 VERSION"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "version 0.28"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    on_scope_end { ... };"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "This module allows you to execute code when perl finished compiling the"
NSQ_SOURCE_LINE 00000048 "surrounding scope."
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=head2 on_scope_end"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    on_scope_end { ... };"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    on_scope_end $code;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "Registers C<$code> to be executed after the surrounding scope has been"
NSQ_SOURCE_LINE 00000059 "compiled."
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "This is exported by default. See L<Sub::Exporter> on how to customize it."
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=head1 LIMITATIONS"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "=head2 Pure-perl mode caveat"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "This caveat applies to B<any> version of perl where L<Variable::Magic>"
NSQ_SOURCE_LINE 00000068 "is unavailable or otherwise disabled."
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "While L<Variable::Magic> has access to some very dark sorcery to make it"
NSQ_SOURCE_LINE 00000071 "possible to throw an exception from within a callback, the pure-perl"
NSQ_SOURCE_LINE 00000072 "implementation does not have access to these hacks. Therefore, what"
NSQ_SOURCE_LINE 00000073 "would have been a B<compile-time exception> is instead B<converted to a"
NSQ_SOURCE_LINE 00000074 "warning>, and your execution will continue as if the exception never"
NSQ_SOURCE_LINE 00000075 "happened."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "To explicitly request an XS (or PP) implementation one has two choices. Either"
NSQ_SOURCE_LINE 00000078 "to import from the desired implementation explicitly:"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 " use B::Hooks::EndOfScope::XS"
NSQ_SOURCE_LINE 00000081 "   or"
NSQ_SOURCE_LINE 00000082 " use B::Hooks::EndOfScope::PP"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "or by setting C<$ENV{B_HOOKS_ENDOFSCOPE_IMPLEMENTATION}> to either C<XS> or"
NSQ_SOURCE_LINE 00000085 "C<PP>."
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "=head2 Perl 5.8.0 ~ 5.8.3"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "Due to a L<core interpreter bug"
NSQ_SOURCE_LINE 00000090 "|https://rt.perl.org/Public/Bug/Display.html?id=27040#txn-82797> present in"
NSQ_SOURCE_LINE 00000091 "older perl versions, the implementation of B::Hooks::EndOfScope deliberately"
NSQ_SOURCE_LINE 00000092 "leaks a single empty hash for every scope being cleaned. This is done to"
NSQ_SOURCE_LINE 00000093 "avoid the memory corruption associated with the bug mentioned above."
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "In order to stabilize this workaround use of L<Variable::Magic> is disabled"
NSQ_SOURCE_LINE 00000096 "on perls prior to version 5.8.4. On such systems loading/requesting"
NSQ_SOURCE_LINE 00000097 "L<B::Hooks::EndOfScope::XS> explicitly will result in a compile-time"
NSQ_SOURCE_LINE 00000098 "exception."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=head2 Perl versions 5.6.x"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "Versions of perl before 5.8.0 lack a feature allowing changing the visibility"
NSQ_SOURCE_LINE 00000103 "of C<%^H> via setting bit 17 within C<$^H>. As such the only way to achieve"
NSQ_SOURCE_LINE 00000104 "the effect necessary for this module to work, is to use the C<local> operator"
NSQ_SOURCE_LINE 00000105 "explicitly on these platforms. This might lead to unexpected interference"
NSQ_SOURCE_LINE 00000106 "with other scope-driven libraries relying on the same mechanism. On the flip"
NSQ_SOURCE_LINE 00000107 "side there are no such known incompatibilities at the time this note was"
NSQ_SOURCE_LINE 00000108 "written."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "For further details on the unavailable behavior please refer to the test"
NSQ_SOURCE_LINE 00000111 "file F<t/02-localise.t> included with the distribution."
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "L<Sub::Exporter>"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "L<Variable::Magic>"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "Bugs may be submitted through L<the RT bug tracker|https://rt.cpan.org/Public/Dist/Display.html?Name=B-Hooks-EndOfScope>"
NSQ_SOURCE_LINE 00000122 "(or L<bug-B-Hooks-EndOfScope@rt.cpan.org|mailto:bug-B-Hooks-EndOfScope@rt.cpan.org>)."
