NSQ_SOURCE_LINE 00000001 "package Hash::Merge;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Carp;"
NSQ_SOURCE_LINE 00000007 "use Clone::Choose 0.008;"
NSQ_SOURCE_LINE 00000008 "use Scalar::Util qw(blessed weaken);"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use base 'Exporter';"
NSQ_SOURCE_LINE 00000011 "our $CONTEXT;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our $VERSION     = '0.302';"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK   = qw( merge _hashify _merge_hashes );"
NSQ_SOURCE_LINE 00000015 "our %EXPORT_TAGS = ('custom' => [qw( _hashify _merge_hashes )]);"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "sub _init"
NSQ_SOURCE_LINE 00000018 "{"
NSQ_SOURCE_LINE 00000019 "    my $self = shift;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "    my $weak = $self;"
NSQ_SOURCE_LINE 00000022 "    weaken $weak;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "    defined $self->{behaviors}"
NSQ_SOURCE_LINE 00000025 "      or $self->{behaviors} = {"
NSQ_SOURCE_LINE 00000026 "        'LEFT_PRECEDENT' => {"
NSQ_SOURCE_LINE 00000027 "            'SCALAR' => {"
NSQ_SOURCE_LINE 00000028 "                'SCALAR' => sub { $_[0] },"
NSQ_SOURCE_LINE 00000029 "                'ARRAY'  => sub { $_[0] },"
NSQ_SOURCE_LINE 00000030 "                'HASH'   => sub { $_[0] },"
NSQ_SOURCE_LINE 00000031 "            },"
NSQ_SOURCE_LINE 00000032 "            'ARRAY' => {"
NSQ_SOURCE_LINE 00000033 "                'SCALAR' => sub { [@{$_[0]}, $_[1]] },"
NSQ_SOURCE_LINE 00000034 "                'ARRAY'  => sub { [@{$_[0]}, @{$_[1]}] },"
NSQ_SOURCE_LINE 00000035 "                'HASH'   => sub { [@{$_[0]}, values %{$_[1]}] },"
NSQ_SOURCE_LINE 00000036 "            },"
NSQ_SOURCE_LINE 00000037 "            'HASH' => {"
NSQ_SOURCE_LINE 00000038 "                'SCALAR' => sub { $_[0] },"
NSQ_SOURCE_LINE 00000039 "                'ARRAY'  => sub { $_[0] },"
NSQ_SOURCE_LINE 00000040 "                'HASH'   => sub { $weak->_merge_hashes($_[0], $_[1]) },"
NSQ_SOURCE_LINE 00000041 "            },"
NSQ_SOURCE_LINE 00000042 "        },"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "        'RIGHT_PRECEDENT' => {"
NSQ_SOURCE_LINE 00000045 "            'SCALAR' => {"
NSQ_SOURCE_LINE 00000046 "                'SCALAR' => sub { $_[1] },"
NSQ_SOURCE_LINE 00000047 "                'ARRAY'  => sub { [$_[0], @{$_[1]}] },"
NSQ_SOURCE_LINE 00000048 "                'HASH'   => sub { $_[1] },"
NSQ_SOURCE_LINE 00000049 "            },"
NSQ_SOURCE_LINE 00000050 "            'ARRAY' => {"
NSQ_SOURCE_LINE 00000051 "                'SCALAR' => sub { $_[1] },"
NSQ_SOURCE_LINE 00000052 "                'ARRAY'  => sub { [@{$_[0]}, @{$_[1]}] },"
NSQ_SOURCE_LINE 00000053 "                'HASH'   => sub { $_[1] },"
NSQ_SOURCE_LINE 00000054 "            },"
NSQ_SOURCE_LINE 00000055 "            'HASH' => {"
NSQ_SOURCE_LINE 00000056 "                'SCALAR' => sub { $_[1] },"
NSQ_SOURCE_LINE 00000057 "                'ARRAY'  => sub { [values %{$_[0]}, @{$_[1]}] },"
NSQ_SOURCE_LINE 00000058 "                'HASH'   => sub { $weak->_merge_hashes($_[0], $_[1]) },"
NSQ_SOURCE_LINE 00000059 "            },"
NSQ_SOURCE_LINE 00000060 "        },"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "        'STORAGE_PRECEDENT' => {"
NSQ_SOURCE_LINE 00000063 "            'SCALAR' => {"
NSQ_SOURCE_LINE 00000064 "                'SCALAR' => sub { $_[0] },"
NSQ_SOURCE_LINE 00000065 "                'ARRAY'  => sub { [$_[0], @{$_[1]}] },"
NSQ_SOURCE_LINE 00000066 "                'HASH'   => sub { $_[1] },"
NSQ_SOURCE_LINE 00000067 "            },"
NSQ_SOURCE_LINE 00000068 "            'ARRAY' => {"
NSQ_SOURCE_LINE 00000069 "                'SCALAR' => sub { [@{$_[0]}, $_[1]] },"
NSQ_SOURCE_LINE 00000070 "                'ARRAY'  => sub { [@{$_[0]}, @{$_[1]}] },"
NSQ_SOURCE_LINE 00000071 "                'HASH'   => sub { $_[1] },"
NSQ_SOURCE_LINE 00000072 "            },"
NSQ_SOURCE_LINE 00000073 "            'HASH' => {"
NSQ_SOURCE_LINE 00000074 "                'SCALAR' => sub { $_[0] },"
NSQ_SOURCE_LINE 00000075 "                'ARRAY'  => sub { $_[0] },"
NSQ_SOURCE_LINE 00000076 "                'HASH'   => sub { $weak->_merge_hashes($_[0], $_[1]) },"
NSQ_SOURCE_LINE 00000077 "            },"
NSQ_SOURCE_LINE 00000078 "        },"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "        'RETAINMENT_PRECEDENT' => {"
NSQ_SOURCE_LINE 00000081 "            'SCALAR' => {"
NSQ_SOURCE_LINE 00000082 "                'SCALAR' => sub { [$_[0], $_[1]] },"
NSQ_SOURCE_LINE 00000083 "                'ARRAY'  => sub { [$_[0], @{$_[1]}] },"
NSQ_SOURCE_LINE 00000084 "                'HASH'   => sub { $weak->_merge_hashes($weak->_hashify($_[0]), $_[1]) },"
NSQ_SOURCE_LINE 00000085 "            },"
NSQ_SOURCE_LINE 00000086 "            'ARRAY' => {"
NSQ_SOURCE_LINE 00000087 "                'SCALAR' => sub { [@{$_[0]}, $_[1]] },"
NSQ_SOURCE_LINE 00000088 "                'ARRAY'  => sub { [@{$_[0]}, @{$_[1]}] },"
NSQ_SOURCE_LINE 00000089 "                'HASH'   => sub { $weak->_merge_hashes($weak->_hashify($_[0]), $_[1]) },"
NSQ_SOURCE_LINE 00000090 "            },"
NSQ_SOURCE_LINE 00000091 "            'HASH' => {"
NSQ_SOURCE_LINE 00000092 "                'SCALAR' => sub { $weak->_merge_hashes($_[0], $weak->_hashify($_[1])) },"
NSQ_SOURCE_LINE 00000093 "                'ARRAY'  => sub { $weak->_merge_hashes($_[0], $weak->_hashify($_[1])) },"
NSQ_SOURCE_LINE 00000094 "                'HASH'   => sub { $weak->_merge_hashes($_[0], $_[1]) },"
NSQ_SOURCE_LINE 00000095 "            },"
NSQ_SOURCE_LINE 00000096 "        },"
NSQ_SOURCE_LINE 00000097 "      };"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    defined $self->{behavior} or $self->{behavior} = 'LEFT_PRECEDENT';"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    croak \"Behavior '$self->{behavior}' does not exist\""
NSQ_SOURCE_LINE 00000102 "      if !exists $self->{behaviors}{$self->{behavior}};"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    $self->{matrix} = $self->{behaviors}{$self->{behavior}};"
NSQ_SOURCE_LINE 00000105 "    $self->{clone}  = 1;"
NSQ_SOURCE_LINE 00000106 "}"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "sub new"
NSQ_SOURCE_LINE 00000109 "{"
NSQ_SOURCE_LINE 00000110 "    my ($pkg, $beh) = @_;"
NSQ_SOURCE_LINE 00000111 "    $pkg = ref $pkg || $pkg;"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "    my $instance = bless {($beh ? (behavior => $beh) : ())}, $pkg;"
NSQ_SOURCE_LINE 00000114 "    $instance->_init;"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    return $instance;"
NSQ_SOURCE_LINE 00000117 "}"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "sub set_behavior"
NSQ_SOURCE_LINE 00000120 "{"
NSQ_SOURCE_LINE 00000121 "    my $self  = &_get_obj;    # '&' + no args modifies current @_"
NSQ_SOURCE_LINE 00000122 "    my $value = shift;"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "    my @behaviors = grep { /^$value$/i } keys %{$self->{'behaviors'}};"
NSQ_SOURCE_LINE 00000125 "    if (scalar @behaviors == 0)"
NSQ_SOURCE_LINE 00000126 "    {"
NSQ_SOURCE_LINE 00000127 "        carp 'Behavior must be one of : ' . join(', ', keys %{$self->{'behaviors'}});"
NSQ_SOURCE_LINE 00000128 "        return;"
NSQ_SOURCE_LINE 00000129 "    }"
NSQ_SOURCE_LINE 00000130 "    if (scalar @behaviors > 1)"
NSQ_SOURCE_LINE 00000131 "    {"
NSQ_SOURCE_LINE 00000132 "        croak 'Behavior must be unique in uppercase letters! You specified: ' . join ', ', @behaviors;"
NSQ_SOURCE_LINE 00000133 "    }"
NSQ_SOURCE_LINE 00000134 "    if (scalar @behaviors == 1)"
NSQ_SOURCE_LINE 00000135 "    {"
NSQ_SOURCE_LINE 00000136 "        $value = $behaviors[0];"
NSQ_SOURCE_LINE 00000137 "    }"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    my $oldvalue = $self->{'behavior'};"
NSQ_SOURCE_LINE 00000140 "    $self->{'behavior'} = $value;"
NSQ_SOURCE_LINE 00000141 "    $self->{'matrix'}   = $self->{'behaviors'}{$value};"
NSQ_SOURCE_LINE 00000142 "    return $oldvalue;    # Use classic POSIX pattern for get/set: set returns previous value"
NSQ_SOURCE_LINE 00000143 "}"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "sub get_behavior"
NSQ_SOURCE_LINE 00000146 "{"
NSQ_SOURCE_LINE 00000147 "    my $self = &_get_obj;    # '&' + no args modifies current @_"
NSQ_SOURCE_LINE 00000148 "    return $self->{'behavior'};"
NSQ_SOURCE_LINE 00000149 "}"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "sub add_behavior_spec"
NSQ_SOURCE_LINE 00000152 "{"
NSQ_SOURCE_LINE 00000153 "    my $self = &_get_obj;    # '&' + no args modifies current @_"
NSQ_SOURCE_LINE 00000154 "    my ($matrix, $name) = @_;"
NSQ_SOURCE_LINE 00000155 "    $name ||= 'user defined';"
NSQ_SOURCE_LINE 00000156 "    if (exists $self->{'behaviors'}{$name})"
NSQ_SOURCE_LINE 00000157 "    {"
NSQ_SOURCE_LINE 00000158 "        carp \"Behavior '$name' was already defined. Please take another name\";"
NSQ_SOURCE_LINE 00000159 "        return;"
NSQ_SOURCE_LINE 00000160 "    }"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "    my @required = qw( SCALAR ARRAY HASH );"
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "    foreach my $left (@required)"
NSQ_SOURCE_LINE 00000165 "    {"
NSQ_SOURCE_LINE 00000166 "        foreach my $right (@required)"
NSQ_SOURCE_LINE 00000167 "        {"
NSQ_SOURCE_LINE 00000168 "            if (!exists $matrix->{$left}->{$right})"
NSQ_SOURCE_LINE 00000169 "            {"
NSQ_SOURCE_LINE 00000170 "                carp \"Behavior does not specify action for '$left' merging with '$right'\";"
NSQ_SOURCE_LINE 00000171 "                return;"
NSQ_SOURCE_LINE 00000172 "            }"
NSQ_SOURCE_LINE 00000173 "        }"
NSQ_SOURCE_LINE 00000174 "    }"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "    $self->{'behavior'} = $name;"
NSQ_SOURCE_LINE 00000177 "    $self->{'behaviors'}{$name} = $self->{'matrix'} = $matrix;"
NSQ_SOURCE_LINE 00000178 "}"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "no strict \"refs\";"
NSQ_SOURCE_LINE 00000181 "*specify_behavior = \\&add_behavior_spec;"
NSQ_SOURCE_LINE 00000182 "use strict;"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "sub get_behavior_spec"
NSQ_SOURCE_LINE 00000185 "{"
NSQ_SOURCE_LINE 00000186 "    my $self = &_get_obj;    # '&' + no args modifies current @_"
NSQ_SOURCE_LINE 00000187 "    my ($name) = @_;"
NSQ_SOURCE_LINE 00000188 "    $name ||= 'user defined';"
NSQ_SOURCE_LINE 00000189 "    exists $self->{'behaviors'}{$name} and return $self->{'behaviors'}{$name};"
NSQ_SOURCE_LINE 00000190 "  return:"
NSQ_SOURCE_LINE 00000191 "}"
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "sub set_clone_behavior"
NSQ_SOURCE_LINE 00000194 "{"
NSQ_SOURCE_LINE 00000195 "    my $self     = &_get_obj;          # '&' + no args modifies current @_"
NSQ_SOURCE_LINE 00000196 "    my $oldvalue = $self->{'clone'};"
NSQ_SOURCE_LINE 00000197 "    $self->{'clone'} = shift() ? 1 : 0;"
NSQ_SOURCE_LINE 00000198 "    return $oldvalue;"
NSQ_SOURCE_LINE 00000199 "}"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "sub get_clone_behavior"
NSQ_SOURCE_LINE 00000202 "{"
NSQ_SOURCE_LINE 00000203 "    my $self = &_get_obj;              # '&' + no args modifies current @_"
NSQ_SOURCE_LINE 00000204 "    return $self->{'clone'};"
NSQ_SOURCE_LINE 00000205 "}"
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "sub merge"
NSQ_SOURCE_LINE 00000208 "{"
NSQ_SOURCE_LINE 00000209 "    my $self = &_get_obj;              # '&' + no args modifies current @_"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "    my ($left, $right) = @_;"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "    # For the general use of this module, we want to create duplicates"
NSQ_SOURCE_LINE 00000214 "    # of all data that is merged.  This behavior can be shut off, but"
NSQ_SOURCE_LINE 00000215 "    # can create havoc if references are used heavily."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "    my $lefttype = ref($left);"
NSQ_SOURCE_LINE 00000218 "    $lefttype = \"SCALAR\" unless defined $lefttype and defined $self->{'matrix'}->{$lefttype};"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "    my $righttype = ref($right);"
NSQ_SOURCE_LINE 00000221 "    $righttype = \"SCALAR\" unless defined $righttype and defined $self->{'matrix'}->{$righttype};"
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "    if ($self->{'clone'})"
NSQ_SOURCE_LINE 00000224 "    {"
NSQ_SOURCE_LINE 00000225 "        $left  = ref($left)  ? clone($left)  : $left;"
NSQ_SOURCE_LINE 00000226 "        $right = ref($right) ? clone($right) : $right;"
NSQ_SOURCE_LINE 00000227 "    }"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "    local $CONTEXT = $self;"
NSQ_SOURCE_LINE 00000230 "    return $self->{'matrix'}->{$lefttype}{$righttype}->($left, $right);"
NSQ_SOURCE_LINE 00000231 "}"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "# This does a straight merge of hashes, delegating the merge-specific"
NSQ_SOURCE_LINE 00000234 "# work to 'merge'"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "sub _merge_hashes"
NSQ_SOURCE_LINE 00000237 "{"
NSQ_SOURCE_LINE 00000238 "    my $self = &_get_obj;    # '&' + no args modifies current @_"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "    my ($left, $right) = (shift, shift);"
NSQ_SOURCE_LINE 00000241 "    if (ref $left ne 'HASH' || ref $right ne 'HASH')"
NSQ_SOURCE_LINE 00000242 "    {"
NSQ_SOURCE_LINE 00000243 "        carp 'Arguments for _merge_hashes must be hash references';"
NSQ_SOURCE_LINE 00000244 "        return;"
NSQ_SOURCE_LINE 00000245 "    }"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    my %newhash;"
NSQ_SOURCE_LINE 00000248 "    foreach my $key (keys %$left)"
NSQ_SOURCE_LINE 00000249 "    {"
NSQ_SOURCE_LINE 00000250 "        $newhash{$key} ="
NSQ_SOURCE_LINE 00000251 "          exists $right->{$key}"
NSQ_SOURCE_LINE 00000252 "          ? $self->merge($left->{$key}, $right->{$key})"
NSQ_SOURCE_LINE 00000253 "          : $left->{$key};"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "    }"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    foreach my $key (grep { !exists $left->{$_} } keys %$right)"
NSQ_SOURCE_LINE 00000258 "    {"
NSQ_SOURCE_LINE 00000259 "        $newhash{$key} = $right->{$key};"
NSQ_SOURCE_LINE 00000260 "    }"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "    return \\%newhash;"
NSQ_SOURCE_LINE 00000263 "}"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "# Given a scalar or an array, creates a new hash where for each item in"
NSQ_SOURCE_LINE 00000266 "# the passed scalar or array, the key is equal to the value.  Returns"
NSQ_SOURCE_LINE 00000267 "# this new hash"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "sub _hashify"
NSQ_SOURCE_LINE 00000270 "{"
NSQ_SOURCE_LINE 00000271 "    my $self = &_get_obj;    # '&' + no args modifies current @_"
NSQ_SOURCE_LINE 00000272 "    my $arg  = shift;"
NSQ_SOURCE_LINE 00000273 "    if (ref $arg eq 'HASH')"
NSQ_SOURCE_LINE 00000274 "    {"
NSQ_SOURCE_LINE 00000275 "        carp 'Arguement for _hashify must not be a HASH ref';"
NSQ_SOURCE_LINE 00000276 "        return;"
NSQ_SOURCE_LINE 00000277 "    }"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "    my %newhash;"
NSQ_SOURCE_LINE 00000280 "    if (ref $arg eq 'ARRAY')"
NSQ_SOURCE_LINE 00000281 "    {"
NSQ_SOURCE_LINE 00000282 "        foreach my $item (@$arg)"
NSQ_SOURCE_LINE 00000283 "        {"
NSQ_SOURCE_LINE 00000284 "            my $suffix = 2;"
NSQ_SOURCE_LINE 00000285 "            my $name   = $item;"
NSQ_SOURCE_LINE 00000286 "            while (exists $newhash{$name})"
NSQ_SOURCE_LINE 00000287 "            {"
NSQ_SOURCE_LINE 00000288 "                $name = $item . $suffix++;"
NSQ_SOURCE_LINE 00000289 "            }"
NSQ_SOURCE_LINE 00000290 "            $newhash{$name} = $item;"
NSQ_SOURCE_LINE 00000291 "        }"
NSQ_SOURCE_LINE 00000292 "    }"
NSQ_SOURCE_LINE 00000293 "    else"
NSQ_SOURCE_LINE 00000294 "    {"
NSQ_SOURCE_LINE 00000295 "        $newhash{$arg} = $arg;"
NSQ_SOURCE_LINE 00000296 "    }"
NSQ_SOURCE_LINE 00000297 "    return \\%newhash;"
NSQ_SOURCE_LINE 00000298 "}"
NSQ_SOURCE_LINE 00000299 ""
NSQ_SOURCE_LINE 00000300 "my $_global;"
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "sub _get_obj"
NSQ_SOURCE_LINE 00000303 "{"
NSQ_SOURCE_LINE 00000304 "    if (my $type = ref $_[0])"
NSQ_SOURCE_LINE 00000305 "    {"
NSQ_SOURCE_LINE 00000306 "        return shift()"
NSQ_SOURCE_LINE 00000307 "          if $type eq __PACKAGE__"
NSQ_SOURCE_LINE 00000308 "          || (blessed $_[0] && $_[0]->isa(__PACKAGE__));"
NSQ_SOURCE_LINE 00000309 "    }"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "    defined $CONTEXT and return $CONTEXT;"
NSQ_SOURCE_LINE 00000312 "    defined $_global or $_global = Hash::Merge->new;"
NSQ_SOURCE_LINE 00000313 "    return $_global;"
NSQ_SOURCE_LINE 00000314 "}"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "1;"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "__END__"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "=head1 NAME"
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "Hash::Merge - Merges arbitrarily deep hashes into a single hash"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=begin html"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "<a href=\"https://travis-ci.org/perl5-utils/Hash-Merge\"><img src=\"https://travis-ci.org/perl5-utils/Hash-Merge.svg?branch=master\" alt=\"Travis CI\"/></a>"
NSQ_SOURCE_LINE 00000327 "<a href='https://coveralls.io/github/perl5-utils/Hash-Merge?branch=master'><img src='https://coveralls.io/repos/github/perl5-utils/Hash-Merge/badge.svg?branch=master' alt='Coverage Status'/></a>"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "=end html"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "    my %a = ("
NSQ_SOURCE_LINE 00000334 "        'foo'    => 1,"
NSQ_SOURCE_LINE 00000335 "        'bar'    => [qw( a b e )],"
NSQ_SOURCE_LINE 00000336 "        'querty' => { 'bob' => 'alice' },"
NSQ_SOURCE_LINE 00000337 "    );"
NSQ_SOURCE_LINE 00000338 "    my %b = ("
NSQ_SOURCE_LINE 00000339 "        'foo'    => 2,"
NSQ_SOURCE_LINE 00000340 "        'bar'    => [qw(c d)],"
NSQ_SOURCE_LINE 00000341 "        'querty' => { 'ted' => 'margeret' },"
NSQ_SOURCE_LINE 00000342 "    );"
NSQ_SOURCE_LINE 00000343 "    "
NSQ_SOURCE_LINE 00000344 "    my %c = %{ merge( \\%a, \\%b ) };"
NSQ_SOURCE_LINE 00000345 "    "
NSQ_SOURCE_LINE 00000346 "    Hash::Merge::set_behavior('RIGHT_PRECEDENT');"
NSQ_SOURCE_LINE 00000347 "    "
NSQ_SOURCE_LINE 00000348 "    # This is the same as above"
NSQ_SOURCE_LINE 00000349 "    "
NSQ_SOURCE_LINE 00000350 "    Hash::Merge::add_behavior_spec("
NSQ_SOURCE_LINE 00000351 "        {   'SCALAR' => {"
NSQ_SOURCE_LINE 00000352 "                'SCALAR' => sub { $_[1] },"
NSQ_SOURCE_LINE 00000353 "                'ARRAY'  => sub { [ $_[0], @{ $_[1] } ] },"
NSQ_SOURCE_LINE 00000354 "                'HASH'   => sub { $_[1] },"
NSQ_SOURCE_LINE 00000355 "            },"
NSQ_SOURCE_LINE 00000356 "            'ARRAY' => {"
NSQ_SOURCE_LINE 00000357 "                'SCALAR' => sub { $_[1] },"
NSQ_SOURCE_LINE 00000358 "                'ARRAY'  => sub { [ @{ $_[0] }, @{ $_[1] } ] },"
NSQ_SOURCE_LINE 00000359 "                'HASH'   => sub { $_[1] },"
NSQ_SOURCE_LINE 00000360 "            },"
NSQ_SOURCE_LINE 00000361 "            'HASH' => {"
NSQ_SOURCE_LINE 00000362 "                'SCALAR' => sub { $_[1] },"
NSQ_SOURCE_LINE 00000363 "                'ARRAY'  => sub { [ values %{ $_[0] }, @{ $_[1] } ] },"
NSQ_SOURCE_LINE 00000364 "                'HASH'   => sub { Hash::Merge::_merge_hashes( $_[0], $_[1] ) },"
NSQ_SOURCE_LINE 00000365 "            },"
NSQ_SOURCE_LINE 00000366 "        },"
NSQ_SOURCE_LINE 00000367 "        'My Behavior',"
NSQ_SOURCE_LINE 00000368 "    );"
NSQ_SOURCE_LINE 00000369 "    "
NSQ_SOURCE_LINE 00000370 "    # Also there is OO interface."
NSQ_SOURCE_LINE 00000371 "    "
NSQ_SOURCE_LINE 00000372 "    my $merger = Hash::Merge->new('LEFT_PRECEDENT');"
NSQ_SOURCE_LINE 00000373 "    my %c = %{ $merger->merge( \\%a, \\%b ) };"
NSQ_SOURCE_LINE 00000374 "    "
NSQ_SOURCE_LINE 00000375 "    # All behavioral changes (e.g. $merge->set_behavior(...)), called on an object remain specific to that object"
NSQ_SOURCE_LINE 00000376 "    # The legacy \"Global Setting\" behavior is respected only when new called as a non-OO function."
NSQ_SOURCE_LINE 00000377 ""
NSQ_SOURCE_LINE 00000378 "    # re-use globally specified behavior"
NSQ_SOURCE_LINE 00000379 "    my $merger = Hash::Merge->new();"
NSQ_SOURCE_LINE 00000380 "    $merger->add_behavior_spec(Hash::Merge::get_behavior_spec(\"My Behavior\"), \"My Behavior\");"
NSQ_SOURCE_LINE 00000381 "    my %c = %{ $merger->merge( \\%a, \\%b ) };"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "    # re-use externally specified behavior"
NSQ_SOURCE_LINE 00000384 "    use Hash::Merge::Extra ();"
NSQ_SOURCE_LINE 00000385 "    my $merger = Hash::Merge->new();"
NSQ_SOURCE_LINE 00000386 "    $merger->add_behavior_spec(Hash::Merge::Extra::L_REPLACE, \"L_REPLACE\");"
NSQ_SOURCE_LINE 00000387 "    my %c = %{ $merger->merge( \\%a, \\%b ) };"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "Hash::Merge merges two arbitrarily deep hashes into a single hash.  That"
NSQ_SOURCE_LINE 00000393 "is, at any level, it will add non-conflicting key-value pairs from one"
NSQ_SOURCE_LINE 00000394 "hash to the other, and follows a set of specific rules when there are key"
NSQ_SOURCE_LINE 00000395 "value conflicts (as outlined below).  The hash is followed recursively,"
NSQ_SOURCE_LINE 00000396 "so that deeply nested hashes that are at the same level will be merged "
NSQ_SOURCE_LINE 00000397 "when the parent hashes are merged.  B<Please note that self-referencing"
NSQ_SOURCE_LINE 00000398 "hashes, or recursive references, are not handled well by this method.>"
NSQ_SOURCE_LINE 00000399 ""
NSQ_SOURCE_LINE 00000400 "Values in hashes are considered to be either ARRAY references, "
NSQ_SOURCE_LINE 00000401 "HASH references, or otherwise are treated as SCALARs.  By default, the "
NSQ_SOURCE_LINE 00000402 "data passed to the merge function will be cloned using the Clone module; "
NSQ_SOURCE_LINE 00000403 "however, if necessary, this behavior can be changed to use as many of "
NSQ_SOURCE_LINE 00000404 "the original values as possible.  (See C<set_clone_behavior>). "
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "Because there are a number of possible ways that one may want to merge"
NSQ_SOURCE_LINE 00000407 "values when keys are conflicting, Hash::Merge provides several preset"
NSQ_SOURCE_LINE 00000408 "methods for your convenience, as well as a way to define you own.  "
NSQ_SOURCE_LINE 00000409 "These are (currently):"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=over"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "=item Left Precedence"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "This is the default behavior."
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "The values buried in the left hash will never"
NSQ_SOURCE_LINE 00000418 "be lost; any values that can be added from the right hash will be"
NSQ_SOURCE_LINE 00000419 "attempted."
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "    my $merge = Hash::Merge->new();"
NSQ_SOURCE_LINE 00000422 "    my $merge = Hash::Merge->new('LEFT_PRECEDENT');"
NSQ_SOURCE_LINE 00000423 "    $merge->set_behavior('LEFT_PRECEDENT');"
NSQ_SOURCE_LINE 00000424 "    Hash::Merge::set_behavior('LEFT_PRECEDENT');"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=item Right Precedence"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "Same as Left Precedence, but with the right"
NSQ_SOURCE_LINE 00000429 "hash values never being lost"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "    my $merge = Hash::Merge->new('RIGHT_PRECEDENT');"
NSQ_SOURCE_LINE 00000432 "    $merge->set_behavior('RIGHT_PRECEDENT');"
NSQ_SOURCE_LINE 00000433 "    Hash::Merge::set_behavior('RIGHT_PRECEDENT');"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "=item Storage Precedence"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "If conflicting keys have two different"
NSQ_SOURCE_LINE 00000438 "storage mediums, the 'bigger' medium will win; arrays are preferred over"
NSQ_SOURCE_LINE 00000439 "scalars, hashes over either.  The other medium will try to be fitted in"
NSQ_SOURCE_LINE 00000440 "the other, but if this isn't possible, the data is dropped."
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "    my $merge = Hash::Merge->new('STORAGE_PRECEDENT');"
NSQ_SOURCE_LINE 00000443 "    $merge->set_behavior('STORAGE_PRECEDENT');"
NSQ_SOURCE_LINE 00000444 "    Hash::Merge::set_behavior('STORAGE_PRECEDENT');"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "=item Retainment Precedence"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "No data will be lost; scalars will be joined"
NSQ_SOURCE_LINE 00000449 "with arrays, and scalars and arrays will be 'hashified' to fit them into"
NSQ_SOURCE_LINE 00000450 "a hash."
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "    my $merge = Hash::Merge->new('RETAINMENT_PRECEDENT');"
NSQ_SOURCE_LINE 00000453 "    $merge->set_behavior('RETAINMENT_PRECEDENT');"
NSQ_SOURCE_LINE 00000454 "    Hash::Merge::set_behavior('RETAINMENT_PRECEDENT');"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "=back"
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "Specific descriptions of how these work are detailed below."
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "=over "
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "=item merge ( <hashref>, <hashref> )"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "Merges two hashes given the rules specified.  Returns a reference to "
NSQ_SOURCE_LINE 00000465 "the new hash."
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "=item _hashify( <scalar>|<arrayref> ) -- INTERNAL FUNCTION"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "Returns a reference to a hash created from the scalar or array reference, "
NSQ_SOURCE_LINE 00000470 "where, for the scalar value, or each item in the array, there is a key"
NSQ_SOURCE_LINE 00000471 "and it's value equal to that specific value.  Example, if you pass scalar"
NSQ_SOURCE_LINE 00000472 "'3', the hash will be { 3 => 3 }."
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "=item _merge_hashes( <hashref>, <hashref> ) -- INTERNAL FUNCTION"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "Actually does the key-by-key evaluation of two hashes and returns "
NSQ_SOURCE_LINE 00000477 "the new merged hash.  Note that this recursively calls C<merge>."
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "=item set_clone_behavior( <scalar> ) "
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "Sets how the data cloning is handled by Hash::Merge.  If this is true,"
NSQ_SOURCE_LINE 00000482 "then data will be cloned; if false, then original data will be used"
NSQ_SOURCE_LINE 00000483 "whenever possible.  By default, cloning is on (set to true)."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "=item get_clone_behavior( )"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "Returns the current behavior for data cloning."
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "=item set_behavior( <scalar> )"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "Specify which built-in behavior for merging that is desired.  The scalar"
NSQ_SOURCE_LINE 00000492 "must be one of those given below."
NSQ_SOURCE_LINE 00000493 ""
NSQ_SOURCE_LINE 00000494 "=item get_behavior( )"
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "Returns the behavior that is currently in use by Hash::Merge."
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "=item specify_behavior( <hashref>, [<name>] ) [deprecated]"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "Alias for C<add_behavior_spec>."
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "=item add_behavior_spec( <hashref>, [<name>] )"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "Add a custom merge behavior spec for Hash::Merge.  This must be a hashref"
NSQ_SOURCE_LINE 00000505 "defined with (at least) 3 keys, SCALAR, ARRAY, and HASH; each of those"
NSQ_SOURCE_LINE 00000506 "keys must have another hashref with (at least) the same 3 keys defined."
NSQ_SOURCE_LINE 00000507 "Furthermore, the values in those hashes must be coderefs.  These will be"
NSQ_SOURCE_LINE 00000508 "called with two arguments, the left and right values for the merge.  "
NSQ_SOURCE_LINE 00000509 "Your coderef should return either a scalar or an array or hash reference"
NSQ_SOURCE_LINE 00000510 "as per your planned behavior.  If necessary, use the functions"
NSQ_SOURCE_LINE 00000511 "_hashify and _merge_hashes as helper functions for these.  For example,"
NSQ_SOURCE_LINE 00000512 "if you want to add the left SCALAR to the right ARRAY, you can have your"
NSQ_SOURCE_LINE 00000513 "behavior specification include:"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "    %spec = ( ...SCALAR => { ARRAY => sub { [ $_[0], @$_[1] ] }, ... } } );"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "Note that you can import _hashify and _merge_hashes into your program's"
NSQ_SOURCE_LINE 00000518 "namespace with the 'custom' tag."
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=item get_behavior_spec( [<name>] )"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "Return a previously defined merge behavior spec. If name ism't specified,"
NSQ_SOURCE_LINE 00000523 "the same default as add_behavior_spec is applied."
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "If no such name is known referring to an behavior spec, nothing is returned."
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "=back"
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=head1 BUILT-IN BEHAVIORS"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "Here is the specifics on how the current internal behaviors are called, "
NSQ_SOURCE_LINE 00000532 "and what each does.  Assume that the left value is given as $a, and"
NSQ_SOURCE_LINE 00000533 "the right as $b (these are either scalars or appropriate references)"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "    LEFT TYPE    RIGHT TYPE    LEFT_PRECEDENT       RIGHT_PRECEDENT"
NSQ_SOURCE_LINE 00000536 "     SCALAR       SCALAR        $a                   $b"
NSQ_SOURCE_LINE 00000537 "     SCALAR       ARRAY         $a                   ( $a, @$b )"
NSQ_SOURCE_LINE 00000538 "     SCALAR       HASH          $a                   %$b"
NSQ_SOURCE_LINE 00000539 "     ARRAY        SCALAR        ( @$a, $b )          $b"
NSQ_SOURCE_LINE 00000540 "     ARRAY        ARRAY         ( @$a, @$b )         ( @$a, @$b )"
NSQ_SOURCE_LINE 00000541 "     ARRAY        HASH          ( @$a, values %$b )  %$b "
NSQ_SOURCE_LINE 00000542 "     HASH         SCALAR        %$a                  $b"
NSQ_SOURCE_LINE 00000543 "     HASH         ARRAY         %$a                  ( values %$a, @$b )"
NSQ_SOURCE_LINE 00000544 "     HASH         HASH          merge( %$a, %$b )    merge( %$a, %$b )"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "    LEFT TYPE    RIGHT TYPE    STORAGE_PRECEDENT    RETAINMENT_PRECEDENT"
NSQ_SOURCE_LINE 00000547 "     SCALAR       SCALAR        $a                   ( $a ,$b )"
NSQ_SOURCE_LINE 00000548 "     SCALAR       ARRAY         ( $a, @$b )          ( $a, @$b )"
NSQ_SOURCE_LINE 00000549 "     SCALAR       HASH          %$b                  merge( hashify( $a ), %$b )"
NSQ_SOURCE_LINE 00000550 "     ARRAY        SCALAR        ( @$a, $b )          ( @$a, $b )"
NSQ_SOURCE_LINE 00000551 "     ARRAY        ARRAY         ( @$a, @$b )         ( @$a, @$b )"
NSQ_SOURCE_LINE 00000552 "     ARRAY        HASH          %$b                  merge( hashify( @$a ), %$b )"
NSQ_SOURCE_LINE 00000553 "     HASH         SCALAR        %$a                  merge( %$a, hashify( $b ) )"
NSQ_SOURCE_LINE 00000554 "     HASH         ARRAY         %$a                  merge( %$a, hashify( @$b ) )"
NSQ_SOURCE_LINE 00000555 "     HASH         HASH          merge( %$a, %$b )    merge( %$a, %$b )"
NSQ_SOURCE_LINE 00000556 ""
NSQ_SOURCE_LINE 00000557 "(*) note that merge calls _merge_hashes, hashify calls _hashify."
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000560 ""
