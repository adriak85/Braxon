NSQ_SOURCE_LINE 00000001 "package Log::ger::Output::Composite;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use Log::ger::Util;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000008 "our $DATE = '2024-01-12'; # DATE"
NSQ_SOURCE_LINE 00000009 "our $DIST = 'Log-ger-Output-Composite'; # DIST"
NSQ_SOURCE_LINE 00000010 "our $VERSION = '0.018'; # VERSION"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "# this can be used to override all level settings as it has the highest"
NSQ_SOURCE_LINE 00000013 "# precedence."
NSQ_SOURCE_LINE 00000014 "our $Current_Level;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "sub meta { +{"
NSQ_SOURCE_LINE 00000017 "    v => 2,"
NSQ_SOURCE_LINE 00000018 "} }"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "sub _debug {"
NSQ_SOURCE_LINE 00000021 "    return unless $ENV{LOG_GER_OUTPUT_COMPOSITE_DEBUG};"
NSQ_SOURCE_LINE 00000022 "    warn \"[Log::ger::Output::Composite] debug: $_[0]\\n\";"
NSQ_SOURCE_LINE 00000023 "}"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub _get_min_max_level {"
NSQ_SOURCE_LINE 00000026 "    my $level = shift;"
NSQ_SOURCE_LINE 00000027 "    my ($min, $max);"
NSQ_SOURCE_LINE 00000028 "    if (defined $level) {"
NSQ_SOURCE_LINE 00000029 "        if (defined $Current_Level) {"
NSQ_SOURCE_LINE 00000030 "            $min = 0;"
NSQ_SOURCE_LINE 00000031 "            $max = $Current_Level;"
NSQ_SOURCE_LINE 00000032 "        } elsif (ref $level eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000033 "            $min = Log::ger::Util::numeric_level($level->[0]);"
NSQ_SOURCE_LINE 00000034 "            $max = Log::ger::Util::numeric_level($level->[1]);"
NSQ_SOURCE_LINE 00000035 "            ($min, $max) = ($max, $min) if $min > $max;"
NSQ_SOURCE_LINE 00000036 "        } else {"
NSQ_SOURCE_LINE 00000037 "            $min = 0;"
NSQ_SOURCE_LINE 00000038 "            $max = Log::ger::Util::numeric_level($level);"
NSQ_SOURCE_LINE 00000039 "        }"
NSQ_SOURCE_LINE 00000040 "    }"
NSQ_SOURCE_LINE 00000041 "    ($min, $max);"
NSQ_SOURCE_LINE 00000042 "}"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "sub get_hooks {"
NSQ_SOURCE_LINE 00000045 "    my %plugin_conf = @_;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    #_debug \"In get_hooks()\";"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    my $empty_hashref = {};"
NSQ_SOURCE_LINE 00000050 "    my %outputter_get_hooks_cache; # key = \"$output $conf\", value = result from outputter's get_hooks()"
NSQ_SOURCE_LINE 00000051 "    my %layouter_get_hooks_cache ; # key = \"$output $conf\", value = result from layouter's get_hooks()"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    # check arguments"
NSQ_SOURCE_LINE 00000054 "    for my $k (keys %plugin_conf) {"
NSQ_SOURCE_LINE 00000055 "        my $conf = $plugin_conf{$k};"
NSQ_SOURCE_LINE 00000056 "        if ($k eq 'outputs') {"
NSQ_SOURCE_LINE 00000057 "            for my $o (keys %$conf) {"
NSQ_SOURCE_LINE 00000058 "                for my $oconf (ref $conf->{$o} eq 'ARRAY' ?"
NSQ_SOURCE_LINE 00000059 "                                   @{ $conf->{$o} } : $conf->{$o}) {"
NSQ_SOURCE_LINE 00000060 "                    for my $k2 (keys %$oconf) {"
NSQ_SOURCE_LINE 00000061 "                        unless ($k2 =~"
NSQ_SOURCE_LINE 00000062 "                                    /\\A(conf|level|category_level|layout)\\z/) {"
NSQ_SOURCE_LINE 00000063 "                            die \"Unknown configuration for output '$o': '$k2'\";"
NSQ_SOURCE_LINE 00000064 "                        }"
NSQ_SOURCE_LINE 00000065 "                    }"
NSQ_SOURCE_LINE 00000066 "                }"
NSQ_SOURCE_LINE 00000067 "            }"
NSQ_SOURCE_LINE 00000068 "        } elsif ($k =~ /\\A(category_level)\\z/) {"
NSQ_SOURCE_LINE 00000069 "        } else {"
NSQ_SOURCE_LINE 00000070 "            die \"Unknown configuration: '$k'\";"
NSQ_SOURCE_LINE 00000071 "        }"
NSQ_SOURCE_LINE 00000072 "    }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "    my @ospecs;"
NSQ_SOURCE_LINE 00000075 "    {"
NSQ_SOURCE_LINE 00000076 "        my $outputs = $plugin_conf{outputs};"
NSQ_SOURCE_LINE 00000077 "        for my $oname (sort keys %$outputs) {"
NSQ_SOURCE_LINE 00000078 "            my $ospec0 = $outputs->{$oname};"
NSQ_SOURCE_LINE 00000079 "            my @ospecs0;"
NSQ_SOURCE_LINE 00000080 "            if (ref $ospec0 eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000081 "                @ospecs0 = map { +{ %{$_} } } @$ospec0;"
NSQ_SOURCE_LINE 00000082 "            } else {"
NSQ_SOURCE_LINE 00000083 "                @ospecs0 = (+{ %{ $ospec0 } });"
NSQ_SOURCE_LINE 00000084 "            }"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "            die \"Invalid output name '$oname'\""
NSQ_SOURCE_LINE 00000087 "                unless $oname =~ /\\A\\w+(::\\w+)*\\z/;"
NSQ_SOURCE_LINE 00000088 "            my $mod = \"Log::ger::Output::$oname\";"
NSQ_SOURCE_LINE 00000089 "            (my $mod_pm = \"$mod.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000090 "            require $mod_pm;"
NSQ_SOURCE_LINE 00000091 "            for my $ospec (@ospecs0) {"
NSQ_SOURCE_LINE 00000092 "                $ospec->{_name} = $oname;"
NSQ_SOURCE_LINE 00000093 "                $ospec->{_mod} = $mod;"
NSQ_SOURCE_LINE 00000094 "                push @ospecs, $ospec;"
NSQ_SOURCE_LINE 00000095 "            }"
NSQ_SOURCE_LINE 00000096 "        }"
NSQ_SOURCE_LINE 00000097 "    }"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    return {"
NSQ_SOURCE_LINE 00000100 "        create_outputter => ["
NSQ_SOURCE_LINE 00000101 "            __PACKAGE__, # key"
NSQ_SOURCE_LINE 00000102 "            9,           # priority."
NSQ_SOURCE_LINE 00000103 "            # we use a high priority to override Log::ger's default hook (at"
NSQ_SOURCE_LINE 00000104 "            # priority 10) which create null outputter for levels lower than the"
NSQ_SOURCE_LINE 00000105 "            # general level, since we want to do our own custom level checking."
NSQ_SOURCE_LINE 00000106 "            sub {        # hook"
NSQ_SOURCE_LINE 00000107 "                no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000108 "                require Data::Dmp;"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "                my %hook_args = @_; # see Log::ger::Manual::Internals/\"Arguments passed to hook\""
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "                my $outputters = [];"
NSQ_SOURCE_LINE 00000113 "                my $layouters = [];"
NSQ_SOURCE_LINE 00000114 "                for my $ospec (@ospecs) {"
NSQ_SOURCE_LINE 00000115 "                    my $oname = $ospec->{_name};"
NSQ_SOURCE_LINE 00000116 "                    my $mod = \"Log::ger::Output::$oname\";"
NSQ_SOURCE_LINE 00000117 "                    my $ospec_conf = $ospec->{conf} || $empty_hashref;"
NSQ_SOURCE_LINE 00000118 "                    my $cache_key = \"$oname $ospec_conf\";"
NSQ_SOURCE_LINE 00000119 "                    my $hooks = $outputter_get_hooks_cache{$cache_key} || do {"
NSQ_SOURCE_LINE 00000120 "                        _debug(\"calling $oname\\'s get_hooks() ...\");"
NSQ_SOURCE_LINE 00000121 "                        my $res = &{\"$mod\\::get_hooks\"}(%$ospec_conf)"
NSQ_SOURCE_LINE 00000122 "                            or die \"Output module $mod does not return any hooks\";"
NSQ_SOURCE_LINE 00000123 "                        $outputter_get_hooks_cache{$cache_key} = $res;"
NSQ_SOURCE_LINE 00000124 "                        $res;"
NSQ_SOURCE_LINE 00000125 "                    };"
NSQ_SOURCE_LINE 00000126 "                    my @hook_args = ("
NSQ_SOURCE_LINE 00000127 "                        routine_name    => $hook_args{routine_name},"
NSQ_SOURCE_LINE 00000128 "                        target_type     => $hook_args{target_type},"
NSQ_SOURCE_LINE 00000129 "                        target_name     => $hook_args{target_name},"
NSQ_SOURCE_LINE 00000130 "                        per_target_conf => $hook_args{per_target_conf},"
NSQ_SOURCE_LINE 00000131 "                    );"
NSQ_SOURCE_LINE 00000132 "                    my $res;"
NSQ_SOURCE_LINE 00000133 "                    {"
NSQ_SOURCE_LINE 00000134 "                        push @hook_args, (level => 60, str_level => 'trace');"
NSQ_SOURCE_LINE 00000135 "                        if ($hooks->{create_log_routine}) { # old name, will be removed in the future"
NSQ_SOURCE_LINE 00000136 "                            $res = $hooks->{create_log_routine}->[2]->("
NSQ_SOURCE_LINE 00000137 "                                @hook_args);"
NSQ_SOURCE_LINE 00000138 "                            if ($res->[0]) {"
NSQ_SOURCE_LINE 00000139 "                                push @$outputters, $res->[0];"
NSQ_SOURCE_LINE 00000140 "                                last;"
NSQ_SOURCE_LINE 00000141 "                            }"
NSQ_SOURCE_LINE 00000142 "                        }"
NSQ_SOURCE_LINE 00000143 "                        if ($hooks->{create_outputter}) {"
NSQ_SOURCE_LINE 00000144 "                            $res = $hooks->{create_outputter}->[2]->("
NSQ_SOURCE_LINE 00000145 "                                @hook_args);"
NSQ_SOURCE_LINE 00000146 "                            if ($res->[0]) {"
NSQ_SOURCE_LINE 00000147 "                                push @$outputters, $res->[0];"
NSQ_SOURCE_LINE 00000148 "                                last;"
NSQ_SOURCE_LINE 00000149 "                            }"
NSQ_SOURCE_LINE 00000150 "                        }"
NSQ_SOURCE_LINE 00000151 "                        die \"Output module $mod does not produce outputter in \"."
NSQ_SOURCE_LINE 00000152 "                            \"its create_outputter (or create_log_routine) hook\"; # old name create_log_routine will be removed in the future"
NSQ_SOURCE_LINE 00000153 "                    }"
NSQ_SOURCE_LINE 00000154 "                    if ($ospec->{layout}) {"
NSQ_SOURCE_LINE 00000155 "                        my $lname = $ospec->{layout}[0];"
NSQ_SOURCE_LINE 00000156 "                        my $lconf = $ospec->{layout}[1] || $empty_hashref;"
NSQ_SOURCE_LINE 00000157 "                        my $lmod  = \"Log::ger::Layout::$lname\";"
NSQ_SOURCE_LINE 00000158 "                        (my $lmod_pm = \"$lmod.pm\") =~ s!::!/!g;"
NSQ_SOURCE_LINE 00000159 "                        require $lmod_pm;"
NSQ_SOURCE_LINE 00000160 "                        my $cache_key = \"$lname $lconf\";"
NSQ_SOURCE_LINE 00000161 "                        my $lhooks = $layouter_get_hooks_cache{$cache_key} || do {"
NSQ_SOURCE_LINE 00000162 "                            _debug(\"calling layouter $lname\\'s get_hooks() ...\");"
NSQ_SOURCE_LINE 00000163 "                            my $res = &{\"$lmod\\::get_hooks\"}(%$lconf)"
NSQ_SOURCE_LINE 00000164 "                                or die \"Layout module $lmod does not return any hooks\";"
NSQ_SOURCE_LINE 00000165 "                            $layouter_get_hooks_cache{$cache_key} = $res;"
NSQ_SOURCE_LINE 00000166 "                            $res;"
NSQ_SOURCE_LINE 00000167 "                        };"
NSQ_SOURCE_LINE 00000168 "                        $lhooks->{create_layouter}"
NSQ_SOURCE_LINE 00000169 "                            or die \"Layout module $mod does not declare \"."
NSQ_SOURCE_LINE 00000170 "                            \"layouter\";"
NSQ_SOURCE_LINE 00000171 "                        my @lhook_args = ("
NSQ_SOURCE_LINE 00000172 "                            target_type     => $hook_args{target_type},"
NSQ_SOURCE_LINE 00000173 "                            target_name     => $hook_args{target_name},"
NSQ_SOURCE_LINE 00000174 "                            per_target_conf => $hook_args{per_target_conf},"
NSQ_SOURCE_LINE 00000175 "                        );"
NSQ_SOURCE_LINE 00000176 "                        my $lres = $lhooks->{create_layouter}->[2]->("
NSQ_SOURCE_LINE 00000177 "                            @lhook_args) or die \"Hook from layout module \"."
NSQ_SOURCE_LINE 00000178 "                                \"$lmod does not produce layout routine\";"
NSQ_SOURCE_LINE 00000179 "                        ref $lres->[0] eq 'CODE'"
NSQ_SOURCE_LINE 00000180 "                            or die \"Layouter from layout module $lmod \"."
NSQ_SOURCE_LINE 00000181 "                            \"is not a coderef\";"
NSQ_SOURCE_LINE 00000182 "                        push @$layouters, $lres->[0];"
NSQ_SOURCE_LINE 00000183 "                    } else {"
NSQ_SOURCE_LINE 00000184 "                        push @$layouters, undef;"
NSQ_SOURCE_LINE 00000185 "                    }"
NSQ_SOURCE_LINE 00000186 "                }"
NSQ_SOURCE_LINE 00000187 "                unless (@$outputters) {"
NSQ_SOURCE_LINE 00000188 "                    $Log::ger::_outputter_is_null = 1;"
NSQ_SOURCE_LINE 00000189 "                    return [sub {0}];"
NSQ_SOURCE_LINE 00000190 "                }"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "                # put the data that are mentioned in string-eval'ed code in a"
NSQ_SOURCE_LINE 00000193 "                # package so they are addressable"
NSQ_SOURCE_LINE 00000194 "                my $varname = do {"
NSQ_SOURCE_LINE 00000195 "                    my $suffix;"
NSQ_SOURCE_LINE 00000196 "                    if ($hook_args{target_type} eq 'package') {"
NSQ_SOURCE_LINE 00000197 "                        $suffix = $hook_args{target_name};"
NSQ_SOURCE_LINE 00000198 "                    } else {"
NSQ_SOURCE_LINE 00000199 "                        ($suffix) = \"$hook_args{target_name}\" =~ /\\(0x(\\w+)/;"
NSQ_SOURCE_LINE 00000200 "                    }"
NSQ_SOURCE_LINE 00000201 "                    \"Log::ger::Stash::OComposite_$suffix\";"
NSQ_SOURCE_LINE 00000202 "                };"
NSQ_SOURCE_LINE 00000203 "                {"
NSQ_SOURCE_LINE 00000204 "                    no strict 'refs'; ## no critic: TestingAndDebugging::ProhibitNoStrict"
NSQ_SOURCE_LINE 00000205 "                    ${$varname} = [];"
NSQ_SOURCE_LINE 00000206 "                    ${$varname}->[0] = $outputters;"
NSQ_SOURCE_LINE 00000207 "                    ${$varname}->[1] = $layouters;"
NSQ_SOURCE_LINE 00000208 "                    ${$varname}->[2] = $hook_args{per_target_conf};"
NSQ_SOURCE_LINE 00000209 "                }"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "                # generate our outputter routine"
NSQ_SOURCE_LINE 00000212 "                my $composite_outputter;"
NSQ_SOURCE_LINE 00000213 "                {"
NSQ_SOURCE_LINE 00000214 "                    my @src;"
NSQ_SOURCE_LINE 00000215 "                    push @src, \"sub {\\n\";"
NSQ_SOURCE_LINE 00000216 "                    push @src, \"  my (\\$per_target_conf, \\$fmsg, \\$per_msg_conf) = \\@_;\\n\";"
NSQ_SOURCE_LINE 00000217 "                    push @src, \"  my \\$lvl; if (\\$per_msg_conf) { \\$lvl = \\$per_msg_conf->{level} }\", (defined $hook_args{level} ? \" if (!defined \\$lvl) { \\$lvl = $hook_args{level} }\" : \"\"), \"\\n\";"
NSQ_SOURCE_LINE 00000218 "                    push @src, \"  if (!\\$per_msg_conf) { \\$per_msg_conf = {level=>\\$lvl} }\\n\"; # since we want to pass level etc to other outputs"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "                    for my $i (0..$#ospecs) {"
NSQ_SOURCE_LINE 00000221 "                        my $ospec = $ospecs[$i];"
NSQ_SOURCE_LINE 00000222 "                        push @src, \"  # output #$i: $ospec->{_name}\\n\";"
NSQ_SOURCE_LINE 00000223 "                        push @src, \"  {\\n\";"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "                        # filter by output's category_level and category-level"
NSQ_SOURCE_LINE 00000226 "                        if ($ospec->{category_level} || $plugin_conf{category_level}) {"
NSQ_SOURCE_LINE 00000227 "                            push @src, \"    my \\$cat = (\\$per_msg_conf ? \\$per_msg_conf->{category} : undef) || \\$per_target_conf->{category} || '';\\n\";"
NSQ_SOURCE_LINE 00000228 "                            push @src, \"    local \\$per_msg_conf->{category} = \\$cat;\\n\";"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "                            my @cats;"
NSQ_SOURCE_LINE 00000231 "                            if ($ospec->{category_level}) {"
NSQ_SOURCE_LINE 00000232 "                                for my $cat (keys %{$ospec->{category_level}}) {"
NSQ_SOURCE_LINE 00000233 "                                    my $clevel = $ospec->{category_level}{$cat};"
NSQ_SOURCE_LINE 00000234 "                                    push @cats, [$cat, 1, $clevel];"
NSQ_SOURCE_LINE 00000235 "                                }"
NSQ_SOURCE_LINE 00000236 "                            }"
NSQ_SOURCE_LINE 00000237 "                            if ($plugin_conf{category_level}) {"
NSQ_SOURCE_LINE 00000238 "                                for my $cat (keys %{$plugin_conf{category_level}}) {"
NSQ_SOURCE_LINE 00000239 "                                    my $clevel = $plugin_conf{category_level}{$cat};"
NSQ_SOURCE_LINE 00000240 "                                    push @cats, [$cat, 2, $clevel];"
NSQ_SOURCE_LINE 00000241 "                                }"
NSQ_SOURCE_LINE 00000242 "                            }"
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "                            for my $cat (sort {"
NSQ_SOURCE_LINE 00000245 "                                length($b->[0]) <=> length($a->[0]) ||"
NSQ_SOURCE_LINE 00000246 "                                    $a->[0] cmp $b->[0] ||"
NSQ_SOURCE_LINE 00000247 "                                        $a->[1] <=> $b->[1]} @cats) {"
NSQ_SOURCE_LINE 00000248 "                                push @src, \"    if (\\$cat eq \".Data::Dmp::dmp($cat->[0]).\" || index(\\$cat, \".Data::Dmp::dmp(\"$cat->[0]\\::\").\") == 0) { \";"
NSQ_SOURCE_LINE 00000249 "                                my ($min_level, $max_level) ="
NSQ_SOURCE_LINE 00000250 "                                    _get_min_max_level($cat->[2]);"
NSQ_SOURCE_LINE 00000251 "                                push @src, \"if (\\$lvl >= $min_level && \"."
NSQ_SOURCE_LINE 00000252 "                                    \"\\$lvl <= $max_level) { goto LOG } else { last }\";"
NSQ_SOURCE_LINE 00000253 "                                push @src, \" }\\n\";"
NSQ_SOURCE_LINE 00000254 "                            }"
NSQ_SOURCE_LINE 00000255 "                            push @src, \"\\n\";"
NSQ_SOURCE_LINE 00000256 "                        }"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "                        # filter by output level"
NSQ_SOURCE_LINE 00000259 "                        my ($min_level, $max_level) = _get_min_max_level("
NSQ_SOURCE_LINE 00000260 "                            $ospec->{level});"
NSQ_SOURCE_LINE 00000261 "                        if (defined $min_level) {"
NSQ_SOURCE_LINE 00000262 "                            push @src, \"    if (\\$lvl >= $min_level && \"."
NSQ_SOURCE_LINE 00000263 "                                \"\\$lvl <= $max_level) { goto LOG } else { last }\\n\";"
NSQ_SOURCE_LINE 00000264 "                        }"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "                        # filter by general level"
NSQ_SOURCE_LINE 00000267 "                        push @src, \"    if (\\$Log::ger::Current_Level >= \\$lvl) { goto LOG } else { last }\\n\";"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "                        # run output's log routine"
NSQ_SOURCE_LINE 00000270 "                        push @src, \"    LOG:\\n\";"
NSQ_SOURCE_LINE 00000271 "                        push @src, \"    if (\\$$varname\\->[1][$i]) {\\n\";"
NSQ_SOURCE_LINE 00000272 "                        push @src, \"      \\$$varname\\->[0][$i]->(\\$per_target_conf, \\$$varname\\->[1][$i]->(\\$fmsg, \\$$varname\\->[2], \\$lvl, Log::ger::Util::string_level(\\$lvl)), \\$per_msg_conf);\\n\";"
NSQ_SOURCE_LINE 00000273 "                        push @src, \"    } else {\\n\";"
NSQ_SOURCE_LINE 00000274 "                        push @src, \"      \\$$varname\\->[0][$i]->(\\$per_target_conf, \\$fmsg, \\$per_msg_conf);\\n\";"
NSQ_SOURCE_LINE 00000275 "                        push @src, \"    }\\n\";"
NSQ_SOURCE_LINE 00000276 "                        push @src, \"  }\\n\";"
NSQ_SOURCE_LINE 00000277 "                        push @src, \"  # end output #$i\\n\\n\";"
NSQ_SOURCE_LINE 00000278 "                    } # for ospec"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "                    push @src, \"};\\n\";"
NSQ_SOURCE_LINE 00000281 "                    my $src = join(\"\", @src);"
NSQ_SOURCE_LINE 00000282 "                    if ($ENV{LOG_LOG_GER_OUTPUT_COMPOSITE_CODE}) {"
NSQ_SOURCE_LINE 00000283 "                        warn \"Log::ger::Output::Composite logger source code (target type=$hook_args{target_type} target name=$hook_args{target_name}, routine name=$hook_args{routine_name}): <<$src>>\\n\";"
NSQ_SOURCE_LINE 00000284 "                    }"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "                    $composite_outputter = eval $src; ## no critic: BuiltinFunctions::ProhibitStringyEval"
NSQ_SOURCE_LINE 00000287 "                }"
NSQ_SOURCE_LINE 00000288 "                [$composite_outputter];"
NSQ_SOURCE_LINE 00000289 "            }] # hook record"
NSQ_SOURCE_LINE 00000290 "    };"
NSQ_SOURCE_LINE 00000291 "}"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "sub set_level {"
NSQ_SOURCE_LINE 00000294 "    $Current_Level = Log::ger::Util::numeric_level(shift);"
NSQ_SOURCE_LINE 00000295 "    Log::ger::Util::reinit_all_targets();"
NSQ_SOURCE_LINE 00000296 "}"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "1;"
NSQ_SOURCE_LINE 00000299 "# ABSTRACT: Composite output"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "__END__"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "=pod"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "=head1 NAME"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "Log::ger::Output::Composite - Composite output"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "=head1 VERSION"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 "version 0.018"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 " use Log::ger::Output Composite => ("
NSQ_SOURCE_LINE 00000318 "     outputs => {"
NSQ_SOURCE_LINE 00000319 "         # single screen output"
NSQ_SOURCE_LINE 00000320 "         Screen => {"
NSQ_SOURCE_LINE 00000321 "             conf   => { use_color=>1 },                        # output config, optional."
NSQ_SOURCE_LINE 00000322 "             level  => 'info',                                  # set per-output level. optional."
NSQ_SOURCE_LINE 00000323 "             layout => [Pattern => {format=>'%d (%F:%L)> %m'}], # add per-output layout, optional."
NSQ_SOURCE_LINE 00000324 "         },"
NSQ_SOURCE_LINE 00000325 "         # multiple file outputs"
NSQ_SOURCE_LINE 00000326 "         File => ["
NSQ_SOURCE_LINE 00000327 "             {"
NSQ_SOURCE_LINE 00000328 "                 conf  => { path=>'/var/log/myapp.log' },"
NSQ_SOURCE_LINE 00000329 "                 level => 'warn',"
NSQ_SOURCE_LINE 00000330 "                 category_level => {                            # set per-category, per-output level. optional."
NSQ_SOURCE_LINE 00000331 "                     # don't log MyApp::Security messages to this file"
NSQ_SOURCE_LINE 00000332 "                     'MyApp::Security' => 'off',"
NSQ_SOURCE_LINE 00000333 "                     ..."
NSQ_SOURCE_LINE 00000334 "                 },"
NSQ_SOURCE_LINE 00000335 "             },"
NSQ_SOURCE_LINE 00000336 "             {"
NSQ_SOURCE_LINE 00000337 "                 conf => { path => '/var/log/myapp-security.log' },"
NSQ_SOURCE_LINE 00000338 "                 level => 'warn',"
NSQ_SOURCE_LINE 00000339 "                 category_level => {"
NSQ_SOURCE_LINE 00000340 "                     # only MyApp::Security messages go to this file"
NSQ_SOURCE_LINE 00000341 "                     'MyApp::Security' => 'warn',"
NSQ_SOURCE_LINE 00000342 "                     ..."
NSQ_SOURCE_LINE 00000343 "                 },"
NSQ_SOURCE_LINE 00000344 "             },"
NSQ_SOURCE_LINE 00000345 "         ],"
NSQ_SOURCE_LINE 00000346 "     },"
NSQ_SOURCE_LINE 00000347 "     category_level => {                                        # set per-category level. optional."
NSQ_SOURCE_LINE 00000348 "        'MyApp::SubModule1' => 'info',"
NSQ_SOURCE_LINE 00000349 "        'MyApp::SubModule2' => 'debug',"
NSQ_SOURCE_LINE 00000350 "        ..."
NSQ_SOURCE_LINE 00000351 "     },"
NSQ_SOURCE_LINE 00000352 " );"
NSQ_SOURCE_LINE 00000353 " use Log::ger;"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 " log_warn \"blah...\";"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "This is a L<Log::ger> output that can multiplex output to several outputs and do"
NSQ_SOURCE_LINE 00000360 "filtering on the basis of per-category level, per-output level, or per-output"
NSQ_SOURCE_LINE 00000361 "per-category level. It can also apply per-output layout."
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=for Pod::Coverage ^(.+)$"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "=head1 CONFIGURATION"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=head2 outputs => hash"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "Hash. Specify outputs. Hash key is output name and and hash value is output"
NSQ_SOURCE_LINE 00000370 "specification."
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "Output name is the name of output module without the C<Log::ger::Output::>"
NSQ_SOURCE_LINE 00000373 "prefix, e.g. L<Screen|Log::ger::Output::Screen> or"
NSQ_SOURCE_LINE 00000374 "L<File|Log::ger::Output::File>."
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "Output specification is either a hashref or arrayref of hashrefs to specify"
NSQ_SOURCE_LINE 00000377 "multiple outputs per type (e.g. if you want to output to two File's). Known"
NSQ_SOURCE_LINE 00000378 "hashref keys for output specification:"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=over"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=item * conf => hashref"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "Specify output configuration. Optional. See each output documentation for the"
NSQ_SOURCE_LINE 00000385 "list of available configuration parameters."
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "=item * level => str|int|[min, max]"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "Specify per-output level. Optional. If specified, logging will be done at this"
NSQ_SOURCE_LINE 00000390 "level instead of the general level. For example, if this is set to C<debug> then"
NSQ_SOURCE_LINE 00000391 "debug messages and higher will be sent to output even though the general level"
NSQ_SOURCE_LINE 00000392 "is C<warn>. Vice versa, if this is set to C<error> then even though the general"
NSQ_SOURCE_LINE 00000393 "level is C<warn>, warning messages won't be sent to this output; only C<error>"
NSQ_SOURCE_LINE 00000394 "messages and higher will be sent."
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "You can specify a single level (e.g. 1 or \"trace\") or a two-element array to"
NSQ_SOURCE_LINE 00000397 "specify minimum and maximum level (e.g. C<<[\"trace\", \"info\"]>>). If you"
NSQ_SOURCE_LINE 00000398 "accidentally mix up minimum and maximum, this module will helpfully fix it for"
NSQ_SOURCE_LINE 00000399 "you."
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "=item * category_level => hash"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "Specify per-output per-category level. Optional. Hash key is category name,"
NSQ_SOURCE_LINE 00000404 "value is level (which can be a string/numeric level or a two-element array"
NSQ_SOURCE_LINE 00000405 "containing minimum and maximum level)."
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=item * layout => [Name => {conf1=>..., conf2=>..., ...}]"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "Specify per-output layout. Optional. Value is two-element array containing"
NSQ_SOURCE_LINE 00000410 "layout name (without the C<Log::ger::Layout::> prefix, e.g."
NSQ_SOURCE_LINE 00000411 "L<Pattern|Log::ger::Layout::Pattern>) and configuration hash. See each layout"
NSQ_SOURCE_LINE 00000412 "module documentation for the list of available configuration parameters."
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "Note that if you also use a layout module outside of Composite configuration,"
NSQ_SOURCE_LINE 00000415 "e.g.:"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 " use Log::ger::Output Composite => (...);"
NSQ_SOURCE_LINE 00000418 " use Log::ger::Layout Pattern => (format => '...');"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "then both layouts will be applied, the general layout will be applied before the"
NSQ_SOURCE_LINE 00000421 "per-output layout."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "=back"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "=head2 category_level => hash"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "Hash, optional. Specify per-category level. Hash key is category name, value is"
NSQ_SOURCE_LINE 00000428 "level (which can be a string/numeric level or a two-element array containing"
NSQ_SOURCE_LINE 00000429 "minimum and maximum level)."
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "=head1 FAQS"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "=head2 Why doesn't re-setting log level using Log::ger::Util::set_level() work?"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "This output plugin sets its own levels and logs using a multilevel routine"
NSQ_SOURCE_LINE 00000436 "(which gets called for all levels). Re-setting log level dynamically via"
NSQ_SOURCE_LINE 00000437 "L<Log::ger::Util>'s C<set_level> will not work as intended, which is fortunate"
NSQ_SOURCE_LINE 00000438 "or unfortunate depending on your need."
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "If you want to override all levels settings with a single value, you can use"
NSQ_SOURCE_LINE 00000441 "C<Log::ger::Output::Composite::set_level>, for example:"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 " Log::ger::Util::set_level('trace'); # also set this too"
NSQ_SOURCE_LINE 00000444 " Log::ger::Output::Composite::set_level('trace');"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "This sets an internal level setting which is respected and has the highest"
NSQ_SOURCE_LINE 00000447 "precedence so all levels settings will use this instead. If previously you have:"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 " Log::ger::Output->set(Composite => ("
NSQ_SOURCE_LINE 00000450 "     outputs => {"
NSQ_SOURCE_LINE 00000451 "         File   => {conf=>{path=>'/foo'}, level=>'debug'},"
NSQ_SOURCE_LINE 00000452 "         Screen => {level=>'info', category_level=>{MyApp=>'warn'}},"
NSQ_SOURCE_LINE 00000453 "     },"
NSQ_SOURCE_LINE 00000454 "     category_level => {"
NSQ_SOURCE_LINE 00000455 "         'MyApp::SubModule1' => 'debug',"
NSQ_SOURCE_LINE 00000456 "     },"
NSQ_SOURCE_LINE 00000457 " ));"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "then after the C<Log::ger::Output::Composite::set_level('trace')>, all the above"
NSQ_SOURCE_LINE 00000460 "per-category and per-output levels will be set to C<trace>."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000463 ""
NSQ_SOURCE_LINE 00000464 "=head2 LOG_LOG_GER_OUTPUT_COMPOSITE_CODE"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "Bool. If set to true will print the generated logger source code to stderr."
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "=head2 LOG_GER_OUTPUT_COMPOSITE_DEBUG"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "Bool. If set to true, will print some debugging messages to stderr."
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "L<Log::ger::App> as an example on module that uses Log::ger::Output::Composite."
NSQ_SOURCE_LINE 00000475 ""
