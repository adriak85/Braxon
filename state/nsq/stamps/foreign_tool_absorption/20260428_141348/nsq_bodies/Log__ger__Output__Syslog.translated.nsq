NSQ_SOURCE_LINE 00000001 "package Log::ger::Output::Syslog;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2020-03-11'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Log-ger-Output-Syslog'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.005'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000009 "use warnings;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "use Log::ger::Util;"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our %level_map = ("
NSQ_SOURCE_LINE 00000014 "    # Log::ger default level => syslog level"
NSQ_SOURCE_LINE 00000015 "    # => emerg"
NSQ_SOURCE_LINE 00000016 "    # => alert"
NSQ_SOURCE_LINE 00000017 "    fatal => 'crit',"
NSQ_SOURCE_LINE 00000018 "    error => 'err',"
NSQ_SOURCE_LINE 00000019 "    warn  => 'warning',"
NSQ_SOURCE_LINE 00000020 "    # => notice"
NSQ_SOURCE_LINE 00000021 "    info  => 'info',"
NSQ_SOURCE_LINE 00000022 "    debug => 'debug',"
NSQ_SOURCE_LINE 00000023 "    trace => 'debug',"
NSQ_SOURCE_LINE 00000024 ");"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "sub meta { +{"
NSQ_SOURCE_LINE 00000027 "    v => 2,"
NSQ_SOURCE_LINE 00000028 "} }"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "sub get_hooks {"
NSQ_SOURCE_LINE 00000031 "    my %plugin_conf = @_;"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    my $ident = delete($plugin_conf{ident});"
NSQ_SOURCE_LINE 00000034 "    defined($ident) or die \"Please specify ident\";"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    my $facility = delete($plugin_conf{facility}) || 'user';"
NSQ_SOURCE_LINE 00000037 "    $facility =~ /\\A(auth|authpriv|cron|daemon|ftp|kern|local[0-7]|lpr|mail|news|syslog|user|uucp)\\z/"
NSQ_SOURCE_LINE 00000038 "        or die \"Invalid value for facility, please choose \"."
NSQ_SOURCE_LINE 00000039 "        \"auth|authpriv|cron|daemon|ftp|kern|local[0-7]|lpr|mail|news|syslog|user|uucp\";"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "    my $logopt = delete($plugin_conf{logopt});"
NSQ_SOURCE_LINE 00000042 "    $logopt = \"pid\" unless defined $logopt;"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "    keys %plugin_conf and"
NSQ_SOURCE_LINE 00000045 "        die \"Unknown configuration: \".join(\", \", sort keys %plugin_conf);"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    require Sys::Syslog;"
NSQ_SOURCE_LINE 00000048 "    Sys::Syslog::openlog($ident, $logopt, $facility) or die;"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "    return {"
NSQ_SOURCE_LINE 00000051 "        create_outputter => ["
NSQ_SOURCE_LINE 00000052 "            __PACKAGE__, # key"
NSQ_SOURCE_LINE 00000053 "            50,          # priority"
NSQ_SOURCE_LINE 00000054 "            sub {        # hook"
NSQ_SOURCE_LINE 00000055 "                my %hook_args = @_; # see Log::ger::Manual::Internals/\"Arguments passed to hook\""
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "                my $outputter = sub {"
NSQ_SOURCE_LINE 00000058 "                    my ($per_target_conf, $fmsg, $per_msg_conf) = @_;"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "                    my $num_level = $per_msg_conf ? $per_msg_conf->{level} : undef; $num_level = $hook_args{level} if !defined $num_level;"
NSQ_SOURCE_LINE 00000061 "                    my $str_level = Log::ger::Util::string_level($num_level);"
NSQ_SOURCE_LINE 00000062 "                    $level_map{$str_level} or die \"Don't know how to map \"."
NSQ_SOURCE_LINE 00000063 "                        \"Log::ger level '$str_level' to syslog level\";"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "                    Sys::Syslog::syslog("
NSQ_SOURCE_LINE 00000066 "                        &{\"Sys::Syslog::LOG_\".uc($level_map{$str_level})},"
NSQ_SOURCE_LINE 00000067 "                        $fmsg,"
NSQ_SOURCE_LINE 00000068 "                    );"
NSQ_SOURCE_LINE 00000069 "                };"
NSQ_SOURCE_LINE 00000070 "                [$outputter];"
NSQ_SOURCE_LINE 00000071 "            }],"
NSQ_SOURCE_LINE 00000072 "    };"
NSQ_SOURCE_LINE 00000073 "}"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "1;"
NSQ_SOURCE_LINE 00000076 "# ABSTRACT: Send logs to syslog"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "__END__"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "=pod"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "=head1 NAME"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "Log::ger::Output::Syslog - Send logs to syslog"
NSQ_SOURCE_LINE 00000087 ""
