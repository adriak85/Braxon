NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "version 0.005"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 " use Log::ger::Output 'Syslog' => ("
NSQ_SOURCE_LINE 00000095 "     ident    => 'myprog', # required"
NSQ_SOURCE_LINE 00000096 "     facility => 'daemon', # optional, default 'user'"
NSQ_SOURCE_LINE 00000097 " );"
NSQ_SOURCE_LINE 00000098 " use Log::ger;"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 " log_warn \"blah ...\";"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "This output plugin sends logs to syslog using L<Sys::Syslog>."
NSQ_SOURCE_LINE 00000105 "It accepts all C<syslog(3)> facilities."
