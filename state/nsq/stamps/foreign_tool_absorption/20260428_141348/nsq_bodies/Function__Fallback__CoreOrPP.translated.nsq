NSQ_SOURCE_LINE 00000001 "package Function::Fallback::CoreOrPP;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2020-02-03'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Function-Fallback-CoreOrPP'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.090'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our $USE_NONCORE_XS_FIRST = 1;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "require Exporter;"
NSQ_SOURCE_LINE 00000015 "our @ISA       = qw(Exporter);"
NSQ_SOURCE_LINE 00000016 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000017 "                       clone"
NSQ_SOURCE_LINE 00000018 "                       clone_list"
NSQ_SOURCE_LINE 00000019 "                       unbless"
NSQ_SOURCE_LINE 00000020 "                       uniq"
NSQ_SOURCE_LINE 00000021 "               );"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "sub clone {"
NSQ_SOURCE_LINE 00000024 "    my $data = shift;"
NSQ_SOURCE_LINE 00000025 "    goto FALLBACK unless $USE_NONCORE_XS_FIRST;"
NSQ_SOURCE_LINE 00000026 "    goto FALLBACK unless eval { require Data::Clone; 1 };"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "  STANDARD:"
NSQ_SOURCE_LINE 00000029 "    return Data::Clone::clone($data);"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "  FALLBACK:"
NSQ_SOURCE_LINE 00000032 "    require Clone::PP;"
NSQ_SOURCE_LINE 00000033 "    return Clone::PP::clone($data);"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub clone_list {"
NSQ_SOURCE_LINE 00000037 "    map { clone($_) } @_;"
NSQ_SOURCE_LINE 00000038 "}"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "sub _unbless_fallback {"
NSQ_SOURCE_LINE 00000041 "    my $ref = shift;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "    my $r = ref($ref);"
NSQ_SOURCE_LINE 00000044 "    # not a reference"
NSQ_SOURCE_LINE 00000045 "    return $ref unless $r;"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "    # return if not a blessed ref"
NSQ_SOURCE_LINE 00000048 "    my ($r2, $r3) = \"$ref\" =~ /(.+)=(.+?)\\(/"
NSQ_SOURCE_LINE 00000049 "        or return $ref;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    if ($r3 eq 'HASH') {"
NSQ_SOURCE_LINE 00000052 "        return { %$ref };"
NSQ_SOURCE_LINE 00000053 "    } elsif ($r3 eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000054 "        return [ @$ref ];"
NSQ_SOURCE_LINE 00000055 "    } elsif ($r3 eq 'SCALAR') {"
NSQ_SOURCE_LINE 00000056 "        return \\( my $copy = ${$ref} );"
NSQ_SOURCE_LINE 00000057 "    } elsif ($r3 eq 'CODE') {"
NSQ_SOURCE_LINE 00000058 "        return sub { goto &$ref };"
NSQ_SOURCE_LINE 00000059 "    } else {"
NSQ_SOURCE_LINE 00000060 "        die \"Can't handle $ref\";"
NSQ_SOURCE_LINE 00000061 "    }"
NSQ_SOURCE_LINE 00000062 "}"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "sub unbless {"
NSQ_SOURCE_LINE 00000065 "    my $ref = shift;"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "    goto FALLBACK unless $USE_NONCORE_XS_FIRST;"
NSQ_SOURCE_LINE 00000068 "    goto FALLBACK unless eval { require Acme::Damn; 1 };"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "  STANDARD:"
NSQ_SOURCE_LINE 00000071 "    return Acme::Damn::damn($ref);"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "  FALLBACK:"
NSQ_SOURCE_LINE 00000074 "    return _unbless_fallback($ref);"
NSQ_SOURCE_LINE 00000075 "}"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "sub uniq {"
NSQ_SOURCE_LINE 00000078 "    goto FALLBACK unless $USE_NONCORE_XS_FIRST;"
NSQ_SOURCE_LINE 00000079 "    goto FALLBACK unless eval { require List::MoreUtils; 1 };"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "  STANDARD:"
NSQ_SOURCE_LINE 00000082 "    return List::MoreUtils::uniq(@_);"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "  FALLBACK:"
NSQ_SOURCE_LINE 00000085 "    my %h;"
NSQ_SOURCE_LINE 00000086 "    my @res;"
NSQ_SOURCE_LINE 00000087 "    for (@_) {"
NSQ_SOURCE_LINE 00000088 "        push @res, $_ unless $h{$_}++;"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 "    return @res;"
NSQ_SOURCE_LINE 00000091 "}"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "1;"
NSQ_SOURCE_LINE 00000094 "# ABSTRACT: Functions that use non-core XS module but provide pure-Perl/core fallback"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "__END__"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "=pod"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "=head1 NAME"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "Function::Fallback::CoreOrPP - Functions that use non-core XS module but provide pure-Perl/core fallback"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=head1 VERSION"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "This document describes version 0.090 of Function::Fallback::CoreOrPP (from Perl distribution Function-Fallback-CoreOrPP), released on 2020-02-03."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 " use Function::Fallback::CoreOrPP qw(clone unbless uniq);"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 " my $clone = clone({blah=>1});"
NSQ_SOURCE_LINE 00000115 " my $unblessed = unbless($blessed_ref);"
NSQ_SOURCE_LINE 00000116 " my @uniq  = uniq(1, 3, 2, 1, 4);  # -> (1, 3, 2, 4)"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "This module provides functions that use non-core XS modules (for best speed,"
NSQ_SOURCE_LINE 00000121 "reliability, feature, etc) but falls back to those that use core XS or pure-Perl"
NSQ_SOURCE_LINE 00000122 "modules when the non-core XS module is not available."
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "This module helps when you want to bootstrap your Perl application with a"
NSQ_SOURCE_LINE 00000125 "portable, dependency-free Perl script. In a vanilla Perl installation (having"
NSQ_SOURCE_LINE 00000126 "only core modules), you can use L<App::FatPacker> to include non-core pure-Perl"
NSQ_SOURCE_LINE 00000127 "dependencies to your script."
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "=for Pod::Coverage ^()$"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=head2 clone($data) => $cloned"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "Try to use L<Data::Clone>'s C<clone>, but fall back to using L<Clone::PP>'s"
NSQ_SOURCE_LINE 00000136 "C<clone>."
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "=head2 clone_list(@data) => @data"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "A shortcut for:"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 " return map {clone($_)} @data"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=head2 unbless($ref) => $unblessed_ref"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "Try to use L<Acme::Damn>'s C<damn> to unbless a reference but fall back to"
NSQ_SOURCE_LINE 00000147 "shallow copying."
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "NOTE: C<damn()> B<MODIFIES> the original reference. (XXX in the future an option"
NSQ_SOURCE_LINE 00000150 "to clone the reference first will be provided), while shallow copying will"
NSQ_SOURCE_LINE 00000151 "return a shallow copy."
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "NOTE: The shallow copy method currently only handles blessed"
NSQ_SOURCE_LINE 00000154 "{scalar,array,hash}ref as those are the most common."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=head2 uniq(@ary) => @uniq_ary"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "Try to use L<List::MoreUtils>'s C<uniq>, but fall back to using slower,"
NSQ_SOURCE_LINE 00000159 "pure-Perl implementation."
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "Please visit the project's homepage at L<https://metacpan.org/release/Function-Fallback-CoreOrPP>."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "Source repository is at L<https://github.com/perlancar/perl-Function-Fallback-CoreOrPP>."
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "=head1 BUGS"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=Function-Fallback-CoreOrPP>"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000174 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000175 "feature."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "L<Clone::Any> can also use multiple backends. I used to avoid it because"
NSQ_SOURCE_LINE 00000180 "L<Storable>'s C<dclone> (which is used as the backend) did not support Regexp"
NSQ_SOURCE_LINE 00000181 "objects out of the box until version 3.08. Plus must use deparse to handle"
NSQ_SOURCE_LINE 00000182 "coderefs."
NSQ_SOURCE_LINE 00000183 ""
