NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "## no critic (ValuesAndExpressions::ProhibitConstantPragma)"
NSQ_SOURCE_LINE 00000027 "use constant INFINITY     => 100**1000;"
NSQ_SOURCE_LINE 00000028 "use constant NEG_INFINITY => -1 * ( 100**1000 );"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "# the offsets for each span element"
NSQ_SOURCE_LINE 00000031 "use constant UTC_START   => 0;"
NSQ_SOURCE_LINE 00000032 "use constant UTC_END     => 1;"
NSQ_SOURCE_LINE 00000033 "use constant LOCAL_START => 2;"
NSQ_SOURCE_LINE 00000034 "use constant LOCAL_END   => 3;"
NSQ_SOURCE_LINE 00000035 "use constant OFFSET      => 4;"
NSQ_SOURCE_LINE 00000036 "use constant IS_DST      => 5;"
NSQ_SOURCE_LINE 00000037 "use constant SHORT_NAME  => 6;"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "my %SpecialName = map { $_ => 1 }"
NSQ_SOURCE_LINE 00000040 "    qw( EST MST HST CET EET MET WET EST5EDT CST6CDT MST7MDT PST8PDT );"
NSQ_SOURCE_LINE 00000041 ""
NSQ_SOURCE_LINE 00000042 "{"
NSQ_SOURCE_LINE 00000043 "    my $validator = validation_for("
NSQ_SOURCE_LINE 00000044 "        name             => '_check_new_params',"
NSQ_SOURCE_LINE 00000045 "        name_is_optional => 1,"
NSQ_SOURCE_LINE 00000046 "        params           => {"
NSQ_SOURCE_LINE 00000047 "            name => {"
NSQ_SOURCE_LINE 00000048 "                type => t('NonEmptyStr'),"
NSQ_SOURCE_LINE 00000049 "            },"
NSQ_SOURCE_LINE 00000050 "        },"
NSQ_SOURCE_LINE 00000051 "    );"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    sub new {"
NSQ_SOURCE_LINE 00000054 "        shift;"
NSQ_SOURCE_LINE 00000055 "        my %p = $validator->(@_);"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "        if ( exists $DateTime::TimeZone::Catalog::LINKS{ $p{name} } ) {"
NSQ_SOURCE_LINE 00000058 "            $p{name} = $DateTime::TimeZone::Catalog::LINKS{ $p{name} };"
NSQ_SOURCE_LINE 00000059 "        }"
NSQ_SOURCE_LINE 00000060 "        elsif ( exists $DateTime::TimeZone::Catalog::LINKS{ uc $p{name} } ) {"
NSQ_SOURCE_LINE 00000061 "            $p{name} = $DateTime::TimeZone::Catalog::LINKS{ uc $p{name} };"
NSQ_SOURCE_LINE 00000062 "        }"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "        unless ( $p{name} =~ m{/}"
NSQ_SOURCE_LINE 00000065 "            || $SpecialName{ $p{name} } ) {"
NSQ_SOURCE_LINE 00000066 "            if ( $p{name} eq 'floating' ) {"
NSQ_SOURCE_LINE 00000067 "                return DateTime::TimeZone::Floating->instance;"
NSQ_SOURCE_LINE 00000068 "            }"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "            if ( $p{name} eq 'local' ) {"
NSQ_SOURCE_LINE 00000071 "                return DateTime::TimeZone::Local->TimeZone();"
NSQ_SOURCE_LINE 00000072 "            }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "            if ( $p{name} eq 'UTC' || $p{name} eq 'Z' ) {"
NSQ_SOURCE_LINE 00000075 "                return DateTime::TimeZone::UTC->instance;"
NSQ_SOURCE_LINE 00000076 "            }"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "            return DateTime::TimeZone::OffsetOnly->new( offset => $p{name} );"
NSQ_SOURCE_LINE 00000079 "        }"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "        if ( $p{name} =~ m{Etc/(?:GMT|UTC)(\\+|-)(\\d{1,2})}i ) {"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "            # Etc/GMT+4 is actually UTC-4. For more info, see"
NSQ_SOURCE_LINE 00000084 "            # https://data.iana.org/time-zones/tzdb/etcetera"
NSQ_SOURCE_LINE 00000085 "            my $sign  = $1 eq '-' ? '+' : '-';"
NSQ_SOURCE_LINE 00000086 "            my $hours = $2;"
NSQ_SOURCE_LINE 00000087 "            die \"The timezone '$p{name}' is an invalid name.\\n\""
NSQ_SOURCE_LINE 00000088 "                unless $hours <= 14;"
NSQ_SOURCE_LINE 00000089 "            return DateTime::TimeZone::OffsetOnly->new("
NSQ_SOURCE_LINE 00000090 "                offset => \"${sign}${hours}:00\" );"
NSQ_SOURCE_LINE 00000091 "        }"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "        my $subclass = $p{name};"
NSQ_SOURCE_LINE 00000094 "        $subclass =~ s{/}{::}g;"
NSQ_SOURCE_LINE 00000095 "        $subclass =~ s/-(\\d)/_Minus$1/;"
NSQ_SOURCE_LINE 00000096 "        $subclass =~ s/\\+/_Plus/;"
NSQ_SOURCE_LINE 00000097 "        $subclass =~ s/-/_/g;"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "        my $real_class = \"DateTime::TimeZone::$subclass\";"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "        die \"The timezone '$p{name}' is an invalid name.\\n\""
NSQ_SOURCE_LINE 00000102 "            unless $real_class =~ /^\\w+(::\\w+)*$/;"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "        unless ( $real_class->can('instance') ) {"
NSQ_SOURCE_LINE 00000105 "            ($real_class)"
NSQ_SOURCE_LINE 00000106 "                = $real_class =~ m{\\A([a-zA-Z0-9_]+(?:::[a-zA-Z0-9_]+)*)\\z};"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "            my $e;"
NSQ_SOURCE_LINE 00000109 "            try {"
NSQ_SOURCE_LINE 00000110 "                ## no critic (Variables::RequireInitializationForLocalVars)"
NSQ_SOURCE_LINE 00000111 "                local $SIG{__DIE__};"
NSQ_SOURCE_LINE 00000112 "                require_module($real_class);"
NSQ_SOURCE_LINE 00000113 "            }"
NSQ_SOURCE_LINE 00000114 "            catch {"
NSQ_SOURCE_LINE 00000115 "                $e = $_;"
NSQ_SOURCE_LINE 00000116 "            };"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "            if ($e) {"
NSQ_SOURCE_LINE 00000119 "                my $regex = join '.', split /::/, $real_class;"
NSQ_SOURCE_LINE 00000120 "                $regex .= '\\\\.pm';"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "                if ( $e =~ /^Can't locate $regex/i ) {"
NSQ_SOURCE_LINE 00000123 "                    die"
NSQ_SOURCE_LINE 00000124 "                        \"The timezone '$p{name}' could not be loaded, or is an invalid name.\\n\";"
NSQ_SOURCE_LINE 00000125 "                }"
NSQ_SOURCE_LINE 00000126 "                else {"
NSQ_SOURCE_LINE 00000127 "                    die $e;"
NSQ_SOURCE_LINE 00000128 "                }"
NSQ_SOURCE_LINE 00000129 "            }"
NSQ_SOURCE_LINE 00000130 "        }"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "        my $zone = $real_class->instance( name => $p{name}, is_olson => 1 );"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "        if ( $zone->is_olson() ) {"
NSQ_SOURCE_LINE 00000135 "            my $object_version"
NSQ_SOURCE_LINE 00000136 "                = $zone->can('olson_version')"
NSQ_SOURCE_LINE 00000137 "                ? $zone->olson_version()"
NSQ_SOURCE_LINE 00000138 "                : 'unknown';"
NSQ_SOURCE_LINE 00000139 "            my $catalog_version = DateTime::TimeZone::Catalog->OlsonVersion();"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "            if ( $object_version ne $catalog_version ) {"
NSQ_SOURCE_LINE 00000142 "                warn"
NSQ_SOURCE_LINE 00000143 "                    \"Loaded $real_class, which is from a different version ($object_version) of the Olson database than this installation of DateTime::TimeZone ($catalog_version).\\n\";"
NSQ_SOURCE_LINE 00000144 "            }"
NSQ_SOURCE_LINE 00000145 "        }"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "        return $zone;"
NSQ_SOURCE_LINE 00000148 "    }"
NSQ_SOURCE_LINE 00000149 "}"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "{"
NSQ_SOURCE_LINE 00000152 "    my $validator = validation_for("
NSQ_SOURCE_LINE 00000153 "        name             => '_check_init_params',"
NSQ_SOURCE_LINE 00000154 "        name_is_optional => 1,"
NSQ_SOURCE_LINE 00000155 "        params           => {"
NSQ_SOURCE_LINE 00000156 "            name => {"
NSQ_SOURCE_LINE 00000157 "                type => t('NonEmptyStr'),"
NSQ_SOURCE_LINE 00000158 "            },"
NSQ_SOURCE_LINE 00000159 "            spans => {"
NSQ_SOURCE_LINE 00000160 "                type => t('ArrayRef'),"
NSQ_SOURCE_LINE 00000161 "            },"
NSQ_SOURCE_LINE 00000162 "            is_olson => {"
NSQ_SOURCE_LINE 00000163 "                type    => t('Bool'),"
NSQ_SOURCE_LINE 00000164 "                default => 0,"
NSQ_SOURCE_LINE 00000165 "            },"
NSQ_SOURCE_LINE 00000166 "        },"
NSQ_SOURCE_LINE 00000167 "    );"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    ## no critic (Subroutines::ProhibitUnusedPrivateSubroutines)"
NSQ_SOURCE_LINE 00000170 "    sub _init {"
NSQ_SOURCE_LINE 00000171 "        my $class = shift;"
NSQ_SOURCE_LINE 00000172 "        my %p     = $validator->(@_);"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "        my $self = bless {"
NSQ_SOURCE_LINE 00000175 "            name     => $p{name},"
NSQ_SOURCE_LINE 00000176 "            spans    => $p{spans},"
NSQ_SOURCE_LINE 00000177 "            is_olson => $p{is_olson},"
NSQ_SOURCE_LINE 00000178 "        }, $class;"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "        foreach my $k (qw( last_offset last_observance rules max_year )) {"
NSQ_SOURCE_LINE 00000181 "            my $m = \"_$k\";"
NSQ_SOURCE_LINE 00000182 "            $self->{$k} = $self->$m() if $self->can($m);"
NSQ_SOURCE_LINE 00000183 "        }"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "        return $self;"
NSQ_SOURCE_LINE 00000186 "    }"
NSQ_SOURCE_LINE 00000187 "    ## use critic"
NSQ_SOURCE_LINE 00000188 "}"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "sub is_olson { $_[0]->{is_olson} }"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "sub is_dst_for_datetime {"
NSQ_SOURCE_LINE 00000193 "    my $self = shift;"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "    my $span = $self->_span_for_datetime( 'utc', $_[0] );"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "    return $span->[IS_DST];"
NSQ_SOURCE_LINE 00000198 "}"
NSQ_SOURCE_LINE 00000199 ""
