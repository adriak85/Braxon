NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "our $VERSION = '2.68';"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "# Note that while we make use of DateTime::Duration in this module if we"
