NSQ_SOURCE_LINE 00000201 "    my $self = shift;"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    my $span = $self->_span_for_datetime( 'utc', $_[0] );"
NSQ_SOURCE_LINE 00000204 ""
NSQ_SOURCE_LINE 00000205 "    return $span->[OFFSET];"
NSQ_SOURCE_LINE 00000206 "}"
NSQ_SOURCE_LINE 00000207 ""
