NSQ_SOURCE_LINE 00000209 "    my $self = shift;"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "    my $span = $self->_span_for_datetime( 'local', $_[0] );"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "    return $span->[OFFSET];"
NSQ_SOURCE_LINE 00000214 "}"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "sub short_name_for_datetime {"
NSQ_SOURCE_LINE 00000217 "    my $self = shift;"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "    my $span = $self->_span_for_datetime( 'utc', $_[0] );"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "    return $span->[SHORT_NAME];"
NSQ_SOURCE_LINE 00000222 "}"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "sub _span_for_datetime {"
NSQ_SOURCE_LINE 00000225 "    my $self = shift;"
NSQ_SOURCE_LINE 00000226 "    my $type = shift;"
NSQ_SOURCE_LINE 00000227 "    my $dt   = shift;"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "    my $method = $type . '_rd_as_seconds';"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "    my $end = $type eq 'utc' ? UTC_END : LOCAL_END;"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "    my $span;"
NSQ_SOURCE_LINE 00000234 "    my $seconds = $dt->$method();"
NSQ_SOURCE_LINE 00000235 "    if ( $seconds < $self->max_span->[$end] ) {"
NSQ_SOURCE_LINE 00000236 "        $span = $self->_spans_binary_search( $type, $seconds );"
NSQ_SOURCE_LINE 00000237 "    }"
NSQ_SOURCE_LINE 00000238 "    else {"
NSQ_SOURCE_LINE 00000239 "        my $until_year = $dt->utc_year + 1;"
NSQ_SOURCE_LINE 00000240 "        $span = $self->_generate_spans_until_match("
NSQ_SOURCE_LINE 00000241 "            $until_year, $seconds,"
NSQ_SOURCE_LINE 00000242 "            $type"
NSQ_SOURCE_LINE 00000243 "        );"
NSQ_SOURCE_LINE 00000244 "    }"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "    # This means someone gave a local time that doesn't exist"
NSQ_SOURCE_LINE 00000247 "    # (like during a transition into savings time)"
NSQ_SOURCE_LINE 00000248 "    unless ( defined $span ) {"
NSQ_SOURCE_LINE 00000249 "        my $err = 'Invalid local time for date';"
NSQ_SOURCE_LINE 00000250 "        $err .= q{ } . $dt->iso8601 if $type eq 'utc';"
NSQ_SOURCE_LINE 00000251 "        $err .= ' in time zone: ' . $self->name;"
NSQ_SOURCE_LINE 00000252 "        $err .= \"\\n\";"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "        die $err;"
NSQ_SOURCE_LINE 00000255 "    }"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    return $span;"
NSQ_SOURCE_LINE 00000258 "}"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "sub _spans_binary_search {"
NSQ_SOURCE_LINE 00000261 "    my $self = shift;"
NSQ_SOURCE_LINE 00000262 "    my ( $type, $seconds ) = @_;"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "    my ( $start, $end ) = _keys_for_type($type);"
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "    my $min = 0;"
NSQ_SOURCE_LINE 00000267 "    my $max = scalar @{ $self->{spans} } + 1;"
NSQ_SOURCE_LINE 00000268 "    my $i   = int( $max / 2 );"
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "    # special case for when there are only 2 spans"
NSQ_SOURCE_LINE 00000271 "    $i++ if $max % 2 && $max != 3;"
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "    $i = 0 if @{ $self->{spans} } == 1;"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "    while (1) {"
NSQ_SOURCE_LINE 00000276 "        my $current = $self->{spans}[$i];"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "        if ( $seconds < $current->[$start] ) {"
NSQ_SOURCE_LINE 00000279 "            $max = $i;"
NSQ_SOURCE_LINE 00000280 "            my $c = int( ( $i - $min ) / 2 );"
NSQ_SOURCE_LINE 00000281 "            $c ||= 1;"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "            $i -= $c;"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "            return if $i < $min;"
NSQ_SOURCE_LINE 00000286 "        }"
NSQ_SOURCE_LINE 00000287 "        elsif ( $seconds >= $current->[$end] ) {"
NSQ_SOURCE_LINE 00000288 "            $min = $i;"
NSQ_SOURCE_LINE 00000289 "            my $c = int( ( $max - $i ) / 2 );"
NSQ_SOURCE_LINE 00000290 "            $c ||= 1;"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "            $i += $c;"
NSQ_SOURCE_LINE 00000293 ""
NSQ_SOURCE_LINE 00000294 "            return if $i >= $max;"
NSQ_SOURCE_LINE 00000295 "        }"
NSQ_SOURCE_LINE 00000296 "        else {"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "            # Special case for overlapping ranges because of DST and"
NSQ_SOURCE_LINE 00000299 "            # other weirdness (like Alaska's change when bought from"
NSQ_SOURCE_LINE 00000300 "            # Russia by the US).  Always prefer latest span."
NSQ_SOURCE_LINE 00000301 "            if ( $current->[IS_DST] && $type eq 'local' ) {"
NSQ_SOURCE_LINE 00000302 ""
NSQ_SOURCE_LINE 00000303 "                # Asia/Dhaka in 2009j goes into DST without any known"
NSQ_SOURCE_LINE 00000304 "                # end-of-DST date (wtf, Bangladesh)."
NSQ_SOURCE_LINE 00000305 "                return $current if $current->[UTC_END] == INFINITY;"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "                my $next = $self->{spans}[ $i + 1 ];"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "                # Sometimes we will get here and the span we're"
NSQ_SOURCE_LINE 00000310 "                # looking at is the last that's been generated so far."
NSQ_SOURCE_LINE 00000311 "                # We need to try to generate one more or else we run"
NSQ_SOURCE_LINE 00000312 "                # out."
NSQ_SOURCE_LINE 00000313 "                $next ||= $self->_generate_next_span;"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "                die \"No next span in $self->{max_year}\" unless defined $next;"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "                if (   ( !$next->[IS_DST] )"
NSQ_SOURCE_LINE 00000318 "                    && $next->[$start] <= $seconds"
NSQ_SOURCE_LINE 00000319 "                    && $seconds <= $next->[$end] ) {"
NSQ_SOURCE_LINE 00000320 "                    return $next;"
NSQ_SOURCE_LINE 00000321 "                }"
NSQ_SOURCE_LINE 00000322 "            }"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "            return $current;"
NSQ_SOURCE_LINE 00000325 "        }"
NSQ_SOURCE_LINE 00000326 "    }"
NSQ_SOURCE_LINE 00000327 "}"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "sub _generate_next_span {"
NSQ_SOURCE_LINE 00000330 "    my $self = shift;"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "    my $last_idx = $#{ $self->{spans} };"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "    my $max_span = $self->max_span;"
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "    # Kind of a hack, but AFAIK there are no zones where it takes"
NSQ_SOURCE_LINE 00000337 "    # _more_ than a year for a _future_ time zone change to occur, so"
NSQ_SOURCE_LINE 00000338 "    # by looking two years out we can ensure that we will find at"
NSQ_SOURCE_LINE 00000339 "    # least one more span.  Of course, I will no doubt be proved wrong"
NSQ_SOURCE_LINE 00000340 "    # and this will cause errors."
NSQ_SOURCE_LINE 00000341 "    $self->_generate_spans_until_match("
NSQ_SOURCE_LINE 00000342 "        $self->{max_year} + 2,"
NSQ_SOURCE_LINE 00000343 "        $max_span->[UTC_END] + ( 366 * 86400 ), 'utc'"
NSQ_SOURCE_LINE 00000344 "    );"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "    return $self->{spans}[ $last_idx + 1 ];"
NSQ_SOURCE_LINE 00000347 "}"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "sub _generate_spans_until_match {"
NSQ_SOURCE_LINE 00000350 "    my $self                = shift;"
NSQ_SOURCE_LINE 00000351 "    my $generate_until_year = shift;"
NSQ_SOURCE_LINE 00000352 "    my $seconds             = shift;"
NSQ_SOURCE_LINE 00000353 "    my $type                = shift;"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "    my @changes;"
NSQ_SOURCE_LINE 00000356 "    my @rules = @{ $self->_rules };"
NSQ_SOURCE_LINE 00000357 "    foreach my $year ( $self->{max_year} .. $generate_until_year ) {"
NSQ_SOURCE_LINE 00000358 "        ## no critic (ControlStructures::ProhibitCStyleForLoops)"
NSQ_SOURCE_LINE 00000359 "        for ( my $x = 0; $x < @rules; $x++ ) {"
NSQ_SOURCE_LINE 00000360 "            my $last_offset_from_std;"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "            if ( @rules == 2 ) {"
NSQ_SOURCE_LINE 00000363 "                $last_offset_from_std"
NSQ_SOURCE_LINE 00000364 "                    = $x"
NSQ_SOURCE_LINE 00000365 "                    ? $rules[0]->offset_from_std"
NSQ_SOURCE_LINE 00000366 "                    : $rules[1]->offset_from_std;"
NSQ_SOURCE_LINE 00000367 "            }"
NSQ_SOURCE_LINE 00000368 "            elsif ( @rules == 1 ) {"
NSQ_SOURCE_LINE 00000369 "                $last_offset_from_std = $rules[0]->offset_from_std;"
NSQ_SOURCE_LINE 00000370 "            }"
NSQ_SOURCE_LINE 00000371 "            else {"
NSQ_SOURCE_LINE 00000372 "                my $count = scalar @rules;"
NSQ_SOURCE_LINE 00000373 "                die"
NSQ_SOURCE_LINE 00000374 "                    \"Cannot generate future changes for zone with $count infinite rules\\n\";"
NSQ_SOURCE_LINE 00000375 "            }"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "            my $rule = $rules[$x];"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "            my $next = $rule->utc_start_datetime_for_year("
NSQ_SOURCE_LINE 00000380 "                $year,"
NSQ_SOURCE_LINE 00000381 "                $self->{last_offset}, $last_offset_from_std"
NSQ_SOURCE_LINE 00000382 "            );"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "            # don't bother with changes we've seen already"
NSQ_SOURCE_LINE 00000385 "            next if $next->utc_rd_as_seconds < $self->max_span->[UTC_END];"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "            push @changes,"
NSQ_SOURCE_LINE 00000388 "                DateTime::TimeZone::OlsonDB::Change->new("
NSQ_SOURCE_LINE 00000389 "                type                 => 'rule',"
NSQ_SOURCE_LINE 00000390 "                utc_start_datetime   => $next,"
NSQ_SOURCE_LINE 00000391 "                local_start_datetime => $next + DateTime::Duration->new("
NSQ_SOURCE_LINE 00000392 "                    seconds => $self->{last_observance}->total_offset"
NSQ_SOURCE_LINE 00000393 "                        + $rule->offset_from_std"
NSQ_SOURCE_LINE 00000394 "                ),"
NSQ_SOURCE_LINE 00000395 "                short_name => $self->{last_observance}"
NSQ_SOURCE_LINE 00000396 "                    ->formatted_short_name( $rule->letter, $rule ),"
NSQ_SOURCE_LINE 00000397 "                observance => $self->{last_observance},"
NSQ_SOURCE_LINE 00000398 "                rule       => $rule,"
NSQ_SOURCE_LINE 00000399 "                );"
NSQ_SOURCE_LINE 00000400 "        }"
NSQ_SOURCE_LINE 00000401 "    }"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "    $self->{max_year} = $generate_until_year;"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "    my @sorted"
NSQ_SOURCE_LINE 00000406 "        = sort { $a->utc_start_datetime <=> $b->utc_start_datetime } @changes;"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "    my ( $start, $end ) = _keys_for_type($type);"
NSQ_SOURCE_LINE 00000409 ""
NSQ_SOURCE_LINE 00000410 "    my $match;"
NSQ_SOURCE_LINE 00000411 "    ## no critic (ControlStructures::ProhibitCStyleForLoops)"
NSQ_SOURCE_LINE 00000412 "    for ( my $x = 1; $x < @sorted; $x++ ) {"
NSQ_SOURCE_LINE 00000413 "        my $span = DateTime::TimeZone::OlsonDB::Change::two_changes_as_span("
NSQ_SOURCE_LINE 00000414 "            @sorted[ $x - 1, $x ] );"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "        $span = _span_as_array($span);"
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "        push @{ $self->{spans} }, $span;"
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "        $match = $span"
NSQ_SOURCE_LINE 00000421 "            if $seconds >= $span->[$start] && $seconds < $span->[$end];"
NSQ_SOURCE_LINE 00000422 "    }"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "    return $match;"
NSQ_SOURCE_LINE 00000425 "}"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "sub max_span { $_[0]->{spans}[-1] }"
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "sub _keys_for_type {"
NSQ_SOURCE_LINE 00000430 "    $_[0] eq 'utc' ? ( UTC_START, UTC_END ) : ( LOCAL_START, LOCAL_END );"
NSQ_SOURCE_LINE 00000431 "}"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "sub _span_as_array {"
NSQ_SOURCE_LINE 00000434 "    ["
NSQ_SOURCE_LINE 00000435 "        @{ $_[0] }{"
NSQ_SOURCE_LINE 00000436 "            qw( utc_start utc_end local_start local_end offset is_dst short_name )"
NSQ_SOURCE_LINE 00000437 "        }"
NSQ_SOURCE_LINE 00000438 "    ];"
NSQ_SOURCE_LINE 00000439 "}"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "sub is_floating {0}"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "sub is_utc {0}"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "sub has_dst_changes {0}"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "sub name     { $_[0]->{name} }"
NSQ_SOURCE_LINE 00000448 "sub category { ( split /\\//, $_[0]->{name}, 2 )[0] }"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "sub is_valid_name {"
NSQ_SOURCE_LINE 00000451 "    my $class = shift;"
NSQ_SOURCE_LINE 00000452 "    my $name  = shift;"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "    my $tz = try {"
NSQ_SOURCE_LINE 00000455 "        ## no critic (Variables::RequireInitializationForLocalVars)"
NSQ_SOURCE_LINE 00000456 "        local $SIG{__DIE__};"
NSQ_SOURCE_LINE 00000457 "        $class->new( name => $name );"
NSQ_SOURCE_LINE 00000458 "    };"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "    return $tz && $tz->isa('DateTime::TimeZone') ? 1 : 0;"
NSQ_SOURCE_LINE 00000461 "}"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "sub STORABLE_freeze {"
NSQ_SOURCE_LINE 00000464 "    my $self = shift;"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "    return $self->name;"
NSQ_SOURCE_LINE 00000467 "}"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "sub STORABLE_thaw {"
NSQ_SOURCE_LINE 00000470 "    my $self = shift;"
NSQ_SOURCE_LINE 00000471 "    shift;"
NSQ_SOURCE_LINE 00000472 "    my $serialized = shift;"
NSQ_SOURCE_LINE 00000473 ""
NSQ_SOURCE_LINE 00000474 "    my $class = ref $self || $self;"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "    my $obj;"
NSQ_SOURCE_LINE 00000477 "    if ( $class->isa(__PACKAGE__) ) {"
NSQ_SOURCE_LINE 00000478 "        $obj = __PACKAGE__->new( name => $serialized );"
NSQ_SOURCE_LINE 00000479 "    }"
NSQ_SOURCE_LINE 00000480 "    else {"
NSQ_SOURCE_LINE 00000481 "        $obj = $class->new( name => $serialized );"
NSQ_SOURCE_LINE 00000482 "    }"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "    %$self = %$obj;"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "    return $self;"
NSQ_SOURCE_LINE 00000487 "}"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "#"
NSQ_SOURCE_LINE 00000490 "# Functions"
NSQ_SOURCE_LINE 00000491 "#"
NSQ_SOURCE_LINE 00000492 "sub offset_as_seconds {"
NSQ_SOURCE_LINE 00000493 "    my $offset = shift;"
NSQ_SOURCE_LINE 00000494 "    $offset = shift if try {"
NSQ_SOURCE_LINE 00000495 "        ## no critic (Variables::RequireInitializationForLocalVars)"
NSQ_SOURCE_LINE 00000496 "        local $SIG{__DIE__};"
NSQ_SOURCE_LINE 00000497 "        $offset->isa('DateTime::TimeZone');"
NSQ_SOURCE_LINE 00000498 "    };"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "    return undef unless defined $offset;"
NSQ_SOURCE_LINE 00000501 ""
NSQ_SOURCE_LINE 00000502 "    return 0 if $offset eq '0';"
NSQ_SOURCE_LINE 00000503 ""
NSQ_SOURCE_LINE 00000504 "    my ( $sign, $hours, $minutes, $seconds );"
NSQ_SOURCE_LINE 00000505 "    if ( $offset =~ /^([\\+\\-])?(\\d\\d?):(\\d\\d)(?::(\\d\\d))?$/ ) {"
NSQ_SOURCE_LINE 00000506 "        ( $sign, $hours, $minutes, $seconds ) = ( $1, $2, $3, $4 );"
NSQ_SOURCE_LINE 00000507 "    }"
NSQ_SOURCE_LINE 00000508 "    elsif ( $offset =~ /^([\\+\\-])?(\\d\\d)(\\d\\d)(\\d\\d)?$/ ) {"
NSQ_SOURCE_LINE 00000509 "        ( $sign, $hours, $minutes, $seconds ) = ( $1, $2, $3, $4 );"
NSQ_SOURCE_LINE 00000510 "    }"
NSQ_SOURCE_LINE 00000511 "    else {"
NSQ_SOURCE_LINE 00000512 "        return undef;"
NSQ_SOURCE_LINE 00000513 "    }"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "    $sign = '+'  unless defined $sign;"
NSQ_SOURCE_LINE 00000516 "    return undef unless $hours >= 0   && $hours <= 99;"
NSQ_SOURCE_LINE 00000517 "    return undef unless $minutes >= 0 && $minutes <= 59;"
NSQ_SOURCE_LINE 00000518 "    return undef"
NSQ_SOURCE_LINE 00000519 "        unless !defined($seconds) || ( $seconds >= 0 && $seconds <= 59 );"
NSQ_SOURCE_LINE 00000520 ""
NSQ_SOURCE_LINE 00000521 "    my $total = $hours * 3600 + $minutes * 60;"
NSQ_SOURCE_LINE 00000522 "    $total += $seconds if $seconds;"
NSQ_SOURCE_LINE 00000523 "    $total *= -1       if $sign eq '-';"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "    return $total;"
NSQ_SOURCE_LINE 00000526 "}"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "sub offset_as_string {"
NSQ_SOURCE_LINE 00000529 "    my $offset = shift;"
NSQ_SOURCE_LINE 00000530 "    $offset = shift if try {"
NSQ_SOURCE_LINE 00000531 "        ## no critic (Variables::RequireInitializationForLocalVars)"
NSQ_SOURCE_LINE 00000532 "        local $SIG{__DIE__};"
NSQ_SOURCE_LINE 00000533 "        $offset->isa('DateTime::TimeZone');"
NSQ_SOURCE_LINE 00000534 "    };"
NSQ_SOURCE_LINE 00000535 "    my $sep = shift || q{};"
NSQ_SOURCE_LINE 00000536 ""
NSQ_SOURCE_LINE 00000537 "    return undef unless defined $offset;"
NSQ_SOURCE_LINE 00000538 "    return undef unless $offset >= -359999 && $offset <= 359999;"
NSQ_SOURCE_LINE 00000539 ""
NSQ_SOURCE_LINE 00000540 "    my $sign = $offset < 0 ? '-' : '+';"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "    $offset = abs($offset);"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "    my $hours = int( $offset / 3600 );"
NSQ_SOURCE_LINE 00000545 "    $offset %= 3600;"
NSQ_SOURCE_LINE 00000546 "    my $mins = int( $offset / 60 );"
NSQ_SOURCE_LINE 00000547 "    $offset %= 60;"
NSQ_SOURCE_LINE 00000548 "    my $secs = int($offset);"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "    return ("
NSQ_SOURCE_LINE 00000551 "        $secs"
NSQ_SOURCE_LINE 00000552 "        ? sprintf("
NSQ_SOURCE_LINE 00000553 "            '%s%02d%s%02d%s%02d', $sign, $hours, $sep, $mins, $sep, $secs"
NSQ_SOURCE_LINE 00000554 "            )"
NSQ_SOURCE_LINE 00000555 "        : sprintf( '%s%02d%s%02d', $sign, $hours, $sep, $mins )"
NSQ_SOURCE_LINE 00000556 "    );"
NSQ_SOURCE_LINE 00000557 "}"
NSQ_SOURCE_LINE 00000558 ""
NSQ_SOURCE_LINE 00000559 "# These methods all operate on data contained in the DateTime/TimeZone/Catalog.pm file."
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "sub all_names {"
NSQ_SOURCE_LINE 00000562 "    return wantarray"
NSQ_SOURCE_LINE 00000563 "        ? @DateTime::TimeZone::Catalog::ALL"
NSQ_SOURCE_LINE 00000564 "        : [@DateTime::TimeZone::Catalog::ALL];"
NSQ_SOURCE_LINE 00000565 "}"
NSQ_SOURCE_LINE 00000566 ""
NSQ_SOURCE_LINE 00000567 "sub categories {"
NSQ_SOURCE_LINE 00000568 "    return wantarray"
NSQ_SOURCE_LINE 00000569 "        ? @DateTime::TimeZone::Catalog::CATEGORY_NAMES"
NSQ_SOURCE_LINE 00000570 "        : [@DateTime::TimeZone::Catalog::CATEGORY_NAMES];"
NSQ_SOURCE_LINE 00000571 "}"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "sub links {"
NSQ_SOURCE_LINE 00000574 "    return wantarray"
NSQ_SOURCE_LINE 00000575 "        ? %DateTime::TimeZone::Catalog::LINKS"
NSQ_SOURCE_LINE 00000576 "        : {%DateTime::TimeZone::Catalog::LINKS};"
NSQ_SOURCE_LINE 00000577 "}"
NSQ_SOURCE_LINE 00000578 ""
NSQ_SOURCE_LINE 00000579 "sub names_in_category {"
NSQ_SOURCE_LINE 00000580 "    shift if $_[0]->isa('DateTime::TimeZone');"
NSQ_SOURCE_LINE 00000581 "    return unless exists $DateTime::TimeZone::Catalog::CATEGORIES{ $_[0] };"
NSQ_SOURCE_LINE 00000582 ""
NSQ_SOURCE_LINE 00000583 "    return wantarray"
NSQ_SOURCE_LINE 00000584 "        ? @{ $DateTime::TimeZone::Catalog::CATEGORIES{ $_[0] } }"
NSQ_SOURCE_LINE 00000585 "        : $DateTime::TimeZone::Catalog::CATEGORIES{ $_[0] };"
NSQ_SOURCE_LINE 00000586 "}"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "sub countries {"
NSQ_SOURCE_LINE 00000589 "    wantarray"
NSQ_SOURCE_LINE 00000590 "        ? ( sort keys %DateTime::TimeZone::Catalog::ZONES_BY_COUNTRY )"
NSQ_SOURCE_LINE 00000591 "        : [ sort keys %DateTime::TimeZone::Catalog::ZONES_BY_COUNTRY ];"
NSQ_SOURCE_LINE 00000592 "}"
NSQ_SOURCE_LINE 00000593 ""
NSQ_SOURCE_LINE 00000594 "sub names_in_country {"
NSQ_SOURCE_LINE 00000595 "    shift if $_[0]->isa('DateTime::TimeZone');"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "    return"
NSQ_SOURCE_LINE 00000598 "        unless"
NSQ_SOURCE_LINE 00000599 "        exists $DateTime::TimeZone::Catalog::ZONES_BY_COUNTRY{ lc $_[0] };"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "    return"
NSQ_SOURCE_LINE 00000602 "        wantarray"
NSQ_SOURCE_LINE 00000603 "        ? @{ $DateTime::TimeZone::Catalog::ZONES_BY_COUNTRY{ lc $_[0] } }"
NSQ_SOURCE_LINE 00000604 "        : $DateTime::TimeZone::Catalog::ZONES_BY_COUNTRY{ lc $_[0] };"
NSQ_SOURCE_LINE 00000605 "}"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "1;"
NSQ_SOURCE_LINE 00000608 ""
NSQ_SOURCE_LINE 00000609 "# ABSTRACT: Time zone object base class and factory"
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "__END__"
NSQ_SOURCE_LINE 00000612 ""
NSQ_SOURCE_LINE 00000613 "=pod"
NSQ_SOURCE_LINE 00000614 ""
NSQ_SOURCE_LINE 00000615 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "=head1 NAME"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "DateTime::TimeZone - Time zone object base class and factory"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "=head1 VERSION"
NSQ_SOURCE_LINE 00000622 ""
NSQ_SOURCE_LINE 00000623 "version 2.68"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000626 ""
NSQ_SOURCE_LINE 00000627 "  use DateTime;"
NSQ_SOURCE_LINE 00000628 "  use DateTime::TimeZone;"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "  my $tz = DateTime::TimeZone->new( name => 'America/Chicago' );"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "  my $dt = DateTime->now();"
NSQ_SOURCE_LINE 00000633 "  my $offset = $tz->offset_for_datetime($dt);"
NSQ_SOURCE_LINE 00000634 ""
NSQ_SOURCE_LINE 00000635 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "This class is the base class for all time zone objects.  A time zone is"
NSQ_SOURCE_LINE 00000638 "represented internally as a set of observances, each of which describes the"
NSQ_SOURCE_LINE 00000639 "offset from GMT for a given time period."
NSQ_SOURCE_LINE 00000640 ""
NSQ_SOURCE_LINE 00000641 "Note that without the L<DateTime> module, this module does not do much.  It's"
NSQ_SOURCE_LINE 00000642 "primary interface is through a L<DateTime> object, and most users will not need"
NSQ_SOURCE_LINE 00000643 "to directly use C<DateTime::TimeZone> methods."
NSQ_SOURCE_LINE 00000644 ""
NSQ_SOURCE_LINE 00000645 "=head2 Special Case Platforms"
NSQ_SOURCE_LINE 00000646 ""
NSQ_SOURCE_LINE 00000647 "If you are on the Win32 platform, you will want to also install"
NSQ_SOURCE_LINE 00000648 "L<DateTime::TimeZone::Local::Win32>. This will enable you to specify a time"
NSQ_SOURCE_LINE 00000649 "zone of C<'local'> when creating a L<DateTime> object."
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "If you are on HPUX, install L<DateTime::TimeZone::HPUX>. This provides support"
NSQ_SOURCE_LINE 00000652 "for HPUX style time zones like C<'MET-1METDST'>."
NSQ_SOURCE_LINE 00000653 ""
NSQ_SOURCE_LINE 00000654 "=head1 USAGE"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "This class has the following methods:"
NSQ_SOURCE_LINE 00000657 ""
NSQ_SOURCE_LINE 00000658 "=head2 DateTime::TimeZone->new( name => $tz_name )"
NSQ_SOURCE_LINE 00000659 ""
NSQ_SOURCE_LINE 00000660 "Given a valid time zone name, this method returns a new time zone blessed into"
NSQ_SOURCE_LINE 00000661 "the appropriate subclass.  Subclasses are named for the given time zone, so"
NSQ_SOURCE_LINE 00000662 "that the time zone \"America/Chicago\" is the"
NSQ_SOURCE_LINE 00000663 "DateTime::TimeZone::America::Chicago class."
NSQ_SOURCE_LINE 00000664 ""
NSQ_SOURCE_LINE 00000665 "If the name given is a \"link\" name in the Olson database, the object created"
NSQ_SOURCE_LINE 00000666 "may have a different name.  For example, there is a link from the old \"EST5EDT\""
NSQ_SOURCE_LINE 00000667 "name to \"America/New_York\"."
NSQ_SOURCE_LINE 00000668 ""
NSQ_SOURCE_LINE 00000669 "When loading a time zone from the Olson database, the constructor checks the"
NSQ_SOURCE_LINE 00000670 "version of the loaded class to make sure it matches the version of the current"
NSQ_SOURCE_LINE 00000671 "DateTime::TimeZone installation. If they do not match it will issue a warning."
NSQ_SOURCE_LINE 00000672 "This is useful because time zone names may fall out of use, but you may have an"
NSQ_SOURCE_LINE 00000673 "old module file installed for that time zone."
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "There are also several special values that can be given as names."
NSQ_SOURCE_LINE 00000676 ""
NSQ_SOURCE_LINE 00000677 "If the \"name\" parameter is \"floating\", then a C<DateTime::TimeZone::Floating>"
NSQ_SOURCE_LINE 00000678 "object is returned.  A floating time zone does not have I<any> offset, and is"
NSQ_SOURCE_LINE 00000679 "always the same time.  This is useful for calendaring applications, which may"
NSQ_SOURCE_LINE 00000680 "need to specify that a given event happens at the same I<local> time,"
NSQ_SOURCE_LINE 00000681 "regardless of where it occurs. See L<RFC"
NSQ_SOURCE_LINE 00000682 "2445|https://www.ietf.org/rfc/rfc2445.txt> for more details."
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "If the \"name\" parameter is \"UTC\", then a C<DateTime::TimeZone::UTC> object is"
NSQ_SOURCE_LINE 00000685 "returned."
NSQ_SOURCE_LINE 00000686 ""
NSQ_SOURCE_LINE 00000687 "If the \"name\" is an offset string, it is converted to a number, and a"
NSQ_SOURCE_LINE 00000688 "C<DateTime::TimeZone::OffsetOnly> object is returned."
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "=head3 The \"local\" time zone"
NSQ_SOURCE_LINE 00000691 ""
NSQ_SOURCE_LINE 00000692 "If the \"name\" parameter is \"local\", then the module attempts to determine the"
NSQ_SOURCE_LINE 00000693 "local time zone for the system."
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "The method for finding the local zone varies by operating system. See the"
NSQ_SOURCE_LINE 00000696 "appropriate module for details of how we check for the local time zone."
NSQ_SOURCE_LINE 00000697 ""
NSQ_SOURCE_LINE 00000698 "=over 4"
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "=item * L<DateTime::TimeZone::Local::Unix>"
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "=item * L<DateTime::TimeZone::Local::Android>"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "=item * L<DateTime::TimeZone::Local::hpux>"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "=item * L<DateTime::TimeZone::Local::Win32>"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "=item * L<DateTime::TimeZone::Local::VMS>"
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "=back"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "If a local time zone is not found, then an exception will be thrown. This"
NSQ_SOURCE_LINE 00000713 "exception will always stringify to something containing the text C<\"Cannot"
NSQ_SOURCE_LINE 00000714 "determine local time zone\">."
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "If you are writing code for users to run on systems you do not control, you"
NSQ_SOURCE_LINE 00000717 "should try to account for the possibility that this exception may be thrown."
NSQ_SOURCE_LINE 00000718 "Falling back to UTC might be a reasonable alternative."
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "When writing tests for your modules that might be run on others' systems, you"
NSQ_SOURCE_LINE 00000721 "are strongly encouraged to either not use C<local> when creating L<DateTime>"
NSQ_SOURCE_LINE 00000722 "objects or to set C<$ENV{TZ}> to a known value in your test code. All of the"
NSQ_SOURCE_LINE 00000723 "per-OS classes check this environment variable."
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "=head2 $tz->offset_for_datetime( $dt )"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "Given a C<DateTime> object, this method returns the offset in seconds for the"
NSQ_SOURCE_LINE 00000728 "given datetime.  This takes into account historical time zone information, as"
NSQ_SOURCE_LINE 00000729 "well as Daylight Saving Time.  The offset is determined by looking at the"
NSQ_SOURCE_LINE 00000730 "object's UTC Rata Die days and seconds."
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "=head2 $tz->offset_for_local_datetime( $dt )"
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "Given a C<DateTime> object, this method returns the offset in seconds for the"
NSQ_SOURCE_LINE 00000735 "given datetime.  Unlike the previous method, this method uses the local time's"
NSQ_SOURCE_LINE 00000736 "Rata Die days and seconds.  This should only be done when the corresponding UTC"
NSQ_SOURCE_LINE 00000737 "time is not yet known, because local times can be ambiguous due to Daylight"
NSQ_SOURCE_LINE 00000738 "Saving Time rules."
NSQ_SOURCE_LINE 00000739 ""
NSQ_SOURCE_LINE 00000740 "=head2 $tz->is_dst_for_datetime( $dt )"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "Given a C<DateTime> object, this method returns true if the DateTime is"
NSQ_SOURCE_LINE 00000743 "currently in Daylight Saving Time."
NSQ_SOURCE_LINE 00000744 ""
NSQ_SOURCE_LINE 00000745 "=head2 $tz->name"
NSQ_SOURCE_LINE 00000746 ""
NSQ_SOURCE_LINE 00000747 "Returns the name of the time zone."
NSQ_SOURCE_LINE 00000748 ""
NSQ_SOURCE_LINE 00000749 "=head2 $tz->short_name_for_datetime( $dt )"
NSQ_SOURCE_LINE 00000750 ""
NSQ_SOURCE_LINE 00000751 "Given a C<DateTime> object, this method returns the \"short name\" for the"
NSQ_SOURCE_LINE 00000752 "current observance and rule this datetime is in.  These are names like \"EST\","
NSQ_SOURCE_LINE 00000753 "\"GMT\", etc."
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "It is B<strongly> recommended that you do not rely on these names for anything"
NSQ_SOURCE_LINE 00000756 "other than display.  These names are not official, and many of them are simply"
NSQ_SOURCE_LINE 00000757 "the invention of the Olson database maintainers. Moreover, these names are not"
NSQ_SOURCE_LINE 00000758 "unique.  For example, there is an \"EST\" at both -0500 and +1000/+1100."
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "=head2 $tz->is_floating"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "Returns a boolean indicating whether or not this object represents a floating"
NSQ_SOURCE_LINE 00000763 "time zone, as defined by L<RFC 2445|https://www.ietf.org/rfc/rfc2445.txt>."
NSQ_SOURCE_LINE 00000764 ""
NSQ_SOURCE_LINE 00000765 "=head2 $tz->is_utc"
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "Indicates whether or not this object represents the UTC (GMT) time zone."
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "=head2 $tz->has_dst_changes"
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "Indicates whether or not this zone has I<ever> had a change to and from DST,"
NSQ_SOURCE_LINE 00000772 "either in the past or future."
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "=head2 $tz->is_olson"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "Returns true if the time zone is a named time zone from the Olson database."
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "=head2 $tz->category"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "Returns the part of the time zone name before the first slash.  For example,"
NSQ_SOURCE_LINE 00000781 "the \"America/Chicago\" time zone would return \"America\"."
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "=head2 DateTime::TimeZone->is_valid_name($name)"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "Given a string, this method returns a boolean value indicating whether or not"
NSQ_SOURCE_LINE 00000786 "the string is a valid time zone name.  If you are using"
NSQ_SOURCE_LINE 00000787 "C<DateTime::TimeZone::Alias>, any aliases you've created will be valid."
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "=head2 DateTime::TimeZone->all_names"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "This returns a pre-sorted list of all the time zone names.  This list does not"
NSQ_SOURCE_LINE 00000792 "include link names.  In scalar context, it returns an array reference, while in"
NSQ_SOURCE_LINE 00000793 "list context it returns an array."
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "=head2 DateTime::TimeZone->categories"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "This returns a list of all time zone categories.  In scalar context, it returns"
NSQ_SOURCE_LINE 00000798 "an array reference, while in list context it returns an array."
NSQ_SOURCE_LINE 00000799 ""
NSQ_SOURCE_LINE 00000800 "=head2 DateTime::TimeZone->links"
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "This returns a hash of all time zone links, where the keys are the old,"
NSQ_SOURCE_LINE 00000803 "deprecated names, and the values are the new names.  In scalar context, it"
NSQ_SOURCE_LINE 00000804 "returns a hash reference, while in list context it returns a hash."
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "=head2 DateTime::TimeZone->names_in_category( $category )"
NSQ_SOURCE_LINE 00000807 ""
NSQ_SOURCE_LINE 00000808 "Given a valid category, this method returns a list of the names in that"
NSQ_SOURCE_LINE 00000809 "category, without the category portion.  So the list for the \"America\" category"
NSQ_SOURCE_LINE 00000810 "would include the strings \"Chicago\", \"Kentucky/Monticello\", and \"New_York\". In"
NSQ_SOURCE_LINE 00000811 "scalar context, it returns an array reference, while in list context it returns"
NSQ_SOURCE_LINE 00000812 "an array."
NSQ_SOURCE_LINE 00000813 ""
NSQ_SOURCE_LINE 00000814 "=head2 DateTime::TimeZone->countries()"
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 "Returns a sorted list of all the valid country codes (in lower-case) which can"
NSQ_SOURCE_LINE 00000817 "be passed to C<names_in_country()>. In scalar context, it returns an array"
NSQ_SOURCE_LINE 00000818 "reference, while in list context it returns an array."
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "If you need to convert country codes to names or vice versa you can use"
NSQ_SOURCE_LINE 00000821 "C<Locale::Country> to do so. Note that one of the codes returned is \"uk\", which"
NSQ_SOURCE_LINE 00000822 "is an alias for the country code \"gb\", and is not a valid ISO country code."
NSQ_SOURCE_LINE 00000823 ""
NSQ_SOURCE_LINE 00000824 "=head2 DateTime::TimeZone->names_in_country( $country_code )"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "Given a two-letter ISO3166 country code, this method returns a list of time"
NSQ_SOURCE_LINE 00000827 "zones used in that country. The country code may be of any case. In scalar"
NSQ_SOURCE_LINE 00000828 "context, it returns an array reference, while in list context it returns an"
NSQ_SOURCE_LINE 00000829 "array."
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "This list is returned in an order vaguely based on geography and population. In"
NSQ_SOURCE_LINE 00000832 "general, the least used zones come last, but there are not guarantees of a"
NSQ_SOURCE_LINE 00000833 "specific order from one release to the next. This order is probably the best"
NSQ_SOURCE_LINE 00000834 "option for presenting zones names to end users."
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "=head2 DateTime::TimeZone->offset_as_seconds( $offset )"
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "Given an offset as a string, this returns the number of seconds represented by"
NSQ_SOURCE_LINE 00000839 "the offset as a positive or negative number.  Returns C<undef> if $offset is"
NSQ_SOURCE_LINE 00000840 "not in the range C<-99:59:59> to C<+99:59:59>."
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "The offset is expected to match either"
NSQ_SOURCE_LINE 00000843 "C</^([\\+\\-])?(\\d\\d?):(\\d\\d)(?::(\\d\\d))?$/> or"
NSQ_SOURCE_LINE 00000844 "C</^([\\+\\-])?(\\d\\d)(\\d\\d)(\\d\\d)?$/>.  If it doesn't match either of these,"
NSQ_SOURCE_LINE 00000845 "C<undef> will be returned."
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "This means that if you want to specify hours as a single digit, then each"
NSQ_SOURCE_LINE 00000848 "element of the offset must be separated by a colon (:)."
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "=head2 DateTime::TimeZone->offset_as_string( $offset, $sep )"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "Given an offset as a number, this returns the offset as a string. Returns"
NSQ_SOURCE_LINE 00000853 "C<undef> if $offset is not in the range C<-359999> to C<359999>."
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "You can also provide an optional separator which will go between the hours,"
NSQ_SOURCE_LINE 00000856 "minutes, and seconds (if applicable) portions of the offset."
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "=head2 Storable Hooks"
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 "This module provides freeze and thaw hooks for C<Storable> so that the huge"
NSQ_SOURCE_LINE 00000861 "data structures for Olson time zones are not actually stored in the serialized"
NSQ_SOURCE_LINE 00000862 "structure."
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "If you subclass C<DateTime::TimeZone>, you will inherit its hooks, which may"
NSQ_SOURCE_LINE 00000865 "not work for your module, so please test the interaction of your module with"
NSQ_SOURCE_LINE 00000866 "Storable."
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "=head1 LOADING TIME ZONES IN A PRE-FORKING SYSTEM"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "If you are running an application that does pre-forking (for example with"
NSQ_SOURCE_LINE 00000871 "Starman), then you should try to load all the time zones that you'll need in"
NSQ_SOURCE_LINE 00000872 "the parent process. Time zones are loaded on-demand, so loading them once in"
NSQ_SOURCE_LINE 00000873 "each child will waste memory that could otherwise be shared."
NSQ_SOURCE_LINE 00000874 ""
NSQ_SOURCE_LINE 00000875 "=head1 CREDITS"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "This module was inspired by Jesse Vincent's work on Date::ICal::Timezone, and"
NSQ_SOURCE_LINE 00000878 "written with much help from the datetime@perl.org list."
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "datetime@perl.org mailing list"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "The tools directory of the DateTime::TimeZone distribution includes two scripts"
NSQ_SOURCE_LINE 00000885 "that may be of interest to some people.  They are parse_olson and"
NSQ_SOURCE_LINE 00000886 "tests_from_zdump.  Please run them with the --help flag to see what they can be"
NSQ_SOURCE_LINE 00000887 "used for."
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "Support for this module is provided via the datetime@perl.org email list."
NSQ_SOURCE_LINE 00000892 ""
NSQ_SOURCE_LINE 00000893 "Bugs may be submitted at L<https://github.com/houseabsolute/DateTime-TimeZone/issues>."
NSQ_SOURCE_LINE 00000894 ""
NSQ_SOURCE_LINE 00000895 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000896 ""
NSQ_SOURCE_LINE 00000897 "The source code repository for DateTime-TimeZone can be found at L<https://github.com/houseabsolute/DateTime-TimeZone>."
NSQ_SOURCE_LINE 00000898 ""
NSQ_SOURCE_LINE 00000899 "=head1 DONATIONS"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "If you'd like to thank me for the work I've done on this module, please"
NSQ_SOURCE_LINE 00000902 "consider making a \"donation\" to me via PayPal. I spend a lot of free time"
NSQ_SOURCE_LINE 00000903 "creating free software, and would appreciate any support you'd care to offer."
NSQ_SOURCE_LINE 00000904 ""
NSQ_SOURCE_LINE 00000905 "Please note that B<I am not suggesting that you must do this> in order for me"
NSQ_SOURCE_LINE 00000906 "to continue working on this particular software. I will continue to do so,"
NSQ_SOURCE_LINE 00000907 "inasmuch as I have in the past, for as long as it interests me."
NSQ_SOURCE_LINE 00000908 ""
NSQ_SOURCE_LINE 00000909 "Similarly, a donation made in this way will probably not make me work on this"
NSQ_SOURCE_LINE 00000910 "software much more, unless I get so many donations that I can consider working"
NSQ_SOURCE_LINE 00000911 "on free software full time (let's all have a chuckle at that together)."
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "To donate, log into PayPal and send money to autarch@urth.org, or use the"
NSQ_SOURCE_LINE 00000914 "button at L<https://houseabsolute.com/foss-donations/>."
NSQ_SOURCE_LINE 00000915 ""
