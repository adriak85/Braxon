NSQ_SOURCE_LINE 00000001 "package File::Copy::Recursive::Reduced;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use parent qw( Exporter );"
NSQ_SOURCE_LINE 00000006 "our @EXPORT_OK = qw( dircopy fcopy rcopy );"
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.008';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use File::Copy;"
NSQ_SOURCE_LINE 00000010 "use File::Find;"
NSQ_SOURCE_LINE 00000011 "use File::Path qw( mkpath );"
NSQ_SOURCE_LINE 00000012 "use File::Spec;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our $Link       = eval { local $SIG{'__DIE__'}; link    '', ''; 1 } || 0;"
NSQ_SOURCE_LINE 00000015 "our $CopyLink   = eval { local $SIG{'__DIE__'}; symlink '', ''; 1 } || 0;"
NSQ_SOURCE_LINE 00000016 "our $DirPerms   = 0777;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "=head1 NAME"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "File::Copy::Recursive::Reduced - Recursive copying of files and directories within Perl 5 toolchain"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000025 ""
NSQ_SOURCE_LINE 00000026 "    use File::Copy::Recursive::Reduced qw(fcopy dircopy);"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    fcopy($orig,$new) or die $!;"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    dircopy($orig,$new) or die $!;"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "This library is intended as a not-quite-drop-in replacement for certain"
NSQ_SOURCE_LINE 00000035 "functionality provided by L<CPAN distribution"
NSQ_SOURCE_LINE 00000036 "File-Copy-Recursive|http://search.cpan.org/dist/File-Copy-Recursive/>.  The"
NSQ_SOURCE_LINE 00000037 "library provides methods similar enough to that distribution's C<fcopy()>,"
NSQ_SOURCE_LINE 00000038 "C<dircopy()> and C<rcopy()> functions to be usable in those CPAN distributions"
NSQ_SOURCE_LINE 00000039 "often described as being part of the Perl toolchain."
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=head2 Rationale"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "F<File::Copy::Recursive> (hereinafter referred to as B<FCR>) is heavily used"
NSQ_SOURCE_LINE 00000044 "in other CPAN libraries.  Out of over 30,000 other CPAN distributions studied"
NSQ_SOURCE_LINE 00000045 "in early 2018, it ranks by one calculation as the 129th highest distribution"
NSQ_SOURCE_LINE 00000046 "in terms of its total direct and indirect reverse dependencies.  In current"
NSQ_SOURCE_LINE 00000047 "parlance, it sits C<high upstream on the CPAN river.>  Hence, it ought to work"
NSQ_SOURCE_LINE 00000048 "correctly and be installable on all operating systems where Perl is well"
NSQ_SOURCE_LINE 00000049 "supported."
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "However, as of early April 2018, FCR version 0.40 wass failing to pass its tests against either"
NSQ_SOURCE_LINE 00000052 "Perl 5.26 or Perl 5 blead on important operating systems including Windows,"
NSQ_SOURCE_LINE 00000053 "FreeBSD and NetBSD"
NSQ_SOURCE_LINE 00000054 "(L<http://fast-matrix.cpantesters.org/?dist=File-Copy-Recursive%200.40>).  As"
NSQ_SOURCE_LINE 00000055 "a consequence, CPAN installers such as F<cpan> and F<cpanm> were failing to"
NSQ_SOURCE_LINE 00000056 "install it (unless one resorted to the C<--force> option).  This prevented"
NSQ_SOURCE_LINE 00000057 "distributions dependent (directly or indirectly) on FCR from being installed"
NSQ_SOURCE_LINE 00000058 "as well."
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "Some patches had been provided to the L<FCR bug"
NSQ_SOURCE_LINE 00000061 "tracker|https://rt.cpan.org/Dist/Display.html?Name=File-Copy-Recursive> for"
NSQ_SOURCE_LINE 00000062 "this problem.  However, as late as April 18 2018 those patches had not yet"
NSQ_SOURCE_LINE 00000063 "been applied.  This posed a critical problem for the ability to assess the"
NSQ_SOURCE_LINE 00000064 "impact of the soon-to-be-released perl-5.28.0 on CPAN distributions (the"
NSQ_SOURCE_LINE 00000065 "so-called \"Blead Breaks CPAN\" (\"BBC\") problem) on platforms other than Linux."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "F<File::Copy::Recursive::Reduced> (hereinafter referred to as B<FCR2>) is"
NSQ_SOURCE_LINE 00000068 "intended to provide a minimal subset of FCR's functionality -- just enough to"
NSQ_SOURCE_LINE 00000069 "get the Perl toolchain working on the platforms where FCR is currently"
NSQ_SOURCE_LINE 00000070 "failing.  Functions will be added to FCR2 only insofar as investigation shows"
NSQ_SOURCE_LINE 00000071 "that they can replace usage of FCR functions in toolchain and other heavily"
NSQ_SOURCE_LINE 00000072 "used modules.  No attempt will be made to reproduce all the functionality"
NSQ_SOURCE_LINE 00000073 "currently provided or claimed to be provided by FCR."
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "On April 19 2018, FCR's author, Daniel Muey, released version 0.41 to CPAN."
NSQ_SOURCE_LINE 00000076 "This version included a patch submitted by Tom Hukins which corrected the"
NSQ_SOURCE_LINE 00000077 "problem addressed by FCR2.  FCR once again built and tested correctly on"
NSQ_SOURCE_LINE 00000078 "FreeBSD.  That meant that its 6000-plus reverse dependencies can once again be"
NSQ_SOURCE_LINE 00000079 "reached by F<cpan> and other installers.  That in turn means that we can"
NSQ_SOURCE_LINE 00000080 "conduct exhaustive BBC investigations on FreeBSD and other platforms."
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "With that correction in FCR, the original rationale for FCR2 has been"
NSQ_SOURCE_LINE 00000083 "superseded.  I will continue to maintain the code and respond to bug reports,"
NSQ_SOURCE_LINE 00000084 "but am suspending active development.  I now deem FCR2 feature-complete."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=head1 SUBROUTINES"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "The current version of FCR2 provides three exportable and publicly supported"
NSQ_SOURCE_LINE 00000089 "subroutines partially equivalent to the similarly named subroutines exported"
NSQ_SOURCE_LINE 00000090 "by FCR."
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "=head2 C<fcopy()>"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=over 4"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "=item * Purpose"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "A stripped-down replacement for C<File::Copy::Recursive::fcopy()>."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "Copies a file to a new location, recursively creating directories as needed."
NSQ_SOURCE_LINE 00000101 "Does not copy directories.  Unlike C<File::Copy::copy()>, C<fcopy()> attempts"
NSQ_SOURCE_LINE 00000102 "to preserve the mode of the original file."
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "=item * Arguments"
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "    fcopy($orig, $new) or die $!;"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "List of two required arguments:"
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=over 4"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "=item * Absolute path to the file being copied; and"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=item * Absolute path to the location to which the file is being copied."
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "=back"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "Four cases should be noted:"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "=over 4"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "=item 1 Create copy within same directory but new basename"
NSQ_SOURCE_LINE 00000123 ""
NSQ_SOURCE_LINE 00000124 "    fcopy('/path/to/filename', '/path/to/newfile');"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "The second argument must be the absolute path to the new file.  (Otherwise"
NSQ_SOURCE_LINE 00000127 "the file will be created in the current working directory, which is almost"
NSQ_SOURCE_LINE 00000128 "certainly what you do not want.)"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=item 2 Create copy within different, already B<existing> directory, same basename"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "    fcopy('/path/to/filename', '/path/to/existing/directory');"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "The second argument can be merely the path to the existing directory; will"
NSQ_SOURCE_LINE 00000135 "create F</path/to/existing/directory/filename>."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=item 3 Create copy within different, not yet existing directory, same basename"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    fcopy('/path/to/filename', '/path/not/yet/existing/directory/filename');"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "The second argument will be interpreted as the complete path to the newly"
NSQ_SOURCE_LINE 00000142 "created file.  The basename must be included even if it is the same as in the"
NSQ_SOURCE_LINE 00000143 "first argument.  Will create F</path/not/yet/existing/directory/filename>."
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "=item 4 Create copy within different, not yet existing directory, different basename"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    fcopy('/path/to/filename', '/path/not/yet/existing/directory/newfile');"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "The second argument will be interpreted as the complete path to the newly"
NSQ_SOURCE_LINE 00000150 "created file.  Will create F</path/not/yet/existing/directory/newfile>."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=back"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "=item * Return Value"
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "Returns C<1> upon success; C<0> upon failure.  Returns an undefined value if,"
NSQ_SOURCE_LINE 00000157 "for example, function cannot validate arguments."
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "=item * Comment"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "Since C<fcopy()> internally uses C<File::Copy::copy()> to perform the copying,"
NSQ_SOURCE_LINE 00000162 "the arguments are subject to the same qualifications as that function's"
NSQ_SOURCE_LINE 00000163 "arguments.  Call F<perldoc File::Copy> for discussion of those arguments."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "=back"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "=cut"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "sub fcopy {"
NSQ_SOURCE_LINE 00000170 "    return unless @_ == 2;"
NSQ_SOURCE_LINE 00000171 "    my ($from, $to) = @_;"
NSQ_SOURCE_LINE 00000172 "    #return unless _samecheck($from, $to);"
NSQ_SOURCE_LINE 00000173 "    return unless _basic_samecheck($from, $to);"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "    # TODO:  Explore whether we should check (-e $from) here."
NSQ_SOURCE_LINE 00000176 "    # If we don't have a starting point, it shouldn't make any sense to go"
NSQ_SOURCE_LINE 00000177 "    # farther."
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    return unless _dev_ino_check($from, $to);"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "    return _fcopy($from, $to);"
NSQ_SOURCE_LINE 00000182 "}"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "sub _fcopy {"
NSQ_SOURCE_LINE 00000185 "    my ($from, $to) = @_;"
NSQ_SOURCE_LINE 00000186 "    my ( $volm, $path ) = File::Spec->splitpath($to);"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "    # TODO: Explore whether it's possible for $path to be Perl-false in"
NSQ_SOURCE_LINE 00000189 "    # following line.  If not, remove."
NSQ_SOURCE_LINE 00000190 "    if ( $path && !-d $path ) {"
NSQ_SOURCE_LINE 00000191 "        pathmk(File::Spec->catpath($volm, $path, ''));"
NSQ_SOURCE_LINE 00000192 "    }"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    if ( -l $from && $CopyLink ) {"
NSQ_SOURCE_LINE 00000195 "        my $target = readlink( $from );"
NSQ_SOURCE_LINE 00000196 "        # FCR: mass-untaint is OK since we have to allow what the file system does"
NSQ_SOURCE_LINE 00000197 "        ($target) = $target =~ m/(.*)/;"
NSQ_SOURCE_LINE 00000198 "        warn \"Copying a symlink ($from) whose target does not exist\""
NSQ_SOURCE_LINE 00000199 "          if !-e $target;"
NSQ_SOURCE_LINE 00000200 "        my $new = $to;"
NSQ_SOURCE_LINE 00000201 "        unlink $new if -l $new;"
NSQ_SOURCE_LINE 00000202 "        symlink( $target, $new ) or return;"
NSQ_SOURCE_LINE 00000203 "    }"
NSQ_SOURCE_LINE 00000204 "    elsif (-d $from && -f $to) { return; }"
NSQ_SOURCE_LINE 00000205 "    else {"
NSQ_SOURCE_LINE 00000206 "        copy($from, $to) or return;"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "        my @base_file = File::Spec->splitpath( $from );"
NSQ_SOURCE_LINE 00000209 "        my $mode_trg = -d $to ? File::Spec->catfile( $to, $base_file[$#base_file] ) : $to;"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "        chmod scalar((stat($from))[2]), $mode_trg;"
NSQ_SOURCE_LINE 00000212 "    }"
NSQ_SOURCE_LINE 00000213 "    return 1;"
NSQ_SOURCE_LINE 00000214 "}"
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "sub pathmk {"
NSQ_SOURCE_LINE 00000217 "    my ( $vol, $dir, $file ) = File::Spec->splitpath( shift() );"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "    # TODO: Exploration whether $dir can be undef at this point."
NSQ_SOURCE_LINE 00000220 "    # If possible, then we should probably return immediately."
NSQ_SOURCE_LINE 00000221 "    if ( defined($dir) ) {"
NSQ_SOURCE_LINE 00000222 "        my (@dirs) = File::Spec->splitdir($dir);"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "        for ( my $i = 0; $i < scalar(@dirs); $i++ ) {"
NSQ_SOURCE_LINE 00000225 "            my $newdir = File::Spec->catdir( @dirs[ 0 .. $i ] );"
NSQ_SOURCE_LINE 00000226 "            my $newpth = File::Spec->catpath( $vol, $newdir, \"\" );"
NSQ_SOURCE_LINE 00000227 "            mkdir( $newpth );"
NSQ_SOURCE_LINE 00000228 "            return unless -d $newpth;"
NSQ_SOURCE_LINE 00000229 "        }"
NSQ_SOURCE_LINE 00000230 "    }"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "    # TODO: Exploration whether $file can be undef at this point."
NSQ_SOURCE_LINE 00000233 "    # If possible, then we should probably return immediately."
NSQ_SOURCE_LINE 00000234 "    if ( defined($file) ) {"
NSQ_SOURCE_LINE 00000235 "        my $newpth = File::Spec->catpath( $vol, $dir, $file );"
NSQ_SOURCE_LINE 00000236 "        mkdir( $newpth );"
NSQ_SOURCE_LINE 00000237 "        return unless -d $newpth;"
NSQ_SOURCE_LINE 00000238 "    }"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "    return 1;"
NSQ_SOURCE_LINE 00000241 "}"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "=head2 C<dircopy()>"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "=over 4"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "=item * Purpose"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "A stripped-down replacement for C<File::Copy::Recursive::dircopy()>."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "Given the path to the directory specified by the first argument, the function"
NSQ_SOURCE_LINE 00000253 "copies all of the files and directories beneath it to the directory specified"
NSQ_SOURCE_LINE 00000254 "by the second argument."
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "=item * Arguments"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "    my $count = dircopy($orig, $new);"
NSQ_SOURCE_LINE 00000259 "    warn \"dircopy() returned undefined value\" unless defined $count;"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=item * Return Value"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "Upon completion, returns the count of directories and files created -- which"
NSQ_SOURCE_LINE 00000264 "might be C<0>."
NSQ_SOURCE_LINE 00000265 ""
NSQ_SOURCE_LINE 00000266 "Should the function not complete (but not C<die>), an undefined value will be"
NSQ_SOURCE_LINE 00000267 "returned.  That generally indicates problems with argument validation.  This"
NSQ_SOURCE_LINE 00000268 "approach is taken for consistency with C<File::Copy::Recursive::dircopy()>."
NSQ_SOURCE_LINE 00000269 ""
NSQ_SOURCE_LINE 00000270 "In list context the return value is a one-item list holding the same value as"
NSQ_SOURCE_LINE 00000271 "returned in scalar context.  The three-item list return value of"
NSQ_SOURCE_LINE 00000272 "C<File::Copy::Recursive::dircopy()> is not supported."
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "=item * Restrictions"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "None of C<File::Copy::Recursive::dircopy>'s bells and whistles.  No guaranteed"
NSQ_SOURCE_LINE 00000277 "preservation of file or directory modes.  No restriction on maximum depth.  No"
NSQ_SOURCE_LINE 00000278 "nothing; this is fine-tuned to the needs of Perl toolchain modules and their"
NSQ_SOURCE_LINE 00000279 "test suites."
NSQ_SOURCE_LINE 00000280 ""
NSQ_SOURCE_LINE 00000281 "=back"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "=cut"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 "sub dircopy {"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    # I'm not supporting the buffer limitation, at this point I can insert a"
NSQ_SOURCE_LINE 00000288 "    # check for the correct number of arguments:  2"
NSQ_SOURCE_LINE 00000289 "    # FCR2 dircopy does not support buffer limit as third argument"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "    return unless @_ == 2;"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "    # Check the definedness and string inequality of the arguments now;"
NSQ_SOURCE_LINE 00000294 "    # Failure to do it now means that if $_[0] is not defined, you'll get an"
NSQ_SOURCE_LINE 00000295 "    # uninitalized value warning in the first line that calls 'substr' below."
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "    return unless _basic_samecheck(@_);"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "    # See local file globstar-investigation.pl"
NSQ_SOURCE_LINE 00000300 "    # What the block above does is to trim the 'from' argument so that, if user"
NSQ_SOURCE_LINE 00000301 "    # said 'dircopy(/path/to/directory/*, /path/to/copy)', the first argument"
NSQ_SOURCE_LINE 00000302 "    # is effectively reduced to '/path/to/directory/' but inside $globstar is"
NSQ_SOURCE_LINE 00000303 "    # set to true.  Have to see what impact of $globstar true is."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "    return _dircopy(@_);"
NSQ_SOURCE_LINE 00000306 "}"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "sub _dircopy {"
NSQ_SOURCE_LINE 00000309 "    my $globstar = 0;"
NSQ_SOURCE_LINE 00000310 "    my $_zero    = $_[0];"
NSQ_SOURCE_LINE 00000311 "    my $_one     = $_[1];"
NSQ_SOURCE_LINE 00000312 "    if ( substr( $_zero, ( 1 * -1 ), 1 ) eq '*' ) {"
NSQ_SOURCE_LINE 00000313 "        $globstar = 1;"
NSQ_SOURCE_LINE 00000314 "        $_zero = substr( $_zero, 0, ( length($_zero) - 1 ) );"
NSQ_SOURCE_LINE 00000315 "    }"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "    # Note also that, in the above, $_[0] and $_[1], while assigned to"
NSQ_SOURCE_LINE 00000318 "    # variables, are not shifted-in.  Hence they retain their original values."
NSQ_SOURCE_LINE 00000319 "    # TODO: Investigate whether replacing $_[1] from this point forward with a"
NSQ_SOURCE_LINE 00000320 "    # 'my' variable would be harmful."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "    # Both arguments must now be defined (though not necessarily true -- yet);"
NSQ_SOURCE_LINE 00000323 "    # they can't be equal; they can't be \"dev-ino\" equal on non-Win32 systems."
NSQ_SOURCE_LINE 00000324 "    # Verify that."
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "    return unless _dev_ino_check( $_zero, $_[1] );"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "    if ( !-d $_zero || ( -e $_[1] && !-d $_[1] ) ) {"
NSQ_SOURCE_LINE 00000329 "        $! = 20;"
NSQ_SOURCE_LINE 00000330 "        return;"
NSQ_SOURCE_LINE 00000331 "    }"
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "    # If the second argument is not an already existing directory,"
NSQ_SOURCE_LINE 00000334 "    # then, create that directory now (the top-level 'to')."
NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "    if ( !-d $_[1] ) {"
NSQ_SOURCE_LINE 00000337 "        pathmk( $_[1] ) or return;"
NSQ_SOURCE_LINE 00000338 "    }"
NSQ_SOURCE_LINE 00000339 "    # If the second argument is an existing directory ..."
NSQ_SOURCE_LINE 00000340 "    # ... $globstar false is the typical case, i.e., no '/*' at end of 2nd argument"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "    my $baseend = $_one;"
NSQ_SOURCE_LINE 00000343 "    my $level   = 0;"
NSQ_SOURCE_LINE 00000344 "    my $filen   = 0;"
NSQ_SOURCE_LINE 00000345 "    my $dirn    = 0;"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "    my $recurs;    #must be my()ed before sub {} since it calls itself"
NSQ_SOURCE_LINE 00000348 "    $recurs = sub {"
NSQ_SOURCE_LINE 00000349 "        my ( $str, $end ) = @_;"
NSQ_SOURCE_LINE 00000350 "        $filen++ if $end eq $baseend;"
NSQ_SOURCE_LINE 00000351 "        $dirn++  if $end eq $baseend;"
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "        # On each pass of the recursive coderef, create the directory in the"
NSQ_SOURCE_LINE 00000354 "        # 2nd argument or return (undef) if that does not succeed"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "        mkdir( $end ) or return if !-d $end;"
NSQ_SOURCE_LINE 00000357 "        $level++;"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "        opendir( my $str_dh, $str ) or return;"
NSQ_SOURCE_LINE 00000360 "        my @entities = grep( $_ ne '.' && $_ ne '..', readdir($str_dh) );"
NSQ_SOURCE_LINE 00000361 "        closedir $str_dh;"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "        for my $entity (@entities) {"
NSQ_SOURCE_LINE 00000364 "            my ($entity_ut) = $entity =~ m{ (.*) }xms;"
NSQ_SOURCE_LINE 00000365 "            my $from = File::Spec->catfile( $str, $entity_ut );"
NSQ_SOURCE_LINE 00000366 "            my $to = File::Spec->catfile( $end, $entity_ut );"
NSQ_SOURCE_LINE 00000367 "            if ( -l $from && $CopyLink ) {"
NSQ_SOURCE_LINE 00000368 "                my $target = readlink($from);"
NSQ_SOURCE_LINE 00000369 "                # mass-untaint is OK since we have to allow what the file system does"
NSQ_SOURCE_LINE 00000370 "                ($target) = $target =~ m/(.*)/;"
NSQ_SOURCE_LINE 00000371 "                warn \"Copying a symlink ($from) whose target does not exist\""
NSQ_SOURCE_LINE 00000372 "                  if !-e $target;"
NSQ_SOURCE_LINE 00000373 "                unlink $to if -l $to;"
NSQ_SOURCE_LINE 00000374 "                symlink( $target, $to ) or return;"
NSQ_SOURCE_LINE 00000375 "            }"
NSQ_SOURCE_LINE 00000376 "            elsif ( -d $from ) {"
NSQ_SOURCE_LINE 00000377 "                my $rc;"
NSQ_SOURCE_LINE 00000378 "                $rc = $recurs->( $from, $to );"
NSQ_SOURCE_LINE 00000379 "                return unless $rc;"
NSQ_SOURCE_LINE 00000380 "                $filen++;"
NSQ_SOURCE_LINE 00000381 "                $dirn++;"
NSQ_SOURCE_LINE 00000382 "            }"
NSQ_SOURCE_LINE 00000383 "            else {"
NSQ_SOURCE_LINE 00000384 "                fcopy( $from, $to ) or return;"
NSQ_SOURCE_LINE 00000385 "                $filen++;"
NSQ_SOURCE_LINE 00000386 "            }"
NSQ_SOURCE_LINE 00000387 "        } # End 'for' loop around @entities"
NSQ_SOURCE_LINE 00000388 "        $level--;"
NSQ_SOURCE_LINE 00000389 "        1;"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "    }; # END definition of $recurs"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "    $recurs->( $_zero, $_one ) or return;"
NSQ_SOURCE_LINE 00000394 "    return $filen;"
NSQ_SOURCE_LINE 00000395 "}"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "sub _basic_samecheck {"
NSQ_SOURCE_LINE 00000398 "    my ($from, $to) = @_;"
NSQ_SOURCE_LINE 00000399 "    return if !defined $from || !defined $to;"
NSQ_SOURCE_LINE 00000400 "    return if $from eq $to;"
NSQ_SOURCE_LINE 00000401 "    return 1;"
NSQ_SOURCE_LINE 00000402 "}"
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "sub _dev_ino_check {"
NSQ_SOURCE_LINE 00000405 "    my ($from, $to) = @_;"
NSQ_SOURCE_LINE 00000406 "    return 1 if $^O eq 'MSWin32';"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "    # perldoc perlport: \"(Win32) \"dev\" and \"ino\" are not meaningful.\""
NSQ_SOURCE_LINE 00000409 "    # Will probably have to add restrictions for VMS and other OSes."
NSQ_SOURCE_LINE 00000410 "    my $one = join( '-', ( stat $from )[ 0, 1 ] ) || '';"
NSQ_SOURCE_LINE 00000411 "    my $two = join( '-', ( stat $to   )[ 0, 1 ] ) || '';"
NSQ_SOURCE_LINE 00000412 "    if ( $one and $one eq $two ) {"
NSQ_SOURCE_LINE 00000413 "        warn \"$from and $to are identical\";"
NSQ_SOURCE_LINE 00000414 "        return;"
NSQ_SOURCE_LINE 00000415 "    }"
NSQ_SOURCE_LINE 00000416 "    return 1;"
NSQ_SOURCE_LINE 00000417 "}"
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "=head2 C<rcopy()>"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "=over 4"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "=item * Purpose"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "A stripped-down replacement for C<File::Copy::Recursive::rcopy()>.  As is the"
NSQ_SOURCE_LINE 00000426 "case with that FCR function, C<rcopy()> is more or less a wrapper around"
NSQ_SOURCE_LINE 00000427 "C<fcopy()> or C<dircopy()>, depending on the nature of the first argument."
NSQ_SOURCE_LINE 00000428 ""
NSQ_SOURCE_LINE 00000429 "=item * Arguments"
NSQ_SOURCE_LINE 00000430 ""
NSQ_SOURCE_LINE 00000431 "    rcopy($orig, $new) or die $!;"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "List of two required arguments:"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "=over 4"
NSQ_SOURCE_LINE 00000436 ""
NSQ_SOURCE_LINE 00000437 "=item * Absolute path to the entity (file or directory) being copied; and"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "=item * Absolute path to the location to which the entity is being copied."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=back"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "=item * Return Value"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "Returns C<1> upon success; C<0> upon failure.  Returns an undefined value if,"
NSQ_SOURCE_LINE 00000446 "for example, function cannot validate arguments."
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "=item * Comment"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "Please read the documentation for C<fcopy()> or C<dircopy()>, depending on the"
NSQ_SOURCE_LINE 00000451 "nature of the first argument."
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "=back"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=cut"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "sub rcopy {"
NSQ_SOURCE_LINE 00000458 "    return unless @_ == 2;"
NSQ_SOURCE_LINE 00000459 "    my ($from, $to) = @_;"
NSQ_SOURCE_LINE 00000460 "    return unless _basic_samecheck($from, $to);"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "    # TODO:  Explore whether we should check (-e $from) here."
NSQ_SOURCE_LINE 00000463 "    # If we don't have a starting point, it shouldn't make any sense to go"
NSQ_SOURCE_LINE 00000464 "    # farther."
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "    return unless _dev_ino_check($from, $to);"
NSQ_SOURCE_LINE 00000467 ""
NSQ_SOURCE_LINE 00000468 "    # symlinks not yet supported"
NSQ_SOURCE_LINE 00000469 "    #return if -l $_[0];"
NSQ_SOURCE_LINE 00000470 "    goto &fcopy if -l $_[0] && $CopyLink;"
NSQ_SOURCE_LINE 00000471 ""
NSQ_SOURCE_LINE 00000472 "    goto &_dircopy if -d $_[0] || substr( $_[0], ( 1 * -1 ), 1 ) eq '*';"
NSQ_SOURCE_LINE 00000473 "    goto &_fcopy;"
NSQ_SOURCE_LINE 00000474 "}"
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "=head2 File::Copy::Recursive Subroutines Not Supported in File::Copy::Recursive::Reduced"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "As of the current version, FCR2 has no publicly documented, exportable subroutines equivalent"
NSQ_SOURCE_LINE 00000480 "to the following FCR exportable subroutines:"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "    rcopy_glob"
NSQ_SOURCE_LINE 00000483 "    fmove"
NSQ_SOURCE_LINE 00000484 "    rmove"
NSQ_SOURCE_LINE 00000485 "    rmove_glob"
NSQ_SOURCE_LINE 00000486 "    dirmove"
NSQ_SOURCE_LINE 00000487 "    pathempty"
NSQ_SOURCE_LINE 00000488 "    pathrm"
NSQ_SOURCE_LINE 00000489 "    pathrmdir"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "Consideration is being given to supporting C<rcopy()>."
NSQ_SOURCE_LINE 00000492 ""
