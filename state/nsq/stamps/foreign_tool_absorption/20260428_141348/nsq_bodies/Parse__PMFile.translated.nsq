NSQ_SOURCE_LINE 00000414 "                      ^[\\s\\{;]*"
NSQ_SOURCE_LINE 00000415 "                      \\b(?:$package_or_class)\\s+"
NSQ_SOURCE_LINE 00000416 "                      ([\\w\\:\\']+)"
NSQ_SOURCE_LINE 00000417 "                      \\s*"
NSQ_SOURCE_LINE 00000418 "                      (?: $ | [\\}\\;\\:] | \\{ | \\s+($version::STRICT) )"
NSQ_SOURCE_LINE 00000419 "                    }x) {"
NSQ_SOURCE_LINE 00000420 "            $pkg = $1;"
NSQ_SOURCE_LINE 00000421 "            $strict_version = $2;"
NSQ_SOURCE_LINE 00000422 "            if ($pkg eq \"DB\"){"
NSQ_SOURCE_LINE 00000423 "                # XXX if pumpkin and perl make him comaintainer! I"
NSQ_SOURCE_LINE 00000424 "                # think I always made the pumpkins comaint on DB"
NSQ_SOURCE_LINE 00000425 "                # without further ado (?)"
NSQ_SOURCE_LINE 00000426 "                next PLINE;"
NSQ_SOURCE_LINE 00000427 "            }"
NSQ_SOURCE_LINE 00000428 "        }"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "        if ($pkg) {"
NSQ_SOURCE_LINE 00000431 "            # Found something"
NSQ_SOURCE_LINE 00000432 ""
NSQ_SOURCE_LINE 00000433 "            # from package"
NSQ_SOURCE_LINE 00000434 "            $pkg =~ s/\\'/::/g;"
NSQ_SOURCE_LINE 00000435 "            next PLINE unless $pkg =~ /^[A-Za-z]/;"
NSQ_SOURCE_LINE 00000436 "            next PLINE unless $pkg =~ /\\w$/;"
NSQ_SOURCE_LINE 00000437 "            next PLINE if $pkg eq \"main\";"
NSQ_SOURCE_LINE 00000438 "            # Perl::Critic::Policy::TestingAndDebugging::ProhibitShebangWarningsArg"
NSQ_SOURCE_LINE 00000439 "            # database for modid in mods, package in packages, package in perms"
NSQ_SOURCE_LINE 00000440 "            # alter table mods modify modid varchar(128) binary NOT NULL default '';"
NSQ_SOURCE_LINE 00000441 "            # alter table packages modify package varchar(128) binary NOT NULL default '';"
NSQ_SOURCE_LINE 00000442 "            next PLINE if length($pkg) > 128;"
NSQ_SOURCE_LINE 00000443 "            #restriction"
NSQ_SOURCE_LINE 00000444 "            $ppp->{$pkg}{parsed}++;"
NSQ_SOURCE_LINE 00000445 "            $ppp->{$pkg}{infile} = $pmfile;"
NSQ_SOURCE_LINE 00000446 "            if ($self->_simile($pmfile,$pkg)) {"
NSQ_SOURCE_LINE 00000447 "                $ppp->{$pkg}{simile} = $pmfile;"
NSQ_SOURCE_LINE 00000448 "                if ($self->_version_from_meta_ok) {"
NSQ_SOURCE_LINE 00000449 "                    my $provides = $self->{META_CONTENT}{provides};"
NSQ_SOURCE_LINE 00000450 "                    if (exists $provides->{$pkg}) {"
NSQ_SOURCE_LINE 00000451 "                        if (defined $provides->{$pkg}{version}) {"
NSQ_SOURCE_LINE 00000452 "                            my $v = $provides->{$pkg}{version};"
NSQ_SOURCE_LINE 00000453 "                            if ($v =~ /[_\\s]/ && !$self->{ALLOW_DEV_VERSION} && !$ALLOW_DEV_VERSION){   # ignore developer releases and \"You suck!\""
NSQ_SOURCE_LINE 00000454 "                                next PLINE;"
NSQ_SOURCE_LINE 00000455 "                            }"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "                            unless (eval { $version = $self->_normalize_version($v); 1 }) {"
NSQ_SOURCE_LINE 00000458 "                              $self->_verbose(1, \"error with version in $pmfile: $@\");"
NSQ_SOURCE_LINE 00000459 "                              next;"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "                            }"
NSQ_SOURCE_LINE 00000462 "                            $ppp->{$pkg}{version} = $version;"
NSQ_SOURCE_LINE 00000463 "                        } else {"
NSQ_SOURCE_LINE 00000464 "                            $ppp->{$pkg}{version} = \"undef\";"
NSQ_SOURCE_LINE 00000465 "                        }"
NSQ_SOURCE_LINE 00000466 "                    }"
NSQ_SOURCE_LINE 00000467 "                } else {"
NSQ_SOURCE_LINE 00000468 "                    if (defined $strict_version){"
NSQ_SOURCE_LINE 00000469 "                        $ppp->{$pkg}{version} = $strict_version ;"
NSQ_SOURCE_LINE 00000470 "                    } else {"
NSQ_SOURCE_LINE 00000471 "                        $ppp->{$pkg}{version} = defined $version ? $version : \"\";"
NSQ_SOURCE_LINE 00000472 "                    }"
NSQ_SOURCE_LINE 00000473 "                    no warnings;"
NSQ_SOURCE_LINE 00000474 "                    if ($version eq 'undef') {"
NSQ_SOURCE_LINE 00000475 "                        $ppp->{$pkg}{version} = $version unless defined $ppp->{$pkg}{version};"
NSQ_SOURCE_LINE 00000476 "                    } else {"
NSQ_SOURCE_LINE 00000477 "                        $ppp->{$pkg}{version} ="
NSQ_SOURCE_LINE 00000478 "                            $version"
NSQ_SOURCE_LINE 00000479 "                                if $version"
NSQ_SOURCE_LINE 00000480 "                                    > $ppp->{$pkg}{version} ||"
NSQ_SOURCE_LINE 00000481 "                                        $version"
NSQ_SOURCE_LINE 00000482 "                                            gt $ppp->{$pkg}{version};"
NSQ_SOURCE_LINE 00000483 "                    }"
NSQ_SOURCE_LINE 00000484 "                }"
NSQ_SOURCE_LINE 00000485 "            } else {        # not simile"
NSQ_SOURCE_LINE 00000486 "                #### it comes later, it would be nonsense"
NSQ_SOURCE_LINE 00000487 "                #### to set to \"undef\". MM_Unix gives us"
NSQ_SOURCE_LINE 00000488 "                #### the best we can reasonably consider"
NSQ_SOURCE_LINE 00000489 "                $ppp->{$pkg}{version} ="
NSQ_SOURCE_LINE 00000490 "                    $version"
NSQ_SOURCE_LINE 00000491 "                        unless defined $ppp->{$pkg}{version} &&"
NSQ_SOURCE_LINE 00000492 "                            length($ppp->{$pkg}{version});"
NSQ_SOURCE_LINE 00000493 "            }"
NSQ_SOURCE_LINE 00000494 "            $ppp->{$pkg}{filemtime} = $filemtime;"
NSQ_SOURCE_LINE 00000495 "            $ppp->{$pkg}{version} .= \"\";    # make sure to stringify version"
NSQ_SOURCE_LINE 00000496 "        } else {"
NSQ_SOURCE_LINE 00000497 "            # $self->_verbose(2,\"no pkg found\");"
NSQ_SOURCE_LINE 00000498 "        }"
NSQ_SOURCE_LINE 00000499 "    }"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "    close $fh;"
NSQ_SOURCE_LINE 00000502 "    $ppp;"
NSQ_SOURCE_LINE 00000503 "}"
