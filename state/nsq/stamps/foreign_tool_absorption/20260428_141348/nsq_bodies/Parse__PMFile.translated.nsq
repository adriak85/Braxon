NSQ_SOURCE_LINE 00000001 "package Parse::PMFile;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "sub __clean_eval { eval $_[0] } # needs to be here (RT#101273)"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 "use warnings;"
NSQ_SOURCE_LINE 00000007 "use Safe;"
NSQ_SOURCE_LINE 00000008 "use JSON::PP ();"
NSQ_SOURCE_LINE 00000009 "use Dumpvalue;"
NSQ_SOURCE_LINE 00000010 "use version ();"
NSQ_SOURCE_LINE 00000011 "use File::Spec ();"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "our $VERSION = '0.48';"
NSQ_SOURCE_LINE 00000014 "our $VERBOSE = 0;"
NSQ_SOURCE_LINE 00000015 "our $ALLOW_DEV_VERSION = 0;"
NSQ_SOURCE_LINE 00000016 "our $FORK = 0;"
NSQ_SOURCE_LINE 00000017 "our $UNSAFE = $] < 5.010000 ? 1 : 0;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "sub new {"
NSQ_SOURCE_LINE 00000020 "    my ($class, $meta, $opts) = @_;"
NSQ_SOURCE_LINE 00000021 "    bless {%{ $opts || {} }, META_CONTENT => $meta}, $class;"
NSQ_SOURCE_LINE 00000022 "}"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "# from PAUSE::pmfile::examine_fio"
NSQ_SOURCE_LINE 00000025 "sub parse {"
NSQ_SOURCE_LINE 00000026 "    my ($self, $pmfile) = @_;"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "    $pmfile =~ s|\\\\|/|g;"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    my($filemtime) = (stat $pmfile)[9];"
NSQ_SOURCE_LINE 00000031 "    $self->{MTIME} = $filemtime;"
NSQ_SOURCE_LINE 00000032 "    $self->{PMFILE} = $pmfile;"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "    unless ($self->_version_from_meta_ok) {"
NSQ_SOURCE_LINE 00000035 "        my $version;"
NSQ_SOURCE_LINE 00000036 "        unless (eval { $version = $self->_parse_version; 1 }) {"
NSQ_SOURCE_LINE 00000037 "          $self->_verbose(1, \"error with version in $pmfile: $@\");"
NSQ_SOURCE_LINE 00000038 "          return;"
NSQ_SOURCE_LINE 00000039 "        }"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "        $self->{VERSION} = $version;"
NSQ_SOURCE_LINE 00000042 "        if ($self->{VERSION} =~ /^\\{.*\\}$/) {"
NSQ_SOURCE_LINE 00000043 "            # JSON error message"
NSQ_SOURCE_LINE 00000044 "        } elsif ($self->{VERSION} =~ /[_\\s]/ && !$self->{ALLOW_DEV_VERSION} && !$ALLOW_DEV_VERSION){   # ignore developer releases and \"You suck!\""
NSQ_SOURCE_LINE 00000045 "            return;"
NSQ_SOURCE_LINE 00000046 "        }"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    my($ppp) = $self->_packages_per_pmfile;"
NSQ_SOURCE_LINE 00000050 "    my @keys_ppp = $self->_filter_ppps(sort keys %$ppp);"
NSQ_SOURCE_LINE 00000051 "    $self->_verbose(1,\"Will check keys_ppp[@keys_ppp]\\n\");"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    #"
NSQ_SOURCE_LINE 00000054 "    # Immediately after each package (pmfile) examined contact"
NSQ_SOURCE_LINE 00000055 "    # the database"
NSQ_SOURCE_LINE 00000056 "    #"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "    my ($package, %errors);"
NSQ_SOURCE_LINE 00000059 "    my %checked_in;"
NSQ_SOURCE_LINE 00000060 "  DBPACK: foreach $package (@keys_ppp) {"
NSQ_SOURCE_LINE 00000061 "        # this part is taken from PAUSE::package::examine_pkg"
NSQ_SOURCE_LINE 00000062 "        # and PAUSE::package::_pkg_name_insane"
NSQ_SOURCE_LINE 00000063 "        if ($package !~ /^\\w[\\w\\:\\']*\\w?\\z/"
NSQ_SOURCE_LINE 00000064 "         || $package !~ /\\w\\z/"
NSQ_SOURCE_LINE 00000065 "         || $package =~ /:/ && $package !~ /::/"
NSQ_SOURCE_LINE 00000066 "         || $package =~ /\\w:\\w/"
NSQ_SOURCE_LINE 00000067 "         || $package =~ /:::/"
NSQ_SOURCE_LINE 00000068 "        ){"
NSQ_SOURCE_LINE 00000069 "            $self->_verbose(1,\"Package[$package] did not pass the ultimate sanity check\");"
NSQ_SOURCE_LINE 00000070 "            delete $ppp->{$package};"
NSQ_SOURCE_LINE 00000071 "            next;"
NSQ_SOURCE_LINE 00000072 "        }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "        if ($self->{USERID} && $self->{PERMISSIONS} && !$self->_perm_check($package)) {"
NSQ_SOURCE_LINE 00000075 "            delete $ppp->{$package};"
NSQ_SOURCE_LINE 00000076 "            next;"
NSQ_SOURCE_LINE 00000077 "        }"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "        # Check that package name matches case of file name"
NSQ_SOURCE_LINE 00000080 "        {"
NSQ_SOURCE_LINE 00000081 "          my (undef, $module) = split m{/lib/}, $self->{PMFILE}, 2;"
NSQ_SOURCE_LINE 00000082 "          if ($module) {"
NSQ_SOURCE_LINE 00000083 "            $module =~ s{\\.pm\\z}{};"
NSQ_SOURCE_LINE 00000084 "            $module =~ s{/}{::}g;"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "            if (lc $module eq lc $package && $module ne $package) {"
NSQ_SOURCE_LINE 00000087 "              # warn \"/// $self->{PMFILE} vs. $module vs. $package\\n\";"
NSQ_SOURCE_LINE 00000088 "              $errors{$package} = {"
NSQ_SOURCE_LINE 00000089 "                indexing_warning => \"Capitalization of package ($package) does not match filename!\","
NSQ_SOURCE_LINE 00000090 "                infile => $self->{PMFILE},"
NSQ_SOURCE_LINE 00000091 "              };"
NSQ_SOURCE_LINE 00000092 "            }"
NSQ_SOURCE_LINE 00000093 "          }"
NSQ_SOURCE_LINE 00000094 "        }"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "        my $pp = $ppp->{$package};"
NSQ_SOURCE_LINE 00000097 "        if ($pp->{version} && $pp->{version} =~ /^\\{.*\\}$/) { # JSON parser error"
NSQ_SOURCE_LINE 00000098 "            my $err = JSON::PP::decode_json($pp->{version});"
NSQ_SOURCE_LINE 00000099 "            if ($err->{x_normalize}) {"
NSQ_SOURCE_LINE 00000100 "                $errors{$package} = {"
NSQ_SOURCE_LINE 00000101 "                    normalize => $err->{version},"
NSQ_SOURCE_LINE 00000102 "                    infile => $pp->{infile},"
NSQ_SOURCE_LINE 00000103 "                };"
NSQ_SOURCE_LINE 00000104 "                $pp->{version} = \"undef\";"
NSQ_SOURCE_LINE 00000105 "            } elsif ($err->{openerr}) {"
NSQ_SOURCE_LINE 00000106 "                $pp->{version} = \"undef\";"
NSQ_SOURCE_LINE 00000107 "                $self->_verbose(1,"
NSQ_SOURCE_LINE 00000108 "                              qq{Parse::PMFile was not able to"
NSQ_SOURCE_LINE 00000109 "        read the file. It issued the following error: C< $err->{r} >},"
NSQ_SOURCE_LINE 00000110 "                              );"
NSQ_SOURCE_LINE 00000111 "                $errors{$package} = {"
NSQ_SOURCE_LINE 00000112 "                    open => $err->{r},"
NSQ_SOURCE_LINE 00000113 "                    infile => $pp->{infile},"
NSQ_SOURCE_LINE 00000114 "                };"
NSQ_SOURCE_LINE 00000115 "            } else {"
NSQ_SOURCE_LINE 00000116 "                $pp->{version} = \"undef\";"
NSQ_SOURCE_LINE 00000117 "                $self->_verbose(1, "
NSQ_SOURCE_LINE 00000118 "                              qq{Parse::PMFile was not able to"
NSQ_SOURCE_LINE 00000119 "        parse the following line in that file: C< $err->{line} >"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "        Note: the indexer is running in a Safe compartement and cannot"
NSQ_SOURCE_LINE 00000122 "        provide the full functionality of perl in the VERSION line. It"
NSQ_SOURCE_LINE 00000123 "        is trying hard, but sometime it fails. As a workaround, please"
NSQ_SOURCE_LINE 00000124 "        consider writing a META.yml that contains a 'provides'"
NSQ_SOURCE_LINE 00000125 "        attribute or contact the CPAN admins to investigate (yet"
NSQ_SOURCE_LINE 00000126 "        another) workaround against \"Safe\" limitations.)},"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "                              );"
NSQ_SOURCE_LINE 00000129 "                $errors{$package} = {"
NSQ_SOURCE_LINE 00000130 "                    parse_version => $err->{line},"
NSQ_SOURCE_LINE 00000131 "                    infile => $err->{file},"
NSQ_SOURCE_LINE 00000132 "                };"
NSQ_SOURCE_LINE 00000133 "            }"
NSQ_SOURCE_LINE 00000134 "        }"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "        # Sanity checks"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "        for ("
NSQ_SOURCE_LINE 00000139 "            $package,"
NSQ_SOURCE_LINE 00000140 "            $pp->{version},"
NSQ_SOURCE_LINE 00000141 "        ) {"
NSQ_SOURCE_LINE 00000142 "            if (!defined || /^\\s*$/ || /\\s/){  # for whatever reason I come here"
NSQ_SOURCE_LINE 00000143 "                delete $ppp->{$package};"
NSQ_SOURCE_LINE 00000144 "                next;            # don't screw up 02packages"
NSQ_SOURCE_LINE 00000145 "            }"
NSQ_SOURCE_LINE 00000146 "        }"
NSQ_SOURCE_LINE 00000147 "        unless ($self->_version_ok($pp)) {"
NSQ_SOURCE_LINE 00000148 "            $errors{$package} = {"
NSQ_SOURCE_LINE 00000149 "                long_version => qq{Version string exceeds maximum allowed length of 16b: \"$pp->{version}\"},"
NSQ_SOURCE_LINE 00000150 "                infile => $pp->{infile},"
NSQ_SOURCE_LINE 00000151 "            };"
NSQ_SOURCE_LINE 00000152 "            next;"
NSQ_SOURCE_LINE 00000153 "        }"
NSQ_SOURCE_LINE 00000154 "        $checked_in{$package} = $ppp->{$package};"
NSQ_SOURCE_LINE 00000155 "    }                       # end foreach package"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    return (wantarray && %errors) ? (\\%checked_in, \\%errors) : \\%checked_in;"
NSQ_SOURCE_LINE 00000158 "}"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "sub _version_ok {"
NSQ_SOURCE_LINE 00000161 "    my ($self, $pp) = @_;"
NSQ_SOURCE_LINE 00000162 "    return if length($pp->{version} || 0) > 16;"
NSQ_SOURCE_LINE 00000163 "    return 1"
NSQ_SOURCE_LINE 00000164 "}"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "sub _perm_check {"
NSQ_SOURCE_LINE 00000167 "    my ($self, $package) = @_;"
NSQ_SOURCE_LINE 00000168 "    my $userid = $self->{USERID};"
NSQ_SOURCE_LINE 00000169 "    my $module = $self->{PERMISSIONS}->module_permissions($package);"
NSQ_SOURCE_LINE 00000170 "    return 1 if !$module; # not listed yet"
NSQ_SOURCE_LINE 00000171 "    return 1 if defined $module->m && $module->m eq $userid;"
NSQ_SOURCE_LINE 00000172 "    return 1 if defined $module->f && $module->f eq $userid;"
NSQ_SOURCE_LINE 00000173 "    return 1 if defined $module->c && grep {$_ eq $userid} @{$module->c};"
NSQ_SOURCE_LINE 00000174 "    return;"
NSQ_SOURCE_LINE 00000175 "}"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "# from PAUSE::pmfile;"
NSQ_SOURCE_LINE 00000178 "sub _parse_version {"
NSQ_SOURCE_LINE 00000179 "    my $self = shift;"
NSQ_SOURCE_LINE 00000180 ""
NSQ_SOURCE_LINE 00000181 "    use strict;"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    my $pmfile = $self->{PMFILE};"
NSQ_SOURCE_LINE 00000184 "    my $tmpfile = File::Spec->catfile(File::Spec->tmpdir, \"ParsePMFile$$\" . rand(1000));"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "    my $pmcp = $pmfile;"
NSQ_SOURCE_LINE 00000187 "    for ($pmcp) {"
NSQ_SOURCE_LINE 00000188 "        s/([^\\\\](\\\\\\\\)*)@/$1\\\\@/g; # thanks to Raphael Manfredi for the"
NSQ_SOURCE_LINE 00000189 "        # solution to escape @s and \\"
NSQ_SOURCE_LINE 00000190 "    }"
NSQ_SOURCE_LINE 00000191 "    my($v);"
NSQ_SOURCE_LINE 00000192 "    {"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "        package main; # seems necessary"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "        # XXX: do we need to fork as PAUSE does?"
NSQ_SOURCE_LINE 00000197 "        # or, is alarm() just fine?"
NSQ_SOURCE_LINE 00000198 "        my $pid;"
NSQ_SOURCE_LINE 00000199 "        if ($self->{FORK} || $FORK) {"
NSQ_SOURCE_LINE 00000200 "            $pid = fork();"
NSQ_SOURCE_LINE 00000201 "            die \"Can't fork: $!\" unless defined $pid;"
NSQ_SOURCE_LINE 00000202 "        }"
NSQ_SOURCE_LINE 00000203 "        if ($pid) {"
NSQ_SOURCE_LINE 00000204 "            waitpid($pid, 0);"
NSQ_SOURCE_LINE 00000205 "            if (open my $fh, '<', $tmpfile) {"
NSQ_SOURCE_LINE 00000206 "                $v = <$fh>;"
NSQ_SOURCE_LINE 00000207 "            }"
NSQ_SOURCE_LINE 00000208 "        } else {"
NSQ_SOURCE_LINE 00000209 "            # XXX Limit Resources too"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "            my $comp;"
NSQ_SOURCE_LINE 00000212 "            my $eval = qq{"
NSQ_SOURCE_LINE 00000213 "                local(\\$^W) = 0;"
NSQ_SOURCE_LINE 00000214 "                Parse::PMFile::_parse_version_safely(\"$pmcp\");"
NSQ_SOURCE_LINE 00000215 "            };"
NSQ_SOURCE_LINE 00000216 "            unless ($self->{UNSAFE} || $UNSAFE) {"
NSQ_SOURCE_LINE 00000217 "                $comp = Safe->new;"
NSQ_SOURCE_LINE 00000218 "                $comp->permit(\"entereval\"); # for MBARBON/Module-Info-0.30.tar.gz"
NSQ_SOURCE_LINE 00000219 "                $comp->share(\"*Parse::PMFile::_parse_version_safely\");"
NSQ_SOURCE_LINE 00000220 "                $comp->share(\"*version::new\");"
NSQ_SOURCE_LINE 00000221 "                $comp->share(\"*version::numify\");"
NSQ_SOURCE_LINE 00000222 "                $comp->share_from('main', ['*version::',"
NSQ_SOURCE_LINE 00000223 "                                            '*charstar::',"
NSQ_SOURCE_LINE 00000224 "                                            '*Exporter::',"
NSQ_SOURCE_LINE 00000225 "                                            '*DynaLoader::']);"
NSQ_SOURCE_LINE 00000226 "                $comp->share_from('version', ['&qv']);"
NSQ_SOURCE_LINE 00000227 "                $comp->permit(\":base_math\"); # atan2 (Acme-Pi)"
NSQ_SOURCE_LINE 00000228 "                # $comp->permit(\"require\"); # no strict!"
NSQ_SOURCE_LINE 00000229 "                $comp->deny(qw/enteriter iter unstack goto/); # minimum protection against Acme::BadExample"
NSQ_SOURCE_LINE 00000230 "            }"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "            version->import('qv') if $self->{UNSAFE} || $UNSAFE;"
NSQ_SOURCE_LINE 00000233 "            {"
NSQ_SOURCE_LINE 00000234 "                no strict;"
NSQ_SOURCE_LINE 00000235 "                $v = $comp ? $comp->reval($eval) : eval $eval;"
NSQ_SOURCE_LINE 00000236 "            }"
NSQ_SOURCE_LINE 00000237 "            if ($@){ # still in the child process, out of Safe::reval"
NSQ_SOURCE_LINE 00000238 "                my $err = $@;"
NSQ_SOURCE_LINE 00000239 "                # warn \">>>>>>>err[$err]<<<<<<<<\";"
NSQ_SOURCE_LINE 00000240 "                if (ref $err) {"
NSQ_SOURCE_LINE 00000241 "                    if ($err->{line} =~ /([\\$*])([\\w\\:\\']*)\\bVERSION\\b.*?\\=(.*)/) {"
NSQ_SOURCE_LINE 00000242 "                        local($^W) = 0;"
NSQ_SOURCE_LINE 00000243 "                        my ($sigil, $vstr) = ($1, $3);"
NSQ_SOURCE_LINE 00000244 "                        $self->_restore_overloaded_stuff(1) if $err->{line} =~ /use\\s+version\\b|version\\->|qv\\(/;"
NSQ_SOURCE_LINE 00000245 "                        $v = $comp ? $comp->reval($vstr) : eval $vstr;"
NSQ_SOURCE_LINE 00000246 "                        $v = $$v if $sigil eq '*' && ref $v;"
NSQ_SOURCE_LINE 00000247 "                    }"
NSQ_SOURCE_LINE 00000248 "                    if ($@ or !$v) {"
NSQ_SOURCE_LINE 00000249 "                        $self->_verbose(1, sprintf(\"reval failed: err[%s] for eval[%s]\","
NSQ_SOURCE_LINE 00000250 "                                      JSON::PP::encode_json($err),"
NSQ_SOURCE_LINE 00000251 "                                      $eval,"
NSQ_SOURCE_LINE 00000252 "                                    ));"
NSQ_SOURCE_LINE 00000253 "                        $v = JSON::PP::encode_json($err);"
NSQ_SOURCE_LINE 00000254 "                    }"
NSQ_SOURCE_LINE 00000255 "                } else {"
NSQ_SOURCE_LINE 00000256 "                    $v = JSON::PP::encode_json({ openerr => $err });"
NSQ_SOURCE_LINE 00000257 "                }"
NSQ_SOURCE_LINE 00000258 "            }"
NSQ_SOURCE_LINE 00000259 "            if (defined $v) {"
NSQ_SOURCE_LINE 00000260 "                no warnings;"
NSQ_SOURCE_LINE 00000261 "                $v = $v->numify if ref($v) =~ /^version(::vpp)?$/;"
NSQ_SOURCE_LINE 00000262 "            } else {"
NSQ_SOURCE_LINE 00000263 "                $v = \"\";"
NSQ_SOURCE_LINE 00000264 "            }"
NSQ_SOURCE_LINE 00000265 "            if ($self->{FORK} || $FORK) {"
NSQ_SOURCE_LINE 00000266 "                open my $fh, '>:utf8', $tmpfile;"
NSQ_SOURCE_LINE 00000267 "                print $fh $v;"
NSQ_SOURCE_LINE 00000268 "                exit 0;"
NSQ_SOURCE_LINE 00000269 "            } else {"
NSQ_SOURCE_LINE 00000270 "                utf8::encode($v);"
NSQ_SOURCE_LINE 00000271 "                # undefine empty $v as if read from the tmpfile"
NSQ_SOURCE_LINE 00000272 "                $v = undef if defined $v && !length $v;"
NSQ_SOURCE_LINE 00000273 "                $comp->erase if ($comp);"
NSQ_SOURCE_LINE 00000274 "                $self->_restore_overloaded_stuff;"
NSQ_SOURCE_LINE 00000275 "            }"
NSQ_SOURCE_LINE 00000276 "        }"
NSQ_SOURCE_LINE 00000277 "    }"
NSQ_SOURCE_LINE 00000278 "    unlink $tmpfile if ($self->{FORK} || $FORK) && -e $tmpfile;"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "    return $self->_normalize_version($v);"
NSQ_SOURCE_LINE 00000281 "}"
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "sub _restore_overloaded_stuff {"
NSQ_SOURCE_LINE 00000284 "    my ($self, $used_version_in_safe) = @_;"
NSQ_SOURCE_LINE 00000285 "    return if $self->{UNSAFE} || $UNSAFE;"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000288 "    no warnings 'redefine';"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "    # version XS in CPAN"
NSQ_SOURCE_LINE 00000291 "    my $restored;"
NSQ_SOURCE_LINE 00000292 "    if ($INC{'version/vxs.pm'}) {"
NSQ_SOURCE_LINE 00000293 "        *{'version::(\"\"'} = \\&version::vxs::stringify;"
NSQ_SOURCE_LINE 00000294 "        *{'version::(0+'} = \\&version::vxs::numify;"
NSQ_SOURCE_LINE 00000295 "        *{'version::(cmp'} = \\&version::vxs::VCMP;"
NSQ_SOURCE_LINE 00000296 "        *{'version::(<=>'} = \\&version::vxs::VCMP;"
NSQ_SOURCE_LINE 00000297 "        *{'version::(bool'} = \\&version::vxs::boolean;"
NSQ_SOURCE_LINE 00000298 "        $restored = 1;"
NSQ_SOURCE_LINE 00000299 "    }"
NSQ_SOURCE_LINE 00000300 "    # version PP in CPAN"
NSQ_SOURCE_LINE 00000301 "    if ($INC{'version/vpp.pm'}) {"
NSQ_SOURCE_LINE 00000302 "        {"
NSQ_SOURCE_LINE 00000303 "            package # hide from PAUSE"
NSQ_SOURCE_LINE 00000304 "                charstar;"
NSQ_SOURCE_LINE 00000305 "            overload->import;"
NSQ_SOURCE_LINE 00000306 "        }"
NSQ_SOURCE_LINE 00000307 "        if (!$used_version_in_safe) {"
NSQ_SOURCE_LINE 00000308 "            package # hide from PAUSE"
NSQ_SOURCE_LINE 00000309 "                version::vpp;"
NSQ_SOURCE_LINE 00000310 "            overload->import;"
NSQ_SOURCE_LINE 00000311 "        }"
NSQ_SOURCE_LINE 00000312 "        unless ($restored) {"
NSQ_SOURCE_LINE 00000313 "            *{'version::(\"\"'} = \\&version::vpp::stringify;"
NSQ_SOURCE_LINE 00000314 "            *{'version::(0+'} = \\&version::vpp::numify;"
NSQ_SOURCE_LINE 00000315 "            *{'version::(cmp'} = \\&version::vpp::vcmp;"
NSQ_SOURCE_LINE 00000316 "            *{'version::(<=>'} = \\&version::vpp::vcmp;"
NSQ_SOURCE_LINE 00000317 "            *{'version::(bool'} = \\&version::vpp::vbool;"
NSQ_SOURCE_LINE 00000318 "        }"
NSQ_SOURCE_LINE 00000319 "        *{'version::vpp::(\"\"'} = \\&version::vpp::stringify;"
NSQ_SOURCE_LINE 00000320 "        *{'version::vpp::(0+'} = \\&version::vpp::numify;"
NSQ_SOURCE_LINE 00000321 "        *{'version::vpp::(cmp'} = \\&version::vpp::vcmp;"
NSQ_SOURCE_LINE 00000322 "        *{'version::vpp::(<=>'} = \\&version::vpp::vcmp;"
NSQ_SOURCE_LINE 00000323 "        *{'version::vpp::(bool'} = \\&version::vpp::vbool;"
NSQ_SOURCE_LINE 00000324 "        *{'charstar::(\"\"'} = \\&charstar::thischar;"
NSQ_SOURCE_LINE 00000325 "        *{'charstar::(0+'} = \\&charstar::thischar;"
NSQ_SOURCE_LINE 00000326 "        *{'charstar::(++'} = \\&charstar::increment;"
NSQ_SOURCE_LINE 00000327 "        *{'charstar::(--'} = \\&charstar::decrement;"
NSQ_SOURCE_LINE 00000328 "        *{'charstar::(+'} = \\&charstar::plus;"
NSQ_SOURCE_LINE 00000329 "        *{'charstar::(-'} = \\&charstar::minus;"
NSQ_SOURCE_LINE 00000330 "        *{'charstar::(*'} = \\&charstar::multiply;"
NSQ_SOURCE_LINE 00000331 "        *{'charstar::(cmp'} = \\&charstar::cmp;"
NSQ_SOURCE_LINE 00000332 "        *{'charstar::(<=>'} = \\&charstar::spaceship;"
NSQ_SOURCE_LINE 00000333 "        *{'charstar::(bool'} = \\&charstar::thischar;"
NSQ_SOURCE_LINE 00000334 "        *{'charstar::(='} = \\&charstar::clone;"
NSQ_SOURCE_LINE 00000335 "        $restored = 1;"
NSQ_SOURCE_LINE 00000336 "    }"
NSQ_SOURCE_LINE 00000337 "    # version in core"
NSQ_SOURCE_LINE 00000338 "    if (!$restored) {"
NSQ_SOURCE_LINE 00000339 "        *{'version::(\"\"'} = \\&version::stringify;"
NSQ_SOURCE_LINE 00000340 "        *{'version::(0+'} = \\&version::numify;"
NSQ_SOURCE_LINE 00000341 "        *{'version::(cmp'} = \\&version::vcmp;"
NSQ_SOURCE_LINE 00000342 "        *{'version::(<=>'} = \\&version::vcmp;"
NSQ_SOURCE_LINE 00000343 "        *{'version::(bool'} = \\&version::boolean;"
NSQ_SOURCE_LINE 00000344 "    }"
NSQ_SOURCE_LINE 00000345 "}"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "# from PAUSE::pmfile;"
NSQ_SOURCE_LINE 00000348 "sub _packages_per_pmfile {"
NSQ_SOURCE_LINE 00000349 "    my $self = shift;"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 "    my $ppp = {};"
NSQ_SOURCE_LINE 00000352 "    my $pmfile = $self->{PMFILE};"
NSQ_SOURCE_LINE 00000353 "    my $filemtime = $self->{MTIME};"
NSQ_SOURCE_LINE 00000354 "    my $version = $self->{VERSION};"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "    open my $fh, \"<\", \"$pmfile\" or return $ppp;"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "    local $/ = \"\\n\";"
NSQ_SOURCE_LINE 00000359 "    my $inpod = 0;"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "    my $package_or_class = 'package';"
NSQ_SOURCE_LINE 00000362 "    my $checked_bom;"
NSQ_SOURCE_LINE 00000363 "  PLINE: while (<$fh>) {"
NSQ_SOURCE_LINE 00000364 "        chomp;"
NSQ_SOURCE_LINE 00000365 "        my($pline) = $_;"
NSQ_SOURCE_LINE 00000366 "        $pline =~ s/\\A(?:\\x00\\x00\\xfe\\xff|\\xff\\xfe\\x00\\x00|\\xfe\\xff|\\xff\\xfe|\\xef\\xbb\\xbf)// unless $checked_bom;"
NSQ_SOURCE_LINE 00000367 "        $checked_bom = 1;"
NSQ_SOURCE_LINE 00000368 "        $inpod = $pline =~ /^=(?!cut)/ ? 1 :"
NSQ_SOURCE_LINE 00000369 "            $pline =~ /^=cut/ ? 0 : $inpod;"
NSQ_SOURCE_LINE 00000370 "        next if $inpod;"
NSQ_SOURCE_LINE 00000371 "        next if substr($pline,0,4) eq \"=cut\";"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "        $pline =~ s/\\#.*//;"
NSQ_SOURCE_LINE 00000374 "        next if $pline =~ /^\\s*$/;"
NSQ_SOURCE_LINE 00000375 "        if ($pline =~ /^__(?:END|DATA)__\\b/"
NSQ_SOURCE_LINE 00000376 "            and $pmfile !~ /\\.PL$/   # PL files may well have code after __DATA__"
NSQ_SOURCE_LINE 00000377 "            ){"
NSQ_SOURCE_LINE 00000378 "            last PLINE;"
NSQ_SOURCE_LINE 00000379 "        }"
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "=pod"
NSQ_SOURCE_LINE 00000382 "        # hide in the pod block until 'class' is added to a version bundle"
NSQ_SOURCE_LINE 00000383 "        if ($pline =~ /^[\\s\\{;]*use\\s(+v?5\\.[0-9]+)/) {"
NSQ_SOURCE_LINE 00000384 "            my $version = $1;"
NSQ_SOURCE_LINE 00000385 "            my $version_bundle_for_class = version->parse(\"v5.xx.xx\");"
NSQ_SOURCE_LINE 00000386 "            if (eval { version->parse($version) >= $version_bundle_for_class) {"
NSQ_SOURCE_LINE 00000387 "                $package_or_class = 'package|class|role';"
NSQ_SOURCE_LINE 00000388 "            }"
NSQ_SOURCE_LINE 00000389 "            next PLINE;"
NSQ_SOURCE_LINE 00000390 "        }"
NSQ_SOURCE_LINE 00000391 "=cut"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "        # use feature 'class'; enabels class (and role, though not implemented yet)"
NSQ_SOURCE_LINE 00000394 "        if ($pline =~ /^[\\s\\{;]*use\\s+(?:feature|experimental)\\s+[^;]+\\b(?:class|all)[^;]*;/) {"
NSQ_SOURCE_LINE 00000395 "            $package_or_class = 'package|class';"
NSQ_SOURCE_LINE 00000396 "        }"
NSQ_SOURCE_LINE 00000397 ""
NSQ_SOURCE_LINE 00000398 "        # some modules also enables class and role"
NSQ_SOURCE_LINE 00000399 "        if ($pline =~ /^[\\s\\{;]*use\\s+(?:Feature::Compat::Class)[^;]*;/) {"
NSQ_SOURCE_LINE 00000400 "            $package_or_class = 'package|class';"
NSQ_SOURCE_LINE 00000401 "        }"
NSQ_SOURCE_LINE 00000402 "        if ($pline =~ /^[\\s\\{;]*use\\s+(?:Object::Pad)[^;]*;/) {"
NSQ_SOURCE_LINE 00000403 "            $package_or_class = 'package|class|role';"
NSQ_SOURCE_LINE 00000404 "        }"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "        my $pkg;"
NSQ_SOURCE_LINE 00000407 "        my $strict_version;"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "        if ("
NSQ_SOURCE_LINE 00000410 "            # If you change *anything* here, it needs changing in '_parse_version_safely' too"
NSQ_SOURCE_LINE 00000411 "            $pline =~ m{"
NSQ_SOURCE_LINE 00000412 "                      # (.*) # takes too much time if $pline is long"
