NSQ_SOURCE_LINE 00000505 "# from PAUSE::pmfile;"
NSQ_SOURCE_LINE 00000506 "{"
NSQ_SOURCE_LINE 00000507 "    no strict;"
NSQ_SOURCE_LINE 00000508 "    sub _parse_version_safely {"
NSQ_SOURCE_LINE 00000509 "        my($parsefile) = @_;"
NSQ_SOURCE_LINE 00000510 "        my $result;"
NSQ_SOURCE_LINE 00000511 "        local *FH;"
NSQ_SOURCE_LINE 00000512 "        local $/ = \"\\n\";"
NSQ_SOURCE_LINE 00000513 "        open(FH,$parsefile) or die \"Could not open '$parsefile': $!\";"
NSQ_SOURCE_LINE 00000514 "        my $inpod = 0;"
NSQ_SOURCE_LINE 00000515 "        my $package_or_class = 'package';"
NSQ_SOURCE_LINE 00000516 "        while (<FH>) {"
NSQ_SOURCE_LINE 00000517 "            $inpod = /^=(?!cut)/ ? 1 : /^=cut/ ? 0 : $inpod;"
NSQ_SOURCE_LINE 00000518 "            next if $inpod || /^\\s*#/;"
NSQ_SOURCE_LINE 00000519 "            last if /^__(?:END|DATA)__\\b/; # fails on quoted __END__ but this is rare -> __END__ in the middle of a line is rarer"
NSQ_SOURCE_LINE 00000520 "            chop;"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "            # use feature 'class'; enabels class (and role, though not implemented yet)"
NSQ_SOURCE_LINE 00000523 "            if (/^[\\s\\{;]*use\\s+(?:feature|experimental)\\s+[^;]+\\b(?:class|all)[^;]*;/) {"
NSQ_SOURCE_LINE 00000524 "                $package_or_class = 'package|class';"
NSQ_SOURCE_LINE 00000525 "            }"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "            # some modules also enables class and role"
NSQ_SOURCE_LINE 00000528 "            # XXX: what to do with MooseX::Declare and a few minor experiments)"
NSQ_SOURCE_LINE 00000529 "            if (/^[\\s\\{;]*use\\s+(?:Feature::Compat::Class)[^;]*;/) {"
NSQ_SOURCE_LINE 00000530 "                $package_or_class = 'package|class';"
NSQ_SOURCE_LINE 00000531 "            }"
NSQ_SOURCE_LINE 00000532 "            if (/^[\\s\\{;]*use\\s+(?:Object::Pad)[^;]*;/) {"
NSQ_SOURCE_LINE 00000533 "                $package_or_class = 'package|class|role';"
NSQ_SOURCE_LINE 00000534 "            }"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "            # If you change *anything* here, it needs changing in '_packages_per_pmfile' too"
NSQ_SOURCE_LINE 00000537 "            if (my ($ver) = /$package_or_class \\s+ \\S+ \\s+ (\\S+) \\s* [:;{]/x) {"
NSQ_SOURCE_LINE 00000538 "              # XXX: should handle this better if version is bogus -- rjbs,"
NSQ_SOURCE_LINE 00000539 "              # 2014-03-16"
NSQ_SOURCE_LINE 00000540 "              return $ver if version::is_lax($ver);"
NSQ_SOURCE_LINE 00000541 "            }"
NSQ_SOURCE_LINE 00000542 ""
NSQ_SOURCE_LINE 00000543 "            # next unless /\\$(([\\w\\:\\']*)\\bVERSION)\\b.*\\=/;"
NSQ_SOURCE_LINE 00000544 "            next unless /(?<!\\\\)([\\$*])(([\\w\\:\\']*)\\bVERSION)\\b.*(?<![!><=])\\=(?![=>])/;"
NSQ_SOURCE_LINE 00000545 "            my $current_parsed_line = $_;"
NSQ_SOURCE_LINE 00000546 "            my $eval = qq{"
NSQ_SOURCE_LINE 00000547 "                package #"
NSQ_SOURCE_LINE 00000548 "                    ExtUtils::MakeMaker::_version;"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "                local $1$2;"
NSQ_SOURCE_LINE 00000551 "                \\$$2=undef; do {"
NSQ_SOURCE_LINE 00000552 "                    $_"
NSQ_SOURCE_LINE 00000553 "                }; \\$$2"
NSQ_SOURCE_LINE 00000554 "            };"
NSQ_SOURCE_LINE 00000555 "            local $^W = 0;"
NSQ_SOURCE_LINE 00000556 "            local $SIG{__WARN__} = sub {};"
NSQ_SOURCE_LINE 00000557 "            $result = __clean_eval($eval);"
NSQ_SOURCE_LINE 00000558 "            # warn \"current_parsed_line[$current_parsed_line]\\$\\@[$@]\";"
NSQ_SOURCE_LINE 00000559 "            if ($@ or !defined $result){"
NSQ_SOURCE_LINE 00000560 "                die +{"
NSQ_SOURCE_LINE 00000561 "                      eval => $eval,"
NSQ_SOURCE_LINE 00000562 "                      line => $current_parsed_line,"
NSQ_SOURCE_LINE 00000563 "                      file => $parsefile,"
NSQ_SOURCE_LINE 00000564 "                      err => $@,"
NSQ_SOURCE_LINE 00000565 "                      };"
NSQ_SOURCE_LINE 00000566 "            }"
NSQ_SOURCE_LINE 00000567 "            last;"
NSQ_SOURCE_LINE 00000568 "        } #;"
NSQ_SOURCE_LINE 00000569 "        close FH;"
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "        $result = \"undef\" unless defined $result;"
NSQ_SOURCE_LINE 00000572 "        if ((ref $result) =~ /^version(?:::vpp)?\\b/) {"
NSQ_SOURCE_LINE 00000573 "            no warnings;"
NSQ_SOURCE_LINE 00000574 "            $result = $result->numify;"
NSQ_SOURCE_LINE 00000575 "        }"
NSQ_SOURCE_LINE 00000576 "        return $result;"
NSQ_SOURCE_LINE 00000577 "    }"
NSQ_SOURCE_LINE 00000578 "}"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "# from PAUSE::pmfile;"
NSQ_SOURCE_LINE 00000581 "sub _filter_ppps {"
NSQ_SOURCE_LINE 00000582 "    my($self,@ppps) = @_;"
NSQ_SOURCE_LINE 00000583 "    my @res;"
NSQ_SOURCE_LINE 00000584 ""
NSQ_SOURCE_LINE 00000585 "    # very similar code is in PAUSE::dist::filter_pms"
NSQ_SOURCE_LINE 00000586 "  MANI: for my $ppp ( @ppps ) {"
NSQ_SOURCE_LINE 00000587 "        if ($self->{META_CONTENT}){"
NSQ_SOURCE_LINE 00000588 "            my $no_index = $self->{META_CONTENT}{no_index}"
NSQ_SOURCE_LINE 00000589 "                            || $self->{META_CONTENT}{private}; # backward compat"
NSQ_SOURCE_LINE 00000590 "            if (ref($no_index) eq 'HASH') {"
NSQ_SOURCE_LINE 00000591 "                my %map = ("
NSQ_SOURCE_LINE 00000592 "                            package => qr{\\z},"
NSQ_SOURCE_LINE 00000593 "                            namespace => qr{::},"
NSQ_SOURCE_LINE 00000594 "                          );"
NSQ_SOURCE_LINE 00000595 "                for my $k (qw(package namespace)) {"
NSQ_SOURCE_LINE 00000596 "                    next unless my $v = $no_index->{$k};"
NSQ_SOURCE_LINE 00000597 "                    my $rest = $map{$k};"
NSQ_SOURCE_LINE 00000598 "                    if (ref $v eq \"ARRAY\") {"
NSQ_SOURCE_LINE 00000599 "                        for my $ve (@$v) {"
NSQ_SOURCE_LINE 00000600 "                            $ve =~ s|::$||;"
NSQ_SOURCE_LINE 00000601 "                            if ($ppp =~ /^$ve$rest/){"
NSQ_SOURCE_LINE 00000602 "                                $self->_verbose(1,\"Skipping ppp[$ppp] due to ve[$ve]\");"
NSQ_SOURCE_LINE 00000603 "                                next MANI;"
NSQ_SOURCE_LINE 00000604 "                            } else {"
NSQ_SOURCE_LINE 00000605 "                                $self->_verbose(1,\"NOT skipping ppp[$ppp] due to ve[$ve]\");"
NSQ_SOURCE_LINE 00000606 "                            }"
NSQ_SOURCE_LINE 00000607 "                        }"
NSQ_SOURCE_LINE 00000608 "                    } else {"
NSQ_SOURCE_LINE 00000609 "                        $v =~ s|::$||;"
NSQ_SOURCE_LINE 00000610 "                        if ($ppp =~ /^$v$rest/){"
NSQ_SOURCE_LINE 00000611 "                            $self->_verbose(1,\"Skipping ppp[$ppp] due to v[$v]\");"
NSQ_SOURCE_LINE 00000612 "                            next MANI;"
NSQ_SOURCE_LINE 00000613 "                        } else {"
NSQ_SOURCE_LINE 00000614 "                            $self->_verbose(1,\"NOT skipping ppp[$ppp] due to v[$v]\");"
NSQ_SOURCE_LINE 00000615 "                        }"
NSQ_SOURCE_LINE 00000616 "                    }"
NSQ_SOURCE_LINE 00000617 "                }"
NSQ_SOURCE_LINE 00000618 "            } else {"
NSQ_SOURCE_LINE 00000619 "                $self->_verbose(1,\"No keyword 'no_index' or 'private' in META_CONTENT\");"
NSQ_SOURCE_LINE 00000620 "            }"
NSQ_SOURCE_LINE 00000621 "        } else {"
NSQ_SOURCE_LINE 00000622 "            # $self->_verbose(1,\"no META_CONTENT\"); # too noisy"
NSQ_SOURCE_LINE 00000623 "        }"
NSQ_SOURCE_LINE 00000624 "        push @res, $ppp;"
NSQ_SOURCE_LINE 00000625 "    }"
NSQ_SOURCE_LINE 00000626 "    $self->_verbose(1,\"Result of filter_ppps: res[@res]\");"
NSQ_SOURCE_LINE 00000627 "    @res;"
NSQ_SOURCE_LINE 00000628 "}"
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "# from PAUSE::pmfile;"
NSQ_SOURCE_LINE 00000631 "sub _simile {"
NSQ_SOURCE_LINE 00000632 "    my($self,$file,$package) = @_;"
NSQ_SOURCE_LINE 00000633 "    # MakeMaker gives them the chance to have the file Simple.pm in"
NSQ_SOURCE_LINE 00000634 "    # this directory but have the package HTML::Simple in it."
NSQ_SOURCE_LINE 00000635 "    # Afaik, they wouldn't be able to do so with deeper nested packages"
NSQ_SOURCE_LINE 00000636 "    $file =~ s|.*/||;"
NSQ_SOURCE_LINE 00000637 "    $file =~ s|\\.pm(?:\\.PL)?||;"
NSQ_SOURCE_LINE 00000638 "    my $ret = $package =~ m/\\b\\Q$file\\E$/;"
NSQ_SOURCE_LINE 00000639 "    $ret ||= 0;"
NSQ_SOURCE_LINE 00000640 "    unless ($ret) {"
NSQ_SOURCE_LINE 00000641 "        # Apache::mod_perl_guide stuffs it into Version.pm"
NSQ_SOURCE_LINE 00000642 "        $ret = 1 if lc $file eq 'version';"
NSQ_SOURCE_LINE 00000643 "    }"
NSQ_SOURCE_LINE 00000644 "    $self->_verbose(1,\"Result of simile(): file[$file] package[$package] ret[$ret]\\n\");"
NSQ_SOURCE_LINE 00000645 "    $ret;"
NSQ_SOURCE_LINE 00000646 "}"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "# from PAUSE::pmfile"
NSQ_SOURCE_LINE 00000649 "sub _normalize_version {"
NSQ_SOURCE_LINE 00000650 "    my($self,$v) = @_;"
NSQ_SOURCE_LINE 00000651 "    $v = \"undef\" unless defined $v;"
NSQ_SOURCE_LINE 00000652 "    my $dv = Dumpvalue->new;"
NSQ_SOURCE_LINE 00000653 "    my $sdv = $dv->stringify($v,1); # second argument prevents ticks"
NSQ_SOURCE_LINE 00000654 "    $self->_verbose(1,\"Result of normalize_version: sdv[$sdv]\\n\");"
NSQ_SOURCE_LINE 00000655 ""
NSQ_SOURCE_LINE 00000656 "    return $v if $v eq \"undef\";"
NSQ_SOURCE_LINE 00000657 "    return $v if $v =~ /^\\{.*\\}$/; # JSON object"
NSQ_SOURCE_LINE 00000658 "    $v =~ s/^\\s+//;"
NSQ_SOURCE_LINE 00000659 "    $v =~ s/\\s+\\z//;"
NSQ_SOURCE_LINE 00000660 "    if ($v =~ /_/) {"
NSQ_SOURCE_LINE 00000661 "        # XXX should pass something like EDEVELOPERRELEASE up e.g."
NSQ_SOURCE_LINE 00000662 "        # SIXTEASE/XML-Entities-0.0306.tar.gz had nothing but one"
NSQ_SOURCE_LINE 00000663 "        # such modules and the mesage was not helpful that \"nothing"
NSQ_SOURCE_LINE 00000664 "        # was found\"."
NSQ_SOURCE_LINE 00000665 "        return $v ;"
NSQ_SOURCE_LINE 00000666 "    }"
NSQ_SOURCE_LINE 00000667 "    if (!version::is_lax($v)) {"
NSQ_SOURCE_LINE 00000668 "        return JSON::PP::encode_json({ x_normalize => 'version::is_lax failed', version => $v });"
NSQ_SOURCE_LINE 00000669 "    }"
NSQ_SOURCE_LINE 00000670 "    # may warn \"Integer overflow\""
NSQ_SOURCE_LINE 00000671 "    my $vv = eval { no warnings; version->new($v)->numify };"
NSQ_SOURCE_LINE 00000672 "    if ($@) {"
NSQ_SOURCE_LINE 00000673 "        # warn \"$v: $@\";"
NSQ_SOURCE_LINE 00000674 "        return JSON::PP::encode_json({ x_normalize => $@, version => $v });"
NSQ_SOURCE_LINE 00000675 "        # return \"undef\";"
NSQ_SOURCE_LINE 00000676 "    }"
NSQ_SOURCE_LINE 00000677 "    if ($vv eq $v) {"
NSQ_SOURCE_LINE 00000678 "        # the boring 3.14"
NSQ_SOURCE_LINE 00000679 "    } else {"
NSQ_SOURCE_LINE 00000680 "        my $forced = $self->_force_numeric($v);"
NSQ_SOURCE_LINE 00000681 "        if ($forced eq $vv) {"
NSQ_SOURCE_LINE 00000682 "        } elsif ($forced =~ /^v(.+)/) {"
NSQ_SOURCE_LINE 00000683 "            # rare case where a v1.0.23 slipped in (JANL/w3mir-1.0.10.tar.gz)"
NSQ_SOURCE_LINE 00000684 "            no warnings;"
NSQ_SOURCE_LINE 00000685 "            $vv = version->new($1)->numify;"
NSQ_SOURCE_LINE 00000686 "        } else {"
NSQ_SOURCE_LINE 00000687 "            # warn \"Unequal forced[$forced] and vv[$vv]\";"
NSQ_SOURCE_LINE 00000688 "            if ($forced == $vv) {"
NSQ_SOURCE_LINE 00000689 "                # the trailing zeroes would cause unnecessary havoc"
NSQ_SOURCE_LINE 00000690 "                $vv = $forced;"
NSQ_SOURCE_LINE 00000691 "            }"
NSQ_SOURCE_LINE 00000692 "        }"
NSQ_SOURCE_LINE 00000693 "    }"
NSQ_SOURCE_LINE 00000694 "    return $vv;"
NSQ_SOURCE_LINE 00000695 "}"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "# from PAUSE::pmfile;"
NSQ_SOURCE_LINE 00000698 "sub _force_numeric {"
NSQ_SOURCE_LINE 00000699 "    my($self,$v) = @_;"
NSQ_SOURCE_LINE 00000700 "    $v = $self->_readable($v);"
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "    if ("
NSQ_SOURCE_LINE 00000703 "        $v =~"
NSQ_SOURCE_LINE 00000704 "        /^(\\+?)(\\d*)(\\.(\\d*))?/ &&"
NSQ_SOURCE_LINE 00000705 "        # \"$2$4\" ne ''"
NSQ_SOURCE_LINE 00000706 "        ("
NSQ_SOURCE_LINE 00000707 "          defined $2 && length $2"
NSQ_SOURCE_LINE 00000708 "          ||"
NSQ_SOURCE_LINE 00000709 "          defined $4 && length $4"
NSQ_SOURCE_LINE 00000710 "        )"
NSQ_SOURCE_LINE 00000711 "        ) {"
NSQ_SOURCE_LINE 00000712 "        my $two = defined $2 ? $2 : \"\";"
NSQ_SOURCE_LINE 00000713 "        my $three = defined $3 ? $3 : \"\";"
NSQ_SOURCE_LINE 00000714 "        $v = \"$two$three\";"
NSQ_SOURCE_LINE 00000715 "    }"
NSQ_SOURCE_LINE 00000716 "    # no else branch! We simply say, everything else is a string."
NSQ_SOURCE_LINE 00000717 "    $v;"
NSQ_SOURCE_LINE 00000718 "}"
NSQ_SOURCE_LINE 00000719 ""
NSQ_SOURCE_LINE 00000720 "# from PAUSE::dist"
NSQ_SOURCE_LINE 00000721 "sub _version_from_meta_ok {"
NSQ_SOURCE_LINE 00000722 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000723 "  return $self->{VERSION_FROM_META_OK} if exists $self->{VERSION_FROM_META_OK};"
NSQ_SOURCE_LINE 00000724 "  my $c = $self->{META_CONTENT};"
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "  # If there's no provides hash, we can't get our module versions from the"
NSQ_SOURCE_LINE 00000727 "  # provides hash! -- rjbs, 2012-03-31"
NSQ_SOURCE_LINE 00000728 "  return($self->{VERSION_FROM_META_OK} = 0) unless $c->{provides};"
NSQ_SOURCE_LINE 00000729 ""
NSQ_SOURCE_LINE 00000730 "  # Some versions of Module::Build geneated an empty provides hash.  If we're"
NSQ_SOURCE_LINE 00000731 "  # *not* looking at a Module::Build-generated metafile, then it's okay."
NSQ_SOURCE_LINE 00000732 "  my ($mb_v) = (defined $c->{generated_by} ? $c->{generated_by} : '') =~ /Module::Build version ([\\d\\.]+)/;"
NSQ_SOURCE_LINE 00000733 "  return($self->{VERSION_FROM_META_OK} = 1) unless $mb_v;"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "  # ??? I don't know why this is here."
NSQ_SOURCE_LINE 00000736 "  return($self->{VERSION_FROM_META_OK} = 1) if $mb_v eq '0.250.0';"
NSQ_SOURCE_LINE 00000737 ""
NSQ_SOURCE_LINE 00000738 "  if ($mb_v >= 0.19 && $mb_v < 0.26 && ! keys %{$c->{provides}}) {"
NSQ_SOURCE_LINE 00000739 "      # RSAVAGE/Javascript-SHA1-1.01.tgz had an empty provides hash. Ron"
NSQ_SOURCE_LINE 00000740 "      # did not find the reason why this happened, but let's not go"
NSQ_SOURCE_LINE 00000741 "      # overboard, 0.26 seems a good threshold from the statistics: there"
NSQ_SOURCE_LINE 00000742 "      # are not many empty provides hashes from 0.26 up."
NSQ_SOURCE_LINE 00000743 "      return($self->{VERSION_FROM_META_OK} = 0);"
NSQ_SOURCE_LINE 00000744 "  }"
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "  # We're not in the suspect range of M::B versions.  It's good to go."
NSQ_SOURCE_LINE 00000747 "  return($self->{VERSION_FROM_META_OK} = 1);"
NSQ_SOURCE_LINE 00000748 "}"
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "sub _verbose {"
NSQ_SOURCE_LINE 00000751 "    my($self,$level,@what) = @_;"
NSQ_SOURCE_LINE 00000752 "    warn @what if $level <= ((ref $self && $self->{VERBOSE}) || $VERBOSE);"
NSQ_SOURCE_LINE 00000753 "}"
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "# all of the following methods are stripped from CPAN::Version"
NSQ_SOURCE_LINE 00000756 "# (as of version 5.5001, bundled in CPAN 2.03), and slightly"
NSQ_SOURCE_LINE 00000757 "# modified (ie. made private, as well as CPAN->debug(...) are"
NSQ_SOURCE_LINE 00000758 "# replaced with $self->_verbose(9, ...).)"
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "# CPAN::Version::vcmp courtesy Jost Krieger"
NSQ_SOURCE_LINE 00000761 "sub _vcmp {"
NSQ_SOURCE_LINE 00000762 "    my($self,$l,$r) = @_;"
NSQ_SOURCE_LINE 00000763 "    local($^W) = 0;"
NSQ_SOURCE_LINE 00000764 "    $self->_verbose(9, \"l[$l] r[$r]\");"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "    return 0 if $l eq $r; # short circuit for quicker success"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "    for ($l,$r) {"
NSQ_SOURCE_LINE 00000769 "        s/_//g;"
NSQ_SOURCE_LINE 00000770 "    }"
NSQ_SOURCE_LINE 00000771 "    $self->_verbose(9, \"l[$l] r[$r]\");"
NSQ_SOURCE_LINE 00000772 "    for ($l,$r) {"
NSQ_SOURCE_LINE 00000773 "        next unless tr/.// > 1 || /^v/;"
NSQ_SOURCE_LINE 00000774 "        s/^v?/v/;"
NSQ_SOURCE_LINE 00000775 "        1 while s/\\.0+(\\d)/.$1/; # remove leading zeroes per group"
NSQ_SOURCE_LINE 00000776 "    }"
NSQ_SOURCE_LINE 00000777 "    $self->_verbose(9, \"l[$l] r[$r]\");"
NSQ_SOURCE_LINE 00000778 "    if ($l=~/^v/ <=> $r=~/^v/) {"
NSQ_SOURCE_LINE 00000779 "        for ($l,$r) {"
NSQ_SOURCE_LINE 00000780 "            next if /^v/;"
NSQ_SOURCE_LINE 00000781 "            $_ = $self->_float2vv($_);"
NSQ_SOURCE_LINE 00000782 "        }"
NSQ_SOURCE_LINE 00000783 "    }"
NSQ_SOURCE_LINE 00000784 "    $self->_verbose(9, \"l[$l] r[$r]\");"
NSQ_SOURCE_LINE 00000785 "    my $lvstring = \"v0\";"
NSQ_SOURCE_LINE 00000786 "    my $rvstring = \"v0\";"
NSQ_SOURCE_LINE 00000787 "    if ($] >= 5.006"
NSQ_SOURCE_LINE 00000788 "     && $l =~ /^v/"
NSQ_SOURCE_LINE 00000789 "     && $r =~ /^v/) {"
NSQ_SOURCE_LINE 00000790 "        $lvstring = $self->_vstring($l);"
NSQ_SOURCE_LINE 00000791 "        $rvstring = $self->_vstring($r);"
NSQ_SOURCE_LINE 00000792 "        $self->_verbose(9, sprintf \"lv[%vd] rv[%vd]\", $lvstring, $rvstring);"
NSQ_SOURCE_LINE 00000793 "    }"
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "    return ("
NSQ_SOURCE_LINE 00000796 "            ($l ne \"undef\") <=> ($r ne \"undef\")"
NSQ_SOURCE_LINE 00000797 "            ||"
NSQ_SOURCE_LINE 00000798 "            $lvstring cmp $rvstring"
NSQ_SOURCE_LINE 00000799 "            ||"
NSQ_SOURCE_LINE 00000800 "            $l <=> $r"
NSQ_SOURCE_LINE 00000801 "            ||"
NSQ_SOURCE_LINE 00000802 "            $l cmp $r"
NSQ_SOURCE_LINE 00000803 "    );"
NSQ_SOURCE_LINE 00000804 "}"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "sub _vgt {"
NSQ_SOURCE_LINE 00000807 "    my($self,$l,$r) = @_;"
NSQ_SOURCE_LINE 00000808 "    $self->_vcmp($l,$r) > 0;"
NSQ_SOURCE_LINE 00000809 "}"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "sub _vlt {"
NSQ_SOURCE_LINE 00000812 "    my($self,$l,$r) = @_;"
NSQ_SOURCE_LINE 00000813 "    $self->_vcmp($l,$r) < 0;"
NSQ_SOURCE_LINE 00000814 "}"
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 "sub _vge {"
NSQ_SOURCE_LINE 00000817 "    my($self,$l,$r) = @_;"
NSQ_SOURCE_LINE 00000818 "    $self->_vcmp($l,$r) >= 0;"
NSQ_SOURCE_LINE 00000819 "}"
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "sub _vle {"
NSQ_SOURCE_LINE 00000822 "    my($self,$l,$r) = @_;"
NSQ_SOURCE_LINE 00000823 "    $self->_vcmp($l,$r) <= 0;"
NSQ_SOURCE_LINE 00000824 "}"
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "sub _vstring {"
NSQ_SOURCE_LINE 00000827 "    my($self,$n) = @_;"
NSQ_SOURCE_LINE 00000828 "    $n =~ s/^v// or die \"Parse::PMFile::_vstring() called with invalid arg [$n]\";"
NSQ_SOURCE_LINE 00000829 "    pack \"U*\", split /\\./, $n;"
NSQ_SOURCE_LINE 00000830 "}"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "# vv => visible vstring"
NSQ_SOURCE_LINE 00000833 "sub _float2vv {"
NSQ_SOURCE_LINE 00000834 "    my($self,$n) = @_;"
NSQ_SOURCE_LINE 00000835 "    my($rev) = int($n);"
NSQ_SOURCE_LINE 00000836 "    $rev ||= 0;"
NSQ_SOURCE_LINE 00000837 "    my($mantissa) = $n =~ /\\.(\\d{1,12})/; # limit to 12 digits to limit"
NSQ_SOURCE_LINE 00000838 "                                          # architecture influence"
NSQ_SOURCE_LINE 00000839 "    $mantissa ||= 0;"
NSQ_SOURCE_LINE 00000840 "    $mantissa .= \"0\" while length($mantissa)%3;"
NSQ_SOURCE_LINE 00000841 "    my $ret = \"v\" . $rev;"
NSQ_SOURCE_LINE 00000842 "    while ($mantissa) {"
NSQ_SOURCE_LINE 00000843 "        $mantissa =~ s/(\\d{1,3})// or"
NSQ_SOURCE_LINE 00000844 "            die \"Panic: length>0 but not a digit? mantissa[$mantissa]\";"
NSQ_SOURCE_LINE 00000845 "        $ret .= \".\".int($1);"
NSQ_SOURCE_LINE 00000846 "    }"
NSQ_SOURCE_LINE 00000847 "    # warn \"n[$n]ret[$ret]\";"
NSQ_SOURCE_LINE 00000848 "    $ret =~ s/(\\.0)+/.0/; # v1.0.0 => v1.0"
NSQ_SOURCE_LINE 00000849 "    $ret;"
NSQ_SOURCE_LINE 00000850 "}"
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "sub _readable {"
NSQ_SOURCE_LINE 00000853 "    my($self,$n) = @_;"
NSQ_SOURCE_LINE 00000854 "    $n =~ /^([\\w\\-\\+\\.]+)/;"
NSQ_SOURCE_LINE 00000855 ""
NSQ_SOURCE_LINE 00000856 "    return $1 if defined $1 && length($1)>0;"
NSQ_SOURCE_LINE 00000857 "    # if the first user reaches version v43, he will be treated as \"+\"."
NSQ_SOURCE_LINE 00000858 "    # We'll have to decide about a new rule here then, depending on what"
NSQ_SOURCE_LINE 00000859 "    # will be the prevailing versioning behavior then."
NSQ_SOURCE_LINE 00000860 ""
NSQ_SOURCE_LINE 00000861 "    if ($] < 5.006) { # or whenever v-strings were introduced"
NSQ_SOURCE_LINE 00000862 "        # we get them wrong anyway, whatever we do, because 5.005 will"
NSQ_SOURCE_LINE 00000863 "        # have already interpreted 0.2.4 to be \"0.24\". So even if he"
NSQ_SOURCE_LINE 00000864 "        # indexer sends us something like \"v0.2.4\" we compare wrongly."
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "        # And if they say v1.2, then the old perl takes it as \"v12\""
NSQ_SOURCE_LINE 00000867 ""
NSQ_SOURCE_LINE 00000868 "        $self->_verbose(9, \"Suspicious version string seen [$n]\\n\");"
NSQ_SOURCE_LINE 00000869 "        return $n;"
NSQ_SOURCE_LINE 00000870 "    }"
NSQ_SOURCE_LINE 00000871 "    my $better = sprintf \"v%vd\", $n;"
NSQ_SOURCE_LINE 00000872 "    $self->_verbose(9, \"n[$n] better[$better]\");"
NSQ_SOURCE_LINE 00000873 "    return $better;"
NSQ_SOURCE_LINE 00000874 "}"
NSQ_SOURCE_LINE 00000875 ""
NSQ_SOURCE_LINE 00000876 "1;"
NSQ_SOURCE_LINE 00000877 ""
NSQ_SOURCE_LINE 00000878 "__END__"
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "=head1 NAME"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "Parse::PMFile - parses .pm file as PAUSE does"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "    use Parse::PMFile;"
NSQ_SOURCE_LINE 00000887 ""
NSQ_SOURCE_LINE 00000888 "    my $parser = Parse::PMFile->new($metadata, {VERBOSE => 1});"
NSQ_SOURCE_LINE 00000889 "    my $packages_info = $parser->parse($pmfile);"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "    # if you need info about invalid versions"
NSQ_SOURCE_LINE 00000892 "    my ($packages_info, $errors) = $parser->parse($pmfile);"
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "    # to check permissions"
NSQ_SOURCE_LINE 00000895 "    my $parser = Parse::PMFile->new($metadata, {"
NSQ_SOURCE_LINE 00000896 "        USERID => 'ISHIGAKI',"
NSQ_SOURCE_LINE 00000897 "        PERMISSIONS => PAUSE::Permissions->new,"
NSQ_SOURCE_LINE 00000898 "    });"
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "The most of the code of this module is taken from the PAUSE code as of April 2013 almost verbatim. Thus, the heart of this module should be quite stable. However, I made it not to use pipe (\"-|\") as well as I stripped database-related code. If you encounter any issue, that's most probably because of my modification."
NSQ_SOURCE_LINE 00000903 ""
NSQ_SOURCE_LINE 00000904 "This module doesn't provide features to extract a distribution or parse meta files intentionally."
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "=head1 METHODS"
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "=head2 new"
NSQ_SOURCE_LINE 00000909 ""
NSQ_SOURCE_LINE 00000910 "creates an object. You can also pass a hashref taken from META.yml etc, and an optional hashref. Options are:"
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "=over 4"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "=item ALLOW_DEV_VERSION"
NSQ_SOURCE_LINE 00000915 ""
NSQ_SOURCE_LINE 00000916 "Parse::PMFile usually ignores a version with an underscore as PAUSE does (because it's for a developer release, and should not be indexed). Set this option to true if you happen to need to keep such a version for better analysis."
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "=item VERBOSE"
NSQ_SOURCE_LINE 00000919 ""
NSQ_SOURCE_LINE 00000920 "Set this to true if you need to know some details."
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "=item FORK"
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "As of version 0.17, Parse::PMFile stops forking while parsing a version for better performance. Parse::PMFile should return the same result no matter how this option is set, but if you do care, set this to true to fork as PAUSE does."
NSQ_SOURCE_LINE 00000925 ""
NSQ_SOURCE_LINE 00000926 "=item USERID, PERMISSIONS"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "As of version 0.21, Parse::PMFile checks permissions of a package if both USERID and PERMISSIONS (which should be an instance of L<PAUSE::Permissions>) are provided. Unauthorized packages are removed."
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "=item UNSAFE"
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "Parse::PMFile usually parses a module version in a Safe compartment. However, this approach doesn't work smoothly under older perls (prior to 5.10) plus some combinations of recent versions of Safe.pm (2.24 and above) and version.pm (0.9905 and above) for various reasons. As of version 0.27, Parse::PMFile simply uses C<eval> to parse a version under older perls. If you want it to use always C<eval> (even under recent perls), set this to true."
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "=back"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "=head2 parse"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "takes a path to a .pm file, and returns a hash reference that holds information for package(s) found in the file."
NSQ_SOURCE_LINE 00000939 ""
NSQ_SOURCE_LINE 00000940 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000941 ""
NSQ_SOURCE_LINE 00000942 "L<Parse::LocalDistribution>, L<PAUSE::Permissions>"
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "Most part of this module is derived from PAUSE and CPAN::Version."
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "L<https://github.com/andk/pause>"
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "L<https://github.com/andk/cpanpm>"
