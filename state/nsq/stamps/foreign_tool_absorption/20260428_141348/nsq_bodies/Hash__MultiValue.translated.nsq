NSQ_SOURCE_LINE 00000252 "    my $v = $values{$this};"
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "    my %hash;"
NSQ_SOURCE_LINE 00000255 "    push @{$hash{$k->[$_]}}, $v->[$_] for 0 .. $#$k;"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    \\%hash;"
NSQ_SOURCE_LINE 00000258 "}"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "*multi = \\&as_hashref_multi;"
NSQ_SOURCE_LINE 00000261 ""
