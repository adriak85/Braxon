NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "sub get {"
NSQ_SOURCE_LINE 00000072 "    my($self, $key) = @_;"
NSQ_SOURCE_LINE 00000073 "    $self->{$key};"
NSQ_SOURCE_LINE 00000074 "}"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "sub get_all {"
NSQ_SOURCE_LINE 00000077 "    my($self, $key) = @_;"
NSQ_SOURCE_LINE 00000078 "    my $this = refaddr $self;"
NSQ_SOURCE_LINE 00000079 "    my $k = $keys{$this};"
NSQ_SOURCE_LINE 00000080 "    (@{$values{$this}}[grep { $key eq $k->[$_] } 0 .. $#$k]);"
NSQ_SOURCE_LINE 00000081 "}"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "sub get_one {"
NSQ_SOURCE_LINE 00000084 "    my ($self, $key) = @_;"
NSQ_SOURCE_LINE 00000085 "    my @v = $self->get_all($key);"
NSQ_SOURCE_LINE 00000086 "    return $v[0] if @v == 1;"
NSQ_SOURCE_LINE 00000087 "    Carp::croak \"Key not found: $key\" if not @v;"
NSQ_SOURCE_LINE 00000088 "    Carp::croak \"Multiple values match: $key\";"
NSQ_SOURCE_LINE 00000089 "}"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "sub set {"
NSQ_SOURCE_LINE 00000092 "    my $self = shift;"
NSQ_SOURCE_LINE 00000093 "    my $key = shift;"
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "    my $this = refaddr $self;"
NSQ_SOURCE_LINE 00000096 "    my $k = $keys{$this};"
NSQ_SOURCE_LINE 00000097 "    my $v = $values{$this};"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    my @idx = grep { $key eq $k->[$_] } 0 .. $#$k;"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "    my $added = @_ - @idx;"
NSQ_SOURCE_LINE 00000102 "    if ($added > 0) {"
NSQ_SOURCE_LINE 00000103 "        my $start = $#$k + 1;"
NSQ_SOURCE_LINE 00000104 "        push @$k, ($key) x $added;"
NSQ_SOURCE_LINE 00000105 "        push @idx, $start .. $#$k;"
NSQ_SOURCE_LINE 00000106 "    }"
NSQ_SOURCE_LINE 00000107 "    elsif ($added < 0) {"
NSQ_SOURCE_LINE 00000108 "        my ($start, @drop, @keep) = splice @idx, $added;"
NSQ_SOURCE_LINE 00000109 "        for my $i ($start+1 .. $#$k) {"
NSQ_SOURCE_LINE 00000110 "            if (@drop and $i == $drop[0]) {"
NSQ_SOURCE_LINE 00000111 "                shift @drop;"
NSQ_SOURCE_LINE 00000112 "                next;"
NSQ_SOURCE_LINE 00000113 "            }"
NSQ_SOURCE_LINE 00000114 "            push @keep, $i;"
NSQ_SOURCE_LINE 00000115 "        }"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "        splice @$_, $start, 0+@$_, ( _SPLICE_SAME_ARRAY_SEGFAULT"
NSQ_SOURCE_LINE 00000118 "            ? @{[ @$_[@keep] ]} # force different source array"
NSQ_SOURCE_LINE 00000119 "            :     @$_[@keep]"
NSQ_SOURCE_LINE 00000120 "        ) for $k, $v;"
NSQ_SOURCE_LINE 00000121 "    }"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "    if (@_) {"
NSQ_SOURCE_LINE 00000124 "        @$v[@idx] = @_;"
NSQ_SOURCE_LINE 00000125 "        $self->{$key} = $_[-1];"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 "    else {"
NSQ_SOURCE_LINE 00000128 "        delete $self->{$key};"
NSQ_SOURCE_LINE 00000129 "    }"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "    $self;"
NSQ_SOURCE_LINE 00000132 "}"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "sub add {"
NSQ_SOURCE_LINE 00000135 "    my $self = shift;"
NSQ_SOURCE_LINE 00000136 "    my $key = shift;"
NSQ_SOURCE_LINE 00000137 "    $self->merge_mixed( $key => \\@_ );"
NSQ_SOURCE_LINE 00000138 "    $self;"
NSQ_SOURCE_LINE 00000139 "}"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "sub merge_flat {"
NSQ_SOURCE_LINE 00000142 "    my $self = shift;"
NSQ_SOURCE_LINE 00000143 "    my $this = refaddr $self;"
NSQ_SOURCE_LINE 00000144 "    my $k = $keys{$this};"
NSQ_SOURCE_LINE 00000145 "    my $v = $values{$this};"
NSQ_SOURCE_LINE 00000146 "    push @{ $_ & 1 ? $v : $k }, $_[$_] for 0 .. $#_;"
NSQ_SOURCE_LINE 00000147 "    @{$self}{@$k} = @$v;"
NSQ_SOURCE_LINE 00000148 "    $self;"
NSQ_SOURCE_LINE 00000149 "}"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "sub merge_mixed {"
NSQ_SOURCE_LINE 00000152 "    my $self = shift;"
NSQ_SOURCE_LINE 00000153 "    my $this = refaddr $self;"
NSQ_SOURCE_LINE 00000154 "    my $k = $keys{$this};"
NSQ_SOURCE_LINE 00000155 "    my $v = $values{$this};"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    my $hash;"
NSQ_SOURCE_LINE 00000158 "    $hash = shift if @_ == 1;"
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "    while ( my ($key, $value) = @_ ? splice @_, 0, 2 : each %$hash ) {"
NSQ_SOURCE_LINE 00000161 "        if ( CORE::ref($value) eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000162 "            next if not @$value;"
NSQ_SOURCE_LINE 00000163 "            push @$k, ($key) x @$value;"
NSQ_SOURCE_LINE 00000164 "            push @$v, @$value;"
NSQ_SOURCE_LINE 00000165 "        }"
NSQ_SOURCE_LINE 00000166 "        else {"
NSQ_SOURCE_LINE 00000167 "            push @$k, $key;"
NSQ_SOURCE_LINE 00000168 "            push @$v, $value;"
NSQ_SOURCE_LINE 00000169 "        }"
NSQ_SOURCE_LINE 00000170 "        $self->{$key} = $v->[-1];"
NSQ_SOURCE_LINE 00000171 "    }"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    $self;"
NSQ_SOURCE_LINE 00000174 "}"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "sub remove {"
NSQ_SOURCE_LINE 00000177 "    my ($self, $key) = @_;"
NSQ_SOURCE_LINE 00000178 "    $self->set($key);"
NSQ_SOURCE_LINE 00000179 "    $self;"
NSQ_SOURCE_LINE 00000180 "}"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "sub clear {"
NSQ_SOURCE_LINE 00000183 "    my $self = shift;"
NSQ_SOURCE_LINE 00000184 "    %$self = ();"
NSQ_SOURCE_LINE 00000185 "    my $this = refaddr $self;"
NSQ_SOURCE_LINE 00000186 "    $keys{$this} = [];"
NSQ_SOURCE_LINE 00000187 "    $values{$this} = [];"
NSQ_SOURCE_LINE 00000188 "    $self;"
NSQ_SOURCE_LINE 00000189 "}"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "sub clone {"
NSQ_SOURCE_LINE 00000192 "    my $self = shift;"
NSQ_SOURCE_LINE 00000193 "    CORE::ref($self)->new($self->flatten);"
NSQ_SOURCE_LINE 00000194 "}"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "sub keys {"
NSQ_SOURCE_LINE 00000197 "    my $self = shift;"
NSQ_SOURCE_LINE 00000198 "    return @{$keys{refaddr $self}};"
NSQ_SOURCE_LINE 00000199 "}"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "sub values {"
NSQ_SOURCE_LINE 00000202 "    my $self = shift;"
NSQ_SOURCE_LINE 00000203 "    return @{$values{refaddr $self}};"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "sub flatten {"
NSQ_SOURCE_LINE 00000207 "    my $self = shift;"
NSQ_SOURCE_LINE 00000208 "    my $this = refaddr $self;"
NSQ_SOURCE_LINE 00000209 "    my $k = $keys{$this};"
NSQ_SOURCE_LINE 00000210 "    my $v = $values{$this};"
NSQ_SOURCE_LINE 00000211 "    map { $k->[$_], $v->[$_] } 0 .. $#$k;"
NSQ_SOURCE_LINE 00000212 "}"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "sub each {"
NSQ_SOURCE_LINE 00000215 "    my ($self, $code) = @_;"
NSQ_SOURCE_LINE 00000216 "    my $this = refaddr $self;"
NSQ_SOURCE_LINE 00000217 "    my $k = $keys{$this};"
NSQ_SOURCE_LINE 00000218 "    my $v = $values{$this};"
NSQ_SOURCE_LINE 00000219 "    for (0 .. $#$k) {"
NSQ_SOURCE_LINE 00000220 "        $code->($k->[$_], $v->[$_]);"
NSQ_SOURCE_LINE 00000221 "    }"
NSQ_SOURCE_LINE 00000222 "    return $self;"
NSQ_SOURCE_LINE 00000223 "}"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "sub as_hashref {"
NSQ_SOURCE_LINE 00000226 "    my $self = shift;"
NSQ_SOURCE_LINE 00000227 "    my %hash = %$self;"
NSQ_SOURCE_LINE 00000228 "    \\%hash;"
NSQ_SOURCE_LINE 00000229 "}"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "sub as_hashref_mixed {"
NSQ_SOURCE_LINE 00000232 "    my $self = shift;"
NSQ_SOURCE_LINE 00000233 "    my $this = refaddr $self;"
NSQ_SOURCE_LINE 00000234 "    my $k = $keys{$this};"
NSQ_SOURCE_LINE 00000235 "    my $v = $values{$this};"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "    my %hash;"
NSQ_SOURCE_LINE 00000238 "    push @{$hash{$k->[$_]}}, $v->[$_] for 0 .. $#$k;"
NSQ_SOURCE_LINE 00000239 "    for (CORE::values %hash) {"
NSQ_SOURCE_LINE 00000240 "        $_ = $_->[0] if 1 == @$_;"
NSQ_SOURCE_LINE 00000241 "    }"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "    \\%hash;"
NSQ_SOURCE_LINE 00000244 "}"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "*mixed = \\&as_hashref_mixed;"
NSQ_SOURCE_LINE 00000247 ""
