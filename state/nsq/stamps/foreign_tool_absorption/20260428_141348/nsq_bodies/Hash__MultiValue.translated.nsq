NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.16';"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Carp ();"
NSQ_SOURCE_LINE 00000009 "use Scalar::Util qw(refaddr);"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "# there does not seem to be a relevant RT or perldelta entry for this"
NSQ_SOURCE_LINE 00000012 "use constant _SPLICE_SAME_ARRAY_SEGFAULT => $] < '5.008007';"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "my %keys;"
NSQ_SOURCE_LINE 00000015 "my %values;"
NSQ_SOURCE_LINE 00000016 "my %registry;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "BEGIN {"
NSQ_SOURCE_LINE 00000019 "    require Config;"
NSQ_SOURCE_LINE 00000020 "    my $needs_registry = ($^O eq 'Win32' || $Config::Config{useithreads});"
NSQ_SOURCE_LINE 00000021 "    if ($needs_registry) {"
NSQ_SOURCE_LINE 00000022 "        *CLONE = sub {"
NSQ_SOURCE_LINE 00000023 "            foreach my $oldaddr (keys %registry) {"
NSQ_SOURCE_LINE 00000024 "                my $this = refaddr $registry{$oldaddr};"
NSQ_SOURCE_LINE 00000025 "                $keys{$this}   = delete $keys{$oldaddr};"
NSQ_SOURCE_LINE 00000026 "                $values{$this} = delete $values{$oldaddr};"
NSQ_SOURCE_LINE 00000027 "                Scalar::Util::weaken($registry{$this} = delete $registry{$oldaddr});"
NSQ_SOURCE_LINE 00000028 "            }"
NSQ_SOURCE_LINE 00000029 "        };"
NSQ_SOURCE_LINE 00000030 "    }"
NSQ_SOURCE_LINE 00000031 "    *NEEDS_REGISTRY = sub () { $needs_registry };"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "if (defined &UNIVERSAL::ref::import) {"
NSQ_SOURCE_LINE 00000035 "    UNIVERSAL::ref->import;"
NSQ_SOURCE_LINE 00000036 "}"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "sub ref { 'HASH' }"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "sub create {"
NSQ_SOURCE_LINE 00000041 "    my $class = shift;"
NSQ_SOURCE_LINE 00000042 "    my $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000043 "    my $this = refaddr $self;"
NSQ_SOURCE_LINE 00000044 "    $keys{$this} = [];"
NSQ_SOURCE_LINE 00000045 "    $values{$this} = [];"
NSQ_SOURCE_LINE 00000046 "    Scalar::Util::weaken($registry{$this} = $self) if NEEDS_REGISTRY;"
NSQ_SOURCE_LINE 00000047 "    $self;"
NSQ_SOURCE_LINE 00000048 "}"
NSQ_SOURCE_LINE 00000049 ""
