NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "sub STORABLE_thaw {"
NSQ_SOURCE_LINE 00000269 "    my $self = shift;"
NSQ_SOURCE_LINE 00000270 "    my ($is_cloning, $serialised, $k, $v) = @_;"
NSQ_SOURCE_LINE 00000271 "    my $this = refaddr $self;"
NSQ_SOURCE_LINE 00000272 "    $keys  {$this} = $k;"
NSQ_SOURCE_LINE 00000273 "    $values{$this} = $v;"
NSQ_SOURCE_LINE 00000274 "    @{$self}{@$k} = @$v;"
