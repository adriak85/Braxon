NSQ_SOURCE_LINE 00000051 "    my $class = shift;"
NSQ_SOURCE_LINE 00000052 "    my $self = $class->create;"
NSQ_SOURCE_LINE 00000053 "    unshift @_, $self;"
NSQ_SOURCE_LINE 00000054 "    &{ $self->can('merge_flat') };"
NSQ_SOURCE_LINE 00000055 "}"
NSQ_SOURCE_LINE 00000056 ""
