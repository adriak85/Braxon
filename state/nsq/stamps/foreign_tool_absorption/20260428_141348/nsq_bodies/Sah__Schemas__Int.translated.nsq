NSQ_SOURCE_LINE 00000019 "=head1 NAME"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "Sah::Schemas::Int - Sah schemas for various integers"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "=head1 VERSION"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "This document describes version 0.077 of Sah::Schemas::Int (from Perl distribution Sah-Schemas-Int), released on 2022-10-19."
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "=head1 SAH SCHEMAS"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "The following schemas are included in this distribution:"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "=over"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "=item * L<byte|Sah::Schema::byte>"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "Same as uint8."
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=item * L<even|Sah::Schema::even>"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "Even number."
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "=item * L<int128|Sah::Schema::int128>"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "128-bit signed integer."
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=item * L<int16|Sah::Schema::int16>"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "16-bit signed integer."
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "=item * L<int32|Sah::Schema::int32>"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "32-bit signed integer."
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "=item * L<int64|Sah::Schema::int64>"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "64-bit signed integer."
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "=item * L<int8|Sah::Schema::int8>"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "8-bit signed integer."
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "=item * L<natnum|Sah::Schema::natnum>"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "Same as posint."
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "Natural numbers are those used for counting and ordering. Some definitions, like"
NSQ_SOURCE_LINE 00000066 "ISO 80000-2 begin the natural numbers with 0. But in this definition, natural"
NSQ_SOURCE_LINE 00000067 "numbers start with 1. For integers that start at 0, see C<uint>."
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=item * L<negeven|Sah::Schema::negeven>"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "Negative even number."
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=item * L<negint|Sah::Schema::negint>"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "Negative integer (-1, -2, ...)."
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=item * L<negodd|Sah::Schema::negodd>"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "Negative odd number."
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=item * L<nonnegint|Sah::Schema::nonnegint>"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "Non-negative integer (0, 1, 2, ...), same as uint."
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=item * L<nonposint|Sah::Schema::nonposint>"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "Non-positive integer (0, -1, -2, ...)."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "=item * L<odd|Sah::Schema::odd>"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "Odd number."
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=item * L<poseven|Sah::Schema::poseven>"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "Positive even number."
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "=item * L<posint|Sah::Schema::posint>"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "Positive integer (1, 2, ...)."
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "Zero is not included in this schema because zero is neither positive nor"
NSQ_SOURCE_LINE 00000103 "negative. See also C<uint> for integers that start from 0."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "=item * L<posodd|Sah::Schema::posodd>"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "Positive odd number."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=item * L<uint|Sah::Schema::uint>"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "Non-negative integer (0, 1, 2, ...)."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "See also C<posint> for integers that start from 1."
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=item * L<uint128|Sah::Schema::uint128>"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "128-bit unsigned integer."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=item * L<uint16|Sah::Schema::uint16>"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "16-bit unsigned integer."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=item * L<uint32|Sah::Schema::uint32>"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "32-bit unsigned integer."
NSQ_SOURCE_LINE 00000128 ""
NSQ_SOURCE_LINE 00000129 "=item * L<uint64|Sah::Schema::uint64>"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "64-bit unsigned integer."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "=item * L<uint8|Sah::Schema::uint8>"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "8-bit unsigned integer."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "=back"
NSQ_SOURCE_LINE 00000138 ""
