NSQ_SOURCE_LINE 00000507 "1;"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 ""
NSQ_SOURCE_LINE 00000510 "#pod =head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000511 "#pod"
NSQ_SOURCE_LINE 00000512 "#pod   use Email::Valid;"
NSQ_SOURCE_LINE 00000513 "#pod   my $address = Email::Valid->address('maurice@hevanet.com');"
NSQ_SOURCE_LINE 00000514 "#pod   print ($address ? 'yes' : 'no');"
NSQ_SOURCE_LINE 00000515 "#pod"
NSQ_SOURCE_LINE 00000516 "#pod =head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000517 "#pod"
NSQ_SOURCE_LINE 00000518 "#pod This module determines whether an email address is well-formed, and"
NSQ_SOURCE_LINE 00000519 "#pod optionally, whether a mail host exists for the domain."
NSQ_SOURCE_LINE 00000520 "#pod"
NSQ_SOURCE_LINE 00000521 "#pod Please note that there is no way to determine whether an"
NSQ_SOURCE_LINE 00000522 "#pod address is deliverable without attempting delivery"
NSQ_SOURCE_LINE 00000523 "#pod (for details, see L<perlfaq 9|http://perldoc.perl.org/perlfaq9.html#How-do-I-check-a-valid-mail-address>)."
NSQ_SOURCE_LINE 00000524 "#pod"
NSQ_SOURCE_LINE 00000525 "#pod =head1 PREREQUISITES"
NSQ_SOURCE_LINE 00000526 "#pod"
NSQ_SOURCE_LINE 00000527 "#pod This module requires perl 5.004 or later and the L<Mail::Address> module."
NSQ_SOURCE_LINE 00000528 "#pod Either the L<Net::DNS> module or the nslookup utility is required"
NSQ_SOURCE_LINE 00000529 "#pod for DNS checks.  The L<Net::Domain::TLD> module is required to check the"
NSQ_SOURCE_LINE 00000530 "#pod validity of top level domains."
NSQ_SOURCE_LINE 00000531 "#pod"
NSQ_SOURCE_LINE 00000532 "#pod =head1 METHODS"
NSQ_SOURCE_LINE 00000533 "#pod"
NSQ_SOURCE_LINE 00000534 "#pod Every method which accepts an C<< <ADDRESS> >> parameter may"
NSQ_SOURCE_LINE 00000535 "#pod be passed either a string or an instance of the Mail::Address"
NSQ_SOURCE_LINE 00000536 "#pod class.  All errors raise an exception."
NSQ_SOURCE_LINE 00000537 "#pod"
NSQ_SOURCE_LINE 00000538 "#pod =over 4"
NSQ_SOURCE_LINE 00000539 "#pod"
NSQ_SOURCE_LINE 00000540 "#pod =item new ( [PARAMS] )"
NSQ_SOURCE_LINE 00000541 "#pod"
NSQ_SOURCE_LINE 00000542 "#pod This method is used to construct an Email::Valid object."
NSQ_SOURCE_LINE 00000543 "#pod It accepts an optional list of named parameters to"
NSQ_SOURCE_LINE 00000544 "#pod control the behavior of the object at instantiation."
NSQ_SOURCE_LINE 00000545 "#pod"
NSQ_SOURCE_LINE 00000546 "#pod The following named parameters are allowed.  See the"
NSQ_SOURCE_LINE 00000547 "#pod individual methods below for details."
NSQ_SOURCE_LINE 00000548 "#pod"
NSQ_SOURCE_LINE 00000549 "#pod  -mxcheck"
NSQ_SOURCE_LINE 00000550 "#pod  -tldcheck"
NSQ_SOURCE_LINE 00000551 "#pod  -fudge"
NSQ_SOURCE_LINE 00000552 "#pod  -fqdn"
NSQ_SOURCE_LINE 00000553 "#pod  -allow_ip"
NSQ_SOURCE_LINE 00000554 "#pod  -local_rules"
NSQ_SOURCE_LINE 00000555 "#pod"
NSQ_SOURCE_LINE 00000556 "#pod =item mx ( <ADDRESS>|<DOMAIN> )"
NSQ_SOURCE_LINE 00000557 "#pod"
NSQ_SOURCE_LINE 00000558 "#pod This method accepts an email address or domain name and determines"
NSQ_SOURCE_LINE 00000559 "#pod whether a DNS record (A or MX) exists for it."
NSQ_SOURCE_LINE 00000560 "#pod"
NSQ_SOURCE_LINE 00000561 "#pod The method returns true if a record is found and undef if not."
NSQ_SOURCE_LINE 00000562 "#pod"
NSQ_SOURCE_LINE 00000563 "#pod Either the Net::DNS module or the nslookup utility is required for"
NSQ_SOURCE_LINE 00000564 "#pod DNS checks.  Using Net::DNS is the preferred method since error"
NSQ_SOURCE_LINE 00000565 "#pod handling is improved.  If Net::DNS is available, you can modify"
NSQ_SOURCE_LINE 00000566 "#pod the behavior of the resolver (e.g. change the default tcp_timeout"
NSQ_SOURCE_LINE 00000567 "#pod value) by manipulating the global L<Net::DNS::Resolver> instance stored in"
NSQ_SOURCE_LINE 00000568 "#pod C<$Email::Valid::Resolver>."
NSQ_SOURCE_LINE 00000569 "#pod"
NSQ_SOURCE_LINE 00000570 "#pod =item rfc822 ( <ADDRESS> )"
NSQ_SOURCE_LINE 00000571 "#pod"
NSQ_SOURCE_LINE 00000572 "#pod This method determines whether an address conforms to the RFC822"
NSQ_SOURCE_LINE 00000573 "#pod specification (except for nested comments).  It returns true if it"
NSQ_SOURCE_LINE 00000574 "#pod conforms and undef if not."
NSQ_SOURCE_LINE 00000575 "#pod"
NSQ_SOURCE_LINE 00000576 "#pod =item fudge ( <TRUE>|<FALSE> )"
NSQ_SOURCE_LINE 00000577 "#pod"
NSQ_SOURCE_LINE 00000578 "#pod Specifies whether calls to address() should attempt to correct"
NSQ_SOURCE_LINE 00000579 "#pod common addressing errors.  Currently, this results in the removal of"
NSQ_SOURCE_LINE 00000580 "#pod spaces in AOL addresses, and the conversion of commas to periods in"
NSQ_SOURCE_LINE 00000581 "#pod Compuserve addresses.  The default is false."
NSQ_SOURCE_LINE 00000582 "#pod"
NSQ_SOURCE_LINE 00000583 "#pod =item allow_ip ( <TRUE>|<FALSE> )"
NSQ_SOURCE_LINE 00000584 "#pod"
NSQ_SOURCE_LINE 00000585 "#pod Specifies whether a \"domain literal\" is acceptable as the domain part.  That"
NSQ_SOURCE_LINE 00000586 "#pod means addresses like:  C<rjbs@[1.2.3.4]>"
NSQ_SOURCE_LINE 00000587 "#pod"
NSQ_SOURCE_LINE 00000588 "#pod The checking for the domain literal is stricter than the RFC and looser than"
NSQ_SOURCE_LINE 00000589 "#pod checking for a valid IP address, I<but this is subject to change>."
NSQ_SOURCE_LINE 00000590 "#pod"
NSQ_SOURCE_LINE 00000591 "#pod The default is true."
NSQ_SOURCE_LINE 00000592 "#pod"
NSQ_SOURCE_LINE 00000593 "#pod =item fqdn ( <TRUE>|<FALSE> )"
NSQ_SOURCE_LINE 00000594 "#pod"
NSQ_SOURCE_LINE 00000595 "#pod Specifies whether addresses passed to address() must contain a fully"
NSQ_SOURCE_LINE 00000596 "#pod qualified domain name (FQDN).  The default is true."
NSQ_SOURCE_LINE 00000597 "#pod"
NSQ_SOURCE_LINE 00000598 "#pod B<Please note!>  FQDN checks only occur for non-domain-literals.  In other"
NSQ_SOURCE_LINE 00000599 "#pod words, if you have set C<allow_ip> and the address ends in a bracketed IP"
NSQ_SOURCE_LINE 00000600 "#pod address, the FQDN check will not occur."
NSQ_SOURCE_LINE 00000601 "#pod"
NSQ_SOURCE_LINE 00000602 "#pod =item tld ( <ADDRESS> )"
NSQ_SOURCE_LINE 00000603 "#pod"
NSQ_SOURCE_LINE 00000604 "#pod This method determines whether the domain part of an address is in a"
NSQ_SOURCE_LINE 00000605 "#pod recognized top-level domain."
NSQ_SOURCE_LINE 00000606 "#pod"
NSQ_SOURCE_LINE 00000607 "#pod B<Please note!>  TLD checks only occur for non-domain-literals.  In other"
NSQ_SOURCE_LINE 00000608 "#pod words, if you have set C<allow_ip> and the address ends in a bracketed IP"
NSQ_SOURCE_LINE 00000609 "#pod address, the TLD check will not occur."
NSQ_SOURCE_LINE 00000610 "#pod"
NSQ_SOURCE_LINE 00000611 "#pod =item local_rules ( <TRUE>|<FALSE> )"
NSQ_SOURCE_LINE 00000612 "#pod"
NSQ_SOURCE_LINE 00000613 "#pod Specifies whether addresses passed to address() should be tested"
NSQ_SOURCE_LINE 00000614 "#pod for domain specific restrictions.  Currently, this is limited to"
NSQ_SOURCE_LINE 00000615 "#pod certain AOL restrictions that I'm aware of.  The default is false."
NSQ_SOURCE_LINE 00000616 "#pod"
NSQ_SOURCE_LINE 00000617 "#pod =item mxcheck ( <TRUE>|<FALSE> )"
NSQ_SOURCE_LINE 00000618 "#pod"
NSQ_SOURCE_LINE 00000619 "#pod Specifies whether addresses passed to address() should be checked"
NSQ_SOURCE_LINE 00000620 "#pod for a valid DNS entry.  The default is false."
NSQ_SOURCE_LINE 00000621 "#pod"
NSQ_SOURCE_LINE 00000622 "#pod =item tldcheck ( <TRUE>|<FALSE> )"
NSQ_SOURCE_LINE 00000623 "#pod"
NSQ_SOURCE_LINE 00000624 "#pod Specifies whether addresses passed to address() should be checked"
NSQ_SOURCE_LINE 00000625 "#pod for a valid top level domains.  The default is false."
NSQ_SOURCE_LINE 00000626 "#pod"
NSQ_SOURCE_LINE 00000627 "#pod =item address ( <ADDRESS> )"
NSQ_SOURCE_LINE 00000628 "#pod"
NSQ_SOURCE_LINE 00000629 "#pod This is the primary method which determines whether an email"
NSQ_SOURCE_LINE 00000630 "#pod address is valid.  Its behavior is modified by the values of"
NSQ_SOURCE_LINE 00000631 "#pod mxcheck(), tldcheck(), local_rules(), fqdn(), and fudge().  If the address"
NSQ_SOURCE_LINE 00000632 "#pod passes all checks, the (possibly modified) address is returned as"
NSQ_SOURCE_LINE 00000633 "#pod a string.  Otherwise, undef is returned."
NSQ_SOURCE_LINE 00000634 "#pod In a list context, the method also returns an instance of the"
NSQ_SOURCE_LINE 00000635 "#pod Mail::Address class representing the email address."
NSQ_SOURCE_LINE 00000636 "#pod"
NSQ_SOURCE_LINE 00000637 "#pod =item details ()"
NSQ_SOURCE_LINE 00000638 "#pod"
NSQ_SOURCE_LINE 00000639 "#pod If the last call to address() returned undef, you can call this"
NSQ_SOURCE_LINE 00000640 "#pod method to determine why it failed.  Possible values are:"
NSQ_SOURCE_LINE 00000641 "#pod"
NSQ_SOURCE_LINE 00000642 "#pod  rfc822"
NSQ_SOURCE_LINE 00000643 "#pod  localpart"
NSQ_SOURCE_LINE 00000644 "#pod  local_rules"
NSQ_SOURCE_LINE 00000645 "#pod  fqdn"
NSQ_SOURCE_LINE 00000646 "#pod  mxcheck"
NSQ_SOURCE_LINE 00000647 "#pod  tldcheck"
NSQ_SOURCE_LINE 00000648 "#pod"
NSQ_SOURCE_LINE 00000649 "#pod If the class is not instantiated, you can get the same information"
NSQ_SOURCE_LINE 00000650 "#pod from the global C<$Email::Valid::Details>."
NSQ_SOURCE_LINE 00000651 "#pod"
NSQ_SOURCE_LINE 00000652 "#pod =back"
NSQ_SOURCE_LINE 00000653 "#pod"
NSQ_SOURCE_LINE 00000654 "#pod =head1 EXAMPLES"
NSQ_SOURCE_LINE 00000655 "#pod"
NSQ_SOURCE_LINE 00000656 "#pod Let's see if the address 'maurice@hevanet.com' conforms to the"
NSQ_SOURCE_LINE 00000657 "#pod RFC822 specification:"
NSQ_SOURCE_LINE 00000658 "#pod"
NSQ_SOURCE_LINE 00000659 "#pod   print (Email::Valid->address('maurice@hevanet.com') ? 'yes' : 'no');"
NSQ_SOURCE_LINE 00000660 "#pod"
NSQ_SOURCE_LINE 00000661 "#pod Additionally, let's make sure there's a mail host for it:"
NSQ_SOURCE_LINE 00000662 "#pod"
NSQ_SOURCE_LINE 00000663 "#pod   print (Email::Valid->address( -address => 'maurice@hevanet.com',"
NSQ_SOURCE_LINE 00000664 "#pod                                 -mxcheck => 1 ) ? 'yes' : 'no');"
NSQ_SOURCE_LINE 00000665 "#pod"
NSQ_SOURCE_LINE 00000666 "#pod Let's see an example of how the address may be modified:"
NSQ_SOURCE_LINE 00000667 "#pod"
NSQ_SOURCE_LINE 00000668 "#pod   $addr = Email::Valid->address('Alfred Neuman <Neuman @ foo.bar>');"
NSQ_SOURCE_LINE 00000669 "#pod   print \"$addr\\n\"; # prints Neuman@foo.bar"
NSQ_SOURCE_LINE 00000670 "#pod"
NSQ_SOURCE_LINE 00000671 "#pod Now let's add the check for top level domains:"
NSQ_SOURCE_LINE 00000672 "#pod"
NSQ_SOURCE_LINE 00000673 "#pod   $addr = Email::Valid->address( -address => 'Neuman@foo.bar',"
NSQ_SOURCE_LINE 00000674 "#pod                                  -tldcheck => 1 );"
NSQ_SOURCE_LINE 00000675 "#pod   print \"$addr\\n\"; # doesn't print anything"
NSQ_SOURCE_LINE 00000676 "#pod"
NSQ_SOURCE_LINE 00000677 "#pod Need to determine why an address failed?"
NSQ_SOURCE_LINE 00000678 "#pod"
NSQ_SOURCE_LINE 00000679 "#pod   unless(Email::Valid->address('maurice@hevanet')) {"
NSQ_SOURCE_LINE 00000680 "#pod     print \"address failed $Email::Valid::Details check.\\n\";"
NSQ_SOURCE_LINE 00000681 "#pod   }"
NSQ_SOURCE_LINE 00000682 "#pod"
NSQ_SOURCE_LINE 00000683 "#pod If an error is encountered, an exception is raised.  This is really"
NSQ_SOURCE_LINE 00000684 "#pod only possible when performing DNS queries.  Trap any exceptions by"
NSQ_SOURCE_LINE 00000685 "#pod wrapping the call in an eval block:"
NSQ_SOURCE_LINE 00000686 "#pod"
NSQ_SOURCE_LINE 00000687 "#pod   eval {"
NSQ_SOURCE_LINE 00000688 "#pod     $addr = Email::Valid->address( -address => 'maurice@hevanet.com',"
NSQ_SOURCE_LINE 00000689 "#pod                                    -mxcheck => 1 );"
NSQ_SOURCE_LINE 00000690 "#pod   };"
NSQ_SOURCE_LINE 00000691 "#pod   warn \"an error was encountered: $@\" if $@;"
NSQ_SOURCE_LINE 00000692 "#pod"
NSQ_SOURCE_LINE 00000693 "#pod =head1 CREDITS"
NSQ_SOURCE_LINE 00000694 "#pod"
NSQ_SOURCE_LINE 00000695 "#pod Significant portions of this module are based on the ckaddr program"
NSQ_SOURCE_LINE 00000696 "#pod written by Tom Christiansen and the RFC822 address pattern developed"
NSQ_SOURCE_LINE 00000697 "#pod by Jeffrey Friedl.  Neither were involved in the construction of this"
NSQ_SOURCE_LINE 00000698 "#pod module; all errors are mine."
NSQ_SOURCE_LINE 00000699 "#pod"
NSQ_SOURCE_LINE 00000700 "#pod Thanks very much to the following people for their suggestions and"
NSQ_SOURCE_LINE 00000701 "#pod bug fixes:"
NSQ_SOURCE_LINE 00000702 "#pod"
NSQ_SOURCE_LINE 00000703 "#pod   Otis Gospodnetic <otis@DOMINIS.com>"
NSQ_SOURCE_LINE 00000704 "#pod   Kim Ryan <kimaryan@ozemail.com.au>"
NSQ_SOURCE_LINE 00000705 "#pod   Pete Ehlke <pde@listserv.music.sony.com>"
NSQ_SOURCE_LINE 00000706 "#pod   Lupe Christoph"
NSQ_SOURCE_LINE 00000707 "#pod   David Birnbaum"
NSQ_SOURCE_LINE 00000708 "#pod   Achim"
NSQ_SOURCE_LINE 00000709 "#pod   Elizabeth Mattijsen (liz@dijkmat.nl)"
NSQ_SOURCE_LINE 00000710 "#pod"
NSQ_SOURCE_LINE 00000711 "#pod =head1 SEE ALSO"
NSQ_SOURCE_LINE 00000712 "#pod"
NSQ_SOURCE_LINE 00000713 "#pod L<Mail::Address>, L<Net::DNS>, L<Net::Domain::TLD>, L<perlfaq9|https://metacpan.org/pod/distribution/perlfaq/lib/perlfaq9.pod>"
NSQ_SOURCE_LINE 00000714 "#pod"
NSQ_SOURCE_LINE 00000715 "#pod L<RFC822|https://www.ietf.org/rfc/rfc0822.txt> -"
NSQ_SOURCE_LINE 00000716 "#pod standard for the format of ARPA internet text messages."
NSQ_SOURCE_LINE 00000717 "#pod Superseded by L<RFC2822|https://www.ietf.org/rfc/rfc2822.txt>."
NSQ_SOURCE_LINE 00000718 "#pod"
NSQ_SOURCE_LINE 00000719 "#pod =cut"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "__END__"
NSQ_SOURCE_LINE 00000722 ""
NSQ_SOURCE_LINE 00000723 "=pod"
NSQ_SOURCE_LINE 00000724 ""
NSQ_SOURCE_LINE 00000725 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000726 ""
NSQ_SOURCE_LINE 00000727 "=head1 NAME"
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "Email::Valid - Check validity of Internet email addresses"
NSQ_SOURCE_LINE 00000730 ""
NSQ_SOURCE_LINE 00000731 "=head1 VERSION"
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "version 1.204"
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000736 ""
NSQ_SOURCE_LINE 00000737 "  use Email::Valid;"
NSQ_SOURCE_LINE 00000738 "  my $address = Email::Valid->address('maurice@hevanet.com');"
NSQ_SOURCE_LINE 00000739 "  print ($address ? 'yes' : 'no');"
NSQ_SOURCE_LINE 00000740 ""
NSQ_SOURCE_LINE 00000741 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "This module determines whether an email address is well-formed, and"
NSQ_SOURCE_LINE 00000744 "optionally, whether a mail host exists for the domain."
NSQ_SOURCE_LINE 00000745 ""
NSQ_SOURCE_LINE 00000746 "Please note that there is no way to determine whether an"
NSQ_SOURCE_LINE 00000747 "address is deliverable without attempting delivery"
NSQ_SOURCE_LINE 00000748 "(for details, see L<perlfaq 9|http://perldoc.perl.org/perlfaq9.html#How-do-I-check-a-valid-mail-address>)."
NSQ_SOURCE_LINE 00000749 ""
NSQ_SOURCE_LINE 00000750 "=head1 PERL VERSION"
NSQ_SOURCE_LINE 00000751 ""
NSQ_SOURCE_LINE 00000752 "This library should run on perls released even a long time ago.  It should"
NSQ_SOURCE_LINE 00000753 "work on any version of perl released in the last five years."
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "Although it may work on older versions of perl, no guarantee is made that the"
NSQ_SOURCE_LINE 00000756 "minimum required version will not be increased.  The version may be increased"
NSQ_SOURCE_LINE 00000757 "for any reason, and there is no promise that patches will be accepted to"
NSQ_SOURCE_LINE 00000758 "lower the minimum required perl."
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "=head1 PREREQUISITES"
NSQ_SOURCE_LINE 00000761 ""
NSQ_SOURCE_LINE 00000762 "This module requires perl 5.004 or later and the L<Mail::Address> module."
NSQ_SOURCE_LINE 00000763 "Either the L<Net::DNS> module or the nslookup utility is required"
NSQ_SOURCE_LINE 00000764 "for DNS checks.  The L<Net::Domain::TLD> module is required to check the"
NSQ_SOURCE_LINE 00000765 "validity of top level domains."
NSQ_SOURCE_LINE 00000766 ""
NSQ_SOURCE_LINE 00000767 "=head1 METHODS"
NSQ_SOURCE_LINE 00000768 ""
NSQ_SOURCE_LINE 00000769 "Every method which accepts an C<< <ADDRESS> >> parameter may"
NSQ_SOURCE_LINE 00000770 "be passed either a string or an instance of the Mail::Address"
NSQ_SOURCE_LINE 00000771 "class.  All errors raise an exception."
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "=over 4"
NSQ_SOURCE_LINE 00000774 ""
NSQ_SOURCE_LINE 00000775 "=item new ( [PARAMS] )"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "This method is used to construct an Email::Valid object."
NSQ_SOURCE_LINE 00000778 "It accepts an optional list of named parameters to"
NSQ_SOURCE_LINE 00000779 "control the behavior of the object at instantiation."
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "The following named parameters are allowed.  See the"
NSQ_SOURCE_LINE 00000782 "individual methods below for details."
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 " -mxcheck"
NSQ_SOURCE_LINE 00000785 " -tldcheck"
NSQ_SOURCE_LINE 00000786 " -fudge"
NSQ_SOURCE_LINE 00000787 " -fqdn"
NSQ_SOURCE_LINE 00000788 " -allow_ip"
NSQ_SOURCE_LINE 00000789 " -local_rules"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "=item mx ( <ADDRESS>|<DOMAIN> )"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "This method accepts an email address or domain name and determines"
NSQ_SOURCE_LINE 00000794 "whether a DNS record (A or MX) exists for it."
NSQ_SOURCE_LINE 00000795 ""
NSQ_SOURCE_LINE 00000796 "The method returns true if a record is found and undef if not."
NSQ_SOURCE_LINE 00000797 ""
NSQ_SOURCE_LINE 00000798 "Either the Net::DNS module or the nslookup utility is required for"
NSQ_SOURCE_LINE 00000799 "DNS checks.  Using Net::DNS is the preferred method since error"
NSQ_SOURCE_LINE 00000800 "handling is improved.  If Net::DNS is available, you can modify"
NSQ_SOURCE_LINE 00000801 "the behavior of the resolver (e.g. change the default tcp_timeout"
NSQ_SOURCE_LINE 00000802 "value) by manipulating the global L<Net::DNS::Resolver> instance stored in"
NSQ_SOURCE_LINE 00000803 "C<$Email::Valid::Resolver>."
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "=item rfc822 ( <ADDRESS> )"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "This method determines whether an address conforms to the RFC822"
NSQ_SOURCE_LINE 00000808 "specification (except for nested comments).  It returns true if it"
NSQ_SOURCE_LINE 00000809 "conforms and undef if not."
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "=item fudge ( <TRUE>|<FALSE> )"
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "Specifies whether calls to address() should attempt to correct"
NSQ_SOURCE_LINE 00000814 "common addressing errors.  Currently, this results in the removal of"
NSQ_SOURCE_LINE 00000815 "spaces in AOL addresses, and the conversion of commas to periods in"
NSQ_SOURCE_LINE 00000816 "Compuserve addresses.  The default is false."
NSQ_SOURCE_LINE 00000817 ""
NSQ_SOURCE_LINE 00000818 "=item allow_ip ( <TRUE>|<FALSE> )"
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "Specifies whether a \"domain literal\" is acceptable as the domain part.  That"
NSQ_SOURCE_LINE 00000821 "means addresses like:  C<rjbs@[1.2.3.4]>"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "The checking for the domain literal is stricter than the RFC and looser than"
NSQ_SOURCE_LINE 00000824 "checking for a valid IP address, I<but this is subject to change>."
NSQ_SOURCE_LINE 00000825 ""
NSQ_SOURCE_LINE 00000826 "The default is true."
NSQ_SOURCE_LINE 00000827 ""
NSQ_SOURCE_LINE 00000828 "=item fqdn ( <TRUE>|<FALSE> )"
NSQ_SOURCE_LINE 00000829 ""
NSQ_SOURCE_LINE 00000830 "Specifies whether addresses passed to address() must contain a fully"
NSQ_SOURCE_LINE 00000831 "qualified domain name (FQDN).  The default is true."
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "B<Please note!>  FQDN checks only occur for non-domain-literals.  In other"
NSQ_SOURCE_LINE 00000834 "words, if you have set C<allow_ip> and the address ends in a bracketed IP"
NSQ_SOURCE_LINE 00000835 "address, the FQDN check will not occur."
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "=item tld ( <ADDRESS> )"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "This method determines whether the domain part of an address is in a"
NSQ_SOURCE_LINE 00000840 "recognized top-level domain."
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "B<Please note!>  TLD checks only occur for non-domain-literals.  In other"
NSQ_SOURCE_LINE 00000843 "words, if you have set C<allow_ip> and the address ends in a bracketed IP"
NSQ_SOURCE_LINE 00000844 "address, the TLD check will not occur."
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "=item local_rules ( <TRUE>|<FALSE> )"
NSQ_SOURCE_LINE 00000847 ""
NSQ_SOURCE_LINE 00000848 "Specifies whether addresses passed to address() should be tested"
NSQ_SOURCE_LINE 00000849 "for domain specific restrictions.  Currently, this is limited to"
NSQ_SOURCE_LINE 00000850 "certain AOL restrictions that I'm aware of.  The default is false."
NSQ_SOURCE_LINE 00000851 ""
NSQ_SOURCE_LINE 00000852 "=item mxcheck ( <TRUE>|<FALSE> )"
NSQ_SOURCE_LINE 00000853 ""
NSQ_SOURCE_LINE 00000854 "Specifies whether addresses passed to address() should be checked"
NSQ_SOURCE_LINE 00000855 "for a valid DNS entry.  The default is false."
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "=item tldcheck ( <TRUE>|<FALSE> )"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "Specifies whether addresses passed to address() should be checked"
NSQ_SOURCE_LINE 00000860 "for a valid top level domains.  The default is false."
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "=item address ( <ADDRESS> )"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "This is the primary method which determines whether an email"
NSQ_SOURCE_LINE 00000865 "address is valid.  Its behavior is modified by the values of"
NSQ_SOURCE_LINE 00000866 "mxcheck(), tldcheck(), local_rules(), fqdn(), and fudge().  If the address"
NSQ_SOURCE_LINE 00000867 "passes all checks, the (possibly modified) address is returned as"
NSQ_SOURCE_LINE 00000868 "a string.  Otherwise, undef is returned."
NSQ_SOURCE_LINE 00000869 "In a list context, the method also returns an instance of the"
NSQ_SOURCE_LINE 00000870 "Mail::Address class representing the email address."
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 "=item details ()"
NSQ_SOURCE_LINE 00000873 ""
NSQ_SOURCE_LINE 00000874 "If the last call to address() returned undef, you can call this"
NSQ_SOURCE_LINE 00000875 "method to determine why it failed.  Possible values are:"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 " rfc822"
NSQ_SOURCE_LINE 00000878 " localpart"
NSQ_SOURCE_LINE 00000879 " local_rules"
NSQ_SOURCE_LINE 00000880 " fqdn"
NSQ_SOURCE_LINE 00000881 " mxcheck"
NSQ_SOURCE_LINE 00000882 " tldcheck"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "If the class is not instantiated, you can get the same information"
NSQ_SOURCE_LINE 00000885 "from the global C<$Email::Valid::Details>."
NSQ_SOURCE_LINE 00000886 ""
NSQ_SOURCE_LINE 00000887 "=back"
NSQ_SOURCE_LINE 00000888 ""
NSQ_SOURCE_LINE 00000889 "=head1 EXAMPLES"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "Let's see if the address 'maurice@hevanet.com' conforms to the"
NSQ_SOURCE_LINE 00000892 "RFC822 specification:"
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "  print (Email::Valid->address('maurice@hevanet.com') ? 'yes' : 'no');"
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "Additionally, let's make sure there's a mail host for it:"
NSQ_SOURCE_LINE 00000897 ""
NSQ_SOURCE_LINE 00000898 "  print (Email::Valid->address( -address => 'maurice@hevanet.com',"
NSQ_SOURCE_LINE 00000899 "                                -mxcheck => 1 ) ? 'yes' : 'no');"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "Let's see an example of how the address may be modified:"
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "  $addr = Email::Valid->address('Alfred Neuman <Neuman @ foo.bar>');"
NSQ_SOURCE_LINE 00000904 "  print \"$addr\\n\"; # prints Neuman@foo.bar"
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "Now let's add the check for top level domains:"
NSQ_SOURCE_LINE 00000907 ""
NSQ_SOURCE_LINE 00000908 "  $addr = Email::Valid->address( -address => 'Neuman@foo.bar',"
NSQ_SOURCE_LINE 00000909 "                                 -tldcheck => 1 );"
NSQ_SOURCE_LINE 00000910 "  print \"$addr\\n\"; # doesn't print anything"
NSQ_SOURCE_LINE 00000911 ""
NSQ_SOURCE_LINE 00000912 "Need to determine why an address failed?"
NSQ_SOURCE_LINE 00000913 ""
NSQ_SOURCE_LINE 00000914 "  unless(Email::Valid->address('maurice@hevanet')) {"
NSQ_SOURCE_LINE 00000915 "    print \"address failed $Email::Valid::Details check.\\n\";"
NSQ_SOURCE_LINE 00000916 "  }"
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 "If an error is encountered, an exception is raised.  This is really"
NSQ_SOURCE_LINE 00000919 "only possible when performing DNS queries.  Trap any exceptions by"
NSQ_SOURCE_LINE 00000920 "wrapping the call in an eval block:"
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "  eval {"
NSQ_SOURCE_LINE 00000923 "    $addr = Email::Valid->address( -address => 'maurice@hevanet.com',"
NSQ_SOURCE_LINE 00000924 "                                   -mxcheck => 1 );"
NSQ_SOURCE_LINE 00000925 "  };"
NSQ_SOURCE_LINE 00000926 "  warn \"an error was encountered: $@\" if $@;"
NSQ_SOURCE_LINE 00000927 ""
NSQ_SOURCE_LINE 00000928 "=head1 CREDITS"
NSQ_SOURCE_LINE 00000929 ""
NSQ_SOURCE_LINE 00000930 "Significant portions of this module are based on the ckaddr program"
NSQ_SOURCE_LINE 00000931 "written by Tom Christiansen and the RFC822 address pattern developed"
NSQ_SOURCE_LINE 00000932 "by Jeffrey Friedl.  Neither were involved in the construction of this"
NSQ_SOURCE_LINE 00000933 "module; all errors are mine."
NSQ_SOURCE_LINE 00000934 ""
NSQ_SOURCE_LINE 00000935 "Thanks very much to the following people for their suggestions and"
NSQ_SOURCE_LINE 00000936 "bug fixes:"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "  Otis Gospodnetic <otis@DOMINIS.com>"
