NSQ_SOURCE_LINE 00000940 "  Pete Ehlke <pde@listserv.music.sony.com>"
NSQ_SOURCE_LINE 00000941 "  Lupe Christoph"
NSQ_SOURCE_LINE 00000942 "  David Birnbaum"
NSQ_SOURCE_LINE 00000943 "  Achim"
NSQ_SOURCE_LINE 00000944 "  Elizabeth Mattijsen (liz@dijkmat.nl)"
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "L<Mail::Address>, L<Net::DNS>, L<Net::Domain::TLD>, L<perlfaq9|https://metacpan.org/pod/distribution/perlfaq/lib/perlfaq9.pod>"
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "L<RFC822|https://www.ietf.org/rfc/rfc0822.txt> -"
NSQ_SOURCE_LINE 00000951 "standard for the format of ARPA internet text messages."
NSQ_SOURCE_LINE 00000952 "Superseded by L<RFC2822|https://www.ietf.org/rfc/rfc2822.txt>."
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "Maurice Aubrey <maurice@hevanet.com>"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "=head1 CONTRIBUTORS"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "=for stopwords Alexandr Ciornii Arne Johannessen Dan Book Gene Hightower James E Keenan Karel Miko McA Michael Schout Mohammad S Anwar Neil Bowers Ricardo Signes Steve Bertrand Svetlana Troy Morehouse Yanick Champoux"
NSQ_SOURCE_LINE 00000961 ""
NSQ_SOURCE_LINE 00000962 "=over 4"
NSQ_SOURCE_LINE 00000963 ""
NSQ_SOURCE_LINE 00000964 "=item *"
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "Alexandr Ciornii <alexchorny@gmail.com>"
NSQ_SOURCE_LINE 00000967 ""
NSQ_SOURCE_LINE 00000968 "=item *"
NSQ_SOURCE_LINE 00000969 ""
NSQ_SOURCE_LINE 00000970 "Arne Johannessen <ajnn@cpan.org>"
NSQ_SOURCE_LINE 00000971 ""
NSQ_SOURCE_LINE 00000972 "=item *"
NSQ_SOURCE_LINE 00000973 ""
NSQ_SOURCE_LINE 00000974 "Dan Book <grinnz@gmail.com>"
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "=item *"
NSQ_SOURCE_LINE 00000977 ""
NSQ_SOURCE_LINE 00000978 "Gene Hightower <gene@digilicious.com>"
NSQ_SOURCE_LINE 00000979 ""
NSQ_SOURCE_LINE 00000980 "=item *"
NSQ_SOURCE_LINE 00000981 ""
NSQ_SOURCE_LINE 00000982 "James E Keenan <jkeenan@cpan.org>"
NSQ_SOURCE_LINE 00000983 ""
NSQ_SOURCE_LINE 00000984 "=item *"
NSQ_SOURCE_LINE 00000985 ""
NSQ_SOURCE_LINE 00000986 "Karel Miko <karel.miko@gmail.com>"
NSQ_SOURCE_LINE 00000987 ""
NSQ_SOURCE_LINE 00000988 "=item *"
NSQ_SOURCE_LINE 00000989 ""
NSQ_SOURCE_LINE 00000990 "McA <McA@github.com>"
NSQ_SOURCE_LINE 00000991 ""
