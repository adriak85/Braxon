NSQ_SOURCE_LINE 00000001 "require 5.006;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 "package Email::Valid 1.204;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "# ABSTRACT: Check validity of Internet email addresses"
NSQ_SOURCE_LINE 00000007 "our ("
NSQ_SOURCE_LINE 00000008 "  $RFC822PAT,"
NSQ_SOURCE_LINE 00000009 "  $Details, $Resolver, $Nslookup_Path,"
NSQ_SOURCE_LINE 00000010 "  $Debug,"
NSQ_SOURCE_LINE 00000011 ");"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "use Carp;"
NSQ_SOURCE_LINE 00000014 "use IO::File;"
NSQ_SOURCE_LINE 00000015 "use Mail::Address;"
NSQ_SOURCE_LINE 00000016 "use File::Spec;"
NSQ_SOURCE_LINE 00000017 "use Scalar::Util 'blessed';"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "our %AUTOLOAD = ("
NSQ_SOURCE_LINE 00000020 "  allow_ip => 1,"
NSQ_SOURCE_LINE 00000021 "  fqdn     => 1,"
NSQ_SOURCE_LINE 00000022 "  fudge    => 1,"
NSQ_SOURCE_LINE 00000023 "  mxcheck  => 1,"
NSQ_SOURCE_LINE 00000024 "  tldcheck => 1,"
NSQ_SOURCE_LINE 00000025 "  local_rules => 1,"
NSQ_SOURCE_LINE 00000026 "  localpart => 1,"
NSQ_SOURCE_LINE 00000027 ");"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "our $NSLOOKUP_PAT = 'preference|serial|expire|mail\\s+exchanger';"
NSQ_SOURCE_LINE 00000030 "our @NSLOOKUP_PATHS = File::Spec->path();"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "# initialize if already loaded, better in prefork mod_perl environment"
NSQ_SOURCE_LINE 00000033 "our $DNS_Method = defined $Net::DNS::VERSION ? 'Net::DNS' : '';"
NSQ_SOURCE_LINE 00000034 "unless ($DNS_Method) {"
NSQ_SOURCE_LINE 00000035 "    __PACKAGE__->_select_dns_method;"
NSQ_SOURCE_LINE 00000036 "}"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "# initialize $Resolver if necessary"
NSQ_SOURCE_LINE 00000039 "if ($DNS_Method eq 'Net::DNS') {"
NSQ_SOURCE_LINE 00000040 "    unless (defined $Resolver) {"
NSQ_SOURCE_LINE 00000041 "        $Resolver = Net::DNS::Resolver->new;"
NSQ_SOURCE_LINE 00000042 "    }"
NSQ_SOURCE_LINE 00000043 "}"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "sub new {"
NSQ_SOURCE_LINE 00000046 "  my $class   = shift;"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "  $class = ref $class || $class;"
NSQ_SOURCE_LINE 00000049 "  bless my $self = {}, $class;"
NSQ_SOURCE_LINE 00000050 "  $self->_initialize;"
NSQ_SOURCE_LINE 00000051 "  %$self = $self->_rearrange([ keys %AUTOLOAD ], \\@_);"
NSQ_SOURCE_LINE 00000052 "  return $self;"
NSQ_SOURCE_LINE 00000053 "}"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "sub _initialize {"
NSQ_SOURCE_LINE 00000056 "  my $self = shift;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "  $self->{mxcheck}     = 0;"
NSQ_SOURCE_LINE 00000059 "  $self->{tldcheck}    = 0;"
NSQ_SOURCE_LINE 00000060 "  $self->{fudge}       = 0;"
NSQ_SOURCE_LINE 00000061 "  $self->{fqdn}        = 1;"
NSQ_SOURCE_LINE 00000062 "  $self->{allow_ip}    = 1;"
NSQ_SOURCE_LINE 00000063 "  $self->{local_rules} = 0;"
NSQ_SOURCE_LINE 00000064 "  $self->{localpart}   = 1;"
NSQ_SOURCE_LINE 00000065 "  $self->{details}     = $Details = undef;"
NSQ_SOURCE_LINE 00000066 "}"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "# Pupose: handles named parameter calling style"
NSQ_SOURCE_LINE 00000069 "sub _rearrange {"
NSQ_SOURCE_LINE 00000070 "  my $self = shift;"
NSQ_SOURCE_LINE 00000071 "  my(@names)  = @{ shift() };"
NSQ_SOURCE_LINE 00000072 "  my(@params) = @{ shift() };"
NSQ_SOURCE_LINE 00000073 "  my(%args);"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "  ref $self ? %args = %$self : _initialize( \\%args );"
NSQ_SOURCE_LINE 00000076 "  return %args unless @params;"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "  unless (@params > 1 and $params[0] =~ /^-/) {"
NSQ_SOURCE_LINE 00000079 "    while(@params) {"
NSQ_SOURCE_LINE 00000080 "      croak 'unexpected number of parameters' unless @names;"
NSQ_SOURCE_LINE 00000081 "      $args{ lc shift @names } = shift @params;"
NSQ_SOURCE_LINE 00000082 "    }"
NSQ_SOURCE_LINE 00000083 "    return %args;"
NSQ_SOURCE_LINE 00000084 "  }"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "  while(@params) {"
NSQ_SOURCE_LINE 00000087 "    my $param = lc substr(shift @params, 1);"
NSQ_SOURCE_LINE 00000088 "    $args{ $param } = shift @params;"
NSQ_SOURCE_LINE 00000089 "  }"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "  %args;"
NSQ_SOURCE_LINE 00000092 "}"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "# Purpose: determine why an address failed a check"
NSQ_SOURCE_LINE 00000095 "sub details {"
NSQ_SOURCE_LINE 00000096 "  my $self = shift;"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "  return (ref $self ? $self->{details} : $Details) unless @_;"
NSQ_SOURCE_LINE 00000099 "  $Details = shift;"
NSQ_SOURCE_LINE 00000100 "  $self->{details} = $Details if ref $self;"
NSQ_SOURCE_LINE 00000101 "  return undef;"
NSQ_SOURCE_LINE 00000102 "}"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "# Purpose: Check whether address conforms to RFC 822 syntax."
NSQ_SOURCE_LINE 00000105 "sub rfc822 {"
NSQ_SOURCE_LINE 00000106 "  my $self = shift;"
NSQ_SOURCE_LINE 00000107 "  my %args = $self->_rearrange([qw( address )], \\@_);"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "  my $addr = $args{address} or return $self->details('rfc822');"
NSQ_SOURCE_LINE 00000110 "  $addr = $addr->address if (blessed($addr) && $addr->isa('Mail::Address'));"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "  return $self->details('rfc822')"
NSQ_SOURCE_LINE 00000113 "    if $addr =~ /\\P{ASCII}/ or $addr !~ m/^$RFC822PAT$/o;"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "  return 1;"
NSQ_SOURCE_LINE 00000116 "}"
NSQ_SOURCE_LINE 00000117 ""
NSQ_SOURCE_LINE 00000118 "# Purpose: attempt to locate the nslookup utility"
NSQ_SOURCE_LINE 00000119 "sub _find_nslookup {"
NSQ_SOURCE_LINE 00000120 "  my $self = shift;"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "  my $ns = 'nslookup';"
NSQ_SOURCE_LINE 00000123 "  foreach my $path (@NSLOOKUP_PATHS) {"
NSQ_SOURCE_LINE 00000124 "    my $file = File::Spec->catfile($path, $ns);"
NSQ_SOURCE_LINE 00000125 "    return \"$file.exe\" if ($^O eq 'MSWin32') and -x \"$file.exe\" and !-d _;"
NSQ_SOURCE_LINE 00000126 "    return $file if -x $file and !-d _;"
NSQ_SOURCE_LINE 00000127 "  }"
NSQ_SOURCE_LINE 00000128 "  return undef;"
NSQ_SOURCE_LINE 00000129 "}"
NSQ_SOURCE_LINE 00000130 ""
NSQ_SOURCE_LINE 00000131 "sub _select_dns_method {"
NSQ_SOURCE_LINE 00000132 "  # Configure a global resolver object for DNS queries"
NSQ_SOURCE_LINE 00000133 "  # if Net::DNS is available"
NSQ_SOURCE_LINE 00000134 "  eval { require Net::DNS };"
NSQ_SOURCE_LINE 00000135 "  return $DNS_Method = 'Net::DNS' unless $@;"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "  $DNS_Method = 'nslookup';"
NSQ_SOURCE_LINE 00000138 "}"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "# Purpose: perform DNS query using the Net::DNS module"
NSQ_SOURCE_LINE 00000141 "sub _net_dns_query {"
NSQ_SOURCE_LINE 00000142 "  my $self = shift;"
NSQ_SOURCE_LINE 00000143 "  my $host = shift;"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "  $Resolver = Net::DNS::Resolver->new unless defined $Resolver;"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "  my @mx_entries = Net::DNS::mx($Resolver, $host);"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "  # Check for valid MX records for $host"
NSQ_SOURCE_LINE 00000150 "  if (@mx_entries) {"
NSQ_SOURCE_LINE 00000151 "    # Check for RFC-7505 Null MX"
NSQ_SOURCE_LINE 00000152 "    my $nmx = scalar @mx_entries;"
NSQ_SOURCE_LINE 00000153 "    if ($nmx == 1 && $mx_entries[0]->exchange eq '.') {"
NSQ_SOURCE_LINE 00000154 "      return $self->details('mx');"
NSQ_SOURCE_LINE 00000155 "    }"
NSQ_SOURCE_LINE 00000156 "    foreach my $mx (@mx_entries) {"
NSQ_SOURCE_LINE 00000157 "      my $mxhost = $mx->exchange;"
NSQ_SOURCE_LINE 00000158 "      my $query  = $Resolver->search($mxhost);"
NSQ_SOURCE_LINE 00000159 "      next unless ($query);"
NSQ_SOURCE_LINE 00000160 "      foreach my $a_rr ($query->answer) {"
NSQ_SOURCE_LINE 00000161 "        return 1 unless $a_rr->type ne 'A';"
NSQ_SOURCE_LINE 00000162 "      }"
NSQ_SOURCE_LINE 00000163 "    }"
NSQ_SOURCE_LINE 00000164 "  }"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "  # Check for A record for $host"
NSQ_SOURCE_LINE 00000167 "  my $ans   = $Resolver->query($host, 'A');"
NSQ_SOURCE_LINE 00000168 "  my @a_rrs = $ans ? $ans->answer : ();"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "  if (@a_rrs) {"
NSQ_SOURCE_LINE 00000171 "    foreach my $a_rr (@a_rrs) {"
NSQ_SOURCE_LINE 00000172 "      return 1 unless $a_rr->type ne 'A';"
NSQ_SOURCE_LINE 00000173 "    }"
NSQ_SOURCE_LINE 00000174 "  }"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "  # MX Check failed"
NSQ_SOURCE_LINE 00000177 "  return $self->details('mx');"
NSQ_SOURCE_LINE 00000178 "}"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "# Purpose: perform DNS query using the nslookup utility"
NSQ_SOURCE_LINE 00000181 "sub _nslookup_query {"
NSQ_SOURCE_LINE 00000182 "  my $self = shift;"
NSQ_SOURCE_LINE 00000183 "  my $host = shift;"
NSQ_SOURCE_LINE 00000184 "  local($/, *OLDERR);"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "  unless ($Nslookup_Path) {"
NSQ_SOURCE_LINE 00000187 "    $Nslookup_Path = $self->_find_nslookup"
NSQ_SOURCE_LINE 00000188 "      or croak 'unable to locate nslookup';"
NSQ_SOURCE_LINE 00000189 "  }"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "  # Check for an A record"
NSQ_SOURCE_LINE 00000192 "  return 1 if gethostbyname $host;"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "  # Check for an MX record"
NSQ_SOURCE_LINE 00000195 "  if ($^O eq 'MSWin32' or $^O eq 'Cygwin') {"
NSQ_SOURCE_LINE 00000196 "    # Oh no, we're on Windows!"
NSQ_SOURCE_LINE 00000197 "    require Capture::Tiny;"
NSQ_SOURCE_LINE 00000198 "    my $response = Capture::Tiny::capture_stdout {"
NSQ_SOURCE_LINE 00000199 "     $Nslookup_Path, '-query=mx', $host"
NSQ_SOURCE_LINE 00000200 "    };"
NSQ_SOURCE_LINE 00000201 "    croak \"unable to execute nslookup '$Nslookup_Path': exit $?\" if $?;"
NSQ_SOURCE_LINE 00000202 "    print STDERR $response if $Debug;"
NSQ_SOURCE_LINE 00000203 "    $response =~ /$NSLOOKUP_PAT/io or return $self->details('mx');"
NSQ_SOURCE_LINE 00000204 "    return 1;"
NSQ_SOURCE_LINE 00000205 "  } else {"
NSQ_SOURCE_LINE 00000206 "    # phew, we're not on Windows!"
NSQ_SOURCE_LINE 00000207 "    if (my $fh = IO::File->new('-|')) {"
NSQ_SOURCE_LINE 00000208 "      my $response = <$fh>;"
NSQ_SOURCE_LINE 00000209 "      print STDERR $response if $Debug;"
NSQ_SOURCE_LINE 00000210 "      close $fh;"
NSQ_SOURCE_LINE 00000211 "      $response =~ /$NSLOOKUP_PAT/io or return $self->details('mx');"
NSQ_SOURCE_LINE 00000212 "      return 1;"
NSQ_SOURCE_LINE 00000213 "    } else {"
NSQ_SOURCE_LINE 00000214 "      open OLDERR, '>&STDERR' or croak \"cannot dup stderr: $!\";"
NSQ_SOURCE_LINE 00000215 "      open STDERR, '>&STDOUT' or croak \"cannot redirect stderr to stdout: $!\";"
NSQ_SOURCE_LINE 00000216 "      {"
NSQ_SOURCE_LINE 00000217 "        exec $Nslookup_Path, '-query=mx', $host;"
NSQ_SOURCE_LINE 00000218 "      }"
NSQ_SOURCE_LINE 00000219 "      open STDERR, \">&OLDERR\";"
NSQ_SOURCE_LINE 00000220 "      croak \"unable to execute nslookup '$Nslookup_Path': $!\";"
NSQ_SOURCE_LINE 00000221 "    }"
NSQ_SOURCE_LINE 00000222 "  }"
NSQ_SOURCE_LINE 00000223 "}"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "# Purpose: Check whether a top level domain is valid for a domain."
NSQ_SOURCE_LINE 00000226 "sub tld {"
NSQ_SOURCE_LINE 00000227 "  my $self = shift;"
NSQ_SOURCE_LINE 00000228 "  my %args = $self->_rearrange([qw( address )], \\@_);"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "  unless (eval {require Net::Domain::TLD; Net::Domain::TLD->VERSION(1.65); 1}) {"
NSQ_SOURCE_LINE 00000231 "    die \"Net::Domain::TLD not available\";"
NSQ_SOURCE_LINE 00000232 "  }"
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "  my $host = $self->_host( $args{address} or return $self->details('tld') );"
NSQ_SOURCE_LINE 00000235 "  my ($tld) = $host =~ m#\\.(\\w+)$#;"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "  my %invalid_tlds = map { $_ => 1 } qw(invalid test example localhost);"
NSQ_SOURCE_LINE 00000238 ""
NSQ_SOURCE_LINE 00000239 "  return defined $invalid_tlds{$tld} ? 0 : Net::Domain::TLD::tld_exists($tld);"
NSQ_SOURCE_LINE 00000240 "}"
NSQ_SOURCE_LINE 00000241 ""
NSQ_SOURCE_LINE 00000242 "# Purpose: Check whether a DNS record (A or MX) exists for a domain."
NSQ_SOURCE_LINE 00000243 "sub mx {"
NSQ_SOURCE_LINE 00000244 "  my $self = shift;"
NSQ_SOURCE_LINE 00000245 "  my %args = $self->_rearrange([qw( address )], \\@_);"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "  my $host = $self->_host($args{address}) or return $self->details('mx');"
NSQ_SOURCE_LINE 00000248 ""
NSQ_SOURCE_LINE 00000249 "  $self->_select_dns_method unless $DNS_Method;"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "  if ($DNS_Method eq 'Net::DNS') {"
NSQ_SOURCE_LINE 00000252 "    print STDERR \"using Net::DNS for dns query\\n\" if $Debug;"
NSQ_SOURCE_LINE 00000253 "    return $self->_net_dns_query( $host );"
NSQ_SOURCE_LINE 00000254 "  } elsif ($DNS_Method eq 'nslookup') {"
NSQ_SOURCE_LINE 00000255 "    print STDERR \"using nslookup for dns query\\n\" if $Debug;"
NSQ_SOURCE_LINE 00000256 "    return $self->_nslookup_query( $host );"
NSQ_SOURCE_LINE 00000257 "  } else {"
NSQ_SOURCE_LINE 00000258 "    croak \"unknown DNS method '$DNS_Method'\";"
NSQ_SOURCE_LINE 00000259 "  }"
NSQ_SOURCE_LINE 00000260 "}"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "# Purpose: convert address to host"
NSQ_SOURCE_LINE 00000263 "# Returns: host"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "sub _host {"
NSQ_SOURCE_LINE 00000266 "  my $self = shift;"
NSQ_SOURCE_LINE 00000267 "  my $addr = shift;"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "  $addr = $addr->address if (blessed($addr) && $addr->isa('Mail::Address'));"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "  my $host = ($addr =~ /^.*@(.*)$/ ? $1 : $addr);"
NSQ_SOURCE_LINE 00000272 "  $host =~ s/\\s+//g;"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "  # REMOVE BRACKETS IF IT'S A DOMAIN-LITERAL"
NSQ_SOURCE_LINE 00000275 "  #   RFC822 3.4.6"
NSQ_SOURCE_LINE 00000276 "  #   Square brackets (\"[\" and \"]\") are used to indicate the"
NSQ_SOURCE_LINE 00000277 "  #   presence of a domain-literal, which the appropriate"
NSQ_SOURCE_LINE 00000278 "  #   name-domain is to use directly, bypassing normal"
NSQ_SOURCE_LINE 00000279 "  #   name-resolution mechanisms."
NSQ_SOURCE_LINE 00000280 "  $host =~ s/(^\\[)|(\\]$)//g;"
NSQ_SOURCE_LINE 00000281 "  $host;"
NSQ_SOURCE_LINE 00000282 "}"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "# Purpose: Fix common addressing errors"
NSQ_SOURCE_LINE 00000285 "# Returns: Possibly modified address"
NSQ_SOURCE_LINE 00000286 "sub _fudge {"
NSQ_SOURCE_LINE 00000287 "  my $self = shift;"
NSQ_SOURCE_LINE 00000288 "  my $addr = shift;"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "  $addr =~ s/\\s+//g if $addr =~ /aol\\.com$/i;"
NSQ_SOURCE_LINE 00000291 "  $addr =~ s/,/./g  if $addr =~ /compuserve\\.com$/i;"
NSQ_SOURCE_LINE 00000292 "  $addr;"
NSQ_SOURCE_LINE 00000293 "}"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "# Purpose: Special address restrictions on a per-domain basis."
NSQ_SOURCE_LINE 00000296 "# Caveats: These organizations may change their rules at any time."
NSQ_SOURCE_LINE 00000297 "sub _local_rules {"
NSQ_SOURCE_LINE 00000298 "  my $self = shift;"
NSQ_SOURCE_LINE 00000299 "  my($user, $host) = @_;"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "  1;"
NSQ_SOURCE_LINE 00000302 "}"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "sub _valid_local_part {"
NSQ_SOURCE_LINE 00000305 "  my ($self, $localpart) = @_;"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "  return 0 unless defined $localpart and length $localpart <= 64;"
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "  return 1;"
NSQ_SOURCE_LINE 00000310 "}"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "sub _valid_domain_parts {"
NSQ_SOURCE_LINE 00000313 "  my ($self, $string) = @_;"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "  return unless $string and length $string <= 255;"
NSQ_SOURCE_LINE 00000316 "  return if $string =~ /\\.\\./;"
NSQ_SOURCE_LINE 00000317 "  my @labels = split /\\./, $string;"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "  for my $label (@labels) {"
NSQ_SOURCE_LINE 00000320 "    return 0 unless $self->_is_domain_label($label);"
NSQ_SOURCE_LINE 00000321 "  }"
NSQ_SOURCE_LINE 00000322 "  return scalar @labels;"
NSQ_SOURCE_LINE 00000323 "}"
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "sub _is_domain_label {"
NSQ_SOURCE_LINE 00000326 "  my ($self, $string) = @_;"
NSQ_SOURCE_LINE 00000327 "  return unless $string =~ /\\A"
NSQ_SOURCE_LINE 00000328 "    [A-Z0-9]          # must start with an alnum"
NSQ_SOURCE_LINE 00000329 "    (?:"
NSQ_SOURCE_LINE 00000330 "      [-A-Z0-9]*      # then maybe a dash or alnum"
NSQ_SOURCE_LINE 00000331 "      [A-Z0-9]        # finally ending with an alnum"
NSQ_SOURCE_LINE 00000332 "    )?                # lather, rinse, repeat"
NSQ_SOURCE_LINE 00000333 "  \\z/ix;"
NSQ_SOURCE_LINE 00000334 "  return 1;"
NSQ_SOURCE_LINE 00000335 "}"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "# Purpose: Put an address through a series of checks to determine"
NSQ_SOURCE_LINE 00000338 "#          whether it should be considered valid."
NSQ_SOURCE_LINE 00000339 "sub address {"
NSQ_SOURCE_LINE 00000340 "  my $self = shift;"
NSQ_SOURCE_LINE 00000341 "  my %args = $self->_rearrange([qw( address fudge mxcheck tldcheck fqdn"
NSQ_SOURCE_LINE 00000342 "                                    local_rules )], \\@_);"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "  my $addr = $args{address} or return $self->details('rfc822');"
NSQ_SOURCE_LINE 00000345 "  $addr = $addr->address if (blessed($addr) && $addr->isa('Mail::Address'));"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "  $addr = $self->_fudge( $addr ) if $args{fudge};"
NSQ_SOURCE_LINE 00000348 "  $self->rfc822( -address => $addr ) or return undef;"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "  ($addr) = Mail::Address->parse( $addr );"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "  $addr or return $self->details('rfc822'); # This should never happen"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "  if (length($addr->address) > 254) {"
NSQ_SOURCE_LINE 00000355 "    return $self->details('address_too_long');"
NSQ_SOURCE_LINE 00000356 "  }"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "  if ($args{local_rules}) {"
NSQ_SOURCE_LINE 00000359 "    $self->_local_rules( $addr->user, $addr->host )"
NSQ_SOURCE_LINE 00000360 "      or return $self->details('local_rules');"
NSQ_SOURCE_LINE 00000361 "  }"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "  if ($args{localpart}) {"
NSQ_SOURCE_LINE 00000364 "    $self->_valid_local_part($addr->user) > 0"
NSQ_SOURCE_LINE 00000365 "      or return $self->details('localpart');"
NSQ_SOURCE_LINE 00000366 "  }"
NSQ_SOURCE_LINE 00000367 ""
NSQ_SOURCE_LINE 00000368 "  my $ip_ok = $args{allow_ip} && $addr->host =~ /\\A\\["
NSQ_SOURCE_LINE 00000369 "    (?:[0-9]{1,3}\\.){3}[0-9]{1,3}"
NSQ_SOURCE_LINE 00000370 "  /x;"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "  if (! $ip_ok && $args{fqdn}) {"
NSQ_SOURCE_LINE 00000373 "    my $domain_parts = $self->_valid_domain_parts($addr->host);"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 "    return $self->details('fqdn')"
NSQ_SOURCE_LINE 00000376 "      unless $ip_ok || ($domain_parts && $domain_parts > 1);"
NSQ_SOURCE_LINE 00000377 "  }"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "  if (! $ip_ok && $args{tldcheck}) {"
NSQ_SOURCE_LINE 00000380 "    $self->tld( $addr->host ) or return $self->details('tldcheck');"
NSQ_SOURCE_LINE 00000381 "  }"
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "  if ($args{mxcheck}) {"
NSQ_SOURCE_LINE 00000384 "    # I'm not sure this ->details call is needed, but I'll test for it later."
NSQ_SOURCE_LINE 00000385 "    # The whole ->details thing is... weird. -- rjbs, 2006-06-08"
NSQ_SOURCE_LINE 00000386 "    $self->mx( $addr->host ) or return $self->details('mxcheck');"
NSQ_SOURCE_LINE 00000387 "  }"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "  return (wantarray ? ($addr->address, $addr) : $addr->address);"
NSQ_SOURCE_LINE 00000390 "}"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "sub AUTOLOAD {"
NSQ_SOURCE_LINE 00000393 "  my $self = shift;"
NSQ_SOURCE_LINE 00000394 "  my $type = ref($self) || die \"$self is not an object\";"
NSQ_SOURCE_LINE 00000395 "  my $name = our $AUTOLOAD;"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "  $name =~ s/.*://;"
NSQ_SOURCE_LINE 00000398 "  return if $name eq 'DESTROY';"
NSQ_SOURCE_LINE 00000399 "  die \"unknown autoload name '$name'\" unless $AUTOLOAD{$name};"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "  return (@_ ? $self->{$name} = shift : $self->{$name});"
NSQ_SOURCE_LINE 00000402 "}"
NSQ_SOURCE_LINE 00000403 ""
