NSQ_SOURCE_LINE 00000001 "use 5.008001;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "package Path::Iterator::Rule;"
NSQ_SOURCE_LINE 00000006 "# ABSTRACT: Iterative, recursive file finder"
NSQ_SOURCE_LINE 00000007 "our $VERSION = '1.015';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "# Register warnings category"
NSQ_SOURCE_LINE 00000010 "use warnings::register;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "use if $] ge '5.010000', 're', 'regexp_pattern';"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "# Dependencies"
NSQ_SOURCE_LINE 00000015 "use Carp           ();"
NSQ_SOURCE_LINE 00000016 "use File::Basename ();"
NSQ_SOURCE_LINE 00000017 "use File::Spec     ();"
NSQ_SOURCE_LINE 00000018 "use List::Util     ();"
NSQ_SOURCE_LINE 00000019 "use Number::Compare 0.02;"
NSQ_SOURCE_LINE 00000020 "use Scalar::Util ();"
NSQ_SOURCE_LINE 00000021 "use Text::Glob   ();"
NSQ_SOURCE_LINE 00000022 "use Try::Tiny;"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000025 "# constructors and meta methods"
NSQ_SOURCE_LINE 00000026 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "sub new {"
NSQ_SOURCE_LINE 00000029 "    my $class = shift;"
NSQ_SOURCE_LINE 00000030 "    $class = ref $class if ref $class;"
NSQ_SOURCE_LINE 00000031 "    return bless { rules => [] }, $class;"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "sub clone {"
NSQ_SOURCE_LINE 00000035 "    my $self = shift;"
NSQ_SOURCE_LINE 00000036 "    return bless _my_clone( {%$self} ), ref $self;"
NSQ_SOURCE_LINE 00000037 "}"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "# avoid XS/buggy dependencies for a simple recursive clone; we clone"
NSQ_SOURCE_LINE 00000040 "# fully instead of just 'rules' in case we get subclassed and they"
NSQ_SOURCE_LINE 00000041 "# add attributes"
NSQ_SOURCE_LINE 00000042 "sub _my_clone {"
NSQ_SOURCE_LINE 00000043 "    my $d = shift;"
NSQ_SOURCE_LINE 00000044 "    if ( ref $d eq 'HASH' ) {"
NSQ_SOURCE_LINE 00000045 "        return {"
NSQ_SOURCE_LINE 00000046 "            map { ; my $v = $d->{$_}; $_ => ( ref($v) ? _my_clone($v) : $v ) }"
NSQ_SOURCE_LINE 00000047 "              keys %$d"
NSQ_SOURCE_LINE 00000048 "        };"
NSQ_SOURCE_LINE 00000049 "    }"
NSQ_SOURCE_LINE 00000050 "    elsif ( ref $d eq 'ARRAY' ) {"
NSQ_SOURCE_LINE 00000051 "        return [ map { ref($_) ? _my_clone($_) : $_ } @$d ];"
NSQ_SOURCE_LINE 00000052 "    }"
NSQ_SOURCE_LINE 00000053 "    else {"
NSQ_SOURCE_LINE 00000054 "        return $d;"
NSQ_SOURCE_LINE 00000055 "    }"
NSQ_SOURCE_LINE 00000056 "}"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "sub add_helper {"
NSQ_SOURCE_LINE 00000059 "    my ( $class, $name, $coderef, $skip_negation ) = @_;"
NSQ_SOURCE_LINE 00000060 "    $class = ref $class if ref $class;"
NSQ_SOURCE_LINE 00000061 "    if ( !$class->can($name) ) {"
NSQ_SOURCE_LINE 00000062 "        no strict 'refs'; ## no critic"
NSQ_SOURCE_LINE 00000063 "        *$name = sub {"
NSQ_SOURCE_LINE 00000064 "            my $self = shift;"
NSQ_SOURCE_LINE 00000065 "            my $rule = $coderef->(@_);"
NSQ_SOURCE_LINE 00000066 "            $self->and($rule);"
NSQ_SOURCE_LINE 00000067 "        };"
NSQ_SOURCE_LINE 00000068 "        if ( !$skip_negation ) {"
NSQ_SOURCE_LINE 00000069 "            *{\"not_$name\"} = sub {"
NSQ_SOURCE_LINE 00000070 "                my $self = shift;"
NSQ_SOURCE_LINE 00000071 "                my $rule = $coderef->(@_);"
NSQ_SOURCE_LINE 00000072 "                $self->not($rule);"
NSQ_SOURCE_LINE 00000073 "            };"
NSQ_SOURCE_LINE 00000074 "        }"
NSQ_SOURCE_LINE 00000075 "    }"
NSQ_SOURCE_LINE 00000076 "    else {"
NSQ_SOURCE_LINE 00000077 "        Carp::croak(\"Can't add rule '$name' because it conflicts with an existing method\");"
NSQ_SOURCE_LINE 00000078 "    }"
NSQ_SOURCE_LINE 00000079 "}"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000082 "# Implementation-specific method; these may be overridden by subclasses"
NSQ_SOURCE_LINE 00000083 "# to test/return results of file wrappers like Path::Class or IO::All"
NSQ_SOURCE_LINE 00000084 "# or to provide custom error handler, visitors or other features"
NSQ_SOURCE_LINE 00000085 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "sub _objectify {"
NSQ_SOURCE_LINE 00000088 "    my ( $self, $path ) = @_;"
NSQ_SOURCE_LINE 00000089 "    return \"$path\";"
NSQ_SOURCE_LINE 00000090 "}"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "## We inline this below, but a subclass equivalent would be this:"
NSQ_SOURCE_LINE 00000093 "##sub _children {"
NSQ_SOURCE_LINE 00000094 "##    my $self = shift;"
NSQ_SOURCE_LINE 00000095 "##    my $path = \"\" . shift; # stringify objects"
NSQ_SOURCE_LINE 00000096 "##    opendir( my $dh, $path );"
NSQ_SOURCE_LINE 00000097 "##    return map { [ $_, \"$path/$_\" ] } grep { $_ ne \".\" && $_ ne \"..\" } readdir $dh;"
NSQ_SOURCE_LINE 00000098 "##}"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "# The _stringify option controls whether the string form of an object is cached"
NSQ_SOURCE_LINE 00000101 "# for iteration control.  This is generally a good idea to avoid extra overhead,"
NSQ_SOURCE_LINE 00000102 "# but subclasses can override this if necessary"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "sub _defaults {"
NSQ_SOURCE_LINE 00000105 "    return ("
NSQ_SOURCE_LINE 00000106 "        _stringify      => 1,"
NSQ_SOURCE_LINE 00000107 "        follow_symlinks => 1,"
NSQ_SOURCE_LINE 00000108 "        depthfirst      => 0,"
NSQ_SOURCE_LINE 00000109 "        sorted          => 1,"
NSQ_SOURCE_LINE 00000110 "        loop_safe       => ( $^O eq 'MSWin32' ? 0 : 1 ),       # No inode #'s on Windows"
NSQ_SOURCE_LINE 00000111 "        error_handler   => sub { die sprintf( \"%s: %s\", @_ ) },"
NSQ_SOURCE_LINE 00000112 "        visitor         => undef,"
NSQ_SOURCE_LINE 00000113 "    );"
NSQ_SOURCE_LINE 00000114 "}"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "sub _fast_defaults {"
NSQ_SOURCE_LINE 00000117 "    return ("
NSQ_SOURCE_LINE 00000118 "        _stringify      => 1,"
NSQ_SOURCE_LINE 00000119 "        follow_symlinks => 1,"
NSQ_SOURCE_LINE 00000120 "        depthfirst      => -1,"
NSQ_SOURCE_LINE 00000121 "        sorted          => 0,"
NSQ_SOURCE_LINE 00000122 "        loop_safe       => 0,"
NSQ_SOURCE_LINE 00000123 "        error_handler   => undef,"
NSQ_SOURCE_LINE 00000124 "        visitor         => undef,"
NSQ_SOURCE_LINE 00000125 "    );"
NSQ_SOURCE_LINE 00000126 "}"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000129 "# iteration methods"
NSQ_SOURCE_LINE 00000130 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "sub iter {"
NSQ_SOURCE_LINE 00000133 "    my $self = shift;"
NSQ_SOURCE_LINE 00000134 "    $self->_iter( { $self->_defaults }, @_ );"
NSQ_SOURCE_LINE 00000135 "}"
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "sub iter_fast {"
NSQ_SOURCE_LINE 00000138 "    my $self = shift;"
NSQ_SOURCE_LINE 00000139 "    $self->_iter( { $self->_fast_defaults }, @_ );"
NSQ_SOURCE_LINE 00000140 "}"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "sub _iter {"
NSQ_SOURCE_LINE 00000143 "    my $self     = shift;"
NSQ_SOURCE_LINE 00000144 "    my $defaults = shift;"
NSQ_SOURCE_LINE 00000145 "    my $args ="
NSQ_SOURCE_LINE 00000146 "        ref( $_[0] )  && !Scalar::Util::blessed( $_[0] )  ? shift"
NSQ_SOURCE_LINE 00000147 "      : ref( $_[-1] ) && !Scalar::Util::blessed( $_[-1] ) ? pop"
NSQ_SOURCE_LINE 00000148 "      :                                                     {};"
NSQ_SOURCE_LINE 00000149 "    my %opts = ( %$defaults, %$args );"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    # unroll these for efficiency"
NSQ_SOURCE_LINE 00000152 "    my $opt_stringify       = $opts{_stringify};"
NSQ_SOURCE_LINE 00000153 "    my $opt_depthfirst      = $opts{depthfirst};"
NSQ_SOURCE_LINE 00000154 "    my $opt_follow_symlinks = $opts{follow_symlinks};"
NSQ_SOURCE_LINE 00000155 "    my $opt_sorted          = $opts{sorted};"
NSQ_SOURCE_LINE 00000156 "    my $opt_loop_safe       = $opts{loop_safe};"
NSQ_SOURCE_LINE 00000157 "    my $opt_error_handler   = $opts{error_handler};"
NSQ_SOURCE_LINE 00000158 "    my $opt_relative        = $opts{relative};"
NSQ_SOURCE_LINE 00000159 "    my $opt_visitor         = $opts{visitor};"
NSQ_SOURCE_LINE 00000160 "    my $has_rules           = @{ $self->{rules} };"
NSQ_SOURCE_LINE 00000161 "    my $stash               = {};"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    my $opt_report_symlinks ="
NSQ_SOURCE_LINE 00000164 "      defined( $opts{report_symlinks} )"
NSQ_SOURCE_LINE 00000165 "      ? $opts{report_symlinks}"
NSQ_SOURCE_LINE 00000166 "      : $opts{follow_symlinks};"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "    # if not subclassed, we want to inline"
NSQ_SOURCE_LINE 00000169 "    my $can_children = $self->can(\"_children\");"
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "    # queue structure: flat list of (unnested) tuples of 4 (object,"
NSQ_SOURCE_LINE 00000172 "    # basename, depth, origin).  If object is a coderef, it's a deferred"
NSQ_SOURCE_LINE 00000173 "    # directory list.  If the object is an arrayref, then that's a special"
NSQ_SOURCE_LINE 00000174 "    # case signal that it was already of interest and can finally be"
NSQ_SOURCE_LINE 00000175 "    # returned for postorder searches"
NSQ_SOURCE_LINE 00000176 "    my @queue ="
NSQ_SOURCE_LINE 00000177 "      map {"
NSQ_SOURCE_LINE 00000178 "        my $i = $self->_objectify($_);"
NSQ_SOURCE_LINE 00000179 "        ( $i, File::Basename::basename(\"$_\"), 0, $i )"
NSQ_SOURCE_LINE 00000180 "      } @_ ? @_ : '.';"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    return sub {"
NSQ_SOURCE_LINE 00000183 "        LOOP: {"
NSQ_SOURCE_LINE 00000184 "            my ( $item, $base, $depth, $origin ) = splice( @queue, 0, 4 );"
NSQ_SOURCE_LINE 00000185 "            return unless $item;"
NSQ_SOURCE_LINE 00000186 "            if ( ref $item eq 'CODE' ) {"
NSQ_SOURCE_LINE 00000187 "                # replace placeholder with children"
NSQ_SOURCE_LINE 00000188 "                unshift @queue, $item->();"
NSQ_SOURCE_LINE 00000189 "                redo LOOP;"
NSQ_SOURCE_LINE 00000190 "            }"
NSQ_SOURCE_LINE 00000191 "            return $item->[0] if ref $item eq 'ARRAY'; # deferred for postorder"
NSQ_SOURCE_LINE 00000192 "            my $string_item = $opt_stringify ? \"$item\" : $item;"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "            # by default, we're interested in everything and prune nothing"
NSQ_SOURCE_LINE 00000195 "            my ( $interest, $prune ) = ( 1, 0 );"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "            if ( -l $string_item ) {"
NSQ_SOURCE_LINE 00000198 "                $prune = 1 if !$opt_follow_symlinks;"
NSQ_SOURCE_LINE 00000199 "                redo LOOP if !$opt_report_symlinks;"
NSQ_SOURCE_LINE 00000200 "            }"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "            if ($has_rules) {"
NSQ_SOURCE_LINE 00000203 "                local $_ = $item;"
NSQ_SOURCE_LINE 00000204 "                $stash->{_depth} = $depth;"
NSQ_SOURCE_LINE 00000205 "                if ($opt_error_handler) {"
NSQ_SOURCE_LINE 00000206 "                    $interest = try { $self->test( $item, $base, $stash ) }"
NSQ_SOURCE_LINE 00000207 "                    catch { $opt_error_handler->( $item, $_ ) };"
NSQ_SOURCE_LINE 00000208 "                }"
NSQ_SOURCE_LINE 00000209 "                else {"
NSQ_SOURCE_LINE 00000210 "                    $interest = $self->test( $item, $base, $stash );"
NSQ_SOURCE_LINE 00000211 "                }"
NSQ_SOURCE_LINE 00000212 "                # New way to signal prune is returning a reference to a scalar."
NSQ_SOURCE_LINE 00000213 "                # Value of the scalar indicates if it should be returned by the"
NSQ_SOURCE_LINE 00000214 "                # iterator or not"
NSQ_SOURCE_LINE 00000215 "                if ( ref $interest eq 'SCALAR' ) {"
NSQ_SOURCE_LINE 00000216 "                    $prune    = 1;"
NSQ_SOURCE_LINE 00000217 "                    $interest = $$interest;"
NSQ_SOURCE_LINE 00000218 "                }"
NSQ_SOURCE_LINE 00000219 "            }"
NSQ_SOURCE_LINE 00000220 ""
NSQ_SOURCE_LINE 00000221 "            # if we have a visitor, we call it like a custom rule"
NSQ_SOURCE_LINE 00000222 "            if ( $opt_visitor && $interest ) {"
NSQ_SOURCE_LINE 00000223 "                local $_ = $item;"
NSQ_SOURCE_LINE 00000224 "                $stash->{_depth} = $depth;"
NSQ_SOURCE_LINE 00000225 "                $opt_visitor->( $item, $base, $stash );"
NSQ_SOURCE_LINE 00000226 "            }"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "            # if it's a directory, maybe add children to the queue"
NSQ_SOURCE_LINE 00000229 "            if (   ( -d $string_item )"
NSQ_SOURCE_LINE 00000230 "                && ( !$prune )"
NSQ_SOURCE_LINE 00000231 "                && ( !$opt_loop_safe || $self->_is_unique( $string_item, $stash ) ) )"
NSQ_SOURCE_LINE 00000232 "            {"
NSQ_SOURCE_LINE 00000233 "                if ( !-r $string_item ) {"
NSQ_SOURCE_LINE 00000234 "                    warnings::warnif(\"Directory '$string_item' is not readable. Skipping it\");"
NSQ_SOURCE_LINE 00000235 "                }"
NSQ_SOURCE_LINE 00000236 "                else {"
NSQ_SOURCE_LINE 00000237 "                    my $depth_p1 = $depth + 1;"
NSQ_SOURCE_LINE 00000238 "                    my $next;"
NSQ_SOURCE_LINE 00000239 "                    if ($can_children) {"
NSQ_SOURCE_LINE 00000240 "                        $next = sub {"
NSQ_SOURCE_LINE 00000241 "                            my @paths = $can_children->( $self, $item );"
NSQ_SOURCE_LINE 00000242 "                            if ($opt_sorted) {"
NSQ_SOURCE_LINE 00000243 "                                @paths = sort { \"$a->[0]\" cmp \"$b->[0]\" } @paths;"
NSQ_SOURCE_LINE 00000244 "                            }"
NSQ_SOURCE_LINE 00000245 "                            map { ( $_->[1], $_->[0], $depth_p1, $origin ) } @paths;"
NSQ_SOURCE_LINE 00000246 "                        };"
NSQ_SOURCE_LINE 00000247 "                    }"
NSQ_SOURCE_LINE 00000248 "                    else {"
NSQ_SOURCE_LINE 00000249 "                        $next = sub {"
NSQ_SOURCE_LINE 00000250 "                            my $dh;"
NSQ_SOURCE_LINE 00000251 "                            # Windows can return true for -r but still fail opendir."
NSQ_SOURCE_LINE 00000252 "                            if ( ! opendir( $dh, $string_item ) ) {"
NSQ_SOURCE_LINE 00000253 "                                warnings::warnif(\"Directory '$string_item' is not readable. Skipping it\");"
NSQ_SOURCE_LINE 00000254 "                                return;"
NSQ_SOURCE_LINE 00000255 "                            }"
NSQ_SOURCE_LINE 00000256 "                            if ($opt_sorted) {"
NSQ_SOURCE_LINE 00000257 "                                map { ( \"$string_item/$_\", $_, $depth_p1, $origin ) }"
NSQ_SOURCE_LINE 00000258 "                                  sort { $a cmp $b } grep { $_ ne \".\" && $_ ne \"..\" } readdir $dh;"
NSQ_SOURCE_LINE 00000259 "                            }"
NSQ_SOURCE_LINE 00000260 "                            else {"
NSQ_SOURCE_LINE 00000261 "                                map { ( \"$string_item/$_\", $_, $depth_p1, $origin ) }"
NSQ_SOURCE_LINE 00000262 "                                  grep { $_ ne \".\" && $_ ne \"..\" } readdir $dh;"
NSQ_SOURCE_LINE 00000263 "                            }"
NSQ_SOURCE_LINE 00000264 "                        };"
NSQ_SOURCE_LINE 00000265 "                    }"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "                    if ($opt_depthfirst) {"
NSQ_SOURCE_LINE 00000268 "                        # either preorder (parents before kids) or"
NSQ_SOURCE_LINE 00000269 "                        # postorder (parents after kids); for postorder,"
NSQ_SOURCE_LINE 00000270 "                        # requeue current item as a reference to signal it"
NSQ_SOURCE_LINE 00000271 "                        # can be returned without being retested"
NSQ_SOURCE_LINE 00000272 "                        unshift @queue,"
NSQ_SOURCE_LINE 00000273 "                          ["
NSQ_SOURCE_LINE 00000274 "                            ("
NSQ_SOURCE_LINE 00000275 "                                  $opt_relative"
NSQ_SOURCE_LINE 00000276 "                                ? $self->_objectify( File::Spec->abs2rel( $string_item, $origin ) )"
NSQ_SOURCE_LINE 00000277 "                                : $item"
NSQ_SOURCE_LINE 00000278 "                            )"
NSQ_SOURCE_LINE 00000279 "                          ],"
NSQ_SOURCE_LINE 00000280 "                          undef, undef, undef"
NSQ_SOURCE_LINE 00000281 "                          if $interest && $opt_depthfirst > 0;"
NSQ_SOURCE_LINE 00000282 "                        unshift @queue, $next, undef, undef, undef;"
NSQ_SOURCE_LINE 00000283 "                        redo LOOP if $opt_depthfirst > 0;"
NSQ_SOURCE_LINE 00000284 "                    }"
NSQ_SOURCE_LINE 00000285 "                    else {"
NSQ_SOURCE_LINE 00000286 "                        # breadth-first: add placeholder for children at the end"
NSQ_SOURCE_LINE 00000287 "                        push @queue, $next, undef, undef, undef;"
NSQ_SOURCE_LINE 00000288 "                    }"
NSQ_SOURCE_LINE 00000289 "                }"
NSQ_SOURCE_LINE 00000290 "            } # end of \"is directory maybe with children\""
NSQ_SOURCE_LINE 00000291 "            return ("
NSQ_SOURCE_LINE 00000292 "                  $opt_relative"
NSQ_SOURCE_LINE 00000293 "                ? $self->_objectify( File::Spec->abs2rel( $string_item, $origin ) )"
NSQ_SOURCE_LINE 00000294 "                : $item"
NSQ_SOURCE_LINE 00000295 "            ) if $interest;"
NSQ_SOURCE_LINE 00000296 "            redo LOOP;"
NSQ_SOURCE_LINE 00000297 "        }"
NSQ_SOURCE_LINE 00000298 "    };"
NSQ_SOURCE_LINE 00000299 "}"
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "sub all {"
NSQ_SOURCE_LINE 00000302 "    my $self = shift;"
NSQ_SOURCE_LINE 00000303 "    return $self->_all( $self->iter(@_) );"
NSQ_SOURCE_LINE 00000304 "}"
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "sub all_fast {"
NSQ_SOURCE_LINE 00000307 "    my $self = shift;"
NSQ_SOURCE_LINE 00000308 "    return $self->_all( $self->iter_fast(@_) );"
NSQ_SOURCE_LINE 00000309 "}"
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "sub _all {"
NSQ_SOURCE_LINE 00000312 "    my $self = shift;"
NSQ_SOURCE_LINE 00000313 "    my $iter = shift;"
NSQ_SOURCE_LINE 00000314 "    if (wantarray) {"
NSQ_SOURCE_LINE 00000315 "        my @results;"
NSQ_SOURCE_LINE 00000316 "        while ( defined( my $item = $iter->() ) ) {"
NSQ_SOURCE_LINE 00000317 "            push @results, $item;"
NSQ_SOURCE_LINE 00000318 "        }"
NSQ_SOURCE_LINE 00000319 "        return @results;"
NSQ_SOURCE_LINE 00000320 "    }"
NSQ_SOURCE_LINE 00000321 "    elsif ( defined wantarray ) {"
NSQ_SOURCE_LINE 00000322 "        my $count = 0;"
NSQ_SOURCE_LINE 00000323 "        $count++ while defined $iter->();"
NSQ_SOURCE_LINE 00000324 "        return $count;"
NSQ_SOURCE_LINE 00000325 "    }"
NSQ_SOURCE_LINE 00000326 "    else {"
NSQ_SOURCE_LINE 00000327 "        1 while defined $iter->();"
NSQ_SOURCE_LINE 00000328 "    }"
NSQ_SOURCE_LINE 00000329 "}"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000332 "# logic methods"
NSQ_SOURCE_LINE 00000333 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "sub and {"
NSQ_SOURCE_LINE 00000336 "    my $self = shift;"
NSQ_SOURCE_LINE 00000337 "    push @{ $self->{rules} }, $self->_rulify(@_);"
NSQ_SOURCE_LINE 00000338 "    return $self;"
NSQ_SOURCE_LINE 00000339 "}"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "sub or {"
NSQ_SOURCE_LINE 00000342 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000343 "    my @rules   = $self->_rulify(@_);"
NSQ_SOURCE_LINE 00000344 "    my $coderef = sub {"
NSQ_SOURCE_LINE 00000345 "        my ( $result, $prune );"
NSQ_SOURCE_LINE 00000346 "        for my $rule (@rules) {"
NSQ_SOURCE_LINE 00000347 "            $result = $rule->(@_);"
NSQ_SOURCE_LINE 00000348 "            # once any rule says to prune, we remember that"
NSQ_SOURCE_LINE 00000349 "            $prune ||= ref($result) eq 'SCALAR';"
NSQ_SOURCE_LINE 00000350 "            # extract whether constraint was met"
NSQ_SOURCE_LINE 00000351 "            $result = $$result if ref($result) eq 'SCALAR';"
NSQ_SOURCE_LINE 00000352 "            # shortcut if met, propagating prune state"
NSQ_SOURCE_LINE 00000353 "            return ( $prune ? \\1 : 1 ) if $result;"
NSQ_SOURCE_LINE 00000354 "        }"
NSQ_SOURCE_LINE 00000355 "        return ( $prune ? \\$result : $result )"
NSQ_SOURCE_LINE 00000356 "          ; # may or may not be met, but propagate prune state"
NSQ_SOURCE_LINE 00000357 "    };"
NSQ_SOURCE_LINE 00000358 "    return $self->and($coderef);"
NSQ_SOURCE_LINE 00000359 "}"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "sub not {"
NSQ_SOURCE_LINE 00000362 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000363 "    my $obj     = $self->new->and(@_);"
NSQ_SOURCE_LINE 00000364 "    my $coderef = sub {"
NSQ_SOURCE_LINE 00000365 "        my $result = $obj->test(@_);"
NSQ_SOURCE_LINE 00000366 "        return ref($result) ? \\!$$result : !$result; # invert, but preserve prune"
NSQ_SOURCE_LINE 00000367 "    };"
NSQ_SOURCE_LINE 00000368 "    return $self->and($coderef);"
NSQ_SOURCE_LINE 00000369 "}"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "sub skip {"
NSQ_SOURCE_LINE 00000372 "    my $self    = shift;"
NSQ_SOURCE_LINE 00000373 "    my @rules   = @_;"
NSQ_SOURCE_LINE 00000374 "    my $obj     = $self->new->or(@rules);"
NSQ_SOURCE_LINE 00000375 "    my $coderef = sub {"
NSQ_SOURCE_LINE 00000376 "        my $result = $obj->test(@_);"
NSQ_SOURCE_LINE 00000377 "        my ( $prune, $interest );"
NSQ_SOURCE_LINE 00000378 "        if ( ref($result) eq 'SCALAR' ) {"
NSQ_SOURCE_LINE 00000379 "            # test told us to prune, so make that sticky"
NSQ_SOURCE_LINE 00000380 "            # and also skip it"
NSQ_SOURCE_LINE 00000381 "            $prune    = 1;"
NSQ_SOURCE_LINE 00000382 "            $interest = 0;"
NSQ_SOURCE_LINE 00000383 "        }"
NSQ_SOURCE_LINE 00000384 "        else {"
NSQ_SOURCE_LINE 00000385 "            # prune if test was true"
NSQ_SOURCE_LINE 00000386 "            $prune = $result;"
NSQ_SOURCE_LINE 00000387 "            # negate test result"
NSQ_SOURCE_LINE 00000388 "            $interest = !$result;"
NSQ_SOURCE_LINE 00000389 "        }"
NSQ_SOURCE_LINE 00000390 "        return $prune ? \\$interest : $interest;"
NSQ_SOURCE_LINE 00000391 "    };"
NSQ_SOURCE_LINE 00000392 "    return $self->and($coderef);"
NSQ_SOURCE_LINE 00000393 "}"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "sub test {"
NSQ_SOURCE_LINE 00000396 "    my ( $self, $item, $base, $stash ) = @_;"
NSQ_SOURCE_LINE 00000397 "    my ( $result, $prune );"
NSQ_SOURCE_LINE 00000398 "    for my $rule ( @{ $self->{rules} } ) {"
NSQ_SOURCE_LINE 00000399 "        $result = $rule->( $item, $base, $stash ) || 0;"
NSQ_SOURCE_LINE 00000400 "        if ( !ref($result) && $result eq '0 but true' ) {"
NSQ_SOURCE_LINE 00000401 "            Carp::croak(\"0 but true no longer supported by custom rules\");"
NSQ_SOURCE_LINE 00000402 "        }"
NSQ_SOURCE_LINE 00000403 "        # once any rule says to prune, we remember that"
NSQ_SOURCE_LINE 00000404 "        $prune ||= ref($result) eq 'SCALAR';"
NSQ_SOURCE_LINE 00000405 "        # extract whether constraint was met"
NSQ_SOURCE_LINE 00000406 "        $result = $$result if ref($result) eq 'SCALAR';"
NSQ_SOURCE_LINE 00000407 "        # shortcut if not met, propagating prune state"
NSQ_SOURCE_LINE 00000408 "        return ( $prune ? \\0 : 0 ) if !$result;"
NSQ_SOURCE_LINE 00000409 "    }"
NSQ_SOURCE_LINE 00000410 "    return ( $prune ? \\1 : 1 ); # all constraints met, but propagate prune state"
NSQ_SOURCE_LINE 00000411 "}"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000414 "# private methods"
NSQ_SOURCE_LINE 00000415 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "sub _rulify {"
NSQ_SOURCE_LINE 00000418 "    my ( $self, @args ) = @_;"
NSQ_SOURCE_LINE 00000419 "    my @rules;"
NSQ_SOURCE_LINE 00000420 "    for my $arg (@args) {"
NSQ_SOURCE_LINE 00000421 "        my $rule;"
NSQ_SOURCE_LINE 00000422 "        if ( Scalar::Util::blessed($arg) && $arg->isa(\"Path::Iterator::Rule\") ) {"
NSQ_SOURCE_LINE 00000423 "            $rule = sub { $arg->test(@_) };"
NSQ_SOURCE_LINE 00000424 "        }"
NSQ_SOURCE_LINE 00000425 "        elsif ( ref($arg) eq 'CODE' ) {"
NSQ_SOURCE_LINE 00000426 "            $rule = $arg;"
NSQ_SOURCE_LINE 00000427 "        }"
NSQ_SOURCE_LINE 00000428 "        else {"
NSQ_SOURCE_LINE 00000429 "            Carp::croak(\"Rules must be coderef or Path::Iterator::Rule\");"
NSQ_SOURCE_LINE 00000430 "        }"
NSQ_SOURCE_LINE 00000431 "        push @rules, $rule;"
NSQ_SOURCE_LINE 00000432 "    }"
NSQ_SOURCE_LINE 00000433 "    return @rules;"
NSQ_SOURCE_LINE 00000434 "}"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "sub _is_unique {"
NSQ_SOURCE_LINE 00000437 "    my ( $self, $string_item, $stash ) = @_;"
NSQ_SOURCE_LINE 00000438 "    my $unique_id;"
NSQ_SOURCE_LINE 00000439 "    my @st = eval { stat $string_item };"
NSQ_SOURCE_LINE 00000440 "    @st = eval { lstat $string_item } unless @st;"
NSQ_SOURCE_LINE 00000441 "    if (@st) {"
NSQ_SOURCE_LINE 00000442 "        $unique_id = join( \",\", $st[0], $st[1] );"
NSQ_SOURCE_LINE 00000443 "    }"
NSQ_SOURCE_LINE 00000444 "    else {"
NSQ_SOURCE_LINE 00000445 "        my $type = -d $string_item ? 'directory' : 'file';"
NSQ_SOURCE_LINE 00000446 "        warnings::warnif(\"Could not stat $type '$string_item'\");"
NSQ_SOURCE_LINE 00000447 "        $unique_id = $string_item;"
NSQ_SOURCE_LINE 00000448 "    }"
NSQ_SOURCE_LINE 00000449 "    return !$stash->{_seen}{$unique_id}++;"
NSQ_SOURCE_LINE 00000450 "}"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000453 "# built-in helpers"
NSQ_SOURCE_LINE 00000454 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "sub _regexify {"
NSQ_SOURCE_LINE 00000457 "    my ( $re, $add ) = @_;"
NSQ_SOURCE_LINE 00000458 "    $add ||= '';"
NSQ_SOURCE_LINE 00000459 "    my $new = ref($re) eq 'Regexp' ? $re : Text::Glob::glob_to_regex($re);"
NSQ_SOURCE_LINE 00000460 "    return $new unless $add;"
NSQ_SOURCE_LINE 00000461 "    my ( $pattern, $flags ) = _split_re($new);"
NSQ_SOURCE_LINE 00000462 "    my $new_flags = $add ? _reflag( $flags, $add ) : \"\";"
NSQ_SOURCE_LINE 00000463 "    return qr/$new_flags$pattern/;"
NSQ_SOURCE_LINE 00000464 "}"
NSQ_SOURCE_LINE 00000465 ""
NSQ_SOURCE_LINE 00000466 "sub _split_re {"
NSQ_SOURCE_LINE 00000467 "    my $value = shift;"
NSQ_SOURCE_LINE 00000468 "    if ( $] ge 5.010 ) {"
NSQ_SOURCE_LINE 00000469 "        return re::regexp_pattern($value);"
NSQ_SOURCE_LINE 00000470 "    }"
NSQ_SOURCE_LINE 00000471 "    else {"
NSQ_SOURCE_LINE 00000472 "        $value =~ s/^\\(\\?\\^?//;"
NSQ_SOURCE_LINE 00000473 "        $value =~ s/\\)$//;"
NSQ_SOURCE_LINE 00000474 "        my ( $opt, $re ) = split( /:/, $value, 2 );"
NSQ_SOURCE_LINE 00000475 "        $opt =~ s/\\-\\w+$//;"
NSQ_SOURCE_LINE 00000476 "        return ( $re, $opt );"
NSQ_SOURCE_LINE 00000477 "    }"
NSQ_SOURCE_LINE 00000478 "}"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "sub _reflag {"
NSQ_SOURCE_LINE 00000481 "    my ( $orig, $add ) = @_;"
NSQ_SOURCE_LINE 00000482 "    $orig ||= \"\";"
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "    if ( $] >= 5.014 ) {"
NSQ_SOURCE_LINE 00000485 "        return \"(?^$orig$add)\";"
NSQ_SOURCE_LINE 00000486 "    }"
NSQ_SOURCE_LINE 00000487 "    else {"
NSQ_SOURCE_LINE 00000488 "        my ( $pos, $neg ) = split /-/, $orig;"
NSQ_SOURCE_LINE 00000489 "        $pos ||= \"\";"
NSQ_SOURCE_LINE 00000490 "        $neg ||= \"\";"
NSQ_SOURCE_LINE 00000491 "        $neg =~ s/i//;"
NSQ_SOURCE_LINE 00000492 "        $neg = \"-$neg\" if length $neg;"
NSQ_SOURCE_LINE 00000493 "        return \"(?$add$pos$neg)\";"
NSQ_SOURCE_LINE 00000494 "    }"
NSQ_SOURCE_LINE 00000495 "}"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "# \"simple\" helpers take no arguments"
NSQ_SOURCE_LINE 00000498 "my %simple_helpers = ("
NSQ_SOURCE_LINE 00000499 "    directory => sub { -d $_ },           # see also -d => dir below"
NSQ_SOURCE_LINE 00000500 "    dangling => sub { -l $_ && !stat $_ },"
NSQ_SOURCE_LINE 00000501 ");"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "while ( my ( $k, $v ) = each %simple_helpers ) {"
NSQ_SOURCE_LINE 00000504 "    __PACKAGE__->add_helper( $k, sub { return $v } );"
NSQ_SOURCE_LINE 00000505 "}"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "sub _generate_name_matcher {"
NSQ_SOURCE_LINE 00000508 "    my (@patterns) = @_;"
NSQ_SOURCE_LINE 00000509 "    if ( @patterns > 1 ) {"
NSQ_SOURCE_LINE 00000510 "        return sub {"
NSQ_SOURCE_LINE 00000511 "            my $name = \"$_[1]\";"
NSQ_SOURCE_LINE 00000512 "            return ( List::Util::first { $name =~ $_ } @patterns ) ? 1 : 0;"
NSQ_SOURCE_LINE 00000513 "          }"
NSQ_SOURCE_LINE 00000514 "    }"
NSQ_SOURCE_LINE 00000515 "    else {"
NSQ_SOURCE_LINE 00000516 "        my $pattern = $patterns[0];"
NSQ_SOURCE_LINE 00000517 "        return sub {"
NSQ_SOURCE_LINE 00000518 "            my $name = \"$_[1]\";"
NSQ_SOURCE_LINE 00000519 "            return $name =~ $pattern ? 1 : 0;"
NSQ_SOURCE_LINE 00000520 "          }"
NSQ_SOURCE_LINE 00000521 "    }"
NSQ_SOURCE_LINE 00000522 "}"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "# \"complex\" helpers take arguments"
NSQ_SOURCE_LINE 00000525 "my %complex_helpers = ("
NSQ_SOURCE_LINE 00000526 "    name => sub {"
NSQ_SOURCE_LINE 00000527 "        Carp::croak(\"No patterns provided to 'name'\") unless @_;"
NSQ_SOURCE_LINE 00000528 "        _generate_name_matcher( map { _regexify($_) } @_ );"
NSQ_SOURCE_LINE 00000529 "    },"
NSQ_SOURCE_LINE 00000530 "    iname => sub {"
NSQ_SOURCE_LINE 00000531 "        Carp::croak(\"No patterns provided to 'iname'\") unless @_;"
NSQ_SOURCE_LINE 00000532 "        _generate_name_matcher( map { _regexify( $_, \"i\" ) } @_ );"
NSQ_SOURCE_LINE 00000533 "    },"
NSQ_SOURCE_LINE 00000534 "    min_depth => sub {"
NSQ_SOURCE_LINE 00000535 "        Carp::croak(\"No depth argument given to 'min_depth'\") unless @_;"
NSQ_SOURCE_LINE 00000536 "        my $min_depth = 0+ shift; # if this warns, do here and not on every file"
NSQ_SOURCE_LINE 00000537 "        return sub {"
NSQ_SOURCE_LINE 00000538 "            my ( $f, $b, $stash ) = @_;"
NSQ_SOURCE_LINE 00000539 "            return $stash->{_depth} >= $min_depth;"
NSQ_SOURCE_LINE 00000540 "          }"
NSQ_SOURCE_LINE 00000541 "    },"
NSQ_SOURCE_LINE 00000542 "    max_depth => sub {"
NSQ_SOURCE_LINE 00000543 "        Carp::croak(\"No depth argument given to 'max_depth'\") unless @_;"
NSQ_SOURCE_LINE 00000544 "        my $max_depth = 0+ shift; # if this warns, do here and not on every file"
NSQ_SOURCE_LINE 00000545 "        return sub {"
NSQ_SOURCE_LINE 00000546 "            my ( $f, $b, $stash ) = @_;"
NSQ_SOURCE_LINE 00000547 "            return 1  if $stash->{_depth} < $max_depth;"
NSQ_SOURCE_LINE 00000548 "            return \\1 if $stash->{_depth} == $max_depth;"
NSQ_SOURCE_LINE 00000549 "            return \\0;"
NSQ_SOURCE_LINE 00000550 "          }"
NSQ_SOURCE_LINE 00000551 "    },"
NSQ_SOURCE_LINE 00000552 "    shebang => sub {"
NSQ_SOURCE_LINE 00000553 "        Carp::croak(\"No patterns provided to 'shebang'\") unless @_;"
NSQ_SOURCE_LINE 00000554 "        my @patterns = map { _regexify($_) } @_;"
NSQ_SOURCE_LINE 00000555 "        return sub {"
NSQ_SOURCE_LINE 00000556 "            my $f = shift;"
NSQ_SOURCE_LINE 00000557 "            return unless !-d $f;"
NSQ_SOURCE_LINE 00000558 "            open my $fh, \"<\", $f;"
NSQ_SOURCE_LINE 00000559 "            my $shebang = <$fh>;"
NSQ_SOURCE_LINE 00000560 "            return unless defined $shebang;"
NSQ_SOURCE_LINE 00000561 "            return ( List::Util::first { $shebang =~ $_ } @patterns ) ? 1 : 0;"
NSQ_SOURCE_LINE 00000562 "        };"
NSQ_SOURCE_LINE 00000563 "    },"
NSQ_SOURCE_LINE 00000564 "    contents_match => sub {"
NSQ_SOURCE_LINE 00000565 "        my @regexp = @_;"
NSQ_SOURCE_LINE 00000566 "        my $filter = ':encoding(UTF-8)';"
NSQ_SOURCE_LINE 00000567 "        $filter = shift @regexp unless ref $regexp[0];"
NSQ_SOURCE_LINE 00000568 "        return sub {"
NSQ_SOURCE_LINE 00000569 "            my $f = shift;"
NSQ_SOURCE_LINE 00000570 "            return unless !-d $f;"
NSQ_SOURCE_LINE 00000571 "            my $contents = do {"
NSQ_SOURCE_LINE 00000572 "                local $/ = undef;"
NSQ_SOURCE_LINE 00000573 "                open my $fh, \"<$filter\", $f;"
NSQ_SOURCE_LINE 00000574 "                <$fh>;"
NSQ_SOURCE_LINE 00000575 "            };"
NSQ_SOURCE_LINE 00000576 "            for my $re (@regexp) {"
NSQ_SOURCE_LINE 00000577 "                return 1 if $contents =~ $re;"
NSQ_SOURCE_LINE 00000578 "            }"
NSQ_SOURCE_LINE 00000579 "            return 0;"
NSQ_SOURCE_LINE 00000580 "        };"
NSQ_SOURCE_LINE 00000581 "    },"
NSQ_SOURCE_LINE 00000582 "    line_match => sub {"
NSQ_SOURCE_LINE 00000583 "        my @regexp = @_;"
NSQ_SOURCE_LINE 00000584 "        my $filter = ':encoding(UTF-8)';"
NSQ_SOURCE_LINE 00000585 "        $filter = shift @regexp unless ref $regexp[0];"
NSQ_SOURCE_LINE 00000586 "        return sub {"
NSQ_SOURCE_LINE 00000587 "            my $f = shift;"
NSQ_SOURCE_LINE 00000588 "            return unless !-d $f;"
NSQ_SOURCE_LINE 00000589 "            open my $fh, \"<$filter\", $f;"
NSQ_SOURCE_LINE 00000590 "            while ( my $line = <$fh> ) {"
NSQ_SOURCE_LINE 00000591 "                for my $re (@regexp) {"
NSQ_SOURCE_LINE 00000592 "                    return 1 if $line =~ $re;"
NSQ_SOURCE_LINE 00000593 "                }"
NSQ_SOURCE_LINE 00000594 "            }"
NSQ_SOURCE_LINE 00000595 "            return 0;"
NSQ_SOURCE_LINE 00000596 "        };"
NSQ_SOURCE_LINE 00000597 "    },"
NSQ_SOURCE_LINE 00000598 ");"
NSQ_SOURCE_LINE 00000599 ""
NSQ_SOURCE_LINE 00000600 "while ( my ( $k, $v ) = each %complex_helpers ) {"
NSQ_SOURCE_LINE 00000601 "    __PACKAGE__->add_helper( $k, $v );"
NSQ_SOURCE_LINE 00000602 "}"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "# skip_dirs"
NSQ_SOURCE_LINE 00000605 "__PACKAGE__->add_helper("
NSQ_SOURCE_LINE 00000606 "    skip_dirs => sub {"
NSQ_SOURCE_LINE 00000607 "        Carp::croak(\"No patterns provided to 'skip_dirs'\") unless @_;"
NSQ_SOURCE_LINE 00000608 "        my $name_check = Path::Iterator::Rule->new->name(@_);"
NSQ_SOURCE_LINE 00000609 "        return sub {"
NSQ_SOURCE_LINE 00000610 "            return \\0 if -d $_[0] && $name_check->test(@_);"
NSQ_SOURCE_LINE 00000611 "            return 1; # otherwise, like a null rule"
NSQ_SOURCE_LINE 00000612 "          }"
NSQ_SOURCE_LINE 00000613 "      } => 1 # don't create not_skip_dirs"
NSQ_SOURCE_LINE 00000614 ");"
NSQ_SOURCE_LINE 00000615 ""
NSQ_SOURCE_LINE 00000616 "__PACKAGE__->add_helper("
NSQ_SOURCE_LINE 00000617 "    skip_subdirs => sub {"
NSQ_SOURCE_LINE 00000618 "        Carp::croak(\"No patterns provided to 'skip_subdirs'\") unless @_;"
NSQ_SOURCE_LINE 00000619 "        my $name_check = Path::Iterator::Rule->new->name(@_);"
NSQ_SOURCE_LINE 00000620 "        return sub {"
NSQ_SOURCE_LINE 00000621 "            my ( $f, $b, $stash ) = @_;"
NSQ_SOURCE_LINE 00000622 "            return \\0 if -d $f && $stash->{_depth} && $name_check->test(@_);"
NSQ_SOURCE_LINE 00000623 "            return 1; # otherwise, like a null rule"
NSQ_SOURCE_LINE 00000624 "          }"
NSQ_SOURCE_LINE 00000625 "      } => 1 # don't create not_skip_dirs"
NSQ_SOURCE_LINE 00000626 ");"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "# X_tests adapted from File::Find::Rule"
NSQ_SOURCE_LINE 00000629 "#<<< do not perltidy this"
NSQ_SOURCE_LINE 00000630 "my %X_tests = ("
NSQ_SOURCE_LINE 00000631 "    -r  =>  readable           =>  -R  =>  r_readable      =>"
NSQ_SOURCE_LINE 00000632 "    -w  =>  writeable          =>  -W  =>  r_writeable     =>"
NSQ_SOURCE_LINE 00000633 "    -w  =>  writable           =>  -W  =>  r_writable      =>"
NSQ_SOURCE_LINE 00000634 "    -x  =>  executable         =>  -X  =>  r_executable    =>"
NSQ_SOURCE_LINE 00000635 "    -o  =>  owned              =>  -O  =>  r_owned         =>"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "    -e  =>  exists             =>  -f  =>  file            =>"
NSQ_SOURCE_LINE 00000638 "    -z  =>  empty              =>  -d  =>  dir             =>"
NSQ_SOURCE_LINE 00000639 "    -s  =>  nonempty           =>  -l  =>  symlink         =>"
NSQ_SOURCE_LINE 00000640 "                               =>  -p  =>  fifo            =>"
NSQ_SOURCE_LINE 00000641 "    -u  =>  setuid             =>  -S  =>  socket          =>"
NSQ_SOURCE_LINE 00000642 "    -g  =>  setgid             =>  -b  =>  block           =>"
NSQ_SOURCE_LINE 00000643 "    -k  =>  sticky             =>  -c  =>  character       =>"
NSQ_SOURCE_LINE 00000644 "                               =>  -t  =>  tty             =>"
NSQ_SOURCE_LINE 00000645 "    -T  =>  ascii              =>"
NSQ_SOURCE_LINE 00000646 "    -B  =>  binary             =>"
NSQ_SOURCE_LINE 00000647 ");"
NSQ_SOURCE_LINE 00000648 "#>>>"
NSQ_SOURCE_LINE 00000649 ""
NSQ_SOURCE_LINE 00000650 "while ( my ( $op, $name ) = each %X_tests ) {"
NSQ_SOURCE_LINE 00000651 "    my $coderef = eval \"sub { $op \\$_ }\"; ## no critic"
NSQ_SOURCE_LINE 00000652 "    __PACKAGE__->add_helper( $name, sub { return $coderef } );"
NSQ_SOURCE_LINE 00000653 "}"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "my %time_tests = ( -A => accessed => -M => modified => -C => changed => );"
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "while ( my ( $op, $name ) = each %time_tests ) {"
NSQ_SOURCE_LINE 00000658 "    my $filetest = eval \"sub { $op \\$_ }\"; ## no critic"
NSQ_SOURCE_LINE 00000659 "    my $coderef  = sub {"
NSQ_SOURCE_LINE 00000660 "        Carp::croak(\"The '$name' test requires a single argument\") unless @_ == 1;"
NSQ_SOURCE_LINE 00000661 "        my $comparator = Number::Compare->new(shift);"
NSQ_SOURCE_LINE 00000662 "        return sub { return $comparator->( $filetest->() ) };"
NSQ_SOURCE_LINE 00000663 "    };"
NSQ_SOURCE_LINE 00000664 "    __PACKAGE__->add_helper( $name, $coderef );"
NSQ_SOURCE_LINE 00000665 "}"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "# stat tests adapted from File::Find::Rule"
NSQ_SOURCE_LINE 00000668 "my @stat_tests = qw("
NSQ_SOURCE_LINE 00000669 "  dev ino mode nlink uid gid rdev size atime mtime ctime blksize blocks"
NSQ_SOURCE_LINE 00000670 ");"
NSQ_SOURCE_LINE 00000671 ""
NSQ_SOURCE_LINE 00000672 "for my $i ( 0 .. $#stat_tests ) {"
NSQ_SOURCE_LINE 00000673 "    my $name    = $stat_tests[$i];"
NSQ_SOURCE_LINE 00000674 "    my $coderef = sub {"
NSQ_SOURCE_LINE 00000675 "        Carp::croak(\"The '$name' test requires a single argument\") unless @_ == 1;"
NSQ_SOURCE_LINE 00000676 "        my $comparator = Number::Compare->new(shift);"
NSQ_SOURCE_LINE 00000677 "        return sub { return $comparator->( ( stat($_) )[$i] ) };"
NSQ_SOURCE_LINE 00000678 "    };"
NSQ_SOURCE_LINE 00000679 "    __PACKAGE__->add_helper( $name, $coderef );"
NSQ_SOURCE_LINE 00000680 "}"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "# VCS rules adapted from File::Find::Rule::VCS"
NSQ_SOURCE_LINE 00000683 "my %vcs_rules = ("
NSQ_SOURCE_LINE 00000684 "    skip_cvs => sub {"
NSQ_SOURCE_LINE 00000685 "        return Path::Iterator::Rule->new->skip_dirs('CVS')->not_name(qr/\\.\\#$/);"
NSQ_SOURCE_LINE 00000686 "    },"
NSQ_SOURCE_LINE 00000687 "    skip_rcs => sub {"
NSQ_SOURCE_LINE 00000688 "        return Path::Iterator::Rule->new->skip_dirs('RCS')->not_name(qr/,v$/);"
NSQ_SOURCE_LINE 00000689 "    },"
NSQ_SOURCE_LINE 00000690 "    skip_git => sub {"
NSQ_SOURCE_LINE 00000691 "        return Path::Iterator::Rule->new->skip_dirs('.git');"
NSQ_SOURCE_LINE 00000692 "    },"
NSQ_SOURCE_LINE 00000693 "    skip_svn => sub {"
NSQ_SOURCE_LINE 00000694 "        return Path::Iterator::Rule->new->skip_dirs("
NSQ_SOURCE_LINE 00000695 "            ( $^O eq 'MSWin32' ) ? ( '.svn', '_svn' ) : ('.svn') );"
NSQ_SOURCE_LINE 00000696 "    },"
NSQ_SOURCE_LINE 00000697 "    skip_bzr => sub {"
NSQ_SOURCE_LINE 00000698 "        return Path::Iterator::Rule->new->skip_dirs('.bzr');"
NSQ_SOURCE_LINE 00000699 "    },"
NSQ_SOURCE_LINE 00000700 "    skip_hg => sub {"
NSQ_SOURCE_LINE 00000701 "        return Path::Iterator::Rule->new->skip_dirs('.hg');"
NSQ_SOURCE_LINE 00000702 "    },"
NSQ_SOURCE_LINE 00000703 "    skip_darcs => sub {"
NSQ_SOURCE_LINE 00000704 "        return Path::Iterator::Rule->new->skip_dirs('_darcs');"
NSQ_SOURCE_LINE 00000705 "    },"
NSQ_SOURCE_LINE 00000706 "    skip_vcs => sub {"
NSQ_SOURCE_LINE 00000707 "        return Path::Iterator::Rule->new->skip_dirs(qw/.git .bzr .hg _darcs CVS RCS/)"
NSQ_SOURCE_LINE 00000708 "          ->skip_svn->not_name( qr/\\.\\#$/, qr/,v$/ );"
NSQ_SOURCE_LINE 00000709 "    },"
NSQ_SOURCE_LINE 00000710 ");"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "while ( my ( $name, $coderef ) = each %vcs_rules ) {"
NSQ_SOURCE_LINE 00000713 "    __PACKAGE__->add_helper( $name, $coderef, 1 ); # don't create not_*"
NSQ_SOURCE_LINE 00000714 "}"
NSQ_SOURCE_LINE 00000715 ""
NSQ_SOURCE_LINE 00000716 "# perl rules adapted from File::Find::Rule::Perl"
NSQ_SOURCE_LINE 00000717 "my %perl_rules = ("
NSQ_SOURCE_LINE 00000718 "    perl_module    => sub { return Path::Iterator::Rule->new->file->name('*.pm') },"
NSQ_SOURCE_LINE 00000719 "    perl_pod       => sub { return Path::Iterator::Rule->new->file->name('*.pod') },"
NSQ_SOURCE_LINE 00000720 "    perl_test      => sub { return Path::Iterator::Rule->new->file->name('*.t') },"
NSQ_SOURCE_LINE 00000721 "    perl_installer => sub {"
NSQ_SOURCE_LINE 00000722 "        return Path::Iterator::Rule->new->file->name( 'Makefile.PL', 'Build.PL' );"
NSQ_SOURCE_LINE 00000723 "    },"
NSQ_SOURCE_LINE 00000724 "    perl_script => sub {"
NSQ_SOURCE_LINE 00000725 "        return Path::Iterator::Rule->new->file->or("
NSQ_SOURCE_LINE 00000726 "            Path::Iterator::Rule->new->name('*.pl'),"
NSQ_SOURCE_LINE 00000727 "            Path::Iterator::Rule->new->shebang(qr/#!.*\\bperl\\b/),"
NSQ_SOURCE_LINE 00000728 "        );"
NSQ_SOURCE_LINE 00000729 "    },"
NSQ_SOURCE_LINE 00000730 "    perl_file => sub {"
NSQ_SOURCE_LINE 00000731 "        return Path::Iterator::Rule->new->or("
NSQ_SOURCE_LINE 00000732 "            Path::Iterator::Rule->new->perl_module, Path::Iterator::Rule->new->perl_pod,"
NSQ_SOURCE_LINE 00000733 "            Path::Iterator::Rule->new->perl_test,   Path::Iterator::Rule->new->perl_installer,"
NSQ_SOURCE_LINE 00000734 "            Path::Iterator::Rule->new->perl_script,"
NSQ_SOURCE_LINE 00000735 "        );"
NSQ_SOURCE_LINE 00000736 "    },"
NSQ_SOURCE_LINE 00000737 ");"
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "while ( my ( $name, $coderef ) = each %perl_rules ) {"
NSQ_SOURCE_LINE 00000740 "    __PACKAGE__->add_helper( $name, $coderef );"
NSQ_SOURCE_LINE 00000741 "}"
NSQ_SOURCE_LINE 00000742 ""
NSQ_SOURCE_LINE 00000743 "1;"
