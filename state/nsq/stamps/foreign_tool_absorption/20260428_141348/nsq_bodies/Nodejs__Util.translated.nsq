NSQ_SOURCE_LINE 00000001 "package Nodejs::Util;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $DATE = '2018-03-21'; # DATE"
NSQ_SOURCE_LINE 00000004 "our $VERSION = '0.012'; # VERSION"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use 5.010001;"
NSQ_SOURCE_LINE 00000007 "use strict 'subs', 'vars';"
NSQ_SOURCE_LINE 00000008 "use warnings;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "use Exporter qw(import);"
NSQ_SOURCE_LINE 00000011 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000012 "                       get_nodejs_path"
NSQ_SOURCE_LINE 00000013 "                       nodejs_path"
NSQ_SOURCE_LINE 00000014 "                       nodejs_available"
NSQ_SOURCE_LINE 00000015 "                       system_nodejs"
NSQ_SOURCE_LINE 00000016 "                       nodejs_module_path"
NSQ_SOURCE_LINE 00000017 "               );"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "our %SPEC;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "my %arg_all = ("
NSQ_SOURCE_LINE 00000022 "    all => {"
NSQ_SOURCE_LINE 00000023 "        schema => 'bool',"
NSQ_SOURCE_LINE 00000024 "        summary => 'Find all node.js instead of the first found',"
NSQ_SOURCE_LINE 00000025 "        description => <<'_',"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "If this option is set to true, will return an array of paths intead of path."
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "_"
NSQ_SOURCE_LINE 00000030 "    },"
NSQ_SOURCE_LINE 00000031 ");"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "$SPEC{nodejs_path} = {"
NSQ_SOURCE_LINE 00000034 "    v => 1.1,"
NSQ_SOURCE_LINE 00000035 "    summary => 'Check the availability of Node.js executable in PATH',"
NSQ_SOURCE_LINE 00000036 "    description => <<'_',"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "Return the path to executable or undef if none is available. Node.js is usually"
NSQ_SOURCE_LINE 00000039 "installed as 'node' or 'nodejs'."
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "_"
NSQ_SOURCE_LINE 00000042 "    args => {"
NSQ_SOURCE_LINE 00000043 "        %arg_all,"
NSQ_SOURCE_LINE 00000044 "    },"
NSQ_SOURCE_LINE 00000045 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000046 "};"
NSQ_SOURCE_LINE 00000047 "sub nodejs_path {"
NSQ_SOURCE_LINE 00000048 "    require File::Which;"
NSQ_SOURCE_LINE 00000049 "    require IPC::System::Options;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "    my %args = @_;"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "    my @paths;"
NSQ_SOURCE_LINE 00000054 "    for my $name (qw/nodejs node/) {"
NSQ_SOURCE_LINE 00000055 "        my $path = File::Which::which($name);"
NSQ_SOURCE_LINE 00000056 "        next unless $path;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "        # check if it's really nodejs"
NSQ_SOURCE_LINE 00000059 "        my $out = IPC::System::Options::readpipe("
NSQ_SOURCE_LINE 00000060 "            $path, '-e', 'console.log(1+1)');"
NSQ_SOURCE_LINE 00000061 "        if ($out =~ /\\A2\\n?\\z/) {"
NSQ_SOURCE_LINE 00000062 "            return $path unless $args{all};"
NSQ_SOURCE_LINE 00000063 "            push @paths, $path;"
NSQ_SOURCE_LINE 00000064 "        } else {"
NSQ_SOURCE_LINE 00000065 "            #say \"D:Output of $cmd: $out\";"
NSQ_SOURCE_LINE 00000066 "        }"
NSQ_SOURCE_LINE 00000067 "    }"
NSQ_SOURCE_LINE 00000068 "    return undef unless @paths;"
NSQ_SOURCE_LINE 00000069 "    \\@paths;"
NSQ_SOURCE_LINE 00000070 "}"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "*get_nodejs_path = \\&nodejs_path;"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "$SPEC{nodejs_available} = {"
NSQ_SOURCE_LINE 00000075 "    v => 1.1,"
NSQ_SOURCE_LINE 00000076 "    summary => 'Check the availability of Node.js',"
NSQ_SOURCE_LINE 00000077 "    description => <<'_',"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "This is a more advanced alternative to `nodejs_path()`. Will check for `node` or"
NSQ_SOURCE_LINE 00000080 "`nodejs` in the PATH, like `nodejs_path()`. But you can also specify minimum"
NSQ_SOURCE_LINE 00000081 "version (and other options in the future). And it will return more details."
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "Will return status 200 if everything is okay. Actual result will return the path"
NSQ_SOURCE_LINE 00000084 "to executable, and result metadata will contain extra result like detected"
NSQ_SOURCE_LINE 00000085 "version in `func.version`."
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "Will return satus 412 if something is wrong. The return message will tell the"
NSQ_SOURCE_LINE 00000088 "reason."
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "_"
NSQ_SOURCE_LINE 00000091 "    args => {"
NSQ_SOURCE_LINE 00000092 "        min_version => {"
NSQ_SOURCE_LINE 00000093 "            schema => 'str*',"
NSQ_SOURCE_LINE 00000094 "        },"
NSQ_SOURCE_LINE 00000095 "        path => {"
NSQ_SOURCE_LINE 00000096 "            summary => 'Search this instead of PATH environment variable',"
NSQ_SOURCE_LINE 00000097 "            schema => ['str*'],"
NSQ_SOURCE_LINE 00000098 "        },"
NSQ_SOURCE_LINE 00000099 "        %arg_all,"
NSQ_SOURCE_LINE 00000100 "    },"
NSQ_SOURCE_LINE 00000101 "};"
NSQ_SOURCE_LINE 00000102 "sub nodejs_available {"
NSQ_SOURCE_LINE 00000103 "    require IPC::System::Options;"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "    my %args = @_;"
NSQ_SOURCE_LINE 00000106 "    my $all = $args{all};"
NSQ_SOURCE_LINE 00000107 ""
NSQ_SOURCE_LINE 00000108 "    my $paths = do {"
NSQ_SOURCE_LINE 00000109 "        local $ENV{PATH} = $args{path} if defined $args{path};"
NSQ_SOURCE_LINE 00000110 "        nodejs_path(all => 1);"
NSQ_SOURCE_LINE 00000111 "    };"
NSQ_SOURCE_LINE 00000112 "    defined $paths or return [412, \"node.js not detected in PATH\"];"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "    my $res = [200, \"OK\"];"
NSQ_SOURCE_LINE 00000115 "    my @filtered_paths;"
NSQ_SOURCE_LINE 00000116 "    my @versions;"
NSQ_SOURCE_LINE 00000117 "    my @errors;"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "    for my $path (@$paths) {"
NSQ_SOURCE_LINE 00000120 "        my $v;"
NSQ_SOURCE_LINE 00000121 "        if ($args{min_version}) {"
NSQ_SOURCE_LINE 00000122 "            my $out = IPC::System::Options::readpipe("
NSQ_SOURCE_LINE 00000123 "                $path, '-v');"
NSQ_SOURCE_LINE 00000124 "            $out =~ /^(v\\d+\\.\\d+\\.\\d+)$/ or do {"
NSQ_SOURCE_LINE 00000125 "                push @errors, \"Can't recognize output of $path -v: $out\";"
NSQ_SOURCE_LINE 00000126 "                next;"
NSQ_SOURCE_LINE 00000127 "            };"
NSQ_SOURCE_LINE 00000128 "            # node happens to use semantic versioning, which we can parse using"
NSQ_SOURCE_LINE 00000129 "            # version.pm"
NSQ_SOURCE_LINE 00000130 "            $v = version->parse($1);"
NSQ_SOURCE_LINE 00000131 "            $v >= version->parse($args{min_version}) or do {"
NSQ_SOURCE_LINE 00000132 "                push @errors, \"Version of $path less than $args{min_version}\";"
NSQ_SOURCE_LINE 00000133 "                next;"
NSQ_SOURCE_LINE 00000134 "            };"
NSQ_SOURCE_LINE 00000135 "        }"
NSQ_SOURCE_LINE 00000136 "        push @filtered_paths, $path;"
NSQ_SOURCE_LINE 00000137 "        push @versions, defined($v) ? \"$v\" : undef;"
NSQ_SOURCE_LINE 00000138 "    }"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "    $res->[2]                 = $all ? \\@filtered_paths : $filtered_paths[0];"
NSQ_SOURCE_LINE 00000141 "    $res->[3]{'func.path'}    = $all ? \\@filtered_paths : $filtered_paths[0];"
NSQ_SOURCE_LINE 00000142 "    $res->[3]{'func.version'} = $all ? \\@versions       : $versions[0];"
NSQ_SOURCE_LINE 00000143 "    $res->[3]{'func.errors'}  = \\@errors;"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    unless (@filtered_paths) {"
NSQ_SOURCE_LINE 00000146 "        $res->[0] = 412;"
NSQ_SOURCE_LINE 00000147 "        $res->[1] = @errors == 1 ? $errors[0] :"
NSQ_SOURCE_LINE 00000148 "            \"No eligible node.js found in PATH\";"
NSQ_SOURCE_LINE 00000149 "    }"
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "    $res;"
NSQ_SOURCE_LINE 00000152 "}"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "sub system_nodejs {"
NSQ_SOURCE_LINE 00000155 "    require IPC::System::Options;"
NSQ_SOURCE_LINE 00000156 "    my $opts = ref($_[0]) eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "    my $harmony_scoping = delete $opts->{harmony_scoping};"
NSQ_SOURCE_LINE 00000159 "    my $path = delete $opts->{path};"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    my %detect_nodejs_args;"
NSQ_SOURCE_LINE 00000162 "    if ($harmony_scoping) {"
NSQ_SOURCE_LINE 00000163 "        $detect_nodejs_args{min_version} = '0.5.10';"
NSQ_SOURCE_LINE 00000164 "    }"
NSQ_SOURCE_LINE 00000165 "    if ($path) {"
NSQ_SOURCE_LINE 00000166 "        $detect_nodejs_args{path} = $path;"
NSQ_SOURCE_LINE 00000167 "    }"
NSQ_SOURCE_LINE 00000168 "    my $detect_res = nodejs_available(%detect_nodejs_args);"
NSQ_SOURCE_LINE 00000169 "    die \"No eligible node.js binary available: \"."
NSQ_SOURCE_LINE 00000170 "        \"$detect_res->[0] - $detect_res->[1]\" unless $detect_res->[0] == 200;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    my @extra_args;"
NSQ_SOURCE_LINE 00000173 "    if ($harmony_scoping) {"
NSQ_SOURCE_LINE 00000174 "        my $node_v = $detect_res->[3]{'func.version'};"
NSQ_SOURCE_LINE 00000175 "        if (version->parse($node_v) < version->parse(\"2.0.0\")) {"
NSQ_SOURCE_LINE 00000176 "            push @extra_args, \"--use_strict\", \"--harmony_scoping\";"
NSQ_SOURCE_LINE 00000177 "        } else {"
NSQ_SOURCE_LINE 00000178 "            push @extra_args, \"--use_strict\";"
NSQ_SOURCE_LINE 00000179 "        }"
NSQ_SOURCE_LINE 00000180 "    }"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "    IPC::System::Options::system("
NSQ_SOURCE_LINE 00000183 "        $opts,"
NSQ_SOURCE_LINE 00000184 "        $detect_res->[2],"
NSQ_SOURCE_LINE 00000185 "        @extra_args,"
NSQ_SOURCE_LINE 00000186 "        @_,"
NSQ_SOURCE_LINE 00000187 "    );"
NSQ_SOURCE_LINE 00000188 "}"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "sub nodejs_module_path {"
NSQ_SOURCE_LINE 00000191 "    my $opts = ref $_[0] eq 'HASH' ? shift : {};"
NSQ_SOURCE_LINE 00000192 "    my $module = shift;"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "    my ($dir, $name, $ext) = $module =~ m!\\A(?:(.*)/)?(.+?)(\\.\\w+)?\\z!;"
NSQ_SOURCE_LINE 00000195 "    #use DD; dd {dir=>$dir, name=>$name, ext=>$ext};"
NSQ_SOURCE_LINE 00000196 ""
NSQ_SOURCE_LINE 00000197 "    my  @dirs;"
NSQ_SOURCE_LINE 00000198 "    if (defined $dir) {"
NSQ_SOURCE_LINE 00000199 "        @dirs = ($dir);"
NSQ_SOURCE_LINE 00000200 "    } else {"
NSQ_SOURCE_LINE 00000201 "        my $cwd = do {"
NSQ_SOURCE_LINE 00000202 "            if (defined $opts->{cwd}) {"
NSQ_SOURCE_LINE 00000203 "                $opts->{cwd};"
NSQ_SOURCE_LINE 00000204 "            } else {"
NSQ_SOURCE_LINE 00000205 "                require Cwd;"
NSQ_SOURCE_LINE 00000206 "                Cwd::getcwd();"
NSQ_SOURCE_LINE 00000207 "            }"
NSQ_SOURCE_LINE 00000208 "        };"
NSQ_SOURCE_LINE 00000209 "        $cwd =~ s!/node_modules\\z!!;"
NSQ_SOURCE_LINE 00000210 "        while (1) {"
NSQ_SOURCE_LINE 00000211 "            push @dirs, \"$cwd/node_modules\";"
NSQ_SOURCE_LINE 00000212 "            $cwd =~ s!(.*)/.+!$1!"
NSQ_SOURCE_LINE 00000213 "                or last;"
NSQ_SOURCE_LINE 00000214 "        }"
NSQ_SOURCE_LINE 00000215 "    }"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "    if (defined $ENV{NODE_PATH}) {"
NSQ_SOURCE_LINE 00000218 "        my $sep = $^O =~ /win32/i ? qr/;/ : qr/:/;"
NSQ_SOURCE_LINE 00000219 "        push @dirs, split($sep, $ENV{NODE_PATH});"
NSQ_SOURCE_LINE 00000220 "    }"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "    if (defined $ENV{HOME}) {"
NSQ_SOURCE_LINE 00000223 "        push @dirs, \"$ENV{HOME}/.node_modules\";"
NSQ_SOURCE_LINE 00000224 "        push @dirs, \"$ENV{HOME}/.node_libraries\";"
NSQ_SOURCE_LINE 00000225 "    }"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "    if (defined $ENV{PREFIX}) {"
NSQ_SOURCE_LINE 00000228 "        push @dirs, \"$ENV{PREFIX}/lib/node\";"
NSQ_SOURCE_LINE 00000229 "    }"
NSQ_SOURCE_LINE 00000230 ""
NSQ_SOURCE_LINE 00000231 "    #use DD; dd \\@dirs;"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "    my @res;"
NSQ_SOURCE_LINE 00000234 "    for my $d (@dirs) {"
NSQ_SOURCE_LINE 00000235 "        next unless -d $d;"
NSQ_SOURCE_LINE 00000236 "        if (defined $ext) {"
NSQ_SOURCE_LINE 00000237 "            my $p = \"$d/$name$ext\";"
NSQ_SOURCE_LINE 00000238 "            if (-f $p) {"
NSQ_SOURCE_LINE 00000239 "                push @res, $p;"
NSQ_SOURCE_LINE 00000240 "                last unless $opts->{all};"
NSQ_SOURCE_LINE 00000241 "            }"
NSQ_SOURCE_LINE 00000242 "        } else {"
NSQ_SOURCE_LINE 00000243 "            my $p;"
NSQ_SOURCE_LINE 00000244 "            for my $e (\".js\", \".json\", \".node\") {"
NSQ_SOURCE_LINE 00000245 "                $p = \"$d/$name$e\";"
NSQ_SOURCE_LINE 00000246 "                if (-f $p) {"
NSQ_SOURCE_LINE 00000247 "                    push @res, $p;"
NSQ_SOURCE_LINE 00000248 "                    last unless $opts->{all};"
NSQ_SOURCE_LINE 00000249 "                }"
NSQ_SOURCE_LINE 00000250 "            }"
NSQ_SOURCE_LINE 00000251 "            $p = \"$d/$name\";"
NSQ_SOURCE_LINE 00000252 "            if (-d $p) {"
NSQ_SOURCE_LINE 00000253 "                if (-f \"$p/index.js\") {"
NSQ_SOURCE_LINE 00000254 "                    push @res, \"$p/index.js\";"
NSQ_SOURCE_LINE 00000255 "                    last unless $opts->{all};"
NSQ_SOURCE_LINE 00000256 "                } elsif (-f \"$p/package.json\") {"
NSQ_SOURCE_LINE 00000257 "                    push @res, \"$p/package.json\";"
NSQ_SOURCE_LINE 00000258 "                    last unless $opts->{all};"
NSQ_SOURCE_LINE 00000259 "                }"
NSQ_SOURCE_LINE 00000260 "            }"
NSQ_SOURCE_LINE 00000261 "        }"
NSQ_SOURCE_LINE 00000262 "    }"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "    if ($opts->{all}) {"
NSQ_SOURCE_LINE 00000265 "        return \\@res;"
NSQ_SOURCE_LINE 00000266 "    } else {"
NSQ_SOURCE_LINE 00000267 "        return $res[0];"
NSQ_SOURCE_LINE 00000268 "    }"
NSQ_SOURCE_LINE 00000269 "}"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "1;"
NSQ_SOURCE_LINE 00000272 "# ABSTRACT: Utilities related to Node.js"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "__END__"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "=pod"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "=head1 NAME"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "Nodejs::Util - Utilities related to Node.js"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "=head1 VERSION"
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "This document describes version 0.012 of Nodejs::Util (from Perl distribution Nodejs-Util), released on 2018-03-21."
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "=for Pod::Coverage ^(get_nodejs_path)$"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "=head2 nodejs_available"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "Usage:"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 " nodejs_available(%args) -> [status, msg, result, meta]"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "Check the availability of Node.js."
NSQ_SOURCE_LINE 00000300 ""
NSQ_SOURCE_LINE 00000301 "This is a more advanced alternative to C<nodejs_path()>. Will check for C<node> or"
NSQ_SOURCE_LINE 00000302 "C<nodejs> in the PATH, like C<nodejs_path()>. But you can also specify minimum"
NSQ_SOURCE_LINE 00000303 "version (and other options in the future). And it will return more details."
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "Will return status 200 if everything is okay. Actual result will return the path"
NSQ_SOURCE_LINE 00000306 "to executable, and result metadata will contain extra result like detected"
NSQ_SOURCE_LINE 00000307 "version in C<func.version>."
NSQ_SOURCE_LINE 00000308 ""
NSQ_SOURCE_LINE 00000309 "Will return satus 412 if something is wrong. The return message will tell the"
NSQ_SOURCE_LINE 00000310 "reason."
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "=over 4"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "=item * B<all> => I<bool>"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "Find all node.js instead of the first found."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "If this option is set to true, will return an array of paths intead of path."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=item * B<min_version> => I<str>"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "=item * B<path> => I<str>"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "Search this instead of PATH environment variable."
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=back"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "Returns an enveloped result (an array)."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "First element (status) is an integer containing HTTP status code"
NSQ_SOURCE_LINE 00000335 "(200 means OK, 4xx caller error, 5xx function error). Second element"
NSQ_SOURCE_LINE 00000336 "(msg) is a string containing error message, or 'OK' if status is"
NSQ_SOURCE_LINE 00000337 "200. Third element (result) is optional, the actual result. Fourth"
NSQ_SOURCE_LINE 00000338 "element (meta) is called result metadata and is optional, a hash"
NSQ_SOURCE_LINE 00000339 "that contains extra information."
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "Return value:  (any)"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "=head2 nodejs_path"
NSQ_SOURCE_LINE 00000345 ""
NSQ_SOURCE_LINE 00000346 "Usage:"
NSQ_SOURCE_LINE 00000347 ""
NSQ_SOURCE_LINE 00000348 " nodejs_path(%args) -> any"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "Check the availability of Node.js executable in PATH."
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "Return the path to executable or undef if none is available. Node.js is usually"
NSQ_SOURCE_LINE 00000353 "installed as 'node' or 'nodejs'."
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 "=over 4"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "=item * B<all> => I<bool>"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "Find all node.js instead of the first found."
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "If this option is set to true, will return an array of paths intead of path."
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "=back"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "Return value:  (any)"
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=head2 system_nodejs"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "Usage:"
NSQ_SOURCE_LINE 00000374 ""
NSQ_SOURCE_LINE 00000375 " system_nodejs([ \\%opts ], @argv)"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "Will call L<IPC::System::Options>'s system(), but with node.js binary as the"
NSQ_SOURCE_LINE 00000378 "first argument. Known options:"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "=over"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=item * harmony_scoping => bool"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "If set to 1, will attempt to enable block scoping. This means at least node.js"
NSQ_SOURCE_LINE 00000385 "v0.5.10 (where C<--harmony_scoping> is first recognized). But"
NSQ_SOURCE_LINE 00000386 "C<--harmony_scoping> is no longer needed after v2.0.0 and no longer recognized"
NSQ_SOURCE_LINE 00000387 "in later versions."
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "=item * path => str"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "Will be passed to C<nodejs_available()>."
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "=back"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "Other options will be passed to C<IPC::System::Options>'s C<system()>."
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "=head2 nodejs_module_path"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "Usage:"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 " nodejs_module_path([ \\%opts, ] $module) => str|array"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "Search module in filesystem according to Node.js rule described in"
NSQ_SOURCE_LINE 00000404 "L<https://nodejs.org/api/modules.html>. C<$module> can be either a"
NSQ_SOURCE_LINE 00000405 "relative/absolute path (e.g. C<./bip39.js>, C<../bip39.js>, or"
NSQ_SOURCE_LINE 00000406 "C</home/foo/bip39.js>), a filename (e.g. C<bip39.js>), or a filename with the"
NSQ_SOURCE_LINE 00000407 "C<.js> removed (e.g. C<bip39>)."
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "Will return undef if no module is found, or string containing the found path."
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "Known options:"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "=over"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "=item * parse_package_json => bool (default: 0)"
NSQ_SOURCE_LINE 00000416 ""
NSQ_SOURCE_LINE 00000417 "Not yet implemented."
NSQ_SOURCE_LINE 00000418 ""
NSQ_SOURCE_LINE 00000419 "=item * cwd => str"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "Use this directory instead of using C<Cwd::get_cwd()>."
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "=item * all => bool"
NSQ_SOURCE_LINE 00000424 ""
NSQ_SOURCE_LINE 00000425 "If set to true, will return an array of all found paths instead of string"
NSQ_SOURCE_LINE 00000426 "containing the first found path."
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "=back"
