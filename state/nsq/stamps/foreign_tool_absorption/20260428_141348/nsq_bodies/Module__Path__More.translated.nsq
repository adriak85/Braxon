NSQ_SOURCE_LINE 00000001 "package Module::Path::More;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 "our $DATE = '2021-07-20'; # DATE"
NSQ_SOURCE_LINE 00000005 "our $DIST = 'Module-Path-More'; # DIST"
NSQ_SOURCE_LINE 00000006 "our $VERSION = '0.340'; # VERSION"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use 5.010001;"
NSQ_SOURCE_LINE 00000009 "use strict;"
NSQ_SOURCE_LINE 00000010 "use warnings;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "require Exporter;"
NSQ_SOURCE_LINE 00000013 "our @ISA       = qw(Exporter);"
NSQ_SOURCE_LINE 00000014 "our @EXPORT_OK = qw(module_path pod_path);"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our $SEPARATOR;"
NSQ_SOURCE_LINE 00000017 ""
NSQ_SOURCE_LINE 00000018 "our %SPEC;"
NSQ_SOURCE_LINE 00000019 ""
NSQ_SOURCE_LINE 00000020 "$SPEC{':package'} = {"
NSQ_SOURCE_LINE 00000021 "    v => 1.1,"
NSQ_SOURCE_LINE 00000022 "    summary => 'Get path to locally installed Perl module',"
NSQ_SOURCE_LINE 00000023 "};"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "BEGIN {"
NSQ_SOURCE_LINE 00000026 "    if ($^O =~ /^(dos|os2)/i) {"
NSQ_SOURCE_LINE 00000027 "        $SEPARATOR = '\\\\';"
NSQ_SOURCE_LINE 00000028 "    } elsif ($^O =~ /^MacOS/i) {"
NSQ_SOURCE_LINE 00000029 "        $SEPARATOR = ':';"
NSQ_SOURCE_LINE 00000030 "    } else {"
NSQ_SOURCE_LINE 00000031 "        $SEPARATOR = '/';"
NSQ_SOURCE_LINE 00000032 "    }"
NSQ_SOURCE_LINE 00000033 "}"
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "$SPEC{module_path} = {"
NSQ_SOURCE_LINE 00000036 "    v => 1.1,"
NSQ_SOURCE_LINE 00000037 "    summary => 'Get path to locally installed Perl module',"
NSQ_SOURCE_LINE 00000038 "    description => <<'_',"
NSQ_SOURCE_LINE 00000039 ""
NSQ_SOURCE_LINE 00000040 "Search `@INC` (reference entries are skipped) and return path(s) to Perl module"
NSQ_SOURCE_LINE 00000041 "files with the requested name."
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "This function is like the one from <pm:Module::Path>, except with a different"
NSQ_SOURCE_LINE 00000044 "interface and more options (finding all matches instead of the first, the option"
NSQ_SOURCE_LINE 00000045 "of not absolutizing paths, finding `.pmc` & `.pod` files, finding module"
NSQ_SOURCE_LINE 00000046 "prefixes)."
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "_"
NSQ_SOURCE_LINE 00000049 "    args => {"
NSQ_SOURCE_LINE 00000050 "        module => {"
NSQ_SOURCE_LINE 00000051 "            summary => 'Module name to search',"
NSQ_SOURCE_LINE 00000052 "            schema  => 'str*',"
NSQ_SOURCE_LINE 00000053 "            req     => 1,"
NSQ_SOURCE_LINE 00000054 "            pos     => 0,"
NSQ_SOURCE_LINE 00000055 "        },"
NSQ_SOURCE_LINE 00000056 "        find_pm => {"
NSQ_SOURCE_LINE 00000057 "            summary => 'Whether to find .pm files',"
NSQ_SOURCE_LINE 00000058 "            schema  => ['int*', min=>0],"
NSQ_SOURCE_LINE 00000059 "            default => 1,"
NSQ_SOURCE_LINE 00000060 "            description => <<'_',"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "The value of this option is an integer number from 0. 0 means to not search for"
NSQ_SOURCE_LINE 00000063 ".pm files, while number larger than 0 means to search for .pm files. The larger"
NSQ_SOURCE_LINE 00000064 "the number, the lower the priority. If more than one type is found (prefix, .pm,"
NSQ_SOURCE_LINE 00000065 ".pmc, .pod) then the type with the lowest number is returned first."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "_"
NSQ_SOURCE_LINE 00000068 "        },"
NSQ_SOURCE_LINE 00000069 "        find_pmc => {"
NSQ_SOURCE_LINE 00000070 "            summary => 'Whether to find .pmc files',"
NSQ_SOURCE_LINE 00000071 "            schema  => ['int*', min=>0],"
NSQ_SOURCE_LINE 00000072 "            default => 2,"
NSQ_SOURCE_LINE 00000073 "            description => <<'_',"
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "The value of this option is an integer number from 0. 0 means to not search for"
NSQ_SOURCE_LINE 00000076 ".pmc files, while number larger than 0 means to search for .pmc files. The"
NSQ_SOURCE_LINE 00000077 "larger the number, the lower the priority. If more than one type is found"
NSQ_SOURCE_LINE 00000078 "(prefix, .pm, .pmc, .pod) then the type with the lowest number is returned"
NSQ_SOURCE_LINE 00000079 "first."
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "_"
NSQ_SOURCE_LINE 00000082 "        },"
NSQ_SOURCE_LINE 00000083 "        find_pod => {"
NSQ_SOURCE_LINE 00000084 "            summary => 'Whether to find .pod files',"
NSQ_SOURCE_LINE 00000085 "            schema  => ['int*', min=>0],"
NSQ_SOURCE_LINE 00000086 "            default => 0,"
NSQ_SOURCE_LINE 00000087 "            description => <<'_',"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "The value of this option is an integer number from 0. 0 means to not search for"
NSQ_SOURCE_LINE 00000090 ".pod files, while number larger than 0 means to search for .pod files. The"
NSQ_SOURCE_LINE 00000091 "larger the number, the lower the priority. If more than one type is found"
NSQ_SOURCE_LINE 00000092 "(prefix, .pm, .pmc, .pod) then the type with the lowest number is returned"
NSQ_SOURCE_LINE 00000093 "first."
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "_"
NSQ_SOURCE_LINE 00000096 "        },"
NSQ_SOURCE_LINE 00000097 "        find_prefix => {"
NSQ_SOURCE_LINE 00000098 "            summary => 'Whether to find module prefixes',"
NSQ_SOURCE_LINE 00000099 "            schema  => ['int*', min=>0],"
NSQ_SOURCE_LINE 00000100 "            default => 0,"
NSQ_SOURCE_LINE 00000101 "            description => <<'_',"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "The value of this option is an integer number from 0. 0 means to not search for"
NSQ_SOURCE_LINE 00000104 "module prefix, while number larger than 0 means to search for module prefix. The"
NSQ_SOURCE_LINE 00000105 "larger the number, the lower the priority. If more than one type is found"
NSQ_SOURCE_LINE 00000106 "(prefix, .pm, .pmc, .pod) then the type with the lowest number is returned"
NSQ_SOURCE_LINE 00000107 "first."
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "_"
NSQ_SOURCE_LINE 00000110 "        },"
NSQ_SOURCE_LINE 00000111 "        all => {"
NSQ_SOURCE_LINE 00000112 "            summary => 'Return all results instead of just the first',"
NSQ_SOURCE_LINE 00000113 "            schema  => 'bool',"
NSQ_SOURCE_LINE 00000114 "            default => 0,"
NSQ_SOURCE_LINE 00000115 "        },"
NSQ_SOURCE_LINE 00000116 "        abs => {"
NSQ_SOURCE_LINE 00000117 "            summary => 'Whether to return absolute paths',"
NSQ_SOURCE_LINE 00000118 "            schema  => 'bool',"
NSQ_SOURCE_LINE 00000119 "            default => 0,"
NSQ_SOURCE_LINE 00000120 "        },"
NSQ_SOURCE_LINE 00000121 "    },"
NSQ_SOURCE_LINE 00000122 "    result => {"
NSQ_SOURCE_LINE 00000123 "        schema => ['any' => of => ['str*', ['array*' => of => 'str*']]],"
NSQ_SOURCE_LINE 00000124 "    },"
NSQ_SOURCE_LINE 00000125 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000126 "    examples => ["
NSQ_SOURCE_LINE 00000127 "        {"
NSQ_SOURCE_LINE 00000128 "            summary => 'Find the first Foo::Bar (.pm or .pmc) in @INC',"
NSQ_SOURCE_LINE 00000129 "            args => {module => 'Foo::Bar'},"
NSQ_SOURCE_LINE 00000130 "        },"
NSQ_SOURCE_LINE 00000131 "        {"
NSQ_SOURCE_LINE 00000132 "            summary => 'Find all Foo::Bar (.pm or .pmc) in @INC, return absolute paths',"
NSQ_SOURCE_LINE 00000133 "            args => {module => 'Foo::Bar', all => 1, abs => 1},"
NSQ_SOURCE_LINE 00000134 "        },"
NSQ_SOURCE_LINE 00000135 "        {"
NSQ_SOURCE_LINE 00000136 "            summary => 'Find the Rinci (.pod first, then .pm) in @INC',"
NSQ_SOURCE_LINE 00000137 "            args => {module => 'Rinci', find_pod => 1, find_pm => 2, find_pmc => 0},"
NSQ_SOURCE_LINE 00000138 "        },"
NSQ_SOURCE_LINE 00000139 "    ],"
NSQ_SOURCE_LINE 00000140 "};"
NSQ_SOURCE_LINE 00000141 "sub module_path {"
NSQ_SOURCE_LINE 00000142 "    my %args = @_;"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "    my $module = $args{module} or die \"Please specify module\";"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "    $args{abs}         //= 0;"
NSQ_SOURCE_LINE 00000147 "    $args{all}         //= 0;"
NSQ_SOURCE_LINE 00000148 "    $args{find_pm}     //= 1;"
NSQ_SOURCE_LINE 00000149 "    $args{find_pmc}    //= 2;"
NSQ_SOURCE_LINE 00000150 "    $args{find_pod}    //= 0;"
NSQ_SOURCE_LINE 00000151 "    $args{find_prefix} //= 0;"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "    require Cwd if $args{abs};"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "    my @res;"
NSQ_SOURCE_LINE 00000156 "    my %unfound = ("
NSQ_SOURCE_LINE 00000157 "        (\"pm\" => 1)     x !!$args{find_pm},"
NSQ_SOURCE_LINE 00000158 "        (\"pmc\" => 1)    x !!$args{find_pmc},"
NSQ_SOURCE_LINE 00000159 "        (\"pod\" => 1)    x !!$args{find_pod},"
NSQ_SOURCE_LINE 00000160 "        (\"prefix\" => 1) x !!$args{find_prefix},"
NSQ_SOURCE_LINE 00000161 "    );"
NSQ_SOURCE_LINE 00000162 "    my $add = sub {"
NSQ_SOURCE_LINE 00000163 "        my ($path, $prio) = @_;"
NSQ_SOURCE_LINE 00000164 "        push @res, [$args{abs} ? Cwd::abs_path($path) : $path, $prio];"
NSQ_SOURCE_LINE 00000165 "    };"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    my $relpath;"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "    ($relpath = $module) =~ s/::/$SEPARATOR/g;"
NSQ_SOURCE_LINE 00000170 "    $relpath =~ s/\\.(pm|pmc|pod)\\z//i;"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "    foreach my $dir (@INC) {"
NSQ_SOURCE_LINE 00000173 "        next if not defined($dir);"
NSQ_SOURCE_LINE 00000174 "        next if ref($dir);"
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "        my $prefix = $dir . $SEPARATOR . $relpath;"
NSQ_SOURCE_LINE 00000177 "        if ($args{find_pm}) {"
NSQ_SOURCE_LINE 00000178 "            my $file = $prefix . \".pm\";"
NSQ_SOURCE_LINE 00000179 "            if (-f $file) {"
NSQ_SOURCE_LINE 00000180 "                $add->($file, $args{find_pm});"
NSQ_SOURCE_LINE 00000181 "                delete $unfound{pm};"
NSQ_SOURCE_LINE 00000182 "                last if !keys(%unfound) && !$args{all};"
NSQ_SOURCE_LINE 00000183 "            }"
NSQ_SOURCE_LINE 00000184 "        }"
NSQ_SOURCE_LINE 00000185 "        if ($args{find_pmc}) {"
NSQ_SOURCE_LINE 00000186 "            my $file = $prefix . \".pmc\";"
NSQ_SOURCE_LINE 00000187 "            if (-f $file) {"
NSQ_SOURCE_LINE 00000188 "                $add->($file, $args{find_pmc});"
NSQ_SOURCE_LINE 00000189 "                delete $unfound{pmc};"
NSQ_SOURCE_LINE 00000190 "                last if !keys(%unfound) && !$args{all};"
NSQ_SOURCE_LINE 00000191 "            }"
NSQ_SOURCE_LINE 00000192 "        }"
NSQ_SOURCE_LINE 00000193 "        if ($args{find_pod}) {"
NSQ_SOURCE_LINE 00000194 "            my $file = $prefix . \".pod\";"
NSQ_SOURCE_LINE 00000195 "            if (-f $file) {"
NSQ_SOURCE_LINE 00000196 "                $add->($file, $args{find_pod});"
NSQ_SOURCE_LINE 00000197 "                delete $unfound{pod};"
NSQ_SOURCE_LINE 00000198 "                last if !keys(%unfound) && !$args{all};"
NSQ_SOURCE_LINE 00000199 "            }"
NSQ_SOURCE_LINE 00000200 "        }"
NSQ_SOURCE_LINE 00000201 "        if ($args{find_prefix}) {"
NSQ_SOURCE_LINE 00000202 "            if (-d $prefix) {"
NSQ_SOURCE_LINE 00000203 "                $add->($prefix, $args{find_prefix});"
NSQ_SOURCE_LINE 00000204 "                delete $unfound{prefix};"
NSQ_SOURCE_LINE 00000205 "                last if !keys(%unfound) && !$args{all};"
NSQ_SOURCE_LINE 00000206 "            }"
NSQ_SOURCE_LINE 00000207 "        }"
NSQ_SOURCE_LINE 00000208 "    }"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "    @res = map { $_->[0] } sort { $a->[1] <=> $b->[1] } @res;"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "    if ($args{all}) {"
NSQ_SOURCE_LINE 00000213 "        return \\@res;"
NSQ_SOURCE_LINE 00000214 "    } else {"
NSQ_SOURCE_LINE 00000215 "        return @res ? $res[0] : undef;"
NSQ_SOURCE_LINE 00000216 "    }"
NSQ_SOURCE_LINE 00000217 "}"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "$SPEC{pod_path} = {"
NSQ_SOURCE_LINE 00000220 "    v => 1.1,"
NSQ_SOURCE_LINE 00000221 "    summary => 'Get path to locally installed POD',"
NSQ_SOURCE_LINE 00000222 "    description => <<'_',"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "This is a shortcut for:"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "    module_path(%args, find_pm=>0, find_pmc=>0, find_pod=>1, find_prefix=>0)"
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "_"
NSQ_SOURCE_LINE 00000229 "    args => {"
NSQ_SOURCE_LINE 00000230 "        module => {"
NSQ_SOURCE_LINE 00000231 "            summary => 'Module name to search',"
NSQ_SOURCE_LINE 00000232 "            schema  => 'str*',"
NSQ_SOURCE_LINE 00000233 "            req     => 1,"
NSQ_SOURCE_LINE 00000234 "            pos     => 0,"
NSQ_SOURCE_LINE 00000235 "        },"
NSQ_SOURCE_LINE 00000236 "        all => {"
NSQ_SOURCE_LINE 00000237 "            summary => 'Return all results instead of just the first',"
NSQ_SOURCE_LINE 00000238 "            schema  => 'bool',"
NSQ_SOURCE_LINE 00000239 "            default => 0,"
NSQ_SOURCE_LINE 00000240 "        },"
NSQ_SOURCE_LINE 00000241 "        abs => {"
NSQ_SOURCE_LINE 00000242 "            summary => 'Whether to return absolute paths',"
NSQ_SOURCE_LINE 00000243 "            schema  => 'bool',"
NSQ_SOURCE_LINE 00000244 "            default => 0,"
NSQ_SOURCE_LINE 00000245 "        },"
NSQ_SOURCE_LINE 00000246 "    },"
NSQ_SOURCE_LINE 00000247 "    result => {"
NSQ_SOURCE_LINE 00000248 "        schema => ['any' => of => ['str*', ['array*' => of => 'str*']]],"
NSQ_SOURCE_LINE 00000249 "    },"
NSQ_SOURCE_LINE 00000250 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000251 "};"
NSQ_SOURCE_LINE 00000252 "sub pod_path {"
NSQ_SOURCE_LINE 00000253 "    module_path(@_, find_pm=>0, find_pmc=>0, find_pod=>1, find_prefix=>0);"
NSQ_SOURCE_LINE 00000254 "}"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "1;"
NSQ_SOURCE_LINE 00000257 "# ABSTRACT: Get path to locally installed Perl module"
NSQ_SOURCE_LINE 00000258 ""
NSQ_SOURCE_LINE 00000259 "__END__"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "=pod"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "=head1 NAME"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "Module::Path::More - Get path to locally installed Perl module"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=head1 VERSION"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "This document describes version 0.340 of Module::Path::More (from Perl distribution Module-Path-More), released on 2021-07-20."
NSQ_SOURCE_LINE 00000272 ""
NSQ_SOURCE_LINE 00000273 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 " use Module::Path::More qw(module_path pod_path);"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 " $path = module_path(module=>'Test::More');"
NSQ_SOURCE_LINE 00000278 " if (defined($path)) {"
NSQ_SOURCE_LINE 00000279 "   print \"Test::More found at $path\\n\";"
NSQ_SOURCE_LINE 00000280 " } else {"
NSQ_SOURCE_LINE 00000281 "   print \"Danger Will Robinson!\\n\";"
NSQ_SOURCE_LINE 00000282 " }"
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 " # find all found modules, as well as .pmc and .pod files"
NSQ_SOURCE_LINE 00000285 " $paths = module_path(module=>'Foo::Bar', all=>1, find_pmc=>1, find_pod=>1);"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 " # just a shortcut for module_path(module=>'Foo',"
NSQ_SOURCE_LINE 00000288 " #                                 find_pm=>0, find_pmc=>0, find_pod=>1);"
NSQ_SOURCE_LINE 00000289 " $path = pod_path(module=>'Foo');"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "Module::Path::More provides a function, C<module_path()>, which will find where"
NSQ_SOURCE_LINE 00000294 "a module (or module prefix, or .pod file) is installed locally. (There is also"
NSQ_SOURCE_LINE 00000295 "another function C<pod_path()> which is just a convenience wrapper.)"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "It works by looking in all the directories in @INC for an appropriately named"
NSQ_SOURCE_LINE 00000298 "file. If module is C<Foo::Bar>, will search for C<Foo/Bar.pm>, C<Foo/Bar.pmc>"
NSQ_SOURCE_LINE 00000299 "(if C<find_pmc> argument is true), C<Foo/Bar> directory (if C<find_prefix>"
NSQ_SOURCE_LINE 00000300 "argument is true), or C<Foo/Bar.pod> (if C<find_pod> argument is true)."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "Caveats: Obviously this only works where the module you're after has its own"
NSQ_SOURCE_LINE 00000303 "C<.pm> file. If a file defines multiple packages, this won't work. This also"
NSQ_SOURCE_LINE 00000304 "won't find any modules that are being loaded in some special way, for example"
NSQ_SOURCE_LINE 00000305 "using a code reference in C<@INC>, as described in C<require> in L<perlfunc>."
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "To check whether a module is available/loadable, it's generally better to use"
NSQ_SOURCE_LINE 00000308 "something like:"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 " if (eval { require Some::Module; 1 }) {"
NSQ_SOURCE_LINE 00000311 "     # module is available"
NSQ_SOURCE_LINE 00000312 " }"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "because this works with fatpacking or any other C<@INC> hook that might be"
NSQ_SOURCE_LINE 00000315 "installed. If you use:"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 " if (module_path(module => \"Some::Module\")) {"
NSQ_SOURCE_LINE 00000318 "     # module is available"
NSQ_SOURCE_LINE 00000319 " }"
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "then it only works if the module is locatable in the filesystem. But on the"
NSQ_SOURCE_LINE 00000322 "other hand this method can avoid actual loading of the module."
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "=head1 CONTRIBUTOR"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "=for stopwords Steven Haryanto"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "Steven Haryanto <sharyanto@cpan.org>"
NSQ_SOURCE_LINE 00000329 ""
NSQ_SOURCE_LINE 00000330 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 ""
NSQ_SOURCE_LINE 00000333 "=head2 module_path"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "Usage:"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 " module_path(%args) -> str|array[str]"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "Get path to locally installed Perl module."
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "Examples:"
NSQ_SOURCE_LINE 00000342 ""
NSQ_SOURCE_LINE 00000343 "=over"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "=item * Find the first Foo::Bar (.pm or .pmc) in @INC:"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 " module_path(module => \"Foo::Bar\");"
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "Result:"
NSQ_SOURCE_LINE 00000350 ""
NSQ_SOURCE_LINE 00000351 " \"/home/s1/perl5/perlbrew/perls/perl-5.30.2/lib/site_perl/5.30.2/Foo/Bar.pm\""
NSQ_SOURCE_LINE 00000352 ""
NSQ_SOURCE_LINE 00000353 "=item * Find all Foo::Bar (.pm or .pmc) in @INC, return absolute paths:"
NSQ_SOURCE_LINE 00000354 ""
NSQ_SOURCE_LINE 00000355 " module_path(module => \"Foo::Bar\", abs => 1, all => 1);"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "Result:"
NSQ_SOURCE_LINE 00000358 ""
NSQ_SOURCE_LINE 00000359 " ["
NSQ_SOURCE_LINE 00000360 "   \"/zpool_host_mnt/mnt/home/s1/perl5/perlbrew/perls/perl-5.30.2/lib/site_perl/5.30.2/Foo/Bar.pm\","
NSQ_SOURCE_LINE 00000361 " ]"
NSQ_SOURCE_LINE 00000362 ""
NSQ_SOURCE_LINE 00000363 "=item * Find the Rinci (.pod first, then .pm) in @INC:"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 " module_path(module => \"Rinci\", find_pm => 2, find_pmc => 0, find_pod => 1);"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "Result:"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 " \"/home/s1/perl5/perlbrew/perls/perl-5.30.2/lib/site_perl/5.30.2/Rinci.pod\""
NSQ_SOURCE_LINE 00000370 ""
NSQ_SOURCE_LINE 00000371 "=back"
NSQ_SOURCE_LINE 00000372 ""
NSQ_SOURCE_LINE 00000373 "Search C<@INC> (reference entries are skipped) and return path(s) to Perl module"
NSQ_SOURCE_LINE 00000374 "files with the requested name."
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "This function is like the one from L<Module::Path>, except with a different"
NSQ_SOURCE_LINE 00000377 "interface and more options (finding all matches instead of the first, the option"
NSQ_SOURCE_LINE 00000378 "of not absolutizing paths, finding C<.pmc> & C<.pod> files, finding module"
NSQ_SOURCE_LINE 00000379 "prefixes)."
NSQ_SOURCE_LINE 00000380 ""
NSQ_SOURCE_LINE 00000381 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=over 4"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "=item * B<abs> => I<bool> (default: 0)"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "Whether to return absolute paths."
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "=item * B<all> => I<bool> (default: 0)"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "Return all results instead of just the first."
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=item * B<find_pm> => I<int> (default: 1)"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "Whether to find .pm files."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "The value of this option is an integer number from 0. 0 means to not search for"
NSQ_SOURCE_LINE 00000400 ".pm files, while number larger than 0 means to search for .pm files. The larger"
NSQ_SOURCE_LINE 00000401 "the number, the lower the priority. If more than one type is found (prefix, .pm,"
NSQ_SOURCE_LINE 00000402 ".pmc, .pod) then the type with the lowest number is returned first."
NSQ_SOURCE_LINE 00000403 ""
NSQ_SOURCE_LINE 00000404 "=item * B<find_pmc> => I<int> (default: 2)"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "Whether to find .pmc files."
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "The value of this option is an integer number from 0. 0 means to not search for"
NSQ_SOURCE_LINE 00000409 ".pmc files, while number larger than 0 means to search for .pmc files. The"
NSQ_SOURCE_LINE 00000410 "larger the number, the lower the priority. If more than one type is found"
NSQ_SOURCE_LINE 00000411 "(prefix, .pm, .pmc, .pod) then the type with the lowest number is returned"
NSQ_SOURCE_LINE 00000412 "first."
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "=item * B<find_pod> => I<int> (default: 0)"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "Whether to find .pod files."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "The value of this option is an integer number from 0. 0 means to not search for"
NSQ_SOURCE_LINE 00000419 ".pod files, while number larger than 0 means to search for .pod files. The"
NSQ_SOURCE_LINE 00000420 "larger the number, the lower the priority. If more than one type is found"
NSQ_SOURCE_LINE 00000421 "(prefix, .pm, .pmc, .pod) then the type with the lowest number is returned"
NSQ_SOURCE_LINE 00000422 "first."
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "=item * B<find_prefix> => I<int> (default: 0)"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "Whether to find module prefixes."
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "The value of this option is an integer number from 0. 0 means to not search for"
NSQ_SOURCE_LINE 00000429 "module prefix, while number larger than 0 means to search for module prefix. The"
NSQ_SOURCE_LINE 00000430 "larger the number, the lower the priority. If more than one type is found"
NSQ_SOURCE_LINE 00000431 "(prefix, .pm, .pmc, .pod) then the type with the lowest number is returned"
NSQ_SOURCE_LINE 00000432 "first."
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "=item * B<module>* => I<str>"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "Module name to search."
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "=back"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "Return value:  (str|array[str])"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=head2 pod_path"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "Usage:"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 " pod_path(%args) -> str|array[str]"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "Get path to locally installed POD."
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "This is a shortcut for:"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 " module_path(%args, find_pm=>0, find_pmc=>0, find_pod=>1, find_prefix=>0)"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "=over 4"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "=item * B<abs> => I<bool> (default: 0)"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "Whether to return absolute paths."
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "=item * B<all> => I<bool> (default: 0)"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "Return all results instead of just the first."
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "=item * B<module>* => I<str>"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "Module name to search."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 ""
NSQ_SOURCE_LINE 00000476 "=back"
NSQ_SOURCE_LINE 00000477 ""
NSQ_SOURCE_LINE 00000478 "Return value:  (str|array[str])"
NSQ_SOURCE_LINE 00000479 ""
NSQ_SOURCE_LINE 00000480 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000481 ""
NSQ_SOURCE_LINE 00000482 "Please visit the project's homepage at L<https://metacpan.org/release/Module-Path-More>."
NSQ_SOURCE_LINE 00000483 ""
NSQ_SOURCE_LINE 00000484 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000485 ""
NSQ_SOURCE_LINE 00000486 "Source repository is at L<https://github.com/perlancar/perl-Module-Path-More>."
NSQ_SOURCE_LINE 00000487 ""
NSQ_SOURCE_LINE 00000488 "=head1 BUGS"
NSQ_SOURCE_LINE 00000489 ""
NSQ_SOURCE_LINE 00000490 "Please report any bugs or feature requests on the bugtracker website L<https://rt.cpan.org/Public/Dist/Display.html?Name=Module-Path-More>"
NSQ_SOURCE_LINE 00000491 ""
NSQ_SOURCE_LINE 00000492 "When submitting a bug or request, please include a test-file or a"
NSQ_SOURCE_LINE 00000493 "patch to an existing test-file that illustrates the bug or desired"
NSQ_SOURCE_LINE 00000494 "feature."
NSQ_SOURCE_LINE 00000495 ""
NSQ_SOURCE_LINE 00000496 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000497 ""
NSQ_SOURCE_LINE 00000498 "=head2 Similar modules"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "L<Module::Path>. Module::Path::More is actually a fork of Module::Path."
NSQ_SOURCE_LINE 00000501 "Module::Path::More contains features that are not (or have not been accepted) in"
NSQ_SOURCE_LINE 00000502 "the original module, namely: finding all matches instead of the first found"
NSQ_SOURCE_LINE 00000503 "match, and finding C<.pmc/.pod> in addition to .pm files. B<Note that the"
NSQ_SOURCE_LINE 00000504 "interface is different> (Module::Path::More accepts hash/named arguments) so the"
NSQ_SOURCE_LINE 00000505 "two modules are not drop-in replacements for each other. Also, note that by"
NSQ_SOURCE_LINE 00000506 "default Module::Path::More does B<not> do an C<abs_path()> to each file it"
NSQ_SOURCE_LINE 00000507 "finds. I think this module's choice (not doing abs_path) is a more sensible"
NSQ_SOURCE_LINE 00000508 "default, because usually there is no actual need to do so and doing abs_path()"
NSQ_SOURCE_LINE 00000509 "or resolving symlinks will sometimes fail or expose filesystem quirks that we"
NSQ_SOURCE_LINE 00000510 "might not want to deal with at all. However, if you want to do abs_path, you can"
NSQ_SOURCE_LINE 00000511 "do so by setting C<abs> option to true."
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "Command-line utility is not included in this distribution, unlike L<mpath> in"
NSQ_SOURCE_LINE 00000514 "C<Module-Path>. However, you can use"
NSQ_SOURCE_LINE 00000515 "L<pmpath|https://metacpan.org/pod/distribution/App-PMUtils/bin/pmpath> from"
NSQ_SOURCE_LINE 00000516 "L<App::PMUtils> distribution which uses this module."
NSQ_SOURCE_LINE 00000517 ""
NSQ_SOURCE_LINE 00000518 "References:"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "=over"
NSQ_SOURCE_LINE 00000521 ""
NSQ_SOURCE_LINE 00000522 "=item * L<https://github.com/neilbowers/Module-Path/issues/6>"
NSQ_SOURCE_LINE 00000523 ""
NSQ_SOURCE_LINE 00000524 "=item * L<https://github.com/neilbowers/Module-Path/issues/7>"
NSQ_SOURCE_LINE 00000525 ""
NSQ_SOURCE_LINE 00000526 "=item * L<https://github.com/neilbowers/Module-Path/issues/10>"
NSQ_SOURCE_LINE 00000527 ""
NSQ_SOURCE_LINE 00000528 "=item * L<https://rt.cpan.org/Public/Bug/Display.html?id=100979>"
NSQ_SOURCE_LINE 00000529 ""
NSQ_SOURCE_LINE 00000530 "=back"
NSQ_SOURCE_LINE 00000531 ""
NSQ_SOURCE_LINE 00000532 "=head2 Task-related"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "If you want to check if a module is \"installed\", use L<Module::Installed::Tiny>"
NSQ_SOURCE_LINE 00000535 "instead. Module::Path::More only tries to find the module file in the"
NSQ_SOURCE_LINE 00000536 "filesystem, but Perl can actually search for modules in other sources (read"
NSQ_SOURCE_LINE 00000537 "about %INC hook in C<require()> section of L<perlfunc>). Module::Installed::Tiny"
NSQ_SOURCE_LINE 00000538 "can mimic Perl's behavior in searching for modules, without actually loading the"
NSQ_SOURCE_LINE 00000539 "module."
NSQ_SOURCE_LINE 00000540 ""
