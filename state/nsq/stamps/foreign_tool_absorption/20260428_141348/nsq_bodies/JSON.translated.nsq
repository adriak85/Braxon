NSQ_SOURCE_LINE 00000178 "    if ( ref($_[0]) eq 'JSON' or $_[0] eq 'JSON' ) {"
NSQ_SOURCE_LINE 00000179 "        Carp::croak \"from_json should not be called as a method.\";"
NSQ_SOURCE_LINE 00000180 "    }"
NSQ_SOURCE_LINE 00000181 "    my $json = JSON->new;"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    if (@_ == 2 and ref $_[1] eq 'HASH') {"
