NSQ_SOURCE_LINE 00000407 "    ${\"$class\\::VERSION\"} = $module->VERSION;"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "    if ( $module->VERSION < 3 ) {"
NSQ_SOURCE_LINE 00000410 "        eval 'package JSON::PP::Boolean';"
NSQ_SOURCE_LINE 00000411 "        push @{\"$module\\::Boolean::ISA\"}, qw(JSON::PP::Boolean);"
NSQ_SOURCE_LINE 00000412 "    }"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "    for my $method (@PPOnlyMethods) {"
NSQ_SOURCE_LINE 00000415 "        *{\"JSON::$method\"} = sub {"
NSQ_SOURCE_LINE 00000416 "            Carp::carp(\"$method is not supported by $module.\");"
NSQ_SOURCE_LINE 00000417 "            $_[0];"
NSQ_SOURCE_LINE 00000418 "        };"
NSQ_SOURCE_LINE 00000419 "    }"
NSQ_SOURCE_LINE 00000420 ""
NSQ_SOURCE_LINE 00000421 "    return 1;"
NSQ_SOURCE_LINE 00000422 "}"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "sub is_xs { 1 };"
NSQ_SOURCE_LINE 00000425 "sub is_pp { 0 };"
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "sub support_by_pp {"
NSQ_SOURCE_LINE 00000428 "    my ($class, @methods) = @_;"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "    JSON::__load_pp('JSON::PP');"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "    local $^W;"
NSQ_SOURCE_LINE 00000433 "    no strict qw(refs);"
NSQ_SOURCE_LINE 00000434 ""
NSQ_SOURCE_LINE 00000435 "    for my $method (@methods) {"
NSQ_SOURCE_LINE 00000436 "        my $pp_method = JSON::PP->can($method) or next;"
NSQ_SOURCE_LINE 00000437 "        *{\"JSON::$method\"} = sub {"
NSQ_SOURCE_LINE 00000438 "            if (!$_[0]->isa('JSON::PP')) {"
NSQ_SOURCE_LINE 00000439 "                my $xs_self = $_[0];"
NSQ_SOURCE_LINE 00000440 "                my $pp_self = JSON::PP->new;"
NSQ_SOURCE_LINE 00000441 "                for (@Properties) {"
NSQ_SOURCE_LINE 00000442 "                     my $getter = \"get_$_\";"
NSQ_SOURCE_LINE 00000443 "                    $pp_self->$_($xs_self->$getter);"
NSQ_SOURCE_LINE 00000444 "                }"
NSQ_SOURCE_LINE 00000445 "                $_[0] = $pp_self;"
NSQ_SOURCE_LINE 00000446 "            }"
NSQ_SOURCE_LINE 00000447 "            $pp_method->(@_);"
NSQ_SOURCE_LINE 00000448 "        };"
NSQ_SOURCE_LINE 00000449 "    }"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "    $JSON::DEBUG and Carp::carp(\"set -support_by_pp mode.\");"
NSQ_SOURCE_LINE 00000452 "}"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "1;"
NSQ_SOURCE_LINE 00000455 "__END__"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "=head1 NAME"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "JSON - JSON (JavaScript Object Notation) encoder/decoder"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 " use JSON; # imports encode_json, decode_json, to_json and from_json."
NSQ_SOURCE_LINE 00000464 " "
NSQ_SOURCE_LINE 00000465 " # simple and fast interfaces (expect/generate UTF-8)"
NSQ_SOURCE_LINE 00000466 " "
NSQ_SOURCE_LINE 00000467 " $utf8_encoded_json_text = encode_json $perl_hash_or_arrayref;"
NSQ_SOURCE_LINE 00000468 " $perl_hash_or_arrayref  = decode_json $utf8_encoded_json_text;"
NSQ_SOURCE_LINE 00000469 " "
NSQ_SOURCE_LINE 00000470 " # OO-interface"
NSQ_SOURCE_LINE 00000471 " "
NSQ_SOURCE_LINE 00000472 " $json = JSON->new->allow_nonref;"
NSQ_SOURCE_LINE 00000473 " "
NSQ_SOURCE_LINE 00000474 " $json_text   = $json->encode( $perl_scalar );"
NSQ_SOURCE_LINE 00000475 " $perl_scalar = $json->decode( $json_text );"
NSQ_SOURCE_LINE 00000476 " "
NSQ_SOURCE_LINE 00000477 " $pretty_printed = $json->pretty->encode( $perl_scalar ); # pretty-printing"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "This module is a thin wrapper for L<JSON::XS>-compatible modules with a few"
NSQ_SOURCE_LINE 00000482 "additional features. All the backend modules convert a Perl data structure"
NSQ_SOURCE_LINE 00000483 "to a JSON text and vice versa. This module uses L<JSON::XS> by default,"
NSQ_SOURCE_LINE 00000484 "and when JSON::XS is not available, falls back on L<JSON::PP>, which is"
NSQ_SOURCE_LINE 00000485 "in the Perl core since 5.14. If JSON::PP is not available either, this"
NSQ_SOURCE_LINE 00000486 "module then falls back on JSON::backportPP (which is actually JSON::PP"
NSQ_SOURCE_LINE 00000487 "in a different .pm file) bundled in the same distribution as this module."
NSQ_SOURCE_LINE 00000488 "You can also explicitly specify to use L<Cpanel::JSON::XS>, a fork of"
NSQ_SOURCE_LINE 00000489 "JSON::XS by Reini Urban."
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "All these backend modules have slight incompatibilities between them,"
NSQ_SOURCE_LINE 00000492 "including extra features that other modules don't support, but as long as you"
NSQ_SOURCE_LINE 00000493 "use only common features (most important ones are described below), migration"
NSQ_SOURCE_LINE 00000494 "from backend to backend should be reasonably easy. For details, see each"
NSQ_SOURCE_LINE 00000495 "backend module you use."
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "=head1 CHOOSING BACKEND"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "This module respects an environmental variable called C<PERL_JSON_BACKEND>"
NSQ_SOURCE_LINE 00000500 "when it decides a backend module to use. If this environmental variable is"
NSQ_SOURCE_LINE 00000501 "not set, it tries to load JSON::XS, and if JSON::XS is not available, it"
NSQ_SOURCE_LINE 00000502 "falls back on JSON::PP, and then JSON::backportPP if JSON::PP is not available"
NSQ_SOURCE_LINE 00000503 "either."
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "If you always don't want it to fall back on pure perl modules, set the"
NSQ_SOURCE_LINE 00000506 "variable like this (C<export> may be C<setenv>, C<set> and the likes,"
NSQ_SOURCE_LINE 00000507 "depending on your environment):"
NSQ_SOURCE_LINE 00000508 ""
NSQ_SOURCE_LINE 00000509 "  > export PERL_JSON_BACKEND=JSON::XS"
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "If you prefer Cpanel::JSON::XS to JSON::XS, then:"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "  > export PERL_JSON_BACKEND=Cpanel::JSON::XS,JSON::XS,JSON::PP"
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "You may also want to set this variable at the top of your test files, in order"
NSQ_SOURCE_LINE 00000516 "not to be bothered with incompatibilities between backends (you need to wrap"
NSQ_SOURCE_LINE 00000517 "this in C<BEGIN>, and set before actually C<use>-ing JSON module, as it decides"
NSQ_SOURCE_LINE 00000518 "its backend as soon as it's loaded):"
NSQ_SOURCE_LINE 00000519 ""
NSQ_SOURCE_LINE 00000520 "  BEGIN { $ENV{PERL_JSON_BACKEND}='JSON::backportPP'; }"
NSQ_SOURCE_LINE 00000521 "  use JSON;"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "=head1 USING OPTIONAL FEATURES"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "There are a few options you can set when you C<use> this module."
NSQ_SOURCE_LINE 00000526 "These historical options are only kept for backward compatibility,"
NSQ_SOURCE_LINE 00000527 "and should not be used in a new application."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=over"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "=item -support_by_pp"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "   BEGIN { $ENV{PERL_JSON_BACKEND} = 'JSON::XS' }"
NSQ_SOURCE_LINE 00000534 "   "
NSQ_SOURCE_LINE 00000535 "   use JSON -support_by_pp;"
NSQ_SOURCE_LINE 00000536 "   "
NSQ_SOURCE_LINE 00000537 "   my $json = JSON->new;"
NSQ_SOURCE_LINE 00000538 "   # escape_slash is for JSON::PP only."
NSQ_SOURCE_LINE 00000539 "   $json->allow_nonref->escape_slash->encode(\"/\");"
NSQ_SOURCE_LINE 00000540 ""
NSQ_SOURCE_LINE 00000541 "With this option, this module loads its pure perl backend along with"
NSQ_SOURCE_LINE 00000542 "its XS backend (if available), and lets the XS backend to watch if you set"
NSQ_SOURCE_LINE 00000543 "a flag only JSON::PP supports. When you do, the internal JSON::XS object"
NSQ_SOURCE_LINE 00000544 "is replaced with a newly created JSON::PP object with the setting copied"
NSQ_SOURCE_LINE 00000545 "from the XS object, so that you can use JSON::PP flags (and its slower"
NSQ_SOURCE_LINE 00000546 "C<decode>/C<encode> methods) from then on. In other words, this is not"
NSQ_SOURCE_LINE 00000547 "something that allows you to hook JSON::XS to change its behavior while"
NSQ_SOURCE_LINE 00000548 "keeping its speed. JSON::XS and JSON::PP objects are quite different"
NSQ_SOURCE_LINE 00000549 "(JSON::XS object is a blessed scalar reference, while JSON::PP object is"
NSQ_SOURCE_LINE 00000550 "a blessed hash reference), and can't share their internals."
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "To avoid needless overhead (by copying settings), you are advised not"
NSQ_SOURCE_LINE 00000553 "to use this option and just to use JSON::PP explicitly when you need"
NSQ_SOURCE_LINE 00000554 "JSON::PP features."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "=item -convert_blessed_universally"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "   use JSON -convert_blessed_universally;"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "   my $json = JSON->new->allow_nonref->convert_blessed;"
NSQ_SOURCE_LINE 00000561 "   my $object = bless {foo => 'bar'}, 'Foo';"
NSQ_SOURCE_LINE 00000562 "   $json->encode($object); # => {\"foo\":\"bar\"}"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "JSON::XS-compatible backend modules don't encode blessed objects by"
NSQ_SOURCE_LINE 00000565 "default (except for their boolean values, which are typically blessed"
NSQ_SOURCE_LINE 00000566 "JSON::PP::Boolean objects). If you need to encode a data structure"
NSQ_SOURCE_LINE 00000567 "that may contain objects, you usually need to look into the structure"
NSQ_SOURCE_LINE 00000568 "and replace objects with alternative non-blessed values, or enable"
NSQ_SOURCE_LINE 00000569 "C<convert_blessed> and provide a C<TO_JSON> method for each object's"
NSQ_SOURCE_LINE 00000570 "(base) class that may be found in the structure, in order to let the"
NSQ_SOURCE_LINE 00000571 "methods replace the objects with whatever scalar values the methods"
NSQ_SOURCE_LINE 00000572 "return."
NSQ_SOURCE_LINE 00000573 ""
NSQ_SOURCE_LINE 00000574 "If you need to serialise data structures that may contain arbitrary"
NSQ_SOURCE_LINE 00000575 "objects, it's probably better to use other serialisers (such as"
NSQ_SOURCE_LINE 00000576 "L<Sereal> or L<Storable> for example), but if you do want to use"
NSQ_SOURCE_LINE 00000577 "this module for that purpose, C<-convert_blessed_universally> option"
NSQ_SOURCE_LINE 00000578 "may help, which tweaks C<encode> method of the backend to install"
NSQ_SOURCE_LINE 00000579 "C<UNIVERSAL::TO_JSON> method (locally) before encoding, so that"
NSQ_SOURCE_LINE 00000580 "all the objects that don't have their own C<TO_JSON> method can"
NSQ_SOURCE_LINE 00000581 "fall back on the method in the C<UNIVERSAL> namespace. Note that you"
NSQ_SOURCE_LINE 00000582 "still need to enable C<convert_blessed> flag to actually encode"
NSQ_SOURCE_LINE 00000583 "objects in a data structure, and C<UNIVERSAL::TO_JSON> method"
NSQ_SOURCE_LINE 00000584 "installed by this option only converts blessed hash/array references"
NSQ_SOURCE_LINE 00000585 "into their unblessed clone (including private keys/values that are"
NSQ_SOURCE_LINE 00000586 "not supposed to be exposed). Other blessed references will be"
NSQ_SOURCE_LINE 00000587 "converted into null."
NSQ_SOURCE_LINE 00000588 ""
NSQ_SOURCE_LINE 00000589 "This feature is experimental and may be removed in the future."
NSQ_SOURCE_LINE 00000590 ""
NSQ_SOURCE_LINE 00000591 "=item -no_export"
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "When you don't want to import functional interfaces from a module, you"
NSQ_SOURCE_LINE 00000594 "usually supply C<()> to its C<use> statement."
NSQ_SOURCE_LINE 00000595 ""
NSQ_SOURCE_LINE 00000596 "    use JSON (); # no functional interfaces"
NSQ_SOURCE_LINE 00000597 ""
NSQ_SOURCE_LINE 00000598 "If you don't want to import functional interfaces, but you also want to"
NSQ_SOURCE_LINE 00000599 "use any of the above options, add C<-no_export> to the option list."
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "   # no functional interfaces, while JSON::PP support is enabled."
NSQ_SOURCE_LINE 00000602 "   use JSON -support_by_pp, -no_export;"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "=back"
NSQ_SOURCE_LINE 00000605 ""
NSQ_SOURCE_LINE 00000606 "=head1 FUNCTIONAL INTERFACE"
NSQ_SOURCE_LINE 00000607 ""
NSQ_SOURCE_LINE 00000608 "This section is taken from JSON::XS. C<encode_json> and C<decode_json>"
NSQ_SOURCE_LINE 00000609 "are exported by default."
NSQ_SOURCE_LINE 00000610 ""
NSQ_SOURCE_LINE 00000611 "This module also exports C<to_json> and C<from_json> for backward"
NSQ_SOURCE_LINE 00000612 "compatibility. These are slower, and may expect/generate different stuff"
NSQ_SOURCE_LINE 00000613 "from what C<encode_json> and C<decode_json> do, depending on their"
NSQ_SOURCE_LINE 00000614 "options. It's better just to use Object-Oriented interfaces than using"
NSQ_SOURCE_LINE 00000615 "these two functions."
NSQ_SOURCE_LINE 00000616 ""
NSQ_SOURCE_LINE 00000617 "=head2 encode_json"
NSQ_SOURCE_LINE 00000618 ""
NSQ_SOURCE_LINE 00000619 "    $json_text = encode_json $perl_scalar"
NSQ_SOURCE_LINE 00000620 ""
NSQ_SOURCE_LINE 00000621 "Converts the given Perl data structure to a UTF-8 encoded, binary string"
NSQ_SOURCE_LINE 00000622 "(that is, the string contains octets only). Croaks on error."
NSQ_SOURCE_LINE 00000623 ""
NSQ_SOURCE_LINE 00000624 "This function call is functionally identical to:"
NSQ_SOURCE_LINE 00000625 ""
NSQ_SOURCE_LINE 00000626 "    $json_text = JSON->new->utf8->encode($perl_scalar)"
NSQ_SOURCE_LINE 00000627 ""
NSQ_SOURCE_LINE 00000628 "Except being faster."
NSQ_SOURCE_LINE 00000629 ""
NSQ_SOURCE_LINE 00000630 "=head2 decode_json"
NSQ_SOURCE_LINE 00000631 ""
NSQ_SOURCE_LINE 00000632 "    $perl_scalar = decode_json $json_text"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "The opposite of C<encode_json>: expects an UTF-8 (binary) string and tries"
NSQ_SOURCE_LINE 00000635 "to parse that as an UTF-8 encoded JSON text, returning the resulting"
NSQ_SOURCE_LINE 00000636 "reference. Croaks on error."
NSQ_SOURCE_LINE 00000637 ""
NSQ_SOURCE_LINE 00000638 "This function call is functionally identical to:"
NSQ_SOURCE_LINE 00000639 ""
NSQ_SOURCE_LINE 00000640 "    $perl_scalar = JSON->new->utf8->decode($json_text)"
NSQ_SOURCE_LINE 00000641 ""
NSQ_SOURCE_LINE 00000642 "Except being faster."
NSQ_SOURCE_LINE 00000643 ""
NSQ_SOURCE_LINE 00000644 "=head2 to_json"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "   $json_text = to_json($perl_scalar[, $optional_hashref])"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "Converts the given Perl data structure to a Unicode string by default."
NSQ_SOURCE_LINE 00000649 "Croaks on error."
NSQ_SOURCE_LINE 00000650 ""
NSQ_SOURCE_LINE 00000651 "Basically, this function call is functionally identical to:"
NSQ_SOURCE_LINE 00000652 ""
NSQ_SOURCE_LINE 00000653 "   $json_text = JSON->new->encode($perl_scalar)"
NSQ_SOURCE_LINE 00000654 ""
NSQ_SOURCE_LINE 00000655 "Except being slower."
NSQ_SOURCE_LINE 00000656 ""
NSQ_SOURCE_LINE 00000657 "You can pass an optional hash reference to modify its behavior, but"
NSQ_SOURCE_LINE 00000658 "that may change what C<to_json> expects/generates (see"
NSQ_SOURCE_LINE 00000659 "C<ENCODING/CODESET FLAG NOTES> for details)."
NSQ_SOURCE_LINE 00000660 ""
NSQ_SOURCE_LINE 00000661 "   $json_text = to_json($perl_scalar, {utf8 => 1, pretty => 1})"
NSQ_SOURCE_LINE 00000662 "   # => JSON->new->utf8(1)->pretty(1)->encode($perl_scalar)"
NSQ_SOURCE_LINE 00000663 ""
NSQ_SOURCE_LINE 00000664 "=head2 from_json"
NSQ_SOURCE_LINE 00000665 ""
NSQ_SOURCE_LINE 00000666 "   $perl_scalar = from_json($json_text[, $optional_hashref])"
NSQ_SOURCE_LINE 00000667 ""
NSQ_SOURCE_LINE 00000668 "The opposite of C<to_json>: expects a Unicode string and tries"
NSQ_SOURCE_LINE 00000669 "to parse it, returning the resulting reference. Croaks on error."
NSQ_SOURCE_LINE 00000670 ""
NSQ_SOURCE_LINE 00000671 "Basically, this function call is functionally identical to:"
NSQ_SOURCE_LINE 00000672 ""
NSQ_SOURCE_LINE 00000673 "    $perl_scalar = JSON->new->decode($json_text)"
NSQ_SOURCE_LINE 00000674 ""
NSQ_SOURCE_LINE 00000675 "You can pass an optional hash reference to modify its behavior, but"
NSQ_SOURCE_LINE 00000676 "that may change what C<from_json> expects/generates (see"
NSQ_SOURCE_LINE 00000677 "C<ENCODING/CODESET FLAG NOTES> for details)."
NSQ_SOURCE_LINE 00000678 ""
NSQ_SOURCE_LINE 00000679 "    $perl_scalar = from_json($json_text, {utf8 => 1})"
NSQ_SOURCE_LINE 00000680 "    # => JSON->new->utf8(1)->decode($json_text)"
NSQ_SOURCE_LINE 00000681 ""
NSQ_SOURCE_LINE 00000682 "=head2 JSON::is_bool"
NSQ_SOURCE_LINE 00000683 ""
NSQ_SOURCE_LINE 00000684 "    $is_boolean = JSON::is_bool($scalar)"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "Returns true if the passed scalar represents either JSON::true or"
NSQ_SOURCE_LINE 00000687 "JSON::false, two constants that act like C<1> and C<0> respectively"
NSQ_SOURCE_LINE 00000688 "and are also used to represent JSON C<true> and C<false> in Perl strings."
NSQ_SOURCE_LINE 00000689 ""
NSQ_SOURCE_LINE 00000690 "See L<MAPPING>, below, for more information on how JSON values are mapped to"
NSQ_SOURCE_LINE 00000691 "Perl."
NSQ_SOURCE_LINE 00000692 ""
NSQ_SOURCE_LINE 00000693 "=head1 COMMON OBJECT-ORIENTED INTERFACE"
NSQ_SOURCE_LINE 00000694 ""
NSQ_SOURCE_LINE 00000695 "This section is also taken from JSON::XS."
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "The object oriented interface lets you configure your own encoding or"
NSQ_SOURCE_LINE 00000698 "decoding style, within the limits of supported formats."
NSQ_SOURCE_LINE 00000699 ""
NSQ_SOURCE_LINE 00000700 "=head2 new"
NSQ_SOURCE_LINE 00000701 ""
NSQ_SOURCE_LINE 00000702 "    $json = JSON->new"
NSQ_SOURCE_LINE 00000703 ""
NSQ_SOURCE_LINE 00000704 "Creates a new JSON::XS-compatible backend object that can be used to de/encode JSON"
NSQ_SOURCE_LINE 00000705 "strings. All boolean flags described below are by default I<disabled>"
NSQ_SOURCE_LINE 00000706 "(with the exception of C<allow_nonref>, which defaults to I<enabled> since"
NSQ_SOURCE_LINE 00000707 "version C<4.0>)."
NSQ_SOURCE_LINE 00000708 ""
NSQ_SOURCE_LINE 00000709 "The mutators for flags all return the backend object again and thus calls can"
NSQ_SOURCE_LINE 00000710 "be chained:"
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "   my $json = JSON->new->utf8->space_after->encode({a => [1,2]})"
NSQ_SOURCE_LINE 00000713 "   => {\"a\": [1, 2]}"
NSQ_SOURCE_LINE 00000714 ""
NSQ_SOURCE_LINE 00000715 "=head2 ascii"
NSQ_SOURCE_LINE 00000716 ""
NSQ_SOURCE_LINE 00000717 "    $json = $json->ascii([$enable])"
NSQ_SOURCE_LINE 00000718 "    "
NSQ_SOURCE_LINE 00000719 "    $enabled = $json->get_ascii"
NSQ_SOURCE_LINE 00000720 ""
NSQ_SOURCE_LINE 00000721 "If C<$enable> is true (or missing), then the C<encode> method will not"
NSQ_SOURCE_LINE 00000722 "generate characters outside the code range C<0..127> (which is ASCII). Any"
NSQ_SOURCE_LINE 00000723 "Unicode characters outside that range will be escaped using either a"
NSQ_SOURCE_LINE 00000724 "single \\uXXXX (BMP characters) or a double \\uHHHH\\uLLLLL escape sequence,"
NSQ_SOURCE_LINE 00000725 "as per RFC4627. The resulting encoded JSON text can be treated as a native"
NSQ_SOURCE_LINE 00000726 "Unicode string, an ascii-encoded, latin1-encoded or UTF-8 encoded string,"
NSQ_SOURCE_LINE 00000727 "or any other superset of ASCII."
NSQ_SOURCE_LINE 00000728 ""
NSQ_SOURCE_LINE 00000729 "If C<$enable> is false, then the C<encode> method will not escape Unicode"
NSQ_SOURCE_LINE 00000730 "characters unless required by the JSON syntax or other flags. This results"
NSQ_SOURCE_LINE 00000731 "in a faster and more compact format."
NSQ_SOURCE_LINE 00000732 ""
NSQ_SOURCE_LINE 00000733 "See also the section I<ENCODING/CODESET FLAG NOTES> later in this document."
NSQ_SOURCE_LINE 00000734 ""
NSQ_SOURCE_LINE 00000735 "The main use for this flag is to produce JSON texts that can be"
NSQ_SOURCE_LINE 00000736 "transmitted over a 7-bit channel, as the encoded JSON texts will not"
NSQ_SOURCE_LINE 00000737 "contain any 8 bit characters."
NSQ_SOURCE_LINE 00000738 ""
NSQ_SOURCE_LINE 00000739 "  JSON->new->ascii(1)->encode([chr 0x10401])"
NSQ_SOURCE_LINE 00000740 "  => [\"\\ud801\\udc01\"]"
NSQ_SOURCE_LINE 00000741 ""
NSQ_SOURCE_LINE 00000742 "=head2 latin1"
NSQ_SOURCE_LINE 00000743 ""
NSQ_SOURCE_LINE 00000744 "    $json = $json->latin1([$enable])"
NSQ_SOURCE_LINE 00000745 "    "
NSQ_SOURCE_LINE 00000746 "    $enabled = $json->get_latin1"
NSQ_SOURCE_LINE 00000747 ""
NSQ_SOURCE_LINE 00000748 "If C<$enable> is true (or missing), then the C<encode> method will encode"
NSQ_SOURCE_LINE 00000749 "the resulting JSON text as latin1 (or iso-8859-1), escaping any characters"
NSQ_SOURCE_LINE 00000750 "outside the code range C<0..255>. The resulting string can be treated as a"
NSQ_SOURCE_LINE 00000751 "latin1-encoded JSON text or a native Unicode string. The C<decode> method"
NSQ_SOURCE_LINE 00000752 "will not be affected in any way by this flag, as C<decode> by default"
NSQ_SOURCE_LINE 00000753 "expects Unicode, which is a strict superset of latin1."
NSQ_SOURCE_LINE 00000754 ""
NSQ_SOURCE_LINE 00000755 "If C<$enable> is false, then the C<encode> method will not escape Unicode"
NSQ_SOURCE_LINE 00000756 "characters unless required by the JSON syntax or other flags."
NSQ_SOURCE_LINE 00000757 ""
NSQ_SOURCE_LINE 00000758 "See also the section I<ENCODING/CODESET FLAG NOTES> later in this document."
NSQ_SOURCE_LINE 00000759 ""
NSQ_SOURCE_LINE 00000760 "The main use for this flag is efficiently encoding binary data as JSON"
NSQ_SOURCE_LINE 00000761 "text, as most octets will not be escaped, resulting in a smaller encoded"
NSQ_SOURCE_LINE 00000762 "size. The disadvantage is that the resulting JSON text is encoded"
NSQ_SOURCE_LINE 00000763 "in latin1 (and must correctly be treated as such when storing and"
NSQ_SOURCE_LINE 00000764 "transferring), a rare encoding for JSON. It is therefore most useful when"
NSQ_SOURCE_LINE 00000765 "you want to store data structures known to contain binary data efficiently"
NSQ_SOURCE_LINE 00000766 "in files or databases, not when talking to other JSON encoders/decoders."
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "  JSON->new->latin1->encode ([\"\\x{89}\\x{abc}\"]"
NSQ_SOURCE_LINE 00000769 "  => [\"\\x{89}\\\\u0abc\"]    # (perl syntax, U+abc escaped, U+89 not)"
NSQ_SOURCE_LINE 00000770 ""
NSQ_SOURCE_LINE 00000771 "=head2 utf8"
NSQ_SOURCE_LINE 00000772 ""
NSQ_SOURCE_LINE 00000773 "    $json = $json->utf8([$enable])"
NSQ_SOURCE_LINE 00000774 "    "
NSQ_SOURCE_LINE 00000775 "    $enabled = $json->get_utf8"
NSQ_SOURCE_LINE 00000776 ""
NSQ_SOURCE_LINE 00000777 "If C<$enable> is true (or missing), then the C<encode> method will encode"
NSQ_SOURCE_LINE 00000778 "the JSON result into UTF-8, as required by many protocols, while the"
NSQ_SOURCE_LINE 00000779 "C<decode> method expects to be handled an UTF-8-encoded string.  Please"
NSQ_SOURCE_LINE 00000780 "note that UTF-8-encoded strings do not contain any characters outside the"
NSQ_SOURCE_LINE 00000781 "range C<0..255>, they are thus useful for bytewise/binary I/O. In future"
NSQ_SOURCE_LINE 00000782 "versions, enabling this option might enable autodetection of the UTF-16"
NSQ_SOURCE_LINE 00000783 "and UTF-32 encoding families, as described in RFC4627."
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "If C<$enable> is false, then the C<encode> method will return the JSON"
NSQ_SOURCE_LINE 00000786 "string as a (non-encoded) Unicode string, while C<decode> expects thus a"
NSQ_SOURCE_LINE 00000787 "Unicode string.  Any decoding or encoding (e.g. to UTF-8 or UTF-16) needs"
NSQ_SOURCE_LINE 00000788 "to be done yourself, e.g. using the Encode module."
NSQ_SOURCE_LINE 00000789 ""
NSQ_SOURCE_LINE 00000790 "See also the section I<ENCODING/CODESET FLAG NOTES> later in this document."
NSQ_SOURCE_LINE 00000791 ""
NSQ_SOURCE_LINE 00000792 "Example, output UTF-16BE-encoded JSON:"
NSQ_SOURCE_LINE 00000793 ""
NSQ_SOURCE_LINE 00000794 "  use Encode;"
NSQ_SOURCE_LINE 00000795 "  $jsontext = encode \"UTF-16BE\", JSON->new->encode ($object);"
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "Example, decode UTF-32LE-encoded JSON:"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "  use Encode;"
NSQ_SOURCE_LINE 00000800 "  $object = JSON->new->decode (decode \"UTF-32LE\", $jsontext);"
NSQ_SOURCE_LINE 00000801 ""
NSQ_SOURCE_LINE 00000802 "=head2 pretty"
NSQ_SOURCE_LINE 00000803 ""
NSQ_SOURCE_LINE 00000804 "    $json = $json->pretty([$enable])"
NSQ_SOURCE_LINE 00000805 ""
NSQ_SOURCE_LINE 00000806 "This enables (or disables) all of the C<indent>, C<space_before> and"
NSQ_SOURCE_LINE 00000807 "C<space_after> (and in the future possibly more) flags in one call to"
NSQ_SOURCE_LINE 00000808 "generate the most readable (or most compact) form possible."
NSQ_SOURCE_LINE 00000809 ""
NSQ_SOURCE_LINE 00000810 "=head2 indent"
NSQ_SOURCE_LINE 00000811 ""
NSQ_SOURCE_LINE 00000812 "    $json = $json->indent([$enable])"
NSQ_SOURCE_LINE 00000813 "    "
NSQ_SOURCE_LINE 00000814 "    $enabled = $json->get_indent"
NSQ_SOURCE_LINE 00000815 ""
NSQ_SOURCE_LINE 00000816 "If C<$enable> is true (or missing), then the C<encode> method will use a multiline"
NSQ_SOURCE_LINE 00000817 "format as output, putting every array member or object/hash key-value pair"
NSQ_SOURCE_LINE 00000818 "into its own line, indenting them properly."
NSQ_SOURCE_LINE 00000819 ""
NSQ_SOURCE_LINE 00000820 "If C<$enable> is false, no newlines or indenting will be produced, and the"
NSQ_SOURCE_LINE 00000821 "resulting JSON text is guaranteed not to contain any C<newlines>."
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "This setting has no effect when decoding JSON texts."
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "=head2 space_before"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "    $json = $json->space_before([$enable])"
NSQ_SOURCE_LINE 00000828 "    "
NSQ_SOURCE_LINE 00000829 "    $enabled = $json->get_space_before"
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "If C<$enable> is true (or missing), then the C<encode> method will add an extra"
NSQ_SOURCE_LINE 00000832 "optional space before the C<:> separating keys from values in JSON objects."
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "If C<$enable> is false, then the C<encode> method will not add any extra"
NSQ_SOURCE_LINE 00000835 "space at those places."
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "This setting has no effect when decoding JSON texts. You will also"
NSQ_SOURCE_LINE 00000838 "most likely combine this setting with C<space_after>."
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "Example, space_before enabled, space_after and indent disabled:"
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "   {\"key\" :\"value\"}"
NSQ_SOURCE_LINE 00000843 ""
NSQ_SOURCE_LINE 00000844 "=head2 space_after"
NSQ_SOURCE_LINE 00000845 ""
NSQ_SOURCE_LINE 00000846 "    $json = $json->space_after([$enable])"
NSQ_SOURCE_LINE 00000847 "    "
NSQ_SOURCE_LINE 00000848 "    $enabled = $json->get_space_after"
NSQ_SOURCE_LINE 00000849 ""
NSQ_SOURCE_LINE 00000850 "If C<$enable> is true (or missing), then the C<encode> method will add an extra"
NSQ_SOURCE_LINE 00000851 "optional space after the C<:> separating keys from values in JSON objects"
NSQ_SOURCE_LINE 00000852 "and extra whitespace after the C<,> separating key-value pairs and array"
NSQ_SOURCE_LINE 00000853 "members."
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "If C<$enable> is false, then the C<encode> method will not add any extra"
NSQ_SOURCE_LINE 00000856 "space at those places."
NSQ_SOURCE_LINE 00000857 ""
NSQ_SOURCE_LINE 00000858 "This setting has no effect when decoding JSON texts."
NSQ_SOURCE_LINE 00000859 ""
NSQ_SOURCE_LINE 00000860 "Example, space_before and indent disabled, space_after enabled:"
NSQ_SOURCE_LINE 00000861 ""
NSQ_SOURCE_LINE 00000862 "   {\"key\": \"value\"}"
NSQ_SOURCE_LINE 00000863 ""
NSQ_SOURCE_LINE 00000864 "=head2 relaxed"
NSQ_SOURCE_LINE 00000865 ""
NSQ_SOURCE_LINE 00000866 "    $json = $json->relaxed([$enable])"
NSQ_SOURCE_LINE 00000867 "    "
NSQ_SOURCE_LINE 00000868 "    $enabled = $json->get_relaxed"
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "If C<$enable> is true (or missing), then C<decode> will accept some"
NSQ_SOURCE_LINE 00000871 "extensions to normal JSON syntax (see below). C<encode> will not be"
NSQ_SOURCE_LINE 00000872 "affected in any way. I<Be aware that this option makes you accept invalid"
NSQ_SOURCE_LINE 00000873 "JSON texts as if they were valid!>. I suggest only to use this option to"
NSQ_SOURCE_LINE 00000874 "parse application-specific files written by humans (configuration files,"
NSQ_SOURCE_LINE 00000875 "resource files etc.)"
NSQ_SOURCE_LINE 00000876 ""
NSQ_SOURCE_LINE 00000877 "If C<$enable> is false (the default), then C<decode> will only accept"
NSQ_SOURCE_LINE 00000878 "valid JSON texts."
NSQ_SOURCE_LINE 00000879 ""
NSQ_SOURCE_LINE 00000880 "Currently accepted extensions are:"
NSQ_SOURCE_LINE 00000881 ""
NSQ_SOURCE_LINE 00000882 "=over 4"
NSQ_SOURCE_LINE 00000883 ""
NSQ_SOURCE_LINE 00000884 "=item * list items can have an end-comma"
NSQ_SOURCE_LINE 00000885 ""
NSQ_SOURCE_LINE 00000886 "JSON I<separates> array elements and key-value pairs with commas. This"
NSQ_SOURCE_LINE 00000887 "can be annoying if you write JSON texts manually and want to be able to"
NSQ_SOURCE_LINE 00000888 "quickly append elements, so this extension accepts comma at the end of"
NSQ_SOURCE_LINE 00000889 "such items not just between them:"
NSQ_SOURCE_LINE 00000890 ""
NSQ_SOURCE_LINE 00000891 "   ["
NSQ_SOURCE_LINE 00000892 "      1,"
NSQ_SOURCE_LINE 00000893 "      2, <- this comma not normally allowed"
NSQ_SOURCE_LINE 00000894 "   ]"
NSQ_SOURCE_LINE 00000895 "   {"
NSQ_SOURCE_LINE 00000896 "      \"k1\": \"v1\","
NSQ_SOURCE_LINE 00000897 "      \"k2\": \"v2\", <- this comma not normally allowed"
NSQ_SOURCE_LINE 00000898 "   }"
NSQ_SOURCE_LINE 00000899 ""
NSQ_SOURCE_LINE 00000900 "=item * shell-style '#'-comments"
NSQ_SOURCE_LINE 00000901 ""
NSQ_SOURCE_LINE 00000902 "Whenever JSON allows whitespace, shell-style comments are additionally"
NSQ_SOURCE_LINE 00000903 "allowed. They are terminated by the first carriage-return or line-feed"
NSQ_SOURCE_LINE 00000904 "character, after which more white-space and comments are allowed."
NSQ_SOURCE_LINE 00000905 ""
NSQ_SOURCE_LINE 00000906 "  ["
NSQ_SOURCE_LINE 00000907 "     1, # this comment not allowed in JSON"
NSQ_SOURCE_LINE 00000908 "        # neither this one..."
NSQ_SOURCE_LINE 00000909 "  ]"
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "=back"
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "=head2 canonical"
NSQ_SOURCE_LINE 00000914 ""
NSQ_SOURCE_LINE 00000915 "    $json = $json->canonical([$enable])"
NSQ_SOURCE_LINE 00000916 "    "
NSQ_SOURCE_LINE 00000917 "    $enabled = $json->get_canonical"
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "If C<$enable> is true (or missing), then the C<encode> method will output JSON objects"
NSQ_SOURCE_LINE 00000920 "by sorting their keys. This is adding a comparatively high overhead."
NSQ_SOURCE_LINE 00000921 ""
NSQ_SOURCE_LINE 00000922 "If C<$enable> is false, then the C<encode> method will output key-value"
NSQ_SOURCE_LINE 00000923 "pairs in the order Perl stores them (which will likely change between runs"
NSQ_SOURCE_LINE 00000924 "of the same script, and can change even within the same run from 5.18"
NSQ_SOURCE_LINE 00000925 "onwards)."
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "This option is useful if you want the same data structure to be encoded as"
NSQ_SOURCE_LINE 00000928 "the same JSON text (given the same overall settings). If it is disabled,"
NSQ_SOURCE_LINE 00000929 "the same hash might be encoded differently even if contains the same data,"
NSQ_SOURCE_LINE 00000930 "as key-value pairs have no inherent ordering in Perl."
NSQ_SOURCE_LINE 00000931 ""
NSQ_SOURCE_LINE 00000932 "This setting has no effect when decoding JSON texts."
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "This setting has currently no effect on tied hashes."
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "=head2 allow_nonref"
NSQ_SOURCE_LINE 00000937 ""
NSQ_SOURCE_LINE 00000938 "    $json = $json->allow_nonref([$enable])"
NSQ_SOURCE_LINE 00000939 "    "
NSQ_SOURCE_LINE 00000940 "    $enabled = $json->get_allow_nonref"
NSQ_SOURCE_LINE 00000941 ""
NSQ_SOURCE_LINE 00000942 "Unlike other boolean options, this option is enabled by default beginning"
NSQ_SOURCE_LINE 00000943 "with version C<4.0>."
NSQ_SOURCE_LINE 00000944 ""
NSQ_SOURCE_LINE 00000945 "If C<$enable> is true (or missing), then the C<encode> method can convert a"
NSQ_SOURCE_LINE 00000946 "non-reference into its corresponding string, number or null JSON value,"
NSQ_SOURCE_LINE 00000947 "which is an extension to RFC4627. Likewise, C<decode> will accept those JSON"
NSQ_SOURCE_LINE 00000948 "values instead of croaking."
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "If C<$enable> is false, then the C<encode> method will croak if it isn't"
NSQ_SOURCE_LINE 00000951 "passed an arrayref or hashref, as JSON texts must either be an object"
NSQ_SOURCE_LINE 00000952 "or array. Likewise, C<decode> will croak if given something that is not a"
NSQ_SOURCE_LINE 00000953 "JSON object or array."
NSQ_SOURCE_LINE 00000954 ""
NSQ_SOURCE_LINE 00000955 "Example, encode a Perl scalar as JSON value with enabled C<allow_nonref>,"
NSQ_SOURCE_LINE 00000956 "resulting in an invalid JSON text:"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "   JSON->new->allow_nonref->encode (\"Hello, World!\")"
NSQ_SOURCE_LINE 00000959 "   => \"Hello, World!\""
NSQ_SOURCE_LINE 00000960 ""
NSQ_SOURCE_LINE 00000961 "=head2 allow_unknown"
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "    $json = $json->allow_unknown ([$enable])"
NSQ_SOURCE_LINE 00000964 "    "
NSQ_SOURCE_LINE 00000965 "    $enabled = $json->get_allow_unknown"
NSQ_SOURCE_LINE 00000966 ""
NSQ_SOURCE_LINE 00000967 "If C<$enable> is true (or missing), then C<encode> will I<not> throw an"
NSQ_SOURCE_LINE 00000968 "exception when it encounters values it cannot represent in JSON (for"
NSQ_SOURCE_LINE 00000969 "example, filehandles) but instead will encode a JSON C<null> value. Note"
NSQ_SOURCE_LINE 00000970 "that blessed objects are not included here and are handled separately by"
NSQ_SOURCE_LINE 00000971 "c<allow_blessed>."
NSQ_SOURCE_LINE 00000972 ""
NSQ_SOURCE_LINE 00000973 "If C<$enable> is false (the default), then C<encode> will throw an"
NSQ_SOURCE_LINE 00000974 "exception when it encounters anything it cannot encode as JSON."
NSQ_SOURCE_LINE 00000975 ""
NSQ_SOURCE_LINE 00000976 "This option does not affect C<decode> in any way, and it is recommended to"
NSQ_SOURCE_LINE 00000977 "leave it off unless you know your communications partner."
NSQ_SOURCE_LINE 00000978 ""
NSQ_SOURCE_LINE 00000979 "=head2 allow_blessed"
NSQ_SOURCE_LINE 00000980 ""
NSQ_SOURCE_LINE 00000981 "    $json = $json->allow_blessed([$enable])"
NSQ_SOURCE_LINE 00000982 "    "
NSQ_SOURCE_LINE 00000983 "    $enabled = $json->get_allow_blessed"
NSQ_SOURCE_LINE 00000984 ""
NSQ_SOURCE_LINE 00000985 "See L<OBJECT SERIALISATION> for details."
NSQ_SOURCE_LINE 00000986 ""
NSQ_SOURCE_LINE 00000987 "If C<$enable> is true (or missing), then the C<encode> method will not"
NSQ_SOURCE_LINE 00000988 "barf when it encounters a blessed reference that it cannot convert"
NSQ_SOURCE_LINE 00000989 "otherwise. Instead, a JSON C<null> value is encoded instead of the object."
NSQ_SOURCE_LINE 00000990 ""
NSQ_SOURCE_LINE 00000991 "If C<$enable> is false (the default), then C<encode> will throw an"
NSQ_SOURCE_LINE 00000992 "exception when it encounters a blessed object that it cannot convert"
NSQ_SOURCE_LINE 00000993 "otherwise."
NSQ_SOURCE_LINE 00000994 ""
NSQ_SOURCE_LINE 00000995 "This setting has no effect on C<decode>."
NSQ_SOURCE_LINE 00000996 ""
NSQ_SOURCE_LINE 00000997 "=head2 convert_blessed"
NSQ_SOURCE_LINE 00000998 ""
NSQ_SOURCE_LINE 00000999 "    $json = $json->convert_blessed([$enable])"
NSQ_SOURCE_LINE 00001000 "    "
NSQ_SOURCE_LINE 00001001 "    $enabled = $json->get_convert_blessed"
NSQ_SOURCE_LINE 00001002 ""
NSQ_SOURCE_LINE 00001003 "See L<OBJECT SERIALISATION> for details."
NSQ_SOURCE_LINE 00001004 ""
NSQ_SOURCE_LINE 00001005 "If C<$enable> is true (or missing), then C<encode>, upon encountering a"
NSQ_SOURCE_LINE 00001006 "blessed object, will check for the availability of the C<TO_JSON> method"
NSQ_SOURCE_LINE 00001007 "on the object's class. If found, it will be called in scalar context and"
NSQ_SOURCE_LINE 00001008 "the resulting scalar will be encoded instead of the object."
NSQ_SOURCE_LINE 00001009 ""
NSQ_SOURCE_LINE 00001010 "The C<TO_JSON> method may safely call die if it wants. If C<TO_JSON>"
NSQ_SOURCE_LINE 00001011 "returns other blessed objects, those will be handled in the same"
NSQ_SOURCE_LINE 00001012 "way. C<TO_JSON> must take care of not causing an endless recursion cycle"
NSQ_SOURCE_LINE 00001013 "(== crash) in this case. The name of C<TO_JSON> was chosen because other"
NSQ_SOURCE_LINE 00001014 "methods called by the Perl core (== not by the user of the object) are"
NSQ_SOURCE_LINE 00001015 "usually in upper case letters and to avoid collisions with any C<to_json>"
NSQ_SOURCE_LINE 00001016 "function or method."
NSQ_SOURCE_LINE 00001017 ""
NSQ_SOURCE_LINE 00001018 "If C<$enable> is false (the default), then C<encode> will not consider"
NSQ_SOURCE_LINE 00001019 "this type of conversion."
NSQ_SOURCE_LINE 00001020 ""
NSQ_SOURCE_LINE 00001021 "This setting has no effect on C<decode>."
NSQ_SOURCE_LINE 00001022 ""
NSQ_SOURCE_LINE 00001023 "=head2 allow_tags (since version 3.0)"
NSQ_SOURCE_LINE 00001024 ""
NSQ_SOURCE_LINE 00001025 "    $json = $json->allow_tags([$enable])"
NSQ_SOURCE_LINE 00001026 ""
NSQ_SOURCE_LINE 00001027 "    $enabled = $json->get_allow_tags"
NSQ_SOURCE_LINE 00001028 ""
NSQ_SOURCE_LINE 00001029 "See L<OBJECT SERIALISATION> for details."
NSQ_SOURCE_LINE 00001030 ""
NSQ_SOURCE_LINE 00001031 "If C<$enable> is true (or missing), then C<encode>, upon encountering a"
NSQ_SOURCE_LINE 00001032 "blessed object, will check for the availability of the C<FREEZE> method on"
NSQ_SOURCE_LINE 00001033 "the object's class. If found, it will be used to serialise the object into"
NSQ_SOURCE_LINE 00001034 "a nonstandard tagged JSON value (that JSON decoders cannot decode)."
NSQ_SOURCE_LINE 00001035 ""
NSQ_SOURCE_LINE 00001036 "It also causes C<decode> to parse such tagged JSON values and deserialise"
NSQ_SOURCE_LINE 00001037 "them via a call to the C<THAW> method."
NSQ_SOURCE_LINE 00001038 ""
NSQ_SOURCE_LINE 00001039 "If C<$enable> is false (the default), then C<encode> will not consider"
NSQ_SOURCE_LINE 00001040 "this type of conversion, and tagged JSON values will cause a parse error"
NSQ_SOURCE_LINE 00001041 "in C<decode>, as if tags were not part of the grammar."
NSQ_SOURCE_LINE 00001042 ""
NSQ_SOURCE_LINE 00001043 "=head2 boolean_values (since version 4.0)"
NSQ_SOURCE_LINE 00001044 ""
NSQ_SOURCE_LINE 00001045 "    $json->boolean_values([$false, $true])"
NSQ_SOURCE_LINE 00001046 ""
NSQ_SOURCE_LINE 00001047 "    ($false,  $true) = $json->get_boolean_values"
NSQ_SOURCE_LINE 00001048 ""
NSQ_SOURCE_LINE 00001049 "By default, JSON booleans will be decoded as overloaded"
NSQ_SOURCE_LINE 00001050 "C<$JSON::false> and C<$JSON::true> objects."
NSQ_SOURCE_LINE 00001051 ""
NSQ_SOURCE_LINE 00001052 "With this method you can specify your own boolean values for decoding -"
NSQ_SOURCE_LINE 00001053 "on decode, JSON C<false> will be decoded as a copy of C<$false>, and JSON"
NSQ_SOURCE_LINE 00001054 "C<true> will be decoded as C<$true> (\"copy\" here is the same thing as"
NSQ_SOURCE_LINE 00001055 "assigning a value to another variable, i.e. C<$copy = $false>)."
NSQ_SOURCE_LINE 00001056 ""
NSQ_SOURCE_LINE 00001057 "This is useful when you want to pass a decoded data structure directly"
NSQ_SOURCE_LINE 00001058 "to other serialisers like YAML, Data::MessagePack and so on."
NSQ_SOURCE_LINE 00001059 ""
NSQ_SOURCE_LINE 00001060 "Note that this works only when you C<decode>. You can set incompatible"
NSQ_SOURCE_LINE 00001061 "boolean objects (like L<boolean>), but when you C<encode> a data structure"
NSQ_SOURCE_LINE 00001062 "with such boolean objects, you still need to enable C<convert_blessed>"
NSQ_SOURCE_LINE 00001063 "(and add a C<TO_JSON> method if necessary)."
NSQ_SOURCE_LINE 00001064 ""
NSQ_SOURCE_LINE 00001065 "Calling this method without any arguments will reset the booleans"
NSQ_SOURCE_LINE 00001066 "to their default values."
NSQ_SOURCE_LINE 00001067 ""
NSQ_SOURCE_LINE 00001068 "C<get_boolean_values> will return both C<$false> and C<$true> values, or"
NSQ_SOURCE_LINE 00001069 "the empty list when they are set to the default."
NSQ_SOURCE_LINE 00001070 ""
NSQ_SOURCE_LINE 00001071 "=head2 filter_json_object"
NSQ_SOURCE_LINE 00001072 ""
NSQ_SOURCE_LINE 00001073 "    $json = $json->filter_json_object([$coderef])"
NSQ_SOURCE_LINE 00001074 ""
NSQ_SOURCE_LINE 00001075 "When C<$coderef> is specified, it will be called from C<decode> each"
NSQ_SOURCE_LINE 00001076 "time it decodes a JSON object. The only argument is a reference to"
NSQ_SOURCE_LINE 00001077 "the newly-created hash. If the code references returns a single scalar"
NSQ_SOURCE_LINE 00001078 "(which need not be a reference), this value (or rather a copy of it) is"
NSQ_SOURCE_LINE 00001079 "inserted into the deserialised data structure. If it returns an empty"
NSQ_SOURCE_LINE 00001080 "list (NOTE: I<not> C<undef>, which is a valid scalar), the original"
NSQ_SOURCE_LINE 00001081 "deserialised hash will be inserted. This setting can slow down decoding"
NSQ_SOURCE_LINE 00001082 "considerably."
NSQ_SOURCE_LINE 00001083 ""
NSQ_SOURCE_LINE 00001084 "When C<$coderef> is omitted or undefined, any existing callback will"
NSQ_SOURCE_LINE 00001085 "be removed and C<decode> will not change the deserialised hash in any"
NSQ_SOURCE_LINE 00001086 "way."
NSQ_SOURCE_LINE 00001087 ""
NSQ_SOURCE_LINE 00001088 "Example, convert all JSON objects into the integer 5:"
NSQ_SOURCE_LINE 00001089 ""
NSQ_SOURCE_LINE 00001090 "   my $js = JSON->new->filter_json_object(sub { 5 });"
NSQ_SOURCE_LINE 00001091 "   # returns [5]"
NSQ_SOURCE_LINE 00001092 "   $js->decode('[{}]');"
NSQ_SOURCE_LINE 00001093 "   # returns 5"
NSQ_SOURCE_LINE 00001094 "   $js->decode('{\"a\":1, \"b\":2}');"
NSQ_SOURCE_LINE 00001095 ""
NSQ_SOURCE_LINE 00001096 "=head2 filter_json_single_key_object"
NSQ_SOURCE_LINE 00001097 ""
NSQ_SOURCE_LINE 00001098 "    $json = $json->filter_json_single_key_object($key [=> $coderef])"
NSQ_SOURCE_LINE 00001099 ""
NSQ_SOURCE_LINE 00001100 "Works remotely similar to C<filter_json_object>, but is only called for"
NSQ_SOURCE_LINE 00001101 "JSON objects having a single key named C<$key>."
NSQ_SOURCE_LINE 00001102 ""
NSQ_SOURCE_LINE 00001103 "This C<$coderef> is called before the one specified via"
NSQ_SOURCE_LINE 00001104 "C<filter_json_object>, if any. It gets passed the single value in the JSON"
NSQ_SOURCE_LINE 00001105 "object. If it returns a single value, it will be inserted into the data"
NSQ_SOURCE_LINE 00001106 "structure. If it returns nothing (not even C<undef> but the empty list),"
NSQ_SOURCE_LINE 00001107 "the callback from C<filter_json_object> will be called next, as if no"
NSQ_SOURCE_LINE 00001108 "single-key callback were specified."
NSQ_SOURCE_LINE 00001109 ""
NSQ_SOURCE_LINE 00001110 "If C<$coderef> is omitted or undefined, the corresponding callback will be"
NSQ_SOURCE_LINE 00001111 "disabled. There can only ever be one callback for a given key."
NSQ_SOURCE_LINE 00001112 ""
NSQ_SOURCE_LINE 00001113 "As this callback gets called less often then the C<filter_json_object>"
NSQ_SOURCE_LINE 00001114 "one, decoding speed will not usually suffer as much. Therefore, single-key"
NSQ_SOURCE_LINE 00001115 "objects make excellent targets to serialise Perl objects into, especially"
NSQ_SOURCE_LINE 00001116 "as single-key JSON objects are as close to the type-tagged value concept"
NSQ_SOURCE_LINE 00001117 "as JSON gets (it's basically an ID/VALUE tuple). Of course, JSON does not"
NSQ_SOURCE_LINE 00001118 "support this in any way, so you need to make sure your data never looks"
NSQ_SOURCE_LINE 00001119 "like a serialised Perl hash."
NSQ_SOURCE_LINE 00001120 ""
NSQ_SOURCE_LINE 00001121 "Typical names for the single object key are C<__class_whatever__>, or"
NSQ_SOURCE_LINE 00001122 "C<$__dollars_are_rarely_used__$> or C<}ugly_brace_placement>, or even"
NSQ_SOURCE_LINE 00001123 "things like C<__class_md5sum(classname)__>, to reduce the risk of clashing"
NSQ_SOURCE_LINE 00001124 "with real hashes."
NSQ_SOURCE_LINE 00001125 ""
NSQ_SOURCE_LINE 00001126 "Example, decode JSON objects of the form C<< { \"__widget__\" => <id> } >>"
NSQ_SOURCE_LINE 00001127 "into the corresponding C<< $WIDGET{<id>} >> object:"
NSQ_SOURCE_LINE 00001128 ""
NSQ_SOURCE_LINE 00001129 "   # return whatever is in $WIDGET{5}:"
NSQ_SOURCE_LINE 00001130 "   JSON"
NSQ_SOURCE_LINE 00001131 "      ->new"
NSQ_SOURCE_LINE 00001132 "      ->filter_json_single_key_object (__widget__ => sub {"
NSQ_SOURCE_LINE 00001133 "            $WIDGET{ $_[0] }"
NSQ_SOURCE_LINE 00001134 "         })"
NSQ_SOURCE_LINE 00001135 "      ->decode ('{\"__widget__\": 5')"
NSQ_SOURCE_LINE 00001136 ""
NSQ_SOURCE_LINE 00001137 "   # this can be used with a TO_JSON method in some \"widget\" class"
NSQ_SOURCE_LINE 00001138 "   # for serialisation to json:"
NSQ_SOURCE_LINE 00001139 "   sub WidgetBase::TO_JSON {"
NSQ_SOURCE_LINE 00001140 "      my ($self) = @_;"
NSQ_SOURCE_LINE 00001141 ""
NSQ_SOURCE_LINE 00001142 "      unless ($self->{id}) {"
NSQ_SOURCE_LINE 00001143 "         $self->{id} = ..get..some..id..;"
NSQ_SOURCE_LINE 00001144 "         $WIDGET{$self->{id}} = $self;"
NSQ_SOURCE_LINE 00001145 "      }"
NSQ_SOURCE_LINE 00001146 ""
NSQ_SOURCE_LINE 00001147 "      { __widget__ => $self->{id} }"
NSQ_SOURCE_LINE 00001148 "   }"
NSQ_SOURCE_LINE 00001149 ""
NSQ_SOURCE_LINE 00001150 "=head2 max_depth"
NSQ_SOURCE_LINE 00001151 ""
NSQ_SOURCE_LINE 00001152 "    $json = $json->max_depth([$maximum_nesting_depth])"
NSQ_SOURCE_LINE 00001153 "    "
NSQ_SOURCE_LINE 00001154 "    $max_depth = $json->get_max_depth"
NSQ_SOURCE_LINE 00001155 ""
NSQ_SOURCE_LINE 00001156 "Sets the maximum nesting level (default C<512>) accepted while encoding"
NSQ_SOURCE_LINE 00001157 "or decoding. If a higher nesting level is detected in JSON text or a Perl"
NSQ_SOURCE_LINE 00001158 "data structure, then the encoder and decoder will stop and croak at that"
NSQ_SOURCE_LINE 00001159 "point."
NSQ_SOURCE_LINE 00001160 ""
NSQ_SOURCE_LINE 00001161 "Nesting level is defined by number of hash- or arrayrefs that the encoder"
NSQ_SOURCE_LINE 00001162 "needs to traverse to reach a given point or the number of C<{> or C<[>"
NSQ_SOURCE_LINE 00001163 "characters without their matching closing parenthesis crossed to reach a"
NSQ_SOURCE_LINE 00001164 "given character in a string."
NSQ_SOURCE_LINE 00001165 ""
NSQ_SOURCE_LINE 00001166 "Setting the maximum depth to one disallows any nesting, so that ensures"
NSQ_SOURCE_LINE 00001167 "that the object is only a single hash/object or array."
NSQ_SOURCE_LINE 00001168 ""
NSQ_SOURCE_LINE 00001169 "If no argument is given, the highest possible setting will be used, which"
NSQ_SOURCE_LINE 00001170 "is rarely useful."
NSQ_SOURCE_LINE 00001171 ""
NSQ_SOURCE_LINE 00001172 "See L<JSON::XS/SECURITY CONSIDERATIONS> for more info on why this is useful."
NSQ_SOURCE_LINE 00001173 ""
NSQ_SOURCE_LINE 00001174 "=head2 max_size"
NSQ_SOURCE_LINE 00001175 ""
NSQ_SOURCE_LINE 00001176 "    $json = $json->max_size([$maximum_string_size])"
NSQ_SOURCE_LINE 00001177 "    "
NSQ_SOURCE_LINE 00001178 "    $max_size = $json->get_max_size"
NSQ_SOURCE_LINE 00001179 ""
NSQ_SOURCE_LINE 00001180 "Set the maximum length a JSON text may have (in bytes) where decoding is"
NSQ_SOURCE_LINE 00001181 "being attempted. The default is C<0>, meaning no limit. When C<decode>"
NSQ_SOURCE_LINE 00001182 "is called on a string that is longer then this many bytes, it will not"
NSQ_SOURCE_LINE 00001183 "attempt to decode the string but throw an exception. This setting has no"
NSQ_SOURCE_LINE 00001184 "effect on C<encode> (yet)."
NSQ_SOURCE_LINE 00001185 ""
NSQ_SOURCE_LINE 00001186 "If no argument is given, the limit check will be deactivated (same as when"
NSQ_SOURCE_LINE 00001187 "C<0> is specified)."
NSQ_SOURCE_LINE 00001188 ""
NSQ_SOURCE_LINE 00001189 "See L<JSON::XS/SECURITY CONSIDERATIONS> for more info on why this is useful."
NSQ_SOURCE_LINE 00001190 ""
NSQ_SOURCE_LINE 00001191 "=head2 encode"
NSQ_SOURCE_LINE 00001192 ""
NSQ_SOURCE_LINE 00001193 "    $json_text = $json->encode($perl_scalar)"
NSQ_SOURCE_LINE 00001194 ""
NSQ_SOURCE_LINE 00001195 "Converts the given Perl value or data structure to its JSON"
NSQ_SOURCE_LINE 00001196 "representation. Croaks on error."
NSQ_SOURCE_LINE 00001197 ""
NSQ_SOURCE_LINE 00001198 "=head2 decode"
NSQ_SOURCE_LINE 00001199 ""
NSQ_SOURCE_LINE 00001200 "    $perl_scalar = $json->decode($json_text)"
NSQ_SOURCE_LINE 00001201 ""
NSQ_SOURCE_LINE 00001202 "The opposite of C<encode>: expects a JSON text and tries to parse it,"
NSQ_SOURCE_LINE 00001203 "returning the resulting simple scalar or reference. Croaks on error."
NSQ_SOURCE_LINE 00001204 ""
NSQ_SOURCE_LINE 00001205 "=head2 decode_prefix"
NSQ_SOURCE_LINE 00001206 ""
NSQ_SOURCE_LINE 00001207 "    ($perl_scalar, $characters) = $json->decode_prefix($json_text)"
NSQ_SOURCE_LINE 00001208 ""
NSQ_SOURCE_LINE 00001209 "This works like the C<decode> method, but instead of raising an exception"
NSQ_SOURCE_LINE 00001210 "when there is trailing garbage after the first JSON object, it will"
NSQ_SOURCE_LINE 00001211 "silently stop parsing there and return the number of characters consumed"
NSQ_SOURCE_LINE 00001212 "so far."
NSQ_SOURCE_LINE 00001213 ""
NSQ_SOURCE_LINE 00001214 "This is useful if your JSON texts are not delimited by an outer protocol"
NSQ_SOURCE_LINE 00001215 "and you need to know where the JSON text ends."
NSQ_SOURCE_LINE 00001216 ""
NSQ_SOURCE_LINE 00001217 "   JSON->new->decode_prefix (\"[1] the tail\")"
NSQ_SOURCE_LINE 00001218 "   => ([1], 3)"
NSQ_SOURCE_LINE 00001219 ""
NSQ_SOURCE_LINE 00001220 "=head1 ADDITIONAL METHODS"
NSQ_SOURCE_LINE 00001221 ""
NSQ_SOURCE_LINE 00001222 "The following methods are for this module only."
NSQ_SOURCE_LINE 00001223 ""
NSQ_SOURCE_LINE 00001224 "=head2 backend"
NSQ_SOURCE_LINE 00001225 ""
NSQ_SOURCE_LINE 00001226 "    $backend = $json->backend"
NSQ_SOURCE_LINE 00001227 ""
NSQ_SOURCE_LINE 00001228 "Since 2.92, C<backend> method returns an abstract backend module used currently,"
NSQ_SOURCE_LINE 00001229 "which should be JSON::Backend::XS (which inherits JSON::XS or Cpanel::JSON::XS),"
NSQ_SOURCE_LINE 00001230 "or JSON::Backend::PP (which inherits JSON::PP), not to monkey-patch the actual"
NSQ_SOURCE_LINE 00001231 "backend module globally."
NSQ_SOURCE_LINE 00001232 ""
NSQ_SOURCE_LINE 00001233 "If you need to know what is used actually, use C<isa>, instead of string comparison."
NSQ_SOURCE_LINE 00001234 ""
NSQ_SOURCE_LINE 00001235 "=head2 is_xs"
NSQ_SOURCE_LINE 00001236 ""
NSQ_SOURCE_LINE 00001237 "    $boolean = $json->is_xs"
NSQ_SOURCE_LINE 00001238 ""
NSQ_SOURCE_LINE 00001239 "Returns true if the backend inherits JSON::XS or Cpanel::JSON::XS."
NSQ_SOURCE_LINE 00001240 ""
NSQ_SOURCE_LINE 00001241 "=head2 is_pp"
NSQ_SOURCE_LINE 00001242 ""
NSQ_SOURCE_LINE 00001243 "    $boolean = $json->is_pp"
NSQ_SOURCE_LINE 00001244 ""
NSQ_SOURCE_LINE 00001245 "Returns true if the backend inherits JSON::PP."
NSQ_SOURCE_LINE 00001246 ""
NSQ_SOURCE_LINE 00001247 "=head2 property"
NSQ_SOURCE_LINE 00001248 ""
NSQ_SOURCE_LINE 00001249 "    $settings = $json->property()"
NSQ_SOURCE_LINE 00001250 ""
NSQ_SOURCE_LINE 00001251 "Returns a reference to a hash that holds all the common flag settings."
NSQ_SOURCE_LINE 00001252 ""
NSQ_SOURCE_LINE 00001253 "    $json = $json->property('utf8' => 1)"
NSQ_SOURCE_LINE 00001254 "    $value = $json->property('utf8') # 1"
NSQ_SOURCE_LINE 00001255 ""
NSQ_SOURCE_LINE 00001256 "You can use this to get/set a value of a particular flag."
NSQ_SOURCE_LINE 00001257 ""
NSQ_SOURCE_LINE 00001258 "=head2 boolean"
NSQ_SOURCE_LINE 00001259 ""
NSQ_SOURCE_LINE 00001260 "    $boolean_object = JSON->boolean($scalar)"
NSQ_SOURCE_LINE 00001261 ""
NSQ_SOURCE_LINE 00001262 "Returns $JSON::true if $scalar contains a true value, $JSON::false otherwise."
NSQ_SOURCE_LINE 00001263 "You can use this as a full-qualified function (C<JSON::boolean($scalar)>)."
NSQ_SOURCE_LINE 00001264 ""
NSQ_SOURCE_LINE 00001265 "=head1 INCREMENTAL PARSING"
NSQ_SOURCE_LINE 00001266 ""
NSQ_SOURCE_LINE 00001267 "This section is also taken from JSON::XS."
NSQ_SOURCE_LINE 00001268 ""
NSQ_SOURCE_LINE 00001269 "In some cases, there is the need for incremental parsing of JSON"
NSQ_SOURCE_LINE 00001270 "texts. While this module always has to keep both JSON text and resulting"
NSQ_SOURCE_LINE 00001271 "Perl data structure in memory at one time, it does allow you to parse a"
NSQ_SOURCE_LINE 00001272 "JSON stream incrementally. It does so by accumulating text until it has"
NSQ_SOURCE_LINE 00001273 "a full JSON object, which it then can decode. This process is similar to"
NSQ_SOURCE_LINE 00001274 "using C<decode_prefix> to see if a full JSON object is available, but"
NSQ_SOURCE_LINE 00001275 "is much more efficient (and can be implemented with a minimum of method"
NSQ_SOURCE_LINE 00001276 "calls)."
NSQ_SOURCE_LINE 00001277 ""
NSQ_SOURCE_LINE 00001278 "This module will only attempt to parse the JSON text once it is sure it"
NSQ_SOURCE_LINE 00001279 "has enough text to get a decisive result, using a very simple but"
NSQ_SOURCE_LINE 00001280 "truly incremental parser. This means that it sometimes won't stop as"
NSQ_SOURCE_LINE 00001281 "early as the full parser, for example, it doesn't detect mismatched"
NSQ_SOURCE_LINE 00001282 "parentheses. The only thing it guarantees is that it starts decoding as"
NSQ_SOURCE_LINE 00001283 "soon as a syntactically valid JSON text has been seen. This means you need"
NSQ_SOURCE_LINE 00001284 "to set resource limits (e.g. C<max_size>) to ensure the parser will stop"
NSQ_SOURCE_LINE 00001285 "parsing in the presence if syntax errors."
NSQ_SOURCE_LINE 00001286 ""
NSQ_SOURCE_LINE 00001287 "The following methods implement this incremental parser."
NSQ_SOURCE_LINE 00001288 ""
NSQ_SOURCE_LINE 00001289 "=head2 incr_parse"
NSQ_SOURCE_LINE 00001290 ""
NSQ_SOURCE_LINE 00001291 "    $json->incr_parse( [$string] ) # void context"
NSQ_SOURCE_LINE 00001292 "    "
NSQ_SOURCE_LINE 00001293 "    $obj_or_undef = $json->incr_parse( [$string] ) # scalar context"
NSQ_SOURCE_LINE 00001294 "    "
NSQ_SOURCE_LINE 00001295 "    @obj_or_empty = $json->incr_parse( [$string] ) # list context"
NSQ_SOURCE_LINE 00001296 ""
NSQ_SOURCE_LINE 00001297 "This is the central parsing function. It can both append new text and"
NSQ_SOURCE_LINE 00001298 "extract objects from the stream accumulated so far (both of these"
NSQ_SOURCE_LINE 00001299 "functions are optional)."
NSQ_SOURCE_LINE 00001300 ""
NSQ_SOURCE_LINE 00001301 "If C<$string> is given, then this string is appended to the already"
NSQ_SOURCE_LINE 00001302 "existing JSON fragment stored in the C<$json> object."
NSQ_SOURCE_LINE 00001303 ""
NSQ_SOURCE_LINE 00001304 "After that, if the function is called in void context, it will simply"
NSQ_SOURCE_LINE 00001305 "return without doing anything further. This can be used to add more text"
NSQ_SOURCE_LINE 00001306 "in as many chunks as you want."
NSQ_SOURCE_LINE 00001307 ""
NSQ_SOURCE_LINE 00001308 "If the method is called in scalar context, then it will try to extract"
NSQ_SOURCE_LINE 00001309 "exactly I<one> JSON object. If that is successful, it will return this"
NSQ_SOURCE_LINE 00001310 "object, otherwise it will return C<undef>. If there is a parse error,"
NSQ_SOURCE_LINE 00001311 "this method will croak just as C<decode> would do (one can then use"
NSQ_SOURCE_LINE 00001312 "C<incr_skip> to skip the erroneous part). This is the most common way of"
NSQ_SOURCE_LINE 00001313 "using the method."
NSQ_SOURCE_LINE 00001314 ""
NSQ_SOURCE_LINE 00001315 "And finally, in list context, it will try to extract as many objects"
NSQ_SOURCE_LINE 00001316 "from the stream as it can find and return them, or the empty list"
NSQ_SOURCE_LINE 00001317 "otherwise. For this to work, there must be no separators (other than"
NSQ_SOURCE_LINE 00001318 "whitespace) between the JSON objects or arrays, instead they must be"
NSQ_SOURCE_LINE 00001319 "concatenated back-to-back. If an error occurs, an exception will be"
NSQ_SOURCE_LINE 00001320 "raised as in the scalar context case. Note that in this case, any"
NSQ_SOURCE_LINE 00001321 "previously-parsed JSON texts will be lost."
NSQ_SOURCE_LINE 00001322 ""
NSQ_SOURCE_LINE 00001323 "Example: Parse some JSON arrays/objects in a given string and return"
NSQ_SOURCE_LINE 00001324 "them."
NSQ_SOURCE_LINE 00001325 ""
NSQ_SOURCE_LINE 00001326 "    my @objs = JSON->new->incr_parse (\"[5][7][1,2]\");"
NSQ_SOURCE_LINE 00001327 ""
NSQ_SOURCE_LINE 00001328 "=head2 incr_text"
NSQ_SOURCE_LINE 00001329 ""
NSQ_SOURCE_LINE 00001330 "    $lvalue_string = $json->incr_text"
NSQ_SOURCE_LINE 00001331 ""
NSQ_SOURCE_LINE 00001332 "This method returns the currently stored JSON fragment as an lvalue, that"
NSQ_SOURCE_LINE 00001333 "is, you can manipulate it. This I<only> works when a preceding call to"
NSQ_SOURCE_LINE 00001334 "C<incr_parse> in I<scalar context> successfully returned an object. Under"
NSQ_SOURCE_LINE 00001335 "all other circumstances you must not call this function (I mean it."
NSQ_SOURCE_LINE 00001336 "although in simple tests it might actually work, it I<will> fail under"
NSQ_SOURCE_LINE 00001337 "real world conditions). As a special exception, you can also call this"
NSQ_SOURCE_LINE 00001338 "method before having parsed anything."
NSQ_SOURCE_LINE 00001339 ""
NSQ_SOURCE_LINE 00001340 "That means you can only use this function to look at or manipulate text"
NSQ_SOURCE_LINE 00001341 "before or after complete JSON objects, not while the parser is in the"
NSQ_SOURCE_LINE 00001342 "middle of parsing a JSON object."
NSQ_SOURCE_LINE 00001343 ""
NSQ_SOURCE_LINE 00001344 "This function is useful in two cases: a) finding the trailing text after a"
NSQ_SOURCE_LINE 00001345 "JSON object or b) parsing multiple JSON objects separated by non-JSON text"
NSQ_SOURCE_LINE 00001346 "(such as commas)."
NSQ_SOURCE_LINE 00001347 ""
NSQ_SOURCE_LINE 00001348 "=head2 incr_skip"
NSQ_SOURCE_LINE 00001349 ""
NSQ_SOURCE_LINE 00001350 "    $json->incr_skip"
NSQ_SOURCE_LINE 00001351 ""
NSQ_SOURCE_LINE 00001352 "This will reset the state of the incremental parser and will remove"
NSQ_SOURCE_LINE 00001353 "the parsed text from the input buffer so far. This is useful after"
NSQ_SOURCE_LINE 00001354 "C<incr_parse> died, in which case the input buffer and incremental parser"
NSQ_SOURCE_LINE 00001355 "state is left unchanged, to skip the text parsed so far and to reset the"
NSQ_SOURCE_LINE 00001356 "parse state."
NSQ_SOURCE_LINE 00001357 ""
NSQ_SOURCE_LINE 00001358 "The difference to C<incr_reset> is that only text until the parse error"
NSQ_SOURCE_LINE 00001359 "occurred is removed."
NSQ_SOURCE_LINE 00001360 ""
NSQ_SOURCE_LINE 00001361 "=head2 incr_reset"
NSQ_SOURCE_LINE 00001362 ""
NSQ_SOURCE_LINE 00001363 "    $json->incr_reset"
NSQ_SOURCE_LINE 00001364 ""
NSQ_SOURCE_LINE 00001365 "This completely resets the incremental parser, that is, after this call,"
NSQ_SOURCE_LINE 00001366 "it will be as if the parser had never parsed anything."
NSQ_SOURCE_LINE 00001367 ""
NSQ_SOURCE_LINE 00001368 "This is useful if you want to repeatedly parse JSON objects and want to"
NSQ_SOURCE_LINE 00001369 "ignore any trailing data, which means you have to reset the parser after"
NSQ_SOURCE_LINE 00001370 "each successful decode."
NSQ_SOURCE_LINE 00001371 ""
NSQ_SOURCE_LINE 00001372 "=head1 MAPPING"
NSQ_SOURCE_LINE 00001373 ""
NSQ_SOURCE_LINE 00001374 "Most of this section is also taken from JSON::XS."
NSQ_SOURCE_LINE 00001375 ""
NSQ_SOURCE_LINE 00001376 "This section describes how the backend modules map Perl values to JSON values and"
NSQ_SOURCE_LINE 00001377 "vice versa. These mappings are designed to \"do the right thing\" in most"
NSQ_SOURCE_LINE 00001378 "circumstances automatically, preserving round-tripping characteristics"
NSQ_SOURCE_LINE 00001379 "(what you put in comes out as something equivalent)."
NSQ_SOURCE_LINE 00001380 ""
NSQ_SOURCE_LINE 00001381 "For the more enlightened: note that in the following descriptions,"
NSQ_SOURCE_LINE 00001382 "lowercase I<perl> refers to the Perl interpreter, while uppercase I<Perl>"
NSQ_SOURCE_LINE 00001383 "refers to the abstract Perl language itself."
NSQ_SOURCE_LINE 00001384 ""
NSQ_SOURCE_LINE 00001385 "=head2 JSON -> PERL"
NSQ_SOURCE_LINE 00001386 ""
NSQ_SOURCE_LINE 00001387 "=over 4"
NSQ_SOURCE_LINE 00001388 ""
NSQ_SOURCE_LINE 00001389 "=item object"
NSQ_SOURCE_LINE 00001390 ""
NSQ_SOURCE_LINE 00001391 "A JSON object becomes a reference to a hash in Perl. No ordering of object"
NSQ_SOURCE_LINE 00001392 "keys is preserved (JSON does not preserver object key ordering itself)."
NSQ_SOURCE_LINE 00001393 ""
NSQ_SOURCE_LINE 00001394 "=item array"
NSQ_SOURCE_LINE 00001395 ""
NSQ_SOURCE_LINE 00001396 "A JSON array becomes a reference to an array in Perl."
NSQ_SOURCE_LINE 00001397 ""
NSQ_SOURCE_LINE 00001398 "=item string"
NSQ_SOURCE_LINE 00001399 ""
NSQ_SOURCE_LINE 00001400 "A JSON string becomes a string scalar in Perl - Unicode codepoints in JSON"
NSQ_SOURCE_LINE 00001401 "are represented by the same codepoints in the Perl string, so no manual"
NSQ_SOURCE_LINE 00001402 "decoding is necessary."
NSQ_SOURCE_LINE 00001403 ""
NSQ_SOURCE_LINE 00001404 "=item number"
NSQ_SOURCE_LINE 00001405 ""
NSQ_SOURCE_LINE 00001406 "A JSON number becomes either an integer, numeric (floating point) or"
NSQ_SOURCE_LINE 00001407 "string scalar in perl, depending on its range and any fractional parts. On"
NSQ_SOURCE_LINE 00001408 "the Perl level, there is no difference between those as Perl handles all"
NSQ_SOURCE_LINE 00001409 "the conversion details, but an integer may take slightly less memory and"
NSQ_SOURCE_LINE 00001410 "might represent more values exactly than floating point numbers."
NSQ_SOURCE_LINE 00001411 ""
NSQ_SOURCE_LINE 00001412 "If the number consists of digits only, this module will try to represent"
NSQ_SOURCE_LINE 00001413 "it as an integer value. If that fails, it will try to represent it as"
NSQ_SOURCE_LINE 00001414 "a numeric (floating point) value if that is possible without loss of"
NSQ_SOURCE_LINE 00001415 "precision. Otherwise it will preserve the number as a string value (in"
NSQ_SOURCE_LINE 00001416 "which case you lose roundtripping ability, as the JSON number will be"
NSQ_SOURCE_LINE 00001417 "re-encoded to a JSON string)."
NSQ_SOURCE_LINE 00001418 ""
NSQ_SOURCE_LINE 00001419 "Numbers containing a fractional or exponential part will always be"
NSQ_SOURCE_LINE 00001420 "represented as numeric (floating point) values, possibly at a loss of"
NSQ_SOURCE_LINE 00001421 "precision (in which case you might lose perfect roundtripping ability, but"
NSQ_SOURCE_LINE 00001422 "the JSON number will still be re-encoded as a JSON number)."
NSQ_SOURCE_LINE 00001423 ""
NSQ_SOURCE_LINE 00001424 "Note that precision is not accuracy - binary floating point values cannot"
NSQ_SOURCE_LINE 00001425 "represent most decimal fractions exactly, and when converting from and to"
NSQ_SOURCE_LINE 00001426 "floating point, this module only guarantees precision up to but not including"
NSQ_SOURCE_LINE 00001427 "the least significant bit."
NSQ_SOURCE_LINE 00001428 ""
NSQ_SOURCE_LINE 00001429 "=item true, false"
NSQ_SOURCE_LINE 00001430 ""
NSQ_SOURCE_LINE 00001431 "These JSON atoms become C<JSON::true> and C<JSON::false>,"
NSQ_SOURCE_LINE 00001432 "respectively. They are overloaded to act almost exactly like the numbers"
NSQ_SOURCE_LINE 00001433 "C<1> and C<0>. You can check whether a scalar is a JSON boolean by using"
NSQ_SOURCE_LINE 00001434 "the C<JSON::is_bool> function."
NSQ_SOURCE_LINE 00001435 ""
NSQ_SOURCE_LINE 00001436 "=item null"
NSQ_SOURCE_LINE 00001437 ""
NSQ_SOURCE_LINE 00001438 "A JSON null atom becomes C<undef> in Perl."
NSQ_SOURCE_LINE 00001439 ""
NSQ_SOURCE_LINE 00001440 "=item shell-style comments (C<< # I<text> >>)"
NSQ_SOURCE_LINE 00001441 ""
NSQ_SOURCE_LINE 00001442 "As a nonstandard extension to the JSON syntax that is enabled by the"
NSQ_SOURCE_LINE 00001443 "C<relaxed> setting, shell-style comments are allowed. They can start"
NSQ_SOURCE_LINE 00001444 "anywhere outside strings and go till the end of the line."
NSQ_SOURCE_LINE 00001445 ""
NSQ_SOURCE_LINE 00001446 "=item tagged values (C<< (I<tag>)I<value> >>)."
NSQ_SOURCE_LINE 00001447 ""
NSQ_SOURCE_LINE 00001448 "Another nonstandard extension to the JSON syntax, enabled with the"
NSQ_SOURCE_LINE 00001449 "C<allow_tags> setting, are tagged values. In this implementation, the"
NSQ_SOURCE_LINE 00001450 "I<tag> must be a perl package/class name encoded as a JSON string, and the"
NSQ_SOURCE_LINE 00001451 "I<value> must be a JSON array encoding optional constructor arguments."
NSQ_SOURCE_LINE 00001452 ""
NSQ_SOURCE_LINE 00001453 "See L<OBJECT SERIALISATION>, below, for details."
NSQ_SOURCE_LINE 00001454 ""
NSQ_SOURCE_LINE 00001455 "=back"
NSQ_SOURCE_LINE 00001456 ""
NSQ_SOURCE_LINE 00001457 ""
NSQ_SOURCE_LINE 00001458 "=head2 PERL -> JSON"
NSQ_SOURCE_LINE 00001459 ""
NSQ_SOURCE_LINE 00001460 "The mapping from Perl to JSON is slightly more difficult, as Perl is a"
NSQ_SOURCE_LINE 00001461 "truly typeless language, so we can only guess which JSON type is meant by"
NSQ_SOURCE_LINE 00001462 "a Perl value."
NSQ_SOURCE_LINE 00001463 ""
NSQ_SOURCE_LINE 00001464 "=over 4"
NSQ_SOURCE_LINE 00001465 ""
NSQ_SOURCE_LINE 00001466 "=item hash references"
NSQ_SOURCE_LINE 00001467 ""
NSQ_SOURCE_LINE 00001468 "Perl hash references become JSON objects. As there is no inherent"
NSQ_SOURCE_LINE 00001469 "ordering in hash keys (or JSON objects), they will usually be encoded"
NSQ_SOURCE_LINE 00001470 "in a pseudo-random order. This module can optionally sort the hash keys"
NSQ_SOURCE_LINE 00001471 "(determined by the I<canonical> flag), so the same data structure will"
NSQ_SOURCE_LINE 00001472 "serialise to the same JSON text (given same settings and version of"
NSQ_SOURCE_LINE 00001473 "the same backend), but this incurs a runtime overhead and is only rarely useful,"
NSQ_SOURCE_LINE 00001474 "e.g. when you want to compare some JSON text against another for equality."
NSQ_SOURCE_LINE 00001475 ""
NSQ_SOURCE_LINE 00001476 "=item array references"
NSQ_SOURCE_LINE 00001477 ""
NSQ_SOURCE_LINE 00001478 "Perl array references become JSON arrays."
NSQ_SOURCE_LINE 00001479 ""
NSQ_SOURCE_LINE 00001480 "=item other references"
NSQ_SOURCE_LINE 00001481 ""
NSQ_SOURCE_LINE 00001482 "Other unblessed references are generally not allowed and will cause an"
NSQ_SOURCE_LINE 00001483 "exception to be thrown, except for references to the integers C<0> and"
NSQ_SOURCE_LINE 00001484 "C<1>, which get turned into C<false> and C<true> atoms in JSON. You can"
NSQ_SOURCE_LINE 00001485 "also use C<JSON::false> and C<JSON::true> to improve readability."
NSQ_SOURCE_LINE 00001486 ""
NSQ_SOURCE_LINE 00001487 "   encode_json [\\0,JSON::true]      # yields [false,true]"
NSQ_SOURCE_LINE 00001488 ""
NSQ_SOURCE_LINE 00001489 "=item JSON::true, JSON::false, JSON::null"
NSQ_SOURCE_LINE 00001490 ""
NSQ_SOURCE_LINE 00001491 "These special values become JSON true and JSON false values,"
NSQ_SOURCE_LINE 00001492 "respectively. You can also use C<\\1> and C<\\0> directly if you want."
NSQ_SOURCE_LINE 00001493 ""
NSQ_SOURCE_LINE 00001494 "=item blessed objects"
NSQ_SOURCE_LINE 00001495 ""
NSQ_SOURCE_LINE 00001496 "Blessed objects are not directly representable in JSON, but C<JSON::XS>"
NSQ_SOURCE_LINE 00001497 "allows various ways of handling objects. See L<OBJECT SERIALISATION>,"
NSQ_SOURCE_LINE 00001498 "below, for details."
NSQ_SOURCE_LINE 00001499 ""
NSQ_SOURCE_LINE 00001500 "=item simple scalars"
NSQ_SOURCE_LINE 00001501 ""
NSQ_SOURCE_LINE 00001502 "Simple Perl scalars (any scalar that is not a reference) are the most"
NSQ_SOURCE_LINE 00001503 "difficult objects to encode: this module will encode undefined scalars as"
NSQ_SOURCE_LINE 00001504 "JSON C<null> values, scalars that have last been used in a string context"
NSQ_SOURCE_LINE 00001505 "before encoding as JSON strings, and anything else as number value:"
NSQ_SOURCE_LINE 00001506 ""
NSQ_SOURCE_LINE 00001507 "   # dump as number"
NSQ_SOURCE_LINE 00001508 "   encode_json [2]                      # yields [2]"
NSQ_SOURCE_LINE 00001509 "   encode_json [-3.0e17]                # yields [-3e+17]"
NSQ_SOURCE_LINE 00001510 "   my $value = 5; encode_json [$value]  # yields [5]"
NSQ_SOURCE_LINE 00001511 ""
NSQ_SOURCE_LINE 00001512 "   # used as string, so dump as string"
NSQ_SOURCE_LINE 00001513 "   print $value;"
NSQ_SOURCE_LINE 00001514 "   encode_json [$value]                 # yields [\"5\"]"
NSQ_SOURCE_LINE 00001515 ""
NSQ_SOURCE_LINE 00001516 "   # undef becomes null"
NSQ_SOURCE_LINE 00001517 "   encode_json [undef]                  # yields [null]"
NSQ_SOURCE_LINE 00001518 ""
NSQ_SOURCE_LINE 00001519 "You can force the type to be a string by stringifying it:"
NSQ_SOURCE_LINE 00001520 ""
NSQ_SOURCE_LINE 00001521 "   my $x = 3.1; # some variable containing a number"
NSQ_SOURCE_LINE 00001522 "   \"$x\";        # stringified"
NSQ_SOURCE_LINE 00001523 "   $x .= \"\";    # another, more awkward way to stringify"
NSQ_SOURCE_LINE 00001524 "   print $x;    # perl does it for you, too, quite often"
NSQ_SOURCE_LINE 00001525 ""
NSQ_SOURCE_LINE 00001526 "You can force the type to be a number by numifying it:"
NSQ_SOURCE_LINE 00001527 ""
NSQ_SOURCE_LINE 00001528 "   my $x = \"3\"; # some variable containing a string"
NSQ_SOURCE_LINE 00001529 "   $x += 0;     # numify it, ensuring it will be dumped as a number"
NSQ_SOURCE_LINE 00001530 "   $x *= 1;     # same thing, the choice is yours."
NSQ_SOURCE_LINE 00001531 ""
NSQ_SOURCE_LINE 00001532 "You can not currently force the type in other, less obscure, ways. Tell me"
NSQ_SOURCE_LINE 00001533 "if you need this capability (but don't forget to explain why it's needed"
NSQ_SOURCE_LINE 00001534 ":)."
NSQ_SOURCE_LINE 00001535 ""
NSQ_SOURCE_LINE 00001536 "Since version 2.91_01, JSON::PP uses a different number detection logic"
NSQ_SOURCE_LINE 00001537 "that converts a scalar that is possible to turn into a number safely."
NSQ_SOURCE_LINE 00001538 "The new logic is slightly faster, and tends to help people who use older"
NSQ_SOURCE_LINE 00001539 "perl or who want to encode complicated data structure. However, this may"
NSQ_SOURCE_LINE 00001540 "results in a different JSON text from the one JSON::XS encodes (and"
NSQ_SOURCE_LINE 00001541 "thus may break tests that compare entire JSON texts). If you do"
NSQ_SOURCE_LINE 00001542 "need the previous behavior for better compatibility or for finer control,"
NSQ_SOURCE_LINE 00001543 "set PERL_JSON_PP_USE_B environmental variable to true before you"
NSQ_SOURCE_LINE 00001544 "C<use> JSON."
NSQ_SOURCE_LINE 00001545 ""
NSQ_SOURCE_LINE 00001546 "Note that numerical precision has the same meaning as under Perl (so"
NSQ_SOURCE_LINE 00001547 "binary to decimal conversion follows the same rules as in Perl, which"
NSQ_SOURCE_LINE 00001548 "can differ to other languages). Also, your perl interpreter might expose"
NSQ_SOURCE_LINE 00001549 "extensions to the floating point numbers of your platform, such as"
NSQ_SOURCE_LINE 00001550 "infinities or NaN's - these cannot be represented in JSON, and it is an"
NSQ_SOURCE_LINE 00001551 "error to pass those in."
NSQ_SOURCE_LINE 00001552 ""
NSQ_SOURCE_LINE 00001553 "JSON.pm backend modules trust what you pass to C<encode> method"
NSQ_SOURCE_LINE 00001554 "(or C<encode_json> function) is a clean, validated data structure with"
NSQ_SOURCE_LINE 00001555 "values that can be represented as valid JSON values only, because it's"
NSQ_SOURCE_LINE 00001556 "not from an external data source (as opposed to JSON texts you pass to"
NSQ_SOURCE_LINE 00001557 "C<decode> or C<decode_json>, which JSON backends consider tainted and"
NSQ_SOURCE_LINE 00001558 "don't trust). As JSON backends don't know exactly what you and consumers"
NSQ_SOURCE_LINE 00001559 "of your JSON texts want the unexpected values to be (you may want to"
NSQ_SOURCE_LINE 00001560 "convert them into null, or to stringify them with or without"
NSQ_SOURCE_LINE 00001561 "normalisation (string representation of infinities/NaN may vary"
NSQ_SOURCE_LINE 00001562 "depending on platforms), or to croak without conversion), you're advised"
NSQ_SOURCE_LINE 00001563 "to do what you and your consumers need before you encode, and also not"
NSQ_SOURCE_LINE 00001564 "to numify values that may start with values that look like a number"
NSQ_SOURCE_LINE 00001565 "(including infinities/NaN), without validating."
NSQ_SOURCE_LINE 00001566 ""
NSQ_SOURCE_LINE 00001567 "=back"
NSQ_SOURCE_LINE 00001568 ""
NSQ_SOURCE_LINE 00001569 "=head2 OBJECT SERIALISATION"
NSQ_SOURCE_LINE 00001570 ""
NSQ_SOURCE_LINE 00001571 "As JSON cannot directly represent Perl objects, you have to choose between"
NSQ_SOURCE_LINE 00001572 "a pure JSON representation (without the ability to deserialise the object"
NSQ_SOURCE_LINE 00001573 "automatically again), and a nonstandard extension to the JSON syntax,"
NSQ_SOURCE_LINE 00001574 "tagged values."
NSQ_SOURCE_LINE 00001575 ""
NSQ_SOURCE_LINE 00001576 "=head3 SERIALISATION"
NSQ_SOURCE_LINE 00001577 ""
NSQ_SOURCE_LINE 00001578 "What happens when this module encounters a Perl object depends on the"
NSQ_SOURCE_LINE 00001579 "C<allow_blessed>, C<convert_blessed> and C<allow_tags> settings, which"
NSQ_SOURCE_LINE 00001580 "are used in this order:"
NSQ_SOURCE_LINE 00001581 ""
NSQ_SOURCE_LINE 00001582 "=over 4"
NSQ_SOURCE_LINE 00001583 ""
NSQ_SOURCE_LINE 00001584 "=item 1. C<allow_tags> is enabled and the object has a C<FREEZE> method."
NSQ_SOURCE_LINE 00001585 ""
NSQ_SOURCE_LINE 00001586 "In this case, C<JSON> creates a tagged JSON value, using a nonstandard"
NSQ_SOURCE_LINE 00001587 "extension to the JSON syntax."
NSQ_SOURCE_LINE 00001588 ""
NSQ_SOURCE_LINE 00001589 "This works by invoking the C<FREEZE> method on the object, with the first"
NSQ_SOURCE_LINE 00001590 "argument being the object to serialise, and the second argument being the"
NSQ_SOURCE_LINE 00001591 "constant string C<JSON> to distinguish it from other serialisers."
NSQ_SOURCE_LINE 00001592 ""
NSQ_SOURCE_LINE 00001593 "The C<FREEZE> method can return any number of values (i.e. zero or"
NSQ_SOURCE_LINE 00001594 "more). These values and the package/classname of the object will then be"
NSQ_SOURCE_LINE 00001595 "encoded as a tagged JSON value in the following format:"
NSQ_SOURCE_LINE 00001596 ""
NSQ_SOURCE_LINE 00001597 "   (\"classname\")[FREEZE return values...]"
NSQ_SOURCE_LINE 00001598 ""
NSQ_SOURCE_LINE 00001599 "e.g.:"
NSQ_SOURCE_LINE 00001600 ""
NSQ_SOURCE_LINE 00001601 "   (\"URI\")[\"http://www.google.com/\"]"
NSQ_SOURCE_LINE 00001602 "   (\"MyDate\")[2013,10,29]"
NSQ_SOURCE_LINE 00001603 "   (\"ImageData::JPEG\")[\"Z3...VlCg==\"]"
NSQ_SOURCE_LINE 00001604 ""
NSQ_SOURCE_LINE 00001605 "For example, the hypothetical C<My::Object> C<FREEZE> method might use the"
NSQ_SOURCE_LINE 00001606 "objects C<type> and C<id> members to encode the object:"
NSQ_SOURCE_LINE 00001607 ""
NSQ_SOURCE_LINE 00001608 "   sub My::Object::FREEZE {"
NSQ_SOURCE_LINE 00001609 "      my ($self, $serialiser) = @_;"
NSQ_SOURCE_LINE 00001610 ""
NSQ_SOURCE_LINE 00001611 "      ($self->{type}, $self->{id})"
NSQ_SOURCE_LINE 00001612 "   }"
NSQ_SOURCE_LINE 00001613 ""
NSQ_SOURCE_LINE 00001614 "=item 2. C<convert_blessed> is enabled and the object has a C<TO_JSON> method."
NSQ_SOURCE_LINE 00001615 ""
NSQ_SOURCE_LINE 00001616 "In this case, the C<TO_JSON> method of the object is invoked in scalar"
NSQ_SOURCE_LINE 00001617 "context. It must return a single scalar that can be directly encoded into"
NSQ_SOURCE_LINE 00001618 "JSON. This scalar replaces the object in the JSON text."
NSQ_SOURCE_LINE 00001619 ""
NSQ_SOURCE_LINE 00001620 "For example, the following C<TO_JSON> method will convert all L<URI>"
NSQ_SOURCE_LINE 00001621 "objects to JSON strings when serialised. The fact that these values"
NSQ_SOURCE_LINE 00001622 "originally were L<URI> objects is lost."
NSQ_SOURCE_LINE 00001623 ""
NSQ_SOURCE_LINE 00001624 "   sub URI::TO_JSON {"
NSQ_SOURCE_LINE 00001625 "      my ($uri) = @_;"
NSQ_SOURCE_LINE 00001626 "      $uri->as_string"
NSQ_SOURCE_LINE 00001627 "   }"
NSQ_SOURCE_LINE 00001628 ""
NSQ_SOURCE_LINE 00001629 "=item 3. C<allow_blessed> is enabled."
NSQ_SOURCE_LINE 00001630 ""
NSQ_SOURCE_LINE 00001631 "The object will be serialised as a JSON null value."
NSQ_SOURCE_LINE 00001632 ""
NSQ_SOURCE_LINE 00001633 "=item 4. none of the above"
NSQ_SOURCE_LINE 00001634 ""
NSQ_SOURCE_LINE 00001635 "If none of the settings are enabled or the respective methods are missing,"
NSQ_SOURCE_LINE 00001636 "this module throws an exception."
NSQ_SOURCE_LINE 00001637 ""
NSQ_SOURCE_LINE 00001638 "=back"
NSQ_SOURCE_LINE 00001639 ""
NSQ_SOURCE_LINE 00001640 "=head3 DESERIALISATION"
NSQ_SOURCE_LINE 00001641 ""
NSQ_SOURCE_LINE 00001642 "For deserialisation there are only two cases to consider: either"
NSQ_SOURCE_LINE 00001643 "nonstandard tagging was used, in which case C<allow_tags> decides,"
NSQ_SOURCE_LINE 00001644 "or objects cannot be automatically be deserialised, in which"
NSQ_SOURCE_LINE 00001645 "case you can use postprocessing or the C<filter_json_object> or"
NSQ_SOURCE_LINE 00001646 "C<filter_json_single_key_object> callbacks to get some real objects our of"
NSQ_SOURCE_LINE 00001647 "your JSON."
NSQ_SOURCE_LINE 00001648 ""
NSQ_SOURCE_LINE 00001649 "This section only considers the tagged value case: a tagged JSON object"
NSQ_SOURCE_LINE 00001650 "is encountered during decoding and C<allow_tags> is disabled, a parse"
NSQ_SOURCE_LINE 00001651 "error will result (as if tagged values were not part of the grammar)."
NSQ_SOURCE_LINE 00001652 ""
NSQ_SOURCE_LINE 00001653 "If C<allow_tags> is enabled, this module will look up the C<THAW> method"
NSQ_SOURCE_LINE 00001654 "of the package/classname used during serialisation (it will not attempt"
NSQ_SOURCE_LINE 00001655 "to load the package as a Perl module). If there is no such method, the"
NSQ_SOURCE_LINE 00001656 "decoding will fail with an error."
NSQ_SOURCE_LINE 00001657 ""
NSQ_SOURCE_LINE 00001658 "Otherwise, the C<THAW> method is invoked with the classname as first"
NSQ_SOURCE_LINE 00001659 "argument, the constant string C<JSON> as second argument, and all the"
NSQ_SOURCE_LINE 00001660 "values from the JSON array (the values originally returned by the"
NSQ_SOURCE_LINE 00001661 "C<FREEZE> method) as remaining arguments."
NSQ_SOURCE_LINE 00001662 ""
NSQ_SOURCE_LINE 00001663 "The method must then return the object. While technically you can return"
NSQ_SOURCE_LINE 00001664 "any Perl scalar, you might have to enable the C<allow_nonref> setting to"
NSQ_SOURCE_LINE 00001665 "make that work in all cases, so better return an actual blessed reference."
NSQ_SOURCE_LINE 00001666 ""
NSQ_SOURCE_LINE 00001667 "As an example, let's implement a C<THAW> function that regenerates the"
NSQ_SOURCE_LINE 00001668 "C<My::Object> from the C<FREEZE> example earlier:"
NSQ_SOURCE_LINE 00001669 ""
NSQ_SOURCE_LINE 00001670 "   sub My::Object::THAW {"
NSQ_SOURCE_LINE 00001671 "      my ($class, $serialiser, $type, $id) = @_;"
NSQ_SOURCE_LINE 00001672 ""
NSQ_SOURCE_LINE 00001673 "      $class->new (type => $type, id => $id)"
NSQ_SOURCE_LINE 00001674 "   }"
NSQ_SOURCE_LINE 00001675 ""
NSQ_SOURCE_LINE 00001676 ""
NSQ_SOURCE_LINE 00001677 "=head1 ENCODING/CODESET FLAG NOTES"
NSQ_SOURCE_LINE 00001678 ""
NSQ_SOURCE_LINE 00001679 "This section is taken from JSON::XS."
NSQ_SOURCE_LINE 00001680 ""
NSQ_SOURCE_LINE 00001681 "The interested reader might have seen a number of flags that signify"
NSQ_SOURCE_LINE 00001682 "encodings or codesets - C<utf8>, C<latin1> and C<ascii>. There seems to be"
NSQ_SOURCE_LINE 00001683 "some confusion on what these do, so here is a short comparison:"
NSQ_SOURCE_LINE 00001684 ""
NSQ_SOURCE_LINE 00001685 "C<utf8> controls whether the JSON text created by C<encode> (and expected"
NSQ_SOURCE_LINE 00001686 "by C<decode>) is UTF-8 encoded or not, while C<latin1> and C<ascii> only"
NSQ_SOURCE_LINE 00001687 "control whether C<encode> escapes character values outside their respective"
NSQ_SOURCE_LINE 00001688 "codeset range. Neither of these flags conflict with each other, although"
NSQ_SOURCE_LINE 00001689 "some combinations make less sense than others."
NSQ_SOURCE_LINE 00001690 ""
NSQ_SOURCE_LINE 00001691 "Care has been taken to make all flags symmetrical with respect to"
NSQ_SOURCE_LINE 00001692 "C<encode> and C<decode>, that is, texts encoded with any combination of"
NSQ_SOURCE_LINE 00001693 "these flag values will be correctly decoded when the same flags are used"
NSQ_SOURCE_LINE 00001694 "- in general, if you use different flag settings while encoding vs. when"
NSQ_SOURCE_LINE 00001695 "decoding you likely have a bug somewhere."
NSQ_SOURCE_LINE 00001696 ""
NSQ_SOURCE_LINE 00001697 "Below comes a verbose discussion of these flags. Note that a \"codeset\" is"
NSQ_SOURCE_LINE 00001698 "simply an abstract set of character-codepoint pairs, while an encoding"
NSQ_SOURCE_LINE 00001699 "takes those codepoint numbers and I<encodes> them, in our case into"
NSQ_SOURCE_LINE 00001700 "octets. Unicode is (among other things) a codeset, UTF-8 is an encoding,"
NSQ_SOURCE_LINE 00001701 "and ISO-8859-1 (= latin 1) and ASCII are both codesets I<and> encodings at"
NSQ_SOURCE_LINE 00001702 "the same time, which can be confusing."
NSQ_SOURCE_LINE 00001703 ""
NSQ_SOURCE_LINE 00001704 "=over 4"
NSQ_SOURCE_LINE 00001705 ""
NSQ_SOURCE_LINE 00001706 "=item C<utf8> flag disabled"
NSQ_SOURCE_LINE 00001707 ""
NSQ_SOURCE_LINE 00001708 "When C<utf8> is disabled (the default), then C<encode>/C<decode> generate"
NSQ_SOURCE_LINE 00001709 "and expect Unicode strings, that is, characters with high ordinal Unicode"
NSQ_SOURCE_LINE 00001710 "values (> 255) will be encoded as such characters, and likewise such"
NSQ_SOURCE_LINE 00001711 "characters are decoded as-is, no changes to them will be done, except"
NSQ_SOURCE_LINE 00001712 "\"(re-)interpreting\" them as Unicode codepoints or Unicode characters,"
NSQ_SOURCE_LINE 00001713 "respectively (to Perl, these are the same thing in strings unless you do"
NSQ_SOURCE_LINE 00001714 "funny/weird/dumb stuff)."
NSQ_SOURCE_LINE 00001715 ""
NSQ_SOURCE_LINE 00001716 "This is useful when you want to do the encoding yourself (e.g. when you"
NSQ_SOURCE_LINE 00001717 "want to have UTF-16 encoded JSON texts) or when some other layer does"
NSQ_SOURCE_LINE 00001718 "the encoding for you (for example, when printing to a terminal using a"
NSQ_SOURCE_LINE 00001719 "filehandle that transparently encodes to UTF-8 you certainly do NOT want"
NSQ_SOURCE_LINE 00001720 "to UTF-8 encode your data first and have Perl encode it another time)."
NSQ_SOURCE_LINE 00001721 ""
NSQ_SOURCE_LINE 00001722 "=item C<utf8> flag enabled"
NSQ_SOURCE_LINE 00001723 ""
NSQ_SOURCE_LINE 00001724 "If the C<utf8>-flag is enabled, C<encode>/C<decode> will encode all"
NSQ_SOURCE_LINE 00001725 "characters using the corresponding UTF-8 multi-byte sequence, and will"
NSQ_SOURCE_LINE 00001726 "expect your input strings to be encoded as UTF-8, that is, no \"character\""
NSQ_SOURCE_LINE 00001727 "of the input string must have any value > 255, as UTF-8 does not allow"
NSQ_SOURCE_LINE 00001728 "that."
NSQ_SOURCE_LINE 00001729 ""
NSQ_SOURCE_LINE 00001730 "The C<utf8> flag therefore switches between two modes: disabled means you"
NSQ_SOURCE_LINE 00001731 "will get a Unicode string in Perl, enabled means you get an UTF-8 encoded"
NSQ_SOURCE_LINE 00001732 "octet/binary string in Perl."
NSQ_SOURCE_LINE 00001733 ""
NSQ_SOURCE_LINE 00001734 "=item C<latin1> or C<ascii> flags enabled"
NSQ_SOURCE_LINE 00001735 ""
NSQ_SOURCE_LINE 00001736 "With C<latin1> (or C<ascii>) enabled, C<encode> will escape characters"
NSQ_SOURCE_LINE 00001737 "with ordinal values > 255 (> 127 with C<ascii>) and encode the remaining"
NSQ_SOURCE_LINE 00001738 "characters as specified by the C<utf8> flag."
NSQ_SOURCE_LINE 00001739 ""
NSQ_SOURCE_LINE 00001740 "If C<utf8> is disabled, then the result is also correctly encoded in those"
NSQ_SOURCE_LINE 00001741 "character sets (as both are proper subsets of Unicode, meaning that a"
NSQ_SOURCE_LINE 00001742 "Unicode string with all character values < 256 is the same thing as a"
NSQ_SOURCE_LINE 00001743 "ISO-8859-1 string, and a Unicode string with all character values < 128 is"
NSQ_SOURCE_LINE 00001744 "the same thing as an ASCII string in Perl)."
NSQ_SOURCE_LINE 00001745 ""
NSQ_SOURCE_LINE 00001746 "If C<utf8> is enabled, you still get a correct UTF-8-encoded string,"
NSQ_SOURCE_LINE 00001747 "regardless of these flags, just some more characters will be escaped using"
NSQ_SOURCE_LINE 00001748 "C<\\uXXXX> then before."
NSQ_SOURCE_LINE 00001749 ""
NSQ_SOURCE_LINE 00001750 "Note that ISO-8859-1-I<encoded> strings are not compatible with UTF-8"
NSQ_SOURCE_LINE 00001751 "encoding, while ASCII-encoded strings are. That is because the ISO-8859-1"
NSQ_SOURCE_LINE 00001752 "encoding is NOT a subset of UTF-8 (despite the ISO-8859-1 I<codeset> being"
NSQ_SOURCE_LINE 00001753 "a subset of Unicode), while ASCII is."
NSQ_SOURCE_LINE 00001754 ""
NSQ_SOURCE_LINE 00001755 "Surprisingly, C<decode> will ignore these flags and so treat all input"
NSQ_SOURCE_LINE 00001756 "values as governed by the C<utf8> flag. If it is disabled, this allows you"
NSQ_SOURCE_LINE 00001757 "to decode ISO-8859-1- and ASCII-encoded strings, as both strict subsets of"
NSQ_SOURCE_LINE 00001758 "Unicode. If it is enabled, you can correctly decode UTF-8 encoded strings."
NSQ_SOURCE_LINE 00001759 ""
NSQ_SOURCE_LINE 00001760 "So neither C<latin1> nor C<ascii> are incompatible with the C<utf8> flag -"
NSQ_SOURCE_LINE 00001761 "they only govern when the JSON output engine escapes a character or not."
NSQ_SOURCE_LINE 00001762 ""
NSQ_SOURCE_LINE 00001763 "The main use for C<latin1> is to relatively efficiently store binary data"
NSQ_SOURCE_LINE 00001764 "as JSON, at the expense of breaking compatibility with most JSON decoders."
NSQ_SOURCE_LINE 00001765 ""
NSQ_SOURCE_LINE 00001766 "The main use for C<ascii> is to force the output to not contain characters"
NSQ_SOURCE_LINE 00001767 "with values > 127, which means you can interpret the resulting string"
NSQ_SOURCE_LINE 00001768 "as UTF-8, ISO-8859-1, ASCII, KOI8-R or most about any character set and"
NSQ_SOURCE_LINE 00001769 "8-bit-encoding, and still get the same data structure back. This is useful"
NSQ_SOURCE_LINE 00001770 "when your channel for JSON transfer is not 8-bit clean or the encoding"
NSQ_SOURCE_LINE 00001771 "might be mangled in between (e.g. in mail), and works because ASCII is a"
NSQ_SOURCE_LINE 00001772 "proper subset of most 8-bit and multibyte encodings in use in the world."
NSQ_SOURCE_LINE 00001773 ""
NSQ_SOURCE_LINE 00001774 "=back"
NSQ_SOURCE_LINE 00001775 ""
NSQ_SOURCE_LINE 00001776 "=head1 BACKWARD INCOMPATIBILITY"
NSQ_SOURCE_LINE 00001777 ""
NSQ_SOURCE_LINE 00001778 "Since version 2.90, stringification (and string comparison) for"
NSQ_SOURCE_LINE 00001779 "C<JSON::true> and C<JSON::false> has not been overloaded. It shouldn't"
NSQ_SOURCE_LINE 00001780 "matter as long as you treat them as boolean values, but a code that"
NSQ_SOURCE_LINE 00001781 "expects they are stringified as \"true\" or \"false\" doesn't work as"
NSQ_SOURCE_LINE 00001782 "you have expected any more."
NSQ_SOURCE_LINE 00001783 ""
NSQ_SOURCE_LINE 00001784 "    if (JSON::true eq 'true') {  # now fails"
NSQ_SOURCE_LINE 00001785 ""
NSQ_SOURCE_LINE 00001786 "    print \"The result is $JSON::true now.\"; # => The result is 1 now."
NSQ_SOURCE_LINE 00001787 ""
NSQ_SOURCE_LINE 00001788 "And now these boolean values don't inherit JSON::Boolean, either."
NSQ_SOURCE_LINE 00001789 "When you need to test a value is a JSON boolean value or not, use"
NSQ_SOURCE_LINE 00001790 "C<JSON::is_bool> function, instead of testing the value inherits"
NSQ_SOURCE_LINE 00001791 "a particular boolean class or not."
NSQ_SOURCE_LINE 00001792 ""
NSQ_SOURCE_LINE 00001793 "=head1 BUGS"
NSQ_SOURCE_LINE 00001794 ""
NSQ_SOURCE_LINE 00001795 "Please report bugs on backend selection and additional features"
NSQ_SOURCE_LINE 00001796 "this module provides to RT or GitHub issues for this module:"
NSQ_SOURCE_LINE 00001797 ""
NSQ_SOURCE_LINE 00001798 "L<https://rt.cpan.org/Public/Dist/Display.html?Queue=JSON>"
NSQ_SOURCE_LINE 00001799 ""
NSQ_SOURCE_LINE 00001800 "L<https://github.com/makamaka/JSON/issues>"
NSQ_SOURCE_LINE 00001801 ""
NSQ_SOURCE_LINE 00001802 "As for bugs on a specific behavior, please report to the author"
NSQ_SOURCE_LINE 00001803 "of the backend module you are using."
NSQ_SOURCE_LINE 00001804 ""
NSQ_SOURCE_LINE 00001805 "As for new features and requests to change common behaviors, please"
NSQ_SOURCE_LINE 00001806 "ask the author of JSON::XS (Marc Lehmann, E<lt>schmorp[at]schmorp.deE<gt>)"
NSQ_SOURCE_LINE 00001807 "first, by email (important!), to keep compatibility among JSON.pm"
NSQ_SOURCE_LINE 00001808 "backends."
NSQ_SOURCE_LINE 00001809 ""
