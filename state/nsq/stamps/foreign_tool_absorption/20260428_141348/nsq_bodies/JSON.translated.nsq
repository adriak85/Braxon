NSQ_SOURCE_LINE 00000157 "sub to_json ($@) {"
NSQ_SOURCE_LINE 00000158 "    if ("
NSQ_SOURCE_LINE 00000159 "        ref($_[0]) eq 'JSON'"
NSQ_SOURCE_LINE 00000160 "        or (@_ > 2 and $_[0] eq 'JSON')"
NSQ_SOURCE_LINE 00000161 "    ) {"
NSQ_SOURCE_LINE 00000162 "        Carp::croak \"to_json should not be called as a method.\";"
NSQ_SOURCE_LINE 00000163 "    }"
NSQ_SOURCE_LINE 00000164 "    my $json = JSON->new;"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "    if (@_ == 2 and ref $_[1] eq 'HASH') {"
NSQ_SOURCE_LINE 00000167 "        my $opt  = $_[1];"
NSQ_SOURCE_LINE 00000168 "        for my $method (keys %$opt) {"
NSQ_SOURCE_LINE 00000169 "            $json->$method( $opt->{$method} );"
NSQ_SOURCE_LINE 00000170 "        }"
NSQ_SOURCE_LINE 00000171 "    }"
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "    $json->encode($_[0]);"
NSQ_SOURCE_LINE 00000174 "}"
