NSQ_SOURCE_LINE 00000136 "sub jsonToObj {"
NSQ_SOURCE_LINE 00000137 "    my $alternative = 'from_json';"
NSQ_SOURCE_LINE 00000138 "    if (defined $_[0] and UNIVERSAL::isa($_[0], 'JSON')) {"
