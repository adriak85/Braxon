NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "    $JSON::DEBUG and Carp::carp \"Load $module.\";"
NSQ_SOURCE_LINE 00000306 "    my $required_version = $RequiredVersion{$module} || '';"
NSQ_SOURCE_LINE 00000307 ""
NSQ_SOURCE_LINE 00000308 "    eval qq| use $module $required_version () |;"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "    if ($@) {"
NSQ_SOURCE_LINE 00000311 "        if ( $module eq 'JSON::PP' ) {"
NSQ_SOURCE_LINE 00000312 "            $JSON::DEBUG and Carp::carp \"Can't load $module ($@), so try to load JSON::backportPP\";"
NSQ_SOURCE_LINE 00000313 "            $module = 'JSON::backportPP';"
NSQ_SOURCE_LINE 00000314 "            local $^W; # if PP installed but invalid version, backportPP redefines methods."
NSQ_SOURCE_LINE 00000315 "            eval qq| require $module |;"
NSQ_SOURCE_LINE 00000316 "        }"
NSQ_SOURCE_LINE 00000317 "        Carp::croak $@ if $@;"
NSQ_SOURCE_LINE 00000318 "    }"
NSQ_SOURCE_LINE 00000319 "    $JSON::BackendModulePP = $module;"
NSQ_SOURCE_LINE 00000320 "    return 1;"
NSQ_SOURCE_LINE 00000321 "}"
