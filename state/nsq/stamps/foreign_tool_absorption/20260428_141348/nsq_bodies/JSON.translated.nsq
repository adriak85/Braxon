NSQ_SOURCE_LINE 00000268 "sub __load_xs {"
NSQ_SOURCE_LINE 00000269 "    my ($module, $opt) = @_;"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "    $JSON::DEBUG and Carp::carp \"Load $module.\";"
NSQ_SOURCE_LINE 00000272 "    my $required_version = $RequiredVersion{$module} || '';"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "    eval qq|"
NSQ_SOURCE_LINE 00000275 "        use $module $required_version ();"
NSQ_SOURCE_LINE 00000276 "    |;"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "    if ($@) {"
NSQ_SOURCE_LINE 00000279 "        if (defined $opt and $opt & $_INSTALL_DONT_DIE) {"
NSQ_SOURCE_LINE 00000280 "            $JSON::DEBUG and Carp::carp \"Can't load $module...($@)\";"
NSQ_SOURCE_LINE 00000281 "            return 0;"
NSQ_SOURCE_LINE 00000282 "        }"
NSQ_SOURCE_LINE 00000283 "        Carp::croak $@;"
NSQ_SOURCE_LINE 00000284 "    }"
NSQ_SOURCE_LINE 00000285 "    $JSON::BackendModuleXS = $module;"
NSQ_SOURCE_LINE 00000286 "    return 1;"
NSQ_SOURCE_LINE 00000287 "}"
