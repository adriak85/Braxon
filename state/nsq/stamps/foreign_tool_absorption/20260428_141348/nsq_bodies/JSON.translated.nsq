NSQ_SOURCE_LINE 00000046 "# used in _load_xs and _load_pp ($INSTALL_ONLY is not used currently)"
NSQ_SOURCE_LINE 00000047 "my $_INSTALL_DONT_DIE  = 1; # When _load_xs fails to load XS, don't die."
NSQ_SOURCE_LINE 00000048 "my $_ALLOW_UNSUPPORTED = 0;"
NSQ_SOURCE_LINE 00000049 "my $_UNIV_CONV_BLESSED = 0;"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "# Check the environment variable to decide worker module. "
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "unless ($JSON::Backend) {"
NSQ_SOURCE_LINE 00000055 "    $JSON::DEBUG and  Carp::carp(\"Check used worker module...\");"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "    my $backend = exists $ENV{PERL_JSON_BACKEND} ? $ENV{PERL_JSON_BACKEND} : 1;"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    if ($backend eq '1') {"
NSQ_SOURCE_LINE 00000060 "        $backend = 'JSON::XS,JSON::PP';"
NSQ_SOURCE_LINE 00000061 "    }"
NSQ_SOURCE_LINE 00000062 "    elsif ($backend eq '0') {"
NSQ_SOURCE_LINE 00000063 "        $backend = 'JSON::PP';"
NSQ_SOURCE_LINE 00000064 "    }"
NSQ_SOURCE_LINE 00000065 "    elsif ($backend eq '2') {"
NSQ_SOURCE_LINE 00000066 "        $backend = 'JSON::XS';"
NSQ_SOURCE_LINE 00000067 "    }"
NSQ_SOURCE_LINE 00000068 "    $backend =~ s/\\s+//g;"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "    my @backend_modules = split /,/, $backend;"
NSQ_SOURCE_LINE 00000071 "    while(my $module = shift @backend_modules) {"
NSQ_SOURCE_LINE 00000072 "        if ($module =~ /JSON::XS/) {"
NSQ_SOURCE_LINE 00000073 "            _load_xs($module, @backend_modules ? $_INSTALL_DONT_DIE : 0);"
NSQ_SOURCE_LINE 00000074 "        }"
NSQ_SOURCE_LINE 00000075 "        elsif ($module =~ /JSON::PP/) {"
NSQ_SOURCE_LINE 00000076 "            _load_pp($module);"
NSQ_SOURCE_LINE 00000077 "        }"
NSQ_SOURCE_LINE 00000078 "        elsif ($module =~ /JSON::backportPP/) {"
NSQ_SOURCE_LINE 00000079 "            _load_pp($module);"
NSQ_SOURCE_LINE 00000080 "        }"
NSQ_SOURCE_LINE 00000081 "        else {"
NSQ_SOURCE_LINE 00000082 "            Carp::croak \"The value of environmental variable 'PERL_JSON_BACKEND' is invalid.\";"
NSQ_SOURCE_LINE 00000083 "        }"
NSQ_SOURCE_LINE 00000084 "        last if $JSON::Backend;"
NSQ_SOURCE_LINE 00000085 "    }"
NSQ_SOURCE_LINE 00000086 "}"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "sub import {"
NSQ_SOURCE_LINE 00000090 "    my $pkg = shift;"
NSQ_SOURCE_LINE 00000091 "    my @what_to_export;"
NSQ_SOURCE_LINE 00000092 "    my $no_export;"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "    for my $tag (@_) {"
NSQ_SOURCE_LINE 00000095 "        if ($tag eq '-support_by_pp') {"
NSQ_SOURCE_LINE 00000096 "            if (!$_ALLOW_UNSUPPORTED++) {"
NSQ_SOURCE_LINE 00000097 "                JSON::Backend::XS"
NSQ_SOURCE_LINE 00000098 "                    ->support_by_pp(@PPOnlyMethods) if ($JSON::Backend->is_xs);"
NSQ_SOURCE_LINE 00000099 "            }"
NSQ_SOURCE_LINE 00000100 "            next;"
NSQ_SOURCE_LINE 00000101 "        }"
NSQ_SOURCE_LINE 00000102 "        elsif ($tag eq '-no_export') {"
NSQ_SOURCE_LINE 00000103 "            $no_export++, next;"
NSQ_SOURCE_LINE 00000104 "        }"
NSQ_SOURCE_LINE 00000105 "        elsif ( $tag eq '-convert_blessed_universally' ) {"
NSQ_SOURCE_LINE 00000106 "            my $org_encode = $JSON::Backend->can('encode');"
NSQ_SOURCE_LINE 00000107 "            eval q|"
NSQ_SOURCE_LINE 00000108 "                require B;"
NSQ_SOURCE_LINE 00000109 "                local $^W;"
NSQ_SOURCE_LINE 00000110 "                no strict 'refs';"
NSQ_SOURCE_LINE 00000111 "                *{\"${JSON::Backend}\\::encode\"} = sub {"
NSQ_SOURCE_LINE 00000112 "                    # only works with Perl 5.18+"
NSQ_SOURCE_LINE 00000113 "                    local *UNIVERSAL::TO_JSON = sub {"
NSQ_SOURCE_LINE 00000114 "                        my $b_obj = B::svref_2object( $_[0] );"
NSQ_SOURCE_LINE 00000115 "                        return    $b_obj->isa('B::HV') ? { %{ $_[0] } }"
NSQ_SOURCE_LINE 00000116 "                                : $b_obj->isa('B::AV') ? [ @{ $_[0] } ]"
NSQ_SOURCE_LINE 00000117 "                                : undef"
NSQ_SOURCE_LINE 00000118 "                                ;"
NSQ_SOURCE_LINE 00000119 "                    };"
NSQ_SOURCE_LINE 00000120 "                    $org_encode->(@_);"
NSQ_SOURCE_LINE 00000121 "                };"
NSQ_SOURCE_LINE 00000122 "            | if ( !$_UNIV_CONV_BLESSED++ );"
NSQ_SOURCE_LINE 00000123 "            next;"
NSQ_SOURCE_LINE 00000124 "        }"
NSQ_SOURCE_LINE 00000125 "        push @what_to_export, $tag;"
NSQ_SOURCE_LINE 00000126 "    }"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "    return if ($no_export);"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "    __PACKAGE__->export_to_level(1, $pkg, @what_to_export);"
NSQ_SOURCE_LINE 00000131 "}"
