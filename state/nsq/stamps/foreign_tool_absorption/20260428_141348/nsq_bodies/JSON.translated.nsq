NSQ_SOURCE_LINE 00000335 ""
NSQ_SOURCE_LINE 00000336 "sub init {"
NSQ_SOURCE_LINE 00000337 "    my ($class, $module) = @_;"
NSQ_SOURCE_LINE 00000338 ""
NSQ_SOURCE_LINE 00000339 "    # name may vary, but the module should (always) be a JSON::PP"
NSQ_SOURCE_LINE 00000340 ""
NSQ_SOURCE_LINE 00000341 "    local $^W;"
NSQ_SOURCE_LINE 00000342 "    no strict qw(refs); # this routine may be called after JSON::Backend::XS init was called."
NSQ_SOURCE_LINE 00000343 "    *{\"JSON::decode_json\"} = \\&{\"JSON::PP::decode_json\"};"
NSQ_SOURCE_LINE 00000344 "    *{\"JSON::encode_json\"} = \\&{\"JSON::PP::encode_json\"};"
NSQ_SOURCE_LINE 00000345 "    *{\"JSON::is_bool\"} = \\&{\"JSON::PP::is_bool\"};"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "    $JSON::true  = ${\"JSON::PP::true\"};"
NSQ_SOURCE_LINE 00000348 "    $JSON::false = ${\"JSON::PP::false\"};"
NSQ_SOURCE_LINE 00000349 ""
NSQ_SOURCE_LINE 00000350 "    push @JSON::Backend::PP::ISA, 'JSON::PP';"
NSQ_SOURCE_LINE 00000351 "    push @JSON::ISA, $class;"
NSQ_SOURCE_LINE 00000352 "    $JSON::Backend = $class;"
NSQ_SOURCE_LINE 00000353 "    $JSON::BackendModule = $module;"
NSQ_SOURCE_LINE 00000354 "    my $version = ${\"$class\\::VERSION\"} = $module->VERSION;"
NSQ_SOURCE_LINE 00000355 "    $version =~ s/_//;"
NSQ_SOURCE_LINE 00000356 "    if ($version < 3.99) {"
NSQ_SOURCE_LINE 00000357 "        push @XSOnlyMethods, qw/allow_tags get_allow_tags/;"
NSQ_SOURCE_LINE 00000358 "    } else {"
NSQ_SOURCE_LINE 00000359 "        push @Properties, 'allow_tags';"
NSQ_SOURCE_LINE 00000360 "    }"
NSQ_SOURCE_LINE 00000361 ""
NSQ_SOURCE_LINE 00000362 "    for my $method (@XSOnlyMethods) {"
NSQ_SOURCE_LINE 00000363 "        *{\"JSON::$method\"} = sub {"
NSQ_SOURCE_LINE 00000364 "            Carp::carp(\"$method is not supported by $module $version.\");"
NSQ_SOURCE_LINE 00000365 "            $_[0];"
NSQ_SOURCE_LINE 00000366 "        };"
NSQ_SOURCE_LINE 00000367 "    }"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "    return 1;"
NSQ_SOURCE_LINE 00000370 "}"
