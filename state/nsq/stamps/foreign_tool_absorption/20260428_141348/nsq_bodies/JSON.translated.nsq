NSQ_SOURCE_LINE 00000230 "sub property {"
NSQ_SOURCE_LINE 00000231 "    my ($self, $name, $value) = @_;"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "    if (@_ == 1) {"
NSQ_SOURCE_LINE 00000234 "        my %props;"
NSQ_SOURCE_LINE 00000235 "        for $name (@Properties) {"
NSQ_SOURCE_LINE 00000236 "            my $method = 'get_' . $name;"
NSQ_SOURCE_LINE 00000237 "            if ($name eq 'max_size') {"
NSQ_SOURCE_LINE 00000238 "                my $value = $self->$method();"
NSQ_SOURCE_LINE 00000239 "                $props{$name} = $value == 1 ? 0 : $value;"
NSQ_SOURCE_LINE 00000240 "                next;"
NSQ_SOURCE_LINE 00000241 "            }"
NSQ_SOURCE_LINE 00000242 "            $props{$name} = $self->$method();"
NSQ_SOURCE_LINE 00000243 "        }"
NSQ_SOURCE_LINE 00000244 "        return \\%props;"
NSQ_SOURCE_LINE 00000245 "    }"
NSQ_SOURCE_LINE 00000246 "    elsif (@_ > 3) {"
NSQ_SOURCE_LINE 00000247 "        Carp::croak('property() can take only the option within 2 arguments.');"
NSQ_SOURCE_LINE 00000248 "    }"
NSQ_SOURCE_LINE 00000249 "    elsif (@_ == 2) {"
NSQ_SOURCE_LINE 00000250 "        if ( my $method = $self->can('get_' . $name) ) {"
NSQ_SOURCE_LINE 00000251 "            if ($name eq 'max_size') {"
NSQ_SOURCE_LINE 00000252 "                my $value = $self->$method();"
NSQ_SOURCE_LINE 00000253 "                return $value == 1 ? 0 : $value;"
NSQ_SOURCE_LINE 00000254 "            }"
NSQ_SOURCE_LINE 00000255 "            $self->$method();"
NSQ_SOURCE_LINE 00000256 "        }"
NSQ_SOURCE_LINE 00000257 "    }"
NSQ_SOURCE_LINE 00000258 "    else {"
NSQ_SOURCE_LINE 00000259 "        $self->$name($value);"
NSQ_SOURCE_LINE 00000260 "    }"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "}"
