NSQ_SOURCE_LINE 00000289 "sub _load_xs {"
NSQ_SOURCE_LINE 00000290 "    my ($module, $opt) = @_;"
NSQ_SOURCE_LINE 00000291 "    __load_xs($module, $opt) or return;"
NSQ_SOURCE_LINE 00000292 ""
