NSQ_SOURCE_LINE 00000768 "=head1 SUPPORT"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "=head2 Perldoc"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "You can find documentation for this module with the perldoc command."
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "  perldoc HTML::Scrubber"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "=head2 Websites"
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "The following websites have more information about this module, and may be of help to you. As always,"
NSQ_SOURCE_LINE 00000779 "in addition to those websites please use your favorite search engine to discover more resources."
NSQ_SOURCE_LINE 00000780 ""
NSQ_SOURCE_LINE 00000781 "=over 4"
NSQ_SOURCE_LINE 00000782 ""
NSQ_SOURCE_LINE 00000783 "=item *"
NSQ_SOURCE_LINE 00000784 ""
NSQ_SOURCE_LINE 00000785 "MetaCPAN"
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "A modern, open-source CPAN search engine, useful to view POD in HTML format."
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "L<https://metacpan.org/release/HTML-Scrubber>"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 "=item *"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "Search CPAN"
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "The default CPAN search engine, useful to view POD in HTML format."
NSQ_SOURCE_LINE 00000796 ""
NSQ_SOURCE_LINE 00000797 "L<http://search.cpan.org/dist/HTML-Scrubber>"
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "=item *"
NSQ_SOURCE_LINE 00000800 ""
NSQ_SOURCE_LINE 00000801 "RT: CPAN's Bug Tracker"
NSQ_SOURCE_LINE 00000802 ""
NSQ_SOURCE_LINE 00000803 "The RT ( Request Tracker ) website is the default bug/issue tracking system for CPAN."
NSQ_SOURCE_LINE 00000804 ""
NSQ_SOURCE_LINE 00000805 "L<https://rt.cpan.org/Public/Dist/Display.html?Name=HTML-Scrubber>"
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "=item *"
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "AnnoCPAN"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "The AnnoCPAN is a website that allows community annotations of Perl module documentation."
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "L<http://annocpan.org/dist/HTML-Scrubber>"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "=item *"
NSQ_SOURCE_LINE 00000816 ""
NSQ_SOURCE_LINE 00000817 "CPAN Ratings"
NSQ_SOURCE_LINE 00000818 ""
NSQ_SOURCE_LINE 00000819 "The CPAN Ratings is a website that allows community ratings and reviews of Perl modules."
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "L<http://cpanratings.perl.org/d/HTML-Scrubber>"
NSQ_SOURCE_LINE 00000822 ""
NSQ_SOURCE_LINE 00000823 "=item *"
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "CPANTS"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "The CPANTS is a website that analyzes the Kwalitee ( code metrics ) of a distribution."
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "L<http://cpants.cpanauthors.org/dist/HTML-Scrubber>"
NSQ_SOURCE_LINE 00000830 ""
NSQ_SOURCE_LINE 00000831 "=item *"
NSQ_SOURCE_LINE 00000832 ""
NSQ_SOURCE_LINE 00000833 "CPAN Testers"
NSQ_SOURCE_LINE 00000834 ""
NSQ_SOURCE_LINE 00000835 "The CPAN Testers is a network of smoke testers who run automated tests on uploaded CPAN distributions."
NSQ_SOURCE_LINE 00000836 ""
NSQ_SOURCE_LINE 00000837 "L<http://www.cpantesters.org/distro/H/HTML-Scrubber>"
NSQ_SOURCE_LINE 00000838 ""
NSQ_SOURCE_LINE 00000839 "=item *"
NSQ_SOURCE_LINE 00000840 ""
NSQ_SOURCE_LINE 00000841 "CPAN Testers Matrix"
NSQ_SOURCE_LINE 00000842 ""
NSQ_SOURCE_LINE 00000843 "The CPAN Testers Matrix is a website that provides a visual overview of the test results for a distribution on various Perls/platforms."
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "L<http://matrix.cpantesters.org/?dist=HTML-Scrubber>"
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "=item *"
NSQ_SOURCE_LINE 00000848 ""
NSQ_SOURCE_LINE 00000849 "CPAN Testers Dependencies"
NSQ_SOURCE_LINE 00000850 ""
NSQ_SOURCE_LINE 00000851 "The CPAN Testers Dependencies is a website that shows a chart of the test results of all dependencies for a distribution."
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "L<http://deps.cpantesters.org/?module=HTML::Scrubber>"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "=back"
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "=head2 Bugs / Feature Requests"
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "Please report any bugs or feature requests by email to C<bug-html-scrubber at rt.cpan.org>, or through"
NSQ_SOURCE_LINE 00000860 "the web interface at L<https://rt.cpan.org/Public/Bug/Report.html?Queue=HTML-Scrubber>. You will be automatically notified of any"
NSQ_SOURCE_LINE 00000861 "progress on the request by the system."
NSQ_SOURCE_LINE 00000862 ""
NSQ_SOURCE_LINE 00000863 "=head2 Source Code"
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "The code is open to the world, and available for you to hack on. Please feel free to browse it and play"
NSQ_SOURCE_LINE 00000866 "with it, or whatever. If you want to contribute patches, please send me a diff or prod me to pull"
NSQ_SOURCE_LINE 00000867 "from your repository :)"
NSQ_SOURCE_LINE 00000868 ""
NSQ_SOURCE_LINE 00000869 "L<https://github.com/nigelm/html-scrubber>"
NSQ_SOURCE_LINE 00000870 ""
NSQ_SOURCE_LINE 00000871 "  git clone https://github.com/nigelm/html-scrubber.git"
