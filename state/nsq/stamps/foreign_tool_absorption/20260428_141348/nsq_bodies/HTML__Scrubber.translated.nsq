NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub new {"
NSQ_SOURCE_LINE 00000026 "    my $package = shift;"
NSQ_SOURCE_LINE 00000027 "    my $p       = HTML::Parser->new("
NSQ_SOURCE_LINE 00000028 "        api_version             => 3,"
NSQ_SOURCE_LINE 00000029 "        default_h               => \\@_scrub,"
NSQ_SOURCE_LINE 00000030 "        marked_sections         => 0,"
NSQ_SOURCE_LINE 00000031 "        strict_comment          => 0,"
NSQ_SOURCE_LINE 00000032 "        unbroken_text           => 1,"
NSQ_SOURCE_LINE 00000033 "        case_sensitive          => 0,"
NSQ_SOURCE_LINE 00000034 "        boolean_attribute_value => undef,"
NSQ_SOURCE_LINE 00000035 "        empty_element_tags      => 1,"
NSQ_SOURCE_LINE 00000036 "    );"
NSQ_SOURCE_LINE 00000037 ""
NSQ_SOURCE_LINE 00000038 "    my $self = {"
NSQ_SOURCE_LINE 00000039 "        _p        => $p,"
NSQ_SOURCE_LINE 00000040 "        _rules    => { '*' => 0, },"
NSQ_SOURCE_LINE 00000041 "        _comment  => 0,"
NSQ_SOURCE_LINE 00000042 "        _process  => 0,"
NSQ_SOURCE_LINE 00000043 "        _r        => \"\","
NSQ_SOURCE_LINE 00000044 "        _optimize => 1,"
NSQ_SOURCE_LINE 00000045 "        _script   => 0,"
NSQ_SOURCE_LINE 00000046 "        _style    => 0,"
NSQ_SOURCE_LINE 00000047 "    };"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    $p->{\"\\0_s\"} = bless $self, $package;"
NSQ_SOURCE_LINE 00000050 "    weaken( $p->{\"\\0_s\"} );"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    return $self unless @_;"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "    my (%args) = @_;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    for my $f (qw[ default allow deny rules process comment ]) {"
NSQ_SOURCE_LINE 00000057 "        next unless exists $args{$f};"
NSQ_SOURCE_LINE 00000058 "        if ( ref $args{$f} ) {"
NSQ_SOURCE_LINE 00000059 "            $self->$f( @{ $args{$f} } );"
NSQ_SOURCE_LINE 00000060 "        }"
NSQ_SOURCE_LINE 00000061 "        else {"
NSQ_SOURCE_LINE 00000062 "            $self->$f( $args{$f} );"
NSQ_SOURCE_LINE 00000063 "        }"
NSQ_SOURCE_LINE 00000064 "    }"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "    return $self;"
NSQ_SOURCE_LINE 00000067 "}"
NSQ_SOURCE_LINE 00000068 ""
