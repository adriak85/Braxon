NSQ_SOURCE_LINE 00000378 "=head1 NAME"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "HTML::Scrubber - Perl extension for scrubbing/sanitizing HTML"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 "=head1 VERSION"
NSQ_SOURCE_LINE 00000383 ""
NSQ_SOURCE_LINE 00000384 "version 0.19"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "=for stopwords html cpan callback homepage Perlbrew perltidy repository"
NSQ_SOURCE_LINE 00000387 ""
NSQ_SOURCE_LINE 00000388 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000389 ""
NSQ_SOURCE_LINE 00000390 "    use HTML::Scrubber;"
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "    my $scrubber = HTML::Scrubber->new( allow => [ qw[ p b i u hr br ] ] );"
NSQ_SOURCE_LINE 00000393 "    print $scrubber->scrub('<p><b>bold</b> <em>missing</em></p>');"
NSQ_SOURCE_LINE 00000394 "    # output is: <p><b>bold</b> </p>"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "    # more complex input"
NSQ_SOURCE_LINE 00000397 "    my $html = q["
NSQ_SOURCE_LINE 00000398 "    <style type=\"text/css\"> BAD { background: #666; color: #666;} </style>"
NSQ_SOURCE_LINE 00000399 "    <script language=\"javascript\"> alert(\"Hello, I am EVIL!\");    </script>"
NSQ_SOURCE_LINE 00000400 "    <HR>"
NSQ_SOURCE_LINE 00000401 "        a   => <a href=1>link </a>"
NSQ_SOURCE_LINE 00000402 "        br  => <br>"
NSQ_SOURCE_LINE 00000403 "        b   => <B> bold </B>"
NSQ_SOURCE_LINE 00000404 "        u   => <U> UNDERLINE </U>"
NSQ_SOURCE_LINE 00000405 "    ];"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "    print $scrubber->scrub($html);"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "    $scrubber->deny( qw[ p b i u hr br ] );"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "    print $scrubber->scrub($html);"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000414 ""
NSQ_SOURCE_LINE 00000415 "If you want to \"scrub\" or \"sanitize\" html input in a reliable and flexible"
NSQ_SOURCE_LINE 00000416 "fashion, then this module is for you."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "I wasn't satisfied with L<HTML::Sanitizer> because it is based on"
NSQ_SOURCE_LINE 00000419 "L<HTML::TreeBuilder>, so I thought I'd write something similar that works"
NSQ_SOURCE_LINE 00000420 "directly with L<HTML::Parser>."
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "=head1 METHODS"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "First a note on documentation: just study the L<EXAMPLE|\"EXAMPLE\"> below. It's"
NSQ_SOURCE_LINE 00000425 "all the documentation you could need."
NSQ_SOURCE_LINE 00000426 ""
NSQ_SOURCE_LINE 00000427 "Also, be sure to read all the comments as well as L<How does it work?|\"How does"
NSQ_SOURCE_LINE 00000428 "it work?\">."
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "If you're new to perl, good luck to you."
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "=head2 new"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "    my $scrubber = HTML::Scrubber->new( allow => [ qw[ p b i u hr br ] ] );"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "Build a new L<HTML::Scrubber>.  The arguments are the initial values for the"
NSQ_SOURCE_LINE 00000437 "following directives:-"
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "=over 4"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "=item * default"
NSQ_SOURCE_LINE 00000442 ""
NSQ_SOURCE_LINE 00000443 "=item * allow"
NSQ_SOURCE_LINE 00000444 ""
NSQ_SOURCE_LINE 00000445 "=item * deny"
NSQ_SOURCE_LINE 00000446 ""
NSQ_SOURCE_LINE 00000447 "=item * rules"
NSQ_SOURCE_LINE 00000448 ""
NSQ_SOURCE_LINE 00000449 "=item * process"
NSQ_SOURCE_LINE 00000450 ""
NSQ_SOURCE_LINE 00000451 "=item * comment"
NSQ_SOURCE_LINE 00000452 ""
NSQ_SOURCE_LINE 00000453 "=back"
NSQ_SOURCE_LINE 00000454 ""
NSQ_SOURCE_LINE 00000455 "=head2 comment"
NSQ_SOURCE_LINE 00000456 ""
NSQ_SOURCE_LINE 00000457 "    warn \"comments are  \", $p->comment ? 'allowed' : 'not allowed';"
NSQ_SOURCE_LINE 00000458 "    $p->comment(0);  # off by default"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "=head2 process"
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "    warn \"process instructions are  \", $p->process ? 'allowed' : 'not allowed';"
NSQ_SOURCE_LINE 00000463 "    $p->process(0);  # off by default"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=head2 script"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "    warn \"script tags (and everything in between) are supressed\""
NSQ_SOURCE_LINE 00000468 "        if $p->script;      # off by default"
NSQ_SOURCE_LINE 00000469 "    $p->script( 0 || 1 );"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "B<**> Please note that this is implemented using L<HTML::Parser>'s"
NSQ_SOURCE_LINE 00000472 "C<ignore_elements> function, so if C<script> is set to true, all script tags"
NSQ_SOURCE_LINE 00000473 "encountered will be validated like all other tags."
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "=head2 style"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "    warn \"style tags (and everything in between) are supressed\""
NSQ_SOURCE_LINE 00000478 "        if $p->style;       # off by default"
NSQ_SOURCE_LINE 00000479 "    $p->style( 0 || 1 );"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "B<**> Please note that this is implemented using L<HTML::Parser>'s"
NSQ_SOURCE_LINE 00000482 "C<ignore_elements> function, so if C<style> is set to true, all style tags"
NSQ_SOURCE_LINE 00000483 "encountered will be validated like all other tags."
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "=head2 allow"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "    $p->allow(qw[ t a g s ]);"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "=head2 deny"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "    $p->deny(qw[ t a g s ]);"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "=head2 rules"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "    $p->rules("
NSQ_SOURCE_LINE 00000496 "        img => {"
NSQ_SOURCE_LINE 00000497 "            src => qr{^(?!http://)}i, # only relative image links allowed"
NSQ_SOURCE_LINE 00000498 "            alt => 1,                 # alt attribute allowed"
NSQ_SOURCE_LINE 00000499 "            '*' => 0,                 # deny all other attributes"
NSQ_SOURCE_LINE 00000500 "        },"
NSQ_SOURCE_LINE 00000501 "        a => {"
NSQ_SOURCE_LINE 00000502 "            href => sub { ... },      # check or adjust with a callback"
NSQ_SOURCE_LINE 00000503 "        },"
NSQ_SOURCE_LINE 00000504 "        b => 1,"
NSQ_SOURCE_LINE 00000505 "        ..."
NSQ_SOURCE_LINE 00000506 "    );"
NSQ_SOURCE_LINE 00000507 ""
NSQ_SOURCE_LINE 00000508 "Updates a set of attribute rules. Each rule can be 1/0, a regular expression or"
NSQ_SOURCE_LINE 00000509 "a callback. Values longer than 1 char are treated as regexps. The callback is"
NSQ_SOURCE_LINE 00000510 "called with the following arguments: the current object, tag name, attribute"
NSQ_SOURCE_LINE 00000511 "name, and attribute value; the callback should return an empty list to drop the"
NSQ_SOURCE_LINE 00000512 "attribute, C<undef> to keep it without a value, or a new scalar value."
NSQ_SOURCE_LINE 00000513 ""
NSQ_SOURCE_LINE 00000514 "=head2 default"
NSQ_SOURCE_LINE 00000515 ""
NSQ_SOURCE_LINE 00000516 "    print \"default is \", $p->default();"
NSQ_SOURCE_LINE 00000517 "    $p->default(1);      # allow tags by default"
NSQ_SOURCE_LINE 00000518 "    $p->default("
NSQ_SOURCE_LINE 00000519 "        undef,           # don't change"
NSQ_SOURCE_LINE 00000520 "        {                # default attribute rules"
NSQ_SOURCE_LINE 00000521 "            '*' => 1,    # allow attributes by default"
NSQ_SOURCE_LINE 00000522 "        }"
NSQ_SOURCE_LINE 00000523 "    );"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "=head2 scrub_file"
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "    $html = $scrubber->scrub_file('foo.html');   ## returns giant string"
NSQ_SOURCE_LINE 00000528 "    die \"Eeek $!\" unless defined $html;  ## opening foo.html may have failed"
NSQ_SOURCE_LINE 00000529 "    $scrubber->scrub_file('foo.html', 'new.html') or die \"Eeek $!\";"
NSQ_SOURCE_LINE 00000530 "    $scrubber->scrub_file('foo.html', *STDOUT)"
NSQ_SOURCE_LINE 00000531 "        or die \"Eeek $!\""
NSQ_SOURCE_LINE 00000532 "            if fileno STDOUT;"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "=head2 scrub"
NSQ_SOURCE_LINE 00000535 ""
NSQ_SOURCE_LINE 00000536 "    print $scrubber->scrub($html);  ## returns giant string"
NSQ_SOURCE_LINE 00000537 "    $scrubber->scrub($html, 'new.html') or die \"Eeek $!\";"
NSQ_SOURCE_LINE 00000538 "    $scrubber->scrub($html', *STDOUT)"
NSQ_SOURCE_LINE 00000539 "        or die \"Eeek $!\""
NSQ_SOURCE_LINE 00000540 "            if fileno STDOUT;"
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "=for comment _out"
NSQ_SOURCE_LINE 00000543 "    $scrubber->_out(*STDOUT) if fileno STDOUT;"
NSQ_SOURCE_LINE 00000544 "    $scrubber->_out('foo.html') or die \"eeek $!\";"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "=for comment _validate"
NSQ_SOURCE_LINE 00000547 "Uses $self->{_rules} to do attribute validation."
NSQ_SOURCE_LINE 00000548 "Takes tag, rule('_' || $tag), attrref."
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "=for comment _scrub_str"
NSQ_SOURCE_LINE 00000551 ""
NSQ_SOURCE_LINE 00000552 "I<default> handler, used by both C<_scrub> and C<_scrub_fh>. Moved all the"
NSQ_SOURCE_LINE 00000553 "common code (basically all of it) into a single routine for ease of"
NSQ_SOURCE_LINE 00000554 "maintenance."
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "=for comment _scrub_fh"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "I<default> handler, does the scrubbing if we're scrubbing out to a file. Now"
NSQ_SOURCE_LINE 00000559 "calls C<_scrub_str> and pushes that out to a file."
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "=for comment _scrub"
NSQ_SOURCE_LINE 00000562 ""
NSQ_SOURCE_LINE 00000563 "I<default> handler, does the scrubbing if we're returning a giant string. Now"
NSQ_SOURCE_LINE 00000564 "calls C<_scrub_str> and appends that to the output string."
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "=head1 How does it work?"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "When a tag is encountered, L<HTML::Scrubber> allows/denies the tag using the"
NSQ_SOURCE_LINE 00000569 "explicit rule if one exists."
NSQ_SOURCE_LINE 00000570 ""
NSQ_SOURCE_LINE 00000571 "If no explicit rule exists, Scrubber applies the default rule."
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "If an explicit rule exists, but it's a simple rule(1), then the default"
NSQ_SOURCE_LINE 00000574 "attribute rule is applied."
NSQ_SOURCE_LINE 00000575 ""
NSQ_SOURCE_LINE 00000576 "=head2 EXAMPLE"
NSQ_SOURCE_LINE 00000577 ""
NSQ_SOURCE_LINE 00000578 "=for example begin"
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "    #!/usr/bin/perl -w"
NSQ_SOURCE_LINE 00000581 "    use HTML::Scrubber;"
NSQ_SOURCE_LINE 00000582 "    use strict;"
NSQ_SOURCE_LINE 00000583 ""
NSQ_SOURCE_LINE 00000584 "    my @allow = qw[ br hr b a ];"
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "    my @rules = ("
NSQ_SOURCE_LINE 00000587 "        script => 0,"
NSQ_SOURCE_LINE 00000588 "        img    => {"
NSQ_SOURCE_LINE 00000589 "            src => qr{^(?!http://)}i,    # only relative image links allowed"
NSQ_SOURCE_LINE 00000590 "            alt => 1,                    # alt attribute allowed"
NSQ_SOURCE_LINE 00000591 "            '*' => 0,                    # deny all other attributes"
NSQ_SOURCE_LINE 00000592 "        },"
NSQ_SOURCE_LINE 00000593 "    );"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "    my @default = ("
NSQ_SOURCE_LINE 00000596 "        0 =>                             # default rule, deny all tags"
NSQ_SOURCE_LINE 00000597 "            {"
NSQ_SOURCE_LINE 00000598 "            '*'    => 1,                             # default rule, allow all attributes"
NSQ_SOURCE_LINE 00000599 "            'href' => qr{^(?:http|https|ftp)://}i,"
NSQ_SOURCE_LINE 00000600 "            'src'  => qr{^(?:http|https|ftp)://}i,"
NSQ_SOURCE_LINE 00000601 ""
NSQ_SOURCE_LINE 00000602 "            #   If your perl doesn't have qr"
NSQ_SOURCE_LINE 00000603 "            #   just use a string with length greater than 1"
NSQ_SOURCE_LINE 00000604 "            'cite'        => '(?i-xsm:^(?:http|https|ftp):)',"
NSQ_SOURCE_LINE 00000605 "            'language'    => 0,"
NSQ_SOURCE_LINE 00000606 "            'name'        => 1,                                 # could be sneaky, but hey ;)"
NSQ_SOURCE_LINE 00000607 "            'onblur'      => 0,"
NSQ_SOURCE_LINE 00000608 "            'onchange'    => 0,"
NSQ_SOURCE_LINE 00000609 "            'onclick'     => 0,"
NSQ_SOURCE_LINE 00000610 "            'ondblclick'  => 0,"
NSQ_SOURCE_LINE 00000611 "            'onerror'     => 0,"
NSQ_SOURCE_LINE 00000612 "            'onfocus'     => 0,"
NSQ_SOURCE_LINE 00000613 "            'onkeydown'   => 0,"
NSQ_SOURCE_LINE 00000614 "            'onkeypress'  => 0,"
NSQ_SOURCE_LINE 00000615 "            'onkeyup'     => 0,"
NSQ_SOURCE_LINE 00000616 "            'onload'      => 0,"
NSQ_SOURCE_LINE 00000617 "            'onmousedown' => 0,"
NSQ_SOURCE_LINE 00000618 "            'onmousemove' => 0,"
NSQ_SOURCE_LINE 00000619 "            'onmouseout'  => 0,"
NSQ_SOURCE_LINE 00000620 "            'onmouseover' => 0,"
NSQ_SOURCE_LINE 00000621 "            'onmouseup'   => 0,"
NSQ_SOURCE_LINE 00000622 "            'onreset'     => 0,"
NSQ_SOURCE_LINE 00000623 "            'onselect'    => 0,"
NSQ_SOURCE_LINE 00000624 "            'onsubmit'    => 0,"
NSQ_SOURCE_LINE 00000625 "            'onunload'    => 0,"
NSQ_SOURCE_LINE 00000626 "            'src'         => 0,"
NSQ_SOURCE_LINE 00000627 "            'type'        => 0,"
NSQ_SOURCE_LINE 00000628 "            }"
NSQ_SOURCE_LINE 00000629 "    );"
NSQ_SOURCE_LINE 00000630 ""
NSQ_SOURCE_LINE 00000631 "    my $scrubber = HTML::Scrubber->new();"
NSQ_SOURCE_LINE 00000632 "    $scrubber->allow(@allow);"
NSQ_SOURCE_LINE 00000633 "    $scrubber->rules(@rules);    # key/value pairs"
NSQ_SOURCE_LINE 00000634 "    $scrubber->default(@default);"
NSQ_SOURCE_LINE 00000635 "    $scrubber->comment(1);       # 1 allow, 0 deny"
NSQ_SOURCE_LINE 00000636 ""
NSQ_SOURCE_LINE 00000637 "    ## preferred way to create the same object"
NSQ_SOURCE_LINE 00000638 "    $scrubber = HTML::Scrubber->new("
NSQ_SOURCE_LINE 00000639 "        allow   => \\@allow,"
NSQ_SOURCE_LINE 00000640 "        rules   => \\@rules,"
NSQ_SOURCE_LINE 00000641 "        default => \\@default,"
NSQ_SOURCE_LINE 00000642 "        comment => 1,"
NSQ_SOURCE_LINE 00000643 "        process => 0,"
NSQ_SOURCE_LINE 00000644 "    );"
NSQ_SOURCE_LINE 00000645 ""
NSQ_SOURCE_LINE 00000646 "    require Data::Dumper, die Data::Dumper::Dumper($scrubber) if @ARGV;"
NSQ_SOURCE_LINE 00000647 ""
NSQ_SOURCE_LINE 00000648 "    my $it = q["
NSQ_SOURCE_LINE 00000649 "        <?php   echo(\" EVIL EVIL EVIL \"); ?>    <!-- asdf -->"
NSQ_SOURCE_LINE 00000650 "        <hr>"
NSQ_SOURCE_LINE 00000651 "        <I FAKE=\"attribute\" > IN ITALICS WITH FAKE=\"attribute\" </I><br>"
NSQ_SOURCE_LINE 00000652 "        <B> IN BOLD </B><br>"
NSQ_SOURCE_LINE 00000653 "        <A NAME=\"evil\">"
NSQ_SOURCE_LINE 00000654 "            <A HREF=\"javascript:alert('die die die');\">HREF=JAVA &lt;!&gt;</A>"
NSQ_SOURCE_LINE 00000655 "            <br>"
NSQ_SOURCE_LINE 00000656 "            <A HREF=\"image/bigone.jpg\" ONMOUSEOVER=\"alert('die die die');\">"
NSQ_SOURCE_LINE 00000657 "                <IMG SRC=\"image/smallone.jpg\" ALT=\"ONMOUSEOVER JAVASCRIPT\">"
NSQ_SOURCE_LINE 00000658 "            </A>"
NSQ_SOURCE_LINE 00000659 "        </A> <br>"
NSQ_SOURCE_LINE 00000660 "    ];"
NSQ_SOURCE_LINE 00000661 ""
NSQ_SOURCE_LINE 00000662 "    print \"#original text\", $/, $it, $/;"
NSQ_SOURCE_LINE 00000663 "    print"
NSQ_SOURCE_LINE 00000664 "        \"#scrubbed text (default \", $scrubber->default(),    # no arguments returns the current value"
NSQ_SOURCE_LINE 00000665 "        \" comment \", $scrubber->comment(), \" process \", $scrubber->process(), \" )\", $/, $scrubber->scrub($it), $/;"
NSQ_SOURCE_LINE 00000666 ""
NSQ_SOURCE_LINE 00000667 "    $scrubber->default(1);                                   # allow all tags by default"
NSQ_SOURCE_LINE 00000668 "    $scrubber->comment(0);                                   # deny comments"
NSQ_SOURCE_LINE 00000669 ""
NSQ_SOURCE_LINE 00000670 "    print"
NSQ_SOURCE_LINE 00000671 "        \"#scrubbed text (default \","
NSQ_SOURCE_LINE 00000672 "        $scrubber->default(),"
NSQ_SOURCE_LINE 00000673 "        \" comment \","
NSQ_SOURCE_LINE 00000674 "        $scrubber->comment(),"
NSQ_SOURCE_LINE 00000675 "        \" process \","
NSQ_SOURCE_LINE 00000676 "        $scrubber->process(),"
NSQ_SOURCE_LINE 00000677 "        \" )\", $/,"
NSQ_SOURCE_LINE 00000678 "        $scrubber->scrub($it),"
NSQ_SOURCE_LINE 00000679 "        $/;"
NSQ_SOURCE_LINE 00000680 ""
NSQ_SOURCE_LINE 00000681 "    $scrubber->process(1);    # allow process instructions (dangerous)"
NSQ_SOURCE_LINE 00000682 "    $default[0] = 1;          # allow all tags by default"
NSQ_SOURCE_LINE 00000683 "    $default[1]->{'*'} = 0;   # deny all attributes by default"
NSQ_SOURCE_LINE 00000684 "    $scrubber->default(@default);    # set the default again"
NSQ_SOURCE_LINE 00000685 ""
NSQ_SOURCE_LINE 00000686 "    print"
NSQ_SOURCE_LINE 00000687 "        \"#scrubbed text (default \","
NSQ_SOURCE_LINE 00000688 "        $scrubber->default(),"
NSQ_SOURCE_LINE 00000689 "        \" comment \","
NSQ_SOURCE_LINE 00000690 "        $scrubber->comment(),"
NSQ_SOURCE_LINE 00000691 "        \" process \","
NSQ_SOURCE_LINE 00000692 "        $scrubber->process(),"
NSQ_SOURCE_LINE 00000693 "        \" )\", $/,"
NSQ_SOURCE_LINE 00000694 "        $scrubber->scrub($it),"
NSQ_SOURCE_LINE 00000695 "        $/;"
NSQ_SOURCE_LINE 00000696 ""
NSQ_SOURCE_LINE 00000697 "=for example end"
NSQ_SOURCE_LINE 00000698 ""
NSQ_SOURCE_LINE 00000699 "=head2 FUN"
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "If you have L<Test::Inline> (and you've installed L<HTML::Scrubber>), try"
NSQ_SOURCE_LINE 00000702 ""
NSQ_SOURCE_LINE 00000703 "    pod2test Scrubber.pm >scrubber.t"
NSQ_SOURCE_LINE 00000704 "    perl scrubber.t"
NSQ_SOURCE_LINE 00000705 ""
NSQ_SOURCE_LINE 00000706 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000707 ""
NSQ_SOURCE_LINE 00000708 "L<HTML::Parser>, L<Test::Inline>."
NSQ_SOURCE_LINE 00000709 ""
NSQ_SOURCE_LINE 00000710 "The L<HTML::Sanitizer> module is no longer available on CPAN."
NSQ_SOURCE_LINE 00000711 ""
NSQ_SOURCE_LINE 00000712 "=head1 VERSION REQUIREMENTS"
NSQ_SOURCE_LINE 00000713 ""
NSQ_SOURCE_LINE 00000714 "As of version 0.14 I have added a perl minimum version requirement of 5.8. This"
NSQ_SOURCE_LINE 00000715 "is basically due to failures on the smokers perl 5.6 installations - which"
NSQ_SOURCE_LINE 00000716 "appears to be down to installation mechanisms and requirements."
NSQ_SOURCE_LINE 00000717 ""
NSQ_SOURCE_LINE 00000718 "Since I don't want to spend the time supporting a version that is so old (and"
NSQ_SOURCE_LINE 00000719 "may not work for reasons on UTF support etc), I have added a C<use 5.008;> to"
NSQ_SOURCE_LINE 00000720 "the main module."
NSQ_SOURCE_LINE 00000721 ""
NSQ_SOURCE_LINE 00000722 "If this is problematic I am very willing to accept patches to fix this up,"
NSQ_SOURCE_LINE 00000723 "although I do not personally see a good reason to support a release that has"
NSQ_SOURCE_LINE 00000724 "been obsolete for 13 years."
NSQ_SOURCE_LINE 00000725 ""
NSQ_SOURCE_LINE 00000726 "=head1 CONTRIBUTING"
NSQ_SOURCE_LINE 00000727 ""
NSQ_SOURCE_LINE 00000728 "If you want to contribute to the development of this module, the code is on"
NSQ_SOURCE_LINE 00000729 "L<GitHub|http://github.com/nigelm/html-scrubber>. You'll need a perl"
NSQ_SOURCE_LINE 00000730 "environment with L<Dist::Zilla>, and if you're just getting started, there's"
NSQ_SOURCE_LINE 00000731 "some documentation on using Vagrant and Perlbrew"
NSQ_SOURCE_LINE 00000732 "L<here|http://mrcaron.github.io/2015/03/06/Perl-CPAN-Pull-Request.html>."
NSQ_SOURCE_LINE 00000733 ""
NSQ_SOURCE_LINE 00000734 "There is now a C<.perltidyrc> and a C<.tidyallrc> file within the repository"
NSQ_SOURCE_LINE 00000735 "for the standard perltidy settings used - I will apply these before new"
NSQ_SOURCE_LINE 00000736 "releases.  Please do not let formatting prevent you from sending in patches etc"
NSQ_SOURCE_LINE 00000737 "- this can be sorted out as part of the release process.  Info on C<tidyall>"
NSQ_SOURCE_LINE 00000738 "can be found at"
NSQ_SOURCE_LINE 00000739 "L<https://metacpan.org/pod/distribution/Code-TidyAll/bin/tidyall>."
NSQ_SOURCE_LINE 00000740 ""
