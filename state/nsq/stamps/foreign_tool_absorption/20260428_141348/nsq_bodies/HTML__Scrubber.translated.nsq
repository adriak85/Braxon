NSQ_SOURCE_LINE 00000102 "sub allow {"
NSQ_SOURCE_LINE 00000103 "    my $self = shift;"
NSQ_SOURCE_LINE 00000104 "    for my $k (@_) {"
NSQ_SOURCE_LINE 00000105 "        $self->{_rules}{ lc $k } = 1;"
NSQ_SOURCE_LINE 00000106 "    }"
NSQ_SOURCE_LINE 00000107 "    $self->{_optimize} = 1;    # each time a rule changes, reoptimize when parse"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "    return;"
NSQ_SOURCE_LINE 00000110 "}"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "sub deny {"
NSQ_SOURCE_LINE 00000114 "    my $self = shift;"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "    for my $k (@_) {"
NSQ_SOURCE_LINE 00000117 "        $self->{_rules}{ lc $k } = 0;"
NSQ_SOURCE_LINE 00000118 "    }"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "    $self->{_optimize} = 1;    # each time a rule changes, reoptimize when parse"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "    return;"
NSQ_SOURCE_LINE 00000123 "}"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "sub rules {"
NSQ_SOURCE_LINE 00000127 "    my $self = shift;"
NSQ_SOURCE_LINE 00000128 "    my (%rules) = @_;"
NSQ_SOURCE_LINE 00000129 "    for my $k ( keys %rules ) {"
NSQ_SOURCE_LINE 00000130 "        $self->{_rules}{ lc $k } = $rules{$k};"
NSQ_SOURCE_LINE 00000131 "    }"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "    $self->{_optimize} = 1;    # each time a rule changes, reoptimize when parse"
NSQ_SOURCE_LINE 00000134 ""
NSQ_SOURCE_LINE 00000135 "    return;"
NSQ_SOURCE_LINE 00000136 "}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "sub default {"
NSQ_SOURCE_LINE 00000140 "    return $_[0]->{_rules}{'*'}"
NSQ_SOURCE_LINE 00000141 "        if @_ == 1;"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "    $_[0]->{_rules}{'*'} = $_[1] if defined $_[1];"
NSQ_SOURCE_LINE 00000144 "    $_[0]->{_rules}{'_'} = $_[2] if defined $_[2] and ref $_[2];"
NSQ_SOURCE_LINE 00000145 "    $_[0]->{_optimize} = 1;    # each time a rule changes, reoptimize when parse"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    return;"
NSQ_SOURCE_LINE 00000148 "}"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 ""
NSQ_SOURCE_LINE 00000151 "sub scrub_file {"
NSQ_SOURCE_LINE 00000152 "    if ( @_ > 2 ) {"
NSQ_SOURCE_LINE 00000153 "        return unless defined $_[0]->_out( $_[2] );"
NSQ_SOURCE_LINE 00000154 "    }"
NSQ_SOURCE_LINE 00000155 "    else {"
NSQ_SOURCE_LINE 00000156 "        $_[0]->{_p}->handler( default => @_scrub );"
NSQ_SOURCE_LINE 00000157 "    }"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "    $_[0]->_optimize();    #if $_[0]->{_optimize};"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "    $_[0]->{_p}->parse_file( $_[1] );"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "    return delete $_[0]->{_r} unless exists $_[0]->{_out};"
NSQ_SOURCE_LINE 00000164 "    print { $_[0]->{_out} } $_[0]->{_r} if length $_[0]->{_r};"
NSQ_SOURCE_LINE 00000165 "    delete $_[0]->{_out};"
NSQ_SOURCE_LINE 00000166 "    return 1;"
NSQ_SOURCE_LINE 00000167 "}"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "sub scrub {"
NSQ_SOURCE_LINE 00000171 "    if ( @_ > 2 ) {"
NSQ_SOURCE_LINE 00000172 "        return unless defined $_[0]->_out( $_[2] );"
NSQ_SOURCE_LINE 00000173 "    }"
NSQ_SOURCE_LINE 00000174 "    else {"
NSQ_SOURCE_LINE 00000175 "        $_[0]->{_p}->handler( default => @_scrub );"
NSQ_SOURCE_LINE 00000176 "    }"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "    $_[0]->_optimize();    # if $_[0]->{_optimize};"
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "    $_[0]->{_p}->parse( $_[1] ) if defined( $_[1] );"
NSQ_SOURCE_LINE 00000181 "    $_[0]->{_p}->eof();"
NSQ_SOURCE_LINE 00000182 ""
NSQ_SOURCE_LINE 00000183 "    return delete $_[0]->{_r} unless exists $_[0]->{_out};"
NSQ_SOURCE_LINE 00000184 "    delete $_[0]->{_out};"
NSQ_SOURCE_LINE 00000185 "    return 1;"
NSQ_SOURCE_LINE 00000186 "}"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "sub _out {"
NSQ_SOURCE_LINE 00000190 "    my ( $self, $o ) = @_;"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "    unless ( ref $o and ref \\$o ne 'GLOB' ) {"
NSQ_SOURCE_LINE 00000193 "        open my $F, '>', $o or return;"
NSQ_SOURCE_LINE 00000194 "        binmode $F;"
NSQ_SOURCE_LINE 00000195 "        $self->{_out} = $F;"
NSQ_SOURCE_LINE 00000196 "    }"
NSQ_SOURCE_LINE 00000197 "    else {"
NSQ_SOURCE_LINE 00000198 "        $self->{_out} = $o;"
NSQ_SOURCE_LINE 00000199 "    }"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "    $self->{_p}->handler( default => @_scrub_fh );"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "    return 1;"
NSQ_SOURCE_LINE 00000204 "}"
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 ""
NSQ_SOURCE_LINE 00000207 "sub _validate {"
NSQ_SOURCE_LINE 00000208 "    my ( $s, $t, $r, $a, $as ) = @_;"
NSQ_SOURCE_LINE 00000209 "    return \"<$t>\" unless %$a;"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "    $r = $s->{_rules}->{$r};"
NSQ_SOURCE_LINE 00000212 "    my %f;"
NSQ_SOURCE_LINE 00000213 ""
NSQ_SOURCE_LINE 00000214 "    for my $k ( keys %$a ) {"
NSQ_SOURCE_LINE 00000215 "        my $check = exists $r->{$k} ? $r->{$k} : exists $r->{'*'} ? $r->{'*'} : next;"
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "        if ( ref $check eq 'CODE' ) {"
NSQ_SOURCE_LINE 00000218 "            my @v = $check->( $s, $t, $k, $a->{$k}, $a, \\%f );"
NSQ_SOURCE_LINE 00000219 "            next unless @v;"
NSQ_SOURCE_LINE 00000220 "            $f{$k} = shift @v;"
NSQ_SOURCE_LINE 00000221 "        }"
NSQ_SOURCE_LINE 00000222 "        elsif ( ref $check || length($check) > 1 ) {"
NSQ_SOURCE_LINE 00000223 "            $f{$k} = $a->{$k} if $a->{$k} =~ m{$check};"
NSQ_SOURCE_LINE 00000224 "        }"
NSQ_SOURCE_LINE 00000225 "        elsif ($check) {"
NSQ_SOURCE_LINE 00000226 "            $f{$k} = $a->{$k};"
NSQ_SOURCE_LINE 00000227 "        }"
NSQ_SOURCE_LINE 00000228 "    }"
NSQ_SOURCE_LINE 00000229 ""
NSQ_SOURCE_LINE 00000230 "    if (%f) {"
NSQ_SOURCE_LINE 00000231 "        my %seen;"
NSQ_SOURCE_LINE 00000232 "        return \"<$t $r>\""
NSQ_SOURCE_LINE 00000233 "            if $r = join ' ', map {"
NSQ_SOURCE_LINE 00000234 "            defined $f{$_}"
NSQ_SOURCE_LINE 00000235 "                ? qq[$_=\"] . encode_entities( $f{$_} ) . q[\"]"
NSQ_SOURCE_LINE 00000236 "                : $_;    # boolean attribute (TODO?)"
NSQ_SOURCE_LINE 00000237 "            } grep { exists $f{$_} and !$seen{$_}++; } @$as;"
NSQ_SOURCE_LINE 00000238 "    }"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "    return \"<$t>\";"
NSQ_SOURCE_LINE 00000241 "}"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 ""
NSQ_SOURCE_LINE 00000244 "sub _scrub_str {"
NSQ_SOURCE_LINE 00000245 "    my ( $p, $e, $t, $a, $as, $text ) = @_;"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "    my $s      = $p->{\"\\0_s\"};"
NSQ_SOURCE_LINE 00000248 "    my $outstr = '';"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "    if ( $e eq 'start' ) {"
NSQ_SOURCE_LINE 00000251 "        if ( exists $s->{_rules}->{$t} )    # is there a specific rule"
NSQ_SOURCE_LINE 00000252 "        {"
NSQ_SOURCE_LINE 00000253 "            if ( ref $s->{_rules}->{$t} )    # is it complicated?(not simple;)"
NSQ_SOURCE_LINE 00000254 "            {"
NSQ_SOURCE_LINE 00000255 "                $outstr .= $s->_validate( $t, $t, $a, $as );"
NSQ_SOURCE_LINE 00000256 "            }"
NSQ_SOURCE_LINE 00000257 "            elsif ( $s->{_rules}->{$t} )     # validate using default attribute rule"
NSQ_SOURCE_LINE 00000258 "            {"
NSQ_SOURCE_LINE 00000259 "                $outstr .= $s->_validate( $t, '_', $a, $as );"
NSQ_SOURCE_LINE 00000260 "            }"
NSQ_SOURCE_LINE 00000261 "        }"
NSQ_SOURCE_LINE 00000262 "        elsif ( $s->{_rules}->{'*'} )        # default allow tags"
NSQ_SOURCE_LINE 00000263 "        {"
NSQ_SOURCE_LINE 00000264 "            $outstr .= $s->_validate( $t, '_', $a, $as );"
NSQ_SOURCE_LINE 00000265 "        }"
NSQ_SOURCE_LINE 00000266 "    }"
NSQ_SOURCE_LINE 00000267 "    elsif ( $e eq 'end' ) {"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "        # empty tags list taken from"
NSQ_SOURCE_LINE 00000270 "        # https://developer.mozilla.org/en/docs/Glossary/empty_element"
NSQ_SOURCE_LINE 00000271 "        my @empty_tags = qw(area base br col embed hr img input link meta param source track wbr);"
NSQ_SOURCE_LINE 00000272 "        return \"\" if $text ne '' && any { $t eq $_ } @empty_tags;    # skip false closing empty tags"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "        my $place = 0;"
NSQ_SOURCE_LINE 00000275 "        if ( exists $s->{_rules}->{$t} ) {"
NSQ_SOURCE_LINE 00000276 "            $place = 1 if $s->{_rules}->{$t};"
NSQ_SOURCE_LINE 00000277 "        }"
NSQ_SOURCE_LINE 00000278 "        elsif ( $s->{_rules}->{'*'} ) {"
NSQ_SOURCE_LINE 00000279 "            $place = 1;"
NSQ_SOURCE_LINE 00000280 "        }"
NSQ_SOURCE_LINE 00000281 "        if ($place) {"
NSQ_SOURCE_LINE 00000282 "            if ( length $text ) {"
NSQ_SOURCE_LINE 00000283 "                $outstr .= \"</$t>\";"
NSQ_SOURCE_LINE 00000284 "            }"
NSQ_SOURCE_LINE 00000285 "            else {"
NSQ_SOURCE_LINE 00000286 "                substr $s->{_r}, -1, 0, ' /';"
NSQ_SOURCE_LINE 00000287 "            }"
NSQ_SOURCE_LINE 00000288 "        }"
NSQ_SOURCE_LINE 00000289 "    }"
NSQ_SOURCE_LINE 00000290 "    elsif ( $e eq 'comment' ) {"
NSQ_SOURCE_LINE 00000291 "        if ( $s->{_comment} ) {"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "            # only copy comments through if they are well formed..."
NSQ_SOURCE_LINE 00000294 "            $outstr .= $text if ( $text =~ m|^<!--.*-->$|ms );"
NSQ_SOURCE_LINE 00000295 "        }"
NSQ_SOURCE_LINE 00000296 "    }"
NSQ_SOURCE_LINE 00000297 "    elsif ( $e eq 'process' ) {"
NSQ_SOURCE_LINE 00000298 "        $outstr .= $text if $s->{_process};"
NSQ_SOURCE_LINE 00000299 "    }"
NSQ_SOURCE_LINE 00000300 "    elsif ( $e eq 'text' or $e eq 'default' ) {"
NSQ_SOURCE_LINE 00000301 "        $text =~ s/</&lt;/g;    #https://rt.cpan.org/Public/Ticket/Attachment/83958/10332/scrubber.patch"
NSQ_SOURCE_LINE 00000302 "        $text =~ s/>/&gt;/g;"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "        $outstr .= $text;"
NSQ_SOURCE_LINE 00000305 "    }"
NSQ_SOURCE_LINE 00000306 "    elsif ( $e eq 'start_document' ) {"
NSQ_SOURCE_LINE 00000307 "        $outstr = \"\";"
NSQ_SOURCE_LINE 00000308 "    }"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "    return $outstr;"
NSQ_SOURCE_LINE 00000311 "}"
NSQ_SOURCE_LINE 00000312 ""
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "sub _scrub_fh {"
NSQ_SOURCE_LINE 00000315 "    my $self = $_[0]->{\"\\0_s\"};"
NSQ_SOURCE_LINE 00000316 "    print { $self->{_out} } $self->{'_r'} if length $self->{_r};"
NSQ_SOURCE_LINE 00000317 "    $self->{'_r'} = _scrub_str(@_);"
NSQ_SOURCE_LINE 00000318 "}"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 ""
NSQ_SOURCE_LINE 00000321 "sub _scrub {"
NSQ_SOURCE_LINE 00000322 ""
NSQ_SOURCE_LINE 00000323 "    $_[0]->{\"\\0_s\"}->{_r} .= _scrub_str(@_);"
NSQ_SOURCE_LINE 00000324 "}"
NSQ_SOURCE_LINE 00000325 ""
NSQ_SOURCE_LINE 00000326 "sub _optimize {"
NSQ_SOURCE_LINE 00000327 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "    my (@ignore_elements) = grep { not $self->{\"_$_\"} } qw(script style);"
NSQ_SOURCE_LINE 00000330 "    $self->{_p}->ignore_elements(@ignore_elements);    # if @ is empty, we reset ;)"
NSQ_SOURCE_LINE 00000331 ""
NSQ_SOURCE_LINE 00000332 "    return unless $self->{_optimize};"
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "    #sub allow"
NSQ_SOURCE_LINE 00000335 "    #    return unless $self->{_optimize}; # till I figure it out (huh)"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "    if ( $self->{_rules}{'*'} ) {    # default allow"
NSQ_SOURCE_LINE 00000338 "        $self->{_p}->report_tags();    # so clear it"
NSQ_SOURCE_LINE 00000339 "    }"
NSQ_SOURCE_LINE 00000340 "    else {"
NSQ_SOURCE_LINE 00000341 ""
NSQ_SOURCE_LINE 00000342 "        my (@reports) ="
NSQ_SOURCE_LINE 00000343 "            grep {                     # report only tags we want"
NSQ_SOURCE_LINE 00000344 "            $self->{_rules}{$_}"
NSQ_SOURCE_LINE 00000345 "            } keys %{ $self->{_rules} };"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "        $self->{_p}->report_tags(      # default deny, so optimize"
NSQ_SOURCE_LINE 00000348 "            @reports"
NSQ_SOURCE_LINE 00000349 "        ) if @reports;"
NSQ_SOURCE_LINE 00000350 "    }"
NSQ_SOURCE_LINE 00000351 ""
NSQ_SOURCE_LINE 00000352 "    # sub deny"
NSQ_SOURCE_LINE 00000353 "    #    return unless $self->{_optimize}; # till I figure it out (huh)"
NSQ_SOURCE_LINE 00000354 "    my (@ignores) ="
NSQ_SOURCE_LINE 00000355 "        grep { not $self->{_rules}{$_} } grep { $_ ne '*' } keys %{ $self->{_rules} };"
NSQ_SOURCE_LINE 00000356 ""
NSQ_SOURCE_LINE 00000357 "    $self->{_p}->ignore_tags(    # always ignore stuff we don't want"
NSQ_SOURCE_LINE 00000358 "        @ignores"
NSQ_SOURCE_LINE 00000359 "    ) if @ignores;"
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "    $self->{_optimize} = 0;"
NSQ_SOURCE_LINE 00000362 "    return;"
NSQ_SOURCE_LINE 00000363 "}"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "1;"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "#print sprintf q[ '%-12s => %s,], \"$_'\", $h{$_} for sort keys %h;# perl!"
NSQ_SOURCE_LINE 00000368 "#perl -ne\"chomp;print $_;print qq'\\t\\t# test ', ++$a if /ok\\(/;print $/\" test.pl >test2.pl"
NSQ_SOURCE_LINE 00000369 "#perl -ne\"chomp;print $_;if( /ok\\(/ ){s/\\#test \\d+$//;print qq'\\t\\t# test ', ++$a }print $/\" test.pl >test2.pl"
NSQ_SOURCE_LINE 00000370 "#perl -ne\"chomp;if(/ok\\(/){s/# test .*$//;print$_,qq'\\t\\t# test ',++$a}else{print$_}print$/\" test.pl >test2.pl"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "__END__"
