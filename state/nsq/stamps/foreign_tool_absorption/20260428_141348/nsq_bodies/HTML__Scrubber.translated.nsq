NSQ_SOURCE_LINE 00000087 "    return $_[0]->{_script}"
NSQ_SOURCE_LINE 00000088 "        if @_ == 1;"
NSQ_SOURCE_LINE 00000089 "    $_[0]->{_script} = $_[1];"
NSQ_SOURCE_LINE 00000090 "    return;"
NSQ_SOURCE_LINE 00000091 "}"
