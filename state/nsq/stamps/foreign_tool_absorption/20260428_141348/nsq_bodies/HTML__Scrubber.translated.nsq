NSQ_SOURCE_LINE 00000021 "(@_scrub)    = ( \\&_scrub,    \"self, event, tagname, attr, attrseq, text\" );"
NSQ_SOURCE_LINE 00000022 "(@_scrub_fh) = ( \\&_scrub_fh, \"self, event, tagname, attr, attrseq, text\" );"
