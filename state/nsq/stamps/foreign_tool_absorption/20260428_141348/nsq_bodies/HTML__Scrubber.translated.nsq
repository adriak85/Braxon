NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "our ( @_scrub, @_scrub_fh );"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "our $VERSION = '0.19'; # VERSION"
NSQ_SOURCE_LINE 00000017 "our $AUTHORITY = 'cpan:NIGELM'; # AUTHORITY"
NSQ_SOURCE_LINE 00000018 ""
