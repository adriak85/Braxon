NSQ_SOURCE_LINE 00000001 "package PadWalker;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use vars qw($VERSION @ISA @EXPORT_OK %EXPORT_TAGS);"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "require Exporter;"
NSQ_SOURCE_LINE 00000007 "require DynaLoader;"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "require 5.008;"
NSQ_SOURCE_LINE 00000010 ""
NSQ_SOURCE_LINE 00000011 "@ISA = qw(Exporter DynaLoader);"
NSQ_SOURCE_LINE 00000012 "@EXPORT_OK = qw(peek_my peek_our closed_over peek_sub var_name set_closed_over);"
NSQ_SOURCE_LINE 00000013 "%EXPORT_TAGS = (all => \\@EXPORT_OK);"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "$VERSION = '2.5';"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "bootstrap PadWalker $VERSION;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "sub peek_my;"
NSQ_SOURCE_LINE 00000020 "sub peek_our;"
NSQ_SOURCE_LINE 00000021 "sub closed_over;"
NSQ_SOURCE_LINE 00000022 "sub peek_sub;"
NSQ_SOURCE_LINE 00000023 "sub var_name;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "1;"
NSQ_SOURCE_LINE 00000026 "__END__"
NSQ_SOURCE_LINE 00000027 ""
NSQ_SOURCE_LINE 00000028 "=head1 NAME"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "PadWalker - play with other peoples' lexical variables"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "  use PadWalker qw(peek_my peek_our peek_sub closed_over);"
NSQ_SOURCE_LINE 00000035 "  ..."
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "PadWalker is a module which allows you to inspect (and even change!)"
NSQ_SOURCE_LINE 00000040 "lexical variables in any subroutine which called you. It will only"
NSQ_SOURCE_LINE 00000041 "show those variables which are in scope at the point of the call."
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "PadWalker is particularly useful for debugging. It's even"
NSQ_SOURCE_LINE 00000044 "used by Perl's built-in debugger. (It can also be used"
NSQ_SOURCE_LINE 00000045 "for evil, of course.)"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "I wouldn't recommend using PadWalker directly in production"
NSQ_SOURCE_LINE 00000048 "code, but it's your call. Some of the modules that use"
NSQ_SOURCE_LINE 00000049 "PadWalker internally are certainly safe for and useful"
NSQ_SOURCE_LINE 00000050 "in production."
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "=over 4"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "=item peek_my LEVEL"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "=item peek_our LEVEL"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "The LEVEL argument is interpreted just like the argument to C<caller>."
NSQ_SOURCE_LINE 00000059 "So C<peek_my(0)> returns a reference to a hash of all the C<my>"
NSQ_SOURCE_LINE 00000060 "variables that are currently in scope;"
NSQ_SOURCE_LINE 00000061 "C<peek_my(1)> returns a reference to a hash of all the C<my>"
NSQ_SOURCE_LINE 00000062 "variables that are in scope at the point where the current"
NSQ_SOURCE_LINE 00000063 "sub was called, and so on."
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "C<peek_our> works in the same way, except that it lists"
NSQ_SOURCE_LINE 00000066 "the C<our> variables rather than the C<my> variables."
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "The hash associates each variable name with a reference"
NSQ_SOURCE_LINE 00000069 "to its value. The variable names include the sigil, so"
NSQ_SOURCE_LINE 00000070 "the variable $x is represented by the string '$x'."
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "For example:"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "  my $x = 12;"
NSQ_SOURCE_LINE 00000075 "  my $h = peek_my (0);"
NSQ_SOURCE_LINE 00000076 "  ${$h->{'$x'}}++;"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "  print $x;  # prints 13"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "Or a more complex example:"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "  sub increment_my_x {"
NSQ_SOURCE_LINE 00000083 "    my $h = peek_my (1);"
NSQ_SOURCE_LINE 00000084 "    ${$h->{'$x'}}++;"
NSQ_SOURCE_LINE 00000085 "  }"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "  my $x=5;"
NSQ_SOURCE_LINE 00000088 "  increment_my_x;"
NSQ_SOURCE_LINE 00000089 "  print $x;  # prints 6"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=item peek_sub SUB"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "The C<peek_sub> routine takes a coderef as its argument, and returns a hash"
NSQ_SOURCE_LINE 00000094 "of the C<my> variables used in that sub. The values will usually be undefined"
NSQ_SOURCE_LINE 00000095 "unless the sub is in use (i.e. in the call-chain) at the time. On the other"
NSQ_SOURCE_LINE 00000096 "hand:"
NSQ_SOURCE_LINE 00000097 ""
NSQ_SOURCE_LINE 00000098 "  my $x = \"Hello!\";"
NSQ_SOURCE_LINE 00000099 "  my $r = peek_sub(sub {$x})->{'$x'};"
NSQ_SOURCE_LINE 00000100 "  print \"$$r\\n\";\t# prints 'Hello!'"
NSQ_SOURCE_LINE 00000101 ""
NSQ_SOURCE_LINE 00000102 "If the sub defines several C<my> variables with the same name, you'll get the"
NSQ_SOURCE_LINE 00000103 "last one. I don't know of any use for C<peek_sub> that isn't broken as a result"
NSQ_SOURCE_LINE 00000104 "of this, and it will probably be deprecated in a future version in favour of"
NSQ_SOURCE_LINE 00000105 "some alternative interface."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "=item closed_over SUB"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "C<closed_over> is similar to C<peek_sub>, except that it only lists"
NSQ_SOURCE_LINE 00000110 "the C<my> variables which are used in the subroutine but defined outside:"
NSQ_SOURCE_LINE 00000111 "in other words, the variables which it closes over. This I<does> have"
NSQ_SOURCE_LINE 00000112 "reasonable uses: see L<Data::Dump::Streamer>, for example (a future version"
NSQ_SOURCE_LINE 00000113 "of which may in fact use C<closed_over>)."
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "=item set_closed_over SUB, HASH_REF"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "C<set_closed_over> reassigns the pad variables that are closed over by the subroutine."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "The second argument is a hash of references, much like the one returned from C<closed_over>."
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=item var_name LEVEL, VAR_REF"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "=item var_name SUB,   VAR_REF"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "C<var_name(sub, var_ref)> returns the name of the variable referred to"
NSQ_SOURCE_LINE 00000126 "by C<var_ref>, provided it is a C<my> variable used in the sub. The C<sub>"
NSQ_SOURCE_LINE 00000127 "parameter can be either a CODE reference or a number. If it's a number,"
NSQ_SOURCE_LINE 00000128 "it's treated the same way as the argument to C<peek_my>."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "For example,"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "  my $foo;"
NSQ_SOURCE_LINE 00000133 "  print var_name(0, \\$foo);    # prints '$foo'"
NSQ_SOURCE_LINE 00000134 "  "
NSQ_SOURCE_LINE 00000135 "  sub my_name {"
NSQ_SOURCE_LINE 00000136 "    return var_name(1, shift);"
NSQ_SOURCE_LINE 00000137 "  }"
NSQ_SOURCE_LINE 00000138 "  print my_name(\\$foo);        # ditto"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=back"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "Robin Houston <robin@cpan.org>"
