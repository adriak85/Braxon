NSQ_SOURCE_LINE 00000023 "=head1 VERSION"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "This document describes version 0.014 of BorderStyles::Standard (from Perl distribution BorderStyles-Standard), released on 2022-02-20."
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "=head1 BORDER STYLES"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "=over"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "=item * L<BorderStyle::ASCII::None>"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "No borders, but row separator is still drawn using dashes."
NSQ_SOURCE_LINE 00000034 ""
NSQ_SOURCE_LINE 00000035 "=item * L<BorderStyle::ASCII::SingleLine>"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "Single line border with ASCII characters."
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "=item * L<BorderStyle::ASCII::SingleLineDoubleAfterHeader>"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "Just like ASCII::SingleLine but uses double line to separate header row and first data row."
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=item * L<BorderStyle::ASCII::SingleLineHorizontalOnly>"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "Single line border with ASCII characters, horizontal only."
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=item * L<BorderStyle::ASCII::SingleLineInnerOnly>"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "Single line border with ASCII characters, between columns only."
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=item * L<BorderStyle::ASCII::SingleLineOuterOnly>"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "Single line border with ASCII characters, outer borders only."
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "=item * L<BorderStyle::ASCII::SingleLineVerticalOnly>"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "Single line border with ASCII characters, vertical only."
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "=item * L<BorderStyle::ASCII::Space>"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "Space as borders, but data row separator is still drawn using dashes."
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "=item * L<BorderStyle::ASCII::SpaceInnerOnly>"
NSQ_SOURCE_LINE 00000064 ""
NSQ_SOURCE_LINE 00000065 "No borders, but columns are still separated using spaces and data row separator is still drawn using dashes."
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "=item * L<BorderStyle::BoxChar::None>"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "No borders, but data row separator is still drawn using horizontal line."
NSQ_SOURCE_LINE 00000070 ""
NSQ_SOURCE_LINE 00000071 "=item * L<BorderStyle::BoxChar::SingleLine>"
NSQ_SOURCE_LINE 00000072 ""
NSQ_SOURCE_LINE 00000073 "Single line border with box-drawing characters."
NSQ_SOURCE_LINE 00000074 ""
NSQ_SOURCE_LINE 00000075 "=item * L<BorderStyle::BoxChar::SingleLineHorizontalOnly>"
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "Single line border with box-drawing characters, horizontal only."
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "=item * L<BorderStyle::BoxChar::SingleLineInnerOnly>"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "Single line border with box-drawing characters, between columns only."
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "=item * L<BorderStyle::BoxChar::SingleLineOuterOnly>"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "Single line border with box-drawing characters, outer borders only."
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "=item * L<BorderStyle::BoxChar::SingleLineVerticalOnly>"
NSQ_SOURCE_LINE 00000088 ""
NSQ_SOURCE_LINE 00000089 "Single line border with box-drawing characters, vertical only."
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "=item * L<BorderStyle::BoxChar::Space>"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "Space as borders, but data row separator is still drawn using horizontal line."
NSQ_SOURCE_LINE 00000094 ""
NSQ_SOURCE_LINE 00000095 "=item * L<BorderStyle::BoxChar::SpaceInnerOnly>"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "No borders, but columns are still separated using spaces and data row separator is still drawn using horizontal line."
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "=item * L<BorderStyle::UTF8::Brick>"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "Single-line, bold on bottom right to give illusion of depth."
NSQ_SOURCE_LINE 00000102 ""
