NSQ_SOURCE_LINE 00000001 "package Parse::LocalDistribution;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 "use Parse::PMFile;"
NSQ_SOURCE_LINE 00000006 "use List::Util ();"
NSQ_SOURCE_LINE 00000007 "use Parse::CPAN::Meta ();"
NSQ_SOURCE_LINE 00000008 "use File::Spec;"
NSQ_SOURCE_LINE 00000009 "use File::Find;"
NSQ_SOURCE_LINE 00000010 "use Cwd ();"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our $VERSION = '0.21';"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub new {"
NSQ_SOURCE_LINE 00000015 "  my ($class, $root, $opts) = @_;"
NSQ_SOURCE_LINE 00000016 "  if (ref $root eq ref {} && !$opts) {"
NSQ_SOURCE_LINE 00000017 "    $opts = $root; $root = undef;"
NSQ_SOURCE_LINE 00000018 "  }"
NSQ_SOURCE_LINE 00000019 "  $opts ||= {};"
NSQ_SOURCE_LINE 00000020 "  $opts->{DISTROOT} = $root;"
NSQ_SOURCE_LINE 00000021 "  bless $opts, $class;"
NSQ_SOURCE_LINE 00000022 "}"
NSQ_SOURCE_LINE 00000023 ""
NSQ_SOURCE_LINE 00000024 "# adapted from PAUSE::mldistwatch#check_for_new"
NSQ_SOURCE_LINE 00000025 "sub parse {"
NSQ_SOURCE_LINE 00000026 "  my ($self, $root) = @_;"
NSQ_SOURCE_LINE 00000027 "  if ($root) {"
NSQ_SOURCE_LINE 00000028 "    $self->{DISTROOT} = $root;"
NSQ_SOURCE_LINE 00000029 "  } elsif (!$self->{DISTROOT}) {"
NSQ_SOURCE_LINE 00000030 "    $self->{DISTROOT} = Cwd::cwd();"
NSQ_SOURCE_LINE 00000031 "  }"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "  $self->{DIST} = $self->{DISTROOT};"
NSQ_SOURCE_LINE 00000034 "  $self->_read_dist;"
NSQ_SOURCE_LINE 00000035 "  $self->_extract_meta;"
NSQ_SOURCE_LINE 00000036 "  $self->_examine_pms;"
NSQ_SOURCE_LINE 00000037 "}"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "# from PAUSE::dist;"
NSQ_SOURCE_LINE 00000040 "sub _read_dist {"
NSQ_SOURCE_LINE 00000041 "  my $self = shift;"
NSQ_SOURCE_LINE 00000042 "  # TODO: support absolute path"
NSQ_SOURCE_LINE 00000043 "  my(@manifind) = $self->_find_files;"
NSQ_SOURCE_LINE 00000044 "  my $manifound = @manifind;"
NSQ_SOURCE_LINE 00000045 "  $self->{MANIFOUND} = \\@manifind;"
NSQ_SOURCE_LINE 00000046 "  my $dist = $self->{DIST};"
NSQ_SOURCE_LINE 00000047 "  unless (@manifind){"
NSQ_SOURCE_LINE 00000048 "    $self->_verbose(1,\"NO FILES! in dist $dist?\");"
NSQ_SOURCE_LINE 00000049 "    return;"
NSQ_SOURCE_LINE 00000050 "  }"
NSQ_SOURCE_LINE 00000051 "  $self->_verbose(1,\"Found $manifound files in dist $dist, first $manifind[0]\\n\");"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "# from PAUSE::dist;"
NSQ_SOURCE_LINE 00000055 "sub _extract_meta {"
NSQ_SOURCE_LINE 00000056 "  my $self = shift;"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "  return if $self->{META_CONTENT};"
NSQ_SOURCE_LINE 00000059 ""
NSQ_SOURCE_LINE 00000060 "  my $dist = $self->{DIST};"
NSQ_SOURCE_LINE 00000061 "  my @manifind = @{$self->{MANIFOUND}};"
NSQ_SOURCE_LINE 00000062 ""
NSQ_SOURCE_LINE 00000063 "  my $json = List::Util::reduce { length $a < length $b ? $a : $b }"
NSQ_SOURCE_LINE 00000064 "             grep !m|/t/|, grep m|/META\\.json$|, @manifind;"
NSQ_SOURCE_LINE 00000065 "  my $yaml = List::Util::reduce { length $a < length $b ? $a : $b }"
NSQ_SOURCE_LINE 00000066 "             grep !m|/t/|, grep m|/META\\.yml$|, @manifind;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "  # META.json located only in a subdirectory should not precede"
NSQ_SOURCE_LINE 00000069 "  # META.yml located in the top directory. (eg. Test::Module::Used 0.2.4)"
NSQ_SOURCE_LINE 00000070 "  if ($json && $yaml && length($json) > length($yaml) + 1) {"
NSQ_SOURCE_LINE 00000071 "    $json = '';"
NSQ_SOURCE_LINE 00000072 "  }"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "  unless ($json || $yaml) {"
NSQ_SOURCE_LINE 00000075 "    $self->{METAFILE} = \"No META.yml or META.json found\";"
NSQ_SOURCE_LINE 00000076 "    $self->_verbose(1,\"No META.yml or META.json in $dist\");"
NSQ_SOURCE_LINE 00000077 "    return;"
NSQ_SOURCE_LINE 00000078 "  }"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "  for my $metafile ($json || $yaml) {"
NSQ_SOURCE_LINE 00000081 "    my $metafile_abs = File::Spec->catfile($self->{DISTROOT}, $metafile);"
NSQ_SOURCE_LINE 00000082 "    $metafile_abs =~ s|\\\\|/|g;"
NSQ_SOURCE_LINE 00000083 "    if (-l $metafile_abs) {"
NSQ_SOURCE_LINE 00000084 "      my $err = \"found $metafile but it was a symlink, ignoring\";"
NSQ_SOURCE_LINE 00000085 "      $self->{METAFILE} = $err;"
NSQ_SOURCE_LINE 00000086 "    } elsif (-s $metafile_abs) {"
NSQ_SOURCE_LINE 00000087 "      $self->{METAFILE} = $metafile;"
NSQ_SOURCE_LINE 00000088 "      my $ok = eval {"
NSQ_SOURCE_LINE 00000089 "        $self->{META_CONTENT} = Parse::CPAN::Meta->load_file($metafile_abs); 1"
NSQ_SOURCE_LINE 00000090 "      };"
NSQ_SOURCE_LINE 00000091 "      unless ($ok) {"
NSQ_SOURCE_LINE 00000092 "        $self->_verbose(1,\"Error while parsing $metafile: $@\");"
NSQ_SOURCE_LINE 00000093 "        $self->{META_CONTENT} = {};"
NSQ_SOURCE_LINE 00000094 "        $self->{METAFILE} = \"$metafile found but error \""
NSQ_SOURCE_LINE 00000095 "                          . \"encountered while loading: $@\";"
NSQ_SOURCE_LINE 00000096 "      }"
NSQ_SOURCE_LINE 00000097 "    } else {"
NSQ_SOURCE_LINE 00000098 "      $self->{METAFILE} = \"Empty $metafile found, ignoring\\n\";"
NSQ_SOURCE_LINE 00000099 "    }"
NSQ_SOURCE_LINE 00000100 "  }"
NSQ_SOURCE_LINE 00000101 "}"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "# from PAUSE::dist;"
NSQ_SOURCE_LINE 00000104 "sub _examine_pms {"
NSQ_SOURCE_LINE 00000105 "  my $self = shift;"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "  my $dist = $self->{DIST};"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "  my $pmfiles = $self->_filter_pms;"
NSQ_SOURCE_LINE 00000110 "  my($meta, $provides, $indexing_method);"
NSQ_SOURCE_LINE 00000111 "  if (my $version_from_meta_ok = $self->_version_from_meta_ok) {"
NSQ_SOURCE_LINE 00000112 "    $meta = $self->{META_CONTENT};"
NSQ_SOURCE_LINE 00000113 "    $provides = $meta->{provides};"
NSQ_SOURCE_LINE 00000114 "    if ($provides && \"HASH\" eq ref $provides) {"
NSQ_SOURCE_LINE 00000115 "      $indexing_method = '_index_by_meta';"
NSQ_SOURCE_LINE 00000116 "    }"
NSQ_SOURCE_LINE 00000117 "  }"
NSQ_SOURCE_LINE 00000118 "  if (! $indexing_method && @$pmfiles) { # examine files"
NSQ_SOURCE_LINE 00000119 "    $indexing_method = '_index_by_files';"
NSQ_SOURCE_LINE 00000120 "  }"
NSQ_SOURCE_LINE 00000121 ""
NSQ_SOURCE_LINE 00000122 "  if ($indexing_method) {"
NSQ_SOURCE_LINE 00000123 "    return $self->$indexing_method($pmfiles, $provides);"
NSQ_SOURCE_LINE 00000124 "  }"
NSQ_SOURCE_LINE 00000125 "  return {};"
NSQ_SOURCE_LINE 00000126 "}"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "# from PAUSE::dist"
NSQ_SOURCE_LINE 00000129 "sub _index_by_files {"
NSQ_SOURCE_LINE 00000130 "  my ($self, $pmfiles, $provides) = @_;"
NSQ_SOURCE_LINE 00000131 "  my $dist = $self->{DIST};"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "  my %result;"
NSQ_SOURCE_LINE 00000134 "  my $parser = Parse::PMFile->new($self->{META_CONTENT}, $self);"
NSQ_SOURCE_LINE 00000135 "  for my $pmfile (@$pmfiles) {"
NSQ_SOURCE_LINE 00000136 "    my $pmfile_abs = File::Spec->catfile($self->{DISTROOT}, $pmfile);"
NSQ_SOURCE_LINE 00000137 "    $pmfile_abs =~ s|\\\\|/|g;"
NSQ_SOURCE_LINE 00000138 "    if ($pmfile_abs =~ m|/blib/|) {"
NSQ_SOURCE_LINE 00000139 "      $self->_verbose(1,\"Still a blib directory detected:"
NSQ_SOURCE_LINE 00000140 "        dist[$dist]pmfile[$pmfile]"
NSQ_SOURCE_LINE 00000141 "        \");"
NSQ_SOURCE_LINE 00000142 "      next;"
NSQ_SOURCE_LINE 00000143 "    }"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    my ($info, $errs) = $parser->parse($pmfile_abs);"
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "    for my $package (keys %$info) {"
NSQ_SOURCE_LINE 00000148 "      if (!defined $result{$package} or $info->{$package}{simile}) {"
NSQ_SOURCE_LINE 00000149 "        $result{$package} = $info->{$package};"
NSQ_SOURCE_LINE 00000150 "      }"
NSQ_SOURCE_LINE 00000151 "    }"
NSQ_SOURCE_LINE 00000152 "    if ($errs) {"
NSQ_SOURCE_LINE 00000153 "      for my $package (keys %$errs) {"
NSQ_SOURCE_LINE 00000154 "        for (keys %{$errs->{$package}}) {"
NSQ_SOURCE_LINE 00000155 "          $result{$package}{$_ =~ /infile|warning/ ? $_ : $_.'_error'} = $errs->{$package}{$_};"
NSQ_SOURCE_LINE 00000156 "        }"
NSQ_SOURCE_LINE 00000157 "      }"
NSQ_SOURCE_LINE 00000158 "    }"
NSQ_SOURCE_LINE 00000159 "  }"
NSQ_SOURCE_LINE 00000160 "  return \\%result;"
NSQ_SOURCE_LINE 00000161 "}"
NSQ_SOURCE_LINE 00000162 ""
NSQ_SOURCE_LINE 00000163 "# from PAUSE::dist"
NSQ_SOURCE_LINE 00000164 "sub _index_by_meta {"
NSQ_SOURCE_LINE 00000165 "  my ($self, $pmfiles, $provides) = @_;"
NSQ_SOURCE_LINE 00000166 "  my $dist = $self->{DIST};"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "  my %result;"
NSQ_SOURCE_LINE 00000169 "  while (my($k,$v) = each %$provides) {"
NSQ_SOURCE_LINE 00000170 "    next if ref $v ne ref {};"
NSQ_SOURCE_LINE 00000171 "    next if !defined $v->{file} or $v->{file} eq '';"
NSQ_SOURCE_LINE 00000172 "    $v->{infile} = \"$v->{file}\";"
NSQ_SOURCE_LINE 00000173 "    my @stat = stat File::Spec->catfile($self->{DISTROOT}, $v->{file});"
NSQ_SOURCE_LINE 00000174 "    if (@stat) {"
NSQ_SOURCE_LINE 00000175 "      $v->{filemtime} = $stat[9];"
NSQ_SOURCE_LINE 00000176 "    } else {"
NSQ_SOURCE_LINE 00000177 "      $v->{filemtime} = 0;"
NSQ_SOURCE_LINE 00000178 "    }"
NSQ_SOURCE_LINE 00000179 "    unless (defined $v->{version}) {"
NSQ_SOURCE_LINE 00000180 "      # 2009-09-23 get a bugreport due to"
NSQ_SOURCE_LINE 00000181 "      # RKITOVER/MooseX-Types-0.20.tar.gz not"
NSQ_SOURCE_LINE 00000182 "      # setting version for MooseX::Types::Util"
NSQ_SOURCE_LINE 00000183 "      $v->{version} = \"undef\";"
NSQ_SOURCE_LINE 00000184 "    }"
NSQ_SOURCE_LINE 00000185 "    # going from a distro object to a package object"
NSQ_SOURCE_LINE 00000186 "    # is only possible via a file object"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "    $self->_examine_pkg({package => $k, pp => $v}) or next;"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "    $result{$k} = $v;"
NSQ_SOURCE_LINE 00000191 "  }"
NSQ_SOURCE_LINE 00000192 "  return \\%result;"
NSQ_SOURCE_LINE 00000193 "}"
NSQ_SOURCE_LINE 00000194 ""
NSQ_SOURCE_LINE 00000195 "# from PAUSE::package;"
NSQ_SOURCE_LINE 00000196 "sub _examine_pkg {"
NSQ_SOURCE_LINE 00000197 "  my ($self, $args) = @_;"
NSQ_SOURCE_LINE 00000198 "  my $package = $args->{package};"
NSQ_SOURCE_LINE 00000199 "  my $pp = $args->{pp};"
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "  # should they be cought earlier? Maybe."
NSQ_SOURCE_LINE 00000202 "  # but as an ultimate sanity check suggested by Richard Soderberg"
NSQ_SOURCE_LINE 00000203 "  # XXX should be in a separate sub and be tested"
NSQ_SOURCE_LINE 00000204 "  if ($package !~ /^\\w[\\w\\:\\']*\\w?\\z/"
NSQ_SOURCE_LINE 00000205 "      ||"
NSQ_SOURCE_LINE 00000206 "      $package !~ /\\w\\z/"
NSQ_SOURCE_LINE 00000207 "      ||"
NSQ_SOURCE_LINE 00000208 "      $package =~ /:/ && $package !~ /::/"
NSQ_SOURCE_LINE 00000209 "      ||"
NSQ_SOURCE_LINE 00000210 "      $package =~ /\\w:\\w/"
NSQ_SOURCE_LINE 00000211 "      ||"
NSQ_SOURCE_LINE 00000212 "      $package =~ /:::/"
NSQ_SOURCE_LINE 00000213 "      ){"
NSQ_SOURCE_LINE 00000214 "      $self->_verbose(1,\"Package[$package] did not pass the ultimate sanity check\");"
NSQ_SOURCE_LINE 00000215 "      return;"
NSQ_SOURCE_LINE 00000216 "  }"
NSQ_SOURCE_LINE 00000217 ""
NSQ_SOURCE_LINE 00000218 "  if ($self->{USERID} && $self->{PERMISSIONS} && !$self->_perm_check($package)) {"
NSQ_SOURCE_LINE 00000219 "      return;"
NSQ_SOURCE_LINE 00000220 "  }"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "  # No parser problem should be found"
NSQ_SOURCE_LINE 00000223 "  # (only used for META provides in this module)"
NSQ_SOURCE_LINE 00000224 ""
NSQ_SOURCE_LINE 00000225 "  # Sanity checks"
NSQ_SOURCE_LINE 00000226 ""
NSQ_SOURCE_LINE 00000227 "  for ("
NSQ_SOURCE_LINE 00000228 "        $package,"
NSQ_SOURCE_LINE 00000229 "        $pp->{version},"
NSQ_SOURCE_LINE 00000230 "      ) {"
NSQ_SOURCE_LINE 00000231 "      if (!defined || /^\\s*$/ || /\\s/){  # for whatever reason I come here"
NSQ_SOURCE_LINE 00000232 "          return;            # don't screw up 02packages"
NSQ_SOURCE_LINE 00000233 "      }"
NSQ_SOURCE_LINE 00000234 "  }"
NSQ_SOURCE_LINE 00000235 "  return unless $self->_version_ok($pp);"
NSQ_SOURCE_LINE 00000236 ""
NSQ_SOURCE_LINE 00000237 "  $pp;"
NSQ_SOURCE_LINE 00000238 "}"
NSQ_SOURCE_LINE 00000239 ""
NSQ_SOURCE_LINE 00000240 "sub _version_ok {"
NSQ_SOURCE_LINE 00000241 "  my ($self, $pp) = @_;"
NSQ_SOURCE_LINE 00000242 "  return if length($pp->{version} || 0) > 16;"
NSQ_SOURCE_LINE 00000243 "  return 1"
NSQ_SOURCE_LINE 00000244 "}"
NSQ_SOURCE_LINE 00000245 ""
NSQ_SOURCE_LINE 00000246 "# from PAUSE::dist;"
NSQ_SOURCE_LINE 00000247 "sub _filter_pms {"
NSQ_SOURCE_LINE 00000248 "  my($self) = @_;"
NSQ_SOURCE_LINE 00000249 "  my @pmfile;"
NSQ_SOURCE_LINE 00000250 ""
NSQ_SOURCE_LINE 00000251 "  # very similar code is in PAUSE::package::filter_ppps"
NSQ_SOURCE_LINE 00000252 "  MANI: for my $mf ( @{$self->{MANIFOUND}} ) {"
NSQ_SOURCE_LINE 00000253 "    next unless $mf =~ /\\.pm(?:\\.PL)?$/i;"
NSQ_SOURCE_LINE 00000254 "    my($inmf) = $mf =~ m!^[^/]+/(.+)!; # go one directory down"
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "    # skip \"t\" - libraries in ./t are test libraries!"
NSQ_SOURCE_LINE 00000257 "    # skip \"xt\" - libraries in ./xt are author test libraries!"
NSQ_SOURCE_LINE 00000258 "    # skip \"inc\" - libraries in ./inc are usually install libraries"
NSQ_SOURCE_LINE 00000259 "    # skip \"local\" - somebody shipped his carton setup!"
NSQ_SOURCE_LINE 00000260 "    # skip 'perl5\" - somebody shipped her local::lib!"
NSQ_SOURCE_LINE 00000261 "    # skip 'fatlib\" - somebody shipped their  fatpack lib!"
NSQ_SOURCE_LINE 00000262 "    # skip 'examples', 'example', 'ex', 'eg', 'demo' - example usage"
NSQ_SOURCE_LINE 00000263 "    next if $inmf =~ m!^(?:x?t|inc|local|perl5|fatlib|examples?|ex|eg|demo)/!;"
NSQ_SOURCE_LINE 00000264 ""
NSQ_SOURCE_LINE 00000265 "    if ($self->{META_CONTENT}){"
NSQ_SOURCE_LINE 00000266 "      my $no_index = $self->{META_CONTENT}{no_index}"
NSQ_SOURCE_LINE 00000267 "      || $self->{META_CONTENT}{private}; # backward compat"
NSQ_SOURCE_LINE 00000268 "      if (ref($no_index) eq 'HASH') {"
NSQ_SOURCE_LINE 00000269 "        my %map = ("
NSQ_SOURCE_LINE 00000270 "          file => qr{\\z},"
NSQ_SOURCE_LINE 00000271 "          directory => qr{/},"
NSQ_SOURCE_LINE 00000272 "        );"
NSQ_SOURCE_LINE 00000273 "        for my $k (qw(file directory)) {"
NSQ_SOURCE_LINE 00000274 "          next unless my $v = $no_index->{$k};"
NSQ_SOURCE_LINE 00000275 "          my $rest = $map{$k};"
NSQ_SOURCE_LINE 00000276 "          if (ref $v eq \"ARRAY\") {"
NSQ_SOURCE_LINE 00000277 "            for my $ve (@$v) {"
NSQ_SOURCE_LINE 00000278 "              $ve =~ s|\\\\|/|g; # Class-InsideOut-0.90_01"
NSQ_SOURCE_LINE 00000279 "              $ve =~ s|/+$||;"
NSQ_SOURCE_LINE 00000280 "              if ($inmf =~ /^$ve$rest/){"
NSQ_SOURCE_LINE 00000281 "                $self->_verbose(1,\"Skipping inmf[$inmf] due to ve[$ve]\");"
NSQ_SOURCE_LINE 00000282 "                next MANI;"
NSQ_SOURCE_LINE 00000283 "              } else {"
NSQ_SOURCE_LINE 00000284 "                $self->_verbose(1,\"NOT skipping inmf[$inmf] due to ve[$ve]\");"
NSQ_SOURCE_LINE 00000285 "              }"
NSQ_SOURCE_LINE 00000286 "            }"
NSQ_SOURCE_LINE 00000287 "          } else {"
NSQ_SOURCE_LINE 00000288 "            $v =~ s|/+$||;"
NSQ_SOURCE_LINE 00000289 "            if ($inmf =~ /^$v$rest/){"
NSQ_SOURCE_LINE 00000290 "              $self->_verbose(1,\"Skipping inmf[$inmf] due to v[$v]\");"
NSQ_SOURCE_LINE 00000291 "              next MANI;"
NSQ_SOURCE_LINE 00000292 "            } else {"
NSQ_SOURCE_LINE 00000293 "              $self->_verbose(1,\"NOT skipping inmf[$inmf] due to v[$v]\");"
NSQ_SOURCE_LINE 00000294 "            }"
NSQ_SOURCE_LINE 00000295 "          }"
NSQ_SOURCE_LINE 00000296 "        }"
NSQ_SOURCE_LINE 00000297 "      } else {"
NSQ_SOURCE_LINE 00000298 "        # noisy:"
NSQ_SOURCE_LINE 00000299 "        # $self->_verbose(1,\"no keyword 'no_index' or 'private' in META_CONTENT\");"
NSQ_SOURCE_LINE 00000300 "      }"
NSQ_SOURCE_LINE 00000301 "    } else {"
NSQ_SOURCE_LINE 00000302 "      # $self->_verbose(1,\"no META_CONTENT\"); # too noisy"
NSQ_SOURCE_LINE 00000303 "    }"
NSQ_SOURCE_LINE 00000304 "    push @pmfile, $mf;"
NSQ_SOURCE_LINE 00000305 "  }"
NSQ_SOURCE_LINE 00000306 "  $self->_verbose(1,\"Finished with pmfile[@pmfile]\\n\");"
NSQ_SOURCE_LINE 00000307 "  \\@pmfile;"
NSQ_SOURCE_LINE 00000308 "}"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "sub _version_from_meta_ok { Parse::PMFile::_version_from_meta_ok(@_) }"
NSQ_SOURCE_LINE 00000311 "sub _verbose { Parse::PMFile::_verbose(@_) }"
NSQ_SOURCE_LINE 00000312 "sub _perm_check { Parse::PMFile::_perm_check(@_) }"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "# instead of ExtUtils::Manifest::manifind()"
NSQ_SOURCE_LINE 00000315 "# which only looks for files under the current directory."
NSQ_SOURCE_LINE 00000316 "# We also need to look at MANIFEST/MANIFEST.SKIP here because"
NSQ_SOURCE_LINE 00000317 "# unwanted files are not excluded yet."
NSQ_SOURCE_LINE 00000318 "# If we have MANIFEST, assume it's up-to-date and lists everything"
NSQ_SOURCE_LINE 00000319 "# we need. If we have only MANIFEST.SKIP, then look for files"
NSQ_SOURCE_LINE 00000320 "# and discard the matched."
NSQ_SOURCE_LINE 00000321 "sub _find_files {"
NSQ_SOURCE_LINE 00000322 "  my $self = shift;"
NSQ_SOURCE_LINE 00000323 ""
NSQ_SOURCE_LINE 00000324 "  my @files = $self->_find_files_from_manifest;"
NSQ_SOURCE_LINE 00000325 "  return sort @files if @files;"
NSQ_SOURCE_LINE 00000326 ""
NSQ_SOURCE_LINE 00000327 "  my $skip = $self->_prepare_skip;"
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "  my $root = $self->{DISTROOT};"
NSQ_SOURCE_LINE 00000330 "  my $wanted = sub {"
NSQ_SOURCE_LINE 00000331 "    my $name = $File::Find::name;"
NSQ_SOURCE_LINE 00000332 "    return if -d $_;"
NSQ_SOURCE_LINE 00000333 "    return if $name =~ m!/(?:\\.(?:svn|git)|blib)/!; # too common"
NSQ_SOURCE_LINE 00000334 "    my $rel = File::Spec->abs2rel($name, $root);"
NSQ_SOURCE_LINE 00000335 "    $rel =~ s|\\\\|/|g;"
NSQ_SOURCE_LINE 00000336 "    return if $skip && $skip->($rel);"
NSQ_SOURCE_LINE 00000337 "    push @files, \"./$rel\";"
NSQ_SOURCE_LINE 00000338 "  };"
NSQ_SOURCE_LINE 00000339 ""
NSQ_SOURCE_LINE 00000340 "  File::Find::find("
NSQ_SOURCE_LINE 00000341 "    {wanted => $wanted, follow => 0, no_chdir => 1}, $root"
NSQ_SOURCE_LINE 00000342 "  );"
NSQ_SOURCE_LINE 00000343 ""
NSQ_SOURCE_LINE 00000344 "  return sort @files;"
NSQ_SOURCE_LINE 00000345 "}"
NSQ_SOURCE_LINE 00000346 ""
NSQ_SOURCE_LINE 00000347 "# adapted from ExtUtils::Manifest::maniread"
NSQ_SOURCE_LINE 00000348 "sub _find_files_from_manifest {"
NSQ_SOURCE_LINE 00000349 "  my $self = shift;"
NSQ_SOURCE_LINE 00000350 "  my $root = $self->{DISTROOT};"
NSQ_SOURCE_LINE 00000351 "  my $manifile = \"$root/MANIFEST\";"
NSQ_SOURCE_LINE 00000352 "  return unless -f $manifile;"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "  my %files;"
NSQ_SOURCE_LINE 00000355 "  open my $fh, '<', $manifile or return;"
NSQ_SOURCE_LINE 00000356 "  while(<$fh>) {"
NSQ_SOURCE_LINE 00000357 "    next if /^\\s*#/;"
NSQ_SOURCE_LINE 00000358 "    chomp;"
NSQ_SOURCE_LINE 00000359 "    my ($file, $comment);"
NSQ_SOURCE_LINE 00000360 "    if (($file, $comment) = /^'(\\\\[\\\\']|.+)+'\\s*(.*)/) {"
NSQ_SOURCE_LINE 00000361 "      $file =~ s/\\\\([\\\\'])/$1/g;"
NSQ_SOURCE_LINE 00000362 "    }"
NSQ_SOURCE_LINE 00000363 "    else {"
NSQ_SOURCE_LINE 00000364 "      ($file, $comment) = /^(\\S+)\\s*(.*)/;"
NSQ_SOURCE_LINE 00000365 "    }"
NSQ_SOURCE_LINE 00000366 "    next unless $file;"
NSQ_SOURCE_LINE 00000367 "    $files{\"./$file\"} = $comment;"
NSQ_SOURCE_LINE 00000368 "  }"
NSQ_SOURCE_LINE 00000369 "  sort keys %files;"
NSQ_SOURCE_LINE 00000370 "}"
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "# adapted from ExtUtils::Manifest::maniskip"
NSQ_SOURCE_LINE 00000373 "sub _prepare_skip {"
NSQ_SOURCE_LINE 00000374 "  my $self = shift;"
NSQ_SOURCE_LINE 00000375 "  my $root = $self->{DISTROOT};"
NSQ_SOURCE_LINE 00000376 "  my $skipfile = \"$root/MANIFEST.SKIP\";"
NSQ_SOURCE_LINE 00000377 "  return unless -f $skipfile;"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "  my @skip;"
NSQ_SOURCE_LINE 00000380 "  open my $fh, '<', $skipfile or return;"
NSQ_SOURCE_LINE 00000381 "  while(<$fh>) {"
NSQ_SOURCE_LINE 00000382 "    chomp;"
NSQ_SOURCE_LINE 00000383 "    s/\\r//;"
NSQ_SOURCE_LINE 00000384 "    m{^\\s*(?:(?:'([^\\\\']*(?:\\\\.[^\\\\']*)*)')|([^#\\s]\\S*))?(?:(?:\\s*)|(?:\\s+(.*?)\\s*))$};"
NSQ_SOURCE_LINE 00000385 "    my $filename = $2;"
NSQ_SOURCE_LINE 00000386 "    if ( defined($1) ) { "
NSQ_SOURCE_LINE 00000387 "      $filename = $1; "
NSQ_SOURCE_LINE 00000388 "      $filename =~ s/\\\\(['\\\\])/$1/g;"
NSQ_SOURCE_LINE 00000389 "    }"
NSQ_SOURCE_LINE 00000390 "    next if not defined($filename) or not $filename;"
NSQ_SOURCE_LINE 00000391 "    push @skip, $filename;"
NSQ_SOURCE_LINE 00000392 "  }"
NSQ_SOURCE_LINE 00000393 "  return unless @skip;"
NSQ_SOURCE_LINE 00000394 "  my $re = join '|', map \"(?:$_)\", @skip;"
NSQ_SOURCE_LINE 00000395 ""
NSQ_SOURCE_LINE 00000396 "  return sub {$_[0] =~ /$re/};"
NSQ_SOURCE_LINE 00000397 "}"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "1;"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "__END__"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "=head1 NAME"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "Parse::LocalDistribution - parses local .pm files as PAUSE does"
NSQ_SOURCE_LINE 00000406 ""
NSQ_SOURCE_LINE 00000407 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000408 ""
NSQ_SOURCE_LINE 00000409 "    use Parse::LocalDistribution;"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "    my $parser = Parse::LocalDistribution->new({ALLOW_DEV_VERSION => 1});"
NSQ_SOURCE_LINE 00000412 "    my $provides = $parser->parse('.');"
NSQ_SOURCE_LINE 00000413 ""
NSQ_SOURCE_LINE 00000414 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "This is a sister module of L<Parse::PMFile>. This module parses local .pm files (and a META file if any) in a specific (current if not specified) directory, and returns a hash reference that represents \"provides\" information (with some extra meta data). This is almost the same as L<Module::Metadata> does (which has been in Perl core since Perl 5.13.9). The main difference is the most of the code of this module is directly taken from the PAUSE code as of June 2013. If you need better compatibility to PAUSE, try this. If you need better performance, safety, or portability in general, L<Module::Metadata> may be a better and handier option (L<Parse::PMFile> (and thus L<Parse::LocalDistribution>) actually evaluates code in the $VERSION line (in a Safe compartment), which may be problematic in some cases)."
NSQ_SOURCE_LINE 00000417 ""
NSQ_SOURCE_LINE 00000418 "This module doesn't provide a feature to extract a distribution. If you are too lazy to implement it, L<CPAN::ParseDistribution> may be another good option."
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "=head1 METHODS"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "=head2 new"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "creates an object. You can pass an optional path and/or an optional hashref to configure. Options are:"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "=over 4"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "=item ALLOW_DEV_VERSION"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "Parse::LocalDistribution (actually L<Parse::PMFile>) usually ignores a version with an underscore as PAUSE does (because it's for a developer release, and should not be indexed). Set this option to true if you happen to need to keep such a version for better analysis."
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "=item VERBOSE"
NSQ_SOURCE_LINE 00000433 ""
NSQ_SOURCE_LINE 00000434 "Set this to true if you need to know some details."
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "=item FORK"
NSQ_SOURCE_LINE 00000437 ""
NSQ_SOURCE_LINE 00000438 "If you really need to let Parse::PMFile fork while parsing a version (as PAUSE does), set this to true."
NSQ_SOURCE_LINE 00000439 ""
NSQ_SOURCE_LINE 00000440 "=item USERID, PERMISSIONS"
NSQ_SOURCE_LINE 00000441 ""
NSQ_SOURCE_LINE 00000442 "Parse::LocalDistribution checks permissions of a package if both USERID and PERMISSIONS (which should be an instance of L<PAUSE::Permissions>) are provided. Unauthorized packages are removed."
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "=item META_CONTENT"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "If you already have parsed a META file, set this to avoid parsing the same META file again."
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "=back"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "=head2 parse"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "may take a path to a local distribution, and return a hash reference that holds information for package(s) found in the directory."
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000455 ""
NSQ_SOURCE_LINE 00000456 "Most part of this module is derived from PAUSE."
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "L<https://github.com/andk/pause>"
NSQ_SOURCE_LINE 00000459 ""
NSQ_SOURCE_LINE 00000460 "The following distributions do similar parsing, though the results may differ sometimes."
NSQ_SOURCE_LINE 00000461 ""
NSQ_SOURCE_LINE 00000462 "L<Module::Metadata>, L<CPAN::ParseDistribution>"
NSQ_SOURCE_LINE 00000463 ""
