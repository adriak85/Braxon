NSQ_SOURCE_LINE 00000383 "            #use DD; dd $coptspec;"
NSQ_SOURCE_LINE 00000384 "            return unless $coptspec;"
NSQ_SOURCE_LINE 00000385 ""
NSQ_SOURCE_LINE 00000386 "            my $summ;"
NSQ_SOURCE_LINE 00000387 "            # XXX translate"
NSQ_SOURCE_LINE 00000388 "            if ($opts{$optname}{is_neg}) {"
NSQ_SOURCE_LINE 00000389 "                $summ = $coptspec->{\"summary.alt.bool.not\"};"
NSQ_SOURCE_LINE 00000390 "                return $summ if defined $summ;"
NSQ_SOURCE_LINE 00000391 "                my $pos_opt = $ospecmeta->{pos_opts}[0];"
NSQ_SOURCE_LINE 00000392 "                $pos_opt = length($pos_opt) == 1 ? \"-$pos_opt\" : \"--$pos_opt\";"
NSQ_SOURCE_LINE 00000393 "                return \"The opposite of $pos_opt\";"
NSQ_SOURCE_LINE 00000394 "            } else {"
NSQ_SOURCE_LINE 00000395 "                $summ = $coptspec->{\"summary.alt.bool.yes\"};"
NSQ_SOURCE_LINE 00000396 "                return $summ if defined $summ;"
NSQ_SOURCE_LINE 00000397 "                $summ = $coptspec->{\"summary\"};"
NSQ_SOURCE_LINE 00000398 "                return $summ if defined $summ;"
NSQ_SOURCE_LINE 00000399 "            }"
NSQ_SOURCE_LINE 00000400 "        } else {"
NSQ_SOURCE_LINE 00000401 "            # it's option from function argument"
NSQ_SOURCE_LINE 00000402 "            my $arg = $ospecmeta->{arg};"
NSQ_SOURCE_LINE 00000403 "            my $argspec = $extras->{r}{meta}{args}{$arg};"
NSQ_SOURCE_LINE 00000404 "            #use DD; dd $argspec;"
NSQ_SOURCE_LINE 00000405 ""
NSQ_SOURCE_LINE 00000406 "            my $summ;"
NSQ_SOURCE_LINE 00000407 "            # XXX translate"
NSQ_SOURCE_LINE 00000408 "            #use DD; dd {optname=>$optname, ospecmeta=>$ospecmeta};"
NSQ_SOURCE_LINE 00000409 "            if ($ospecmeta->{is_neg}) {"
NSQ_SOURCE_LINE 00000410 "                $summ = $argspec->{\"summary.alt.bool.not\"};"
NSQ_SOURCE_LINE 00000411 "                return $summ if defined $summ;"
NSQ_SOURCE_LINE 00000412 "                my $pos_opt = $ospecmeta->{pos_opts}[0];"
NSQ_SOURCE_LINE 00000413 "                $pos_opt = length($pos_opt) == 1 ? \"-$pos_opt\" : \"--$pos_opt\";"
NSQ_SOURCE_LINE 00000414 "                return \"The opposite of $pos_opt\";"
NSQ_SOURCE_LINE 00000415 "            } else {"
