NSQ_SOURCE_LINE 00000421 "        }"
NSQ_SOURCE_LINE 00000422 ""
NSQ_SOURCE_LINE 00000423 "        return;"
NSQ_SOURCE_LINE 00000424 "    };"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "    my %seen_opts;"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "    # for each word (each element in this array), we try to find out whether"
NSQ_SOURCE_LINE 00000429 "    # it's supposed to complete option name, or option value, or argument, or"
NSQ_SOURCE_LINE 00000430 "    # separator (or more than one of them). plus some other information."
NSQ_SOURCE_LINE 00000431 "    #"
NSQ_SOURCE_LINE 00000432 "    # each element is a hash. if hash contains 'optname' key then it expects an"
NSQ_SOURCE_LINE 00000433 "    # option name. if hash contains 'optval' key then it expects an option"
NSQ_SOURCE_LINE 00000434 "    # value."
NSQ_SOURCE_LINE 00000435 "    #"
NSQ_SOURCE_LINE 00000436 "    # 'short_only' means that the word is not to be completed with long option"
NSQ_SOURCE_LINE 00000437 "    # name, only (bundle of) one-letter option names."
NSQ_SOURCE_LINE 00000438 ""
NSQ_SOURCE_LINE 00000439 "    my @expects;"
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "    $i = -1;"
NSQ_SOURCE_LINE 00000442 "    my $argpos = 0;"
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "  WORD:"
NSQ_SOURCE_LINE 00000445 "    while (1) {"
NSQ_SOURCE_LINE 00000446 "        last WORD if ++$i >= @words;"
NSQ_SOURCE_LINE 00000447 "        my $word = $words[$i];"
NSQ_SOURCE_LINE 00000448 "        #say \"D:i=$i, word=$word, ~~\\@words=\",~~@words;"
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "        if ($word eq '--' && $i != $cword) {"
NSQ_SOURCE_LINE 00000451 "            $expects[$i] = {separator=>1};"
NSQ_SOURCE_LINE 00000452 "            while (1) {"
NSQ_SOURCE_LINE 00000453 "                $i++;"
NSQ_SOURCE_LINE 00000454 "                last WORD if $i >= @words;"
NSQ_SOURCE_LINE 00000455 "                $expects[$i] = {arg=>1, argpos=>$argpos++};"
NSQ_SOURCE_LINE 00000456 "            }"
NSQ_SOURCE_LINE 00000457 "        }"
NSQ_SOURCE_LINE 00000458 ""
NSQ_SOURCE_LINE 00000459 "        if ($word =~ /\\A-/) {"
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "            # check if it is a (bundle) of short option names"
NSQ_SOURCE_LINE 00000462 "          SHORT_OPTS:"
NSQ_SOURCE_LINE 00000463 "            {"
NSQ_SOURCE_LINE 00000464 "                # it's not a known short option"
NSQ_SOURCE_LINE 00000465 "                last unless $opts{\"-\".substr($word,1,1)};"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "                # not a bundle, regard as only a single short option name"
NSQ_SOURCE_LINE 00000468 "                last unless $bundling;"
NSQ_SOURCE_LINE 00000469 ""
NSQ_SOURCE_LINE 00000470 "                # expand bundle"
NSQ_SOURCE_LINE 00000471 "                my $j = $i;"
NSQ_SOURCE_LINE 00000472 "                my $rest = substr($word, 1);"
NSQ_SOURCE_LINE 00000473 "                my @inswords;"
NSQ_SOURCE_LINE 00000474 "                my $encounter_equal_sign;"
NSQ_SOURCE_LINE 00000475 "              EXPAND:"
NSQ_SOURCE_LINE 00000476 "                while (1) {"
NSQ_SOURCE_LINE 00000477 "                    $rest =~ s/(.)// or last;"
NSQ_SOURCE_LINE 00000478 "                    my $opt = \"-$1\";"
NSQ_SOURCE_LINE 00000479 "                    my $opthash = $opts{$opt};"
NSQ_SOURCE_LINE 00000480 "                    unless ($opthash) {"
NSQ_SOURCE_LINE 00000481 "                        # we encounter an unknown option, doubt that this is a"
NSQ_SOURCE_LINE 00000482 "                        # bundle of short option name, it could be someone"
NSQ_SOURCE_LINE 00000483 "                        # typing --long as -long"
NSQ_SOURCE_LINE 00000484 "                        @inswords = ();"
NSQ_SOURCE_LINE 00000485 "                        $expects[$i]{short_only} = 0;"
NSQ_SOURCE_LINE 00000486 "                        $rest = $word;"
NSQ_SOURCE_LINE 00000487 "                        last EXPAND;"
NSQ_SOURCE_LINE 00000488 "                    }"
NSQ_SOURCE_LINE 00000489 "                    if ($opthash->{parsed}{max_vals}) {"
NSQ_SOURCE_LINE 00000490 "                        # stop after an option that requires value"
NSQ_SOURCE_LINE 00000491 "                        _mark_seen(\\%seen_opts, $opt, \\%opts);"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "                        if ($i == $j) {"
NSQ_SOURCE_LINE 00000494 "                            $words[$i] = $opt;"
NSQ_SOURCE_LINE 00000495 "                        } else {"
NSQ_SOURCE_LINE 00000496 "                            push @inswords, $opt;"
NSQ_SOURCE_LINE 00000497 "                            $j++;"
NSQ_SOURCE_LINE 00000498 "                        }"
NSQ_SOURCE_LINE 00000499 ""
NSQ_SOURCE_LINE 00000500 "                        my $expand;"
NSQ_SOURCE_LINE 00000501 "                        if (length $rest) {"
NSQ_SOURCE_LINE 00000502 "                            $expand++;"
NSQ_SOURCE_LINE 00000503 "                            # complete -Sfoo^ is completing option value"
NSQ_SOURCE_LINE 00000504 "                            $expects[$j > $i ? $j+1 : $j+2]{do_complete_optname} = 0;"
NSQ_SOURCE_LINE 00000505 "                            $expects[$j > $i ? $j+1 : $j+2]{optval} = $opt;"
NSQ_SOURCE_LINE 00000506 "                        } else {"
NSQ_SOURCE_LINE 00000507 "                            # complete -S^ as [-S] to add space"
NSQ_SOURCE_LINE 00000508 "                            $expects[$j > $i ? $j-1 : $j]{optname} = $opt;"
NSQ_SOURCE_LINE 00000509 "                            $expects[$j > $i ? $j-1 : $j]{comp_result} = ["
NSQ_SOURCE_LINE 00000510 "                                substr($word, 0, length($word)-length($rest))];"
NSQ_SOURCE_LINE 00000511 "                        }"
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "                        if ($rest =~ s/\\A=//) {"
NSQ_SOURCE_LINE 00000514 "                            $encounter_equal_sign++;"
NSQ_SOURCE_LINE 00000515 "                        }"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "                        if ($expand) {"
NSQ_SOURCE_LINE 00000518 "                            push @inswords, \"=\", $rest;"
NSQ_SOURCE_LINE 00000519 "                            $j+=2;"
NSQ_SOURCE_LINE 00000520 "                        }"
NSQ_SOURCE_LINE 00000521 "                        last EXPAND;"
NSQ_SOURCE_LINE 00000522 "                    }"
NSQ_SOURCE_LINE 00000523 "                    # continue splitting"
NSQ_SOURCE_LINE 00000524 "                    _mark_seen(\\%seen_opts, $opt, \\%opts);"
NSQ_SOURCE_LINE 00000525 "                    if ($i == $j) {"
NSQ_SOURCE_LINE 00000526 "                        $words[$i] = $opt;"
NSQ_SOURCE_LINE 00000527 "                    } else {"
NSQ_SOURCE_LINE 00000528 "                        push @inswords, $opt;"
NSQ_SOURCE_LINE 00000529 "                    }"
NSQ_SOURCE_LINE 00000530 "                    $j++;"
NSQ_SOURCE_LINE 00000531 "                }"
NSQ_SOURCE_LINE 00000532 ""
NSQ_SOURCE_LINE 00000533 "                #use DD; print \"D:inswords: \"; dd \\@inswords;"
NSQ_SOURCE_LINE 00000534 ""
NSQ_SOURCE_LINE 00000535 "                my $prefix = $encounter_equal_sign ? '' :"
NSQ_SOURCE_LINE 00000536 "                    substr($word, 0, length($word)-length($rest));"
NSQ_SOURCE_LINE 00000537 "                splice @words, $i+1, 0, @inswords;"
NSQ_SOURCE_LINE 00000538 "                for (0..@inswords) {"
NSQ_SOURCE_LINE 00000539 "                    $expects[$i+$_]{prefix} = $prefix;"
NSQ_SOURCE_LINE 00000540 "                    $expects[$i+$_]{word}   = $rest;"
NSQ_SOURCE_LINE 00000541 "                }"
NSQ_SOURCE_LINE 00000542 "                $cword += @inswords;"
NSQ_SOURCE_LINE 00000543 "                $i += @inswords;"
NSQ_SOURCE_LINE 00000544 "                $word = $words[$i];"
NSQ_SOURCE_LINE 00000545 "                $expects[$i]{short_only} //= 1;"
NSQ_SOURCE_LINE 00000546 "            } # SHORT_OPTS"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "            # split --foo=val -> --foo, =, val"
NSQ_SOURCE_LINE 00000549 "          SPLIT_EQUAL:"
NSQ_SOURCE_LINE 00000550 "            {"
NSQ_SOURCE_LINE 00000551 "                if ($word =~ /\\A(--?[^=]+)(=)(.*)/) {"
NSQ_SOURCE_LINE 00000552 "                    splice @words, $i, 1, $1, $2, $3;"
NSQ_SOURCE_LINE 00000553 "                    $word = $1;"
NSQ_SOURCE_LINE 00000554 "                    $cword += 2 if $cword >= $i;"
NSQ_SOURCE_LINE 00000555 "                }"
NSQ_SOURCE_LINE 00000556 "            }"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "            my $opt = $word;"
NSQ_SOURCE_LINE 00000559 "            my $matching_opts = _matching_opts($opt, \\%opts);"
NSQ_SOURCE_LINE 00000560 ""
NSQ_SOURCE_LINE 00000561 "            if (keys(%$matching_opts) == 1) {"
NSQ_SOURCE_LINE 00000562 "                my $opthash = $matching_opts->{ (keys %$matching_opts)[0] };"
NSQ_SOURCE_LINE 00000563 "                $opt = $opthash->{name};"
NSQ_SOURCE_LINE 00000564 "                $expects[$i]{optname} = $opt;"
NSQ_SOURCE_LINE 00000565 "                my $nth = $seen_opts{$opt} // 0;"
NSQ_SOURCE_LINE 00000566 "                $expects[$i]{nth} = $nth;"
NSQ_SOURCE_LINE 00000567 "                _mark_seen(\\%seen_opts, $opt, \\%opts);"
NSQ_SOURCE_LINE 00000568 ""
NSQ_SOURCE_LINE 00000569 "                my $min_vals = $opthash->{parsed}{min_vals};"
NSQ_SOURCE_LINE 00000570 "                my $max_vals = $opthash->{parsed}{max_vals};"
NSQ_SOURCE_LINE 00000571 "                #say \"D:min_vals=$min_vals, max_vals=$max_vals\";"
NSQ_SOURCE_LINE 00000572 ""
NSQ_SOURCE_LINE 00000573 "                # detect = after --opt"
NSQ_SOURCE_LINE 00000574 "                if ($i+1 < @words && $words[$i+1] eq '=') {"
NSQ_SOURCE_LINE 00000575 "                    $i++;"
NSQ_SOURCE_LINE 00000576 "                    $expects[$i] = {separator=>1, optval=>$opt, word=>'', nth=>$nth};"
NSQ_SOURCE_LINE 00000577 "                    # force expecting a value due to ="
NSQ_SOURCE_LINE 00000578 "                    $min_vals = 1;"
NSQ_SOURCE_LINE 00000579 "                    $max_vals = $min_vals if $max_vals < $min_vals;"
NSQ_SOURCE_LINE 00000580 "                }"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "                for (1 .. $min_vals) {"
NSQ_SOURCE_LINE 00000583 "                    $i++;"
NSQ_SOURCE_LINE 00000584 "                    last WORD if $i >= @words;"
NSQ_SOURCE_LINE 00000585 "                    $expects[$i]{optval} = $opt;"
NSQ_SOURCE_LINE 00000586 "                    $expects[$i]{nth} = $nth;"
NSQ_SOURCE_LINE 00000587 "                    push @{ $parsed_opts{$opt} }, $words[$i];"
NSQ_SOURCE_LINE 00000588 "                }"
NSQ_SOURCE_LINE 00000589 "                for (1 .. $max_vals-$min_vals) {"
NSQ_SOURCE_LINE 00000590 "                    last if $i+$_ >= @words;"
NSQ_SOURCE_LINE 00000591 "                    last if $words[$i+$_] =~ /\\A-/; # a new option"
NSQ_SOURCE_LINE 00000592 "                    $expects[$i+$_]{optval} = $opt; # but can also be optname"
NSQ_SOURCE_LINE 00000593 "                    $expects[$i]{nth} = $nth;"
NSQ_SOURCE_LINE 00000594 "                    push @{ $parsed_opts{$opt} }, $words[$i+$_];"
NSQ_SOURCE_LINE 00000595 "                }"
NSQ_SOURCE_LINE 00000596 "            } else {"
NSQ_SOURCE_LINE 00000597 "                # an unknown or still ambiguous option, assume it doesn't"
NSQ_SOURCE_LINE 00000598 "                # require argument, unless it's --opt= or --opt=foo"
NSQ_SOURCE_LINE 00000599 "                $opt = undef;"
NSQ_SOURCE_LINE 00000600 "                $expects[$i]{optname} = $opt;"
NSQ_SOURCE_LINE 00000601 "                my $possible_optnames = [sort keys %$matching_opts];"
NSQ_SOURCE_LINE 00000602 "                $expects[$i]{possible_optnames} = $possible_optnames;"
NSQ_SOURCE_LINE 00000603 ""
NSQ_SOURCE_LINE 00000604 "                # detect = after --opt"
NSQ_SOURCE_LINE 00000605 "                if ($i+1 < @words && $words[$i+1] eq '=') {"
NSQ_SOURCE_LINE 00000606 "                    $i++;"
NSQ_SOURCE_LINE 00000607 "                    $expects[$i] = {separator=>1, optval=>undef, possible_optnames=>$possible_optnames, word=>''};"
NSQ_SOURCE_LINE 00000608 "                    if ($i+1 < @words) {"
NSQ_SOURCE_LINE 00000609 "                        $i++;"
NSQ_SOURCE_LINE 00000610 "                        $expects[$i]{optval} = $opt;"
NSQ_SOURCE_LINE 00000611 "                        $expects[$i]{possible_optnames} = $possible_optnames;"
NSQ_SOURCE_LINE 00000612 "                    }"
NSQ_SOURCE_LINE 00000613 "                }"
NSQ_SOURCE_LINE 00000614 "            }"
NSQ_SOURCE_LINE 00000615 "        } else {"
NSQ_SOURCE_LINE 00000616 "            $expects[$i]{optname} = '';"
NSQ_SOURCE_LINE 00000617 "            $expects[$i]{arg} = 1;"
NSQ_SOURCE_LINE 00000618 "            $expects[$i]{argpos} = $argpos++;"
NSQ_SOURCE_LINE 00000619 "        }"
NSQ_SOURCE_LINE 00000620 "    }"
NSQ_SOURCE_LINE 00000621 ""
NSQ_SOURCE_LINE 00000622 "    my $exp = $expects[$cword];"
NSQ_SOURCE_LINE 00000623 "    my $word = $exp->{word} // $words[$cword];"
NSQ_SOURCE_LINE 00000624 ""
NSQ_SOURCE_LINE 00000625 "    #use DD; say \"D:opts: \"; dd \\%opts;"
NSQ_SOURCE_LINE 00000626 "    #use DD; print \"D:words: \"; dd \\@words;"
NSQ_SOURCE_LINE 00000627 "    #say \"D:cword: $cword\";"
NSQ_SOURCE_LINE 00000628 "    #use DD; print \"D:expects: \"; dd \\@expects;"
NSQ_SOURCE_LINE 00000629 "    #use DD; print \"D:seen_opts: \"; dd \\%seen_opts;"
NSQ_SOURCE_LINE 00000630 "    #use DD; print \"D:parsed_opts: \"; dd \\%parsed_opts;"
NSQ_SOURCE_LINE 00000631 "    #use DD; print \"D:exp: \"; dd $exp;"
NSQ_SOURCE_LINE 00000632 "    #use DD; say \"D:word:<$word>\";"
NSQ_SOURCE_LINE 00000633 ""
NSQ_SOURCE_LINE 00000634 "    my @answers;"
NSQ_SOURCE_LINE 00000635 ""
NSQ_SOURCE_LINE 00000636 "    # complete option names"
NSQ_SOURCE_LINE 00000637 "    {"
NSQ_SOURCE_LINE 00000638 "        last if $word =~ /\\A[^-]/;"
NSQ_SOURCE_LINE 00000639 "        last unless exists $exp->{optname};"
NSQ_SOURCE_LINE 00000640 "        last if defined($exp->{do_complete_optname}) &&"
NSQ_SOURCE_LINE 00000641 "            !$exp->{do_complete_optname};"
NSQ_SOURCE_LINE 00000642 "        if ($exp->{comp_result}) {"
NSQ_SOURCE_LINE 00000643 "            push @answers, $exp->{comp_result};"
NSQ_SOURCE_LINE 00000644 "            last;"
NSQ_SOURCE_LINE 00000645 "        }"
NSQ_SOURCE_LINE 00000646 "        #say \"D:completing option names\";"
NSQ_SOURCE_LINE 00000647 "        my $opt = $exp->{optname};"
NSQ_SOURCE_LINE 00000648 "        my @o;"
NSQ_SOURCE_LINE 00000649 "        my @osumms;"
NSQ_SOURCE_LINE 00000650 "        my $o_has_summaries;"
NSQ_SOURCE_LINE 00000651 "        for my $optname (@optnames) {"
NSQ_SOURCE_LINE 00000652 "            my $repeatable = 0;"
NSQ_SOURCE_LINE 00000653 "            next if $exp->{short_only} && $optname =~ /\\A--/;"
NSQ_SOURCE_LINE 00000654 "            if ($seen_opts{$optname}) {"
NSQ_SOURCE_LINE 00000655 "                my $opthash = $opts{$optname};"
NSQ_SOURCE_LINE 00000656 "                my $parsed = $opthash->{parsed};"
NSQ_SOURCE_LINE 00000657 "                my $dest = $opthash->{dest};"
NSQ_SOURCE_LINE 00000658 "                if (ref $dest eq 'ARRAY') {"
NSQ_SOURCE_LINE 00000659 "                    $repeatable = 1;"
NSQ_SOURCE_LINE 00000660 "                } elsif ($parsed->{desttype} || $parsed->{is_inc}) {"
NSQ_SOURCE_LINE 00000661 "                    $repeatable = 1;"
NSQ_SOURCE_LINE 00000662 "                }"
NSQ_SOURCE_LINE 00000663 "            }"
NSQ_SOURCE_LINE 00000664 "            # skip options that have been specified and not repeatable"
NSQ_SOURCE_LINE 00000665 "            #use DD; dd {'$_'=>$_, seen=>$seen_opts{$_}, repeatable=>$repeatable, opt=>$opt};"
NSQ_SOURCE_LINE 00000666 "            next if $seen_opts{$optname} && !$repeatable && ("
NSQ_SOURCE_LINE 00000667 "                # long option has been specified"
NSQ_SOURCE_LINE 00000668 "                (!$opt || $opt ne $optname) ||"
NSQ_SOURCE_LINE 00000669 "                     # short option (in a bundle) has been specified"
NSQ_SOURCE_LINE 00000670 "                    (defined($exp->{prefix}) &&"
NSQ_SOURCE_LINE 00000671 "                         index($exp->{prefix}, substr($opt, 1, 1)) >= 0));"
NSQ_SOURCE_LINE 00000672 "            if (defined $exp->{prefix}) {"
NSQ_SOURCE_LINE 00000673 "                my $o = $optname; $o =~ s/\\A-//;"
NSQ_SOURCE_LINE 00000674 "                push @o, \"$exp->{prefix}$o\";"
NSQ_SOURCE_LINE 00000675 "            } else {"
NSQ_SOURCE_LINE 00000676 "                push @o, $optname;"
NSQ_SOURCE_LINE 00000677 "            }"
NSQ_SOURCE_LINE 00000678 "            my $summ = $code_get_summary->($optname) // '';"
NSQ_SOURCE_LINE 00000679 "            if (length $summ) {"
NSQ_SOURCE_LINE 00000680 "                $o_has_summaries = 1;"
NSQ_SOURCE_LINE 00000681 "                push @osumms, $summ;"
NSQ_SOURCE_LINE 00000682 "            } else {"
NSQ_SOURCE_LINE 00000683 "                push @osumms, '';"
NSQ_SOURCE_LINE 00000684 "            }"
NSQ_SOURCE_LINE 00000685 "        }"
NSQ_SOURCE_LINE 00000686 "        #use DD; dd \\@o;"
NSQ_SOURCE_LINE 00000687 "        #use DD; dd \\@osumms;"
NSQ_SOURCE_LINE 00000688 "        my $compres = Complete::Util::complete_array_elem("
NSQ_SOURCE_LINE 00000689 "            array => \\@o, word => $word,"
NSQ_SOURCE_LINE 00000690 "            (summaries => \\@osumms) x !!$o_has_summaries,"
NSQ_SOURCE_LINE 00000691 "        );"
NSQ_SOURCE_LINE 00000692 "        log_trace('[compgl] adding result from option names, '."
NSQ_SOURCE_LINE 00000693 "                      'matching options=%s', $compres) if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000694 "        push @answers, $compres;"
NSQ_SOURCE_LINE 00000695 "        if (!exists($exp->{optval}) && !exists($exp->{arg})) {"
NSQ_SOURCE_LINE 00000696 "            $fres = {words=>$compres, esc_mode=>'option'};"
NSQ_SOURCE_LINE 00000697 "            goto RETURN_RES;"
NSQ_SOURCE_LINE 00000698 "        }"
NSQ_SOURCE_LINE 00000699 "    }"
NSQ_SOURCE_LINE 00000700 ""
NSQ_SOURCE_LINE 00000701 "    # complete option value"
NSQ_SOURCE_LINE 00000702 "    {"
NSQ_SOURCE_LINE 00000703 "        last unless exists($exp->{optval});"
NSQ_SOURCE_LINE 00000704 "        #say \"D:completing option value\";"
NSQ_SOURCE_LINE 00000705 "        my $opt = $exp->{optval};"
NSQ_SOURCE_LINE 00000706 "        my $opthash; $opthash = $opts{$opt} if $opt;"
NSQ_SOURCE_LINE 00000707 "        my %compargs = ("
NSQ_SOURCE_LINE 00000708 "            %$extras,"
NSQ_SOURCE_LINE 00000709 "            type=>'optval', words=>\\@words, cword=>$args{cword},"
NSQ_SOURCE_LINE 00000710 "            word=>$word, opt=>($opt // $exp->{possible_optnames}), ospec=>$opthash->{ospec},"
NSQ_SOURCE_LINE 00000711 "            argpos=>undef, nth=>$exp->{nth}, seen_opts=>\\%seen_opts,"
NSQ_SOURCE_LINE 00000712 "            parsed_opts=>\\%parsed_opts,"
NSQ_SOURCE_LINE 00000713 "        );"
NSQ_SOURCE_LINE 00000714 "        my $compres;"
NSQ_SOURCE_LINE 00000715 "        if ($comp) {"
NSQ_SOURCE_LINE 00000716 "            log_trace(\"[compgl] invoking routine supplied from 'completion' argument to complete option value, option=<%s>\", $opt) if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000717 "            $compres = $comp->(%compargs);"
NSQ_SOURCE_LINE 00000718 "            Complete::Util::modify_answer(answer=>$compres, prefix=>$exp->{prefix})"
NSQ_SOURCE_LINE 00000719 "                if defined $exp->{prefix};"
NSQ_SOURCE_LINE 00000720 "            log_trace('[compgl] adding result from routine: %s', $compres) if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000721 "        }"
NSQ_SOURCE_LINE 00000722 "        if (!$compres || !$comp) {"
NSQ_SOURCE_LINE 00000723 "            $compres = _default_completion(%compargs);"
NSQ_SOURCE_LINE 00000724 "            Complete::Util::modify_answer(answer=>$compres, prefix=>$exp->{prefix})"
NSQ_SOURCE_LINE 00000725 "                if defined $exp->{prefix};"
NSQ_SOURCE_LINE 00000726 "            log_trace('[compgl] adding result from default '."
NSQ_SOURCE_LINE 00000727 "                          'completion routine') if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000728 "        }"
NSQ_SOURCE_LINE 00000729 "        push @answers, $compres;"
NSQ_SOURCE_LINE 00000730 "    }"
NSQ_SOURCE_LINE 00000731 ""
NSQ_SOURCE_LINE 00000732 "    # complete argument"
NSQ_SOURCE_LINE 00000733 "    {"
NSQ_SOURCE_LINE 00000734 "        last unless exists($exp->{arg});"
NSQ_SOURCE_LINE 00000735 "        my %compargs = ("
NSQ_SOURCE_LINE 00000736 "            %$extras,"
NSQ_SOURCE_LINE 00000737 "            type=>'arg', words=>\\@words, cword=>$args{cword},"
NSQ_SOURCE_LINE 00000738 "            word=>$word, opt=>undef, ospec=>undef,"
NSQ_SOURCE_LINE 00000739 "            argpos=>$exp->{argpos}, seen_opts=>\\%seen_opts,"
NSQ_SOURCE_LINE 00000740 "            parsed_opts=>\\%parsed_opts,"
NSQ_SOURCE_LINE 00000741 "        );"
NSQ_SOURCE_LINE 00000742 "        log_trace('[compgl] invoking \\'completion\\' routine '."
NSQ_SOURCE_LINE 00000743 "                      'to complete argument') if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000744 "        my $compres; $compres = $comp->(%compargs) if $comp;"
NSQ_SOURCE_LINE 00000745 "        if (!defined $compres) {"
NSQ_SOURCE_LINE 00000746 "            $compres = _default_completion(%compargs);"
NSQ_SOURCE_LINE 00000747 "            log_trace('[compgl] adding result from default '."
NSQ_SOURCE_LINE 00000748 "                          'completion routine: %s', $compres) if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000749 "        }"
NSQ_SOURCE_LINE 00000750 "        push @answers, $compres;"
NSQ_SOURCE_LINE 00000751 "    }"
NSQ_SOURCE_LINE 00000752 ""
NSQ_SOURCE_LINE 00000753 "    log_trace(\"[compgl] combining result from %d source(s)\", scalar @answers) if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000754 "    $fres = Complete::Util::combine_answers(@answers) // [];"
NSQ_SOURCE_LINE 00000755 ""
NSQ_SOURCE_LINE 00000756 "  RETURN_RES:"
NSQ_SOURCE_LINE 00000757 "    log_trace(\"[compgl] leaving %s(), result=%s\", $fname, $fres) if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000758 "    $fres;"
NSQ_SOURCE_LINE 00000759 "}"
NSQ_SOURCE_LINE 00000760 ""
NSQ_SOURCE_LINE 00000761 "1;"
NSQ_SOURCE_LINE 00000762 "# ABSTRACT: Complete command-line argument using Getopt::Long specification"
NSQ_SOURCE_LINE 00000763 ""
NSQ_SOURCE_LINE 00000764 "__END__"
NSQ_SOURCE_LINE 00000765 ""
NSQ_SOURCE_LINE 00000766 "=pod"
NSQ_SOURCE_LINE 00000767 ""
NSQ_SOURCE_LINE 00000768 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000769 ""
NSQ_SOURCE_LINE 00000770 "=head1 NAME"
NSQ_SOURCE_LINE 00000771 ""
NSQ_SOURCE_LINE 00000772 "Complete::Getopt::Long - Complete command-line argument using Getopt::Long specification"
NSQ_SOURCE_LINE 00000773 ""
NSQ_SOURCE_LINE 00000774 "=head1 VERSION"
NSQ_SOURCE_LINE 00000775 ""
NSQ_SOURCE_LINE 00000776 "This document describes version 0.481 of Complete::Getopt::Long (from Perl distribution Complete-Getopt-Long), released on 2022-08-28."
NSQ_SOURCE_LINE 00000777 ""
NSQ_SOURCE_LINE 00000778 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000779 ""
NSQ_SOURCE_LINE 00000780 "See L<Getopt::Long::Complete> for an easy way to use this module."
NSQ_SOURCE_LINE 00000781 ""
NSQ_SOURCE_LINE 00000782 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000783 ""
NSQ_SOURCE_LINE 00000784 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000785 ""
NSQ_SOURCE_LINE 00000786 ""
NSQ_SOURCE_LINE 00000787 "=head2 complete_cli_arg"
NSQ_SOURCE_LINE 00000788 ""
NSQ_SOURCE_LINE 00000789 "Usage:"
NSQ_SOURCE_LINE 00000790 ""
NSQ_SOURCE_LINE 00000791 " complete_cli_arg(%args) -> hash|array"
NSQ_SOURCE_LINE 00000792 ""
NSQ_SOURCE_LINE 00000793 "Complete command-line argument using Getopt::Long specification."
NSQ_SOURCE_LINE 00000794 ""
NSQ_SOURCE_LINE 00000795 "This routine can complete option names, where the option names are retrieved"
NSQ_SOURCE_LINE 00000796 "from L<Getopt::Long> specification. If you provide completion routine in"
NSQ_SOURCE_LINE 00000797 "C<completion>, you can also complete I<option values> and I<arguments>."
NSQ_SOURCE_LINE 00000798 ""
NSQ_SOURCE_LINE 00000799 "Note that this routine does not use L<Getopt::Long> (it does its own parsing)"
NSQ_SOURCE_LINE 00000800 "and currently is not affected by Getopt::Long's configuration. Its behavior"
NSQ_SOURCE_LINE 00000801 "mimics Getopt::Long under these configuration: C<no_ignore_case>, C<bundling> (or"
NSQ_SOURCE_LINE 00000802 "C<no_bundling> if the C<bundling> option is turned off). Which I think is the"
NSQ_SOURCE_LINE 00000803 "sensible default. This routine also does not currently support C<auto_help> and"
NSQ_SOURCE_LINE 00000804 "C<auto_version>, so you'll need to add those options specifically if you want to"
NSQ_SOURCE_LINE 00000805 "recognize C<--help/-?> and C<--version>, respectively."
NSQ_SOURCE_LINE 00000806 ""
NSQ_SOURCE_LINE 00000807 "This function is not exported by default, but exportable."
NSQ_SOURCE_LINE 00000808 ""
NSQ_SOURCE_LINE 00000809 "Arguments ('*' denotes required arguments):"
NSQ_SOURCE_LINE 00000810 ""
NSQ_SOURCE_LINE 00000811 "=over 4"
NSQ_SOURCE_LINE 00000812 ""
NSQ_SOURCE_LINE 00000813 "=item * B<bundling> => I<bool> (default: 1)"
NSQ_SOURCE_LINE 00000814 ""
NSQ_SOURCE_LINE 00000815 "If you turn off bundling, completion of short-letter options won't support"
NSQ_SOURCE_LINE 00000816 "bundling (e.g. C<< -bE<lt>tabE<gt> >> won't add more single-letter options), but single-dash"
NSQ_SOURCE_LINE 00000817 "multiletter options can be recognized. Currently only those specified with a"
NSQ_SOURCE_LINE 00000818 "single dash will be completed. For example if you have C<-foo=s> in your option"
NSQ_SOURCE_LINE 00000819 "specification, C<< -fE<lt>tabE<gt> >> can complete it."
NSQ_SOURCE_LINE 00000820 ""
NSQ_SOURCE_LINE 00000821 "This can be used to complete old-style programs, e.g. emacs which has options"
NSQ_SOURCE_LINE 00000822 "like C<-nw>, C<-nbc> etc (but also have double-dash options like"
NSQ_SOURCE_LINE 00000823 "C<--no-window-system> or C<--no-blinking-cursor>)."
NSQ_SOURCE_LINE 00000824 ""
NSQ_SOURCE_LINE 00000825 "=item * B<completion> => I<code>"
NSQ_SOURCE_LINE 00000826 ""
NSQ_SOURCE_LINE 00000827 "Completion routine to complete option valueE<sol>argument."
NSQ_SOURCE_LINE 00000828 ""
NSQ_SOURCE_LINE 00000829 "Completion code will receive a hash of arguments (C<%args>) containing these"
NSQ_SOURCE_LINE 00000830 "keys:"
NSQ_SOURCE_LINE 00000831 ""
NSQ_SOURCE_LINE 00000832 "=over"
NSQ_SOURCE_LINE 00000833 ""
NSQ_SOURCE_LINE 00000834 "=item * C<type> (str, what is being completed, either C<optval>, or C<arg>)"
NSQ_SOURCE_LINE 00000835 ""
NSQ_SOURCE_LINE 00000836 "=item * C<word> (str, word to be completed)"
NSQ_SOURCE_LINE 00000837 ""
NSQ_SOURCE_LINE 00000838 "=item * C<cword> (int, position of words in the words array, starts from 0)"
NSQ_SOURCE_LINE 00000839 ""
NSQ_SOURCE_LINE 00000840 "=item * C<opt> (str, option name, e.g. C<--str>; undef if we're completing argument)"
NSQ_SOURCE_LINE 00000841 ""
NSQ_SOURCE_LINE 00000842 "=item * C<ospec> (str, Getopt::Long option spec, e.g. C<str|S=s>; undef when completing"
NSQ_SOURCE_LINE 00000843 "argument)"
NSQ_SOURCE_LINE 00000844 ""
NSQ_SOURCE_LINE 00000845 "=item * C<argpos> (int, argument position, zero-based; undef if type='optval')"
NSQ_SOURCE_LINE 00000846 ""
NSQ_SOURCE_LINE 00000847 "=item * C<nth> (int, the number of times this option has seen before, starts from 0"
NSQ_SOURCE_LINE 00000848 "that means this is the first time this option has been seen; undef when"
NSQ_SOURCE_LINE 00000849 "type='arg')"
NSQ_SOURCE_LINE 00000850 ""
NSQ_SOURCE_LINE 00000851 "=item * C<seen_opts> (hash, all the options seen in C<words>)"
NSQ_SOURCE_LINE 00000852 ""
NSQ_SOURCE_LINE 00000853 "=item * C<parsed_opts> (hash, options parsed the standard/raw way)"
NSQ_SOURCE_LINE 00000854 ""
NSQ_SOURCE_LINE 00000855 "=back"
NSQ_SOURCE_LINE 00000856 ""
NSQ_SOURCE_LINE 00000857 "as well as all keys from C<extras> (but these won't override the above keys)."
NSQ_SOURCE_LINE 00000858 ""
NSQ_SOURCE_LINE 00000859 "and is expected to return a completion answer structure as described in"
NSQ_SOURCE_LINE 00000860 "C<Complete> which is either a hash or an array. The simplest form of answer is"
NSQ_SOURCE_LINE 00000861 "just to return an array of strings. The various C<complete_*> function like those"
NSQ_SOURCE_LINE 00000862 "in L<Complete::Util> or the other C<Complete::*> modules are suitable to use"
NSQ_SOURCE_LINE 00000863 "here."
NSQ_SOURCE_LINE 00000864 ""
NSQ_SOURCE_LINE 00000865 "Completion routine can also return undef to express declination, in which case"
NSQ_SOURCE_LINE 00000866 "the default completion routine will then be consulted. The default routine"
NSQ_SOURCE_LINE 00000867 "completes from shell environment variables (C<$FOO>), Unix usernames (C<~foo>),"
NSQ_SOURCE_LINE 00000868 "and files/directories."
NSQ_SOURCE_LINE 00000869 ""
NSQ_SOURCE_LINE 00000870 "Example:"
NSQ_SOURCE_LINE 00000871 ""
NSQ_SOURCE_LINE 00000872 " use Complete::Unix qw(complete_user);"
NSQ_SOURCE_LINE 00000873 " use Complete::Util qw(complete_array_elem);"
NSQ_SOURCE_LINE 00000874 " complete_cli_arg("
NSQ_SOURCE_LINE 00000875 "     getopt_spec => ["
NSQ_SOURCE_LINE 00000876 "         'help|h'   => sub{...},"
NSQ_SOURCE_LINE 00000877 "         'format=s' => \\$format,"
NSQ_SOURCE_LINE 00000878 "         'user=s'   => \\$user,"
NSQ_SOURCE_LINE 00000879 "     ],"
NSQ_SOURCE_LINE 00000880 "     completion  => sub {"
NSQ_SOURCE_LINE 00000881 "         my %args  = @_;"
NSQ_SOURCE_LINE 00000882 "         my $word  = $args{word};"
NSQ_SOURCE_LINE 00000883 "         my $ospec = $args{ospec};"
NSQ_SOURCE_LINE 00000884 "         if ($ospec && $ospec eq 'format=s') {"
NSQ_SOURCE_LINE 00000885 "             complete_array_elem(array=>[qw/json text xml yaml/], word=>$word);"
NSQ_SOURCE_LINE 00000886 "         } else {"
NSQ_SOURCE_LINE 00000887 "             complete_user(word=>$word);"
NSQ_SOURCE_LINE 00000888 "         }"
NSQ_SOURCE_LINE 00000889 "     },"
NSQ_SOURCE_LINE 00000890 " );"
NSQ_SOURCE_LINE 00000891 ""
NSQ_SOURCE_LINE 00000892 "=item * B<cword>* => I<int>"
NSQ_SOURCE_LINE 00000893 ""
NSQ_SOURCE_LINE 00000894 "Index in words of the word we're trying to complete."
NSQ_SOURCE_LINE 00000895 ""
NSQ_SOURCE_LINE 00000896 "See function C<parse_cmdline> in L<Complete::Bash> on how to produce this (if"
NSQ_SOURCE_LINE 00000897 "you're using bash)."
NSQ_SOURCE_LINE 00000898 ""
NSQ_SOURCE_LINE 00000899 "=item * B<extras> => I<hash>"
NSQ_SOURCE_LINE 00000900 ""
NSQ_SOURCE_LINE 00000901 "Add extra arguments to completion routine."
NSQ_SOURCE_LINE 00000902 ""
NSQ_SOURCE_LINE 00000903 "The keys from this C<extras> hash will be merged into the final C<%args> passed to"
NSQ_SOURCE_LINE 00000904 "completion routines. Note that standard keys like C<type>, C<word>, and so on as"
NSQ_SOURCE_LINE 00000905 "described in the function description will not be overwritten by this."
NSQ_SOURCE_LINE 00000906 ""
NSQ_SOURCE_LINE 00000907 "=item * B<getopt_spec>* => I<array>"
NSQ_SOURCE_LINE 00000908 ""
NSQ_SOURCE_LINE 00000909 "Getopt::Long specification."
NSQ_SOURCE_LINE 00000910 ""
NSQ_SOURCE_LINE 00000911 "=item * B<words>* => I<array>"
NSQ_SOURCE_LINE 00000912 ""
NSQ_SOURCE_LINE 00000913 "Command line arguments, like @ARGV."
NSQ_SOURCE_LINE 00000914 ""
NSQ_SOURCE_LINE 00000915 "See function C<parse_cmdline> in L<Complete::Bash> on how to produce this (if"
NSQ_SOURCE_LINE 00000916 "you're using bash)."
NSQ_SOURCE_LINE 00000917 ""
NSQ_SOURCE_LINE 00000918 ""
NSQ_SOURCE_LINE 00000919 "=back"
NSQ_SOURCE_LINE 00000920 ""
NSQ_SOURCE_LINE 00000921 "Return value:  (hash|array)"
NSQ_SOURCE_LINE 00000922 ""
NSQ_SOURCE_LINE 00000923 ""
NSQ_SOURCE_LINE 00000924 "You can use C<format_completion> function in L<Complete::Bash> module to format"
NSQ_SOURCE_LINE 00000925 "the result of this function for bash."
NSQ_SOURCE_LINE 00000926 ""
NSQ_SOURCE_LINE 00000927 "=head1 ENVIRONMENT"
NSQ_SOURCE_LINE 00000928 ""
NSQ_SOURCE_LINE 00000929 "=head2 COMPLETE_GETOPT_LONG_TRACE"
NSQ_SOURCE_LINE 00000930 ""
NSQ_SOURCE_LINE 00000931 "Bool. If set to true, will generated more log statements for debugging (at the"
NSQ_SOURCE_LINE 00000932 "trace level)."
NSQ_SOURCE_LINE 00000933 ""
NSQ_SOURCE_LINE 00000934 "=head2 COMPLETE_GETOPT_LONG_DEFAULT_ENV"
NSQ_SOURCE_LINE 00000935 ""
NSQ_SOURCE_LINE 00000936 "Bool. Default true. Can be set to false to disable completing from environment"
NSQ_SOURCE_LINE 00000937 "variable in default completion."
NSQ_SOURCE_LINE 00000938 ""
NSQ_SOURCE_LINE 00000939 "=head2 COMPLETE_GETOPT_LONG_DEFAULT_FILE"
NSQ_SOURCE_LINE 00000940 ""
NSQ_SOURCE_LINE 00000941 "Bool. Default true. Can be set to false to disable completing from filesystem"
NSQ_SOURCE_LINE 00000942 "(file and directory names) in default completion."
NSQ_SOURCE_LINE 00000943 ""
NSQ_SOURCE_LINE 00000944 "=head1 HOMEPAGE"
NSQ_SOURCE_LINE 00000945 ""
NSQ_SOURCE_LINE 00000946 "Please visit the project's homepage at L<https://metacpan.org/release/Complete-Getopt-Long>."
NSQ_SOURCE_LINE 00000947 ""
NSQ_SOURCE_LINE 00000948 "=head1 SOURCE"
NSQ_SOURCE_LINE 00000949 ""
NSQ_SOURCE_LINE 00000950 "Source repository is at L<https://github.com/perlancar/perl-Complete-Getopt-Long>."
NSQ_SOURCE_LINE 00000951 ""
NSQ_SOURCE_LINE 00000952 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000953 ""
NSQ_SOURCE_LINE 00000954 "L<Getopt::Long::Complete>"
NSQ_SOURCE_LINE 00000955 ""
NSQ_SOURCE_LINE 00000956 "L<Complete>"
NSQ_SOURCE_LINE 00000957 ""
NSQ_SOURCE_LINE 00000958 "L<Complete::Bash>"
NSQ_SOURCE_LINE 00000959 ""
NSQ_SOURCE_LINE 00000960 "Other modules related to bash shell tab completion: L<Bash::Completion>,"
NSQ_SOURCE_LINE 00000961 "L<Getopt::Complete>."
NSQ_SOURCE_LINE 00000962 ""
NSQ_SOURCE_LINE 00000963 "L<Perinci::CmdLine> - an alternative way to easily create command-line"
NSQ_SOURCE_LINE 00000964 "applications with completion feature."
NSQ_SOURCE_LINE 00000965 ""
NSQ_SOURCE_LINE 00000966 "=head1 AUTHOR"
