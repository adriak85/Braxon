NSQ_SOURCE_LINE 00000001 "package Complete::Getopt::Long;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use 5.010001;"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use Log::ger;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Exporter 'import';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our $AUTHORITY = 'cpan:PERLANCAR'; # AUTHORITY"
NSQ_SOURCE_LINE 00000011 "our $DATE = '2022-08-28'; # DATE"
NSQ_SOURCE_LINE 00000012 "our $DIST = 'Complete-Getopt-Long'; # DIST"
NSQ_SOURCE_LINE 00000013 "our $VERSION = '0.481'; # VERSION"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "our @EXPORT_OK = qw("
NSQ_SOURCE_LINE 00000016 "                       complete_cli_arg"
NSQ_SOURCE_LINE 00000017 "               );"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "our %SPEC;"
NSQ_SOURCE_LINE 00000020 ""
NSQ_SOURCE_LINE 00000021 "our $COMPLETE_GETOPT_LONG_TRACE=$ENV{COMPLETE_GETOPT_LONG_TRACE} // 0;"
NSQ_SOURCE_LINE 00000022 "our $COMPLETE_GETOPT_LONG_DEFAULT_ENV = $ENV{COMPLETE_GETOPT_LONG_DEFAULT_ENV} // 1;"
NSQ_SOURCE_LINE 00000023 "our $COMPLETE_GETOPT_LONG_DEFAULT_FILE = $ENV{COMPLETE_GETOPT_LONG_DEFAULT_FILE} // 1;"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub _default_completion {"
NSQ_SOURCE_LINE 00000026 "    require Complete::Env;"
NSQ_SOURCE_LINE 00000027 "    require Complete::File;"
NSQ_SOURCE_LINE 00000028 "    require Complete::Util;"
NSQ_SOURCE_LINE 00000029 ""
NSQ_SOURCE_LINE 00000030 "    my %args = @_;"
NSQ_SOURCE_LINE 00000031 "    my $word = $args{word} // '';"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "    my $fres;"
NSQ_SOURCE_LINE 00000034 "    log_trace('[compgl] entering default completion routine') if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "    # try completing '$...' with shell variables"
NSQ_SOURCE_LINE 00000037 "    if ($word =~ /\\A\\$/ && $COMPLETE_GETOPT_LONG_DEFAULT_ENV) {"
NSQ_SOURCE_LINE 00000038 "        log_trace('[compgl] completing shell variable') if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000039 "        {"
NSQ_SOURCE_LINE 00000040 "            my $compres = Complete::Env::complete_env("
NSQ_SOURCE_LINE 00000041 "                word=>$word);"
NSQ_SOURCE_LINE 00000042 "            last unless @$compres;"
NSQ_SOURCE_LINE 00000043 "            $fres = {words=>$compres, esc_mode=>'shellvar'};"
NSQ_SOURCE_LINE 00000044 "            goto RETURN_RES;"
NSQ_SOURCE_LINE 00000045 "        }"
NSQ_SOURCE_LINE 00000046 "        # if empty, fallback to searching file"
NSQ_SOURCE_LINE 00000047 "    }"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    # try completing '~foo' with user dir (appending / if user's home exists)"
NSQ_SOURCE_LINE 00000050 "    if ($word =~ m!\\A~([^/]*)\\z! && $COMPLETE_GETOPT_LONG_DEFAULT_FILE) {"
NSQ_SOURCE_LINE 00000051 "        log_trace(\"[compgl] completing userdir, user=%s\", $1) if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000052 "        {"
NSQ_SOURCE_LINE 00000053 "            eval { require Unix::Passwd::File };"
NSQ_SOURCE_LINE 00000054 "            last if $@;"
NSQ_SOURCE_LINE 00000055 "            my $res = Unix::Passwd::File::list_users(detail=>1);"
NSQ_SOURCE_LINE 00000056 "            last unless $res->[0] == 200;"
NSQ_SOURCE_LINE 00000057 "            my $compres = Complete::Util::complete_array_elem("
NSQ_SOURCE_LINE 00000058 "                array=>[map {\"~\" . $_->{user} . ((-d $_->{home}) ? \"/\":\"\")}"
NSQ_SOURCE_LINE 00000059 "                            @{ $res->[2] }],"
NSQ_SOURCE_LINE 00000060 "                word=>$word,"
NSQ_SOURCE_LINE 00000061 "            );"
NSQ_SOURCE_LINE 00000062 "            last unless @$compres;"
NSQ_SOURCE_LINE 00000063 "            $fres = {words=>$compres, path_sep=>'/'};"
NSQ_SOURCE_LINE 00000064 "            goto RETURN_RES;"
NSQ_SOURCE_LINE 00000065 "        }"
NSQ_SOURCE_LINE 00000066 "        # if empty, fallback to searching file"
NSQ_SOURCE_LINE 00000067 "    }"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "    # try completing '~/blah' or '~foo/blah' as if completing file, but do not"
NSQ_SOURCE_LINE 00000070 "    # expand ~foo (this is supported by complete_file(), so we just give it off"
NSQ_SOURCE_LINE 00000071 "    # to the routine)"
NSQ_SOURCE_LINE 00000072 "    if ($word =~ m!\\A(~[^/]*)/! && $COMPLETE_GETOPT_LONG_DEFAULT_FILE) {"
NSQ_SOURCE_LINE 00000073 "        log_trace(\"[compgl] completing file, path=<%s>\", $word) if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000074 "        $fres = Complete::Util::hashify_answer("
NSQ_SOURCE_LINE 00000075 "            Complete::File::complete_file(word=>$word),"
NSQ_SOURCE_LINE 00000076 "            {path_sep=>'/'}"
NSQ_SOURCE_LINE 00000077 "        );"
NSQ_SOURCE_LINE 00000078 "        goto RETURN_RES;"
NSQ_SOURCE_LINE 00000079 "    }"
NSQ_SOURCE_LINE 00000080 ""
NSQ_SOURCE_LINE 00000081 "    # try completing something that contains wildcard with glob. for"
NSQ_SOURCE_LINE 00000082 "    # convenience, we add '*' at the end so that when user type [AB] it is"
NSQ_SOURCE_LINE 00000083 "    # treated like [AB]*."
NSQ_SOURCE_LINE 00000084 "    require String::Wildcard::Bash;"
NSQ_SOURCE_LINE 00000085 "    if (String::Wildcard::Bash::contains_wildcard($word) && $COMPLETE_GETOPT_LONG_DEFAULT_FILE) {"
NSQ_SOURCE_LINE 00000086 "        log_trace(\"[compgl] completing with wildcard glob, glob=<%s>\", \"$word*\") if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000087 "        {"
NSQ_SOURCE_LINE 00000088 "            my $compres = [glob(\"$word*\")];"
NSQ_SOURCE_LINE 00000089 "            last unless @$compres;"
NSQ_SOURCE_LINE 00000090 "            for (@$compres) {"
NSQ_SOURCE_LINE 00000091 "                $_ .= \"/\" if (-d $_);"
NSQ_SOURCE_LINE 00000092 "            }"
NSQ_SOURCE_LINE 00000093 "            $fres = {words=>$compres, path_sep=>'/'};"
NSQ_SOURCE_LINE 00000094 "            goto RETURN_RES;"
NSQ_SOURCE_LINE 00000095 "        }"
NSQ_SOURCE_LINE 00000096 "        # if empty, fallback to searching file"
NSQ_SOURCE_LINE 00000097 "    }"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "    if ($COMPLETE_GETOPT_LONG_DEFAULT_FILE) {"
NSQ_SOURCE_LINE 00000100 "        log_trace(\"[compgl] completing with file, file=<%s>\", $word) if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000101 "        $fres = Complete::Util::hashify_answer("
NSQ_SOURCE_LINE 00000102 "            Complete::File::complete_file(word=>$word),"
NSQ_SOURCE_LINE 00000103 "            {path_sep=>'/'}"
NSQ_SOURCE_LINE 00000104 "        );"
NSQ_SOURCE_LINE 00000105 "    }"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "  RETURN_RES:"
NSQ_SOURCE_LINE 00000108 "    log_trace(\"[compgl] leaving default completion routine, result=%s\", $fres) if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000109 "    $fres;"
NSQ_SOURCE_LINE 00000110 "}"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "# return the possible options. if there is only one candidate (unambiguous"
NSQ_SOURCE_LINE 00000113 "# expansion) then scalar will be returned. otherwise, an array of candidates"
NSQ_SOURCE_LINE 00000114 "# will be returned."
NSQ_SOURCE_LINE 00000115 "sub _matching_opts {"
NSQ_SOURCE_LINE 00000116 "    my ($opt, $opts) = @_;"
NSQ_SOURCE_LINE 00000117 "    my %candidates;"
NSQ_SOURCE_LINE 00000118 "    for (sort {length($a)<=>length($b)} keys %$opts) {"
NSQ_SOURCE_LINE 00000119 "        next unless index($_, $opt) == 0;"
NSQ_SOURCE_LINE 00000120 "        $candidates{$_} = $opts->{$_};"
NSQ_SOURCE_LINE 00000121 "        last if $opt eq $_;"
NSQ_SOURCE_LINE 00000122 "    }"
NSQ_SOURCE_LINE 00000123 "    \\%candidates;"
NSQ_SOURCE_LINE 00000124 "}"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "# mark an option (and all its aliases) as seen"
NSQ_SOURCE_LINE 00000127 "sub _mark_seen {"
NSQ_SOURCE_LINE 00000128 "    my ($seen_opts, $opt, $opts) = @_;"
NSQ_SOURCE_LINE 00000129 "    my $opthash = $opts->{$opt};"
NSQ_SOURCE_LINE 00000130 "    return unless $opthash;"
NSQ_SOURCE_LINE 00000131 "    my $ospec = $opthash->{ospec};"
NSQ_SOURCE_LINE 00000132 "    for (keys %$opts) {"
NSQ_SOURCE_LINE 00000133 "        my $v = $opts->{$_};"
NSQ_SOURCE_LINE 00000134 "        $seen_opts->{$_}++ if $v->{ospec} eq $ospec;"
NSQ_SOURCE_LINE 00000135 "    }"
NSQ_SOURCE_LINE 00000136 "}"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "$SPEC{complete_cli_arg} = {"
NSQ_SOURCE_LINE 00000139 "    v => 1.1,"
NSQ_SOURCE_LINE 00000140 "    summary => 'Complete command-line argument using '."
NSQ_SOURCE_LINE 00000141 "        'Getopt::Long specification',"
NSQ_SOURCE_LINE 00000142 "    description => <<'_',"
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "This routine can complete option names, where the option names are retrieved"
NSQ_SOURCE_LINE 00000145 "from <pm:Getopt::Long> specification. If you provide completion routine in"
NSQ_SOURCE_LINE 00000146 "`completion`, you can also complete _option values_ and _arguments_."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "Note that this routine does not use <pm:Getopt::Long> (it does its own parsing)"
NSQ_SOURCE_LINE 00000149 "and currently is not affected by Getopt::Long's configuration. Its behavior"
NSQ_SOURCE_LINE 00000150 "mimics Getopt::Long under these configuration: `no_ignore_case`, `bundling` (or"
NSQ_SOURCE_LINE 00000151 "`no_bundling` if the `bundling` option is turned off). Which I think is the"
NSQ_SOURCE_LINE 00000152 "sensible default. This routine also does not currently support `auto_help` and"
NSQ_SOURCE_LINE 00000153 "`auto_version`, so you'll need to add those options specifically if you want to"
NSQ_SOURCE_LINE 00000154 "recognize `--help/-?` and `--version`, respectively."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "_"
NSQ_SOURCE_LINE 00000157 "    args => {"
NSQ_SOURCE_LINE 00000158 "        getopt_spec => {"
NSQ_SOURCE_LINE 00000159 "            summary => 'Getopt::Long specification',"
NSQ_SOURCE_LINE 00000160 "            schema  => 'array*',"
NSQ_SOURCE_LINE 00000161 "            req     => 1,"
NSQ_SOURCE_LINE 00000162 "        },"
NSQ_SOURCE_LINE 00000163 "        completion => {"
NSQ_SOURCE_LINE 00000164 "            summary     =>"
NSQ_SOURCE_LINE 00000165 "                'Completion routine to complete option value/argument',"
NSQ_SOURCE_LINE 00000166 "            schema      => 'code*',"
NSQ_SOURCE_LINE 00000167 "            description => <<'_',"
NSQ_SOURCE_LINE 00000168 ""
NSQ_SOURCE_LINE 00000169 "Completion code will receive a hash of arguments (`%args`) containing these"
NSQ_SOURCE_LINE 00000170 "keys:"
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "* `type` (str, what is being completed, either `optval`, or `arg`)"
NSQ_SOURCE_LINE 00000173 "* `word` (str, word to be completed)"
NSQ_SOURCE_LINE 00000174 "* `cword` (int, position of words in the words array, starts from 0)"
NSQ_SOURCE_LINE 00000175 "* `opt` (str, option name, e.g. `--str`; undef if we're completing argument)"
NSQ_SOURCE_LINE 00000176 "* `ospec` (str, Getopt::Long option spec, e.g. `str|S=s`; undef when completing"
NSQ_SOURCE_LINE 00000177 "  argument)"
NSQ_SOURCE_LINE 00000178 "* `argpos` (int, argument position, zero-based; undef if type='optval')"
NSQ_SOURCE_LINE 00000179 "* `nth` (int, the number of times this option has seen before, starts from 0"
NSQ_SOURCE_LINE 00000180 "  that means this is the first time this option has been seen; undef when"
NSQ_SOURCE_LINE 00000181 "  type='arg')"
NSQ_SOURCE_LINE 00000182 "* `seen_opts` (hash, all the options seen in `words`)"
NSQ_SOURCE_LINE 00000183 "* `parsed_opts` (hash, options parsed the standard/raw way)"
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "as well as all keys from `extras` (but these won't override the above keys)."
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "and is expected to return a completion answer structure as described in"
NSQ_SOURCE_LINE 00000188 "`Complete` which is either a hash or an array. The simplest form of answer is"
NSQ_SOURCE_LINE 00000189 "just to return an array of strings. The various `complete_*` function like those"
NSQ_SOURCE_LINE 00000190 "in <pm:Complete::Util> or the other `Complete::*` modules are suitable to use"
NSQ_SOURCE_LINE 00000191 "here."
NSQ_SOURCE_LINE 00000192 ""
NSQ_SOURCE_LINE 00000193 "Completion routine can also return undef to express declination, in which case"
NSQ_SOURCE_LINE 00000194 "the default completion routine will then be consulted. The default routine"
NSQ_SOURCE_LINE 00000195 "completes from shell environment variables (`$FOO`), Unix usernames (`~foo`),"
NSQ_SOURCE_LINE 00000196 "and files/directories."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "Example:"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "    use Complete::Unix qw(complete_user);"
NSQ_SOURCE_LINE 00000201 "    use Complete::Util qw(complete_array_elem);"
NSQ_SOURCE_LINE 00000202 "    complete_cli_arg("
NSQ_SOURCE_LINE 00000203 "        getopt_spec => ["
NSQ_SOURCE_LINE 00000204 "            'help|h'   => sub{...},"
NSQ_SOURCE_LINE 00000205 "            'format=s' => \\$format,"
NSQ_SOURCE_LINE 00000206 "            'user=s'   => \\$user,"
NSQ_SOURCE_LINE 00000207 "        ],"
NSQ_SOURCE_LINE 00000208 "        completion  => sub {"
NSQ_SOURCE_LINE 00000209 "            my %args  = @_;"
NSQ_SOURCE_LINE 00000210 "            my $word  = $args{word};"
NSQ_SOURCE_LINE 00000211 "            my $ospec = $args{ospec};"
NSQ_SOURCE_LINE 00000212 "            if ($ospec && $ospec eq 'format=s') {"
NSQ_SOURCE_LINE 00000213 "                complete_array_elem(array=>[qw/json text xml yaml/], word=>$word);"
NSQ_SOURCE_LINE 00000214 "            } else {"
NSQ_SOURCE_LINE 00000215 "                complete_user(word=>$word);"
NSQ_SOURCE_LINE 00000216 "            }"
NSQ_SOURCE_LINE 00000217 "        },"
NSQ_SOURCE_LINE 00000218 "    );"
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "_"
NSQ_SOURCE_LINE 00000221 "        },"
NSQ_SOURCE_LINE 00000222 "        words => {"
NSQ_SOURCE_LINE 00000223 "            summary     => 'Command line arguments, like @ARGV',"
NSQ_SOURCE_LINE 00000224 "            description => <<'_',"
NSQ_SOURCE_LINE 00000225 ""
NSQ_SOURCE_LINE 00000226 "See function `parse_cmdline` in <pm:Complete::Bash> on how to produce this (if"
NSQ_SOURCE_LINE 00000227 "you're using bash)."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "_"
NSQ_SOURCE_LINE 00000230 "            schema      => 'array*',"
NSQ_SOURCE_LINE 00000231 "            req         => 1,"
NSQ_SOURCE_LINE 00000232 "        },"
NSQ_SOURCE_LINE 00000233 "        cword => {"
NSQ_SOURCE_LINE 00000234 "            summary     =>"
NSQ_SOURCE_LINE 00000235 "                \"Index in words of the word we're trying to complete\","
NSQ_SOURCE_LINE 00000236 "            description => <<'_',"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "See function `parse_cmdline` in <pm:Complete::Bash> on how to produce this (if"
NSQ_SOURCE_LINE 00000239 "you're using bash)."
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "_"
NSQ_SOURCE_LINE 00000242 "            schema      => 'int*',"
NSQ_SOURCE_LINE 00000243 "            req         => 1,"
NSQ_SOURCE_LINE 00000244 "        },"
NSQ_SOURCE_LINE 00000245 "        extras => {"
NSQ_SOURCE_LINE 00000246 "            summary => 'Add extra arguments to completion routine',"
NSQ_SOURCE_LINE 00000247 "            schema  => 'hash',"
NSQ_SOURCE_LINE 00000248 "            description => <<'_',"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "The keys from this `extras` hash will be merged into the final `%args` passed to"
NSQ_SOURCE_LINE 00000251 "completion routines. Note that standard keys like `type`, `word`, and so on as"
NSQ_SOURCE_LINE 00000252 "described in the function description will not be overwritten by this."
NSQ_SOURCE_LINE 00000253 ""
NSQ_SOURCE_LINE 00000254 "_"
NSQ_SOURCE_LINE 00000255 "        },"
NSQ_SOURCE_LINE 00000256 "        bundling => {"
NSQ_SOURCE_LINE 00000257 "            schema  => 'bool*',"
NSQ_SOURCE_LINE 00000258 "            default => 1,"
NSQ_SOURCE_LINE 00000259 "            'summary.alt.bool.not' => 'Turn off bundling',"
NSQ_SOURCE_LINE 00000260 "            description => <<'_',"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "If you turn off bundling, completion of short-letter options won't support"
NSQ_SOURCE_LINE 00000263 "bundling (e.g. `-b<tab>` won't add more single-letter options), but single-dash"
NSQ_SOURCE_LINE 00000264 "multiletter options can be recognized. Currently only those specified with a"
NSQ_SOURCE_LINE 00000265 "single dash will be completed. For example if you have `-foo=s` in your option"
NSQ_SOURCE_LINE 00000266 "specification, `-f<tab>` can complete it."
NSQ_SOURCE_LINE 00000267 ""
NSQ_SOURCE_LINE 00000268 "This can be used to complete old-style programs, e.g. emacs which has options"
NSQ_SOURCE_LINE 00000269 "like `-nw`, `-nbc` etc (but also have double-dash options like"
NSQ_SOURCE_LINE 00000270 "`--no-window-system` or `--no-blinking-cursor`)."
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "_"
NSQ_SOURCE_LINE 00000273 "        },"
NSQ_SOURCE_LINE 00000274 "    },"
NSQ_SOURCE_LINE 00000275 "    result_naked => 1,"
NSQ_SOURCE_LINE 00000276 "    result => {"
NSQ_SOURCE_LINE 00000277 "        schema => ['any*' => of => ['hash*', 'array*']],"
NSQ_SOURCE_LINE 00000278 "        description => <<'_',"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "You can use `format_completion` function in <pm:Complete::Bash> module to format"
NSQ_SOURCE_LINE 00000281 "the result of this function for bash."
NSQ_SOURCE_LINE 00000282 ""
NSQ_SOURCE_LINE 00000283 "_"
NSQ_SOURCE_LINE 00000284 "    },"
NSQ_SOURCE_LINE 00000285 "};"
NSQ_SOURCE_LINE 00000286 "sub complete_cli_arg {"
NSQ_SOURCE_LINE 00000287 "    require Complete::Util;"
NSQ_SOURCE_LINE 00000288 "    require Getopt::Long::Util;"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "    my %args = @_;"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "    my $fname = __PACKAGE__ . \"::complete_cli_arg\"; # XXX use __SUB__"
NSQ_SOURCE_LINE 00000293 "    my $fres;"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "    $args{words} or die \"Please specify words\";"
NSQ_SOURCE_LINE 00000296 "    my @words = @{ $args{words} };"
NSQ_SOURCE_LINE 00000297 "    defined(my $cword = $args{cword}) or die \"Please specify cword\";"
NSQ_SOURCE_LINE 00000298 "    my $gospec = $args{getopt_spec} or die \"Please specify getopt_spec\";"
NSQ_SOURCE_LINE 00000299 "    my $comp = $args{completion};"
NSQ_SOURCE_LINE 00000300 "    my $extras = $args{extras} // {};"
NSQ_SOURCE_LINE 00000301 "    my $bundling = $args{bundling} // 1;"
NSQ_SOURCE_LINE 00000302 "    my %parsed_opts;"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "    # backward compatibility: gospec was expected to be a hash, now an array"
NSQ_SOURCE_LINE 00000305 "    if (ref $gospec eq 'HASH') {"
NSQ_SOURCE_LINE 00000306 "        my $ary_gospec = [];"
NSQ_SOURCE_LINE 00000307 "        for (keys %$gospec) {"
NSQ_SOURCE_LINE 00000308 "            push @$ary_gospec, $_;"
NSQ_SOURCE_LINE 00000309 "            push @$ary_gospec, $gospec->{$_} if ref $gospec->{$_};"
NSQ_SOURCE_LINE 00000310 "        }"
NSQ_SOURCE_LINE 00000311 "        $gospec = $ary_gospec;"
NSQ_SOURCE_LINE 00000312 "    }"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "    log_trace('[compgl] entering %s(), words=%s, cword=%d, word=<%s>',"
NSQ_SOURCE_LINE 00000315 "              $fname, \\@words, $cword, $words[$cword]) if $COMPLETE_GETOPT_LONG_TRACE;"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "    # strip hash storage from getopt_spec"
NSQ_SOURCE_LINE 00000318 "    shift @$gospec if ref $gospec->[0] eq 'HASH';"
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "    # parse all options first & supply default completion routine"
NSQ_SOURCE_LINE 00000321 "    my %opts;"
NSQ_SOURCE_LINE 00000322 "    my $i = -1;"
NSQ_SOURCE_LINE 00000323 "    while (++$i <= $#{$gospec}) {"
NSQ_SOURCE_LINE 00000324 "        my $ospec = $gospec->[$i];"
NSQ_SOURCE_LINE 00000325 "        my $dest  = $i+1 <= $#{$gospec} && ref $gospec->[$i+1] ?"
NSQ_SOURCE_LINE 00000326 "            splice(@$gospec, $i+1, 1) : undef;"
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "        my $res = Getopt::Long::Util::parse_getopt_long_opt_spec($ospec)"
NSQ_SOURCE_LINE 00000329 "            or die \"Can't parse option spec '$ospec'\";"
NSQ_SOURCE_LINE 00000330 "        next if $res->{is_arg};"
NSQ_SOURCE_LINE 00000331 "        $res->{min_vals} //= $res->{type} ? 1 : 0;"
NSQ_SOURCE_LINE 00000332 "        $res->{max_vals} //= $res->{type} || $res->{opttype} ? 1:0;"
NSQ_SOURCE_LINE 00000333 "        for my $o0 (@{ $res->{opts} }) {"
NSQ_SOURCE_LINE 00000334 "            my @ary = $res->{is_neg} && length($o0) > 1 ?"
NSQ_SOURCE_LINE 00000335 "                ([$o0, 0], [\"no$o0\",1], [\"no-$o0\",1]) : ([$o0,0]);"
NSQ_SOURCE_LINE 00000336 "            for my $elem (@ary) {"
NSQ_SOURCE_LINE 00000337 "                my $o = $elem->[0];"
NSQ_SOURCE_LINE 00000338 "                my $is_neg = $elem->[1];"
NSQ_SOURCE_LINE 00000339 "                my $k = length($o)==1 ||"
NSQ_SOURCE_LINE 00000340 "                    (!$bundling && $res->{dash_prefix} eq '-') ?"
NSQ_SOURCE_LINE 00000341 "                        \"-$o\" : \"--$o\";"
NSQ_SOURCE_LINE 00000342 "                $opts{$k} = {"
NSQ_SOURCE_LINE 00000343 "                    name => $k,"
NSQ_SOURCE_LINE 00000344 "                    ospec => $ospec,"
NSQ_SOURCE_LINE 00000345 "                    dest  => $dest,"
NSQ_SOURCE_LINE 00000346 "                    parsed => $res,"
NSQ_SOURCE_LINE 00000347 "                    is_neg => $is_neg,"
NSQ_SOURCE_LINE 00000348 "                };"
NSQ_SOURCE_LINE 00000349 "            }"
NSQ_SOURCE_LINE 00000350 "        }"
NSQ_SOURCE_LINE 00000351 "    }"
NSQ_SOURCE_LINE 00000352 "    my @optnames = sort keys %opts;"
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "    my $code_get_summary = sub {"
NSQ_SOURCE_LINE 00000355 "        # currently we only extract summaries from Rinci metadata and"
NSQ_SOURCE_LINE 00000356 "        # Perinci::CmdLine object"
NSQ_SOURCE_LINE 00000357 "        return unless $extras;"
NSQ_SOURCE_LINE 00000358 "        my $ggls_res = $extras->{ggls_res};"
NSQ_SOURCE_LINE 00000359 "        return unless $ggls_res;"
NSQ_SOURCE_LINE 00000360 "        my $r = $extras->{r};"
NSQ_SOURCE_LINE 00000361 "        return unless $r;"
NSQ_SOURCE_LINE 00000362 "        my $cmdline = $extras->{cmdline};"
NSQ_SOURCE_LINE 00000363 ""
