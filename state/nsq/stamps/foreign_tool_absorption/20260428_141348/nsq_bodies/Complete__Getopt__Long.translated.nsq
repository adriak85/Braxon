NSQ_SOURCE_LINE 00000377 "        }"
NSQ_SOURCE_LINE 00000378 ""
NSQ_SOURCE_LINE 00000379 "        if (defined(my $coptname = $ospecmeta->{common_opt})) {"
NSQ_SOURCE_LINE 00000380 "            # it's a common Perinci::CmdLine option"
NSQ_SOURCE_LINE 00000381 "            my $coptspec = $cmdline ? $cmdline->{common_opts}{$coptname} :"
