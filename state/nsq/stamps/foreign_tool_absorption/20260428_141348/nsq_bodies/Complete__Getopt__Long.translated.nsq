NSQ_SOURCE_LINE 00000417 "                return $summ if defined $summ;"
NSQ_SOURCE_LINE 00000418 "                $summ = $argspec->{\"summary\"};"
NSQ_SOURCE_LINE 00000419 "                return $summ if defined $summ;"
