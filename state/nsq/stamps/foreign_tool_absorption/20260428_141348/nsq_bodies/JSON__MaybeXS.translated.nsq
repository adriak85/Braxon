BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package JSON::MaybeXS;"
NSQ_SOURCE_LINE 00000002 ""
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings FATAL => 'all';"
NSQ_SOURCE_LINE 00000005 "use base qw(Exporter);"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "our $VERSION = '1.004008';"
NSQ_SOURCE_LINE 00000008 "$VERSION =~ tr/_//d;"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "sub _choose_json_module {"
NSQ_SOURCE_LINE 00000011 "    return 'Cpanel::JSON::XS' if $INC{'Cpanel/JSON/XS.pm'};"
NSQ_SOURCE_LINE 00000012 "    return 'JSON::XS'         if $INC{'JSON/XS.pm'} && eval { JSON::XS->VERSION(3.0); 1 };"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "    my @err;"
NSQ_SOURCE_LINE 00000015 ""
NSQ_SOURCE_LINE 00000016 "    return 'Cpanel::JSON::XS' if eval { require Cpanel::JSON::XS; 1; };"
NSQ_SOURCE_LINE 00000017 "    push @err, \"Error loading Cpanel::JSON::XS: $@\";"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "    return 'JSON::XS' if eval { require JSON::XS; JSON::XS->VERSION(3.0); 1; };"
NSQ_SOURCE_LINE 00000020 "    push @err, \"Error loading JSON::XS: $@\";"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    return 'JSON::PP' if eval { require JSON::PP; 1 };"
NSQ_SOURCE_LINE 00000023 "    push @err, \"Error loading JSON::PP: $@\";"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "    die join( \"\\n\", \"Couldn't load a JSON module:\", @err );"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "}"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "BEGIN {"
NSQ_SOURCE_LINE 00000030 "    our $JSON_Class = _choose_json_module();"
NSQ_SOURCE_LINE 00000031 "    $JSON_Class->import(qw(encode_json decode_json));"
NSQ_SOURCE_LINE 00000032 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000033 "    *$_ = $JSON_Class->can($_)"
NSQ_SOURCE_LINE 00000034 "      for qw(true false);"
NSQ_SOURCE_LINE 00000035 "}"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "our @EXPORT = qw(encode_json decode_json JSON);"
NSQ_SOURCE_LINE 00000038 "my @EXPORT_ALL = qw(is_bool);"
NSQ_SOURCE_LINE 00000039 "our @EXPORT_OK = qw(is_bool to_json from_json);"
NSQ_SOURCE_LINE 00000040 "our %EXPORT_TAGS = ( all => [ @EXPORT, @EXPORT_ALL ],"
NSQ_SOURCE_LINE 00000041 "                     legacy => [ @EXPORT, @EXPORT_OK ],"
NSQ_SOURCE_LINE 00000042 "                   );"
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "sub JSON () { our $JSON_Class }"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "sub new {"
NSQ_SOURCE_LINE 00000047 "  shift;"
NSQ_SOURCE_LINE 00000048 "  my %args = @_ == 1 ? %{$_[0]} : @_;"
NSQ_SOURCE_LINE 00000049 "  my $new = (our $JSON_Class)->new;"
NSQ_SOURCE_LINE 00000050 "  $new->$_($args{$_}) for keys %args;"
NSQ_SOURCE_LINE 00000051 "  return $new;"
NSQ_SOURCE_LINE 00000052 "}"
NSQ_SOURCE_LINE 00000053 ""
NSQ_SOURCE_LINE 00000054 "use Scalar::Util ();"
NSQ_SOURCE_LINE 00000055 "use constant HAVE_BUILTIN => \"$]\" >= 5.036;"
NSQ_SOURCE_LINE 00000056 "use if HAVE_BUILTIN, experimental => 'builtin';"
NSQ_SOURCE_LINE 00000057 ""
NSQ_SOURCE_LINE 00000058 "sub is_bool {"
NSQ_SOURCE_LINE 00000059 "  die 'is_bool is not a method' if @_ > 1;"
NSQ_SOURCE_LINE 00000060 ""
NSQ_SOURCE_LINE 00000061 "  HAVE_BUILTIN and builtin::is_bool($_[0])"
NSQ_SOURCE_LINE 00000062 "  or"
NSQ_SOURCE_LINE 00000063 "  !!Scalar::Util::blessed($_[0])"
NSQ_SOURCE_LINE 00000064 "    and ($_[0]->isa('JSON::PP::Boolean')"
NSQ_SOURCE_LINE 00000065 "      or $_[0]->isa('Cpanel::JSON::XS::Boolean')"
NSQ_SOURCE_LINE 00000066 "      or $_[0]->isa('JSON::XS::Boolean'));"
NSQ_SOURCE_LINE 00000067 "}"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "# (mostly) CopyPasta from JSON.pm version 2.90"
NSQ_SOURCE_LINE 00000070 "use Carp ();"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "sub from_json ($@) {"
NSQ_SOURCE_LINE 00000073 "    if ( ref($_[0]) =~ /^JSON/ or $_[0] =~ /^JSON/ ) {"
NSQ_SOURCE_LINE 00000074 "        Carp::croak \"from_json should not be called as a method.\";"
NSQ_SOURCE_LINE 00000075 "    }"
NSQ_SOURCE_LINE 00000076 "    my $json = JSON()->new;"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "    if (@_ == 2 and ref $_[1] eq 'HASH') {"
NSQ_SOURCE_LINE 00000079 "        my $opt  = $_[1];"
NSQ_SOURCE_LINE 00000080 "        for my $method (keys %$opt) {"
NSQ_SOURCE_LINE 00000081 "            $json->$method( $opt->{$method} );"
NSQ_SOURCE_LINE 00000082 "        }"
NSQ_SOURCE_LINE 00000083 "    }"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "    return $json->decode( $_[0] );"
NSQ_SOURCE_LINE 00000086 "}"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "sub to_json ($@) {"
NSQ_SOURCE_LINE 00000089 "    if ("
NSQ_SOURCE_LINE 00000090 "        ref($_[0]) =~ /^JSON/"
NSQ_SOURCE_LINE 00000091 "        or (@_ > 2 and $_[0] =~ /^JSON/)"
NSQ_SOURCE_LINE 00000092 "          ) {"
NSQ_SOURCE_LINE 00000093 "               Carp::croak \"to_json should not be called as a method.\";"
NSQ_SOURCE_LINE 00000094 "    }"
NSQ_SOURCE_LINE 00000095 "    my $json = JSON()->new;"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "    if (@_ == 2 and ref $_[1] eq 'HASH') {"
NSQ_SOURCE_LINE 00000098 "        my $opt  = $_[1];"
NSQ_SOURCE_LINE 00000099 "        for my $method (keys %$opt) {"
NSQ_SOURCE_LINE 00000100 "            $json->$method( $opt->{$method} );"
NSQ_SOURCE_LINE 00000101 "        }"
NSQ_SOURCE_LINE 00000102 "    }"
NSQ_SOURCE_LINE 00000103 ""
NSQ_SOURCE_LINE 00000104 "    $json->encode($_[0]);"
NSQ_SOURCE_LINE 00000105 "}"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "1;"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=head1 NAME"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "JSON::MaybeXS - Use L<Cpanel::JSON::XS> with a fallback to L<JSON::XS> and L<JSON::PP>"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "  use JSON::MaybeXS;"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "  my $data_structure = decode_json($json_input);"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "  my $json_output = encode_json($data_structure);"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "  my $json = JSON()->new;"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 "  my $json_with_args = JSON::MaybeXS->new(utf8 => 1); # or { utf8 => 1 }"
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000126 ""
NSQ_SOURCE_LINE 00000127 "This module first checks to see if either L<Cpanel::JSON::XS> or"
NSQ_SOURCE_LINE 00000128 "L<JSON::XS> (at at least version 3.0)"
NSQ_SOURCE_LINE 00000129 "is already loaded, in which case it uses that module. Otherwise"
NSQ_SOURCE_LINE 00000130 "it tries to load L<Cpanel::JSON::XS>, then L<JSON::XS>, then L<JSON::PP>"
NSQ_SOURCE_LINE 00000131 "in order, and either uses the first module it finds or throws an error."
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "It then exports the C<encode_json> and C<decode_json> functions from the"
NSQ_SOURCE_LINE 00000134 "loaded module, along with a C<JSON> constant that returns the class name"
NSQ_SOURCE_LINE 00000135 "for calling C<new> on."
NSQ_SOURCE_LINE 00000136 ""
NSQ_SOURCE_LINE 00000137 "If you're writing fresh code rather than replacing L<JSON.pm|JSON> usage, you might"
NSQ_SOURCE_LINE 00000138 "want to pass options as constructor args rather than calling mutators, so"
NSQ_SOURCE_LINE 00000139 "we provide our own C<new> method that supports that."
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=head1 EXPORTS"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "C<encode_json>, C<decode_json> and C<JSON> are exported by default; C<is_bool>"
NSQ_SOURCE_LINE 00000144 "is exported on request."
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "To import only some symbols, specify them on the C<use> line:"
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "  use JSON::MaybeXS qw(encode_json decode_json is_bool); # functions only"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "  use JSON::MaybeXS qw(JSON); # JSON constant only"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "To import all available sensible symbols (C<encode_json>, C<decode_json>, and"
NSQ_SOURCE_LINE 00000153 "C<is_bool>), use C<:all>:"
NSQ_SOURCE_LINE 00000154 ""
NSQ_SOURCE_LINE 00000155 "  use JSON::MaybeXS ':all';"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "To import all symbols including those needed by legacy apps that use L<JSON::PP>:"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "  use JSON::MaybeXS ':legacy';"
NSQ_SOURCE_LINE 00000160 ""
NSQ_SOURCE_LINE 00000161 "This imports the C<to_json> and C<from_json> symbols as well as everything in"
NSQ_SOURCE_LINE 00000162 "C<:all>.  NOTE: This is to support legacy code that makes extensive"
NSQ_SOURCE_LINE 00000163 "use of C<to_json> and C<from_json> which you are not yet in a position to"
NSQ_SOURCE_LINE 00000164 "refactor.  DO NOT use this import tag in new code, in order to avoid"
NSQ_SOURCE_LINE 00000165 "the crawling horrors of getting UTF-8 support subtly wrong.  See the"
NSQ_SOURCE_LINE 00000166 "documentation for L<JSON> for further details."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=head2 encode_json"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "This is the C<encode_json> function provided by the selected implementation"
NSQ_SOURCE_LINE 00000171 "module, and takes a perl data structure which is serialised to JSON text."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "  my $json_text = encode_json($data_structure);"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "=head2 decode_json"
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "This is the C<decode_json> function provided by the selected implementation"
NSQ_SOURCE_LINE 00000178 "module, and takes a string of JSON text to deserialise to a perl data structure."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "  my $data_structure = decode_json($json_text);"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "=head2 to_json"
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "This function is equivalent to calling C<< JSON()->new->encode($data_structure) >>."
NSQ_SOURCE_LINE 00000185 "It takes a perl data structure which is serialised to JSON text without encoding"
NSQ_SOURCE_LINE 00000186 "it to UTF-8. You should only use this function if you expect another layer to"
NSQ_SOURCE_LINE 00000187 "handle the UTF-8 encoding of the resulting JSON text."
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "  my $json_text = to_json($data_structure);"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "Additional arguments can be passed and will be handled as in L<JSON/to_json>,"
NSQ_SOURCE_LINE 00000192 "this is included to support legacy code B<only>."
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=head2 from_json"
NSQ_SOURCE_LINE 00000195 ""
NSQ_SOURCE_LINE 00000196 "This function is equivalent to calling C<< JSON()->new->decode($json_text) >>. It"
NSQ_SOURCE_LINE 00000197 "takes a string of unencoded JSON text to deserialise to a perl data structure. You"
NSQ_SOURCE_LINE 00000198 "should only use this function if another layer is already handling the UTF-8"
NSQ_SOURCE_LINE 00000199 "decoding of the input JSON text."
NSQ_SOURCE_LINE 00000200 ""
NSQ_SOURCE_LINE 00000201 "  my $data_structure = from_json($json_text);"
NSQ_SOURCE_LINE 00000202 ""
NSQ_SOURCE_LINE 00000203 "Additional arguments can be passed and will be handled as in L<JSON/from_json>,"
NSQ_SOURCE_LINE 00000204 "this is included to support legacy code B<only>."
NSQ_SOURCE_LINE 00000205 ""
NSQ_SOURCE_LINE 00000206 "=head2 JSON"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "The C<JSON> constant returns the selected implementation module's name for"
NSQ_SOURCE_LINE 00000209 "use as a class name - so:"
NSQ_SOURCE_LINE 00000210 ""
NSQ_SOURCE_LINE 00000211 "  my $json_obj = JSON()->new; # returns a Cpanel::JSON::XS or JSON::PP object"
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "and that object can then be used normally:"
NSQ_SOURCE_LINE 00000214 ""
NSQ_SOURCE_LINE 00000215 "  my $data_structure = $json_obj->decode($json_text); # etc."
NSQ_SOURCE_LINE 00000216 ""
NSQ_SOURCE_LINE 00000217 "The use of parentheses here is optional, and only used as a hint to the reader"
NSQ_SOURCE_LINE 00000218 "that this use of C<JSON> is a I<subroutine> call, I<not> a class name."
NSQ_SOURCE_LINE 00000219 ""
NSQ_SOURCE_LINE 00000220 "=head2 is_bool"
NSQ_SOURCE_LINE 00000221 ""
NSQ_SOURCE_LINE 00000222 "  $is_boolean = is_bool($scalar)"
NSQ_SOURCE_LINE 00000223 ""
NSQ_SOURCE_LINE 00000224 "Returns true if the passed scalar represents either C<true> or"
NSQ_SOURCE_LINE 00000225 "C<false>, two constants that act like C<1> and C<0>, respectively"
NSQ_SOURCE_LINE 00000226 "and are used to represent JSON C<true> and C<false> values in Perl."
NSQ_SOURCE_LINE 00000227 ""
NSQ_SOURCE_LINE 00000228 "Since this is a bare sub in the various backend classes, it cannot be called as"
NSQ_SOURCE_LINE 00000229 "a class method like the other interfaces; it must be called as a function, with"
NSQ_SOURCE_LINE 00000230 "no invocant.  It supports the representation used in all JSON backends."
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "Available since version 1.002004."
NSQ_SOURCE_LINE 00000233 ""
NSQ_SOURCE_LINE 00000234 "=head1 CONSTRUCTOR"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=head2 new"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "With L<JSON::PP>, L<JSON::XS> and L<Cpanel::JSON::XS> you are required to call"
NSQ_SOURCE_LINE 00000239 "mutators to set options, such as:"
NSQ_SOURCE_LINE 00000240 ""
NSQ_SOURCE_LINE 00000241 "  my $json = $class->new->utf8(1)->pretty(1);"
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "Since this is a trifle irritating and noticeably un-perlish, we also offer:"
NSQ_SOURCE_LINE 00000244 ""
NSQ_SOURCE_LINE 00000245 "  my $json = JSON::MaybeXS->new(utf8 => 1, pretty => 1);"
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "which works equivalently to the above (and in the usual tradition will accept"
NSQ_SOURCE_LINE 00000248 "a hashref instead of a hash, should you so desire)."
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "The resulting object is blessed into the underlying backend, which offers (at"
NSQ_SOURCE_LINE 00000251 "least) the methods C<encode> and C<decode>."
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "=head1 BOOLEANS"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "To include JSON-aware booleans (C<true>, C<false>) in your data, just do:"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "    use JSON::MaybeXS;"
NSQ_SOURCE_LINE 00000258 "    my $true = JSON()->true;"
NSQ_SOURCE_LINE 00000259 "    my $false = JSON()->false;"
NSQ_SOURCE_LINE 00000260 ""
NSQ_SOURCE_LINE 00000261 "The booleans are also available as subs or methods on JSON::MaybeXS."
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "    use JSON::MaybeXS ();"
NSQ_SOURCE_LINE 00000264 "    my $true = JSON::MaybeXS::true;"
NSQ_SOURCE_LINE 00000265 "    my $true = JSON::MaybeXS->true;"
NSQ_SOURCE_LINE 00000266 "    my $false = JSON::MaybeXS::false;"
NSQ_SOURCE_LINE 00000267 "    my $false = JSON::MaybeXS->false;"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "=head1 CONVERTING FROM JSON::Any"
NSQ_SOURCE_LINE 00000270 ""
NSQ_SOURCE_LINE 00000271 "L<JSON::Any> used to be the favoured compatibility layer above the various"
NSQ_SOURCE_LINE 00000272 "JSON backends, but over time has grown a lot of extra code to deal with legacy"
NSQ_SOURCE_LINE 00000273 "backends (e.g. L<JSON::Syck>) that are no longer needed.  This is a rough guide of translating such code:"
NSQ_SOURCE_LINE 00000274 ""
NSQ_SOURCE_LINE 00000275 "Change code from:"
NSQ_SOURCE_LINE 00000276 ""
NSQ_SOURCE_LINE 00000277 "    use JSON::Any;"
NSQ_SOURCE_LINE 00000278 "    my $json = JSON::Any->new->objToJson($data);    # or to_json($data), or Dump($data)"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "to:"
NSQ_SOURCE_LINE 00000281 ""
NSQ_SOURCE_LINE 00000282 "    use JSON::MaybeXS;"
NSQ_SOURCE_LINE 00000283 "    my $json = encode_json($data);"
NSQ_SOURCE_LINE 00000284 ""
NSQ_SOURCE_LINE 00000285 ""
NSQ_SOURCE_LINE 00000286 "Change code from:"
NSQ_SOURCE_LINE 00000287 ""
NSQ_SOURCE_LINE 00000288 "    use JSON::Any;"
NSQ_SOURCE_LINE 00000289 "    my $data = JSON::Any->new->jsonToObj($json);    # or from_json($json), or Load($json)"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "to:"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "    use JSON::MaybeXS;"
NSQ_SOURCE_LINE 00000294 "    my $json = decode_json($data);"
NSQ_SOURCE_LINE 00000295 ""
NSQ_SOURCE_LINE 00000296 "=head1 CAVEATS"
NSQ_SOURCE_LINE 00000297 ""
NSQ_SOURCE_LINE 00000298 "The C<new()> method in this module is technically a factory, not a"
NSQ_SOURCE_LINE 00000299 "constructor, because the objects it returns will I<NOT> be blessed into the"
NSQ_SOURCE_LINE 00000300 "C<JSON::MaybeXS> class."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "If you are using an object returned by this module as a Moo(se) attribute,"
NSQ_SOURCE_LINE 00000303 "this type constraint code:"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "    is 'json' => ( isa => 'JSON::MaybeXS' );"
NSQ_SOURCE_LINE 00000306 ""
NSQ_SOURCE_LINE 00000307 "will I<NOT> do what you expect. Instead, either rely on the C<JSON> class"
NSQ_SOURCE_LINE 00000308 "constant described above, as so:"
NSQ_SOURCE_LINE 00000309 ""
NSQ_SOURCE_LINE 00000310 "    is 'json' => ( isa => JSON::MaybeXS::JSON() );"
NSQ_SOURCE_LINE 00000311 ""
NSQ_SOURCE_LINE 00000312 "Alternatively, you can use duck typing:"
NSQ_SOURCE_LINE 00000313 ""
NSQ_SOURCE_LINE 00000314 "    use Moose::Util::TypeConstraints 'duck_type';"
NSQ_SOURCE_LINE 00000315 "    is 'json' => ( isa => Object , duck_type([qw/ encode decode /]));"
NSQ_SOURCE_LINE 00000316 ""
NSQ_SOURCE_LINE 00000317 "=head1 INSTALLATION"
NSQ_SOURCE_LINE 00000318 ""
NSQ_SOURCE_LINE 00000319 "At installation time, F<Makefile.PL> will attempt to determine if you have a"
NSQ_SOURCE_LINE 00000320 "working compiler available, and therefore whether you are able to run XS code."
NSQ_SOURCE_LINE 00000321 "If so, L<Cpanel::JSON::XS> will be added to the prerequisite list, unless"
NSQ_SOURCE_LINE 00000322 "L<JSON::XS> is already installed at a high enough version. L<JSON::XS> may"
NSQ_SOURCE_LINE 00000323 "also be upgraded to fix any incompatibility issues."
NSQ_SOURCE_LINE 00000324 ""
NSQ_SOURCE_LINE 00000325 "Because running XS code is not mandatory and L<JSON::PP> (which is in perl"
NSQ_SOURCE_LINE 00000326 "core) is used as a fallback backend, this module is safe to be used in a suite"
NSQ_SOURCE_LINE 00000327 "of code that is fatpacked or installed into a restricted-resource environment."
NSQ_SOURCE_LINE 00000328 ""
NSQ_SOURCE_LINE 00000329 "You can also prevent any XS dependencies from being installed by setting"
NSQ_SOURCE_LINE 00000330 "C<PUREPERL_ONLY=1> in F<Makefile.PL> options (or in the C<PERL_MM_OPT>"
NSQ_SOURCE_LINE 00000331 "environment variable), or using the C<--pp> or C<--pureperl> flags with the"
NSQ_SOURCE_LINE 00000332 "L<cpanminus client|cpanm>."
NSQ_SOURCE_LINE 00000333 ""
NSQ_SOURCE_LINE 00000334 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000335 ""
