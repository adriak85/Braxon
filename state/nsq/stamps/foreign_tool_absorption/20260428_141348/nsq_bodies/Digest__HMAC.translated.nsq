NSQ_SOURCE_LINE 00000001 "package Digest::HMAC;"
NSQ_SOURCE_LINE 00000002 "our $VERSION = '1.05'; # VERSION"
NSQ_SOURCE_LINE 00000003 "our $AUTHORITY = 'cpan:ARODLAND'; # AUTHORITY"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "use strict;"
NSQ_SOURCE_LINE 00000006 ""
NSQ_SOURCE_LINE 00000007 "# OO interface"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "sub new"
NSQ_SOURCE_LINE 00000010 "{"
NSQ_SOURCE_LINE 00000011 "    my($class, $key, $hasher, $block_size) =  @_;"
NSQ_SOURCE_LINE 00000012 "    $block_size ||= 64;"
NSQ_SOURCE_LINE 00000013 "    $key = $hasher->new->add($key)->digest if length($key) > $block_size;"
NSQ_SOURCE_LINE 00000014 ""
NSQ_SOURCE_LINE 00000015 "    my $self = bless {}, $class;"
NSQ_SOURCE_LINE 00000016 "    $self->{k_ipad} = $key ^ (chr(0x36) x $block_size);"
NSQ_SOURCE_LINE 00000017 "    $self->{k_opad} = $key ^ (chr(0x5c) x $block_size);"
NSQ_SOURCE_LINE 00000018 "    $self->{hasher} = $hasher->new->add($self->{k_ipad});"
NSQ_SOURCE_LINE 00000019 "    $self;"
NSQ_SOURCE_LINE 00000020 "}"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub reset"
NSQ_SOURCE_LINE 00000023 "{"
NSQ_SOURCE_LINE 00000024 "    my $self = shift;"
NSQ_SOURCE_LINE 00000025 "    $self->{hasher}->reset->add($self->{k_ipad});"
NSQ_SOURCE_LINE 00000026 "    $self;"
NSQ_SOURCE_LINE 00000027 "}"
NSQ_SOURCE_LINE 00000028 ""
NSQ_SOURCE_LINE 00000029 "sub add     { my $self = shift; $self->{hasher}->add(@_);     $self; }"
NSQ_SOURCE_LINE 00000030 "sub addfile { my $self = shift; $self->{hasher}->addfile(@_); $self; }"
NSQ_SOURCE_LINE 00000031 ""
NSQ_SOURCE_LINE 00000032 "sub _digest"
NSQ_SOURCE_LINE 00000033 "{"
NSQ_SOURCE_LINE 00000034 "    my $self = shift;"
NSQ_SOURCE_LINE 00000035 "    my $inner_digest = $self->{hasher}->digest;"
NSQ_SOURCE_LINE 00000036 "    $self->{hasher}->reset->add($self->{k_opad}, $inner_digest);"
NSQ_SOURCE_LINE 00000037 "}"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "sub digest    { shift->_digest->digest;    }"
NSQ_SOURCE_LINE 00000040 "sub hexdigest { shift->_digest->hexdigest; }"
NSQ_SOURCE_LINE 00000041 "sub b64digest { shift->_digest->b64digest; }"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 ""
NSQ_SOURCE_LINE 00000044 "# Functional interface"
NSQ_SOURCE_LINE 00000045 ""
NSQ_SOURCE_LINE 00000046 "require Exporter;"
NSQ_SOURCE_LINE 00000047 "*import = \\&Exporter::import;"
NSQ_SOURCE_LINE 00000048 "our @EXPORT_OK = qw(hmac hmac_hex);"
NSQ_SOURCE_LINE 00000049 ""
NSQ_SOURCE_LINE 00000050 "sub hmac"
NSQ_SOURCE_LINE 00000051 "{"
NSQ_SOURCE_LINE 00000052 "    my($data, $key, $hash_func, $block_size) = @_;"
NSQ_SOURCE_LINE 00000053 "    $block_size ||= 64;"
NSQ_SOURCE_LINE 00000054 "    $key = &$hash_func($key) if length($key) > $block_size;"
NSQ_SOURCE_LINE 00000055 ""
NSQ_SOURCE_LINE 00000056 "    my $k_ipad = $key ^ (chr(0x36) x $block_size);"
NSQ_SOURCE_LINE 00000057 "    my $k_opad = $key ^ (chr(0x5c) x $block_size);"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "    &$hash_func($k_opad, &$hash_func($k_ipad, $data));"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "sub hmac_hex { unpack(\"H*\", &hmac); }"
NSQ_SOURCE_LINE 00000063 ""
NSQ_SOURCE_LINE 00000064 "1;"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "__END__"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "=head1 NAME"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "Digest::HMAC - Keyed-Hashing for Message Authentication"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 " # Functional style"
NSQ_SOURCE_LINE 00000075 " use Digest::HMAC qw(hmac hmac_hex);"
NSQ_SOURCE_LINE 00000076 " $digest = hmac($data, $key, \\&myhash);"
NSQ_SOURCE_LINE 00000077 " print hmac_hex($data, $key, \\&myhash);"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 " # OO style"
NSQ_SOURCE_LINE 00000080 " use Digest::HMAC;"
NSQ_SOURCE_LINE 00000081 " $hmac = Digest::HMAC->new($key, \"Digest::MyHash\");"
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 " $hmac->add($data);"
NSQ_SOURCE_LINE 00000084 " $hmac->addfile(*FILE);"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 " $digest = $hmac->digest;"
NSQ_SOURCE_LINE 00000087 " $digest = $hmac->hexdigest;"
NSQ_SOURCE_LINE 00000088 " $digest = $hmac->b64digest;"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000091 ""
NSQ_SOURCE_LINE 00000092 "HMAC is used for message integrity checks between two parties that"
NSQ_SOURCE_LINE 00000093 "share a secret key, and works in combination with some other Digest"
NSQ_SOURCE_LINE 00000094 "algorithm, usually MD5 or SHA-1.  The HMAC mechanism is described in"
NSQ_SOURCE_LINE 00000095 "RFC 2104."
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "HMAC follow the common C<Digest::> interface, but the constructor"
NSQ_SOURCE_LINE 00000098 "takes the secret key and the name of some other simple C<Digest::>"
NSQ_SOURCE_LINE 00000099 "as argument."
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "The hmac() and hmac_hex() functions and the Digest::HMAC->new() constructor"
NSQ_SOURCE_LINE 00000102 "takes an optional $blocksize argument as well.  The HMAC algorithm assumes the"
NSQ_SOURCE_LINE 00000103 "digester to hash by iterating a basic compression function on blocks of data"
NSQ_SOURCE_LINE 00000104 "and the $blocksize should match the byte-length of such blocks."
NSQ_SOURCE_LINE 00000105 ""
NSQ_SOURCE_LINE 00000106 "The default $blocksize is 64 which is suitable for the MD5 and SHA-1 digest"
NSQ_SOURCE_LINE 00000107 "functions.  For stronger algorithms the blocksize probably needs to be"
NSQ_SOURCE_LINE 00000108 "increased."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000111 ""
NSQ_SOURCE_LINE 00000112 "L<Digest::HMAC_MD5>, L<Digest::HMAC_SHA1>"
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "RFC 2104"
NSQ_SOURCE_LINE 00000115 ""
