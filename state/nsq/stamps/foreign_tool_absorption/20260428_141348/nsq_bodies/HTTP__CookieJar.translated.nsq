NSQ_SOURCE_LINE 00000001 "use 5.008001;"
NSQ_SOURCE_LINE 00000002 "use strict;"
NSQ_SOURCE_LINE 00000003 "use warnings;"
NSQ_SOURCE_LINE 00000004 ""
NSQ_SOURCE_LINE 00000005 "package HTTP::CookieJar;"
NSQ_SOURCE_LINE 00000006 "# ABSTRACT: A minimalist HTTP user agent cookie jar"
NSQ_SOURCE_LINE 00000007 "our $VERSION = '0.014';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Carp       ();"
NSQ_SOURCE_LINE 00000010 "use HTTP::Date ();"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "my $HAS_MPS = eval { require Mozilla::PublicSuffix; 1 };"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "#pod =construct new"
NSQ_SOURCE_LINE 00000015 "#pod"
NSQ_SOURCE_LINE 00000016 "#pod     my $jar = HTTP::CookieJar->new;"
NSQ_SOURCE_LINE 00000017 "#pod"
NSQ_SOURCE_LINE 00000018 "#pod Return a new, empty cookie jar"
NSQ_SOURCE_LINE 00000019 "#pod"
NSQ_SOURCE_LINE 00000020 "#pod =cut"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "sub new {"
NSQ_SOURCE_LINE 00000023 "    my ($class) = @_;"
NSQ_SOURCE_LINE 00000024 "    bless { store => {} }, $class;"
NSQ_SOURCE_LINE 00000025 "}"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "#pod =method add"
NSQ_SOURCE_LINE 00000028 "#pod"
NSQ_SOURCE_LINE 00000029 "#pod     $jar->add("
NSQ_SOURCE_LINE 00000030 "#pod         \"http://www.example.com/\", \"lang=en-US; Path=/; Domain=example.com\""
NSQ_SOURCE_LINE 00000031 "#pod     );"
NSQ_SOURCE_LINE 00000032 "#pod"
NSQ_SOURCE_LINE 00000033 "#pod Given a request URL and a C<Set-Cookie> header string, attempts to adds the"
NSQ_SOURCE_LINE 00000034 "#pod cookie to the jar.  If the cookie is expired, instead it deletes any matching"
NSQ_SOURCE_LINE 00000035 "#pod cookie from the jar.  A C<Max-Age> attribute will be converted to an absolute"
NSQ_SOURCE_LINE 00000036 "#pod C<Expires> attribute."
NSQ_SOURCE_LINE 00000037 "#pod"
NSQ_SOURCE_LINE 00000038 "#pod It will throw an exception if the request URL is missing or invalid.  Returns true if"
NSQ_SOURCE_LINE 00000039 "#pod successful cookie processing or undef/empty-list on failure."
NSQ_SOURCE_LINE 00000040 "#pod"
NSQ_SOURCE_LINE 00000041 "#pod =cut"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "sub add {"
NSQ_SOURCE_LINE 00000044 "    my ( $self, $request, $cookie ) = @_;"
NSQ_SOURCE_LINE 00000045 "    return unless defined $cookie and length $cookie;"
NSQ_SOURCE_LINE 00000046 "    my ( $scheme, $host, $port, $request_path ) = eval { _split_url($request) };"
NSQ_SOURCE_LINE 00000047 "    Carp::croak($@) if $@;"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "    return unless my $parse = _parse_cookie($cookie);"
NSQ_SOURCE_LINE 00000050 "    my $name = $parse->{name};"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "    # check and normalize domain"
NSQ_SOURCE_LINE 00000053 "    if ( exists $parse->{domain} ) {"
NSQ_SOURCE_LINE 00000054 "        _normalize_domain( $host, $parse ) or return;"
NSQ_SOURCE_LINE 00000055 "    }"
NSQ_SOURCE_LINE 00000056 "    else {"
NSQ_SOURCE_LINE 00000057 "        $parse->{domain}   = $host;"
NSQ_SOURCE_LINE 00000058 "        $parse->{hostonly} = 1;"
NSQ_SOURCE_LINE 00000059 "    }"
NSQ_SOURCE_LINE 00000060 "    my $domain = $parse->{domain};"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "    # normalize path"
NSQ_SOURCE_LINE 00000063 "    if ( !exists $parse->{path} || substr( $parse->{path}, 0, 1 ) ne \"/\" ) {"
NSQ_SOURCE_LINE 00000064 "        $parse->{path} = _default_path($request_path);"
NSQ_SOURCE_LINE 00000065 "    }"
NSQ_SOURCE_LINE 00000066 "    my $path = $parse->{path};"
NSQ_SOURCE_LINE 00000067 "    # set timestamps and normalize expires"
NSQ_SOURCE_LINE 00000068 "    my $now = $parse->{creation_time} = $parse->{last_access_time} = time;"
NSQ_SOURCE_LINE 00000069 "    if ( exists $parse->{'max-age'} ) {"
NSQ_SOURCE_LINE 00000070 "        # \"If delta-seconds is less than or equal to zero (0), let expiry-time"
NSQ_SOURCE_LINE 00000071 "        # be the earliest representable date and time.\""
NSQ_SOURCE_LINE 00000072 "        $parse->{expires} = $parse->{'max-age'} <= 0"
NSQ_SOURCE_LINE 00000073 "            ? 0"
NSQ_SOURCE_LINE 00000074 "            : $now + $parse->{'max-age'};"
NSQ_SOURCE_LINE 00000075 "        delete $parse->{'max-age'};"
NSQ_SOURCE_LINE 00000076 "    }"
NSQ_SOURCE_LINE 00000077 "    # update creation time from old cookie, if exists"
NSQ_SOURCE_LINE 00000078 "    if ( my $old = $self->{store}{$domain}{$path}{$name} ) {"
NSQ_SOURCE_LINE 00000079 "        $parse->{creation_time} = $old->{creation_time};"
NSQ_SOURCE_LINE 00000080 "    }"
NSQ_SOURCE_LINE 00000081 "    # if cookie has expired, purge any old matching cookie, too"
NSQ_SOURCE_LINE 00000082 "    if ( defined $parse->{expires} && $parse->{expires} < $now ) {"
NSQ_SOURCE_LINE 00000083 "        delete $self->{store}{$domain}{$path}{$name};"
NSQ_SOURCE_LINE 00000084 "    }"
NSQ_SOURCE_LINE 00000085 "    else {"
NSQ_SOURCE_LINE 00000086 "        $self->{store}{$domain}{$path}{$name} = $parse;"
NSQ_SOURCE_LINE 00000087 "    }"
NSQ_SOURCE_LINE 00000088 "    return 1;"
NSQ_SOURCE_LINE 00000089 "}"
NSQ_SOURCE_LINE 00000090 ""
NSQ_SOURCE_LINE 00000091 "#pod =method clear"
NSQ_SOURCE_LINE 00000092 "#pod"
NSQ_SOURCE_LINE 00000093 "#pod     $jar->clear"
NSQ_SOURCE_LINE 00000094 "#pod"
NSQ_SOURCE_LINE 00000095 "#pod Empties the cookie jar."
NSQ_SOURCE_LINE 00000096 "#pod"
NSQ_SOURCE_LINE 00000097 "#pod =cut"
NSQ_SOURCE_LINE 00000098 ""
NSQ_SOURCE_LINE 00000099 "sub clear {"
NSQ_SOURCE_LINE 00000100 "    my ($self) = @_;"
NSQ_SOURCE_LINE 00000101 "    $self->{store} = {};"
NSQ_SOURCE_LINE 00000102 "    return 1;"
NSQ_SOURCE_LINE 00000103 "}"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "#pod =method cookies_for"
NSQ_SOURCE_LINE 00000106 "#pod"
NSQ_SOURCE_LINE 00000107 "#pod     my @cookies = $jar->cookies_for(\"http://www.example.com/foo/bar\");"
NSQ_SOURCE_LINE 00000108 "#pod"
NSQ_SOURCE_LINE 00000109 "#pod Given a request URL, returns a list of hash references representing cookies"
NSQ_SOURCE_LINE 00000110 "#pod that should be sent.  The hash references are copies -- changing values"
NSQ_SOURCE_LINE 00000111 "#pod will not change the cookies in the jar."
NSQ_SOURCE_LINE 00000112 "#pod"
NSQ_SOURCE_LINE 00000113 "#pod Cookies set C<secure> will only be returned if the request scheme is C<https>."
NSQ_SOURCE_LINE 00000114 "#pod Expired cookies will not be returned."
NSQ_SOURCE_LINE 00000115 "#pod"
NSQ_SOURCE_LINE 00000116 "#pod Keys of a cookie hash reference might include:"
NSQ_SOURCE_LINE 00000117 "#pod"
NSQ_SOURCE_LINE 00000118 "#pod =for :list"
NSQ_SOURCE_LINE 00000119 "#pod * name -- the name of the cookie"
NSQ_SOURCE_LINE 00000120 "#pod * value -- the value of the cookie"
NSQ_SOURCE_LINE 00000121 "#pod * domain -- the domain name to which the cookie applies"
NSQ_SOURCE_LINE 00000122 "#pod * path -- the path to which the cookie applies"
NSQ_SOURCE_LINE 00000123 "#pod * expires -- if present, when the cookie expires in epoch seconds"
NSQ_SOURCE_LINE 00000124 "#pod * secure -- if present, the cookie was set C<Secure>"
NSQ_SOURCE_LINE 00000125 "#pod * httponly -- if present, the cookie was set C<HttpOnly>"
NSQ_SOURCE_LINE 00000126 "#pod * hostonly -- if present, the cookie may only be used with the domain as a host"
NSQ_SOURCE_LINE 00000127 "#pod * creation_time -- epoch time when the cookie was first stored"
NSQ_SOURCE_LINE 00000128 "#pod * last_access_time -- epoch time when the cookie was last accessed (i.e. \"now\")"
NSQ_SOURCE_LINE 00000129 "#pod"
NSQ_SOURCE_LINE 00000130 "#pod Keep in mind that C<httponly> means it should only be used in requests and not"
NSQ_SOURCE_LINE 00000131 "#pod made available via Javascript, etc.  This is pretty meaningless for Perl user"
NSQ_SOURCE_LINE 00000132 "#pod agents."
NSQ_SOURCE_LINE 00000133 "#pod"
NSQ_SOURCE_LINE 00000134 "#pod Generally, user agents should use the C<cookie_header> method instead."
NSQ_SOURCE_LINE 00000135 "#pod"
NSQ_SOURCE_LINE 00000136 "#pod It will throw an exception if the request URL is missing or invalid."
NSQ_SOURCE_LINE 00000137 "#pod"
NSQ_SOURCE_LINE 00000138 "#pod =cut"
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "sub cookies_for {"
NSQ_SOURCE_LINE 00000141 "    my ( $self, $request ) = @_;"
NSQ_SOURCE_LINE 00000142 "    my @found = $self->_cookies_for($request);"
NSQ_SOURCE_LINE 00000143 "    return map { {%$_} } @found;"
NSQ_SOURCE_LINE 00000144 "}"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "# _cookies_for returns originals, not copies, which helps in testing"
NSQ_SOURCE_LINE 00000147 "sub _cookies_for {"
NSQ_SOURCE_LINE 00000148 "    my ( $self, $request ) = @_;"
NSQ_SOURCE_LINE 00000149 "    my ( $scheme, $host, $port, $request_path ) = eval { _split_url($request) };"
NSQ_SOURCE_LINE 00000150 "    Carp::croak($@) if $@;"
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "    my @found;"
NSQ_SOURCE_LINE 00000153 "    my $now = time;"
NSQ_SOURCE_LINE 00000154 "    for my $cookie ( $self->_all_cookies ) {"
NSQ_SOURCE_LINE 00000155 "        next if $cookie->{hostonly}           && $host ne $cookie->{domain};"
NSQ_SOURCE_LINE 00000156 "        next if $cookie->{secure}             && $scheme ne 'https';"
NSQ_SOURCE_LINE 00000157 "        next if defined( $cookie->{expires} ) && $cookie->{expires} < $now;"
NSQ_SOURCE_LINE 00000158 "        next unless _domain_match( $host, $cookie->{domain} );"
NSQ_SOURCE_LINE 00000159 "        next unless _path_match( $request_path, $cookie->{path} );"
NSQ_SOURCE_LINE 00000160 "        $cookie->{last_access_time} = time;"
NSQ_SOURCE_LINE 00000161 "        push @found, $cookie;"
NSQ_SOURCE_LINE 00000162 "    }"
NSQ_SOURCE_LINE 00000163 "    @found = sort {"
NSQ_SOURCE_LINE 00000164 "        length( $b->{path} ) <=> length( $a->{path} )"
NSQ_SOURCE_LINE 00000165 "          || $a->{creation_time} <=> $b->{creation_time}"
NSQ_SOURCE_LINE 00000166 "    } @found;"
NSQ_SOURCE_LINE 00000167 "    return @found;"
NSQ_SOURCE_LINE 00000168 "}"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "#pod =method cookie_header"
NSQ_SOURCE_LINE 00000171 "#pod"
NSQ_SOURCE_LINE 00000172 "#pod     my $header = $jar->cookie_header(\"http://www.example.com/foo/bar\");"
NSQ_SOURCE_LINE 00000173 "#pod"
NSQ_SOURCE_LINE 00000174 "#pod Given a request URL, returns a correctly-formatted string with all relevant"
NSQ_SOURCE_LINE 00000175 "#pod cookies for the request.  This string is ready to be used in a C<Cookie> header"
NSQ_SOURCE_LINE 00000176 "#pod in an HTTP request.  E.g.:"
NSQ_SOURCE_LINE 00000177 "#pod"
NSQ_SOURCE_LINE 00000178 "#pod     SID=31d4d96e407aad42; lang=en-US"
NSQ_SOURCE_LINE 00000179 "#pod"
NSQ_SOURCE_LINE 00000180 "#pod It follows the same exclusion rules as C<cookies_for>."
NSQ_SOURCE_LINE 00000181 "#pod"
NSQ_SOURCE_LINE 00000182 "#pod If the request is invalid or no cookies apply, it will return an empty string."
NSQ_SOURCE_LINE 00000183 "#pod"
NSQ_SOURCE_LINE 00000184 "#pod =cut"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "sub cookie_header {"
NSQ_SOURCE_LINE 00000187 "    my ( $self, $req ) = @_;"
NSQ_SOURCE_LINE 00000188 "    return join( \"; \", map { \"$_->{name}=$_->{value}\" } $self->cookies_for($req) );"
NSQ_SOURCE_LINE 00000189 "}"
NSQ_SOURCE_LINE 00000190 ""
NSQ_SOURCE_LINE 00000191 "#pod =method dump_cookies"
NSQ_SOURCE_LINE 00000192 "#pod"
NSQ_SOURCE_LINE 00000193 "#pod     my @list = $jar->dump_cookies;"
NSQ_SOURCE_LINE 00000194 "#pod     my @list = $jar->dump_cookies( { persistent => 1 } );"
NSQ_SOURCE_LINE 00000195 "#pod"
NSQ_SOURCE_LINE 00000196 "#pod Returns a list of raw cookies in string form.  The strings resemble what"
NSQ_SOURCE_LINE 00000197 "#pod would be received from C<Set-Cookie> headers, but with additional internal"
NSQ_SOURCE_LINE 00000198 "#pod fields.  The list is only intended for use with C<load_cookies> to allow"
NSQ_SOURCE_LINE 00000199 "#pod cookie jar persistence."
NSQ_SOURCE_LINE 00000200 "#pod"
NSQ_SOURCE_LINE 00000201 "#pod If a hash reference with a true C<persistent> key is given as an argument,"
NSQ_SOURCE_LINE 00000202 "#pod cookies without an C<Expires> time (i.e. \"session cookies\") will be omitted."
NSQ_SOURCE_LINE 00000203 "#pod"
NSQ_SOURCE_LINE 00000204 "#pod Here is a trivial example of saving a cookie jar file with L<Path::Tiny>:"
NSQ_SOURCE_LINE 00000205 "#pod"
NSQ_SOURCE_LINE 00000206 "#pod     path(\"jar.txt\")->spew( join \"\\n\", $jar->dump_cookies );"
NSQ_SOURCE_LINE 00000207 "#pod"
NSQ_SOURCE_LINE 00000208 "#pod =cut"
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "sub dump_cookies {"
NSQ_SOURCE_LINE 00000211 "    my ( $self, $args ) = @_;"
NSQ_SOURCE_LINE 00000212 "    my @list;"
NSQ_SOURCE_LINE 00000213 "    for my $c ( $self->_all_cookies ) {"
NSQ_SOURCE_LINE 00000214 "        my @parts = \"$c->{name}=$c->{value}\";"
NSQ_SOURCE_LINE 00000215 "        if ( defined $c->{expires} ) {"
NSQ_SOURCE_LINE 00000216 "            push @parts, 'Expires=' . HTTP::Date::time2str( $c->{expires} );"
NSQ_SOURCE_LINE 00000217 "        }"
NSQ_SOURCE_LINE 00000218 "        else {"
NSQ_SOURCE_LINE 00000219 "            next if $args->{persistent};"
NSQ_SOURCE_LINE 00000220 "        }"
NSQ_SOURCE_LINE 00000221 "        for my $attr (qw/Domain Path Creation_Time Last_Access_Time/) {"
NSQ_SOURCE_LINE 00000222 "            push @parts, \"$attr=$c->{lc $attr}\" if defined $c->{ lc $attr };"
NSQ_SOURCE_LINE 00000223 "        }"
NSQ_SOURCE_LINE 00000224 "        for my $attr (qw/Secure HttpOnly HostOnly/) {"
NSQ_SOURCE_LINE 00000225 "            push @parts, $attr if $c->{ lc $attr };"
NSQ_SOURCE_LINE 00000226 "        }"
NSQ_SOURCE_LINE 00000227 "        push @list, join( \"; \", @parts );"
NSQ_SOURCE_LINE 00000228 "    }"
NSQ_SOURCE_LINE 00000229 "    return @list;"
NSQ_SOURCE_LINE 00000230 "}"
NSQ_SOURCE_LINE 00000231 ""
NSQ_SOURCE_LINE 00000232 "#pod =method load_cookies"
NSQ_SOURCE_LINE 00000233 "#pod"
NSQ_SOURCE_LINE 00000234 "#pod     $jar->load_cookies( @cookies );"
NSQ_SOURCE_LINE 00000235 "#pod"
NSQ_SOURCE_LINE 00000236 "#pod Given a list of cookie strings from C<dump_cookies>, it adds them to"
NSQ_SOURCE_LINE 00000237 "#pod the cookie jar.  Cookies added in this way will supersede any existing"
NSQ_SOURCE_LINE 00000238 "#pod cookies with similar domain, path and name."
NSQ_SOURCE_LINE 00000239 "#pod"
NSQ_SOURCE_LINE 00000240 "#pod It returns the jar object for convenience when loading a new object:"
NSQ_SOURCE_LINE 00000241 "#pod"
NSQ_SOURCE_LINE 00000242 "#pod     my $jar = HTTP::CookieJar->new->load_cookies( @cookies );"
NSQ_SOURCE_LINE 00000243 "#pod"
NSQ_SOURCE_LINE 00000244 "#pod Here is a trivial example of loading a cookie jar file with L<Path::Tiny>:"
NSQ_SOURCE_LINE 00000245 "#pod"
NSQ_SOURCE_LINE 00000246 "#pod     my $jar = HTTP::CookieJar->new->load_cookies("
NSQ_SOURCE_LINE 00000247 "#pod         path(\"jar.txt\")->lines"
NSQ_SOURCE_LINE 00000248 "#pod     );"
NSQ_SOURCE_LINE 00000249 "#pod"
NSQ_SOURCE_LINE 00000250 "#pod =cut"
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "sub load_cookies {"
NSQ_SOURCE_LINE 00000253 "    my ( $self, @cookies ) = @_;"
NSQ_SOURCE_LINE 00000254 "    for my $cookie (@cookies) {"
NSQ_SOURCE_LINE 00000255 "        my $p = _parse_cookie( $cookie, 1 );"
NSQ_SOURCE_LINE 00000256 "        next unless exists $p->{domain} && exists $p->{path};"
NSQ_SOURCE_LINE 00000257 "        $p->{$_} = time for grep { !defined $p->{$_} } qw/creation_time last_access_time/;"
NSQ_SOURCE_LINE 00000258 "        $self->{store}{ $p->{domain} }{ $p->{path} }{ $p->{name} } = $p;"
NSQ_SOURCE_LINE 00000259 "    }"
NSQ_SOURCE_LINE 00000260 "    return $self;"
NSQ_SOURCE_LINE 00000261 "}"
NSQ_SOURCE_LINE 00000262 ""
NSQ_SOURCE_LINE 00000263 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000264 "# private methods"
NSQ_SOURCE_LINE 00000265 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "# return flattened list of all cookies"
NSQ_SOURCE_LINE 00000268 "sub _all_cookies {"
NSQ_SOURCE_LINE 00000269 "    return map { values %$_ } map { values %$_ } values %{ $_[0]->{store} };"
NSQ_SOURCE_LINE 00000270 "}"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000273 "# Helper subroutines"
NSQ_SOURCE_LINE 00000274 "#--------------------------------------------------------------------------#"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "my $pub_re = qr/(?:domain|path|expires|max-age|httponly|secure)/;"
NSQ_SOURCE_LINE 00000277 "my $pvt_re = qr/(?:$pub_re|creation_time|last_access_time|hostonly)/;"
NSQ_SOURCE_LINE 00000278 ""
NSQ_SOURCE_LINE 00000279 "sub _parse_cookie {"
NSQ_SOURCE_LINE 00000280 "    my ( $cookie, $private ) = @_;"
NSQ_SOURCE_LINE 00000281 "    $cookie = '' unless defined $cookie;"
NSQ_SOURCE_LINE 00000282 "    my ( $kvp, @attrs ) = split /;/, $cookie;"
NSQ_SOURCE_LINE 00000283 "    $kvp = '' unless defined $kvp;"
NSQ_SOURCE_LINE 00000284 "    my ( $name, $value ) ="
NSQ_SOURCE_LINE 00000285 "      map { s/^\\s*//; s/\\s*$//; $_ } split( /=/, $kvp, 2 ); ## no critic"
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "    return unless defined $name and length $name;"
NSQ_SOURCE_LINE 00000288 "    $value = '' unless defined $value;"
NSQ_SOURCE_LINE 00000289 "    my $parse = { name => $name, value => $value };"
NSQ_SOURCE_LINE 00000290 "    for my $s (@attrs) {"
NSQ_SOURCE_LINE 00000291 "        next unless defined $s && $s =~ /\\S/;"
NSQ_SOURCE_LINE 00000292 "        my ( $k, $v ) = map { s/^\\s*//; s/\\s*$//; $_ } split( /=/, $s, 2 ); ## no critic"
NSQ_SOURCE_LINE 00000293 "        $k = lc $k;"
NSQ_SOURCE_LINE 00000294 "        next unless $private ? ( $k =~ m/^$pvt_re$/ ) : ( $k =~ m/^$pub_re$/ );"
NSQ_SOURCE_LINE 00000295 "        $v = 1 if $k =~ m/^(?:httponly|secure|hostonly)$/; # boolean flag if present"
NSQ_SOURCE_LINE 00000296 "        $v = HTTP::Date::str2time($v) || 0 if $k eq 'expires'; # convert to epoch"
NSQ_SOURCE_LINE 00000297 "        next unless length $v;"
NSQ_SOURCE_LINE 00000298 "        $v =~ s{^\\.}{}                            if $k eq 'domain'; # strip leading dot"
NSQ_SOURCE_LINE 00000299 "        $v =~ s/%([0-9A-Fa-f]{2})/chr(hex($1))/eg if $k eq 'path';   # unescape"
NSQ_SOURCE_LINE 00000300 "        $parse->{$k} = $v;"
NSQ_SOURCE_LINE 00000301 "    }"
NSQ_SOURCE_LINE 00000302 "    return $parse;"
NSQ_SOURCE_LINE 00000303 "}"
NSQ_SOURCE_LINE 00000304 ""
NSQ_SOURCE_LINE 00000305 "sub _domain_match {"
NSQ_SOURCE_LINE 00000306 "    my ( $string, $dom_string ) = @_;"
NSQ_SOURCE_LINE 00000307 "    return 1 if $dom_string eq $string;"
NSQ_SOURCE_LINE 00000308 "    return unless $string =~ /[a-z]/i;                               # non-numeric"
NSQ_SOURCE_LINE 00000309 "    if ( $string =~ s{\\Q$dom_string\\E$}{} ) {"
NSQ_SOURCE_LINE 00000310 "        return substr( $string, -1, 1 ) eq '.';                      # \"foo.\""
NSQ_SOURCE_LINE 00000311 "    }"
NSQ_SOURCE_LINE 00000312 "    return;"
NSQ_SOURCE_LINE 00000313 "}"
NSQ_SOURCE_LINE 00000314 ""
NSQ_SOURCE_LINE 00000315 "sub _normalize_domain {"
NSQ_SOURCE_LINE 00000316 "    my ( $host, $parse ) = @_;"
NSQ_SOURCE_LINE 00000317 ""
NSQ_SOURCE_LINE 00000318 "    if ($HAS_MPS) {"
NSQ_SOURCE_LINE 00000319 "        my $host_pub_suff = eval { Mozilla::PublicSuffix::public_suffix($host) };"
NSQ_SOURCE_LINE 00000320 "        $host_pub_suff = '' unless defined $host_pub_suff;"
NSQ_SOURCE_LINE 00000321 "        if ( _domain_match( $host_pub_suff, $parse->{domain} ) ) {"
NSQ_SOURCE_LINE 00000322 "            if ( $parse->{domain} eq $host ) {"
NSQ_SOURCE_LINE 00000323 "                return $parse->{hostonly} = 1;"
NSQ_SOURCE_LINE 00000324 "            }"
NSQ_SOURCE_LINE 00000325 "            else {"
NSQ_SOURCE_LINE 00000326 "                return;"
NSQ_SOURCE_LINE 00000327 "            }"
NSQ_SOURCE_LINE 00000328 "        }"
NSQ_SOURCE_LINE 00000329 "    }"
NSQ_SOURCE_LINE 00000330 ""
NSQ_SOURCE_LINE 00000331 "    if ( $parse->{domain} !~ m{\\.} && $parse->{domain} eq $host ) {"
NSQ_SOURCE_LINE 00000332 "        return $parse->{hostonly} = 1;"
NSQ_SOURCE_LINE 00000333 "    }"
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "    return _domain_match( $host, $parse->{domain} );"
NSQ_SOURCE_LINE 00000336 "}"
NSQ_SOURCE_LINE 00000337 ""
NSQ_SOURCE_LINE 00000338 "sub _default_path {"
NSQ_SOURCE_LINE 00000339 "    my ($path) = @_;"
NSQ_SOURCE_LINE 00000340 "    return \"/\" if !length $path || substr( $path, 0, 1 ) ne \"/\";"
NSQ_SOURCE_LINE 00000341 "    my ($default) = $path =~ m{^(.*)/}; # greedy to last /"
NSQ_SOURCE_LINE 00000342 "    return length($default) ? $default : \"/\";"
NSQ_SOURCE_LINE 00000343 "}"
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "sub _path_match {"
NSQ_SOURCE_LINE 00000346 "    my ( $req_path, $cookie_path ) = @_;"
NSQ_SOURCE_LINE 00000347 "    return 1 if $req_path eq $cookie_path;"
NSQ_SOURCE_LINE 00000348 "    if ( $req_path =~ m{^\\Q$cookie_path\\E(.*)} ) {"
NSQ_SOURCE_LINE 00000349 "        my $rest = $1;"
NSQ_SOURCE_LINE 00000350 "        return 1 if substr( $cookie_path, -1, 1 ) eq '/';"
NSQ_SOURCE_LINE 00000351 "        return 1 if substr( $rest,        0,  1 ) eq '/';"
NSQ_SOURCE_LINE 00000352 "    }"
NSQ_SOURCE_LINE 00000353 "    return;"
NSQ_SOURCE_LINE 00000354 "}"
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "sub _split_url {"
NSQ_SOURCE_LINE 00000357 "    my $url = shift;"
NSQ_SOURCE_LINE 00000358 "    die(qq/No URL provided\\n/) unless defined $url and length $url;"
NSQ_SOURCE_LINE 00000359 ""
NSQ_SOURCE_LINE 00000360 "    # URI regex adapted from the URI module"
NSQ_SOURCE_LINE 00000361 "    # XXX path_query here really chops at ? or # to get just the path and not the query"
NSQ_SOURCE_LINE 00000362 "    my ( $scheme, $authority, $path_query ) = $url =~ m<\\A([^:/?#]+)://([^/?#]*)([^#?]*)>"
NSQ_SOURCE_LINE 00000363 "      or die(qq/Cannot parse URL: '$url'\\n/);"
NSQ_SOURCE_LINE 00000364 ""
NSQ_SOURCE_LINE 00000365 "    $scheme = lc $scheme;"
NSQ_SOURCE_LINE 00000366 "    $path_query = \"/$path_query\" unless $path_query =~ m<\\A/>;"
NSQ_SOURCE_LINE 00000367 "    $path_query =~ s/%([0-9A-Fa-f]{2})/chr(hex($1))/eg;"
NSQ_SOURCE_LINE 00000368 ""
NSQ_SOURCE_LINE 00000369 "    my $host = ( length($authority) ) ? lc $authority : 'localhost';"
NSQ_SOURCE_LINE 00000370 "    $host =~ s/\\A[^@]*@//; # userinfo"
NSQ_SOURCE_LINE 00000371 "    my $port = do {"
NSQ_SOURCE_LINE 00000372 "        $host =~ s/:([0-9]*)\\z// && length $1"
NSQ_SOURCE_LINE 00000373 "          ? $1"
NSQ_SOURCE_LINE 00000374 "          : ( $scheme eq 'http' ? 80 : $scheme eq 'https' ? 443 : undef );"
NSQ_SOURCE_LINE 00000375 "    };"
NSQ_SOURCE_LINE 00000376 ""
NSQ_SOURCE_LINE 00000377 "    return ( $scheme, $host, $port, $path_query );"
NSQ_SOURCE_LINE 00000378 "}"
NSQ_SOURCE_LINE 00000379 ""
NSQ_SOURCE_LINE 00000380 "1;"
NSQ_SOURCE_LINE 00000381 ""
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "# vim: ts=4 sts=4 sw=4 et:"
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "__END__"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "=pod"
NSQ_SOURCE_LINE 00000388 ""
NSQ_SOURCE_LINE 00000389 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000390 ""
NSQ_SOURCE_LINE 00000391 "=head1 NAME"
NSQ_SOURCE_LINE 00000392 ""
NSQ_SOURCE_LINE 00000393 "HTTP::CookieJar - A minimalist HTTP user agent cookie jar"
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "=head1 VERSION"
NSQ_SOURCE_LINE 00000396 ""
NSQ_SOURCE_LINE 00000397 "version 0.014"
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "  use HTTP::CookieJar;"
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "  my $jar = HTTP::CookieJar->new;"
NSQ_SOURCE_LINE 00000404 ""
NSQ_SOURCE_LINE 00000405 "  # add cookie received from a request"
NSQ_SOURCE_LINE 00000406 "  $jar->add( \"http://www.example.com/\", \"CUSTOMER=WILE_E_COYOTE; Path=/; Domain=example.com\" );"
NSQ_SOURCE_LINE 00000407 ""
NSQ_SOURCE_LINE 00000408 "  # extract cookie header for a given request"
NSQ_SOURCE_LINE 00000409 "  my $cookie = $jar->cookie_header( \"http://www.example.com/\" );"
NSQ_SOURCE_LINE 00000410 ""
NSQ_SOURCE_LINE 00000411 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000412 ""
NSQ_SOURCE_LINE 00000413 "This module implements a minimalist HTTP user agent cookie jar in"
NSQ_SOURCE_LINE 00000414 "conformance with L<RFC 6265|http://tools.ietf.org/html/rfc6265>."
NSQ_SOURCE_LINE 00000415 ""
NSQ_SOURCE_LINE 00000416 "Unlike the commonly used L<HTTP::Cookies> module, this module does"
NSQ_SOURCE_LINE 00000417 "not require use of L<HTTP::Request> and L<HTTP::Response> objects."
NSQ_SOURCE_LINE 00000418 "An LWP-compatible adapter is available as L<HTTP::CookieJar::LWP>."
NSQ_SOURCE_LINE 00000419 ""
NSQ_SOURCE_LINE 00000420 "=head1 CONSTRUCTORS"
NSQ_SOURCE_LINE 00000421 ""
NSQ_SOURCE_LINE 00000422 "=head2 new"
NSQ_SOURCE_LINE 00000423 ""
NSQ_SOURCE_LINE 00000424 "    my $jar = HTTP::CookieJar->new;"
NSQ_SOURCE_LINE 00000425 ""
NSQ_SOURCE_LINE 00000426 "Return a new, empty cookie jar"
NSQ_SOURCE_LINE 00000427 ""
NSQ_SOURCE_LINE 00000428 "=head1 METHODS"
NSQ_SOURCE_LINE 00000429 ""
NSQ_SOURCE_LINE 00000430 "=head2 add"
NSQ_SOURCE_LINE 00000431 ""
NSQ_SOURCE_LINE 00000432 "    $jar->add("
NSQ_SOURCE_LINE 00000433 "        \"http://www.example.com/\", \"lang=en-US; Path=/; Domain=example.com\""
NSQ_SOURCE_LINE 00000434 "    );"
NSQ_SOURCE_LINE 00000435 ""
NSQ_SOURCE_LINE 00000436 "Given a request URL and a C<Set-Cookie> header string, attempts to adds the"
NSQ_SOURCE_LINE 00000437 "cookie to the jar.  If the cookie is expired, instead it deletes any matching"
NSQ_SOURCE_LINE 00000438 "cookie from the jar.  A C<Max-Age> attribute will be converted to an absolute"
NSQ_SOURCE_LINE 00000439 "C<Expires> attribute."
NSQ_SOURCE_LINE 00000440 ""
NSQ_SOURCE_LINE 00000441 "It will throw an exception if the request URL is missing or invalid.  Returns true if"
NSQ_SOURCE_LINE 00000442 "successful cookie processing or undef/empty-list on failure."
NSQ_SOURCE_LINE 00000443 ""
NSQ_SOURCE_LINE 00000444 "=head2 clear"
NSQ_SOURCE_LINE 00000445 ""
NSQ_SOURCE_LINE 00000446 "    $jar->clear"
NSQ_SOURCE_LINE 00000447 ""
NSQ_SOURCE_LINE 00000448 "Empties the cookie jar."
NSQ_SOURCE_LINE 00000449 ""
NSQ_SOURCE_LINE 00000450 "=head2 cookies_for"
NSQ_SOURCE_LINE 00000451 ""
NSQ_SOURCE_LINE 00000452 "    my @cookies = $jar->cookies_for(\"http://www.example.com/foo/bar\");"
NSQ_SOURCE_LINE 00000453 ""
NSQ_SOURCE_LINE 00000454 "Given a request URL, returns a list of hash references representing cookies"
NSQ_SOURCE_LINE 00000455 "that should be sent.  The hash references are copies -- changing values"
NSQ_SOURCE_LINE 00000456 "will not change the cookies in the jar."
NSQ_SOURCE_LINE 00000457 ""
NSQ_SOURCE_LINE 00000458 "Cookies set C<secure> will only be returned if the request scheme is C<https>."
NSQ_SOURCE_LINE 00000459 "Expired cookies will not be returned."
NSQ_SOURCE_LINE 00000460 ""
NSQ_SOURCE_LINE 00000461 "Keys of a cookie hash reference might include:"
NSQ_SOURCE_LINE 00000462 ""
NSQ_SOURCE_LINE 00000463 "=over 4"
NSQ_SOURCE_LINE 00000464 ""
NSQ_SOURCE_LINE 00000465 "=item *"
NSQ_SOURCE_LINE 00000466 ""
NSQ_SOURCE_LINE 00000467 "name -- the name of the cookie"
NSQ_SOURCE_LINE 00000468 ""
NSQ_SOURCE_LINE 00000469 "=item *"
NSQ_SOURCE_LINE 00000470 ""
NSQ_SOURCE_LINE 00000471 "value -- the value of the cookie"
NSQ_SOURCE_LINE 00000472 ""
NSQ_SOURCE_LINE 00000473 "=item *"
NSQ_SOURCE_LINE 00000474 ""
NSQ_SOURCE_LINE 00000475 "domain -- the domain name to which the cookie applies"
NSQ_SOURCE_LINE 00000476 ""
NSQ_SOURCE_LINE 00000477 "=item *"
NSQ_SOURCE_LINE 00000478 ""
NSQ_SOURCE_LINE 00000479 "path -- the path to which the cookie applies"
NSQ_SOURCE_LINE 00000480 ""
NSQ_SOURCE_LINE 00000481 "=item *"
NSQ_SOURCE_LINE 00000482 ""
NSQ_SOURCE_LINE 00000483 "expires -- if present, when the cookie expires in epoch seconds"
NSQ_SOURCE_LINE 00000484 ""
NSQ_SOURCE_LINE 00000485 "=item *"
NSQ_SOURCE_LINE 00000486 ""
NSQ_SOURCE_LINE 00000487 "secure -- if present, the cookie was set C<Secure>"
NSQ_SOURCE_LINE 00000488 ""
NSQ_SOURCE_LINE 00000489 "=item *"
NSQ_SOURCE_LINE 00000490 ""
NSQ_SOURCE_LINE 00000491 "httponly -- if present, the cookie was set C<HttpOnly>"
NSQ_SOURCE_LINE 00000492 ""
NSQ_SOURCE_LINE 00000493 "=item *"
NSQ_SOURCE_LINE 00000494 ""
NSQ_SOURCE_LINE 00000495 "hostonly -- if present, the cookie may only be used with the domain as a host"
NSQ_SOURCE_LINE 00000496 ""
NSQ_SOURCE_LINE 00000497 "=item *"
NSQ_SOURCE_LINE 00000498 ""
NSQ_SOURCE_LINE 00000499 "creation_time -- epoch time when the cookie was first stored"
NSQ_SOURCE_LINE 00000500 ""
NSQ_SOURCE_LINE 00000501 "=item *"
NSQ_SOURCE_LINE 00000502 ""
NSQ_SOURCE_LINE 00000503 "last_access_time -- epoch time when the cookie was last accessed (i.e. \"now\")"
NSQ_SOURCE_LINE 00000504 ""
NSQ_SOURCE_LINE 00000505 "=back"
NSQ_SOURCE_LINE 00000506 ""
NSQ_SOURCE_LINE 00000507 "Keep in mind that C<httponly> means it should only be used in requests and not"
NSQ_SOURCE_LINE 00000508 "made available via Javascript, etc.  This is pretty meaningless for Perl user"
NSQ_SOURCE_LINE 00000509 "agents."
NSQ_SOURCE_LINE 00000510 ""
NSQ_SOURCE_LINE 00000511 "Generally, user agents should use the C<cookie_header> method instead."
NSQ_SOURCE_LINE 00000512 ""
NSQ_SOURCE_LINE 00000513 "It will throw an exception if the request URL is missing or invalid."
NSQ_SOURCE_LINE 00000514 ""
NSQ_SOURCE_LINE 00000515 "=head2 cookie_header"
NSQ_SOURCE_LINE 00000516 ""
NSQ_SOURCE_LINE 00000517 "    my $header = $jar->cookie_header(\"http://www.example.com/foo/bar\");"
NSQ_SOURCE_LINE 00000518 ""
NSQ_SOURCE_LINE 00000519 "Given a request URL, returns a correctly-formatted string with all relevant"
NSQ_SOURCE_LINE 00000520 "cookies for the request.  This string is ready to be used in a C<Cookie> header"
NSQ_SOURCE_LINE 00000521 "in an HTTP request.  E.g.:"
NSQ_SOURCE_LINE 00000522 ""
NSQ_SOURCE_LINE 00000523 "    SID=31d4d96e407aad42; lang=en-US"
NSQ_SOURCE_LINE 00000524 ""
NSQ_SOURCE_LINE 00000525 "It follows the same exclusion rules as C<cookies_for>."
NSQ_SOURCE_LINE 00000526 ""
NSQ_SOURCE_LINE 00000527 "If the request is invalid or no cookies apply, it will return an empty string."
NSQ_SOURCE_LINE 00000528 ""
NSQ_SOURCE_LINE 00000529 "=head2 dump_cookies"
NSQ_SOURCE_LINE 00000530 ""
NSQ_SOURCE_LINE 00000531 "    my @list = $jar->dump_cookies;"
NSQ_SOURCE_LINE 00000532 "    my @list = $jar->dump_cookies( { persistent => 1 } );"
NSQ_SOURCE_LINE 00000533 ""
NSQ_SOURCE_LINE 00000534 "Returns a list of raw cookies in string form.  The strings resemble what"
NSQ_SOURCE_LINE 00000535 "would be received from C<Set-Cookie> headers, but with additional internal"
NSQ_SOURCE_LINE 00000536 "fields.  The list is only intended for use with C<load_cookies> to allow"
NSQ_SOURCE_LINE 00000537 "cookie jar persistence."
NSQ_SOURCE_LINE 00000538 ""
NSQ_SOURCE_LINE 00000539 "If a hash reference with a true C<persistent> key is given as an argument,"
NSQ_SOURCE_LINE 00000540 "cookies without an C<Expires> time (i.e. \"session cookies\") will be omitted."
NSQ_SOURCE_LINE 00000541 ""
NSQ_SOURCE_LINE 00000542 "Here is a trivial example of saving a cookie jar file with L<Path::Tiny>:"
NSQ_SOURCE_LINE 00000543 ""
NSQ_SOURCE_LINE 00000544 "    path(\"jar.txt\")->spew( join \"\\n\", $jar->dump_cookies );"
NSQ_SOURCE_LINE 00000545 ""
NSQ_SOURCE_LINE 00000546 "=head2 load_cookies"
NSQ_SOURCE_LINE 00000547 ""
NSQ_SOURCE_LINE 00000548 "    $jar->load_cookies( @cookies );"
NSQ_SOURCE_LINE 00000549 ""
NSQ_SOURCE_LINE 00000550 "Given a list of cookie strings from C<dump_cookies>, it adds them to"
NSQ_SOURCE_LINE 00000551 "the cookie jar.  Cookies added in this way will supersede any existing"
NSQ_SOURCE_LINE 00000552 "cookies with similar domain, path and name."
NSQ_SOURCE_LINE 00000553 ""
NSQ_SOURCE_LINE 00000554 "It returns the jar object for convenience when loading a new object:"
NSQ_SOURCE_LINE 00000555 ""
NSQ_SOURCE_LINE 00000556 "    my $jar = HTTP::CookieJar->new->load_cookies( @cookies );"
NSQ_SOURCE_LINE 00000557 ""
NSQ_SOURCE_LINE 00000558 "Here is a trivial example of loading a cookie jar file with L<Path::Tiny>:"
NSQ_SOURCE_LINE 00000559 ""
NSQ_SOURCE_LINE 00000560 "    my $jar = HTTP::CookieJar->new->load_cookies("
NSQ_SOURCE_LINE 00000561 "        path(\"jar.txt\")->lines"
NSQ_SOURCE_LINE 00000562 "    );"
NSQ_SOURCE_LINE 00000563 ""
NSQ_SOURCE_LINE 00000564 "=for Pod::Coverage method_names_here"
NSQ_SOURCE_LINE 00000565 ""
NSQ_SOURCE_LINE 00000566 "=head1 LIMITATIONS AND CAVEATS"
NSQ_SOURCE_LINE 00000567 ""
NSQ_SOURCE_LINE 00000568 "=head2 RFC 6265 vs prior standards"
NSQ_SOURCE_LINE 00000569 ""
NSQ_SOURCE_LINE 00000570 "This modules adheres as closely as possible to the user-agent rules"
NSQ_SOURCE_LINE 00000571 "of RFC 6265.  Therefore, it does not handle nor generate C<Set-Cookie2>"
NSQ_SOURCE_LINE 00000572 "and C<Cookie2> headers, implement C<.local> suffixes, or do path/domain"
NSQ_SOURCE_LINE 00000573 "matching in accord with prior RFC's."
NSQ_SOURCE_LINE 00000574 ""
NSQ_SOURCE_LINE 00000575 "=head2 Internationalized domain names"
NSQ_SOURCE_LINE 00000576 ""
NSQ_SOURCE_LINE 00000577 "Internationalized domain names given in requests must be properly"
NSQ_SOURCE_LINE 00000578 "encoded in ASCII form."
NSQ_SOURCE_LINE 00000579 ""
NSQ_SOURCE_LINE 00000580 "=head2 Public suffixes"
NSQ_SOURCE_LINE 00000581 ""
NSQ_SOURCE_LINE 00000582 "If L<Mozilla::PublicSuffix> is installed, cookie domains will be checked"
NSQ_SOURCE_LINE 00000583 "against the public suffix list.  Public suffix cookies are only allowed"
NSQ_SOURCE_LINE 00000584 "as host-only cookies."
NSQ_SOURCE_LINE 00000585 ""
NSQ_SOURCE_LINE 00000586 "=head2 Third-party cookies"
NSQ_SOURCE_LINE 00000587 ""
NSQ_SOURCE_LINE 00000588 "According to RFC 6265, a cookie may be accepted only if has no C<Domain>"
NSQ_SOURCE_LINE 00000589 "attribute (in which case it is \"host-only\") or if the C<Domain> attribute is a"
NSQ_SOURCE_LINE 00000590 "suffix of the request URL.  This effectively prohibits Site A from setting a"
NSQ_SOURCE_LINE 00000591 "cookie for unrelated Site B, which is one potential third-party cookie vector."
NSQ_SOURCE_LINE 00000592 ""
NSQ_SOURCE_LINE 00000593 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000594 ""
NSQ_SOURCE_LINE 00000595 "=over 4"
NSQ_SOURCE_LINE 00000596 ""
NSQ_SOURCE_LINE 00000597 "=item *"
NSQ_SOURCE_LINE 00000598 ""
NSQ_SOURCE_LINE 00000599 "L<HTTP::Cookies>"
NSQ_SOURCE_LINE 00000600 ""
NSQ_SOURCE_LINE 00000601 "=item *"
NSQ_SOURCE_LINE 00000602 ""
NSQ_SOURCE_LINE 00000603 "L<Mojo::UserAgent::CookieJar>"
NSQ_SOURCE_LINE 00000604 ""
NSQ_SOURCE_LINE 00000605 "=back"
NSQ_SOURCE_LINE 00000606 ""
NSQ_SOURCE_LINE 00000607 "=for :stopwords cpan testmatrix url bugtracker rt cpants kwalitee diff irc mailto metadata placeholders metacpan"
