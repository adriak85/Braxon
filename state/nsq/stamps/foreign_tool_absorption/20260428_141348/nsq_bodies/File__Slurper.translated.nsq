BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package File::Slurper;"
NSQ_SOURCE_LINE 00000002 "$File::Slurper::VERSION = '0.014';"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "use Carp 'croak';"
NSQ_SOURCE_LINE 00000007 "use Exporter 5.57 'import';"
NSQ_SOURCE_LINE 00000008 ""
NSQ_SOURCE_LINE 00000009 "use Encode 2.11 qw/FB_CROAK STOP_AT_PARTIAL/;"
NSQ_SOURCE_LINE 00000010 "use PerlIO::encoding;"
NSQ_SOURCE_LINE 00000011 ""
NSQ_SOURCE_LINE 00000012 "our @EXPORT_OK = qw/read_binary read_text read_lines write_binary write_text read_dir/;"
NSQ_SOURCE_LINE 00000013 ""
NSQ_SOURCE_LINE 00000014 "sub read_binary {"
NSQ_SOURCE_LINE 00000015 "\tmy $filename = shift;"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "\t# This logic is a bit ugly, but gives a significant speed boost"
NSQ_SOURCE_LINE 00000018 "\t# because slurpy readline is not optimized for non-buffered usage"
NSQ_SOURCE_LINE 00000019 "\topen my $fh, '<:unix', $filename or croak \"Couldn't open $filename: $!\";"
NSQ_SOURCE_LINE 00000020 "\tif (my $size = -s $fh) {"
NSQ_SOURCE_LINE 00000021 "\t\tmy $buf;"
NSQ_SOURCE_LINE 00000022 "\t\tmy ($pos, $read) = 0;"
NSQ_SOURCE_LINE 00000023 "\t\tdo {"
NSQ_SOURCE_LINE 00000024 "\t\t\tdefined($read = read $fh, ${$buf}, $size - $pos, $pos) or croak \"Couldn't read $filename: $!\";"
NSQ_SOURCE_LINE 00000025 "\t\t\t$pos += $read;"
NSQ_SOURCE_LINE 00000026 "\t\t} while ($read && $pos < $size);"
NSQ_SOURCE_LINE 00000027 "\t\treturn ${$buf};"
NSQ_SOURCE_LINE 00000028 "\t}"
NSQ_SOURCE_LINE 00000029 "\telse {"
NSQ_SOURCE_LINE 00000030 "\t\treturn do { local $/; <$fh> };"
NSQ_SOURCE_LINE 00000031 "\t}"
NSQ_SOURCE_LINE 00000032 "}"
NSQ_SOURCE_LINE 00000033 ""
NSQ_SOURCE_LINE 00000034 "use constant {"
NSQ_SOURCE_LINE 00000035 "\tCRLF_DEFAULT => $^O eq 'MSWin32',"
NSQ_SOURCE_LINE 00000036 "\tHAS_UTF8_STRICT => scalar do { local $@; eval { require PerlIO::utf8_strict } },"
NSQ_SOURCE_LINE 00000037 "};"
NSQ_SOURCE_LINE 00000038 ""
NSQ_SOURCE_LINE 00000039 "sub _text_layers {"
NSQ_SOURCE_LINE 00000040 "\tmy ($encoding, $crlf) = @_;"
NSQ_SOURCE_LINE 00000041 "\t$crlf = CRLF_DEFAULT if $crlf && $crlf eq 'auto';"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "\tif (HAS_UTF8_STRICT && $encoding =~ /^utf-?8\\b/i) {"
NSQ_SOURCE_LINE 00000044 "\t\treturn $crlf ? ':unix:utf8_strict:crlf' : ':unix:utf8_strict';"
NSQ_SOURCE_LINE 00000045 "\t}"
NSQ_SOURCE_LINE 00000046 "\telse {"
NSQ_SOURCE_LINE 00000047 "\t\t# non-ascii compatible encodings such as UTF-16 need encoding before crlf"
NSQ_SOURCE_LINE 00000048 "\t\treturn $crlf ? \":raw:encoding($encoding):crlf\" : \":raw:encoding($encoding)\";"
NSQ_SOURCE_LINE 00000049 "\t}"
NSQ_SOURCE_LINE 00000050 "}"
NSQ_SOURCE_LINE 00000051 ""
NSQ_SOURCE_LINE 00000052 "sub read_text {"
NSQ_SOURCE_LINE 00000053 "\tmy ($filename, $encoding, $crlf) = @_;"
NSQ_SOURCE_LINE 00000054 "\t$encoding ||= 'utf-8';"
NSQ_SOURCE_LINE 00000055 "\tmy $layer = _text_layers($encoding, $crlf);"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 "\tlocal $PerlIO::encoding::fallback = STOP_AT_PARTIAL | FB_CROAK;"
NSQ_SOURCE_LINE 00000058 "\topen my $fh, \"<$layer\", $filename or croak \"Couldn't open $filename: $!\";"
NSQ_SOURCE_LINE 00000059 "\treturn scalar do { local $/; <$fh> };"
NSQ_SOURCE_LINE 00000060 "}"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 "sub write_text {"
NSQ_SOURCE_LINE 00000063 "\tmy ($filename, undef, $encoding, $crlf) = @_;"
NSQ_SOURCE_LINE 00000064 "\t$encoding ||= 'utf-8';"
NSQ_SOURCE_LINE 00000065 "\tmy $layer = _text_layers($encoding, $crlf);"
NSQ_SOURCE_LINE 00000066 ""
NSQ_SOURCE_LINE 00000067 "\tlocal $PerlIO::encoding::fallback = STOP_AT_PARTIAL | FB_CROAK;"
NSQ_SOURCE_LINE 00000068 "\topen my $fh, \">$layer\", $filename or croak \"Couldn't open $filename: $!\";"
NSQ_SOURCE_LINE 00000069 "\tprint $fh $_[1] or croak \"Couldn't write to $filename: $!\";"
NSQ_SOURCE_LINE 00000070 "\tclose $fh or croak \"Couldn't write to $filename: $!\";"
NSQ_SOURCE_LINE 00000071 "\treturn;"
NSQ_SOURCE_LINE 00000072 "}"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "sub write_binary {"
NSQ_SOURCE_LINE 00000075 "\tmy $filename = $_[0];"
NSQ_SOURCE_LINE 00000076 "\topen my $fh, \">:raw\", $filename or croak \"Couldn't open $filename: $!\";"
NSQ_SOURCE_LINE 00000077 "\tprint $fh $_[1] or croak \"Couldn't write to $filename: $!\";"
NSQ_SOURCE_LINE 00000078 "\tclose $fh or croak \"Couldn't write to $filename: $!\";"
NSQ_SOURCE_LINE 00000079 "\treturn;"
NSQ_SOURCE_LINE 00000080 "}"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "sub read_lines {"
NSQ_SOURCE_LINE 00000083 "\tmy ($filename, $encoding, $crlf, $skip_chomp) = @_;"
NSQ_SOURCE_LINE 00000084 "\t$encoding ||= 'utf-8';"
NSQ_SOURCE_LINE 00000085 "\tmy $layer = _text_layers($encoding, $crlf);"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "\tlocal $PerlIO::encoding::fallback = STOP_AT_PARTIAL | FB_CROAK;"
NSQ_SOURCE_LINE 00000088 "\topen my $fh, \"<$layer\", $filename or croak \"Couldn't open $filename: $!\";"
NSQ_SOURCE_LINE 00000089 "\tlocal $/ = \"\\n\";"
NSQ_SOURCE_LINE 00000090 "\treturn <$fh> if $skip_chomp;"
NSQ_SOURCE_LINE 00000091 "\tmy @buf = <$fh>;"
NSQ_SOURCE_LINE 00000092 "\tclose $fh;"
NSQ_SOURCE_LINE 00000093 "\tchomp @buf;"
NSQ_SOURCE_LINE 00000094 "\treturn @buf;"
NSQ_SOURCE_LINE 00000095 "}"
NSQ_SOURCE_LINE 00000096 ""
NSQ_SOURCE_LINE 00000097 "sub read_dir {"
NSQ_SOURCE_LINE 00000098 "\tmy ($dirname) = @_;"
NSQ_SOURCE_LINE 00000099 "\topendir my ($dir), $dirname or croak \"Could not open $dirname: $!\";"
NSQ_SOURCE_LINE 00000100 "\treturn grep { not m/ \\A \\.\\.? \\z /x } readdir $dir;"
NSQ_SOURCE_LINE 00000101 "}"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "1;"
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "# ABSTRACT: A simple, sane and efficient module to slurp a file"
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "__END__"
NSQ_SOURCE_LINE 00000108 ""
NSQ_SOURCE_LINE 00000109 "=pod"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "=head1 NAME"
NSQ_SOURCE_LINE 00000114 ""
NSQ_SOURCE_LINE 00000115 "File::Slurper - A simple, sane and efficient module to slurp a file"
NSQ_SOURCE_LINE 00000116 ""
NSQ_SOURCE_LINE 00000117 "=head1 VERSION"
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "version 0.014"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000122 ""
NSQ_SOURCE_LINE 00000123 " use File::Slurper 'read_text';"
NSQ_SOURCE_LINE 00000124 " my $content = read_text($filename);"
NSQ_SOURCE_LINE 00000125 ""
NSQ_SOURCE_LINE 00000126 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "This module provides functions for fast and correct slurping and spewing. All functions are optionally exported. All functions throw exceptions on errors, write functions don't return any meaningful value."
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "=head1 FUNCTIONS"
NSQ_SOURCE_LINE 00000131 ""
NSQ_SOURCE_LINE 00000132 "=head2 read_text($filename, $encoding, $crlf)"
NSQ_SOURCE_LINE 00000133 ""
NSQ_SOURCE_LINE 00000134 "Reads file C<$filename> into a scalar and decodes it from C<$encoding> (which defaults to UTF-8). If C<$crlf> is true, crlf translation is performed. The default for this argument is off. The special value C<'auto'> will set it to a platform specific default value."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=head2 read_binary($filename)"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "Reads file C<$filename> into a scalar without any decoding or transformation."
NSQ_SOURCE_LINE 00000139 ""
NSQ_SOURCE_LINE 00000140 "=head2 read_lines($filename, $encoding, $crlf, $skip_chomp)"
NSQ_SOURCE_LINE 00000141 ""
NSQ_SOURCE_LINE 00000142 "Reads file C<$filename> into a list/array line-by-line, after decoding from C<$encoding>, optional crlf translation and chomping. It will always use newline as separator."
NSQ_SOURCE_LINE 00000143 ""
NSQ_SOURCE_LINE 00000144 "=head2 write_text($filename, $content, $encoding, $crlf)"
NSQ_SOURCE_LINE 00000145 ""
NSQ_SOURCE_LINE 00000146 "Writes C<$content> to file C<$filename>, encoding it to C<$encoding> (which defaults to UTF-8). It can also take a C<crlf> argument that works exactly as in read_text."
NSQ_SOURCE_LINE 00000147 ""
NSQ_SOURCE_LINE 00000148 "=head2 write_binary($filename, $content)"
NSQ_SOURCE_LINE 00000149 ""
NSQ_SOURCE_LINE 00000150 "Writes C<$content> to file C<$filename> as binary data."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=head2 read_dir($dirname)"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "Open C<dirname> and return all entries except C<.> and C<..>."
NSQ_SOURCE_LINE 00000155 ""
NSQ_SOURCE_LINE 00000156 "=head1 RATIONALE"
NSQ_SOURCE_LINE 00000157 ""
NSQ_SOURCE_LINE 00000158 "This module tries to make it as easy as possible to read and write files correctly and fast. The most correct way of doing this is not always obvious (e.g. L<#83126|https://rt.cpan.org/Public/Bug/Display.html?id=83126>), and just as often the most obvious correct way is not the fastest correct way. This module hides away all such complications behind an easy intuitive interface."
NSQ_SOURCE_LINE 00000159 ""
NSQ_SOURCE_LINE 00000160 "=head1 DEPENDENCIES"
NSQ_SOURCE_LINE 00000161 ""
NSQ_SOURCE_LINE 00000162 "This module has an optional dependency on L<PerlIO::utf8_strict|PerlIO::utf8_strict>. Installing this will make UTF-8 encoded IO significantly faster, but should not otherwise affect the operation of this module. This may change into a dependency on the related Unicode::UTF8 in the future."
NSQ_SOURCE_LINE 00000163 ""
NSQ_SOURCE_LINE 00000164 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000165 ""
NSQ_SOURCE_LINE 00000166 "=over 4"
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=item * L<Path::Tiny|Path::Tiny>"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "A minimalistic abstraction handling not only IO but also paths."
NSQ_SOURCE_LINE 00000171 ""
NSQ_SOURCE_LINE 00000172 "=item * L<IO::All|IO::All>"
NSQ_SOURCE_LINE 00000173 ""
NSQ_SOURCE_LINE 00000174 "An attempt to expose as many IO related features as possible via a single API."
NSQ_SOURCE_LINE 00000175 ""
NSQ_SOURCE_LINE 00000176 "=item * L<File::Slurp|File::Slurp>"
NSQ_SOURCE_LINE 00000177 ""
NSQ_SOURCE_LINE 00000178 "This is a previous generation file slurping module. It has a number of issues, as described L<here|http://blogs.perl.org/users/leon_timmermans/2015/08/fileslurp-is-broken-and-wrong.html>."
NSQ_SOURCE_LINE 00000179 ""
NSQ_SOURCE_LINE 00000180 "=item * L<File::Slurp::Tiny|File::Slurp::Tiny>"
NSQ_SOURCE_LINE 00000181 ""
NSQ_SOURCE_LINE 00000182 "This was my previous attempt at a better file slurping module. It's mostly (but not entirely) a drop-in replacement for File::Slurp, which is both a feature (easy conversion) and a bug (interface issues)."
NSQ_SOURCE_LINE 00000183 ""
NSQ_SOURCE_LINE 00000184 "=back"
NSQ_SOURCE_LINE 00000185 ""
NSQ_SOURCE_LINE 00000186 "=head1 TODO"
NSQ_SOURCE_LINE 00000187 ""
NSQ_SOURCE_LINE 00000188 "=over 4"
NSQ_SOURCE_LINE 00000189 ""
NSQ_SOURCE_LINE 00000190 "=item * C<open_text>/C<open_binary>?"
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=item * C<drain_handle>?"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "=back"
NSQ_SOURCE_LINE 00000195 ""
