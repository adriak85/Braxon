NSQ_SOURCE_LINE 00000010 "#"
NSQ_SOURCE_LINE 00000011 "###############################################################################"
NSQ_SOURCE_LINE 00000012 ""
NSQ_SOURCE_LINE 00000013 "###############################################################################"
NSQ_SOURCE_LINE 00000014 "##                 L I B R A R I E S / M O D U L E S"
NSQ_SOURCE_LINE 00000015 "###############################################################################"
NSQ_SOURCE_LINE 00000016 ""
NSQ_SOURCE_LINE 00000017 "package Logfile::Rotate;"
NSQ_SOURCE_LINE 00000018 ""
NSQ_SOURCE_LINE 00000019 "use Config;    # do we have gzip"
NSQ_SOURCE_LINE 00000020 "use Carp;"
NSQ_SOURCE_LINE 00000021 "use IO::File;"
NSQ_SOURCE_LINE 00000022 "use File::Copy;"
NSQ_SOURCE_LINE 00000023 "use Fcntl qw(:flock); "
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "use strict;"
NSQ_SOURCE_LINE 00000026 ""
NSQ_SOURCE_LINE 00000027 "###############################################################################"
NSQ_SOURCE_LINE 00000028 "##                  G L O B A L   V A R I A B L E S"
NSQ_SOURCE_LINE 00000029 "###############################################################################"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "use vars qw($VERSION $COUNT $GZIP_FLAG);"
NSQ_SOURCE_LINE 00000032 ""
NSQ_SOURCE_LINE 00000033 "$VERSION = do { my @r=(q$Revision: 1.5 $=~/\\d+/g); sprintf \"%d.\".\"%02d\"x$#r,@r};"
NSQ_SOURCE_LINE 00000034 "$COUNT   =7; # default to keep 7 copies"
NSQ_SOURCE_LINE 00000035 "$GZIP_FLAG='-qf'; # force writing over old logfiles"
NSQ_SOURCE_LINE 00000036 ""
NSQ_SOURCE_LINE 00000037 "###############################################################################"
NSQ_SOURCE_LINE 00000038 "##                         E X P O R T S"
NSQ_SOURCE_LINE 00000039 "###############################################################################"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "###############################################################################"
NSQ_SOURCE_LINE 00000042 "##                             M A I N"
NSQ_SOURCE_LINE 00000043 "###############################################################################"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "sub new {"
NSQ_SOURCE_LINE 00000046 "\tmy ($class, %args) = @_;"
NSQ_SOURCE_LINE 00000047 ""
NSQ_SOURCE_LINE 00000048 "\tcroak(\"usage: new( File => filename "
NSQ_SOURCE_LINE 00000049 "\t\t\t\t[, Count    => cnt ]"
NSQ_SOURCE_LINE 00000050 "\t\t\t\t[, Gzip     => lib or \\\"/path/to/gzip\\\" or no ] "
NSQ_SOURCE_LINE 00000051 "\t\t\t\t[, Signal   => \\&sub_signal ]"
NSQ_SOURCE_LINE 00000052 "\t\t\t\t[, Pre      => \\&sub_pre ]"
NSQ_SOURCE_LINE 00000053 "\t\t\t\t[, Post     => \\&sub_post ]"
NSQ_SOURCE_LINE 00000054 "\t\t\t\t[, Flock    => yes or no ]"
NSQ_SOURCE_LINE 00000055 "\t\t\t\t[, Persist  => yes or no ]"
NSQ_SOURCE_LINE 00000056 "\t\t\t\t[, Dir      => \\\"dir/to/put/old/files/into\\\"] )\")"
NSQ_SOURCE_LINE 00000057 "\t\tunless defined($args{'File'});"
NSQ_SOURCE_LINE 00000058 ""
NSQ_SOURCE_LINE 00000059 "\tmy $self = {};"
NSQ_SOURCE_LINE 00000060 "\t$self->{'Fh'}\t  = undef;"
NSQ_SOURCE_LINE 00000061 "\t$self->{'File'}   = $args{'File'};"
NSQ_SOURCE_LINE 00000062 "\t$self->{'Count'}  = ($args{'Count'} or 7);"
NSQ_SOURCE_LINE 00000063 "\t$self->{'Signal'} = ($args{'Signal'} or sub {1;});"
NSQ_SOURCE_LINE 00000064 "\t$self->{'Pre'} = ($args{'Pre'} or sub {1;});"
NSQ_SOURCE_LINE 00000065 "\t$self->{'Post'} = ($args{'Post'} or sub {1;});"
NSQ_SOURCE_LINE 00000066 "\t$self->{'Flock'}  = ($args{'Flock'} or 'yes');"
NSQ_SOURCE_LINE 00000067 "\t$self->{'Persist'}  = ($args{'Persist'} or 'yes');"
NSQ_SOURCE_LINE 00000068 ""
NSQ_SOURCE_LINE 00000069 "\t# deprecated methods"
NSQ_SOURCE_LINE 00000070 "\tcarp \"Signal is a deprecated argument, see Pre/Post\" if $args{'Signal'};"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "\t# mutual excl"
NSQ_SOURCE_LINE 00000073 "\tcroak \"Can not define both Signal and Post\" "
NSQ_SOURCE_LINE 00000074 "\t\tif ($args{Signal} and $args{Post});"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "\t(ref($self->{'Signal'}) eq \"CODE\")"
NSQ_SOURCE_LINE 00000077 "\t\tor croak \"error: Signal is not a CODE reference.\";"
NSQ_SOURCE_LINE 00000078 ""
NSQ_SOURCE_LINE 00000079 "\t(ref($self->{'Pre'}) eq \"CODE\")"
NSQ_SOURCE_LINE 00000080 "\t\tor croak \"error: Pre is not a CODE reference.\";"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "\t(ref($self->{'Post'}) eq \"CODE\")"
NSQ_SOURCE_LINE 00000083 "\t\tor croak \"error: Post is not a CODE reference.\";"
NSQ_SOURCE_LINE 00000084 ""
NSQ_SOURCE_LINE 00000085 "\t# Process compression arg"
NSQ_SOURCE_LINE 00000086 "\tunless ($args{Gzip}) {"
NSQ_SOURCE_LINE 00000087 "\t\tif (_have_compress_zlib()) {"
NSQ_SOURCE_LINE 00000088 "\t\t\t$self->{Gzip} = 'lib';"
NSQ_SOURCE_LINE 00000089 "\t\t} else {"
NSQ_SOURCE_LINE 00000090 "\t\t\t$self->{Gzip} = $Config{gzip};"
NSQ_SOURCE_LINE 00000091 "\t\t}"
NSQ_SOURCE_LINE 00000092 "\t} else {"
NSQ_SOURCE_LINE 00000093 "\t\tif ($args{Gzip} eq 'no') {"
NSQ_SOURCE_LINE 00000094 "\t\t\t$self->{Gzip} = undef;"
NSQ_SOURCE_LINE 00000095 "\t\t} else {"
NSQ_SOURCE_LINE 00000096 "\t\t\t$self->{Gzip} = $args{Gzip};"
NSQ_SOURCE_LINE 00000097 "\t\t}"
NSQ_SOURCE_LINE 00000098 "\t}"
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "\t# Process directory arg"
NSQ_SOURCE_LINE 00000102 ""
NSQ_SOURCE_LINE 00000103 "\tif (defined($args{'Dir'})) {"
NSQ_SOURCE_LINE 00000104 "\t\t$self->{'Dir'} = $args{'Dir'};"
NSQ_SOURCE_LINE 00000105 "\t\t# don't know about creating directories ??"
NSQ_SOURCE_LINE 00000106 "\t\tmkdir($self->{'Dir'},0750) unless (-d $self->{'Dir'});"
NSQ_SOURCE_LINE 00000107 "\t} else {"
NSQ_SOURCE_LINE 00000108 "\t\t$self->{'Dir'} = undef;"
NSQ_SOURCE_LINE 00000109 "\t}"
NSQ_SOURCE_LINE 00000110 ""
NSQ_SOURCE_LINE 00000111 "\t# confirm existence of dir"
NSQ_SOURCE_LINE 00000112 ""
NSQ_SOURCE_LINE 00000113 "\tif (defined $self->{'Dir'} ) {"
NSQ_SOURCE_LINE 00000114 "\t\tcroak \"error: $self->{'Dir'} not writable\" "
NSQ_SOURCE_LINE 00000115 "\t\tunless (-w $self->{'Dir'});"
NSQ_SOURCE_LINE 00000116 "\t\tcroak \"error: $self->{'Dir'} not executable\" "
NSQ_SOURCE_LINE 00000117 "\t\tunless (-x $self->{'Dir'});"
NSQ_SOURCE_LINE 00000118 "\t}"
NSQ_SOURCE_LINE 00000119 ""
NSQ_SOURCE_LINE 00000120 "\t# open and lock the file"
NSQ_SOURCE_LINE 00000121 "\tif( $self->{'Flock'} eq 'yes'){"
NSQ_SOURCE_LINE 00000122 "\t    $self->{'Fh'} = new IO::File \"$self->{'File'}\", O_WRONLY|O_EXCL;"
NSQ_SOURCE_LINE 00000123 "\t    croak \"error: can not lock open: ($self->{'File'})\" "
NSQ_SOURCE_LINE 00000124 "\t\tunless defined($self->{'Fh'});"
NSQ_SOURCE_LINE 00000125 "\t\tflock($self->{'Fh'},LOCK_EX);"
NSQ_SOURCE_LINE 00000126 "\t}"
NSQ_SOURCE_LINE 00000127 "\telse{"
NSQ_SOURCE_LINE 00000128 "\t    $self->{'Fh'} = new IO::File \"$self->{'File'}\";"
NSQ_SOURCE_LINE 00000129 "\t    croak \"error: can not open: ($self->{'File'})\" "
NSQ_SOURCE_LINE 00000130 "\t\tunless defined($self->{'Fh'});"
NSQ_SOURCE_LINE 00000131 "\t}"
NSQ_SOURCE_LINE 00000132 ""
NSQ_SOURCE_LINE 00000133 "\tbless $self, $class;"
NSQ_SOURCE_LINE 00000134 "}"
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "sub rotate {"
NSQ_SOURCE_LINE 00000137 "    my ($self, %args) = @_;"
NSQ_SOURCE_LINE 00000138 ""
NSQ_SOURCE_LINE 00000139 "    my ($prev,$next,$i,$j);"
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "    # check we still have a filehandle"
NSQ_SOURCE_LINE 00000142 "    croak \"error: lost file handle, may have called rotate twice ?\""
NSQ_SOURCE_LINE 00000143 "        unless defined($self->{'Fh'});"
NSQ_SOURCE_LINE 00000144 ""
NSQ_SOURCE_LINE 00000145 "    my $curr  =  $self->{'File'};"
NSQ_SOURCE_LINE 00000146 "    my $currn =  $curr;"
NSQ_SOURCE_LINE 00000147 "    my $ext   =  $self->{'Gzip'} ? '.gz' : '';"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "\t# Execute and exit if Pre method fails"
NSQ_SOURCE_LINE 00000150 "\teval { &{$self->{'Pre'}}($curr); } if $self->{Pre};"
NSQ_SOURCE_LINE 00000151 "\tcroak \"error: your supplied Pre function failed: $@\" if ($@);"
NSQ_SOURCE_LINE 00000152 ""
NSQ_SOURCE_LINE 00000153 "\t# TODO: what is this doing ??"
NSQ_SOURCE_LINE 00000154 "    my $dir   =  defined($self->{'Dir'}) ? \"$self->{'Dir'}/\" : \"\";"
NSQ_SOURCE_LINE 00000155 "    $currn    =~ s+.*/([^/]*)+$self->{'Dir'}/$1+ if defined($self->{'Dir'});"
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "    for($i = $self->{'Count'}; $i > 1; $i--) {"
NSQ_SOURCE_LINE 00000158 "        $j = $i - 1;"
NSQ_SOURCE_LINE 00000159 "            $next = \"${currn}.\" . $i . $ext;"
NSQ_SOURCE_LINE 00000160 "            $prev = \"${currn}.\" . $j . $ext;"
NSQ_SOURCE_LINE 00000161 "        if ( -r $prev && -f $prev ) {"
NSQ_SOURCE_LINE 00000162 "            move($prev,$next)\t## move will attempt rename for us"
NSQ_SOURCE_LINE 00000163 "                or croak \"error: move failed: ($prev,$next)\";"
NSQ_SOURCE_LINE 00000164 "        }"
NSQ_SOURCE_LINE 00000165 "    }"
NSQ_SOURCE_LINE 00000166 ""
NSQ_SOURCE_LINE 00000167 "    ## copy current to next incremental"
NSQ_SOURCE_LINE 00000168 "    $next = \"${currn}.1\";"
NSQ_SOURCE_LINE 00000169 "    copy ($curr, $next);        "
NSQ_SOURCE_LINE 00000170 ""
NSQ_SOURCE_LINE 00000171 "\t## preserve permissions and status"
NSQ_SOURCE_LINE 00000172 "\tif ( $self->{'Persist'} eq 'yes' ){"
NSQ_SOURCE_LINE 00000173 "\t\tmy @stat = stat $curr;"
NSQ_SOURCE_LINE 00000174 "\t\tchmod( $stat[2], $next ) or carp \"error: chmod failed: ($next)\";"
NSQ_SOURCE_LINE 00000175 "\t\tutime( $stat[8], $stat[9], $next ) or carp \"error: failed: ($next)\";"
NSQ_SOURCE_LINE 00000176 "\t\tchown( $stat[4], $stat[5], $next ) or carp \"error: chown failed: ($next)\";"
NSQ_SOURCE_LINE 00000177 "\t}"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "    # now truncate the file"
NSQ_SOURCE_LINE 00000180 "\tif( $self->{'Flock'} eq 'yes' )"
NSQ_SOURCE_LINE 00000181 "\t{"
NSQ_SOURCE_LINE 00000182 "\t\ttruncate $curr,0 or croak \"error: could not truncate $curr: $!\"; }"
NSQ_SOURCE_LINE 00000183 "\telse{"
NSQ_SOURCE_LINE 00000184 "\t\tlocal(*IN);"
NSQ_SOURCE_LINE 00000185 "\t\topen(IN, \"+>$self->{'File'}\") "
NSQ_SOURCE_LINE 00000186 "\t\t\tor croak \"error: could not truncate $curr: $!\";"
NSQ_SOURCE_LINE 00000187 "\t}"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "\tif ($self->{'Gzip'} and $self->{'Gzip'} eq 'lib') "
NSQ_SOURCE_LINE 00000190 "\t{ "
NSQ_SOURCE_LINE 00000191 "\t\t_gzip($next, $next.$ext);"
NSQ_SOURCE_LINE 00000192 "\t}"
NSQ_SOURCE_LINE 00000193 "\telsif ($self->{'Gzip'})"
NSQ_SOURCE_LINE 00000194 "\t{ "
NSQ_SOURCE_LINE 00000195 "\t\t# WARNING: may not be safe system call"
NSQ_SOURCE_LINE 00000196 "        ( 0 == (system $self->{'Gzip'}, $GZIP_FLAG, $next) )"
NSQ_SOURCE_LINE 00000197 "            or croak \"error: \", $self->{'Gzip'}, \" failed\";"
NSQ_SOURCE_LINE 00000198 "    }"
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "\t# TODO: deprecated: remove next release"
NSQ_SOURCE_LINE 00000201 "\teval { &{$self->{'Signal'}}($curr, $next); } if ($self->{Signal});"
NSQ_SOURCE_LINE 00000202 "\tcroak \"error: your supplied Signal function failed: $@\" if ($@);"
NSQ_SOURCE_LINE 00000203 ""
NSQ_SOURCE_LINE 00000204 "\t# Execute and exit on post method"
NSQ_SOURCE_LINE 00000205 "\teval { &{$self->{'Post'}}($curr, $next); } if $self->{Post};"
NSQ_SOURCE_LINE 00000206 "\tcroak \"error: your supplied Post function failed: $@\" if ($@);"
NSQ_SOURCE_LINE 00000207 ""
NSQ_SOURCE_LINE 00000208 "\t# if we made it here we have succeeded"
NSQ_SOURCE_LINE 00000209 "\treturn 1;"
NSQ_SOURCE_LINE 00000210 "}"
NSQ_SOURCE_LINE 00000211 ""
NSQ_SOURCE_LINE 00000212 "sub DESTROY {"
NSQ_SOURCE_LINE 00000213 "    my ($self, %args) = @_;"
NSQ_SOURCE_LINE 00000214 "\treturn unless $self->{'Fh'};\t# already gone"
NSQ_SOURCE_LINE 00000215 "    flock($self->{'Fh'},LOCK_UN);"
NSQ_SOURCE_LINE 00000216 "    undef $self->{'Fh'};    # auto-close"
NSQ_SOURCE_LINE 00000217 "}"
NSQ_SOURCE_LINE 00000218 ""
NSQ_SOURCE_LINE 00000219 "sub _have_compress_zlib {"
NSQ_SOURCE_LINE 00000220 "\t# try and load the compression library"
NSQ_SOURCE_LINE 00000221 "\teval { require Compress::Zlib; };"
NSQ_SOURCE_LINE 00000222 "\tif ($@) {"
NSQ_SOURCE_LINE 00000223 "\t\tcarp \"warning: could not load Compress::Zlib, skipping compression\" ;"
NSQ_SOURCE_LINE 00000224 "\t\treturn undef;"
NSQ_SOURCE_LINE 00000225 "\t}"
NSQ_SOURCE_LINE 00000226 "\treturn 1;"
NSQ_SOURCE_LINE 00000227 "}"
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "sub _gzip {"
NSQ_SOURCE_LINE 00000230 "\tmy $in = shift;"
NSQ_SOURCE_LINE 00000231 "\tmy $out = shift;"
NSQ_SOURCE_LINE 00000232 ""
NSQ_SOURCE_LINE 00000233 "\t# ASSERT"
NSQ_SOURCE_LINE 00000234 "\tcroak \"error: _gzip called without mandatory argument\" unless $in;"
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "\treturn unless _have_compress_zlib();"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "    my($buffer,$fhw);"
NSQ_SOURCE_LINE 00000239 "\t$fhw = new IO::File $in "
NSQ_SOURCE_LINE 00000240 "\t\tor croak \"error: could not open $in: $!\";"
NSQ_SOURCE_LINE 00000241 "    my $gz = Compress::Zlib::gzopen($out, \"wb\")"
NSQ_SOURCE_LINE 00000242 "\t\tor croak \"error: could not gzopen $out: $!\";"
NSQ_SOURCE_LINE 00000243 "    $gz->gzwrite($buffer)"
NSQ_SOURCE_LINE 00000244 "\twhile read($fhw,$buffer,4096) > 0 ;"
NSQ_SOURCE_LINE 00000245 "    $gz->gzclose() ;"
NSQ_SOURCE_LINE 00000246 "    $fhw->close;"
NSQ_SOURCE_LINE 00000247 ""
NSQ_SOURCE_LINE 00000248 "\tunlink $in or croak \"error: could not delete $in: $!\";"
NSQ_SOURCE_LINE 00000249 ""
NSQ_SOURCE_LINE 00000250 "\treturn 1;"
NSQ_SOURCE_LINE 00000251 "}"
NSQ_SOURCE_LINE 00000252 ""
NSQ_SOURCE_LINE 00000253 "1;"
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 ""
NSQ_SOURCE_LINE 00000256 "__END__"
NSQ_SOURCE_LINE 00000257 ""
NSQ_SOURCE_LINE 00000258 "=head1 NAME"
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "Logfile::Rotate - Perl module to rotate logfiles."
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000263 ""
NSQ_SOURCE_LINE 00000264 "   use Logfile::Rotate;"
NSQ_SOURCE_LINE 00000265 "   my $log = new Logfile::Rotate( File   => '/var/adm/syslog/syslog.log', "
NSQ_SOURCE_LINE 00000266 "                                  Count  => 7,"
NSQ_SOURCE_LINE 00000267 "                                  Gzip  => 'lib',"
NSQ_SOURCE_LINE 00000268 "                                  Post   => sub{ "
NSQ_SOURCE_LINE 00000269 "                                    open(IN, \"/var/run/syslog.pid\");"
NSQ_SOURCE_LINE 00000270 "                                    kill(\"HUP\", chomp(<IN>)); }"
NSQ_SOURCE_LINE 00000271 "                                  Dir    => '/var/log/old',"
NSQ_SOURCE_LINE 00000272 "                                  Flock\t => 'yes',"
NSQ_SOURCE_LINE 00000273 "                                  Persist => 'yes',"
NSQ_SOURCE_LINE 00000274 "                                );"
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "   # process log file "
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "   $log->rotate();"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "   or"
NSQ_SOURCE_LINE 00000281 "   "
NSQ_SOURCE_LINE 00000282 "   my $log = new Logfile::Rotate( File  => '/var/adm/syslog', "
NSQ_SOURCE_LINE 00000283 "                                  Gzip   => '/usr/local/bin/gzip');"
NSQ_SOURCE_LINE 00000284 "   "
NSQ_SOURCE_LINE 00000285 "   # process log file "
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "   $log->rotate();"
NSQ_SOURCE_LINE 00000288 "   undef $log;"
NSQ_SOURCE_LINE 00000289 ""
NSQ_SOURCE_LINE 00000290 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000291 ""
NSQ_SOURCE_LINE 00000292 "I have used the name space of L<Logfile::Base> package by I<Ulrich Pfeifer>, "
NSQ_SOURCE_LINE 00000293 "as the use of this module closely relates to the processing logfiles."
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=over 4"
NSQ_SOURCE_LINE 00000296 ""
NSQ_SOURCE_LINE 00000297 "=item new"
NSQ_SOURCE_LINE 00000298 ""
NSQ_SOURCE_LINE 00000299 "C<new> accepts the following arguments, C<File>, C<Count>, C<Gzip>,"
NSQ_SOURCE_LINE 00000300 "C<Pre>, C<Post>, C<Flock> and C<Dir> with only C<File> being mandatory."
NSQ_SOURCE_LINE 00000301 "C<new> will open and lock the file, so you may co-ordinate the"
NSQ_SOURCE_LINE 00000302 "processing of the file with rotating it.  The file is closed and"
NSQ_SOURCE_LINE 00000303 "unlocked when the object is destroyed, so you can do this explicitly by"
NSQ_SOURCE_LINE 00000304 "C<undef>'ing the object.  "
NSQ_SOURCE_LINE 00000305 ""
NSQ_SOURCE_LINE 00000306 "The C<Pre>/C<Post> arguments allow you to pass function references to"
NSQ_SOURCE_LINE 00000307 "this method, which you may use as a callback for any processing you want"
NSQ_SOURCE_LINE 00000308 "before or after the rotation. For example, you may notify the process"
NSQ_SOURCE_LINE 00000309 "writing to the file that it has been rotated."
NSQ_SOURCE_LINE 00000310 ""
NSQ_SOURCE_LINE 00000311 "The C<Pre> function is passed the current filename to be rotated as an"
NSQ_SOURCE_LINE 00000312 "argument and the C<Post> function is passed the current filename that"
NSQ_SOURCE_LINE 00000313 "was rotated and that file's new filename including any extension added"
NSQ_SOURCE_LINE 00000314 "by compression previously."
NSQ_SOURCE_LINE 00000315 ""
NSQ_SOURCE_LINE 00000316 "Both the C<Pre> and C<Post> function references you provide are executed"
NSQ_SOURCE_LINE 00000317 "within an C<eval> statement inside the C<rotate> method.  If the C<eval>"
NSQ_SOURCE_LINE 00000318 "returns an error then the C<rotate> method will croak at that point."
NSQ_SOURCE_LINE 00000319 ""
NSQ_SOURCE_LINE 00000320 "The C<Signal> argument is deprecated by the C<Post> argument."
NSQ_SOURCE_LINE 00000321 ""
NSQ_SOURCE_LINE 00000322 "The C<Flock> argument allows you to specify whether the perl function"
NSQ_SOURCE_LINE 00000323 "C<flock> is used to lock the file during the rotation operation."
NSQ_SOURCE_LINE 00000324 "Apparently flock causes problems on some platforms and this option has"
NSQ_SOURCE_LINE 00000325 "been added to allow you to control the programs behaviour.  By default"
NSQ_SOURCE_LINE 00000326 "the file will be locked using C<flock>."
NSQ_SOURCE_LINE 00000327 ""
NSQ_SOURCE_LINE 00000328 "The C<Persist> argument allows you to control whether the program will"
NSQ_SOURCE_LINE 00000329 "try and set the current log file ownership and permissions on any new"
NSQ_SOURCE_LINE 00000330 "files that may be created by the rotation.  In some circumstances the"
NSQ_SOURCE_LINE 00000331 "program doing the file rotation may not have sufficient permission to"
NSQ_SOURCE_LINE 00000332 "C<chown> on the file.  By default the program will try and preserve"
NSQ_SOURCE_LINE 00000333 "ownership and permissions."
NSQ_SOURCE_LINE 00000334 ""
NSQ_SOURCE_LINE 00000335 "=item rotate()"
NSQ_SOURCE_LINE 00000336 ""
NSQ_SOURCE_LINE 00000337 "This method will copy the file passed in C<new> to a file of the same"
NSQ_SOURCE_LINE 00000338 "name, with a numeric extension and truncate the original file to zero"
NSQ_SOURCE_LINE 00000339 "length.  The numeric extension will range from 1 up to the value"
NSQ_SOURCE_LINE 00000340 "specified by Count, or 7 if none is defined, with 1 being the most"
NSQ_SOURCE_LINE 00000341 "recent file.  When Count is reached, the older file is discarded in a"
NSQ_SOURCE_LINE 00000342 "FIFO (first in, first out) fashion. If the argument C<Dir> was given, "
NSQ_SOURCE_LINE 00000343 "all old files will be placed in the specified directory."
NSQ_SOURCE_LINE 00000344 ""
NSQ_SOURCE_LINE 00000345 "The C<Post> function is the last step executed by the rotate method so"
NSQ_SOURCE_LINE 00000346 "the return code of rotate will be the return code of the function you"
NSQ_SOURCE_LINE 00000347 "proved, or 1 by default."
NSQ_SOURCE_LINE 00000348 ""
NSQ_SOURCE_LINE 00000349 "The copy function is implemented by using the L<File::Copy> package, but"
NSQ_SOURCE_LINE 00000350 "I have had a few people suggest that they would prefer L<File::Move>."
NSQ_SOURCE_LINE 00000351 "I'm still not decided on this as you would loose data if the move should"
NSQ_SOURCE_LINE 00000352 "fail.  "
NSQ_SOURCE_LINE 00000353 ""
NSQ_SOURCE_LINE 00000354 "=back "
NSQ_SOURCE_LINE 00000355 ""
NSQ_SOURCE_LINE 00000356 "=head2 Optional Compression"
NSQ_SOURCE_LINE 00000357 ""
NSQ_SOURCE_LINE 00000358 "If available C<rotate> will also compress the file with the "
NSQ_SOURCE_LINE 00000359 "L<gzip> program or the program passed as the C<Gzip> argument.  "
NSQ_SOURCE_LINE 00000360 ""
NSQ_SOURCE_LINE 00000361 "You may now also use C<lib> as a value for the C<Gzip> argument.  This"
NSQ_SOURCE_LINE 00000362 "directs the program to load the C<Compress::Zlib> module, if available"
NSQ_SOURCE_LINE 00000363 "and use it do the compression within perl.  B<This avoids the security"
NSQ_SOURCE_LINE 00000364 "issues associated with spawning external programs and is the recommended"
NSQ_SOURCE_LINE 00000365 "value for this option.>"
NSQ_SOURCE_LINE 00000366 ""
NSQ_SOURCE_LINE 00000367 "If no argument is defined it will first check to see if the"
NSQ_SOURCE_LINE 00000368 "C<Compress::Zlib> module can be loaded then check the perl L<Config> to"
NSQ_SOURCE_LINE 00000369 "determine if gzip is available on your system. In this case the L<gzip>"
NSQ_SOURCE_LINE 00000370 "must be in your current path to succeed, and accept the C<-f> option.  "
NSQ_SOURCE_LINE 00000371 ""
NSQ_SOURCE_LINE 00000372 "See the L<\"WARNING\"> section below."
NSQ_SOURCE_LINE 00000373 ""
NSQ_SOURCE_LINE 00000374 "=head2 Optional Relocation Directory"
NSQ_SOURCE_LINE 00000375 ""
NSQ_SOURCE_LINE 00000376 "If you specify an argument for C<Dir> then the file being rotated will"
NSQ_SOURCE_LINE 00000377 "be relocated to the directory specified.  Along with any other files"
NSQ_SOURCE_LINE 00000378 "that may have been rotated previously.  If the directory name specified"
NSQ_SOURCE_LINE 00000379 "does not exist then it will be created with C<0750> permissions.  If you"
NSQ_SOURCE_LINE 00000380 "wish to have other permissions on the directory then I would recommend"
NSQ_SOURCE_LINE 00000381 "you create the directory before using this module."
NSQ_SOURCE_LINE 00000382 ""
NSQ_SOURCE_LINE 00000383 "See the L<\"WARNING\"> section below."
NSQ_SOURCE_LINE 00000384 ""
NSQ_SOURCE_LINE 00000385 "=head1 WARNING"
NSQ_SOURCE_LINE 00000386 ""
NSQ_SOURCE_LINE 00000387 "If a system call is made to F<gzip> this makes this module vulnerable to"
NSQ_SOURCE_LINE 00000388 "security problems if a rogue gzip is in your path or F<gzip> has been"
NSQ_SOURCE_LINE 00000389 "sabotaged.  For this reason a STRONGLY RECOMMEND you DO NOT use this"
NSQ_SOURCE_LINE 00000390 "module while you are ROOT."
NSQ_SOURCE_LINE 00000391 ""
NSQ_SOURCE_LINE 00000392 "For a more secure alternative install the C<Compress::Zlib> module and"
NSQ_SOURCE_LINE 00000393 "use the B<lib> value for the C<Gzip> argument."
NSQ_SOURCE_LINE 00000394 ""
NSQ_SOURCE_LINE 00000395 "If you specify an argument for C<Dir> and the directory name you pass"
NSQ_SOURCE_LINE 00000396 "does not exist, this module B<will create> the directory with"
NSQ_SOURCE_LINE 00000397 "permissions C<0750>."
NSQ_SOURCE_LINE 00000398 ""
NSQ_SOURCE_LINE 00000399 "=head1 DEPENDANCIES"
NSQ_SOURCE_LINE 00000400 ""
NSQ_SOURCE_LINE 00000401 "See L<File::Copy>."
NSQ_SOURCE_LINE 00000402 ""
NSQ_SOURCE_LINE 00000403 "If C<Gzip> is being used it must create files with an extension "
NSQ_SOURCE_LINE 00000404 "of C<.gz> for the file to be picked by the rotate cycle."
NSQ_SOURCE_LINE 00000405 ""
