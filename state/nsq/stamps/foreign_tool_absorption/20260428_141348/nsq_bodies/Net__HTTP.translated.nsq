BODY_BEGIN
NSQ_SOURCE_LINE 00000001 "package Net::HTTP;"
NSQ_SOURCE_LINE 00000002 "our $VERSION = '6.24';"
NSQ_SOURCE_LINE 00000003 "use strict;"
NSQ_SOURCE_LINE 00000004 "use warnings;"
NSQ_SOURCE_LINE 00000005 ""
NSQ_SOURCE_LINE 00000006 "our $SOCKET_CLASS;"
NSQ_SOURCE_LINE 00000007 "unless ($SOCKET_CLASS) {"
NSQ_SOURCE_LINE 00000008 "    # Try several, in order of capability and preference"
NSQ_SOURCE_LINE 00000009 "    if (eval { require IO::Socket::IP }) {"
NSQ_SOURCE_LINE 00000010 "       $SOCKET_CLASS = \"IO::Socket::IP\";    # IPv4+IPv6"
NSQ_SOURCE_LINE 00000011 "    } elsif (eval { require IO::Socket::INET6 }) {"
NSQ_SOURCE_LINE 00000012 "       $SOCKET_CLASS = \"IO::Socket::INET6\"; # IPv4+IPv6"
NSQ_SOURCE_LINE 00000013 "    } elsif (eval { require IO::Socket::INET }) {"
NSQ_SOURCE_LINE 00000014 "       $SOCKET_CLASS = \"IO::Socket::INET\";  # IPv4 only"
NSQ_SOURCE_LINE 00000015 "    } else {"
NSQ_SOURCE_LINE 00000016 "       require IO::Socket;"
NSQ_SOURCE_LINE 00000017 "       $SOCKET_CLASS = \"IO::Socket::INET\";"
NSQ_SOURCE_LINE 00000018 "    }"
NSQ_SOURCE_LINE 00000019 "}"
NSQ_SOURCE_LINE 00000020 "require Net::HTTP::Methods;"
NSQ_SOURCE_LINE 00000021 "require Carp;"
NSQ_SOURCE_LINE 00000022 ""
NSQ_SOURCE_LINE 00000023 "our @ISA = ($SOCKET_CLASS, 'Net::HTTP::Methods');"
NSQ_SOURCE_LINE 00000024 ""
NSQ_SOURCE_LINE 00000025 "sub new {"
NSQ_SOURCE_LINE 00000026 "    my $class = shift;"
NSQ_SOURCE_LINE 00000027 "    Carp::croak(\"No Host option provided\") unless @_;"
NSQ_SOURCE_LINE 00000028 "    $class->SUPER::new(@_);"
NSQ_SOURCE_LINE 00000029 "}"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "sub configure {"
NSQ_SOURCE_LINE 00000032 "    my($self, $cnf) = @_;"
NSQ_SOURCE_LINE 00000033 "    $self->http_configure($cnf);"
NSQ_SOURCE_LINE 00000034 "}"
NSQ_SOURCE_LINE 00000035 ""
NSQ_SOURCE_LINE 00000036 "sub http_connect {"
NSQ_SOURCE_LINE 00000037 "    my($self, $cnf) = @_;"
NSQ_SOURCE_LINE 00000038 "    $self->SUPER::configure($cnf);"
NSQ_SOURCE_LINE 00000039 "}"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "1;"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "=pod"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000046 ""
NSQ_SOURCE_LINE 00000047 "=head1 NAME"
NSQ_SOURCE_LINE 00000048 ""
NSQ_SOURCE_LINE 00000049 "Net::HTTP - Low-level HTTP connection (client)"
NSQ_SOURCE_LINE 00000050 ""
NSQ_SOURCE_LINE 00000051 "=head1 VERSION"
NSQ_SOURCE_LINE 00000052 ""
NSQ_SOURCE_LINE 00000053 "version 6.24"
NSQ_SOURCE_LINE 00000054 ""
NSQ_SOURCE_LINE 00000055 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000056 ""
NSQ_SOURCE_LINE 00000057 " use Net::HTTP;"
NSQ_SOURCE_LINE 00000058 " my $s = Net::HTTP->new(Host => \"www.perl.com\") || die $@;"
NSQ_SOURCE_LINE 00000059 " $s->write_request(GET => \"/\", 'User-Agent' => \"Mozilla/5.0\");"
NSQ_SOURCE_LINE 00000060 " my($code, $mess, %h) = $s->read_response_headers;"
NSQ_SOURCE_LINE 00000061 ""
NSQ_SOURCE_LINE 00000062 " while (1) {"
NSQ_SOURCE_LINE 00000063 "    my $buf;"
NSQ_SOURCE_LINE 00000064 "    my $n = $s->read_entity_body($buf, 1024);"
NSQ_SOURCE_LINE 00000065 "    die \"read failed: $!\" unless defined $n;"
NSQ_SOURCE_LINE 00000066 "    last unless $n;"
NSQ_SOURCE_LINE 00000067 "    print $buf;"
NSQ_SOURCE_LINE 00000068 " }"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "The C<Net::HTTP> class is a low-level HTTP client.  An instance of the"
NSQ_SOURCE_LINE 00000073 "C<Net::HTTP> class represents a connection to an HTTP server.  The"
NSQ_SOURCE_LINE 00000074 "HTTP protocol is described in RFC 2616.  The C<Net::HTTP> class"
NSQ_SOURCE_LINE 00000075 "supports C<HTTP/1.0> and C<HTTP/1.1>."
NSQ_SOURCE_LINE 00000076 ""
NSQ_SOURCE_LINE 00000077 "C<Net::HTTP> is a sub-class of one of C<IO::Socket::IP> (IPv6+IPv4),"
NSQ_SOURCE_LINE 00000078 "C<IO::Socket::INET6> (IPv6+IPv4), or C<IO::Socket::INET> (IPv4 only)."
NSQ_SOURCE_LINE 00000079 "You can mix the methods described below with reading and writing from the"
NSQ_SOURCE_LINE 00000080 "socket directly.  This is not necessary a good idea, unless you know what"
NSQ_SOURCE_LINE 00000081 "you are doing."
NSQ_SOURCE_LINE 00000082 ""
NSQ_SOURCE_LINE 00000083 "The following methods are provided (in addition to those of"
NSQ_SOURCE_LINE 00000084 "C<IO::Socket::INET>):"
NSQ_SOURCE_LINE 00000085 ""
NSQ_SOURCE_LINE 00000086 "=over"
NSQ_SOURCE_LINE 00000087 ""
NSQ_SOURCE_LINE 00000088 "=item C<< $s = Net::HTTP->new( %options ) >>"
NSQ_SOURCE_LINE 00000089 ""
NSQ_SOURCE_LINE 00000090 "The C<Net::HTTP> constructor method takes the same options as"
NSQ_SOURCE_LINE 00000091 "C<IO::Socket::INET>'s as well as these:"
NSQ_SOURCE_LINE 00000092 ""
NSQ_SOURCE_LINE 00000093 "  Host:            Initial host attribute value"
NSQ_SOURCE_LINE 00000094 "  KeepAlive:       Initial keep_alive attribute value"
NSQ_SOURCE_LINE 00000095 "  SendTE:          Initial send_te attribute_value"
NSQ_SOURCE_LINE 00000096 "  HTTPVersion:     Initial http_version attribute value"
NSQ_SOURCE_LINE 00000097 "  PeerHTTPVersion: Initial peer_http_version attribute value"
NSQ_SOURCE_LINE 00000098 "  MaxLineLength:   Initial max_line_length attribute value"
NSQ_SOURCE_LINE 00000099 "  MaxHeaderLines:  Initial max_header_lines attribute value"
NSQ_SOURCE_LINE 00000100 ""
NSQ_SOURCE_LINE 00000101 "The C<Host> option is also the default for C<IO::Socket::INET>'s"
NSQ_SOURCE_LINE 00000102 "C<PeerAddr>.  The C<PeerPort> defaults to 80 if not provided."
NSQ_SOURCE_LINE 00000103 "The C<PeerPort> specification can also be embedded in the C<PeerAddr>"
NSQ_SOURCE_LINE 00000104 "by preceding it with a \":\", and closing the IPv6 address on brackets \"[]\" if"
NSQ_SOURCE_LINE 00000105 "necessary: \"192.0.2.1:80\",\"[2001:db8::1]:80\",\"any.example.com:80\"."
NSQ_SOURCE_LINE 00000106 ""
NSQ_SOURCE_LINE 00000107 "The C<Listen> option provided by C<IO::Socket::INET>'s constructor"
NSQ_SOURCE_LINE 00000108 "method is not allowed."
NSQ_SOURCE_LINE 00000109 ""
NSQ_SOURCE_LINE 00000110 "If unable to connect to the given HTTP server then the constructor"
NSQ_SOURCE_LINE 00000111 "returns C<undef> and $@ contains the reason.  After a successful"
NSQ_SOURCE_LINE 00000112 "connect, a C<Net:HTTP> object is returned."
NSQ_SOURCE_LINE 00000113 ""
NSQ_SOURCE_LINE 00000114 "=item C<< $s->host >>"
NSQ_SOURCE_LINE 00000115 ""
NSQ_SOURCE_LINE 00000116 "Get/set the default value of the C<Host> header to send.  The $host"
NSQ_SOURCE_LINE 00000117 "must not be set to an empty string (or C<undef>) for HTTP/1.1."
NSQ_SOURCE_LINE 00000118 ""
NSQ_SOURCE_LINE 00000119 "=item C<< $s->keep_alive >>"
NSQ_SOURCE_LINE 00000120 ""
NSQ_SOURCE_LINE 00000121 "Get/set the I<keep-alive> value.  If this value is TRUE then the"
NSQ_SOURCE_LINE 00000122 "request will be sent with headers indicating that the server should try"
NSQ_SOURCE_LINE 00000123 "to keep the connection open so that multiple requests can be sent."
NSQ_SOURCE_LINE 00000124 ""
NSQ_SOURCE_LINE 00000125 "The actual headers set will depend on the value of the C<http_version>"
NSQ_SOURCE_LINE 00000126 "and C<peer_http_version> attributes."
NSQ_SOURCE_LINE 00000127 ""
NSQ_SOURCE_LINE 00000128 "=item C<< $s->send_te >>"
NSQ_SOURCE_LINE 00000129 ""
NSQ_SOURCE_LINE 00000130 "Get/set the a value indicating if the request will be sent with a \"TE\""
NSQ_SOURCE_LINE 00000131 "header to indicate the transfer encodings that the server can choose to"
NSQ_SOURCE_LINE 00000132 "use.  The list of encodings announced as accepted by this client depends"
NSQ_SOURCE_LINE 00000133 "on availability of the following modules: C<Compress::Raw::Zlib> for"
NSQ_SOURCE_LINE 00000134 "I<deflate>, and C<IO::Compress::Gunzip> for I<gzip>."
NSQ_SOURCE_LINE 00000135 ""
NSQ_SOURCE_LINE 00000136 "=item C<< $s->http_version >>"
NSQ_SOURCE_LINE 00000137 ""
NSQ_SOURCE_LINE 00000138 "Get/set the HTTP version number that this client should announce."
NSQ_SOURCE_LINE 00000139 "This value can only be set to \"1.0\" or \"1.1\".  The default is \"1.1\"."
NSQ_SOURCE_LINE 00000140 ""
NSQ_SOURCE_LINE 00000141 "=item C<< $s->peer_http_version >>"
NSQ_SOURCE_LINE 00000142 ""
NSQ_SOURCE_LINE 00000143 "Get/set the protocol version number of our peer.  This value will"
NSQ_SOURCE_LINE 00000144 "initially be \"1.0\", but will be updated by a successful"
NSQ_SOURCE_LINE 00000145 "read_response_headers() method call."
NSQ_SOURCE_LINE 00000146 ""
NSQ_SOURCE_LINE 00000147 "=item C<< $s->max_line_length >>"
NSQ_SOURCE_LINE 00000148 ""
NSQ_SOURCE_LINE 00000149 "Get/set a limit on the length of response line and response header"
NSQ_SOURCE_LINE 00000150 "lines.  The default is 8192.  A value of 0 means no limit."
NSQ_SOURCE_LINE 00000151 ""
NSQ_SOURCE_LINE 00000152 "=item C<< $s->max_header_length >>"
NSQ_SOURCE_LINE 00000153 ""
NSQ_SOURCE_LINE 00000154 "Get/set a limit on the number of header lines that a response can"
NSQ_SOURCE_LINE 00000155 "have.  The default is 128.  A value of 0 means no limit."
NSQ_SOURCE_LINE 00000156 ""
NSQ_SOURCE_LINE 00000157 "=item C<< $s->format_request($method, $uri, %headers, [$content]) >>"
NSQ_SOURCE_LINE 00000158 ""
NSQ_SOURCE_LINE 00000159 "Format a request message and return it as a string.  If the headers do"
NSQ_SOURCE_LINE 00000160 "not include a C<Host> header, then a header is inserted with the value"
NSQ_SOURCE_LINE 00000161 "of the C<host> attribute.  Headers like C<Connection> and"
NSQ_SOURCE_LINE 00000162 "C<Keep-Alive> might also be added depending on the status of the"
NSQ_SOURCE_LINE 00000163 "C<keep_alive> attribute."
NSQ_SOURCE_LINE 00000164 ""
NSQ_SOURCE_LINE 00000165 "If $content is given (and it is non-empty), then a C<Content-Length>"
NSQ_SOURCE_LINE 00000166 "header is automatically added unless it was already present."
NSQ_SOURCE_LINE 00000167 ""
NSQ_SOURCE_LINE 00000168 "=item C<< $s->write_request($method, $uri, %headers, [$content]) >>"
NSQ_SOURCE_LINE 00000169 ""
NSQ_SOURCE_LINE 00000170 "Format and send a request message.  Arguments are the same as for"
NSQ_SOURCE_LINE 00000171 "format_request().  Returns true if successful."
NSQ_SOURCE_LINE 00000172 ""
NSQ_SOURCE_LINE 00000173 "=item C<< $s->format_chunk( $data ) >>"
NSQ_SOURCE_LINE 00000174 ""
NSQ_SOURCE_LINE 00000175 "Returns the string to be written for the given chunk of data."
NSQ_SOURCE_LINE 00000176 ""
NSQ_SOURCE_LINE 00000177 "=item C<< $s->write_chunk($data) >>"
NSQ_SOURCE_LINE 00000178 ""
NSQ_SOURCE_LINE 00000179 "Will write a new chunk of request entity body data.  This method"
NSQ_SOURCE_LINE 00000180 "should only be used if the C<Transfer-Encoding> header with a value of"
NSQ_SOURCE_LINE 00000181 "C<chunked> was sent in the request.  Note, writing zero-length data is"
NSQ_SOURCE_LINE 00000182 "a no-op.  Use the write_chunk_eof() method to signal end of entity"
NSQ_SOURCE_LINE 00000183 "body data."
NSQ_SOURCE_LINE 00000184 ""
NSQ_SOURCE_LINE 00000185 "Returns true if successful."
NSQ_SOURCE_LINE 00000186 ""
NSQ_SOURCE_LINE 00000187 "=item C<< $s->format_chunk_eof( %trailers ) >>"
NSQ_SOURCE_LINE 00000188 ""
NSQ_SOURCE_LINE 00000189 "Returns the string to be written for signaling EOF when a"
NSQ_SOURCE_LINE 00000190 "C<Transfer-Encoding> of C<chunked> is used."
NSQ_SOURCE_LINE 00000191 ""
NSQ_SOURCE_LINE 00000192 "=item C<< $s->write_chunk_eof( %trailers ) >>"
NSQ_SOURCE_LINE 00000193 ""
NSQ_SOURCE_LINE 00000194 "Will write eof marker for chunked data and optional trailers.  Note"
NSQ_SOURCE_LINE 00000195 "that trailers should not really be used unless is was signaled"
NSQ_SOURCE_LINE 00000196 "with a C<Trailer> header."
NSQ_SOURCE_LINE 00000197 ""
NSQ_SOURCE_LINE 00000198 "Returns true if successful."
NSQ_SOURCE_LINE 00000199 ""
NSQ_SOURCE_LINE 00000200 "=item C<< ($code, $mess, %headers) = $s->read_response_headers( %opts ) >>"
NSQ_SOURCE_LINE 00000201 ""
NSQ_SOURCE_LINE 00000202 "Read response headers from server and return it.  The $code is the 3"
NSQ_SOURCE_LINE 00000203 "digit HTTP status code (see L<HTTP::Status>) and $mess is the textual"
NSQ_SOURCE_LINE 00000204 "message that came with it.  Headers are then returned as key/value"
NSQ_SOURCE_LINE 00000205 "pairs.  Since key letter casing is not normalized and the same key can"
NSQ_SOURCE_LINE 00000206 "even occur multiple times, assigning these values directly to a hash"
NSQ_SOURCE_LINE 00000207 "is not wise.  Only the $code is returned if this method is called in"
NSQ_SOURCE_LINE 00000208 "scalar context."
NSQ_SOURCE_LINE 00000209 ""
NSQ_SOURCE_LINE 00000210 "As a side effect this method updates the 'peer_http_version'"
NSQ_SOURCE_LINE 00000211 "attribute."
NSQ_SOURCE_LINE 00000212 ""
NSQ_SOURCE_LINE 00000213 "Options might be passed in as key/value pairs.  There are currently"
NSQ_SOURCE_LINE 00000214 "only two options supported; C<laxed> and C<junk_out>."
NSQ_SOURCE_LINE 00000215 ""
NSQ_SOURCE_LINE 00000216 "The C<laxed> option will make read_response_headers() more forgiving"
NSQ_SOURCE_LINE 00000217 "towards servers that have not learned how to speak HTTP properly.  The"
NSQ_SOURCE_LINE 00000218 "C<laxed> option is a boolean flag, and is enabled by passing in a TRUE"
NSQ_SOURCE_LINE 00000219 "value.  The C<junk_out> option can be used to capture bad header lines"
NSQ_SOURCE_LINE 00000220 "when C<laxed> is enabled.  The value should be an array reference."
NSQ_SOURCE_LINE 00000221 "Bad header lines will be pushed onto the array."
NSQ_SOURCE_LINE 00000222 ""
NSQ_SOURCE_LINE 00000223 "The C<laxed> option must be specified in order to communicate with"
NSQ_SOURCE_LINE 00000224 "pre-HTTP/1.0 servers that don't describe the response outcome or the"
NSQ_SOURCE_LINE 00000225 "data they send back with a header block.  For these servers"
NSQ_SOURCE_LINE 00000226 "peer_http_version is set to \"0.9\" and this method returns (200,"
NSQ_SOURCE_LINE 00000227 "\"Assumed OK\")."
NSQ_SOURCE_LINE 00000228 ""
NSQ_SOURCE_LINE 00000229 "The method will raise an exception (die) if the server does not speak"
NSQ_SOURCE_LINE 00000230 "proper HTTP or if the C<max_line_length> or C<max_header_length>"
NSQ_SOURCE_LINE 00000231 "limits are reached.  If the C<laxed> option is turned on and"
NSQ_SOURCE_LINE 00000232 "C<max_line_length> and C<max_header_length> checks are turned off,"
NSQ_SOURCE_LINE 00000233 "then no exception will be raised and this method will always"
NSQ_SOURCE_LINE 00000234 "return a response code."
NSQ_SOURCE_LINE 00000235 ""
NSQ_SOURCE_LINE 00000236 "=item C<< $n = $s->read_entity_body($buf, $size); >>"
NSQ_SOURCE_LINE 00000237 ""
NSQ_SOURCE_LINE 00000238 "Reads chunks of the entity body content.  Basically the same interface"
NSQ_SOURCE_LINE 00000239 "as for read() and sysread(), but the buffer offset argument is not"
NSQ_SOURCE_LINE 00000240 "supported yet.  This method should only be called after a successful"
NSQ_SOURCE_LINE 00000241 "read_response_headers() call."
NSQ_SOURCE_LINE 00000242 ""
NSQ_SOURCE_LINE 00000243 "The return value will be C<undef> on read errors, 0 on EOF, -1 if no data"
NSQ_SOURCE_LINE 00000244 "could be returned this time, otherwise the number of bytes assigned"
NSQ_SOURCE_LINE 00000245 "to $buf.  The $buf is set to \"\" when the return value is -1."
NSQ_SOURCE_LINE 00000246 ""
NSQ_SOURCE_LINE 00000247 "You normally want to retry this call if this function returns either"
NSQ_SOURCE_LINE 00000248 "-1 or C<undef> with C<$!> as EINTR or EAGAIN (see L<Errno>).  EINTR"
NSQ_SOURCE_LINE 00000249 "can happen if the application catches signals and EAGAIN can happen if"
NSQ_SOURCE_LINE 00000250 "you made the socket non-blocking."
NSQ_SOURCE_LINE 00000251 ""
NSQ_SOURCE_LINE 00000252 "This method will raise exceptions (die) if the server does not speak"
NSQ_SOURCE_LINE 00000253 "proper HTTP.  This can only happen when reading chunked data."
NSQ_SOURCE_LINE 00000254 ""
NSQ_SOURCE_LINE 00000255 "=item C<< %headers = $s->get_trailers >>"
NSQ_SOURCE_LINE 00000256 ""
NSQ_SOURCE_LINE 00000257 "After read_entity_body() has returned 0 to indicate end of the entity"
NSQ_SOURCE_LINE 00000258 "body, you might call this method to pick up any trailers."
NSQ_SOURCE_LINE 00000259 ""
NSQ_SOURCE_LINE 00000260 "=item C<< $s->_rbuf >>"
NSQ_SOURCE_LINE 00000261 ""
NSQ_SOURCE_LINE 00000262 "Get/set the read buffer content.  The read_response_headers() and"
NSQ_SOURCE_LINE 00000263 "read_entity_body() methods use an internal buffer which they will look"
NSQ_SOURCE_LINE 00000264 "for data before they actually sysread more from the socket itself.  If"
NSQ_SOURCE_LINE 00000265 "they read too much, the remaining data will be left in this buffer."
NSQ_SOURCE_LINE 00000266 ""
NSQ_SOURCE_LINE 00000267 "=item C<< $s->_rbuf_length >>"
NSQ_SOURCE_LINE 00000268 ""
NSQ_SOURCE_LINE 00000269 "Returns the number of bytes in the read buffer.  This should always be"
NSQ_SOURCE_LINE 00000270 "the same as:"
NSQ_SOURCE_LINE 00000271 ""
NSQ_SOURCE_LINE 00000272 "    length($s->_rbuf)"
NSQ_SOURCE_LINE 00000273 ""
NSQ_SOURCE_LINE 00000274 "but might be more efficient."
NSQ_SOURCE_LINE 00000275 ""
NSQ_SOURCE_LINE 00000276 "=back"
NSQ_SOURCE_LINE 00000277 ""
NSQ_SOURCE_LINE 00000278 "=head1 SUBCLASSING"
NSQ_SOURCE_LINE 00000279 ""
NSQ_SOURCE_LINE 00000280 "The read_response_headers() and read_entity_body() will invoke the"
NSQ_SOURCE_LINE 00000281 "sysread() method when they need more data.  Subclasses might want to"
NSQ_SOURCE_LINE 00000282 "override this method to control how reading takes place."
NSQ_SOURCE_LINE 00000283 ""
NSQ_SOURCE_LINE 00000284 "The object itself is a glob.  Subclasses should avoid using hash key"
NSQ_SOURCE_LINE 00000285 "names prefixed with C<http_> and C<io_>."
NSQ_SOURCE_LINE 00000286 ""
NSQ_SOURCE_LINE 00000287 "=head1 SEE ALSO"
NSQ_SOURCE_LINE 00000288 ""
NSQ_SOURCE_LINE 00000289 "L<LWP>, L<IO::Socket::INET>, L<Net::HTTP::NB>"
NSQ_SOURCE_LINE 00000290 ""
NSQ_SOURCE_LINE 00000291 "=head1 AUTHOR"
NSQ_SOURCE_LINE 00000292 ""
NSQ_SOURCE_LINE 00000293 "Gisle Aas <gisle@activestate.com>"
NSQ_SOURCE_LINE 00000294 ""
NSQ_SOURCE_LINE 00000295 "=head1 COPYRIGHT AND LICENSE"
NSQ_SOURCE_LINE 00000296 ""
