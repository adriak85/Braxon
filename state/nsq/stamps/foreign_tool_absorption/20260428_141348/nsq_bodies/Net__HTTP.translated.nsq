NSQ_SOURCE_LINE 00000300 "the same terms as the Perl 5 programming language system itself."
NSQ_SOURCE_LINE 00000301 ""
NSQ_SOURCE_LINE 00000302 "=cut"
NSQ_SOURCE_LINE 00000303 ""
NSQ_SOURCE_LINE 00000304 "__END__"
