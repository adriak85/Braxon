NSQ_SOURCE_LINE 00000001 "package Ref::Util::XS;"
NSQ_SOURCE_LINE 00000002 "# ABSTRACT: XS implementation for Ref::Util"
NSQ_SOURCE_LINE 00000003 "$Ref::Util::XS::VERSION = '0.117';"
NSQ_SOURCE_LINE 00000004 "use strict;"
NSQ_SOURCE_LINE 00000005 "use warnings;"
NSQ_SOURCE_LINE 00000006 "use XSLoader;"
NSQ_SOURCE_LINE 00000007 ""
NSQ_SOURCE_LINE 00000008 "use Exporter 5.57 'import';"
NSQ_SOURCE_LINE 00000009 ""
NSQ_SOURCE_LINE 00000010 "our %EXPORT_TAGS = ( 'all' => [qw<"
NSQ_SOURCE_LINE 00000011 "    is_ref"
NSQ_SOURCE_LINE 00000012 "    is_scalarref"
NSQ_SOURCE_LINE 00000013 "    is_arrayref"
NSQ_SOURCE_LINE 00000014 "    is_hashref"
NSQ_SOURCE_LINE 00000015 "    is_coderef"
NSQ_SOURCE_LINE 00000016 "    is_regexpref"
NSQ_SOURCE_LINE 00000017 "    is_globref"
NSQ_SOURCE_LINE 00000018 "    is_formatref"
NSQ_SOURCE_LINE 00000019 "    is_ioref"
NSQ_SOURCE_LINE 00000020 "    is_refref"
NSQ_SOURCE_LINE 00000021 ""
NSQ_SOURCE_LINE 00000022 "    is_plain_ref"
NSQ_SOURCE_LINE 00000023 "    is_plain_scalarref"
NSQ_SOURCE_LINE 00000024 "    is_plain_arrayref"
NSQ_SOURCE_LINE 00000025 "    is_plain_hashref"
NSQ_SOURCE_LINE 00000026 "    is_plain_coderef"
NSQ_SOURCE_LINE 00000027 "    is_plain_globref"
NSQ_SOURCE_LINE 00000028 "    is_plain_formatref"
NSQ_SOURCE_LINE 00000029 "    is_plain_refref"
NSQ_SOURCE_LINE 00000030 ""
NSQ_SOURCE_LINE 00000031 "    is_blessed_ref"
NSQ_SOURCE_LINE 00000032 "    is_blessed_scalarref"
NSQ_SOURCE_LINE 00000033 "    is_blessed_arrayref"
NSQ_SOURCE_LINE 00000034 "    is_blessed_hashref"
NSQ_SOURCE_LINE 00000035 "    is_blessed_coderef"
NSQ_SOURCE_LINE 00000036 "    is_blessed_globref"
NSQ_SOURCE_LINE 00000037 "    is_blessed_formatref"
NSQ_SOURCE_LINE 00000038 "    is_blessed_refref"
NSQ_SOURCE_LINE 00000039 ">] );"
NSQ_SOURCE_LINE 00000040 ""
NSQ_SOURCE_LINE 00000041 "our @EXPORT_OK   = ( @{ $EXPORT_TAGS{'all'} } );"
NSQ_SOURCE_LINE 00000042 ""
NSQ_SOURCE_LINE 00000043 "XSLoader::load('Ref::Util::XS', $Ref::Util::XS::{VERSION} ? ${ $Ref::Util::XS::{VERSION} } : ());"
NSQ_SOURCE_LINE 00000044 ""
NSQ_SOURCE_LINE 00000045 "if (_using_custom_ops()) {"
NSQ_SOURCE_LINE 00000046 "  for my $op (@{$EXPORT_TAGS{all}}) {"
NSQ_SOURCE_LINE 00000047 "    no strict 'refs';"
NSQ_SOURCE_LINE 00000048 "    *{\"B::Deparse::pp_$op\"} = sub {"
NSQ_SOURCE_LINE 00000049 "      my ($deparse, $bop, $cx) = @_;"
NSQ_SOURCE_LINE 00000050 "      my @kids = $deparse->deparse($bop->first, 6);"
NSQ_SOURCE_LINE 00000051 "      my $sib = $bop->first->sibling;"
NSQ_SOURCE_LINE 00000052 "      if (ref $sib ne 'B::NULL') {"
NSQ_SOURCE_LINE 00000053 "        push @kids, $deparse->deparse($sib, 6);"
NSQ_SOURCE_LINE 00000054 "      }"
NSQ_SOURCE_LINE 00000055 "      my $prefix"
NSQ_SOURCE_LINE 00000056 "        = ("
NSQ_SOURCE_LINE 00000057 "          exists &{\"$deparse->{curstash}::$op\"}"
NSQ_SOURCE_LINE 00000058 "          && \\&{\"$deparse->{curstash}::$op\"} == \\&{__PACKAGE__.'::'.$op}"
NSQ_SOURCE_LINE 00000059 "        )"
NSQ_SOURCE_LINE 00000060 "        ? '' : (__PACKAGE__.'::');"
NSQ_SOURCE_LINE 00000061 "      return \"$prefix$op(\" . join(\", \", @kids) . \")\";"
NSQ_SOURCE_LINE 00000062 "    };"
NSQ_SOURCE_LINE 00000063 "  }"
NSQ_SOURCE_LINE 00000064 "}"
NSQ_SOURCE_LINE 00000065 ""
NSQ_SOURCE_LINE 00000066 "1;"
NSQ_SOURCE_LINE 00000067 ""
NSQ_SOURCE_LINE 00000068 "__END__"
NSQ_SOURCE_LINE 00000069 ""
NSQ_SOURCE_LINE 00000070 "=pod"
NSQ_SOURCE_LINE 00000071 ""
NSQ_SOURCE_LINE 00000072 "=encoding UTF-8"
NSQ_SOURCE_LINE 00000073 ""
NSQ_SOURCE_LINE 00000074 "=head1 NAME"
NSQ_SOURCE_LINE 00000075 ""
NSQ_SOURCE_LINE 00000076 "Ref::Util::XS - XS implementation for Ref::Util"
NSQ_SOURCE_LINE 00000077 ""
NSQ_SOURCE_LINE 00000078 "=head1 VERSION"
NSQ_SOURCE_LINE 00000079 ""
NSQ_SOURCE_LINE 00000080 "version 0.117"
NSQ_SOURCE_LINE 00000081 ""
NSQ_SOURCE_LINE 00000082 "=head1 SYNOPSIS"
NSQ_SOURCE_LINE 00000083 ""
NSQ_SOURCE_LINE 00000084 "    use Ref::Util;"
NSQ_SOURCE_LINE 00000085 "    # Don't use Ref::Util::XS directly!"
NSQ_SOURCE_LINE 00000086 ""
NSQ_SOURCE_LINE 00000087 "    if (is_arrayref($something) {"
NSQ_SOURCE_LINE 00000088 "        print for @$something;"
NSQ_SOURCE_LINE 00000089 "    }"
NSQ_SOURCE_LINE 00000090 "    elsif (is_hashref($something)) {"
NSQ_SOURCE_LINE 00000091 "        print for sort values %$something;"
NSQ_SOURCE_LINE 00000092 "    }"
NSQ_SOURCE_LINE 00000093 ""
NSQ_SOURCE_LINE 00000094 "=head1 DESCRIPTION"
NSQ_SOURCE_LINE 00000095 ""
NSQ_SOURCE_LINE 00000096 "Ref::Util::XS is the XS implementation of Ref::Util, which provides several"
NSQ_SOURCE_LINE 00000097 "functions to help identify references in a more convenient way than the"
NSQ_SOURCE_LINE 00000098 "usual approach of examining the return value of C<ref>."
NSQ_SOURCE_LINE 00000099 ""
NSQ_SOURCE_LINE 00000100 "You should use L<Ref::Util::XS> by installing L<Ref::Util> itself: if the system"
NSQ_SOURCE_LINE 00000101 "you install it on has a C compiler available, C<Ref::Util::XS> will be"
NSQ_SOURCE_LINE 00000102 "installed and used automatically, providing a significant speed boost to"
NSQ_SOURCE_LINE 00000103 "everything that uses C<Ref::Util>."
NSQ_SOURCE_LINE 00000104 ""
NSQ_SOURCE_LINE 00000105 "See L<Ref::Util> for full documentation of the available functions."
NSQ_SOURCE_LINE 00000106 ""
